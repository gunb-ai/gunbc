// docs/design/sdlc/sdlc.dag -- Design-version SDLC pipeline.
//
// This is the DESIGN DOCUMENT version of the pipeline. The canonical
// implementation lives at dsl/pipelines/sdlc.dag.
//
// This file is kept in sync as documentation of the target architecture.
// It uses the same interface-first, profile-bound design as the
// implementation but may include forward-looking syntax proposals.
//
// Core idea: a GitHub issue IS a pipeline instance. Its labels encode
// lifecycle stage, its comments carry artifacts (designs, reviews,
// reports), and its state transitions drive pipeline progression.
//
//   sdlc:idea -> sdlc:design -> sdlc:design-review -> sdlc:accepted
//                                                        |
//   sdlc:done <- sdlc:testing <- sdlc:code-review <- sdlc:implementing
//
// ── Architecture (Three-Layer Model) ──
//
//   Layer 1 (Pipeline):     pipelines/sdlc.dag -- domain concepts only
//   Layer 2 (Interfaces):   interfaces/*.dag -- typed contracts
//   Layer 3 (Providers):    services/sdlc/providers/*.dag -- concrete impls
//   Profile:                profiles/sdlc.dag -- compile-time binding
//
// ── Gap Analysis Implementation Status ──
//
//   Gap A: IssueProvider interface                  [IMPLEMENTED]
//   Gap B: ClaimStore + OutcomeLedger interfaces     [IMPLEMENTED]
//   Gap C: Profile declarations (bridge syntax)      [IMPLEMENTED]
//   Gap D: Credential wiring via profile             [PARTIAL - config bindings]
//   Gap E: CAS for multi-worker claim safety         [DEFERRED - single-worker ok]
//   Gap F: SubDag/Pipeline node execution            [RESOLVED - stage composition]
//   Gap G: Worker routes by stage                    [IMPLEMENTED - execute_stage]
//   Gap H: Code review and acceptance stubs          [IMPLEMENTED - stub handlers]
//   Gap I: Agent branch management                   [IMPLEMENTED - AgentProvider]
//   Gap J: Pipeline parameters                       [IMPLEMENTED - param decls]

module docs.design.sdlc

import interfaces.issue_provider { IssueProvider }
import interfaces.claim_store { ClaimStore }
import interfaces.outcome_ledger { OutcomeLedger }
import interfaces.agent_provider { AgentProvider }
import funcs.sdlc_stages { determine_stage, execute_stage }
import shared.dag_util { aggregate_results, format_report, stage_result }
import std.types {
    TrackedIssue, IssueLifecycleStage, StageResult, Summary,
    StageOutcome, OutcomeStatus, NonEmptyStr
}

// ── Pipeline parameters ─────────────────────────────────────────────

param repo_owner: String
param repo_name: String
param issue_number: Int
param llm_provider: String = "anthropic"
param llm_model: String = "claude-sonnet-4-20250514"
param worker_id: String = "pipeline-1"

// ── Pipeline ────────────────────────────────────────────────────────

pipeline sdlc
  uses issues: IssueProvider
  uses claims: ClaimStore
  uses outcomes: OutcomeLedger
  uses agents: AgentProvider
{
  stage fetch {
    issue_result = issues.get(id: "{issue_number}")
    issue = issue_result.issue
  }

  stage claim [after fetch] {
    current_stage = determine_stage(labels: issue.labels)
    issue_id = "{repo_owner}/{repo_name}#{issue_number}"
    run_key = "sdlc::{issue_id}::{current_stage}::v1"

    acquired = claims.acquire(
      issue_id: issue_id,
      stage: current_stage,
      owner: worker_id,
      lease_ttl_ms: 30000
    )
  }

  stage replay_check [after claim, when acquired.acquired] {
    prior = outcomes.get(run_key: run_key, stage: current_stage)
  }

  stage execute [after replay_check, when !prior.found] {
    stage_outcome = execute_stage(
      issue_id: issue_id,
      stage: current_stage,
      title: issue.title,
      body: issue.body,
      run_key: run_key,
      owner: repo_owner,
      repo: repo_name,
      number: issue_number,
      llm_provider: llm_provider,
      llm_model: llm_model
    )
  }

  stage record [after execute, when stage_outcome != null] {
    recorded = outcomes.upsert(
      run_key: run_key,
      stage: current_stage,
      outcome: {
        run_key: run_key,
        stage: current_stage,
        status: match stage_outcome.success {
          true  => "Success"
          false => "Failed"
        },
        payload: None,
        error: None,
        attempt_count: 1,
        retry_budget_remaining: 2,
        next_attempt_at: None,
        created_at: "",
        updated_at: ""
      }
    )
  }

  stage release [after record] {
    released = claims.release(
      issue_id: issue_id,
      stage: current_stage,
      owner: worker_id,
      generation: acquired.lease_generation
    )
  }

  stage report [after release] {
    stages = [
      stage_result(
        name: "{current_stage}->{stage_outcome.next_stage}",
        success: stage_outcome.success,
        stderr: ""
      )
    ]
    summary = aggregate_results(stages: stages)
    report_text = format_report(summary: summary, stages: stages)
    report_comment = issues.comment(
      id: issue_id,
      body: report_text,
      marker: "sdlc:report:{run_key}"
    )
  }
}
