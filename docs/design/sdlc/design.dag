// tools/design.dag -- Software design generation and review tool.
//
// Analogous to tools/review.dag: the design document is an abstract
// content blob (markdown) that can be posted as a GitHub issue comment,
// stored in a file, or piped into the review pipeline.
//
// Two modes:
//   1. generate: idea (text) → structured design document (markdown)
//   2. review:   design (text) → review findings (ReviewOutput)
//
// The generate mode uses LLM to produce a structured markdown document
// with standard sections. The review mode reuses the existing review
// pipeline with design-specific criteria.
//
// The design output is intentionally simple: a markdown string with
// a summary. This mirrors ReviewOutput's shape and keeps the content
// blob collapsible into different downstream consumers.
//
// Architecture:
//
//   [idea text]
//       |
//   prepare_design_prompt (pure: idea → ChatRequest)
//       |
//   llm/execute (I/O boundary: ChatRequest → ChatResponse)
//       |
//   parse_design_response (pure: ChatResponse → DesignOutput)
//       |
//   [DesignOutput { content: markdown, summary: string }]

module tools.design

import extdeps.llm.openai
import extdeps.llm.anthropic
import std.types { Url, DesignOutput, DesignReviewOutput, DesignFinding, DesignSections }

// --- Design generation ---------------------------------------------------
// Pure prepare → LLM execute → Pure parse.
//
// The prompt instructs the LLM to produce a markdown document with:
//   - Problem statement
//   - Proposed approach
//   - Key interfaces / type signatures
//   - Risks and mitigations
//   - Test plan
//   - Estimated scope (S/M/L)
//
// The parse step extracts the markdown body and a one-line summary.

func generate_design(
    idea: String,
    context: String?,
    provider: String = "anthropic",
    model: String = "claude-sonnet-4-20250514"
) -> { content: String, summary: String } {

    // Step 1: Build the LLM request with design-generation system prompt
    prepared = prepare_design_prompt(
        idea: idea,
        context: context,
        provider: provider,
        model: model
    )

    // Step 2: Execute LLM call (I/O boundary)
    llm_response = llm.execute(request: prepared.request)

    // Step 3: Parse the response into a DesignOutput
    result = parse_design_response(response: llm_response)

    return { content: result.content, summary: result.summary }
}

// --- Design review -------------------------------------------------------
// Reuses the review pipeline with design-specific criteria.
// The criteria focus on: completeness, feasibility, risk coverage,
// interface clarity, and testability.

func review_design(
    design: String,
    provider: String = "anthropic",
    model: String = "claude-sonnet-4-20250514"
) -> { findings: Json, approved: Bool, summary: String } {

    // Step 1: Prepare review prompt with design criteria
    prepared = prepare_design_review_prompt(
        artifact: design,
        criteria: design_review_criteria()
    )

    // Step 2: Execute LLM call
    llm_response = llm.execute(request: prepared.request)

    // Step 3: Parse review findings
    review = parse_review_response(response: llm_response, criteria: design_review_criteria())

    // Step 4: Determine approval (no blocking findings)
    approved = review.findings |> filter(f => f.severity == "blocking") |> count() == 0

    return { findings: review.findings, approved: approved, summary: review.summary }
}

// --- Design criteria (compile-time constant) -----------------------------
// Analogous to review criteria in tools/review.dag.

fn design_review_criteria() -> Json {
    {
        name: "software-design",
        description: "Review a software design document for completeness and feasibility",
        checks: [
            { id: "problem-clarity",   description: "Problem statement is clear and scoped" },
            { id: "approach-feasible",  description: "Proposed approach is technically feasible" },
            { id: "interfaces-defined", description: "Key interfaces and types are specified" },
            { id: "risks-identified",   description: "Risks are identified with mitigations" },
            { id: "test-plan-present",  description: "Test plan covers critical paths" },
            { id: "scope-reasonable",   description: "Estimated scope matches the proposal" }
        ]
    }
}

// ── Tests ──────────────────────────────────────────────────────────

fixture design_cloud_env {
    mock cloud_env.config -> { provider: "gcp", runtime: "local-dev", audience: "local-dev", project_or_account: "mock-secrets" }
    mock cloud_env.request_url -> "https://example.com/oidc"
    mock cloud_env.credential -> { token: "<MOCK_API_KEY>", source_type: "static", scheme: "bearer" }
}

test generate_design_from_idea : design_cloud_env {
    @tier(Scenario)
    @hermetic(true)

    input generate_design.idea -> "We need a GitHub Issues integration that allows the SDLC pipeline to create, update, and track issues as they progress through lifecycle stages."
    input generate_design.provider -> "anthropic"
    input generate_design.model -> "claude-sonnet-4-20250514"

    mock llm/execute.response -> rest_response(200, {
        content: [{ type: "text", text: "## Problem\n\nThe SDLC pipeline needs GitHub Issues integration.\n\n## Approach\n\nAdd a `github.Issues` service with CRUD operations.\n\n## Interfaces\n\n```\nservice github.Issues { Create, Get, Update, AddComment, SetLabels, List }\n```\n\n## Risks\n\n- Rate limiting on GitHub API\n- Webhook delivery reliability\n\n## Test Plan\n\n- Unit: mock all REST calls\n- Scenario: full lifecycle test\n\n## Scope\n\nM (medium)" }],
        model: "claude-sonnet-4-20250514",
        stop_reason: "end_turn",
        usage: { input_tokens: 200, output_tokens: 300 }
    })

    expect result.content contains "## Problem"
    expect result.content contains "## Approach"
    expect result.summary is String
}

test review_design_document : design_cloud_env {
    @tier(Scenario)
    @hermetic(true)

    input review_design.design -> "## Problem\n\nNeed feature X.\n\n## Approach\n\nDo thing Y.\n\n## Risks\n\nNone identified.\n\n## Test Plan\n\nUnit tests."

    mock llm/execute.response -> rest_response(200, {
        content: [{ type: "text", text: "{\"findings\":[{\"check_id\":\"risks-identified\",\"issue_key\":\"no_risks_listed\",\"observation\":\"Design claims no risks but all projects have risks\",\"severity\":\"blocking\"}],\"summary\":\"Design needs risk analysis\"}" }],
        model: "claude-sonnet-4-20250514",
        stop_reason: "end_turn",
        usage: { input_tokens: 150, output_tokens: 100 }
    })

    expect result.approved == false
    expect result.summary contains "risk"
}
