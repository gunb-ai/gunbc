# gen_init_cpio spec for the runner-host initramfs.
#
# A DIRECTORY CANNOT CARRY DEVICE NODES, and that is what failed the first boot. With
# CONFIG_INITRAMFS_SOURCE pointing at a directory, /dev is created empty -- so PID 1 starts with no
# /dev/console, every echo goes nowhere, and `exec sh` reads immediate EOF and exits. The kernel
# then panics with "Attempted to kill init! exitcode=0x0", which names the symptom and not the
# cause. The spec-file form declares nodes without needing root to mknod them.
dir /dev 0755 0 0
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /bin 0755 0 0
dir /run 0755 0 0

nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3
nod /dev/tty 0666 0 0 c 5 0
nod /dev/kmsg 0600 0 0 c 1 11

file /bin/busybox @BUSYBOX@ 0755 0 0
file /init @INIT@ 0755 0 0
file /udhcpc.script @UDHCPC@ 0755 0 0

# THE HYPERVISOR IS IN THE IMAGE; THE GUEST IS NOT, and the firmware settled that argument. A first
# attempt embedded the guest kernel and rootfs in the initramfs, taking the host Image from 84 MiB
# to 173 MiB -- and the firmware answered "Boot option loading failed" where the smaller image had
# booted. So there is a load ceiling somewhere between them, and the artifact that must stay small
# is the one firmware loads.
#
# THAT PUSHES THE DESIGN THE RIGHT WAY. Guest artifacts were always meant to arrive from a staging
# service and be verified by digest rather than baked into the trusted host image; for this slice
# they ride on the ISO filesystem beside the loader and /init mounts the medium to reach them. That
# keeps the guest out of the boot artifact while not yet requiring a network that has never carried
# traffic.
dir /media 0755 0 0
nod /dev/sr0 0660 0 0 b 11 0
file /bin/firecracker @FIRECRACKER@ 0755 0 0
file /bin/jailer @JAILER@ 0755 0 0
