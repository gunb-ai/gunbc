+name = "p3_cohort_probe"
+path = "src/bin/p3_cohort_probe.rs"
+
 # Per-worker private-footprint decomposition (node://adhoc-2a689db3-964). Requires
 # `--features interp_test_witness` for the force/drop handles on MultiEntryIndex.
