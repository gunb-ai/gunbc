//! REPORT-ONLY SHADOW of the direct-call ARGUMENT-TYPE judgment.
//!
//! INSTRUMENT, NOT PRODUCTION, AND NOT FOR MAIN (smart-ram-730 ruling, 2026-08-22).
//! This module exists to answer one question: of the rustc board on emitted v2 Rust, what
//! share is source conformance debt -- calls the `.dag` layer should have refused and did
//! not, because `v1.compiler.infer` `module_skips_direct_call_arg_check` exempts every
//! `v2.*` caller module from the argument TYPE judgment.
//!
//! IT DOES NOT REIMPLEMENT COMPATIBILITY. The verdict on every row comes from calling
//! `v1_compiler_infer::direct_call_arg_type_mismatch` -- the same predicate production
//! calls -- so a row measures the compiler's judgment, not a second copy of it.
//! What this module re-walks is only the per-formal PLAN, which production also walks in
//! `direct_call_arg_mismatch_diags`; the two control-flow arms production takes before
//! reaching the predicate (no matched actual; an anonymous record literal at the actual
//! position) are mirrored here EXPLICITLY AND LABELLED, never silently skipped.
//!
//! IT CHANGES NO COMPILATION OR EMISSION BEHAVIOUR. Rows are accumulated into a process
//! -global sink and written once at the compile boundary. No diagnostic is added or
//! removed, no vocabulary is widened, and the diagnostics total the canary board is read
//! beside does not move.
//!
//! IT FAILS TOWARD UNADJUDICATED, NEVER TOWARD SILENCE. Every formal of every direct call
//! that reaches the seam produces exactly one row. A relation whose comparison cannot be
//! reached is `ComparisonUnavailable` with a cause, never a dropped row -- a missing row
//! and a `Compatible` row are indistinguishable in a total, and the missing population is
//! precisely the one being bounded.

use im::{HashMap, Vector};
use std::rc::Rc;
use std::sync::Mutex;

/// The conservative outcome vocabulary. `WouldDiagnose` is a CANDIDATE source defect and
/// is deliberately not named one: the exemption was introduced around representation-gap
/// false positives, so promoting a candidate to a defect needs the modeled declarations
/// and a target-independent relation, which this instrument does not have.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ShadowOutcome {
    Compatible,
    WouldDiagnose,
    ComparisonUnavailable { cause: &'static str },
    RepresentationRelationUnadjudicated { cause: &'static str },
}

impl ShadowOutcome {
    pub fn tag(&self) -> &'static str {
        match self {
            ShadowOutcome::Compatible => "Compatible",
            ShadowOutcome::WouldDiagnose => "WouldDiagnose",
            ShadowOutcome::ComparisonUnavailable { .. } => "ComparisonUnavailable",
            ShadowOutcome::RepresentationRelationUnadjudicated { .. } => {
                "RepresentationRelationUnadjudicated"
            }
        }
    }
    pub fn cause(&self) -> &'static str {
        match self {
            ShadowOutcome::ComparisonUnavailable { cause } => cause,
            ShadowOutcome::RepresentationRelationUnadjudicated { cause } => cause,
            _ => "",
        }
    }
}

/// One row per actual/formal relation. The join key is SEMANTIC -- caller module, caller
/// declaration, callee, formal index -- exactly as briefed; the file/byte fields are a
/// convenience for locating a row in source and are never the key (a two-line file shift
/// moves every byte offset and reads as a repair plus a regression).
#[derive(Debug, Clone)]
pub struct ShadowRow {
    pub caller_module: String,
    pub caller_decl: String,
    pub callee: String,
    pub formal_index: i64,
    pub formal_label: String,
    pub exempt: bool,
    pub call_file: String,
    pub call_start: i64,
    pub actual_file: String,
    pub actual_start: i64,
    pub actual_end: i64,
    pub formal_type: String,
    pub actual_type: String,
    pub outcome: ShadowOutcome,
}

static SINK: Mutex<Option<Vec<ShadowRow>>> = Mutex::new(None);

/// Armed only when `GUNBC_SHADOW_ARG_CONFORMANCE` names an output path. Unarmed, `record`
/// is a lock-and-return, so an ordinary compile pays nothing but the check.
pub fn output_path() -> Option<String> {
    std::env::var("GUNBC_SHADOW_ARG_CONFORMANCE")
        .ok()
        .filter(|p| !p.is_empty())
}

pub fn armed() -> bool {
    output_path().is_some()
}

pub fn record(row: ShadowRow) {
    if !armed() {
        return;
    }
    let mut g = SINK.lock().unwrap();
    g.get_or_insert_with(Vec::new).push(row);
}

fn tsv_escape(s: &str) -> String {
    s.replace('\\', "\\\\")
        .replace('\t', "\\t")
        .replace('\n', "\\n")
        .replace('\r', "\\r")
}

/// Written once at the compile boundary, where an effect is already sanctioned.
/// Returns the number of rows written, or `None` when the instrument was never armed.
static FLUSHED: Mutex<bool> = Mutex::new(false);

pub fn flush() -> Option<usize> {
    let path = output_path()?;
    {
        // Idempotent: `flush` is called at every exit the compile boundary can take, and a
        // second call must not overwrite the ledger with the emptied sink.
        let mut f = FLUSHED.lock().unwrap();
        if *f {
            return None;
        }
        *f = true;
    }
    let rows = { SINK.lock().unwrap().take().unwrap_or_default() };
    let mut out = String::from(
        "caller_module\tcaller_decl\tcallee\tformal_index\tformal_label\texempt\tcall_file\tcall_start\tactual_file\tactual_start\tactual_end\tformal_type\tactual_type\toutcome\tcause\n",
    );
    for r in rows.iter() {
        out.push_str(&format!(
            "{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\n",
            tsv_escape(&r.caller_module),
            tsv_escape(&r.caller_decl),
            tsv_escape(&r.callee),
            r.formal_index,
            tsv_escape(&r.formal_label),
            if r.exempt { "exempt" } else { "judged" },
            tsv_escape(&r.call_file),
            r.call_start,
            tsv_escape(&r.actual_file),
            r.actual_start,
            r.actual_end,
            tsv_escape(&r.formal_type),
            tsv_escape(&r.actual_type),
            r.outcome.tag(),
            tsv_escape(r.outcome.cause()),
        ));
    }
    if let Err(e) = std::fs::write(&path, out) {
        // A sidecar that cannot be written REFUSES loudly. Silently losing the ledger
        // would report an empty population as a clean one.
        eprintln!("shadow-arg-conformance: REFUSE: cannot write {path}: {e}");
        std::process::exit(9);
    }
    eprintln!("shadow-arg-conformance: {} rows -> {}", rows.len(), path);
    Some(rows.len())
}

/// Called from the one direct-call seam in `v1_compiler_infer`, for EVERY direct call --
/// exempt (`v2.*`) and judged alike.
///
/// Recording the judged calls too is discriminator (1): on a non-exempt module the shadow
/// and production run the same predicate over the same plan, so the `WouldDiagnose` rows
/// must be exactly the production diagnostics. That control is taken on every ordinary
/// call in the run rather than on a single fixture, and its failure is visible as a count
/// disagreement in the receipt rather than as a silent divergence.
#[allow(clippy::too_many_arguments)]
pub fn shadow_direct_call(
    plan: Rc<Vector<Rc<crate::v1_compiler_infer::CallFormalApplication>>>,
    type_env: Rc<crate::v1_compiler_infer_env::TypeEnv>,
    module_name: String,
    caller_decl: String,
    callee: String,
    call_span: Rc<crate::std_types::SourceSpan>,
    exempt: bool,
) {
    if !armed() {
        return;
    }
    let source_indices = type_env.source_indices.clone();

    for app in plan.iter() {
        let formal = app.formal.clone();
        let formal_type =
            crate::v1_compiler_infer_types::node_type_shape(formal.clone(), source_indices.clone());

        let (actual_file, actual_start, actual_end, actual_type, outcome) =
            match app.matched_arg.clone() {
                // Production's own `None` arm: no actual was bound to this formal, so there is
                // nothing to compare. Production emits no diagnostic here and neither does the
                // shadow -- but the relation still EXISTS and gets a row, because dropping it
                // would shrink the denominator toward a flattering number.
                None => (
                    call_span.file.clone(),
                    call_span.start,
                    call_span.end,
                    String::new(),
                    ShadowOutcome::ComparisonUnavailable {
                        cause: "no_actual_matched_to_formal",
                    },
                ),
                Some(ta) => {
                    let actual_expr = crate::v1_compiler_infer::arg_value(ta.clone());
                    let is_record_lit = matches!(
                        (*actual_expr.expr_data.clone()).clone(),
                        crate::v1_std_core::ExprData::ExprRecordLit { .. }
                    );
                    let actual_raw = crate::v1_compiler_infer::resolved_type(actual_expr.clone());
                    let actual = crate::v1_compiler_infer::peel_nominal_alias_identity(
                        actual_raw.clone(),
                        type_env.clone(),
                        module_name.clone(),
                    );
                    let actual_type = crate::v1_compiler_infer_types::node_type_shape(
                        actual.clone(),
                        source_indices.clone(),
                    );
                    let sp = actual_expr.span.clone();
                    if is_record_lit {
                        // Production SKIPS an anonymous record literal at an actual position.
                        // That skip is one of the four measured representation-gap classes, so
                        // the shadow preserves it as unadjudicated rather than either judging
                        // it or dropping it. This is discriminator (4)'s standing arm.
                        (
                            sp.file.clone(),
                            sp.start,
                            sp.end,
                            actual_type,
                            ShadowOutcome::RepresentationRelationUnadjudicated {
                                cause: "anonymous_record_literal_at_actual_position",
                            },
                        )
                    } else {
                        let mismatch = crate::v1_compiler_infer::direct_call_arg_type_mismatch(
                            formal.clone(),
                            actual.clone(),
                            type_env.clone(),
                            module_name.clone(),
                            source_indices.clone(),
                        );
                        (
                            sp.file.clone(),
                            sp.start,
                            sp.end,
                            actual_type,
                            if mismatch {
                                ShadowOutcome::WouldDiagnose
                            } else {
                                ShadowOutcome::Compatible
                            },
                        )
                    }
                }
            };

        record(ShadowRow {
            caller_module: module_name.clone(),
            caller_decl: caller_decl.clone(),
            callee: callee.clone(),
            formal_index: app.index,
            formal_label: app.param_name.clone(),
            exempt,
            call_file: call_span.file.clone(),
            call_start: call_span.start,
            actual_file,
            actual_start,
            actual_end,
            formal_type,
            actual_type,
            outcome,
        });
    }
}
