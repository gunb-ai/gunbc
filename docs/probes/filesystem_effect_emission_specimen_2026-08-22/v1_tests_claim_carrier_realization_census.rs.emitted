#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
#[serde(tag = "_variant")]
pub enum CensusSources {
    SourcesRead { sources: Rc<Vec<Rc<SourceFile>>> },
    SourceReadRefused { path: String },
}

pub fn census_sources_step(acc: Rc<CensusSources>, path: String) -> Rc<CensusSources> {
    match (*acc.clone()).clone() {
        CensusSources::SourceReadRefused { path: p, .. } => {
            Rc::new(CensusSources::SourceReadRefused { path: p.clone() })
        }
        CensusSources::SourcesRead {
            sources: so_far, ..
        } => {
            let read_out = filesystem.read(path.clone()).await?;
            if !read_out.1.clone() {
                Rc::new(CensusSources::SourceReadRefused { path: path.clone() })
            } else {
                Rc::new(CensusSources::SourcesRead {
                    sources: v1_rt::concat(
                        so_far.clone(),
                        Rc::new(vec![Rc::new(SourceFile {
                            path: path.clone(),
                            content: read_out.0.clone(),
                        })]),
                    ),
                })
            }
        }
    }
}

pub fn census_sources_from_paths(paths: Rc<Vec<String>>) -> Rc<CensusSources> {
    paths.clone().iter().cloned().fold(
        Rc::new(CensusSources::SourcesRead {
            sources: Rc::new(vec![]),
        }),
        |acc: Rc<CensusSources>, p: String| census_sources_step(acc, p.clone()),
    )
}

pub fn outcome_label(o: CensusOutcome) -> String {
    match o.clone() {
        CensusOutcome::Agrees => "Agrees".to_string(),
        CensusOutcome::DivergesWithExactIdentity => "DivergesWithExactIdentity".to_string(),
        CensusOutcome::IdentityUnavailable => "IdentityUnavailable".to_string(),
    }
}

pub fn tsv_escape(v: String) -> String {
    v1_rt::replace(
        v1_rt::replace(v.clone(), "\t".to_string(), "\\t".to_string()),
        "\n".to_string(),
        "\\n".to_string(),
    )
}

pub fn census_tsv_header() -> String {
    "module_file\tenclosing_decl\tposition_kind\tauthored_name\tdecl_file\tlegacy_base\tauthority_base\tinference_resolved\toutcome".to_string()
}

pub fn arm_label(resolved: bool) -> String {
    if resolved.clone() {
        "resolved".to_string()
    } else {
        "fallback".to_string()
    }
}

pub fn census_row_tsv(r: Rc<CarrierDecisionRow>) -> String {
    Rc::new(vec![
        tsv_escape(r.module_file.clone()),
        tsv_escape(r.enclosing_decl.clone()),
        tsv_escape(r.position_kind.clone()),
        tsv_escape(r.authored_name.clone()),
        tsv_escape(r.decl_file.clone()),
        tsv_escape(r.legacy_base.clone()),
        tsv_escape(r.authority_base.clone()),
        arm_label(r.inference_resolved.clone()),
        outcome_label(r.outcome.clone()),
    ])
    .join(&"\t".to_string())
}

pub fn census_tsv(rows: Rc<Vec<Rc<CarrierDecisionRow>>>) -> String {
    rows.clone()
        .iter()
        .cloned()
        .fold(census_tsv_header(), |acc: String, r: _| {
            v1_rt::concat(
                v1_rt::concat(acc, "\n".to_string()),
                census_row_tsv(r.clone()),
            )
        })
}

pub fn census_receipt_for_paths(paths: Rc<Vec<String>>) -> String {
    match (*census_sources_from_paths(paths.clone())).clone() {
        CensusSources::SourceReadRefused { path: p, .. } => {
            v1_rt::concat("REFUSED\tsource_read_failed\t".to_string(), p.clone())
        }
        CensusSources::SourcesRead { sources: srcs, .. } => census_tsv(census_rows(srcs.clone())),
    }
}

