pub fn outcome_of(claims_text: bool, realizes: bool, decl_file: String) -> CensusOutcome {
    if (decl_file.clone() == "".to_string()) {
        CensusOutcome::IdentityUnavailable
    } else {
        if (claims_text.clone() && !realizes.clone()) {
            CensusOutcome::DivergesWithExactIdentity
        } else {
            CensusOutcome::Agrees
        }
    }
}

