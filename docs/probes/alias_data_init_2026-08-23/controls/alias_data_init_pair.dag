module test.aliasrec


type Wrap<C> {
  concern: C
}

type Key {
  lens: Bool
}

type Plain {
  concern: Key
}

type WrapKeyAlias = Wrap<Key>
type PlainAlias = Plain

data via_alias: WrapKeyAlias = {
  concern: Key { lens: true }
}

data via_direct: Wrap<Key> = {
  concern: Key { lens: true }
}

data via_plain_alias: PlainAlias = {
  concern: Key { lens: true }
}

data via_plain_direct: Plain = {
  concern: Key { lens: true }
}

fn aliasrec_entry() -> Bool {
  via_alias().concern.lens
}

fn build_alias_in_body() -> WrapKeyAlias {
  WrapKeyAlias { concern: Key { lens: true } }
}
