module chunk

test fn an_omitted_population_row_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_over(
      universe: [
        test_identity(module: "v2.test.alpha", declaration: "passes"),
        test_identity(module: "v2.test.beta", declaration: "missing")
      ],
      module_source_index: [],
      population: [passed_row(module: "v2.test.alpha", declaration: "passes")],
      file_refusals: []
    )),
    cause_name: "population_omissions_present"
  )
}


