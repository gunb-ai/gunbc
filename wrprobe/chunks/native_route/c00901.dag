module chunk

test fn an_unattributed_head_advisory_is_refused() -> Bool {
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt_over(
      universe: [test_identity(module: "v2.test.alpha", declaration: "passes")],
      module_source_index: [],
      population: [passed_row(module: "v2.test.alpha", declaration: "passes")],
      file_refusals: [file_refusal_row(
        path: ^some_path,
        head: ^some_unowned_advisory,
        fatal: ^parse_g0_tokens_remain
      )]
    )),
    cause_name: "unattributed_head_advisories_present"
  )
}


