module chunk

test fn the_default_pattern_admits_every_universe_member() -> Bool {
  default_admits(module_qn: "v2.test.v2_native_route")
  && default_admits(module_qn: "v2.test.parse.alias_decl_parse")
  && !default_admits(module_qn: "v2.compiler.compile")
  && !default_admits(module_qn: "v2.testing.y")
  && (default_admits(module_qn: "v2.test") && !native_route_universe_member(module_qn: "v2.test"))
}

