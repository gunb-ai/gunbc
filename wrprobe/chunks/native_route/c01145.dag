module chunk

test fn an_accepted_malformed_specimen_is_refused() -> Bool {
  let base = green_receipt()
  let receipt = NativeRouteReceipt {
    job: base.job,
    tested_tree: base.tested_tree,
    preparation_seed_identity: base.preparation_seed_identity,
    emitted_closure_identity: base.emitted_closure_identity,
    executable_path: base.executable_path,
    executable_identity: base.executable_identity,
    universe: base.universe,
    module_source_index: base.module_source_index,
    population: base.population,
    file_refusals: base.file_refusals,
    false_control: base.false_control,
    true_control: base.true_control,
    malformed_control: MalformedSpecimenAccepted,
    old_route_control: base.old_route_control,
    emitted_build: base.emitted_build
  }
  native_route_admission_refused_with(
    admission: native_route_admission_with(live_pair: LivePairRequired, receipt: receipt),
    cause_name: "malformed_control_accepted_by_route"
  )
}

