module chunk

fn string_join(fields: FreeMonoid<String>, separator: String) -> String {
  match fields {
    Empty => Empty
    Cons { head: first, tail: rest } =>
      fold_list(
        xs: rest,
        empty: first,
        cons: fn(acc, field) {
          list_append(left: list_append(left: acc, right: separator), right: field)
        }
      )
  }
}

