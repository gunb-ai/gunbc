module chunk

fn parse_looks_like_match_arm_start(tokens: List<Token>) -> Bool {
  match parse_token_first(tokens: tokens) {
    Absent => false
    Present { value: tok0 } =>
      if string_length(s: tok0.lexeme) == 0 {
        false
      } else if parse_char_is_arm_pattern_lead(c: code_point(c: char_at(s: tok0.lexeme, pos: 0))) {
        match parse_token_second(tokens: tokens) {
          Present { value: tok1 } =>
            if parse_token_lexeme_is(tok: tok1, lit: "=>") {
              true
            } else if parse_token_lexeme_is(tok: tok1, lit: "{") {
              parse_scan_fat_arrow_after_lbrace(
                tokens: parse_tokens_drop(tokens: tokens, count: 2),
                depth: 1
              )
            } else {
              false
            }
          Absent => false
        }
      } else {
        false
      }
  }
}

