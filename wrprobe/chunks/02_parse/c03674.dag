module chunk

fn parse_production_prepared_measured(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  analysis: GrammarFirstAnalysis,
  production_name: Symbol,
  materialization: Materialization
) -> ParseProductionMeasured {
  parse_production_prepared_measured_seeded(
    tokens: tokens,
    validated: validated,
    analysis: analysis,
    production_name: production_name,
    seed: occurrence_id_allocator_initial(),
    materialization: materialization
  )
}

