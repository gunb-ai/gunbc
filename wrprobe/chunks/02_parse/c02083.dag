module chunk

fn choice_shared_prefix_suffixes(
  alts: List<PreparedExprFold>,
  prefix: PreparedGrammarExpr,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>
) -> Optional<List<PreparedExprFold>> {
  choice_shared_prefix_suffixes_from(
    alts: alts,
    prefix: prefix,
    nullable_set: nullable_set,
    first_rows: first_rows,
    suffixes: std.algebra.Empty
  )
}

