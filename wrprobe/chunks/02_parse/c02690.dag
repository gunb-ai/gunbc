module chunk

fn expr_corner_fold_sequence(
  left_fold: GrammarExprCornerFold,
  right_fold: GrammarExprCornerFold
) -> GrammarExprCornerFold {

  GrammarExprCornerFold {
    corners: list_append(
      left: left_fold.corners,
      right: if left_fold.nullable {
        right_fold.corners
      } else {
        grammar_empty_corner_list()
      }
    ),
    nullable: left_fold.nullable && right_fold.nullable
  }
}

