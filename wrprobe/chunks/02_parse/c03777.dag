module chunk

fn parse_production_tree(
  tokens: List<Token>,
  validated: ValidatedGrammarRoot,
  production_name: Symbol
) -> Outcome<ParseTree> {
  match parse_production(
    tokens: tokens,
    validated: validated,
    production_name: production_name
  ) {
    Accepted { value: artifact, diagnostics: d } =>
      Accepted { value: artifact.tree, diagnostics: d }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
