module chunk

fn expr_first_fold_from_prepared(
  expr: PreparedGrammarExpr,
  nullable_set: List<Symbol>,
  first_rows: Map<Symbol, List<FirstKey>>
) -> GrammarExprFirstFold {
  match expr {
    PreparedTerminal { token_class: token_class, stamp: _ } =>
      expr_first_fold_terminal(token_class: token_class)
    PreparedLiteralTerminal { token_class: token_class, lexeme: lexeme } =>
      expr_first_fold_literal(token_class: token_class, lexeme: lexeme)
    PreparedNonterminal { production: production } =>
      expr_first_fold_nonterminal(name: production, nullable_set: nullable_set, first_rows: first_rows)
    PreparedSequence { left: left, right: right } =>
      expr_first_fold_sequence(
        left: expr_first_fold_from_prepared(expr: left, nullable_set: nullable_set, first_rows: first_rows),
        right: expr_first_fold_from_prepared(expr: right, nullable_set: nullable_set, first_rows: first_rows)
      )
    PreparedChoice { plan: _, first: first } => first
    PreparedOptional { element: element } =>
      expr_first_fold_optional(
        element: expr_first_fold_from_prepared(expr: element, nullable_set: nullable_set, first_rows: first_rows)
      )
    PreparedRepeat { element: element } =>
      expr_first_fold_repeat(
        element: expr_first_fold_from_prepared(expr: element, nullable_set: nullable_set, first_rows: first_rows)
      )
  }
}

