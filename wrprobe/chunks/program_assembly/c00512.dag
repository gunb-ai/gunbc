module chunk

fn module_roots_from_source_root_ingest(
  ingest: SourceRootIngest,
  lm: LanguageModel
) -> Outcome<FreeMonoid<NormalizedTree>> {
  match program_assembly_fold_ingest(ingest: ingest, lm: lm) {
    ProgramAssemblyFoldOk { roots: roots, index: _ } =>
      outcome_accepted(value: roots)
    ProgramAssemblyFoldFailed { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

