module chunk

fn conj_positional_children(parent: Node) -> List<Node> {
  match parent.kind {
    TypeNode { connective: Conj } =>
      fold(
        parent.children,
        init: Empty,
        f: fn(acc, edge) {
          match edge.label {
            Positional => list_snoc_item(xs: acc, item: edge.target)
            Named { name: _ } => acc
          }
        }
      )
    _ => Empty
  }
}

