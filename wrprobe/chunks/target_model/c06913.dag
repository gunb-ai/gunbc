module chunk

fn target_value_expr_match_arms_are_int_bool_octet_channel(
  arms: List<TargetValueExprMatchArmSlot>
) -> Bool {
  if is_empty(xs: arms) {
    false
  } else {
    !any(
      xs: arms,
      predicate: fn(arm) {
        arm.pattern.kind != TargetValueExprBoolLiteral
          || arm.body.kind != TargetValueExprBoolLiteral
      }
    )
  }
}

