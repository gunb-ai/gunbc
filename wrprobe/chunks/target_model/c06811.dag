module chunk

fn target_value_expr_bool_literal_value_from_atom(node: Node) -> Optional<Bool> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^target_value_expression_bool_true {
        optional_present(true)
      } else if id == ^target_value_expression_bool_false {
        optional_present(false)
      } else {
        optional_absent()
      }
    _ => optional_absent()
  }
}

