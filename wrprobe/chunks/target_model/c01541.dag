module chunk

fn equality_predicate_from_wire_symbol(id: Symbol) -> Optional<EqualityPredicate> {
  if id == ^equality_predicate_is_equal {
    optional_present(value: IsEqual)
  } else {
    if id == ^equality_predicate_is_not_equal {
      optional_present(value: IsNotEqual)
    } else {
      optional_absent()
    }
  }
}

