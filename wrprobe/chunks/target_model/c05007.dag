module chunk

fn target_operator_realization_catalog_lookup_step(
  acc: PassingCandidateFold<Node>,
  row_node: Node,
  canonical_op: CanonicalOperation
) -> PassingCandidateFold<Node> {
  match target_operator_realization_row_wire_schema_valid(row: row_node) {
    Accepted { value: _, diagnostics: _ } =>
      if target_operator_realization_row_matches_canonical_op(
        row: row_node,
        canonical_op: canonical_op
      ) {
        match acc {
          NoPassingCandidate => OnePassingCandidate { candidate: row_node }
          OnePassingCandidate { candidate: _ } => ManyPassingCandidates
          ManyPassingCandidates => ManyPassingCandidates
        }
      } else {
        acc
      }
    Rejected { diagnostics: _ } => acc
  }
}

