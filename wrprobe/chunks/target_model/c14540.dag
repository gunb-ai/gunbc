module chunk

fn target_project_arrow_body_to_value_expression(
  arrow: Node,
  target: TargetModel,
  source_bool_form: TargetBoolLiteralShape,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } =>
          if target_value_expr_field_access_gate(node: body) {
            target_project_field_access(
              arrow: arrow,
              body: body,
              target: target,
              source_bool_form: source_bool_form,
              handle_transform: handle_transform
            )
          } else {
            handle_transform(arrow, body, target)
          }
        ComputationNode { behavior: Branch } =>
          target_project_branch_bool_if_else(
            arrow: arrow,
            body: body,
            target: target,
            source_bool_form: source_bool_form,
            handle_transform: handle_transform
          )
        ComputationNode { behavior: Bind } =>
          target_project_bind_let(
            arrow: arrow,
            body: body,
            target: target,
            source_bool_form: source_bool_form,
            handle_transform: handle_transform
          )
        ComputationNode { behavior: Loop } =>
          target_project_loop(
            arrow: arrow,
            body: body,
            target: target,
            source_bool_form: source_bool_form,
            handle_transform: handle_transform
          )
        ComputationNode { behavior: Match } =>
          target_project_match(
            arrow: arrow,
            body: body,
            target: target,
            source_bool_form: source_bool_form,
            handle_transform: handle_transform
          )
        TypeNode { connective: Conj } =>
          if target_value_expr_record_construct_gate(node: body) {
            target_project_record_construct(
              arrow: arrow,
              body: body,
              target: target,
              source_bool_form: source_bool_form,
              handle_transform: handle_transform
            )
          } else {
            outcome_rejected(
              target_value_expr_diagnostic(
                reason: ^target_value_expr_reason_transform_shape_invalid,
                node: body
              )
            )
          }
        _ =>
          outcome_rejected(
            target_value_expr_diagnostic(
              reason: ^target_value_expr_reason_transform_shape_invalid,
              node: body
            )
          )
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

