module chunk

fn produced_decl_params_tokens(
  rows: ProducedDeclRenderRows,
  params: List<Edge>
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: fold_list(
      xs: params,
      empty: outcome_accepted(
        value: ProducedDeclParamsFold { any_written: false, tokens: Empty }
      ),
      cons: fn(acc, edge) {
        bind_outcome(
          o: acc,
          f: fn(so_far) {
            bind_outcome(
              o: produced_decl_param_layout_tokens(
                rows: rows,
                edge: edge,
                layout: rows.param_layout
              ),
              f: fn(toks) {
                outcome_accepted(
                  value: ProducedDeclParamsFold {
                    any_written: true,
                    tokens: list_append(
                      left: so_far.tokens,
                      right: match so_far.any_written {
                        true =>
                          list_append(
                            left: produced_decl_separator_tokens(
                              separator: rows.param_separator
                            ),
                            right: toks
                          )
                        false => toks
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    ),
    f: fn(folded) { outcome_accepted(value: folded.tokens) }
  )
}

