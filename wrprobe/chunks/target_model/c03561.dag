module chunk

fn concrete_syntax_token_node_targets_from_list_node(node: Node) -> Outcome<List<Node>> {
  match node.kind {
    TypeNode { connective: Conj } =>
      if is_empty(xs: node.children) {
        outcome_accepted(Empty)
      } else {
        bind_outcome(
          o: find_named_child(root: node, name: ^fold_list_node_head),
          f: fn(head) {
            bind_outcome(
              o: find_named_child(root: node, name: ^fold_list_node_tail),
              f: fn(tail) {
                bind_outcome(
                  o: concrete_syntax_token_node_targets_from_list_node(node: tail),
                  f: fn(rest) {
                    outcome_accepted(Cons { head: head, tail: rest })
                  }
                )
              }
            )
          }
        )
      }
    _ =>
      outcome_rejected(
        target_bodied_arrow_scaffold_bundle_malformed_diagnostic(bundle: node)
      )
  }
}

