module chunk

fn target_value_expr_effect_apply_operand_bindings(wire: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: target_value_expr_effect_apply_wire_schema_valid(wire: wire),
    f: fn(_) {
      match fold(
        wire.children,
        init: Accepted { value: Empty, diagnostics: None },
        f: fn(acc, edge) {
          match acc {
            Rejected { diagnostics: r } => acc
            Accepted { value: bindings, diagnostics: d } =>
              match edge.label {
                Named { name: n } =>
                  if n == ^target_value_expr_field_effect_kind {
                    acc
                  } else if n == ^target_value_expr_field_operand {
                    bind_outcome(
                      o: target_value_expr_operand_wire_binding(operand_wire: edge.target),
                      f: fn(binding) {
                        outcome_accepted(
                          list_snoc_item(xs: bindings, item: binding)
                        )
                      }
                    )
                  } else {
                    outcome_rejected(
                      target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                    )
                  }
                Positional =>
                  outcome_rejected(
                    target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
                  )
              }
          }
        }
      ) {
        Accepted { value: bindings, diagnostics: d } =>
          Accepted { value: bindings, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    }
  )
}

