module chunk

fn target_value_expression_callable_apply(
  callee: Symbol,
  args: List<TargetValueExpression>
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprCallableApply,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_callable_apply_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_callee,
            target: target_model_type_atom_node(identity: callee)
          )
        ],
        right: target_value_expr_callable_arg_edges(args: args)
      ),
      occurrence_id: OccurrenceSynthetic
    }
  }
}

