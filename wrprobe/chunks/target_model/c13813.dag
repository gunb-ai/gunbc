module chunk

fn target_value_expr_record_construct_gate(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Conj } =>
      if !all_edges_named(children: node.children) {
        false
      } else {
        match target_value_expr_labeled_edge_head(
          labeled: node_labeled_child_edges(node: node)
        ) {
          Present { value: first_edge } =>
            match first_edge.target.kind {
              TypeNode { connective: Atom { identity: _ } } => true
              _ => false
            }
          Absent => false
        }
      }
    _ => false
  }
}

