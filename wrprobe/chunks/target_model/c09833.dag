module chunk

fn target_type_expr_fold_named_metadata_edges(node: Node) -> TargetTypeExprNamedMetadataFold {
  match fold(node.children, init: NamedMetadataFoldOk { kind_seen: false, surface_seen: false, extra_named: 0 }, f: fn(acc, e) {
    match acc {
      NamedMetadataFoldMalformed => acc
      NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: surface_seen, extra_named: extra_named } =>
        match e.label {
          Positional => acc
          Named { name: n } =>
            if n == ^target_type_expr_field_kind {
              if kind_seen {
                NamedMetadataFoldMalformed
              } else {
                match e.target.kind {
                  TypeNode { connective: Atom { identity: _ } } =>
                    NamedMetadataFoldOk { kind_seen: true, surface_seen: surface_seen, extra_named: extra_named }
                  _ => NamedMetadataFoldMalformed
                }
              }
            } else {
              if n == ^target_type_expr_field_surface {
                if surface_seen {
                  NamedMetadataFoldMalformed
                } else {
                  match e.target.kind {
                    TypeNode { connective: Atom { identity: _ } } =>
                      NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: true, extra_named: extra_named }
                    _ => NamedMetadataFoldMalformed
                  }
                }
              } else {
                NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: surface_seen, extra_named: extra_named + 1 }
              }
            }
        }
    }
  }) {
    NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: surface_seen, extra_named: extra_named } =>
      if kind_seen && surface_seen {
        NamedMetadataFoldOk { kind_seen: kind_seen, surface_seen: surface_seen, extra_named: extra_named }
      } else {
        NamedMetadataFoldMalformed
      }
    NamedMetadataFoldMalformed => NamedMetadataFoldMalformed
  }
}

