module chunk

fn decode_conditional_shape_bundle(bundle: Node) -> Outcome<TargetConditionalShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_if_token),
    f: fn(if_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(
          bundle: bundle,
          field: ^target_value_expr_field_then_token
        ),
        f: fn(then_token) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: ^target_value_expr_field_else_token
            ),
            f: fn(else_token) {
              bind_outcome(
                o: decode_conditional_delimiting(bundle: bundle),
                f: fn(delimiting) {
                  outcome_accepted(
                    TargetConditionalShape {
                      if_token: if_token,
                      then_token: then_token,
                      else_token: else_token,
                      delimiting: delimiting
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

