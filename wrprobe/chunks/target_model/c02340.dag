module chunk

fn decode_loop_shape_bundle(bundle: Node) -> Outcome<TargetLoopShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: ^target_value_expr_field_loop_token),
    f: fn(loop_token) {
      outcome_accepted(
        TargetLoopShape {
          loop_token: loop_token
        }
      )
    }
  )
}

