module chunk

fn target_capability_eligibility_from_node(
  node: Node
) -> Outcome<List<TargetCapabilityEligibilityRow>> {
  bind_outcome(
    o: node_list_from_node(
      node: node,
      decode_item: target_capability_eligibility_row_from_node
    ),
    f: fn(rows) {
      bind_outcome(
        o: fold_list(
          xs: rows,
          empty: outcome_accepted(empty_map()),
          cons: fn(acc, row) {
            match acc {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: seen, diagnostics: _ } =>
                match map_lookup(m: seen, key: row.capability_key) {
                  Present { value: _ } =>
                    outcome_rejected(
                      target_capability_eligibility_duplicate_diagnostic(at: node)
                    )
                  Absent =>
                    outcome_accepted(
                      map_insert(m: seen, key: row.capability_key, value: row.eligibility)
                    )
                }
            }
          }
        ),
        f: fn(_validated) { outcome_accepted(rows) }
      )
    }
  )
}

