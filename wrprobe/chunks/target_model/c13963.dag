module chunk

fn target_project_field_access(
  arrow: Node,
  body: Node,
  target: TargetModel,
  source_bool_form: TargetBoolLiteralShape,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<TargetValueExpression> {
  if !target_value_expr_field_access_gate(node: body) {
    outcome_rejected(
      target_value_expr_diagnostic(
        reason: ^target_value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    match target_value_expr_positional_child_optional(node: body, index: 1) {
      Absent =>
        outcome_rejected(
          target_value_expr_diagnostic(
            reason: ^target_value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      Present { value: base_node } =>
        match target_value_expr_positional_child_optional(node: body, index: 2) {
          Absent =>
            outcome_rejected(
              target_value_expr_diagnostic(
                reason: ^target_value_expr_reason_transform_shape_invalid,
                node: body
              )
            )
          Present { value: field_node } =>
            bind_outcome(
              o: target_value_expr_project_body_subexpression(
                arrow: arrow,
                node: base_node,
                target: target,
                source_bool_form: source_bool_form,
                handle_transform: handle_transform
              ),
              f: fn(projected_base) {
                match field_node.kind {
                  TypeNode { connective: Atom { identity: field_name } } =>
                    outcome_accepted(
                      target_value_expression_field_access(
                        base: projected_base,
                        field_name: field_name
                      )
                    )
                  _ =>
                    outcome_rejected(
                      target_value_expr_diagnostic(
                        reason: ^target_value_expr_reason_transform_shape_invalid,
                        node: body
                      )
                    )
                }
              }
            )
        }
    }
  }
}

