module chunk

fn target_derive_supplemental_generic_bound_requirement_nodes_for_contract(
  contract_authority: TargetDeriveSupplementalGenericBoundContractAuthority
) -> List<Node> {
  fold_list(
    xs: map_keys(contract_authority.requirements),
    empty: Empty,
    cons: fn(acc, representation_parameter) {
      match contract_authority.requirements.lookup(representation_parameter) {
        Absent => acc
        Present { value: requirements } =>
          fold_list(
            xs: map_keys(requirements),
            empty: acc,
            cons: fn(requirement_acc, required_key) {
              match requirements.lookup(required_key) {
                Absent => requirement_acc
                Present { value: requirement_authority } =>
                  list_snoc_item(
                    xs: requirement_acc,
                    item: target_model_type_conj_node(
                      children: [
                        target_model_named_edge(
                          name: ^target_derive_supplemental_generic_bound_requirement_field_representation_parameter,
                          target: target_model_type_atom_node(
                            identity: representation_parameter
                          )
                        ),
                        target_model_named_edge(
                          name: ^target_derive_supplemental_generic_bound_requirement_field_required_trait,
                          target: target_model_type_atom_node(
                            identity: required_key
                          )
                        ),
                        target_model_named_edge(
                          name: ^target_derive_supplemental_generic_bound_requirement_field_authority,
                          target: target_external_authority_bundle_node(
                            authority: requirement_authority.authority
                          )
                        )
                      ]
                    )
                  )
              }
            }
          )
      }
    }
  )
}

