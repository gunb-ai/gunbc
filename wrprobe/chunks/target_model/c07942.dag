module chunk

fn value_expr_projection_bundle_node(projection: TargetValueExpressionProjection) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: ^target_value_expr_field_binding_ref,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_ident_token,
              target: target_model_type_atom_node(
                identity: projection.binding_ref_form.ident_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_primitive_apply,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_open,
              target: target_model_type_atom_node(
                identity: projection.primitive_apply_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_close,
              target: target_model_type_atom_node(
                identity: projection.primitive_apply_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_separator,
              target: target_model_type_atom_node(
                identity: projection.primitive_apply_form.separator
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_callable_apply,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_ident_token,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.callee_ident_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_open,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_close,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_separator,
              target: target_model_type_atom_node(
                identity: projection.callable_apply_form.separator
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_closure,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_fn_token,
              target: target_model_type_atom_node(
                identity: projection.closure_form.fn_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_open,
              target: target_model_type_atom_node(
                identity: projection.closure_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_separator,
              target: target_model_type_atom_node(
                identity: projection.closure_form.separator
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_close,
              target: target_model_type_atom_node(
                identity: projection.closure_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_body_open,
              target: target_model_type_atom_node(
                identity: projection.closure_form.body_open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_body_close,
              target: target_model_type_atom_node(
                identity: projection.closure_form.body_close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_ident_token,
              target: target_model_type_atom_node(
                identity: projection.closure_form.param_ident_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_effect_apply,
        target: target_model_type_conj_node(

          children: list_append(
            left: fold_list(
              xs: projection.effect_apply_form.callees,
              empty: Empty,
              cons: fn(acc, row) {
                Cons {
                  head: target_model_named_edge(
                    name: ^target_value_expr_effect_callee_row_edge,
                    target: target_value_expr_effect_callee_row_node(row: row)
                  ),
                  tail: acc
                }
              }
            ),
            right: [
              target_model_named_edge(
                name: ^target_value_expr_field_open,
                target: target_model_type_atom_node(
                  identity: projection.effect_apply_form.open
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_close,
                target: target_model_type_atom_node(
                  identity: projection.effect_apply_form.close
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_separator,
                target: target_model_type_atom_node(
                  identity: projection.effect_apply_form.separator
                )
              )
            ]
          )
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_conditional,
        target: target_model_type_conj_node(
          children: list_append(
            left: [
              target_model_named_edge(
                name: ^target_value_expr_field_if_token,
                target: target_model_type_atom_node(
                  identity: projection.conditional_form.if_token
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_then_token,
                target: target_model_type_atom_node(
                  identity: projection.conditional_form.then_token
                )
              ),
              target_model_named_edge(
                name: ^target_value_expr_field_else_token,
                target: target_model_type_atom_node(
                  identity: projection.conditional_form.else_token
                )
              )
            ],
            right: conditional_delimiting_edges(
              delimiting: projection.conditional_form.delimiting
            )
          )
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_bind_let,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_let_token,
              target: target_model_type_atom_node(
                identity: projection.let_form.let_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_assign_token,
              target: target_model_type_atom_node(
                identity: projection.let_form.assign_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_in_token,
              target: target_model_type_atom_node(
                identity: projection.let_form.in_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_loop,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_loop_token,
              target: target_model_type_atom_node(
                identity: projection.loop_form.loop_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_record_construct,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_record_open,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_close,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_separator,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.separator
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_assign,
              target: target_model_type_atom_node(
                identity: projection.record_construct_form.assign
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_record_names_type,
              target: target_model_type_atom_node(
                identity: record_literal_type_naming_to_symbol(
                  naming: projection.record_construct_form.record_literal_names_type
                )
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_field_access,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_field_access_dot,
              target: target_model_type_atom_node(
                identity: projection.field_access_form.dot
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_match,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_match_token,
              target: target_model_type_atom_node(
                identity: projection.match_form.match_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_scrutinee_open,
              target: target_model_type_atom_node(
                identity: projection.match_form.scrutinee_open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_scrutinee_close,
              target: target_model_type_atom_node(
                identity: projection.match_form.scrutinee_close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_open,
              target: target_model_type_atom_node(
                identity: projection.match_form.open
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_close,
              target: target_model_type_atom_node(
                identity: projection.match_form.close
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_fat_arrow,
              target: target_model_type_atom_node(
                identity: projection.match_form.fat_arrow
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_match_arm_separator,
              target: target_model_type_atom_node(
                identity: projection.match_form.arm_separator
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_bool_literal,
        target: target_model_type_conj_node(
          children: [
            target_model_named_edge(
              name: ^target_value_expr_field_bool_true_token,
              target: target_model_type_atom_node(
                identity: projection.bool_literal_form.true_token
              )
            ),
            target_model_named_edge(
              name: ^target_value_expr_field_bool_false_token,
              target: target_model_type_atom_node(
                identity: projection.bool_literal_form.false_token
              )
            )
          ]
        )
      ),
      target_model_named_edge(
        name: ^target_value_expr_field_block_eval,
        target: block_evaluation_mode_to_node(
          mode: projection.block_evaluation_mode
        )
      )
    ]
  )
}

