module chunk

fn target_value_expr_arrow_body_scope_binding(
  arrow: Node,
  body: Node,
  binding: Symbol,
  target: TargetModel
) -> Outcome<Symbol> {
  bind_outcome(
    o: arrow_domain_named_param_bindings(arrow: arrow),
    f: fn(bindings) {
      match target_value_expr_param_binding_for_referent(
        referent: binding,
        bindings: bindings,
        target: target
      ) {
        Present { value: scoped } =>
          if target_value_expr_add_signature_matches_for_target(arrow: arrow, target: target)
            || target_value_expr_arrow_has_transform_body(arrow: arrow)
            || target_value_expr_arrow_has_match_body(arrow: arrow) {
            outcome_accepted(scoped)
          } else {
            outcome_rejected(
              target_value_expr_diagnostic(
                reason: ^target_value_expr_reason_body_scope_binding_invalid,
                node: body
              )
            )
          }
        Absent =>
          outcome_rejected(
            target_value_expr_diagnostic(
              reason: ^target_value_expr_reason_body_scope_binding_invalid,
              node: body
            )
          )
      }
    }
  )
}

