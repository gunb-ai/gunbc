module chunk

fn target_value_expr_record_construct_field_slots_from_edges(
  arrow: Node,
  edges: List<Edge>,
  target: TargetModel,
  source_bool_form: TargetBoolLiteralShape,
  handle_transform: fn(Node, Node, TargetModel) -> Outcome<TargetValueExpression>
) -> Outcome<List<TargetValueExprFieldInitSlot>> {
  match fold(
    edges,
    init: Accepted { value: Empty, diagnostics: None },
    f: fn(acc, edge) {
      match acc {
        Rejected { diagnostics: r } => acc
        Accepted { value: slots, diagnostics: d } =>
          match edge.label {
            Named { name: field_label } =>
              bind_outcome(
                o: target_value_expr_project_body_subexpression(
                  arrow: arrow,
                  node: edge.target,
                  target: target,
                  source_bool_form: source_bool_form,
                  handle_transform: handle_transform
                ),
                f: fn(projected_value) {
                  outcome_accepted(
                    list_snoc_item(
                      xs: slots,
                      item: TargetValueExprFieldInitSlot {
                        label: field_label,
                        value: projected_value
                      }
                    )
                  )
                }
              )
            Positional =>
              outcome_rejected(
                target_value_expr_diagnostic(
                  reason: ^target_value_expr_reason_transform_shape_invalid,
                  node: edge.target
                )
              )
          }
      }
    }
  ) {
    Accepted { value: slots, diagnostics: d } => Accepted { value: slots, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

