module chunk

fn target_value_expr_binding_ref_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == ^target_value_expression_binding_ref_atom {
        if name_occurrences(
          name: ^target_value_expr_field_binding,
          children: wire.children
        ) != 1 {
          outcome_rejected(
            target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
          )
        } else {
          match fold(
            wire.children,
            init: true,
            f: fn(acc, edge) {
              if acc {
                match edge.label {
                  Named { name: n } => n == ^target_value_expr_field_binding
                  Positional => false
                }
              } else {
                false
              }
            }
          ) {
            true => outcome_accepted(true)
            false =>
              outcome_rejected(
                target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
              )
          }
        }
      } else {
        outcome_rejected(
          target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
        )
      }
    _ =>
      outcome_rejected(
        target_value_expr_operand_wire_malformed_diagnostic(wire: wire)
      )
  }
}

