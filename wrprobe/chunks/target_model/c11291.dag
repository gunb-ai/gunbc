module chunk

fn target_capability_eligibility_row_from_node(
  node: Node
) -> Outcome<TargetCapabilityEligibilityRow> {
  bind_outcome(
    o: find_named_child(root: node, name: ^target_capability_eligibility_field_capability),
    f: fn(capability_node) {
      bind_outcome(
        o: target_collection_node_atom_identity(node: capability_node),
        f: fn(capability_key) {
          bind_outcome(
            o: find_named_child(
              root: node,
              name: ^target_capability_eligibility_field_kernel_atoms
            ),
            f: fn(atoms_node) {
              bind_outcome(
                o: node_list_from_node(
                  node: atoms_node,
                  decode_item: target_collection_node_atom_identity
                ),
                f: fn(kernel_atoms) {
                  outcome_accepted(
                    TargetCapabilityEligibilityRow {
                      capability_key: capability_key,
                      eligibility: TargetCapabilityElementEligibility {
                        kernel_atoms: kernel_atoms
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

