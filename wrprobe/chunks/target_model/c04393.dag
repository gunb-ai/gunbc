module chunk

fn target_value_expression_effect_apply(
  effect_kind_discriminant: Symbol,
  operands: List<TargetValueExpression>
) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprEffectApply,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_effect_apply_atom }
      },
      children: list_append(
        left: [
          target_model_named_edge(
            name: ^target_value_expr_field_effect_kind,
            target: target_model_type_atom_node(identity: effect_kind_discriminant)
          )
        ],
        right: target_value_expr_primitive_apply_operand_edges(operands: operands)
      ),
      occurrence_id: OccurrenceSynthetic
    }
  }
}

