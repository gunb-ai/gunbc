module chunk

fn target_type_expr_emitted_labeled_slot_edges(node: Node) -> Outcome<List<Edge>> {
  if is_empty(xs: node_positional_child_targets(node: node)) {
    Accepted {
      value: fold(node.children, init: Empty, f: fn(acc, e) {
        match e.label {
          Named { name: n } =>
            if n == ^target_type_expr_field_surface || n == ^target_type_expr_field_kind {
              acc
            } else {
              list_snoc_item(xs: acc, item: e)
            }
          Positional => acc
        }
      }),
      diagnostics: None
    }
  } else {
    outcome_rejected(target_type_expr_emitted_shape_malformed_diagnostic(node: node))
  }
}

