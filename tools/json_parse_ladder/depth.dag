module tools.json_parse_ladder.depth

fn deep(i: Int, n: Int, acc: Int) -> Int {
  if i >= n { acc } else { deep(i: i + 1, n: n, acc: acc + 1) }
}

fn chunks(k: Int, per: Int, acc: Int) -> Int {
  if k <= 0 { acc } else { chunks(k: k - 1, per: per, acc: acc + deep(i: 0, n: per, acc: 0)) }
}

fn deep_20k() -> Int { deep(i: 0, n: 20000, acc: 0) + deep(i: 0, n: 20000, acc: 0) + deep(i: 0, n: 20000, acc: 0) + deep(i: 0, n: 20000, acc: 0) }
fn deep_80k() -> Int { deep(i: 0, n: 80000, acc: 0) }
fn flat_80k() -> Int { chunks(k: 400, per: 200, acc: 0) }
fn flat_320k() -> Int { chunks(k: 1600, per: 200, acc: 0) }
