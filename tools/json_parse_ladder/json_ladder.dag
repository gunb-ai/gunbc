module tools.json_parse_ladder.json_ladder

import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_object_unique_member, JsonMemberFound }
import extdeps.filesystem.filesystem_io
import extdeps.languages.json.emit { JsonObject, serialize_json }

fn members_of(path: String) -> Int {
  let r = filesystem_read(path: path)
  match parse_json_document(s: r.content) {
    JsonDocumentUnreadable { gap: _ } => 0 - 1
    JsonDocumentParsed { value: v } =>
      match json_object_unique_member(v: v, key: "weight_map") {
        JsonMemberFound { value: JsonObject { members: ms } } => count(ms)
        _ => 0 - 2
      }
  }
}

fn n1000() -> Int { members_of(path: "tools/json_parse_ladder/doc_1000.json") }
fn n4000() -> Int { members_of(path: "tools/json_parse_ladder/doc_4000.json") }
fn n16000() -> Int { members_of(path: "tools/json_parse_ladder/doc_16000.json") }
fn n48000() -> Int { members_of(path: "tools/json_parse_ladder/doc_48000.json") }
fn n96000() -> Int { members_of(path: "tools/json_parse_ladder/doc_96000.json") }
fn read_only_96000() -> Int { filesystem_read(path: "tools/json_parse_ladder/doc_96000.json").content.length() }

fn walk_from(s: String, i: Int, n: Int, acc: Int) -> Int {
  if i >= n { acc } else if char_at(s: s, pos: i) == "\"" { walk_from(s: s, i: i + 1, n: n, acc: acc + 1) } else { walk_from(s: s, i: i + 1, n: n, acc: acc) }
}
fn walk_of(path: String) -> Int {
  let t = filesystem_read(path: path).content
  walk_from(s: t, i: 0, n: t.length(), acc: 0)
}
fn w1000() -> Int { walk_of(path: "tools/json_parse_ladder/doc_1000.json") }
fn w4000() -> Int { walk_of(path: "tools/json_parse_ladder/doc_4000.json") }
fn w16000() -> Int { walk_of(path: "tools/json_parse_ladder/doc_16000.json") }
fn w48000() -> Int { walk_of(path: "tools/json_parse_ladder/doc_48000.json") }

fn big_walk_50k() -> Int {
  let t = filesystem_read(path: "tools/json_parse_ladder/doc_96000.json").content
  walk_from(s: t, i: 0, n: 50000, acc: 0)
}
fn small_walk_50k() -> Int {
  let t = substring(s: filesystem_read(path: "tools/json_parse_ladder/doc_96000.json").content, start: 0, end: 50001)
  walk_from(s: t, i: 0, n: 50000, acc: 0)
}
fn big_len_walk(s: String, i: Int, acc: Int) -> Int {
  if i >= 50000 || i >= s.length() { acc } else { big_len_walk(s: s, i: i + 1, acc: acc + 1) }
}
fn big_len_50k() -> Int { big_len_walk(s: filesystem_read(path: "tools/json_parse_ladder/doc_96000.json").content, i: 0, acc: 0) }
fn big_substr_walk(s: String, i: Int, acc: Int) -> Int {
  if i >= 50000 { acc } else { big_substr_walk(s: s, i: i + 1, acc: acc + substring(s: s, start: i, end: i + 1).length()) }
}
fn big_substr_50k() -> Int { big_substr_walk(s: filesystem_read(path: "tools/json_parse_ladder/doc_96000.json").content, i: 0, acc: 0) }

fn reserialized(path: String) -> String {
  match parse_json_document(s: filesystem_read(path: path).content) {
    JsonDocumentUnreadable { gap: _ } => "UNREADABLE"
    JsonDocumentParsed { value: v } => serialize_json(v: v)
  }
}
fn rs1000() -> String { reserialized(path: "tools/json_parse_ladder/doc_1000.json") }
fn rs16000() -> String { reserialized(path: "tools/json_parse_ladder/doc_16000.json") }
