module phb_rows
import std.types { String, Int, List, Bool }
import std.algebra { list_map, collection_join_shape }
import std.process { ProcessExit, exit_failure }
import gunbc.compile_diagnostic_census { CensusObserved, CensusNotRunnable, CompileDiagnosticCensusRow }
import test.claim.nominal_host_text_argument_wall_witness { concat_record_source,concat_coproduct_unit_source,concat_coproduct_record_arm_source,join_record_elements_source,join_coproduct_elements_source,join_record_separator_source,join_coproduct_separator_source,string_length_record_source,control_string_source,control_non_empty_source,control_declared_conversion_source,control_kernel_scalars_source,control_local_join_parameter_source }
fn row_text(r: CompileDiagnosticCensusRow) -> String {
  concat(r.diagnostic_class, "|", r.subject_name, "|", if r.blocking { "B" } else { "a" })
}
fn rows_text(name: String, source: String) -> String {
  match compile_dag_diagnostic_census(source) {
    CensusObserved { rows: rows } => concat("ROWS ", name, ": ", join(rows |> map(r => row_text(r: r)), " ;; "))
    CensusNotRunnable { cause: c } => concat("ROWS ", name, ": NOTRUNNABLE ", c)
  }
}
fn main() -> ProcessExit { exit_failure(reason: join([rows_text(name: "concat_record_source", source: concat_record_source), rows_text(name: "concat_coproduct_unit_source", source: concat_coproduct_unit_source), rows_text(name: "concat_coproduct_record_arm_source", source: concat_coproduct_record_arm_source), rows_text(name: "join_record_elements_source", source: join_record_elements_source), rows_text(name: "join_coproduct_elements_source", source: join_coproduct_elements_source), rows_text(name: "join_record_separator_source", source: join_record_separator_source), rows_text(name: "join_coproduct_separator_source", source: join_coproduct_separator_source), rows_text(name: "string_length_record_source", source: string_length_record_source), rows_text(name: "control_string_source", source: control_string_source), rows_text(name: "control_non_empty_source", source: control_non_empty_source), rows_text(name: "control_declared_conversion_source", source: control_declared_conversion_source), rows_text(name: "control_kernel_scalars_source", source: control_kernel_scalars_source), rows_text(name: "control_local_join_parameter_source", source: control_local_join_parameter_source)], "\n")) }
