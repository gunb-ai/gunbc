+/// What the cost partition's verdict contributes to the batch exit. An accounting that
+/// contradicts itself (rows past the parent, a nested span, in-span time past the thread
+/// total) is a measurement that did not hold: it fails the line, so a Refused verdict is never
+/// printed and then ignored. `NoSpans` made no observation at all, which is exit 2's meaning.
+/// Returns `(unobserved, failed)`.
+fn partition_exit_flags(verdict: &v1_compiler::cli_run::CostAccountingVerdict) -> (bool, bool) {
+    use v1_compiler::cli_run::{CostAccountingRefusal, CostAccountingVerdict};
+    match verdict {
+        CostAccountingVerdict::Reconciled { .. } => (false, false),
+        CostAccountingVerdict::Refused {
+            cause: CostAccountingRefusal::NoSpans,
+        } => (true, false),
+        CostAccountingVerdict::Refused { .. } => (false, true),
+    }
+}
