    && id_in_list(id: "obl-lang-support-registry OPEN", ids: view)
    && id_in_list(id: "obl-lang-no-new-debt-gate OPEN", ids: view)
    && id_in_list(id: "obl-ts-product-browser-profile OPEN", ids: view)
    && id_in_list(id: "obl-spice-simulation-profile OPEN", ids: view)
    && !id_in_list(id: "obl-ts-product-browser-profile BOUND", ids: view)
    && strategy_blocker_count(obligation_id: "obl-ts-product-browser-profile", prerequisites: obligation_prerequisites) > 0
    && !strategy_blockers_discharged(obligation_id: "obl-ts-product-browser-profile", current_digest: d, prerequisites: obligation_prerequisites, bindings: work_contributions, observations: work_observations)
    && strategy_blocker_count(obligation_id: "obl-lang-status-projection", prerequisites: obligation_prerequisites) > 0
    && (match strategy_contract_completion(contract: lc, decompositions: program_decompositions, bindings: work_contributions, observations: work_observations) {
      ContractComplete => false
      ContractCompletionRefused { cause } =>
        match cause {
          DecompositionPartial => true
          DecompositionMissing => false
          DecompositionNotSingular => false
          DecompositionStale => false
          ObligationUnbound { obligation_id } => false
          ObligationUndischarged { obligation_id } => false
        }
    })
    && (match authorize_work(question_id: "lang-ecmascript-authority", decisions: decisions) {
      Authorized => false
      AuthorizationRefused { cause } =>
        match cause {
          DecisionNotSelected => true
          DecisionNotFound => false
          DecisionSuperseded => false
        }
    })
    && (match authorize_work(question_id: "lang-cpp-profile", decisions: decisions) {
      Authorized => false
      AuthorizationRefused { cause } =>
        match cause {
          DecisionNotSelected => true
          DecisionNotFound => false
          DecisionSuperseded => false
        }
    })
}

fn witness_licensing_fee_curve_and_anti_engineering_holds() -> Bool {
  enterprise_fee_usd(group_revenue_usd40k: 0) == 0
    && enterprise_fee_usd(group_revenue_usd40k: 2475) == 0
    && enterprise_fee_usd(group_revenue_usd40k: 2500) == 0
    && enterprise_fee_usd(group_revenue_usd40k: 5000) == 10000
    && enterprise_fee_usd(group_revenue_usd40k: 12500) == 40000
    && enterprise_fee_usd(group_revenue_usd40k: 25000) == 90000
    && enterprise_fee_usd(group_revenue_usd40k: 125000) == 290000
    && enterprise_fee_usd(group_revenue_usd40k: 250000) == 540000
    && enterprise_fee_usd(group_revenue_usd40k: 500000) == 790000
    && enterprise_fee_usd(group_revenue_usd40k: 710000) == 1000000
    && enterprise_fee_usd(group_revenue_usd40k: 25000000) == 1000000
    && (enterprise_fee_usd(group_revenue_usd40k: 2501) - enterprise_fee_usd(group_revenue_usd40k: 2500)) == 4
    && (enterprise_fee_usd(group_revenue_usd40k: 25001) - enterprise_fee_usd(group_revenue_usd40k: 25000)) == 2
    && (enterprise_fee_usd(group_revenue_usd40k: 250001) - enterprise_fee_usd(group_revenue_usd40k: 250000)) == 1
    && (enterprise_fee_usd(group_revenue_usd40k: 710001) - enterprise_fee_usd(group_revenue_usd40k: 710000)) == 0
    && enterprise_fee_usd(group_revenue_usd40k: 24750) == 89000
    && (enterprise_fee_usd(group_revenue_usd40k: 30000) - enterprise_fee_usd(group_revenue_usd40k: 27500)) == 5000
}

// EVERY CLAIM BODY IN THIS FILE IS INVOKED FROM HERE, EACH ON ITS OWN LINE. Each claim is an
// ordinary `_holds` fn with a one-line `test fn` enrolment wrapper, so this entry point calls the
// body and never references test code; a body this entry point
// never calls is a declaration nothing executes: until this change all but three of these were
// exactly that, behind a resolve failure that stopped the whole module. Each body prints `name=pass`
// or `error: name=FAIL`, so the cause-locked KnownRed row in strategy.private_witness_workflow can
// name the exact witness that is red, a newly red body surfaces as an UNDECLARED FAILURE, and a
// repaired one as CAUSE DRIFT -- the same grain ci_economics_frontier uses. The name strings in the
// report are the second list of these names that .dag's lack of reflection forces.
fn strategy_body_line(name: NonEmptyStr, b: Bool) -> NonEmptyStr {
  if b {
    join([name, "=pass"], "")
  } else {
    join(["error: ", name, "=FAIL"], "")
  }
}

// Each body is evaluated ONCE: the report and the verdict read the same thirty-one results, so they
// cannot disagree about what ran, and no witness is paid for twice.
fn strategy_witness_main() -> ProcessExit {
  let r0 = witness_graph_ids_unique_and_relations_resolve_holds()
  let r1 = witness_wipe_target_carries_four_invariants_holds()
  let r2 = witness_decision_states_match_operator_rulings_holds()
  let r3 = witness_work_authorization_verdicts_holds()
  let r4 = witness_claims_unsupported_today_and_flip_with_evidence_holds()
  let r5 = witness_journey_stage_is_derived_from_receipts_holds()
  let r6 = witness_journey_refusals_are_typed_holds()
  let r7 = witness_forecast_derives_and_refuses_holds()
  let r8 = witness_experiment_stop_condition_cannot_be_silently_continued_holds()
  let r9 = witness_every_active_roadmap_lane_has_strategic_reason_holds()
  let r10 = witness_node_grain_bindings_target_real_roadmap_nodes_holds()
  let r11 = witness_capability_evidence_consistent_with_public_authority_holds()
  let r12 = witness_first_partner_is_self_and_stage_derives_from_real_receipts_holds()
  let r13 = witness_timeline_eras_and_events_resolve_with_evidence_holds()
  let r14 = witness_lineage_two_rust_to_dag_successions_holds()
  let r15 = witness_present_state_is_derived_never_stored_holds()
  let r16 = witness_projection_grounded_in_strategy_without_fabricated_dates_holds()
  let r17 = witness_cadence_tangent_readings_cover_all_windows_and_align_holds()
  let r18 = witness_instantiation_counts_and_honest_emptiness_holds()
  let r19 = witness_program_contract_graph_resolves_holds()
  let r20 = witness_binding_discharges_exact_obligation_never_neighbor_holds()
  let r21 = witness_contract_amendment_invalidates_stale_bindings_holds()
  let r22 = witness_contract_completion_refuses_below_complete_holds()
  let r23 = witness_program_view_is_derived_projection_holds()
  let r24 = witness_child_discharge_unblocks_without_advancing_holds()
  let r25 = witness_measurement_readiness_derived_not_assumed_holds()
  let r26 = witness_unrelated_work_carries_no_selfhost_binding_holds()
  let r27 = witness_unestablished_modules_refuse_completeness_holds()
  let r28 = witness_observed_capability_ids_are_declared_holds()
  let r29 = witness_language_support_contract_open_and_gated_holds()
  let r30 = witness_licensing_fee_curve_and_anti_engineering_holds()
  let report = join([
    strategy_body_line(name: "witness_graph_ids_unique_and_relations_resolve", b: r0),
    "\n",
    strategy_body_line(name: "witness_wipe_target_carries_four_invariants", b: r1),
    "\n",
    strategy_body_line(name: "witness_decision_states_match_operator_rulings", b: r2),
    "\n",
    strategy_body_line(name: "witness_work_authorization_verdicts", b: r3),
    "\n",
    strategy_body_line(name: "witness_claims_unsupported_today_and_flip_with_evidence", b: r4),
    "\n",
    strategy_body_line(name: "witness_journey_stage_is_derived_from_receipts", b: r5),
    "\n",
    strategy_body_line(name: "witness_journey_refusals_are_typed", b: r6),
    "\n",
    strategy_body_line(name: "witness_forecast_derives_and_refuses", b: r7),
    "\n",
    strategy_body_line(name: "witness_experiment_stop_condition_cannot_be_silently_continued", b: r8),
    "\n",
    strategy_body_line(name: "witness_every_active_roadmap_lane_has_strategic_reason", b: r9),
    "\n",
    strategy_body_line(name: "witness_node_grain_bindings_target_real_roadmap_nodes", b: r10),
    "\n",
    strategy_body_line(name: "witness_capability_evidence_consistent_with_public_authority", b: r11),
    "\n",
    strategy_body_line(name: "witness_first_partner_is_self_and_stage_derives_from_real_receipts", b: r12),
    "\n",
    strategy_body_line(name: "witness_timeline_eras_and_events_resolve_with_evidence", b: r13),
    "\n",
    strategy_body_line(name: "witness_lineage_two_rust_to_dag_successions", b: r14),
    "\n",
    strategy_body_line(name: "witness_present_state_is_derived_never_stored", b: r15),
    "\n",
    strategy_body_line(name: "witness_projection_grounded_in_strategy_without_fabricated_dates", b: r16),
    "\n",
    strategy_body_line(name: "witness_cadence_tangent_readings_cover_all_windows_and_align", b: r17),
    "\n",
    strategy_body_line(name: "witness_instantiation_counts_and_honest_emptiness", b: r18),
    "\n",
    strategy_body_line(name: "witness_program_contract_graph_resolves", b: r19),
    "\n",
    strategy_body_line(name: "witness_binding_discharges_exact_obligation_never_neighbor", b: r20),
    "\n",
    strategy_body_line(name: "witness_contract_amendment_invalidates_stale_bindings", b: r21),
    "\n",
    strategy_body_line(name: "witness_contract_completion_refuses_below_complete", b: r22),
    "\n",
    strategy_body_line(name: "witness_program_view_is_derived_projection", b: r23),
    "\n",
    strategy_body_line(name: "witness_child_discharge_unblocks_without_advancing", b: r24),
    "\n",
    strategy_body_line(name: "witness_measurement_readiness_derived_not_assumed", b: r25),
    "\n",
    strategy_body_line(name: "witness_unrelated_work_carries_no_selfhost_binding", b: r26),
    "\n",
    strategy_body_line(name: "witness_unestablished_modules_refuse_completeness", b: r27),
    "\n",
    strategy_body_line(name: "witness_observed_capability_ids_are_declared", b: r28),
    "\n",
    strategy_body_line(name: "witness_language_support_contract_open_and_gated", b: r29),
    "\n",
    strategy_body_line(name: "witness_licensing_fee_curve_and_anti_engineering", b: r30),
  ], "")
  if r0 && r1 && r2 && r3 && r4 && r5 && r6 && r7 && r8 && r9 && r10 && r11 && r12 && r13 && r14 && r15 && r16 && r17 && r18 && r19 && r20 && r21 && r22 && r23 && r24 && r25 && r26 && r27 && r28 && r29 && r30 {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: report }
  }
}

