  count(view) == 11
    && id_in_list(id: "obl-lang-support-registry OPEN", ids: view)
    && id_in_list(id: "obl-lang-no-new-debt-gate OPEN", ids: view)
    && id_in_list(id: "obl-ts-product-browser-profile OPEN", ids: view)
    && id_in_list(id: "obl-spice-simulation-profile OPEN", ids: view)
    && !id_in_list(id: "obl-ts-product-browser-profile BOUND", ids: view)
    && strategy_blocker_count(obligation_id: "obl-ts-product-browser-profile", prerequisites: obligation_prerequisites) == 1
    && !strategy_blockers_discharged(obligation_id: "obl-ts-product-browser-profile", current_digest: d, prerequisites: obligation_prerequisites, bindings: work_contributions, observations: work_observations)
    && strategy_blocker_count(obligation_id: "obl-lang-status-projection", prerequisites: obligation_prerequisites) == 1
    && (match strategy_contract_completion(contract: lc, decompositions: program_decompositions, bindings: work_contributions, observations: work_observations) {
      ContractComplete => false
      ContractCompletionRefused { cause } =>
        match cause {
          DecompositionPartial => true
          DecompositionMissing => false
          DecompositionNotSingular => false
          DecompositionStale => false
          ObligationUnbound { obligation_id } => false
          ObligationUndischarged { obligation_id } => false
        }
    })
    && (match authorize_work(question_id: "lang-ecmascript-authority", decisions: decisions) {
      Authorized => false
      AuthorizationRefused { cause } =>
        match cause {
          DecisionNotSelected => true
          DecisionNotFound => false
          DecisionSuperseded => false
        }
    })
    && (match authorize_work(question_id: "lang-cpp-profile", decisions: decisions) {
      Authorized => false
      AuthorizationRefused { cause } =>
        match cause {
          DecisionNotSelected => true
          DecisionNotFound => false
          DecisionSuperseded => false
        }
    })
}

test fn witness_licensing_fee_curve_and_anti_engineering() -> Bool {
  enterprise_fee_usd(group_revenue_usd40k: 0) == 0
    && enterprise_fee_usd(group_revenue_usd40k: 2475) == 0
    && enterprise_fee_usd(group_revenue_usd40k: 2500) == 0
    && enterprise_fee_usd(group_revenue_usd40k: 5000) == 10000
    && enterprise_fee_usd(group_revenue_usd40k: 12500) == 40000
    && enterprise_fee_usd(group_revenue_usd40k: 25000) == 90000
    && enterprise_fee_usd(group_revenue_usd40k: 125000) == 290000
    && enterprise_fee_usd(group_revenue_usd40k: 250000) == 540000
    && enterprise_fee_usd(group_revenue_usd40k: 500000) == 790000
    && enterprise_fee_usd(group_revenue_usd40k: 710000) == 1000000
    && enterprise_fee_usd(group_revenue_usd40k: 25000000) == 1000000
    && (enterprise_fee_usd(group_revenue_usd40k: 2501) - enterprise_fee_usd(group_revenue_usd40k: 2500)) == 4
    && (enterprise_fee_usd(group_revenue_usd40k: 25001) - enterprise_fee_usd(group_revenue_usd40k: 25000)) == 2
    && (enterprise_fee_usd(group_revenue_usd40k: 250001) - enterprise_fee_usd(group_revenue_usd40k: 250000)) == 1
    && (enterprise_fee_usd(group_revenue_usd40k: 710001) - enterprise_fee_usd(group_revenue_usd40k: 710000)) == 0
    && enterprise_fee_usd(group_revenue_usd40k: 24750) == 89000
    && (enterprise_fee_usd(group_revenue_usd40k: 30000) - enterprise_fee_usd(group_revenue_usd40k: 27500)) == 5000
}

// A PROCESS-EXIT ENTRY POINT, authored even though this module does not currently RESOLVE, so the
// actuator's known-red row fails for the reason it names. Without it the roster would point at a
// symbol that does not exist, and a missing function and a genuinely red claim would produce the
// identical nonzero exit -- a masked run and a measured one rendering the same, which is the
// execution-provenance loss DESIGN names. With it, the nonzero comes from the closure refusing on
// compiler_frontier_roster, which is what the row says.
fn strategy_witness_main() -> ProcessExit {
  if witness_graph_ids_unique_and_relations_resolve() { ExitSuccess } else { ExitFailure { code: 1, reason: "witness_graph_ids_unique_and_relations_resolve returned false" } }
}
