test fn witness_contract_amendment_invalidates_stale_bindings() -> Bool {
  let contract = program_first_contract()
  let current = strategy_contract_digest(c: contract)
  let am = program_first_amendment()
  let stale_specimen = WorkContribution {
    id: "wc-stale-control",
    work_ref: "gunb-ai/gunbc#7599",
    obligation_id: "obl-native-witness-execution",
    kind: DischargesObligation,
    maximum_conclusion: "negative control: bound against the pre-amendment five-minute criteria",
    parent_criteria_digest: strategy_criteria_digest(criteria: am.previous_criteria),
  }
  all(work_contributions, b =>
      match strategy_contribution_status(b: b, contract: program_contract_for_obligation(obligation_id: b.obligation_id), observations: work_observations) {
        ContributionStale { bound_digest, current_digest } => false
        ContributionUnobserved => false
        ContributionObserved { outcome, observed_on } => !(observed_on == "")
      })
    && (match strategy_contribution_status(b: stale_specimen, contract: contract, observations: work_observations) {
      ContributionStale { bound_digest, current_digest } => current_digest == current && !(bound_digest == current)
      ContributionUnobserved => false
      ContributionObserved { outcome, observed_on } => false
    })
    && !(strategy_criteria_digest(criteria: am.previous_criteria) == current)
}

test fn witness_contract_completion_refuses_below_complete() -> Bool {
  let contract = program_first_contract()
  let real = strategy_contract_completion(contract: contract, decompositions: program_decompositions, bindings: work_contributions, observations: work_observations)
  let syn_receipt = DecisionReceipt { authority: "operator", decided_on: "2026-08-02", rationale: "synthetic positive control" }
  let syn_contract = StrategicContract { id: "syn-contract", statement: "synthetic", acceptance_criteria: ["only clause"], constraint_ids: [], adoption: syn_receipt }
  let syn_digest = strategy_contract_digest(c: syn_contract)
  let syn_dec = ProgramDecomposition { id: "syn-dec", parent_contract: "syn-contract", parent_criteria_digest: syn_digest, child_obligation_ids: ["syn-obl"], composition_rule: "single child", coverage: CompleteCoverage { receipt: syn_receipt } }
  let syn_binding = WorkContribution { id: "syn-wc", work_ref: "syn#1", obligation_id: "syn-obl", kind: DischargesObligation, maximum_conclusion: "synthetic", parent_criteria_digest: syn_digest }
  let syn_landed = ObservationReceipt { id: "syn-ob", subject: "syn#1", observed_on: "2026-08-02", subject_revision: "syn", outcome: ObservedLanded, result: "synthetic landed", evidence: EvidenceAnchor { repo: "x", reference: "y", note: "" } }
  let syn_open = ObservationReceipt { id: "syn-ob2", subject: "syn#1", observed_on: "2026-08-02", subject_revision: "syn", outcome: ObservedInFlight, result: "synthetic open", evidence: EvidenceAnchor { repo: "x", reference: "y", note: "" } }
  let stale_dec = ProgramDecomposition { id: "syn-dec-stale", parent_contract: "syn-contract", parent_criteria_digest: "criteria|outdated clause", child_obligation_ids: ["syn-obl"], composition_rule: "single child", coverage: CompleteCoverage { receipt: syn_receipt } }
  (match real {
    ContractComplete => false
    ContractCompletionRefused { cause } =>
      match cause {
        DecompositionPartial => true
        DecompositionMissing => false
        DecompositionNotSingular => false
        DecompositionStale => false
        ObligationUnbound { obligation_id } => false
        ObligationUndischarged { obligation_id } => false
      }
  })
    && (match strategy_contract_completion(contract: syn_contract, decompositions: [syn_dec], bindings: [syn_binding], observations: [syn_landed]) {
      ContractComplete => true
      ContractCompletionRefused { cause } => false
    })
    && (match strategy_contract_completion(contract: syn_contract, decompositions: [], bindings: [syn_binding], observations: [syn_landed]) {
      ContractComplete => false
      ContractCompletionRefused { cause } =>
        match cause {
          DecompositionMissing => true
          DecompositionNotSingular => false
          DecompositionStale => false
          DecompositionPartial => false
          ObligationUnbound { obligation_id } => false
          ObligationUndischarged { obligation_id } => false
        }
    })
    && (match strategy_contract_completion(contract: syn_contract, decompositions: [stale_dec], bindings: [syn_binding], observations: [syn_landed]) {
      ContractComplete => false
      ContractCompletionRefused { cause } =>
        match cause {
          DecompositionStale => true
          DecompositionMissing => false
          DecompositionNotSingular => false
          DecompositionPartial => false
          ObligationUnbound { obligation_id } => false
          ObligationUndischarged { obligation_id } => false
        }
    })
    && (match strategy_contract_completion(contract: syn_contract, decompositions: [syn_dec], bindings: [], observations: [syn_landed]) {
      ContractComplete => false
      ContractCompletionRefused { cause } =>
        match cause {
          ObligationUnbound { obligation_id } => obligation_id == "syn-obl"
          DecompositionMissing => false
          DecompositionNotSingular => false
          DecompositionStale => false
          DecompositionPartial => false
          ObligationUndischarged { obligation_id } => false
        }
    })
    && (match strategy_contract_completion(contract: syn_contract, decompositions: [syn_dec], bindings: [syn_binding], observations: [syn_open]) {
      ContractComplete => false
      ContractCompletionRefused { cause } =>
        match cause {
          ObligationUndischarged { obligation_id } => obligation_id == "syn-obl"
          DecompositionMissing => false
          DecompositionNotSingular => false
          DecompositionStale => false
          DecompositionPartial => false
          ObligationUnbound { obligation_id } => false
        }
    })
}

test fn witness_program_view_is_derived_projection() -> Bool {
  let contract = program_first_contract()
  let view = strategy_program_view(contract: contract, obligations: program_obligations, bindings: work_contributions)
  let planted = concat(work_contributions, [WorkContribution {
    id: "wc-syn-preindex",
    work_ref: "syn#2",
    obligation_id: "obl-pre-index-lookup",
    kind: DischargesObligation,
    maximum_conclusion: "synthetic plant proving the view is derived",
    parent_criteria_digest: strategy_contract_digest(c: contract),
  }])
  let view2 = strategy_program_view(contract: contract, obligations: program_obligations, bindings: planted)
  count(view) == 7
    && id_in_list(id: "obl-exact-affected-closure OPEN", ids: view)
    && id_in_list(id: "obl-semantic-input-identity OPEN", ids: view)
    && id_in_list(id: "obl-pre-index-lookup OPEN", ids: view)
    && id_in_list(id: "obl-counted-fallback OPEN", ids: view)
    && id_in_list(id: "obl-native-witness-execution BOUND", ids: view)
    && id_in_list(id: "obl-cross-invocation-reuse BOUND", ids: view)
    && id_in_list(id: "obl-no-duplicate-stage-work BOUND", ids: view)
    && id_in_list(id: "obl-pre-index-lookup BOUND", ids: view2)
    && !id_in_list(id: "obl-pre-index-lookup OPEN", ids: view2)
}

