test fn witness_child_discharge_unblocks_without_advancing() -> Bool {
  let sh = program_selfhost_contract()
  let d = strategy_contract_digest(c: sh)
  let view = strategy_program_view(contract: sh, obligations: program_obligations, bindings: work_contributions)
  let synthetic_missing_blocker = concat(obligation_prerequisites, [ObligationPrerequisite { blocker_obligation: "obl-direct-rust-output-door", blocked_obligation: "obl-remaining-stages-self-emit" }])
  strategy_obligation_bound_fresh(obligation_id: "obl-translate-instantiation-wrap-decision", current_digest: d, bindings: work_contributions)
    && strategy_obligation_discharge_observed(obligation_id: "obl-translate-instantiation-wrap-decision", current_digest: d, bindings: work_contributions, observations: work_observations)
    && !strategy_obligation_bound_fresh(obligation_id: "obl-remaining-stages-self-emit", current_digest: d, bindings: work_contributions)
    && !strategy_obligation_discharge_observed(obligation_id: "obl-remaining-stages-self-emit", current_digest: d, bindings: work_contributions, observations: work_observations)
    && strategy_blocker_count(obligation_id: "obl-remaining-stages-self-emit", prerequisites: obligation_prerequisites) == 1
    && strategy_blockers_discharged(obligation_id: "obl-remaining-stages-self-emit", current_digest: d, prerequisites: obligation_prerequisites, bindings: work_contributions, observations: work_observations)
    && !strategy_blockers_discharged(obligation_id: "obl-remaining-stages-self-emit", current_digest: d, prerequisites: synthetic_missing_blocker, bindings: work_contributions, observations: work_observations)
    && count(view) == 6
    && id_in_list(id: "obl-translate-instantiation-wrap-decision BOUND", ids: view)
    && id_in_list(id: "obl-frontier-classifier-totality BOUND", ids: view)
    && id_in_list(id: "obl-direct-rust-output-door OPEN", ids: view)
    && id_in_list(id: "obl-first-module-behavioral-replacement OPEN", ids: view)
    && id_in_list(id: "obl-emitter-bootstrap-generations OPEN", ids: view)
    && id_in_list(id: "obl-remaining-stages-self-emit OPEN", ids: view)
    && (match strategy_contract_completion(contract: sh, decompositions: program_decompositions, bindings: work_contributions, observations: work_observations) {
      ContractComplete => false
      ContractCompletionRefused { cause } =>
        match cause {
          DecompositionPartial => true
          DecompositionMissing => false
          DecompositionNotSingular => false
          DecompositionStale => false
          ObligationUnbound { obligation_id } => false
          ObligationUndischarged { obligation_id } => false
        }
    })
    && (match strategy_contract_completion(contract: program_contract_by_id(id: "contract-v2-production-cutover"), decompositions: program_decompositions, bindings: work_contributions, observations: work_observations) {
      ContractComplete => false
      ContractCompletionRefused { cause } =>
        match cause {
          DecompositionMissing => true
          DecompositionNotSingular => false
          DecompositionStale => false
          DecompositionPartial => false
          ObligationUnbound { obligation_id } => false
          ObligationUndischarged { obligation_id } => false
        }
    })
}

fn program_binding_measures_decision(binding_id: String, question_id: String) -> Bool {
  fold(work_contributions, init: false, f: fn(acc, b) {
    acc
      || (b.id == binding_id
            && match b.kind {
              MeasurementForDecision { decision_question_id } => decision_question_id == question_id
              DischargesObligation => false
              PreservesAcceptedState => false
              BoundedExploration { bound } => false
              ClosesPrerequisite => false
            })
  })
}

test fn witness_measurement_readiness_derived_not_assumed() -> Bool {
  let sh = program_selfhost_contract()
  let d = strategy_contract_digest(c: sh)
  let planted_census = concat(work_observations, [ObservationReceipt {
    id: "ob-syn-census",
    subject: corrected_census_subject,
    observed_on: "2026-08-02",
    subject_revision: "syn",
    outcome: ObservedLanded,
    result: "synthetic control: a landed census observation flips readiness",
    evidence: EvidenceAnchor { repo: "x", reference: "y", note: "" },
  }])
  (match strategy_measurement_readiness(subject: corrected_census_subject, observations: work_observations) {
    MeasurementAbsent { missing } => missing == corrected_census_subject
    MeasurementPresent { observation_id } => false
  })
    && (match strategy_measurement_readiness(subject: corrected_census_subject, observations: planted_census) {
      MeasurementPresent { observation_id } => observation_id == "ob-syn-census"
      MeasurementAbsent { missing } => false
    })
    && !program_binding_measures_decision(binding_id: "wc-7627-lane-e-census", question_id: "first-module-selection")
    && !strategy_obligation_discharge_observed(obligation_id: "obl-first-module-behavioral-replacement", current_digest: d, bindings: work_contributions, observations: work_observations)
    && (match authorize_work(question_id: "first-module-selection", decisions: decisions) {
      Authorized => false
      AuthorizationRefused { cause } =>
        match cause {
          DecisionNotFound => true
          DecisionNotSelected => false
          DecisionSuperseded => false
        }
    })
}

