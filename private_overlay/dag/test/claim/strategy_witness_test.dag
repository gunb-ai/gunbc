fn capability_id_known(id: String) -> Bool {
  fold(capabilities, init: false, f: fn(acc, c) { acc || c.id == id })
}

fn hypothesis_id_known(id: String) -> Bool {
  fold(hypotheses, init: false, f: fn(acc, h) { acc || h.id == id })
}

fn outcome_id_known(id: String) -> Bool {
  fold(outcomes, init: false, f: fn(acc, o) { acc || o.id == id })
}

fn segment_id_known(id: String) -> Bool {
  fold(market_segments, init: false, f: fn(acc, s) { acc || s.id == id })
}

fn capability_count_with_id(id: String) -> Nat {
  fold(capabilities, init: 0, f: fn(acc, c) { if c.id == id { acc + 1 } else { acc } })
}

fn decision_count_with_question(id: String) -> Nat {
  fold(decisions, init: 0, f: fn(acc, d) { if d.question_id == id { acc + 1 } else { acc } })
}

test fn witness_graph_ids_unique_and_relations_resolve() -> Bool {
  count(visions) == 1
    && count(capabilities) == 6
    && count(decisions) == 8
    && all(capabilities, c => capability_count_with_id(id: c.id) == 1)
    && all(decisions, d => decision_count_with_question(id: d.question_id) == 1)
    && all(experience_targets, t => capability_id_known(id: t.exposes_capability_id))
    && all(experiments, e => hypothesis_id_known(id: e.tests_hypothesis_id))
    && all(realizes_rows, r => capability_id_known(id: r.capability_id) && outcome_id_known(id: r.outcome_id))
    && all(roadmap_bindings, b => capability_id_known(id: b.delivers_capability_id))
    && all(product_claims, c => segment_id_known(id: c.segment_id) && all(c.requires_capability_ids, r => capability_id_known(id: r)))
}

test fn witness_wipe_target_carries_four_invariants() -> Bool {
  count(experience_targets) == 1
    && all(experience_targets, t =>
         count(t.invariants) == 4
           && id_in_list(id: "PlaintextAbsentBeforeAuthorization", ids: t.invariants)
           && id_in_list(id: "GestureDoesNotConferAuthority", ids: t.invariants))
}

fn decision_selected_as(d: StrategicDecision, expected_choice: String) -> Bool {
  match d.state {
    Selected { choice_id, receipt } => choice_id == expected_choice && receipt.authority == "operator"
    Open => false
    SupersededBy { question_id } => false
    RefusedDecision { reason } => false
  }
}

fn decision_is_open(d: StrategicDecision) -> Bool {
  match d.state {
    Open => true
    Selected { choice_id, receipt } => false
    SupersededBy { question_id } => false
    RefusedDecision { reason } => false
  }
}

test fn witness_decision_states_match_operator_rulings() -> Bool {
  all(decisions, d =>
    if d.question_id == "first-world" { decision_selected_as(d: d, expected_choice: "gunbc-dogfood") }
    else {
      if d.question_id == "roadmap-visibility" { decision_selected_as(d: d, expected_choice: "keep-public-for-now") }
      else {
        if d.question_id == "dashboard-host-surface" { decision_selected_as(d: d, expected_choice: "gunbc-served-dashboard-lane") }
        else {
          if d.question_id == "actor-model-scope" { decision_selected_as(d: d, expected_choice: "thin-projection") }
          else { decision_is_open(d: d) }
        }
      }
    })
}

test fn witness_work_authorization_verdicts() -> Bool {
  let superseded = StrategicDecision {
    question_id: "old-question",
    question: "superseded synthetic",
    alternatives: [],
    criteria: [],
    state: SupersededBy { question_id: "first-world" },
  }
  let with_synthetic = concat(decisions, [superseded])
  (match authorize_work(question_id: "first-world", decisions: decisions) {
    Authorized => true
    AuthorizationRefused { cause } => false
  })
    && (match authorize_work(question_id: "licensing-model", decisions: decisions) {
      Authorized => false
      AuthorizationRefused { cause } =>
        match cause {
          DecisionNotSelected => true
          DecisionNotFound => false
          DecisionSuperseded => false
        }
    })
    && (match authorize_work(question_id: "old-question", decisions: with_synthetic) {
      Authorized => false
      AuthorizationRefused { cause } =>
        match cause {
          DecisionSuperseded => true
          DecisionNotFound => false
          DecisionNotSelected => false
        }
    })
    && (match authorize_work(question_id: "never-declared", decisions: decisions) {
      Authorized => false
      AuthorizationRefused { cause } =>
        match cause {
          DecisionNotFound => true
          DecisionNotSelected => false
          DecisionSuperseded => false
        }
    })
}

test fn witness_claims_unsupported_today_and_flip_with_evidence() -> Bool {
  let full = ["audience-scoped-node-disclosure", "sealed-execution"]
  all(product_claims, c =>
    match claim_status(claim: c, observed_capability_ids: observed_capability_id_list()) {
      ClaimSupported => false
      ClaimUnsupported { missing_capability_ids } => count(missing_capability_ids) == count(c.requires_capability_ids)
    })
    && all(product_claims, c =>
      match claim_status(claim: c, observed_capability_ids: full) {
        ClaimSupported => true
        ClaimUnsupported { missing_capability_ids } => false
      })
}

test fn witness_journey_stage_is_derived_from_receipts() -> Bool {
  let no_receipts = derive_stage(rules: design_partner_rules, initial_stage_id: "identified", receipts: [])
  let three = derive_stage(rules: design_partner_rules, initial_stage_id: "identified", receipts: [
    StepReceipt { from_id: "identified", to_id: "qualified", receipt_kind: "QualifiedPartnerReceipt", evidence: "synthetic" },
    StepReceipt { from_id: "qualified", to_id: "problem-confirmed", receipt_kind: "ProblemInterviewReceipt", evidence: "synthetic" },
    StepReceipt { from_id: "problem-confirmed", to_id: "shadow-connected", receipt_kind: "ShadowInstallationReceipt", evidence: "synthetic" },
  ])
  (match no_receipts {
    ProgressAt { stage_id } => stage_id == "identified"
    ProgressStopped { cause } => false
    ProgressRefused { cause } => false
  })
    && (match three {
      ProgressAt { stage_id } => stage_id == "shadow-connected"
      ProgressStopped { cause } => false
      ProgressRefused { cause } => false
    })
}

test fn witness_journey_refusals_are_typed() -> Bool {
  let skip = derive_stage(rules: design_partner_rules, initial_stage_id: "identified", receipts: [
    StepReceipt { from_id: "qualified", to_id: "problem-confirmed", receipt_kind: "ProblemInterviewReceipt", evidence: "synthetic" },
  ])
  let wrong_kind = derive_stage(rules: design_partner_rules, initial_stage_id: "identified", receipts: [
    StepReceipt { from_id: "identified", to_id: "qualified", receipt_kind: "SomeOtherReceipt", evidence: "synthetic" },
  ])
  let stopped = derive_stage(rules: design_partner_rules, initial_stage_id: "identified", receipts: [
    StopReceipt { cause: TrustBoundaryRejected, evidence: "synthetic" },
  ])
  let after_stop = derive_stage(rules: design_partner_rules, initial_stage_id: "identified", receipts: [
    StopReceipt { cause: TrustBoundaryRejected, evidence: "synthetic" },
    StepReceipt { from_id: "identified", to_id: "qualified", receipt_kind: "QualifiedPartnerReceipt", evidence: "synthetic" },
  ])
  (match skip {
    ProgressRefused { cause } =>
      match cause {
        ReceiptFromNoncurrentStage => true
        ReceiptAfterStop => false
        TransitionNotDeclaredOrKindMismatch => false
      }
    ProgressAt { stage_id } => false
    ProgressStopped { cause } => false
  })
    && (match wrong_kind {
      ProgressRefused { cause } =>
        match cause {
          TransitionNotDeclaredOrKindMismatch => true
          ReceiptAfterStop => false
          ReceiptFromNoncurrentStage => false
        }
      ProgressAt { stage_id } => false
      ProgressStopped { cause } => false
    })
    && (match stopped {
      ProgressStopped { cause } =>
        match cause {
          TrustBoundaryRejected => true
          ProblemNotMaterial => false
          InstallationCostTooHigh => false
          ImprovementNotObserved => false
          EconomicCaseAbsent => false
          TimingMismatch => false
          OtherLocatedCause { note } => false
        }
      ProgressAt { stage_id } => false
      ProgressRefused { cause } => false
    })
    && (match after_stop {
      ProgressRefused { cause } =>
        match cause {
          ReceiptAfterStop => true
          ReceiptFromNoncurrentStage => false
          TransitionNotDeclaredOrKindMismatch => false
        }
      ProgressAt { stage_id } => false
      ProgressStopped { cause } => false
    })
}

test fn witness_forecast_derives_and_refuses() -> Bool {
  let ok = derive_acquisition_cost_forecast(input: AcquisitionScenarioDeclared { scenario: baseline_acquisition_scenario })
  let broken_rate = AcquisitionScenario {
    entry_stage_label: "click",
    entry_unit_cost: MoneyOnce { amount: money_amount_micro(count: 3000000), currency: Usd },
    steps: [
      AcquisitionStageStep { stage_label: "signup", assumed_rate: ConversionRate { num: 0, denom: 20 } },
      AcquisitionStageStep { stage_label: "activated", assumed_rate: ConversionRate { num: 2, denom: 5 } },
    ],
  }
  let free_click = AcquisitionScenario {
    entry_stage_label: "click",
    entry_unit_cost: MoneyOnce { amount: money_amount_micro(count: 0), currency: Usd },
    steps: [
      AcquisitionStageStep { stage_label: "signup", assumed_rate: ConversionRate { num: 1, denom: 20 } },
      AcquisitionStageStep { stage_label: "activated", assumed_rate: ConversionRate { num: 2, denom: 5 } },
    ],
  }
  (match ok {
    AcquisitionForecastDerived { forecast } =>
      (match acquisition_forecast_cost_floor_micros(forecast: forecast) {
        Present { value } => value == 150000000
        Absent => false
      })
        && forecast.outcome_stage_label == "activated"
    AcquisitionForecastRefused { cause } => false
  })
    && (match derive_acquisition_cost_forecast(input: AcquisitionScenarioUnknown) {
      AcquisitionForecastDerived { forecast } => false
      AcquisitionForecastRefused { cause } =>
        match cause {
          ScenarioUnknown => true
          ZeroEntryUnitCost => false
          EmptyFunnel => false
          ZeroConversionNumerator { stage_label } => false
          ZeroConversionCohort { stage_label } => false
          ConversionRateExceedsUnity { stage_label } => false
        }
    })
    && (match derive_acquisition_cost_forecast(input: AcquisitionScenarioDeclared { scenario: broken_rate }) {
      AcquisitionForecastDerived { forecast } => false
      AcquisitionForecastRefused { cause } =>
        match cause {
          ZeroConversionNumerator { stage_label } => stage_label == "signup"
          ScenarioUnknown => false
          ZeroEntryUnitCost => false
          EmptyFunnel => false
          ZeroConversionCohort { stage_label } => false
          ConversionRateExceedsUnity { stage_label } => false
        }
    })
    && (match derive_acquisition_cost_forecast(input: AcquisitionScenarioDeclared { scenario: free_click }) {
      AcquisitionForecastDerived { forecast } => false
      AcquisitionForecastRefused { cause } =>
        match cause {
          ZeroEntryUnitCost => true
          ScenarioUnknown => false
          EmptyFunnel => false
          ZeroConversionNumerator { stage_label } => false
          ZeroConversionCohort { stage_label } => false
          ConversionRateExceedsUnity { stage_label } => false
        }
    })
}

test fn witness_experiment_stop_condition_cannot_be_silently_continued() -> Bool {
  (match experiment_continuation(stop_receipts: []) {
    ExperimentMayContinue => true
    ExperimentMustStop { cause } => false
  })
    && (match experiment_continuation(stop_receipts: [StopReceipt { cause: EconomicCaseAbsent, evidence: "synthetic budget cap" }]) {
      ExperimentMustStop { cause } =>
        match cause {
          EconomicCaseAbsent => true
          ProblemNotMaterial => false
          TrustBoundaryRejected => false
          InstallationCostTooHigh => false
          ImprovementNotObserved => false
          TimingMismatch => false
          OtherLocatedCause { note } => false
        }
      ExperimentMayContinue => false
    })
}

fn vision_id_known(id: String) -> Bool {
  fold(visions, init: false, f: fn(acc, v) { acc || v.id == id })
}

fn reason_resolves(r: StrategicReason) -> Bool {
  match r {
    DeliversCapability { capability_id } => capability_id_known(id: capability_id)
    ServesOutcome { outcome_id } => outcome_id_known(id: outcome_id)
    TestsHypothesis { hypothesis_id } => hypothesis_id_known(id: hypothesis_id)
    RequiredByDecision { question_id } => decision_count_with_question(id: question_id) == 1
    ServesVision { vision_id } => vision_id_known(id: vision_id)
  }
}

fn lane_bound(owner: String) -> Bool {
  fold(lane_bindings, init: false, f: fn(acc, b) { acc || b.lane_owner == owner })
}

fn lane_acknowledged(owner: String) -> Bool {
  fold(unbound_lanes_acknowledged, init: false, f: fn(acc, a) { acc || a.lane_owner == owner })
}

fn declared_owner_exists(owner: String) -> Bool {
  fold(declared_roadmap_nodes(), init: false, f: fn(acc, n) { acc || n.owner == owner })
}

test fn witness_every_active_roadmap_lane_has_strategic_reason() -> Bool {
  count(active_roadmap_nodes()) > 0
    && all(active_roadmap_nodes(), n => lane_bound(owner: n.owner) || lane_acknowledged(owner: n.owner))
    && all(lane_bindings, b => reason_resolves(r: b.reason))
    && all(lane_bindings, b => declared_owner_exists(owner: b.lane_owner))
    && all(unbound_lanes_acknowledged, a => !(a.trigger == ""))
}

test fn witness_node_grain_bindings_target_real_roadmap_nodes() -> Bool {
  all(roadmap_bindings, b =>
    fold(declared_roadmap_nodes(), init: false, f: fn(acc, n) { acc || n.node == nid(s: b.roadmap_node_id) }))
}

fn accepted_in_authority(node_id: String) -> Bool {
  fold(accepted_roadmap_node_ids(), init: false, f: fn(acc, a) { acc || a == nid(s: node_id) })
}

fn capability_evidence_valid(o: ObservedCapability) -> Bool {
  capability_id_known(id: o.capability_id)
    && match o.evidence {
      RoadmapAccepted { roadmap_node_id } => accepted_in_authority(node_id: roadmap_node_id)
      CapabilityDirectlyObserved { receipt } => !(receipt == "")
    }
}

test fn witness_capability_evidence_consistent_with_public_authority() -> Bool {
  count(observed_capabilities) == 1
    && all(observed_capabilities, o => capability_evidence_valid(o: o))
    && all(active_roadmap_nodes(), n =>
         !fold(accepted_roadmap_node_ids(), init: false, f: fn(acc, a) { acc || a == n.node }))
    && !capability_evidence_valid(o: ObservedCapability {
         capability_id: "source-integration-landing-dashboard",
         evidence: RoadmapAccepted { roadmap_node_id: "never-declared-node" },
       })
}

fn engagement_count_with_id(id: String) -> Nat {
  fold(engagements, init: 0, f: fn(acc, e) { if e.id == id { acc + 1 } else { acc } })
}

test fn witness_first_partner_is_self_and_stage_derives_from_real_receipts() -> Bool {
  count(engagements) == 3
    && all(engagements, e => engagement_count_with_id(id: e.id) == 1)
    && (match derive_stage(rules: design_partner_rules, initial_stage_id: "identified", receipts: eng000_journey_receipts) {
      ProgressAt { stage_id } => stage_id == "problem-confirmed"
      ProgressStopped { cause } => false
      ProgressRefused { cause } => false
    })
    && fold(engagements, init: 0, f: fn(acc, e) {
         match e.kind { TechnicalValidator => acc + 1  WedgeDesignPartner => acc } }) == 2
}

fn venture_era_count_with_id(id: String) -> Nat {
  fold(venture_eras, init: 0, f: fn(acc, e) { if e.id == id { acc + 1 } else { acc } })
}

fn venture_event_count_with_id(id: String) -> Nat {
  fold(timeline_events, init: 0, f: fn(acc, e) { if e.id == id { acc + 1 } else { acc } })
}

fn venture_event_era_resolves(e: TimelineEvent) -> Bool {
  venture_era_count_with_id(id: e.era_id) == 1
}

fn venture_evidence_cited(a: EvidenceAnchor) -> Bool {
  !(a.repo == "") && !(a.reference == "")
}

test fn witness_timeline_eras_and_events_resolve_with_evidence() -> Bool {
  count(venture_eras) == 6
    && count(timeline_events) == 10
    && all(venture_eras, e => venture_era_count_with_id(id: e.id) == 1)
    && all(timeline_events, e => venture_event_count_with_id(id: e.id) == 1)
    && all(timeline_events, e => venture_event_era_resolves(e: e))
    && all(venture_eras, e => !(e.started_on == "") && venture_evidence_cited(a: e.start_evidence))
    && all(venture_eras, e =>
         match e.close {
           EraOpen => true
           EraClosed { on, evidence } => !(on == "") && venture_evidence_cited(a: evidence)
         })
    && all(timeline_events, e => !(e.occurred_on == "") && venture_evidence_cited(a: e.evidence))
    && !venture_event_era_resolves(e: TimelineEvent {
         id: "synthetic",
         era_id: "never-declared-era",
         occurred_on: "2026-01-01",
         statement: "negative control",
         evidence: EvidenceAnchor { repo: "x", reference: "y", note: "" },
       })
}

fn lineage_generation_count_with_ordinal(ordinal: Nat) -> Nat {
  fold(compiler_generations, init: 0, f: fn(acc, g) { if g.ordinal == ordinal { acc + 1 } else { acc } })
}

fn lineage_substrate_is_rust(ordinal: Nat) -> Bool {
  fold(compiler_generations, init: false, f: fn(acc, g) {
    acc || (g.ordinal == ordinal && match g.substrate { RustCompiler => true  DagCompiler => false })
  })
}

fn lineage_substrate_is_dag(ordinal: Nat) -> Bool {
  fold(compiler_generations, init: false, f: fn(acc, g) {
    acc || (g.ordinal == ordinal && match g.substrate { DagCompiler => true  RustCompiler => false })
  })
}

fn lineage_edge_is_rust_to_dag(e: SuccessionEdge) -> Bool {
  lineage_substrate_is_rust(ordinal: e.from_ordinal) && lineage_substrate_is_dag(ordinal: e.to_ordinal)
}

fn lineage_outgoing_succession_count(ordinal: Nat) -> Nat {
  fold(succession_edges, init: 0, f: fn(acc, e) { if e.from_ordinal == ordinal { acc + 1 } else { acc } })
}

fn lineage_host_resolves(g: CompilerGeneration) -> Bool {
  match g.host {
    SelfNativeRust => true
    RustSeedInterpreter => true
    HostedByGeneration { ordinal } => lineage_substrate_is_dag(ordinal: ordinal)
  }
}

fn lineage_alive_current_names() -> List<String> {
  fold(compiler_generations, init: [], f: fn(acc, g) {
    match g.fate {
      GenerationAlive { current_name, role } => concat(acc, [current_name])
      GenerationRetired { on, evidence } => acc
      GenerationDeleted { on, evidence, migrated_role } => acc
    }
  })
}

test fn witness_lineage_two_rust_to_dag_successions() -> Bool {
  count(compiler_generations) == 4
    && count(succession_edges) == 2
    && all(compiler_generations, g => lineage_generation_count_with_ordinal(ordinal: g.ordinal) == 1)
    && all(compiler_generations, g => !(g.born_on == "") && venture_evidence_cited(a: g.born_evidence))
    && all(compiler_generations, g => lineage_host_resolves(g: g))
    && all(succession_edges, e => lineage_edge_is_rust_to_dag(e: e) && venture_evidence_cited(a: e.evidence))
    && all(compiler_generations, g =>
         if generation_is_alive(g: g) {
           lineage_outgoing_succession_count(ordinal: g.ordinal) == 0
         } else {
           lineage_outgoing_succession_count(ordinal: g.ordinal) == 1
         })
    && count(lineage_alive_current_names()) == 2
    && id_in_list(id: "v1", ids: lineage_alive_current_names())
    && id_in_list(id: "v2", ids: lineage_alive_current_names())
    && !lineage_edge_is_rust_to_dag(e: SuccessionEdge {
         from_ordinal: 2,
         to_ordinal: 3,
         evidence: EvidenceAnchor { repo: "x", reference: "negative control: dag-to-rust succession never happened", note: "" },
       })
}

test fn witness_present_state_is_derived_never_stored() -> Bool {
  fold(venture_eras, init: 0, f: fn(acc, e) { if era_is_open(e: e) { acc + 1 } else { acc } }) == 3
    && fold(compiler_generations, init: 0, f: fn(acc, g) { if generation_is_alive(g: g) { acc + 1 } else { acc } }) == 2
    && all(venture_eras, e => if e.id == "era-substrate" { era_is_open(e: e) } else { true })
    && all(venture_eras, e => if e.id == "era-platform-push" { !era_is_open(e: e) } else { true })
}

fn projection_horizon_count_now() -> Nat {
  fold(projected_steps, init: 0, f: fn(acc, s) {
    match s.horizon { HorizonNow => acc + 1  HorizonNext => acc  HorizonLater => acc }
  })
}

fn projection_horizon_count_later() -> Nat {
  fold(projected_steps, init: 0, f: fn(acc, s) {
    match s.horizon { HorizonLater => acc + 1  HorizonNow => acc  HorizonNext => acc }
  })
}

test fn witness_projection_grounded_in_strategy_without_fabricated_dates() -> Bool {
  count(projected_steps) == 6
    && all(projected_steps, s => reason_resolves(r: s.advances))
    && all(projected_steps, s => !(s.begins_when == ""))
    && projection_horizon_count_now() == 2
    && projection_horizon_count_later() == 2
    && !reason_resolves(r: DeliversCapability { capability_id: "never-declared-capability" })
}

fn cadence_reading_count_in_window(w: CadenceWindow, want_daily: Bool, want_weekly: Bool, want_monthly: Bool, want_quarterly: Bool, want_yearly: Bool) -> Bool {
  match w {
    DailyWindow => want_daily
    WeeklyWindow => want_weekly
    MonthlyWindow => want_monthly
    QuarterlyWindow => want_quarterly
    YearlyWindow => want_yearly
  }
}

fn cadence_window_reading_count(want_daily: Bool, want_weekly: Bool, want_monthly: Bool, want_quarterly: Bool, want_yearly: Bool) -> Nat {
  fold(tangent_readings, init: 0, f: fn(acc, r) {
    if cadence_reading_count_in_window(w: r.window, want_daily: want_daily, want_weekly: want_weekly, want_monthly: want_monthly, want_quarterly: want_quarterly, want_yearly: want_yearly) { acc + 1 } else { acc }
  })
}

test fn witness_cadence_tangent_readings_cover_all_windows_and_align() -> Bool {
  count(tangent_readings) == 5
    && cadence_window_reading_count(want_daily: true, want_weekly: false, want_monthly: false, want_quarterly: false, want_yearly: false) == 1
    && cadence_window_reading_count(want_daily: false, want_weekly: true, want_monthly: false, want_quarterly: false, want_yearly: false) == 1
    && cadence_window_reading_count(want_daily: false, want_weekly: false, want_monthly: true, want_quarterly: false, want_yearly: false) == 1
    && cadence_window_reading_count(want_daily: false, want_weekly: false, want_monthly: false, want_quarterly: true, want_yearly: false) == 1
    && cadence_window_reading_count(want_daily: false, want_weekly: false, want_monthly: false, want_quarterly: false, want_yearly: true) == 1
    && all(tangent_readings, r => !(r.read_on == "") && !(r.direction == ""))
    && all(tangent_readings, r => !(r.magnitude_evidence.repo == "") && !(r.magnitude_evidence.reference == ""))
    && all(tangent_readings, r => reason_resolves(r: r.projects_onto))
    && !reason_resolves(r: DeliversCapability { capability_id: "orphan-movement-control" })
}

