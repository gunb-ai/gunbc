fn program_obligation_count_with_id(id: String) -> Nat {
  fold(program_obligations, init: 0, f: fn(acc, o) { if o.id == id { acc + 1 } else { acc } })
}

fn program_obligation_known(id: String) -> Bool {
  program_obligation_count_with_id(id: id) == 1
}

fn program_first_contract() -> StrategicContract {
  fold(program_contracts, init: StrategicContract {
    id: "",
    statement: "",
    acceptance_criteria: [],
    constraint_ids: [],
    adoption: DecisionReceipt { authority: "", decided_on: "", rationale: "" },
  }, f: fn(acc, c) { if acc.id == "" { c } else { acc } })
}

fn program_first_amendment() -> ContractAmendment {
  fold(contract_amendments, init: ContractAmendment {
    id: "",
    subject_contract: "",
    previous_criteria: [],
    summary: "",
    receipt: DecisionReceipt { authority: "", decided_on: "", rationale: "" },
    evidence: "",
  }, f: fn(acc, a) { if acc.id == "" { a } else { acc } })
}

fn program_contract_known(id: String) -> Bool {
  fold(program_contracts, init: false, f: fn(acc, c) { acc || c.id == id })
}

fn program_obligation_count_for_contract(contract_id: String) -> Nat {
  fold(program_obligations, init: 0, f: fn(acc, o) { if o.parent_contract == contract_id { acc + 1 } else { acc } })
}

fn program_contract_by_id(id: String) -> StrategicContract {
  fold(program_contracts, init: StrategicContract {
    id: "",
    statement: "",
    acceptance_criteria: [],
    constraint_ids: [],
    adoption: DecisionReceipt { authority: "", decided_on: "", rationale: "" },
  }, f: fn(acc, c) { if c.id == id { c } else { acc } })
}

fn program_contract_for_obligation(obligation_id: String) -> StrategicContract {
  let parent = fold(program_obligations, init: "", f: fn(acc, o) { if o.id == obligation_id { o.parent_contract } else { acc } })
  program_contract_by_id(id: parent)
}

test fn witness_program_contract_graph_resolves() -> Bool {
  count(program_contracts) == 4
    && count(program_obligations) == 25
    && count(program_decompositions) == 3
    && count(work_contributions) == 6
    && count(work_observations) == 8
    && count(contract_amendments) == 2
    && count(obligation_prerequisites) == 5
    && program_obligation_count_for_contract(contract_id: "contract-bare-minimum-computation") == 7
    && program_obligation_count_for_contract(contract_id: "contract-v2-self-host-fixed-point") == 6
    && program_obligation_count_for_contract(contract_id: "contract-v2-production-cutover") == 1
    && program_obligation_count_for_contract(contract_id: "contract-language-medium-support") == 11
    && all(obligation_prerequisites, p => program_obligation_known(id: p.blocker_obligation) && program_obligation_known(id: p.blocked_obligation))
    && all(program_obligations, o => program_contract_known(id: o.parent_contract))
    && all(program_obligations, o => program_obligation_count_with_id(id: o.id) == 1)
    && all(program_decompositions, d => program_contract_known(id: d.parent_contract) && all(d.child_obligation_ids, oid => program_obligation_known(id: oid)))
    && all(work_contributions, b => program_obligation_known(id: b.obligation_id) && !(b.work_ref == "") && !(b.maximum_conclusion == ""))
    && all(work_observations, o => !(o.observed_on == "") && !(o.subject_revision == "") && venture_evidence_cited(a: o.evidence))
    && all(program_decompositions, d => match d.coverage { PartialCoverage { open_note } => !(open_note == "")  CompleteCoverage { receipt } => true })
    && all(contract_amendments, a => program_contract_known(id: a.subject_contract) && count(a.previous_criteria) > 0 && !(a.evidence == ""))
    && !program_obligation_known(id: "obl-never-declared")
    && !program_contract_known(id: "contract-never-declared")
}

fn program_binding_count(work_ref: String, obligation_id: String) -> Nat {
  fold(work_contributions, init: 0, f: fn(acc, b) {
    if b.work_ref == work_ref && b.obligation_id == obligation_id { acc + 1 } else { acc }
  })
}

