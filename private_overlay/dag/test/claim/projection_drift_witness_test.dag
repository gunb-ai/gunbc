module test.claim.projection_drift_witness

import std.types { Bool, String, List, NonEmptyStr }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io {
  Filesystem,
  FilesystemReadOutcome, FilesystemReadSucceeded, FilesystemReadRefused,
  filesystem_read_outcome,
}
import strategy.private_witness_workflow {
  ProjectedArtifact, projected_artifacts, private_repo_prefix,
  private_witness_workflow_authority,
  ProjectionAgreement, ProjectionAgrees, ProjectionDrifted, projection_agreement,
  ProjectedArtifactObservation, ProjectedArtifactObserved, ProjectedArtifactReadRefused,
  projected_artifact_observation, projected_artifact_observation_ok,
  projected_artifact_observation_detail,
  witnesses_yml_path, expected_witnesses_yml,
  projection_drift_yml_path,
}
import strategy.node_rental_page {
  node_rental_html_path, expected_node_rental_html, node_rental_page_authority,
}
import strategy.buyer_listing_entries {
  ddr4_rdimm_sheet_csv_path, expected_ddr4_rdimm_sheet_csv,
  ddr4_rdimm_notes_csv_path, expected_ddr4_rdimm_notes_csv,
  buyer_listing_entries_authority,
}
import strategy.plan_tracker_page {
  plan_tracker_html_path, expected_plan_tracker_html, plan_tracker_page_authority,
}
import strategy.wholesale_supply_packet {
  wholesale_packet_csv_path, expected_wholesale_packet_csv, wholesale_packet_csv_authority,
}

// THE CONSUMER THE PROJECTIONS DID NOT HAVE. strategy.private_witness_workflow declares itself the
// authority for the committed workflow files and computes the bytes that authority implies; this
// witness is the thing that asks whether what is committed still equals them. Without it the
// producers were an inert lens -- present, correct-looking, gating nothing.
//
// WHY THE PATHS CARRY A PARENT-CHECKOUT PREFIX. gunbc resolves its workspace from the working
// directory, so roster invocations run inside the PUBLIC checkout. The compiler ingest of
// private .dag files uses private_entry_prefix (the in-workspace overlay). The drift observer
// reads the committed YAML from the private git tree one level up, via private_repo_prefix,
// because those files are not part of the overlay copy. private_overlay is never a projection
// source: comparing it would verify that a generated copy matches itself.
//
// LOCAL COMPOSE MUST CREATE THAT PREFIX -- AND $COMPOSE MUST NOT BE A SESSION WORKTREE. CI
// runs `ln -sfn "$PRIVATE_ROOT" "$COMPOSE/private_repo"` in witness_run_script and
// projection_drift_run_script, where $COMPOSE is a throwaway checkout. A local `gunbc run`
// from a public checkout that does not have that symlink cannot observe the committed
// projections: Filesystem.Read of private_repo/... refuses, and the witness cannot tell
// agreement from unread. Create the same symlink onto the private git tree (the checkout
// that owns .github/workflows and docs/strategy CSV) ONLY inside the compose location
// strategy.private_witness_workflow overlay_local_method names: a detached worktree outside
// every session worktree (`git worktree add --detach /tmp/claude-1000/SESSION-compose HEAD`)
// or a remote-less scratch checkout. Never inside a session worktree, under any name:
// private_overlay/, privdag/ and any other copied directory are staged as FULL CONTENT by
// the archive-time `git add -A` (mode 100644, silently), a nested clone at private_repo/
// is staged as a gitlink with only a warning, and the flush-time guard is the last line,
// not the first. Ignore rules are not the protection either way: a linked worktree's own
// .git/info/exclude is never read, and the COMMON dir's info/exclude -- which every linked
// worktree does read -- is uncommitted, unreviewed and machine-local, so a passing
// `git check-ignore` on one host proves nothing about the next clone (measured 2026-09-14
// by quick-owl-739: that file was the only thing covering private_overlay/ on the host, and
// the committed .gitignore had no row for it). The measured instance is
// gunbc.recurring_failure_mode private_tree_inside_a_public_worktree_publishes_on_archive.
// If one of those paths is already in a session worktree, MOVE it out; do not exclude it and
// do not stage it.
//
// TEARDOWN IS A FILESYSTEM ACT, NOT A REGISTRATION ACT. `git worktree prune` removes the
// worktree's REGISTRATION and leaves its files on disk; four pruned compose directories were
// found on one host each still holding a full private tree (`git` inside them answers "not a
// git repository", so nothing can stage them, but the content outlives the registration).
// Remove a compose with `git worktree remove --force <dir>` or `rm -rf` of the detached
// directory, never prune alone, and sweep the FILESYSTEM -- the session scratchpad,
// /tmp/claude-1000/<session>/, every compose location ever created -- rather than
// `git worktree list`, which enumerates registrations and cannot see a pruned copy. Sweep by
// CONTENT, not by directory name: a scratch copy is named after whatever its author was doing
// (a child id, a PR number), so `find -name 'priv*' -o -name '*compose*'` censuses a shape the
// author chose and returned nothing for three full trees found on 2026-09-14 (snappy-pike-154);
// what found them was the fact that only the private corpus carries these files --
// `find /tmp/claude-1000 -type f \( -name year_end_plan.dag -o -name data_map.dag -o -name
// audit_packet.dag -o -name node_rental.dag \)`. A hit is a DISCOVERY CANDIDATE, not a
// deletion order: the same find lists the working clone and the compose this paragraph tells
// you to create, and a compose is in use for as long as its witness run has not reported.
// Delete only a copy you have identified as yours whose use has ended (the run reported, or
// the copy was never a compose at all); content presence alone establishes neither.
fn committed_path(a: ProjectedArtifact) -> String {
  join([private_repo_prefix, a.path], "")
}

fn read_committed(a: ProjectedArtifact) -> FilesystemReadOutcome {
  let r = Filesystem.Read(path: committed_path(a: a))
  filesystem_read_outcome(content: r.content, success: r.success, error: r.error)
}

fn observe(a: ProjectedArtifact) -> ProjectedArtifactObservation {
  projected_artifact_observation(
    path: a.path, authority: a.authority, read: read_committed(a: a), expected: a.expected)
}

// AND THE TRACKER PAGE WAS THE SECOND ONE. The same gap recurred for
// docs/strategy/plan-tracker-generated.html: strategy.plan_tracker_page declares render_tracker_body
// the authority for those bytes and ships an emit entry, and nothing compared the two -- so when main
// deleted dag/finance/personal_ledger.dag and the plan re-pointed four relates_to targets at
// gunbc-personal:finance.personal_ledger, the committed page kept naming the deleted module and both
// required lanes stayed green. Enrolling a producer here is what makes it a wall; declaring the
// authority in the producing module is not.
//
// THE HTML PAGE WAS THE MISSING MEMBER. projected_artifacts in the workflow module names the
// two YAML files that module itself emits. The node-rental page is emitted by
// strategy.node_rental_page, and the buyer review sheet and its notes by
// strategy.buyer_listing_entries, so each is enrolled here -- the drift observer's population --
// rather than by editing YAML-emit to compile what it does not produce.
fn enrolled_projections() -> List<ProjectedArtifact> {
  concat(projected_artifacts(), [
    ProjectedArtifact {
      path: node_rental_html_path,
      expected: expected_node_rental_html(),
      authority: node_rental_page_authority,
    },
    ProjectedArtifact {
      path: ddr4_rdimm_sheet_csv_path,
      expected: expected_ddr4_rdimm_sheet_csv(),
      authority: buyer_listing_entries_authority,
    },
    ProjectedArtifact {
      path: ddr4_rdimm_notes_csv_path,
      expected: expected_ddr4_rdimm_notes_csv(),
      authority: buyer_listing_entries_authority,
    },
    ProjectedArtifact {
      path: plan_tracker_html_path,
      expected: expected_plan_tracker_html(),
      authority: plan_tracker_page_authority,
    },
    ProjectedArtifact {
      path: wholesale_packet_csv_path,
      expected: expected_wholesale_packet_csv(),
      authority: wholesale_packet_csv_authority,
    },
  ])
}

fn observations() -> List<ProjectedArtifactObservation> {
  fold(enrolled_projections(), init: [], f: fn(acc, a) { concat(acc, [observe(a: a)]) })
}

// EVERY DISAGREEING ARTIFACT IS NAMED, not just the first. A run that stops at the first difference
// makes the next one invisible until this one is fixed, which turns one regeneration into as many
// round trips as there are drifted files.
fn failing_detail(os: List<ProjectedArtifactObservation>) -> String {
  fold(os, init: "", f: fn(acc, o) {
    if projected_artifact_observation_ok(o: o) {
      acc
    } else {
      join([acc, if acc == "" { "" } else { "; " }, projected_artifact_observation_detail(o: o)], "")
    }
  })
}

fn all_agree(os: List<ProjectedArtifactObservation>) -> Bool {
  fold(os, init: true, f: fn(acc, o) { acc && projected_artifact_observation_ok(o: o) })
}

// THE POSITIVE CONTROL: the producer agrees with itself. This is what proves the accepting arm is
// reachable at all, so a predicate that has silently become permanently-refusing cannot pass itself
// off as a wall that never fires because nothing is wrong.
fn the_producer_agrees_with_itself() -> Bool {
  projected_artifact_observation_ok(o: projected_artifact_observation(
    path: witnesses_yml_path,
    authority: private_witness_workflow_authority,
    read: FilesystemReadSucceeded { content: expected_witnesses_yml() },
    expected: expected_witnesses_yml(),
  ))
}

// THE DISCRIMINATING RED, kept enrolled rather than retired now that the wall stands (DESIGN 4b(4)).
// Drift is authored as an argument, so the refusal is exercised on every run without perturbing a
// committed file. A single appended byte is the smallest difference the comparison must catch; if
// this stops refusing, the comparison has stopped discriminating and the green above is hollow.
fn a_single_changed_byte_refuses() -> Bool {
  projected_artifact_observation_ok(o: projected_artifact_observation(
    path: witnesses_yml_path,
    authority: private_witness_workflow_authority,
    read: FilesystemReadSucceeded { content: join([expected_witnesses_yml(), "\n"], "") },
    expected: expected_witnesses_yml(),
  )) == false
    && projected_artifact_observation_ok(o: projected_artifact_observation(
      path: witnesses_yml_path,
      authority: private_witness_workflow_authority,
      read: FilesystemReadSucceeded { content: "" },
      expected: expected_witnesses_yml(),
    )) == false
}

// A READ REFUSAL IS ITS OWN ARM AND IS ASSERTED AS ONE. The fold takes the read outcome as a
// parameter precisely so this control can reach the refusing arm with a synthetic outcome instead
// of requiring a real filesystem failure. It asserts the ARM, not merely that the run failed: an
// unreadable file and a drifted file both stop the line, and a check that only asked "did it stop"
// would pass while the two causes were conflated -- which is the erasure this type exists to
// prevent.
fn a_read_refusal_is_not_reported_as_drift() -> Bool {
  let refused = projected_artifact_observation(
    path: witnesses_yml_path,
    authority: private_witness_workflow_authority,
    read: FilesystemReadRefused { error: "No such file or directory (os error 2)" },
    expected: expected_witnesses_yml(),
  )
  let is_refusal_arm = match refused {
    ProjectedArtifactObserved { path, agreement } => false
    ProjectedArtifactReadRefused { path, cause } => true
  }
  let drifted = projected_artifact_observation(
    path: witnesses_yml_path,
    authority: private_witness_workflow_authority,
    read: FilesystemReadSucceeded { content: "" },
    expected: expected_witnesses_yml(),
  )
  let is_observed_arm = match drifted {
    ProjectedArtifactObserved { path, agreement } => true
    ProjectedArtifactReadRefused { path, cause } => false
  }
  is_refusal_arm && is_observed_arm
    && projected_artifact_observation_ok(o: refused) == false
}

// NAMED PATHS, NOT A COUNT OF THE CURRENT TREE. Adding a projection without committing its file
// still stops the line because observations() folds enrolled_projections() and a missing file is
// ProjectedArtifactReadRefused. Pinning count==N was itself a change detector.
fn enrolled(path: NonEmptyStr) -> Bool {
  count(filter(enrolled_projections(), a => a.path == path)) == 1
}

fn every_projection_is_checked() -> Bool {
  enrolled(path: witnesses_yml_path)
    && enrolled(path: projection_drift_yml_path)
    && enrolled(path: node_rental_html_path)
    && enrolled(path: ddr4_rdimm_sheet_csv_path)
    && enrolled(path: ddr4_rdimm_notes_csv_path)
    && enrolled(path: plan_tracker_html_path)
    && enrolled(path: wholesale_packet_csv_path)
    && count(observations()) == count(enrolled_projections())
}

// THE AUTHORITY IN THE REFUSAL IS THE ROW'S OWN, AND A SINGLE RED CANNOT ESTABLISH THAT. Until this
// change the detail named one hardcoded module for every artifact, so it was right for the two files
// that module emits and wrong for the other four. Any CONSTANT authority still makes one artifact's
// message correct, which means a one-artifact red greens under the exact regression this control
// exists to catch. So it asserts the discriminating shape directly: two artifacts with different
// authorities produce details naming their OWN module and NOT each other's.
fn drift_detail(path: NonEmptyStr, authority: NonEmptyStr) -> String {
  let a = projection_agreement(
    path: path, authority: authority, committed: "", expected: "these bytes differ")
  match a {
    ProjectionAgrees => ""
    ProjectionDrifted { detail } => detail
  }
}

fn the_refusal_names_each_artifacts_own_authority() -> Bool {
  let nr = drift_detail(path: node_rental_html_path, authority: node_rental_page_authority)
  let pt = drift_detail(path: plan_tracker_html_path, authority: plan_tracker_page_authority)
  string_contains(s: nr, pattern: node_rental_page_authority)
    && string_contains(s: pt, pattern: plan_tracker_page_authority)
    && !string_contains(s: nr, pattern: plan_tracker_page_authority)
    && !string_contains(s: pt, pattern: node_rental_page_authority)
}

fn controls_hold() -> Bool {
  the_producer_agrees_with_itself()
    && a_single_changed_byte_refuses()
    && a_read_refusal_is_not_reported_as_drift()
    && the_refusal_names_each_artifacts_own_authority()
    && every_projection_is_checked()
}

fn projection_drift_witness_main() -> ProcessExit {
  let os = observations()
  if all_agree(os: os) {
    if controls_hold() {
      ExitSuccess
    } else {
      exit_failure(reason: "projection drift controls failed: the comparison no longer discriminates")
    }
  } else {
    exit_failure(reason: failing_detail(os: os))
  }
}
