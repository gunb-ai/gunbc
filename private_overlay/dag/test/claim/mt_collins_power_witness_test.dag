module test.claim.mt_collins_power_witness

import std.types { Bool, Int }
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import strategy.mt_collins_power {
  mt_collins_wall_watts_or_refusal, draw_is_derived, power_standing,
  PowerDerived, PowerAssumedOnly, assumed_wall_watts, mt_collins_electrical,
  observed_boot_peak, observed_boot_hover, observed_post_boot_idle,
  telemetry_idle_corroboration, regime_sizes_infrastructure, instrument_is_captured,
  sizing_observation_exists, circuit_sizing_watts_or_refusal,
  idle_corroboration, IdleCorroborated, IdleUncorroborated, idle_agreement_tolerance_watts,
  assumed_wall_watts_retirement, RetiredByMeasurement, NotRetiredWrongRegime,
  measured_versus_derived, DerivationRefusedNotComparable, RegimeMismatchNotComparable,
  fleet_idle_watts_at_full_site,
}
import std.measure { watt_count }
import strategy.calendar_date { calendar_date_is_valid }

// THE DERIVATION MUST REFUSE WHILE THE CENSUS IS UNREAD, and the refusal must not be a number.
// A node whose memory draw cannot be derived does not draw only its processor, so a
// CPU-plus-board figure is exactly what a power budget would divide by. Minus one cannot be
// mistaken for a wattage; a zero could.
fn refuses_while_census_unread() -> Bool {
  !draw_is_derived() && mt_collins_wall_watts_or_refusal() == 0 - 1
}

// The standing must report AssumedOnly rather than quietly presenting the assumption as a
// derivation. This is the check that flips when the census lands: it becomes a red demanding
// the row be updated, which is the correct behaviour for evidence arriving.
fn standing_is_assumed_only() -> Bool {
  match power_standing() {
    PowerDerived { wall_watts, assumed_watts } => false,
    PowerAssumedOnly { assumed_watts, obligation } => assumed_watts == 650,
  }
}

// The binding really is dual-socket. A one-socket figure charged to a two-socket node is the
// error candidate_node_watts_note already records for the ASRock build, in the other direction.
fn binding_is_dual_socket() -> Bool {
  mt_collins_electrical.sockets == 2 && assumed_wall_watts() == 650
}

// THE SIZING QUESTION REFUSES BECAUSE NO READING WAS TAKEN UNDER LOAD, which is a different
// refusal from the derivation's. This is the check that goes red the day someone installs the
// 480 W boot peak as a maximum: the peak is real, it is the largest number in the roster, and its
// regime says it may not size anything. If a sustained-load reading is ever added to the roster,
// this flips to a red demanding the row be updated - which is the correct behaviour for the
// measurement this module is waiting for actually arriving.
fn sizing_refuses_without_a_load_reading() -> Bool {
  !sizing_observation_exists() && circuit_sizing_watts_or_refusal() == 0 - 1
}

// The peak is recorded at its observed value AND is excluded from sizing. Both halves matter: a
// roster that dropped the 480 would lose the observation, and one that let its regime size a
// circuit would be worse than not recording it.
fn boot_peak_is_recorded_and_not_a_sizing_figure() -> Bool {
  watt_count(w: observed_boot_peak.watts) == 480
    && watt_count(w: observed_boot_hover.watts) == 380
    && watt_count(w: observed_post_boot_idle.watts) == 185
    && !regime_sizes_infrastructure(r: observed_boot_peak.regime)
}

// TWO INSTRUMENTS, AND THE TYPE KNOWS WHICH IS WHICH. A watched display is not a capture, and the
// row that was captured is the telemetry one. This goes red if a later editor writes the watched
// readings up as instrumented.
fn instruments_are_distinguished() -> Bool {
  !instrument_is_captured(i: observed_boot_peak.instrument)
    && !instrument_is_captured(i: observed_post_boot_idle.instrument)
    && instrument_is_captured(i: telemetry_idle_corroboration.instrument)
}

// The idle arm, and only the idle arm, has a second instrument behind it and they agree.
fn idle_arm_is_corroborated() -> Bool {
  match idle_corroboration() {
    IdleCorroborated { meter_watts, telemetry_watts, spread_watts, note } =>
      meter_watts == 185 && telemetry_watts == 200 && spread_watts <= idle_agreement_tolerance_watts,
    IdleUncorroborated { obligation } => false,
  }
}

fn observation_dates_are_valid() -> Bool {
  calendar_date_is_valid(d: observed_boot_peak.observed_on)
    && calendar_date_is_valid(d: observed_post_boot_idle.observed_on)
    && calendar_date_is_valid(d: telemetry_idle_corroboration.observed_on)
}

// THE FINDING, ENFORCED: three real numbers do not retire an assumption about a different regime.
fn assumption_is_not_retired_by_a_boot_reading() -> Bool {
  match assumed_wall_watts_retirement() {
    RetiredByMeasurement { measured_load_watts, assumed_watts } => false,
    NotRetiredWrongRegime { assumed_watts, assumption_regime, observed_regimes, reason } => assumed_watts == 650,
  }
}

// The measurement does not relieve the census read, so the derivation still refuses and the two
// facts stay uncompared rather than being reconciled.
fn measurement_does_not_close_the_derivation() -> Bool {
  match measured_versus_derived() {
    DerivationRefusedNotComparable { measured_idle_watts, refusal_obligation } => measured_idle_watts == 185,
    RegimeMismatchNotComparable { derived_wall_watts, measured_idle_watts, mismatch } => false,
  }
}

// The one fleet-scale claim these readings support, checked as a claim rather than as arithmetic:
// a full site doing NOTHING draws more than the per-node figure the whole electrical plan is built
// on. That is the sentence that makes the missing load measurement a colo-path fact.
fn fleet_idle_floor_exceeds_one_nodes_assumption() -> Bool {
  fleet_idle_watts_at_full_site() > assumed_wall_watts()
}

fn mt_collins_power_witness_all() -> Bool {
  refuses_while_census_unread() && standing_is_assumed_only() && binding_is_dual_socket()
    && sizing_refuses_without_a_load_reading()
    && boot_peak_is_recorded_and_not_a_sizing_figure()
    && instruments_are_distinguished()
    && idle_arm_is_corroborated()
    && observation_dates_are_valid()
    && assumption_is_not_retired_by_a_boot_reading()
    && measurement_does_not_close_the_derivation()
    && fleet_idle_floor_exceeds_one_nodes_assumption()
}

fn mt_collins_power_witness_main() -> ProcessExit {
  if mt_collins_power_witness_all() { ExitSuccess } else { ExitFailure { code: 1, reason: "mt_collins_power_witness_all returned false" } }
}
