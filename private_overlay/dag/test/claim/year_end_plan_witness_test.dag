  q2_recut_item_ids, q2_recut_count, q2_recut_items_are_anchored_at_q2,
  find_item, dep_ids, no_item_relations, done_evidence, done_merge_shas,
  item_relation_targets_resolve, item_relation_not_also_a_dep,
  llc_exposure_activates_on_m2_success,
  PlanEdge, CompletionRequires, dep,
  PlanWorkstream, EconomicsQa, ExecutionMode, AgentParallel, PlanItemStatus, NotStarted,
  roster_schedule_standing, schedule_standing_at_day, standing_fits, standing_is_refusal,
