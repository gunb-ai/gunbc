}

fn fixture_experiment(
  identity: NonEmptyStr,
  control: MemoryChannelExperimentControl,
  machine: NonEmptyStr,
  u: MemorySlotUniverseReceipt,
  requested: NonEmptyStr,
  transfer: HeldUnitToRevATransferStanding,
  installed_designations: List<NonEmptyStr>,
  installed_capacity_gib: Nat,
  installed_ranks: Nat,
  installed_width: Nat,
) -> MemoryDepopulationExperiment {
  MemoryDepopulationExperiment {
    identity: identity,
    control: control,
    subject_machine: machine,
    requested_candidate: requested,
    transfer: transfer,
    installed: fixture_inspection(machine: machine, u: u, designations: installed_designations,
      capacity_gib: installed_capacity_gib, ranks: installed_ranks, width: installed_width),
    shutdown_requirement: "fixture",
    physical_mutation: OperatorExecuted,
  }
}

fn observed_receipt_under(control: MemoryChannelExperimentControl, firmware: NonEmptyStr, tag: NonEmptyStr, population: NonEmptyStr, designations: List<NonEmptyStr>, capacity_gib: Nat, ranks: Nat, width: Nat, completed_work: Nat, concurrency: Nat, billed: Nat) -> MemoryChannelResponseReceipt {
  CandidateResponseObserved {
    response_identity: tag,
    experiment: fixture_experiment(identity: tag, control: control, machine: fixture_machine, u: universe_1p, requested: population,
      transfer: DirectOneSocketObservation, installed_designations: designations,
      installed_capacity_gib: capacity_gib, installed_ranks: ranks, installed_width: width),
    census: fixture_census(machine: fixture_machine, u: universe_1p, firmware: firmware, run: tag, designations: designations,
      capacity_gib: capacity_gib, ranks: ranks, width: width, cls: Rdimm, os_visible: fixture_os_visible,
      domains: ["CPU0"], machine_visible: fixture_os_visible),
    workload: fixture_workload(machine: fixture_machine, domain: "CPU0", invocation: tag, completed_work: completed_work, concurrency: concurrency, billed: billed),
  }
}

fn observed_receipt(tag: NonEmptyStr, population: NonEmptyStr, designations: List<NonEmptyStr>, capacity_gib: Nat, ranks: Nat, width: Nat, completed_work: Nat) -> MemoryChannelResponseReceipt {
  observed_receipt_under(control: control_1p, firmware: "fixture firmware", tag: tag, population: population,
    designations: designations, capacity_gib: capacity_gib, ranks: ranks, width: width, completed_work: completed_work,
    concurrency: 76, billed: 76)
}

