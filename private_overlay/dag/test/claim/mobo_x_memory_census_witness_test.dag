fn fixture_control(
  identity: NonEmptyStr,
  subject: SubjectProcessorPopulationReceipt,
  firmware: NonEmptyStr,
  universe_identity: NonEmptyStr,
  policy: NonSourceDomainPolicy,
  concurrency: Nat,
) -> MemoryChannelExperimentControl {
  MemoryChannelExperimentControl {
    identity: identity,
    subject: subject,
    board_identity: "fixture board",
    board_revision: "revA-fixture",
    configured_firmware_identity: firmware,
    slot_universe_identity: universe_identity,
    baseline: PriorVerdictCaptured { identity: "fixture-baseline", verdict: "fixture pass", producer_note: "fixture" },
    workload_protocol: fixture_protocol,
    source_domain: "CPU0",
    non_source_domain_policy: policy,
    concurrency: concurrency,
    billed_unit_law: BilledUnitsEqualConcurrency,
    host_memory_reserve_bytes: fixture_host_reserve,
    workload_pinning: "fixture-pinning",
    numa_policy: "fixture-numa",
  }
}

data control_1p: MemoryChannelExperimentControl = fixture_control(identity: "fixture-control", subject: subject_1p,
  firmware: "fixture firmware", universe_identity: "fixture-universe-1p", policy: NoNonSourceDomain, concurrency: 76)

data control_2p: MemoryChannelExperimentControl = fixture_control(identity: "fixture-control-2p", subject: subject_2p,
  firmware: "fixture firmware", universe_identity: "fixture-universe-2p",
  policy: FixedControlPopulation { expected_signature: "4ch-1dpc-64gib-2Rx4-rdimm" }, concurrency: 76)

fn fixture_workload(machine: NonEmptyStr, domain: NonEmptyStr, invocation: NonEmptyStr, completed_work: Nat, concurrency: Nat, billed: Nat) -> WorkloadObservation {
