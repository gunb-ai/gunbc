data fixture_machine: NonEmptyStr = "fixture board, not the held unit"
data fixture_ref: DeclarationRef = decl_ref(module_path: "test.claim.mobo_x_memory_census_witness", decl_name: "fixture_machine")

data fixture_authority: SlotUniverseAuthority = BoardDrawingAuthority {
  drawing: fixture_ref,
  drawing_digest: "fixture-digest",
}

data universe_1p: MemorySlotUniverseReceipt = MemorySlotUniverseReceipt {
  universe_identity: "fixture-universe-1p",
  board_identity: "fixture board",
  board_revision: "revA-fixture",
  authority: fixture_authority,
  note: "fixture",
  first_slot: fixture_first_slot,
  additional_slots: fixture_cpu0_rest,
}

data universe_2p: MemorySlotUniverseReceipt = MemorySlotUniverseReceipt {
  universe_identity: "fixture-universe-2p",
  board_identity: "fixture board",
  board_revision: "revA-fixture",
  authority: fixture_authority,
  note: "fixture",
  first_slot: fixture_first_slot,
  additional_slots: concat(fixture_cpu0_rest, fixture_cpu1_slots),
}

fn universe_slots_named(u: MemorySlotUniverseReceipt, designation: NonEmptyStr) -> List<UniverseSlot> {
  universe_slot_list(u: u) |> filter(e => e.slot_designation == designation)
}

fn universe_slot_list(u: MemorySlotUniverseReceipt) -> List<UniverseSlot> {
  concat([u.first_slot], u.additional_slots)
}

fn fixture_axes(capacity_gib: Nat, ranks: Nat, width: Nat, cls: MemoryModuleClass) -> ModuleAxes {
  ModuleAxes {
    capacity_gib: capacity_gib,
    ranks: ranks,
    device_width_bits: width,
    module_class: cls,
    part_identity: "fixture part",
  }
}

// THE PHYSICAL INSPECTION KNOWS THE MODULE AND ITS RATED SPEED; IT DOES NOT KNOW A TRAINED SPEED,
// and the type gives it nowhere to invent one.
fn fixture_installed_slots(u: MemorySlotUniverseReceipt, designations: List<NonEmptyStr>, capacity_gib: Nat, ranks: Nat, width: Nat, cls: MemoryModuleClass) -> List<InstalledSlotObservation> {
  universe_slot_list(u: u) |> map(e => InstalledSlotObservation {
    slot_designation: e.slot_designation,
    channel_designation: e.channel_designation,
    processor_domain: e.processor_domain,
    module: if count(designations |> filter(d => d == e.slot_designation)) > 0 {
      ModuleInstalled { axes: fixture_axes(capacity_gib: capacity_gib, ranks: ranks, width: width, cls: cls), rated_speed_mts: 3200, part_authority: fixture_ref }
    } else {
      SlotVacant
    },
  })
}

fn fixture_trained_slots(u: MemorySlotUniverseReceipt, designations: List<NonEmptyStr>, capacity_gib: Nat, ranks: Nat, width: Nat, cls: MemoryModuleClass) -> List<MemorySlotObservation> {
  universe_slot_list(u: u) |> map(e => MemorySlotObservation {
    slot_designation: e.slot_designation,
    channel_designation: e.channel_designation,
    processor_domain: e.processor_domain,
    trained: if count(designations |> filter(d => d == e.slot_designation)) > 0 {
      TrainedModulePresent { axes: fixture_axes(capacity_gib: capacity_gib, ranks: ranks, width: width, cls: cls), trained_speed_mts: 3200 }
    } else {
      TrainedSlotEmpty
    },
  })
}

data fixture_os_visible: Nat = 250000000000
data fixture_host_reserve: Nat = 10000000000

fn fixture_usable(machine: NonEmptyStr, domain: NonEmptyStr, run: NonEmptyStr, os_visible: Nat, reserve: Nat) -> DomainUsableMemoryObservation {
  DomainUsableMemoryObservation {
    subject_machine: machine,
    processor_domain: domain,
    producer_run_identity: run,
    os_visible_bytes: os_visible,
    host_reserved_bytes: reserve,
  }
}

fn fixture_census(
  machine: NonEmptyStr,
  u: MemorySlotUniverseReceipt,
  firmware: NonEmptyStr,
  run: NonEmptyStr,
  designations: List<NonEmptyStr>,
  capacity_gib: Nat,
  ranks: Nat,
  width: Nat,
  cls: MemoryModuleClass,
  os_visible: Nat,
  domains: List<NonEmptyStr>,
  machine_visible: Nat,
) -> HostMemoryCensusReceipt {
  HostMemoryCensusReceipt {
    subject_machine: machine,
    board_identity: "fixture board",
    board_revision: "revA-fixture",
    firmware_identity: firmware,
    universe: u,
    producer: LinuxDmidecodeEdac,
    producer_run_identity: run,
    observed_at: "fixture",
    observed_slots: fixture_trained_slots(u: u, designations: designations, capacity_gib: capacity_gib, ranks: ranks, width: width, cls: cls),
    domain_usable_memory: domains |> map(d => fixture_usable(machine: machine, domain: d, run: run, os_visible: os_visible, reserve: fixture_host_reserve)),
    first_raw_evidence: "fixture dmidecode --type 17 transcript",
    additional_raw_evidence: [],
    trained_visible_bytes: machine_visible,
  }
}

fn census_1p(run: NonEmptyStr, designations: List<NonEmptyStr>, capacity_gib: Nat, ranks: Nat, width: Nat) -> HostMemoryCensusReceipt {
  fixture_census(machine: fixture_machine, u: universe_1p, firmware: "fixture firmware", run: run, designations: designations,
    capacity_gib: capacity_gib, ranks: ranks, width: width, cls: Rdimm,
    os_visible: fixture_os_visible, domains: ["CPU0"], machine_visible: fixture_os_visible)
}

fn fixture_inspection_over(machine: NonEmptyStr, cited: MemorySlotUniverseReceipt, rows_from: MemorySlotUniverseReceipt, designations: List<NonEmptyStr>, capacity_gib: Nat, ranks: Nat, width: Nat) -> ExecutedPhysicalPopulationReceipt {
  ExecutedPhysicalPopulationReceipt {
    subject_machine: machine,
    universe: cited,
    installed_slots: fixture_installed_slots(u: rows_from, designations: designations, capacity_gib: capacity_gib, ranks: ranks, width: width, cls: Rdimm),
    first_evidence: fixture_ref,
    additional_evidence: [],
    observed_before_power_on: "fixture: every slot inspected before power-on",
    producer: "fixture operator",
  }
}

fn fixture_inspection(machine: NonEmptyStr, u: MemorySlotUniverseReceipt, designations: List<NonEmptyStr>, capacity_gib: Nat, ranks: Nat, width: Nat) -> ExecutedPhysicalPopulationReceipt {
  ExecutedPhysicalPopulationReceipt {
    subject_machine: machine,
    universe: u,
    installed_slots: fixture_installed_slots(u: u, designations: designations, capacity_gib: capacity_gib, ranks: ranks, width: width, cls: Rdimm),
    first_evidence: fixture_ref,
    additional_evidence: [],
    observed_before_power_on: "fixture: every slot inspected before power-on",
    producer: "fixture operator",
  }
}

