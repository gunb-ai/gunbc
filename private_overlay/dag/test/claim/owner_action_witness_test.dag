// WHAT THIS WITNESS IS. Every claim below is a FOLD OVER THE LIVE ROSTER, and every one of them is
// accompanied by a mutated roster that must make it FALSE. A coverage claim that only ever sees the
// corpus that satisfies it is a decoration; the reds here are what make the greens mean something.
//
// The mutations are deletions and fixtures rather than edits, because deletion is the census: drop
// the step that covers an outcome and the coverage derivation must refuse.

fn without_step(step_id: NonEmptyStr) -> List<OwnerStep> {
  filter(owner_steps, s => s.step_id != step_id)
}

// Deleting every OPEN step of a covered outcome is the sharper census: what breaks is exactly what
// was load-bearing, and an outcome left with only discharged receipts must render as undecomposed.
fn without_open_steps_for(item_id: NonEmptyStr) -> List<OwnerStep> {
  filter(owner_steps, s => !(s.plan_item == item_id && !step_is_discharged(step: s)))
}

// A discharged step promising one receipt and carrying another.
fn fixture_receipt_mismatch() -> OwnerStep {
  OwnerStep {
    step_id: "fixture-receipt-mismatch",
    plan_item: "hw-first-host",
    work: DelegatedActionWork { instruction: "fixture" },
    start_requirements: [],
    produces_receipt: "promised-receipt",
    progress: StepDischarged {
      receipt: ActionReceipt {
        receipt_id: "some-other-receipt",
        evidence: ObservedFact {
          subject: "fixture",
          observation: "fixture",
          observed_at: "2026-09-10",
        },
      },
    },
  }
}

