// THE OPERATOR ACT IS IN THE QUEUE. Before this the data map's operator input lived only in the
// last sentence of rank 12's status note in strategy.year_end_plan, so the surface whose entire job
// is "what does the operator have to do" did not know it existed. This asserts the fold surfaces it
// exactly once, and ready rather than Blocked -- nothing is stopping the operator from ANSWERING.
// The act is supplying inputs, not ratifying: ratification is gated on counsel and is not work
// anyone can be told to do today.
fn the_data_map_operator_input_is_actionable_in_the_queue() -> Bool {
  count(filter(
    owner_queue(steps: owner_steps),
    s => count(filter(state_step_id(state: s), id => id == "m2-data-map-operator-inputs")) == 1
      && state_is_ready(state: s),
  )) == 1
}

// AND DELETING THE STEP REFUSES RATHER THAN GOING QUIET, which is the failure this enrolment has to
// survive: an item enrolled as a subject whose only step is later removed must not slide back out of
// the operator's view the way it was out of it before. Over a roster with the step filtered away the
// item renders NeedsDecomposition -- the queue says the outcome has no executable child instead of
// dropping it. The red is authorable by deleting the step, which is exactly the edit to guard.
fn removing_the_step_refuses_rather_than_dropping_the_item() -> Bool {
  count(filter(
    item_queue_states(
      item_id: "m2-data-map",
      steps: filter(owner_steps, s => s.step_id != "m2-data-map-operator-inputs"),
    ),
    st => state_needs_decomposition(state: st),
  )) == 1
}

// THE PERMISSION STEP'S DISCHARGE IS A CITATION UNTIL THIS JOIN READS IT. decl_ref only names a
// declaration; this claim resolves the one the receipt names to the decision it is, and requires
// that decision to be the operator's selected risk acceptance with every typed limitation present.
// Change the decision, re-point the receipt, or drop a limitation and this goes red.
fn receipt_cites_the_retention_decision(receipt: ActionReceipt) -> Bool {
  match receipt.evidence {
    CorpusDeclaration { declaration } =>
      declaration.module_path == "strategy.gunbc_strategy"
        && declaration.decl_name == "decision_ebay_retention_permitted",
    MergedPullRequest { repo: _, number: _, merged_at: _, merge_commit_sha: _ } => false,
    ExternalFilingReceipt { authority: _, identifier: _, received_at: _ } => false,
    PaymentSettled { instrument: _, amount_usd: _, settled_at: _ } => false,
    ExternalRequestSent { recipient: _, sent_at: _ } => false,
    ObservedFact { subject: _, observation: _, observed_at: _ } => false,
  }
}

fn step_discharged_by_the_retention_decision(step: OwnerStep) -> Bool {
  match step.progress {
    StepDischarged { receipt: r } => receipt_cites_the_retention_decision(receipt: r),
    StepExternallyRefused { receipt: _, cause: _ } => false,
    StepOpen => false,
  }
}

fn state_is_the_operator_risk_acceptance(state: DecisionState) -> Bool {
  match state {
    Selected { choice_id: c, receipt: r } =>
      c == "operator-accepts-residual-retention-risk" && r.authority == "operator",
    Open => false,
    SupersededBy { question_id: _ } => false,
    RefusedDecision { reason: _ } => false,
  }
}

fn decision_is_the_operator_risk_acceptance(d: StrategicDecision) -> Bool {
  d.question_id == "ebay-retention-permitted" && state_is_the_operator_risk_acceptance(state: d.state)
}

fn the_retention_discharge_joins_the_selected_risk_decision() -> Bool {
  let retention = steps_with_id(steps: owner_steps, step_id: "ebay-retention-permitted")
  let applicability = steps_with_id(steps: owner_steps, step_id: "ebay-exemption-applicability")
  length(retention) == 1
    && all(retention, s => step_discharged_by_the_retention_decision(step: s))
    && length(applicability) == 1
    && all(applicability, s => step_is_open(step: s))
    && decision_is_the_operator_risk_acceptance(d: decision_ebay_retention_permitted)
}

fn owner_action_witness_main() -> ProcessExit {
  if the_retention_discharge_joins_the_selected_risk_decision()
    && the_data_map_operator_input_is_actionable_in_the_queue()
    && removing_the_step_refuses_rather_than_dropping_the_item()
    && subject_items_resolve()
    && steps_target_subject_items(steps: owner_steps)
    && operator_exclusive_coverage(steps: owner_steps)
    && in_progress_items_carry_receipt_and_residue(steps: owner_steps)
    && external_lead_dispatch_and_wait_separated(steps: owner_steps)
    && waits_never_ready(steps: owner_steps)
    && ready_steps_have_no_unmet_requirement(steps: owner_steps)
    && decisions_offer_alternatives(steps: owner_steps)
    && discharged_receipts_match_promise(steps: owner_steps)
    && discharged_operator_steps_cite_site(steps: owner_steps)
    && open_operator_steps_state_the_gap(steps: owner_steps)
    && no_open_item_needs_decomposition(steps: owner_steps)
    && llc_is_a_wait_not_operator_work()
    && counsel_is_dispatch_plus_wait_not_one_task()
    && hw_first_host_renders_named_residue()
    && census_limits_are_consumed()
    && lot_decision_has_a_clock_and_a_wait()
    && storage_merge_is_a_receipt_not_a_sentence()
    && dispatched_waits_carry_a_reference(steps: owner_steps)
    && refused_steps_satisfy_nothing(steps: owner_steps)
    && refusal_behaves_as_a_dead_end()
    && wait_reference_red_is_real()
    && wait_outcome_accessor_is_total()
    && wait_outcomes_cover_exactly_the_waits()
    && refused_wait_reads_refused()
    && wait_outcome_agrees_with_step_state(steps: owner_steps)
    && cpa_dispatch_is_gated_on_arm_and_calendar()
    && cpa_dispatch_opens_at_tax_time()
    && no_row_presupposes_an_accountant()
    && cohort_reaches_its_committed_dates()
    && consumers_use_independent_dimensions()
    && the_two_authorities_are_separate()
    && source_read_is_not_an_answer()
    && standings_are_not_queue_work()
    && relationship_hygiene()
    && outreach_asks_are_coherent()
    && coverage_reds_are_real()
    && step_reds_are_real()
    && done_coherence_red_is_real()
    && hw_residue_red_is_real()
    && owner_queue_size(steps: owner_steps) > 0
    && live_owner_queue_shows_llc_exposure_while_filing_open()
    && m2_done_shows_llc_exposure_live()
    && filing_done_hides_llc_exposure_from_owner_queue()
    && owner_queue_size_excludes_exposures()
    && m2_success_opens_llc_court_exposure()
  {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: owner_action_witness_report() }
  }
}
