// A wait whose dispatch is discharged while its reference still says nothing was sent.
fn fixture_dispatched_wait_without_reference() -> List<OwnerStep> {
  concat(
    filter(owner_steps, s => s.step_id == "llc-package-mailed"),
    [OwnerStep {
      step_id: "fixture-sent-wait-no-reference",
      plan_item: "llc-publication-filing",
      work: ExternalWaitWork {
        wait: ExternalWait {
          partial_answers: [],
          awaited_event: "fixture",
          blocks: ["llc-publication-filing"],
          window: OperatorFollowUp { next_check: "2026-09-26", basis: "fixture" },
          fallback: NoFallbackDeclared { reason: "fixture" },
          reference: RequestNotYetSent,
        },
      },
      start_requirements: [AfterStep { step_id: "llc-package-mailed" }],
      produces_receipt: "fixture-wait",
      progress: StepOpen,
    }],
  )
}

// A refused external answer, and a step that would start only if the refusal counted as a discharge.
fn fixture_refused_wait_roster() -> List<OwnerStep> {
  [
    OwnerStep {
      step_id: "fixture-refused-wait",
      plan_item: "counsel-market-census",
      work: ExternalWaitWork {
        wait: ExternalWait {
          partial_answers: [],
          awaited_event: "an approval that came back NO",
          blocks: ["counsel-market-census"],
          window: OperatorFollowUp { next_check: "2026-09-26", basis: "fixture" },
          fallback: DeclaredFallback { on_or_after: "2026-09-26", alternatives: ["fixture arm"] },
          reference: ReferencedRequest {
            authority: "fixture counterparty",
            identifier: "fixture-request-id",
            sent_at: "2026-09-10",
          },
        },
      },
      start_requirements: [],
      produces_receipt: "fixture-refused",
      progress: StepExternallyRefused {
        receipt: ActionReceipt {
          receipt_id: "fixture-refused",
          evidence: ExternalFilingReceipt {
            authority: "fixture counterparty",
            identifier: "rejection",
            received_at: "2026-09-11",
          },
        },
        cause: "the counterparty declined",
      },
    },
    OwnerStep {
      step_id: "fixture-depends-on-refusal",
      plan_item: "counsel-market-census",
      work: DelegatedActionWork { instruction: "fixture" },
      start_requirements: [AfterStep { step_id: "fixture-refused-wait" }],
      produces_receipt: "fixture-dependent",
      progress: StepOpen,
    },
  ]
}

// THE DEPENDENT MUST EXIST BEFORE IT CAN BE BLOCKED. `first()` answers an Optional, so an empty
// filter has no step to judge; reading Absent as `false` keeps a vanished fixture row a failure of
// this claim rather than a silently skipped assertion.
fn dependent_step_is_blocked(roster: List<OwnerStep>) -> Bool {
  match filter(roster, s => s.step_id == "fixture-depends-on-refusal").first() {
    Present { value: s } => state_is_blocked(state: step_state(step: s, steps: roster))
    Absent => false
  }
}

// A REFUSAL IS NOT A DISCHARGE AND NOT A PENDING WAIT. The refused step must satisfy nothing, its
// dependent must stay Blocked rather than becoming ready, and an outcome left with nothing but a
// refusal must render NeedsDecomposition rather than an empty, contented queue.
fn refusal_behaves_as_a_dead_end() -> Bool {
  let roster = fixture_refused_wait_roster()
  refused_steps_satisfy_nothing(steps: roster)
    && count(filter(roster, s => step_is_open(step: s))) == 1
    && count(filter(roster, s => step_is_externally_refused(step: s))) == 1
    && dependent_step_is_blocked(roster: roster)
    && count(filter(
      item_queue_states(item_id: "counsel-market-census", steps: filter(roster, s => step_is_externally_refused(step: s))),
      q => state_needs_decomposition(state: q))) == 1
}

