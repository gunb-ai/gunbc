module strategy.year_end_plan

import std.types { Int, List, NonEmptyStr, Bool }
import std.decl_ref { decl_ref }
import strategy.receipt_evidence {
  ReceiptEvidence, MergedPullRequest, ExternalFilingReceipt, PaymentSettled,
  ExternalRequestSent, ObservedFact, CorpusDeclaration,
}

// THE PLAN FROM 2026-08-29 TO YEAR END (operator direction 2026-08-29), worked BACKWARDS
// from a small private demo - the current 4 servers, free founding credits to a handful of
// trusted customers - with every long-lead lever (compliance, security, storage, colo
// agreements, acquisition instrumentation, machine health) sorted BEFORE the exponential-
// scaling window can demand it. AMENDED 2026-08-29 per the external analyst's ruling: the
// three anchor DATES stand, but their exits are recut so each date establishes the
// smallest executed fact that safely authorizes the next irreversible step, never the
// largest plausible feature bundle attachable to the date; two internal stage gates
// (2026-10-15, 2026-11-23) keep the outer anchors honest about what they prove.

// M4JanuaryLaunch ADDED 2026-09-07 (operator: "I meant to say January 7"). The plan previously
// terminated at the year-end gate, which made the launch reachable only in prose while the plan's
// own arithmetic reported the graph finished. 2027-01-07 is day 131 on the plan epoch, nineteen
// days past M3 -- and that spread is the whole schedule for whichever launch form is chosen, which
// is why strategy.january_launch reads BOTH representations from here rather than restating the
// date: one anchor, one authority.
type PlanMilestone
  = M1InternalVertical
  | M1bInternalS0Proof
  | M2FirstExternal
  | M2bPrivateCohort
  | M3YearEndGate
  | M4JanuaryLaunch
  | M5Q2ColoDeployment

fn milestone_order(m: PlanMilestone) -> Int {
  match m {
    M1InternalVertical => 1,
    M1bInternalS0Proof => 2,
    M2FirstExternal => 3,
    M2bPrivateCohort => 4,
    M3YearEndGate => 5,
    M4JanuaryLaunch => 6,
    M5Q2ColoDeployment => 7,
  }
}

fn milestone_anchor_date(m: PlanMilestone) -> NonEmptyStr {
  match m {
    M1InternalVertical => "2026-10-01",
    M1bInternalS0Proof => "2026-10-15",
    M2FirstExternal => "2026-11-02",
    M2bPrivateCohort => "2026-11-23",
    M3YearEndGate => "2026-12-19",
    M4JanuaryLaunch => "2027-01-07",
    M5Q2ColoDeployment => "2027-06-30",
  }
}

// Day offsets from plan epoch 2026-08-29 - the arithmetic carrier for schedule math (ISO
// strings compare but do not subtract). Both representations are declared per milestone
// and the witness asserts they order together.
fn milestone_anchor_day(m: PlanMilestone) -> Int {
  match m {
    M1InternalVertical => 33,
    M1bInternalS0Proof => 47,
    M2FirstExternal => 65,
    M2bPrivateCohort => 86,
    M3YearEndGate => 112,
    M4JanuaryLaunch => 131,
    M5Q2ColoDeployment => 305,
  }
}

type PlanWorkstream
  = Hardware
  | StorageFabric
  | RunnerSoftware
  | SecurityCompliance
  | AcquisitionMarketing
  | OpsMachineHealth
  | EconomicsQa
  | PeopleAndProcess

// THE SINGLE-OPERATOR CORRECTION (analyst): seven workstreams are NOT seven parallel
// lanes - hardware handling, security judgment, legal review, customer onboarding,
// commercial decisions and incident ownership all converge on one person. Every item
// declares how it consumes the operator; the honest WIP shape is roughly one primary
// OperatorExclusive build item plus concurrent ExternalLead queues at a time.
type ExecutionMode
  = OperatorExclusive
  | AgentParallel
  | ExternalLead
  | CalendarObservation

type PlanItemStatus
  = NotStarted
  | InProgress { note: NonEmptyStr }
  | Done { evidence: List<ReceiptEvidence>, note: NonEmptyStr }
  | DeclaredBehind { reason: NonEmptyStr }

// rank: a declared topological level - every dependency must carry a STRICTLY smaller
// rank, which makes a dependency cycle unwritable (no cycle admits strictly decreasing
// ranks). Construction standing where the previous witness only checked resolution.
// min_calendar_days: the item's floor duration; latest safe start derives from it.
// THE EDGE VOCABULARY, AND WHY IT IS NEW RATHER THAN REUSED. Before minting this, the nearest
// existing authority is strategy.workflow_stage_gate WorkflowDependency, which carries a
// predecessor, a NodeActivation and a DependencyKind. It owns ACTIVATION (is this edge live for
// the selected candidate) and ADMISSION (does crossing it require a permit). It carries NO
// TEMPORAL axis at all - nothing distinguishes must-have-finished from must-have-started, and
// nothing carries a lag - and it is keyed by DeclarationRef over workflow nodes rather than by
// plan item id. So the timing question this plan needs is genuinely a different concept, not a
// second name for that one. If the two ever merge, the merge is WorkflowDependency gaining a
// temporal field and this type dissolving into it, not the reverse.
//
// WHY THE PLAN NEEDS IT AT ALL. A bare id can only mean complete-before-start, so the untyped
// carrier serialized every dependency by construction - the serialization was never a decision
// anyone made, it is what the type could express. That is why latest_start_day below could not
// see a chain: with one edge kind and a per-item subtraction there is no path to roll up.
//
// AN UNCLASSIFIED EDGE IS DECLARED, NOT ASSUMED. Most rows still carry `dep(...)`, which means
// COMPLETION-REQUIRES AT THE CARRIER'S PRIOR MEANING, NOT YET INTERROGATED. That is countable
// (unclassified_edge_count) rather than silent, so the migration frontier is readable and a row
// that was actually examined is distinguishable from one that was merely carried.
type PlanEdge
  = CompletionRequires { of: NonEmptyStr, why: NonEmptyStr }
  | StartRequires { of: NonEmptyStr, why: NonEmptyStr }
  | StartAfterStart { of: NonEmptyStr, lag_days: Int, consumed_artifact: NonEmptyStr, why: NonEmptyStr }
  | ConditionalRequires { of: NonEmptyStr, condition: NonEmptyStr, why: NonEmptyStr }
  | ObservationWindow { of: NonEmptyStr, window_days: Int, why: NonEmptyStr }

data unclassified_edge_basis: NonEmptyStr = "CARRIED FROM THE UNTYPED CARRIER AND NOT YET INTERROGATED. The previous depends_on held a bare id, whose only possible meaning is complete-before-start, so that is what this edge asserts. It is not a finding that the predecessor must finish first - it is the absence of one, made countable so the difference is visible."

fn dep(id: NonEmptyStr) -> PlanEdge {
  CompletionRequires { of: id, why: unclassified_edge_basis }
}

fn edge_of(e: PlanEdge) -> NonEmptyStr {
  match e {
    CompletionRequires { of, why } => of,
    StartRequires { of, why } => of,
    StartAfterStart { of, lag_days, consumed_artifact, why } => of,
    ConditionalRequires { of, condition, why } => of,
    ObservationWindow { of, window_days, why } => of,
  }
}

fn edge_is_unclassified(e: PlanEdge) -> Bool {
  match e {
    CompletionRequires { of, why } => why == unclassified_edge_basis,
    StartRequires { of, why } => false,
    StartAfterStart { of, lag_days, consumed_artifact, why } => false,
    ConditionalRequires { of, condition, why } => false,
    ObservationWindow { of, window_days, why } => false,
  }
}

// A conditional edge does not constrain the UNCONDITIONAL schedule: the work behind it may never
// be bought. It constrains the conditional reading, which is reported separately rather than
// folded in, because averaging a branch that may not happen into the headline is how a schedule
// starts describing a world nobody is in.
// The id projection. depends_on is the AUTHORITY and this is derived from it, so there is no
// second edge list anywhere - a consumer that only needs membership reads this rather than
// keeping its own copy.
fn dep_ids_of(edges: List<PlanEdge>) -> List<NonEmptyStr> {
  map(edges, e => edge_of(e: e))
}

fn edge_is_conditional(e: PlanEdge) -> Bool {
  match e {
    CompletionRequires { of, why } => false,
    StartRequires { of, why } => false,
    StartAfterStart { of, lag_days, consumed_artifact, why } => false,
    ConditionalRequires { of, condition, why } => true,
    ObservationWindow { of, window_days, why } => false,
  }
}

// NON-BLOCKING ITEM-TO-ITEM RELATIONS. The plan's edge vocabulary is dep() and StartAfterStart,
// both blocking-temporal. A fact that is not a scheduling constraint had nowhere to live except
// prose, which is how a hazard stated on the item that CURES it stayed invisible from the item
// that TRIGGERS it. relates_to is MODULE-SCOPED (every value on origin/main 1af16d1 is a dotted
// module path) and must not take a plan-item id - that would be a section 3 meaning fork.
//
// THIS FIELD IS OPTIONAL IN CONTENT, REQUIRED IN SHAPE. An empty list is the honest zero: most
// of the 91 items have no such relation. A required Option would still need a value on every row.
// The field is required so absence is written, not inferred. It has NO scheduling force: latest_start
// and done_implies_deps_done read depends_on only. A genuinely blocking relation already has dep()
// and does not belong here.
//
// ARMS ARE THE CLASSIFIED CENSUS ON origin/main 1af16d1, not a general ontology. Detector: PlanItem
// constructors only; depends_on extracted from dep(id) and of: in that field; prose is
// exit_criterion plus status, not leading comments. Tests: billing-ux names paid-minimum AND carries
// dep(id: paid-minimum) so it is NOT a census pair (the prior detector's known-bad); cloud-quota-baseline
// names cloud-overflow-role AND depends on it - ConsumesConclusion with a blocking edge, so not this
// carrier; node-local-cache-drive names cache-hit-floor without depending on it (known-good);
// llc-publication-filing names no item id, so the detector cannot find the specimen - it is filed
// here by reading, not by id match.
type PlanItemRelation
  = ConsumesMeasurement { of: NonEmptyStr, why: NonEmptyStr }
  | ConsumesAdmittedWork { of: NonEmptyStr, why: NonEmptyStr }
  | TakesUpDeferredReceipt { of: NonEmptyStr, why: NonEmptyStr }
  | RemainderLivesOn { of: NonEmptyStr, why: NonEmptyStr }
  | ProvidesSubject { of: NonEmptyStr, why: NonEmptyStr }
  | ProcurementBundledWith { of: NonEmptyStr, why: NonEmptyStr }
  | ConstrainedByFinding { of: NonEmptyStr, why: NonEmptyStr }
  | FirstActionLivesOn { of: NonEmptyStr, why: NonEmptyStr }
  | CitesPeerStatement { of: NonEmptyStr, why: NonEmptyStr }
  | ExposureActivatesOnSuccess { of: NonEmptyStr, why: NonEmptyStr }

type PlanItem {
  id: NonEmptyStr
  workstream: PlanWorkstream
  milestone: PlanMilestone
  rank: Int
  min_calendar_days: Int
  active_effort_days: Int
  execution_mode: ExecutionMode
  exit_criterion: NonEmptyStr
  depends_on: List<PlanEdge>
  relates_to: List<NonEmptyStr>
  item_relations: List<PlanItemRelation>
  status: PlanItemStatus
}

data no_deps: List<PlanEdge> = []

data no_refs: List<NonEmptyStr> = []

data no_item_relations: List<PlanItemRelation> = []

