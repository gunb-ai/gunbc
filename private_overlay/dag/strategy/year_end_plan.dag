data item_soc2_baseline: PlanItem = PlanItem {
  id: "soc2-baseline",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 20,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "Control baseline OPERATIONAL by M2, not designed in December: access-review schedule, vendor register, change receipts, incident procedure, restore procedure - so the demo itself produces evidence. Operating these controls is NOT a SOC report and may never be described as one to a customer: a SOC 2 report is independent assurance issued by a CPA practitioner over a defined scope and period, and control evidence is the input to that engagement rather than a substitute for it. Claiming otherwise is a quality claim carrying billing and remedy consequences, which DESIGN section 4b treats as a contract rather than marketing.",
  depends_on: [dep(id: "m2-control-bindings")],
  relates_to: ["strategy.compliance_posture"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_soc2_window: PlanItem = PlanItem {
