data item_year_end_gate: PlanItem = PlanItem {
  id: "s1-gate",
  workstream: EconomicsQa,
  milestone: M3YearEndGate,
  rank: 80,
  min_calendar_days: 1,
  active_effort_days: 1,
  execution_mode: OperatorExclusive,
  exit_criterion: "A TOTAL decision, not a task: the gate derives S1Admitted-with-evidence or S1Refused-with-unmet-list from upstream receipts - the date commits to an ANSWER, never that every prerequisite is green. Almost no independent implementation lives here.",
  depends_on: [dep(id: "s0-receipts"), dep(id: "soc2-window"), dep(id: "acquisition-instrumented"), dep(id: "machine-health-model"), dep(id: "lot-decision"), dep(id: "marketing-min"), dep(id: "billing-ux"), dep(id: "commercial-demand-standing"), dep(id: "tenant-shared-fleet-suite"), dep(id: "storage-recovery-rewarm-drill"), dep(id: "tax-insurance-scope"), dep(id: "spares-control-plane-readiness"), dep(id: "package-upstream-admission")],
  relates_to: ["strategy.workflow_stage_gate"],
  item_relations: no_item_relations,
  status: NotStarted,
}


// THE BENCHMARK GAP (operator, 2026-09-04). Fleet admission and the price claim both rest on
// a workload figure and neither has one. The honest difficulty is that customer workloads are
// DIVERSE, so a single build is not a benchmark suite — it is one sample presented as a
// population. These five items separate what one node can settle now from what needs a real
// customer, because conflating them is how a benchmark ends up measuring the operator's own
// repository and being quoted as a customer fact.

data item_workload_benchmark_suite: PlanItem = PlanItem {
  id: "workload-benchmark-suite",
  workstream: EconomicsQa,
  milestone: M1bInternalS0Proof,
  rank: 20,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: AgentParallel,
  exit_criterion: "A NAMED, EXECUTABLE suite standing in for customer build and test work, with its representativeness argued rather than assumed: at least one large compiled-language build, one test-heavy run whose cost is dominated by process spawn rather than compute, and one dependency-fetch-dominated job — three different bottlenecks, so a fleet tuned to one can be wrong for the others. Each case declares what it stresses and what it deliberately does not measure. The repository's own release build is admissible as ONE case and is not the suite.",
  depends_on: [dep(id: "hw-first-host")],
  relates_to: ["strategy.fleet_qualification", "strategy.ci_build_frontier"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_fleet_capacity_floor: PlanItem = PlanItem {
  id: "fleet-capacity-floor",
  workstream: Hardware,
  milestone: M1bInternalS0Proof,
  rank: 30,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: OperatorExclusive,
  exit_criterion: "strategy.fleet_qualification's matrix executed on one node — 2666 reference, 2133, single-socket, dense-2133 — producing measured relative throughput per configuration and a DERIVED admission floor replacing the declared 900-per-mille placeholder, which currently records an intent rather than an observation. Memtest at each configuration in the same cycle discharges the engineering-sample sustained-load qualification as a by-product. SUBJECT NAMED 2026-09-10 (operator): RUN THE MATRIX ON THE MT. COLLINS 1U, deliberately, because it is the thermally tightest chassis in the fleet and is expected to struggle. A capacity floor measured on the most forgiving machine is an optimistic bound that every other node then fails to meet; measured on the tightest one it is a floor the fleet can actually hold. If the 1U throttles under sustained load, THAT IS THE RESULT -- record it as the measured ceiling for this chassis rather than retrying on a roomier one, because the fleet is twenty of these.",
  depends_on: [dep(id: "hw-first-host"), dep(id: "workload-benchmark-suite")],
  relates_to: ["strategy.fleet_qualification"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_memory_bom_decision: PlanItem = PlanItem {
  id: "memory-bom-decision",
  workstream: Hardware,
  milestone: M1bInternalS0Proof,
  rank: 40,
  min_calendar_days: 2,
  active_effort_days: 2,
  execution_mode: OperatorExclusive,
  exit_criterion: "DIMM population selected against QUALIFIED STOCK and a chosen concurrency, NOT a mandatory module capacity - an earlier version of this row derived that 32 GB modules were forced and that 64 GB were wasted, and both claims are WITHDRAWN as invalid. THE TWENTY INVOICED UNITS SHIP WITHOUT RAM, so there is no incumbent population to preserve and this is a greenfield choice for the fleet; the held unit's sixteen installed modules are INVENTORY TO NET AGAINST, never a baseline, and its roughly 256 GiB is an artifact of one machine's current state rather than a deployment option. Any row that reads 256 GiB as a candidate has confused an observation with a plan. THE CONCURRENCY IS NO LONGER UNCHOSEN, and that is what changed: measured customer runner sizes on real arm64 CI - 16, 8 and 4 vCPU, with the 16-vCPU shape carrying the clear majority of one repository's minutes - run through strategy.ci_sellable_unit give the same answer at every size. A unit is one physical core with three DECIMAL gigabytes, so a 16-vCPU job needs 44.7 GiB, an 8-vCPU job 22.4 and a 4-vCPU job 11.2. Against 160 cores and an illustrative 4 GiB host allowance, a 256 GiB node is MEMORY-BOUND at every one of those sizes and sells only 80 to 88 of its 160 cores; a 512 GiB node is CORE-bound at every one of them and sells all 160; a 1024 GiB node sells no additional core and its extra memory buys cache or scratch rather than capacity. So the target is a population reaching approximately 512 GiB, derived from observed demand shape rather than from an assumed cache reservation, and the 1024 GiB case must be argued on cache or scratch or not at all. THE CACHE RESERVATION REMAINS A DECISION VARIABLE AND NOT A PREMISE: every GiB reserved is a unit not sold, and it may not authorize a purchase until its size is chosen. WHAT IS STILL OPEN IS HOW TO REACH 512, NOT WHETHER: thirty-two 16 GiB modules at two DIMMs per channel and sixteen 32 GiB modules at one per channel both total 512 GiB and are NOT equivalent - 2DPC derates the data rate against product.node_power_envelope altra_two_dpc_ceilings, whose rows are themselves transcribed and uncited. Blocked on the J-slot census, which decides whether the held unit's sixteen modules already occupy all sixteen channels - in which case filling the empty slots trades bandwidth for capacity - or only eight, in which case half the memory channels are dark today and filling them is free bandwidth",
  depends_on: [dep(id: "fleet-capacity-floor"), dep(id: "buyer-agent-pipeline"), dep(id: "fleet-network-baseline")],
  relates_to: ["strategy.fleet_qualification", "strategy.ci_node_build"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_customer_workload_profile: PlanItem = PlanItem {
