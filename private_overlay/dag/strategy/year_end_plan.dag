// REVIEW REPAIR 2026-09-14 (P2): wholesale-supply-channel exits on a stated price OR an explicit no,
// so its completion is not evidence a buyer wants a pilot. This item is the POSITIVE CARRIER:
// wholesale_batch_floor offer_disposition must read OfferAccepted for the named buyer before the
// provider integration or the pilot order can start; OfferDeclined ends the path for that buyer.
data item_wholesale_offer_acceptance: PlanItem = PlanItem {
  id: "wholesale-offer-acceptance",
  workstream: AcquisitionMarketing,
  milestone: M3YearEndGate,
  rank: 62,
  min_calendar_days: 2,
  active_effort_days: 2,
  execution_mode: OperatorExclusive,
  exit_criterion: "wholesale_batch_floor offer_disposition recorded as OfferAccepted { buyer, offer_revision, boundary, pilot_requested } from the buyer's written acceptance of a named tier revision, or as OfferDeclined { buyer, reason }. Only OfferAccepted satisfies this item; a decline is recorded and the wholesale path for that buyer stops here rather than flowing into a pilot order.",
  depends_on: [dep(id: "wholesale-supply-channel")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.wholesale_buyer"],
  item_relations: no_item_relations,
  status: NotStarted,
}

