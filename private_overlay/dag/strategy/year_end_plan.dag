data item_demo_cohort: PlanItem = PlanItem {
  id: "demo-cohort",
  workstream: AcquisitionMarketing,
  milestone: M2bPrivateCohort,
  rank: 60,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: ExternalLead,
  exit_criterion: "3-5 trusted customers active on founding credits; at least one completes an UNAIDED onboarding (the receipt docs-dry-run deferred); migrations timed. OPERATOR RULING 2026-08-29, settled - do not relitigate: free minutes are fine given spare capacity and highly trusted users; the bound is a COUPON (fixed credit, expiry, per-org concurrency cap). Analyst refinement consistent with it: the SKU carries a real founding price from job one, credits pay the invoice, and at least one commercial sentinel pays a nonzero prepaid amount before the S1 decision.",
  depends_on: [CompletionRequires { of: "customer-journey-acceptance", why: "A cohort is several instances of the journey one person already completed. Running it first with an invited person is what turns a cohort from a discovery exercise into a repetition." }, dep(id: "first-external-customer"), dep(id: "customer-portal"), dep(id: "runner-lifecycle")],
  relates_to: ["strategy.ci_acquisition"],
  item_relations: [TakesUpDeferredReceipt { of: "docs-dry-run", why: "Unaided onboarding is the receipt docs-dry-run deferred; this item produces it rather than waiting on that item to finish." }],
  status: NotStarted,
}

