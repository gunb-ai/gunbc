// The exact wholesale-gate conjunction, as identities, beside the s1-gate one.
// THE GATE DEPENDS ON A SIGNED CONTRACT, NOT ON THE OFFER (Codex review, PR #123):
// wholesale-supply-channel exits on a stated requirement set OR AN EXPLICIT NO, so as a positive
// dependency it could unblock billing after a rejection. It is reached transitively through
// pilot-order -> pilot-acceptance -> production-contract, and only the contract carries an acceptance.
data wholesale_gate_required_deps: List<NonEmptyStr> = [
  "wholesale-production-readiness", "wholesale-offboarding-erasure",
  "colo-contract-execution",
  "wholesale-production-contract-execution", "wholesale-capacity-billing-settlement",
]

// The exact s1-gate conjunction, as identities - a count alone would still pass if a
// required dependency were swapped for an unrelated one while the count held.
data s1_gate_required_deps: List<NonEmptyStr> = [
  "s0-receipts", "soc2-window", "acquisition-instrumented",
  "machine-health-model", "lot-decision", "marketing-min", "billing-ux",
  "commercial-demand-standing", "tenant-shared-fleet-suite", "storage-recovery-rewarm-drill",
  "tax-insurance-scope", "spares-control-plane-readiness", "package-upstream-admission",
]

// WHAT THE S1 GATE DECIDED, SEPARATE FROM WHETHER IT FINISHED. The gate's exit criterion admits
// S1Refused as a correct completion, so its item status going Done says the question was
// answered, not that the answer permits anything. A consumer that needs permission reads this
// row; one that needs completion reads the item. Undecided is carried explicitly so "not yet
// decided" refuses rather than reading as either answer.
type S1GateOutcome
  = S1Undecided
  | S1Admitted { evidence: List<ReceiptEvidence> }
  | S1Refused { unmet: List<NonEmptyStr> }

data s1_gate_outcome: S1GateOutcome = S1Undecided {}

// ---------------------------------------------------------------------------------------------
// Structural checks the witness executes.
// ---------------------------------------------------------------------------------------------

// THE RECEIPT A Done ROW STANDS ON, AS DATA. Before this existed the receipt was one prose
// string, so "which PR closed this" was a question only a human reading the sentence could
// answer. These two folds are what make it a question the corpus can answer, and they are the
// reason Done may no longer be prose-only -- the witness asserts the count is never zero.
fn done_evidence(i: PlanItem) -> List<ReceiptEvidence> {
  match i.status {
    NotStarted => [],
    InProgress { note } => [],
    DeclaredBehind { reason } => [],
    Done { evidence, note } => evidence,
  }
}

fn done_merge_shas(i: PlanItem) -> List<NonEmptyStr> {
  flat_map(done_evidence(i: i), e => match e {
    MergedPullRequest { repo, number, merged_at, merge_commit_sha } => [merge_commit_sha],
    ExternalFilingReceipt { authority, identifier, received_at } => [],
    PaymentSettled { instrument, amount_usd, settled_at } => [],
    ExternalRequestSent { recipient, sent_at } => [],
    ObservedFact { subject, observation, observed_at } => [],
    CorpusDeclaration { declaration } => [],
  })
}

fn find_item(id: NonEmptyStr) -> List<PlanItem> {
  filter(year_end_plan_items, i => i.id == id)
}

fn dep_resolves(id: NonEmptyStr) -> Bool {
  count(find_item(id: id)) == 1
}

fn dep_ids(i: PlanItem) -> List<NonEmptyStr> {
  dep_ids_of(edges: i.depends_on)
}

fn item_relation_of(r: PlanItemRelation) -> NonEmptyStr {
  match r {
    ConsumesMeasurement { of, why } => of,
    ConsumesAdmittedWork { of, why } => of,
    TakesUpDeferredReceipt { of, why } => of,
    RemainderLivesOn { of, why } => of,
    ProvidesSubject { of, why } => of,
    ProcurementBundledWith { of, why } => of,
    ConstrainedByFinding { of, why } => of,
    FirstActionLivesOn { of, why } => of,
    CitesPeerStatement { of, why } => of,
    ExposureActivatesOnSuccess { of, why } => of,
  }
}

fn item_relation_kind_label(r: PlanItemRelation) -> NonEmptyStr {
  match r {
    ConsumesMeasurement { of, why } => "consumes measurement",
    ConsumesAdmittedWork { of, why } => "consumes admitted work",
    TakesUpDeferredReceipt { of, why } => "takes up deferred receipt",
    RemainderLivesOn { of, why } => "remainder lives on",
    ProvidesSubject { of, why } => "provides subject for",
    ProcurementBundledWith { of, why } => "procurement bundled with",
    ConstrainedByFinding { of, why } => "constrained by finding on",
    FirstActionLivesOn { of, why } => "first action lives on",
    CitesPeerStatement { of, why } => "cites peer statement on",
    ExposureActivatesOnSuccess { of, why } => "exposure activates on success of",
  }
}

fn item_relation_is_exposure_on_success(r: PlanItemRelation) -> Bool {
  match r {
    ExposureActivatesOnSuccess { of, why } => true,
    ConsumesMeasurement { of, why } => false,
    ConsumesAdmittedWork { of, why } => false,
    TakesUpDeferredReceipt { of, why } => false,
    RemainderLivesOn { of, why } => false,
    ProvidesSubject { of, why } => false,
    ProcurementBundledWith { of, why } => false,
    ConstrainedByFinding { of, why } => false,
    FirstActionLivesOn { of, why } => false,
    CitesPeerStatement { of, why } => false,
  }
}

fn item_relation_line(r: PlanItemRelation) -> NonEmptyStr {
  join([item_relation_kind_label(r: r), " ", item_relation_of(r: r)], "")
}

fn item_relation_count() -> Int {
  fold(year_end_plan_items, init: 0, f: fn(acc, i) { acc + count(i.item_relations) })
}

fn item_relation_targets_resolve() -> Bool {
  fold(year_end_plan_items, init: true, f: fn(acc, i) {
    acc && fold(i.item_relations, init: true, f: fn(a2, r) { a2 && dep_resolves(id: item_relation_of(r: r)) })
  })
}

fn item_relation_not_also_a_dep() -> Bool {
  fold(year_end_plan_items, init: true, f: fn(acc, i) {
    acc && fold(i.item_relations, init: true, f: fn(a2, r) {
      a2 && count(filter(dep_ids(i: i), d => d == item_relation_of(r: r))) == 0
    })
  })
}

fn exposures_activated_by_success_of_in(items: List<PlanItem>, item_id: NonEmptyStr) -> List<PlanItem> {
  filter(items, i => fold(i.item_relations, init: false, f: fn(acc, r) {
    acc || (item_relation_is_exposure_on_success(r: r) && item_relation_of(r: r) == item_id)
  }))
}

fn exposures_activated_by_success_of(item_id: NonEmptyStr) -> List<PlanItem> {
  exposures_activated_by_success_of_in(items: year_end_plan_items, item_id: item_id)
}

fn incoming_item_relation_lines(item_id: NonEmptyStr) -> List<NonEmptyStr> {
  fold(year_end_plan_items, init: [], f: fn(acc, i) {
    concat(acc, map(filter(i.item_relations, r => item_relation_of(r: r) == item_id), r =>
      join([i.id, " ", item_relation_kind_label(r: r)], "")))
  })
}

fn declared_item_relation_lines(i: PlanItem) -> List<NonEmptyStr> {
  concat(map(i.item_relations, r => item_relation_line(r: r)), incoming_item_relation_lines(item_id: i.id))
}

fn llc_exposure_activates_on_m2_success() -> Bool {
  fold(find_item(id: "llc-publication-filing"), init: false, f: fn(acc, i) {
    acc || fold(i.item_relations, init: false, f: fn(a2, r) {
      a2 || (item_relation_is_exposure_on_success(r: r) && item_relation_of(r: r) == "m2-customer-projections")
    })
  })
    && fold(exposures_activated_by_success_of(item_id: "m2-customer-projections"), init: false, f: fn(acc, i) {
      acc || i.id == "llc-publication-filing"
    })
}

// THE MIGRATION FRONTIER, COUNTED. An edge carrying the prior meaning unexamined is not a
// finding, and the difference between 'we looked and it must complete first' and 'nobody has
// looked' is exactly what a silent default destroys. A reader meets these two numbers on the
// tracker page rather than having to grep for them.
// A COUNTERFACTUAL ROSTER IS BUILT FROM THE PLAN'S OWN ROWS, NOT BESIDE THEM. A lane asking what
// a proposed change would buy needs the plan's items with one figure altered and the SAME
// schedule fold run over them - not a private roster with private durations, which is how two
// schedules start. This is the only supported way to make one, and it changes exactly one field.
fn with_elapsed_window(i: PlanItem, days: Int) -> PlanItem {
  PlanItem {
    id: i.id,
    workstream: i.workstream,
    milestone: i.milestone,
    rank: i.rank,
    min_calendar_days: days,
    active_effort_days: if i.active_effort_days > days { days } else { i.active_effort_days },
    execution_mode: i.execution_mode,
    exit_criterion: i.exit_criterion,
    depends_on: i.depends_on,
    relates_to: i.relates_to,
    item_relations: i.item_relations,
    status: i.status,
  }
}

fn roster_with_elapsed(items: List<PlanItem>, id: NonEmptyStr, days: Int) -> List<PlanItem> {
  map(items, i => if i.id == id { with_elapsed_window(i: i, days: days) } else { i })
}

fn with_status(i: PlanItem, status: PlanItemStatus) -> PlanItem {
  PlanItem {
    id: i.id,
    workstream: i.workstream,
    milestone: i.milestone,
    rank: i.rank,
    min_calendar_days: i.min_calendar_days,
    active_effort_days: i.active_effort_days,
    execution_mode: i.execution_mode,
    exit_criterion: i.exit_criterion,
    depends_on: i.depends_on,
    relates_to: i.relates_to,
    item_relations: i.item_relations,
    status: status,
  }
}

// A FIXTURE Done IS EVIDENCED BY THE FIXTURE, and saying so is the only honest arm available. This
// roster is constructed inside a witness, so no PR merged, nothing settled, and nothing was observed
// about the world -- inventing an ObservedFact here would put a fabricated observation into the same
// carrier the real rows use, which is precisely what the typed evidence exists to prevent. The
// citation names the declaration that built the row, so a reader meeting a Done with this evidence
// knows immediately it is constructed rather than earned. The caller's sentence stays in note, where
// a sentence belongs.
fn roster_with_item_done(items: List<PlanItem>, id: NonEmptyStr, receipt: NonEmptyStr) -> List<PlanItem> {
  map(items, i => if i.id == id {
    with_status(i: i, status: Done {
      evidence: [
        CorpusDeclaration {
          declaration: decl_ref(module_path: "strategy.year_end_plan", decl_name: "roster_with_item_done"),
        },
      ],
      note: receipt,
    })
  } else { i })
}

fn unclassified_edge_count() -> Int {
  fold(year_end_plan_items, init: 0, f: fn(acc, i) {
    acc + count(filter(i.depends_on, e => edge_is_unclassified(e: e)))
  })
}

fn classified_edge_count() -> Int {
  fold(year_end_plan_items, init: 0, f: fn(acc, i) {
    acc + count(filter(i.depends_on, e => edge_is_unclassified(e: e) == false))
  })
}

fn item_deps_resolve(i: PlanItem) -> Bool {
  fold(dep_ids(i: i), init: true, f: fn(acc, d) { acc && dep_resolves(id: d) })
}

fn dep_milestone_order_ok(i: PlanItem) -> Bool {
  fold(dep_ids(i: i), init: true, f: fn(acc, d) {
    acc && fold(find_item(id: d), init: true, f: fn(a2, dep) {
      a2 && milestone_order(m: dep.milestone) <= milestone_order(m: i.milestone)
    })
  })
}

// ACYCLICITY BY CONSTRUCTION: every dependency's declared rank is strictly smaller than
// the dependent's, and no cycle admits strictly decreasing ranks - the same-milestone
// two-cycle the previous witness permitted is now unwritable without also failing this.
fn dep_rank_ok(i: PlanItem) -> Bool {
  fold(dep_ids(i: i), init: true, f: fn(acc, d) {
    acc && fold(find_item(id: d), init: true, f: fn(a2, dep) {
      a2 && dep.rank < i.rank
    })
  })
}

fn plan_graph_sound() -> Bool {
  fold(year_end_plan_items, init: true, f: fn(acc, i) {
    acc && item_deps_resolve(i: i) && dep_milestone_order_ok(i: i) && dep_rank_ok(i: i)
  })
}

fn contains_id(ids: List<NonEmptyStr>, id: NonEmptyStr) -> Bool {
  count(filter(ids, x => x == id)) == 1
}

fn gate_conjunction_exact() -> Bool {
  fold(find_item(id: "s1-gate"), init: false, f: fn(acc, g) {
    count(g.depends_on) == count(s1_gate_required_deps)
      && fold(s1_gate_required_deps, init: true, f: fn(a2, r) { a2 && contains_id(ids: dep_ids(i: g), id: r) })
  })
}

fn item_is_done(i: PlanItem) -> Bool {
  match i.status {
    Done { evidence, note } => true,
    NotStarted => false,
    InProgress { note } => false,
    DeclaredBehind { reason } => false,
  }
}

fn item_not_started(i: PlanItem) -> Bool {
  match i.status {
    NotStarted => true,
    Done { evidence, note } => false,
    InProgress { note } => false,
    DeclaredBehind { reason } => false,
  }
}

// COMPLETION COHERENCE: a Done item whose dependency is not Done is a lie the previous
// model accepted; now it reds the witness. (Typed receipt identities in place of the
// receipt string remain declared follow-up debt - the string proves someone typed text.)
// THE SCHEDULE AND THIS CHECK USED TO DISAGREE ABOUT CONDITIONAL EDGES (repaired 2026-09-11 after
// review). The rollup treats a ConditionalRequires edge as imposing no constraint, because the
// work behind it may never be bought; this check went on requiring that same predecessor to be
// Done unconditionally. One model, two answers about the same edge, and the completion answer was
// the stricter one - so an item could be legitimately complete and still read as incoherent.
//
// A CONDITIONAL EDGE IS EXCLUDED FROM COMPLETION, AND THE RESIDUE IS STATED RATHER THAN HIDDEN:
// whether the branch was actually purchased is NOT MODELLED ANYWHERE, so this check cannot tell
// "never bought, correctly absent" from "bought, incomplete, and being ignored". It excludes,
// which makes a legitimate Done reachable, and it therefore does NOT catch the second case. That
// gap needs a purchased-or-not fact about the branch, which is an owner-action concept and is not
// this module's to mint - conditional_completion_residue is where it is recorded until then.
fn edge_binds_completion(e: PlanEdge) -> Bool {
  edge_is_conditional(e: e) == false
}

fn completion_binding_dep_ids(i: PlanItem) -> List<NonEmptyStr> {
  dep_ids_of(edges: filter(i.depends_on, e => edge_binds_completion(e: e)))
}

data conditional_completion_residue: NonEmptyStr = "A ConditionalRequires edge is excluded from done_implies_deps_done because the plan does not record whether the conditional work was purchased. The excluded case that still needs catching: the branch WAS triggered, its item is not Done, and its dependent is marked Done anyway. Catching it needs a purchased/not-purchased fact carried on the branch, which is an owner-action concept owned elsewhere. Until that exists this is a KNOWN HOLE rather than a closed check, and it is one edge wide - m2-compliance-admission's dependency on m2-contract-deviation-review."

fn conditional_completion_edge_count() -> Int {
  fold(year_end_plan_items, init: 0, f: fn(acc, i) {
    acc + count(filter(i.depends_on, e => edge_is_conditional(e: e)))
  })
}

fn deps_all_done(i: PlanItem) -> Bool {
  fold(completion_binding_dep_ids(i: i), init: true, f: fn(acc, d) {
    acc && fold(find_item(id: d), init: true, f: fn(a2, dep) { a2 && item_is_done(i: dep) })
  })
}

fn done_implies_deps_done() -> Bool {
  fold(year_end_plan_items, init: true, f: fn(acc, i) {
    acc && (!item_is_done(i: i) || deps_all_done(i: i))
  })
}

// ---------------------------------------------------------------------------------------------
// TRACKING, in plan-epoch days (2026-08-29 = day 0). LATE: anchor passed without Done.
// AT RISK: latest safe start (anchor_day - min_calendar_days) has passed and the item is
// UNFINISHED -- not merely unstarted. InProgress past that day is still amber: starting
// an item must not extinguish the only signal that means act today. Late remains the
// stronger colour once the anchor itself has passed.
// ---------------------------------------------------------------------------------------------

// ---------------------------------------------------------------------------------------------
// TWO DURATION FIGURES, BECAUSE THE CORPUS ALREADY SAYS THERE ARE TWO
// ---------------------------------------------------------------------------------------------
// The evidence is not an argument, it is a sentence in an item: m2-legal-issue-spot's own exit
// criterion reads "min_calendar_days is QUEUE LATENCY, not effort, and the census quote replaces
// it." Fourteen days of window, three senior hours of work, one field carrying both.
// m2-contract-deviation-review is the same shape at ten. A field that means two things cannot be
// scheduled correctly against either.
//
// min_calendar_days KEEPS ITS MEANING and is pinned here as the ELAPSED WINDOW - which is what
// its name always said and what the schedule must subtract. active_effort_days is the new fact.
// It is declared on every row rather than kept in a sparse override table, because "effort equals
// window" is a CLAIM about an item and not a default: stated on the row it can be examined and
// corrected, hidden in a default it cannot. Rows that have not been examined therefore assert
// something they have not measured, which is why the split frontier is counted rather than
// assumed complete.
fn elapsed_window_days(i: PlanItem) -> Int { i.min_calendar_days }

fn active_effort_days_of(i: PlanItem) -> Int { i.active_effort_days }

// EFFORT CANNOT EXCEED THE WINDOW IT OCCUPIES. This is the invariant that makes the second figure
// load-bearing rather than decorative - a row claiming more working days than calendar days is
// malformed, and the witness reds on it.
fn duration_is_coherent(i: PlanItem) -> Bool {
  i.active_effort_days > 0 && i.active_effort_days <= i.min_calendar_days
}

fn durations_are_coherent() -> Bool {
  fold(year_end_plan_items, init: true, f: fn(acc, i) { acc && duration_is_coherent(i: i) })
}

// Items where the two figures actually differ - the declared, countable frontier of the split.
fn items_with_effort_window_split() -> List<PlanItem> {
  filter(year_end_plan_items, i => i.active_effort_days < i.min_calendar_days)
}

// THE SPLITS AS IDENTITIES, NOT AS A COUNT (review 67328). A calendar window wider than its effort
// is a WAITING FACT, and each one has to name what it waits on -- otherwise the field is a place
// to park a padded estimate. The roster is what the witness identity-joins against the fold above,
// in both directions, so a new split cannot arrive silently and a rostered one cannot quietly stop
// being a split.
//
// WHY THIS IS A ROSTER AND NOT `== 4`, which is what it was until this change: a count taken from
// the same tree it checks is not an oracle (DESIGN section 5), and automating its update collapses
// it to measure() == measure(). I had already removed exactly this shape from the Q2 roster one
// review earlier, then wrote it again here and defended it in a comment - the rule was applied to
// the population I had just been told about and not to the one I introduced in the same file.
//
// THE FIRST CUT OF THIS ROSTER WAS WRONG AND THE JOIN CAUGHT IT IMMEDIATELY, which is the best
// argument for the join that this change could have produced. I authored four ids from
// plausibility rather than reading the tree - hw-first-host and node-local-cache-drive "obviously"
// wait on something - and both are false: neither declares a window wider than its effort. The two
// real members I had missed are the counsel items, whose own exit text says the window IS QUEUE
// LATENCY, NOT EFFORT. A count would have accepted my invented roster without comment, because
// four wrong ids count to four.
//
// What each split waits on, so the roster is readable without opening four rows:
//   m2-legal-issue-spot           - external counsel queue latency; 3 senior hours inside 14 days,
//                                   and the row says the census quote replaces the estimate
//   m2-contract-deviation-review  - the same, separately authorized: 3 senior hours inside 10 days
//   colo-turnup-rack-acceptance   - a facility's stated 28-day lead time (Netrality, 2026-09-14)
//   residence-migration-rehearsal - the move must happen while a consumer is under load
//   use-case-scouting             - 7 effort days inside 14, because scouting waits on incumbent
//                                   documentation and on replies from people we do not control
//   agent-workspace-dogfood       - 10 effort days inside 21, because the exit is a two-week
//                                   OBSERVATION and calendar time cannot be parallelized away
//   control-plane-siting          - 10 effort days inside 14, because the 2026-09-19 recut moved the
//                                   exit from naming to an EXECUTED relocation, and off-fleet
//                                   capacity procurement plus DNS and ingress propagation are
//                                   waiting the operator cannot compress
data effort_window_split_item_ids: List<NonEmptyStr> = [
  "m2-legal-issue-spot",
  "m2-contract-deviation-review",
  "colo-turnup-rack-acceptance",
  "residence-migration-rehearsal",
  "use-case-scouting",
  "agent-workspace-dogfood",
  "control-plane-siting",
]

fn id_is_in(ids: List<NonEmptyStr>, id: NonEmptyStr) -> Bool {
  count(filter(ids, x => x == id)) == 1
}

// Both directions of the join. Neither alone is the claim: the first admits a new unrostered split,
// the second admits a rostered row that no longer splits.
fn every_split_is_rostered() -> Bool {
  all(items_with_effort_window_split(), i => id_is_in(ids: effort_window_split_item_ids, id: i.id))
}

fn every_rostered_split_still_splits() -> Bool {
  all(effort_window_split_item_ids, id =>
    fold(find_item(id: id), init: false, f: fn(acc, i) {
      acc || i.active_effort_days < i.min_calendar_days
    }))
}

// ---------------------------------------------------------------------------------------------
// THE PATH ROLLUP, AND WHAT IT REPLACES
// ---------------------------------------------------------------------------------------------
// WHAT WAS HERE: latest_start_day(i) = anchor(i.milestone) - i.min_calendar_days. Per item, and
// it never read depends_on. So the schedule check could see that an ITEM had started too late
// and could never see that a CHAIN could not fit: eleven items with individual slack, whose
// serial sum exceeds the window between now and the anchor, each reported comfortable. That is
// why nobody saw the M2 problem - the check that existed to catch it could not express it.
//
// MEASURED BEFORE REPLACING, because the claim deserved a number rather than an argument: under
// the old derivation on_track_at_day was GREEN at day 12 and RED at day 33. So it was not
// vacuous in the sense of never going red - it goes red the moment an anchor passes with items
// outstanding. What it could not do is go red IN ADVANCE, which is the only kind of schedule
// warning worth having. Being told on the anchor date that the anchor is missed is not a check.
//
// THE REPLACEMENT is a backward pass: an item's latest start is the earliest of its own anchor
// deadline and every constraint its successors impose, with the constraint READ FROM THE EDGE
// KIND rather than assumed. It is a single pass because the plan already guarantees the order it
// needs - dep_rank_ok makes every dependency's rank strictly smaller, so visiting items in
// DESCENDING rank visits every successor before its predecessor. That invariant is load-bearing
// here rather than decorative, which is why the rollup REFUSES rather than answering if it ever
// fails to hold.
// TWO DIFFERENT THINGS USED TO SHARE ONE CONSTANT AND THAT WAS THE DEFECT (repaired 2026-09-11
// after review). This number is the IDENTITY OF A MINIMUM FOLD - the value "no successor
// constrains this item", which is a legitimate answer meaning the item is bounded only by its own
// anchor. It was ALSO returned for "this bound could not be resolved", and a latest-start figure
// of 100000 reads as abundant slack: the most reassuring possible answer produced by the arm that
// means WE COULD NOT COMPUTE THIS. That is the absorbing fallback - it destroyed the signal that a
// successor was unresolved, and made the schedule look healthier the more broken its input was.
//
// The identity stays, because a minimum fold needs one. The refusal no longer collapses into it:
// it is carried to the caller as a typed value, and a consumer must handle it to get a number.
data unbounded_by_successors: Int = 100000

type StartBound
  = StartResolved { id: NonEmptyStr, latest_start: Int }
  | StartRefusedUnresolvedSuccessor { id: NonEmptyStr, successor: NonEmptyStr }

fn start_bound_is_resolved(b: StartBound) -> Bool {
  match b {
    StartResolved { id, latest_start } => true,
    StartRefusedUnresolvedSuccessor { id, successor } => false,
  }
}

fn start_bound_id(b: StartBound) -> NonEmptyStr {
  match b {
    StartResolved { id, latest_start } => id,
    StartRefusedUnresolvedSuccessor { id, successor } => id,
  }
}

fn start_bound_day(b: StartBound) -> Int {
  match b {
    StartResolved { id, latest_start } => latest_start,
    StartRefusedUnresolvedSuccessor { id, successor } => unbounded_by_successors,
  }
}

// THREE OUTCOMES, NOT ONE NUMBER. Absent means the backward pass has not placed this item yet,
// which during the fold is how an out-of-order rank is detected; Refused means it was placed and
// could not be computed. Both used to arrive as a large Int indistinguishable from real slack.
type BoundLookup
  = BoundFound { day: Int }
  | BoundRefused { item: NonEmptyStr }
  | BoundAbsent { item: NonEmptyStr }

fn lookup_bound(acc: List<StartBound>, id: NonEmptyStr) -> BoundLookup {
  fold(acc, init: BoundAbsent { item: id }, f: fn(best, b) {
    if start_bound_id(b: b) == id {
      if start_bound_is_resolved(b: b) {
        BoundFound { day: start_bound_day(b: b) }
      } else {
        BoundRefused { item: id }
      }
    } else {
      best
    }
  })
}

fn bound_is_found(l: BoundLookup) -> Bool {
  match l {
    BoundFound { day } => true,
    BoundRefused { item } => false,
    BoundAbsent { item } => false,
  }
}

// USED ONLY WHERE THE CALLER HAS ALREADY ESTABLISHED THE BOUND IS FOUND. The unresolved arms
// return the fold identity because a minimum fold must return something, and every caller is
// guarded by bound_is_found - the refusal is handled before the arithmetic, not inside it.
fn bound_day_or_identity(l: BoundLookup) -> Int {
  match l {
    BoundFound { day } => day,
    BoundRefused { item } => unbounded_by_successors,
    BoundAbsent { item } => unbounded_by_successors,
  }
}

// THE ITEM'S OWN CEILING. The elapsed window is what occupies calendar, so it is the figure the
// schedule subtracts; active effort is a different question and is not this arithmetic.
fn own_deadline_start(i: PlanItem) -> Int {
  milestone_anchor_day(m: i.milestone) - elapsed_window_days(i: i)
}

// What one edge from PREDECESSOR p into SUCCESSOR s requires of p's latest start, given s's.
// A conditional edge returns no constraint: the work behind it may never be bought, so folding
// it into the unconditional schedule would describe a world nobody is committed to. It is
// reported separately instead.
fn edge_start_bound(e: PlanEdge, successor_start: Int, p_elapsed: Int) -> Int {
  match e {
    CompletionRequires { of, why } => successor_start - p_elapsed,
    StartRequires { of, why } => successor_start,
    StartAfterStart { of, lag_days, consumed_artifact, why } => successor_start - lag_days,
    ConditionalRequires { of, condition, why } => unbounded_by_successors,
    ObservationWindow { of, window_days, why } => successor_start - window_days - p_elapsed,
  }
}

// Every constraint imposed on item p by the edges of one successor s.
fn successor_edges_bound(acc: List<StartBound>, p: PlanItem, s: PlanItem) -> Int {
  let s_start = bound_day_or_identity(l: lookup_bound(acc: acc, id: s.id))
  fold(s.depends_on, init: unbounded_by_successors, f: fn(best, e) {
    if edge_of(e: e) == p.id {
      let b = edge_start_bound(e: e, successor_start: s_start, p_elapsed: elapsed_window_days(i: p))
      if b < best { b } else { best }
    } else {
      best
    }
  })
}

fn successors_bound(acc: List<StartBound>, p: PlanItem, items: List<PlanItem>) -> Int {
  fold(items, init: unbounded_by_successors, f: fn(best, s) {
    let b = successor_edges_bound(acc: acc, p: p, s: s)
    if b < best { b } else { best }
  })
}

// A successor that has not been placed yet means the rank order did not hold, so this refuses
// rather than treating the missing bound as no constraint - a missing constraint would silently
// report a LATER safe start, which is the absorbing direction.
fn has_unplaced_successor(acc: List<StartBound>, p: PlanItem, items: List<PlanItem>) -> Bool {
  fold(items, init: false, f: fn(bad, s) {
    bad || fold(s.depends_on, init: false, f: fn(b2, e) {
      b2 || (edge_of(e: e) == p.id && bound_is_found(l: lookup_bound(acc: acc, id: s.id)) == false)
    })
  })
}

fn rollup_step(acc: List<StartBound>, p: PlanItem, items: List<PlanItem>) -> StartBound {
  if has_unplaced_successor(acc: acc, p: p, items: items) {
    StartRefusedUnresolvedSuccessor { id: p.id, successor: "a successor with a rank not greater than this item" }
  } else {
    let own = own_deadline_start(i: p)
    let succ = successors_bound(acc: acc, p: p, items: items)
    StartResolved { id: p.id, latest_start: if succ < own { succ } else { own } }
  }
}

fn by_rank_descending(items: List<PlanItem>) -> List<PlanItem> {
  sort_by(items, fn(i) { 0 - i.rank })
}

// THE FOLD IS PARAMETERIZED OVER THE ROSTER so a fixture can exercise THIS code rather than a
// copy of it. A schedule check whose discriminating red runs against a reimplementation proves
// the reimplementation.
fn start_bounds_over(items: List<PlanItem>) -> List<StartBound> {
  fold(by_rank_descending(items: items), init: [], f: fn(acc, p) {
    concat(acc, [rollup_step(acc: acc, p: p, items: items)])
  })
}

fn rollup_resolved_over(items: List<PlanItem>) -> Bool {
  fold(start_bounds_over(items: items), init: true, f: fn(acc, b) { acc && start_bound_is_resolved(b: b) })
}

// THE PUBLIC ANSWER IS TYPED, AND THAT IS THE WHOLE REPAIR. A consumer cannot get a day out of
// this without saying what it will do when there is no day: the refusal reaches the caller instead
// of being substituted with a number that reads as slack.
type LatestStart
  = LatestStartKnown { day: Int }
  | LatestStartUnresolved { item: NonEmptyStr, cause: NonEmptyStr }

fn latest_start_of(l: BoundLookup, i: PlanItem) -> LatestStart {
  match l {
    BoundFound { day } => LatestStartKnown { day: day },
    BoundRefused { item } => LatestStartUnresolved {
      item: i.id,
      cause: "the backward pass refused this item: one of its successors could not be placed before it, so the rank ordering the single-pass rollup relies on does not hold here",
    },
    BoundAbsent { item } => LatestStartUnresolved {
      item: i.id,
      cause: "this item is not in the roster the schedule was computed over",
    },
  }
}

fn latest_start_over(items: List<PlanItem>, i: PlanItem) -> LatestStart {
  latest_start_of(l: lookup_bound(acc: start_bounds_over(items: items), id: i.id), i: i)
}

fn latest_start_is_known(l: LatestStart) -> Bool {
  match l {
    LatestStartKnown { day } => true,
    LatestStartUnresolved { item, cause } => false,
  }
}

// A DAY FOR ORDERING AND NOTHING ELSE. Sorting needs a total key, and an unresolved item sorts
// FIRST because it is the most urgent thing on the page - not last, where it would look settled.
// This is deliberately not usable as a schedule figure: it is only ever passed to a sort.
fn latest_start_sort_key(l: LatestStart) -> Int {
  match l {
    LatestStartKnown { day } => day,
    LatestStartUnresolved { item, cause } => 0 - unbounded_by_successors,
  }
}

// THE ONLY TWO WAYS TO GET A NUMBER OUT, and both make the caller say what unresolved means for
// it. start_is_at_or_after answers the scheduling question directly and answers FALSE when the
// start is unresolved - an item whose latest start could not be computed has not been shown to be
// safe, and treating it as safe is the widening this repair exists to remove.
fn start_is_at_or_after(l: LatestStart, day: Int) -> Bool {
  match l {
    LatestStartKnown { day: d } => d >= day,
    LatestStartUnresolved { item, cause } => false,
  }
}

fn start_day_or(l: LatestStart, fallback: Int) -> Int {
  match l {
    LatestStartKnown { day } => day,
    LatestStartUnresolved { item, cause } => fallback,
  }
}

fn latest_start_label(l: LatestStart) -> NonEmptyStr {
  match l {
    LatestStartKnown { day } => "known",
    LatestStartUnresolved { item, cause } => "REFUSED: the schedule could not place this item",
  }
}

// An item may not start after today and still make its anchor: the rollup says the latest day it
// could have started, so a latest start already behind today is a chain that cannot fit.
fn roster_on_track_at_day(items: List<PlanItem>, today_day: Int) -> Bool {
  fold(items, init: true, f: fn(acc, i) {
    acc && (item_is_done(i: i) || start_is_at_or_after(l: latest_start_over(items: items, i: i), day: today_day))
  })
}

// COMPUTED ONCE, NOT PER LOOKUP. The backward pass is O(items x items x edges); every consumer
// that sorts by latest start calls it once per row, so a function here would multiply that by the
// roster size for no answer that differs. It is a data declaration so the value is the fact and
// the traversal happens once - the cost-shape rule applies to a plan model exactly as it does to
// a compiler fold, and "the roster is only ninety rows" is not a time-stable fact.
data start_bounds_table: List<StartBound> = start_bounds_over(items: year_end_plan_items)

fn rollup_is_resolved() -> Bool {
  fold(start_bounds_table, init: true, f: fn(acc, b) { acc && start_bound_is_resolved(b: b) })
}

// THE PUBLIC ANSWER, unchanged in name and consumed by the tracker page and procurement exactly
// as before - what changed is that it now answers over the graph instead of over one row.
fn latest_start(i: PlanItem) -> LatestStart {
  latest_start_of(l: lookup_bound(acc: start_bounds_table, id: i.id), i: i)
}

// ---------------------------------------------------------------------------------------------
// THE SCHEDULE STANDING: A CHECK WITH PREDICTIVE CONTENT
// ---------------------------------------------------------------------------------------------
// The old pair could report an item late (its anchor passed) or at risk (its own latest start
// passed). Neither could report a CHAIN that cannot fit, because neither read the graph. This
// arm does, and it is the one that can go red BEFORE the deadline rather than on it.
type ScheduleStanding
  = ScheduleFits { slack_days: Int }
  | ScheduleCannotFit { first_item: NonEmptyStr, latest_start: Int, days_behind: Int }
  | ScheduleRefusedRollupUnresolved { note: NonEmptyStr }

fn behind_items_at_day(items: List<PlanItem>, today_day: Int) -> List<PlanItem> {
  filter(items, i => item_is_done(i: i) == false && start_is_at_or_after(l: latest_start_over(items: items, i: i), day: today_day) == false)
}

// AN UNRESOLVED ITEM CONTRIBUTES NO NUMBER HERE. It is already counted as behind, and the
// standing above refuses outright when any item is unresolved, so this fold never has to invent a
// day for one - it skips it rather than folding a sentinel into a minimum.
fn worst_latest_start(items: List<PlanItem>, today_day: Int) -> Int {
  fold(behind_items_at_day(items: items, today_day: today_day), init: today_day, f: fn(worst, i) {
    let l = latest_start_over(items: items, i: i)
    if latest_start_is_known(l: l) == false { worst }
    else if start_day_or(l: l, fallback: worst) < worst { start_day_or(l: l, fallback: worst) } else { worst }
  })
}

// The sentinel is declared rather than written inline: a bare literal in a fold initial resolves
// as String while the values it may carry are NonEmptyStr, and the two branches then disagree.
data no_behind_item: NonEmptyStr = "none"

fn worst_behind_id(items: List<PlanItem>, today_day: Int) -> NonEmptyStr {
  let w = worst_latest_start(items: items, today_day: today_day)
  fold(behind_items_at_day(items: items, today_day: today_day), init: no_behind_item, f: fn(acc, i) {
    if acc == no_behind_item && start_day_or(l: latest_start_over(items: items, i: i), fallback: w + 1) == w { i.id } else { acc }
  })
}

fn slack_at_day(items: List<PlanItem>, today_day: Int) -> Int {
  fold(items, init: 100000, f: fn(best, i) {
    if item_is_done(i: i) { best } else {
      let l = latest_start_over(items: items, i: i)
      if latest_start_is_known(l: l) == false { best } else {
        let d = start_day_or(l: l, fallback: best) - today_day
        if d < best { d } else { best }
      }
    }
  })
}

fn roster_schedule_standing(items: List<PlanItem>, today_day: Int) -> ScheduleStanding {
  if rollup_resolved_over(items: items) == false {
    ScheduleRefusedRollupUnresolved {
      note: "The backward pass could not place an item before one of its successors, which means the rank ordering it relies on does not hold. It refuses rather than answering, because a missing constraint would report a LATER safe start than the truth.",
    }
  } else if roster_on_track_at_day(items: items, today_day: today_day) {
    ScheduleFits { slack_days: slack_at_day(items: items, today_day: today_day) }
  } else {
    ScheduleCannotFit {
      first_item: worst_behind_id(items: items, today_day: today_day),
      latest_start: worst_latest_start(items: items, today_day: today_day),
      days_behind: today_day - worst_latest_start(items: items, today_day: today_day),
    }
  }
}

fn schedule_standing_at_day(today_day: Int) -> ScheduleStanding {
  roster_schedule_standing(items: year_end_plan_items, today_day: today_day)
}

// THE CONDITIONAL READING, WHICH WAS CLAIMED AND NOT COMPUTED (repaired 2026-09-11 after review).
// The ConditionalRequires row says the conditional reading "is computed and reported separately",
// and it was not: nothing anywhere evaluated the branch-taken schedule. A sentence describing a
// computation that does not exist is specification-without-execution, and it was mine.
//
// Here it is. Same fold, same rows; the only difference is that a conditional edge binds. Read it
// when the branch is expected to be taken - a negotiating counterparty takes it by definition.
fn edge_binds_conditionally(e: PlanEdge) -> PlanEdge {
  match e {
    ConditionalRequires { of, condition, why } => CompletionRequires { of: of, why: why },
    CompletionRequires { of, why } => e,
    StartRequires { of, why } => e,
    StartAfterStart { of, lag_days, consumed_artifact, why } => e,
    ObservationWindow { of, window_days, why } => e,
  }
}

fn item_with_conditional_edges_bound(i: PlanItem) -> PlanItem {
  PlanItem {
    id: i.id,
    workstream: i.workstream,
    milestone: i.milestone,
    rank: i.rank,
    min_calendar_days: i.min_calendar_days,
    active_effort_days: i.active_effort_days,
    execution_mode: i.execution_mode,
    exit_criterion: i.exit_criterion,
    depends_on: map(i.depends_on, e => edge_binds_conditionally(e: e)),
    relates_to: i.relates_to,
    item_relations: i.item_relations,
    status: i.status,
  }
}

fn conditional_roster() -> List<PlanItem> {
  map(year_end_plan_items, i => item_with_conditional_edges_bound(i: i))
}

fn conditional_standing_at_day(today_day: Int) -> ScheduleStanding {
  roster_schedule_standing(items: conditional_roster(), today_day: today_day)
}

fn standing_fits(st: ScheduleStanding) -> Bool {
  match st {
    ScheduleFits { slack_days } => true,
    ScheduleCannotFit { first_item, latest_start, days_behind } => false,
    ScheduleRefusedRollupUnresolved { note } => false,
  }
}

fn standing_is_refusal(st: ScheduleStanding) -> Bool {
  match st {
    ScheduleFits { slack_days } => false,
    ScheduleCannotFit { first_item, latest_start, days_behind } => false,
    ScheduleRefusedRollupUnresolved { note } => true,
  }
}

// THE CORPUS READS RED TODAY, AND THAT IS DECLARED HERE RATHER THAN DISCOVERED IN A WITNESS.
// Under the strict completion-requires reading the whole M2 chain needed to start THIRTY-NINE
// DAYS BEFORE THE PLAN EPOCH: eleven items summing to more calendar than exists between the
// epoch and the anchor. The witness asserts this row rather than asserting green, so the check
// is honest about a plan that does not fit instead of reporting a schedule nobody can run.
//
// WHEN THIS STOPS BEING TRUE THE WITNESS GOES RED, AND THAT IS THE INTENDED BEHAVIOUR RATHER
// THAN A DEFECT: whoever makes M2 fit updates this row in the same change, and the conjunct name
// says so. A green that survives the problem being fixed would be a check measuring nothing.
data m2_chain_overruns_its_anchor: Bool = true

// WHAT THE CARRIER ACTUALLY ENFORCED BEFORE THIS CHANGE, because the number everyone has been
// quoting needs its standing said out loud. The untyped depends_on was never a SCHEDULING
// constraint at all: the only thing derived from it was done_implies_deps_done, a completion-order
// check. Summing the M2 chain's declared durations as though every edge were finish-to-start
// produces 104 days, and that figure is a COUNTEREXAMPLE THE CARRIER PERMITS - it shows what the
// edges would mean if they were scheduling constraints - rather than a schedule the plan ever
// computed. Quoting it as "the schedule" attributes to the plan an arithmetic the plan did not do.
// The rollup below is the first thing that makes those edges scheduling-relevant, which is why
// its numbers and that one are not the same kind of claim.
data m2_chain_overrun_note: NonEmptyStr = "DECLARED 2026-09-10. schedule_standing_at_day reports ScheduleCannotFit for the plan as it stands, at the epoch and at every day since. The cause is not any single item's duration: it is that the M2 admission chain is declared as eleven complete-before-start links, and that reading is a COUNTEREXAMPLE the carrier permits rather than a schedule anyone chose - the untyped depends_on could express nothing else. Retire this row by making the chain fit - reclassify edges on evidence, shorten the work, or move the anchor - and update it in the same change that does, because the witness conjunct named corpus_schedule_reads_behind_today will red the moment it is false."

fn item_late_at_day(i: PlanItem, today_day: Int) -> Bool {
  milestone_anchor_day(m: i.milestone) < today_day && !item_is_done(i: i)
}

fn item_at_risk_at_day(i: PlanItem, today_day: Int) -> Bool {
  !item_late_at_day(i: i, today_day: today_day)
    && start_is_at_or_after(l: latest_start(i: i), day: today_day) == false
    && !item_is_done(i: i)
}

fn items_late_at_day(today_day: Int) -> List<PlanItem> {
  filter(year_end_plan_items, i => item_late_at_day(i: i, today_day: today_day))
}

fn items_at_risk_at_day(today_day: Int) -> List<PlanItem> {
  filter(year_end_plan_items, i => item_at_risk_at_day(i: i, today_day: today_day))
}

fn on_track_at_day(today_day: Int) -> Bool {
  count(items_late_at_day(today_day: today_day)) == 0 && count(items_at_risk_at_day(today_day: today_day)) == 0
}

data requirement_coalescence_note: NonEmptyStr = "COALESCENCE MAP - where every standing requirement family lives, so this plan is the ONE staging surface: the compliance register's DesignConstraintNow rows land through m2-applicability-model, m2-control-bindings, customer-authorizations, soc2-baseline and tax-insurance-scope; the external review's before-first-customer list lands through tenant-boundary-minimum, fabric-m0's durable-commit gate, boot-minimum, machine-identity-secrets-lifecycle, the m2-launch-intent through m2-compliance-admission chain, whose centre is the provider-route permit, and support-abuse; its before-S1 list lands through s0-receipts, machine-health-model, tenant-shared-fleet-suite, storage-recovery-rewarm-drill, package-upstream-admission, spares-control-plane-readiness and the s1-gate conjunction - colo-rfq WAS a member of that conjunction and was removed 2026-09-17 with the Q2 recut, so the gate roster s1_gate_required_deps and this sentence agree rather than forking (review 67307); the storage M0-M3 sequence enters as fabric-m0 with M1+ stages deliberately post-gate; the acquisition authority's outbound-scale preconditions bind acquisition-instrumented; the fragility/lot analysis lands through lot-decision (immediate execution); the product surface lands through customer-portal (cut scope), docs-dry-run, paid-minimum, billing-ux and support-abuse; and the SOFTWARE DELIVERY MAP's five programs (docs/plans/software-delivery-map.md, 2026-09-19) land through six items added that day, THREE OF THEM FAMILIES THIS MAP HAD NEVER NAMED - persistent control-plane state through control-plane-state-store, the authenticated execution-lifecycle ingress through webhook-ingress-durable-record, customer identity and access through customer-identity-access, production release and deployment through production-release-identity, durable mutable workspace storage through durable-workspace-volume, and the website/customer journey through customer-journey-acceptance beside the product-surface items already named. THAT CLAUSE WAS ADDED WITH THOSE ITEMS AND NOT AFTER THEM ONLY ON THE SECOND ATTEMPT (review 68230): the change that introduced the six rows CITED this note as its authority for carrying them as items rather than a side list, and left this roster unextended - so the note went on describing a plan with three fewer requirement families than the file it lives in, which is the fork it exists to prevent, committed by the row that invoked it. A requirement discovered later is added HERE as an item with a milestone, or explicitly recorded as post-gate - never tracked in a side list."

// THE Q2 COLO RECUT (operator ruling 2026-09-17). The operator ruled that there is NO COLOCATION
// DEPLOYMENT AT YEAR END: the colo deployment targets Q2 2027, and the year-end shape is roughly
// FIVE MACHINES OR FEWER SERVING TWO TO THREE CUSTOMERS FROM THE RESIDENCE. Two further operator
// sentences bound it: the Philadelphia site visit will not happen, and colo is not to be chased.
//
// THIS RESOLVES A FORK THE PLAN ALREADY CARRIED rather than introducing a new one. siting-decision
// was declared on 2026-08-29 as "serve from colo, or soft-launch from the residence with colo as
// the scaling path", and this ruling takes the second arm. So the recut is the plan's own
// vocabulary being answered, not a structure bolted on: the residence path already has its items
// (home-soft-launch-readiness, wholesale-apartment-journey-acceptance, and the direct-customer
// spine at M1/M2b), and what moves is the RACK.
//
// WHY A MILESTONE RATHER THAN A STATUS. Moving eight items to DeclaredBehind would say the work is
// late; it is not late, it is LATER BY DECISION, and those are different facts with different
// consequences (a behind item ranks for rescue, a re-anchored one does not). M5Q2ColoDeployment
// carries the new anchor so the schedule engine prices the rack chain against 2027-06-30 instead
// of reporting a 48-day overrun nobody intends to close.
//
// THE ANCHOR IS THE END OF Q2, NOT ITS START. "Target Q2" bounds the deployment to the quarter and
// names no date inside it; 2027-06-30 is the latest reading the words support, and inventing
// 2027-04-01 would manufacture a commitment the operator did not make. Tighten it when a facility
// quote carries a real occupancy date.
//
// THE RECUT IS NINETEEN ITEMS, NOT EIGHT, AND THE CORPUS IS WHAT ESTABLISHED THAT. The intent was
// to move the eight rack rows and leave the wholesale tail where it was, with its rack dependency
// visible for a later ruling. plan_graph_sound refused: dep_milestone_order_ok requires every
// dependency to sit at or before its dependent's milestone, so eleven more wholesale items -- the
// whole production programme from pilot acceptance through billing settlement, compliance,
// security, SLO, observability, fault actuation, repair readmission and hardware serviceability --
// could not keep a January anchor over a June dependency. They follow the rack.
//
// THAT IS THE RULING'S REAL COST, AND IT IS STATED HERE RATHER THAN DISCOVERED LATER: there is no
// wholesale PRODUCTION capacity at year end. What remains on the residence path is
// wholesale-apartment-journey-acceptance -- one node, one buyer, every step receipted on the
// apartment overlay -- together with the direct-customer spine at M1 and M2b, which is what the
// two-to-three customer target is served by.
//
// ANY OF THE ELEVEN CAN COME BACK, and bringing one back is a real decision rather than an edit:
// it means cutting that item's dependency on the rack and asserting the apartment can carry it.
// That is a commercial and technical judgement about what a wholesale buyer accepts from a
// residence, and this ruling does not make it.
data q2_colo_recut_ruling: NonEmptyStr = "OPERATOR RULING 2026-09-17: no colocation deployment at year end; colo targets Q2 2027 (anchored at 2027-06-30, the end of the quarter). Year-end target is approximately five machines or fewer serving two to three customers from the residence. The Philadelphia site visit is declined and the colo field is not to be chased; strategy.owner_action freezes the chase steps and strategy.wholesale_batch_floor keeps the RFQ responses that arrive unbidden."

// The NINETEEN items the ruling re-anchors, as identities rather than as a count -- a count would
// still pass if one row were swapped for another. The witness asserts every id here resolves and
// carries M5Q2ColoDeployment, so silently re-anchoring a twentieth item, or quietly returning one
// of these to the year-end gate, reds rather than passing. (Both sentences said EIGHT until
// review 67315: eight was the intended recut, nineteen is what dep_milestone_order_ok forced, and
// the paragraph twenty lines above had been corrected while its own roster annotation was not --
// the same declaration-versus-annotation fork this change congratulates itself for closing on the
// gate roster.)
data q2_recut_item_ids: List<NonEmptyStr> = [
  "colo-rfq", "colo-shortlist", "colo-vendor-selection", "colo-contract-execution",
  "colo-turnup-rack-acceptance", "first-rack-capital-admission",
  "wholesale-colo-journey-acceptance", "wholesale-capacity-ready",
  "wholesale-pilot-acceptance", "wholesale-repair-interval-admission", "wholesale-production-contract-execution",
  "wholesale-production-readiness", "wholesale-capacity-billing-settlement",
  "wholesale-compliance-admission", "wholesale-security-admission",
  "wholesale-support-slo", "wholesale-health-observability",
  "wholesale-fault-actuation", "wholesale-repair-readmission",
  "wholesale-hardware-serviceability",
]

fn item_is_q2_recut(i: PlanItem) -> Bool {
  count(filter(q2_recut_item_ids, id => id == i.id)) == 1
}

fn q2_recut_items_are_anchored_at_q2() -> Bool {
  fold(q2_recut_item_ids, init: true, f: fn(acc, id) {
    acc && fold(find_item(id: id), init: false, f: fn(a2, i) {
      a2 || milestone_order(m: i.milestone) == milestone_order(m: M5Q2ColoDeployment)
    })
  })
}

fn q2_recut_count() -> Int { count(filter(year_end_plan_items, i => item_is_q2_recut(i: i))) }

data plan_scaling_note: NonEmptyStr = "Why the M3 items exist at demo scale (operator 2026-08-29): the business can scale exponentially for a stretch, so every lever must carry EXECUTABLE TERMS before it is needed - the PreparedLever grain (quoted price, quote expiry, activation lead days, admitted capacity, prerequisites, deposit, cancellation terms, supplier), and for software/security levers an executed drill in place of a price. Price alone is not sufficient. The demo is deliberately small; the levers are deliberately not - and by each anchor the plan establishes the smallest executed fact that safely authorizes the next irreversible step."
