data item_tenant_boundary_minimum: PlanItem = PlanItem {
  id: "tenant-boundary-minimum",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 20,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: OperatorExclusive,
  exit_criterion: "The constrained first tenancy topology - customer-dedicated host/pool, one clean microVM per job, no host credentials in the guest, no cross-customer peer cache, customer-scoped CAS identity, untrusted-PR action-cache writes disabled or trust-classed unreadable by trusted workflows, outbound 25 blocked, per-customer egress and flow receipts. Removes cross-customer co-residency from the demo; the shared-fleet adversarial suite is a separate pre-S1 item.",
  depends_on: [dep(id: "runner-canary"), dep(id: "fabric-m0")],
