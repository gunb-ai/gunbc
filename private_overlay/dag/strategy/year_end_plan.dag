data item_wholesale_production_contract_execution: PlanItem = PlanItem {
  id: "wholesale-production-contract-execution",
  workstream: AcquisitionMarketing,
  milestone: M5Q2ColoDeployment,
  rank: 88,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: ExternalLead,
  exit_criterion: "A signed MSA and order form: the selected boundary; the exact node specification (wholesale_batch_floor standard_node_inclusions with every conditional resolved); the capacity envelope as wholesale_batch_floor fabric_capacity_contract carries it AT SIGNING - guaranteed units, burst ceiling, recovery window and interruption semantics - derived from the slot shape and pool size THEN IN FORCE (slot_shape and failover_pool_sizing; Codex review, PR #136: an earlier cut hard-coded the illustrative sixteen dedicated, four pooled and four units per slot into this criterion, which would have either blocked a correctly negotiated contract or signed provisional figures as final). Where those standings are still PlanningFigure arms at signing, the contract names the measured basis it will be trued up against rather than presenting the figure as measured. fleet_decisions allocation-model governs either way: logical placement, never a serial number in the contract, sold units never oversubscribed; deployment ramp; price, term and renewal; acceptance and billing start; maintenance windows; the support/SLO disposition and any service-credit remedy; liability, indemnity and insurance; custom-hardware ownership and amortisation; early termination and unpaid hardware balance; security schedule and DPA where applicable; incident and data-handling allocation; expansion reservation terms; first payment or deposit received. wholesale-supply-channel carries the offer; this signs it. REVIEW REPAIR 2026-09-14 (P1): the exact node specification and the security schedule this signs are produced by wholesale-bom-capacity-freeze and wholesale-security-admission, so both are dependencies - a binding order form cannot be signed before the BOM it specifies is frozen or the security realization it promises is admitted. A capacity RESERVATION signed earlier is a different, narrower instrument that names no exact node specification and no production security commitment, and is not this item.",
  depends_on: [dep(id: "wholesale-pilot-acceptance"), dep(id: "wholesale-support-slo"), dep(id: "wholesale-compliance-admission"), dep(id: "tax-insurance-scope"), dep(id: "wholesale-bom-capacity-freeze"), dep(id: "wholesale-security-admission")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.b2b_capacity_track"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_capacity_billing_settlement: PlanItem = PlanItem {
  id: "wholesale-capacity-billing-settlement",
  workstream: EconomicsQa,
  milestone: M5Q2ColoDeployment,
  rank: 95,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: AgentParallel,
  exit_criterion: "The billing transaction rehearsed IN THE UNIT THE BOUNDARY SELLS (Codex review, PR #136: an earlier cut settled an accepted node-day/node-month roster with spare substitutions, which under ManagedFabricCapacity invoices the physical implementation the contract explicitly withholds - after a placement moves there is no stable customer node roster to bill). Under raw bare metal, where the buyer does hold named machines, the node-day/node-month roster from acceptance timestamps with proration and spare-substitution treatment is still the right transaction and is rehearsed as such. Under a managed substrate or managed fabric capacity: guaranteed unit-time against the envelope's floor, burst unit-time above it, and envelope credits where the floor, the recovery window or the performance envelope was missed - none of it keyed to a host identity. Both arms then share: deposit accounting; custom-hardware amortisation; tax provenance; invoice issuance; payment settlement; one credit/refund/adjustment rehearsal - through the entity ledger (finance.gunbai_ledger), not a side spreadsheet.",
  depends_on: [dep(id: "wholesale-production-contract-execution"), dep(id: "wholesale-production-readiness")],
  relates_to: ["finance.gunbai_ledger", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// ---- the journeys (operator direction 2026-09-14): security, networking and fabric as end-to-end
// acceptance, on a colo cabinet and on the apartment overlay, for raw metal and managed substrate.
// strategy.wholesale_journeys names the steps and their owners; these three close its gaps. ----

data item_wholesale_buyer_network_handoff: PlanItem = PlanItem {
  id: "wholesale-buyer-network-handoff",
  workstream: SecurityCompliance,
  milestone: M3YearEndGate,
  rank: 47,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: AgentParallel,
  exit_criterion: "THE EXPOSED INTERFACE, SPECIFIED PER SITE AND PER BOUNDARY, AND THE BUYER ZONE THAT MAKES ITS ISOLATION STATABLE. (1) A BuyerTenant zone landed in gunbc.product.network_topology with reachability BuyerTenant -> BuyerTenant only - never BmcManagement, HostLan or our ContainerRunner - which is a PUBLIC-REPO change; until it lands strategy.wholesale_journeys buyer_zone_exists_in_public_topology stays false. (2) The colo handoff: L2 VLAN or L3 VRF on the rack switch, routed vs attached prefix, who configures the switch, MTU, the buyer's path to reinstall through the management broker. (3) The apartment handoff: WireGuard overlay terminated at the VPS, the buyer's prefix routed over it, NAT on residential egress, no A+B - the row that proves the design before a colo is signed. (4) The buyer egress path: policy, NAT or public-IP ownership, and how an abuse notice for a buyer flow reaches the buyer, written into the security responsibility matrix. Exercised: a buyer segment demonstrably cannot reach any BMC, our host LAN, or our runners, on the site variant in hand.",
  depends_on: [dep(id: "wholesale-service-boundary"), dep(id: "wholesale-network-decision"), dep(id: "wholesale-oob-management-realization")],
  relates_to: ["strategy.wholesale_journeys", "strategy.wholesale_batch_floor", "strategy.home_hosting"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_fabric_buyer_demand: PlanItem = PlanItem {
  id: "wholesale-fabric-buyer-demand",
  workstream: RunnerSoftware,
  milestone: M3YearEndGate,
  rank: 47,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "THE FABRIC SELECTS FOR THE BUYER'S WORK (managed substrate only; raw metal discharges this by declaration). gunbc.fabric_control_plane selects through product.fabric.selection, reserves by compare-and-set and grants; demand enters through fabric_quota and executor_class, and product.fabric.provider_admission seals permits for OUR routes. Exit: a wholesale buyer typed as a demand source with its own quota, executor class and sealed permit; a buyer-attributed Demand admitted; a cell reserved; an ExecutionGrant issued and metered to the buyer; a refusal when the buyer's quota is exhausted. No new selection vocabulary - the buyer is an arm of the existing carriers.",
  depends_on: [dep(id: "wholesale-service-boundary")],
  relates_to: ["strategy.wholesale_journeys", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// SPLIT 2026-09-14 (review repair, P1): one item said "apartment first, colo after turn-up" while
// depending on colo turn-up through an ordinary edge, which made the apartment journey impossible
// to run first. Two items: the apartment journey needs home readiness and the apartment handoff;
// the colo journey needs turn-up. Production readiness consumes the journey for the SELECTED
// production site (ConditionalRequires on each, bound by strategy.wholesale_journeys).
// REVIEW REPAIR 2026-09-14 (P1): wholesale-hardware-serviceability joins health observability, which
// depends on colo turn-up - so the apartment journey secretly waited on the colo. The apartment
// proves LOCAL detection, cull, spare activation, buyer identity movement and local readmission;
// the colo journey additionally proves the facility's remote-hands transaction.
data item_wholesale_local_fault_spare_activation: PlanItem = PlanItem {
  id: "wholesale-local-fault-spare-activation",
  workstream: OpsMachineHealth,
  milestone: M4JanuaryLaunch,
  rank: 74,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: AgentParallel,
  exit_criterion: "On the apartment overlay, without a facility: an injected uncorrectable-memory or fan event observed locally, the node culled and drained, the spare activated through the buyer integration with the buyer's node identity, certificate and scheduler enrollment moved, the faulty node repaired by the operator and readmitted through gunbc.machine_intake with a new FleetAdmissionReceipt. Remote hands, ticket SLAs and facility FRU procedures are the colo item's (wholesale-hardware-serviceability).",
  depends_on: [dep(id: "wholesale-provider-integration"), dep(id: "spares-control-plane-readiness")],
  relates_to: ["strategy.ci_operations", "strategy.wholesale_journeys"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_apartment_journey_acceptance: PlanItem = PlanItem {
  id: "wholesale-apartment-journey-acceptance",
  workstream: SecurityCompliance,
  milestone: M4JanuaryLaunch,
  rank: 82,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: AgentParallel,
  exit_criterion: "ONE NODE, ONE BUYER, EVERY STEP RECEIPTED IN ORDER, ON THE APARTMENT OVERLAY. The strategy.wholesale_journeys journey for the selected boundary executed end to end on the apartment site: cold boot from the staging host over the management VLAN; FleetAdmissionReceipt; buyer reaches the node over the specified overlay handoff and nothing else; BMC reachable by us through the gateway and by nobody else; (managed/hosted) the fabric selects and grants for a buyer-attributed demand and the SELECTED cache realization serves it with its arm's receipts, or (raw) the buyer reinstalls through the mediated path; a buyer egress flow observed on the buyer path; an injected fault culls the node, the spare activates and the buyer's identity moves; the buyer offboards and the node is erased and reset. Each step lands as an Accepted { receipt, buyer, node, journey_revision, observed_at } standing and the journey as an AcceptedJourney row keyed by buyer, boundary, site, node, contract revision, security-profile revision and journey revision; wholesale_journeys journey_accepted_for reads it exactly. This is the variant available before a colo is signed.",
  depends_on: [dep(id: "home-soft-launch-readiness"), dep(id: "wholesale-provider-integration"), dep(id: "wholesale-buyer-network-handoff"), dep(id: "wholesale-fabric-buyer-demand"), dep(id: "wholesale-oob-management-realization"), dep(id: "wholesale-network-decision"), dep(id: "wholesale-origin-boot-cache-realization"), dep(id: "wholesale-local-fault-spare-activation"), dep(id: "wholesale-offboarding-erasure")],
  relates_to: ["strategy.wholesale_journeys", "strategy.wholesale_batch_floor", "strategy.home_hosting"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_colo_journey_acceptance: PlanItem = PlanItem {
  id: "wholesale-colo-journey-acceptance",
  workstream: SecurityCompliance,
  milestone: M5Q2ColoDeployment,
  rank: 84,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: AgentParallel,
  exit_criterion: "THE SAME JOURNEY, EVERY STEP RECEIPTED IN ORDER, ON THE COLO CABINET AFTER TURN-UP: the specified VLAN or VRF handoff, the buyer segment demonstrably unable to reach any BMC, our host LAN or our runners on the rack switch, and the rest as wholesale-apartment-journey-acceptance. Lands as an AcceptedJourney row keyed to the colo site. Required for production readiness when the selected production site is the colo cabinet.",
  depends_on: [dep(id: "colo-turnup-rack-acceptance"), dep(id: "wholesale-provider-integration"), dep(id: "wholesale-buyer-network-handoff"), dep(id: "wholesale-fabric-buyer-demand"), dep(id: "wholesale-oob-management-realization"), dep(id: "wholesale-network-decision"), dep(id: "wholesale-origin-boot-cache-realization"), dep(id: "wholesale-hardware-serviceability"), dep(id: "wholesale-offboarding-erasure")],
  relates_to: ["strategy.wholesale_journeys", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// ---------------------------------------------------------------------------------------------
// THE SOFTWARE PROGRAM ITEMS (added 2026-09-19). The plan carried software in roughly fifteen
// items and still did not expose a dependency-complete software program: several exits establish a
// DESIGN rather than an operating service, and whole programs -- customer identity, the persistent
// control plane, the webhook ingress, production release -- had no item at all. The evidence for
// each row is docs/plans/software-delivery-map.md, which classifies every capability against the
// public corpus by MODULE and SYMBOL and names the consumer and executing route for anything it
// calls integrated.
//
// THESE ARE ITEMS AND NOT A SIDE LIST, which requirement_coalescence_note requires: a requirement
// the plan cannot see cannot be late, and every one of these was live in the prose of some other
// item's exit criterion while nothing scheduled it.
//
// THE FINDING THAT ORDERS THEM. gunbc.runner.runner_first_job_receipt records a real GitHub Actions
// job completing in a microVM on the Mt. Collins host, and the same module records that it ran a
// HAND-BUILT image -- runner_artifact_model_disagreement, where the modelled row named 2.336.0 and
// 2.337.0 ran, found by a human reading a job log. Reading the import graph the same way generalises
// it: gunbc.runner_jit_mint is imported only by gunbc.runner.runner_jit_perform, imported only by
// gunbc.runner.runner_bound_attempt_receipt, which NOTHING imports; gunbc.runner.runner_usage_receipt
// is imported by gunbc.runner.runner_teardown_receipt whose own only importer is a witness test; and
// the fabric-M0 commit cluster is reached only by witness tests and instrument probes. THE CHAINS ARE
// ROOTED IN WITNESS TESTS RATHER THAN IN A JOB -- which is a weaker claim than the one this comment
// carried until 2026-09-19, when it said four of those modules had NO IMPORTER ANYWHERE. That was
// produced by grepping module paths that do not exist: dag/gunbc/runner/ declares modules BOTH as
// gunbc.runner_* and as gunbc.runner.runner_*, so the directory does not determine the name, and
// gunbc.runner_lifecycle in particular is DEPLOYED, reached from gunbc.host_effect_realize through
// gunbc.fleet.fleet_converge_apply to the gunbc.fleet.fleet_converge_cli entry point. THE INSTRUMENT
// IS NAMED AND ITS OUTPUT IS NOT TRANSCRIBED (DESIGN section 6): the subject is the IMPORTER SET of
// gunbc.runner_lifecycle in the public corpus, re-derived by grepping that declared name. An earlier
// revision of this comment carried a COUNT of that set, which is the same duty cycle that made the
// sentence it replaced wrong -- a right number rots exactly as a wrong one does. So the
// vertical that was demonstrated and the vertical that is modelled are two different programs, and
// the difference is what these items schedule.

// THE STORE IS NAMED BEFORE IT IS CHOSEN. The exit is not "stand up a database" -- it is the
// enumeration plus one authoritative carrier and one recovery path per fact, because the failure
// this closes is that three of the four things the business bills by have a carrier with no
// recovery and the fourth has neither.
data item_control_plane_state_store: PlanItem = PlanItem {
  id: "control-plane-state-store",
  workstream: RunnerSoftware,
  milestone: M1InternalVertical,
  rank: 15,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "THE PERSISTENT CONTROL-PLANE STATE UNIVERSE, ENUMERATED AND EACH FACT CARRIED. One module lists every durable control-plane fact -- tenant, job, delivery, lease, reservation, usage, balance, deployment state -- and for each names its AUTHORITATIVE CARRIER and its RECOVERY PATH, or declares it NotCarried, which is a countable frontier rather than a silence. TWO CARRIERS ARE ALREADY REAL AND ARE THE SUBJECT OF THE RECOVERY HALF: gunbc.fabric_allocation_store_substrate, whose own writer_standing declares its only live caller is tools.fabric_control_plane_live_probe under EUID 0 and names 'a non-root production reservation caller is modeled' as its re-derivation trigger; and gunbc.fabric_event_log, whose fabric_event_log_placement is a SINGLE WRITER on srv1 that by declaration refuses rather than failing over -- correct for a lease and, today, a control plane that does not survive the loss of one host. What this item OWES is that a reader of each fact can say what answers it and what happens when the host holding it is gone; a typed refusal is an admissible answer and silence is not. NOT owed: choosing a database, or migrating anything. Naming the universe is what makes the choice derivable instead of asserted.",
  depends_on: no_deps,
  relates_to: ["strategy.compute_fabric_model", "strategy.ci_operations"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// THE INGRESS IS A SUCCESSOR OF THE CANARY, NOT A PREDECESSOR. The canary proved a job can execute;
// this proves a job can ARRIVE without the operator at the keyboard, which is the difference between
// a demonstration and a service, and it is what dogfood-started's two-week clock actually requires.
data item_webhook_ingress_durable_record: PlanItem = PlanItem {
  id: "webhook-ingress-durable-record",
  workstream: RunnerSoftware,
  milestone: M1InternalVertical,
  rank: 25,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: AgentParallel,
  exit_criterion: "A WORKFLOW_JOB DELIVERY ARRIVES, IS AUTHENTICATED, IS RECORDED DURABLY, AND REACHES THE MODELLED MINT -- no operator at the keyboard. (1) AUTHENTICATED INGRESS: X-Hub-Signature-256 verified against the secret gunbc.fleet.app_control_plane_converge already converges (HookSecretConfigured); an unverified delivery is a typed located refusal and never a job. NOTHING IN THE CORPUS RECEIVES A WEBHOOK TODAY -- a search of dag/ for workflow_job, Hub-Signature and hmac finds the witness-floor CI workflow and the operator-approval broker, which are different subjects. (2) DURABLE RECORD KEYED ON THE DELIVERY GUID GitHub sends, so a DUPLICATE OR LATE DELIVERY IS A NO-OP BY CONSTRUCTION rather than by a check a later reader can remove, and the record survives a control-plane restart. (3) THE JOIN: the record reaches gunbc.runner_jit_mint JitMintAuthorized through an import AND a call site. That edge is the whole point -- today gunbc.runner_jit_mint is imported only by gunbc.runner.runner_jit_perform, which is imported only by gunbc.runner.runner_bound_attempt_receipt, which NOTHING imports, so the modelled runner chain terminates in a witness test. NOT owed here: retry policy and abandoned-runner cleanup, which are runner-lifecycle at M2; and the public hostname and certificate, which are production-release-identity -- a LAN-reachable receiver closes this item.",
  depends_on: [
    CompletionRequires { of: "runner-canary", why: "THE INGRESS IS A SUCCESSOR OF THE CANARY, NOT A PREDECESSOR. This item's exit is that a delivery REACHES gunbc.runner_jit_mint JitMintAuthorized, so there has to be an executing job path on the other side of the join; a receiver wired to a chain that terminates in a witness test has proved nothing it could not prove alone." },
    StartRequires { of: "control-plane-state-store", why: "THE ONLY THING THIS ITEM CONSUMES IS ONE ROW OF THAT ENUMERATION -- where a delivery record durably lives -- and that row exists as soon as the enumeration is being written. The recovery half, which is the long part of that item and most of its window, is NOT consumed here: a receiver can write guid-keyed records before anyone has decided what happens when the host holding them is gone. So this edge binds the START and would be a false serialization as a completion edge." },
  ],
  relates_to: ["strategy.ci_alpha", "strategy.ci_product_surface"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// THE SIGN-IN PROVIDER IS DELIBERATELY NOT DECIDED HERE. GitHub versus Google is an operator
// question; every conjunct below is provider-independent, and writing the item this way is what
// stops the open question from blocking the nine tenths of the work that does not depend on it.
data item_customer_identity_access: PlanItem = PlanItem {
  id: "customer-identity-access",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 25,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "AN AUTHENTICATED CUSTOMER IDENTITY THE SERVER DECIDES WITH, exercised end to end. (1) Identity and session from GOOGLE SIGN-IN ONLY (operator decision 2026-09-19); the account key is the ID token's issuer and subject, never the email, which can change. GitHub is NOT a sign-in method: it is CONNECTED SEPARATELY, as the installation binding in (3), on an account that has already signed in with Google. (2) ORG MEMBERSHIP as a modelled relation: a search of dag/ for OrgMembership returns nothing today. (3) THE INSTALLATION BINDING IS VERIFIED SERVER-SIDE AND IS NEVER A BROWSER-SUPPLIED ID -- the installation id arrives from GitHub on the authenticated callback or is read back from the App, and a request that carries its own claim of which installation it is is refused. gunbc.auth.github_apps ObservedAppRegistration observes OUR App and is not this fact. (4) TERMS-REVISION ACCEPTANCE recorded against a revision identity, so what a customer agreed to is readable later; nothing in dag/ carries this today. (5) PER-REQUEST SERVER AUTHORIZATION on every authenticated route, decided from the session and never from a parameter. (6) REVOCATION AND EXPIRY HAVE CONSUMERS: a revoked installation or an expired session stops authorizing within a declared bound, and the bound is asserted rather than assumed. (7) A CROSS-TENANT NEGATIVE TEST that is red when the wall is removed: tenant A's authenticated session must be REFUSED tenant B's job, receipt and usage, each separately. gunbc.product.fabric.identity FabricIdentity<P, K> parameterises a principal and no row binds a customer org to it, so the tenant principal this test needs does not exist yet either.",
  depends_on: [
    CompletionRequires { of: "control-plane-state-store", why: "Identity, org membership and terms acceptance are durable control-plane facts, and a session store that cannot survive the loss of its host turns every revocation and expiry bound on this row into a claim nobody can keep. This consumes the RECOVERY half, not only the enumeration, so it is a completion edge where the ingress's is a start edge." },
    CompletionRequires { of: "external-app-install-rehearsal", why: "The rehearsal is what produces an OBSERVED org-owner approval with its granted permissions and selected repositories. The verified installation binding on this row is checked AGAINST that observation; without it the binding would be verified against a shape nobody has seen an org actually produce." },
  ],
  relates_to: ["strategy.compliance_posture", "strategy.ci_product_surface"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// THE DEPLOYMENT PROGRAM IS THE ONE THE PLAN MOST UNDER-CREDITS: gunbc.live_deploy and
// gunbc.running_release_identity are OPERATING on srv1, and the gap is not convergence -- it is
// that the identity being converged names one repository out of the two the product is built from,
// and that there is exactly one environment and no public ingress.
data item_production_release_identity: PlanItem = PlanItem {
  id: "production-release-identity",
  workstream: RunnerSoftware,
  milestone: M2FirstExternal,
  rank: 28,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: AgentParallel,
  exit_criterion: "A RELEASE IS AN IDENTITY, A SECOND ENVIRONMENT EXISTS, AND A PROMOTION IS SURVIVABLE. (1) RELEASE IDENTITY OVER EVERY INPUT: gunbc.running_release_identity already rules that the RUNNING PROCESS is the authority for what is deployed and already keeps revision and surface_bundle_identity separate because they fail independently -- both correct, and it names ONE revision while the product is built from the public repository, this private one, a compiler version, the built artifacts and the config. The running process reports all of them as one value or deployment ordering is decidable over half its inputs. (2) A STAGING ENVIRONMENT SEPARATE FROM PRODUCTION: a search of both repositories for staging finds only generated-artifact and merge-admission senses of the word. There is one environment. (3) PUBLIC INGRESS: a hostname, a certificate with a renewal path, and the callback URL GitHub requires for both the webhook and the App install return. This is the longest external lead on the software program and it is NOT agent-parallel. (4) PROMOTION WITH WORK RUNNING: the convergence model replaces a tree and nothing today drains or defers for an in-flight job; a promotion that kills a customer's running job is a billing and trust event, not a deployment detail. (5) PERSISTENT-STATE MIGRATION AND ROLLBACK over whatever control-plane-state-store named, with the rollback exercised rather than described. (6) INDEPENDENT POST-DEPLOY ACCEPTANCE -- an observation taken from OUTSIDE the deploying process, for which gunbc.served_surface_browser_observation is the existing carrier. (7) CONTROL-PLANE BOOTSTRAP AND DR: what recreates the control plane from nothing, rehearsed once. (8) THE PRODUCT RELEASE PINS ITS COMPILER VERSION, which rust-toolchain.toml does for this repository's own CI and nothing does for a shipped release.",
  depends_on: [
    CompletionRequires { of: "control-plane-state-store", why: "Conjunct (5) is persistent-state migration and rollback OVER WHATEVER THAT ITEM NAMED, and conjunct (7) is a control-plane bootstrap from nothing. Both quantify over the finished enumeration AND its recovery paths, so a partial answer would leave the rollback exercised over a subset nobody declared." },
    CompletionRequires { of: "webhook-ingress-durable-record", why: "Conjunct (3) is the public callback URL GitHub requires, and a callback is a hostname POINTED AT A RECEIVER. Certificates and ingress can be procured earlier, but this item's exit is that the callback WORKS, which is a fact about the thing at the other end." },
  ],
  relates_to: ["strategy.ci_operations", "strategy.ci_site_fleet"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// SPLIT OUT OF agent-workspace-dogfood BECAUSE THE DOGFOOD ITEM IS AN OBSERVATION AND THIS IS A
// BUILD. Twenty-one calendar days of watching cannot start against a volume that does not exist,
// and folding the construction into the observation window is how a three-week exit silently
// becomes a five-week one.
data item_durable_workspace_volume: PlanItem = PlanItem {
  id: "durable-workspace-volume",
  workstream: StorageFabric,
  milestone: M2bPrivateCohort,
  rank: 35,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: AgentParallel,
  exit_criterion: "A DURABLE MUTABLE WORKSPACE WITH ONE ACTIVE WRITER, RECONSTRUCTIBLE WITHOUT ITS FAILED EXECUTOR. Nothing in dag/ carries this today -- a search for workspace, volume and writer finds no authority, and the requirement lives only in agent-workspace-dogfood's exit prose. THREE FACTS, each with a discriminating red. (1) ONE ACTIVE WRITER, ENFORCED BEFORE ATTACH: a second executor claiming the volume is REFUSED, and the refusal must hold when the first host merely APPEARS dead, because a host that appears dead is not necessarily dead and two executors on one repository corrupt it. (2) RECONSTRUCTION READS NOTHING FROM THE FAILED HOST: the volume comes up on a second admitted host with the first unreachable. A reconstruction that works because the old host answered proves nothing about host loss. (3) WHAT ACKNOWLEDGES AN EDIT AS DURABLE is a named, asserted boundary: a file change the workspace has ACKNOWLEDGED survives the loss, and an in-flight command need not. This is the pass boundary agent-workspace-dogfood already states, moved to the item that can actually enforce it. THE SEPARATION IS THE PRODUCT: an immutable digest-addressed root, this durable volume, a tenant-scoped secret path, and disposable scratch -- and CREDENTIALS ARE NOT ON THE VOLUME, so a reconstruction that works because an API key sat in it FAILS.",
  depends_on: [
    CompletionRequires { of: "fabric-m0", why: "The four-domain separation this item exists to establish has an IMMUTABLE DIGEST-ADDRESSED ROOT as one of its four, and that root is fabric-M0's product. A durable mutable volume defined against an immutable half that does not yet carry a job is defined against nothing." },
    CompletionRequires { of: "control-plane-state-store", why: "ONE ACTIVE WRITER IS A LEASE, and a lease is exactly the fact whose recovery path that item owes -- the refusal has to hold when the first host merely APPEARS dead, which is a question about what answers the lease when its holder is unreachable. That is the recovery half, not the enumeration." },
  ],
  relates_to: ["strategy.compute_fabric_model", "strategy.ci_storage_tiering"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// THE ACCEPTANCE IS THE ITEM, NOT A CLAUSE INSIDE customer-portal. A portal item exits on surfaces
// having been built; this exits on a PERSON WHO IS NOT THE OPERATOR reaching an outcome, which is a
// different fact and the only one that answers whether the product works.
data item_customer_journey_acceptance: PlanItem = PlanItem {
  id: "customer-journey-acceptance",
  workstream: AcquisitionMarketing,
  milestone: M2bPrivateCohort,
  rank: 45,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: ExternalLead,
  exit_criterion: "AN INVITED PERSON, A FRESH BROWSER, NO OPERATOR SHELL. The session is driven by someone who is not the operator, from a browser with no prior state, and the receipt names four outcomes: (1) THEY REACH AN AUTHORIZED OUTCOME -- sign in, install the App on their org, and get a job admitted -- without anyone running a command for them; (2) THEY UNDERSTAND A REFUSAL -- a deliberately refused request renders a reason they can act on, not a status code, and the refusal is one the server decided; (3) THEY SEE THEIR USAGE, which requires that metering be reachable from a job at all: today gunbc.runner.runner_usage_receipt is imported by gunbc.runner.runner_teardown_receipt and THAT module's only importer is a witness test, so the chain is rooted in a witness rather than in a job and there is nothing to render until billing-receipts closes; (4) EVERY STEP THE OPERATOR HAD TO PERFORM IS RECORDED AS A NAMED GAP rather than smoothed over, because an assisted onboarding that reads as self-serve is how a launch discovers its real gaps in front of a customer. What is deployed today is an internal roadmap dashboard served to the operator via gunbc.gunbhub_serve over gunbc.node_http_server_emit; no public marketing surface, install return page or usage statement exists.",
  depends_on: [
    CompletionRequires { of: "customer-identity-access", why: "The acceptance sentence is NO OPERATOR SHELL, which means every gate the invited person crosses is one the server decided. An identity item that is merely underway leaves the operator standing in for the missing decision, and an assisted step that reads as self-serve is the exact failure this item exists to catch." },
    CompletionRequires { of: "customer-portal", why: "The surfaces the person walks -- install return, org and repo selection, the admission result -- are that item's exit. There is nothing to walk before it closes." },
    CompletionRequires { of: "paid-minimum", why: "A journey that stops short of the payment path has not established the outcome the cohort needs, and a half-built checkout is where an invited person's session ends in a way nobody planned to observe." },
    CompletionRequires { of: "billing-receipts", why: "Conjunct (3) is THEY SEE THEIR USAGE, and today the metering chain is rooted in a witness test rather than in a job -- gunbc.runner.runner_usage_receipt is imported by gunbc.runner.runner_teardown_receipt, whose own only importer is a witness -- so until billing-receipts puts metering on an executing route there is nothing to render on the screen this item accepts." },
  ],
  relates_to: ["strategy.ci_product_surface", "strategy.ci_acquisition"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data year_end_plan_items: List<PlanItem> = [
  item_control_plane_state_store,
  item_webhook_ingress_durable_record,
  item_customer_identity_access,
  item_production_release_identity,
  item_durable_workspace_volume,
  item_customer_journey_acceptance,
  item_contributor_engagement_terms,
  item_contributor_access_provisioning,
  item_contributor_payment_path,
  item_contributor_onboarding_path,
  item_contractor_tax_reporting,
  item_buyer_agent_pipeline,
  item_storage_provider_accounts,
  item_economics_regrounding,
  item_cache_tier_fabric,
  item_fleet_network_baseline,
  item_node_local_cache_drive,
  item_cache_hit_floor,
  item_cloud_overflow_role,
  item_cloud_quota_baseline,
