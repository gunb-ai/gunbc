data item_wholesale_pilot_acceptance: PlanItem = PlanItem {
  id: "wholesale-pilot-acceptance",
  workstream: AcquisitionMarketing,
  milestone: M5Q2ColoDeployment,
  rank: 80,
  min_calendar_days: 30,
  active_effort_days: 30,
  execution_mode: ExternalLead,
  exit_criterion: "Four nodes accepted by the buyer under a NON-PRODUCTION suite agreed in advance, LAYERED ON THE PUBLIC HARDWARE AUTHORITY (recut 2026-09-14): each of the four carries a current gunbc.machine_intake FleetAdmissionReceipt under the production qualification policy (arrival hardware qualification, OS provisioning, placement commissioning - not a hand-authored checklist), and above it the buyer-specific integration receipts: identity (asset, serial, BMC, buyer node id), the buyer image/agent booted through the bound delivery plan, link and isolation as the buyer requires, OOB and reinstall through the buyer path, unique credentials, an agreed workload floor, a simulated node loss with spare replacement through the buyer integration, and a signed acceptance timestamp per node. Requires a signed pilot order (wholesale-pilot-order-execution). The buyer places no downstream customer work on the pilot.",
  depends_on: [dep(id: "wholesale-provider-integration"), dep(id: "colo-turnup-rack-acceptance"), dep(id: "wholesale-pilot-order-execution")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.fleet_qualification"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// THE ITEM THAT OWNS THE REPAIR-INTERVAL TRANSITION, added because no existing item did (side review
// of gunbc-private#141). strategy.wholesale_batch_floor RepairIntervalPlanAssessment rests on six
// planning assumptions, and the journey step that renders it needs one plan item whose completion
// means ALL of them are resolved and the grounded public decision has been taken. wholesale-pilot-
// acceptance does not qualify: it accepts four pilot nodes and a simulated loss, and leaves the
// cadence, the failure rate, the slot shape, the pool size and the full-fleet population ungrounded,
// so pointing the step at it would have reported ownership that does not exist.
data item_wholesale_repair_interval_admission: PlanItem = PlanItem {
  id: "wholesale-repair-interval-admission",
  workstream: RunnerSoftware,
  milestone: M5Q2ColoDeployment,
  rank: 81,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "THE REPAIR-INTERVAL PLAN STOPS BEING A PLAN. Every assumption strategy.wholesale_batch_floor plan_assumptions names is discharged: the slot shape is negotiated (SlotShapeNegotiated), the failover pool is sized on a measured cull rate and the buyer's stated expectation (PoolSizedByMeasurement), the repair cadence is ruled (RepairCadenceRuled), the failure rate is measured on this fleet (FailureRateMeasured), the full required capacity population - not one representative host - is observed and admitted through product.fabric.capacity_admission, and the owned fleet route has an unexpired exercise. Then, on a committed buyer demand, product.fabric.failure_scenario_admission is asked the repair-cadence scenario (accumulated failures before a visit plus one node) over that admitted capacity and returns FailureScenariosSurvived, recorded as the receipt of the admission. A fitting RepairIntervalPlanAssessment alone never discharges this item.",
  depends_on: [dep(id: "wholesale-pilot-acceptance"), dep(id: "wholesale-requirements-discovery"), dep(id: "wholesale-fabric-buyer-demand")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.wholesale_journeys"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_offboarding_erasure: PlanItem = PlanItem {
  id: "wholesale-offboarding-erasure",
  workstream: SecurityCompliance,
  milestone: M4JanuaryLaunch,
  rank: 80,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: OperatorExclusive,
  exit_criterion: "Rehearsed on one node: buyer credential revocation, local-data erasure with a receipt, BMC factory reset and re-credential, buyer agent removal, and disposition of any buyer-funded hardware - so termination is an executable procedure before the first contract can end.",
  depends_on: [dep(id: "wholesale-provider-integration")],
  relates_to: ["strategy.asset_lifecycle", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_production_readiness: PlanItem = PlanItem {
  id: "wholesale-production-readiness",
  workstream: OpsMachineHealth,
  milestone: M5Q2ColoDeployment,
  rank: 90,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: OperatorExclusive,
  exit_criterion: "PRODUCTION ADMISSION (recut 2026-09-14): an identity join over twenty current gunbc.machine_intake FleetAdmissionReceipts under the production policy plus one current MATCHED-spare receipt (same DIMM population and speed, same NIC and firmware - the held unit is a replacement chassis until its census and upgrade land), the buyer acceptance receipts layered above them, the infrastructure realization named and not counted as billable, and each of its own dependencies Done: network disposition, origin/staging/cache realized and failed over, health observability, fault actuation and repair readmission exercised, security admitted, compliance dossier frozen, support/SLO disposition total. Reliability is not one spare node.",
  depends_on: [dep(id: "wholesale-pilot-acceptance"), dep(id: "wholesale-bom-capacity-freeze"), dep(id: "spares-control-plane-readiness"), dep(id: "tax-insurance-scope"), dep(id: "wholesale-hardware-serviceability"), dep(id: "wholesale-security-admission"), dep(id: "wholesale-compliance-admission"), dep(id: "wholesale-support-slo"), dep(id: "wholesale-origin-boot-cache-realization"), ConditionalRequires { of: "wholesale-apartment-journey-acceptance", condition: "wholesale_journeys production_site is the apartment overlay", why: "The journey required is the one on the SELECTED production site; strategy.wholesale_journeys production_readiness_binds_selected_site_journey refuses a selection whose edge is still conditional - selecting the site obliges the edit to dep(id: ...) in the same change." }, ConditionalRequires { of: "wholesale-colo-journey-acceptance", condition: "wholesale_journeys production_site is the colo cabinet", why: "As above, for the colo cabinet. A first buyer that goes directly to colo does not owe the apartment journey forever." }],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.asset_lifecycle", "strategy.rack_power_engineering"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_capacity_ready: PlanItem = PlanItem {
  id: "wholesale-capacity-ready",
  workstream: EconomicsQa,
  milestone: M5Q2ColoDeployment,
  rank: 100,
  min_calendar_days: 1,
  active_effort_days: 1,
  execution_mode: OperatorExclusive,
  exit_criterion: "THE WHOLESALE GATE, separate from s1-gate: a total admitted-or-refused projection over the conjunction in wholesale_gate_required_deps - production readiness (which carries network, origin, serviceability, security, compliance and SLO), offboarding rehearsed, site contract signed, the PRODUCTION CONTRACT EXECUTED (the binding offer wholesale-supply-channel can exit on an explicit no and is therefore not a gate dependency; it is reached through the contract) with first payment received, and the BILLING SETTLEMENT rehearsed. Billing begins here and nowhere earlier.",
  depends_on: [dep(id: "wholesale-production-readiness"), dep(id: "wholesale-offboarding-erasure"), dep(id: "colo-contract-execution"), dep(id: "wholesale-production-contract-execution"), dep(id: "wholesale-capacity-billing-settlement")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.year_end_plan"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_network_decision: PlanItem = PlanItem {
  id: "wholesale-network-decision",
  workstream: Hardware,
  milestone: M3YearEndGate,
  rank: 40,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: OperatorExclusive,
  exit_criterion: "THE JOINT NETWORK-AND-CACHE SELECTION (recut 2026-09-14): consumes wholesale-network-cache-experiment and chooses leaf speed, rack uplinks, transit commit, cache realization, switch topology, required NICs and the resulting BOM as one point. A total disposition: Onboard1GbEAdmitted, BuyerRequires10GbE, MeasurementRequires10GbE, NetworkDecisionUnresolved. 1 GbE is admitted only on the experiment receipts; 10G only on a named counterexample or a buyer requirement. Link speed and cache topology are mutually dependent - the value of a cache depends on the link, the adequacy of the link on hit rate and rewarm - so they are not decided separately. Leaf link, rack uplinks and transit commit need not match. REVIEW REPAIR 2026-09-14 (P1): the selection lands as wholesale_batch_floor cache_realization - NoCacheSelected, NodeRamCacheSelected, NodeDiskCacheSelected or RackCacheSelected - and RackCacheSelected carries the downstream-tenant authorization and isolation ruling (cache-tier-fabric proves bytes, not permission) as its tenancy_ruling; strategy.wholesale_journeys projects the cache step from this carrier.",
  depends_on: [dep(id: "wholesale-requirements-discovery"), dep(id: "fleet-network-baseline"), dep(id: "wholesale-network-cache-experiment")],
  relates_to: ["strategy.fleet_decisions", "strategy.wholesale_batch_floor", "strategy.procurement_order"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_origin_boot_cache_realization: PlanItem = PlanItem {
  id: "wholesale-origin-boot-cache-realization",
  workstream: StorageFabric,
  milestone: M3YearEndGate,
  rank: 48,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: OperatorExclusive,
  exit_criterion: "OWNS BINDING AND EXECUTION, NOT PROTOCOLS (recut 2026-09-14): boot transport is gunbc.boot_artifact_delivery and is bound by wholesale-boot-delivery-binding; R2 readiness is wholesale-r2-origin-readiness. This item: the staging placement deployed where boot-delivery-binding selected it; the cache realization selected by wholesale-network-decision deployed (absent, node RAM, node disk, or a rack service); R2 bound as origin where the boundary uses it; customer artifacts explicitly assigned an owner; each realization failed over once - staging loss blocks only new or recovering nodes, cache loss degrades and never blocks. Resolves fleet_decisions infrastructure-pair, and with it the NVMe, OCP-NIC and DAC procurement lines that await it.",
  depends_on: [dep(id: "wholesale-service-boundary"), dep(id: "netboot-gap-analysis"), dep(id: "wholesale-boot-delivery-binding"), dep(id: "wholesale-r2-origin-readiness"), dep(id: "wholesale-network-decision")],
  relates_to: ["strategy.fleet_decisions", "strategy.ci_storage_tiering", "strategy.compute_fabric_model", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// REVIEW REPAIR 2026-09-14 (P2): fleet_decisions infrastructure-pair is a FLEET question, and it
// was blocked on a wholesale-only item while the direct-CI plan still consumes a redundant pair
// for its tier-two cache. This item joins the two channels; procurement derives from the union.
data item_site_cache_realization: PlanItem = PlanItem {
  id: "site-cache-realization",
  workstream: Hardware,
  milestone: M3YearEndGate,
  rank: 49,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: AgentParallel,
  exit_criterion: "The UNION of cache realizations selected by each consuming channel: the direct-CI program's (cache-tier-fabric, node-local-cache-drive: a redundant pair or node-local drives, on the admitted concurrency) and the wholesale program's (wholesale-network-decision: cache_realization per buyer). A shared physical pair is admissible only when BOTH channels select it; a channel that selects no on-site cache contributes nothing. strategy.procurement_order's NVMe, OCP-NIC and DAC lines derive from this union, not from one channel's boolean, and fleet_decisions infrastructure-pair is decidable when this item is Done.",
  depends_on: [dep(id: "wholesale-network-decision"), dep(id: "cache-tier-fabric"), dep(id: "node-local-cache-drive"), dep(id: "wholesale-origin-boot-cache-realization")],
  relates_to: ["strategy.fleet_decisions", "strategy.procurement_order", "strategy.ci_storage_tiering", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// REVIEW REPAIR 2026-09-14 (P1): the managed/hosted boundary needs the R2 account, bucket and write
// credential - not the two-provider survey that also carries Backblaze B2 pricing.
data item_r2_origin_account_bucket_write_readiness: PlanItem = PlanItem {
  id: "r2-origin-account-bucket-write-readiness",
  workstream: StorageFabric,
  milestone: M3YearEndGate,
  rank: 30,
  min_calendar_days: 2,
  active_effort_days: 2,
  execution_mode: AgentParallel,
  exit_criterion: "The Cloudflare R2 account billed to the LLC, the origin bucket in an American region, and the write credential minted and pinned (gunbc.cloudflare.r2_origin run_object_write; today OriginCredentialUnminted), with PUT, GET and independent readback exercised once. Nothing about Backblaze B2 is consumed here.",
  depends_on: no_deps,
  relates_to: ["strategy.wholesale_batch_floor", "strategy.ci_storage_tiering"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_security_profile: PlanItem = PlanItem {
  id: "wholesale-security-profile",
  workstream: SecurityCompliance,
  milestone: M3YearEndGate,
  rank: 50,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: OperatorExclusive,
  exit_criterion: "THE RESPONSIBILITY MATRIX ONLY (split 2026-09-14): per buyer boundary, every control lands in one of GunbaiOwned, BuyerOwned, Shared, NotApplicableForBoundary, Unresolved - colo physical security, rack access and remote hands, BMC/OOB network, BMC credentials and console audit, BIOS/BMC firmware, host OS and hypervisor, runner agent and downstream isolation, edge transit/DDoS/abuse, R2 artifacts and credentials, customer artifacts, vulnerability response, incident notification, decommission and erasure, node identity and replacement enrollment. Raw metal, managed substrate and hosted capacity consume DIFFERENT control populations; the direct-CI controls are neither inherited wholesale nor bypassed. Realizations are their own items: wholesale-oob-management-realization, mt-collins-firmware-serviceability, and the existing credential, image, logging and offboarding producers; wholesale-security-admission joins them.",
  depends_on: [dep(id: "wholesale-service-boundary")],
  relates_to: ["strategy.compliance_posture", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_hardware_serviceability: PlanItem = PlanItem {
  id: "wholesale-hardware-serviceability",
  workstream: OpsMachineHealth,
  milestone: M5Q2ColoDeployment,
  rank: 78,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: AgentParallel,
  exit_criterion: "THE JOIN (split 2026-09-14): wholesale-health-observability, wholesale-fault-actuation and wholesale-repair-readmission each Done, and one end-to-end run - runtime RAS/fan/PSU observation, durable off-host ingestion, completeness or refusal, alert delivery and acknowledgment, cordon/drain/power action, accepted spare activation, buyer identity transfer, component repair, full machine-intake readmission producing a new FleetAdmissionReceipt. Day-one policy, consumed from the observation producers and never written into them: isolated corrected ECC persists and watches; same-location recurrence or a declared CE rate drains and quarantines; ANY uncorrectable memory event or fatal CPU/cache/interconnect event culls the whole node and activates the spare; missing DIMM, changed population or training failure refuses admission; expected fan not rotating with unproven thermal margin drains and powers down; missing tach is unknown, never healthy; repaired hardware re-runs the full intake. A DIMM is called the failed DIMM only when attribution establishes that grain; a channel- or controller-attributed event still takes the node down and does not license replacing a guessed stick. REVIEW REPAIR 2026-09-14 (P1): this is the COLO serviceability proof - it consumes colo turn-up through health observability and adds the facility's remote-hands FRU transaction; the apartment journey proves local fault handling through wholesale-local-fault-spare-activation instead.",
  depends_on: [dep(id: "wholesale-health-observability"), dep(id: "wholesale-fault-actuation"), dep(id: "wholesale-repair-readmission")],
  relates_to: ["strategy.asset_lifecycle", "strategy.ci_operations", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_compliance_admission: PlanItem = PlanItem {
  id: "wholesale-compliance-admission",
  workstream: SecurityCompliance,
  milestone: M5Q2ColoDeployment,
  rank: 70,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: OperatorExclusive,
  exit_criterion: "One exact dossier for the named buyer, CONDITIONAL ON THE BOUNDARY (recut 2026-09-14): hosted capacity requires the full direct-CI gate m2-compliance-admission by identity; a managed substrate requires the shared infrastructure, route, data-access and downstream-contract controls; raw bare metal requires physical, OOB, remote-hands, administrative-access, contract, incident, data-erasure and sanctions/export allocation only. The dossier: the selected colo and inherited physical controls; R2 use and data classes where applicable; management, monitoring and support providers; remote-hands access; every region and administrative-access path; the selected boundary; contract, security schedule and any DPA revision; subprocessor list; retention, deletion and offboarding; incident-notification responsibilities; sanctions, export and prohibited-use allocation; facility and vendor evidence available to the buyer. Unresolved controls REFUSE - compliance_posture is an issue register, not a verdict, and the audit-control model still owes access review, vendor roster, incident exercise, vulnerability management, physical-control inheritance, monitoring evidence, training and key custody. No offer says SOC 2 compliant, SOC 2 ready, or ISO certified. REVIEW REPAIR 2026-09-14 (P1): the m2-compliance-admission binding is a declared ConditionalRequires edge on the modeled boundary fact, and wholesale_batch_floor's witness refuses a ManagedFabricCapacity selection that leaves it conditional. Every Unresolved control carries a wholesale_batch_floor UnresolvedControlDisposition - BlocksProduction, ContractuallyExcluded, BuyerOwnedByContract or BoundedReplacementOnly - not merely a line in the disclosure.",
  depends_on: [dep(id: "wholesale-security-profile"), dep(id: "colo-contract-execution"), ConditionalRequires { of: "m2-compliance-admission", condition: "wholesale_batch_floor selected_boundary is ManagedFabricCapacity for the named buyer", why: "The hosted-capacity arm consumes the full direct-CI gate BY IDENTITY, the other two arms do not; the edge is declared conditional because the boundary is decided per buyer after discovery. The binding is not left to prose: wholesale_batch_floor compliance_gate_binds_m2_for_hosted_capacity reads this item and refuses a HostedCapacity selection whose compliance gate does not carry m2-compliance-admission as an unconditional dep - selecting hosted capacity obliges the edit to dep(id: m2-compliance-admission) in the same change." }],
  relates_to: ["strategy.compliance_posture", "strategy.b2b_capacity_track", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_support_slo: PlanItem = PlanItem {
  id: "wholesale-support-slo",
  workstream: OpsMachineHealth,
  milestone: M5Q2ColoDeployment,
  rank: 85,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: OperatorExclusive,
  exit_criterion: "A support and SLO product selected from evidence over an OBSERVATION WINDOW - the paid 30-day pilot at minimum - with a TOTAL terminal standing: BestEffortOnly, CreditBackedSloAdmitted, SloRefusedMissingEvidence. One successful spare drill proves the replacement transaction; it does not create uptime history. Measured: fault evidence to alert, alert to cordon, cordon to accepted spare capacity, first human acknowledgment, P1 update cadence, component replacement, repaired-node readmission, accepted nodes available during the incident. Distinguished: per-node availability, aggregate contracted capacity, rack/site availability, management-plane availability, buyer-caused failures. One spare is N+1 for ONE simultaneous node failure and protects against none of: two failures, switch, PDU/feed design, environment, transit, site loss, R2 or staging-path loss - each gets redundancy or an explicit SLO exclusion. Support coverage declared honestly as one of: business-hours human plus 24x7 automated; named after-hours escalation best-effort; contracted NOC; a real 24x7 rotation. No four-hour replacement is quoted before the facility returns remote-hands availability and the procedure has executed.",
  depends_on: [dep(id: "wholesale-hardware-serviceability"), dep(id: "colo-turnup-rack-acceptance"), dep(id: "wholesale-provider-integration"), dep(id: "wholesale-pilot-acceptance"), dep(id: "support-abuse")],
  relates_to: ["strategy.b2b_capacity_track", "strategy.ci_operations", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

// ---- third audit folded 2026-09-14: bind what exists, plan only what is missing ----

data item_wholesale_boot_delivery_binding: PlanItem = PlanItem {
  id: "wholesale-boot-delivery-binding",
  workstream: RunnerSoftware,
  milestone: M3YearEndGate,
  rank: 42,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: AgentParallel,
  exit_criterion: "BOOT TRANSPORT IS IMPLEMENTED; THIS BINDS IT. With the buyer boundary selected: an existing public gunbc.boot_artifact_delivery BootDeliveryPlan produced for the exact Mt. Collins target and artifact; the STAGING PLACEMENT selected separately (gateway appliance, dedicated management host, already-booted peer, buyer-controlled staging - wholesale_batch_floor StagingPlacement); one full cold-host execution proving exact digest delivered, intended host consumed it, nonce-bound callback returned, boot override consumed and restored, temporary media and credentials detached; staging failure behaviour exercised; no Q80 fleet node consumed unless the placement selection explicitly says so. No new boot vocabulary is minted.",
  depends_on: [dep(id: "wholesale-service-boundary"), dep(id: "netboot-gap-analysis")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.fleet_decisions"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_r2_origin_readiness: PlanItem = PlanItem {
  id: "wholesale-r2-origin-readiness",
  workstream: StorageFabric,
  milestone: M3YearEndGate,
  rank: 42,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: AgentParallel,
  exit_criterion: "THE MECHANISM EXISTS (gunbc.cloudflare.r2_origin_object: put, get, independent readback, digest verification, create-if-absent, ambiguous-write reconciliation, credential cleanup); this closes its LIVE STANDING, conditional on a boundary that uses GUNBAI's origin: the write credential executed and pinned (today OriginCredentialUnminted, producer run_object_write); PUT then GET then independent readback exercised; the exact boot-artifact population admitted; credential residue proven absent; object-account recovery exercised; R2 jurisdiction, data classes and buyer disclosure recorded. For raw bare metal the standing is R2NotApplicableForThisBoundary and this item is discharged by that declaration. REVIEW REPAIR 2026-09-14 (P1): the storage-provider-accounts edge is conditional on the boundary using R2; a raw-metal buyer is not blocked on Backblaze B2 pricing.",
  depends_on: [dep(id: "wholesale-service-boundary"), ConditionalRequires { of: "r2-origin-account-bucket-write-readiness", condition: "the selected boundary uses GUNBAI's origin (wholesale_batch_floor boundary_uses_gunbai_origin: managed substrate or hosted capacity)", why: "Raw metal carries no storage-provider dependency - the buyer brings its own plane - and this item discharges as R2NotApplicableForThisBoundary. The narrow producer a managed or hosted boundary needs is the R2 account, bucket and write credential (gunbc.cloudflare.r2_origin run_object_write), which r2-origin-account-bucket-write-readiness produces on its own, independent of the two-provider survey and its Backblaze B2 work; wholesale_batch_floor r2_readiness_binds_storage_when_boundary_uses_r2 refuses an R2-using selection whose edge is still conditional." }],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.ci_storage_tiering"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_network_cache_experiment: PlanItem = PlanItem {
  id: "wholesale-network-cache-experiment",
  workstream: Hardware,
  milestone: M3YearEndGate,
  rank: 35,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "Candidate points executed, not argued, and each point carries a wholesale_batch_floor ExperimentPointStanding (review repair 2026-09-14, P2): 1 GbE leaf with no cache, with RAM cache, with a rack cache are REQUIRED; 10 GbE leaf with no cache and with the selected cache are required ONLY on a trigger - a named buyer requirement, an observed 1 GbE counterexample, or the operator approving a sample card in wholesale-network-cache-authorization - and otherwise stand NotRunNotRequired with the basis named, which is distinct from PointNotRun (missing evidence) and does not block the 1 GbE disposition. Measured at each executed point: single-node cold boot/reinstall, simultaneous multi-node cold start, rack-cold origin rewarm, a real dependency-fetch and artifact workload, interference while another node rebuilds, and the buyer-required per-node and aggregate throughput - carrying bytes, goodput, time-to-ready, peak and percentile utilisation, queueing or refusal, and whether customer work was displaced. Feeds wholesale-network-decision, whose joint selection decides cache absence, RAM cache, node disk or rack service; nothing is elected here.",
  depends_on: [dep(id: "wholesale-requirements-discovery"), dep(id: "fleet-network-baseline"), dep(id: "netboot-gap-analysis")],
  relates_to: ["strategy.ci_storage_tiering", "strategy.fleet_decisions", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_oob_management_realization: PlanItem = PlanItem {
  id: "wholesale-oob-management-realization",
  workstream: SecurityCompliance,
  milestone: M3YearEndGate,
  rank: 45,
