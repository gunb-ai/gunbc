  id: "wholesale-pilot-order-execution",
  workstream: AcquisitionMarketing,
  milestone: M3YearEndGate,
  rank: 65,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: ExternalLead,
  exit_criterion: "A signed NON-PRODUCTION pilot order: four nodes, the $550 rate with the $50 credit on conversion, support boundary, no production SLA, the acceptance suite, start and end dates, payment received. The transaction the offer implied and nothing produced.",
  depends_on: [dep(id: "wholesale-offer-acceptance"), dep(id: "pilot-capital-admission")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.b2b_capacity_track"],
  item_relations: no_item_relations,
