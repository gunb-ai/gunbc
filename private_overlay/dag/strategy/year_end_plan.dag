data item_ny_llc_transparency_act: PlanItem = PlanItem {
  id: "ny-llc-transparency-act",
  workstream: SecurityCompliance,
  milestone: M3YearEndGate,
  rank: 10,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: OperatorExclusive,
  exit_criterion: "Beneficial ownership disclosed to the New York Department of State under the LLC Transparency Act, on the transition deadline understood to fall on 2027-01-01 for entities formed before 2026-01-01. Confirm the operative deadline against the Department's own guidance rather than this row. The narrowed federal FinCEN regime does NOT discharge it — concluding that beneficial ownership does not apply is exactly how the state filing gets missed.",
  depends_on: no_deps,
  relates_to: ["finance.gunbai_llc"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_gdpr_posture: PlanItem = PlanItem {
  id: "gdpr-posture",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 20,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: ExternalLead,
  exit_criterion: "Territorial scope decided against Article 3 rather than against billing country - establishment in the Union, offering goods or services to data subjects in the Union, and monitoring their behaviour each trigger it independently, so an entirely US-billed customer base does not by itself settle the question. Then: controller and processor roles named per processing activity, data map of what the CI path touches, lawful basis, retention and deletion covering build artefacts and logs, a DPA offered rather than requested, sub-processor list, and a Chapter V transfer mechanism where personal data leaves the Union. Binds on the first in-scope data subject, not at the year-end gate. Declining in-scope customers for now is an admissible answer and must be recorded as one, since silence reads as acceptance.",
  depends_on: [dep(id: "m2-applicability-model")],
  relates_to: ["strategy.compliance_posture"],
  item_relations: no_item_relations,
  status: NotStarted,
}


// ---------------------------------------------------------------------------------------------
// CLOUD CAPACITY (operator, 2026-09-04). Two questions the plan did not carry. First, whether
// rented cloud capacity has a role at all — burst overflow above owned fleet capacity, x86_64
// build targets the aarch64 fleet cannot serve natively, or a control plane that must not share
// a failure domain with the machines it schedules. Second, and the operator's own framing:
// capacity is NOT available on demand at the sizes being planned. Provider quotas are granted
// per account, per region and per machine family, start small on a new account, and are raised
// by REVIEWED REQUEST with a lead time measured in days — sometimes with a spend history or a
// support tier as a precondition. A burst path whose quota is discovered at the moment of burst
// is not a burst path; it is an outage with a plan attached. The quota is therefore a lead-time
// item that must be started before it is needed, exactly like the colo contract.
// ---------------------------------------------------------------------------------------------

data item_cloud_overflow_role: PlanItem = PlanItem {
  id: "cloud-overflow-role",
  workstream: Hardware,
  milestone: M1bInternalS0Proof,
  rank: 10,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: AgentParallel,
  exit_criterion: "A decision on what, if anything, rented cloud capacity is FOR, with the honest cost comparison behind it: burst overflow above owned capacity, x86_64 targets the aarch64 fleet cannot serve natively, a control plane held outside the fleet's failure domain, or nothing. Owned hardware is the cost advantage the entire product rests on, so every cloud hour is margin spent — an unpriced overflow path quietly inverts the pitch. Answering 'none of these' is admissible and closes the two items below.",
  depends_on: no_deps,
  relates_to: ["strategy.ci_spill_policy", "strategy.serving_capacity"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_cloud_quota_baseline: PlanItem = PlanItem {
  id: "cloud-quota-baseline",
  workstream: Hardware,
  milestone: M2FirstExternal,
  rank: 50,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: ExternalLead,
  exit_criterion: "For each provider actually in scope — Hetzner, GCP, and any third — the CURRENT granted quota recorded per region and machine family as an observed number rather than a published maximum, alongside the request path, the reviewed lead time, and any spend-history or support-tier precondition. Then the increase requested for whatever cloud-overflow-role concluded, and the granted result recorded. New accounts start low and raises are reviewed, so this is a lead-time item: it must be started before the capacity is wanted, not when it is.",
  depends_on: [dep(id: "cloud-overflow-role")],
  relates_to: ["strategy.ci_spill_policy"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_control_plane_siting: PlanItem = PlanItem {
  id: "control-plane-siting",
  workstream: Hardware,
  milestone: M2bPrivateCohort,
  rank: 30,
  min_calendar_days: 14,
  active_effort_days: 10,
  execution_mode: OperatorExclusive,
  exit_criterion: "RECUT 2026-09-19 FROM NAMING TO RUNNING. The previous exit ended at 'Names where the control plane runs', and a name is not a siting: today the fabric event log IS the control plane's durable state and gunbc.fabric_event_log fabric_event_log_placement places it on srv1, inside the fleet, single-writer, refusing rather than failing over. So the exposure this item exists to close is currently REALIZED, not hypothetical. THE EXIT IS NOW: the control plane RUNS off the fleet's power, network and physical-access domain, with the move executed and observed, and with what customers see when the fleet is unreachable and the control plane is not RENDERED AND READ BY SOMEONE WHO IS NOT THE OPERATOR. THE PRIOR EXIT IS RETAINED BELOW AS THE ARGUMENT AND IS NO LONGER THE EXIT, stated explicitly because a recut that merely prepends leaves TWO completion conditions in one row and a worker may satisfy the weaker one -- which is the exact failure this recut opens by naming. Nothing after this sentence closes the item. THE ARGUMENT: scheduler, API, billing and status surfaces sited so that they do not share power, network or physical access with the fleet they control. Under a residential soft launch this is the sharpest exposure: one tripped circuit takes down both the machines and the ability to say why. Naming where the control plane runs, and what customers observe when the fleet is unreachable but the control plane is not, is the FIRST STEP of the work above and no longer its completion. SIZING REVISED WITH THE EXIT, because widening an exit while leaving its duration alone reports identical slack for materially more work: 7/7 described a naming exercise. An executed relocation off the fleet's failure domain is 10 effort days inside a 14-day window, and the gap is waiting the operator cannot compress -- off-fleet capacity has to be procured and DNS and ingress have to propagate before the move can be observed at all.",
  depends_on: [dep(id: "cloud-overflow-role")],
  relates_to: ["strategy.ci_site_fleet", "strategy.home_hosting"],
  item_relations: no_item_relations,
  status: NotStarted,
}


// ---------------------------------------------------------------------------------------------
// NETWORK AND LOCAL STORAGE (operator, 2026-09-04). Established this day: the Mt Collins carry two
// onboard 1 GbE ports plus a 1 GbE BMC port, and the OCP NIC 3.0 slots are EMPTY - so the fleet is
// 1 GbE per node unless cards are bought and 20 chassis opened. 10 gigabit is a purchase, not a
// cable.
//
// That makes the cache load-bearing rather than optional. strategy.ci_storage_tiering plans 2 GB
// restored per job at 2 vCPU and 5 minutes over 2100 sellable vCPU at 30 percent utilisation:
// 16.8 Gbps of fleet restore traffic average, 50.4 at the declared 3x peak, which across 20 nodes
// is 0.84 Gbps average and 2.52 Gbps PEAK PER NODE if every restore crosses the wire - already
// beyond a single 1 GbE link. The model carries the escape as an axis rather than an assumption:
// ServingLocality's HotServedLocallyWithOriginMiss takes a local hit rate.
//
// The move that dissolves the constraint rather than mitigating it is a local drive, because it
// takes the layer cache, package cache and runner images off the wire entirely and leaves 1 GbE
// carrying what it is actually good for - clone, pull-on-miss, artifact upload. A local cache is
// also compatible with netboot's real purpose: the OS image still arrives over the network and
// the drive holds only ephemeral state, so a node stays reimageable from any other.
// ---------------------------------------------------------------------------------------------

data item_fleet_network_baseline: PlanItem = PlanItem {
  id: "fleet-network-baseline",
  workstream: Hardware,
  milestone: M1bInternalS0Proof,
  rank: 10,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: OperatorExclusive,
  exit_criterion: "SUPERSEDED 2026-09-14 (operator, audit folded): ONBOARD 1 GbE IS THE BASELINE AND 10 GbE IS AN UNELECTED OPTION. strategy.fleet_decisions leaf-network-speed (Decided 2026-09-04: 1 GbE at the leaves) is the authority; the 2026-09-10 text below that selected a 10G card per node contradicted it and is retracted, kept as provenance. Three layers stay separate: the per-node leaf link (onboard 1 GbE), the rack service/uplink links (open), and internet transit (the RFQ asks a 1 Gbps commit on a 10G handoff). 10G at the leaf is elected only by wholesale-network-decision on a named buyer requirement or a named measurement. This item now exits on the MEASURED link-utilisation receipt alone. PROVENANCE, 2026-09-10 TEXT: THE PORT-SPEED DECISION COMES FIRST AND THE SWITCH FOLLOWS FROM IT, which is the reverse of how this item was written. The previous criterion assumed 1GbE bonding and derived a 60-port two-switch layout from it; bonding two 1G links raises aggregate throughput across concurrent restores and does NOTHING for a single job fetch, so it never fixed the axis that matters. A single 10G port per node fixes both and the operator prices used 10G cards at roughly 30 dollars, which is a rounding error against a 1,953.90 delivered node. THE OCCUPANCY QUESTION IS SETTLED AND THE ANSWER IS EMPTY (operator, 2026-09-10, by direct inspection; strategy.mt_collins_held_unit mt_collins_ocp_slot_occupancy = OcpSlotEmpty). The platform has an OCP 3.0 mezzanine slot and NO onboard 10GbE, and no card is fitted - so today these nodes have a 1G path and nothing else. TWENTY CARDS AT ROUGHLY 30 DOLLARS IS ABOUT 600 FOR THE FLEET, 1.5 per cent of ONE node delivered at 1,953.90, and the operator has ruled for 10G cards over bonding on simplicity: no LACP support required in the switch, no bond configuration on the host, and it fixes single-restore latency, which bonding structurally cannot. That earlier 2026-09-06 BMC sensor reading is superseded rather than deleted - it correctly declined to read four OCP-named sensors as occupancy, and its lspci discriminator remains the route for any unit nobody has opened. PURCHASE IS BUNDLED WITH THE RAM, NOT RUN AHEAD OF IT (operator, 2026-09-10). Two reasons, and the second is the one that would have cost money. COMPATIBILITY IS UNRESEARCHED: an OCP 3.0 slot admits cards, not every card - form factor, keying, the mezzanine generation the board actually negotiates, firmware the platform will accept, and whether a card sold as OCP 3.0 SFF fits this chassis at all are open questions, and twenty of the wrong card is twenty wrong cards. AND ONE ORDER IS CHEAPER THAN TWO: memory-bom-decision is already a fleet-scale purchase for the same twenty units on the same delivery, so the NIC rides with it - one shipment, one intake, one receiving event to reconcile against. This item therefore does NOT gate on buying anything; it gates on the DECISION being derivable, and the decision is now derivable because occupancy is settled. THEN the switching, sized to that decision: port count and speed per node, data and management on separate VLANs, and a BMC path that does not share a failure domain with the data path. The two-switch conclusion may still hold on port count alone - 20 data plus 20 BMC is 40 - but it must be DERIVED from the chosen per-node port shape rather than inherited from the bonded-1G assumption that is now withdrawn. THE EDGE THIS BUNDLING NEEDS POINTS THE OTHER WAY, AND THE FIRST VERSION OF THIS ROW GOT IT BACKWARDS (corrected 2026-09-10). It declared depends_on memory-bom-decision and then argued, in this paragraph, that the arrangement produced a scheduling inversion the plan could not flag: this item's latest safe start is 2026-10-08 and memory-bom-decision's is 2026-10-13, so a dependency's deadline fell after its dependent's. That reasoning was correct about the DATES and wrong about the DIRECTION, and the rank invariant said so - dep_rank_ok requires a dependency to carry a strictly smaller rank, memory-bom-decision is 40 against this item's 10, and plan_graph_sound went FALSE. The inversion was not a limitation of latest_start_day; it was the signature of an edge running uphill. THE CORRECT RELATION IS THE ONE THIS ROW ALREADY ARGUES TWO SENTENCES EARLIER: this item does NOT gate on buying anything, it gates on the DECISION being derivable, and it is the ORDER that cannot be placed until the decision exists. So memory-bom-decision depends on this item, not the reverse, and 10 < 40 satisfies the rank rule with the ranks unchanged. The dates then agree instead of inverting - the decision at 2026-10-08 precedes the order at 2026-10-13 - which is what a correctly oriented edge looks like. THE OBSERVATION ABOUT latest_start_day SURVIVES ON ITS OWN and is kept because it is true and independent: it is computed per item as anchor minus duration and never reads depends_on, so it cannot detect a dependency whose deadline falls after its dependent's. That defect stands, unwitnessed, between fabric-m0 and storage-provider-accounts; it simply was not this row's problem. THE RECEIPT IS UNCHANGED AND IS THE POINT: measured link utilisation under a real job mix, because a switch that was bought is not a network that was characterised.",
  depends_on: no_deps,
  relates_to: ["strategy.compute_fabric_model", "strategy.ci_storage_tiering"],
  item_relations: [ProcurementBundledWith { of: "memory-bom-decision", why: "The NIC rides the same fleet-scale order; this item does not wait for that purchase and does not gate on buying anything." }],
  status: NotStarted,
}

data item_node_local_cache_drive: PlanItem = PlanItem {
  id: "node-local-cache-drive",
  workstream: Hardware,
  milestone: M1bInternalS0Proof,
  rank: 20,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: OperatorExclusive,
  exit_criterion: "REFRAMED 2026-09-10 (operator): DURABILITY AND SERVING COME FROM THE FABRIC; LOCAL SSD IS A CONSTRAINT-BALANCING QUESTION, NOT A DESIGN COMMITMENT. The launch does not depend on this purchase and the design must not either -- the fleet relies primarily on fabric storage, and the chassis takes M.2 later, so RETROFIT IS PRESERVED BY CONSTRUCTION and there is no deadline pressure to decide early. What changes the answer is evidence that does not exist yet: the per-node port speed settled by fleet-network-baseline (a 10G link and a 1G link imply different cache values for the same hit rate), and measured restore behaviour from real jobs rather than a projected full-rack workload. So this item is DEPENDENT rather than scheduled, and its honest state until those land is undecided-with-a-reason. The endurance arithmetic below stays as the SELECTION axis for the day a purchase is made; it is not an argument that one should be. ORIGINAL CRITERION FOLLOWS. WHETHER local storage is bought at all, decided on evidence rather than on a projected full-rack workload - this item is NOT an instruction to populate the M.2. The launch is a bounded design-partner rollout on the machines available, and compute-node drives are not required to serve it; compute_fabric_model already selects RamRoot with local NVMe as disposable scratch only, and its diskless_promotion_gate governs the question. If drives are bought the layer cache, package cache and runner images are local I/O rather than wire traffic. Endurance is the selection axis and it is DERIVED, not a preference: at 2.1 GB/s of fleet restore over 21 nodes each node writes 8.64 TB/day into cache at a zero hit rate, 1.73 TB/day at eighty percent - which on a 2 TB drive is 4.32 and 0.86 drive-writes per day against roughly 1 DWPD for a used enterprise M.2 and roughly 0.3 for consumer TLC. Consumer drives are therefore ruled out by arithmetic rather than by taste, and even enterprise parts only survive if the hit rate is high, which makes drive endurance a SECOND consumer of the cache-hit-floor measurement rather than an independent choice. Swap deserves an explicit decision rather than a default - with 256 GB per node swapping a CI job is a performance failure, not a safety net. The front 2.5 inch bays are a later option and need the backplane established first, since configurations differ between SATA and U.2. PRICE THE ALTERNATIVES AGAINST EACH OTHER BEFORE COMMITTING: this fleet-wide drive purchase is comparable to or larger than the 20-card 10 gigabit retrofit it is preferred over, so the case for it is architectural - it removes the traffic rather than widening the pipe, and it is the same drive the cache would need anyway - and not that it is cheaper. A cost claim in either direction must be re-derived from quotes rather than carried from this row.",
  depends_on: [dep(id: "fleet-network-baseline")],
  relates_to: ["strategy.ci_storage_tiering", "strategy.ci_node_build", "strategy.compute_fabric_model"],
  item_relations: [ConsumesMeasurement { of: "cache-hit-floor", why: "Drive endurance is a second consumer of the cache-hit-floor measurement rather than an independent choice. cache-hit-floor already depends on this item, so the reverse dep() would cycle." }],
  status: NotStarted,
}

data item_cache_hit_floor: PlanItem = PlanItem {
  id: "cache-hit-floor",
  workstream: OpsMachineHealth,
  milestone: M2bPrivateCohort,
  rank: 30,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "The REQUIRED local cache hit rate derived from the link, and the ACHIEVABLE rate measured against the isolation posture actually shipped - two different numbers whose gap decides whether the 1 GbE fleet works. THE PERCENTAGES BELONG TO ONE WORKLOAD ENVELOPE AND ARE NOT INHERENT TO RUNNING CI ON 1 GbE: at 315 concurrent jobs across twenty workers the peak demands roughly 64 percent local hits on one port and 29 percent bonded, but a bounded design-partner concurrency fits 1 GbE with NO cache benefit at all - four workers at twenty concurrent jobs is about 0.8 Gbps per worker at the modelled peak. So the launch answer is measured bounded concurrency, and the cache floor is what governs GROWTH beyond it rather than what makes the fleet work at all. Distributing jobs across idle workers spreads concurrent transfers and does NOT shorten any single transfer - a 2 GB restore has a serialization floor near 18 seconds at 0.9 Gbps however many workers are idle - and it does not enlarge a shared uplink or cache-server link. The threat is that multi-tenant isolation forces ephemeral per-job runners, destroying the cache every job and driving the achievable rate toward zero. Diskless is not the same as cacheless and a populated M.2 changes the answer again, so this measurement is what closes the network question rather than any projection. Both percentages rest on planning constants and a 20-node assumption and are superseded by the measurement, never cited beside it.",
  depends_on: [dep(id: "netboot-gap-analysis"), dep(id: "fleet-network-baseline"), dep(id: "node-local-cache-drive")],
  relates_to: ["strategy.ci_storage_tiering", "strategy.compliance_posture"],
  item_relations: no_item_relations,
  status: NotStarted,
}


data item_cache_tier_fabric: PlanItem = PlanItem {
  id: "cache-tier-fabric",
  workstream: StorageFabric,
  milestone: M2bPrivateCohort,
  rank: 40,
  min_calendar_days: 21,
  active_effort_days: 21,
  execution_mode: AgentParallel,
  exit_criterion: "RECUT 2026-09-19 FROM DESIGN TO OPERATION. The previous exit was 'designed and its boundaries settled', which is an exit a document satisfies; a settled design that never carries a job leaves the retrofit it exists to avoid exactly where it was. THE EXIT IS NOW: TIERS ONE AND TWO CARRY REAL JOB TRAFFIC WITH A MEASURED HIT RATE AT EACH TIER AND WRITE-THROUGH TO TIER THREE OBSERVED, and the two boundaries below are settled AND ENFORCED rather than settled and written down -- in particular the tenancy boundary has a DISCRIMINATING RED: an untrusted job's write must be REFUSED admission to the population a privileged job reads, and the refusal must be observed. That wall has no authority today: a search of dag/ finds no tenant scope on any CAS key, and gunbc.product.fabric.identity FabricIdentity<P, K> parameterises a principal that no row binds to a customer org. The design content that follows is retained because it is the argument, not the exit. The three-tier content-addressed cache, and why both hard parts are hard to retrofit. Tier one is a digest-keyed read-only store in node RAM surviving across ephemeral per-job guests - which is what makes the node hit rate achievable without giving any compute node a drive. Tier two is an S3-compatible store on the redundant infrastructure pair, taking every node miss so nothing reaches the internet on a job path, and absorbing artifact writes locally. Tier three is the durable origin bucket, written through from tier two and read only on a rack miss or cold start. One protocol at tiers two and three so a node image is indifferent to which it is talking to. TWO BOUNDARIES MUST BE SETTLED FIRST. Tenancy: public base layers may be shared globally because a digest is a digest, but a digest proves which bytes arrived and NOT who was entitled to them, so private layers and build outputs stay tenant-scoped and the node-RAM tier only ever holds the shared population - and an untrusted job must never populate a store a privileged job later trusts. Eviction: LRU by digest under a size cap is adequate, but a job must never observe a partially written object, so writes land whole under a temporary key and rename. S3 IS THE ORIGIN AND NOT THE HOT PATH: 16.8 Gbps of average fan-in is roughly 180 TB per day, which at metered egress is economically impossible and at zero-egress providers still crosses a site uplink that is smaller than the demand - so a tier-two miss rate near one is a business failure and not merely slow.",
  depends_on: [dep(id: "fabric-m0"), dep(id: "cache-hit-floor")],
  relates_to: ["strategy.compute_fabric_model", "strategy.ci_storage_tiering", "strategy.compliance_posture"],
  item_relations: no_item_relations,
  status: NotStarted,
}


data item_economics_regrounding: PlanItem = PlanItem {
  id: "economics-regrounding",
  workstream: EconomicsQa,
  milestone: M2FirstExternal,
  rank: 60,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "strategy.ci_runner_economics, strategy.ci_spill_policy and strategy.ci_pricing_page RESOLVE AND EXECUTE. DISCHARGED 2026-09-13 on gunbc-private#113: they consume strategy.ci_compute_offer_catalog over public per-vendor homes (Hetzner/GitHub/Ubicloud) and strategy.node_rental for GCP/OCI listed hours; witness_ci_economics is Enforced (witnesses run 34764693502). Remaining KnownRed is node-build Pareto (witness_ci_economics_frontier), not a missing import. Public PR 8950 stays refused as a restoration path.",
  depends_on: no_deps,
  relates_to: ["strategy.ci_runner_economics", "strategy.ci_spill_policy", "strategy.ci_pricing_page"],
  item_relations: no_item_relations,
  status: Done {
    evidence: [
      MergedPullRequest {
        repo: "gunb-ai/gunbc-private",
        number: 113,
        merged_at: "2026-09-13T18:12:39Z",
        merge_commit_sha: "1af16d17aab86a6982f7a96b1afebbab89e2031d",
      },
    ],
    note: "The previous note here said the remainder was the operator merge of that PR; the merge had already happened, which is the transcribed-status rot this plan keeps catching in its own rows. strategy.ci_runner_economics, strategy.ci_spill_policy and strategy.ci_pricing_page resolve and execute over strategy.ci_compute_offer_catalog and strategy.node_rental; witness_ci_economics is Enforced, witnesses run 34764693502. RESIDUAL, carried because Done on this exit criterion is not green everywhere: witness_ci_economics_frontier stays KnownRed under a FOUR-BODY cause lock, and the four bodies are named individually because run 34763198395 proved UNDECLARED FAILURE when only two were declared. Its restoration trigger is per-vendor quoted RateQuoted homes for Scaleway, Blacksmith, Depot and CircleCI being SUFFICIENT FOR THE PARETO WITNESSES TO PASS - the trigger names that capability and not an artifact called ci_compute_pricing, because a trigger naming less than the capability it restores is satisfied while the capability stays dead. Public PR 8950 and the ci_compute_pricing hub stay refused as a restoration path. Also open and not this item: Scaleway EUR with no FX path, and Int micro algebra that is not yet MoneyPerMinute.",
  },
}


// ---------------------------------------------------------------------------------------------
// Bringing a second person onto the project
// ---------------------------------------------------------------------------------------------
//
// A CANDIDATE CONTRIBUTOR APPROACHED THE OPERATOR ON 2026-09-10 and the engagement is intended:
// paid, part-time, bounded term, for someone seeking their first software engineering role. These
// five items are NOT about that person. They are the obligations a SECOND PARTICIPANT creates, and
// they would be owed for anyone.
//
// THE OPERATOR'S OWN FRAMING IS THE REASON THEY ARE PLAN ITEMS RATHER THAN A CHECKLIST: the systems
// gaps this exposes are worth the engagement cost on their own. Every one of these obligations is a
// place where the project currently depends on one person's memory, and paying someone is what
// forces the memory into a system. That is a resilience purchase, and it is severable from whether
// any particular contributor works out.
//
// A NEW WORKSTREAM WAS ADDED FOR THEM. The seven existing workstreams are all things the operator
// DOES; none is a home for who does it. Forcing these under SecurityCompliance or EconomicsQa would
// put access control and payroll in the same box as customer compliance and pricing, which is the
// §3 fork this plan keeps out of the item rows. PeopleAndProcess is the eighth, and it is the one
// whose whole purpose is to REDUCE the single-operator dependency the plan's own analyst correction
// names -- seven workstreams are not seven parallel lanes for one person, and the answer to that is
// either fewer workstreams or more people.

data item_contributor_engagement_terms: PlanItem = PlanItem {
  id: "contributor-engagement-terms",
  workstream: PeopleAndProcess,
  milestone: M1InternalVertical,
  rank: 10,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: OperatorExclusive,
  exit_criterion: "One written engagement before any work is performed, carrying: scope, hourly rate, a WEEKLY HOURS CAP, a fixed term with a review date, confidentiality, and an explicit IP assignment. CLASSIFICATION IS PART OF THE EXIT, not an afterthought: an unpaid or nominally-paid internship at a for-profit is governed by a legal test this engagement would not pass, so the engagement is a CONTRACTOR one at an hourly rate, and the classification is stated in the document rather than implied by how payment happens. THE IP TERM NEEDS ACTUAL THOUGHT AND IS THE ONE MOST LIKELY TO BE SKIPPED: contributions to the public repository are made under its license, while anything touching the private overlay, the strategy corpus or customer material is not, and a single assignment clause that does not distinguish them either over-claims the open-source contributions or under-claims the private ones. THE BINDING CONSTRAINT IS NOT THIS MILESTONE: it is the contributor's first working day, whenever that is agreed. latest_start_day here is computed from the anchor like every other item and will therefore UNDERSTATE the urgency - read the start date, not the derived date.",
  depends_on: no_deps,
  relates_to: ["strategy.compliance_posture"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_contributor_access_provisioning: PlanItem = PlanItem {
  id: "contributor-access-provisioning",
  workstream: PeopleAndProcess,
  milestone: M1InternalVertical,
  rank: 20,
  min_calendar_days: 2,
  active_effort_days: 2,
  execution_mode: OperatorExclusive,
  exit_criterion: "A second principal exists in the access model, and what they may reach is DECLARED rather than defaulted. Public repository: contributor access. PRIVATE OVERLAY: NO ACCESS, and this is the one that must be checked rather than assumed - gunbc-private carries strategy, pricing, personal and entity finance, and the operator's own bank and card records, none of which an engagement of this kind should reach. Fleet hosts, BMC credentials, cloud secrets and the fleet secrets project: no access. THE OFFBOARDING PATH IS PART OF THIS ITEM AND NOT A LATER ONE, because access granted with no modeled revocation is a permanent grant that nobody wrote down: what is revoked, by whom, and how it is verified revoked. Joins gunbc.fleet_posix_accounts and the org-actions credential model, which already carry the vocabulary for who may perform what.",
  depends_on: [dep(id: "contributor-engagement-terms")],
  relates_to: ["strategy.compliance_posture"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_contributor_payment_path: PlanItem = PlanItem {
  id: "contributor-payment-path",
  workstream: PeopleAndProcess,
  milestone: M1InternalVertical,
  rank: 30,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: OperatorExclusive,
  exit_criterion: "An invoice-to-payment-to-record path that runs monthly without being reinvented: how hours are reported, how the invoice arrives, which account pays, and where the expense lands in the company's books. THE CARRIER NOW EXISTS: finance.gunbai_ledger is the entity double-entry book. What this item still owes is a RECURRING posting path onto that book. A one-off equipment purchase can sit as a single transaction; a monthly obligation to a second person cannot, because every month adds an entry and the gap compounds instead of waiting. Sizing, so the runway consequence is legible rather than discovered: 10 hours a week at a modest rate is roughly 1,000 a month and 13,000 a year; 20 hours is double that. strategy.year_end_plan runway-ceiling-review already records that the tax-efficient drawdown rate and personal burn are close enough that colo cannot be funded from personal capital without shortening runway materially, so this is not a rounding error against that number and the hours cap is the lever.",
  depends_on: [dep(id: "contributor-engagement-terms")],
  relates_to: ["strategy.compliance_posture", "finance.gunbai_ledger"],
  item_relations: [ConstrainedByFinding { of: "runway-ceiling-review", why: "That item already records that tax-efficient drawdown and personal burn are close enough colo cannot be funded from personal capital; contributor hours are not a rounding error against that number." }],
  status: NotStarted,
}

data item_contributor_onboarding_path: PlanItem = PlanItem {
  id: "contributor-onboarding-path",
  workstream: PeopleAndProcess,
  milestone: M1bInternalS0Proof,
  rank: 40,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "A NEW ENGINEER CAN CLONE, BUILD, RUN THE WITNESSES AND LAND ONE REVIEWED CHANGE WITHOUT THE OPERATOR IN THE LOOP. That is the whole exit and it is deliberately measured by an outcome rather than by the existence of a document. THIS IS THE ITEM WORTH THE MONEY EVEN IF NOBODY IS HIRED: it is the bus-factor test, and today the project would fail it. The known obstacles are not guesses - they were each observed in the last day. DESIGN.md is loaded in full every session and is not a first-day document. The .dag substrate is unlike anything a new engineer has used. A local gunbc build is required before anything runs, and an OLD locally-installed gunbc silently parses things CI refuses, which is how a lane shipped a break to main. The private overlay composes through an extra source root whose rules were undiscovered until they broke CI for two days. Every one of those is a thing the operator currently knows and nothing else does. VALIDATION IS BY EXECUTION, not by review: someone who has not seen the repository follows the path and either reaches a merged change or names where it stopped.",
  depends_on: no_deps,
  relates_to: ["strategy.gunbc_strategy"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_contractor_tax_reporting: PlanItem = PlanItem {
  id: "contractor-tax-reporting",
  workstream: PeopleAndProcess,
  milestone: M4JanuaryLaunch,
  rank: 50,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: OperatorExclusive,
  exit_criterion: "Form 1099-NEC issued to the contractor and filed, IF total 2026 payments reach the reporting threshold. Requires a W-9 collected AT ENGAGEMENT rather than chased in January, which is why this item's real first action belongs to contributor-engagement-terms and not to the milestone this row sits under. THE DEADLINE IS OUTSIDE THIS PLAN'S HORIZON AND THE ROW SAYS SO RATHER THAN PRETENDING OTHERWISE: 1099-NEC is due 2027-01-31, which is day 155 on the plan epoch, TWENTY-FOUR DAYS PAST M4JanuaryLaunch at day 131. This plan has no anchor beyond M4, so the item is filed at the last one and its derived dates are WRONG IN THE SAFE DIRECTION - earlier than the true obligation. That gap is a finding about the plan rather than about the filing: a plan whose horizon ends before its own obligations do will silently drop everything past the edge, and this is the first item to fall off it.",
  depends_on: [dep(id: "contributor-payment-path")],
  relates_to: ["strategy.compliance_posture"],
  item_relations: [FirstActionLivesOn { of: "contributor-engagement-terms", why: "The W-9 must be collected at engagement, so this item's first action belongs there rather than under the January milestone this row sits in. Not blocking: the 1099 itself is after M4." }],
  status: NotStarted,
}

// ---------------------------------------------------------------------------------------------
// THE WHOLESALE PATH, AS ITS OWN CHAIN (audit folded 2026-09-14). The S1 gate is the CI product's
// gate and stays untouched; a 20-node block operated under a reseller has a different closing
// transaction - a signed site, a turned-up rack, a buyer boundary, an acceptance suite - and none
// of those was owned by any item. quote is not site readiness; a signed contract is not a rack.
// ---------------------------------------------------------------------------------------------

data item_wholesale_requirements_discovery: PlanItem = PlanItem {
  id: "wholesale-requirements-discovery",
  workstream: AcquisitionMarketing,
  milestone: M2FirstExternal,
  rank: 30,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: ExternalLead,
  exit_criterion: "At least three CI providers that resell arm64 capacity contacted (Ubicloud first, Blacksmith, one peer such as Depot) with the discovery message in strategy.wholesale_batch_floor; each returns a named technical owner and a requirements profile - service boundary (raw metal / managed host / installed agent), RAM and speed, local storage and endurance, host NIC and aggregate transit, IP and BGP, OOB and reinstall access, minimum volume and ramp, maintenance and replacement expectation, onboarding and security process, target term and economic range - or an explicit no. NOT owed: a price. This item does not wait on fleet-capacity-floor; it exists so the BOM is frozen on what buyers require rather than on what we guessed.",
  depends_on: [dep(id: "wholesale-argument-grounding")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.wholesale_buyer", "strategy.b2b_capacity_track"],
  item_relations: no_item_relations,
  status: InProgress { note: "Ubicloud sent 2026-09-15 by the operator (info@ubicloud.com, subject 'Gunbai x Ubicloud': the company, ~20 dual-socket Q80-30, 3,200 cores, ~10 TiB, early 2027, cost and energy efficiency, alignment, an open offer to collaborate at any layer; no price, unit or boundary). Blacksmith and one peer not yet sent (owner_action wholesale-discovery-dispatch-others). First check 2026-09-22; if silent, a founder by name." },
}

data item_wholesale_service_boundary: PlanItem = PlanItem {
  id: "wholesale-service-boundary",
  workstream: AcquisitionMarketing,
  milestone: M2FirstExternal,
  rank: 40,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: OperatorExclusive,
  exit_criterion: "Exactly one of raw bare metal, managed substrate or managed fabric capacity (the buyer consumes a logical capacity envelope; GUNBAI owns placement) selected per candidate buyer (operator ruling 2026-09-14: decided per buyer after discovery, not assumed). THE INFRASTRUCTURE REALIZATION FOLLOWS FROM THE BOUNDARY AND MUST BE NAMED WITH IT: under raw bare metal the buyer brings its own boot and cache plane and no GUNBAI infrastructure pair is consumed from the 21; under a managed substrate the durable origin is Cloudflare R2 (operator, 2026-09-14 - the M0 origin is R2 only per fabric-m0), and WHETHER ANY CACHE EXISTS IS NOT DECIDED HERE (review repair 2026-09-14, P2): the all-cloud-R2 refusal in strategy.ci_storage_tiering is a direct-CI full-rack projection, not a wholesale law; cache absence, a RAM cache, node disk or a rack service is selected per buyer by wholesale-network-decision on wholesale-network-cache-experiment's receipts. BOOTSTRAP IS SEPARATE FROM CACHE AND NEVER NEEDS R2 ON THE BOOT PATH: gunbc.boot_artifact_delivery delivers the image by BMC virtual media, UEFI HTTP or PXE from a staging host on the management network (gateway, management box, or an already-booted peer). fleet_decisions infrastructure-pair is Deferred to wholesale-origin-boot-cache-realization; wholesale_batch_floor carries the realizations as arms and reports billable capacity under each; the 20-node offer is honest only under the arms that consume zero fleet nodes.",
  depends_on: [dep(id: "wholesale-requirements-discovery")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.ci_storage_tiering", "strategy.procurement_order"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_bom_capacity_freeze: PlanItem = PlanItem {
  id: "wholesale-bom-capacity-freeze",
  workstream: Hardware,
  milestone: M3YearEndGate,
  rank: 50,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: OperatorExclusive,
  exit_criterion: "Exact dedicated-node, failover-pool and infrastructure-node counts with no node counted in two commercial roles (allocation-model ruling 2026-09-14: sixteen dedicated, four pooled, of twenty deployed; the held unit is the replacement chassis); the standard buyer-facing node stated as inclusions (leaf link per wholesale-network-decision - onboard 1 GbE unless a buyer or measurement elects 10G, in which case cards for all twenty deployed hosts because the failover pool must match the block; DDR4 32 GiB RDIMM population, ECC, private OOB never on the public block, local disk included or excluded); RAM quoted as 336 installed + 16 cold-spare DDR4 modules with part number, rank, speed, serialized test report and DOA window; strategy.procurement_order projected from the network and origin/boot/cache decisions rather than from the 2026-09-04 bonded-1G-plus-pair shape - the data switch derives from the selected topology, link speed and redundancy stay independent (one data switch is a rack-wide failure domain whatever its speed), the BMC network stays isolated; edge (router/firewall/VPN/BMC broker) named as facility-, buyer- or GUNBAI-owned; no DPU. Nothing fleet-scale is ordered before this exits.",
  depends_on: [dep(id: "wholesale-service-boundary"), dep(id: "memory-bom-decision"), dep(id: "fleet-network-baseline"), dep(id: "wholesale-network-decision"), dep(id: "wholesale-origin-boot-cache-realization")],
  relates_to: ["strategy.procurement_order", "strategy.wholesale_batch_floor", "strategy.ci_node_build", "strategy.fleet_decisions"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_colo_contract_execution: PlanItem = PlanItem {
  id: "colo-contract-execution",
  workstream: Hardware,
  milestone: M5Q2ColoDeployment,
  rank: 55,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: OperatorExclusive,
  exit_criterion: "The selected facility's contract SIGNED, deposit paid, certificate of insurance delivered and accepted, occupancy date and carrier/cross-connect order dates fixed in writing, MRC start date and the 16 kW commit (A and B each independently capable) stated on the order form. colo-vendor-selection exits with a signable contract in hand; this is the signature, and nothing before it is a site. REVIEW 2026-09-14 (finance): signed only after first-rack-capital-admission admits the first rack's cash - the irreversible site spend follows the buyer's money and the reconciliation, never a plan.",
  depends_on: [dep(id: "siting-decision"), dep(id: "first-rack-capital-admission")],
  relates_to: ["strategy.colo_market", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_colo_turnup_rack_acceptance: PlanItem = PlanItem {
  id: "colo-turnup-rack-acceptance",
  workstream: Hardware,
  milestone: M5Q2ColoDeployment,
  rank: 60,
  min_calendar_days: 28,
  active_effort_days: 14,
  execution_mode: OperatorExclusive,
  exit_criterion: "Cabinet occupied: A and B feeds and metered PDUs installed and a feed-failure test passed with the full load on one side; edge and transit turned up with the /29 routed; private OOB path to every BMC exercised through the gateway; rack build (rails, cabling, labeling, blanking) photographed as-built; the remote-hands runbook executed once by the facility's hands; server delivery, dock, DOA window and asset tagging receipted. Distinct from node burn-in and from colo selection. CALENDAR FLOOR 28 DAYS (Netrality, by phone 2026-09-14: about four weeks from an installation contract to space; wholesale_batch_floor stated_lead_time_floor_days): the effort is two weeks, the wait for the facility is not, and the two figures are declared apart.",
  depends_on: [dep(id: "colo-contract-execution"), dep(id: "node-burnin-protocol"), dep(id: "fleet-network-baseline")],
  relates_to: ["strategy.rack_power_engineering", "strategy.procurement_order", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_wholesale_provider_integration: PlanItem = PlanItem {
  id: "wholesale-provider-integration",
  workstream: RunnerSoftware,
  milestone: M4JanuaryLaunch,
  rank: 70,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: ExternalLead,
  exit_criterion: "The buyer's image, agent or API exercised on at least one node under the selected boundary: node lifecycle (provision, reinstall, drain, power-cycle), credential issue and revocation, telemetry heartbeat, and the replacement path - how a swapped node inherits network identity, host certificate, scheduler identity and agent enrollment - all executed, not described. Without this, swap-within-N-hours is not a promise anyone can keep.",
  depends_on: [dep(id: "wholesale-offer-acceptance")],
  relates_to: ["strategy.wholesale_batch_floor", "strategy.b2b_capacity_track"],
  item_relations: no_item_relations,
  status: NotStarted,
