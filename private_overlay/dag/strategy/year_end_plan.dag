data item_first_external: PlanItem = PlanItem {
  id: "first-external-customer",
  workstream: AcquisitionMarketing,
  milestone: M2FirstExternal,
  rank: 50,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: ExternalLead,
  exit_criterion: "One trusted design partner runs a real workload under the paperwork, credit, support and tenant-boundary controls; migration hand-done and TIMED; their receipts flow into the same S0 instruments as dogfood. Onboarding may be assisted.",
  depends_on: [
    dep(id: "dogfood-window"),
    dep(id: "tenant-boundary-minimum"),
    CompletionRequires {
      of: "m2-compliance-admission",
      why: "THE ONE EDGE THAT MAY NEVER BE RELAXED. First external job permitted ONLY IF THE ADMISSION GATE IS CONSTRUCTIBLE FROM THOSE FROZEN VERSIONS, and THE BINDING EVENT IS EXECUTION, NOT PAYMENT. Starting the customer before the revisions are frozen is exactly the just-for-the-pilot bypass the admission spine's fourth discriminating red exists to prevent.",
    },
    dep(id: "customer-authorizations"),
    dep(id: "billing-receipts"),
    dep(id: "support-abuse"),
    dep(id: "docs-dry-run"),
    dep(id: "cohort-qualified"),
    dep(id: "external-app-install-rehearsal"),
    dep(id: "acquisition-instrumented"),
    CompletionRequires { of: "customer-identity-access", why: "The customer is EXTERNAL, which is the one word that makes this different from dogfood: they reach the product through a browser the operator does not control, so the server has to decide who they are and what they may touch. Assisted onboarding may smooth the journey and may not substitute for the authorization." },
    CompletionRequires { of: "production-release-identity", why: "A first external customer requires a public HTTPS callback GitHub can reach, and a promotion that does not kill their running job. Both are that item and neither exists today." },
  ],
  relates_to: ["strategy.ci_acquisition"],
  item_relations: no_item_relations,
  status: NotStarted,
}

