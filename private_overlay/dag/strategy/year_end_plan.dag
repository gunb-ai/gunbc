}

data item_billing_receipts: PlanItem = PlanItem {
  id: "billing-receipts",
  workstream: RunnerSoftware,
  milestone: M2FirstExternal,
  rank: 20,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "PRICED FROM THE FIRST JOB (analyst hybrid, consistent with the operator's coupon ruling): metered usage x real founding price = gross charge; THE METERING HALF IS THE UNSTATED PREREQUISITE AND IS NAMED HERE 2026-09-19: gunbc.runner.runner_usage_receipt models the basis correctly -- allocated vCPUs times monotonic launch-to-reap duration, explicitly excluding price, credit, rounding and invoice, which is the right layer -- and ITS CHAIN IS ROOTED IN A WITNESS TEST RATHER THAN IN A JOB: it is imported by gunbc.runner.runner_teardown_receipt, whose own only importer is test.claim.runner.runner_canary_receipt_witness_test. Nothing on an executing route measures a job. CORRECTED 2026-09-19 from 'HAS NO IMPORTER ANYWHERE', a claim produced by grepping a module path that does not exist. So this item begins by giving TEARDOWN a production consumer on the attempt path and emitting one metering row for a real job; everything below is downstream of that and cannot be started without it. Price, credit and invoice have no authority in either repository today; promotional credit (finite amount, expiry, per-org concurrency cap, no silent renewal) applied on the invoice; net due may be $0 but the invoice shows what the customer would owe. Proves metering, price application, credit accounting and invoice generation at once. JobInitiatorClass captured.",
  depends_on: [dep(id: "runner-canary")],
  relates_to: ["strategy.ci_runner_economics"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_failure_billing: PlanItem = PlanItem {
  id: "failure-billing-semantics",
  workstream: RunnerSoftware,
  milestone: M2FirstExternal,
  rank: 30,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: AgentParallel,
  exit_criterion: "Typed dispositions for every non-success: cancellation, timeout, runner disappearance, failed durable commit, queue refusal - each auto-unbilled or credited per declared policy, no silent widening. Billing and the failure ledger must agree exactly.",
  depends_on: [dep(id: "billing-receipts")],
  relates_to: ["strategy.ci_runner_economics"],
  item_relations: no_item_relations,
  status: NotStarted,
}

