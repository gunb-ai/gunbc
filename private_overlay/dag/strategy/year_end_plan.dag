  depends_on: [dep(id: "hw-first-host"), dep(id: "fleet-capacity-floor")],
  relates_to: ["strategy.fleet_qualification", "strategy.mobo_x_memory_census"],
  item_relations: no_item_relations,
  status: NotStarted,
}

