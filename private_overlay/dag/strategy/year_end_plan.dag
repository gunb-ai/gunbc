}

// PAPERWORK-MIN SPLIT (operator approval 2026-09-07; amended twice the same day).
// The row asserted one fact that is really fourteen, and each amendment removed a wrong premise.
// FIRST: ExternalLead + no_deps + 21 days said counsel AUTHORS the package, so the compliance
// surface inherited an external queue as its critical path. Counsel is a BOUNDED ADVERSARIAL
// SENSOR - the authorities are the statutes, agency interpretations, network rules and the signed
// agreement - so there is no CounselApproved, LegallyCompliant or EnumerationComplete standing to
// reach, and spend is gated rather than pre-authorized.
//
// SECOND, and the deeper one: the work was still producing a REGISTER AND A LAWYER PACKET when
// what it owes is a PROVIDER-USE PERMIT THE FABRIC CANNOT ROUTE AROUND. The register already
// claims region-as-admission covers object storage, logs, telemetry, backups, support access and
// spill; the code that actually places work admits on architecture, dedication, interruption and
// price, and cannot CONSTRUCT a jurisdiction refusal at all. Two authorities answer "may this job
// run here" and the deciding one has no compliance term - so the claim is prose over an unenforced
// path, and no amount of applicability modeling fixes it.
//
// The admitted subject is a ROUTE, never a company: provider x service x region x data-path
// closure x contract revision. "Hetzner is compliant" is not a fact; the same provider is
// admissible in one region and not another, for build source and not ePHI, before a subprocessor
// change and not after. Authority direction is fixed: provider modules never import our posture -
// a third module joins provider facts, active posture revision and the exact use scope, exactly as
// gunbc.fabric_executor_class lets no supplier declare what it is sanctioned to serve.
//
// Three budget questions stay separate. May this work use this route is a PERMIT, not money, and
// a cheap offer must never buy through a missing authority. Should we fund enabling a route is a
// real appropriation carrying cash, operator time and latency on separate axes. Can this job
// afford this offer is the existing demand-side budget. Funding an enablement item must never
// itself mint a runtime permit.
//
// Support is DERIVED, not declared: the intent is maximal lawful global support, and the current
// supported surface is the union of scopes for which some route can produce a permit under the
// active posture. Dates live on enablement items, never on a permit - support is a present fact
// and a forecast is a plan.
data item_counsel_market_census: PlanItem = PlanItem {
  id: "counsel-market-census",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 2,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: ExternalLead,
  exit_criterion: "ZERO EXTERNAL SPEND AND NO SUBSTANTIVE WORK AUTHORIZED. Three comparable responses, each carrying the individual reviewer rather than the firm, relevant experience, phase rates and hour caps, availability, whether they ACCEPT THE DELIVERABLE SHAPE, excluded specialties and conflicts standing. The discriminating question is whether their work JOINS our model and returns deltas, never whether they can sample the answer free on the call. Counsel questions are EMITTED FROM UNRESOLVED PROVIDER ENABLEMENT OBLIGATIONS - a bounded external interpretation is one owner arm among internal construction and provider evidence, never the owner of the onboarding program.",
  depends_on: no_deps,
  relates_to: ["strategy.compliance_posture", "finance.gunbai_llc"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_m2_contract_standard: PlanItem = PlanItem {
  id: "m2-contract-standard",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 2,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: AgentParallel,
  exit_criterion: "ONE pinned external contract authority as a versioned extdep, because warranty, indemnity, IP, confidentiality, payment, liability, dispute and termination terms DO NOT DERIVE from a compliance model. Leading candidate Common Paper Cloud Service Agreement v2.1 - verified 2026-09-07 as current: CC BY 4.0, cover page plus incorporated standard terms, explicit pilot support, versions immutable once posted. Bonterms Cloud Terms is the credible alternative; PIN EXACTLY ONE.",
  depends_on: no_deps,
  relates_to: ["strategy.compliance_posture", "strategy.ci_product_surface"],
  item_relations: no_item_relations,
  status: Done {
    evidence: [
      MergedPullRequest {
        repo: "gunb-ai/gunbc",
        number: 11186,
        merged_at: "2026-09-13T02:18:20Z",
        merge_commit_sha: "c19edeb7e500cdfc0ee67a1e86b33147dfde652e",
      },
    ],
    note: "Common Paper Cloud Service Agreement Standard Terms v2.1 pinned as a versioned extdep with four dated read receipts carrying HTTP status, byte count and sha256; Bonterms Cloud Terms v1.0 cited as its OWN upstream module rather than a row inside Common Paper; three discriminators stated for why Common Paper wins. CONSUMED BY EXECUTION rather than declared - RouteScopeSanction.requires_agreement with a RequiredAgreementAuthorityAbsent red whose accepted list is exactly the pinned ref, plus a must-fail control. No commercial position is chosen: every Cover Page variable is deliberately unmodeled. The keeper from the comparison, because it is a live commercial fact and not a modeling note: under Bonterms this project would have INHERITED a US dollar 1,000 pilot liability cap and a no-warranty, no-indemnity, no-SLA position as a silent standard-term default nobody chose, while Common Paper forces that same position onto a Cover Page where it is visible as a decision.",
  }
}

data item_m2_launch_intent: PlanItem = PlanItem {
  id: "m2-launch-intent",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 2,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: OperatorExclusive,
  exit_criterion: "REPLACES THE US-ONLY LAUNCH PROFILE, which hardcoded a constant where the corpus already had a parameter - region-as-admission and per-customer regional placement both predate this plan. Declares MAXIMAL LAWFUL GLOBAL SUPPORT as the terminal intent plus the ACTIVE POSTURE REVISION as a content hash, and declares NOTHING about currently supported geography, which is derived from the admitted route population rather than asserted here. Jurisdictions are open declaration references, never a central US or EU or Asia enum, so adding Germany is a row and not an edit to a kernel. Named operator-approved organizations only with public self-service disabled; founding credit with no card collected; the authorities with no producer enumerated.",
  depends_on: no_deps,
  relates_to: ["strategy.compliance_posture", "strategy.ci_alpha"],
  item_relations: no_item_relations,
  status: InProgress { note: "The operator ruling of 2026-09-12 ~22:40Z, carried by strategy.compliance_posture_revision m2_posture_ruling, supplies this item's operator-exclusive content. THIS ROW'S READING OF IT, which is a reading and not the operator's words - those live at the carrier and are not restated here: seek ALL compliance regardless as soon as possible, no hard rules on geography, err toward US customers without being able to choose the market. This row already says the right thing and needed only its provenance - maximal lawful global support as the TERMINAL intent, plus the active posture revision as a content hash, and it declares NOTHING about currently supported geography, which stays DERIVED from the admitted route population. The ruling does not change that derivation and must not be read as declaring a geography." },
}

data item_provider_route_census: PlanItem = PlanItem {
  id: "provider-route-census",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 4,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: AgentParallel,
  exit_criterion: "PREDECESSOR TO ANY CLAIM ABOUT SUPPORTED GEOGRAPHY. One row per provider x service x region, each answering the FULL data-path closure - execution, durable storage, backups, logs, telemetry, control plane, support access, administrative access and spill - plus downstream provider population and the exact contract and provider-term revisions. A vendor region label establishes none of these: a Helsinki VM whose backups, telemetry or administrators sit elsewhere is not a Helsinki-contained path. Every path arm distinguishes LOCATED from ABSENT from UNREAD, because an empty backup list must never conflate backups-disabled with nobody-looked - the discipline the Ubicloud binding already keeps by carrying IsolationNotObserved rather than inventing from a price list. Hetzner is already modeled in catalog, pricing and procurement; what is missing is its supplier-route realization.",
  depends_on: [StartAfterStart {
    of: "m2-launch-intent",
    lag_days: 3,
    consumed_artifact: "the ACTIVE POSTURE REVISION as a content hash, which every census row names as the revision it was read under",
    why: "m2-launch-intent DECLARES NOTHING ABOUT CURRENTLY SUPPORTED GEOGRAPHY, WHICH IS DERIVED FROM THE ADMITTED ROUTE POPULATION RATHER THAN ASSERTED HERE - its own words. So the census is not waiting on that item's content; it is waiting for a revision identity to exist to pin rows against, which is minted early in the item rather than at its end. The three days are a proposal about when the hash exists, not a measurement.",
  }],
  relates_to: ["strategy.compliance_posture", "strategy.compute_fabric_model"],
  item_relations: no_item_relations,
  status: InProgress { note: "gunbc#11188 open at the approval floor as of 2026-09-13. Hetzner hel1 and nbg1 censused over the full nine-path closure; BOTH REFUSE, which is the census working rather than failing - upstream states a Helsinki server snapshot is placed in Nuremberg or Falkenstein, so durable storage on a Finnish route spans two jurisdictions while ProviderPathLocated carries one. Seven rows executed with both required reds. Not Done: the census population is two regions of one provider. WIND-DOWN, 2026-09-14: gunbc#11188 is MERGED, 2026-09-14T05:40:45Z as 1f41797e639490a4054e8a040397c0e6dd16b322 -- the sentence this replaces called it a PR at the floor, which was true when written and is not now. The exit criterion still is not discharged: a merged PR is not an executed population, and widening beyond hel1 and nbg1 is unstarted." }
}

data item_m2_applicability_model: PlanItem = PlanItem {
  id: "m2-applicability-model",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 4,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: AgentParallel,
  exit_criterion: "The register climbs off free strings: every source applied to VERSIONED launch facts carrying cited authority, the instrument's own trigger, our observed facts, standing and recheck condition as separate fields, each authority pinned with official representation, retrieval time, content hash, effective standing and trigger extract. The cleared arm dies - NotApplicable admitted a conclusion drawn from our INTENT rather than the instrument's trigger, the single root cause of all four prior misclassifications - and non-applicability must carry a NONEMPTY observed-fact list and a recheck condition or it does not typecheck. Joins strategy.compliance_posture to the extdeps.regulation instrument model already carrying lifecycle, provenance, temporal application and derived applicability.",
  depends_on: [dep(id: "m2-launch-intent")],
  relates_to: ["strategy.compliance_posture"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_m2_admission_spine: PlanItem = PlanItem {
  id: "m2-admission-spine",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 6,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: AgentParallel,
  exit_criterion: "THE SMALLEST EXECUTING REFUSAL, LANDED BEFORE THE FULL REGIME MODEL AND IN PARALLEL WITH IT. Four discriminating reds, executed rather than declared: a declared-ePHI job REFUSES because no producer of that handling authority exists; an unresolved classification HOLDS; a job with no admission receipt REFUSES; and A ZERO-DOLLAR NET INVOICE DOES NOT ALTER ADMISSION, the claim the canary makes concrete and the one most likely to erode into a just-for-the-pilot bypass.",
  depends_on: [
    StartAfterStart {
      of: "m2-launch-intent",
      lag_days: 3,
      consumed_artifact: "the same posture revision the census consumes",
      why: "The spine pins its refusals to a posture revision; it does not consume the rest of the intent.",
    },
    StartAfterStart {
      of: "provider-route-census",
      lag_days: 0,
      consumed_artifact: "nothing the census produces",
      why: "THE SMALLEST EXECUTING REFUSAL, LANDED BEFORE THE FULL REGIME MODEL AND IN PARALLEL WITH IT - this item's own first sentence, which authorises the parallelism rather than merely permitting it. Its four discriminating reds are about the ABSENCE of a handling authority and the ABSENCE of an admission receipt; not one of them reads a route fact. This is the only edge in the chain relaxed on the successor's own words rather than on a proposal about overlap.",
    },
  ],
  relates_to: ["strategy.compliance_posture", "strategy.ci_alpha"],
  item_relations: no_item_relations,
  status: InProgress { note: "THE NARROW LANDING IS COMPLETE AND THIS ROW IS DELIBERATELY NOT Done - read the second paragraph before concluding the work is outstanding. gunbc#11176 merged 2026-09-13T13:39:16Z as 4e1de737bce. THE FOUR REDS EXECUTE RATHER THAN MERELY ENROL, which is this item whole point and the claim most easily faked: CI run 34706214469 on 5227b45fc5 reports all twelve job_admission witnesses at standing planned-and-passed with disposition planned_as_changed_witness, blocking 0 and declined_in_declared_nonexecuting_root 0, inside a floor run of planned 3787 executed 3787 not_attempted 0. The fold preserves Hold, Refuse and Admit over FabricIdentity of P and WorkKey, requires a matching self-issued JobClassificationReceipt, refuses declared ePHI with no handling-authority producer, and takes no billing input. WHY IT IS NOT MARKED Done, stated rather than worked around: done_implies_deps_done reds when a Done item has a completion-binding dependency that is not Done, and edge_binds_completion excludes ONLY conditional edges - so this item two StartAfterStart edges, to m2-launch-intent and provider-route-census, both count as completion-binding and both targets are legitimately InProgress. Marking this Done would red the witness. A START edge binding COMPLETION is a conflation in that predicate rather than a fact about this item: A can start after B starts and still finish first. FILED HERE rather than resolved by widening the predicate, because changing a plan invariant to make one row green is the move that invariant exists to stop. ALSO NOT DISCHARGED, and independent of the above: there is NO production caller of admit_job - its only non-test occurrences are its own declaration, a decl_ref inside a frontier row, and two dissolution descriptions - and four capabilities remain census-enrolled as frontiers, namely an authenticated receipt issuer, the deployed runner calling admit_job before launch, a real metered-price and credit and net billing-carrier join, and a SCHEDULED PERMANENT source-mutation consumer. The one-off zero-net bypass experiment failed the other-job-receipt assertion while the paid missing-receipt case passed, proving the mutation authorable and explicitly NOT permanent coverage. A classification receipt must not be read as authenticated authorization, and money stays outside admission." },
}

data item_provider_route_admission: PlanItem = PlanItem {
  id: "provider-route-admission",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 8,
  min_calendar_days: 4,
  active_effort_days: 4,
  execution_mode: AgentParallel,
  exit_criterion: "THE EXECUTABLE JOIN, AND THE CENTRE OF THE COMPLIANCE PROGRAM: active posture revision x exact demand and work and customer and data scope x provider route and its data-path closure -> a SEALED PERMIT naming demand, work, offer, route, posture revision, route-facts revision, customer profile revision and agreement revision. Refusals are typed and constructible - route unclassified, route facts incomplete, posture revision stale, customer scope unsupported, data handling unsupported, required agreement authority absent, transfer or location unresolved, downstream provider unassessed, access path unsupported - SEVEN OF WHICH ALREADY EXIST ON MAIN, corrected 2026-09-12 against gunbc.product.fabric.provider_admission ProviderUseRefusal, which carries THIRTEEN constructible arms as of 2026-09-14: ProviderRouteUnclassified, ProviderRouteFactsIncomplete, DownstreamProviderUnassessed, PostureRevisionStale, CustomerScopeUnsupported, DataHandlingUnsupported, RequiredAgreementAuthorityAbsent, plus three this criterion never named at all - ProhibitedUseNotCleared, SanctionsNotCleared, ExportNotCleared - plus three gunbc#11194 added after this sentence was written and which it likewise never named: PostureJurisdictionsUnread, TransferOrLocationUnresolved, ProviderAccessPathUnsupported. THE COUNT HERE SAID TEN AND WAS RIGHT WHEN WRITTEN; it is corrected rather than deleted because the correspondence it draws between this item's named refusals and the type's arms is the load-bearing part, and the arm list in gunbc.product.fabric.provider_admission is the authority for both the names and the number. ProviderUsePermit is already sole_constructor and ProviderUseEvidence already carries posture_revision, route_facts_revision, customer_profile and agreement. THE GENUINE REMAINDER IS TWO ARMS AND A POPULATION: TransferOrLocationUnresolved and ProviderAccessPathUnsupported were DELIBERATELY DELETED rather than left uninhabitable, because both compare a located path's jurisdiction against the jurisdictions a posture permits and CompliancePostureRevision carries only an authority and a content hash. Their restoration trigger is a posture revision carrying its permitted-jurisdiction population, and that trigger is SUFFICIENT rather than partial - gunbc.product.fabric.provider_route ProviderPathStanding already carries a jurisdiction on its located arm, so the posture side is the only missing half. That remainder is part of THIS item and is not a separate one: rank 8 is incomplete while two of its named refusals are uninhabitable. The gate runs BEFORE capacity fungibility and before price, alongside executor sanction, because neither is economic and neither belongs in a selection cost. Required reds: the cheapest unadmitted route never wins; an unclassified route refuses rather than defaulting; the same provider in two regions may differ; a permit under one posture revision is stale under the next; available money cannot override a denial; and a permit cannot override an exhausted budget.",
  depends_on: [
    StartAfterStart {
      of: "provider-route-census",
      lag_days: 3,
      consumed_artifact: "one exact-route dossier, not the whole censused population",
      why: "The join is PER ROUTE - active posture revision x demand and work and customer and data scope x provider route and its data-path closure - so it can begin on the first completed route dossier rather than on the last. The three days are a proposal about when the first dossier lands.",
    },
    dep(id: "m2-applicability-model"),
  ],
  relates_to: ["strategy.compliance_posture", "strategy.compute_fabric_model"],
  item_relations: no_item_relations,
  status: InProgress { note: "SUBSTANTIALLY BUILT, AND NOT BY THIS PLAN. Recorded 2026-09-12 after censusing the corpus: gunbc.product.fabric.provider_admission carries ProviderUsePermit as sole_constructor, ProviderUseEvidence, and ProviderUseRefusal with thirteen constructible arms as of 2026-09-14, NINE OF NINE of the refusals this item names. RE-DERIVED AT WIND-DOWN: the sentence here previously said ten arms and seven of nine, and gunbc#11194 added three arms and closed the last two. A transcribed count rots by construction, which is exactly how that one did; trust the arm list in gunbc.product.fabric.provider_admission ProviderUseRefusal rather than this sentence. That landed through gunbc#10802 and gunbc#11083, and NEITHER IS CLAIMED BY ANY ITEM IN THIS PLAN. This read NotStarted until now because the plan carries no join to the pull requests that satisfy it, so an item can be most of the way done and still read as untouched - the same missing join that hid fabric-m0 progress. Treat that absence as the finding, not this one row. THE REMAINDER AS IT STOOD ON 2026-09-12, AND IT IS NOW DISCHARGED - stated in the past tense because it was the live remainder for one day and reading it as current is what produced three rounds of review on this row: extend CompliancePostureRevision to carry a permitted-jurisdiction population, then restore TransferOrLocationUnresolved and ProviderAccessPathUnsupported with their discriminating reds. All three arrived with gunbc#11194 - see below. The four is an estimate of that remainder and nothing measured it; the previous fourteen was an estimate of the whole item and is falsified by the census above. THE PR ARC, kept because it records HOW the remainder was discharged and not because any of it is current. The census paragraph above is a different fact again - it is HOW this item came to be built and why the plan could not see it - and it stays. gunbc#11194 was opened on 2026-09-13 carrying all four required checks green, with its two deleted refusal arms restored under distinct remedies and discriminating pairs. HISTORICAL, AND SUPERSEDED - kept as the record of a hold that is now discharged rather than deleted, because deleting it would erase why the item waited. It read: not landable as it stands, its green predates gunbc#11192 merging and the two share dag/test/claim/fabric/provider_use_fixture.dag, so it re-integrates before any merge ask. THAT HOLD IS DISCHARGED. gunbc#11192 merged 2026-09-13T02:18:33Z and is an ANCESTOR of gunbc#11194 head acfb1623 rather than a pending rebase, verified by ancestry and not by timestamps. gunbc#11194 ITSELF MERGED as 4f3df2aa0bf, and public main now carries PermittedJurisdictionPopulation in product.fabric.provider_route, product.fabric.provider_admission and the csa witness. SO THE RESTORATION TRIGGER ON strategy.private_witness_workflow witness_compliance_posture_revision IS NOW Enforced, not merely eligible: the quarantine retirement LANDED on private main, so the DESIGN section 4b(4) requirement is satisfied by executed evidence rather than by the landing that enabled it. The sentence this replaces said that retirement was a separate edit that had not landed; it had, and re-derived 2026-09-13 it no longer blocks anything. THIS ITEM IS STILL NOT Done, and for ONE remaining reason rather than the three it used to give: the exit criterion is the SEALED PERMIT JOIN, and that join is not built. A FINDING RECORDED HERE RATHER THAN TIDIED AWAY, because this row own dependency edge demanded it: the CompletionRequires edge on m2-admission-spine has been DROPPED. Its why-text declared its own premise falsified in 2026-09-12 and named a decision procedure rather than an artifact - when m2-admission-spine lands, compare what it produces against this item REMAINDER, and the edge survives only if the spine produces something that remainder consumes. The spine landed as gunbc#11176, merged 2026-09-13T13:39:16Z as 4e1de737bce. The comparison was then run against origin/main: job_admission, JobAdmission, JobClassification and admit_job have ZERO occurrences in product.fabric.provider_admission and product.fabric.provider_route, so the spine produces nothing this remainder consumes. The remainder arrived from somewhere else entirely - gunbc#11194 - while the edge went on blocking. The edge is dropped on evidence, which its own text called a finding rather than a tidy-up, and dropping it was legitimate only AFTER the comparison ran, never before: until then the edge blocked, and that fail-closed reading was deliberate. Its earlier CI was a heal-pushed head whose pull_request run was created and HELD with zero jobs; approving that run produced the green, not a new commit. 2026-09-14, THE FIRST-PARTY SPARK ROUTE IS THE NEAREST CONSUMER AND IT DOES NOT CALL THE JOIN. gunbc.spark.first_party_serving imports admit_provider_use and declares the route, a first-party self-use posture and its profiles - site allocation and posture landed as gunbc#11083, realization-answered route facts as gunbc#11162, typed service-identity refusals as gunbc#11294, and the container-inspect grant with its operator-accepted disclosure as gunbc#11326 and gunbc#11360. REMAINING on that lane, none of it discharging this item: gunbc#11362 (live-host endpoint-to-incarnation join) and gunbc#11363 (image-config Env classification) are open; the inspect grant is derived but not installed by fleet converge; the image-digest observation is unbuilt; weights and tokenizer stay an unobservable boundary; and the serving harness never calls admit_provider_use, so a permit is constructible for that route and nothing admits work through it. No dev end-to-end exists for it either, since the dev dashboard instance that served one is gone. The sealed-permit exit criterion therefore still has no executing caller, which is the same absence recorded above for admit_job on m2-admission-spine." },
}

data item_m2_control_bindings: PlanItem = PlanItem {
  id: "m2-control-bindings",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 10,
  min_calendar_days: 14,
  active_effort_days: 14,
  execution_mode: AgentParallel,
  exit_criterion: "REQUIRES AN ACTUAL PERMIT PRODUCER, not a regional plan described in prose - and the permit must SURVIVE SELECTION, GRANT ISSUANCE AND THE EFFECT BOUNDARY, since a candidate that carries an admission proof but a selection that returns a raw offer loses the evidence between candidate and grant. One authority for may-this-job-run-here: the private spill policy CONSUMES admitted routes and never keeps a second compliance decision. An exclusion stays unwritable without all three of a customer clause, an executing refusal, and a defined response when reality contradicts the clause, checked in both directions. The permit is a typed or sealed carrier, never a sixth opaque receipt field beside five others of the same type.",
  depends_on: [
    CompletionRequires {
      of: "provider-route-admission",
      why: "STAYS. This item REQUIRES AN ACTUAL PERMIT PRODUCER, NOT A REGIONAL PLAN DESCRIBED IN PROSE, and the permit must SURVIVE SELECTION, GRANT ISSUANCE AND THE EFFECT BOUNDARY. A producer that does not yet produce cannot be made to survive anything.",
    },
    dep(id: "m2-applicability-model"),
  ],
  relates_to: ["strategy.compliance_posture", "strategy.ci_alpha"],
  item_relations: no_item_relations,
  status: InProgress { note: "SUBSTANTIALLY LANDED, NOT DONE, and the remainder is deliberate. gunbc#11192 merged 2026-09-13T02:18:33Z: ExecutionGrant now CARRIES the sealed ProviderUsePermit and issuance records it, and the witness reads grant_admitting_route, grant_admitting_posture_revision and grant_admitting_route_facts_revision OFF THE COMMITTED GRANT rather than off the permit parameter or the candidate - which is the property that is easy to fake by reading the parameter back. Fixture projections come from the same producers the permit is built from rather than separately seeded constants, so the assertion can actually fail. WHAT IS NOT DONE: residual capability ONE in grant_issue is deliberately left open with the annotation saying so - taking a CandidateOffer there would satisfy a trigger while the defect stood. This item is Done when that residual closes, not when the PR merged." }
}

data item_provider_enablement_budget: PlanItem = PlanItem {
  id: "provider-enablement-budget",
  workstream: EconomicsQa,
  milestone: M2FirstExternal,
  rank: 10,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "THE SECOND OF THE THREE BUDGET QUESTIONS, kept separate from the permit because compliance is not depleted by use. One item per unsupported route naming what it closes first, the posture revision it was sized against, its owner as internal construction or provider evidence or bounded external interpretation, and its cost as quoted or estimated or explicitly unpriced. Cash, operator time and calendar latency stay SEPARATE AXES rather than one scalar, so an internal hour is never silently interchangeable with an outside dollar. A one-time contract review is never charged per job, and a route that has not completed enablement never enters dispatch selection - the selector must not commission legal research or sign an agreement as a fallback.",
  depends_on: [dep(id: "provider-route-admission")],
  relates_to: ["strategy.compliance_posture", "strategy.ci_runner_economics"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_m2_compliance_posture: PlanItem = PlanItem {
  id: "m2-compliance-posture",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 1,
  min_calendar_days: 5,
  active_effort_days: 5,
  execution_mode: AgentParallel,
  exit_criterion: "ONE DECLARED COMPLIANCE POSTURE WITH A PERMITTED-JURISDICTION POPULATION, and an active revision naming it. NO LANE MAY AUTHOR THE POSTURE CONTENT: a posture row written by an agent manufactures exactly the fact the admission spine exists to refuse, so its absence is a refusal working rather than a gap to fill. THE EXECUTION MODE IS AgentParallel AND WAS OperatorExclusive, changed 2026-09-13 after review 65245 read the typed field against this row own text and found them disagreeing. The field declares HOW AN ITEM CONSUMES THE OPERATOR - strategy.plan_tracker_page renders OperatorExclusive as you-exclusively and strategy.owner_action is_operator_exclusive keys operator coverage off it - so it is a claim about the operator REMAINING capacity, not about the item nature. This item nature is operator-gated and always was; that gate is DISCHARGED, by the operator ruling strategy.compliance_posture_revision m2_posture_ruling carries and the status below cites; gunbc#11194 merged 2026-09-13 as 4f3df2aa0bf, so nothing here waits on it. Leaving the field at OperatorExclusive would have presented a discharged item to the operator as exclusively theirs and spent the single primary-item slot the mode comment above rations. Changing it does not retract the gate: the status cites m2_posture_ruling, so a later reader can see the item required an operator decision and that the decision was made - by following the citation to the carrier that holds the words, rather than by reading a copy of them here. Discovered 2026-09-12 by a corpus sweep in the M2 lane: every construction of CompliancePostureRevision in the public tree is a fixture or a probe, so the PRODUCTION admitted route population is empty for two independent reasons - routes refuse on their facts, and no posture was ever declared. The evidence population is NOT empty and the instruments are testable today against fixtures, which is why the spine shipped rather than waiting. WHAT THIS UNLOCKS BEYOND ITSELF, and it is why this is the cheaper of the two: gunbc.product.fabric.provider_admission deleted two refusal arms - TransferOrLocationUnresolved and ProviderAccessPathUnsupported - rather than leave them uninhabitable, and their stated restoration trigger is a posture revision carrying its permitted-jurisdiction population. That trigger is SUFFICIENT rather than partial, because ProviderPathStanding already carries a jurisdiction on its located arm. So one operator decision closes the posture gap and the rank-8 remainder together.",
  depends_on: no_deps,
  relates_to: ["strategy.compliance_posture"],
  item_relations: no_item_relations,
  status: Done {
    evidence: [
      CorpusDeclaration {
        declaration: decl_ref(module_path: "strategy.compliance_posture_revision", decl_name: "m2_posture_ruling"),
      },
    ],
    note: "The operator ruling carried by strategy.compliance_posture_revision m2_posture_ruling discharges the operator-exclusive part; the build is with the M2 lane. WHAT THE RULING DOES NOT MEAN, because the encoding is the whole job: NO HARD RULES IS NOT PERMIT-EVERYTHING. Permit-all is the absorbing widen DESIGN section 5 forbids and would destroy the refusal the admission spine exists to produce. The honest encoding is demand-directed - permitted_jurisdictions ENUMERATES the jurisdictions whose route facts have been READ AND CLEARED, which today is the United States (own metal US-NY, plus the R2 durable origin once its location is READ; R2JurisdictionDefault is not a residency commitment). basis is the operator words m2_posture_ruling carries; expansion_trigger is a named customer whose route sits outside, censused and added when read. So a non-US customer is never refused BY RULE - they are served after their route is read and not before. The preferred-region preference is customer-selection POLICY under std.decision and belongs where candidates are ranked, NOT in admission: putting it in the posture would turn a commercial preference into a refusal. WHERE THIS STANDS AFTER THE BUILD, appended rather than replacing the ruling citation, and appended so this row and item_m2_customer_projections answer the SAME WAY about one fact - review 65126 on gunbc-private#97 correctly read the two as forking: gunbc-private#103 merged 2026-09-13 and landed the encoding described above, m2_jurisdiction_clearances yielding PermittedJurisdictionsEnumerated over one cleared jurisdiction, m2_demand_directed_posture, and m2_compliance_posture_revision as the active revision the admission reads. IT DID NOT RESOLVE AGAINST PUBLIC MAIN WHEN THIS WAS WRITTEN, and that is now history rather than state: the six names it imports - three from product.fabric.provider_route and three from product.fabric.provider_admission - arrived with gunbc#11194, and while they were missing strategy.private_witness_workflow had to carry witness_compliance_posture_revision as KnownRed rather than Enforced, run alone rather than in the shared roster process because one unresolved import stops every enforced witness reporting, with its seven expected causes checked whole. That quarantine has retired. THE RESTORATION TRIGGER HAS FIRED AND THIS ITEM IS NOW Done, re-derived 2026-09-13 from the tree rather than from the sentence this replaces, which said the public carrier was not on main and had gone stale where it stood. gunbc#11194 MERGED 2026-09-13T09:30:00Z as 4f3df2aa0bf, so the permitted-jurisdiction population on CompliancePostureRevision and both restored refusal arms are on public main. The private encoding is on private main in strategy.compliance_posture_revision, and the chain resolves rather than being asserted: m2_jurisdiction_clearances feeds demand_directed_posture as m2_demand_directed_posture, whose revision IS m2_compliance_posture_revision, and the fold yields PermittedJurisdictionsEnumerated over the cleared population. AND THE CLIMB IS ESTABLISHED BY EXECUTED EVIDENCE RATHER THAN BY THE LANDING THAT ENABLED IT, which is what DESIGN section 4b(4) requires: strategy.private_witness_workflow now carries witness_compliance_posture_revision as Enforced, not KnownRed, and it runs in the shared roster process rather than alone. The exit criterion - one declared posture with a permitted-jurisdiction population and an active revision naming it - is therefore met and executing. WHAT IS NOT CLAIMED BY THIS Done: the cleared population is ONE jurisdiction, and its expansion trigger remains a named customer whose route sits outside it, censused and added when read. That is the demand-directed design working, not a gap.",
  },
}

// BOTH DAY FIGURES ON THE TWO ITEMS ABOVE AND BELOW ARE UNMEASURED ESTIMATES. Calendar equals effort
// on both deliberately: an effort window split is asserted by items_with_effort_window_split and
// counted exactly, so inventing a split I cannot ground would have perturbed an unrelated check with
// a number I made up. If either item turns out to have real waiting in it, split it then and move
// that count with a reason beside it.
data item_m2_data_map: PlanItem = PlanItem {
  id: "m2-data-map",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 1,
  min_calendar_days: 10,
  active_effort_days: 10,
  execution_mode: OperatorExclusive,
  exit_criterion: "A DATA MAP: categories, subjects, purposes, retention and lawful basis, as declared rows rather than prose. Zero such rows exist in either repository as of 2026-09-12. IT IS OPERATOR-LEAD BUT NOT WHOLLY OPERATOR-WORK, and the split is worth making before the item is scheduled, because it is much smaller than it looks. THE EXECUTION MODE STAYS OperatorExclusive AND THE SPLIT BELOW IS NOT A REASON TO RELABEL IT, recorded 2026-09-13 against review 65245, which correctly read this sentence as disagreeing with the typed field and asked that one of the two move. The PROSE moved, because the field is right: this item EXIT is an operator act - purposes, retention and lawful basis - and no census can produce it, so is_operator_exclusive true is the accurate answer to does completing this need the operator. AgentParallel would be the worse error in the asymmetric direction: it would understate an operator gate to ZERO, and there is nowhere else today that would carry it - strategy.owner_action NOW CARRIES step_m2_data_map_operator_inputs, landed by gunbc-private#130, so the mode field is no longer the only typed record that the operator is on the completion path. THIS SENTENCE PREVIOUSLY SAID owner_action held no such step and deferred the fix to gunbc-private#98; both halves are spent -- the step exists and that PR is not where it landed. AND THE PRECISION MATTERS, because it is the whole subject of this item: what landed is NOT a ratification step and deliberately so. It collects the operator INPUTS the proposal rows wait on and leaves every row ProposedAwaitingRatification, because category_settlement_is_coherent admits a ratified row only with zero open questions across all three sources and the lawful-basis one needs funded counsel WHERE IT IS STILL COUNSEL'S -- since operator_legal_conclusion_ruling (2026-09-18) that is three of the thirteen basis claims, the ones whose placement is not ours to hold, and ten put no question there at all. So the literal clause 'holds no ratification step' stays TRUE and would stay true after any honest change; what is false is the claim that no typed operator record exists at all. What the split DOES license is dispatching the agent half as its own work item, which is the first move this row already names. WHAT AN AGENT CAN ESTABLISH: which data the fabric actually touches, holds and transmits is a fact about the code and is discoverable by census, the same way the provider route closure is. WHAT ONLY THE OPERATOR CAN SUPPLY: purposes, retention periods and lawful basis, which are commercial and legal choices no census can read off a program. The agent half HAS SINCE LANDED and this row is written after it: strategy.data_map is on private main carrying its category rows at proposed() standing, so the split was the first move and it is made. What remains of this item is the operator act named above, and the proposal standing flips on that ratification and on nothing else. WHY IT BLOCKS rank 12 rather than merely informing it: m2-customer-projections derives its privacy notice from the ACTUAL data map, so without one the projection either emits nothing or authors what it was supposed to derive.",
  depends_on: no_deps,
  relates_to: ["strategy.compliance_posture"],
  item_relations: no_item_relations,
  status: InProgress { note: "The operator ruling carried by strategy.compliance_posture_revision m2_posture_ruling discharged the POSTURE question and NOT this item's operator act. THE TWO ARE DIFFERENT OPERATOR INPUTS and this row previously conflated them by reusing the sentence that is accurate on item_m2_compliance_posture: purposes, retention periods and lawful basis are what the exit criterion above names as operator-only, they are OUTSTANDING, and the proposal standing flips on that ratification and on nothing else - which is why this item still blocks rank 12. The operator gave NO retention numbers and NO category correction, and the lane does not wait for them: the map is authored as typed rows carrying a PROPOSAL STANDING, every retention default typed as awaiting ratification and never as fact (DESIGN section 4d - do not assert as deduced what is only inferred). Lawful-basis rows carry a CounselStanding, and since operator_legal_conclusion_ruling (2026-09-18) that is THREE states rather than two: ten of the thirteen basis claims the nine categories carry are now ConcludedInHouse at a placement whose error we can correct ourselves or with a customer we can reach, and counsel remains ZERO SPEND for the rest. The operator ratifies in one pass and the proposal standing flips then and only then. Its consumers land in the same change per DESIGN section 3c - RouteScopeSanction.data_handling_profile and ProviderUseScope.data_handling_profile must resolve to it, because a data map nothing reads is a dangling declaration. WIND-DOWN, 2026-09-14 -- OPERATOR-OWNED AND HELD, and the two halves are different: the operator CAN supply input now (purposes, retention answers, category corrections) and that is the act carried as owner step m2-data-map-operator-inputs. The operator CANNOT ratify, and NO ROW LEAVES ProposedAwaitingRatification until the private CategoryUnmapped repair lands. THE SEQUENCE, because the order is the whole constraint: gunbc-private#118 merged the head carrying data_map.dag category_profile_ref, which hands a PRIVATE description identity to product.data_class admit_data_effect where a product.data_category MARKER is compared, so every ratified row would resolve CategoryUnmapped; the repair imports six functions that gunbc#11343 adds, so it cannot land before gunbc#11343 does. Ratifying ahead of that sequence detonates a defect that today has no symptom only because the map has no ratified rows. Counsel funding is additionally an UNMODELLED DEPENDENCY of this item -- no plan edge carries it -- and it NARROWED on 2026-09-18 rather than vanishing: the gate was map-wide because CounselStanding had only two arms, so the three basis constructors hard-coded CounselReviewRequired onto every basis claim and no row could ratify until counsel was funded. What still cannot exit under zero spend is the rows whose placement is not ours to hold -- the sanctions and abuse bases, and the tax and accounting legal-obligation basis -- plus the retention PERIODS bound to counsel_retention_period_review, which were never lawful-basis questions." },
}

data item_m2_customer_projections: PlanItem = PlanItem {
  id: "m2-customer-projections",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 12,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: AgentParallel,
  exit_criterion: "PROJECTED from the pinned standard, the bindings and THE ADMITTED ROUTE POPULATION - the provider, subprocessor and location disclosures are derived from admitted routes rather than authored, so a schedule cannot promise a boundary no permit can produce. Cover page and order carrying founding-credit terms as a section, the M2 addendum, a privacy notice that projects the ACTUAL data map, the security and data-handling schedule, a versioned subprocessor snapshot, and the EXPLICIT DEVIATION LIST against the pinned standard - the only thing phase two is asked to read. No public ToS while public self-service is disabled. AND THE EXPOSURE THIS ITEM ACTIVATES, CARRIED HERE BECAUSE THE PLAN HAS NO EDGE FOR IT (snappy-pike-154, 2026-09-13, verified against origin/main): llc-publication-filing (rank 10, M1InternalVertical) states, in its own exit criterion, that until filed the LLC authority to maintain an action in New York courts is SUSPENDED -- dormant while nobody owes anything, live the moment a customer contract exists. THIS ITEM IS WHAT MAKES A CUSTOMER CONTRACT EXIST, so it is the TRIGGER and that item is the CURE, and NOTHING IN THE PLAN CONNECTS THEM - on origin/main llc-publication-filing appears exactly three times, its declaration, its id, and the roster, and no depends_on anywhere references it. A depends_on edge IS WRITABLE - rank 10 is strictly smaller than 12, so a dep on llc-publication-filing would compile - and is DELIBERATELY NOT TAKEN, because it asserts BLOCKING and the legal reading that would justify blocking has not been established: the suspension bites on MAINTAINING AN ACTION rather than on validity, and is curable by filing later. Counsel is ZERO SPEND, so that reading is not arriving soon. relates_to cannot carry it either: every relates_to value in this module is a dotted MODULE path, so a plan-item id there would put one field on two kinds of referent, which is the section 3 meaning fork. SO THIS SENTENCE IS A STOPGAP THE SCHEDULE CANNOT SEE. It is recorded on the item that TRIGGERS the exposure rather than only on the item that CURES it, because a reader of this item otherwise has no way to learn the exposure exists. It is NOT a substitute for the missing carrier and must not be cited as coverage; the carrier is dispatched as its own work, whose first deliverable is a census of the prose-only cross-item relations rather than a field invented from this one case.",
  depends_on: [
    StartAfterStart {
      of: "m2-control-bindings",
      lag_days: 4,
      consumed_artifact: "the exclusion clauses",
      why: "The disclosures are DERIVED FROM ADMITTED ROUTES RATHER THAN AUTHORED, and the admitted route population is the join's output, which is already complete when this item starts. What the bindings add is the clause set, which lands during the item rather than at its end. Four days is a proposal about when.",
    },
    dep(id: "m2-contract-standard"),
    dep(id: "provider-route-admission"),
    CompletionRequires {
      of: "m2-compliance-posture",
      why: "A permit cannot be minted against a posture that does not exist, and this item derives its disclosures from the ADMITTED ROUTE POPULATION. With no declared posture that population is empty in production, so the projection would emit a privacy notice promising nothing and a subprocessor snapshot with no entries - a document that misleads a customer rather than a deliverable held back by caution.",
    },
    CompletionRequires {
      of: "m2-data-map",
      why: "The privacy notice projects the ACTUAL data map. Without one this item would AUTHOR the categories, purposes, retention and lawful basis it exists to DERIVE, which is the inversion its own exit criterion forbids.",
    },
  ],
  relates_to: ["strategy.compliance_posture", "strategy.ci_product_surface"],
  item_relations: no_item_relations,
  status: InProgress { note: "DELIBERATELY STOPPED, NOT MERELY UNSTARTED, and the record is gunbc-private#94. This item DERIVES its provider, subprocessor and location disclosures from the ADMITTED ROUTE POPULATION. That population is empty in production for two independent reasons, and building the projections now would AUTHOR what the item exists to DERIVE - a privacy notice promising nothing and a subprocessor snapshot with no entries is a document that misleads a customer, not a deliverable held back by caution. The two dependencies are now carried as edges on this item rather than in prose: m2-compliance-posture and m2-data-map. THE POSTURE HALF NOW RESOLVES, and m2-compliance-posture reads Done - one standing, and this row and that one give the same answer, which is what review 65126 asked this PR to close. HOW IT GOT THERE, kept because it is why this edge existed at all rather than because it is current: gunbc-private#103 merged 2026-09-13 carrying strategy.compliance_posture_revision with its permitted-jurisdiction population and m2_compliance_posture_revision as the active revision, and for part of that day its witness was green only on a COMPOSED root of public main plus gunbc#11194, because against public main alone six of the names it imports from product.fabric.provider_route and product.fabric.provider_admission did not resolve - so strategy.private_witness_workflow had to enrol witness_compliance_posture_revision as KnownRed, run alone rather than in the shared roster process. gunbc#11194 merged 2026-09-13T09:30:00Z as 4f3df2aa0bf, the six names resolve against public main, and that witness is Enforced in the shared roster. THAT EDGE IS NOW DISCHARGED, re-derived 2026-09-13: the trigger it named has fired - gunbc#11194 merged 2026-09-13T09:30:00Z as 4f3df2aa0bf, the six names resolve against public main, and witness_compliance_posture_revision is Enforced in the shared roster process rather than quarantined alone. The sentence this replaces said the opposite and was true only until 09:30 that morning. WHAT ACTUALLY REMAINS on this item is therefore not the quarantine: the data map is in flight as typed PROPOSAL rows awaiting operator input, and no agent may supply it. WIND-DOWN, 2026-09-14, AND THIS CORRECTS THE SENTENCE IT REPLACES: that sentence said the rows await operator RATIFICATION. They do not, because ratification cannot be performed by anyone today -- strategy.data_map category_settlement_is_coherent admits a ratified row only with ZERO open questions across all three sources, and the per-basis lawful-basis question clears through CounselOpinionOnRecord or, since operator_legal_conclusion_ruling (2026-09-18), through ConcludedInHouse -- ten of the thirteen basis claims now take the second route and put no question there, so the funded-counsel premise this sentence rested on holds for three claims rather than all of them. So this item is CONSTRAINED BY THE ROWS THAT REMAIN rather than structurally unable to start: both of its CompletionRequires edges are unmet, m2-compliance-posture excepted, and its projections must be DERIVED from admitted routes while no route can be admitted from a map with no settled rows. It needs EXPLICIT REDISPATCH when work resumes; it is not queued behind anything that will clear on its own." }
}

data item_m2_legal_review_ready: PlanItem = PlanItem {
  id: "m2-legal-review-ready",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 14,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: OperatorExclusive,
  exit_criterion: "THE GATE THAT MAKES PAID REVIEW CONDITIONAL: ratified launch intent, named customer facts including state and sector, verified authority pins, a complete provider-route and data-path census, an EXECUTED admission spine and permit producer, a pinned contract standard, the projected addendum, privacy projection and security schedule, and the enablement obligations that survive. Unstable facts and a homegrown contract are the two reliable ways to burn legal hours and both are refused here rather than discovered on the invoice.",
  depends_on: [
    dep(id: "m2-control-bindings"),
    CompletionRequires {
      of: "m2-customer-projections",
      why: "STAYS, AND IT IS AN ECONOMIC WALL RATHER THAN A BUREAUCRATIC ONE. This item exists to make PAID review conditional on a complete packet, and its input list names the projected addendum, the privacy projection and the security schedule. Relaxing this edge would spend senior hours against facts still moving - it saves calendar by spending money, which is the one trade this gate was built to refuse.",
    },
    dep(id: "provider-enablement-budget"),
    dep(id: "counsel-market-census"),
  ],
  relates_to: ["strategy.compliance_posture", "finance.gunbai_llc"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_m2_legal_issue_spot: PlanItem = PlanItem {
  id: "m2-legal-issue-spot",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 16,
  min_calendar_days: 14,
  active_effort_days: 1,
  execution_mode: ExternalLead,
  exit_criterion: "PHASE ONE, CAPPED AT THREE SENIOR HOURS - min_calendar_days is QUEUE LATENCY, not effort, and the census quote replaces it. Authorized: material omitted categories, materially wrong LIVE applicability findings, named-customer state or sector facts that change obligations, questions needing specialty counsel, and what must change before first dispatch. Unauthorized: drafting, redlining, rewriting the matrix, a narrative memo, DPA or BAA work, SOC 2 or ISO work, research outside scope, contacting another specialist, continuing past the cap. The return is a typed observation carrying reviewer, scope hash, assumptions and specialties NOT reviewed; arms are material omission identified, none identified within that declared boundary, or specialty review required. Never a completeness certificate.",
  depends_on: [dep(id: "m2-legal-review-ready")],
  relates_to: ["strategy.compliance_posture", "finance.gunbai_llc"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_m2_contract_deviation_review: PlanItem = PlanItem {
  id: "m2-contract-deviation-review",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 18,
  min_calendar_days: 10,
  active_effort_days: 1,
  execution_mode: ExternalLead,
  exit_criterion: "PHASE TWO, SEPARATELY AUTHORIZED AND CAPPED AT THREE SENIOR HOURS - not authorized merely because phase one happened, and bought only if phase one demonstrated it useful. Input is the pinned standard plus our deviation list, never a blank page. Output is a redline, a clause-to-control mismatch table, launch-blocking wording changes and later-capability wording marked separately, with NO restatement of unchanged standard terms. A closeout of at most two further hours is separately authorized.",
  depends_on: [CompletionRequires {
    of: "m2-legal-issue-spot",
    why: "If phase two happens at all it consumes phase one's typed observation: INPUT IS THE PINNED STANDARD PLUS OUR DEVIATION LIST, NEVER A BLANK PAGE. Whether it happens is a different question, carried on the edge INTO m2-compliance-admission rather than here.",
  }],
  relates_to: ["strategy.compliance_posture", "strategy.ci_product_surface"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_m2_compliance_admission: PlanItem = PlanItem {
  id: "m2-compliance-admission",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 20,
  min_calendar_days: 7,
  active_effort_days: 7,
  execution_mode: OperatorExclusive,
  exit_criterion: "FREEZES THE EXACT REVISIONS the launch runs against - posture revision, every route-facts revision, customer profile revision, agreement revision and the permit evidence - so a later posture change makes standing permits stale rather than silently tolerated. Every launch-blocking delta closed, and one rehearsal recorded, SYNTHETIC AND NON-NOTIFYING THROUGHOUT because a rehearsal that actually notifies is an incident: a synthetic sanctions potential match adjudicated, a synthetic declared-ePHI job refused and a detected signal contained, a synthetic unresolved export classification held, a cheapest-but-unadmitted route losing to a dearer admitted one, and an incident exercised to RECIPIENT SELECTION, SEQUENCING AND DRAFT GENERATION ONLY - nothing sent to any customer, regulator, law-enforcement agency or OFAC - plus a deletion to its typed terminal state and a test organization offboarded. First external job permitted only if the admission gate is constructible from those frozen versions. THE BINDING EVENT IS EXECUTION, NOT PAYMENT.",
  depends_on: [
    dep(id: "m2-control-bindings"),
    dep(id: "m2-legal-issue-spot"),
    ConditionalRequires {
      of: "m2-contract-deviation-review",
      condition: "phase one returned material omission identified, or the counterparty negotiates - which a reseller does by definition and a design partner on a pinned standard form usually does not",
      why: "PHASE TWO IS NOT AUTHORIZED MERELY BECAUSE PHASE ONE HAPPENED, AND IS BOUGHT ONLY IF PHASE ONE DEMONSTRATED IT USEFUL - the deviation review's own exit criterion. So this freeze does not unconditionally wait on it. The edge is declared rather than deleted: the conditional reading is computed and reported separately, because a branch that may not be bought does not belong in the unconditional schedule and a branch that may be bought does not belong in nobody's.",
    },
  ],
  relates_to: ["strategy.compliance_posture", "strategy.ci_alpha"],
  item_relations: no_item_relations,
  status: NotStarted,
}

data item_customer_authorizations: PlanItem = PlanItem {
  id: "customer-authorizations",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 20,
  min_calendar_days: 5,
