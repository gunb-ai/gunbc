data item_wholesale_security_admission: PlanItem = PlanItem {
  id: "wholesale-security-admission",
  workstream: SecurityCompliance,
  milestone: M5Q2ColoDeployment,
  rank: 82,
  min_calendar_days: 3,
  active_effort_days: 3,
  execution_mode: OperatorExclusive,
  exit_criterion: "The joining gate: every GunbaiOwned or Shared row of the responsibility matrix has a Done realization, and each realization is a DEPENDENCY EDGE of this item, not a sentence (review repair 2026-09-14, P1): OOB management (wholesale-oob-management-realization), firmware serviceability (mt-collins-firmware-serviceability), credential lifecycle (machine-identity-secrets-lifecycle), image identity (boot-minimum: digest-identified host image), off-host security logging (wholesale-off-host-security-logging), offboarding (wholesale-offboarding-erasure). Every Unresolved row carries an UnresolvedControlDisposition (wholesale_batch_floor): BlocksProduction refuses this gate; ContractuallyExcluded, BuyerOwnedByContract and BoundedReplacementOnly admit it only with the clause or bound named. Admits or refuses; nothing passes by silence and nothing passes by disclosure alone.",
  depends_on: [dep(id: "wholesale-security-profile"), dep(id: "wholesale-oob-management-realization"), dep(id: "mt-collins-firmware-serviceability"), dep(id: "colo-turnup-rack-acceptance"), dep(id: "machine-identity-secrets-lifecycle"), dep(id: "boot-minimum"), dep(id: "wholesale-off-host-security-logging"), dep(id: "wholesale-offboarding-erasure")],
  relates_to: ["strategy.compliance_posture", "strategy.wholesale_batch_floor"],
  item_relations: no_item_relations,
  status: NotStarted,
}

