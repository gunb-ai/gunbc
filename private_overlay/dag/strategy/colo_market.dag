    authority: "webhostingtalk thread 1313185 (fetch refused 2026-08-18); refused as stale-unverifiable",
  },
  RefusedChannel {
    label: "Broker and agency surfaces (515 Engine, newjerseycolocation.com, QuoteColo, LowCostColocation)",
    cause: "Quote-aggregation channels, not facility operators: none owns a building, so none is an upstream authority to model. They remain usable as RFQ distribution channels; any quote they return is a quote FROM a modeled operator and lands on that operator's row.",
    authority: "extdeps external-upstream-decomposition rule, applied 2026-08-18",
  },
]

// The refusal above points at a modeled subject, not a name: the campus rows stay cited in
// extdeps.colo.equinix, and this typed edge is what keeps the refusal auditable against the
// exact facility population it declines.
data equinix_refusal_subject: ColoFacilityRow = equinix_ny4

// ---------------------------------------------------------------------------------------------
// THE PARETO INSTANTIATION.
// ---------------------------------------------------------------------------------------------

// AXIS IDENTITY IS STRUCTURAL. std.pareto moved SelectionAxis/AxisReading onto DeclarationRef:
// a display string is a second naming scheme for what the namespace already names, and two
// readings joining by spelling rather than identity is the silent mis-join the spine refuses.
data axis_monthly_cost_id: DeclarationRef = decl_ref(module_path: "strategy.colo_market", decl_name: "axis_monthly_cost_id")
data axis_power_watts_id: DeclarationRef = decl_ref(module_path: "strategy.colo_market", decl_name: "axis_power_watts_id")
data axis_transit_megabits_id: DeclarationRef = decl_ref(module_path: "strategy.colo_market", decl_name: "axis_transit_megabits_id")
data axis_rack_units_id: DeclarationRef = decl_ref(module_path: "strategy.colo_market", decl_name: "axis_rack_units_id")
data axis_ipv4_usable_id: DeclarationRef = decl_ref(module_path: "strategy.colo_market", decl_name: "axis_ipv4_usable_id")
data axis_distance_miles_id: DeclarationRef = decl_ref(module_path: "strategy.colo_market", decl_name: "axis_distance_miles_id")

data axis_monthly_cost: SelectionAxis = SelectionAxis { identity: axis_monthly_cost_id, goal: LowerIsBetter }
data axis_power_watts: SelectionAxis = SelectionAxis { identity: axis_power_watts_id, goal: HigherIsBetter }
data axis_transit_megabits: SelectionAxis = SelectionAxis { identity: axis_transit_megabits_id, goal: HigherIsBetter }
data axis_rack_units: SelectionAxis = SelectionAxis { identity: axis_rack_units_id, goal: HigherIsBetter }
data axis_ipv4_usable: SelectionAxis = SelectionAxis { identity: axis_ipv4_usable_id, goal: HigherIsBetter }
data axis_distance_miles: SelectionAxis = SelectionAxis { identity: axis_distance_miles_id, goal: LowerIsBetter }

data colo_axes: List<SelectionAxis> = [
  axis_monthly_cost,
  axis_power_watts,
  axis_transit_megabits,
  axis_rack_units,
  axis_ipv4_usable,
]

data colo_sensitivities: List<NonEmptyStr> = [
  "drive distance: NOT A FUNDED AXIS, because no facility has a measured road distance. Every row carries a coarse planning estimate and nothing else - no retained route, no receipt, no rounding protocol - so there is no interval to fund the axis with, and a point reading would let a guess decide. Distance genuinely matters (it prices every emergency the operator drives to, alongside the remote-hands rate below), which is exactly why it is named here rather than approximated: an axis with no evidence is unfunded and said so, not funded with a number that looks like evidence.",
  "power alarm basis: whether an allocation is policed on average, on peak, or on the eighty-percent continuous rule is unread for every offer, and it decides how many nodes a wattage actually carries",
  "metered pass-through and overage: what a kilowatt-hour or an excess terabyte costs beyond the allocation is unread everywhere",
  "setup, cross-connect and IP fees: only 165 Halsey publishes cross-connect economics; every other offer's non-recurring stack is unread",
  "contract term and exit friction: month-to-month is published only for InterServer; everyone else's minimum term is unread",
  "BMC and out-of-band policy: whether a private OOB VLAN with a customer WireGuard gateway is permitted is unread everywhere, and the ask sheet leads with it",
  "remote-hands rate: published only for 165 Halsey; unread elsewhere and it prices every emergency the operator cannot drive to",
]


data no_missing: List<AxisGap> = []

// A GAP NAMES THE AXIS WHOSE ABSENCE IT DECLARES, AND THAT IS A NARROWER CLAIM THAN IT SOUNDS.
//
// std.pareto still refuses a candidate carrying ANY gap -- compare_pair returns
// PairEvidenceIncomplete and entry_standing returns NotComputable. Naming the axis does NOT buy a
// partial standing over the axes that are funded, and nothing here should be read as saying it
// does.
//
// What it buys is that a declared absence can no longer excuse an UNRELATED one. Before
// gunbc#10150 a gap was a bare sentence, so an unread voltage and an unread port were
// indistinguishable, and a gap about power silently covered a missing transit reading. Now the
// reading and the gap must name the same axis or std.pareto reports a located contradiction, so an
// unfunded absence is accounted for individually instead of being absorbed by whichever obligation
// happened to be declared.
fn one_missing(axis: DeclarationRef, text: NonEmptyStr) -> List<AxisGap> {
  [AxisGap { axis: axis, cause: text }]
}

fn gap_on_each(axes: List<DeclarationRef>, text: NonEmptyStr) -> List<AxisGap> {
  fold(axes, init: [], f: fn(acc, ax) { concat(acc, [AxisGap { axis: ax, cause: text }]) })
}

// A QUOTE-ONLY LISTING IS SHORT ON EVERY AXIS BUT ONE, AND NOW IT ENUMERATES THEM. Nothing here is
// readable from the listing, because an RFQ has not been answered.
//
// Distance is omitted for a different reason, and the earlier text got it wrong by saying distance
// is readable from the listing alone: these rows carry DistanceUnmeasured, distance_readings emits
// no reading for that arm, and the distance axis is not presently FUNDED by this selection because
// no facility carries measured road-distance evidence. A gap must name a funded axis, so an
// unfunded axis cannot take one -- std.pareto refuses that roster outright.
//
// The name says GAP AXES, not "unfunded axes": every ref below is a FUNDED axis of this selection.
// That is the requirement, not an accident -- std.pareto refuses a gap naming an axis the selection
// does not fund, so a gap roster is necessarily a subset of the funded roster.
//
// It is written out as "every axis except distance" rather than derived by subtraction so that a
// new axis has to be a considered addition here. Silently inheriting a gap it was never assessed
// for is how an absence gets excused by accident.
data quote_only_gap_axes: List<DeclarationRef> = [
  axis_monthly_cost_id, axis_power_watts_id, axis_transit_megabits_id, axis_rack_units_id, axis_ipv4_usable_id,
]

// Power as an axis reading. A breakered feed is derated to eighty percent continuous per the
// power appendix; an allocation is taken as stated; unread power is a missing input, never a
// guessed figure.
type PowerReading
  = PowerReadWatts { watts: Int }
  | PowerReadingMissing { obligation: NonEmptyStr }

fn power_reading(p: PowerAllocation) -> PowerReading {
  match p {
    AllocatedWatts { allocation } => PowerReadWatts { watts: watt_count(w: allocation) },
    FeedAmps { amps, volts } => PowerReadWatts { watts: ampere_count(a: amps) * volt_count(v: volts) * 800 / 1000 },
    FeedAmpsVoltsUnstated { amps, voltage_obligation } => PowerReadingMissing { obligation: voltage_obligation },
    PowerUnread { obligation } => PowerReadingMissing { obligation: obligation },
  }
}

type TransitReading
  = TransitReadMegabits { megabits: Int }
  | TransitReadingMissing { obligation: NonEmptyStr }

fn transit_reading(t: TransitAllocation) -> TransitReading {
  match t {
    UnmeteredPort { port_speed } => TransitReadMegabits { megabits: bandwidth_count(b: port_speed) / 1000000 },
    MeteredTransfer { port_speed, included_transfer_per_month } => TransitReadingMissing {
      obligation: "metered transfer is not comparable on the unmetered-port axis without an overage rate; carried as missing rather than converted by a guessed utilization",
    },
    TransitUnread { obligation } => TransitReadingMissing { obligation: obligation },
  }
}

type Ipv4Reading
  = Ipv4ReadCount { usable: Int }
  | Ipv4ReadingMissing { obligation: NonEmptyStr }

fn ipv4_reading(a: Ipv4Allocation) -> Ipv4Reading {
  match a {
    Ipv4Usable { usable_addresses, block_note } => Ipv4ReadCount { usable: usable_addresses },
    Ipv4Unread { obligation } => Ipv4ReadingMissing { obligation: obligation },
  }
}

data no_readings: List<AxisReading> = []

// The distance axis is emitted ONLY from a measured route, exactly as power, transit and IPv4 are
// emitted only when they were read.
//
// THE OBLIGATION IS NOT ROUTED TO missing_inputs, AND THAT IS DELIBERATE. missing_inputs makes the
// SUBJECT incomparable, which is right when one candidate lacks something its peers have. Distance
// is unmeasured for EVERY candidate, so routing it there would make every colo entry NotComputable
// and the selection would stop answering on the cost, space and power evidence it does hold. That
// trades a fail-open for a fail-shut and loses real information either way. An axis no candidate can
// evidence is not a per-candidate gap - it is an UNFUNDED axis, so it leaves colo_axes and is named
// in colo_sensitivities beside the other things nobody has read. The moment one facility carries a
// DistanceMeasured route, the axis can be funded and any candidate still unmeasured becomes a real
// missing_inputs case at that point.
fn distance_readings(c: ColoOfferCandidate) -> List<AxisReading> {
  match c.distance {
    DistanceMeasured { interval_miles, receipt } =>
      [AxisReading { axis: axis_distance_miles_id, interval_micro: interval_miles }],
    DistanceUnmeasured { planning_estimate_miles, obligation } => no_readings,
  }
}

fn plan_readings(c: ColoOfferCandidate, plan: RetailPlanRow) -> List<AxisReading> {
  let base = concat([
    AxisReading { axis: axis_monthly_cost_id, interval_micro: degenerate_interval(point: money_per_month_micros(q: plan.monthly)) },
    AxisReading { axis: axis_rack_units_id, interval_micro: degenerate_interval(point: rack_unit_count(u: plan.rack_units)) },
  ], distance_readings(c: c))
  let with_power = match power_reading(p: plan.power) {
    PowerReadWatts { watts } => concat(base, [AxisReading { axis: axis_power_watts_id, interval_micro: degenerate_interval(point: watts) }]),
    PowerReadingMissing { obligation } => base,
  }
  let with_transit = match transit_reading(t: plan.transit) {
    TransitReadMegabits { megabits } => concat(with_power, [AxisReading { axis: axis_transit_megabits_id, interval_micro: degenerate_interval(point: megabits) }]),
    TransitReadingMissing { obligation } => with_power,
  }
  match ipv4_reading(a: plan.ipv4) {
    Ipv4ReadCount { usable } => concat(with_transit, [AxisReading { axis: axis_ipv4_usable_id, interval_micro: degenerate_interval(point: usable) }]),
    Ipv4ReadingMissing { obligation } => with_transit,
  }
}

fn plan_missing(plan: RetailPlanRow) -> List<AxisGap> {
  let power_gap = match power_reading(p: plan.power) {
    PowerReadWatts { watts } => no_missing,
    PowerReadingMissing { obligation } => one_missing(axis: axis_power_watts_id, text: obligation),
  }
  let transit_gap = match transit_reading(t: plan.transit) {
    TransitReadMegabits { megabits } => no_missing,
    TransitReadingMissing { obligation } => one_missing(axis: axis_transit_megabits_id, text: obligation),
  }
  let ipv4_gap = match ipv4_reading(a: plan.ipv4) {
    Ipv4ReadCount { usable } => no_missing,
    Ipv4ReadingMissing { obligation } => one_missing(axis: axis_ipv4_usable_id, text: obligation),
  }
  concat(power_gap, concat(transit_gap, ipv4_gap))
}

fn colo_entry(c: ColoOfferCandidate) -> ParetoEntry {
  match c.pricing {
    PublishedPlan { plan } => ParetoEntry {
      identity: decl_ref(module_path: "strategy.colo_market", decl_name: c.id),
      display_label: c.id,
      readings: plan_readings(c: c, plan: plan),
      missing_inputs: plan_missing(plan: plan),
    },
    QuoteOnly { rfq } => ParetoEntry {
      identity: decl_ref(module_path: "strategy.colo_market", decl_name: c.id),
      display_label: c.id,
      readings: distance_readings(c: c),
      missing_inputs: gap_on_each(axes: quote_only_gap_axes, text: rfq),
    },
  }
}

data no_colo_entries: List<ParetoEntry> = []

fn colo_entries() -> List<ParetoEntry> {
  fold(colo_candidates, init: no_colo_entries, f: fn(acc, c) { concat(acc, [colo_entry(c: c)]) })
}

fn colo_standing(c: ColoOfferCandidate) -> ParetoStanding {
  entry_standing(subject: colo_entry(c: c), field: colo_entries(), axes: colo_axes, sensitivities: colo_sensitivities)
}

fn colo_standing_label(c: ColoOfferCandidate) -> NonEmptyStr {
  pareto_label(s: colo_standing(c: c))
}

// The derived shopping list: every quote-only candidate's RFQ, in census order. This is what
// makes the quotes the model's own advice about where to spend effort - obtaining any one of
// them moves a candidate from not-computable onto the comparable field.
fn open_rfqs() -> List<NonEmptyStr> {
  fold(colo_candidates, init: no_missing, f: fn(acc, c) {
    match c.pricing {
      PublishedPlan { plan } => acc,
      QuoteOnly { rfq } => concat(acc, [rfq]),
    }
  })
}

// ---------------------------------------------------------------------------------------------
// FLEET FIT. Two reference loads: the full move (srv1-4 plus the inbound pilot, five dense
// nodes) and the leaner deployment the operator's ideation thread surfaced 2026-08-18 - two
// existing 2U hosts in per-U or quarter-rack space with the remaining hosts retained as
// overflow, RAM completion and measured power gating sellable capacity.
// ---------------------------------------------------------------------------------------------

type ReferenceLoad {
  label: NonEmptyStr
  node_count: Int
  rack_units_needed: Int
  gating_obligations: List<NonEmptyStr>
}

data full_fleet_load: ReferenceLoad = ReferenceLoad {
  label: "full move: srv1-4 plus pilot (five 2U nodes)",
  node_count: 5,
  rack_units_needed: 12,
  gating_obligations: [
    "measured wall power per host replaces the 650-watt planning figure before any admission is quoted as fact",
    "top-of-rack switch and gateway add roughly one to two hundred watts and two rack units, included in the twelve-unit ask",
  ],
}

data lean_two_host_load: ReferenceLoad = ReferenceLoad {
  label: "lean deployment: two existing 2U hosts, overflow retained at the lab",
  node_count: 2,
  rack_units_needed: 5,
  gating_obligations: [
    "RAM completion gates sellable capacity: the cheap-DIMM population purchase has to land before the hosts earn their keep in paid colocation",
    "measured wall power per host replaces the 650-watt planning figure; the quarter-rack admission below is peak-tight and stands or falls on that measurement",
    "the retained overflow hosts keep the lab as the burst tier, which the spill model must carry as a distinct placement rather than pretending one site",
  ],
}

type FleetAdmission
  = FleetAdmitted { nodes_at_average: Int, headroom_note: NonEmptyStr }
  | FleetPowerRefused { shortfall_watts: Int, remedy: NonEmptyStr }

fn admission_against(plan_watts: Int, load: ReferenceLoad) -> FleetAdmission {
  let average_draw = load.node_count * node_watts()
  if average_draw <= plan_watts {
    FleetAdmitted {
      nodes_at_average: plan_watts / node_watts(),
      headroom_note: "admitted on the average-draw planning figure; peak draw and the provider's alarm basis are the two unread facts that can still refuse this",
    }
  } else {
    FleetPowerRefused {
      shortfall_watts: average_draw - plan_watts,
      remedy: "quote a larger feed - the ask sheet's thirty-amp 208-volt target yields roughly 4,992 usable watts at the eighty-percent rule",
    }
  }
}

fn quarter_rack_admits_lean_load() -> FleetAdmission {
  admission_against(plan_watts: 1500, load: lean_two_host_load)
}

fn half_rack_admits_full_fleet() -> FleetAdmission {
  admission_against(plan_watts: 2500, load: full_fleet_load)
}

data full_fleet_ask_note: NonEmptyStr = "The published retail tiers under-power the full five-node move: 2,500 allocated watts carries three nodes at the 650-watt planning figure, not five. The full move is therefore a quote-only object - a full cabinet with a single metered thirty-amp 208-volt feed (about 4,992 usable watts under the eighty-percent rule) - which is exactly what the RFQ ask sheet requests. The lean two-host deployment inverts this: it fits the published quarter-rack tier today at 705 dollars a month, published price, no quote needed, which is why it is the reference load that makes the selection actionable before any RFQ returns."

// THE ASK SHEET, instantiated from the strategy appendix so every RFQ asks the same
// questions and the answers land on comparable rows.
data rfq_ask_sheet: List<NonEmptyStr> = [
  "single metered feed, thirty or sixty amps at 208 volts, and whether the quoted allocation is policed on average draw, peak draw, or the eighty-percent continuous rule",
  "metered rate: all-in per kilowatt-hour or PUE-multiplied, and the overage terms",
  "per-outlet metered PDU availability - host-grain power observation is a product requirement, not a nicety",
  "a /29 of provider space plus a private BMC/out-of-band VLAN, never internet-routed, with a customer WireGuard gateway permitted",
  "remote-hands rate and window",
  "month-to-month or one-year term, and the setup non-recurring charge",
  "cross-connect fees monthly and install, and carrier list at the meet-me room",
]
