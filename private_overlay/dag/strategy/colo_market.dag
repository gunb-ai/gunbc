// ---------------------------------------------------------------------------------------------
// BUSINESS REFUSALS - channels the selection deliberately does not carry as candidates. A
// refusal is a typed row with its authority named, never a silent omission, so the census
// denominator stays auditable.
// ---------------------------------------------------------------------------------------------

type RefusedChannel {
  label: NonEmptyStr
  cause: NonEmptyStr
  authority: NonEmptyStr
}

data refused_channels: List<RefusedChannel> = [
  RefusedChannel {
    label: "Equinix Secaucus campus (NY2/NY4/NY5/NY6)",
    cause: "Operator ruling in the compute-infrastructure strategy provider shortlist: skip Equinix - the premium interconnection campus prices far above this deployment's needs. The campus stays modeled in extdeps.colo.equinix as the market's price ceiling.",
    authority: "docs/strategy/2026-08-09-compute-infrastructure-strategy.md Appendix B, restated 2026-08-18",
