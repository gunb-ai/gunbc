// THE ROSTER LIST IS NOT THE REGIME LIST. These are CONTROL ROSTERS keyed by the register's own
// regime id; the population of regimes is the register's (strategy.compliance_posture
// compliance_regimes), and audit_regimes below is derived from it by joining on that id. An earlier
// cut authored a second list of twelve and kept it equal to the register with a witness - two
// sources and a check, where DESIGN section 5 asks for one authority and a derivation (review
// 65088). A regime the register carries and this list does not now REFUSES, typed and named,
// instead of quietly shrinking the population.
data regime_rosters: List<RegimeRoster> = [
  roster_soc2,
  roster_gdpr,
  roster_pci,
  roster_us_state,
  roster_iso,
  roster_hipaa,
  roster_sanctions,
  roster_export,
  roster_data_act,
  roster_breach,
  roster_nis2,
  roster_dora,
]

// ONE MATCH ON THE POSTURE THE REGISTER DECLARES. An excluded regime's controls are wrapped so that
// every row shows the exclusion policy AND what enforces it; every other posture leaves the control
// carrier as the roster authored it. Re-posturing HIPAA in the register is therefore all it takes
// to stop the packet rendering exclusions - no roster edit, and no possibility of the two
// disagreeing.
fn posture_carrier(
  posture: CompliancePosture,
  register_row: DeclarationRef,
  carrier: EvidenceCarrier,
) -> EvidenceCarrier {
  match posture {
    ExcludedByProductPolicy { policy: _ } =>
      PolicyExclusionCarrier { policy: register_row, enforcement: carrier }
    DesignConstraintNow { carrier: _ } => carrier
    DeferredUntil { trigger: _ } => carrier
    NotApplicable { reason: _ } => carrier
  }
}

fn postured_control(c: AuditControl, posture: CompliancePosture, register_row: DeclarationRef) -> AuditControl {
  AuditControl {
    id: c.id,
    question: c.question,
    question_standing: c.question_standing,
    evidence_kind: c.evidence_kind,
    carrier: posture_carrier(posture: posture, register_row: register_row, carrier: c.carrier),
  }
}

fn postured_controls(roster: RegimeRoster, posture: CompliancePosture) -> List<AuditControl> {
  map(roster.controls, c => postured_control(c: c, posture: posture, register_row: roster.register_row))
}

// THE REGISTER'S OWN POSTURE TEXT, RENDERED FROM THE REGISTER. Roster prose that restates a posture
// rots the day the register is re-postured - review 65109 caught exactly that, with ISO and NIS2
// obligations still saying "deferred" after the register had moved them to agent-buildable controls
// under seek-all-now. The prose is corrected, and beside it the packet now prints the posture the
// register carries AT RENDER TIME, derived by this match rather than transcribed: a reader sees the
// register's current decision even if a roster sentence ages.
fn posture_summary(posture: CompliancePosture) -> String {
  match posture {
    DesignConstraintNow { carrier: c } =>
      join(["Register posture: DESIGN CONSTRAINT NOW - ", c as String], "")
    DeferredUntil { trigger: t } =>
      join(["Register posture: DEFERRED UNTIL - ", t as String], "")
    ExcludedByProductPolicy { policy: p } =>
      join(["Register posture: EXCLUDED BY PRODUCT POLICY - ", p as String], "")
    NotApplicable { reason: r } =>
      join(["Register posture: NOT APPLICABLE - ", r as String], "")
  }
}

type RegimeBinding
  = RegimeBound { regime: AuditRegime }
  | RegimeRosterMissing { regime_id: NonEmptyStr }

fn roster_for(regime_id: String) -> List<RegimeRoster> {
  filter(regime_rosters, r => r.regime_id as String == regime_id)
}

fn bind_regime(r: ComplianceRegime) -> RegimeBinding {
  match list_head(xs: roster_for(regime_id: r.id as String)) {
    HeadAbsent => RegimeRosterMissing { regime_id: r.id }
    HeadFound { value: roster } =>
      RegimeBound {
        regime: AuditRegime {
          regime_id: r.id,
          register_row: roster.register_row,
          posture_summary: posture_summary(posture: r.posture),
          authority: roster.authority,
          controls: postured_controls(roster: roster, posture: r.posture),
          overlaps: roster.overlaps,
        },
      }
  }
}

data regime_bindings: List<RegimeBinding> = map(compliance_regimes, r => bind_regime(r: r))

fn bound_regimes(bindings: List<RegimeBinding>) -> List<AuditRegime> {
  fold(bindings, init: [], f: fn(acc, b) {
    match b {
      RegimeBound { regime } => concat(acc, [regime])
      RegimeRosterMissing { regime_id: _ } => acc
    }
  })
}

fn regimes_without_rosters(bindings: List<RegimeBinding>) -> List<NonEmptyStr> {
  fold(bindings, init: [], f: fn(acc, b) {
    match b {
      RegimeBound { regime: _ } => acc
      RegimeRosterMissing { regime_id: id } => concat(acc, [id])
    }
  })
}

// THE REGIMES THE BUTTON ANSWERS FOR, derived from the register in the register's order.
data audit_regimes: List<AuditRegime> = bound_regimes(bindings: regime_bindings)

fn regime_control_ids(r: AuditRegime) -> List<String> {
  map(r.controls, c => c.id as String)
}

// AN OVERLAP IS A CITATION TOO, and until review 65003 nothing checked it: the witness counted the
// overlaps and read none of them, so a row could point at a control that does not exist - or, as it
// did, at a control answering a different question - and the packet printed it as the place the
// question is answered. The join below is what the witness folds; the note beside each row is prose
// and stays a reviewer's problem, but the TARGET is now decidable.
fn overlap_target_exists(o: ControlOverlap) -> Bool {
  fold(audit_regimes, init: false, f: fn(acc, r) {
    if acc {
      true
    } else {
      r.regime_id as String == o.other_regime_id as String
        && fold(regime_control_ids(r: r), init: false, f: fn(a, c) {
             if a { true } else { c == o.other_control_id as String }
           })
    }
  })
}

fn unresolved_overlaps(r: AuditRegime) -> List<ControlOverlap> {
  filter(r.overlaps, o => !overlap_target_exists(o: o))
}

fn overlap_source_exists(r: AuditRegime, o: ControlOverlap) -> Bool {
  fold(regime_control_ids(r: r), init: false, f: fn(a, c) {
    if a { true } else { c == o.control_id as String }
  })
}

fn misattached_overlaps(r: AuditRegime) -> List<ControlOverlap> {
  filter(r.overlaps, o => !overlap_source_exists(r: r, o: o))
}

fn find_regime(regime_id: String) -> List<AuditRegime> {
  filter(audit_regimes, r => r.regime_id as String == regime_id)
}

// DISPATCH READS THE BINDING, NOT THE FLATTENED LIST. bound_regimes drops the RegimeRosterMissing
// arm by construction, so asking the flattened list "is there a regime with this id" answered NO
// for a regime the REGISTER carries whose control roster is missing - the button then said "no such
// regime in the compliance register", which is a false statement about the register and throws away
// the one diagnosis that would have been actionable (operator merge review, 2026-09-13). Two
// materially different failures were wearing one message. They are now two.
fn binding_regime_id(b: RegimeBinding) -> String {
  match b {
    RegimeBound { regime } => regime.regime_id as String
    RegimeRosterMissing { regime_id } => regime_id as String
  }
}

fn binding_for(regime_id: String) -> List<RegimeBinding> {
  filter(regime_bindings, b => binding_regime_id(b: b) == regime_id)
}

fn missing_roster_refusal(regime_id: String) -> String {
  join([
    "REFUSED: regime '", regime_id,
    "' IS carried by the compliance register (strategy.compliance_posture compliance_regimes) and",
    " this module carries no control roster for it, so there is no packet to emit and no honest",
    " empty one either. Add a RegimeRoster whose regime_id is '", regime_id,
    "' - an unrostered register row is a regime the operator cannot audit, which is a different",
    " defect from asking for a regime that does not exist.",
  ], "")
}

// The button over a binding, so the missing-roster path is reachable from a witness: every register
// row carries a roster today, so nothing can reach that arm through an id.
fn button_for_binding(binding: RegimeBinding) -> CliWireResponse {
  match binding {
    RegimeBound { regime } => button_for_regime(regime: regime)
    RegimeRosterMissing { regime_id } =>
      CliWirePrintable {
        bytes: missing_roster_refusal(regime_id: regime_id as String),
        exit: ExitFailure {
          code: 1,
          reason: join([
            "regime ", regime_id as String,
            " is in the compliance register and has no control roster in strategy.audit_regimes",
          ], ""),
        },
      }
  }
}

// THE BUTTON, AND THERE IS ONLY ONE OF IT. An earlier cut had two entries - a String-returning
// renderer and a CliWireResponse process entry - each constructing the unknown-regime refusal from
// its own literal list, and the witness pinned the renderer while the operator ran the process
// entry. That is the second-authority defect this module argues against elsewhere, applied to its
// own front door: the untested copy could have had its ExitFailure turned into ExitSuccess and the
// roster would have stayed green (review 64979). One construction now, and the witness mutates ITS
// exit.
//
//   gunbc run --source-root dag --source-root src/v2 --source-root private_overlay/dag \
//     --entry private_overlay/dag/strategy/audit_regimes.dag --function audit_button \
//     --arg regime_id=hipaa
//
// It prints the packet and EXITS NONZERO when there is no packet to trust - an unknown regime id,
// or a roster row whose citation no longer resolves. A refused packet still PRINTS, because its
// content is the repair list; printing and exiting zero is the shape that would let a broken roster
// reach an auditor. gunbc.cli_wire exists for exactly this pair of facts.
fn unknown_regime_refusal(regime_id: String) -> String {
  join([
    "REFUSED: no regime '", regime_id,
    "' in the compliance register roster. Known ids: ",
    join(map(audit_regimes, r => r.regime_id as String), ", "),
  ], "")
}

// THE EXIT MATCHES THE SUM, not a Bool over it. Reading a coproduct through an is_* predicate and
// then branching discards the payload the refusal needs - here, how many rows must be repaired -
// and forces a second walk to recover it (the DispositionStanding precedent in
// product.fabric.provider_admission). One match, and the count comes from the arm.
fn packet_exit(regime_id: String, p: AuditPacket) -> ProcessExit {
  match p {
    PacketRendered { regime: _, readings: _ } => ExitSuccess
    PacketRefused { regime_id: _, refusals: rs } =>
      ExitFailure {
        code: 1,
        reason: join([
          "audit packet refused for ", regime_id, ": ", to_string(count(rs)),
          " roster row(s) cite a declaration the corpus does not carry; the printed document names every one.",
        ], ""),
      }
  }
}

// Split from audit_button so the refusal path is REACHABLE FROM A WITNESS: a refusing roster cannot
// be reached through a regime id, because every id in the register resolves today. The fixtures
// exercise this, and audit_button is one lookup in front of it.
// THE RESPONSE IS DECIDED BY BOTH FACTS: whether the roster resolved, and whether the document
// could be emitted at all. A rejected emit exits NONZERO even over a packet that resolved, because
// the reader is holding no packet either way - and the bytes still say which, because a refusal a
// reader cannot diagnose is a blank page with a status attached.
fn button_response(regime_id: String, p: AuditPacket, rendering: PacketRendering) -> CliWireResponse {
  match rendering {
    PacketRenderRejected { reason } =>
      CliWirePrintable {
        bytes: rendering_bytes(rendering: rendering),
        exit: ExitFailure {
          code: 1,
          reason: join(["audit packet for ", regime_id, " could not be emitted: ", reason], ""),
        },
      }
    PacketBytes { html: _ } =>
      CliWirePrintable {
        bytes: rendering_bytes(rendering: rendering),
        exit: packet_exit(regime_id: regime_id, p: p),
      }
  }
}

// Split from audit_button so the refusal path is REACHABLE FROM A WITNESS: a refusing roster cannot
// be reached through a regime id, because every id in the register resolves today.
fn button_for_regime(regime: AuditRegime) -> CliWireResponse {
  let p = packet(regime: regime)
  button_response(regime_id: regime.regime_id as String, p: p, rendering: render_packet(p: p))
}

fn audit_button(regime_id: String) -> CliWireResponse {
  match list_head(xs: binding_for(regime_id: regime_id)) {
    HeadAbsent =>
      CliWirePrintable {
        bytes: unknown_regime_refusal(regime_id: regime_id),
        exit: ExitFailure {
          code: 1,
          reason: join(["no such regime in the compliance register: ", regime_id], ""),
        },
      }
    HeadFound { value: binding } => button_for_binding(binding: binding)
  }
}

// ONE PROJECTION, ONE MATCH, BOTH FACTS. This front door used to carry button_exited_zero and
// button_exit_reason: a Bool over the two-arm ProcessExit, and then a SECOND walk of the same
// response to recover the payload the Bool discarded - which is the shape strategy.audit_packet
// forbids in its own body where packet_is_refused used to be (review 65019 caught the module
// contradicting itself at its front door). A reader of a CLI response wants both facts a CLI
// produces, so the projection hands over both at once.
//
// THE UNPRINTABLE ARM IS REAL AND IS NOT THIS MODULE'S TO PRODUCE. gunbc.cli_wire makes the illegal
// pairing -- no bytes, yet a success exit -- unwritable by giving CliWireUnprintable no exit field.
// The button never constructs it (it renders through std.markdown, not through a terminal-write
// projection), but a reader of a response must still answer for it, and answering "no bytes, did
// not exit zero" is the honest projection rather than a default that hides a refusal.
type ButtonReading {
  bytes: String
  exited_zero: Bool
  exit_reason: String
}

fn read_button(response: CliWireResponse) -> ButtonReading {
  match response {
    CliWirePrintable { bytes, exit: e } =>
      match e {
        ExitSuccess => ButtonReading { bytes: bytes, exited_zero: true, exit_reason: "" }
        ExitFailure { code: _, reason: r } =>
          ButtonReading { bytes: bytes, exited_zero: false, exit_reason: r }
      }
    CliWireUnprintable { cause } =>
      ButtonReading {
        bytes: join(["REFUSED: nothing printable - ", cause as String], ""),
        exited_zero: false,
        exit_reason: cause as String,
      }
  }
}
