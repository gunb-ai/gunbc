module strategy.audit_regimes

import std.types { Bool, String, List, NonEmptyStr, Int }
import std.decl_ref { DeclarationRef, decl_ref }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }
import strategy.compliance_posture {
  ComplianceRegime, CompliancePosture,
  DesignConstraintNow, DeferredUntil, ExcludedByProductPolicy, NotApplicable,
  compliance_regimes,
}
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import gunbc.cli_wire { CliWireResponse, CliWirePrintable, CliWireUnprintable }
import strategy.audit_packet {
  AuditRegime, AuditControl, ControlOverlap, EvidenceCarrier,
  ReceiptCarrier, DeclaredCarrier, RegisterProseCarrier, ObligationCarrier, PolicyExclusionCarrier,
  EvidenceKind, PolicyDocumentAsk, ContractTermAsk, ControlRecordAsk, ExecutedRefusalAsk,
  ChangeRecordAsk, InventoryRosterAsk, TrainingRecordAsk, TestExerciseAsk,
  AuditPacket, PacketRendered, PacketRefused, packet,
  PacketRendering, PacketBytes, PacketRenderRejected, render_packet, rendering_bytes,
}

// THE TWELVE ROSTERS, ONE PER REGISTER ROW. strategy.compliance_posture names twelve regimes and
// says, in prose, which construction will carry each. This module turns that into the question an
// auditor actually asks - one row per control - so the answer can be DERIVED by resolving the
// carrier instead of read out of the register's paragraph.
//
// THIS MODULE DOES NOT EDIT THE REGISTER. It reads it: every row whose evidence is still the
// register's own prose cites the register row itself, and renders as Prose. Replacing those prose
// carriers with roster rows inside compliance_posture is a SECOND change, after the posture
// revision carrier lands beside it.
//
// EVERY QUESTION IS TRANSCRIBED, NOT QUOTED (DESIGN 4d). No framework text has been retrieved by
// this lane. What a SOC 2 or HIPAA audit "typically asks" is an inference from practice, and
// asserting it as the framework's requirement would be the over-assertion arm of epistemic
// humility. So every question below carries TranscribedUncited with the read that would ground it,
// the packet prints that beside each row, and the rows climb one at a time as texts are retrieved
// and pinned.
//
// WHAT A ROSTER MAY NOT DO is omit a control because nothing carries it. An Absent row is a true
// statement about this repository; an omitted row is a claim that the framework does not ask.

// A ROSTER IS WHAT THIS MODULE OWNS: the controls a framework is understood to ask about, the
// declaration carrying the register row they belong to, and the overlap map. Posture, and the
// population of regimes itself, belong to the register and are read from it.
//
// register_row is authored rather than derived because a .dag value cannot name the declaration
// that holds it: the register's rows are ComplianceRegime VALUES, and the packet cites the
// DECLARATION. That citation is resolved by the lens like every other, so a renamed register row
// refuses the packet rather than printing a dead name.
type RegimeRoster {
  regime_id: NonEmptyStr
  register_row: DeclarationRef
  authority: CitedFigureStanding
  controls: List<AuditControl>
  overlaps: List<ControlOverlap>
}

fn transcribed(read_obligation: String) -> CitedFigureStanding {
  TranscribedUncited { read_obligation: read_obligation }
}

fn register_row(name: String) -> DeclarationRef {
  decl_ref(module_path: "strategy.compliance_posture", decl_name: name)
}

fn control(
  id: String,
  question: String,
  read_obligation: String,
  kind: EvidenceKind,
  carrier: EvidenceCarrier,
) -> AuditControl {
  AuditControl {
    id: id,
    question: question,
    question_standing: transcribed(read_obligation: read_obligation),
    evidence_kind: kind,
    carrier: carrier,
  }
}

fn typed_by(module_path: String, decl_name: String) -> EvidenceCarrier {
  DeclaredCarrier { declaration: decl_ref(module_path: module_path, decl_name: decl_name) }
}

fn prose_of(regime_decl: String) -> EvidenceCarrier {
  RegisterProseCarrier { register_row: register_row(name: regime_decl) }
}

fn owed(obligation: String) -> EvidenceCarrier {
  ObligationCarrier { obligation: obligation }
}

// READ OBLIGATIONS NAME THE OFFICIAL TEXT AND THE RETRIEVAL, not "look it up". A read obligation a
// reader cannot execute is the same unpinned claim in a longer sentence.
data soc2_read: String = "Retrieve the AICPA Trust Services Criteria (TSP section 100, current edition) from the AICPA and pin the criterion text for each control below; the points of focus, not this transcription, are what an auditor works from."
data hipaa_read: String = "Retrieve 45 CFR Parts 160 and 164 (HIPAA Administrative Simplification, Security and Breach Notification Rules) from eCFR and pin the safeguard text; HHS business-associate guidance is a second citation, not a substitute for the rule text."
data gdpr_read: String = "Retrieve Regulation (EU) 2016/679 from EUR-Lex and pin Articles 28, 30, 32, 33, 44-49; EDPB guidance on Article 3 territorial scope is a second citation."
data pci_read: String = "Retrieve PCI DSS v4.x and SAQ-A from the PCI Security Standards Council document library and pin the eligibility criteria and the SAQ-A requirement set."
data us_state_read: String = "Retrieve the operative text of each state statute this row spans (CCPA/CPRA as amended, NJ Data Protection Act, NY SHIELD Act) from each state's official code publisher and pin the processor-contract and reasonable-security provisions."
data iso_read: String = "Retrieve ISO/IEC 27001:2022 and its Annex A control set from ISO and pin the clause text; the standard is licensed, so the pin is to the purchased copy's representation."
data sanctions_read: String = "Retrieve OFAC's sanctions compliance program framework and the SDN list publication terms from the US Treasury and pin the five program elements."
data export_read: String = "Retrieve the EAR (15 CFR Parts 730-774) from eCFR and pin the deemed-export and end-use/end-user provisions; ITAR (22 CFR 120-130) is a second citation for the excluded class."
data data_act_read: String = "Retrieve Regulation (EU) 2023/2854 (Data Act) from EUR-Lex and pin Chapter VI switching, export and charge provisions with their application dates."
data breach_read: String = "Retrieve each notification statute this matrix spans (GDPR Art. 33/34, NJ, NY, and the contractual clocks in the DPA and cyber policy) and pin the recipient, deadline, threshold and sequencing text per row."
data nis2_read: String = "Retrieve Directive (EU) 2022/2555 from EUR-Lex and pin the Annex I/II scope entries and the size-cap provisions, plus the national implementation that would apply."
data dora_read: String = "Retrieve Regulation (EU) 2022/2554 from EUR-Lex and pin Article 30 contractual provisions and the critical-ICT-third-party designation criteria."

// ---------------------------------------------------------------------------
// SOC 2 - the largest roster, and the one enterprise procurement asks for first.
// ---------------------------------------------------------------------------

data soc2_controls: List<AuditControl> = [
  control(
    id: "soc2-change-management",
    question: "How does a change reach production, and what record shows the change was reviewed and tested before it did?",
    read_obligation: soc2_read,
    kind: ChangeRecordAsk,
    carrier: typed_by(module_path: "gunbc.merge_admission", decl_name: "merge_admission_enforcement_policy"),
  ),
  control(
    id: "soc2-change-gate-roster",
    question: "Which checks must pass before a merge is admitted, and how is that set itself controlled against silent edit?",
    read_obligation: soc2_read,
    kind: ChangeRecordAsk,
    carrier: typed_by(module_path: "gunbc.merge_admission", decl_name: "current_gate_roster_hash"),
  ),
  control(
    id: "soc2-required-lanes",
    question: "Which CI lanes are required rather than advisory, and what makes a failing lane block a merge?",
    read_obligation: soc2_read,
    kind: ControlRecordAsk,
    carrier: typed_by(module_path: "gunbc.witness_floor_workflow", decl_name: "required_lanes_roster"),
  ),
  control(
    id: "soc2-logical-access",
    question: "How is access to production systems and secrets granted, scoped and revoked?",
    read_obligation: soc2_read,
    kind: ControlRecordAsk,
    carrier: typed_by(module_path: "gunbc.auth.secret_access_admission", decl_name: "SecretAccessAdmission"),
  ),
  control(
    id: "soc2-privileged-access",
    question: "Which grants are privileged, who holds them, and what bounds their use?",
    read_obligation: soc2_read,
    kind: ControlRecordAsk,
    carrier: typed_by(module_path: "std.scoped_authorization", decl_name: "AuthorizationScope"),
  ),
  control(
    id: "soc2-credential-rotation",
    question: "How often are credentials rotated, and what evidences a completed rotation?",
    read_obligation: soc2_read,
    kind: ControlRecordAsk,
    carrier: typed_by(module_path: "gunbc.auth.secret_rotation", decl_name: "SecretRotationIntent"),
  ),
  control(
    id: "soc2-access-review",
    question: "Show the periodic review of who has access, with the joiner/mover/leaver records behind it.",
    read_obligation: soc2_read,
    kind: ControlRecordAsk,
    carrier: owed("No access-review construction exists. Owed: a typed review cycle over the grant roster, producing a receipt per reviewed principal, with the leaver path revoking before the review rather than at it."),
  ),
  control(
    id: "soc2-vendor-review",
    question: "Which subprocessors and vendors are used, and what review and contract terms cover each?",
    read_obligation: soc2_read,
    kind: InventoryRosterAsk,
    carrier: owed("No subprocessor roster exists as a typed carrier. Owed: one row per subprocessor with its data classes, region, contract reference and review date, and a change-notice obligation joined to the customer DPA."),
  ),
  control(
    id: "soc2-incident-response",
    question: "What is the incident response process, who owns it, and show an exercise of it.",
    read_obligation: soc2_read,
    kind: TestExerciseAsk,
    carrier: owed("No incident-response control exists. Owed: typed incident states with an owner, the notification matrix row this repository already names as an obligation, and a recorded exercise - the exercise, not the document, is what the audit consumes."),
  ),
  control(
    id: "soc2-vulnerability-management",
    question: "How are vulnerabilities discovered, triaged and patched within a stated window?",
    read_obligation: soc2_read,
    kind: ControlRecordAsk,
    carrier: owed("No vulnerability-management control exists. Owed: a dependency and image inventory joined to an advisory feed, with a typed remediation deadline per severity and a receipt per closed finding."),
  ),
  control(
    id: "soc2-backup-restore",
    question: "What is backed up, how often, and when was a restore last tested?",
    read_obligation: soc2_read,
    kind: TestExerciseAsk,
    carrier: prose_of(regime_decl: "compliance_storage_tie_note"),
  ),
  control(
    id: "soc2-physical-access",
    question: "Who can physically reach the machines, and how is that control inherited from the facility?",
    read_obligation: soc2_read,
    kind: ControlRecordAsk,
    carrier: owed("Physical access is inherited from the colocation facility and no inheritance row exists. Owed: the facility's own attestation as a cited authority, plus the list of controls this repository relies on it for rather than implements."),
  ),
  control(
    id: "soc2-monitoring",
    question: "What is monitored, what alerts, and who responds?",
    read_obligation: soc2_read,
    kind: ControlRecordAsk,
    carrier: owed("No monitoring control exists as a typed carrier. Owed: the observed surfaces, the alert conditions, the recipient, and the standing evidence that an alert reached a person."),
  ),
  control(
    id: "soc2-training",
    question: "What security training do personnel receive, and how is completion recorded?",
    read_obligation: soc2_read,
    kind: TrainingRecordAsk,
    carrier: owed("No training control exists. At current headcount this is one person, which changes the evidence shape but not the obligation: a dated completion record per person per period."),
  ),
  control(
    id: "soc2-encryption",
    question: "How is customer data encrypted at rest and in transit, and how are the keys managed?",
    read_obligation: soc2_read,
    kind: ControlRecordAsk,
    carrier: owed("No encryption control exists as a typed carrier. This row was added because the HIPAA roster had nowhere honest to point: its encryption question was mapped onto the access-admission carrier, which answers who may reach a secret and says nothing about how bytes are protected (review 65003). Owed: the at-rest and in-transit surfaces named with what encrypts each, and the key custody - per-tenant keys are also what makes the GDPR deletion states answerable under cross-tenant dedup."),
  ),
  control(
    id: "soc2-asset-inventory",
    question: "What systems and assets are in scope, and how is the inventory kept current?",
    read_obligation: soc2_read,
    kind: InventoryRosterAsk,
    carrier: typed_by(module_path: "strategy.asset_inventory", decl_name: "q80_inventory_lot"),
  ),
  control(
    id: "soc2-continuity",
    question: "What happens if the primary site or provider is lost, and when was that tested?",
    read_obligation: soc2_read,
    kind: TestExerciseAsk,
    carrier: owed("No continuity control exists. The storage-tiering row already records the argument that a single provider or credential failure domain out-blasts disposable drives; what is owed is the tested second recovery copy and the exit path, not a further statement of the risk."),
  ),
]

data roster_soc2: RegimeRoster = RegimeRoster {
  regime_id: "soc2-type2",
  register_row: register_row(name: "regime_soc2"),
  authority: transcribed(read_obligation: soc2_read),
  controls: soc2_controls,
  overlaps: [],
}

// ---------------------------------------------------------------------------
// HIPAA - the discriminating regime. The posture is EXCLUSION BY PRODUCT POLICY, which is a
// product decision and not a legal impossibility, so every row must show the policy, what
// ENFORCES the policy, and where the underlying control is answered for every other customer.
// "Not applicable" is exactly the answer this register was corrected away from.
// ---------------------------------------------------------------------------

// THE EXCLUSION IS NOT RE-ENCODED HERE. strategy.compliance_posture already owns whether a regime
// is excluded by product policy - ExcludedByProductPolicy on the register row - and an earlier cut
// hardcoded a PolicyExclusionCarrier around every HIPAA control, which is the same fact authored
// twice: re-posture the register and the roster would have gone on wrapping (review 65088). The
// wrap is now DERIVED from the posture the register carries, by the one match below, so this
// roster states controls and the register states posture.

data hipaa_controls: List<AuditControl> = [
  control(
    id: "hipaa-baa",
    question: "Is a business associate agreement in place, and what does it cover?",
    read_obligation: hipaa_read,
    kind: ContractTermAsk,
    carrier: owed("No BAA is offered. The enforcing construction owed is the contract term itself as a typed carrier - a prohibition in the terms of service with a stated consequence - rather than the register's paragraph describing it."),
  ),
  control(
    id: "hipaa-workload-prohibition",
    question: "How is it ensured that regulated health data is not processed on this infrastructure?",
    read_obligation: hipaa_read,
    kind: ExecutedRefusalAsk,
    carrier: owed("The REFUSAL MECHANISM exists and the PHI RULE does not, and those are different facts (review 65003). product.fabric.provider_admission carries a prohibited-use program arm and the typed refusal it produces - the sanctions roster's abuse-prohibited-use row cites them, and the overlap map below points here - but no declared rule in that program names protected health information, so nothing in this tree refuses a PHI workload today. Owed: a prohibited-use rule naming PHI, joined to that program. Citing the program itself as PHI enforcement would report the machinery as the policy."),
  ),
  control(
    id: "hipaa-known-phi-refusal",
    question: "What happens when a workload is known to carry protected health information?",
    read_obligation: hipaa_read,
    kind: ExecutedRefusalAsk,
    carrier: owed("Same gap as the row above, at the moment of admission rather than in the policy: DispositionStanding can carry a refusal with its cause, but no cause declared anywhere in the tree is 'this workload carries PHI'. Owed: the standing minted from the PHI rule, which is what would make a known-PHI workload refuse rather than merely be refusable."),
  ),
  control(
    id: "hipaa-detected-phi-containment",
    question: "What happens when protected health information is detected after the fact - suspend, contain, return or delete?",
    read_obligation: hipaa_read,
    kind: ControlRecordAsk,
    carrier: owed("The register states the intended posture - suspend, contain, return-or-delete, incident obligations preserved - and nothing carries it. Owed: typed containment states with the disposition of the data at each, because an exclusion whose detection path is undefined is an exclusion in name only."),
  ),
  control(
    id: "hipaa-encryption",
    question: "How is data encrypted at rest and in transit?",
    read_obligation: hipaa_read,
    kind: ControlRecordAsk,
    carrier: owed("Answered for every customer by the SOC 2 roster rather than by a HIPAA-specific control; see the overlap map below. HHS holds that encrypted ePHI without the key can still make a provider a business associate, so encryption is not what carries this exclusion and is not offered as though it were."),
  ),
  control(
    id: "hipaa-access-control",
    question: "Who can access customer data, and how is that access controlled and reviewed?",
    read_obligation: hipaa_read,
    kind: ControlRecordAsk,
    carrier: DeclaredCarrier {
      declaration: decl_ref(module_path: "gunbc.auth.secret_access_admission", decl_name: "SecretAccessAdmission"),
    },
  ),
  control(
    id: "hipaa-breach-notification",
    question: "What is the breach notification obligation and its clock?",
    read_obligation: hipaa_read,
    kind: PolicyDocumentAsk,
    carrier: prose_of(regime_decl: "regime_breach_matrix"),
  ),
  control(
    id: "hipaa-audit-controls",
    question: "What audit controls record access to systems that could hold protected health information?",
    read_obligation: hipaa_read,
    kind: ControlRecordAsk,
    carrier: owed("Answered by the SOC 2 monitoring control, which is itself Absent today; see the overlap map. Stating it as inherited coverage would report as present a control neither roster carries."),
  ),
]

data hipaa_overlaps: List<ControlOverlap> = [
  ControlOverlap {
    control_id: "hipaa-encryption",
    other_regime_id: "soc2-type2",
    other_control_id: "soc2-encryption",
    note: "Encryption is a SOC 2 roster question for every customer and reads Absent there too - one repair closes both rows. It previously pointed at the access-admission row, which answers who may reach a secret and not how bytes are protected; that was two answers for one question (review 65003).",
  },
  ControlOverlap {
    control_id: "hipaa-access-control",
    other_regime_id: "soc2-type2",
    other_control_id: "soc2-logical-access",
    note: "Both rows cite gunbc.auth.secret_access_admission SecretAccessAdmission - the same carrier, which is why this is an overlap rather than two constructions.",
  },
  ControlOverlap {
    control_id: "hipaa-workload-prohibition",
    other_regime_id: "sanctions-and-abuse",
    other_control_id: "abuse-prohibited-use",
    note: "The prohibited-use refusal mechanism lives on the sanctions-and-abuse roster and reads Typed there. This row stays Absent because that program declares no PHI rule: the mechanism is present, the policy it would enforce is not.",
  },
  ControlOverlap {
    control_id: "hipaa-known-phi-refusal",
    other_regime_id: "sanctions-and-abuse",
    other_control_id: "sanctions-disposition-record",
    note: "The disposition carrier that would record a refusal and its cause is the same one the sanctions roster cites; what is missing here is a declared PHI cause for it to carry, not the carrier.",
  },
  ControlOverlap {
    control_id: "hipaa-audit-controls",
    other_regime_id: "soc2-type2",
    other_control_id: "soc2-monitoring",
    note: "Both rosters read Absent here, and they read Absent for one reason: no monitoring carrier exists. One repair closes both rows.",
  },
  ControlOverlap {
    control_id: "hipaa-breach-notification",
    other_regime_id: "breach-notification-matrix",
    other_control_id: "breach-matrix-rows",
    note: "The notification clocks live in the breach matrix regime, which is a matrix over jurisdiction, role and data class rather than a per-regime control.",
  },
]

data roster_hipaa: RegimeRoster = RegimeRoster {
  regime_id: "hipaa",
  register_row: register_row(name: "regime_hipaa"),
  authority: transcribed(read_obligation: hipaa_read),
  controls: hipaa_controls,
  overlaps: hipaa_overlaps,
}

// ---------------------------------------------------------------------------
// The remaining ten. Mostly Absent by construction, and that is the point: the rosters exist so
// that pressing the button for any register row returns the framework's questions with this
// repository's honest answer, rather than returning nothing for ten of twelve regimes.
// ---------------------------------------------------------------------------

data gdpr_controls: List<AuditControl> = [
  control(
    id: "gdpr-art28-dpa",
    question: "Is there a processor agreement meeting Article 28, and what does it bind?",
    read_obligation: gdpr_read,
    kind: ContractTermAsk,
    carrier: prose_of(regime_decl: "regime_gdpr"),
  ),
  control(
    id: "gdpr-records-of-processing",
    question: "Show the records of processing for both roles - controller and processor.",
    read_obligation: gdpr_read,
    kind: InventoryRosterAsk,
    carrier: owed("No records of processing exist as a typed carrier. Owed: one row per processing activity with role, purpose, data classes, recipients, transfers and retention - for BOTH roles, which the register already distinguishes."),
  ),
  control(
    id: "gdpr-deletion",
    question: "When a customer asks for deletion, what is actually deleted, and when?",
    read_obligation: gdpr_read,
    kind: ControlRecordAsk,
    carrier: owed("The register names the intended construction - deletion as typed states covering access revocation, logical reference deletion, key destruction, physical deletion, backup expiry and legal hold - and nothing carries it yet. Owed: those states as a coproduct, with a per-tenant key so that 'your bytes were erased' is answerable under cross-tenant deduplication."),
  ),
  control(
    id: "gdpr-subprocessors",
    question: "Which subprocessors process personal data, and how are customers notified of changes?",
    read_obligation: gdpr_read,
    kind: InventoryRosterAsk,
    carrier: owed("Shares the missing subprocessor roster with the SOC 2 vendor-review row; one construction closes both."),
  ),
  control(
    id: "gdpr-transfers",
    question: "What transfers leave the EEA, and on what lawful basis?",
    read_obligation: gdpr_read,
    kind: ContractTermAsk,
    carrier: owed("No transfer assessment exists. Owed: the transfer map - object storage, logs, telemetry, backups and support access, not just the runner - joined to the mechanism relied on for each."),
  ),
  control(
    id: "gdpr-region-admission",
    question: "If a customer pins a region, what enforces the pin across every data path?",
    read_obligation: gdpr_read,
    kind: ExecutedRefusalAsk,
    carrier: owed("NOTHING ENFORCES A REGION PIN, and this row said otherwise for one revision. It cited gunbc.fabric_executor_class CapacityClassAdmission, whose producer admits an executor against a CAPACITY CLASS - control-plane versus customer - and never reads a region: the module does not contain the word (operator merge review, 2026-09-13). Capacity segregation is not geographic enforcement. Owed: an admission that refuses placement, object storage, logs, telemetry, backups and support access outside the customer's pinned region, since a pin the runner honours and the log sink does not is not a pin."),
  ),
  control(
    id: "gdpr-security-art32",
    question: "What technical and organisational measures secure the processing?",
    read_obligation: gdpr_read,
    kind: ControlRecordAsk,
    carrier: owed("Answered in substance by the SOC 2 roster's access, change and monitoring rows, and therefore Absent to exactly the extent those are. No separate Article 32 statement is offered, because a statement that restates absent controls reads as coverage."),
  ),
  control(
    id: "gdpr-dsr-assistance",
    question: "How does the processor assist the controller with data subject requests?",
    read_obligation: gdpr_read,
    kind: ContractTermAsk,
    carrier: owed("No assistance path exists. Owed: the tenant-scoped read that answers an access request and the deletion states that answer an erasure request, plus the contractual response window."),
  ),
]

data roster_gdpr: RegimeRoster = RegimeRoster {
  regime_id: "gdpr-processor",
  register_row: register_row(name: "regime_gdpr"),
  authority: transcribed(read_obligation: gdpr_read),
  controls: gdpr_controls,
  overlaps: [],
}

data pci_controls: List<AuditControl> = [
  control(
    id: "pci-saq-a-eligibility",
    question: "On what basis does this entity self-assess at SAQ-A rather than a fuller SAQ?",
    read_obligation: pci_read,
    kind: PolicyDocumentAsk,
    carrier: prose_of(regime_decl: "regime_pci"),
  ),
  control(
    id: "pci-no-card-data",
    question: "Where could a primary account number enter the system, and what prevents it?",
    read_obligation: pci_read,
    kind: ExecutedRefusalAsk,
    carrier: owed("The register's invariant - no card-data type exists - is necessary and not sufficient, and it is not carried by a construction that refuses. Owed: the payment-event redaction path and the absence of PAN in logs, analytics, support and webhooks, each as a typed refusal rather than an absence nobody checks."),
  ),
  control(
    id: "pci-provider-aoc",
    question: "Show the attestation of compliance for the payment provider whose elements render the payment page.",
    read_obligation: pci_read,
    kind: PolicyDocumentAsk,
    carrier: owed("No provider attestation is held as a cited authority. Owed: the provider's current AOC retrieved and pinned, because SAQ-A eligibility depends on it and a lapsed attestation changes the eligibility rather than merely the paperwork."),
  ),
  control(
    id: "pci-page-elements",
    question: "Which scripts execute on the payment page, and who controls them?",
    read_obligation: pci_read,
    kind: InventoryRosterAsk,
    carrier: owed("No script inventory exists for the payment page. This is the row the register's external review added: a browser tag can observe what the backend never stores, so the backend invariant does not answer it."),
  ),
  control(
    id: "pci-annual-validation",
    question: "When was the SAQ last completed and by whom?",
    read_obligation: pci_read,
    kind: ControlRecordAsk,
    carrier: owed("No SAQ has been completed. Owed: the dated self-assessment, which is an annual obligation rather than a launch one."),
  ),
]

data roster_pci: RegimeRoster = RegimeRoster {
  regime_id: "pci-dss-saq-a",
  register_row: register_row(name: "regime_pci"),
  authority: transcribed(read_obligation: pci_read),
  controls: pci_controls,
  overlaps: [],
}

data us_state_controls: List<AuditControl> = [
  control(
    id: "us-state-processor-terms",
    question: "Do the processor terms carry the instructions, confidentiality, security, subprocessor, deletion and assessment obligations each state requires?",
    read_obligation: us_state_read,
    kind: ContractTermAsk,
    carrier: prose_of(regime_decl: "regime_us_state_privacy"),
  ),
  control(
    id: "us-state-reasonable-security",
    question: "What reasonable security safeguards are in place, in the terms the applicable state statute uses?",
    read_obligation: us_state_read,
    kind: ControlRecordAsk,
