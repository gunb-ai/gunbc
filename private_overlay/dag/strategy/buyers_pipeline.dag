  viability_source: "ci_node_build mt_collins_system_lot PurchaseReceipt - the market-cleared executed price stands as the wall for any remainder; a proper derivation from the node-economics spread is the open obligation",
  wanted: DemandQuantityUnestablished {
    candidate_units: 0,
    candidate_derivation: fleet_convergence_gap_derivation,
    blocked_on: "no demand warrant for a barebones remainder is recorded: the executed purchase (ci_node_build mt_collins_system_lot) records what was BOUGHT -- twenty ordered beside the held pilot -- and the derivation candidate is 0 because held plus ordered equals target_collins_nodes; an earlier row stated a 1-unit remainder of the original 21 on that receipt, which a purchase record does not establish",
  },
  qualification_note: "Intake workflow phases 1-5 within the return window; random-sample selection from the seller manifest, never seller-picked units. REFERENCE RE-BASED 2026-08-30 on the executed 20-unit purchase at 1,700 pre-tax plus 75 observed freight",
  refusal_conditions: ["seller will not palletize or quote freight", "quantity claimed but not verifiable at purchase time"],
}

