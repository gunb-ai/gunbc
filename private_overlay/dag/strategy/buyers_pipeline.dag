module strategy.buyers_pipeline

import std.types { Int, List, NonEmptyStr, Bool, String }
import std.decl_ref { DeclarationRef, decl_ref }
import strategy.owner_action { RamPurchaseStanding, RamHeldCensusIdentityGap, RamHeldQualificationGap, ram_purchase_standing_text, current_ram_purchase_standing }

// THE BUYERS PIPELINE (operator direction 2026-08-29): the operator inputs the parts and
// configurations we need supply for; an LLM scout workflow continuously scans listings
// (eBay and peers), files typed observations, and PROPOSES purchases - and the authority
// split is the load-bearing design: A SCOUT MAY OBSERVE AND PROPOSE, NEVER APPROVE. The
// approval act is the operator's, out of band of the scout (the same reason scaffold
// approval is external to the diff: an agent that can write a proposal can equally write
// a row claiming it was approved). Everything the fragility discipline learned binds
// here: an unverified listing quantity counts as ZERO depth, price is delivered-and-
// qualified (freight, expected yield), and a proposal that exceeds its demand row's
// ceiling is a typed refusal, not a judgment call.

type ConditionClass
  = ListedWorking
  | ListedForParts
  | ListedBiosTestedOnly

// TWO PRICES, TWO FACTS (operator correction 2026-08-30): we do not SET ceilings.
// reference_unit_micro is a dated market quote/estimate - expected to drift UP as our own
// buying consumes depth, and refreshed by executed purchases. viability_ceiling_micro is
// the only refusal wall, and it is DERIVED from a named economics instrument (the price
// at which the build stops surviving), never taste. A listing above reference but under
// viability is an ordinary admissible buy - that spread is exactly what the pipeline is
// solving for: the real cost of converging the fleet against a moving market.
// THE WANTED QUANTITY CARRIES ITS EVIDENTIARY STANDING, NOT A BARE Int. A demand row's quantity is
// either ESTABLISHED -- units plus the declaration that establishes them (an executed purchase
// receipt, an operator ruling recorded on the row) -- or UNESTABLISHED, in which case the
// derivation's figure is kept as the typed bet it is (DESIGN 4d: an inference is typed as a bet,
// neither deleted nor promoted) beside what establishing it is blocked on. The operator's ruling is
// that purchase counts establish neither deployable nodes nor RAM demand, and the fleet-convergence
// gap is a planning target minus a purchase count; so until the held population is identity-
// reconciled and qualified, the RDIMM and NVMe figures are candidates and nothing downstream may
// read a candidate as demand: propose() refuses a purchase quantity against it, and the buyer
// sheet's intent admission refuses with it.
//
// A PURCHASE RECORD IS NOT A DEMAND WARRANT. A receipt establishes what was bought; the demanded
// remainder beyond it is a separate fact that needs its own declaration, so no established arm
// cites a strategy.ci_node_build lot observation as its authority (the witness holds that at
// identity grain). The Mt. Collins row once did exactly that -- "1-unit remainder of the original
// 21" on the 20-unit receipt -- while the derivation, held pilot plus twenty ordered, says 0.
//
// WHY THIS IS NOT extdeps.external_authority CitedFigureStanding. That carrier is the right home
// for a figure warranted by an EXTERNAL authority (CitedToAuthority holds an ExternalAuthority
// URI) or transcribed uncited with a read obligation. Neither arm fits here: the establishing
// warrant is an internal declaration (a receipt row, a ruling on the row), and the unestablished
// arm must carry the candidate figure and its derivation so the bet stays typed instead of
// vanishing into a read obligation. Reusing it would have put a DeclarationRef where a URI is
// declared, or dropped the candidate.
type DemandQuantityStanding
  = DemandQuantityEstablished { units: Int, authority: DeclarationRef }
  | DemandQuantityUnestablished { candidate_units: Int, candidate_derivation: DeclarationRef, blocked_on: NonEmptyStr }

fn demand_quantity_text(q: DemandQuantityStanding) -> String {
  match q {
    DemandQuantityEstablished { units: u, authority: a } => join(["wanted ", to_string(u), " (established by ", a.module_path as String, " ", a.decl_name as String, ")"], "")
    DemandQuantityUnestablished { candidate_units: _, candidate_derivation: d, blocked_on: b } => join(["wanted: NOT ESTABLISHED -- the ", d.module_path as String, " ", d.decl_name as String, " figure is a derivation candidate, not demand; blocked on: ", b as String], "")
  }
}

// THE FLEET-DERIVED ROWS SHARE ONE ROOT: the node count. strategy.fleet_convergence component_gap
// multiplies target_collins_nodes by the per-node BOM line and subtracts purchase counts. That is
// the derivation candidate for both the RDIMM and the cache-NVMe rows, and both are unestablished
// while strategy.owner_action ram_purchase_standing is a gap: the held population that would turn
// the node count into a fleet is not identity-reconciled (RamHeldCensusIdentityGap) or not
// qualified (RamHeldQualificationGap). Neither arm establishes a quantity, so this fold has no
// established outcome today; an established RAM standing is owner_action's to add, and this fold
// would then gain the arm that reads it.
data fleet_convergence_gap_derivation: DeclarationRef = decl_ref(module_path: "strategy.fleet_convergence", decl_name: "component_gap")

fn fleet_derived_quantity_standing(candidate_units: Int, standing: RamPurchaseStanding) -> DemandQuantityStanding {
  match standing {
    RamHeldCensusIdentityGap => DemandQuantityUnestablished {
      candidate_units: candidate_units,
      candidate_derivation: fleet_convergence_gap_derivation,
      blocked_on: join(["the node count (strategy.fleet_convergence target_collins_nodes) is a planning target and purchase counts establish neither deployable nodes nor demand (operator ruling); RAM standing reads '", ram_purchase_standing_text(s: standing), "'"], "") as NonEmptyStr,
    }
    RamHeldQualificationGap => DemandQuantityUnestablished {
      candidate_units: candidate_units,
      candidate_derivation: fleet_convergence_gap_derivation,
      blocked_on: join(["the node count (strategy.fleet_convergence target_collins_nodes) is a planning target and purchase counts establish neither deployable nodes nor demand (operator ruling); RAM standing reads '", ram_purchase_standing_text(s: standing), "'"], "") as NonEmptyStr,
    }
  }
}

type DemandRow {
  id: NonEmptyStr
  spec: NonEmptyStr
  reference_unit_micro: Int
  viability_ceiling_micro: Int
  viability_source: NonEmptyStr
  wanted: DemandQuantityStanding
  qualification_note: NonEmptyStr
  refusal_conditions: List<NonEmptyStr>
}

// Standing demand, seeded 2026-08-29. Ceilings come from the modeled economics, not
// hope: the Collins ceiling is the analyst's hedge-priced ~$1,000; the EPYC ceiling is
// dollar-per-core parity with the Collins row (~$11/core x 128 cores, delivered).
