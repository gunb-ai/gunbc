data buyer_demand_rows: List<DemandRow> = [
  demand_mt_collins,
  demand_epyc_rome_platform,
  demand_ddr4_rdimm,
  demand_u2_nvme,
]

// ---------------------------------------------------------------------------------------------
// Observations and proposals: what the scout files. Depth discipline baked into the type:
// claimed quantity and verified quantity are different fields, and admitted depth reads
// ONLY the verified one.
// ---------------------------------------------------------------------------------------------

type ListingObservation {
  demand_id: NonEmptyStr
  source: NonEmptyStr
  unit_price_delivered_micro: Int
  quantity_claimed: Int
  quantity_verified: Int
  seller_feedback_permille: Int
  seller_feedback_count: Int
  condition: ConditionClass
  observed_at: NonEmptyStr
}

fn admitted_depth(o: ListingObservation) -> Int {
  o.quantity_verified
}

type PurchaseProposal
  = ProposalAdmissible { demand_id: NonEmptyStr, source: NonEmptyStr, units: Int, unit_price_micro: Int }
  | ProposalRefusedOverCeiling { demand_id: NonEmptyStr, unit_price_micro: Int, ceiling_micro: Int }
  | ProposalRefusedNoVerifiedDepth { demand_id: NonEmptyStr, quantity_claimed: Int }

fn propose(demand: DemandRow, o: ListingObservation) -> PurchaseProposal {
  if o.unit_price_delivered_micro > demand.viability_ceiling_micro {
    ProposalRefusedOverCeiling {
      demand_id: demand.id,
      unit_price_micro: o.unit_price_delivered_micro,
      ceiling_micro: demand.viability_ceiling_micro,
    }
  } else if admitted_depth(o: o) == 0 {
    ProposalRefusedNoVerifiedDepth { demand_id: demand.id, quantity_claimed: o.quantity_claimed }
  } else {
    ProposalAdmissible {
      demand_id: demand.id,
      source: o.source,
      units: if admitted_depth(o: o) < demand.wanted_units { admitted_depth(o: o) } else { demand.wanted_units },
      unit_price_micro: o.unit_price_delivered_micro,
    }
  }
}

data scout_workflow_contract_note: NonEmptyStr = "THE SCOUT WORKFLOW CONTRACT: input is buyer_demand_rows; output is ListingObservation rows plus propose() results; cadence is a scheduled agent run (daily is plenty - liquidation moves in days, not minutes). The scout verifies quantity where the marketplace permits (purchase-quantity probe, seller question) and otherwise files quantity_verified: 0, which propose() turns into a typed refusal rather than a hopeful buy. THE SCOUT NEVER ACTUATES A PURCHASE: an admissible proposal is a message to the operator carrying the demand row, the listing, and the intake obligation it would trigger; the operator's approval and payment are the out-of-band act. Dissolution of the manual step: none planned - purchase actuation staying human is a design decision, not debt."

data epyc_diversity_note: NonEmptyStr = "WHY THE EPYC DEMAND ROW EXISTS (operator 2026-08-29): Ampere is niche - deep TODAY in one rotating liquidation pool, but one channel, and the operator notes his own bias toward it. Rome/Milan dual-socket DDR4 platforms are the closest x86 analog to Mt. Collins/Mt. Jade (same memory grade, same 1DPC discipline, similar dollars-per-core when unlocked), the used market is far wider, and an x86 vintage also unlocks the customer segment whose jobs are x86-only (the Amdahl partition in the gaming-CPU memo applies to ISA too). Known traps priced into the refusal conditions: vendor-locked CPUs saturate the cheap end of the Rome market, and 2x 225W runs hotter than the Altra pair. The pilot is 4 units - prove the second vintage through the same intake, netboot and fabric path before giving it depth; the vintage frontier gets its measured row from the pilot, not from listings."

data architecture_posture_ruling: NonEmptyStr = "OPERATOR RULING 2026-08-30 (v3; v2 reworked after the analyst's final ruling on this thread): ARCHITECTURE IS NOT AN IDEOLOGY, IT IS A CAPEX / LIQUIDATION / ARBITRAGE DECISION. Frozen center, in the analyst's corrected wording: warehoused inventory, cold spares, and pilot/hedge nodes are NOT serving supply - the supply-beneath-demand law is stated over ADMITTED ONLINE owned capacity only, and it holds PER EXECUTION-COMPATIBILITY CLASS (ISA is one hard coordinate; memory/disk envelope, isolation class, restart safety are others), because aggregate demand above aggregate capacity can still strand a whole class (the analyst's 100-ARM/60-ARM-demand counterexample). For each class: admitted online owned capacity stays beneath qualified PAID baseline demand for that class; customer work spills when projected pickup would exceed the class's queue-delay bound; preemptible internal work (dogfood as InternalScavenger, see serving_capacity) fills unused owned capacity and is evicted first. FLEET EXPANSION is authorized by sustained compatible demand and marginal avoided-spill economics - buy the next node when expected avoided spill cost minus owned marginal cost exceeds node fixed cost plus risk reserve - NEVER by a fixed 100-percent-utilization threshold (utilization splits into three readings, also in serving_capacity). ARM leads on both operative axes today (capex per core, watts per core) so the fleet leans ARM; the EPYC pilot STANDS as the supply-diversity hedge against Ampere-channel concentration; x86 spill clears at a premium via a price PER ISA CLASS - two flat prices - but that pricing sentence is DECLARED, NOT LIVE: the economics closure that would carry it (ci_runner_economics / ci_spill_policy / ci_pricing_page) is a rostered KnownRed on extdeps.ci_compute_pricing, and today's surface exposes one flat price, so per-ISA pricing becomes authority only when that closure lands and the pricing page consumes it. Vintage selection stays ISA-neutral: a vintage joins the owned fleet when its liquidation price crosses the frontier, whatever its ISA. ENROLLMENT DEBT, declared: this ruling is consumed today by review diligence and by the typed carriers it names; it becomes structural authority only when purchase admission, the spill router, and the pricing page consume those carriers - that consumer enrollment is the ruling's own dissolution trigger for its prose form."
