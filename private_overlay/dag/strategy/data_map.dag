      },
    },
  ],
  subjects: [CustomerOrgUser, CustomerOrgAdmin],
  purposes: [MeterAndBill, ExecuteCustomerWork],
  lawful_bases: [contract_basis(standing: in_house(
    conclusion: "the measurements are OURS -- we generate them to bill, they are not material the customer handed us -- so we hold them as a controller on the basis of performing the agreement we bill under. Reached in house, and deliberately NOT the processor conclusion the material categories carry: a row that is the input to our own invoice is not a row we handle on someone else's instruction.",
    placement: ReachesACustomerCommitment { commitment: "the bill, and the retention we state for the records it is re-derived from. The period itself is a separate question and still counsel's -- see counsel_retention_period_review on the residency row -- because how long a bill must remain re-derivable is a statutory number and not a basis." },
    falsified_by: "counsel finding, or a customer's DPA asserting that per-job measurements joined to their organisation are their material and not ours.",
  ))],
  standing: proposed(),
}

// CARD DATA IS THE ONE CATEGORY MODELLED BY ITS ABSENCE, and the absence is a residency arm rather
// than a missing row. Leaving it out entirely would make the map silent about payments; giving it a
// retention period would claim custody this map cannot establish.
//
// AND THE ABSENCE IS PROPOSED, NOT DEMONSTRATED, which the earlier wording lost. NotRetainedByUs
// carries strategy.compliance_posture regime_pci as its basis, and that row NAMES REQUIRED CONTROLS --
// hosted checkout or isolated provider elements, the provider AOC, no PAN in logs, analytics, support
// or webhooks, payment-event redaction, annual SAQ validation. Naming a control is not operating it,
// and the row says so itself: the no-card-data invariant is NECESSARY AND NOT SUFFICIENT, because a
// browser script can observe what a backend never stores. So citing it supports a REQUIREMENT that no
// PAN reaches us; it does not establish that none does, and this arm must not be read as a receipt.
data category_account_and_billing_identity: DataCategory = DataCategory {
  decl: "category_account_and_billing_identity",
  marker: personal_identity_ref(),
  scope_note: "Who the customer is: organisation, users and admins, email addresses, authentication identity, billing address and tax status, invoices and payment events. We are a controller for this, not a processor. PROPOSED: no card number reaches us, because payment pages and elements are required to originate from the PCI-compliant provider so the PAN stays theirs. That is the requirement this row records, NOT an established fact - the posture row it cites names those controls rather than demonstrating their operation - so the card entry is an absence with a basis awaiting ratification, not a period and not a receipt.",
  residency: [
    ResidencyRow {
      locus: StoredOnDurableOrigin,
      retention: RetentionBoundedByObligation {
        obligation: tax_and_billing_obligation,
        period: PeriodUndetermined { settled_by: counsel_retention_period_review },
      },
    },
    ResidencyRow {
      locus: OutsideOurCustody { basis: pci_no_card_data_basis() },
      retention: NotRetainedByUs { basis: pci_no_card_data_basis() },
    },
  ],
  subjects: [CustomerOrgUser, CustomerOrgAdmin],
  purposes: [MeterAndBill, Support, LegalObligation],
  lawful_bases: [
    contract_basis(standing: in_house(
      conclusion: "we are a CONTROLLER of account, billing and support identity -- we decided to collect it, for our own purposes -- and the basis for holding it is performance of the agreement the customer signed. Reached in house; the controller reading is the one the whole map is written on.",
      placement: ReachesACustomerCommitment { commitment: "the privacy notice we project from these rows to the account holder, who is our counterparty." },
      falsified_by: "counsel finding, or a supervisory authority reading the account holder's identity as something we hold on another controller's instruction.",
    )),
    legal_obligation_basis(
      obligation: "tax and accounting record retention, and sanctions screening records, in the jurisdictions we sell from and into",
      standing: counsel_required(
        question: counsel_scope_review,
        placement: ReachesASupervisoryAuthority { exposure: "a legal-obligation basis IS a claim about what a statute requires of us, so being wrong is being wrong in front of the authority that wrote it, and the error is not one we can correct by amending anything of ours. This is the placement the rule refuses to let us hold, and it is why counsel is still required here after the rest of the map stopped waiting on it." },
      ),
    ),
  ],
  standing: proposed(),
}

