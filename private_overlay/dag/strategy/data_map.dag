        schedule: TierScheduleUndetermined { partial_tiers: [], settled_by: abuse_backoff_schedule_decision },
      },
    },
  ],
  subjects: [CustomerOrgUser, CustomerOrgAdmin],
  purposes: [SecurityAndAbuse, LegalObligation],
  lawful_bases: [
    security_interest_basis(
      interest: "screening, rescreening on list changes, and abuse investigation, as the provider's own risk-based program rather than a processor's",
      standing: counsel_required(
        question: counsel_scope_review,
        placement: ReachesAThirdPartysRights { rights_holder: "the person or organisation screened, blocked or rejected. A screening decision is made ABOUT someone and acted on WITHOUT their agreement, so being wrong here costs them access and a record, and no amendment of ours gives it back. The correction is not within our gift, which is the test." },
      ),
    ),
    legal_obligation_basis(
      obligation: "sanctions compliance: retaining blocked-versus-rejected dispositions and the evidence behind them for the period the program requires",
      standing: counsel_required(
        question: counsel_scope_review,
        placement: ReachesASupervisoryAuthority { exposure: "sanctions enforcement. Getting blocked-versus-rejected wrong, or failing to retain the evidence behind a disposition, is answered to the authority running the program and not to a customer." },
      ),
    ),
  ],
  standing: proposed(),
}

data data_categories: List<DataCategory> = [
  category_source_and_build_inputs,
  category_build_artifacts,
  category_execution_receipts,
  category_ci_secrets,
  category_job_logs,
  category_metering_telemetry,
  category_account_and_billing_identity,
  category_support_communications,
  category_abuse_and_sanctions_records,
]

// THE NEGATIVE ROW, WHICH IS A CLAIM AND THEREFORE CARRIES A STANDING LIKE ANY OTHER.
//
// "We hold no end-user personal data" is the single most load-bearing sentence a privacy notice for
// this product would contain, and it is not a fact about the world: it is a product policy, in exactly
// the sense strategy.compliance_posture had to correct the HIPAA row into - a ToS exclusion is not a
// legal impossibility, and nobody can guarantee a customer never commits a user table into a
// repository. So the row states the policy, states what would falsify it, and is proposed rather than
// asserted. Modelling it as an absence - simply having no such category - would have made the
// strongest claim in the map the only one with no standing attached.
// THE SURVIVING NAME IS THE BINDER HERE TOO, CORRECTED (review 65354). This carried `id`, a kebab
// business nickname, which is exactly the shape deleted from DataCategory earlier in this PR and for the
// same reason: two naming schemes for one row, and the one a reader can act on is the declaration. The
// correction was applied to categories and NOT to this type, which is the partial-fix shape -- a class
// repaired at the site that was pointed at rather than over its population.
//
// It matters most here of anywhere in the map. This row carries the single most load-bearing claim in it
// -- that we process no end-user personal data -- and its open question goes on the same ratification
// agenda, so an operator reading that agenda was being pointed at a string that is not a declaration and
// cannot be opened. It is now the binder, and the distinctness and citation walls below cover it.
type ScopeExclusion {
  decl: NonEmptyStr
  claim: NonEmptyStr
  policy: NonEmptyStr
  falsified_by: NonEmptyStr
  standing: ProposalStanding
}

data exclusion_end_user_personal_data: ScopeExclusion = ScopeExclusion {
  decl: "exclusion_end_user_personal_data",
  claim: "We process no personal data of our customers' end users. The subjects in this map are our customers' own org users and admins, plus commit authors who appear incidentally inside material we were handed.",
  policy: "The product is a CI service. It is not offered as a place to run workloads over end-user personal data, and no arm of the product solicits, imports or indexes an end-user population.",
  falsified_by: "any product surface that ingests a customer's end-user records, or a discovered instance of a customer processing end-user personal data through jobs with our knowledge - either makes this an inclusion row with its own residency, retention and basis rather than an exclusion",
  standing: proposed(),
}

data scope_exclusions: List<ScopeExclusion> = [exclusion_end_user_personal_data]

// ---------------------------------------------------------------------------------------------
// PROJECTIONS. What a consumer may read out of the map, and which arm it is allowed to read.
// ---------------------------------------------------------------------------------------------

// THE SOURCE-TEXT PATTERN BLOCK THAT STOOD HERE IS DELETED, NOT REWRITTEN (review 65282).
//
// It described a guard deriving the text a row's declaration must contain and requiring it to appear in
// the module's source, and called that derivation "the single authority for the format". Its subject
// declaration is gone: the question moved to v2.std.decl_index and then to v2.std.decl_ref_resolution,
// so nothing in this module reads source text or owns a format. The block had also outlived its body
// far enough to sit above an UNRELATED function, which is the stranded-header defect review 64945
// raised here once already -- a reader would have taken it for a description of agreement_ref_key.
//
// Deleted rather than marked as history because a §4c annotation exists to explain why a construction
// has the shape it has, and this construction does not exist. The history that was worth keeping is the
// fail-open it left behind, and that is recorded where it still bites: on the distinctness conjunct in
// test.claim.data_map_witness, beside the fold that closes it.


// THERE IS NO PATH DERIVATION HERE ANY MORE, AND THAT IS A CORRECTION OF A WRONG ASSUMPTION RATHER
// THAN A REFINEMENT.
//
// This carried module_source_path: join(["dag/", replace(module_path, ".", "/"), ".dag"]). It read
// cleanly for the citations the map holds today, which is exactly why it survived review and my own
// mutation controls. It is wrong for a LARGE FRACTION of the public corpus, because the namespace does
// not mirror the directory.
//
// THE FRACTION IS NAMED AS RE-DERIVABLE RATHER THAN TRANSCRIBED (review 65282). This said "1704 of the
// 4214 modules, measured", and the denominator alone was already stale by the time it was read again --
// `git ls-tree -r --name-only origin/main -- dag | grep -c '\.dag$'` answers 4222 as this is written,
// eight more than the sentence claimed, which is the whole argument against copying a number in beside
// a corpus that grows every day. The durable evidence is not the count but the counterexamples, which
// are stable and checkable one at a time:
// product.fabric.provider_route lives at
// dag/gunbc/product/fabric/provider_route.dag; extdeps.docker lives at dag/extdeps/docker/docker.dag;
// extdeps.shell.mock_corpus lives at dag/extdeps/shell_mock_corpus.dag. So no prefix rule fixes it --
// there is no rule to encode, and encoding one would put a layout assumption in a witness that the
// compiler would then disagree with, where the witness is the one that lies.
//
// The consequence was the bad failure direction: a citation into product.* would have been reported as
// naming NO DECLARATION when the declaration exists, so the wall built to stop fabricated citations
// would have fabricated a defect -- and trained its next reader to disbelieve it. Found by
// snappy-pike-154 while agreeing a cross-lane shape whose citations would have hit it on day one.
//
// The question is now asked of the authority that OWNS it: v2.std.decl_index, which is where the
// resolver gets the same answer. No path, no layout assumption, and it sees fn and type declarations
// too, which the old file grep for `data <name>:` could not.
//
// DEDUPED, because the cost is per lookup and the map cites one agreement seven times -- once per
// category carrying a contract basis. One distinct citation is one keyed read.
fn agreement_ref_key(ref: DeclarationRef) -> String {
  declaration_ref_display_key(ref: ref)
}

fn distinct_agreement_refs() -> List<DeclarationRef> {
  fold(cited_agreement_refs(), init: [], f: fn(acc, ref) {
    if count(filter(acc, seen => agreement_ref_key(ref: seen) == agreement_ref_key(ref: ref))) > 0 {
      acc
    } else {
      concat(acc, [ref])
    }
  })
}

// THE BASIS CITATIONS ARE A POPULATION TOO, AND THEY WERE THE LAST ONE OUTSIDE THE GUARD (review
// 65169). The custody arms carry a DeclarationRef into strategy.compliance_posture, and the card-data
// conjunct only compared both halves of the residency pair against the SAME hand-spelled value -- so two
// hand-copies agreed with each other and the check stayed green whether or not regime_pci existed. That
// is the map's strongest positive claim resting on a citation the change's own index guard never asked
// about, which is the precise class this PR exists to close: this module says two hundred lines up that a
// reference naming nothing "would have named NOTHING while looking exactly like a resolved citation",
// and that is what these two were free to become.
fn residency_basis_refs(c: DataCategory) -> List<DeclarationRef> {
  flat_map(c.residency, r =>
    concat(
      locus_outside_custody_basis(l: r.locus),
      retention_not_retained_basis(r: r.retention),
    ))
}

fn cited_basis_refs() -> List<DeclarationRef> {
  flat_map(data_categories, c => residency_basis_refs(c: c))
}

// THE RULING EVERY IN-HOUSE CONCLUSION RESTS ON, PROJECTED SO THE CITATION WALL REACHES IT (review
// 68506). ConcludedInHouse carries a DeclarationRef naming the operator statement that authorises us to
// hold a legal conclusion at all, and in_house stamps it on every in-house claim, so that one reference
// anchors TEN of the thirteen basis claims -- while the witness's
// resolution fold covered map rows, exclusions, sanctioned profiles and residency bases, and not this.
// A renamed declaration or a wrong module_path would have resolved to nothing with nothing red, which
// is the exact fail-open compliance_posture_revision records review 64881 catching in refused_by.
//
// The same standard this module states for `placement`: a field carried and never matched is a frontier
// it enrols rather than tolerates. `placement` got its wall; `ruling` had neither, and now has the one
// that fits it -- resolution rather than a policy fold, because what can go wrong with a citation is
// that it names nothing.
fn claim_ruling_ref(c: LawfulBasisClaim) -> List<DeclarationRef> {
  match c.standing {
    ConcludedInHouse { conclusion, ruling, placement, falsified_by } => [ruling]
    CounselReviewRequired { question, placement } => []
    CounselOpinionOnRecord { opinion } => [opinion]
  }
}

fn cited_ruling_refs() -> List<DeclarationRef> {
  flat_map(data_categories, c => flat_map(c.lawful_bases, b => claim_ruling_ref(c: b)))
}

fn cited_agreements() -> List<AgreementAuthority> {
  flat_map(data_categories, c => flat_map(c.lawful_bases, b => basis_agreement(b: b.basis)))
}

fn cited_agreement_refs() -> List<DeclarationRef> {
  flat_map(cited_agreements(), a => agreement_landed_ref(a: a))
}

fn unlanded_agreement_landings() -> List<NonEmptyStr> {
  flat_map(cited_agreements(), a => agreement_pending_landing(a: a))
}

data data_map_module_path: NonEmptyStr = "strategy.data_map"


// THE PROFILE REFERENCE, DERIVED FROM THE ROW. This is the join that makes the map a consumed
// authority rather than a document: product.fabric.provider_admission's data_handling_profile is an
// open DeclarationRef, and this function is what a private route sanction cites into it. Deriving it
// from `decl` rather than writing the pair out beside each sanction is the difference between one
// authority and a second table that can disagree with this one.
//
// This header sat stranded above a different declaration for one commit, describing a function two
// declarations away -- a claim separated from its body, which is the defect 0fba336 fixed in the
// sibling module. Noted by review 64945 and moved back onto its subject.
fn category_profile_ref(c: DataCategory) -> DeclarationRef {
  decl_ref(module_path: data_map_module_path as String, decl_name: c.decl as String)
}

// AND THE SAME REFERENCE FOR AN EXCLUSION ROW, so that the name on the ratification agenda is one the
// citation wall has to resolve rather than one a reader has to trust (review 65354). Without this the
// binder rename would fix the string and leave it unchecked, which is half a repair.
fn exclusion_profile_ref(e: ScopeExclusion) -> DeclarationRef {
  decl_ref(module_path: data_map_module_path as String, decl_name: e.decl as String)
}

fn exclusion_refs() -> List<DeclarationRef> {
  map(scope_exclusions, e => exclusion_profile_ref(e: e))
}

// WHAT MAY BE PROJECTED TO A CUSTOMER, AND IT IS EMPTY TODAY BY CONSTRUCTION RATHER THAN BY
// OVERSIGHT. A privacy notice or a security schedule is a statement we are held to, so it may only be
// projected from ratified rows. Every row is proposed as this lands, so this list is empty today --
// the honest state of a map nobody has ratified yet, and the thing that changes in one pass.
//
// THE WITNESS DOES NOT ASSERT THE EMPTINESS, CORRECTED (review 65282). This sentence previously said it
// did. That assertion existed and was DELIBERATELY REMOVED as one of the four state-pinning tripwires
// (review 64875): `count(ratified_categories()) == 0` made the single ratification pass this module
// exists to enable turn the enforced roster red, which is a tripwire across the only exit rather than a
// wall. What the witness asserts instead is the property holding on BOTH sides of the pass -- a ratified
// row carries no open question -- and it REPORTS the count, because an operator reads that count as a
// live fact and reporting a fact is not pinning it.
fn ratified_categories() -> List<DataCategory> {
  filter(data_categories, c => standing_is_ratified(s: c.standing))
}

fn proposed_categories() -> List<DataCategory> {
  filter(data_categories, c => !standing_is_ratified(s: c.standing))
}

// THE AGENDA FOR THE RATIFICATION PASS, which is the other half of the same match: what the operator
// is being asked. One entry per open question, so a pass is finished when this is empty rather than
// when someone says it is.
type OpenQuestion {
  subject: NonEmptyStr
  question: NonEmptyStr
}

fn category_open_questions(c: DataCategory) -> List<OpenQuestion> {
  concat(
    map(standing_open_question(s: c.standing), q => OpenQuestion { subject: c.decl, question: q }),
    concat(
      map(
        flat_map(c.residency, r => retention_open_question(r: r.retention)),
        q => OpenQuestion { subject: c.decl, question: q },
      ),
      map(
        flat_map(c.lawful_bases, b => claim_open_question(c: b)),
        q => OpenQuestion { subject: c.decl, question: q },
      ),
    ),
  )
}

fn ratification_agenda() -> List<OpenQuestion> {
  concat(
    flat_map(data_categories, c => category_open_questions(c: c)),
    flat_map(scope_exclusions, e =>
      map(standing_open_question(s: e.standing), q => OpenQuestion { subject: e.decl, question: q })),
  )
}

// WHO DECIDES A QUESTION IS ONE FACT, AND THIS QUEUE USED TO ANSWER IT FROM A DIFFERENT SOURCE THAN THE
// ROWS DID (review 66342). It folded only over lawful_bases, so it WAS counsel's queue exactly while
// counsel's only questions were lawful-basis ones. This change broke that coincidence: two rows now route
// their open DURATION to counsel_retention_period_review, a counsel question that is not a lawful basis
// and so could never appear here -- while the witness report printed this count labelled "for counsel".
// The operator would have been told N questions are counsel's while N+2 were. That is the defect this
// change names one row over, running the other way: an act that IS counsel's and is not in counsel's
// queue.
//
// THE QUEUE NOW DERIVES FROM THE ROSTER RATHER THAN FROM A SHAPE. counsel_owned_questions is the single
// authority for "counsel decides this", and both the agenda membership test below and any future counsel
// question join it by identity instead of by which field the question happened to hang from. Widening
// rather than relabelling was the choice because the alternative -- saying in the report that the count
// covers lawful basis only -- leaves the operator reading a number that is true and answers a question
// nobody asked.
data counsel_owned_questions: List<NonEmptyStr> = [counsel_scope_review, counsel_retention_period_review]

fn question_is_counsel_owned(q: NonEmptyStr) -> Bool {
  count(filter(counsel_owned_questions, owned => owned == q)) > 0
}

fn counsel_review_queue() -> List<OpenQuestion> {
  filter(ratification_agenda(), q => question_is_counsel_owned(q: q.question))
}

// EVERY ROW OWNS ITS OWN decl, AND NOTHING CHECKED THAT UNTIL NOW (review 65047).
//
// THE FAIL-OPEN IT CLOSES, WHICH SAT BEHIND AN ANNOTATION OF MINE CLAIMING IT WAS ALREADY COVERED.
// Copy a category row, leave the `decl` field pointing at the ORIGINAL's binder, and add no proposal of
// its own. Then: proposal_for_category matches on the profile reference, which is built from `decl`, so
// the copy finds the OTHER row's proposal and every_category_has_a_carriage_position counts exactly one;
// and the source-binder guard passes too, because a declaration of that name genuinely exists -- the
// original's. Both walls green. And since use_scope_for_category also derives the profile from `decl`,
// the new, unsanctioned category is ADMITTED by admit_provider_use on the covered row's sanction. A
// fail-open in the exact join this change exists to close.
//
// Duplication only redded when the copy ALSO got its own proposal, which is the opposite of the
// forgetful case. My annotation said distinctness "already has a home"; it did not, in the direction
// that matters, and a wrong claim of coverage is worse than no claim because the next reader stops
// looking.
//
// WHAT THIS DOES NOT CLOSE, stated rather than implied: two rows whose decl fields are SWAPPED are
// distinct and both exist, so both this conjunct and the source guard pass while each row's profile
// names the other's declaration. Closing that needs a declaration to know its own binder name -- the
// reflection the substrate deliberately does not have (std.decl_ref says so where it explains why a
// DeclarationRef is a record of strings). TRIGGER: a compiler-provided self-reference for a
// declaration, at which point `decl` stops being an authored field and this conjunct dissolves with it.
// THE UNIVERSE IS EVERY RATIFIABLE ROW, WHICH IT WAS NOT (review 65354). This folded over
// data_categories alone, so an exclusion row could duplicate a category's decl -- or another exclusion's
// -- and nothing said so. A guard whose universe is narrower than the population its claim covers is the
// same defect as a stale description: the sentence "every row owns its own decl" was true only of the
// rows the fold happened to reach.
fn row_decls() -> List<NonEmptyStr> {
  concat(map(data_categories, c => c.decl), map(scope_exclusions, e => e.decl))
}

fn distinct_row_decls() -> List<NonEmptyStr> {
  fold(row_decls(), init: [], f: fn(acc, d) {
    if count(filter(acc, seen => seen == d)) > 0 { acc } else { concat(acc, [d]) }
  })
}

fn every_row_owns_its_own_decl() -> Bool {
  count(distinct_row_decls()) == count(row_decls())
}

// AND THE WALL THAT KEEPS THE POLICY HONEST: nothing may be held in house whose placement the rule
// above says is not ours to hold. Without this, `in_house` is a constructor anyone can point at any
// row, and the placement field becomes decoration -- carried, never matched, exactly the frontier
// shape this module enrolls elsewhere rather than tolerates.
fn in_house_claims_are_within_our_placement(claims: List<LawfulBasisClaim>) -> Bool {
  all(claims, c => match c.standing {
    ConcludedInHouse { conclusion, ruling, placement, falsified_by } =>
      placement_is_ours_to_hold(p: placement)
    CounselReviewRequired { question, placement } => true
    CounselOpinionOnRecord { opinion } => true
  })
}

fn every_in_house_conclusion_is_ours_to_hold() -> Bool {
  all(data_categories, c => in_house_claims_are_within_our_placement(claims: c.lawful_bases))
}

// AND ONE MARKER PER ROW, WHICH IS THE WALL THAT KEEPS A SPLIT SPLIT. product.data_class
// admit_data_effect resolves a category by filtering the map for every row whose reference matches and
// then judging the UNION of them, so two description rows sharing one marker do not conflict -- they
// silently merge. category_build_artifacts and category_execution_receipts were separated on the
// operator's 2026-09-14 ruling precisely because their retention and purposes differ; pointing both at
// BuildOutput would have re-admitted an artifact under the obligation-bounded retention and the
// MeterAndBill purpose that only the receipt carries, one layer below where anyone was looking. So the
// split is not finished by this module alone: it required the ExecutionReceipt marker in the public tree,
// and this conjunct is what says so in a form a run can fail on.
//
// THE UNIVERSE IS data_categories AND NOT THE EXCLUSIONS, deliberately: a scope exclusion has no marker
// because a category with no marker has no Classified constructor and no sink, which is the type-level
// form of the exclusion itself (product.data_category says this from the other side).
fn row_marker_keys() -> List<NonEmptyStr> {
  map(data_categories, c => declaration_ref_display_key(ref: c.marker))
}

fn distinct_row_marker_keys() -> List<NonEmptyStr> {
  fold(row_marker_keys(), init: [], f: fn(acc, k) {
    if count(filter(acc, seen => seen == k)) > 0 { acc } else { concat(acc, [k]) }
  })
}

fn every_category_owns_its_own_marker() -> Bool {
  count(distinct_row_marker_keys()) == count(row_marker_keys())
}

// EVERY CATEGORY ANSWERS ALL FOUR QUESTIONS. A row missing its residency, its purposes, its subjects
// or its basis is a category we have named without saying anything about it, which is worse than an
// absent row because it counts as coverage.
fn category_is_complete(c: DataCategory) -> Bool {
  count(c.residency) > 0
    && count(c.purposes) > 0
    && count(c.subjects) > 0
    && count(c.lawful_bases) > 0
}

fn population_is_complete(categories: List<DataCategory>) -> Bool {
  all(categories, c => category_is_complete(c: c))
}

fn map_is_complete() -> Bool {
  population_is_complete(categories: data_categories)
}

// WHAT RATIFICATION MUST MEAN, STATED SO THAT RATIFYING IS LEGAL AND FAKING IT IS NOT.
//
// THIS REPLACES A WALL THAT FORBADE THE WRONG THING, and the correction is worth recording because
// the first shape was actively harmful rather than merely weak. no_unfunded_counsel_conclusion
// asserted `all(bases => !counsel_is_settled(...))` and was a merge-blocking conjunct of the enforced
// witness. Read as an invariant it says: no lawful basis may EVER be settled. So the moment counsel
// issued a real opinion - the intended next action, the thing CounselOpinionOnRecord exists for - the
// private roster went red, and the only way forward was to delete the conjunct. It therefore MANDATED
// the "later author wanting a green deletes the check" move its own annotation claimed to prevent, and
// it declared an arm of this module's coproduct that nothing could ever construct. Review 64875 caught
// it. DESIGN 4d's second arm is exactly this failure: a mechanism that forbids more than the evidence
// supports costs the thing you never did, and it looks like rigor.
//
// THE PROPERTY THAT WAS MEANT, and it survives both transitions: a RATIFIED row carries NO open
// question. Ratification is not a flag, it is the claim that the questions got answered - so a row
// whose standing says RatifiedByOperator while a retention period is still Undetermined, or while a
// lawful basis still says CounselReviewRequired, is the cheap fake green this is aimed at, and it is
// now the red. Counsel opining is legal; the operator ratifying is legal; ratifying a row whose
// periods or bases are still open is not, and the ORDER that implies - counsel and periods first, the
// standing last - is the honest one.
//
// ITS RED IS AUTHORABLE, AND IS EXERCISED RATHER THAN ASSUMED. Today no row is ratified, so this fold
// is green over an empty population, which on its own would be an instrument that cannot fail. The
// witness therefore hands this predicate a synthetic ratified-with-an-open-question row and requires
// it to return false, so the check has a subject even while the real population is empty.
//
// WHAT IT CANNOT DO, stated rather than implied: whether a cited ratification record or counsel
// opinion actually exists and says what the row claims is outside the modeled guarantee, exactly as
// the honesty of a clearance stays with whoever issued it. That stays a boundary obligation on the
// author of the row, and no fold here can discharge it.
fn category_settlement_is_coherent(c: DataCategory) -> Bool {
  if standing_is_ratified(s: c.standing) {
    count(category_open_questions(c: c)) == 0
  } else {
    true
  }
}

fn map_settlement_is_coherent() -> Bool {
  all(data_categories, c => category_settlement_is_coherent(c: c))
}

// ---------------------------------------------------------------------------------------------
// THE SEALED DATA-HANDLING MAP. What the fabric's permit fold is allowed to read out of this map.
// ---------------------------------------------------------------------------------------------

// PRODUCT.DATA_CLASS LANDED A CARRIER THIS MAP IS THE ONLY AUTHORISED AUTHOR OF (gunbc#11236), and the
// minting function below is named data_handling_map_rows because product.data_class admit_callers-seals
// data_handling_map to exactly that name and to its own witness fixture. The name is load-bearing: rename
// it and the mint refuses with ConstructorCallAdmissionRefused rather than compiling.
//
// A ROW IS AN AUTHORISATION, NOT A DESCRIPTION, AND THAT DISTINCTION DECIDES EVERYTHING BELOW. The fold
// reads a row and MINTS A PERMIT to perform a data effect. This module's category rows are PROPOSALS, and the reason is the
// STANDING they carry and not the state of their bases -- which is worth stating precisely, because this
// paragraph used to argue it from "every basis carries CounselReviewRequired" and ten of the thirteen
// basis claims no longer do.
// The derivation filters on ProposalStanding; a row whose lawful basis we concluded ourselves is still
// ProposedAwaitingRatification, so the empty map is unchanged and its justification no longer rests on a
// premise this module deleted. Every retention still either names what would settle it or carries a
// policy whose figure does. ONE ROW NOW CARRIES A SETTLED PERIOD -- support communications, twelve months
// -- and that changes nothing here: a settled figure on a proposed row is still a proposal, because the
// standing and the retention are different axes and it is the STANDING this derivation filters on. Deriving an authorisation from a proposal would make the proposal operative with no
// ratification pass, which is the defect this module exists to refuse -- a row that reads as settled fact
// before that pass. So the derivation FILTERS ON RATIFIED STANDING, exactly as ratified_route_sanctions
// does, and today nothing is ratified, so the map has NO ROWS.
//
// AN EMPTY MAP IS THE FAIL-CLOSED DEFAULT AND NOT UNFINISHED WORK. product.data_class says the same of its
// own empty public map. A run under this map admits no data effect and the fabric canary refuses
// CategoryUnmapped; only the operator's ratification pass changes that, and no code here can.
//
// FOUR FACTS A ROW WOULD NEED ARE ESTABLISHED AS UNREAD, which is why the derivation below is narrow rather
// than eight rows of plausible labels. Each is recorded where it is already refused, so that two carriers
// agree instead of quietly disagreeing:
//   RECIPIENTS. product.data_class defines them as this lane's transfer counterparties. gunbc#11213 landed
//     the R2 durable origin as a REFUSAL -- ProviderRouteRegionUnobserved, nine paths ProviderPathUnread,
//     ProviderPathAbsent taken zero times. We have established that we have NOT read where that origin's
//     data goes. extdeps.vendor.cloudflare is landed and citable, and naming it a recipient would assert a
//     transfer we have explicitly established we have not read -- in a carrier that mints a permit.
//   A ROUTE FOR ANY DURABLE SINK. SinkKind DurableOrigin carries a ProviderRoute, and no ProviderRoute
//     declaration exists in this repository: the only construction is route_sanctions_for's PARAMETER,
//     which provider_data_handling_sanction_frontier_rows already carries as a declared frontier.
//   MOST OF THE LOCUS-TO-SINK CORRESPONDENCE. StorageLocus says where data LIVES; SinkKind is the
//     DESTINATION of an effect, and treating one as the other is an inference wearing the shape of a
//     mapping. CORRECTED AFTER review 65710, which caught the earlier wording claiming this module mints
//     no such correspondence AT ALL while the code minted one invisibly: sinks_for_locus DOES map the one
//     pair we can establish -- the operator support surface is a support-export destination, which is
//     near-tautological -- and maps every other locus to NO sink with the reason stated. What the module
//     does not mint is a correspondence for any locus whose destination is unestablished.
//   THE ADMITTED PURPOSES AND OPERATIONS. A row's purposes are the purposes it ADMITS for a sink -- purpose
//     limitation, an authorisation -- and not a transcription of the purposes this map DESCRIBES. Which
//     purposes are admitted for a category is the operator's grant and counsel's question, so they stay
//     empty. An empty list admits nothing and there is no wildcard arm, so the carrier refuses; that is the
//     carrier working rather than a gap for the next author to fill.
//
// SO WHAT THE DERIVATION ACTUALLY IS: the standing filter, plus citations at FIELD GRAIN into the category
// row that already carries each fact. retention and lawful_basis cite decl_field_ref into the row rather
// than minting per-category retention and basis declarations, because the category row is already the one
// authority for both and a second declaration carrying the same fact is the fork DESIGN 3 forbids.
fn data_handling_authority() -> DeclarationRef {
  decl_ref(module_path: data_map_module_path as String, decl_name: "data_handling_map_rows")
}

// ONE TOTAL FUNCTION DECIDES BOTH WHETHER AND WHICH, AND THAT IS THE WHOLE OF review 65710'S FINDING. The
// first shape split the fact in two: a Bool said whether a locus HAD a sink, and a literal one line away
// said WHICH sink every passing locus got. Flipping the Bool's StoredOnDurableOrigin arm to true -- the
// obvious edit the day a ProviderRoute lands -- would then have emitted a SUPPORT-EXPORT row for a durable
// residency: an authorisation to export, minted by an edit that looked like it only unblocked a sink. One
// fact stored twice, where the second copy is invisible from the first.
//
// Now the arm names its own sink or names none, so a future arm cannot inherit another's destination by
// accident, and the zero arms are ANSWERS rather than omissions: a locus with no sink contributes no row,
// which the fold reports as CategoryUnmapped. StoredOnDurableOrigin is empty for a stated reason and not
// for lack of attention -- SinkKind's durable arm requires a ProviderRoute and none is declared here.
fn sinks_for_locus(l: StorageLocus) -> List<SinkKind> {
  match l {
    OperatorSupportSurface => [SupportExport]
    StoredOnDurableOrigin => []
    JobMicroVmTransient => []
    ContentAddressedByHash => []
    ProcessMemoryNeverDurable => []
    OutsideOurCustody { basis } => []
  }
}

// THE ROW'S `category` IS THE PUBLIC MARKER, AND NOTHING ELSE MAY GO IN THAT FIELD. product.data_class
// admit_data_effect compares it against the marker reference carried by the Sink, so a reference into
// THIS module there resolves nothing and refuses CategoryUnmapped on every row the map emits. The other
// two references on the row are not the same kind of thing and are correct as they stand: `retention` and
// `lawful_basis` are open decl_field_refs into this lane's own rows, which is what the public type's own
// annotation says they are -- an authority the fold carries onto the permit without judging.
fn handling_rows_for_category(c: DataCategory) -> List<DataHandlingRow> {
  flat_map(
    c.residency,
    r => map(
      sinks_for_locus(l: r.locus),
      s => DataHandlingRow {
        category: c.marker,
        sink: s,
        purposes: [],
        recipients: [],
        operations: [],
        retention: decl_field_ref(
          module_path: data_map_module_path as String,
          decl_name: c.decl as String,
          field_name: "residency",
        ),
        lawful_basis: decl_field_ref(
          module_path: data_map_module_path as String,
          decl_name: c.decl as String,
          field_name: "lawful_bases",
        ),
        posture: m2_compliance_posture_revision,
      },
    ),
  )
}

// PARAMETRIC AND DELIBERATELY NON-MINTING, which is the whole reason it may take an argument. The mint
// below takes NO parameters, and that is a seal decision rather than a style one: product.data_class's own
// fixture mint fx_map IS parametric, and it is safe only because it carries its own admit_callers list
// naming six exact callers. A parametric mint here with no such list would let any importer pass a
// fabricated ratified category and receive an admitting map -- bypassing the seal through this module's
// front door. This function mints nothing, so a caller handing it fixtures gets rows and no authority.
fn data_handling_rows_for(categories: List<DataCategory>) -> List<DataHandlingRow> {
  flat_map(
    filter(categories, c => standing_is_ratified(s: c.standing)),
    c => handling_rows_for_category(c: c),
  )
}

fn data_handling_map_rows() -> DataHandlingMap {
  data_handling_map(
    authority: data_handling_authority(),
    rows: data_handling_rows_for(categories: data_categories),
  )
}
