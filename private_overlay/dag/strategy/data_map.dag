  marker: support_communication_ref(),
  scope_note: "What a customer told us and what we told them: tickets, email threads, and whatever they pasted into one - which in a CI product is routinely a log excerpt or a snippet of their source, so this category can contain any other category by inclusion. An operator reading a ticket is a data-access path and is treated as one by the export-controls row of strategy.compliance_posture.",
  residency: [
    ResidencyRow {
      locus: OperatorSupportSurface,
      retention: RetentionForPeriod {
        period: PeriodSettled { period: Measure { count: 31536000 }, basis: ticket_retention_note },
      },
    },
  ],
  subjects: [CustomerOrgUser, CustomerOrgAdmin],
  purposes: [Support, SecurityAndAbuse],
  lawful_bases: [
    contract_basis(standing: processor_contract_conclusion()),
    security_interest_basis(
      interest: "keeping a record of what was reported and what we did about it, so an incident or an abuse decision can be re-derived later",
      standing: in_house(
        conclusion: "keeping the record of a support exchange for a bounded period is a legitimate interest, and the period is settled rather than open. Reached in house.",
        placement: CorrectableByUsAlone { correction: "a ticket store we control, a settled twelve-month ceiling, and deletion we can perform ourselves. Nothing outside our custody depends on this being right." },
        falsified_by: "a ticket being read as containing another category by inclusion -- which the scope note already says happens routinely -- in a way that makes the enclosed category's own standing govern instead of this one.",
      ),
    ),
  ],
  standing: proposed(),
}

data category_abuse_and_sanctions_records: DataCategory = DataCategory {
  decl: "category_abuse_and_sanctions_records",
  marker: abuse_and_sanctions_record_ref(),
  scope_note: "The output of our own risk-based programs: screening results against restricted-party lists with their rescreening history, billing and IP-geolocation signals used as inputs, abuse investigations, and blocked-versus-rejected disposition records. strategy.compliance_posture regime_sanctions_abuse is explicit that a payment processor's KYC is an input and not the authority, so these records are ours to keep and ours to justify keeping.",
  residency: [
    ResidencyRow {
      locus: StoredOnDurableOrigin,
