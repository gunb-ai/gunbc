  | CarrierLocal
  | BranchLevel
  | DomainLevel
  | RoomLevel
  | BuildingLevel
  | OutdoorLevel

data boundary_scope_note: String = "CarrierLocal renamed from CassetteLocal (carrier+dependency directive): a cassette is a realization, not a fundamental scope - a tray, panel, chassis, cassette, or tank can all provide a carrier-local boundary."

