}

data custom_dependency_spec_note: String = "A custom object without this complete packet is a prototype artifact, not an operational dependency."

data dependency_budget_note: String = "Dependency budgets are multi-dimensional, never collapsed to money: custom_dependency_count, single_source_dependency_count, vintage_specific_dependency_count, site_specific_dependency_count; custom_tools_required, distinct_material_processes, distinct_connector_families, distinct_coolant_or_fluid_families; hours_to_reproduce, hours_to_replace, hours_to_move_site, hours_to_restore_leasehold; spare_items_required, documentation_burden, qualification_tests_required; assemblies_lost_when_dependency_fails. A design answers in this vocabulary: 'the custom carrier uses one board-specific adapter plate and one board-specific airflow shroud; every other interface is common' - stronger than 'this is reversible'."

type PhysicalDesignRefusal
  = UnjustifiedPhysicalArtifact {
      artifact: String
      note: String
