data printed_part_note: String = "'Printed in PETG' is not a sufficient engineering description: ratings and behavior attach to the validated MATERIAL + PROCESS (+ printer), never the polymer name (UL printed-vs-molded variability - external reading, pin-verification pending). Screening ladder: PLA 50-60C mockups/jigs only; PETG 70-90C cool-zone fixtures; ASA/PC/engineering blends 90-115C warm zones; validated flame-rated material/process near electrical or ignition sources. NOT-PRINTED-FIRST (promotion bar, not prohibition): primary structural attachment, main load plate, cooler clamping hardware, mains enclosures, PSU shells, fire barriers, EMI planes, pressurized manifolds, cold plates, permanent fittings, anything whose failure drops liquid onto lower assemblies, creep-critical brackets. A printed part in any such role is also a CustomFabricationDependency edge with a full CustomPhysicalDependencySpec."

data fabrication_capacity_note: String = "Printer admission under demand-before-capacity: ONE enclosed ~250-300mm-class machine; priority order enclosure, repeatability, ASA/PC/nylon capability, nozzle/hotend, bed, dry handling, filtration, volume LAST. Long ducts are gasketed/interlocking modules; large flat structural pieces go to laser-cut/CNC sheet, extrusion, or outsourced fabrication. >=350mm admitted only on repeated evidence (doesn't fit; segmentation causes a real defect; outsourcing becomes recurring cost/lead-time; same large part repeats across sites)."

type SiteComputeAdmission {
  id: String
  site_id: String
  maximum_continuous_it_power_watts: Nat
  maximum_heat_rejection_watts: Nat
  acoustic_budget_note: String
  structural_load_note: String
  admitted_service_domains_note: String
  maintenance_burden_note: String
  failure_blast_radius_note: String
  evidence: List<EvidenceAnchor>
}

data site_compute_admission_note: String = "SiteComputeAdmission replaces 'rack cap' as the governing site quantity; rack count is display arithmetic derived from the physical design. NO admission row exists yet for site-91-e21st-bayonne: budgets derive from survey receipts still open, and jurisdictional Phase A items outrank them; storing budgets ahead of receipts is the stored-verdict defect site_model already corrected once."

type ComparisonAxis
  = SustainedPerformance
  | PowerDraw
  | ThermalMargin
  | AcousticByZone
  | SpatialFootprint
  | MaterialUse
  | MaintenanceAccess
  | FailureDomainSize
  | Safety
  | BuildAndOperatingCost
  | HabitabilityAcceptance
  | Reversibility
  | HeatUtility
  | DependencyBurden
  | MaintenanceLocality
  | NetworkBurden

data comparison_axes_note: String = "Every candidate realization is compared against the conventional rack CONTROL over one measured workload across all axes. DependencyBurden added (carrier+dependency directive): the discharged demands are weighed against the dependency population introduced, over full expected lifetime. HabitabilityAcceptance keeps the P11 split: measured rows witnessable; comfortable-to-think-in is operator sign-off. Acceptance criterion: a typed comparison showing what each boundary buys, what it costs, what can fail together, and which claims remain hypotheses."

data altrad8ud_reference_assembly: ComputeAssembly = ComputeAssembly {
  id: "asm-altrad8ud-reference",
  role_note: "REFERENCE ASSEMBLY - the conventional, documented normal case. Purpose: prove the generic carrier/service-frame architecture is genuinely simple when hardware presents normal interfaces. Public gunbc already models this board and uses it for srv1-srv4 (fleet_intent, paired with Altra Max M128-30; srv1 hostname fixture altrad8ud-1l2t-1) - consume those authorities by reference, never duplicate them as prose.",
  motherboard: "ASRock Rack ALTRAD8UD-1L2T - consume public authority asrock_altrad8ud_1l2t_catalog (deep micro-ATX 9.6x10.5in, single LGA4926, 8x DDR4 DIMM, onboard BMC/IPMI, PCIe 4.0, dual 10GbE)",
  processors: "1x Ampere Altra Max M128-30 - consume public authority altra_max_m12830_catalog",
  memory: "8x DDR4-3200 RDIMM (all channels populated per bandwidth-before-capacity policy)",
  storage_interfaces: "M.2 + PCIe 4.0 NVMe-capable slots (capabilities only - placement per demand is composed from orthogonal facts and bound via StorageBinding, storage_service_note)",
  network_interfaces: "onboard dual 10GbE",
  management_controller: "onboard BMC/IPMI - consume existing public BMC identity and fan-behavior observations",
  required_native_interconnects: [
    "none beyond standard interfaces - ATX PSU or supported 12V DC input, ordinary connectors; this absence is the point of the reference assembly",
  ],
  evidence: EvidenceAnchor { repo: "gunbc", reference: "asrock_altrad8ud_1l2t_catalog + altra_max_m12830_catalog + dynatron_w1_catalog + fleet_intent", note: "Review-asserted public extdeps authorities (carrier+dependency directive, 2026-08-10); pin-verification against gunb-ai/gunbc pending from this private-overlay session. Dynatron W1 (2U active/passive LGA4926, explicitly supporting this board) is the catalog-supported cooler row. Session hypothesis to verify, not a claim: the owned NH-D9 AMP-4926 pair is LGA4926 - if Noctua's compatibility list admits this board (orientation/clearance on the deep micro-ATX layout), the pair covers two reference nodes; W1 is the fallback." },
}

data mt_jade_stress_assembly: ComputeAssembly = ComputeAssembly {
  id: "asm-mt-jade-pilot-1",
  role_note: "STRESS ASSEMBLY - the proprietary liquidation-vintage case. Purpose: prove the architecture can absorb a strange vintage without making that vintage's quirks universal. Its PDB/CRPS/fan-presence facts are properties of THIS assembly's realizations, never of the generic system (power_split_note).",
  motherboard: "Wiwynn Mt. Jade dual-socket Ampere Altra board (proprietary 2U outline, non-ATX hole pattern - geometry to be measured, captured via printed jig)",
  processors: "2x Ampere Altra 80-core (LGA4926)",
  memory: "16x DDR4-3200 RDIMM channels (2 sockets x 8 channels)",
  storage_interfaces: "NVMe-capable (interfaces verified at arrival; placement per demand composed and bound via StorageBinding, storage_service_note)",
  network_interfaces: "onboard + OCP mezzanine (verify at arrival)",
  management_controller: "AMI MegaRAC BMC (Aptio, project OACOI 1.08.20211002); Redfish surface to be probed at Stage 0",
  required_native_interconnects: [
    "power distribution board (PDB) - proprietary; travels with the board (VintageSpecificDependency)",
    "CRPS PSUs + control wiring into the PDB - relocated intact, never recreated; physically two supplies, operating plan may select one (MultipleSuppliesRequiredByNativeAssembly is a Jade property)",
    "fan-wall PWM/presence wiring - BMC expects it; modified realizations spoof or reconfigure, never surprise it",
  ],
  evidence: EvidenceAnchor { repo: "external", reference: "pilot-order-2026-08-09", note: "One unit ordered 2026-08-09, ~$3-4k, ETA ~30 days; ~75 dB full-load report indicts the fan realization, not the board or power system." },
}

data seed_demands: List<PhysicalFunctionDemand> = [
  PhysicalFunctionDemand {
    id: "dem-jade-airflow-compile",
    consumer_id: "asm-mt-jade-pilot-1",
    function: AirflowGuidance,
    operating_condition: "sustained compile-class load (fixture reference workload: cargo build of gunbc + cold-control run)",
    required_outcome: "CPU and memory within admitted temperatures without the stock fan-wall acoustic realization",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-10-physical-aggregation-directive.md", note: "fixture Stage 1/2 question" },
  },
  PhysicalFunctionDemand {
    id: "dem-site-visual-integration",
    consumer_id: "site-habitability-axis",
    function: VisualIntegration,
    operating_condition: "continuous occupancy of the compute-hosting space by working people",
    required_outcome: "assemblies read as deliberate instruments, not exposed lab debris; coherent physical language per site",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-09-compute-infrastructure-strategy.md", note: "section 0 habitability axis, funded increment ~$3-8k/site" },
  },
  PhysicalFunctionDemand {
    id: "dem-open-compute-contamination-control",
    consumer_id: "zone-open-compute",
    function: DustControl,
    operating_condition: "continuous operation of open or minimally enclosed compute assemblies",
    required_outcome: "no routine assembly-internal cleaning during the admitted service interval (state 24 or 36 months - a bounded horizon, never an unbounded 'never'); contamination does not cause an inadmissible increase in component temperature, fan power, pressure drop, connector failure, or corrosion",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-10-contamination-access-and-storage-directive.md", note: "operator requirement; ASHRAE treats particulate AND gaseous contamination as reliability risks - a visually clean room can still have a corrosion problem" },
  },
  PhysicalFunctionDemand {
    id: "dem-compute-zone-infiltration-control",
    consumer_id: "zone-open-compute",
    function: DustControl,
    operating_condition: "compute zone adjoining ordinary workspace, kitchenette, street door, and any workshop or receiving activity",
    required_outcome: "uncontrolled infiltration does not enter the compute airflow path; cooking, cardboard unpacking, sanding, deliveries, and street-door traffic stay outside it. Topology preference: public/ordinary workspace -> controlled service boundary -> cleaner compute zone; the occupied office is NOT made a cleanroom and people still work alongside and see the machines",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-10-contamination-access-and-storage-directive.md", note: "candidate: filtered supply + slight positive pressure vs uncontrolled areas + controlled return + sealed cable/pipe penetrations" },
  },
  PhysicalFunctionDemand {
    id: "dem-filter-condition-observation",
    consumer_id: "zone-open-compute",
    function: DustControl,
    operating_condition: "filtration in service between replacement intervals",
    required_outcome: "filter loading is observed before it defeats cooling (differential pressure or scheduled condition inspection); filter selection is bounded by the actual air handler's tolerance for pressure drop - a higher-efficiency filter is NOT automatically better, and MERV rating is a realization fact, never the acceptance criterion",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-10-contamination-access-and-storage-directive.md", note: "EPA: MERV 13 or as high as the system can accommodate; select against the real air handler via an HVAC design/commissioning receipt" },
  },
  PhysicalFunctionDemand {
    id: "dem-contamination-serviceability",
    consumer_id: "zone-open-compute",
    function: DustControl,
    operating_condition: "buildout and post-construction periods, plus routine fouling trend observation",
    required_outcome: "construction dust is isolated (compute sealed or offline until post-construction cleaning - buildout dust is unlike operating dust); representative inspection plus thermal trend confirms heatsinks are actually clean, since clean-looking air does not prove clean heatsinks; gaseous-corrosion testing is triggered where site evidence warrants",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-10-contamination-access-and-storage-directive.md", note: "acceptance is outcome-based: FilterInstallationReady, RoomPressureReady, ParticleTrendObserved, ThermalFoulingTrendObserved, NoRoutineAssemblyCleaningReceipt" },
  },
  PhysicalFunctionDemand {
    id: "dem-compute-zone-entry-authorization",
    consumer_id: "zone-compute-service",
    function: PhysicalAccessControl,
    operating_condition: "storefront-sized site with PublicOrHostedZone, StaffZone, and ComputeServiceZone (the first two may combine operationally; the compute zone stays separately controllable)",
    required_outcome: "only active authorized identities enter the compute zone; keycard is the preferred realization but 'keycard lock' is a bundle - identity/credential, authorization policy, reader, local controller, lock/strike, door sensor, request-to-exit, egress behavior, controller power, audit stream, visitor handling, and mechanical override are separate concerns",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-10-contamination-access-and-storage-directive.md", note: "shape: derived access demand x explicit access policy x observed door state -> admitted actuation; NIST physical-security families decompose the same way" },
  },
  PhysicalFunctionDemand {
    id: "dem-credential-revocation",
    consumer_id: "zone-compute-service",
    function: PhysicalAccessControl,
    operating_condition: "lost card, departing employee, or ended contractor window",
    required_outcome: "the credential is denied within the declared revocation time; credential authority is upstream, decision cache is local",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-10-contamination-access-and-storage-directive.md", note: "revocation and audit are the reasons electronic access beats ordinary keys; the landlord master key bypassing the electronic record is a named residual" },
  },
  PhysicalFunctionDemand {
    id: "dem-access-local-continuity",
    consumer_id: "zone-compute-service",
    function: PhysicalAccessControl,
    operating_condition: "WAN or cloud-control-plane outage",
    required_outcome: "ordinary admitted entry continues; a cloud subscription is NEVER the sole source of unlock authority; a controller outage must not lock the operator out",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-10-contamination-access-and-storage-directive.md", note: "prefer a local controller that survives internet loss; OSDP-capable supervised reader wiring is a reasonable selection preference, not a mandate" },
  },
  PhysicalFunctionDemand {
    id: "dem-access-audit-and-door-state",
    consumer_id: "zone-compute-service",
    function: PhysicalAccessControl,
    operating_condition: "continuous operation, including contractor and visitor windows",
    required_outcome: "successful, refused, forced-open, and held-open events remain durable (local buffering with upstream durable replication); the system distinguishes closed, held open, and forced open; visitors receive temporary bounded access or remain escorted",
    source: EvidenceAnchor { repo: "gunbc-private", reference: "docs/strategy/2026-08-10-contamination-access-and-storage-directive.md", note: "do not overfit to theft: unauthorized entry to a customer-code execution zone, device connection to the management network, a propped door, and unaudited contractor entry are the live risks" },
  },
  PhysicalFunctionDemand {
    id: "dem-free-egress",
    consumer_id: "zone-compute-service",
    function: PhysicalAccessControl,
    operating_condition: "loss of software, credential service, or ordinary power",
    required_outcome: "occupants are never trapped; authorized emergency/manual access exists without becoming the routine path. Fail-safe vs fail-secure is DERIVED PER DOOR from egress rules, fire-system integration, and the site authority - never a global enum default",
