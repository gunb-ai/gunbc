module strategy.b2b_capacity_track

import std.types { NonEmptyStr, String, List, Int, Bool }
import std.decl_ref { DeclarationRef, decl_ref, decl_field_ref, declaration_ref_display_key }
import strategy.node_rental {
  market_rows, hetzner_row, admissible_as_competitive_floor,
  region_is_known, supply_is_purchasable, our_cost_per_slice_micro,
}
import strategy.cost_floor { floor_micro_per_unit_minute }
import finance.gunbai_llc { gunbai_facts }

// SELLING COMPUTE CAPACITY TO BUSINESSES, BESIDE THE CI-MINUTES PRODUCT AND NOT INSTEAD OF IT
// (operator direction 2026-09-10: it is kind of a parallel/complementary path, i.e. trying to
// find more customers, b2b vs b2c).
//
// THIS MODULE IS NOT AN ARGUMENT THAT THE B2B TRACK IS CORRECT. Two tracks is a decision over a
// candidate field (DESIGN section 3d, selection precedes convergence), and the field is not
// decided here: strategy.node_rental reports zero of its retail rows admissible as a purchasable
// competitive floor, so the price side of the comparison currently has no ground under it. What
// this module does is make the candidate products DISTINCT, make the join with the existing plan
// EXPLICIT, and make the standing of every claim about American READABLE. A track whose products
// are collapsed into one positioning phrase cannot be ranked at all.
//
// AMERICAN HETZNER IS A POSITIONING PHRASE, NOT A CONTRACT. Three candidate products wear it and
// they have different buyers, different price shapes, different service obligations and different
// legal surfaces; the first job is to stop them sharing a name.
// ---------------------------------------------------------------------------------------------
// 1. THE OFFER SPACE: FOUR ORTHOGONAL AXES, AND OFFERS AS POINTS IN IT
// ---------------------------------------------------------------------------------------------
// THE AXIS CORRECTION, AND IT IS A SECTION-3 REPAIR RATHER THAN A PRESENTATION CHOICE. The first
// shape of this module named bare metal, reservation and CI-reseller as three competing PRODUCTS.
// They are not on one axis at all: bare metal is a RESOURCE BOUNDARY, a reservation is a
// COMMERCIAL MODEL, and a CI company is one possible SALES CHANNEL - and a fourth axis, whether
// the workload is production, turned out to be the one that actually decides feasibility. Three
// orthogonal facts wearing one enum is a meaning fork: it makes combinations unwritable that are
// perfectly real, and it invites an argument true of one axis to be read as true of a product.
// An offer is therefore a POINT in that space, and the rows below are points rather than a
// taxonomy.

// WHERE OUR MANAGEMENT STOPS AND THE CUSTOMER'S BEGINS. The whole per-job cell construction of
// the CI product exists because many tenants share a machine within a day; a boundary at the
// machine is a different and much cheaper obligation.
type ResourceBoundary
  = WholeNodeCustomerManaged { note: NonEmptyStr }
  | PerJobCellWeManage { note: NonEmptyStr }

fn boundary_is_whole_node(b: ResourceBoundary) -> Bool {
  match b {
    WholeNodeCustomerManaged { note } => true,
    PerJobCellWeManage { note } => false,
  }
}

// HOW THE MONEY ARRIVES. A month of a machine and a minute of a job are not two prices for one
// good: the first carries no utilisation guess at all and the second is almost entirely one.
type CommercialModel
  = PerMinuteMetered { note: NonEmptyStr }
  | MonthToMonthRental { note: NonEmptyStr }
  | FixedTermTakeOrPay { term_months: Int, note: NonEmptyStr }

fn commercial_carries_utilization_guess(c: CommercialModel) -> Bool {
  match c {
    PerMinuteMetered { note } => true,
    MonthToMonthRental { note } => false,
    FixedTermTakeOrPay { term_months, note } => false,
  }
}

// WHO WE SELL THROUGH. A reseller is a channel, not a different good - and the channel is where
// the obligations grow, because their downstream customers' security, data-processing and remedy
// obligations flow back to us.
type SalesChannel
  = SelfServeDeveloper { note: NonEmptyStr }
  | DirectToBusiness { note: NonEmptyStr }
  | ThroughCiReseller { note: NonEmptyStr }

fn channel_inherits_downstream_obligations(c: SalesChannel) -> Bool {
  match c {
    SelfServeDeveloper { note } => false,
    DirectToBusiness { note } => false,
    ThroughCiReseller { note } => true,
  }
}

// THE AXIS THAT DECIDES FEASIBILITY AND WAS MISSING ENTIRELY. A paid non-production evaluation and
// a production workload differ in acceptance testing, maintenance windows, SLA, insurance and
// contractual remedy - which is most of what makes the first sale slow.
type UseStanding
  = NonProductionEvaluation { note: NonEmptyStr }
  | ProductionWorkload { note: NonEmptyStr }

fn use_is_production(u: UseStanding) -> Bool {
  match u {
    NonProductionEvaluation { note } => false,
    ProductionWorkload { note } => true,
  }
}

// WHAT QUALITY IS PROMISED, ordered by what the fleet must be able to PROVE. A promise this
// corpus cannot evidence is not a stronger product, it is an unpriced liability.
type QualityPromise
  = BestEffortNoRemedy { note: NonEmptyStr }
  | UptimeCreditRemedy { note: NonEmptyStr }
  | NegotiatedSlaWithRemedies { note: NonEmptyStr }

fn b2b_promise_needs_uptime_history(q: QualityPromise) -> Bool {
  match q {
    BestEffortNoRemedy { note } => false,
    UptimeCreditRemedy { note } => true,
    NegotiatedSlaWithRemedies { note } => true,
  }
}

// CAN THE FLEET SERVE IT AT S0. S0 is four machines held with one through intake, so this is a
// capacity fact and a contention fact at once: a machine sold whole is a machine the CI canary is
// not running on.
type S0Servability
  = ServableAtS0 { machines_consumed: Int, basis: NonEmptyStr }
  | ServableAtS0OnlyByDisplacingCi { machines_consumed: Int, displaced: NonEmptyStr }
  | NotServableAtS0 { blocker: NonEmptyStr }

fn b2b_servable_at_s0(s: S0Servability) -> Bool {
  match s {
    ServableAtS0 { machines_consumed, basis } => true,
    ServableAtS0OnlyByDisplacingCi { machines_consumed, displaced } => true,
    NotServableAtS0 { blocker } => false,
  }
}

fn b2b_displaces_ci(s: S0Servability) -> Bool {
  match s {
    ServableAtS0 { machines_consumed, basis } => false,
    ServableAtS0OnlyByDisplacingCi { machines_consumed, displaced } => true,
    NotServableAtS0 { blocker } => false,
  }
}

type OfferConfiguration {
  id: NonEmptyStr
  boundary: ResourceBoundary
  commercial: CommercialModel
  channel: SalesChannel
  use: UseStanding
  promise: QualityPromise
  servability: S0Servability
  compliance_note: NonEmptyStr
  why_this_point: NonEmptyStr
}

// THE B2C PATH, CARRIED HERE AS A POINT RATHER THAN AS AN OTHER. Naming it in the same space is
// what makes the comparison a comparison instead of two vocabularies.
data offer_ci_minutes_b2c: OfferConfiguration = OfferConfiguration {
  id: "ci-minutes-b2c",
  boundary: PerJobCellWeManage {
    note: "One cell per job, many tenants per machine, teardown proved per job. Every construction the M2 tenant-boundary work is building.",
  },
  commercial: PerMinuteMetered {
    note: "The floor is divided by a utilisation nobody has measured. See the exposure rows below.",
  },
  channel: SelfServeDeveloper {
    note: "Install the App, change one line of runs-on. The narrowness of that surface is the product.",
  },
  use: ProductionWorkload { note: "A customer's CI is production by the time they depend on it." },
  promise: BestEffortNoRemedy { note: "Founding credits, assisted onboarding, no SLA yet." },
  servability: ServableAtS0 {
    machines_consumed: 1,
    basis: "The M1 canary is exactly this offer on one host.",
  },
  compliance_note: "The full multi-tenant surface, plus a route population because jobs may spill onto third-party providers.",
  why_this_point: "The existing plan. Present so the B2B points are read as neighbours in one space.",
}

// THE NARROW POINT THAT AN INDEPENDENT REVIEW LANDS ON AS THE ONLY PLAUSIBLY-NOVEMBER ONE, and it
// is narrow on all four axes at once rather than on the one the phrase American Hetzner suggests.
data offer_eval_reserved_node: OfferConfiguration = OfferConfiguration {
  id: "eval-reserved-node-us-metro",
  boundary: WholeNodeCustomerManaged {
    note: "One node, customer-administered above the hardware and network boundary. We hand over a machine and an attachment; they run what they like on it.",
  },
  commercial: FixedTermTakeOrPay {
    term_months: 1,
    note: "Paid, fixed term, take-or-pay - so the month is sold or it is not and no utilisation assumption enters the price.",
  },
  channel: DirectToBusiness { note: "One counterparty, one invoice, one named contact." },
  use: NonProductionEvaluation {
    note: "THIS IS THE AXIS THAT MAKES IT FEASIBLE. A non-production evaluation does not need acceptance testing, maintenance windows, an SLA with remedies, or insurance - which is most of what makes a first production sale slow. It is also the axis a pitch is most likely to blur, and blurring it converts an evaluation into a production commitment nobody priced.",
  },
  promise: BestEffortNoRemedy {
    note: "Honest for an evaluation and dishonest for anything else. Two of the other points here promise availability this fleet cannot evidence.",
  },
  servability: ServableAtS0OnlyByDisplacingCi {
    machines_consumed: 1,
    displaced: "Four machines held, one through intake. Selling that one removes the machine the M1 canary runs on, so at S0 this point and the CI vertical compete for the same unit.",
  },
  compliance_note: "One route - our own site - plus the durable origin. FOUR CONDITIONS MUST HOLD TOGETHER or it is not feasible either: the route census collapses to one exact-route dossier, preparation runs in parallel rather than serially, the buyer accepts our paper rather than negotiating, and THE CURRENT PHYSICAL SITE IS ADMISSIBLE - an unselected colo would dominate the path and no site here carries a site-admission receipt.",
  why_this_point: "Narrow on boundary, term, channel and use simultaneously. Every axis widened is a different and slower offer.",
}

data offer_production_reserved_capacity: OfferConfiguration = OfferConfiguration {
  id: "production-reserved-capacity",
  boundary: WholeNodeCustomerManaged { note: "Same boundary as the evaluation point." },
  commercial: FixedTermTakeOrPay {
    term_months: 12,
    note: "Bulk and predictable, which is the argument the plan item wholesale-supply-channel makes for fixing the utilisation denominator.",
  },
  channel: DirectToBusiness { note: "Still one counterparty." },
  use: ProductionWorkload {
    note: "And this single axis change is what makes it SAME OR LONGER than the CI path rather than shorter: acceptance testing, maintenance windows, an SLA, insurance and redlines all arrive with production.",
  },
  promise: UptimeCreditRemedy { note: "A production reservation is a promise about availability, and availability is sayable only over a measured window." },
  servability: NotServableAtS0 {
    blocker: "Headroom for a production customer cannot be held on four machines with one qualified, and fleet-capacity-floor has not run.",
  },
  compliance_note: "One route, but a full production contract surface.",
  why_this_point: "It is one axis away from the feasible point and materially slower. That distance is the finding.",
}

data offer_wholesale_through_reseller: OfferConfiguration = OfferConfiguration {
  id: "wholesale-through-ci-reseller",
  boundary: WholeNodeCustomerManaged { note: "They isolate their own customers on top; our boundary is the machine we hand them." },
  commercial: FixedTermTakeOrPay { term_months: 12, note: "A supply contract. Every term quote in strategy.wholesale_buyer is Unquoted." },
  channel: ThroughCiReseller {
    note: "The channel is the cost. Their downstream customers' security review, data-processing terms and remedy obligations flow back to us, so this point carries MORE obligation than selling direct, not less.",
  },
  use: ProductionWorkload { note: "A reseller wraps it and sells it; there is no evaluation posture available." },
  promise: NegotiatedSlaWithRemedies { note: "Reliability evidence this fleet cannot produce: no failover exercise, no site-admission receipt." },
  servability: NotServableAtS0 {
    blocker: "A reseller buys volume. Four machines is not a supply contract.",
  },
  compliance_note: "The customer-facing admission surface shrinks to one counterparty while the CONTRACT surface grows - a negotiated master agreement, a security questionnaire and an SLA with remedies replace a pinned standard form nobody negotiates.",
  why_this_point: "The point the phrase American Hetzner most often means, and the longest of the four.",
}

data b2b_offers: List<OfferConfiguration> = [
  offer_ci_minutes_b2c,
  offer_eval_reserved_node,
  offer_production_reserved_capacity,
  offer_wholesale_through_reseller,
]

fn b2b_offer_count() -> Int { count(b2b_offers) }

fn b2b_offers_servable_at_s0() -> List<OfferConfiguration> {
  filter(b2b_offers, o => b2b_servable_at_s0(s: o.servability))
}

fn b2b_s0_servable_count() -> Int { count(b2b_offers_servable_at_s0()) }

fn b2b_offers_needing_uptime_history() -> List<OfferConfiguration> {
  filter(b2b_offers, o => b2b_promise_needs_uptime_history(q: o.promise))
}

fn b2b_uptime_history_owed_count() -> Int { count(b2b_offers_needing_uptime_history()) }

// The axes are independent, and this is the executed statement of it: the same resource boundary
// appears under three different commercial-and-channel combinations, so a claim proved about one
// of them is not a claim about the boundary.
fn whole_node_offer_count() -> Int {
  count(filter(b2b_offers, o => boundary_is_whole_node(b: o.boundary)))
}

fn non_production_offer_count() -> Int {
  count(filter(b2b_offers, o => use_is_production(u: o.use) == false))
}

fn reseller_channel_offer_count() -> Int {
  count(filter(b2b_offers, o => channel_inherits_downstream_obligations(c: o.channel)))
}

fn utilization_guessing_offer_count() -> Int {
  count(filter(b2b_offers, o => commercial_carries_utilization_guess(c: o.commercial)))
}


// ---------------------------------------------------------------------------------------------
// 2. THE ONE STRUCTURAL ECONOMIC DIFFERENCE, DERIVED RATHER THAN ASSERTED
// ---------------------------------------------------------------------------------------------
//
// The CI floor is divided by a utilisation constant. The machine-month floor is not divided by
// anything. That is not a preference between two prices, it is a difference in how much of each
// price is a guess - and it is the strongest thing the B2B track has going for it that does not
// depend on an unobserved market fact.
type UtilizationExposure
  = FloorDividedByUtilization { reference_permille: Int, micro_per_unit_minute: Int, note: NonEmptyStr }
  | FloorCarriesNoUtilizationTerm { micro_per_slice_month: Int, note: NonEmptyStr }

data ci_half_utilization_permille: Int = 500

fn ci_floor_at_half_utilization_micro() -> Int {
  floor_micro_per_unit_minute(utilization_permille: ci_half_utilization_permille)
}

fn ci_floor_at_full_utilization_micro() -> Int {
  floor_micro_per_unit_minute(utilization_permille: 1000)
}

fn b2b_cost_per_slice_month_micro() -> Int { our_cost_per_slice_micro() }

data ci_track_exposure: UtilizationExposure = FloorDividedByUtilization {
  reference_permille: ci_half_utilization_permille,
  micro_per_unit_minute: ci_floor_at_half_utilization_micro(),
  note: "THE POINT IS THE DIVISOR, NOT ITS VALUE. strategy.cost_floor floor_micro_per_unit_minute takes utilisation as a PARAMETER, so the CI floor is a function of an assumption about how busy the fleet is. This row evaluates it at a declared halfway endpoint rather than at the plan's planning utilisation, because that constant lives in strategy.ci_runner_economics. The sensitivity below makes the argument without forking a second planning-utilisation authority.",
}

data b2b_track_exposure: UtilizationExposure = FloorCarriesNoUtilizationTerm {
  micro_per_slice_month: b2b_cost_per_slice_month_micro(),
  note: "strategy.node_rental our_cost_per_slice_micro is a machine-month cost with no utilisation term in it at all. An unsold node still costs the full amount, which is a risk and not an escape - the risk simply sits in whether the month sells rather than inside the price.",
}

// How much of the CI floor is the utilisation assumption. A ratio rather than a difference,
// because the two floors are denominated in different units and subtracting them would be the
// typed-refusal-comparing-the-wrong-quantities defect.
fn ci_utilization_multiple_permille() -> Int {
  let full = ci_floor_at_full_utilization_micro()
  if full <= 0 { 0 } else { ci_floor_at_half_utilization_micro() * 1000 / full }
}

// The two rows are read through these rather than restated by their consumers, so a row that
// stopped carrying its divisor or its amount reds rather than being quietly bypassed.
fn b2b_exposure_divisor_permille(e: UtilizationExposure) -> Int {
  match e {
    FloorDividedByUtilization { reference_permille, micro_per_unit_minute, note } => reference_permille,
    FloorCarriesNoUtilizationTerm { micro_per_slice_month, note } => 0,
  }
}

fn b2b_exposure_amount_micro(e: UtilizationExposure) -> Int {
  match e {
    FloorDividedByUtilization { reference_permille, micro_per_unit_minute, note } => micro_per_unit_minute,
    FloorCarriesNoUtilizationTerm { micro_per_slice_month, note } => micro_per_slice_month,
  }
}

// THE CLAIM, AND IT IS ABOUT THE ROWS RATHER THAN ABOUT TWO FUNCTION CALLS: the CI track carries a
// divisor and the B2B track carries none, and both rows carry a real amount.
fn b2b_utilization_exposure_differs() -> Bool {
  b2b_exposure_divisor_permille(e: ci_track_exposure) > 0
    && b2b_exposure_divisor_permille(e: b2b_track_exposure) == 0
    && b2b_exposure_amount_micro(e: ci_track_exposure) > 0
    && b2b_exposure_amount_micro(e: b2b_track_exposure) > 0
    && ci_utilization_multiple_permille() > 1000
}

// ---------------------------------------------------------------------------------------------
// 3. THE JOIN: FOR EACH EXISTING PLAN ITEM, WHAT DOES THE B2B TRACK NEED
// ---------------------------------------------------------------------------------------------
//
// THE ITEMS ARE CITED, NOT IMPORTED. strategy.year_end_plan is the authority for every declared
// rank, duration and dependency, and this module deliberately does not copy one of those numbers
// in: a transcribed duration is unreachable from the thing that owns it and rots without anyone
// touching either end (DESIGN section 6, name the instrument). The join therefore answers WHICH
// items and WHAT KIND of need, and refuses to answer HOW MANY DAYS - see chain_disposition below,
// whose day arm is a declared frontier that closes when the plan module can be imported.
type TrackNeed
  = SharedWithB2c { note: NonEmptyStr }
  | B2bDoesNotNeed { why: NonEmptyStr }
  | B2bNeedsDifferent { instead: NonEmptyStr, note: NonEmptyStr }
  | B2bNeedsMore { what: NonEmptyStr, note: NonEmptyStr }

fn b2b_need_is_dropped(n: TrackNeed) -> Bool {
  match n {
    SharedWithB2c { note } => false,
    B2bDoesNotNeed { why } => true,
    B2bNeedsDifferent { instead, note } => false,
    B2bNeedsMore { what, note } => false,
  }
}

fn b2b_need_is_replaced(n: TrackNeed) -> Bool {
  match n {
    SharedWithB2c { note } => false,
    B2bDoesNotNeed { why } => false,
    B2bNeedsDifferent { instead, note } => true,
    B2bNeedsMore { what, note } => false,
  }
}

fn b2b_need_adds_obligation(n: TrackNeed) -> Bool {
  match n {
    SharedWithB2c { note } => false,
    B2bDoesNotNeed { why } => false,
    B2bNeedsDifferent { instead, note } => false,
    B2bNeedsMore { what, note } => true,
  }
}

// Whether the row sits on the declared chain from m2-launch-intent to first-external-customer.
// That chain is the open escalation, so its membership is a field rather than a comment.
type ChainMembership
  = OnDeclaredM2Chain { hop: Int }
  | BesideTheChain { note: NonEmptyStr }

fn b2b_row_is_on_chain(m: ChainMembership) -> Bool {
  match m {
    OnDeclaredM2Chain { hop } => true,
    BesideTheChain { note } => false,
  }
}

type TrackJoinRow {
  item_id: NonEmptyStr
  item_ref: DeclarationRef
  membership: ChainMembership
  need: TrackNeed
  product_scope: NonEmptyStr
}

fn b2b_plan_item_ref(decl: String) -> DeclarationRef {
  decl_ref(module_path: "strategy.year_end_plan", decl_name: decl)
}

data join_m2_launch_intent: TrackJoinRow = TrackJoinRow {
  item_id: "m2-launch-intent",
  item_ref: b2b_plan_item_ref(decl: "item_m2_launch_intent"),
  membership: OnDeclaredM2Chain { hop: 1 },
  need: SharedWithB2c {
    note: "One posture revision governs both tracks or there are two compliance authorities, which is the fork section 3 forbids. Worth stating loudly because American Hetzner sounds like a geographic restriction and this item deliberately REPLACED the US-only launch profile with maximal lawful global support: the B2B track may not quietly reinstate a constant the plan already turned into a parameter.",
  },
  product_scope: "all three products",
}

data join_provider_route_census: TrackJoinRow = TrackJoinRow {
  item_id: "provider-route-census",
  item_ref: b2b_plan_item_ref(decl: "item_provider_route_census"),
  membership: OnDeclaredM2Chain { hop: 2 },
  need: B2bNeedsDifferent {
    instead: "one route - our own site - censused to the same data-path closure",
    note: "The census is one row per provider times service times region because the CI product DISPATCHES onto third-party routes. A customer renting our machines has one route and we are it. The closure questions do not vanish - execution, storage, backups, logs, telemetry, control plane, support access, administrative access and spill still need answering for our own site - but the population is one row we already own rather than a supplier survey. Note the honest cost: nobody has censused our own route either, so this is a smaller job and not a finished one.",
  },
  product_scope: "bare-metal-monthly and wholesale-runner-capacity; reserved-capacity-term inherits the full census",
}

data join_m2_admission_spine: TrackJoinRow = TrackJoinRow {
  item_id: "m2-admission-spine",
  item_ref: b2b_plan_item_ref(decl: "item_m2_admission_spine"),
  membership: OnDeclaredM2Chain { hop: 3 },
  need: B2bNeedsDifferent {
    instead: "a contract-time admission decision instead of a per-job one",
    note: "Three of its four discriminating reds are about JOBS - a declared-ePHI job, an unresolved classification, a job with no admission receipt. A single-tenant machine rental admits a CUSTOMER once, at signature, not a job stream continuously. The fourth red survives unchanged and is the one most likely to be waived for a first B2B deal: a zero-dollar net invoice does not alter admission.",
  },
  product_scope: "bare-metal-monthly and wholesale-runner-capacity",
}

// CORRECTED 2026-09-10 AFTER REVIEW, AND THE CORRECTION IS THE POINT. This row previously read
// B2bDoesNotNeed, on the reasoning that a whole-machine rental performs no route SELECTION. That
// conflated selection with AUTHORIZATION, and it was the exact edge deletion this work's own edge
// doctrine forbids: a route population of size one does not make the join vacuous, it makes it a
// join over one element, and one route still needs a sealed permit before a customer runs on it.
// The reviewer is right, and the tell was available in this very module - the recut kept
// spine -> admission and admission -> bindings as complete-before-start while this row said the
// successor of both was unnecessary. A gate is not removed because its input got small.
data join_provider_route_admission: TrackJoinRow = TrackJoinRow {
  item_id: "provider-route-admission",
  item_ref: b2b_plan_item_ref(decl: "item_provider_route_admission"),
  membership: OnDeclaredM2Chain { hop: 4 },
  need: B2bNeedsDifferent {
    instead: "the same sealed permit over a one-element route population",
    note: "WHAT STAYS, WHOLE: the join itself - active posture revision x demand and work and customer and data scope x route and its data-path closure -> a SEALED PERMIT naming every revision it was constructed from. Every constructible refusal stays too: route unclassified, route facts incomplete, posture revision stale, customer scope unsupported, data handling unsupported, required agreement authority absent, transfer or location unresolved, downstream provider unassessed, access path unsupported. A single-tenant machine is precisely where an unpermitted workload would never meet a dispatch path that could stop it, so the permit is doing MORE work here, not less. WHAT IS TRIVIALLY SATISFIED, named as the reviewer asked rather than used to justify removal: exactly one required red, the COMPARATIVE one - the cheapest unadmitted route never wins - has no subject when the candidate field has one element, because there is no cheaper alternative to lose to. That is a red whose SUBJECT is absent, not a red that has been waived, and it returns the moment a second route is admitted. Every other required red keeps its subject, including the one most likely to be waved through: an unclassified route must still refuse rather than default, and the customer having bought the machine by name is not a classification.",
  },
  product_scope: "all three whole-node points; the CI point needs the full multi-route join",
}

data join_m2_control_bindings: TrackJoinRow = TrackJoinRow {
  item_id: "m2-control-bindings",
  item_ref: b2b_plan_item_ref(decl: "item_m2_control_bindings"),
  membership: OnDeclaredM2Chain { hop: 5 },
  need: B2bNeedsDifferent {
    instead: "the exclusion half without the permit-producer half",
    note: "Its two halves separate cleanly. A permit that survives selection, grant issuance and the effect boundary is meaningless with no selection to survive. But an exclusion stays unwritable without all three of a customer clause, an executing refusal, and a defined response when reality contradicts the clause - and that requirement binds harder here, because a single-tenant machine is exactly where a customer can put a workload the contract prohibits and nothing in the dispatch path will ever see it.",
  },
  product_scope: "all three products",
}

data join_m2_customer_projections: TrackJoinRow = TrackJoinRow {
  item_id: "m2-customer-projections",
  item_ref: b2b_plan_item_ref(decl: "item_m2_customer_projections"),
  membership: OnDeclaredM2Chain { hop: 6 },
  need: B2bNeedsDifferent {
    instead: "the same projection over a one-row route population",
    note: "The projection is derived from the admitted route population so that a schedule cannot promise a boundary no permit can produce. With one route the derivation is trivial and the disclosure is short - our site, our machines, our administrators. The deviation list against the pinned standard survives whole, and for the reseller product it grows.",
  },
  product_scope: "all three products",
}

data join_m2_legal_review_ready: TrackJoinRow = TrackJoinRow {
  item_id: "m2-legal-review-ready",
  item_ref: b2b_plan_item_ref(decl: "item_m2_legal_review_ready"),
  membership: OnDeclaredM2Chain { hop: 7 },
  need: SharedWithB2c {
    note: "The gate that makes paid review conditional does not care which track pays for the hours. Its inputs shrink with the route population and grow with the contract, which is the same trade the whole join keeps finding.",
  },
  product_scope: "all three products",
}

data join_m2_legal_issue_spot: TrackJoinRow = TrackJoinRow {
  item_id: "m2-legal-issue-spot",
  item_ref: b2b_plan_item_ref(decl: "item_m2_legal_issue_spot"),
  membership: OnDeclaredM2Chain { hop: 8 },
  need: SharedWithB2c {
    note: "Three senior hours reading our facts. Its declared duration is QUEUE LATENCY rather than effort, which matters for the schedule question: an item whose clock is somebody else's calendar does not shorten because our product got simpler.",
  },
  product_scope: "all three products",
}

data join_m2_contract_deviation_review: TrackJoinRow = TrackJoinRow {
  item_id: "m2-contract-deviation-review",
  item_ref: b2b_plan_item_ref(decl: "item_m2_contract_deviation_review"),
  membership: OnDeclaredM2Chain { hop: 9 },
  need: B2bNeedsMore {
    what: "a negotiated agreement rather than a redline of a standard form",
    note: "Phase two takes the pinned standard plus our deviation list and is capped at three senior hours because nobody is negotiating back. A business buyer negotiates, and a reseller putting their own customers on our metal negotiates hard: SLA remedies, liability caps, insurance, security review, exit and data return. That is a different shape of legal work from reviewing a form, and the cap is the first thing it breaks.",
  },
  product_scope: "wholesale-runner-capacity most; bare-metal-monthly if the buyer is sophisticated",
}

data join_m2_compliance_admission: TrackJoinRow = TrackJoinRow {
  item_id: "m2-compliance-admission",
  item_ref: b2b_plan_item_ref(decl: "item_m2_compliance_admission"),
  membership: OnDeclaredM2Chain { hop: 10 },
  need: B2bNeedsDifferent {
    instead: "freeze the same revisions over a smaller rehearsal",
    note: "Freezing the exact revisions the launch runs against is track-independent and stays. Of the rehearsal arms, the cheapest-but-unadmitted route losing to a dearer admitted one has no subject without route selection; the ePHI refusal, the sanctions match, the deletion to its typed terminal state and the offboarding all survive.",
  },
  product_scope: "all three products",
}

data join_first_external_customer: TrackJoinRow = TrackJoinRow {
  item_id: "first-external-customer",
  item_ref: b2b_plan_item_ref(decl: "item_first_external"),
  membership: OnDeclaredM2Chain { hop: 11 },
  need: B2bNeedsDifferent {
    instead: "a first B2B counterparty, which is a different terminal fact",
    note: "The declared terminal is a design partner running a real workload under the paperwork, credit, support and tenant-boundary controls, with a hand-done and TIMED migration. A business renting a machine has no migration to time and no workload of ours to run. If the B2B track is to have a terminal at all it needs its own, and inventing it is phase two rather than a sentence here.",
  },
  product_scope: "all three products",
}

// Rows beside the declared chain that the chain question keeps colliding with.
data join_tenant_boundary_minimum: TrackJoinRow = TrackJoinRow {
  item_id: "tenant-boundary-minimum",
  item_ref: b2b_plan_item_ref(decl: "item_tenant_boundary_minimum"),
  membership: BesideTheChain { note: "A declared dependency of first-external-customer, not of the eleven-hop compliance chain." },
  need: B2bNeedsDifferent {
    instead: "a machine boundary instead of a cell boundary",
    note: "This is where the B2B track is genuinely CHEAPER rather than merely different: handing over a whole machine removes per-job cell teardown proof, cross-tenant cache authorization and shared-silicon variance from the promise. It does not remove the network boundary, and it adds one the CI product does not have - a customer with root on our hardware inside our site, which is a physical and administrative exposure the cell model never creates.",
  },
  product_scope: "bare-metal-monthly and wholesale-runner-capacity",
}

data join_fleet_capacity_floor: TrackJoinRow = TrackJoinRow {
  item_id: "fleet-capacity-floor",
  item_ref: b2b_plan_item_ref(decl: "item_fleet_capacity_floor"),
  membership: BesideTheChain { note: "Already a declared dependency of wholesale-supply-channel." },
  need: SharedWithB2c {
    note: "Both tracks sell the same machines, so the capacity floor is measured once. This is the clearest instance of the operator's premise that work done for one track is not spent twice.",
  },
  product_scope: "all three products",
}

data join_hw_4_population: TrackJoinRow = TrackJoinRow {
