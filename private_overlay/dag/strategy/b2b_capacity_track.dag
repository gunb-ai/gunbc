  need: B2bNeedsDifferent {
    instead: "an invoice for a month, not metered minutes",
    note: "Metering vCPU-minutes is the CI product's billing primitive and the B2B product does not have one. An invoice for a fixed monthly amount is a materially smaller construction - and it is also the reason the B2B track can take money before per-job metering works.",
  },
  product_scope: "bare-metal-monthly and wholesale-runner-capacity",
}

data join_support_abuse: TrackJoinRow = TrackJoinRow {
  item_id: "support-abuse",
  item_ref: b2b_plan_item_ref(decl: "item_support_abuse"),
  membership: BesideTheChain { note: "A declared dependency of first-external-customer." },
  need: B2bNeedsDifferent {
    instead: "one named counterparty instead of a tenant population",
    note: "strategy.cost_floor carries support, abuse response and payment processing among its unquoted per-end-user components. One contract with one invoice does not carry them per user, which is the third argument recorded in wholesale-supply-channel. It does not carry them at zero either: a business buyer expects a named human, and that human is the operator.",
  },
  product_scope: "all three products",
}

data track_join_rows: List<TrackJoinRow> = [
  join_m2_launch_intent,
  join_provider_route_census,
  join_m2_admission_spine,
  join_provider_route_admission,
  join_m2_control_bindings,
  join_m2_customer_projections,
  join_m2_legal_review_ready,
  join_m2_legal_issue_spot,
  join_m2_contract_deviation_review,
  join_m2_compliance_admission,
  join_first_external_customer,
  join_tenant_boundary_minimum,
  join_fleet_capacity_floor,
  join_hw_4_population,
  join_billing_receipts,
  join_support_abuse,
]

fn b2b_join_row_count() -> Int { count(track_join_rows) }

fn b2b_chain_rows() -> List<TrackJoinRow> {
  filter(track_join_rows, r => b2b_row_is_on_chain(m: r.membership))
}

fn b2b_chain_row_count() -> Int { count(b2b_chain_rows()) }

fn b2b_chain_dropped_count() -> Int {
  count(filter(b2b_chain_rows(), r => b2b_need_is_dropped(n: r.need)))
}

fn b2b_chain_replaced_count() -> Int {
  count(filter(b2b_chain_rows(), r => b2b_need_is_replaced(n: r.need)))
}

fn b2b_chain_added_count() -> Int {
  count(filter(b2b_chain_rows(), r => b2b_need_adds_obligation(n: r.need)))
}

fn b2b_chain_shared_count() -> Int {
  b2b_chain_row_count() -
    b2b_chain_dropped_count() -
    b2b_chain_replaced_count() -
    b2b_chain_added_count()
}

fn b2b_join_display_key(r: TrackJoinRow) -> String {
  declaration_ref_display_key(ref: r.item_ref)
}

// ---------------------------------------------------------------------------------------------
// 4. DOES A B2B FIRST CUSTOMER SHORTEN THE DECLARED CHAIN. THE ANSWER IS NO.
// ---------------------------------------------------------------------------------------------
//
// THE COUNT IS DERIVABLE HERE AND THE CALENDAR IS NOT. Every declared duration lives in
// strategy.year_end_plan; copying eleven numbers in to sum them would be a transcription that
// rots, and inventing durations for the replacement items would be exactly the fabricated
// plausible output that makes a favourable answer look decided. So the shape of the answer is:
// the DISPOSITION is decided now, the DAYS are a declared frontier with a named trigger.
type ChainDisposition
  = ExistingChainNotShortenedByBuyerType {
      chain_rows: Int
      dropped: Int
      replaced: Int
      shared: Int
      added: Int
      reason: NonEmptyStr
    }
  | B2bShortensCriticalPath { days_saved: Int, basis: NonEmptyStr }
  | B2bLengthensCriticalPath { days_added: Int, basis: NonEmptyStr }

// THE ANSWER, AND IT IS A NO. The question this module was opened with was whether a B2B first
// customer shortens the declared eleven-hop chain to first-external-customer. It does not, and the
// reason is one the join rows above make visible only once they are counted: M2 ALREADY assumes a
// trusted, non-public, ASSISTED DESIGN PARTNER. Changing the buyer from a developer to a business
// therefore removes very little, because the consumer-scale machinery it would remove was never
// what the milestone was buying. Even aggressively deleting the generalized gates leaves more days
// than remain. The counts below are the shape of that finding rather than an argument for it: one
// item drops, most are rewritten smaller, and one gets HARDER.
//
// WHAT DOES SHORTEN IS A DIFFERENT CHAIN, NOT A SHORTER VERSION OF THIS ONE - see
// parallel_chain_standing below and strategy.m2_demand_directed_recut for the arithmetic.
fn b2b_chain_disposition() -> ChainDisposition {
  ExistingChainNotShortenedByBuyerType {
    chain_rows: b2b_chain_row_count(),
    dropped: b2b_chain_dropped_count(),
    replaced: b2b_chain_replaced_count(),
    shared: b2b_chain_shared_count(),
    added: b2b_chain_added_count(),
    reason: "The compliance middle narrows and the contract middle widens, and neither movement is large enough to matter against the remaining calendar. The two ExternalLead legal members get harder rather than easier for a business buyer, and their clocks are queue latency rather than effort, so they do not respond to a simpler product at all. No day total is minted here: every declared duration lives in strategy.year_end_plan and this module may not transcribe them - the recut module computes a longest path over ITS OWN declared rows instead.",
  }
}

fn b2b_disposition_shortens(d: ChainDisposition) -> Bool {
  match d {
    ExistingChainNotShortenedByBuyerType { chain_rows, dropped, replaced, shared, added, reason } => false,
    B2bShortensCriticalPath { days_saved, basis } => true,
    B2bLengthensCriticalPath { days_added, basis } => false,
  }
}

// THE USEFUL RESIDUE OF A NEGATIVE ANSWER. A narrower OFFER - narrow on all four axes at once -
// can carry its own shorter chain beside the CI one. The conditions are conjunctive and stated so
// that dropping any of them is visible rather than optimistic.
type ParallelChainStanding
  = ParallelChainConditionallyFeasible {
      offer: OfferConfiguration
      conditions: List<NonEmptyStr>
      soundness_wall: NonEmptyStr
    }
  | ParallelChainNotAvailable { cause: NonEmptyStr }

data parallel_chain_standing: ParallelChainStanding = ParallelChainConditionallyFeasible {
  offer: offer_eval_reserved_node,
  conditions: [
    "The route census collapses to ONE EXACT-ROUTE DOSSIER rather than a provider survey.",
    "Preparation runs in parallel with the technical work rather than serially behind it.",
    "The buyer accepts our paper rather than negotiating it.",
    "The CURRENT PHYSICAL SITE is admissible - an unselected colo would dominate the path, and no site in this corpus carries a site-admission receipt.",
  ],
  soundness_wall: "A SEPARATE EXIT, NEVER A SUBSTITUTED ONE. A bare-metal capacity evaluation must not imply that the CI controls passed - different evidence, different obligations - so the honest structure is a compute-first-external milestone BESIDE the CI one, with any either-satisfies gate being an explicit operator decision rather than a modelling convenience. Collapsing them would let the cheaper proof discharge the dearer one, which is the externalized-degradation shape: the same milestone name covering a materially different delivery.",
}

fn parallel_chain_condition_count(s: ParallelChainStanding) -> Int {
  match s {
    ParallelChainConditionallyFeasible { offer, conditions, soundness_wall } => count(conditions),
    ParallelChainNotAvailable { cause } => 0,
  }
}

fn parallel_chain_is_conditional(s: ParallelChainStanding) -> Bool {
  match s {
    ParallelChainConditionallyFeasible { offer, conditions, soundness_wall } => true,
    ParallelChainNotAvailable { cause } => false,
  }
}

// The part of the answer that does NOT need the plan join, because it is a fact about the fleet
// rather than about the schedule. It is also the part most likely to be misread as good news.
type S0BindingConstraint {
  constraint: NonEmptyStr
  consequence: NonEmptyStr
}

data s0_inventory_rivalry: S0BindingConstraint = S0BindingConstraint {
  constraint: "Four machines held, one through intake, and a machine sold whole is a machine the CI vertical is not running on.",
  consequence: "At S0 the two tracks are complementary in DEMAND and rival in INVENTORY. The first B2B sale does not merely add a customer, it removes the canary host - so any claim that the B2B track shortens the path must be read against the M1 vertical it would displace. This is the one respect in which the parallel-path framing is not free.",
}

data b2b_reliability_gap: S0BindingConstraint = S0BindingConstraint {
  constraint: "No failover exercise and no site-admission receipt exist in this corpus, and an uptime credit or an SLA is sayable only over a measured window.",
  consequence: "Two of the three candidate products promise something the fleet cannot yet evidence. A measured window is calendar-bound and cannot be compressed by simplifying the product, so for those two the reliability pole is longer than the compliance pole it replaces.",
}

data s0_binding_constraints: List<S0BindingConstraint> = [s0_inventory_rivalry, b2b_reliability_gap]

fn b2b_binding_constraint_count() -> Int { count(s0_binding_constraints) }

// ---------------------------------------------------------------------------------------------
// 5. WHAT AMERICAN MEANS, ONE ROW PER CANDIDATE CONTENT
// ---------------------------------------------------------------------------------------------
//
// American Hetzner has to survive being asked what it delivers. Some of it is grounded in this
// corpus today, some of it is unobserved, and some of it is positioning - and a slogan that
// silently carries all three is how an unmeasured claim reaches a customer.
type ClaimStanding
  = GroundedInCorpus { authority: DeclarationRef, note: NonEmptyStr }
  | UnobservedAndNeeded { observation: NonEmptyStr }
  | PositioningOnly { why: NonEmptyStr }

fn b2b_claim_is_grounded(s: ClaimStanding) -> Bool {
  match s {
    GroundedInCorpus { authority, note } => true,
    UnobservedAndNeeded { observation } => false,
    PositioningOnly { why } => false,
  }
}

fn b2b_claim_is_unobserved(s: ClaimStanding) -> Bool {
  match s {
    GroundedInCorpus { authority, note } => false,
    UnobservedAndNeeded { observation } => true,
    PositioningOnly { why } => false,
  }
}

// THE SUPPLY EVIDENCE THIS TRACK WAITS ON, AND IT MAY NOT BE ONE VENDOR IN ONE REGION.
// CORRECTED 2026-09-10 AFTER REVIEW. This module previously named the observation as the operator's
// HETZNER capacity enquiry in a US region. That was wrong twice over. It gated a track on a single
// vendor's catalogue in a single region - and the OPERATOR HAS RULED that a matching processor SKU
// does not imply a supply relationship: Hetzner is one possible supplier among others, and other
// Ampere-era suppliers are looked for if needed. A question asked of one vendor's US catalogue is
// also not an open evidence item in the way this row needs, because a vendor that does not offer
// the line there answers it without telling us anything about whether the capacity is buyable.
//
// THE REQUIREMENT IS THEREFORE SUPPLIER-SHAPED, NOT VENDOR-SHAPED, and the scope is a typed arm so
// that re-gating on one vendor is a visible edit rather than a sentence someone changes. What
// closes it is an ORDER OUTCOME, not a listing: a dated attempt that was PAID or REFUSED, with the
// supplier and the region recorded as facts of the receipt rather than as its subject.
type SupplierScope
  = AnyQualifiedSupplier { note: NonEmptyStr }
  | NamedSupplierOnly { supplier: NonEmptyStr, why_this_one: NonEmptyStr }

fn supplier_scope_is_open(s: SupplierScope) -> Bool {
  match s {
    AnyQualifiedSupplier { note } => true,
    NamedSupplierOnly { supplier, why_this_one } => false,
  }
}

type OrderOutcomeStanding
  = OrderAttemptedAndPaid { dated_receipt: NonEmptyStr }
  | OrderAttemptedAndRefused { dated_receipt: NonEmptyStr }
  | NoOrderAttempted { obligation: NonEmptyStr }

fn order_outcome_is_dated(o: OrderOutcomeStanding) -> Bool {
  match o {
    OrderAttemptedAndPaid { dated_receipt } => true,
    OrderAttemptedAndRefused { dated_receipt } => true,
    NoOrderAttempted { obligation } => false,
  }
}

type SupplyEvidenceRequirement {
  scope: SupplierScope
  standing: OrderOutcomeStanding
  closes_when: NonEmptyStr
}

data ampere_supply_requirement: SupplyEvidenceRequirement = SupplyEvidenceRequirement {
  scope: AnyQualifiedSupplier {
    note: "Any supplier that can deliver Ampere-era dedicated capacity. A processor-model coincidence with a vendor we already price is EVIDENCE ABOUT A CATALOGUE and never evidence of a supply relationship - the operator's ruling, and the reason this arm exists as a construction rather than as a caution in prose. A named-supplier arm is available for the day a term sheet actually binds one, and taking it is then a deliberate edit.",
  },
  standing: NoOrderAttempted {
    obligation: "No dated order outcome from any supplier exists in this corpus. Listings, advertised rates and console readings are not order outcomes: the first says what is published, the second what is charged, and only an ATTEMPT says what is deliverable.",
  },
  closes_when: "A dated, paid-or-refused Ampere order from AT LEAST ONE supplier, with the supplier named and the region recorded on the receipt. Region is a recorded fact of the outcome, not a precondition of the question - a refused order in one region and a paid one in another are both evidence, and demanding a specific region up front is what turned this into a single-vendor question the first time.",
}

fn supply_requirement_is_vendor_agnostic() -> Bool {
  supplier_scope_is_open(s: ampere_supply_requirement.scope)
}

fn supply_evidence_is_open() -> Bool {
  order_outcome_is_dated(o: ampere_supply_requirement.standing) == false
}

type AmericanContent {
  key: NonEmptyStr
  standing: ClaimStanding
}

data american_us_entity: AmericanContent = AmericanContent {
  key: "a US entity signs the contract",
  standing: GroundedInCorpus {
    authority: decl_ref(module_path: "finance.gunbai_llc", decl_name: "gunbai_facts"),
    note: "A New York LLC with an EIN, a registered agent and New York governing law. This is the single most solidly grounded content of the word, and it is also the one a buyer asks about first when the alternative is a German vendor.",
  },
}

data american_usd_billing: AmericanContent = AmericanContent {
  key: "billed in dollars, with no exchange-rate exposure",
  standing: GroundedInCorpus {
    authority: decl_ref(module_path: "strategy.node_rental", decl_name: "our_currency"),
    note: "Our costs and our prices are both in dollars. strategy.node_rental records what happens to a comparison that crosses currency: the FX-converted competitor figure was a number no buyer is ever quoted, and it was withdrawn.",
  },
}

data american_physical_location: AmericanContent = AmericanContent {
  key: "the machines are physically in the United States",
  standing: GroundedInCorpus {
    authority: decl_field_ref(module_path: "finance.gunbai_llc", decl_name: "gunbai_facts", field_name: "principal_office"),
    note: "Every site this fleet occupies or surveys is in the United States - the operating address on the entity record, the held Mt. Collins unit, and the Bayonne candidate in strategy.site_survey_91_e21st. That is a fact about where the metal is, which is what a data-residency question asks first - but a location is not a residency GUARANTEE until the route closure covering storage, logs, telemetry, backups and support access is censused for our own site, and no site here carries a site-admission receipt.",
  },
}

data american_data_residency: AmericanContent = AmericanContent {
  key: "customer data stays in the United States",
  standing: UnobservedAndNeeded {
    observation: "The full data-path closure for OUR OWN route - execution, durable storage, backups, logs, telemetry, control plane, support access, administrative access and spill. The object-storage half already crosses a provider boundary: storage-provider-accounts requires American regions at both candidate providers, and a bucket in an American region is not the same fact as an American-contained data path. Until that census exists this is a claim about geography, not about data.",
  },
}

data american_latency: AmericanContent = AmericanContent {
  key: "lower latency to US customers",
  standing: UnobservedAndNeeded {
    observation: "A measurement. Nothing in this corpus times anything from a US client to our site or to a European vendor. For CI in particular the claim is weak on its face - a job that runs for minutes is not latency-bound - so it is worth measuring only if a customer names it.",
  },
}

data american_support_hours: AmericanContent = AmericanContent {
  key: "US business-hours support from a person you can reach",
  standing: PositioningOnly {
    why: "There is one operator and no support model. Every workstream converges on that person, which the plan itself records. Saying it before support-abuse exists would be selling an obligation we have not built.",
  },
}

data american_supply_availability: AmericanContent = AmericanContent {
  key: "dedicated Ampere capacity that can actually be bought, in the United States",
  standing: UnobservedAndNeeded {
    observation: "The sharpest candidate differentiator and the least established, and what it waits on is ampere_supply_requirement - a dated paid-or-refused order from ANY qualified supplier, region recorded. NOT a quantity answer from one vendor in one region: that framing stood here until 2026-09-10 and was wrong, because a vendor which does not offer the line in a region answers it without saying anything about whether the capacity is buyable, and because a matching processor SKU is evidence about a catalogue rather than a supply relationship. strategy.node_rental separately carries the Hetzner arm row as a dated NOT-ORDERABLE series against one signed-in account, which is a fact about that row's admissibility as a floor and not this track's supply answer. The US half stays unestablished in either direction until an order outcome carries a US region on its receipt.",
  },
}

data american_contents: List<AmericanContent> = [
  american_us_entity,
  american_usd_billing,
  american_physical_location,
  american_data_residency,
  american_latency,
  american_support_hours,
  american_supply_availability,
]

fn b2b_american_content_count() -> Int { count(american_contents) }

fn b2b_american_grounded_count() -> Int {
  count(filter(american_contents, c => b2b_claim_is_grounded(s: c.standing)))
}

fn b2b_american_unobserved_count() -> Int {
  count(filter(american_contents, c => b2b_claim_is_unobserved(s: c.standing)))
}

// ---------------------------------------------------------------------------------------------
// 6. THE STANDING OF THE TWO-TRACK DECISION ITSELF
// ---------------------------------------------------------------------------------------------
//
// DESIGN section 3d: a Pareto front of two is not a winner, and a decision with an unresolved
// funded axis is SelectionNeedsEvidence rather than a preference. The evidence gap here is not
// incidental - it is the same gap on both sides.
type TrackDecisionStanding
  = TwoTracksNeedsEvidence {
      unresolved_axis: NonEmptyStr
      discriminating_observation: NonEmptyStr
      note: NonEmptyStr
    }
  | TwoTracksAdmitted { note: NonEmptyStr }
  | B2bTrackRefused { cause: NonEmptyStr }

// Is there any retail row this corpus may cite as a purchasable competitive floor. The B2B price
// argument is a comparison against exactly that, so with none the price axis is unfunded.
fn b2b_has_admissible_floor_row() -> Bool {
  count(filter(market_rows, r => admissible_as_competitive_floor(r: r))) > 0
}

// WHY PURCHASABLE AND NOT MERELY KNOWN, since the difference is the whole point upstream now
// makes: a supply standing can be perfectly well OBSERVED and still not be a floor, because what
// was observed is that the line could not be ordered. Testing observedness here would have read a
// dated not-orderable series as evidence that the rate is buyable.
fn b2b_hetzner_row_is_not_a_floor() -> Bool {
  admissible_as_competitive_floor(r: hetzner_row) == false
    && (region_is_known(r: hetzner_row.region) == false
        || supply_is_purchasable(s: hetzner_row.supply) == false)
}

fn b2b_track_decision_standing() -> TrackDecisionStanding {
  if b2b_has_admissible_floor_row() == false {
    TwoTracksNeedsEvidence {
      unresolved_axis: "price against a purchasable market floor",
      discriminating_observation: "Whether dedicated Ampere-era capacity comparable to our slice can actually be BOUGHT - at what price, in what quantity, from ANY qualified supplier, with the region recorded rather than demanded up front. That is ampere_supply_requirement, and it is deliberately not a question about one vendor: gating it on one vendor's catalogue in one region is how an unanswerable question gets mistaken for an open one. It is the same observation both tracks need, which is itself an argument for running them together: if the capacity is freely purchasable the wholesale argument weakens and the CI product must win on service; if it is genuinely scarce the same fact both retires an advertised rate as a floor and supplies the reason a reseller wants a supplier at all.",
      note: "NOT a finding that the market has no floor. Zero admissible rows is a statement about this corpus, and reading the census as a market claim is the misreading strategy.node_rental evidence_census_note exists to prevent. The two tracks are non-dominated on what is currently known: the B2B track has the smaller construction and the weaker differentiation, the CI track has the stronger product argument and the longer admission chain. Selecting between them now would be a preference wearing a decision's clothes.",
    }
  } else {
    TwoTracksAdmitted {
      note: "An admissible floor exists, so the price axis is funded and the comparison can be made. Reaching this arm with a fabricated floor row is the failure it is written to make visible.",
    }
  }
}

fn b2b_decision_needs_evidence(s: TrackDecisionStanding) -> Bool {
  match s {
    TwoTracksNeedsEvidence { unresolved_axis, discriminating_observation, note } => true,
    TwoTracksAdmitted { note } => false,
    B2bTrackRefused { cause } => false,
  }
}

fn b2b_entity_is_us() -> Bool {
  gunbai_facts.formation_state == "New York"
}
