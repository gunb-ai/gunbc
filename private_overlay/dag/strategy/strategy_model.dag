data roadmap_relationship_note: String = "One-way authority relationship (directive): the public roadmap identifies the work the strategy requires; the strategy consumes roadmap acceptance receipts and never hand-authors roadmap status; the roadmap never references the private strategy (publication monotonicity). Lane bindings attach a StrategicReason to each public roadmap lane (the RoadmapNode.owner field); node-grain RoadmapBinding rows attach specific deliveries. The lane-coverage witness imports the PUBLIC gunbc.roadmap_authority under composed roots, so a new public lane without a strategic reason reds the private witness - control 7 executing at lane grain, with UnboundLaneAcknowledged as the typed, triggered debt row, never silence. Roadmap visibility itself is a modeled decision (roadmap-visibility), currently keep-public-for-now by operator receipt."

type MarketSegment {
  id: String
  description: String
}

type VisibilityAudience {
  id: String
  description: String
}

type DecisionAlternative {
  id: String
  statement: String
}

type DecisionReceipt {
  authority: String
  decided_on: String
  rationale: String
}

type DecisionState
  = Open
  | Selected { choice_id: String, receipt: DecisionReceipt }
  | SupersededBy { question_id: String }
  | RefusedDecision { reason: String }

type StrategicDecision {
  question_id: String
  question: String
  alternatives: List<DecisionAlternative>
  criteria: List<String>
  state: DecisionState
}

type AuthorizationVerdict
  = Authorized
  | AuthorizationRefused { cause: AuthorizationRefusalCause }

type AuthorizationRefusalCause
  = DecisionNotFound
  | DecisionNotSelected
  | DecisionSuperseded

fn authorize_work(question_id: String, decisions: List<StrategicDecision>) -> AuthorizationVerdict {
  fold(decisions, init: AuthorizationRefused { cause: DecisionNotFound }, f: fn(acc, d) {
    if d.question_id == question_id {
      match d.state {
        Selected { choice_id, receipt } => Authorized
        SupersededBy { question_id } => AuthorizationRefused { cause: DecisionSuperseded }
        Open => AuthorizationRefused { cause: DecisionNotSelected }
        RefusedDecision { reason } => AuthorizationRefused { cause: DecisionNotSelected }
      }
    } else {
      acc
    }
  })
}

type CapabilityEvidence
  = RoadmapAccepted { roadmap_node_id: String }
  | CapabilityDirectlyObserved { receipt: String }

type ObservedCapability {
  capability_id: String
  evidence: CapabilityEvidence
}

type EngagementKind
  = WedgeDesignPartner
  | TechnicalValidator

type Engagement {
  id: String
  kind: EngagementKind
}

data engagement_note: String = "Engagement ids are OPAQUE in the graph (directive: the aggregate strategy refers to an opaque identity); names, personal context, and commercial terms live only in the narrower disclosure subtree docs/engagements/. A TechnicalValidator is not a wedge customer: its journey model is per-kind and deliberately unauthored until needed - running a validator through the sales-pipeline stages would mint dishonest receipts."

type AdoptionEvidence
  = JourneyTransitionObserved { journey_id: String, receipt: String }
  | UsageObserved { receipt: String }

type ProductClaim {
  id: String
  proposition: String
  segment_id: String
  requires_capability_ids: List<String>
}

type ClaimStatus
  = ClaimSupported
  | ClaimUnsupported { missing_capability_ids: List<String> }

fn id_in_list(id: String, ids: List<String>) -> Bool {
  fold(ids, init: false, f: fn(acc, x) { acc || x == id })
}

fn claim_status(claim: ProductClaim, observed_capability_ids: List<String>) -> ClaimStatus {
  let missing = fold(claim.requires_capability_ids, init: [], f: fn(acc, c) {
    if id_in_list(id: c, ids: observed_capability_ids) { acc } else { concat(acc, [c]) }
  })
  if count(missing) == 0 { ClaimSupported } else { ClaimUnsupported { missing_capability_ids: missing } }
}

type JourneyStage {
  id: String
  order: Nat
}

type JourneyTransitionRule {
  from_id: String
  to_id: String
  required_receipt_kind: String
}

type StopCause
  = ProblemNotMaterial
  | TrustBoundaryRejected
  | InstallationCostTooHigh
  | ImprovementNotObserved
  | EconomicCaseAbsent
  | TimingMismatch
  | OtherLocatedCause { note: String }

type TransitionReceipt
  = StepReceipt { from_id: String, to_id: String, receipt_kind: String, evidence: String }
  | StopReceipt { cause: StopCause, evidence: String }

type JourneyRefusalCause
  = ReceiptAfterStop
  | ReceiptFromNoncurrentStage
  | TransitionNotDeclaredOrKindMismatch

type StageProgress
  = ProgressAt { stage_id: String }
  | ProgressStopped { cause: StopCause }
  | ProgressRefused { cause: JourneyRefusalCause }

fn rule_admits(rules: List<JourneyTransitionRule>, from_id: String, to_id: String, receipt_kind: String) -> Bool {
  fold(rules, init: false, f: fn(acc, r) {
    acc || (r.from_id == from_id && r.to_id == to_id && r.required_receipt_kind == receipt_kind)
  })
}

fn apply_transition_receipt(rules: List<JourneyTransitionRule>, progress: StageProgress, r: TransitionReceipt) -> StageProgress {
  match progress {
    ProgressRefused { cause } => ProgressRefused { cause }
    ProgressStopped { cause } => ProgressRefused { cause: ReceiptAfterStop }
    ProgressAt { stage_id } =>
      match r {
        StopReceipt { cause, evidence } => ProgressStopped { cause }
        StepReceipt { from_id, to_id, receipt_kind, evidence } =>
          if !(from_id == stage_id) {
            ProgressRefused { cause: ReceiptFromNoncurrentStage }
          } else {
            if rule_admits(rules: rules, from_id: from_id, to_id: to_id, receipt_kind: receipt_kind) {
              ProgressAt { stage_id: to_id }
            } else {
              ProgressRefused { cause: TransitionNotDeclaredOrKindMismatch }
            }
          }
      }
  }
}

fn derive_stage(rules: List<JourneyTransitionRule>, initial_stage_id: String, receipts: List<TransitionReceipt>) -> StageProgress {
  fold(receipts, init: ProgressAt { stage_id: initial_stage_id }, f: fn(acc, r) {
    apply_transition_receipt(rules: rules, progress: acc, r: r)
  })
}

type ExperimentContinuation
  = ExperimentMayContinue
  | ExperimentMustStop { cause: StopCause }

fn experiment_continuation(stop_receipts: List<TransitionReceipt>) -> ExperimentContinuation {
  fold(stop_receipts, init: ExperimentMayContinue, f: fn(acc, r) {
    match r {
      StopReceipt { cause, evidence } => ExperimentMustStop { cause }
      StepReceipt { from_id, to_id, receipt_kind, evidence } => acc
    }
  })
}

data venture_timeline_note: String = "Venture timeline kernel (operator request 2026-08-02, session loyal-ant-382): the story of where we came from, what we are dealing with now, and where we might be headed, as typed facts. PAST: VentureEra spans and TimelineEvent rows, every date carried with an EvidenceAnchor (a git-citable receipt, never recollection alone). PRESENT: derived, never stored - open eras via era_is_open, living compiler generations via generation_is_alive; there is no stored current-phase field. FUTURE: ProjectedStep rows carry an ordered horizon and a begins_when trigger CONDITION - a projected step never carries a fabricated calendar date - and each step advances a StrategicReason, so projections point at the same capability/hypothesis/vision authorities the lane bindings use rather than minting a parallel goal vocabulary. Compiler lineage: CompilerGeneration rows with birth/fate evidence and SuccessionEdge rows whose Rust-to-dag shape is asserted by witness, capturing the two seed-shrinks-toward-zero succession cycles at whole-compiler grain. Dates are ISO-8601 strings matching DecisionReceipt.decided_on; provenance prose lives in docs/strategy/2026-08-02-project-timeline-recollection.md, which this kernel supersedes as authority per the README discipline."

type EvidenceAnchor {
  repo: String
  reference: String
  note: String
}

type EraClose
  = EraClosed { on: String, evidence: EvidenceAnchor }
  | EraOpen

type VentureEra {
  id: String
  title: String
  summary: String
  started_on: String
  start_evidence: EvidenceAnchor
  close: EraClose
}

fn era_is_open(e: VentureEra) -> Bool {
  match e.close {
    EraOpen => true
    EraClosed { on, evidence } => false
  }
}

type TimelineEvent {
  id: String
  era_id: String
  occurred_on: String
  statement: String
  evidence: EvidenceAnchor
}

type SubstrateKind
  = RustCompiler
  | DagCompiler

type HostSubstrate
  = SelfNativeRust
  | RustSeedInterpreter
  | HostedByGeneration { ordinal: Nat }

type GenerationFate
  = GenerationRetired { on: String, evidence: EvidenceAnchor }
  | GenerationDeleted { on: String, evidence: EvidenceAnchor, migrated_role: String }
  | GenerationAlive { current_name: String, role: String }

type CompilerGeneration {
  ordinal: Nat
  name_at_birth: String
  substrate: SubstrateKind
  host: HostSubstrate
  born_on: String
  born_evidence: EvidenceAnchor
  fate: GenerationFate
}

fn generation_is_alive(g: CompilerGeneration) -> Bool {
  match g.fate {
    GenerationAlive { current_name, role } => true
    GenerationRetired { on, evidence } => false
    GenerationDeleted { on, evidence, migrated_role } => false
  }
}

type SuccessionEdge {
