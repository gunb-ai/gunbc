}

data site_survey_91_e21st_note: String = "First site test case (operator direction 2026-08-10): 91 E 21st St, Bayonne NJ 07002 - 750 SF furnished first-floor office suite in a 1911 three-story Class C building, listed on LoopNet (ID 35253254, on market since 2026-01-30, i.e. six-plus months - a negotiation fact). Facts below are LISTING AND PHOTO CLAIMS, not survey receipts; every dimension is UnmeasuredRoom pending geometry capture (floor-plan request + photo-set AI reconstruction + anchor measurements - operator ruling 2026-08-10, no LiDAR); every gating axis is Unevaluated pending its survey obligation. Purpose is dual: exercise the site kernel on a real candidate, and run the uniform-principles conformance test on our own process (captured in docs/strategy/2026-08-10-site-testcase-91-e21st.md). This carrier records NO lease decision: per the section 6 purchase gates, evaluating and modeling a site is evidence-gathering; leasing before a section 7 trigger fires would violate P8, and no such trigger has fired."

data site_candidates: List<SiteCandidate> = [
  SiteCandidate {
    id: "site-91-e21st-bayonne",
    address: "91 E 21st St, Bayonne, NJ 07002",
    listing: EvidenceAnchor {
      repo: "external",
      reference: "loopnet-listing-35253254",
      note: "LoopNet listing, captured 2026-08-10: 750 SF, 1st floor, $28.80/SF/YR, 1-5 yr term, full build-out, furnished, available now; building 3,933 SF, 3 stories, built 1911, typical floor 1,311 SF; 3 min walk to 22nd Street HBLR.",
    },
    year_built: 1911,
    stories: 3,
    building_square_feet: 3933,
    unit_square_feet: 750,
    unit_location: "first floor",
    monthly_base_rent_micro_usd: 1800000000,
    rent_basis_note: "750 SF x $28.80/SF/YR / 12 = $1,800/mo base; listing states rate may exclude certain utilities, building services, and property expenses - all-in estimated $2,100-2,400/mo pending expense disclosure (survey item srv-expense-stack).",
  },
]

