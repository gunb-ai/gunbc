data survey_obligations: List<SurveyObligation> = [
  SurveyObligation { id: "srv-panel-photo", site_id: "site-91-e21st-bayonne", question: "Panel and meter: service size, phase, spare capacity, dedicated-circuit feasibility for a 3-6 kW quiet rack; whose meter carries the first floor", method: "photograph panel + meter during walkthrough; clamp meter if permitted", gates_axis: ContinuousPower },
  SurveyObligation { id: "srv-cooling-increment", site_id: "site-91-e21st-bayonne", question: "Existing HVAC capacity and landlord consent for a dedicated mini-split (penetration + condenser placement) for the rack zone", method: "inspect air handler/condenser, ask landlord in writing", gates_axis: CoolingHeatRejection },
  SurveyObligation { id: "srv-fiber-demarc", site_id: "site-91-e21st-bayonne", question: "Carriers serving the address, fiber demarc location, business-class availability (Fios Business / Optimum / Lightpath)", method: "carrier availability check + demarc inspection", gates_axis: NetworkCapacityAndRepair },
  SurveyObligation { id: "srv-floor-loading", site_id: "site-91-e21st-bayonne", question: "1911 wood-frame first floor: point-load capacity where a ~400-600 kg quiet rack would stand; basement/crawlspace access to sister joists if needed", method: "inspect structure from below; engineer letter if ambiguous", gates_axis: FireElectricalCompliance },
  SurveyObligation { id: "srv-dba-baseline", site_id: "site-91-e21st-bayonne", question: "Ambient dBA by room, day and evening; noise sensitivity of adjacent units (both directions)", method: "sound meter during walkthrough, both floors if accessible", gates_axis: Habitability },
  SurveyObligation { id: "srv-geometry-capture", site_id: "site-91-e21st-bayonne", question: "Room geometry to layout tolerance (not instrument tolerance): estimated floor plan and heights for the SiteRealizationSpec", method: "Operator ruling 2026-08-10 (supersedes the LiDAR method): (1) request existing floor plans first - landlord/PM and Bayonne construction-permit records for the recent renovation (srv-floor-plan-request); (2) dense photo set at walkthrough covering every corner; (3) AI reconstruction from photos, scale-calibrated on in-frame constants (3x6-inch subway tile, 36/42-inch grab bars, 32-36-inch door leaves) and 2-3 tape anchor measurements; anchors upgrade decision-consumed dimensions to SpatialMeasured with tolerance. Bare-minimum metrology: precision is set by the consuming decision, never by the instrument.", gates_axis: Habitability },
  SurveyObligation { id: "srv-floor-plan-request", site_id: "site-91-e21st-bayonne", question: "Existing floor plans: landlord/PM marketing or as-built plans; Bayonne building-department permit drawings for the renovation", method: "ask Bellagio Property Management; municipal records request. Obtained plans enter as SpatialEstimated claims (plans lie), upgraded only by spot-check anchors", gates_axis: Habitability },
  SurveyObligation { id: "srv-lease-use-clause", site_id: "site-91-e21st-bayonne", question: "Does the office lease permit continuous-operation equipment, increased electrical draw, and a server rack; sublease/assignment terms; personal guarantee scope", method: "draft lease review with attorney", gates_axis: ZoningPermittedUse },
  SurveyObligation { id: "srv-expense-stack", site_id: "site-91-e21st-bayonne", question: "Which utilities, building services, and property expenses sit outside the $28.80 rate; historical electric cost for the unit", method: "written expense disclosure from Bellagio Property Management", gates_axis: TotalAndIncrementalCost },
  SurveyObligation { id: "srv-upstairs-tenancy", site_id: "site-91-e21st-bayonne", question: "Occupancy and use of floors 2-3 (office vs residential); shared systems; after-hours building access", method: "ask listing agents; observe during walkthrough", gates_axis: PhysicalAccess },
  SurveyObligation { id: "srv-access-path", site_id: "site-91-e21st-bayonne", question: "Equipment access path: door clear widths, thresholds, turning geometry, curb and rear access, building delivery rules - the largest object that can reach the interior", method: "tape measure + photos at walkthrough", gates_axis: WorkshopReceivingUtility },
  SurveyObligation { id: "srv-zoning-verify", site_id: "site-91-e21st-bayonne", question: "Zoning district and permitted-use table row for this parcel (office/tech-studio as-of-right?)", method: "Bayonne zoning office / published ordinance lookup", gates_axis: ZoningPermittedUse },
  SurveyObligation { id: "srv-insurance-quote", site_id: "site-91-e21st-bayonne", question: "Commercial GL + property quote including owned equipment; landlord COI requirements", method: "broker quote against draft lease", gates_axis: InsuranceCoverage },
  SurveyObligation { id: "srv-ordinance-track", site_id: "site-91-e21st-bayonne", question: "Bayonne data-center prohibition ordinance: final text, Planning Board action (2026-08-11), Council hearing/adoption (2026-08-12 18:00, 630 Avenue C - attendable), effective date, any amendments", method: "attend/track hearings; capture adopted text; model lifecycle transitions as distinct states; public-comment question prepared: does the ordinance exclude server rooms and computing equipment accessory and subordinate to an otherwise permitted principal use? (request an express accessory-IT exclusion pre-adoption)", gates_axis: ZoningPermittedUse },
  SurveyObligation { id: "srv-zoning-interpretation", site_id: "site-91-e21st-bayonne", question: "Written zoning applicability determination for the TRUE operating profile (machines, continuous load, 24/7 operation, external customers, employees, expansion bounds) - is this an office with incidental equipment or a prohibited principal use", method: "zoning officer request with exact operating profile; never a friendly label", gates_axis: ZoningPermittedUse },
  SurveyObligation { id: "srv-co-history", site_id: "site-91-e21st-bayonne", question: "Current first-floor CO + approved use; nonconformity certificate/variances/site-plan resolutions; permits open/closed; fire inspections + violations; renovation plans; building unit roster", method: "landlord document request + Bayonne OPRA", gates_axis: ZoningPermittedUse },
  SurveyObligation { id: "srv-parcel-map", site_id: "site-91-e21st-bayonne", question: "Official tax-map parcel geometry (reported Block 456 Lot 2, 21.4 x 100 ft claim) and zoning district/overlays", method: "Bayonne tax-assessment map + zoning map lookup", gates_axis: ZoningPermittedUse },
]

