module strategy.procurement_order

import std.types { Int, NonEmptyStr, List, Bool }
import std.nat { Nat }
import strategy.year_end_plan { PlanItem, year_end_plan_items, latest_start_day, find_item }
import strategy.fleet_decisions { fleet_decisions, is_decided }
import strategy.rack_power_engineering { collins_fleet_nodes, collins_node_planning_watts, fleet_demand_watts }

// THE PURCHASE ORDER, DERIVED. What has to be bought, how many, and by when - where every
// quantity comes from a fleet fact and every date comes from the plan, so this is a projection
// of decisions already made rather than a shopping list maintained beside them.
//
// Two things it refuses to do, both of which an ordinary purchase order does freely.
//
// It refuses to state a quantity it cannot derive. Several lines depend on decisions that are
// still open - which netboot variant, whether the local cache clears its floor, colo or the
// residence - and the honest form of those lines is QuantityBlocked naming the plan item that
// unblocks them, not a number chosen to make the list look complete. A blocked line is
// procurement information: it says an unmade decision is holding up an order, and it carries
// the date by which that becomes a schedule problem.
//
// It refuses to total. Almost every price here is an ESTIMATE from market observation rather
// than a quote against this order, and a single figure summed from estimates reads as a budget
// once it is written down. So the order prices as a BAND and reports its standing: a total is
// admitted only when every line is quoted, and until then the causes are named. DESIGN section
// 5's fabricated-plausible-output arm is exactly the risk - the plausible thing here is a
// confident number.
//
// THE QUANTITY THAT IS NOT 21. rack_power_engineering derives 21 nodes at 650 W planning draw,
// so 13,650 W. strategy.home_hosting models a 30 A circuit, which at 240 V is 5,760 W usable
// under the NEC continuous derate - about eight nodes. The residence therefore cannot power the
// fleet, and any line whose quantity scales with DEPLOYED nodes rather than OWNED nodes is
// blocked on siting-decision. Buying 21 racks' worth of anything before that fork is resolved
// is buying for a site that may not exist.

data no_awaits: List<NonEmptyStr> = []

data fleet_nodes: Int = collins_fleet_nodes
data dimm_slots_per_node: Int = 32
data memory_channels_per_node: Int = 16
data psu_per_node: Int = 2
data data_ports_per_node: Int = 2
data bmc_ports_per_node: Int = 1
data rack_screws_per_node: Int = 4

// Both populations the BOM decision chooses between, derived rather than described: one DIMM per
// channel is the floor fleet_qualification will admit, two per channel fills every physical slot
// and trades memory speed for capacity. Neither number is authored.
fn dimms_at_1dpc() -> Int { fleet_nodes * memory_channels_per_node }
fn dimms_at_2dpc() -> Int { fleet_nodes * dimm_slots_per_node }

type ComponentCategory
  = Memory
  | Storage
  | Networking
  | Power
  | Racking
  | Instrument

// A quantity is derived, blocked on a decision, or gross-of-inventory. The third arm exists
// because netting an unmeasured inventory against a known requirement understates the order by
// an unknown amount - the same refusal finance.personal_ledger makes about the RAM obligation.
type QuantityStanding
  = QuantityDerived { count: Int, basis: NonEmptyStr }
  | QuantityBlocked { on_plan_item: NonEmptyStr, obligation: NonEmptyStr }
  | QuantityGrossOfInventory { gross: Int, basis: NonEmptyStr, obligation: NonEmptyStr }

// PriceEstimated is NOT PriceQuoted and the type refuses to let them blur. An estimate is a
// market observation with a stated basis; a quote is a seller's offer against this order at a
// stated validity. Only the second can settle a purchase, and a total built from the first is
// an estimate however many lines it sums.
type PriceStanding
  = PriceQuoted { unit_low_micro: Nat, unit_high_micro: Nat, source: NonEmptyStr }
  | PriceEstimated { unit_low_micro: Nat, unit_high_micro: Nat, basis: NonEmptyStr }
  | PriceUnknown { obligation: NonEmptyStr }

type LineItem {
  key: NonEmptyStr
  category: ComponentCategory
  unit: NonEmptyStr
  quantity: QuantityStanding
  price: PriceStanding
  lead_time_days: Int
  needed_for: NonEmptyStr
  awaits_decisions: List<NonEmptyStr>
  note: NonEmptyStr
}

fn quantity_count(q: QuantityStanding) -> Int {
  match q {
    QuantityDerived { count, basis } => count,
    QuantityBlocked { on_plan_item, obligation } => 0,
    QuantityGrossOfInventory { gross, basis, obligation } => gross,
  }
}

fn quantity_is_settled(q: QuantityStanding) -> Bool {
  match q {
    QuantityDerived { count, basis } => true,
    QuantityBlocked { on_plan_item, obligation } => false,
    QuantityGrossOfInventory { gross, basis, obligation } => false,
  }
}

fn price_is_quoted(p: PriceStanding) -> Bool {
  match p {
    PriceQuoted { unit_low_micro, unit_high_micro, source } => true,
    PriceEstimated { unit_low_micro, unit_high_micro, basis } => false,
    PriceUnknown { obligation } => false,
  }
}

fn price_low_micro(p: PriceStanding) -> Nat {
  match p {
    PriceQuoted { unit_low_micro, unit_high_micro, source } => unit_low_micro,
    PriceEstimated { unit_low_micro, unit_high_micro, basis } => unit_low_micro,
    PriceUnknown { obligation } => 0,
  }
}

fn price_high_micro(p: PriceStanding) -> Nat {
  match p {
    PriceQuoted { unit_low_micro, unit_high_micro, source } => unit_high_micro,
    PriceEstimated { unit_low_micro, unit_high_micro, basis } => unit_high_micro,
    PriceUnknown { obligation } => 0,
  }
}

// ORDER-BY DERIVES FROM THE PLAN. The item that needs the part fixes when it is needed - its
// latest safe start - and the part's lead time fixes how much earlier it must be ordered. So a
// long-lead part with a near milestone can already be late on the day it is first written down,
// which is the whole reason this is computed rather than listed.
fn needed_by_day(l: LineItem) -> Int {
  fold(find_item(id: l.needed_for), init: 0, f: (acc, i) => latest_start_day(i: i))
}

fn order_by_day(l: LineItem) -> Int {
  needed_by_day(l: l) - l.lead_time_days
}

fn line_extended_low_micro(l: LineItem) -> Nat {
  quantity_count(q: l.quantity) * price_low_micro(p: l.price)
}

fn line_extended_high_micro(l: LineItem) -> Nat {
  quantity_count(q: l.quantity) * price_high_micro(p: l.price)
}

// ---------------------------------------------------------------------------------------------
// THE LINES. Quantities derive from fleet_nodes and the per-node counts above; nothing here is
// a typed-in total. Prices are ESTIMATES unless a line says otherwise, and each states the basis
// it rests on so a reader can attack it rather than inherit it.
// ---------------------------------------------------------------------------------------------

data line_dimms: LineItem = LineItem {
  key: "dram-dimms",
  category: Memory,
  unit: "DIMM",
  quantity: QuantityGrossOfInventory {
    gross: dimms_at_1dpc(),
    basis: "21 nodes x 16 CHANNELS at one DIMM per channel. The board carries 32 physical slots against 16 channels (8 per socket, two sockets), so this is the 1DPC quantity and NOT the slot count - populating all 32 at two DIMMs per channel is 672 modules and costs memory speed. fleet_qualification refuses a node whose channels are not fully populated, so 16 is a floor rather than a choice; whether to go beyond it to 2DPC is memory-bom-decision's, and it trades capacity against bandwidth.",
    obligation: "No on-hand memory census receipt exists and TWO INCOMPATIBLE READINGS STAND. mt_collins_held_unit records 254 GB visible as consistent with 8 x 32 GB; a UEFI smbiosview pass read 16 x 16 GB at 1DPC. Both total roughly 256 GB, so capacity cannot discriminate them, and they disagree about whether the machine runs at half memory bandwidth and about which upgrade is even the same purchase. mobo_x_memory_census records that the BMC firmware cannot produce a per-slot inventory, so the census needs the host-side route with a node POWERED AND BOOTED - the fleet is not running today, which makes producing it a scheduled task rather than a lookup and puts it on the critical path of this order rather than beside it. Netting unmeasured inventory against this gross would understate the order by an unknown amount.",
  },
  price: PriceEstimated {
    unit_low_micro: 80000000,
    unit_high_micro: 120000000,
    basis: "ci_node_build dimm_32gib_low_micro and dimm_32gib_high_micro, the observed 32 GiB band. The capacity per DIMM is itself open - memory-bom-decision selects it - and the 16 GiB and 64 GiB lots price differently per GB.",
  },
  lead_time_days: 14,
  needed_for: "memory-bom-decision",
  awaits_decisions: ["memory-population", "pilot-node-population"],
  note: "The single largest line by value and the one most exposed to an unmeasured input on both sides: the capacity is undecided and the on-hand stock is uncounted.",
}

data line_nvme: LineItem = LineItem {
  key: "m2-nvme-infrastructure-pair",
  category: Storage,
  unit: "M.2 NVMe drive",
  quantity: QuantityDerived {
    count: 4,
    basis: "TWO per infrastructure node across a redundant PAIR - not one per fleet node. The diskless design puts the boot image and the rack cache tier on two nodes and leaves the other nineteen stateless, so a dead drive can never take a compute node down because a compute node has no drive to lose. Two drives each because those two nodes are now the single component whose loss stops the fleet restarting, and unmirrored storage there converts a drive failure into a fleet outage - exactly the failure mode the design was chosen to remove.",
  },
  price: PriceEstimated {
    unit_low_micro: 160000000,
    unit_high_micro: 240000000,
    basis: "Used enterprise M.2 at 80-120 per TB, 2 TB, market observation 2026-09-04. Consumer parts are excluded by the write arithmetic in the note, not by preference.",
  },
  lead_time_days: 10,
  needed_for: "node-local-cache-drive",
  awaits_decisions: ["infrastructure-pair", "local-cache-drive-shape"],
  note: "THE LINE THAT SHRANK BY A FACTOR OF FIVE, and the reason is a design change rather than a better price. Populating every node was 21 drives at 3360-5040 dollars and carried a write load of 8.64 TB per node per day at a zero hit rate - 4.32 drive-writes per day on a 2 TB part against roughly 1 DWPD for used enterprise, so the fleet-wide population was failing its own endurance arithmetic before it was bought. Concentrating the storage on a redundant infrastructure pair costs 4 drives, and the compute nodes become stateless. What it BUYS in exchange is a new single point of failure that must be engineered rather than assumed: the pair carries boot, cache and artifact upload for the whole fleet, so its redundancy is now the fleet's availability.",
}

