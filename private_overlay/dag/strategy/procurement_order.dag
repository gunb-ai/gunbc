data order_lines: List<LineItem> = [
  line_dimms, line_nvme, line_data_switch, line_bmc_switch, line_patch_cables,
  line_ocp_nics, line_dacs, line_pdus, line_power_cords, line_rails,
  line_cage_nuts, line_blanking_panels, line_clamp_meter, line_label_printer,
]

// ---------------------------------------------------------------------------------------------
// THE ORDER'S STANDING. It refuses to be a total while any line is estimated, blocked, or
// gross-of-inventory, and it names every cause rather than reporting the first. A band computed
// from estimates is reported AS a band with its standing attached, because the failure mode here
// is not arithmetic - it is that a number written down once gets quoted later as a budget.
// ---------------------------------------------------------------------------------------------

fn orderable_now() -> List<LineItem> {
  filter(order_lines, l => quantity_is_settled(q: l.quantity))
}

fn blocked_lines() -> List<LineItem> {
  filter(order_lines, l => !quantity_is_settled(q: l.quantity))
}

fn unquoted_lines() -> List<LineItem> {
  filter(order_lines, l => !price_is_quoted(p: l.price))
}

fn orderable_low_micro() -> Nat {
  fold(orderable_now(), init: 0, f: (acc, l) => acc + line_extended_low_micro(l: l))
}

fn orderable_high_micro() -> Nat {
  fold(orderable_now(), init: 0, f: (acc, l) => acc + line_extended_high_micro(l: l))
}

type OrderStanding
  = OrderQuoted { low_micro: Nat, high_micro: Nat }
  | OrderEstimatedOnly { low_micro: Nat, high_micro: Nat, causes: NonEmptyStr }

fn order_standing() -> OrderStanding {
  if count(unquoted_lines()) == 0 && count(blocked_lines()) == 0 {
    OrderQuoted { low_micro: orderable_low_micro(), high_micro: orderable_high_micro() }
  } else {
    OrderEstimatedOnly {
      low_micro: orderable_low_micro(),
      high_micro: orderable_high_micro(),
      causes: "This band covers ONLY the lines whose quantity is settled, and every unit price in it is a market estimate rather than a quote against this order. It is not a budget and may not be quoted as one. Lines whose quantity is blocked contribute ZERO to it, which means the true order is larger than the band by an amount that cannot be stated until the blocking decisions are made - and the two largest exposures, DRAM and per-node NVMe, are both among them.",
    }
  }
}

// The lines that need ordering soonest, and the ones whose blocking decision is closest to
// costing schedule. A blocked line is not a line with no date - it is a line whose date belongs
// to the DECISION rather than to the seller, which is the more useful thing to see.
fn lines_ordered_by_urgency() -> List<LineItem> {
  sort_by(order_lines, fn(l) { order_by_day(l: l) })
}

fn lines_due_before_day(day: Int) -> List<LineItem> {
  filter(order_lines, l => order_by_day(l: l) < day)
}

// The unconditional lines: nothing in front of them, needed under every branch of every open
// decision. These are the ones to buy today, and the discipline this whole module exists to
// enforce is that everything NOT on this list waits for its decision.
// A SETTLED QUANTITY IS NOT AN ABSENT DECISION, and conflating them is how a purchase order
// quietly authorises the thing the plan says is still open. The earlier version of this
// function filtered on quantity alone, which made every derived count "buy today" - including
// the 10 gigabit cards and DACs, whose count is perfectly derivable from the infrastructure
// pair and whose PURCHASE waits on that pair being decided. Two different facts: how many, and
// whether at all.
//
// The second fact lives in strategy.fleet_decisions, so a line names the decisions it awaits
// and is unconditional only when every one of them is Decided. That also means the register
// and the order cannot drift: flipping a decision back to Deferred withdraws its lines from
// the buy-today list automatically rather than by someone remembering to edit here.
fn line_decisions_all_settled(l: LineItem) -> Bool {
  all(l.awaits_decisions, k =>
    any(fleet_decisions, d => d.key == k && is_decided(d: d)))
}

fn unconditional_lines() -> List<LineItem> {
  filter(order_lines, l => quantity_is_settled(q: l.quantity) && line_decisions_all_settled(l: l))
}

fn lines_awaiting_a_decision() -> List<LineItem> {
  filter(order_lines, l => quantity_is_settled(q: l.quantity) && !line_decisions_all_settled(l: l))
}

data procurement_thesis: NonEmptyStr = "Buy what every branch needs and nothing else. The BMC switch, the patch cables, the power cords, the cage nuts and the two instruments are required whether the fleet lands in a colo or the residence, whether netboot is RAM-loaded or NFS-rooted, and whether or not 10 gigabit is ever bought - so they carry no decision risk and should be ordered now. Every other line is waiting on a decision that is cheaper to make than to unmake, and the clamp meter is the highest-leverage item in the order because it replaces the 650 W planning assumption that the circuit sizing, the rack count and the colo quote all rest on."

data inventory_refusal_note: NonEmptyStr = "No line here is netted against on-hand stock, and that is deliberate rather than an omission. The DRAM line is the case that matters: strategy.mobo_x_memory_census models the recipe for an on-hand census and no receipt has been produced, so the quantity actually held is unknown. Netting an unmeasured inventory against a known requirement understates the order by an unknown amount and produces a shortfall discovered at racking time - which is the most expensive moment to discover it. The census is a prerequisite of the order, not a reconciliation after it."
