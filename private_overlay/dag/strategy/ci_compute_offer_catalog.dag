data circleci_caveat_note: NonEmptyStr = "CircleCI is priced in credits plus per-platform-user and per-feature charges. This catalog carries no composed per-minute figure for that class: inventing one from a credit table would look comparable to a flat runner and is refused. The CircleCI row is unquoted until extdeps.pricing.circleci exists."

data namespace_note: NonEmptyStr = "Namespace belongs in the competitor set and has no row here, because a competitor with no readable price is an unread price and not an absent one. Inventing a plausible figure for it would be the exact defect this tree exists to refuse."

data price_provenance_note: NonEmptyStr = "Hetzner CAX41 USD, GitHub Actions 2-core rates, and Ubicloud premium/arm standard-2 rates are projected from the public vendor modules. GCP N2 listed and spot vCPU-hours and OCI A1 flex hours are projected from strategy.node_rental (same listed hourly figures that module already cites). Blacksmith, Depot and CircleCI are RateUnquoted until those vendors have their own public pricing modules. Scaleway AMP2 stays EUR with no FX reading."

// 🟡 feature: Scaleway AMP2 remains an operator-relayed EUR hourly. Re-homing it as a public
// per-vendor module is a pricing survey, which this item is not.
// 🟡 dissolve-on: Scaleway has its own public extdeps module with cited version, and this row
// projects from that home the way Hetzner/GitHub/Ubicloud already do.

// Binding uses quoted_memory_units, not ByteSize/4GiB. Switching the divisor to 2^32 would
// re-price Ubicloud (8e9 bytes is not 8 GiB) and is refused by this item.

data ci_product_defaults_note: NonEmptyStr = "The hosted CI rows sell integration, isolation, cache, logs, billing, support and abuse handling on top of compute. Comparing their per-unit-minute rate with a raw VM rate is a fair way to bound our price and an unfair way to describe their margin."

type BindingResource
  = BoundByMemory { cpu_units_permille: Int, memory_units_permille: Int }
  | BoundByCpu { cpu_units_permille: Int, memory_units_permille: Int }
  | BoundEqually { units_permille: Int }

fn offer_binding_resource(o: ComputeOfferObservation) -> BindingResource {
  let cpu = offer_vcpu_count(o: o) * 1000
  let mem = offer_memory_units(o: o) * 1000 / 4
  if cpu < mem {
    BoundByCpu { cpu_units_permille: cpu, memory_units_permille: mem }
  } else {
    if mem < cpu {
      BoundByMemory { cpu_units_permille: cpu, memory_units_permille: mem }
    } else {
      BoundEqually { units_permille: cpu }
    }
  }
}

fn offer_unit_count_permille(o: ComputeOfferObservation) -> Int {
  match offer_binding_resource(o: o) {
    BoundByMemory { cpu_units_permille, memory_units_permille } => memory_units_permille
    BoundByCpu { cpu_units_permille, memory_units_permille } => cpu_units_permille
    BoundEqually { units_permille } => units_permille
  }
}

type UnitPriceStanding
  = UnitPriceUsd { micro: Int }
  | UnitPriceForeign { micro: Int, currency: CurrencyCode, obligation: NonEmptyStr }
  | UnitPriceUnquoted { obligation: NonEmptyStr }

fn offer_unit_price(o: ComputeOfferObservation) -> UnitPriceStanding {
  match o.rate {
    RateUnquoted { obligation } => UnitPriceUnquoted { obligation: obligation }
    RatePerHour { micro, currency } => quoted_unit_price(o: o, hourly_micro: micro, currency: currency)
    RatePerMinute { micro, currency } => quoted_unit_price(o: o, hourly_micro: micro * 60, currency: currency)
  }
}

fn quoted_unit_price(o: ComputeOfferObservation, hourly_micro: Int, currency: CurrencyCode) -> UnitPriceStanding {
  let units = offer_unit_count_permille(o: o)
  let micro = hourly_micro * 1000 / (60 * units)
  match currency {
    Usd => UnitPriceUsd { micro: micro }
    Eur => UnitPriceForeign {
      micro: micro,
      currency: Eur,
      obligation: "No exchange-rate reading is held. Converting at a rate nobody recorded would make a euro figure look like a dollar one; the row stays in its own currency until an FX observation with a timestamp exists.",
    }
  }
}

type ComputeOfferResolution
  = ComputeOfferResolved { offer: ComputeOfferObservation }
  | ComputeOfferMissing { identity: ComputeOfferIdentity }
  | ComputeOfferAmbiguous { identity: ComputeOfferIdentity, match_count: Int }

fn resolve_offer(id: ComputeOfferIdentity) -> ComputeOfferResolution {
  fold(ci_compute_offers, init: ComputeOfferMissing { identity: id }, f: fn(acc, o) {
    if offer_identity_equal(a: o.identity, b: id) {
      match acc {
        ComputeOfferMissing { identity } => ComputeOfferResolved { offer: o }
        ComputeOfferResolved { offer } => ComputeOfferAmbiguous { identity: id, match_count: 2 }
        ComputeOfferAmbiguous { identity, match_count } =>
          ComputeOfferAmbiguous { identity: id, match_count: match_count + 1 }
      }
    } else { acc }
  })
}

fn offer_identities_are_unique() -> Bool {
  all(ci_compute_offers, o => match resolve_offer(id: o.identity) {
    ComputeOfferResolved { offer } => true
    ComputeOfferMissing { identity } => false
    ComputeOfferAmbiguous { identity, match_count } => false
  })
}

type RouteCostStanding
  = RouteCostKnown { per_unit_minute_micro: Int, offer: ComputeOfferObservation }
  | RouteCostRefused { identity: ComputeOfferIdentity, reason: NonEmptyStr }

fn route_cost(id: ComputeOfferIdentity) -> RouteCostStanding {
  match resolve_offer(id: id) {
    ComputeOfferResolved { offer } =>
      match offer_unit_price(o: offer) {
        UnitPriceUsd { micro } => RouteCostKnown { per_unit_minute_micro: micro, offer: offer }
        UnitPriceForeign { micro, currency, obligation } =>
          RouteCostRefused { identity: id, reason: obligation }
        UnitPriceUnquoted { obligation } =>
          RouteCostRefused { identity: id, reason: obligation }
      }
    ComputeOfferMissing { identity } =>
      RouteCostRefused {
        identity: identity,
        reason: "no offer carries this identity. A missing price is not a free price, so this refuses instead of returning zero.",
      }
    ComputeOfferAmbiguous { identity, match_count } =>
      RouteCostRefused {
        identity: identity,
        reason: "more than one offer carries this identity. The catalog must not silently pick one of them.",
      }
  }
}

fn offer_is_spill_admitted(o: ComputeOfferObservation) -> Bool {
  match o.spill_admission {
    SpillAdmitted { note } => true
    CompetitorNotSpill { note } => false
    ExperimentalNotAdmitted { obligation } => false
  }
}

fn admitted_spill_offers() -> List<ComputeOfferObservation> {
  filter(ci_compute_offers, o => offer_is_spill_admitted(o: o))
}

fn competitor_offers() -> List<ComputeOfferObservation> {
  filter(ci_compute_offers, o => match o.market_class {
    HostedCiProduct => true
    RawInfrastructure => false
  })
}

fn hetzner_cax41_tariff_is_the_current_usd_row() -> Bool {
  tariff_is_current(t: cax41_catalog_usd.tariff)
}
