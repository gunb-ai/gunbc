// JOIN, NOT A VENDOR AUTHORITY. Public PR 8950 restored extdeps.ci_compute_pricing and was
// refused: a generic hub restated per-vendor facts that already live in extdeps.ci_runner,
// extdeps.pricing and extdeps.cloud. This module is the consumer join those three strategy
// pricing modules need — spill admission, unit-minute normalization, and lookup cardinality —
// over rows consumed from those public authorities where they exist. It is strategy, not
// extdeps: which offers we treat as spill routes is our policy, and DESIGN §3's external
// upstream decomposition forbids a hub that enumerates vendors as if they were one product.
//
// Cited vendor rates below are projected from the public rows. Operator-relayed rates that
// still have no per-vendor public home remain TranscribedUncited; this item does not re-price
// them. Public vendor pricing belongs on public main, one module per independently versioned
// upstream, when those homes land — not in a restored ci_compute_pricing.

type CpuArchitecture
  = Amd64
  | Arm64
  | ArchitectureUnstated

fn architecture_from_toolchain(a: Architecture) -> CpuArchitecture {
  match a {
    X86_64 => Amd64
    Aarch64 => Arm64
    X86 => ArchitectureUnstated
    Arm => ArchitectureUnstated
    Armv7 => ArchitectureUnstated
    Mips => ArchitectureUnstated
    Mipsel => ArchitectureUnstated
    Mips64 => ArchitectureUnstated
    Mips64el => ArchitectureUnstated
    Riscv64 => ArchitectureUnstated
    Wasm32 => ArchitectureUnstated
  }
}

fn architecture_label(a: CpuArchitecture) -> NonEmptyStr {
  match a {
    Amd64 => "x86-64"
    Arm64 => "Arm64"
    ArchitectureUnstated => "unstated"
  }
}

type CpuEntitlement
  = PhysicalCore
  | SmtHardwareThread
  | ProviderVcpuUnspecified
  | SharedBurstableVcpu

fn entitlement_label(e: CpuEntitlement) -> NonEmptyStr {
  match e {
    PhysicalCore => "physical core"
    SmtHardwareThread => "SMT thread"
    ProviderVcpuUnspecified => "vCPU, unstated"
    SharedBurstableVcpu => "shared burstable"
  }
}

type ResourceDedication
  = DedicatedResource { note: NonEmptyStr }
  | SharedResource { note: NonEmptyStr }
  | DedicationUnread { obligation: NonEmptyStr }

fn dedication_label(d: ResourceDedication) -> NonEmptyStr {
  match d {
    DedicatedResource { note } => "dedicated"
    SharedResource { note } => "shared"
    DedicationUnread { obligation } => "unread"
  }
}

type InterruptionStanding
  = NonPreemptible { note: NonEmptyStr }
  | Preemptible { note: NonEmptyStr }
  | InterruptionUnread { obligation: NonEmptyStr }

fn interruption_label(i: InterruptionStanding) -> NonEmptyStr {
  match i {
    NonPreemptible { note } => "durable"
    Preemptible { note } => "preemptible"
    InterruptionUnread { obligation } => "unread"
  }
}

type PerformanceStanding
  = PerformanceMeasured { benchmark_suite: NonEmptyStr, score: Int, receipt: NonEmptyStr }
  | PerformanceUnmeasured { obligation: NonEmptyStr }

data performance_unmeasured_default: PerformanceStanding = PerformanceUnmeasured {
  obligation: "No benchmark has been run. A physical core, an SMT thread and a shared vCPU are not interchangeable units of work until a receipt says so.",
}

type MarketClass
  = RawInfrastructure
  | HostedCiProduct

fn market_class_label(c: MarketClass) -> NonEmptyStr {
  match c {
    RawInfrastructure => "raw infrastructure"
    HostedCiProduct => "hosted CI"
  }
}

type SpillAdmission
  = SpillAdmitted { note: NonEmptyStr }
  | CompetitorNotSpill { note: NonEmptyStr }
  | ExperimentalNotAdmitted { obligation: NonEmptyStr }

fn spill_admission_label(s: SpillAdmission) -> NonEmptyStr {
  match s {
    SpillAdmitted { note } => "spill route"
    CompetitorNotSpill { note } => "competitor"
    ExperimentalNotAdmitted { obligation } => "experimental"
  }
}

// 🟡 feature: VendorRate and UnitPriceUsd keep micro-Int after reading MoneyPerMinute /
// money_amount_micro_count. The join's job this item is to execute existing figures, not to
// migrate the spill algebra onto std.measure.
// 🟡 dissolve-on: offer_unit_price / route_cost consume MoneyPerMinute (and a single ByteSize
// binding unit) without a parallel Int rate type.

type VendorRate
  = RatePerHour { micro: Int, currency: CurrencyCode }
  | RatePerMinute { micro: Int, currency: CurrencyCode }
  | RateUnquoted { obligation: NonEmptyStr }

fn usd_per_hour(micros: Int) -> VendorRate { RatePerHour { micro: micros, currency: Usd } }
fn usd_per_minute(micros: Int) -> VendorRate { RatePerMinute { micro: micros, currency: Usd } }
fn eur_per_hour(micros: Int) -> VendorRate { RatePerHour { micro: micros, currency: Eur } }

type ComputeOfferIdentity {
  provider: NonEmptyStr
  sku: NonEmptyStr
}

fn offer_identity_equal(a: ComputeOfferIdentity, b: ComputeOfferIdentity) -> Bool {
  a.provider == b.provider && a.sku == b.sku
}

type ComputeOfferObservation {
  identity: ComputeOfferIdentity
  product: NonEmptyStr
  market_class: MarketClass
  architecture: CpuArchitecture
  entitlement: CpuEntitlement
  dedication: ResourceDedication
  interruption: InterruptionStanding
  performance: PerformanceStanding
  spill_admission: SpillAdmission
  vcpus: HardwareThreadCount
  memory_bytes: ByteSize
  memory_quote: MemoryQuoteScale
  rate: VendorRate
}

// Vendor catalogs quote memory on different scales (Hetzner binary GiB, Ubicloud decimal GB).
// The quote scale is data, not a second divisor chosen per row at the binding site.
type MemoryQuoteScale
  = QuotedGibibyte
  | QuotedGigabyte

fn quoted_memory_units(bytes: ByteSize, scale: MemoryQuoteScale) -> Int {
  match scale {
    QuotedGibibyte => nat_count_as_int(n: byte_size_count(b: bytes) / 1073741824)
    QuotedGigabyte => nat_count_as_int(n: byte_size_count(b: bytes) / 1000000000)
  }
}

fn offer_vcpu_count(o: ComputeOfferObservation) -> Int {
  nat_count_as_int(n: hardware_thread_count_value(t: o.vcpus))
}

fn offer_memory_units(o: ComputeOfferObservation) -> Int {
  quoted_memory_units(bytes: o.memory_bytes, scale: o.memory_quote)
}

fn memory_quoted_as_gibibytes(n: Nat) -> ByteSize {
  byte_size(n * 1073741824)
}

fn memory_quoted_as_gigabytes(n: Nat) -> ByteSize {
  byte_size(n * 1000000000)
}

fn money_per_minute_as_int(q: MoneyPerMinute) -> Int {
  money_per_minute_micros(q: q)
}

fn nat_count_as_int(n: Nat) -> Int { n }

// Rate on the two GCP rows is the whole 2-vCPU / 8 GiB offer (n2-standard-128 hourly / 64),
// matching Hetzner/OCI whole-shape hours. quoted_unit_price then divides by that shape's units.

data gcp_n2_on_demand: ComputeOfferObservation = ComputeOfferObservation {
  identity: ComputeOfferIdentity { provider: "Google Cloud", sku: "n2-standard-128-on-demand" },
  product: "N2 on-demand (n2-standard-128 derived)",
  market_class: RawInfrastructure,
  architecture: Amd64,
  entitlement: SmtHardwareThread,
  dedication: DedicatedResource { note: "N2 runs on Intel processors and each vCPU is one hardware thread." },
  interruption: NonPreemptible { note: "Standard on-demand allocation." },
  performance: performance_unmeasured_default,
  spill_admission: SpillAdmitted { note: "Expensive x86 emergency route. Appropriate when a job requires x86 and cannot wait." },
  vcpus: hardware_thread_count( 2),
  memory_bytes: memory_quoted_as_gibibytes(n: 8),
  memory_quote: QuotedGibibyte,
  rate: usd_per_hour(micros: gcp_n2_two_vcpu_eight_gib_hourly_usd_micro(full_machine_hourly_micro: gcp_n2_standard_128_listed_hourly_usd_micro)),
}

