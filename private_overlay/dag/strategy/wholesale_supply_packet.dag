fn packet_count() -> Int { count(wholesale_seller_packets) }

fn list_price_label(s: ListPriceStanding) -> String {
  match s {
    ListPriceCited { price_authority } => join(["cited:", declaration_ref_display_key(ref: price_authority)], "")
    ListPriceUnstated { catalog } => join(["unstated:", declaration_ref_display_key(ref: catalog)], "")
  }
}

fn silicon_label(s: SiliconStanding) -> String {
  match s {
    SiliconEntitlementCited { entitlement_authority } =>
      join(["cited:", declaration_ref_display_key(ref: entitlement_authority)], "")
    SiliconUnstated { catalog } => join(["unstated:", declaration_ref_display_key(ref: catalog)], "")
  }
}

fn channel_constructor_label(c: ArmCapacityChannel) -> String {
  match c {
    SellerOwnMetalStated => "SellerOwnMetalStated"
    ResoldNamedCloud { vendor_words: _ } => "ResoldNamedCloud"
    CustomerAccountNamedCloud { vendor_words: _ } => "CustomerAccountNamedCloud"
    CloudOperatorIsTheSeller { vendor_words: _ } => "CloudOperatorIsTheSeller"
    SoftwareOnCustomerHosts => "SoftwareOnCustomerHosts"
    CapacityChannelUnread => "CapacityChannelUnread"
  }
}

fn host_label(s: HostStanding) -> String {
  match s {
    HostCited { channel, authority } =>
      join(["cited:", channel_constructor_label(c: channel), ":", declaration_ref_display_key(ref: authority)], "")
    HostStandingUnstated { catalog } => join(["unstated:", declaration_ref_display_key(ref: catalog)], "")
  }
}

fn cost_label(s: OurCostFloorStanding) -> String {
  match s {
    CostFloorConcurrencyUnstated { floor, catalog, why: _ } =>
      join([
        "concurrency-unstated:",
        declaration_ref_display_key(ref: floor),
        ";",
        declaration_ref_display_key(ref: catalog),
      ], "")
  }
}

fn packet_outreach_label(o: PacketOutreach) -> String {
  match o {
    PreparedUnsent { unsent } =>
      outreach_arm_label(o: RelationshipOutreachUnsent { unsent: unsent })
    DraftBlocked { why } => "DraftBlocked"
  }
}

fn packet_csv_row(p: WholesaleSellerPacket) -> String {
  join([
    p.seller_id as String,
    declaration_ref_display_key(ref: p.identity),
    declaration_ref_display_key(ref: p.arm_shape_catalog),
    list_price_label(s: p.list_price),
    silicon_label(s: p.silicon),
    host_label(s: p.host),
    cost_label(s: p.our_cost),
    declaration_ref_display_key(ref: p.wholesale_argument),
    declaration_ref_display_key(ref: p.hetzner_row),
    declaration_ref_display_key(ref: p.hetzner_listed),
    declaration_ref_display_key(ref: p.hetzner_cax_reply),
    packet_outreach_label(o: p.outreach),
    p.send_read_obligation.event as String,
    must_read_label(refs: p.send_read_obligation.must_read),
  ], "|")
}

fn must_read_label(refs: List<DeclarationRef>) -> String {
  join(map(refs, r => declaration_ref_display_key(ref: r)), ";")
}

data wholesale_packet_csv_path: NonEmptyStr = "docs/strategy/wholesale-supply-packet-generated.csv"
data wholesale_packet_csv_authority: NonEmptyStr = "strategy.wholesale_supply_packet"

data wholesale_packet_csv_header: String = "seller_id|identity|arm_shape_catalog|list_price|silicon|host|our_cost|wholesale_argument|hetzner_row|hetzner_listed|hetzner_cax_reply|outreach_arm|send_obligation_event|send_obligation_must_read"

fn expected_wholesale_packet_csv() -> String {
  join(concat(
    [wholesale_packet_csv_header],
    map(wholesale_seller_packets, p => packet_csv_row(p: p)),
  ), "\n") + "\n"
}

fn wholesale_packet_emit_cli() -> CliWireResponse {
  CliWirePrintable { bytes: expected_wholesale_packet_csv(), exit: ExitSuccess }
}

fn packet_outreach_ok(p: WholesaleSellerPacket) -> Bool {
  match p.outreach {
    PreparedUnsent { unsent } =>
      outreach_asks_coherent(o: RelationshipOutreachUnsent { unsent: unsent }) && count(unsent.asks) == 2
    DraftBlocked { why } => false
  }
}

fn cited_price_and_silicon_resolve() -> Bool {
  money_amount_micro_count(m: ubicloud_arm_standard_16_price.per_minute.amount) > 0
    && money_amount_micro_count(m: github_actions_linux_arm_2core_price.per_minute.amount) > 0
    && ubicloud_shape_entitlement(architecture: Aarch64) == DedicatedPhysicalCore
    && enquiry_is_answered(p: hetzner_wholesale_quantity_enquiry.principal)
    && match hetzner_cax_support_request_id() {
      EnquiryRequestId { request_id: _ } => true
      PrincipalHasNoEnquiry => false
    }
}

fn packet_cost_cites_floor(p: WholesaleSellerPacket) -> Bool {
  match p.our_cost {
    CostFloorConcurrencyUnstated { floor, catalog, why } =>
      declaration_ref_eq(a: floor, b: cost_floor_fn_ref)
        && declaration_ref_resolves(r: floor)
        && declaration_ref_eq(a: catalog, b: p.arm_shape_catalog)
        && why == cost_floor_concurrency_why
  }
}

fn packet_citations_resolve(p: WholesaleSellerPacket, packet_decl: DeclarationRef) -> Bool {
  all(packet_projected_citation_refs(p: p), r =>
    count(must_read_ref_refusals(packet: packet_decl, r: r)) == 0
  )
}

fn list_price_citation_refs(s: ListPriceStanding) -> List<DeclarationRef> {
  match s {
    ListPriceCited { price_authority } => [price_authority]
    ListPriceUnstated { catalog } => [catalog]
  }
}

fn silicon_citation_refs(s: SiliconStanding) -> List<DeclarationRef> {
  match s {
    SiliconEntitlementCited { entitlement_authority } => [entitlement_authority]
    SiliconUnstated { catalog } => [catalog]
  }
}

fn host_citation_refs(s: HostStanding) -> List<DeclarationRef> {
  match s {
    HostCited { channel: _, authority } => [authority]
    HostStandingUnstated { catalog } => [catalog]
  }
}

fn cost_citation_refs(s: OurCostFloorStanding) -> List<DeclarationRef> {
  match s {
    CostFloorConcurrencyUnstated { floor, catalog, why: _ } => [floor, catalog]
  }
}

fn packet_projected_citation_refs(p: WholesaleSellerPacket) -> List<DeclarationRef> {
  concat(
    concat(
      concat(
        concat(
          [
            p.identity,
            p.arm_shape_catalog,
            p.wholesale_argument,
            p.hetzner_row,
            p.hetzner_listed,
            p.hetzner_cax_reply,
          ],
          list_price_citation_refs(s: p.list_price),
        ),
        silicon_citation_refs(s: p.silicon),
      ),
      host_citation_refs(s: p.host),
    ),
    cost_citation_refs(s: p.our_cost),
  )
}

fn packet_joins_wholesale_buyer() -> Bool {
  packet_unsent_while_term_unquoted(o: packet_ubicloud.outreach, i: ubicloud_inquiry)
    && packet_unsent_while_term_unquoted(o: packet_blacksmith.outreach, i: blacksmith_inquiry)
    && match ubicloud_inquiry.end_customer_price {
      EndCustomerMinuteRate { micro_per_minute: _, currency: _, product: _, citation: _, price_authority, not_wholesale_reason: _ } =>
        match packet_ubicloud.list_price {
          ListPriceCited { price_authority: packet_auth } =>
            declaration_ref_eq(a: price_authority, b: packet_auth)
              && facing_is_wholesale_term(p: ubicloud_inquiry.end_customer_price) == false
          ListPriceUnstated { catalog } => false
        }
      EndCustomerRateUnquoted { obligation } => false
      WholesaleTermQuoted { micro_per_month, term_months, currency, source } => false
      WholesaleTermUnquoted { obligation } => false
    }
    && match packet_blacksmith.list_price {
      ListPriceUnstated { catalog } =>
        facing_is_wholesale_term(p: blacksmith_inquiry.end_customer_price) == false
      ListPriceCited { price_authority } => false
    }
}

fn draft_text_omits_node_unit_inventory_count(text: String) -> Bool {
  !string_contains(s: text, pattern: " node")
    && !string_contains(s: text, pattern: "unit")
    && !string_contains(s: text, pattern: "inventory")
}

fn packet_draft_omits_fleet_claims(p: WholesaleSellerPacket) -> Bool {
  match p.outreach {
    PreparedUnsent { unsent } =>
      draft_text_omits_node_unit_inventory_count(text: unsent.intervention.instruction as String)
    DraftBlocked { why } => false
  }
}

fn packet_draft_omits_transcribed_listed_price_text(text: String) -> Bool {
  !string_contains(s: text, pattern: cax41_listed_monthly_usd_wire())
}

fn packet_draft_omits_transcribed_listed_price(p: WholesaleSellerPacket) -> Bool {
  match p.outreach {
    PreparedUnsent { unsent } =>
      packet_draft_omits_transcribed_listed_price_text(text: unsent.intervention.instruction as String)
    DraftBlocked { why } => false
  }
}

fn host_cited_authority(h: HostStanding, authority: DeclarationRef) -> Bool {
  match h {
    HostCited { channel: _, authority: a } => declaration_ref_eq(a: a, b: authority)
    HostStandingUnstated { catalog: _ } => false
  }
}

fn host_is_unstated_catalog(h: HostStanding, catalog: DeclarationRef) -> Bool {
  match h {
    HostStandingUnstated { catalog: c } => declaration_ref_eq(a: c, b: catalog)
    HostCited { channel: _, authority: _ } => false
  }
}

fn packet_holds_host() -> Bool {
  host_cited_authority(h: packet_blacksmith.host, authority: blacksmith_arm_capacity_ref)
    && host_cited_authority(h: packet_depot.host, authority: depot_arm_capacity_ref)
    && host_cited_authority(
      h: packet_github_actions.host,
      authority: github_actions_arm_capacity_ref,
    )
    && host_is_unstated_catalog(h: packet_circleci.host, catalog: circleci_catalog_ref)
    && host_is_unstated_catalog(h: packet_warpbuild.host, catalog: warpbuild_catalog_ref)
    && host_is_unstated_catalog(h: packet_ubicloud.host, catalog: ubicloud_catalog_ref)
    && host_is_unstated_catalog(
      h: host_standing_from_channel(
        channel: CapacityChannelUnread,
        catalog: circleci_catalog_ref,
        channel_ref: circleci_catalog_ref,
      ),
      catalog: circleci_catalog_ref,
    )
}

fn packet_catalog_has_arm(availability: RunnerCatalogAvailability) -> Bool {
  count(arm_shape_labels(availability: availability)) > 0
}

fn packet_holds_catalogs() -> Bool {
  packet_catalog_has_arm(availability: blacksmith_runner_catalog)
    && packet_catalog_has_arm(availability: circleci_runner_catalog)
    && packet_catalog_has_arm(availability: depot_runner_catalog)
    && packet_catalog_has_arm(availability: github_actions_runner_catalog)
    && packet_catalog_has_arm(availability: warpbuild_runner_catalog)
    && packet_catalog_has_arm(availability: ubicloud_runner_catalog_shapes)
}

fn packet_holds_outreach() -> Bool { all(wholesale_seller_packets, p => packet_outreach_ok(p: p)) }
fn packet_holds_cost() -> Bool { all(wholesale_seller_packets, p => packet_cost_cites_floor(p: p)) }
fn packet_holds_citations() -> Bool {
  packet_citations_resolve(p: packet_blacksmith, packet_decl: packet_blacksmith_ref)
    && packet_citations_resolve(p: packet_circleci, packet_decl: packet_circleci_ref)
    && packet_citations_resolve(p: packet_depot, packet_decl: packet_depot_ref)
    && packet_citations_resolve(p: packet_github_actions, packet_decl: packet_github_actions_ref)
    && packet_citations_resolve(p: packet_warpbuild, packet_decl: packet_warpbuild_ref)
    && packet_citations_resolve(p: packet_ubicloud, packet_decl: packet_ubicloud_ref)
}
fn packet_holds_cited_authorities() -> Bool { cited_price_and_silicon_resolve() }
fn packet_holds_inquiries() -> Bool { packet_joins_wholesale_buyer() }
fn packet_holds_draft() -> Bool {
  all(wholesale_seller_packets, p => packet_draft_omits_fleet_claims(p: p))
    && all(wholesale_seller_packets, p => packet_draft_omits_transcribed_listed_price(p: p))
}
fn packet_holds_asks() -> Bool { all(wholesale_prepared_asks, a => ask_is_unsent(a: a)) }
fn packet_holds_count() -> Bool { packet_count() == 6 && offer_wholesale_through_reseller.id == "wholesale-through-ci-reseller" }

fn must_read_ref_refusals(packet: DeclarationRef, r: DeclarationRef) -> List<MustReadCitationUnresolved> {
  let resolution = resolve_declaration_ref(ref: r, facts: audit_decl_facts, modules: audit_module_facts)
  match resolution {
    DeclarationRefResolved { declaration_identity: _ } => []
    DeclarationRefModuleAbsent { reference: _ } =>
      [MustReadCitationUnresolved {
        packet: packet,
        reference: r,
        arm: declaration_ref_resolution_arm_key(resolution: resolution),
      }]
    DeclarationRefDeclarationAbsent { reference: _ } =>
      [MustReadCitationUnresolved {
        packet: packet,
        reference: r,
        arm: declaration_ref_resolution_arm_key(resolution: resolution),
      }]
    DeclarationRefFieldAbsent { reference: _ } =>
      [MustReadCitationUnresolved {
        packet: packet,
        reference: r,
        arm: declaration_ref_resolution_arm_key(resolution: resolution),
      }]
    DeclarationRefAmbiguous { reference: _, candidates: _ } =>
      [MustReadCitationUnresolved {
        packet: packet,
        reference: r,
        arm: declaration_ref_resolution_arm_key(resolution: resolution),
      }]
  }
}

fn send_read_obligation_refusals(
  packet: DeclarationRef,
  o: OperatorSendReadObligation,
) -> List<MustReadCitationUnresolved> {
  fold(o.must_read, init: [], f: fn(acc, r) {
    concat(acc, must_read_ref_refusals(packet: packet, r: r))
  })
}

fn send_read_obligation_holds(packet: DeclarationRef, o: OperatorSendReadObligation) -> Bool {
  count(send_read_obligation_refusals(packet: packet, o: o)) == 0
}

fn declaration_ref_resolves(r: DeclarationRef) -> Bool {
  match resolve_declaration_ref(ref: r, facts: audit_decl_facts, modules: audit_module_facts) {
    DeclarationRefResolved { declaration_identity: _ } => true
    DeclarationRefModuleAbsent { reference: _ } => false
    DeclarationRefDeclarationAbsent { reference: _ } => false
    DeclarationRefFieldAbsent { reference: _ } => false
    DeclarationRefAmbiguous { reference: _, candidates: _ } => false
  }
}

data fixture_no_such_send_read_ref: DeclarationRef = decl_ref(
  module_path: "strategy.wholesale_supply_packet",
  decl_name: "no_such_send_read_declaration",
)

data fixture_dangling_send_read: OperatorSendReadObligation = OperatorSendReadObligation {
  event: "fixture: a must_read ref that names no declaration must refuse",
  must_read: [fixture_no_such_send_read_ref],
}

fn dangling_send_read_refuses() -> Bool {
  count(send_read_obligation_refusals(
    packet: packet_blacksmith_ref,
    o: fixture_dangling_send_read,
  )) > 0
}

fn packet_holds_send_read() -> Bool {
  send_read_obligation_holds(packet: packet_blacksmith_ref, o: packet_blacksmith.send_read_obligation)
    && send_read_obligation_holds(packet: packet_circleci_ref, o: packet_circleci.send_read_obligation)
    && send_read_obligation_holds(packet: packet_depot_ref, o: packet_depot.send_read_obligation)
    && send_read_obligation_holds(packet: packet_github_actions_ref, o: packet_github_actions.send_read_obligation)
    && send_read_obligation_holds(packet: packet_warpbuild_ref, o: packet_warpbuild.send_read_obligation)
    && send_read_obligation_holds(packet: packet_ubicloud_ref, o: packet_ubicloud.send_read_obligation)
}

fn every_packet_holds() -> Bool {
  packet_holds_count()
    && packet_holds_catalogs()
    && packet_holds_outreach()
    && packet_holds_cost()
    && packet_holds_citations()
    && packet_holds_cited_authorities()
    && packet_holds_inquiries()
    && packet_holds_draft()
    && packet_holds_asks()
    && packet_holds_host()
    && packet_holds_send_read()
}

fn cax41_listed_monthly_usd_wire() -> String {
  fixed_point_wire(
    value: money_amount_micro_count(m: cax41_listed.monthly.amount) / 10000,
    decimals: 2,
  )
}

fn csv_omits_hetzner_console_cap() -> Bool {
  string_contains(
    s: expected_wholesale_packet_csv(),
    pattern: declaration_ref_display_key(ref: hetzner_listed_ref),
  )
    && !string_contains(s: expected_wholesale_packet_csv(), pattern: cax41_listed_monthly_usd_wire())
}

fn wholesale_packet_invariants() -> Bool {
  every_packet_holds() && csv_omits_hetzner_console_cap()
}
