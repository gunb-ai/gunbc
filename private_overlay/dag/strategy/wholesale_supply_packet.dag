// Per-seller operator drafts. strategy.wholesale_buyer owns the Ubicloud and Blacksmith
// commercial facts (end-customer rate vs term quote). This module consumes those two inquiries
// and adds the four CI-runner sellers that module does not yet carry. Nothing here sends mail.

type SiliconStanding
  = SiliconEntitlementCited { entitlement_authority: DeclarationRef }
  | SiliconUnstated { catalog: DeclarationRef }

type HostStanding
  = HostCited { channel: ArmCapacityChannel, authority: DeclarationRef }
  | HostStandingUnstated { catalog: DeclarationRef }

type ListPriceStanding
  = ListPriceCited { price_authority: DeclarationRef }
  | ListPriceUnstated { catalog: DeclarationRef }

type OurCostFloorStanding
  = CostFloorConcurrencyUnstated {
      floor: DeclarationRef
      catalog: DeclarationRef
      why: NonEmptyStr
    }

type OperatorSendReadObligation {
  event: NonEmptyStr
  must_read: List<DeclarationRef>
}

type MustReadCitationUnresolved {
  packet: DeclarationRef
  reference: DeclarationRef
  arm: String
}

type WholesaleSellerPacket {
  seller_id: NonEmptyStr
  identity: DeclarationRef
  arm_shape_catalog: DeclarationRef
  list_price: ListPriceStanding
  silicon: SiliconStanding
  host: HostStanding
  our_cost: OurCostFloorStanding
  wholesale_argument: DeclarationRef
  hetzner_row: DeclarationRef
  hetzner_listed: DeclarationRef
  hetzner_cax_reply: DeclarationRef
  outreach: PacketOutreach
  send_read_obligation: OperatorSendReadObligation
}

data wholesale_argument_ref: DeclarationRef = decl_ref(
  module_path: "strategy.year_end_plan",
  decl_name: "item_wholesale_supply_channel",
)

data hetzner_row_ref: DeclarationRef = decl_ref(
  module_path: "strategy.node_rental",
  decl_name: "hetzner_row",
)

data hetzner_listed_ref: DeclarationRef = decl_ref(
  module_path: "extdeps.cloud.hetzner",
  decl_name: "cax41_listed",
)

data hetzner_cax_reply_ref: DeclarationRef = decl_ref(
  module_path: "strategy.node_rental",
  decl_name: "hetzner_wholesale_quantity_enquiry",
)

data offer_wholesale_ref: DeclarationRef = decl_ref(
  module_path: "strategy.b2b_capacity_track",
  decl_name: "offer_wholesale_through_reseller",
)

data cost_floor_fn_ref: DeclarationRef = decl_ref(
  module_path: "strategy.cost_floor",
  decl_name: "floor_micro_per_unit_minute",
)

data cost_floor_concurrency_why: NonEmptyStr = "floor_micro_per_unit_minute takes utilization_permille, not a runner shape's advertised vCPU count"

fn packet_cost_for_catalog(catalog: DeclarationRef) -> OurCostFloorStanding {
  CostFloorConcurrencyUnstated {
    floor: cost_floor_fn_ref,
    catalog: catalog,
    why: cost_floor_concurrency_why,
  }
}

fn corpus_receipt(id: NonEmptyStr, module_path: String, decl_name: String) -> ActionReceipt {
  ActionReceipt {
    receipt_id: id,
    evidence: CorpusDeclaration {
      declaration: decl_ref(module_path: module_path, decl_name: decl_name),
    },
  }
}

data ask_price_volume_reliability: PreparedAsk = PreparedAsk {
  ask_id: "price-volume-reliability-requirement",
  ask: "a stated price, volume and reliability requirement for dedicated Ampere capacity underneath their ARM CI product, or the conversation stops short of a requirement",
  standing: AskUnsent { reason: "the operator has not sent this enquiry; sending is theirs" },
}

data ask_explicit_no: PreparedAsk = PreparedAsk {
  ask_id: "explicit-no",
  ask: "an explicit no, if they will not consider dedicated Ampere supply under their product",
  standing: AskUnsent { reason: "the operator has not sent this enquiry; sending is theirs" },
}

data wholesale_prepared_asks: List<PreparedAsk> = [ask_price_volume_reliability, ask_explicit_no]

type WholesaleDraft
  = DraftReady { text: NonEmptyStr }
  | DraftRefused { why: NonEmptyStr }

type PacketOutreach
  = PreparedUnsent { unsent: UnsentOutreach }
  | DraftBlocked { why: NonEmptyStr }

fn packet_outreach_is_prepared(o: PacketOutreach) -> Bool {
  match o {
    PreparedUnsent { unsent: _ } => true
    DraftBlocked { why } => false
  }
}

fn wholesale_draft(seller_label: NonEmptyStr) -> WholesaleDraft {
  match hetzner_cax_support_request_id() {
    EnquiryRequestId { request_id: _ } =>
      DraftReady {
        text: join([
          "Hello,\n\n",
          "I operate Gunbai LLC (gunb.ai). We run dedicated Ampere capacity and are asking whether ",
          seller_label as String,
          " would consider taking that capacity underneath your ARM CI product — a supply conversation, not a request that you buy minutes from us as an end customer.\n\n",
          "The opening is supply, not a quoted price. Publicly listed cloud ARM that would otherwise stand as a retail floor is presently not purchasable on the account we hold.\n\n",
          "Two questions, and either answer closes the item:\n\n",
          "1. If you would consider dedicated Ampere supply under your product, what price, volume, and reliability requirement would that conversation have to meet?\n",
          "2. If you would not, an explicit no is the useful answer.\n\n",
          "Thank you,\nBrian Searls\nFounder, Gunbai LLC\nbriansrls@gunb.ai",
        ], ""),
      }
    PrincipalHasNoEnquiry =>
      DraftRefused { why: "Hetzner CAX enquiry principal has no request id" }
  }
}

fn send_obligation_for(packet_decl: DeclarationRef, extra: List<DeclarationRef>) -> OperatorSendReadObligation {
  OperatorSendReadObligation {
    event: "the operator personally sends this draft; sessions do not send",
    must_read: concat([
      packet_decl,
      wholesale_argument_ref,
      offer_wholesale_ref,
      hetzner_row_ref,
      hetzner_cax_reply_ref,
    ], extra),
  }
}

fn unsent_outreach(
  identity: NonEmptyStr,
  seller_label: NonEmptyStr,
  catalog_module: String,
  catalog_decl: String,
  extra_prep: List<ActionReceipt>,
  support_context: NonEmptyStr,
) -> PacketOutreach {
  match wholesale_draft(seller_label: seller_label) {
    DraftReady { text } =>
      PreparedUnsent {
        unsent: UnsentOutreach {
          intervention: open_operator_intervention(
            identity: identity,
            subject: seller_label,
            instruction: text,
          ),
          preparation: concat([
            corpus_receipt(id: join([identity as String, "-plan"], ""), module_path: "strategy.year_end_plan", decl_name: "item_wholesale_supply_channel"),
            corpus_receipt(id: join([identity as String, "-hetzner"], ""), module_path: "strategy.node_rental", decl_name: "hetzner_row"),
            corpus_receipt(id: join([identity as String, "-catalog"], ""), module_path: catalog_module, decl_name: catalog_decl),
          ], extra_prep),
          support_context: support_context,
          asks: wholesale_prepared_asks,
        },
      }
    DraftRefused { why } => DraftBlocked { why: why }
  }
}

fn arm_shape_labels(availability: RunnerCatalogAvailability) -> List<NonEmptyStr> {
  map(
    filter(runner_shape_rows(availability: availability), r => shape_is_architecture(row: r, architecture: Aarch64)),
    r => r.label,
  )
}

fn host_standing_from_channel(
  channel: ArmCapacityChannel,
  catalog: DeclarationRef,
  channel_ref: DeclarationRef,
) -> HostStanding {
  match channel {
    CapacityChannelUnread => HostStandingUnstated { catalog: catalog }
    SellerOwnMetalStated => HostCited { channel: channel, authority: channel_ref }
    ResoldNamedCloud { vendor_words: _ } => HostCited { channel: channel, authority: channel_ref }
    CustomerAccountNamedCloud { vendor_words: _ } => HostCited { channel: channel, authority: channel_ref }
    CloudOperatorIsTheSeller { vendor_words: _ } => HostCited { channel: channel, authority: channel_ref }
    SoftwareOnCustomerHosts => HostCited { channel: channel, authority: channel_ref }
  }
}

fn packet(
  seller_id: NonEmptyStr,
  identity: DeclarationRef,
  catalog: DeclarationRef,
  list_price: ListPriceStanding,
  silicon: SiliconStanding,
  host: HostStanding,
  outreach: PacketOutreach,
  packet_decl: DeclarationRef,
  extra_must_read: List<DeclarationRef>,
) -> WholesaleSellerPacket {
  WholesaleSellerPacket {
    seller_id: seller_id,
    identity: identity,
    arm_shape_catalog: catalog,
    list_price: list_price,
    silicon: silicon,
    host: host,
    our_cost: packet_cost_for_catalog(catalog: catalog),
    wholesale_argument: wholesale_argument_ref,
    hetzner_row: hetzner_row_ref,
    hetzner_listed: hetzner_listed_ref,
    hetzner_cax_reply: hetzner_cax_reply_ref,
    outreach: outreach,
    send_read_obligation: send_obligation_for(packet_decl: packet_decl, extra: extra_must_read),
  }
}

