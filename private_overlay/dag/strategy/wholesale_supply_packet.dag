fn list_price_from_inquiry(i: WholesaleInquiry, catalog: DeclarationRef) -> ListPriceStanding {
  match i.end_customer_price {
    EndCustomerMinuteRate { micro_per_minute, currency, product, citation, price_authority, not_wholesale_reason } =>
      ListPriceCited { price_authority: price_authority }
    EndCustomerRateUnquoted { obligation } => ListPriceUnstated { catalog: catalog }
    WholesaleTermQuoted { micro_per_month, term_months, currency, source } =>
      ListPriceUnstated { catalog: catalog }
    WholesaleTermUnquoted { obligation } => ListPriceUnstated { catalog: catalog }
  }
}

fn packet_unsent_while_term_unquoted(o: PacketOutreach, i: WholesaleInquiry) -> Bool {
  !facing_is_wholesale_term(p: i.what_they_would_pay_us)
    && packet_outreach_is_prepared(o: o)
}

