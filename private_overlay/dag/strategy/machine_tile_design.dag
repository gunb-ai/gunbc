  note: "The direct answer to hide the supply, and it costs almost no new dependency: the same supply, the same three internal runs, the same boundary, moved 150 mm backwards. The cleat band must grow from 25 mm to about 126 mm to clear the supply body plus intake and service allowance, which makes this the DEEPEST total assembly of the three. Clean front face, furniture-depth object.",
}

data scenario_c_rear_liquid: MachineTileScenario = MachineTileScenario {
  id: "altra-rear-psu-liquid",
  label: "C - supply behind the carrier, cold plates",
  external_connectors: [AcPowerInlet, DataEthernet, BmcEthernet, CoolantSupply, CoolantReturn],
  board: AsrockAltrad8udSingleSocket,
  power_placement: TileRearAttached,
  rear_standing: RearAttachedToTile,
  cooling: ColdPlateLiquid,
  active_data_ports: 1,
  tile_count: 6,
  wall_to_backboard_face_mm: 45,
  rear_service_depth_mm: 126,
  carrier_thickness_mm: 18,
  tile_plane_to_front_tip_mm: 38,
  psu_fans_on_tile: 1,
  cooler_fans_on_tile: 0,
  auxiliary_fans_on_tile: 1,
  mass_estimate_dg: 750,
  note: "Electrical routing identical to B; fluid adds a supply and return pair on manual non-drip couplings, an internal split to the plate, and leak observation. Front projection collapses to the cold plate - and the total barely moves, because the rear depth is unchanged. This is the finding the single old depth number was hiding.",
}

data invariant_selection_note: String = "COLLAPSE 2026-08-11: DesignSelection carried mount_base, mount_interface, tile_shape and bench_rest, and every row set them identically. A field that does not vary across the population is not a scenario field - it is a design fact, and duplicating it three times invited exactly the divergence the collapse exists to end. They are module-level below; only what actually varies by preset lives on a scenario."

data selected_mount_base: MountBase = FreestandingBackboard

data selected_mount_interface: MountInterface = CleatWithLowerLocators

data selected_tile_shape: TileShape = AsymmetricLiveEdge

data selected_bench_rest: BenchRest = SeparateHiddenFeet

data selected_cleat_affordances: List<CleatAffordance> = [
  SeatedReveal,
  LeadInChamfer,
  WitnessMark,
  LowerLocatorPin,
  BottomBumper,
]

data selected_tile_edges: List<TileEdge> = [
    TileEdge {
      name: "top",
      treatment: StraightDatum,
      note: "Cleat datum. Machine-straight; carries the 45-degree rip on its back face and the seated-reveal shadow line on its front.",
    },
    TileEdge {
      name: "bottom",
      treatment: StraightDatum,
      note: "Service datum. Machine-straight; carries the locator counterbores, the rubber bumpers, and the drop point for both cords.",
    },
    TileEdge {
      name: "left",
      treatment: GripCut,
      note: "Square vertical edge with a 32 mm deep, 110 mm tall incut hand grip centred 180 mm above the service datum.",
    },
    TileEdge {
      name: "right",
      treatment: LiveEdgeGripCut,
      note: "The one expressive edge - waney, sanded, oiled, no two tiles alike. Its grip cut is placed where the natural line already bulges inward, so the irregularity reads as the reason for the grip rather than as an error.",
    },
]

data scenarios: List<MachineTileScenario> = [
  scenario_a_face_air,
  scenario_b_rear_air,
  scenario_c_rear_liquid,
]

data selected_scenario_id: String = "altra-face-psu-air"

data deferred_study_note: String = "The shared 48 V rectifier study is DEMOTED out of the preset set on operator direction, and the review's reason is right: it should not compete with the first build merely because it already has a drawing. The types, the voltage-drop arithmetic and contract_c_48v_air survive as Study S. Its one genuine claim over presets A to C is now sharper rather than weaker - it is the ONLY path to a thin wall assembly, because it is the only one that removes the supply from the carrier entirely."

data backboard_thickness_mm: Nat = 18

data backboard_thickness_note: String = "NAMED 2026-08-11 after review. This 18 mm was previously a bare literal inside the projection sum AND again inside the page renderer, so a physically meaningful thickness lived in two places, in neither of which it could be found by searching for a backboard. A number that describes matter is a model fact; only page margins may be literals."

fn scenario_total_wall_projection_mm(s: MachineTileScenario) -> Nat {
  s.wall_to_backboard_face_mm + backboard_thickness_mm + s.rear_service_depth_mm + s.carrier_thickness_mm + s.tile_plane_to_front_tip_mm
}

type ScenarioSelection
  = ScenarioSelected { scenario: MachineTileScenario }
  | ScenarioSelectionMissing { id: String }
  | ScenarioSelectionAmbiguous { id: String, matches: Nat }

data scenario_selection_note: String = "Selection is a zero/one/many RESULT, not a string comparison. The previous form asked each row whether its id equalled selected_scenario_id, so a typo rendered a page with no selected badge and a duplicated id rendered several - both silently, and both looking like a design with no selection rather than a broken carrier. A page that cannot say which configuration it is showing has no business rendering."

fn resolve_selected_scenario() -> ScenarioSelection {
  let matches = filter(scenarios, s => s.id == selected_scenario_id)
  let found = count(matches)
  if found == 1 {
    fold(matches, init: ScenarioSelectionMissing { id: selected_scenario_id },
         f: fn(acc, s) { ScenarioSelected { scenario: s } })
  } else {
    if found == 0 {
      ScenarioSelectionMissing { id: selected_scenario_id }
    } else {
      ScenarioSelectionAmbiguous { id: selected_scenario_id, matches: found }
    }
  }
}

fn scenario_selection_resolves() -> Bool {
  match resolve_selected_scenario() {
    ScenarioSelected { scenario } => true,
    ScenarioSelectionMissing { id } => false,
    ScenarioSelectionAmbiguous { id, matches } => false,
  }
}

fn scenario_fans_on_tile(s: MachineTileScenario) -> Nat {
  s.psu_fans_on_tile + s.cooler_fans_on_tile + s.auxiliary_fans_on_tile
}

fn scenario_fluid_crossings(s: MachineTileScenario) -> Nat {
  match s.cooling {
    DualAirTower => 0,
    ColdPlateLiquid => 2,
  }
}

fn scenario_rear_standing_crossings(s: MachineTileScenario) -> Nat {
  match s.rear_standing {
    RearAttachedToTile => 1,
    RearFixedToSupport => 3,
  }
}

data rear_standing_replaces_mains_note: String = "CORRECTED 2026-08-11, caught by witness_rejected_rear_fixed_fork_stays_measurable going RED on its first execution. The first form ADDED three crossings to the mains connection, giving a rear-fixed supply six. That is wrong on the physics: when the supply sits on the support rather than the carrier, the tile does not receive mains AT ALL - it receives 24-pin and two EPS instead. The power crossings REPLACE each other, they do not accumulate. Derived said six while the declared connector list said five, and the disagreement is exactly what this witness class exists to surface. The error was mine and the machinery found it before the page did."

data rear_fixed_crossing_note: String = "This is where the rejected remote-supply fork stays MEASURABLE without a second configuration vocabulary to hold it. A supply fixed to the support rather than the carrier puts the 24-pin and both EPS across the service boundary, so it adds three crossings to the one mains connection - reaching five with a single data port, exactly what the deleted contract_b_variant row asserted by hand. The fork is now a consequence of a standing rather than a parallel object."

fn scenario_power_crossings(s: MachineTileScenario) -> Nat {
  match s.power_placement {
    TileFace => 1,
    TileRearAttached => scenario_rear_standing_crossings(s: s),
    SharedRectifierStudy => 1,
  }
}

fn scenario_declared_connector_count(s: MachineTileScenario) -> Int {
  count(filter(s.external_connectors, c => connector_is_external_to_tile(c: c)))
}

fn scenario_boundary_crossings(s: MachineTileScenario) -> Nat {
  scenario_power_crossings(s: s) + s.active_data_ports + 1 + scenario_fluid_crossings(s: s)
}

fn scenario_by_id(id: String) -> Nat {
  count(filter(scenarios, s => s.id == id))
}

data crossing_derivation_note: String = "Crossings are DERIVED, never stored: one power connection, plus however many data ports are active, plus one management port, plus two fluid couplings when the scenario is liquid. Preset A at one active data port gives three, which is the ritual the concept was sold on. The same preset at two active ports gives four, and it should - the second 10 GbE port is real. Preset C gives five at one port and six at two. RearFixedToSupport is deliberately NOT reachable from these presets: it would add the 24-pin and both EPS to this sum, which is why it is a separate refused standing rather than a variation of B."


// THE SELECTED PART, imported rather than described.
//
// This carrier previously hand-authored HoldShapeStanding and HoldUseStanding: two coproducts
// restating, in prose, facts that belong to the part. That arrangement was a second authority for
// the hold, and it is exactly how the original defect happened — with no external row to consult,
// the carrier reasoned about the hold from its own description of it and concluded the part had no
// datum. A part cannot supply a frame to a module that only has an opinion about the part.
//
// extdeps.climbing_holds.atomik now owns identity, material, fixation interface, source readings
// and shape evidence. This module owns role, pose, and relation to the tile, and DERIVES every
// standing below from the imported row. The derivation direction matters: when the extdeps row
// gains a thread, the corresponding obligation here disappears on its own. Nothing has to be
// remembered, and the two cannot drift.
data selected_hold: ClimbingHoldCatalogRow = atomik_xl_arrow_down_climb_jug

fn selected_hold_may_render_silhouette() -> Bool {
  match selected_hold.shape {
    ShapeArtifactHeld { format: _, artifact_hash: _, units_note: _, frame_alignment_note: _ } => true,
    ShapeArtifactAbsent { obligation: _ } => false,
  }
}

// Proof load stays a CARRIER fact, and is the one standing not derived from the row. No catalog
// can settle it: a vendor's climbing-wall standing is evidence about a different load direction,
// cycle count, panel stock, edge distance and failure consequence. The tile's use has to earn its
// own receipt against the exact assembly, and no fixture has been built.
data lift_proof_load_receipt_held: Bool = false

// PLACEMENT CLEARANCE, which this carrier cannot supply and must not fake. The renamed
// hold_catalog_clearance_envelope_is_spendable was still being consumed here after it was pulled
// out of the extdeps lift gate -- the same lie, one module further downstream, and it survived the
// rename because renaming a function does not find its callers. The private consumer is where it
// was finally caught, which is the argument for a consumer sitting close to its authority.
//
// A resolved layout is the only thing that can answer this, and there is no resolved layout: the
// hold clearance envelopes intersect the board, the cooler and, in preset A, the power supply.
// So the standing is Unresolved and it names what would close it.
type ScenePlacementStanding
  = ScenePlacementResolved { scene_id: String, receipt: String }
  | ScenePlacementUnresolved { obligations: List<String> }
  | ScenePlacementRefused { conflicts: List<String> }

data selected_scene_placement: ScenePlacementStanding = ScenePlacementUnresolved {
  obligations: [
    "Resolve a physical scene with conservative placed bodies for carrier, board, cooler, PSU, saddle, cleat and both hold clearance volumes.",
    "Declare relation policy: cooler-processor AllowedContact, bolt-panel FastenerPenetrates, hold-board / hold-cooler / hold-PSU RequiredDisjointness.",
    "Known conflicts that any resolution must confront: left hold clearance intersects board and cooler; right hold clearance intersects the power supply in preset A.",
    "No free region on the current 640 mm face admits a 166 x 191 mm hold, so the resolution must change the layout or the hold, not the coordinates.",
  ],
}

fn scene_placement_is_resolved() -> Bool {
  match selected_scene_placement {
    ScenePlacementResolved { scene_id: _, receipt: _ } => true,
    ScenePlacementUnresolved { obligations: _ } => false,
    ScenePlacementRefused { conflicts: _ } => false,
  }
}

fn hold_is_qualified_for_lift() -> Bool {
  lift_proof_load_receipt_held
    && hold_local_frame_is_ready(row: selected_hold)
    && scene_placement_is_resolved()
}

// The typed incomplete result. Each arm names a document or an act that closes it, and each is
// DERIVED from the imported row rather than listed by hand — so this list shortens only when a
// real fact lands in extdeps, never because someone edited a note here.
type MachineTileGripObligation
  = SelectedHardwareThread
  | MountingFaceConfirmation
  | ExactShapeArtifact
  | HoldMaterialStatement
  | ManufacturerSkuCode
  | LiftProofLoadReceipt

fn grip_obligation_thread() -> List<MachineTileGripObligation> {
  match selected_hold.fixation.primary_bolt_thread {
    ImperialUncThread { designation: _ } => [],
    MetricCoarseThread { designation: _ } => [],
    FastenerThreadUnread { obligation: _ } => [SelectedHardwareThread],
  }
}

fn grip_obligation_face() -> List<MachineTileGripObligation> {
  match selected_hold.fixation.mounting_face {
    SingleFlatMountingFace => [],
    ContouredMountingFace { obligation: _ } => [MountingFaceConfirmation],
    HoldMountingFaceUnread { obligation: _ } => [MountingFaceConfirmation],
  }
}

fn grip_obligation_shape() -> List<MachineTileGripObligation> {
  if selected_hold_may_render_silhouette() { [] } else { [ExactShapeArtifact] }
}

fn grip_obligation_material() -> List<MachineTileGripObligation> {
  match selected_hold.material {
    HoldMaterialUnread { obligation: _ } => [HoldMaterialStatement],
    PolyurethaneResin => [],
    PolyesterResin => [],
    Fiberglass => [],
    MachinedRockComposite => [],
    Plywood => [],
    Hardwood => [],
  }
}

fn grip_obligation_sku() -> List<MachineTileGripObligation> {
  match selected_hold.naming.manufacturer_sku {
    ProductSkuObserved { value: _, authority: _ } => [],
    ProductSkuUnread { obligation: _ } => [ManufacturerSkuCode],
  }
}

fn grip_obligation_proof_load() -> List<MachineTileGripObligation> {
  if lift_proof_load_receipt_held { [] } else { [LiftProofLoadReceipt] }
}

fn machine_tile_grip_obligations() -> List<MachineTileGripObligation> {
  grip_obligation_thread()
    .concat(grip_obligation_face())
    .concat(grip_obligation_shape())
    .concat(grip_obligation_material())
    .concat(grip_obligation_sku())
    .concat(grip_obligation_proof_load())
}

type MachineTileGripIntegration
  = MachineTileGripIncomplete { missing: List<MachineTileGripObligation> }
  | MachineTileGripReady { receipt: String }

// A useful first result is NOT Ready, and saying so is the point. The previous carrier had no
// integration result at all: the hold was either drawn as a square or deleted, and both readings
// looked finished. An explicit Incomplete carrying its own reasons is a better artifact than
// either, because it is the only one of the three that can be closed.
fn machine_tile_grip_integration() -> MachineTileGripIntegration {
  let missing = machine_tile_grip_obligations()
  if count(missing) == 0 {
    MachineTileGripReady { receipt: "every grip obligation closed" }
  } else {
    MachineTileGripIncomplete { missing: missing }
  }
}

fn machine_tile_grip_obligation_count() -> Int {
  count(machine_tile_grip_obligations())
}
