  power_placement: TileFace,
  rear_standing: RearAttachedToTile,
  cooling: DualAirTower,
  active_data_ports: 1,
  tile_count: 6,
  wall_to_backboard_face_mm: 45,
  rear_service_depth_mm: 25,
  carrier_thickness_mm: 18,
  tile_plane_to_front_tip_mm: 138,
  psu_fans_on_tile: 1,
  cooler_fans_on_tile: 2,
  auxiliary_fans_on_tile: 0,
  mass_estimate_dg: 800,
  note: "SELECTED. Rear depth is the 25 mm cleat band only. Front projection is the NH-D9 tower plus standoff. The supply is visible and the object reads as deliberate mechanism; it is also the only preset where a tile is a complete standalone machine that runs on any socket at a bench.",
}

data scenario_b_rear_air: MachineTileScenario = MachineTileScenario {
  id: "altra-rear-psu-air",
  label: "B - supply behind the carrier, air",
  external_connectors: [AcPowerInlet, DataEthernet, BmcEthernet],
  board: AsrockAltrad8udSingleSocket,
  power_placement: TileRearAttached,
  rear_standing: RearAttachedToTile,
  cooling: DualAirTower,
  active_data_ports: 1,
  tile_count: 6,
  wall_to_backboard_face_mm: 45,
  rear_service_depth_mm: 126,
  carrier_thickness_mm: 18,
  tile_plane_to_front_tip_mm: 138,
  psu_fans_on_tile: 1,
  cooler_fans_on_tile: 2,
  auxiliary_fans_on_tile: 0,
