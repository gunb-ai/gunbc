    id: "run-mains",
    from: TilePsuMainsInlet,
    to: PlinthBranchReceptacle,
    conductor: MainsAc,
    crosses_tile_boundary: true,
    routed_in_saddle: false,
    length_mm: 1800,
    note: "The only mains on the tile, and it exists only inside the supply's own sealed enclosure and this cord. Standard C13 to a plinth receptacle; the cord drops straight down the face of the backboard.",
  },
  CableRun {
    id: "run-data",
    from: BoardIoDataPort,
    to: PlinthSwitchPort,
    conductor: TwistedPairData,
    crosses_tile_boundary: true,
    routed_in_saddle: false,
    length_mm: 2000,
    note: "One of the board's two onboard 10 GbE ports, plugged directly into the board's own I/O edge - which faces down, so the cord drops without crossing a grip.",
  },
  CableRun {
    id: "run-bmc",
    from: BoardIoBmcPort,
    to: PlinthSwitchPort,
    conductor: TwistedPairData,
    crosses_tile_boundary: true,
    routed_in_saddle: false,
    length_mm: 2000,
    note: "Dedicated BMC port. Separate from data on purpose: the reason a tile can be power-cycled and reinstalled without anyone walking to the wall.",
  },
]

data rev_a_power_budget: PowerBudget = PowerBudget {
  board_count: 6,
  per_board_budget_w: 350,
  total_budget_w: 2100,
  planning_ceiling_w: 2625,
  per_tile_peak_w: 350,
  per_tile_psu_rated_w: 650,
  note: "650 W, 80 PLUS Gold or better, fully modular, standard ATX form factor. Fully modular is a requirement and not a preference here: the saddle carries exactly three cables because the unused ones were never attached. Expected wall draw for six tiles in ordinary service is 1.6 to 1.9 kW, against a 2.1 kW budget and a 2.6 kW planning ceiling.",
}

data branch_circuits: List<BranchCircuit> = [
  BranchCircuit { id: "circ-a", volts: 120, amps: 20, tiles_served: 3 },
  BranchCircuit { id: "circ-b", volts: 120, amps: 20, tiles_served: 3 },
]

data branch_circuit_note: String = "Two 120 V 20 A circuits, three tiles each. Each gives 2400 VA nameplate and 1920 W continuous at the 80 percent rule, against 1050 W of budgeted tiles - so a circuit carries its three tiles with a whole tile of margin, and losing one circuit costs half the wall rather than all of it. One 240 V 20 A circuit would also cover the ceiling on paper and is refused: it puts all six tiles behind one breaker."

fn continuous_capacity_w(c: BranchCircuit) -> Nat {
  c.volts * c.amps * 8 / 10
}

fn total_continuous_capacity_w() -> Nat {
  fold(branch_circuits, init: 0, f: fn(acc, c) { acc + continuous_capacity_w(c: c) })
}

fn total_tiles_served() -> Nat {
  fold(branch_circuits, init: 0, f: fn(acc, c) { acc + c.tiles_served })
}

fn connector_is_external_to_tile(c: ExternalConnector) -> Bool {
  match c {
    AcPowerInlet => true,
    DataEthernet => true,
    BmcEthernet => true,
    Atx24Pin => true,
    Eps8PinA => true,
    Eps8PinB => true,
    FrontPanelHeader => true,
    DcInput48V => true,
    CoolantSupply => true,
    CoolantReturn => true,
  }
}

// DC RUN POPULATION, withdrawn and replaced by a standing.
//
// This carrier authored three on-tile DC runs -- run-atx24, run-eps-a, run-eps-b -- from the
// reading that the ALTRAD8UD-1L2T carries one 24-pin main and two 8-pin EPS12V inputs. That
// reading is FALSE. The board exposes three 8-pin ATX12V inputs plus a 4-pin Micro-Fit signal
// connector; there is no 24-pin socket on it, and ATX-supply operation goes through a bundled
// 24-pin-to-4-pin converter. run-eps-a's note went further and asserted a design decision on top
// of the falsehood -- "the ALTRAD8UD carries two, and both are populated" -- which was reasoning
// from an inventory that does not exist.
//
// The correction cannot simply renumber the runs. HOW MANY of the three 8-pin inputs must be
// populated for a given processor and workload is UNRESOLVED in the public authority, and drawing
// a specific number here would repeat the original mistake exactly: a plausible count rendered as
// a fact. So the DC population is a standing, not a list, and it refuses until extdeps closes it.
//
// The count is load-bearing downstream: boundary_crossing_run_count and on_tile_dc_run_count feed
// the interface-contract witness, so a withdrawn inventory reaches the connector arithmetic and
// not merely the prose.
type DcRunPopulationStanding
  = DcRunPopulationResolved { run_count: Int, receipt: String }
  | DcRunPopulationUnresolved { obligation: String, available_inputs: Int }

fn selected_dc_run_population() -> DcRunPopulationStanding {
  match asrock_altrad8ud_required_input_population {
    PowerInputPopulationSpecified { required_inputs } =>
      DcRunPopulationResolved {
        run_count: required_inputs,
        receipt: "derived from extdeps.boards.gigabyte required-input population",
      },
    PowerInputPopulationUnresolved { available_inputs } =>
      DcRunPopulationUnresolved {
        obligation: "Read the vendor statement or measure a fixture: how many of the board's three 8-pin ATX12V inputs must be populated for an Altra Max M128-30 under all-core load. Until then no on-tile DC harness may be drawn or counted.",
        available_inputs: available_inputs,
      },
  }
}

fn dc_run_population_is_resolved() -> Bool {
  match selected_dc_run_population() {
    DcRunPopulationResolved { run_count: _, receipt: _ } => true,
    DcRunPopulationUnresolved { obligation: _, available_inputs: _ } => false,
  }
}

data dc_population_withdrawal_note: String = "The three authored on-tile DC runs are withdrawn. Their replacement is a derived standing that is currently Unresolved, so the on-tile harness has no count. The board's 4-pin Micro-Fit signal connector and its bundled 24-pin-to-4-pin converter are part of the same unread interface and are not modelled as runs either."

fn boundary_crossing_run_count() -> Int {
  count(filter(cable_runs, r => r.crosses_tile_boundary))
}

fn on_tile_dc_run_count() -> Int {
  count(filter(cable_runs, r => r.routed_in_saddle))
}

fn grip_is_lift_load(g: Grip) -> Bool {
  match g.role {
    LiftLoad => true,
    ColourIdentification => false,
  }
}

fn grip_is_integrated(g: Grip) -> Bool {
  match g.realization {
    IntegratedEdgeGrip => true,
    BoltedResinHold => false,
    BoltedWoodenHold => false,
  }
}

fn edge_is_straight_datum(e: TileEdge) -> Bool {
  match e.treatment {
    StraightDatum => true,
    GripCut => false,
    LiveEdgeGripCut => false,
  }
}

fn edge_is_live(e: TileEdge) -> Bool {
  match e.treatment {
    StraightDatum => false,
    GripCut => false,
    LiveEdgeGripCut => true,
  }
}

fn edge_carries_grip(e: TileEdge) -> Bool {
  match e.treatment {
    StraightDatum => false,
    GripCut => true,
    LiveEdgeGripCut => true,
  }
}

fn affordance_matches(a: CleatAffordance, b: CleatAffordance) -> Bool {
  match a {
    SeatedReveal => match b { SeatedReveal => true, LeadInChamfer => false, WitnessMark => false, LowerLocatorPin => false, BottomBumper => false },
    LeadInChamfer => match b { SeatedReveal => false, LeadInChamfer => true, WitnessMark => false, LowerLocatorPin => false, BottomBumper => false },
    WitnessMark => match b { SeatedReveal => false, LeadInChamfer => false, WitnessMark => true, LowerLocatorPin => false, BottomBumper => false },
    LowerLocatorPin => match b { SeatedReveal => false, LeadInChamfer => false, WitnessMark => false, LowerLocatorPin => true, BottomBumper => false },
    BottomBumper => match b { SeatedReveal => false, LeadInChamfer => false, WitnessMark => false, LowerLocatorPin => false, BottomBumper => true },
  }
}

fn selection_carries_affordance(a: CleatAffordance) -> Bool {
  any(selected_cleat_affordances, x => affordance_matches(a: x, b: a))
}

fn datum_offset(id: String) -> Nat {
  fold(datum_chain, init: 0, f: fn(acc, d) { if d.id == id { acc + d.offset_mm } else { acc } })
}

fn datum_declared(id: String) -> Bool {
  count(filter(datum_chain, d => d.id == id)) == 1
}

fn grip_to_board_web_mm() -> Nat {
  datum_offset(id: "d-board-left") - datum_offset(id: "d-grip-depth")
}

data required_cleat_affordances: List<CleatAffordance> = [
  SeatedReveal,
  LeadInChamfer,
  WitnessMark,
  LowerLocatorPin,
  BottomBumper,
]

data witness_obligations_note: String = "Seven obligations, discharged in test.claim.machine_tile_design_witness. They are chosen so that each of the six reviewed defects has a claim that would have gone red on the reviewed document, plus one for the root cause itself. What they do NOT check, stated so it is not mistaken for coverage: no claim here observes a real tile, a real weight, a real temperature, or a real purchased supply. Every one is a check that the DESIGN is self-consistent - which is precisely the failure the review found, and precisely the failure a drawing cannot catch on its own."


data power_reconsideration_note: String = "OPERATOR DIRECTION 2026-08-11: the supply on the tile is refused on appearance - a wall of machines should not read as a wall of power supplies - with the proposal to run ONE large supply, ONE line to each board, and generate the standard board interface locally. That proposal defeats my own retraction of Contract B and I record the concession rather than defending the earlier ruling: what I objected to was never SUPPLY OFF THE TILE as a category, it was ATX AND EPS OVER DISTANCE - a custom-length harness carrying tens of amps at 12 V across a wall. Distributing at a higher voltage on one small cable and converting at the board removes that objection entirely, because the objection was about conductor size and connector energy, not about where the rectifier sits. I generalised from a real defect to a category and that was wrong."

type DistributionVoltage
  = DistributionMainsAc
  | Distribution12V
  | Distribution48V

data distribution_voltage_note: String = "The choice is settled by conductor size, and it is not close. Per tile at the 350 W budget: 7.3 A at 48 V, 29.2 A at 12 V. Over a 5 m run (10 m of conductor) in 14 AWG the drop is about 0.6 V at 48 V - 13 parts per thousand, invisible - and about 2.4 V at 12 V, 201 parts per thousand, which is not a cable but a failure. Holding 12 V under 3 percent over that distance needs roughly 4 AWG per tile: a battery cable, six of them, terminated by hand. THAT is the custom harness the Contract B retraction was actually about. At 48 V the same job is ordinary two-core flex."

type BulkSupplyPlacement
  = OnTile
  | ServicePlinth
  | BackRoom

data bulk_supply_placement_note: String = "BackRoom is the placement the operator direction is really asking for, and it buys more than tidiness. Six consumer supplies mean six fans in the occupied room; one rectifier shelf means two or three fans behind a wall, and rectifier fans are the loud kind, so moving them is worth more than silencing them would be. The floor plan already has a back room directly behind Wall A. ServicePlinth is the fallback where no back room exists. OnTile is Rev A, retained as the comparison baseline and as the honest answer when a single tile has to work standalone on a bench."

type PerTileConversion
  = NoConversion
  | NativeBoard12VInput
  | Dc48ToDc12Brick
  | Dc48ToAtxModule

data per_tile_conversion_note: String = "Two candidate paths and one open fact between them. If the ALTRAD8UD-1L2T's native 12 V DC input is real and sufficient (SEED DEBT 3 - vendor page reading, pin-verification not done), the tile carries one 48-to-12 V brick and NOTHING else: no ATX interface is synthesised because the board never wanted one. If it is not, the tile carries a DC-ATX module producing the board's own 12 V input population locally, which is exactly the operator's phrasing - give each board the standard interface FROM THERE. The exact connector set that module must present is unresolved for the same reason the on-tile harness is: extdeps has not established how many of the board's three 8-pin inputs must be populated. The first is strictly simpler; the second is the fallback that still works. Deciding between them is one datasheet read, and it is the single highest-value verification in this design. SOURCING RISK, stated not buried: an isolated 48-to-12 V converter at 350 W is a standard telecom quarter-brick class and I expect it to be commodity, but no part number, price, or footprint here is quoted from a real listing, and my last attempt to price a converter in this session was an overclaim that had to be withdrawn. Treat every converter figure as a market-search hypothesis until a quote lands."

type CoolingRealization
  = AirTowerCooler
  | AirBlowerCooler
  | LiquidColdPlateLoop

type FluidConnection
  = PermanentFitting
  | ManualQuickDisconnect
  | BlindMateCoupling

data cooling_realization_note: String = "OPERATOR DIRECTION 2026-08-11: LGA4926 water blocks exist (Alphacool), so liquid is admitted as a candidate on cost and safety grounds. What liquid earns here, stated as it was established earlier in this work: it is NOT a noise argument - an open tower cooler at 700 rpm is already quiet - it is a HEAT ROUTING argument. 2.1 kW landing in a 750 sf office is a load the mini-split has to remove; a loop can take it out of the building to a dry cooler, or into space heat in winter. The tile-level effects are large and separate: the block is roughly 30 mm tall against the NH-D9 tower's 130 mm, so tile depth off the backboard falls from about 140 mm to about 50 mm, and with the supply also gone the tile carries ZERO fans. ManualQuickDisconnect is the part that makes liquid compatible with a tile on a cleat at all - without non-drip couplings a tile cannot leave the wall in five steps. BlindMateCoupling on the cleat is the tempting version and is REFUSED for now: seating misalignment on a blind fluid coupling is a leak over a live board, which is a custom dependency whose failure mode is the worst one available."

data liquid_dependency_note: String = "The dependency population liquid creates, inventoried rather than waved at, because this is exactly the no-unearned-relationship test. It adds: cold plates, tubing, two couplings per tile, a manifold, a pump, a reservoir, coolant with a biocide schedule, a heat rejection device, leak detection, an annual service interval, and a pump failure mode that takes ALL boards on the loop at once rather than one. Pump redundancy is therefore not optional - two pumps in parallel is the standard answer and is assumed here. Against that it removes: twelve cooler fans, 90 mm of tile depth, and the whole question of how to get 2.1 kW out of an occupied room. The operator condition - safely and cheaply - is the right test, and it is not yet met by evidence: no quote exists for couplings, which are the expensive part, and no leak-containment design has been drawn."

data tile_envelope_supersession_note: String = "DELETED 2026-08-11, and the deletion is the point. This module previously carried a TileEnvelope row list asserting fans_on_tile 0 and depth_off_backboard_mm 50 for the liquid candidate, together with envelope_fans and envelope_depth_mm readers and a GREEN witness pinning both numbers. It also carried zero_fan_claim_retraction_note and depth_envelope_note retracting exactly those two claims. Both were true of the module at once: a witness asserting a number and a note retracting it, shipped in the same commit. That is the third instance of the defect class this carrier exists to prevent - an authority split surviving because the two halves were different KINDS of statement and nothing forced them to meet. A retraction that leaves its witness standing is not a retraction. The scenario layer is now the sole authority for fans and depth: scenario_fans_on_tile sums the three fan roles a scenario actually declares, and scenario_total_wall_projection_mm derives from the four depth quantities rather than from one stored number."



data per_board_budget_mw: Nat = 350000

fn per_tile_current_ma(watts_mw: Nat, volts: Nat) -> Nat {
  watts_mw / volts
}

data conductor_14awg_micro_ohm_per_m: Nat = 8286

data run_length_conductor_m: Nat = 10

fn line_drop_mv(watts_mw: Nat, volts: Nat) -> Nat {
  per_tile_current_ma(watts_mw: watts_mw, volts: volts) * conductor_14awg_micro_ohm_per_m * run_length_conductor_m / 1000000
}

fn line_drop_per_mille(watts_mw: Nat, volts: Nat) -> Nat {
  line_drop_mv(watts_mw: watts_mw, volts: volts) * 1000 / (volts * 1000)
}

data architecture_comparison_note: String = "RECOMMENDATION, with the condition attached rather than buried. Candidate C is the right answer to the operator direction and I would select it the moment ONE fact lands: whether the board's native 12 V input is real. It hides the supply, keeps the removal ritual at three connectors, shrinks the tile by 150 mm of width and 1.7 kg, and moves the loudest fans out of the room - and it does NOT save money or watts, which should be said plainly. Two conversion stages at roughly 94 percent each land near 88 percent against a single Gold supply's roughly 90 percent at half load, so efficiency is a wash or slightly worse, and a rectifier shelf plus six converters plausibly costs more than six consumer supplies. Candidate D is the version worth wanting and the one that stops the wall reading as equipment at all - zero fans, 50 mm deep - but it is the one whose dependency ledger is unpaid: no coupling quote, no leak-containment design, and a pump whose failure takes every board on the loop. Rev A stays SELECTED until those verifications land, because selecting on hypothesis-grade part availability is the exact error this carrier exists to prevent."


data scenario_recut_note: String = "RECUT 2026-08-11 after a routed review, operator-approved. The review's structural finding is accepted and it is the same defect class this carrier was created to kill: one hard-coded rev_a_selection with alternatives appended as static prose is EXACTLY the shape that let the original document claim three connectors while drawing five. The instance was patched and the class reproduced. From here one selected_scenario drives every derived physical quantity, and a configuration-sensitive number that is not derived from a scenario is a defect. SCOPE HELD, against the review's proposal: the resolver derives PHYSICAL quantities only. The review asked it to also derive BOM, capital cost, monthly operating model and utilisation break-even; that is the site and business layer, which machine_tile_design_note already disclaims and which strategy.site_model owns, and folding CI pricing into a tile-geometry carrier is the one-generic-node failure the strategy kernel directive exists to prevent. This carrier emits physical facts and a capacity shape; the business carrier consumes them."

type BoardProfile
  = AsrockAltrad8udSingleSocket
  | GigabyteMp72Hb0DualSocket

data board_profile_note: String = "AsrockAltrad8udSingleSocket is SELECTED: 244 x 267 mm, one LGA4926, 8 DIMMs, two 10 GbE plus BMC, a power interface this carrier no longer restates because extdeps.boards.gigabyte owns it and an earlier restatement here was false - and, decisively, hardware the operator already owns alongside two NH-D9 AMP-4926 coolers. GigabyteMp72Hb0DualSocket is a CANDIDATE only. CORRECTION: this sentence claimed the specification was independently verified against the vendor page and resellers. It was not. Every outbound fetch is refused by egress policy, so the figures came from a routed review - a real source, and not a first-party read. The reading is: dual LGA4926, 250 W per processor, E-ATX 305 x 330 mm, 16 DIMMs to DDR4-3200, two 10 GbE, one 24-pin and two 8-pin ATX12V, M.2 plus SATA, four PCIe slots. Those facts hold. What does NOT hold is any claim to ownership, price, or condition: domestic quotes near USD 1445 with four-to-six week lead times were reported in the review and are not verified here, and no board has been held. The architectural attraction is real and should be stated without overselling it - three dual-socket tiles for six sockets removes three whole baseboard, supply, BMC, boot device and mounting boundaries, but board AREA falls only about 23 percent, CPU cooling is unchanged at six, DIMM count is unchanged at 48, and one tile failure takes a third of the fleet rather than a sixth."

data mp72_procurement_refusal_note: String = "PROCUREMENT STANDING, and a CORRECTION to the review that raised it. The review refused a marketplace listing on the ground that its photograph showed a proprietary MT JADE SYSTEM BOARD silkscreen rather than the documented Gigabyte part. The operator then supplied the listing and its image, and read directly the image does not support that: the silkscreen reads GIGABYTE MP72-HB0 DDR4 beside the regulatory marks, and the board shows two LGA4926 sockets with white retention frames, sixteen DIMM slots in four banks, four PCIe slots, two SlimSAS ports, one M.2 socket, and a rear panel carrying VGA, USB, two RJ45 and a management port - consistent with the vendor profile on every countable field. THE REFUSAL AS STATED DOES NOT HOLD, and it is recorded here because it was routed as a reason not to buy. The real caveat is duller and still binding: the image is a watermarked reseller stock photograph, so it establishes what the listing DEPICTS and never what a particular unit IS. Standing is ListingObserved, which is not enough to enter a fleet carrier. The full gate, landed-cost standing and vendor profile live in extdeps.boards.gigabyte, which this module now genuinely IMPORTS -- an earlier version of this sentence claimed consumption while the carrier had no import of that module at all, and then restated the connector inventory in the same breath. The connector counts have been removed from this note for the same reason: a carrier that says it restates nothing must not restate."

type PowerPlacement
  = TileFace
  | TileRearAttached
  | SharedRectifierStudy

type RearPowerStanding
  = RearAttachedToTile
  | RearFixedToSupport

data rear_power_standing_note: String = "There is no generic behind-the-board value, and the review is right that the phrase hides two incompatible designs. RearAttachedToTile: the supply is fixed to the carrier and leaves the wall with it, so the whole machine stays one removable object, all high-current DC stays internal, and the boundary is unchanged - this is preset B. RearFixedToSupport: the supply stays on the backboard, which recreates the remote-PSU interface already refused, puts 24-pin and both EPS across the service boundary, and must report those crossings honestly rather than inheriting B's count. Any row that fails to say which one it is is refused as RearPowerOwnershipAmbiguous."

type ScenarioCooling
  = DualAirTower
  | ColdPlateLiquid

type MemoryPopulation {
  dimm_count: Nat
  capacity_per_dimm_gib: Nat
  data_rate_mt_s: Nat
}

type MachineTileScenario {
  id: String
  label: String
  external_connectors: List<ExternalConnector>
  board: BoardProfile
  power_placement: PowerPlacement
  rear_standing: RearPowerStanding
  cooling: ScenarioCooling
  active_data_ports: Nat
  tile_count: Nat
  wall_to_backboard_face_mm: Nat
  rear_service_depth_mm: Nat
  carrier_thickness_mm: Nat
  tile_plane_to_front_tip_mm: Nat
  psu_fans_on_tile: Nat
  cooler_fans_on_tile: Nat
  auxiliary_fans_on_tile: Nat
  mass_estimate_dg: Nat
  note: String
}

data active_data_ports_note: String = "An INPUT, not a constant, and the review is right that this was a silent assumption. The baseboard carries two 10 GbE ports plus a dedicated management port. The three-connector removal ritual is true only when one data port is active; with both, an air-cooled tile crosses at four. Treating the second port as either always present or nonexistent are both misreports."

data depth_envelope_note: String = "DEFECT CORRECTED. The previous carrier held ONE depth_off_backboard_mm and the rendered page labelled it depth off the WALL - so 140 mm, which is tile-plane to cooler tip, was published as though it were the finished wall projection. It is not, and the difference is not small: adding the 45 mm service void, the 18 mm backboard, the cleat or rear-service band and the 18 mm carrier puts preset A near 244 mm. Four quantities are now carried separately and the total is derived, never stored. The consequence worth stating loudly, because the old number hid it: preset C is NOT a shallow wall. Cold plates take the front projection from about 138 mm to about 38 mm, but a rear-attached supply puts that depth straight back behind the carrier, so C lands within a few millimetres of A. Only removing the local supply entirely - the deferred shared-rectifier study - produces a genuinely thin assembly. Liquid alone does not buy the appearance it looks like it buys."

data zero_fan_claim_retraction_note: String = "RETRACTED: the previous carrier asserted fans_on_tile 0 for the liquid candidate. That was an overclaim on two counts. It silently assumed the supply had also left the tile, which is true only under the shared-rectifier study and not under preset C; and cold plates cool processors only - sixteen DIMM positions, the regulators, the network interfaces and the boot device still need moving air, and no thermal observation exists for a bare vertical board without any. Preset C therefore carries its supply fan plus one auxiliary low-speed fan, and that auxiliary count is a REQUIREMENT, not a measurement: the real number is unknown until a board is run."

data memory_8x32: MemoryPopulation = MemoryPopulation {
  dimm_count: 8,
  capacity_per_dimm_gib: 32,
  data_rate_mt_s: 3200,
}

