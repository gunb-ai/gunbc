// Public source access is not an OCP organizational relationship. The read can be served while
// its result remains TBD. Future organizational contact needs its own positive observation.
fn ocp_rank_cell_read() -> MtJadeMixedDimmSupportOutcome {
  mt_jade_mixed_dimm_support(placement: DifferentChannel, axis: Mixing1rAnd2r)
}

fn ocp_rank_cell_was_read(outcome: MtJadeMixedDimmSupportOutcome) -> Bool {
  match outcome {
    MixedDimmSupportResolved { cell: _ } => true,
    MixedDimmSupportUnmodelled { query: _ } => false,
    MixedDimmSupportAmbiguous { query: _ } => false,
  }
}

fn ocp_rank_question_answered(outcome: MtJadeMixedDimmSupportOutcome) -> Bool {
  match outcome {
    MixedDimmSupportResolved { cell: c } => match c.support {
      MixingUndetermined => false,
      MixingSupported => true,
      MixingNotSupported => true,
      MixingNotPreferred => true,
    },
    MixedDimmSupportUnmodelled { query: _ } => false,
    MixedDimmSupportAmbiguous { query: _ } => false,
  }
}

data excluded_consumers: List<ExcludedConsumer> = [
  ExcludedConsumer {
    consumer: "memory-bom-decision",
    relationship: relationship_ampere.subject,
    reason: "RAM purchase HELD. Only unit 1 arithmetic is established: 10 x 1R + 6 x 2R, requiring 22 purchases for all-1R or 26 for all-2R on that unit. No fleet multiplication or zero-purchase resort follows. Census identity, module axes, serial conservation, assignment feasibility and OCP Table 3 facts remain required.",
  },
]

// This action has no year-end plan identity. Completion records correspondence using #64's
// carrier, never changes the relationship standing. Unsent is not an external wait.
// THE PREPARATION TRAVELS WITH THE ENQUIRY. The receipts that routed the request -- the Customer
// Connect refusal that named sales as the NDA route, the earlier enquiry that went unanswered --
// are facts about why the enquiry took the channel it took, so they stay consumed on the sent and
// answered arms rather than dangling once the draft they prepared has been sent (DESIGN 3c). The
// counterparty's reference on the enquiry (request_id) is the receipt that it was sent; a second
// acknowledgment carrier would be one fact in two places.
// WHAT THE SENT TEXT CARRIED, ASK BY ASK. A draft prepares several asks and the text that goes
// out may carry some of them, reword others and drop the rest; reading the sent text as "the
// draft was sent" would let an unsent ask read as awaiting an answer. So each prepared ask carries
// its own standing: carried, or unsent with the reason it is still owed. "Carried" means carried
// by THIS outreach's enquiry -- the only enquiry the arm holds -- so the arm has no payload: a
// request id restated per ask would be the enquiry's request_id in a second place, and an ask
// "carried by some other ticket" would become writable only to be policed afterwards. An unsent
// ask is not folded into a live ticket by this row -- sending it is the operator's act.
// A THIRD STANDING, BECAUSE THE FACT EXISTS AND THE TWO ARMS COULD NOT HOLD IT (review 68148). The
// firmware-images ask was NOT carried by the 2026-09-12 enquiry this row holds, and it is no longer
// unsent either: the operator's 2026-09-15 reply on the same ticket carried it, and the images arrived.
// Tagging that AskCarried is the meaning-fork the paragraph above anticipated -- the tag would say
// "carried by this enquiry" while the prose beside it said "carried by a later message", making the
// string the authority for what the tag means and changing outreach_asks_coherent's answer on an arm
// that is load-bearing.
//
// THE OBJECTION TO A PAYLOAD IS ANSWERED RATHER THAN OVERRIDDEN. The paragraph refuses a per-ask
// request id because it would restate the enquiry's own id in a second place and let anyone write
// "carried by some other ticket" as unpoliced prose. This arm carries neither: its payload is the
// RECEIPT of the later sending -- a declaration that exists, is reachable by fold, and names its own
// recipient and date. It cannot be written for a sending the corpus has no receipt for, which is the
// exact property the refusal was protecting.
type PreparedAskStanding
  = AskCarried
  | AskCarriedByLaterEnquiry { carried_by: ActionReceipt }
  | AskUnsent { reason: NonEmptyStr }

type PreparedAsk {
  ask_id: NonEmptyStr
  ask: NonEmptyStr
  standing: PreparedAskStanding
}

// transcription is the receipt that `enquiry.asked` is the sender's own words rather than a
// paraphrase: who supplied the text, through what, on what date. It is a separate carrier from
// the enquiry because the enquiry records what the counterparty received and the transcription
// records how this corpus came to hold it.
type UnsentOutreach {
  intervention: HumanIntervention
  preparation: List<ActionReceipt>
  support_context: NonEmptyStr
  asks: List<PreparedAsk>
}

type RelationshipOutreach
  = RelationshipOutreachUnsent { unsent: UnsentOutreach }
  | RelationshipOutreachSent { enquiry: VendorEnquiry, preparation: List<ActionReceipt>, transcription: ActionReceipt, asks: List<PreparedAsk> }
  | RelationshipOutreachAnswered { enquiry: VendorEnquiry, reply: VendorReply, preparation: List<ActionReceipt>, transcription: ActionReceipt, asks: List<PreparedAsk> }

fn ask_is_unsent(a: PreparedAsk) -> Bool {
  match a.standing {
    AskCarried => false
    AskCarriedByLaterEnquiry { carried_by: _ } => false
    AskUnsent { reason: _ } => true
  }
}


// Sent/answered: at least one prepared ask has left the drafting table -- carried by this arm's own
// enquiry, or carried by a later one whose receipt the standing holds. Both are "not unsent", which is
// what this coherence question is about; which enquiry carried it is the standing's own business.
// Unsent: every prepared ask is still AskUnsent, and at least one exists -- a draft with
// AskCarried would claim the operator already sent an ask this corpus has no request id for.
fn outreach_asks_coherent(o: RelationshipOutreach) -> Bool {
  match o {
    RelationshipOutreachUnsent { unsent } =>
      count(unsent.asks) > 0 && count(filter(unsent.asks, a => !ask_is_unsent(a: a))) == 0
    RelationshipOutreachSent { enquiry: _, preparation: _, transcription: _, asks: asks } => some_ask_carried(asks: asks)
    RelationshipOutreachAnswered { enquiry: _, reply: _, preparation: _, transcription: _, asks: asks } => some_ask_carried(asks: asks)
  }
}

fn outreach_arm_label(o: RelationshipOutreach) -> String {
  match o {
    RelationshipOutreachUnsent { unsent: _ } => "Unsent"
    RelationshipOutreachSent { enquiry: _, preparation: _, transcription: _, asks: _ } => "Sent"
    RelationshipOutreachAnswered { enquiry: _, reply: _, preparation: _, transcription: _, asks: _ } => "Answered"
  }
}

fn some_ask_carried(asks: List<PreparedAsk>) -> Bool {
  count(filter(asks, a => !ask_is_unsent(a: a))) > 0
}

fn unsent_ask_ids(asks: List<PreparedAsk>) -> List<String> {
  map(filter(asks, a => ask_is_unsent(a: a)), a => a.ask_id as String)
}

// SENT 2026-09-12, by the operator personally, through Ampere's support helpdesk rather than the
// sales address the Customer Connect refusal pointed at: Ampere Support acknowledged receipt and
// opened ticket #7426, "Help routing NDA / Customer Connect request -- Gunbai LLC"
// (https://support.amperecomputing.com/helpdesk/tickets/7426), promising a personal response from
// a support representative. `asked` is the operator's own text, verbatim including the signature
// block; the transcription receipt says how the corpus came to hold it. The text states its own
// scope -- "simply to establish the appropriate next step" -- so the reply this row expects is a
// ROUTING answer (who considers the NDA; whether an OEM, ODM or distributor is the route), not a
// technical one; a technical answer would be a bonus, not the discharge. The reply lands as
// RelationshipOutreachAnswered with #64's VendorReply carrier.
//
// ANSWERED 2026-09-18, AND THE BONUS IS WHAT ARRIVED. This row now holds
// strategy.vendor_correspondence mt_collins_firmware_delivery, exactly the transition the sentence
// above predicted -- and the shape of the answer is the inversion it did not expect: the TECHNICAL
// delivery landed and the ROUTING answer this outreach is FOR did not. No person was named for the
// NDA and no OEM, ODM or distributor referral was given. So `Answered` here means a reply arrived;
// what remains open is carried by the asks below rather than by that label, and the reply's own
// leaves_open field says the same thing from the other side.
//
// No owner step is minted for the wait because this action has no year-end plan identity (the rule
// stated above the type).
data ampere_relationship_outreach: RelationshipOutreach = RelationshipOutreachAnswered {
  reply: mt_collins_firmware_delivery,
  enquiry: VendorEnquiry {
    sent_on: "2026-09-12",
    channel: "Ampere Support helpdesk (support.amperecomputing.com), submitted by the operator personally; acknowledged by the Ampere Support Team by email the same day",
    request_id: "Ampere Support ticket #7426",
    asked: "Hello Ampere Support,\n\nMy Customer Connect registration was declined because Gunbai LLC does not yet have an Ampere NDA. Following your instructions, I emailed sales@amperecomputing.com on August 17 and August 30, but have not received a response.\n\nWe operate Ampere Altra systems and are seeking access to platform documentation and an appropriate contact for firmware and memory-population questions.\n\nCould you help identify the person responsible for considering our NDA request? If an OEM, ODM, or distributor is the appropriate route for a company in our position, a referral would be very helpful.\n\nThe earlier emails contain the project details; our immediate request is simply to establish the appropriate next step.\n\nThank you,\nBrian Searls\nFounder, Gunbai LLC\nbriansrls@gunb.ai",
  },
  transcription: ActionReceipt {
    receipt_id: "ampere-ticket-7426-sent-text-transcribed",
    evidence: ObservedFact {
      subject: "the operator's sent text on Ampere Support ticket #7426",
      observation: "transcribed verbatim, signature block included, from the operator's own copy as relayed by royal-eagle-761 in dashboard message msg_c0b01d37-5a58-4f42-8fd3-194fd4fed8a1; the earlier revision of this row (private #96) recorded the acknowledged subject line only and marked the body unread",
      observed_at: "2026-09-12",
    },
  },
  asks: [
    PreparedAsk {
      ask_id: "nda-customer-connect-routing",
      ask: "identify the person responsible for considering the NDA request, so Customer Connect registration can proceed",
      standing: AskCarried,
    },
    PreparedAsk {
      ask_id: "referral-route",
      ask: "whether an OEM, ODM or distributor is the appropriate route for a company in Gunbai's position, with a referral",
      standing: AskCarried,
    },
    PreparedAsk {
      ask_id: "documentation-and-technical-contact",
      ask: "access to platform documentation and an appropriate contact for firmware and memory-population questions",
      standing: AskCarried,
    },
    PreparedAsk {
      ask_id: "firmware-images-owned-mt-collins",
      ask: "firmware images / access for the owned Mt Collins systems",
      standing: AskCarriedByLaterEnquiry { carried_by: receipt_ampere_firmware_asks_sent },
    },
    PreparedAsk {
      ask_id: "table-3-different-channel-rank",
      ask: "clarification of OCP Mt. Jade Table 3's different-channel rank-mixing cell, which reads TBD",
      standing: AskUnsent { reason: "not carried by the sent text; OCP open channels remain the separate route to specification clarification" },
    },
    PreparedAsk {
      ask_id: "named-commercial-contact",
      ask: "a named commercial contact for a supply discussion beyond the secondary market",
      standing: AskUnsent { reason: "the sent text asked for the NDA decision-maker and a technical contact, not a commercial one; still owed" },
    },
  ],
  preparation: [receipt_ampere_customer_connect_rejection, receipt_ampere_sales_enquiry_unanswered,
    ActionReceipt { receipt_id: "ampere-es-preparation", evidence: CorpusDeclaration {
      declaration: decl_ref(module_path: "strategy.ci_node_build", decl_name: "altra_q80_lot"),
    } },
  ],
}
fn consumer_is_served(consumer: RelationshipConsumer, relationships: List<VendorRelationship>) -> Bool {
  let matches = filter(relationships, r => declaration_ref_eq(a: r.subject, b: consumer.relationship))
  count(matches) == 1 && fold(matches, init: false, f: fn(acc, r) {
    acc || standing_serves(standing: r.standing, needs: consumer.needs)
  })
}

fn covered_relationships_state_how_coverage_fails(relationships: List<VendorRelationship>) -> Bool {
  fold(relationships, init: true, f: fn(acc, r) {
    acc && match r.current_coverage {
      CoveredBy { mechanism: _, failure_modes: fs } => count(fs) > 0,
      NotCovered { reason: _ } => true,
    }
  })
}

fn relationships_name_routes_and_drivers(relationships: List<VendorRelationship>) -> Bool {
  fold(relationships, init: true, f: fn(acc, r) {
    acc && count(r.raising_routes) > 0 && count(r.absence_cost_drivers) > 0
  })
}

fn relationships_are_not_steps(relationships: List<VendorRelationship>, steps: List<OwnerStep>) -> Bool {
  fold(relationships, init: true, f: fn(acc, r) {
    acc && count(filter(steps, s => s.step_id == r.identity)) == 0
  })
}

fn exclusions_hold() -> Bool {
  fold(excluded_consumers, init: true, f: fn(acc, x) {
    acc && count(filter(relationship_consumers,
      c => c.consumer == x.consumer && declaration_ref_eq(a: c.relationship, b: x.relationship))) == 0
  })
}

fn every_consumer_names_a_declared_relationship() -> Bool {
  fold(relationship_consumers, init: true, f: fn(acc, c) {
    acc && count(filter(vendor_relationships, r => declaration_ref_eq(a: r.subject, b: c.relationship))) == 1
  })
}

// THE BUYER PIPELINE'S TWO eBAY GATES, in the order they can open. The developer account was
// registered 2026-09-11 and approved the same day. Production Browse access is then established by
// observation: a 200 from one read-only search with the Production keyset. Only if that test had
// returned 403 would a Partner Network application be owed, and its decision wait rostered after it
// was sent (an unsent request has no wait). strategy.buyer_review_sheet derives the pipeline's API
// standing from these rows through external_wait_outcome and holds no gate state of its own.
data step_ebay_developer_account_wait: OwnerStep = OwnerStep {
  step_id: "ebay-developer-account-wait",
  plan_item: "buyer-agent-pipeline",
  work: ExternalWaitWork {
    wait: ExternalWait {
      partial_answers: [],
      awaited_event: "eBay Developers Program account approval",
      blocks: ["ebay-browse-production-access"],
      window: UpstreamPublishedWindow {
        source: "eBay registration acknowledgement: access to the new account is pending approval, which takes at least one business day",
        next_check: "2026-09-12",
        read_at: "2026-09-11",
      },
      fallback: NoFallbackDeclared {
        reason: "operator-entered listings are the floor: a refusal at either eBay gate costs the scheduled scan and nothing else; ranking, filtering, compatibility and purchase intent need no credential",
      },
      reference: SentWithoutReference {
        authority: "eBay Developers Program",
        sent_at: "2026-09-11",
        note: "the registration returned only an acknowledgement with no ticket or case identifier; the stated window is a floor, so an unanswered check on 2026-09-12 is not yet a missed deadline",
      },
    },
  },
  start_requirements: no_requirements,
  produces_receipt: "ebay-developer-account-approved",
  progress: StepDischarged { receipt: receipt_ebay_developer_account_approved },
}

data step_ebay_browse_production_access: OwnerStep = OwnerStep {
  step_id: "ebay-browse-production-access",
  plan_item: "buyer-agent-pipeline",
  work: OperatorActionWork {
    intervention: discharged_operator_intervention(
      identity: "ebay-browse-production-access",
      subject: browse_production_access.application_route,
      instruction: "With the developer account approved, put the Production keyset's App ID and Cert ID into fleet secret custody (gunbai-secrets ebay-browse-app-id, ebay-browse-cert-id), then run one read-only client-credentials token mint and one Browse search. A 200 establishes production Browse access. A 403 means it is not granted: apply through the eBay Partner Network (read-only search and item reads for internal procurement, no checkout, no resale or republication), and a decision wait on that application is rostered.",
      receipt_declaration: "receipt_ebay_browse_production_access_observed",
    ),
  },
  start_requirements: [AfterStep { step_id: "ebay-developer-account-wait" }],
  produces_receipt: "ebay-browse-production-access-observed",
  progress: StepDischarged { receipt: receipt_ebay_browse_production_access_observed },
}

// WHAT WAS FILED IS READ AND RECORDED, AND THAT IS ALL THIS STEP DOES. The keyset is exempt from
// Marketplace Account Deletion on the portal reason "I do not persist eBay data", filed on
// 2026-09-11 with an Additional information disclosure that listing attributes are retained. This
// step carries that text verbatim (receipt_ebay_exemption_filing_recorded) and nothing more.
//
// IT DECIDES NOTHING ABOUT COVERAGE. eBay activates a keyset once a developer subscribes or opts
// out, so the activation that followed is a consequence of the SELECTION, not an adjudication of the
// free text beside it -- reading it as acceptance would be an inference promoted to a fact, on a
// question whose stated penalty is account disablement. Whether the retained profile is covered is
// step_ebay_exemption_applicability, and whether any answer PERMITS retention is
// step_ebay_retention_permitted. Applicability remains unanswered. Permission was discharged
// separately: the operator accepted the residual risk and authorized retention
// (strategy.gunbc_strategy decision_ebay_retention_permitted), so applicability does not block that
// internally authorized persistence route. ebay-browse-scheduled-scan remains the open build step.
data step_ebay_exemption_filing_read: OwnerStep = OwnerStep {
  step_id: "ebay-exemption-filing-read",
  plan_item: "buyer-agent-pipeline",
  work: OperatorActionWork {
    intervention: discharged_operator_intervention(
      identity: "ebay-exemption-filing-read",
      subject: "the Marketplace Account Deletion exemption as filed for the Production keyset",
      instruction: "From the developer portal's Marketplace Account Deletion page, record verbatim: the exemption reason selected, the Additional information text exactly as submitted, and whether the portal shows the exemption granted. Carry the filed text, never a paraphrase.",
      receipt_declaration: "receipt_ebay_exemption_filing_recorded",
    ),
  },
  start_requirements: [AfterStep { step_id: "ebay-browse-production-access" }],
  produces_receipt: "ebay-exemption-filing-recorded",
  progress: StepDischarged { receipt: receipt_ebay_exemption_filing_recorded },
}

// THE PERMISSION STEP'S EVIDENCE IS THE OPERATOR'S RISK DECISION. This receipt CITES
// strategy.gunbc_strategy decision_ebay_retention_permitted; a decl_ref is a citation and resolves
// nothing by itself, so the join between this step and that decision is established by
// test.claim.owner_action_witness the_retention_discharge_joins_the_selected_risk_decision, which
// checks the cited declaration's question, selected choice, authority and typed facts.
data receipt_ebay_retention_permitted_ruled: ActionReceipt = ActionReceipt {
  receipt_id: "ebay-retention-permission-evidenced",
  evidence: CorpusDeclaration {
    declaration: decl_ref(module_path: "strategy.gunbc_strategy", decl_name: "decision_ebay_retention_permitted"),
  },
}

// APPLICABILITY IS NOT SETTLED BY ACTIVATION. What is still owed is evidence addressing THIS
// retained profile: eBay Developer Technical Support answering, against the filed disclosure,
// whether retaining listing attributes is within "I do not persist eBay data" -- or, failing that,
// a decision among the three arms (stop persisting API-derived listing data, subscribe to deletion
// notifications, or amend the exemption). It remains unanswered. It no longer gates persistence:
// the operator separately accepted the residual risk and authorized retention
// (step_ebay_retention_permitted), so the scan's gate is that permission, not this answer, and
// ebay-browse-scheduled-scan remains the open build step.
data step_ebay_exemption_applicability: OwnerStep = OwnerStep {
  step_id: "ebay-exemption-applicability",
  plan_item: "buyer-agent-pipeline",
  work: OperatorActionWork {
    intervention: open_operator_intervention(
      identity: "ebay-exemption-applicability",
      subject: "whether the filed exemption covers retaining the disclosed listing attributes",
      instruction: "Ask eBay Developer Technical Support, quoting the filed disclosure, whether retaining listing attributes (item ID, title, price, shipping cost, condition, item specifics, seller feedback figures without identity) is within the exemption reason selected. Record their answer. If it is not, choose an arm: stop persisting API-derived listing data, subscribe to account-deletion notifications, or amend the exemption. Activation of the keyset is not this answer.",
    ),
  },
  start_requirements: [AfterStep { step_id: "ebay-exemption-filing-read" }],
  produces_receipt: "ebay-exemption-applicability-settled",
  progress: StepOpen,
}

// AN ANSWER IS NOT A PERMISSION. The applicability step above completes on ANY of its outcomes, and
// two of them -- stop persisting API-derived listing data, or subscribe to deletion notifications --
// do not permit the scan to retain anything: the first forbids it, and the second only becomes
// permission once a subscription is actually OPERATING, which is more than transport: the endpoint
// answers eBay's challenge, a notification is processed, and the data it names is deleted from every
// retained copy. Acknowledging is not handling -- an endpoint returning 200 and deleting nothing
// satisfies eBay's transport and not its obligation -- so the instruction below names that deletion
// capability's own completion evidence. AfterStep reads discharge alone, so a step that discharges
// on the supported outcome is what the scan waits on, and it stays open under every other answer.
// A FOURTH ROUTE WAS ADDED 2026-09-18, and it is the one that discharged this step: arm (d), the
// operator ACCEPTING the residual risk, recorded as a selected strategic decision that carries typed
// facts about what it does not establish. It is not a finding that no personal data is stored, and it
// does not answer applicability. That is why this step no longer waits on ebay-exemption-applicability:
// the ruling authorizes retention while applicability is unanswered, so requiring applicability first
// would make the risk route unreachable, and discharging applicability to satisfy it would record an
// answer nobody gave. Applicability stays open.
data step_ebay_retention_permitted: OwnerStep = OwnerStep {
  step_id: "ebay-retention-permitted",
  plan_item: "buyer-agent-pipeline",
  work: OperatorActionWork {
    intervention: discharged_operator_intervention(
      identity: "ebay-retention-permitted",
      subject: "a supported permission to persist the disclosed listing attributes",
      instruction: "Discharge this ONLY on an outcome that permits retention: (d) an operator ruling recorded as a selected strategic decision that names what it does not establish; or (a) eBay stating the disclosed listing attributes are within the filed exemption, quoted; or (b) an amended filing that covers them, recorded verbatim as filed; or (c) a deletion-notification subscription that is OPERATING END TO END -- the endpoint answered eBay's challenge, a test notification was processed, and the data named by a notification is actually deleted from every retained copy (the CSVs, the Sheets realization, and any cache). Acknowledging a notification is not handling it: an endpoint that answers 200 and deletes nothing satisfies eBay's transport and not its obligation, so arm (c) needs the deletion capability's own completion evidence. An answer of 'stop persisting API-derived listing data' never discharges this step; it closes the retaining scan instead.",
      receipt_declaration: "receipt_ebay_retention_permitted_ruled",
    ),
  },
  start_requirements: [],
  produces_receipt: "ebay-retention-permission-evidenced",
  progress: StepDischarged { receipt: receipt_ebay_retention_permitted_ruled },
}

// THE NEXT STEP IS AGENT WORK, AND IT IS BOUNDED BY THE DISCLOSURE. With access observed and the
// retention permitted, the scheduled read may be built against observed Browse responses. What it persists is limited to what the disclosure
// names. No dedicated identity field is writable (test.probe.seller_identity_unwritable_probe guards
// two named fields); free text the scan captures is not policed, so the capture itself must stay
// narrow rather than rely on that probe.
data step_ebay_browse_scheduled_scan: OwnerStep = OwnerStep {
  step_id: "ebay-browse-scheduled-scan",
  plan_item: "buyer-agent-pipeline",
  work: DelegatedActionWork {
    instruction: "Build the scheduled Browse read for the DDR4 RDIMM demand row: capture only the disclosed fields from real search and getItem responses (a full getItem body is broader than the retained projection), witness the fold against them, and persist only the listing attributes the filed exemption disclosure names (item ID, title, price, shipping cost, condition, item specifics, seller feedback figures without identity), within review_scan_schedule's derived call budget. The filed disclosure is the exact list of what may be persisted: anything the scan would keep that is not on it is a new disclosure question for the operator, not an implementation detail.",
  },
  start_requirements: [AfterStep { step_id: "ebay-retention-permitted" }],
  produces_receipt: "ebay-browse-scheduled-scan-live",
  progress: StepOpen,
}

// THE AUTHORING HALF, AND IT IS WHY THE ITEM READS InProgress RATHER THAN NotStarted. The check
// in_progress_items_carry_receipt_and_residue refused the first version of this enrolment, which
// carried only the open ratification step: an item claiming progress with nothing discharged is an
// item nobody started. The refusal was right, and the missing fact was real -- the proposal rows
