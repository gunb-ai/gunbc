fn is_operator_exclusive(mode: ExecutionMode) -> Bool {
  match mode {
    OperatorExclusive => true,
    AgentParallel => false,
    ExternalLead => false,
    CalendarObservation => false,
  }
}

fn is_external_lead(mode: ExecutionMode) -> Bool {
  match mode {
    OperatorExclusive => false,
    AgentParallel => false,
    ExternalLead => true,
    CalendarObservation => false,
  }
}

fn item_resolves(item_id: NonEmptyStr) -> Bool {
  count(find_item(id: item_id)) == 1
}

fn item_is_operator_exclusive(item_id: NonEmptyStr) -> Bool {
  fold(find_item(id: item_id), init: false, f: fn(acc, i) { acc || is_operator_exclusive(mode: i.execution_mode) })
}

fn item_is_external_lead(item_id: NonEmptyStr) -> Bool {
  fold(find_item(id: item_id), init: false, f: fn(acc, i) { acc || is_external_lead(mode: i.execution_mode) })
}

fn item_open(item_id: NonEmptyStr) -> Bool {
  fold(find_item(id: item_id), init: false, f: fn(acc, i) { acc || !item_is_done(i: i) })
}

// InProgress is read as "neither Done nor NotStarted" rather than by importing the status
// constructor: the plan owns what its statuses mean, and a second match on its variants here would
// be a second reader of the same fact.
fn item_in_progress(item_id: NonEmptyStr) -> Bool {
  fold(find_item(id: item_id), init: false, f: fn(acc, i) {
    acc || (!item_is_done(i: i) && !item_not_started(i: i))
  })
}

fn step_is_discharged(step: OwnerStep) -> Bool {
  match step.progress {
    StepDischarged { receipt: _ } => true,
    StepExternallyRefused { receipt: _, cause: _ } => false,
    StepOpen => false,
  }
}

// OPEN IS NOT "not discharged". A refused step is neither in flight nor done, and folding it into
// either one is the state-space conflation that would make a rejected application render as a wait
// still pending.
fn step_is_open(step: OwnerStep) -> Bool {
  match step.progress {
    StepDischarged { receipt: _ } => false,
    StepExternallyRefused { receipt: _, cause: _ } => false,
    StepOpen => true,
  }
}

fn step_is_externally_refused(step: OwnerStep) -> Bool {
  match step.progress {
    StepDischarged { receipt: _ } => false,
    StepExternallyRefused { receipt: _, cause: _ } => true,
    StepOpen => false,
  }
}

fn step_is_wait(step: OwnerStep) -> Bool {
  match step.work {
    OperatorActionWork { intervention: _ } => false,
    DelegatedActionWork { instruction: _ } => false,
    OperatorDecisionWork { intervention: _, alternatives: _ } => false,
    ExternalWaitWork { wait: _ } => true,
  }
}

// THE OPERATOR/AGENT SPLIT, READ OFF THE EXISTING CONCEPT. A step is the operator's exactly when
// its work carries a HumanIntervention. Nothing else is consulted, and no second actor field
// exists to disagree with it.
fn step_is_human_intervention(step: OwnerStep) -> Bool {
  match step.work {
    OperatorActionWork { intervention: _ } => true,
    DelegatedActionWork { instruction: _ } => false,
    OperatorDecisionWork { intervention: _, alternatives: _ } => true,
    ExternalWaitWork { wait: _ } => false,
  }
}

fn steps_with_id(steps: List<OwnerStep>, step_id: NonEmptyStr) -> List<OwnerStep> {
  filter(steps, s => s.step_id == step_id)
}

fn requirement_satisfied_as_of(
  requirement: StartRequirement,
  steps: List<OwnerStep>,
  as_of: NonEmptyStr,
) -> Bool {
  match requirement {
    AfterStep { step_id: sid } =>
      fold(steps_with_id(steps: steps, step_id: sid), init: false, f: fn(acc, s) {
        acc || step_is_discharged(step: s)
      }),
    AfterPlanItem { item_id: iid } =>
      fold(find_item(id: iid), init: false, f: fn(acc, i) { acc || item_is_done(i: i) }),
    AfterCalendarDate { on_or_after: d, basis: _ } => d <= as_of,
  }
}

fn requirement_satisfied(requirement: StartRequirement, steps: List<OwnerStep>) -> Bool {
  requirement_satisfied_as_of(requirement: requirement, steps: steps, as_of: owner_queue_as_of)
}

fn unmet_requirements_as_of(
  step: OwnerStep,
  steps: List<OwnerStep>,
  as_of: NonEmptyStr,
) -> List<StartRequirement> {
  filter(step.start_requirements,
    r => !requirement_satisfied_as_of(requirement: r, steps: steps, as_of: as_of))
}

fn unmet_requirements(step: OwnerStep, steps: List<OwnerStep>) -> List<StartRequirement> {
  unmet_requirements_as_of(step: step, steps: steps, as_of: owner_queue_as_of)
}

fn requirement_names_step(requirement: StartRequirement, step_id: NonEmptyStr) -> Bool {
  match requirement {
    AfterStep { step_id: sid } => sid == step_id,
    AfterPlanItem { item_id: _ } => false,
    AfterCalendarDate { on_or_after: _, basis: _ } => false,
  }
}

// A DISPATCH IS NOT DECLARED, IT IS DERIVED. A short action that starts material calendar latency
// is exactly an action some WAIT is waiting on, and that edge is already written. Carrying a
// starts_a_clock flag beside it would be a second representation of the same fact, satisfiable by
// editing the flag while the graph says otherwise.
fn step_starts_external_clock(step: OwnerStep, steps: List<OwnerStep>) -> Bool {
  fold(steps, init: false, f: fn(acc, w) {
    acc || (step_is_wait(step: w)
      && fold(w.start_requirements, init: false, f: fn(inner, r) {
        inner || requirement_names_step(requirement: r, step_id: step.step_id)
      }))
  })
}

// THE SIX STATES, DERIVED HERE AND NOWHERE ELSE. A wait cannot reach a ready arm: the wait branch
// is taken before any ready arm is considered, and an undispatched wait is Blocked rather than
// Waiting, because nothing is in flight until its initiating action is discharged.
fn step_state_as_of(
  step: OwnerStep,
  steps: List<OwnerStep>,
  as_of: NonEmptyStr,
) -> OwnerQueueState {
  let unmet = unmet_requirements_as_of(step: step, steps: steps, as_of: as_of)
  if count(unmet) > 0 {
    Blocked { step_id: step.step_id, unmet: unmet }
  } else {
    match step.work {
      ExternalWaitWork { wait: w } =>
        Waiting { step_id: step.step_id, awaited_event: w.awaited_event, next_check: wait_next_check(window: w.window) },
      DelegatedActionWork { instruction: _ } => DelegateNow { step_id: step.step_id },
      OperatorActionWork { intervention: _ } =>
        if step_starts_external_clock(step: step, steps: steps) {
          StartExternalClock { step_id: step.step_id }
        } else {
          DoNow { step_id: step.step_id }
        },
      OperatorDecisionWork { intervention: _, alternatives: _ } =>
        if step_starts_external_clock(step: step, steps: steps) {
          StartExternalClock { step_id: step.step_id }
        } else {
          DoNow { step_id: step.step_id }
        },
    }
  }
}

fn step_state(step: OwnerStep, steps: List<OwnerStep>) -> OwnerQueueState {
  step_state_as_of(step: step, steps: steps, as_of: owner_queue_as_of)
}

fn open_steps_for(item_id: NonEmptyStr, steps: List<OwnerStep>) -> List<OwnerStep> {
  filter(steps, s => s.plan_item == item_id && step_is_open(step: s))
}

fn discharged_steps_for(item_id: NonEmptyStr, steps: List<OwnerStep>) -> List<OwnerStep> {
  filter(steps, s => s.plan_item == item_id && step_is_discharged(step: s))
}

// AN OPEN OUTCOME WITH NO EXECUTABLE CHILD AND NO HONEST WAIT IS NOT "not started" -- it is
// UNDECOMPOSED, and it renders as that rather than disappearing from the queue.
fn item_queue_states(item_id: NonEmptyStr, steps: List<OwnerStep>) -> List<OwnerQueueState> {
  if !item_open(item_id: item_id) {
    []
  } else {
    let open = open_steps_for(item_id: item_id, steps: steps)
    if count(open) == 0 {
      [NeedsDecomposition { plan_item: item_id }]
    } else {
      map(open, s => step_state(step: s, steps: steps))
    }
  }
}

fn exposure_state_for(trigger: PlanItem, cure: PlanItem) -> OwnerQueueState {
  if item_is_done(i: trigger) {
    ExposureNowLive { trigger_item: trigger.id, curing_item: cure.id }
  } else {
    ExposureIfTriggerSucceeds { trigger_item: trigger.id, curing_item: cure.id }
  }
}

fn open_success_exposure_states(items: List<PlanItem>) -> List<OwnerQueueState> {
  fold(items, init: [], f: fn(acc, trigger) {
    concat(acc, map(
      filter(
        exposures_activated_by_success_of_in(items: items, item_id: trigger.id),
        cure => !item_is_done(i: cure),
      ),
      cure => exposure_state_for(trigger: trigger, cure: cure),
    ))
  })
}

fn owner_queue_over(steps: List<OwnerStep>, items: List<PlanItem>) -> List<OwnerQueueState> {
  concat(
    flat_map(owner_action_subject_items, id => item_queue_states(item_id: id, steps: steps)),
    open_success_exposure_states(items: items),
  )
}

fn owner_queue(steps: List<OwnerStep>) -> List<OwnerQueueState> {
  owner_queue_over(steps: steps, items: year_end_plan_items)
}

// THE STEP A QUEUE LINE IS ABOUT, so a per-step claim can be made against the FOLD's output
// without a bespoke predicate per step. The first version of this was state_is_data_map_ratify,
// which baked one step id into a production function that existed only to serve one witness
// (review 66228): the id then lived in three places and a rename would have redded two of them
// only by luck of string equality. This carries no id at all -- the name stays on the step row
// and in the claim that is about it.
//
// ZERO-OR-ONE RATHER THAN A SENTINEL, for the reason strategy.data_map states about its own
// settling decision: NeedsDecomposition names a plan_item and genuinely has no step, and inventing
// a step id to stand for "none" would fabricate a value the empty case does not have.
//
// AND THE EMPTY CASE IMMEDIATELY GREW, which is the argument landing rather than being asserted.
// #116's two exposure arms name a trigger item and a curing item and no step at all, so they answer
// empty here for the same reason NeedsDecomposition does. A sentinel would have forced a fabricated
// step id onto a line that is not about a step, at the first arm added after this was written.
fn state_step_id(state: OwnerQueueState) -> List<NonEmptyStr> {
  match state {
    DoNow { step_id } => [step_id],
    StartExternalClock { step_id } => [step_id],
    Waiting { step_id, awaited_event, next_check } => [step_id],
    DelegateNow { step_id } => [step_id],
    Blocked { step_id, unmet } => [step_id],
    NeedsDecomposition { plan_item } => [],
    ExposureIfTriggerSucceeds { trigger_item, curing_item } => [],
    ExposureNowLive { trigger_item, curing_item } => [],
  }
}

fn state_is_ready(state: OwnerQueueState) -> Bool {
  match state {
    DoNow { step_id: _ } => true,
    StartExternalClock { step_id: _ } => true,
    DelegateNow { step_id: _ } => true,
    Waiting { step_id: _, awaited_event: _, next_check: _ } => false,
    Blocked { step_id: _, unmet: _ } => false,
    NeedsDecomposition { plan_item: _ } => false,
    ExposureIfTriggerSucceeds { trigger_item: _, curing_item: _ } => false,
    ExposureNowLive { trigger_item: _, curing_item: _ } => false,
  }
}

fn state_is_waiting(state: OwnerQueueState) -> Bool {
  match state {
    DoNow { step_id: _ } => false,
    StartExternalClock { step_id: _ } => false,
    DelegateNow { step_id: _ } => false,
    Waiting { step_id: _, awaited_event: _, next_check: _ } => true,
    Blocked { step_id: _, unmet: _ } => false,
    NeedsDecomposition { plan_item: _ } => false,
    ExposureIfTriggerSucceeds { trigger_item: _, curing_item: _ } => false,
    ExposureNowLive { trigger_item: _, curing_item: _ } => false,
  }
}

fn state_needs_decomposition(state: OwnerQueueState) -> Bool {
  match state {
    DoNow { step_id: _ } => false,
    StartExternalClock { step_id: _ } => false,
    DelegateNow { step_id: _ } => false,
    Waiting { step_id: _, awaited_event: _, next_check: _ } => false,
    Blocked { step_id: _, unmet: _ } => false,
    NeedsDecomposition { plan_item: _ } => true,
    ExposureIfTriggerSucceeds { trigger_item: _, curing_item: _ } => false,
    ExposureNowLive { trigger_item: _, curing_item: _ } => false,
  }
}

fn state_is_blocked(state: OwnerQueueState) -> Bool {
  match state {
    DoNow { step_id: _ } => false,
    StartExternalClock { step_id: _ } => false,
    DelegateNow { step_id: _ } => false,
    Waiting { step_id: _, awaited_event: _, next_check: _ } => false,
    Blocked { step_id: _, unmet: _ } => true,
    NeedsDecomposition { plan_item: _ } => false,
    ExposureIfTriggerSucceeds { trigger_item: _, curing_item: _ } => false,
    ExposureNowLive { trigger_item: _, curing_item: _ } => false,
  }
}

fn state_starts_external_clock(state: OwnerQueueState) -> Bool {
  match state {
    DoNow { step_id: _ } => false,
    StartExternalClock { step_id: _ } => true,
    DelegateNow { step_id: _ } => false,
    Waiting { step_id: _, awaited_event: _, next_check: _ } => false,
    Blocked { step_id: _, unmet: _ } => false,
    NeedsDecomposition { plan_item: _ } => false,
    ExposureIfTriggerSucceeds { trigger_item: _, curing_item: _ } => false,
    ExposureNowLive { trigger_item: _, curing_item: _ } => false,
  }
}

fn step_wait_reference(step: OwnerStep) -> ExternalRequestReference {
  match step.work {
    ExternalWaitWork { wait: w } => w.reference,
    OperatorActionWork { intervention: _ } => RequestNotYetSent,
    DelegatedActionWork { instruction: _ } => RequestNotYetSent,
    OperatorDecisionWork { intervention: _, alternatives: _ } => RequestNotYetSent,
  }
}

fn reference_says_sent(reference: ExternalRequestReference) -> Bool {
  match reference {
    RequestNotYetSent => false,
    ReferencedRequest { authority: _, identifier: _, sent_at: _ } => true,
    SentWithoutReference { authority: _, sent_at: _, note: _ } => true,
  }
}

fn evidence_cites_site(evidence: InterventionCompletionEvidence) -> Bool {
  match evidence {
    DischargedAt { evidence: _ } => true,
    NoDischargeSiteModeled => false,
  }
}

fn step_cites_discharge_site(step: OwnerStep) -> Bool {
  match step.work {
    OperatorActionWork { intervention: iv } => evidence_cites_site(evidence: iv.completion_evidence),
    OperatorDecisionWork { intervention: iv, alternatives: _ } => evidence_cites_site(evidence: iv.completion_evidence),
    DelegatedActionWork { instruction: _ } => false,
    ExternalWaitWork { wait: _ } => false,
  }
}

fn step_is_decision(step: OwnerStep) -> Bool {
  match step.work {
    OperatorDecisionWork { intervention: _, alternatives: _ } => true,
    OperatorActionWork { intervention: _ } => false,
    DelegatedActionWork { instruction: _ } => false,
    ExternalWaitWork { wait: _ } => false,
  }
}

fn decision_alternative_count(step: OwnerStep) -> Int {
  match step.work {
    OperatorDecisionWork { intervention: _, alternatives: a } => count(a),
    OperatorActionWork { intervention: _ } => 0,
    DelegatedActionWork { instruction: _ } => 0,
    ExternalWaitWork { wait: _ } => 0,
  }
}

fn step_receipt_id(step: OwnerStep) -> NonEmptyStr {
  match step.progress {
    StepDischarged { receipt: r } => r.receipt_id,
    StepExternallyRefused { receipt: r, cause: _ } => r.receipt_id,
    StepOpen => step.produces_receipt,
  }
}

// ---------------------------------------------------------------------------------------------
// THE COVERAGE DERIVATIONS. Each is total over the declared subject and returns a Bool the witness
// executes; each has a discriminating red the witness produces by handing it a mutated roster.
// ---------------------------------------------------------------------------------------------

fn subject_items_resolve() -> Bool {
  fold(owner_action_subject_items, init: true, f: fn(acc, id) { acc && item_resolves(item_id: id) })
}

fn id_in_subject(item_id: NonEmptyStr) -> Bool {
  count(filter(owner_action_subject_items, s => s == item_id)) == 1
}

fn steps_target_subject_items(steps: List<OwnerStep>) -> Bool {
  fold(steps, init: true, f: fn(acc, s) { acc && id_in_subject(item_id: s.plan_item) })
}

fn operator_exclusive_item_covered(item_id: NonEmptyStr, steps: List<OwnerStep>) -> Bool {
  count(filter(open_steps_for(item_id: item_id, steps: steps),
    s => step_is_human_intervention(step: s) || step_is_wait(step: s))) > 0
}

fn operator_exclusive_coverage(steps: List<OwnerStep>) -> Bool {
  fold(owner_action_subject_items, init: true, f: fn(acc, id) {
    acc && (!(item_open(item_id: id) && item_is_operator_exclusive(item_id: id))
      || operator_exclusive_item_covered(item_id: id, steps: steps))
  })
}

fn in_progress_items_carry_receipt_and_residue(steps: List<OwnerStep>) -> Bool {
  fold(owner_action_subject_items, init: true, f: fn(acc, id) {
    acc && (!item_in_progress(item_id: id)
      || (count(discharged_steps_for(item_id: id, steps: steps)) > 0
        && count(open_steps_for(item_id: id, steps: steps)) > 0))
  })
}

// THE COUNSEL-MARKET-CENSUS REPAIR, STATED AS A LAW OVER EVERY ExternalLead OUTCOME. A dispatch and
// the wait it starts are two steps with two different actors of time, and the wait must name the
// dispatch as its start requirement -- a wait that names nothing is a task wearing a wait's word.
fn external_lead_item_separated(item_id: NonEmptyStr, steps: List<OwnerStep>) -> Bool {
  let item_steps = filter(steps, s => s.plan_item == item_id)
  let waits = filter(item_steps, s => step_is_wait(step: s))
  let actions = filter(item_steps, s => !step_is_wait(step: s))
  count(waits) > 0
    && count(actions) > 0
    && fold(waits, init: true, f: fn(acc, w) {
      acc && fold(w.start_requirements, init: false, f: fn(inner, r) {
        inner || fold(actions, init: false, f: fn(hit, a) {
          hit || requirement_names_step(requirement: r, step_id: a.step_id)
        })
      })
    })
}

fn external_lead_dispatch_and_wait_separated(steps: List<OwnerStep>) -> Bool {
  fold(owner_action_subject_items, init: true, f: fn(acc, id) {
    acc && (!(item_open(item_id: id) && item_is_external_lead(item_id: id))
      || external_lead_item_separated(item_id: id, steps: steps))
  })
}

fn waits_never_ready(steps: List<OwnerStep>) -> Bool {
  fold(filter(steps, s => step_is_wait(step: s)), init: true, f: fn(acc, s) {
    acc && !state_is_ready(state: step_state(step: s, steps: steps))
  })
}

fn ready_steps_have_no_unmet_requirement(steps: List<OwnerStep>) -> Bool {
  fold(steps, init: true, f: fn(acc, s) {
    acc && (!state_is_ready(state: step_state(step: s, steps: steps))
      || count(unmet_requirements(step: s, steps: steps)) == 0)
  })
}

fn decisions_offer_alternatives(steps: List<OwnerStep>) -> Bool {
  fold(filter(steps, s => step_is_decision(step: s)), init: true, f: fn(acc, s) {
    acc && decision_alternative_count(step: s) > 1
  })
}

fn discharged_receipts_match_promise(steps: List<OwnerStep>) -> Bool {
  fold(filter(steps, s => step_is_discharged(step: s)), init: true, f: fn(acc, s) {
    acc && step_receipt_id(step: s) == s.produces_receipt
  })
}

fn discharged_operator_steps_cite_site(steps: List<OwnerStep>) -> Bool {
  fold(filter(steps, s => step_is_discharged(step: s) && step_is_human_intervention(step: s)),
    init: true, f: fn(acc, s) { acc && step_cites_discharge_site(step: s) })
}

fn open_operator_steps_state_the_gap(steps: List<OwnerStep>) -> Bool {
  fold(filter(steps, s => !step_is_discharged(step: s) && step_is_human_intervention(step: s)),
    init: true, f: fn(acc, s) { acc && !step_cites_discharge_site(step: s) })
}

// A WAIT WHOSE DISPATCH IS DISCHARGED HAS BEEN SENT, SO ITS REFERENCE MAY NOT SAY OTHERWISE. This
// is the one place the reference arm can be checked against another fact rather than trusted:
// RequestNotYetSent beside a discharged dispatch is a contradiction the graph can see.
fn dispatched_waits_carry_a_reference(steps: List<OwnerStep>) -> Bool {
  fold(filter(steps, s => step_is_wait(step: s)), init: true, f: fn(acc, s) {
    acc && (count(unmet_requirements(step: s, steps: steps)) > 0
      || reference_says_sent(reference: step_wait_reference(step: s)))
  })
}

// AN EXTERNALLY REFUSED STEP SATISFIES NOTHING. Asserted as a law over the roster rather than left
// to requirement_satisfied's definition, because the whole point of the refusal arm is that a "no"
// must not read as a "done" to anything downstream.
fn refused_steps_satisfy_nothing(steps: List<OwnerStep>) -> Bool {
  fold(filter(steps, s => step_is_externally_refused(step: s)), init: true, f: fn(acc, r) {
    acc && !requirement_satisfied(requirement: AfterStep { step_id: r.step_id }, steps: steps)
  })
}

// ---------------------------------------------------------------------------------------------
// THE JOIN SURFACE FOR CONSUMERS THAT HOLD A WAIT BUT NOT A STEP.
//
// ExternalWait carries whether the request WENT OUT (its reference), and that half is genuinely
// standalone. It deliberately does NOT carry whether it was ANSWERED: that fact lives in the
// carrier's own progress, and copying it onto the wait would be the second representation this
// module refuses everywhere else. But the outcome is exactly the gate a consumer asks about -- "may
// the executor call this upstream in production" is approved / refused / still open -- so leaving
// it reachable only by importing OwnerStep pushes every consumer to mirror it onto their own
// record, rebuilding the duplicate by the other route.
//
// So the outcome is a DERIVATION returning a VALUE, computed on every call and stored nowhere.
// ExternalWaitOutcome is not a second spelling of StepProgress: StepProgress is about a STEP of any
// kind, where "discharged" names an action its actor performed, and an applicant does not
// "discharge" someone else's approval. This is the external-answer vocabulary, and the function
// below is the ONE mapping between them -- a consumer never pattern-matches StepProgress arms
// itself, which is the fork-by-duplication that three consumers reading the sum in three places
// would be even though nobody minted a type. A consumer with no steps at all produces this value
// from its own carrier and joins here.
type ExternalWaitOutcome
  = AwaitedAnswerOutstanding
  | AwaitedAnswerReceived { receipt: ActionReceipt }
  | AwaitedAnswerRefused { receipt: ActionReceipt, cause: NonEmptyStr }

// The wait is a parameter although only the progress is read: the outcome is a fact ABOUT a
// specific awaited thing, and a reader callable without one in hand would answer for any step,
// which is the question this function is not for.
fn external_wait_outcome(wait: ExternalWait, progress: StepProgress) -> ExternalWaitOutcome {
  match progress {
    StepOpen => AwaitedAnswerOutstanding,
    StepDischarged { receipt: r } => AwaitedAnswerReceived { receipt: r },
    StepExternallyRefused { receipt: r, cause: c } => AwaitedAnswerRefused { receipt: r, cause: c },
  }
}

fn awaited_answer_is_outstanding(outcome: ExternalWaitOutcome) -> Bool {
  match outcome {
    AwaitedAnswerOutstanding => true,
    AwaitedAnswerReceived { receipt: _ } => false,
    AwaitedAnswerRefused { receipt: _, cause: _ } => false,
  }
}

fn awaited_answer_was_received(outcome: ExternalWaitOutcome) -> Bool {
  match outcome {
    AwaitedAnswerOutstanding => false,
    AwaitedAnswerReceived { receipt: _ } => true,
    AwaitedAnswerRefused { receipt: _, cause: _ } => false,
  }
}

fn awaited_answer_was_refused(outcome: ExternalWaitOutcome) -> Bool {
  match outcome {
    AwaitedAnswerOutstanding => false,
    AwaitedAnswerReceived { receipt: _ } => false,
    AwaitedAnswerRefused { receipt: _, cause: _ } => true,
  }
}

// Live consumption of the accessor: the wait arm yields one outcome, every other work kind yields
// none, so a non-wait step is never answered for rather than being given a default.
fn external_wait_outcomes(steps: List<OwnerStep>) -> List<ExternalWaitOutcome> {
  flat_map(steps, s =>
    match s.work {
      ExternalWaitWork { wait: w } => [external_wait_outcome(wait: w, progress: s.progress)],
      OperatorActionWork { intervention: _ } => [],
      DelegatedActionWork { instruction: _ } => [],
      OperatorDecisionWork { intervention: _, alternatives: _ } => [],
    }
  )
}

// THE ACCESSOR AND THE QUEUE MUST NOT DISAGREE. Both read the same progress, and this says so by
// execution: the number of waits the accessor calls outstanding equals the number of wait steps the
// step-level reader calls open. A future edit that taught one of them a different answer reds here.
fn wait_outcome_agrees_with_step_state(steps: List<OwnerStep>) -> Bool {
  count(filter(external_wait_outcomes(steps: steps), o => awaited_answer_is_outstanding(outcome: o)))
    == count(filter(steps, s => step_is_wait(step: s) && step_is_open(step: s)))
}

fn no_open_item_needs_decomposition(steps: List<OwnerStep>) -> Bool {
  count(filter(owner_queue(steps: steps), q => state_needs_decomposition(state: q))) == 0
}

// A PARENT OUTCOME CANNOT BE DONE WITHOUT ITS TERMINAL CHILD RECEIPTS. Parameterized on the item's
// doneness rather than reading it, because no subject item is Done today: over the live corpus this
// is true for an uninteresting reason, and a claim whose red is unauthorable is a decoration. The
// witness feeds it a fixture whose item IS done with an open step, and the red is real there.
fn done_item_requires_discharged_steps(item_done: Bool, item_steps: List<OwnerStep>) -> Bool {
  !item_done || count(filter(item_steps, s => !step_is_discharged(step: s))) == 0
}

fn owner_queue_size(steps: List<OwnerStep>) -> Int {
  count(filter(owner_queue(steps: steps), q => state_is_work(state: q)))
}

fn state_is_work(state: OwnerQueueState) -> Bool {
  match state {
    DoNow { step_id: _ } => true,
    StartExternalClock { step_id: _ } => true,
    Waiting { step_id: _, awaited_event: _, next_check: _ } => true,
    DelegateNow { step_id: _ } => true,
    Blocked { step_id: _, unmet: _ } => true,
    NeedsDecomposition { plan_item: _ } => true,
    ExposureIfTriggerSucceeds { trigger_item: _, curing_item: _ } => false,
    ExposureNowLive { trigger_item: _, curing_item: _ } => false,
  }
}

fn state_is_llc_if_m2_succeeds(state: OwnerQueueState) -> Bool {
  match state {
    DoNow { step_id: _ } => false,
    StartExternalClock { step_id: _ } => false,
    Waiting { step_id: _, awaited_event: _, next_check: _ } => false,
    DelegateNow { step_id: _ } => false,
    Blocked { step_id: _, unmet: _ } => false,
    NeedsDecomposition { plan_item: _ } => false,
    ExposureIfTriggerSucceeds { trigger_item, curing_item } =>
      trigger_item == "m2-customer-projections" && curing_item == "llc-publication-filing",
    ExposureNowLive { trigger_item, curing_item } => false,
  }
}

fn state_is_llc_live_after_m2(state: OwnerQueueState) -> Bool {
  match state {
    DoNow { step_id: _ } => false,
    StartExternalClock { step_id: _ } => false,
    Waiting { step_id: _, awaited_event: _, next_check: _ } => false,
    DelegateNow { step_id: _ } => false,
    Blocked { step_id: _, unmet: _ } => false,
    NeedsDecomposition { plan_item: _ } => false,
    ExposureIfTriggerSucceeds { trigger_item, curing_item } => false,
    ExposureNowLive { trigger_item, curing_item } =>
      trigger_item == "m2-customer-projections" && curing_item == "llc-publication-filing",
  }
}

fn queue_has_llc_if_m2(steps: List<OwnerStep>, items: List<PlanItem>) -> Bool {
  count(filter(owner_queue_over(steps: steps, items: items), s => state_is_llc_if_m2_succeeds(state: s))) == 1
}

fn queue_has_llc_live(steps: List<OwnerStep>, items: List<PlanItem>) -> Bool {
  count(filter(owner_queue_over(steps: steps, items: items), s => state_is_llc_live_after_m2(state: s))) == 1
}

fn live_owner_queue_shows_llc_exposure_while_filing_open() -> Bool {
  llc_exposure_activates_on_m2_success()
    && queue_has_llc_if_m2(steps: owner_steps, items: year_end_plan_items)
    && !queue_has_llc_live(steps: owner_steps, items: year_end_plan_items)
    && count(filter(owner_queue(steps: owner_steps), s => state_is_llc_if_m2_succeeds(state: s))) == 1
}

fn m2_done_shows_llc_exposure_live() -> Bool {
  let items = roster_with_item_done(
    items: year_end_plan_items,
    id: "m2-customer-projections",
    receipt: "fixture: trigger Done while the filing is still open",
  )
  queue_has_llc_live(steps: owner_steps, items: items)
    && !queue_has_llc_if_m2(steps: owner_steps, items: items)
}

fn filing_done_hides_llc_exposure_from_owner_queue() -> Bool {
  let items = roster_with_item_done(
    items: year_end_plan_items,
    id: "llc-publication-filing",
    receipt: "fixture: filing Done, so the exposure line must vanish",
  )
  !queue_has_llc_if_m2(steps: owner_steps, items: items)
    && !queue_has_llc_live(steps: owner_steps, items: items)
}

fn m2_success_opens_llc_court_exposure() -> Bool {
  live_owner_queue_shows_llc_exposure_while_filing_open()
    && m2_done_shows_llc_exposure_live()
    && filing_done_hides_llc_exposure_from_owner_queue()
}

fn owner_queue_size_excludes_exposures() -> Bool {
  owner_queue_size(steps: owner_steps) == count(filter(owner_queue(steps: owner_steps), q => state_is_work(state: q)))
    && owner_queue_size(steps: owner_steps) < count(owner_queue(steps: owner_steps))
}

fn states_for_item(item_id: NonEmptyStr, steps: List<OwnerStep>) -> List<OwnerQueueState> {
  item_queue_states(item_id: item_id, steps: steps)
}

// Fleet RAM remains an evidence frontier. Identity completeness alone never authorizes a buy:
// module/slot axes, serial conservation and feasible assignment still need their own receipts.
// #67 owns closing the live roster. Purchase counts cannot construct it.
type FleetCensusRoster
  = FleetRosterUnreconciled { gap: NonEmptyStr }
  | FleetRosterClosed { units: List<NonEmptyStr>, evidence: DeclarationRef }

// A CENSUS READING CARRIES THE LIMITS ITS AUTHOR STATED, AS TYPED ARMS A FOLD CAN READ. A limit
// that only lived as prose would be authored and never consumed; each arm here has a consequence
// that held_part_identity_standing derives from it. An empty list is a reading whose author
// stated none, which is a claim about the reading, not an absence of the field.
//   SoftwareJoinNoPhysicalRead -- slot identity is a join over software readings (SMBIOS prints
//     no J-number); nobody has read the silkscreen. Part numbers and serials are still the
//     machine's own report, so the reading can still identify held parts.
//   DescribesPriorPopulation -- the reading describes a population the unit no longer holds, so
//     it CANNOT stand for the unit's present held parts.
type CensusReadingLimit
  = SoftwareJoinNoPhysicalRead { detail: NonEmptyStr }
  | DescribesPriorPopulation { detail: NonEmptyStr }

type UnitCensusIdentity {
  unit: NonEmptyStr
  census: DeclarationRef
  limits: List<CensusReadingLimit>
}

// WHETHER A CENSUS CAN ESTABLISH A UNIT'S PRESENT HELD PARTS IS DECIDED BY ITS LIMITS, not by the
// row existing. A reading whose limits say it describes a prior population is consumed as exactly
// that -- not present state -- and the consequence is carried in words so the buyer sheet's
// held-part obligation prints what the census does and does not settle.
type HeldPartIdentityStanding
  = HeldPartsFromPresentCensus { unit: NonEmptyStr, census: DeclarationRef, join_caveat: NonEmptyStr? }
  | HeldPartsNotPresentState { unit: NonEmptyStr, census: DeclarationRef, why: NonEmptyStr }
  | HeldPartsUncensused

fn prior_population_limit(limits: List<CensusReadingLimit>) -> NonEmptyStr? {
  fold(limits, init: none, f: fn(acc, l) {
    match acc {
      Present { value: _ } => acc,
      Absent => match l { DescribesPriorPopulation { detail: d } => Present { value: d }  SoftwareJoinNoPhysicalRead { detail: _ } => none },
    }
  })
}

fn software_join_limit(limits: List<CensusReadingLimit>) -> NonEmptyStr? {
  fold(limits, init: none, f: fn(acc, l) {
    match acc {
      Present { value: _ } => acc,
      Absent => match l { SoftwareJoinNoPhysicalRead { detail: d } => Present { value: d }  DescribesPriorPopulation { detail: _ } => none },
    }
  })
}

fn held_part_identity_standing(reading: UnitCensusIdentity) -> HeldPartIdentityStanding {
  match prior_population_limit(limits: reading.limits) {
    Present { value: why } => HeldPartsNotPresentState { unit: reading.unit, census: reading.census, why: why },
    Absent => HeldPartsFromPresentCensus { unit: reading.unit, census: reading.census, join_caveat: software_join_limit(limits: reading.limits) },
  }
}

fn held_part_identity_text(standing: HeldPartIdentityStanding) -> String {
  match standing {
    HeldPartsFromPresentCensus { unit: u, census: c, join_caveat: caveat } =>
      u + "'s held parts are identified by its census " + (c.module_path as String) + " " + (c.decl_name as String)
        + (match caveat { Present { value: d } => " (slot identity caveat: " + (d as String) + ")"  Absent => "" }),
    HeldPartsNotPresentState { unit: u, census: c, why: w } =>
      u + "'s census " + (c.module_path as String) + " " + (c.decl_name as String) + " does NOT stand for its present held parts: " + (w as String),
    HeldPartsUncensused => "no unit census is read",
  }
}

// The held-part identity over a set of readings: the first reading's standing, or uncensused when
// there is none. One unit is read today; a multi-unit fleet answers per unit when the roster
// closes, and that change lands here once rather than in each consumer.
fn held_part_identity_of(readings: List<UnitCensusIdentity>) -> HeldPartIdentityStanding {
  match readings.first() {
    Present { value: r } => held_part_identity_standing(reading: r),
    Absent => HeldPartsUncensused,
  }
}

fn current_held_part_identity_standing() -> HeldPartIdentityStanding {
  held_part_identity_of(readings: ram_unit_censuses)
}

type IdentityIndex {
  ids: Map<NonEmptyStr, Bool>
  duplicate: Bool
}

fn census_identity_index(ids: List<NonEmptyStr>) -> IdentityIndex {
  fold(ids, init: IdentityIndex { ids: empty_map(), duplicate: false }, f: fn(acc, id) {
    IdentityIndex {
      ids: map_insert(acc.ids, id, true),
      duplicate: acc.duplicate || map_contains_key(acc.ids, id),
    }
  })
}

fn fleet_census_identities_complete(roster: FleetCensusRoster, readings: List<UnitCensusIdentity>) -> Bool {
  match roster {
    FleetRosterUnreconciled { gap: _ } => false,
    FleetRosterClosed { units: units, evidence: _ } => {
      let expected = census_identity_index(ids: units)
      let observed = census_identity_index(ids: map(readings, r => r.unit))
      count(units) > 0 && !expected.duplicate && !observed.duplicate
        && fold(units, init: true, f: fn(acc, id) { acc && map_contains_key(observed.ids, id) })
        && fold(readings, init: true, f: fn(acc, r) { acc && map_contains_key(expected.ids, r.unit) })
    },
  }
}

type RamPurchaseStanding
  = RamHeldCensusIdentityGap
  | RamHeldQualificationGap

// No relationship argument exists: commercial progress has no edge into the RAM decision.
fn ram_purchase_standing(roster: FleetCensusRoster, readings: List<UnitCensusIdentity>) -> RamPurchaseStanding {
  if fleet_census_identities_complete(roster: roster, readings: readings) {
    RamHeldQualificationGap
  } else {
    RamHeldCensusIdentityGap
  }
}

// ONE RENDERING OF THE STANDING, read by the relationship report below and by the buyer review
// sheet's wanted line (strategy.buyer_review_sheet imports this module; this module imports no
// buyer module). Both arms are HELD: neither establishes a fleet RAM quantity, so a consumer that
// prints a quantity under either arm is printing a number the standing does not carry.
fn ram_purchase_standing_text(s: RamPurchaseStanding) -> String {
  match s {
    RamHeldCensusIdentityGap => "HELD: census identities incomplete or duplicated",
    RamHeldQualificationGap => "HELD: exact module axes, serial conservation and feasible assignment unproved",
  }
}

// The standing as the live roster and censuses read today.
fn current_ram_purchase_standing() -> RamPurchaseStanding {
  ram_purchase_standing(roster: ram_fleet_roster, readings: ram_unit_censuses)
}

data ram_fleet_roster: FleetCensusRoster = FleetRosterUnreconciled {
  gap: "One held pilot plus 20 inbound units conflicts with the unit-1-of-20 handoff. #67 must reconcile exact identities; no 19-remaining or fleet RAM quantity is established.",
}

// UNIT 1 IS CENSUSED; THE ROSTER IS NOT RECONCILED, AND THE FOLD -- NOT THIS ROW -- DECIDES THE
// STANDING. The reading is the public per-slot census (gunbc#10965), carrying its author's two
// limits verbatim. ram_fleet_roster stays FleetRosterUnreconciled, so fleet_census_identities_complete
// still answers false and ram_purchase_standing still reads RamHeldCensusIdentityGap: one censused
// unit against an unreconciled roster is not identity completeness.
data mtcollins1_unit_census: UnitCensusIdentity = UnitCensusIdentity {
  unit: "mt-collins-1",
  census: decl_ref(module_path: "gunbc.machine_intake_mtcollins1_memory_census_observation", decl_name: "mtcollins1_slots"),
  limits: [
    SoftwareJoinNoPhysicalRead { detail: "it is a join over software readings (SMBIOS prints no J-number; nobody has read the silkscreen)" },
    DescribesPriorPopulation { detail: "it describes the ORIGINAL 16-module population, which is NOT what unit 1 holds now (eight 64 GB modules in socket 0 as of 2026-09-12)" },
  ],
}

data ram_unit_censuses: List<UnitCensusIdentity> = [mtcollins1_unit_census]

type RelationshipPreparation {
  unserved: List<RelationshipConsumer>
  ram: RamPurchaseStanding
}

fn assess_relationship_preparation(relationships: List<VendorRelationship>, roster: FleetCensusRoster,
  readings: List<UnitCensusIdentity>) -> RelationshipPreparation {
  RelationshipPreparation {
    unserved: filter(relationship_consumers, c => !consumer_is_served(consumer: c, relationships: relationships)),
    ram: ram_purchase_standing(roster: roster, readings: readings),
  }
}

// Executed planning projection; witnesses call the same projection with controlled inputs.
fn relationship_preparation_report(relationships: List<VendorRelationship>, roster: FleetCensusRoster,
  readings: List<UnitCensusIdentity>, outreach: RelationshipOutreach) -> String {
  let assessment = assess_relationship_preparation(relationships: relationships, roster: roster, readings: readings)
  let unmet = count(assessment.unserved)
  let ram = ram_purchase_standing_text(s: assessment.ram) + "; " + held_part_identity_text(standing: held_part_identity_of(readings: readings))
  let contact = match outreach {
    RelationshipOutreachUnsent { unsent } =>
      unsent.support_context + "; Outreach draft: " + unsent.intervention.instruction + "; unsent asks: " + join(unsent_ask_ids(asks: unsent.asks), ", "),
    RelationshipOutreachSent { enquiry: e, preparation: _, transcription: _, asks: asks } =>
      e.request_id + ": carried " + to_string(count(asks) - count(unsent_ask_ids(asks: asks))) + " of " + to_string(count(asks)) + " prepared asks; unsent: " + join(unsent_ask_ids(asks: asks), ", "),
    RelationshipOutreachAnswered { enquiry: _, reply: r, preparation: _, transcription: _, asks: _ } => r.leaves_open,
  }
  let collateral = match ampere_restricted_collateral_source() {
    ReferenceBoardCollateralAvailable => "public producer reports collateral available",
    ReferenceBoardCollateralUnderNda { subject: subject, access_route: _ } => subject,
  }
  let ocp = ocp_rank_cell_read()
  let source = if ocp_rank_cell_was_read(outcome: ocp) {
    if ocp_rank_question_answered(outcome: ocp) { "OCP rank cell answered" } else { "OCP rank cell read; answer TBD" }
  } else { "OCP rank cell read refused" }
  ram + "; collateral subject=" + collateral + "; " + source + "; unmet relationship requirements=" + to_string(unmet) + "; " + contact
}

fn ampere_relationship_preparation() -> String {
  relationship_preparation_report(relationships: vendor_relationships, roster: ram_fleet_roster,
    readings: ram_unit_censuses, outreach: ampere_relationship_outreach)
}
