// THE OPEN OPERATOR DECISION UNDER AN AGENT ITEM. boot-minimum is AgentParallel, and its reset
// receipt has never executed for a reason no agent can clear: the credential the converge path
// would use is not pinned. The two arms are genuinely different in kind -- one buys a modeled
// provisioning path, the other accepts a human step on every provision.
// DECIDED BY CONSTRUCTION AND NOW RECORDED (hw-first-host lane, 2026-09-17). The first alternative
// is the one that exists: the credential is pinned in fleet secret custody at a fixed version and
// the runner fetches it over workload identity federation with a converged accessor grant, so the
// converge path already obtains it without a human at the keyboard. The burden the choice accepts
// is therefore the custody one -- a secret with a version that has to be rotated and re-granted --
// and NOT the per-provision human entry the second alternative priced.
//
// THE DECISION WAS TAKEN IN THE PUBLIC CORPUS AND IS ONLY BEING WRITTEN DOWN HERE, which is why the
// receipt is a CorpusDeclaration rather than a merged PR of this repo: the evidence is the
// declaration that pins the reference, and a reader re-derives the state by resolving it rather
// than by trusting this sentence.
data receipt_boot_minimum_bmc_credential: ActionReceipt = ActionReceipt {
  receipt_id: "boot-minimum-bmc-credential-decided",
  evidence: CorpusDeclaration {
    declaration: decl_ref(module_path: "gunbc.secret_provision", decl_name: "mtcollins1_bmc_gunbc_secret_ref"),
  },
}

data step_boot_minimum_bmc_credential: OwnerStep = OwnerStep {
  step_id: "boot-minimum-bmc-credential",
  plan_item: "boot-minimum",
  work: OperatorDecisionWork {
    intervention: discharged_operator_intervention(
      identity: "boot-minimum-bmc-credential",
      subject: "BMC credential reachable from fleet converge",
      instruction: "Decide how the converge path obtains the BMC credential, and record the choice with the burden it accepts. DECIDED: pin the credential in fleet secret custody at a fixed version -- gunbc.secret_provision mtcollins1_bmc_gunbc_secret_ref, secret bmc-mtcollins1-gunbc at version 2, fetched by the runner over WIF with the accessor grant converged 2026-09-17. The second arm, operator entry on every converge run, is NOT taken.",
      receipt_declaration: "receipt_boot_minimum_bmc_credential",
    ),
    alternatives: [
      DecisionAlternative {
        label: "pin the credential in fleet secret custody at a fixed version",
        evidence: decl_ref(module_path: "gunbc.secret_provision", decl_name: "secret_provision_intervention"),
      },
      DecisionAlternative {
        label: "operator enters the credential on each converge run",
        evidence: decl_ref(module_path: "std.human_intervention", decl_name: "compare_routine_human_burden"),
      },
    ],
  },
  start_requirements: no_requirements,
  produces_receipt: "boot-minimum-bmc-credential-decided",
  progress: StepDischarged { receipt: receipt_boot_minimum_bmc_credential },
}

