// ---------------------------------------------------------------------------------------------
// Relationship capabilities are independent observations. Neither an NDA transaction nor a
// commercial contact can manufacture access to a different subject. Evidence authenticity stays
// an external boundary; these projections establish no stronger rung than executed validation.
type CapabilityEvidence
  = CapabilityUnestablished { gap: NonEmptyStr }
  | CapabilityObserved { receipt: ActionReceipt }

type RestrictedCollateralCapability {
  subject: DeclarationRef
  evidence: CapabilityEvidence
}

type RelationshipStanding {
  restricted_collateral: RestrictedCollateralCapability
  named_contact: CapabilityEvidence
  design_engagement: CapabilityEvidence
  firmware_images: CapabilityEvidence
}

type RelationshipRequirement
  = RestrictedCollateral { subject: DeclarationRef }
  | NamedAccountContact
  | DesignEngagement
  | FirmwareImages

fn capability_observed(evidence: CapabilityEvidence) -> Bool {
  match evidence {
    CapabilityUnestablished { gap: _ } => false,
    CapabilityObserved { receipt: _ } => true,
  }
}

fn standing_serves(standing: RelationshipStanding, needs: RelationshipRequirement) -> Bool {
  capability_observed(evidence: match needs {
    RestrictedCollateral { subject: subject } =>
      if declaration_ref_eq(a: subject, b: standing.restricted_collateral.subject) {
        standing.restricted_collateral.evidence
      } else { CapabilityUnestablished { gap: "The requested collateral subject differs from the observed one." } },
    NamedAccountContact => standing.named_contact,
    DesignEngagement => standing.design_engagement,
    FirmwareImages => standing.firmware_images,
  })
}

type ObligationHorizon = HorizonTriggeredBy { event: NonEmptyStr }
type ObligationCoverage
  = CoveredBy { mechanism: NonEmptyStr, failure_modes: List<NonEmptyStr> }
  | NotCovered { reason: NonEmptyStr }

type VendorRelationship {
  identity: NonEmptyStr
  subject: DeclarationRef
  standing: RelationshipStanding
  raising_routes: List<NonEmptyStr>
  absence_cost_drivers: List<NonEmptyStr>
  ruling: NonEmptyStr
  horizon: ObligationHorizon
  current_coverage: ObligationCoverage
}

type RelationshipConsumer {
  consumer: NonEmptyStr
  relationship: DeclarationRef
  needs: RelationshipRequirement
}

type ExcludedConsumer {
  consumer: NonEmptyStr
  relationship: DeclarationRef
  reason: NonEmptyStr
}

