data step_wholesale_pilot_order_wait: OwnerStep = OwnerStep {
  step_id: "wholesale-pilot-order-wait",
  plan_item: "wholesale-pilot-order-execution",
  work: ExternalWaitWork {
    wait: ExternalWait {
      partial_answers: [],
