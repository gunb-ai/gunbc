data step_colo_responses_wait: OwnerStep = OwnerStep {
  step_id: "colo-responses-wait",
  plan_item: "colo-rfq",
  work: ExternalWaitWork {
    wait: ExternalWait {
      partial_answers: [],
      awaited_event: "colocation RFQ responses",
      blocks: ["colo-rfq"],
      window: OperatorFollowUp {
        next_check: "two weeks after the RFQ is issued",
        basis: "the candidates publish no quote turnaround; relative to dispatch until dispatch happens.",
      },
      fallback: NoFallbackDeclared {
        reason: "a non-responding candidate is dropped from the comparison rather than replaced by a different arm; the RFQ goes to several candidates for exactly that reason.",
      },
      reference: SentWithoutReference {
        authority: "DataBank (LGA4 and LGA3 Orangeburg), Iron Mountain (NJE-1 Edison), Netrality (401 N Broad), Digital Fortress (Piscataway)",
        sent_at: "2026-09-14",
        note: "Submitted through each operator's web inquiry form; the forms issue no ticket identifier. Five submissions, one ask sheet (strategy.wholesale_batch_floor rfq_asks). AT 2026-09-17 the field is three populations and the counts are derived, not narrated: one refusal (Digital Fortress Piscataway, 2026-09-16), one non-quoting answer (Netrality's 28-day lead time), three silent (DataBank LGA4, DataBank LGA3, Iron Mountain NJE-1) -- strategy.wholesale_batch_floor declined_facility_count, responded_facility_count and silent_facility_count. A refusal is not the silence this wait's fallback drops: it will not arrive later. THIS WAIT NO LONGER BLOCKS ANYTHING AT YEAR END (q2_colo_recut_ruling): colo-rfq is anchored at M5Q2ColoDeployment, so a response that arrives is Q2 evidence gathered early rather than a year-end dependency, and nobody is waiting on it. The 2026-09-28 check is retired with the chase.",
      },
    },
  },
  start_requirements: [AfterStep { step_id: "colo-rfq-issue" }],
  produces_receipt: "colo-rfq-responses",
  progress: StepOpen,
}

// THE COLO FORMS ISSUED NO TICKET, SO THE FIRST HUMAN FOLLOW-UP IS A STEP, NOT THE TWO-WEEK CHECK
// (audit folded 2026-09-14): a named sales engineer and an opportunity reference from each of the
// five within three business days, and the addendum the eight-line form ask left out.
data step_colo_named_owner_follow_up: OwnerStep = OwnerStep {
  step_id: "colo-named-owner-follow-up",
  plan_item: "colo-rfq",
  work: OperatorActionWork {
    intervention: open_operator_intervention(
      identity: "colo-named-owner-follow-up",
      subject: "five colocation inquiries with no reference",
      instruction: "RE-CUT 2026-09-17 BY THE Q2 RULING (strategy.year_end_plan q2_colo_recut_ruling): the colo deployment is a Q2 2027 target and the operator ruled the colo field is not to be chased, so this step is no longer a three-facility pursuit. WHAT REMAINS IS THE CHEAP HALF, and it is cheap because the counterparty already wrote to us: send the RFQ addendum (strategy.wholesale_batch_floor rfq_addendum_asks) to Ammar Petiwala at Netrality, who asked for our requirements in writing. It costs one email, it answers the questions a Q2 quote will need anyway, and it leaves a named relationship warm at the one facility that engaged. WHAT IS DROPPED: chasing names at DataBank (Orangeburg LGA4 and LGA3) and Iron Mountain NJE-1. They were silent at three days and they are welcome to answer the form submission whenever they like -- an answer that arrives is recorded (strategy.wholesale_batch_floor facility_responses); an answer that never arrives costs nothing now. THE 2026-09-28 ESCALATION IS RETIRED with the chase, not carried forward, because an escalation nobody intends to perform is a calendar entry pretending to be a plan.",
    ),
  },
  start_requirements: [AfterStep { step_id: "colo-rfq-issue" }],
  produces_receipt: "colo-named-owners",
  progress: StepOpen,
}

// THE SITE VISIT STEP IS WITHDRAWN, NOT DISCHARGED (2026-09-17). It was added earlier the same day
// against Netrality's tour invitation, and the Q2 ruling (strategy.year_end_plan
// q2_colo_recut_ruling) declined the visit hours later. It is REMOVED rather than discharged
// because receipts_match_promise is right to refuse the alternative: the step promised
// colo-netrality-site-visit-notes, no visit happened, and a discharge carrying a "declined"
// receipt would have rewritten the promise to fit the outcome -- which is the one edit that check
// exists to stop. There is also no withdrawn-by-us arm on StepProgress, and inventing one for a
// step that lived half a day would be a vocabulary nobody else needs.
//
// THE FACT IS NOT LOST, it is filed where it belongs: the invitation and our declination are a
// property of the Netrality RELATIONSHIP, not of a queue step, so they live on
// strategy.wholesale_batch_floor netrality_visit_invitation, which a Q2 re-approach reads.

// PROVIDER DISCOVERY, DISPATCHED NOW. It does not wait on fleet-capacity-floor: its purpose is to
// learn the facts that decide the BOM, and a price is not asked. Shape as counsel-market-census: an
// approval, a dispatch, an external clock, a delegated reduction.
data receipt_wholesale_discovery_approved: ActionReceipt = ActionReceipt {
  receipt_id: "wholesale-discovery-packet-approved",
  evidence: ObservedFact {
    subject: "provider discovery message",
    observation: "The operator wrote and sent the note personally on 2026-09-15 (the sent text is strategy.wholesale_batch_floor discovery_message); approval and dispatch are one act by the same hand.",
    observed_at: "2026-09-15",
  },
}

data receipt_wholesale_discovery_sent_ubicloud: ActionReceipt = ActionReceipt {
  receipt_id: "wholesale-discovery-sent-ubicloud",
  evidence: ExternalRequestSent {
    recipient: "Ubicloud, info@ubicloud.com (the general inbox, not a founder), from briansrls@gunb.ai, subject 'Gunbai x Ubicloud'",
    sent_at: "2026-09-15",
  },
}

data step_wholesale_discovery_packet_approval: OwnerStep = OwnerStep {
  step_id: "wholesale-discovery-packet-approval",
  plan_item: "wholesale-requirements-discovery",
  work: OperatorActionWork {
    intervention: discharged_operator_intervention(
      identity: "wholesale-discovery-packet-approval",
      subject: "provider discovery message",
      instruction: "Approve the discovery message in strategy.wholesale_batch_floor discovery_message. THIS STEP DESCRIBES THE TEXT THAT WAS ACTUALLY SENT (Codex review, PR #136: an earlier cut of this instruction described a richer drafted packet - founding-design-partner standing, a thirty-minute ask, the integration-boundary menu - that the operator did not send, so a discharged approval recorded approval of content nobody dispatched). What went out, six sentences: gunb.ai is primarily a language and compiler project and is beginning to build Arm supply on the US East Coast; a belief that the two projects' goals align strongly, and a proposal of a relationship benefiting both; the initial deployment - about twenty dual-socket Q80-30 Ampere servers, 3,200 cores, about 10 TiB of memory, targeting early 2027, focused on cost and energy efficiency, which is why Arm; an offer to collaborate on interfaces or requirements at any layer of the stack, the root project being software-driven; and an open invitation to reply. The drafted alternatives that were NOT sent - founding-design-partner standing, the four integration boundaries, the constraint list, a thirty-minute ask - are in this file's history and remain available for the call and for the Blacksmith and peer notes. It carries NO price and never the word oversubscription (operator ruling 2026-09-14), and represents no reliability, no committed site and no committed date.",
      receipt_declaration: "receipt_wholesale_discovery_approved",
    ),
  },
  start_requirements: no_requirements,
  produces_receipt: "wholesale-discovery-packet-approved",
  progress: StepDischarged { receipt: receipt_wholesale_discovery_approved },
}

// UBICLOUD IS SENT; BLACKSMITH AND THE PEER ARE NOT (2026-09-15). One dispatch per provider, so
// the wait clock starts from the first real send and the exit criterion's third contact stays a
// visible open step rather than a fraction of a discharged one.
data step_wholesale_discovery_dispatch: OwnerStep = OwnerStep {
  step_id: "wholesale-discovery-dispatch",
  plan_item: "wholesale-requirements-discovery",
  work: OperatorActionWork {
    intervention: discharged_operator_intervention(
      identity: "wholesale-discovery-dispatch",
      subject: "Ubicloud",
      instruction: "Send the discovery note to Ubicloud: the company, the initial deployment (~20 dual-socket Q80-30, 3,200 cores, ~10 TiB, early 2027, cost and energy efficiency), the alignment, and an open offer to collaborate on interfaces or requirements at any layer. No price, no unit, no boundary.",
      receipt_declaration: "receipt_wholesale_discovery_sent_ubicloud",
    ),
  },
  start_requirements: [AfterStep { step_id: "wholesale-discovery-packet-approval" }],
  produces_receipt: "wholesale-discovery-sent-ubicloud",
  progress: StepDischarged { receipt: receipt_wholesale_discovery_sent_ubicloud },
}

// FOUNDER FOLLOW-UP FIRST, OTHER PROVIDERS SECOND (operator ruling 2026-09-17). The 09-15 note went
// to a general inbox; the operator's order is a direct note to the Ubicloud founders by name, and
// only then the other providers. The backup if every provider declines or stays silent is not
// another note: it is selling the same capacity under list, which strategy.demand_utilization
// prices (every candidate point above the site floor at every grid point) and which the wait's
// fallback below now names rather than leaving as NoFallbackDeclared.
//
// TWO DISCHARGE PATHS, BECAUSE AfterStep HAS NO NOT-APPLICABLE ARM (review repair, P1). This step's
// purpose is a Ubicloud contact that draws a reply, not the founder note as such. It discharges
// EITHER with an ExternalRequestSent receipt (the founder note went out) OR with an ObservedFact
// receipt recording that Ubicloud replied to the 09-15 note before a follow-up was needed. On the
// second path no note is sent and the step is discharged by the reply itself, so the providers
// behind it are never blocked on a message the condition says not to send.
data step_wholesale_discovery_founder_follow_up: OwnerStep = OwnerStep {
  step_id: "wholesale-discovery-founder-follow-up",
  plan_item: "wholesale-requirements-discovery",
  work: OperatorActionWork {
    intervention: open_operator_intervention(
      identity: "wholesale-discovery-founder-follow-up",
      subject: "Ubicloud founders, by name (Ozgun Erdogan; Umur Cubukcu and Daniel Farina as co-founders)",
      instruction: "IF the 2026-09-15 note to info@ubicloud.com has drawn no reply by 2026-09-22 (or sooner at the operator's discretion): send a short direct note to the founders by name referencing that note -- the deployment, the alignment, the offer to collaborate at any layer, the ask for a reply -- and discharge this step with an ExternalRequestSent receipt. IF Ubicloud replies to the 09-15 note BEFORE that: send nothing and discharge this step with an ObservedFact receipt recording the reply and its date. Either path is a discharge; the other providers (wholesale-discovery-dispatch-others) start after it, not beside it.",
    ),
  },
  start_requirements: [AfterStep { step_id: "wholesale-discovery-dispatch" }],
  produces_receipt: "wholesale-discovery-ubicloud-contact-resolved",
  progress: StepOpen,
}

data step_wholesale_discovery_dispatch_others: OwnerStep = OwnerStep {
  step_id: "wholesale-discovery-dispatch-others",
  plan_item: "wholesale-requirements-discovery",
  work: OperatorActionWork {
    intervention: open_operator_intervention(
      identity: "wholesale-discovery-dispatch-others",
      subject: "Blacksmith, Depot, and any other listed provider",
      instruction: "AFTER the founder follow-up (operator order 2026-09-17): send the same note, adapted to each, to Blacksmith, Depot and the other providers on the list, so one silence does not empty the field (the item asks for three providers). Prefer a named person over a general inbox.",
    ),
  },
  start_requirements: [AfterStep { step_id: "wholesale-discovery-founder-follow-up" }],
  produces_receipt: "wholesale-discovery-sent-others",
  progress: StepOpen,
}

data step_wholesale_discovery_wait: OwnerStep = OwnerStep {
  step_id: "wholesale-discovery-wait",
  plan_item: "wholesale-requirements-discovery",
  work: ExternalWaitWork {
    wait: ExternalWait {
      partial_answers: [],
      awaited_event: "requirements profiles or explicit refusals from at least three providers",
      blocks: ["wholesale-requirements-discovery"],
      window: OperatorFollowUp {
        next_check: "2026-09-22",
        basis: "one week after the Ubicloud send of 2026-09-15; no provider publishes a partnership response time. A general inbox was used, so if there is no reply by then, the follow-up goes to a founder (Ozgun Erdogan) by name rather than a second note to info@.",
      },
      fallback: DeclaredFallback {
        on_or_after: "2026-10-15",
        alternatives: [
          "Sell the same capacity directly under Ubicloud's list (operator 2026-09-17: 'at the worst, I have to undercut them'). strategy.demand_utilization prices it: every candidate point from 320 to 1,000 micro per 2-vCPU-minute sits above the site floor at every grid point, and the eight unpriced rows are what a price has to carry. Target a couple of small-to-medium customers by 2027-01, not a fleet fill.",
          "Host from home across several circuits and arbitrage against AWS, Hetzner and peers for overflow (operator 2026-09-17), with the ordered servers idle until a buyer or the direct product needs them.",
        ],
      },
      reference: SentWithoutReference {
        authority: "Ubicloud, info@ubicloud.com",
        sent_at: "2026-09-15",
        note: "An email to a general inbox issues no ticket or reference; Blacksmith and the peer are not yet sent (wholesale-discovery-dispatch-others).",
      },
    },
  },
  start_requirements: [AfterStep { step_id: "wholesale-discovery-dispatch" }],
  produces_receipt: "wholesale-discovery-responses",
  progress: StepOpen,
}

data step_wholesale_discovery_profile: OwnerStep = OwnerStep {
  step_id: "wholesale-discovery-profile",
  plan_item: "wholesale-requirements-discovery",
  work: DelegatedActionWork {
    instruction: "Reduce the responses to one typed provider integration profile per buyer - boundary, RAM and speed, storage and endurance, NIC and transit (per-node and aggregate bandwidth, burst pattern, latency sensitivity), IP and BGP, OOB and reinstall, Arm-only or an x86 ratio, minimum volume and ramp, maintenance and replacement, onboarding and security, term and economic range - as rows beside strategy.wholesale_buyer, without selecting a boundary.",
  },
