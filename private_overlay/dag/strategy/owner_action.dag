  produces_receipt: "wholesale-provider-profiles",
  progress: StepOpen,
}

// THE WHOLESALE OPERATOR RULINGS AS LEAVES (third audit folded 2026-09-14): a plan outcome is not
// "what should Brian do next". Implementation is AgentParallel elsewhere; only the commercial, risk
// and architecture rulings are the operator's, and each ExternalLead item splits dispatch from wait.
data step_wholesale_boundary_selection: OwnerStep = OwnerStep {
  step_id: "wholesale-boundary-selection",
  plan_item: "wholesale-service-boundary",
  work: OperatorDecisionWork {
    intervention: open_operator_intervention(
      identity: "wholesale-boundary-selection",
      subject: "service boundary for the first buyer",
      instruction: "On the reduced provider profiles, select raw bare metal, managed substrate or managed fabric capacity for the named buyer, or record Unresolved with the missing fact.",
    ),
    alternatives: [
      DecisionAlternative { label: "raw bare metal: buyer owns boot, storage and software plane", evidence: decl_ref(module_path: "strategy.wholesale_batch_floor", decl_name: "realization_buyer_own_plane") },
      DecisionAlternative { label: "managed substrate: GUNBAI owns host OS and staging; whether any cache exists is selected later by wholesale-network-decision", evidence: decl_ref(module_path: "strategy.wholesale_batch_floor", decl_name: "cache_realization") },
      DecisionAlternative { label: "managed fabric capacity: the buyer consumes a logical capacity envelope through the provider interface (capacity API, its agent on our capacity, or a logical host pool); GUNBAI owns placement and failure (the operator's stated preference, 2026-09-14)", evidence: decl_ref(module_path: "strategy.wholesale_batch_floor", decl_name: "fabric_capacity_contract") },
      DecisionAlternative { label: "Unresolved: the profile lacks the fact that decides it; the missing fact is written into selected_boundary's obligation", evidence: decl_ref(module_path: "strategy.wholesale_batch_floor", decl_name: "selected_boundary") },
    ],
  },
  start_requirements: [AfterStep { step_id: "wholesale-discovery-profile" }],
  produces_receipt: "wholesale-boundary-selected",
  progress: StepOpen,
}

data step_wholesale_network_cache_authorization: OwnerStep = OwnerStep {
  step_id: "wholesale-network-cache-authorization",
  plan_item: "wholesale-network-decision",
  work: OperatorActionWork {
    intervention: open_operator_intervention(
      identity: "wholesale-network-cache-authorization",
      subject: "network and cache experiment",
      instruction: "Authorize the candidate points and the measurement plan in wholesale-network-cache-experiment. Whether a 10 GbE sample card is bought is a separate ruling recorded in wholesale_batch_floor sample_card: declining it leaves the 10 GbE points NotRunNotRequired and does not block the 1 GbE disposition.",
    ),
  },
  start_requirements: [AfterStep { step_id: "wholesale-boundary-selection" }],
  produces_receipt: "wholesale-network-cache-experiment-authorized",
  progress: StepOpen,
}

