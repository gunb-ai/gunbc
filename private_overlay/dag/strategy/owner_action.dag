    ),
    alternatives: [
      DecisionAlternative { label: "OfferAccepted: the buyer accepts a named tier revision; the pilot order and provider integration may start", evidence: decl_ref(module_path: "strategy.wholesale_batch_floor", decl_name: "offer_disposition") },
      DecisionAlternative { label: "OfferDeclined: recorded with the reason; the wholesale path for this buyer stops", evidence: decl_ref(module_path: "strategy.wholesale_batch_floor", decl_name: "offer_disposition") },
      DecisionAlternative { label: "OfferUnresolved: no written answer yet; the outstanding question is named", evidence: decl_ref(module_path: "strategy.wholesale_batch_floor", decl_name: "offer_disposition") },
    ],
  },
  start_requirements: [AfterPlanItem { item_id: "wholesale-supply-channel" }],
