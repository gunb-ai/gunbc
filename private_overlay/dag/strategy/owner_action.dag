// THE ORDERING GATE STANDS AND ITS REASON CHANGED. The first revision made the dispatch depend on
// identifying a SECOND CPA, and the operator read that and asked who the first one is. There is no
// first: no accountant is named anywhere in this repository, and gunbai_llc says only "Determine,
// WITH A CPA, the date". So the wording implied an engagement that does not exist and read as
// further along than the state -- the same class as a receipt minted from a command, and the reason
// the fix is a rewording rather than a deletion.
//
// What the gate now requires is that the DEFAULT ARM be declared, which is a different and better
// question than whether a second name exists: the fallback is SELF-FILE, it is available today, and
// it needs no identification. A sentence in a row is not a firing mechanism
// (gunbc.recurring_failure_mode a_written_row_is_not_a_firing_mechanism), so the arm is a discharged
// step the dispatch depends on rather than a claim in prose.
data receipt_cpa_filing_arm_declared: ActionReceipt = ActionReceipt {
  receipt_id: "cpa-filing-arm-declared",
  evidence: ObservedFact {
    subject: "the 2026 tax year filing arm",
    observation: "Operator ruling: self-file is the preferred arm -- they have self-filed small business taxes before -- with a CPA engaged only as a BOUNDED EXTERNAL INTERPRETATION of the one question that cannot be self-issued, the active-trade-or-business commencement date, which gunbai_llc already says belongs to a CPA reading the actual activity. That is one determination, not an engagement to prepare a return.",
    observed_at: "2026-09-11",
  },
}

data step_cpa_filing_arm_declared: OwnerStep = OwnerStep {
  step_id: "cpa-filing-arm-declared",
  plan_item: "cpa-commencement-determination",
  work: OperatorActionWork {
    intervention: discharged_operator_intervention(
      identity: "cpa-filing-arm-declared",
      subject: "the 2026 tax year filing arm",
      instruction: "Declare which arm the filing takes, so the bounded CPA question is dispatched against a decided default rather than into an open engagement.",
      receipt_declaration: "receipt_cpa_filing_arm_declared",
    ),
  },
  start_requirements: no_requirements,
  produces_receipt: "cpa-filing-arm-declared",
  progress: StepDischarged { receipt: receipt_cpa_filing_arm_declared },
}

data step_cpa_engagement_dispatch: OwnerStep = OwnerStep {
  step_id: "cpa-engagement-dispatch",
  plan_item: "cpa-commencement-determination",
  work: OperatorActionWork {
    intervention: open_operator_intervention(
      identity: "cpa-engagement-dispatch",
      subject: "CPA commencement determination",
      instruction: "Commission a BOUNDED determination of the active-trade-or-business commencement date -- one question, not a return engagement -- with the facts it must rest on: formation, first expenditures, first revenue-seeking activity, and the equipment acquisition dates. AT STAKE -- NO TOTAL IS STATED HERE, AND THAT IS THE POINT (withdrawn 2026-09-17, corrected again after review 67392). This sentence carried a roughly-65-thousand hardware-basis figure as uncited prose with no producer. The first correction replaced it with three more uncited figures, which reproduced the defect in the other direction and put them in the text dispatched to a CPA. What each leg actually stands on: THE SERVERS ARE DERIVABLE -- strategy.ci_node_build mt_collins_system_lot records twenty units at 1,700 dollars pre-tax plus about 75 per unit freight, which is 35,500 pre-tax, and the operator stated about 40,000 on 2026-09-17, a figure CONSISTENT with that receipt once New York sales tax is applied rather than in conflict with it. THE SPARKS ARE NOT DERIVABLE AT ALL: no Spark purchase record exists anywhere in the corpus, so no Spark figure is carried here, and the operator statement of about 35,000 on the same date is operator testimony awaiting a receipt rather than a corpus fact. THE READ OBLIGATION IS THEREFORE ONE DOCUMENT: the Spark invoice. Until it lands, this instruction supplies the CPA with the derivable server figure and its producer, names the Spark leg as unpriced, and QUOTES NO TOTAL -- a total assembled from one receipt and one recollection would be exactly the kind of number this row exists to stop carrying. The treatment of resale receipts turn on the answer, and gunbai_llc gates equipment cost recovery on it and refuses by default. The operator has ruled it non-urgent anyway, because a determination needed at filing time is not needed now.",
    ),
  },
  start_requirements: [
    AfterStep { step_id: "cpa-filing-arm-declared" },
    AfterCalendarDate {
      on_or_after: "2027-01-15",
      basis: "Operator ruling 2026-09-11: not urgent, due by tax time -- the 2027 filing season for tax year 2026. A determination needed at filing time is not needed in September, and a queue that offers it now manufactures an urgency the ruling removed. The 21 days the plan row carries was never wrong as a DURATION; it was wrong as a deadline.",
    },
  ],
  produces_receipt: "cpa-request-sent",
  progress: StepOpen,
}

data step_cpa_determination_wait: OwnerStep = OwnerStep {
  step_id: "cpa-determination-wait",
  plan_item: "cpa-commencement-determination",
  work: ExternalWaitWork {
    wait: ExternalWait {
      partial_answers: [],
      awaited_event: "written CPA determination of the active-trade-or-business commencement date",
      blocks: ["cpa-commencement-determination"],
      window: OperatorFollowUp {
        next_check: "two weeks after the request is sent, which is not before the 2027 filing season",
        basis: "no engagement exists yet, so no turnaround has been quoted; the check is relative to dispatch, and dispatch itself is not offerable before tax time.",
      },
      fallback: DeclaredFallback {
        on_or_after: "the filing deadline for tax year 2026",
        alternatives: ["self-file taking the position gunbai_llc already defaults to -- equipment cost recovery refused for want of a determination -- and document the position taken. This is available today, needs no identification, and is why the dispatch gate is about which arm is taken rather than about finding a second name."],
      },
      reference: RequestNotYetSent,
    },
  },
  start_requirements: [AfterStep { step_id: "cpa-engagement-dispatch" }],
  produces_receipt: "cpa-determination",
  progress: StepOpen,
}

