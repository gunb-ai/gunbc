import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import strategy.calendar_date { CalendarDate }
import strategy.ci_node_build {
  SupplyDepth, DepthObserved, DepthAvailableUncounted, DepthScarce,
  DomesticRoute, ImportRoute, RouteUnread,
  altra_q80_lot, asrock_board_facts,
}
import strategy.asset_lifecycle { hold_q80_lot, hold_asrock_boards, q80_original_deploy_target, q80_ruled_deploy_target }
