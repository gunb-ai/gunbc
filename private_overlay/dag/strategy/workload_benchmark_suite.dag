fn selected_workloads() -> List<WorkloadCandidate> {
  filter(workload_census, c => candidate_is_selected(c: c))
}

// THE ADMITTED SET IS NARROWER THAN THE SELECTED SET, AND THAT IS THE POINT. A workload is
// admitted for a CORRECTNESS comparison only if it has a real baseline; OpenObserve is selected
// and not admitted, so the head-to-head may time it and may not report it as a pass.
fn correctness_admitted_workloads() -> List<WorkloadCandidate> {
  filter(selected_workloads(), c => baseline_is_admitted(b: candidate_baseline(c: c)))
}

data census_scope_note: NonEmptyStr = "read-only inspection of public workflow files and public run metadata. No maintainer was contacted, no repository was scraped beyond its workflow directory, no outreach list was produced, and no pull request was opened against any inspected repository. Nothing here qualifies a customer or authorizes an approach."

// =====================================================================================
// THE THIRD-PARTY CI SPEND SCREEN.
//
// A SEPARATE QUESTION FROM SELECTION, AND IT DOES NOT QUALIFY ANYONE. This tells the operator
// which of these repositories has a real CI bill. A benchmark target is not a lead, and a bill is
// not a lead either: census_outreach_admission still refuses, and nothing below changes that.
//
// WHY A CEILING RATHER THAN A PLAN. Determining anyone's actual plan needs an account we do not
// have and a question we may not ask. The screen instead takes the most generous free allowance
// the repository could conceivably hold and asks whether measured consumption EXCEEDS it.
// Consumption above the ceiling proves spend whatever the tier. Consumption below it proves
// NOTHING - and "nothing" is not "no spend", which is why the refusing arm carries a cause rather
// than a zero.
//
// THE ASYMMETRY IS WHAT MAKES THE SCREEN SOUND, and it fixes the order of the derivation. Sampling
// error in a run-mix estimate is overwhelmingly DOWNWARD: a sample that misses a repository's rare
// heavy workflow under-counts minutes, and no amount of missed heavy work can manufacture an
// above-ceiling reading. So a proof of spend survives an incomplete sample, while a below-ceiling
// reading does not - it must first be asked whether the sample could see the workload at all.
// A too-short window is the one error that goes the other way: a burst extrapolated to a month
// inflates, so the window test runs BEFORE the ceiling test and can only refuse.
// =====================================================================================

// INSTRUMENT DEFECT 1, CLOSED BY CONSTRUCTION: actions/runs total_count IS NOT A COUNT. Measured
// on this branch: biomejs/biome and openobserve/openobserve both report exactly 40000 unfiltered -
// a cap wearing the shape of a total - and openobserve's created-FILTERED count came back 77132,
// LARGER than its unfiltered one. A filtered population larger than the unfiltered one is
// incoherent. There is deliberately NO FIELD here for a reported total: the population size is
// runs COUNTED over a recorded window, and the wrong number has nowhere to be written down.
//
// INSTRUMENT DEFECT 2, CLOSED BY REFUSAL: a monthly rate extrapolated from a short window is a
// burst, not a rate. The window is a required field so that the extrapolation always carries the
// evidence a reader needs to distrust it, and a window under the declared minimum refuses.
type SamplingWindow {
  start: NonEmptyStr
  end: NonEmptyStr
  hours: Int
}

data minimum_extrapolation_window_hours: Int = 24

data window_minimum_basis: NonEmptyStr = "a repository's CI load is diurnal and weekly; a monthly rate taken from a few hours is dominated by whatever happened in those hours. Measured while building this screen: a single recent 100-run page put biomejs/biome at 20,908 runs per month over a 3.44-hour span, against 7,149 over the 51-hour window carried below - the short window inflated the rate roughly threefold."

type RunRateSample {
  runs_counted: Int
  window: SamplingWindow
  runs_per_month: Int
}

fn window_is_long_enough(w: SamplingWindow) -> Bool {
  w.hours >= minimum_extrapolation_window_hours
}

// INSTRUMENT DEFECT 3, CLOSED BY NAMING: WALL-CLOCK JOB DURATION IS NOT BILLED MINUTES. Rounding,
// per-job minimums and per-provider metering rules all differ, so nothing here may be read as an
// invoice - there is no cost field, no rate and no currency in this section, and the proving arm
// asserts THAT a bill exists, never how large it is.
//
// The screen is still valid despite that gap, and the reason is directional: every billing rule of
// this kind rounds UP - a minimum charge or a rounded interval can only make billed minutes exceed
// wall-clock minutes, never fall below them. So wall-clock consumption above the ceiling implies
// billed consumption above the ceiling. The inequality survives the imprecision in the one
// direction the screen uses.
type LabelConsumption {
  label: NonEmptyStr
  minutes_per_run_thousandths: Int
}

// INSTRUMENT DEFECT 4, FOUND BY EXECUTION: some jobs report completed_at BEFORE started_at. In the
// three samples below they are 9, 17 and 21 jobs. A negative duration is not a fast job, it is not
// a measurement at all, and summing it silently subtracts real minutes from a repository's bill.
// They are excluded from the sums and COUNTED here, because an excluded observation that nobody
// counts is indistinguishable from one that never existed.
type ConsumptionSample {
  repository: NonEmptyStr
  provider: NonEmptyStr
  rate: RunRateSample
  provider_labels: List<LabelConsumption>
  jobs_sampled_from_runs: Int
  incoherent_job_durations: Int
  workflows_observed: List<NonEmptyStr>
  census_workflow_path: NonEmptyStr
}

// ONLY THE PAYING PROVIDER'S LABELS COUNT TOWARD THE PAYING PROVIDER'S BILL, and this is where the
// screen would most easily lie. PowerDNS burns roughly 282,000 minutes a month on ubuntu-24.04 -
// five times the ceiling - and every one of those minutes is GitHub-hosted and free on a public
// repository. Attributing them to Ubicloud would have produced a confident, enormous, entirely
// fictional bill. Provider attribution is read from the label prefix, the same way architecture is
// read from an architecture segment.
fn label_provider(label: NonEmptyStr) -> ProviderDeclaration {
  if label.starts_with("depot-") {
    ProviderDeclaredDepot { label: label }
  } else if label.starts_with("ubicloud-") {
    ProviderDeclaredUbicloud { label: label }
  } else {
    ProviderDeclaredGitHubHosted { label: label }
  }
}

fn provider_name(p: ProviderDeclaration) -> NonEmptyStr {
  match p {
    ProviderDeclaredDepot { label } => "depot",
    ProviderDeclaredUbicloud { label } => "ubicloud",
    ProviderDeclaredGitHubHosted { label } => "github-hosted",
    ProviderSelectedByExpression { expression, alternatives } => "unresolved",
  }
}

fn label_is_billed_by(label: NonEmptyStr, provider: NonEmptyStr) -> Bool {
  provider_name(p: label_provider(label: label)) == provider
}

fn sample_minutes_per_month(s: ConsumptionSample) -> Int {
  let attributed = filter(s.provider_labels, l => label_is_billed_by(label: l.label, provider: s.provider))
  let thousandths = fold(attributed, init: 0, f: (acc, l) => acc + l.minutes_per_run_thousandths)
  s.rate.runs_per_month * thousandths / 1000
}

fn sample_covers_census_workload(s: ConsumptionSample) -> Bool {
  count(filter(s.workflows_observed, w => w == s.census_workflow_path)) > 0
}

// THE CEILING IS AN INPUT WITH A CITED BASIS AND A STANDING, NOT A CONSTANT. A provider whose free
// tier cannot be bounded from public sources cannot have its consumption proved to be spend at any
// volume, and saying so is the whole difference between a screen and a guess.
type FreeAllowanceStanding
  = AllowanceBoundedBy { minutes_per_month: Int, basis: NonEmptyStr }
  | AllowanceUnresolved { obligation: NonEmptyStr }

type ProviderAllowance {
  provider: NonEmptyStr
  standing: FreeAllowanceStanding
}

data depot_allowance: ProviderAllowance = ProviderAllowance {
  provider: "depot",
  standing: AllowanceBoundedBy {
    minutes_per_month: 50000,
    basis: "Depot publishes metered per-second runner pricing with a 7-day trial and no unmetered open-source grant was found on its own pricing or documentation pages. 50,000 minutes per month is the largest monthly included-minutes allowance published by any provider in this census (GitHub Enterprise Cloud) and is used here as a deliberately over-generous bound: it is roughly two orders of magnitude beyond a 7-day trial, so exceeding it proves a bill under any plan Depot is known to offer.",
  },
}

data ubicloud_allowance: ProviderAllowance = ProviderAllowance {
  provider: "ubicloud",
  standing: AllowanceUnresolved {
    obligation: "two mutually inconsistent readings of Ubicloud's free tier for PUBLIC repositories were seen and neither was confirmed against Ubicloud's own pricing page: a metered monthly free allowance in the low thousands of minutes, and an open-source plan carrying unmetered public-repository runners. If the second reading is right, no volume of Ubicloud consumption on a public repository can ever prove spend, and a bounded ceiling would be a fabricated authority. Resolve by reading the vendor's own published plan terms.",
  },
}

// THE VERDICT. Three arms, and the third is not optional: openobserve needs it today.
type SpendScreen
  = SpendProvenAboveCeiling {
      provider: NonEmptyStr
      observed_minutes_per_month: Int
      ceiling_minutes_per_month: Int
      note: NonEmptyStr
    }
  | SpendUnprovenBelowCeiling {
      provider: NonEmptyStr
      observed_minutes_per_month: Int
      cause: NonEmptyStr
    }
  | SampleUnrepresentative { cause: NonEmptyStr }

data below_ceiling_note: NonEmptyStr = "below the ceiling the screen is silent, and silence is not evidence of absence: this repository may be paying under any tier the ceiling generously covers. The only thing established is that public data cannot prove a bill."

// THE ORDER OF THESE ARMS IS THE ARGUMENT, not a style choice. The window test precedes everything
// because a short window is the one error that INFLATES. The ceiling test precedes the coverage
// test because sampling error runs downward, so a proof survives an incomplete sample while a
// below-ceiling reading does not. And an unresolved allowance can only ever PREVENT a proof - it
// never creates one - so it gates the proving arm rather than forming an arm of its own.
fn spend_screen(s: ConsumptionSample, a: ProviderAllowance) -> CensusVerdict<SpendScreen> {
  let observed = sample_minutes_per_month(s: s)
  if window_is_long_enough(w: s.rate.window) == false {
    CensusVerdict { reading: SampleUnrepresentative {
      cause: join([s.repository, ": the rate was extrapolated from a ", s.rate.window.start, " to ", s.rate.window.end,
        " window shorter than the declared minimum, and a burst read as a month inflates. ", window_minimum_basis], ""),
    } }
  } else {
    match a.standing {
      AllowanceBoundedBy { minutes_per_month, basis } =>
        if observed > minutes_per_month {
          CensusVerdict { reading: SpendProvenAboveCeiling {
            provider: s.provider,
            observed_minutes_per_month: observed,
            ceiling_minutes_per_month: minutes_per_month,
            note: join(["wall-clock runner minutes on ", s.provider,
              "-billed labels exceed the most generous conceivable free allowance, so some amount is billed. Billing rules round UP, so the inequality survives the wall-clock approximation. The AMOUNT is not established here and no rate is applied. Ceiling basis: ", basis], ""),
          } }
        } else if sample_covers_census_workload(s: s) == false {
          CensusVerdict { reading: SampleUnrepresentative {
            cause: join([s.repository, ": below the ceiling, and the sample never observed ", s.census_workflow_path,
              " - the workflow carrying the job this census selected. Sampling error runs downward, so a below-ceiling reading from a sample that could not see the repository's heavy workload establishes nothing at all, not even a lower bound worth reporting."], ""),
          } }
        } else {
          CensusVerdict { reading: SpendUnprovenBelowCeiling {
            provider: s.provider, observed_minutes_per_month: observed, cause: below_ceiling_note,
          } }
        },
      AllowanceUnresolved { obligation } =>
        if sample_covers_census_workload(s: s) == false {
          CensusVerdict { reading: SampleUnrepresentative {
            cause: join([s.repository, ": the sample never observed ", s.census_workflow_path,
              ", the workflow carrying the selected job, AND ", s.provider, "'s free allowance is unbounded from public sources (", obligation, ")"], ""),
          } }
        } else {
          CensusVerdict { reading: SpendUnprovenBelowCeiling {
            provider: s.provider, observed_minutes_per_month: observed,
            cause: join([s.provider, "'s free allowance could not be bounded, so no consumption at any volume proves a bill: ", obligation], ""),
          } }
        },
    }
  }
}

fn spend_is_proven(v: CensusVerdict<SpendScreen>) -> Bool {
  match v.reading {
    SpendProvenAboveCeiling { provider, observed_minutes_per_month, ceiling_minutes_per_month, note } => true,
    SpendUnprovenBelowCeiling { provider, observed_minutes_per_month, cause } => false,
    SampleUnrepresentative { cause } => false,
  }
}

// -------------------------------------------------------------------------------------
// THE SAMPLES. Measured 2026-09-05 by counting runs over a recorded window and summing job
// durations per runner label across runs drawn at an even stride through that window - not from
// the recent end, which is what made an earlier pass at openobserve report 0.04 minutes per run.
// Re-derive with: 500 runs over five pages of repos/{owner}/{repo}/actions/runs, then
// repos/{owner}/{repo}/actions/runs/{id}/jobs for every sixteenth run.
// -------------------------------------------------------------------------------------

data sample_biome: ConsumptionSample = ConsumptionSample {
  repository: "biomejs/biome",
  provider: "depot",
  rate: RunRateSample {
    runs_counted: 500,
    window: SamplingWindow { start: "2026-09-03T16:46:46Z", end: "2026-09-05T19:52:38Z", hours: 51 },
    runs_per_month: 7149,
  },
  provider_labels: [
    LabelConsumption { label: "depot-ubuntu-24.04-arm-16", minutes_per_run_thousandths: 33482 },
    LabelConsumption { label: "depot-windows-2022", minutes_per_run_thousandths: 393 },
    LabelConsumption { label: "depot-ubuntu-24.04-arm", minutes_per_run_thousandths: 246 },
    LabelConsumption { label: "depot-windows-2022-16", minutes_per_run_thousandths: 214 },
    LabelConsumption { label: "depot-ubuntu-24.04-arm-small", minutes_per_run_thousandths: 69 },
    LabelConsumption { label: "ubuntu-latest", minutes_per_run_thousandths: 66 },
  ],
  jobs_sampled_from_runs: 30,
  incoherent_job_durations: 9,
  workflows_observed: [
    ".github/workflows/actions_linter.yml",
    ".github/workflows/autofix.yml",
    ".github/workflows/benchmark.yml",
    ".github/workflows/label-issue.yaml",
    ".github/workflows/labels.yml",
