type ScreenedRepository {
  sample: ConsumptionSample
  allowance: ProviderAllowance
}

data spend_screen_population: List<ScreenedRepository> = [
  ScreenedRepository { sample: sample_biome, allowance: depot_allowance },
  ScreenedRepository { sample: sample_pdns, allowance: ubicloud_allowance },
  ScreenedRepository { sample: sample_openobserve, allowance: ubicloud_allowance },
]

fn screened_verdict(r: ScreenedRepository) -> CensusVerdict<SpendScreen> {
  spend_screen(s: r.sample, a: r.allowance)
}

// The ranked output the operator asked for is a FILTER, not a score: the repositories whose CI
// bill is established. Everything else is silent, and silence is recorded as silence.
fn repositories_with_proven_spend() -> List<ScreenedRepository> {
  filter(spend_screen_population, r => spend_is_proven(v: screened_verdict(r: r)))
}
