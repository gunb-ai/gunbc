module strategy.workload_benchmark_suite

import std.types { Int, List, NonEmptyStr, Bool }
import strategy.ci_acquisition {
  SpendStanding, PublicStandardFree, PaidRunnerObserved, CustomerBillObserved, SpendUnknown,
  OpportunityStanding, NoCommercialSignal,
  ReplayAdmission, ReplayAdmitted, ReplayRefusedLicense, ReplayRefusedSafety,
  ReplayRefusedArchitecture, ReplayRefusedSecrets, ReplayRefusedWorkload,
  ContactProvenance, GitHubDerivedContact,
  OutreachAdmission, OutreachAdmitted, OutreachRefused, outreach_admission,
  MigrationPrAuthorization,
}

// THE PUBLIC WORKLOAD CENSUS (year_end_plan item public-workload-census).
//
// THE SUBJECT IS A JOB, NOT A REPOSITORY. Compatibility is job-scoped: an Arm image-publishing
// job proves nothing about whether a repository's build and tests run natively on Arm, and two
// jobs in one workflow file can disagree about architecture, provider, cache and correctness.
// Every row below therefore names workflow path, job key, matrix selector and source revision.
//
// WHAT THIS MODULE IS FOR. It selects the workloads that incumbent-head-to-head will measure,
// and it makes five promotions unwritable. Each promotion is a place where a cheap observation
// could be read as an expensive fact, and each is refused by a SEPARATE carrier rather than by
// one qualified Boolean, because a single field forces the reader to guess which of five
// different questions a `true` answered:
//   1. an x64 label may not become Arm evidence          -> DeclaredArchitecture, by SUFFIX
//   2. a skipped or failed test may not become a baseline -> ObservedExecution / BaselineAdmission
//   3. an unobserved cache may not become warm            -> CacheObservation / CacheCondition
//   4. provider use may not become verified spend         -> ci_acquisition.SpendStanding
//   5. a benchmark may not authorize trial or outreach    -> TrialAuthorization / OutreachAdmission
//
// NOTHING NEW IS COINED WHERE ci_acquisition ALREADY OWNS THE CONCEPT. Spend provenance, replay
// admission, commercial standing, outreach admission and the migration authorization are that
// module's facts; this census produces rows that inhabit them. Promotions 4 and 5 are therefore
// discharged by an authority that already refuses, not by a second one that agrees with it.

// -------------------------------------------------------------------------------------
// THE ONE SEALED CARRIER, AND WHY THE VERDICTS ARE DERIVED RATHER THAN AUTHORED.
//
// Every refusal below is computed by a total function over authored evidence. That makes the five
// promotions DETECTED - and detection is DESIGN 4b rung 2, because the invalid state stays
// writable: nothing in a derivation stops a later author from writing the verdict directly and
// never calling it. That is exactly 5's tell, a check satisfiable by editing the declaration
// while the realization still lies.
//
// CensusVerdict is the wall. Its constructor is confined to this module, so the only way any other
// module can hold a verdict is to have run the derivation that produced it. The forbidden state
// stops being a thing a witness catches and becomes a thing that does not compile, which is rung 4:
// the invalid program has no representation.
//
// ONE CARRIER, NOT SIX SEALED VERDICTS. "Derived here, not authored elsewhere" is a single concept;
// minting a separate sealed wrapper per verdict would be that concept re-invented six times, which
// 2 counts as a failed decomposition rather than a stronger wall.
//
// IT IS THE CARRIER THAT IS SEALED, NOT THE READING, AND THAT IS DELIBERATE. sole_constructor is
// enforced against RECORD LITERALS, so writing it on a variant type is accepted by the parser and
// checked by nothing - a decoration that would be cited as coverage. Measured on this branch: with
// the six sums marked sole_constructor, a foreign module forging every one of them resolved
// cleanly. The record carrier is the form that actually refuses, proved by
// test.probe.workload_census_verdict_construction_probe.
//
// THE EVIDENCE TYPES ARE DELIBERATELY LEFT OPEN. ObservedExecution, CacheObservation,
// CacheMechanism, ProviderDeclaration and ExternalEffect are what a census SAW, and a census must
// be able to write down what it saw. Sealing evidence would move authorship, not remove it. What
// may not be authored is the verdict.
// -------------------------------------------------------------------------------------

type CensusVerdict<Reading> sole_constructor {
  reading: Reading
}

// -------------------------------------------------------------------------------------
// PROMOTION 1. ARCHITECTURE IS READ FROM AN ARCHITECTURE SEGMENT OF THE LABEL, AND A LABEL
// WITHOUT ONE IS EVIDENCE OF THE OPPOSITE OF WHAT WE WANT.
//
// A provider that offers both architectures selects between them inside one label family:
// ubicloud-standard-2 is x64 and ubicloud-standard-2-arm is the dedicated Arm core;
// depot-ubuntu-24.04-16 is x64 and depot-ubuntu-24.04-arm-16 is Arm. So "the repo uses
// Ubicloud" or "the repo uses Depot" is not an Arm fact at all, and a census that recorded
// only the provider would have promoted every x64 job in these repositories into evidence.
//
// The label is split on "-" and an "arm" or "arm64" SEGMENT is what decides it, rather than a
// substring search: "-arm" appears in the middle of depot-ubuntu-24.04-arm-16 and at the end of
// ubuntu-24.04-arm, so a suffix test alone would miss the first, and a bare substring test would
// answer yes to any future label that merely spells the three letters somewhere.
// -------------------------------------------------------------------------------------

fn label_declares_arm(label: NonEmptyStr) -> Bool {
  let segments = label.split("-")
  segments.contains("arm") || segments.contains("arm64")
}

type DeclaredArchitecture
  = ArmDeclared { label: NonEmptyStr }
  | X64Declared { label: NonEmptyStr }

fn declared_architecture(label: NonEmptyStr) -> CensusVerdict<DeclaredArchitecture> {
  if label_declares_arm(label: label) {
    CensusVerdict { reading: ArmDeclared { label: label } }
  } else {
    CensusVerdict { reading: X64Declared { label: label } }
  }
}

fn architecture_is_arm(a: CensusVerdict<DeclaredArchitecture>) -> Bool {
  match a.reading {
    ArmDeclared { label } => true,
    X64Declared { label } => false,
  }
}

// THE PROVIDER IS A SECOND, INDEPENDENT FACT, AND THE YAML DOES NOT ALWAYS DECIDE IT.
// PowerDNS selects its runner with an expression over a repository variable, so the workflow
// establishes an Arm PATH while leaving the provider to whatever the variable was on the day.
// That is why declared and observed providers are separate fields: only the run resolves it.
type ProviderDeclaration
  = ProviderDeclaredUbicloud { label: NonEmptyStr }
  | ProviderDeclaredDepot { label: NonEmptyStr }
  | ProviderDeclaredGitHubHosted { label: NonEmptyStr }
  | ProviderSelectedByExpression { expression: NonEmptyStr, alternatives: List<NonEmptyStr> }

// -------------------------------------------------------------------------------------
// PROMOTION 2. A SKIPPED OR FAILED TEST IS NOT A BASELINE, AND NEITHER IS A GREEN JOB THAT
// RAN NO TEST. A fast failure is not a speed win, and a build that moves a binary is not a
// correctness check however its step is named.
// -------------------------------------------------------------------------------------

type ObservedExecution
  = NoRunObserved { obligation: NonEmptyStr }
  | RunObservedFailed { run_id: NonEmptyStr, job_id: NonEmptyStr, cause: NonEmptyStr }
  | RunObservedCancelled { run_id: NonEmptyStr, job_id: NonEmptyStr }
  | RunObservedSucceededWithoutTests {
      run_id: NonEmptyStr
      job_id: NonEmptyStr
      head_sha: NonEmptyStr
      observed_label: NonEmptyStr
      note: NonEmptyStr
    }
  | RunObservedSucceededWithTests {
      run_id: NonEmptyStr
      job_id: NonEmptyStr
      head_sha: NonEmptyStr
      observed_label: NonEmptyStr
      test_step: NonEmptyStr
    }

type BaselineAdmission
  = BaselineAdmitted {
      run_id: NonEmptyStr
      job_id: NonEmptyStr
      head_sha: NonEmptyStr
      test_step: NonEmptyStr
      observed_label: NonEmptyStr
    }
  | BaselineRefused { cause: NonEmptyStr }

// The only constructor of BaselineAdmitted. Success is necessary and not sufficient: the arm
// that succeeded without executing a test is refused with its own cause, so the census can
// count WHY a candidate has no baseline rather than reporting an undifferentiated absence.
fn baseline_admission(o: ObservedExecution) -> CensusVerdict<BaselineAdmission> {
  match o {
    RunObservedSucceededWithTests { run_id, job_id, head_sha, observed_label, test_step } =>
      CensusVerdict { reading: BaselineAdmitted {
        run_id: run_id, job_id: job_id, head_sha: head_sha,
        test_step: test_step, observed_label: observed_label,
      } },
    RunObservedSucceededWithoutTests { run_id, job_id, head_sha, observed_label, note } =>
      CensusVerdict { reading: BaselineRefused { cause: join(["job ", job_id, " succeeded but executed no correctness check: ", note], "") } },
    RunObservedFailed { run_id, job_id, cause } =>
      CensusVerdict { reading: BaselineRefused { cause: join(["job ", job_id, " failed: ", cause, " - a failed job is not a baseline"], "") } },
    RunObservedCancelled { run_id, job_id } =>
      CensusVerdict { reading: BaselineRefused { cause: join(["job ", job_id, " was cancelled; a truncated run has no verdict"], "") } },
    NoRunObserved { obligation } =>
      CensusVerdict { reading: BaselineRefused { cause: join(["no run observed: ", obligation], "") } },
  }
}

fn baseline_is_admitted(b: CensusVerdict<BaselineAdmission>) -> Bool {
  match b.reading {
    BaselineAdmitted { run_id, job_id, head_sha, test_step, observed_label } => true,
    BaselineRefused { cause } => false,
  }
}

// The observed runner label is where promotion 1 and promotion 2 join: a baseline is Arm
// evidence only if the label the RUN reports is Arm-suffixed. The declared label is what the
// YAML asked for; the observed label is what answered.
data no_observed_label: NonEmptyStr = "(no runner label observed)"

fn observed_label(o: ObservedExecution) -> NonEmptyStr {
  match o {
    RunObservedSucceededWithTests { run_id, job_id, head_sha, observed_label, test_step } => observed_label,
    RunObservedSucceededWithoutTests { run_id, job_id, head_sha, observed_label, note } => observed_label,
    RunObservedFailed { run_id, job_id, cause } => no_observed_label,
    RunObservedCancelled { run_id, job_id } => no_observed_label,
    NoRunObserved { obligation } => no_observed_label,
  }
}

// -------------------------------------------------------------------------------------
// PROMOTION 3. AN UNOBSERVED CACHE IS NOT A WARM ONE - AND A FRESH WORKER IS NOT A COLD CACHE.
// The incumbent starts a fresh VM per job AND restores a remote cache by default, so the two
// familiar conditions are three: logical cold is CONFIRMED MISSES, remote-warm-on-a-fresh-
// worker is the condition that actually exercises an ephemeral-worker design, and neither is
// established by reading a workflow file. Every row in this census carries CacheUnobserved,
// because this census read YAML and run metadata and did not read a single cache log line.
// -------------------------------------------------------------------------------------

type CacheObservation
  = CacheUnobserved { obligation: NonEmptyStr }
  | CacheMissConfirmed { evidence: NonEmptyStr }
  | CacheHitConfirmed { evidence: NonEmptyStr }

type CacheMechanism {
  name: NonEmptyStr
  layer: NonEmptyStr
  observation: CacheObservation
}

type CacheCondition
  = LogicalCold { evidence: NonEmptyStr }
  | RemoteWarmOnFreshWorker { evidence: NonEmptyStr }
  | CacheConditionUnestablished { cause: NonEmptyStr }

fn cache_condition(m: CacheMechanism) -> CensusVerdict<CacheCondition> {
  match m.observation {
    CacheHitConfirmed { evidence } => CensusVerdict { reading: RemoteWarmOnFreshWorker { evidence: evidence } },
    CacheMissConfirmed { evidence } => CensusVerdict { reading: LogicalCold { evidence: evidence } },
    CacheUnobserved { obligation } => CensusVerdict { reading: CacheConditionUnestablished {
      cause: join([m.name, " (", m.layer, ") was declared in the workflow and never observed: ", obligation], ""),
    } },
  }
}

fn cache_condition_is_warm(c: CensusVerdict<CacheCondition>) -> Bool {
  match c.reading {
    RemoteWarmOnFreshWorker { evidence } => true,
    LogicalCold { evidence } => false,
    CacheConditionUnestablished { cause } => false,
  }
}

// -------------------------------------------------------------------------------------
// EXTERNAL EFFECTS AND WHY A REPLAY IS DERIVED. Registry pushes, cloud role assumption and
// third-party coverage uploads must come out of BOTH realizations, which makes the measured
// thing a build/test replay DERIVED from the workflow and not an execution of the published
// pipeline. Saying so is not pedantry: a removed push is removed WORK, and a comparison that
// silently drops it from one side is measuring two different workloads.
//
// An artifact upload back into the same run is NOT a third-party mutation, so it is retained -
// and it is then a TIMED STAGE, because the exit criterion decomposes required upload as its
// own stage rather than folding it into build.
// -------------------------------------------------------------------------------------

type ExternalEffectKind
  = RegistryPush { registry: NonEmptyStr }
  | CloudRoleAssumption { role: NonEmptyStr }
  | CoverageUpload { service: NonEmptyStr }
  | WorkflowArtifactUpload { artifact: NonEmptyStr }

type EffectDisposition
  = RemovedFromBothRealizations { cause: NonEmptyStr }
  | RetainedAndTimed { cause: NonEmptyStr }

type ExternalEffect {
  kind: ExternalEffectKind
  step: NonEmptyStr
  disposition: EffectDisposition
}

fn effect_requires_removal(k: ExternalEffectKind) -> Bool {
  match k {
    RegistryPush { registry } => true,
    CloudRoleAssumption { role } => true,
    CoverageUpload { service } => true,
    WorkflowArtifactUpload { artifact } => false,
  }
}

fn effect_is_removed(e: ExternalEffect) -> Bool {
  match e.disposition {
    RemovedFromBothRealizations { cause } => true,
    RetainedAndTimed { cause } => false,
  }
}

// The row-level obligation: every effect that mutates something outside the run carries a
// removal disposition. A row that names a registry push and retains it fails this.
fn effect_disposition_is_sound(e: ExternalEffect) -> Bool {
  effect_requires_removal(k: e.kind) == effect_is_removed(e: e)
}

type ReplayDerivation
  = DerivedBuildTestReplay { removed_effects: Int }
  | PipelineExecutedAsPublished

fn replay_derivation(effects: List<ExternalEffect>) -> CensusVerdict<ReplayDerivation> {
  let removed = count(filter(effects, e => effect_is_removed(e: e)))
  if removed == 0 {
    CensusVerdict { reading: PipelineExecutedAsPublished }
  } else {
    CensusVerdict { reading: DerivedBuildTestReplay { removed_effects: removed } }
  }
}

// -------------------------------------------------------------------------------------
// PROMOTION 5. NOTHING IN A CENSUS OR A BENCHMARK AUTHORIZES A TRIAL OR AN APPROACH.
//
// TrialAuthorizedByOperator CONTAINS a ci_acquisition.MigrationPrAuthorization, and this module
// constructs no such value anywhere: the authorizing arm is unreachable from a benchmark
// outcome by construction, not by a check that a later edit could satisfy. The function below
// is total over benchmark outcomes and every arm refuses, INCLUDING the favorable one - which
// is the arm that would otherwise be argued into an exception.
// -------------------------------------------------------------------------------------

type BenchmarkOutcome
  = BenchmarkNotRun
  | BenchmarkFavorable { receipt: NonEmptyStr }
  | BenchmarkUnfavorable { receipt: NonEmptyStr }
  | BenchmarkIncomplete { cause: NonEmptyStr }

type TrialAuthorization
  = TrialUnauthorized { cause: NonEmptyStr }
  | TrialAuthorizedByOperator { authorization: MigrationPrAuthorization }

data trial_refusal_note: NonEmptyStr = "a measurement is not a mandate: a trial or a migration PR exists only downstream of an explicit repository-scoped operator authorization (ci_acquisition.MigrationPrAuthorization), which no benchmark outcome constructs"

fn trial_authorization_from_benchmark(o: BenchmarkOutcome) -> CensusVerdict<TrialAuthorization> {
  match o {
    BenchmarkFavorable { receipt } => CensusVerdict { reading: TrialUnauthorized {
      cause: join(["favorable benchmark ", receipt, ": ", trial_refusal_note], ""),
    } },
    BenchmarkUnfavorable { receipt } => CensusVerdict { reading: TrialUnauthorized {
      cause: join(["unfavorable benchmark ", receipt, ": ", trial_refusal_note], ""),
    } },
    BenchmarkIncomplete { cause } => CensusVerdict { reading: TrialUnauthorized {
      cause: join(["incomplete benchmark (", cause, "): ", trial_refusal_note], ""),
    } },
    BenchmarkNotRun => CensusVerdict { reading: TrialUnauthorized {
      cause: join(["no benchmark run: ", trial_refusal_note], ""),
    } },
  }
}

fn trial_is_authorized(t: CensusVerdict<TrialAuthorization>) -> Bool {
  match t.reading {
    TrialAuthorizedByOperator { authorization } => true,
    TrialUnauthorized { cause } => false,
  }
}

// HOW THESE CANDIDATES WERE FOUND IS THE FACT THAT DECIDES OUTREACH. They were found by reading
// public workflow files on GitHub, which is exactly ci_acquisition.GitHubDerivedContact, and that
// module's outreach_admission refuses that provenance unconditionally. The census does not need
// its own outreach rule; it needs to hand the existing one the truth about its own provenance.
data census_provenance: ContactProvenance = GitHubDerivedContact {
  how_obtained: "public code search and read-only inspection of GitHub-hosted workflow files and public run history",
}

fn census_outreach_admission() -> OutreachAdmission {
  outreach_admission(
    provenance: census_provenance,
    jurisdiction: "US corporate subscriber",
    suppression_checked: "not applicable - no contact record was collected by this census",
    human_authorization: "none sought; this census is selection work only")
}

// -------------------------------------------------------------------------------------
// THE READING THE HEAD-TO-HEAD MUST NOT GET WRONG. Ubicloud's Arm runners are Ampere Altra
// Q80-30, the same processor family this fleet holds, so a gap measured against them is a
// SERVICE-PATH gap - cache, network, scheduling, setup - and not a silicon verdict. Stated as
// a derivation rather than a sentence so that changing the premise changes the reading.
// -------------------------------------------------------------------------------------

type ProcessorFamilyRelation
  = SameProcessorFamily { our_part: NonEmptyStr, incumbent_part: NonEmptyStr, source: NonEmptyStr }
  | DifferentProcessorFamily { our_part: NonEmptyStr, incumbent_part: NonEmptyStr, source: NonEmptyStr }
  | ProcessorFamilyUnknown { obligation: NonEmptyStr }

type GapReading
  = ServicePathReading { note: NonEmptyStr }
  | SiliconReading { note: NonEmptyStr }
  | GapReadingUnavailable { cause: NonEmptyStr }

fn gap_reading(r: ProcessorFamilyRelation) -> CensusVerdict<GapReading> {
  match r {
    SameProcessorFamily { our_part, incumbent_part, source } => CensusVerdict { reading: ServicePathReading {
      note: join(["both sides run ", our_part, " / ", incumbent_part, " (", source,
        "), so any gap is cache, network, scheduling or setup overhead and may not be reported as a hardware verdict"], ""),
    } },
    DifferentProcessorFamily { our_part, incumbent_part, source } => CensusVerdict { reading: SiliconReading {
      note: join([our_part, " against ", incumbent_part, " (", source,
        "): silicon is confounded with the service path and the two must be separated before either is reported"], ""),
    } },
    ProcessorFamilyUnknown { obligation } => CensusVerdict { reading: GapReadingUnavailable {
      cause: join(["the incumbent's processor is unobserved: ", obligation], ""),
    } },
  }
}

data ubicloud_arm_family_relation: ProcessorFamilyRelation = SameProcessorFamily {
  our_part: "Ampere Altra (Mt. Collins fleet)",
  incumbent_part: "Ampere Altra Q80-30 (Ubicloud Arm runners)",
  source: "Ubicloud published runner specification, carried in year_end_plan item incumbent-head-to-head",
}

// -------------------------------------------------------------------------------------
// THE CANDIDATE ROW. Five separate standings, never one qualified Boolean: what the provider
// DECLARES, what a run OBSERVED, whether replay is ADMITTED, what commercial signal exists,
// and what a trial is authorized to do. A candidate can be Arm-declared, observed-green,
// replay-refused, commercially silent and trial-unauthorized all at once, and that combination
// has to be readable without collapsing it.
// -------------------------------------------------------------------------------------

type CandidateSelection
  = SelectedWorkload { rank: Int, complementarity: NonEmptyStr }
  | ShortlistedNotSelected { reason: NonEmptyStr }
  | CandidateRejected { reason: NonEmptyStr }
  | CandidateUnresolved { obligation: NonEmptyStr }

type WorkloadCandidate {
  repository: NonEmptyStr
  license_spdx: NonEmptyStr
  inspected_workflow_revision: NonEmptyStr
  workflow_path: NonEmptyStr
  job_key: NonEmptyStr
  job_display_name: NonEmptyStr
  matrix_selector: NonEmptyStr
  declared_label: NonEmptyStr
  declared_provider: ProviderDeclaration
  observed: ObservedExecution
  workload_commands: List<NonEmptyStr>
  resource_requirements: NonEmptyStr
  caches: List<CacheMechanism>
  external_effects: List<ExternalEffect>
  replay: ReplayAdmission
  spend: SpendStanding
  commercial: OpportunityStanding
  trial: CensusVerdict<TrialAuthorization>
  selection: CandidateSelection
}

fn candidate_declared_architecture(c: WorkloadCandidate) -> CensusVerdict<DeclaredArchitecture> {
  declared_architecture(label: c.declared_label)
}

fn candidate_baseline(c: WorkloadCandidate) -> CensusVerdict<BaselineAdmission> {
  baseline_admission(o: c.observed)
}

fn candidate_is_selected(c: WorkloadCandidate) -> Bool {
  match c.selection {
    SelectedWorkload { rank, complementarity } => true,
    ShortlistedNotSelected { reason } => false,
    CandidateRejected { reason } => false,
    CandidateUnresolved { obligation } => false,
  }
}

fn candidate_replay_is_admitted(c: WorkloadCandidate) -> Bool {
  match c.replay {
    ReplayAdmitted { sandbox_profile } => true,
    ReplayRefusedLicense { cause } => false,
    ReplayRefusedSafety { cause } => false,
    ReplayRefusedArchitecture { cause } => false,
    ReplayRefusedSecrets { cause } => false,
    ReplayRefusedWorkload { cause } => false,
  }
}

data replay_sandbox_note: NonEmptyStr = "ci_acquisition.replay_sandbox_profile, with the workflow's external mutations removed from BOTH realizations"

data cache_read_obligation: NonEmptyStr = "this census read workflow YAML and run/job metadata only; no cache log line was read, so hit or miss is unobserved and the head-to-head must establish it in our own account"

// -------------------------------------------------------------------------------------
// SELECTED WORKLOAD 1 - Biome. A Rust workspace test job with a KNOWN-SUCCESSFUL Arm baseline,
// no external mutation of any kind, and one command. It is the cleanest thing in the census.
//
// TWO CORRECTIONS THE ROW CARRIES. First, the most recent CI-on-main run at inspection time
// FAILED, so "Biome is green on Arm" would have been false on the day; the baseline is the
// named earlier commit, not HEAD. Second, Biome's Arm runners are DEPOT, not Ubicloud - the
// screening brief for this census assumed Ubicloud, and only OpenObserve below is actually
// observed on it. That does not disqualify anything, because both sides of the head-to-head
// run in OUR account, but a row that recorded "Ubicloud" here would have been fiction.
// -------------------------------------------------------------------------------------

data candidate_biome_test: WorkloadCandidate = WorkloadCandidate {
  repository: "biomejs/biome",
  license_spdx: "Apache-2.0",
  inspected_workflow_revision: "47d7383d049b36ff8eaba50912176928143dd9e9",
  workflow_path: ".github/workflows/main.yml",
  job_key: "test",
  job_display_name: "Test (depot-ubuntu-24.04-arm-16)",
  matrix_selector: "os=depot-ubuntu-24.04-arm-16",
  declared_label: "depot-ubuntu-24.04-arm-16",
  declared_provider: ProviderDeclaredDepot { label: "depot-ubuntu-24.04-arm-16" },
  observed: RunObservedSucceededWithTests {
    run_id: "33892992396",
    job_id: "101088906536",
    head_sha: "a7f0c48e20e17ec8e70f09644fff4ec50f4e8f2e",
    observed_label: "depot-ubuntu-24.04-arm-16",
    test_step: "Run tests on depot-ubuntu-24.04-arm-16 (success, 2026-09-04T16:04:06Z to 2026-09-04T16:08:12Z)",
  },
  workload_commands: ["cargo test --workspace --features=js_plugin"],
  resource_requirements: "16-vCPU class Arm runner; Rust toolchain via moonrepo/setup-rust; no service containers, no database, no privileged capability",
  caches: [
    CacheMechanism {
      name: "moonrepo/setup-rust (cache-base: main)",
      layer: "cargo registry and compiler outputs",
      observation: CacheUnobserved { obligation: cache_read_obligation },
    },
  ],
  external_effects: [],
  replay: ReplayAdmitted { sandbox_profile: replay_sandbox_note },
  spend: SpendUnknown {
    obligation: "a third-party runner label establishes provider USE, not spend; Depot's billing for this account is not public and no bill was observed",
  },
  commercial: NoCommercialSignal,
  trial: trial_authorization_from_benchmark(o: BenchmarkNotRun),
  selection: SelectedWorkload {
    rank: 1,
    complementarity: "managed Rust workspace test: real correctness signal, single command, zero external mutation, so the replay is the published job rather than a derivation of it",
  },
}

// -------------------------------------------------------------------------------------
// SELECTED WORKLOAD 2 - PowerDNS dnsdist. Native C++ under sanitizers, meson/ninja, ccache and
// a build container: a materially different cost shape from a cargo workspace, which is the
// whole reason to carry a second workload.
//
// THE PROVIDER WAS DECIDED BY THE RUN, NOT THE YAML. runs-on is an expression choosing
// ubicloud-standard-4-arm-ubuntu-2404 when a repository variable is set and ubuntu-24.04-arm
// otherwise. Both alternatives are Arm-suffixed, so the ARCHITECTURE is established by the
// workflow; the PROVIDER is not. The observed job reports ubuntu-24.04-arm - GitHub-hosted, not
// Ubicloud - so this repository is not evidence of incumbent spend of any kind.
// -------------------------------------------------------------------------------------

data candidate_pdns_dnsdist_arm: WorkloadCandidate = WorkloadCandidate {
  repository: "PowerDNS/pdns",
  license_spdx: "GPL-2.0",
  inspected_workflow_revision: "0f2df8380e89bb066e947a5818f6267016847d98",
  workflow_path: ".github/workflows/build-and-test-all.yml",
  job_key: "build-dnsdist",
  job_display_name: "build dnsdist (asan+ubsan, full, -arm)",
  matrix_selector: "sanitizers=asan+ubsan, features=full, architecture_suffix=-arm",
  declared_label: "ubuntu-24.04-arm",
  declared_provider: ProviderSelectedByExpression {
    expression: "( vars.REPOSITORY_USE_UBICLOUD == '1' ) && format('ubicloud-standard-4{0}-ubuntu-2404', matrix.architecture_suffix) || format('ubuntu-24.04{0}', matrix.architecture_suffix)",
    alternatives: ["ubicloud-standard-4-arm-ubuntu-2404", "ubuntu-24.04-arm"],
  },
  observed: RunObservedSucceededWithTests {
    run_id: "33860869079",
    job_id: "100984779675",
    head_sha: "0f2df8380e89bb066e947a5818f6267016847d98",
    observed_label: "ubuntu-24.04-arm",
    test_step: "inv ci-dnsdist-run-unit-tests (success; job 2026-09-04T09:57:28Z to 2026-09-04T10:07:09Z)",
  },
  workload_commands: [
    "inv install-dnsdist-build-deps",
    "inv install-clang",
    "inv ci-install-rust",
    "inv ci-build-and-install-quiche",
    "inv ci-dnsdist-configure full",
    "inv ci-dnsdist-run-ninja",
    "inv ci-dnsdist-run-unit-tests",
  ],
  resource_requirements: "4-vCPU class Arm runner inside a maintainer-published build container, --sysctl net.ipv6.conf.all.disable_ipv6=0, asan+ubsan instrumented build, recursive submodules",
  caches: [
    CacheMechanism {
      name: "./.github/actions/cache (cache-key-base dnsdist-full-asan+ubsan-meson-arm-ccache)",
      layer: "ccache compiler outputs",
      observation: CacheUnobserved { obligation: cache_read_obligation },
    },
  ],
  external_effects: [
    ExternalEffect {
      kind: CoverageUpload { service: "Coveralls" },
      step: "Coveralls Parallel dnsdist unit",
      disposition: RemovedFromBothRealizations {
        cause: "a third-party coverage upload mutates an external service and its latency is that service's, not the runner's",
      },
    },
    ExternalEffect {
      kind: WorkflowArtifactUpload { artifact: "pdns-recursor / dnsdist binaries" },
      step: "Store the binaries",
      disposition: RetainedAndTimed {
        cause: "an artifact upload inside our own run is required work, so it is kept and timed as its own stage rather than folded into build",
      },
    },
  ],
  replay: ReplayAdmitted { sandbox_profile: replay_sandbox_note },
  spend: PublicStandardFree {
    note: "the observed run used GitHub-hosted ubuntu-24.04-arm on a public repository; no paid-runner label and no bill observed",
  },
  commercial: NoCommercialSignal,
  trial: trial_authorization_from_benchmark(o: BenchmarkNotRun),
  selection: SelectedWorkload {
    rank: 2,
    complementarity: "native C++ with sanitizers, meson/ninja and ccache in a container - a different compiler, a different cache layer and a different I/O shape from the Rust workspace, which is what keeps the head-to-head from measuring cargo twice",
  },
}

// -------------------------------------------------------------------------------------
// SELECTED WORKLOAD 3 - OpenObserve. The ONLY job in this census observed executing on a
// Ubicloud Arm runner, which is the incumbent this program is compared against. It is selected
// for that reason and it is selected as a BUILD-PERFORMANCE workload only.
//
// ITS STEP IS NAMED "Build and run binary" AND IT DOES NOT RUN THE BINARY. The step compiles
// with cargo and then mkdir/mv the output; nothing executes and nothing is asserted. The
// observed job is therefore RunObservedSucceededWithoutTests and baseline_admission REFUSES it.
// A step name is not evidence, and this row is the census's own worked example of promotion 2.
// -------------------------------------------------------------------------------------

