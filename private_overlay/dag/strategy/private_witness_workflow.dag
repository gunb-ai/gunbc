data witness_ci_economics: PrivateWitness = PrivateWitness {
  entry: "dag/test/claim/ci_economics_witness_test.dag",
  function: "economics_frontier_main",
  disposition: KnownRed {
    expected_causes: [
      "error: resolve failed for private_overlay/dag/test/claim/ci_economics_witness_test.dag",
      "unresolved import: module 'extdeps.ci_compute_pricing' not found",
    ],
    reason: "REASON-LOCKED IN EXECUTION, not in prose: every string in expected_causes above is grepped for in the run's own output, so a failure that does not exhibit all of them stops the line. ci_runner_economics, ci_spill_policy and ci_pricing_page import extdeps.ci_compute_pricing, which is not on public main. Public PR 8950 was closed as a stale fork duplicating eight authorities that landed after it was branched, so restoring it is refused; the three modules must be re-grounded onto extdeps/ci_runner, extdeps/pricing and extdeps/cloud. That is a rewrite, not a repair. This row previously carried ci_build_frontier as its only execution, and because a KnownRed accepts ANY nonzero exit it could not tell this cause from another: the module sat un-migrated against a deleted std.pareto API and this witness reported exactly the same red. Stale-pass detection does not detect CAUSE drift. ci_build_frontier now has its own Enforced witness above, so this row no longer stands as evidence for anything but its own named cause.",
    restoration_trigger: "The three modules consume the existing public authorities and this witness returns ExitSuccess.",
  },
}

