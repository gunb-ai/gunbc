data probe_seller_identity_unwritable: PrivateWitness = PrivateWitness {
  entry: "dag/test/probe/seller_identity_unwritable_probe.dag",
  function: "probe_main",
  disposition: RefusalProbe {
    guards: "no eBay user identity is writable into the buyer pipeline's listing types: OperatorListingEntry and ListingEvidence carry no seller field, which is what keeps the Marketplace Account Deletion exemption statement true. The wall's edge is known and chosen: the sheet's own columns never derive identity, and the residue is free text a human typed (title, stated aspects, notes). Also given up, deliberately: the sheet cannot show that two rows share a seller, so combined shipping across listings is judged on the listing page -- a hashed seller key would still be pseudonymous personal data",
    expected_causes: [
      "field 'seller' not found in type 'OperatorListingEntry'",
      "field 'seller' not found in type 'ListingEvidence'",
    ],
    dissolution: "this row retires ONLY if a seller identity field is deliberately re-added, and then the exemption statement to eBay is false and must be withdrawn with it; it is never retired as fixed",
  },
}

data probe_buyer_review_execution_forged: PrivateWitness = PrivateWitness {
  entry: "dag/test/probe/buyer_review_execution_forged_probe.dag",
  function: "probe_main",
  disposition: RefusalProbe {
    guards: "two walls on the buyer-sheet hold. BuyerReviewExecution (the identity a run acquires under) is minted only by buyer_review_execution_observe, which reads the boot time, its own cgroup and the unit invocation itself. BuyerReviewRecoveryWarrant (the only authority recover_admitted accepts to release a stale hold) is minted only by buyer_review_recovery_admission, which reads the slot, the current boot and the recorded unit's invocation itself. The warrant's mint, recovery_admission_on_the_executor_host, is admit_callers-sealed to the host-gated buyer_review_recovery_admission, so no warrant is minted without the live srv1 check. What this does NOT cover: the pure recovery_verdict_of still accepts supplied reads, by design, and carries no release authority; and that the gated entry calls the gate before the mint is read in source, not executed by a hermetic claim",
    expected_causes: [
      "sole_constructor type 'BuyerReviewExecution' cannot be constructed outside its defining module",
      "sole_constructor type 'BuyerReviewRecoveryWarrant' cannot be constructed outside its defining module",
      "constructor call admission refused: 'strategy.buyer_review_placement.recovery_admission_on_the_executor_host' refuses call from 'test.probe.buyer_review_execution_forged_probe.ungated_recovery'",
    ],
    dissolution: "this row retires ONLY if the confinement is deliberately removed, and the wall goes with it; it is never retired as fixed",
  },
}

