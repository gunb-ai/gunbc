// The read-outcome COPRODUCT only. This module never calls Filesystem.Read -- the impure read
// lives in the witness -- but the fold that classifies a read must name its arms, and naming them
// here is what lets the classification be tested with a synthetic outcome instead of a real
// filesystem failure.
import extdeps.filesystem.filesystem_io {
  FilesystemReadOutcome, FilesystemReadSucceeded, FilesystemReadRefused,
}
import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep,
  WorkflowTrigger, Push, PullRequest, WorkflowDispatch,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview,
  WorkflowPermissions, PermRead,
  RunnerSpec, HostedRunner, UbuntuLatest, SelfHosted, self_hosted_labels,
  checkout_action, setup_rust_action,
}

// THE ACTUATOR THIS REPOSITORY DID NOT HAVE.
//
// The .dag graph here is declared canonical, and until this workflow existed nothing executed it.
// Measured 2026-08-26: seven of the eight claim witnesses did not resolve against public main and
// had not for at least six days. Nothing went red, because nothing ran. A canonical graph with no
// consumer is documentary, and the cost is paid by whoever next assumes a private claim still holds.
//
// EMITTED, NOT HAND-AUTHORED. .github/workflows/witnesses.yml is a projection of this module, the
// same construction public gunbc uses (gunbc.witness_floor_workflow -> gunbc.generated_artifact_emit).
// A hand-written YAML beside a modelled actuator is manual application committed as source.

// WHY THE PUBLIC ROOT TRACKS main RATHER THAN A PINNED SHA. Pinning would make each run
// reproducible and would hide the exact defect this exists to catch: a deliberate public authority
// change silently invalidating a private claim. Tracking main makes that loud on the day it lands.
// The resolved SHA is printed by the run so a red is diagnosable and quotable -- a receipt names the
// commit it was measured at, never the branch.
data public_root_ref: NonEmptyStr = "main"

data public_checkout_path: NonEmptyStr = "public"

// A REFUSAL PROBE IS EVIDENCE, NOT DEBT, WHICH IS WHY IT IS NOT A KnownRed.
//
// Both dispositions run an entry and require a NONZERO exit, so the machinery is nearly the same
// and the difference is entirely in what a green means. A KnownRed that starts passing is GOOD
// news arriving through a stale row: the repository was repaired and the quarantine must retire.
// A RefusalProbe that starts passing is the WALL BEING GONE -- the invalid program it describes
// has become constructible -- and nothing about it should ever be retired as fixed.
//
// Filing the second under the first would put one name on two materially different contracts,
// which is the 3 meaning fork, and it would make the roster unreadable in the direction that
// matters: an operator scanning declared reds is reading a DEBT LIST, and a wall's evidence
// sitting in it is both a false debt and a wall nobody can find.
type WitnessDisposition
  = Enforced
  | KnownRed { reason: NonEmptyStr, expected_causes: List<NonEmptyStr>, restoration_trigger: NonEmptyStr }
  | RefusalProbe { guards: NonEmptyStr, expected_causes: List<NonEmptyStr>, dissolution: NonEmptyStr }

type PrivateWitness {
  entry: NonEmptyStr
  function: NonEmptyStr
  disposition: WitnessDisposition
}

// THE CONSTRUCTOR CONFINEMENT ON THE SELECTION CARRIERS, EXECUTED. Verified by running it:
// the probe exits 1 and names both walls. Without this row the confinement is a declaration
// nothing tests, which is exactly the state 4b calls specification-without-execution.
data probe_selection_assessment_construction: PrivateWitness = PrivateWitness {
  entry: "dag/test/probe/selection_assessment_construction_probe.dag",
  function: "probe_main",
  disposition: RefusalProbe {
    guards: "sole_constructor confinement on SelectionAssessment and ProcedureRegistration: a selection assessment may not be forged by a module outside the one that seals it, and neither may the procedure registration it would have to carry",
    expected_causes: [
      "sole_constructor type 'SelectionAssessment' cannot be constructed outside its defining module",
      "sole_constructor type 'ProcedureRegistration' cannot be constructed outside its defining module",
    ],
    dissolution: "this row retires ONLY if the confinement is deliberately removed, and then the wall goes with it. It is not retired by a repair, because there is nothing here to repair -- a green means the invalid program became constructible.",
  },
}

