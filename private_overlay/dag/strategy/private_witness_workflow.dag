fn witness_is_enforced(w: PrivateWitness) -> Bool {
  match w.disposition {
    Enforced => true,
    KnownRed { reason, restoration_trigger } => false,
    RefusalProbe { guards, expected_causes, dissolution } => false,
  }
}

fn enforced_witnesses() -> List<PrivateWitness> {
  filter(private_witnesses, w => witness_is_enforced(w: w))
}

// THE THREE DISPOSITIONS PARTITION, AND THIS FILTER IS WHY THAT HAD TO BE SAID OUT LOUD. It read
// "not enforced", which was a faithful complement while there were exactly two arms and became a
// silent mis-classification the moment a third arrived: a refusal probe is not enforced, so it
// would have been counted as a declared red -- reported in the quarantine census, read by an
// operator as debt, and its row proposed for retirement. The arm is matched, not complemented.
fn known_red_witnesses() -> List<PrivateWitness> {
  filter(private_witnesses, w => witness_is_known_red(w: w))
}

fn witness_is_known_red(w: PrivateWitness) -> Bool {
  match w.disposition {
    Enforced => false,
    KnownRed { reason, expected_causes, restoration_trigger } => true,
    RefusalProbe { guards, expected_causes, dissolution } => false,
  }
}

// PATHS ARE RELATIVE TO THE PUBLIC CHECKOUT, because gunbc refuses to run anywhere else. Measured
// on the first real CI run (gunbc-private run 32942165573): the binary panics with
// "process_workspace_root: cannot locate workspace — git rev-parse did not name a Cargo.toml+dag/
// tree" when its cwd is this repository, which has dag/ but no Cargo.toml. It resolves its
// workspace from the CWD, not from --source-root. So the step runs inside the public checkout.
//
// THE PRIVATE TREE IS COPIED UNDER THAT CHECKOUT, NOT REACHED WITH ../. Measured 2026-09-10 on
// public SHA 0d6b6653e0f (the same revision CI recorded on failing run 34451871767):
//   gunbc run --source-root dag --source-root src/v2 --source-root <overlay> --entry <year_end_plan>
// admits every module-scope annotation when <overlay> is a directory UNDER the process workspace
// (including a sibling spelled ../ann_priv_ci, and a two-file extra root _ann_probe). The same
// bytes under an absolute extra root /tmp/ann_priv panic at repo_relative_path_normalized.
// CI's spelling --source-root ../dag from inside public/ is that out-of-workspace extra root:
// process_workspace_root is the public git tree, and ../dag is the private overlay. Against that
// invocation the v1 binder reports UnattachedAtScopeEnd for every content-carrying // line and
// drops every bare `//` (annotation_attach_resolve: empty text with no following subject is a
// no-op). That is the 175/12 split on year_end_plan.dag, not a corpus migration. Copying the
// overlay to private_overlay/dag makes the extra root workspace-relative, which is the invocation
// that attaches a leading // to the next module item.
// THE DESTINATION IS OUTSIDE THE REPOSITORY ROOT, AND THAT IS THE WALL (2026-09-11).
//
// This used to be "private_overlay" - a path INSIDE the public checkout - and that is the shape
// that leaked. A session worktree is persistent and the dashboard's archive-time auto-push commits
// its state INCLUDING UNTRACKED FILES, so a private copy sitting anywhere under the repo root is
// one archive away from public. On 2026-09-11 that happened: 85,967 lines of private tree, finance
// included, pushed to public gunbc with a pull request opened automatically.
//
// A NAME CHECK WOULD NOT HAVE STOPPED IT, which is why this is a path fact rather than a lint.
// private_overlay, base_overlay, wb62_overlay, dag2 - the set of names a lane might choose is open,
// so a checker over names is a heuristic over an open world. What is closed is the QUESTION OF
// WHETHER THE COPY IS UNDER THE REPO ROOT AT ALL. The compose root is therefore a DETACHED
// WORKTREE outside the workspace: the copy never exists where an auto-push can reach it, and the
// recipe a lane copies from this file is the safe one rather than the hazardous one.
//
// gunbc REQUIRES a git checkout as its workspace root - a plain directory is refused with
// workspace_root is not inside a git checkout - so the compose root cannot simply be a temp
// directory. A detached worktree satisfies the compiler and sits outside the repo at once, which is
// why it is the construction available today rather than a compromise.
//
// THE NEXT RUNG IS UNCHANGED and is still the real dissolution: when gunbc admits an extra
// --source-root outside process_workspace_root with annotations attaching on the same terms, the
// copy and the worktree both disappear and --source-root ../dag returns. Until then this is the
// strongest available form.
data compose_root_env_default: NonEmptyStr = "$\{RUNNER_TEMP:-/tmp}/gunbc-private-compose"

data private_overlay_dir: NonEmptyStr = "$COMPOSE/private_overlay"

// DISSOLUTION NAMES THE CAPABILITY, NOT THE ARTIFACT. The copy is admitted while private CI
// cannot wait on a public compiler change. It is deleted when gunbc admits an extra
// --source-root whose directory is outside process_workspace_root with module-scope
// annotations attaching on the same terms as an in-workspace extra root — sufficient to
// restore `--source-root ../dag` without UnattachedAtScopeEnd on a file that attaches under
// a workspace-relative copy of the same bytes. "When the copy is no longer needed" is not
// the trigger: that is satisfied by anything. Authority for the class:
// gunbc.recurring_failure_mode.extra_source_root_outside_workspace_refuses_annotations_as_unattached.
data overlay_copy_dissolution: NonEmptyStr = "gunbc admits an extra --source-root outside process_workspace_root with module-scope annotations attaching as they do for an in-workspace extra root; then delete the private_overlay copy and restore --source-root ../dag"

// THE LOCAL METHOD, AND WHY IT IS A RECIPE FACT RATHER THAN A DISCIPLINE ONE.
//
// The copy above is what CI does, and CI does it inside a throwaway checkout. A SESSION doing the
// same thing inside its own worktree leaks the private repository: the dashboard's archive-time
// auto-push commits a worktree's state INCLUDING UNTRACKED FILES and pushes it. That happened on
// 2026-09-11 - a private tree of 85,967 lines, finance included, reached public gunbc and
// auto-opened a pull request before anyone noticed. The lane that did it was following THIS FILE'S
// recipe faithfully, which is why the method belongs here rather than in a warning somebody has to
// remember: every lane that runs these witnesses locally the documented way reproduces the hazard.
//
// "Clone gunbc-private outside the worktree" is necessary and NOT sufficient. gunbc refuses a
// workspace root that is not inside a git checkout, so the composed root has to be SOME public
// checkout - the question is only which one.
//
// THE METHOD: git worktree add --detach /tmp/claude-1000/SESSION-compose HEAD, put
// private_overlay/dag inside THAT, and run gunbc from there. It is a real git checkout, which the
// compiler requires, and it is not the registered session worktree, so archive-time auto-push has
// no reason to touch it.
//
// TWO DEAD ENDS, RECORDED SO NOBODY SPENDS THE TIME AGAIN. A plain directory copy under /tmp is
// refused: workspace_root is not inside a git checkout, run from the workspace. And cp -al into
// /tmp fails with Invalid cross-device link, so the copy cannot be made cheap with hardlinks.
//
// RECEIPT: year_end_plan_witness_main returns ExitSuccess when run from such a composed worktree,
// which is the evidence that this method actually executes the roster rather than merely avoiding
// the hazard. Re-derive it by running the entry from the composed root.
data overlay_local_method: NonEmptyStr = "Do NOT create private_overlay inside the session worktree - archive-time auto-push commits untracked files and leaks the private repo. Use: git worktree add --detach /tmp/claude-1000/SESSION-compose HEAD, put private_overlay/dag inside that, run gunbc there. A plain /tmp directory is refused because gunbc needs a git checkout, and cp -al across /tmp fails as a cross-device link."

// THE ROOT SET IS ONE FACT AND IS DECLARED ONCE. The argv below is DERIVED from it, and
// strategy.audit_packet's lens resolves citations against this same list rather than a second
// literal of it. That fork existed for one revision and review 65028 was right about what it would
// cost: add a fourth root to the runner and a lens carrying its own copy keeps resolving against a
// three-root corpus, so "resolved against the live corpus at render time" silently becomes a claim
// about a different corpus, with the witness green because it reads the same stale list. A stated
// dissolution trigger does not authorize minting the fork.
data source_roots: List<String> = ["dag", "src/v2", "private_overlay/dag"]

fn source_root_flag(root: String) -> String {
  join(["--source-root ", root], "")
}

data source_roots_argv: NonEmptyStr = join(map(source_roots, r => source_root_flag(root: r)), " ") as NonEmptyStr

data private_entry_prefix: NonEmptyStr = "private_overlay/"

// The private git tree as seen from the public checkout CWD -- used to READ committed
// projections, not to ingest .dag (that is private_entry_prefix after the overlay copy).
// THE COMMITTED FILES STILL HAVE TO BE READ, and the working directory is no longer the public
// checkout, so "../" no longer names the private repository. The compose root carries a symlink to
// it instead: one line in the recipe resolves the absolute path at setup time, and the model keeps
// a relative prefix it can state without knowing where the runner put anything.
data private_repo_prefix: NonEmptyStr = "private_repo/"

// ONE PROCESS FOR EVERY ENFORCED WITNESS, BECAUSE THE COST WAS NEVER THE WITNESSES.
//
// This roster used to emit one `gunbc run` per enforced witness. Measured on run 34462653642, the
// 33 completed invocations cost 82-107s each, mean 96s, spread under ten percent -- and witnesses
// doing wildly different amounts of work cost the same. A cost that does not vary with the work is
// not the work: it is the composed world, resolved and typechecked from scratch once per process,
// and the step unsets both cache roots so nothing carries between them. Fifty-one of the fifty-three
// minutes were one world acquired once per roster row, which is DESIGN section 2 redundancy at the
// coarsest possible grain. THE ROSTER SIZE IS NOT PART OF THE CLAIM and is deliberately not written
// here as a number: it was 33 rows when this was measured and 34 the same day, because #49 enrolled
// node_rental_witness. What is fixed is the shape -- one process per row before, five after, however
// many rows the roster carries.
//
// So the enforced half now runs as ONE entry -- test.claim.private_roster_witness -- which calls
// every enforced witness's main and folds their ProcessExits. The witnesses are untouched; what
// changed is how many worlds we pay for.
//
// WHY NOT claim_executor --required-floor, which is the public floor's own answer to this. Read
// before assuming: `run_required_floor(source_roots, commit, style)` discovers over the FULL
// inventory of every source root with no scope parameter -- `apply_discovery_scope_dirs_filter`
// exists but is reachable only from the discovery-corpus path, not from the required-floor one. So
// `--required-floor` over dag + src/v2 + private_overlay/dag does not run the private roster in one
// process; it runs the entire PUBLIC floor as well. Measured on public run 34502250692: 2,696
// modules resolved, 3,590 claims planned and executed, ~26 minutes inside the process. That would
// take this job from 53 minutes to ~35 AND re-run 3,590 public claims per private PR -- a larger
// redundancy than the one being deleted, and it would import public's reds into private's signal.

// THE AGGREGATE IS THE RUNNER, NOT A ROW OF THE ROSTER. It is deliberately absent from
// private_witnesses: the roster is the authority for WHAT must run and with what disposition, and
// the aggregate is one way of running the Enforced part of it. Putting it in the list would make it
// a witness that has to cover itself.
//
// THE TWO LISTS CANNOT SILENTLY DIVERGE. test.claim.private_roster_witness names each entry beside
// the main it calls, and its own first conjunct asserts set equality between those entries and the
// Enforced rows of THIS module, in both directions. Dropping a witness from the aggregate reds the
// aggregate; adding an Enforced row here without wiring it there reds it too. That check is the
// reason the roster stays consumed rather than becoming a list nothing reads (DESIGN section 3c).
data roster_aggregate: PrivateWitness = PrivateWitness {
  entry: "dag/test/claim/private_roster_witness_test.dag",
  function: "private_roster_main",
  disposition: Enforced,
}

// RESOLVE ATTRIBUTION SURVIVES ONE PROCESS. MEASURED, BECAUSE IT WAS THE ONE REAL OBJECTION.
//
// One process for the whole enforced roster trades away something if a witness module fails to
// RESOLVE: a module that will not resolve cannot be called, so one broken import fails this entry
// as a whole. That matters here specifically, because the public root tracks main rather than a
// pinned SHA so that a public authority change invalidating a private claim goes loud -- and that
// invalidation arrives as a resolve failure, not as an assertion failure. Collapsing thirty
// verdicts into one opaque red exactly where this instrument earns its keep would be a worse
// instrument, not a faster one.
//
// So it was measured rather than argued, by breaking a witness deliberately and reading what came
// back. Both shapes the real known-reds exhibit were tried. A missing MODULE:
//
//   error: resolve failed for <the aggregate entry>
//     cause: .../colo_market_witness_test.dag:2:1: error: unresolved import: module
//     'std.no_such_module_for_this_experiment' not found (imported by 'test.claim.colo_market_witness')
//
// and a missing NAME in a module that does resolve:
//
//   .../tab_group_witness_test.dag:3:29: error: name 'no_such_name_in_tab_group' not found in
//   module 'strategy.tab_group' (imported by 'test.claim.tab_group_witness')
//
// The diagnostic names the failing FILE, the LINE and COLUMN, and the MODULE THAT IMPORTED IT. Run
// alone, the same break prints the identical cause line; the only difference is which entry the
// envelope names. Attribution is preserved, so nothing needs to be added to recover it.
//
// AND THAT IS WHY THERE IS NO PER-WITNESS FALLBACK HERE. An earlier cut of this change followed a
// failing aggregate with a re-run of every witness, one process each, to attribute the failure. It
// would have been the absorbing fallback DESIGN section 5 names: cannot compute the failing witness
// -> run them all. The premise was false. The compiler already computes it, so the fallback would
// have spent forty-six minutes on every red re-deriving a fact that was already printed, and its
// existence would have implied a deficit in the diagnostic that measurement does not support.

fn roster_aggregate_run_line() -> String {
  join([
    "if out=$(run_one \"", private_entry_prefix, roster_aggregate.entry, "\" \"", roster_aggregate.function, "\" 2>&1); then\n",
    "  echo \"$out\"\n",
    "  echo \"PASS  every enforced private witness, in ONE process — ", roster_aggregate.entry, "\"\n",
    "else\n",
    "  echo \"$out\"\n",
    "  echo \"::error::FAIL the enforced private witness roster. Every failing witness is named in the output above: an assertion failure by its entry and its own reason, a resolve failure by file, line and importing module.\"\n",
    "  fail=1\n",
    "fi\n",
  ], "")
}

// STILL ONE EXPLICIT LINE PER ENTRY BELOW, no loop and no heredoc, and both exclusions are
// load-bearing rather than stylistic. This reasoning arrived with the per-witness enforced block
// that the roster aggregate replaced; it is carried here rather than deleted with that function,
// because the four non-enforced entries are still unrolled and it still governs them. A heredoc
// terminator cannot be used at all: this script is carried in a YAML block scalar, so every line is
// indented, and an indented EOF does not terminate a plain heredoc. And `... | while read` runs the
// loop body in a SUBSHELL, so a fail=1 set inside it is discarded when the pipe closes -- the run
// would report success over a failing witness, which is the fail-open arm this actuator exists to
// prevent. Unrolling costs nothing because the roster is derived from private_witnesses rather than
// hand-authored here.

// A KNOWN-RED IS PINNED TO ITS NAMED CAUSE, NOT TO "ANY NONZERO EXIT". Accepting every failure is
// the absorbing arm DESIGN section 5 forbids: it cannot tell the declared cause from a NEW one, so a
// quarantined witness silently becomes a place defects go to hide. This repository has now been bitten
// by exactly that three times in one PR - a module left un-migrated against a deleted std.pareto API,
// then stale imports of symbols removed in that migration, then a source-annotation violation - and
// each time the roster reported "known-red held" over a failure that had nothing to do with the
// missing extdep the row declares.
//
// So the run now REQUIRES the declared cause to appear in the output. A red for the stated reason
// holds; a red for a different reason stops the line and names the drift.
// THE DECLARED SET IS THE COMPLETE DESCRIPTION OF THE FAILURE, IN BOTH DIRECTIONS. The first
// version grepped for a single string, and its first real CI run proved that insufficient. The
// second required every declared cause to be PRESENT - and review found that still insufficient,
// correctly: presence alone never rejects an ADDITIONAL undeclared failure, so a fifth defect rides
// in behind the four as long as the four persist. That is the absorbing quarantine this mechanism
// exists to end, merely narrowed. I had claimed in the previous commit that a fifth failure would
// stop the line; it would not have, and I had not tested it.
//
// So the check runs both ways. Every declared cause must appear, and every diagnostic line the run
// emits must match some declared cause. Set equality, not containment. The resolve envelope is
// declared alongside the causes for the same reason - it is part of what the witness emits, and a
// set that silently exempts one line is not a complete description.
//
// Consequences, both intended: a NEW failure stops the line because it matches no declared cause,
// and FIXING one stops it because its declared cause stops appearing. Either way the roster has
// stopped describing the repository, which is the whole and only claim a quarantine makes.
fn expected_cause_check(entry: NonEmptyStr, function: NonEmptyStr, cause: NonEmptyStr) -> String {
  join([
    "  if printf '%s\\n' \"$out\" | grep -qF -- \"", cause, "\"; then :; else\n",
    "    echo \"::error::CAUSE DRIFT ", entry, " ", function, " — quarantined for a NAMED SET of causes and one of them did not occur. Expected to find: ", cause, "\"\n",
    "    fail=1\n",
    "    drift=1\n",
    "  fi\n",
  ], "")
}

fn undeclared_filter_step(cause: NonEmptyStr) -> String {
  join([" | grep -vF -- \"", cause, "\""], "")
}

fn known_red_run_line(w: PrivateWitness) -> String {
  match w.disposition {
    Enforced => "",
    RefusalProbe { guards, expected_causes, dissolution } => "",
    KnownRed { reason, expected_causes, restoration_trigger } => join([
      "if out=$(run_one \"", private_entry_prefix, w.entry, "\" \"", w.function, "\" 2>&1); then\n",
      "  echo \"$out\"\n",
      "  echo \"::error::STALE QUARANTINE ", w.entry, " ", w.function, " — a declared known-red witness PASSED. Retire its KnownRed row in strategy.private_witness_workflow rather than leaving the roster describing a repository that no longer exists.\"\n",
      "  fail=1\n",
      "else\n",
      "  echo \"$out\"\n",
      "  drift=0\n",
      fold(expected_causes, init: "", f: fn(acc, c) { join([acc, expected_cause_check(entry: w.entry, function: w.function, cause: c)], "") }),
      "  undeclared=$(printf '%s\\n' \"$out\" | grep -F -- 'error:'",
      fold(expected_causes, init: "", f: fn(acc, c) { join([acc, undeclared_filter_step(cause: c)], "") }),
      " || true)\n",
      "  if [ -n \"$undeclared\" ]; then\n",
      "    echo \"::error::UNDECLARED FAILURE ", w.entry, " ", w.function, " — this witness emitted a diagnostic its KnownRed row does not declare. A quarantine that only requires its OWN causes to be present still hides every new defect that arrives beside them. Declare it or fix it:\"\n",
      "    printf '%s\\n' \"$undeclared\"\n",
      "    fail=1\n",
      "    drift=1\n",
      "  fi\n",
      "  if [ \"$drift\" = \"0\" ]; then\n",
      "    echo \"known-red held  ", w.entry, " ", w.function, " — failed for exactly its declared causes\"\n",
      "  fi\n",
      "fi\n",
    ], ""),
  }
}

fn enforced_block() -> String {
  roster_aggregate_run_line()
}

fn refusal_probe_witnesses() -> List<PrivateWitness> {
  filter(private_witnesses, w => witness_is_refusal_probe(w: w))
}

fn witness_is_refusal_probe(w: PrivateWitness) -> Bool {
  match w.disposition {
    Enforced => false,
    KnownRed { reason, restoration_trigger } => false,
    RefusalProbe { guards, expected_causes, dissolution } => true,
  }
}

fn refusal_probe_block() -> String {
  fold(refusal_probe_witnesses(), init: "", f: fn(acc, w) { join([acc, refusal_probe_run_line(w: w)], "") })
}

fn refusal_probe_run_line(w: PrivateWitness) -> String {
  match w.disposition {
    Enforced => "",
    KnownRed { reason, expected_causes, restoration_trigger } => "",
    RefusalProbe { guards, expected_causes, dissolution } => join([
      "if out=$(run_one \"", private_entry_prefix, w.entry, "\" \"", w.function, "\" 2>&1); then\n",
      "  echo \"$out\"\n",
      "  echo \"::error::WALL GONE ", w.entry, " — this program MUST NOT COMPILE and it compiled. What it guards: ", guards, "\"\n",
      "  fail=1\n",
      "else\n",
      "  probe_drift=0\n",
      fold(expected_causes, init: "", f: fn(acc, c) { join([acc, probe_cause_check(entry: w.entry, cause: c)], "") }),
      "  if [ \"$probe_drift\" = \"0\" ]; then\n",
      "    echo \"refusal probe held  ", w.entry, " — refused for exactly the walls it names\"\n",
      "  fi\n",
      "fi\n",
    ], ""),
  }
}

// A PROBE THAT REFUSES FOR THE WRONG REASON IS NOT EVIDENCE. Any nonzero exit would satisfy a bare
// expecting-red check -- a typo in an import refuses too -- so the diagnostic is compared, and a
// missing declared cause fails the run rather than passing quietly on the exit code alone.
fn probe_cause_check(entry: NonEmptyStr, cause: NonEmptyStr) -> String {
  join([
    "  if ! printf '%s\\n' \"$out\" | grep -qF -- \"", cause, "\"; then\n",
    "    echo \"::error::PROBE DRIFT ", entry, " — refused, but NOT for its declared cause: ", cause, ". A probe that refuses for a different reason is measuring a different wall.\"\n",
    "    fail=1\n",
    "    probe_drift=1\n",
    "  fi\n",
  ], "")
}

// WHY THE FOUR NON-ENFORCED ENTRIES KEEP ONE PROCESS EACH, and what would end that.
//
// The two known-reds and the two refusal probes are NOT in the aggregate, and the reason is a
// capability gap in the public floor rather than an oversight here. On these four entries this
// repository's mechanism is STRICTLY STRONGER than the public one:
//
//   1. A KnownRed here declares its CAUSES, and the run requires set equality in both directions --
//      every declared cause present, every emitted diagnostic declared. The public roster,
//      v2.workflow.floor_expected_red, is a List<String> of IDENTITIES with no cause field at all.
//      It detects a stale quarantine and nothing else: no cause drift, and no new defect arriving
//      beside the declared ones. Enrolling these two there would delete the check.
//   2. A RefusalProbe here is a whole program that MUST NOT COMPILE, checked for its own refusal
//      text. The floor has no must-not-compile row type; its discovery enrolls `test fn` decls,
//      which is a shape a non-compiling program cannot take.
//   3. Both known-reds fail at RESOLVE, not at assertion. The floor's expected-red vocabulary is
//      about claim outcomes -- a claim that ran and disagreed -- and floor_expected_red's own header
//      records its worst historical error as 101 rows enrolled as failing that had in fact never
//      reached their subject. Enrolling two resolve failures there would reproduce that defect
//      knowingly.
//
// So this is not private lagging public. Matching public here would be a regression, and a faster
// CI that weakened a quarantine or a wall is worse than the fifty-three minutes it saved.
//
// THE TRIGGER NAMES CAPABILITIES, NOT ARTIFACTS, because a trigger naming a PR or "floor work" is
// satisfied while the capability stays dead. All three must hold before these four can join a
// shared process, and the third is the one an earlier draft of this reasoning missed: without
// discovery scoping the floor cannot host a private roster at ANY strength, so the first two could
// land and the bridge would still be load-bearing.
data shared_process_dissolution: NonEmptyStr = "the four non-enforced entries join a shared process when the public floor gains ALL THREE of: (i) an expected-red row type carrying declared causes, with cause-drift and undeclared-failure detection at the grain this module's KnownRed rows have today; (ii) a must-not-compile row type carrying per-probe expected refusal text; and (iii) discovery scoping on the required-floor path, so a run can be bounded to one source root instead of every module under all of them. Until all three hold, each of these entries keeps its own process and its own checks."

// WHAT DOES NOT MIGRATE, EVER, and it is worth saying because (i) above will read like an
// invitation. The declared causes name private modules and private import failures. Even once the
// public floor can carry causes, these rows stay in this repository: moving them would publish
// private module identities into the public corpus, which is the one thing the placement-based
// privacy model of this repo exists to prevent. What (i) unlocks is a private roster expressed in a
// public VOCABULARY, never private rows stored in public SOURCE.

fn known_red_block() -> String {
  fold(known_red_witnesses(), init: "", f: fn(acc, w) { join([acc, known_red_run_line(w: w)], "") })
}

// THE LINE STOPS ON A FAILURE AND ON A STALE QUARANTINE. Every enforced witness must exit zero;
// every declared red must exit nonzero. A red that has started passing is not good news the run may
// swallow -- it means the roster is describing a repository that no longer exists, so it fails here
// and the row is retired deliberately.
fn witness_run_script() -> String {
  join([
    "set -u\n",
    "cd ", public_checkout_path, "\n",
    "GUNBC=\"$PWD/target/release/gunbc\"\n",
    "PRIVATE_ROOT=\"$(cd .. && pwd)\"\n",
    "COMPOSE=\"", compose_root_env_default, "\"\n",
    "rm -rf \"$COMPOSE\"\n",
    "git worktree prune\n",
    "git worktree add --detach \"$COMPOSE\" HEAD\n",
    "mkdir -p ", private_overlay_dir, "\n",
    "cp -a \"$PRIVATE_ROOT/dag\" ", private_overlay_dir, "/dag\n",
    "ln -sfn \"$PRIVATE_ROOT\" \"$COMPOSE/private_repo\"\n",
    "cd \"$COMPOSE\"\n",
    "echo \"private_overlay is a generated ingest copy of the private checkout, composed into a detached worktree OUTSIDE the repository root so no auto-push can reach it; do not edit it. Edit the private checkout. Dissolves when: ", overlay_copy_dissolution, "\"\n",
    "echo \"LOCAL RUNS: ", overlay_local_method, "\"\n",
    "echo \"the four non-enforced entries run one process each. Dissolves when: ", shared_process_dissolution, "\"\n",
    "unset GUNBC_RESOLVED_GRAPH_CACHE_DIR || true\n",
    "unset GUNBC_NATIVE_CACHE_ROOT || true\n",
    "fail=0\n",
    "run_one() {\n",
    "  \"$GUNBC\" run ", source_roots_argv, " --entry \"$1\" --function \"$2\"\n",
    "}\n",
    enforced_block(),
    known_red_block(),
    refusal_probe_block(),
    "exit $fail\n",
  ], "")
}

fn public_revision_receipt_script() -> String {
  join([
    "cd ", public_checkout_path, "\n",
    "echo \"public gunbc resolved to $(git rev-parse HEAD)\"\n",
    "echo \"tracking ref: ", public_root_ref, "\"\n",
  ], "")
}

