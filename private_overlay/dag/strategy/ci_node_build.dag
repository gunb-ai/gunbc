// ---------------------------------------------------------------------------------------------
// THE BOARD. Read from the existing carrier rather than restated: 2 sockets, 16 DIMM slots.
// ---------------------------------------------------------------------------------------------

fn board_socket_count() -> Nat { gigabyte_mp72_hb0_physical_profile.socket_count }
fn board_dimm_slots() -> Nat { gigabyte_mp72_hb0_physical_profile.dimm_slots }
// A board is a fact bundle the candidate generator crosses with processors and memory:
// geometry from the cited public profile, an observed market price, an Altra Max support
// standing, and a planning draw. Adding a board is adding ONE row here.
type AltraMaxSupport
  = MaxSupportedObserved { basis: NonEmptyStr }
  | MaxConditionalOnFirmware { obligation: NonEmptyStr }

// Depth is the fact that separates a price from a fleet: a rate with one findable unit can
// seed a pilot but cannot reorganize the build plan. A scarce board's candidates land
// NotComputable in the frontier (visible, priced, not comparable, and NOT
// allowed to dominate buyable candidates) until sourcing is proven.
type SupplyDepth
  = DepthObserved { units: Nat, note: NonEmptyStr }
  | DepthAvailableUncounted { note: NonEmptyStr }
  | DepthScarce { obligation: NonEmptyStr }

type BoardFacts {
  label: NonEmptyStr
  socket: CpuSocket
  route: SupplyRoute
  socket_count: Nat
  dimm_slots: Nat
  max_data_rate_mts: Nat
  altra_max_support: AltraMaxSupport
  board_price_micro: Int
  price_note: NonEmptyStr
  depth: SupplyDepth
  planning_node_watts: Nat
  observed_on: NonEmptyStr
  rate_history: List<MarketRateObservation>
}

