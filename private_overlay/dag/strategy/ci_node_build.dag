  depth: DepthAvailableUncounted { note: "available around 2,000 each; no count observed" },
  planned_dimm_population: 16,
  max_data_rate_mt_s: 3200,
  condition: UsedUntested { obligation: "Liquidation barebones pull: no test report, no return standing recorded. Firmware images are NDA-gated for secondhand buyers - obtain BIOS, BMC and SCP images from the seller per the pilot arrival checklist before treating the unit as reflashable." },
  unit_price_micro: 2000000000,
  supply: PlanningRate { grade: ObservedMarketRate { note: "Operator quote 2026-08-18: Mt. Jade 2U barebones available around 2,000 dollars each, no RAM. One pilot unit was ordered 2026-08-09 at roughly 3-4k loaded; its arrival measurements replace these planning figures." } },
