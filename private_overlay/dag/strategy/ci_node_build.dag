// WHAT A NODE COSTS TO BUILD, and how many sellable units that build actually yields.
//
// RETRACTION, and it is the whole point of this module's current shape. An earlier version of this
// work implied that more memory and more cores were better, and the 64-GiB population came out
// ahead on capex per unit. That conclusion was drawn against an ASSUMED memory price curve. The
// operator's actual marketplace observations invert it: 64-GiB RDIMMs are presently at a price
// cliff, not on a curve, and the cheapest balanced point is a SMALLER processor with mid-density
// memory.
//
// The lesson generalizes past this build. The hardware advantage is not "buy the most cores". It is
// finding the cheapest balanced point between the CPU liquidation curve, the DIMM density curve and
// the product's actual CPU-to-RAM ratio. Those three move independently and the answer moves with
// them, so the model carries the observations and derives the answer rather than carrying the
// answer.
//
// TWO LAYERS, and keeping them apart is what makes this model usable.
//
//   Planning market rate  -> supports Pareto analysis, capex estimates, margins and break-even
//   Procurement receipt   -> required only before a purchase or build authorization
//
// Everything in this module is the FIRST layer. It answers "assuming these parts stay available near
// these prices, which architecture is economically preferable" - not "can this one seller furnish
// sixteen modules today". The second question is a real gate and it lives at the bottom of the file,
// where it blocks a purchase and nothing else.
//
// Requiring receipt-grade evidence to ask which configuration looks sensible makes the model brittle
// and answers nothing. Every planning figure carries the grade of evidence behind it instead.

// What kind of evidence a figure rests on. The page renders this beside every number, so a planning
// estimate can never be mistaken for a receipt.
type EvidenceGrade
  = PlanningEstimate { note: NonEmptyStr }
  | ObservedMarketRate { note: NonEmptyStr }
  | QuotedExpense { note: NonEmptyStr }
  | PurchaseReceipt { note: NonEmptyStr }
  | MeasuredOperatingCost { note: NonEmptyStr }

fn evidence_grade_label(g: EvidenceGrade) -> NonEmptyStr {
  match g {
    PlanningEstimate { note } => "planning estimate",
    ObservedMarketRate { note } => "market rate",
    QuotedExpense { note } => "quoted",
    PurchaseReceipt { note } => "receipt",
    MeasuredOperatingCost { note } => "measured",
  }
}

fn grade_is_receipt(g: EvidenceGrade) -> Bool {
  match g {
    PurchaseReceipt { note } => true,
    MeasuredOperatingCost { note } => true,
    PlanningEstimate { note } => false,
    ObservedMarketRate { note } => false,
    QuotedExpense { note } => false,
  }
}

type ProductCondition
  = NewSealed { note: NonEmptyStr }
  | UsedTested { note: NonEmptyStr }
  | UsedUntested { obligation: NonEmptyStr }
  | ConditionUnread { obligation: NonEmptyStr }

fn condition_label(c: ProductCondition) -> NonEmptyStr {
  match c {
    NewSealed { note } => "new",
    UsedTested { note } => "used, tested",
    UsedUntested { obligation } => "used, untested",
    ConditionUnread { obligation } => "condition unread",
  }
}

// SUPPLY is treated as a market rate, not as a lot size. A single listing is where the number came
// from, but the build decision is about what a part costs when you go looking for sixteen of them,
// not about whether one seller happens to hold sixteen today. Assembling a population across several
// used lots is ordinary purchasing; it is a logistics problem and it does not change the price.
//
// The assumption is still recorded, because it is an assumption: if 32-GiB modules turn out not to
// be consistently available near this rate, the frontier moves.
type SupplyStanding
  = PlanningRate { grade: EvidenceGrade }
  | SupplyUnread { obligation: NonEmptyStr }

fn supply_label(q: SupplyStanding) -> NonEmptyStr {
  match q {
    PlanningRate { grade } => evidence_grade_label(g: grade),
    SupplyUnread { obligation } => "no rate",
  }
}

// A candidate is COMPUTABLE when every one of its inputs has a planning rate. A missing rate is not
// a zero and not an average; it makes the candidate uncomparable and says so.
fn supply_is_assumed(q: SupplyStanding) -> Bool {
  match q {
    PlanningRate { grade } => true,
    SupplyUnread { obligation } => false,
  }
}

data no_obligations: List<NonEmptyStr> = []

// A one-element list whose element type is pinned by the parameter. A bare string literal in a list
// infers List<String>, which will not meet a List<NonEmptyStr> return type.
fn one_note(text: NonEmptyStr) -> List<NonEmptyStr> { [text] }

// MARKET RATES MOVE, and a superseded reading is history rather than deletion (operator
// directive 2026-08-18: "we need to model market rates somehow"). Every observation row
// carries its CURRENT planning rate in unit_price_micro plus the dated readings it
// superseded, so a price move is visible as a fact with a direction instead of a silent
// edit. The three same-day receipts that forced this: Mt. Jade 2,600 -> 2,000, 64 GiB
// DIMMs 499 -> 210, 32 GiB 100 -> 110.
// WHERE A PART COMES FROM decides which levies apply (operator 2026-08-18: include sales
// tax and duties where applicable - Mt. Collins has no import; NYC sales tax on everything).
// Domestic purchases pay sales tax only; imports pay the duty reserve AND sales/use tax; an
// unread route keeps the duty reserve conservatively until sourcing is known.
type SupplyRoute
  = DomesticRoute { note: NonEmptyStr }
  | ImportRoute { note: NonEmptyStr }
  | RouteUnread { obligation: NonEmptyStr }

type MarketRateObservation {
  price_micro: Int
  observed_on: NonEmptyStr
  source_note: NonEmptyStr
}

data no_rate_history: List<MarketRateObservation> = []

type MemoryLotObservation {
  label: NonEmptyStr
  part_description: NonEmptyStr
  capacity_gib: Nat
  route: SupplyRoute
  depth: SupplyDepth
  data_rate_mt_s: Nat
  organization: NonEmptyStr
  condition: ProductCondition
  unit_price_micro: Int
  supply: SupplyStanding
  seller: NonEmptyStr
  observed_on: NonEmptyStr
  rate_history: List<MarketRateObservation>
}

// The compatibility-bearing family axis: Altra and Altra Max share the socket, but a
// board's Max support can be conditional on firmware - a fact the candidate generator
// consumes rather than a note a buyer has to remember.
type ProcessorFamily = AltraFamily | AltraMaxFamily

type ProcessorLotObservation {
  label: NonEmptyStr
  sku: NonEmptyStr
  family: ProcessorFamily
  socket: CpuSocket
  route: SupplyRoute
  depth: SupplyDepth
  physical_cores: Nat
  condition: ProductCondition
  unit_price_micro: Int
  supply: SupplyStanding
  observed_on: NonEmptyStr
  rate_history: List<MarketRateObservation>
}

// A WHOLE-SYSTEM LOT: a complete or near-complete server observed at one price, processors
// included, versus the loose-parts path above. Operator direction 2026-08-18: the Mt. Jade and
// Mt. Collins supply enters the frontier at the operator-quoted prices, so the candidate shape
// must carry either a loose board build or a system lot without forking the comparison.
type SystemLotObservation {
  label: NonEmptyStr
  system_description: NonEmptyStr
  included_processor_sku: NonEmptyStr
  included_core_count_total: Nat
  route: SupplyRoute
  depth: SupplyDepth
  planned_dimm_population: Nat
  max_data_rate_mt_s: Nat
  condition: ProductCondition
  unit_price_micro: Int
  supply: SupplyStanding
  seller: NonEmptyStr
  observed_on: NonEmptyStr
  rate_history: List<MarketRateObservation>
}

// The platform is the axis that decides which parts a candidate still has to buy. A loose
// board build buys board, duty reserve, processors and the finishing BOM; a system lot has
// processors, chassis, power and cooling in its one price and still buys memory, scratch and
// rails. Collapsing these into one price field is how a lot would be credited nothing for
// the chassis it includes, so the platform is a sum, not a note.
type NodePlatform
  = LooseBoardBuild { board: BoardFacts, processor: ProcessorLotObservation }
  | WholeSystemLot { lot: SystemLotObservation }

