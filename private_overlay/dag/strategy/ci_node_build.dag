data memory_lots: List<MemoryLotObservation> = [dimm_16gib_lot, dimm_32gib_lot, dimm_64gib_lot]

// The band the frontier is tested against. A baseline with no band is a number pretending to be a
// fact; a band says how wrong it can be before the answer changes.
data dimm_32gib_low_micro: Int = 80000000
data dimm_32gib_high_micro: Int = 120000000

data memory_band_note: NonEmptyStr = "The 32-GiB planning baseline is 110 dollars a module with a sensitivity band of 80 to 120. The frontier is checked at both ends rather than at the baseline alone, because a build recommendation that only survives at one price is not a recommendation."

fn memory_price_per_gib_micro(m: MemoryLotObservation) -> Int {
  m.unit_price_micro / m.capacity_gib
}

// THE CLIFF, derived rather than described. 32-GiB modules are cheaper per gibibyte than 16-GiB
// modules; 64-GiB modules are roughly twice the price per gibibyte of either. That is not a curve
// with a smooth optimum, it is a step, and stepping over it costs more than four 32-GiB modules for
// twice the memory of one.
fn memory_cliff_holds() -> Bool {
  memory_price_per_gib_micro(m: dimm_32gib_lot) < memory_price_per_gib_micro(m: dimm_16gib_lot)
    && memory_price_per_gib_micro(m: dimm_64gib_lot) > memory_price_per_gib_micro(m: dimm_32gib_lot) * 2
}

data memory_curve_note: NonEmptyStr = "After the 2026-08-18 re-quotes the curve is nearly flat per gibibyte: 3.13 dollars per GiB at 16, 3.44 at 32, 3.28 at 64 - the 64-GiB price cliff that used to drive the density decision is gone (499 -> 210, see the rate history), which is exactly what put the dense and mid-density builds back on the frontier. The prices are observations, not constants; the frontier is re-derived when they move."

