data known_boards: List<BoardFacts> = [mp72_board_facts, asrock_board_facts, supermicro_r12spd_facts]

fn duty_for(price_micro: Int, route: SupplyRoute) -> Int {
  match route {
    DomesticRoute { note } => 0,
    ImportRoute { note } => price_micro * duty_reserve_permille / 1000,
    RouteUnread { obligation } => price_micro * duty_reserve_permille / 1000,
  }
}

fn board_with_duty_for(b: BoardFacts) -> Int {
  b.board_price_micro + duty_for(price_micro: b.board_price_micro, route: b.route)
}

data sales_tax_per_100k: Int = 8875

data sales_tax_note: NonEmptyStr = "NYC combined sales/use tax at 8.875 percent, applied to EVERY hardware purchase line (operator directive 2026-08-18) - domestic purchases pay it at sale, imports as use tax. It is applied at the planning-capex assembly so every candidate carries it uniformly; the rate is a declared planning fact, and a New Jersey delivery address would change it, which is a placement-coupled question noted rather than modeled."

fn with_sales_tax(price_micro: Int) -> Int {
  price_micro + price_micro * sales_tax_per_100k / 100000
}

type CpuBoardCompatibility
  = CompatibleObserved
  | CompatibleConditional { obligation: NonEmptyStr }

fn board_cpu_compatibility(b: BoardFacts, p: ProcessorLotObservation) -> CpuBoardCompatibility {
  match p.family {
    AltraFamily => CompatibleObserved,
    AltraMaxFamily => match b.altra_max_support {
      MaxSupportedObserved { basis } => CompatibleObserved,
      MaxConditionalOnFirmware { obligation } => CompatibleConditional { obligation: obligation },
    },
  }
}

fn board_max_data_rate_mt_s() -> Nat { megatransfers_per_second_count(r: gigabyte_mp72_hb0_physical_profile.max_data_rate) }

data board_price_micro: Int = 800000000

// The 30 percent import figure is a RESERVE, not a tariff. A duty rate belongs to a confirmed
// classification for a specific part on a specific commercial invoice, and none of those exists.
data duty_reserve_permille: Int = 300

data duty_reserve_note: NonEmptyStr = "The 30 percent import figure is a duty-reserve hypothesis, not an observed tariff. It is a planning reserve against duty, freight and brokerage on a Chinese-origin board. A confirmed classification, a commercial invoice and a broker quote replace it; until then no candidate here may report a landed cost."

fn board_with_duty_micro() -> Int {
  board_price_micro + board_price_micro * duty_reserve_permille / 1000
}

// ---------------------------------------------------------------------------------------------
// CANDIDATES. A candidate is a board population times a processor lot times a memory lot, and a
// node count - because two smaller nodes is a real alternative to one dense node and has to be
// comparable on the same axes.
// ---------------------------------------------------------------------------------------------

type NodeBuildCandidate {
  label: NonEmptyStr
  node_count: Nat
  platform: NodePlatform
  memory: MemoryLotObservation
}

data nat_zero: Nat = 0

fn cores_per_node(c: NodeBuildCandidate) -> Nat {
  match c.platform {
    LooseBoardBuild { board, processor } => board.socket_count * processor.physical_cores,
    WholeSystemLot { lot } => lot.included_core_count_total,
  }
}

// How many DIMMs the candidate actually buys and installs. The loose build fills every slot
// on the board; a system lot follows the section-4 bandwidth-before-capacity policy - one
// DIMM per memory channel - and its spec-total slot count stays in the cited platform rows
// (32 at 2DPC for both Mt. Jade and Mt. Collins), read by the fns below so a witness can
// hold the planned population against the specification.
fn populated_dimm_count(c: NodeBuildCandidate) -> Nat {
  match c.platform {
    LooseBoardBuild { board, processor } => board.dimm_slots,
    WholeSystemLot { lot } => lot.planned_dimm_population,
  }
}

fn mt_jade_spec_dimm_slots() -> Int { mt_jade_motherboard_mechanical.ddr4_dimms_total }

fn mt_collins_spec_dimm_slots() -> Nat { mt_collins_platform_mechanical.ddr4_dimms_total }

fn memory_gib_per_node(c: NodeBuildCandidate) -> Nat {
  populated_dimm_count(c: c) * c.memory.capacity_gib
}

fn total_cores(c: NodeBuildCandidate) -> Nat { c.node_count * cores_per_node(c: c) }
fn total_memory_gib(c: NodeBuildCandidate) -> Nat { c.node_count * memory_gib_per_node(c: c) }

// The product's ratio is strategy.ci_sellable_unit ci_sellable_unit (one core, three decimal GB),
// converted from the binary GiB the DIMMs carry in exactly one place; whichever of cores and
// memory runs out first is the capacity, and the other is paid for and unsellable.
fn standard_units_per_node(c: NodeBuildCandidate) -> Nat {
  nat_min(a: cores_per_node(c: c), b: units_by_memory_gib(gib: memory_gib_per_node(c: c)))
}

fn standard_units(c: NodeBuildCandidate) -> Nat {
  c.node_count * standard_units_per_node(c: c)
}

fn stranded_cores(c: NodeBuildCandidate) -> Nat {
  let by_memory = units_by_memory_gib(gib: memory_gib_per_node(c: c))
  let per_node = if cores_per_node(c: c) > by_memory { cores_per_node(c: c) - by_memory } else { nat_zero }
  c.node_count * per_node
}

fn unused_standard_memory_gib(c: NodeBuildCandidate) -> Nat {
  let used = required_memory_gib_ceiling_for_units(units: standard_units_per_node(c: c))
  let per_node = if memory_gib_per_node(c: c) > used { memory_gib_per_node(c: c) - used } else { nat_zero }
  c.node_count * per_node
}

// ---------------------------------------------------------------------------------------------
// CAPACITY RECEIPT. Reserves are subtracted per node, so a two-node candidate pays them twice.
// ---------------------------------------------------------------------------------------------

data host_reserved_cores: Nat = 4
data host_reserved_memory_gib: Nat = 16
data maintenance_reserve_units: Nat = 4
data admission_headroom_units: Nat = 4

data reserve_basis_note: NonEmptyStr = "Host reserve, maintenance reserve and admission headroom are planning figures, not measurements, and they are charged per node - so two smaller nodes pay them twice. The fleet carrier knows the real host reserve for srv1 through srv4 and this module does not yet read it. They are stated so revenue is computed after a subtraction rather than before one."

type SellableCapacityReceipt {
  physical_cores: Nat
  memory_gib: Nat
  memory_bound_units: Nat
  standard_units: Nat
  host_reserved_cores: Nat
  host_reserved_memory_gib: Nat
  reserved_units: Nat
  sellable_units: Nat
}

fn sellable_units_per_node(c: NodeBuildCandidate) -> Nat {
  let cores_left = cores_per_node(c: c) - host_reserved_cores
  let gib_left = memory_gib_per_node(c: c) - host_reserved_memory_gib
  let bound = nat_min(a: cores_left, b: units_by_memory_gib(gib: gib_left))
  bound - maintenance_reserve_units - admission_headroom_units
}

fn capacity_receipt(c: NodeBuildCandidate) -> SellableCapacityReceipt {
  SellableCapacityReceipt {
    physical_cores: total_cores(c: c),
    memory_gib: total_memory_gib(c: c),
    memory_bound_units: units_by_memory_gib(gib: total_memory_gib(c: c)),
    standard_units: standard_units(c: c),
    host_reserved_cores: c.node_count * host_reserved_cores,
    host_reserved_memory_gib: c.node_count * host_reserved_memory_gib,
    reserved_units: c.node_count * (maintenance_reserve_units + admission_headroom_units),
    sellable_units: c.node_count * sellable_units_per_node(c: c),
  }
}

fn sellable_units(c: NodeBuildCandidate) -> Nat {
  capacity_receipt(c: c).sellable_units
}

// ---------------------------------------------------------------------------------------------
// CAPEX. Known lines only. The standing refuses to call any of it a landed cost.
// ---------------------------------------------------------------------------------------------

fn known_capex_per_node_micro(c: NodeBuildCandidate) -> Int {
  let memory = populated_dimm_count(c: c) * c.memory.unit_price_micro
  match c.platform {
    LooseBoardBuild { board, processor } =>
      board_with_duty_for(b: board) + board.socket_count * processor.unit_price_micro + memory,
    WholeSystemLot { lot } => lot.unit_price_micro + duty_for(price_micro: lot.unit_price_micro, route: lot.route) + memory,
  }
}

fn known_capex_micro(c: NodeBuildCandidate) -> Int {
  c.node_count * known_capex_per_node_micro(c: c)
}

fn known_capex_per_unit_micro(c: NodeBuildCandidate) -> Int {
  let units = sellable_units(c: c)
  if units > 0 { known_capex_micro(c: c) / units } else { 0 - 1 }
}

data missing_bom_lines: List<NonEmptyStr> = [
  "two processor coolers per node",
  "power supply per node",
  "NVMe scratch per node",
  "board carrier and chassis hardware per node",
  "cables and I/O per node",
  "network boot and management wiring",
  "freight, brokerage and taxes as actually assessed",
  "spare parts allowance",
]

type LandedCapexStanding
  = LandedCapexResolved { usd_micro: Int, receipt: NonEmptyStr }
  | LandedCapexIncomplete { known_subtotal_micro: Int, missing: List<NonEmptyStr>, obligation: NonEmptyStr }

fn landed_capex(c: NodeBuildCandidate) -> LandedCapexStanding {
  LandedCapexIncomplete {
    known_subtotal_micro: known_capex_micro(c: c),
    missing: missing_bom_lines,
    obligation: "The subtotal covers board, duty reserve, processors and memory only, and every one of those is a marketplace listing rather than an invoice. A two-node candidate duplicates every missing line, which is exactly where the dense-versus-split comparison will move once they are priced.",
  }
}

// A planning capex that also feeds the frontier's capex axes. The finishing allowance is per
// node AND per platform: a loose build still buys coolers, PSU, scratch, carrier and cables,
// while a system lot arrives with chassis, power distribution, supplies and coolers in its
// one price and still buys scratch, rails and cables. Charging both shapes the same flat
// figure - or comparing on bare parts subtotals - would credit the lot nothing for what its
// price includes, which is exactly the asymmetry that made the earlier known-capex-only
// comparison honest between loose builds and wrong across platforms.
data finishing_allowance_per_node_micro: Int = 880000000

data system_lot_finishing_allowance_micro: Int = 300000000

data finishing_allowance_note: NonEmptyStr = "The loose-build finishing allowance stands in for coolers, PSU, scratch, carrier and cables at a flat 880 dollars per node; the system-lot allowance stands in for scratch, rails and cables at a flat 300 dollars because the lot price already carries chassis, power and cooling. Both are assumptions rather than quotes, they are the numbers that decide loose-versus-system and split-versus-dense, and they are the next figures worth pricing properly."

fn finishing_for(c: NodeBuildCandidate) -> Int {
  match c.platform {
    LooseBoardBuild { board, processor } => finishing_allowance_per_node_micro,
    WholeSystemLot { lot } => system_lot_finishing_allowance_micro,
  }
}

fn planning_capex_micro(c: NodeBuildCandidate) -> Int {
  with_sales_tax(price_micro: known_capex_micro(c: c) + c.node_count * finishing_for(c: c))
}

fn planning_capex_per_unit_micro(c: NodeBuildCandidate) -> Int {
  let units = sellable_units(c: c)
  if units > 0 { planning_capex_micro(c: c) / units } else { 0 - 1 }
}

// THE BAND WAS DECLARED AND NEVER EXECUTED. memory_band_note has said since it was written that
// "the frontier is checked at both ends rather than at the baseline alone", but the only consumer of
// that claim lives inside a witness that is quarantined KnownRed for an unrelated missing extdep, so
// the sentence has never once run. What follows is the executable form of it.
//
// THE BAND IS A SHARED PARAMETER, NOT PER-CANDIDATE EVIDENCE WIDTH, and the distinction decides the
// carrier. There is ONE 32-GiB market price, and in any world it applies to every candidate at once.
// Handing each candidate its own [low, high] capex interval and comparing those intervals asks a
// different and wrong question - it admits a world where one build buys the shared DIMM at 80 while
// another buys it at 120 - and it converts facts that hold at EVERY price into "undecided". The
// measured case: 2xQ80 is cheaper than 2xQ64 by a constant 151 dollars at both ends of the band, yet
// their marginal intervals overlap. So the price is varied as a scenario over the whole field, and
// within one scenario a capex is exact.
fn memory_is_banded_32gib(c: NodeBuildCandidate) -> Bool {
  c.memory.capacity_gib == 32
}

// How hard the shared price pushes this candidate: the number of banded modules the build buys. Two
// candidates with the SAME coefficient move together under the parameter, so a strict ordering
// between them at one price is a strict ordering at every price - which is what makes the endpoint
// check sufficient for such a pair rather than merely suggestive.
fn memory_price_coefficient(c: NodeBuildCandidate) -> Nat {
  if memory_is_banded_32gib(c: c) { c.node_count * populated_dimm_count(c: c) } else { nat_zero }
}

fn capex_at_32gib_price_micro(c: NodeBuildCandidate, unit_price_micro: Int) -> Int {
  let per_node_delta = populated_dimm_count(c: c) * (unit_price_micro - c.memory.unit_price_micro)
  with_sales_tax(price_micro: known_capex_micro(c: c) + c.node_count * finishing_for(c: c) + c.node_count * per_node_delta)
}

// A candidate whose memory is not the banded lot does not move with the parameter at all, so its
// capex under any scenario is its planning capex. This is not a fallback: it is the coefficient
// being zero.
fn planning_capex_at_32gib_price_micro(c: NodeBuildCandidate, unit_price_micro: Int) -> Int {
  if memory_is_banded_32gib(c: c) {
    capex_at_32gib_price_micro(c: c, unit_price_micro: unit_price_micro)
  } else { planning_capex_micro(c: c) }
}

fn planning_capex_per_unit_at_32gib_price_micro(c: NodeBuildCandidate, unit_price_micro: Int) -> Int {
  let units = sellable_units(c: c)
  if units > 0 { planning_capex_at_32gib_price_micro(c: c, unit_price_micro: unit_price_micro) / units } else { 0 - 1 }
}

data capex_life_months: Int = 36

fn capex_amortization_per_month_micro(c: NodeBuildCandidate) -> Int {
  planning_capex_micro(c: c) / capex_life_months
}

// ---------------------------------------------------------------------------------------------
// THE SECOND LAYER: the purchase gate. It blocks a purchase order, because "is this architecture
// economically preferable" and "can I buy it this afternoon" are different questions.
//
// CORRECTION, AND THE CARVE-OUT IS NOT NEW BEHAVIOUR. This block used to say the gate "does not
// feed the frontier" and never makes a candidate incomparable. That has been FALSE for as long as
// ci_build_frontier node_missing_inputs has concatenated supply_depth_obligation into a candidate's
// Pareto gaps, which predates the axis-scoped gap migration -- the migration only gave that gap an
// axis, which is what finally made the contradiction legible.
//
// The split is between EVIDENCE and PAPERWORK, and it is stated without absolutes because the
// absolutes are what kept going wrong here. TWO facts affect planning, and both do so because they
// leave an axis without a grounded reading:
//
//   a missing rate      -- no capex can be computed, so both capex axes carry no evidence
//   unproven depth      -- fewer units are obtainable than the plan needs, so sellable units has none
//
// THE TWO SETS OVERLAP WITHOUT EITHER CONTAINING THE OTHER, and that is the whole content of this
// paragraph. Stated per fact, with no absolute over "them", because every absolute written here so
// far has been false of one member of whatever set it quantified over:
//
//   missing PROCESSOR or SYSTEM-LOT rate   planning: capex axes carry no reading
//                                          purchase authorization: CARRIED, by rate_obligation
//   missing MEMORY rate                    planning: capex axes carry no reading
//                                          purchase authorization: not carried
//   unproven supply DEPTH                  planning: sellable units carries no reading
//                                          purchase authorization: not carried, by any obligation
//
// So one of the three does cross, and the sentence that stood here said none of them did -- while
// its own table, six lines below it, said rate_obligation carries the platform rate. The absolute
// and its own counterexample were in the same block.
//
// Every candidate is blocked at the gate regardless, by the universal roster, and being blocked for
// an unrelated reason is not provenance for any of the three. The other purchase obligations --
// firmware conditions, duty reserve, return standing -- stay on the gate side and leave the frontier
// alone.
//
// FOUR REVISIONS, AND THE PATTERN IS THE POINT: "depth is the ONE obligation that crosses" (false,
// a missing rate affects planning too), "both also reach purchase authorization" (false for the
// memory rate and for depth), "NEITHER of them reaches purchase authorization" (false for the
// platform rate). Each was an absolute over a set whose members do not agree, and each was refuted
// by a member the sentence had not been checked against. The table above is per fact for that
// reason: there is no quantifier left to get wrong.
// ---------------------------------------------------------------------------------------------

type PurchaseAuthorization
  = PurchaseAuthorized { receipt: NonEmptyStr }
  | PurchaseBlocked { obligations: List<NonEmptyStr> }

fn rate_obligation(c: NodeBuildCandidate) -> List<NonEmptyStr> {
  match c.platform {
    LooseBoardBuild { board, processor } =>
      if supply_is_assumed(q: processor.supply) { no_obligations } else {
        one_note(text: join(["processor rate: no rate is carried for ", processor.sku], ""))
      },
    WholeSystemLot { lot } =>
      if supply_is_assumed(q: lot.supply) { no_obligations } else {
        one_note(text: join(["system lot rate: no rate is carried for ", lot.label], ""))
      },
  }
}

fn platform_max_data_rate_mt_s(c: NodeBuildCandidate) -> Nat {
  match c.platform {
    LooseBoardBuild { board, processor } => board.max_data_rate_mts,
    WholeSystemLot { lot } => lot.max_data_rate_mt_s,
  }
}

fn memory_speed_obligation(c: NodeBuildCandidate) -> List<NonEmptyStr> {
  if c.memory.data_rate_mt_s < platform_max_data_rate_mt_s(c: c) {
    one_note(text: join([
      "memory speed: these modules are ", to_string(c.memory.data_rate_mt_s),
      " MT/s and the platform supports ", to_string(platform_max_data_rate_mt_s(c: c)),
      ". The build does not become a ", to_string(platform_max_data_rate_mt_s(c: c)),
      " build because the platform could take one, and whether the slower grade measurably slows a compile has not been benchmarked.",
    ], ""))
  } else { no_obligations }
}

data universal_purchase_obligations: List<NonEmptyStr> = [
  "matched population: sixteen compatible modules actually in hand, from however many lots, with rank and speed matched",
  "processor compatibility: exact stepping, board revision, BIOS and CPLD support confirmed for the specific parts",
  "condition and returns: test report, serials and a written return standing for used parts",
  "landed cost: tariff classification, freight and brokerage confirmed, replacing the duty reserve with an assessed figure",
  "remaining BOM: coolers, PSU, scratch, carrier and cables quoted rather than allowed for",
]

fn purchase_authorization(c: NodeBuildCandidate) -> PurchaseAuthorization {
  PurchaseBlocked {
    obligations: concat(
      rate_obligation(c: c),
      concat(compatibility_obligation(c: c),
        concat(memory_speed_obligation(c: c), universal_purchase_obligations))),
  }
}

fn purchase_is_authorized(c: NodeBuildCandidate) -> Bool {
  match purchase_authorization(c: c) {
    PurchaseAuthorized { receipt } => true,
    PurchaseBlocked { obligations } => false,
  }
}

data two_layer_note: NonEmptyStr = "Nothing above is a purchase order. Every candidate is blocked at the purchase gate, and that blockage does not by itself make a candidate incomparable: the planning layer answers which architecture is economically preferable under stated assumptions, and the purchase gate answers whether a specific build can be bought. Making the first wait for the second is how a planning model becomes useless. The two layers read overlapping facts, and they read DIFFERENT subsets of them, so state the split rather than a count of what crosses. PLANNING: a missing platform or memory rate leaves both capex axes without a reading, and unproven supply depth leaves sellable units without one; ci_build_frontier declares each as a gap on the axis it starves, and planning_inputs_are_complete reads the platform rate AND the memory rate. PURCHASE AUTHORIZATION: rate_obligation carries a missing processor or system-lot rate and nothing else, so a missing MEMORY rate reaches the frontier but never the gate; supply depth reaches the gate through no obligation at all. Every candidate is blocked there regardless, by the universal roster, and being blocked for an unrelated reason is not provenance for either fact. This sentence previously read \"every candidate is fully comparable on the frontier\", and then \"TWO facts cross\": the first was contradicted by the frontier, the second by purchase_authorization, which consumes neither the depth obligation nor any memory-rate one."


// A candidate is COMPUTABLE for planning when every input has a rate. This is about missing FACTS
// rather than missing receipts, which is the distinction that matters here.
//
// It is NOT the only thing that can make a candidate uncomparable, and saying so contradicted the
// depth carve-out stated with the purchase gate above. Unproven supply depth does it too, for the
// same reason and by the same route: ci_build_frontier turns each into a declared gap on the axis
// it leaves without a reading.
fn planning_inputs_are_complete(c: NodeBuildCandidate) -> Bool {
  match c.platform {
    LooseBoardBuild { board, processor } =>
      supply_is_assumed(q: processor.supply) && supply_is_assumed(q: c.memory.supply),
    WholeSystemLot { lot } =>
      supply_is_assumed(q: lot.supply) && supply_is_assumed(q: c.memory.supply),
  }
}

// ---------------------------------------------------------------------------------------------
// THE CANDIDATE GENERATOR (operator direction 2026-08-18: "those types of candidates should
// be derived from a loose list of facts ... model all possible mobos, CPUs, RAM, their
// compatibility, and see what is actually cheapest" - not a bunch of hardcoded rows).
//
// A candidate is a POINT IN THE CROSS PRODUCT boards x processors x memory x node-count
// (plus system-lots x memory x node-count), admitted through two declared constraints:
// the memory-to-core band below, and board-CPU compatibility. A refused combination is a
// typed row with its cause, counted, never a silent absence - so the field the frontier
// sees is exactly "every buildable configuration of the observed facts", and entering one
// new fact row (a board, a CPU rate, a DIMM rate) grows the field without editing any list.
// ---------------------------------------------------------------------------------------------

// The product sells one core with three decimal GB (strategy.ci_sellable_unit). A build below 2 GiB per core is mostly stranded
// cores; above 8 GiB per core it is mostly stranded memory. The band is a declared planning
// constraint, not physics - widen it and the refused rows below become candidates.
data gib_per_core_floor: Nat = 2
data gib_per_core_ceiling: Nat = 8

data node_count_options: List<Nat> = [1, 2]

type CandidateAdmission
  = CandidateAdmitted { c: NodeBuildCandidate }
  | CandidateRefused { label: NonEmptyStr, cause: NonEmptyStr }

fn loose_label(b: BoardFacts, p: ProcessorLotObservation, m: MemoryLotObservation, nc: Nat) -> NonEmptyStr {
  join([to_string(nc), "x [", b.label, ", ", to_string(b.socket_count), "x", p.label, ", ", to_string(b.dimm_slots), "x", m.label, "]"], "")
}

fn lot_label(l: SystemLotObservation, m: MemoryLotObservation, nc: Nat) -> NonEmptyStr {
  join([to_string(nc), "x [", l.label, ", ", to_string(l.planned_dimm_population), "x", m.label, "]"], "")
}

fn ratio_admits(cores: Nat, gib: Nat) -> Bool {
  gib >= cores * gib_per_core_floor && gib <= cores * gib_per_core_ceiling
}

fn ratio_refusal_cause(cores: Nat, gib: Nat) -> NonEmptyStr {
  join(["memory-to-core ratio out of band: ", to_string(gib), " GiB over ", to_string(cores),
    " cores falls outside the declared ", to_string(gib_per_core_floor), "-",
    to_string(gib_per_core_ceiling), " GiB-per-core band the 1-core-4-GiB product implies"], "")
}

fn build_loose(b: BoardFacts, p: ProcessorLotObservation, m: MemoryLotObservation, nc: Nat) -> NodeBuildCandidate {
  NodeBuildCandidate {
    label: loose_label(b: b, p: p, m: m, nc: nc),
    node_count: nc,
    platform: LooseBoardBuild { board: b, processor: p },
    memory: m,
  }
}

fn build_lot(l: SystemLotObservation, m: MemoryLotObservation, nc: Nat) -> NodeBuildCandidate {
  NodeBuildCandidate {
    label: lot_label(l: l, m: m, nc: nc),
    node_count: nc,
    platform: WholeSystemLot { lot: l },
    memory: m,
  }
}

fn admit_loose(b: BoardFacts, p: ProcessorLotObservation, m: MemoryLotObservation, nc: Nat) -> CandidateAdmission {
  if cpu_socket_eq(a: b.socket, b: p.socket) {
    admit_loose_socket_matched(b: b, p: p, m: m, nc: nc)
  } else {
    CandidateRefused {
      label: loose_label(b: b, p: p, m: m, nc: nc),
      cause: join(["socket mismatch: ", b.label, " does not carry the socket ", p.sku, " terminates in (typed cpu_socket_eq on platform owner, termination and contact count - extdeps.cpu.types authority) - the combination is not constructible, refused before any pricing"], ""),
    }
  }
}

fn admit_loose_socket_matched(b: BoardFacts, p: ProcessorLotObservation, m: MemoryLotObservation, nc: Nat) -> CandidateAdmission {
  if ratio_admits(cores: b.socket_count * p.physical_cores, gib: b.dimm_slots * m.capacity_gib) {
    CandidateAdmitted { c: build_loose(b: b, p: p, m: m, nc: nc) }
  } else {
    CandidateRefused {
      label: loose_label(b: b, p: p, m: m, nc: nc),
      cause: ratio_refusal_cause(cores: b.socket_count * p.physical_cores, gib: b.dimm_slots * m.capacity_gib),
    }
  }
}

fn admit_lot(l: SystemLotObservation, m: MemoryLotObservation, nc: Nat) -> CandidateAdmission {
  if ratio_admits(cores: l.included_core_count_total, gib: l.planned_dimm_population * m.capacity_gib) {
    CandidateAdmitted { c: build_lot(l: l, m: m, nc: nc) }
  } else {
    CandidateRefused {
      label: lot_label(l: l, m: m, nc: nc),
      cause: ratio_refusal_cause(cores: l.included_core_count_total, gib: l.planned_dimm_population * m.capacity_gib),
    }
  }
}

data processor_market: List<ProcessorLotObservation> = [altra_q64_lot, altra_q80_lot, altra_q128_lot]

data no_admissions: List<CandidateAdmission> = []

fn all_admissions() -> List<CandidateAdmission> {
  let loose = fold(known_boards, init: no_admissions, f: fn(acc_b, b) {
    fold(processor_market, init: acc_b, f: fn(acc_p, p) {
      fold(memory_lots, init: acc_p, f: fn(acc_m, m) {
        fold(node_count_options, init: acc_m, f: fn(acc_n, nc) {
          concat(acc_n, [admit_loose(b: b, p: p, m: m, nc: nc)])
        })
      })
    })
  })
  fold(system_lot_market, init: loose, f: fn(acc_l, l) {
    fold(memory_lots, init: acc_l, f: fn(acc_m, m) {
      fold(node_count_options, init: acc_m, f: fn(acc_n, nc) {
        concat(acc_n, [admit_lot(l: l, m: m, nc: nc)])
      })
    })
  })
}

data no_candidates: List<NodeBuildCandidate> = []

fn admitted_candidates() -> List<NodeBuildCandidate> {
  fold(all_admissions(), init: no_candidates, f: fn(acc, a) {
    match a {
      CandidateAdmitted { c } => concat(acc, [c]),
      CandidateRefused { label, cause } => acc,
    }
  })
}

fn refused_combinations() -> List<CandidateAdmission> {
  fold(all_admissions(), init: no_admissions, f: fn(acc, a) {
    match a {
      CandidateAdmitted { c } => acc,
      CandidateRefused { label, cause } => concat(acc, [a]),
    }
  })
}

// The board-CPU compatibility standing is deliberately an OBLIGATION rather than an
// admission filter: no observed pairing is impossible, but the MP72 x Altra Max pairing is
// conditional on firmware, and that condition rides the purchase gate of every candidate it
// applies to (see compatibility_obligation below).
// NOISE IS A PLACEMENT FACT (operator 2026-08-18): the Mt. Jade / Mt. Collins system chassis
// are dense rack servers whose fans make them machine-room equipment - they require a colo
// or a closed machine closet. A loose board build can be finished into a quiet chassis (the
// finishing allowance carries it), which is what makes home placement possible AT ALL for
// those candidates. This is derived per candidate and consumed by the placement models.
type Habitability
  = HomeHabitableWithQuietBuild { note: NonEmptyStr }
  | RequiresMachineRoom { note: NonEmptyStr }

fn candidate_habitability(c: NodeBuildCandidate) -> Habitability {
  match c.platform {
    LooseBoardBuild { board, processor } => HomeHabitableWithQuietBuild {
      note: "loose build: the finishing allowance can buy a quiet tower or sound-managed chassis; choosing a dense 1U/2U rack chassis instead forfeits this and re-classes the node as machine-room equipment",
    },
    WholeSystemLot { lot } => RequiresMachineRoom {
      note: join([lot.label, ": dense rack chassis with server fans - open-room habitation refused; placement is a colo cabinet or a closed machine room, never a living space"], ""),
    },
  }
}

fn supply_depth_obligation(c: NodeBuildCandidate) -> List<NonEmptyStr> {
  match c.platform {
    LooseBoardBuild { board, processor } => match board.depth {
      DepthObserved { units, note } =>
        if c.node_count > units {
          one_note(text: join(["supply depth: the plan needs ", to_string(c.node_count), " boards and only ", to_string(units), " are observed obtainable"], ""))
        } else { no_obligations },
      DepthAvailableUncounted { note } => no_obligations,
      DepthScarce { obligation } => one_note(text: join(["supply depth (", board.label, "): ", obligation], "")),
    },
    WholeSystemLot { lot } => match lot.depth {
      DepthObserved { units, note } =>
        if c.node_count > units {
          one_note(text: join(["supply depth: the plan needs ", to_string(c.node_count), " systems and only ", to_string(units), " are observed obtainable"], ""))
        } else { no_obligations },
      DepthAvailableUncounted { note } => no_obligations,
      DepthScarce { obligation } => one_note(text: join(["supply depth (", lot.label, "): ", obligation], "")),
    },
  }
}

fn compatibility_obligation(c: NodeBuildCandidate) -> List<NonEmptyStr> {
  match c.platform {
    LooseBoardBuild { board, processor } => match board_cpu_compatibility(b: board, p: processor) {
      CompatibleObserved => no_obligations,
      CompatibleConditional { obligation } => one_note(text: obligation),
    },
    WholeSystemLot { lot } => no_obligations,
  }
}

// THE WHOLE-SYSTEM SUPPLY, at the operator-quoted prices (direction 2026-08-18). Both lots
// include their processors, so their capex line has no separate processor purchase; both
// follow the section-4 one-DIMM-per-channel population (16 of the 32 spec slots the cited
