}

data system_lot_market: List<SystemLotObservation> = [mt_jade_system_lot, mt_collins_system_lot]

// NAMED SPECIMENS - derived through the same builders the generator uses, kept because the
// narrative reads (split-versus-dense, the band check, the selected build) and the witness
// pins need stable handles into the field. They are compositions of the fact rows, never
// facts of their own; each is identical to the generated entry with the same label.
data candidate_q64_16: NodeBuildCandidate = build_loose(b: mp72_board_facts, p: altra_q64_lot, m: dimm_16gib_lot, nc: 1)
data candidate_q64_32: NodeBuildCandidate = build_loose(b: mp72_board_facts, p: altra_q64_lot, m: dimm_32gib_lot, nc: 1)
data candidate_q80_32: NodeBuildCandidate = build_loose(b: mp72_board_facts, p: altra_q80_lot, m: dimm_32gib_lot, nc: 1)
data candidate_q128_32: NodeBuildCandidate = build_loose(b: mp72_board_facts, p: altra_q128_lot, m: dimm_32gib_lot, nc: 1)
data candidate_q128_64: NodeBuildCandidate = build_loose(b: mp72_board_facts, p: altra_q128_lot, m: dimm_64gib_lot, nc: 1)
data candidate_two_q64_32: NodeBuildCandidate = build_loose(b: mp72_board_facts, p: altra_q64_lot, m: dimm_32gib_lot, nc: 2)
data candidate_q80_64: NodeBuildCandidate = build_loose(b: mp72_board_facts, p: altra_q80_lot, m: dimm_64gib_lot, nc: 1)
data candidate_asrock_q64_32: NodeBuildCandidate = build_loose(b: asrock_board_facts, p: altra_q64_lot, m: dimm_32gib_lot, nc: 1)
data candidate_r12spd_q80_32: NodeBuildCandidate = build_loose(b: supermicro_r12spd_facts, p: altra_q80_lot, m: dimm_32gib_lot, nc: 1)
data candidate_mt_jade_32: NodeBuildCandidate = build_lot(l: mt_jade_system_lot, m: dimm_32gib_lot, nc: 1)
data candidate_mt_collins_32: NodeBuildCandidate = build_lot(l: mt_collins_system_lot, m: dimm_32gib_lot, nc: 1)

data node_build_candidates: List<NodeBuildCandidate> = admitted_candidates()


// The provisional launch front-runner, and provisional is load-bearing: procurement is incomplete
// for every candidate here, so this is a modelling preference and not a purchase authorization.
data selected_build: NodeBuildCandidate = candidate_q64_32

data selection_note: NonEmptyStr = "PROVISIONAL ENGINEERING SELECTION, NOT A DERIVED BALANCE. Under the three-decimal-GB unit the Q64 pair with 512 GiB is core-bound at 128 units with 154 GiB unsold (the frontier witness measures both), so no exact-balance rationale exists for it; it is retained provisionally because it fills every slot and socket from the 32-GiB supply the market actually sells, avoids the 64-GiB price cliff, and holds the build question open pending frontier re-evaluation under the contract. Matched sixteen-module supply, memory speed and compatibility, processor support, the remaining BOM, landed cost and power are all open, so nothing here authorizes a purchase."

// Failure domain: what one board taking a node out costs in capacity. A split fleet halves it and
// pays for the second board to do so.
fn failure_domain_units(c: NodeBuildCandidate) -> Nat {
  sellable_units_per_node(c: c)
}

fn maintenance_population(c: NodeBuildCandidate) -> Nat { c.node_count }

// The dual-socket planning draw. Per-candidate differentiation lives in candidate_node_watts,
// which reads the board's planning figure for loose builds; both are assumptions until a clamp
// meter replaces them (candidate_node_watts_note).
type NodePowerStanding
  = NodePowerMeasured { watts: Nat, receipt: NonEmptyStr }
  | NodePowerAssumed { watts: Nat, note: NonEmptyStr }

data selected_node_power: NodePowerStanding = NodePowerAssumed {
  watts: 650,
  note: "One assumed average draw per node under load, used for every candidate. It therefore cannot separate a 128-core node from a 64-core one, which is precisely why watts per unit is an unmeasured axis on the frontier rather than a column with numbers in it. A clamp meter on one built node replaces this, and it will move the split-versus-dense answer.",
}

fn node_watts() -> Nat {
  match selected_node_power {
    NodePowerMeasured { watts, receipt } => watts,
    NodePowerAssumed { watts, note } => watts,
  }
}

fn candidate_node_watts(c: NodeBuildCandidate) -> Nat {
  match c.platform {
    LooseBoardBuild { board, processor } => board.planning_node_watts,
    WholeSystemLot { lot } => node_watts(),
  }
}

data candidate_node_watts_note: NonEmptyStr = "The single-socket ASRock node carries a 350 W planning average against the dual-socket 650 W - an assumption in the same standing as selected_node_power, stated so the fleet-watts axis does not charge a one-socket node a two-socket draw. Both figures dissolve into clamp-meter measurements."

fn power_is_measured() -> Bool {
  match selected_node_power {
    NodePowerMeasured { watts, receipt } => true,
    NodePowerAssumed { watts, note } => false,
  }
}
