module finance.personal_ledger

import std.types { NonEmptyStr, List, Bool }
import std.nat { Nat }

// PERSONAL LEDGER — the operator's own balance sheet, 2026, modeled as DOUBLE ENTRY.
//
// Why double entry and not a signed amount: std.measure's MoneyAmount<S> is
// Measure<Currency, S, Nat> — non-negative BY CONSTRUCTION. A finance year is full of
// quantities that look signed (a loss, a withdrawal, a refund), and the tempting move is
// to widen the carrier to admit a negative number. That would push the sign into a
// VALUE, where nothing checks it, and would widen a load-bearing public std type for a
// private need.
//
// Double entry puts the sign in the STRUCTURE instead. An amount is a Nat and cannot be
// negative; DIRECTION is a typed arm; and a transaction that does not balance has no
// accepted form. That is DESIGN section 4b rung 4 (structurally impossible) for the
// class "the books silently disagree with themselves", rather than rung 1 (detected
// afterward by a validator). It is also the grounded authority — double entry is the
// accepted intersubjective framework for exactly this, so modeling it is section 3
// citing the real upstream rather than coining a private scheme.
//
// DENOMINATION: every amount is micro-USD (1 USD = 1,000,000), matching the repo's
// existing usd_micro_per_month convention in strategy.ci_site_cost. There is no float
// anywhere in this module and there must never be one — money is an exact integer count.

type LedgerAccount
  = CashChecking
  | CashCma
  | BrokerageTaxable
  | RetirementLocked
  | CreditCardPayable
  | EquipmentCompute
  | HousingRent
  | PersonalConsumption
  | TaxPayableFederal
  | TaxPayableState
  | RealizedCapitalGain
  | OpeningEquity
  | MoneyMarketCore
  | MercuryBusinessChecking
  | DueFromGunbai
  | UnclassifiedTransferSuspense

// Whether an account can fund next month's rent is a FACT ABOUT THE ACCOUNT, not a note
// beside it. The 401k is the reason this arm exists: it is 60 percent of the headline net
// worth and zero percent of the runway, and every projection that reads the headline
// instead of this predicate is wrong by that ratio.
fn account_is_deployable(a: LedgerAccount) -> Bool {
  match a {
    CashChecking => true,
    CashCma => true,
    BrokerageTaxable => true,
    RetirementLocked => false,
    CreditCardPayable => false,
    EquipmentCompute => false,
    HousingRent => false,
    PersonalConsumption => false,
    TaxPayableFederal => false,
    TaxPayableState => false,
    RealizedCapitalGain => false,
    OpeningEquity => false,
    MoneyMarketCore => true,
    MercuryBusinessChecking => true,
    DueFromGunbai => false,
    UnclassifiedTransferSuspense => false,
  }
}

type PostingDirection
  = Debit
  | Credit

type Posting {
  account: LedgerAccount
  direction: PostingDirection
  usd_micro: Nat
  memo: NonEmptyStr
}

type LedgerTransaction {
  id: NonEmptyStr
  date_iso: NonEmptyStr
  postings: List<Posting>
  provenance: NonEmptyStr
}

fn posting_debit_micro(p: Posting) -> Nat {
  match p.direction {
    Debit => p.usd_micro,
    Credit => 0,
  }
}

fn posting_credit_micro(p: Posting) -> Nat {
  match p.direction {
    Debit => 0,
    Credit => p.usd_micro,
  }
}

fn transaction_debit_total(t: LedgerTransaction) -> Nat {
  fold(t.postings, init: 0, f: (acc, p) => acc + posting_debit_micro(p))
}

fn transaction_credit_total(t: LedgerTransaction) -> Nat {
  fold(t.postings, init: 0, f: (acc, p) => acc + posting_credit_micro(p))
}

// The refusal is TYPED AND LOCATED, never a boolean. An unbalanced transaction reports
// which transaction and by how much, because "the books are wrong" is not an actionable
// diagnostic and DESIGN section 5 forbids the fabricated-plausible-output arm that would
// let it pass as merely-warned.
type BalanceVerdict
  = Balanced
  | Unbalanced { transaction_id: NonEmptyStr, debit_micro: Nat, credit_micro: Nat }

fn transaction_balance(t: LedgerTransaction) -> BalanceVerdict {
  let debits = transaction_debit_total(t)
  let credits = transaction_credit_total(t)
  if debits == credits {
    Balanced
  } else {
    Unbalanced { transaction_id: t.id, debit_micro: debits, credit_micro: credits }
  }
}

fn transaction_is_balanced(t: LedgerTransaction) -> Bool {
  match transaction_balance(t) {
    Balanced => true,
    Unbalanced { transaction_id, debit_micro, credit_micro } => false,
  }
}

fn ledger_all_balanced(ts: List<LedgerTransaction>) -> Bool {
  fold(ts, init: true, f: (acc, t) => acc && transaction_is_balanced(t))
}

// ---------------------------------------------------------------------------------------------
// The 2026 transactions. Each row carries its provenance — the receipt it was read from,
// not a recollection. Where a figure is a recollection it says so, because DESIGN section 5
// distinguishes a measurement from an estimate and a ledger that blurs them is worse than
// one that omits the row.
// ---------------------------------------------------------------------------------------------

