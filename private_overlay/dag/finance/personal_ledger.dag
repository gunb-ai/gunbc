// ---------------------------------------------------------------------------------------------
// The two genuinely unexplained movements. Together they are 100,000 dollars — five times
// the residual the first reconciliation chased, and on dates that reconciliation never
// examined. They are NOT expenses and must never be totalled as such: an outbound wire to
// an unnamed destination is as consistent with a transfer between the operator's own
// accounts as with a payment to a third party, and those have opposite consequences for
// both net worth and taxable income. Recording either reading would be a fabricated fact.
// ---------------------------------------------------------------------------------------------

type TransferClassification
  = InternalBetweenOwnAccounts { destination_account: NonEmptyStr, evidence: NonEmptyStr }
  | ExternalPaymentToThirdParty { payee: NonEmptyStr, purpose: NonEmptyStr, evidence: NonEmptyStr }
  | UnclassifiedExternalTransfer { obligation: NonEmptyStr }

data march_wire_classification: TransferClassification = InternalBetweenOwnAccounts {
  destination_account: "Mercury business checking, held by Gunbai LLC",
  evidence: "Operator statement 2026-09-04. Neither wire left the operator's net worth; both funded the company account from personal funds. Because Gunbai LLC is disregarded for federal purposes there is no taxable event on the transfer itself — it is one taxpayer moving money between two of his own accounts — but it IS a member capital contribution for entity bookkeeping and must be recorded as such rather than as an expense.",
}

data august_wire_classification: TransferClassification = InternalBetweenOwnAccounts {
  destination_account: "Mercury business checking, held by Gunbai LLC",
  evidence: "Operator statement 2026-09-04. The sequencing now reads cleanly: 70,000 was wired to the company on 2026-08-05 out of SPAXX, and the VOO sale executed the same day REFILLED the core, arriving 2026-08-10. The disposition funded the capitalization; it was not itself the spending.",
}

fn transfer_is_classified(t: TransferClassification) -> Bool {
  match t {
    InternalBetweenOwnAccounts { destination_account, evidence } => true,
    ExternalPaymentToThirdParty { payee, purpose, evidence } => true,
    UnclassifiedExternalTransfer { obligation } => false,
  }
}

