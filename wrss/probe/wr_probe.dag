module probe.wr_probe

import extdeps.filesystem.filesystem_io
import v2.compiler.normalize { normalize, normalize_node, normalize_module_graft_finish, bind_retention_free }
import v2.std.node { Node, Edge, NodeFold, fold_node, locally_well_formed, well_formed }
import v2.workflow.body_lowering_retention_census { node_shape_label, emitted_production_label }
import v2.compiler.parse { parse_module_prepared }
import v2.compiler.program_assembly { dag_prepared_grammar }
import v2.compiler.tokenize { tokenize }
import v2.extdeps.languages.dag { dag_lex }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.algebra { fold_list }
import v2.workflow.body_lowering_retention_census { retention_census, retention_census_render, diagnostic_ledger_render }

fn probe(path: String) -> String {
  let src = filesystem_read(path: path).content
  match tokenize(text: src, file: ^wr_probe, rules: dag_lex()) {
    Rejected { diagnostics: r } => concat("TOKENIZE REJECTED\n", diagnostic_ledger_render(ds: r))
    Accepted { value: tokens, diagnostics: _ } =>
      match dag_prepared_grammar() {
        Rejected { diagnostics: r } => "GRAMMAR REJECTED"
        Accepted { value: prepared, diagnostics: residue } =>
          match parse_module_prepared(tokens: tokens, prepared: prepared, validation_residue: residue) {
            Rejected { diagnostics: r } => concat("PARSE REJECTED\n", diagnostic_ledger_render(ds: r))
            Accepted { value: artifact, diagnostics: _ } =>
              match normalize(parse_tree: artifact.tree) {
                Rejected { diagnostics: r } =>
                  concat(retention_census_render(families: retention_census(ds: r)), diagnostic_ledger_render(ds: r))
                Accepted { value: _, diagnostics: _ } => "NORMALIZED OK"
              }
          }
      }
  }
}


fn verdict(path: String) -> String {
  let r = probe(path: path)
  if r == "NORMALIZED OK" { "" } else { concat("\n##### ", concat(path, concat("\n", r))) }
}

fn whole() -> String {
  fold_list(xs: [
    "dag/gunbc/tools/cron_tag.dag",
    "dag/extdeps/bmc/http.dag",
    "dag/gunbc/provider_readiness_claim_evidence.dag",
    "dag/std/key_relation.dag",
    "dag/test/claim/roadmap/roadmap_launch_deployment_observe_witness_test.dag"
  ], empty: "", cons: fn(acc, p) { concat(acc, verdict(path: p)) })
}

fn edge_label_text(e: Edge) -> String {
  match e.label {
    Positional => "_"
    Named { name: s } => symbol_lexeme(sym: s)
  }
}

fn node_brief(n: Node) -> String {
  concat(node_shape_label(kind: n.kind), concat("[", concat(emitted_production_label(node: n), concat("]", concat(" n=", to_string(length(xs: n.children)))))))
}

fn node_describe(n: Node) -> String {
  concat(node_brief(n: n), concat(" {", concat(fold_list(xs: n.children, empty: "", cons: fn(acc, e) {
    edge_step(acc: acc, e: e)
  }), " }")))
}

fn first_ill(root: Node) -> String {
  fold_node(n: root, algebra: NodeFold {
    init: fn(n0) { if locally_well_formed(n: n0) { "" } else { concat("ILL ", node_describe(n: n0)) } },
    step: fn(acc, e, child) {
      if acc != "" { acc } else if child == "" { "" } else {
        concat("  via ", concat(edge_label_text(e: e), concat(" <- ", concat(node_brief(n: e.target), concat("\n", child)))))
      }
    }
  })
}

fn locate(path: String) -> String {
  let src = filesystem_read(path: path).content
  match tokenize(text: src, file: ^wr_probe, rules: dag_lex()) {
    Rejected { diagnostics: r } => "TOKENIZE REJECTED"
    Accepted { value: tokens, diagnostics: _ } =>
      match dag_prepared_grammar() {
        Rejected { diagnostics: r } => "GRAMMAR REJECTED"
        Accepted { value: prepared, diagnostics: residue } =>
          match parse_module_prepared(tokens: tokens, prepared: prepared, validation_residue: residue) {
            Rejected { diagnostics: r } => "PARSE REJECTED"
            Accepted { value: artifact, diagnostics: _ } =>
              match bind_retention_free(o: normalize_node(n: artifact.tree)) {
                Rejected { diagnostics: r } => concat("RETENTION/LOWER REJECTED\n", diagnostic_ledger_render(ds: r))
                Accepted { value: normalized, diagnostics: d } =>
                  match normalize_module_graft_finish(folded: normalized, cd: d) {
                    Rejected { diagnostics: r } => "GRAFT REJECTED"
                    Accepted { value: grafted, diagnostics: _ } =>
                      if well_formed(n: grafted) { "WELL FORMED" } else { first_ill(root: grafted) }
                  }
              }
          }
      }
  }
}

fn locate_all() -> String {
  fold_list(xs: [
    "dag/extdeps/bmc/http.dag",
    "dag/gunbc/provider_readiness_claim_evidence.dag",
    "dag/std/key_relation.dag",
    "dag/test/claim/roadmap/roadmap_launch_deployment_observe_witness_test.dag"
  ], empty: "", cons: fn(acc, p) { concat(acc, concat("\n##### ", concat(p, concat("\n", locate(path: p))))) })
}

