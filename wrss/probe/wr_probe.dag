fn edge_step(acc: String, e: Edge) -> String {
  concat(acc, concat(" ", concat(edge_label_text(e: e), concat(":", node_brief(n: e.target)))))
}

fn locate_kr() -> String { locate(path: "dag/std/key_relation.dag") }
fn probe_kr() -> String { probe(path: "dag/std/key_relation.dag") }

