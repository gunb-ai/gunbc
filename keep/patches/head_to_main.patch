+      Present { value: TypeVariable { id: left_id } } =>
+        match right.inferred {
+          Present { value: TypeVariable { id: right_id } } =>
+            if_branch_type_variables_identical(left: left, right: right, left_id: left_id, right_id: right_id)
+          _ => false
+        }
+      _ =>
+        match right.inferred {
+          Present { value: CompilerError { message: _, span: _ } } => false
+          Present { value: TypeVariable { id: _ } } => false
+          _ =>
+            match whole_declaration_carried(n: left) {
+              Present { value: l } =>
+                match whole_declaration_carried(n: right) {
+                  Present { value: r } => declaration_ref_eq(a: l, b: r)
+                  Absent => false
+                }
+              Absent =>
+                match whole_declaration_carried(n: right) {
+                  Present { value: _ } => false
+                  Absent =>
+                    match if_branch_reference_identity(n: left, source_indices: source_indices) {
+                      Present { value: li } =>
+                        match if_branch_reference_identity(n: right, source_indices: source_indices) {
+                          Present { value: ri } => li == ri
+                          Absent => false
+                        }
+                      Absent => false
+                    }
+                }
+            }
+        }
+    }
+  }
+}
+
+// A TYPE VARIABLE IS ITS OWNER'S PARAMETER, NOT ITS SPELLING. The resolver stamps a reference to a
+// declaration's own parameter with a TypeParameter declaration ref naming that owner, so two `T`s
+// from different declarations carry different refs. Both carrying a ref compares the refs; only two
+// unowned synthetic variables fall back to the bare id; one owned and one unowned declines.
+fn if_branch_type_variables_identical(left: Node, right: Node, left_id: String, right_id: String) -> Bool {
+  match left.declaration {
+    Present { value: l } =>
+      match right.declaration {
+        Present { value: r } => declaration_ref_eq(a: l, b: r)
+        Absent => false
+      }
+    Absent =>
+      match right.declaration {
+        Present { value: _ } => false
+        Absent => left_id == right_id
+      }
+  }
+}
+
+// type_reference_identity's key, refused when the reference names nothing: an empty declared name
+// would make every unnamed reference in one file identical to every other.
+fn if_branch_reference_identity(n: Node, source_indices: Map<String, NewlineIndex>) -> String? {
+  let target = match n.inferred {
+    Present { value: Resolved { node: rt } } => rt
+    _ => n
+  }
+  if authored_name_at(source_indices: source_indices, node: target) == "" {
+    none
+  } else {
+    Present { value: node_declaration_identity(n: target, source_indices: source_indices) }
+  }
+}
