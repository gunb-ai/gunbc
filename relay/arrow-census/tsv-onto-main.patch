+fn not_established_cause_token(cause: SourceAnalysisNotEstablishedCause) -> String {
+  match cause {
+    LanguageGrammarUnavailable => "LanguageGrammarUnavailable"
+    LanguageGrammarRejected => "LanguageGrammarRejected"
+    SourceUnreadable => "SourceUnreadable"
+    SourceTokenizationRejected => "SourceTokenizationRejected"
+    SourceParseRejected => "SourceParseRejected"
+    SourceNormalizationRejected => "SourceNormalizationRejected"
+  }
+}
+
+fn census_tsv_line_for_path(path: String) -> String {
+  let row = corpus_file_row(path: path)
+  match row.standing {
+    CorpusFileScanned { suspects: s, refusals: r, causes: _ } =>
+      concat(
+        path,
+        concat(
+          "\tscanned\t",
+          concat(
+            integer_int_to_decimal_string(value: s),
+            concat("\t", integer_int_to_decimal_string(value: r))
+          )
+        )
+      )
+    CorpusFileNotEstablished { cause: cause } =>
+      concat(path, concat("\tnot_established\t", concat(not_established_cause_token(cause: cause), "\t0")))
+  }
+}
+
 fn subtree_gate() -> CorpusGateDisposition {
   corpus_gate(pool_roots: ["dag/extdeps/filesystem"], population_floor: 5)
