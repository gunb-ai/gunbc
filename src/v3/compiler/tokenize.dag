// v3.compiler.tokenize — tokenizer authority for SG-1.
//
// The Rust projection (`tokenize_generated.rs`) is produced by
// `cargo run --bin regen_tokenize` — do not hand-edit the generated file.
//
// Tables below are the single source of truth for keyword spellings and
// punctuation classification. The scanning algorithm is emitted from
// `src/v3/compiler/src/bin/regen_tokenize.rs` as deterministic codegen
// (not a second semantic authority).

module v3.compiler.tokenize

import v3.std.substrate { SourceSpan }

type TokenKind
  = KwLet
  | KwIf
  | KwThen
  | KwElse
  | KwFn
  | KwType
  | KwModule
  | KwImport
  | KwMatch
  | KwData
  | KwWhere
  | KwTrue
  | KwFalse
  | Ident { name: String }
  | IntLit { value: Int }
  | StringLit { value: String }
  | Eq
  | EqEq
  | NotEq
  | Lt
  | Le
  | Gt
  | Ge
  | Plus
  | Minus
  | Star
  | Slash
  | AmpAmp
  | PipePipe
  | Colon
  | Arrow
  | FatArrow
  | PipeArrow
  | Dot
  | LParen
  | RParen
  | LBrace
  | RBrace
  | LBracket
  | RBracket
  | Comma
  | Semicolon
  | Pipe
  | Question
  | Eof

type Token {
  kind: TokenKind
  span: SourceSpan
}

type KeywordSpec {
  spelling: String
  kind: TokenKind
}

type PunctSpec {
  pattern: String
  width: Int
  kind: TokenKind
}

data keyword_let: KeywordSpec = { spelling: "let", kind: KwLet }
data keyword_if: KeywordSpec = { spelling: "if", kind: KwIf }
data keyword_then: KeywordSpec = { spelling: "then", kind: KwThen }
data keyword_else: KeywordSpec = { spelling: "else", kind: KwElse }
data keyword_fn: KeywordSpec = { spelling: "fn", kind: KwFn }
data keyword_type: KeywordSpec = { spelling: "type", kind: KwType }
data keyword_module: KeywordSpec = { spelling: "module", kind: KwModule }
data keyword_import: KeywordSpec = { spelling: "import", kind: KwImport }
data keyword_match: KeywordSpec = { spelling: "match", kind: KwMatch }
data keyword_data: KeywordSpec = { spelling: "data", kind: KwData }
data keyword_where: KeywordSpec = { spelling: "where", kind: KwWhere }
data keyword_true: KeywordSpec = { spelling: "true", kind: KwTrue }
data keyword_false: KeywordSpec = { spelling: "false", kind: KwFalse }

data punct_eq_eq: PunctSpec = { pattern: "==", width: 2, kind: EqEq }
data punct_eq_fat: PunctSpec = { pattern: "=>", width: 2, kind: FatArrow }
data punct_bang_eq: PunctSpec = { pattern: "!=", width: 2, kind: NotEq }
data punct_lt_eq: PunctSpec = { pattern: "<=", width: 2, kind: Le }
data punct_gt_eq: PunctSpec = { pattern: ">=", width: 2, kind: Ge }
data punct_minus_gt: PunctSpec = { pattern: "->", width: 2, kind: Arrow }
data punct_pipe_gt: PunctSpec = { pattern: "|>", width: 2, kind: PipeArrow }
data punct_amp_amp: PunctSpec = { pattern: "&&", width: 2, kind: AmpAmp }
data punct_pipe_pipe: PunctSpec = { pattern: "||", width: 2, kind: PipePipe }

data punct_eq: PunctSpec = { pattern: "=", width: 1, kind: Eq }
data punct_lt: PunctSpec = { pattern: "<", width: 1, kind: Lt }
data punct_gt: PunctSpec = { pattern: ">", width: 1, kind: Gt }
data punct_plus: PunctSpec = { pattern: "+", width: 1, kind: Plus }
data punct_minus: PunctSpec = { pattern: "-", width: 1, kind: Minus }
data punct_star: PunctSpec = { pattern: "*", width: 1, kind: Star }
data punct_slash: PunctSpec = { pattern: "/", width: 1, kind: Slash }
data punct_colon: PunctSpec = { pattern: ":", width: 1, kind: Colon }
data punct_dot: PunctSpec = { pattern: ".", width: 1, kind: Dot }
data punct_lparen: PunctSpec = { pattern: "(", width: 1, kind: LParen }
data punct_rparen: PunctSpec = { pattern: ")", width: 1, kind: RParen }
data punct_lbrace: PunctSpec = { pattern: "{", width: 1, kind: LBrace }
data punct_rbrace: PunctSpec = { pattern: "}", width: 1, kind: RBrace }
data punct_lbracket: PunctSpec = { pattern: "[", width: 1, kind: LBracket }
data punct_rbracket: PunctSpec = { pattern: "]", width: 1, kind: RBracket }
data punct_comma: PunctSpec = { pattern: ",", width: 1, kind: Comma }
data punct_semicolon: PunctSpec = { pattern: ";", width: 1, kind: Semicolon }
data punct_pipe: PunctSpec = { pattern: "|", width: 1, kind: Pipe }
data punct_question: PunctSpec = { pattern: "?", width: 1, kind: Question }
