// v3.compiler.tokenize — tokenizer authority for SG-1.
//
// The Rust projection (`tokenize_generated.rs`) is produced by
// `cargo run --bin regen_tokenize` — do not hand-edit the generated file.
//
// Tables below are the single source of truth for keyword spellings and
// punctuation classification. The scanning algorithm is emitted from
// `src/v3/compiler/src/bin/regen_tokenize.rs` as deterministic codegen
// (not a second semantic authority).

module v3.compiler.tokenize

import v3.std.substrate { SourceSpan }

type TokenKind
  = KwLet
  | KwIf
  | KwThen
  | KwElse
  | KwFn
  | KwType
  | KwModule
  | KwImport
  | KwMatch
  | KwData
  | KwWhere
  | KwTrue
  | KwFalse
  | Ident(String)
  | IntLit(Int)
  | StringLit(String)
  | Eq
  | EqEq
  | NotEq
  | Lt
  | Le
  | Gt
  | Ge
  | Plus
  | Minus
  | Star
  | Slash
  | AmpAmp
  | PipePipe
  | Colon
  | Arrow
  | FatArrow
  | PipeArrow
  | Dot
  | LParen
  | RParen
  | LBrace
  | RBrace
  | LBracket
  | RBracket
  | Comma
  | Semicolon
  | Pipe
  | Question
  | Eof

type Token {
  kind: TokenKind
  span: SourceSpan
}

type KeywordSpec {
  spelling: String
  kind_name: String
}

type PunctSpec {
  pattern: String
  width: Int
  kind_name: String
}

data keyword_let: KeywordSpec = { spelling: "let", kind_name: "KwLet" }
data keyword_if: KeywordSpec = { spelling: "if", kind_name: "KwIf" }
data keyword_then: KeywordSpec = { spelling: "then", kind_name: "KwThen" }
data keyword_else: KeywordSpec = { spelling: "else", kind_name: "KwElse" }
data keyword_fn: KeywordSpec = { spelling: "fn", kind_name: "KwFn" }
data keyword_type: KeywordSpec = { spelling: "type", kind_name: "KwType" }
data keyword_module: KeywordSpec = { spelling: "module", kind_name: "KwModule" }
data keyword_import: KeywordSpec = { spelling: "import", kind_name: "KwImport" }
data keyword_match: KeywordSpec = { spelling: "match", kind_name: "KwMatch" }
data keyword_data: KeywordSpec = { spelling: "data", kind_name: "KwData" }
data keyword_where: KeywordSpec = { spelling: "where", kind_name: "KwWhere" }
data keyword_true: KeywordSpec = { spelling: "true", kind_name: "KwTrue" }
data keyword_false: KeywordSpec = { spelling: "false", kind_name: "KwFalse" }

data punct_eq_eq: PunctSpec = { pattern: "==", width: 2, kind_name: "EqEq" }
data punct_eq_fat: PunctSpec = { pattern: "=>", width: 2, kind_name: "FatArrow" }
data punct_bang_eq: PunctSpec = { pattern: "!=", width: 2, kind_name: "NotEq" }
data punct_lt_eq: PunctSpec = { pattern: "<=", width: 2, kind_name: "Le" }
data punct_gt_eq: PunctSpec = { pattern: ">=", width: 2, kind_name: "Ge" }
data punct_minus_gt: PunctSpec = { pattern: "->", width: 2, kind_name: "Arrow" }
data punct_pipe_gt: PunctSpec = { pattern: "|>", width: 2, kind_name: "PipeArrow" }
data punct_amp_amp: PunctSpec = { pattern: "&&", width: 2, kind_name: "AmpAmp" }
data punct_pipe_pipe: PunctSpec = { pattern: "||", width: 2, kind_name: "PipePipe" }

data punct_eq: PunctSpec = { pattern: "=", width: 1, kind_name: "Eq" }
data punct_lt: PunctSpec = { pattern: "<", width: 1, kind_name: "Lt" }
data punct_gt: PunctSpec = { pattern: ">", width: 1, kind_name: "Gt" }
data punct_plus: PunctSpec = { pattern: "+", width: 1, kind_name: "Plus" }
data punct_minus: PunctSpec = { pattern: "-", width: 1, kind_name: "Minus" }
data punct_star: PunctSpec = { pattern: "*", width: 1, kind_name: "Star" }
data punct_slash: PunctSpec = { pattern: "/", width: 1, kind_name: "Slash" }
data punct_colon: PunctSpec = { pattern: ":", width: 1, kind_name: "Colon" }
data punct_dot: PunctSpec = { pattern: ".", width: 1, kind_name: "Dot" }
data punct_lparen: PunctSpec = { pattern: "(", width: 1, kind_name: "LParen" }
data punct_rparen: PunctSpec = { pattern: ")", width: 1, kind_name: "RParen" }
data punct_lbrace: PunctSpec = { pattern: "{", width: 1, kind_name: "LBrace" }
data punct_rbrace: PunctSpec = { pattern: "}", width: 1, kind_name: "RBrace" }
data punct_lbracket: PunctSpec = { pattern: "[", width: 1, kind_name: "LBracket" }
data punct_rbracket: PunctSpec = { pattern: "]", width: 1, kind_name: "RBracket" }
data punct_comma: PunctSpec = { pattern: ",", width: 1, kind_name: "Comma" }
data punct_semicolon: PunctSpec = { pattern: ";", width: 1, kind_name: "Semicolon" }
data punct_pipe: PunctSpec = { pattern: "|", width: 1, kind_name: "Pipe" }
data punct_question: PunctSpec = { pattern: "?", width: 1, kind_name: "Question" }
