// v3.compiler.tokenize — tokenizer authority for SG-1.
//
// The Rust projection (`tokenize_generated.rs`) is produced by
// `cargo run -p v3-compiler --bin regen_tokenize` — do not hand-edit it.
//
// **Authority boundary.** This file declares token kinds, tokenizer-local
// punctuation that is not modeled in `dsl/extdeps/languages/dag/syntax.dag`,
// string escape behavior, line-comment prefix, string delimiter, and fixed
// tokenizer diagnostic bodies. `regen_tokenize` derives the dedicated keyword
// subset and the shared-operator punctuation subset from the shared syntax
// authority at `dsl/extdeps/languages/dag/syntax.dag`, then merges those with
// the tokenizer-local rows below. That keeps authored spellings for keywords /
// shared operators out of this file.
//
// **Tracked scaffold (SG-1a).** The shared authority handoff is not yet a pure
// structural read: `regen_tokenize` currently parses the raw source text for
// `dag_keyword_set` / `dag_operators` because those bodies still lower as
// `ValueBody::Unparsed`. Named dissolution trigger: once those two shared
// syntax bodies lower structurally under `compile_to_dag`, delete the raw-text
// extractor and derive directly from the lowered Dag in the same PR.
//
// **Scan phases (spec).** After skipping ASCII whitespace, the scanner applies
// in order: line comment (`line_comment_prefix` to newline), punctuation
// (longest match across the shared-operator subset plus local punctuation
// rows), ASCII digit run → decimal `IntLit`, identifier run → keyword table or
// `Ident`, string (`string_literal_delimiter`) with `StringEscapeSpec` rows
// after `\`, else `unexpected byte` diagnostic.

module v3.compiler.tokenize

import v3.std.substrate { SourceSpan }

type TokenKind
  = KwLet
  | KwIf
  | KwThen
  | KwElse
  | KwFn
  | KwType
  | KwModule
  | KwImport
  | KwMatch
  | KwData
  | KwWhere
  | KwTrue
  | KwFalse
  | Ident(String)
  | IntLit(Int)
  | StringLit(String)
  | Eq
  | EqEq
  | NotEq
  | Lt
  | Le
  | Gt
  | Ge
  | Plus
  | Minus
  | Star
  | Slash
  | AmpAmp
  | PipePipe
  | Colon
  | Arrow
  | FatArrow
  | PipeArrow
  | Dot
  | LParen
  | RParen
  | LBrace
  | RBrace
  | LBracket
  | RBracket
  | Comma
  | Semicolon
  | Pipe
  | Question
  | Eof

type Token {
  kind: TokenKind
  span: SourceSpan
}

// Dedicated keyword tokens for the v3 tokenizer. Their spellings derive from
// `dsl/extdeps/languages/dag/syntax.dag`'s `dag_keyword_set`; `tokenize.dag`
// only declares which dedicated keyword variants exist.
type KeywordTokenKind
  = KwLet
  | KwIf
  | KwThen
  | KwElse
  | KwFn
  | KwType
  | KwModule
  | KwImport
  | KwMatch
  | KwData
  | KwWhere
  | KwTrue
  | KwFalse

// Dedicated punctuation tokens for the v3 tokenizer. Shared operator spellings
// derive from `dsl/extdeps/languages/dag/syntax.dag`'s `dag_operators`;
// `LocalPunctSpec` rows below cover only punctuation that the shared syntax
// authority does not model (delimiters, assignment, lambda / arm markers).
// SG-1a banked scaffold: `regen_tokenize` currently classifies each
// `dag_operators` symbol as either tokenizer-owned punctuation or explicit
// parser-only debt (`??`, `%`) and fails closed on any drift. Once shared
// syntax lowers structurally, move that subset relation out of the Rust bridge.
type PunctTokenKind
  = Eq
  | EqEq
  | NotEq
  | Lt
  | Le
  | Gt
  | Ge
  | Plus
  | Minus
  | Star
  | Slash
  | AmpAmp
  | PipePipe
  | Colon
  | Arrow
  | FatArrow
  | PipeArrow
  | Dot
  | LParen
  | RParen
  | LBrace
  | RBrace
  | LBracket
  | RBracket
  | Comma
  | Semicolon
  | Pipe
  | Question

type LocalPunctSpec {
  pattern: String
  kind: PunctTokenKind
}

// After `\` inside a string literal: map the next source byte (as a
// one-character `suffix`) to a Unicode scalar emitted into the string value.
// Unknown suffixes are not listed here; the projection preserves historical
// behavior (`\` + literal suffix char).
type StringEscapeSpec {
  suffix: String
  output_codepoint: Int
}

// Fixed diagnostic message bodies for tokenizer failures (C-8: errors only).
data diagnostic_unterminated_string_escape: String = "unterminated string escape"
data diagnostic_unterminated_string_literal: String = "unterminated string literal"

// `format!("invalid integer literal `{}`", literal)` — prefix/suffix split so
// the delimiter is explicit in data without nested braces in one string.
data diagnostic_invalid_integer_literal_prefix: String = "invalid integer literal `"
data diagnostic_invalid_integer_literal_suffix: String = "`"

// Line comment begins with this two-byte prefix; scanner runs to `\n` or EOF.
data line_comment_prefix: String = "//"

// Opening delimiter for string literals (one ASCII character).
data string_literal_delimiter: String = "\""

data string_escape_dquote: StringEscapeSpec = { suffix: "\"", output_codepoint: 34 }
data string_escape_backslash: StringEscapeSpec = { suffix: "\\", output_codepoint: 92 }
data string_escape_n: StringEscapeSpec = { suffix: "n", output_codepoint: 10 }
data string_escape_r: StringEscapeSpec = { suffix: "r", output_codepoint: 13 }
data string_escape_t: StringEscapeSpec = { suffix: "t", output_codepoint: 9 }

data local_punct_eq: LocalPunctSpec = { pattern: "=", kind: Eq }
data local_punct_colon: LocalPunctSpec = { pattern: ":", kind: Colon }
data local_punct_arrow: LocalPunctSpec = { pattern: "->", kind: Arrow }
data local_punct_fat_arrow: LocalPunctSpec = { pattern: "=>", kind: FatArrow }
data local_punct_lparen: LocalPunctSpec = { pattern: "(", kind: LParen }
data local_punct_rparen: LocalPunctSpec = { pattern: ")", kind: RParen }
data local_punct_lbrace: LocalPunctSpec = { pattern: "{", kind: LBrace }
data local_punct_rbrace: LocalPunctSpec = { pattern: "}", kind: RBrace }
data local_punct_lbracket: LocalPunctSpec = { pattern: "[", kind: LBracket }
data local_punct_rbracket: LocalPunctSpec = { pattern: "]", kind: RBracket }
data local_punct_comma: LocalPunctSpec = { pattern: ",", kind: Comma }
data local_punct_semicolon: LocalPunctSpec = { pattern: ";", kind: Semicolon }
data local_punct_pipe: LocalPunctSpec = { pattern: "|", kind: Pipe }
data local_punct_question: LocalPunctSpec = { pattern: "?", kind: Question }
