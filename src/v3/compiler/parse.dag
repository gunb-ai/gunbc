// v3.compiler.parse — surface **carrier** schema for SG-2 **parser staging** (not SG-2b hard cutover).
//
// **What `.dag` owns here:** `Surface*` module / item / expression / type / pattern shapes for the
// v3 surface grammar. Tokenization stays in `tokenize.dag`; lowering stays in `lower.rs`.
//
// **What is still outside `.dag`:** the recursive-descent algorithm lives in the checked-in Rust
// fragment `parse_parser_body.txt`. `cargo run -p v3-compiler --bin regen_parse` lowers this file’s
// type declarations and splices that fragment into `parse_generated.rs`. There is no second runtime
// parser, but **semantic parse-rule authority is split** (schema in `.dag`, algorithm in `.txt`)
// until SG-2b converges.
//
// **Dissolution trigger — `parse_parser_body.txt`:** delete the fragment (and teach `regen_parse` to
// emit the full module without it) once parse rules are structurally `.dag`-owned — Phase 4a direct
// port or Phase 4b grammar-as-data per `src/v3/SELF_HOSTING.md` §6. Until then, treat the `.txt` as
// **temporary staging**, not omission-grade final authority.
//
// The Rust projection (`parse_generated.rs`) is produced by `regen_parse` — do not hand-edit it.

module v3.compiler.parse

import v3.std.substrate { SourceSpan, Int, Bool }
import std.list { List }
import v3.compiler.operators { OperatorKind }

type SurfaceModule {
  items: List<SurfaceItem>
}

type SurfaceItem
  = Let { name: String, type_ann: SurfaceType?, expr: SurfaceExpr }
  | Fn {
      name: String
      type_params: List<String>
      params: List<SurfaceParam>
      return_type: SurfaceType
      body: SurfaceExpr
      span: SourceSpan
    }
  | FnExternalBody {
      name: String
      type_params: List<String>
      params: List<SurfaceParam>
      return_type: SurfaceType
      body_span: SourceSpan
      span: SourceSpan
    }
  | Data {
      name: String
      ty: SurfaceType
      body: SurfaceExpr?
      body_span: SourceSpan
      span: SourceSpan
    }
  | Module { path: List<String>, span: SourceSpan }
  | Import { path: List<String>, names: List<String>, span: SourceSpan }
  | TypeAtom {
      name: String
      type_params: List<String>
      span: SourceSpan
    }
  | TypeRecord {
      name: String
      type_params: List<String>
      fields: List<SurfaceField>
      span: SourceSpan
    }
  | TypeSum {
      name: String
      type_params: List<String>
      variants: List<SurfaceVariant>
      span: SourceSpan
    }
  | TypeAlias {
      name: String
      type_params: List<String>
      target: SurfaceType
      span: SourceSpan
    }

type SurfaceParam {
  name: String
  ty: SurfaceType
  refinement: SurfaceExpr?
}

type SurfaceField {
  name: String
  ty: SurfaceType
}

type SurfaceVariant {
  name: String
  payload: VariantPayload
  span: SourceSpan
}

type VariantPayload
  = Positional(List<SurfaceType>)
  | Record(List<SurfaceField>)

type SurfaceType
  = Named { name: String, span: SourceSpan }
  | Parameterized {
      name: String
      args: List<SurfaceType>
      span: SourceSpan
    }
  | Optional { inner: SurfaceType, span: SourceSpan }
  | Arrow {
      inputs: List<SurfaceType>
      output: SurfaceType
      span: SourceSpan
    }

// SurfaceLiteral variant labels MUST stay `Int` / `Bool` / `String` — the same
// names as the historical handwritten parser — so generated Rust matches
// `lower.rs` and every `SurfaceLiteral::…` constructor site. Do not rename to
// `IntLit` / `BoolLit` / `StringLit` (tokenizer token kinds, not surface literals).
type SurfaceLiteral
  = Int(Int)
  | Bool(Bool)
  | String(String)

type SurfaceRecordField {
  name: String
  value: SurfaceExpr
  span: SourceSpan
}

type SurfaceMatchArm {
  pattern: SurfacePattern
  body: SurfaceExpr
  span: SourceSpan
}

type SurfacePatternField {
  name: String
  binding: String
  span: SourceSpan
}

type SurfacePattern
  = BareVariant { name: String, span: SourceSpan }
  | VariantWith { name: String, binding: String, span: SourceSpan }
  | VariantFields {
      name: String
      fields: List<SurfacePatternField>
      span: SourceSpan
    }

type SurfaceExpr
  = Literal { value: SurfaceLiteral, span: SourceSpan }
  | Var { name: String, span: SourceSpan }
  | Path {
      segments: List<String>
      segment_spans: List<SourceSpan>
      span: SourceSpan
    }
  | Call { target: String, args: List<SurfaceExpr>, span: SourceSpan }
  | VariantRecord {
      target: String
      fields: List<SurfaceRecordField>
      span: SourceSpan
    }
  | Operator { op: OperatorKind, args: List<SurfaceExpr>, span: SourceSpan }
  | Lambda { params: List<String>, body: SurfaceExpr, span: SourceSpan }
  | If {
      cond: SurfaceExpr
      then_branch: SurfaceExpr
      else_branch: SurfaceExpr
      span: SourceSpan
    }
  | Match {
      scrutinee: SurfaceExpr
      arms: List<SurfaceMatchArm>
      span: SourceSpan
    }
  | Record { fields: List<SurfaceRecordField>, span: SourceSpan }
  | List { elements: List<SurfaceExpr>, span: SourceSpan }
