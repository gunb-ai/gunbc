module v3.compiler.pipeline

import v3.std.substrate { Dag }
import v3.spec.v3_l1 { DeclarationRef }
import v3.spec.rust { LanguageSpec }

// L1.5 pipeline authority. The staged bootstrap upgrades the five
// stage declarations below to `ArrowBody::ExternalRealization`
// bodies so the declaration table carries the intended host-backed
// execution shape. The source bodies stay trivially type-correct so
// the file parses and lowers cleanly today.

type CompilerHostRealization {
  symbol: String
}

type PipelineSnapshotKind = SnapshotSurface | SnapshotDag | SnapshotText

type PipelineStageBinding {
  stage: DeclarationRef
  realization: DeclarationRef
  snapshot: PipelineSnapshotKind
}

data parse_realization: CompilerHostRealization = {
  symbol: "v3_compiler::parse"
}

data lower_realization: CompilerHostRealization = {
  symbol: "v3_compiler::lower"
}

data infer_realization: CompilerHostRealization = {
  symbol: "v3_compiler::infer"
}

data compute_ownership_realization: CompilerHostRealization = {
  symbol: "v3_compiler::compute_ownership"
}

data emit_realization: CompilerHostRealization = {
  symbol: "v3_compiler::emit"
}

data lens_complexity_realization: CompilerHostRealization = {
  symbol: "v3_compiler::lens_complexity"
}

data parse_stage_binding: PipelineStageBinding = {
  stage: parse
  realization: parse_realization
  snapshot: SnapshotSurface
}

data lower_stage_binding: PipelineStageBinding = {
  stage: lower
  realization: lower_realization
  snapshot: SnapshotDag
}

data infer_stage_binding: PipelineStageBinding = {
  stage: infer
  realization: infer_realization
  snapshot: SnapshotDag
}

data compute_ownership_stage_binding: PipelineStageBinding = {
  stage: compute_ownership
  realization: compute_ownership_realization
  snapshot: SnapshotDag
}

data lens_complexity_stage_binding: PipelineStageBinding = {
  stage: lens_complexity
  realization: lens_complexity_realization
  snapshot: SnapshotDag
}

data emit_stage_binding: PipelineStageBinding = {
  stage: emit
  realization: emit_realization
  snapshot: SnapshotText
}

fn parse(source: String, file: String) -> Dag {
  host parse
}

fn lower(dag: Dag) -> Dag {
  host lower
}

fn infer(dag: Dag) -> Dag {
  host infer
}

fn compute_ownership(dag: Dag) -> Dag {
  host ownership
}

fn lens_complexity(dag: Dag) -> Dag {
  host complexity
}

fn emit(
  inferred: Dag,
  ownership: Dag,
  complexity: Dag,
  spec: LanguageSpec
) -> String {
  host emit
}

fn compile(source: String, file: String, spec: LanguageSpec) -> String {
  parse
  lower
  infer
  compute_ownership
  lens_complexity
  emit
}
