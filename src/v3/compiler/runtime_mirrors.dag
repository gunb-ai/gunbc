module v3.compiler.runtime_mirrors

import v3.std.diagnostics { Correction }
import v3.std.substrate {
  ClusterId,
  DeclarationId,
  NodeId,
  NonEmptyList,
  NonSingletonList,
  ParamRef,
  PortId,
  SourceSpan,
  TransformRef,
  TypeShape
}

type DagDifference {
  detail: String
}

type CompilerLiteralBits
  = Int(Int)
  | Bool(Bool)
  | String(String)

type CompilerCardinalityBound
  = Exact(Int)
  | AtMostOne
  | Unbounded

type CompilerTemplateArgument {
  parameter: DeclarationId
  value: DeclarationId
}

type CompilerPortState
  = Uninferred
  | Resolved(TypeShape)
  | Unresolved

type CompilerBranchPattern
  = UnresolvedVariant {
      name: String
      span: SourceSpan
    }
  | ResolvedVariant(DeclarationId)

type CompilerPayloadBinding {
  binding_name: String
  payload_port: PortId
}

type CompilerPath {
  body: NodeId
  output: PortId
  pattern: CompilerBranchPattern
  binding: CompilerPayloadBinding?
}

type CompilerMemberDescent {
  param: ParamRef
}

type CompilerIntraClusterCall {
  transform: TransformRef
}

type CompilerCluster {
  members: NonSingletonList<CompilerMemberDescent>
  intra_cluster_calls: NonEmptyList<CompilerIntraClusterCall>
}

type CompilerLoopBound
  = Cardinality {
      count: PortId
    }
  | Descent {
      cluster: ClusterId
    }
