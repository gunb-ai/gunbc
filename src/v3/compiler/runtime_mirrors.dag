module v3.compiler.runtime_mirrors

import std.list { List }
import v3.std.substrate { SourceSpan, OperatorKind }

type DagDifference {
  detail: String
}

// SG-3f — parse-surface reflection foundation.
//
// These declarations mirror the parser's Surface* carriers so they
// exist as substrate authority rather than only as handwritten Rust
// types in `parse.rs`. The parser still constructs its native Rust
// structs/enums today; SG-3f's job is the structural foundation:
// lower.dag can now target a declared surface schema instead of
// inventing a parallel one later.
type SurfaceModule {
  items: List<SurfaceItem>
}

type SurfaceParam {
  name: String
  ty: SurfaceType
  refinement: SurfaceExpr?
}

type SurfaceField {
  name: String
  ty: SurfaceType
}

type SurfaceVariant {
  name: String
  payload: VariantPayload
  span: SourceSpan
}

// 🟢 TERMINAL at variant-payload shape scope for `runtime_mirrors`. `Positional` vs `Record`
// names two surface encodings of constructor payloads at this mirror; ledger: patterns 1–4
// from modeling-discipline §4 are N/A here (finer decomposition belongs in parse-rule authority).
type VariantPayload
  = Positional(List<SurfaceType>)
  | Record(List<SurfaceField>)

// 🟡 SCAFFOLD at SG-2 parser-staging carrier scope (substrate mirror, not parse-rule authority).
// **Named trigger:** `parse_parser_body.txt` header (emit algorithm from `.dag` alone) plus
// SG-2b / SG-3f parse-rule cutover aligned with `lower.rs`.
type SurfaceType
  = Named { name: String, span: SourceSpan }
  | Parameterized {
      name: String
      args: List<SurfaceType>
      span: SourceSpan
    }
  | Optional {
      inner: SurfaceType
      span: SourceSpan
    }
  | Arrow {
      inputs: List<SurfaceType>
      output: SurfaceType
      span: SourceSpan
    }

type SurfaceRecordField {
  name: String
  value: SurfaceExpr
  span: SourceSpan
}

type SurfaceMatchArm {
  pattern: SurfacePattern
  body: SurfaceExpr
  span: SourceSpan
}

type SurfacePatternField {
  name: String
  binding: String
  span: SourceSpan
}

// 🟡 SCAFFOLD — mirrored surface pattern forms; same dissolution trigger as `SurfaceType`.
type SurfacePattern
  = BareVariant { name: String, span: SourceSpan }
  | VariantWith {
      name: String
      binding: String
      span: SourceSpan
    }
  | VariantFields {
      name: String
      fields: List<SurfacePatternField>
      span: SourceSpan
    }

// 🟢 TERMINAL at runtime_mirrors surface-literal scope. Three literal classes are irreducible
// input distinctions here; ledger: patterns 1–4 N/A (no finer substrate split without changing
// the language surface). **Naming contract:** SurfaceLiteral variant labels MUST stay `Int` /
// `Bool` / `String` — the same names as the historical handwritten parser — so generated Rust
// matches `lower.rs` and every `SurfaceLiteral::…` constructor site. Do not rename to
// `IntLit` / `BoolLit` / `StringLit` (tokenizer token kinds, not surface literals).
type SurfaceLiteral
  = Int(Int)
  | Bool(Bool)
  | String(String)

// 🟡 SCAFFOLD — expression carrier mirror; same dissolution trigger as `SurfaceType`.
type SurfaceExpr
  = Literal { value: SurfaceLiteral, span: SourceSpan }
  | Var { name: String, span: SourceSpan }
  | Path {
      segments: List<String>
      segment_spans: List<SourceSpan>
      span: SourceSpan
    }
  | Call {
      target: String
      args: List<SurfaceExpr>
      span: SourceSpan
    }
  | VariantRecord {
      target: String
      fields: List<SurfaceRecordField>
      span: SourceSpan
    }
  | Operator {
      op: OperatorKind
      args: List<SurfaceExpr>
      span: SourceSpan
    }
  | Lambda {
      params: List<String>
      body: SurfaceExpr
      span: SourceSpan
    }
  | If {
      cond: SurfaceExpr
      then_branch: SurfaceExpr
      else_branch: SurfaceExpr
      span: SourceSpan
    }
  | Match {
      scrutinee: SurfaceExpr
      arms: List<SurfaceMatchArm>
      span: SourceSpan
    }
  | Record {
      fields: List<SurfaceRecordField>
      span: SourceSpan
    }
  | List {
      elements: List<SurfaceExpr>
      span: SourceSpan
    }

// 🟡 SCAFFOLD — top-level item carrier mirror; same dissolution trigger as `SurfaceType`.
type SurfaceItem
  = Let {
      name: String
      type_ann: SurfaceType?
      expr: SurfaceExpr
    }
  | Fn {
      name: String
      type_params: List<String>
      params: List<SurfaceParam>
      return_type: SurfaceType
      body: SurfaceExpr
      span: SourceSpan
    }
  | FnExternalBody {
      name: String
      type_params: List<String>
      params: List<SurfaceParam>
      return_type: SurfaceType
      body_span: SourceSpan
      span: SourceSpan
    }
  | Data {
      name: String
      ty: SurfaceType
      body: SurfaceExpr?
      body_span: SourceSpan
      span: SourceSpan
    }
  | Module { path: List<String>, span: SourceSpan }
  | Import {
      path: List<String>
      names: List<String>
      span: SourceSpan
    }
  | TypeAtom {
      name: String
      type_params: List<String>
      span: SourceSpan
    }
  | TypeRecord {
      name: String
      type_params: List<String>
      fields: List<SurfaceField>
      span: SourceSpan
    }
  | TypeSum {
      name: String
      type_params: List<String>
      variants: List<SurfaceVariant>
      span: SourceSpan
    }
  | TypeAlias {
      name: String
      type_params: List<String>
      target: SurfaceType
      span: SourceSpan
    }
