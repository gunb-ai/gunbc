module v3.compiler.runtime_mirrors

import std.list { List }
import v3.std.substrate { PortId, DeclarationId, TypeShape }

type CompilerSourceSpan {
  file: String
  byte_start: Int
  byte_end: Int
}

type CompilerCorrection {
  description: String
  span: CompilerSourceSpan
  new_source: String
}

type CompilerDiagnostic
  = TokenizerError {
      message: String
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | ParseError {
      message: String
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | TypeMismatch {
      expected: TypeShape
      actual: TypeShape
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | ArityMismatch {
      function: String
      expected: Int
      actual: Int
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | ResolveError {
      name: String
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | BranchConditionNotBool {
      port: PortId
      actual_type: TypeShape?
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }

type CompilerDiagnosticStyleTarget
  = Rust
  | Go
  | Python

type CompilerDiagnosticRenderError
  = MissingCleanEmissionContract(String)
  | MalformedCleanEmissionContract {
      declaration: DeclarationId
      detail: String
    }
  | MissingCorrectionStyle(String)
  | MalformedCorrectionStyle {
      declaration: DeclarationId
      detail: String
    }

type DagDifference {
  detail: String
}

type LiteralBits
  = Int(Int)
  | Bool(Bool)
  | String(String)

type CardinalityBound
  = Exact(Int)
  | AtMostOne
  | Unbounded

type TemplateArgument {
  parameter: DeclarationId
  value: DeclarationId
}

type PortState
  = Uninferred
  | Resolved(TypeShape)
  | Unresolved

type BranchPattern
  = UnresolvedVariant {
      name: String
      span: CompilerSourceSpan
    }
  | ResolvedVariant(DeclarationId)

type PayloadBinding {
  binding_name: String
  payload_port: PortId
}

type Path {
  body: NodeId
  output: PortId
  pattern: BranchPattern
  binding: PayloadBinding?
}

type MemberDescent {
  param: ParamRef
}

type IntraClusterCall {
  transform: TransformRef
}

type Cluster {
  members: NonSingletonList<MemberDescent>
  intra_cluster_calls: NonEmptyList<IntraClusterCall>
}

type LoopBound
  = Cardinality {
      count: PortId
    }
  | Descent {
      cluster: ClusterId
    }
