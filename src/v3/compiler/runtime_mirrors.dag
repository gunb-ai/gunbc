module v3.compiler.runtime_mirrors

import std.list { List }
import v3.std.substrate { PortId, DeclarationId, TypeShape }

type CompilerSourceSpan {
  file: String
  byte_start: Int
  byte_end: Int
}

type CompilerCorrection {
  description: String
  span: CompilerSourceSpan
  new_source: String
}

type CompilerDiagnostic
  = TokenizerError {
      message: String
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | ParseError {
      message: String
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | TypeMismatch {
      expected: TypeShape
      actual: TypeShape
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | ArityMismatch {
      function: String
      expected: Int
      actual: Int
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | ResolveError {
      name: String
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }
  | BranchConditionNotBool {
      port: PortId
      actual_type: TypeShape?
      span: CompilerSourceSpan
      fixes: List<CompilerCorrection>
    }

type CompilerDiagnosticStyleTarget
  = Rust
  | Go
  | Python

type CompilerDiagnosticRenderError
  = MissingCleanEmissionContract(String)
  | MalformedCleanEmissionContract {
      declaration: DeclarationId
      detail: String
    }
  | MissingCorrectionStyle(String)
  | MalformedCorrectionStyle {
      declaration: DeclarationId
      detail: String
    }

type DagDifference {
  detail: String
}

type CompilerLiteralBits
  = Int(Int)
  | Bool(Bool)
  | String(String)

type CompilerCardinalityBound
  = Exact(Int)
  | AtMostOne
  | Unbounded

type CompilerTemplateArgument {
  parameter: DeclarationId
  value: DeclarationId
}

type CompilerPortState
  = Uninferred
  | Resolved(TypeShape)
  | Unresolved

type CompilerBranchPattern
  = UnresolvedVariant {
      name: String
      span: CompilerSourceSpan
    }
  | ResolvedVariant(DeclarationId)

type CompilerPayloadBinding {
  binding_name: String
  payload_port: PortId
}

type CompilerPath {
  body: NodeId
  output: PortId
  pattern: CompilerBranchPattern
  binding: CompilerPayloadBinding?
}

type CompilerMemberDescent {
  param: ParamRef
}

type CompilerIntraClusterCall {
  transform: TransformRef
}

type CompilerCluster {
  members: NonSingletonList<CompilerMemberDescent>
  intra_cluster_calls: NonEmptyList<CompilerIntraClusterCall>
}

type CompilerLoopBound
  = Cardinality {
      count: PortId
    }
  | Descent {
      cluster: ClusterId
    }
