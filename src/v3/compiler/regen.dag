// Absorbed from SG-4 prep (PR #562): `regen_infer_helpers.rs` was
// landed as a per-file regen driver mirroring the deleted
// `regen_lens_*` bins, explicitly flagged in its own header as
// "SG-6 owns folding all of these into a single generic regen
// target". This is that absorption. `infer_helpers.dag` is a lens
// in the broad sense the registry uses (reads substrate Dag, emits
// a Rust module via `emit_rust_module`), so it fits the existing
// `LensRegistryEntry` shape without a rename. A future `.dag`
// artifact that is genuinely non-lens would trigger the widening
// to a `GeneratedArtifactEntry` carrier.
data lens_infer_helpers_entry: LensRegistryEntry = {
  name: "infer_helpers"
  lens_file: "src/v3/lenses/infer_helpers.dag"
  generated_file: "src/v3/compiler/src/infer_helpers_generated.rs"
}

data lens_variant_payload_entry: LensRegistryEntry = {
  name: "variant_payload"
  lens_file: "src/v3/lenses/variant_payload.dag"
  generated_file: "src/v3/compiler/src/variant_payload_generated.rs"
}

// SG-3g prototype — first `.dag`-authority lowering helper. Slice
// rationale and emitter gaps that blocked wider extraction are in
// `lenses/lower_helpers.dag`. `lower.rs` consumes `expr_span` via
// `crate::lower_helpers` (SG-3g-b wire-in).
data lens_lower_helpers_entry: LensRegistryEntry = {
  name: "lower_helpers"
  lens_file: "src/v3/lenses/lower_helpers.dag"
  generated_file: "src/v3/compiler/src/lower_helpers_generated.rs"
}
