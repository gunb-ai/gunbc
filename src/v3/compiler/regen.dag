module v3.compiler.regen

import std.types { FilePath, NonEmptyStr }

// Lens regen registry. Each `data <name>_entry: LensRegistryEntry`
// record below is picked up structurally by the `regen_lens` binary
// (`dag.declarations().filter(meta_tag == LensRegistryEntry)`), which
// then reads `lens_file`, emits the Rust projection via
// `emit_rust_module`, and writes to `generated_file`. Mirrors the
// `PipelineStageBinding` pattern in `src/v3/compiler/pipeline.dag`.
//
// Adding a new generated lens is a pure `.dag` edit: drop the lens
// source in `src/v3/lenses/`, add a `data ..._entry: LensRegistryEntry`
// record here with the three paths filled in, and
// `cargo run -p v3-compiler --bin regen_lens` picks it up. No
// per-lens Rust driver is added or edited.
//
// `name` composes from `std.types::NonEmptyStr` (= `String where
// non_empty`) so the `--lens <name>` selector key cannot encode an
// empty string. `lens_file` and `generated_file` compose from
// `std.types::FilePath` (also `String where non_empty`) per
// MODELING M9 — every field attaches to the existing path/identifier
// vocabulary rather than reintroduce a raw `String`. Refinement
// means empty-string entries cannot be lowered into the registry,
// closing the "illegal states representable" hole that a raw
// `String` would leave open across all three fields.
//
// **Band-C cementing dispatch.** Each new `LensRegistryEntry` must
// update `docs/v3-lens-capability-register.md` (see its Discipline
// section). If the register row is `BEHAVIORALLY COMPLETE` and names
// a concrete v2 counterpart, add a matching behavioral cementing
// module under `src/v3/compiler/tests/integration/cementing/` and
// extend the ratchet slice in
// `cementing_lens_registry_dispatch_test.rs` in the same PR. See
// `TESTING.md` ("Cementing tests (Band C — lens subsumption)").

type LensRegistryEntry {
  name: NonEmptyStr
  lens_file: FilePath
  generated_file: FilePath
}

data lens_cost_entry: LensRegistryEntry = {
  name: "cost"
  lens_file: "src/v3/lenses/complexity.dag"
  generated_file: "src/v3/compiler/src/lens_cost_generated.rs"
}

data lens_cost_symbolic_entry: LensRegistryEntry = {
  name: "cost_symbolic"
  lens_file: "src/v3/lenses/cost.dag"
  generated_file: "src/v3/compiler/src/lens_cost_symbolic_generated.rs"
}

data lens_provenance_entry: LensRegistryEntry = {
  name: "provenance"
  lens_file: "src/v3/lenses/provenance.dag"
  generated_file: "src/v3/compiler/src/lens_provenance_generated.rs"
}

data lens_structural_resolution_entry: LensRegistryEntry = {
  name: "structural_resolution"
  lens_file: "src/v3/lenses/structural_resolution.dag"
  generated_file: "src/v3/compiler/src/lens_structural_resolution_generated.rs"
}

data lens_unused_parameters_entry: LensRegistryEntry = {
  name: "unused_parameters"
  lens_file: "src/v3/lenses/unused_parameters.dag"
  generated_file: "src/v3/compiler/src/lens_unused_parameters_generated.rs"
}

// Absorbed from SG-4 prep (PR #562): `regen_infer_helpers.rs` was
// landed as a per-file regen driver mirroring the deleted
// `regen_lens_*` bins, explicitly flagged in its own header as
// "SG-6 owns folding all of these into a single generic regen
// target". This is that absorption. `infer_helpers.dag` is a lens
// in the broad sense the registry uses (reads substrate Dag, emits
// a Rust module via `emit_rust_module`), so it fits the existing
// `LensRegistryEntry` shape without a rename. A future `.dag`
// artifact that is genuinely non-lens would trigger the widening
// to a `GeneratedArtifactEntry` carrier.
data lens_infer_helpers_entry: LensRegistryEntry = {
  name: "infer_helpers"
  lens_file: "src/v3/lenses/infer_helpers.dag"
  generated_file: "src/v3/compiler/src/infer_helpers_generated.rs"
}

data lens_variant_payload_entry: LensRegistryEntry = {
  name: "variant_payload"
  lens_file: "src/v3/lenses/variant_payload.dag"
  generated_file: "src/v3/compiler/src/variant_payload_generated.rs"
}

// SG-3g prototype — first `.dag`-authority lowering helper. Slice
// rationale and emitter gaps that blocked wider extraction are in
// `lenses/lower_helpers.dag`. `lower.rs` consumes `expr_span` via
// `crate::lower_helpers` (SG-3g-b wire-in).
data lens_lower_helpers_entry: LensRegistryEntry = {
  name: "lower_helpers"
  lens_file: "src/v3/lenses/lower_helpers.dag"
  generated_file: "src/v3/compiler/src/lower_helpers_generated.rs"
}
