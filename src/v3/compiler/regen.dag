module v3.compiler.regen

// Lens regen registry. Each `data <name>_entry: LensRegistryEntry`
// record below is picked up structurally by the `regen_lens` binary
// (`dag.declarations().filter(meta_tag == LensRegistryEntry)`), which
// then reads `lens_file`, emits the Rust projection via
// `emit_rust_module`, and writes to `generated_file`. Mirrors the
// `PipelineStageBinding` pattern in `src/v3/compiler/pipeline.dag`.
//
// Adding a new generated lens is a pure `.dag` edit: drop the lens
// source in `src/v3/lenses/`, add a `data ..._entry: LensRegistryEntry`
// record here with the three paths filled in, and
// `cargo run -p v3-compiler --bin regen_lens` picks it up. No
// per-lens Rust driver is added or edited.

type LensRegistryEntry {
  name: String
  lens_file: String
  generated_file: String
}

data lens_cost_entry: LensRegistryEntry = {
  name: "cost"
  lens_file: "src/v3/lenses/complexity.dag"
  generated_file: "src/v3/compiler/src/lens_cost_generated.rs"
}

data lens_cost_symbolic_entry: LensRegistryEntry = {
  name: "cost_symbolic"
  lens_file: "src/v3/lenses/cost.dag"
  generated_file: "src/v3/compiler/src/lens_cost_symbolic_generated.rs"
}

data lens_provenance_entry: LensRegistryEntry = {
  name: "provenance"
  lens_file: "src/v3/lenses/provenance.dag"
  generated_file: "src/v3/compiler/src/lens_provenance_generated.rs"
}

data lens_structural_resolution_entry: LensRegistryEntry = {
  name: "structural_resolution"
  lens_file: "src/v3/lenses/structural_resolution.dag"
  generated_file: "src/v3/compiler/src/lens_structural_resolution_generated.rs"
}

data lens_unused_parameters_entry: LensRegistryEntry = {
  name: "unused_parameters"
  lens_file: "src/v3/lenses/unused_parameters.dag"
  generated_file: "src/v3/compiler/src/lens_unused_parameters_generated.rs"
}
