module v3.compiler.regen

import std.types { FilePath, NonEmptyStr }

// Lens regen registry. Each `data <name>_entry: LensRegistryEntry`
// record below is picked up structurally by the `regen_lens` binary
// (`dag.declarations().filter(meta_tag == LensRegistryEntry)`), which
// then reads `lens_file`, emits the Rust projection via
// `emit_rust_module`, and writes to `generated_file`. Mirrors the
// `PipelineStageBinding` pattern in `src/v3/compiler/pipeline.dag`.
//
// Adding a new generated lens is a pure `.dag` edit: drop the lens
// source in `src/v3/lenses/`, add a `data ..._entry: LensRegistryEntry`
// record here with the three paths filled in, and
// `cargo run -p v3-compiler --bin regen_lens` picks it up. No
// per-lens Rust driver is added or edited.
//
// `name` composes from `std.types::NonEmptyStr` (= `String where
// non_empty`) so the `--lens <name>` selector key cannot encode an
// empty string. `lens_file` and `generated_file` compose from
// `std.types::FilePath` (also `String where non_empty`) per
// MODELING M9 — every field attaches to the existing path/identifier
// vocabulary rather than reintroduce a raw `String`. Refinement
// means empty-string entries cannot be lowered into the registry,
// closing the "illegal states representable" hole that a raw
// `String` would leave open across all three fields.
//
// **Band-C cementing dispatch.** Each new `LensRegistryEntry` must update
// `docs/v3-lens-capability-register.md` and the structural mirror at
// `src/v3/std/verification.dag` (`data lens_capability_register_rows`) in the
// same PR. Add or extend the gate-#87 harness
// `src/v3/compiler/tests/dag/t_r3_gate_87_cementing_regen_<name>.dag`, wire it
// through `R3_GATE_87_CEMENTING_REGEN_SUITES`, and, when the row is
// `BEHAVIORALLY COMPLETE`, land the matching behavioral receipt in that same
// change. Real-v2 COMPLETE rows also extend
// `src/v3/compiler/tests/dag/cementing_dispatch.dag`
// (`cementing_band_c_v2_complete_receipts`); temporary Rust receipts are allowed
// only with `tests/integration.rs` wiring plus a named blocker/dissolution path.
// See `TESTING.md` ("Cementing tests (Band C — lens subsumption)" →
// "Same-PR checklist — promoting a row to `BEHAVIORALLY COMPLETE`").

type LensRegistryEntry {
  name: NonEmptyStr
  lens_file: FilePath
  generated_file: FilePath
}

data lens_cost_entry: LensRegistryEntry = {
  name: "cost"
  lens_file: "src/v3/lenses/complexity.dag"
  generated_file: "src/v3/compiler/src/complexity_lens_generated.rs"
}

data lens_cost_symbolic_entry: LensRegistryEntry = {
