// §3.3 — `wrap`. Parameter reaches the return via record
// construction (embedded in a Conj value).
//
//   Expected disposition (post-Track-1-Phase-2): Consumed.
//   Reachability fact today: UnusedParametersLens reports the
//   parameter as USED (the body's `{ value: x }` record captures it).
//
// Abstraction boundary probed: "reach return through construct".
type Box { value: Int }
fn wrap(x: Int) -> Box = { value: x }
let boxed: Box = wrap(1)
let sample: Int = boxed.value
