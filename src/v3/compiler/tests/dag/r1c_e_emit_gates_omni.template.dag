// R1C-E — T-Emit omni three-way gate (separate template so the integration
// receipt can stay `#[ignore]`d: `go` + `python3` are not on all CI images).
// `__R1C_E_BIN__` is replaced with `env!("CARGO_BIN_EXE_r1c_e_emit_gates")`
// in `r1c_e_emit_gates_omni_dag_test.rs`. `ForAllTargets` is not wired in the
// Rust `TestRunner` (see `test_runner.rs`); this gate is one `ExecuteCommand`
// to the `omni-demo` subcommand (brief §3 — three separate claims not needed).

module v3.compiler.tests.r1c_e_emit_gates_omni

import std.verification { TestClaim, TestSuite }

data emit_omni_demo_fixtures_green_claim: TestClaim = {
  name: "emit_omni_demo_fixtures_green",
  source: "let marker: Int = 1",
  file_name: "r1c_e_emit_gates_omni_smoke.v3",
  predicate: ExecuteCommand("__R1C_E_BIN__", ["omni-demo"], 0),
  requires: []
}

data r1c_e_emit_gates_omni_suite: TestSuite = {
  name: "r1c_e_emit_gates_omni_suite",
  claims: [emit_omni_demo_fixtures_green_claim]
}
