module v3.compiler.tests.t_r3.gate_87_cementing_regen_provenance

import std.substrate { Dag }
import std.verification { LensOutputEquals, ProgramInput, TestClaim, TestSuite }

fn gate87_provenance_literal_origin_source(d: Dag) -> Int = 0

fn gate87_provenance_sum_origin_computed(d: Dag) -> Int = 0

data gate87_program_input: ProgramInput = {}

data gate87_expected_true: Int = 1

data cementing_regen_provenance_claim: TestClaim = {
  name: "cementing_regen_provenance",
  source: "let lit: Int = 7",
  file_name: "r3_gate_87_provenance_smoke.v3",
  predicate: LensOutputEquals(
    gate87_provenance_literal_origin_source,
    gate87_program_input,
    gate87_expected_true
