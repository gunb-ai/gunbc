  source: "let sum: Int = 1 + 2",
  file_name: "r3_gate_87_provenance_sum_smoke.v3",
  predicate: LensOutputEquals(
    gate87_provenance_sum_origin_computed,
    gate87_program_input,
    gate87_expected_true
  ),
  requires: []
}

data r3_gate_87_cementing_regen_provenance_suite: TestSuite = {
  name: "r3-gate-87/cementing/regen/provenance",
  claims: [
    Enumerated(cementing_regen_provenance_claim),
    Enumerated(cementing_regen_provenance_sum_claim)
