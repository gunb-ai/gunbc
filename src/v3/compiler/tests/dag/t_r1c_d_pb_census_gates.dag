      PendingFact { output_path: "src/v3/compiler/src/parse_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/parse_surface_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/parse_tables_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/serialize_generated.rs" },
