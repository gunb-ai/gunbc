data pb_rust_tests_outside_residual_zero_gate: TestClaim = {
  name: "pb_rust_tests_outside_residual_zero",
  source: "// PB census predicates read external census state, not this source.\nlet _: Int = 0\n",
  file_name: "r1_pb_rust_tests_outside_residual_zero.v3",
  predicate: CensusBoundCheck {
    authority: self_gen_census_test_authority,
    list_constant: expected_hand_authored_test,
    bound: 0
  },
  requires: []
}

data r1_pb_census_gates_suite: TestSuite = {
  name: "r1_pb_census_gates_suite",
  claims: [
    Enumerated(pb_hand_rust_at_shim_floor_gate),
    Enumerated(lens_producer_files_remaining_gate),
    Enumerated(pb_self_compile_fixed_point_gate),
    Enumerated(pb_compiler_std_ratchet_zero_gate),
    Enumerated(pb_test_file_generated_from_dag_gate),
    Enumerated(pb_rust_tests_outside_residual_zero_gate)
  ]
}
