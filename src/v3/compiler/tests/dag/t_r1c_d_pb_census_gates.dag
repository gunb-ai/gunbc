// R1C-D — PB census `.dag` TestClaim fixtures for the six
// PB census gates (T-PB-A ×4 + T-PB-B ×2). The Rust ratchets in
// `src/v3/compiler/tests/integration/self_gen_census_test.rs` remain the
// drift-detection authority on the underlying lists; this file wires the
// release-gate `.dag` layer that R1 close evaluates, per the strict
// reading of `THESIS.md §"Tests are structural data"`.
//
// Predicate shapes consumed here (`CensusBoundCheck`, `CensusSubsetCount`,
// `FixedPointConverges`, `RatchetZero`, `GeneratedFromDag`) live at
// `src/v3/std/verification.dag`. Runner dispatch lives at
// `src/v3/compiler/src/test_runner.rs::run_claim` (the
// `eval_*_shape` family).
//
// **Today's evaluation state** (R1C-D acceptance: gate evaluates `Pass`
// or `Fail` against the live census, never `NotYetImplemented`):
//
//   D.1 / D.6 — `CensusBoundCheck` against `EXPECTED_HAND_AUTHORED_*`
//               at `bound = 0` is RED until cascade-promotion 0-floor
//               (`docs/design-pure-bootstrap-zero.md`, LIVE 2026-04-25)
//               retires the residual lists. Pacing owned by Pure
//               Bootstrap to Zero program; surfaced cross-manager.
//   D.2 — `CensusSubsetCount` lens-producer subset over the non-test
//         census; same dissolution-pacing dependency as D.1.
//   D.3 — `FixedPointConverges` runs DB-8 twice and compares snapshots.
//   D.4 — `RatchetZero` checks the consolidation ratchet count.
//   D.5 — `GeneratedFromDag` requires the `.dag` manifest to enumerate every
//         `build.rs::REGEN_OUTPUTS` path exactly once (set equality with
//         `GENERATED_FILES`) and that the `EXPECTED_HAND_AUTHORED_TEST` census
//         is empty (Gate #84 negative authority).
//
// Lives under `src/v3/compiler/tests/dag/` alongside other `TestRunner`
// harness modules (R3 Cluster M #84 pilot — tests-as-data layout). The
// integration receipt is `t_pb_b_1_dag_runner_test::r1c_d_pb_census_gates_suite_evaluates_through_runner`.

module v3.compiler.tests.r1c_d.pb_census_gates

import std.verification {
  CensusBoundCheck,
  CensusSubsetCount,
  FixedPointConverges,
  GeneratedFromDag,
  PendingFact,
  RatchetZero,
  TestClaim,
  TestSuite,
  compiler_std_positive_set_ratchet,
  expected_hand_authored_non_test,
  expected_hand_authored_test,
  lens_producer_files_subset_predicate
}

// Census-authority handle. The Rust runner's `resolve_census_authority_ref`
// only requires a `DeclarationRef` edge (it does not pin a name or type);
// the marker exists so fixtures point at a typed identity that names the
// underlying authority (`src/v3/compiler/tests/integration/self_gen_census_test.rs`)
// rather than smuggling the path through fixture text.
type Sg0CensusAuthority {}

data self_gen_census_test_authority: Sg0CensusAuthority = {}

// Stub source string repeated inline on each `TestClaim` below. The PB
// census `eval_*_shape` family does not consume `claim.source` —
// evaluation reads live census state via `self_gen_census_list_*` helpers in
// `test_runner.rs`. The string is repeated rather than referenced through
// a shared `data` because `TestClaimValue::from_declaration` reads `source`
// as a `FieldValue::Literal(String)`; a `Reference(_)` edge falls back to
// the declaration name and breaks the structural `name` contract used by
// the runner test's claim-order assertion.
data pb_hand_rust_at_shim_floor_gate: TestClaim = {
  name: "pb_hand_rust_at_shim_floor",
  source: "// PB census predicates read external census state, not this source.\nlet _: Int = 0\n",
  file_name: "r1_pb_hand_rust_at_shim_floor.v3",
  predicate: CensusBoundCheck {
    authority: self_gen_census_test_authority,
    list_constant: expected_hand_authored_non_test,
    bound: 0
  },
  requires: []
}

data lens_producer_files_remaining_gate: TestClaim = {
  name: "lens_producer_files_remaining",
  source: "// PB census predicates read external census state, not this source.\nlet _: Int = 0\n",
  file_name: "r1_lens_producer_files_remaining.v3",
  predicate: CensusSubsetCount {
    authority: self_gen_census_test_authority,
    list_constant: expected_hand_authored_non_test,
    subset_predicate: lens_producer_files_subset_predicate
  },
  requires: []
}

data pb_self_compile_fixed_point_gate: TestClaim = {
  name: "pb_self_compile_fixed_point",
  source: "// PB census predicates read external census state, not this source.\nlet _: Int = 0\n",
  file_name: "r1_pb_self_compile_fixed_point.v3",
  predicate: FixedPointConverges {
    compile_target: "default_fixed_point_source",
    expected: "pipeline_stage_snapshots"
  },
  requires: []
}

data pb_compiler_std_ratchet_zero_gate: TestClaim = {
  name: "pb_compiler_std_ratchet_zero",
  source: "// PB census predicates read external census state, not this source.\nlet _: Int = 0\n",
  file_name: "r1_pb_compiler_std_ratchet_zero.v3",
  predicate: RatchetZero {
    authority: self_gen_census_test_authority,
    ratchet_kind: compiler_std_positive_set_ratchet
  },
  requires: []
}

// `manifest_entries` enumerates every path in the Self-Generation-0 generated-file manifest
// (`src/v3/compiler/src/lib.rs::generated_files`, emitted from
// `build.rs::REGEN_OUTPUTS`). **Keep this list in lockstep with that literal**
// (same paths, same order as `build.rs`) so `GeneratedFromDag` set-equality
// against `GENERATED_FILES` stays single-authority (INVARIANTS P2 / MODELING
// Practice 5). The runner requires set equality (no dupes / omissions). The
// gate's load-bearing T-PB-B check remains that the `EXPECTED_HAND_AUTHORED_TEST`
// census is empty (Gate #84 negative authority).
//
// R3 Cluster M substrate-shape (msg_3b99a90f): entries are typed sum-variants —
// `PendingFact { output_path }` IS the P3/C-9 honest "unknown" carrier; the
// follow-up runtime PR materialises `ResolvedFact` as hash-derivation lands.
data pb_test_file_generated_from_dag_gate: TestClaim = {
  name: "pb_test_file_generated_from_dag",
  source: "// PB census predicates read external census state, not this source.\nlet _: Int = 0\n",
  file_name: "r1_pb_test_file_generated_from_dag.v3",
  predicate: GeneratedFromDag {
    authority: self_gen_census_test_authority,
    manifest_entries: [
      PendingFact { output_path: "src/v3/compiler/src/bootstrap_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/bootstrap_generated_without_parse_surface.rs" },
      PendingFact { output_path: "src/v3/compiler/src/bootstrap_std_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/complexity_lattice_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/complexity_lens_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/cost_basis_declaration_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/dag_branch_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/dag_cluster_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/dag_cost_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/dag_lookup_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/dag_scalar_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/dag_value_body_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/diagnostics_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/emit/collection_ops_method_contract_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/emit_rust_bin_shim_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/enforced_lens_application_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/infer_helpers_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/int_literal_ranges_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/cost_symbolic_lens_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/lens_cost_target_realization_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/lens_effect_enumeration_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/lens_idempotency_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/lens_parallelism_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/lens_provenance_generated.rs" },
      PendingFact { output_path: "src/v3/compiler/src/lens_structural_resolution_generated.rs" },
