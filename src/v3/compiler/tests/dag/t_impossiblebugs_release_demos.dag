// T-ImpossibleBugs release demos: executable receipts for the three release
// classes in THESIS.md. These are real claim programs: the runner compiles
// `TestClaim.source`, then the named lens projection reads the resulting
// program DAG. The transport drift row is intentionally a compiler diagnostic
// receipt because the bug is closed at the typed boundary before a runtime
// transport can exist.

module v3.compiler.tests.t_impossiblebugs.release_demos

import std.substrate { Dag }
import std.verification {
  FailsWithDiagnostic,
  LensOutputEquals,
  ProgramInput,
  TestClaim,
  TestSuite
}

fn impossible_bug_complexity_over_bound_detected(d: Dag) -> Int = 0
fn impossible_bug_idempotency_loop_rejected(d: Dag) -> Int = 0

data impossible_bug_demo_program_input: ProgramInput = {}
data impossible_bug_demo_expected_true: Int = 1

data complexity_over_bound_lens_demo: TestClaim = {
  name: "impossible_bug_release_demo.complexity_over_bound_lens"
  source: "import std.list { List, cons, empty, fold }\n\nfn pair_score(xs: List<Int>) -> Int = fold(xs, 0, |outer, x| outer + fold(xs, 0, |inner, y| inner + x + y))\nlet complexity_demo_out: Int = pair_score(cons(1, cons(2, empty())))\n"
  file_name: "impossible_bug_complexity_over_bound_lens.v3"
  predicate: LensOutputEquals(
    impossible_bug_complexity_over_bound_detected,
    impossible_bug_demo_program_input,
    impossible_bug_demo_expected_true
  ),
  requires: []
}

data idempotency_loop_lens_demo: TestClaim = {
  name: "impossible_bug_release_demo.idempotency_loop_lens"
  source: "// gunbc::r3_free_consequences::lane2_loop_witness: upsert_dependent\nimport std.list { List, cons, empty, fold }\n\nlet idempotency_demo_xs: List<Int> = cons(1, cons(2, empty()))\nlet _: Int = fold(idempotency_demo_xs, 0, |acc, x| acc + x)\n"
  file_name: "impossible_bug_idempotency_loop_lens.v3"
  predicate: LensOutputEquals(
    impossible_bug_idempotency_loop_rejected,
    impossible_bug_demo_program_input,
    impossible_bug_demo_expected_true
  ),
  requires: []
}

data transport_drift_boundary_demo: TestClaim = {
  name: "impossible_bug_release_demo.transport_type_drift"
  source: "let server_field: String = 1\n"
  file_name: "impossible_bug_transport_type_drift.v3"
  predicate: FailsWithDiagnostic({
    kind: TypeMismatch,
    detail_contains: AnyDetail
  }),
  requires: []
}

data suite_impossible_bug_release_demos: TestSuite = {
  name: "t-impossiblebugs/release-demos"
  claims: [
    Enumerated(complexity_over_bound_lens_demo),
    Enumerated(idempotency_loop_lens_demo),
    Enumerated(transport_drift_boundary_demo)
  ]
}
