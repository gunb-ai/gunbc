// R3 gate #87 — `LensRegistryEntry` `idempotency`.
// The claim uses a narrow Int projection while `WorkflowIdempotencyReport` literals remain
// awkward to author as stable `.dag` data. The runner applies the generated/native idempotency
// authority and checks that a non-workflow program fails closed as unsupported.

module v3.compiler.tests.t_r3.gate_87_cementing_regen_idempotency

import std.substrate { Dag }
import std.verification { LensOutputEquals, ProgramInput, TestClaim, TestSuite }

fn gate87_idempotency_missing_workflow_is_unsupported(d: Dag) -> Int = 0

data gate87_program_input: ProgramInput = {}

data gate87_expected_true: Int = 1

data cementing_regen_idempotency_claim: TestClaim = {
  name: "cementing_regen_idempotency",
  source: "let lit: Int = 7",
  file_name: "r3_gate_87_idempotency_smoke.v3",
  predicate: LensOutputEquals(
    gate87_idempotency_missing_workflow_is_unsupported,
    gate87_program_input,
    gate87_expected_true
  ),
  requires: []
}

data r3_gate_87_cementing_regen_idempotency_suite: TestSuite = {
  name: "r3-gate-87/cementing/regen/idempotency",
  claims: [Enumerated(cementing_regen_idempotency_claim)]
}
