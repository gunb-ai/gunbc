// T-ImpossibleBugs nested-optional flatten class-close gate.
//
// The claim program typechecks only if the surface `Int??` parameter lowers to
// the same cardinality shape as `Int?`; without the constructor invariant, the
// return annotation would require `Int?` while the body carries `Int??`.

module v3.compiler.tests.t_impossiblebugs.nested_optional_flatten

import std.verification { TestClaim, TestSuite, TestPredicate }

data nested_optional_flatten_compile_error: TestClaim = {
  name: "nested_optional_flatten_compile_error",
  source: "fn flatten_probe(x: Int??) -> Int? = x\n",
  file_name: "nested_optional_flatten_compile_error.v3",
  predicate: Compiles,
  requires: []
}

data suite_nested_optional_flatten_class_close: TestSuite = {
  name: "t-impossiblebugs/nested-optional-flatten/class-close",
  claims: [nested_optional_flatten_compile_error]
}
