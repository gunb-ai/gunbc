// R3 gate #87 — `LensRegistryEntry` `cost_symbolic` (`cost.dag`) cementing in `.dag` form.
// `SymbolicCostExprEquals` applies the emitted symbolic-cost lens to `TestClaim.source`
// and compares against a frozen `SymbolicCost` witness (same pattern as
// `symbolic_cost_expr_equals_smoke` in `m1_5_verification_test.rs`).

module v3.compiler.tests.t_r3.gate_87_cementing_regen_cost_symbolic

import std.algebra { SymbolicCost }
import std.verification {
  BindParamRef,
  BindParamSizeVariable,
  SymbolicCostBindParamExpected,
  SymbolicCostExprEquals,
  SymbolicCostExprEqualsForBindParam,
  TestClaim,
  TestSuite
}

data gate87_symbolic_cost_expected: SymbolicCost = ConstantCost(0)

data gate87_symbolic_cost_countdown_expected: SymbolicCostBindParamExpected =
  LinearCostForBindParam { var: SelectedBindParamSizeVariable }

data cementing_regen_cost_symbolic_literal_claim: TestClaim = {
  name: "cementing_regen_cost_symbolic",
  source: "let lit: Int = 7",
  file_name: "r3_gate_87_symbolic_lit.v3",
  predicate: SymbolicCostExprEquals(gate87_symbolic_cost_expected),
  requires: []
}

data cementing_regen_cost_symbolic_countdown_claim: TestClaim = {
  name: "cementing_regen_cost_symbolic_countdown",
  source: "fn countdown(n: Int) -> Int =\n  if n == 0 then 0 else countdown(n - 1)",
  file_name: "r3_gate_87_symbolic_countdown.v3",
  predicate: SymbolicCostExprEqualsForBindParam(gate87_symbolic_cost_countdown_expected, { index: 0 }),
  requires: []
}

data r3_gate_87_cementing_regen_cost_symbolic_suite: TestSuite = {
  name: "r3-gate-87/cementing/regen/cost_symbolic",
  claims: [
    Enumerated(cementing_regen_cost_symbolic_literal_claim),
    Enumerated(cementing_regen_cost_symbolic_countdown_claim)
  ]
}
