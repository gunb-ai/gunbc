// R1C-E — T-Emit `.dag` `TestClaim` wrappers (ExecuteCommand logical child:
// the `r1c_e_emit_gates` `bin`). The `__R1C_E_BIN__` placeholder is replaced
// with `env!("CARGO_BIN_EXE_r1c_e_emit_gates")` at integration-test compile
// time (see `tests/integration/r1c_e_emit_gates_dag_test.rs`); no checked-in
// absolute path goes stale (manager guidance, R1 Closure decision on #973 —
// same discipline as `build.rs` splice for `r1_gates.template.dag`).
//
// Each claim's `name` matches the corresponding ROADMAP T-Emit gate row so
// the lane-acceptance receipt and the `.dag` claim share one identity.
// `source` / `file_name` are the trivial smoke-program the runner requires to
// compile cleanly before evaluating `ExecuteCommand` (see `eval_execute_command`
// in `test_runner.rs`); the bin is the real gate.

module v3.compiler.tests.r1c_e_emit_gates

import std.verification { TestClaim, TestSuite }

// `emit_generic_bounds_survive` — pins the Rust type line for callable params
// (`impl Fn(...) -> ... + Clone`, not `&impl Fn`). Body in
// `r1c_e_gates::check_generic_bounds_survive`; same body as the host
// `m1_3_emit_rust_test::emit_generic_bounds_survive` `#[test]`.
data emit_generic_bounds_survive_claim: TestClaim = {
  name: "emit_generic_bounds_survive",
  source: "let marker: Int = 1",
  file_name: "r1c_e_emit_gates_smoke.v3",
  predicate: ExecuteCommand("__R1C_E_BIN__", ["generic-bounds"], 0),
  requires: []
}

data r1c_e_emit_gates_suite: TestSuite = {
  name: "r1c_e_emit_gates_suite",
  claims: [emit_generic_bounds_survive_claim]
}
