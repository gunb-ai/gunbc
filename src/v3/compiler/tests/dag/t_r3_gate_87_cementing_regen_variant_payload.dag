// R3 gate #87 — `LensRegistryEntry` `variant_payload` Band-C cementing receipt.
// `LensOutputEquals` compares the emitted `variant_payload_shape` oracle against a frozen
// `VariantPayloadShapeLookup` sum literal (declaration-missing path: invalid `DeclarationId`).
// Runner dispatch: `test_runner::eval_gate_87_cementing_projection` key
// `gate87_variant_payload_shape_on_missing_declaration_id` (native oracle + structural
// `FieldValue` equality; the harness `fn` is a typed marker only).

module v3.compiler.tests.t_r3.gate_87_cementing_regen_variant_payload

import std.substrate { Dag }
import std.verification { LensOutputEquals, ProgramInput, TestClaim, TestSuite }
import lenses.variant_payload { VariantPayloadShapeLookup }

fn gate87_variant_payload_shape_on_missing_declaration_id(_d: Dag) -> VariantPayloadShapeLookup =
  DeclarationMissing

data gate87_program_input: ProgramInput = {}

data gate87_variant_payload_expected_missing: VariantPayloadShapeLookup = DeclarationMissing

data cementing_regen_variant_payload_claim: TestClaim = {
  name: "cementing_regen_variant_payload",
  source: "let lit: Int = 7",
  file_name: "r3_gate_87_variant_payload_smoke.v3",
  predicate: LensOutputEquals(
    gate87_variant_payload_shape_on_missing_declaration_id,
    gate87_program_input,
    gate87_variant_payload_expected_missing
  ),
  requires: []
}

data r3_gate_87_cementing_regen_variant_payload_suite: TestSuite = {
  name: "r3-gate-87/cementing/regen/variant_payload",
  claims: [Enumerated(cementing_regen_variant_payload_claim)]
}
