// R3 gate #87 — `LensRegistryEntry` `variant_payload`.
// `VariantPayloadShapeLookup` literals are not yet authorable as `.dag` data (M1(2.8)); this
// harness freezes the empty-product branch via a narrow Int projection over
// `variant_payload_shape` on `Gate87EmptyPayload` in the claim program (see
// `src/v3/lenses/variant_payload.dag`).
//
// Dissolution trigger: when `VariantPayloadShapeLookup` expected values are structurally
// authorable in `.dag` test data, replace this Int projection with
// `LensOutputEquals(variant_payload_shape, …)` comparing the full carrier and delete the
// `eval_gate_87_cementing_projection` arm `gate87_variant_payload_empty_product_found`.

module v3.compiler.tests.t_r3.gate_87_cementing_regen_variant_payload

import std.substrate { Dag }
import std.verification { LensOutputEquals, ProgramInput, TestClaim, TestSuite }

fn gate87_variant_payload_empty_product_found(d: Dag) -> Int = 0

data gate87_program_input: ProgramInput = {}

data gate87_expected_true: Int = 1

data cementing_regen_variant_payload_claim: TestClaim = {
  name: "cementing_regen_variant_payload",
  source: "type Gate87EmptyPayload { }\n\nlet lit: Int = 7",
  file_name: "r3_gate_87_variant_payload_smoke.v3",
  predicate: LensOutputEquals(
    gate87_variant_payload_empty_product_found,
    gate87_program_input,
    gate87_expected_true
