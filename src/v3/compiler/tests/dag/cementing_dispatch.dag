data claim_cementing_dispatch_projection: TestClaim = {
  name: "cementing_dispatch_projection_matches_register_and_regen"
  source: "// Band-C cementing dispatch reads capability_register + bootstrap LensRegistryEntry; not this program.\nlet _: Int = 0\n"
  file_name: "cementing_dispatch_projection_gate.v3"
  predicate: CementingDispatchMatchesProjection {
    capability_register: lens_capability_register_rows
    cementing_receipts: cementing_band_c_v2_complete_receipts
  }
  requires: []
}

data cementing_dispatch_suite: TestSuite = {
  name: "cementing_dispatch_suite"
  claims: [Enumerated(claim_cementing_dispatch_projection)]
}
