// Band-C cementing dispatch — `.dag` successor to the retired
// `cementing_lens_registry_dispatch_test.rs` ratchet (R3 T-Tests-As-Data-Completeness
// gate #87 / `lens_cementing_test_discipline_complete`).
//
// Single structural authority for lens capability rows (projection input) plus the
// Band-C receipt list. The runner predicate `CementingDispatchMatchesProjection`
// joins `lens_capability_register_rows` against bootstrap `LensRegistryEntry` rows
// from `regen.dag` and asserts receipt coverage + on-disk harness artifacts.
//
// Human-readable prose mirror: `docs/v3-lens-capability-register.md` (update both
// together when a lens row changes).

module v3.compiler.tests.cementing_dispatch

import std.list { List }
import std.verification {
  CementingDispatchMatchesProjection,
  TestClaim,
  TestSuite
}

// --- Capability projection (mirrors docs/v3-lens-capability-register.md §table) ---
// `structural` / `behavioral` / `v2_counterpart` are plain strings so the runner does not
// depend on anonymous sum-variant constructor ids in fixture-local lowering.

type LensCapabilityRegisterRow {
  lens_basename: String
  structural: String
  behavioral: String
  v2_counterpart: String
}

type CementingBandCReceipt {
  registry_name: String
  module_stem: String
  // `dag` = `.dag` TestClaim harness under `tests/dag/<module_stem>.dag`;
  // `temporary-rust` = `tests/integration/cementing/<module_stem>.rs` + `integration.rs` wiring.
  kind: String
}

