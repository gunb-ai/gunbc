// Band-C cementing dispatch — `.dag` successor to the retired
// `cementing_lens_registry_dispatch_test.rs` ratchet (R3 T-Tests-As-Data-Completeness
// gate #87 / `lens_cementing_test_discipline_complete`).
//
// Canonical lens capability rows live in `std.verification` as `lens_capability_register_rows`
// (`docs/design-tests-as-data-completeness.md` §8.3). This module declares only the
// Band-C receipt list plus the `TestClaim` / `TestSuite` that wire
// `CementingDispatchMatchesProjection` against that authority + `regen.dag`.
//
// Human-readable mirror: `docs/v3-lens-capability-register.md` (not a second authority).
// Band-C v2-complete rows: keep in lockstep with `BAND_C_V2_EXPANSIONS` in
// `src/v3/compiler/src/cementing_dispatch.rs` (dispatch projection triples + unit coherence test).

module v3.compiler.tests.cementing_dispatch

import std.list { List }
import std.verification {
  CementingDispatchMatchesProjection,
  TestClaim,
  TestSuite,
  lens_capability_register_rows
}

// Closed coproduct: receipt harness shape is a type error at fixture load, not a runtime string whitelist.
type CementingBandCReceiptKind
  = DagHarness
  | TemporaryRustModule

type CementingBandCReceipt {
  registry_name: String
  module_stem: String
  // `DagHarness` → `.dag` TestClaim harness under `tests/dag/<module_stem>.dag`;
  // `TemporaryRustModule` → `tests/integration/cementing/<module_stem>.rs` + `integration.rs` wiring.
  kind: CementingBandCReceiptKind
}

data cementing_band_c_v2_complete_receipts: List<CementingBandCReceipt> = [
  {
    registry_name: "cost"
    module_stem: "t_r3_gate_87_cementing_regen_cost"
    kind: DagHarness
  },
  {
    registry_name: "cost"
    module_stem: "complexity_lens_behavioral_completion"
    kind: TemporaryRustModule
  },
  {
    registry_name: "cost_symbolic"
    module_stem: "t_r3_gate_87_cementing_regen_cost_symbolic"
    kind: DagHarness
  },
  {
    registry_name: "cost_symbolic"
    module_stem: "cost_lens_symbolic_consumer_test"
    kind: TemporaryRustModule
  }
]

data claim_cementing_dispatch_projection: TestClaim = {
  name: "cementing_dispatch_projection_matches_register_and_regen"
  source: "// Band-C cementing dispatch reads capability_register + bootstrap LensRegistryEntry; not this program.\nlet _: Int = 0\n"
  file_name: "cementing_dispatch_projection_gate.v3"
  predicate: CementingDispatchMatchesProjection {
    capability_register: lens_capability_register_rows
    cementing_receipts: cementing_band_c_v2_complete_receipts
  }
  requires: []
}

data cementing_dispatch_suite: TestSuite = {
  name: "cementing_dispatch_suite"
  claims: [Enumerated(claim_cementing_dispatch_projection)]
}
