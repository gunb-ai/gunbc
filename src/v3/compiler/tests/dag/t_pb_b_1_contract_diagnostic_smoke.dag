// T-PB-B-1 — contract negative (`FailsWithDiagnostic`) as landed `.dag` data.

module v3.compiler.tests.t_pb_b_1.contract_diagnostic_smoke

import std.verification { TestClaim, TestSuite, TestPredicate }

data claim_bool_int_rejected: TestClaim = {
  name: "Bool annotation rejects Int literal",
  source: "let x: Bool = 1",
  file_name: "t1_4_type_mismatch.v3",
  predicate: FailsWithDiagnostic({ kind: TypeMismatch, detail_contains: AnyDetail }),
  requires: []
}

data suite_contract_diagnostic_negatives: TestSuite = {
  name: "t-pb-b-1/contract/diagnostic_negatives",
  claims: [claim_bool_int_rejected]
}
