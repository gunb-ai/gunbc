// R3 gate #87 — `LensRegistryEntry` `parallelism`.
// `WorkflowParallelismReport` literals are not yet authorable as stable `.dag` data, so this
// receipt freezes a narrow Int projection over the generated parallelism lens: a trivial program
// has no staged `WorkflowEffect`, and `analyze_parallelism` must report that absence fail-closed.

module v3.compiler.tests.t_r3.gate_87_cementing_regen_parallelism

import std.substrate { Dag }
import std.verification { LensOutputEquals, ProgramInput, TestClaim, TestSuite }

fn gate87_parallelism_no_workflow_projection(d: Dag) -> Int = 0

data gate87_program_input: ProgramInput = {}

data gate87_expected_true: Int = 1

data cementing_regen_parallelism_claim: TestClaim = {
  name: "cementing_regen_parallelism",
  source: "let lit: Int = 7",
  file_name: "r3_gate_87_parallelism_smoke.v3",
  predicate: LensOutputEquals(
    gate87_parallelism_no_workflow_projection,
    gate87_program_input,
    gate87_expected_true
  ),
  requires: []
}

data r3_gate_87_cementing_regen_parallelism_suite: TestSuite = {
  name: "r3-gate-87/cementing/regen/parallelism",
  claims: [Enumerated(cementing_regen_parallelism_claim)]
}
