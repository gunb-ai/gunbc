module v3.compiler.tests.r3_callgraph_forward_only_authority

import std.verification { TestClaim, TestSuite, TestPredicate }

data callgraph_derived_adjacency_views_coherent: TestClaim = {
  name: "callgraph_derived_adjacency_views_coherent",
  source: "let _: Int = 0\n",
  file_name: "callgraph_derived_adjacency_views_coherent.v3",
  predicate: ExecuteCommand("python3", ["-c", "from pathlib import Path\nimport subprocess, sys\nroot = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())\ntext = (root / 'dsl/std/graph.dag').read_text()\n\ndef block_after(marker):\n    start = text.find(marker)\n    if start < 0:\n        sys.exit(f'missing {marker}')\n    open_brace = text.find('{', start)\n    close = text.find('\\n}', open_brace)\n    return text[start:open_brace], text[open_brace + 1:close]\n\ndef record_fields(type_name):\n    _, body = block_after('type ' + type_name)\n    fields = {}\n    for raw in body.splitlines():\n        line = raw.strip()\n        if line and not line.startswith('//'):\n            name, ty = [part.strip() for part in line.split(':', 1)]\n            fields[name] = ty\n    return fields\n\ndef function(name):\n    return block_after('fn ' + name)\n\nassert record_fields('GraphEdge') == {'caller': 'String', 'callee': 'String'}\nassert record_fields('CallGraph') == {'edges': 'List<GraphEdge>'}\nassert record_fields('CallGraphAdjacencyViews') == {'forward': 'Map<String, List<String>>', 'reverse': 'Map<String, List<String>>'}\nfor name, ret in {'build_adjacency_views': 'CallGraphAdjacencyViews', 'forward_adjacency': 'Map<String, List<String>>', 'reverse_adjacency': 'Map<String, List<String>>'}.items():\n    sig, _ = function(name)\n    assert ('-> ' + ret) in sig, f'{name} must return {ret}'\n_, builder = function('build_call_graph_from_proof_edges')\nassert 'CallGraph' in builder and 'edges:' in builder\nassert 'GraphEdge' in builder\nassert 'forward:' not in builder and 'reverse:' not in builder\n_, views = function('build_adjacency_views')\nassert 'graph.edges' in views\nassert 'edge.caller' in views and 'edge.callee' in views\n_, scc = function('graph_has_multi_node_scc')\nassert 'graph.forward' not in scc and 'graph.reverse' not in scc\nassert 'build_adjacency_views' in scc\nassert 'adjacency.forward' in scc and 'adjacency.reverse' in scc\n"], 0),
  requires: []
}

data suite_r3_callgraph_forward_only_authority: TestSuite = {
  name: "r3/callgraph/forward-only-authority",
  claims: [callgraph_derived_adjacency_views_coherent]
}
