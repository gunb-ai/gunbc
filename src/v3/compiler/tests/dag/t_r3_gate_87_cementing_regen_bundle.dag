// R3 gate #87 — single-module bundle of every `t_r3_gate_87_cementing_regen_<lens>.dag` harness.
//
// **Why this exists:** the per-lens files remain the human-editable authority and inventory
// ratchet inputs (`R3_GATE_87_CEMENTING_REGEN_SUITES` paths). `t_pb_b_1_dag_runner_test` compiles
// *this* file once so CI pays one bootstrap instead of ten sequential `compile_to_dag` calls
// (per-test timeout ratchet — `scripts/slow-test-exemptions.txt` gate-#87 row).
//
// **Sync discipline:** when editing a per-lens harness, mirror the change here (claim order must
// match `R3_GATE_87_CEMENTING_BUNDLE_CLAIM_NAMES` in `t_pb_b_1_dag_runner_test.rs`).

module v3.compiler.tests.t_r3.gate_87_cementing_regen_bundle

import std.algebra { SymbolicCost }
import std.substrate { Dag, PortId }
import std.verification {
  Compiles,
  DifferentialEquals,
  ProgramOutputBind,
  SymbolicCostExprEquals,
  TestClaim,
  TestSuite
}
import v3.std.lookup { Lookup, miss_int_lookup }

// --- cost (merge-sort Lane-E harness; same as t_r3_gate_87_cementing_regen_cost.dag) ---
fn v3_program_cost(d: Dag, port_id: PortId) -> Lookup<Int> =
  miss_int_lookup()

fn v2_oracle_cost(d: Dag, port_id: PortId) -> Lookup<Int> =
  miss_int_lookup()

data merge_sort_out: Int = 0

data gate87_merge_sort_program_input: ProgramOutputBind = {
  output_ref: merge_sort_out
}

data gate87_merge_sort_v3_matches_v2_oracle: TestClaim = {
  name: "cementing_regen_cost",
  source: "import std.list { List, cons, singleton, empty }\n\nlet xs: List<Int> = cons(2, singleton(1))\n\nfn merge_sort_pair(xs: List<Int>) -> List<Int> =\n  match xs {\n    Empty => empty()\n    Cons(p0) =>\n      match p0.tail {\n        Empty => xs\n        Cons(p1) =>\n          match p1.tail {\n            Empty =>\n              if p0.head < p1.head\n              then cons(p0.head, singleton(p1.head))\n              else cons(p1.head, singleton(p0.head))\n            Cons(_) => xs\n          }\n      }\n  }\n\nlet merge_sort_out: List<Int> = merge_sort_pair(xs)\n",
  file_name: "r3_gate_87_merge_sort_pair.v3",
  predicate: DifferentialEquals(
    v3_program_cost,
    v2_oracle_cost,
    gate87_merge_sort_program_input
  ),
  requires: []
}

// --- cost_symbolic (t_r3_gate_87_cementing_regen_cost_symbolic.dag) ---
data gate87_symbolic_cost_expected: SymbolicCost = ConstantCost(0)

data cementing_regen_cost_symbolic_claim: TestClaim = {
  name: "cementing_regen_cost_symbolic",
  source: "let lit: Int = 7",
  file_name: "r3_gate_87_symbolic_lit.v3",
  predicate: SymbolicCostExprEquals(gate87_symbolic_cost_expected),
  requires: []
}

