// std.r3_verification_l4_emit_eval_mixed_lineage — negative control for W1 `DifferentialEquals`
// dispatch: pairs `rust_emit_output` with a non-W1 oracle so `eval_differential_equals` returns
// `NotYetImplemented` with an explicit unsupported-producer-pair receipt (producer-identity /
// observation gates per #1485; coordinate with #1495 ratchet when it lands — do not weaken to Pass).

module std.r3_verification_l4_emit_eval_mixed_lineage

import std.substrate { Dag, PortId }
import std.types { Int }
import std.verification {
  DifferentialEquals,
  ProgramOutputBind,
  TestClaim,
  TestSuite
}
import v3.std.lookup { Lookup, miss_int_lookup }

fn rust_emit_output(d: Dag, port_id: PortId) -> Lookup<Int> =
  miss_int_lookup()

fn v3_program_cost(d: Dag, port_id: PortId) -> Lookup<Int> =
  miss_int_lookup()

data mixed_out: Int = 0

data mixed_program_input: ProgramOutputBind = {
  output_ref: mixed_out
}

data r3_verification_l4_emit_eval_mixed_lineage_claim: TestClaim = {
  name: "r3_verification_l4_emit_eval_mixed_lineage_claim",
  source: "let mixed_out: Int = 1\n",
  file_name: "r3_verification_l4_emit_eval_mixed_lineage.v3",
  predicate: DifferentialEquals(
    rust_emit_output,
    v3_program_cost,
    mixed_program_input
  ),
  requires: []
}

data r3_verification_l4_emit_eval_mixed_lineage_suite: TestSuite = {
  name: "r3_verification_l4_emit_eval_mixed_lineage_suite",
  claims: [r3_verification_l4_emit_eval_mixed_lineage_claim]
}
