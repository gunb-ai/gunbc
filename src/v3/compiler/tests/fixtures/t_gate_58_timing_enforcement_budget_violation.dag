// Gate #58 executable receipt: `timing_enforceable` + `EnforcedApplication` host enforcement.
//
// `gate_58_timing_enforcement_section` is substrate-authoritative in
// `t_ci_workflow_as_data_demo.dag`; this fixture pairs an over-budget `TimingMeasurement`
// with a 1-ns ceiling so `check_enforced_lens_applications` must emit a lens-enforcement
// diagnostic (same fail-closed path as gate #92's LAS demo, but on timing).
module user.t_gate_58_timing_enforcement_budget_violation

import v3.std.lens_application { DeclarationScope, EnforcedApplication }
import v3.std.timing_lens {
  TimingBudget,
  TimingEnforcementProjected,
  TimingMeasurement,
  timing_enforceable
}
import v3.std.t_ci_workflow_as_data_demo { gate_58_timing_enforcement_section }

data gate_58_section_over_budget: gate_58_timing_enforcement_section = {
  measurement: Observed { duration: { count: 999 } }
}

data gate_58_enforcement_budget_violation: EnforcedApplication<TimingMeasurement, TimingBudget, TimingEnforcementProjected> = {
  enforceable_lens: timing_enforceable
  section: DeclarationScope { declaration: gate_58_section_over_budget }
  budget: { max: { count: 1 } }
  diagnostic_severity: Error
  span: { file: "t_gate_58_timing_enforcement_budget_violation.dag", start: 0, end: 1 }
}
