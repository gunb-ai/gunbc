// std.rust_dag_isomorphism_consumer - structural equality consumer.
//
// RustDagIsomorphism is a consumer instance, not a new predicate family:
// compare the Rust enum extraction shape report and the .dag reflection shape
// report through BinaryDimensionReportEquals. The concrete DagShapeReport
// producer remains substrate-owned; these aliases pin the report-carrier shape
// this consumer expects.

module std.rust_dag_isomorphism_consumer

import std.dimensions { DimensionReport }
import std.substrate { Dag }
import std.verification { BinaryDimensionReportEquals, TestClaim, TestSuite }

type RustEnumExtractionDagShapeReport = DimensionReport<Dag>
type DagReflectionDagShapeReport = DimensionReport<Dag>

data rust_dag_isomorphism_shape_reports_equal: TestClaim = {
  name: "rust_dag_isomorphism_shape_reports_equal",
  source: "",
  file_name: "src/v3/lenses/dag_shape.dag",
  predicate: BinaryDimensionReportEquals(
    RustEnumExtractionDagShapeReport,
    DagReflectionDagShapeReport
  ),
  requires: []
}

data rust_dag_isomorphism_consumer_suite: TestSuite = {
  name: "rust_dag_isomorphism_consumer_suite",
  claims: [rust_dag_isomorphism_shape_reports_equal]
}
