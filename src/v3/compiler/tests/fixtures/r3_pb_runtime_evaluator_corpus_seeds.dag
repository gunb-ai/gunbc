// std.r3_pb_runtime_evaluator_corpus_seeds — PB-Runtime ↔ R2-Evaluator
// Row-4 corpus seeds (1)–(2), author-now/fire-later.
// See docs/briefs/r3-pb-runtime-equivalence-corpus-seed-audit.md.
//
// The producer declarations below are fixture-local DeclarationRef targets only.
// `TestRunner::eval_differential_equals` intentionally returns NotYetImplemented
// for the `(pb_runtime_evaluate, r2_evaluator_evaluate)` producer pair today, so
// these claims compile the corpus seed programs without asserting Row 4 green.

module std.r3_pb_runtime_evaluator_corpus_seeds

import std.substrate { Dag, PortId }
import std.types { Int }
import std.verification {
  DifferentialEquals,
  ProgramOutputBind,
  TestClaim,
  TestSuite
}
import v3.std.lookup { Lookup, miss_int_lookup }

fn pb_runtime_evaluate(d: Dag, port_id: PortId) -> Lookup<Int> =
  miss_int_lookup()

fn r2_evaluator_evaluate(d: Dag, port_id: PortId) -> Lookup<Int> =
  miss_int_lookup()

data pb_eval_seed_int_out: Int = 0

data pb_eval_seed_int_output: ProgramOutputBind = {
  output_ref: pb_eval_seed_int_out
}

data pb_eval_seed_list_fold_out: Int = 0

data pb_eval_seed_list_fold_output: ProgramOutputBind = {
  output_ref: pb_eval_seed_list_fold_out
}

data pb_eval_corpus_seed_int_arithmetic_deferred: TestClaim = {
  name: "pb_eval_corpus_seed_int_arithmetic_deferred",
  source: "// Program authority for `pb_eval_corpus_seed_int_arithmetic_deferred`.\nmodule user.pb_eval_seed_int_arithmetic\n\nlet pb_eval_seed_int_a: Int = 2 + 3\nlet pb_eval_seed_int_b: Int = pb_eval_seed_int_a * 4\nlet pb_eval_seed_int_out: Int = pb_eval_seed_int_b - 5\n",
  file_name: "seed_int_arithmetic.v3",
  predicate: DifferentialEquals(
    pb_runtime_evaluate,
    r2_evaluator_evaluate,
    pb_eval_seed_int_output
  ),
  requires: []
}

data pb_eval_corpus_seed_list_fold_deferred: TestClaim = {
  name: "pb_eval_corpus_seed_list_fold_deferred",
  source: "// Program authority for `pb_eval_corpus_seed_list_fold_deferred`.\nmodule user.pb_eval_seed_list_fold\n\nimport std.list { List, cons, empty, fold }\n\nlet pb_eval_seed_list_values: List<Int> = cons(1, cons(2, cons(3, empty())))\nlet pb_eval_seed_list_fold_out: Int =\n  fold(pb_eval_seed_list_values, 0, |acc, x| acc + x)\n",
  file_name: "seed_list_fold.v3",
  predicate: DifferentialEquals(
    pb_runtime_evaluate,
    r2_evaluator_evaluate,
    pb_eval_seed_list_fold_output
  ),
  requires: []
}

data r3_pb_runtime_evaluator_corpus_seed_suite: TestSuite = {
  name: "r3_pb_runtime_evaluator_corpus_seed_suite",
  claims: [
    pb_eval_corpus_seed_int_arithmetic_deferred,
    pb_eval_corpus_seed_list_fold_deferred
  ]
}
