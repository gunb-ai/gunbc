// std.r1_release_acceptance - R1 release-acceptance fixture.
//
// Director disposition for R1C-D closes R1 with one strict PB gate green
// (`pb_self_compile_fixed_point`) and five PB census gates structurally
// deferred to release-cycle authority. The deferral claims
// use `ReleaseDeferredClaim` only because the Director explicitly approved this
// release-acceptance fixture shape; do not copy it into arbitrary suites.

module std.r1_release_acceptance

import std.verification {
  FixedPointConverges,
  ReleaseDeferredClaim,
  TestClaim,
  TestSuite
}

type Sg0CensusAuthority {}
data self_gen_census_test_authority: Sg0CensusAuthority = {}

