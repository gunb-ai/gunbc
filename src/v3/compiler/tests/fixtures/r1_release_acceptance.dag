data pure_bootstrap_zero_authority: ReleaseAuthorityDoc = {}
data r2_substrate_manager_authority: ReleaseAuthorityDoc = {}

data pb_hand_rust_at_shim_floor_deferred: TestClaim = {
  name: "pb_hand_rust_at_shim_floor",
