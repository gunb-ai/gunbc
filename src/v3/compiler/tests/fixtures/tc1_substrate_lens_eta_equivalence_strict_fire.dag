//
// Authority chain (Director ratifications, current as of 2026-05-07):
//   - Q-PAFS Path A ACCEPTED 2026-05-06 (PR #1824 merge record on `main`).
//   - Q-Reification Option A ratified 2026-05-07 (PR #2096): `Dag` IS the reflected program.
//   - Substrate Mgr Gate A patches MERGED 2026-05-07 (PR #2079, commit 0e8724bc).
//   - V1 dispatch unblocked by Verification Mgr (wise-bear-525, #2075) per Director cascade
//     UNHOLD signal at gunbc#828 #issuecomment-4394467134.
//
// Differences vs `tc1_substrate_lens_eta_equivalence_deferred.dag`:
//   - Canonical TestClaim name `tc1_eta_equivalence_executable` per `r3-program-plan.md` §1.8 #11
//     (deferred fixture's claim name is the R2 research-receipt form, not the §1.8 gate name).
//   - Adds the η-pair callables `eta_subject_f` / `eta_subject_f_eta` at source level — η-equivalent
//     pair `f` and `lambda x. apply(f, [x])` per TC1 statement (`r3-v-tc1-eta-equivalence-deeper-
//     analysis.md` §"What TC1 Asserts"). Both compute the same `Int` value structurally.
//   - Predicate stays `BinaryDimensionReportEquals` (Pattern-A consumer envelope; unified
//     surface ratified at gunbc#828).
//
// Runner: §1.8 gate #11 executes via `TestRunner::try_eval_tc1_eta_equivalence_executable`:
// `analyze_symbolic_cost_dimension` at η-pair entry binds in `TestClaim.source`. Typed refs remain
// `DimensionReport<Tc1EtaLensObservation>` (Pattern-A envelope); Pass uses a **proxy**
// `DimensionReport<SymbolicCost>` comparison until gunbc#1972 lands the real
// `Tc1EtaLensObservation` fold — single forward dissolution trigger (INVARIANTS P5-style receipt).
//
// Path A intent for this representative: both entries reduce to the same Int computation (`0+1`);
// η-expansion adds an indirect call but the symbolic-cost lens attributes the **same** root
// `composed` asymptotic bound for these workflows today — so equality of root `composed`
// `SymbolicCost` matches Director-approved Path A static-rep receipt without claiming full TC1
// lens-fold η-invariance yet. A future analyzer that weights call depth could flip this gate until
// #1972 migrates the assertion to carrier-native reports.
//
// Hard bars (E6-G1.a Option 3 caveat #1853): no `lens_apply` / `eval_substrate_reify` /
// `reflect_behavior` imports. Carrier shape is the ratified Q-Reification Option A `Dag`-as-
// carrier (Verification consumes; does not introduce).

module std.tc1_substrate_lens_eta_equivalence_strict_fire

import std.dimensions { DimensionReport }
import std.verification {
  BinaryDimensionReportEquals,
  TestClaim,
  TestSuite
}

// Carrier for the TC1 eta-equivalence observation. Stays opaque at this slice — the carrier
// identity is what BinaryDimensionReportEquals normalizes on (left/right must agree).
type Tc1EtaLensObservation {}

// η-pair callables — both compute the same `Int` value. `eta_subject_f_eta` is the η-expanded
// form `lambda x. apply(eta_subject_f, [x])`; the lens-fold-over-`Dag` of either should yield
// equal `DimensionReport<Tc1EtaLensObservation>` values once the Evaluator substrate-fact
// projection path lands. These declarations make the η-pair source-visible (Mgr/
// reviewer can read non-vacuity intent off the .dag) even though runtime fold isn't wired
// at this slice.
fn eta_subject_f(x: Int) -> Int = x + 1
fn eta_subject_f_eta(x: Int) -> Int = eta_subject_f(x)

// Typed report refs — the unified `BinaryDimensionReportEquals` consumer envelope reads
// these as `DeclarationRef`s and validates carrier-equivalence today. Fold-output wiring
// is Evaluator-side; #1970 closed superseded-by-deferral, with the remaining path tracked at #1972.
type tc1_subject_f_report = DimensionReport<Tc1EtaLensObservation>
type tc1_subject_eta_expanded_report = DimensionReport<Tc1EtaLensObservation>

// §1.8 gate #11 canonical TestClaim name. Predicate uses the unified `BinaryDimensionReportEquals`
// shape; `TestClaim.source` wires η-pair entry binds — runner compares **root composed SymbolicCost**
// proxy equality (see header comment); full `Tc1EtaLensObservation` report parity is gunbc#1972.
data tc1_eta_equivalence_executable_claim: TestClaim = {
  name: "tc1_eta_equivalence_executable",
  source: "// TC1 V1 executable η-pair — binds wired for runner Path A (`tc1_eta_exec_*`).\nfn eta_subject_f(x: Int) -> Int = x + 1\nfn eta_subject_f_eta(x: Int) -> Int = eta_subject_f(x)\nfn tc1_eta_exec_direct() -> Int = eta_subject_f(0)\nfn tc1_eta_exec_eta_expanded() -> Int = eta_subject_f_eta(0)\n",
  file_name: "tc1_eta_equivalence_executable.v3",
  predicate: BinaryDimensionReportEquals(
    tc1_subject_f_report,
    tc1_subject_eta_expanded_report
  ),
  requires: []
}

data tc1_substrate_lens_eta_equivalence_strict_fire_suite: TestSuite = {
  name: "tc1_substrate_lens_eta_equivalence_strict_fire_suite",
  claims: [tc1_eta_equivalence_executable_claim]
}
