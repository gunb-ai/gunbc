// TC2 strict-fire - binary Transform + two argument sites (non-atomic subexpressions).
// Vacuity guard: LeftFirst vs RightFirst eager schedules traverse distinct operand-eval order.
module user.tc2_church_rosser_executable

fn sub_pos(a: Int, b: Int) -> Int = a - b

let _: Int = sub_pos(2 + 3, 1 + 1)
