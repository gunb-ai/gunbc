// R3 gate #8 - `self_gen_non_test_zero`.
//
// This fixture makes the combined T-PB-A non-test closure predicate executable:
// both the non-test Rust census and the hand-authored scaffold-fragment census
// must reach zero. The runner reads live Self-Generation-0 state from `self_gen0_census_test.rs`;
// the source programs below are inert placeholders.

module std.r3_self_gen_non_test_zero

import std.verification {
  CensusBoundCheck,
  TestClaim,
  TestSuite,
  expected_hand_authored_fragments,
  expected_hand_authored_non_test
}

type Sg0CensusAuthority {}

data self_gen0_census_test_authority: Sg0CensusAuthority = {}

data self_gen_non_test_zero_rust_gate: TestClaim = {
  name: "self_gen_non_test_zero_rust",
  source: "// Self-Generation-0 census predicates read external census state, not this source.\nlet _: Int = 0\n",
  file_name: "r3_self_gen_non_test_zero_rust.v3",
  predicate: CensusBoundCheck {
    authority: self_gen0_census_test_authority,
    list_constant: expected_hand_authored_non_test,
    bound: 0
  },
  requires: []
}

data self_gen_non_test_zero_fragments_gate: TestClaim = {
  name: "self_gen_non_test_zero_fragments",
  source: "// Self-Generation-0 census predicates read external census state, not this source.\nlet _: Int = 0\n",
  file_name: "r3_self_gen_non_test_zero_fragments.v3",
  predicate: CensusBoundCheck {
    authority: self_gen0_census_test_authority,
    list_constant: expected_hand_authored_fragments,
    bound: 0
  },
  requires: []
}

data r3_self_gen_non_test_zero_suite: TestSuite = {
  name: "r3_self_gen_non_test_zero_suite",
  claims: [
    Enumerated(self_gen_non_test_zero_rust_gate),
    Enumerated(self_gen_non_test_zero_fragments_gate)
  ]
}
