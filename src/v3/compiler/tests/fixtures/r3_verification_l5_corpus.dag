// std.r3_verification_l5_corpus — R3 L5 certification corpus: `ForAllTargets` over
// Rust / Python / Go Int stdout parity (`docs/r3-program-plan.md` §1.8 gate #15).

module std.r3_verification_l5_corpus

import std.verification { ForAllTargets, ProgramOutputBind, TestClaim, TestSuite }

type L5RustcToolchain {}
type L5Python3Toolchain {}
type L5GoToolchain {}

type l5_out {}
type l4_out {}
type l4_false_out {}
type l4_nested_out {}

data r3_l5_gate_program_output: ProgramOutputBind = {
  output_ref: l5_out
}

data r3_l5_branch_true_program_output: ProgramOutputBind = {
  output_ref: l4_out
}

data r3_l5_branch_false_program_output: ProgramOutputBind = {
  output_ref: l4_false_out
}

data r3_l5_nested_program_output: ProgramOutputBind = {
  output_ref: l4_nested_out
}

data l5_cross_target_consistency_add_then: TestClaim = {
  name: "l5_cross_target_consistency",
  source: "// R3 L5 certification corpus - add-then-branch seed (gate #15 `l5_cross_target_consistency` authority).\n// `TestClaim.source` in `r3_verification_l5_corpus.dag` must match this file exactly (integration test).\nmodule user.r3_l5_add_then_branch_seed\n\nfn add(a: Int, b: Int) -> Int = a + b\n\nlet seed_acc: Int = add(1, 2)\nlet l5_out: Int =\n  match seed_acc == 3 {\n    True => seed_acc\n    False => 0\n  }\n",
  file_name: "add_then_branch_seed.v3",
  predicate: ForAllTargets("true", [], 0, r3_l5_gate_program_output),
  requires: [
    { target: L5RustcToolchain },
    { target: L5Python3Toolchain },
    { target: L5GoToolchain }
  ]
}

data r3_l5_cert_branch_literal_true: TestClaim = {
  name: "r3_l5_cert_branch_literal_true",
  source: "// R3 L4 - branch-only claim program on the current eager PR-B spine (no Callable / fold lambdas) so `dag_eval_output` can use `evaluate_body` while Callable remains fail-closed.\n\nlet l4_pick: Bool = true\n\nlet l4_out: Int =\n  match l4_pick {\n    True => 3\n    False => 0\n  }\n",
  file_name: "branch_literal_true_seed.v3",
  predicate: ForAllTargets("true", [], 0, r3_l5_branch_true_program_output),
  requires: [
    { target: L5RustcToolchain },
    { target: L5Python3Toolchain },
    { target: L5GoToolchain }
  ]
}

data r3_l5_cert_branch_literal_false: TestClaim = {
  name: "r3_l5_cert_branch_literal_false",
  source: "// R3 L4 - second W1 Rust/Int receipt inside the #1499 surface: false Bool branch, signed Int output, one named output bind.\n\nlet l4_pick: Bool = false\n\nlet l4_false_out: Int =\n  match l4_pick {\n    True => 0\n    False => -4\n  }\n",
  file_name: "branch_literal_false_seed.v3",
  predicate: ForAllTargets("true", [], 0, r3_l5_branch_false_program_output),
  requires: [
    { target: L5RustcToolchain },
    { target: L5Python3Toolchain },
    { target: L5GoToolchain }
  ]
}

data r3_l5_cert_nested_branch: TestClaim = {
  name: "r3_l5_cert_nested_branch",
  source: "// R3 L4 - third W1 Rust/Int receipt inside the current Int-only ceiling: nested Bool branch, one named Int output bind.\n\nlet l4_outer_pick: Bool = true\nlet l4_inner_pick: Bool = false\n\nlet l4_nested_out: Int =\n  match l4_outer_pick {\n    True => match l4_inner_pick {\n      True => 5\n      False => 7\n    }\n    False => 0\n  }\n",
  file_name: "nested_branch_seed.v3",
  predicate: ForAllTargets("true", [], 0, r3_l5_nested_program_output),
  requires: [
    { target: L5RustcToolchain },
    { target: L5Python3Toolchain },
    { target: L5GoToolchain }
  ]
}

data l5_cross_target_consistency: TestSuite = {
  name: "l5_cross_target_consistency",
  claims: [
    Enumerated(l5_cross_target_consistency_add_then),
    Enumerated(r3_l5_cert_branch_literal_true),
    Enumerated(r3_l5_cert_branch_literal_false),
    Enumerated(r3_l5_cert_nested_branch),
  ]
}
