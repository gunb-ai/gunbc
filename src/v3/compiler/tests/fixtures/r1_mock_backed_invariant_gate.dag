// Minimal MockBackedInvariant gate fixture.
// Lives under tests/fixtures/ -- NOT src/v3/std/ -- not auto-staged into bootstrap.
//
// The runner evaluates `MockBackedInvariant` hermetically: compile `TestClaim.source`,
// `apply_lens_declaration` on the subject (0-arity), then on the invariant (1-arity) with
// the subject output. `requires: []` remains intentional until obligation materialization lands.

module std.r1_mock_backed_invariant_gate

import std.verification { TestClaim, TestSuite }

fn mock_service_status() -> Int = 200

fn mock_invariant_holds(code: Int) -> Bool = code == 200

data mock_backed_invariant_gate: TestClaim = {
  name: "testgen_mock_backed_integration_safe",
  source: "fn mock_service_status() -> Int = 200\n\nfn mock_invariant_holds(code: Int) -> Bool = code == 200\n\nlet _: Int = 0\n",
  file_name: "mock_backed_harness.v3",
  predicate: MockBackedInvariant(mock_service_status, mock_invariant_holds),
  requires: []
}

data mock_backed_invariant_suite: TestSuite = {
  name: "mock_backed_invariant_suite",
  claims: [mock_backed_invariant_gate]
}
