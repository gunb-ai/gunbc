// std.r3_verification_l7_algebraic_laws — R3 Lane 1/L7 algebraic-law fixtures.
//
// The skeleton suite uses `AlgebraicLaw(Identity, …)` over Int `+` as an ordinary bounded witness
// row (same discipline as `Associativity` / `Commutativity`). The matrix suite below pre-authors
// enum-backed per-(algebra, law) fixture rows for the current `AlgebraicLawKind` surface:
// `Associativity`, `Commutativity`, and `Identity`.
//
// Laws such as distributivity, absorption, inverse, complement, annihilation,
// and order laws are theory in `dsl/std/algebra.dag` but **not**
// `AlgebraicLawKind` variants. They are substrate-introduction candidates via
// INVARIANTS §P1, not fixture-local encodings.
//
// **Receipt limits:** `AlgebraicLaw` payload is only `AlgebraicLawKind` + `lens_ref` — there is no
// declared identity-element / operation-class substrate edge distinguishing add-zero vs mul-one vs
// lattice units vs free-monoid empty (codex review / PR #2394). Additive vs multiplicative identity
// is expressed **only** by wiring distinct binary `Int` lenses (`+` vs `*`). Passing-matrix rows
// below intentionally exclude obligations whose tags imply non-`Int` inhabitants or non-additive /
// non-multiplicative operations until faithful witnesses exist. This fixture does **not** claim
// ROADMAP / gate `l7_algebraic_laws_witnessed` exhaustive per-(algebra, inhabitant, law) closure.

module std.r3_verification_l7_algebraic_laws

import std.types { Int }
import std.verification { AlgebraicLaw, Associativity, Commutativity, Identity, TestClaim, TestSuite }

fn r3_l7_identity_placeholder_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_semigroup_associativity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_monoid_identity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_commutative_monoid_commutativity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_group_identity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_abelian_group_commutativity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_semiring_add_commutativity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_semiring_mul_identity_op(a: Int, b: Int) -> Int = a * b
fn r3_l7_ring_add_commutativity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_ring_mul_identity_op(a: Int, b: Int) -> Int = a * b
fn r3_l7_ordered_ring_add_commutativity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_ordered_ring_mul_identity_op(a: Int, b: Int) -> Int = a * b
fn r3_l7_lattice_meet_associativity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_lattice_join_commutativity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_bounded_lattice_meet_identity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_boolean_algebra_join_identity_op(a: Int, b: Int) -> Int = a + b
fn r3_l7_free_monoid_identity_op(a: Int, b: Int) -> Int = a + b

data r3_verification_l7_algebraic_laws_skeleton: TestClaim = {
  name: "r3_verification_l7_algebraic_laws_skeleton",
  source: "fn r3_l7_identity_placeholder_op(a: Int, b: Int) -> Int = a + b\n",
  file_name: "r3_verification_l7_algebraic_laws_skeleton.v3",
  predicate: AlgebraicLaw(Identity, r3_l7_identity_placeholder_op),
  requires: []
}

// Passing-matrix rows: binary `Int` lenses whose **operation matches the tagged additive vs
// multiplicative obligation** (`+` for additive monoid/group/semiring-add laws; `*` for mul
// `Identity`). Lattice meet/join **associativity/commutativity** tags are **not** green-lit here on
// `Int` `+` (that would read as lattice laws without meet/join carriers). Bounded-lattice /
// Boolean-algebra / free-monoid identity placeholders likewise stay **out** of the passing matrix.
data r3_l7_semigroup_associativity: TestClaim = {
  name: "r3_l7_semigroup_associativity",
  source: "fn r3_l7_semigroup_associativity_op(a: Int, b: Int) -> Int = a + b\n",
  file_name: "r3_l7_semigroup_associativity.v3",
  predicate: AlgebraicLaw(Associativity, r3_l7_semigroup_associativity_op),
  requires: []
}

