data r3_verification_l7_algebraic_laws_skeleton: TestClaim = {
  name: "r3_verification_l7_algebraic_laws_skeleton",
  source: "let _: Int = 1\n",
  file_name: "r3_verification_l7_algebraic_laws_skeleton.v3",
  predicate: AlgebraicLaw(Identity, r3_l7_identity_placeholder_op),
  requires: []
}

