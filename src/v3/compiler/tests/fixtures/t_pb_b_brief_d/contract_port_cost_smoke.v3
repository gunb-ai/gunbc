import std.list { empty }
import std.verification { TestClaim, TestSuite, TestPredicate }

let pred_answer_resolved: TestPredicate = PortHasState("answer", Resolved)
let pred_answer_cost_eq_3: TestPredicate = CostBounded("answer", Eq, 3)

let claim_answer_resolved: TestClaim = {
  name: "answer bind resolves",
  source: "let answer: Int = 1 + 1 + 1 + 1",
  file_name: "t_pb_b_port_answer.v3",
  predicate: pred_answer_resolved,
  requires: empty()
}

let claim_answer_cost_bounded: TestClaim = {
  name: "answer bind has bounded cost witness (Eq 3)",
  source: "let answer: Int = 1 + 1 + 1 + 1",
  file_name: "t_pb_b_cost_answer.v3",
  predicate: pred_answer_cost_eq_3,
  requires: empty()
}

let suite_contract_port_and_cost: TestSuite = {
  name: "t-pb-b/contract/port_and_cost",
  claims: [claim_answer_resolved, claim_answer_cost_bounded]
}
