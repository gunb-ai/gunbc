// std.r1_gates - Day-1 R1 gate declarations (integration-test fixture).
//
// **Authority:** Hand-edit `r1_gates.template.dag` only. Companion `r1_gates.dag` is
// **generated** on every `cargo build` of `v3-compiler`: `build.rs` splices
// `src/v3/lenses/named_function_count.dag` into `user_authored_lens_compiles_gate.source`
// (single-line placeholder token, see `build.rs` `emit_r1_gates_fixture`) so the on-disk lens
// is the single program-text authority (T-LensAPI D4 / ROADMAP scheduled cleanup item 3).
//
// **T-TestGen** (`testgen_manual_claim_is_first_class`, ROADMAP.md:51, [ext]): hand-authored
// `manual_negative_claim_gate` + `manual_claim_suite` live in this same module so one
// fixture file stays the R1 gate surface without growing `src/v3/std/*.dag` (bootstrap
// enumerates that tree — see PR #679 / review round 1).
//
// Lives under `src/v3/compiler/tests/fixtures/` so it is **not** auto-staged
// into `Dag::new()` bootstrap (`src/v3/std/*.dag` is build-script enumerated).
// `sub_match_over_user_sum_links_and_runs` also extracts this claim source for
// the rustc boundary receipt, so the named T-Sub gate has one program witness.
//
// merge-conflicts: union with `origin/main` — keep every `data` gate from main
// (`sub_match_*`, `manual_*`, `testgen_structural_coverage*`) plus this file's
// `user_authored_lens_compiles_gate`; do not resolve conflicts by keeping only the lens gate.

module std.r1_gates

import std.list { fold }
import std.substrate { Dag, Behavior }
import std.verification {
  AlgebraicLaw,
  Compiles,
  LensOutputEquals,
  TestClaim,
  TestSuite
}

data sub_match_over_user_sum: TestClaim = {
  name: "sub_match_over_user_sum",
  source: "type Choice = Number(Int) | Missing\n\nfn score(choice: Choice) -> Int =\n  match choice {\n    Number(value) => value\n    Missing => 0\n  }\n\nlet result: Bool = score(Number(7)) == 7 && score(Missing) == 0\n",
  file_name: "r1_sub_match_over_user_sum.v3",
  predicate: Compiles,
  requires: []
}

data sub_match_over_user_sum_gate: TestSuite = {
  name: "sub_match_over_user_sum_gate",
  claims: [sub_match_over_user_sum]
}

// Naming stub for `DeclarationRef` resolution on `AlgebraicLaw(Associativity, lens_composition_op)`.
// The runner resolves `lens_ref` by name from this fixture DAG, then looks up the same name in
// the compiled `program_dag` (`TestClaim.source`). The stub body is unused at evaluation time —
// only the **name** is asserted against `program_dag`; keep the **body** byte-identical to
// `src/v3/lenses/lens_composition_associative_witness.dag` anyway so the parallel copy cannot
// silently drift (merge hazard / reader confusion).
// Dissolution trigger: once the runner resolves lens refs directly from `program_dag` without a
// fixture-side stub, delete this declaration.
fn lens_composition_op(a: Int, b: Int) -> Int = a + b

// Fixture-local stubs (names + shapes for `DeclarationRef` in this merged DAG). Bodies mirror
// `src/v3/lenses/named_function_count.dag`; keep in sync when editing the lens file.
fn count_named_bind(behavior: Behavior) -> Int =
  match behavior {
    Value(v) => 0
    Transform(t) => 0
    Branch(b) => 0
    Loop(l) => 0
    Bind(bind) => if bind.name == "" then 0 else 1
  }

fn named_function_count(d: Dag) -> Int =
  fold(d.nodes, 0, |acc, behavior| acc + count_named_bind(behavior))

data user_authored_lens_compiles_gate: TestClaim = {
  name: "user_authored_lens_compiles",
  source: "R1_NAMED_FUNCTION_COUNT_LENS_SPLICE_V1",
  file_name: "src/v3/lenses/named_function_count.dag",
  predicate: Compiles,
  requires: []
}

// Fixture: return type says `String` but body is `Int` (`x`). The substrate surfaces
// this as `ResolveError` ("parameter … does not satisfy its declared signature"), not
// `TypeMismatch` — the gate matches the live diagnostic kind.
data manual_negative_claim_gate: TestClaim = {
  name: "testgen_manual_claim_is_first_class",
  source: "fn broken(x: Int) -> String = x",
  file_name: "manual_claim_fixture.v3",
  predicate: FailsWithDiagnostic({
    kind: ResolveError,
    detail_contains: AnyDetail
  }),
  requires: []
}

data manual_claim_suite: TestSuite = {
  name: "manual_claim_suite",
  claims: [manual_negative_claim_gate]
}

data lens_composition_associative_gate: TestClaim = {
  name: "lens_composition_associative",
  source: "// lenses.lens_composition_associative_witness - minimal `[ext]` gate witness for\n// `lens_composition_associative` (T-LensAPI / AlgebraicLaw::Associativity).\n//\n// The runner checks associativity by applying the lens twice under both\n// parenthesizations on fixed sample integers (see `lens_apply::int_associativity_holds`).\n//\n// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY N/A beyond the witness shape.\n// Not bundled into `Dag::new()` bootstrap; see `m1_5_user_authored_lens_gate_test`\n// lockstep pattern for `r1_gates.dag`.\n\nmodule lenses.lens_composition_associative_witness\n\nfn lens_composition_op(a: Int, b: Int) -> Int = a + b\n",
  file_name: "src/v3/lenses/lens_composition_associative_witness.dag",
  predicate: AlgebraicLaw(Associativity, lens_composition_op),
  requires: []
}

data lens_composition_associative_suite: TestSuite = {
  name: "lens_composition_associative_suite",
  claims: [lens_composition_associative_gate]
}

// R1 T-TestGen gate: the runner evaluates a structural fact about a compiled
// fixture DAG, not just "source compiles." This binds a named value through a
// small function call, then asserts the bind's value port resolved.
data testgen_structural_coverage_gate: TestClaim = {
  name: "testgen_structural_coverage",
  source: "fn double(x: Int) -> Int = x + x\nlet structural_result: Int = double(3)",
  file_name: "structural_coverage_fixture.v3",
  predicate: PortHasState("structural_result", Resolved),
  requires: []
}

data testgen_structural_coverage_suite: TestSuite = {
  name: "testgen_structural_coverage_suite",
  claims: [testgen_structural_coverage_gate]
}

// `LensOutputEquals` R1 gate: input `Dag` is reflected from `TestClaim.source` using the
// `r1_lens_output_input_from_program` sentinel (see `test_runner::eval_lens_output_equals`).
data r1_lens_output_input_from_program: Int = 0

data lens_output_equals_expected: Int = 1

data lens_output_equals_gate: TestClaim = {
  name: "lens_output_equals_gate",
  source: "let x: Int = 1\n",
  file_name: "r1_lens_output_program.v3",
  predicate: LensOutputEquals(
    named_function_count,
    r1_lens_output_input_from_program,
    lens_output_equals_expected
  ),
  requires: []
}

data r1_lens_output_equals_suite: TestSuite = {
  name: "r1_lens_output_equals_suite",
  claims: [lens_output_equals_gate]
}
