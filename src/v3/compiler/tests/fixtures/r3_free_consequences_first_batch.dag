// std.r3_free_consequences_first_batch — T-Free-Consequences first-batch
// author-now/fire-later consumers.
//
// Five gates from `r3-v-free-consequences-worker.md`:
// - auto-parallelism x3
// - auto-memoization x2
//
// The auto-parallelism gates use ordinary lens data, not `DimensionReport<C>`:
// DB-3 explicitly keeps parallelism outside the Dimension abstraction, and
// DB-20 models workflow parallelism through `WorkflowParallelismReport`.
// Schedule witness (gates #44–#45): evaluated in the test runner as
// `r3_auto_parallelism_schedule_witness` — `1` when two or more module `let` binds
// in the claim file are pairwise dataflow-independent and no bind RHS carries
// `Branch`/`Loop` control (branch arms serialize vs naive cross-bind parallelism).
// Gates `#44`–`#45` use `LensOutputEquals` + the test-runner Rust mirror; gate `#43`
// uses `r3_auto_parallelism_parallel_emit_witness` (parallel Rust schedule).
// Full `ParallelEffect` on `lane2_workflow` stays deferred until commutativity + cost lenses exist.

module std.r3_free_consequences_first_batch

import std.dimensions { DimensionReport }
import std.substrate { Dag }
import std.verification {
  BinaryDimensionReportEquals,
  LensOutputEquals,
  ProgramInput,
  TestClaim,
  TestSuite
}

type AutoMemoizationEvidence {}

data auto_parallelism_program_input: ProgramInput = {}

// M1(2.8) stub — `LensOutputEquals` evaluates via the test-runner Rust mirror
// `r3_auto_parallelism_schedule_witness` (see `workflow_parallelism.rs`).
fn auto_parallelism_schedule_witness(_d: Dag) -> Int = 0

data auto_parallelism_sequential_expected: Int = 0

// R3 #43 witness: runner matches emitted Rust for `std::thread::scope` (see test_runner).
fn r3_auto_parallelism_parallel_emit_witness(_d: Dag) -> Int = 0

data r3_auto_parallelism_parallel_emit_expected: Int = 1

type repeated_pure_call_observed_report = DimensionReport<AutoMemoizationEvidence>
type repeated_pure_call_expected_report = DimensionReport<AutoMemoizationEvidence>
type one_shot_call_observed_report = DimensionReport<AutoMemoizationEvidence>
type one_shot_call_expected_report = DimensionReport<AutoMemoizationEvidence>

data auto_parallelism_independent_binds_emit_parallel: TestClaim = {
  name: "auto_parallelism_independent_binds_emit_parallel",
  source: "// free-consequences fixture: pairwise-independent top-level binds emit a parallel Rust schedule.\nlet a: Int = 1 + 2\nlet b: Int = 3 + 4\n",
  file_name: "r3_free_consequences_auto_parallelism_independent_binds.v3",
  predicate: LensOutputEquals(
    r3_auto_parallelism_parallel_emit_witness,
    auto_parallelism_program_input,
    r3_auto_parallelism_parallel_emit_expected
  ),
  requires: []
}

data auto_parallelism_dependent_binds_emit_sequential: TestClaim = {
  name: "auto_parallelism_dependent_binds_emit_sequential",
  source: "// free-consequences fixture: dependent binds must remain sequential.\nlet a: Int = 1 + 2\nlet b: Int = a + 3\n",
  file_name: "r3_free_consequences_auto_parallelism_dependent_binds.v3",
  predicate: LensOutputEquals(
    auto_parallelism_schedule_witness,
    auto_parallelism_program_input,
    auto_parallelism_sequential_expected
  ),
  requires: []
}

data auto_parallelism_branch_arms_serialize: TestClaim = {
  name: "auto_parallelism_branch_arms_serialize",
  source: "// free-consequences fixture: two module lets, RHS conditional — schedule witness stays sequential.\nlet a: Int = 1\nlet r: Int = if 1 > 0 then 10 else 20\n",
  file_name: "r3_free_consequences_auto_parallelism_branch_arms.v3",
  predicate: LensOutputEquals(
    auto_parallelism_schedule_witness,
    auto_parallelism_program_input,
    auto_parallelism_sequential_expected
  ),
  requires: []
}

data auto_memoization_repeated_pure_call_cached: TestClaim = {
  name: "auto_memoization_repeated_pure_call_cached",
  source: "// free-consequences fixture: repeated pure calls may be cached when purity and cost witnesses land.\nlet _: Int = 0\n",
  file_name: "r3_free_consequences_auto_memoization_repeated_pure_call.v3",
  predicate: BinaryDimensionReportEquals(
    repeated_pure_call_observed_report,
    repeated_pure_call_expected_report
  ),
  requires: []
}

data auto_memoization_no_caching_for_one_shot: TestClaim = {
  name: "auto_memoization_no_caching_for_one_shot",
  source: "// free-consequences fixture: one-shot calls do not emit memoization scaffolding.\nlet _: Int = 0\n",
  file_name: "r3_free_consequences_auto_memoization_one_shot.v3",
  predicate: BinaryDimensionReportEquals(
    one_shot_call_observed_report,
    one_shot_call_expected_report
  ),
  requires: []
}

data r3_free_consequences_first_batch_suite: TestSuite = {
  name: "r3_free_consequences_first_batch_suite",
  claims: [
    auto_parallelism_independent_binds_emit_parallel,
    auto_parallelism_dependent_binds_emit_sequential,
    auto_parallelism_branch_arms_serialize,
    auto_memoization_repeated_pure_call_cached,
    auto_memoization_no_caching_for_one_shot
  ]
}
