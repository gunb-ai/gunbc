module test.r3_path_b_brief3_char_in_class_exec

import std.unicode { CharClass, char_in_class }

fn receipt_letter_is_ident_start() -> Bool = char_in_class(97, IdentStart)

fn receipt_digit_not_ident_start() -> Bool = char_in_class(53, IdentStart)

fn receipt_space_not_ident_start() -> Bool = char_in_class(32, IdentStart)

fn receipt_digit_is_digit() -> Bool = char_in_class(53, Digit)
