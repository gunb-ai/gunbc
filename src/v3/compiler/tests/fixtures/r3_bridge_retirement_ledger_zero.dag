// std.r3_bridge_retirement_ledger_zero - R3 bridge ledger-zero gate.
//
// Production consumer for the substrate-owned BridgeLedger carrier and
// BridgeLedgerZero predicate. The claim subject is the canonical structural
// ledger declaration, not an executable program. The integration harness
// records the current open-row baseline and keeps a decreasing-open-count
// ratchet against this claim while the binary zero gate stays the terminus.

module std.r3_bridge_retirement_ledger_zero

import std.verification { BridgeLedgerZero, TestClaim, TestSuite }
import v3.std.bridge_ledger { bridge_ledger }

data bridge_retirement_ledger_zero: TestClaim = {
  name: "bridge_retirement_ledger_zero",
  source: "",
  file_name: "src/v3/std/bridge_ledger.dag",
  predicate: BridgeLedgerZero { ledger: { decl: bridge_ledger } },
  requires: []
}

data r3_bridge_retirement_ledger_zero_suite: TestSuite = {
  name: "r3_bridge_retirement_ledger_zero_suite",
  claims: [bridge_retirement_ledger_zero]
}
