// R3 Class 2 gap representative: function-valued data is first-class.

type Gate61DimensionReport<Carrier>
  = Gate61DimensionOk { dimension_name: String, composed: Carrier }
  | Gate61DimensionFail { dimension_name: String }

data add_one: fn(Int) -> Int = |x| x + 1
data report_int: fn(Int) -> Gate61DimensionReport<Int> =
  |x| Gate61DimensionOk {
    dimension_name: "function-valued-data",
    composed: x
  }

fn test_function_valued_data() -> Int = add_one(41)
fn test_function_valued_dimension_report() -> Gate61DimensionReport<Int> = report_int(42)
