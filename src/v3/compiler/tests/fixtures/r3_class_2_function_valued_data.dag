// R3 Class 2 gap representative: function-valued data is first-class.

import std.list { List, Empty, Cons }
import v3.std.dimensions { DimensionReport, Witness }

data add_one: fn(Int) -> Int = |x| x + 1

fn gate61_empty_int_witnesses() -> List<Witness<Int>> = Empty

fn gate61_int_witnesses(c: Int) -> List<Witness<Int>> =
  Cons { head: Inhabits(c), tail: gate61_empty_int_witnesses() }

data report_int: fn(Int) -> DimensionReport<Int> =
  |x| DimensionOk {
    dimension_name: "function-valued-data",
    composed: x,
    witnesses: gate61_int_witnesses(x)
  }

fn test_function_valued_data() -> Int = add_one(41)
fn test_function_valued_dimension_report() -> DimensionReport<Int> = report_int(42)
