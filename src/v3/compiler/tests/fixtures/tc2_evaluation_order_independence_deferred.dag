// std.tc2_evaluation_order_independence_deferred — TC2 (R2 Evaluator semantics).
//
// Author-now / fire-later structural `TestClaim` for Church-Rosser-style
// evaluation-order independence over evaluator runtime values and Lens<C>
// results. Runtime values remain gated on the closed-over-environment decision
// in docs/briefs/r2-pr-a-runtime-value-model.md: environments are evaluator
// state (`EvalFrame` / `EvalStateStack`), not observable Value inhabitants.
//
// Slice-0 strict predicate: unified `BinaryDimensionReportEquals` (Director #828;
// Substrate PR #1318) with TC2 **strategy-order** interpretation — pair
// `DimensionReport<Dag>` role declarations for **LeftFirst** vs **RightFirst**
// n-ary Transform input-evaluation order (PR #1316 §1). Modifier semantics
// live in the future report producers / runner wiring, not in a parallel
// `TestPredicate` variant. Runner evaluation is NYI until generic
// `DimensionReport<C>` production lands; strict-fire still waits on ≥2
// executable strategies (PR #1316 §4 P4). `TestClaim.source` is empty —
// predicate is structural (paired report refs); no claim program slice.

module std.tc2_evaluation_order_independence_deferred

import std.dimensions { DimensionReport }
import std.substrate { Dag }
import std.verification { BinaryDimensionReportEquals, TestClaim, TestSuite }

// Role types: producers will resolve these to strategy-conditioned folds.
type tc2_leftfirst_strategy_dimension_report = DimensionReport<Dag>
type tc2_rightfirst_strategy_dimension_report = DimensionReport<Dag>

// Gates on PB-Runtime spec landing (#1176 landed) + T-Substrate-Lens-Primitive landing (R2 Substrate cadence).
// Evaluation-order strategies enumerated per docs/design-pb-runtime-interpreter.md §3.
// TC2 — For any program + Lens<C>, two valid evaluation strategies
// (applicative-order vs normal-order; left-first vs right-first
// input evaluation in n-ary Transform) yield identical
// DimensionReport<C>.
data evaluation_order_independent_lens_results: TestClaim = {
  name: "evaluation_order_independent_lens_results",
  source: "",
  file_name: "tc2_evaluation_order_independent_lens_results.v3",
  predicate: BinaryDimensionReportEquals(
    tc2_leftfirst_strategy_dimension_report,
    tc2_rightfirst_strategy_dimension_report
  ),
  requires: []
}

data tc2_evaluation_order_independence_suite: TestSuite = {
  name: "tc2_evaluation_order_independence_suite",
  claims: [evaluation_order_independent_lens_results]
}
