// R3 L5 certification corpus - add-then-branch seed (gate #15 `l5_cross_target_consistency` authority).
// `TestClaim.source` in `r3_verification_l5_corpus.dag` must match this file exactly (integration test).
module user.r3_l5_add_then_branch_seed

fn add(a: Int, b: Int) -> Int = a + b

let seed_acc: Int = add(1, 2)
let l5_out: Int =
  match seed_acc == 3 {
    True => seed_acc
    False => 0
  }
