// std.tc3_strong_normalization_deferred — TC3 (strong normalization / R3 Verification).
//
// Stage-(a) author-now-fire-later `TestClaim` for the PB→Verification transition
// described in docs/briefs/r3-pb-t-fixedpoint-worker.md §"TC3 — Strong-normalization
// TestClaim" and docs/briefs/r3-v-formal-grounding-tc-bundle.md (two-stage gate).
//
// Uses unified `BinaryDimensionReportEquals` with TC3 **evaluation-step** interpretation:
// paired `DimensionReport<Dag>` roles stand in for evaluation-step witness parity
// (bounded forward execution vs termination evidence — exact producers land with
// B5 + T-Substrate-Lens-Primitive + T-FixedPoint cadence). Full theorem witnessing
// (stage b) remains gated on T-FixedPoint completion; this fixture does not assert
// runtime termination over the typed fragment.
//
// `TestClaim.source` is empty — predicate is structural (paired report refs); no
// claim program slice (Verification structural-claim convention; cf. PR #1325).
//
// NO new `TestPredicate` variants — consumer-only authoring per Director #828.

module std.tc3_strong_normalization_deferred

import std.dimensions { DimensionReport }
import std.substrate { Dag }
import std.verification { BinaryDimensionReportEquals, TestClaim, TestSuite }

// Role types: baseline vs bounded-step projection producers hook here when wired.
type tc3_evaluation_step_baseline_dimension_report = DimensionReport<Dag>
type tc3_evaluation_step_compare_dimension_report = DimensionReport<Dag>

data tc3_strong_normalization_substrate_introduced: TestClaim = {
  name: "tc3_strong_normalization_substrate_introduced",
  source: "",
  file_name: "tc3_strong_normalization_substrate_introduced.v3",
  predicate: BinaryDimensionReportEquals(
    tc3_evaluation_step_baseline_dimension_report,
    tc3_evaluation_step_compare_dimension_report
  ),
  requires: []
}

data tc3_strong_normalization_suite: TestSuite = {
  name: "tc3_strong_normalization_suite",
  claims: [tc3_strong_normalization_substrate_introduced]
}
