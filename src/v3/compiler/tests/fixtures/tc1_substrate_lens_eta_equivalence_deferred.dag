// std.tc1_substrate_lens_eta_equivalence_deferred — TC1 (R2 substrate research scope).
//
// Author-now / fire-later structural `TestClaim` for eta-equivalence at substrate
// level vs `Lens<C>` / `DimensionReport<C>`. Design intent:
// - PR #1178 `docs/design-substrate-lambda-calculus-grounding.md` — "eta-equivalence at substrate level"
// - `docs/design-lens-framework.md` — `Lens<C>`, `DimensionReport<C>`
//
// `SubstrateResearchDeferredClaim` remains runner-valid only in this file (not
// R1 `r1_release_acceptance.dag` / `ReleaseDeferredClaim`), but TC1's strict
// consumer path now authors the unified `BinaryDimensionReportEquals` shape.
// The equality still author-now/fire-later gates on generic DimensionReport<C>
// production/evaluation and lens producer retirement.

module std.tc1_substrate_lens_eta_equivalence_deferred

import std.dimensions { DimensionReport }
import std.verification {
  BinaryDimensionReportEquals,
  TestClaim,
  TestSuite
}

// Carrier for the TC1 eta-equivalence observation. The concrete `Lens<C>` set
// and eta-pair producer are still pending T-Substrate-Lens-Primitive + lens
// producer retirement; this fixture locks the unified consumer shape.
type Tc1EtaLensObservation {}

// Eta-equivalent term pair:
// - `tc1_subject_f_report` represents applying `fold_lens<C>` to `f`.
// - `tc1_subject_eta_expanded_report` represents applying `fold_lens<C>` to
//   the eta-expanded form `lambda x.apply(f, [x])`.
//
// Both refs intentionally produce the same `DimensionReport<C>` carrier. The
// runner validates that shape today and returns NotYetImplemented until generic
// report evaluation can compare the produced values structurally.
type tc1_subject_f_report = DimensionReport<Tc1EtaLensObservation>
type tc1_subject_eta_expanded_report = DimensionReport<Tc1EtaLensObservation>

// Gates on T-Substrate-Lens-Primitive landing (Q6/Q6.5/Q7/Q8 design locks LANDED via #1129; substrate primitive itself in cadence after PR-PreF #1167)
// TC1 — For any Lens<C>, applying it to `f` and to eta-expanded
// `lambda x.apply(f, [x])` yields identical DimensionReport<C>.
data eta_equivalent_dag_forms_yield_identical_lens_results: TestClaim = {
  name: "eta_equivalent_dag_forms_yield_identical_lens_results",
  source: "// TC1 deferred theorem marker; no program evaluation.\nlet _: Int = 0\n",
  file_name: "tc1_eta_equivalent_dag_forms_yield_identical_lens_results.v3",
  predicate: BinaryDimensionReportEquals(
    tc1_subject_f_report,
    tc1_subject_eta_expanded_report
  ),
  requires: []
}

data tc1_substrate_lens_eta_equivalence_suite: TestSuite = {
  name: "tc1_substrate_lens_eta_equivalence_suite",
  claims: [eta_equivalent_dag_forms_yield_identical_lens_results]
}
