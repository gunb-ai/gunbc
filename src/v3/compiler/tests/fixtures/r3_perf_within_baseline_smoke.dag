// std.r3_perf_within_baseline_smoke — end-to-end `PerfWithinBaseline` using substrate
// `PerfBaselineMeasurement { median_ns, p99_delta_ns }` + `PerfBudgetComparisonOp::AtMostBudget`.

module std.r3_perf_within_baseline_smoke

import std.list { empty }
import v3.std.substrate { PerfBaselineMeasurement }
import std.verification {
  AtMostBudget,
  PerfWithinBaseline,
  TestClaim,
  TestSuite
}

data perf_within_smoke_baseline: PerfBaselineMeasurement = {
  median_ns: 100,
  p99_delta_ns: 100
}

data perf_within_smoke_subject: PerfBaselineMeasurement = {
  median_ns: 50,
  p99_delta_ns: 50
}

data perf_within_smoke_claim: TestClaim = {
  name: "perf_within_baseline_substrate_shape_smoke",
  source: "let _: Int = 0\n",
  file_name: "perf_within_smoke.v3",
  predicate: PerfWithinBaseline(
    perf_within_smoke_subject,
    AtMostBudget,
    perf_within_smoke_baseline
  ),
  requires: []
}

data perf_within_smoke_suite: TestSuite = {
  name: "perf_within_smoke_suite",
  claims: [perf_within_smoke_claim]
}
