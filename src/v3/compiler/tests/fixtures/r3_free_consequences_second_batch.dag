// std.r3_free_consequences_second_batch - T-Free-Consequences second-batch
// author-now/fire-later consumers.
//
// Five gates from `r3-v-free-consequences-worker.md`:
// - auto-loop-parallelism x3
// - cross-target-optimization x2
//
// The auto-loop-parallelism gates follow the first-batch DB-3/DB-20 split:
// parallelism is ordinary lens data, not `DimensionReport<C>`. The
// cross-target-optimization gates are cost-related consumers and therefore
// keep the `BinaryDimensionReportEquals` shape over paired `DimensionReport<C>`
// aliases.

module std.r3_free_consequences_second_batch

import std.dimensions { DimensionReport }
import std.substrate { Dag }
import std.verification {
  BinaryDimensionReportEquals,
  LensOutputEquals,
  ProgramInput,
  SymbolicCostExprEquals,
  TestClaim,
  TestSuite
}
import std.algebra { SymbolicCost, ConstantCost }

type CrossTargetOptimizationEvidence {}

data auto_loop_parallelism_program_input: ProgramInput = {}

// `Dag -> Int` lens for `LensOutputEquals`. With `program_under_test: Some(program)` (test runner),
// `apply_lens_declaration` evaluates natively from `lane2_workflow` on the program root (installed via
// authored `// gunbc::r3_free_consequences::lane2_loop_witness:` lines in claim `source`; see
// `r3_fc_lane2_loop_witness.rs`). The `= 0` body applies when no program-under-test is supplied.
fn auto_loop_parallelism_pending_lens(_d: Dag) -> Int = 0

// Parallel schedule hint (`loop_iteration_parallel_emission_indicator` → 1).
data auto_loop_parallelism_pending_expected: Int = 1

// Sequential / fail-closed hint (indicator → 0) for unproven independence and provable dependence.
data auto_loop_parallelism_sequential_expected: Int = 0

type constant_fold_observed_report = DimensionReport<CrossTargetOptimizationEvidence>
type constant_fold_expected_report = DimensionReport<CrossTargetOptimizationEvidence>
type cost_structurally_derived_observed_report = DimensionReport<CrossTargetOptimizationEvidence>
type cost_structurally_derived_expected_report = DimensionReport<CrossTargetOptimizationEvidence>

data constant_fold_pre_emission_cost: SymbolicCost = ConstantCost(1)

data auto_loop_parallelism_provable_independence_emits_parallel: TestClaim = {
  name: "auto_loop_parallelism_provable_independence_emits_parallel",
  source: "// gunbc::r3_free_consequences::lane2_loop_witness: read_only\n// free-consequences fixture: staged harness — read_only directive is author attestation for gate #46, not a composed iteration-independence proof on this trivial body.\nlet _: Int = 0\n",
  file_name: "r3_free_consequences_auto_loop_parallelism_provable_independence.v3",
  predicate: LensOutputEquals(
    auto_loop_parallelism_pending_lens,
    auto_loop_parallelism_program_input,
    auto_loop_parallelism_pending_expected
  ),
  requires: []
}

data auto_loop_parallelism_unproven_falls_back_sequential: TestClaim = {
  name: "auto_loop_parallelism_unproven_falls_back_sequential",
  source: "// gunbc::r3_free_consequences::lane2_loop_witness: unproven\n// free-consequences fixture: staged harness — unproven directive is author attestation of sequential fallback for gate #47, not compiler-inferred unprovenness.\nlet _: Int = 0\n",
  file_name: "r3_free_consequences_auto_loop_parallelism_unproven.v3",
  predicate: LensOutputEquals(
    auto_loop_parallelism_pending_lens,
    auto_loop_parallelism_program_input,
    auto_loop_parallelism_sequential_expected
  ),
  requires: []
}

data auto_loop_parallelism_dependence_emits_sequential: TestClaim = {
  name: "auto_loop_parallelism_dependence_emits_sequential",
  source: "// gunbc::r3_free_consequences::lane2_loop_witness: upsert_dependent\n// free-consequences fixture: structural `fold` (acc + x) lowers a real loop; lens `Pass` still follows\n// directive attestation + pending lens (ROADMAP second-batch auto-loop scaffold) - not compiler-derived upsert classification.\nimport std.list { List, cons, empty, fold }\n\nlet auto_loop_dependence_xs: List<Int> = cons(1, cons(2, cons(3, empty())))\nlet _: Int = fold(auto_loop_dependence_xs, 0, |acc, x| acc + x)\n",
  file_name: "r3_free_consequences_auto_loop_parallelism_dependence.v3",
  predicate: LensOutputEquals(
    auto_loop_parallelism_pending_lens,
    auto_loop_parallelism_program_input,
    auto_loop_parallelism_sequential_expected
  ),
  requires: []
}

data cross_target_optimization_constant_fold_consistent: TestClaim = {
  name: "cross_target_optimization_constant_fold_consistent",
  source: "// free-consequences fixture: constant folding applies the same structural cost shrink across target language specs.\nlet folded: Int = 1 + 2\n",
  file_name: "r3_free_consequences_cross_target_constant_fold_consistent.v3",
  predicate: SymbolicCostExprEquals(constant_fold_pre_emission_cost),
  requires: []
}

data cross_target_optimization_cost_structurally_derived: TestClaim = {
  name: "cross_target_optimization_cost_structurally_derived",
  source: "// free-consequences fixture: cross-target optimization cost is structurally derived from Lens<Cost> and LanguageSpec facts.\nlet cost_demo: Int = 1 + 2 + 3\n",
  file_name: "r3_free_consequences_cross_target_cost_structurally_derived.v3",
  predicate: BinaryDimensionReportEquals(
    cost_structurally_derived_observed_report,
    cost_structurally_derived_expected_report
  ),
  requires: []
}

data r3_free_consequences_second_batch_suite: TestSuite = {
  name: "r3_free_consequences_second_batch_suite",
  claims: [
    auto_loop_parallelism_provable_independence_emits_parallel,
    auto_loop_parallelism_unproven_falls_back_sequential,
    auto_loop_parallelism_dependence_emits_sequential,
    cross_target_optimization_constant_fold_consistent,
    cross_target_optimization_cost_structurally_derived
  ]
}
