// Gate #92 witness: `complexity_of` + `EnforcedApplication` enforcement consumer.
//
// `linear_countdown_score` is a structurally terminating recursive function:
// non-positive inputs stop immediately, and positive inputs count down to zero.
// The current authoritative complexity lens observes this recursive descent as
// `ClassUnknown`; the enforced application below requires `ClassConstant`,
// forcing a fail-closed diagnostic at the authored lens-application span.
module user.t_las_complexity_contract_demo

import lenses.complexity { ComplexitySummary, complexity_enforceable }
import std.algebra { AsymptoticClass }
import v3.std.lens_application { EnforcedApplication, DeclarationScope }

fn linear_countdown_score(n: Int) -> Int =
  if n < 1 then 0 else linear_countdown_score(n - 1) + 1

data witness_log_cap: EnforcedApplication<ComplexitySummary, AsymptoticClass, AsymptoticClass> = {
  enforceable_lens: complexity_enforceable
  section: DeclarationScope { declaration: linear_countdown_score }
  budget: ClassConstant
  diagnostic_severity: Error
  span: { file: "t_las_complexity_contract_demo.dag", start: 805, end: 1147 }
}
