// lenses.cost — symbolic-cost lens over the v3 DAG.
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY PROXY
//   (T-CostLens-Composition α-narrow ratified at gunb-ai/gunbc#828
//   #issuecomment-4400772335 via PR #2171: §1.8 gates #38 + #39 satisfied
//   by construction at HEAD; #37 + #40 + #70 deferred to follow-on
//   Behavior→primitive-identity wiring canvas at gunb-ai/gunbc#2175).
// See docs/v3-lens-capability-register.md.
//
// Produces `Lookup<SymbolicCost>` per port using `SymbolicCost`
// combinators (`sequential`, `iterate`, `max_path`) from
// `std.algebra`. Richer than the integer-depth `complexity.dag`
// output, but `SizeVariable` here carries only `source_port: PortId`
// — there is no named size variable with value semantics the way v2's
// `SizeVar { name: String }` has. Output dimensions, certainty, and
// asymptotic classification from v2 are also not carried. Dimension
// wiring is deferred on grammar gaps (see the `Dimension<SymbolicCost>`
// discussion lower in this file). Lane E-C stages `CallPattern` /
// `LoweringTarget` in `std.computation`; lane E-I stages `SubValueRelation`
// and the `CostBound` algebra in `std.induction`. This lens still does not
// thread per-call descent into `SymbolicCost`: the remaining gap is **E-P**
// (producer wiring, richer size variables, behavioral tests) — not missing
// E-I vocabulary or a ported `MethodSemantics` carrier. E-M closed method
// carrier parity by structural subsumption through `TransformTarget` and
// typed declaration/effect metadata. No behavioral cementing test exercises
// this lens yet.
//
// Shared carrier: `v3.std.lookup.Lookup` (compiler-std consolidation;
// see docs/thesis/compiler-std-consolidation.md). The prior lens-local
// `SymbolicCostLookup = MissingCost | FoundCost(SymbolicCost)` enum
// was a parallel `Missing|Found(T)` sum that dissolved into `Lookup<T>`
// per the strict two-variant ratchet; the Rust surface keeps a
// `SymbolicCostLookup` *type alias* for embedders.

module lenses.cost

import std.list { List, empty, fold, cons }
import std.substrate { Dag, Behavior, BranchPath, LoopNode, NodeId, PortId, node }
import std.algebra {
  MethodContract,
  CostShape,
  SymbolicCost,
  SizeVariable,
  sequential,
  iterate,
  max_path,
  miss_symbolic_cost_lookup,
  hit_symbolic_cost_lookup
}
import v3.std.lookup { Lookup }

type SymbolicCostEntry {
  port: PortId
  cost: Lookup<SymbolicCost>
}

fn symbolic_cost_of(d: Dag, port_id: PortId) -> Lookup<SymbolicCost> =
  lookup_cost(compute_symbolic_costs(d), port_id)

// §6a Option 3 demo consumer: cost analysis reads per-method metadata from
// the unified carrier keyed by `(algebra_id, method_id)`, keeping the
// cost/size/callback facts co-located for later live call-site wiring.
fn method_contract_cost_shape(contract: MethodContract) -> CostShape? =
  contract.cost_shape

fn compute_symbolic_costs(d: Dag) -> List<SymbolicCostEntry> =
  fold(d.nodes, seed_bind_params(d.nodes), |acc, behavior|
    cons(entry_for(d, acc, behavior), acc)
  )

fn seed_bind_params(nodes: List<Behavior>) -> List<SymbolicCostEntry> =
  match nodes {
    Empty => empty()
    Cons(payload) =>
      concat_entries(params_of(payload.head), seed_bind_params(payload.tail))
  }

fn params_of(behavior: Behavior) -> List<SymbolicCostEntry> =
  match behavior {
    Value(v) => empty()
    Transform(t) => empty()
    Branch(b) => empty()
    Loop(l) => empty()
    Bind(bind) => param_entries(bind.params)
  }

fn param_entries(params: List<PortId>) -> List<SymbolicCostEntry> =
  match params {
    Empty => empty()
    Cons(payload) =>
      cons(
        { port: payload.head, cost: hit_symbolic_cost_lookup(ConstantCost(0)) },
        param_entries(payload.tail)
      )
  }

fn concat_entries(
  a: List<SymbolicCostEntry>,
  b: List<SymbolicCostEntry>
) -> List<SymbolicCostEntry> =
  match a {
    Empty => b
    Cons(payload) => cons(payload.head, concat_entries(payload.tail, b))
  }

fn entry_for(
  d: Dag,
  acc: List<SymbolicCostEntry>,
  behavior: Behavior
) -> SymbolicCostEntry =
  match behavior {
    Value(v) =>
      { port: v.result_port, cost: hit_symbolic_cost_lookup(ConstantCost(0)) }
    Transform(t) =>
      { port: t.result_port, cost: transform_cost(acc, t.inputs) }
    Branch(b) =>
      { port: b.result_port, cost: branch_cost(acc, b.input, b.paths) }
    Loop(l) =>
      { port: l.result_port, cost: loop_cost(d, acc, l) }
    Bind(bind) =>
      { port: bind.result_port, cost: lookup_cost(acc, bind.result_port) }
  }

// `loop_cost` composes iteration: bound × body.
//
// - Bound: `LinearCost(size_var_of(l.source))` — the runtime value
//   the Loop descends upon. This is the live DB-3 / DB-7 analysis path:
//   `AnalysisDimension.witness_of(d, behavior)` receives the whole
//   `Behavior`, so a Loop witness can read both `LoopNode.source` and
//   `LoopNode.bound`. Do not use this comment as an argument that a
//   future generic `Lens<C>.iterate` may drop or rederive the source;
//   the current authority stays at the Behavior / LoopNode boundary.
// - Body: the already-lowered cost of `l.body`'s result port. The
//   forward-fold contract guarantees the body's `entry_for` ran
//   earlier in the walk (producers precede consumers in
//   `d.nodes`), so its cost is already in `acc`.
//
// PR #537 reviewer call-out (briansrls, BLOCKING): the earlier
// shape `loop_cost(acc, l.source)` passed only the source port
// and then looked that same port up as "body cost" — so
// recursive-body work silently contributed zero, violating Facts
// Flow Forward. Now `l.body: NodeId` is resolved through the
// `node(d, NodeId) -> Behavior?` substrate accessor to recover
// the body's result port, and THAT port's cost is the honest
// body cost.
fn loop_cost(
  d: Dag,
  acc: List<SymbolicCostEntry>,
  l: LoopNode
) -> Lookup<SymbolicCost> =
  combine_iterate(
    linear_at(l.source),
    body_cost(d, acc, l.body)
  )

fn body_cost(
  d: Dag,
  acc: List<SymbolicCostEntry>,
  body_id: NodeId
) -> Lookup<SymbolicCost> =
  match node(d, body_id) {
    None => miss_symbolic_cost_lookup()
    Some(body_behavior) => lookup_cost(acc, behavior_result_port(body_behavior))
  }

fn behavior_result_port(b: Behavior) -> PortId =
  match b {
    Value(v) => v.result_port
    Transform(t) => t.result_port
    Branch(br) => br.result_port
    Loop(lp) => lp.result_port
    Bind(bind) => bind.result_port
  }

fn linear_at(port_id: PortId) -> Lookup<SymbolicCost> =
  hit_symbolic_cost_lookup(LinearCost({ source_port: port_id }))

fn combine_iterate(
  bound: Lookup<SymbolicCost>,
  body: Lookup<SymbolicCost>
) -> Lookup<SymbolicCost> =
  match bound {
    Miss => miss_symbolic_cost_lookup()
    Hit(b) =>
      match body {
        Miss => miss_symbolic_cost_lookup()
        Hit(y) => hit_symbolic_cost_lookup(iterate(b, y))
      }
  }

fn branch_cost(
  acc: List<SymbolicCostEntry>,
  input: PortId,
  paths: List<BranchPath>
) -> Lookup<SymbolicCost> =
  combine_sequential(
    hit_symbolic_cost_lookup(ConstantCost(1)),
    combine_sequential(
      lookup_cost(acc, input),
      max_of_paths(acc, paths)
    )
  )

fn max_of_paths(
  acc: List<SymbolicCostEntry>,
  paths: List<BranchPath>
) -> Lookup<SymbolicCost> =
  fold(paths, hit_symbolic_cost_lookup(ConstantCost(0)), |running, path|
    combine_max(running, lookup_cost(acc, path.result_port))
  )

fn combine_max(
  a: Lookup<SymbolicCost>,
  b: Lookup<SymbolicCost>
) -> Lookup<SymbolicCost> =
  match a {
    Miss => miss_symbolic_cost_lookup()
    Hit(ax) =>
      match b {
        Miss => miss_symbolic_cost_lookup()
        Hit(bx) => hit_symbolic_cost_lookup(dominant(ax, bx))
      }
  }

fn dominant(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost =
  max_path(cons(a, cons(b, empty())))

fn transform_cost(
  acc: List<SymbolicCostEntry>,
  inputs: List<PortId>
) -> Lookup<SymbolicCost> =
  combine_sequential(
    hit_symbolic_cost_lookup(ConstantCost(1)),
    sum_costs(acc, inputs)
  )

fn sum_costs(
  acc: List<SymbolicCostEntry>,
  ports: List<PortId>
) -> Lookup<SymbolicCost> =
  fold(ports, hit_symbolic_cost_lookup(ConstantCost(0)), |running, port_id|
    combine_sequential(running, lookup_cost(acc, port_id))
  )

fn combine_sequential(
  a: Lookup<SymbolicCost>,
  b: Lookup<SymbolicCost>
) -> Lookup<SymbolicCost> =
  match a {
    Miss => miss_symbolic_cost_lookup()
    Hit(ax) =>
      match b {
        Miss => miss_symbolic_cost_lookup()
        Hit(bx) => hit_symbolic_cost_lookup(sequential(ax, bx))
      }
  }

fn lookup_cost(acc: List<SymbolicCostEntry>, port_id: PortId) -> Lookup<SymbolicCost> =
  match acc {
    Empty => miss_symbolic_cost_lookup()
    Cons(payload) =>
      if payload.head.port == port_id then
        payload.head.cost
      else
        lookup_cost(payload.tail, port_id)
  }

// ── T-CostLens-Composition α-narrow disposition (gunb-ai/gunbc#2141) ─
//
// **Director-ratified α (narrow)** at gunbc#828 #issuecomment-4400772335
// (relay: gunbc#2068 #issuecomment-4401002201). β (parallel-API) rejected
// per `feedback_isomorphism_or_generation_for_mirrors`; γ-extended
// (`Lens<C>.read` refactor) deferred to its own Q-Lens-Target-Context
// PROPOSAL canvas — NOT a T-CostLens stowaway.
//
// **Same-slice closure (PR #2171 receipts)**:
//   - **#38 `coercion_cost_equals_complexity_by_construction`** —
//     SATISFIED-BY-CONSTRUCTION at HEAD. `SymbolicCost` algebra (type
//     at `src/v3/std/algebra.dag:181-188`) with `sequential` / `iterate`
//     composition fns (`src/v3/std/algebra.dag:262-272`) is the sole
//     composition authority; no parallel "complexity-vs-cost"
//     reconciliation surface exists.
//   - **#39 `no_coercion_cost_dimension`** — SATISFIED-BY-CONSTRUCTION
//     at HEAD. `SymbolicCost` 7-variant (`std/algebra.dag:181`) is the
//     sole cost dimension; no parallel `CoercionCost` carrier exists per
//     grep across `src/v3/{std,lenses,spec}/`.
//
// **Deferred to follow-on canvas (gunb-ai/gunbc#2175)** —
// cross-cutting Behavior→primitive-identity wiring substrate:
//   - **#37** `cost_lens_reads_target_realization`
//   - **#40** `symbolic_cost_expr_equals_executable` (also Verification
//     Mgr lane #2075)
//   - **#70** `cost_lens_demonstration`
//
// Structural findings forcing the canvas-tier deferral (surfaced
// gunbc#2068 #issuecomment-4399898495 + #issuecomment-4400390687):
//   1. No `data cost_lens: Lens<SymbolicCost>` row at HEAD — see this
//      file's line ~357 below ("do not author"); the existing scaffolding
//      is the bespoke `compute_symbolic_costs(d: Dag)` Behavior fold,
//      NOT a `Lens<SymbolicCost>` instance.
//   2. `Lens<C>.read: fn(Dag, Behavior) -> Witness<C>` carries no
//      target-context — Q-Lens-Target-Context PROPOSAL territory.
//   3. Behavior→primitive-identity is structurally tractable via
//      `TransformNode.target: TransformTarget` (`Callable(DeclarationId)`,
//      `std/substrate.dag:418`) for Transform behaviors; other variants
//      need their own anchors.
//   4. `.dag`-side iteration over `List<CallableRealization>` /
//      `List<TypeRealization>` has zero precedent at HEAD; realizations
//      consumed Rust-side at emit time only. Introducing such iteration
//      is canvas-tier (#2175).
//
// ── Dimension<SymbolicCost> wiring — DEFERRED (class-5 data bodies) ─
//
// **Stage 2f dispatch (landed):** `v3_compiler::analyze_symbolic_cost_dimension`
// packages the same `symbolic_cost_of` / `compute_symbolic_costs` algebra as a
// `DimensionReport<SymbolicCost>` (DB-3). The `data symbolic_cost_dimension:
// Dimension<SymbolicCost> = { ... }` **value** remains blocked on record bodies;
// the Rust entrypoint is the interim authority — same pattern as ROADMAP §Lane 2.
//
// ── Dimension<SymbolicCost> data declaration — DEFERRED to class-5 ─
//
// DB-7 §"Dimension<SymbolicCost> wiring" specifies a
// `data symbolic_cost_dimension: Dimension<SymbolicCost> = {..}`
// declaration with `witness_of`, `compose`, `identity` fields
// carrying function references.
//
// Stage 2d does NOT ship this data declaration because v3's
// current parser/lowerer rejects two v3 surface-grammar gaps that
// the declaration's shape requires simultaneously:
//
//   1. Record literals inside `data X: T = { ... }` bodies. At
//      M1(2.8) the lowerer reports "data has an opaque body —
//      user code cannot yet use record / list / map literals
//      inside data bodies" (DOWNSTREAM_REQUIREMENTS.md class-5
//      gap #3).
//   2. Record literals / match / lambdas inside `fn X { body }`
//      block-bodied definitions. Constructing `Witness::Violates
//      { reason, at }` — the MissingCost-to-violation shim the
//      Dimension contract requires — hits the same block-body
//      restriction.
//
// The lens ships its Behavior-variant lowering (`entry_for` +
// helpers) as the authority. When Stage 2f's generic `analyze`
// walker lands, it will materialize the `Dimension<SymbolicCost>`
// instance alongside the surface-grammar extensions that unlock
// the receipt form. Dispatching the instance from here today
// would either require a parallel Rust-side declaration (bypassing
// `.dag`-as-authority) or wait on the grammar extension — the
// second path is the one the ROADMAP already sequences (Stage 2f
// extracts the abstraction once multiple instances exist).
//
// See `docs/design-symbolic-cost-algebra.md` §"Dimension<SymbolicCost>
// wiring" for the target shape.

// ── Cost dimension data declaration / forward Lens boundary ─
//
// Live target today is DB-3 / DB-7's analysis-dimension path:
//
//   data symbolic_cost_dimension: AnalysisDimension<SymbolicCost> = {
//     name: "symbolic_cost",
//     witness_of: symbolic_cost_witness_of,
//     compose: sequential,
//     identity: ConstantCost(0),
//     break_diagnostic: symbolic_cost_break_diagnostic
//   }
//
// Do NOT author that data value until class-5 data-body lowering can
// express the record honestly: function-valued field references,
// nested structural values, and the `Witness<SymbolicCost>` /
// `OptionalDiagnostic` constructors needed by `witness_of` and
// `break_diagnostic`. The current Rust entrypoint
// `v3_compiler::analyze_symbolic_cost_dimension` remains the execution
// authority over the same `DimensionReport<SymbolicCost>` carrier.
//
// This DB-3 path keeps symbolic-cost analysis at the Behavior /
// LoopNode boundary. A Loop witness may read `l.source`, `l.bound`, and
// the loop body through the Dag, so `LoopBound::Descent` is not by
// itself a blocker for the live `AnalysisDimension<SymbolicCost>`
// declaration. The existing `loop_cost(d, acc, l)` implementation keeps
// using `linear_at(l.source)` for both Cardinality and Descent loops
// until a richer, authoritative cluster-measure fact is introduced.
//
// Forward Lens<SymbolicCost> note: current cost semantics still read
// `LoopNode.source`, but R3 cost-lens composition should not carry that
// shortcut forward. `LoopBound::Descent` now carries its own runtime
// `measure: PortId`, plus the shared `loop_bound_measure(LoopBound) ->
// PortId` accessor, so a source-less `Lens<C>.iterate: fn(C, LoopBound)
// -> C` can read the bound honestly once the lens fold lands. Current
// mapping:
//
//   - `Cardinality { count }` -> `LinearCost({ source_port: count })`
//   - `Descent { cluster, measure }` -> currently
//     `LinearCost({ source_port: l.source })` through the enclosing
//     `LoopNode`, with a ratchet that `l.source ==
//     loop_bound_measure(l.bound)` until direct `LoopNode.source` cost
//     reads retire. The cluster sidecar carries termination witness
//     topology, not a replacement cost carrier.
//
// Do not choose `UnknownCost("mutual recursion descent cluster")` as a
// local migration convenience. `UnknownCost` is an algebra top, not a
// failure channel; if a future lens fold wants a different Descent cost
// policy, that must be named as the authoritative substrate decision.
// Until the class-5 data declaration and direct `LoopNode.source` cost
// reads retire, preserve `compute_symbolic_costs` / `symbolic_cost_of`
// as the primary API and do not author `data cost_lens`.
