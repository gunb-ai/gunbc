module lenses.cost

import std.list { List, empty, fold, cons }
import std.substrate { Dag, Behavior, PortId }
import std.algebra { SymbolicCost }

type SymbolicCostEntry {
  port: PortId
  cost: SymbolicCost
}

fn symbolic_cost_of(d: Dag, port_id: PortId) -> SymbolicCost =
  lookup_cost(compute_symbolic_costs(d), port_id)

fn compute_symbolic_costs(d: Dag) -> List<SymbolicCostEntry> =
  fold(d.nodes, empty(), |acc, behavior|
    cons(entry_for(behavior), acc)
  )

fn entry_for(behavior: Behavior) -> SymbolicCostEntry =
  match behavior {
    Value(v) => { port: v.result_port, cost: ConstantCost(0) }
    Transform(t) => { port: t.result_port, cost: ConstantCost(0) }
    Branch(b) => { port: b.result_port, cost: ConstantCost(0) }
    Loop(l) => { port: l.result_port, cost: ConstantCost(0) }
    Bind(bind) => { port: bind.result_port, cost: ConstantCost(0) }
  }

fn lookup_cost(acc: List<SymbolicCostEntry>, port_id: PortId) -> SymbolicCost =
  match acc {
    Empty => ConstantCost(0)
    Cons(payload) =>
      if payload.head.port == port_id then
        payload.head.cost
      else
        lookup_cost(payload.tail, port_id)
  }
