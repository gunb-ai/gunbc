// lenses.variant_payload — emitter-side classification for resolved variant
// payload shapes (empty / positional single / named fields).
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY COMPLETE (v3-native, no v2 counterpart).
// See docs/v3-lens-capability-register.md.
// (The `DeclarationLookup` parallel-authority cleanup tracked in
// ROADMAP 2026-04-21 wave is an internal C-8 tightening, not a
// behavioral gap in what this lens computes.)
//
// Authority lives here; Rust projection is regenerated via `emit_rust_module`
// into `src/v3/compiler/src/variant_payload_generated.rs`. Bootstrap
// placement mirrors other lenses under `src/v3/lenses/` (not `src/v3/std/`)
// so build.rs does not double-load this file into the bootstrap Dag.

module lenses.variant_payload

import std.list { List, empty, cons, map }
import std.substrate {
  Dag, DeclarationId, TypeConnective, ConjField, declaration_by_id
}

type VariantPayloadShape
  = Empty
  | PositionalSingle
  | NamedFields(List<String>)

// `DeclarationMissing` carries the substrate-integrity violation
// (`declaration_by_id` returned `None`): id-carriers can't legitimately
// reference an absent declaration, so consumers must fail closed.
// `NotPayloadProduct` is the ordinary outcome for declarations whose
// connective is not `Conj` (atoms, arrows, cardinalities, …) — callers
// that only care about product-shaped variants legitimately ignore it.
// Keeping the two distinct prevents a C-8 fail-open where a caller's
// `not-a-product` fallback would otherwise swallow a substrate-integrity
// miss.
type VariantPayloadShapeLookup
  = DeclarationMissing
  | NotPayloadProduct
  | Found(VariantPayloadShape)

fn conj_field_label(f: ConjField) -> String =
  f.label

fn conj_payload_shape(children: List<ConjField>) -> VariantPayloadShape =
  match children {
    Empty => Empty
    Cons(payload) =>
      match payload.tail {
        Empty =>
          if payload.head.label == "_0" then PositionalSingle
          else NamedFields(cons(payload.head.label, empty()))
        Cons(_) =>
          NamedFields(map(children, conj_field_label))
      }
  }

fn variant_payload_shape(d: Dag, variant_id: DeclarationId) -> VariantPayloadShapeLookup =
  match declaration_by_id(d, variant_id) {
    None => DeclarationMissing
    Some(decl) =>
      match decl.connective {
        Conj(c) => Found(conj_payload_shape(c.children))
        Atom(_) => NotPayloadProduct
        Disj(_) => NotPayloadProduct
        Arrow(_) => NotPayloadProduct
        Cardinality(_) => NotPayloadProduct
        Instantiation(_) => NotPayloadProduct
      }
  }
