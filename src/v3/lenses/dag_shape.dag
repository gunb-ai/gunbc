// lenses.dag_shape — reusable reflected-Dag shape producer.
//
// Producer-first substrate slice for Verification shape/isomorphism work.
// Downstream TC1 eta-equivalence, TC2 strategy-order, TC3 evaluation-step,
// and RustDagIsomorphism consumers should compare `DagShapeReport` values
// structurally instead of introducing one-off predicates.
//
// This file deliberately does not author Verification `TestClaim`s and does
// not introduce a RustDagIsomorphism primitive. It only exposes the carrier and
// producer surface that comparison shells such as `BinaryDimensionReportEquals`
// can consume.

module lenses.dag_shape

import std.list { List, empty, cons, concat }
import std.algebra { Monoid }
import std.substrate {
  Dag,
  Behavior,
  Declaration,
  DagPort,
  Cluster,
  LoopBound
}
import v3.std.dimensions { Witness, OptionalDiagnostic }
import v3.std.lens { Lens }

// Raw reflected-Dag shape carrier. This is intentionally a projection of the
// existing reflected substrate authority, not a parallel hand-coded
// isomorphism predicate. Normalization policies such as eta expansion,
// evaluation strategy ordering, or id remapping belong to downstream producers
// before they compare two reports.
type DagShapeReport {
  declarations: List<Declaration>
  nodes: List<Behavior>
  ports: List<DagPort>
  clusters: List<Cluster>
}

data empty_dag_shape_report: DagShapeReport = {
  declarations: []
  nodes: []
  ports: []
  clusters: []
}

fn dag_shape_report(d: Dag) -> DagShapeReport =
  {
    declarations: d.declarations
    nodes: d.nodes
    ports: d.ports
    clusters: d.clusters
  }

fn dag_shape_node_report(b: Behavior) -> DagShapeReport =
  {
    declarations: empty()
    nodes: cons(b, empty())
    ports: empty()
    clusters: empty()
  }

fn combine_dag_shape_reports(left: DagShapeReport, right: DagShapeReport) -> DagShapeReport =
  {
    declarations: concat(left.declarations, right.declarations)
    nodes: concat(left.nodes, right.nodes)
    ports: concat(left.ports, right.ports)
    clusters: concat(left.clusters, right.clusters)
  }

fn dag_shape_read(_d: Dag, b: Behavior) -> Witness<DagShapeReport> =
  Inhabits(dag_shape_node_report(b))

fn dag_shape_branch(left: DagShapeReport, right: DagShapeReport) -> DagShapeReport =
  combine_dag_shape_reports(left, right)

fn dag_shape_iterate(body: DagShapeReport, _bound: LoopBound) -> DagShapeReport =
  body

fn dag_shape_validate(_d: Dag, _report: DagShapeReport) -> OptionalDiagnostic =
  NoDiagnostic

data dag_shape_report_monoid: Monoid<DagShapeReport> = {
  op: combine_dag_shape_reports
  identity: empty_dag_shape_report
}

data dag_shape_lens: Lens<DagShapeReport> = {
  name: "dag_shape"
  read: dag_shape_read
  sequential: dag_shape_report_monoid
  branch: dag_shape_branch
  iterate: dag_shape_iterate
  validate: dag_shape_validate
}
