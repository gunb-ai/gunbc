// lenses.dag_shape — reusable reflected-Dag shape producer.
//
// Producer-first substrate slice for Verification shape/isomorphism work.
// Downstream TC1 eta-equivalence, TC2 strategy-order, TC3 evaluation-step,
// and RustDagIsomorphism consumers should compare raw reflected `Dag` values
// structurally instead of introducing one-off predicates.
//
// This file deliberately does not author Verification `TestClaim`s and does
// not introduce a RustDagIsomorphism primitive. It only exposes the carrier and
// producer surface that comparison shells such as `BinaryDimensionReportEquals`
// can consume.

module lenses.dag_shape

import std.substrate {
  Dag
}

// Raw reflected-Dag shape producer. The existing `std.substrate.Dag` product
// remains the single authority for declarations, nodes, ports, and clusters;
// this file must not restate that exact product as a second report record.
// Normalization policies such as eta expansion, evaluation strategy ordering,
// or id remapping belong to downstream producers before they compare reports.
fn dag_shape_report(d: Dag) -> Dag =
  d

// Lens-shaped Dag shape production is intentionally not part of this slice.
// The live Lens<C> read contract is per-Behavior, while this raw producer
// returns whole-Dag facts (`declarations`, `nodes`, `ports`, and `clusters`).
// Forcing those facts through per-node helpers would drop reflected substrate
// authority. A future lens surface needs either a separate behavior-only
// carrier, an explicit framework contract for whole-Dag producers, or a named
// normalized report carrier with invariants that differ from raw `Dag`.
