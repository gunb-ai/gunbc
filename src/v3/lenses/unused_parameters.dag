module lenses.unused_parameters

import std.list {
  List, empty, singleton, cons, concat, fold, contains, is_empty, length
}
import std.substrate {
  Dag, DagPort, Behavior, BranchPath, BindNode, LoopNode, NodeId, PortId, SourceSpan,
  port, node
}

type UnusedParameter {
  function: NodeId
  parameter: PortId
  parameter_index: Int
  function_span: SourceSpan
}

fn check(d: Dag) -> List<UnusedParameter> =
  fold(d.nodes, empty(), |acc, behavior|
    concat(acc, check_behavior(d, behavior))
  )

fn check_behavior(d: Dag, behavior: Behavior) -> List<UnusedParameter> =
  match behavior {
    Value(v) => empty()
    Transform(t) => empty()
    Branch(b) => empty()
    Loop(l) => empty()
    Bind(bind) =>
      if is_empty(bind.params) then
        empty()
      else
        check_bind(d, bind)
  }

fn check_bind(d: Dag, bind: BindNode) -> List<UnusedParameter> =
  collect_unused_params(
    bind.params,
    bind,
    referenced_ports(d, bind.result_port),
    0
  )

fn collect_unused_params(params: List<PortId>, bind: BindNode, referenced: List<PortId>, index: Int) -> List<UnusedParameter> =
  match params {
    Empty => empty()
    Cons(payload) =>
      if contains(referenced, payload.head) then
        collect_unused_params(payload.tail, bind, referenced, index + 1)
      else
        cons(
          {
            function: bind.id
            parameter: payload.head
            parameter_index: index
            function_span: bind.span
          },
          collect_unused_params(payload.tail, bind, referenced, index + 1)
        )
  }

fn referenced_ports(d: Dag, root: PortId) -> List<PortId> =
  walk_steps(length(d.ports), d, singleton(root), empty())

fn walk_steps(remaining: Int, d: Dag, frontier: List<PortId>, referenced: List<PortId>) -> List<PortId> =
  if remaining == 0 then
    referenced
  else
    if is_empty(frontier) then
      referenced
    else
      walk_steps(
        remaining - 1,
        d,
        expand_frontier_list(frontier, d, referenced),
        expand_referenced_list(frontier, referenced)
      )

fn expand_frontier_list(frontier: List<PortId>, d: Dag, referenced: List<PortId>) -> List<PortId> =
  match frontier {
    Empty => empty()
    Cons(payload) =>
      if contains(referenced, payload.head) then
        expand_frontier_list(payload.tail, d, referenced)
      else
        concat(
          inputs_for_port(d, payload.head),
          expand_frontier_list(payload.tail, d, referenced)
        )
  }

fn expand_referenced_list(frontier: List<PortId>, referenced: List<PortId>) -> List<PortId> =
  fold(frontier, referenced, |acc, port|
    if contains(acc, port) then
      acc
    else
      cons(port, acc)
  )

fn inputs_for_port(d: Dag, port_id: PortId) -> List<PortId> =
  match port(d, port_id) {
    None => empty()
    Some(p) =>
      match p.produced_by {
        None => empty()
        Some(node_id) => inputs_for_node(d, node_id)
      }
  }

fn inputs_for_node(d: Dag, node_id: NodeId) -> List<PortId> =
  match node(d, node_id) {
    None => empty()
    Some(behavior) => inputs_for_behavior(d, behavior)
  }

fn inputs_for_behavior(d: Dag, behavior: Behavior) -> List<PortId> =
  match behavior {
    Value(v) => empty()
    Transform(t) => t.inputs
    Branch(branch) => cons(branch.input, branch_path_outputs(branch.paths))
    Loop(loop_node) => loop_inputs(d, loop_node)
    Bind(bind) => singleton(bind.result_port)
  }

fn loop_inputs(d: Dag, loop_node: LoopNode) -> List<PortId> =
  concat(
    cons(
      loop_node.source,
      cons(loop_node.init, singleton(loop_node.bound.count))
    ),
    match node(d, loop_node.body) {
      None => empty()
      Some(body_node) => singleton(behavior_port(body_node))
    }
  )

fn branch_path_outputs(paths: List<BranchPath>) -> List<PortId> =
  match paths {
    Empty => empty()
    Cons(payload) => cons(payload.head.result_port, branch_path_outputs(payload.tail))
  }

fn behavior_port(behavior: Behavior) -> PortId =
  match behavior {
    Value(v) => v.result_port
    Transform(t) => t.result_port
    Branch(b) => b.result_port
    Loop(l) => l.result_port
    Bind(bind) => bind.result_port
  }
