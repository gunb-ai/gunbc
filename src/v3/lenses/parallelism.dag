// Status: STRUCTURALLY PARTIAL; BEHAVIORALLY STUB.
// See docs/v3-lens-capability-register.md.
//
// This file is not an analysis — `analyze_parallelism` unconditionally returns
// `report_parallelism_unsupported(LensSurfacePending, …)`. The authoritative
// analysis lives in `src/v3/compiler/src/workflow_parallelism.rs` (`v3_compiler::
// analyze_parallelism`). **Emit note:** `emit_rust_module` can now lower `match`
// on imported user-defined sums such as `WorkflowEffect` in lens modules (see
// `docs/v3-lens-capability-register.md`); this lens stays a placeholder until
// the Stage 2e walk is ported to `.dag` / `std.effects` and wired through
// `lane2_workflow_at` like `lenses/idempotency.dag`. See ROADMAP Lane 2 Stage 2b
// “Reflection boundary.”

module lenses.parallelism

import v3.std.substrate { Dag, NodeId }
import std.effects { LensSurfacePending, WorkflowParallelismReport, report_parallelism_unsupported }

fn analyze_parallelism(_d: Dag, _workflow_root: NodeId) -> WorkflowParallelismReport =
  report_parallelism_unsupported(
    LensSurfacePending,
    "lens surface pending match-on-user-sum; use v3_compiler::analyze_parallelism"
  )
