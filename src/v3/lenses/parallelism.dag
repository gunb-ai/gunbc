// lenses.parallelism — Lane 2 Stage 2e parallel composition safety.
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY COMPLETE.
// See docs/v3-lens-capability-register.md.
//
// Port authority: retired hand-Rust Stage 2e bridge (2026-05-12), specifically:
//   - `idempotent_operations_commute`
//   - `first_breaking_across_branches`
//   - `extract_linear_branches`
//   - `pairwise_cross_branch_commutes`
//   - `analyze_parallelism`
//   - `loop_iteration_parallel_emission_indicator`
//
// The breaker witness deliberately uses branch-order flattening, matching the
// retired Rust bridge and `WorkflowEffect::operation_at`.

module lenses.parallelism

import std.list { List, Empty, Cons, empty, cons, concat }
import v3.std.substrate { Dag, NodeId, lane2_workflow_at }
import v3.std.substrate_minimal { NonSingletonList }
import v3.spec.rust { rust_language }
import std.effects {
  EffectShape,
  IdempotentShape,
  KeySource,
  OperationEffect,
  WorkflowEffect,
  WorkflowParallelismReport,
  CompositionVerdict,
  ParallelismUnsupportedKind,
  compose_effects,
  report_parallelism_unsupported
}

type LinearBranchesLookup
  // 🟢 TERMINAL helper coproduct. This is the local, total result of trying to
  // view each parallel branch as `LinearEffect`; dissolving it into
  // `WorkflowParallelismReport` would mix traversal control flow with the
  // public Stage 2e diagnostic contract. The terminal carrier is private to
  // this lens and has exactly one unsupported class (`NonLinearParallelBranch`)
  // at the report boundary.
  = LinearBranchesFound { branches: List<List<OperationEffect>> }
  | NonLinearBranchFound

type NonCommutingPairLookup
  // 🟢 TERMINAL helper coproduct. The operation pair is internal search
  // evidence used only to decide the closed `PairwiseNonCommute` class; the
  // exported report contract remains `ParallelismUnsupportedDetail { kind,
  // downstream_stage, reason }` from `std.effects`. Dissolution into a public
  // pair-evidence payload is intentionally deferred until that report contract
  // grows a typed evidence field instead of overloading the free-text reason.
  = NonCommutingPairFound { left: OperationEffect, right: OperationEffect }
  | AllPairsCommute

fn nsl_to_workflow_list(nsl: NonSingletonList<WorkflowEffect>) -> List<WorkflowEffect> =
  cons(nsl.first, cons(nsl.second, nsl.rest))

fn idempotent_shapes_commute(a: IdempotentShape, b: IdempotentShape) -> Bool =
  match a {
    ReadEffect =>
      match b {
        ReadEffect => true
        UpsertEffect { key_source: _ } => false
        DeleteEffect { key_source: _ } => false
      }
    UpsertEffect { key_source: _ } => false
    DeleteEffect { key_source: ka } =>
      match b {
        ReadEffect => false
        UpsertEffect { key_source: _ } => false
        DeleteEffect { key_source: kb } => key_sources_equal(ka, kb)
      }
  }

fn string_lists_equal(a: List<String>, b: List<String>) -> Bool =
  match a {
    Empty =>
      match b {
        Empty => true
        Cons(_) => false
      }
    Cons(pa) =>
      match b {
        Empty => false
        Cons(pb) =>
          if pa.head == pb.head then
            string_lists_equal(pa.tail, pb.tail)
          else
            false
      }
  }

fn key_sources_equal(a: KeySource, b: KeySource) -> Bool =
  match a {
    PathParam { param: pa } =>
      match b {
        PathParam { param: pb } => pa == pb
        InputField { field: _ } => false
        CompositeKey { fields: _ } => false
      }
    InputField { field: fa } =>
      match b {
        PathParam { param: _ } => false
        InputField { field: fb } => fa == fb
        CompositeKey { fields: _ } => false
      }
    CompositeKey { fields: fa } =>
      match b {
        PathParam { param: _ } => false
        InputField { field: _ } => false
        CompositeKey { fields: fb } => string_lists_equal(fa, fb)
      }
  }

fn operations_commute(a: OperationEffect, b: OperationEffect) -> Bool =
  match a.shape {
    IsIdempotent(ia) =>
      match b.shape {
        IsIdempotent(ib) => idempotent_shapes_commute(ia, ib)
        IsBreaking(_) => false
      }
    IsBreaking(_) => false
  }

fn extract_linear_branches_from_list(
  branches: List<WorkflowEffect>
) -> LinearBranchesLookup =
  match branches {
    Empty => LinearBranchesFound { branches: empty() }
    Cons(payload) =>
      match payload.head {
        LinearEffect { ops: ops } =>
          match extract_linear_branches_from_list(payload.tail) {
            LinearBranchesFound { branches: tail_branches } =>
              LinearBranchesFound { branches: cons(ops, tail_branches) }
            NonLinearBranchFound => NonLinearBranchFound
          }
        BranchEffect { arms: _ } => NonLinearBranchFound
        LoopEffect { body: _ } => NonLinearBranchFound
        ParallelEffect { branches: _ } => NonLinearBranchFound
      }
  }

fn extract_linear_branches(
  branches: NonSingletonList<WorkflowEffect>
) -> LinearBranchesLookup =
  extract_linear_branches_from_list(nsl_to_workflow_list(branches))

fn flatten_branch_ops(branch_ops: List<List<OperationEffect>>) -> List<OperationEffect> =
  match branch_ops {
    Empty => empty()
    Cons(payload) => concat(payload.head, flatten_branch_ops(payload.tail))
  }

fn first_non_commuting_op_in_branch(
  right_branch: List<OperationEffect>,
  left: OperationEffect
) -> NonCommutingPairLookup =
  match right_branch {
    Empty => AllPairsCommute
    Cons(payload) =>
      if operations_commute(left, payload.head) then
        first_non_commuting_op_in_branch(payload.tail, left)
      else
        NonCommutingPairFound { left: left, right: payload.head }
  }

fn first_non_commuting_branch_pair(
  left_branch: List<OperationEffect>,
  right_branch: List<OperationEffect>
) -> NonCommutingPairLookup =
  match left_branch {
    Empty => AllPairsCommute
    Cons(payload) =>
      match first_non_commuting_op_in_branch(right_branch, payload.head) {
        AllPairsCommute => first_non_commuting_branch_pair(payload.tail, right_branch)
        NonCommutingPairFound { left: left, right: right } =>
          NonCommutingPairFound { left: left, right: right }
      }
  }

fn first_non_commuting_against_tail(
  tail_branches: List<List<OperationEffect>>,
  left_branch: List<OperationEffect>
) -> NonCommutingPairLookup =
  match tail_branches {
    Empty => AllPairsCommute
    Cons(payload) =>
      match first_non_commuting_branch_pair(left_branch, payload.head) {
        AllPairsCommute => first_non_commuting_against_tail(payload.tail, left_branch)
        NonCommutingPairFound { left: left, right: right } =>
          NonCommutingPairFound { left: left, right: right }
      }
  }

fn pairwise_cross_branch_commutes(
  branch_ops: List<List<OperationEffect>>
) -> NonCommutingPairLookup =
  match branch_ops {
    Empty => AllPairsCommute
    Cons(payload) =>
      match first_non_commuting_against_tail(payload.tail, payload.head) {
        AllPairsCommute => pairwise_cross_branch_commutes(payload.tail)
        NonCommutingPairFound { left: left, right: right } =>
          NonCommutingPairFound { left: left, right: right }
      }
  }

fn parallelism_report_for_workflow(wf: WorkflowEffect) -> WorkflowParallelismReport =
  match wf {
    ParallelEffect { branches: branches } =>
      match extract_linear_branches(branches) {
        NonLinearBranchFound =>
          report_parallelism_unsupported(
            NonLinearParallelBranch,
            "Stage 2e v1 requires every parallel branch to be `LinearEffect`"
          )
        LinearBranchesFound { branches: branch_ops } =>
          match compose_effects(flatten_branch_ops(branch_ops)) {
            BrokenBy { first_breaker: b } => ParallelCompositionVerdict(BrokenBy { first_breaker: b })
            IdempotentComposition =>
              match pairwise_cross_branch_commutes(branch_ops) {
                AllPairsCommute => ParallelCompositionVerdict(IdempotentComposition)
                NonCommutingPairFound { left: left_op, right: right_op } =>
                  // The pair witnesses stay bound here to prove the search found
                  // concrete non-commuting operations, but Stage 2e's exported
                  // report contract is deliberately the closed kind plus a
                  // stable reason string. Tests lock that contract instead of
                  // formatting operation names into `reason`.
                  report_parallelism_unsupported(
                    PairwiseNonCommute,
                    "parallel branch operations do not commute under parallel scheduling"
                  )
              }
          }
      }
    LinearEffect { ops: _ } =>
      report_parallelism_unsupported(
        NotParallelEffectRoot,
        "parallelism lens analyzes `ParallelEffect` roots only"
      )
    BranchEffect { arms: _ } =>
      report_parallelism_unsupported(
        NotParallelEffectRoot,
        "parallelism lens analyzes `ParallelEffect` roots only"
      )
    LoopEffect { body: _ } =>
      report_parallelism_unsupported(
        NotParallelEffectRoot,
        "parallelism lens analyzes `ParallelEffect` roots only"
      )
  }

fn analyze_parallelism(d: Dag, workflow_root: NodeId) -> WorkflowParallelismReport =
  match lane2_workflow_at(d, workflow_root) {
    None =>
      report_parallelism_unsupported(
        NoWorkflowProjection,
        "no WorkflowEffect projection on this substrate node - analysis reads only `Value`/`Bind` fields set by lowering or `try_register_lane2_workflow_effect`"
      )
    Some(wf) => parallelism_report_for_workflow(wf)
  }

fn read_only_ops(ops: List<OperationEffect>) -> Bool =
  match ops {
    Empty => true
    Cons(payload) =>
      match payload.head.shape {
        IsIdempotent(shape) =>
          match shape {
            ReadEffect => read_only_ops(payload.tail)
            UpsertEffect { key_source: _ } => false
            DeleteEffect { key_source: _ } => false
          }
        IsBreaking(_) => false
      }
  }

fn loop_iteration_parallel_emission_indicator(d: Dag, workflow_root: NodeId) -> Int =
  match lane2_workflow_at(d, workflow_root) {
    None => 0
    Some(wf) =>
      match wf {
        LoopEffect { body: body } =>
          match body {
            LinearEffect { ops: ops } =>
              match ops {
                Empty => 0
                Cons(_) =>
                  if read_only_ops(ops) then 1 else 0
              }
            BranchEffect { arms: _ } => 0
            LoopEffect { body: _ } => 0
            ParallelEffect { branches: _ } => 0
          }
        LinearEffect { ops: _ } => 0
        BranchEffect { arms: _ } => 0
        ParallelEffect { branches: _ } => 0
      }
  }
