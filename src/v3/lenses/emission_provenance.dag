// lenses.emission_provenance — `Lens<List<EmissionProvenance>>` instance.
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY DEFERRED.
// (Same staging shape as `lenses.cost` STRUCTURALLY TERMINAL /
// BEHAVIORALLY PROXY and `lenses.dag_shape` producer-only.)
//
// Per Director Q1 (a) RATIFIED at gunbc#1739 #issuecomment-4392562911,
// emission-provenance is a Lens<C>-shaped per-Behavior analysis whose
// per-Behavior `List<EmissionProvenance>` flattens to a per-line view at
// the visualization layer. Per-line instrumentation (Q1 b) and parallel
// substrates (Q1 d) were rejected; (a) per-Behavior is the substrate.
//
// **Behavioral attribution wiring is deferred.** Producing real
// `EmissionProvenance` entries from a `Behavior` requires the emitter
// to record which `*SyntaxBinding` / `*OpsBinding` field-path fired
// for each emitted line — instrumentation hooks in
// `src/v3/compiler/src/emit/rust_target.rs`'s `render_named_template`
// call sites. That code-side work is a separate downstream slice
// (precedent: `lenses.cost` BEHAVIORALLY PROXY). This file authors
// the structural lens shape so the carrier + lens declaration are
// landed and consumable; the `read` body is a fail-closed `Empty`
// stub until producer wiring lands.
//
// **Bundled-scope discipline** per Director ratification at
// gunbc#1739 #issuecomment-4392225548: Grounding-side visualization
// consumer wiring is NOT bundled here.

module lenses.emission_provenance

import std.list { List, Empty, concat }
import std.algebra { Monoid }
import std.substrate { Dag, Behavior, LoopBound }
import v3.std.dimensions { Witness, OptionalDiagnostic }
import v3.std.lens { Lens }
import v3.std.emission_provenance { EmissionProvenance }

// Per-Behavior provenance read.
//
// 🟡 STUB. Returns `Inhabits(Empty)` — every Behavior contributes an
// empty provenance list. Producer wiring (instrumenting
// `render_named_template` call sites in `rust_target.rs` to record
// rule-fired-at-line per Behavior) is a separate downstream slice.
//
// `Inhabits(Empty)` is fail-closed at the structural-shape level: an
// honest "no provenance attribution authored yet" rather than a
// fabricated entry. When producer wiring lands, this body lifts to a
// real per-Behavior fold without changing the lens declaration shape.
fn read_provenance(d: Dag, b: Behavior) -> Witness<List<EmissionProvenance>> =
  Inhabits(Empty)

// Sequential composition: list concatenation (the canonical free-monoid
// op for `List<T>`). `BindNode` cost-basis aggregates left-to-right.
fn concat_provenance(
  a: List<EmissionProvenance>,
  b: List<EmissionProvenance>
) -> List<EmissionProvenance> =
  concat(a, b)

// Branch composition: concat over both arms. Per the Lens<C> framework
// note on `branch` — static-emission analysis captures both branches;
// runtime exclusivity is orthogonal to static-emission tracking. Both
// branches' emitted lines belong to the program's emission surface.
fn branch_provenance(
  left: List<EmissionProvenance>,
  right: List<EmissionProvenance>
) -> List<EmissionProvenance> =
  concat(left, right)

// Iteration composition: identity. Loop bodies are emitted once
// (the LoopBound is data, not source); iterating the body's
// emission lines doesn't multiply emitted-line count. Worker confirmed
// by reading `render_loop` at `rust_target.rs:4782` — the body is
// emitted once per `LoopNode`, not per iteration.
fn iterate_provenance(
  c: List<EmissionProvenance>,
  bound: LoopBound
) -> List<EmissionProvenance> =
  c

// Aggregate validation. Record form makes "rule absent" structurally
// impossible; `OptionalSourceSpan::NoSourceSpan` is structurally legal
// and NOT a diagnostic. Worker greps producer-side at PR-author time:
// no rule field-path that doesn't resolve to a real `*SyntaxBinding` /
// `*OpsBinding` field at HEAD should be authored. (When real producer
// wiring lands, this validate body lifts to round-trip the field-path
// against the structural addressing surface.)
//
// **Stringly-typed defense** — `EmissionRule = String` is by-design per
// Director Q3 `feedback_reason_not_label` (substrate carries structural
// truth via field-path; nominal aliases are display-layer derived) but
// the type can't enforce well-formed field-paths. When producer wiring
// lands, this validate body assumes the field-path-resolves-to-real-field
// defense (round-trip against the `*SyntaxBinding` / `*OpsBinding`
// field set at HEAD); malformed paths surface as aggregate diagnostic.
fn validate_provenance(d: Dag, c: List<EmissionProvenance>) -> OptionalDiagnostic =
  NoDiagnostic

// 🟡 SCAFFOLD — the `data emission_provenance_lens: Lens<List<EmissionProvenance>>`
// instance declaration is authored as a TEST FIXTURE (see
// `src/v3/compiler/tests/integration/emission_provenance_lens_test.rs`)
// rather than as a top-level `data` item here, matching the
// `named_function_count.dag` / `dag_shape.dag` precedent: lens .dag
// files in `src/v3/lenses/` declare the structural fns and types; the
// `data <name>_lens: Lens<C>` instance is bound in a fixture context
// (compare `e6_g1a_option3_static_lens_test.rs::mini_lens`).
//
// **Substrate-gap receipt** — promoting the instance to a top-level
// `data` declaration here is currently blocked by Class 5 Gap 3
// (top-level `ValueBody` boundary at `src/v3/compiler/src/dag.rs:259-287`).
// Two facets of the same gap surface depending on how the lens monoid
// `identity` field is encoded:
//   1. Bare sum-variant literal (`identity: Empty`) — fails because
//      sum-variant literals don't lower in `data` body context.
//   2. Nested-fn reference (`identity: empty_provenance_list`) —
//      fails because the data body is rejected as opaque (the
//      lowerer can't structurally validate a fn-typed value in a
//      `data` body field).
// Both reduce to the same root: `data` bodies don't accept top-level
// non-scalar / non-record carriers. The same constraint blocks the
// canonical generic `data list_monoid<element>: Monoid<List<element>>`
// declaration documented at `src/v3/std/list.dag:61-64`. Dissolution
// trigger: when Class 5 Gap 3 closes for *both* facets (top-level
// `List` / sum-variant `ValueBody` carriers land AND fn-typed fields
// in `data` bodies validate structurally), the instance promotes from
// fixture-bound to top-level `data` here without lens-shape changes.
// If only one facet closes first, this comment block updates accordingly.
