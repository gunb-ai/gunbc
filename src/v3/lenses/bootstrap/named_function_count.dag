// lenses.named_function_count — minimal user-authored lens (Day-1 gate fixture).
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY N/A.
// See docs/v3-lens-capability-register.md.
//
// Lives under `lenses/bootstrap/` so `build.rs` enumerates it into
// `LENS_BOOTSTRAP_FILES` (no `include_str!` in `bootstrap.rs`). Demo only:
// counts `Bind` behaviors whose `name` is non-empty. Not in `regen.dag`.

module lenses.named_function_count

import std.list { fold }
import std.substrate { Dag, Behavior }

fn count_named_bind(behavior: Behavior) -> Int =
  match behavior {
    Value(v) => 0
    Transform(t) => 0
    Branch(b) => 0
    Loop(l) => 0
    Bind(bind) => if bind.name == "" then 0 else 1
  }

fn named_function_count(d: Dag) -> Int =
  fold(d.nodes, 0, |acc, behavior| acc + count_named_bind(behavior))
