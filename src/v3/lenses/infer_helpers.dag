// SG-4b-1 prototype tranche — bounded Cat-1/Cat-2 infer helpers.
//
// This prototype deliberately stops short of the refinement/discharge
// readers. The existing reflected `BindNode` carrier does not expose
// the predicate body port that `predicate_info` needs, so the helper
// path cannot move that slice honestly without substrate work.
//
// It also leaves `walk_to_optional_cardinality_decl`,
// `callable_template_arguments`, `is_retryable_generic_decl_walk`, and
// `declaration_is_callable` in Rust for now: the current reflected
// helper surface does not expose the canonical total
// `Dag::declaration(id)` accessor, so the first two cannot move
// honestly without parallel lookup authority, and the current lens path
// cannot yet express the former's termination proof. `infer.rs`
// remains authoritative for those remainders.

module lenses.infer_helpers

import std.list { List }
import std.substrate {
  Behavior, BranchPath, BranchPattern, DeclarationId, SourceSpan,
  TemplateArgument
}

type TemplateArgumentLookup
  = MissingTemplateArgument
  | FoundTemplateArgument(DeclarationId)

// SG-4b-3 template-argument reconciliation tranche — still pure
// Cat-2 list mechanics, but now covering the real equality/update
// helpers that `infer.rs` uses while resolving callable targets.
type TemplateArgumentBinding
  = TemplateArgumentBindingConflict
  | TemplateArgumentsBound(List<TemplateArgument>)

fn behavior_output_port(behavior: Behavior) -> PortId =
  match behavior {
    Value(v) => v.result_port
    Transform(t) => t.result_port
    Branch(b) => b.result_port
    Loop(l) => l.result_port
    Bind(bind) => bind.result_port
  }

// SG-4b-2 span-utility tranche — structurally twin to
// `behavior_output_port`; reads the reflected `span` field that every
// `Behavior` variant already carries on the substrate.
fn behavior_span(behavior: Behavior) -> SourceSpan =
  match behavior {
    Value(v) => v.span
    Transform(t) => t.span
    Branch(b) => b.span
    Loop(l) => l.span
    Bind(bind) => bind.span
  }

// Pure match over reflected `BranchPattern`; total — the
// `branch_span` fallback covers the resolved-variant case.
fn payload_binding_span(
  path: BranchPath,
  branch_span: SourceSpan
) -> SourceSpan =
  match path.pattern {
    UnresolvedVariant(u) => u.span
    ResolvedVariant(_) => branch_span
  }

fn template_argument_value(
  arguments: List<TemplateArgument>,
  parameter: DeclarationId
) -> TemplateArgumentLookup =
  match arguments {
    Empty => MissingTemplateArgument
    Cons(payload) =>
      if payload.head.parameter == parameter then
        FoundTemplateArgument(payload.head.value)
      else
        template_argument_value(payload.tail, parameter)
  }

fn resolve_template_argument_value(
  remaining: Int,
  arguments: List<TemplateArgument>,
  current: DeclarationId
) -> DeclarationId =
  if remaining <= 0 then
    current
  else
    match template_argument_value(arguments, current) {
      MissingTemplateArgument => current
      FoundTemplateArgument(next) =>
        if next == current then
          current
        else
          resolve_template_argument_value(remaining - 1, arguments, next)
    }

fn template_arguments_match(
  lhs: List<TemplateArgument>,
  rhs: List<TemplateArgument>
) -> Bool =
  match lhs {
    Empty =>
      match rhs {
        Empty => true
        Cons(_) => false
      }
    Cons(left_payload) =>
      match rhs {
        Empty => false
        Cons(right_payload) =>
          if left_payload.head.parameter == right_payload.head.parameter then
            if left_payload.head.value == right_payload.head.value then
              template_arguments_match(left_payload.tail, right_payload.tail)
            else
              false
          else
            false
      }
  }

fn push_template_argument_binding(
  arguments: List<TemplateArgument>,
  parameter: DeclarationId,
  value: DeclarationId
) -> TemplateArgumentBinding =
  match arguments {
    Empty =>
      TemplateArgumentsBound(cons({ parameter: parameter, value: value }, empty()))
    Cons(payload) =>
      if payload.head.parameter == parameter then
        if payload.head.value == parameter then
          TemplateArgumentsBound(
            cons(
              {
                parameter: payload.head.parameter
                value: value
              },
              payload.tail
            )
          )
        else
          if payload.head.value == value then
            TemplateArgumentsBound(arguments)
          else
            TemplateArgumentBindingConflict
      else
        match push_template_argument_binding(payload.tail, parameter, value) {
          TemplateArgumentBindingConflict => TemplateArgumentBindingConflict
          TemplateArgumentsBound(updated_tail) =>
            TemplateArgumentsBound(cons(payload.head, updated_tail))
        }
  }
