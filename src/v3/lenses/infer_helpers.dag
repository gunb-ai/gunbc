// SG-4b-1 prototype tranche — bounded Cat-1/Cat-2 infer helpers.
//
// Status: STRUCTURALLY PARTIAL; BEHAVIORALLY N/A (intentionally bounded prototype).
// See docs/v3-lens-capability-register.md.
//
// This prototype deliberately stops short of the refinement/discharge
// readers. The existing reflected `BindNode` carrier does not expose
// the predicate body port that `predicate_info` needs, so the helper
// path cannot move that slice honestly without substrate work.
//
// It also leaves `walk_to_optional_cardinality_decl`,
// `callable_template_arguments`, `is_retryable_generic_decl_walk`, and
// `declaration_is_callable` in Rust for now: the current reflected
// helper surface does not expose the canonical total
// `Dag::declaration(id)` accessor, so the first two cannot move
// honestly without parallel lookup authority, and the current lens
// path cannot yet express the third's termination proof. `infer.rs`
// remains authoritative for those remainders.
//
// SG-4b-4 moves `template_arguments_match` as a bounded Cat-2 cluster.
// The lens->Rust emitter still shadows nested `Cons` pattern bindings,
// so the function is factored into three single-match helpers that
// never nest list matches — each function inspects at most one
// `List<TemplateArgument>` via `match`, with the other side passed as
// already-destructured components.
//
// SG-4b-5 moves `filter_non_self_template_arguments` — the DB-16
// self-binding strip (`parameter == value`) used when normalizing
// `Instantiation` argument lists for structural comparison. `infer.rs`
// keeps the `TypeConnective::Instantiation` unwrap; this helper is
// pure list mechanics only.

module lenses.infer_helpers

import std.list { List, empty, cons }
import std.substrate {
  Behavior, BranchPath, BranchPattern, DeclarationId, SourceSpan,
  TemplateArgument
}

type TemplateArgumentLookup
  = MissingTemplateArgument
  | FoundTemplateArgument(DeclarationId)

// SG-4b-3 template-argument reconciliation tranche — still pure
// Cat-2 list mechanics, but now covering the real equality/update
// helpers that `infer.rs` uses while resolving callable targets.
type TemplateArgumentBinding
  = Conflict
  | NoOp
  | Append
  | ReplaceAt(Int, DeclarationId)

// SG-4b-4 template-argument match result. Pure pairwise equality over
// two `List<TemplateArgument>`s; mirrors the existing decision-enum
// pattern (`TemplateArgumentLookup`, `TemplateArgumentBinding`) so the
// helper avoids a `Bool` return while the lens->Rust emitter's Bool
// mapping is still untested.
//
// Classification: 🟡 workaround-shaped coproduct (§modeling-discipline
// coproduct-dissolution ratchet). This is a `Bool` spelled as a
// 2-variant coproduct; the only reason it is not written as `Bool` is
// that the lens->Rust emitter does not yet have a tested `Bool`
// mapping for helper returns.
//
// Dissolution trigger: the lens->Rust emitter lands a verified `Bool`
// mapping (paired with updated `TemplateArgumentLookup` /
// `TemplateArgumentBinding` decision helpers so all four dissolve
// together). At that point every call site collapses to a direct
// `Bool` return and this type deletes.
type TemplateArgumentsMatch
  = Match
  | Mismatch

// Non-recursive rhs-cursor used to destructure the second list without
// a second `match` over `List`, avoiding the lens->Rust emitter's
// nested-`Cons`-binding shadow. Pure projection.
//
// Classification: 🟡 workaround-shaped coproduct. `CursorEnd` /
// `CursorHead` duplicates `List`'s own `Empty` / `Cons` shape; it
// exists solely because two stacked `match` expressions over `List`
// produce shadowed `__list_head` / `__list_tail` bindings in generated
// Rust.
//
// Dissolution trigger: the lens->Rust emitter scopes `Cons` pattern
// bindings uniquely per nested match (no name-clash shadowing). At
// that point `template_arguments_match` inlines the second `match`
// over `rhs` directly and this type, plus `template_argument_cursor`,
// deletes.
type TemplateArgumentCursor
  = CursorEnd
  | CursorHead { head: TemplateArgument, tail: List<TemplateArgument> }

fn behavior_output_port(behavior: Behavior) -> PortId =
  match behavior {
    Value(v) => v.result_port
    Transform(t) => t.result_port
    Branch(b) => b.result_port
    Loop(l) => l.result_port
    Bind(bind) => bind.result_port
  }

// SG-4b-2 span-utility tranche — structurally twin to
// `behavior_output_port`; reads the reflected `span` field that every
// `Behavior` variant already carries on the substrate.
fn behavior_span(behavior: Behavior) -> SourceSpan =
  match behavior {
    Value(v) => v.span
    Transform(t) => t.span
    Branch(b) => b.span
    Loop(l) => l.span
    Bind(bind) => bind.span
  }

// Pure match over reflected `BranchPattern`; total — the
// `branch_span` fallback covers the resolved-variant case.
fn payload_binding_span(
  path: BranchPath,
  branch_span: SourceSpan
) -> SourceSpan =
  match path.pattern {
    UnresolvedVariant(u) => u.span
    ResolvedVariant(_) => branch_span
  }

fn template_argument_value(
  arguments: List<TemplateArgument>,
  parameter: DeclarationId
) -> TemplateArgumentLookup =
  match arguments {
    Empty => MissingTemplateArgument
    Cons(payload) =>
      if payload.head.parameter == parameter then
        FoundTemplateArgument(payload.head.value)
      else
        template_argument_value(payload.tail, parameter)
  }

fn resolve_template_argument_value(
  remaining: Int,
  arguments: List<TemplateArgument>,
  current: DeclarationId
) -> DeclarationId =
  if remaining <= 0 then
    current
  else
    match template_argument_value(arguments, current) {
      MissingTemplateArgument => current
      FoundTemplateArgument(next) =>
        if next == current then
          current
        else
          resolve_template_argument_value(remaining - 1, arguments, next)
    }

fn push_template_argument_binding(
  arguments: List<TemplateArgument>,
  parameter: DeclarationId,
  value: DeclarationId
) -> TemplateArgumentBinding =
  push_template_argument_binding_at(arguments, parameter, value, 0)

fn push_template_argument_binding_at(
  arguments: List<TemplateArgument>,
  parameter: DeclarationId,
  value: DeclarationId,
  index: Int
) -> TemplateArgumentBinding =
  match arguments {
    Empty => Append
    Cons(payload) =>
      if payload.head.parameter == parameter then
        if payload.head.value == parameter then
          ReplaceAt(index, value)
        else
          if payload.head.value == value then
            NoOp
          else
            Conflict
      else
        push_template_argument_binding_at(payload.tail, parameter, value, index + 1)
  }

// Pairwise equality over two `List<TemplateArgument>`. The sole
// recursive function is `template_arguments_match`, which matches on
// `lhs` and recurses on its structurally-smaller tail. The second
// list is inspected via the non-recursive `template_argument_cursor`
// helper, so the emitted Rust never contains a `match` over one list
// nested inside a `match` over another list (the known lens->Rust
// emitter shadowing bug).
fn template_arguments_match(
  lhs: List<TemplateArgument>,
  rhs: List<TemplateArgument>
) -> TemplateArgumentsMatch =
  match lhs {
    Empty => template_arguments_rhs_empty(rhs)
    Cons(lp) =>
      match template_argument_cursor(rhs) {
        CursorEnd => Mismatch
        CursorHead(cur) =>
          if lp.head.parameter == cur.head.parameter then
            if lp.head.value == cur.head.value then
              template_arguments_match(lp.tail, cur.tail)
            else
              Mismatch
          else
            Mismatch
      }
  }

fn template_arguments_rhs_empty(
  rhs: List<TemplateArgument>
) -> TemplateArgumentsMatch =
  match rhs {
    Empty => Match
    Cons(_) => Mismatch
  }

fn template_argument_cursor(
  xs: List<TemplateArgument>
) -> TemplateArgumentCursor =
  match xs {
    Empty => CursorEnd
    Cons(p) => CursorHead { head: p.head, tail: p.tail }
  }

// Strip only self-bindings (`parameter == value`). See DB-16 / `infer.rs`
// `normalized_instantiation_args` — non-self bindings must survive.
// List construction uses `empty`/`cons` (std.list API) so both branches
// agree on `List<TemplateArgument>`; raw `Empty`/`Cons` mixed with
// `cons` tripped the v3 typechecker on this surface in SG-4b-5.
fn filter_non_self_template_arguments(
  arguments: List<TemplateArgument>
) -> List<TemplateArgument> =
  match arguments {
    Empty => empty()
    Cons(payload) =>
      if payload.head.parameter == payload.head.value then
        filter_non_self_template_arguments(payload.tail)
      else
        cons(payload.head, filter_non_self_template_arguments(payload.tail))
  }
