// lenses.cost_target_realization — `.dag`-tier consumer of the
// `declaration_by_name` substrate accessor introduced by Slice 1a.0
// (PR #2194 merged at commit 633f83854; T-CostLens-Composition follow-on
// per gunb-ai/gunbc#2141 ε ratification at gunbc#2181 #issuecomment-4401584012).
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY N/A
//   (v3-native; ε path consumer-evidence-only — not a v2 mirror. The
//   six per-category meta-type resolvers are pure single-call delegations
//   to `declaration_by_name`, fail-closed at the substrate-Option boundary.
//   See `docs/v3-lens-capability-register.md` cost_target_realization.dag row.)
//
// **Slice 1a.1 (minimum-viable consumer-proof)**: provides `.dag`-tier
// fns that acquire the substrate meta-type `DeclarationId`s needed for
// per-target realization-cost extraction. Mechanically demonstrates the
// `declaration_by_name(d, "TypeRealization")` etc. access pattern at
// `.dag`-tier — closes Slice 1a.0's same-PR-consumer-evidence gap per
// INVARIANTS P2 (codex BLOCKING surfaced post-merge at PR #2194
// #issuecomment-4404079935).
//
// **Slice 1a.1b (gate #37 ε-slice)**: `realization_row_cost_int` /
// `declaration_realization_cost_by_name` read the authoritative `cost: Int`
// field from lowered `ValueBodyStructural` realization rows (`emit_model.dag`
// + `spec/{lang}.dag`). Emit-time / `LanguageSpec`-indexed tables remain
// follow-on (gates #40 / #70); this is the declared substrate query surface
// for per-row cost facts, regenerated to `lens_cost_target_realization_generated.rs`.
//
// **Out of scope** (later sub-slices): `d.declarations` fold +
// `meta_tag`-filtering table build (Slice 1a.2+).
//
// **ε factoring** (per `docs/proposals/q-cost-composition-layering-canvas.md`):
//   - Layer 1 (target-agnostic abstract shape): `SymbolicCost` algebra at
//     `src/v3/std/algebra.dag:181-188`; produced by `cost.dag`.
//   - Layer 2 (language-agnostic per-primitive realization-cost facts):
//     `data X: TypeRealization = { ..., cost: Int }` rows in `spec/{lang}.dag`.
//   - Layer 3 (per-target concrete-cost composition): this lane (Slices
//     1a.1 → 1a.2 → 1a.3) at `.dag`-tier.

module lenses.cost_target_realization

import std.types { Int }
import std.list { List, fold }
import std.substrate {
  Dag, Declaration, FieldEntry, FieldValue, LiteralBits, ValueBody, declaration_by_name
}

// Acquire the `DeclarationId` of the `TypeRealization` meta-type by
// name. The returned `Declaration?` carries the meta-type's full
// declaration when known; `None` indicates the substrate doesn't
// declare `TypeRealization` (a substrate-integrity violation a
// downstream consumer treats as fail-closed).
fn type_realization_meta(d: Dag) -> Declaration? =
  declaration_by_name(d, "TypeRealization")

// Same shape for `CallableRealization`; mirror per-category.
fn callable_realization_meta(d: Dag) -> Declaration? =
  declaration_by_name(d, "CallableRealization")

// Same shape for `OperatorRealization`.
fn operator_realization_meta(d: Dag) -> Declaration? =
  declaration_by_name(d, "OperatorRealization")

// Same shape for `BehaviorRealization`.
fn behavior_realization_meta(d: Dag) -> Declaration? =
  declaration_by_name(d, "BehaviorRealization")

// Same shape for `TypeInstantiationRealization`.
fn type_instantiation_realization_meta(d: Dag) -> Declaration? =
  declaration_by_name(d, "TypeInstantiationRealization")

// Same shape for `PatternRealization`.
fn pattern_realization_meta(d: Dag) -> Declaration? =
  declaration_by_name(d, "PatternRealization")

// ── Per-row `cost: Int` on lowered realization data bodies ───────────────

fn literal_bits_as_cost_int(bits: LiteralBits) -> Int? =
  match bits {
    LitInt(n) => Some { value: n }
    LitBool(b) => none
    LitString(s) => none
  }

fn field_value_as_realization_cost_int(v: FieldValue) -> Int? =
  match v {
    Literal(bits) => literal_bits_as_cost_int(bits)
    Reference(r) => none
    Record(rec) => none
    List(xs) => none
    Map(m) => none
    Variant { constructor: c, payload: p } => none
  }

fn cost_int_from_field_entries(entries: List<FieldEntry>) -> Int? =
  fold(entries, none, |acc, entry|
    match acc {
      Some { value: found } => acc
      None =>
        if entry.label == "cost" then field_value_as_realization_cost_int(entry.value)
        else none
    }
  )

fn realization_row_cost_from_value_body(body: ValueBody) -> Int? =
  match body {
    ValueBodyUnparsed(span) => none
    ValueBodyStructural { fields: f } => cost_int_from_field_entries(f)
    ValueBodyScalar(bits) => none
    ValueBodyList(xs) => none
    ValueBodyMap(entries) => none
  }

// Fail-closed `none` when missing / non-structural / no `cost` Int literal.
fn realization_row_cost_int(decl: Declaration) -> Int? =
  match decl.value_body {
    None => none
    Some(body) => realization_row_cost_from_value_body(body)
  }

fn declaration_realization_cost_by_name(d: Dag, row_name: String) -> Int? =
  match declaration_by_name(d, row_name) {
    None => none
    Some(decl) => realization_row_cost_int(decl)
  }
