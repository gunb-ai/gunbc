// lenses.complexity — structural cost lens for the v3 DAG.
//
// 🟢 TERMINAL. Forward fold over `d.nodes` builds a per-port cost
// entry list. The substrate invariant that producers precede
// consumers in `d.nodes` makes this a pure catamorphism — no fuel,
// no mutual recursion, no manual termination measure. Structural
// termination: `fold` drives the walk on the finite list `d.nodes`.
//
// **Equivalent to the original Rust lens** at
// `src/v3/compiler/src/lens_cost.rs` on commit 1247f4b1d, which
// walked `produced_by` recursively. That oracle encodes the same
// algebra; this forward-fold is the substrate-native rewriting
// that exchanges recursive graph descent for sequential map build.

module lenses.complexity

import std.list { List, empty, fold, cons }
import std.substrate { Dag, DagPort, Behavior, BranchPath, NodeId, PortId }

type CostEntry {
  port: PortId
  cost: Int
}

type CostLookup
  = MissingCost
  | FoundCost(Int)

fn cost_of(d: Dag, port_id: PortId) -> Int =
  lookup_int(compute_costs(d), port_id)

fn compute_costs(d: Dag) -> List<CostEntry> =
  fold(d.nodes, empty(), |acc, behavior|
    cons(entry_for(acc, behavior), acc)
  )

fn entry_for(acc: List<CostEntry>, behavior: Behavior) -> CostEntry =
  match behavior {
    Value(v) => { port: v.result_port, cost: 0 }
    Transform(t) =>
      {
        port: t.result_port
        cost: 1 + sum_costs(acc, t.inputs)
      }
    Branch(b) =>
      {
        port: b.result_port
        cost: 1 + lookup_int(acc, b.input) + max_path_cost(acc, b.paths)
      }
    Loop(l) =>
      {
        port: l.result_port
        cost:
          1
          + lookup_int(acc, l.source)
          + lookup_int(acc, l.init)
      }
    Bind(bind) =>
      {
        port: bind.result_port
        cost: lookup_int(acc, bind.result_port)
      }
  }

fn sum_costs(acc: List<CostEntry>, ports: List<PortId>) -> Int =
  fold(ports, 0, |sum, port| sum + lookup_int(acc, port))

fn max_path_cost(acc: List<CostEntry>, paths: List<BranchPath>) -> Int =
  fold(paths, 0, |best, path| max_int(best, lookup_int(acc, path.result_port)))

fn lookup_int(acc: List<CostEntry>, port_id: PortId) -> Int =
  match lookup_cost(acc, port_id) {
    MissingCost => 0
    FoundCost(c) => c
  }

fn lookup_cost(acc: List<CostEntry>, port_id: PortId) -> CostLookup =
  match acc {
    Empty => MissingCost
    Cons(payload) =>
      if payload.head.port == port_id then
        FoundCost(payload.head.cost)
      else
        lookup_cost(payload.tail, port_id)
  }

fn max_int(left: Int, right: Int) -> Int =
  if left > right then left else right
