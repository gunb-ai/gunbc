// lenses.complexity — behavioral complexity summary lens for the v3 DAG.
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY COMPLETE.
// See docs/design-complexity-lens-behavioral-completeness.md and
// docs/v3-lens-capability-register.md.
//
// Forward fold over `d.nodes` builds a per-port `ComplexitySummary`
// map. The substrate invariant that producers precede consumers in
// `d.nodes` makes this a pure catamorphism; the old structural-depth
// proxy is dissolved into the richer carrier below:
//   - symbolic work and span costs (`SymbolicCost`)
//   - asymptotic classification (`AsymptoticClass`)
//   - per-coordinate certainty (`work_certainty`, `span_certainty`)
//
// Work/span dimensions are the two `AnalysisDimension<SymbolicCost>`
// instances named by the design. Class-5 record-valued `data` bodies
// still gate executable declarations for `work_dimension` and
// `span_dimension`, so this file keeps the executable authority in
// the lens fold and names the dissolution trigger in the receipt
// comments instead of inventing a parallel dimension registry.
//
// Shared carrier: `v3.std.lookup.Lookup`.

module lenses.complexity

import std.list { List, empty, fold, cons, concat }
import std.substrate { Dag, Behavior, BranchPath, LoopNode, LoopBound, NodeId, PortId, node }
import std.algebra {
  SymbolicCost,
  AsymptoticClass,
  Monoid,
  unnamed_size_variable,
  classify_symbolic_cost,
  asymptotic_dominates,
  dominates,
  sequential,
  iterate,
  max_path,
  ConstantCost,
  LinearCost,
  PolynomialCost,
  ProductCost,
  SumCost,
  LogCost,
  UnknownCost
}
import std.computation {
  CallPattern,
  ArithmeticSubtractCall,
  ArithmeticDivideCall,
  ChildAccessorCall,
  CollectionShrinkCall,
  FoldBodyCall,
  ParserAdvanceCall,
  WorklistDrainCall,
  SameArgumentCall,
  per_call_pattern_at
}
import v3.std.lookup { Lookup }
import v3.std.dimensions { Witness, OptionalDiagnostic }
import v3.std.lens { Lens }
import v3.std.lens_application { LensEnforcement, EnforceableLens, EnforcedApplication }

// Certainty: how tight is the bound?
// Proven means the bound is exact for that coordinate; Conservative means it
// is a sound upper bound that may be loose. There is intentionally no
// BoundedLattice<Certainty>; certainty composes with cost dominance at the
// ComplexitySummary level.
type Certainty = Proven | Conservative

type ComplexitySummary {
  work: SymbolicCost
  span: SymbolicCost
  asymptotic_class: AsymptoticClass
  work_certainty: Certainty
  span_certainty: Certainty
}

type ComplexityEntry {
  port: PortId
  summary: Lookup<ComplexitySummary>
}

type DominanceOutcome
  = BothSurvive
  | OuterDominates
  | BodyDominates

fn miss_complexity_summary_lookup() -> Lookup<ComplexitySummary> =
  Miss

fn hit_complexity_summary_lookup(summary: ComplexitySummary) -> Lookup<ComplexitySummary> =
  Hit(summary)

fn complexity_of(d: Dag, port_id: PortId) -> Lookup<ComplexitySummary> =
  lookup_summary(compute_summaries(d), port_id)

fn compute_summaries(d: Dag) -> List<ComplexityEntry> =
  fold(d.nodes, seed_bind_params(d.nodes), |acc, behavior|
    cons(entry_for(d, acc, behavior), acc)
  )

fn seed_bind_params(nodes: List<Behavior>) -> List<ComplexityEntry> =
  fold(nodes, empty(), |acc, behavior|
    concat(params_of(behavior), acc)
  )

fn params_of(behavior: Behavior) -> List<ComplexityEntry> =
  match behavior {
    Value(v) => empty()
    Transform(t) => empty()
    Branch(b) => empty()
    Loop(l) => empty()
    Bind(bind) => param_entries(bind.params)
  }

fn param_entries(params: List<PortId>) -> List<ComplexityEntry> =
  match params {
    Empty => empty()
    Cons(payload) =>
      cons(
        { port: payload.head, summary: hit_complexity_summary_lookup(zero_summary()) },
        param_entries(payload.tail)
      )
  }

fn zero_summary() -> ComplexitySummary =
  summary_from_costs(ConstantCost(0), ConstantCost(0), Proven, Proven)

fn unit_summary() -> ComplexitySummary =
  summary_from_costs(ConstantCost(1), ConstantCost(1), Proven, Proven)

fn conservative_unknown_summary(reason: String) -> ComplexitySummary =
  summary_from_costs(UnknownCost(reason), UnknownCost(reason), Conservative, Conservative)

fn summary_from_costs(
  work: SymbolicCost,
  span: SymbolicCost,
  work_certainty: Certainty,
  span_certainty: Certainty
) -> ComplexitySummary =
  {
    work: work
    span: span
    asymptotic_class: classify_symbolic_cost(work)
    work_certainty: work_certainty
    span_certainty: span_certainty
  }

fn entry_for(
  d: Dag,
  acc: List<ComplexityEntry>,
  behavior: Behavior
) -> ComplexityEntry =
  match behavior {
    Value(v) =>
      { port: v.result_port, summary: hit_complexity_summary_lookup(zero_summary()) }
    Transform(t) =>
      { port: t.result_port, summary: transform_summary(d, acc, t.id, t.inputs) }
    Branch(b) =>
      { port: b.result_port, summary: branch_summary(acc, b.input, b.paths) }
    Loop(l) =>
      { port: l.result_port, summary: loop_summary(d, acc, l) }
    Bind(bind) =>
      { port: bind.result_port, summary: lookup_summary(acc, bind.result_port) }
  }

fn transform_summary(
  d: Dag,
  acc: List<ComplexityEntry>,
  call_site: NodeId,
  inputs: List<PortId>
) -> Lookup<ComplexitySummary> =
  match per_call_pattern_at(d, call_site) {
    None => compose_many_inputs(acc, inputs)
    Some(pattern) =>
      recursive_transform_summary(acc, pattern, inputs)
  }

fn compose_many_inputs(
  acc: List<ComplexityEntry>,
  ports: List<PortId>
) -> Lookup<ComplexitySummary> =
  fold(ports, hit_complexity_summary_lookup(unit_summary()), |running, port_id|
    combine_sequential(running, lookup_summary(acc, port_id))
  )

fn recursive_transform_summary(
  acc: List<ComplexityEntry>,
  pattern: CallPattern,
  inputs: List<PortId>
) -> Lookup<ComplexitySummary> =
  match inputs {
    Empty => miss_complexity_summary_lookup()
    Cons(payload) =>
      combine_iterate(
        summary_from_iter_bound(pattern_to_iter_bound(pattern, payload.head)),
        compose_many_inputs(acc, inputs)
      )
  }

fn pattern_to_iter_bound(pattern: CallPattern, arg_port: PortId) -> SymbolicCost =
  match pattern {
    ArithmeticSubtractCall { steps: steps, ring_param: ring_param } =>
      LinearCost(unnamed_size_variable(arg_port))
    ArithmeticDivideCall { divisor: divisor , ring_param: ring_param } =>
      LogCost(unnamed_size_variable(arg_port))
    ChildAccessorCall { accessor: accessor } =>
      LinearCost(unnamed_size_variable(arg_port))
    CollectionShrinkCall { amount: amount, collection: collection } =>
      LinearCost(unnamed_size_variable(arg_port))
    FoldBodyCall { outer_collection: outer_collection } =>
      LinearCost(unnamed_size_variable(arg_port))
    ParserAdvanceCall { witness: witness } =>
      LinearCost(unnamed_size_variable(arg_port))
    WorklistDrainCall { element: element } =>
      LinearCost(unnamed_size_variable(arg_port))
    SameArgumentCall =>
      UnknownCost("same-argument recursive call has no descent")
  }

fn summary_from_iter_bound(bound: SymbolicCost) -> Lookup<ComplexitySummary> =
  match bound {
    UnknownCost(reason) =>
      hit_complexity_summary_lookup(conservative_unknown_summary(reason))
    ConstantCost(_) =>
      hit_complexity_summary_lookup(summary_from_costs(bound, bound, Proven, Proven))
    LinearCost(_) =>
      hit_complexity_summary_lookup(summary_from_costs(bound, bound, Proven, Proven))
    PolynomialCost(_) =>
      hit_complexity_summary_lookup(summary_from_costs(bound, bound, Proven, Proven))
    ProductCost(_) =>
      hit_complexity_summary_lookup(summary_from_costs(bound, bound, Proven, Proven))
    SumCost(_) =>
      hit_complexity_summary_lookup(summary_from_costs(bound, bound, Proven, Proven))
    LogCost(_) =>
      hit_complexity_summary_lookup(summary_from_costs(bound, bound, Proven, Proven))
  }

fn loop_summary(
  d: Dag,
  acc: List<ComplexityEntry>,
  l: LoopNode
) -> Lookup<ComplexitySummary> =
  combine_sequential(
    combine_sequential(lookup_summary(acc, l.source), lookup_summary(acc, l.init)),
    combine_iterate(
      hit_complexity_summary_lookup(summary_from_costs(
        LinearCost(unnamed_size_variable(l.source)),
        LinearCost(unnamed_size_variable(l.source)),
        Proven,
        Proven
      )),
      body_summary(d, acc, l.body)
    )
  )

fn body_summary(
  d: Dag,
  acc: List<ComplexityEntry>,
  body_id: NodeId
) -> Lookup<ComplexitySummary> =
  match node(d, body_id) {
    None => miss_complexity_summary_lookup()
    Some(body_behavior) => lookup_summary(acc, behavior_result_port(body_behavior))
  }

fn behavior_result_port(b: Behavior) -> PortId =
  match b {
    Value(v) => v.result_port
    Transform(t) => t.result_port
    Branch(br) => br.result_port
    Loop(lp) => lp.result_port
    Bind(bind) => bind.result_port
  }

fn branch_summary(
  acc: List<ComplexityEntry>,
  input: PortId,
  paths: List<BranchPath>
) -> Lookup<ComplexitySummary> =
  combine_sequential(
    lookup_summary(acc, input),
    max_path_summaries(acc, paths)
  )

fn max_path_summaries(
  acc: List<ComplexityEntry>,
  paths: List<BranchPath>
) -> Lookup<ComplexitySummary> =
  fold(paths, hit_complexity_summary_lookup(zero_summary()), |running, path|
    combine_branch(running, lookup_summary(acc, path.result_port))
  )

fn lookup_summary(acc: List<ComplexityEntry>, port_id: PortId) -> Lookup<ComplexitySummary> =
  fold(acc, miss_complexity_summary_lookup(), |running, entry|
    match running {
      Hit(_) => running
      Miss =>
        if entry.port == port_id then
          entry.summary
        else
          miss_complexity_summary_lookup()
    }
  )

fn combine_sequential(
  a: Lookup<ComplexitySummary>,
  b: Lookup<ComplexitySummary>
) -> Lookup<ComplexitySummary> =
  match a {
    Miss => miss_complexity_summary_lookup()
    Hit(ax) =>
      match b {
        Miss => miss_complexity_summary_lookup()
        Hit(bx) => hit_complexity_summary_lookup(compose_summary_sequential(ax, bx))
      }
  }

fn combine_iterate(
  outer: Lookup<ComplexitySummary>,
  body: Lookup<ComplexitySummary>
) -> Lookup<ComplexitySummary> =
  match outer {
    Miss => miss_complexity_summary_lookup()
    Hit(outer_summary) =>
      match body {
        Miss => miss_complexity_summary_lookup()
        Hit(body_summary_value) =>
          hit_complexity_summary_lookup(compose_summary_iterate(outer_summary, body_summary_value))
      }
  }

fn combine_branch(
  a: Lookup<ComplexitySummary>,
  b: Lookup<ComplexitySummary>
) -> Lookup<ComplexitySummary> =
  match a {
    Miss => miss_complexity_summary_lookup()
    Hit(ax) =>
      match b {
        Miss => miss_complexity_summary_lookup()
        Hit(bx) => hit_complexity_summary_lookup(compose_summary_branch_pair(ax, bx))
      }
  }

fn compose_summary_sequential(a: ComplexitySummary, b: ComplexitySummary) -> ComplexitySummary =
  summary_from_costs(
    sequential(a.work, b.work),
    sequential(a.span, b.span),
    certainty_of_surviving_per_dim(a.work, b.work, a.work_certainty, b.work_certainty),
    certainty_of_surviving_per_dim(a.span, b.span, a.span_certainty, b.span_certainty)
  )

fn compose_summary_iterate(outer: ComplexitySummary, body: ComplexitySummary) -> ComplexitySummary =
  summary_from_costs(
    iterate(outer.work, body.work),
    iterate(outer.work, body.span),
    certainty_of_surviving_per_dim(outer.work, body.work, outer.work_certainty, body.work_certainty),
    certainty_of_surviving_per_dim(outer.work, body.span, outer.work_certainty, body.span_certainty)
  )

fn compose_summary_branch_pair(a: ComplexitySummary, b: ComplexitySummary) -> ComplexitySummary =
  summary_from_costs(
    max_path(cons(a.work, cons(b.work, empty()))),
    max_path(cons(a.span, cons(b.span, empty()))),
    certainty_of_surviving_per_dim(a.work, b.work, a.work_certainty, b.work_certainty),
    certainty_of_surviving_per_dim(a.span, b.span, a.span_certainty, b.span_certainty)
  )

fn certainty_of_surviving_per_dim(
  outer_dim: SymbolicCost,
  body_dim: SymbolicCost,
  outer_cert: Certainty,
  body_cert: Certainty
) -> Certainty =
  match dominance_outcome(outer_dim, body_dim) {
    BothSurvive => meet_pair(outer_cert, body_cert)
    OuterDominates => outer_cert
    BodyDominates => body_cert
  }

fn dominance_outcome(outer_dim: SymbolicCost, body_dim: SymbolicCost) -> DominanceOutcome =
  if dominates(outer_dim, body_dim) then
    if dominates(body_dim, outer_dim) then BothSurvive else OuterDominates
  else
    if dominates(body_dim, outer_dim) then BodyDominates else BothSurvive

fn meet_pair(a: Certainty, b: Certainty) -> Certainty =
  match a {
    Proven => b
    Conservative => Conservative
  }

// ── T-LAS — canonical `EnforceableLens` for complexity contracts (gate #92) ──
//
// `data complexity_lens` is substrate `Lens<ComplexitySummary>`. **read** runs the
// same `complexity_of` catamorphism as the enforcement consumer; **monoid op** /
// **branch** / **iterate** delegate to the same `compose_*` helpers as
// `compute_summaries` (thin wrapper fns keep `Monoid`/`Lens` `data` bodies
// M1(2.8)-structural — avoid wiring `compose_*` fields directly in records).
//
// **validate** — predicate `complexity_summary_work_class_consistent` is exported
// for callers/folds (`asymptotic_dominates(summary.asymptotic_class, classify(work))`:
// stored class is a conservative upper bound). This hook stays `NoDiagnostic` until `SomeDiagnostic` can be
// lowered from `lenses.*` (DB-11 `SourceSpan`/`FilePath` narrowing + M1(2.8) opaque
// `data Diagnostic` bodies). Dissolution: class-5 `Diagnostic` authorship in lens
// modules / span witnesses (program-plan gate #92 closure).
//
// **LensEnforcement authority:** `project` / `violates` remain substrate truth;
// `enforced_lens_application` consumes the generated `complexity_enforcement_*` fns.
//
// **Read / monoid / branch / iterate:** wired to `complexity_of` + `compose_*` (same
// fold as `compute_summaries`) — not a placeholder dissolution; the remaining lift is
// `validate`→`SomeDiagnostic` (paragraph above).
fn complexity_enforcement_project(summary: ComplexitySummary) -> AsymptoticClass =
  summary.asymptotic_class

// Strict excess: observed strictly dominates declared budget under `asymptotic_dominates`
// (`algebra.dag`), and not conversely. Bool via `0 == 0` / `0 == 1` so rust emit
// stays valid Rust `bool` (Classical `True`/`False` lowers poorly for `-> Bool` targets).
//
// **Executable parity (P2 / T-LAS):** this lowers to `complexity_lens_generated` calling
// `v3_compiler::complexity_lattice::asymptotic_dominates`, which matches the staged
// `.dag` relation on every tier **and** refines `ClassPolynomial`×`ClassPolynomial` to
// compare Peano degrees (k1 ≥ k2). `algebra.dag` remains tier-coarse for poly–poly in
// `meet`/`join`/`asymptotic_dominates` until bootstrap lowering accepts the same-degree
// story structurally in substrate (dissolution: algebra `ClassPolynomial` match payloads
// + Peano compare without host/Rust-only split — program-plan gate #92 / ROADMAP).
// **Budget enforcement** must follow the generated lattice bridge (single consumer:
// `enforced_lens_application`).
fn complexity_enforcement_violates(declared: AsymptoticClass, observed: AsymptoticClass) -> Bool =
  if asymptotic_dominates(observed, declared) then
    if asymptotic_dominates(declared, observed) then 0 == 1 else 0 == 0
  else
    0 == 1

// Match on owned `Lookup` (not `&Lookup`) so Rust emit binds an owned summary in
// `Hit(summary)` for `Witness::Inhabits` (see `m2_lens_cost_migration_test` / regen).
fn witness_from_complexity_lookup(s: Lookup<ComplexitySummary>, at: Behavior) -> Witness<ComplexitySummary> =
  match s {
    Hit(summary) => Inhabits(summary)
    Miss =>
      Violates {
        reason: "complexity_of: missing ComplexitySummary for behavior result port"
        at: at
      }
  }

fn complexity_lens_read(d: Dag, b: Behavior) -> Witness<ComplexitySummary> =
  witness_from_complexity_lookup(complexity_of(d, behavior_result_port(b)), b)

fn complexity_lens_sequential_op(a: ComplexitySummary, b: ComplexitySummary) -> ComplexitySummary =
  compose_summary_sequential(a, b)

fn complexity_lens_branch_op(a: ComplexitySummary, b: ComplexitySummary) -> ComplexitySummary =
  compose_summary_branch_pair(a, b)

fn complexity_lens_iterate_op(body: ComplexitySummary, bound: LoopBound) -> ComplexitySummary =
  match bound {
    Cardinality(payload) =>
      compose_summary_iterate(
        summary_from_costs(
          LinearCost(unnamed_size_variable(payload.count)),
          LinearCost(unnamed_size_variable(payload.count)),
          Proven,
          Proven
        ),
        body
      )
    Descent(payload) =>
      compose_summary_iterate(
        summary_from_costs(
          LinearCost(unnamed_size_variable(payload.measure)),
          LinearCost(unnamed_size_variable(payload.measure)),
          Proven,
          Proven
        ),
        body
      )
  }

// `c.asymptotic_class` must **cover** `classify_symbolic_cost(c.work)` in the
// `algebra.dag` order (ClassConstant ≤ … ≤ ClassUnknown): upper-bound field
// dominates actual work class. Under-reported labels (e.g. ClassLog + linear work)
// fail `asymptotic_dominates(stored, classified)` — `asymptotic_dominates(ClassLog, ClassLinear)` is False.
fn complexity_summary_work_class_consistent(c: ComplexitySummary) -> Bool =
  asymptotic_dominates(c.asymptotic_class, classify_symbolic_cost(c.work))

fn complexity_lens_validate(d: Dag, c: ComplexitySummary) -> OptionalDiagnostic =
  NoDiagnostic

data complexity_lens_monoid: Monoid<ComplexitySummary> = {
  op: complexity_lens_sequential_op
  identity: {
    work: ConstantCost(0)
    span: ConstantCost(0)
    asymptotic_class: ClassConstant
    work_certainty: Proven
    span_certainty: Proven
  }
}

data complexity_lens: Lens<ComplexitySummary> = {
  name: "complexity"
  read: complexity_lens_read
  sequential: complexity_lens_monoid
  branch: complexity_lens_branch_op
  iterate: complexity_lens_iterate_op
  validate: complexity_lens_validate
}

data complexity_enforcement: LensEnforcement<ComplexitySummary, AsymptoticClass> = {
  project: complexity_enforcement_project
  violates: complexity_enforcement_violates
}

data complexity_enforceable: EnforceableLens<ComplexitySummary, AsymptoticClass> = {
  lens: complexity_lens
  enforcement: complexity_enforcement
}

type ComplexityEnforcedApplication = EnforcedApplication<ComplexitySummary, AsymptoticClass>

// CostBound projection authority lives in `std.induction::cost_bound_to_symbolic`.
// This lens consumes the live CallPattern query directly because structural
// SizeVariable construction needs PortIds, while CostBound atoms still carry
// string parameter names.
