// lenses.complexity — structural cost lens for the v3 DAG.
//
// 🟡 Scaffold — fuel counter on graph-plus-list descent. The
// recursion in `eval_cost` carries `remaining: Int` because
// `.dag`'s termination checker cannot prove that a walk along
// `produced_by` edges terminates without an explicit measure, and
// v3 does not yet support mutual recursion so the list-descent
// helpers cannot live in separate functions that call back into
// graph-descent.
//
// **Equivalent to the original Rust lens** at
// `src/v3/compiler/src/lens_cost.rs` on commit 1247f4b1d, which
// walked the DAG recursively without fuel (Rust has no termination
// checker). That reference implementation is the oracle this lens
// agrees with.
//
// **Dissolution trigger.** Fuel disappears when any of:
//   (a) `.dag` gains mutual recursion support; then graph-descent
//       and list-descent live in separate functions that each
//       descend structurally on their own first argument.
//   (b) `.dag`'s termination checker accepts DAG-walk termination
//       via substrate invariants (the DAG is acyclic and finite).
//   (c) The substrate exposes a `fold_backward(d, port, f)` or
//       forward-fold-by-topological-order primitive that makes the
//       walk structural by construction.
//
// **Fuel budget.** Seed = 2 × port count. The walk decrements fuel
// on every recursive call (both graph descent via `produced_by` and
// list descent for Transform inputs / Branch paths). Since the
// substrate graph is acyclic, each port is visited at most once
// along any single chain, and each port contributes at most one
// list-descent step per consumer. Two decrements per port is a
// safe upper bound that accommodates the double-decrement without
// truncating real computations. The tighter single-decrement
// version would require mutual recursion.

module lenses.complexity

import std.list { List, empty, fold }
import std.substrate { Dag, DagPort, Behavior, BranchPath, NodeId, PortId }

type PortLookup
  = MissingPort
  | FoundPort(DagPort)

type BehaviorLookup
  = MissingBehavior
  | FoundBehavior(Behavior)

type CostMode
  = Port
  | SumPorts
  | MaxPaths

fn cost_of(d: Dag, port_id: PortId) -> Int =
  eval_cost(
    // Seed: 2 × port count. Covers graph descent plus list descent
    // steps without premature termination. See file header for why.
    fold(d.ports, 0, |acc, _| acc + 2),
    d,
    Port,
    port_id,
    empty(),
    empty()
  )

fn eval_cost(
  remaining: Int,
  d: Dag,
  mode: CostMode,
  port_id: PortId,
  ports: List<PortId>,
  paths: List<BranchPath>
) -> Int =
  if remaining == 0 then
    0
  else
    match mode {
      Port =>
        match find_port(d.ports, port_id) {
          MissingPort => 0
          FoundPort(port) =>
            match port.produced_by {
              None => 0
              Some(node_id) =>
                match find_behavior(d.nodes, node_id) {
                  MissingBehavior => 0
                  FoundBehavior(behavior) =>
                    match behavior {
                      Value(v) => 0
                      Transform(t) =>
                        1
                        + eval_cost(
                            remaining - 1,
                            d,
                            SumPorts,
                            port_id,
                            t.inputs,
                            empty()
                          )
                      Branch(branch) =>
                        1
                        + eval_cost(
                            remaining - 1,
                            d,
                            Port,
                            branch.input,
                            empty(),
                            empty()
                          )
                        + eval_cost(
                            remaining - 1,
                            d,
                            MaxPaths,
                            port_id,
                            empty(),
                            branch.paths
                          )
                      Loop(loop_node) =>
                        1
                        + eval_cost(
                            remaining - 1,
                            d,
                            Port,
                            loop_node.source,
                            empty(),
                            empty()
                          )
                        + eval_cost(
                            remaining - 1,
                            d,
                            Port,
                            loop_node.init,
                            empty(),
                            empty()
                          )
                      Bind(bind) =>
                        eval_cost(
                          remaining - 1,
                          d,
                          Port,
                          bind.result_port,
                          empty(),
                          empty()
                        )
                    }
                }
            }
        }
      SumPorts =>
        match ports {
          Empty => 0
          Cons(payload) =>
            sum_int(
              eval_cost(
                remaining - 1,
                d,
                Port,
                payload.head,
                empty(),
                empty()
              ),
              eval_cost(
                remaining - 1,
                d,
                SumPorts,
                port_id,
                payload.tail,
                empty()
              )
            )
        }
      MaxPaths =>
        match paths {
          Empty => 0
          Cons(payload) =>
            max_int(
              eval_cost(
                remaining - 1,
                d,
                Port,
                payload.head.result_port,
                empty(),
                empty()
              ),
              eval_cost(
                remaining - 1,
                d,
                MaxPaths,
                port_id,
                empty(),
                payload.tail
              )
            )
        }
    }

fn max_int(left: Int, right: Int) -> Int =
  if left > right then left else right

fn sum_int(left: Int, right: Int) -> Int =
  left + right

fn find_port(ports: List<DagPort>, port_id: PortId) -> PortLookup =
  match ports {
    Empty => MissingPort
    Cons(payload) =>
      if payload.head.id == port_id then
        FoundPort(payload.head)
      else
        find_port(payload.tail, port_id)
  }

fn find_behavior(nodes: List<Behavior>, node_id: NodeId) -> BehaviorLookup =
  match nodes {
    Empty => MissingBehavior
    Cons(payload) =>
      if behavior_id(payload.head) == node_id then
        FoundBehavior(payload.head)
      else
        find_behavior(payload.tail, node_id)
  }

fn behavior_id(behavior: Behavior) -> NodeId =
  match behavior {
    Value(v) => v.id
    Transform(t) => t.id
    Branch(b) => b.id
    Loop(l) => l.id
    Bind(bind) => bind.id
  }
