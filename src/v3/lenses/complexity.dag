// lenses.complexity — structural depth lens for the v3 DAG.
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY PROXY.
// See docs/v3-lens-capability-register.md.
//
// Forward fold over `d.nodes` builds a per-port integer depth
// map. The substrate invariant that producers precede consumers in
// `d.nodes` makes this a pure catamorphism — no fuel, no mutual
// recursion, no manual termination measure. Structural termination:
// `fold` drives the walk on the finite list `d.nodes`.
//
// **This lens does not subsume v2's complexity analysis.** v2's
// `src/v2/complexity.dag` produces `ComplexitySummary { work, span,
// output_size, certainty }` with symbolic `CostExpr` / `SizeExpr`
// and asymptotic classification. This lens produces a single integer
// per port — the structural depth of the producing behavior in the
// DAG. The reduction in LOC versus v2 is achieved by computing a
// weaker function of the program, not by dissolving v2's algebra.
// Genuine equivalence blocks on porting `DescentEvidence`,
// `CallPattern`, `SubValueRelation`, and `MethodSemantics` carriers
// into the v3 substrate. See the register for the full delta.
//
// **Equivalent to the prior Rust lens** at
// `src/v3/compiler/src/lens_cost.rs` on commit 1247f4b1d, which
// walked `produced_by` recursively. That oracle encoded the same
// structural-depth algebra; this forward-fold is the substrate-native
// rewriting that exchanges recursive graph descent for sequential
// map build.
//
// **Fail-closed on malformed references.** `Lookup<Int>` keeps
// `Miss` distinct from `Hit(0)` so a port referenced by
// a consumer but absent from the cost map cannot masquerade as a
// legitimate zero-cost leaf. The accumulator is pre-seeded with an
// entry (cost 0) for every `bind.params` port — parameters are the
// only legitimate absent-from-d.nodes zero-cost leaves. Any remaining
// `Miss` at lookup time means the DAG references a port whose
// producer is not in `d.nodes`, which is malformed and surfaces at
// the Rust boundary (`CostLens::cost_of` panics).
//
// Shared carrier: `v3.std.lookup.Lookup` (see docs/thesis/compiler-std-consolidation.md).

module lenses.complexity

import std.list { List, empty, fold, cons, concat }
import std.substrate { Dag, DagPort, Behavior, BranchPath, NodeId, PortId }
import std.types { Int }
import v3.std.lookup { Lookup, hit_int_lookup, miss_int_lookup }

type CostEntry {
  port: PortId
  cost: Lookup<Int>
}

fn cost_of(d: Dag, port_id: PortId) -> Lookup<Int> =
  lookup_cost(compute_costs(d), port_id)

fn compute_costs(d: Dag) -> List<CostEntry> =
  fold(d.nodes, seed_bind_params(d.nodes), |acc, behavior|
    cons(entry_for(acc, behavior), acc)
  )

// Pre-seed the accumulator with `Hit(0)` for every
// `bind.params` port. Parameters have `produced_by = None` and are not
// Behaviors in `d.nodes`, so without this seed their lookups would
// return `Miss` and a malformed reference would be
// indistinguishable from a legitimate parameter.
fn seed_bind_params(nodes: List<Behavior>) -> List<CostEntry> =
  match nodes {
    Empty => empty()
    Cons(payload) =>
      concat(params_of(payload.head), seed_bind_params(payload.tail))
  }

fn params_of(behavior: Behavior) -> List<CostEntry> =
  match behavior {
    Value(v) => empty()
    Transform(t) => empty()
    Branch(b) => empty()
    Loop(l) => empty()
    Bind(bind) => param_entries(bind.params)
  }

fn param_entries(params: List<PortId>) -> List<CostEntry> =
  match params {
    Empty => empty()
    Cons(payload) =>
      cons(
        { port: payload.head, cost: hit_int_lookup(0) },
        param_entries(payload.tail)
      )
  }

fn entry_for(acc: List<CostEntry>, behavior: Behavior) -> CostEntry =
  match behavior {
    Value(v) => { port: v.result_port, cost: hit_int_lookup(0) }
    Transform(t) =>
      {
        port: t.result_port
        cost: add_one(sum_costs(acc, t.inputs))
      }
    Branch(b) =>
      {
        port: b.result_port
        cost:
          add_one(
            add_cost(
              lookup_cost(acc, b.input),
              max_path_cost(acc, b.paths)
            )
          )
      }
    Loop(l) =>
      {
        port: l.result_port
        cost:
          add_one(
            add_cost(
              lookup_cost(acc, l.source),
              lookup_cost(acc, l.init)
            )
          )
      }
    Bind(bind) =>
      {
        port: bind.result_port
        cost: lookup_cost(acc, bind.result_port)
      }
  }

fn sum_costs(acc: List<CostEntry>, ports: List<PortId>) -> Lookup<Int> =
  fold(ports, hit_int_lookup(0), |sum, port_id|
    add_cost(sum, lookup_cost(acc, port_id))
  )

fn max_path_cost(acc: List<CostEntry>, paths: List<BranchPath>) -> Lookup<Int> =
  fold(paths, hit_int_lookup(0), |best, path|
    max_cost(best, lookup_cost(acc, path.result_port))
  )

fn lookup_cost(acc: List<CostEntry>, port_id: PortId) -> Lookup<Int> =
  match acc {
    Empty => miss_int_lookup()
    Cons(payload) =>
      if payload.head.port == port_id then
        payload.head.cost
      else
        lookup_cost(payload.tail, port_id)
  }

// Fail-closed arithmetic: a missing operand makes the whole sum
// missing. Silent zero-fallback would let a malformed DAG masquerade
// as a valid computation with cost 0.
fn add_one(c: Lookup<Int>) -> Lookup<Int> =
  match c {
    Miss => miss_int_lookup()
    Hit(n) => hit_int_lookup(1 + n)
  }

fn add_cost(a: Lookup<Int>, b: Lookup<Int>) -> Lookup<Int> =
  match a {
    Miss => miss_int_lookup()
    Hit(x) =>
      match b {
        Miss => miss_int_lookup()
        Hit(y) => hit_int_lookup(x + y)
      }
  }

fn max_cost(a: Lookup<Int>, b: Lookup<Int>) -> Lookup<Int> =
  match a {
    Miss => miss_int_lookup()
    Hit(x) =>
      match b {
        Miss => miss_int_lookup()
        Hit(y) => hit_int_lookup(if x > y then x else y)
      }
  }
