// SG-3g prototype — first `.dag`-authority lowering helper.
//
// Status: STRUCTURALLY PARTIAL; BEHAVIORALLY N/A (intentionally bounded prototype).
// See docs/v3-lens-capability-register.md.
//
// `expr_span` is the smallest real lowering primitive that survives
// the current emit constraints: a pure match over `SurfaceExpr`'s
// eleven named-field variants returning each variant's `span` as
// `SourceByteSpan` (bytes only). Full lowering still needs a parse
// `SourceSpan` including `file`; `lower.rs` takes that from
// `crate::parse::expr_span` (usually imported as `surface_expr_span`),
// not from this lens helper.
//
// Two earlier candidate slices hit `emit_rust_module` gaps and were
// rejected:
//
//   1. `SurfaceLiteral -> LiteralBits`. `src/v3/std/substrate.dag`
//      declares `LiteralBits = LitInt | LitBool | LitString` while
//      the Rust enum is `Int | Bool | String`. No variant-rename
//      facility exists in `spec/rust.dag`, and `emit_rust_module`
//      emits variant names verbatim, so the helper can't construct
//      the Rust variants from the `.dag` names.
//
//   2. `placeholder_connective -> TypeConnective::Atom(
//      AtomPayload::UnresolvedIdentifier(name))`. The variant names
//      align (`Atom`, `UnresolvedIdentifier` exist on both sides),
//      but `render_variant_constructor` at
//      `src/v3/compiler/src/emit/rust_target.rs:4296` unconditionally
//      emits `Variant { _0: value }` struct-variant construction.
//      That works for enums the emit also declares; it doesn't
//      compile against the real tuple-variant Rust enums in
//      `crate::dag` (`TypeConnective::Atom(AtomPayload)` is a tuple
//      variant).
//
// Both are tracked as separate prerequisite lanes — SG-3g is not
// responsible for widening emit_rust_module to construct external
// substrate variants.
//
// `expr_span` only reads variants and returns `SourceByteSpan` (byte
// extent within the compilation unit; no `SourceSpan.file` surface on
// the lens output), so neither construction gap applies. The generator
// produces clean Rust for it.
//
// Wire-in: `lower.rs` imports `pattern_binding_names` and
// `surface_item_span` from `crate::lower_helpers` (the latter is the
// hand helper next to `include!("lower_helpers_generated.rs")` in
// `lib.rs`). Expression extents for full `SourceSpan` come from
// `crate::parse::expr_span`. Byte-only `lower_helpers::expr_span` is
// used where parse glue stitches spans before calling
// `SourceSpan::new(self.file, ...)` (see `parse_parser_body.txt`).
// `parse::SurfaceExpr` matches `parse_surface::SurfaceExpr`
// (`parse_generated.rs` re-exports the mirror), so no clone bridge.
//
// Placement under `lenses/` mirrors `infer_helpers.dag`: `build.rs`'s
// auto-stager for `src/v3/compiler/*.dag` does not sweep this file
// into the bootstrap; `regen_lens` reads it standalone via the
// `LensRegistryEntry` record in `src/v3/compiler/regen.dag`.

module lenses.lower_helpers

import v3.std.substrate { SourceByteSpan }
import std.list { List, empty, cons, singleton }
import v3.std.parse_surface { SurfaceExpr, SurfaceItem, SurfacePattern, SurfacePatternField }

fn expr_span(expr: SurfaceExpr) -> SourceByteSpan =
  match expr {
    Literal(e) => { byte_start: e.span.start, byte_end: e.span.end }
    Var(e) => { byte_start: e.span.start, byte_end: e.span.end }
    Path(e) => { byte_start: e.span.start, byte_end: e.span.end }
    Call(e) => { byte_start: e.span.start, byte_end: e.span.end }
    VariantRecord(e) => { byte_start: e.span.start, byte_end: e.span.end }
    Operator(e) => { byte_start: e.span.start, byte_end: e.span.end }
    Lambda(e) => { byte_start: e.span.start, byte_end: e.span.end }
    If(e) => { byte_start: e.span.start, byte_end: e.span.end }
    Match(e) => { byte_start: e.span.start, byte_end: e.span.end }
    Record(e) => { byte_start: e.span.start, byte_end: e.span.end }
    List(e) => { byte_start: e.span.start, byte_end: e.span.end }
    Map(e) => { byte_start: e.span.start, byte_end: e.span.end }
    PathCall(e) => { byte_start: e.span.start, byte_end: e.span.end }
  }

fn item_span(item: SurfaceItem) -> SourceByteSpan =
  match item {
    Let(i) => expr_span(i.expr)
    Fn(i) => { byte_start: i.span.start, byte_end: i.span.end }
    FnExternalBody(i) => { byte_start: i.span.start, byte_end: i.span.end }
    Data(i) => { byte_start: i.span.start, byte_end: i.span.end }
    Module(i) => { byte_start: i.span.start, byte_end: i.span.end }
    Import(i) => { byte_start: i.span.start, byte_end: i.span.end }
    TypeAtom(i) => { byte_start: i.span.start, byte_end: i.span.end }
    TypeRecord(i) => { byte_start: i.span.start, byte_end: i.span.end }
    TypeSum(i) => { byte_start: i.span.start, byte_end: i.span.end }
    TypeAlias(i) => { byte_start: i.span.start, byte_end: i.span.end }
  }

fn pattern_binding_names(pattern: SurfacePattern) -> List<String> =
  match pattern {
    BareVariant(_) => empty()
    VariantWith(v) => singleton(v.binding)
    VariantFields(v) => pattern_field_bindings(v.fields)
  }

fn pattern_field_bindings(fields: List<SurfacePatternField>) -> List<String> =
  match fields {
    Empty => empty()
    Cons(payload) =>
      cons(payload.head.binding, pattern_field_bindings(payload.tail))
  }
