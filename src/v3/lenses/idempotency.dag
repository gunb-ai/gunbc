// lenses.idempotency — Lane 2 Stage 2b workflow idempotency dispatch.
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY COMPLETE.
// See docs/v3-lens-capability-register.md.
//
// Reads `lane2_workflow` through the substrate accessor `lane2_workflow_at`
// (reflected on `ValueNode` / `BindNode` in `v3.std.substrate`) and dispatches
// to `std.effects::lane2_workflow_idempotency_report`, whose `match` on
// `WorkflowEffect` is authored in `src/v3/std/effects.dag`. The crate entry
// `v3_compiler::analyze_workflow` remains a native-`Dag` convenience mirror over
// the same projection (`workflow_idempotency.rs`).
//
// CI exercises lens emission in `m2_lens_idempotency_emit_test` (Rust/Go/Python
// emit smoke) and rustc round-trip in `m2_lens_idempotency_migration_test`.

module lenses.idempotency

import v3.std.substrate { Dag, NodeId, lane2_workflow_at }
import std.effects {
  WorkflowIdempotencyReport,
  lane2_workflow_idempotency_report,
  report_unsupported_workflow_variant
}

fn analyze_workflow(d: Dag, workflow_root: NodeId) -> WorkflowIdempotencyReport =
  match lane2_workflow_at(d, workflow_root) {
    None =>
      report_unsupported_workflow_variant(
        "Lane2WorkflowRoot",
        "lane2_stage2b_idempotency_lens",
        "no WorkflowEffect at this substrate root - populate `lane2_workflow` on `Value`/`Bind` via lowering or `try_register_lane2_workflow_effect`"
      )
    Some(wf) => lane2_workflow_idempotency_report(wf)
  }
