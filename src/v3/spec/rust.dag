data rust_behavior: TypeRealization = {
  target: Behavior
  carrier: "Behavior"
  fields: []
  cost: 1
}

data rust_dag: TypeRealization = {
  target: Dag
  carrier: "Dag"
  fields: [
    { dag_name: "declarations", rust_access: AccessorMethod("declarations") },
    { dag_name: "nodes", rust_access: AccessorMethod("nodes") }
  ]
  cost: 1
}

// ─────────────────────────────────────────────────────────────────
// Operator realizations — arithmetic on Int.
// ─────────────────────────────────────────────────────────────────
//
// `op` references the algebra field declaration via dotted path:
// `OrderedRing.add` resolves at lower time to the child
// declaration of OrderedRing's Conj whose label is "add". The
// emitter looks up by the (operand_type_decl, algebra_field_decl)
// pair built from the Transform's input port type and the
// OperatorKind's algebra field name resolved against the operand
// type's algebra chain.

data rust_int_add: OperatorRealization = {
  target: Int
  op: OrderedRing.add
  carrier: "+"
  cost: 1
}

data rust_int_sub: OperatorRealization = {
  target: Int
  op: OrderedRing.sub
  carrier: "-"
  cost: 1
}

data rust_int_mul: OperatorRealization = {
  target: Int
  op: OrderedRing.mul
  carrier: "*"
  cost: 1
}

data rust_int_div: OperatorRealization = {
  target: Int
  op: OrderedRing.div
  carrier: "/"
  cost: 1
}

// ─────────────────────────────────────────────────────────────────
// Operator realizations — comparisons on Int.
// ─────────────────────────────────────────────────────────────────

data rust_int_eq: OperatorRealization = {
  target: Int
  op: OrderedRing.eq
  carrier: "=="
  cost: 1
}

data rust_int_ne: OperatorRealization = {
  target: Int
  op: OrderedRing.ne
  carrier: "!="
  cost: 1
}

data rust_int_lt: OperatorRealization = {
  target: Int
  op: OrderedRing.lt
  carrier: "<"
  cost: 1
}

data rust_int_le: OperatorRealization = {
  target: Int
  op: OrderedRing.le
  carrier: "<="
  cost: 1
}

data rust_int_gt: OperatorRealization = {
  target: Int
  op: OrderedRing.gt
  carrier: ">"
  cost: 1
}

data rust_int_ge: OperatorRealization = {
  target: Int
  op: OrderedRing.ge
  carrier: ">="
  cost: 1
}

// ─────────────────────────────────────────────────────────────────
// Behavior template realizations — substrate-shaped emissions.
// ─────────────────────────────────────────────────────────────────

data rust_let_stmt: BehaviorRealization = {
  target: Bind
  carrier: "let {name}: {type} = {value};"
  cost: 0
}

data rust_if_expr: BehaviorRealization = {
  target: Branch
  carrier: "if {cond} { {then} } else { {else} }"
  cost: 0
}

data rust_main_wrap: BehaviorRealization = {
  target: Main
  carrier: "fn main() { {body} println!({quote}{{}}{quote}, {final}); }"
  cost: 0
}

// ─────────────────────────────────────────────────────────────────
// Callable realizations — staged std.list helpers.
// ─────────────────────────────────────────────────────────────────

data rust_empty_callable: CallableRealization = {
  target: empty
  strategy: ListEmpty
  cost: 1
}

data rust_singleton_callable: CallableRealization = {
  target: singleton
  strategy: ListSingleton
  cost: 1
}

data rust_cons_callable: CallableRealization = {
  target: cons
  strategy: ListCons
  cost: 1
}

data rust_fold_callable: CallableRealization = {
  target: fold
  strategy: ListFold
  cost: 1
}

data rust_map_callable: CallableRealization = {
  target: map
  strategy: ListMap
  cost: 1
}

data rust_filter_callable: CallableRealization = {
  target: filter
  strategy: ListFilter
  cost: 1
}

data rust_statements: StatementSyntax = {
  let_binding: "let {name}: {type} = {value};"
  let_binding_inferred: "let {name} = {value};"
}

data rust_expressions: ExpressionSyntax = {
  binary_op: "({lhs} {op} {rhs})"
  field_access: "{object}.{field}"
  function_call: "{func}({args})"
  closure: "|{params}| {{ {body} }}"
}

data rust_control_flow: ControlFlowSyntax = {
  if_else: "if {cond} { {then} } else { {else} }"
  match_arm: "{pattern} => {body},"
  for_each_syntax: { prefix: "for ", separator: " in " }
}

data rust_literals: LiteralSyntax = {
  true_keyword: "true"
  false_keyword: "false"
  string_delimiter: "%Q"
}

data rust_modules: ModuleSyntax = {
  path_separator: "::"
}

data rust_functions: FunctionSyntax = {
  definition: "fn {name}({params}) -> {ret} { {body} }"
  definition_void: "fn {name}({params}) { {body} }"
  param_with_type: "{name}: {type}"
  param_separator: ", "
}

data rust_type_defs: TypeDefinitionSyntax = {
  struct_def: "pub struct {name} { {fields} }"
  struct_field: "pub {name}: {type},"
  enum_def: "pub enum {name} { {variants} }"
  enum_unit_variant: "{name},"
  enum_data_variant: "{name} { {fields} },"
}

data rust_patterns: PatternMatchSyntax = {
  match_expr: "match {expr} { {arms} }"
  match_arm: "{pattern} => {body},"
  variant_pattern: "{name} {{ {bindings} }}"
  variant_pattern_positional: "{name}({binding})"
  variant_pattern_empty: "{name}"
  field_binding: "{field}: {binding}"
  field_binding_separator: ", "
  wildcard: "_"
}

data rust_collection_ops: CollectionOps = {
  fold: "({recv}).clone().into_iter().fold({init}, {body})"
  map: "({recv}).clone().into_iter().map({body}).collect::<Vec<_>>()"
  filter: "{ let mut __out = Vec::new(); for {item} in ({recv}).clone().into_iter() { if {predicate} { __out.push({item}); } } __out }"
  empty_list: "Vec::new()"
  list_literal: "vec![{elements}]"
  cons: "{ let mut __list = {tail}; __list.insert(0, {head}); __list }"
}

data rust_value_construction: ValueConstructionSyntax = {
  struct_literal: "{type} {{ {fields} }}"
  struct_field_init: "{name}: {value}"
  struct_field_separator: ", "
  variant_construction: "{variant}({args})"
  variant_named_construction: "{variant} {{ {fields} }}"
}

data rust_language: LanguageSpec = {
  statements: rust_statements
  expressions: rust_expressions
  control_flow: rust_control_flow
  literals: rust_literals
  modules: rust_modules
  functions: rust_functions
  type_definitions: rust_type_defs
  patterns: rust_patterns
  collection_ops: rust_collection_ops
  values: rust_value_construction
}
