// ─────────────────────────────────────────────────────────────────
// Behavior template realizations — substrate-shaped emissions.
// ─────────────────────────────────────────────────────────────────

data rust_let_stmt: BehaviorRealization = {
  target: Bind
  carrier: "let {name}: {type} = {value};"
  cost: 0
}

data rust_if_expr: BehaviorRealization = {
  target: Branch
  carrier: "if {cond} { {then} } else { {else} }"
  cost: 0
}

data rust_main_wrap: BehaviorRealization = {
  target: Main
  carrier: "fn main() { {body} println!({quote}{{}}{quote}, {final}); }"
  cost: 0
}

// ─────────────────────────────────────────────────────────────────
// Callable realizations — staged std.list helpers.
// ─────────────────────────────────────────────────────────────────

data rust_empty_callable: CallableRealization = {
  target: empty
  strategy: ListEmpty
  parameter_dispositions: []
  cost: 1
}

data rust_singleton_callable: CallableRealization = {
  target: singleton
  strategy: ListSingleton
  parameter_dispositions: [Consumed]
  cost: 1
}

data rust_cons_callable: CallableRealization = {
  target: cons
  strategy: ListCons
  parameter_dispositions: [Consumed, Consumed]
  cost: 1
}

data rust_concat_callable: CallableRealization = {
  target: concat
  strategy: ListConcat
  parameter_dispositions: [Consumed, Consumed]
  cost: 1
}

data rust_length_callable: CallableRealization = {
  target: length
  strategy: ListLength
  parameter_dispositions: [Borrowed]
  cost: 1
}

data rust_list_instantiation: TypeInstantiationRealization = {
  target: List
  carrier: "Vec<{element}>"
  cost: 1
}

data rust_map_instantiation: TypeInstantiationRealization = {
  target: Map
  carrier: "HashMap<{key}, {value}>"
  cost: 1
}

data rust_is_empty_callable: CallableRealization = {
  target: is_empty
  strategy: ListIsEmpty
  parameter_dispositions: [Borrowed]
  cost: 1
}

data rust_fold_callable: CallableRealization = {
  target: fold
  strategy: ListFold
  parameter_dispositions: [Borrowed, Consumed]
  cost: 1
}

data rust_map_callable: CallableRealization = {
  target: map
  strategy: ListMap
  parameter_dispositions: [Borrowed]
  cost: 1
}

data rust_filter_callable: CallableRealization = {
