// M1(3) PR-B-unwind — Rust target realization with typed
// declaration references throughout.
//
// **What changed from the initial PR-B cut.** The original
// `Realization` meta-type used `target_name: String` and
// `op_name: String` — string keys that the emitter dispatched on
// via `index.lookup("Int", "")` etc. That regenerated the
// name-bridge dispatch pattern that M1(2.7) had spent fourteen
// review rounds eliminating from the inference layer, just at the
// emit layer instead. The unwind reshapes every realization to
// carry typed `DeclarationRef` references (resolved at lower time
// from identifier / dotted-path expressions in the data body) so
// the emitter looks up by `DeclarationId` and zero name strings
// cross the substrate/emitter boundary.
//
// **Four meta-types, one per realization category.** Earlier
// drafts attempted to fit every realization under a single
// `Realization` meta-type with overloaded `target` / `op` fields.
// That conflated three distinct fact shapes:
//   1. Type realizations: a primitive type → its target-language
//      type name (Int → "i64").
//   2. Operator realizations: a (operand_type, algebra_field) pair
//      → its target-language operator symbol ((Int, OrderedRing.add)
//      → "+").
//   3. Behavior template realizations: a v3_l1 marker → a target-
//      language template string with placeholder slots (Bind →
//      "let {name}: {type} = {value};").
// Each shape needs its own index keyed differently. Splitting the
// meta-types makes the emitter's lookup tables type-safe and
// each meta-type's 4-pattern dissolution receipt independent.
//
// **The placeholder template language (`{name}` / `{type}` /
// `{value}` / etc.)** stays as-is: it is a bounded scaffold inside the
// per-target template carrier strings. Each placeholder is
// documented in the BehaviorRealization comment block below; the
// substitution engine lives in `emit_rust.rs::render_template`.
// The full dissolution would move the template language itself
// into a structural form (e.g. a sub-DAG of placeholder edges
// referencing the substrate's named slots) — that's deferred
// follow-up work tracked in DOWNSTREAM_REQUIREMENTS.
//
// **`{quote}` placeholder** stands in for a literal `"` (double-quote)
// inside a carrier string. The v3 tokenizer at M1(3) has no
// string escape sequences, so `\"` inside a string literal is
// impossible and `{quote}` is the workaround the emitter substitutes
// at render time. Dissolves when the tokenizer learns escape
// sequences.

module v3.spec.rust

import v3.spec.v3_l1 { Bind, Branch, Main, DeclarationRef }
import v3.std.computation_model { ComputationModel }
import std.list { List }

// ─────────────────────────────────────────────────────────────────
// Realization meta-types — three distinct shapes.
// ─────────────────────────────────────────────────────────────────

// Type realization. Maps a primitive type declaration to its
// target-language type name. Looked up by the emitter via
// `(target: DeclarationRef)` to produce `let x: <carrier> = ...`.
type TypeRealization {
  target: DeclarationRef
  carrier: String
  is_copy: Bool
  fields: List<FieldBinding>
  cost: Int
}

type FieldBinding {
  dag_name: String
  rust_access: RustFieldAccess
  borrowed_read: Bool
}

type RustFieldAccess
  = DirectField(String)
  | AccessorMethod(String)

// Operator realization. Maps a `(operand_type, algebra_field)`
// pair to its target-language operator symbol. The operand type
// is the LHS operand's primitive type (Int / Bool / String /
// etc.); the algebra field is the corresponding field on the
// operand type's algebra (e.g. OrderedRing.add). The emitter
// looks up by `(target: DeclarationRef, op: DeclarationRef)` when
// rendering a `Transform { target: Operator(_), .. }`.
type OperatorRealization {
  target: DeclarationRef
  op: DeclarationRef
  carrier: String
  cost: Int
}

// Behavior template realization. Maps a substrate marker from
// `dsl/std/v3_l1.dag` to a target-language template string with
// placeholders for downstream substitution. Looked up by the
// emitter via `(target: DeclarationRef)` where target is one of the
// L1 behavior markers (Bind / Branch / Main / etc.).
//
// Placeholders the template engine recognizes:
//   {name}  — the Bind's name
//   {type}  — the resolved target-language type name (looked up via
//         the corresponding TypeRealization)
//   {value} — the value sub-expression rendered into target syntax
//   {cond}  — Branch condition expression
//   {then}  — Branch "then" arm body
//   {else}  — Branch "else" arm body
//   {body}  — the joined sequence of let-statements in main body
//   {final} — the name of the final let-binding (printed by main)
//   {quote} — a literal `"` character (workaround for the M1(3)
//         tokenizer having no escape sequences)
type BehaviorRealization {
  target: DeclarationRef
  carrier: String
  cost: Int
}

// Callable realization. Maps a callable declaration to the
// target-language render strategy the emitter should use when it
// sees a `TransformTarget::Callable` instantiation of that
// declaration. This keeps list builtin dispatch in rust.dag
// instead of in name-keyed Rust code.
type CallableRealization {
  target: DeclarationRef
  strategy: RustCallableStrategy
  parameter_dispositions: List<ParameterDisposition>
  cost: Int
}

type ParameterDisposition
  = Borrowed
  | Consumed

type TypeInstantiationRealization {
  target: DeclarationRef
  carrier: String
  cost: Int
}

// Dissolution receipt — 🟡 mixed lifecycle. These variants are the staged Rust
// callable-emission strategies that still live in host Rust while `emit_rust.rs`
// exists. They dissolve when `emit.dag` owns callable lowering directly from the
// target-language facts; until then, the strategy tag is the single authority for
// how a std callable lowers into Rust syntax.
type RustCallableStrategy
  = ListEmpty
  | ListSingleton
  | ListCons
  | ListConcat
  | ListLength
  | ListIsEmpty
  | ListFold
  | ListMap
  | ListFilter
  | ListContains

// Dissolution receipt — 🟡 mixed lifecycle. `PatternRealization` is a staged
// carrier for structural-match lowering onto realized Rust carriers such as
// `List<T> -> Vec<T>`. The terminal target is the same authority expressed as
// target-language facts consumed by `.dag` emission; this record remains the
// single authority until that stage lands.
type PatternRealization {
  target: DeclarationRef
  strategy: RustPatternStrategy
  scrutinee: String
  empty_pattern: String
  cons_pattern: String
  head_expr: String
  tail_expr: String
  cost: Int
}

// Dissolution receipt — 🟡 mixed lifecycle. The current staged emitter needs a
// small structural strategy tag to decide which pattern-lowering path to take.
// It dissolves with `PatternRealization` when the emitter itself becomes data.
type RustPatternStrategy
  = PlaceholderPatternStrategy
  | VectorList

type StatementSyntax {
  let_binding: String
  let_binding_inferred: String
}

type ExpressionSyntax {
  binary_op: String
  field_access: String
  function_call: String
  closure: String
}

type ForEachSyntax {
  prefix: String
  separator: String
}

type ControlFlowSyntax {
  if_else: String
  match_arm: String
  for_each_syntax: ForEachSyntax
}

type LiteralSyntax {
  true_keyword: String
  false_keyword: String
  string_delimiter: String
}

type ModuleSyntax {
  path_separator: String
}

type FunctionSyntax {
  definition: String
  definition_void: String
  param_with_type: String
  param_separator: String
}

type TypeApplicationSyntax {
  optional: String
}

type TypeDefinitionSyntax {
  struct_def: String
  struct_field: String
  enum_def: String
  enum_unit_variant: String
  enum_data_variant: String
}

type PatternMatchSyntax {
  match_expr: String
  match_arm: String
  variant_pattern: String
  variant_pattern_positional: String
  variant_pattern_empty: String
  field_binding: String
  field_binding_separator: String
  wildcard: String
}

type CollectionOps {
  concat: String
  length: String
  is_empty: String
  fold: String
  map: String
  filter: String
  contains: String
  empty_list: String
  list_literal: String
  cons: String
}

type ValueConstructionSyntax {
  struct_literal: String
  struct_field_init: String
  struct_field_separator: String
  variant_construction: String
  variant_named_construction: String
}

type RenderingModel {
  read: ReadStrategy
  construct: ConstructStrategy
}

type ReadStrategy
  = Borrow
  | PassByValue

type ConstructStrategy
  = CopyOrClone
  | PassByValue

type MemoryModel
  = ValueOnly
  | GarbageCollected
  | RefCounted
  | OwnershipBased

type TargetExecutionModel {
  memory: MemoryModel
}

type LanguageSpec {
  statements: DeclarationRef
  expressions: DeclarationRef
  control_flow: DeclarationRef
  literals: DeclarationRef
  modules: DeclarationRef
  functions: DeclarationRef
  type_applications: DeclarationRef
  type_definitions: DeclarationRef
  patterns: DeclarationRef
  collection_ops: DeclarationRef
  values: DeclarationRef
}

// ─────────────────────────────────────────────────────────────────
// Type realizations — primitive type mappings.
// ─────────────────────────────────────────────────────────────────

