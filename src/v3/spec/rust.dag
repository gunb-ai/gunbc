  target: Int
  op: OrderedRing.eq
  carrier: "=="
  cost: 1
}

data rust_node_id_eq: OperatorRealization = {
  target: NodeId
  op: OrderedRing.eq
  carrier: "=="
  cost: 1
}

data rust_port_id_eq: OperatorRealization = {
