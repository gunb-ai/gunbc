// ─────────────────────────────────────────────────────────────────
// Operator realizations — arithmetic on Int.
// ─────────────────────────────────────────────────────────────────
//
// `op` references the algebra field declaration via dotted path:
// `OrderedRing.add` resolves at lower time to the child
// declaration of OrderedRing's Conj whose label is "add". The
// emitter looks up by the (operand_type_decl, algebra_field_decl)
// pair built from the Transform's input port type and the
// OperatorKind's algebra field name resolved against the operand
// type's algebra chain.

data rust_int_add: OperatorRealization = {
  language: rust_language
  target: Int
  op: OrderedRing.add
  carrier: "({lhs} + {rhs})"
  cost: 1
}

data rust_int_sub: OperatorRealization = {
  language: rust_language
  target: Int
  op: OrderedRing.sub
  carrier: "({lhs} - {rhs})"
  cost: 1
}

data rust_int_mul: OperatorRealization = {
  language: rust_language
  target: Int
  op: OrderedRing.mul
  carrier: "({lhs} * {rhs})"
  cost: 1
}

data rust_int_div: OperatorRealization = {
  language: rust_language
  target: Int
  op: OrderedRing.div
  carrier: "({lhs} / {rhs})"
  cost: 1
}

// ─────────────────────────────────────────────────────────────────
// Operator realizations — comparisons on Int.
// ─────────────────────────────────────────────────────────────────

data rust_int_eq: OperatorRealization = {
  language: rust_language
  target: Int
  op: OrderedRing.eq
  carrier: "({lhs} == {rhs})"
  cost: 1
}

data rust_node_id_eq: OperatorRealization = {
  language: rust_language
  target: NodeId
  op: OrderedRing.eq
  carrier: "({lhs} == {rhs})"
  cost: 1
}

data rust_port_id_eq: OperatorRealization = {
  language: rust_language
  target: PortId
  op: OrderedRing.eq
  carrier: "({lhs} == {rhs})"
  cost: 1
}

data rust_declaration_id_eq: OperatorRealization = {
  language: rust_language
  target: DeclarationId
  op: OrderedRing.eq
  carrier: "({lhs} == {rhs})"
  cost: 1
}

// String inhabits FreeMonoid (no direct `eq` field); equality uses the same
// canonical OrderedRing.eq arrow that `algebra_field_for_operator` selects
// after the monoid walk misses `eq`.
data rust_string_eq: OperatorRealization = {
  language: rust_language
  target: String
  op: OrderedRing.eq
  carrier: "({lhs} == {rhs})"
  cost: 1
}

data rust_int_ne: OperatorRealization = {
  language: rust_language
  target: Int
  op: OrderedRing.ne
  carrier: "({lhs} != {rhs})"
  cost: 1
}

data rust_node_id_ne: OperatorRealization = {
  language: rust_language
  target: NodeId
  op: OrderedRing.ne
  carrier: "({lhs} != {rhs})"
  cost: 1
}

data rust_port_id_ne: OperatorRealization = {
  language: rust_language
  target: PortId
  op: OrderedRing.ne
  carrier: "({lhs} != {rhs})"
  cost: 1
}

data rust_declaration_id_ne: OperatorRealization = {
  language: rust_language
  target: DeclarationId
  op: OrderedRing.ne
  carrier: "({lhs} != {rhs})"
  cost: 1
}

data rust_int_lt: OperatorRealization = {
  language: rust_language
  target: Int
  op: OrderedRing.lt
  carrier: "({lhs} < {rhs})"
  cost: 1
}

data rust_int_le: OperatorRealization = {
  language: rust_language
  target: Int
  op: OrderedRing.le
  carrier: "({lhs} <= {rhs})"
  cost: 1
