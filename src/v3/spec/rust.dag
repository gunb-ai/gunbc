  op: OrderedRing.eq
  carrier: "=="
  cost: 1
}

data rust_int_ne: OperatorRealization = {
  target: Int
  op: OrderedRing.ne
  carrier: "!="
  cost: 1
}

data rust_node_id_ne: OperatorRealization = {
