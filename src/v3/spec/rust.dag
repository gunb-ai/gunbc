// Bool logical rows key the substrate `Bool` declaration; emit resolves
// operator carriers via `operator_carrier_realization`: strip refinements
// (DB-11 mirror), try the surface key, then peeled empty-alias instantiations
// (e.g. `type MyBool = Bool`) when earlier keys miss.

// ─────────────────────────────────────────────────────────────────
// Behavior template realizations — substrate-shaped emissions.
// ─────────────────────────────────────────────────────────────────

data rust_let_stmt: BehaviorRealization = {
  language: rust_language
  target: Bind
  carrier: "let {name}: {type} = {value};"
  cost: 0
}

data rust_if_expr: BehaviorRealization = {
  language: rust_language
  target: Branch
  carrier: "if {cond} { {then} } else { {else} }"
  cost: 0
}

data rust_main_wrap: BehaviorRealization = {
  language: rust_language
  target: Main
  carrier: "fn main() { {body} println!({quote}{{}}{quote}, {final}); }"
  cost: 0
}

// ─────────────────────────────────────────────────────────────────
// Callable realizations — staged std.list helpers.
// ─────────────────────────────────────────────────────────────────
//
// First-class surface function types (`fn(A) -> B`, lowered as
// `TypeConnective::Arrow` with `ArrowBody::NoBody`) are **not** a single
// `TypeRealization` row: the Rust emitter chooses the carrier by **position**
// (`ArrowRustEmitPolicy` in `emit/rust_target.rs`):
//   - user `fn` parameters → `impl Fn(A) -> B + Clone` (PR #650);
//   - struct fields / `List` / `Map` / `Optional` / top-level `let` / inferred
//     return → `std::rc::Rc<dyn Fn(A) -> B>`;
//   - any other type-name context → fail closed (`UnsupportedBehavior`) until a
//     realization-backed path exists here.
//
// **Derive split (blocking #676 api-review):** `dyn Fn` does not implement
// `Debug`, so user `struct` / `enum` definitions that (transitively) carry
// first-class `fn` storage use `rust_language.record_derive_templates`
// (`data rust_record_derive_templates`, `#[derive(Clone)]` only); see
// `emit/rust_target.rs`.

data rust_empty_callable: CallableRealization = {
  language: rust_language
  target: empty
  strategy: ListEmpty
  parameters: []
  cost: 1
}

data rust_singleton_callable: CallableRealization = {
  language: rust_language
  target: singleton
  strategy: ListSingleton
  parameters: [
    { slot: 0, disposition: Consumed }
  ]
  cost: 1
}

data rust_cons_callable: CallableRealization = {
  language: rust_language
  target: cons
  strategy: ListCons
  parameters: [
    { slot: 0, disposition: Consumed },
    { slot: 1, disposition: Consumed }
  ]
  cost: 1
}

data rust_concat_callable: CallableRealization = {
  language: rust_language
  target: concat
  strategy: ListConcat
  parameters: [
    { slot: 0, disposition: Consumed },
    { slot: 1, disposition: Consumed }
  ]
  cost: 1
}

data rust_length_callable: CallableRealization = {
  language: rust_language
  target: length
  strategy: ListLength
  parameters: [
    { slot: 0, disposition: Borrowed }
  ]
  cost: 1
}

data rust_list_instantiation: TypeInstantiationRealization = {
  language: rust_language
  target: List
  carrier: "Vec<{element}>"
  cost: 1
}

data rust_lookup_instantiation: TypeInstantiationRealization = {
  language: rust_language
  target: Lookup
  carrier: "Lookup<{element}>"
  cost: 1
}

data rust_map_instantiation: TypeInstantiationRealization = {
  language: rust_language
  target: Map
  carrier: "HashMap<{key}, {value}>"
  cost: 1
}

data rust_is_empty_callable: CallableRealization = {
  language: rust_language
  target: is_empty
  strategy: ListIsEmpty
  parameters: [
    { slot: 0, disposition: Borrowed }
  ]
  cost: 1
}

data rust_fold_callable: CallableRealization = {
  language: rust_language
  target: fold
  strategy: ListFold
  parameters: [
    { slot: 0, disposition: Borrowed },
    { slot: 1, disposition: Consumed },
    { slot: 2, disposition: Borrowed }
  ]
  cost: 1
}

data rust_map_callable: CallableRealization = {
  language: rust_language
  target: map
  strategy: ListMap
  parameters: [
    { slot: 0, disposition: Borrowed },
    { slot: 1, disposition: Borrowed }
  ]
  cost: 1
}

data rust_filter_callable: CallableRealization = {
  language: rust_language
  target: filter
  strategy: ListFilter
  parameters: [
    { slot: 0, disposition: Borrowed },
    { slot: 1, disposition: Borrowed }
  ]
  cost: 1
}

data rust_contains_callable: CallableRealization = {
  language: rust_language
  target: contains
  strategy: ListContains
  parameters: [
    { slot: 0, disposition: Borrowed },
    { slot: 1, disposition: Borrowed }
  ]
  cost: 1
}

// List structural-sum (`Empty`/`Cons`) → carrier patterns. `strategy` is the
// pattern-role tag (validated at emitter load); templates below are the
// emission bundle — no strategy dispatch in emitters post Stage 1e.0.
data rust_list_pattern: PatternRealization = {
  language: rust_language
  target: List
  strategy: VectorList
  empty_variant: List.Empty
  cons_variant: List.Cons
  scrutinee: "{expr}"
  empty_pattern: "[]"
  cons_pattern: "[{head}, {tail} @ ..]"
  head_expr: "{head}"
  tail_expr: "{tail}"
  cost: 1
}

data rust_statements: StatementSyntax = {
  let_binding: "let {name}: {type} = {value};"
  let_binding_inferred: "let {name} = {value};"
}

data rust_expressions: ExpressionSyntax = {
  field_access: "({object}).{field}"
  function_call: "{func}({args})"
  closure: "|{params}| {{ {body} }}"
}

data rust_control_flow: ControlFlowSyntax = {
  if_else: "if {cond} { {then} } else { {else} }"
  match_arm: "{pattern} => {body},"
  for_each_syntax: { prefix: "for ", separator: " in " }
}

data rust_literals: LiteralSyntax = {
  true_keyword: "true"
  false_keyword: "false"
  string_delimiter: "%Q"
}

data rust_modules: ModuleSyntax = {
  path_separator: "::"
}

data rust_functions: FunctionSyntax = {
  definition: "fn {name}({params}) -> {ret} { {body} }"
  definition_exported: "pub fn {name}({params}) -> {ret} { {body} }"
  definition_void: "fn {name}({params}) { {body} }"
  param_with_type: "{name}: {type}"
  param_separator: ", "
}

data rust_type_applications: TypeApplicationSyntax = {
  optional: "Option<{element}>"
}

data rust_type_defs: TypeDefinitionSyntax = {
  struct_def: "#[derive(Clone, Debug)]\npub struct {name} { {fields} }"
  struct_field: "pub {name}: {type},"
  enum_def: "#[derive(Clone, Debug)]\npub enum {name} { {variants} }"
  enum_unit_variant: "{name},"
  enum_data_variant: "{name} { {fields} },"
}

data rust_record_derive_templates: RecordDeriveTemplateBundle = {
  struct_def_no_debug: "#[derive(Clone)]\npub struct {name} { {fields} }"
  enum_def_no_debug: "#[derive(Clone)]\npub enum {name} { {variants} }"
}

data rust_patterns: PatternMatchSyntax = {
  match_expr: "match {expr} { {arms} }"
  match_arm: "{pattern} => {body},"
  variant_pattern: "{name} {{ {bindings} }}"
  variant_pattern_positional: "{name}({binding})"
  variant_pattern_empty: "{name}"
  field_binding: "{field}: {binding}"
  field_binding_separator: ", "
  wildcard: "_"
}

data rust_collection_ops: CollectionOps = {
  concat: "{ let mut __left = {left}; __left.extend({right}); __left }"
  length: "({recv}).len() as i64"
  is_empty: "({recv}).is_empty()"
  fold: "({recv}).iter().fold({init}, {body})"
  map: "({recv}).iter().map({body}).collect::<Vec<_>>()"
  filter: "{ let mut __out = Vec::new(); for {item} in ({recv}).iter() { if {predicate} { __out.push({item_push}); } } __out }"
  contains: "({recv}).contains({item})"
  empty_list: "Vec::new()"
  list_literal: "vec![{elements}]"
  cons: "{ let mut __list = {tail}; __list.insert(0, {head}); __list }"
}

data rust_value_construction: ValueConstructionSyntax = {
  struct_literal: "{type} {{ {fields} }}"
  struct_field_init: "{name}: {value}"
  struct_field_separator: ", "
  variant_construction: "{variant}({args})"
  variant_named_construction: "{variant} {{ {fields} }}"
}

data rust_rendering: RenderingModel = {
  read: Borrow
  construct: CopyOrClone
}

data rust_language: LanguageSpec = {
  statements: rust_statements
  expressions: rust_expressions
  control_flow: rust_control_flow
  literals: rust_literals
  modules: rust_modules
  functions: rust_functions
  type_applications: rust_type_applications
  type_definitions: rust_type_defs
  record_derive_templates: rust_record_derive_templates
  patterns: rust_patterns
  collection_ops: rust_collection_ops
  values: rust_value_construction
}

// ─────────────────────────────────────────────────────────────────
// Clean-emission contract (E-5 / Lane 1 Stage 1c).
// ─────────────────────────────────────────────────────────────────
//
// Per-target rule choices for the E-5 invariant. Emitters read this
// contract to shape emitted code so it passes `rustc -D warnings`
// by construction. See `docs/design-clean-emission-contract.md`
// (DB-4) for the full contract shape and `INVARIANTS.md §E-5` for
// the "no escape hatches" commitment.
//
// **Dispatch state at this PR (Lane 1 Stage 1c PR 1):**
// - `pattern_bindings` is LIVE — `emit_rust::render_branch_pattern`
//   dispatches on it for the unused-payload-binding pilot.
// - `variant_payload_field_access` is LIVE — `emit_rust` routes
//   named variant-payload field reads through match-site field
//   bindings because Rust cannot hold anonymous struct-variant
//   payloads as first-class values.
// - Every other field is authored-but-unread. Each field has a
//   named rollout: the emitter change that consumes it removes
//   the corresponding lint from the test-wrapper allow list in
//   the same PR (Lane 1d/1e consolidation).

data rust_correction_style: CorrectionStyle = {
  indent_unit: "    "
  line_ending: "\n"
  string_quote: "%Q"
  trailing_semicolon: true
}

data rust_clean_emission: CleanEmissionContract = {
  expression_wrapping: WrapOnlyInOperandPosition
  pattern_bindings: EmitUnderscoreWhenUnused
  variant_payload_field_access: OverrideNamedFieldsAtBindingSite
  imports: IncludeOnlyReferenced
  block_return: NoWrappingOnTerminalExpression
  variable_bindings: EmitLetUnderscoreWhenUnused
  match_arm_body: NoWrappingOnNonComplexBody
  correction_style: rust_correction_style
  post_emit_verifier: {
    command: "rustc"
    args: ["--edition=2021", "-D", "warnings"]
    syntax_only: false
    expected_exit_code: 0
    output_policy: IgnoreVerifierOutput
  }
}

data rust_clean_emission_binding: TargetCleanEmissionBinding = {
  language: rust_language
  clean_emission: rust_clean_emission
}

// ─────────────────────────────────────────────────────────────────
// DB-14 substrate accessor realizations (Rust target).
// ─────────────────────────────────────────────────────────────────
//
// Each accessor's Rust implementation is a method on `Dag` declared
// in `src/v3/compiler/src/dag.rs`. The carrier templates below are
// substituted per call-site by `emit_rust::render_substrate_accessor`,
// which looks the accessor up in a per-target index built from the
// `SubstrateAccessorBinding` records below (filtered by
// `language == rust_language`). Go/Python land when those emitters
// register their own bindings.
//
// Placeholder convention: `{pN}` is the N-th input expression at the
// call-site. The emitter substitutes them positionally so carriers
// stay independent of the accessor fn's source-level param names.

data rust_port_accessor: SubstrateAccessorRealization = {
  carrier: "({p0}).port_opt({p1}).cloned()"
}

data rust_node_accessor: SubstrateAccessorRealization = {
  carrier: "({p0}).node_opt({p1}).cloned()"
}

data rust_resolve_producer_accessor: SubstrateAccessorRealization = {
  carrier: "({p0}).resolve_producer_opt({p1}).cloned()"
}

data port_binding_rust: SubstrateAccessorBinding = {
  accessor: port
  realization: rust_port_accessor
  language: rust_language
}

data node_binding_rust: SubstrateAccessorBinding = {
  accessor: node
  realization: rust_node_accessor
  language: rust_language
}

data resolve_producer_binding_rust: SubstrateAccessorBinding = {
  accessor: resolve_producer
  realization: rust_resolve_producer_accessor
  language: rust_language
}

// `{p1}` is whatever `emit_rust` renders for the accessor’s second transform
// input — for `lane2_workflow_at` that is the **borrow** of the workflow root
// (`&NodeId`, same convention as `node_opt` / `port_opt`), not a by-value
// `NodeId`. Emitted idempotency lens: `fn analyze_workflow(p0: &Dag, p1: &NodeId)`
// → `(p0).lane2_workflow_effect_at(p1)` type-checks against
// `lane2_workflow_effect_at(&self, root: &NodeId)`; see
// `tests/m2_lens_idempotency_migration_test.rs` (rustc round-trip).
data rust_lane2_workflow_accessor: SubstrateAccessorRealization = {
  carrier: "({p0}).lane2_workflow_effect_at({p1}).cloned()"
}

data lane2_workflow_at_binding_rust: SubstrateAccessorBinding = {
  accessor: lane2_workflow_at
  realization: rust_lane2_workflow_accessor
  language: rust_language
}

// `declaration_by_id(d: Dag, id: DeclarationId) -> Declaration?` —
// id-keyed parity with `port` / `node`. Host realization is
// `Dag::declaration_opt(&DeclarationId)`; `.cloned()` mirrors the
// `port` / `node` accessor shape so the reflected `Declaration?`
// return type carries owned data at the substrate boundary.
data rust_declaration_by_id_accessor: SubstrateAccessorRealization = {
  carrier: "({p0}).declaration_opt({p1}).cloned()"
}

data declaration_by_id_binding_rust: SubstrateAccessorBinding = {
  accessor: declaration_by_id
  realization: rust_declaration_by_id_accessor
  language: rust_language
}
