  target: BranchNode
  carrier: "BranchNode"
  fields: [
    { dag_name: "id", rust_access: DirectField("id") },
    { dag_name: "input", rust_access: DirectField("input") },
    { dag_name: "paths", rust_access: DirectField("paths") },
    { dag_name: "result_port", rust_access: AccessorMethod("result_port") },
    { dag_name: "span", rust_access: DirectField("span") }
  ]
  cost: 1
}

data rust_loop_node: TypeRealization = {
  target: LoopNode
  carrier: "LoopNode"
  fields: [
    { dag_name: "id", rust_access: DirectField("id") },
    { dag_name: "source", rust_access: DirectField("source") },
    { dag_name: "init", rust_access: DirectField("init") },
    { dag_name: "body", rust_access: DirectField("body") },
    { dag_name: "bound", rust_access: DirectField("bound") },
