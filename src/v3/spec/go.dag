data go_int_le: OperatorRealization = {
  target: Int
  op: OrderedRing.le
  carrier: "<="
  cost: 1
}

data go_int_gt: OperatorRealization = {
  target: Int
  op: OrderedRing.gt
  carrier: ">"
  cost: 1
