module v3.spec.go

import v3.spec.v3_l1 { Bind, Branch, Main }
import v3.std.emit_model {
  TypeRealization, FieldBinding, FieldAccess,
  OperatorRealization, BehaviorRealization, CallableRealization,
  TypeInstantiationRealization, CallableStrategy,
  ParameterDisposition, Borrowed, Consumed,
  PatternRealization, PatternStrategy,
  StatementSyntax, ExpressionSyntax, ControlFlowSyntax,
  LiteralSyntax, ModuleSyntax, FunctionSyntax, TypeApplicationSyntax,
  TypeDefinitionSyntax, PatternMatchSyntax, CollectionOps,
  ValueConstructionSyntax, RenderingModel, LanguageSpec
}
import v3.std.computation_model {
  TargetExecutionModel, GarbageCollected, LexicalScoping
}
import std.list { List }

data go_execution_model: TargetExecutionModel = {
  memory: GarbageCollected
  scope: LexicalScoping
}

data go_int: TypeRealization = {
  target: Int
  carrier: "int64"
  is_copy: true
  fields: []
  cost: 1
}

data go_bool: TypeRealization = {
  target: Bool
  carrier: "bool"
  is_copy: true
  fields: []
  cost: 1
}

