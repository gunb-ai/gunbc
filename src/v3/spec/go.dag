data go_let_stmt: BehaviorRealization = {
  target: Bind
  carrier: "var {name} {type} = {value}"
  cost: 0
}

data go_if_expr: BehaviorRealization = {
  target: Branch
  carrier: "if {cond} { {then} } else { {else} }"
  cost: 0
}

data go_main_wrap: BehaviorRealization = {
  target: Main
  carrier: "func main() {\n{body}\nfmt.Println({final})\n}"
  cost: 0
}

data go_empty_callable: CallableRealization = {
  target: empty
  strategy: ListEmpty
  parameter_dispositions: []
  cost: 1
}

data go_singleton_callable: CallableRealization = {
  target: singleton
  strategy: ListSingleton
  parameter_dispositions: [Consumed]
  cost: 1
}

data go_cons_callable: CallableRealization = {
  target: cons
  strategy: ListCons
  parameter_dispositions: [Consumed, Consumed]
  cost: 1
}

data go_concat_callable: CallableRealization = {
  target: concat
  strategy: ListConcat
  parameter_dispositions: [Consumed, Consumed]
  cost: 1
}

data go_length_callable: CallableRealization = {
  target: length
  strategy: ListLength
  parameter_dispositions: [Borrowed]
  cost: 1
}

data go_list_instantiation: TypeInstantiationRealization = {
  target: List
  carrier: "[]{element}"
  cost: 1
}

data go_map_instantiation: TypeInstantiationRealization = {
  target: Map
  carrier: "map[{key}]{value}"
  cost: 1
}

data go_is_empty_callable: CallableRealization = {
  target: is_empty
  strategy: ListIsEmpty
  parameter_dispositions: [Borrowed]
  cost: 1
}

data go_fold_callable: CallableRealization = {
  target: fold
  strategy: ListFold
  parameter_dispositions: [Borrowed, Consumed]
  cost: 1
}

data go_map_callable: CallableRealization = {
  target: map
  strategy: ListMap
  parameter_dispositions: [Borrowed]
  cost: 1
}

data go_filter_callable: CallableRealization = {
  target: filter
  strategy: ListFilter
  parameter_dispositions: [Borrowed]
  cost: 1
}

data go_contains_callable: CallableRealization = {
  target: contains
  strategy: ListContains
  parameter_dispositions: [Borrowed, Borrowed]
  cost: 1
}

data go_list_pattern: PatternRealization = {
  target: List
  strategy: VectorList
  scrutinee: "{expr}"
  empty_pattern: "len({expr}) == 0"
  cons_pattern: "{expr}"
  head_expr: "{list}[0]"
  tail_expr: "{list}[1:]"
  cost: 1
}

data go_statements: StatementSyntax = {
  let_binding: "var {name} {type} = {value}"
  let_binding_inferred: "{name} := {value}"
}

data go_expressions: ExpressionSyntax = {
  binary_op: "({lhs} {op} {rhs})"
  field_access: "({object}).{field}"
  function_call: "{func}({args})"
  closure: "func({params}) { return {body} }"
}

data go_control_flow: ControlFlowSyntax = {
  if_else: "if {cond} { {then} } else { {else} }"
  match_arm: "{pattern}: return {body}"
  for_each_syntax: { prefix: "for _, ", separator: " := range " }
}

data go_literals: LiteralSyntax = {
  true_keyword: "true"
  false_keyword: "false"
  string_delimiter: "%Q"
}

data go_modules: ModuleSyntax = {
  path_separator: "."
}

data go_functions: FunctionSyntax = {
  definition: "func {name}({params}) {ret} { return {body} }"
  definition_void: "func {name}({params}) { {body} }"
  param_with_type: "{name} {type}"
  param_separator: ", "
}

data go_type_applications: TypeApplicationSyntax = {
  optional: "*{element}"
}

data go_type_defs: TypeDefinitionSyntax = {
  struct_def: "type {name} struct { {fields} }"
  struct_field: "{name} {type}"
  enum_def: "type {name} interface{}"
  enum_unit_variant: "{name}"
  enum_data_variant: "{name}"
}

data go_patterns: PatternMatchSyntax = {
  match_expr: "{expr}"
  match_arm: "{pattern}: return {body}"
  variant_pattern: "{name}"
  variant_pattern_positional: "{name}"
  variant_pattern_empty: "{name}"
  field_binding: "{field}: {binding}"
  field_binding_separator: ", "
  wildcard: "_"
}

data go_collection_ops: CollectionOps = {
  concat: "append({left}, {right}...)"
  length: "int64(len({recv}))"
  is_empty: "len({recv}) == 0"
  fold: "/* fold({recv}, {init}, {body}) */"
  map: "/* map({recv}, {body}) */"
  filter: "/* filter({recv}, {body}) */"
  contains: "/* contains({recv}, {item}) */"
  empty_list: "nil"
  list_literal: "[]{element_type}{{{elements}}}"
  cons: "append([]{element_type}{{{head}}}, {tail}...)"
}

data go_value_construction: ValueConstructionSyntax = {
  struct_literal: "{type}{{ {fields} }}"
  struct_field_init: "{name}: {value}"
  struct_field_separator: ", "
  variant_construction: "{variant}({args})"
  variant_named_construction: "{variant}{{ {fields} }}"
}

data go_rendering: RenderingModel = {
  read: PassByValue
  construct: PassByValue
}

data go_language: LanguageSpec = {
  statements: go_statements
  expressions: go_expressions
  control_flow: go_control_flow
  literals: go_literals
  modules: go_modules
  functions: go_functions
  type_applications: go_type_applications
  type_definitions: go_type_defs
  patterns: go_patterns
  collection_ops: go_collection_ops
  values: go_value_construction
}
