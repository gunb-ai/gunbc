module v3.spec.python

import v3.spec.v3_l1 { DeclarationRef }
import v3.std.substrate {
  NodeId, PortId, DeclarationId, SourceSpan, DagPort, Dag, ValueNode,
  TransformNode, BranchNode, LoopNode, BindNode, BranchPath, Behavior
}
import std.list {
  List, empty, singleton, cons, concat, length, is_empty, fold, map, filter, contains
}
import std.algebra { OrderedRing }
import v3.std.computation_model {
  TargetExecutionModel, MemoryModel,
  GarbageCollected, LexicalScoping
}
import v3.std.emit_model {
  TypeRealization, OperatorRealization, CallableRealization,
  TypeInstantiationRealization, PatternRealization, CallableStrategy,
  PatternStrategy, CallableParameter, ParameterDisposition,
  Borrowed, Consumed,
  StatementSyntax, ExpressionSyntax, ControlFlowSyntax, ForEachSyntax,
  LiteralSyntax, ModuleSyntax, FunctionSyntax, TypeApplicationSyntax,
  TypeDefinitionSyntax, PatternMatchSyntax, CollectionOps,
  ValueConstructionSyntax, LanguageSpec
}
import v3.std.clean_emission {
  CleanEmissionContract,
  ExpressionWrappingRule, WrapOnlyInOperandPosition,
  PatternBindingRule, NotApplicablePatternBinding,
  ImportRule, IncludeOnlyReferenced,
  BlockReturnRule, ExplicitReturnKeyword,
  VariableBindingRule, EmitLetBindingAlways,
  MatchArmBodyRule, NotApplicableMatchArmBody,
  CorrectionStyle, PostEmitVerifier,
  VerifierOutputPolicy, IgnoreVerifierOutput
}

data python_statements: StatementSyntax = {
  let_binding: "{name} = {value}"
  let_binding_inferred: "{name} = {value}"
}

data python_expressions: ExpressionSyntax = {
  binary_op: "({lhs} {op} {rhs})"
  field_access: "{object}.{field}"
  function_call: "{func}({args})"
  closure: "lambda {params}: {body}"
}

data python_control_flow: ControlFlowSyntax = {
  if_else: "({then} if {cond} else {else})"
  match_arm: "{pattern}: {body}"
  for_each_syntax: {
    prefix: "for {item} in {iter}:\n{body}"
    separator: "\n"
  }
}

data python_literals: LiteralSyntax = {
  true_keyword: "True"
  false_keyword: "False"
  string_delimiter: "%Q"
}

data python_modules: ModuleSyntax = {
  path_separator: "."
}

data python_functions: FunctionSyntax = {
  definition: "def {name}({params}) -> {ret}:\n    return {body}"
  definition_void: "def {name}({params}) -> None:\n    {body}"
  param_with_type: "{name}: {type}"
  param_separator: ", "
}

data python_type_applications: TypeApplicationSyntax = {
  optional: "typing.Optional[{element}]"
}

data python_type_definitions: TypeDefinitionSyntax = {
  struct_def: "@dataclass\nclass {name}:\n{fields}"
  struct_field: "{name}: {type}"
  enum_def: "class {name}:\n    pass\n\n{variants}"
  enum_unit_variant: "@dataclass\nclass {name}({parent}):\n    pass"
  enum_data_variant: "@dataclass\nclass {name}({parent}):\n{fields}"
}

data python_patterns: PatternMatchSyntax = {
  match_expr: "match {expr} { {arms} }"
  match_arm: "{pattern}: {body}"
  variant_pattern: "{name}({bindings})"
  variant_pattern_positional: "{name}({binding})"
  variant_pattern_empty: "{name}()"
  field_binding: "{field}={binding}"
  field_binding_separator: ", "
  wildcard: "_"
}

data python_collections: CollectionOps = {
  empty_list: "[]"
  list_literal: "[{elements}]"
  cons: "[{head}, *{tail}]"
  concat: "[*{left}, *{right}]"
  length: "len({recv})"
  is_empty: "(len({recv}) == 0)"
  fold: "__v3_fold({recv}, {init}, {body})"
  map: "[{body} for {item} in {recv}]"
  filter: "[{item_push} for {item} in {recv} if {predicate}]"
  contains: "({item} in {recv})"
}

data python_value_construction: ValueConstructionSyntax = {
  struct_literal: "{name}({fields})"
  struct_field_init: "{field}={value}"
  struct_field_separator: ", "
  variant_construction: "{name}()"
  variant_named_construction: "{name}({fields})"
}

data python_language: LanguageSpec = {
  statements: python_statements
  expressions: python_expressions
  control_flow: python_control_flow
  literals: python_literals
  modules: python_modules
  functions: python_functions
  type_applications: python_type_applications
  type_definitions: python_type_definitions
  patterns: python_patterns
  collection_ops: python_collections
  values: python_value_construction
}

data python_target: TargetExecutionModel = {
  memory: GarbageCollected
  scope: LexicalScoping
}

data python_int: TypeRealization = {
  language: python_language
  target: Int
  carrier: "int"
  is_copy: true
  fields: []
  cost: 1
}

