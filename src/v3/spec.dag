module v3.spec

// The DAG is a causal system. Nodes are events. Edges are causal links.
// Values flow forward through edges. The system is finite and closed.
//
// Conservation laws fall out of this structure:
//   - No perpetual motion (termination)
//   - No duplication of matter (ownership)
//   - No effect before cause (causality)
//   - No opaque interaction (complexity)
//   - No contradiction (type safety)
//
// A program with contradictions cannot be constructed — the causal
// structure won't admit it, the same way a physics engine can't
// produce a trajectory that violates conservation of energy.
//
// The compiler is a physics engine: it simulates signal flow through
// the DAG and rejects graphs that violate conservation.


// === THE SUBSTRATE ===

// The bound. All signals are finite. Closed system.
data max_signal: Int = 9223372036854775807

// An event in the causal graph.
type NodeId = Int
type Span { file: String, start: Int, end: Int }

type Node {
  id: NodeId
  span: Span
  edges: List<Edge>
}

// A causal link. Carries a value from source to target.
// The force (SVR) describes how the value transforms along this link.
type Edge {
  target: NodeId
  force: Force
}

// The force on an edge: how the target value relates to the source.
// This is the fundamental property that determines everything downstream:
// whether cycles terminate, who owns what, what can run in parallel.
//
// Dissipative:  target is strictly smaller than source (energy lost)
// Conservative: target preserves source (energy conserved)
// Unknown:      unmeasured (fail-closed: assume worst case)
type Force
  = Dissipative { kind: DissipationKind }
  | Conservative
  | Unmeasured

// How dissipation happens — observable from the causal structure.
type DissipationKind
  = StructuralShrink { field: FieldRef, rate: ShrinkRate }
  | CollectionElement { field: FieldRef }
  | ArithmeticReduction { param: ParamRef, rate: ShrinkRate }

// How fast energy dissipates. Determines complexity: O(n) vs O(log n).
type ShrinkRate
  = Linear                        // decrease by 1 per step
  | StepK { amount: Int }         // decrease by k per step
  | Logarithmic { divisor: Int }  // decrease by factor per step

// References into the causal graph.
type FieldRef { type_id: NodeId, field_name: String }
type ParamRef { func_id: NodeId, index: Int }


// === CONSERVATION LAWS ===
//
// These are not "checks" the compiler performs. They are properties
// that HOLD when the causal structure is well-formed. The compiler
// verifies well-formedness — the laws follow.

// LAW 1: NO PERPETUAL MOTION (termination)
//
// Every cycle in the causal graph must have net dissipation.
// If every edge in a cycle is Conservative or Unmeasured, the cycle
// could run forever — perpetual motion. At least one edge must be
// Dissipative, proving the cycle will eventually halt.
//
// This is conservation of energy: you can't sustain a cycle without
// spending energy. The energy budget is the input size, and each
// Dissipative edge spends some of it.
//
// The compiler detects cycles (SCCs in the call graph) and checks
// that each cycle has net dissipation. That's termination.

// LAW 2: NO DUPLICATION (ownership)
//
// A value produced at a node flows out through edges. Each value is
// produced once. If multiple edges consume the same value, it must
// be explicitly shared (copied) — you can't have two consumers of
// the same physical thing without acknowledging the copy.
//
// This is conservation of matter: matter can't be in two places.
// The compiler counts how many edges consume each value (fan-out).
// Fan-out = 1: sole owner, can move. Fan-out > 1: must copy.
type OwnershipKind = Owned | Borrowed | Shared

fn ownership_from_force(f: Force) -> OwnershipKind {
  match f {
    Dissipative { kind: _ } => Borrowed
    Conservative => Owned
    Unmeasured => Shared
  }
}

// LAW 3: NO EFFECT BEFORE CAUSE (causality)
//
// Edges are directed. A node can only depend on nodes that precede
// it in the causal order. The graph is a DAG (or cycles with proven
// termination). Effects can't precede their causes.
//
// This gives us effect ordering for free: if node A has an effect
// and node B depends on A, B's effect comes after A's. Independent
// nodes (no causal link) can execute in any order — parallelism
// falls out of the absence of causal constraint.
type EffectLevel
  = Inert                 // no effect on the outside world
  | Observes              // reads external state
  | Modifies              // writes external state

fn effect_join(a: EffectLevel, b: EffectLevel) -> EffectLevel {
  match a {
    Modifies => Modifies
    Observes => match b { Modifies => Modifies  _ => Observes }
    Inert => b
  }
}

// Effect shape: determines if a causal chain is idempotent.
// Lattice operations (upsert, delete) are idempotent — repeating
// them doesn't change the result. Monoid operations (append, create)
// are not — repeating them accumulates.
type EffectShape
  = LatticeEffect
  | MonoidEffect
  | IdentityEffect

fn is_idempotent(shape: EffectShape) -> Bool {
  match shape { LatticeEffect => true  IdentityEffect => true  MonoidEffect => false }
}

fn compose_shapes(a: EffectShape, b: EffectShape) -> EffectShape {
  match a {
    MonoidEffect => MonoidEffect
    LatticeEffect => match b { MonoidEffect => MonoidEffect  _ => LatticeEffect }
    IdentityEffect => b
  }
}

// LAW 4: NO OPAQUE INTERACTION (complexity)
//
// Every edge has a measurable force. Every node's cost is the
// composition of its incoming edge costs. Nothing is hidden from
// the compiler — the causal graph IS the complete description of
// the computation. There is no "runtime magic" or "external oracle."
//
// This means complexity is ALWAYS known. A function's cost is the
// product of the dissipation rates along its causal path. The
// compiler reads the forces and computes the bound.
//
// O(n) = one Dissipative edge with Linear rate in a cycle
// O(n log n) = nested: Linear outer × Logarithmic inner
// O(n²) = nested: Linear outer × Linear inner (the compiler flags this)
//
// No separate "complexity pass" needed. The forces on edges
// already encode the cost. The compiler just reads them.

// LAW 5: NO CONTRADICTION (type safety)
//
// Every edge connects compatible types. A node that produces an
// Integer can't feed into a node that expects a String — the
// causal link would be incoherent, like connecting a water pipe
// to an electrical socket. The compiler verifies that every edge
// connects compatible endpoints.
//
// Exhaustiveness is a special case: a coproduct (tagged signal)
// must have every tag handled. Missing a tag = a signal with no
// handler = energy with no drain = violation of conservation.


// === WHAT FALLS OUT ===
//
// From these 5 laws + the causal structure:
//
// Parallelism:
//   Nodes with no causal link are independent → can execute in any
//   order → parallelism is the DEFAULT. Sequential execution requires
//   a causal link to justify it.
//
// Memoization:
//   An Inert node with known cost and deterministic inputs → the
//   same input always produces the same output → cacheable.
//
// Algebraic simplification:
//   f followed by f⁻¹ = no net effect (like a wave reflecting).
//   f followed by f = f if LatticeEffect (idempotent).
//   The compiler reads the effect shapes and simplifies.
//
// Space bounds:
//   If complexity is known (Law 4) and all data is finite (max_signal),
//   maximum memory = computed from the cost bound. Stack depth =
//   maximum cycle depth. All derivable.
//
// Verification:
//   Every node's inputs and outputs are known. The compiler can
//   generate test inputs (finite types are enumerable) and verify
//   that actual behavior matches declared behavior.


// === COMPILER OBSERVATIONS ===
//
// Labels the compiler assigns for communication (diagnostics, emission).
// These don't change the physics — they name what the laws already guarantee.

type Diagnostic {
  span: Span
  message: String
  fix: SuggestedFix?
}

type SuggestedFix {
  description: String
  replacement: String
  span: Span
}

// Surface forms: what the parser observed about syntax.
// Side table: Map<NodeId, SurfaceForm>. Not on Node itself.
type SurfaceForm
  = FormModule { name: String }
  | FormImport { path: String, names: List<String> }
  | FormType { name: String }
  | FormFunc { name: String, is_async: Bool }
  | FormData { name: String }
  | FormService { name: String }
  | FormLiteral { value: LiteralValue }
  | FormVar { name: String }
  | FormCall
  | FormMethodCall { method: String }
  | FormMatch
  | FormIf
  | FormLet { name: String }
  | FormLambda
  | FormBlock
  | FormFieldAccess { field: String }
  | FormBinOp { op: BinOp }
  | FormUnaryOp { op: UnaryOp }
  | FormRecordLit { type_name: String }
  | FormListLit
  | FormStringInterp
  | FormForEach { binding: String }
  | FormIndex
  | FormReturn
  | FormParam { name: String }
  | FormArg { name: String }
  | FormArm
  | FormFieldInit { name: String }
  | FormVariant { name: String }
  | FormField { name: String }

type LiteralValue
  = LitInt { value: Int }
  | LitFloat { value: Float }
  | LitString { value: String }
  | LitBool { value: Bool }

type BinOp
  = Add | Sub | Mul | Div | Mod
  | Eq | Neq | Lt | Gt | Lte | Gte
  | And | Or
  | Concat

type UnaryOp = Not | Neg

type PatternForm
  = PatBind { name: String }
  | PatLiteral { value: LiteralValue }
  | PatVariant { name: String, parent: String?, bindings: List<String> }
  | PatWildcard


// === PIPELINE ===

type Source { path: String, text: String }

type ParseResult {
  nodes: Map<NodeId, Node>
  surface: Map<NodeId, SurfaceForm>
  patterns: Map<NodeId, PatternForm>
  diagnostics: List<Diagnostic>
  intern: InternTable
}

type InternTable {
  strings: List<String>
  index: Map<String, Int>
}

type ResolvedGraph {
  nodes: Map<NodeId, Node>
  surface: Map<NodeId, SurfaceForm>
  patterns: Map<NodeId, PatternForm>
  call_graph: Map<NodeId, List<NodeId>>
  bindings: Map<NodeId, TypeBinding>
  inductive_fields: Map<NodeId, List<InductiveField>>
  func_sigs: Map<NodeId, FuncSig>
  diagnostics: List<Diagnostic>
}

type TypeBinding {
  id: NodeId
  resolved_type: TypeRef
  force: Force
}

type InductiveField {
  field: FieldRef
  field_type: TypeRef
}

type FuncSig {
  id: NodeId
  params: List<FuncParam>
  return_type: TypeRef
  is_async: Bool
  output_forces: Map<String, Force>
}

type FuncParam { name: String, id: NodeId, type_ref: TypeRef }

type TypeRef
  = NamedType { name: String, args: List<TypeRef> }
  | FuncType { params: List<TypeRef>, result: TypeRef }
  | OptionalType { inner: TypeRef }

type ProvenGraph {
  nodes: Map<NodeId, Node>
  surface: Map<NodeId, SurfaceForm>
  patterns: Map<NodeId, PatternForm>
  call_graph: Map<NodeId, List<NodeId>>
  bindings: Map<NodeId, TypeBinding>
  func_sigs: Map<NodeId, FuncSig>
  ownership: Map<NodeId, OwnershipKind>
  effects: Map<NodeId, EffectLevel>
  diagnostics: List<Diagnostic>
}

type LanguageSpec {
  name: String
  file_extension: String
  sharing: SharingStrategy
}

type SharingStrategy
  = ReferenceCounted
  | GarbageCollected
  | ValueSemantics
  | BorrowChecked

type TargetFile { path: String, content: String }
type EmitResult { files: List<TargetFile>, diagnostics: List<Diagnostic> }
