module v3.std.diagnostics

import std.list { List }
import v3.std.substrate { SourceSpan }

// 🟡 SCAFFOLD. Mirrors the compiler's native diagnostic taxonomy until
// diagnostics themselves are surfaced as reflected declaration-shaped
// facts instead of a Rust enum.
type DiagnosticKind
  = TokenizerError
  | ParseError
  | TypeMismatch
  | ArityMismatch
  | ResolveError

// 🟢 TERMINAL for DB-1's source-level correction carrier. Corrections
// replace a span in user-authored `.dag` source with new `.dag`
// syntax; target-native fix syntax is deliberately out of scope.
type Correction {
  description: String
  span: SourceSpan
  new_source: String
}

// 🟡 SCAFFOLD until reflected diagnostics replace the compiler's
// native enum. The record shape is the authority for consumers that
// only need the diagnostic carrier, including `fixes`.
type Diagnostic {
  kind: DiagnosticKind
  span: SourceSpan
  message: String
  fixes: List<Correction>
}
