module v3.std.diagnostics

import std.list { List }
import v3.spec.v3_l1 { DeclarationRef }
import v3.std.substrate { SourceSpan, TypeShape }

// 🟡 SCAFFOLD. Mirrors the compiler's native diagnostic taxonomy for
// the staged v3 diagnostics surface. Kept distinct from
// `std.verification.DiagnosticKind` to avoid introducing a second
// imported top-level declaration with the same name during bootstrap.
// Dissolution trigger: reflected diagnostics or a shared diagnostic
// kind authority once the staged/bootstrap-local split disappears.
//
// Layer 1 (per `docs/design-lens-framework.md` Q6.5 two-layer
// authority): Substrate-Manager-owned closed sum of compiler-primitive
// diagnostic kinds. Layer-2 lens-instance kinds live separately under
// `DiagnosticKindDecl` / `LensInstanceKindWitness` below — they MUST
// NOT be added as variants here. Adding a Layer-1 kind is rare,
// design-locked, and requires SCAFFOLD-note acknowledgment of where
// the diagnostic surfaces.
type CompilerDiagnosticKind
  = TokenizerError
  | ParseError
  | TypeMismatch
  | ArityMismatch
  | ResolveError
  | UnitMismatch
  | BranchConditionNotBool
  | MagnitudeOutOfRange
  | MalformedIntegerRangeFact
  | NominalOpacityViolation

// 🟢 TERMINAL for DB-1's source-level correction carrier. Corrections
// replace a span in user-authored `.dag` source with new `.dag`
// syntax; target-native fix syntax is deliberately out of scope.
type Correction {
  description: String
  // Retained so future fix surfaces can point at the precise source
  // range the correction applies to. The current source-level
  // renderer only prints `new_source`.
  span: SourceSpan
  new_source: String
}

// Layer 2 lens-instance diagnostic-kind declaration (per
// `docs/design-lens-framework.md` Q6.5). A `DiagnosticKindDecl`
// appears inside the `diagnostic_kinds` list of an `inhabits Lens<C>`
// declaration; the containing inhabitance IS the owning lens (P2
// single-authority via structural containment, NOT via a duplicated
// `lens_instance` field). The decl's `name` MUST NOT collide with any
// `CompilerDiagnosticKind` Layer-1 variant name (anti-shadowing
// protocol per Q6.5 §Name-collision protocol).
//
// 🟡 TRANSITIONAL. Owner-by-containment is the structural authority,
// not a re-declared field. The decl name is a String today; refines
// to a typed `KindName` namespace-scoped to the parent lens once the
// substrate exposes namespace-typed identifiers.
type DiagnosticKindDecl {
  name: String
  payload: TypeShape
}

// Layer 2 lens-instance kind witness (per Q6.5 §Substrate change
// required). A structural pointer to a declared `DiagnosticKindDecl`.
//
// 🟡 SCAFFOLD coproduct (single-arm record). Pattern 1 (per-call
// payload typing) fails because the payload's TypeShape is dependent
// on the runtime-resolved `kind_decl.payload` field — `.dag` grammar
// today cannot express `payload: <inhabits kind_decl.payload>`
// (refinement-type-on-sibling-field). Pattern 2 (collapse to a flat
// `{ kind_decl, payload_kind_shape }` record with a free `TypeShape`
// payload coordinate) ratifies exactly the parallel-authority illegal
// state Q6.5's §State-space discipline rejected — three independent
// coordinates (lens / name / payload-shape) that admit
// `(Lens<TenantFlow>, "WrongName", payload-of-different-shape)`.
// Pattern 3 is the dissolution path: when refinement/dependent field
// typing OR declaration-shaped inhabitance witnesses land in the .dag
// substrate, this carrier grows a checked `payload` value field
// constrained to inhabit the shape `kind_decl.payload` names; until
// then the witness is decl-only — Layer-2 kind identity and
// namespace authority are present, but the structured payload value
// is intentionally NOT carried through the substrate. Trigger:
// dependent-field typing or substrate inhabitance witnesses lower
// without hand-Rust scaffolding.
//
// Note on `kind_decl` typing: bare `DeclarationRef` admits any
// declaration. The structural constraint (\"must resolve to a
// `DiagnosticKindDecl` whose parent is the owning `Lens<C>`
// inhabitance\") is checked fail-closed at the runtime resolution
// boundary — same residual class as `PatternRealization` (`emit_model.dag`
// lines 140–152, where `empty_variant`/`cons_variant` admit any
// declaration but are validated as variants-of-target at parse time)
// and `MethodTemplateContract.dag_method` (`emit_model.dag:371`).
// Refining to `DeclarationRef<DiagnosticKindDecl>` is part of the
// SAME dissolution trigger above — substrate-level
// refinement-typing-on-DeclarationRef is the mechanism that closes
// both the payload-typing gap and the kind-decl resolution gap in
// one move.
type LensInstanceKindWitness {
  kind_decl: DeclarationRef
}

// Two-layer diagnostic-kind parent (Q6.5). `Diagnostic.kind` widens
// from `CompilerDiagnosticKind` to this sum so a single `Diagnostic`
// value can carry either Layer-1 (substrate-owned closed sum) or
// Layer-2 (lens-namespace-scoped) kinds without re-introducing a
// cross-manager handoff for lens-instance kind authoring.
//
// Anti-bridge invariant (Q6.5): adding a lens-instance kind MUST NOT
// extend `CompilerDiagnosticKind` — Layer-2 kinds enter via
// `LensInstanceKind(LensInstanceKindWitness)` exclusively. The closed
// Layer-1 sum stays the authority for compiler-primitive kinds only.
type AnyDiagnosticKind
  = CompilerKind(CompilerDiagnosticKind)
  | LensInstanceKind(LensInstanceKindWitness)

// 🟡 SCAFFOLD until reflected diagnostics replace the compiler's
// native enum. The record shape is the authority for consumers that
// only need the diagnostic carrier, including `fixes`.
//
// `kind: AnyDiagnosticKind` carries either Layer-1 (closed-sum
// compiler-primitive) or Layer-2 (lens-instance, namespace-scoped)
// kinds per Q6.5 two-layer authority.
type Diagnostic {
  kind: AnyDiagnosticKind
  span: SourceSpan
  message: String
  fixes: List<Correction>
}

// T-Ground-Diagnostic — substrate `EmissionDiagnostic` carrier
// (per `docs/briefs/t-ground-diagnostic.md` + #1216 + #1133 dispatch
// 4355793511). Closed sum of fold/emission failures the structural
// emission lane (Coercion-Fold + Lifetime-Analyzer + Cross-Target-Meta
// + downstream test crates) returns when emission cannot proceed.
//
// **Anti-bridge (Q6.5):** this is a SEPARATE carrier from
// `CompilerDiagnosticKind` and `AnyDiagnosticKind`. Fold failures do
// NOT extend `CompilerDiagnosticKind` (would violate Q6.5 + P2 single
// authority). Mapping `EmissionDiagnostic` → runtime
// `Diagnostic { kind: AnyDiagnosticKind, ... }` is a downstream
// consumer concern (Coercion-Fold + emit pipeline), not authored here.
//
// **P1 receipts** (per `INVARIANTS.md:94-129`):
//   - Step 1 (DAG-ancestor): home is `src/v3/std/diagnostics.dag` —
//     existing diagnostic-types module hosts the sibling Layer-1
//     `CompilerDiagnosticKind`, Layer-2 `LensInstanceKindWitness`, and
//     two-layer `AnyDiagnosticKind` parent. `EmissionDiagnostic` is a
//     fourth sibling sum: closed substrate-primitive carrier for
//     emission-pipeline failures, parallel to but disjoint from the
//     two-layer kind authority.
//   - Step 2 (coproduct-vs-coordinate): variants are alternatives —
//     one failure mode per fold-call. Resolution-hint payloads
//     (e.g. `unspecified_axis: String`) are coordinates of the
//     individual variant's record, not new arms.
//   - Step 3 (primitive-vs-lens-extensible): substrate-primitive
//     closed sum (compiler-internal fold/emission failures). NOT
//     lens-extensible — extending requires substrate-amendment
//     dispatch, parallel to `CompilerDiagnosticKind`.
//
// **Lane-local mirror migration receipts** (in flight per dispatch
// 4355793511; substrate-side carrier lands here, downstream PRs
// migrate the Rust mirrors):
//   - `v3-grounding-lifetime` lane-local `EmissionDiagnostic` (#1206)
//     — variants: `ContradictoryUse`, `UnderRefined`, `OutOfR2Scope`,
//     `LifetimeProgramExtractionPending`. Migrates here.
//   - `v3-grounding-coercion-fold` lane-local `EmissionDiagnostic`
//     (#1241) — variant: `FoldNotImplemented`. Migrates here.
//   - `v3-grounding-cross-target-meta` lane-local `EmissionDiagnostic`
//     (#1271) — variant: `MissingEmissionPath`. Migrates here.
//   - `v3-grounding-tests` lane-local `GroundingTestsDiagnostic`
//     (#1274/#1289) — Stratum-A test-side variants kept lane-local
//     for now (test-side outcomes carry test-specific shape; review
//     for migration in a follow-up dispatch).
type EmissionDiagnostic
  // Program intent or structural axis under-specified; consumer
  // authors a resolution hint via `unspecified_axis`. Covers
  // worked Examples 1 (`unspecified_axis: "bound"` for unrefined
  // `Int`) and 5 (`unspecified_axis: "algebra"` for algebra
  // ambiguity) per `design-emission-model.md` ~417-464 / ~639-680.
  // Lifetime-Analyzer also uses this for its axis-level
  // under-determination (`growability` / `ownership` / `encoding`).
  = UnderRefined { unspecified_axis: String }
  // Substrate declares no candidate covering the program's stated
  // refinement (Example 6 pattern; `design-emission-model.md`
  // ~684-731). Distinct from `UnderRefined` which is "program is
  // under-specified"; this is "substrate has no inhabitant for the
  // specified refinement."
  | NoInhabitant
  // Lifetime-Analyzer: a binding's use sites contradict each other
  // structurally (some require Owned, some require Borrowed, etc.).
  // Names the binding + the conflicting sites for the resolution
  // hint surface.
  | ContradictoryUse { binding: String, sites: List<String> }
  // Lifetime-Analyzer: program contains a construct outside R2
  // structural-ownership scope (closures / async / Pin / etc.).
  // Locked at `design-emission-model.md:635` to T-LensProducer-Retirement
  // (R3 fold-in). The construct name surfaces so the user/test sees
  // why the analyzer declined.
  | OutOfR2Scope { construct: String }
  // 🟡 TRANSITIONAL — Lifetime-Analyzer: `Dag` → `LifetimeProgram`
  // extraction wiring gap. Returning `Ok(empty)` would silently drop
  // load-bearing program shape (C-8). Detail string captures the
  // wiring stage. **Retires when Dag-extraction lands** (per #1218 /
  // #1247) — this variant is named here so the lane-local mirror
  // can remove it from its sum at the same time.
  | LifetimeProgramExtractionPending { detail: String }
  // 🟡 TRANSITIONAL — Coercion-Fold: full structural fold not yet
  // implemented; returning `Ok` would fabricate target choices
  // (C-8 / engine-retraction discipline). **Retires when Coercion-Fold
  // body lands** (per nimble-pike-489's Examples 1-7 dispatch) —
  // variant is a stub-failure surface for the in-flight fold.
  | FoldNotImplemented
  // CrossTarget-Meta L6: `(connective × behavior × target)` cell has
  // no LanguageSpec emission-path declaration. Each axis carries a
  // string label (substrate-anchored discriminant; resolved against
  // `TypeConnective` per #1229 anchor + `Behavior` per L1 model +
  // Shape A targets per `r2-grounding-manager.md` portability set).
  | MissingEmissionPath {
      connective: String,
      behavior: String,
      target: String
    }
