// std.lookup — partial-map application at a single key (1 + V).
//
// Ontological grounding: `dsl/std/algebra.dag` models `Map<K,V>` as
// `K -> (1 + V)`; applying the map at one key yields either absence
// (`Missing`) or a found value (`Found`). This is the shared carrier
// for every lens-local `MissingX | FoundX(T)` pair that only differed
// in label noise — see docs/thesis/compiler-std-consolidation.md
// (primary ratchet: strict two-variant Lookup pattern).
//
// Bootstrap staging: `src/v3/std/` until the v2 firewall dissolves and
// `dsl/std/` subsumes v3 std (same gate as `std.list` / `std.algebra`).
//
// `miss_int_lookup` / `hit_int_lookup` are Int-monomorphized helpers
// (v3 infer does not yet close generic `miss_lookup<value>` /
// `hit_lookup<value>` with body `Miss` / `Hit(v)`). Rust lens emission
// treats these two callables as `Lookup::Miss` / `Lookup::Hit` (see
// `emit_rust_target::render_general_callable`).

module v3.std.lookup

import std.types { Int }

// Generic sum: one authority for “absent vs present” at a typed value.
// Variant labels `Miss` / `Hit` mirror the thesis `Missing | Found(T)` naming.
type Lookup<value>
  = Miss
  | Hit(value)

fn miss_int_lookup() -> Lookup<Int> {
  Miss
}

fn hit_int_lookup(n: Int) -> Lookup<Int> {
  Hit(n)
}
