// v3.std.methods — typed `MethodRef` reference into the
// `dsl/std/methods.dag` registry.
//
// Companion to `dsl/std/methods.dag` which declares the
// `MethodDeclaration` carrier, the 64 algebra-template per-method
// `data` bindings, and any legacy v2 emit-map aliases (see that
// file's header for the alias convention and dissolution trigger).
// `MethodRef` lives here (not in `dsl/std/methods.dag`) because it
// references `DeclarationRef` from `v3.spec.v3_l1`, and `dsl/std/`
// stays v3-spec-free per the existing layering convention.

module v3.std.methods

import v3.spec.v3_l1 { DeclarationRef }

// 🟡 SCAFFOLD. Typed reference shape into the `dsl/std/methods.dag`
// registry. `decl` resolves to a top-level `MethodDeclaration` data
// binding in `std.methods`. The resolution check is enforced
// fail-closed at the boundary because today's substrate grammar
// can't express `DeclarationRef<MethodDeclaration>` (refinement-type-
// on-DeclarationRef). Same residual class as `PatternRealization`
// (`src/v3/std/emit_model.dag` lines 140–152, `empty_variant` /
// `cons_variant`) and `LensInstanceKindWitness.kind_decl` in
// `src/v3/std/diagnostics.dag`. Refining to
// `DeclarationRef<MethodDeclaration>` is part of the same
// dissolution trigger — substrate-level refinement-typing-on-
// DeclarationRef.
//
// `MethodTemplateContract.dag_method` (`src/v3/std/emit_model.dag`)
// refines from bare `DeclarationRef` (the #1175 substrate gap) to
// `MethodRef` so the field carries a structurally meaningful pointer
// at the registry rather than admitting any declaration.
type MethodRef {
  decl: DeclarationRef
}
