// v3.std.go_method_template_contracts -- per-method render-template
// rows for the Go target. See sibling
// `rust_method_template_contracts.dag` for the full scope / authority /
// home / convention notes.
//
// GO-SPECIFIC NOTES:
//   - The legacy emit authority (`go_method_templates: Map<String, String>`
//     in `dsl/extdeps/languages/go/emit.dag`) does not carry
//     `wraps_result`. Per Q4 four-property gate, every row's
//     `wraps_result` is structurally `false` for Go — declared
//     explicitly here, NOT silently inherited from Rust.
//   - `string_contains` is now classified as a target-only emit-shortcut
//     name in `dsl/std/methods.dag` (#1549 Gap 1 / R3 dispatch on parent
//     inbox #1130). The row below references `string_contains_method`
//     and renders Go's `strings.Contains({recv}, {arg})` for the
//     substring shape; this is structurally distinct from algebra
//     `contains` (collection membership).
//   - `{arg0}` → `{arg}` rewrite applied to runtime templates (`join`,
//     `split`); rows use `placeholder_convention: NamedArg` uniformly.
//   - `chars` is present only in `collection_method_translations`
//     (Go runtime). The runtime template `strings.Split({recv}, "")`
//     embeds an escaped empty-string literal (`\"\""`) which the
//     current `.dag` tokenizer fails to lower as a structural list
//     element (the body falls back to `ValueBody::Unparsed`). Skipping
//     the row in Phase 1 keeps the list lowerable; legacy Go runtime
//     authority continues serving v2 until Phase 2 retires it. The
//     escaped-empty-string handling is a tokenizer-level question
//     orthogonal to row population — flag for Phase 2 / parser-level
//     follow-up rather than block Phase 1 dispatch.
//   - Methods present only in `go_method_templates` (concat, map,
//     filter, any, all, flat_map, skip, take, fold, sort_by, append)
//     use the emit template for both row sides for the symmetric
//     reason.

module v3.std.go_method_template_contracts

import v3.std.emit_model {
  MethodTemplateContract,
  PlaceholderConvention,
  NamedArg,
  SingleTemplate
}
import v3.std.methods { MethodRef }
import std.methods {
  count_method,
  join_method,
  split_method,
  concat_method,
  map_method,
  filter_method,
  any_method,
  all_method,
  flat_map_method,
  skip_method,
  take_method,
  fold_method,
  is_empty_method,
  length_method,
  sort_by_method,
  append_method,
  string_contains_method
}

data go_language_spec_free_monoid_concat_contract: MethodTemplateContract = {
  dag_method: { decl: concat_method },
  runtime_template: "append({left}, {right}...)",
  emit_template: SingleTemplate { template: "append({left}, {right}...)" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data go_language_spec_free_monoid_length_contract: MethodTemplateContract = {
  dag_method: { decl: length_method },
  runtime_template: "int64(len({recv}))",
  emit_template: SingleTemplate { template: "int64(len({recv}))" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

// Emptiness — `dag_method` is `is_empty_method`; template is Go `len(...) == 0` sugar.
data go_language_spec_free_monoid_emptiness_contract: MethodTemplateContract = {
  dag_method: { decl: is_empty_method },
  runtime_template: "len({recv}) == 0",
  emit_template: SingleTemplate { template: "len({recv}) == 0" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

// **P2 single authority** for `fold_method` on the Go target: LanguageSpec
// `CollectionOps.fold_contract` uses the explicit `{recv}` / `{init}` / `{body}`
// stub. It does **not** repeat inside `go_method_template_contracts` below —
// that list row used `v2rt.Fold({recv}, {arg})` (different placeholder shape),
// a second parallel contract for the same registry method; see
// `docs/briefs/collectionops-algebra-reframe.md`.
data go_language_spec_free_monoid_fold_contract: MethodTemplateContract = {
  dag_method: { decl: fold_method },
  runtime_template: "/* fold({recv}, {init}, {body}) */",
  emit_template: SingleTemplate { template: "/* fold({recv}, {init}, {body}) */" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data go_method_template_contracts: List<MethodTemplateContract> = [
  {
    dag_method: { decl: count_method },
    runtime_template: "len({recv})",
    emit_template: SingleTemplate { template: "len({recv})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: join_method },
    runtime_template: "strings.Join({recv}, {arg})",
    emit_template: SingleTemplate { template: "strings.Join({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: split_method },
    runtime_template: "strings.Split({recv}, {arg})",
    emit_template: SingleTemplate { template: "strings.Split({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: concat_method },
    runtime_template: "append({recv}, {arg}...)",
    emit_template: SingleTemplate { template: "append({recv}, {arg}...)" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: map_method },
    runtime_template: "v2rt.Map({recv}, {arg})",
    emit_template: SingleTemplate { template: "v2rt.Map({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: filter_method },
    runtime_template: "v2rt.Filter({recv}, {arg})",
    emit_template: SingleTemplate { template: "v2rt.Filter({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: any_method },
    runtime_template: "v2rt.Any({recv}, {arg})",
    emit_template: SingleTemplate { template: "v2rt.Any({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: all_method },
    runtime_template: "v2rt.All({recv}, {arg})",
    emit_template: SingleTemplate { template: "v2rt.All({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: flat_map_method },
    runtime_template: "v2rt.FlatMap({recv}, {arg})",
    emit_template: SingleTemplate { template: "v2rt.FlatMap({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: skip_method },
    runtime_template: "{recv}[{arg}:]",
    emit_template: SingleTemplate { template: "{recv}[{arg}:]" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: take_method },
    runtime_template: "{recv}[:{arg}]",
    emit_template: SingleTemplate { template: "{recv}[:{arg}]" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: sort_by_method },
    runtime_template: "v2rt.SortBy({recv}, {arg})",
    emit_template: SingleTemplate { template: "v2rt.SortBy({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: append_method },
    runtime_template: "append({recv}, {arg})",
    emit_template: SingleTemplate { template: "append({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: string_contains_method },
    runtime_template: "strings.Contains({recv}, {arg})",
    emit_template: SingleTemplate { template: "strings.Contains({recv}, {arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  }
]
