module v3.std.bootstrap_authority

import std.types { FilePath }

// Generalized bootstrap authority membership for the committed full bootstrap
// snapshot. This is the substrate prerequisite for Verification row 82
// (`diagnostics_empty_after_bootstrap`): Verification should consume the
// `bootstrap_authority` map rather than re-deriving bootstrap membership from
// Rust fixture arrays or source globs.
//
// This carrier intentionally records membership only. It does not define the
// bootstrap process, load ordering, diagnostics policy, or row-82 TestClaim.

// 🟢 TERMINAL at current bootstrap membership scope. These categories are
// the five distinct source roots the committed bootstrap snapshot is built
// from today; each variant owns its path payload so category and path cannot
// drift as independent record fields. If a future bootstrap root appears, this
// coproduct must grow in the same PR as the authority row and ratchet.
type StdAuthorityPath = FilePath where pattern("^dsl/std/")
type V3StdAuthorityPath = FilePath where pattern("^src/v3/std/")
type V3SpecAuthorityPath = FilePath where pattern("^src/v3/spec/")
type CompilerAuthorityPath = FilePath where pattern("^src/v3/compiler/")
type ExtdepsFixtureAuthorityPath = FilePath where pattern("^dsl/extdeps/")

type BootstrapAuthority
  = StdAuthority { path: StdAuthorityPath }
  | V3StdAuthority { path: V3StdAuthorityPath }
  | V3SpecAuthority { path: V3SpecAuthorityPath }
  | CompilerAuthority { path: CompilerAuthorityPath }
  | ExtdepsFixtureAuthority { path: ExtdepsFixtureAuthorityPath }

// Map key is the canonical path and gives the set duplicate-free membership
// semantics. The value repeats the path inside the typed root variant because
// current structural maps do not project their key into the value payload.
// Dissolution trigger: replace the repeated value path with a dependent
// map-entry/key projection once substrate map entries can pass the key to the
// value type.
type BootstrapAuthoritySet = Map<String, BootstrapAuthority>

data bootstrap_authority: BootstrapAuthoritySet = {
  "dsl/std/logic.dag": StdAuthority { path: "dsl/std/logic.dag" },
  "dsl/std/bit.dag": StdAuthority { path: "dsl/std/bit.dag" },
