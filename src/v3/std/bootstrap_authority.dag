module v3.std.bootstrap_authority

import std.list { List }

// Generalized bootstrap authority membership for the committed full bootstrap
// snapshot. This is the substrate prerequisite for Verification row 82
// (`diagnostics_empty_after_bootstrap`): Verification should consume
// `bootstrap_authority.authorities` rather than re-deriving bootstrap
// membership from Rust fixture arrays or source globs.
//
// This carrier intentionally records membership only. It does not define the
// bootstrap process, load ordering, diagnostics policy, or row-82 TestClaim.

type BootstrapAuthorityKind
  = StdAuthority
  | V3StdAuthority
  | V3SpecAuthority
  | CompilerAuthority
  | ExtdepsFixtureAuthority

type BootstrapAuthority {
  kind: BootstrapAuthorityKind
  path: String
}

type BootstrapAuthoritySet {
  authorities: List<BootstrapAuthority>
}

data bootstrap_authority: BootstrapAuthoritySet = {
  authorities: [
    { kind: StdAuthority, path: "dsl/std/logic.dag" },
