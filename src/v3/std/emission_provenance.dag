// std.emission_provenance — typed carrier for "what produced this emitted line?"
//
// Status: STRUCTURALLY TERMINAL; BEHAVIORALLY DEFERRED.
//
// Per Director Q1 (a) RATIFIED at gunbc#1739 #issuecomment-4392562911:
// emission-provenance is analysis (a Lens<C> over physics), not runtime
// instrumentation. This file authors the typed carrier; the per-Behavior
// Lens<List<EmissionProvenance>> instance lives at lenses.emission_provenance.
//
// **Reshape rationale** (codex BLOCKING at PR #1910 sha 2ed1046e Finding
// #1, applied here): earlier typed-sum form `EmissionOrigin =
// SubstrateDeclMirror(SourceSpan) | FoldRuleAutoEmit(EmissionRule)`
// conflated two orthogonal axes. A single emitted line genuinely can have
// BOTH attributions (e.g., `#[derive(Debug)]` on an enum has rule =
// `derive_for_disj` AND source-span attribution to the enum declaration).
// Record (product) form with mandatory `rule` + optional `source_span`
// is faithful to actual emission semantics and structurally fail-closed:
// `rule` presence is enforced by the type system; the type makes
// "rule absent" structurally impossible.
//
// **EmissionRule = String of field-path** per Director Q3 RATIFIED at
// gunbc#1739 #issuecomment-4392797954: substrate carries structural truth
// (the `*SyntaxBinding` / `*OpsBinding` field-path that named the
// template, e.g., `"indexes.syntax.statements.let_binding"`); nominal
// aliases are display-layer derived, not substrate-side. T-Rule-Enumeration
// retired per Reading C — the field-path enumeration is structurally
// already provided by the field set of those structs in
// `src/v3/compiler/src/emit/rust_target.rs`.

module v3.std.emission_provenance

import std.integer { PositiveInt }
import v3.std.substrate { SourceSpan }

// 🟢 TERMINAL. Field-path identifier for the emission rule that produced
// a given line. The string value is the structural field-access path on
// `*SyntaxBinding` / `*OpsBinding` in `src/v3/compiler/src/emit/rust_target.rs`
// (e.g., `"indexes.syntax.statements.let_binding"`,
// `"indexes.syntax.collection_ops.fold"`). Per Director Q3
// `feedback_reason_not_label`: field-path IS the stable reason; nominal
// alias is the volatile label.
type EmissionRule = String

// Optional carrier for SourceSpan absence.
//
// **Practice 4 classification: 🟢 PRIMITIVE** — closed 2-variant typed
// sum, structurally distinguished (presence vs absence), irreducible
// variants. Direct analog of `OptionalDiagnostic` at `v3.std.dimensions`
// and the canonical "absence-or-presence" idiom. No dissolution trigger
// — the two variants are exhaustive and the shape is terminal.
//
// v3 std has no generic `Option<T>`; the typed-sum pattern is the
// idiom. `NoSourceSpan` arm is structurally legal — purely structural
// emissions (headers, fixed scaffolding, derive-attribute lines) have
// no `.dag` source declaration to attribute to and MUST surface as
// `NoSourceSpan` rather than fabricating a span. Per
// `feedback_no_textual_enforcement_bridges`: fail-closed at the
// substrate boundary, not via runtime sentinel.
type OptionalSourceSpan
  = NoSourceSpan
  | SomeSourceSpan { value: SourceSpan }

// 🟢 TERMINAL. The "what produced this emitted line?" carrier.
//
// - `emitted_line: PositiveInt`: 1-indexed line number in emitted target
//   output. Refined to `PositiveInt` (`dsl/std/integer.dag:137`,
//   `Nat where gt_zero`) rather than bare `Int` because line coordinates
//   are positive by construction; type-system enforces the 1-indexed
//   contract instead of leaving it as a comment-only invariant.
// - `rule`: MANDATORY field-path of the rule that produced this line.
//   Type system enforces presence: every emitted line is attributable
//   to some rule (even trivial mirror-rules); `rule` absence is
//   structurally impossible.
// - `source_span`: OPTIONAL `.dag` source attribution. `SomeSourceSpan`
//   when the rule's input traces to a `.dag` source declaration;
//   `NoSourceSpan` for purely structural emissions. Optional-presence
//   is structurally legal (NOT a diagnostic); only `rule` is mandatory.
//
// The two facts are orthogonal — a single emitted line can have BOTH
// rule AND span (e.g., a derive line on a sum type), so record (product)
// is the faithful shape, not sum (coproduct).
type EmissionProvenance {
  emitted_line: PositiveInt
  rule: EmissionRule
  source_span: OptionalSourceSpan
}
