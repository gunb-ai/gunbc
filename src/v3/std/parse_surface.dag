// v3.std.parse_surface — shared parse-surface AST for `.dag` source text.
//
// The parser/projection stack (`parse_generated.rs`, `regen_parse`, lower helpers)
// consumes these types as imported authority. This keeps `Surface*` shapes in
// `std/` so the compiler and future user-space tooling share the same
// pre-lowered surface schema (compiler-std consolidation tranche 2).
//
// **Historical note:** these declarations lived in
// `src/v3/compiler/runtime_mirrors.dag` as substrate mirrors; they moved here
// as the single authority for the parse-surface family.

module v3.std.parse_surface

import std.list { List }
import v3.std.substrate { SourceSpan, OperatorKind }

type DagDifference {
  detail: String
}

// SG-3f — parse-surface reflection foundation.
//
// These declarations mirror the parser's Surface* carriers so they
// exist as substrate authority rather than only as handwritten Rust
// types in `parse.rs`. The parser still constructs its native Rust
// structs/enums today; SG-3f's job is the structural foundation:
// lower.dag can now target a declared surface schema instead of
// inventing a parallel one later.
type SurfaceModule {
  items: List<SurfaceItem>
}

type SurfaceParam {
  name: String
  ty: SurfaceType
  refinement: SurfaceExpr?
}

type SurfaceField {
  name: String
  ty: SurfaceType
}

type SurfaceVariant {
  name: String
  payload: VariantPayload
  span: SourceSpan
}

// 🟢 TERMINAL at variant-payload shape scope for `parse_surface`. `Positional` vs `Record`
// names two surface encodings of constructor payloads at this mirror; ledger: patterns 1–4
// from modeling-discipline §4 are N/A here (finer decomposition belongs in parse-rule authority).
type VariantPayload
  = Positional(List<SurfaceType>)
  | Record(List<SurfaceField>)

// 🟡 SCAFFOLD at SG-2 parser-staging carrier scope (substrate mirror, not parse-rule authority).
// **Named trigger:** `parse_parser_body.txt` header (emit algorithm from `.dag` alone) plus
// SG-2b / SG-3f parse-rule cutover aligned with `lower.rs`.
type SurfaceType
  = Named { name: String, span: SourceSpan }
  | Parameterized {
      name: String
      args: List<SurfaceType>
      span: SourceSpan
    }
  | Optional {
      inner: SurfaceType
      span: SourceSpan
    }
  | Arrow {
      inputs: List<SurfaceType>
      output: SurfaceType
      span: SourceSpan
    }

type SurfaceRecordField {
  name: String
  value: SurfaceExpr
  span: SourceSpan
}

type SurfaceMatchArm {
  pattern: SurfacePattern
  body: SurfaceExpr
  span: SourceSpan
}

type SurfacePatternField {
  name: String
  binding: String
  span: SourceSpan
}

// 🟡 SCAFFOLD — mirrored surface pattern forms; same dissolution trigger as `SurfaceType`.
type SurfacePattern
  = BareVariant { name: String, span: SourceSpan }
  | VariantWith {
      name: String
      binding: String
      span: SourceSpan
    }
  | VariantFields {
      name: String
      fields: List<SurfacePatternField>
      span: SourceSpan
    }

// 🟢 TERMINAL at parse_surface surface-literal scope. Three literal classes are irreducible
// input distinctions here; ledger: patterns 1–4 N/A (no finer substrate split without changing
// the language surface). **Naming contract:** SurfaceLiteral variant labels MUST stay `Int` /
// `Bool` / `String` — the same names as the historical handwritten parser — so generated Rust
// matches `lower.rs` and every `SurfaceLiteral::…` constructor site. Do not rename to
// `IntLit` / `BoolLit` / `StringLit` (tokenizer token kinds, not surface literals).
type SurfaceLiteral
  = Int(Int)
  | Bool(Bool)
  | String(String)

// 🟡 SCAFFOLD — expression carrier mirror; same dissolution trigger as `SurfaceType`.
type SurfaceExpr
  = Literal { value: SurfaceLiteral, span: SourceSpan }
  | Var { name: String, span: SourceSpan }
  | Path {
      segments: List<String>
      segment_spans: List<SourceSpan>
      span: SourceSpan
    }
  | Call {
      target: String
      args: List<SurfaceExpr>
      span: SourceSpan
    }
  | VariantRecord {
      target: String
      fields: List<SurfaceRecordField>
      span: SourceSpan
    }
  | Operator {
      op: OperatorKind
      args: List<SurfaceExpr>
      span: SourceSpan
    }
  | Lambda {
      params: List<String>
      body: SurfaceExpr
      span: SourceSpan
    }
  | If {
      cond: SurfaceExpr
      then_branch: SurfaceExpr
      else_branch: SurfaceExpr
      span: SourceSpan
    }
  | Match {
      scrutinee: SurfaceExpr
      arms: List<SurfaceMatchArm>
      span: SourceSpan
    }
  | Record {
      fields: List<SurfaceRecordField>
      span: SourceSpan
    }
  | List {
      elements: List<SurfaceExpr>
      span: SourceSpan
    }

// 🟡 SCAFFOLD — top-level item carrier mirror (substrate schema). **Named trigger (carrier /
// parse-rule authority, SG-2b):** same as `SurfaceType` — `parse_parser_body.txt` header +
// roadmap-active-deferrals.md (emit parse from `.dag` alone; no Rust body splice).
// **`FnExternalBody` ledger (DB-16 — not the same paydown as SG-2b):** one variant, three
// pipeline-reconciled cases — (1) parse lag → `ArrowBody::Unparsed(body_span)` until M2 surface
// catches the form; (2a) host pipeline stages → `ExternalRealization` at bootstrap; (2c)
// `pipeline.dag` `compile` keeps `Unparsed` with body-span ordering authority. Do not fold
// these into the SG-2b text-file deletion trigger; authority + scheduled deletions live in
// `docs/design-fn-external-body-reconciliation.md` and `docs/history/roadmap-active-deferrals.md`
// (DB-16 / PR #524).
type SurfaceItem
  = Let {
      name: String
      type_ann: SurfaceType?
      expr: SurfaceExpr
    }
  | Fn {
      name: String
      type_params: List<String>
      params: List<SurfaceParam>
      return_type: SurfaceType
      body: SurfaceExpr
      span: SourceSpan
    }
  | FnExternalBody {
      name: String
      type_params: List<String>
      params: List<SurfaceParam>
      return_type: SurfaceType
      body_span: SourceSpan
      span: SourceSpan
    }
  | Data {
      name: String
      ty: SurfaceType
      body: SurfaceExpr?
      body_span: SourceSpan
      span: SourceSpan
    }
  | Module { path: List<String>, span: SourceSpan }
  | Import {
      path: List<String>
      names: List<String>
      span: SourceSpan
    }
  | TypeAtom {
      name: String
      type_params: List<String>
      span: SourceSpan
    }
  | TypeRecord {
      name: String
      type_params: List<String>
      fields: List<SurfaceField>
      span: SourceSpan
    }
  | TypeSum {
      name: String
      type_params: List<String>
      variants: List<SurfaceVariant>
      inhabits: SurfaceType?
      span: SourceSpan
    }
  | TypeAlias {
      name: String
      type_params: List<String>
      target: SurfaceType
      refinement: SurfaceExpr?
      span: SourceSpan
    }
