module v3.std.computation_model

// Source-side facts: .dag's own computation model
type Mutability
  = Immutable
  | Mutable

type Purity
  = Pure
  | Effectful

type Structure
  = ExplicitDAG
  | Arbitrary

type Iteration
  = Bounded
  | Unbounded

type ComputationModel {
  mutability: Mutability
  purity: Purity
  structure: Structure
  iteration: Iteration
}

data dag_model: ComputationModel = {
  mutability: Immutable
  purity: Pure
  structure: ExplicitDAG
  iteration: Bounded
}

// Target-side facts: each emission target's execution model
type MemoryModel
  = ValueOnly
  | GarbageCollected
  | RefCounted
  | OwnershipBased

type ScopeModel
  = LexicalScoping
  | DynamicScoping

type TargetExecutionModel {
  memory: MemoryModel
  scope: ScopeModel
}
