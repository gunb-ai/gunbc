data shape_a_target_language_spec_ref_invariant: TestClaim = {
  name: "shape_a_target_language_spec_ref_invariant"
  source: "// ShapeATarget is a typed LanguageSpec reference, not a closed Rust/Python/Go enum.\nlet _: Int = 0\n"
  file_name: "shape_a_target_language_spec_ref_invariant.v3"
