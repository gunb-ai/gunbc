  { row_identity: { target: rust_shape_a_target, dag_method: { decl: flat_map_method } }, cells: [{ connective: Cardinality, behavior: Transform }] },
  { row_identity: { target: rust_shape_a_target, dag_method: { decl: skip_method } }, cells: [{ connective: Cardinality, behavior: Transform }] },
  { row_identity: { target: rust_shape_a_target, dag_method: { decl: take_method } }, cells: [{ connective: Cardinality, behavior: Transform }] },
  { row_identity: { target: python_shape_a_target, dag_method: { decl: count_method } }, cells: [{ connective: Cardinality, behavior: Transform }] },
  { row_identity: { target: python_shape_a_target, dag_method: { decl: join_method } }, cells: [{ connective: Cardinality, behavior: Transform }] },
  { row_identity: { target: python_shape_a_target, dag_method: { decl: split_method } }, cells: [{ connective: Cardinality, behavior: Transform }] },
