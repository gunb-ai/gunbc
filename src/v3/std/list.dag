// std.list — list modeling as the free monoid on T.
//
// **Status: bootstrap-staged std file.** The declarations in this
// file are loaded by `Dag::new()` from `src/v3/std/`. The bodies stay
// in block form for now so the current parser/lowerer can ingest the
// signatures cleanly while preserving the intended implementation as
// source text in-place. The remaining gap is end-to-end lowering /
// emission of recursive list bodies, not the API surface itself.
//
// Current staging note:
//   - The function signatures are authoritative and available to
//     downstream code today.
//   - The bodies remain preserved as block text because the current
//     compiler still lacks full structural recursion + list-body
//     emission support.
//
// **Bootstrap staging.** Lives in `src/v3/std/` not `dsl/std/`
// for the same reason `src/v3/spec/rust.dag` does: v2's CI
// pipeline scans `dsl/` recursively and cannot parse v3's
// grammar. Canonical logical home is `dsl/std/list.dag` once
// v2 retires. See `THESIS.md` §"Two groundings" bootstrap note.
//
// **Why List is modeled here, not left implicit.** The thesis
// commits to "every program facet is a substrate fact." v2 has
// `Set<T>` declared structurally but no List standard library.
// List is one of the highest-leverage missing pieces — every
// other collection algebra (fold, map, filter, zip) derives from
// the free-monoid structure. Without a declared List, every
// consumer that needs a list re-invents iteration in Rust.

module std.list

import std.types { Int, Bool, List }
import std.algebra { Monoid }

// ── Structural shape ────────────────────────────────────────────

// `List<T>` already exists in `dsl/std/types.dag` as the
// bootstrap-loaded authority for the collection type. This staged
// file layers the helper functions (`empty`, `cons`, `fold`, `map`,
// `filter`, ...) on top of that existing declaration.
//
// The long-term reflection design models `List<T>` structurally as
// `Empty | Cons(T, List<T>)`. In this checkout that shape is still
// hosted indirectly through `std.types` / `FreeMonoid`; staging the
// helpers here avoids a duplicate top-level `List` declaration during
// bootstrap while still making the API surface available.

// ── Algebraic inhabitance ───────────────────────────────────────

// `List<T>` inhabits `Monoid<List<T>>`:
//   identity = `Empty`
//   op       = `concat` (append two lists)
// This makes `List<T>` the **free monoid on T**. The monoid laws
// (associativity, left-identity, right-identity) hold by the
// recursive definition of `concat` and are verified by the
// algebra-inhabitance lens.
//
// The canonical value declaration is intentionally commented out
// for now because generic `data` items are not yet part of the
// surface grammar:
//
// data list_monoid<element>: Monoid<List<element>> = {
//   identity: Empty
//   op: concat
// }

// ── Constructors ────────────────────────────────────────────────

// `empty()` — the empty list. Alias for the `Empty` variant in
// expression position. Exists so callers can write `empty()`
// generically instead of naming the variant.
fn empty<element>() -> List<element> {
  Empty
}

// `cons(head, tail)` — prepend `head` to `tail`. Alias for the
// `Cons` variant constructor.
fn cons<element>(head: element, tail: List<element>) -> List<element> {
  Cons(head, tail)
}

// `singleton(x)` — a one-element list.
fn singleton<element>(x: element) -> List<element> {
  Cons(x, Empty)
}

// ── The catamorphism (fold) ─────────────────────────────────────

// `fold` is THE primitive. Every other list operation below
// derives from `fold` or `fold_right`. This is the structural
// catamorphism over the Disj — pattern match on Empty/Cons,
// recurse on the tail.
//
// **Left fold.** Accumulator grows leftward; the function `f`
// receives the current accumulator and the next element.
//   `fold([1, 2, 3], 0, |acc, x| acc + x) = ((0 + 1) + 2) + 3 = 6`
fn fold<T, U>(list: List<T>, init: U, f: fn(U, T) -> U) -> U {
  match list {
    Empty            => init
    Cons(head, tail) => fold(tail, f(init, head), f)
  }
}

// **Right fold.** Accumulator grows rightward; the function `f`
// receives the next element and the current accumulator. Used by
// `concat` and `map` because it preserves order without a
// reversal step.
//   `fold_right([1, 2, 3], 0, |x, acc| x + acc) = 1 + (2 + (3 + 0)) = 6`
fn fold_right<T, U>(list: List<T>, init: U, f: fn(T, U) -> U) -> U {
  match list {
    Empty            => init
    Cons(head, tail) => f(head, fold_right(tail, init, f))
  }
}

// ── Monoid op (concat) ──────────────────────────────────────────

// `concat(a, b)` — append `b` onto `a`. Derived from `fold_right`
// by cons-ing each element of `a` onto the front of `b`.
//
// This is the monoid operation named in `list_monoid.op` above.
// The recursive structure makes associativity and identity laws
// trivially hold (empty on either side leaves the other list
// unchanged; three-way concat regroups without changing order).
fn concat<element>(a: List<element>, b: List<element>) -> List<element> {
  fold_right(a, b, cons)
}

// ── Derived operations ──────────────────────────────────────────

// `map(list, f)` — apply `f` to every element, producing a new
// list of the same length.
fn map<A, B>(list: List<A>, f: fn(A) -> B) -> List<B> {
  fold_right(list, empty(), |x, acc| cons(f(x), acc))
}

// `filter(list, p)` — keep only elements matching the predicate.
fn filter<T>(list: List<T>, p: fn(T) -> Bool) -> List<T> {
  fold_right(list, empty(), |x, acc|
    if p(x) then cons(x, acc) else acc
  )
}

// Temporary concrete wrappers used by the current end-to-end tests.
// The general helper API above is the real surface; these wrappers
// exist because ordinary generic-call instantiation from runtime
// arguments is not wired through the current pipeline yet.
fn singleton_int(x: Int) -> List<Int> {
  singleton(x)
}

fn cons_int(head: Int, tail: List<Int>) -> List<Int> {
  cons(head, tail)
}

fn fold_int(list: List<Int>, init: Int, f: fn(Int, Int) -> Int) -> Int {
  fold(list, init, f)
}

fn map_int(list: List<Int>, f: fn(Int) -> Int) -> List<Int> {
  map(list, f)
}

fn filter_int(list: List<Int>, p: fn(Int) -> Bool) -> List<Int> {
  filter(list, p)
}

// `flat_map(list, f)` — map each element to a list, then
// concatenate the results. Aka `concatMap` in Haskell.
fn flat_map<A, B>(list: List<A>, f: fn(A) -> List<B>) -> List<B> {
  fold_right(list, empty(), |x, acc| concat(f(x), acc))
}

// `length(list)` — the number of elements. The only list
// operation that returns an `Int` directly.
fn length<T>(list: List<T>) -> Int {
  fold(list, 0, |acc, _| acc + 1)
}

// `is_empty(list)` — true iff the list has no elements. Useful
// as a predicate since pattern matching would force the caller
// to write a full match.
fn is_empty<T>(list: List<T>) -> Bool {
  match list {
    Empty   => True
    Cons(_, _) => False
  }
}

// ── Indexed traversal ───────────────────────────────────────────

// `IndexedElement<T>` pairs a list index with its value. Used
// by `enumerate` to thread positional information through a
// traversal without a side-channel.
type IndexedElement<element> {
  index: Int
  value: element
}

// `enumerate(list)` — pair each element with its zero-based
// index. The output list has the same length as the input.
fn enumerate<T>(list: List<T>) -> List<IndexedElement<T>> {
  enumerate_helper(list, 0)
}

// Helper: accumulator-style traversal that threads the index.
// Not exposed to callers; callers use `enumerate`.
fn enumerate_helper<T>(list: List<T>, start: Int) -> List<IndexedElement<T>> {
  match list {
    Empty => Empty
    Cons(head, tail) =>
      Cons(
        IndexedElement { index: start, value: head },
        enumerate_helper(tail, start + 1)
      )
  }
}

// ── Element search ──────────────────────────────────────────────

// `contains(list, target)` — true iff some element of `list`
// equals `target`. Requires `T` to inhabit `Eq<T>` for the
// equality comparison below.
//
// TODO: once v3 grows `Eq<T>` inhabitance declarations, this
// function becomes `where T: Eq`. Until then, `==` dispatches
// through whatever equality is structurally available on `T`.
fn contains<T>(list: List<T>, target: T) -> Bool {
  match list {
    Empty => False
    Cons(head, tail) =>
      if head == target then True else contains(tail, target)
  }
}
