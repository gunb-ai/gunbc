module v3.std.substrate

import v3.spec.v3_l1 { DeclarationRef }
import v3.std.substrate_minimal {
  NodeId, PortId, DeclarationId, ClusterId, NonEmptyList, NonSingletonList
}
import std.effects { WorkflowEffect }

type TypeShape {
  declaration: DeclarationId
}

// 🟢 TERMINAL at reflected-substrate scope. Three-way port inference
// state is a durable compiler fact consumed directly by reflection.
type PortState
  = Uninferred
  | Resolved(TypeShape)
  | Unresolved

type DagPort {
  id: PortId
  state: PortState
  produced_by: NodeId?
}

// Leaf structural types.
// 🟢 TERMINAL. Literal carrier split matches dag.rs's runtime enum
// one-for-one and is expected to persist as the leaf literal surface.
type LiteralBits
  = LitInt(Int)
  | LitBool(Bool)
  | LitString(String)

// 🟢 TERMINAL at current substrate scope. This is the durable atom
// connective surface the lowered declaration graph carries.
type AtomPayload
  = Literal(LiteralBits)
  | UnresolvedIdentifier(String)
  | ResolvedByStructure(DeclarationId)
  | ResolvedByName(DeclarationId)
  | TypeParam(String)

// 🟢 TERMINAL. Cardinality bounds are structural substrate facts and
// not a temporary bridge to another representation.
type CardinalityBound
  = Exact(Int)
  | AtMostOne
  | Unbounded

type ConjField {
  label: String
  ty: DeclarationId
}

type TemplateArgument {
  parameter: DeclarationId
  value: DeclarationId
}

type FieldEntry {
  label: String
  value: FieldValue
}

// 🟡 SCAFFOLD until reflected structural values dissolve into ordinary
// declaration-shaped values. Mirrors the live runtime carrier exactly,
// but remains a bootstrap bridge for nested structural data bodies.
type FieldValue
  = Literal(LiteralBits)
  | Reference(DeclarationId)
  | Record(List<FieldEntry>)
  | List(List<FieldValue>)
  | Variant {
      constructor: DeclarationId
      payload: List<FieldValue>
    }

// 🟡 SCAFFOLD paired with `FieldValue`. `Unparsed` and structural body
// carriers are bootstrap-time receipts for data-body lowering.
type ValueBody
  = ValueBodyUnparsed(SourceSpan)
  | ValueBodyStructural { fields: List<FieldEntry> }

// Type substrate.
// 🟡 MIXED. `ArrowBody` carries the durable user/external/no-body
// edges plus the temporary `Pending` / `Unparsed` bootstrap states
// still present in today's lowering pipeline. See the Rust-side
// ledger in `src/v3/compiler/src/dag.rs` for variant rationale and
// dissolution triggers.
type ArrowBody
  = UserDefined(NodeId)
  | ExternalRealization(DeclarationId)
  | Pending
  | NoBody
  | Unparsed(SourceSpan)

// 🟢 TERMINAL at reflected-substrate scope. The connective partition is
// the compiler's durable declaration-shape authority; temporary detail
// lives inside the child carriers such as `ArrowBody`.
type TypeConnective
  = Atom(AtomPayload)
  | Conj { children: List<ConjField> }
  | Disj { variants: List<ConjField> }
  | Arrow {
      inputs: List<DeclarationId>
      output: DeclarationId
      body: ArrowBody
    }
  | Cardinality {
      element: DeclarationId
      bound: CardinalityBound
    }
  | Instantiation {
      template: DeclarationId
      arguments: List<TemplateArgument>
    }

type Declaration {
  id: DeclarationId
  name: String?
  connective: TypeConnective
  type_params: List<DeclarationId>
  meta_tag: DeclarationId?
  inhabits: DeclarationId?
  value_body: ValueBody?
  span: SourceSpan
}

// 🟢 TERMINAL. Arithmetic operators are durable substrate facts.
type ArithmeticOp
  = Add
  | Sub
  | Mul
  | Div

// 🟢 TERMINAL. Comparison operators are durable substrate facts.
type ComparisonOp
  = Eq
  | Ne
  | Lt
  | Le
  | Gt
  | Ge

// 🟢 TERMINAL. OperatorKind is the substrate authority for operator
// identity; realizations map from this structural fact downstream.
type OperatorKind
  = Arithmetic(ArithmeticOp)
  | Comparison(ComparisonOp)

// Computation substrate.
// 🟢 TERMINAL at the reflected-substrate level. Every transform target
// variant corresponds to a live runtime carrier in dag.rs.
type TransformTarget
  = Callable(DeclarationId)
  | FieldProject {
      field_label: String
      field_child: DeclarationId?
    }
  | Operator(OperatorKind)

// 🟢 TERMINAL. Match-path pattern identity is part of the durable
// reflected branch substrate.
type BranchPattern
  = UnresolvedVariant { name: String, span: SourceSpan }
  | ResolvedVariant(DeclarationId)

type PayloadBinding {
  binding_name: String
  payload_port: PortId
}

type BranchPath {
  body: NodeId
  result_port: PortId
  pattern: BranchPattern
  binding: PayloadBinding?
}

// Constructor-validation asymmetry (tracked Track 9 debt): the
// reflected substrate carries the witness fields, while validity is
// enforced today by Rust-side constructors. `Dag::param_of(member,
// slot)` fails closed for non-Bind members and out-of-arity slots.
// When .dag-side construction matures in the Lane 3c self-hosting
// cycle, add the equivalent substrate-level constructor authority so
// direct .dag producers cannot forge invalid handles.
// Full prose + graduation trigger: ../../../ROADMAP.md — Track 9
// ("Tracked debt — substrate constructor-validation asymmetry").
type ParamRef {
  member: NodeId
  slot: Int
}

// Constructor-validation asymmetry (tracked Track 9 debt): validity is
// enforced today by `Dag::as_transform_ref(node)`, which fails closed
// unless `node` carries `Behavior::Transform`. The reflected substrate
// currently exposes the witness field shape only; .dag-side
// construction must gain the same constructor authority in the Lane 3c
// self-hosting cycle.
// Same ROADMAP authority as ParamRef: ../../../ROADMAP.md — Track 9
// ("Tracked debt — substrate constructor-validation asymmetry").
type TransformRef {
  node: NodeId
}

type MemberDescent {
  param: ParamRef
}

type IntraClusterCall {
  transform: TransformRef
}

type Cluster {
  members: NonSingletonList<MemberDescent>
  intra_cluster_calls: NonEmptyList<IntraClusterCall>
}

// 🟢 TERMINAL. `LoopBound` records the irreducible witness that makes a
// reflected `LoopNode` honest: either an explicit runtime count port or
// a proved mutual-recursion descent cluster. Collapsing the variants
// would either fabricate a count fact or erase the structural proof.
// See `docs/design-mutual-recursion-lowering.md` for the full
// dissolution receipt and named trigger rationale.
type LoopBound
  = Cardinality { count: PortId }
  | Descent { cluster: ClusterId }

type ValueNode {
  id: NodeId
  payload: LiteralBits
  result_port: PortId
  span: SourceSpan
  lane2_workflow: WorkflowEffect?
}

type TransformNode {
  id: NodeId
  target: TransformTarget
  inputs: List<PortId>
  result_port: PortId
  span: SourceSpan
}

type BranchNode {
  id: NodeId
  input: PortId
  paths: List<BranchPath>
  result_port: PortId
  span: SourceSpan
}

type LoopNode {
  id: NodeId
  source: PortId
  init: PortId
  body: NodeId
  bound: LoopBound
  result_port: PortId
  span: SourceSpan
}

type BindNode {
  id: NodeId
  name: String
  result_port: PortId
  params: List<PortId>
  span: SourceSpan
  lane2_workflow: WorkflowEffect?
}

// 🟢 TERMINAL. Behavior is the core runtime computation coproduct.
type Behavior
  = Value(ValueNode)
  | Transform(TransformNode)
  | Branch(BranchNode)
  | Loop(LoopNode)
  | Bind(BindNode)

type Dag {
  declarations: List<Declaration>
  nodes: List<Behavior>
  ports: List<DagPort>
  clusters: List<Cluster>
}

// ── Substrate keyed accessors (DB-14, INVARIANTS.md L-7) ────────────
//
// These three functions are the single authority for id-keyed lookup
// over `Dag.ports` / `Dag.nodes`. Every lens consumes them; no lens
// reconstructs its own `find_port` / `find_behavior`.
//
// Implementation: the fn bodies below are trivial `{ host <name> }`
// stubs. Arrow bodies stay `Unparsed` through bootstrap — target
// selection happens at emission time. Each emitter reads
// `SubstrateAccessorBinding` records from the spec files, filters by
// its own `language: LanguageSpec` id, and dispatches through a
// per-target index. Diverges from `pipeline.dag`'s bootstrap-upgrade
// pattern because substrate accessors have per-target realizations;
// upgrading once at bootstrap silently drops target selection. See
// docs/design-substrate-external-primitives.md § 5.

// 🟡 SCAFFOLD per DB-14. Carries a per-target rendering template for
// a substrate accessor. `carrier` is a template string with positional
// `{p0}`, `{p1}`, … placeholders matching the accessor's input order;
// the emitter substitutes per call-site. Dissolves when Lane 1e
// collapses the three emitters into a single spec-driven walker —
// the carrier field moves into the per-target spec, but the
// emission-time index-lookup dispatch stays.
type SubstrateAccessorRealization {
  carrier: String
}

// 🟡 SCAFFOLD per DB-14. One record per (accessor × target language)
// pair. `language` is the LanguageSpec declaration the realization is
// defined against (`rust_language`, `go_language`, `python_language`);
// each emitter filters for bindings where `language == <its own
// language spec>`. Shape mirrors the `language: DeclarationRef` edge
// used by every other shared realization (TypeRealization,
// OperatorRealization, …) so adding a new target = one more data
// record, zero compiler changes. Review round 1b.3 root cause: prior
// shape `{ accessor, realization }` had no target selector, so
// multiple target bindings would silently overwrite by iteration
// order. Dissolves with the same Lane 1e trigger as
// SubstrateAccessorRealization.
type SubstrateAccessorBinding {
  accessor: DeclarationRef
  realization: DeclarationRef
  language: DeclarationRef
}

fn port(d: Dag, id: PortId) -> DagPort? {
  host port
}

fn node(d: Dag, id: NodeId) -> Behavior? {
  host node
}

fn resolve_producer(d: Dag, port_id: PortId) -> Behavior? {
  host resolve_producer
}

// Lane 2 Stage 2b — reads the optional workflow fact installed on `Value` /
// `Bind` roots (same authority as `Dag::lane2_workflow_effect_at` on the Rust
// side). Target emitters map this accessor via `SubstrateAccessorBinding`.
fn lane2_workflow_at(d: Dag, id: NodeId) -> WorkflowEffect? {
  host lane2_workflow_effect_at
}
