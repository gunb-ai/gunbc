module v3.std.substrate

import v3.spec.v3_l1 { DeclarationRef }
import v3.std.substrate_minimal {
  NodeId, PortId, DeclarationId, ClusterId, NonEmptyList, NonSingletonList
}
import std.effects { WorkflowEffect }
import v3.std.lookup { Lookup }
import std.nat { Nat }

type TypeShape {
  declaration: DeclarationId
}

// 🟢 TERMINAL at reflected-substrate scope. Three-way port inference
// state is a durable compiler fact consumed directly by reflection.
type PortState
  = Uninferred
  | Resolved(TypeShape)
  | Unresolved

type DagPort {
  id: PortId
  state: PortState
  produced_by: NodeId?
}

// Leaf structural types.
// 🟢 TERMINAL. Literal carrier split matches dag.rs's runtime enum
// one-for-one and is expected to persist as the leaf literal surface.
//
// `LitInt` payload is a signed decimal magnitude string (optional leading `-`;
// no `+` prefix), same decimal authority as `IntegerPrimitive` range facts.
// R3 gate `int_lit_full_magnitude_consumer`: accepts full host narrowing range
// (unsigned through `u128::MAX`; signed unary `-` through `i128::MIN`).
type LiteralBits
  = LitInt(String)
  | LitBool(Bool)
  | LitString(String)

// Dissolution ledger — AtomPayload (substrate authority; was dag.rs hand-Rust).
//
// 🟢 TERMINAL at M1(2.6). Five variants covering the user-input kinds at the
// type-atom level:
//
//   - Literal(LiteralBits) — a literal bit pattern carried at the type level
//     (e.g. the `3` in Cardinality::Exact(3)).
//   - UnresolvedIdentifier(String) — a name reference not yet resolved against
//     the declaration table. Produced during lowering; eliminated at
//     resolve_pending_identifiers time.
//   - ResolvedByStructure(DeclarationId) — resolved by structural walk.
//   - ResolvedByName(DeclarationId) — resolved by name-keyed fallback.
//   - TypeParam(String) — a type parameter declaration slot, shared across
//     references inside a parameterized declaration.
//
// 4-pattern check:
// - Pattern 1 (fact placement): fails. Each variant has distinct downstream
//   consumers (literal constant folding, identifier resolution via
//   declaration_by_name, SubstStack lookup) — `declaration_by_name` now
//   landed as `host` accessor below; `SubstStack lookup` still pending.
// - Pattern 2 (variant-is-data): fails. Different payload types per variant.
// - Pattern 3 (algebraic form): fails. Each variant is a terminal fact from a
//   distinct user-input boundary.
// - Pattern 4 (dimensional): fails.
//
// Pre/post-sweep phase is structural. Before M1(2.6) review round 7 the shape
// was Identifier { name: String, resolved: Option<DeclarationId> }, which hid a
// phase coproduct inside the Option. The split into UnresolvedIdentifier,
// ResolvedByStructure, and ResolvedByName makes that distinction visible to the
// type system: unresolved stubs, structural references, and name-fallback
// references are separate variants rather than hidden behind Some/None.
//
// Verdict: terminal. Future extensions (Span-backed metadata atoms for
// diagnostic-only uses, Char / Float literals) go through §8.10's
// substrate-extension audit.
//
// 🟢 TERMINAL at current substrate scope. This is the durable atom
// connective surface the lowered declaration graph carries.
type AtomPayload
  = Literal(LiteralBits)
  | UnresolvedIdentifier(String)
  | ResolvedByStructure(DeclarationId)
  | ResolvedByName(DeclarationId)
  | TypeParam(String)

// 🟢 TERMINAL. PR-PreF shared bound parent. CardinalityBound, SizeBound,
// and the cardinality arm of LoopBound all describe bounded intervals over
// different domains; this parent is the substrate target named by
// INVARIANTS.md#p1-modeling-faithfulness. Existing carriers retrofit as instances instead of
// growing new sibling bound declarations.
//
// `BoundedInterval` stores a lower endpoint plus a nonnegative width, never
// two independent endpoints. This makes inverted intervals unrepresentable:
// an upper endpoint is derived by applying the width in the interval domain.
type PositiveIntervalWidth
  = OneUnit
  | AdditionalUnit { previous: PositiveIntervalWidth }
  // 🟡 SCAFFOLD (substrate authoring sugar — explicit bridge, not a second width axiom).
  //
  // **Canonical semantic witness:** `OneUnit` / `AdditionalUnit` — inductive proof-carrying
  // encoding for positive interval width already consumed by structural passes.
  //
  // **`UnitCount` role:** decimal/spec authoring shorthand denoting the **same** discrete span as a
  // unary `AdditionalUnit` chain of length `units` atop `OneUnit` over `Int` (inclusive span above
  // `lower` in `BoundedInterval<Int>`). Large fixed-width rows (Coercion-Fold examples) use this so
  // specs stay compact; Peano spines remain valid everywhere small unary witnesses are preferred.
  //
  // **Same-PR structural consumers (fail-closed):** `integer_range_for_decl` /
  // `lower_scalar_literal_for_type` reject negative decimals for `Nat`; `enforce_non_negative_unit_count_payload`
  // witnesses nonnegative payloads when lowering bypasses those gates.
  //
  // **Dissolution trigger:** add a substrate normalizer or shared query that expands every
  // `UnitCount { units: N }` **value** to an equivalent Peano spine **before** consumers that require
  // an explicit unary witness for induction-shaped reasoning — until then, treat both variants as
  // denotationally equivalent via this bridge (single interval-width fact; no competing lattices).
  //
  // **INVARIANTS.md P5** (Progress Is Dissolution): parallel surface shapes land only under tracked
  // scaffold + named exit; Peano remains the durable unary carrier where proof structure matters.
  | UnitCount { units: Nat }

type IntervalWidth
  = ZeroWidth
  | PositiveWidth(PositiveIntervalWidth)

// 🟢 TERMINAL. `Interval` is the durable shared bound parent. The bounded
// variant is lower + nonnegative width; `Unbounded` is the target-side
// universal bound case. No dissolution trigger: later carriers attach as
// instances/projections of this parent rather than replacing it.
type Interval<D>
  = BoundedInterval { lower: D, width: IntervalWidth }
  | Unbounded

// Alias so LanguageSpec-side carriers (`emit_model`) can name fixed `Int`
// intervals without instantiating `Interval<Int>` at every import site.
type IntInterval = Interval<Int>

// 🟢 TERMINAL at Coercion-Fold bound-declaration scope. Static value-domain
// bounds are represented by the shared Interval<Int> parent; platform-dependent
// bounds are a distinct kind because their interval is resolved only after the
// target platform is known. No parser/lowerer or per-target population lands in
// this substrate carrier slice.
type BoundDeclaration
  = StaticBound(Interval<Int>)
  | PlatformDependent

// 🟢 TERMINAL. Cardinality bounds are structural substrate facts and
// not a temporary bridge to another representation. PR-PreF projects this
// carrier through Interval<Int> for consumers that need the shared parent.
type CardinalityBound
  = Exact(Int)
  | AtMostOne
  | Unbounded

type ConjField {
  label: String
  ty: DeclarationId
}

type TemplateArgument {
  parameter: DeclarationId
  value: DeclarationId
}

type FieldEntry {
  label: String
  value: FieldValue
}

// 🟡 SCAFFOLD until reflected structural values dissolve into ordinary
// declaration-shaped values. Mirrors the live runtime carrier exactly,
// but remains a bootstrap bridge for nested structural data bodies.
type FieldValue
  = Literal(LiteralBits)
  | Reference(DeclarationId)
  | Record(List<FieldEntry>)
  | List(List<FieldValue>)
  | Map(List<FieldEntry>)
  | Variant {
      constructor: DeclarationId
      payload: List<FieldValue>
    }

// 🟡 SCAFFOLD paired with `FieldValue`. `ValueBody` is the bootstrap
// data-body carrier until all source data bodies lower through ordinary
// declaration-shaped value DAGs. Named dissolution trigger: M2+ parser
// extensions plus value-sub-DAG lowering close the class-5 data-body gap,
// allowing `Unparsed` and the top-level structural body carriers below to
// dissolve into regular declarations/behaviors.
//
// Coproduct receipt:
// - `ValueBodyUnparsed(SourceSpan)` — 🟡 scaffold for source bodies not yet
//   structurally lowered; trigger is parser/lowering coverage for the
//   remaining opaque data-body forms.
// - `ValueBodyStructural { fields }` — 🟡 scaffold for top-level record
//   bodies; kept distinct from list/map/scalar so records are not encoded as
//   anonymous positional or keyed containers.
// - `ValueBodyScalar(LiteralBits)` — 🟡 scaffold for scalar-valued data
//   declarations (`data answer: Int = 42`); `LiteralBits` is intentionally
//   narrower than `FieldValue` so top-level records/references/variants do
//   not become overlapping scalar states.
// - `ValueBodyList(List<FieldValue>)` — 🟡 scaffold for top-level list data
//   bodies; preserves authored order and reuses `FieldValue` for nested
//   structural elements until value-sub-DAG lowering owns lists directly.
// - `ValueBodyMap(List<FieldEntry>)` — 🟡 scaffold for top-level
//   string-keyed map data bodies. Rust wraps this payload in `FieldMap`
//   post-codegen to preserve duplicate-key rejection while substrate remains
//   the minimal carrier authority.
type ValueBody
  = ValueBodyUnparsed(SourceSpan)
  | ValueBodyStructural { fields: List<FieldEntry> }
  | ValueBodyScalar(LiteralBits)
  | ValueBodyList(List<FieldValue>)
  | ValueBodyMap(List<FieldEntry>)

// Type substrate.
// Typed witness that a NodeId identifies a BindNode. `ArrowBody::UserDefined`
// carries this witness instead of a raw NodeId so the bind-body invariant lives
// in the substrate authority as well as the Rust mirror.
//
// Constructor-validation asymmetry (tracked Track 9 debt): validity is
// enforced today by `BindNodeId::from_bind_node(dag, id)`, which fails closed
// unless `id` resolves to `Behavior::Bind`. The reflected substrate exposes the
// witness field shape only; direct `.dag` construction can still write the
// record. When .dag-side construction matures in the Lane 3c self-hosting
// cycle, add the equivalent substrate-level constructor authority so direct
// producers cannot forge invalid bind handles. Same ROADMAP authority as
// ParamRef / TransformRef: ../../../ROADMAP.md — Track 9 ("Tracked debt —
// substrate constructor-validation asymmetry").
type BindNodeId {
  node: NodeId
}

// 🟡 MIXED. `ArrowBody` carries the durable user/external/no-body
// edges plus the temporary `Pending` / `Unparsed` bootstrap states
// still present in today's lowering pipeline. See the Rust-side
// ledger in `src/v3/compiler/src/dag.rs` for variant rationale and
// dissolution triggers.
type ArrowBody
  = UserDefined(BindNodeId)
  | ExternalRealization(DeclarationId)
  | Pending
  | NoBody
  | Unparsed(SourceSpan)

// 🟢 TERMINAL at reflected-substrate scope. The connective partition is
// the compiler's durable declaration-shape authority; temporary detail
// lives inside the child carriers such as `ArrowBody`.
type TypeConnective
  = Atom(AtomPayload)
  | Conj { children: List<ConjField> }
  | Disj { variants: List<ConjField> }
  | Arrow {
      inputs: List<DeclarationId>
      output: DeclarationId
      body: ArrowBody
    }
  | Cardinality {
      element: DeclarationId
      bound: CardinalityBound
    }
  | Instantiation {
      template: DeclarationId
      arguments: List<TemplateArgument>
    }

type Declaration {
  id: DeclarationId
  name: String?
  connective: TypeConnective
  type_params: List<DeclarationId>
  phantom_params: List<PhantomParameter>
  meta_tag: DeclarationId?
  inhabits: DeclarationId?
  value_body: ValueBody?
  nominal_opacity: NominalOpacity?
  span: SourceSpan
}

// Phantom parameters are compile-time-only parameters on a value wrapper.
// The first landed consumer is `Dimension<Unit>`/Money-style arithmetic:
// values under the same phantom compose under abelian-group closure, while
// distinct phantom values produce a unit-mismatch diagnostic before ordinary
// structural type mismatch. `algebra` is a typed edge to the existing
// algebra authority (`AbelianGroup` or an instantiation thereof), not a
// parallel closed tag.
type PhantomParameter {
  parameter: DeclarationId
  algebra: DeclarationId
}

// Nominal-opaque carrier (T-Substrate nominal-opaque-for-Secret
// subset, carrier-only staging). `permitted_accessors` lists the
// declarations intended as the only sealed-accessor descent path.
// The fail-closed walker consumer + std `Secret` marking + opacity
// carry-forward through specialization are the named follow-up
// enforcement work; this carrier is staging surface only and must
// either gain a real walker consumer or be removed before T-Modeling
// Secret<T> graduation can dispatch.
type NominalOpacity {
  permitted_accessors: List<DeclarationId>
}

// 🟡 SCAFFOLD. Arithmetic operators inherit the operator-shim
// dissolution trigger: surface-operator syntax still lowers through
// `TransformTarget::Operator`, and the richer source remains the
// algebra-field declaration in `dsl/std/algebra.dag`.
type ArithmeticOp
  = Add
  | Sub
  | Mul
  | Div

// 🟡 SCAFFOLD. Comparison operators inherit the same operator-shim
// trigger as `ArithmeticOp`.
type ComparisonOp
  = Eq
  | Ne
  | Lt
  | Le
  | Gt
  | Ge

// 🟢 TERMINAL at T-Tier3 perf-budget substrate scope. Wall-clock
// mirror-dissolution baseline facts are measured values, not symbolic
// cost expressions: consumers compare live/captured measurements to a
// declared baseline using the Tier-3 budget thresholds (median <= 2x,
// p99 <= 5x). Durations are `Nat`, and `p99_delta_ns` encodes
// `p99_ns - median_ns`, making negative durations and `p99 < median`
// uninhabitable in the carrier shape.
type PerfBaselineMeasurement {
  median_ns: Nat
  p99_delta_ns: Nat
}

// 🟡 SCAFFOLD. `&&` / `||` are structurally tracked for the current
// surface grammar, but they stay on the operator-shim path until the
// M2+ parser/desugarer lowers them to direct BooleanAlgebra
// field/callable references.
type LogicalOp
  = And
  | Or

// 🟡 SCAFFOLD. `OperatorKind` is the current structural carrier for
// the operator shim. Dissolves with `TransformTarget::Operator` once
// surface operators lower directly to algebra-field declaration refs.
type OperatorKind
  = Arithmetic(ArithmeticOp)
  | Comparison(ComparisonOp)
  | Logical(LogicalOp)

// Computation substrate.
// 🟢 TERMINAL at the reflected-substrate level. Every transform target
// variant corresponds to a live runtime carrier in dag.rs.
type TransformTarget
  = Callable(DeclarationId)
  | FieldProject {
      field_label: String
      field_child: DeclarationId?
    }
  | Operator(OperatorKind)

// 🟢 TERMINAL. Match-path pattern identity is part of the durable
// reflected branch substrate.
type BranchPattern
  = UnresolvedVariant { name: String, span: SourceSpan }
  | ResolvedVariant(DeclarationId)

type PayloadBinding {
  binding_name: String
  payload_port: PortId
}

type BranchPath {
  body: NodeId
  result_port: PortId
  pattern: BranchPattern
  binding: PayloadBinding?
}

// Constructor-validation asymmetry (tracked Track 9 debt): the
// reflected substrate carries the witness fields, while validity is
// enforced today by Rust-side constructors. `Dag::param_of(member,
// slot)` fails closed for non-Bind members and out-of-arity slots.
// When .dag-side construction matures in the Lane 3c self-hosting
// cycle, add the equivalent substrate-level constructor authority so
// direct .dag producers cannot forge invalid handles.
// Full prose + graduation trigger: ../../../ROADMAP.md — Track 9
// ("Tracked debt — substrate constructor-validation asymmetry").
type ParamRef {
  member: NodeId
  slot: Int
}

// Constructor-validation asymmetry (tracked Track 9 debt): validity is
// enforced today by `Dag::as_transform_ref(node)`, which fails closed
// unless `node` carries `Behavior::Transform`. The reflected substrate
// currently exposes the witness field shape only; .dag-side
// construction must gain the same constructor authority in the Lane 3c
// self-hosting cycle.
// Same ROADMAP authority as ParamRef: ../../../ROADMAP.md — Track 9
// ("Tracked debt — substrate constructor-validation asymmetry").
type TransformRef {
  node: NodeId
}

// Constructor-validation asymmetry (tracked Track 9 debt): `ElementRef`
// is list-relative rather than graph-relative, so validity is enforced
// today by consumer-specific Rust constructors (`ElementRef::from_slice`
// and friends) that check the index against the carrier list in scope.
// The handle does not retain owner identity after construction, so
// read sites must still resolve it against the same authority list they
// validated it against. Direct `.dag` construction currently exposes
// only the witness field shape; self-hosted constructors should add the
// same authority in the Lane 3c cycle.
type ElementRef<element> {
  index: Int
}

type MemberDescent {
  param: ParamRef
}

type IntraClusterCall {
  transform: TransformRef
}

type Cluster {
  members: NonSingletonList<MemberDescent>
  intra_cluster_calls: NonEmptyList<IntraClusterCall>
}

// 🟢 TERMINAL. `LoopBound` records the irreducible witness that makes a
// reflected `LoopNode` honest: either an explicit runtime count port or
// a proved mutual-recursion descent cluster plus the runtime measure
// port whose size bounds that descent. Collapsing the variants would
// either fabricate a count fact or erase the structural proof. The
// shared `loop_bound_measure` accessor projects the cost/iteration
// measure while keeping cluster topology on `Dag.clusters`. See
// `docs/design-mutual-recursion-lowering.md` for the full dissolution
// receipt and named trigger rationale.
type LoopBound
  = Cardinality { count: PortId }
  | Descent { cluster: ClusterId, measure: PortId }

fn loop_bound_measure(bound: LoopBound) -> PortId =
  match bound {
    Cardinality(payload) => payload.count
    Descent(payload) => payload.measure
  }

type ValueNode {
  id: NodeId
  payload: LiteralBits
  result_port: PortId
  span: SourceSpan
  lane2_workflow: WorkflowEffect?
}

type TransformNode {
  id: NodeId
  target: TransformTarget
  inputs: List<PortId>
  result_port: PortId
  span: SourceSpan
}

// B4.3 — participate in match emission: lowering attaches this on user `match`
// Branch nodes, not `if`/Bool. Authority at lower time, not `SourceSpan::file`.
type BranchEmitParticipation
  = UserMatch

type BranchNode {
  id: NodeId
  input: PortId
  paths: List<BranchPath>
  result_port: PortId
  span: SourceSpan
  emit_participation: BranchEmitParticipation?
}

type LoopNode {
  id: NodeId
  source: PortId
  init: PortId
  body: NodeId
  bound: LoopBound
  result_port: PortId
  span: SourceSpan
}

// B4.3 — participate in named-type-alias / shared `primitive_type_id_for_port_shared`
// emission: lowering attaches on user `fn` and lambda Arrow bodies, not
// `let`/`refinement` Binds. Authority at lower time, not `SourceSpan::file`.
type BindEmitParticipation
  = UserCallable

type BindNode {
  id: NodeId
  name: String
  result_port: PortId
  params: List<PortId>
  span: SourceSpan
  lane2_workflow: WorkflowEffect?
  emit_participation: BindEmitParticipation?
}

// 🟢 TERMINAL. Behavior is the core runtime computation coproduct.
type Behavior
  = Value(ValueNode)
  | Transform(TransformNode)
  | Branch(BranchNode)
  | Loop(LoopNode)
  | Bind(BindNode)

type Dag {
  declarations: List<Declaration>
  nodes: List<Behavior>
  ports: List<DagPort>
  clusters: List<Cluster>
}

// ── Substrate keyed accessors (DB-14, INVARIANTS.md L-7) ────────────
//
// These three functions are the single authority for id-keyed lookup
// over `Dag.ports` / `Dag.nodes`. Every lens consumes them; no lens
// reconstructs its own `find_port` / `find_behavior`.
//
// Implementation: the fn bodies below are trivial `{ host <name> }`
// stubs. Arrow bodies stay `Unparsed` through bootstrap — target
// selection happens at emission time. Each emitter reads
// `SubstrateAccessorBinding` records from the spec files, filters by
// its own `language: LanguageSpec` id, and dispatches through a
// per-target index. Diverges from `pipeline.dag`'s bootstrap-upgrade
// pattern because substrate accessors have per-target realizations;
// upgrading once at bootstrap silently drops target selection. See
// docs/design-substrate-external-primitives.md § 5.

// 🟡 SCAFFOLD per DB-14. Carries a per-target rendering template for
// a substrate accessor. `carrier` is a template string with positional
// `{p0}`, `{p1}`, … placeholders matching the accessor's input order;
// the emitter substitutes per call-site. Dissolves when Lane 1e
// collapses the three emitters into a single spec-driven walker —
// the carrier field moves into the per-target spec, but the
// emission-time index-lookup dispatch stays.
type SubstrateAccessorRealization {
  carrier: String
}

// 🟡 SCAFFOLD per DB-14. One record per (accessor × target language)
// pair. `language` is the LanguageSpec declaration the realization is
// defined against (`rust_language`, `go_language`, `python_language`);
// each emitter filters for bindings where `language == <its own
// language spec>`. Shape mirrors the `language: DeclarationRef` edge
// used by every other shared realization (TypeRealization,
// OperatorRealization, …) so adding a new target = one more data
// record, zero compiler changes. Review round 1b.3 root cause: prior
// shape `{ accessor, realization }` had no target selector, so
// multiple target bindings would silently overwrite by iteration
// order. Dissolves with the same Lane 1e trigger as
// SubstrateAccessorRealization.
type SubstrateAccessorBinding {
  accessor: DeclarationRef
  realization: DeclarationRef
  language: DeclarationRef
}

fn port(d: Dag, id: PortId) -> DagPort? {
  host port
}

fn node(d: Dag, id: NodeId) -> Behavior? {
  host node
}

fn resolve_producer(d: Dag, port_id: PortId) -> Behavior? {
  host resolve_producer
}

// Declaration-by-id accessor — id-keyed lookup parity with `port` / `node`.
// `Declaration?` mirrors the permissive reflected-substrate shape; C-8
// fail-closed lives at the caller, which treats `None` as a
// constructor-layer violation (valid `DeclarationId`s can't legitimately
// miss).
fn declaration_by_id(d: Dag, id: DeclarationId) -> Declaration? {
  host declaration_by_id
}

// Declaration-by-name accessor — strict mirror of `declaration_by_id`,
// keyed by name instead of id. Director-ratified path (α) at gunbc#2068
// #issuecomment-4402899692 (T-CostLens follow-on Slice 1a.0): consumers
// that need a substrate meta-type's `DeclarationId` (e.g., `TypeRealization`,
// `CallableRealization`) can acquire it via name-lookup at compile time.
// `Declaration?` mirrors the permissive reflected-substrate shape per
// `declaration_by_id`; C-8 fail-closed at the caller (a name that doesn't
// resolve to a known declaration is a substrate-integrity question, not a
// silent miss). Pre-anticipated as part of the intended substrate primitive
// set (see comment authority at the top of this file referencing
// `declaration_by_name, SubstStack lookup`).
fn declaration_by_name(d: Dag, name: String) -> Declaration? {
  host declaration_by_name
}

// Lane 2 Stage 2b — reads the optional workflow fact installed on `Value` /
// `Bind` roots (same authority as `Dag::lane2_workflow_effect_at` on the Rust
// side). Target emitters map this accessor via `SubstrateAccessorBinding`.
fn lane2_workflow_at(d: Dag, id: NodeId) -> WorkflowEffect? {
  host lane2_workflow_effect_at
}

// Workflow-root identification (Director-locked α; per
// `docs/design-lens-framework.md` Q-shape and merged audit
// `docs/design-lens-fold-prerequisites.md` §"Prereq-3a").
//
// 🟡 SCAFFOLD coproduct. The three arms partition every legitimate
// `Dag` exactly once at the substrate-load boundary:
//
//   - `SingleRoot(p)` — α (last topological `Bind`) selected `p` as
//     the workflow-root port. Emitted whenever the Dag contains at
//     least one `Bind`; multiple Binds are NOT ambiguous under α —
//     the linear `d.nodes` order picks exactly one last element by
//     definition. `p` is the chosen Bind's `result_port`.
//   - `NoRoot` — zero `Bind` behaviors in `d.nodes`. The fold short-
//     circuits (`fold_lens<C>` returns `DimensionFail` with a
//     no-root diagnostic; `R2-Evaluator.evaluate(...)` rejects).
//   - `AmbiguousRoot { candidates }` — reserved for the
//     enumerate-all-eligible-entries rule that the runtime evaluator
//     (`evaluate(program, entry, args)` per Items 4+5 / #1176 §3.2)
//     consumes for multi-entry programs. The α / γ "last X Bind"
//     rules cannot populate this arm over a linear `Dag.nodes` —
//     both pick exactly one element by definition. Pinned here as a
//     fail-closed surface for the future enumerate-all consumer
//     wiring; today's α implementation never emits this variant.
//
// Pattern 1 (per-call total fact) was rejected: `-> PortId` would
// fabricate or panic on `NoRoot` cases. Pattern 2 (collapse to
// `Option<PortId>`) loses the `AmbiguousRoot` channel for the
// multi-entry consumer. Pattern 3 (this sum) is the dissolution
// path: each variant carries the structural reason its arm was
// taken; consumers dispatch fail-closed without fabrication.
//
// Dissolution: γ refinement (last `UserCallable` `Bind`) and the
// enumerate-all rule both reuse this same partition behind the
// `workflow_root_port` accessor; no carrier change required.
type WorkflowRoot
  = SingleRoot(PortId)
  | NoRoot
  | AmbiguousRoot { candidates: NonSingletonList<PortId> }

// Workflow-root accessor (per merged audit Prereq-3a). Implements
// the α rule: last topological `Bind` in `d.nodes`. Returns
// `WorkflowRoot::SingleRoot(b.result_port)` when the Dag contains
// at least one Bind (α picks the last one); `NoRoot` when zero
// Binds; never `AmbiguousRoot` under α (linear `d.nodes` cannot
// tie — multiple Binds are not ambiguous, α just picks the last).
// Shared authority — both `fold_lens<C>` (workflow-root
// identification for the equivalence target) and R2-Evaluator
// (runtime entry-point identification) are the planned consumers.
//
// 🟡 BOUNDED STAGING on the realization side. The declaration +
// Rust impl + Rust binding (`rust_workflow_root_port_accessor` +
// `workflow_root_port_binding_rust` in `src/v3/spec/rust.dag`) land
// in Prereq-3a (this PR), which puts the accessor in
// `substrate_accessor_universe` so any `.dag` consumer that
// references it lowers to the Rust template. Per-target
// Python/Go bindings are NOT in this PR. Trigger: when a Python
// or Go emitter first consumes `workflow_root_port`, the
// corresponding `SubstrateAccessorBinding` lands atomically with
// that consumer — same staging discipline as `lane2_workflow_at`
// (Rust binding landed first because the lens runtime needs it;
// other targets land when they emit a consumer). Today's path
// fails closed at emit time for the unbound targets via
// `EmitError::MissingSubstrateAccessorRealization`.
fn workflow_root_port(d: Dag) -> WorkflowRoot {
  host workflow_root_port
}

// `Lookup<DeclarationId>` monomorphized constructors (same shim story as
// `miss_int_lookup` in `v3.std.lookup` and `miss_symbolic_cost_lookup` in
// `std.algebra`). Lives here so `infer_helpers.dag` can call them via
// `std.substrate` without `std.lookup` importing declaration identity types.
fn miss_declaration_id_lookup() -> Lookup<DeclarationId> {
  Miss
}

fn hit_declaration_id_lookup(id: DeclarationId) -> Lookup<DeclarationId> {
  Hit(id)
}
