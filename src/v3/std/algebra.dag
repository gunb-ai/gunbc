// std.algebra — structural algebra shared across lenses.
//
// 🟡 SCAFFOLD at Stage 2d scope. This file ships the carrier types +
// composition algebra for `SymbolicCost`, the asymptotic-bound
// coproduct consumed by `lenses/cost.dag` (DB-7). The broader
// algebra hierarchy (Monoid, Lattice, Ring, ...) authored at
// `dsl/std/algebra.dag` for v2 is NOT ported yet — Stage 2d needs
// `SymbolicCost` alone; later lanes pull algebra structures in as
// concrete consumers demand them, same policy as
// `src/v3/std/effects.dag` Stage 2a.
//
// **SymbolicCost coproduct (seven variants per DB-7
// `docs/design-symbolic-cost-algebra.md`):**
//   - `ConstantCost(Int)`          — O(1) bounds
//   - `LinearCost(SizeVariable)`   — O(n) over a named size
//   - `PolynomialCost { var, degree }` — O(n^k)
//   - `ProductCost(List<SymbolicCost>)` — O(n·m) product
//   - `SumCost(List<SymbolicCost>)` — O(n + m) sum, dominated terms drop
//   - `LogCost(SizeVariable)`      — O(log n)
//   - `UnknownCost(String)`        — top of the dominance lattice
//
// **`UnknownCost` role — algebra element, not failure channel.**
// Reviewer call-out on PR #537: the earlier "fail-open" framing
// straddled two stories. Locked here: `UnknownCost` is a
// legitimate member of the cost algebra representing the most
// conservative asymptotic upper bound. `dominates(Unknown, X) =
// True` for every `X`; nothing but itself dominates Unknown.
// The `String` payload carries a user-facing reason (exotic
// bound the thesis doesn't yet model — O(n!), O(2^n) — or "the
// analyzer could not prove a tighter bound"). Treating Unknown
// as top keeps the composition algebra total and keeps
// downstream consumers from having to special-case "bound not
// known yet."
//
// Failure — "this behavior cannot inhabit the cost dimension at
// all" (malformed DAG reference, missing producer) — lives
// OUTSIDE `SymbolicCost`:
//   - `SymbolicCostLookup::MissingCost` is the lens-boundary
//     failure carrier (see `src/v3/lenses/cost.dag`); every
//     composition wrapper propagates it.
//   - `Witness<SymbolicCost>::Violates` from
//     `src/v3/std/dimensions.dag` is the Dimension-boundary
//     failure carrier. Stage 2f's generic `analyze` will route
//     MissingCost-at-the-lens into Violates-at-the-dimension.
// Keeping the two failure channels outside the algebra carrier
// lets `SymbolicCost` stay a trustworthy algebra element without
// a "maybe" mode consumers have to unwrap.
//
// Four-pattern dissolution receipt (Q4 per DB-7):
//
//   - Pattern 1 (fact placement): fails. Every consumer dispatches
//     on cost variant first — dominance on Polynomial/Linear pairs,
//     list flattening on Sum/Product, name extraction on
//     Linear/Log/Polynomial. No neutral placement above the variant
//     tag.
//   - Pattern 2 (variant-is-data): fails. ConstantCost carries a
//     literal Int; LinearCost/LogCost carry a SizeVariable;
//     PolynomialCost carries `{var, degree}`; Product/Sum carry
//     lists of costs; UnknownCost carries a reason String. Each
//     payload is structurally distinct.
//   - Pattern 3 (algebraic-form): confirms terminality. The seven
//     variants are the asymptotic bounds the thesis reasons about;
//     exotic bounds (O(n!), O(2^n)) collapse to `UnknownCost` with
//     a reason until a concrete consumer forces variant growth.
//   - Pattern 4 (dimensional): fails. No common coordinate space
//     generates all seven — LinearCost's payload is a SizeVariable,
//     ProductCost's is a list, ConstantCost's is an Int.
//
// STOP SIGNAL: wanting an eighth variant. Pause and escalate rather
// than extending; the thesis claim is that seven covers the
// asymptotic surface, and any new variant should carry its own
// dissolution receipt.

module v3.std.algebra

import std.algebra { Semiring, BoundedLattice }
import std.list { List, empty, fold, cons, singleton, filter }
import std.substrate { NonSingletonList, PortId, DeclarationId }
import std.termination { AdditionalStep, OneStep, PositiveDescentAmount }
import v3.std.lookup { Lookup }

// 🟡 SCAFFOLD coproduct. These are v2 per-method output-size effect facts
// staged in v3 as the MethodContract metadata vocabulary. Pattern 1 fails
// for the §6a pick: cost/complexity need the facts co-located per method,
// not scattered into lens-local tables. Pattern 2 partially fits the unit
// variants but would erase the closed semantic partition that consumers
// dispatch on. Pattern 3 is the intended dissolution: once live call-site
// MethodContract producers read structural return-type / collection-shape
// facts, this carrier either narrows to those structural facts or remains as
// their named projection. Trigger: the bulk MethodContract producer/consumer
// migration replaces template-row seeding with structural method contracts.
type CollectionSizeEffect
  = ShrinkEffect
  | ProjectionEffect
  | IdentityEffect

// Operation cost shape — structural contract on a method's algorithmic cost.
// Declared per method on `MethodContract`; cost/complexity lenses read this
// to compute cost expressions without string-dispatching on method names.
//
// 🟡 SCAFFOLD coproduct. Pattern 1 fails because cost shape belongs beside the
// same method identity as size/callback metadata. Pattern 2 fails because the
// variants name distinct closed asymptotic classes, not one labeled record
// shape with free data. Pattern 3 is the dissolution path: live cost analysis
// should derive these classes from `CostBound` / call-pattern structure when
// MethodContract lookup is wired at call sites. Trigger: the post-§6a bulk
// migration makes MethodContract construction consume E-C/E-I/E-P facts
// directly instead of copying template metadata.
type CostShape
  = ShapeConstant
  | ShapeLinearScan
  | ShapeIterateBody
  | ShapeSortBody

// Unified per-method metadata carrier for v3 lens consumers. This is the
// §6a Option 3 shape: one lookup key `(algebra_id, method_id)` using existing
// `DeclarationId` identity, with the method contract facts cost/complexity
// need co-located. It deliberately does not extend substrate declarations or
// create one carrier per algebra.
//
// 🟡 TRANSITIONAL. This carrier centralizes facts that two lenses need today,
// but it is not the endpoint. Field-level dissolution:
// - `size_effect` dissolves into collection-cardinality-refined method
//   signatures.
// - `cost_shape` dissolves into a typed cost surface / structural cost
//   derivation.
// - `callback_element_position` dissolves into typed higher-order callback
//   parameter shape.
type MethodContract {
  algebra_id: DeclarationId
  method_id: DeclarationId
  size_effect: CollectionSizeEffect?
  cost_shape: CostShape?
  callback_element_position: Int?
}

// 🟢 TERMINAL. `SizeVariable` names the runtime size of a DAG
// port's value. Two cost expressions correlate structurally via
// `source_port` equality — different folds over the same port
// describe the SAME size; two folds over different ports do NOT,
// even if both lists have the same declared type.
//
// `display_name` is presentation only. Identity stays on `source_port`
// so two size variables that name the same runtime value compare equal
// even if one lacks an authored display label.
type SizeVariable {
  source_port: PortId
  display_name: String?
}

fn unnamed_size_variable(source_port: PortId) -> SizeVariable {
  host unnamed_size_variable
}

fn size_variable_eq(a: SizeVariable, b: SizeVariable) -> Bool =
  a.source_port == b.source_port

// 🟢 TERMINAL. Polynomial degrees `>= 2` as a structural carrier, not a
// pseudo-refinement over `Int`. `LinearCost` remains the sole degree-1 surface,
// and `ConstantCost` carries degree-0 behavior; this sum makes 0/1 literally
// unrepresentable inside `PolynomialCost`.
//
// Track 9 constructor-validation asymmetry still exists at the API boundary:
// Rust's `DegreeAtLeastTwo::new(Int) -> Option<_>` remains the only generic
// `Int -> DegreeAtLeastTwo` constructor today. The substrate is the authority
// for the inhabitant set; a `.dag`-level validator/constructor (for example
// `degree_of(n) -> DegreeAtLeastTwo?`) is the dissolution trigger for removing
// the Rust-side validation asymmetry in the Lane 3c self-hosting cycle.
type DegreeAtLeastTwo
  = DegreeTwo
  | DegreeSuccessor { previous: DegreeAtLeastTwo }

// 🟢 TERMINAL at Stage 2d scope. The asymptotic-bound coproduct
// DB-7 locks. See the module-level receipt for dissolution-pattern
// evidence. The `Semiring<SymbolicCost>` inhabitance edge is the
// substrate prerequisite for downstream Verification law witnesses
// (INVARIANTS §P1); it does not retire those law rows in this slice.
// This is intentionally edge-only today: v3 can parse the imported
// `Semiring<T>` instantiation, but class-5 structural data lowering still
// rejects honest function-valued witness fields (`add`, `mul`, etc.). Do
// NOT add a parallel ad-hoc witness table. Dissolution trigger:
// `symbolic_cost_semiring_structural_witness_lands` - when function-valued
// structural data fields lower cleanly, author the single
// `data symbolic_cost_semiring: Semiring<SymbolicCost>` witness with
// `add = sequential`, `zero = ConstantCost(0)`, `mul = iterate`, and
// `one = ConstantCost(1)`, then retire this edge-only boundary note in the
// same PR.
type SymbolicCost inhabits Semiring<SymbolicCost>
  = ConstantCost(Int)
  | LinearCost(SizeVariable)
  | PolynomialCost { var: SizeVariable, degree: DegreeAtLeastTwo }
  | ProductCost(NonSingletonList<SymbolicCost>)
  | SumCost(NonSingletonList<SymbolicCost>)
  | LogCost(SizeVariable)
  | UnknownCost(String)

// Scan state for composite `dominates` / `drop_dominated_step`.
//
// 🟢 TERMINAL (`docs/modeling-discipline.md` §4). Structural product
// `{ any, pivot }` only — no phantom coproduct arm. Values use block literals
// (`{ any: …, pivot: … }`) and `dominate_scan_init`; field projection uses
// `acc.any` / `acc.pivot` like other conjunctive std carriers (`SizeVariable`,
// `MethodContract`).
type DominateScanAcc {
  any: Bool
  pivot: SymbolicCost
}

fn dominate_scan_init(pivot: SymbolicCost) -> DominateScanAcc = {
  any: False
  pivot: pivot
}

// SymbolicCost-monomorphized `Lookup` constructors. Same shim story
// as `miss_int_lookup` / `hit_int_lookup` in `v3.std.lookup`: v3 infer
// cannot yet prove bare `Miss` / `Hit(v)` bodies against a generic
// `Lookup<value>` return type, so each concrete element gets a named
// constructor. Rust emit lowers both calls to `Lookup::Miss` /
// `Lookup::Hit(..)` (see `lookup_monomorphized_constructor_emit` in `rust_target.rs`).
// Lives here (not in `v3.std.lookup`) because `SymbolicCost` is the
// lens-side algebra element and `std.lookup` must stay free of algebra
// imports.
fn miss_symbolic_cost_lookup() -> Lookup<SymbolicCost> {
  Miss
}

fn hit_symbolic_cost_lookup(cost: SymbolicCost) -> Lookup<SymbolicCost> {
  Hit(cost)
}

fn two_terms(a: SymbolicCost, b: SymbolicCost) -> NonSingletonList<SymbolicCost> =
  {
    first: a
    second: b
    // Grammar workaround: this is semantically `empty()` for
    // `List<SymbolicCost>`, but v3 does not yet infer that typed-empty witness
    // reliably from the surrounding `NonSingletonList<SymbolicCost>` context.
    // Collapse this back to `rest: empty()` once typed-empty inference lands.
    rest: filter(singleton(a), reject_all_symbolic_costs)
  }

fn many_terms(
  first: SymbolicCost,
  second: SymbolicCost,
  rest: List<SymbolicCost>
) -> NonSingletonList<SymbolicCost> =
  {
    first: first
    second: second
    rest: rest
  }

fn reject_all_symbolic_costs(cost: SymbolicCost) -> Bool =
  match singleton(cost) {
    Empty => False
    Cons(_) => False
  }

fn degree_raw(degree: DegreeAtLeastTwo) -> Int =
  match degree {
    DegreeTwo => 2
    DegreeSuccessor(payload) => degree_raw(payload.previous) + 1
  }

// ── Composition (sequential / iterate / max_path) ───────────────

// `sequential(a, b)` composes two costs in series. The resulting
// sum normalizes dominated terms away — `O(n) + O(1) = O(n)`.
fn sequential(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost =
  normalize(SumCost(two_terms(a, b)))

// `iterate(bound, body)` composes an iteration: `body` runs
// `bound`-many times. `O(n) * O(1) = O(n)`; `O(n) * O(n) = O(n²)`
// when the two LinearCost terms share a SizeVariable.
fn iterate(bound: SymbolicCost, body: SymbolicCost) -> SymbolicCost =
  normalize(ProductCost(two_terms(bound, body)))

// Lambda-free helper so `max_path`'s fold below resolves its
// function-type parameter without relying on bidirectional
// inference through a closure.
//
// Three-way semantics (fixes PR #537 review: Facts Flow Forward
// violation — pairing paths via `if dominates(c, acc) then c else
// acc` silently dropped whichever path was ordered later when the
// two were incomparable, e.g. `Linear(n)` vs `Linear(m)` with
// distinct size variables):
//
//   - candidate dominates acc → return candidate (acc drops, Big-O
//     dominance is stable).
//   - acc dominates candidate → return acc (candidate drops).
//   - neither dominates → preserve both via `sequential`, relying
//     on `Big-O(f + g) = Big-O(max(f, g))` for non-negative
//     asymptotic terms; `normalize` inside `sequential` still drops
//     anything the other term dominates.
fn max_path_step(acc: SymbolicCost, candidate: SymbolicCost) -> SymbolicCost =
  if dominates(candidate, acc) then
    candidate
  else
    keep_or_sum(acc, candidate)

fn keep_or_sum(acc: SymbolicCost, candidate: SymbolicCost) -> SymbolicCost =
  if dominates(acc, candidate) then
    acc
  else
    sequential(acc, candidate)

// `max_path(paths)` takes the dominant cost across alternative
// control-flow paths (Branch arms). Worst-case asymptotic
// semantics: a branch between `O(n)` and `O(n²)` costs `O(n²)`
// overall; a branch between `O(n)` and `O(m)` (incomparable)
// costs `O(n + m)` — both facts flow forward.
fn max_path(paths: List<SymbolicCost>) -> SymbolicCost =
  fold(paths, ConstantCost(0), max_path_step)

// ── Dominance ───────────────────────────────────────────────────
//
// Asymptotic dominance: `a` dominates `b` iff `a` grows at least as
// fast as `b`. Dropped terms in `normalize` and path selection in
// `max_path` both read this.
//
// Rules implemented here (DB-7 §"Dominance / normalization"):
//   - Unknown dominates everything (safest over-approximation).
//   - Constant is dominated by everything else.
//   - Polynomial(v, k1) dominates Polynomial(v, k2) iff k1 >= k2.
//   - `PolynomialCost` carries `DegreeAtLeastTwo`, so `Linear(v)` is
//     the sole degree-1 surface.
//   - Product/Sum use the dominant child as a summary (MVP — full
//     term-by-term comparison lands with the multi-variable
//     fixtures in Stage 2d+ follow-up).
fn dominates(a: SymbolicCost, b: SymbolicCost) -> Bool =
  match a {
    UnknownCost(_) => True
    ConstantCost(_) =>
      match b {
        ConstantCost(_) => True
        UnknownCost(_) => False
        LinearCost(_) => False
        PolynomialCost(_) => False
        ProductCost(_) => False
        SumCost(_) => False
        LogCost(_) => False
      }
    LinearCost(va) =>
      match b {
        ConstantCost(_) => True
        LogCost(_) => True
        LinearCost(vb) => same_size_variable(va, vb)
        PolynomialCost(payload) =>
          False
        UnknownCost(_) => False
        ProductCost(_) => False
        SumCost(_) => False
      }
    PolynomialCost(pa) =>
      match b {
        ConstantCost(_) => True
        LogCost(_) => True
        LinearCost(vb) =>
          same_size_variable(pa.var, vb)
        PolynomialCost(pb) =>
          if same_size_variable(pa.var, pb.var) then
            degree_raw(pa.degree) >= degree_raw(pb.degree)
          else
            False
        UnknownCost(_) => False
        ProductCost(_) => False
        SumCost(_) => False
      }
    LogCost(va) =>
      match b {
        ConstantCost(_) => True
        LogCost(vb) => same_size_variable(va, vb)
        LinearCost(_) => False
        PolynomialCost(_) => False
        ProductCost(_) => False
        SumCost(_) => False
        UnknownCost(_) => False
      }
    // Single semantic definition (DB-7 / R2 dissolution): when `a`
    // is a composite (`ProductCost` / `SumCost`), `a` dominates `b`
    // iff **any child** dominates `b`. The list walk uses `std.list.fold`
    // with `fold_or_dominate_scan` so the surface call graph does not form
    // an invalid mutually-recursive SCC with `dominates` (M1 checker).
    ProductCost(terms) =>
      scan_hit(
        fold(
          nsl_to_list(terms),
          dominate_scan_init(b),
          fold_or_dominate_scan
        )
      )
    SumCost(terms) =>
      scan_hit(
        fold(
          nsl_to_list(terms),
          dominate_scan_init(b),
          fold_or_dominate_scan
        )
      )
  }

fn same_size_variable(a: SizeVariable, b: SizeVariable) -> Bool =
  size_variable_eq(a, b)

// Terminal asymptotic-class carrier for complexity display and budget
// enforcement. Ordering is by asymptotic dominance:
// ClassConstant <= ClassLog <= ClassLinear <= ClassLinearithmic <=
// ClassQuadratic <= ClassPolynomial(k>=3) <= ClassExponential <= ClassUnknown.
//
// `asymptotic_dominates(ClassPolynomial { degree: da }, ClassPolynomial { degree: db })`
// compares Peano degrees structurally (same order as `positive_descent_count` depth).
// Implemented with a local catamorphism so this module does **not** import
// `std.computation` (that would create a bootstrap SCC: `std.computation` imports
// `std.algebra`, and `v3.std.algebra` already depends on `std.algebra`).
// `v3_compiler::complexity_lattice::complexity_enforcement_budget_dominates` stays aligned
// with this `.dag` relation for every arm including poly×poly (single authority for gate #92).
type AsymptoticClass inhabits BoundedLattice<AsymptoticClass>
  = ClassConstant
  | ClassLog
  | ClassLinear
  | ClassLinearithmic
  | ClassQuadratic
  | ClassPolynomial { degree: PositiveDescentAmount }
  | ClassExponential
  | ClassUnknown

// True iff Peano depth(da) ≥ Peano depth(db) for `PositiveDescentAmount` witnesses.
fn positive_descent_amount_count_ge(da: PositiveDescentAmount, db: PositiveDescentAmount) -> Bool =
  match da {
    OneStep =>
      match db {
        OneStep => True
        AdditionalStep { previous: _ } => False
      }
    AdditionalStep { previous: pa } =>
      match db {
        OneStep => True
        AdditionalStep { previous: pb } => positive_descent_amount_count_ge(pa, pb)
      }
  }

fn asymptotic_dominates(a: AsymptoticClass, b: AsymptoticClass) -> Bool =
  match a {
    ClassUnknown => True
    ClassExponential =>
      match b {
        ClassUnknown => False
        ClassExponential => True
        ClassPolynomial(_) => True
        ClassQuadratic => True
        ClassLinearithmic => True
        ClassLinear => True
        ClassLog => True
        ClassConstant => True
      }
    ClassPolynomial { degree: da } =>
      match b {
        ClassUnknown => False
        ClassExponential => False
        ClassPolynomial { degree: db } =>
          positive_descent_amount_count_ge(da, db)
        ClassQuadratic => True
        ClassLinearithmic => True
        ClassLinear => True
        ClassLog => True
        ClassConstant => True
      }
    ClassQuadratic =>
      match b {
        ClassConstant => True
        ClassLog => True
        ClassLinear => True
        ClassLinearithmic => True
        ClassQuadratic => True
        ClassPolynomial(_) => False
        ClassExponential => False
        ClassUnknown => False
      }
    ClassLinearithmic =>
      match b {
        ClassConstant => True
        ClassLog => True
        ClassLinear => True
        ClassLinearithmic => True
        ClassQuadratic => False
        ClassPolynomial(_) => False
        ClassExponential => False
        ClassUnknown => False
      }
    ClassLinear =>
      match b {
        ClassConstant => True
        ClassLog => True
        ClassLinear => True
        ClassLinearithmic => False
        ClassQuadratic => False
        ClassPolynomial(_) => False
        ClassExponential => False
        ClassUnknown => False
      }
    ClassLog =>
      match b {
        ClassConstant => True
        ClassLog => True
        ClassLinear => False
        ClassLinearithmic => False
        ClassQuadratic => False
        ClassPolynomial(_) => False
        ClassExponential => False
        ClassUnknown => False
      }
    ClassConstant =>
      match b {
        ClassConstant => True
        ClassLog => False
        ClassLinear => False
        ClassLinearithmic => False
        ClassQuadratic => False
        ClassPolynomial(_) => False
        ClassExponential => False
        ClassUnknown => False
      }
  }

fn meet_asymptotic_class(a: AsymptoticClass, b: AsymptoticClass) -> AsymptoticClass =
  if asymptotic_dominates(a, b) then b else a

fn join_asymptotic_class(a: AsymptoticClass, b: AsymptoticClass) -> AsymptoticClass =
  if asymptotic_dominates(a, b) then a else b

fn classify_symbolic_cost(cost: SymbolicCost) -> AsymptoticClass {
  host classify_symbolic_cost
}

// ── Normalization ───────────────────────────────────────────────
//
// `normalize(c)` simplifies a SymbolicCost expression by:
//   - dropping `ConstantCost(0)` from Sum lists,
//   - collapsing Product lists containing `ConstantCost(0)` to zero,
//   - dropping `ConstantCost(1)` from Product lists,
//   - collapsing Sums/Products whose term lists reduce to a single
//     element,
//   - folding a Product of two identical LinearCosts into
//     `PolynomialCost(var, 2)` — the nested-fold fingerprint the
//     `all_pairs` fixture leans on,
//   - otherwise returning the input unchanged.
//
// Full recursive flattening of nested Sums/Products is deferred —
// the composition ops construct trees two deep at most, so the
// MVP handles that surface directly.
fn normalize(c: SymbolicCost) -> SymbolicCost =
  match c {
    ConstantCost => c
    LinearCost => c
    PolynomialCost => c
    LogCost => c
    UnknownCost => c
    SumCost(terms) => reduce_sum(drop_additive_zero(nsl_to_list(terms)))
    ProductCost(terms) =>
      reduce_product(drop_multiplicative_one(collapse_on_multiplicative_zero(nsl_to_list(terms))))
  }

fn nsl_to_list(terms: NonSingletonList<SymbolicCost>) -> List<SymbolicCost> =
  cons(terms.first, cons(terms.second, terms.rest))

// Drops `ConstantCost(0)` terms from a list of costs. Used by
// normalize so `SumCost([Linear, Constant(0)])` collapses to the
// single Linear term (DB-7 acceptance test).
fn drop_additive_zero(terms: List<SymbolicCost>) -> List<SymbolicCost> =
  match terms {
    Empty => empty()
    Cons(payload) =>
      if is_zero_constant(payload.head) then
        drop_additive_zero(payload.tail)
      else
        cons(payload.head, drop_additive_zero(payload.tail))
  }

// Multiplicative zero is an annihilator, not a removable identity. This keeps
// `Semiring<SymbolicCost>` honest: `O(n) * 0` collapses to `0`, while additive
// zero remains removable only under `SumCost`.
fn collapse_on_multiplicative_zero(terms: List<SymbolicCost>) -> List<SymbolicCost> =
  if any_zero(terms) then
    cons(ConstantCost(0), empty())
  else
    terms

fn any_zero(terms: List<SymbolicCost>) -> Bool =
  match terms {
    Empty => False
    Cons(payload) => is_zero_constant(payload.head) || any_zero(payload.tail)
  }

// Multiplicative one is the product identity. Once zero-annihilation has run,
// `ConstantCost(1)` terms can be removed from products without losing work.
fn drop_multiplicative_one(terms: List<SymbolicCost>) -> List<SymbolicCost> =
  match terms {
    Empty => empty()
    Cons(payload) =>
      if is_one_constant(payload.head) then
        drop_multiplicative_one(payload.tail)
      else
        cons(payload.head, drop_multiplicative_one(payload.tail))
  }

fn is_zero_constant(c: SymbolicCost) -> Bool =
  match c {
    ConstantCost(n) => n == 0
    LinearCost(_) => False
    PolynomialCost(_) => False
    ProductCost(_) => False
    SumCost(_) => False
    LogCost(_) => False
    UnknownCost(_) => False
  }

fn is_one_constant(c: SymbolicCost) -> Bool =
  match c {
    ConstantCost(n) => n == 1
    LinearCost(_) => False
    PolynomialCost(_) => False
    ProductCost(_) => False
    SumCost(_) => False
    LogCost(_) => False
    UnknownCost(_) => False
  }

// If a SumCost reduces to a single term, return that term; else keep
// the canonical `NonSingletonList` wrapper with dominated terms
// dropped.
//
// PR #537 reviewer (ChatGPT) call-out: the Cons-branch previously
// wrapped the result of `drop_dominated` in `SumCost(...)`
// unconditionally, so an input like `SumCost([Linear(n),
// Constant(5)])` — where `drop_dominated` correctly strips the
// dominated `Constant(5)` and leaves a singleton — landed as the
// invalid `SumCost([Linear(n)])`. Now a post-drop singleton
// unwraps via `wrap_sum` so the post-normalize carrier stays
// canonical (≥ 2 terms in any surviving `SumCost`). Rust mirror in
// `dag.rs::reduce_sum` already handles this via its `match terms.len()`
// arms; this keeps the .dag authority in sync.
fn reduce_sum(terms: List<SymbolicCost>) -> SymbolicCost =
  match terms {
    Empty => ConstantCost(0)
    Cons(payload) =>
      match payload.tail {
        Empty => payload.head
        Cons(_) => wrap_sum(drop_dominated(cons(payload.head, payload.tail)))
      }
  }

fn wrap_sum(terms: List<SymbolicCost>) -> SymbolicCost =
  match terms {
    Empty => ConstantCost(0)
    Cons(payload) =>
      match payload.tail {
        Empty => payload.head
        Cons(second) => SumCost(many_terms(payload.head, second.head, second.tail))
      }
  }

// If a ProductCost reduces to a single term, return it; if the
// product is two LinearCosts over the same variable, fold to
// `PolynomialCost(var, 2)`; otherwise keep the wrapper.
fn reduce_product(terms: List<SymbolicCost>) -> SymbolicCost =
  match terms {
    Empty => ConstantCost(1)
    Cons(payload) =>
      match payload.tail {
        Empty => payload.head
        Cons(second) =>
          match second.tail {
            Empty => combine_binary_product(payload.head, second.head)
            Cons(_) => ProductCost(many_terms(payload.head, second.head, second.tail))
          }
      }
  }

// Binary product special-case: two LinearCosts over the same port
// collapse to PolynomialCost with degree 2. Other shapes stay as
// a two-element ProductCost.
fn combine_binary_product(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost =
  match a {
    LinearCost(va) => combine_linear_with(va, a, b)
    ConstantCost(_) => product_pair(a, b)
    PolynomialCost(_) => product_pair(a, b)
    LogCost(_) => product_pair(a, b)
    SumCost(_) => product_pair(a, b)
    ProductCost(_) => product_pair(a, b)
    UnknownCost(_) => product_pair(a, b)
  }

fn combine_linear_with(va: SizeVariable, a: SymbolicCost, b: SymbolicCost) -> SymbolicCost =
  match b {
    LinearCost(vb) => collapse_linear_square(va, vb, a, b)
    ConstantCost(_) => product_pair(a, b)
    PolynomialCost(_) => product_pair(a, b)
    LogCost(_) => product_pair(a, b)
    SumCost(_) => product_pair(a, b)
    ProductCost(_) => product_pair(a, b)
    UnknownCost(_) => product_pair(a, b)
  }

fn collapse_linear_square(
  va: SizeVariable,
  vb: SizeVariable,
  a: SymbolicCost,
  b: SymbolicCost
) -> SymbolicCost =
  if same_size_variable(va, vb) then
    polynomial_square(va)
  else
    product_pair(a, b)

fn polynomial_square(v: SizeVariable) -> SymbolicCost {
  PolynomialCost { var: v, degree: DegreeTwo }
}

fn product_pair(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost =
  ProductCost(two_terms(a, b))

fn fold_or_dominate_scan(acc: DominateScanAcc, c: SymbolicCost) -> DominateScanAcc = {
  any: acc.any || dominates(c, acc.pivot)
  pivot: acc.pivot
}

fn scan_hit(scan: DominateScanAcc) -> Bool =
  scan.any

fn filter_not_dominated_by(
  candidates: List<SymbolicCost>,
  winner: SymbolicCost
) -> List<SymbolicCost> =
  match candidates {
    Empty => empty()
    Cons(payload) =>
      if dominates(winner, payload.head) then
        filter_not_dominated_by(payload.tail, winner)
      else
        cons(payload.head, filter_not_dominated_by(payload.tail, winner))
  }

fn drop_dominated_step(
  acc: List<SymbolicCost>,
  term: SymbolicCost
) -> List<SymbolicCost> =
  if scan_hit(fold(acc, dominate_scan_init(term), fold_or_dominate_scan)) then
    acc
  else
    cons(term, filter_not_dominated_by(acc, term))

// Drops terms from a SumCost list that are dominated by another
// term in the list. MVP: O(n²) pairwise walk; acceptable because
// the sum lists in practice are short (≤ 3 terms).
fn drop_dominated(terms: List<SymbolicCost>) -> List<SymbolicCost> =
  fold(terms, empty(), drop_dominated_step)
