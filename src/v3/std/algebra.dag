// std.algebra — structural algebra shared across lenses.
//
// 🟡 SCAFFOLD at Stage 2d scope. This file ships the carrier types +
// composition algebra for `SymbolicCost`, the asymptotic-bound
// coproduct consumed by `lenses/cost.dag` (DB-7). The broader
// algebra hierarchy (Monoid, Lattice, Ring, ...) authored at
// `dsl/std/algebra.dag` for v2 is NOT ported yet — Stage 2d needs
// `SymbolicCost` alone; later lanes pull algebra structures in as
// concrete consumers demand them, same policy as
// `src/v3/std/effects.dag` Stage 2a.
//
// **SymbolicCost coproduct (seven variants per DB-7
// `docs/design-symbolic-cost-algebra.md`):**
//   - `ConstantCost(Int)`          — O(1) bounds
//   - `LinearCost(SizeVariable)`   — O(n) over a named size
//   - `PolynomialCost { var, degree }` — O(n^k)
//   - `ProductCost(List<SymbolicCost>)` — O(n·m) product
//   - `SumCost(List<SymbolicCost>)` — O(n + m) sum, dominated terms drop
//   - `LogCost(SizeVariable)`      — O(log n)
//   - `UnknownCost(String)`        — top of the dominance lattice
//
// **`UnknownCost` role — algebra element, not failure channel.**
// Reviewer call-out on PR #537: the earlier "fail-open" framing
// straddled two stories. Locked here: `UnknownCost` is a
// legitimate member of the cost algebra representing the most
// conservative asymptotic upper bound. `dominates(Unknown, X) =
// True` for every `X`; nothing but itself dominates Unknown.
// The `String` payload carries a user-facing reason (exotic
// bound the thesis doesn't yet model — O(n!), O(2^n) — or "the
// analyzer could not prove a tighter bound"). Treating Unknown
// as top keeps the composition algebra total and keeps
// downstream consumers from having to special-case "bound not
// known yet."
//
// Failure — "this behavior cannot inhabit the cost dimension at
// all" (malformed DAG reference, missing producer) — lives
// OUTSIDE `SymbolicCost`:
//   - `SymbolicCostLookup::MissingCost` is the lens-boundary
//     failure carrier (see `src/v3/lenses/cost.dag`); every
//     composition wrapper propagates it.
//   - `Witness<SymbolicCost>::Violates` from
//     `src/v3/std/dimensions.dag` is the Dimension-boundary
//     failure carrier. Stage 2f's generic `analyze` will route
//     MissingCost-at-the-lens into Violates-at-the-dimension.
// Keeping the two failure channels outside the algebra carrier
// lets `SymbolicCost` stay a trustworthy algebra element without
// a "maybe" mode consumers have to unwrap.
//
// Four-pattern dissolution receipt (Q4 per DB-7):
//
//   - Pattern 1 (fact placement): fails. Every consumer dispatches
//     on cost variant first — dominance on Polynomial/Linear pairs,
//     list flattening on Sum/Product, name extraction on
//     Linear/Log/Polynomial. No neutral placement above the variant
//     tag.
//   - Pattern 2 (variant-is-data): fails. ConstantCost carries a
//     literal Int; LinearCost/LogCost carry a SizeVariable;
//     PolynomialCost carries `{var, degree}`; Product/Sum carry
//     lists of costs; UnknownCost carries a reason String. Each
//     payload is structurally distinct.
//   - Pattern 3 (algebraic-form): confirms terminality. The seven
//     variants are the asymptotic bounds the thesis reasons about;
//     exotic bounds (O(n!), O(2^n)) collapse to `UnknownCost` with
//     a reason until a concrete consumer forces variant growth.
//   - Pattern 4 (dimensional): fails. No common coordinate space
//     generates all seven — LinearCost's payload is a SizeVariable,
//     ProductCost's is a list, ConstantCost's is an Int.
//
// STOP SIGNAL: wanting an eighth variant. Pause and escalate rather
// than extending; the thesis claim is that seven covers the
// asymptotic surface, and any new variant should carry its own
// dissolution receipt.

module v3.std.algebra

import std.list { List, empty, fold, cons }
import std.substrate { NonSingletonList, PortId }

// 🟢 TERMINAL. `SizeVariable` names the runtime size of a DAG
// port's value. Two cost expressions correlate structurally via
// `source_port` equality — different folds over the same port
// describe the SAME size; two folds over different ports do NOT,
// even if both lists have the same declared type.
//
// No `name: String` field: MVP rendering pins on port equality
// alone, and the user-facing label the DB-7 design doc sketches
// needs an InternTable lookup the lens doesn't yet run. When a
// render consumer pins the missing piece, `SizeVariable` grows a
// `name` field alongside the Rust mirror in `src/v3/compiler/src/dag.rs`.
type SizeVariable {
  source_port: PortId
}

type DegreeAtLeastTwo {
  value: Int
}

// 🟢 TERMINAL at Stage 2d scope. The asymptotic-bound coproduct
// DB-7 locks. See the module-level receipt for dissolution-pattern
// evidence.
type SymbolicCost
  = ConstantCost(Int)
  | LinearCost(SizeVariable)
  | PolynomialCost { var: SizeVariable, degree: DegreeAtLeastTwo }
  | ProductCost(NonSingletonList<SymbolicCost>)
  | SumCost(NonSingletonList<SymbolicCost>)
  | LogCost(SizeVariable)
  | UnknownCost(String)

fn two_terms(a: SymbolicCost, b: SymbolicCost) -> NonSingletonList<SymbolicCost> = {
  first: a
  second: b
  rest: empty()
}

fn many_terms(
  first: SymbolicCost,
  second: SymbolicCost,
  rest: List<SymbolicCost>
) -> NonSingletonList<SymbolicCost> = {
  first: first
  second: second
  rest: rest
}

// ── Composition (sequential / iterate / max_path) ───────────────

// `sequential(a, b)` composes two costs in series. The resulting
// sum normalizes dominated terms away — `O(n) + O(1) = O(n)`.
fn sequential(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost =
  normalize(SumCost(two_terms(a, b)))

// `iterate(bound, body)` composes an iteration: `body` runs
// `bound`-many times. `O(n) * O(1) = O(n)`; `O(n) * O(n) = O(n²)`
// when the two LinearCost terms share a SizeVariable.
fn iterate(bound: SymbolicCost, body: SymbolicCost) -> SymbolicCost =
  normalize(ProductCost(two_terms(bound, body)))

// Lambda-free helper so `max_path`'s fold below resolves its
// function-type parameter without relying on bidirectional
// inference through a closure.
//
// Three-way semantics (fixes PR #537 review: Facts Flow Forward
// violation — pairing paths via `if dominates(c, acc) then c else
// acc` silently dropped whichever path was ordered later when the
// two were incomparable, e.g. `Linear(n)` vs `Linear(m)` with
// distinct size variables):
//
//   - candidate dominates acc → return candidate (acc drops, Big-O
//     dominance is stable).
//   - acc dominates candidate → return acc (candidate drops).
//   - neither dominates → preserve both via `sequential`, relying
//     on `Big-O(f + g) = Big-O(max(f, g))` for non-negative
//     asymptotic terms; `normalize` inside `sequential` still drops
//     anything the other term dominates.
fn max_path_step(acc: SymbolicCost, candidate: SymbolicCost) -> SymbolicCost =
  if dominates(candidate, acc) then
    candidate
  else
    keep_or_sum(acc, candidate)

fn keep_or_sum(acc: SymbolicCost, candidate: SymbolicCost) -> SymbolicCost =
  if dominates(acc, candidate) then
    acc
  else
    sequential(acc, candidate)

// `max_path(paths)` takes the dominant cost across alternative
// control-flow paths (Branch arms). Worst-case asymptotic
// semantics: a branch between `O(n)` and `O(n²)` costs `O(n²)`
// overall; a branch between `O(n)` and `O(m)` (incomparable)
// costs `O(n + m)` — both facts flow forward.
fn max_path(paths: List<SymbolicCost>) -> SymbolicCost =
  fold(paths, ConstantCost(0), max_path_step)

// ── Dominance ───────────────────────────────────────────────────
//
// Asymptotic dominance: `a` dominates `b` iff `a` grows at least as
// fast as `b`. Dropped terms in `normalize` and path selection in
// `max_path` both read this.
//
// Rules implemented here (DB-7 §"Dominance / normalization"):
//   - Unknown dominates everything (safest over-approximation).
//   - Constant is dominated by everything else.
//   - Polynomial(v, k1) dominates Polynomial(v, k2) iff k1 >= k2.
//   - `PolynomialCost` carries `DegreeAtLeastTwo`, so `Linear(v)` is
//     the sole degree-1 surface.
//   - Product/Sum use the dominant child as a summary (MVP — full
//     term-by-term comparison lands with the multi-variable
//     fixtures in Stage 2d+ follow-up).
fn dominates(a: SymbolicCost, b: SymbolicCost) -> Bool =
  match a {
    UnknownCost(_) => True
    ConstantCost(_) =>
      match b {
        ConstantCost(_) => True
        UnknownCost(_) => False
        LinearCost(_) => False
        PolynomialCost(_) => False
        ProductCost(_) => False
        SumCost(_) => False
        LogCost(_) => False
      }
    LinearCost(va) =>
      match b {
        ConstantCost(_) => True
        LogCost(_) => True
        LinearCost(vb) => same_size_variable(va, vb)
        PolynomialCost(payload) =>
          False
        UnknownCost(_) => False
        ProductCost(_) => False
        SumCost(_) => False
      }
    PolynomialCost(pa) =>
      match b {
        ConstantCost(_) => True
        LogCost(_) => True
        LinearCost(vb) =>
          same_size_variable(pa.var, vb)
        PolynomialCost(pb) =>
          if same_size_variable(pa.var, pb.var) then
            pa.degree.value >= pb.degree.value
          else
            False
        UnknownCost(_) => False
        ProductCost(_) => False
        SumCost(_) => False
      }
    LogCost(va) =>
      match b {
        ConstantCost(_) => True
        LogCost(vb) => same_size_variable(va, vb)
        LinearCost(_) => False
        PolynomialCost(_) => False
        ProductCost(_) => False
        SumCost(_) => False
        UnknownCost(_) => False
      }
    // Conservative fallback: the correct "dominant child summary"
    // rule walks the composite's children and returns True iff any
    // child dominates `b`. Expressing that walk in .dag requires
    // mutual recursion between `dominates` (descending on
    // `SymbolicCost`) and a list-iterating helper (descending on
    // `List<SymbolicCost>`), which v3's termination analyzer
    // cannot prove yet — cluster descent witnesses in #519 share
    // a single type, and cross-type mutual recursion lands as a
    // substrate extension (flagged as a Lane 1 / Stage 2d+
    // follow-up in the ROADMAP). The Rust mirror in
    // `src/v3/compiler/src/dag.rs::dominates` carries the
    // recursive form; this .dag branch returns `False` as a
    // conservative over-approximation — callers that ask "does a
    // composite dominate `b`" get `False` (safe: composite stays
    // in `drop_dominated`'s keep list, `max_path` preferring
    // scalars), never a false True that could drop legitimate
    // terms. The generated Rust projection of this lens is not
    // affected because it reads through the Rust `dominates`
    // function directly.
    ProductCost(_) => False
    SumCost(_) => False
  }

fn same_size_variable(a: SizeVariable, b: SizeVariable) -> Bool =
  a.source_port == b.source_port

// ── Normalization ───────────────────────────────────────────────
//
// `normalize(c)` simplifies a SymbolicCost expression by:
//   - dropping `ConstantCost(0)` from Sum/Product lists,
//   - collapsing Sums/Products whose term lists reduce to a single
//     element,
//   - folding a Product of two identical LinearCosts into
//     `PolynomialCost(var, 2)` — the nested-fold fingerprint the
//     `all_pairs` fixture leans on,
//   - otherwise returning the input unchanged.
//
// Full recursive flattening of nested Sums/Products is deferred —
// the composition ops construct trees two deep at most, so the
// MVP handles that surface directly.
fn normalize(c: SymbolicCost) -> SymbolicCost =
  match c {
    ConstantCost => c
    LinearCost => c
    PolynomialCost => c
    LogCost => c
    UnknownCost => c
    SumCost(terms) => reduce_sum(drop_zero(nsl_to_list(terms)))
    ProductCost(terms) => reduce_product(drop_zero(nsl_to_list(terms)))
  }

fn nsl_to_list(terms: NonSingletonList<SymbolicCost>) -> List<SymbolicCost> =
  cons(terms.first, cons(terms.second, terms.rest))

// Drops `ConstantCost(0)` terms from a list of costs. Used by
// normalize so `SumCost([Linear, Constant(0)])` collapses to the
// single Linear term (DB-7 acceptance test).
fn drop_zero(terms: List<SymbolicCost>) -> List<SymbolicCost> =
  match terms {
    Empty => empty()
    Cons(payload) =>
      if is_zero_constant(payload.head) then
        drop_zero(payload.tail)
      else
        cons(payload.head, drop_zero(payload.tail))
  }

fn is_zero_constant(c: SymbolicCost) -> Bool =
  match c {
    ConstantCost(n) => n == 0
    LinearCost(_) => False
    PolynomialCost(_) => False
    ProductCost(_) => False
    SumCost(_) => False
    LogCost(_) => False
    UnknownCost(_) => False
  }

// If a SumCost reduces to a single term, return that term; else keep
// the canonical `NonSingletonList` wrapper with dominated terms
// dropped.
//
// PR #537 reviewer (ChatGPT) call-out: the Cons-branch previously
// wrapped the result of `drop_dominated` in `SumCost(...)`
// unconditionally, so an input like `SumCost([Linear(n),
// Constant(5)])` — where `drop_dominated` correctly strips the
// dominated `Constant(5)` and leaves a singleton — landed as the
// invalid `SumCost([Linear(n)])`. Now a post-drop singleton
// unwraps via `wrap_sum` so the post-normalize carrier stays
// canonical (≥ 2 terms in any surviving `SumCost`). Rust mirror in
// `dag.rs::reduce_sum` already handles this via its `match terms.len()`
// arms; this keeps the .dag authority in sync.
fn reduce_sum(terms: List<SymbolicCost>) -> SymbolicCost =
  match terms {
    Empty => ConstantCost(0)
    Cons(payload) =>
      match payload.tail {
        Empty => payload.head
        Cons(_) => wrap_sum(drop_dominated(cons(payload.head, payload.tail)))
      }
  }

fn wrap_sum(terms: List<SymbolicCost>) -> SymbolicCost =
  match terms {
    Empty => ConstantCost(0)
    Cons(payload) =>
      match payload.tail {
        Empty => payload.head
        Cons(second) => SumCost(many_terms(payload.head, second.head, second.tail))
      }
  }

// If a ProductCost reduces to a single term, return it; if the
// product is two LinearCosts over the same variable, fold to
// `PolynomialCost(var, 2)`; otherwise keep the wrapper.
fn reduce_product(terms: List<SymbolicCost>) -> SymbolicCost =
  match terms {
    Empty => ConstantCost(0)
    Cons(payload) =>
      match payload.tail {
        Empty => payload.head
        Cons(second) =>
          match second.tail {
            Empty => combine_binary_product(payload.head, second.head)
            Cons(_) => ProductCost(many_terms(payload.head, second.head, second.tail))
          }
      }
  }

// Binary product special-case: two LinearCosts over the same port
// collapse to PolynomialCost with degree 2. Other shapes stay as
// a two-element ProductCost.
fn combine_binary_product(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost =
  match a {
    LinearCost(va) => combine_linear_with(va, a, b)
    ConstantCost(_) => product_pair(a, b)
    PolynomialCost(_) => product_pair(a, b)
    LogCost(_) => product_pair(a, b)
    SumCost(_) => product_pair(a, b)
    ProductCost(_) => product_pair(a, b)
    UnknownCost(_) => product_pair(a, b)
  }

fn combine_linear_with(va: SizeVariable, a: SymbolicCost, b: SymbolicCost) -> SymbolicCost =
  match b {
    LinearCost(vb) => collapse_linear_square(va, vb, a, b)
    ConstantCost(_) => product_pair(a, b)
    PolynomialCost(_) => product_pair(a, b)
    LogCost(_) => product_pair(a, b)
    SumCost(_) => product_pair(a, b)
    ProductCost(_) => product_pair(a, b)
    UnknownCost(_) => product_pair(a, b)
  }

fn collapse_linear_square(
  va: SizeVariable,
  vb: SizeVariable,
  a: SymbolicCost,
  b: SymbolicCost
) -> SymbolicCost =
  if same_size_variable(va, vb) then
    polynomial_square(va)
  else
    product_pair(a, b)

fn polynomial_square(v: SizeVariable) -> SymbolicCost {
  PolynomialCost { var: v, degree: { value: 2 } }
}

fn product_pair(a: SymbolicCost, b: SymbolicCost) -> SymbolicCost =
  ProductCost(two_terms(a, b))

fn any_dominates(candidates: List<SymbolicCost>, term: SymbolicCost) -> Bool =
  match candidates {
    Empty => False
    Cons(payload) =>
      if dominates(payload.head, term) then
        True
      else
        any_dominates(payload.tail, term)
  }

fn filter_not_dominated_by(
  candidates: List<SymbolicCost>,
  winner: SymbolicCost
) -> List<SymbolicCost> =
  match candidates {
    Empty => empty()
    Cons(payload) =>
      if dominates(winner, payload.head) then
        filter_not_dominated_by(payload.tail, winner)
      else
        cons(payload.head, filter_not_dominated_by(payload.tail, winner))
  }

fn drop_dominated_step(
  acc: List<SymbolicCost>,
  term: SymbolicCost
) -> List<SymbolicCost> =
  if any_dominates(acc, term) then
    acc
  else
    cons(term, filter_not_dominated_by(acc, term))

// Drops terms from a SumCost list that are dominated by another
// term in the list. MVP: O(n²) pairwise walk; acceptable because
// the sum lists in practice are short (≤ 3 terms).
fn drop_dominated(terms: List<SymbolicCost>) -> List<SymbolicCost> =
  fold(terms, empty(), drop_dominated_step)
