// std.computation -- v3-staged computational lowering carriers.
//
// Bootstrap-staged mirror of `dsl/std/computation.dag` for Lane E-C. Keep
// these carrier shapes and pure lowering helpers aligned while v2 still scans
// `dsl/`. This file depends on Lane E-T's `std.termination` carriers.

module std.computation

import std.termination {
  DescentEvidence, DescentUnknown, Strict, NonIncreasing,
  PositiveDescentAmount, OneStep, AdditionalStep,
  ProportionalDivisor, DivideByTwo, StrictlyLarger
}
import std.algebra {
  AlgebraProfile, OrderedRingProfile, ApproximateFieldProfile,
  BooleanAlgebraProfile, BooleanAlgebraCollectionProfile,
  FreeMonoidScalarProfile, FreeMonoidCollectionProfile,
  PartialFunctionProfile,
  kernel_algebra_profile
}

// 🟡 MIXED coproduct — E-C `SizeBound` carrier (five-way flat sum). Dissolution: collapse
// `param: String` symbolic slots to structural size-parameter refs; `ExplicitCount` /
// `Forever` remain terminal finite-bound atoms (no String bridge).
type SizeBound
  = CollectionSize { param: String }
  | TreeSize { param: String }
  | ArithmeticParam { param: String }
  | ExplicitCount { n: Int }
  | Forever

fn tree_size_bound(param: String) -> SizeBound {
  TreeSize { param: param }
}

fn positive_descent_count(steps: PositiveDescentAmount) -> Int {
  match steps {
    OneStep => 1
    AdditionalStep { previous: p } => 1 + positive_descent_count(steps: p)
  }
}

// 🟡 MIXED coproduct — exhaustive call-shape classifier for `lower_call_pattern`. Dissolution:
// replace `String` accessor / witness / element slots with structural refs; Peano shrink
// payloads stay terminal (shared with `std.termination`).
type CallPattern
  = ChildAccessorCall { accessor: String }
  | CollectionShrinkCall { amount: PositiveDescentAmount, collection: String }
  | ArithmeticSubtractCall { steps: PositiveDescentAmount, ring_param: String }
  | ArithmeticDivideCall { divisor: ProportionalDivisor, ring_param: String }
  | ParserAdvanceCall { witness: String }
  | WorklistDrainCall { element: String }
  | FoldBodyCall { outer_collection: String }
  | SameArgumentCall

// 🟢 TERMINAL coproduct — shrink-rate witnesses aligned with `std.termination`. Dissolution: none
// (structural `PositiveDescentAmount` / `ProportionalDivisor` already proof-grade).
type ShrinkFactor
  = UnitShrink
  | ConstantShrink { steps: PositiveDescentAmount }
  | ProportionalShrink { divisor: ProportionalDivisor }

// 🟢 TERMINAL coproduct — `Fold` | `Descend` | `Repeat` lowering enum (Lane E-C). Dissolution:
// none (kept in lockstep with `std.iteration` primitives).
type IterationPrimitive
  = Fold
  | Descend
  | Repeat

// 🟡 MIXED record — product of the coproduct carriers above (not a coproduct itself).
// Dissolution inherits from `SizeBound` / `CallPattern` / optional `ShrinkFactor` String bridges.
type LoweringTarget {
  primitive: IterationPrimitive
  bound: SizeBound
  evidence: DescentEvidence
  factor: ShrinkFactor?
}

// `lower_call_pattern` copies CallPattern-carried `String` slots into `SizeBound.param`
// (no fabricated size labels). String bridges dissolve with structural refs (E-P).
fn lower_call_pattern(pattern: CallPattern) -> LoweringTarget {
  match pattern {
    ChildAccessorCall { accessor: a } =>
      LoweringTarget { primitive: Descend,
        bound: TreeSize { param: a },
        evidence: Strict, factor: none }

    CollectionShrinkCall { amount: p, collection: c } =>
      LoweringTarget { primitive: Fold,
        bound: CollectionSize { param: c },
        evidence: Strict,
        factor: Some { value: ConstantShrink { steps: p } } }

    ArithmeticSubtractCall { steps: p, ring_param: r } =>
      LoweringTarget { primitive: Repeat,
        bound: ArithmeticParam { param: r },
        evidence: Strict,
        factor: Some { value: ConstantShrink { steps: p } } }

    ArithmeticDivideCall { divisor: d, ring_param: r } =>
      LoweringTarget { primitive: Repeat,
        bound: ArithmeticParam { param: r },
        evidence: Strict,
        factor: Some { value: ProportionalShrink { divisor: d } } }

    ParserAdvanceCall { witness: w } =>
      LoweringTarget { primitive: Fold,
        bound: CollectionSize { param: w },
        evidence: Strict, factor: none }

    WorklistDrainCall { element: e } =>
      LoweringTarget { primitive: Fold,
        bound: CollectionSize { param: e },
        evidence: Strict, factor: none }

    FoldBodyCall { outer_collection: oc } =>
      LoweringTarget { primitive: Fold,
        bound: CollectionSize { param: oc },
        evidence: NonIncreasing, factor: none }

    SameArgumentCall =>
      LoweringTarget { primitive: Repeat,
        bound: Forever,
        evidence: NonIncreasing, factor: none }
  }
}

fn size_bound_param(bound: SizeBound) -> String? {
  match bound {
    TreeSize { param: p }       => Some { value: p }
    CollectionSize { param: p } => Some { value: p }
    ArithmeticParam { param: p } => Some { value: p }
    ExplicitCount { n: _ }      => none
    Forever                     => none
  }
}

fn is_constant_bound(bound: SizeBound) -> Bool {
  match bound {
    ExplicitCount { n: _ } => true
    Forever                => true
    _                      => false
  }
}

// Signed `Int` top iterate count (`i64::MAX`); matches `repeat(max_int)` cap.
fn forever_iteration_bound() -> Int { 9223372036854775807 }

// `none` when the bound is not constant (avoids conflating with `ExplicitCount { n: 0 }`).
fn constant_bound_value(bound: SizeBound) -> Int? {
  match bound {
    ExplicitCount { n: count } => Some { value: count }
    Forever                    => Some { value: forever_iteration_bound() }
    _                          => none
  }
}

// =========================================================================
// Type-directed iteration dimension (Lane E-C): algebra profile → bound kind
// =========================================================================
// 🟢 TERMINAL coproduct — E-C dissolution receipt: which symbolic bound class applies
// when analyzing recursion through a kernel `AlgebraProfile` (complements
// `IterationPrimitive`, which records what lowers, not which bound kind applies).
type IterationDimension
  = TreeDescent       // child accessor / tree-size descent
  | CollectionFold    // collection-sized iteration (list, set, map keys, …)
  | ArithmeticRepeat   // arithmetic-param / ordered-ring repeat bounds

fn algebra_profile_to_dimension(profile: AlgebraProfile) -> IterationDimension? {
  match profile {
    FreeMonoidCollectionProfile     => Some { value: CollectionFold }
    FreeMonoidScalarProfile         => Some { value: CollectionFold }
    BooleanAlgebraCollectionProfile => Some { value: CollectionFold }
    PartialFunctionProfile          => Some { value: CollectionFold }
    OrderedRingProfile              => Some { value: ArithmeticRepeat }
    ApproximateFieldProfile         => Some { value: ArithmeticRepeat }
    BooleanAlgebraProfile           => none
  }
}

fn type_iteration_dimension(type_name: String) -> IterationDimension? {
  if type_name == "Node" { Some { value: TreeDescent } }
  else {
    match kernel_algebra_profile |> get(type_name) {
      Some { value: p } => algebra_profile_to_dimension(profile: p)
      None => none
    }
  }
}
