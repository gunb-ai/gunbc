// std.computation -- v3-staged computational lowering carriers.
//
// Bootstrap-staged mirror of `dsl/std/computation.dag` for Lane E-C. Keep
// these carrier shapes and pure lowering helpers aligned while v2 still scans
// `dsl/`. This file depends on Lane E-T's `std.termination` carriers.

module std.computation

import std.termination { DescentEvidence, DivisionDescentFactor }
import std.types { NonNegativeInt, PositiveInt }
import std.algebra {
  AlgebraProfile, OrderedRingProfile, ApproximateFieldProfile,
  BooleanAlgebraProfile, BooleanAlgebraCollectionProfile,
  FreeMonoidScalarProfile, FreeMonoidCollectionProfile,
  PartialFunctionProfile,
  kernel_algebra_profile
}

// 🟡 SCAFFOLD. The five size regimes are durable, but the `param: String`
// payload mirrors the same first-class-reference bridge as
// `std.termination::RankingDimension` and dissolves when function parameters
// and field accessors are substrate references rather than names.
type SizeBound
  = CollectionSize { param: String }
  | TreeSize { param: String }
  | ArithmeticParam { param: String }
  | ExplicitCount { n: NonNegativeInt }
  | Forever

fn tree_size_bound(param: String) -> SizeBound {
  TreeSize { param: param }
}

// 🟡 SCAFFOLD. Call-site classifier mirroring `DescentSource`. The variant
// taxonomy is durable for E-C, but String payloads (`accessor`, `op`,
// `witness`, `element`) and the carrier itself dissolve once E-I/E-P land
// per-call provenance — at which point `CallPattern` becomes a projection
// of `SubValueRelation` evidence rather than an authored shape.
// Every descent-carrying variant also carries the source parameter name it
// descends over, so `lower_call_pattern` can project it into the
// `SizeBound.param` slot instead of fabricating a canned string. (The name
// remains a `String` bootstrap bridge mirroring `RankingDimension.param`;
// it dissolves with the same first-class-reference wave.)
// Arithmetic descent is split across subtract/divide so the refinement on
// each operator (subtract by >= 1, divide by >= 2) is representable at the
// carrier, mirroring `std.termination::DescentSource::ArithmeticSubtract /
// ArithmeticDivide`. No String `op` tag is authored — the variant is the op.
type CallPattern
  = ChildAccessorCall { accessor: String }
  | CollectionShrinkCall { collection: String, amount: PositiveInt }
  | ArithmeticSubtractCall { param: String, by: PositiveInt }
  | ArithmeticDivideCall { param: String, by: DivisionDescentFactor }
  | ParserAdvanceCall { stream: String, witness: String }
  | WorklistDrainCall { worklist: String, element: String }
  | FoldBodyCall { outer_collection: String }
  | SameArgumentCall

// 🟢 TERMINAL at shrink-factor scope. Closed algebra of how a ranking
// measure decreases per call edge: by one, by a constant, or by a divisor.
// No further refinement is owed at the carrier layer. Amounts and divisors
// reuse the shared `PositiveInt` / `DivisionDescentFactor` authorities so
// zero / negative / divide-by-one witnesses are unrepresentable.
type ShrinkFactor
  = UnitShrink
  | ConstantShrink { amount: PositiveInt }
  | ProportionalShrink { divisor: DivisionDescentFactor }

// 🟢 TERMINAL. The three iteration primitives are the closed alphabet of
// the behavioral concept DAG (fold / descend / repeat); see MODELING.md M9.
// All higher-level computation desugars onto these three.
type IterationPrimitive
  = Fold
  | Descend
  | Repeat

// 🟡 SCAFFOLD aggregate. `LoweringTarget` bundles the carriers above into a
// per-call staging record consumed by the E-C Rust mirror until E-I/E-P
// produce the same record from per-call provenance lenses; at that point
// this struct dissolves into the lens query and the field set is recovered
// structurally, not authored.
type LoweringTarget {
  primitive: IterationPrimitive
  bound: SizeBound
  evidence: DescentEvidence
  factor: ShrinkFactor?
}

fn lower_call_pattern(pattern: CallPattern) -> LoweringTarget {
  match pattern {
    ChildAccessorCall { accessor: a } =>
      LoweringTarget { primitive: Descend,
        bound: TreeSize { param: a },
        evidence: Strict, factor: none }

    CollectionShrinkCall { collection: c, amount: k } =>
      LoweringTarget { primitive: Fold,
        bound: CollectionSize { param: c },
        evidence: Strict,
        factor: Some { value: ConstantShrink { amount: k } } }

    ArithmeticSubtractCall { param: p, by: k } =>
      LoweringTarget { primitive: Repeat,
        bound: ArithmeticParam { param: p },
        evidence: Strict,
        factor: Some { value: ConstantShrink { amount: k } } }

    ArithmeticDivideCall { param: p, by: k } =>
      LoweringTarget { primitive: Repeat,
        bound: ArithmeticParam { param: p },
        evidence: Strict,
        factor: Some { value: ProportionalShrink { divisor: k } } }

    ParserAdvanceCall { stream: s, witness: _ } =>
      LoweringTarget { primitive: Fold,
        bound: CollectionSize { param: s },
        evidence: Strict, factor: none }

    WorklistDrainCall { worklist: w, element: _ } =>
      LoweringTarget { primitive: Fold,
        bound: CollectionSize { param: w },
        evidence: Strict, factor: none }

    FoldBodyCall { outer_collection: oc } =>
      LoweringTarget { primitive: Fold,
        bound: CollectionSize { param: oc },
        evidence: NonIncreasing, factor: none }

    SameArgumentCall =>
      LoweringTarget { primitive: Repeat,
        bound: Forever,
        evidence: NonIncreasing, factor: none }
  }
}

fn size_bound_param(bound: SizeBound) -> String? {
  match bound {
    TreeSize { param: p }       => Some { value: p }
    CollectionSize { param: p } => Some { value: p }
    ArithmeticParam { param: p } => Some { value: p }
    ExplicitCount { n: _ }      => none
    Forever                     => none
  }
}

// `Forever` is "constant" in the sense that it collapses to a fixed
// constant-cost COEFFICIENT in the size/cost algebra — *not* that it carries
// a finite runtime iteration count. See `constant_bound_value` for the
// coefficient projection.
fn is_constant_bound(bound: SizeBound) -> Bool {
  match bound {
    ExplicitCount { n: _ } => true
    Forever                => true
    _                      => false
  }
}

// Returns the constant VALUE only for `SizeBound` variants that carry one
// directly, and the constant-cost COEFFICIENT for `Forever`. Non-constant
// bounds map to `none` rather than fabricating 0. Pair with
// `is_constant_bound` at the call site if a Bool guard is needed.
//
// `Forever => Some(1)` is the O(1) constant-cost coefficient for the
// size/cost algebra (SameArgumentCall → Repeat(Forever) collapses to a
// single-unit cost projection per v2's `dsl/std/computation.dag:269-275`).
// It is NOT a claim that `Forever` represents a finite iteration count of 1.
fn constant_bound_value(bound: SizeBound) -> Int? {
  match bound {
    ExplicitCount { n: count } => Some { value: count }
    Forever                    => Some { value: 1 }
    _                          => none
  }
}

// 🟢 TERMINAL. Projection of the algebra-profile table into the three
// iteration regimes. Closed alongside `IterationPrimitive`; new dimensions
// would have to land via a new algebra profile, not a new variant here.
type IterationDimension
  = TreeDescent
  | CollectionFold
  | ArithmeticRepeat

fn algebra_profile_to_dimension(profile: AlgebraProfile) -> IterationDimension? {
  match profile {
    FreeMonoidCollectionProfile     => Some { value: CollectionFold }
    FreeMonoidScalarProfile         => Some { value: CollectionFold }
    BooleanAlgebraCollectionProfile => Some { value: CollectionFold }
    PartialFunctionProfile          => Some { value: CollectionFold }
    OrderedRingProfile              => Some { value: ArithmeticRepeat }
    ApproximateFieldProfile         => Some { value: ArithmeticRepeat }
    BooleanAlgebraProfile           => none
  }
}

fn type_iteration_dimension(type_name: String) -> IterationDimension? {
  if type_name == "Node" { Some { value: TreeDescent } }
  else {
    match kernel_algebra_profile |> get(type_name) {
      Some { value: p } => algebra_profile_to_dimension(profile: p)
      None => none
    }
  }
}
