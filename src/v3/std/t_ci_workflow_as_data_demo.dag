// v3.std.t_ci_workflow_as_data_demo — T-Workflow-As-Data gate `ci_workflow_modeled_as_dag`
// (gunbc#1956). Structural receipt: CI-shaped workflow authored as `.dag` data over
// `extdeps.github.actions` carriers; timing dimension applies `Lens<TimingMeasurement>`
// hooks from `v3.std.timing_lens` and yields `DimensionReport<TimingMeasurement>` through
// the body evaluator (E6-G1.a option-3 shaped reporting shell).

module v3.std.t_ci_workflow_as_data_demo

import std.list { List, Empty, Cons, is_empty }
import std.types { Bool }
import std.substrate { Behavior, Cluster, Dag, DagPort, Declaration }
import extdeps.github.actions {
  Workflow,
  Job,
  Step,
  UsesStep,
  HostedRunner,
  UbuntuLatest,
  Push,
  checkout_action,
  setup_rust_action
}
import v3.std.dimensions { Witness, OptionalDiagnostic, DimensionReport }
import v3.std.diagnostics { Diagnostic }
import v3.std.timing_lens {
  TimingMeasurement,
  timing_lens_behavior_span,
  timing_lens_scaffold_non_evidence_diagnostic,
  timing_lens_validate,
  timing_sequential_identity
}
import v3.std.workflows { behavior_spine }

// Modeled subset of gunbc CI: push trigger + ubuntu-latest job with checkout + Rust setup.
data modeled_gunbc_ci_workflow: Workflow = Workflow {
  name: "gunbc-ci-demo",
  on: Cons {
    head: Push { branches: Empty, paths: Empty },
    tail: Empty,
  },
  jobs: Cons {
    head: Job {
      id: "build",
      name: none,
      runner: HostedRunner { label: UbuntuLatest },
      steps: Cons {
        head: UsesStep {
          name: none,
          uses: checkout_action,
          with: { fetch_depth: "1" },
          env: { DEMO_CI: "1" },
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none,
        },
        tail: Cons {
          head: UsesStep {
            name: none,
            uses: setup_rust_action,
            with: { rust_version: "stable" },
            env: { DEMO_CI: "1" },
            if_condition: none,
            continue_on_error: false,
            timeout_minutes: none,
          },
          tail: Empty,
        },
      },
      needs: Empty,
      env: { CI: "demo" },
      if_condition: none,
      strategy: none,
      timeout_minutes: none,
      continue_on_error: false,
      concurrency: none,
    },
    tail: Empty,
  },
  env: { WORKFLOW_LEVEL: "demo" },
  permissions: none,
}

// Historical note: an earlier PB-1 receipt wrapped this predicate in `_ci_wad_nonlinear_timing_stub`
// (`gate ||` dead `contains` clause) so `b` appeared in an unreachable arm for unused-parameter
// hygiene. The eager evaluator now closes the spine gate with declared `is_empty`/`behavior_spine`
// alone — no name-keyed Rust escape hatch.

// Discriminate `b` at the outer bind and validate timing against `d` inline so reachability sees
// both parameter ports (same rationale as the spine gate on `d`).
fn ci_demo_timing_read(d: Dag, b: Behavior) -> Witness<TimingMeasurement> =
  match b {
    Value(_) =>
      match timing_lens_validate(d, timing_sequential_identity()) {
        NoDiagnostic => Inhabits(timing_sequential_identity())
        SomeDiagnostic { value: _ } => Inhabits(timing_sequential_identity())
      }
    Transform(_) =>
      match timing_lens_validate(d, timing_sequential_identity()) {
        NoDiagnostic => Inhabits(timing_sequential_identity())
        SomeDiagnostic { value: _ } => Inhabits(timing_sequential_identity())
      }
    Branch(_) =>
      match timing_lens_validate(d, timing_sequential_identity()) {
        NoDiagnostic => Inhabits(timing_sequential_identity())
        SomeDiagnostic { value: _ } => Inhabits(timing_sequential_identity())
      }
    Loop(_) =>
      match timing_lens_validate(d, timing_sequential_identity()) {
        NoDiagnostic => Inhabits(timing_sequential_identity())
        SomeDiagnostic { value: _ } => Inhabits(timing_sequential_identity())
      }
    Bind(_) =>
      match timing_lens_validate(d, timing_sequential_identity()) {
        NoDiagnostic => Inhabits(timing_sequential_identity())
        SomeDiagnostic { value: _ } => Inhabits(timing_sequential_identity())
      }
  }

// Non-stub witness path: same timing read as the stub-true branch (PB-1-safe). The modeled CI
// workflow remains substrate-authoritative via `data modeled_gunbc_ci_workflow` above; passing that
// `data` binding into callees or matching `w.jobs` is not supported on embedded bootstrap yet.
fn ci_wad_modeled_workflow_timing_witness(d: Dag, b: Behavior) -> Witness<TimingMeasurement> =
  ci_demo_timing_read(d, b)

// PB-1 integration harness: `find_list_empty_constructor_tag` needs `List<τ>.Empty` rows for each
// `Dag` record field type — mirror `_e6_seed_*` in `e6_g1a_option3_static_lens_test.rs`.
fn _ci_wad_seed_list_declaration_empty() -> List<Declaration> = Empty

fn _ci_wad_seed_list_behavior_empty() -> List<Behavior> = Empty

fn _ci_wad_seed_list_dagport_empty() -> List<DagPort> = Empty

fn _ci_wad_seed_list_cluster_empty() -> List<Cluster> = Empty

fn _ci_wad_empty_list_diagnostic() -> List<Diagnostic> = Empty

fn _ci_wad_empty_list_witness_tm() -> List<Witness<TimingMeasurement>> = Empty

fn _ci_wad_witnesses_singleton_tm(c: TimingMeasurement) -> List<Witness<TimingMeasurement>> =
  Cons { head: Inhabits(c), tail: _ci_wad_empty_list_witness_tm() }

fn _ci_wad_violations_singleton(diag: Diagnostic) -> List<Diagnostic> =
  Cons { head: diag, tail: _ci_wad_empty_list_diagnostic() }

fn _ci_wad_dimension_ok_tm_payload(c: TimingMeasurement) -> DimensionReport<TimingMeasurement> =
  DimensionOk {
    dimension_name: "ci_modeled_timing",
    composed: c,
    witnesses: _ci_wad_witnesses_singleton_tm(c),
  }

fn _ci_wad_dimension_fail_tm_payload(c: TimingMeasurement, diag: Diagnostic) -> DimensionReport<TimingMeasurement> =
  DimensionFail {
    dimension_name: "ci_modeled_timing",
    violations: _ci_wad_violations_singleton(diag),
    witnesses: _ci_wad_witnesses_singleton_tm(c),
  }

// Thread `d` via `behavior_spine` so `lenses.unused_parameters` stays clean on full bootstrap.
// Payload records live in dedicated binds so `compile_to_dag(cost.dag)` inference does not
// duplicate unresolved record ports across `match` arms (lane2 Stage 2d).
fn report_dim_ok_tm(d: Dag, c: TimingMeasurement) -> DimensionReport<TimingMeasurement> =
  match behavior_spine(d) {
    Empty => _ci_wad_dimension_ok_tm_payload(c)
    Cons { head: _h, tail: _t } => _ci_wad_dimension_ok_tm_payload(c)
  }

fn report_dim_fail_tm(d: Dag, c: TimingMeasurement, diag: Diagnostic) -> DimensionReport<TimingMeasurement> =
  match behavior_spine(d) {
    Empty => _ci_wad_dimension_fail_tm_payload(c, diag)
    Cons { head: _h, tail: _t } => _ci_wad_dimension_fail_tm_payload(c, diag)
  }

fn report_inhabits_branch_tm(d: Dag, c: TimingMeasurement, od: OptionalDiagnostic) -> DimensionReport<TimingMeasurement> =
  match od {
    NoDiagnostic => report_dim_ok_tm(d, c)
    SomeDiagnostic { value: diag } => report_dim_fail_tm(d, c, diag)
  }

fn dimension_report_tm_from_witness(d: Dag, w: Witness<TimingMeasurement>) -> DimensionReport<TimingMeasurement> =
  match w {
    Inhabits(c) => report_inhabits_branch_tm(d, c, timing_lens_validate(d, c))
    Violates { reason: r, at: beh } =>
      report_dim_fail_tm(
        d,
        timing_sequential_identity(),
        timing_lens_scaffold_non_evidence_diagnostic(r, timing_lens_behavior_span(beh))
      )
  }

// Evaluator receipt entrypoint: single spine predicate + branches only on `Bool` so
// `evaluate_body` does not need resolved `Behavior` match arms (PB-1 embed omits `infer`).
//
// Branches on `is_empty(behavior_spine(d))` so both parameters participate on the embedded
// bootstrap path without `Behavior` match lowering. When the spine is empty, take the first
// witness read; otherwise use `ci_wad_modeled_workflow_timing_witness` (currently the same read).
//
// Dissolution trigger (Progress Is Dissolution): when PB-1 embedded bootstrap carries the
// inference / optional-match materialization needed for `evaluate_body` on `ci_demo_timing_read`
// (same fixpoint as fresh `regen_bootstrap` — see `ensure_all_optional_match_disjs`), collapse
// to `dimension_report_tm_from_witness(d, ci_demo_timing_read(d, b))` once full witness lowering lands.
fn demo_ci_modeled_timing_dimension_report(d: Dag, b: Behavior) -> DimensionReport<TimingMeasurement> =
  if is_empty(behavior_spine(d)) then
    dimension_report_tm_from_witness(d, ci_demo_timing_read(d, b))
  else
    dimension_report_tm_from_witness(d, ci_wad_modeled_workflow_timing_witness(d, b))
