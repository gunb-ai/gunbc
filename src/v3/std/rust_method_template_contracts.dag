// v3.std.rust_method_template_contracts -- per-method render-template
// rows for the Rust target, populating the `MethodTemplateContract`
// substrate carrier in `src/v3/std/emit_model.dag`.
//
// SCOPE (T-Ground-LanguageSpec scope E.1, Phase 1): row population
// only. **Authority classification:** this file is the v3-side
// single-authority for future emission. v2's emit pipeline still
// consumes the legacy `rust_simple_method_specs` /
// `rust_method_templates()` / `rust_method_wraps_result()` chain in
// `dsl/extdeps/languages/rust/emit.dag` because v2 has no
// bootstrap-Dag consumer infrastructure to read these rows. Full
// retirement of those legacy authorities is **deferred to
// Pure-Bootstrap-Zero / v2 retirement scope** (manager dispatch
// #1133 inbox 4344956791). The row-list here is net-additive until
// then. (Phase 2 retired the dead `MethodTranslation` declarations
// in `runtime.dag` — zero v2 consumers — but emit-side authorities
// continue serving v2.)
//
// HOME (post-#1187 audit lesson): this file lives under `src/v3/std/`
// because v2's `collect_dag_sources` walks `dsl/` recursively (see
// `src/v2/tests/src/pipeline.rs:27`) — placing this file in
// `dsl/extdeps/languages/...` would re-trigger the cross-tree-import
// regression. The bootstrap-fixture authority
// (`src/v3/std/extdeps_bootstrap_fixtures.dag`) plus
// `BOOTSTRAP_FIXTURE_PATH_KEYS` (`src/v3/compiler/src/bootstrap.rs`)
// resolve mixed-tree fixtures across `STAGED_FILES` and `EXTDEPS_FILES`.
//
// PLACEHOLDER CONVENTION: every row uses `NamedArg`. Where the legacy
// `MethodTranslation` template used `{arg0}`, the row's
// `runtime_template` rewrites to `{arg}` per the canonical convention
// (rows with one argument; no positional ambiguity).
//
// PHASE 1.5 HIGHER-ORDER ROWS:
//   - `all` / `any` / `filter` / `flat_map` now use
//     `MethodEmitTemplate.HigherOrderTemplates`, preserving the legacy
//     `rust_higher_order_methods` inline/fn-ref template split. The
//     legacy `wraps_in_sharing` bit is represented by the existing
//     row-level `wraps_result` field so wrapping remains a single
//     authority. This file is the v3-side row authority; the legacy table
//     remains for v2 until Grounding retires it.
//
// DRIFT RECEIPTS (resolved in this row set; old authorities retain
// their pre-consolidation shapes until Phase 2):
//   - `count`: runtime `"{recv}.len()"` differs from emit
//     `"({recv}.len() as i64)"`; both kept distinct in the row's
//     `runtime_template` / `emit_template`. Emit wraps to `i64` because
//     algebra `count` returns `Int`, while Rust `len()` returns `usize`.
//   - `{arg0}` → `{arg}`: rewritten in `join`, `split` runtime
//     templates to match the row's `placeholder_convention: NamedArg`.
//   - Methods present only in `rust_simple_method_specs` (skip, take)
//     and not in `collection_method_translations` use the emit template
//     for both row sides — v2's actual behavior is "rust_method_templates
//     for both consumption sites" since `MethodTranslation` doesn't
//     declare them.

module v3.std.rust_method_template_contracts

import v3.std.emit_model {
  MethodTemplateContract,
  PlaceholderConvention,
  NamedArg,
  SingleTemplate,
  HigherOrderTemplates
}
import v3.std.methods { MethodRef }
import std.methods {
  all_method,
  any_method,
  count_method,
  filter_method,
  flat_map_method,
  join_method,
  split_method,
  last_method,
  first_method,
  enumerate_method,
  chars_method,
  skip_method,
  take_method
}

data rust_filter_method_template_contract: MethodTemplateContract = {
  dag_method: { decl: filter_method },
  runtime_template: "{ let mut __result = Vec::new(); for {param} in {iter} { if {body} { __result.push({param}); } } __result }",
  emit_template: HigherOrderTemplates {
    inline_template: "{ let mut __result = Vec::new(); for {param} in {iter} { if {body} { __result.push({param}); } } __result }",
    fn_ref_template: "{iter}.filter({arg}).collect::<Vec<_>>()"
  },
  wraps_result: true,
  placeholder_convention: NamedArg
}

data rust_any_method_template_contract: MethodTemplateContract = {
  dag_method: { decl: any_method },
  runtime_template: "{ let mut __found = false; for {param} in {iter} { if {body} { __found = true; break; } } __found }",
  emit_template: HigherOrderTemplates {
    inline_template: "{ let mut __found = false; for {param} in {iter} { if {body} { __found = true; break; } } __found }",
    fn_ref_template: "{iter}.any({arg})"
  },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data rust_all_method_template_contract: MethodTemplateContract = {
  dag_method: { decl: all_method },
  runtime_template: "{ let mut __all = true; for {param} in {iter} { if !({body}) { __all = false; break; } } __all }",
  emit_template: HigherOrderTemplates {
    inline_template: "{ let mut __all = true; for {param} in {iter} { if !({body}) { __all = false; break; } } __all }",
    fn_ref_template: "{iter}.all({arg})"
  },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data rust_flat_map_method_template_contract: MethodTemplateContract = {
  dag_method: { decl: flat_map_method },
  runtime_template: "{ let mut __result = Vec::new(); for {param} in {iter} { __result.extend({inner_iter}); } __result }",
  emit_template: HigherOrderTemplates {
    inline_template: "{ let mut __result = Vec::new(); for {param} in {iter} { __result.extend({inner_iter}); } __result }",
    fn_ref_template: "{iter}.flat_map({arg}).collect::<Vec<_>>()"
  },
  wraps_result: true,
  placeholder_convention: NamedArg
}


data rust_method_template_contracts: List<MethodTemplateContract> = [
  {
    dag_method: { decl: count_method },
    runtime_template: "{recv}.len()",
    emit_template: SingleTemplate { template: "({recv}.len() as i64)" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: join_method },
    runtime_template: "{recv}.join(&{arg})",
    emit_template: SingleTemplate { template: "{recv}.join(&{arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: split_method },
    runtime_template: "{recv}.split(&{arg}).map(|s| s.to_string()).collect::<Vec<_>>()",
    emit_template: SingleTemplate { template: "{recv}.split(&{arg}).map(|s| s.to_string()).collect::<Vec<_>>()" },
    wraps_result: true,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: last_method },
    runtime_template: "{recv}.last().cloned()",
    emit_template: SingleTemplate { template: "{recv}.last().cloned()" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: first_method },
    runtime_template: "{recv}.first().cloned()",
    emit_template: SingleTemplate { template: "{recv}.first().cloned()" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: enumerate_method },
    runtime_template: "{recv}.iter().enumerate().map(|(i, v)| (i, v.clone())).collect::<Vec<_>>()",
    emit_template: SingleTemplate { template: "{recv}.iter().cloned().enumerate().map(|(i, v)| (i as i64, v)).collect::<Vec<_>>()" },
    wraps_result: true,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: chars_method },
    runtime_template: "{recv}.chars().map(|c| c as i64).collect::<Vec<_>>()",
    emit_template: SingleTemplate { template: "{recv}.chars().map(|c| c as i64).collect::<Vec<_>>()" },
    wraps_result: true,
    placeholder_convention: NamedArg
  },
  rust_filter_method_template_contract,
  rust_any_method_template_contract,
  rust_all_method_template_contract,
  rust_flat_map_method_template_contract,
  {
    dag_method: { decl: skip_method },
    runtime_template: "{recv}.iter().cloned().skip({arg} as usize).collect::<Vec<_>>()",
    emit_template: SingleTemplate { template: "{recv}.iter().cloned().skip({arg} as usize).collect::<Vec<_>>()" },
    wraps_result: true,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: take_method },
    runtime_template: "{recv}.iter().cloned().take({arg} as usize).collect::<Vec<_>>()",
    emit_template: SingleTemplate { template: "{recv}.iter().cloned().take({arg} as usize).collect::<Vec<_>>()" },
    wraps_result: true,
    placeholder_convention: NamedArg
  }
]
