// v3.std.bin_shim - carrier for .dag-authored binary shims.
//
// Authority: docs/design-pb-runtime-interpreter.md sections 4.2 and 5.4.
// Concrete per-binary declarations are PB-owned rows under
// `dsl/std/runtime/bin_shims/`; this file owns only the substrate carrier
// shape that those rows inhabit.

module v3.std.bin_shim

import std.types { NonEmptyStr }
import v3.spec.v3_l1 { DeclarationRef }

// 🟢 TERMINAL at BinShim carrier-introduction scope. A bin-shim is metadata
// plus a pointer to a .dag entry function, not a separate pipeline DSL.
// `entry` remains a plain `DeclarationRef` until the substrate can express
// `DeclarationRef<fn () -> std.process.ProcessExit>`; `ProcessExit` itself is
// already declared by `dsl/std/process.dag` and is intentionally not mirrored
// here.
type BinShim {
  entrypoint_name: NonEmptyStr
  description: String
  entry: DeclarationRef
}
