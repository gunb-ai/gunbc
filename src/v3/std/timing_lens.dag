// v3.std.timing_lens — T-Workflow-As-Data Slice 2 timing-lens substrate
// (gunbc#1955). Carriers consumed as `Lens<TimingMeasurement>` alongside
// `TimingObservationSet`, `WorkflowObservationAnchor`, and `TimingBudget`.
// Authority: `docs/design-timing-lens.md` + `docs/r3-structure.md` T-WAD row.
//
// 🟡 SCAFFOLD. External CI / runner timing facts are not yet reflected into
// `timing_lens_read`; the uniform unobserved witness is an honest fail-open
// substrate receipt until observation wiring lands. Loop-bound measure lowering
// into compositional timing algebra is deferred: `timing_measurement_iterate` is
// fail-closed on `Observed` (returns `Unobserved` while the bound cannot refine
// durations) and passes `Unobserved` / `Ambiguous` / `Stale` through unchanged.
module v3.std.timing_lens

import std.algebra { Monoid }
import std.list { List, is_empty }
import std.nat { Nat }
import std.types {
  Bool,
  ContentHash,
  FilePath,
  SourceSpan,
  WorkflowProducerId,
  WorkflowObserverId,
  WorkflowProverId,
  WorkflowRunId
}
import std.substrate { Dag, Behavior, LoopBound, NodeId }
import v3.std.diagnostics { Diagnostic, CompilerDiagnosticKind, Correction, RetirementPlan }
import v3.std.dimensions { Witness, OptionalDiagnostic }
import v3.std.lens { Lens }
import v3.std.lens_application { LensEnforcement, EnforceableLens }
import v3.std.workflows { behavior_spine }

// DB-11 `FilePath` witness for this module (same narrowing discipline as
// `LensRegistryEntry.lens_file` in `v3.compiler.regen`).
fn timing_lens_module_path_witness() -> FilePath =
  "src/v3/std/timing_lens.dag"

// PRACTICE 4 CHECKPOINT: 🟡 SCAFFOLD — nominal SI-nanosecond coordinate for
// durations and POSIX-epoch instants at this substrate layer. **Magnitude**
// uses `Nat` (non-negative; same counting authority as `PerfBaselineMeasurement`
// `median_ns` / `p99_delta_ns` in `v3.std.substrate`). Per-field upper bounds,
// signed pre-epoch instants, and `Measure<Time, S>` grounding remain deferred
// per Q-Unit-4 option (c) / `dsl/std/measure.dag` posture.
type Nanoseconds {
  count: Nat
}

// PRACTICE 4 / P5 — `TimingMeasurement` report coproduct (T-WAD Slice 2 / §1.8 gate #54):
// **🟢 GREEN (terminal)** — this sum is the landed observation-boundary coproduct:
// external timing **report** states (`Observed` carries `Nanoseconds`; `Unobserved` /
// `Ambiguous` / `Stale` are unit outcomes; no bare `Missing` label — witness-resolution
// collision class). Four-pattern dissolution (`docs/modeling-discipline.md#4-coproduct-dissolution`):
//   1. Fact placement — PASS: each variant names one external observation fact.
//   2. Variant-is-data — PASS: `Observed` carries `Nanoseconds`; others unit facts.
//   3. Algebraic form — PASS: closed sum over report outcomes (no stringly state).
//   4. Dimensional — N/A at this layer (time magnitude is tagged via `Nanoseconds`).
//
// **🟡 SCAFFOLD (hooks only, not the carrier sum):** `timing_measurement_lens_combine`
// precedence until evidence-bearing runners supply richer algebra; `timing_lens_read` /
// `timing_lens_validate` / `timing_measurement_iterate` behavior — see module banner
// and `timing_measurement_lens_combine` / `timing_lens_read` / `timing_lens_validate`
// below. Run/digest / anchor coordinates for each row stay on `WorkflowObservationAnchor`
// inside `TimingObservationEntry` (gate #55 attachment row). P5 / INVARIANTS Progress Is
// Dissolution + modeling-discipline checkpoint (~L131–L134) — **carrier = GREEN; hooks = YELLOW**.
//
// **Report-state join (scaffold, one authority):** `timing_measurement_lens_combine`
// below defines precedence for composing two `TimingMeasurement` values until
// evidence-bearing runners supply richer algebra. **`Unobserved` is strict on
// both operands** (never silenced by `Stale` / `Ambiguous` / `Observed`).
// Among non-`Unobserved` faults, `Stale` dominates `Ambiguous` on the left when
// pairing with `Observed` (see `Stale` / `Ambiguous` arms); `Observed`×`Observed`
// uses `sequential` sum vs `branch` max only in that combine helper.
//
type TimingMeasurement
  = Observed { duration: Nanoseconds }
  | Unobserved
  | Ambiguous
  | Stale

// Shared External Attachment Pattern — stable workflow-side anchor for facts
// sourced outside the `.dag` program text (CI logs, artifacts, receipts).
// Six invariants are documented in `docs/design-timing-lens.md` §2; this
// record carries the structural coordinates those invariants reference.
// Gate #55 invariant 1 (stable subject identity): `subject_node` is the
// substrate `NodeId` table key (`Dag.nodes` / `behavior_spine` witness order),
// not free-form path or source-span text — P2 Boundary Discipline / illegal-states
// hygiene (stringly span coordinates cannot inhabit this field).
// Gate #55 invariant 2 (observed-artifact identity): `artifact_digest` is
// `ContentHash` (`std.types`), not bare `String` — content-addressed binding /
// M9 nominal discipline so arbitrary prose cannot masquerade as a digest.
// Gate #55 invariant 3 (role separation): `producer_id`, `observer_id`, and
// `prover_id` use distinct branded nominals (`WorkflowProducerId`, …) so the
// three provenance roles cannot be mixed at callsites (vs three anonymous `String`s).
// Gate #55 invariant 4 (run context): `workflow_run_id` is `WorkflowRunId`, not
// bare `String`, so run scope is typed as a dedicated external-run key nominal.
// Declared before `TimingObservationEntry` so each observation row embeds the
// same anchor authority as its measurement (Boundary Discipline: one product
// fact, no join drift between payload and provenance).
type WorkflowObservationAnchor {
  subject_node: NodeId
  artifact_digest: ContentHash
  producer_id: WorkflowProducerId
  observer_id: WorkflowObserverId
  prover_id: WorkflowProverId
  attached_at_ns: Nanoseconds
  workflow_run_id: WorkflowRunId
}

// Gate #62 `substrate_gap_file_ingestion_closed` — T-Workflow-As-Data file-attachment
// substrate carrier (Refined-B-1 ratification: `docs/briefs/r3-substrate-gate-62-file-attachment-carrier-sub-canvas.md`,
// PR #2820; Director disposition relayed via PM msg_bc8c23f6 2026-05-13).
//
// **Refined-B-1 (strict 5-of-7 subset of `WorkflowObservationAnchor` above / gate #55):**
// same provenance/run coordinates as the timing anchor, with `artifact_digest` renamed to
// `content_digest` for file-ingestion vocabulary; drops `observer_id` + `prover_id` (timing-specific
// roles). Sibling-carrier pattern with `WorkflowSecret` / `CronExpression` on gate #53 — no
// `List<FileAttachment>` on Job/Step here (consumer-evidence deferral per Director Q4).
type FileAttachment {
  subject_node: NodeId
  content_digest: ContentHash
  producer_id: WorkflowProducerId
  workflow_run_id: WorkflowRunId
  attached_at_ns: Nanoseconds
}

// Gate #62 existence proof (`substrate_gap_file_ingestion_closed`): anonymous record literal
// with `-> FileAttachment` expected type (same discipline as `timing_lens_degenerate_empty_dag_span`
// → `SourceSpan`). Kept in this module so the return nominal resolves to the `FileAttachment` Conj
// adjacent above — cross-module `import` return typing did not supply a conj witness for `{…}`.
fn gate_62_file_attachment_demo_record(
  subject: NodeId,
  digest: ContentHash,
  producer: WorkflowProducerId,
  run: WorkflowRunId,
  attached: Nanoseconds
) -> FileAttachment =
  {
    subject_node: subject,
    content_digest: digest,
    producer_id: producer,
    workflow_run_id: run,
    attached_at_ns: attached,
  }

// Batched timing observations: each entry is anchor × measurement (typed edge).
type TimingObservationSet {
  observations: List<TimingObservationEntry>
}

type TimingObservationEntry {
  anchor: WorkflowObservationAnchor
  measurement: TimingMeasurement
}

// Budget carrier paired with timing enforcement (`LensEnforcement` / demo
// lanes consume this shape; substrate lands the fact here).
type TimingBudget {
  max: Nanoseconds
}

// T-LAS timing enforcement: `project` codomain for `LensEnforcement<TimingMeasurement,
// TimingBudget, TimingEnforcementProjected>`. Separates observed wall-clock usage (`TimedUsage`)
// from non-evidence report states (`NonEvidenceUsage`) so `project` never encodes the latter as a
// plausible `Nat` magnitude inside `TimingBudget` (P2 / illegal-states-unrepresentable; openai-pro
// review on gate #58).
//
// PRACTICE 4 / INVARIANTS P1 (`docs/modeling-discipline.md` §4 coproduct checkpoint) — traffic light:
// **🟢 GREEN (terminal)** — landed enforcement-projection coproduct: `TimedUsage` is the observed
// wall-clock usage coordinate (same `Nanoseconds` shape as `TimingBudget.max`); `NonEvidenceUsage`
// is a unit fact for `Unobserved` / `Ambiguous` / `Stale` (no `Nat` fault sentinel in `TimingBudget`).
// **🟡 SCAFFOLD** — none on this sum (both variants are substrate-final at this layer). **🔴 BLOCKED**
// — none. **Dissolution:** retire this sum only when every `project` consumer can thread full
// `TimingMeasurement` without illegal-state collisions (gate #58 `.dag` `TestClaim` / T-PB-B SG-0
// receipt per `INVARIANTS.md`).
type TimingEnforcementProjected
  = TimedUsage { max: Nanoseconds }
  | NonEvidenceUsage

// §1.8 / r3-program-plan `timing_lens_carrier_landed`: nominal `Lens<C>` surface at
// `C = TimingMeasurement` (see `docs/design-timing-lens.md` §1). Hooks below remain
// scaffold until `data … : TimingLens` rows are admissible under E6-G1 policy.
type TimingLens = Lens<TimingMeasurement>

fn timing_measurement_unobserved() -> TimingMeasurement =
  Unobserved

// Single declared join for `Lens<TimingMeasurement>` composition hooks.
// `sequential`: `Observed`×`Observed` sums nanoseconds; else `branch` takes max.
fn timing_measurement_lens_combine(a: TimingMeasurement, b: TimingMeasurement, sequential: Bool) -> TimingMeasurement =
  match a {
    Unobserved => Unobserved
    Stale =>
      match b {
        Unobserved => Unobserved
        Stale => Stale
        Ambiguous => Stale
        Observed { duration: _ } => Stale
      }
    Ambiguous =>
      match b {
        Unobserved => Unobserved
        Stale => Stale
        Ambiguous => Ambiguous
        Observed { duration: _ } => Ambiguous
      }
    Observed { duration: ax } =>
      match b {
        Unobserved => Unobserved
        Stale => Stale
        Ambiguous => Ambiguous
        Observed { duration: bx } =>
          if sequential then
            Observed { duration: { count: ax.count + bx.count } }
          else
            Observed {
              duration: if ax.count > bx.count then ax else bx,
            }
      }
  }

// Sequential monoid operation for `Lens<TimingMeasurement>.sequential`.
fn timing_sequential_op(a: TimingMeasurement, b: TimingMeasurement) -> TimingMeasurement =
  timing_measurement_lens_combine(a, b, true)

fn nanoseconds_zero() -> Nanoseconds =
  { count: 0 }

fn timing_sequential_identity() -> TimingMeasurement =
  Observed { duration: nanoseconds_zero() }

// Branch composition (`Lens<TimingMeasurement>.branch`).
fn timing_branch_op(a: TimingMeasurement, b: TimingMeasurement) -> TimingMeasurement =
  timing_measurement_lens_combine(a, b, false)

// 🟡 TRANSITIONAL pre-L1.5 scaffold reconciliation for SELF_HOSTING.md
// §14.6. Gate #58 timing enforcement predates the row #106 mandatory
// correction carrier and does not yet preserve the source span needed
// to rewrite the modeled timing witness safely. This is not a waiver
// for post-L1.5 lenses: the retirement plan below is the explicit
// obligation to replace this deferral with a LiveCorrection once the
// timing enforcement diagnostic threads source-span evidence for the
// offending timing measurement/budget row.
fn timing_lens_correction_retirement_plan() -> RetirementPlan =
  {
    owner: "R3 Gap 9 row #106 timing-lens diagnostic roundtrip"
    exit_condition: "thread timing measurement/budget source spans through gate #58 enforcement and replace this scaffold diagnostic with a generated/data-backed LiveCorrection"
  }

fn timing_lens_deferred_correction() -> Correction =
  DeferredCorrection(
    "TimingLensScaffoldDiagnostic does not yet compute a source-level live correction witness",
    timing_lens_correction_retirement_plan()
  )

// Reads the reflected `span` on a `Behavior` (same partition as
// `v3.lenses.infer_helpers.behavior_span`; kept here so `v3.std.timing_lens`
// does not depend on `v3.lenses.*`).
fn timing_lens_behavior_span(b: Behavior) -> SourceSpan =
  match b {
    Value(v) => v.span
    Transform(t) => t.span
    Branch(br) => br.span
    Loop(l) => l.span
    Bind(bind) => bind.span
  }

// Placeholder `Diagnostic` for scaffold validate: non-`Observed` carriers are
// not admissible as validated evidence until runner-backed observation wiring
// lands (`ResolveError` is the closest Layer-1 kind for “evidence not resolved”).
fn timing_lens_scaffold_non_evidence_diagnostic(text: String, at: SourceSpan) -> Diagnostic =
  {
    kind: CompilerKind(ResolveError)
    span: at
    message: text
    correction: timing_lens_deferred_correction()
  }

// Degenerate DAG case: no declarations (cannot borrow a declaration `span`).
// Arrow return type directs `SourceSpan` field narrowing (DB-11), matching
// `LensRegistryEntry`-style `FilePath` witnesses plus kernel `Int` literals.
fn timing_lens_degenerate_empty_dag_span() -> SourceSpan =
  {
    file: timing_lens_module_path_witness()
    start: 0
    end: 0
  }

// Threads `d` through `behavior_spine` so `lenses.unused_parameters` stays
// clean. Non-`Observed` validation is fail-closed (P3): always `SomeDiagnostic`.
// With a non-empty spine, attach the first node's reflected `span`; when the
// spine is empty, attach the first declaration's substrate `span` (still a
// real `SourceSpan` witness). The inner `Empty` arm covers the degenerate
// no-declaration DAG case; see `timing_lens_degenerate_empty_dag_span`.
fn timing_lens_validate_non_observed(d: Dag, text: String) -> OptionalDiagnostic =
  match behavior_spine(d) {
    Empty =>
      match d.declarations {
        Cons(dd) =>
          SomeDiagnostic {
            value: timing_lens_scaffold_non_evidence_diagnostic(text, dd.head.span)
          }
        Empty =>
          SomeDiagnostic {
            value: timing_lens_scaffold_non_evidence_diagnostic(
              text,
              timing_lens_degenerate_empty_dag_span()
            )
          }
      }
    Cons(payload) =>
      SomeDiagnostic {
        value: timing_lens_scaffold_non_evidence_diagnostic(
          text,
          timing_lens_behavior_span(payload.head)
        )
      }
  }

// Bounded iteration witness hook — until `LoopBound` measure ports lower into
// compositional timing algebra, **`Observed` × any bound must not return the
// same `Observed`** (P3: that would fabricate loop-correct timing while silently
// discarding the bound). Fault arms pass through unchanged (see module banner).
fn timing_measurement_iterate(body: TimingMeasurement, bound: LoopBound) -> TimingMeasurement =
  match body {
    Observed { duration: _ } =>
      match bound {
        Cardinality(_) => timing_measurement_unobserved()
        Descent(_) => timing_measurement_unobserved()
      }
    Unobserved => Unobserved
    Ambiguous => Ambiguous
    Stale => Stale
  }

// `d` / `b` are threaded through trivial substrate queries so
// `lenses.unused_parameters` does not flag scaffold roots on `Dag::new()`
// (full bootstrap clone). Semantics stay fail-open until observation wiring lands.
//
// P3 / DB-3 (witness partition): `Inhabits(Unobserved)` is not "success" that hides
// absent evidence -- `Unobserved` is the `TimingMeasurement` report that no
// external timing row is attached yet (no fabricated `Observed` / `Nat` magnitude).
// `Violates` on `Witness<_>` is for policy/dimension faults once real `read` rules
// exist; routing "no row yet" through `Violates` would collapse the carrier's
// `Unobserved` arm into the wrong DB-3 bucket. See `docs/design-timing-lens.md` section 1.3
// and `dimensions.dag` on `Witness<Carrier>`.
fn timing_lens_read(d: Dag, b: Behavior) -> Witness<TimingMeasurement> =
  match b {
    Value(_) =>
      if is_empty(behavior_spine(d)) then Inhabits(timing_measurement_unobserved()) else Inhabits(timing_measurement_unobserved())
    Transform(_) =>
      if is_empty(behavior_spine(d)) then Inhabits(timing_measurement_unobserved()) else Inhabits(timing_measurement_unobserved())
    Branch(_) =>
      if is_empty(behavior_spine(d)) then Inhabits(timing_measurement_unobserved()) else Inhabits(timing_measurement_unobserved())
    Loop(_) =>
      if is_empty(behavior_spine(d)) then Inhabits(timing_measurement_unobserved()) else Inhabits(timing_measurement_unobserved())
    Bind(_) =>
      if is_empty(behavior_spine(d)) then Inhabits(timing_measurement_unobserved()) else Inhabits(timing_measurement_unobserved())
  }

fn timing_lens_validate(d: Dag, composed: TimingMeasurement) -> OptionalDiagnostic =
  match composed {
    Observed { duration: _ } =>
      if is_empty(behavior_spine(d)) then NoDiagnostic else NoDiagnostic
    Unobserved =>
      timing_lens_validate_non_observed(
        d,
        "timing_lens_validate: TimingMeasurement.Unobserved is not admissible evidence at this scaffold (missing external timing row)."
      )
    Ambiguous =>
      timing_lens_validate_non_observed(
        d,
        "timing_lens_validate: TimingMeasurement.Ambiguous is not admissible evidence at this scaffold (conflicting timing facts)."
      )
    Stale =>
      timing_lens_validate_non_observed(
        d,
        "timing_lens_validate: TimingMeasurement.Stale is not admissible evidence at this scaffold (digest/run mismatch vs attachment)."
      )
  }

// ── T-LAS / T-Lens-Self-Application — gate #58 `apply_lens_self_application_demonstrated` ──
//
// Canonical `EnforceableLens` for timing contracts on workflow-shaped sections. Enforcement
// fail-closes on `Unobserved` / `Ambiguous` / `Stale` (typed `NonEvidenceUsage` projection) and on
// `Observed` durations strictly above the user `TimingBudget.max` ceiling (same reflexive edge as
// gate #94 memory-peak: `>` not `>=`). Host consumer: `enforced_lens_application` (mirrors
// `complexity_enforceable` wiring for gate #92).
//
// P2: `violates` takes the full `TimingMeasurement` (see `LensEnforcement` in
// `lens_application.dag`) so non-evidence variants fail closed without comparing sentinels inside
// `TimingBudget`. `project` returns `TimingEnforcementProjected` — never overloads
// `TimingBudget.max.count` with a second meaning for faults (codex 10994 / openai-pro gate #58).
//
// `timing_enforcement_fault_sentinel_count` remains a substrate-named regression literal (unit
// tests: observed wall ns equal to this magnitude is ordinary evidence, not a fault short-circuit).

fn timing_enforcement_fault_sentinel_count() -> Nat =
  999999999999999999

fn timing_enforcement_project(m: TimingMeasurement) -> TimingEnforcementProjected =
  match m {
    Observed { duration: d } => TimedUsage { max: d }
    Unobserved => NonEvidenceUsage
    Ambiguous => NonEvidenceUsage
    Stale => NonEvidenceUsage
  }

fn timing_enforcement_violates(m: TimingMeasurement, declared: TimingBudget) -> Bool =
  match m {
    Observed { duration: d } =>
      if d.count > declared.max.count then 0 == 0 else 0 == 1
    Unobserved => 0 == 0
    Ambiguous => 0 == 0
    Stale => 0 == 0
  }

data timing_lens_monoid: Monoid<TimingMeasurement> = {
  op: timing_sequential_op
  identity: Observed { duration: { count: 0 } }
}

data timing_lens: TimingLens = {
  name: "timing"
  read: timing_lens_read
  sequential: timing_lens_monoid
  branch: timing_branch_op
  iterate: timing_measurement_iterate
  validate: timing_lens_validate
}

data timing_enforcement: LensEnforcement<TimingMeasurement, TimingBudget, TimingEnforcementProjected> = {
  project: timing_enforcement_project
  violates: timing_enforcement_violates
}

data timing_enforceable: EnforceableLens<TimingMeasurement, TimingBudget, TimingEnforcementProjected> = {
  lens: timing_lens
  enforcement: timing_enforcement
}
