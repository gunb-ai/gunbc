// std.r1_gates — structural Day-1 release gates (bootstrap-staged).
//
// Declarative `TestClaim` witnesses consumed by future runners; each entry
// compiles as data against the same bootstrap `Dag::new()` loads for user code.

module std.r1_gates

import std.list { empty }
import std.verification { Compiles, TestClaim, TestPredicate }

let user_authored_lens_compiles_predicate: TestPredicate = Compiles

let user_authored_lens_compiles_gate: TestClaim = {
  name: "user_authored_lens_compiles",
  source: "import lenses.named_function_count { named_function_count }\nimport std.substrate { Dag }\n\nfn count_fns(d: Dag) -> Int = named_function_count(d)\n",
  file_name: "user_lens_fixture.v3",
  predicate: user_authored_lens_compiles_predicate,
  requires: empty()
}
