// R1 release gate declarations.
//
// Day-1 gates live here as executable `TestClaim` values. The runner consumes
// this file directly, so lane receipts stay in `.dag` instead of only in Rust
// integration tests.

module v3.std.r1_gates

data sub_match_over_user_sum: TestClaim = {
  name: "sub_match_over_user_sum",
  source: "type Surface = Alpha | Beta\nfn classify(s: Surface) -> Int = match s { Alpha => 1, Beta => 2 }\n",
  file_name: "r1_sub_match_over_user_sum.v3",
  predicate: Compiles,
  requires: []
}

data sub_match_over_user_sum_gate: TestSuite = {
  name: "sub_match_over_user_sum_gate",
  claims: [sub_match_over_user_sum]
}
