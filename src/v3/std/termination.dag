// std.termination -- v3-staged well-founded descent and termination proofs.
//
// Bootstrap-staged mirror of `dsl/std/termination.dag` for v3. Keep these
// carrier shapes and lattice functions aligned while v2 still scans `dsl/`.

module std.termination

import v3.std.substrate { Dag, ClusterId, PortId }
import std.error_primitives { Result, Ok, Err }

// At each recursive call edge, a ranking dimension either strictly decreases,
// does not increase, or is unknown. The lattice ordering is:
// DescentUnknown < NonIncreasing < Strict.
// 🟢 TERMINAL at termination-proof scope. These are the durable evidence
// states downstream lenses consume; later work may add producers, but the
// proof lattice itself is not a bootstrap shim.
type DescentEvidence
  = Strict
  | NonIncreasing
  | DescentUnknown

fn evidence_rank(e: DescentEvidence) -> Int {
  match e {
    Strict => 2
    NonIncreasing => 1
    DescentUnknown => 0
  }
}

// Conservative meet: keep only evidence proven on every branch.
fn merge_evidence(a: DescentEvidence, b: DescentEvidence) -> DescentEvidence {
  match a {
    Strict => match b {
      Strict => Strict
      NonIncreasing => NonIncreasing
      DescentUnknown => DescentUnknown
    }
    NonIncreasing => match b {
      Strict => NonIncreasing
      NonIncreasing => NonIncreasing
      DescentUnknown => DescentUnknown
    }
    DescentUnknown => DescentUnknown
  }
}

// Optimistic join: keep the strongest evidence seen on any branch.
fn join_evidence(a: DescentEvidence, b: DescentEvidence) -> DescentEvidence {
  match a {
    DescentUnknown => b
    NonIncreasing => match b {
      Strict => Strict
      NonIncreasing => NonIncreasing
      DescentUnknown => NonIncreasing
    }
    Strict => Strict
  }
}

// Fail closed: strict descent cannot be fabricated from non-increase without
// a separate structural witness.
//
// 🟡 P5 BRIDGE. Name reads like unary promotion; body is fail-closed (see `dsl` mirror).
// `v2.compiler.complexity` routes parser progress through `strict_after_parser_witness` and
// no longer imports this symbol; dissolution: rename here when bootstrap / mirrors migrate.
fn promote_to_strict(evidence: DescentEvidence) -> DescentEvidence {
  match evidence {
    NonIncreasing => NonIncreasing
    Strict => Strict
    DescentUnknown => DescentUnknown
  }
}

// Optional meet for DescentEvidence: None is identity (top).
fn optional_evidence_meet(a: DescentEvidence?, b: DescentEvidence?) -> DescentEvidence? {
  match a {
    None => b
    Some { value: va } =>
      match b {
        None => a
        Some { value: vb } => Some { value: merge_evidence(a: va, b: vb) }
      }
  }
}

// Pointwise meet keyed by String.
fn map_evidence_merge_at(base: Map<String, DescentEvidence>, key: String, new_val: DescentEvidence) -> Map<String, DescentEvidence> {
  match map_get(base, key) {
    Some { value: existing } => map_insert(base, key, merge_evidence(a: existing, b: new_val))
    None => map_insert(base, key, new_val)
  }
}

// Bootstrap constraint: `param` is a function parameter name (String).
// When .dag supports function references, this should become structural.
// 🟡 SCAFFOLD. Ranking dimensions are durable, but the `param: String`
// bridge dissolves when function parameters can be referenced structurally.
type RankingDimension
  = TreeSize { param: String }
  | ListLength { param: String }
  | ArithmeticValue { param: String }
  | TokenPosition { param: String }
  | SetCardinality { param: String }

// 🟢 TERMINAL at descent-witness scope. Raw `Int` cannot carry shrink
// evidence because zero and negative values are not descent witnesses.
//
// Ratchet (P4 / modeling): self-recursive Peano-style sums here extend the substrate
// recursive-type set beyond `Node`; dissolution is deferred until E-P routes literal
// bridges through shared numeric refinements (see `ROADMAP.md` P4 — Peano witness ratchet).
//
// Design note (api-review / E-P): `std.types` already declares `PositiveInt`
// (`Int where range(min: 1)`) and similar refinements. A future dissolution is
// to route literal bridges through that **shared numeric refinement authority**
// (plus an explicit M9 cap) once E-P lowers refinements uniformly for all
// consumers. Today the Peano sum stays the single structural witness shared with
// `std.computation` / `std.induction` and the v2 emitter; literal materialization
// is fail-closed and capped in `positive_descent_amount_from_positive_int`.
type PositiveDescentAmount
  = OneStep
  | AdditionalStep { previous: PositiveDescentAmount }

// Peano depth as `Int` (Lane E-T / E-C). Declared in `std.termination` (not
// `std.computation`) so `v3.std.algebra` can compare polynomial degrees without
// importing `std.computation`, which would create a bootstrap SCC with `std.algebra`.
fn positive_descent_count(steps: PositiveDescentAmount) -> Int {
  match steps {
    OneStep => 1
    AdditionalStep { previous: p } => 1 + positive_descent_count(steps: p)
  }
}

// 🟢 TERMINAL at descent-witness scope. Structural divisor ≥ 2; lives here so
// `DescentSource` can reference it without `std.computation` (which imports this module).
//
// Same E-P dissolution story as `PositiveDescentAmount`: bounded `Int where
// range(min: 2, max: …)` (or a branded divisor refinement) is the target once
// refinements are first-class end-to-end; `proportional_divisor_from_int_at_least_two`
// is the capped `Int` bridge meanwhile.
type ProportionalDivisor
  = DivideByTwo
  | StrictlyLarger { inner: ProportionalDivisor }

fn proportional_divisor_to_int(d: ProportionalDivisor) -> Int {
  match d {
    DivideByTwo => 2
    StrictlyLarger { inner: p } => 1 + proportional_divisor_to_int(d: p)
  }
}

// M9 / P2 — **single numeric authority** for literal-sized Peano witness depth (mirror of `dsl/std/termination.dag`).
// Dissolution: E-P shared refinement caps (see ROADMAP P4).
fn peano_literal_materialization_cap() -> Int { 256 }

// M9 / P4: refuse witness depths above `peano_literal_materialization_cap()` so literal-sized `Int` inputs cannot
// force deep recursive materialization (infer + std share this cap; fail closed).
// The .dag definition is stack-recursive O(k) in witness depth; the Rust mirror is
// iterative with the same cap — future unbounded-Int producers should cap or bound k upstream.
fn positive_descent_amount_from_positive_int(k: Int) -> PositiveDescentAmount? {
  if k <= 0 { none }
  else {
    if k > peano_literal_materialization_cap() { none }
    else {
      if k == 1 { Some { value: OneStep } }
      else {
        match positive_descent_amount_from_positive_int(k: k - 1) {
          Some { value: prev } => Some { value: AdditionalStep { previous: prev } }
          None => none
        }
      }
    }
  }
}

fn proportional_divisor_from_int_at_least_two(k: Int) -> ProportionalDivisor? {
  if k < 2 { none }
  else {
    if k > peano_literal_materialization_cap() { none }
    else {
      if k == 2 { Some { value: DivideByTwo } }
      else {
        match proportional_divisor_from_int_at_least_two(k: k - 1) {
          Some { value: prev } => Some { value: StrictlyLarger { inner: prev } }
          None => none
        }
      }
    }
  }
}

// Concrete code pattern that witnesses descent for a ranking dimension.
// Bootstrap constraint: name-like payloads are Strings until function and
// field references are first-class in .dag.
// 🟡 SCAFFOLD. The witness taxonomy is durable for E-T; the String payload
// bridge dissolves once accessor, operation, witness, and element references
// are first-class substrate values instead of names.
type DescentSource
  = ChildAccessor { accessor: String }
  | ListShrink { amount: PositiveDescentAmount }
  | ArithmeticSubtractDescent { steps: PositiveDescentAmount }
  | ArithmeticDivideDescent { divisor: ProportionalDivisor }
  | ParserAdvance { witness: String }
  | SetRemoval { element: String }
  | FoldIteration

type TerminationProof {
  dimensions: List<RankingDimension>
}

// Bootstrap constraint: caller/callee are function names (String).
// When .dag supports function references, these should become structural.
type ProofEdge {
  caller: String
  callee: String
  evidence: List<DescentEvidence>
}

// 🟢 TERMINAL at descent-residual scope.
//
// Strict-only 1-variant subset of `DescentEvidence` — the `Ok` channel of
// `descent_execution_proof` carries exclusively `Strict` per-path entries; P2
// API-level enforcement makes `Ok(... NonIncreasing ...)` and `Ok(...
// DescentUnknown ...)` unrepresentable by construction. Pairs with
// `NonStrictEvidence` to partition `DescentEvidence` across the Result split:
// Strict ⊕ NonStrictEvidence = DescentEvidence.
type StrictEvidence
  = Strict

// 🟢 TERMINAL at descent-residual scope.
//
// `NonStrictEvidence` is the 2-variant typed subset of `DescentEvidence` that
// carries actual residual signal. `Strict` is **not** a residual (Strict means
// termination IS provable), so it is not a member of this subset. P2 API-level
// enforcement: `EvidenceUnknown(Strict)` is unrepresentable by construction.
type NonStrictEvidence
  = NonIncreasing
  | DescentUnknown

// 🟢 TERMINAL at descent-residual scope.
//
// Result residual returned by `descent_execution_proof` when proof construction
// cannot certify strict descent for every path. Director-ratified γ shape
// (gunbc#828 #issuecomment-4395060514, 2026-05-07): 2-variant residual replacing
// the prose 4-variant `Missing | Unknown | Incomplete | NonStrict` decomposition.
//
// - `EvidenceUnknown(NonStrictEvidence)` collapses absent-evidence and
//   not-strict into a single typed channel; the `NonStrictEvidence` payload
//   witnesses *which* sub-Strict evidence the executor saw (per join semantics:
//   any non-Strict per-path entry surfaces here).
// - `EvidenceIncomplete` is the proof-construction state for per-path coverage
//   that did not complete. Currently unit-variant per Director γ; STOP-and-PING
//   the Substrate Mgr if substrate evidence forces a payload-variant
//   decomposition (e.g. `TimeoutReason | DepthBoundExceeded |
//   EvaluatorErrorDuringProofConstruction`) — canvas-shape verification, not
//   re-ratification (per Director).
type DescentResidual
  = EvidenceUnknown(NonStrictEvidence)
  | EvidenceIncomplete

// 🟡 SCAFFOLD at proof-witness scope.
//
// Termination-contract proof token consumed by Evaluator E2 (#1971) for
// `LoopBound::Descent` execution. Per-path evidence map keyed by branch
// identifier; each entry is typed as `StrictEvidence` (1-variant subset) so
// non-Strict per-path entries are unrepresentable in the Ok channel by
// construction (P2 API-level enforcement, not runtime check). Non-Strict
// per-path evidence surfaces as `EvidenceUnknown(NonIncreasing)` /
// `EvidenceUnknown(DescentUnknown)` residual via the executor's join semantics.
//
// `cluster` and `port` are echoed to keep the token self-describing for
// downstream lens consumers; `String` keys are the bootstrap bridge until
// branch identifiers gain a structural carrier (mirrors the `param: String`
// scaffold pattern elsewhere in this file).
type DescentExecutionProof {
  cluster: ClusterId
  port: PortId
  per_path: Map<String, StrictEvidence>
}

// 🟡 SCAFFOLD at substrate-fact scope.
//
// Substrate-side typed termination-contract carrier (Q-EVAL-Descent-Termination-
// Contract; γ-ratified at gunbc#828 #issuecomment-4395060514 2026-05-07).
// Evaluator E2 (#1971) consumes proof token only — multi-consumer composability
// is intentionally out of scope (carrier IS the consumer-cementing executor
// termination contract).
//
// Body is fail-closed: returns `Err { value: EvidenceIncomplete }` until a
// downstream producer wires per-path Strict-evidence aggregation. The fail-
// closed default matches the §10.3 row's "fail-closed residuals" disposition;
// concrete per-path evidence wiring is the Evaluator-side same-slice consumer's
// concern.
//
// Bootstrap signature drift: brief signature uses `&Dag` (Rust-style reference);
// v3 std .dag carrier uses bare `Dag` per local convention (see `port` /
// `resolve_producer` in `v3.std.substrate`). Surface as STOP-and-PING if a
// module witness becomes necessary at consumer-wiring time.
fn descent_execution_proof(dag: Dag, cluster: ClusterId, port: PortId) -> Result<DescentExecutionProof, DescentResidual> {
  Err { value: EvidenceIncomplete }
}
