// v3.std.integer_diagnostic_order — substrate-declared diagnostic enumeration order
// for fixed-width integers (T-Ground-Diagnostic slice 2; Modeling problem 4 corrected).
//
// **Why this file (not `dsl/std/integer.dag`):** list elements are typed
// `DeclarationRef` values (`Int8`, …) resolved against `std.integer`. The
// `DeclarationRef` sentinel meta-type lives in `v3.spec.v3_l1`, which is not
// part of the dsl-only std bootstrap seed — authoring `List<DeclarationRef>`
// here keeps ordering facts in substrate adjacent to the integer type family
// imported from `dsl/std/integer.dag`.
//
// **Dissolution trigger:** typed width metadata on word carriers (Substrate Mgr);
// then derive order from carriers and delete these lists.

module v3.std.integer_diagnostic_order

import std.list { List }
import v3.spec.v3_l1 { DeclarationRef }
import std.integer {
  Int8,
  Int16,
  Int32,
  Int64,
  Int128,
  UInt8,
  UInt16,
  UInt32,
  UInt64,
  UInt128
}

// Diagnostic-only enumeration order for fixed-width signed integers.
// Used when constructing fail-closed diagnostics (e.g. candidate text under
// `EmissionDiagnostic::UnderRefined`); NOT consulted for emission selection.
data signed_int_diagnostic_order: List<DeclarationRef> = [
  Int8,
  Int16,
  Int32,
  Int64,
  Int128
]

// Diagnostic-only enumeration order for fixed-width unsigned integers.
data unsigned_int_diagnostic_order: List<DeclarationRef> = [
  UInt8,
  UInt16,
  UInt32,
  UInt64,
  UInt128
]
