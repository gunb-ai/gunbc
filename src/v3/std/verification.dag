// std.verification — structural authority for generated tests.
//
// L1.5's contract is to declare what a test IS, not how a target
// framework renders it. The compiler can then synthesize `TestClaim`
// values structurally from std/ declarations and defer per-language
// rendering to the target spec layer.
//
// **Bootstrap staging.** This file lives in `src/v3/std/` because
// v2's recursive `dsl/` CI pipeline still cannot ingest the current
// v3 grammar. It is the bootstrap-local authority for v3's testgen
// surface today. `dsl/std/verification.dag` remains the older v2-era
// behavioral-assertion model; it is not silently superseded here.
// Convergence trigger: once v2 retires and the shared std tree can
// host the v3 verification surface directly, dissolve the duplicate
// definitions back to one `std.verification`.

module std.verification

import std.list { List, map }
import std.types { FilePath, NonEmptyStr }
import v3.std.substrate { ComparisonOp }
import v3.std.timing_lens { TimingBudget, TimingMeasurement }
import v3.spec.v3_l1 { DeclarationRef }
import v3.std.resources { ResourceReference }
import v3.std.bridge_ledger { BridgeLedgerRef }

// R1C-A / T-TestGen PB-census predicate shape vocabulary. These are narrow
// bootstrap-local carriers for R1C-D's census-as-TestClaim fixtures; the Rust
// runner still owns evaluation against the live census authorities.
type Path = FilePath
type SnapshotRef = NonEmptyStr

// R3 Cluster M generator-manifest substrate (Director ratifications
// msg_05837745 + msg_606e0e50 + msg_8423d468 + msg_3b99a90f). One manifest
// entry binds a generated output path to either a typed PENDING state (no
// resolution data yet) or a fully RESOLVED state carrying its `DeclarationRef`
// source authority + opaque `source_hash` reference (bare `NonEmptyStr` per
// Q3-amend β; the follow-up runtime PR may re-introduce branded `ContentHash`
// at its hash-derivation construction boundary).
//
// The sum-variant shape (Q-StubValuePosture (b), msg_3b99a90f) replaces the
// prior struct-with-stubs framing that violated INVARIANTS P3 / C-9 ("missing
// fields / values may not fabricate empty nodes or strings"). `PendingFact`
// IS the typed "unknown" carrier — fixtures populate it without fabricating
// `dag_source` / `source_hash` values; `ResolvedFact` materialization happens
// in the follow-up Evaluator-Mgr-owned runtime PR as hash-derivation produces
// real values. Gate #86 satisfies on shape (output_path is always present);
// the 3-way byte-equality assertion only fires on `ResolvedFact` arms.
type GeneratedManifestEntry
  = PendingFact { output_path: Path }
  | ResolvedFact {
      output_path: Path
      dag_source: DeclarationRef
      source_hash: NonEmptyStr
    }

// R3 T-Workflow-As-Data gate #101 (`test_cost_dimension_landed`).
//
// Closed PB census-list constants are declared vocabulary, not string labels,
// so fixtures can only point at typed list identities.
type CensusListConstant {}

data expected_hand_authored_non_test: CensusListConstant = {}
data expected_hand_authored_test: CensusListConstant = {}
data expected_hand_authored_fragments: CensusListConstant = {}

// Closed PB subset predicates are declared values, not string labels, so
// fixtures can only point at typed vocabulary entries.
type LensProducerFilesSubsetPredicate {}

data lens_producer_files_subset_predicate: LensProducerFilesSubsetPredicate = {}

// Closed PB bin-shim predicate follows the same declaration-ref pattern
// as the lens-producer subset.
type BinShimFilesSubsetPredicate {}

data bin_shim_files_subset_predicate: BinShimFilesSubsetPredicate = {}

// Closed PB consolidation ratchets follow the same declaration-ref pattern.
type CompilerStdPositiveSetRatchet {}

data compiler_std_positive_set_ratchet: CompilerStdPositiveSetRatchet = {}

// **🟡 Scaffold — DiagnosticKind.** This mirrors the compiler's native
// diagnostic taxonomy until reflected substrate diagnostic facts can be
// consumed directly from `std.verification`.
// Dissolution trigger: replace this mirror with typed references once
// substrate diagnostics are surfaced as declaration-shaped facts.
type DiagnosticKind
  = TokenizerError
  | ParseError
  | TypeMismatch
  | ArityMismatch
  | ResolveError
  | UnitMismatch
  | BranchConditionNotBool
  | MagnitudeOutOfRange
  | MalformedIntegerRangeFact
  | NominalOpacityViolation

// **🟡 Scaffold — DiagnosticDetailExpectation.** Bootstrap-local bridge
// for kind-only vs detail-narrowed diagnostic matching while
// `std.verification` still lacks direct access to reflected substrate
// diagnostics.
// Dissolution trigger: replace this filter surface with typed edges into
// the reflected diagnostic fact once that authority is available.
type DiagnosticDetailExpectation
  = AnyDetail
  | Contains(String)

// Diagnostic reference used by generated negative claims. `kind` is
// structural and `detail_contains` narrows the match only when present.
type DiagnosticReference {
  kind: DiagnosticKind
  detail_contains: DiagnosticDetailExpectation
}

// **🟡 Scaffold — PortStateExpectation.** This is the coarse projection
// testgen currently needs from substrate `PortState` while verification
// predicates remain bootstrap-local.
// Dissolution trigger: point at substrate `PortState` directly once
// `std.verification` can consume the reflected port-state fact without
// treating `Uninferred` as an accidental test surface.
type PortStateExpectation
  = Resolved
  | Unresolved

// Closed comparator for measured Tier-3 perf-budget checks. Do not reuse
// general `ComparisonOp`: `Gt` / `Ge` would invert the budget and let a
// regression satisfy `PerfWithinBaseline`.
type PerfBudgetComparisonOp
  = AtMostBudget

// **🟡 Scaffold — TestPredicate.** The remaining bootstrap carrier is
// the outer "what property are we asserting?" coproduct. The
// diagnostic, port-state, and cost-ordering sub-axes now flow through
// structural carriers instead of parallel flat variants.
// Dissolution trigger: dissolve this outer sum once verification
// predicates are modeled as ordinary surfaced substrate facts instead
// of a bootstrap-local predicate envelope.

// **🟡 Scaffold — AlgebraicLawKind.** Enumeration of algebraic-law tags for
// T-LensAPI composition gates (`AlgebraicLaw`); not yet backed by a dedicated
// substrate law algebra.
// Dissolution trigger: replace with reflected law witnesses once lens-algebra
// facts are first-class declarations consumable from `std.verification`.
type AlgebraicLawKind
  = Associativity
  | Commutativity
  | Identity

// Structural reference to a declaration whose body produces generated
// `ProgramShape` values. The referenced declaration is the family authority;
// new program families are new declarations, not new variants in a closed
// roster.
type ProgramGenerator {
  generator: DeclarationRef
}

// A generated program's shape. Bootstrap starts with the literal source form
// that matches `TestClaim.source` / `TestClaim.file_name`; richer shape
// variants attach here only when a new primitive generated-program form lands.
type ProgramShape
  = LiteralProgram {
      source: String
      file_name: String
    }

type SymbolicCostBindParamExpected
  = LinearCostForBindParam { var: BindParamSizeVariable }

type BindParamSizeVariable
  = SelectedBindParamSizeVariable

type BindParamRef {
  index: Int
}

// R3 T-Tests-As-Data-Completeness / gate #87 — canonical v3 lens capability register
// (`docs/design-tests-as-data-completeness.md` §8.3). Status axes are closed coproducts
// (not strings): misspellings are type errors at fixture load, and the runner rejects any
// unexpected constructor id. `src/v3/compiler/tests/dag/cementing_dispatch.dag` imports
// `lens_capability_register_rows` as the sole structural register body; prose in
// `docs/v3-lens-capability-register.md` is a human mirror, not a second authority.
type LensCapabilityStructuralStatus
  = LensCapabilityStructuralTerminal
  | LensCapabilityStructuralPartial

type LensCapabilityBehavioralStatus
  = LensCapabilityBehavioralComplete
  | LensCapabilityBehavioralPartial
  | LensCapabilityBehavioralStub
  | LensCapabilityBehavioralNA

type LensCapabilityV2Counterpart
  = LensCapabilityV2RealV2
  | LensCapabilityV2NoneV3Native
  | LensCapabilityV2NotApplicable

type LensCapabilityRegisterRow {
  lens_basename: String
  structural: LensCapabilityStructuralStatus
  behavioral: LensCapabilityBehavioralStatus
  v2_counterpart: LensCapabilityV2Counterpart
}

data lens_capability_register_rows: List<LensCapabilityRegisterRow> = [
  {
    lens_basename: "complexity.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralComplete
    v2_counterpart: LensCapabilityV2RealV2
  },
