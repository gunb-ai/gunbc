    lens_basename: "cost_target_realization.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralNA
    v2_counterpart: LensCapabilityV2NoneV3Native
  },
  {
    lens_basename: "effect_enumeration.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralComplete
    v2_counterpart: LensCapabilityV2NoneV3Native
  },
  {
    lens_basename: "idempotency.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralComplete
    v2_counterpart: LensCapabilityV2NoneV3Native
  },
  {
    lens_basename: "parallelism.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralComplete
    v2_counterpart: LensCapabilityV2NoneV3Native
  },
  {
    lens_basename: "provenance.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralComplete
    v2_counterpart: LensCapabilityV2NoneV3Native
  },
  {
    lens_basename: "unused_parameters.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralComplete
    v2_counterpart: LensCapabilityV2NoneV3Native
  },
  {
    lens_basename: "variant_payload.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralComplete
    v2_counterpart: LensCapabilityV2NoneV3Native
  },
  {
    lens_basename: "structural_resolution.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralComplete
    v2_counterpart: LensCapabilityV2NoneV3Native
  },
  {
    lens_basename: "infer_helpers.dag"
    structural: LensCapabilityStructuralPartial
    behavioral: LensCapabilityBehavioralNA
    v2_counterpart: LensCapabilityV2NotApplicable
  },
  {
    lens_basename: "lower_helpers.dag"
    structural: LensCapabilityStructuralPartial
    behavioral: LensCapabilityBehavioralNA
    v2_counterpart: LensCapabilityV2NotApplicable
