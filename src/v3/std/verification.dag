  {
    lens_basename: "named_function_count.dag"
    structural: LensCapabilityStructuralTerminal
    behavioral: LensCapabilityBehavioralNA
    v2_counterpart: LensCapabilityV2NotApplicable
  }
]

type TestPredicate
  = Compiles
  | FailsWithDiagnostic(DiagnosticReference)
  | OutputEquals { expected: String }
  | PortHasState {
      bind_name: String
      state: PortStateExpectation
    }
  // Structural lowering receipt: named declaration must carry `refinement` after
  // `compile_to_dag` on the claim program (DB-11 alias-RHS `where` survival).
  | DeclarationHasRefinement {
      declaration_name: String
    }
  | CostBounded {
      bind_name: String
      comparator: ComparisonOp
      bound: Int
    }
  | BehavioralObservation {
      subject: DeclarationRef
      input_sample: DeclarationRef
      expected_output: DeclarationRef
    }
  // Mock transport is **not** duplicated here: declare it only on
  // `TestClaim.requires` (obligation-walk authority). This variant only pairs
  // subject + invariant declarations for the behavioral check.
  | MockBackedInvariant {
      subject: DeclarationRef
      invariant: DeclarationRef
    }
  // **🟡 Scaffold — ExecuteCommand.** Target-shaped bootstrap hook: names a host
  // process + argv + expected exit code. This encodes *how* evidence is observed
  // (process exit), not a pure declarative property — tolerated until the runner
  // binds audited tools/capabilities from the target spec layer instead of raw
  // `String` (illegal states / injection are unconstrained here by design).
  // Dissolution trigger: lift to typed tool/capability references outside this sum
  // once the substrate can express sandboxed execution without opaque command lines.
  // Collapse with ForAllTargets: one capability-typed execution fact plus scope
  // (once vs per emission target), not two parallel String/List/Int record shapes.
  | ExecuteCommand {
      command: String
      args: List<String>
      expect_exit_code: Int
    }
  // **🟡 Scaffold — ForAllTargets.** Per-emission-target gate: compile the claim's
  // program (`TestClaim.source` / `TestClaim.file_name` — single authority; not
  // duplicated here) for each known target, then observe the declared
  // `ProgramOutputBind` on each target's emitted output (T-Emit omni-demo gate).
  // Dissolution trigger: target-specific emission + verification facts live in the
  // target spec / runner tables; this sum variant narrows to declarative edges only.
  // Collapse with ExecuteCommand: same runner capability as singleton execution,
  // scoped per target — do not preserve a second copy of the raw command triple.
  | ForAllTargets {
      command: String
      args: List<String>
      expect_exit_code: Int
      input_ref: DeclarationRef
    }
  // **🟡 Scaffold — LensOutputEquals.** Apply named lens to named input declaration;
  // compare output structurally to named expected declaration (T-LaneE).
  // Dissolution trigger: lens application + equality are ordinary reflected facts
  // instead of a bespoke predicate envelope.
  | LensOutputEquals {
      lens_ref: DeclarationRef
      input_ref: DeclarationRef
      expected_ref: DeclarationRef
    }
  // **🟡 Scaffold — DifferentialEquals.** Evaluate subject and oracle on the same
  // input declaration; assert structural equality of outputs (T-LaneE oracle diff).
  // Dissolution trigger: differential checks become surfaced substrate comparisons.
  | DifferentialEquals {
      subject_ref: DeclarationRef
      oracle_ref: DeclarationRef
      input_ref: DeclarationRef
    }
  // **🟡 Scaffold — SymbolicCostExprEquals.** Apply the symbolic-cost lens
  // to the claim's program-under-test (`TestClaim.source` for enumerated
  // claims; `ProgramShape.source` for quantified claims once Slice 1
  // lands), then compare the resulting `SymbolicCost` value structurally
  // to a declared expected `data X: SymbolicCost = …`. One `DeclarationRef`
  // payload because `actual` is implicit (program-under-test convention,
  // mirroring `Compiles` / `OutputEquals` / `CostBounded` — every other
  // predicate that reads from the program also relies on this convention
  // rather than carrying a redundant `input_ref`).
  //
  // Why a dedicated predicate, not `LensOutputEquals(symbolic_cost_lens, …)`
  // or `BinaryDimensionReportEquals(left, right)`:
  //   - `LensOutputEquals` carries an explicit `input_ref: DeclarationRef`,
  //     so it cannot project against a generated `ProgramShape` from a
  //     `QuantifiedTestClaim`. Heuristic-cost-function-5th-gate testgen
  //     specifically needs the per-generated-program shape.
  //   - `BinaryDimensionReportEquals` wraps `SymbolicCost` in
  //     `DimensionReport<SymbolicCost>`'s `Ok | Fail` partition + witnesses;
  //     law-shape equality (the heuristic-cost-function use case) does not
  //     need the report partition, and the existing variant is shape-only
  //     until the generic DimensionReport producer/evaluator path lands.
  //
  // Runner status: shape-only until the heuristic-cost-function-5th-gate
  // testgen dispatch authors the eval (Verification follow-up). The runner
  // stub returns `ClaimResult::NotYetImplemented` naming the missing eval,
  // the same pattern other shape-only scaffolds (`BinaryDimensionReportEquals`,
  // `CensusBoundCheck`, `FixedPointConverges`, etc.) already use.
  // Dissolution trigger: when `SymbolicCost` is reflected as a
  // first-class substrate fact and direct expression equality can be
  // expressed as an ordinary surfaced comparison rather than a bespoke
  // predicate envelope.
  | SymbolicCostExprEquals {
      expected: DeclarationRef
    }
  | SymbolicCostExprEqualsForBindParam {
      expected: DeclarationRef
      param: BindParamRef
    }
  // **🟢 TERMINAL at T-Tier3 P1 substrate scope.** Compare a measured
  // `PerfBaselineMeasurement` declaration against a declared baseline
  // measurement. The runner applies the ratified Tier-3 ratio budget:
  // median uses baseline * 2 and p99 uses baseline * 5. `comparator`
  // is a closed budget comparator, not general `ComparisonOp`.
  | PerfWithinBaseline {
      subject: DeclarationRef
      comparator: PerfBudgetComparisonOp
      baseline_ref: DeclarationRef
    }
  // **🟡 Scaffold — BinaryDimensionReportEquals.** Compare two declarations
  // that produce `DimensionReport<C>` values by structural equality. This is
  // intentionally one binary predicate for TC1 eta-equivalence, TC2 strategy
  // order independence, and TC3 evaluation-step witness parity; per-TC
  // interpretation belongs in the referenced report producers, not in parallel
  // predicate variants.
  // Runner status: shape-only until the generic DimensionReport producer/evaluator
  // path lands. Consumers must not compare serialized reports.
  | BinaryDimensionReportEquals {
      left_report_ref: DeclarationRef
      right_report_ref: DeclarationRef
    }
  // **🟡 Scaffold — AlgebraicLaw.** Check a named algebraic law (see `AlgebraicLawKind`)
  // against a named lens (T-LensAPI composition). `Associativity`, `Commutativity`, and `Identity`
  // today: runner applies the compiled lens on bounded Int witness tables in `lens_apply`
  // (`ASSOCIATIVITY_WITNESS_TRIPLES`, `COMMUTATIVITY_WITNESS_PAIRS`, identity candidate search),
  // not declared law
  // facts from `std.algebra` — see `eval_algebraic_law_for_claim_program` in `test_runner.rs`.
  // Dissolution trigger: consume substrate law / witness metadata on the carrier; then either
  // drop sample-only checks from this predicate or gate them behind explicit testgen claims.
  | AlgebraicLaw {
      law: AlgebraicLawKind
      lens_ref: DeclarationRef
    }
  // R1C-A / T-TestGen schema extensions for the five PB census gates.
  // These variants scope the structural shape R1C-D fixtures consume; they
  // intentionally do not duplicate census lists into fixture text.
  | CensusBoundCheck {
      authority: DeclarationRef
      list_constant: CensusListConstant
      bound: Int
    }
  | CensusSubsetCount {
      authority: DeclarationRef
      list_constant: CensusListConstant
      subset_predicate: DeclarationRef
    }
  // R3 §1.8 gate #16 / T-FixedPoint — **not dispatch-eligible for strong suite here.**
  // R1 `pb_self_compile_fixed_point` composes this variant today; the R3 thesis
  // horizon adds distinct `pb_self_compile_fixed_point_strong` claims only after
  // joint preconditions in `docs/briefs/r3-pb-t-fixedpoint-worker.md` §"Dispatch
  // preconditions". Do not rename or shadow the R1 claim; do not extend this
  // enum from PB without Substrate ack (see `INVARIANTS.md` P1).
  // 2026-05-13 joint-precondition coordination audit:
  // `docs/audit/r3-gap3-fixed-point-precondition-coordination-2026-05-13.md` —
  // all four joint preconditions non-green at HEAD; strong suite stays unauthored.
  | FixedPointConverges {
      compile_target: Path
      expected: SnapshotRef
    }
  | RatchetZero {
      authority: DeclarationRef
      ratchet_kind: DeclarationRef
    }
  // R3 Cluster M substrate-shape refinement (Director ratification msg_05837745
  // + amendment msg_606e0e50). `manifest_entries` replaces `generated_paths`
  // ahead of the follow-up Evaluator-Mgr-owned runtime PR that introduces the
  // 3-way byte-equality assertion + directory-walk orphan-output detection at
  // the well-known `src/v3/compiler/tests/` scan-root. At the runner boundary
  // today: each `output_path` must be in `GENERATED_FILES` (from
  // `build.rs::REGEN_OUTPUTS`), the manifest must enumerate that authority
  // **exactly once each** (no duplicates / omissions), and the SG-0
  // `expected_hand_authored_test` census must be empty (Gate #84 negative
  // authority). A future `scan_root: Path` (or `TestRootRef`) field is a
  // Q4-amendment trigger flagged for the follow-up runtime PR.
  | GeneratedFromDag {
      authority: DeclarationRef
      manifest_entries: List<GeneratedManifestEntry>
    }
  // **🟢 TERMINAL — Band-C cementing dispatch.** The runner fail-closes unless the
  // `TestClaim` is declared in `src/v3/compiler/tests/dag/cementing_dispatch.dag`.
  // Payload names two `DeclarationRef` edges: `capability_register` (a `List` of
  // `LensCapabilityRegisterRow` values — canonical `data lens_capability_register_rows`
  // in this module) and `cementing_receipts` (the Band-C receipt list in the suite
  // fixture). Evaluation projects bootstrap `LensRegistryEntry` (`regen.dag`) rows
  // whose `lens_file` basename appears in the register slice with behavioral axis
  // `LensCapabilityBehavioralComplete` plus v2 axis `LensCapabilityV2RealV2` **or**
  // `LensCapabilityV2NoneV3Native` (v3-native behavioral-complete gate-#87 harnesses),
  // expands each matched pair to the closed roster of `(registry_name, module_stem, kind)`
  // receipts, then asserts the `cementing_receipts` list matches that expansion
  // **exactly** (set equality on receipt triples, not merely registry-name keys), that
  // receipt triples are unique, and each receipt's on-disk harness exists (`tests/dag/<stem>.dag` vs
  // `integration/cementing/<stem>.rs` + `tests/integration.rs` wiring for temporary Rust
  // receipts). See `cementing_dispatch::evaluate_cementing_dispatch_projection`.
  | CementingDispatchMatchesProjection {
      capability_register: DeclarationRef
      cementing_receipts: DeclarationRef
    }
  // **🟡 Scaffold — ReleaseDeferredClaim.** R1 release-acceptance concession
  // marker. Use only in release-acceptance fixtures with explicit Director
  // sign-off; this is not a generic escape hatch for arbitrary `TestSuite`s.
  // The runner validates the three `DeclarationRef` edges resolve to
  // fixture-local role markers named `R1GateMarker`, `TargetLaneMarker`, and
  // `ReleaseAuthorityDoc`; only then does it treat the well-formed deferral as
  // a structural acceptance fact. Release-cycle deferral; target lanes may
  // point at R2, R3, or later release-cycle authorities with explicit Director
  // sign-off.
  // Dissolution trigger: when the deferred release target lane's own `.dag`
  // acceptance claim lands and evaluates green, replace the corresponding
  // `ReleaseDeferredClaim` fixture row with that strict claim (or delete this
  // variant entirely once the R1 release-acceptance wrapper retires).
  | ReleaseDeferredClaim {
      deferred_gate: DeclarationRef
      target_lane: DeclarationRef
      authority_doc: DeclarationRef
    }
  // **🟡 Scaffold — SubstrateResearchDeferredClaim.** R2 substrate / TC1 research
  // deferral marker — distinct from R1 `ReleaseDeferredClaim` release authority.
  // The runner accepts this predicate only for claims declared in
  // `src/v3/compiler/tests/fixtures/tc1_substrate_lens_eta_equivalence_deferred.dag`
  // and requires `DeclarationRef` edges to fixture-local role types
  // `Tc1ResearchGateMarker`, `SubstrateLensPrimitiveTargetLaneMarker`, and
  // `LambdaCalculusGroundingAuthorityDoc`.
  // Dissolution trigger: replace with a strict lens/substrate theorem claim when
  // T-Substrate-Lens-Primitive lands.
  | SubstrateResearchDeferredClaim {
      deferred_gate: DeclarationRef
      target_lane: DeclarationRef
      authority_doc: DeclarationRef
    }
  // 🟢 TERMINAL at PR-α scope. Bridge-retirement ledger zero-residual
  // gate. `ledger: BridgeLedgerRef` points at the canonical
  // `bridge_ledger` declaration of type `List<BridgeLedgerRow>`
  // (`v3.std.bridge_ledger`); the runner reads every row's `status`
  // field and `Pass`es iff every row's status resolves to the
  // `Retired` constructor of `BridgeStatus`. Open rows produce `Fail`
  // with the offending names so the diagnostic surfaces the residual
  // debt directly. The wrapped `BridgeLedgerRef` makes the ledger-
  // target intent structural at the field-type level (mirror of
  // `MethodRef` / `CallableRef`); the canonical-identity check
  // (decl == `bridge_ledger`) lands at the runner boundary in
  // `eval_bridge_ledger_zero` until refinement-typing on
  // `DeclarationRef` retires the wrapper class.
  | BridgeLedgerZero {
      ledger: BridgeLedgerRef
    }

// Structural runner input role for predicates whose input is the compiled
// `TestClaim.source` program.
type ProgramInput {}

// Structural output-bind selector for predicates that compare a lens result
// against one bind in the compiled `TestClaim.source` program.
type ProgramOutputBind {
  output_ref: DeclarationRef
}

// `requires` is the **only** place `ResourceReference` edges attach for a claim
// (including mock backends when `predicate` is `MockBackedInvariant`). No parallel
// resource slots on predicate variants — `obligation_for_claim` / materialization
// read this list alone, so facts cannot diverge.
//
// **Program under test (single authority).** `source` / `file_name` name the
// compilation unit the runner loads for this claim — including when the predicate
// is `ForAllTargets` (that variant does not repeat them; consumers must not fork
// a second copy of the same text in the predicate record).
type TestClaim {
  name: String
  source: String
  file_name: String
  predicate: TestPredicate
  requires: List<ResourceReference>
}

// Closed quantifier over a generated program family. This lives at the
// claim layer, not inside `TestPredicate`, so predicates keep their
// "property of one program" meaning.
type Quantifier
  = ForAll
  | Exists

type QuantifiedTestClaim {
  name: String
  generator: ProgramGenerator
  quantifier: Quantifier
  predicate: TestPredicate
  requires: List<ResourceReference>
}

// T-Workflow-As-Data interim transport.
//
// Committed `.github/workflows/ci.yml` remains the hand-edited source of truth until the T-24 CI
// model emits it. `CIWorkflowDag` carries gate topology only; Actions transport projection is
// deferred to T-24 `src/v4/workflow/ci.dag`.
//
// R3 T-Workflow-As-Data gate #101 (`test_cost_dimension_landed`).
//
// Test execution cost is the timing substrate projected onto a test node in
// the modeled graph (`TestNodeCostDimension` on `TestNodeRef`) — not a
// verification-local scalar dimension. CI projects warn-only libtest tokens from
// `dsl/gunbc/test_node_wall_clock_ratchet.dag` via the `wall_clock_ratchet_manifest`
// projection into the JSONL shape `scripts/check-test-timeout.sh` consumes (**interim bridge** —
// not #102 closure; no checked-in JSONL manifest).
// `TestNodeRef` is a closed test-typed edge: only modeled `TestClaim` /
// `QuantifiedTestClaim` nodes can inhabit it, so arbitrary declarations cannot
// masquerade as test nodes. The budget/report fields reuse T-WAD's existing
// `TimingBudget` / `TimingMeasurement` authority over `Nanoseconds`, so #102
// can derive slow-test **policy** from those facts once the runner consumes
// them instead of the side manifest (no parallel duration algebra here).
//
// PRACTICE 4 CHECKPOINT: 🟡 SCAFFOLD — this coproduct intentionally mirrors
// `SuiteClaim`'s enumerated/quantified axis at the cost-attachment boundary so
// #102 can derive slow-test status for both concrete and generated test nodes
// without reopening `TestNodeCostDimension`. It is not a second suite-entry
// roster: `SuiteClaim` remains the ordered suite membership authority, while
// `TestNodeRef` is only the typed subject edge for cost facts. Dissolution
// trigger: when #102 wires the slow-test ratchet to the v3 timing authority,
// collapse any unconsumed arm or reuse `SuiteClaim` directly if the ratchet only
// needs suite-entry identity rather than a cost-fact subject role.
type TestNodeRef
  = EnumeratedTestNode(TestClaim)
  | QuantifiedTestNode(QuantifiedTestClaim)

type TestNodeCostDimension {
  node: TestNodeRef
  budget: TimingBudget
  measured: TimingMeasurement
}

// **🟢 TERMINAL — SuiteClaim.** Closed two-variant coproduct exhausting the
// structurally meaningful suite-entry shapes: an existing single-source
// `TestClaim` (`Enumerated`) and a generator-driven property-based family
// (`Quantified(QuantifiedTestClaim)`). One ordered carrier preserves reporting
// and dependency order without parallel enumerated/quantified lists (gate #85
// CONSUMER_LANDED wrapper migration; per design `docs/design-tests-as-data-completeness.md`
// §2.2). New suite-entry shapes are new variants on this sum, not new carriers
// or parallel fields; richer quantifier vocabularies attach by extending
// `Quantifier` or by adding fields on `QuantifiedTestClaim`, not by widening
// `SuiteClaim`.
type SuiteClaim
  = Enumerated(TestClaim)
  | Quantified(QuantifiedTestClaim)

type TestSuite {
  name: String
  claims: List<SuiteClaim>
}

// DB-15 — dependency-walk projection: each claim's `requires` list is the
// obligation surface the compiler's declaration DAG consumes (no workflow
// structure — that is a separate layer).
type TestObligation {
  claim_name: String
  resources: List<ResourceReference>
}

// **Single authority for resource edges (including mock backends).** Every
// `ResourceReference` for obligation materialization lives on `TestClaim.requires`
// only. `TestPredicate` variants (including `MockBackedInvariant`) never carry
// parallel resource facts — downstream walks call this projection instead of
// inspecting the predicate for mock transports.
fn claim_obligation_resources(c: TestClaim) -> List<ResourceReference> {
  c.requires
}

fn obligation_for_claim(c: TestClaim) -> TestObligation {
  TestObligation { claim_name: c.name, resources: claim_obligation_resources(c) }
}

// `QuantifiedTestClaim` projects onto the same obligation surface — `requires`
// is the sole authority per design §2.2. Generator/quantifier shape is
// orthogonal to the dependency-walk fact and never adds parallel edges.
fn obligation_for_quantified_claim(q: QuantifiedTestClaim) -> TestObligation {
  TestObligation { claim_name: q.name, resources: q.requires }
}

// SuiteClaim-level projection — dispatches the suite-entry coproduct onto the
// shared `TestObligation` surface so `QuantifiedTestClaim.requires` flows
// forward through the dependency-walk on equal footing with enumerated claims
// (INVARIANTS P2 — facts flow forward through a single carrier).
fn obligation_for_suite_claim(entry: SuiteClaim) -> TestObligation =
  match entry {
    Enumerated(c) => obligation_for_claim(c)
    Quantified(q) => obligation_for_quantified_claim(q)
  }

fn materialize_test_obligations(claims: List<SuiteClaim>) -> List<TestObligation> {
  map(claims, obligation_for_suite_claim)
}
