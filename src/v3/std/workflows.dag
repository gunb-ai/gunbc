// std.workflows — workflow spine helpers for DB-3 dimension analysis.
//
// 🟢 TERMINAL at Lane 2 Stage 2f scope for the **ordered behavior list**
// contract. `behavior_spine` names the same forward `Dag.nodes` order
// `lenses/cost.dag` uses in `compute_symbolic_costs` — witness order for
// per-Behavior dimensions must stay aligned with that fold.
//
// **Not in this module yet:** mapping `WorkflowEffect::LinearEffect` ops to
// substrate `Behavior` nodes (needs op→node wiring in the lane2 carrier).
// Until that lands, whole-program dimension analysis reads the spine below;
// workflow-scoped idempotency-class dimensions continue to consume
// `OperationEffect` lists directly (`std.effects`).

module v3.std.workflows

import std.list { List }
import std.substrate { Dag, Behavior }

// Ordered behaviors in construction order — authority for DB-3 witness lists
// when analyzing per-Behavior dimensions (symbolic cost, future user dims).
fn behavior_spine(d: Dag) -> List<Behavior> =
  d.nodes
