// std.effects — effect algebra for operation composition.
//
// **Status: bootstrap-staged std file.** The declarations in this
// file are loaded by `Dag::new()` from `src/v3/std/`. The function
// signatures are authoritative and available to downstream code
// today; function bodies are v3-compatible minimal encodings of the
// v2 authority at `dsl/std/effects.dag` — the semantics match, the
// surface form is reshaped to use only v3 grammar forms
// (`if ... then ... else ...`, single-binding match arms, explicit
// variant enumeration). When v3 grows `&&` / `||` / `_` wildcard /
// `if` block form, bodies can reflatten toward the v2 shape without
// signature churn.
//
// **Bootstrap staging.** Lives in `src/v3/std/` not `dsl/std/` for
// the same reason `src/v3/std/list.dag` does: v2's CI pipeline
// scans `dsl/` recursively and cannot parse v3's grammar. Canonical
// logical home is `dsl/std/effects.dag` once v2 retires. This port
// is the v3 structural carry-over of the v2 authority at
// `dsl/std/effects.dag`; keep the two in sync during the bootstrap
// window. See `THESIS.md` §"Two groundings" bootstrap note.
//
// **Scope (Lane 2 Stage 2a + follow-ups).** Structural carry-over of
// the v2 authority, with v3-only refinements already landed:
//   - `EffectShape = IsIdempotent(IdempotentShape) | IsBreaking(BreakingShape)` (partition)
//   - `IdempotentShape`, `BreakingShape`
//   - `CreateCause`, `KeySource`, `IdempotencyEvidence`
//   - `OperationEffect`, `BreakingOperation`
//   - `CompositionVerdict = IdempotentComposition | BrokenBy { first_breaker: BreakingOperation }`
//   - `is_idempotent_effect`, `operation_is_breaking`, `operation_to_breaker`
//   - `compose_effects(effects: List<OperationEffect>) -> CompositionVerdict`
//   - `derive_effect_shape(method, path)` — HTTP method + path → EffectShape
//   - `generate_idempotency_obligations`, `check_modifier_vs_derivation`
// v2-specific imports, parser quirks, and Rust bridge code do NOT
// come over. Pure `.dag` declarations.
//
// Stage 2a follow-ups (cleared):
//
// 1. `DerivedOpEffect` was collapsed into `OperationEffect` (PR #521).
// The previous shape carried `method` and `path_template` fields
// alongside `operation_name` + `shape`, but nothing downstream ever
// read the transport fields — the modifier check and obligation
// generator both project through `shape` alone, and the
// `ReadEffect` variant already encodes "method was GET/HEAD/OPTIONS."
// `OperationEffect` is the durable carrier Stage 2b's `compose_effects`
// walks; `derive_op_effect` now returns it directly. Future diagnostic
// rendering that wants the originating method/path should attach a
// separate evidence carrier to the diagnostic, not smuggle transport
// facts onto the effect record.
//
// 2. `ComposedEffect { operations, idempotent: Bool, breaking_operation: String? }`
// was removed entirely. `compose_effects` now returns
// `CompositionVerdict = IdempotentComposition | BrokenBy { first_breaker: BreakingOperation }`
// directly. The earlier intermediate form wrapped the verdict in a
// `{ operations, verdict }` record so callers could get the walk and
// the judgment from one value, but reviewer feedback on the
// intermediate R2 shape pointed out that pairing them admits
// incoherence: `verdict: IdempotentComposition` with a breaking op
// in `operations`, or `BrokenBy { first_breaker }` where the breaker
// is not actually in `operations`. `.dag` records are directly
// constructible, so "the constructor keeps them coherent" is a
// behavioral invariant, not a type-level one. Dropping the record
// leaves `operations` as the caller's own input and the verdict as
// the pure projected output — two facts kept separate at their
// natural sites, with no correlation for the type system to enforce.
//
// 3. `EffectShape` was partitioned into
// `IsIdempotent(IdempotentShape) | IsBreaking(BreakingShape)`,
// and `BrokenBy`'s payload narrowed to `BreakingOperation { shape: BreakingShape }`.
// The earlier flat `BrokenBy { first_breaker: OperationEffect }` shape
// still admitted `OperationEffect { shape: ReadEffect }` — an
// idempotent op in the breaker slot — enforced only by the
// `compose_effects` filter. Partitioning EffectShape at the type
// level, and narrowing the carrier to `BreakingShape`, makes naming
// an idempotent op as the workflow breaker unrepresentable rather
// than disallowed-by-convention. Consumers still match on the five
// concrete variants (ReadEffect / UpsertEffect / DeleteEffect /
// CreateEffect / AppendEffect) through the outer-variant destructure;
// the per-variant algebra is unchanged.
//
// DESIGN PRINCIPLE:
//   Idempotency is not a flag. It is a DERIVED PROPERTY of the
//   effect's algebraic structure. An operation whose effect forms
//   a lattice meet on the target state is idempotent by construction.
//   The compiler doesn't ask "did you mark this idempotent?" — it
//   checks "does this effect inhabit a lattice?"
//
// EXTERNAL AUTHORITY:
//   - Lattice theory: Birkhoff (1940). Lattice = set with meet ∧
//     and join ∨, both idempotent, commutative, associative, with
//     absorption. `meet(a, a) = a` is the idempotency law.
//   - Effect algebras: Foulis, Bennett (1994). Compositional
//     effects with partial combination.
//   - Idempotent semirings: dataflow analysis, routing algebras,
//     tropical geometry.
//
// RELATIONSHIP TO std/algebra.dag:
//   `Lattice<T>` is declared in `algebra.dag`. This file applies
//   the lattice structure to operation effects — the "T" is the
//   state space that the operation modifies.
//
// CONSUMERS:
//   - Lane 2 Stage 2b idempotency lens — walks workflow, composes
//     effects, emits diagnostic on chain break.
//   - Lane 2 Stage 2c test generation — emits `f(f(x)) == f(x)`
//     tests for idempotent ops.
//   - Lane 2 Stage 2d symbolic cost — composition chain lengths
//     inform asymptotic bounds on workflows.

module std.effects

import std.types { HttpMethod, GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS }
import std.list { List, cons }
import v3.std.substrate_minimal { NonEmptyList, NonSingletonList, PortId }

// ── Path-template carriers ──────────────────────────────────────
//
// These are inlined from the v2 `std/http_path.dag` authority
// because the v3 staged-file set does not yet include
// `http_path.dag`. Structural-identical to the v2 declarations so
// that a future port of `http_path.dag` can replace these inline
// definitions without reshaping `effects.dag`.
//
// Minimal helper subset inlined here too: `parse_path_template`
// and `last_path_param` are used by the staged v3 effect-derivation
// bodies below, while `src/v3/std/` does not yet ship a separate
// `http_path.dag`. Keep these definitions structurally aligned with
// the v2 authority until the standalone v3 port lands.
//
// 🟡 SCAFFOLD during the inline `http_path` bridge. `UrlPathToken`
// is not terminal in this file; it is a temporary local mirror of the
// standalone path-token authority that will live in `std/http_path.dag`.
// Dissolution trigger: the dedicated v3 `http_path.dag` port lands and
// `std.effects` imports the token/path carriers instead of defining them.

type UrlPathToken
  = LiteralToken { text: String }
  | ParamToken   { name: String }

type PathTemplate {
  tokens: List<UrlPathToken>
}

fn parse_path_template(raw: String) -> PathTemplate {
  let path_only = match raw |> split(delimiter: "?") |> first {
    Some(p) => p
    None => raw
  }
  let segments = path_only |> split(delimiter: "/") |> filter(s => s != "")
  let tokens = segments |> flat_map(seg => parse_segment_tokens(seg: seg))
  PathTemplate { tokens: tokens }
}

fn parse_segment_tokens(seg: String) -> List<UrlPathToken> {
  if seg |> contains("{") then
    let before_and_rest = seg |> split(delimiter: "{")
    let prefix = match before_and_rest |> first {
      Some(p) => p
      None => ""
    }
    let after_open = match before_and_rest |> skip(1) |> first {
      Some(r) => r
      None => ""
    }
    let name_and_suffix = after_open |> split(delimiter: "}")
    let param_name = match name_and_suffix |> first {
      Some(p) => p
      None => ""
    }
    let suffix = match name_and_suffix |> skip(1) |> first {
      Some(s) => s
      None => ""
    }
    let prefix_tokens = if prefix != "" then
      [LiteralToken { text: prefix }]
    else
      []
    let param_tokens = if param_name != "" then
      [ParamToken { name: param_name }]
    else
      []
    let suffix_tokens = if suffix != "" then
      [LiteralToken { text: suffix }]
    else
      []
    concat(prefix_tokens, param_tokens, suffix_tokens)
  else
    [LiteralToken { text: seg }]
}

fn last_path_param(template: PathTemplate) -> String? {
  let params = template.tokens |> filter(t =>
    match t {
      ParamToken => true
      LiteralToken => false
    })
  match params |> last {
    Some(tok) =>
      match tok {
        ParamToken { name: n } => Some(n)
        LiteralToken => None
      }
    None => None
  }
}

// ── Effect shapes ───────────────────────────────────────────────
//
// 🟢 TERMINAL at the staged effect-algebra scope. These variants are
// the irreducible operation-effect classes later lanes compose:
// read, keyed overwrite, keyed delete, create, append. Richer
// transport facts refine *which* variant a given operation derives,
// not the variant set itself.
//
// The fundamental classification of an operation's effect. Each
// shape corresponds to an algebraic structure on the state space:
//
//   ReadEffect:      identity function on state (trivially idempotent)
//   UpsertEffect:    lattice meet on Map<K, V> — sets key to value
//                    meet(state, {k: v}) applied twice = applied once
//   DeleteEffect:    lattice meet with bottom on key — removes key
//                    meet(state, {k: ⊥}) applied twice = applied once
//   CreateEffect:    monoid append — adds new entry without key guard
//                    NOT idempotent (creates duplicates). The
//                    `cause` preserves whether the create is the
//                    conservative POST default or a keyless
//                    fail-closed fallback from a method that would
//                    otherwise need a subject key.
//   AppendEffect:    monoid append on ordered collection
//                    NOT idempotent (appends duplicates)
//
// The state model determines the algebra:
//   Map<K, V> with upsert/delete → BoundedLattice (idempotent)
//   Set<T> with insert/remove    → BoundedLattice (idempotent)
//   List<T> with append          → FreeMonoid (NOT idempotent)

// 🟢 TERMINAL. The idempotent subset of effect shapes. All variants
// here form either an identity (ReadEffect) or a lattice meet on
// their target state (UpsertEffect / DeleteEffect); repeat application
// converges.
type IdempotentShape
  = ReadEffect
  | UpsertEffect { key_source: KeySource }
  | DeleteEffect { key_source: KeySource }

// 🟢 TERMINAL. The non-idempotent subset of effect shapes. Create
// (POST-style) and Append (free monoid) both duplicate on repeat
// application, so any workflow that includes them cannot be
// retried convergently.
type BreakingShape
  = CreateEffect { cause: CreateCause }
  | AppendEffect

// The fundamental classification of an operation's effect, expressed
// as the disjoint union of its idempotent and breaking subsets.
// Idempotency is not a property we then derive by scanning variants —
// it is encoded in the outer variant `IsIdempotent` / `IsBreaking`
// by construction, so `first_breaker: BreakingShape` and similar
// restricted carriers are well-typed without filtering.
type EffectShape
  = IsIdempotent(IdempotentShape)
  | IsBreaking(BreakingShape)

// 🟢 TERMINAL at current derivation scope. `CreateEffect` has two
// semantically distinct provenances that later diagnostics need to
// keep separate: conservative POST-create and keyless fail-closed
// fallback. Future richer transport witnesses may change which case
// derives, but do not remove the distinction.
//
// Why a create-shaped effect was derived. This keeps legitimate
// POST-creates distinct from fail-closed fallback on methods that
// should have carried a path key.
type CreateCause
  = PostAlways
  | KeylessFallback { method: HttpMethod }

// 🟢 TERMINAL. These are the durable structural places an idempotency
// key can come from in the current effect algebra: path, one field,
// or a structural tuple of fields. They classify key provenance
// without inventing a second authority for the operation itself.
//
// Where the idempotency key comes from. The key is what makes
// upsert/delete convergent: operating on the same key with the
// same value produces the same state regardless of how many times
// you apply it.
//
//   PathParam:     key extracted from URL/path template ({id}, {name})
//   InputField:    key is a declared input field of the operation
//   CompositeKey:  key is a tuple of multiple fields

type KeySource
  = PathParam { param: String }
  | InputField { field: String }
  | CompositeKey { fields: List<String> }

// ── Effect evidence ─────────────────────────────────────────────
//
// 🟢 TERMINAL at proof-reporting scope. `EffectShape` remains the
// single authority; this coproduct is the derived proof carrier a
// later lens/report can project from shape when it needs to explain
// *why* an operation is or is not idempotent.
//
// Per-operation evidence of idempotency. Analogous to
// `DescentEvidence` in termination proofs:
//   termination: "this argument is structurally smaller"
//   idempotency: "this effect forms a lattice on the target state"

type IdempotencyEvidence
  = LatticeEffect
  | IdentityEffect
  | NonIdempotent { reason: String }

// Whether an effect is idempotent — the partition's outer variant
// already encodes the answer, so this is a single-step match rather
// than a per-variant enumeration.
fn is_idempotent_effect(shape: EffectShape) -> Bool {
  match shape {
    IsIdempotent => true
    IsBreaking => false
  }
}

// Derived proof carrier for later reports. This is a projection from
// the single `EffectShape` authority, not a second authored fact.
fn derive_idempotency_evidence(shape: EffectShape) -> IdempotencyEvidence {
  match shape {
    IsIdempotent(inner) =>
      match inner {
        ReadEffect => IdentityEffect
        UpsertEffect => LatticeEffect
        DeleteEffect => LatticeEffect
      }
    IsBreaking(inner) =>
      match inner {
        CreateEffect =>
          NonIdempotent {
            reason: "create-shaped effect duplicates on repeat application"
          }
        AppendEffect =>
          NonIdempotent {
            reason: "append-shaped effect duplicates on repeat application"
          }
      }
  }
}

// ── Effect composition ──────────────────────────────────────────
//
// A workflow is idempotent iff all its constituent effects are
// idempotent. This is because lattice meets compose:
//   meet_a ∘ meet_b applied twice = meet_a ∘ meet_b applied once
//   (each individual meet is idempotent, and the composition of
//   idempotent functions on orthogonal keys is idempotent)
//
// Non-idempotent effects poison the composition:
//   meet_a ∘ append_b applied twice ≠ applied once
//   (the append duplicates on the second application)

// Per-operation effect entry in a workflow.
type OperationEffect {
  operation_name: String
  shape: EffectShape
}

// 🟢 TERMINAL. The breaking-subset projection of OperationEffect.
// `shape: BreakingShape` structurally restricts the variant space —
// no idempotent shape can inhabit this carrier — so naming an
// idempotent op as the workflow breaker is unrepresentable, not
// merely disallowed by a constructor convention.
type BreakingOperation {
  operation_name: String
  shape: BreakingShape
}

// 🟢 TERMINAL. The composition of idempotent lattice meets is
// idempotent; a single non-idempotent operation poisons the chain.
// The judgment space is therefore exactly two states: the workflow
// converges, or some operation broke convergence. No third state.
//
// `first_breaker: BreakingOperation` is a state-space-sound witness:
// its `shape` field ranges only over `BreakingShape`, so the verdict
// cannot name an idempotent op as the breaker. Downstream diagnostics
// project shape / cause directly.
type CompositionVerdict
  = IdempotentComposition
  | BrokenBy { first_breaker: BreakingOperation }

// True if this operation is non-idempotent. Reads the partition
// directly off `EffectShape` — no evidence-projection round-trip.
fn operation_is_breaking(op: OperationEffect) -> Bool {
  match op.shape {
    IsIdempotent => false
    IsBreaking => true
  }
}

// Project an OperationEffect to the breaking-subset witness when its
// shape falls in `BreakingShape`; `None` when the op is idempotent.
// The outer-variant match is exhaustive, so adding a new EffectShape
// partition member forces this projection to update.
fn operation_to_breaker(op: OperationEffect) -> BreakingOperation? {
  match op.shape {
    IsIdempotent => None
    IsBreaking(breaking) =>
      Some(BreakingOperation {
        operation_name: op.operation_name,
        shape: breaking
      })
  }
}

// Compose a list of operation effects into a workflow-level verdict.
// Returns `CompositionVerdict` directly — no enclosing record around
// the verdict plus the input list. Callers that want the evidence
// chain keep the input `List<OperationEffect>` in scope; pairing the
// verdict with the walk inside a record would create a second
// authority (the list) alongside the projected one (the verdict),
// and `.dag` records are directly constructible, so the two could
// be made to disagree without any type-level obstruction.
//
// Flat-maps each op through `operation_to_breaker`, then takes the
// first breaker (if any). `BrokenBy` is only constructible from a
// `BreakingOperation`, so the verdict is state-space sound.
fn compose_effects(effects: List<OperationEffect>) -> CompositionVerdict {
  let breaker_candidates = effects |> flat_map(op =>
    match operation_to_breaker(op: op) {
      Some(b) => [b]
      None => []
    }
  )
  match breaker_candidates |> first {
    Some(b) => BrokenBy { first_breaker: b }
    None => IdempotentComposition
  }
}

// ── DB-18 workflow carrier (Stage 2b) ───────────────────────────
//
// Modeling-discipline principle 4: each coproduct / boundary carrier
// below carries its own 🟢/🟡 stamp — not only this banner.
//
// Four-variant coproduct: linear composition delegates to
// `compose_effects`; branching / loop / parallel are structurally
// distinct control-flow shapes — the idempotency lens reports
// `Unsupported` for those until a branch-wise algebra lands.
//
// Track 9 parity: `BoolPortRef` mirrors `ParamRef` / `TransformRef` in
// `substrate.dag` — a named witness carrier, not a bare `PortId` on
// `BranchArm`. Validity (Bool-typed port) is enforced by
// `Dag::bool_port_of` on the Rust side; substrate constructor symmetry is
// tracked under the same ROADMAP Track 9 debt as other reflected handles.

// 🟢 TERMINAL. Bool-typed port witness — Track 9 parallel to `ParamRef` /
// `TransformRef`; illegal states (non-Bool port) are rejected at
// `Dag::bool_port_of` on the Rust substrate (sole Bool-validating constructor).
type BoolPortRef {
  port: PortId
}

// 🟢 TERMINAL. One conditional arm: witnessed predicate + nested workflow body.
type BranchArm {
  condition: BoolPortRef
  body: WorkflowEffect
}

// 🟢 TERMINAL. Four-way workflow sum — Stage 2b analyzes `LinearEffect` only;
// `BranchEffect` / `LoopEffect` / `ParallelEffect` return explicit unsupported
// reports until a branch-wise idempotency algebra lands (see
// `WorkflowIdempotencyReport`).
//
// **Graduation receipt (🟡 scaffold → 🟢 terminal on this carrier):** closed once
// Lane 2 Stage 2b (`lane2_workflow_idempotency_report` + idempotency lens) and a
// second Lane-2 workflow consumer (Stage 2e parallelism / `analyze_parallelism`,
// landed as PR #543) both consumed this sum without a shape change. Additional
// variants remain gated by DB-18 STOP-AND-ESCALATE — not ad-hoc growth here.
type WorkflowEffect
  = LinearEffect { ops: List<OperationEffect> }
  | BranchEffect { arms: NonSingletonList<BranchArm> }
  | LoopEffect { body: WorkflowEffect }
  | ParallelEffect { branches: NonSingletonList<WorkflowEffect> }

// 🟢 TERMINAL. Explicit unsupported payload — names variant, downstream stage,
// and reason; not a silent `Option` beside a verdict (fail-closed unsupported).
//
// Lane 2 Stage 2b report axis: algebra verdict OR this carrier — no outer
// record pairing verdict with a parallel input list (R3 `ComposedEffect`
// removal; DB-18 open question §2).
type IdempotencyUnsupportedDetail {
  variant_name: String
  downstream_stage: String
  reason: String
}

// 🟢 TERMINAL. Lens boundary sum: composed verdict vs explicit unsupported —
// two constructors only; no nullable parallel fields.
type WorkflowIdempotencyReport
  = WorkflowCompositionVerdict(CompositionVerdict)
  | IdempotencyUnsupported(IdempotencyUnsupportedDetail)

fn report_unsupported_workflow_variant(
  variant_name: String,
  downstream_stage: String,
  reason: String
) -> WorkflowIdempotencyReport {
  IdempotencyUnsupported(IdempotencyUnsupportedDetail {
    variant_name: variant_name,
    downstream_stage: downstream_stage,
    reason: reason,
  })
}

// Stage 2b projection: `LinearEffect` delegates to `compose_effects`; other
// shapes are explicit unsupported until downstream stages consume them.
fn lane2_workflow_idempotency_report(wf: WorkflowEffect) -> WorkflowIdempotencyReport {
  match wf {
    LinearEffect { ops } => WorkflowCompositionVerdict(compose_effects(effects: ops))
    BranchEffect { .. } =>
      report_unsupported_workflow_variant(
        "BranchEffect",
        "lane2_stage2b_idempotency_lens",
        "non-linear workflow; branch-wise idempotency composition is not in the Stage 2b algebra"
      )
    LoopEffect { .. } =>
      report_unsupported_workflow_variant(
        "LoopEffect",
        "lane2_stage2b_idempotency_lens",
        "non-linear workflow; loop-carried idempotency composition is not in the Stage 2b algebra"
      )
    ParallelEffect { .. } =>
      report_unsupported_workflow_variant(
        "ParallelEffect",
        "lane2_stage2b_idempotency_lens",
        "non-linear workflow; parallel idempotency composition is not in the Stage 2b algebra"
      )
  }
}

// `analyze_workflow` lives in `src/v3/lenses/idempotency.dag` (Lane 2 Stage 2b
// lens) — not here — so the name does not duplicate across bootstrap modules.

// ── Effect derivation from transport facts ──────────────────────
//
// The compiler derives `EffectShape` from facts it already has on
// the service operation:
//
// | HTTP method | Key in path? | Derived shape           | Idempotent? |
// |-------------|--------------|-------------------------|-------------|
// | GET         | —            | ReadEffect              | Yes         |
// | PUT         | Yes ({id})   | UpsertEffect(PathParam) | Yes         |
// | PUT         | No           | CreateEffect(KeylessFallback(PUT))      | No          |
// | DELETE      | Yes ({id})   | DeleteEffect(PathParam) | Yes         |
// | POST        | —            | CreateEffect(PostAlways) | No         |
// | PATCH       | Yes ({id})   | UpsertEffect(PathParam) | Yes         |
//
// POST always derives `CreateEffect { cause: PostAlways }` — the
// table cannot distinguish
// parent-scoped paths (POST /projects/{id}/secrets creates a CHILD)
// from resource-identity paths without a structural subject-key
// witness. This is conservative: declared `idempotent` modifiers on
// POST ops surface as `DerivationUnknown`, not as false proofs.
//
// PUT/PATCH/DELETE require a proven path key. Without one, the
// derivation returns `CreateEffect { cause: KeylessFallback { ... } }`
// (non-idempotent) rather than fabricating an empty InputField key.

fn parse_http_method(raw: String) -> HttpMethod? {
  if raw == "GET" then Some(GET)
  else if raw == "PUT" then Some(PUT)
  else if raw == "POST" then Some(POST)
  else if raw == "DELETE" then Some(DELETE)
  else if raw == "PATCH" then Some(PATCH)
  else if raw == "HEAD" then Some(HEAD)
  else if raw == "OPTIONS" then Some(OPTIONS)
  else None
}

fn keyless_create(method: HttpMethod) -> EffectShape {
  IsBreaking(CreateEffect { cause: KeylessFallback { method: method } })
}

// Given a last-param lookup result, build the Upsert variant when
// the key is present; fall back to a keyless CreateEffect when the
// path has no parameter. Factored out so `derive_effect_shape` can
// share one key-resolution strategy across PUT and PATCH.
fn upsert_or_create(last_param: String?, method: HttpMethod) -> EffectShape {
  match last_param {
    Some(p) => IsIdempotent(UpsertEffect { key_source: PathParam { param: p } })
    None => keyless_create(method: method)
  }
}

fn delete_or_create(last_param: String?, method: HttpMethod) -> EffectShape {
  match last_param {
    Some(p) => IsIdempotent(DeleteEffect { key_source: PathParam { param: p } })
    None => keyless_create(method: method)
  }
}

fn derive_effect_shape(
  method: HttpMethod,
  path: PathTemplate
) -> EffectShape {
  match method {
    GET     => IsIdempotent(ReadEffect)
    HEAD    => IsIdempotent(ReadEffect)
    OPTIONS => IsIdempotent(ReadEffect)
    POST    => IsBreaking(CreateEffect { cause: PostAlways })
    DELETE  => delete_or_create(last_param: last_path_param(template: path), method: method)
    PUT     => upsert_or_create(last_param: last_path_param(template: path), method: method)
    PATCH   => upsert_or_create(last_param: last_path_param(template: path), method: method)
  }
}

fn derive_op_effect(
  operation_name: String,
  method_str: String,
  path_str: String
) -> OperationEffect? {
  match parse_http_method(raw: method_str) {
    None => None
    Some(method) =>
      Some(OperationEffect {
        operation_name: operation_name,
        shape: derive_effect_shape(
          method: method,
          path: parse_path_template(raw: path_str)
        )
      })
  }
}

// ── Modifier falsification ──────────────────────────────────────
//
// The derivation replaces the manual `idempotent: Bool` on
// `OperationBehavior`. `check_modifier_vs_derivation` is the
// cross-check that surfaces divergence: if a user wrote
// `idempotent` but the derived shape disagrees, the compiler
// reports `Disagrees` or `DerivationUnknown` rather than silently
// trusting one source over the other.

// 🟢 TERMINAL. This is the irreducible judgment space for a declared
// modifier against structural derivation: it agrees, it disagrees,
// or derivation cannot decide and must say so explicitly.
type ModifierAgreement
  = Agrees
  | Disagrees          { reason: String }
  | DerivationUnknown  { reason: String }

// 🟢 TERMINAL at modifier-check scope. The two states are genuinely
// distinct: a modifier was never declared, or it was declared and
// therefore must carry a structural judgment. This prevents
// "declared but no verdict" from becoming representable.
//
// Per-axis modifier result. `ModifierNotDeclared` means the user did
// not state that modifier; `ModifierDeclared` guarantees there is a
// judgment for every declared modifier fact.
type ModifierAxisCheck
  = ModifierNotDeclared
  | ModifierDeclared { agreement: ModifierAgreement }

type ModifierCheck {
  operation_name: String
  derived_shape: EffectShape
  idempotent_check: ModifierAxisCheck
  readonly_check: ModifierAxisCheck
}

// Disagreement classifier when the user declared idempotent but
// the derivation says otherwise. Takes `BreakingShape` directly —
// the partition already guarantees the derivation says
// non-idempotent, so no idempotent-shape arms are reachable.
// POST-create stays the fail-closed-but-maybe-idempotent case
// (DerivationUnknown); a keyless fallback on PUT/PATCH/DELETE is a
// hard disagreement because the required subject-key witness is
// missing; AppendEffect is a hard disagreement because free-monoid
// append cannot be retried convergently.
fn classify_idempotent_disagreement(shape: BreakingShape) -> ModifierAgreement {
  match shape {
    CreateEffect { cause } =>
      match cause {
        PostAlways =>
          DerivationUnknown {
            reason: "POST derives CreateEffect { cause: PostAlways }; idempotency may be spec-declared"
          }
        KeylessFallback =>
          Disagrees {
            reason: "declared idempotent but method-derived effect fell back to keyless CreateEffect"
          }
      }
    AppendEffect =>
      Disagrees { reason: "declared idempotent but derivation says non-idempotent via append-shaped effect" }
  }
}

// Readonly-declaration classifier: only `ReadEffect` agrees; every
// other idempotent shape (upsert/delete) writes the target, and every
// breaking shape does too. Nested match keeps the specific reasons per
// write-shape available, but the `IsBreaking` arm collapses because the
// verdict is identical across create/append.
fn classify_readonly_agreement(shape: EffectShape) -> ModifierAgreement {
  match shape {
    IsIdempotent(inner) =>
      match inner {
        ReadEffect => Agrees
        UpsertEffect =>
          Disagrees { reason: "readonly declared but derived effect writes target state" }
        DeleteEffect =>
          Disagrees { reason: "readonly declared but derived effect writes target state" }
      }
    IsBreaking =>
      Disagrees { reason: "readonly declared but derived effect writes target state" }
  }
}

fn check_modifier_vs_derivation(
  op: OperationEffect,
  declared_idempotent: Bool,
  declared_readonly: Bool
) -> ModifierCheck {
  let idempotent_check = if declared_idempotent then
    match op.shape {
      IsIdempotent => ModifierDeclared { agreement: Agrees }
      IsBreaking(breaking) =>
        ModifierDeclared {
          agreement: classify_idempotent_disagreement(shape: breaking)
        }
    }
  else
    ModifierNotDeclared
  let readonly_check = if declared_readonly then
    ModifierDeclared {
      agreement: classify_readonly_agreement(shape: op.shape)
    }
  else
    ModifierNotDeclared
  ModifierCheck {
    operation_name: op.operation_name,
    derived_shape: op.shape,
    idempotent_check: idempotent_check,
    readonly_check: readonly_check
  }
}

// ── Test obligation generation ──────────────────────────────────
//
// For each idempotent op, the compiler emits a test asserting
// `f(f(x)) == f(x)`. The obligations are data; Lane 2 Stage 2c
// consumes this list and lowers each obligation into an emitted
// test body.

type IdempotencyTestObligation {
  operation_name: String
  effect_shape: EffectShape
  claim: String
  witness_required: Bool
}

fn generate_idempotency_obligations(
  ops: List<OperationEffect>
) -> List<IdempotencyTestObligation> {
  ops |> filter(o => is_idempotent_effect(shape: o.shape))
      |> map(o => IdempotencyTestObligation {
           operation_name: o.operation_name,
           effect_shape: o.shape,
           claim: "f(f(x)) == f(x)",
           witness_required: true
         })
}

// ── Workflow-level effect concerns ──────────────────────────────
//
// Surfaces when a workflow contains a `CreateEffect` operation at
// a position that breaks workflow-level idempotency. Consumed by
// Lane 2 Stage 2b's diagnostic construction.

type WorkflowEffectConcern {
  workflow_name: String
  create_op: String
  reason: String
}
