module v3.std.extdeps_bootstrap_fixtures

// B4.4 — Structural bootstrap fixture-set carrier.
//
// Single substrate authority for *which* `.dag` files are loaded into the
// PB-1-e bootstrap Dag as structural primitive data (Path 2 pilot). The
// fixture set is **mixed-tree** as of T-Ground-LanguageSpec scope E.1:
// per-target render-template contract lists live under `src/v3/std/` (the
// v2 walker doesn't traverse that tree, avoiding the cross-tree-import
// regression #1187 surfaced); target primitives still live under
// `dsl/extdeps/languages/`. The carrier is the structural authority
// regardless of where each file physically lives.
//
// The regen host (`bootstrap_regen_fresh`) filters `STAGED_FILES`
// (`src/v3/std/*.dag`) and `EXTDEPS_FILES` (`dsl/extdeps/**/*.dag`)
// through the `virtual_path` strings recorded here. At runtime the
// committed bootstrap snapshot load compares those paths to
// `BOOTSTRAP_FIXTURE_PATH_KEYS` in `bootstrap.rs` (see `dag.rs`).
//
// **Filename note.** This file is named
// `extdeps_bootstrap_fixtures.dag` for historical reasons (B4.4 landed
// under the extdeps-only framing). The name is preserved so the
// parse-corpus manifest path stays stable; the carrier-name rename
// (`Extdeps...` → unprefixed) reflects the now-mixed scope without
// incurring a manifest-row churn.

// One source file authorized for bootstrap loading.
type BootstrapFixture {
  virtual_path: String
}

// Named product of every pilot fixture row (extend with new fields when adding
// targets; cost of change stays this file + the parallel `const` filter).
type BootstrapFixtureSet {
  rust_pilot_primitives: BootstrapFixture
  rust_method_template_contracts: BootstrapFixture
  python_method_template_contracts: BootstrapFixture
  go_method_template_contracts: BootstrapFixture
  anthropic_operations: BootstrapFixture
  cross_target_coverage: BootstrapFixture
}

data bootstrap_fixture_authority: BootstrapFixtureSet = {
  rust_pilot_primitives: {
    virtual_path: "dsl/extdeps/languages/rust/primitives.dag"
  },
  rust_method_template_contracts: {
    virtual_path: "src/v3/std/rust_method_template_contracts.dag"
  },
  python_method_template_contracts: {
    virtual_path: "src/v3/std/python_method_template_contracts.dag"
  },
  go_method_template_contracts: {
    virtual_path: "src/v3/std/go_method_template_contracts.dag"
  },
  anthropic_operations: {
    virtual_path: "src/v3/std/anthropic_operations.dag"
  },
  cross_target_coverage: {
    virtual_path: "src/v3/std/cross_target_coverage.dag"
  }
}
