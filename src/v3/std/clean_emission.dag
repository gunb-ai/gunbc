module v3.std.clean_emission

import std.list { List }
import v3.spec.v3_l1 { DeclarationRef }

// 🟢 TERMINAL. Per-target emission invariant (E-5). Every rule in
// this contract must be satisfied by construction — emitted code
// passes the target's declared verifier without modification. No
// post-emission cleanup, no `#[allow(...)]` / `# noqa` / pragma
// suppression. The contract GROWS by adding typed rules when new
// warning categories surface; it does NOT grow by admitting
// suppression. See INVARIANTS.md §E-5 and DB-4 for the full table.
type CleanEmissionContract {
  expression_wrapping: ExpressionWrappingRule
  pattern_bindings: PatternBindingRule
  variant_payload_field_access: VariantPayloadFieldAccessRule
  imports: ImportRule
  block_return: BlockReturnRule
  variable_bindings: VariableBindingRule
  match_arm_body: MatchArmBodyRule
  correction_style: CorrectionStyle
  post_emit_verifier: PostEmitVerifier
}

// 🟢 TERMINAL. Single authority tying a target `LanguageSpec` to the
// `CleanEmissionContract` that governs emitted-source hygiene for
// that language. Bootstrap scans these bindings structurally, so
// adding a new target is one more spec data item rather than a new
// compiler-side branch.
type TargetCleanEmissionBinding {
  language: DeclarationRef
  clean_emission: DeclarationRef
}

// 🟢 TERMINAL. Governs wrapping of expressions with precedence
// parentheses (rustc's `unused_parens`). `WrapEverything` is the
// pre-E-5 default and is rejected by the invariant when the target
// is precedence-capable — it's kept as a variant only so early
// targets could be represented before they migrate to the correct
// rule.
type ExpressionWrappingRule
  = WrapEverything
  | WrapOnlyInOperandPosition
  | NoWrapping

// 🟢 TERMINAL. Governs how a payload binding in a match arm is
// emitted when the arm body does not reference it (rustc's
// `unused_variables` in match arms). `NotApplicable` covers targets
// without structural pattern matching.
type PatternBindingRule
  = EmitBindingAlways
  | EmitUnderscoreWhenUnused
  | EmitPrefixedUnderscoreWhenUnused
  | NotApplicablePatternBinding

// 🟢 TERMINAL. Governs how a match-arm payload binding answers
// downstream field projections (`payload.head`, `payload.count`)
// after the arm has introduced the payload-binding port.
//
// `AccessFromPayloadBinding` means the binding expression itself is a
// whole payload carrier whose fields can be projected directly by the
// target emitter (`v.head`, `__match.count`).
//
// `OverrideNamedFieldsAtBindingSite` means named payload fields cannot
// be projected off the bound payload value in the target surface, so
// the emitter must install per-field bindings at the match site and
// route later `payload.field` reads through those bindings instead.
type VariantPayloadFieldAccessRule
  = AccessFromPayloadBinding
  | OverrideNamedFieldsAtBindingSite

// 🟢 TERMINAL. Governs which declared imports make it into the
// emitted module (rustc's `unused_imports`).
type ImportRule
  = ImportEverythingDeclared
  | IncludeOnlyReferenced
  | ImportPerUsageSite

// 🟢 TERMINAL. Governs the terminal expression of a block (rustc's
// `unused_parens around block return value`).
type BlockReturnRule
  = WrapReturnValue
  | NoWrappingOnTerminalExpression
  | ExplicitReturnKeyword

// 🟢 TERMINAL. Governs a `let`-binding whose identifier the body
// does not reference (rustc's `unused_variables` at let-bindings).
type VariableBindingRule
  = EmitLetBindingAlways
  | EmitLetUnderscoreWhenUnused
  | OmitLetBinding

// 🟢 TERMINAL. Governs wrapping of the arm body expression in a
// match (rustc's `unused_parens around match arm expression`).
// Go uses switch and renders arm bodies differently, so
// `NotApplicable` is a legitimate choice.
type MatchArmBodyRule
  = WrapBody
  | NoWrappingOnNonComplexBody
  | NotApplicableMatchArmBody

// 🟢 TERMINAL. Per-target rendering style used by diagnostic fix
// generators that surface source-level corrections. DB-1's
// `Correction` type consumes this to know how its inserted text
// composes with the surrounding .dag source. Minimal shape here;
// DB-1 may extend at the point its consumers land.
type CorrectionStyle {
  indent_unit: String
  line_ending: String
  string_quote: String
  trailing_semicolon: Bool
}

// 🟢 TERMINAL. Declares the external verifier that validates
// emitted source for this target. `syntax_only` distinguishes
// shallow checks (gofmt, py_compile) from full compiles (rustc).
// `expected_exit_code` and `output_policy` together define the
// verifier's verdict semantics. Exit code alone is insufficient
// for tools like `gofmt -l`, which report dirty files via stdout
// while still exiting 0.
type PostEmitVerifier {
  command: String
  args: List<String>
  syntax_only: Bool
  expected_exit_code: Int
  output_policy: VerifierOutputPolicy
}

// 🟢 TERMINAL. Defines how verifier process output affects the
// pass/fail verdict once `expected_exit_code` matched. Keeps
// verifier-result semantics structural instead of hardcoding
// tool-specific stdout/stderr rules in the harness.
type VerifierOutputPolicy
  = IgnoreVerifierOutput
  | RequireEmptyStdout
  | RequireEmptyStderr
  | RequireEmptyStdoutAndStderr
