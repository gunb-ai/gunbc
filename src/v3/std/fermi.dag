// std.fermi -- v3-staged Fermi estimation depth lattice.
//
// Authority for v3: `FermiDepth` inhabits `BoundedLattice<FermiDepth>`
// directly. The legacy `dsl/std/fermi.dag` helper functions remain only for
// v2 compatibility until `dsl/` can author direct inhabitance.

module std.fermi

import std.algebra { BoundedLattice }
import std.types { Milliseconds }

type FermiDepth inhabits BoundedLattice<FermiDepth>
  = Xs
  | S
  | M
  | L
  | Xl

fn fermi_ordinal(depth: FermiDepth) -> Int {
  match depth {
    Xs => 0
    S  => 1
    M  => 2
    L  => 3
    Xl => 4
  }
}

fn fermi_within_budget(depth: FermiDepth, budget: FermiDepth) -> Bool {
  fermi_ordinal(depth: depth) <= fermi_ordinal(depth: budget)
}

type FermiTimeout {
  depth: FermiDepth
  timeout_ms: Milliseconds
  label: String
}

data fermi_timeouts: List<FermiTimeout> = [
  FermiTimeout { depth: Xs, timeout_ms: 30000,    label: "30 seconds" },
  FermiTimeout { depth: S,  timeout_ms: 300000,   label: "5 minutes" },
  FermiTimeout { depth: M,  timeout_ms: 600000,   label: "10 minutes" },
  FermiTimeout { depth: L,  timeout_ms: 1800000,  label: "30 minutes" },
  FermiTimeout { depth: Xl, timeout_ms: 3600000,  label: "60 minutes" },
]

fn timeout_for_depth(depth: FermiDepth) -> Milliseconds? {
  let matches = filter(fermi_timeouts, t => t.depth == depth)
  match matches |> first {
    Some { value: t } => Some { value: t.timeout_ms }
    None => none
  }
}
