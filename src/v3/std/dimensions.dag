// std.dimensions — compile-time dimensions and unit-typed values.
//
// 🟢 TERMINAL for the structural surface (Lane 2 Stage 2f). Execution
// authority for `analyze_symbolic_cost_dimension` lives in
// `v3_compiler::dimension` until generic HO list folds lower from
// `.dag` without host stubs. When class-5 `data` bodies land, callers
// can walk `Dag::declarations()` for `Dimension<Carrier>` values — no
// separate compiler registry until a real consumer needs it.
//
// **Deferred:** `data symbolic_cost_dimension: AnalysisDimension<SymbolicCost> = { ... }`
// — class-5 gap #3 (`DOWNSTREAM_REQUIREMENTS.md`) blocks record bodies; the
// symbolic-cost **analysis** path still dispatches through this module's
// report shape + the cost lens algebra.
//
// See DB-3 (`docs/design-dimension-abstraction.md`) §"Core type".

module v3.std.dimensions

import std.list { List }
import std.substrate { Dag, Behavior }
import std.algebra { OrderedRing, Monoid }
import v3.std.diagnostics { Diagnostic }

// 🟢 TERMINAL at the structural-witness scope. `Witness<Carrier>`
// partitions per-operation evidence into two disjoint cases:
//
//   - `Inhabits(c)`  — this behavior is an ok member of the
//                      dimension's algebra; compose absorbs `c`.
//   - `Violates {..}` — this behavior breaks the dimension; a
//                       diagnostic fires and composition stalls.
//
// The coproduct is authored at the witness level, not above it in
// an `Option<Witness>` shape, so "no evidence" and "evidence of
// violation" cannot masquerade as each other (DB-3 §Rationale).
type Witness<Carrier>
  = Inhabits(Carrier)
  | Violates { reason: String, at: Behavior }

// Optional break channel for `break_diagnostic` — replaces `Diagnostic?`
// until optional return types are uniform on staged function declarations.
type OptionalDiagnostic
  = NoDiagnostic
  | SomeDiagnostic { value: Diagnostic }

// 🟢 TERMINAL. Aggregate result from `analyze` (DB-3 §Dimension evaluation).
//
// Pass/fail partition: a successful proof carries `composed`; a failed
// proof carries `violations` and never fabricates a carrier — there is
// no valid `composed` when any witness `Violates` or composition at
// the workflow root cannot be resolved (R2 fail-closed).
type DimensionReport<Carrier>
  = DimensionOk {
      dimension_name: String
      composed: Carrier
      witnesses: List<Witness<Carrier>>
    }
  | DimensionFail {
      dimension_name: String
      violations: List<Diagnostic>
      witnesses: List<Witness<Carrier>>
    }

// 🟢 TERMINAL at the dimension-surface scope. The four fields are
// the irreducible contract a compile-time property has to publish:
//   - `name`      — human-facing identifier
//   - `witness_of`— per-op evidence extraction
//   - `compose`   — `Monoid<Carrier>` (`dsl/std/algebra.dag`) carrying
//                   both the binary combine and its identity in a
//                   single field. Replaces the prior parallel
//                   `compose: fn(Carrier, Carrier) -> Carrier` +
//                   `identity: Carrier` pair (F2 dispatch on parent
//                   inbox #1130): that shape duplicated the monoid-law
//                   authority and was structurally identical to the
//                   pre-2026-04-28 `Lens<C>` drift, which already
//                   migrated to `sequential: Monoid<C>`
//                   (`src/v3/std/lens.dag` §`sequential`). Mirroring
//                   that precedent here means the monoid law lives once,
//                   on `Monoid<Carrier>`, and structural inhabitance
//                   over the algebra type is the enforcement vehicle —
//                   not field-pair convention.
//   - `break_diagnostic` — optional diagnostic when composition breaks
type AnalysisDimension<Carrier> {
  name: String
  witness_of: fn(Dag, Behavior) -> Witness<Carrier>
  compose: Monoid<Carrier>
  break_diagnostic: fn(Behavior, Carrier) -> OptionalDiagnostic
}

// R2 T-Modeling unit wrapper. `Unit` is a compile-time-only phantom
// parameter; `Carrier` is the runtime value. Until `.dag` can declare
// `phantom_params` directly, the lowerer has one bounded bridge for this
// exact std authority (`src/v3/std/dimensions.dag` + `Dimension<Unit, Carrier>
// { value: Carrier }`): it attaches
// `PhantomParameter { parameter: Unit, algebra: AbelianGroup<Unit> }` and
// fails closed if the declaration shape or algebra witness drifts. Dissolution
// trigger: when phantom parameters become source-declared substrate facts,
// delete the lowerer bridge and move this fact onto the declaration itself.
type Dimension<Unit, Carrier> {
  value: Carrier
}

type Meters
type Seconds
type Kilograms
type Amperes
type Kelvin
type Moles
type Candela

fn add_dimension<Unit, Carrier>(
  carrier_algebra: OrderedRing<Carrier>,
  left: Dimension<Unit, Carrier>,
  right: Dimension<Unit, Carrier>
) -> Dimension<Unit, Carrier> { host dimension_add }

fn sub_dimension<Unit, Carrier>(
  carrier_algebra: OrderedRing<Carrier>,
  left: Dimension<Unit, Carrier>,
  right: Dimension<Unit, Carrier>
) -> Dimension<Unit, Carrier> { host dimension_sub }

fn mul_dimension_scalar<Unit, Carrier>(
  carrier_algebra: OrderedRing<Carrier>,
  value: Dimension<Unit, Carrier>,
  scalar: Carrier
) -> Dimension<Unit, Carrier> { host dimension_mul_scalar }

fn div_dimension_scalar<Unit, Carrier>(
  carrier_algebra: OrderedRing<Carrier>,
  value: Dimension<Unit, Carrier>,
  scalar: Carrier
) -> Dimension<Unit, Carrier> { host dimension_div_scalar }
