module v3.std.emit_model

import v3.spec.v3_l1 { DeclarationRef }
import v3.std.methods { MethodRef }
import v3.std.substrate { IntInterval }
import std.list { List }

// Target ownership is carried on every shared realization as a
// typed `language: DeclarationRef` field pointing at the owning
// target's language-spec declaration (e.g., `rust_language`,
// `go_language`). The reference is resolved via dotted-path
// lowering at spec parse time; each emitter compares it to its
// own cached language-spec id to pick up only its entries.
// Adding a new shared target is a pure spec-file change — drop a
// `<target>.dag` with a LanguageSpec data item and reference it
// from each realization. No compiler enum roster to edit.
type TypeRealization {
  language: DeclarationRef
  target: DeclarationRef
  carrier: String
  is_copy: Bool
  fields: List<FieldBinding>
  cost: Int
}

// 🟡 SCAFFOLD (Coercion-Fold dissolution — Slice B rows, Slice C consumer).
// Per-target integer inhabitance facts for structural emission selection; see
// `docs/audit/scratch-int-examples-dissolution-spec.md` Slice B. Declared as
// `data` in `src/v3/spec/{rust,python,go}.dag`. Rows are walkable substrate
// today; Grounding selects rows via `LanguageSpecProjection::DeclaredIntegerIntents`
// plus program-side `IntegerTargetIntent` facts (executable projection).
//
// **INVARIANTS.md E-6** (`docs/invariants/e-6-no-target-spec-field-without-a-same-pr-consumer.md`):
// Full `emit_rust` / generated-emitter payload reads are still Slice C (#1133 / #1286).
// **Bounded exception + dissolution ratchet:** rows land under an explicit scaffold marker here;
// Declared projection consumes these rows structurally (no scratch example driver).
//
// **Same-PR consumer (checkpoint, not speculative metadata):** `v3-grounding-coercion-fold`
// `fold_program_to_target` counts meta-tagged `TargetIntegerTypeInhabitance` declarations in
// the `dag` before selection — missing
// rows ⇒ `EmissionDiagnostic::UnderRefined { unspecified_axis: "declared_TargetIntegerTypeInhabitance_rows" }`.
//
// **Failing proofs:** `v3_grounding_coercion_fold::tests::declared_projection_requires_emit_model_inhabitance_rows`
// (empty `dag` trips the row gate); `m2_substrate_inhabitance_test::target_integer_type_inhabitance_rows_are_structural_slice_b_receipt`
// (bootstrap rows lower structurally).
type TargetIntegerTypeInhabitance {
  language: DeclarationRef
  kernel_integer: DeclarationRef
  algebra: DeclarationRef
  bound: TargetIntegerInhabitanceBound
  // Row field stays `DeclarationRef`; **`v3-grounding-coercion-fold`** fail-closed-refines at
  // selection time: referenced declaration must carry `TypeRealization` meta
  // (`dag.type_realization_meta()`) before `SelectedTargetInhabitance` is returned.
  type_realization: DeclarationRef
}

// 🟢 TERMINAL — coproduct dissolution receipt (`feedback_coproduct_dissolution` / four-pattern check).
// LanguageSpec carrier: how an integer inhabitance row attaches static bound facts vs leaving them
// under-refined for Slice C grounding.
//
// **Pattern 1 — Fact placement.** Variants name the same field (`TargetIntegerTypeInhabitance.bound`);
// the discriminant is KIND of bound attachment, not competing DAG slots. ✓ does not apply.
//
// **Pattern 2 — Variant-is-data.** `BoundUnspecified` is unit; `StaticBoundFact(IntInterval)` carries
// substrate `Interval<Int>`; `PlatformDependentFact` is unit (kind-only target witness). Distinct
// payloads — not label-only. ✓ does not apply.
//
// **Pattern 3 — Algebraic form.** Unspecified vs closed/static interval witness are different emission
// authorities (defer vs inline Q1 interval); no shared intro/elim form. ✓ does not apply.
//
// **Pattern 4 — Dimensional.** Not a coordinate record with `Option` axes per variant; `IntInterval`
// is the shared substrate bound parent when present. ✓ does not apply.
//
// **Conclusion:** irreducible coproduct for Slice B rows; emitters/grounding learn this sum in Slice C.
// Design rationale (why not optional interval fields on `TargetIntegerTypeInhabitance`, why not parallel
// top-level `BoundDeclaration` bodies): Pattern 1 at row level would erase the explicit axis; Pattern 2
// hits DB-10 unparsed gap for those top-level data bodies (`lower_data_item`).
type TargetIntegerInhabitanceBound
  = BoundUnspecified
  | StaticBoundFact(IntInterval)
  // Target-side kind witness mirroring `BoundDeclaration::PlatformDependent`
  // (`design-emission-model.md` §Q1): platform-sized integers (`usize`, Go `int`, …)
  // use this variant instead of widening `StaticBoundFact` intervals.
  | PlatformDependentFact

type FieldBinding {
  dag_name: String
  access: FieldAccess
  borrowed_read: Bool
}

// 🟢 TERMINAL. Two-way split of field access shapes a target language
// can offer: direct field access (`x.field`) vs an accessor method
// call (`x.field()` in Java-style getters, or method-style projection
// in Rust where the carrier type exposes the field via a fn). Each
// variant carries the rendered carrier string. Durable because
// targets really do split this way.
type FieldAccess
  = DirectField(String)
  | AccessorMethod(String)

type OperatorRealization {
  language: DeclarationRef
  target: DeclarationRef
  op: DeclarationRef
  carrier: String
  cost: Int
}

type BehaviorRealization {
  language: DeclarationRef
  target: DeclarationRef
  carrier: String
  cost: Int
}

type CallableRealization {
  language: DeclarationRef
  target: DeclarationRef
  strategy: CallableStrategy
  parameters: List<CallableParameter>
  cost: Int
}

// 🟢 TERMINAL. One entry per Arrow input slot, keyed by `slot` so
// arity and order drift become representable as a build-time error
// rather than a silent positional default. Validation: every slot
// in [0, arity) must appear exactly once. Replaces the bare
// `List<ParameterDisposition>` shape, which silently defaulted to
// Borrowed when the spec list was shorter than the callable's
// declared input arity.
type CallableParameter {
  slot: Int
  disposition: ParameterDisposition
}

// 🟢 TERMINAL. Per-parameter ownership classification. Borrowed
// means the callee reads the value and returns ownership to the
// caller; Consumed means the callee takes ownership. This is the
// primary fact ownership-rendering-design.md proposes for replacing
// downstream rendering enums (ReadStrategy/ConstructStrategy) with
// derivations. Durable because every memory-managed target has
// to make this distinction at every callable boundary.
type ParameterDisposition
  = Borrowed
  | Consumed

// 🟢 TERMINAL at string-family diagnostic-ordering axis scope. Ownership is a
// target-row property for string-family candidates, distinct from callable
// `ParameterDisposition`: it classifies the candidate carrier itself, not how a
// callee receives one argument. Rows land in target specs later; this slice
// only provides canonical structural values so consumers do not normalize
// strings locally.
type StringOwnershipAxis
  = Owned
  | Borrowed

// 🟢 TERMINAL at string-family diagnostic-ordering axis scope. These are the R2
// lifetime roles shared by lifetime analyzer facts and future target rows.
// `SelfContained` avoids leaking Rust's `Self_` identifier escaping into the
// substrate vocabulary; `Caller` names the call-frame-bounded role.
type StringLifetimeAxis
  = SelfContained
  | Caller

// 🟢 TERMINAL at string-family diagnostic-ordering axis scope. `NotApplicable`
// is an explicit value, not absence: borrowed candidates and returns can say
// the growability axis does not apply without becoming unknown.
type StringGrowabilityAxis
  = Growable
  | Fixed
  | NotApplicable

// 🟢 TERMINAL at R2 string-family encoding scope. The design-doc correction
// makes `.dag` `String` the `FreeMonoid<Char>` family; this value names the
// UTF-8 target-row semantics consumed by the analyzer/fold bridge. Additional
// byte or target-specific encodings belong in later LanguageSpec rows.
type StringEncodingAxis
  = Utf8FreeMonoidChar

// 🟡 SCAFFOLD. LanguageSpec-owned sibling carrier for string-family
// diagnostic-ordering rows. The row keeps the #1465 axis authority
// namespaced and structural: each field references the canonical axis
// declaration by `DeclarationRef`, and `language` points at the owning
// `LanguageSpec` declaration. Dissolves when the follow-on row-population
// declaration lands beside this carrier and a Grounding projection reader
// consumes `StringFamilyInhabitanceRow` from `LanguageSpec` without a local
// bridge. Until then, this carrier only establishes the substrate home.
type StringFamilyInhabitanceRow {
  language: DeclarationRef
  target_type: DeclarationRef
  type_realization: DeclarationRef
  ownership: DeclarationRef
  lifetime: DeclarationRef
  growability: DeclarationRef
  encoding: DeclarationRef
}

type TypeInstantiationRealization {
  language: DeclarationRef
  target: DeclarationRef
  carrier: String
  cost: Int
}

// Dissolution receipt — 🟡 mixed lifecycle. These variants are the staged target
// callable-emission strategies that still live in host emitters while `.dag`
// emission remains partly in Rust. They dissolve when `emit.dag` owns callable
// lowering directly from the target-language facts; until then, the strategy tag
// is the single authority for how a std callable lowers into target syntax.
type CallableStrategy
  = ListEmpty
  | ListSingleton
  | ListCons
  | ListConcat
  | ListLength
  | ListIsEmpty
  | ListFold
  | ListMap
  | ListFilter
  | ListContains

// Dissolution receipt — 🟡 mixed lifecycle. `PatternRealization` is a staged
// carrier for structural-match lowering onto realized target carriers such as
// `List<T> -> Vec<T>` or `[]T`. The terminal target is the same authority
// expressed as target-language facts consumed by `.dag` emission; this record
// remains the single authority until that stage lands.
//
// **Pattern-role authority (Stage 1e.0):** `strategy` names which lowering
// recipe applies (`VectorList` today). Emitters validate it fail-closed at
// index build and **do not** branch on it when rendering — the role is fully
// expressed by the spec data item (templates + target ref); rendering follows
// that bundle alone.
//
// **Variant-role refs:** `empty_variant` / `cons_variant` name which variant
// of `target`'s Disj plays each role (e.g., `List.Empty` / `List.Cons`).
// Dotted-path lowering walks Disj variants to resolve them. Moving role
// identity into spec data is the single-authority handoff — emitters no
// longer match variant labels by string.
//
// **Shape constraint not expressible in substrate grammar:** a bare
// `DeclarationRef` admits any declaration, so the type alone does not reject
// `empty_variant: Int` under `target: List`. The constraint "must be a
// variant of `target`'s Disj" is enforced at the emitter-binding parse
// boundary — `validate_pattern_roles` in each of `emit/rust_target.rs`,
// `emit/python_target.rs`, and `emit.rs` rejects role refs that are not
// variants of `target`, not distinct from each other, or where `target`
// itself does not resolve to a Disj. Fail-closed: malformed spec surfaces
// `MalformedRealization` at load time, not silent wrong output at render
// time. The terminal resting place is a substrate where variant-of-sum can
// be expressed structurally (refined `DeclarationRef<VariantOf<T>>`, or
// similar), which dissolves the boundary check into a type-level fact.
type PatternRealization {
  language: DeclarationRef
  target: DeclarationRef
  strategy: PatternStrategy
  empty_variant: DeclarationRef
  cons_variant: DeclarationRef
  scrutinee: String
  empty_pattern: String
  cons_pattern: String
  head_expr: String
  tail_expr: String
  cost: Int
}

// List-pattern role tag — single authority lives in each target's
// `data <target>_list_pattern: PatternRealization` in `spec/*.dag`.
// Emitters map validated records to emission without per-role `match` arms.
//
// `PlaceholderPatternStrategy` keeps the coproduct non-singleton (substrate
// discipline: avoid a one-variant sum) until a second real role lands; it
// then dissolves in favor of that role (e.g. tuple-list lowering).
type PatternStrategy
  = PlaceholderPatternStrategy
  | VectorList

type StatementSyntax {
  let_binding: String
  let_binding_inferred: String
}

type ExpressionSyntax {
  field_access: String
  function_call: String
  closure: String
}

type ForEachSyntax {
  prefix: String
  separator: String
}

type ControlFlowSyntax {
  if_else: String
  match_arm: String
  for_each_syntax: ForEachSyntax
}

type LiteralSyntax {
  true_keyword: String
  false_keyword: String
  string_delimiter: String
}

type ModuleSyntax {
  path_separator: String
}

type FunctionSyntax {
  definition: String
  definition_exported: String
  definition_void: String
  param_with_type: String
  param_separator: String
}

type TypeApplicationSyntax {
  optional: String
}

// Shared `LanguageSpec.type_definitions` shape — every target instantiates this
// conj. `LanguageSpec.record_derive_templates` points at
// `RecordDeriveTemplateBundle` (per-target `data` in `*_spec/*.dag`).
type TypeDefinitionSyntax {
  struct_def: String
  struct_field: String
  enum_def: String
  enum_unit_variant: String
  enum_data_variant: String
}

// Target-neutral string templates for emitting a user `struct` / `enum` when a
// full `Debug` (or other) derive set cannot be used — e.g. first-class
// `fn` storage fields (Rust: `Rc<dyn Fn…>`). **Only `emit_rust` consumes
// this today**; Go/Python `*_record_derive_templates` are empty
// `RecordDeriveTemplateBundle` `data` rows that **inhabit** the shared
// `LanguageSpec` Conj (same P2 single-shape rule as `type_definitions`: every
// target’s `*_language` must be structurally complete) — those emitters
// do not read the strings until they implement the policy.
// See TODO(dissolve) and `INVARIANTS.md#e-6` (boundary / unconsumed data).
type RecordDeriveTemplateBundle {
  struct_def_no_debug: String
  enum_def_no_debug: String
}
// TODO(dissolve, #676 / P2) — **named + bounded**:
// - **Retire** in the PR that does either: (A) a substrate `derive` / repr
//   authority exists and the Rust record emitter reads only that (delete these
//   ad hoc strings and this conj field as redundant), or (B) `emit_go` or
//   `emit_python` is wired to read `LanguageSpec.record_derive_templates` with
//   real templates so the empty P2 `data` rows for that field are not the
//   long-term story. **Done** when the bridge has a single read authority for
//   Rust and no target relies on inert cross-target `data` placeholders.
// - **Until then:** empty Go/Python `data` only inhabit the shared `LanguageSpec`
//   Conj; see E-6 above.

type PatternMatchSyntax {
  match_expr: String
  match_arm: String
  variant_pattern: String
  variant_pattern_positional: String
  variant_pattern_empty: String
  field_binding: String
  field_binding_separator: String
  wildcard: String
}

type CollectionOps {
  // Realizations of `FreeMonoid<T>.concat` / `length` / `is_empty` / `fold` and
  // the Rust higher-order quartet — each `DeclarationRef` points at a
  // `MethodTemplateContract` value (same carrier as per-target
  // `*_method_template_contracts` rows). Template strings live only on those
  // contracts; these fields are identity, not render data.
  concat_contract: DeclarationRef
  length_contract: DeclarationRef
  // `FreeMonoid<T>.is_empty` — `dag_method` is `is_empty_method`; templates carry target sugar.
  is_empty_contract: DeclarationRef
  fold_contract: DeclarationRef
  filter_contract: DeclarationRef
  flat_map_contract: DeclarationRef
  any_contract: DeclarationRef
  all_contract: DeclarationRef
  map_contract: DeclarationRef
  // Legacy literal fields remain for targets/render paths not yet migrated to
  // `MethodTemplateContract` references. Rust filter now consumes
  // `filter_contract`'s `HigherOrderTemplates.inline_template`.
  // Dissolution trigger: delete these legacy collection render literals once
  // all CollectionOps render paths select templates through contract refs.
  filter: String
  contains: String
  empty_list: String
  list_literal: String
  cons: String
}

type ValueConstructionSyntax {
  struct_literal: String
  struct_field_init: String
  struct_field_separator: String
  variant_construction: String
  variant_named_construction: String
}

type RenderingModel {
  read: ReadStrategy
  construct: ConstructStrategy
}

// 🟡 SCAFFOLD. Per-target read strategy: Borrow renders `&T`-style
// references; PassByValue renders owned values. Lives here because
// the current emitter dispatches on a target-level rendering tag.
// Dissolution path: ownership-rendering-design.md proposes deriving
// per-edge read mode from MemoryModel × ParameterDisposition × the
// edge's use-site classification (Read vs Construct). Once that
// derivation lands, RenderingModel.read goes away — this enum
// dissolves with it.
type ReadStrategy
  = Borrow
  | PassByValue

// 🟡 SCAFFOLD. Per-target construction strategy: CopyOrClone renders
// `.clone()`-style duplication on Conj construction; PassByValue
// renders direct value moves. Same dissolution path as ReadStrategy
// — replaced by per-edge derivation from MemoryModel ×
// ParameterDisposition.
type ConstructStrategy
  = CopyOrClone
  | PassByValue

type LanguageSpec {
  statements: DeclarationRef
  expressions: DeclarationRef
  control_flow: DeclarationRef
  literals: DeclarationRef
  modules: DeclarationRef
  functions: DeclarationRef
  type_applications: DeclarationRef
  type_definitions: DeclarationRef
  // P2: see `RecordDeriveTemplateBundle` TODO(dissolve) in this file; empty
  // `data` in non-Rust specs inhabit the Conj only (E-6).
  record_derive_templates: DeclarationRef
  patterns: DeclarationRef
  collection_ops: DeclarationRef
  values: DeclarationRef
}

// Placeholder convention for method-template render strings.
//
// `IndexedArgs` — positional placeholders `{arg0}`, `{arg1}`, … as used by
// `dsl/extdeps/languages/{rust,python,go}/runtime.dag` `MethodTranslation`
// rows.
// `NamedArg` — single `{arg}` placeholder as used by Rust `emit.dag`
// `SimpleMethodSpec` and Python/Go `emit.dag` template maps.
//
// The receiver placeholder `{recv}` is common to both conventions and lives
// outside this axis.
//
// 🟡 SCAFFOLD coproduct. Pattern 1 (per-call template typing) fails because
// today's templates are opaque `String` values whose placeholder dialect is
// observable only by string inspection — there is no upstream type-system
// fact distinguishing `{arg0}/{arg1}` indexed slots from a single named
// `{arg}` slot. Pattern 2 (collapse to a single labeled record) erases the
// closed semantic split that consumers actually dispatch on. Pattern 3 is
// the dissolution path: when method-template substrate parses templates
// into structured slot facts (a typed `List<TemplateSegment>` with arity
// and slot-kind known structurally), this convention tag derives from
// segment shape and the named coproduct retires. Trigger: structured
// template-segment substrate in a follow-up substrate-completion lane.
// Until then this scaffold is the single declared authority for the
// dialect axis.
type PlaceholderConvention
  = IndexedArgs
  | NamedArg

// 🟢 TERMINAL at target method-emission-template scope. Method emit
// templates split structurally between ordinary single-expression
// renderings and higher-order method renderings that must preserve two
// target-specific templates: an inline-lambda body template and a
// function-reference adapter template. The row-level `wraps_result`
// remains the single wrapping authority for both cases; the higher-order
// variant intentionally does not carry a second wrapping bit. Pattern 1
// (merge into optional fields on `MethodTemplateContract`) fails because
// the two-template shape is a closed semantic case, not sparse data on
// every row. Pattern 2 (sibling carrier) fails because it would split the
// single per-method emit-template authority across parallel row lists.
// Pattern 3 (collapse into one string) would lose the inline-vs-fn-ref
// distinction carried by Rust's legacy `HigherOrderMethodSpec`. No
// dissolution trigger: later targets can attach to one of these durable
// cases, and any richer typed template-segment substrate refines inside
// the variant payloads rather than replacing the coproduct.
type MethodEmitTemplate
  = SingleTemplate { template: String }
  | HigherOrderTemplates {
      inline_template: String
      fn_ref_template: String
    }

// Per-target, per-method template contract. Sibling carrier to §6a
// `MethodContract` in `src/v3/std/algebra.dag` — that one carries
// target-agnostic cost/complexity metadata keyed by
// `(algebra_id, method_id)`; this one carries target-specific render
// templates keyed by `dag_method`. The two are orthogonal sibling facts
// attached to method declarations; neither is a parent or child of the
// other (P1 step 1).
//
// Single template-contract fact per row — no cost/complexity fields
// (P1 step 2). Per-target identity is carried by the containing
// `data <target>_method_template_contracts: List<MethodTemplateContract>`
// list authority, not duplicated on the row (P2 single-authority).
//
// `dag_method: MethodRef` (refined from bare `DeclarationRef` per the
// #1175 substrate gap). `MethodRef` (`src/v3/std/methods.dag`) wraps a
// `DeclarationRef` whose target is a `MethodDeclaration` data binding
// in `dsl/std/methods.dag` — the method-name registry that pins
// stable identity for the 63 unique method names carried by the
// `dsl/std/algebra.dag` per-profile template lists. The bare-
// `DeclarationRef` admits-anything residual is now bounded by the
// `MethodRef` wrapper; the inner `decl` still admits any declaration
// at the type level (same residual class as `PatternRealization`
// `empty_variant` / `cons_variant` at lines 140–152), with the
// resolution check enforced fail-closed at the boundary until
// substrate-level refinement-typing-on-DeclarationRef lowers.
//
// 🟡 TRANSITIONAL. This carrier consolidates the parallel-rep ×3 between
// `MethodTranslation` (`runtime.dag`) and `SimpleMethodSpec` (`emit.dag`)
// across Rust/Python/Go. Row population and old-carrier retirement are
// Grounding-owned and land in follow-up work.
type MethodTemplateContract {
  dag_method: MethodRef
  runtime_template: String
  emit_template: MethodEmitTemplate
  wraps_result: Bool
  placeholder_convention: PlaceholderConvention
}
