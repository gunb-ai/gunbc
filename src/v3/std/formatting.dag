// std.formatting -- string templating and primitive string conversions.
//
// String itself remains `FreeMonoid<Char>` (see `std.string_type`). This
// module declares the formatting functions that target realizations consume
// when user-authored `.dag` code needs to construct strings from typed values.

module std.formatting

import std.list { List }
import std.types { Int, Char, Bool }
import std.error_primitives { Result }

// Closed error carrier for indexed template substitution. The grammar is
// shared across target realizations: a placeholder starts with ASCII `{`,
// contains one or more ASCII decimal digits `0` through `9`, and ends with
// ASCII `}`. Every other character, including non-ASCII text, is copied as a
// literal string character.
type FormatError
  = PlaceholderRequiresExplicitIndex
  | PlaceholderMissingClosingBrace
  | PlaceholderIndexOutOfBounds

// Indexed templating over string arguments. Placeholders use the closed
// decimal index shape `{0}`, `{1}`, ... so the function's arity is carried by
// the `args` list rather than by a target-language macro.
fn format(template: String, args: List<String>) -> Result<String, FormatError> {
  host format
}

// Explicit primitive conversions keep format type-safe: callers convert
// structured values to String before entering the string-argument list.
fn int_to_string(value: Int) -> String {
  host int_to_string
}

fn char_to_string(value: Char) -> String {
  host char_to_string
}

fn bool_to_string(value: Bool) -> String {
  host bool_to_string
}
