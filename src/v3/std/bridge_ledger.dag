module v3.std.bridge_ledger

import std.list { List }
import v3.spec.v3_l1 { DeclarationRef }

// T-Verification-BridgeLedger — substrate ledger for bridge-retirement
// rows that the `BridgeLedgerZero` `.dag` `TestClaim` (Verification-owned)
// folds. **This file is the substrate authority** for the rows + their
// retirement status; no parallel Rust `Vec` or test-side table.
//
// `docs/r3-structure.md:79-83` is the prose taxonomy that names these
// five bridges and gives lane-level context, but it is not the
// authority for the row's *status*: the per-row `authority` field
// below points at the concrete code/PR ratchet that establishes each
// row's `Retired` / `Open` verdict. When a row's authority pointer
// reports zero residual, the row flips to `Retired`; the prose doc
// updates downstream as a narrative derivation. The meta row
// `bridge_retirement_ledger_zero` from `r3-structure.md:84` is the
// Verification-side fold's verdict, not a row in the ledger; it
// reads THIS list and reports zero-residual against the `Open`
// predicate.
//
// **Status discipline.** `BridgeStatus` is a closed coproduct, not a
// stringly enum: every row's status is `Retired` or `Open` by
// construction, so the Verification fold is a structural partition, not
// a name-matching parser. New retirement states (e.g. partial /
// in-progress) require an explicit substrate amendment that lands here
// before the fold can read them — same modeling-discipline shape as
// other closed-coproduct status surfaces in `std`.
//
// **Per-row status rationale (current state @ HEAD):**
//   - `bridge_source_span_file_participation_retired` — Open. Per
//     `r3-structure.md:79`: "the gate is not satisfied; partial
//     string-check retirement was rejected because parallel
//     participation rules would remain." Concrete prerequisites cited
//     (module/compilation-unit identity for lens reflection; typed
//     authority/emit-scope carriers for lower/emit; lens-fold file-path
//     semantics in ROADMAP).
//   - `bridge_mark_bootstrap_secret_nominal_opacity_retired` — Retired.
//     Per `r3-structure.md:80`: "name-keyed bootstrap bridge from #937
//     deleted; nominal-opacity authority lives in source-level
//     declaration (PR A landed in R2)."
//   - `bridge_canonical_lens_name_dispatch_pr1183_slice_retired` —
//     Retired. Narrow PR #1183 slice: lens dispatch routes via
//     `DeclarationRef`/typed identity; ratcheted by
//     `canonical_lens_bridge_ratchet_test.rs`.
//   - `bridge_canonical_lens_name_patching_residual` — Open. Broader
//     exact-string canonical-lens-name class remains live in
//     `test_runner.rs` (`include_str!`, name arms, and generic
//     name-keyed lookups); full retirement waits for PB-Runtime
//     interpreter-as-data or a typed lens-registry carrier.
//   - `bridge_include_str_side_channels_retired` — Retired for the
//     pipeline-authority slice. The active `pipeline.dag` compile-time
//     source embed under `src/v3/compiler/` has been replaced by a
//     structural bootstrap witness over `PipelineStageBinding`, and the
//     integration ratchet forbids reintroducing `include_str!` of
//     `pipeline.dag` under the compiler crate. `fn compile` still
//     lowers as `ArrowBody::Unparsed`; the retired row therefore means
//     no source-text side channel remains for this authority path, not
//     that compile-body drift is structurally checkable.
//   - `bridge_exact_string_patching_residual_retired` — Open. Per
//     `r3-structure.md:83`: PB lower-helper slice (Tier-2 / #1014
//     lineage) is pinned at zero, BUT "Other exact-string patching
//     classes (outside this retired lower-helper post-process bridge)
//     remain out of scope for this receipt and keep their own
//     dissolution triggers" — the umbrella row stays Open until those
//     other classes land their own retirement receipts.

// 🟢 TERMINAL. Closed retirement-state coproduct for ledger rows. Two
// states are sufficient at this scope: a bridge has either landed its
// retirement receipt (`Retired`) or it has not (`Open`). Partial /
// in-progress states are deliberately not modeled here — the doc
// authority's "open with prerequisites" framing collapses to `Open`
// because the predicate the Verification fold cares about ("is this
// bridge fully retired?") is the binary condition, and richer state
// would invite drift between row-level and predicate-level semantics.
// Adding states later requires an explicit substrate amendment.
type BridgeStatus
  = Retired
  | Open

// 🟡 TRANSITIONAL at PR-α scope. Typed wrapper around `DeclarationRef`
// whose target is the canonical `bridge_ledger` declaration in this
// file. Mirrors `MethodRef` (`src/v3/std/methods.dag:31`) /
// `CallableRef` (`src/v3/std/services.dag:98`) — same wrapper
// discipline, same #1175 substrate-gap classification: the inner
// `decl` still admits any `DeclarationRef` at the type level
// (refinement-typing on `DeclarationRef` has not landed), with the
// canonical-identity check enforced fail-closed at the runner /
// claim-load boundary in `eval_bridge_ledger_zero` (see
// `src/v3/compiler/src/test_runner.rs`). The named wrapper makes the
// ledger-target intent structural at the field-type level instead
// of leaving it as an inline comment on a bare `DeclarationRef` in
// `TestPredicate::BridgeLedgerZero`. Dissolution trigger: the same
// #1175 refinement-typing landing that retires `MethodRef` /
// `CallableRef` retires this wrapper.
type BridgeLedgerRef {
  decl: DeclarationRef
}

// 🟢 TERMINAL at PR-α scope. Single ledger row. Field set matches the
// dispatch contract `{ name, owner, status, authority }`:
//   - `name`: stable identifier matching `r3-structure.md`'s row name.
//   - `owner`: the lane/manager responsible for the row's retirement
//     (e.g. `R3`, `R2-Substrate`, `pipeline_authority`).
//   - `status`: the closed `BridgeStatus` coproduct above.
//   - `authority`: pointer at the canonical record of the row's status
//     (typically a `docs/r3-structure.md` heading anchor or PR
//     reference); the Verification fold treats this as opaque
//     provenance metadata, not a parseable URL.
type BridgeLedgerRow {
  name:      String
  owner:     String
  status:    BridgeStatus
  authority: String
}

// Canonical bridge-retirement rows. Authoring order follows
// `docs/r3-structure.md:79-83`; split rows enumerate sub-classes when
// one prose bridge has both a retired slice and a remaining residual.
// Per-row `authority` points at the
// concrete ratchet (test, PR, gating doc-anchor) that establishes
// the row's status — not a generic taxonomy heading. Status flips
// from `Open` to `Retired` are gated on the named ratchet reaching
// zero residual.
data bridge_ledger: List<BridgeLedgerRow> = [
  {
    name:      "bridge_source_span_file_participation_retired",
    owner:     "R3",
    status:    Open,
    authority: "ROADMAP.md#lens-fold-file-path-semantics"
  },
  {
    name:      "bridge_mark_bootstrap_secret_nominal_opacity_retired",
    owner:     "R2-Substrate",
    status:    Retired,
    authority: "PR #937"
  },
  {
    name:      "bridge_canonical_lens_name_dispatch_pr1183_slice_retired",
    owner:     "R2-Substrate",
    status:    Retired,
    authority: "src/v3/compiler/tests/integration/canonical_lens_bridge_ratchet_test.rs"
  },
  {
    name:      "bridge_canonical_lens_name_patching_residual",
    owner:     "PB-Runtime",
    status:    Open,
    authority: "docs/briefs/r2-pb-canonical-lens-bridge-disposition.md"
  },
  {
    name:      "bridge_include_str_side_channels_retired",
    owner:     "pipeline_authority",
    status:    Retired,
    authority: "src/v3/compiler/tests/integration/l1_5_fixed_point_test.rs"
  },
  {
    name:      "bridge_exact_string_patching_residual_retired",
    owner:     "PB-Tier-2",
    status:    Open,
    // Umbrella row — `bridge_lower_helpers_patch_zero_residual_test.rs`
    // ratchets only the retired sub-slice (PR #1014 lineage); the row
    // stays Open because *other* exact-string patching classes remain
    // outside that receipt's scope. Point `authority` at the prose
    // row where the umbrella's open-scope framing is defined,
    // not at the closed sub-slice's ratchet (the residual debt the
    // open status tracks is exactly the "other classes" the prose
    // row names — those classes' own dissolution triggers cover the
    // remaining scope, and the umbrella retires when those triggers
    // all fire).
    authority: "docs/r3-structure.md:83"
  }
]
