// v3.std.approximate_field - typed axes + parametric carrier for approximate reals.
//
// Authority: docs/design-numeric-construction.md §5 and
// docs/audit/t-numeric-construction-approximate-field-6q.md (slice plan).
//
// Landed axes precursor (#1427): rounding / precision / special-value policy
// terminals. **Carrier slice (this file):** `SpecialValues` + `ApproximateField<F>`
// per 6Q §“Recommended substrate shape” — still **no** `Real` alias, Float
// migration, target mirrors, or tolerance/equivalence behavior.
//
// **Real alias gate:** `docs/audit/t-numeric-construction-approximate-field-real-parameter-stop.md`
// — `Rational` (#1508) names `Field<FieldOfFractions<Int>>`, so `F` in
// `ApproximateField<F>` / `base: Field<F>` cannot honestly be spelled `Rational`
// without a design convention fix (carrier vs witness naming).

module v3.std.approximate_field

import std.algebra { Field }
import std.integer { PositiveInt }

// 🟢 TERMINAL at approximate-arithmetic policy scope. Rounding behavior is a
// program-visible fact, and these modes are the durable closed policy axis;
// target groundings cannot smuggle policy through strings or defaults.
type RoundingMode
  = ToNearestEven
  | ToZero
  | ToPositiveInfinity
  | ToNegativeInfinity
  | ToAwayFromZero

// 🟢 TERMINAL at precision-axis scope. Precision is structural, not a
// target-name tag like "f64". Binary precision names significand and exponent
// width separately; total IEEE width alone is too compressed for later
// grounding and equivalence policy.
type Precision
  = Unbounded
  | BinaryPrecision { significand_bits: PositiveInt, exponent_bits: PositiveInt }
  | DecimalPrecision { digits: PositiveInt, exponent_digits: PositiveInt }

// 🟢 TERMINAL at special-value policy scope. NaN support is an independent
// closed policy axis; `ApproximateField<F>` aggregates it through `SpecialValues`
// without adding policy vocabulary beyond these terminals.
type NanPolicy = NoNaN | QuietNaN | QuietAndSignalingNaN

// 🟢 TERMINAL at special-value policy scope. Infinity support is an independent
// closed policy axis; `ApproximateField<F>` aggregates it through `SpecialValues`
// without adding policy vocabulary beyond these terminals.
type InfinityPolicy = NoInfinity | SignedInfinity

// 🟢 TERMINAL at special-value policy scope. Signed-zero support is an
// independent closed policy axis; `ApproximateField<F>` aggregates it through
// `SpecialValues` without adding policy vocabulary beyond these terminals.
type SignedZeroPolicy = NoSignedZero | SignedZero

// 🟢 TERMINAL at subnormal/denormal policy scope. Underflow behavior is an
// independent closed policy axis; `ApproximateField<F>` carries it as
// `subnormal_policy` — separate from `SpecialValues` per 6Q (denormal policy
// is underflow semantics, not merely “admits subnormals”).
type SubnormalPolicy = NoSubnormals | GradualUnderflow | FlushToZero

// Closed record aggregating the three orthogonal special-value policy axes (NaN,
// infinity, signed zero). Subnormal/denormal policy stays a separate field on
// `ApproximateField<F>` per 6Q — it affects underflow behavior, not merely
// presence of exceptional values.
type SpecialValues {
  nan: NanPolicy
  infinity: InfinityPolicy
  signed_zero: SignedZeroPolicy
}

// Approximate field over an **exact** field algebra `Field<F>` where `F` is the
// same carrier type parameter as in `dsl/std/algebra.dag`'s `Field<T>`.
//
// Observable approximation policies are structural (no target-string tags).
type ApproximateField<F> {
  base: Field<F>
  rounding: RoundingMode
  precision: Precision
  special_values: SpecialValues
  subnormal_policy: SubnormalPolicy
}
