// v3.std.approximate_field - typed axes for approximate real arithmetic.
//
// Authority: docs/design-numeric-construction.md section 5 and
// docs/audit/t-numeric-construction-approximate-field-6q.md. This file lands
// only the independent axes precursor. The `ApproximateField<F>` carrier,
// `SpecialValues` record, `Real = ApproximateField<Rational>` alias, Float
// migration, target mirrors, and tolerance/equivalence behavior land in later
// slices.

module v3.std.approximate_field

import std.types { PositiveInt }

// 🟢 TERMINAL at approximate-arithmetic policy scope. Rounding behavior is a
// program-visible fact, and these modes are the durable closed policy axis;
// target groundings cannot smuggle policy through strings or defaults.
type RoundingMode
  = ToNearestEven
  | ToZero
  | ToPositiveInfinity
  | ToNegativeInfinity
  | ToAwayFromZero

// 🟢 TERMINAL at precision-axis scope. Precision is structural, not a
// target-name tag like "f64". Binary precision names significand and exponent
// width separately; total IEEE width alone is too compressed for later
// grounding and equivalence policy.
type Precision
  = Unbounded
  | BinaryPrecision { significand_bits: PositiveInt, exponent_bits: PositiveInt }
  | DecimalPrecision { digits: PositiveInt, exponent_digits: PositiveInt }

// 🟢 TERMINAL at special-value policy scope. NaN support is an independent
// closed policy axis; the later carrier slice can aggregate it without adding
// new policy vocabulary.
type NanPolicy = NoNaN | QuietNaN | QuietAndSignalingNaN

// 🟢 TERMINAL at special-value policy scope. Infinity support is an independent
// closed policy axis; the later carrier slice can aggregate it without adding
// new policy vocabulary.
type InfinityPolicy = NoInfinity | SignedInfinity

// 🟢 TERMINAL at special-value policy scope. Signed-zero support is an
// independent closed policy axis; the later carrier slice can aggregate it
// without adding new policy vocabulary.
type SignedZeroPolicy = NoSignedZero | SignedZero

// 🟢 TERMINAL at subnormal/denormal policy scope. Underflow behavior is an
// independent closed policy axis; the later carrier slice can aggregate it
// without adding new policy vocabulary.
type SubnormalPolicy = NoSubnormals | GradualUnderflow | FlushToZero
