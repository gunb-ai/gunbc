// v3.std.python_method_template_contracts -- per-method render-template
// rows for the Python target. See sibling
// `rust_method_template_contracts.dag` for the full scope / authority /
// home / convention notes.
//
// PYTHON-SPECIFIC NOTES:
//   - The legacy emit authority (`python_method_templates: Map<String, String>`
//     in `dsl/extdeps/languages/python/emit.dag`) does not carry
//     `wraps_result`. Per Q4 four-property gate, every row's
//     `wraps_result` is structurally `false` for Python — declared
//     explicitly here, NOT silently inherited from Rust.
//   - `string_contains` is now classified as a target-only emit-shortcut
//     name in `dsl/std/methods.dag` (#1549 Gap 1 / R3 dispatch on parent
//     inbox #1130). The row below references `string_contains_method`
//     and renders Python's `{arg} in {recv}` for the substring shape;
//     this is structurally distinct from algebra `contains` (collection
//     membership) which is not currently rendered through this list.
//   - `{arg0}` → `{arg}` rewrite applied to runtime templates (`join`,
//     `split`); rows use `placeholder_convention: NamedArg` uniformly.
//   - Methods present only in `python_method_templates` (map,
//     filter, any, all, flat_map, skip, take, sort_by, append)
//     use the emit template for both row sides — v2's actual behavior
//     is "python_method_templates for both consumption sites" since
//     `collection_method_translations` doesn't declare them.
//     `concat` / `fold` are **not** listed here — LanguageSpec
//     `CollectionOps.{concat,fold}_contract` carries named
//     `MethodTemplateContract` rows (`python_language_spec_free_monoid_*`)
//     so we do not duplicate `dag_method: concat_method` / `fold_method`
//     inside this list (P2 single authority; mirrors Rust + fold).

module v3.std.python_method_template_contracts

import v3.std.emit_model {
  MethodTemplateContract,
  PlaceholderConvention,
  NamedArg,
  SingleTemplate
}
import v3.std.methods { MethodRef }
import std.methods {
  count_method,
  join_method,
  split_method,
  last_method,
  first_method,
  enumerate_method,
  chars_method,
  concat_method,
  map_method,
  filter_method,
  any_method,
  all_method,
  flat_map_method,
  skip_method,
  take_method,
  fold_method,
  is_empty_method,
  length_method,
  sort_by_method,
  append_method,
  string_contains_method
}

// LanguageSpec `CollectionOps.{concat,length,is_empty}_contract` carriers live outside
// `python_method_template_contracts` below (same fold pattern — list rows are a different authority).
//
// **P2 single authority** for `concat_method`: `CollectionOps.concat_contract` uses
// `{left}` / `{right}` (monoid concat). It does **not** repeat inside the list below —
// that row used `{recv} + {arg}` (different placeholder shape), a second parallel contract
// for the same registry method.

data python_language_spec_free_monoid_concat_contract: MethodTemplateContract = {
  dag_method: { decl: concat_method },
  runtime_template: "[*{left}, *{right}]",
  emit_template: SingleTemplate { template: "[*{left}, *{right}]" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data python_language_spec_free_monoid_length_contract: MethodTemplateContract = {
  dag_method: { decl: length_method },
  runtime_template: "len({recv})",
  emit_template: SingleTemplate { template: "len({recv})" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

// Emptiness — `dag_method` is `is_empty_method` (`FreeMonoid<T>.is_empty`); template is Python sugar.
data python_language_spec_free_monoid_emptiness_contract: MethodTemplateContract = {
  dag_method: { decl: is_empty_method },
  runtime_template: "(len({recv}) == 0)",
  emit_template: SingleTemplate { template: "(len({recv}) == 0)" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

// **P2 single authority** for `fold_method` on the Python target: LanguageSpec
// `CollectionOps.fold_contract` (`{recv}`, `{init}`, `{body}` → `__v3_fold`).
// Does **not** repeat inside `python_method_template_contracts` below — the prior
// list row used `functools.reduce({arg}, {recv})` (different shape); see
// `docs/briefs/collectionops-algebra-reframe.md`.
data python_language_spec_free_monoid_fold_contract: MethodTemplateContract = {
  dag_method: { decl: fold_method },
  runtime_template: "__v3_fold({recv}, {init}, {body})",
  emit_template: SingleTemplate { template: "__v3_fold({recv}, {init}, {body})" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

// LanguageSpec `CollectionOps.map_contract` — comprehension shape `{body}` / `{item}` / `{recv}`
// (distinct from the list-row `map_method` template `[{arg}(x) for x in {recv}]`).
data python_language_spec_map_contract: MethodTemplateContract = {
  dag_method: { decl: map_method },
  runtime_template: "[{body} for {item} in {recv}]",
  emit_template: SingleTemplate { template: "[{body} for {item} in {recv}]" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data python_filter_method_template_contract: MethodTemplateContract = {
  dag_method: { decl: filter_method },
  runtime_template: "[x for x in {recv} if {arg}(x)]",
  emit_template: SingleTemplate { template: "[x for x in {recv} if {arg}(x)]" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data python_any_method_template_contract: MethodTemplateContract = {
  dag_method: { decl: any_method },
  runtime_template: "any({arg}(x) for x in {recv})",
  emit_template: SingleTemplate { template: "any({arg}(x) for x in {recv})" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data python_all_method_template_contract: MethodTemplateContract = {
  dag_method: { decl: all_method },
  runtime_template: "all({arg}(x) for x in {recv})",
  emit_template: SingleTemplate { template: "all({arg}(x) for x in {recv})" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data python_flat_map_method_template_contract: MethodTemplateContract = {
  dag_method: { decl: flat_map_method },
  runtime_template: "[y for x in {recv} for y in {arg}(x)]",
  emit_template: SingleTemplate { template: "[y for x in {recv} for y in {arg}(x)]" },
  wraps_result: false,
  placeholder_convention: NamedArg
}

data python_method_template_contracts: List<MethodTemplateContract> = [
  {
    dag_method: { decl: count_method },
    runtime_template: "len({recv})",
    emit_template: SingleTemplate { template: "len({recv})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: join_method },
    runtime_template: "{arg}.join({recv})",
    emit_template: SingleTemplate { template: "{arg}.join({recv})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: split_method },
    runtime_template: "{recv}.split({arg})",
    emit_template: SingleTemplate { template: "{recv}.split({arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: last_method },
    runtime_template: "{recv}[-1] if {recv} else None",
    emit_template: SingleTemplate { template: "{recv}[-1] if {recv} else None" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: first_method },
    runtime_template: "{recv}[0] if {recv} else None",
    emit_template: SingleTemplate { template: "{recv}[0] if {recv} else None" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: enumerate_method },
    runtime_template: "list(enumerate({recv}))",
    emit_template: SingleTemplate { template: "list(enumerate({recv}))" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: chars_method },
    runtime_template: "[ord(c) for c in {recv}]",
    emit_template: SingleTemplate { template: "[ord(c) for c in {recv}]" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: map_method },
    runtime_template: "[{arg}(x) for x in {recv}]",
    emit_template: SingleTemplate { template: "[{arg}(x) for x in {recv}]" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  python_filter_method_template_contract,
  python_any_method_template_contract,
  python_all_method_template_contract,
  python_flat_map_method_template_contract,
  {
    dag_method: { decl: skip_method },
    runtime_template: "{recv}[{arg}:]",
    emit_template: SingleTemplate { template: "{recv}[{arg}:]" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: take_method },
    runtime_template: "{recv}[:{arg}]",
    emit_template: SingleTemplate { template: "{recv}[:{arg}]" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: sort_by_method },
    runtime_template: "sorted({recv}, key={arg})",
    emit_template: SingleTemplate { template: "sorted({recv}, key={arg})" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: append_method },
    runtime_template: "{recv} + [{arg}]",
    emit_template: SingleTemplate { template: "{recv} + [{arg}]" },
    wraps_result: false,
    placeholder_convention: NamedArg
  },
  {
    dag_method: { decl: string_contains_method },
    runtime_template: "{arg} in {recv}",
    emit_template: SingleTemplate { template: "{arg} in {recv}" },
    wraps_result: false,
    placeholder_convention: NamedArg
  }
]
