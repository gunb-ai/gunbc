module v3.spec

// *************************************************************************

// *************************************************************************

// LAYER 0: TRUTH + FINITENESS
type Classical = True | False
data max_inhabitants: Int = 9223372036854775807

// LAYER 1: FUNCTION

// LAYER 2: TYPE STRUCTURE

// LAYER 3: SELF-REFERENCE

// LAYER 4: THE GRAPH
type NodeId = Int
type Span { file: String, start: Int, end: Int }
type Node {
  id: NodeId
  span: Span
  edges: List<Edge>
}
type Edge {
  target: NodeId
  svr: SubValueRelation
}

// LAYER 5: EDGE VOCABULARY (SubValueRelation)
type ShrinkFactor
  = UnitShrink
  | ConstantShrink { amount: Int }
  | ProportionalShrink { divisor: Int }
type SubValueRelation
  = StrictSubValue { field: FieldRef, factor: ShrinkFactor }
  | IteratedSubValue { field: FieldRef }
  | ArithmeticDescent { param: ParamRef, factor: ShrinkFactor }
  | PreservedValue
  | Unknown
fn meet_svr(a: SubValueRelation, b: SubValueRelation) -> SubValueRelation {
  match a {
    Unknown => Unknown
    PreservedValue => match b {
      Unknown => Unknown
      _ => PreservedValue
    }
    _ => match b {
      Unknown => Unknown
      PreservedValue => PreservedValue
      _ => a
    }
  }
}
fn compose_svr(outer: SubValueRelation, inner: SubValueRelation) -> SubValueRelation {
  match outer {
    Unknown => Unknown
    PreservedValue => inner
    _ => match inner {
      Unknown => Unknown
      PreservedValue => outer
      _ => inner
    }
  }
}
type UsageEdge
  = Consumed
  | Read
  | Projected
  | Threaded
type FieldRef { type_id: NodeId, field_name: String }
type ParamRef { func_id: NodeId, index: Int }

// LAYER 6: DIMENSIONS
type BoundedLattice<T> {
  bottom: T
  top: T
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
}
type Dimension<T> {
  lattice: BoundedLattice<T>
  compute: fn(SubValueRelation, T) -> T
  enforce: fn(T, NodeId) -> Diagnostic?
}
type Diagnostic {
  span: Span
  message: String
  fix: SuggestedFix?
}
type SuggestedFix {
  description: String
  replacement: String
  span: Span
}

// --- Provenance (termination dimension) ---

// --- Ownership dimension ---
type OwnershipKind = Owned | Borrowed | Shared
fn ownership_meet(a: OwnershipKind, b: OwnershipKind) -> OwnershipKind {
  match a {
    Shared => Shared
    Borrowed => match b { Shared => Shared  _ => Borrowed }
    Owned => b
  }
}
fn ownership_from_svr(svr: SubValueRelation) -> OwnershipKind {
  match svr {
    StrictSubValue { field: _, factor: _ } => Borrowed
    IteratedSubValue { field: _ } => Owned
    ArithmeticDescent { param: _, factor: _ } => Owned
    PreservedValue => Owned
    Unknown => Shared
  }
}

// --- Effects dimension ---
type EffectLevel
  = Pure
  | ReadsLocal
  | WritesLocal
  | ReadsExternal
  | WritesExternal
fn effect_meet(a: EffectLevel, b: EffectLevel) -> EffectLevel {
  match a {
    WritesExternal => WritesExternal
    ReadsExternal => match b { WritesExternal => WritesExternal  _ => ReadsExternal }
    WritesLocal => match b { WritesExternal => WritesExternal  ReadsExternal => ReadsExternal  _ => WritesLocal }
    ReadsLocal => match b { Pure => ReadsLocal  _ => b }
    Pure => b
  }
}
type EffectShape
  = LatticeEffect
  | MonoidEffect
  | IdentityEffect
fn is_idempotent(shape: EffectShape) -> Bool {
  match shape { LatticeEffect => true  IdentityEffect => true  MonoidEffect => false }
}
fn compose_shapes(a: EffectShape, b: EffectShape) -> EffectShape {
  match a {
    MonoidEffect => MonoidEffect
    LatticeEffect => match b { MonoidEffect => MonoidEffect  _ => LatticeEffect }
    IdentityEffect => b
  }
}

// *************************************************************************

// *************************************************************************

// LAYER 7: PROOF STRATEGIES
type ProofStrategy<N, E, R> {
  nodes: List<N>
  edges_from: fn(N) -> List<ProofEdge<N, E>>
  compose: fn(E, E) -> E
  identity: E
  gate: fn(N, E) -> ProofResult<R>
}
type ProofEdge<N, E> { target: N, evidence: E }
type ProofResult<R>
  = ProofSuccess { proof: R }
  | ProofFailure { diagnostic: Diagnostic }

// --- Termination proof (observation: does every cycle descend?) ---
type DescentEvidence
  = Strict
  | NonIncreasing
  | DescentUnknown
fn merge_descent(a: DescentEvidence, b: DescentEvidence) -> DescentEvidence {
  match a {
    Strict => match b { Strict => Strict  NonIncreasing => NonIncreasing  DescentUnknown => DescentUnknown }
    NonIncreasing => match b { DescentUnknown => DescentUnknown  _ => NonIncreasing }
    DescentUnknown => DescentUnknown
  }
}
type RankingDimension
  = TreeSize { param: ParamRef }
  | ListLength { param: ParamRef }
  | ArithmeticValue { param: ParamRef }
  | TokenPosition { param: ParamRef }
  | SetCardinality { param: ParamRef }
type TerminationProof { dimensions: List<RankingDimension> }
type CallEdgeEvidence {
  caller: NodeId
  callee: NodeId
  per_dimension: List<DescentEvidence>
}
fn is_lexicographic_descent(evidence: List<DescentEvidence>) -> Bool {
  fold(evidence, init: false, f: (found_strict, e) =>
    if found_strict { true }
    else { match e { Strict => true  _ => false } }
  )
}

// --- Ownership proof (observation: is any value aliased?) ---
type OwnershipProof {
  binding_id: NodeId
  kind: OwnershipKind
  fan_out: Int
  last_use: NodeId?
}
type OwnershipResult
  = SoleOwner
  | LastUseIdentified { last: NodeId }
  | SharedOwnership

// --- Workflow proof (observation: is the composition idempotent?) ---
type WorkflowProof {
  workflow_id: NodeId
  composed_effect: EffectLevel
  composed_shape: EffectShape
  is_idempotent: Bool
}

// LAYER 8: SURFACE FORMS
type SurfaceForm
  // --- declarations (introduce a name) ---
  = FormModule { name: String }
  | FormImport { path: String, names: List<String> }
  | FormType { name: String }
  | FormFunc { name: String, is_async: Bool }
  | FormData { name: String }
  | FormService { name: String }
  // --- expressions (produce a value) ---
  | FormLiteral { value: LiteralValue }
  | FormVar { name: String }
  | FormCall
  | FormMethodCall { method: String }
  | FormMatch
  | FormIf
  | FormLet { name: String }
  | FormLambda
  | FormBlock
  | FormFieldAccess { field: String }
  | FormBinOp { op: BinOp }
  | FormUnaryOp { op: UnaryOp }
  | FormRecordLit { type_name: String }
  | FormListLit
  | FormStringInterp
  | FormForEach { binding: String }
  | FormIndex
  | FormReturn
  // --- structural (parts of larger forms) ---
  | FormParam { name: String }
  | FormArg { name: String }
  | FormArm
  | FormFieldInit { name: String }
  | FormVariant { name: String }
  | FormField { name: String }
type LiteralValue
  = LitInt { value: Int }
  | LitFloat { value: Float }
  | LitString { value: String }
  | LitBool { value: Bool }
type BinOp
  = Add | Sub | Mul | Div | Mod
  | Eq | Neq | Lt | Gt | Lte | Gte
  | And | Or
  | Concat
type UnaryOp = Not | Neg
type PatternForm
  = PatBind { name: String }
  | PatLiteral { value: LiteralValue }
  | PatVariant { name: String, parent: String?, bindings: List<String> }
  | PatWildcard

// LAYER 9: PIPELINE
type Source { path: String, text: String }
type ParseResult {
  nodes: Map<NodeId, Node>
  surface: Map<NodeId, SurfaceForm>
  patterns: Map<NodeId, PatternForm>
  diagnostics: List<Diagnostic>
  intern: InternTable
}
type InternTable {
  strings: List<String>
  index: Map<String, Int>
}
type ResolvedGraph {
  nodes: Map<NodeId, Node>
  surface: Map<NodeId, SurfaceForm>
  patterns: Map<NodeId, PatternForm>
  call_graph: Map<NodeId, List<NodeId>>
  bindings: Map<NodeId, TypeBinding>
  inductive_fields: Map<NodeId, List<InductiveField>>
  func_sigs: Map<NodeId, FuncSig>
  diagnostics: List<Diagnostic>
}
type TypeBinding {
  id: NodeId
  resolved_type: TypeRef
  provenance: SubValueRelation
}
type InductiveField {
  field: FieldRef
  field_type: TypeRef
}
type FuncSig {
  id: NodeId
  params: List<FuncParam>
  return_type: TypeRef
  is_async: Bool
  output_provenance: Map<String, SubValueRelation>
}
type FuncParam { name: String, id: NodeId, type_ref: TypeRef }
type TypeRef
  = NamedType { name: String, args: List<TypeRef> }
  | FuncType { params: List<TypeRef>, result: TypeRef }
  | OptionalType { inner: TypeRef }
type ProvenGraph {
  nodes: Map<NodeId, Node>
  surface: Map<NodeId, SurfaceForm>
  patterns: Map<NodeId, PatternForm>
  call_graph: Map<NodeId, List<NodeId>>
  bindings: Map<NodeId, TypeBinding>
  func_sigs: Map<NodeId, FuncSig>
  // dimension side tables
  provenance: Map<NodeId, SubValueRelation>
  ownership: Map<NodeId, OwnershipKind>
  effects: Map<NodeId, EffectLevel>
  // proof results
  termination_proofs: Map<NodeId, TerminationProof>
  ownership_proofs: Map<NodeId, OwnershipProof>
  workflow_proofs: Map<NodeId, WorkflowProof>
  diagnostics: List<Diagnostic>
}
type LanguageSpec {
  name: String
  file_extension: String
  sharing: SharingStrategy
}
type SharingStrategy
  = ReferenceCounted
  | GarbageCollected
  | ValueSemantics
  | BorrowChecked
type TargetFile { path: String, content: String }
type EmitResult { files: List<TargetFile>, diagnostics: List<Diagnostic> }
