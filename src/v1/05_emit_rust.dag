fn emit_rust_expr_bin_op(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprBinOp { op: op, algebra_field: algebra } =>
      emit_typed_bin_op(op: op, algebra_field: algebra, left: binop_left(texpr: expr), right: binop_right(texpr: expr), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => emit_error_expr(message: "emit_rust_expr_bin_op expected ExprBinOp", target: Rust)
  }
}

fn emit_typed_expr(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo, fuel: Int) -> String {
  emit_shared_expr(
    texpr: texpr,
    target: Rust,
    source_indices: scope.type_env.source_indices,
    wrap_result: result => result,
    recurse: child => emit_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: fuel - 1),
    emit_var: expr => emit_rust_expr_var(expr: expr, registry: registry, shared_types: shared_types, emit_info: emit_info, source_indices: scope.type_env.source_indices),
    emit_field_access: expr => emit_rust_expr_field_access(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_call: expr => emit_rust_expr_call(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_method_call: expr => emit_rust_expr_method_call(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_match: expr => emit_rust_expr_match(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_if: expr => emit_rust_expr_if(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_let: expr => emit_rust_expr_let(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_record_lit: expr => emit_rust_expr_record_lit(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_string_interp: expr => emit_rust_expr_string_interp(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_block: expr => emit_rust_expr_block(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_cast: expr => emit_rust_expr_cast(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_for_each: expr => emit_rust_expr_for_each(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_index: expr => emit_rust_expr_index(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_slice: expr => emit_rust_expr_slice(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info),
    emit_bin_op: expr => emit_rust_expr_bin_op(expr: expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
}

fn emit_cloned_arg(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
}

fn is_enum_type_name(type_name: String, type_summaries: Map<String, TypeSummary>) -> Bool {
  is_enum_in_summaries(type_summaries: type_summaries, type_name: type_name)
}

fn contextual_variant_parent_from_type_name(variant_name: String, resolved_type: Node, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  let rt_name = authored_name_at(source_indices: source_indices, node: resolved_type)
  if resolved_type.ident_span != none && rt_name != variant_name && variant_belongs_to_enum(type_summaries: emit_info.type_summaries, variant_name: variant_name, enum_name: rt_name) {
    Present { value: rt_name }
  } else {
    none
  }
}

fn contextual_variant_parent_absent(variant_name: String, resolved_type: Node, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  match resolved_type.return_cardinality {
    CardOptional =>
      if is_optional_variant_name(name: variant_name) { Present { value: "Optional" } } else { contextual_variant_parent_from_type_name(variant_name: variant_name, resolved_type: resolved_type, emit_info: emit_info, source_indices: source_indices) }
    _ => contextual_variant_parent_from_type_name(variant_name: variant_name, resolved_type: resolved_type, emit_info: emit_info, source_indices: source_indices)
  }
}

fn contextual_variant_parent(variant_name: String, parent_enum: String?, resolved_type: Node, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  match parent_enum {
    Present { value: explicit_parent } =>
      if variant_belongs_to_enum(type_summaries: emit_info.type_summaries, variant_name: variant_name, enum_name: explicit_parent) {
        Present { value: explicit_parent }
      } else { none }
    Absent => contextual_variant_parent_absent(variant_name: variant_name, resolved_type: resolved_type, emit_info: emit_info, source_indices: source_indices)
  }
}

fn is_map_typed_expr(texpr: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match texpr.inferred {
    Present { value: Resolved { node: n } } => node_is_keyed_collection(n: n, source_indices: source_indices)
    _ => false
  }
}

fn is_collection_typed_expr(texpr: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match texpr.inferred {
    Present { value: Resolved { node: n } } => node_is_collection(n: n, source_indices: source_indices)
    _ => false
  }
}

fn emit_discriminant_call_lowering(value_arg: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let arg = arg_value(n: value_arg)
  let scrutinee = emit_typed_expr(texpr: arg, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let ty_name = resolved_type_name(n: arg, source_indices: scope.type_env.source_indices)
  match lookup_type_by_name(env: scope.type_env, name: ty_name) {
    Present { value: enum_node } =>
      if is_coproduct_type(n: enum_node) {
        let arms = enum_node.children |> map(child =>
          let child_text = authored_name(env: scope.type_env, node: child)
          let pat = if child.children |> count == 0 {
            concat(ty_name, "::", child_text)
          } else if variant_is_synthetic_positional_payload(fields: child.children, source_indices: scope.type_env.source_indices) {
            concat(ty_name, "::", child_text, "(_)")
          } else {
            concat(ty_name, "::", child_text, " { .. }")
          }
        concat("        ", pat, " => ", emit_rust_host_to_dag_string_via_seam(host_expr: concat("\"", child_text, "\".to_string()"), corpus_repr: emit_info.corpus_repr), ",")
        )

        let scrut_ref = if set_contains(shared_types, ty_name) {
          concat("&*(", scrutinee, ")")
        } else {
          concat("&(", scrutinee, ")")
        }
        concat("(match ", scrut_ref, " {\n", arms |> join(separator: "\n"), "\n    })")
      } else {

        emit_rust_host_to_dag_string_via_seam(host_expr: concat("\"", ty_name, "\""), corpus_repr: emit_info.corpus_repr)
      }
    Absent => emit_rust_host_to_dag_string_via_seam(host_expr: concat("\"", ty_name, "\""), corpus_repr: emit_info.corpus_repr)
  }
}

fn emit_typed_call_expr(func: String, args: List<Node>, inferred: InferredNode?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let call_str = if func == "empty_map" {
    match inferred {
      Present { value: Resolved { node: ret_type } } =>
        let kv_type_str = rust_empty_map_kv_type_str(map_type: ret_type, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices)
        if kv_type_str != "" {
          concat("v1_rt::rc_empty_map::<", kv_type_str, ">()")
        } else {
          "Rc::new(HashMap::new()) /* BRIDGE: empty_map value type unresolved */"
        }
      _ => "Rc::new(HashMap::new()) /* BRIDGE: empty_map return type unresolved */"
    }
  } else if func == "empty_set" {
    match inferred {
      Present { value: Resolved { node: ret_type } } =>
        emit_rust_empty_set_expr(set_type: ret_type, shared_types: shared_types, source_indices: scope.type_env.source_indices, emit_info: emit_info)
      _ => "v1_rt::rc_empty_set::<_>()"
    }
  } else {
    emit_typed_call(func: func, args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  }

  if rust_runtime_bridge_wraps_collection_result_in_rc(function_name: func) {
    concat("Rc::new(", call_str, ")")
  } else { call_str }
}

fn rust_call_arg_fail_closed_unwrap(arg_str: String, arg: Node, callee: ItemInfo?, idx: Int, func: String) -> String {
  match callee {
    Present { value: info } =>
      match info.params |> skip(idx) |> first {
        Present { value: param } =>
          let param_required = param_node_type_expr(n: param).return_cardinality != CardOptional
          let arg_optional = resolved_type(n: arg).return_cardinality == CardOptional
          if param_required && arg_optional {
            concat(arg_str, ".expect(\"fail-closed: an optional value flowed into non-optional parameter ", to_string(value: idx), " of ", func, " (empty Optional at runtime)\")")
          } else {
            arg_str
          }
        Absent => arg_str
      }
    Absent => arg_str
  }
}

fn emit_typed_call(func: String, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  if func == "get" {
    let get_args = order_typed_call_args(args: args, func: func, scope: scope)
    let get_list = get_args |> first
    let get_idx = get_args |> skip(1) |> first
    let get_result = match get_list {
      Present { value: list_arg } =>
        match get_idx {
          Present { value: idx_arg } =>
            let list_str = emit_typed_expr(texpr: arg_value(n: list_arg), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
            let index_str = emit_typed_expr(texpr: arg_value(n: idx_arg), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
            concat(list_str, ".get((", index_str, ") as usize)", clone_iterator_suffix())
          Absent => "compile_error!(\"get call missing index argument\")"
        }
      Absent => "compile_error!(\"get call missing list argument\")"
    }
    return get_result
  }
  if func == "with" {
    let with_args = order_typed_call_args(args: args, func: func, scope: scope)
    if with_args |> count == 0 { return "compile_error!(\"with call missing base record\")" }
    let base_arg = arg_value(n: (with_args |> first).value)
    if with_args |> count < 2 { return "compile_error!(\"with call missing update record\")" }
    let update_arg = arg_value(n: (with_args |> skip(1) |> first).value)
    let base_str = emit_typed_expr(texpr: base_arg, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
    let type_name = if base_arg.inferred != none {
      authored_name_at(source_indices: scope.type_env.source_indices, node: resolved_type(n: base_arg))
    } else {
      "compile_error!(\"with call missing resolved record type\")"
    }
    let field_strs = match update_arg.expr_data {
      ExprRecordLit { parent_enum: _ } =>
        update_arg.children |> map(f => concat(emit_ident(name: field_init_node_name_at(n: f, source_indices: scope.type_env.source_indices), target: Rust), ": ", emit_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)))
      _ => [emit_typed_expr(texpr: update_arg, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)]
    }
    let fields_str = field_strs |> join(separator: ", ")
    let needs_rc = set_contains(shared_types, type_name)
    let sharing = language_spec(target: Rust).sharing
    let spread = if needs_rc { apply_type_template1(template: sharing.deref_clone, arg0: base_str) } else { apply_type_template1(template: sharing.clone_value, arg0: base_str) }
    let raw = concat(type_name, " { ", fields_str, ", ..", spread, " }")
    if needs_rc { return concat("Rc::new(", raw, ")") }
    else { return raw }
  }
  if func == "to_string" {
    let to_string_args = order_typed_call_args(args: args, func: func, scope: scope)
    let ts_result = match to_string_args |> first {
      Present { value: value_arg } =>
        emit_rust_host_to_dag_string_via_seam(host_expr: concat("(", emit_typed_expr(texpr: arg_value(n: value_arg), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ").to_string()"), corpus_repr: emit_info.corpus_repr)
      Absent => "compile_error!(\"to_string call missing value argument\")"
    }
    return ts_result
  }

  if func == "utf8_decode_bytes" {
    let decode_args = order_typed_call_args(args: args, func: func, scope: scope)
    let decode_result = match decode_args |> first {
      Present { value: value_arg } =>
        concat(
          "String::from_utf8(",
          emit_typed_expr(texpr: arg_value(n: value_arg), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024),
          ".clone()).map_err(|e| format!(\"invalid UTF-8 in access payload: {}\", e))?"
        )
      Absent => "compile_error!(\"utf8_decode_bytes call missing value argument\")"
    }
    return decode_result
  }
  if func == "discriminant" {
    let disc_args = order_typed_call_args(args: args, func: func, scope: scope)
    let disc_result = match disc_args |> first {
      Present { value: value_arg } =>
        emit_discriminant_call_lowering(value_arg: value_arg, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      Absent => "compile_error!(\"discriminant call missing value argument\")"
    }
    return disc_result
  }
  let collection_scope = if func == "map" || func == "filter" || func == "flat_map" || func == "fold" {
    let call_args = order_typed_call_args(args: args, func: func, scope: scope)
    match call_args |> last {
      Present { value: a } =>
        match arg_value(n: a).expr_data {
          ExprLambda =>
            let lps = lambda_param_names_at(texpr: arg_value(n: a), source_indices: scope.type_env.source_indices)
            lambda_scope_from_children(scope: scope, params: lps, param_nodes: arg_value(n: a).children |> skip(1))
          _ => scope
        }
      Absent => scope
    }
  } else { scope }
  let ordered_args = order_typed_call_args(args: args, func: func, scope: collection_scope)
  let callee = lookup_item(registry: registry, name: qualified_last_segment(name: func))
  let filled_args = fill_default_args(ordered: ordered_args, callee: callee, registry: registry, scope: collection_scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  let is_rt = map_contains_key(rt_functions(), func)
  let is_rt_ref_map = map_contains_key(rt_ref_map_functions(), func)
  let arg_strs = filled_args |> enumerate |> map(pair =>
    let idx = pair.first
    let a = pair.second
    if is_rt_ref_map && idx == 0 {
      let base = emit_typed_expr_base(texpr: arg_value(n: a), registry: registry, scope: collection_scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      concat("&", base)
    } else {
      let base = emit_cloned_arg(texpr: arg_value(n: a), registry: registry, scope: collection_scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      rust_call_arg_fail_closed_unwrap(arg_str: base, arg: arg_value(n: a), callee: callee, idx: idx, func: func)
    }
  )
  let extra_args = match callee {
    Present { value: info } =>
      let has_effects = info.service_names |> count > 0 || info.resource_names |> count > 0
      if has_effects {
        let resource_args = info.resource_names |> map(rn => concat("&", emit_ident(name: rn, target: Rust)))
        let service_args = info.service_names |> map(sn => service_var_name(service_name: sn))
        concat(resource_args, service_args)
      } else { [] }
    Absent => []
  }
  let all_args = concat(arg_strs, extra_args)
  let args_str = all_args |> join(separator: ", ")
  let runtime_name = rust_runtime_bridge_name(function_name: func)
  let si = scope.type_env.source_indices

  let callee_self_capture = if is_rt { false } else {
    filled_args |> any(a => expr_references_var(node: arg_value(n: a), var_name: func, source_indices: si))
  }
  let func_ident = if is_rt { concat("v1_rt::", emit_ident(name: runtime_name, target: Rust)) }
    else { emit_value_ref_ident(name: func, registry: registry, emit_info: emit_info) }
  let func_name = if callee_self_capture { concat(func_ident, ".clone()") } else { func_ident }
  let call_str = if is_rt && func == "concat" && all_args |> count > 2 {
    emit_nested_rt_concat(remaining: all_args, acc: "", shared_types: shared_types)
  } else {
    concat(func_name, "(", args_str, ")")
  }
  match callee {
    Present { value: info } =>
      let has_effects = info.service_names |> count > 0 || info.resource_names |> count > 0
      if has_effects { concat(call_str, ".await?") } else { call_str }
    Absent => call_str
  }
}

fn fill_default_args(ordered: List<Node>, callee: ItemInfo?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> List<Node> {
  match callee {
    Present { value: info } =>
      let provided_names = ordered |> map(a => match arg_name_at(n: a, source_indices: scope.type_env.source_indices) { Present { value: n } => n  Absent => "" })
      let missing_with_defaults = info.params |> filter(p =>
        let is_provided = provided_names |> any(n => n == param_node_name_at(n: p, source_indices: scope.type_env.source_indices))
        if is_provided { false }
        else { param_node_default_value(n: p) != none }
      )
      let default_args = missing_with_defaults |> map(p =>
        make_arg_node(name: Present { value: param_node_name_at(n: p, source_indices: scope.type_env.source_indices) }, value: param_node_default_value(n: p).value, span: p.span, name_span: p.span)
      )
      concat(ordered, default_args)
    Absent => ordered
  }
}

fn fill_op_default_args(ordered: List<Node>, op_params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> List<Node> {
  let si = scope.type_env.source_indices
  let arg_map = ordered |> fold(init: empty_map(), f: (acc, a) =>
    match arg_name_at(n: a, source_indices: si) {
      Present { value: n } => map_insert(acc, n, a)
      Absent => acc
    }
  )
  let unnamed_args = ordered |> filter(a => arg_name_at(n: a, source_indices: si) == none)
  let named_ordered = op_params |> flat_map(p =>
    let pname = param_node_name_at(n: p, source_indices: si)
    match map_get(arg_map, pname) {
      Present { value: arg } => [arg]
      Absent =>
        if param_node_default_value(n: p) != none {
          [make_arg_node(name: Present { value: pname }, value: param_node_default_value(n: p).value, span: p.span, name_span: p.span)]
        } else { [] }
    }
  )
  concat(named_ordered, unnamed_args)
}

fn emit_nested_rt_concat(remaining: List<String>, acc: String, shared_types: Set<String>) -> String {
  match remaining |> first {
    Absent => acc
    Present { value: arg } =>
      let next_acc = if acc == "" { arg }
        else { concat("v1_rt::concat(", acc, ", ", arg, ")") }
      emit_nested_rt_concat(remaining: remaining |> skip(1), acc: next_acc, shared_types: shared_types)
  }
}

fn emit_typed_for_each(variable: String, collection: Node, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let sharing = language_spec(target: Rust).sharing
  let coll_str = emit_typed_expr(texpr: collection, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let elem_type = for_each_element_type_node(n: resolved_type(n: collection), source_indices: scope.type_env.source_indices)
  let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type, provenance: SubValueUnknown)
  let body_str = emit_typed_expr(texpr: body, registry: registry, scope: body_scope, depth: depth + 2, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let ind1 = make_indent(level: depth + 1)
  let ind2 = make_indent(level: depth + 2)
  let ind0 = make_indent(level: depth)
  let iter_str = apply_type_template1(template: sharing.iter_owned, arg0: coll_str)
  concat("{\n",
    ind1, "let mut __collect = Vec::new();\n",
    ind1, "for ", emit_ident(name: variable, target: Rust), " in ", iter_str, " {\n",
    ind2, "__collect.push(", body_str, ");\n",
    ind1, "}\n",
    ind1, "Rc::new(__collect)\n",
    ind0, "}")
}

fn emit_typed_index(base: Node, index: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let spec = language_spec(target: Rust)
  let base_str = emit_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let index_str = emit_typed_expr(texpr: index, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let base_node = normalize_access_type_node(n: resolved_type(n: base))
  let is_map = node_is_keyed_collection(n: base_node, source_indices: scope.type_env.source_indices)
  if is_rust_string_like(n: base_node, source_indices: scope.type_env.source_indices) {
    apply_type_template2(template: spec.indexing.string_index, arg0: base_str, arg1: index_str)
  } else if is_map {
    apply_type_template2(template: spec.indexing.map_index, arg0: base_str, arg1: index_str)
  } else {
    apply_type_template2(template: spec.indexing.list_index, arg0: base_str, arg1: index_str)
  }
}

fn emit_typed_slice(base: Node, start: Node, end: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let spec = language_spec(target: Rust)
  let base_str = emit_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let start_str = emit_typed_expr(texpr: start, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let end_str = emit_typed_expr(texpr: end, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let base_node = normalize_access_type_node(n: resolved_type(n: base))
  if is_rust_string_like(n: base_node, source_indices: scope.type_env.source_indices) {
    match spec.indexing.string_slice {
      Present { value: tmpl } => apply_type_template3(template: tmpl, arg0: base_str, arg1: start_str, arg2: end_str)
      Absent => emit_error_expr(message: "unsupported string slice for target", target: Rust)
    }
  } else {
    match spec.indexing.list_slice {
      Present { value: tmpl } => apply_type_template3(template: tmpl, arg0: base_str, arg1: start_str, arg2: end_str)
      Absent => emit_error_expr(message: "unsupported list slice for target", target: Rust)
    }
  }
}

fn collection_element_type(receiver_type: InferredNode?, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo, type_env: TypeEnv) -> String {
  match receiver_type {
    Present { value: Resolved { node: rt } } =>
      let __rt_is_container = node_is_element_collection(n: rt, source_indices: source_indices)
      if __rt_is_container {
        match rt.children |> first {
          Present { value: elem_child } =>
            let elem_node = child_type_node(ch: elem_child)
            let elem_is_error = if elem_node.inferred != none { is_compiler_error(inferred: elem_node.inferred.value) } else { false }
            let elem_is_type_var = if elem_node.inferred != none { is_type_variable(inferred: elem_node.inferred.value) } else { false }
            if elem_is_error || elem_is_type_var || type_node_has_closure_unbound_generic_atom(n: elem_node, generic_param_names: emit_info.fn_generic_param_names, env: type_env, source_indices: source_indices) { "_" } else { render_rust_type(n: elem_node, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: emit_info) }
          Absent => "_"
        }
      } else { "_" }
    _ => "_"
  }
}

fn lambda_scope_from_children(scope: InferScope, params: List<String>, param_nodes: List<Node>) -> InferScope {
  params |> enumerate |> fold(init: scope, f: (acc, pair) =>
    let idx = pair.first
    let param_name = pair.second
    let param_type = match param_nodes |> skip(idx) |> first {
      Present { value: pn } =>
        match pn.inferred {
          Present { value: Resolved { node: resolved_type } } => resolved_type
          _ => type_variable_node(id: "lambda_param")
        }
      Absent => type_variable_node(id: "lambda_param")
    }
    extend_scope(scope: acc, name: param_name, resolved: param_type, provenance: SubValueUnknown)
  )
}

fn lambda_param_type_strs(params: List<String>, param_nodes: List<Node>, fallback_types: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo, fold_acc_uses_fallback: Bool, type_env: TypeEnv) -> List<String> {
  params |> enumerate |> map(pair =>
    let idx = pair.first
    let param_name = pair.second
    let inferred_type = if fold_acc_uses_fallback && idx == 0 {
      none
    } else {
      match param_nodes |> skip(idx) |> first {
        Present { value: pn } =>
          match pn.inferred {
            Present { value: Resolved { node: param_type } } =>
              let param_is_error = if param_type.inferred != none { is_compiler_error(inferred: param_type.inferred.value) } else { false }
              let param_is_type_var = if param_type.inferred != none { is_type_variable(inferred: param_type.inferred.value) } else { false }
              if param_is_type_var || param_is_error {
                none
              } else if type_node_has_closure_unbound_generic_atom(n: param_type, generic_param_names: emit_info.fn_generic_param_names, env: type_env, source_indices: source_indices) {
                none
              } else {
                Present { value: render_rust_type(n: param_type, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: emit_info) }
              }
            _ => none
          }
        Absent => none
      }
    }
    let fallback_type = match fallback_types |> skip(idx) |> first {
      Present { value: ty } => ty
      Absent => "_"
    }
    let spec = language_spec(target: Rust)
    let ident = emit_ident(name: param_name, target: Rust)
    match inferred_type {
      Present { value: ty } => apply_type_template2(template: spec.annotations.lambda_param_typed, arg0: ident, arg1: ty)
      Absent => apply_type_template2(template: spec.annotations.lambda_param_typed, arg0: ident, arg1: fallback_type)
    }
  )
}

fn emit_typed_collection_lambda(lambda_expr: Node, elem_type_str: String, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match lambda_expr.expr_data {
    ExprLambda =>
      let ps = lambda_param_names_at(texpr: lambda_expr, source_indices: scope.type_env.source_indices)
      let bd = lambda_body(texpr: lambda_expr)
      let pn = lambda_expr.children |> skip(1)
      let param_strs = lambda_param_type_strs(params: ps, param_nodes: pn, fallback_types: [elem_type_str], shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices, emit_info: emit_info, fold_acc_uses_fallback: false, type_env: scope.type_env)
      let params_str = param_strs |> join(separator: ", ")
      let lambda_scope = lambda_scope_from_children(scope: scope, params: ps, param_nodes: pn)
      let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      concat("|", params_str, "| ", body_str)
    _ => emit_typed_expr(texpr: lambda_expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  }
}

fn emit_typed_fold_lambda(lambda_expr: Node, acc_type_str: String, elem_type_str: String, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match lambda_expr.expr_data {
    ExprLambda =>
      let ps = lambda_param_names_at(texpr: lambda_expr, source_indices: scope.type_env.source_indices)
      let bd = lambda_body(texpr: lambda_expr)
      let pn = lambda_expr.children |> skip(1)

      let safe_acc_type = if acc_type_str == "Rc<Vec<()>>" || acc_type_str == "Vec<()>" || acc_type_str == "Option<()>" { "_" } else { acc_type_str }
      let fallback_types = ps |> enumerate |> map(pair =>
        if pair.first == 0 { safe_acc_type } else { elem_type_str }
      )
      let param_strs = lambda_param_type_strs(params: ps, param_nodes: pn, fallback_types: fallback_types, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices, emit_info: emit_info, fold_acc_uses_fallback: true, type_env: scope.type_env)
      let params_str = param_strs |> join(separator: ", ")
      let lambda_scope = lambda_scope_from_children(scope: scope, params: ps, param_nodes: pn)
      let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)

      let acc_name = match ps |> first { Present { value: n } => n  Absent => "" }
      let needs_unwrap = acc_name != "" && set_contains(emit_info.owned_bindings, acc_name)
      if needs_unwrap {
        let acc_ident = emit_ident(name: acc_name, target: Rust)
        concat("|", params_str, "| { let ", acc_ident, " = v1_rt::take_owned(", acc_ident, "); ", body_str, " }")
      } else {
        concat("|", params_str, "| ", body_str)
      }
    _ => emit_typed_expr(texpr: lambda_expr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  }
}

fn emit_rust_fold_method_call(method_call_node: Node, fold_accumulator_type: Node?, result_type: InferredNode?, receiver: Node, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let elem_type_str = collection_element_type(receiver_type: receiver.inferred, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices, emit_info: emit_info, type_env: scope.type_env)
  let contextual_acc_type = match result_type {
    Present { value: Resolved { node: method_result_type } } => Present { value: method_result_type }
    _ => none
  }
  let acc_type_node = match fold_accumulator_type {
    Present { value: acc_type } =>
      let acc_children_have_unit = acc_type.children |> any(c => is_unit_like(n: c) || c.ident_span == none) || acc_type.children |> any(c => c.children |> any(gc => is_unit_like(n: gc) || gc.ident_span == none))
      let is_under_resolved_map = node_is_keyed_collection(n: acc_type, source_indices: scope.type_env.source_indices) && (acc_type.children |> count == 0 || acc_children_have_unit)
      let is_under_resolved_list = node_is_element_collection(n: acc_type, source_indices: scope.type_env.source_indices) && !node_is_set_collection(n: acc_type, source_indices: scope.type_env.source_indices) && acc_type.children |> count == 0
      let is_under_resolved_set = node_is_set_collection(n: acc_type, source_indices: scope.type_env.source_indices) && (acc_type.children |> count == 0 || acc_children_have_unit)
      let is_under_resolved_non_collection = !node_is_keyed_collection(n: acc_type, source_indices: scope.type_env.source_indices) && !node_is_element_collection(n: acc_type, source_indices: scope.type_env.source_indices) && !node_is_collection(n: acc_type, source_indices: scope.type_env.source_indices)
      if is_under_resolved_map || is_under_resolved_list || is_under_resolved_set || is_under_resolved_non_collection {
        match contextual_acc_type {
          Present { value: concrete_type } => concrete_type
          Absent => acc_type
        }
      } else { acc_type }
    Absent =>
      match contextual_acc_type {
        Present { value: concrete_type } => concrete_type
        Absent =>
          match args |> first {
            Present { value: init_arg } =>
              if arg_value(n: init_arg).inferred != none {
                resolved_type(n: arg_value(n: init_arg))
              } else { type_variable_node(id: "fold_accum") }
            Absent => type_variable_node(id: "fold_accum")
          }
      }
  }
  let acc_type_name = authored_name_at(source_indices: scope.type_env.source_indices, node: acc_type_node)
  let fold_lambda_node = match args |> skip(1) |> first {
    Present { value: a } => arg_value(n: a)
    Absent => type_variable_node(id: "")
  }
  let acc_param_name = match fold_lambda_node.expr_data {
    ExprLambda => match lambda_param_names_at(texpr: fold_lambda_node, source_indices: scope.type_env.source_indices) |> first {
      Present { value: n } => n
      Absent => ""
    }
    _ => ""
  }
  let fold_proof = analyze_single_fold(method_call: method_call_node, si: scope.type_env.source_indices)
  let structural_unwrap = fold_proof.eligible && fold_proof.body_constructs_acc && fold_proof.safe_field_moves
  let structural_move = fold_proof.eligible && fold_proof.whole_acc_single_use
  let acc_unwrap = structural_unwrap && set_contains(shared_types, acc_type_name)
  let fold_emit_info = if acc_unwrap {
    match fold_lambda_node.expr_data {
      ExprLambda =>
        let ps = lambda_param_names_at(texpr: fold_lambda_node, source_indices: scope.type_env.source_indices)
        match ps |> first {
          Present { value: acc_name } =>
            EmitGraphInfo {
              type_summaries: emit_info.type_summaries,
              type_decl_items: emit_info.type_decl_items,
              recursive_type_set: emit_info.recursive_type_set,
              fielded_variants: emit_info.fielded_variants,
              positional_payload_variants: emit_info.positional_payload_variants,
              shared_types: emit_info.shared_types,
              ownership_index: emit_info.ownership_index,
              movable: emit_info.movable,
              variant_to_enum: emit_info.variant_to_enum,
              owned_bindings: set_insert(emit_info.owned_bindings, acc_name),
              read_only_params_index: emit_info.read_only_params_index,
              read_only_params: emit_info.read_only_params,
              corpus_repr: emit_info.corpus_repr,
              fn_generic_param_names: emit_info.fn_generic_param_names,
              fn_type_env: emit_info.fn_type_env,
              fn_return_type: emit_info.fn_return_type
            }
          Absent => emit_info
        }
      _ => emit_info
    }
  } else if structural_move {
    match fold_lambda_node.expr_data {
      ExprLambda =>
        let ps = lambda_param_names_at(texpr: fold_lambda_node, source_indices: scope.type_env.source_indices)
        match ps |> first {
          Present { value: acc_name } =>
            EmitGraphInfo {
              type_summaries: emit_info.type_summaries,
              type_decl_items: emit_info.type_decl_items,
              recursive_type_set: emit_info.recursive_type_set,
              fielded_variants: emit_info.fielded_variants,
              positional_payload_variants: emit_info.positional_payload_variants,
              shared_types: emit_info.shared_types,
              ownership_index: emit_info.ownership_index,
              movable: set_insert(emit_info.movable, acc_name),
              variant_to_enum: emit_info.variant_to_enum,
              owned_bindings: emit_info.owned_bindings,
              read_only_params_index: emit_info.read_only_params_index,
              read_only_params: emit_info.read_only_params,
              corpus_repr: emit_info.corpus_repr,
              fn_generic_param_names: emit_info.fn_generic_param_names,
              fn_type_env: emit_info.fn_type_env,
              fn_return_type: emit_info.fn_return_type
            }
          Absent => emit_info
        }
      _ => emit_info
    }
  } else { emit_info }
  let acc_type_str = render_rust_type(n: acc_type_node, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices, emit_info: fold_emit_info)
  let acc_type_is_type_var = if acc_type_node.inferred != none { is_type_variable(inferred: acc_type_node.inferred.value) } else { false }
  let acc_child_is_type_var = acc_type_node.children |> any(c => type_node_child_is_type_variable(c: c))
  let acc_has_unbound_type_var = type_node_has_unbound_type_variable(n: acc_type_node, generic_param_names: emit_info.fn_generic_param_names, source_indices: scope.type_env.source_indices)
  let acc_has_closure_unbound_generic = type_node_has_closure_unbound_generic_atom(n: acc_type_node, generic_param_names: emit_info.fn_generic_param_names, env: scope.type_env, source_indices: scope.type_env.source_indices)
  let acc_render_has_spurious_generic = rust_fold_rendered_type_has_any_spurious_generic(type_str: acc_type_str, generic_param_names: emit_info.fn_generic_param_names)
  let elem_render_has_spurious_generic = rust_fold_rendered_type_has_any_spurious_generic(type_str: elem_type_str, generic_param_names: emit_info.fn_generic_param_names)
  let is_bare_container = acc_type_node.children |> count == 0 && is_container_type(name: acc_type_name)
  let lambda_acc_type_str = if is_bare_container || acc_type_is_type_var || acc_child_is_type_var || acc_has_unbound_type_var || acc_has_closure_unbound_generic || acc_render_has_spurious_generic { "_" } else { acc_type_str }
  let fold_elem_type_str = if elem_render_has_spurious_generic { "_" } else { elem_type_str }
  let acc_has_unit_child = acc_type_node.children |> any(c => is_unit_like(n: c) || c.ident_span == none) || acc_type_node.children |> any(c => c.children |> any(gc => is_unit_like(n: gc) || gc.ident_span == none))
  let init_str = match args |> first {
    Present { value: init_arg } =>
      match arg_value(n: init_arg).expr_data {
        ExprCall { call_semantics: _, descent_evidence: _ } =>
          let init_func = expr_call_func_at(texpr: arg_value(n: init_arg), source_indices: scope.type_env.source_indices)
          if init_func == "empty_map" && acc_type_str != "_" && acc_type_str != "" && !acc_has_unit_child {
            let kv_type_str = rust_empty_map_kv_type_str(map_type: acc_type_node, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices)
            if kv_type_str != "" {
              concat("v1_rt::rc_empty_map::<", kv_type_str, ">()")
            } else {
              "Rc::new(HashMap::new()) /* BRIDGE: fold empty_map value type unresolved */"
            }
          } else if init_func == "empty_map" {
            "Rc::new(HashMap::new()) /* BRIDGE: fold empty_map accumulator type unresolved */"
          } else if init_func == "empty_set" && acc_type_str != "_" && acc_type_str != "" && !acc_has_unit_child {
            emit_rust_empty_set_expr(set_type: acc_type_node, shared_types: shared_types, source_indices: scope.type_env.source_indices, emit_info: emit_info)
          } else if init_func == "empty_set" {
            "v1_rt::rc_empty_set::<_>()"
          } else {
            emit_typed_expr(texpr: arg_value(n: init_arg), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: fold_emit_info, fuel: 1024)
          }
        _ => emit_typed_expr(texpr: arg_value(n: init_arg), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: fold_emit_info, fuel: 1024)
      }
    Absent => "compile_error!(\"missing fold init argument\")"
  }
  let fold_fn = match args |> skip(1) |> first {
    Present { value: a } =>
      emit_typed_fold_lambda(lambda_expr: arg_value(n: a), acc_type_str: lambda_acc_type_str, elem_type_str: fold_elem_type_str, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: fold_emit_info)
    Absent => "compile_error!(\"missing fold function argument\")"
  }
  let sharing = language_spec(target: Rust).sharing
  let elem_unused = match args |> skip(1) |> first {
    Present { value: a } => fold_lambda_element_unused(lambda_expr: arg_value(n: a), source_indices: scope.type_env.source_indices)
    Absent => false
  }
  let iter_template = if elem_unused { replace(sharing.iter_owned, ".cloned()", "") } else { sharing.iter_owned }
  concat(apply_type_template1(template: iter_template, arg0: recv_str), ".fold(", init_str, ", ", fold_fn, ")")
}

fn fold_lambda_element_unused(lambda_expr: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match lambda_expr.expr_data {
    ExprLambda =>
      let ps = lambda_param_names_at(texpr: lambda_expr, source_indices: source_indices)
      match ps |> skip(1) |> first {
        Present { value: elem_name } => elem_name == "_"
        Absent => false
      }
    _ => false
  }
}

fn emit_rust_sort_by_method_call(receiver: Node, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let elem_type_str = match receiver.inferred {
    Present { value: Resolved { node: rt } } =>
      let resolved = rt
      let elem = for_each_element_type_node(n: resolved, source_indices: scope.type_env.source_indices)
      let elem_is_type_var = if elem.inferred != none { is_type_variable(inferred: elem.inferred.value) } else { false }
      if elem.ident_span != none && !elem_is_type_var {
        render_rust_type(n: elem, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices, emit_info: emit_info)
      } else { "_" }
    _ => "_"
  }
  let sort_key_fn = match args |> first {
    Present { value: a } =>
      emit_typed_collection_lambda(lambda_expr: arg_value(n: a), elem_type_str: elem_type_str, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    Absent => "compile_error!(\"missing sort_by key function argument\")"
  }

  let sharing = language_spec(target: Rust).sharing
  let iter_str = apply_type_template1(template: sharing.iter_owned, arg0: recv_str)
  let a_clone = apply_type_template1(template: sharing.clone_value, arg0: "a")
  let b_clone = apply_type_template1(template: sharing.clone_value, arg0: "b")
  if elem_type_str == "_" {
    concat("Rc::new({ let mut __sorted: Vec<_> = ", iter_str, ".collect(); __sorted.sort_by(|a, b| { a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal) }); __sorted })")
  } else {
    concat("Rc::new({ let mut __sorted: Vec<_> = ", iter_str, ".collect(); __sorted.sort_by(|a: &", elem_type_str, ", b: &", elem_type_str, "| { let __ka = (", sort_key_fn, ")(", a_clone, "); let __kb = (", sort_key_fn, ")(", b_clone, "); __ka.partial_cmp(&__kb).unwrap_or(std::cmp::Ordering::Equal) }); __sorted })")
  }
}

fn emit_rust_map_method_call(receiver: Node, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let first_arg_str = emit_typed_first_arg(args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  let recv_is_optional = match receiver.inferred {
    Present { value: Resolved { node: rt } } => rt.return_cardinality == CardOptional
    _ => false
  }
  if recv_is_optional {
    match args |> first {
      Present { value: a } =>
        match arg_value(n: a).expr_data {
          ExprLambda =>
            let bd = match arg_value(n: a).children |> first { Present { value: v } => v  Absent => arg_value(n: a) }
            let ps = lambda_param_names_at(texpr: arg_value(n: a), source_indices: scope.type_env.source_indices)
            let dag_name = match ps |> first { Present { value: n } => n  Absent => "__x" }
            let p = emit_ident(name: dag_name, target: Rust)
            let lambda_scope = lambda_scope_from_children(scope: scope, params: ps, param_nodes: arg_value(n: a).children |> skip(1))
            let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
            concat(recv_str, ".map(|", p, "| ", body_str, ")")
          _ => concat(recv_str, ".map(", first_arg_str, ")")
        }
      Absent => concat(recv_str, ".map(", first_arg_str, ")")
    }
  } else {
    let sharing = language_spec(target: Rust).sharing
    let iter_str = apply_type_template1(template: sharing.iter_owned, arg0: recv_str)
    match args |> first {
      Present { value: a } =>
        match arg_value(n: a).expr_data {
          ExprLambda =>
            let bd = match arg_value(n: a).children |> first { Present { value: v } => v  Absent => arg_value(n: a) }
            let ps = lambda_param_names_at(texpr: arg_value(n: a), source_indices: scope.type_env.source_indices)
            let dag_name = match ps |> first { Present { value: n } => n  Absent => "__x" }
            let p = emit_ident(name: dag_name, target: Rust)
            let lambda_scope = lambda_scope_from_children(scope: scope, params: ps, param_nodes: arg_value(n: a).children |> skip(1))
            let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
            concat("Rc::new({ let mut __result = Vec::new(); for ", p, " in ", iter_str, " { __result.push(", body_str, "); } __result })")
          _ => concat("Rc::new(", iter_str, ".map(", first_arg_str, ").collect::<Vec<_>>())")
        }
      Absent => concat("Rc::new(", iter_str, ".map(", first_arg_str, ").collect::<Vec<_>>())")
    }
  }
}

fn emit_rust_higher_order_method(ho_spec: HigherOrderMethodSpec, receiver: Node, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let sharing = language_spec(target: Rust).sharing
  let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let first_arg_str = emit_typed_first_arg(args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  let iter_str = apply_type_template1(template: sharing.iter_owned, arg0: recv_str)
  match args |> first {
    Present { value: a } =>
      match arg_value(n: a).expr_data {
        ExprLambda =>
          let bd = match arg_value(n: a).children |> first { Present { value: v } => v  Absent => arg_value(n: a) }
          let ps = lambda_param_names_at(texpr: arg_value(n: a), source_indices: scope.type_env.source_indices)
          let dag_name = match ps |> first { Present { value: n } => n  Absent => "__x" }
          let p = emit_ident(name: dag_name, target: Rust)
          let lambda_scope = lambda_scope_from_children(scope: scope, params: ps, param_nodes: arg_value(n: a).children |> skip(1))
          let body_str = emit_typed_expr(texpr: bd, registry: registry, scope: lambda_scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          let inner_iter = apply_type_template1(template: sharing.iter_owned, arg0: concat("(*", body_str, ")"))
          let bindings = seed_bindings(key: "param", value: p) |> map_insert("body", body_str) |> map_insert("iter", iter_str) |> map_insert("inner_iter", inner_iter)
          let raw = apply_named_template(template: ho_spec.inline_template, bindings: bindings)
          if ho_spec.wraps_in_sharing { concat("Rc::new(", raw, ")") } else { raw }
        _ =>
          let bindings = seed_bindings(key: "iter", value: iter_str) |> map_insert("arg", first_arg_str)
          let raw = apply_named_template(template: ho_spec.fn_ref_template, bindings: bindings)
          if ho_spec.wraps_in_sharing { concat("Rc::new(", raw, ")") } else { raw }
      }
    Absent =>
      let bindings = seed_bindings(key: "iter", value: iter_str) |> map_insert("arg", first_arg_str)
      let raw = apply_named_template(template: ho_spec.fn_ref_template, bindings: bindings)
      if ho_spec.wraps_in_sharing { concat("Rc::new(", raw, ")") } else { raw }
  }
}

fn emit_rust_get_method_call(receiver: Node, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let index_str = match args |> first {
    Present { value: a } => emit_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
    Absent => "compile_error!(\"get method missing index\")"
  }
  let receiver_resolved = match receiver.inferred {
    Present { value: Resolved { node: _ } } => true
    _ => false
  }
  if is_map_typed_expr(texpr: receiver, source_indices: scope.type_env.source_indices) {
    concat("v1_rt::map_get(&", recv_str, ", ", index_str, ")")
  } else if receiver_resolved {
    concat(recv_str, ".get((", index_str, ") as usize)", clone_iterator_suffix())
  } else {
    "compile_error!(\"get: receiver type unresolved\")"
  }
}

fn emit_rust_with_method_call(receiver: Node, args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let base_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let type_name = match receiver.inferred {
    Present { value: Resolved { node: rt } } =>
      let rt_is_error = if rt.inferred != none { is_compiler_error(inferred: rt.inferred.value) } else { false }
      if rt_is_error || rt.ident_span == none {
        "compile_error!(\"with method missing resolved record type\")"
      } else { authored_name_at(source_indices: scope.type_env.source_indices, node: rt) }
    _ => "compile_error!(\"with method missing resolved record type\")"
  }
  if args |> count == 0 { return "compile_error!(\"with method missing update record\")" }
  let update_arg = arg_value(n: (args |> first).value)
  let field_strs = match update_arg.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      update_arg.children |> map(f => concat(emit_ident(name: field_init_node_name_at(n: f, source_indices: scope.type_env.source_indices), target: Rust), ": ", emit_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)))
    _ => [emit_typed_expr(texpr: update_arg, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)]
  }
  let fields_str = field_strs |> join(separator: ", ")
  let needs_rc = set_contains(shared_types, type_name)
  let sharing = language_spec(target: Rust).sharing
  let spread = if needs_rc { apply_type_template1(template: sharing.deref_clone, arg0: base_str) } else { apply_type_template1(template: sharing.clone_value, arg0: base_str) }
  let raw = concat(type_name, " { ", fields_str, ", ..", spread, " }")
  if needs_rc { concat("Rc::new(", raw, ")") } else { raw }
}

fn emit_rust_first_method_call(receiver: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match receiver.expr_data {
    ExprMethodCall { method_semantics: _ } =>
      if expr_method_name_at(texpr: receiver, source_indices: scope.type_env.source_indices) == "skip" {
        let skip_recv = method_receiver(texpr: receiver)
        let skip_args = method_arg_nodes(texpr: receiver)
        let recv_str = emit_typed_expr(texpr: skip_recv, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
        let n_str = emit_typed_first_arg(args: skip_args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
        concat(recv_str, ".iter().cloned().skip(", n_str, " as usize).next()")
      } else {
        let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
        concat(recv_str, ".first().cloned()")
      }
    _ =>
      let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      concat(recv_str, ".first().cloned()")
  }
}

fn emit_rust_generic_method_call(method_name: String, receiver: Node, args: List<Node>, result_type: InferredNode?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let function_name = method_name
  if rust_receiver_has_callable_method_field(receiver: receiver, method_name: function_name, scope: scope) {
    let recv_str = emit_typed_expr_base(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    let arg_strs = args |> map(a => emit_cloned_arg(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
    concat("(", recv_str, ".", emit_ident(name: function_name, target: Rust), ")(", arg_strs |> join(separator: ", "), ")")
  } else {
  let recv_str = if rust_runtime_bridge_passes_receiver_by_ref(function_name: function_name) {
    concat("&", emit_typed_expr_base(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
  } else {
    emit_cloned_arg(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  }
  let arg_strs = args |> map(a => emit_cloned_arg(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
  let all_strs = concat([recv_str], arg_strs)
  let bridge_name = rust_runtime_bridge_name(function_name: function_name)
  let lowered = concat("v1_rt::", emit_ident(name: bridge_name, target: Rust), "(", all_strs |> join(separator: ", "), ")")
  if rust_runtime_bridge_wraps_collection_result_in_rc(function_name: function_name) {
    concat("Rc::new(", lowered, ")")
  } else { lowered }
  }
}

fn emit_typed_method_call(method_call_node: Node, receiver: Node, method: String, args: List<Node>, result_type: InferredNode?, method_semantics: MethodSemantics?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  if method_semantics != none { match method_semantics.value {
    ServiceMethodSemantics { service_name: svc_name, op_params: op_params } => {
      let var_name = service_var_name(service_name: svc_name)
      let si = scope.type_env.source_indices
      let filled_args = fill_op_default_args(ordered: args, op_params: op_params, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      let optional_param_set = op_params
        |> filter(p => param_node_type_expr(n: p).return_cardinality == CardOptional)
        |> fold(init: empty_map(), f: (acc, p) => map_insert(acc, param_node_name_at(n: p, source_indices: si), true))
      let json_param_set = op_params
        |> filter(p => coerce_primitive_type(target: Rust, dag_name: authored_name_at(source_indices: si, node: param_node_type_expr(n: p))) == "serde_json::Value")
        |> fold(init: empty_map(), f: (acc, p) => map_insert(acc, param_node_name_at(n: p, source_indices: si), true))
      let arg_strs = filled_args |> map(a =>
        let arg_str = emit_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
        let aname = match arg_name_at(n: a, source_indices: si) { Present { value: n } => n  Absent => "" }
        let param_is_json = match map_get(json_param_set, aname) { Present { value: _ } => true  Absent => false }
        let param_is_optional = match map_get(optional_param_set, aname) { Present { value: _ } => true  Absent => false }
        let needs_optional = param_is_optional && is_already_optional(texpr: arg_value(n: a), emit_info: emit_info, scope: scope) == false
        let coerced = if param_is_json && is_string_typed_expr(e: arg_value(n: a), source_indices: si) {
          concat("serde_json::from_str(&", arg_str, ").unwrap()")
        } else {
          arg_str
        }
        if needs_optional {
          concat("Some(", coerced, ")")
        } else {
          coerced
        }
      )
      let args_str = arg_strs |> join(separator: ", ")
      concat(var_name, ".", emit_ident(name: method, target: Rust), "(", args_str, ").await?")
    }
    AlgebraMethodSemantics { method_def: method_def, fold_accumulator_type: fold_accumulator_type, size_effect: _, cost_shape: _, algebra_template: _ } => {

      let method_name_raw = authored_name_at(source_indices: scope.type_env.source_indices, node: method_def)
      let method_name = if method_name_raw == "length" {
        if is_string_typed_expr(e: receiver, source_indices: scope.type_env.source_indices) { "string_length" } else { "count" }
      } else { method_name_raw }
      if method_name == "fold" {
        emit_rust_fold_method_call(method_call_node: method_call_node, fold_accumulator_type: fold_accumulator_type, result_type: result_type, receiver: receiver, args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else if method_name == "sort_by" {
        emit_rust_sort_by_method_call(receiver: receiver, args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else if method_name == "map" {
        emit_rust_map_method_call(receiver: receiver, args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else {
        match rust_higher_order_methods |> filter(s => s.method_name == method_name) |> first {
          Present { value: ho_spec } =>
            emit_rust_higher_order_method(ho_spec: ho_spec, receiver: receiver, args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
          Absent =>
      if method_name == "get" {
        emit_rust_get_method_call(receiver: receiver, args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else if method_name == "with" {
        emit_rust_with_method_call(receiver: receiver, args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else if method_name == "string_contains" {
        emit_rust_generic_method_call(method_name: "string_contains", receiver: receiver, args: args, result_type: result_type, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else if method_name == "concat" {
        let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
        let arg_strs = args |> map(a => emit_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024))
        let all_arg_strs = concat([recv_str], arg_strs)
        emit_nested_rt_concat(remaining: all_arg_strs, acc: "", shared_types: shared_types)
      } else if method_name == "first" {
        emit_rust_first_method_call(receiver: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else {
        let recv_str_raw = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
        let recv_is_optional = resolved_type(n: receiver).return_cardinality == CardOptional
        let recv_str = if recv_is_optional {
          concat(recv_str_raw, concat(".expect(\"fail-closed: Optional receiver for method ", concat(method_name, " (empty Optional at runtime)\")")))
        } else { recv_str_raw }
        let first_arg_str = emit_typed_first_arg(args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
        match map_get(rust_method_templates(), method_name) {
          Present { value: tmpl } =>
            let bindings = seed_bindings(key: "recv", value: recv_str) |> map_insert("arg", first_arg_str)
            let raw = apply_named_template(template: tmpl, bindings: bindings)
            if rust_runtime_bridge_wraps_collection_result_in_rc(function_name: method_name) {
              concat("Rc::new(", raw, ")")
            } else { raw }
          Absent =>
            emit_rust_generic_method_call(method_name: method_name, receiver: receiver, args: args, result_type: result_type, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
        }
      }
    }
    }
    }
    PlainMethodSemantics =>
      if method == "get" && is_collection_typed_expr(texpr: receiver, source_indices: scope.type_env.source_indices) {
        emit_rust_get_method_call(receiver: receiver, args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else {
      let recv_str = emit_typed_expr(texpr: receiver, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      match map_get(rust_method_templates(), method) {
        Present { value: tmpl } =>
          let first_arg_str = emit_typed_first_arg(args: args, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
          let bindings = seed_bindings(key: "recv", value: recv_str) |> map_insert("arg", first_arg_str)
          let raw = apply_named_template(template: tmpl, bindings: bindings)
          if rust_runtime_bridge_wraps_collection_result_in_rc(function_name: method) {
            concat("Rc::new(", raw, ")")
          } else { raw }
        Absent =>
          let arg_strs = args |> map(a => emit_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024))
          let args_str = arg_strs |> join(separator: ", ")
          concat(recv_str, ".", emit_ident(name: method, target: Rust), "(", args_str, ")")
      }
      }
  } }
  else { "compile_error!(\"method call missing reconcile semantics\")" }
}

fn emit_typed_first_arg(args: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match args |> first {
    Present { value: a } => emit_typed_expr(texpr: arg_value(n: a), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
    Absent => "compile_error!(\"missing method argument\")"
  }
}

fn freemonoid_match_arm_for(arms: List<Node>, variant: String) -> Node? {
  arms |> filter(arm => match arm_pattern(n: arm) {
    VariantPattern { name: n, parent_enum: _, field_bindings: _ } => n == variant
    _ => false
  }) |> first
}

fn freemonoid_cons_binding(cons_arm: Node, field: String, source_indices: Map<String, NewlineIndex>) -> String {
  match arm_pattern(n: cons_arm) {
    VariantPattern { name: _, parent_enum: _, field_bindings: fbs } =>
      match fbs |> filter(fb => field_binding_name_at(n: fb, source_indices: source_indices) == field) |> first {
        Present { value: fb } =>
          match field_binding_pattern(n: fb) {
            Bind { declaration: nm } => nm.name
            _ => "_"
          }
        Absent => "_"
      }
    _ => "_"
  }
}

fn arm_resolved_parent_enum(arm: Node, scrut_type: String, type_summaries: Map<String, TypeSummary>) -> String? {
  match arm_pattern(n: arm) {
    VariantPattern { name: n, parent_enum: pe, field_bindings: _ } =>
      pattern_parent_enum(name: qualified_last_segment(name: n), parent_enum: pe, scrut_type: scrut_type, type_summaries: type_summaries)
    _ => none
  }
}

fn parent_enum_is_freemonoid(p: String?) -> Bool {
  match p {
    Present { value: nm } => nm == "FreeMonoid"
    Absent => false
  }
}

fn freemonoid_catchall_arm(arms: List<Node>) -> Node? {
  arms |> filter(arm => match arm_pattern(n: arm) {
    Wildcard => true
    Bind { declaration: _ } => true
    _ => false
  }) |> first
}

fn freemonoid_catchall_bind_name(arm: Node) -> String {
  match arm_pattern(n: arm) {
    Bind { declaration: nm } => nm.name
    _ => ""
  }
}

fn arms_are_freemonoid_coproduct(arms: List<Node>, scrut_type: String, type_summaries: Map<String, TypeSummary>) -> Bool {
  let has_empty = match freemonoid_match_arm_for(arms: arms, variant: "Empty") { Present { value: _ } => true  Absent => false }
  let has_cons = match freemonoid_match_arm_for(arms: arms, variant: "Cons") { Present { value: _ } => true  Absent => false }
  let empty_is_fm = match freemonoid_match_arm_for(arms: arms, variant: "Empty") {
    Present { value: ea } => parent_enum_is_freemonoid(p: arm_resolved_parent_enum(arm: ea, scrut_type: scrut_type, type_summaries: type_summaries))
    Absent => false
  }
  let cons_is_fm = match freemonoid_match_arm_for(arms: arms, variant: "Cons") {
    Present { value: ca } => parent_enum_is_freemonoid(p: arm_resolved_parent_enum(arm: ca, scrut_type: scrut_type, type_summaries: type_summaries))
    Absent => false
  }
  let has_catchall = match freemonoid_catchall_arm(arms: arms) { Present { value: _ } => true  Absent => false }
  let is_fm = empty_is_fm || cons_is_fm
  let empty_fillable = has_empty || has_catchall
  let cons_fillable = has_cons || has_catchall
  is_fm && empty_fillable && cons_fillable
}

fn freemonoid_tail_let_from_fm(tail_bind: String) -> String {
  if tail_bind == "_" { "" } else { concat("let ", tail_bind, ": Rc<Vec<_>> = Rc::new((*__fm).iter().skip(1).cloned().collect()); ") }
}

fn freemonoid_empty_branch_body(empty_arm: Node?, catchall: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match empty_arm {
    Present { value: ea } => emit_typed_expr(texpr: arm_body(n: ea), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
    Absent => match catchall {
      Present { value: wa } =>
        let bn = freemonoid_catchall_bind_name(arm: wa)
        let bind_let = if bn == "" { "" } else { concat("let ", bn, " = __fm.clone(); ") }
        concat(bind_let, emit_typed_expr(texpr: arm_body(n: wa), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024))
      Absent => ""
    }
  }
}

fn freemonoid_nonempty_branch_body(cons_arm: Node?, catchall: Node?, si: Map<String, NewlineIndex>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match cons_arm {
    Present { value: ca } =>
      let head_bind = freemonoid_cons_binding(cons_arm: ca, field: "head", source_indices: si)
      let tail_bind = freemonoid_cons_binding(cons_arm: ca, field: "tail", source_indices: si)
      let head_let = if head_bind == "_" { "" } else { concat("let ", head_bind, " = (*__fm)[0].clone(); ") }
      let tail_let = freemonoid_tail_let_from_fm(tail_bind: tail_bind)
      concat(head_let, tail_let, emit_typed_expr(texpr: arm_body(n: ca), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024))
    Absent => match catchall {
      Present { value: wa } =>
        let bn = freemonoid_catchall_bind_name(arm: wa)
        let bind_let = if bn == "" { "" } else { concat("let ", bn, " = __fm.clone(); ") }
        concat(bind_let, emit_typed_expr(texpr: arm_body(n: wa), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024))
      Absent => ""
    }
  }
}

fn emit_native_freemonoid_match(scrut_str: String, arms: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  let empty_arm = freemonoid_match_arm_for(arms: arms, variant: "Empty")
  let cons_arm = freemonoid_match_arm_for(arms: arms, variant: "Cons")
  let catchall = freemonoid_catchall_arm(arms: arms)
  let empty_body = freemonoid_empty_branch_body(empty_arm: empty_arm, catchall: catchall, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  let nonempty_body = freemonoid_nonempty_branch_body(cons_arm: cons_arm, catchall: catchall, si: si, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  if empty_body == "" || nonempty_body == "" { "" } else {
    concat("{ let __fm = ", scrut_str, "; if __fm.is_empty() { ", empty_body, " } else { ", nonempty_body, " } }")
  }
}

fn emit_typed_match(scrutinee: Node, arms: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let scrut_str = emit_typed_expr(texpr: scrutinee, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let scrut_type = match scrutinee.inferred {
    Present { value: Resolved { node: rt } } =>
      let is_optional = rt.return_cardinality == CardOptional
      if is_optional {
        authored_name_at(source_indices: scope.type_env.source_indices, node: with_required_cardinality(n: rt))
      } else { authored_name_at(source_indices: scope.type_env.source_indices, node: rt) }
    _ => ""
  }
  let native_fm = if arms_are_freemonoid_coproduct(arms: arms, scrut_type: scrut_type, type_summaries: emit_info.type_summaries) {
    emit_native_freemonoid_match(scrut_str: scrut_str, arms: arms, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  } else { "" }
  if native_fm != "" { return native_fm }
  let rc_match = analyze_rc_match(scrutinee: scrutinee, arms: arms, scrut_type: scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: scope.type_env.source_indices)
  let match_result_type = match arms |> first {
    Present { value: first_arm } => resolved_type(n: arm_body(n: first_arm))
    Absent => type_variable_node(id: "match_result")
  }
  let arm_strs = arms |> map(arm => emit_typed_match_arm(arm: arm, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, scrut_type: scrut_type, match_result_type: match_result_type, string_from_mode: false))
  let arms_str = arm_strs |> join(separator: "\n")

  let needs_as_str = all_arms_are_string_lit(arms: arms) && arms |> count > 0
  let needs_string_from = has_string_lit_with_bind(arms: arms)
  if rc_match.needs_rc_option_ref {
    concat("match ", scrut_str, ".as_ref() {\n", arms_str, "\n}")
  } else if rc_match.needs_option_deref {
    concat("match ", scrut_str, ".as_deref()", clone_iterator_suffix(), " {\n", arms_str, "\n}")
  } else if rc_match.needs_deref {
    let sharing = language_spec(target: Rust).sharing
    concat("match ", apply_type_template1(template: sharing.deref_clone, arg0: scrut_str), " {\n", arms_str, "\n}")
  } else if needs_as_str {
    concat("match ", scrut_str, ".as_str() {\n", arms_str, "\n}")
  } else if needs_string_from {
    let sf_arm_strs = arms |> map(arm => emit_typed_match_arm(arm: arm, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, scrut_type: scrut_type, match_result_type: match_result_type, string_from_mode: true))
    let sf_arms_str = sf_arm_strs |> join(separator: "\n")
    concat("match ", scrut_str, " {\n", sf_arms_str, "\n}")
  } else {
    concat("match ", scrut_str, " {\n", arms_str, "\n}")
  }
}

fn emit_typed_match_arm(arm: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo, scrut_type: String, match_result_type: Node, string_from_mode: Bool) -> String {
  let arm_pat = arm_pattern(n: arm)
  let arm_g = arm_guard(n: arm)
  let arm_b = arm_body(n: arm)
  let si = scope.type_env.source_indices
  let rc_analysis_raw = analyze_rc_pattern(pattern: arm_pat, scrut_type: scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: si)
  let rc_analysis = rc_pattern_analysis_with_box_fields(rc_analysis: rc_analysis_raw, arm_pat: arm_pat, shared_types: shared_types, emit_info: emit_info, scope: scope)
  let pat_str = if string_from_mode {
    match arm_pat {
      LitPattern { value: v } => match v {
        LitStr { value: s } => concat("ref __s if __s == \"", escape_string_literal_body(s: s), "\"")
        _ => rust_literal_for_pattern(value: v)
      }
      _ => emit_pattern(pattern: arm_pat, path_prefix: [], shared_types: shared_types, scrut_type: scrut_type, source_indices: si, emit_info: emit_info)
    }
  } else if rc_analysis.needs_rc_pattern {
    emit_pattern_rc_aware(pattern: arm_pat, path_prefix: [], rc_analysis: rc_analysis, shared_types: shared_types, scrut_type: scrut_type, source_indices: si, emit_info: emit_info)
  } else {
    emit_pattern(pattern: arm_pat, path_prefix: [], shared_types: shared_types, scrut_type: scrut_type, source_indices: si, emit_info: emit_info)
  }
  let field_guards = collect_pattern_string_guards(pattern: arm_pat, path_prefix: [], source_indices: si)
  let arm_guard_str = match arm_g {
    Present { value: g } => emit_typed_expr(texpr: g, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
    Absent => ""
  }
  let guard_str = if field_guards != "" && arm_guard_str != "" {
    concat(" if ", field_guards, " && ", arm_guard_str)
  } else if field_guards != "" {
    concat(" if ", field_guards)
  } else if arm_guard_str != "" {
    concat(" if ", arm_guard_str)
  } else { "" }
  let body_str = match arm_b.expr_data {
    ExprVar { binding_kind: body_binding_kind } =>
      let body_name = expr_var_name_at(texpr: arm_b, source_indices: si)
      if variant_parent_from_binding_kind(binding_kind: body_binding_kind) != none {
        emit_var_ref(name: body_name, binding_kind: body_binding_kind, resolved_type: Present { value: Resolved { node: match_result_type } }, shared_types: shared_types, registry: registry, emit_info: emit_info, source_indices: si)
      } else {
        emit_typed_expr(texpr: arm_b, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      }
    _ => emit_typed_expr(texpr: arm_b, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  }
  if rc_analysis.needs_rc_pattern {
    let prelude = rc_pattern_preludes(pattern: arm_pat, rc_analysis: rc_analysis, shared_types: shared_types, source_indices: si, emit_info: emit_info)
    concat("    ", pat_str, guard_str, " => { ", prelude, " ", body_str, " },")
  } else {
    concat("    ", pat_str, guard_str, " => ", body_str, ",")
  }
}

fn emit_typed_if(condition: Node, then_branch: Node, else_branch: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let cond_str = emit_typed_expr(texpr: condition, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  emit_typed_if_shared(cond_str: cond_str, then_branch: then_branch, else_branch: else_branch,
    if_result_type: none, depth: depth, target: Rust, source_indices: scope.type_env.source_indices,
    recurse: (node, d) => emit_typed_expr(texpr: node, registry: registry, scope: scope, depth: d, shared_types: shared_types, emit_info: emit_info, fuel: 1024))
}

fn emit_typed_let(name: String, value: Node, body: Node?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let val_str = emit_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  emit_typed_let_shared(name: name, value_str: val_str, body: body, target: Rust,
    recurse: (bd, sc) => emit_typed_expr(texpr: bd, registry: registry, scope: sc, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024),
    scope: scope, value_node: value)
}

fn is_optional_struct_field(emit_info: EmitGraphInfo, struct_name: String, field_name: String) -> Bool {
  match lookup_emit_type_summary(emit_info: emit_info, type_name: struct_name) {
    Present { value: summary } =>
      match map_get(summary.field_summaries, field_name) {
        Present { value: field_summary } =>
          match field_summary.value_shape {
            OptionalValue => true
            _ => false
          }
        Absent => false
      }
    Absent => false
  }
}

fn rust_struct_field_lookup_candidates(struct_name: String, scope: InferScope) -> List<String> {
  let from_template = match container_template_algebra(name: struct_name) {
    Present { value: algebra } => if algebra != "" && algebra != struct_name { [algebra] } else { [] }
    Absent => []
  }
  let from_resolve = match lookup_type_by_name(env: scope.type_env, name: struct_name) {
    Present { value: type_node } =>
      let resolved = resolve_node(n: type_node, env: scope.type_env, module_name: scope.module_name).resolved
      let resolved_name = authored_name_at(source_indices: scope.type_env.source_indices, node: resolved)
      if resolved_name != "" && resolved_name != struct_name { [resolved_name] } else { [] }
    Absent => []
  }
  unique_strings(items: concat([struct_name], concat(from_template, from_resolve)))
}

fn rust_struct_field_type_node(scope: InferScope, struct_name: String, field_name: String) -> Node? {
  match lookup_type_by_name(env: scope.type_env, name: struct_name) {
    Present { value: struct_node } => rust_struct_field_type_node_from_container(container: struct_node, field_name: field_name, source_indices: scope.type_env.source_indices)
    Absent => none
  }
}

fn rust_record_field_needs_fn_rc(scope: InferScope, struct_name: String, field_name: String) -> Bool {
  rust_struct_field_lookup_candidates(struct_name: struct_name, scope: scope) |> any(candidate =>
    match rust_struct_field_type_node(scope: scope, struct_name: candidate, field_name: field_name) {
      Present { value: field_type } => field_type.connective == Arrow
      Absent => false
    }
  )
}

fn rust_receiver_has_callable_method_field(receiver: Node, method_name: String, scope: InferScope) -> Bool {
  if map_contains_key(rt_functions(), method_name) {
    false
  } else {
    let receiver_type = resolved_type(n: receiver)
    let receiver_type_name = authored_name_at(source_indices: scope.type_env.source_indices, node: receiver_type)
    rust_record_field_needs_fn_rc(scope: scope, struct_name: receiver_type_name, field_name: method_name)
  }
}

fn rust_struct_field_type_node_variant_aware(scope: InferScope, emit_info: EmitGraphInfo, struct_name: String, field_name: String) -> Node? {
  match rust_struct_field_type_node(scope: scope, struct_name: struct_name, field_name: field_name) {
    Present { value: n } => Present { value: n }
    Absent =>
      match map_get(emit_info.variant_to_enum, struct_name) {
        Present { value: enum_name } =>
          if enum_name == "" { none } else {
            match lookup_type_by_name(env: scope.type_env, name: enum_name) {
              Present { value: enum_node } =>
                match find_child_named(n: enum_node, name: struct_name, source_indices: scope.type_env.source_indices) {
                  Present { value: variant_node } => rust_struct_field_type_node_from_container(container: variant_node, field_name: field_name, source_indices: scope.type_env.source_indices)
                  Absent => none
                }
              Absent => none
            }
          }
        Absent => none
      }
  }
}

fn rust_struct_field_type_node_from_container(container: Node, field_name: String, source_indices: Map<String, NewlineIndex>) -> Node? {
  match find_child_named(n: container, name: field_name, source_indices: source_indices) {
    Present { value: field_node } => Present { value: resolved_type(n: field_node) }
    Absent => none
  }
}

fn rust_record_field_needs_box(scope: InferScope, emit_info: EmitGraphInfo, shared_types: Set<String>, struct_name: String, field_name: String) -> Bool {
  match rust_struct_field_type_node_variant_aware(scope: scope, emit_info: emit_info, struct_name: struct_name, field_name: field_name) {
    Present { value: field_type } =>
      needs_box_wrapping(n: field_type, recursive_types: emit_info.recursive_type_set, shared_types: shared_types, source_indices: scope.type_env.source_indices)
    Absent => false
  }
}

fn wrap_rust_record_field_value(raw: String, scope: InferScope, emit_info: EmitGraphInfo, shared_types: Set<String>, struct_name: String, field_name: String) -> String {
  let is_bounded_lattice_field = struct_name == "BoundedLattice"
  if rust_record_field_needs_fn_rc(scope: scope, struct_name: struct_name, field_name: field_name) {
    concat("Rc::new(", raw, ")")
  } else if is_bounded_lattice_field && (field_name == "meet" || field_name == "join") {
    concat("Rc::new(", raw, ")")
  } else if rust_record_field_needs_box(scope: scope, emit_info: emit_info, shared_types: shared_types, struct_name: struct_name, field_name: field_name) {
    concat("Box::new(", raw, ")")
  } else {
    raw
  }
}

fn is_already_optional(texpr: Node, emit_info: EmitGraphInfo, scope: InferScope) -> Bool {
  let si = scope.type_env.source_indices
  let n = expr_var_name_at(texpr: texpr, source_indices: si)
  let tn = record_lit_type_name_at(texpr: texpr, source_indices: si)
  let f = field_access_field_at(texpr: texpr, source_indices: si)
  match texpr.expr_data {
    ExprLiteral { value: v } => match v { LitNull => true, _ => false }
    ExprVar { binding_kind: binding_kind } =>
      if is_optional_variant_name(name: n) && match variant_parent_from_binding_kind(binding_kind: binding_kind) {
        Present { value: parent } => is_optional_like_parent_name(name: parent)
        Absent => false
      } {
        true
      } else if n == "none" || n == "None" {
        true
      } else {
        match texpr.inferred {
          Present { value: Resolved { node: rt } } => rt.return_cardinality == CardOptional
          _ =>
            match map_get(scope.locals, n) {
              Present { value: binding } => binding.resolved.return_cardinality == CardOptional
              Absent => false
            }
        }
      }
    ExprRecordLit { parent_enum: parent } =>
      match tn {
        Present { value: name } =>
          is_optional_variant_name(name: name) && match parent {
            Present { value: p } => is_optional_like_parent_name(name: p)
            Absent => false
          }
        Absent => false
      }
    ExprFieldAccess { summary: fa_summary } =>
      let b = field_access_base(texpr: texpr)
      let summary_says_optional = match fa_summary {
        Present { value: fs } => match fs.value_shape { OptionalValue => true, _ => false }
        Absent => false
      }
      if summary_says_optional { true }
      else {
        match b.inferred {
          Present { value: Resolved { node: base_type } } =>
            let resolved_base = base_type
            if is_optional_struct_field(emit_info: emit_info, struct_name: authored_name_at(source_indices: scope.type_env.source_indices, node: resolved_base), field_name: f) {
              true
            } else {
              match texpr.inferred {
                Present { value: Resolved { node: rt } } => rt.return_cardinality == CardOptional
                _ => false
              }
            }
          _ =>
            match texpr.inferred {
              Present { value: Resolved { node: rt } } => rt.return_cardinality == CardOptional
              _ => false
            }
        }
      }
    _ =>
      match texpr.inferred {
        Present { value: Resolved { node: rt } } => rt.return_cardinality == CardOptional
        _ => false
      }
  }
}

fn lookup_struct_field_type_name(struct_node: Node, field_name: String, variant_name: String?, source_indices: Map<String, NewlineIndex>) -> String? {
  let direct = match find_child_named(n: struct_node, name: field_name, source_indices: source_indices) {
    Present { value: field_child } =>
      if field_child.inferred != none {
        let field_type = resolved_type(n: field_child)
        let ft_is_type_var = if field_type.inferred != none { is_type_variable(inferred: field_type.inferred.value) } else { false }
        if field_type.ident_span != none && !ft_is_type_var {
          Present { value: authored_name_at(source_indices: source_indices, node: field_type) }
        } else { none }
      } else { none }
    Absent => none
  }
  match direct {
    Present { value: _ } => direct
    Absent =>
      match variant_name {
        Present { value: vn } =>
          match find_child_named(n: struct_node, name: vn, source_indices: source_indices) {
            Present { value: variant_child } =>
              match find_child_named(n: variant_child, name: field_name, source_indices: source_indices) {
                Present { value: field_child } =>
                  if field_child.inferred != none {
                    let field_type = resolved_type(n: field_child)
                    let ft_is_type_var = if field_type.inferred != none { is_type_variable(inferred: field_type.inferred.value) } else { false }
                    if field_type.ident_span != none && !ft_is_type_var {
                      Present { value: authored_name_at(source_indices: source_indices, node: field_type) }
                    } else { none }
                  } else { none }
                Absent => none
              }
            Absent => none
          }
        Absent => none
      }
  }
}

fn emit_field_value_with_context(field_value: Node, struct_node: Node, outer_type_name: String?, field_name: String, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match field_value.expr_data {
    ExprRecordLit { parent_enum: pe } =>
      let inner_fields = field_value.children
      let tn = record_lit_type_name_at(texpr: field_value, source_indices: scope.type_env.source_indices)
      match tn {
        Present { value: variant_name } =>
          let node_lookup = lookup_struct_field_type_name(struct_node: struct_node, field_name: field_name, variant_name: outer_type_name, source_indices: scope.type_env.source_indices)
          let expected_type = match node_lookup {
            Present { value: _ } => node_lookup
            Absent =>
              if struct_node.ident_span != none {
                match lookup_emit_type_summary(emit_info: emit_info, type_name: authored_name_at(source_indices: scope.type_env.source_indices, node: struct_node)) {
                  Present { value: summary } => map_get(summary.field_type_map, field_name)
                  Absent => none
                }
              } else { none }
          }
          let corrected_parent = match expected_type {
            Present { value: et } =>
              if variant_belongs_to_enum(type_summaries: emit_info.type_summaries, variant_name: variant_name, enum_name: et) {
                Present { value: et }
              } else { pe }
            Absent => pe
          }
          let raw = emit_typed_record_lit(type_name: tn, fields: inner_fields, parent_enum: corrected_parent, resolved_type: resolved_type(n: field_value), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
          let rc_name = match corrected_parent {
            Present { value: en } => en
            Absent => variant_name
          }
          if rc_name != "" && set_contains(shared_types, rc_name) {
            concat("Rc::new(", raw, ")")
          } else { raw }
        Absent =>
          emit_typed_expr(texpr: field_value, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      }
    _ =>
      emit_typed_expr(texpr: field_value, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  }
}

fn struct_candidates_by_field_names(field_names: List<String>, type_summaries: Map<String, TypeSummary>) -> List<TypeSummary> {
  let n_fields = field_names |> count
  if n_fields == 0 { return [] }
  map_values(type_summaries) |> filter(summary =>
    match summary.repr {
      StructRepr =>
        let ftm_keys = sorted_map_keys(summary.field_type_map)
        if ftm_keys |> count == n_fields {
          field_names |> all(fn_name => map_contains_key(summary.field_type_map, fn_name))
        } else { false }
      _ => false
    }
  )
}

fn find_struct_name_by_fields(field_names: List<String>, field_type_hints: Map<String, String>, type_summaries: Map<String, TypeSummary>) -> String? {
  let candidates = struct_candidates_by_field_names(field_names: field_names, type_summaries: type_summaries)
  if candidates |> count <= 1 {
    match candidates |> first {
      Present { value: s } => Present { value: s.name }
      Absent => none
    }
  } else {
    let typed_candidates = candidates |> filter(cand =>
      sorted_map_keys(field_type_hints) |> all(fname =>
        match map_get(field_type_hints, fname) {
          Present { value: hint_type } =>
            match map_get(cand.field_type_map, fname) {
              Present { value: cand_type } => cand_type == hint_type
              Absent => true
            }
          Absent => true
        }
      )
    )
    if typed_candidates |> count == 1 {
      match typed_candidates |> first {
        Present { value: s } => Present { value: s.name }
        Absent => none
      }
    } else {
      match candidates |> sort_by(c => c.name) |> first {
        Present { value: s } => Present { value: s.name }
        Absent => none
      }
    }
  }
}

fn find_unique_struct_name_by_fields(field_names: List<String>, type_summaries: Map<String, TypeSummary>) -> String? {
  let candidates = struct_candidates_by_field_names(field_names: field_names, type_summaries: type_summaries)
  if candidates |> count == 1 {
    match candidates |> first {
      Present { value: s } => Present { value: s.name }
      Absent => none
    }
  } else { none }
}

fn emit_typed_record_lit(type_name: String?, fields: List<Node>, parent_enum: String?, resolved_type: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let struct_name = explicit_record_struct_name(type_name: type_name, inferred_node: resolved_type, shared_types: shared_types, source_indices: scope.type_env.source_indices)
  let qualified_name = match struct_name {
    Present { value: sn } => Present { value: sn }
    Absent =>
      let rt_name = authored_name_at(source_indices: scope.type_env.source_indices, node: resolved_type)
      if resolved_type.ident_span != none && map_contains_key(emit_info.type_summaries, rt_name) {
        Present { value: rt_name }
      } else { none }
  }
  let bare_qualified_name = match qualified_name {
    Present { value: qn } => Present { value: qualified_last_segment(name: qn) }
    Absent => none
  }
  let bare_parent_enum = match parent_enum {
    Present { value: pe } => Present { value: qualified_last_segment(name: pe) }
    Absent => none
  }
  match bare_qualified_name {
    Absent =>
      let is_product = is_product_type(n: resolved_type)
      if is_product && resolved_type.ident_span == none {
        if fields |> count == 1 {
          match fields |> first {
            Present { value: f } =>
              let fname0 = field_init_node_name_at(n: f, source_indices: scope.type_env.source_indices)
              let fval0 = emit_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
              let single_field_names = fields |> map(ff => field_init_node_name_at(n: ff, source_indices: scope.type_env.source_indices))
              match find_unique_struct_name_by_fields(field_names: single_field_names, type_summaries: emit_info.type_summaries) {
                Present { value: r_sn } =>
                  if rust_record_field_needs_fn_rc(scope: scope, struct_name: r_sn, field_name: fname0) {
                    let wrapped_val = wrap_rust_record_field_value(raw: fval0, scope: scope, emit_info: emit_info, shared_types: shared_types, struct_name: r_sn, field_name: fname0)
                    let struct_lit = concat(r_sn, " {\n    ", emit_ident(name: fname0, target: Rust), ": ", wrapped_val, ",\n}")
                    if set_contains(shared_types, r_sn) {
                      concat("Rc::new(", struct_lit, ")")
                    } else { struct_lit }
                  } else { fval0 }
                Absent => fval0
              }
            Absent => "compile_error!(\"empty anonymous record literal\")"
          }
        } else {
          let lit_field_names = fields |> map(f => field_init_node_name_at(n: f, source_indices: scope.type_env.source_indices))
          let field_type_hints = fold(fields, init: empty_map(), f: (acc, f) =>
            let fname = field_init_node_name_at(n: f, source_indices: scope.type_env.source_indices)
            let fval = field_init_node_value(n: f)
            match fval.inferred {
              Present { value: Resolved { node: type_node } } =>
                map_insert(acc, fname, authored_name_at(source_indices: scope.type_env.source_indices, node: type_node))
              _ => acc
            }
          )
          match find_struct_name_by_fields(field_names: lit_field_names, field_type_hints: field_type_hints, type_summaries: emit_info.type_summaries) {
            Present { value: resolved_sn } =>
              let field_strs = fields |> map(f =>
                let fname = field_init_node_name_at(n: f, source_indices: scope.type_env.source_indices)
                let fval = emit_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
                concat("    ", emit_ident(name: fname, target: Rust), ": ", fval, ",")
              )
              let body = field_strs |> join(separator: "\n")
              let struct_lit = concat(resolved_sn, " {\n", body, "\n}")
              if set_contains(shared_types, resolved_sn) {
                concat("Rc::new(", struct_lit, ")")
              } else { struct_lit }
            Absent =>
              let vals = fields |> map(f =>
                emit_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
              )
              concat("(", vals |> join(separator: ", "), ")")
          }
        }
      } else {
        "compile_error!(\"cannot resolve anonymous record type in emitter\")"
      }
    Present { value: tn } =>
      let si = scope.type_env.source_indices
      let tn_is_known_struct = map_contains_key(emit_info.type_summaries, tn)
      let ctor_name = if tn_is_known_struct { tn }
        else {
          let resolved_struct = resolve_node(n: resolved_type, env: scope.type_env, module_name: scope.module_name).resolved
          if (resolved_struct.connective == Conj) {
            let resolved_field_names = resolved_struct.children |> map(c => authored_name_at(source_indices: si, node: c))
            match find_unique_struct_name_by_fields(field_names: resolved_field_names, type_summaries: emit_info.type_summaries) {
              Present { value: canonical } => if (canonical != tn) { canonical } else { tn }
              Absent => tn
            }
          } else { tn }
        }
      let ctor_alias_resolved = ctor_name != tn
      let context_lookup = contextual_variant_parent(variant_name: tn, parent_enum: bare_parent_enum, resolved_type: resolved_type, emit_info: emit_info, source_indices: si)
      let effective_parent = match context_lookup {
        Present { value: context_parent } => Present { value: context_parent }
        Absent =>
          let rt_is_type_var = if resolved_type.inferred != none { is_type_variable(inferred: resolved_type.inferred.value) } else { false }
          let rt_name = qualified_last_segment(name: authored_name_at(source_indices: si, node: resolved_type))

          if resolved_type.ident_span != none && rt_name != tn && !rt_is_type_var && rt_name != "Error"
            && variant_belongs_to_enum(type_summaries: emit_info.type_summaries, variant_name: tn, enum_name: rt_name) {
            Present { value: rt_name }
          } else {
            bare_parent_enum
          }
      }
      let host_freemonoid_cons = tn == "Cons"
        && (match effective_parent { Present { value: p } => p == "FreeMonoid"  Absent => false })
      if host_freemonoid_cons {
        let head_val = match fields |> filter(f => field_init_node_name_at(n: f, source_indices: si) == "head") |> first {
          Present { value: f } => emit_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          Absent => "compile_error!(\"FreeMonoid Cons missing head field\")"
        }
        let tail_val = match fields |> filter(f => field_init_node_name_at(n: f, source_indices: si) == "tail") |> first {
          Present { value: f } => emit_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          Absent => "compile_error!(\"FreeMonoid Cons missing tail field\")"
        }
        return concat("{ let mut __cons_v = (*", tail_val, ").clone(); __cons_v.insert(0, ", head_val, "); __cons_v }")
      }
      let optional_variant = is_optional_variant_name(name: tn) && (is_optional_parent(parent_enum: bare_parent_enum) || is_optional_parent(parent_enum: effective_parent) || resolved_type.return_cardinality == CardOptional)
      let rust_tn = if optional_variant {
        if is_some_like_variant_name(name: tn) { "Some" } else { "None" }
      } else { tn }
      let display_tn = if optional_variant { rust_tn }
        else {
          rust_witness_variant_ctor_path(variant_name: rust_tn, ctor_name: ctor_name, effective_parent: effective_parent, resolved_type: resolved_type, fields: fields, shared_types: shared_types, emit_info: emit_info, source_indices: si)
        }
      if optional_variant && is_some_like_variant_name(name: tn) && fields |> count == 1 {
        match fields |> first {
          Present { value: f } =>
            let inner = emit_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
            concat("Some(", inner, ")")
          Absent => concat(display_tn, " {}")
        }
      } else if fields |> count == 0 {
        let host_freemonoid_carrier = authored_name_at(source_indices: si, node: resolved_type)
        match rust_seed_host_freemonoid_empty(carrier_name: host_freemonoid_carrier, corpus_repr: emit_info.corpus_repr) {
          Present { value: grounded } => grounded
          Absent => concat(display_tn, " {}")
        }
      } else {
        let variant_summary_name = match effective_parent {
          Present { value: parent } => variant_summary_key(enum_name: parent, variant_name: tn)
          Absent => ctor_name
        }
        let is_positional_ctor = fields |> count == 1 && match fields |> first {
          Present { value: f } => field_init_node_name_at(n: f, source_indices: si) == "0"
          Absent => false
        }
        if is_positional_ctor {
          match fields |> first {
            Present { value: f } =>
              let f_value = field_init_node_value(n: f)
              let val_str = emit_field_value_with_context(field_value: f_value, struct_node: resolved_type, outer_type_name: bare_qualified_name, field_name: "0", registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
              let needs_wrap = is_optional_struct_field(emit_info: emit_info, struct_name: variant_summary_name, field_name: "0")
                && is_already_optional(texpr: f_value, emit_info: emit_info, scope: scope) == false
              let field_val = if needs_wrap {
                concat("Some(", val_str, ")")
              } else { val_str }
              concat(display_tn, "(", field_val, ")")
            Absent => concat(display_tn, "()")
          }
        } else {
        let field_strs = fields |> map(f =>
          let f_name = field_init_node_name_at(n: f, source_indices: scope.type_env.source_indices)
          let f_value = field_init_node_value(n: f)
          let val_str = emit_field_value_with_context(field_value: f_value, struct_node: resolved_type, outer_type_name: bare_qualified_name, field_name: f_name, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
          let needs_wrap = is_optional_struct_field(emit_info: emit_info, struct_name: variant_summary_name, field_name: f_name)
            && is_already_optional(texpr: f_value, emit_info: emit_info, scope: scope) == false
          let field_val = if needs_wrap {
            concat("Some(", val_str, ")")
          } else { val_str }
          let stored_val = wrap_rust_record_field_value(raw: field_val, scope: scope, emit_info: emit_info, shared_types: shared_types, struct_name: ctor_name, field_name: f_name)
          concat("    ", emit_ident(name: f_name, target: Rust), ": ", stored_val, ",")
        )
        let provided_names = fields |> map(f => field_init_node_name_at(n: f, source_indices: scope.type_env.source_indices))
        let provided_set = fold(provided_names, init: empty_map(), f: (acc, n) => map_insert(acc, n, true))
        let summary = lookup_emit_type_summary(emit_info: emit_info, type_name: variant_summary_name)
        let default_strs = match summary {
          Present { value: s } =>
            let fs = s.field_summaries
            let ftm = s.field_type_map
            let missing = sorted_map_keys(fs) |> filter(k => !emit_map_has(m: provided_set, key: k))
            let all_defaultable = missing |> all(fname =>
              let has_zv = match map_get(ftm, fname) {
                Present { value: ft } => match rust_zero_value(type_name: ft, corpus_repr: emit_info.corpus_repr) { Present { value: _ } => true, Absent => false }
                Absent => false
              }
              has_zv || is_optional_struct_field(emit_info: emit_info, struct_name: variant_summary_name, field_name: fname)
            )
            if all_defaultable {
              missing |> flat_map(fname =>
                if is_optional_struct_field(emit_info: emit_info, struct_name: variant_summary_name, field_name: fname) {
                  let wrapped_none = wrap_rust_record_field_value(raw: "None", scope: scope, emit_info: emit_info, shared_types: shared_types, struct_name: ctor_name, field_name: fname)
                  [concat("    ", emit_ident(name: fname, target: Rust), ": ", wrapped_none, ",")]
                } else {
                  match map_get(ftm, fname) {
                    Present { value: ft } =>
                      match rust_zero_value(type_name: ft, corpus_repr: emit_info.corpus_repr) {
                        Present { value: zv } => [concat("    ", emit_ident(name: fname, target: Rust), ": ", zv, ",")]
                        Absent => []
                      }
                    Absent => []
                  }
                }
              )
            } else { [] }
          Absent => []
        }

        let phantom_strs = match lookup_type_by_name(env: scope.type_env, name: ctor_name) {
          Present { value: struct_decl } =>
            let is_struct = struct_decl.connective == Conj
            let pnames = struct_decl.params |> map(p => generic_param_name_at(n: p, source_indices: si))
            let unused = struct_unused_param_names(generic_param_names: pnames, children: struct_decl.children, source_indices: si)
            let has_unused = (unused |> count) > 0
            if is_struct && has_unused {
              [concat("    ", rust_phantom_field_name(), ": std::marker::PhantomData,")]
            } else { [] }
          Absent => []
        }
        let all_field_strs = concat(concat(field_strs, default_strs), phantom_strs)
        let fields_str = all_field_strs |> join(separator: "\n")
        let raw = concat(display_tn, " {\n", fields_str, "\n}")
        if ctor_alias_resolved && set_contains(shared_types, ctor_name) {
          concat("Rc::new(", raw, ")")
        } else { raw }
        }
      }
  }
}

fn rust_zero_value(type_name: String, corpus_repr: RustCorpusRepr) -> String? {
  if type_name == "Int" { Present { value: "0" } }
  else if type_name == "Bool" { Present { value: "false" } }
  else if type_name == "String" {
    if corpus_repr_is_faithful(corpus_repr: corpus_repr) {
      Present { value: "v1_rt::freemonoid_empty::<i64>()" }
    } else {
      Present { value: "\"\".to_string()" }
    }
  }
  else { none }
}

fn emit_typed_bin_op(op: BinOp, algebra_field: AlgebraFieldKind?, left: Node, right: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let l_str = emit_typed_expr(texpr: left, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  let r_str = emit_typed_expr(texpr: right, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  if is_null_coalesce(op: op) {
    emit_null_coalesce(l_str: l_str, r_str: r_str, target: Rust)
  } else {
    let op_str = emit_bin_op_symbol(op: op, target: Rust, algebra_field: algebra_field)
    if is_string_comparison(op: op, left: left, right: right, source_indices: scope.type_env.source_indices) {
      let l_optional = is_optional_typed_expr(e: left)
      let r_optional = is_optional_typed_expr(e: right)
      if l_optional || r_optional {
        let l_cmp = if l_optional { concat(l_str, ".as_deref()") } else { concat("Some(", emit_rust_dag_string_to_host_via_seam(dag_expr: l_str, corpus_repr: emit_info.corpus_repr), ").as_deref()") }
        let r_cmp = if r_optional { concat(r_str, ".as_deref()") } else { concat("Some(", emit_rust_dag_string_to_host_via_seam(dag_expr: r_str, corpus_repr: emit_info.corpus_repr), ").as_deref()") }
        concat("(", l_cmp, " ", op_str, " ", r_cmp, ")")
      } else {
        concat("(", emit_rust_dag_string_to_host_via_seam(dag_expr: l_str, corpus_repr: emit_info.corpus_repr), " ", op_str, " ", emit_rust_dag_string_to_host_via_seam(dag_expr: r_str, corpus_repr: emit_info.corpus_repr), ")")
      }
    } else {
      let both_string = is_string_typed_expr(e: left, source_indices: scope.type_env.source_indices) && is_string_typed_expr(e: right, source_indices: scope.type_env.source_indices)
      let is_str_concat = op_str == "+" && both_string
      if is_str_concat {
        concat("(", l_str, " ", op_str, " &", r_str, ")")
      } else {
        concat("(", l_str, " ", op_str, " ", r_str, ")")
      }
    }
  }
}

fn is_optional_typed_expr(e: Node) -> Bool {
  match e.inferred {
    Present { value: Resolved { node: rt } } => rt.return_cardinality == CardOptional
    _ => false
  }
}

fn is_string_comparison(op: BinOp, left: Node, right: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match op {
    Eq => is_string_typed_expr(e: left, source_indices: source_indices) && is_string_typed_expr(e: right, source_indices: source_indices)
    Ne => is_string_typed_expr(e: left, source_indices: source_indices) && is_string_typed_expr(e: right, source_indices: source_indices)
    _ => false
  }
}

fn is_string_typed_expr(e: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match e.inferred {
    Present { value: Resolved { node: rt } } =>
      let is_optional = rt.return_cardinality == CardOptional
      let inner = if is_optional { with_required_cardinality(n: rt) } else { rt }
      is_rust_string_like(n: inner, source_indices: source_indices)
    _ => false
  }
}

fn emit_typed_string_interp(parts: List<StringPart>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let has_interpolations = parts |> any(p => match p { Interpolation { expr: _ } => true  _ => false })
  let fmt_parts = parts |> map(p => typed_interp_format_part(part: p, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, has_interpolations: has_interpolations))
  let fmt_str = fmt_parts |> map(p => p.format_segment) |> join(separator: "")
  let args = fmt_parts
    |> map(p => p.arg_expr)
    |> filter(a => a != "")
  if args |> count == 0 {
    emit_rust_host_to_dag_string_via_seam(host_expr: concat("\"", fmt_str, "\""), corpus_repr: emit_info.corpus_repr)
  } else {
    let args_str = args |> join(separator: ", ")
    emit_rust_host_to_dag_string_via_seam(host_expr: concat("format!(\"", fmt_str, "\", ", args_str, ")"), corpus_repr: emit_info.corpus_repr)
  }
}

fn typed_interp_format_part(part: StringPart, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo, has_interpolations: Bool) -> InterpPart {
  match part {
    Text { value: v } =>
      let escaped = if has_interpolations { escape_rust_interp_text(s: v) } else { escape_string_literal_body(s: v) }
      InterpPart { format_segment: escaped, arg_expr: "" }
    Interpolation { expr: e } =>
      InterpPart { format_segment: "{}", arg_expr: emit_typed_expr(texpr: e, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024) }
  }
}

fn emit_typed_block(stmts: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let state = emit_rust_block_stmts(
    remaining: stmts, text: [], scope: scope, registry: registry, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
  concat("{\n", make_indent(level: depth + 1),(state.text |> join(separator: "\n")), "\n}")
}

fn emit_tco_init_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo, params: List<Node>) -> BlockEmitState {
  match remaining |> first {
    Absent => BlockEmitState { text: text, scope: scope }
    Present { value: stmt } =>
      let rest = remaining |> skip(1)
      match rest |> first {
        Absent => BlockEmitState { text: text, scope: scope }
        Present { value: _ } =>
          let line = emit_tco_init_stmt(stmt: stmt, params: params, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
          let next_scope = scope_after_expr(texpr: stmt, scope: scope)
          emit_tco_init_block_stmts(remaining: rest,
            text: list_push(text, line), scope: next_scope,
            registry: registry, depth: depth, shared_types: shared_types, emit_info: emit_info, params: params)
      }
  }
}

fn emit_tco_init_stmt(stmt: Node, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match stmt.expr_data {
    ExprLet =>
      let n = let_binding_name_at(texpr: stmt, source_indices: scope.type_env.source_indices)
      let v = let_value(texpr: stmt)
      let val_str = emit_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let is_param = params |> any(p => param_node_name_at(n: p, source_indices: scope.type_env.source_indices) == n)
      if is_param { concat(emit_ident(name: n, target: Rust), " = ", val_str, ";") }
      else {
        emit_let_binding(name: n, value: val_str, target: Rust)
      }
    _ => emit_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  }
}

fn emit_typed_tco_body(texpr: Node, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let inner = emit_typed_tco_expr(texpr: texpr, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
  concat("loop {\n", make_indent(level: depth + 1),inner, "\n}")
}

fn emit_rust_tco_non_self_call(frame: TcoFrame, registry: Map<String, ItemInfo>, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match frame.expr.expr_data {
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let f = expr_call_func_at(texpr: frame.expr, source_indices: frame.scope.type_env.source_indices)
      let call_str = emit_typed_call(func: f, args: frame.expr.children, registry: registry, scope: frame.scope, depth: frame.depth, shared_types: shared_types, emit_info: emit_info)
      concat("break ", call_str, ";")
    _ => emit_error_expr(message: "emit_rust_tco_non_self_call expected ExprCall", target: Rust)
  }
}

fn emit_rust_tco_if(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match frame.expr.expr_data {
    ExprIf =>
      let c = if_condition(texpr: frame.expr)
      let t = if_then_branch(texpr: frame.expr)
      let e = if_else_branch(texpr: frame.expr)
      let cond_str = emit_typed_expr(texpr: c, registry: registry, scope: frame.scope, depth: frame.depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let then_str = emit_typed_tco_expr(texpr: t, fn_name: fn_name, params: params, registry: registry, scope: frame.scope, depth: frame.depth + 1, shared_types: shared_types, emit_info: emit_info)
      match e {
        Present { value: eb } =>
          let else_str = emit_typed_tco_expr(texpr: eb, fn_name: fn_name, params: params, registry: registry, scope: frame.scope, depth: frame.depth + 1, shared_types: shared_types, emit_info: emit_info)
          concat("if ", cond_str, " {\n",
            make_indent(level: frame.depth + 1), then_str, "\n} else {\n",
            make_indent(level: frame.depth + 1), else_str, "\n}")
        Absent =>
          concat("if ", cond_str, " {\n",
            make_indent(level: frame.depth + 1), then_str, "\n}")
      }
    _ => emit_error_expr(message: "emit_rust_tco_if expected ExprIf", target: Rust)
  }
}

fn freemonoid_tco_empty_branch_body(empty_arm: Node?, catchall: Node?, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match empty_arm {
    Present { value: ea } => emit_typed_tco_expr(texpr: arm_body(n: ea), fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    Absent => match catchall {
      Present { value: wa } =>
        let bn = freemonoid_catchall_bind_name(arm: wa)
        let bind_let = if bn == "" { "" } else { concat("let ", bn, " = __fm.clone(); ") }
        concat(bind_let, emit_typed_tco_expr(texpr: arm_body(n: wa), fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
      Absent => ""
    }
  }
}

fn freemonoid_tco_nonempty_branch_body(cons_arm: Node?, catchall: Node?, si: Map<String, NewlineIndex>, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match cons_arm {
    Present { value: ca } =>
      let head_bind = freemonoid_cons_binding(cons_arm: ca, field: "head", source_indices: si)
      let tail_bind = freemonoid_cons_binding(cons_arm: ca, field: "tail", source_indices: si)
      let head_let = if head_bind == "_" { "" } else { concat("let ", head_bind, " = (*__fm)[0].clone(); ") }
      let tail_let = freemonoid_tail_let_from_fm(tail_bind: tail_bind)
      concat(head_let, tail_let, emit_typed_tco_expr(texpr: arm_body(n: ca), fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
    Absent => match catchall {
      Present { value: wa } =>
        let bn = freemonoid_catchall_bind_name(arm: wa)
        let bind_let = if bn == "" { "" } else { concat("let ", bn, " = __fm.clone(); ") }
        concat(bind_let, emit_typed_tco_expr(texpr: arm_body(n: wa), fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
      Absent => ""
    }
  }
}

fn emit_native_freemonoid_tco_match(scrut_str: String, arms: List<Node>, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  let empty_arm = freemonoid_match_arm_for(arms: arms, variant: "Empty")
  let cons_arm = freemonoid_match_arm_for(arms: arms, variant: "Cons")
  let catchall = freemonoid_catchall_arm(arms: arms)
  let empty_body = freemonoid_tco_empty_branch_body(empty_arm: empty_arm, catchall: catchall, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  let nonempty_body = freemonoid_tco_nonempty_branch_body(cons_arm: cons_arm, catchall: catchall, si: si, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  if empty_body == "" || nonempty_body == "" { "" } else {
    concat("{ let __fm = ", scrut_str, "; if __fm.is_empty() { ", empty_body, " } else { ", nonempty_body, " } }")
  }
}

fn emit_rust_tco_match(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match frame.expr.expr_data {
    ExprMatch =>
      let s = match_scrutinee(texpr: frame.expr)
      let arm_list = match_arm_nodes(texpr: frame.expr)
      let scrut_str = emit_typed_expr(texpr: s, registry: registry, scope: frame.scope, depth: frame.depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let tco_scrut_type = match s.inferred {
        Present { value: Resolved { node: rt } } =>
          let is_optional = rt.return_cardinality == CardOptional
          if is_optional {
            authored_name_at(source_indices: frame.scope.type_env.source_indices, node: with_required_cardinality(n: rt))
          } else { authored_name_at(source_indices: frame.scope.type_env.source_indices, node: rt) }
        _ => ""
      }
      let native_tco_fm = if arms_are_freemonoid_coproduct(arms: arm_list, scrut_type: tco_scrut_type, type_summaries: emit_info.type_summaries) {
        emit_native_freemonoid_tco_match(scrut_str: scrut_str, arms: arm_list, fn_name: fn_name, params: params, registry: registry, scope: frame.scope, depth: frame.depth, shared_types: shared_types, emit_info: emit_info)
      } else { "" }
      if native_tco_fm != "" { native_tco_fm } else {
      let rc_match = analyze_rc_match(scrutinee: s, arms: arm_list, scrut_type: tco_scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: frame.scope.type_env.source_indices)
      let arm_strs = arm_list |> map(arm =>
        emit_typed_tco_match_arm(arm: arm, fn_name: fn_name, params: params, registry: registry, scope: frame.scope, depth: frame.depth, shared_types: shared_types, emit_info: emit_info, scrut_type: tco_scrut_type))
      let arms_str = arm_strs |> join(separator: "\n")
      let tco_needs_as_str = all_arms_are_string_lit(arms: arm_list) && arm_list |> count > 0
      if rc_match.needs_rc_option_ref {
        concat("match ", scrut_str, ".as_ref() {\n", arms_str, "\n}")
      } else if rc_match.needs_option_deref {
        concat("match ", scrut_str, ".as_deref()", clone_iterator_suffix(), " {\n", arms_str, "\n}")
      } else if rc_match.needs_deref {
        let sharing = language_spec(target: Rust).sharing
        concat("match ", apply_type_template1(template: sharing.deref_clone, arg0: scrut_str), " {\n", arms_str, "\n}")
      } else if tco_needs_as_str {
        concat("match ", scrut_str, ".as_str() {\n", arms_str, "\n}")
      } else {
        concat("match ", scrut_str, " {\n", arms_str, "\n}")
      }
      }
    _ => emit_error_expr(message: "emit_rust_tco_match expected ExprMatch", target: Rust)
  }
}

fn emit_rust_tco_let(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match frame.expr.expr_data {
    ExprLet =>
      let n = let_binding_name_at(texpr: frame.expr, source_indices: frame.scope.type_env.source_indices)
      let v = let_value(texpr: frame.expr)
      let bd = let_body(texpr: frame.expr)
      let val_str = emit_typed_expr(texpr: v, registry: registry, scope: frame.scope, depth: frame.depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let is_param = params |> any(p => param_node_name_at(n: p, source_indices: frame.scope.type_env.source_indices) == n)
      let let_line = if is_param { concat(emit_ident(name: n, target: Rust), " = ", val_str, ";") } else { concat("let ", emit_ident(name: n, target: Rust), " = ", val_str, ";") }
      let next_scope = extend_scope(scope: frame.scope, name: n, resolved: resolved_type(n: v), provenance: SubValueUnknown)
      match bd {
        Present { value: b } =>
          concat(let_line, "\n", emit_typed_tco_expr(texpr: b, fn_name: fn_name, params: params, registry: registry, scope: next_scope, depth: frame.depth, shared_types: shared_types, emit_info: emit_info))
        Absent => let_line
      }
    _ => emit_error_expr(message: "emit_rust_tco_let expected ExprLet", target: Rust)
  }
}

fn emit_rust_tco_block(frame: TcoFrame, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match frame.expr.expr_data {
    ExprBlock =>
      let ss = frame.expr.children
      if ss |> count == 0 {
        "break;"
      } else {
        let init_state = emit_tco_init_block_stmts(
          remaining: ss, text: [], scope: frame.scope, registry: registry, depth: frame.depth, shared_types: shared_types, emit_info: emit_info, params: params)
        let last_str = match ss |> last {
          Present { value: last_expr } =>
            emit_typed_tco_expr(texpr: last_expr, fn_name: fn_name, params: params, registry: registry, scope: init_state.scope, depth: frame.depth, shared_types: shared_types, emit_info: emit_info)
          Absent => "break;"
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    _ => emit_error_expr(message: "emit_rust_tco_block expected ExprBlock", target: Rust)
  }
}

fn emit_rust_tco_default_return(frame: TcoFrame, registry: Map<String, ItemInfo>, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let val_str = emit_typed_expr(texpr: frame.expr, registry: registry, scope: frame.scope, depth: frame.depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  concat("break ", val_str, ";")
}

fn emit_typed_tco_expr(texpr: Node, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  emit_shared_tco_expr(
    frame: TcoFrame { expr: texpr, scope: scope, depth: depth },
    fn_name: fn_name,
    emit_self_call_reassign: input => emit_typed_tco_reassign(args: input.args, params: params, registry: registry, scope: input.scope, depth: input.depth, shared_types: shared_types, emit_info: emit_info),
    emit_non_self_call: frame => emit_rust_tco_non_self_call(frame: frame, registry: registry, shared_types: shared_types, emit_info: emit_info),
    emit_if: frame => emit_rust_tco_if(frame: frame, fn_name: fn_name, params: params, registry: registry, shared_types: shared_types, emit_info: emit_info),
    emit_match: frame => emit_rust_tco_match(frame: frame, fn_name: fn_name, params: params, registry: registry, shared_types: shared_types, emit_info: emit_info),
    emit_let: frame => emit_rust_tco_let(frame: frame, fn_name: fn_name, params: params, registry: registry, shared_types: shared_types, emit_info: emit_info),
    emit_block: frame => emit_rust_tco_block(frame: frame, fn_name: fn_name, params: params, registry: registry, shared_types: shared_types, emit_info: emit_info),
    emit_default_return: frame => emit_rust_tco_default_return(frame: frame, registry: registry, shared_types: shared_types, emit_info: emit_info))
}

fn emit_typed_tco_match_arm(arm: Node, fn_name: String, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo, scrut_type: String) -> String {
  let arm_pat = arm_pattern(n: arm)
  let arm_g = arm_guard(n: arm)
  let arm_b = arm_body(n: arm)
  let si = scope.type_env.source_indices
  let rc_analysis_raw = analyze_rc_pattern(pattern: arm_pat, scrut_type: scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: si)
  let rc_analysis = rc_pattern_analysis_with_box_fields(rc_analysis: rc_analysis_raw, arm_pat: arm_pat, shared_types: shared_types, emit_info: emit_info, scope: scope)
  let pat_str = if rc_analysis.needs_rc_pattern {
    emit_pattern_rc_aware(pattern: arm_pat, path_prefix: [], rc_analysis: rc_analysis, shared_types: shared_types, scrut_type: scrut_type, source_indices: si, emit_info: emit_info)
  } else {
    emit_pattern(pattern: arm_pat, path_prefix: [], shared_types: shared_types, scrut_type: scrut_type, source_indices: si, emit_info: emit_info)
  }
  let field_guards = collect_pattern_string_guards(pattern: arm_pat, path_prefix: [], source_indices: si)
  let arm_guard_str = match arm_g {
    Present { value: g } => emit_typed_expr(texpr: g, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
    Absent => ""
  }
  let guard_str = if field_guards != "" && arm_guard_str != "" {
    concat(" if ", field_guards, " && ", arm_guard_str)
  } else if field_guards != "" {
    concat(" if ", field_guards)
  } else if arm_guard_str != "" {
    concat(" if ", arm_guard_str)
  } else { "" }
  let body_str = emit_typed_tco_expr(texpr: arm_b, fn_name: fn_name, params: params, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  if rc_analysis.needs_rc_pattern {
    let prelude = rc_pattern_preludes(pattern: arm_pat, rc_analysis: rc_analysis, shared_types: shared_types, source_indices: si, emit_info: emit_info)
    concat("    ", pat_str, guard_str, " => { ", prelude, " ", body_str, " },")
  } else {
    concat("    ", pat_str, guard_str, " => { ", body_str, " },")
  }
}

fn expr_references_var(node: Node, var_name: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  match node.expr_data {
    ExprVar { binding_kind: _ } => expr_var_name_at(texpr: node, source_indices: source_indices) == var_name
    _ => node.children |> any(c => expr_references_var(node: c, var_name: var_name, source_indices: source_indices))
  }
}

fn emit_typed_tco_reassign(args: List<Node>, params: List<Node>, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  let arg_values = args |> map(a => arg_value(n: a))
  let identity_params = params |> enumerate |> fold(init: empty_map(), f: (m, pair) =>
    let pname = param_node_name_at(n: pair.second, source_indices: si)
    let av = match arg_values |> skip(pair.first) |> first { Present { value: v } => v  Absent => pair.second }
    if is_tco_identity_passthrough(arg_val: av, param_name: pname, si: si) {
      map_insert(m, pname, true)
    } else { m }
  )
  let filtered_arg_values = params |> enumerate
    |> filter(pair => match map_get(identity_params, param_node_name_at(n: pair.second, source_indices: si)) { Present { value: _ } => false  Absent => true })
    |> map(pair => match arg_values |> skip(pair.first) |> first { Present { value: v } => v  Absent => pair.second })
  let filtered_params = params
    |> filter(p => match map_get(identity_params, param_node_name_at(n: p, source_indices: si)) { Present { value: _ } => false  Absent => true })
  let tco_movable = filtered_params |> fold(acc: emit_info.movable, f: (m, p) =>
    let pname = param_node_name_at(n: p, source_indices: si)
    let ref_count = filtered_arg_values |> fold(acc: 0, f: (n, av) =>
      if expr_references_var(node: av, var_name: pname, source_indices: si) { n + 1 } else { n })
    if ref_count <= 1 { set_insert(m, pname) } else { m })
  let tco_emit_info = with(emit_info, { movable: tco_movable })
  let ordered_args = filtered_arg_values |> map(av => emit_typed_expr(texpr: av, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: tco_emit_info, fuel: 1024))
  let param_names = filtered_params |> map(p => emit_ident(name: param_node_name_at(n: p, source_indices: si), target: Rust))
  let all_lines = tco_reassign_core(
    ordered_args: ordered_args, param_names: param_names,
    temp_var_prefix: "__tco_", temp_decl_prefix: "let ",
    temp_assign_op: " = ", stmt_terminator: ";",
    continue_str: "continue;", line_prefix: "")
  concat("{\n", make_indent(level: depth + 1),(all_lines |> join(separator: "\n")), "\n}")
}

fn emit_service_def(
  item: Node,
  registry: Map<String, ItemInfo>,
  shared_types: Set<String>,
  corpus_repr: RustCorpusRepr,
  env: TypeEnv
) -> String {
  let safe_name = sanitize_service_name(name: authored_name(env: env, node: item))
  let fallback_transport = service_fallback_transport(item: item)
  let op_children = item.children
  let struct_def = emit_service_struct(name: safe_name, fallback_transport: fallback_transport, op_children: op_children, service_item: item, source_indices: env.source_indices)
  let impl_block = emit_service_impl(name: safe_name, transport: fallback_transport, op_children: op_children, registry: registry, shared_types: shared_types, corpus_repr: corpus_repr, env: env, service_item: item)
  concat(struct_def, "\n\n", impl_block)
}

fn emit_service_struct(name: String, fallback_transport: Node, op_children: List<Node>, service_item: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let derives = "#[derive(Debug, Clone)]"
  let config_fields = emit_service_config_fields(fallback_transport: fallback_transport, op_children: op_children, service_item: service_item, source_indices: source_indices)
  let dry_run_field = "\n    pub dry_run: crate::dry_run::DryRunMode,"
  concat(derives, "\npub struct ", name, " {\n", config_fields, dry_run_field, "\n}")
}

fn emit_service_config_fields(fallback_transport: Node, op_children: List<Node>, service_item: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let fs = compute_service_fields(fallback_transport: fallback_transport, op_children: op_children, source_indices: source_indices)
  let has_svc_auth = match service_config_auth_source(n: service_item, source_indices: source_indices) { Present { value: _ } => true  Absent => false }
  let fs = if has_svc_auth { ServiceFieldSet { has_rest: fs.has_rest, has_shell: fs.has_shell, has_file: fs.has_file, has_auth: true } }
  else { fs }
  let decls = service_field_decls(fs: fs, t: language_spec(target: Rust).service_fields)
  if decls |> count == 0 { "    // No configuration needed for local binding.\n" }
  else { decls |> join(separator: "") }
}

fn emit_service_impl(name: String, transport: Node, op_children: List<Node>, registry: Map<String, ItemInfo>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, env: TypeEnv, service_item: Node) -> String {
  let depth = 0
  let new_method = emit_service_new_method(name: name, fallback_transport: transport, op_children: op_children, service_item: service_item, source_indices: env.source_indices)
  let method_strs = op_children |> map(op_node =>
    emit_operation_method(service_name: name, transport: transport, op_node: op_node, registry: registry, depth: depth + 1, shared_types: shared_types, corpus_repr: corpus_repr, env: env, service_item: service_item)
  )
  let all_methods = concat([new_method], method_strs)
  let methods_str = all_methods |> join(separator: "\n\n")
  concat("impl ", name, " {\n", make_indent(level: depth + 1),methods_str, "\n}")
}

fn emit_service_new_method(name: String, fallback_transport: Node, op_children: List<Node>, service_item: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let fs = compute_service_fields(fallback_transport: fallback_transport, op_children: op_children, source_indices: source_indices)
  let has_svc_auth = match service_config_auth_source(n: service_item, source_indices: source_indices) { Present { value: _ } => true  Absent => false }
  let fs = if has_svc_auth { ServiceFieldSet { has_rest: fs.has_rest, has_shell: fs.has_shell, has_file: fs.has_file, has_auth: true } }
  else { fs }
  let from_config = match service_config_endpoint(n: service_item, source_indices: source_indices) {
    Present { value: ep } => match ep.expr_data {
      ExprLiteral { value: LitStr { value: s } } => s
      _ => ""
    }
    Absent => ""
  }
  let base_url_default = if from_config != "" { from_config }
  else if fs.has_rest {
    let fallback_is_rest = is_rest_transport(t: fallback_transport, source_indices: source_indices)
    let from_fallback = if fallback_is_rest {
      match transport_base_url(t: fallback_transport, source_indices: source_indices) {
        Present { value: bu } => match bu.expr_data {
          ExprLiteral { value: LitStr { value: s } } => s
          _ => ""
        }
        Absent => ""
      }
    } else { "" }
    if from_fallback != "" { from_fallback } else { "http://localhost" }
  } else { "" }
  let ctors = service_field_ctors(fs: fs, t: language_spec(target: Rust).service_fields)
  let ctors = ctors |> map(c => apply_type_template1(template: c, arg0: base_url_default))
  let ctors = match service_config_auth_source(n: service_item, source_indices: source_indices) {
    Present { value: src } => ctors |> map(c =>
      if contains(c, "auth_token") { emit_auth_source_ctor(source_expr: src, source_indices: source_indices) }
      else { c }
    )
    Absent => ctors
  }
  let inits = ctors |> join(separator: "")
  concat(
    "pub fn new(dry_run: crate::dry_run::DryRunMode) -> Self {\n",
    "    ", name, " {\n",
    inits,
    "        dry_run,\n",
    "    }\n",
    "}")
}

fn emit_auth_source_ctor(source_expr: Node, source_indices: Map<String, NewlineIndex>) -> String {
  match source_expr.expr_data {
    ExprRecordLit => match record_lit_type_name_at(texpr: source_expr, source_indices: source_indices) {
      Present { value: variant } =>
      if variant == "EnvVar" {
        match source_expr.children |> first {
          Present { value: fi } => match field_init_node_value(n: fi).expr_data {
            ExprLiteral { value: LitStr { value: env_name } } =>
              concat("        auth_token: std::env::var(\"", env_name, "\").expect(\"missing credential: ", env_name, "\"),\n")
            _ => "        auth_token: compile_error!(\"EnvVar.name must be a string literal\"),\n"
          }
          Absent => "        auth_token: compile_error!(\"EnvVar requires a name field\"),\n"
        }
      } else {
        concat("        auth_token: compile_error!(\"unsupported CredentialSource variant: ", variant, "\"),\n")
      }
      Absent => "        auth_token: compile_error!(\"auth_source record literal has no type name\"),\n"
    }
    _ => "        auth_token: compile_error!(\"auth_source must be a CredentialSource variant\"),\n"
  }
}

fn emit_modifier_doc_from_props(properties: List<Node>, source_indices: Map<String, NewlineIndex>) -> String {
  let names = extract_modifier_names(properties: properties, source_indices: source_indices)
  if names |> count == 0 {
    ""
  } else {
    concat("/// Modifiers: ", names |> join(separator: ", "), "\n")
  }
}

fn emit_operation_method(service_name: String, transport: Node, op_node: Node, registry: Map<String, ItemInfo>, depth: Int, shared_types: Set<String>, corpus_repr: RustCorpusRepr, env: TypeEnv, service_item: Node) -> String {
  let op_text = authored_name(env: env, node: op_node)
  let input_params = op_node.params |> map(p =>
    concat(emit_ident(name: param_node_name_at(n: p, source_indices: env.source_indices), target: Rust), rust_items().param_type_sep, emit_rust_param_type(n: param_node_type_expr(n: p), generic_param_names: [], shared_types: shared_types, corpus_repr: corpus_repr, source_indices: env.source_indices, variant_to_enum: empty_map(), env: env.clone()))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "&self"
  } else {
    concat("&self, ", params_str)
  }
  let ret_type = render_rust_type(n: resolved_type(n: op_node), shared_types: shared_types, corpus_repr: corpus_repr, source_indices: env.source_indices, emit_info: empty_emit_graph_info())
  let eff_transport = effective_operation_transport(op_node: op_node, fallback: transport)
  let op_inferred = resolved_type(n: op_node)
  let real_body = emit_transport_call(transport: eff_transport, op_name: op_text, registry: registry, depth: depth + 2, inferred: op_inferred, service_item: service_item, op_node: op_node, source_indices: env.source_indices, shared_types: shared_types, corpus_repr: corpus_repr, env: env)
  let mock_props = op_node.properties |> filter(p => has_mock_prefix(name: field_init_node_name_at(n: p, source_indices: env.source_indices)))
  let dry_run_body = emit_dry_run_branch_from_props(op_name: op_text, inferred: resolved_type(n: op_node), mock_props: mock_props, registry: registry, source_indices: env.source_indices, op_node: op_node, env: env, shared_types: shared_types, corpus_repr: corpus_repr)
  let body = concat(
    "if self.dry_run.is_dry_run() {\n",
    make_indent(level: depth + 2),dry_run_body, "\n",
    "} else {\n",
    make_indent(level: depth + 2),real_body, "\n",
    "}")
  let modifier_doc = emit_modifier_doc_from_props(properties: op_node.properties, source_indices: env.source_indices)
  let items = rust_items()
  concat(modifier_doc, rust_visibility_prefix(), items.async_prefix, items.func_keyword, " ", emit_ident(name: op_text, target: Rust),
    "(", all_params, ") -> Result<", ret_type, ", Box<dyn std::error::Error>> {\n",
    make_indent(level: depth + 1),body, "\n}")
}

fn emit_dry_run_branch_from_props(op_name: String, inferred: Node, mock_props: List<Node>, registry: Map<String, ItemInfo>, source_indices: Map<String, NewlineIndex>, op_node: Node, env: TypeEnv, shared_types: Set<String>, corpus_repr: RustCorpusRepr) -> String {
  let log_line = concat("eprintln!(\"[dry-run] ", op_name, "\");")
  if mock_props |> count > 0 {
    let first_mock = mock_props |> first
    match first_mock {
      Present { value: mp } => {
        let mock_json = emit_data_value_json(value: field_init_node_value(n: mp), source_indices: source_indices)
        let is_multi_field_conj = inferred.connective == Conj && inferred.children |> count > 1
        if is_multi_field_conj {
          let children = inferred.children
          let wire_opt = operation_response_200_resolved_type(op_node: op_node, source_indices: source_indices, env: env)
          if has_response_200_property(op_node: op_node, source_indices: source_indices) && match wire_opt {
            Absent => true
            Present { value: _ } => false
          } {
            concat(log_line, "\ncompile_error!(\"REST response_200 (dry-run): declared HTTP 200 body type is present but could not be resolved; illegal state\");\n")
          } else {
            let use_typed_wire = match wire_opt {
              Present { value: tn } => !is_json_wire_declaration_type(t: tn, source_indices: source_indices)
              Absent => false
            }
            let prelude = match wire_opt {
              Present { value: tn } =>
                if is_json_wire_declaration_type(t: tn, source_indices: source_indices) {
                  concat("let json_body: serde_json::Value = serde_json::from_str(r#\"", mock_json, "\"#)?;\n")
                } else {
                  let wire_ty = match tn.inferred {
                    Present { value: Resolved { node: rt } } => rt
                    _ => tn
                  }
                  concat("let __rest_wire: ", render_rust_type(n: wire_ty, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info()), " = serde_json::from_str(r#\"", mock_json, "\"#)?;\n")
                }
              Absent => concat("let json_body: serde_json::Value = serde_json::from_str(r#\"", mock_json, "\"#)?;\n")
            }
            let extract_lines = children |> map(ch =>
              let ch_name = authored_name_at(source_indices: source_indices, node: ch)
              let field_name = emit_ident(name: ch_name, target: Rust)
              let from_path = match child_from_key(ch: ch, source_indices: source_indices) {
                Present { value: p } => p
                Absent => ch_name
              }
              let raw = match ch.inferred {
                Present { value: Resolved { node: tn } } =>
                  if use_typed_wire {
                    match wire_opt {
                      Present { value: wire_node } => emit_typed_wire_field_assign(field_name: field_name, from_path: from_path, wire_node: wire_node, source_indices: source_indices)
                      Absent => concat("let ", field_name, " = compile_error!(\"REST typed dry-run: response_200 wire type missing despite typed projection; illegal state\");\n")
                    }
                  } else {
                    emit_json_value_extract(var_name: field_name, from_path: from_path, dag_type_name: authored_name_at(source_indices: source_indices, node: tn), corpus_repr: corpus_repr, source_indices: source_indices)
                  }
                _ =>
                  concat("let ", field_name, " = compile_error!(\"unresolved type for mock field: ", ch_name, "\");")
              }
              match ch.return_cardinality {
                CardOptional => concat(raw, "\nlet ", field_name, " = Some(", field_name, ");")
                _ => raw
              }
            )
            let field_names = children |> map(ch => emit_ident(name: authored_name_at(source_indices: source_indices, node: ch), target: Rust))
            let result_body = concat("(", field_names |> join(separator: ", "), ")")
            concat(log_line, "\n", prelude, extract_lines |> join(separator: "\n"), "\nOk(", result_body, ")")
          }
        } else {
          concat(log_line, "\n",
            "let mock_value: serde_json::Value = serde_json::from_str(r#\"", mock_json, "\"#)?;\n",
            "Ok(serde_json::from_value(mock_value)?)")
        }
      }
      Absent => concat(log_line, "\ncompile_error!(\"mock property list was non-empty but first() returned None\")")
    }
  } else {

    concat(log_line, "\npanic!(\"no mock data available for dry-run operation: ", op_name, "\")")
  }
}

fn emit_transport_call(transport: Node, op_name: String, registry: Map<String, ItemInfo>, depth: Int, inferred: Node, service_item: Node, op_node: Node, source_indices: Map<String, NewlineIndex>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, env: TypeEnv) -> String {
  if is_rest_transport(t: transport, source_indices: source_indices) { emit_rest_call(op_name: op_name, transport: transport, registry: registry, depth: depth, service_item: service_item, op_node: op_node, source_indices: source_indices, shared_types: shared_types, corpus_repr: corpus_repr, env: env) }
  else if is_shell_transport(t: transport) { emit_shell_call(op_name: op_name, transport: transport, registry: registry, depth: depth, inferred: inferred, op_node: op_node, corpus_repr: corpus_repr, source_indices: source_indices) }
  else if is_file_transport(t: transport, source_indices: source_indices) { emit_file_call(op_name: op_name, inferred: inferred) }
  else { emit_local_call(op_name: op_name) }
}

fn emit_rest_call(op_name: String, transport: Node, registry: Map<String, ItemInfo>, depth: Int, service_item: Node, op_node: Node, source_indices: Map<String, NewlineIndex>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, env: TypeEnv) -> String {
  let has_config_auth = match service_config_auth(n: service_item, source_indices: source_indices) { Present { value: _ } => true  Absent => false }
  let has_basic_auth = match transport_auth_basic(t: transport, source_indices: source_indices) { Present { value: _ } => true  Absent => false }
  if has_config_auth && has_basic_auth {
    "compile_error!(\"rest transport declares both config-level auth and auth_basic - one auth authority per operation (§3)\");"
  } else {
  let client_init = emit_rest_client_init(transport: transport, source_indices: source_indices)
  let url_line = emit_rest_url_line(transport: transport, op_name: op_name, source_indices: source_indices)
  let http_method = emit_rest_http_method(transport: transport, source_indices: source_indices)
  let auth_line = emit_rest_auth_line(transport: transport, service_item: service_item, http_method: http_method, source_indices: source_indices)
  let basic_auth_line = emit_rest_basic_auth_line(transport: transport, source_indices: source_indices)
  let query_line = emit_rest_query_line(transport: transport, corpus_repr: corpus_repr, source_indices: source_indices)
  let body_line = emit_rest_body_line(transport: transport, source_indices: source_indices)
  let headers = transport_headers(t: transport, source_indices: source_indices)
  let header_lines = headers |> map(h =>
    let hval = field_init_node_value(n: h)
    let val_str = emit_simple_expr(expr: hval, target: Rust, source_indices: source_indices)
    concat("let request = request.header(\"", field_init_node_name_at(n: h, source_indices: source_indices), "\", ", val_str, ");")
  )
  let send_line = "let response = request.send().await?;"
  let response_handling = emit_response_code_handling(op_node: op_node, transport: transport, source_indices: source_indices, shared_types: shared_types, corpus_repr: corpus_repr, env: env)
  let all_lines = concat([client_init, url_line, auth_line, basic_auth_line],
    header_lines, [query_line, body_line, send_line, response_handling])
    |> filter(l => l != "")
  all_lines |> join(separator: "\n")
  }
}

fn emit_rest_client_init(transport: Node, source_indices: Map<String, NewlineIndex>) -> String {
  match transport_tls_posture(t: transport, source_indices: source_indices) {
    Present { value: p } =>
      if p == "InsecureAcceptAnyCert" {
        "let client = reqwest::Client::builder().user_agent(\"gunbc/1.0\").danger_accept_invalid_certs(true).build()?;"
      } else if p == "VerifyPeer" {
        "let client = reqwest::Client::builder().user_agent(\"gunbc/1.0\").build()?;"
      } else {
        concat("compile_error!(\"rest transport tls: unrecognized posture '", p, "'\");")
      }
    Absent => "let client = reqwest::Client::builder().user_agent(\"gunbc/1.0\").build()?;"
  }
}

fn emit_rest_basic_auth_line(transport: Node, source_indices: Map<String, NewlineIndex>) -> String {
  match transport_auth_basic(t: transport, source_indices: source_indices) {
    Present { value: b } => {
      let user_field = b.children |> filter(fi => field_init_node_name_at(n: fi, source_indices: source_indices) == "username") |> first
      let pass_field = b.children |> filter(fi => field_init_node_name_at(n: fi, source_indices: source_indices) == "password") |> first
      match user_field {
        Present { value: uf } => match pass_field {
          Present { value: pf } => {
            let user_expr = emit_simple_expr(expr: field_init_node_value(n: uf), target: Rust, source_indices: source_indices)
            let pass_expr = emit_simple_expr(expr: field_init_node_value(n: pf), target: Rust, source_indices: source_indices)
            concat("let request = request.basic_auth(", user_expr, ", Some(", pass_expr, "));")
          }
          Absent => "compile_error!(\"auth_basic requires both username and password fields\");"
        }
        Absent => "compile_error!(\"auth_basic requires both username and password fields\");"
      }
    }
    Absent => ""
  }
}

fn emit_rest_http_method(transport: Node, source_indices: Map<String, NewlineIndex>) -> String {
  match transport_method(t: transport, source_indices: source_indices) {
    Present { value: m } => match m.inferred {
      Present { value: Resolved { node: _ } } =>
        let method_name = expr_var_name_at(texpr: m, source_indices: source_indices)
        method_name |> chars |> map(ch => to_lower_char(ch: ch)) |> join(separator: "")
      _ =>

        concat("compile_error!(\"transport method type not resolved\")")
    }
    Absent => "compile_error!(\"transport method not specified\")"
  }
}

fn emit_rest_url_line(transport: Node, op_name: String, source_indices: Map<String, NewlineIndex>) -> String {
  match transport_path_template(t: transport, source_indices: source_indices) {
    Present { value: path_node } => match path_node.expr_data {
      ExprLiteral { value: LitStr { value: path_str } } =>
        concat("let url = format!(\"{}", escape_string_literal_body(s: path_str), "\", self.base_url);")
      ExprStringInterp => {
        let parts = path_node.children |> map(child => match child.expr_data {
          ExprLiteral { value: LitStr { value: text } } => Text { value: text }
          _ => Interpolation { expr: arg_value(n: child) }
        })
        let fmt_segments = parts |> map(p => match p {
          Text { value: v } => escape_rust_interp_text(s: v)
          Interpolation { expr: _ } => "{}"
        })
        let fmt_str = fmt_segments |> join(separator: "")
        let args = parts |> flat_map(p => match p {
          Text { value: _ } => []
          Interpolation { expr: e } => {
            let var_name = emit_ident(name: expr_var_name_at(texpr: e, source_indices: source_indices), target: Rust)
            let is_opt = is_optional_typed_expr(e: e)
            if is_opt {
              [concat(var_name, ".as_deref().unwrap_or(\"\")")]
            } else {
              [var_name]
            }
          }
        })
        if args |> count == 0 {
          concat("let url = format!(\"{}", fmt_str, "\", self.base_url);")
        } else {
          let args_str = args |> join(separator: ", ")
          concat("let url = format!(\"{}", fmt_str, "\", self.base_url, ", args_str, ");")
        }
      }
      _ => "compile_error!(\"transport path must be a string literal or interpolation\");"
    }
    Absent => concat("let url = format!(\"{}/{}\", self.base_url, \"",
      emit_ident(name: op_name, target: Rust), "\");")
  }
}

fn emit_rest_auth_line(transport: Node, service_item: Node, http_method: String, source_indices: Map<String, NewlineIndex>) -> String {
  let auth_scheme = service_config_auth(n: service_item, source_indices: source_indices)
  let auth_input = service_config_auth_input(n: service_item, source_indices: source_indices)
  match auth_scheme {
    Present { value: auth } => {

      let has_auth_source = match service_config_auth_source(n: service_item, source_indices: source_indices) { Present { value: _ } => true  Absent => false }
      let token_param = if has_auth_source { "self.auth_token.clone()" }
      else {
        match auth_input {
          Present { value: ai } => emit_simple_expr(expr: ai, target: Rust, source_indices: source_indices)
          Absent => "compile_error!(\"service config has auth but no auth_input or auth_source\")"
        }
      }
      match auth.expr_data {
        ExprVar { binding_kind: _ } =>
          concat("let request = client.", http_method, "(&url)\n    .header(\"Authorization\", format!(\"Bearer {}\", ", token_param, "));")
        ExprCall { call_semantics: _, descent_evidence: _ } =>
          let header_name = match auth.children |> first {
            Present { value: arg_node } => match arg_value(n: arg_node).expr_data {
              ExprLiteral { value: LitStr { value: s } } => s
              _ => emit_simple_expr(expr: arg_value(n: arg_node), target: Rust, source_indices: source_indices)
            }
            Absent => "x-api-key"
          }
          concat("let request = client.", http_method, "(&url)\n    .header(\"", header_name, "\", ", token_param, ");")
        _ =>

          concat("compile_error!(\"unrecognized auth scheme expression shape\"); let request = client.", http_method, "(&url);")
      }
    }
    Absent => {
      if transport_has_auth(t: transport, source_indices: source_indices) {
        let header_name = match transport_auth_header_name(t: transport, source_indices: source_indices) {
          Present { value: h } => h
          Absent => "Authorization"
        }
        let token_node = match transport_auth_token(t: transport, source_indices: source_indices) {
          Present { value: tn } => emit_simple_expr(expr: tn, target: Rust, source_indices: source_indices)
          Absent => "\"\""
        }
        concat("let request = client.", http_method, "(&url)\n    .header(\"",
          header_name, "\", ", token_node, ");")
      } else {
        concat("let request = client.", http_method, "(&url);")
      }
    }
  }
}

fn emit_rest_query_line(transport: Node, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  match transport_query(t: transport, source_indices: source_indices) {
    Present { value: q } => {
      let pairs = q.children |> map(fi =>
        concat("(\"", field_init_node_name_at(n: fi, source_indices: source_indices), "\", &",
          emit_rust_dag_string_to_host_via_seam(dag_expr: emit_simple_expr(expr: field_init_node_value(n: fi), target: Rust, source_indices: source_indices), corpus_repr: corpus_repr),
          ")")
      )
      if pairs |> count > 0 {
        concat("let request = request.query(&[", pairs |> join(separator: ", "), "]);")
      } else { "" }
    }
    Absent => ""
  }
}

fn emit_rest_body_line(transport: Node, source_indices: Map<String, NewlineIndex>) -> String {
  match transport_request_body(t: transport, source_indices: source_indices) {
    Present { value: b } => match b.expr_data {
      ExprRecordLit => {
        let required_fields = b.children |> filter(fi => !is_optional_typed_expr(e: field_init_node_value(n: fi)))
        let optional_fields = b.children |> filter(fi => is_optional_typed_expr(e: field_init_node_value(n: fi)))
        let req_strs = required_fields |> map(fi =>
          concat("\"", field_init_node_name_at(n: fi, source_indices: source_indices), "\": ",
            emit_simple_expr(expr: field_init_node_value(n: fi), target: Rust, source_indices: source_indices))
        )
        if req_strs |> count == 0 && optional_fields |> count == 0 {
          "compile_error!(\"transport body record has no fields\");"
        } else {
          let body_init = if req_strs |> count > 0 {
            concat("let mut __body = serde_json::json!({ ", req_strs |> join(separator: ", "), " });")
          } else {
            "let mut __body = serde_json::json!({});"
          }
          let opt_lines = optional_fields |> map(fi =>
            let fname = field_init_node_name_at(n: fi, source_indices: source_indices)
            let fexpr = emit_simple_expr(expr: field_init_node_value(n: fi), target: Rust, source_indices: source_indices)
            concat("if let Some(ref __v) = ", fexpr, " { __body[\"", fname, "\"] = serde_json::json!(__v); }")
          )
          let assign_line = "let request = request.json(&__body);"
          concat([body_init], opt_lines, [assign_line]) |> join(separator: "\n")
        }
      }
      _ => "compile_error!(\"transport body must be a record expression { field: value, ... }\");"
    }
    Absent => ""
  }
}

fn has_response_prefix(name: String) -> Bool {
  if string_length(s: name) < 9 { false }
  else { substring(s: name, start: 0, end: 9) == "response_" }
}

fn child_from_key(ch: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  match ch.properties |> filter(p => field_init_node_name_at(n: p, source_indices: source_indices) == "from_key") |> first {
    Present { value: prop } => match field_init_node_value(n: prop).expr_data {
      ExprLiteral { value: LitStr { value: s } } => Present { value: s }
      _ => none
    }
    Absent => none
  }
}

fn has_from_key_fields(op_node: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let rt = resolved_type(n: op_node)
  let is_conj = rt.connective == Conj
  let from_key_count = rt.children |> filter(ch => match child_from_key(ch: ch, source_indices: source_indices) { Present { value: _ } => true  Absent => false }) |> count
  is_conj && from_key_count > 0
}

fn has_response_200_property(op_node: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  op_node.properties |> any(p => field_init_node_name_at(n: p, source_indices: source_indices) == "response_200")
}

fn operation_response_200_resolved_type(op_node: Node, source_indices: Map<String, NewlineIndex>, env: TypeEnv) -> Node? {
  match op_node.properties |> filter(p => field_init_node_name_at(n: p, source_indices: source_indices) == "response_200") |> first {
    Present { value: p } => {
      let v = field_init_node_value(n: p)
      match v.inferred {
        Present { value: Resolved { node: tn } } => Present { value: tn }
        _ => {
          let type_name = authored_name_at(source_indices: source_indices, node: normalize_access_type_node(n: v))
          if type_name == "" { none } else { lookup_type_by_name(env: env, name: type_name) }
        }
      }
    }
    Absent => none
  }
}

fn is_json_wire_declaration_type(t: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let n = authored_name_at(source_indices: source_indices, node: normalize_access_type_node(n: t))
  if n == "Json" { true }
  else {
    let parts = n |> split(delimiter: ".")
    match parts |> last {
      Present { value: last } => last == "Json"
      Absent => false
    }
  }
}

fn path_segment_is_list_index(seg: String) -> Bool {
  if string_length(s: seg) == 0 { false }
  else { seg |> chars |> all(c => c >= 48 && c <= 57) }
}

type WirePathProjection {
  expr: String
  node: Node?
  ok: Bool
}

fn wire_child_for_segment(wire_node: Node, seg: String, source_indices: Map<String, NewlineIndex>) -> Node? {
  let normed = normalize_access_type_node(n: wire_node)
  match normed.children |> filter(ch =>
    let authored = authored_name_at(source_indices: source_indices, node: ch)
    let wire_key = match child_from_key(ch: ch, source_indices: source_indices) {
      Present { value: k } => k
      Absent => authored
    }
    wire_key == seg
  ) |> first {
    Present { value: ch } => Present { value: ch }
    Absent => none
  }
}

fn advance_wire_path_projection(state: WirePathProjection, seg: String, full_path: String, source_indices: Map<String, NewlineIndex>) -> WirePathProjection {
  if !state.ok { state }
  else if path_segment_is_list_index(seg: seg) {
    let next_node = match state.node {
      Present { value: n } => Present { value: for_each_element_type_node(n: n, source_indices: source_indices) }
      Absent => none
    }
    WirePathProjection {
      expr: concat("(", state.expr, ").get(", seg, ").ok_or_else(|| format!(\"REST path missing index ", seg, " at ", full_path, "\"))?")
      node: next_node
      ok: true
    }
  } else {
    match state.node {
      Present { value: n } =>
        match wire_child_for_segment(wire_node: n, seg: seg, source_indices: source_indices) {
          Present { value: ch } => WirePathProjection {
            expr: concat("(", state.expr, ").", emit_ident(name: authored_name_at(source_indices: source_indices, node: ch), target: Rust))
            node: Present { value: resolved_type(n: ch) }
            ok: true
          }
          Absent => WirePathProjection { expr: state.expr, node: none, ok: false }
        }
      Absent => WirePathProjection { expr: state.expr, node: none, ok: false }
    }
  }
}

fn emit_wire_struct_path_chain(base: String, wire_node: Node, from_path: String, source_indices: Map<String, NewlineIndex>) -> WirePathProjection {
  let segs = from_path |> split(delimiter: "/") |> filter(s => s != "")
  segs |> fold(init: WirePathProjection { expr: base, node: Present { value: wire_node }, ok: true }, f: (acc, seg) =>
    advance_wire_path_projection(state: acc, seg: seg, full_path: from_path, source_indices: source_indices)
  )
}

fn emit_typed_wire_field_assign(field_name: String, from_path: String, wire_node: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let projection = emit_wire_struct_path_chain(base: "__rest_wire", wire_node: wire_node, from_path: from_path, source_indices: source_indices)
  if projection.ok {
    concat("let ", field_name, " = ", projection.expr, ".clone();\n")
  } else {
    concat("let ", field_name, " = compile_error!(\"REST typed response path could not be resolved against declared 200 body: ", from_path, "\");\n")
  }
}

fn escape_json_pointer_segment(seg: String) -> String {
  seg |> replace("~", "~0") |> replace("/", "~1")
}

fn emit_json_value_extract(var_name: String, from_path: String, dag_type_name: String, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  let escaped_path = from_path |> split("/") |> map(seg => escape_json_pointer_segment(seg: seg)) |> join(separator: "/")
  let pointer = concat("/", escaped_path)
  let rust_type = coerce_primitive_type(target: Rust, dag_name: dag_type_name)
  let accessor = if dag_type_name == "String" {
    concat(".and_then(|v| v.as_str()).map(|s| ", emit_rust_host_to_dag_string_via_seam(host_expr: "s.to_string()", corpus_repr: corpus_repr), ").ok_or(\"missing field: ", from_path, "\")?")
  } else if rust_type == "i64" {
    concat(".and_then(|v| v.as_i64()).ok_or(\"missing field: ", from_path, "\")?")
  } else if rust_type == "f64" {
    concat(".and_then(|v| v.as_f64()).ok_or(\"missing field: ", from_path, "\")?")
  } else if rust_type == "bool" {
    concat(".and_then(|v| v.as_bool()).ok_or(\"missing field: ", from_path, "\")?")
  } else {
    concat(".cloned().map(|v| serde_json::from_value(v)).transpose()?.ok_or(\"missing field: ", from_path, "\")?")
  }
  concat("let ", var_name, " = json_body.pointer(\"", pointer, "\")", accessor, ";")
}

fn emit_from_key_extraction(op_node: Node, source_indices: Map<String, NewlineIndex>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, env: TypeEnv) -> String {
  let rt = resolved_type(n: op_node)
  let children = rt.children
  let wire_opt = operation_response_200_resolved_type(op_node: op_node, source_indices: source_indices, env: env)
  if has_response_200_property(op_node: op_node, source_indices: source_indices) && match wire_opt {
    Absent => true
    Present { value: _ } => false
  } {
    "compile_error!(\"REST response_200: declared HTTP 200 body type is present but could not be resolved (empty name, missing TypeEnv binding, or inference gap); illegal state\");\n"
  } else {
  let use_typed_wire = match wire_opt {
    Present { value: tn } => !is_json_wire_declaration_type(t: tn, source_indices: source_indices)
    Absent => false
  }
  let prelude = match wire_opt {
    Present { value: tn } =>
      if is_json_wire_declaration_type(t: tn, source_indices: source_indices) {
        "let json_body: serde_json::Value = response.json().await?;\n"
      } else {
        let wire_ty = match tn.inferred {
          Present { value: Resolved { node: rt } } => rt
          _ => tn
        }
        concat("let __rest_wire: ", render_rust_type(n: wire_ty, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info()), " = response.json().await?;\n")
      }
    Absent => "let json_body: serde_json::Value = response.json().await?;\n"
  }
  let extract_lines = children |> map(ch =>
    let ch_name = authored_name_at(source_indices: source_indices, node: ch)
    let field_name = emit_ident(name: ch_name, target: Rust)
    let from_path = match child_from_key(ch: ch, source_indices: source_indices) {
      Present { value: p } => p
      Absent => ch_name
    }
    match ch.inferred {
      Present { value: Resolved { node: tn } } =>
        if use_typed_wire {
          match wire_opt {
            Present { value: wire_node } => emit_typed_wire_field_assign(field_name: field_name, from_path: from_path, wire_node: wire_node, source_indices: source_indices)
            Absent => concat("let ", field_name, " = compile_error!(\"REST typed response: response_200 wire type missing despite typed projection; illegal state\");\n")
          }
        } else {
          emit_json_value_extract(var_name: field_name, from_path: from_path, dag_type_name: authored_name_at(source_indices: source_indices, node: tn), corpus_repr: corpus_repr, source_indices: source_indices)
        }
      _ =>
        concat("let ", field_name, " = compile_error!(\"unresolved type for output field: ", ch_name, "\");")
    }
  )
  let field_names = children |> map(ch => emit_ident(name: authored_name_at(source_indices: source_indices, node: ch), target: Rust))
  let tuple_body = if field_names |> count == 1 {
    concat("(", field_names |> first.value, ",)")
  } else {
    concat("(", field_names |> join(separator: ", "), ")")
  }
  concat(prelude, extract_lines |> join(separator: "\n"), "\nOk(", tuple_body, ")")
  }
}

fn emit_plain_response_body(op_node: Node, transport: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let is_text = match transport_response_format(t: transport, source_indices: source_indices) {
    Present { value: fmt } => authored_name_at(source_indices: source_indices, node: fmt) == "Text"
    Absent => false
  }
  if is_text {
    "let result = response.text().await?;\nOk(result)"
  } else {
    "let result = response.json().await?;\nOk(result)"
  }
}

fn emit_response_code_handling(op_node: Node, transport: Node, source_indices: Map<String, NewlineIndex>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, env: TypeEnv) -> String {
  let use_from_key = has_from_key_fields(op_node: op_node, source_indices: source_indices)
  let response_props = op_node.properties |> filter(p => has_response_prefix(name: field_init_node_name_at(n: p, source_indices: source_indices)))
  if response_props |> count == 0 {
    if use_from_key {
      emit_from_key_extraction(op_node: op_node, source_indices: source_indices, shared_types: shared_types, corpus_repr: corpus_repr, env: env)
    } else {
      emit_plain_response_body(op_node: op_node, transport: transport, source_indices: source_indices)
    }
  } else {
    let arms = response_props |> map(p => emit_response_arm(prop: p, op_node: op_node, use_from_key: use_from_key, transport: transport, source_indices: source_indices, shared_types: shared_types, corpus_repr: corpus_repr, env: env))
    concat(
      "let status = response.status().as_u16();\n",
      "match status {\n",
      arms |> join(separator: "\n"),
      "\n    _ => Err(format!(\"unexpected status code: {}\", status).into())\n",
      "}")
  }
}

fn emit_response_arm(prop: Node, op_node: Node, use_from_key: Bool, transport: Node, source_indices: Map<String, NewlineIndex>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, env: TypeEnv) -> String {
  let name = field_init_node_name_at(n: prop, source_indices: source_indices)
  let code_str = substring(s: name, start: 9, end: string_length(s: name))
  let is_success = if string_length(s: code_str) >= 1 {
    substring(s: code_str, start: 0, end: 1) == "2"
  } else { false }
  let pattern = if code_str == "nonzero" { "_" }
    else if string_length(s: code_str) == 3 && substring(s: code_str, start: 1, end: 3) == "xx" {
      let prefix = substring(s: code_str, start: 0, end: 1)
      concat(prefix, "00..=", prefix, "99")
    }
    else { code_str }
  if is_success {
    if use_from_key {
      concat("    ", pattern, " => { ", emit_from_key_extraction(op_node: op_node, source_indices: source_indices, shared_types: shared_types, corpus_repr: corpus_repr, env: env), " },")
    } else {
      concat("    ", pattern, " => { ", emit_plain_response_body(op_node: op_node, transport: transport, source_indices: source_indices), " },")
    }
  } else {
    concat("    ", pattern, " => { let err_body = response.text().await.unwrap_or_default(); Err(format!(\"HTTP {}: {}\", status, err_body).into()) },")
  }
}

fn has_exit_prefix(name: String) -> Bool {
  if string_length(s: name) < 5 { false }
  else { substring(s: name, start: 0, end: 5) == "exit_" }
}

fn emit_exit_code_handling(op_node: Node, inferred: Node, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  let exit_props = op_node.properties |> filter(p => has_exit_prefix(name: field_init_node_name_at(n: p, source_indices: source_indices)))
  if exit_props |> count == 0 {
    emit_shell_return(inferred: inferred, source_indices: source_indices)
  } else {
    let has_nonzero = exit_props |> any(p => field_init_node_name_at(n: p, source_indices: source_indices) == "exit_nonzero")
    let exit_arms = exit_props |> map(p => emit_exit_arm(prop: p, inferred: inferred, corpus_repr: corpus_repr, source_indices: source_indices))
    let default_arm = if has_nonzero { "" }
      else { concat("\n    _ => { let stderr = String::from_utf8_lossy(&output.stderr).to_string(); Err(", emit_rust_host_to_dag_string_via_seam(host_expr: "stderr", corpus_repr: corpus_repr), ") },") }
    concat(
      "let exit_code = output.status.code().unwrap_or(-1);\n",
      "match exit_code {\n",
      exit_arms |> join(separator: "\n"),
      default_arm,
      "\n}")
  }
}

fn emit_exit_arm(prop: Node, inferred: Node, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  let name = field_init_node_name_at(n: prop, source_indices: source_indices)
  let code_str = substring(s: name, start: 5, end: string_length(s: name))
  let pattern = if code_str == "nonzero" { "_" }
    else { code_str }
  let is_success = code_str == "0"
  if is_success {
    concat("    ", pattern, " => { ", emit_shell_return(inferred: inferred, source_indices: source_indices), " },")
  } else {
    concat("    ", pattern, " => { let stderr = String::from_utf8_lossy(&output.stderr).to_string(); Err(", emit_rust_host_to_dag_string_via_seam(host_expr: "stderr", corpus_repr: corpus_repr), ") },")
  }
}

fn emit_shell_call(op_name: String, transport: Node, registry: Map<String, ItemInfo>, depth: Int, inferred: Node, op_node: Node, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  let argv = transport.children
  let optional_params = op_node.params
    |> filter(p => param_node_type_expr(n: p).return_cardinality == CardOptional)
    |> fold(init: empty_map(), f: (acc, p) => map_insert(acc, param_node_name_at(n: p, source_indices: source_indices), true))
  let has_stdin = match transport_stdin(t: transport, source_indices: source_indices) {
    Present { value: _ } => true
    Absent => false
  }
  let let_kw = if has_stdin { "let mut output" } else { "let output" }
  let cmd_line = if argv |> count > 0 {
    match argv |> first {
      Present { value: first_arg } => concat(let_kw, " = std::process::Command::new(",
        emit_shell_argv_element(arg: first_arg, optional_params: optional_params, corpus_repr: corpus_repr, source_indices: source_indices), ")")
      Absent => concat(let_kw, " = std::process::Command::new(\"",
        emit_ident(name: op_name, target: Rust), "\")")
    }
  } else {
    concat(let_kw, " = std::process::Command::new(\"",
      emit_ident(name: op_name, target: Rust), "\")")
  }
  let arg_lines = if argv |> count > 1 {
    argv |> skip(1) |> map(arg =>
      concat("    .arg(", emit_shell_argv_element(arg: arg, optional_params: optional_params, corpus_repr: corpus_repr, source_indices: source_indices), ")")
    )
  } else { [] }
  let env_entries = transport_env(t: transport, source_indices: source_indices)
  let env_lines = env_entries |> map(e =>
    concat("    .env(\"", field_init_node_name_at(n: e, source_indices: source_indices), "\", ", emit_simple_expr(expr: field_init_node_value(n: e), target: Rust, source_indices: source_indices), ")")
  )
  let wd_line = "    .current_dir(self.working_dir.as_deref().unwrap_or(\".\"))"
  if has_stdin {
    let stdin_expr = transport_stdin(t: transport, source_indices: source_indices).value
    let stdin_var = match stdin_expr.expr_data {
      ExprVar { binding_kind: _ } => emit_ident(name: expr_var_name_at(texpr: stdin_expr, source_indices: source_indices), target: Rust)
      _ => emit_simple_expr(expr: stdin_expr, target: Rust, source_indices: source_indices)
    }
    let spawn_line = "    .stdin(std::process::Stdio::piped())\n    .stdout(std::process::Stdio::piped())\n    .stderr(std::process::Stdio::piped())"
    let spawn_exec = "    .spawn()?;"
    let write_block = concat("{\n    use std::io::Write;\n    if let Some(mut stdin) = output.stdin.take() {\n        stdin.write_all(", stdin_var, ".as_bytes())?;\n    }\n}")
    let wait_line = "let output = output.wait_with_output()?;"
    let check_line = "let stdout = String::from_utf8_lossy(&output.stdout).to_string();"
    let return_line = emit_exit_code_handling(op_node: op_node, inferred: inferred, corpus_repr: corpus_repr, source_indices: source_indices)
    let all_lines = concat([cmd_line], arg_lines, env_lines, [wd_line, spawn_line, spawn_exec, write_block, wait_line, check_line, return_line])
    all_lines |> join(separator: "\n")
  } else {
    let output_line = "    .output()?;"
    let check_line = "let stdout = String::from_utf8_lossy(&output.stdout).to_string();"
    let return_line = emit_exit_code_handling(op_node: op_node, inferred: inferred, corpus_repr: corpus_repr, source_indices: source_indices)
    let all_lines = concat([cmd_line], arg_lines, env_lines, [wd_line, output_line, check_line, return_line])
    all_lines |> join(separator: "\n")
  }
}

fn emit_shell_argv_element(arg: Node, optional_params: Map<String, Bool>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  match arg.expr_data {
    ExprLiteral { value: LitStr { value: s } } =>
      concat("\"", escape_string_literal_body(s: s), "\"")
    ExprStringInterp => {
      let parts = arg.children |> map(child => match child.expr_data {
        ExprLiteral { value: LitStr { value: text } } => Text { value: text }
        _ => Interpolation { expr: arg_value(n: child) }
      })
      let fmt_segments = parts |> map(p => match p {
        Text { value: v } => escape_rust_interp_text(s: v)
        Interpolation { expr: _ } => "{}"
      })
      let fmt_str = fmt_segments |> join(separator: "")
      let args = parts |> flat_map(p => match p {
        Text { value: _ } => []
        Interpolation { expr: e } => {
          let name = expr_var_name_at(texpr: e, source_indices: source_indices)
          let var_name = emit_ident(name: name, target: Rust)
          let is_opt = is_optional_typed_expr(e: e) || match map_get(optional_params, name) {
            Present { value: _ } => true
            Absent => false
          }
          if is_opt {
            [concat(var_name, ".as_deref().unwrap_or(\"\")")]
          } else {
            [var_name]
          }
        }
      })
      let args_str = args |> join(separator: ", ")
      concat("&format!(\"", fmt_str, "\", ", args_str, ")")
    }
    ExprVar { binding_kind: _ } => {
      let name = expr_var_name_at(texpr: arg, source_indices: source_indices)
      let var_name = emit_ident(name: name, target: Rust)
      let is_opt = is_optional_typed_expr(e: arg) || match map_get(optional_params, name) {
        Present { value: _ } => true
        Absent => false
      }
      if is_opt {
        emit_rust_dag_string_to_host_via_seam(dag_expr: concat(var_name, ".as_deref().unwrap_or(\"\")"), corpus_repr: corpus_repr)
      } else {
        emit_rust_dag_string_to_host_via_seam(dag_expr: var_name, corpus_repr: corpus_repr)
      }
    }
    _ => emit_simple_expr(expr: arg, target: Rust, source_indices: source_indices)
  }
}

fn emit_shell_return(inferred: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let effective = unwrap_single_field_product(n: inferred)
  let is_product = is_product_type(n: effective)
  let single_from = if is_product && effective.children |> count == 1 {
    match effective.children |> first {
      Present { value: ch } => child_from_key(ch: ch, source_indices: source_indices)
      Absent => none
    }
  } else { none }
  match single_from {
    Present { value: channel } =>
      let is_optional = effective.return_cardinality == CardOptional
      emit_shell_channel_expr(channel: channel, is_optional: is_optional)
    Absent =>
      if is_product && effective.children |> count > 1 {
        let needs_stderr = effective.children |> any(ch =>
          match child_from_key(ch: ch, source_indices: source_indices) {
            Present { value: "stderr" } => true
            _ => false
          })
        let stderr_line = if needs_stderr {
          "let stderr = String::from_utf8_lossy(&output.stderr).to_string();"
        } else { "" }
        let field_exprs = effective.children |> map(ch =>
          let is_optional = ch.return_cardinality == CardOptional
          let channel = match child_from_key(ch: ch, source_indices: source_indices) {
            Present { value: c } => c
            Absent => "stdout"
          }
          emit_shell_channel_expr(channel: channel, is_optional: is_optional)
        )
        let lines = if stderr_line != "" { concat(stderr_line, "\n") } else { "" }
        concat(lines, "Ok((", field_exprs |> join(separator: ", "), "))")
      } else {
        let is_optional = effective.return_cardinality == CardOptional
        emit_shell_channel_expr(channel: "stdout", is_optional: is_optional)
      }
  }
}

fn emit_shell_channel_expr(channel: String, is_optional: Bool) -> String {
  let base = if channel == "exit_success" { "output.status.success()" }
    else if channel == "stderr" { "stderr.clone()" }
    else if channel == "stdout_lines" {
      "Rc::new(stdout.lines().filter(|l| !l.is_empty()).map(|l| l.trim().to_string()).collect())"
    }
    else { "stdout.clone()" }
  if is_optional { concat("Some(", base, ")") } else { base }
}

fn unwrap_single_field_product(n: Node) -> Node {
  let is_product = is_product_type(n: n)
  if is_product && n.ident_span == none && n.children |> count == 1 {
    match n.children |> first {
      Present { value: field_node } => resolved_type(n: field_node)
      Absent => n
    }
  } else { n }
}

fn emit_file_call(op_name: String, inferred: Node) -> String {
  let effective = unwrap_single_field_product(n: inferred)
  let is_product = is_product_type(n: effective)
  let parse_line = if is_product && effective.children |> count > 1 {
    "let parsed: serde_json::Value = serde_json::from_str(&content)?;\nOk(serde_json::from_value(parsed)?)"
  } else {
    "Ok(content)"
  }
  concat("let path = format!(\"{}/{}\", self.base_path, \"",
    emit_ident(name: op_name, target: Rust), "\");\n",
    "let content = std::fs::read_to_string(&path)?;\n",
    parse_line)
}

fn emit_local_call(op_name: String) -> String {
  concat("// Local binding -- direct function call\n",
    "Ok(", emit_ident(name: op_name, target: Rust), "())")
}

fn emit_resource_def(item: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, env: TypeEnv) -> String {
  let item_text = authored_name(env: env, node: item)
  let cap_children = item.children
  if cap_children |> count == 0 {
    concat("#[derive(Debug, Clone)]\npub struct ", item_text, ";")
  } else {
    let depth = 0
    let cap_methods = cap_children |> map(c => emit_capability_method(cap_node: c, shared_types: shared_types, corpus_repr: corpus_repr, env: env))
    let methods_str = cap_methods |> join(separator: "\n\n")
    concat("#[async_trait::async_trait]\npub trait ", item_text, " {\n",
      make_indent(level: depth + 1),methods_str, "\n}")
  }
}

fn emit_capability_method(cap_node: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, env: TypeEnv) -> String {
  let input_params = cap_node.params |> map(p =>
    concat(emit_ident(name: param_node_name_at(n: p, source_indices: env.source_indices), target: Rust), rust_items().param_type_sep, emit_rust_param_type(n: param_node_type_expr(n: p), generic_param_names: [], shared_types: shared_types, corpus_repr: corpus_repr, source_indices: env.source_indices, variant_to_enum: empty_map(), env: env.clone()))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "&self"
  } else {
    concat("&self, ", params_str)
  }
  let ret = render_rust_type(n: resolved_type(n: cap_node), shared_types: shared_types, corpus_repr: corpus_repr, source_indices: env.source_indices, emit_info: empty_emit_graph_info())
  let items = rust_items()
  concat(items.async_prefix, items.func_keyword, " ", emit_ident(name: authored_name(env: env, node: cap_node), target: Rust), "(", all_params, ") -> Result<", ret, ", Box<dyn std::error::Error>>;")
}

fn data_value_has_cross_refs(value: Node) -> Bool {
  match value.expr_data {
    ExprVar { binding_kind: _ } => true
    ExprListLit => value.children |> any(c => data_value_has_cross_refs(value: c))
    ExprRecordLit { parent_enum: _ } =>
      value.children |> any(f => data_value_has_cross_refs(value: field_init_node_value(n: f)))
    _ => false
  }
}

fn data_def_annotation_is_named_refinement(annotation: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let ann_name = authored_name_at(source_indices: source_indices, node: annotation)
  ann_name != "" && annotation.type_annotation != none && !is_container_type(name: ann_name) && !is_host_text_carrier_type(n: annotation, source_indices: source_indices, corpus_repr: FaithfulFreeMonoid)
}

fn emit_data_def(name: String, type_node: Node, value: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let annotation_type_node = type_node
  let ann_name = authored_name_at(source_indices: scope.type_env.source_indices, node: annotation_type_node)
  let preserves_declared_brand = ann_name != "" && annotation_type_node.children |> count == 0 && !is_container_type(name: ann_name) && !is_kernel_type(name: ann_name)
  let render_type_node = if annotation_type_node.children |> count > 0 {
    annotation_type_node
  } else if preserves_declared_brand {
    annotation_type_node
  } else {
    match value.inferred {
      Present { value: Resolved { node: rt } } => rt
      _ => annotation_type_node
    }
  }
  let raw_ty_str = if preserves_declared_brand {
    rust_ground_opaque_kernel_type_name(name: ann_name)
  } else if data_def_annotation_is_named_refinement(annotation: annotation_type_node, source_indices: scope.type_env.source_indices) {
    coerce_primitive_type(target: Rust, dag_name: authored_name_at(source_indices: scope.type_env.source_indices, node: annotation_type_node))
  } else {
    render_rust_type_with_applied_binding(n: render_type_node, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices)
  }
  let ty_str = if raw_ty_str == "BoundedLattice" || raw_ty_str == "Rc<BoundedLattice>" {
    match field_value_by_name(record: value, field_name: "top", source_indices: scope.type_env.source_indices) {
      Present { value: top_value } =>
        let top_type_name = authored_name_at(source_indices: scope.type_env.source_indices, node: resolved_type(n: top_value))
        if top_type_name == "" { raw_ty_str }
        else if raw_ty_str == "Rc<BoundedLattice>" { concat("Rc<BoundedLattice<", top_type_name, ">>") }
        else { concat("BoundedLattice<", top_type_name, ">") }
      Absent => raw_ty_str
    }
  } else { raw_ty_str }
  let fn_name = to_snake(name: name)
  let needs_rc = set_contains(shared_types, authored_name_at(source_indices: scope.type_env.source_indices, node: type_node))

  let ty_str = if needs_rc && !rust_type_is_rc_wrapped(type_name: ty_str) {
    wrap_shared_type(target: Rust, inner: ty_str)
  } else {
    ty_str
  }
  if is_simple_type_node(n: type_node, source_indices: scope.type_env.source_indices) || rust_nominal_identity_carrier_type_eligible(type_name: authored_name_at(source_indices: scope.type_env.source_indices, node: type_node)) {
    let val_str = match rust_nominal_identity_data_expr(type_node: type_node, value: value, source_indices: scope.type_env.source_indices) {
      Present { value: identity_expr } => identity_expr
      Absent => emit_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
    }
    let kw = rust_items().func_keyword
    concat(rust_visibility_prefix(), kw, " ", fn_name, "() -> ", ty_str, " { ", val_str, " }")
  } else {
    let body = emit_data_def_body(type_node: type_node, value: value, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, needs_rc: needs_rc)
    let kw = rust_items().func_keyword
    concat(rust_visibility_prefix(), kw, " ", fn_name, "() -> ", ty_str, " {\n",
      "    thread_local! {\n",
      "        static CACHED: ", ty_str, " = {\n",
      body, "\n",
      "        };\n",
      "    }\n",
      "    CACHED.with(|c: &", ty_str, "| c.clone())\n",
      "}")
  }
}

fn rust_nominal_identity_data_expr(type_node: Node, value: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  let type_name = authored_name_at(source_indices: source_indices, node: type_node)
  let is_identity_type = rust_nominal_identity_carrier_type_eligible(type_name: type_name) && type_node.connective == NoConnective && (type_node.children |> count) == 0 && (type_node.params |> count) == 0
  if is_identity_type {
    match value.expr_data {
      ExprVar { binding_kind: _ } =>
        let symbol_name = expr_var_name_at(texpr: value, source_indices: source_indices)
        Present { value: concat(type_name, "(\"", escape_string_literal_body(s: symbol_name), "\".to_string())") }
      _ => none
    }
  } else {
    none
  }
}

fn value_inferred_type_is_rc_wrapped(value: Node, shared_types: Set<String>, scope: InferScope, emit_info: EmitGraphInfo) -> Bool {
  match value.inferred {
    Present { value: Resolved { node: rt } } =>
      rust_type_is_rc_wrapped(type_name: render_rust_type(n: rt, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices, emit_info: emit_info))
    _ => false
  }
}

fn emit_data_def_body(type_node: Node, value: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo, needs_rc: Bool) -> String {
  let raw_ty_str = render_rust_type(n: type_node, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices, emit_info: emit_info)
  let type_name = authored_name_at(source_indices: scope.type_env.source_indices, node: type_node)
  if type_name == "BoundedLattice" {
    match value.expr_data {
      ExprRecordLit { parent_enum: _ } =>
        let lattice_value = field_value_by_name(record: value, field_name: "lattice", source_indices: scope.type_env.source_indices)
        let meet_value = match field_value_by_name(record: value, field_name: "meet", source_indices: scope.type_env.source_indices) {
          Present { value: n } => Present { value: n }
          Absent => match lattice_value {
            Present { value: lattice } => field_value_by_name(record: lattice, field_name: "meet", source_indices: scope.type_env.source_indices)
            Absent => none
          }
        }
        let join_value = match field_value_by_name(record: value, field_name: "join", source_indices: scope.type_env.source_indices) {
          Present { value: n } => Present { value: n }
          Absent => match lattice_value {
            Present { value: lattice } => field_value_by_name(record: lattice, field_name: "join", source_indices: scope.type_env.source_indices)
            Absent => none
          }
        }
        let meet_str = match meet_value {
          Present { value: n } => emit_typed_expr(texpr: n, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          Absent => "compile_error!(\"BoundedLattice data missing meet\")"
        }
        let join_str = match join_value {
          Present { value: n } => emit_typed_expr(texpr: n, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          Absent => "compile_error!(\"BoundedLattice data missing join\")"
        }
        let top_str = match field_value_by_name(record: value, field_name: "top", source_indices: scope.type_env.source_indices) {
          Present { value: n } => emit_typed_expr(texpr: n, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          Absent => "compile_error!(\"BoundedLattice data missing top\")"
        }
        let bottom_str = match field_value_by_name(record: value, field_name: "bottom", source_indices: scope.type_env.source_indices) {
          Present { value: n } => emit_typed_expr(texpr: n, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          Absent => "compile_error!(\"BoundedLattice data missing bottom\")"
        }
        let phantom_line = match lookup_type_by_name(env: scope.type_env, name: "BoundedLattice") {
          Present { value: struct_decl } =>
            let pnames = struct_decl.params |> map(p => generic_param_name_at(n: p, source_indices: scope.type_env.source_indices))
            let unused = struct_unused_param_names(generic_param_names: pnames, children: struct_decl.children, source_indices: scope.type_env.source_indices)
            if (struct_decl.connective == Conj) && ((unused |> count) > 0) {
              "                _phantom: std::marker::PhantomData,\n"
            } else { "" }
          Absent => ""
        }
        concat("            Rc::new(BoundedLattice {\n",
          "                meet: Rc::new(", meet_str, "),\n",
          "                join: Rc::new(", join_str, "),\n",
          "                top: ", top_str, ",\n",
          "                bottom: ", bottom_str, ",\n",
          phantom_line,
          "            })")
      _ => "            compile_error!(\"BoundedLattice data must be a record\")"
    }
  } else if has_nested_records_node(n: type_node, source_indices: scope.type_env.source_indices) && !data_value_has_cross_refs(value: value) {
    let json_str = emit_data_value_json(value: value, source_indices: scope.type_env.source_indices)
    concat("            serde_json::from_value(serde_json::json!(", json_str, "))\n",
      "                .expect(\"valid data definition\")")
  } else {
    let is_map = node_is_keyed_collection(n: type_node, source_indices: scope.type_env.source_indices)
    if is_map {
      match value.expr_data {
        ExprRecordLit { parent_enum: _ } =>
          let key_is_string = map_literal_key_is_string(map_type_node: type_node, source_indices: scope.type_env.source_indices)
          let inserts = value.children |> map(f =>
            let val_str = emit_typed_expr(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
            concat("            __m.insert(", emit_rust_map_literal_key(field_name: field_init_node_name_at(n: f, source_indices: scope.type_env.source_indices), key_is_string: key_is_string, corpus_repr: emit_info.corpus_repr), ", ", val_str, ");")
          )
          let inserts_str = inserts |> join(separator: "\n")
          concat("            let mut __m = HashMap::new();\n",
            inserts_str, "\n",
            "            Rc::new(__m)")
        _ =>
          let val_str = emit_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          concat("            ", val_str)
      }
    } else {
      let val_str = emit_typed_expr(texpr: value, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let is_already_wrapped = match value.expr_data {
        ExprRecordLit { parent_enum: _ } => true
        ExprListLit => true
        ExprVar { binding_kind: bk } =>
          let vname = expr_var_name_at(texpr: value, source_indices: scope.type_env.source_indices)
          match effective_variant_parent(name: vname, binding_kind: bk, resolved_type: value.inferred, emit_info: emit_info, source_indices: scope.type_env.source_indices) {
            Present { value: enum_name } => variant_ref_self_wraps(name: vname, enum_name: enum_name, shared_types: shared_types, corpus_repr: emit_info.corpus_repr)
            Absent => value_inferred_type_is_rc_wrapped(value: value, shared_types: shared_types, scope: scope, emit_info: emit_info)
          }
        _ => value_inferred_type_is_rc_wrapped(value: value, shared_types: shared_types, scope: scope, emit_info: emit_info)
      }
      let wrap_start = if needs_rc && !is_already_wrapped { "Rc::new(" } else { "" }
      let wrap_end = if needs_rc && !is_already_wrapped { ")" } else { "" }
      concat("            ", wrap_start, val_str, wrap_end)
    }
  }
}

fn emit_test_file(module_name: String, projections: List<TestProjection>, corpus_repr: RustCorpusRepr) -> TextFile {
  let depth = 0
  let test_fns = projections
    |> map(p => emit_operation_test(projection: p, depth: depth + 1, corpus_repr: corpus_repr))
  if test_fns |> count == 0 {
    TextFile { path: "", content: "" }
  } else {
    let filename = module_to_filename(name: module_name)
    let tests_str = test_fns |> join(separator: "\n\n")
    let content = concat("// Generated tests -- do not edit.\n",
      "// Source module: ", module_name, "\n\n",
      "#[cfg(test)]\nmod tests {\n",
      "    use super::*;\n\n",
      make_indent(level: depth + 1),tests_str, "\n",
      "}\n")
    TextFile { path: rust_test_file_path(module_name: module_name), content: content }
  }
}

fn rust_test_signature_comment(projection: TestProjection, corpus_repr: RustCorpusRepr) -> String {
  let stub_env = TypeEnv { module_path: "", bindings: empty_map(), str_bindings: empty_map(), ancestry_str_bindings: empty_map(), parents: [], recursive_types: [], recursive_type_set: empty_map(), inductive_fields: empty_map(), source_indices: projection.source_indices, intern_table: empty_intern_table(), source_visible_names: empty_map(), symbol_index: empty_symbol_index() }
  let params_str = projection.params
    |> map(p => concat(param_node_name_at(n: p, source_indices: projection.source_indices), ": ", emit_rust_param_type(n: param_node_type_expr(n: p), generic_param_names: [], shared_types: empty_set(), corpus_repr: corpus_repr, source_indices: projection.source_indices, variant_to_enum: empty_map(), env: stub_env)))
    |> join(separator: ", ")
  concat(
    "// Signature: ",
    sanitize_service_name(name: projection.service_name), ".",
    projection.operation_name,
    "(",
    params_str,
    ") -> ",
    emit_node_type(n: projection.inferred, target: Rust, source_indices: projection.source_indices))
}

fn emit_operation_test(projection: TestProjection, depth: Int, corpus_repr: RustCorpusRepr) -> String {
  let test_name = rust_test_name(projection: projection)
  let struct_name = sanitize_service_name(name: projection.service_name)
  let op_method = to_snake(name: projection.operation_name)
  let indent = make_indent(level: depth + 1)
  let param_args = projection.params |> map(p =>
    emit_rust_default_value(param: p, source_indices: projection.source_indices)
  )
  let args_str = param_args |> join(separator: ", ")
  let call_args = if args_str == "" { "" } else { args_str }
  concat(rust_async_test_decorator(), "\nasync fn ", test_name, "() {\n",
    indent, rust_test_signature_comment(projection: projection, corpus_repr: corpus_repr), "\n",
    indent, "let service = ", struct_name, "::new(crate::dry_run::DryRunMode(true));\n",
    indent, "let result = service.", emit_ident(name: op_method, target: Rust), "(", call_args, ").await;\n",
    indent, "assert!(result.is_ok(), \"", struct_name, ".", projection.operation_name, " should succeed in dry-run mode: {:?}\", result.err());\n",
    "}")
}

fn emit_rust_default_value(param: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let type_name = authored_name_at(source_indices: source_indices, node: param_node_type_expr(n: param))
  match lookup_checkpoint(target: Rust, dag_name: type_name) {
    Present { value: cp } =>
      match cp.default_expr {
        Present { value: expr } => expr
        Absent => concat("compile_error!(\"no test default for type: ", type_name, "\")")
      }
    Absent => concat("compile_error!(\"no test default for type: ", type_name, "\")")
  }
}

fn emit_mock_prop_setup(mock_prop: Node, depth: Int, source_indices: Map<String, NewlineIndex>) -> String {
  let body_str = emit_simple_expr(expr: field_init_node_value(n: mock_prop), target: Rust, source_indices: source_indices)
  concat("let ", field_init_node_name_at(n: mock_prop, source_indices: source_indices), " = ", body_str, ";")
}

fn emit_cargo_dep(name: String, version: String, features: List<String>) -> String {
  if features |> count > 0 {
    let feat_strs = features |> map(f => concat("\"", f, "\""))
    concat(name, " = { version = \"", version, "\", features = [", feat_strs |> join(separator: ", "), "] }\n")
  } else {
    concat(name, " = \"", version, "\"\n")
  }
}

fn emit_cargo_dep_no_default_features(name: String, version: String, features: List<String>) -> String {
  let feat_strs = features |> map(f => concat("\"", f, "\""))
  concat(name, " = { version = \"", version, "\", default-features = false, features = [", feat_strs |> join(separator: ", "), "] }\n")
}

fn emit_cargo_toml(crate_name: String, has_services: Bool) -> TextFile {
  let header = concat(render_cargo_package_header_prefix(name: crate_name), "\nedition = \"2021\"\n")
  let workspace = "\n[workspace]\n"
  let base_deps = [
    emit_cargo_dep(name: "im", version: "15.1", features: ["serde"]),
    emit_cargo_dep(name: "unicode-ident", version: "1", features: []),
    emit_cargo_dep(name: "unicode-properties", version: "0.1", features: ["emoji"]),
    emit_cargo_dep(name: "serde", version: "1", features: ["derive", "rc"]),
    emit_cargo_dep(name: "serde_json", version: "1", features: []),
    emit_cargo_dep(name: "stacker", version: "0.1", features: []),
    emit_cargo_dep(name: "clap", version: "4", features: ["derive"]),
    emit_cargo_dep(name: "lazy_static", version: "1", features: []),
    emit_cargo_dep(name: "ureq", version: "2", features: ["json"])
  ]
  let async_deps = if has_services {
    [
      emit_cargo_dep(name: "tokio", version: "1", features: ["full"]),
      emit_cargo_dep_no_default_features(name: "reqwest", version: "0.12", features: ["json", "rustls-tls", "http2", "charset"]),
      emit_cargo_dep(name: "async-trait", version: "0.1", features: [])
    ]
  } else { [] }
  let all_deps = concat(base_deps, async_deps)
  TextFile { path: "Cargo.toml", content: concat(header, workspace, "\n[dependencies]\n", all_deps |> join(separator: "")) }
}

type WorkflowFunc {
  name: String
  module_name: String
  params: List<Node>
  inferred: Node
  uses: List<Node>
  service_names: List<String>
  resolved_defaults: Map<String, String>
  read_only_params: Set<String>
  source_indices: Map<String, NewlineIndex>
}

fn extract_literal_string(expr: Node) -> String? {
  match expr.expr_data {
    ExprLiteral { value: v } => match v {
      LitStr { value: s } => Present { value: s }
      LitInt { value: i } => Present { value: to_string(value: i) }
      LitFloat { value: f } => Present { value: f }
      LitBool { value: b } => Present { value: if b { "true" } else { "false" } }
      _ => none
    }
    _ => none
  }
}

fn build_data_body_index(modules: List<TypedModule>) -> Map<String, Node> {
  modules |> fold(init: empty_map(), f: (acc, tm) =>
    tm.items |> fold(init: acc, f: (inner, i) =>
      match i.body {
        Present { value: b } => map_insert(inner, authored_name_at(source_indices: tm.type_env.source_indices, node: i), b)
        Absent => inner
      }
    )
  )
}

fn resolve_param_default(param: Node, registry: Map<String, ItemInfo>, data_body_index: Map<String, Node>, source_indices: Map<String, NewlineIndex>) -> String? {
  match param_node_default_value(n: param) {
    Present { value: dv } => match dv.expr_data {
      ExprLiteral { value: _ } => extract_literal_string(expr: dv)
      ExprVar { binding_kind: _ } =>
        match lookup_item(registry: registry, name: authored_name_at(source_indices: source_indices, node: dv)) {
          Present { value: info } => match info.kind {
            DataItem =>
              match map_get(data_body_index, authored_name_at(source_indices: source_indices, node: dv)) {
                Present { value: body } => extract_literal_string(expr: body)
                Absent => none
              }
            _ => none
          }
          Absent => none
        }
      _ => none
    }
    Absent => none
  }
}

fn to_workflow_func(item: Node, module_name: String, registry: Map<String, ItemInfo>, data_body_index: Map<String, Node>, source_indices: Map<String, NewlineIndex>, read_only_params_index: Map<String, Set<String>>) -> WorkflowFunc {
  let item_name = authored_name_at(source_indices: source_indices, node: item)
  let svc_names = match lookup_item(registry: registry, name: item_name) {
    Present { value: info } => info.service_names
    Absent => []
  }
  let defaults = item.params |> fold(init: empty_map(), f: (acc, p) =>
    match resolve_param_default(param: p, registry: registry, data_body_index: data_body_index, source_indices: source_indices) {
      Present { value: lit } => map_insert(acc, param_node_name_at(n: p, source_indices: source_indices), lit)
      Absent => acc
    }
  )
  let qualified = concat(module_name, ".", item_name)
  let ro_params = match map_get(read_only_params_index, qualified) {
    Present { value: m } => m
    Absent => empty_set()
  }
  WorkflowFunc {
    name: item_name,
    module_name: module_name,
    params: item.params,
    inferred: resolved_type(n: item),
    uses: item.uses,
    service_names: svc_names,
    resolved_defaults: defaults,
    read_only_params: ro_params,
    source_indices: source_indices
  }
}

fn is_workflow_item(item: Node, registry: Map<String, ItemInfo>, source_indices: Map<String, NewlineIndex>) -> Bool {
  if item.body == none { false }
  else if item.uses |> count > 0 { true }
  else {

    match lookup_item(registry: registry, name: authored_name_at(source_indices: source_indices, node: item)) {
      Present { value: info } => info.service_names |> count > 0 || info.resource_names |> count > 0
      Absent => true
    }
  }
}

fn collect_workflow_funcs(modules: List<TypedModule>, registry: Map<String, ItemInfo>, read_only_params_index: Map<String, Set<String>>) -> List<WorkflowFunc> {
  let data_body_index = build_data_body_index(modules: modules)
  modules |> flat_map(tm =>
    tm.items
      |> filter(item => is_workflow_item(item: item, registry: registry, source_indices: tm.type_env.source_indices))
      |> map(item => to_workflow_func(item: item, module_name: authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module), registry: registry, data_body_index: data_body_index, source_indices: tm.type_env.source_indices, read_only_params_index: read_only_params_index))
  )
}

fn cli_default_literal_value(expr: Node) -> String? {
  match expr.expr_data {
    ExprLiteral { value: v } => match v {
      LitStr { value: s } => Present { value: s }
      LitInt { value: i } => Present { value: to_string(value: i) }
      LitFloat { value: f } => Present { value: f }
      LitBool { value: b } => Present { value: if b { emit_keyword(key: "true", target: Rust) } else { emit_keyword(key: "false", target: Rust) } }
      LitNull => none
      LitSymbol { value: s } => Present { value: s }
    }
    _ => none
  }
}

fn validate_workflow_param_defaults(workflow_funcs: List<WorkflowFunc>) -> List<ErrorNode> {
  workflow_funcs |> flat_map(wf =>
    wf.params |> flat_map(param =>
      match param_node_default_value(n: param) {
        Present { value: dv } =>
          let param_name = authored_name_at(source_indices: wf.source_indices, node: param)
          let resolved = match map_get(wf.resolved_defaults, param_name) {
            Present { value: _ } => true
            Absent => match cli_default_literal_value(expr: dv) {
              Present { value: _ } => true
              Absent => false
            }
          }
          if resolved { [] }
          else { [make_error_node(diagnostic: InternalError { message: concat(
              "workflow CLI default for parameter `", param_name,
              "` must be a string, int, float, bool literal, or data reference"
            ), span: param.span }, module_name: wf.module_name)] }
        Absent => []
      }
    )
  )
}

fn find_resource_module(resource_name: String, modules: List<TypedModule>) -> String {
  let matching = modules |> filter(m => m.items |> any(item => authored_name_at(source_indices: m.type_env.source_indices, node: item) == resource_name))
  let result = match matching |> first {
    Present { value: tm } => module_to_filename(name: authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module))
    Absent => ""
  }
  result
}

fn emit_main_rs(workflow_funcs: List<WorkflowFunc>, modules: List<TypedModule>, has_services: Bool, crate_name: String, svc_module_map: Map<String, String>) -> TextFile {
  let has_pipeline = modules |> any(m => authored_name_at(source_indices: m.type_env.source_indices, node: m.module) == "v1.compiler.compile")
  let resource_type_names = workflow_funcs |> flat_map(wf => wf.uses |> map(u => authored_name_at(source_indices: wf.source_indices, node: resource_use_resource(n: u))))
  let unique_resource_types = unique_strings(items: resource_type_names)
  let resource_imports = unique_resource_types |> flat_map(rname =>
    let mod_name = find_resource_module(resource_name: rname, modules: modules)
    if mod_name != "" { [concat("use ", crate_name, "::", mod_name, "::", rname, ";")] }
    else { [] }
  )
  let resource_imports_str = resource_imports |> join(separator: "\n")
  let all_svc_names = workflow_funcs |> flat_map(wf => wf.service_names)
  let unique_svc_names = unique_strings(items: all_svc_names)
  let svc_imports = unique_svc_names |> flat_map(sn =>
    let struct_name = sanitize_service_name(name: sn)
    match map_get(svc_module_map, sn) {
      Present { value: mod_name } => [concat("use ", crate_name, "::", mod_name, "::", struct_name, ";")]
      Absent => []
    }
  )
  let svc_imports_str = svc_imports |> join(separator: "\n")
  let header = concat(
    "// Generated by v1 compiler -- do not edit.\n\n",
    "#![allow(unused_parens, clippy::all, clippy::disallowed_macros)]\n\n",
    concat("use clap::", "{", "Parser, Subcommand", "}", ";\n")
  )
  let crate_use = if has_services {
    concat("use ", crate_name, "::dry_run::DryRunMode;\n")
  } else {
    ""
  }
  let resource_use = if resource_imports_str != "" { concat(resource_imports_str, "\n") } else { "" }
  let svc_use = if svc_imports_str != "" { concat(svc_imports_str, "\n") } else { "" }
  if workflow_funcs |> count == 0 && has_pipeline == false {
    return TextFile {
      path: concat(rust_source_root(), "main", rust_source_ext()),
      content: concat(
        "// Generated by v1 compiler -- do not edit.\n\n",
        "#![allow(unused_parens, clippy::all, clippy::disallowed_macros)]\n\n",
        "fn main() {}\n")
    }
  }
  let mod_uses = emit_main_mod_uses(workflow_funcs: workflow_funcs, has_pipeline: has_pipeline, crate_name: crate_name)
  let binary_name = if has_pipeline { "gunbc" } else { crate_name }
  let cli_about = if has_pipeline { "A causal compiler: write .dag, get Rust/Python/Go." } else { "" }
  let cli_struct = emit_cli_struct(workflow_funcs: workflow_funcs, binary_name: binary_name, about: cli_about)
  let subcommand_enum = emit_subcommand_enum(workflow_funcs: workflow_funcs, has_pipeline: has_pipeline)
  let pipeline_fns = if has_pipeline { emit_main_pipeline_fns(crate_name: crate_name) } else { "" }
  let main_fn = emit_main_fn(workflow_funcs: workflow_funcs, has_services: has_services, has_pipeline: has_pipeline, crate_name: crate_name)
  let diagnostic_fns = if has_pipeline { emit_main_diagnostic_fns(crate_name: crate_name) } else { "" }
  let content = concat(
    header, crate_use, resource_use, svc_use, mod_uses, "\n",
    cli_struct, "\n\n",
    subcommand_enum, "\n\n",
    pipeline_fns,
    main_fn, "\n",
    diagnostic_fns
  )
  TextFile { path: concat(rust_source_root(), "main", rust_source_ext()), content: content }
}

fn emit_main_mod_uses(workflow_funcs: List<WorkflowFunc>, has_pipeline: Bool, crate_name: String) -> String {
  let mod_names = workflow_funcs |> map(wf => module_to_filename(name: wf.module_name))
  let unique_mods = unique_strings(items: mod_names)
  let use_lines = unique_mods |> map(m => concat("use ", crate_name, "::", m, ";"))
  let base = use_lines |> join(separator: "\n")
  if has_pipeline {
    let pipeline_mod = module_to_filename(name: "v1.compiler.compile")
    let core_mod = module_to_filename(name: "v1.std.core")
    concat(base,
      "\nuse im::\{vector as vec, HashMap, OrdSet as BTreeSet, Vector as Vec\};\n",
      "use std::rc::Rc;\n",
      "use ", crate_name, "::", pipeline_mod, ";\n",
      "use ", crate_name, "::", pipeline_mod, "::PipelineResult;\n",
      "use ", crate_name, "::", core_mod, "::", "{",
      "\n    diagnostic_to_message, diagnostic_to_span,\n",
      "    byte_to_line_col, source_line_at, NewlineIndex,\n",
      "    CompilerDiagnostic,\n",
      "}", ";\n",
      "use ", crate_name, "::cli_run;\n")
  } else {
    base
  }
}

fn emit_cli_struct(workflow_funcs: List<WorkflowFunc>, binary_name: String, about: String) -> String {
  let about_attr = if about != "" { concat(", about = \"", about, "\"") } else { "" }
  concat(
    "#[derive(Parser)]\n",
    "#[command(name = \"", binary_name, "\"", about_attr, ")]\n",
    "struct Cli {\n",
    "    #[command(subcommand)]\n",
    "    command: Commands,\n",
    "    /// Run in dry-run mode (mock all service calls)\n",
    "    #[arg(long, global = true)]\n",
    "    dry_run: bool,\n",
    "}"
  )
}

fn emit_subcommand_enum(workflow_funcs: List<WorkflowFunc>, has_pipeline: Bool) -> String {
  let depth = 0
  let variants = workflow_funcs |> map(wf => emit_subcommand_variant(wf: wf, depth: depth + 1))
  let compile_variant = if has_pipeline {
    concat(
      "/// Compile .dag source files to a target language\n",
      make_indent(level: depth + 1), "Compile {\n",
      make_indent(level: depth + 2), "/// Source root directories (searched recursively for .dag files).\n",
      make_indent(level: depth + 2), "/// Module imports are resolved transitively from these roots.\n",
      make_indent(level: depth + 2), "#[arg(long = \"source-root\")]\n",
      make_indent(level: depth + 2), "source_roots: Vec<String>,\n",
      make_indent(level: depth + 2), "/// Legacy: single source directory (all .dag files loaded, no import resolution)\n",
      make_indent(level: depth + 2), "#[arg(long = \"source-dir\")]\n",
      make_indent(level: depth + 2), "source_dir: Option<String>,\n",
      make_indent(level: depth + 2), "#[arg(long)]\n",
      make_indent(level: depth + 2), "output_dir: String,\n",
      make_indent(level: depth + 2), "/// Target language: rust, python, go, dag, or + separated set such as rust+dag\n",
      make_indent(level: depth + 2), "#[arg(long, default_value = \"rust\")]\n",
      make_indent(level: depth + 2), "target: String,\n",
      make_indent(level: depth + 2), "#[arg(long = \"dependency-pool-index\", default_value = \"strict\")]\n",
      make_indent(level: depth + 2), "dependency_pool_index: String,\n",
      make_indent(level: depth + 1), "},")
  } else { "" }
  let run_variant_lines = [
    "/// Execute a .dag program directly (interpreter)\n",
    make_indent(level: depth + 1), "Run {\n",
    make_indent(level: depth + 2), "/// Source root directories (searched recursively for .dag files)\n",
    make_indent(level: depth + 2), "#[arg(long = \"source-root\")]\n",
    make_indent(level: depth + 2), "source_roots: Vec<String>,\n",
    make_indent(level: depth + 2), "/// Entry function to execute (default: \"main\")\n",
    make_indent(level: depth + 2), "#[arg(long, default_value = \"main\")]\n",
    make_indent(level: depth + 2), "function: String,\n",
    make_indent(level: depth + 2), "/// Entry `.dag` file: load only this module and its transitive imports\n",
    make_indent(level: depth + 2), "/// (not every file under --source-root). Required for scoped TestClaim runs.\n",
    make_indent(level: depth + 2), "#[arg(long)]\n",
    make_indent(level: depth + 2), "entry: Option<String>,\n",
    make_indent(level: depth + 2), "/// TestClaim / witness run: Bool false → exit 1; requires --entry\n",
    make_indent(level: depth + 2), "#[arg(long)]\n",
    make_indent(level: depth + 2), "claim_run: bool,\n",
    make_indent(level: depth + 2), "/// Named argument for the entry function, repeatable: `--arg name=value`.\n",
    make_indent(level: depth + 2), "/// Values enter as String; a missing `=` refuses rather than guessing.\n",
    make_indent(level: depth + 2), "#[arg(long = \"arg\")]\n",
    make_indent(level: depth + 2), "args: Vec<String>,\n",
    make_indent(level: depth + 1), "},"]
  let run_variant = if has_pipeline { run_variant_lines |> join(separator: "") } else { "" }
  let all_variants = if has_pipeline { concat(variants, [compile_variant, run_variant]) } else { variants }
  let variants_str = all_variants |> join(separator: "\n")
  concat(
    "#[derive(Subcommand)]\n",
    "enum Commands {\n",
    make_indent(level: depth + 1),variants_str, "\n",
    "}"
  )
}

fn emit_subcommand_variant(wf: WorkflowFunc, depth: Int) -> String {
  let variant_name = to_pascal(name: wf.name)
  let doc_line = concat("/// Run the ", wf.name, " workflow")
  if wf.params |> count == 0 {
    concat(doc_line, "\n", variant_name, ",")
  } else {
    let fields = wf.params |> map(p => emit_subcommand_field(param: p, source_indices: wf.source_indices, resolved_defaults: wf.resolved_defaults))
    let fields_str = fields |> join(separator: "\n")
    concat(doc_line, "\n", variant_name, " {\n",
      make_indent(level: depth + 1),fields_str, "\n",
      "},")
  }
}

fn emit_subcommand_field(param: Node, source_indices: Map<String, NewlineIndex>, resolved_defaults: Map<String, String>) -> String {
  let field_name = emit_ident(name: param_node_name_at(n: param, source_indices: source_indices), target: Rust)
  let param_name = param_node_name_at(n: param, source_indices: source_indices)
  let field_type = emit_cli_param_type_node(n: param_node_type_expr(n: param), source_indices: source_indices)
  let default_attr = match map_get(resolved_defaults, param_name) {
    Present { value: resolved } =>
      concat("#[arg(long, default_value = \"", resolved, "\")]\n")
    Absent => match param_node_default_value(n: param) {
      Present { value: dv } => match cli_default_literal_value(expr: dv) {
        Present { value: default_value } =>
          concat("#[arg(long, default_value = \"", default_value, "\")]\n")
        Absent => "#[arg(long)]\n"
      }
      Absent => "#[arg(long)]\n"
    }
  }
  concat(default_attr, field_name, ": ", field_type, ",")
}

fn emit_cli_param_type_node(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let is_optional = n.return_cardinality == CardOptional
  let has_structure = n.connective != NoConnective
  if is_optional {
    concat("Option<", emit_cli_param_type_node(n: with_required_cardinality(n: n), source_indices: source_indices), ">")
  } else if has_structure {
    "String"
  } else if n.children |> count == 0 {
    let nname = authored_name_at(source_indices: source_indices, node: n)
    if nname == "String" {
      "String"
    } else {
      let mapped = coerce_primitive_type(target: Rust, dag_name: nname)
      if mapped != nname { mapped } else { "String" }
    }
  } else {
    "String"
  }
}

fn emit_main_fn(workflow_funcs: List<WorkflowFunc>, has_services: Bool, has_pipeline: Bool, crate_name: String) -> String {
  let depth = 0
  let async_attr = if has_services { "#[tokio::main]\nasync fn main() " } else { "fn main() " }
  let parse_line = "let cli = Cli::parse();"
  let dry_run_line = if has_services {
    "let dry_run = DryRunMode(cli.dry_run);"
  } else {
    ""
  }
  let match_arms = workflow_funcs |> map(wf => emit_main_match_arm(wf: wf, has_services: has_services))
  let compile_arm = if has_pipeline { emit_compile_match_arm(crate_name: crate_name) } else { "" }
  let run_arm = if has_pipeline { emit_run_match_arm(crate_name: crate_name) } else { "" }
  let all_arms = if has_pipeline { concat(match_arms, [compile_arm, run_arm]) } else { match_arms }
  let arms_str = all_arms |> join(separator: "\n")
  let match_block = concat("match cli.command {\n", make_indent(level: depth + 2),arms_str, "\n    }")
  let result_handling = if has_services {
    match_block
  } else {
    concat("let _result = ", match_block, ";")
  }
  let body_lines = if dry_run_line == "" {
    concat(parse_line, "\n", result_handling)
  } else {
    concat(parse_line, "\n", dry_run_line, "\n", result_handling)
  }
  concat(async_attr, "{\n", make_indent(level: depth + 1),body_lines, "\n}")
}

fn emit_compile_match_arm(crate_name: String) -> String {
  let pipeline_mod = module_to_filename(name: "v1.compiler.compile")
  concat(
    "Commands::Compile { source_roots, source_dir, output_dir, target, dependency_pool_index } => {\n",
    "            let render_targets = parse_render_targets(&target);\n",
    "            let pool_index = parse_dependency_pool_index(&dependency_pool_index);\n",
    "\n",
    "            let sources = if !source_roots.is_empty() {\n",
    "                let index = build_module_index(&source_roots, pool_index);\n",
    "                eprintln!(\"indexed {} modules from {} source roots\", index.len(), source_roots.len());\n",
    "\n",
    "                // Entry modules: all .dag files in the FIRST source root.\n",
    "                // Additional roots are dependency pools resolved via imports.\n",
    "                // This is intentional: --source-root src/v1 --source-root dag\n",
    "                // means 'compile src/v1, using dag as a dependency pool.'\n",
    "                let first_root = std::path::Path::new(&source_roots[0]);\n",
    "                let mut entry_files = Vec::new();\n",
    "                if first_root.is_dir() {\n",
    "                    let mut dag_paths = Vec::new();\n",
    "                    collect_dag_files(first_root, &mut dag_paths);\n",
    "                    for path in dag_paths {\n",
    "                        let content = std::fs::read_to_string(&path)\n",
    "                            .unwrap_or_else(|e| panic!(\"failed to read {:?}: {}\", path, e));\n",
    "                        entry_files.push((path.to_string_lossy().to_string(), content));\n",
    "                    }\n",
    "                }\n",
    "                let skipped_moduleless = cli_run::moduleless_dag_entry_paths(&entry_files);\n",
    "                cli_run::report_moduleless_dag_entry_skips(&skipped_moduleless);\n",
    "\n",
    "                let mut seen: HashMap<String, Rc<", pipeline_mod, "::SourceFile>> = HashMap::new();\n",
    "                let mut entry_for_queue = Vec::new();\n",
    "                for (path, content) in &entry_files {\n",
    "                    if let Some(mod_path) = extract_module_path(content) {\n",
    "                        let source = Rc::new(", pipeline_mod, "::SourceFile {\n",
    "                            path: path.clone(),\n",
    "                            content: content.clone(),\n",
    "                        });\n",
    "                        seen.insert(mod_path, source);\n",
    "                        entry_for_queue.push((path.clone(), content.clone()));\n",
    "                    }\n",
    "                }\n",
    "\n",
    "                let mut resolved = resolve_transitively_with_seen(entry_for_queue, &index, seen);\n",
    "                for (path, content) in entry_files {\n",
    "                    if extract_module_path(&content).is_none() { continue; }\n",
    "                    let already_there = resolved.iter().any(|s| s.path == path);\n",
    "                    if !already_there {\n",
    "                        resolved.push(Rc::new(", pipeline_mod, "::SourceFile { path, content }));\n",
    "                    }\n",
    "                }\n",
    "                eprintln!(\"resolved {} sources (transitive import closure)\", resolved.len());\n",
    "                resolved\n",
    "\n",
    "            } else if let Some(dir) = source_dir {\n",
    "                // Legacy: flat directory scan (backward compatibility)\n",
    "                let mut dag_paths = Vec::new();\n",
    "                collect_dag_files(std::path::Path::new(&dir), &mut dag_paths);\n",
    "                let mut sources = Vec::new();\n",
    "                for path in &dag_paths {\n",
    "                    let content = std::fs::read_to_string(path)\n",
    "                        .unwrap_or_else(|e| panic!(\"failed to read {:?}: {}\", path, e));\n",
    "                    let filename = path.file_name().unwrap().to_string_lossy().to_string();\n",
    "                    sources.push(Rc::new(", pipeline_mod, "::SourceFile {\n",
    "                        path: filename,\n",
    "                        content,\n",
    "                    }));\n",
    "                }\n",
    "                eprintln!(\"compiling {} .dag files from {} (target: {})\", sources.len(), dir, target);\n",
    "                sources\n",
    "\n",
    "            } else {\n",
    "                eprintln!(\"error: provide --source-root or --source-dir\");\n",
    "                std::process::exit(1);\n",
    "            };\n",
    "\n",
    "            if render_targets.len() == 1 {\n",
    "                let result = ", pipeline_mod, "::compile_sources(Rc::new(sources), render_targets[0].1.clone());\n",
    "                write_output_files(&output_dir, &result);\n",
    "                eprintln!(\"compiled: {} files emitted, {} diagnostics\", result.files.len(), result.diagnostics.len());\n",
    "                render_diagnostics(&result);\n",
    "                if hard_errors(&result) {\n",
    "                    std::process::exit(1);\n",
    "                }\n",
    "                if result.files.is_empty() {\n",
    "                    eprintln!(\"error: no files emitted\");\n",
    "                    std::process::exit(1);\n",
    "                }\n",
    "            } else {\n",
    "                let resolved = ", pipeline_mod, "::compile_to_resolved(Rc::new(sources));\n",
    "                let mut any_hard_errors = false;\n",
    "                let mut any_empty = false;\n",
    "                let mut total_files = 0usize;\n",
    "                let mut total_diagnostics = 0usize;\n",
    "                for (name, render_target) in render_targets {\n",
    "                    let result = ", pipeline_mod, "::emit_resolved_for_target(resolved.clone(), render_target);\n",
    "                    let target_output_dir = format!(\"{}/{}\", output_dir, name);\n",
    "                    write_output_files(&target_output_dir, &result);\n",
    "                    eprintln!(\"compiled[{}]: {} files emitted, {} diagnostics\", name, result.files.len(), result.diagnostics.len());\n",
    "                    render_diagnostics(&result);\n",
    "                    any_hard_errors |= hard_errors(&result);\n",
    "                    any_empty |= result.files.is_empty();\n",
    "                    total_files += result.files.len();\n",
    "                    total_diagnostics += result.diagnostics.len();\n",
    "                }\n",
    "                eprintln!(\"compiled: {} files emitted, {} diagnostics\", total_files, total_diagnostics);\n",
    "                if any_hard_errors {\n",
    "                    std::process::exit(1);\n",
    "                }\n",
    "                if any_empty {\n",
    "                    eprintln!(\"error: no files emitted for at least one target\");\n",
    "                    std::process::exit(1);\n",
    "                }\n",
    "            }\n",
    "        },")
}

fn emit_run_match_arm(crate_name: String) -> String {
  concat(
    "\n        Commands::Run { source_roots, function, entry, claim_run, args } => {\n",
    "            cli_run::handle_run_with_options(source_roots, function, entry, cli.dry_run, claim_run, args);\n",
    "        },")
}

fn emit_main_pipeline_fns(crate_name: String) -> String {
  let pipeline_mod = module_to_filename(name: "v1.compiler.compile")
  let artifact_mod = module_to_filename(name: "v1.compiler.artifact")
  concat(
    emit_collect_dag_files_fn(),
    emit_extract_module_path_fn(),
    emit_extract_import_paths_fn(),
    emit_dep_pool_type_and_fns(),
    emit_resolve_transitively_fn(crate_name: crate_name, pipeline_mod: pipeline_mod),
    emit_compile_target_helpers(crate_name: crate_name, pipeline_mod: pipeline_mod, artifact_mod: artifact_mod))
}

fn emit_compile_target_helpers(crate_name: String, pipeline_mod: String, artifact_mod: String) -> String {
  concat(
    "fn render_target_from_name(target: &str) -> Option<", crate_name, "::", artifact_mod, "::RenderTarget> {\n",
    "    match target {\n",
    "        \"rust\" => Some(", crate_name, "::", artifact_mod, "::RenderTarget::Rust),\n",
    "        \"python\" => Some(", crate_name, "::", artifact_mod, "::RenderTarget::Python),\n",
    "        \"go\" => Some(", crate_name, "::", artifact_mod, "::RenderTarget::Go),\n",
    "        \"dag\" => Some(", crate_name, "::", artifact_mod, "::RenderTarget::Dag),\n",
    "        _ => None,\n",
    "    }\n",
    "}\n",
    "\n",
    "fn parse_render_targets(target: &str) -> Vec<(String, ", crate_name, "::", artifact_mod, "::RenderTarget)> {\n",
    "    let mut targets = Vec::new();\n",
    "    for part in target.split('+') {\n",
    "        let trimmed = part.trim();\n",
    "        if trimmed.is_empty() {\n",
    "            continue;\n",
    "        }\n",
    "        match render_target_from_name(trimmed) {\n",
    "            Some(render_target) => targets.push((trimmed.to_string(), render_target)),\n",
    "            None => {\n",
    "                eprintln!(\"unknown target: {}. supported: rust, python, go, dag, rust+dag\", target);\n",
    "                std::process::exit(1);\n",
    "            }\n",
    "        }\n",
    "    }\n",
    "    if targets.is_empty() {\n",
    "        eprintln!(\"error: --target must name at least one target\");\n",
    "        std::process::exit(1);\n",
    "    }\n",
    "    targets\n",
    "}\n",
    "\n",
    "fn write_output_files(output_dir: &str, result: &", crate_name, "::", pipeline_mod, "::PipelineResult) {\n",
    "    std::fs::create_dir_all(format!(\"{}/src\", output_dir))\n",
    "        .unwrap_or_else(|e| panic!(\"failed to create output dir: {}\", e));\n",
    "    for file in result.files.iter() {\n",
    "        let out_path = format!(\"{}/{}\", output_dir, file.path);\n",
    "        if let Some(parent) = std::path::Path::new(&out_path).parent() {\n",
    "            std::fs::create_dir_all(parent).ok();\n",
    "        }\n",
    "        std::fs::write(&out_path, &*file.content)\n",
    "            .unwrap_or_else(|e| panic!(\"failed to write {}: {}\", file.path, e));\n",
    "    }\n",
    "}\n",
    "\n",
    "fn hard_errors(result: &", crate_name, "::", pipeline_mod, "::PipelineResult) -> bool {\n",
    "    result.diagnostics.iter().any(|d| {\n",
    "        !matches!(*d.diagnostic.clone(), CompilerDiagnostic::ComplexityUnknown { .. })\n",
    "    })\n",
    "}\n",
    "\n")
}

fn emit_collect_dag_files_fn() -> String {
  concat(
    "/// Recursively find all .dag files under a directory.\n",
    "/// Fail-closed: panics on unreadable directory entries.\n",
    "fn collect_dag_files(dir: &std::path::Path, files: &mut Vec<std::path::PathBuf>) {\n",
    "    let mut entries: Vec<_> = std::fs::read_dir(dir)\n",
    "        .unwrap_or_else(|e| panic!(\"failed to read dir {:?}: {}\", dir, e))\n",
    "        .map(|e| e.unwrap_or_else(|e| panic!(\"failed to read dir entry in {:?}: {}\", dir, e)))\n",
    "        .collect();\n",
    "    entries.sort_by_key(|e| e.file_name());\n",
    "    for entry in entries {\n",
    "        let path = entry.path();\n",
    "        if path.is_dir() {\n",
    "            collect_dag_files(&path, files);\n",
    "        } else if path.extension().map(|e| e == \"dag\").unwrap_or(false) {\n",
    "            files.push(path);\n",
    "        }\n",
    "    }\n",
    "}\n\n")
}

fn emit_extract_module_path_fn() -> String {
  concat(
    "/// Extract the `module x.y.z` declaration from a .dag file's first lines.\n",
    "fn extract_module_path(content: &str) -> Option<String> {\n",
    "    for line in content.lines() {\n",
    "        let trimmed = line.trim();\n",
    "        if trimmed.starts_with(\"module \") {\n",
    "            return Some(trimmed[\"module \".len()..].trim().to_string());\n",
    "        }\n",
    "        if !trimmed.is_empty() && !trimmed.starts_with(\"//\") {\n",
    "            break;\n",
    "        }\n",
    "    }\n",
    "    None\n",
    "}\n\n")
}

fn emit_extract_import_paths_fn() -> String {
  concat(
    "/// Extract import module paths from a .dag file's import declarations.\n",
    "fn extract_import_paths(content: &str) -> Vec<String> {\n",
    "    let mut imports = Vec::new();\n",
    "    for line in content.lines() {\n",
    "        let trimmed = line.trim();\n",
    "        if trimmed.starts_with(\"import \") {\n",
    "            let rest = trimmed[\"import \".len()..].trim();\n",
    "            let module_path = rest.split('{').next().unwrap_or(rest).trim();\n",
    "            if !module_path.is_empty() {\n",
    "                imports.push(module_path.to_string());\n",
    "            }\n",
    "        }\n",
    "    }\n",
    "    imports\n",
    "}\n\n")
}

fn emit_dep_pool_type_and_fns() -> String {
  concat(
    "#[derive(Clone, Copy, PartialEq, Eq)]\nenum DependencyPoolIndex {\n    Strict,\n    PrimaryPrecedence,\n}\n\n",
    "fn parse_dependency_pool_index(value: &str) -> DependencyPoolIndex {\n",
    "    match value {\n",
    "        \"strict\" => DependencyPoolIndex::Strict,\n",
    "        \"primary-precedence\" => DependencyPoolIndex::PrimaryPrecedence,\n",
    "        other => {\n",
    "            eprintln!(\"unknown --dependency-pool-index: {} (expected strict | primary-precedence)\", other);\n",
    "            std::process::exit(1);\n",
    "        }\n",
    "    }\n",
    "}\n\n",
    "fn insert_module_path(\n",
    "    index: &mut HashMap<String, std::path::PathBuf>,\n",
    "    module_path: String,\n",
    "    path: std::path::PathBuf,\n",
    "    within_root: &mut HashMap<String, std::path::PathBuf>,\n",
    ") {\n",
    "    if let Some(existing) = within_root.get(&module_path) {\n",
    "        panic!(\"duplicate module path '{}' within source root: declared in both {:?} and {:?}\", module_path, existing, path);\n",
    "    }\n",
    "    within_root.insert(module_path.clone(), path.clone());\n",
    "    index.insert(module_path, path);\n",
    "}\n\n",
    "fn index_source_root(root: &str, index: &mut HashMap<String, std::path::PathBuf>, pool_fill_only: bool) {\n",
    "    let root_path = std::path::Path::new(root);\n",
    "    if !root_path.exists() {\n",
    "        panic!(\"source root does not exist: {}\", root);\n",
    "    }\n",
    "    let mut dag_files = Vec::new();\n",
    "    collect_dag_files(root_path, &mut dag_files);\n",
    "    let mut within_root = HashMap::new();\n",
    "    for path in dag_files {\n",
    "        let content = std::fs::read_to_string(&path)\n",
    "            .unwrap_or_else(|e| panic!(\"failed to read {:?}: {}\", path, e));\n",
    "        if let Some(module_path) = extract_module_path(&content) {\n",
    "            if pool_fill_only {\n",
    "                if index.contains_key(&module_path) {\n",
    "                    continue;\n",
    "                }\n",
    "                insert_module_path(index, module_path, path, &mut within_root);\n",
    "            } else if let Some(existing) = index.get(&module_path) {\n",
    "                panic!(\"duplicate module path '{}': declared in both {:?} and {:?}\", module_path, existing, path);\n",
    "            } else {\n",
    "                insert_module_path(index, module_path, path, &mut within_root);\n",
    "            }\n",
    "        }\n",
    "    }\n",
    "}\n\n",
    "fn build_module_index(source_roots: &[String], pool_index: DependencyPoolIndex) -> HashMap<String, std::path::PathBuf> {\n",
    "    let mut index = HashMap::new();\n",
    "    if source_roots.is_empty() {\n",
    "        return index;\n",
    "    }\n",
    "    match pool_index {\n",
    "        DependencyPoolIndex::Strict => {\n",
    "            for root in source_roots {\n",
    "                index_source_root(root, &mut index, false);\n",
    "            }\n",
    "        }\n",
    "        DependencyPoolIndex::PrimaryPrecedence => {\n",
    "            index_source_root(&source_roots[0], &mut index, false);\n",
    "            for root in &source_roots[1..] {\n",
    "                index_source_root(root, &mut index, true);\n",
    "            }\n",
    "        }\n",
    "    }\n",
    "    index\n",
    "}\n\n")
}

fn emit_resolve_transitively_fn(crate_name: String, pipeline_mod: String) -> String {
  concat(
    "/// Resolve imports transitively from entry modules.\n",
    "/// Fail-closed: panics on unreadable imported files.\n",
    "/// Returns sources sorted by path for deterministic fixed-point convergence.\n",
    "fn resolve_transitively_with_seen(\n",
    "    entry_sources: Vec<(String, String)>,\n",
    "    index: &HashMap<String, std::path::PathBuf>,\n",
    "    mut seen: HashMap<String, Rc<", crate_name, "::", pipeline_mod, "::SourceFile>>,\n",
    ") -> Vec<Rc<", crate_name, "::", pipeline_mod, "::SourceFile>> {\n",
    "    let mut queue: Vec<(String, String)> = entry_sources;\n",
    "\n",
    "    while let Some((_path, content)) = queue.pop() {\n",
    "        let imports = extract_import_paths(&content);\n",
    "        for module_path in imports {\n",
    "            if seen.contains_key(&module_path) {\n",
    "                continue;\n",
    "            }\n",
    "            if let Some(file_path) = index.get(&module_path) {\n",
    "                let file_content = std::fs::read_to_string(file_path)\n",
    "                    .unwrap_or_else(|e| panic!(\"failed to read imported module '{}' at {:?}: {}\",\n",
    "                        module_path, file_path, e));\n",
    "                let rel_path = file_path.to_string_lossy().to_string();\n",
    "                let source = Rc::new(", crate_name, "::", pipeline_mod, "::SourceFile {\n",
    "                    path: rel_path.clone(),\n",
    "                    content: file_content.clone(),\n",
    "                });\n",
    "                seen.insert(module_path, source);\n",
    "                queue.push((rel_path, file_content));\n",
    "            }\n",
    "            // If not found in index, the compiler's resolve stage will report the error.\n",
    "        }\n",
    "    }\n",
    "\n",
    "    let mut result: Vec<_> = seen.into_iter().map(|(_, v)| v).collect();\n",
    "    result.sort_by(|a, b| a.path.cmp(&b.path));\n",
    "    result\n",
    "}\n\n")
}

fn emit_main_diagnostic_fns(crate_name: String) -> String {
  let core_mod = module_to_filename(name: "v1.std.core")
  concat(
    "\nfn render_diagnostics(result: &PipelineResult) {\n",
    "    if result.diagnostics.is_empty() {\n",
    "        return;\n",
    "    }\n",
    "\n",
    "    let index_map: HashMap<String, Rc<NewlineIndex>> = result\n",
    "        .newline_indices\n",
    "        .iter()\n",
    "        .map(|idx| (idx.file.clone(), idx.clone()))\n",
    "        .collect();\n",
    "\n",
    "    for d in result.diagnostics.iter() {\n",
    "        render_one_diagnostic(d, &index_map, \"\");\n",
    "    }\n",
    "\n",
    "    eprintln!(\"\\n{} error(s)\", result.diagnostics.len());\n",
    "}\n",
    "\n",
    "fn render_one_diagnostic(\n",
    "    d: &", crate_name, "::", core_mod, "::ErrorNode,\n",
    "    index_map: &HashMap<String, Rc<NewlineIndex>>,\n",
    "    indent: &str,\n",
    ") {\n",
    "    let severity = \"error\";\n",
    "    let message = diagnostic_to_message(d.diagnostic.clone());\n",
    "    let span = diagnostic_to_span(d.diagnostic.clone());\n",
    "\n",
    "    let location = if !span.file.is_empty() {\n",
    "        if let Some(idx) = index_map.get(&span.file) {\n",
    "            let lc = byte_to_line_col(idx.clone(), span.start);\n",
    "            format!(\"{}:{}:{}\", span.file, lc.line, lc.col)\n",
    "        } else {\n",
    "            span.file.clone()\n",
    "        }\n",
    "    } else if !d.module_name.is_empty() {\n",
    "        d.module_name.clone()\n",
    "    } else {\n",
    "        String::new()\n",
    "    };\n",
    "\n",
    "    if location.is_empty() {\n",
    "        eprintln!(\"{}{}: {}\", indent, severity, message);\n",
    "    } else {\n",
    "        eprintln!(\"{}{}[{}]: {}\", indent, severity, location, message);\n",
    "    }\n",
    "\n",
    "    if !span.file.is_empty() {\n",
    "        if let Some(idx) = index_map.get(&span.file) {\n",
    "            let lc = byte_to_line_col(idx.clone(), span.start);\n",
    "            let line_text = source_line_at(idx.clone(), lc.line);\n",
    "            let line_num = format!(\"{}\", lc.line);\n",
    "            let gutter_width = line_num.len();\n",
    "            eprintln!(\"{} {} |\", indent, \" \".repeat(gutter_width));\n",
    "            eprintln!(\"{} {} | {}\", indent, line_num, line_text);\n",
    "\n",
    "            let span_len = std::cmp::max(1, (span.end - span.start) as usize);\n",
    "            let col_offset = (lc.col - 1) as usize;\n",
    "            eprintln!(\n",
    "                \"{} {} | {}{}\",\n",
    "                indent,\n",
    "                \" \".repeat(gutter_width),\n",
    "                \" \".repeat(col_offset),\n",
    "                \"^\".repeat(std::cmp::min(span_len, line_text.len().saturating_sub(col_offset)))\n",
    "            );\n",
    "        }\n",
    "    }\n",
    "}\n")
}

fn emit_main_match_arm(wf: WorkflowFunc, has_services: Bool) -> String {
  let variant_name = to_pascal(name: wf.name)
  let mod_name = module_to_filename(name: wf.module_name)
  let fn_name = emit_ident(name: wf.name, target: Rust)
  let await_suffix = if has_services { ".await" } else { "" }
  let call_expr = if wf.params |> count == 0 {
    let service_args = emit_main_service_args(wf: wf, has_services: has_services)
    concat(mod_name, "::", fn_name, "(", service_args, ")", await_suffix)
  } else {
    let call_args = emit_main_call_args(wf: wf, has_services: has_services)
    concat(mod_name, "::", fn_name, "(", call_args, ")", await_suffix)
  }
  let pattern = if wf.params |> count == 0 {
    concat("Commands::", variant_name)
  } else {
    let field_binds = wf.params |> map(p => emit_ident(name: param_node_name_at(n: p, source_indices: wf.source_indices), target: Rust))
    let binds_str = field_binds |> join(separator: ", ")
    concat("Commands::", variant_name, " { ", binds_str, " }")
  }
  if has_services {
    concat(pattern, " => {\n",
      "            match ", call_expr, " {\n",
      "                Ok(value) => {\n",
      "                    let json = serde_json::to_string_pretty(&value).unwrap_or_else(|_| format!(\"{:?}\", value));\n",
      "                    println!(\"{}\", json);\n",
      "                }\n",
      "                Err(e) => {\n",
      "                    eprintln!(\"Error: {}\", e);\n",
      "                    std::process::exit(1);\n",
      "                }\n",
      "            }\n",
      "        }")
  } else {
    concat(pattern, " => ", call_expr, ",")
  }
}

fn emit_main_call_args(wf: WorkflowFunc, has_services: Bool) -> String {
  let param_args = wf.params |> map(p =>
    let pname = param_node_name_at(n: p, source_indices: wf.source_indices)
    emit_ident(name: pname, target: Rust)
  )
  let service_args = emit_main_service_arg_list(wf: wf, has_services: has_services)
  let all_args = concat(param_args, service_args)
  all_args |> join(separator: ", ")
}

fn emit_main_service_args(wf: WorkflowFunc, has_services: Bool) -> String {
  let service_args = emit_main_service_arg_list(wf: wf, has_services: has_services)
  service_args |> join(separator: ", ")
}

fn emit_main_service_arg_list(wf: WorkflowFunc, has_services: Bool) -> List<String> {
  let sharing = language_spec(target: Rust).sharing
  let resource_args = wf.uses |> map(u => concat("&", authored_name_at(source_indices: wf.source_indices, node: resource_use_resource(n: u))))
  let svc_args = wf.service_names |> map(sn =>
    let struct_name = sanitize_service_name(name: sn)
    if has_services {
      concat("&", struct_name, "::new(", apply_type_template1(template: sharing.clone_value, arg0: "dry_run"), ")")
    } else {
      concat("&", struct_name, "::new()")
    }
  )
  concat(resource_args, svc_args)
}

fn emit_dry_run_module() -> TextFile {
  let content = concat(
    "// Generated by v1 compiler -- do not edit.\n",
    "//\n",
    "// Dry-run support: when DryRunMode(true), service methods return\n",
    "// mock data instead of performing real I/O.\n\n",
    "#[derive(Debug, Clone)]\n",
    "pub struct DryRunMode(pub bool);\n\n",
    "impl DryRunMode {\n",
    "    pub fn is_dry_run(&self) -> bool {\n",
    "        self.0\n",
    "    }\n",
    "}\n\n",
    "impl Default for DryRunMode {\n",
    "    fn default() -> Self {\n",
    "        DryRunMode(false)\n",
    "    }\n",
    "}\n"
  )
  TextFile { path: concat(rust_source_root(), "dry_run", rust_source_ext()), content: content }
}
