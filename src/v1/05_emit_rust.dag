module v1.compiler.emit_rust






fn render_rust_applied_via_emit_info(n: v1.std.core.Node, shared_types: Set<String>, source_indices: Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  render_rust_applied_type_shared(n: n, generic_param_names: emit_info.fn_generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: emit_info.variant_to_enum, env: emit_info.fn_type_env)
}

fn render_rust_type(n: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: emit_info.fn_generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: emit_info.variant_to_enum, env: emit_info.fn_type_env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  match n.inferred {
    Present { value: v1.std.core.TypeVariable { id: tv } } =>
      if type_var_in_fn_generic_scope(id: tv, generic_param_names: emit_info.fn_generic_param_names) { v1.compiler.emit_core_support.to_pascal(name: tv) } else { "_" }
    _ =>
      match v1.std.core.find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
        Present { value: applied } =>
          if applied.children |> count > 0 {
            render_rust_applied_via_emit_info(n: applied, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
          } else {
            render_rust_type_without_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
          }
        Absent => render_rust_type_without_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
      }
  }
}

fn render_rust_type_without_applied_binding(n: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: emit_info.fn_generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: emit_info.variant_to_enum, env: emit_info.fn_type_env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  if n.connective == v1.std.core.NoConnective && n.children |> count > 0 && !std.types.is_container_type(name: v1.std.core.authored_name_at(source_indices: source_indices, node: n)) {
    render_rust_applied_via_emit_info(n: n, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
  } else if v1.compiler.infer_types.node_is_set_collection(n: n, source_indices: source_indices) {
    match n.children |> first {
      Present { value: elem_child } =>
        let elem_node = v1.compiler.infer_types.child_type_node(ch: elem_child)
        let elem_is_type_var = if elem_node.inferred != none { is_type_variable(inferred: elem_node.inferred.value) } else { false }
        if elem_is_type_var {
          emit_rust_compile_error_expr(message: "Set element type unresolved")
        } else if !rust_btree_set_element_ord_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info) {
          let elem_name = v1.std.core.authored_name_at(source_indices: source_indices, node: elem_node)
          emit_rust_compile_error_expr(message: concat("Set element type ", elem_name, " is not Ord-eligible for BTreeSet"))
        } else {
          v1.compiler.emit.render_node_type(n: n, target: v1.compiler.artifact.Rust, shared_types: shared_types, source_indices: source_indices)
        }
      Absent => emit_rust_compile_error_expr(message: "Set missing element type")
    }
  } else if v1.compiler.infer_types.node_is_keyed_collection(n: n, source_indices: source_indices) {
    match n.children |> first {
      Present { value: key_child } =>
        let key_node = v1.compiler.infer_types.child_type_node(ch: key_child)
        let val_node = match n.children |> skip(1) |> first {
          Present { value: val_child } => v1.compiler.infer_types.child_type_node(ch: val_child)
          Absent => type_variable_node(id: "map_value")
        }
        let key_str = render_rust_type(n: key_node, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
        let val_str = render_rust_type(n: val_node, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
        let tn = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
        let base = v1.compiler.emit.emit_map_type(key_type: key_str, val_type: val_str, target: v1.compiler.artifact.Rust)
        render_rust_shared_type_with_optional(n: n, type_name: tn, rendered: base, shared_types: shared_types)
      Absent => v1.compiler.emit.render_node_type(n: n, target: v1.compiler.artifact.Rust, shared_types: shared_types, source_indices: source_indices)
    }
  } else if v1.compiler.infer_types.node_is_element_collection(n: n, source_indices: source_indices) {
    match n.children |> first {
      Present { value: elem_child } =>
        let elem_node = v1.compiler.infer_types.child_type_node(ch: elem_child)
        let inner_str = render_rust_type(n: elem_node, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
        let tn = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
        let base = v1.compiler.emit.emit_container(name: tn, inner: inner_str, target: v1.compiler.artifact.Rust)
        render_rust_shared_type_with_optional(n: n, type_name: tn, rendered: base, shared_types: shared_types)
      Absent => v1.compiler.emit.render_node_type(n: n, target: v1.compiler.artifact.Rust, shared_types: shared_types, source_indices: source_indices)
    }
  } else {
    let tn = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
    if type_node_has_unbound_type_variable(n: n, generic_param_names: emit_info.fn_generic_param_names, source_indices: source_indices) {
      "_"
    } else if is_host_text_carrier_type(n: n, source_indices: source_indices) {
      rust_carrier_optional_wrap(n: n, rendered: render_rust_text_carrier(shared_types: shared_types))
    } else {
      v1.compiler.emit.render_node_type(n: n, target: v1.compiler.artifact.Rust, shared_types: shared_types, source_indices: source_indices)
    }
  }
}

fn empty_string_bool_map() -> std.types.Map<String, Bool> {
  empty_map()
}

fn rust_type_is_rc_wrapped(type_name: String) -> Bool {
  v1.compiler.languages.sharing_type_is_wrapped_for_target(target: v1.compiler.artifact.Rust, type_name: type_name)
}

fn rust_shared_wrap_ctor(inner_expr: String) -> String {
  v1.compiler.languages.sharing_wrap_ctor_for_target(target: v1.compiler.artifact.Rust, inner_expr: inner_expr)
}

fn rust_shared_wrap_ctor_prefix() -> String {
  v1.compiler.languages.sharing_wrap_ctor_open_for_target(target: v1.compiler.artifact.Rust)
}

fn rust_shared_wrap_ctor_suffix() -> String {
  v1.compiler.languages.sharing_wrap_ctor_close_for_target(target: v1.compiler.artifact.Rust)
}

fn is_host_freemonoid_vec_alias(name: String) -> Bool {
  name == "FreeMonoid"
}

fn is_host_optional_carrier_alias(name: String) -> Bool {
  name == "Optional"
}

fn is_host_diagnostics_carrier_alias(name: String) -> Bool {
  name == "Diagnostics"
}

fn is_grounded_coproduct_native_alias(name: String) -> Bool {
  is_host_freemonoid_vec_alias(name: name)
    || is_host_optional_carrier_alias(name: name)
    || is_host_diagnostics_carrier_alias(name: name)
}

fn is_host_optional_carrier_type(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  v1.std.core.authored_name_at(source_indices: source_indices, node: n) == "Optional" && n.children |> count > 0
}

fn is_host_diagnostics_carrier_type(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  v1.std.core.authored_name_at(source_indices: source_indices, node: n) == "Diagnostics"
}

fn render_rust_diagnostics_carrier_applied(shared_types: std.types.Set<String>) -> String {
  concat("Option<", render_rust_shared_type_if_needed(type_name: "NonEmptyDiagnostics", rendered: "NonEmptyDiagnostics", shared_types: shared_types), ">")
}

fn render_rust_optional_carrier_inner(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  match n.children |> first {
    Present { value: elem } =>
      render_rust_applied_type_arg(n: elem, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
    Absent => "()"
  }
}

fn render_rust_optional_carrier_applied(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  concat("Option<", render_rust_optional_carrier_inner(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env), ">")
}
fn render_rust_text_carrier(shared_types: std.types.Set<String>) -> String {
  render_rust_shared_type_if_needed(type_name: "String", rendered: "String", shared_types: shared_types)
}

fn rust_string_grounded_type_alias_decl_line() -> String {
  concat(rust_visibility_prefix(), rust_items().type_alias_keyword, " String = std::string::String;")
}

fn emit_rust_host_to_dag_string_via_seam(host_expr: String) -> String {
  host_expr
}

fn emit_rust_map_literal_key(field_name: String, key_is_string: Bool) -> String {
  let key_literal = concat("\"", field_name, "\"")
  let host_expr = if key_is_string {
    concat(key_literal, ".to_string()")
  } else {
    key_literal
  }
  emit_rust_host_to_dag_string_via_seam(host_expr: host_expr)
}

fn map_literal_key_is_string(map_type_node: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  match map_type_node.children |> first {
    Present { value: key_child } => is_rust_string_like(n: key_child, source_indices: source_indices)
    Absent =>
      match v1.std.core.find_property(props: map_type_node.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
        Present { value: applied } =>
          match applied.children |> first {
            Present { value: akey } => is_rust_string_like(n: akey, source_indices: source_indices)
            Absent => false
          }
        Absent => false
      }
  }
}

fn emit_rust_dag_string_to_host_via_seam(dag_expr: String) -> String {
  dag_expr
}

fn rust_host_string_seam_fn_emit(name: String) -> String? {
  if name == "host_string_text_from_rust_host" {
    Present { value: concat(
      "pub fn host_string_text_from_rust_host(host: String) -> String {\n",
      "    host.chars().fold(v1_rt::freemonoid_empty::<i64>(), ",
      "|acc, ch| v1_rt::list_snoc_item(acc, v1_rt::code_point(ch.to_string())))\n",
      "}\n"
    ) }
  } else if name == "host_string_text_to_rust_host" {
    Present { value: concat(
      "pub fn host_string_text_to_rust_host(text: String) -> String {\n",
      "    v1_rt::fold_list(text, String::new(), |acc, cp| v1_rt::concat(acc, v1_rt::from_code_point(cp)))\n",
      "}\n"
    ) }
  } else {
    none
  }
}

fn rust_host_string_op_fn_emit(name: String) -> String? {
  if name == "string_is_empty" {
    Present { value: concat(
      "pub fn string_is_empty(s: String) -> bool {\n",
      "    s.is_empty()\n",
      "}\n"
    ) }
  } else if name == "string_head" {
    Present { value: concat(
      "pub fn string_head(s: String) -> Rc<CharResult> {\n",
      "    match s.chars().next() {\n",
      "        Some(c) => Rc::new(CharResult::CharFound { value: Box::new(c as i64) }),\n",
      "        None => Rc::new(CharResult::CharAbsent),\n",
      "    }\n",
      "}\n"
    ) }
  } else if name == "string_tail" {
    Present { value: concat(
      "pub fn string_tail(s: String) -> Rc<ListTailResult<Char>> {\n",
      "    let mut __it = s.chars();\n",
      "    match __it.next() {\n",
      "        Some(_) => Rc::new(ListTailResult::TailFound { tail: Rc::new(__it.map(|c| c as i64).collect::<Vec<i64>>()) }),\n",
      "        None => Rc::new(ListTailResult::TailAbsent),\n",
      "    }\n",
      "}\n"
    ) }
  } else if name == "fold_source" {
    Present { value: concat(
      "pub fn fold_source<R: Clone>(src: String, algebra: Rc<SourceFold<R>>) -> R {\n",
      "    let mut __acc = (algebra.init)(src.clone());\n",
      "    for _ in src.chars() {\n",
      "        __acc = if (algebra.is_done)(__acc.clone()) { __acc } else { (algebra.step)(__acc) };\n",
      "    }\n",
      "    __acc\n",
      "}\n"
    ) }
  } else if name == "trim" {
    Present { value: concat(
      "pub fn trim(s: String) -> String {\n",
      "    v1_rt::trim(s)\n",
      "}\n"
    ) }
  } else {
    none
  }
}

fn rust_opaque_kernel_alias_type_eligible(name: String) -> Bool {
  name == "Json" || name == "Bytes" || name == "Symbol"
}

fn rust_opaque_kernel_alias_carrier(name: String) -> String? {
  if rust_opaque_kernel_alias_type_eligible(name: name) {
    Present { value: v1.compiler.coercion.coerce_primitive_type(target: v1.compiler.artifact.Rust, dag_name: name, decl_file: "") }
  } else {
    none
  }
}

fn rust_opaque_kernel_alias_type_decl(name: String) -> String {
  let carrier = v1.compiler.coercion.coerce_primitive_type(target: v1.compiler.artifact.Rust, dag_name: name, decl_file: "")
  concat(rust_visibility_prefix(), rust_items().type_alias_keyword, " ", name, " = ", carrier, ";")
}

fn rust_ground_opaque_kernel_type_name(name: String) -> String {
  match rust_opaque_kernel_alias_carrier(name: name) {
    Present { value: carrier } => carrier
    Absent => name
  }
}

data reference_use_lines_representation_invariant_note: String = "Use-lines are derived from RESOLVED REFERENCES for every module, import-bearing or not. Import synthesis was formerly gated on the same closure-provenance flag as primitive realization, with import-bearing modules on one arm receiving an EMPTY list -- which made what a module imports a function of WHICH OTHER SOURCES SHARED ITS CLOSURE rather than of what it actually references. Both halves of that fused flag are deleted: what a module must import is a derivation from its own resolved reference graph, exactly as what a type realizes as is a fact about its own declaration. Once the gate was removed the two former arms called reference_derived_use_lines with byte-identical arguments, so the conditional collapsed to one call -- the branch existed only to serve the distinction being deleted."

data numeric_realization_relocation_note: String = "RELOCATED to v1.compiler.coercion (smart-ram-730, adhoc-2ea6fb98-a3f, 2026-08-21, review 54335): numeric_realization_identity_note, numeric_realization_roster_extension_note, numeric_realization_declaring_modules, decl_file_realizes_natively and rust_seed_host_numeric_alias moved there in full, completing the relocation checkpoint_table_bypasses_identity_note's structural_declaration_modules_for precedent already established for the negative-form (structural) half of this same two-authority shape -- this was the positive-form (native) half, still sitting in this module and reached back into by v1.compiler.coercion type_realization_decision, an import cycle DESIGN section 3 forbids (emit_rust already imports FROM coercion; coercion calling back into emit_rust closes the cycle). This module now imports only rust_seed_host_numeric_alias back from v1.compiler.coercion, exactly as it already imports lookup_checkpoint from there -- one direction, no cycle; numeric_realization_declaring_modules and decl_file_realizes_natively have no consumer left in this module, since rust_seed_host_numeric_alias was their only caller here and it moved with them. Agreed with swift-moth-294 (msg_502982ac, 2026-08-21) and sequenced behind gunbc#8716 (merged 2026-08-21T06:19:19Z), which is why the move landed now rather than when first proposed."

data checkpoint_table_bypasses_identity_note: String = "CEILING, STATED BECAUSE THE CODE DELIVERS LESS THAN THE DELETION OF RustCorpusRepr SUGGESTS. lookup_checkpoint is keyed on the BARE dag_name and is consulted BEFORE the identity-keyed arm, so any name carrying a checkpoint row in extdeps/languages/rust/types.dag bypasses declaration keying entirely. Nat carries no row and therefore discriminates correctly -- dag/std/nat.dag realizes natively, src/v2/std/nat.dag refuses. Names WITH a row do not. This is not a regression introduced here: the table was already bare-name keyed and the global corpus mode was hiding the question. It is the honest rung. The class is MECHANICALLY PREVENTABLE rather than structurally impossible, and its executing evidence is v1.tests.claim.checkpoint_identity_keying_witness_test, which asserts the CURRENT bypassing answers on purpose so the gap is counted instead of assumed closed. THAT CITATION WAS FALSE WHEN THIS NOTE FIRST LANDED AND IS REPAIRED RATHER THAN SOFTENED. It named the residue block generated by v1.compiler.compiler_tests_rust ct_groupcompletion_checkpoint_fires_under_faithful_corpus_test, which emits into a module declared `#[cfg(test)] mod compiler_tests;` inside the v1-compiler crate -- while the only test step CI runs is `cargo test -p v1-compiler-tests`, a SEPARATE package consuming v1-compiler as an ordinary dependency, so cfg(test) is never set for it and the block is not compiled, let alone executed. Measured rather than reasoned: that step's binary enumerates 30 tests and none is this one, against a positive control confirming the enumeration is non-empty. So a ceiling disclosure cited evidence that had never run -- DESIGN section 4b(1) rung honesty violated in the compiler's own self-description, which is worse than sitting low because an inflated class never ranks for climbing. The assertions were re-authored as an enrolled .dag witness and now execute (seven rows PASS, including the discriminating row where two declarations share the spelling Nat and answer differently); the superseded generated-Rust block is deleted rather than left standing as a second, silent copy. POPULATION (census by vivid-wren-870, who owns the rows): SEVEN of the table's names are also declared under src/v2 -- Int, Float, Bool, Symbol, Unit, String, Hash; Bytes, Secret and Json are not. That is a LOWER BOUND obtained by grepping line-start `type <name>` declarations under src/v2; it does not find names introduced any other way, and it says NOTHING about how many sites bite in any real closure. Three of the seven are the same shape as Int in that the v2 declaration is a genuinely different STRUCTURE rather than a spelling coincidence -- Int is GroupCompletion<Nat>, String is FreeMonoid<Char>, Bool is a two-variant coproduct. Symbol and Unit are bodyless and may be declared-abstract rather than competing realizations, so their bypass may be harmless. Hash is the one that costs a GUARANTEE rather than merely a representation, and it belongs with the same-shape three rather than apart from them: the row targets v1_rt::Hash, which is `pub type Hash = String` in the seed, against a v2 declaration of Fnv1a64Structural -- a single-field record whose digest field is `String where lower_hex_16`. std.content_hash content_hash_family_constructor_note states the public forgeable record constructors are DELETED and that the where-refinement IS the construction wall, so realizing that type as a bare String alias renders away the carrier the wall is attached to. A name-keyed spelling row can therefore silently drop a §4b construction rung. Established from declarations at both ends (vivid-wren-870, re-read here); NO live site is claimed, because no closure reaching a v2-declared Hash through lookup_checkpoint has been emitted by either of us. NEXT-RUNG TRIGGER -- AND THE OBVIOUS SHAPE IS THE WRONG ONE. An earlier revision of this note named `the checkpoint rows gain a declaring-module column`. vivid-wren-870 refused that shape with an argument this note adopts: a TypeCheckpoint row is cited to the Rust reference and states how RUST spells a type, whereas which dag module declares Int is a gunbc-corpus fact, so a declaring-module column puts corpus data inside an extdeps upstream authority -- a layer inversion, and the same class as a row being asked a question its cited authority cannot answer. The expected terminal shape is TWO authorities rather than one wider one: extdeps keeps Rust type -> spelling, a corpus-side binding says this dag declaration realizes as that Rust type, and lookup_checkpoint keys on the second. That also lets the seven differ from each other, which one column keyed on a single module cannot express. Recorded as a proposal from the rows owner, not as a decision, and unbuilt at the time of writing. When it lands the residue assertions flip to None and the flip is the dissolution signal, not a regression. LANDED FOR HASH (this PR, T7): the second authority is v1.compiler.coercion structural_declaration_modules_for, a corpus-side row roster keyed on the dag_name and enumerating the modules whose declaration of that name is structural rather than native -- \"Hash\" => [\"src/v2/std/node.dag\"] is its one row. lookup_checkpoint (v1.compiler.coercion) now consults it before the bare-name table: when decl_file_declares_structurally holds, lookup_checkpoint refuses (none) rather than answering from the table, and every consumer that already carried a correct identity-arm fallback -- coerce_primitive_type, is_copy, literal_suffix, and the direct callers of lookup_checkpoint itself -- inherits the refusal once decl_file is threaded to the call, which it now is at every production call site across v1.compiler.emit_rust and v1.compiler.emit. table_present_hash_refuses_under_structural_declaration in the witness below is the flip this note predicted; it is no longer residue. LANDED FOR STRING (session merry-lark-67, per smart-ram-730's dispatch): structural_declaration_modules_for gained a second row, \"String\" => [\"src/v2/std/text.dag\", \"dag/std/string_type.dag\"] -- both declare `type String = FreeMonoid<Char>`, the structural free-monoid-over-Char carrier, never a host string, so a reference resolving to either module now refuses the bare-name table's `String`/`.to_string()` spelling instead of silently rendering it. residue_table_present_string_bypasses_identity in the legacy oracle (src/v1/tests/claim/checkpoint_identity_keying_witness_test.dag) is retired for the same reason table_present_hash_refuses_under_structural_declaration closed for Hash, and is replaced there by table_present_string_refuses_under_structural_declaration_text / _string_type rather than repaired back to a passing bypass -- the flip is the dissolution signal, not a regression. LANDED FOR BOOL (session merry-lark-67, corpus-wide histogram from smart-ram-730; corrected same session, commit 127ad848070, per review 54257): structural_declaration_modules_for gained a third row, \"Bool\" => [\"src/v2/std/logic.dag\"] -- the initial enrollment mirrored String's two-row shape onto Bool and also listed dag/std/types.dag, but that module is the ordinary corpus-wide native Bool prelude (imported by 300+ dag/test/claim modules with no bit/width/encoding modeling riding on it), directly analogous to dag/std/integer.dag for Int, which sits in the POSITIVE numeric_realization_declaring_modules roster, never the negative structural one. Only src/v2/std/logic.dag's Bool is genuinely structural, carrying BoolWidthFact/BoolEncodingFact/BooleanAlgebra<Bool> modeling over the two-variant coproduct; a reference resolving to it refuses the bare-name table's `bool`/`false` spelling instead of silently rendering it, while a reference resolving to dag/std/types.dag renders natively as designed. The over-broad row caused required-floor to refuse native bool rendering for 5 unrelated fixtures (e0308_mechanical_trio_test, optional_carrier_signature_test) and caused required-regen to see drift across the self-hosted std_*.rs mirrors; both are the fabricated-plausible-ceiling failure this note elsewhere criticizes, disclosed and repaired here rather than left standing. Bool never had a residue row in the legacy oracle to flip; it lands directly as one CLOSED row, table_present_bool_refuses_under_structural_declaration_logic, alongside table_present_bool_renders_natively_for_the_corpus_prelude confirming dag/std/types.dag's native rendering. KNOWN GAP THIS ROW DOES NOT CLOSE, FOUND WHILE MEASURING IT: emit_typed_item's type-alias arm special-cases `item_text == \"String\"` UNCONDITIONALLY -- rust_string_grounded_type_alias_decl_line emits `pub type String = std::string::String;` at the DECLARATION site regardless of decl_file, never consulting rust_scalar_checkpoint_render_base or this roster at all. So the module that declares `type String = FreeMonoid<Char>` keeps emitting itself as a host-String alias even after this row makes every REFERENCE to it refuse the bare-name table; the declaration and its own references can now disagree in the SAME emitted file. This is not fixed here -- it is a separate emit_rust mechanism, unconditional on decl_file, that this row's PR does not touch -- and is recorded as the next-rung trigger for String's declaration-site emission specifically, distinct from the reference-site gate this note otherwise describes. REACHABILITY CORRECTION (royal-dove-436, adhoc-c735d227-60b, 2026-08-21, measured on the 03_ingest closure): TWO CLAIMS ABOVE ARE FALSE FOR STRING AND ARE CORRECTED HERE RATHER THAN SOFTENED -- the LANDED FOR STRING clause's 'a reference resolving to either module now refuses the bare-name table's String/.to_string() spelling instead of silently rendering it', and the KNOWN GAP clause's 'even after this row makes every REFERENCE to it refuse the bare-name table'. The row does not make every reference refuse, because a String-spelled reference in TYPE position never reaches lookup_checkpoint at all. SIX type renderers in this module -- render_rust_type, render_rust_type_without_applied_binding, render_rust_applied_type, render_rust_type_with_applied_binding, render_rust_decl_type and render_rust_fn_sig_type -- each RETURN ON THEIR FIRST LINE (verified: the call is the statement immediately following each fn's own declaration) via is_host_text_carrier_type, rendering the literal \"String\" unconditionally on decl_file, ahead of every checkpoint or roster consultation; and is_host_text_carrier_type accepts the spelling String outright, so no path through those six can reach type_realization_decision's Unrealized-via-structural-gate arm for it. THE ROW IS THEREFORE PRESENT, CORRECT, AND UNREACHABLE FOR THE TEXT CARRIER IN TYPE POSITION -- an unreachable wall rather than a missing one, which is DESIGN section 6's coverage-by-illusion and a section 4b rung this note previously reported as held. This is a REACHABILITY claim about String's reference-site gate; it does NOT touch the Hash clause above, whose 'NO live site is claimed' is scoped to a v2-declared Hash reaching lookup_checkpoint and is unaffected, and it is a DIFFERENT mechanism from the declaration-site alias line the KNOWN GAP clause otherwise describes. SUPPORTING EVIDENCE, cited as a population rather than as the basis of the claim: 34 live E0308 sites in the 03_ingest closure pair a String-declared field or parameter against a FreeMonoid-realized value, every one of them a type position that rendered the native spelling while the roster says the declaration is structural (docs/probes/t2_t3_realization_route_2026-08-21.md, per-site TSV beside it). ESTABLISHED HOW, because the distinction decides what would falsify this: the reachability claim is decidable from the five renderers' control flow, which is how it was established -- NOT by a discriminating execution, and it says nothing about a sixth renderer that may handle some type position without that preamble. NEXT-RUNG TRIGGER: the short-circuit family is deleted so the existing authority becomes reachable, per docs/plans/carrier-realization-arbiter-repair-design.md, which also counts the decl_file == \"\" residue this module contributes (four sites) that the DECLARED RESIDUE note in v1.compiler.coercion says is uncounted. That design leaves the structural-vs-native direction to its owner and proposes an emit-only blast-radius measurement, not a merge, as the next step -- deliberately, because the over-broad Bool row recorded above is what picking a direction without that measurement already cost once. Int, Float, Symbol remain open -- they have no row in structural_declaration_modules_for -- and are the population the next instance of this class (a name question answered by authored spelling instead of declaration identity) inherits, per the class-level framing this ceiling was folded into. The roster is deliberately a single generic, identity-keyed mechanism with one row rather than a Hash-specific special case, so a future row for Int or String is an addition to this same authority, not a new mechanism. MEASURED CONSEQUENCE AT ARTIFACT GRAIN, added after this note first landed: the bypass is observable in the emitted FILE SET, not only in the emitter's answer. In a two-arm emission of one v2-only closure the file v2_std_integer.rs is present before the cut and ABSENT after it. That module declares exactly one item, the v2-declared structural Int, and its only type-position consumer was a single generated re-export line in std_algebra.rs; with Int reaching the bare-name checkpoint the re-export is no longer generated, nothing references the module, and it is not emitted. Every other hunk in that file is an offset shift from the deleted line -- the Int string literals are unchanged and the i64 count in the file is identical across arms, so nothing became native that was structural. AND THE DROP IS THE MINORITY CASE -- THE WRONG REALIZATION IS EMITTED, NOT AVOIDED. Across eleven emitted closures measured by smart-ibex-716 (corpus a6bceb6903, binaries a6bceb6903 and ad05a2f2d5), the module disappears in only 2; in the other 9 it SURVIVES with its content changed, from pub type Int = GroupCompletion<Rc<Nat>> to pub type Int = i64. So the native realization of the v2-declared Peano-completion type is already present in the emitted artifact. What is absent is only a consumer: the same census found ZERO type-position uses of the v2 Int in any of the eleven -- every qualified occurrence sits on a use line, and the only bare occurrences surviving a use-line exclusion were four string literals inside prose, one of them a parser test fixture. Two false positives were found and discarded on the way to that zero, both by pulling the specimen rather than trusting the count. The residue is therefore NOT a dead re-export being dropped, which was this note's first reading and is corrected here; it is a wrong realization sitting inert with no diagnostic attached, so the day any declaration binds a bare Int in one of those closures it binds i64 silently. THE HAZARD TRIGGER IS THEREFORE A TYPE POSITION APPEARING, not the re-export returning. This is recorded because a module leaving OR silently changing an alias target is the kind of consequence a content-only diff of one closure reads as offset noise: the instruments that name it are a file-set diff and a cross-closure alias-target read, and neither was in this PR's original receipt."

fn rust_scalar_checkpoint_render_base(dag_name: String, decl_file: String) -> String? {
  match v1.compiler.coercion.lookup_checkpoint(target: v1.compiler.artifact.Rust, dag_name: dag_name, decl_file: decl_file) {
    Present { value: cp } => Present { value: cp.target_type }
    Absent =>
      match rust_seed_host_numeric_alias(name: dag_name, decl_file: decl_file) {
        Present { value: host } => Present { value: host }
        Absent => none
      }
  }
}

data rust_checkpoint_scalar_declared_arity_guard_note: String = "The strip below reads table MEMBERSHIP as the proposition 'this leaf has arity 0 in Rust'. A TypeCheckpoint row cannot state arity — it states target spelling — so the two facts 'this is a scalar' and 'I have a spelling for this name' arrive as one Present, and the arm answers 'drop every type argument' to both. That is DESIGN section 5's widening failure arm: the dropped argument leaves plausible output rather than a diagnostic, so the deficit's frequency was zero by construction until rustc reported E0107. The guard consults the single arity authority (std.types is_container_type / container_expected_arity) FIRST, so a leaf with declared arity can never be classified scalar however the target's spelling table is edited. Receipt: docs/probes/root_d_generic_arity_2026-08-16.md."

data rust_checkpoint_scalar_phantom_params_note: String = "Construction wall for E0109 (type arguments are not allowed on builtin type i64). A checkpoint scalar (lookup_checkpoint / rust_seed_host_numeric_alias — Int, Nat, i64, etc.) has arity 0 in Rust; DAG phantom params from GroupCompletion<Nat> or Compose<Int, MachineWidth<>> must not surface as i64<T>. Root fix: refuse phantom arg emission at the type-node renderer when the leaf is a checkpoint scalar and children > 0 — not a post-hoc string strip on the rendered output (DESIGN section 5: widening instead of refusing)."

// A NUMERIC machine scalar is never raised to a reference layer -- see
// rust_carrier_realizes_as_machine_scalar. This is the applied-TYPE-ARGUMENT half of the same
// decision: the arm below has already resolved the carrier to a scalar spelling, and the
// shared-wrap rule then re-decides it from the leaf NAME's shared_types membership, producing
// `Rc<i64>` in argument position (`Measure<Q, S, Rc<i64>>`) while the parameter position of the
// same declaration renders bare. That asymmetry is worse than either uniform answer: it yields
// `Rc<i64> * i64`, an operator refusal that neither position produces alone.
//
// Scope is the same as the parameter-side guard and deliberately no wider: only the numeric
// authority suppresses the wrap. rust_scalar_checkpoint_render_base also answers for
// lookup_checkpoint rows that are NOT machine scalars (String is the live one), and those may
// legitimately be shared, so widening this to every checkpoint row is a separate cut.
fn rust_render_checkpoint_scalar_bare(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, shared_types: std.types.Set<String>) -> String? {
  if n.children |> count == 0 { none }
  else {
    let leaf = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
    if std.types.is_container_type(name: leaf) { return none }
    match rust_seed_host_numeric_alias(name: leaf, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) {
      Present { value: numeric } => Present { value: numeric }
      Absent =>
        match rust_scalar_checkpoint_render_base(dag_name: leaf, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) {
          Present { value: scalar } =>
            if set_contains(shared_types, leaf) && !rust_type_is_rc_wrapped(type_name: scalar) {
              Present { value: v1.compiler.languages.wrap_shared_type(target: v1.compiler.artifact.Rust, inner: scalar) }
            } else {
              Present { value: scalar }
            }
          Absent => none
        }
    }
  }
}

fn rust_seed_host_container_base(name: String) -> String? {
  if name == "List" || name == "FreeMonoid" {
    Present { value: "Vec" }
  } else {
    none
  }
}

fn rust_host_text_carrier_elem_name(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  match n.children |> first {
    Present { value: ch } => v1.std.core.authored_name_at(source_indices: source_indices, node: ch)
    Absent =>
      match v1.std.core.find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
        Present { value: applied } =>
          match applied.children |> first {
            Present { value: ach } => v1.std.core.authored_name_at(source_indices: source_indices, node: ach)
            Absent => ""
          }
        Absent => ""
      }
  }
}

fn is_host_text_carrier_type(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let nm = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  if nm == "String" {
    true
  } else if nm == "FreeMonoid" || nm == "List" {
    rust_host_text_carrier_elem_name(n: n, source_indices: source_indices) == "Char"
  } else {
    false
  }
}

fn rust_seed_host_freemonoid_empty(carrier_name: String) -> String? {
  match rust_seed_host_container_base(name: carrier_name) {
    Present { value: _ } => Present { value: rust_shared_wrap_ctor(inner_expr: "vec![]") }
    Absent => none
  }
}

fn rust_named_type_base(name: String, decl_file: String) -> String {
  if name == "Witness" || name == "witness" {
    "Witness"
  } else {
    v1.compiler.coercion.coerce_primitive_type(target: v1.compiler.artifact.Rust, dag_name: name, decl_file: decl_file)
  }
}

fn rust_applied_type_base(name: String, decl_file: String) -> String {
  rust_named_type_base(name: name, decl_file: decl_file)
}

fn rust_witness_parent_leaf(parent: String) -> Bool {
  v1.std.core.qualified_last_segment(name: parent) == "Witness"
}

data rust_witness_variant_arm_names_note: String = "Holds/Violates literals below are the two arms of v2.std.witness.Witness<C> (src/v2/std/witness.dag; this citation read std.witness / dag/std/witness.dag until 2026-08-16, naming a module that does not exist in the tree) — not minted nicknames. Pattern position routes via rust_variant_path like any other modeled enum; construction turbofish here keys type-arg resolution off the modeled arm names only."

fn rust_peel_one_rc_type_node(type_node: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node {
  let seg = v1.std.core.qualified_last_segment(name: type_node.name)
  if seg != "Rc" && seg != "Arc" {
    type_node
  } else {
    match type_node.children |> first {
      Present { value: inner } => inner
      Absent =>
        match v1.std.core.find_property(props: type_node.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
          Present { value: applied } =>
            match applied.children |> first {
              Present { value: inner } => inner
              Absent => type_node
            }
          Absent => type_node
        }
    }
  }
}

fn rust_peel_all_rc_type_node(type_node: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node {
  let seg = v1.std.core.qualified_last_segment(name: type_node.name)
  if seg == "Rc" || seg == "Arc" {
    rust_peel_all_rc_type_node(type_node: rust_peel_one_rc_type_node(type_node: type_node, source_indices: source_indices), source_indices: source_indices)
  } else {
    type_node
  }
}

fn rust_witness_type_arg_admit_rendered(rendered: String, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String? {
  if rendered == "_" || rendered == "" { none }
  else if string_length(s: rendered) == 1 && rust_is_uppercase_letter(c: rendered) && !type_var_in_fn_generic_scope(id: rendered, generic_param_names: emit_info.fn_generic_param_names) { none }
  else if rust_fold_rendered_type_has_any_spurious_generic(type_str: rendered, generic_param_names: emit_info.fn_generic_param_names) { none }
  else { Present { value: rendered } }
}

fn rust_witness_applied_type_arg_node(type_node: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node? {
  match type_node.children |> first {
    Present { value: child } => Present { value: child }
    Absent =>
      match v1.std.core.find_property(props: type_node.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
        Present { value: applied } =>
          match applied.children |> first {
            Present { value: child } => Present { value: child }
            Absent => none
          }
        Absent => none
      }
  }
}

fn rust_witness_carrier_from_type_node(type_node: v1.std.core.Node, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  if type_node_has_unbound_type_variable(n: type_node, generic_param_names: emit_info.fn_generic_param_names, source_indices: source_indices) { return none }
  let peeled = rust_peel_all_rc_type_node(type_node: type_node, source_indices: source_indices)
  if v1.std.core.qualified_last_segment(name: peeled.name) == "Witness" {
    match rust_witness_applied_type_arg_node(type_node: peeled, source_indices: source_indices) {
      Present { value: arg_node } =>
        rust_witness_type_arg_admit_rendered(
          rendered: render_rust_type(n: arg_node, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info),
          emit_info: emit_info
        )
      Absent => none
    }
  } else {
    rust_witness_type_arg_admit_rendered(
      rendered: render_rust_type(n: peeled, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info),
      emit_info: emit_info
    )
  }
}

fn rust_witness_type_arg_render(type_node: v1.std.core.Node, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  rust_witness_carrier_from_type_node(type_node: type_node, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
}

fn rust_witness_type_arg_from_holds_value_field(fields: std.types.List<v1.std.core.Node>, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  match fields |> filter(f => v1.std.core.field_init_node_name_at(n: f, source_indices: source_indices) == "value") |> first {
    Present { value: f } =>
      let val_rt = resolved_type(n: v1.std.core.field_init_node_value(n: f))
      match rust_witness_carrier_from_type_node(type_node: val_rt, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices) {
        Present { value: arg } => Present { value: arg }
        Absent => rust_witness_type_arg_from_fn_return(emit_info: emit_info, shared_types: shared_types, source_indices: source_indices)
      }
    Absent => none
  }
}

fn rust_witness_type_arg_from_fn_return(emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  match emit_info.fn_return_type {
    Present { value: rt } => rust_witness_carrier_from_type_node(type_node: rt, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
    Absent => none
  }
}

fn rust_witness_type_arg_for_variant(variant_name: String, resolved_type: v1.std.core.Node, fields: std.types.List<v1.std.core.Node>, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  if variant_name == "Holds" {
    match rust_witness_type_arg_from_holds_value_field(fields: fields, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices) {
      Present { value: arg } => Present { value: arg }
      Absent => rust_witness_type_arg_from_fn_return(emit_info: emit_info, shared_types: shared_types, source_indices: source_indices)
    }
  } else if variant_name == "Violates" {
    match rust_witness_type_arg_from_fn_return(emit_info: emit_info, shared_types: shared_types, source_indices: source_indices) {
      Present { value: arg } => Present { value: arg }
      Absent => rust_witness_carrier_from_type_node(type_node: resolved_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
    }
  } else {
    rust_witness_carrier_from_type_node(type_node: resolved_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
  }
}

fn rust_witness_variant_ctor_path(variant_name: String, ctor_name: String, effective_parent: String?, resolved_type: v1.std.core.Node, fields: std.types.List<v1.std.core.Node>, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  match effective_parent {
    Present { value: parent } =>
      if !rust_witness_parent_leaf(parent: parent) {
        rust_variant_path(parent: parent, rust_name: variant_name)
      } else {
        match rust_witness_type_arg_for_variant(variant_name: variant_name, resolved_type: resolved_type, fields: fields, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices) {
          Present { value: arg } => concat("Witness::<", arg, ">::", variant_name)
          Absent => concat("compile_error!(\"witness carrier type arg unresolved for variant ", variant_name, "\")")
        }
      }
    Absent => ctor_name
  }
}

fn is_parametric_opaque_type_by_name(env: v1.compiler.infer_env.TypeEnv, type_name: String) -> Bool {
  match v1.compiler.infer_env.lookup_type_by_name(env: env, name: type_name) {
    Present { value: item } => is_parametric_opaque_type_decl_item(item: item, source_indices: env.source_indices)
    Absent => false
  }
}

fn is_parametric_opaque_type_base(type_name: String, def_mod_filename: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match type_item_by_name_in_module_filename(rhs_name: type_name, mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: item } => is_parametric_opaque_type_decl_item(item: item, source_indices: source_indices)
    Absent => false
  }
}

type ClosedAliasPeelVerdict
  = ClosedAliasBindingAbsent
  | ClosedAliasHasParams
  | ClosedAliasPeelZeroParam

fn closed_alias_verdict_do_not_peel() -> ClosedAliasPeelVerdict {
  ClosedAliasHasParams
}

fn closed_alias_peel_verdict(env: v1.compiler.infer_env.TypeEnv, n: v1.std.core.Node) -> ClosedAliasPeelVerdict {
  let name = v1.std.core.authored_name_at(source_indices: env.source_indices, node: n)
  if name == "String" {
    return closed_alias_verdict_do_not_peel()
  }
  let binding = match v1.compiler.infer_env.lookup_type_for(env: env, node: n) {
    Present { value: b } => b
    Absent =>
      match v1.compiler.infer_env.lookup_type_by_name(env: env, name: name) {
        Present { value: b } => b
        Absent => return ClosedAliasBindingAbsent
      }
  }
  if (binding.params |> count) == 0 { ClosedAliasPeelZeroParam } else { closed_alias_verdict_do_not_peel() }
}

type AliasDeclArityVerdict
  = AliasDeclArityAbsent
  | AliasDeclArityZeroParam
  | AliasDeclArityHasParams

fn closed_alias_peels_zero_param(env: v1.compiler.infer_env.TypeEnv, n: v1.std.core.Node) -> Bool {
  match closed_alias_peel_verdict(env: env, n: n) {
    ClosedAliasPeelZeroParam => true
    ClosedAliasHasParams => false
    ClosedAliasBindingAbsent => false
  }
}

fn alias_decl_arity_verdict(type_name: String, def_mod_filename: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex, env: v1.compiler.infer_env.TypeEnv) -> AliasDeclArityVerdict {
  match type_item_by_name_in_module_filename(rhs_name: type_name, mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: item } => if (item.params |> count) == 0 { AliasDeclArityZeroParam } else { AliasDeclArityHasParams }
    Absent =>
      match v1.compiler.infer_env.lookup_type_by_name(env: env, name: type_name) {
        Present { value: binding } => if (binding.params |> count) == 0 { AliasDeclArityZeroParam } else { AliasDeclArityHasParams }
        Absent => AliasDeclArityAbsent
      }
  }
}

fn alias_decl_arity_refusal_expr(type_name: String) -> String {
  emit_rust_compile_error_expr(message: concat("alias decl arity absent for ", type_name))
}

fn type_param_is_collection_element_in_values(param_name: String, value_params: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  value_params |> any(vp =>
    let te = v1.std.core.param_node_type_expr(n: vp)
    std.types.is_container_type(name: v1.std.core.authored_name_at(source_indices: source_indices, node: te))
      && (te.children |> any(c => v1.std.core.authored_name_at(source_indices: source_indices, node: c) == param_name))
  )
}

// The owner string carries a THIRD state that its type does not name: v1.compiler.emit_info
// derive_variant_to_enum inserts "" when two enums in the closure claim one variant name, so ""
// means AMBIGUOUS rather than owned. map_contains_key cannot see that value, so it read an
// ambiguous name as an unambiguous value-variant and collapsed the type argument to unit --
// fabricating plausible output where the emitter could not know the answer. The six other readers
// of this map already guard the sentinel explicitly; this one did not -- which makes the class a
// single-authority failure rather than a bug: a sentinel whose meaning must be re-implemented
// correctly by every reader is a convention, not a construction, and it produces this defect one
// reader at a time. Next rung, and the trigger this repair does NOT reach: ambiguity becomes a
// typed arm rather than a bare "" (Unowned | OwnedBy | Ambiguous), so a reader that ignores it
// does not compile.
//
// AND THE DEEPER DEFECT, measured while trying to witness this and recorded because it outlives the
// repair: the sentinel is asking a question the language does not define globally. §1c
// (v1.compiler.infer constructor_binding_authority) rules that a module's constructor namespace is
// FLAT -- its own declarations plus its DIRECT imports, never transitive ancestry -- and a name
// bound to two owners IN ONE FILE is a VariantCollision refused at env construction. So ownership
// is a PER-FILE fact. derive_variant_to_enum folds the whole TRANSITIVE closure, where no such
// owner exists. The two populations disagree by construction, and that is exactly what is observed:
// emitting src/v2/compiler/05_emit.dag reports NO collision and 92 clean files, while the same run
// records Optional as ambiguously owned 68 times and Absent 91 times. A fixture that imports both
// claimants DIRECTLY does refuse, which is the wall working correctly on the population it owns.
// Honoring the sentinel is therefore right but is not the terminal fix: a per-file relation was
// flattened into a global map, and the ambiguity is that flattening's artifact rather than a defect
// in any declaration.
fn is_value_variant_type_arg(generic_param_names: std.types.List<String>, variant_to_enum: std.types.Map<String, String>, name: String) -> Bool {
  if generic_param_names |> any(g => g == name) {
    false
  } else {
    match map_get(variant_to_enum, name) {
      Present { value: owner } => owner != ""
      Absent => false
    }
  }
}

fn type_leaf_name_for_collapse(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  let a = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  if a == "" { n.name } else { a }
}

fn is_machine_width_phantom_token(name: String) -> Bool {
  name == "Word8" || name == "Word16" || name == "Word32" || name == "Word64" || name == "Word128"
}

fn rust_type_arg_renders_as_unit(n: v1.std.core.Node, generic_param_names: std.types.List<String>, variant_to_enum: std.types.Map<String, String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  v1.compiler.infer_resolve.is_width_nat_type_literal(n: n) || is_machine_width_phantom_token(name: type_leaf_name_for_collapse(n: n, source_indices: source_indices)) || is_value_variant_type_arg(generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, name: type_leaf_name_for_collapse(n: n, source_indices: source_indices))
}

fn type_node_has_value_variant_arg(n: v1.std.core.Node, generic_param_names: std.types.List<String>, variant_to_enum: std.types.Map<String, String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if is_value_variant_type_arg(generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, name: type_leaf_name_for_collapse(n: n, source_indices: source_indices)) {
    true
  } else if n.children |> any(c => type_node_has_value_variant_arg(n: c, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices)) {
    true
  } else {
    match v1.std.core.find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
      Present { value: applied } => applied.children |> any(c => type_node_has_value_variant_arg(n: c, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices))
      Absent => false
    }
  }
}

fn render_rust_phantom_opaque_applied_type_arg(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, scope: v1.compiler.infer.InferScope, imports: std.types.List<v1.std.core.Node>, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, module_name: String, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, module_index: ModuleIndex, variant_to_enum: std.types.Map<String, String>) -> String {
  if rust_type_arg_renders_as_unit(n: n, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
    "()"
  } else {
    render_rust_alias_rhs_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
  }
}

fn render_rust_phantom_opaque_applied_decl_arg(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  if rust_type_arg_renders_as_unit(n: n, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
    "()"
  } else {
    render_rust_decl_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
}

fn render_rust_applied_type_arg(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  if rust_type_arg_renders_as_unit(n: n, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
    "()"
  } else if type_node_has_unbound_type_variable(n: n, generic_param_names: generic_param_names, source_indices: source_indices) {
    "_"
  } else {
    match n.inferred {
      Present { value: v1.std.core.TypeVariable { id: tv } } =>
        if type_var_in_fn_generic_scope(id: tv, generic_param_names: generic_param_names) { v1.compiler.emit_core_support.to_pascal(name: tv) } else { "_" }
      _ =>
        match rust_render_checkpoint_scalar_bare(n: n, source_indices: source_indices, shared_types: shared_types) {
          Present { value: scalar } => scalar
          Absent => render_rust_decl_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
        }
    }
  }
}

fn render_rust_applied_type(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  let base_name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
  if n.children |> count == 0 {

    match rust_seed_host_container_base(name: base_name) {
      Present { value: host } => host
      Absent => rust_named_type_base(name: base_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n))
    }
  } else {

    match rust_scalar_checkpoint_render_base(dag_name: base_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) {
      Present { value: scalar } => scalar
      Absent =>
    match closed_alias_peel_verdict(env: env, n: n) {
      ClosedAliasPeelZeroParam => {
      let bare = match rust_seed_host_container_base(name: base_name) {
        Present { value: host } => host
        Absent => rust_applied_type_base(name: base_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n))
      }
      render_rust_shared_type_if_needed(type_name: base_name, rendered: bare, shared_types: shared_types)
      }
      ClosedAliasHasParams => {
    let base = match rust_seed_host_container_base(name: base_name) {
      Present { value: host } => host
      Absent => rust_applied_type_base(name: base_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n))
    }
    let peel = is_parametric_opaque_type_by_name(env: env, type_name: base_name)
    let args = n.children |> map(arg =>
      if peel {
        render_rust_phantom_opaque_applied_decl_arg(n: arg, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      } else {
        render_rust_applied_type_arg(n: arg, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      }
    ) |> join(separator: ", ")
    concat(base, "<", args, ">")
      }
      ClosedAliasBindingAbsent => {
    let base = match rust_seed_host_container_base(name: base_name) {
      Present { value: host } => host
      Absent => rust_applied_type_base(name: base_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n))
    }
    let peel = is_parametric_opaque_type_by_name(env: env, type_name: base_name)
    let args = n.children |> map(arg =>
      if peel {
        render_rust_phantom_opaque_applied_decl_arg(n: arg, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      } else {
        render_rust_applied_type_arg(n: arg, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      }
    ) |> join(separator: ", ")
    concat(base, "<", args, ">")
      }
    }
    }
  }
}

fn render_rust_shared_type_if_needed(type_name: String, rendered: String, shared_types: std.types.Set<String>) -> String {
  if set_contains(shared_types, type_name) && !rust_type_is_rc_wrapped(type_name: rendered) {
    v1.compiler.languages.wrap_shared_type(target: v1.compiler.artifact.Rust, inner: rendered)
  } else { rendered }
}

// A carrier that realizes as a MACHINE SCALAR is a value, and a value is never raised to a
// reference layer. `Rc<i64>` is not a sharing decision, it is a category error: every arithmetic
// and comparison operator refuses on it, which is why one wrong decision produces many sites.
//
// WHAT THE GUARDED RULE DECIDES FROM, and why neither fact is about the carrier: membership by
// LEAF NAME against shared_types, guarded by rust_type_is_rc_wrapped, which is a string PREFIX
// test for "Rc<" against the already-rendered text. So the same carrier reached by two spellings
// is decided twice, and the prefix guard cannot see a layer through an alias.
//
// MEASURED on the emitted 05_eval closure at the Root B base, where `Nat` realizes natively as
// i64: 172 scalar-wrap spellings -- 12 literal `Rc<i64>` and 160 `Rc<Nat>`. Those are ONE category
// error in two spellings, and both appear on a single emitted line, e.g.
//   measure_scale_fraction_floor<Q, S>(m: Rc<Measure<Q, S, Rc<i64>>>, num: Rc<Nat>, ...)
// the type argument rendering the primitive and the parameter rendering the alias. One wrap
// decision reached by two rendering paths, not two defects. (An earlier census of this population
// said 12: it grepped the rendered primitive form and silently missed the alias form -- the same
// spelling-for-type substitution this guard exists to stop.)
//
// Before Root B the identical defect wore a different surface: `Nat` was
// `Rc<CommutativeSemiring<std.magnitude.Magnitude>>`, the use site rendered the spelling `Nat` (which does not
// begin with "Rc<", so the prefix guard read it as unwrapped) and raised a second layer to
// `Rc<Rc<CommutativeSemiring<std.magnitude.Magnitude>>>`. One position-blind rule, two representations, both
// wrong -- so the repair belongs on the carrier's realization, not on either rendering.
//
// The verdict comes from the SINGLE existing authority (rust_seed_host_numeric_alias, via the
// declaring file) rather than from inspecting rendered text, so no second wrap roster is authored.
// Scope, stated rather than implied: this closes the NUMERIC scalar case, which is the whole of
// the measured Rc<primitive> population. It deliberately does NOT consult lookup_checkpoint, whose
// rows include non-scalar carriers such as String that may legitimately be shared; widening there
// is a separate cut with its own evidence.
//
// RUNG (DESIGN 4b): MITIGATABLE, not structural, and the ceiling is inherited rather than novel.
// rust_seed_host_numeric_alias keys on a NAME plus a declaring-file check, not on resolved
// declaration identity -- the same ceiling checkpoint_table_bypasses_identity_note records for the
// neighbouring table. So this makes the numeric-scalar wrap not happen; it does not make a wrapped
// scalar unwritable. The next rung is the modeled layer transition wrap_decision.dag already
// names, at which point an agreeing flow is DERIVED rather than guarded.
fn rust_carrier_realizes_as_machine_scalar(n: v1.std.core.Node, type_name: String) -> Bool {
  match rust_seed_host_numeric_alias(name: type_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) {
    Present { value: _ } => true
    Absent => false
  }
}

// THE CARRIER'S REFERENCE LAYER, ASKED OF THE CARRIER.
//
// Four call sites below used to answer "is this carrier at the shared reference layer?" and each
// answered it differently:
//
//   the struct-FIELD type position keyed set_contains(shared_types, authored_name_at(..)) -- the
//     name AS AUTHORED, which post-#6848 resolution delivers namespace-QUALIFIED, while
//     shared_types is keyed on the BARE declared name (the same mismatch
//     alias_rhs_qualified_name_routing_note records for every other lookup on that path). So a
//     qualified reference matched nothing and the field rendered BARE;
//   the match-scrutinee position keyed the same membership but refused any leaf carrying type
//     arguments, so an applied shared carrier answered "not wrapped" while it renders as Rc<..>;
//   two value positions rendered the type to TEXT and prefix-matched "Rc<" against it
//     (rust_type_is_rc_wrapped -> sharing_type_is_wrapped_for_target), so an OPTIONAL shared
//     carrier rendering as Option<Rc<Foo>> answered "not wrapped" and took a second layer on top.
//
// Those are not four readings of one authority, they are four authorities, and they disagree in
// BOTH DIRECTIONS on a single carrier. MEASURED on the emitted closure rooted at
// src/v2/compiler/03_ingest.dag (177 files) at 1ebac31a099: v2.std.nat.Nat -- a Peano coproduct,
// Zero | Succ, NOT the natively-realizing dag/std/nat.dag declaration -- appears 18 times as
// "expected Nat, found Rc<Nat>" and 20 times as "expected Rc<Nat>, found Nat" in the same board.
// One inconsistency, two error directions; the specimen is Nat's own recursive field, declared
// `prev: Nat` by the field position and constructed `Rc::new(Nat::Succ { prev: .. })` by the value
// position. SpanIndex, SubjectRoster, ScopeRoster and ConsumerRequirement carry the same signature.
//
// The repair is the one the note above rust_carrier_realizes_as_machine_scalar names: ask the
// CARRIER, not its rendering and not its authored spelling. A layer is a fact about what the
// carrier realizes as, so it is decided once -- leaf identity, then machine-scalar realization,
// then sharing membership -- and every position projects that one answer.
//
// SCOPE, stated because the function name invites a wider reading than the change makes. This
// replaces the "is this carrier at the layer" question at the four sites listed above. It does NOT
// replace the double-wrap idempotence guards elsewhere in this file, which ask a different question
// -- "did the sub-rendering I just produced already apply the layer" -- and which are still
// answered by the prefix test; two of those guards remain composed with this predicate at the sites
// it now feeds. Those are the same class and they are the next cut; they are left alone here
// because each is a distinct rendering path whose idempotence has to be established per path rather
// than asserted for all of them at once. Also OUT of scope and named so they are not read as
// covered: rust_normalize_witness_type_text (573) and rust_normalize_partial_function_field_type_text
// (707), two string REPLACEs over rendered type text, and the struct_name == "PartialFunction"
// literal comparison that selects them.
//
// RUNG (DESIGN 4b): MITIGATABLE, and no higher. The invalid state is still writable -- nothing stops
// a future site from re-deriving the layer from text -- and the carrier key inherits the ceiling
// numeric_realization_identity_note and checkpoint_table_bypasses_identity_note already record: the
// scalar arm keys on a NAME plus a declaring file, and sharing membership keys on a bare leaf name,
// so two declarations sharing a spelling and differing in sharing are still conflated. The next rung
// is the modeled layer transition v2.compiler.wrap_decision names, whose TargetReferenceLayer and
// target_layer_transition carriers already exist in src/v2/std/compilers/target_model.dag; it is not
// reachable from here because the v1 seed's source roots do not include src/v2, and lifting the
// layer model to a root both compilers import is a carrier move that belongs ahead of this pipeline
// edit rather than inside it. This function is deliberately Bool-projected rather than a v1-local
// copy of TargetReferenceLayer, so that when the model becomes reachable there is one authority to
// route to and no second layer enum to merge away first.
fn rust_carrier_is_at_shared_layer(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, shared_types: std.types.Set<String>) -> Bool {
  let leaf = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
  leaf != ""
    && !rust_carrier_realizes_as_machine_scalar(n: n, type_name: leaf)
    && n.return_cardinality != v1.std.core.CardOptional
    && set_contains(shared_types, leaf)
}

fn render_rust_shared_type_with_optional(n: v1.std.core.Node, type_name: String, rendered: String, shared_types: std.types.Set<String>) -> String {
  if rust_carrier_realizes_as_machine_scalar(n: n, type_name: type_name) {
    return rust_carrier_optional_wrap(n: n, rendered: rendered)
  }
  rust_carrier_optional_wrap(n: n, rendered: render_rust_shared_type_if_needed(type_name: type_name, rendered: rendered, shared_types: shared_types))
}

fn render_rust_applied_type_shared(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  let rendered = render_rust_applied_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  let type_name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
  render_rust_shared_type_with_optional(n: n, type_name: type_name, rendered: rendered, shared_types: shared_types)
}

fn render_rust_decl_type(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  let applied_prop = v1.std.core.find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices)
  let applied_overlay = match applied_prop {
    Present { value: applied } =>
      if applied.children |> count > 0 { Present { value: applied } } else { none }
    Absent => none
  }
  match applied_overlay {
    Present { value: applied } =>
      let outer_name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
      if outer_name != "" && outer_name != "fn" && !std.types.is_container_type(name: outer_name) && n.connective == v1.std.core.NoConnective && (n.children |> count) == 0 {
        match closed_alias_peel_verdict(env: env, n: n) {
          ClosedAliasPeelZeroParam =>
            if rust_fn_sig_preserves_authored_alias_leaf(name: outer_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) {
              render_rust_shared_type_with_optional(n: n, type_name: outer_name, rendered: outer_name, shared_types: shared_types)
            } else {
              render_rust_applied_type_shared(n: applied, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
            }
          ClosedAliasHasParams => render_rust_applied_type_shared(n: applied, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
          ClosedAliasBindingAbsent => render_rust_applied_type_shared(n: applied, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
        }
      } else {
        render_rust_applied_type_shared(n: applied, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      }
    Absent =>
      let name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
      if n.connective == v1.std.core.NoConnective && n.children |> count == 0 && (generic_param_names |> any(g => g == name)) {
        v1.compiler.emit_core_support.to_pascal(name: name)
      } else if n.connective == v1.std.core.NoConnective && n.children |> count == 0 && applied_prop == none && is_host_text_carrier_type(n: n, source_indices: source_indices) {
        rust_carrier_optional_wrap(n: n, rendered: render_rust_text_carrier(shared_types: shared_types))
      } else if n.connective == v1.std.core.NoConnective && n.children |> count == 0 && applied_prop == none && set_contains(shared_types, name) {
        let rendered = rust_render_type_leaf_name(name: name, variant_to_enum: variant_to_enum)
        render_rust_shared_type_with_optional(n: n, type_name: name, rendered: rendered, shared_types: shared_types)
      } else if n.connective == v1.std.core.NoConnective && n.children |> count > 0 {
        match rust_render_checkpoint_scalar_bare(n: n, source_indices: source_indices, shared_types: shared_types) {
          Present { value: scalar } => render_rust_shared_type_with_optional(n: n, type_name: rust_fn_sig_leaf_name(source_indices: source_indices, n: n), rendered: scalar, shared_types: shared_types)
          Absent =>
        if !std.types.is_container_type(name: name) && closed_alias_peels_zero_param(env: env, n: n) {
          render_rust_shared_type_with_optional(n: n, type_name: name, rendered: name, shared_types: shared_types)
        } else {
        let base = rust_applied_type_base(name: name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n))
        let peel = is_parametric_opaque_type_by_name(env: env, type_name: name)
        let arg_list = n.children |> map(arg =>
          let typed_arg = render_rust_decl_type_container_arg(arg: arg, source_indices: source_indices, env: env)
          if peel {
            render_rust_phantom_opaque_applied_decl_arg(n: typed_arg, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
          } else if rust_type_arg_renders_as_unit(n: typed_arg, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
            "()"
          } else {
            match rust_render_checkpoint_scalar_bare(n: typed_arg, source_indices: source_indices, shared_types: shared_types) {
              Present { value: scalar } => scalar
              Absent => render_rust_decl_type(n: typed_arg, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
            }
          }
        )
        let applied_ty = if name == v1.std.core.tuple_type_name {
          v1.compiler.emit.render_tuple_parts(parts: arg_list, target: v1.compiler.artifact.Rust)
        } else if v1.compiler.infer_types.node_is_keyed_collection(n: n, source_indices: source_indices) {
          match arg_list |> first {
            Present { value: k } => match arg_list |> skip(1) |> first {
              Present { value: v } => v1.compiler.emit.emit_map_type(key_type: k, val_type: v, target: v1.compiler.artifact.Rust)
              Absent => concat(base, "<", arg_list |> join(separator: ", "), ">")
            }
            Absent => concat(base, "<", arg_list |> join(separator: ", "), ">")
          }
        } else if v1.compiler.infer_types.node_is_collection(n: n, source_indices: source_indices) && (arg_list |> count == 1) {
          match arg_list |> first {
            Present { value: inner } => v1.compiler.emit.emit_container(name: name, inner: inner, target: v1.compiler.artifact.Rust)
            Absent => concat(base, "<", arg_list |> join(separator: ", "), ">")
          }
        } else {
          concat(base, "<", arg_list |> join(separator: ", "), ">")
        }
        render_rust_shared_type_with_optional(n: n, type_name: name, rendered: applied_ty, shared_types: shared_types)
        }
        }
      } else if type_node_has_unbound_type_variable(n: n, generic_param_names: generic_param_names, source_indices: source_indices) {
        "_"
      } else {
        render_rust_type_with_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, env: env)
      }
  }
}

fn rust_fn_sig_preserves_authored_alias_leaf(name: String, decl_file: String) -> Bool {
  if std.types.is_kernel_type(name: name) {
    false
  } else if rust_opaque_kernel_alias_type_eligible(name: name) {
    false
  } else if name == "Nat" {
    true
  } else {
    rust_seed_host_numeric_alias(name: name, decl_file: decl_file) == none
  }
}

fn rust_carrier_optional_wrap(n: v1.std.core.Node, rendered: String) -> String {
  let is_optional = n.return_cardinality == v1.std.core.CardOptional
  if is_optional {
    concat("Option<", rendered, ">")
  } else {
    rendered
  }
}

fn render_rust_fn_sig_type(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  if type_node_has_value_variant_arg(n: n, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
    return render_rust_decl_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  let name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
  if n.connective == v1.std.core.NoConnective && n.children |> count == 0 && is_host_text_carrier_type(n: n, source_indices: source_indices) {
    rust_carrier_optional_wrap(n: n, rendered: render_rust_text_carrier(shared_types: shared_types))
  } else if n.connective == v1.std.core.NoConnective && n.children |> count == 0 && name != "" && name != "String" && !std.types.is_container_type(name: name) && closed_alias_peels_zero_param(env: env, n: n) && rust_fn_sig_preserves_authored_alias_leaf(name: name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) {
    render_rust_shared_type_with_optional(n: n, type_name: name, rendered: name, shared_types: shared_types)
  } else if n.connective == v1.std.core.NoConnective && n.children |> count > 0 && !std.types.is_container_type(name: name) && closed_alias_peels_zero_param(env: env, n: n) {
    render_rust_shared_type_with_optional(n: n, type_name: name, rendered: name, shared_types: shared_types)
  } else if generic_param_names |> count > 0 {
    render_rust_decl_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  } else {
    render_rust_fn_sig_type_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, env: env)
  }
}

fn render_rust_fn_sig_type_applied_binding(n: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, env: v1.compiler.infer_env.TypeEnv) -> String {
  match v1.std.core.find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
    Present { value: applied } =>
      if applied.children |> count > 0 {
        let outer_name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
        if outer_name != "" && outer_name != "fn" && !std.types.is_container_type(name: outer_name) && n.connective == v1.std.core.NoConnective && (n.children |> count) == 0 {
          match closed_alias_peel_verdict(env: env, n: n) {
            ClosedAliasPeelZeroParam =>
              if rust_fn_sig_preserves_authored_alias_leaf(name: outer_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) {
                render_rust_shared_type_with_optional(n: n, type_name: outer_name, rendered: outer_name, shared_types: shared_types)
              } else {
                render_rust_type_with_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, env: env)
              }
            ClosedAliasHasParams => render_rust_type_with_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, env: env)
            ClosedAliasBindingAbsent => render_rust_type_with_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, env: env)
          }
        } else {
          render_rust_type_with_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, env: env)
        }
      } else {
        render_rust_type_with_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, env: env)
      }
    Absent => render_rust_type_with_applied_binding(n: n, shared_types: shared_types, source_indices: source_indices, env: env)
  }
}

fn rust_decl_type_container_arg_needs_resolved_overlay(arg: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, env: v1.compiler.infer_env.TypeEnv) -> Bool {
  let authored_is_leaf = arg.connective == v1.std.core.NoConnective && (arg.children |> count) == 0
  let closed_alias = if authored_is_leaf {
    match closed_alias_peel_verdict(env: env, n: arg) {
      ClosedAliasPeelZeroParam => true
      _ => false
    }
  } else {
    false
  }
  let applied_arg_count = match v1.std.core.find_property(props: arg.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
    Present { value: applied } => Present { value: applied.children |> count }
    Absent => none
  }
  let resolved_child_count = match arg.inferred {
    Present { value: v1.std.core.Resolved { node: rt } } => rt.children |> count
    _ => 0
  }
  gunbc.rust_decl_type_overlay.rust_decl_type_container_overlay_is_admitted(
    authored_is_leaf: authored_is_leaf,
    closed_alias: closed_alias,
    applied_arg_count: applied_arg_count,
    resolved_child_count: resolved_child_count,
  )
}

fn render_rust_decl_type_container_arg(arg: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, env: v1.compiler.infer_env.TypeEnv) -> v1.std.core.Node {
  if rust_decl_type_container_arg_needs_resolved_overlay(arg: arg, source_indices: source_indices, env: env) {
    v1.compiler.infer_types.child_type_node(ch: arg)
  } else {
    arg
  }
}

fn alias_rhs_container_arg(arg: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node {
  match arg.inferred {
    Present { value: v1.std.core.Resolved { node: rt } } =>
      if v1.compiler.infer_types.node_is_collection(n: rt, source_indices: source_indices) { rt } else { arg }
    _ => arg
  }
}

data rust_fn_sig_leaf_name_dotted_note: String = "Construction wall for the dotted-render class in FN-SIG TYPE position (sibling of coerce_primitive_type_dotted_fallback_note for primitives and emit_typed_record_lit's bare_qualified_name for record-lit construction). render_rust_fn_sig_type / render_rust_fn_sig_type_applied_binding / render_rust_decl_type all extract a leaf type's name via authored_name_at and then both (a) key lookups against is_container_type/shared_types/closed_alias_peel_verdict and (b) pass that same string as literal Rust output via render_rust_shared_type_with_optional's `rendered` argument. A namespace-qualified closure-param or aliased-decl type (e.g. impl Fn(v2.lens.complexity_accumulator_copy.Finding) -> bool) previously reached (b) verbatim -- dots and all, an invalid Rust token sequence rustc reports as 'expected one of !, (, +, ::, or <, found .'. Since every lookup in (a) is keyed on the bare declared name (same reasoning as alias_rhs_qualified_name_routing_note below), the fix is to route the leaf-name extraction through rust_fn_sig_leaf_name (which wraps authored_name_at with qualified_last_segment, the single authority) so both the lookup key and the emitted text are bare together -- not a second dotted-name fallback forked per call site. Every already-bare name renders exactly as before."

fn rust_fn_sig_leaf_name(source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, n: v1.std.core.Node) -> String {
  v1.std.core.qualified_last_segment(name: v1.std.core.authored_name_at(source_indices: source_indices, node: n))
}

data alias_rhs_qualified_name_routing_note: String = "Construction wall for the dotted-render class. A namespace-QUALIFIED name in a type position (post-PR 6848 resolution) arrives from authored_name_at as the full dotted spelling, e.g. std.algebra.FreeMonoid. Every routing lookup on this path — alias_rhs_rust_qualify_module_filename via lookup_item, rust_seed_host_container_base, alias_base_is_zero_param_decl, is_parametric_opaque_type_base, shared_types — is keyed on the BARE declared name, so a dotted spelling matched nothing, def_mod fell back to the local module, and the else arm rendered the dotted string VERBATIM into Rust. That is not valid Rust: rustc reports 'expected one of !, (, +, ::, ;, <, or where, found .', a PARSE error, which then masks every later error in the module.

Measured blast radius before the fix: the emitted 04_infer closure (50 files) contained exactly ONE such line — 'pub type std.types.List<T> = std.algebra.FreeMonoid<T>' in v2_std_collection.rs — and that single line blocked 4 of 5 self-host flip candidates, because std.collection sits in essentially every deep-module closure. The control that proves the fault is qualified-specific is the very next declaration: 'type std.types.Set<T> = std.algebra.PointwisePower<T>' (BARE) already routed correctly to Rc<crate::v2_std_algebra::std.algebra.PointwisePower<T>>.

Fix: route on the TERMINAL segment via qualified_last_segment (v1.std.core, the existing authority — a qualified name IS a containment path, and its last segment is the declared name the registry knows). Not a string dot-to-colon rewrite: that would FABRICATE a path from the spelling instead of RESOLVING the declaration, and would silently produce a wrong path whenever the qualifier does not match the defining module. Because qualified_last_segment is the identity on an unqualified name, every bare name renders exactly as before — the seed stays byte-identical by construction, which is why this lands with regen_divergence_count=0 rather than merely hoping for it.

The v2 corpus authors qualified names in type position only rarely today, which is why one line carried this much weight; the point of fixing the renderer rather than editing that one declaration is that the next qualified name must not reintroduce it (DESIGN: do not cement the seed's accidents)."

fn render_rust_alias_rhs_type(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, scope: v1.compiler.infer.InferScope, imports: std.types.List<v1.std.core.Node>, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, module_name: String, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, module_index: ModuleIndex, variant_to_enum: std.types.Map<String, String>) -> String {
  if v1.compiler.infer.is_where_refinement_type(ty: n) {
    match n.children |> first {
      Present { value: base_te } =>
        return render_rust_alias_rhs_type(n: base_te, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
      Absent => {}
    }
  }
  let name = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  if n.connective == v1.std.core.NoConnective && n.children |> count == 0 && (generic_param_names |> any(g => g == name)) {
    v1.compiler.emit_core_support.to_pascal(name: name)
  } else if n.connective == v1.std.core.NoConnective && n.children |> count == 0 {
    match rust_seed_host_numeric_alias(name: name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) {
      Present { value: host } => host
      Absent =>
      match rust_opaque_kernel_alias_carrier(name: name) {
        Present { value: carrier } => carrier
        Absent => {
          let zero_leaf = v1.std.core.qualified_last_segment(name: name)
          let zero_local_mod = v1.compiler.emit_core_support.module_to_filename(name: module_name)
          let zero_def_mod = alias_rhs_rust_qualify_module_filename(name: zero_leaf, alias_module: module_name, imports: imports, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
          let rendered = if zero_def_mod != zero_local_mod && zero_def_mod != "" {
            concat("crate::", zero_def_mod, "::", zero_leaf)
          } else {
            rust_render_type_leaf_name(name: name, variant_to_enum: variant_to_enum)
          }
          render_rust_shared_type_if_needed(type_name: name, rendered: rendered, shared_types: shared_types)
        }
      }
    }
  } else if n.connective == v1.std.core.NoConnective && n.children |> count > 0 {
    let leaf = v1.std.core.qualified_last_segment(name: name)
    let numeric_host_alias = match rust_scalar_checkpoint_render_base(dag_name: leaf, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) {
      Present { value: scalar } => Present { value: scalar }
      Absent => rust_seed_host_numeric_alias(name: leaf, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n))
    }
    if numeric_host_alias != none {
      return match numeric_host_alias { Present { value: host } => host  Absent => "" }
    }
    let local_mod = v1.compiler.emit_core_support.module_to_filename(name: module_name)
    let def_mod = alias_rhs_rust_qualify_module_filename(name: leaf, alias_module: module_name, imports: imports, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
    let base = match rust_seed_host_container_base(name: leaf) {
      Present { value: host } => host
      Absent => if def_mod != local_mod {
        concat("crate::", def_mod, "::", leaf)
      } else {
        leaf
      }
    }
    match closed_alias_peel_verdict(env: scope.type_env, n: n) {
      ClosedAliasPeelZeroParam =>
        if set_contains(shared_types, leaf) && !rust_type_is_rc_wrapped(type_name: base) { v1.compiler.languages.wrap_shared_type(target: v1.compiler.artifact.Rust, inner: base) } else { base }
      ClosedAliasBindingAbsent =>
        match alias_decl_arity_verdict(type_name: leaf, def_mod_filename: def_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index, env: scope.type_env) {
          AliasDeclArityZeroParam =>
            if set_contains(shared_types, leaf) && !rust_type_is_rc_wrapped(type_name: base) { v1.compiler.languages.wrap_shared_type(target: v1.compiler.artifact.Rust, inner: base) } else { base }
          AliasDeclArityHasParams => {
    let peel = is_parametric_opaque_type_base(type_name: leaf, def_mod_filename: def_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
    let args = n.children |> map(arg =>
      if peel {
        render_rust_phantom_opaque_applied_type_arg(n: arg, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
      } else {
        render_rust_alias_rhs_type(n: alias_rhs_container_arg(arg: arg, source_indices: source_indices), generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
      }
    ) |> join(separator: ", ")
    let applied_ty = concat(base, "<", args, ">")
    if set_contains(shared_types, leaf) && !rust_type_is_rc_wrapped(type_name: applied_ty) {
      v1.compiler.languages.wrap_shared_type(target: v1.compiler.artifact.Rust, inner: applied_ty)
    } else {
      applied_ty
    }
          }
          AliasDeclArityAbsent => alias_decl_arity_refusal_expr(type_name: leaf)
        }
      ClosedAliasHasParams => {
    let peel = is_parametric_opaque_type_base(type_name: leaf, def_mod_filename: def_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
    let args = n.children |> map(arg =>
      if peel {
        render_rust_phantom_opaque_applied_type_arg(n: arg, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
      } else {
        render_rust_alias_rhs_type(n: alias_rhs_container_arg(arg: arg, source_indices: source_indices), generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
      }
    ) |> join(separator: ", ")
    let applied_ty = concat(base, "<", args, ">")
    if set_contains(shared_types, leaf) && !rust_type_is_rc_wrapped(type_name: applied_ty) {
      v1.compiler.languages.wrap_shared_type(target: v1.compiler.artifact.Rust, inner: applied_ty)
    } else {
      applied_ty
    }
      }
    }
  } else {
    render_rust_type(n: n, shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info())
  }
}

fn type_variable_node(id: String) -> v1.std.core.Node {
  v1.std.core.Node { name: "", span: v1.std.core.no_span(), ident_span: none, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.TypeVariable { id: id } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
}

fn is_type_variable(inferred: v1.std.core.InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

fn type_var_in_fn_generic_scope(id: String, generic_param_names: std.types.List<String>) -> Bool {
  generic_param_names |> any(g => g == id)
}

fn value_ref_qualified_leaf(name: String) -> String {
  if string_contains(s: name, pattern: ".") { v1.std.core.qualified_last_segment(name: name) } else { name }
}

data value_ref_self_module_normalization_note: String = "Construction wall for the SAME-MODULE half of the qualified-value-reference dotted-render class (sibling of value_ref_ident_dotted_fallback_note, which covers the general dotted-render/registry-miss case). A fully-qualified reference whose module qualifier names the CURRENT module (e.g. extdeps.container.oci.digest.extdeps_external_authority_anchor written inside extdeps.container.oci.digest itself) previously reached the bare-name registry (last-write-wins across every module sharing that leaf, since ordinary decl names are not disambiguated by qualifier) and resolved to whichever unrelated module happened to be inserted last, then rendered as a plain crate::wrong_module::ident value (never the is_data call-suffix decision, which is keyed on the still-dotted name and so never matches) wrapped in .clone() by the surrounding resolved_type sharing template — wrong module AND a fn-item value instead of the intended call. A same-module qualified reference names nothing a bare reference does not already name (the containment tree binds it to the enclosing module's own declaration, DESIGN §4), so the fix is to normalize it to the identical bare spelling before any registry lookup runs, rather than teaching the registry to disambiguate by qualifier — same-module resolution reuses the already-correct bare-name path instead of forking a second one. A genuine cross-module qualified reference (qualifier != current module) is untouched by this wall and keeps today's behavior."

fn value_ref_qualifier_prefix(name: String) -> String {
  let leaf = value_ref_qualified_leaf(name: name)
  if leaf == name { "" }
  else { substring(s: name, start: 0, end: string_length(s: name) - string_length(s: leaf) - 1) }
}

fn value_ref_normalize_self_module(name: String, module_name: String) -> String {
  if string_contains(s: name, pattern: ".") && value_ref_qualifier_prefix(name: name) == module_name {
    value_ref_qualified_leaf(name: name)
  } else {
    name
  }
}

fn rust_is_uppercase_letter(c: String) -> Bool {
  c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" || c == "G" || c == "H" || c == "I" || c == "J" || c == "K" || c == "L" || c == "M" || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R" || c == "S" || c == "T" || c == "U" || c == "V" || c == "W" || c == "X" || c == "Y" || c == "Z"
}

fn rust_read_rendered_type_ident(type_str: String, start: Int) -> String {
  if start >= string_length(s: type_str) { "" }
  else {
    let c = char_at(s: type_str, pos: start)
    if c == ">" || c == "," || c == "<" || c == " " || c == "&" || c == "(" || c == ")" { "" }
    else { concat(c, rust_read_rendered_type_ident(type_str: type_str, start: start + 1)) }
  }
}

fn rust_fold_rendered_type_has_spurious_generic_atom(atom: String, generic_param_names: std.types.List<String>) -> Bool {
  if atom == "" { false }
  else if type_var_in_fn_generic_scope(id: atom, generic_param_names: generic_param_names) { false }
  else { true }
}

fn rust_fold_rendered_type_has_spurious_from_pos(type_str: String, search_from: Int, generic_param_names: std.types.List<String>) -> Bool {
  if type_str == "_" || type_str == "" { false }
  else {
    match string_index_of_from(haystack: type_str, needle: "<", pos: search_from) {
      Present { value: lt_pos } =>
        let atom = rust_read_rendered_type_ident(type_str: type_str, start: lt_pos + 1)
        if atom |> count == 1 && rust_is_uppercase_letter(c: atom) && rust_fold_rendered_type_has_spurious_generic_atom(atom: atom, generic_param_names: generic_param_names) {
          true
        } else {
          rust_fold_rendered_type_has_spurious_from_pos(type_str: type_str, search_from: lt_pos + 1, generic_param_names: generic_param_names)
        }
      Absent => false
    }
  }
}

fn rust_fold_rendered_type_has_any_spurious_generic(type_str: String, generic_param_names: std.types.List<String>) -> Bool {
  rust_fold_rendered_type_has_spurious_from_pos(type_str: type_str, search_from: 0, generic_param_names: generic_param_names)
}

fn type_leaf_is_unbound_in_closure_scope(name: String, generic_param_names: std.types.List<String>, env: v1.compiler.infer_env.TypeEnv) -> Bool {
  if type_var_in_fn_generic_scope(id: name, generic_param_names: generic_param_names) {
    false
  } else {
    match v1.compiler.infer_env.lookup_type_by_name(env: env, name: name) {
      Present { value: resolved_node } =>
        if resolved_node.inferred != none && is_type_variable(inferred: resolved_node.inferred.value) { true } else { false }
      Absent => true
    }
  }
}

fn type_node_has_closure_unbound_generic_atom(n: v1.std.core.Node, generic_param_names: std.types.List<String>, env: v1.compiler.infer_env.TypeEnv, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let leaf_name = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  if n.children |> count == 0 && leaf_name != "" {
    if type_leaf_is_unbound_in_closure_scope(name: leaf_name, generic_param_names: generic_param_names, env: env) { return true }
  }
  if n.inferred != none {
    match n.inferred.value {
      TypeVariable { id: tv } =>
        if !type_var_in_fn_generic_scope(id: tv, generic_param_names: generic_param_names) { return true }
      Resolved { node: rt } =>
        if type_node_has_closure_unbound_generic_atom(n: rt, generic_param_names: generic_param_names, env: env, source_indices: source_indices) { return true }
      _ => ()
    }
  }
  if n.children |> any(c => type_node_has_closure_unbound_generic_atom(n: v1.compiler.infer_types.child_type_node(ch: c), generic_param_names: generic_param_names, env: env, source_indices: source_indices)) {
    true
  } else {
    match v1.std.core.find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
      Present { value: applied } => applied.children |> any(c => type_node_has_closure_unbound_generic_atom(n: c, generic_param_names: generic_param_names, env: env, source_indices: source_indices))
      Absent => false
    }
  }
}

fn type_node_has_unbound_type_variable(n: v1.std.core.Node, generic_param_names: std.types.List<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if n.inferred != none {
    match n.inferred.value {
      TypeVariable { id: tv } =>
        if !type_var_in_fn_generic_scope(id: tv, generic_param_names: generic_param_names) { return true }
      Resolved { node: rt } =>
        if type_node_has_unbound_type_variable(n: rt, generic_param_names: generic_param_names, source_indices: source_indices) { return true }
      _ => ()
    }
  }
  if n.children |> any(c => type_node_has_unbound_type_variable(n: v1.compiler.infer_types.child_type_node(ch: c), generic_param_names: generic_param_names, source_indices: source_indices)) {
    true
  } else {
    match v1.std.core.find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
      Present { value: applied } => applied.children |> any(c => type_node_has_unbound_type_variable(n: c, generic_param_names: generic_param_names, source_indices: source_indices))
      Absent => false
    }
  }
}

fn is_rust_value_type(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let normed = v1.compiler.infer_types.normalize_access_type_node(n: n)
  match v1.compiler.coercion.is_copy(target: v1.compiler.artifact.Rust, dag_name: v1.std.core.authored_name_at(source_indices: source_indices, node: normed), decl_file: v1.compiler.coercion.type_reference_decl_file(n: normed)) {
    Present { value: v } => v
    Absent => false
  }
}

fn is_rust_string_like(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let normed = v1.compiler.infer_types.normalize_access_type_node(n: n)
  v1.compiler.languages.is_string_like(target: v1.compiler.artifact.Rust, name: v1.std.core.authored_name_at(source_indices: source_indices, node: normed))
}

fn rust_source_root() -> String {
  match v1.compiler.languages.scaffold_for_target(target: v1.compiler.artifact.Rust).source_dir {
    Present { value: dir } => dir
    Absent => ""
  }
}

fn rust_source_ext() -> String {
  v1.compiler.languages.scaffold_for_target(target: v1.compiler.artifact.Rust).source_file_extension
}

fn rust_visibility_prefix() -> String {

  match v1.compiler.languages.visibility_for_target(target: v1.compiler.artifact.Rust) {
    KeywordVisibility { prefix: p } => p
    _ => "__VISIBILITY_SPEC_MISMATCH__"
  }
}

fn rust_items() -> v1.compiler.languages.ItemKeywords {
  v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Rust).items
}

fn rust_ord_derives_text() -> String {
  "#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, serde::Serialize, serde::Deserialize)]"
}

fn rust_ord_derives_copy_text() -> String {
  "#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, serde::Serialize, serde::Deserialize)]"
}

fn rust_nominal_identity_carrier_def(name: String) -> String {
  concat(rust_ord_derives_text(), "\n", rust_visibility_prefix(), rust_items().struct_keyword, " ", name, "(pub String);")
}

fn rust_nominal_identity_carrier_type_eligible(type_name: String) -> Bool {
  false
}

fn rust_nominal_ord_derives_for_shape(name: String, children: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  if v1.compiler.trait_derive_emit.rust_symbol_wrapped_ord_carrier_shape_eligible(children: children, source_indices: source_indices) {
    rust_ord_derives_text()
  } else {
    ""
  }
}

fn rust_nominal_ord_type_decl_ord_eligible(decl: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  v1.compiler.trait_derive_emit.rust_nominal_identity_carrier_shape_eligible(n: decl, source_indices: source_indices)
    || rust_symbol_wrapped_ord_carrier_shape_eligible(children: decl.children, source_indices: source_indices)
}

fn rust_nominal_ord_type_ref_eligible(elem_node: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> Bool {
  let type_name = v1.std.core.authored_name_at(source_indices: source_indices, node: elem_node)
  (elem_node.children |> count) == 0
    && (elem_node.params |> count) == 0
    && elem_node.connective == v1.std.core.NoConnective
    && match v1.compiler.infer_emit_info.lookup_emit_type_decl(emit_info: emit_info, type_name: type_name) {
      Present { value: decl } => rust_nominal_ord_type_decl_ord_eligible(decl: decl, source_indices: source_indices)
      Absent => false
    }
}

fn rust_nominal_ord_type_eligible(elem_node: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> Bool {
  v1.compiler.trait_derive_emit.rust_nominal_identity_carrier_shape_eligible(n: elem_node, source_indices: source_indices)
    || rust_nominal_ord_type_ref_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info)
    || rust_symbol_wrapped_ord_carrier_shape_eligible(children: elem_node.children, source_indices: source_indices)
}

fn rust_serde_tag_attr() -> String {
  match v1.compiler.languages.serialization_for_target(target: v1.compiler.artifact.Rust).tag_attribute {
    Present { value: attr } => attr
    Absent => v1.compiler.emit.emit_error_expr(message: "missing serde tag_attribute for Rust", target: v1.compiler.artifact.Rust)
  }
}

type RustEnumWireSerde {
  enum_attr: String
  rename_prefix: String?
  rename_suffix: String?
  rename_style: String?
  error_message: String?
}

fn rust_serde_policy(enum_attr: String, rename_prefix: String?, rename_suffix: String?, rename_style: String?) -> RustEnumWireSerde {
  RustEnumWireSerde {
    enum_attr: enum_attr,
    rename_prefix: rename_prefix,
    rename_suffix: rename_suffix,
    rename_style: rename_style,
    error_message: none
  }
}

fn rust_serde_policy_error(message: String) -> RustEnumWireSerde {
  RustEnumWireSerde {
    enum_attr: "",
    rename_prefix: none,
    rename_suffix: none,
    rename_style: none,
    error_message: Present { value: message }
  }
}

fn rust_tagged_object_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: rust_serde_tag_attr(), rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn rust_untagged_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: "#[serde(untagged)]", rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn rust_serde_error_policy(message: String) -> RustEnumWireSerde {
  rust_serde_policy_error(message: message)
}

fn rust_string_as_authored_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: "", rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn rust_snake_string_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: extdeps.languages.rust.emit.rust_serde_rename_all_snake_case, rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn rust_screaming_snake_string_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: extdeps.languages.rust.emit.rust_serde_rename_all_screaming_snake_case, rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn field_value_by_name(record: v1.std.core.Node, field_name: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node? {
  match record.children |> filter(fi => v1.std.core.field_init_node_name_at(n: fi, source_indices: source_indices) == field_name) |> first {
    Present { value: fi } => Present { value: v1.std.core.field_init_node_value(n: fi) }
    Absent => none
  }
}

fn literal_string_value(n: v1.std.core.Node) -> String? {
  match n.expr_data {
    ExprLiteral { value: lv } => match lv {
      LitStr { value: s } => Present { value: s }
      _ => none
    }
    _ => none
  }
}

fn record_string_field(record: v1.std.core.Node, field_name: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  match field_value_by_name(record: record, field_name: field_name, source_indices: source_indices) {
    Present { value: value_node } => literal_string_value(n: value_node)
    Absent => none
  }
}

fn naming_policy_node(encoding: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node? {
  field_value_by_name(record: encoding, field_name: "naming", source_indices: source_indices)
}

fn coproduct_decl_ref_decl_name(body: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  match field_value_by_name(record: body, field_name: "coproduct", source_indices: source_indices) {
    Present { value: decl_ref_node } => record_string_field(record: decl_ref_node, field_name: "decl_name", source_indices: source_indices)
    Absent => none
  }
}

fn optional_string_record_field(record: v1.std.core.Node, field_name: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  match field_value_by_name(record: record, field_name: field_name, source_indices: source_indices) {
    Present { value: n } => literal_string_value(n: n)
    Absent => none
  }
}

fn required_literal_string_policy_field(record: v1.std.core.Node, field_name: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  match field_value_by_name(record: record, field_name: field_name, source_indices: source_indices) {
    Present { value: n } => literal_string_value(n: n)
    Absent => none
  }
}

fn rust_string_policy_for_naming(naming: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> RustEnumWireSerde {
  let naming_name = v1.std.core.authored_name_at(source_indices: source_indices, node: naming)
  if naming_name == "AsAuthored" {
    rust_string_as_authored_policy()
  } else if naming_name == "SnakeCase" {
    rust_snake_string_policy()
  } else if naming_name == "ScreamingSnakeCase" {
    rust_screaming_snake_string_policy()
  } else if naming_name == "StripPrefixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "prefix", source_indices: source_indices) {
      Present { value: prefix } =>
        rust_serde_policy(
          enum_attr: "",
          rename_prefix: Present { value: prefix },
          rename_suffix: none,
          rename_style: Present { value: "StripAffixAndSnakeCase" }
        )
      Absent => rust_serde_error_policy(message: "StripPrefixAndSnakeCase requires a literal prefix")
    }
  } else if naming_name == "StripSuffixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "suffix", source_indices: source_indices) {
      Present { value: suffix } =>
        rust_serde_policy(
          enum_attr: "",
          rename_prefix: none,
          rename_suffix: Present { value: suffix },
          rename_style: Present { value: "StripAffixAndSnakeCase" }
        )
      Absent => rust_serde_error_policy(message: "StripSuffixAndSnakeCase requires a literal suffix")
    }
  } else if naming_name == "StripPrefixSuffixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "prefix", source_indices: source_indices) {
      Present { value: prefix } =>
        match required_literal_string_policy_field(record: naming, field_name: "suffix", source_indices: source_indices) {
          Present { value: suffix } =>
            rust_serde_policy(
              enum_attr: "",
              rename_prefix: Present { value: prefix },
              rename_suffix: Present { value: suffix },
              rename_style: Present { value: "StripAffixAndSnakeCase" }
            )
          Absent => rust_serde_error_policy(message: "StripPrefixSuffixAndSnakeCase requires a literal suffix")
        }
      Absent => rust_serde_error_policy(message: "StripPrefixSuffixAndSnakeCase requires a literal prefix")
    }
  } else {
    rust_serde_error_policy(message: concat("unsupported VariantNaming: ", naming_name))
  }
}

fn rust_internal_policy_for_naming(tag_field: String, naming: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> RustEnumWireSerde {
  let naming_name = v1.std.core.authored_name_at(source_indices: source_indices, node: naming)
  if naming_name == "AsAuthored" {
    rust_serde_policy(enum_attr: concat("#[serde(tag = \"", tag_field, "\")]"), rename_prefix: none, rename_suffix: none, rename_style: none)
  } else if naming_name == "SnakeCase" {
    rust_serde_policy(enum_attr: concat("#[serde(tag = \"", tag_field, "\", rename_all = \"snake_case\")]"), rename_prefix: none, rename_suffix: none, rename_style: none)
  } else if naming_name == "ScreamingSnakeCase" {
    rust_serde_policy(enum_attr: concat("#[serde(tag = \"", tag_field, "\", rename_all = \"SCREAMING_SNAKE_CASE\")]"), rename_prefix: none, rename_suffix: none, rename_style: none)
  } else if naming_name == "StripPrefixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "prefix", source_indices: source_indices) {
      Present { value: prefix } =>
        rust_serde_policy(
          enum_attr: concat("#[serde(tag = \"", tag_field, "\")]"),
          rename_prefix: Present { value: prefix },
          rename_suffix: none,
          rename_style: Present { value: "StripAffixAndSnakeCase" }
        )
      Absent => rust_serde_error_policy(message: "StripPrefixAndSnakeCase requires a literal prefix")
    }
  } else if naming_name == "StripSuffixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "suffix", source_indices: source_indices) {
      Present { value: suffix } =>
        rust_serde_policy(
          enum_attr: concat("#[serde(tag = \"", tag_field, "\")]"),
          rename_prefix: none,
          rename_suffix: Present { value: suffix },
          rename_style: Present { value: "StripAffixAndSnakeCase" }
        )
      Absent => rust_serde_error_policy(message: "StripSuffixAndSnakeCase requires a literal suffix")
    }
  } else if naming_name == "StripPrefixSuffixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "prefix", source_indices: source_indices) {
      Present { value: prefix } =>
        match required_literal_string_policy_field(record: naming, field_name: "suffix", source_indices: source_indices) {
          Present { value: suffix } =>
            rust_serde_policy(
              enum_attr: concat("#[serde(tag = \"", tag_field, "\")]"),
              rename_prefix: Present { value: prefix },
              rename_suffix: Present { value: suffix },
              rename_style: Present { value: "StripAffixAndSnakeCase" }
            )
          Absent => rust_serde_error_policy(message: "StripPrefixSuffixAndSnakeCase requires a literal suffix")
        }
      Absent => rust_serde_error_policy(message: "StripPrefixSuffixAndSnakeCase requires a literal prefix")
    }
  } else {
    rust_serde_error_policy(message: concat("unsupported VariantNaming: ", naming_name))
  }
}

fn rust_internal_policy_for_encoding(encoding: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> RustEnumWireSerde {
  match record_string_field(record: encoding, field_name: "tag_field", source_indices: source_indices) {
    Present { value: tag_field } =>
      match naming_policy_node(encoding: encoding, source_indices: source_indices) {
        Present { value: naming } => rust_internal_policy_for_naming(tag_field: tag_field, naming: naming, source_indices: source_indices)
        Absent => rust_serde_error_policy(message: "InternallyTaggedObject requires a naming policy")
      }
    Absent => rust_serde_error_policy(message: "InternallyTaggedObject requires a literal tag_field")
  }
}

fn resolve_wire_serde_policy_from_encoding_node(ve: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> RustEnumWireSerde {
  let encoding_name = v1.std.core.authored_name_at(source_indices: source_indices, node: ve)
  if encoding_name == "InternallyTaggedObject" {
    rust_internal_policy_for_encoding(encoding: ve, source_indices: source_indices)
  } else if encoding_name == "StringVariant" {
    match naming_policy_node(encoding: ve, source_indices: source_indices) {
      Present { value: nv } => rust_string_policy_for_naming(naming: nv, source_indices: source_indices)
      Absent => rust_serde_error_policy(message: "StringVariant requires a naming policy")
    }
  } else if encoding_name == "UntaggedVariant" {
    rust_untagged_policy()
  } else if encoding_name == "TaggedVariant" {
    rust_tagged_object_policy()
  } else {
    rust_serde_error_policy(message: concat("unsupported VariantEncoding: ", encoding_name))
  }
}

fn resolve_wire_serde_policy(wire_item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> RustEnumWireSerde {
  match wire_item.body {
    Present { value: ve } => resolve_wire_serde_policy_from_encoding_node(ve: ve, source_indices: source_indices)
    Absent =>
      match wire_item.expr_data {
        ExprRecordLit { parent_enum: _ } =>
          resolve_wire_serde_policy_from_encoding_node(ve: wire_item, source_indices: source_indices)
        _ => rust_serde_error_policy(message: "wire_contract: VariantEncoding could not be resolved (no initializer body and not a record literal)")
      }
  }
}

fn item_binding_is_named(env: v1.compiler.infer_env.TypeEnv, node: v1.std.core.Node, name: String) -> Bool {
  v1.compiler.infer_env.authored_name(env: env, node: node) == name || node.name == name
}

fn resolve_wire_serde_policy_for_coproduct(wire_contract_item: v1.std.core.Node?, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, data_items: std.types.Map<String, std.types.List<v1.std.core.Node>>) -> RustEnumWireSerde {
  resolve_wire_serde_policy_for_coproduct_seen(
    wire_contract_item: wire_contract_item,
    source_indices: source_indices,
    data_items: data_items,
    seen_aliases: empty_map(),
    fuel: 32
  )
}

fn resolve_wire_serde_policy_for_coproduct_seen(wire_contract_item: v1.std.core.Node?, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, data_items: std.types.Map<String, std.types.List<v1.std.core.Node>>, seen_aliases: std.types.Map<String, Bool>, fuel: Int) -> RustEnumWireSerde {
  if fuel <= 0 {
    rust_serde_error_policy(message: "wire_contract: VariantEncoding alias chain exceeded recursion limit")
  } else { match wire_contract_item {
    Absent => rust_tagged_object_policy()
    Present { value: wc } =>
      if v1.compiler.emit_core_support.is_data_def_item(item: wc) {
        match wc.body {
          Absent =>
            rust_serde_error_policy(message: "wire_contract: data item has no initializer body")
          Present { value: init } =>
            match init.expr_data {
              ExprRecordLit { parent_enum: _ } =>
                resolve_wire_serde_policy(wire_item: init, source_indices: source_indices)
              ExprVar { binding_kind: _ } =>
                let alias_name = v1.std.core.expr_var_name_at(texpr: init, source_indices: source_indices)
                if map_get(seen_aliases, alias_name) != none {
                  rust_serde_error_policy(message: concat("wire_contract: cyclic VariantEncoding alias: ", alias_name))
                } else {
                  match map_get(data_items, alias_name) {
                    Present { value: candidates } =>
                      if candidates |> count == 1 {
                        match first(candidates) {
                          Present { value: aliased_data } =>
                            resolve_wire_serde_policy_for_coproduct_seen(
                              wire_contract_item: Present { value: aliased_data },
                              source_indices: source_indices,
                              data_items: data_items,
                              seen_aliases: map_insert(seen_aliases, alias_name, true),
                              fuel: fuel - 1
                            )
                          Absent =>
                            rust_serde_error_policy(message: concat("wire_contract: missing VariantEncoding data alias: ", alias_name))
                        }
                      } else {
                        rust_serde_error_policy(message: concat("wire_contract: ambiguous VariantEncoding data alias: ", alias_name))
                      }
                  Absent =>
                    match init.inferred {
                      Absent =>
                        rust_serde_error_policy(message: "wire_contract: missing type inference on initializer (cannot resolve VariantEncoding alias)")
                      Present { value: inf } =>
                        match inf {
                          Resolved { node } =>
                            if v1.compiler.emit_core_support.is_data_def_item(item: node) {
                              resolve_wire_serde_policy_for_coproduct_seen(
                                wire_contract_item: Present { value: node },
                                source_indices: source_indices,
                                data_items: data_items,
                                seen_aliases: map_insert(seen_aliases, alias_name, true),
                                fuel: fuel - 1
                              )
                            } else {
                              resolve_wire_serde_policy(wire_item: node, source_indices: source_indices)
                            }
                          CompilerError { message, span: _ } =>
                            rust_serde_error_policy(message: concat("wire_contract: ", message))
                          TypeVariable { id: _ } =>
                            rust_serde_error_policy(message: "wire_contract: unresolved type variable in wire_contract initializer")
                        }
                    }
                }
                }
              _ =>
                match init.inferred {
                  Absent =>
                    rust_serde_error_policy(message: "wire_contract: missing type inference on initializer (cannot resolve VariantEncoding alias)")
                  Present { value: inf } =>
                    match inf {
                      Resolved { node } =>
                        if v1.compiler.emit_core_support.is_data_def_item(item: node) {
                          resolve_wire_serde_policy_for_coproduct_seen(
                            wire_contract_item: Present { value: node },
                            source_indices: source_indices,
                            data_items: data_items,
                            seen_aliases: seen_aliases,
                            fuel: fuel - 1
                          )
                        } else {
                          resolve_wire_serde_policy(wire_item: node, source_indices: source_indices)
                        }
                      CompilerError { message, span: _ } =>
                        rust_serde_error_policy(message: concat("wire_contract: ", message))
                      TypeVariable { id: _ } =>
                        rust_serde_error_policy(message: "wire_contract: unresolved type variable in wire_contract initializer")
                    }
                }
            }
        }
      } else {
        resolve_wire_serde_policy(wire_item: wc, source_indices: source_indices)
      }
  } }
}

fn coproduct_wire_contract_encoding(contract_item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node? {
  match contract_item.body {
    Present { value: body } =>
      field_value_by_name(record: body, field_name: "encoding", source_indices: source_indices)
    Absent => none
  }
}

fn variant_encoding_is_string_variant(encoding: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  v1.std.core.authored_name_at(source_indices: source_indices, node: encoding) == "StringVariant"
}

fn coproduct_wire_contract_targets(contract_item: v1.std.core.Node, coproduct_name: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  match contract_item.body {
    Present { value: body } =>
      match coproduct_decl_ref_decl_name(body: body, source_indices: source_indices) {
        Present { value: target_name } => target_name == coproduct_name
        Absent => false
      }
    Absent => false
  }
}

fn emit_rust_compile_error_item(message: String) -> String {
  concat("compile_error!(\"", message, "\");")
}

fn emit_rust_compile_error_expr(message: String) -> String {
  concat("compile_error!(\"", message, "\")")
}

fn module_imports_std_serialization_coproduct_wire_contract(imports: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  imports |> any(imp =>
    v1.std.core.authored_name_at(source_indices: source_indices, node: imp) == "std.serialization"
    && (v1.std.core.import_is_all(n: imp) || import_specific_names_at(n: imp, source_indices: source_indices) |> any(name => name == "CoproductWireContract"))
  )
}

fn data_item_type_is_coproduct_wire_contract(item: v1.std.core.Node, imports: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  match item.type_annotation {
    Present { value: type_node } =>
      v1.std.core.authored_name_at(source_indices: source_indices, node: type_node) == "CoproductWireContract"
      && module_imports_std_serialization_coproduct_wire_contract(imports: imports, source_indices: source_indices)
    Absent => false
  }
}

fn module_defines_local_coproduct_wire_contract_type(module_items: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  v1.std.core.module_items
    |> any(item =>
      (
        v1.compiler.emit_core_support.is_type_def_item(item: item)
        || is_type_alias_item(item: item, source_indices: source_indices)
        || is_type_decl_item(item: item, source_indices: source_indices)
      )
      && v1.std.core.authored_name_at(source_indices: source_indices, node: item) == "CoproductWireContract"
    )
}

fn is_coproduct_wire_contract_row(item: v1.std.core.Node, module_items: std.types.List<v1.std.core.Node>, imports: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if !v1.compiler.emit_core_support.is_data_def_item(item: item) {
    false
  } else if module_defines_local_coproduct_wire_contract_type(module_items: v1.std.core.module_items, source_indices: source_indices) {
    false
  } else if !data_item_type_is_coproduct_wire_contract(item: item, imports: imports, source_indices: source_indices) {
    false
  } else {
    match item.body {
      Present { value: body } =>
        field_value_by_name(record: body, field_name: "coproduct", source_indices: source_indices) != none
        && field_value_by_name(record: body, field_name: "encoding", source_indices: source_indices) != none
      Absent => false
    }
  }
}

fn emit_coproduct_wire_contract_target_validation(contract_item: v1.std.core.Node, local_coproduct_names: std.types.List<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  match contract_item.body {
    Present { value: body } =>
      match coproduct_decl_ref_decl_name(body: body, source_indices: source_indices) {
        Present { value: target_name } =>
          if any(local_coproduct_names, predicate: name => name == target_name) {
            ""
          } else {
            emit_rust_compile_error_item(message: concat("CoproductWireContract target does not name a local coproduct: ", target_name))
          }
        Absent =>
          emit_rust_compile_error_item(message: "CoproductWireContract.coproduct must be a DeclarationRef with a string decl_name")
      }
    Absent =>
      emit_rust_compile_error_item(message: "CoproductWireContract row missing initializer body")
  }
}

fn emit_coproduct_wire_contract_validations(module_items: std.types.List<v1.std.core.Node>, imports: std.types.List<v1.std.core.Node>, local_coproduct_names: std.types.List<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  if local_coproduct_names |> count == 0 {
    ""
  } else {
    v1.std.core.module_items
      |> filter(item => is_coproduct_wire_contract_row(item: item, module_items: v1.std.core.module_items, imports: imports, source_indices: source_indices))
      |> map(item => emit_coproduct_wire_contract_target_validation(contract_item: item, local_coproduct_names: local_coproduct_names, source_indices: source_indices))
      |> filter(text => text != "")
      |> join(separator: "\n")
  }
}

fn resolve_local_coproduct_wire_policy(coproduct_name: String, all_unit_variants: Bool, module_items: std.types.List<v1.std.core.Node>, imports: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> RustEnumWireSerde? {
  let contracts = v1.std.core.module_items
    |> filter(item => is_coproduct_wire_contract_row(item: item, module_items: v1.std.core.module_items, imports: imports, source_indices: source_indices) && coproduct_wire_contract_targets(contract_item: item, coproduct_name: coproduct_name, source_indices: source_indices))
  if contracts |> count == 0 {
    none
  } else if contracts |> count == 1 {
    match contracts |> first {
      Present { value: contract } =>
        match coproduct_wire_contract_encoding(contract_item: contract, source_indices: source_indices) {
          Present { value: encoding } =>
            if variant_encoding_is_string_variant(encoding: encoding, source_indices: source_indices) && !all_unit_variants {
              Present { value: rust_serde_error_policy(message: concat("CoproductWireContract StringVariant requires a nullary-only coproduct: ", coproduct_name)) }
            } else {
              Present { value: resolve_wire_serde_policy_from_encoding_node(ve: encoding, source_indices: source_indices) }
            }
          Absent =>
            Present { value: rust_serde_error_policy(message: concat("CoproductWireContract missing encoding for ", coproduct_name)) }
        }
      Absent => none
    }
  } else {
    Present {
      value: rust_serde_error_policy(message: concat("ambiguous CoproductWireContract rows for ", coproduct_name))
    }
  }
}

fn build_data_item_index(modules: std.types.List<v1.compiler.infer_items.TypedModule>) -> std.types.Map<String, v1.std.core.Node> {
  modules |> fold(init: empty_map(), f: (acc, tm) =>
    let module_name = v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)
    tm.items
      |> filter(item => v1.compiler.emit_core_support.is_data_def_item(item: item))
      |> fold(init: acc, f: (item_acc, item) =>
        let item_name = v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: item)
        let qualified_name = concat(module_name, ".", item_name)
        map_insert(item_acc, qualified_name, item)
      )
  )
}

fn build_qualified_item_registry(modules: std.types.List<v1.compiler.infer_items.TypedModule>) -> std.types.Map<String, v1.compiler.infer_items.ItemInfo> {
  modules |> fold(init: empty_map(), f: (acc, tm) =>
    let module_name = v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)
    tm.item_registry |> map_keys |> fold(init: acc, f: (acc2, item_name) =>
      match map_get(tm.item_registry, item_name) {
        Present { value: info } =>
          let qualified_name = concat(module_name, ".", item_name)
          match map_get(acc2, qualified_name) {
            Present { value: _ } =>
              map_insert(acc2, qualified_name, duplicate_qualified_item_registry_marker(name: qualified_name))
            Absent => map_insert(acc2, qualified_name, info)
          }
        Absent => acc2
      }
    )
  )
}

fn merge_item_registries(bare: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, qualified: std.types.Map<String, v1.compiler.infer_items.ItemInfo>) -> std.types.Map<String, v1.compiler.infer_items.ItemInfo> {
  qualified |> map_keys |> fold(init: bare, f: (acc, key) =>
    match map_get(qualified, key) {
      Present { value: info } => map_insert(acc, key, info)
      Absent => acc
    }
  )
}

data value_ref_leaf_key_collision_note: String = "Construction wall for the cross-module half of the qualified-value-reference dotted-render class (sibling of value_ref_self_module_normalization_note for the same-module half). #7685 keyed registry lookup on the leaf name so the is_data call-suffix decision fired for dotted references, but the flat item_registry is keyed by bare name with last-write-wins across the closure — so module_a.homonym_value could consult module_b's ItemInfo when both modules declare the same leaf. Fix: merge a qualified-name overlay (module.leaf -> ItemInfo, one authority per declaring module) at emit time and key cross-module lookups on the full normalized spelling; same-module references still normalize to bare before lookup. Rendering uses the exact qualified registry row for BOTH declaration kind and declaring module — never the authored qualifier string alone (§5 fabricated-plausible-output refusal). Duplicate exact module.leaf overlay keys refuse via duplicate_qualified_item_registry_marker rather than last-write-wins."

data duplicate_qualified_item_registry_marker_note: String = "Fail-closed marker row for duplicate exact module.leaf keys in the qualified item_registry overlay. build_qualified_item_registry inserts this sentinel instead of last-write-wins. Consumers: emit_qualified_value_ref_crate_ident (dotted Present path), value_ref_item_info_refusal (emit_var_ref / emit_typed_expr_base Present arms) — both refuse via emit_error_expr when is_duplicate_qualified_item_registry_marker holds. DEFINE-AND-CONSUME, not define-only."

fn duplicate_qualified_item_registry_marker(name: String) -> v1.compiler.infer_items.ItemInfo {
  v1.compiler.infer_items.ItemInfo {
    name: name,
    module_name: "__DUPLICATE_QUALIFIED_ITEM_REGISTRY_KEY__",
    kind: v1.compiler.infer_items.OtherItem,
    service_names: [],
    resource_names: [],
    params: [],
    is_self_recursive: false,
    has_non_tail_self_call: false
  }
}

fn is_duplicate_qualified_item_registry_marker(info: v1.compiler.infer_items.ItemInfo) -> Bool {
  info.module_name == "__DUPLICATE_QUALIFIED_ITEM_REGISTRY_KEY__"
}

fn value_ref_registry_lookup_key(resolved_name: String) -> String {
  let qualifier = value_ref_qualifier_prefix(name: resolved_name)
  if qualifier == "" { value_ref_qualified_leaf(name: resolved_name) }
  else { resolved_name }
}

fn lookup_item_for_value_ref(resolved_name: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>) -> v1.compiler.infer_items.ItemInfo? {
  v1.compiler.emit.lookup_item(registry: registry, name: value_ref_registry_lookup_key(resolved_name: resolved_name))
}

fn emit_qualified_value_ref_crate_ident(leaf: String, info: v1.compiler.infer_items.ItemInfo, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>) -> String {
  if is_duplicate_qualified_item_registry_marker(info: info) {
    v1.compiler.emit.emit_error_expr(message: "duplicate qualified item_registry key — refuse ambiguous module.leaf overlay", target: v1.compiler.artifact.Rust)
  } else {
    concat("crate::", v1.compiler.emit_core_support.module_to_filename(name: info.module_name), "::", emit_import_name(n: leaf, registry: registry))
  }
}

fn value_ref_item_info_refusal(info: v1.compiler.infer_items.ItemInfo) -> String {
  v1.compiler.emit.emit_error_expr(message: "duplicate qualified item_registry key — refuse ambiguous module.leaf overlay", target: v1.compiler.artifact.Rust)
}

fn insert_scoped_data_item(scoped: std.types.Map<String, std.types.List<v1.std.core.Node>>, name: String, item: v1.std.core.Node) -> std.types.Map<String, std.types.List<v1.std.core.Node>> {
  let existing = match map_get(scoped, name) {
    Present { value: entries } => entries
    Absent => []
  }
  map_insert(scoped, name, concat(existing, [item]))
}

fn build_scoped_data_item_index(typed_module: v1.compiler.infer_items.TypedModule, data_items: std.types.Map<String, v1.std.core.Node>) -> std.types.Map<String, std.types.List<v1.std.core.Node>> {
  let module_name = v1.std.core.authored_name_at(source_indices: typed_module.type_env.source_indices, node: typed_module.module)
  let local = typed_module.items
    |> filter(item => v1.compiler.emit_core_support.is_data_def_item(item: item))
    |> fold(init: empty_map(), f: (acc, item) =>
      insert_scoped_data_item(
        scoped: acc,
        name: v1.std.core.authored_name_at(source_indices: typed_module.type_env.source_indices, node: item),
        item: item
      )
    )
  v1.std.core.module_imports(n: typed_module.module)
    |> fold(init: local, f: (acc, imp) =>
      let import_path = v1.std.core.authored_name_at(source_indices: typed_module.type_env.source_indices, node: imp)
      if v1.std.core.import_is_all(imp) {
        acc
      } else {
        v1.std.core.import_specific_names_at(n: imp, source_indices: typed_module.type_env.source_indices)
          |> fold(init: acc, f: (inner, imported_name) =>
            let qualified = concat(import_path, ".", imported_name)
            match map_get(data_items, qualified) {
              Present { value: imported_item } =>
                insert_scoped_data_item(scoped: inner, name: imported_name, item: imported_item)
              Absent => inner
            }
          )
      }
    )
}

fn augment_scoped_data_item_index_with_imports(scoped: std.types.Map<String, std.types.List<v1.std.core.Node>>, imports: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, data_items: std.types.Map<String, v1.std.core.Node>) -> std.types.Map<String, std.types.List<v1.std.core.Node>> {
  imports
    |> fold(init: scoped, f: (acc, imp) =>
      let import_path = v1.std.core.authored_name_at(source_indices: source_indices, node: imp)
      if v1.std.core.import_is_all(imp) {
        acc
      } else {
        v1.std.core.import_specific_names_at(n: imp, source_indices: source_indices)
          |> fold(init: acc, f: (inner, imported_name) =>
            match map_get(inner, imported_name) {
              Present { value: _ } => inner
              Absent =>
                let qualified = concat(import_path, ".", imported_name)
                match map_get(data_items, qualified) {
                  Present { value: imported_item } =>
                    insert_scoped_data_item(scoped: inner, name: imported_name, item: imported_item)
                  Absent => inner
                }
            }
          )
      }
    )
}

fn rust_serde_rename_template_text() -> String {
  match v1.compiler.languages.serialization_for_target(target: v1.compiler.artifact.Rust).rename_attribute_template {
    Present { value: template } => template
    Absent => v1.compiler.emit.emit_error_expr(message: "missing serde rename_attribute_template for Rust", target: v1.compiler.artifact.Rust)
  }
}

fn rust_test_file_path(module_name: String) -> String {
  let conventions = v1.compiler.languages.test_conventions_for_target(target: v1.compiler.artifact.Rust)
  let file_dir = match conventions.file_dir {
    Present { value: dir } => dir
    Absent => ""
  }
  let filename = v1.compiler.emit_core_support.module_to_filename(name: module_name)
  concat(file_dir, conventions.file_prefix, filename, conventions.file_suffix, rust_source_ext())
}

fn rust_test_name(projection: v1.compiler.emit_core_support.TestProjection) -> String {
  v1.compiler.emit_core_support.test_function_name(projection: projection, target: v1.compiler.artifact.Rust)
}

fn rust_async_test_decorator() -> String {
  match v1.compiler.languages.test_conventions_for_target(target: v1.compiler.artifact.Rust).async_decorator {
    Present { value: decorator } => decorator
    Absent => v1.compiler.emit.emit_error_expr(message: "missing async_decorator for Rust test conventions", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_block_stmts(remaining: std.types.List<v1.std.core.Node>, text: std.types.List<String>,
    scope: v1.compiler.infer.InferScope, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> v1.compiler.emit.BlockEmitState {
  match remaining |> first {
    Absent => v1.compiler.emit.BlockEmitState { text: text, scope: scope }
    Present { value: stmt } =>
      let line = emit_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let next_scope = v1.compiler.emit.scope_after_expr(texpr: stmt, scope: scope)
      emit_rust_block_stmts(remaining: remaining |> skip(1),
        text: list_push(text, line), scope: next_scope,
        registry: registry, depth: depth, shared_types: shared_types, emit_info: emit_info)
  }
}

fn emit_rust_init_block_stmts(remaining: std.types.List<v1.std.core.Node>, text: std.types.List<String>,
    scope: v1.compiler.infer.InferScope, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> v1.compiler.emit.BlockEmitState {
  match remaining |> first {
    Absent => v1.compiler.emit.BlockEmitState { text: text, scope: scope }
    Present { value: stmt } =>
      let rest = remaining |> skip(1)
      match rest |> first {
        Absent => v1.compiler.emit.BlockEmitState { text: text, scope: scope }
        Present { value: _ } =>
          let raw_line = emit_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          let is_let = match stmt.expr_data {
            ExprLet => true
            _ => false
          }
          let line = if is_let { raw_line } else { concat(raw_line, ";") }
          let next_scope = v1.compiler.emit.scope_after_expr(texpr: stmt, scope: scope)
          emit_rust_init_block_stmts(remaining: rest,
            text: list_push(text, line), scope: next_scope,
            registry: registry, depth: depth, shared_types: shared_types, emit_info: emit_info)
      }
  }
}

fn rust_qualify_type_leaf_name(name: String, variant_to_enum: std.types.Map<String, String>) -> String {
  match map_get(variant_to_enum, name) {
    Present { value: parent } =>
      if parent != "" { rust_variant_path(parent: parent, rust_name: name) } else { name }
    Absent => name
  }
}

// Construction wall for the dotted-render class in TYPE-LEAF position -- the residual gap in
// alias_rhs_qualified_name_routing_note's wall rather than a new position. That wall routes the
// alias-RHS path, but a `where`-refinement RHS re-enters render_rust_alias_rhs_type on its BASE
// expression and reaches this renderer with the dotted spelling intact: `type VersionIdentity =
// std.types.NonEmptyStr where brand(..)` emitted `pub type SemVerIdentity = std.types.NonEmptyStr;`
// -- the same rustc PARSE error ('expected one of !, (, +, ::, ;, <, or where, found .') that masks
// every later diagnostic in the module. Every lookup below is keyed on the BARE declared name
// (rust_opaque_kernel_alias_type_eligible is literally a name == "Json" test), so reducing here
// makes the lookup key and the emitted text bare TOGETHER -- the same remedy, and the same single
// authority, that rust_fn_sig_leaf_name applies in FN-SIG position and variant_pattern_qualified_path
// applies in PATTERN position, rather than forking a fourth dotted-name fallback.
// qualified_last_segment is the identity on an unqualified name, so every already-bare name renders
// exactly as before.
fn rust_render_type_leaf_name(name: String, variant_to_enum: std.types.Map<String, String>) -> String {
  let leaf = v1.std.core.qualified_last_segment(name: name)
  if leaf == "Unit" {
    "()"
  } else if is_value_variant_type_arg(generic_param_names: [], variant_to_enum: variant_to_enum, name: leaf) {
    "()"
  } else {
    match rust_opaque_kernel_alias_carrier(name: leaf) {
      Present { value: carrier } => carrier
      Absent => rust_qualify_type_leaf_name(name: leaf, variant_to_enum: variant_to_enum)
    }
  }
}

fn rust_phantom_zst_marker_def(vname: String) -> String {
  concat(
    "#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]\n",
    rust_visibility_prefix(), rust_items().struct_keyword, " ", vname, ";"
  )
}

fn emit_phantom_zst_markers_for_enum(children: std.types.List<v1.std.core.Node>, env: v1.compiler.infer_env.TypeEnv) -> String {
  let markers = children
    |> filter(child => child.children |> count == 0)
    |> filter(child => is_phantom_unit_variant_type_arg(env: env, variant_name: v1.compiler.infer_env.authored_name(env: env, node: child)))
    |> map(child =>
      let vname = v1.compiler.infer_env.authored_name(env: env, node: child)
      rust_phantom_zst_marker_def(vname: vname)
    )
    |> join(separator: "\n")
  markers
}

fn phantom_marker_name_shadowed_by_real_type_item(items: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, vname: String) -> Bool {
  items |> any(item =>
    v1.std.core.authored_name_at(source_indices: source_indices, node: item) == vname
    && (v1.compiler.emit_core_support.is_type_alias_item(item: item, source_indices: source_indices) || is_type_decl_item(item: item, source_indices: source_indices))
  )
}

fn collect_phantom_zst_marker_names(items: std.types.List<v1.std.core.Node>, env: v1.compiler.infer_env.TypeEnv) -> std.types.List<String> {
  items
    |> filter(item => v1.compiler.emit_core_support.is_type_def_item(item: item) && item.children |> all(c => c.children |> count == 0))
    |> fold(init: [], f: (acc, item) =>
      fold(item.children, init: acc, f: (inner, child) =>
        if child.children |> count == 0 {
          let vname = v1.compiler.infer_env.authored_name(env: env, node: child)
          if is_phantom_unit_variant_type_arg(env: env, variant_name: vname)
            && !inner |> any(n => n == vname)
            && !phantom_marker_name_shadowed_by_real_type_item(items: items, source_indices: env.source_indices, vname: vname) {
            concat(inner, [vname])
          } else { inner }
        } else { inner }
      )
    )
}

fn emit_module_phantom_zst_markers(items: std.types.List<v1.std.core.Node>, env: v1.compiler.infer_env.TypeEnv) -> String {
  collect_phantom_zst_marker_names(items: items, env: env)
    |> map(vname => rust_phantom_zst_marker_def(vname: vname))
    |> join(separator: "\n")
}

fn has_complex_variants(item: v1.std.core.Node) -> Bool {
  if item.children |> count == 0 { false }
  else {
    item.children |> any(c => c.connective != v1.std.core.NoConnective)
  }
}

fn is_simple_disj(item: v1.std.core.Node) -> Bool {
  let complex = item.children |> filter(v => v.children |> count > 0)
  complex |> count == 0
}

fn is_dag_value_type_name(name: String) -> Bool {
  match v1.compiler.coercion.is_copy(target: v1.compiler.artifact.Rust, dag_name: name, decl_file: "") {
    Present { value: v } => v
    Absent => false
  }
}

fn is_type_constant(summary: v1.compiler.infer_emit_info.TypeSummary, recursive_type_set: std.types.Set<String>) -> Bool {
  let is_recursive = set_contains(recursive_type_set, summary.name)
  let has_generics = (summary.generic_param_names |> count) > 0
  match summary.repr {
    EnumRepr { unit_only: unit_only } =>
      unit_only && !is_recursive && !has_generics && !summary.has_fn_fields
    StructRepr =>
      if is_recursive || has_generics || summary.has_fn_fields { false }
      else {
        let field_count = sorted_map_keys(summary.field_summaries) |> count
        let ft_count = sorted_map_keys(summary.field_type_map) |> count
        if ft_count < field_count { false }
        else { map_values(summary.field_type_map) |> all(tn => is_dag_value_type_name(name: tn)) }
      }
  }
}

fn maybe_mark_shared_type(acc: std.types.Set<String>, summary: v1.compiler.infer_emit_info.TypeSummary, recursive_type_set: std.types.Set<String>, target_needs_sharing: Bool) -> std.types.Set<String> {
  let needs_sharing = target_needs_sharing && match summary.repr {
    StructRepr => true
    EnumRepr { unit_only: unit_only } => unit_only == false
  }
  if is_grounded_coproduct_native_alias(name: summary.name) {
    acc
  } else if needs_sharing && !is_type_constant(summary: summary, recursive_type_set: recursive_type_set) {
    set_insert(acc, summary.name)
  } else {
    acc
  }
}

fn build_shared_types(type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, recursive_type_set: std.types.Set<String>, target: v1.compiler.artifact.RenderTarget) -> std.types.Set<String> {

  let sharing = v1.compiler.languages.sharing_for_target(target: target)
  let user_shared = map_values(type_summaries) |> fold(init: empty_set(), f: (acc, summary) =>
    maybe_mark_shared_type(acc: acc, summary: summary, recursive_type_set: recursive_type_set, target_needs_sharing: sharing.needs_sharing)
  )

  let collection_keys = sorted_map_keys(extdeps.languages.rust.emit.rust_container_templates)
    |> filter(k => sharing.needs_sharing && k != "optional" && k != "boolean_algebra")
  collection_keys |> fold(init: user_shared, f: (acc, key) =>
    let pascal = v1.compiler.emit_core_support.to_pascal(name: key)
    set_insert(acc, pascal)
  )
}

type OwnershipProofEntry {
  name: String
  proof: v1.compiler.ownership.OwnershipProof
  param_names: std.types.Set<String>
}

type OwnershipBuildResult {
  ownership_index: std.types.Map<String, std.types.Set<String>>
  read_only_params_index: std.types.Map<String, std.types.Set<String>>
}

fn build_ownership_results(modules: std.types.List<v1.compiler.infer_items.TypedModule>) -> OwnershipBuildResult {
  let callable_set = modules |> fold(init: empty_set(), f: (acc, m) =>
    m.items |> filter(item => item.body != Absent) |> fold(init: acc, f: (inner, item) =>
      set_union(inner, v1.compiler.ownership.collect_callable_refs(texpr: item.body.value, si: m.type_env.source_indices))
    )
  )
  let proofs = modules |> flat_map(m =>
    m.items |> filter(item => item.body != Absent) |> map(item =>
      let pnames = item.params |> fold(init: empty_set(), f: (acc, p) =>
        set_insert(acc, v1.std.core.param_node_name_at(n: p, source_indices: m.type_env.source_indices))
      )
      let si = m.type_env.source_indices
      let qualified = concat(v1.std.core.authored_name_at(source_indices: si, node: m.module), ".", v1.std.core.authored_name_at(source_indices: si, node: item))
      OwnershipProofEntry { name: qualified, proof: v1.compiler.ownership.analyze_ownership(func_name: v1.std.core.authored_name_at(source_indices: si, node: item), params: item.params, body: item.body.value, si: si), param_names: pnames }
    )
  )
  proofs |> fold(init: OwnershipBuildResult { ownership_index: empty_map(), read_only_params_index: empty_map() }, f: (acc, entry) =>
    let read_only = if set_contains(callable_set, entry.proof.func_name) { empty_set() }
      else { v1.compiler.ownership.build_read_only_params(proof: entry.proof, param_names: entry.param_names) }
    let movable = v1.compiler.ownership.build_movable_set(proof: entry.proof, param_names: entry.param_names)
    OwnershipBuildResult {
      ownership_index: map_insert(acc.ownership_index, entry.name, movable),
      read_only_params_index: map_insert(acc.read_only_params_index, entry.name, read_only)
    }
  )
}

fn group_unlisted_type_names(diags: std.types.List<v1.std.core.ErrorNode>) -> std.types.Map<String, std.types.List<String>> {
  diags |> fold(init: empty_map(), f: (acc, en) =>
    match en.diagnostic {
      UnlistedImportUse { name: nm, span: _ } =>
        let existing = match map_get(acc, en.module_name) { Present { value: v } => v  Absent => [] }
        map_insert(acc, en.module_name, concat(existing, [nm]))
      _ => acc
    })
}

fn v1_item_signature_type_exprs(item: v1.std.core.Node) -> std.types.List<v1.std.core.Node> {
  concat(
    function_value_params(params: item.params) |> map(p => v1.std.core.param_node_type_expr(n: p)),
    [v1.compiler.infer.declared_return_type_node(item: item)]
  )
}

fn v1_map_key_seed_type_exprs(modules: std.types.List<v1.compiler.infer_items.TypedModule>, type_decl_items: std.types.Map<String, v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> std.types.List<v1.std.core.Node> {
  let declaration_field_exprs = map_keys(type_decl_items) |> flat_map(type_name =>
    match map_get(type_decl_items, type_name) {
      Present { value: item } => v1.compiler.trait_derive_emit.v1_item_field_type_exprs(item: item, source_indices: source_indices)
      Absent => []
    }
  )
  let signature_exprs = modules |> flat_map(m => m.items |> flat_map(item => v1_item_signature_type_exprs(item: item)))
  concat(declaration_field_exprs, signature_exprs)
}

fn merged_module_source_indices(modules: std.types.List<v1.compiler.infer_items.TypedModule>) -> std.types.Map<String, v1.std.core.NewlineIndex> {
  modules |> fold(init: empty_map(), f: (acc, m) => map_merge(acc, m.type_env.source_indices))
}

fn emit_rust(typed: v1.compiler.infer_items.ResolvedGraph) -> v1.compiler.emit_core_support.EmitResult {
  let base_info = v1.compiler.infer.build_emit_graph_info(modules: typed.modules)
  let ownership = build_ownership_results(modules: typed.modules)
  let shared = build_shared_types(type_summaries: base_info.type_summaries, recursive_type_set: base_info.recursive_type_set, target: v1.compiler.artifact.Rust)
  let clone_bounded = v1.compiler.trait_derive_emit.v1_clone_bounded_type_params(
    type_decl_items: base_info.type_decl_items,
    source_indices: merged_module_source_indices(modules: typed.modules)
  )
  let map_key_required = v1.compiler.trait_derive_emit.v1_map_key_required_type_names(
    seed_type_exprs: v1_map_key_seed_type_exprs(modules: typed.modules, type_decl_items: base_info.type_decl_items, source_indices: merged_module_source_indices(modules: typed.modules)),
    extra_seed_names: hand_maintained_map_key_required_type_names,
    type_decl_items: base_info.type_decl_items,
    source_indices: merged_module_source_indices(modules: typed.modules)
  )
  let clone_impl_required = v1.compiler.trait_derive_emit.v1_clone_impl_required_type_params(
    type_decl_items: base_info.type_decl_items,
    source_indices: merged_module_source_indices(modules: typed.modules)
  )
  let emit_info = v1.compiler.infer_emit_info.EmitGraphInfo {
    type_summaries: base_info.type_summaries,
    type_decl_items: base_info.type_decl_items,
    fn_decl_items: base_info.fn_decl_items,
    recursive_type_set: base_info.recursive_type_set,
    fielded_variants: base_info.fielded_variants,
    positional_payload_variants: base_info.positional_payload_variants,
    shared_types: shared,
    ownership_index: ownership.ownership_index,
    movable: empty_set(),
    variant_to_enum: base_info.variant_to_enum,
    owned_bindings: empty_set(),
    read_only_params_index: ownership.read_only_params_index,
    read_only_params: empty_set(),
    clone_bounded_type_params: clone_bounded,
    map_key_required_type_names: map_key_required,
    clone_impl_required_type_params: clone_impl_required,
    fn_generic_param_names: base_info.fn_generic_param_names,
    fn_type_env: base_info.fn_type_env,
    fn_return_type: none
  }
  let shared_types = emit_info.shared_types
  let registry = merge_item_registries(
    bare: typed.item_registry,
    qualified: build_qualified_item_registry(modules: typed.modules)
  )
  let data_items = build_data_item_index(modules: typed.modules)
  let workflow_funcs = collect_workflow_funcs(modules: typed.modules, registry: registry, read_only_params_index: emit_info.read_only_params_index)
  let workflow_default_diags = validate_workflow_param_defaults(workflow_funcs: workflow_funcs)
  if workflow_default_diags |> count > 0 {
    return v1.compiler.emit_core_support.EmitResult { files: [], diagnostics: workflow_default_diags }
  }
  let svc_module_map = typed.modules |> fold(init: empty_map(), f: (acc, tm) =>
    let svc_items = tm.items |> filter(item => v1.compiler.emit_core_support.is_service_item(item: item))
    let mod_filename = v1.compiler.emit_core_support.module_to_filename(name: v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module))
    svc_items |> fold(init: acc, f: (a, svc) =>
      map_insert(a, v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: svc), mod_filename)
    )
  )
  let test_projections = v1.compiler.emit_core_support.extract_test_projections(typed: typed)
  let export_sets = build_module_export_sets(modules: typed.modules)
  let module_index = build_module_index(modules: typed.modules)
  let unlisted_type_names_by_module = group_unlisted_type_names(diags: typed.diagnostics)
  let module_files = typed.modules |> map(tm => emit_module_full(typed_module: tm, registry: registry, emit_info: emit_info, shared_types: shared_types, svc_module_map: svc_module_map, data_items: data_items, export_sets: export_sets, typed_modules: typed.modules, module_index: module_index, unlisted_type_names: match map_get(unlisted_type_names_by_module, v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)) { Present { value: v } => v  Absent => [] }))
  let test_files = typed.modules
    |> map(tm => emit_test_file(
      module_name: v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module),
      projections: test_projections |> filter(p => p.module_name == v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module))))
    |> filter(f => string_length(s: f.content) > 0)
  let has_services = v1.compiler.emit.has_service_items(typed: typed)
  let has_pipeline = typed.modules |> any(m => v1.std.core.authored_name_at(source_indices: m.type_env.source_indices, node: m.module) == "v1.compiler.compile")
  let crate_name = if has_pipeline { "v1_compiler" } else { "v1_compiled" }
  let cargo = emit_cargo_toml(crate_name: crate_name, has_services: has_services)
  let main_file = emit_main_rs(workflow_funcs: workflow_funcs, modules: typed.modules, has_services: has_services, crate_name: crate_name, svc_module_map: svc_module_map)
  let rt_file = emit_v2_rt_module()
  let compiler_tests_file = if has_pipeline { [emit_compiler_tests_module()] } else { [] }
  let dry_run_file = if has_services {
    [emit_dry_run_module()]
  } else {
    []
  }

  let v2_std_text_stub = if module_files_reference_v2_std_text(files: module_files)
    && !module_files_include_v2_std_text(files: module_files) {
    [emit_v2_std_text_closure_stub_module()]
  } else {
    []
  }
  let v2_std_integer_stub = if module_files_reference_v2_std_integer(files: module_files)
    && !module_files_include_v2_std_integer(files: module_files) {
    [emit_v2_std_integer_closure_stub_module()]
  } else {
    []
  }
  let all_mod_files = concat(module_files, v2_std_text_stub, v2_std_integer_stub, [rt_file], dry_run_file)
  let lib_file = emit_lib_rs_from_files(all_module_files: all_mod_files, has_compiler_tests: has_pipeline)
  let emitted_files = concat([cargo, lib_file, main_file], all_mod_files, compiler_tests_file, test_files)
  let population_manifest = emit_emitted_population_manifest(files: emitted_files)
  let files = concat(emitted_files, [population_manifest])
  v1.compiler.emit_core_support.EmitResult { files: files, diagnostics: [] }
}

// THE EMITTER DECLARES THE POPULATION IT PRODUCED. This is the one place in the repository
// where that fact exists as a value: `files` below is the complete emitted population, typed,
// before anything reaches disk. It was then DISCARDED, and every downstream consumer rebuilt
// it from whatever residue it could see -- lib.rs, the "Generated by v1 compiler" banner, the
// complement of the crate-layout claim, a directory listing. Those reconstructions disagree
// exactly during drift, which is the root the manifest closes: one authority, N derivations.
//
// lib.rs is NOT this fact and never was. It is one PROJECTION of the same value -- the
// top-level pub-mod block of one crate -- which is why nine live stage0 modules are absent
// from it (reached by `mod` from a parent, by `#[path]` from another crate, or by a non-pub
// `mod`). The manifest is a second projection of that value, and a total one.
//
// DECLARED UNFILTERED, deliberately. Every path the emit produced, not "the generated ones".
// Consumers cut it to their own question (`required_regen_host` drops non-.rs and
// hand-maintained; the lifecycle scaffold wants a different cut). Filtering at the write would
// bake one consumer's question into the fact and guarantee the next consumer reconstructs --
// which is the failure this exists to end.
//
// The manifest LISTS ITSELF, because the emitter does produce it. That is a fixed point, not
// a circularity: the content is a function of the PATHS, and the manifest's own path is known
// before its content is rendered, so a second emit over the same input yields identical bytes.
fn emitted_population_manifest_path() -> String {
  concat(rust_source_root(), gunbc.stage0_emitted_population_manifest.emitted_population_manifest_basename)
}

fn emit_emitted_population_manifest(files: std.types.List<v1.std.core.TextFile>) -> v1.std.core.TextFile {
  let declared = concat(files |> map(f => f.path), [emitted_population_manifest_path()])
  let lines = declared
    |> sort_by(path => path)
    |> map(path => concat(gunbc.stage0_emitted_population_manifest.emitted_population_manifest_line_prefix, path))
  v1.std.core.TextFile {
    path: emitted_population_manifest_path(),
    content: concat(
      lines |> join(separator: gunbc.stage0_emitted_population_manifest.emitted_population_manifest_line_separator),
      gunbc.stage0_emitted_population_manifest.emitted_population_manifest_line_separator
    )
  }
}

fn emit_v2_rt_module() -> v1.std.core.TextFile {
  v1.std.core.TextFile { path: concat(rust_source_root(), "v1_rt", rust_source_ext()), content: rust_runtime_source() }
}

fn emit_compiler_tests_module() -> v1.std.core.TextFile {
  v1.std.core.TextFile { path: concat(rust_source_root(), "compiler_tests", rust_source_ext()), content: v1.compiler.compiler_tests_rust.compiler_tests_source() }
}

data closure_stub_reference_self_match_note: String = "The v2 closure-stub triggers scan EMITTED TEXT for a module reference, and the emitter's own emitted file contains every such pattern as a STRING LITERAL -- both the pattern being searched for and the use line being generated. So the predicate matched itself, and any crate containing the emitter emitted stubs for modules nothing actually used. This was latent, not new: the deleted corpus_repr_is_faithful conjunct happened to be false on the seed regen closure and suppressed the self-match there, so removing the corpus mode surfaced it as a fail-closed emission-plan refusal rather than as wrong output. Anchoring on a leading newline discriminates a real emitted use line (line start) from the emitter's literal (always preceded by a quote). WHAT THIS DOES NOT DO: it does not climb the rung. The grain is still a text scan over emitted content, which cannot in general distinguish a program from the compiler that writes it; it only removes the one false-positive class that is decidable by anchoring. The stub's own dissolve-on stands unchanged -- derive the condition from the emitted reference SET, a produced structural fact, rather than re-scanning the output for it."

fn emitted_files_carry_use_line(files: std.types.List<v1.std.core.TextFile>, line: String) -> Bool {
  files |> any(f => string_contains(s: f.content, pattern: concat("\n", line)))
}

fn module_files_reference_v2_std_text(files: std.types.List<v1.std.core.TextFile>) -> Bool {
  emitted_files_carry_use_line(files: files, line: concat(rust_visibility_prefix(), "use crate::v2_std_text::"))
}

fn module_files_reference_v2_std_integer(files: std.types.List<v1.std.core.TextFile>) -> Bool {
  emitted_files_carry_use_line(files: files, line: concat(rust_visibility_prefix(), "use crate::v2_std_integer::"))
}

fn module_files_include_v2_std_text(files: std.types.List<v1.std.core.TextFile>) -> Bool {
  let expected = concat(rust_source_root(), "v2_std_text", rust_source_ext())
  files |> any(f => f.path == expected)
}

fn module_files_include_v2_std_integer(files: std.types.List<v1.std.core.TextFile>) -> Bool {
  let expected = concat(rust_source_root(), "v2_std_integer", rust_source_ext())
  files |> any(f => f.path == expected)
}

fn emit_v2_std_integer_closure_stub_module() -> v1.std.core.TextFile {
  v1.std.core.TextFile {
    path: concat(rust_source_root(), "v2_std_integer", rust_source_ext()),
    content: v1.compiler.closure_stub_v2_std_integer_rust.closure_stub_v2_std_integer_source()
  }
}

fn emit_v2_std_text_closure_stub_module() -> v1.std.core.TextFile {
  v1.std.core.TextFile {
    path: concat(rust_source_root(), "v2_std_text", rust_source_ext()),
    content: v1.compiler.closure_stub_v2_std_text_rust.closure_stub_v2_std_text_source()
  }
}

fn lib_rs_mod_name_from_file(f: v1.std.core.TextFile) -> String {
  let src_prefix_len = string_length(s: rust_source_root())
  let ext_len = string_length(s: rust_source_ext())
  let path_len = string_length(s: f.path)
  substring(s: f.path, start: src_prefix_len, end: path_len - ext_len)
}

data hand_maintained_map_key_required_type_names_note: String = "v1_map_key_required_type_names discovers a declared type's map-key Hash+Eq requirement by scanning .dag-source-visible type-expression positions (declared fields, fn params/returns, alias right-hand sides) — a type used as a map key only inside HAND-MAINTAINED Rust is invisible to that scan by construction. src/v1/stage0/src/coproduct_reflection.rs declares `StdHashMap<(Vec<String>, ItemKind), (Vec<ParsedTypeDecl>, usize)>`, a map keyed on a tuple containing ItemKind, requiring ItemKind: Hash + Eq — no .dag declaration anywhere positions ItemKind as a map key, so the scan alone drops the derive on every regen. This roster is the declared complement: caller-supplied extra roots fed into the SAME fixpoint the scan seeds, not a derive override or a special case inside the generic mechanism. Grows only when a new hand-maintained consumer requires it, cited here at the point of use."

data hand_maintained_map_key_required_type_names: std.types.List<String> = ["ItemKind"]

// ONE role, TWO projections. Being a macro provider decides both how the module is
// RENDERED (`#[macro_use]`) and where it is ORDERED (ahead of its consumers), and the
// two were independently written comparisons against the same literal until this
// consolidation — so a second provider could have been added to one and missed by the
// other, or a module ordered first while rendered as an ordinary `pub mod`. That is a
// smaller copy of the very disagreement this emitter's membership repair removed.
fn emit_lib_rs_mod_decl(mod_name: String) -> String {
  let declaration = concat(rust_visibility_prefix(), rust_items().module_keyword, " ", mod_name, ";")
  if is_lib_rs_macro_provider(mod_name: mod_name) {
    concat("#[macro_use]\n", declaration)
  } else {
    declaration
  }
}

// A macro provider must be DECLARED before the modules invoking its macros: the
// generated dispatch module defines `macro_rules!` arms that v1_interpreter calls
// unqualified, and textual macro scope begins at the definition point and runs
// forward. So declaration order is a rendering constraint with real semantics, and
// it is derived here rather than left to fall out of emitted-file order.
fn is_lib_rs_macro_provider(mod_name: String) -> Bool {
  mod_name == "v1_interpreter_dispatch_generated"
}

// Stage0 only: the dispatch module is co-produced by a different emitter, so the
// admitted hand-maintained block owns its declaration (and already places it ahead
// of v1_interpreter). Dropping it from the derived names keeps it from appearing twice.
fn order_lib_rs_mod_names(mod_names: std.types.List<String>) -> std.types.List<String> {
  mod_names |> filter(n => !is_lib_rs_macro_provider(mod_name: n))
}

fn order_partial_lib_rs_mod_names(mod_names: std.types.List<String>) -> std.types.List<String> {
  concat(
    mod_names |> filter(n => is_lib_rs_macro_provider(mod_name: n)),
    mod_names |> filter(n => !is_lib_rs_macro_provider(mod_name: n))
  )
}

// TWO DIMENSIONS, kept apart. MEMBERSHIP is the emitted file population; ORDER is
// the macro-provider-before-consumer constraint above.
//
// They used to be fused, and wrongly: the derived names filtered the dispatch module
// out, then a hand-authored string appended it back UNCONDITIONALLY. For the stage0
// crate that module is real, so the seed compiled and the fork stayed invisible —
// but every other emitted crate got a declaration for a module nobody materialized,
// which is E0583. It surfaced on the falsifier's wet witnesses, whose lib.rs is a
// dozen lines: two of them died on the missing module before reaching the behaviour
// they exist to measure. A partial crate now declares exactly what this emit produced.
fn emit_lib_rs_from_files(all_module_files: std.types.List<v1.std.core.TextFile>, has_compiler_tests: Bool) -> v1.std.core.TextFile {
  let file_derived_names = all_module_files |> map(lib_rs_mod_name_from_file)
  let mod_names = if has_compiler_tests {
    order_lib_rs_mod_names(mod_names: file_derived_names)
  } else {
    order_partial_lib_rs_mod_names(mod_names: file_derived_names)
  }
  let mod_decls = mod_names |> map(emit_lib_rs_mod_decl)

  let hand_maintained_mods = if has_compiler_tests {
    gunbc.stage0_crate_layout_generated.generated_pub_mod_block
  } else {
    ""
  }
  let test_mod = if has_compiler_tests {
    "\n\n#[cfg(test)]\nmod compiler_tests;"
  } else {
    ""
  }
  let shared_types = emit_non_empty_wrappers()
  let content = concat("// Generated by v1 compiler -- do not edit.\n\n",
    "#![allow(unused_imports, unused_variables, unused_mut, unused_parens, dead_code, non_shorthand_field_patterns, suspicious_double_ref_op, clippy::all)]\n#![deny(unreachable_patterns)]\n",

    "#![recursion_limit = \"256\"]\n\n",
    "use im::\{OrdSet as BTreeSet, Vector as Vec\};\n\n",
    mod_decls |> join(separator: "\n"),
    hand_maintained_mods,
    "\n\n", shared_types,
    test_mod)
  v1.std.core.TextFile { path: concat(rust_source_root(), "lib", rust_source_ext()), content: concat(content, "\n") }
}

fn emit_module(typed_module: v1.compiler.infer_items.TypedModule, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>) -> v1.std.core.TextFile {
  let base_info = v1.compiler.infer.build_emit_graph_info(modules: [typed_module])
  let shared = build_shared_types(type_summaries: base_info.type_summaries, recursive_type_set: base_info.recursive_type_set, target: v1.compiler.artifact.Rust)
  let clone_bounded = v1.compiler.trait_derive_emit.v1_clone_bounded_type_params(
    type_decl_items: base_info.type_decl_items,
    source_indices: merged_module_source_indices(modules: [typed_module])
  )
  let map_key_required = v1.compiler.trait_derive_emit.v1_map_key_required_type_names(
    seed_type_exprs: v1_map_key_seed_type_exprs(modules: [typed_module], type_decl_items: base_info.type_decl_items, source_indices: merged_module_source_indices(modules: [typed_module])),
    extra_seed_names: hand_maintained_map_key_required_type_names,
    type_decl_items: base_info.type_decl_items,
    source_indices: merged_module_source_indices(modules: [typed_module])
  )
  let clone_impl_required = v1.compiler.trait_derive_emit.v1_clone_impl_required_type_params(
    type_decl_items: base_info.type_decl_items,
    source_indices: merged_module_source_indices(modules: [typed_module])
  )
  let emit_info = v1.compiler.infer_emit_info.EmitGraphInfo {
    type_summaries: base_info.type_summaries,
    type_decl_items: base_info.type_decl_items,
    fn_decl_items: base_info.fn_decl_items,
    recursive_type_set: base_info.recursive_type_set,
    fielded_variants: base_info.fielded_variants,
    positional_payload_variants: base_info.positional_payload_variants,
    shared_types: shared,
    ownership_index: base_info.ownership_index,
    movable: base_info.movable,
    variant_to_enum: base_info.variant_to_enum,
    owned_bindings: empty_set(),
    read_only_params_index: base_info.read_only_params_index,
    read_only_params: empty_set(),
    clone_bounded_type_params: clone_bounded,
    map_key_required_type_names: map_key_required,
    clone_impl_required_type_params: clone_impl_required,
    fn_generic_param_names: base_info.fn_generic_param_names,
    fn_type_env: base_info.fn_type_env,
    fn_return_type: none
  }
  let shared_types = emit_info.shared_types
  let export_sets = build_module_export_sets(modules: [typed_module])
  let module_index = build_module_index(modules: [typed_module])
  emit_module_full(typed_module: typed_module, registry: registry, emit_info: emit_info, shared_types: shared_types, svc_module_map: empty_map(), data_items: build_data_item_index(modules: [typed_module]), export_sets: export_sets, typed_modules: [typed_module], module_index: module_index, unlisted_type_names: [])
}

fn build_module_export_sets(modules: std.types.List<v1.compiler.infer_items.TypedModule>) -> std.types.Map<String, std.types.Map<String, Bool>> {
  modules |> fold(init: empty_map(), f: (acc, tm) =>
    let m_name = v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)
    let exported = v1.compiler.resolve.get_exported_names(module: tm.module, source_indices: tm.type_env.source_indices)
    let exported_set = exported |> fold(init: empty_map(), f: (inner, n) => map_insert(inner, n, true))
    map_insert(acc, m_name, exported_set)
  )
}

fn emit_inferred_type_leaf_name(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  match n.inferred {
    Present { value: v1.std.core.Resolved { node: rt } } =>
      let is_optional = rt.return_cardinality == v1.std.core.CardOptional
      if is_optional {
        v1.std.core.authored_name_at(source_indices: source_indices, node: v1.std.core.with_required_cardinality(n: rt))
      } else { v1.std.core.authored_name_at(source_indices: source_indices, node: rt) }
    _ => ""
  }
}

fn anonymous_record_lit_surface_name(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>) -> String {
  let lit_field_names = n.children |> map(f => v1.std.core.field_init_node_name_at(n: f, source_indices: source_indices))
  let field_type_hints = fold(n.children, init: empty_map(), f: (acc, f) =>
    let fname = v1.std.core.field_init_node_name_at(n: f, source_indices: source_indices)
    let fval = v1.std.core.field_init_node_value(n: f)
    match fval.inferred {
      Present { value: v1.std.core.Resolved { node: type_node } } =>
        map_insert(acc, fname, v1.std.core.authored_name_at(source_indices: source_indices, node: type_node))
      _ => acc
    }
  )
  match find_struct_name_by_fields(field_names: lit_field_names, field_type_hints: field_type_hints, type_summaries: type_summaries) {
    Present { value: sn } => sn
    Absent =>
      match find_unique_struct_name_by_fields(field_names: lit_field_names, type_summaries: type_summaries) {
        Present { value: sn } => sn
        Absent =>
          let rt = resolved_type(n: n)
          let rt_name = v1.std.core.authored_name_at(source_indices: source_indices, node: rt)
          if rt.ident_span != none && map_contains_key(type_summaries, rt_name) { rt_name } else { "" }
      }
  }
}

fn record_lit_variant_payload_struct_surfaces(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, variant_to_enum: std.types.Map<String, String>) -> std.types.List<String> {
  let variant_name = match v1.std.core.record_lit_type_name_at(texpr: n, source_indices: source_indices) {
    Present { value: v } => v
    Absent => v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  }
  if variant_name == "" { [] } else {
    let enum_name = match map_get(variant_to_enum, variant_name) {
      Present { value: e } => e
      Absent => ""
    }
    if enum_name == "" { [] } else {
      match map_get(type_summaries, v1.compiler.infer_emit_info.variant_summary_key(enum_name: enum_name, variant_name: variant_name)) {
        Present { value: summary } =>
          map_values(summary.field_type_map) |> filter(ft =>
            ft != "" && match map_get(type_summaries, ft) {
              Present { value: fts } =>
                match fts.repr {
                  StructRepr => true
                  _ => false
                }
              Absent => false
            }
          )
        Absent => []
      }
    }
  }
}

fn record_lit_field_type_hints(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> std.types.Map<String, String> {
  fold(n.children, init: empty_map(), f: (acc, f) =>
    let fname = v1.std.core.field_init_node_name_at(n: f, source_indices: source_indices)
    let fval = v1.std.core.field_init_node_value(n: f)
    match fval.inferred {
      Present { value: v1.std.core.Resolved { node: type_node } } =>
        map_insert(acc, fname, v1.std.core.authored_name_at(source_indices: source_indices, node: type_node))
      _ => acc
    }
  )
}

fn record_lit_resolved_ctor_import_names(type_name: String, n: v1.std.core.Node, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> std.types.List<String> {
  let from_template = match std.types.container_template_algebra(name: type_name) {
    Present { value: algebra } => if algebra != "" && algebra != type_name { [algebra] } else { [] }
    Absent => []
  }
  let from_fields = if type_name != "" {
    let lit_field_names = n.children |> map(f => v1.std.core.field_init_node_name_at(n: f, source_indices: source_indices))
    let field_type_hints = record_lit_field_type_hints(n: n, source_indices: source_indices)
    match find_struct_name_by_fields(field_names: lit_field_names, field_type_hints: field_type_hints, type_summaries: type_summaries) {
      Present { value: sn } => if sn != "" && sn != type_name { [sn] } else { [] }
      Absent =>
        match find_unique_struct_name_by_fields(field_names: lit_field_names, type_summaries: type_summaries) {
          Present { value: sn } => if sn != "" && sn != type_name { [sn] } else { [] }
          Absent => []
        }
    }
  } else { [] }
  v1.compiler.emit_core_support.unique_strings(items: concat(from_template, from_fields))
}

fn record_lit_ref_names(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, variant_to_enum: std.types.Map<String, String>) -> std.types.List<String> {
  match n.expr_data {
    ExprRecordLit { parent_enum: pe } =>
      let tn_list = match v1.std.core.record_lit_type_name_at(texpr: n, source_indices: source_indices) {
        Present { value: t } => if t != "" { [t] } else { [] }
        Absent =>
          let inferred = emit_inferred_type_leaf_name(n: n, source_indices: source_indices)
          if inferred != "" { [inferred] } else {
            let anon = anonymous_record_lit_surface_name(n: n, source_indices: source_indices, type_summaries: type_summaries)
            if anon != "" { [anon] } else { [] }
          }
      }
      let ctor_names = tn_list |> flat_map(t => record_lit_resolved_ctor_import_names(type_name: t, n: n, type_summaries: type_summaries, source_indices: source_indices))
      let pe_list = match pe {
        Present { value: p } => if p != "" { [p] } else { [] }
        Absent => []
      }
      let payload_structs = record_lit_variant_payload_struct_surfaces(n: n, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)
      v1.compiler.emit_core_support.unique_strings(items: concat(concat(concat(tn_list, ctor_names), pe_list), payload_structs))
    _ => []
  }
}

data emitter_attested_anonymous_head_note: String = "ROOT-3 THIRD ATTESTATION ARM (board row 3, materialization_carriers 51-site census): an ANONYMOUS record literal (no authored type name at the literal) is rendered by emit_typed_record_lit with a head the EMITTER decides — the resolved/inferred nominal type, or a fields-signature lookup — so the emitted text spells a name the authored source never does (compile_stage_memo `retention: \{...\}` renders `ProviderRetention \{ .. \}`). The authored-source text gate (reference_derived_candidate_authored) therefore refuses exactly the candidate whose use-line the emitted bytes need, and rustc reports E0422 on the head the emitter itself wrote. The correction is not a widened text gate: attestation for this class comes from the same decision chain the candidate proposer uses for the tn-Absent arm (emit_inferred_type_leaf_name when the summary is known, else anonymous_record_lit_surface_name — both already consulted by record_lit_ref_names), so the admitted set is precisely `heads the emitter will render for anonymous literals in this module's items`, never a deep-inferred over-collection (the AuthoredTokenOrdinal fabrication class enters via type-surface collection, not via this walk, and stays refused). Registry resolution, export proof, local-decl, kernel and already-imported filters all still apply downstream — this arm only replaces WHICH evidence attests the reference: the emitted occurrence rather than an authored spelling that structurally cannot exist. Dissolve-on: the same trigger the text gate declares (P2a candidate-producer / BoundReferenceProvider deriving use-lines from bound-reference structure)."

fn collect_anonymous_record_lit_heads(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>) -> std.types.List<String> {
  let self_head = match n.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      match v1.std.core.record_lit_type_name_at(texpr: n, source_indices: source_indices) {
        Present { value: _ } => []
        Absent =>
          let inferred = emit_inferred_type_leaf_name(n: n, source_indices: source_indices)
          if inferred != "" && map_contains_key(type_summaries, inferred) { [inferred] } else {
            let anon = anonymous_record_lit_surface_name(n: n, source_indices: source_indices, type_summaries: type_summaries)
            if anon != "" { [anon] } else { [] }
          }
      }
    _ => []
  }
  let list_fields = concat(
    concat(
      n.children |> flat_map(c => collect_anonymous_record_lit_heads(n: c, source_indices: source_indices, type_summaries: type_summaries)),
      n.params |> flat_map(c => collect_anonymous_record_lit_heads(n: c, source_indices: source_indices, type_summaries: type_summaries))
    ),
    concat(
      n.uses |> flat_map(c => collect_anonymous_record_lit_heads(n: c, source_indices: source_indices, type_summaries: type_summaries)),
      n.properties |> flat_map(c => collect_anonymous_record_lit_heads(n: c, source_indices: source_indices, type_summaries: type_summaries))
    )
  )
  let opt_fields = concat(
    match n.body { Present { value: b } => collect_anonymous_record_lit_heads(n: b, source_indices: source_indices, type_summaries: type_summaries)  Absent => [] },
    concat(
      match n.transport { Present { value: t } => collect_anonymous_record_lit_heads(n: t, source_indices: source_indices, type_summaries: type_summaries)  Absent => [] },
      match n.type_annotation { Present { value: t } => collect_anonymous_record_lit_heads(n: t, source_indices: source_indices, type_summaries: type_summaries)  Absent => [] }
    )
  )
  concat(self_head, concat(list_fields, opt_fields))
}

fn collect_items_field_import_surface_names(items: std.types.List<v1.std.core.Node>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> std.types.List<String> {
  let type_summaries = emit_info.type_summaries
  let variant_to_enum = emit_info.variant_to_enum
  v1.compiler.emit_core_support.unique_strings(items: items |> flat_map(item =>
    collect_item_emit_surface_names(item: item, source_indices: source_indices, emit_info: emit_info)
      |> flat_map(type_name =>
        let summary_lookup = match map_get(type_summaries, type_name) {
          Present { value: summary } => Present { value: summary }
          Absent =>
            match map_get(variant_to_enum, type_name) {
              Present { value: enum_name } =>
                if enum_name == "" { none } else {
                  map_get(type_summaries, v1.compiler.infer_emit_info.variant_summary_key(enum_name: enum_name, variant_name: type_name))
                }
              Absent => none
            }
        }
        match summary_lookup {
          Present { value: summary } =>
            summary.field_import_surface_names |> filter(field_type =>
              field_type != "" && match map_get(type_summaries, field_type) {
                Present { value: ft } =>
                  match ft.repr {
                    StructRepr => true
                    _ => false
                  }
                Absent => false
              }
            )
          Absent => []
        }
      )
  ))
}

fn collect_value_ref_names(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, variant_to_enum: std.types.Map<String, String>) -> std.types.List<String> {
  let self_name = match n.expr_data {
    ExprVar { binding_kind: bk } =>
      match bk {
        Present { value: v1.std.core.FunctionValueBinding } =>
          let nm = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
          if nm != "" { [nm] } else { [] }
        _ => []
      }
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let nm = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
      if nm != "" { [nm] } else { [] }
    ExprRecordLit { parent_enum: _ } =>
      record_lit_ref_names(n: n, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)
    _ => []
  }
  let list_fields = concat(
    concat(
      n.children |> flat_map(c => collect_value_ref_names(n: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)),
      n.params |> flat_map(c => collect_value_ref_names(n: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum))
    ),
    concat(
      n.uses |> flat_map(c => collect_value_ref_names(n: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)),
      n.properties |> flat_map(c => collect_value_ref_names(n: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum))
    )
  )
  let opt_fields = concat(
    match n.body { Present { value: b } => collect_value_ref_names(n: b, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)  Absent => [] },
    concat(
      match n.transport { Present { value: t } => collect_value_ref_names(n: t, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)  Absent => [] },
      match n.type_annotation { Present { value: t } => collect_value_ref_names(n: t, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)  Absent => [] }
    )
  )
  concat(self_name, concat(list_fields, opt_fields))
}

fn collect_item_type_surface_names(item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> std.types.List<String> {
  let from_ann = match item.type_annotation {
    Present { value: t } => v1.compiler.infer_emit_info.collect_type_node_import_surface_names(n: t, source_indices: source_indices)
    Absent => []
  }
  let from_params = item.params |> flat_map(p =>
    v1.compiler.infer_emit_info.collect_type_node_import_surface_names(n: v1.std.core.param_node_type_expr(n: p), source_indices: source_indices)
  )
  let from_inferred = match item.inferred {
    Present { value: v1.std.core.Resolved { node: rt } } => v1.compiler.infer_emit_info.collect_type_node_import_surface_names(n: rt, source_indices: source_indices)
    _ => []
  }
  concat(from_ann, concat(from_params, from_inferred))
}

fn emit_scrutinee_type_name(scrutinee: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  emit_inferred_type_leaf_name(n: scrutinee, source_indices: source_indices)
}

fn collect_pattern_rc_prelude_parent_enums(pattern: v1.std.core.MatchPattern, scrut_type: String, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>) -> std.types.List<String> {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: _ } =>
      let bare_n = v1.std.core.qualified_last_segment(name: n)
      match pattern_parent_enum(name: bare_n, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: type_summaries) {
        Present { value: parent } => if parent != "" { [parent] } else { [] }
        Absent => []
      }
    _ => []
  }
}

fn collect_rc_pattern_prelude_parent_enums(pattern: v1.std.core.MatchPattern, rc_analysis: RcPatternAnalysis, scrut_type: String, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> std.types.List<String> {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      let bare_n = v1.std.core.qualified_last_segment(name: n)
      if is_optional_variant_name(name: bare_n) && is_optional_parent(parent_enum: parent_enum) {
        if fbs |> count == 1 {
          match fbs |> first {
            Present { value: fb } =>
              let inner_analysis = analyze_rc_pattern(pattern: v1.std.core.field_binding_pattern(n: fb), scrut_type: "", shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
              collect_rc_pattern_prelude_parent_enums(pattern: v1.std.core.field_binding_pattern(n: fb), rc_analysis: inner_analysis, scrut_type: "", shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
            Absent => []
          }
        } else { [] }
      } else {
        fbs |> flat_map(fb =>
          let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices)
          if fb_name == "0" {
            let payload_scrut = positional_payload_scrut_type(parent_enum: pattern_parent_enum(name: bare_n, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: emit_info.type_summaries), variant_name: bare_n, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
            let inner_analysis = analyze_rc_pattern(pattern: v1.std.core.field_binding_pattern(n: fb), scrut_type: payload_scrut, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
            collect_rc_pattern_prelude_parent_enums(pattern: v1.std.core.field_binding_pattern(n: fb), rc_analysis: inner_analysis, scrut_type: payload_scrut, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
          } else if field_needs_rc_ref(field_name: fb_name, rc_analysis: rc_analysis) {
            collect_pattern_rc_prelude_parent_enums(pattern: v1.std.core.field_binding_pattern(n: fb), scrut_type: "", type_summaries: emit_info.type_summaries)
          } else { [] }
        )
      }
    _ => []
  }
}

fn collect_match_pattern_parent_enums(expr: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> std.types.List<String> {
  match expr.expr_data {
    ExprMatch =>
      let scrut = v1.std.core.match_scrutinee(texpr: expr)
      let scrut_type = emit_scrutinee_type_name(scrutinee: scrut, source_indices: source_indices)
      let from_scrut = if scrut_type != "" { [scrut_type] } else { [] }
      let from_arms = v1.std.core.match_arm_nodes(texpr: expr) |> flat_map(arm =>
        let arm_pat = v1.std.core.arm_pattern(n: arm)
        let rc_analysis = analyze_rc_pattern(pattern: arm_pat, scrut_type: scrut_type, shared_types: emit_info.shared_types, emit_info: emit_info, source_indices: source_indices)
        concat(
          match arm_resolved_parent_enum(arm: arm, scrut_type: scrut_type, type_summaries: emit_info.type_summaries) {
            Present { value: parent } => if parent != "" { [parent] } else { [] }
            Absent => []
          },
          collect_rc_pattern_prelude_parent_enums(pattern: arm_pat, rc_analysis: rc_analysis, scrut_type: scrut_type, shared_types: emit_info.shared_types, source_indices: source_indices, emit_info: emit_info)
        )
      )
      v1.compiler.emit_core_support.unique_strings(items: concat(from_scrut, from_arms))
    _ => []
  }
}

fn variant_record_lit_summary_key(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>) -> String {
  match n.expr_data {
    ExprRecordLit { parent_enum: pe } =>
      let variant_name = match v1.std.core.record_lit_type_name_at(texpr: n, source_indices: source_indices) {
        Present { value: v } => v
        Absent => v1.std.core.authored_name_at(source_indices: source_indices, node: n)
      }
      let enum_name = match pe {
        Present { value: e } => e
        Absent =>
          match map_get(variant_to_enum, variant_name) {
            Present { value: p } => p
            Absent => ""
          }
      }
      if enum_name != "" && variant_name != "" {
        v1.compiler.infer_emit_info.variant_summary_key(enum_name: enum_name, variant_name: variant_name)
      } else { "" }
    _ => ""
  }
}

fn collect_record_lit_field_struct_surfaces(parent: v1.std.core.Node, field_init: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, variant_to_enum: std.types.Map<String, String>) -> std.types.List<String> {
  let field_name = v1.std.core.field_init_node_name_at(n: field_init, source_indices: source_indices)
  if field_name == "" { [] } else {
    let field_value = v1.std.core.field_init_node_value(n: field_init)
    match field_value.expr_data {
      ExprRecordLit { parent_enum: _ } =>
        let summary_key = variant_record_lit_summary_key(n: parent, source_indices: source_indices, variant_to_enum: variant_to_enum)
        if summary_key == "" { [] } else {
          match map_get(type_summaries, summary_key) {
            Present { value: summary } =>
              match map_get(summary.field_type_map, field_name) {
                Present { value: ft } =>
                  if ft != "" && match map_get(type_summaries, ft) {
                    Present { value: fts } =>
                      match fts.repr {
                        StructRepr => true
                        _ => false
                      }
                    Absent => false
                  } { [ft] } else { [] }
                Absent => []
              }
            Absent => []
          }
        }
      _ => []
    }
  }
}

fn collect_value_emit_type_surface_names(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> std.types.List<String> {
  let variant_to_enum = emit_info.variant_to_enum
  let type_summaries = emit_info.type_summaries
  let self_names = match n.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      record_lit_ref_names(n: n, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)
    ExprMatch => collect_match_pattern_parent_enums(expr: n, source_indices: source_indices, emit_info: emit_info)
    _ =>
      let from_inferred_list = match n.inferred {
        Present { value: v1.std.core.Resolved { node: rt } } =>
          let is_optional = rt.return_cardinality == v1.std.core.CardOptional
          let peeled_rt = if is_optional { v1.std.core.with_required_cardinality(n: rt) } else { rt }
          v1.compiler.infer_emit_info.collect_type_node_import_surface_names(n: peeled_rt, source_indices: source_indices)
        _ => []
      }
      let nm = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
      let from_variant = match map_get(variant_to_enum, nm) {
        Present { value: parent } => if parent != "" { [parent] } else { [] }
        Absent => []
      }
      v1.compiler.emit_core_support.unique_strings(items: concat(from_inferred_list, from_variant))
  }
  let child_names = match n.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      concat(
        n.children |> flat_map(c => collect_record_lit_field_struct_surfaces(parent: n, field_init: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)),
        n.children |> flat_map(c => collect_value_emit_type_surface_names(n: v1.std.core.field_init_node_value(n: c), source_indices: source_indices, emit_info: emit_info))
      )
    _ =>
      concat(
        concat(
          n.children |> flat_map(c => collect_value_emit_type_surface_names(n: c, source_indices: source_indices, emit_info: emit_info)),
          n.params |> flat_map(c => collect_value_emit_type_surface_names(n: c, source_indices: source_indices, emit_info: emit_info))
        ),
        concat(
          n.uses |> flat_map(c => collect_value_emit_type_surface_names(n: c, source_indices: source_indices, emit_info: emit_info)),
          n.properties |> flat_map(c => collect_value_emit_type_surface_names(n: c, source_indices: source_indices, emit_info: emit_info))
        )
      )
  }
  let opt_names = concat(
    match n.body { Present { value: b } => collect_value_emit_type_surface_names(n: b, source_indices: source_indices, emit_info: emit_info)  Absent => [] },
    concat(
      match n.transport { Present { value: t } => collect_value_emit_type_surface_names(n: t, source_indices: source_indices, emit_info: emit_info)  Absent => [] },
      match n.type_annotation { Present { value: t } => v1.compiler.infer_emit_info.collect_type_node_import_surface_names(n: t, source_indices: source_indices)  Absent => [] }
    )
  )
  v1.compiler.emit_core_support.unique_strings(items: concat(self_names, concat(child_names, opt_names)))
}

fn collect_item_emit_surface_names(item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> std.types.List<String> {
  let from_signature = collect_item_type_surface_names(item: item, source_indices: source_indices)
  let from_body = match item.body {
    Present { value: b } => collect_value_emit_type_surface_names(n: b, source_indices: source_indices, emit_info: emit_info)
    Absent => []
  }
  v1.compiler.emit_core_support.unique_strings(items: concat(from_signature, from_body))
}

fn provider_proven_exports_symbol(name: String, provider_module: String, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  name_in_transitive_export_surface(name: name, module_name: provider_module, visited: [], export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
}

fn imported_names_in_use_line(line: String) -> std.types.List<String> {
  if contains(line, "use ") == false {
    []
  } else {
    let after = match (line |> split(delimiter: "::")) |> last {
      Present { value: s } => s
      Absent => ""
    }
    let cleaned = replace(replace(replace(replace(after, "{", ""), "}", ""), ";", ""), "*", "")
    cleaned |> split(delimiter: ",") |> map(s => std.algebra.trim(s)) |> filter(s => s != "")
  }
}

data reference_derived_use_lines_note: String = "emit_import_closure_root (§5). emit_imports wires a per-module use-line only for names in an authored import list. Namespace-only resolution (post-PR 6848) references cross-module names WITHOUT importing them, so the ref is KNOWN but the use-line is declined (advisory UnlistedImportUse, is_error_diagnostic=false) — a §5 fail-open (⊤-as-ignorance) that emits invalid Rust (E0422/E0433/E0425 downstream). This pass derives the missing use-lines from the SAME resolver signal, split by reference kind onto its precise authority (§2 Realization: one closure, two consumers): (1) TYPE refs come from the resolver's UnlistedImportUse diagnostics (04_resolve.dag resolve_node, masked && not-in-SVN at type positions) threaded through ResolvedGraph.diagnostics — zero-drift by construction, the resolver already applied its SVN mask AT RESOLVE TIME; (2) VALUE-position refs come from collect_value_ref_names, a NARROW walk that structurally excludes the type over-collection classes (container heads, field labels, deep-inferred type names): fn/data refs (FunctionValueBinding ExprVar + ExprCall callee names) AND record-literal type constructions (ExprRecordLit type name + its parent_enum) — the latter matter because a GENERIC user type constructed as `T{..}` (e.g. RealizedStep<Nano>) is grounded by resolve_node (masked flips false into the defining-module descent) so it NEVER fires UnlistedImportUse, yet its bare `T` still needs a use-line; (3) TYPE-surface refs on item signatures come from collect_item_emit_surface_names (collect_item_type_surface_names + collect_value_emit_type_surface_names over data bodies) over each item's type_annotation, param types, inferred Resolved return/signature, AND value-position record-literal / variant-parent-enum surfaces the emitter will qualify (e.g. UriScheme::Https in a data anchor) — covering masked-at-resolve TYPE positions (e.g. partial-import return type PilotWidget) that never enter UnlistedImportUse and are not ExprVar/ExprCall harvests. Registry cross-module resolve + is_known_variant fallback keep variant constructors routed through their parent's import. CONSTRUCTION WALL (ROOT 3, §5): a candidate that registry-resolves to a provider module MUST also pass provider_proven_exports_symbol (name_in_transitive_export_surface) before any use-line is synthesized — never a plausible guess from the bare-name registry alone (the v1_rt::member fabrication class: registry homonym without export proof). NOTE the SVN authority is resolve-time-only: env.source_visible_names is built in 04_infer's unresolved_env and consumed by resolve_node, but is NOT persisted onto TypedModule.type_env (emit reads empty_map), so emit MUST NOT re-apply an SVN filter — it would be a no-op that (worse, when non-empty) diverges from the resolve-time mask. The union is instead already-imported filtered (a name already carried by an authored import / prelude / carrier use-line is skipped — this is what keeps a fully-imported SEED module zero-drift: its refs are all in an import line) and kernel filtered (no E0252 against the runtime prelude), then LOCAL-DECL filtered (any name the module itself declares — local_decl_names from authored_name_at over items, plus local_type_names aliases/phantoms — is never an import candidate: the containment tree binds a bare ref to the module's own declaration before any cross-module lookup, and the bare-name registry is last-write-wins, so a dual-tree homonym — dag/std List/Map/GroupCompletion vs their src/v2/std twins — steals the registry row and would otherwise synthesize a SELF-COLLIDING pub-use, the E0255 std_dup class measured on the 2026-07-22 curated 4-module baseline), then cross-module registry-resolved (a ref the registry maps to this same module is skipped), then reuses emit_specific_import_block for variant/reexport correctness with a §5 direct-emit fallback (arm (c): the name resolved via registry to provider AND export-proven). A candidate that registry-resolves to nothing, or resolves but fails export proof, is left unsynthesized (typed refusal at step-2 is future work); it never fabricates a use-line. SCOPE (emit_module_full): import-free modules run the full union (TYPE unlisted + VALUE refs) — the namespace-resolution case the post-PR-6848 regression is about. SUPERSEDED-MECHANISM, THIS CUT (eager-deer-389): the two sentences that follow describe the corpus_repr_is_faithful / HostNative gate, which NO LONGER EXISTS -- RustCorpusRepr and both its variants are deleted and the gate is gone, so import-bearing modules are no longer split by corpus mode. They are retained as the history of WHY the walk was gated at all (the spurious-use-line and seed zero-drift hazards below are real and still constrain any future gating), not as a live description; reference_use_lines_representation_invariant_note in this module carries the post-cut statement. Read them as quarry. AS WRITTEN BEFORE THE CUT: Import-bearing modules run reference_derived_use_lines ONLY when corpus_repr_is_faithful (FaithfulFreeMonoid / v2 namespace corpus): a partial-import namespace module (e.g. v2.std.node_query importing Outcome but calling outcome_with_diagnostics, or importing Outcome but annotating NamedEdgeTargetLookup) must synthesize BOTH the missing fn-value use-line AND the missing type use-line without duplicating names emit_imports already owns. HostNative import-bearing modules (v1 seed) get [] — running the walk there adds spurious/wrong use-lines (registry homonyms like kernel_span/is_type_variable) and breaks zero-drift seed regen."

fn expand_variant_payload_struct_imports(names: std.types.List<String>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, variant_to_enum: std.types.Map<String, String>) -> std.types.List<String> {
  names |> flat_map(n =>
    match map_get(variant_to_enum, n) {
      Present { value: enum_name } =>
        if enum_name == "" { [] } else {
          match map_get(type_summaries, v1.compiler.infer_emit_info.variant_summary_key(enum_name: enum_name, variant_name: n)) {
            Present { value: summary } =>
              map_values(summary.field_type_map) |> filter(ft =>
                ft != "" && match map_get(type_summaries, ft) {
                  Present { value: fts } =>
                    match fts.repr {
                      StructRepr => true
                      _ => false
                    }
                  Absent => false
                }
              )
            Absent => []
          }
        }
      Absent => []
    }
  )
}

data reference_derived_authored_source_gate_note: String = "reference_derived_use_lines synthesizes a use-line only for an ATTESTED candidate: two authored-source-text forms decided by reference_derived_candidate_authored (NewlineIndex char_codes), plus one emitter-attested form decided by collect_anonymous_record_lit_heads (emitter_attested_anonymous_head_note — a head the emitter itself renders for an anonymous record literal, which the authored text structurally cannot spell). Direct: the candidate's own name is spelled. Variant-induced: the candidate is a unit-only enum and the module spells at least one variant that binds UNAMBIGUOUSLY back to it — derive_variant_to_enum maps a variant shared by two enums to the empty string, so a homonym never equals the enum name and is REFUSED rather than picked. A name that enters the candidate set only via inferred/type-summary over-collection — attested by neither form — must not become a pub use. Empty/unavailable module source REFUSES every candidate (fail-closed): ⊤-as-ignorance must not admit the full candidate set (§5 absorbing fallback). Receipt: after occurrence-binding stage0 enrollment, AuthoredTokenOrdinal entered the registry and std.http_path (which never mentions it) emitted a fabricated pub use — that name is a record, not a unit-only enum, so the variant-induced arm cannot readmit it. Second receipt (Root K): the emitter qualifies variants as Parent::Variant in pattern and nested-argument positions where the source spells only the variant, so asking whether the PARENT was spelled refused a parent the module demonstrably uses — 109 of 132 sites. UnlistedImportUse names are already spelled at the use site, so they pass when source text is readable. Declared residue, in two classes that fail at DIFFERENT stages — this gate is a filter over a candidate set, so it can only refuse, never propose. Refused HERE: a parent enum with neither its own name nor any binding variant spelled, and a non-enum candidate whose only evidence is over-collection. Never REACHING here, and therefore unfixable by any gate decision: a name the candidate collector never proposes. Measured by execution — forcing this gate to admit unconditionally and re-emitting v2.lens.complexity_accumulator_copy.analyze still produces no use-line for Behavior, whose unit-only variant Transform is spelled bare in a pattern position and binds unambiguously, so the arm's preconditions hold and the name is simply absent upstream. That class is pre-existing and unchanged by Root K (identical count in both arms), and it is where the remaining sites live: widening this gate further cannot reach them. Dissolve-on: derive use-lines from the module's bound-reference structure (P2a candidate-producer / BoundReferenceProvider) — this text-attestation gate is the conservative interim, not the destination."

fn module_authored_source_text(module: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  match map_get(source_indices, module.span.file) {
    Present { value: index } => chars_to_string(chars: index.char_codes, start: 0, end: index.char_codes |> count)
    Absent => ""
  }
}

fn reference_derived_candidate_spelled_in_module(module_source: String, name: String) -> Bool {
  module_source != "" && string_contains(s: module_source, pattern: name)
}

data host_realized_builtin_needs_no_import_note: String = "A derived use-line must name a provider the EMITTED code actually paths into, and a host-realized builtin is not one. emit_typed_call intercepts a family of free calls by name -- to_string, discriminant, get, with, empty_set among them -- and renders each as a host expression: to_string(value: e) becomes (e.clone()).to_string(), the Rust METHOD, never a path to v1.compiler.emit_core_support. So the SOURCE reference is real and resolves to a real provider module, while the EMITTED module never mentions that provider. Importing it is dead in a single-crate build and FATAL under the seven-crate stage0 partition, where the provider is not even a member of the consuming crate -- which is exactly how this surfaced: E0432 unresolved import crate::v1_compiler_emit_core_support in v1-stage0-std-core, from a `pub use` this derivation emitted for v1.std.core's to_string calls. Two authorities are READ rather than duplicated, and both answer the same question -- does this name's emitted form contain a path to another module. v1.compiler.infer_method builtin_function_registry: a name it resolves is a host builtin, realized as a host expression. std.types is_container_type: List, Set and Map are structural containers rendered inline as Vec and HashMap, so a `pub use crate::std_types::` List-and-Map re-export names a provider the emitted code never paths into either -- dead in one crate, and E0432 in v1-stage0-emit-core where std_types is a member of v1-stage0-extdeps-languages instead. That second half is the same defect one level out: the first filter fixed a host-realized CALL, this one a host-realized TYPE, and the shared property is realization-without-a-path rather than anything about calls or types. LATENT, NOT NEW: import-free modules always received derived use-lines, so the defect predates this cut; deleting the corpus_repr gate merely extended the derivation to import-bearing modules, where v1.std.core is the first member to carry an intercepted free call. CEILING: the roster this consults covers five of the eight names the call emitter intercepts (empty_map, map and utf8_decode_bytes are absent from it), so a module that both references one of those three across a module boundary AND lands in a different partition crate would still refuse. None exists today. The right terminal shape is the one the closure-stub note already names -- derive use-lines from the EMITTED reference set rather than from source references, which needs no roster of intercepts at all because an intercepted call emits no path."

fn reference_is_host_realized_builtin(name: String) -> Bool {
  v1.compiler.infer_method.infer_builtin_call_type(name: name) != none || is_container_type(name: name)
}

// WHY the authored-source gate has a second arm for parent enums.
//
// The gate asks whether a candidate name is spelled in the module. For a PARENT ENUM that is the
// wrong question: the emitter qualifies a variant by its parent (Parent::Variant, via
// rust_variant_path and the variant-ctor emit path) at sites where the .dag source
// spells only the VARIANT — a bare match arm on Accepted, a nested construction of Unavailable.
// The parent is then never in the module text, so its use-line was refused and the emitted
// Parent::Variant had no import.
//
// The gate is therefore not relaxed; the question is corrected. A parent-enum candidate is admitted
// when an authored VARIANT of that same enum is spelled, and only on the UNAMBIGUOUS binding:
// derive_variant_to_enum maps a variant name shared by two enums to the empty string, so a homonym
// variant admits NEITHER enum rather than picking one — fail-closed, no plausible guess.
//
// Residue, declared not hidden: a corpus-wide ambiguous variant leaves its parent unimported even
// where the emitter qualifies it from the scrutinee type, and a parent reached by neither its own
// spelling nor an unambiguous authored variant stays unsynthesized. Both refuse rather than
// fabricate. This arm carries no dissolution condition of its own — it dissolves with the text gate
// it corrects, on the trigger reference_derived_authored_source_gate_note already declares.

fn reference_derived_variant_induced_parent_spelled(module_source: String, enum_name: String, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, variant_to_enum: std.types.Map<String, String>) -> Bool {
  match map_get(type_summaries, enum_name) {
    Present { value: summary } =>
      match summary.repr {
        EnumRepr { unit_only: _ } =>
          sorted_map_keys(summary.variant_name_set) |> any(vn =>
            match map_get(variant_to_enum, vn) {
              Present { value: parent } => parent == enum_name && reference_derived_candidate_spelled_in_module(module_source: module_source, name: vn)
              Absent => false
            }
          )
        _ => false
      }
    Absent => false
  }
}

fn reference_derived_candidate_authored(module_source: String, name: String, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, variant_to_enum: std.types.Map<String, String>) -> Bool {
  reference_derived_candidate_spelled_in_module(module_source: module_source, name: name)
    || reference_derived_variant_induced_parent_spelled(module_source: module_source, enum_name: name, type_summaries: type_summaries, variant_to_enum: variant_to_enum)
}

// The authored prefix of a dotted reference IS its provider module: re-looking the bare
// leaf up in the bare-keyed registry is last-write-wins across the whole pool, so a
// v1.std.core.Node reference resolved to v2.std.node and the synthesized use-line
// imported the wrong Node. The registry is consulted only for a genuinely bare name.
fn reference_provider_module(name: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>) -> String {
  let leaf = v1.std.core.qualified_last_segment(name: name)
  if leaf != name {
    v1.std.core.qualified_module_prefix(name: name)
  } else {
    match map_get(registry, name) {
      Present { value: info } => info.module_name
      Absent => ""
    }
  }
}

fn reference_derived_use_lines(items: std.types.List<v1.std.core.Node>, unlisted_type_names: std.types.List<String>, this_module_name: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, local_type_names: std.types.List<String>, already_imported_names: std.types.List<String>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> std.types.List<String> {
  {
    let module_source = match typed_modules |> filter(tm => v1.std.core.authored_name_at(source_indices: source_indices, node: tm.module) == this_module_name) |> first {
      Present { value: tm } => module_authored_source_text(module: tm.module, source_indices: source_indices)
      Absent => ""
    }
    let value_names = v1.compiler.emit_core_support.unique_strings(items: items |> flat_map(item => collect_value_ref_names(n: item, source_indices: source_indices, type_summaries: emit_info.type_summaries, variant_to_enum: emit_info.variant_to_enum)))
    let type_surface_names = v1.compiler.emit_core_support.unique_strings(items: items |> flat_map(item => collect_item_emit_surface_names(item: item, source_indices: source_indices, emit_info: emit_info)))
    let field_surface_names = collect_items_field_import_surface_names(items: items, emit_info: emit_info, source_indices: source_indices)
    let variant_payload_structs = expand_variant_payload_struct_imports(names: type_surface_names, type_summaries: emit_info.type_summaries, variant_to_enum: emit_info.variant_to_enum)
    let emitter_attested_anon_heads = v1.compiler.emit_core_support.unique_strings(items: items |> flat_map(item => collect_anonymous_record_lit_heads(n: item, source_indices: source_indices, type_summaries: emit_info.type_summaries)))
    let candidates = v1.compiler.emit_core_support.unique_strings(items: concat(concat(concat(concat(unlisted_type_names, value_names), type_surface_names), field_surface_names), variant_payload_structs))
      |> filter(name =>
        reference_derived_candidate_authored(module_source: module_source, name: name, type_summaries: emit_info.type_summaries, variant_to_enum: emit_info.variant_to_enum)
          || emitter_attested_anon_heads |> any(h => h == name))
      |> filter(name => !reference_is_host_realized_builtin(name: name))
    let local_decl_names = items |> flat_map(item =>
      let nm = v1.std.core.authored_name_at(source_indices: source_indices, node: item)
      if nm == "" { [] } else { [nm] }
    )
    let already = concat(already_imported_names, concat(local_type_names, local_decl_names))
      |> fold(init: empty_map(), f: (acc, nm) => map_insert(acc, nm, true))
    let unlisted = candidates |> flat_map(name =>
      let leaf = v1.std.core.qualified_last_segment(name: name)
      let provider = reference_provider_module(name: name, registry: registry)
      if v1.compiler.infer_types.emit_map_has(m: already, key: leaf) || is_kernel_type(name: leaf) {
        []
      } else if provider != "" && provider != this_module_name
        && provider_proven_exports_symbol(name: leaf, provider_module: provider, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
      { [name] } else { [] }
    )
    let providers = v1.compiler.emit_core_support.unique_strings(items: unlisted
      |> map(name => reference_provider_module(name: name, registry: registry))
      |> filter(m => m != ""))
    providers |> flat_map(provider =>
      let names = unlisted
        |> filter(name => reference_provider_module(name: name, registry: registry) == provider)
        |> map(name => v1.std.core.qualified_last_segment(name: name))
      let block = emit_specific_import_block(import_module: provider, mod_name: v1.compiler.emit_core_support.module_to_filename(name: provider), filtered_names: names, emit_info: emit_info, registry: registry, local_names: local_type_names, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
      let block_lines = if block == "" { [] } else { block |> split(delimiter: "\n") }
      let emitted_here = block_lines |> flat_map(l => imported_names_in_use_line(line: l))
      let fallback = names |> flat_map(nm =>
        if (emitted_here |> any(e => e == nm)) || is_known_variant(type_summaries: emit_info.type_summaries, name: nm) {
          []
        } else if provider_proven_exports_symbol(name: nm, provider_module: provider, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
          [concat(rust_visibility_prefix(), concat("use crate::", concat(v1.compiler.emit_core_support.module_to_filename(name: provider), concat("::", concat(emit_import_name(n: nm, registry: registry), ";")))))]
        } else {
          []
        }
      )
      concat(block_lines, fallback)
    )
  }
}

fn emit_module_full(typed_module: v1.compiler.infer_items.TypedModule, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, shared_types: std.types.Set<String>, svc_module_map: std.types.Map<String, String>, data_items: std.types.Map<String, v1.std.core.Node>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, module_index: ModuleIndex, unlisted_type_names: std.types.List<String>) -> v1.std.core.TextFile {
  let m = typed_module.module
  let scope = v1.compiler.emit.module_emit_scope(typed_module: typed_module)
  let scoped_data_items = augment_scoped_data_item_index_with_imports(
    scoped: build_scoped_data_item_index(typed_module: typed_module, data_items: data_items),
    imports: contracts_imports_for_module(module_name: v1.compiler.infer_env.authored_name(env: scope.type_env, node: m), typed_modules: typed_modules, source_indices: scope.type_env.source_indices, module_index: module_index),
    source_indices: scope.type_env.source_indices,
    data_items: data_items
  )
  let prelude_imported_names = v1.std.core.module_imports(n: m)
    |> flat_map(imp => v1.std.core.import_specific_names_at(n: imp, source_indices: scope.type_env.source_indices))
  let local_type_names = concat(
    typed_module.items
      |> filter(item =>
        v1.compiler.emit_core_support.is_type_def_item(item: item)
        || is_type_alias_item(item: item, source_indices: scope.type_env.source_indices)
        || is_type_decl_item(item: item, source_indices: scope.type_env.source_indices)
      )
      |> map(item => v1.compiler.infer_env.authored_name(env: scope.type_env, node: item)),
    collect_phantom_zst_marker_names(items: typed_module.items, env: scope.type_env)
  )
  let prelude = emit_prelude(imported_names: prelude_imported_names, local_type_names: local_type_names)
  let imports_str = emit_imports(imports: v1.std.core.module_imports(n: m), emit_info: emit_info, registry: registry, local_names: local_type_names, export_sets: export_sets, typed_modules: typed_modules, source_indices: scope.type_env.source_indices, module_index: module_index, supplement_items: typed_module.items)
  let dag_import_lines = if imports_str == "" { [] } else { imports_str |> split(delimiter: "\n") }
  let carrier_import_lines = if module_needs_faithful_carrier_imports(
    items: typed_module.items,
    source_indices: scope.type_env.source_indices
  ) {
    emit_faithful_text_carrier_import_lines(
      imported_names: prelude_imported_names,
      local_type_names: local_type_names,
      items: typed_module.items,
      source_indices: scope.type_env.source_indices,
      shared_types: shared_types,
      typed_modules: typed_modules
    )
  } else {
    []
  }
  let already_imported_names = concat(
    prelude_imported_names,
    concat(dag_import_lines, concat(carrier_import_lines, prelude |> split(delimiter: "\n"))) |> flat_map(l => imported_names_in_use_line(line: l))
  )
  let reference_use_lines = reference_derived_use_lines(
      items: typed_module.items,
      unlisted_type_names: unlisted_type_names,
      this_module_name: v1.compiler.infer_env.authored_name(env: scope.type_env, node: m),
      registry: registry,
      emit_info: emit_info,
      local_type_names: local_type_names,
      already_imported_names: already_imported_names,
      export_sets: export_sets,
      typed_modules: typed_modules,
      source_indices: scope.type_env.source_indices,
      module_index: module_index
    )
  let merged_imports = dedupe_rust_import_lines(lines: concat(concat(dag_import_lines, carrier_import_lines), reference_use_lines)) |> join(separator: "\n")
  let imports_section = if merged_imports == "" { "" } else { concat("\n", merged_imports) }
  let this_mod_filename = v1.compiler.emit_core_support.module_to_filename(name: v1.compiler.infer_env.authored_name(env: scope.type_env, node: m))
  let all_svc_names = typed_module.items |> flat_map(item =>
    match map_get(registry, v1.compiler.infer_env.authored_name(env: scope.type_env, node: item)) {
      Present { value: info } => info.service_names
      Absent => []
    }
  )
  let extern_svc_imports = v1.compiler.emit_core_support.unique_strings(items: all_svc_names) |> flat_map(sn =>
    match map_get(svc_module_map, sn) {
      Present { value: mod_file } =>
        if mod_file == this_mod_filename { [] }
        else { [concat(rust_visibility_prefix(), "use crate::", mod_file, "::", v1.compiler.emit_core_support.sanitize_service_name(name: sn), ";")] }
      Absent => []
    }
  )
  let svc_imports_str = if extern_svc_imports |> count == 0 { "" }
    else { concat("\n", extern_svc_imports |> join(separator: "\n")) }
  let local_enum_uses = typed_module.items
    |> filter(item => v1.compiler.emit_core_support.is_type_def_item(item: item) && v1.compiler.infer_types.is_coproduct_type(n: item)
      && !is_grounded_coproduct_native_alias(name: v1.compiler.infer_env.authored_name(env: scope.type_env, node: item)))
    |> map(item => concat("use self::", v1.compiler.infer_env.authored_name(env: scope.type_env, node: item), "::*;"))
  let local_coproduct_names = typed_module.items
    |> filter(item => v1.compiler.emit_core_support.is_type_def_item(item: item) && v1.compiler.infer_types.is_coproduct_type(n: item))
    |> map(item => v1.compiler.infer_env.authored_name(env: scope.type_env, node: item))
  let module_import_items = v1.std.core.module_imports(n: m)
  let this_module_name = v1.compiler.infer_env.authored_name(env: scope.type_env, node: m)
  let wire_context_items = concat(typed_module.items, contracts_items_for_module(module_name: this_module_name, typed_modules: typed_modules, source_indices: scope.type_env.source_indices, module_index: module_index))
  let wire_context_imports = concat(module_import_items, contracts_imports_for_module(module_name: this_module_name, typed_modules: typed_modules, source_indices: scope.type_env.source_indices, module_index: module_index))
  let coproduct_wire_contract_validations = emit_coproduct_wire_contract_validations(module_items: wire_context_items, imports: wire_context_imports, local_coproduct_names: local_coproduct_names, source_indices: scope.type_env.source_indices)
  let coproduct_wire_contract_validation_section = if coproduct_wire_contract_validations == "" { "" } else { concat(coproduct_wire_contract_validations, "\n\n") }
  let local_uses_str = if local_enum_uses |> count == 0 { "" }
    else { concat("\n", local_enum_uses |> join(separator: "\n")) }
  let wire_contract_item = wire_context_items
    |> filter(i =>
      v1.compiler.emit_core_support.is_data_def_item(item: i)
      && v1.std.core.authored_name_at(source_indices: scope.type_env.source_indices, node: i) == "wire_contract")
    |> first
  let items_str = typed_module.items
    |> map(item => emit_typed_item(item: item, module_name: v1.compiler.infer_env.authored_name(env: scope.type_env, node: m), registry: registry, scope: scope, shared_types: shared_types, emit_info: emit_info, wire_contract_item: wire_contract_item, data_items: scoped_data_items, module_items: wire_context_items, imports: wire_context_imports, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index))
    |> join(separator: "\n\n")
  let phantom_zst_markers = emit_module_phantom_zst_markers(items: typed_module.items, env: scope.type_env)
  let phantom_section = if phantom_zst_markers == "" { "" } else { concat("\n\n", phantom_zst_markers) }
  let raw_filename = v1.compiler.emit_core_support.module_to_filename(name: v1.compiler.infer_env.authored_name(env: scope.type_env, node: m))
  let filename = if raw_filename == "main" { "main_mod" } else { raw_filename }
  let module_attrs = if v1.compiler.infer_env.authored_name(env: scope.type_env, node: m) == "std.error_primitives" {
    "#![allow(non_camel_case_types)]\n\n"
  } else { "" }
  let content = concat("// Generated by v1 compiler -- do not edit.\n",
    "// Source module: ", v1.compiler.infer_env.authored_name(env: scope.type_env, node: m), "\n\n",
    module_attrs, prelude, imports_section, svc_imports_str, local_uses_str, "\n\n",
    coproduct_wire_contract_validation_section, items_str, phantom_section, "\n")
  v1.std.core.TextFile { path: concat(rust_source_root(), filename, rust_source_ext()), content: content }
}

// Dotted-render class, USE-LIST position -- the single point every derived `use crate::<mod>::{..}`
// member passes through (five call sites build their names_str from it). A namespace-qualified name
// emitted `pub use crate::extdeps_shell::{shell.PosixCommandV};`, which rustc rejects with "expected
// one of `,`, `::`, `as`, or `}`, found `.`" -- the same PARSE-class refusal that masks every later
// diagnostic in the module. A use-list member is a DECLARED NAME in the providing module's namespace,
// so the qualifier is redundant there by construction, never load-bearing. The registry lookup above
// stays on the full spelling: like lookup_type_by_name in the discriminant lowering, it resolves a
// declaration rather than keying on the bare name. qualified_last_segment is the identity on an
// unqualified name, so every already-bare use-line renders exactly as before.
fn emit_import_name(n: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>) -> String {
  let is_data = match map_get(registry, n) {
    Present { value: info } => info.kind == v1.compiler.infer_items.DataItem
    Absent => false
  }
  let leaf = v1.std.core.qualified_last_segment(name: n)
  if is_data { v1.compiler.emit_core_support.to_snake(leaf) } else { leaf }
}

fn is_import_graph_type_name(name: String, import_module: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if has_physical_type_def_in_module_filename(rhs_name: name, mod_filename: v1.compiler.emit_core_support.module_to_filename(name: import_module), typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    true
  } else if match reexport_source_module_name(name: name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
    Present { value: src } => type_name_is_rust_importable_in_module(name: name, module_name: src, typed_modules: typed_modules, registry: registry, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
    Absent => false
  } {
    true
  } else if v1.compiler.infer_emit_info.is_enum_in_summaries(type_summaries: type_summaries, type_name: name) {
    false
  } else if v1.compiler.infer_emit_info.is_known_variant(type_summaries: type_summaries, name: name) {
    false
  } else {
    match map_get(export_sets, import_module) {
      Present { value: exported } =>
        if map_get(exported, name) == Present { value: true } {
          type_name_is_rust_importable_in_module(name: name, module_name: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
        } else { false }
      Absent => false
    }
  }
}

fn item_defining_module_filename(name: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, fallback: String) -> String {
  match v1.compiler.emit.lookup_item(registry: registry, name: name) {
    Present { value: info } => v1.compiler.emit_core_support.module_to_filename(name: info.module_name)
    Absent => fallback
  }
}

type ModuleIndex {
  by_name: std.types.Map<String, v1.compiler.infer_items.TypedModule>
  by_filename: std.types.Map<String, std.types.List<v1.compiler.infer_items.TypedModule>>
}

fn build_module_index(modules: std.types.List<v1.compiler.infer_items.TypedModule>) -> ModuleIndex {
  let by_name = modules |> fold(init: empty_map(), f: (acc, tm) =>
    let nm = v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)
    match map_get(acc, nm) {
      Present { value: _ } => acc
      Absent => map_insert(acc, nm, tm)
    }
  )
  let by_filename = modules |> fold(init: empty_map(), f: (acc, tm) =>
    let fname = v1.compiler.emit_core_support.module_to_filename(name: v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module))
    match map_get(acc, fname) {
      Present { value: prior } => map_insert(acc, fname, list_push(prior, tm))
      Absent => map_insert(acc, fname, [tm])
    }
  )
  ModuleIndex { by_name: by_name, by_filename: by_filename }
}

fn typed_module_by_name(module_name: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> v1.compiler.infer_items.TypedModule? {
  map_get(module_index.by_name, module_name)
}

fn contracts_items_for_module(module_name: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> std.types.List<v1.std.core.Node> {
  match typed_module_by_name(module_name: concat(module_name, "_contracts"), typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: tm } => tm.items
    Absent => []
  }
}

fn contracts_imports_for_module(module_name: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> std.types.List<v1.std.core.Node> {
  match typed_module_by_name(module_name: concat(module_name, "_contracts"), typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: tm } => v1.std.core.module_imports(n: tm.module)
    Absent => []
  }
}

fn module_name_from_filename(mod_filename: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> String? {
  match map_get(module_index.by_filename, mod_filename) {
    Present { value: mods } => mods |> map(tm => v1.std.core.authored_name_at(source_indices: source_indices, node: tm.module)) |> first
    Absent => none
  }
}

fn has_physical_type_def_in_module_filename(rhs_name: String, mod_filename: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match map_get(module_index.by_filename, mod_filename) {
    Present { value: mods } => mods |> any(tm =>
      tm.items |> any(item =>
        v1.std.core.authored_name_at(source_indices: source_indices, node: item) == rhs_name
        && (v1.compiler.emit_core_support.is_type_def_item(item: item)
          || is_type_alias_item(item: item, source_indices: source_indices)
          || is_type_decl_item(item: item, source_indices: source_indices))
      )
    )
    Absent => false
  }
}

fn find_variant_parent_in_module(variant_name: String, module_name: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> String? {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => Absent
    Present { value: tm } =>
      tm.items
        |> filter(item => v1.compiler.emit_core_support.is_type_def_item(item: item) && v1.compiler.infer_types.is_coproduct_type(n: item))
        |> filter(item =>
          item.children |> any(child =>
            v1.std.core.authored_name_at(source_indices: source_indices, node: child) == variant_name
          )
        )
        |> map(item => v1.std.core.authored_name_at(source_indices: source_indices, node: item))
        |> first
  }
}

fn type_name_is_export_source_in_module(name: String, module_name: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => false
    Present { value: tm } =>
      tm.items |> any(item =>
        v1.std.core.authored_name_at(source_indices: source_indices, node: item) == name
        && (v1.compiler.emit_core_support.is_type_def_item(item: item)
          || is_type_alias_item(item: item, source_indices: source_indices)
          || is_type_decl_item(item: item, source_indices: source_indices))
      )
  }
}

fn type_name_is_rust_importable_in_module(name: String, module_name: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => false
    Present { value: tm } =>
      match tm.items
        |> filter(item =>
          v1.std.core.authored_name_at(source_indices: source_indices, node: item) == name
          && (v1.compiler.emit_core_support.is_type_def_item(item: item)
            || is_type_alias_item(item: item, source_indices: source_indices)
            || is_type_decl_item(item: item, source_indices: source_indices))
        )
        |> first {
        Absent => false
        Present { value: item } =>
          type_item_has_rust_nominal_shell_authority(
            item: item,
            item_text: name,
            module_name: module_name,
            imports: v1.std.core.module_imports(n: tm.module),
            scope: v1.compiler.emit.module_emit_scope(typed_module: tm),
            registry: registry,
            export_sets: export_sets,
            typed_modules: typed_modules,
            source_indices: source_indices,
          module_index: module_index)
      }
  }
}

fn imported_name_is_non_emittable_type(name: String, import_module: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  let defining_module = match reexport_source_module_name(name: name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
    Present { value: src } => src
    Absent => import_module
  }
  type_name_is_export_source_in_module(name: name, module_name: defining_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
  && type_name_is_rust_importable_in_module(name: name, module_name: defining_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, source_indices: source_indices, module_index: module_index) == false
}

fn name_in_transitive_export_surface(name: String, module_name: String, visited: std.types.List<String>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if visited |> any(v => v == module_name) {
    false
  } else {
    let in_local = match map_get(export_sets, module_name) {
      Present { value: exported } => map_get(exported, name) == Present { value: true }
      Absent => false
    }
    if in_local {
      true
    } else {
      match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
        Absent => false
        Present { value: tm } =>
          v1.std.core.module_imports(n: tm.module)
            |> filter(imp => v1.std.core.import_is_all(n: imp))
            |> any(imp =>
              name_in_transitive_export_surface(
                name: name,
                module_name: v1.std.core.authored_name_at(source_indices: source_indices, node: imp),
                visited: concat(visited, [module_name]),
                export_sets: export_sets,
                typed_modules: typed_modules,
                source_indices: source_indices,
              module_index: module_index)
            )
      }
    }
  }
}

fn reexport_source_module_name(name: String, import_module: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> String? {
  reexport_source_module_name_with_visited(name: name, import_module: import_module, visited: [], typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
}

fn reexport_source_module_name_with_visited(name: String, import_module: String, visited: std.types.List<String>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> String? {
  if visited |> any(v => v == import_module) {
    Absent
  } else {
    match typed_module_by_name(module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
      Absent => Absent
      Present { value: tm } =>
        if type_name_is_export_source_in_module(name: name, module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
          Present { value: import_module }
        } else {
          match find_variant_parent_in_module(
            variant_name: name,
            module_name: import_module,
            typed_modules: typed_modules,
            source_indices: source_indices,
          module_index: module_index) {
            Present { value: _parent } => Present { value: import_module }
            Absent =>
          match v1.std.core.module_imports(n: tm.module) |> filter(imp =>
            v1.std.core.import_is_all(n: imp) == false
            && v1.std.core.import_specific_names_at(n: imp, source_indices: source_indices) |> any(n => n == name)
          ) |> map(imp => v1.std.core.authored_name_at(source_indices: source_indices, node: imp)) |> first {
            Present { value: src } =>
              reexport_source_module_name_with_visited(
                name: name,
                import_module: src,
                visited: concat(visited, [import_module]),
                typed_modules: typed_modules,
                export_sets: export_sets,
                source_indices: source_indices,
              module_index: module_index)
            Absent =>
              match v1.std.core.module_imports(n: tm.module) |> filter(imp => v1.std.core.import_is_all(n: imp)) |> filter(imp =>
                let src_mod = v1.std.core.authored_name_at(source_indices: source_indices, node: imp)
                name_in_transitive_export_surface(name: name, module_name: src_mod, visited: concat(visited, [import_module]), export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
              ) |> map(imp => v1.std.core.authored_name_at(source_indices: source_indices, node: imp)) |> first {
                Present { value: src } =>
                  reexport_source_module_name_with_visited(
                    name: name,
                    import_module: src,
                    visited: concat(visited, [import_module]),
                    typed_modules: typed_modules,
                    export_sets: export_sets,
                    source_indices: source_indices,
                  module_index: module_index)
                Absent => Absent
              }
          }
          }
        }
    }
  }
}

fn import_module_enum_scope(import_module: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> std.types.List<String> {
  let physical = enum_names_in_module(module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
  let reexport_parents = match map_get(export_sets, import_module) {
    Present { value: exported } =>
      sorted_map_keys(exported) |> filter(n =>
        v1.compiler.infer_emit_info.is_known_variant(type_summaries: type_summaries, name: n)
        && v1.compiler.infer_emit_info.is_enum_in_summaries(type_summaries: type_summaries, type_name: n) == false
      ) |> map(n =>
        match reexport_variant_parent_in_import_module(
          variant_name: n,
          import_module: import_module,
          registry: registry,
          type_summaries: type_summaries,
          typed_modules: typed_modules,
          export_sets: export_sets,
          source_indices: source_indices,
        module_index: module_index) {
          Present { value: parent } => parent
          Absent => ""
        }
      ) |> filter(p => p != "")
    Absent => []
  }
  v1.compiler.emit_core_support.unique_strings(items: concat(physical, reexport_parents))
}

fn enum_names_in_module(module_name: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> std.types.List<String> {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => []
    Present { value: tm } =>
      tm.items
        |> filter(item => v1.compiler.emit_core_support.is_type_def_item(item: item) && v1.compiler.infer_types.is_coproduct_type(n: item))
        |> map(item => v1.std.core.authored_name_at(source_indices: source_indices, node: item))
  }
}

fn enum_physically_defined_in_module(enum_name: String, module_name: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => false
    Present { value: tm } =>
      tm.items |> any(item =>
        v1.std.core.authored_name_at(source_indices: source_indices, node: item) == enum_name
        && v1.compiler.emit_core_support.is_type_def_item(item: item)
        && v1.compiler.infer_types.is_coproduct_type(n: item)
      )
  }
}

fn wildcard_import_pool_surface_names(module_name: String, visited: std.types.List<String>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> std.types.List<String> {
  if visited |> any(v => v == module_name) {
    []
  } else {
    match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
      Absent => []
      Present { value: tm } =>
        v1.std.core.module_imports(n: tm.module)
          |> filter(imp => v1.std.core.import_is_all(n: imp))
          |> flat_map(imp =>
            let src_mod = v1.std.core.authored_name_at(source_indices: source_indices, node: imp)
            let direct = match map_get(export_sets, src_mod) {
              Present { value: exported } => sorted_map_keys(exported)
              Absent => []
            }
            concat(
              direct,
              wildcard_import_pool_surface_names(
                module_name: src_mod,
                visited: concat(visited, [module_name]),
                export_sets: export_sets,
                typed_modules: typed_modules,
                source_indices: source_indices,
              module_index: module_index)
            )
          )
    }
  }
}

fn wildcard_reexport_surface_names(import_module: String, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> std.types.List<String> {
  let local_candidates = match map_get(export_sets, import_module) {
    Present { value: exported } => sorted_map_keys(exported)
    Absent => []
  }
  let wildcard_pool_candidates = wildcard_import_pool_surface_names(
    module_name: import_module,
    visited: [],
    export_sets: export_sets,
    typed_modules: typed_modules,
    source_indices: source_indices,
  module_index: module_index)
  v1.compiler.emit_core_support.unique_strings(items: concat(local_candidates, wildcard_pool_candidates) |> filter(n =>
    match reexport_source_module_name(name: n, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
      Present { value: src } => src != import_module
      Absent => false
    }
  ))
}

fn graph_type_import_module_filename(name: String, import_module: String, mod_name: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> String {
  if has_physical_type_def_in_module_filename(rhs_name: name, mod_filename: mod_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    mod_name
  } else {
    match reexport_source_module_name(name: name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
      Present { value: src } => v1.compiler.emit_core_support.module_to_filename(name: src)
      Absent => mod_name
    }
  }
}

fn variant_defining_module_filename_for_import(variant_name: String, import_module: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, fallback: String, module_index: ModuleIndex) -> String {
  match find_variant_parent_in_module(
    variant_name: variant_name,
    module_name: import_module,
    typed_modules: typed_modules,
    source_indices: source_indices,
  module_index: module_index) {
    Present { value: _parent } => v1.compiler.emit_core_support.module_to_filename(name: import_module)
    Absent =>
      match explicit_import_source_module_for_name(name: variant_name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
        Present { value: hop } =>
          if hop != import_module {
            variant_defining_module_filename_for_import(
              variant_name: variant_name,
              import_module: hop,
              typed_modules: typed_modules,
              export_sets: export_sets,
              source_indices: source_indices,
              fallback: fallback,
            module_index: module_index)
          } else { fallback }
        Absent => fallback
      }
  }
}

fn variant_parent_defining_module_filename(parent_enum: String, variant_name: String, import_module: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, fallback: String, module_index: ModuleIndex) -> String {
  match find_variant_parent_in_module(
    variant_name: variant_name,
    module_name: import_module,
    typed_modules: typed_modules,
    source_indices: source_indices,
  module_index: module_index) {
    Present { value: local_parent } =>
      if local_parent == parent_enum {
        v1.compiler.emit_core_support.module_to_filename(name: import_module)
      } else {
        variant_defining_module_filename_for_import(
          variant_name: variant_name,
          import_module: import_module,
          typed_modules: typed_modules,
          export_sets: export_sets,
          source_indices: source_indices,
          fallback: item_defining_module_filename(name: parent_enum, registry: registry, fallback: fallback),
        module_index: module_index)
      }
    Absent =>
      variant_defining_module_filename_for_import(
        variant_name: variant_name,
        import_module: import_module,
        typed_modules: typed_modules,
        export_sets: export_sets,
        source_indices: source_indices,
        fallback: item_defining_module_filename(name: parent_enum, registry: registry, fallback: fallback),
      module_index: module_index)
  }
}

fn explicit_import_source_module_for_name(name: String, import_module: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> String? {
  match typed_module_by_name(module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => Absent
    Present { value: tm } =>
      match v1.std.core.module_imports(n: tm.module) |> filter(imp =>
        v1.std.core.import_is_all(n: imp) == false
        && v1.std.core.import_specific_names_at(n: imp, source_indices: source_indices) |> any(n => n == name)
      ) |> map(imp => v1.std.core.authored_name_at(source_indices: source_indices, node: imp)) |> first {
        Present { value: src } => Present { value: src }
        Absent =>
          match v1.std.core.module_imports(n: tm.module) |> filter(imp => v1.std.core.import_is_all(n: imp)) |> filter(imp =>
            let src_mod = v1.std.core.authored_name_at(source_indices: source_indices, node: imp)
            match map_get(export_sets, src_mod) {
              Present { value: exported } => map_get(exported, name) == Present { value: true }
              Absent => false
            }
          ) |> map(imp => v1.std.core.authored_name_at(source_indices: source_indices, node: imp)) |> first {
            Present { value: src } => Present { value: src }
            Absent => Absent
          }
      }
  }
}

fn reexport_variant_parent_in_import_module(variant_name: String, import_module: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> String? {
  match reexport_source_module_name(name: variant_name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
    Absent => Absent
    Present { value: src_mod } =>
      match find_variant_parent_in_module(
        variant_name: variant_name,
        module_name: src_mod,
        typed_modules: typed_modules,
        source_indices: source_indices,
      module_index: module_index) {
        Present { value: parent } => Present { value: parent }
        Absent =>
          match explicit_import_source_module_for_name(name: variant_name, import_module: src_mod, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
            Present { value: hop } =>
              if hop != src_mod {
                reexport_variant_parent_in_import_module(
                  variant_name: variant_name,
                  import_module: hop,
                  registry: registry,
                  type_summaries: type_summaries,
                  typed_modules: typed_modules,
                  export_sets: export_sets,
                  source_indices: source_indices,
                module_index: module_index)
              } else { none }
            Absent => none
          }
      }
  }
}

fn alias_rhs_rust_qualify_module_filename(name: String, alias_module: String, imports: std.types.List<v1.std.core.Node>, scope: v1.compiler.infer.InferScope, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> String {
  let spell_mod = alias_rhs_base_module_filename(name: name, alias_module: alias_module, imports: imports, source_indices: source_indices, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
  if has_physical_type_def_in_module_filename(rhs_name: name, mod_filename: spell_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    spell_mod
  } else {
    match module_name_from_filename(mod_filename: spell_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
      Present { value: mod_name } =>
        match reexport_source_module_name(name: name, import_module: mod_name, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
          Present { value: src } => v1.compiler.emit_core_support.module_to_filename(name: src)
          Absent => spell_mod
        }
      Absent => spell_mod
    }
  }
}

fn alias_rhs_base_module_filename(name: String, alias_module: String, imports: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, scope: v1.compiler.infer.InferScope, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, module_index: ModuleIndex) -> String {
  let local_mod = v1.compiler.emit_core_support.module_to_filename(name: alias_module)
  match v1.compiler.emit.lookup_item(registry: scope.item_registry, name: name) {
    Present { value: info } =>
      if info.module_name == alias_module && (info.kind == v1.compiler.infer_items.TypeItem || info.kind == v1.compiler.infer_items.OtherItem) && has_physical_type_def_in_module_filename(rhs_name: name, mod_filename: local_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
        local_mod
      } else {
        alias_rhs_base_module_from_import_or_registry(name: name, imports: imports, source_indices: source_indices, registry: registry, local_mod: local_mod, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
      }
    Absent =>
      alias_rhs_base_module_from_import_or_registry(name: name, imports: imports, source_indices: source_indices, registry: registry, local_mod: local_mod, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
  }
}

fn alias_rhs_base_module_from_import_or_registry(name: String, imports: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, local_mod: String, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, module_index: ModuleIndex) -> String {
  match imports |> filter(imp =>
    v1.std.core.import_specific_names_at(n: imp, source_indices: source_indices) |> any(n => n == name)
  ) |> map(imp => v1.std.core.authored_name_at(source_indices: source_indices, node: imp)) |> first {
    Present { value: import_module } => v1.compiler.emit_core_support.module_to_filename(name: import_module)
    Absent =>
      match imports |> filter(imp => v1.std.core.import_is_all(n: imp)) |> filter(imp =>
        let import_module = v1.std.core.authored_name_at(source_indices: source_indices, node: imp)
        name_in_transitive_export_surface(name: name, module_name: import_module, visited: [], export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
      ) |> map(imp => v1.std.core.authored_name_at(source_indices: source_indices, node: imp)) |> first {
        Present { value: import_module } => v1.compiler.emit_core_support.module_to_filename(name: import_module)
        Absent => item_defining_module_filename(name: name, registry: registry, fallback: local_mod)
      }
  }
}

fn item_generic_param_names(item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> std.types.List<String> {
  item.params |> map(p => v1.std.core.generic_param_name_at(n: p, source_indices: source_indices))
}

fn type_item_by_name_in_module_filename(rhs_name: String, mod_filename: String, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> v1.std.core.Node? {
  match module_name_from_filename(mod_filename: mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: mod_name } =>
      match typed_module_by_name(module_name: mod_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
        Present { value: tm } =>
          tm.items |> filter(item =>
            v1.std.core.authored_name_at(source_indices: source_indices, node: item) == rhs_name
            && (v1.compiler.emit_core_support.is_type_def_item(item: item)
              || is_type_alias_item(item: item, source_indices: source_indices)
              || is_type_decl_item(item: item, source_indices: source_indices))
          ) |> first
        Absent => none
      }
    Absent => none
  }
}

fn type_item_has_rust_nominal_shell_authority(item: v1.std.core.Node, item_text: String, module_name: String, imports: std.types.List<v1.std.core.Node>, scope: v1.compiler.infer.InferScope, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if v1.compiler.emit_core_support.is_type_def_item(item: item) {
    true
  } else if v1.compiler.emit_core_support.is_type_alias_item(item: item, source_indices: source_indices) {
    true
  } else if v1.compiler.emit_core_support.is_type_decl_item(item: item, source_indices: source_indices) {
    if (item.params |> count) == 0 && (rust_nominal_identity_carrier_type_eligible(type_name: item_text) || rust_opaque_kernel_alias_type_eligible(name: item_text)) {
      true
    } else if (item.params |> count) > 0 {
      if is_parametric_opaque_type_decl_item(item: item, source_indices: source_indices) {
        true
      } else {
      let rhs = resolved_type(n: item)
      if v1.compiler.emit_core_support.is_type_alias_return_node(n: rhs, source_indices: source_indices) && (rhs.children |> count) > 0 {
        alias_rhs_nominal_shell_has_rust_authority(
          n: rhs,
          module_name: module_name,
          imports: imports,
          scope: scope,
          registry: registry,
          export_sets: export_sets,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index)
      } else if v1.compiler.emit_core_support.is_type_alias_return_node(n: rhs, source_indices: source_indices) {
        let rhs_name = v1.std.core.authored_name_at(source_indices: source_indices, node: rhs)
        (rhs_name != item_text)
          && rhs_name != ""
          && alias_rhs_nominal_shell_has_rust_authority(
            n: rhs,
            module_name: module_name,
            imports: imports,
            scope: scope,
            registry: registry,
            export_sets: export_sets,
            typed_modules: typed_modules,
            source_indices: source_indices,
            module_index: module_index)
      } else {
        false
      }
      }
    } else {
      false
    }
  } else {
    false
  }
}

fn is_phantom_unit_variant_type_arg(env: v1.compiler.infer_env.TypeEnv, variant_name: String) -> Bool {
  match v1.compiler.infer_resolve.lookup_unit_variant_phantom_type(env: env, variant_name: variant_name) {
    Present { value: _ } => true
    Absent => false
  }
}

fn rhs_base_has_rust_type_authority_in_module(rhs_name: String, def_mod_filename: String, module_name: String, imports: std.types.List<v1.std.core.Node>, scope: v1.compiler.infer.InferScope, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if is_phantom_unit_variant_type_arg(env: scope.type_env, variant_name: rhs_name) {
    true
  } else {
  match type_item_by_name_in_module_filename(rhs_name: rhs_name, mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: item } =>
      match module_name_from_filename(mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
        Present { value: def_module_name } =>
          match typed_module_by_name(module_name: def_module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
            Present { value: tm } =>
              type_item_has_rust_nominal_shell_authority(
                item: item,
                item_text: rhs_name,
                module_name: def_module_name,
                imports: v1.std.core.module_imports(n: tm.module),
                scope: v1.compiler.emit.module_emit_scope(typed_module: tm),
                registry: registry,
                export_sets: export_sets,
                typed_modules: typed_modules,
                source_indices: source_indices,
              module_index: module_index)
            Absent => false
          }
        Absent => false
      }
    Absent =>
      match module_name_from_filename(mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
        Present { value: mod_name } =>
          match map_get(export_sets, mod_name) {
            Present { value: exported } =>
              if map_get(exported, rhs_name) == Present { value: true } {
                match reexport_source_module_name(name: rhs_name, import_module: mod_name, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
                  Present { value: src } =>
                    rhs_base_has_rust_type_authority_in_module(
                      rhs_name: rhs_name,
                      def_mod_filename: v1.compiler.emit_core_support.module_to_filename(name: src),
                      module_name: module_name,
                      imports: imports,
                      scope: scope,
                      registry: registry,
                      typed_modules: typed_modules,
                      export_sets: export_sets,
                      source_indices: source_indices,
                    module_index: module_index)
                  Absent => false
                }
              } else { false }
            Absent => false
          }
        Absent => false
      }
  }
  }
}

fn alias_rhs_nominal_shell_has_rust_authority(n: v1.std.core.Node, module_name: String, imports: std.types.List<v1.std.core.Node>, scope: v1.compiler.infer.InferScope, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if n.connective == v1.std.core.NoConnective && n.children |> count > 0 {
    let name = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
    let def_mod = alias_rhs_base_module_filename(name: name, alias_module: module_name, imports: imports, source_indices: source_indices, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
    rhs_base_has_rust_type_authority_in_module(rhs_name: name, def_mod_filename: def_mod, module_name: module_name, imports: imports, scope: scope, registry: registry, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
      && n.children |> all(child =>
        alias_rhs_nominal_shell_has_rust_authority(
          n: child,
          module_name: module_name,
          imports: imports,
          scope: scope,
          registry: registry,
          export_sets: export_sets,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index)
      )
  } else if n.connective == v1.std.core.NoConnective && n.children |> count == 0 {
    if n.inferred != none && is_type_variable(inferred: n.inferred.value) {
      true
    } else {
      let name = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
      if name == "" || is_kernel_type(name: name) {
        true
      } else if is_phantom_unit_variant_type_arg(env: scope.type_env, variant_name: name) {
        true
      } else {
        let def_mod = alias_rhs_base_module_filename(name: name, alias_module: module_name, imports: imports, source_indices: source_indices, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
        rhs_base_has_rust_type_authority_in_module(rhs_name: name, def_mod_filename: def_mod, module_name: module_name, imports: imports, scope: scope, registry: registry, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
      }
    }
  } else {
    true
  }
}

fn is_self_referential_opaque_type_resolved(item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let item_text = v1.std.core.authored_name_at(source_indices: source_indices, node: item)
  let rhs = resolved_type(n: item)
  v1.compiler.emit_core_support.is_type_alias_return_node(n: rhs, source_indices: source_indices)
    && v1.std.core.authored_name_at(source_indices: source_indices, node: rhs) == item_text
}

fn is_zero_param_self_referential_opaque_decl(item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  v1.compiler.emit_core_support.is_bare_leaf_item(item: item)
    && is_self_referential_opaque_type_resolved(item: item, source_indices: source_indices)
}

fn is_parametric_opaque_type_decl_item(item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  (item.params |> count) > 0
    && item.body == none
    && item.transport == none
    && (item.children |> count) == 0
    && (
      !v1.compiler.emit_core_support.is_type_alias_return_node(n: resolved_type(n: item), source_indices: source_indices)
      || is_self_referential_opaque_type_resolved(item: item, source_indices: source_indices)
    )
}

fn emit_zero_param_phantom_opaque_struct(item: v1.std.core.Node, map_key_required: Bool, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  let item_text = v1.std.core.authored_name_at(source_indices: source_indices, node: item)
  concat(
    concat(extdeps.languages.rust.emit.rust_trait_derive_attr_from_traits(v1.compiler.trait_derive_emit.v1_with_map_key_requirement(base: extdeps.languages.rust.capabilities.phantom_opaque_carrier_derive_traits(), map_key_required: map_key_required)), "\n"),
    rust_visibility_prefix(),
    rust_items().struct_keyword, " ", item_text, "(pub std::marker::PhantomData<()>);"
  )
}

fn emit_parametric_phantom_opaque_struct(item: v1.std.core.Node, map_key_required: Bool, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  let item_text = v1.std.core.authored_name_at(source_indices: source_indices, node: item)
  let type_params = emit_type_params(params: item.params, source_indices: source_indices)
  let generic_names = item_generic_param_names(item: item, source_indices: source_indices)
  let marker_ty = concat("std::marker::PhantomData<", rust_phantom_marker_inner(unused: generic_names), ">")
  concat(
    concat(extdeps.languages.rust.emit.rust_trait_derive_attr_from_traits(v1.compiler.trait_derive_emit.v1_with_map_key_requirement(base: extdeps.languages.rust.capabilities.phantom_opaque_carrier_derive_traits(), map_key_required: map_key_required)), "\n"),
    rust_visibility_prefix(),
    rust_items().struct_keyword, " ", item_text, type_params, "(pub ", marker_ty, ");"
  )
}

fn is_emittable_parametric_type_alias_item(item: v1.std.core.Node, item_text: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_name: String, imports: std.types.List<v1.std.core.Node>, scope: v1.compiler.infer.InferScope, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, module_index: ModuleIndex) -> Bool {
  if (item.params |> count) == 0 {
    false
  } else {
    let rhs = resolved_type(n: item)
    if rhs.inferred != none && v1.std.core.is_compiler_error(inferred: rhs.inferred.value) {
      false
    } else if !v1.compiler.emit_core_support.is_type_alias_return_node(n: rhs, source_indices: source_indices) {
      false
    } else {
      let rhs_name = v1.std.core.authored_name_at(source_indices: source_indices, node: rhs)
      (rhs_name != item_text)
        && (
          (rhs.children |> count) > 0
          || (
            (rhs.children |> count) == 0
            && rhs_name != ""
            && alias_rhs_nominal_shell_has_rust_authority(
              n: rhs,
              module_name: module_name,
              imports: imports,
              scope: scope,
              registry: registry,
              export_sets: export_sets,
              typed_modules: typed_modules,
              source_indices: source_indices,
              module_index: module_index)
          )
        )
    }
  }
}

fn import_variant_parent_for_name(n: String, import_module: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex, imported_enums: std.types.List<String>, import_module_enums: std.types.List<String>) -> String {
  if is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index) {
    ""
  } else if import_module_enums |> any(e => e == n) {
    ""
  } else {
    match find_variant_parent_in_module(
      variant_name: n,
      module_name: import_module,
      typed_modules: typed_modules,
      source_indices: source_indices,
    module_index: module_index) {
      Present { value: parent } => parent
      Absent =>
        match reexport_variant_parent_in_import_module(
          variant_name: n,
          import_module: import_module,
          registry: registry,
          type_summaries: type_summaries,
          typed_modules: typed_modules,
          export_sets: export_sets,
          source_indices: source_indices,
        module_index: module_index) {
          Present { value: parent } => parent
          Absent =>
            match v1.compiler.infer_emit_info.find_variant_parent(type_summaries: type_summaries, variant_name: n, scope_enums: imported_enums) {
              Present { value: parent } => parent
              Absent =>
                match v1.compiler.infer_emit_info.find_variant_parent(type_summaries: type_summaries, variant_name: n, scope_enums: import_module_enums) {
                  Present { value: parent } => parent
                  Absent => ""
                }
            }
        }
    }
  }
}

fn emit_specific_import_block(import_module: String, mod_name: String, filtered_names: std.types.List<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, local_names: std.types.List<String>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> String {
  let type_summaries = emit_info.type_summaries
  let deduped_names = v1.compiler.emit_core_support.unique_strings(items: filtered_names |> filter(n => local_names |> all(ln => ln != n)))
  if deduped_names |> count == 0 {
    ""
  } else {
    let import_module_enums = import_module_enum_scope(import_module: import_module, registry: registry, type_summaries: type_summaries, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
    let top_level = deduped_names |> filter(n =>
      if is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index) {
        true
      } else if v1.compiler.infer_emit_info.is_known_variant(type_summaries: type_summaries, name: n) {
        import_module_enums |> any(e => e == n)
      } else if imported_name_is_non_emittable_type(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
        false
      } else if std.types.is_kernel_type(name: n) {
        false
      } else { true }
    )
    let imported_enums = deduped_names |> filter(n => import_module_enums |> any(e => e == n))
    let all_parents = deduped_names |> map(n =>
      import_variant_parent_for_name(n: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index, imported_enums: imported_enums, import_module_enums: import_module_enums)
    ) |> filter(p => p != "")
    let parent_list = v1.compiler.emit_core_support.unique_strings(items: all_parents)
    let non_variant_top = top_level |> filter(n =>
      if import_variant_parent_for_name(n: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index, imported_enums: imported_enums, import_module_enums: import_module_enums) != "" {
        false
      } else if v1.compiler.infer_emit_info.is_known_variant(type_summaries: type_summaries, name: n) {
        import_module_enums |> any(e => e == n)
      } else { true }
    )
    let direct_names = v1.compiler.emit_core_support.unique_strings(items: non_variant_top)

    let local_parent_names = parent_list |> filter(p =>
      deduped_names |> any(n =>
        match find_variant_parent_in_module(
          variant_name: n,
          module_name: import_module,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index) {
          Present { value: found } => found == p
          Absent => false
        }
      )
    )
    let remote_parent_list = parent_list |> filter(p =>
      direct_names |> all(n => n != p)
    ) |> filter(p =>
      deduped_names |> any(n =>
        match find_variant_parent_in_module(
          variant_name: n,
          module_name: import_module,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index) {
          Present { value: found } => found == p
          Absent => false
        }
      ) == false
    )
    let merged_direct_names = v1.compiler.emit_core_support.unique_strings(items: concat(direct_names, local_parent_names))
    let type_direct_names = merged_direct_names |> filter(n =>
      is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index)
    )
    let other_direct_names = merged_direct_names |> filter(n =>
      is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index) == false
    )
    let type_direct_mods = v1.compiler.emit_core_support.unique_strings(items: type_direct_names |> map(n =>
      graph_type_import_module_filename(name: n, import_module: import_module, mod_name: mod_name, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
    ))
    let type_direct_lines = type_direct_mods |> map(def_mod =>
      let group = type_direct_names |> filter(n =>
        graph_type_import_module_filename(name: n, import_module: import_module, mod_name: mod_name, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) == def_mod
      )
      if group |> count > 0 {
        let names_str = group |> map(n =>
          emit_import_name(n: n, registry: registry)
        ) |> join(separator: ", ")
        concat(rust_visibility_prefix(), "use crate::", def_mod, "::{", names_str, "};")
      } else { "" }
    )
    let other_direct_line = if other_direct_names |> count > 0 {
      let names_str = other_direct_names |> map(n =>
        emit_import_name(n: n, registry: registry)
      ) |> join(separator: ", ")
      concat(rust_visibility_prefix(), "use crate::", mod_name, "::{", names_str, "};")
    } else { "" }
    let direct_lines = concat(type_direct_lines |> filter(l => l != ""), if other_direct_line != "" { [other_direct_line] } else { [] })
    let parent_defining_mods = v1.compiler.emit_core_support.unique_strings(items: remote_parent_list |> map(p =>
      let rep_variant = deduped_names |> filter(n =>
        match find_variant_parent_in_module(variant_name: n, module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
          Present { value: found } => found == p
          Absent =>
            match reexport_variant_parent_in_import_module(variant_name: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
              Present { value: found } => found == p
              Absent => false
            }
        }
      ) |> first
      match rep_variant {
        Present { value: v } => variant_parent_defining_module_filename(parent_enum: p, variant_name: v, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, registry: registry, fallback: mod_name, module_index: module_index)
        Absent => item_defining_module_filename(name: p, registry: registry, fallback: mod_name)
      }
    ))
    let parent_main_lines = parent_defining_mods |> map(def_mod =>
      let group = remote_parent_list |> filter(p =>
        let rep_variant = deduped_names |> filter(n =>
          match find_variant_parent_in_module(variant_name: n, module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
            Present { value: found } => found == p
            Absent =>
              match reexport_variant_parent_in_import_module(variant_name: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
                Present { value: found } => found == p
                Absent => false
              }
          }
        ) |> first
        match rep_variant {
          Present { value: v } => variant_parent_defining_module_filename(parent_enum: p, variant_name: v, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, registry: registry, fallback: mod_name, module_index: module_index) == def_mod
          Absent => item_defining_module_filename(name: p, registry: registry, fallback: mod_name) == def_mod
        }
      )
      if group |> count > 0 {
        let names_str = group |> join(separator: ", ")
        concat(rust_visibility_prefix(), "use crate::", def_mod, "::{", names_str, "};")
      } else { "" }
    )
    let main_lines = if direct_lines |> count > 0 {
      concat(direct_lines, parent_main_lines |> filter(l => l != ""))
    } else {
      parent_main_lines |> filter(l => l != "")
    }
    let variant_lines = parent_list |> map(parent =>
      if is_grounded_coproduct_native_alias(name: parent) { "" } else {
      let variants = deduped_names |> filter(n =>
        if n == "None" || n == "Some" {
          false
        } else if is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index) {
          false
        } else if import_module_enums |> any(e => e == n) {
          false
        } else {
          match find_variant_parent_in_module(variant_name: n, module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
            Present { value: found } => found == parent
            Absent =>
              match reexport_variant_parent_in_import_module(variant_name: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
                Present { value: found } => found == parent
                Absent =>
                  match v1.compiler.infer_emit_info.find_variant_parent(type_summaries: type_summaries, variant_name: n, scope_enums: [parent]) {
                    Present { value: _ } => true
                    Absent => false
                  }
              }
          }
        }
      )
      let parent_mod = match variants |> first {
        Present { value: v } => variant_parent_defining_module_filename(parent_enum: parent, variant_name: v, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, registry: registry, fallback: mod_name, module_index: module_index)
        Absent => item_defining_module_filename(name: parent, registry: registry, fallback: mod_name)
      }
      let vars_str = variants |> join(separator: ", ")
      concat("use crate::", parent_mod, "::", parent, "::{", vars_str, "};")
      }
    )
    let final_imported_enums = top_level |> filter(n => import_module_enums |> any(e => e == n))
    let wildcard_enum_lines = final_imported_enums
      |> filter(en => parent_list |> any(p => p == en) == false
        && !is_grounded_coproduct_native_alias(name: en))
      |> map(en => concat("use crate::", mod_name, "::", en, "::*;"))
    let all_lines = concat(
      main_lines |> filter(l => l != ""),
      variant_lines |> filter(l => l != ""),
      wildcard_enum_lines
    )
    all_lines |> join(separator: "\n")
  }
}

fn rust_use_crate_marker(line: String) -> String {
  if contains(line, "pub use crate::") {
    "pub use crate::"
  } else if contains(line, "use crate::") {
    "use crate::"
  } else {
    ""
  }
}

fn rust_use_after_crate(line: String) -> String {
  let marker = rust_use_crate_marker(line: line)
  if marker == "" {
    ""
  } else {
    match line |> split(delimiter: marker) |> skip(1) |> first {
      Present { value: rest } => rest
      Absent => ""
    }
  }
}

fn rust_pub_use_module_name(line: String) -> String {
  let rest = rust_use_after_crate(line: line)
  if rest == "" {
    ""
  } else if contains(rest, "::{") {
    match rest |> split(delimiter: "::{") |> first {
      Present { value: path } => path
      Absent => ""
    }
  } else if contains(rest, "::*") {
    match rest |> split(delimiter: "::*") |> first {
      Present { value: path } => path
      Absent => ""
    }
  } else {
    match rest |> split(delimiter: ";") |> first {
      Present { value: without_semi } =>
        let segments = without_semi |> split(delimiter: "::")
        let seg_count = segments |> count
        if seg_count <= 1 {
          ""
        } else {
          segments |> fold(init: { idx: 0, path: "" }, f: (acc, seg) =>
            if acc.idx < seg_count - 1 {
              let next = if acc.path == "" { seg } else { concat(acc.path, "::", seg) }
              { idx: acc.idx + 1, path: next }
            } else { acc }
          ).path
        }
      Absent => ""
    }
  }
}

fn rust_pub_use_singleton_name(line: String) -> String {
  let rest = rust_use_after_crate(line: line)
  if rest == "" || contains(rest, "::{") || contains(rest, "::*") {
    ""
  } else {
    match rest |> split(delimiter: ";") |> first {
      Present { value: without_semi } =>
        let segments = without_semi |> split(delimiter: "::")
        match segments |> last {
          Present { value: name } => name
          Absent => ""
        }
      Absent => ""
    }
  }
}

fn rust_pub_use_braced_names(line: String) -> std.types.List<String> {
  if contains(line, "::{") && rust_use_crate_marker(line: line) != "" {
    match line |> split(delimiter: "::{") |> skip(1) |> first {
      Present { value: rest } =>
        match rest |> split(delimiter: "}") |> first {
          Present { value: names } => names |> split(delimiter: ", ")
          Absent => []
        }
      Absent => []
    }
  } else {
    []
  }
}

fn rust_pub_use_braced_line_has_name(line: String, mod_name: String, name: String) -> Bool {
  rust_pub_use_module_name(line: line) == mod_name
    && contains(line, "::{")
    && (contains(line, concat("{", name, ","))
      || contains(line, concat(", ", name, ","))
      || contains(line, concat(", ", name, "}"))
      || contains(line, concat("{", name, "}")))
}

fn rust_pub_use_singleton_covered(line: String, lines: std.types.List<String>) -> Bool {
  let mod_name = rust_pub_use_module_name(line: line)
  let name = rust_pub_use_singleton_name(line: line)
  if mod_name == "" || name == "" {
    false
  } else {
    lines |> any(other => rust_pub_use_braced_line_has_name(line: other, mod_name: mod_name, name: name))
  }
}

fn rust_pub_use_braced_subset_covered(line: String, lines: std.types.List<String>) -> Bool {
  let mod_name = rust_pub_use_module_name(line: line)
  let names = rust_pub_use_braced_names(line: line)
  if mod_name == "" || names |> count == 0 {
    false
  } else {
    lines |> any(other =>
      other != line
        && rust_pub_use_module_name(line: other) == mod_name
        && contains(other, "::{")
        && (rust_pub_use_braced_names(line: other) |> count) > (names |> count)
        && names |> all(name => rust_pub_use_braced_line_has_name(line: other, mod_name: mod_name, name: name))
    )
  }
}

type BracedImportCoverAccum {
  found_current: Bool
  covered: Bool
}

fn rust_pub_use_braced_equal_prior_covered(line: String, lines: std.types.List<String>) -> Bool {
  let mod_name = rust_pub_use_module_name(line: line)
  let names = rust_pub_use_braced_names(line: line)
  if mod_name == "" || names |> count == 0 {
    false
  } else {
    let acc = lines |> fold(init: BracedImportCoverAccum { found_current: false, covered: false }, f: (inner, other) =>
      if inner.found_current || inner.covered {
        inner
      } else if other == line {
        BracedImportCoverAccum { found_current: true, covered: inner.covered }
      } else {
        let other_names = rust_pub_use_braced_names(line: other)
        let is_equal_cover = rust_pub_use_module_name(line: other) == mod_name
          && contains(other, "::{")
          && (other_names |> count) == (names |> count)
          && names |> all(name => rust_pub_use_braced_line_has_name(line: other, mod_name: mod_name, name: name))
        BracedImportCoverAccum { found_current: false, covered: is_equal_cover }
      }
    )
    acc.covered
  }
}

fn rust_use_bound_symbol(entry: String) -> String {
  match entry |> split(delimiter: " as ") |> skip(1) |> first {
    Present { value: bound_name } => bound_name
    Absent => entry
  }
}

data strip_repeated_use_symbols_note: String = "Cross-line symbol-ownership pass (the emitter-side construction fix for the last cssl sanitize rule, cssl_emit_artifact_sanitize_scaffold_debt): within one module header, a symbol binds through exactly ONE crate-use line — the first line to bind it keeps it, a later line re-importing the same bound name through a different transitive path (Optional via v2_std_grammar AND v2_std_collection, the measured 2026-07-22 emit_produced firing) drops the repeat, and a line reduced to zero symbols disappears. Glob lines (::*) and non-crate imports pass through unbound (glob shadowing is legal rust and the prelude is out of scope). The subset/equal coverage filters above drop whole redundant lines; this pass makes the residual PARTIAL overlap across two provider paths unwritable, so rustc E0252/E0255 duplicate-binding classes cannot be authored by the import merge. Coarser than rustc's per-namespace rule (one seen-set, not type/value split) — mirrors the sanitize rule it replaces; .dag naming (CamelCase types, snake_case values) keeps cross-namespace same-name pairs out of real emissions, and the seed (green, so free of duplicate bindings) is byte-inert under it by construction. This pass is post-hoc over rendered lines, not construction (DESIGN section 5) — a bounded scaffold. dissolve-on: the import surface derives from ONE symbol-to-provider ownership map built BEFORE any use-line renders (emit_imports + carrier + reference-derived streams selecting from the same map, so a duplicate binding is unwritable), OR the resolver step-2 typed refusal replaces reference-derived synthesis entirely (the nic_scaffold_dissolution_trigger event) — at either point this strip reduces to a dead assertion and is deleted; the raw_dup_pub_use sweep column is the census that proves it fired zero times first. Cost shape: one symbol-to-owning-line map built in a single pass, then a per-line projection against it — linear in total bound symbols (an owner line always retains its owned symbols, so first-binder-wins and the owner map agree); the earlier per-iteration recomputation of the seen set from all prior kept lines was a quadratic fold (bare-minimum-cost rule, 2026-07-10)."

fn rust_use_line_bound_symbols(line: String) -> std.types.List<String> {
  if rust_use_crate_marker(line: line) == "" || contains(line, "::*") {
    []
  } else {
    let braced = rust_pub_use_braced_names(line: line)
    if braced |> count > 0 {
      braced |> map(entry => rust_use_bound_symbol(entry: entry))
    } else {
      let singleton = rust_pub_use_singleton_name(line: line)
      if singleton == "" { [] } else { [singleton] }
    }
  }
}

fn strip_repeated_use_symbols(lines: std.types.List<String>) -> std.types.List<String> {
  let owners = lines |> fold(init: empty_map(), f: (acc, line) =>
    rust_use_line_bound_symbols(line: line) |> fold(init: acc, f: (inner, bound) =>
      if map_contains_key(inner, bound) { inner } else { map_insert(inner, bound, line) }
    )
  )
  lines |> flat_map(line =>
    if rust_use_crate_marker(line: line) == "" || contains(line, "::*") {
      [line]
    } else {
      let braced = rust_pub_use_braced_names(line: line)
      if braced |> count > 0 {
        let fresh_bounds = v1.compiler.emit_core_support.unique_strings(items: braced |> map(entry => rust_use_bound_symbol(entry: entry)))
          |> filter(bound => match map_get(owners, bound) {
            Present { value: owner } => owner == line
            Absent => false
          })
        let kept = fresh_bounds |> flat_map(bound =>
          match braced |> filter(entry => rust_use_bound_symbol(entry: entry) == bound) |> first {
            Present { value: entry } => [entry]
            Absent => []
          }
        )
        if kept |> count == 0 {
          []
        } else if (kept |> count) == (braced |> count) {
          [line]
        } else {
          match line |> split(delimiter: "::{") |> first {
            Present { value: prefix } => [concat(prefix, "::{", kept |> join(separator: ", "), "};")]
            Absent => [line]
          }
        }
      } else {
        let singleton = rust_pub_use_singleton_name(line: line)
        if singleton == "" {
          [line]
        } else {
          match map_get(owners, singleton) {
            Present { value: owner } => if owner == line { [line] } else { [] }
            Absent => [line]
          }
        }
      }
    }
  )
}

fn dedupe_rust_import_lines(lines: std.types.List<String>) -> std.types.List<String> {
  let exact = v1.compiler.emit_core_support.unique_strings(items: lines |> filter(line => line != ""))
  let covered = exact |> filter(line =>
    rust_pub_use_singleton_covered(line: line, lines: exact) == false
      && rust_pub_use_braced_subset_covered(line: line, lines: exact) == false
      && rust_pub_use_braced_equal_prior_covered(line: line, lines: exact) == false
  )
  strip_repeated_use_symbols(lines: covered)
}

fn emit_imports(imports: std.types.List<v1.std.core.Node>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, local_names: std.types.List<String>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex, supplement_items: std.types.List<v1.std.core.Node>) -> String {
  if imports |> count == 0 {
    ""
  } else {
    let import_modules = v1.compiler.emit_core_support.unique_strings(items: imports |> map(imp => v1.std.core.authored_name_at(source_indices: source_indices, node: imp)))
    let import_lines = import_modules |> flat_map(import_module =>
      let mod_imports = imports |> filter(imp => v1.std.core.authored_name_at(source_indices: source_indices, node: imp) == import_module)
      let mod_name = v1.compiler.emit_core_support.module_to_filename(name: import_module)
      let mod_has_wildcard = mod_imports |> any(imp => v1.std.core.import_is_all(n: imp))
      let block = if mod_has_wildcard {
        let wildcard_line = concat("use crate::", mod_name, "::*;")
        let reexport_surface = wildcard_reexport_surface_names(import_module: import_module, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
        let merged_specific = v1.compiler.emit_core_support.unique_strings(items: concat(
          mod_imports
            |> filter(imp => v1.std.core.import_is_all(n: imp) == false)
            |> flat_map(imp => v1.std.core.import_specific_names_at(n: imp, source_indices: source_indices)),
          reexport_surface
        ))
        let specific_block = emit_specific_import_block(
          import_module: import_module,
          mod_name: mod_name,
          filtered_names: merged_specific,
          emit_info: emit_info,
          registry: registry,
          local_names: local_names,
          export_sets: export_sets,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index)
        if specific_block != "" {
          concat(wildcard_line, "\n", specific_block)
        } else {
          wildcard_line
        }
      } else {
        let specific_names = mod_imports |> flat_map(imp => v1.std.core.import_specific_names_at(n: imp, source_indices: source_indices))
        let synth_for_module = module_data_field_struct_import_names(items: supplement_items, type_summaries: emit_info.type_summaries, import_module: import_module, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
        let merged_specific = v1.compiler.emit_core_support.unique_strings(items: concat(specific_names, synth_for_module))
        emit_specific_import_block(
          import_module: import_module,
          mod_name: mod_name,
          filtered_names: merged_specific,
          emit_info: emit_info,
          registry: registry,
          local_names: local_names,
          export_sets: export_sets,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index)
      }
      block |> split(delimiter: "\n")
    )
    dedupe_rust_import_lines(lines: import_lines) |> join(separator: "\n")
  }
}

fn type_node_is_faithful_string_leaf(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let _n = n
  let _si = source_indices
  false
}

fn node_tree_has_faithful_string_leaf(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if type_node_is_faithful_string_leaf(n: n, source_indices: source_indices) {
    true
  } else {
    let child_hit = n.children |> any(child => node_tree_has_faithful_string_leaf(n: child, source_indices: source_indices))
    let annotation_hit = match n.type_annotation {
      Present { value: ta } => node_tree_has_faithful_string_leaf(n: ta, source_indices: source_indices)
      Absent => false
    }
    let inferred_hit = match n.inferred {
      Present { value: v1.std.core.Resolved { node: rt } } => node_tree_has_faithful_string_leaf(n: rt, source_indices: source_indices)
      _ => false
    }
    child_hit || annotation_hit || inferred_hit
  }
}

fn node_tree_references_type_name(n: v1.std.core.Node, type_name: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if v1.std.core.authored_name_at(source_indices: source_indices, node: n) == type_name {
    true
  } else {
    let child_hit = n.children |> any(child => node_tree_references_type_name(n: child, type_name: type_name, source_indices: source_indices))
    let annotation_hit = match n.type_annotation {
      Present { value: ta } => node_tree_references_type_name(n: ta, type_name: type_name, source_indices: source_indices)
      Absent => false
    }
    let inferred_hit = match n.inferred {
      Present { value: v1.std.core.Resolved { node: rt } } => node_tree_references_type_name(n: rt, type_name: type_name, source_indices: source_indices)
      _ => false
    }
    child_hit || annotation_hit || inferred_hit
  }
}

data data_field_struct_import_provider_note: String = "§3 single authority for 'which module PROVIDES this field-struct name'. extdeps.access.zanzibar.This synth exists because an ANONYMOUS record literal takes its type from the FIELD it initializes (an unnamed record literal on the `io` field), so the constructed type name appears NOWHERE in the source text and can therefore never sit in an authored import list — emit_imports, which derives use-lines only from import lists, has no candidate to work from and the emitted Rust refuses (E0422 `cannot find struct ... in this scope`).

The predicate was `has_physical_type_def_in_module_filename` — field type PHYSICALLY DEFINED in the module being imported from. That is strictly narrower than the question actually being asked, which is whether the imported module PROVIDES the name. `extdeps.realization.compile_stage_memo` imports extdeps.cache.types.CacheInterfaceCatalogFacts from `extdeps.cache.types` and constructs its `io` / `placement` fields, but those types are defined in the SIBLING modules `extdeps.cache.catalog_io` / `extdeps.cache.catalog_placement` and merely re-exported by `extdeps.cache.types` — so the physical-definition test rejected them and the use-line was never synthesized. Measured, not assumed: materialization_carriers first_error = error E0422 cannot find struct, variant or union type extdeps.cache.catalog_io.CacheInterfaceCatalogIoSemantics in this scope.

`name_in_transitive_export_surface` is the existing authority for that question (get_exported_names counts specific-import names as exports, which is exactly re-export), so this reuses it rather than minting a second reachability rule. Routing needs no change: graph_type_import_module_filename already groups emitted use-lines by the type's DEFINING module, so admitting the candidate yields a braced use-line against crate::extdeps_cache_catalog_io on its own.

INCREMENT 2 (generic-argument axis, #6986): build_field_type_map also walks the resolved field-type NODE TREE via collect_type_node_import_surface_names (04_emit_info.dag), populating TypeSummary.field_import_surface_names; this synth consumes that list so std.types.List<std.cache_interface.CacheEvidence> admits std.cache_interface.CacheEvidence (field_type_map still maps field→v2.std.network.HEAD for lookup). v2.std.witness.Witness: field_import_surface_generic_arg_test. Re-probe 2026-07-21: materialization_carriers std.cache_interface.CacheEvidence E0422 cleared; first error advanced to E0425 cannot find value extdeps (namespace/dotted-path class — distinct blocker)."

fn module_data_field_struct_import_names(items: std.types.List<v1.std.core.Node>, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, import_module: String, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_index: ModuleIndex) -> std.types.List<String> {
  v1.compiler.emit_core_support.unique_strings(items: items
    |> filter(item => v1.compiler.emit_core_support.is_data_def_item(item: item))
    |> flat_map(item => {
      let type_name = match item.type_annotation {
        Present { value: ta } => v1.std.core.authored_name_at(source_indices: source_indices, node: ta)
        Absent => ""
      }
      if type_name == "" {
        []
      } else {
        match map_get(type_summaries, type_name) {
          Present { value: summary } =>
            summary.field_import_surface_names |> filter(field_type =>
              field_type != ""
              && name_in_transitive_export_surface(name: field_type, module_name: import_module, visited: [], export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
              && match map_get(type_summaries, field_type) {
                Present { value: ft } =>
                  match ft.repr {
                    StructRepr => true
                    _ => false
                  }
                Absent => false
              }
            )
          Absent => []
        }
      }
    }))
}

fn typed_closure_includes_module_filename(typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, filename: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  typed_modules |> any(tm => v1.compiler.emit_core_support.module_to_filename(name: v1.std.core.authored_name_at(source_indices: source_indices, node: tm.module)) == filename)
}

fn module_item_has_faithful_string_leaf(item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  node_tree_has_faithful_string_leaf(n: item, source_indices: source_indices)
    || item.params |> any(p => node_tree_has_faithful_string_leaf(n: p, source_indices: source_indices))
    || match item.body {
      Present { value: body } => node_tree_has_faithful_string_leaf(n: body, source_indices: source_indices)
      Absent => false
    }
}

fn module_item_references_type_name(item: v1.std.core.Node, type_name: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  node_tree_references_type_name(n: item, type_name: type_name, source_indices: source_indices)
    || match item.type_annotation {
      Present { value: ta } => node_tree_references_type_name(n: ta, type_name: type_name, source_indices: source_indices)
      Absent => false
    }
    || item.params |> any(p => node_tree_references_type_name(n: p, type_name: type_name, source_indices: source_indices))
    || match item.body {
      Present { value: body } => node_tree_references_type_name(n: body, type_name: type_name, source_indices: source_indices)
      Absent => false
    }
}

fn module_item_references_faithful_expanded_type(item: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  module_item_references_type_name(item: item, type_name: "ByteSize", source_indices: source_indices)
    || module_item_references_type_name(item: item, type_name: "Measure", source_indices: source_indices)
    || module_item_references_type_name(item: item, type_name: "Map", source_indices: source_indices)
}

fn module_needs_faithful_carrier_imports(items: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if true {
    false
  } else {
    module_renders_faithful_text_carrier(items: items, source_indices: source_indices)
    || items |> any(item =>
      module_item_references_type_name(item: item, type_name: "FreeMonoid", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "Char", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "NonEmptyStr", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "Int", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "PartialFunction", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "Memory", source_indices: source_indices)
      || module_item_references_faithful_expanded_type(item: item, source_indices: source_indices)
    )
  }
}

fn module_renders_faithful_text_carrier(items: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if true {
    false
  } else {
    items |> any(item => module_item_has_faithful_string_leaf(item: item, source_indices: source_indices))
  }
}

fn rust_import_name_already_resolved(imported_names: std.types.List<String>, local_type_names: std.types.List<String>, name: String) -> Bool {
  imported_names |> any(n => n == name) || local_type_names |> any(n => n == name)
}

fn emit_faithful_text_carrier_import_lines(imported_names: std.types.List<String>, local_type_names: std.types.List<String>, items: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, shared_types: std.types.Set<String>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>) -> std.types.List<String> {
  let closure_has_std_measure = typed_closure_includes_module_filename(typed_modules: typed_modules, filename: "std_measure", source_indices: source_indices)
  let needs_free_monoid = items |> any(item =>
    module_item_has_faithful_string_leaf(item: item, source_indices: source_indices)
    || module_item_references_type_name(item: item, type_name: "FreeMonoid", source_indices: source_indices)
  )
  let needs_char = items |> any(item =>
    module_item_has_faithful_string_leaf(item: item, source_indices: source_indices)
    || module_item_references_type_name(item: item, type_name: "Char", source_indices: source_indices)
  )
  let needs_non_empty_str = items |> any(item => module_item_references_type_name(item: item, type_name: "NonEmptyStr", source_indices: source_indices))
  let needs_int = items |> any(item => module_item_references_type_name(item: item, type_name: "Int", source_indices: source_indices))
  let needs_partial_function = items |> any(item =>
    module_item_references_type_name(item: item, type_name: "PartialFunction", source_indices: source_indices)
    || module_item_references_type_name(item: item, type_name: "Map", source_indices: source_indices)
  )
  let needs_measure_phantoms = closure_has_std_measure && items |> any(item => module_item_references_faithful_expanded_type(item: item, source_indices: source_indices))
  let free_monoid = if !needs_free_monoid || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "FreeMonoid") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_algebra::FreeMonoid;")]
  }
  let char_line = if !needs_char || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "Char") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_types::Char;")]
  }
  let non_empty_str = if !needs_non_empty_str || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "NonEmptyStr") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_types::NonEmptyStr;")]
  }
  let int_line = if !needs_int || local_type_names |> any(n => n == "Int") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::v2_std_integer::Int;")]
  }
  let partial_function = if !needs_partial_function || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "PartialFunction") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_algebra::PartialFunction;")]
  }
  let memory = if !needs_measure_phantoms || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "Memory") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_measure::Memory;")]
  }
  let one = if !needs_measure_phantoms || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "One") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_measure::One;")]
  }
  concat(free_monoid, char_line, non_empty_str, int_line, partial_function, memory, one)
}

fn emit_prelude(imported_names: std.types.List<String>, local_type_names: std.types.List<String>) -> String {
  let base = concat(
    "use im::\{vector as vec, HashMap, OrdSet as BTreeSet, Vector as Vec\};\n",
    "use crate::v1_rt::\{VecCompat, VecJoin\};\n",
    "use std::rc::Rc;\n",
    "use crate::v1_rt;")
  let wrapper_use = "\nuse crate::NonEmptyVec;\nuse crate::NonEmptyBTreeSet;"
  concat(base, wrapper_use)
}

fn emit_non_empty_wrappers() -> String {
  let vec_wrapper = concat(
    "pub struct NonEmptyVec<T>(Vec<T>);\n\n",
    "impl<T: Clone + std::fmt::Debug> std::fmt::Debug for NonEmptyVec<T> {\n",
    "    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n",
    "        f.debug_tuple(\"NonEmptyVec\").field(&self.0).finish()\n",
    "    }\n",
    "}\n\n",
    "impl<T: Clone> Clone for NonEmptyVec<T> {\n",
    "    fn clone(&self) -> Self {\n",
    "        Self(self.0.clone())\n",
    "    }\n",
    "}\n\n",
    "impl<T: Clone + PartialEq> PartialEq for NonEmptyVec<T> {\n",
    "    fn eq(&self, other: &Self) -> bool {\n",
    "        self.0 == other.0\n",
    "    }\n",
    "}\n\n",
    "impl<T: Clone> NonEmptyVec<T> {\n",
    "    pub fn new(items: Vec<T>) -> Result<Self, &'static str> {\n",
    "        if items.is_empty() {\n",
    "            Err(\"NonEmptyVec requires at least one element\")\n",
    "        } else {\n",
    "            Ok(Self(items))\n",
    "        }\n",
    "    }\n\n",
    "    pub fn into_vec(self) -> Vec<T> {\n",
    "        self.0\n",
    "    }\n",
    "}"
  )
  let set_wrapper = concat(
    "#[derive(Debug, Clone, PartialEq)]\n",
    "pub struct NonEmptyBTreeSet<T: Ord>(std::collections::BTreeSet<T>);\n\n",
    "impl<T: Ord> NonEmptyBTreeSet<T> {\n",
    "    pub fn new(items: std::collections::BTreeSet<T>) -> Result<Self, &'static str> {\n",
    "        if items.is_empty() {\n",
    "            Err(\"NonEmptyBTreeSet requires at least one element\")\n",
    "        } else {\n",
    "            Ok(Self(items))\n",
    "        }\n",
    "    }\n\n",
    "    pub fn as_set(&self) -> &std::collections::BTreeSet<T> {\n",
    "        &self.0\n",
    "    }\n\n",
    "    pub fn into_set(self) -> std::collections::BTreeSet<T> {\n",
    "        self.0\n",
    "    }\n",
    "}"
  )
  concat(vec_wrapper, "\n\n", set_wrapper)
}

fn emit_typed_item(item: v1.std.core.Node, module_name: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, wire_contract_item: v1.std.core.Node?, data_items: std.types.Map<String, std.types.List<v1.std.core.Node>>, module_items: std.types.List<v1.std.core.Node>, imports: std.types.List<v1.std.core.Node>, export_sets: std.types.Map<String, std.types.Map<String, Bool>>, typed_modules: std.types.List<v1.compiler.infer_items.TypedModule>, module_index: ModuleIndex) -> String {
  let env = scope.type_env
  let qualified_name = concat(module_name, ".", v1.compiler.infer_env.authored_name(env: env, node: item))
  let item_text = v1.compiler.infer_env.authored_name(env: env, node: item)
  if v1.compiler.emit_core_support.is_type_def_item(item: item) {
    emit_type_def_from_connective(item: item, recursive_types: emit_info.recursive_type_set, shared_types: shared_types, env: env, emit_info: emit_info, wire_contract_item: wire_contract_item, data_items: data_items, module_items: v1.std.core.module_items, imports: imports)
  } else if v1.compiler.emit_core_support.is_type_alias_item(item: item, source_indices: env.source_indices) {

    if item_text == "String" {
      rust_string_grounded_type_alias_decl_line()
    } else if (item.params |> count) == 0 && rust_opaque_kernel_alias_type_eligible(name: item_text) {
      rust_opaque_kernel_alias_type_decl(name: item_text)
    } else if (item.params |> count) == 0 && rust_nominal_identity_carrier_type_eligible(type_name: item_text) {
      rust_nominal_identity_carrier_def(name: item_text)
    } else if is_zero_param_self_referential_opaque_decl(item: item, source_indices: env.source_indices) {
      emit_zero_param_phantom_opaque_struct(item: item, map_key_required: set_contains(emit_info.map_key_required_type_names, item_text), source_indices: env.source_indices)
    } else {
      match rust_scalar_checkpoint_render_base(dag_name: item_text, decl_file: decl_identity_file(item: item)) {
        Present { value: host } =>
          concat(rust_visibility_prefix(), rust_items().type_alias_keyword, " ", item_text, " = ", host, ";")
        Absent =>
          concat(rust_visibility_prefix(), rust_items().type_alias_keyword, " ", item_text, " = ", render_rust_alias_rhs_type(
            n: resolved_type(n: item),
            generic_param_names: [],
            shared_types: shared_types,
            source_indices: env.source_indices,
            scope: scope,
            imports: imports,
            registry: registry,
            module_name: module_name,
            export_sets: export_sets,
            typed_modules: typed_modules,
            module_index: module_index,
            variant_to_enum: emit_info.variant_to_enum), ";")
      }
    }
  } else if v1.compiler.emit_core_support.is_type_decl_item(item: item, source_indices: env.source_indices) {
    if (item.params |> count) == 0 && rust_opaque_kernel_alias_type_eligible(name: item_text) {
      rust_opaque_kernel_alias_type_decl(name: item_text)
    } else if (item.params |> count) == 0 && rust_nominal_identity_carrier_type_eligible(type_name: item_text) {
      rust_nominal_identity_carrier_def(name: item_text)
    } else {

      match rust_seed_host_container_base(name: item_text) {
        Present { value: host } =>
          let type_params = emit_type_params(params: item.params, source_indices: env.source_indices)
          let generic_names = item_generic_param_names(item: item, source_indices: env.source_indices)
          concat(
            rust_visibility_prefix(),
            rust_items().type_alias_keyword,
            " ",
            item_text,
            type_params,
            " = ",
            host,
            "<",
            generic_names |> map(n => v1.compiler.emit_core_support.to_pascal(name: n)) |> join(separator: ", "),
            ">;"
          )
        Absent =>
          if is_emittable_parametric_type_alias_item(item: item, item_text: item_text, source_indices: env.source_indices, module_name: module_name, imports: imports, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index) {
            let type_params = emit_type_params(params: item.params, source_indices: env.source_indices)
            let generic_names = item_generic_param_names(item: item, source_indices: env.source_indices)
            let alias_rhs = resolved_type(n: item)
            let unused_params = alias_unused_param_names(generic_param_names: generic_names, rhs: alias_rhs, source_indices: env.source_indices)
            let rhs_str = if unused_params |> count > 0 {
              concat("std::marker::PhantomData<", rust_phantom_marker_inner(unused: unused_params), ">")
            } else {
              render_rust_alias_rhs_type(
                n: alias_rhs,
                generic_param_names: generic_names,
                shared_types: shared_types,
                source_indices: env.source_indices,
                scope: scope,
                imports: imports,
                registry: registry,
                module_name: module_name,
                export_sets: export_sets,
                typed_modules: typed_modules,
              module_index: module_index,
              variant_to_enum: emit_info.variant_to_enum)
            }
            concat(
              rust_visibility_prefix(),
              rust_items().type_alias_keyword,
              " ",
              item_text,
              type_params,
              " = ",
              rhs_str,
              ";"
            )
          } else if is_parametric_opaque_type_decl_item(item: item, source_indices: env.source_indices) {
            emit_parametric_phantom_opaque_struct(item: item, map_key_required: set_contains(emit_info.map_key_required_type_names, item_text), source_indices: env.source_indices)
          } else {
            ""
          }
      }
    }
  } else if v1.compiler.emit_core_support.is_function_item(item: item) {
    let fn_movable = match map_get(emit_info.ownership_index, qualified_name) {
      Present { value: m } => m
      Absent => empty_set()
    }
    let item_is_tco = v1.compiler.emit.is_tco_eligible(name: v1.compiler.infer_env.authored_name(env: env, node: item), body: item.body.value, registry: registry, source_indices: env.source_indices)
    let fn_read_only = if item_is_tco { empty_set() } else {
      match map_get(emit_info.read_only_params_index, qualified_name) {
        Present { value: m } => m
        Absent => empty_set()
      }
    }
    let fn_emit_info = v1.compiler.infer_emit_info.EmitGraphInfo {
      type_summaries: emit_info.type_summaries,
      type_decl_items: emit_info.type_decl_items,
      fn_decl_items: emit_info.fn_decl_items,
      recursive_type_set: emit_info.recursive_type_set,
      fielded_variants: emit_info.fielded_variants,
      positional_payload_variants: emit_info.positional_payload_variants,
      shared_types: emit_info.shared_types,
      ownership_index: emit_info.ownership_index,
      movable: fn_movable,
      variant_to_enum: emit_info.variant_to_enum,
      owned_bindings: empty_set(),
      read_only_params_index: emit_info.read_only_params_index,
      read_only_params: fn_read_only,
      clone_bounded_type_params: emit_info.clone_bounded_type_params,
      map_key_required_type_names: emit_info.map_key_required_type_names,
      clone_impl_required_type_params: emit_info.clone_impl_required_type_params,
      fn_generic_param_names: emit_info.fn_generic_param_names,
      fn_type_env: emit_info.fn_type_env,
      fn_return_type: emit_info.fn_return_type
    }

    let is_effectful = match v1.compiler.emit.lookup_item(registry: registry, name: v1.compiler.infer_env.authored_name(env: env, node: item)) {
      Present { value: info } => info.service_names |> count > 0 || info.resource_names |> count > 0
      Absent => false
    }
    if is_effectful {
      emit_func_def(name: item_text, params: item.params, inferred: resolved_type(n: item), uses: item.uses, body: item.body.value, registry: registry, scope: scope, shared_types: shared_types, emit_info: fn_emit_info)
    } else {
      emit_fn_def(name: item_text, params: item.params, inferred: resolved_type(n: item), body: item.body.value, registry: registry, scope: scope, shared_types: shared_types, emit_info: fn_emit_info)
    }
  } else if v1.compiler.emit_core_support.is_data_def_item(item: item) {
    emit_data_def(name: item_text, type_node: item.type_annotation.value, value: item.body.value, registry: registry, scope: scope, depth: 0, shared_types: shared_types, emit_info: emit_info)
  } else if v1.compiler.emit_core_support.is_service_def_item(item: item) {
    emit_service_def(item: item, registry: registry, shared_types: shared_types, env: env)
  } else if v1.compiler.emit_core_support.is_resource_def_item(item: item) {
    emit_resource_def(item: item, shared_types: shared_types, env: env)
  } else {
    concat("compile_error!(\"unhandled item: ", item_text, "\");")
  }
}

fn needs_box_wrapping(n: v1.std.core.Node, recursive_types: std.types.Set<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let name = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  if set_contains(shared_types, name) { false }
  else if set_contains(recursive_types, name) { true }
  else if n.children |> count == 0 {
    if v1.compiler.coercion.coerce_primitive_type(target: v1.compiler.artifact.Rust, dag_name: name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)) != name { false }
    else { set_contains(recursive_types, name) }
  } else {
    let is_optional = n.return_cardinality == v1.std.core.CardOptional
    if is_optional {
      needs_box_wrapping(n: v1.std.core.with_required_cardinality(n: n), recursive_types: recursive_types, shared_types: shared_types, source_indices: source_indices)
    } else {
      false
    }
  }
}

fn emit_type_params(params: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  if params |> count == 0 { "" }
  else {
    let names = params |> map(p => v1.compiler.emit_core_support.to_pascal(name: v1.std.core.generic_param_name_at(n: p, source_indices: source_indices)))
    concat("<", names |> join(separator: ", "), ">")
  }
}

fn emit_bare_type_params(generic_param_names: std.types.List<String>) -> String {
  if generic_param_names |> count == 0 { "" }
  else {
    concat("<", generic_param_names |> map(n => v1.compiler.emit_core_support.to_pascal(name: n)) |> join(separator: ", "), ">")
  }
}

fn emit_type_params_with_clone_bound(params: std.types.List<v1.std.core.Node>, clone_param: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  if params |> count == 0 { "" }
  else {
    let names = params |> map(p =>
      let pname = v1.std.core.generic_param_name_at(n: p, source_indices: source_indices)
      let pascal = v1.compiler.emit_core_support.to_pascal(name: pname)
      if pname == clone_param { concat(pascal, ": Clone") } else { pascal }
    )
    concat("<", names |> join(separator: ", "), ">")
  }
}

fn is_function_type_param(param: v1.std.core.Node) -> Bool {
  let type_expr = v1.std.core.param_node_type_expr(n: param)
  let type_expr_is_var = match type_expr.inferred {
    Present { value: inf } => is_type_variable(inferred: inf)
    Absent => false
  }
  let same_source_span = param.span.file == type_expr.span.file && param.span.start == type_expr.span.start && param.span.end == type_expr.span.end

  param.name != "" && param.name == type_expr.name && (type_expr_is_var || same_source_span)
}

fn function_type_params(params: std.types.List<v1.std.core.Node>) -> std.types.List<v1.std.core.Node> {
  params |> filter(p => is_function_type_param(param: p))
}

fn function_value_params(params: std.types.List<v1.std.core.Node>) -> std.types.List<v1.std.core.Node> {
  params |> filter(p => !is_function_type_param(param: p))
}

fn function_type_params_have_collision(type_params: std.types.List<v1.std.core.Node>) -> Bool {
  let names = type_params |> map(p => p.name)
  (names |> count) > (v1.compiler.emit_core_support.unique_strings(items: names) |> count)
}

fn emit_item_type_params_with_clone_bounds(item_name: String, params: std.types.List<v1.std.core.Node>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  let generic_param_names = params |> map(p => v1.std.core.generic_param_name_at(n: p, source_indices: source_indices))
  let clone_param_names = v1.compiler.trait_derive_emit.v1_item_clone_bounded_param_names(
    item_name: item_name,
    generic_param_names: generic_param_names,
    bounds: emit_info.clone_bounded_type_params
  )
  if (clone_param_names |> count) > 0 {
    v1.compiler.trait_derive_emit.v1_emit_type_params_with_clone_bounds(params: params, clone_param_names: clone_param_names, source_indices: source_indices)
  } else {
    emit_type_params(params: params, source_indices: source_indices)
  }
}

// The SINGLE well-formedness fact the GroupCompletion supplemental impls need, read from the same
// record `emit_item_type_params_with_clone_bounds` reads (`clone_bounded_type_params`) rather than
// re-derived beside it. Rust REQUIRES an impl's generics to satisfy the type's own bounds, so
// `struct S<M: Clone>` with `impl<M> Neg for S<M>` cannot compile: the item header and the impl
// header are ONE decision rendered twice, which makes single authority the construction answer
// here rather than a style preference.
//
// What crosses into `extdeps.languages.rust.emit` is this Bool — a compiler fact about the
// carrier's declaration. The SPELLING (`Clone`, the trait paths, the where-clauses) stays in
// extdeps, so the §3 duty is intact. It is deliberately NOT routed through
// `spelling.where_bounds`: that field carries the OP's own requirement (a fact about `Neg`/`Add`),
// and the carrier bound is a fact about `GroupCompletion` — merging them would recreate the fused
// flag this change exists to split, and the two have different lifetimes (a new op row changes
// where_bounds and never changes the carrier's WF bound).
//
// KNOWN ASYMMETRY, named rather than fixed here: the item header is rendered compiler-side
// (`emit_item_type_params_with_clone_bounds`) while the impl header is rendered in extdeps, so the
// tree answers "where does a Rust bound get spelled" two different ways. Out of scope for this
// change.
fn v1_carrier_param_needs_clone_bound(item_name: String, generic_param_names: std.types.List<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> Bool {
  (v1.compiler.trait_derive_emit.v1_item_clone_bounded_param_names(
    item_name: item_name,
    generic_param_names: generic_param_names,
    bounds: emit_info.clone_bounded_type_params
  ) |> count) > 0
}

fn emit_item_clone_bound_refusal(item: v1.std.core.Node, item_name: String, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  if (item.params |> count) == 0 {
    ""
  } else {
    let head = v1.compiler.trait_derive_emit.v1_item_clone_undecided_head(
      item: item,
      type_decl_items: emit_info.type_decl_items,
      source_indices: source_indices
    )
    if head == "" {
      ""
    } else {
      v1.compiler.trait_derive_emit.v1_trait_derive_refuse(concat("trait_derive_emit: generic item '", item_name, "' has a field applying type '", head, "', whose declared parameter list is not readable in this closure — the Clone bound it may require on '", item_name, "' cannot be decided (see trait_derive_emit_item_clone_bound_wf_propagation_note)"))
    }
  }
}

// Struct header bareness is keyed on the FIELD-DERIVED property, not on `impl_bodies` being
// nonempty. `emit_item_type_params_with_clone_bounds` reads `clone_bounded_type_params`, the
// WELL-FORMEDNESS fixpoint — "does NAMING G<A..> require P: Clone" — which is exactly "does some
// field's type require this parameter to carry a bound".
//
// A supplemental impl discharges the DERIVE obligation (cloning G) and CANNOT discharge a field's
// well-formedness obligation, so `impl_bodies != ""` was a CORRELATE of the real property that
// happened to agree on the cases Row 1a was measured against. It disagreed on
// `AmbiguousBindingCandidates<N>`, whose field `Rc<BindingCandidate<N>>` needs `N: Clone` to be
// nameable at all: the emitted header went bare and rustc refused with E0277. The discriminating
// oracle is the committed mirror, which main emits as `<N: Clone>` — a prior-release baseline
// produced by a DIFFERENT emitter than the one under test, not a literal copied from this tree.
//
// An exception clause would have made the correlate agree on one more case; deriving from the
// field-level record makes the question go away.
//
// DECLARED BOUNDARY — `has_fn_fields` IS ITSELF PARTLY A PROXY, and the honest state is "no
// instance today", NOT "cannot occur". It is a real discriminator for the DERIVE half: a derive
// emits PER-IMPL bounds, so `Monoid<T> { identity: T, .. }` with `#[derive(Clone)]` gets
// `impl<T: Clone> Clone for Monoid<T>` generated and needs no header bound. It has NO authority
// over the WELL-FORMEDNESS half, which is independent of derives entirely — naming a declared type
// whose parameters are bounded is ill-formed whatever the struct derives — yet it gates that
// computation too.
//
// Measured, not assumed: the seed closure holds 17 callable-field generic structs (16 derive
// Clone); their complete set of non-callable, non-phantom fields is `&'a str`, `identity: T`,
// `zero: T`, `one: T`, `top: T`, `bottom: T`, and `Rc<PartialFunction<K, V>>`. Exactly one names a
// declared type, and `PartialFunction<K, V>` is itself emitted bare, so it carries no obligation.
// The exposing population is therefore EMPTY. That is a closed enumeration, not a spot check.
//
// WHY THIS IS DEFERRED, and it is NOT that evidence is unavailable: the new arm is provable by a
// controlled fixture, and the regression risk — re-bounding the 16 derive carriers that correctly
// stay bare — is testable against the real corpus by regenerating to a fixed point over the live
// 17. Both are available today. The reason is §6 displaced cost: with the population empty the
// benefit is ZERO, while the change carries nonzero regression risk against 17 live carriers and
// consumes the one scarce slot on this file, ahead of work with a live population. It is worth
// less than what it displaces, today — not unverifiable.
//
// NEXT-RUNG TRIGGER: the first carrier with a callable field that ALSO names a
// well-formedness-bounded declared type (the `AmbiguousBindingCandidates` shape with a callable
// field added — the callable field is irrelevant to why the bound is owed). The repair is the same
// move as above: split `has_fn_fields` into the two questions it answers, so the derive half keeps
// suppressing the header bound and the WF half is never consulted about callable fields at all.
// EVIDENCE IT OWES, both halves: a controlled fixture for the new arm, PLUS a regen fixed point
// over the existing 17 callable-field carriers as the regression control. A fixture alone is thin.
fn emit_type_def_from_connective(item: v1.std.core.Node, recursive_types: std.types.Set<String>, shared_types: std.types.Set<String>, env: v1.compiler.infer_env.TypeEnv, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, wire_contract_item: v1.std.core.Node?, data_items: std.types.Map<String, std.types.List<v1.std.core.Node>>, module_items: std.types.List<v1.std.core.Node>, imports: std.types.List<v1.std.core.Node>) -> String {
  let item_text = v1.compiler.infer_env.authored_name(env: env, node: item)
  let is_product = v1.compiler.infer_types.is_product_type(n: item)
  if is_product {
    let has_fn_fields = type_has_fn_fields(name: item_text, emit_info: emit_info)
    let capability_surface = v1.compiler.trait_derive_emit.v1_emit_struct_from_capability_table(
      module_path: env.module_path,
      name: item_text,
      children: item.children,
      shared_types: shared_types,
      has_fn_fields: has_fn_fields,
      map_key_required: set_contains(emit_info.map_key_required_type_names, item_text),
      generic_param_names: item.params |> map(p => v1.std.core.generic_param_name_at(n: p, source_indices: env.source_indices)),
      source_indices: env.source_indices,
      carrier_param_needs_clone: v1_carrier_param_needs_clone_bound(
        item_name: item_text,
        generic_param_names: item.params |> map(p => v1.std.core.generic_param_name_at(n: p, source_indices: env.source_indices)),
        emit_info: emit_info
      ),
      type_decl_items: emit_info.type_decl_items
    )
    let type_params = if !has_fn_fields {
      emit_item_type_params_with_clone_bounds(item_name: item_text, params: item.params, emit_info: emit_info, source_indices: env.source_indices)
    } else {
      emit_type_params(params: item.params, source_indices: env.source_indices)
    }
    let generic_param_names = item.params |> map(p => v1.std.core.generic_param_name_at(n: p, source_indices: env.source_indices))
    let clone_bound_refusal = emit_item_clone_bound_refusal(item: item, item_name: item_text, emit_info: emit_info, source_indices: env.source_indices)
    let struct_text = emit_struct_from_children(name: item_text, type_params: type_params, generic_param_names: generic_param_names, children: item.children, recursive_types: recursive_types, shared_types: shared_types, env: env, emit_info: emit_info)
    if clone_bound_refusal == "" { struct_text } else { concat(clone_bound_refusal, "\n", struct_text) }
  } else if is_host_optional_carrier_alias(name: item_text) {
    let type_params = emit_type_params(params: item.params, source_indices: env.source_indices)
    let elem_csv = item.params |> map(p => v1.compiler.emit_core_support.to_pascal(name: v1.std.core.generic_param_name_at(n: p, source_indices: env.source_indices))) |> join(separator: ", ")
    concat(rust_visibility_prefix(), "type ", item_text, type_params, " = Option<", elem_csv, ">;")
  } else if is_host_freemonoid_vec_alias(name: item_text) {
    let type_params = emit_type_params(params: item.params, source_indices: env.source_indices)
    let elem_csv = item.params |> map(p => v1.compiler.emit_core_support.to_pascal(name: v1.std.core.generic_param_name_at(n: p, source_indices: env.source_indices))) |> join(separator: ", ")
    concat(rust_visibility_prefix(), "type ", item_text, type_params, " = Vec<", elem_csv, ">;")
  } else if is_host_diagnostics_carrier_alias(name: item_text) {
    let type_params = emit_type_params(params: item.params, source_indices: env.source_indices)
    concat(rust_visibility_prefix(), "type ", item_text, type_params, " = ", render_rust_diagnostics_carrier_applied(shared_types: shared_types), ";")
  } else {
    let all_unit_variants = item.children |> all(child => child.children |> count == 0)
    let serde_policy = match resolve_local_coproduct_wire_policy(coproduct_name: item_text, all_unit_variants: all_unit_variants, module_items: v1.std.core.module_items, imports: imports, source_indices: env.source_indices) {
      Present { value: local_policy } => local_policy
      Absent =>
        if all_unit_variants {
          match wire_contract_item {
            Present { value: _ } => resolve_wire_serde_policy_for_coproduct(wire_contract_item: wire_contract_item, source_indices: env.source_indices, data_items: data_items)
            Absent => rust_tagged_object_policy()
          }
        } else {
          rust_tagged_object_policy()
        }
    }
    let rename_validations = variant_rename_validations_for_policy(children: item.children, env: env, serde_policy: serde_policy)
    let policy_validation = match serde_policy.error_message {
      Present { value: message } => emit_rust_compile_error_item(message: message)
      Absent => ""
    }
    let validations = if policy_validation == "" {
      rename_validations
    } else if rename_validations == "" {
      policy_validation
    } else {
      concat(policy_validation, "\n", rename_validations)
    }
    let type_params = emit_item_type_params_with_clone_bounds(item_name: item_text, params: item.params, emit_info: emit_info, source_indices: env.source_indices)
    let generic_param_names = item.params |> map(p => v1.std.core.generic_param_name_at(n: p, source_indices: env.source_indices))
    let clone_bound_refusal = emit_item_clone_bound_refusal(item: item, item_name: item_text, emit_info: emit_info, source_indices: env.source_indices)
    let enum_text = emit_enum_from_children(name: item_text, type_params: type_params, generic_param_names: generic_param_names, children: item.children, recursive_types: recursive_types, shared_types: shared_types, env: env, serde_policy: serde_policy, emit_info: emit_info)
    let validations = if clone_bound_refusal == "" {
      validations
    } else if validations == "" {
      clone_bound_refusal
    } else {
      concat(validations, "\n", clone_bound_refusal)
    }
    if validations == "" {
      enum_text
    } else {
      concat(validations, "\n", enum_text)
    }
  }
}

fn type_node_mentions_name(n: v1.std.core.Node, target: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if v1.std.core.authored_name_at(source_indices: source_indices, node: n) == target {
    true
  } else {
    n.children |> any(c => type_node_mentions_name(n: c, target: target, source_indices: source_indices))
  }
}

fn struct_unused_param_names(generic_param_names: std.types.List<String>, children: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> std.types.List<String> {
  generic_param_names |> filter(p =>
    !(children |> any(child => type_node_mentions_name(n: v1.std.core.field_node_type_expr(n: child), target: p, source_indices: source_indices)))
  )
}

fn alias_unused_param_names(generic_param_names: std.types.List<String>, rhs: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> std.types.List<String> {
  generic_param_names |> filter(p =>
    !type_node_mentions_name(n: rhs, target: p, source_indices: source_indices)
  )
}

fn rust_phantom_marker_inner(unused: std.types.List<String>) -> String {
  let pascal_unused = unused |> map(n => v1.compiler.emit_core_support.to_pascal(name: n))
  if pascal_unused |> count == 1 {
    pascal_unused |> join(separator: ", ")
  } else {
    concat("(", pascal_unused |> join(separator: ", "), ")")
  }
}

fn rust_phantom_field_name() -> String { "_phantom" }

fn type_has_fn_fields(name: String, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> Bool {
  match map_get(emit_info.type_summaries, name) {
    Present { value: ts } => ts.has_fn_fields
    Absent => false
  }
}

fn struct_needs_serde(name: String, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> Bool {
  !type_has_fn_fields(name: name, emit_info: emit_info)
}

fn emit_struct_from_children(name: String, type_params: String, generic_param_names: std.types.List<String>, children: std.types.List<v1.std.core.Node>, recursive_types: std.types.Set<String>, shared_types: std.types.Set<String>, env: v1.compiler.infer_env.TypeEnv, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let has_fn_fields = type_has_fn_fields(name: name, emit_info: emit_info)
  let surface = v1.compiler.trait_derive_emit.v1_emit_struct_from_capability_table(
    module_path: env.module_path,
    name: name,
    children: children,
    shared_types: shared_types,
    has_fn_fields: has_fn_fields,
    map_key_required: set_contains(emit_info.map_key_required_type_names, name),
    generic_param_names: generic_param_names,
    source_indices: env.source_indices,
    carrier_param_needs_clone: v1_carrier_param_needs_clone_bound(
      item_name: name,
      generic_param_names: generic_param_names,
      emit_info: emit_info
    ),
    type_decl_items: emit_info.type_decl_items
  )
  if children |> count == 0 {
    concat(surface.derive_attr, "\n", rust_visibility_prefix(), rust_items().struct_keyword, " ", name, type_params, ";")
  } else {
    let field_lines = children |> map(child => emit_struct_field_from_child(struct_name: name, child: child, generic_param_names: generic_param_names, recursive_types: recursive_types, shared_types: shared_types, env: env, emit_info: emit_info))

    let unused_params = struct_unused_param_names(generic_param_names: generic_param_names, children: children, source_indices: env.source_indices)
    let all_field_lines = if unused_params |> count > 0 {
      concat(field_lines, [concat("    ", rust_visibility_prefix(), rust_phantom_field_name(), ": std::marker::PhantomData<", rust_phantom_marker_inner(unused: unused_params), ">,")])
    } else { field_lines }
    let fields_str = all_field_lines |> join(separator: "\n")
    let struct_def = concat(surface.derive_attr, "\n", rust_visibility_prefix(), rust_items().struct_keyword, " ", name, type_params, " {\n", fields_str, "\n}")
    if surface.impl_bodies == "" { struct_def } else { concat(struct_def, surface.impl_bodies) }
  }
}

data render_rust_type_applied_binding_env_note: String = "Construction wall for the zero-parameter-alias applied-argument class (E0107 'type alias takes 0 generic arguments but N were supplied'). A reference to a closed alias arrives at the emitter carrying the RESOLVED DEFINITION's type arguments as its children while its authored spelling is still the alias name, so a renderer that prints name-plus-children emits ClosedCarrierAlias<Q, S, M> for a Rust alias declared with no parameters. Four renderers already refuse that shape by asking the single peel authority closed_alias_peel_verdict: render_rust_applied_type, render_rust_decl_type, render_rust_fn_sig_type and render_rust_alias_rhs_type. This function is the fifth path, and it did NOT lack the guard -- it reached render_rust_applied_type, which asked, and was answered with an EMPTY TypeEnv this function constructed inline plus an empty_emit_graph_info() it passed to render_rust_type. An empty env resolves no binding, and the peel predicate renders 'I could not look this up' identically to 'this declaration has parameters' -- the state-space conflation DESIGN section 5 names, failing open into the widened applied form rather than refusing. Every one of this function's callers already holds the TypeEnv it was discarding, so the fix is to stop discarding it: the peel authority stays the single authority and is simply answered truthfully. Measured on the src/v2/compiler/03_ingest.dag closure. The next rung is upstream and not taken here: an alias reference that preserved its AUTHORED arity would make the bad shape unwritable rather than merely refused, at which point no renderer would need to ask at all."

fn render_rust_type_with_applied_binding(n: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, env: v1.compiler.infer_env.TypeEnv) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  match v1.std.core.find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
    Present { value: applied } =>
      if applied.children |> count > 0 {
        let outer_name = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
        let applied_name = v1.std.core.authored_name_at(source_indices: source_indices, node: applied)
        if outer_name != "" && n.connective == v1.std.core.NoConnective && (n.children |> count) == 0 {
          if outer_name != applied_name {
            render_rust_shared_type_with_optional(n: n, type_name: outer_name, rendered: outer_name, shared_types: shared_types)
          } else {
            render_rust_applied_type_shared(n: applied, generic_param_names: [], shared_types: shared_types, source_indices: source_indices, variant_to_enum: empty_map(), env: env)
          }
        } else {
          render_rust_applied_type_shared(n: applied, generic_param_names: [], shared_types: shared_types, source_indices: source_indices, variant_to_enum: empty_map(), env: env)
        }
      } else {
        render_rust_type(n: n, shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.emit_info_with_fn_type_context(emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info(), generic_param_names: [], env: env))
      }
    Absent => render_rust_type(n: n, shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.emit_info_with_fn_type_context(emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info(), generic_param_names: [], env: env))
  }
}

fn render_rust_field_type_with_applied_binding(field: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  let authored_type = v1.std.core.field_node_type_expr(n: field)
  if generic_param_names |> count > 0 {
    render_rust_decl_type(n: resolved_type(n: field), generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  } else if v1.std.core.find_property(props: field.properties, prop_name: "__applied_type_args", source_indices: source_indices) != none {
    render_rust_type_with_applied_binding(n: field, shared_types: shared_types, source_indices: source_indices, env: env)
  } else if v1.std.core.find_property(props: authored_type.properties, prop_name: "__applied_type_args", source_indices: source_indices) != none {
    render_rust_type_with_applied_binding(n: authored_type, shared_types: shared_types, source_indices: source_indices, env: env)
  } else if authored_type.connective == v1.std.core.NoConnective && authored_type.children |> count > 0 {
    render_rust_type(n: authored_type, shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info())
  } else {
    render_rust_type_with_applied_binding(n: resolved_type(n: field), shared_types: shared_types, source_indices: source_indices, env: env)
  }
}

data rust_field_carrier_final_type_note: String = "ONE field-carrier layer decision, asked once and projected at every field position. rust_carrier_is_at_shared_layer already unified the four positions that used to answer 'is this carrier at the shared reference layer?' from a rendering or an authored spelling; the ENUM VARIANT RECORD FIELD position was not among them and kept a needs_box_wrapping-only rule, so it rendered a shared cross-module carrier BARE while every other position -- the constructor, the destructuring, the callee signature -- rendered it Rc-wrapped. MEASURED at d72ffe8708b on the src/v2/compiler/03_ingest.dag closure: SymbolicCost::ConstantCost declared `value: Nat` while constant_cost took Rc<Nat>, constructed it with an Rc, and passed the destructured field to nat_dominates(Rc<Nat>); the nested-pattern lowering then emitted `value.as_ref()` against a bare &Nat, which is 18 of that board's 41 E0599 (9 sites x guard + prelude), all in v2_lens_cost.rs. The bareness is not the pattern lowering's defect -- the lowering is right about the layer and the declaration is wrong -- so the repair is at the declaration, and it is shared with the struct-field position rather than copied to it. SCOPE, stated so it is not read as wider: this covers the RECORD-field positions (struct fields and variant record fields). The positional (tuple) payload position renders through render_variant_payload_type and is a distinct path whose layer decision has to be established on its own evidence, not asserted here. RUNG (DESIGN 4b): mitigatable, inherited unchanged from rust_carrier_is_at_shared_layer -- nothing stops a sixth field position from re-deriving the layer locally; the next rung is the same modeled layer transition that predicate names."

fn rust_field_carrier_final_type(rt_field: v1.std.core.Node, ty: String, recursive_types: Set<String>, shared_types: Set<String>, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  if needs_box_wrapping(n: rt_field, recursive_types: recursive_types, shared_types: shared_types, source_indices: source_indices) {
    concat("Box<", ty, ">")
  } else if rust_carrier_is_at_shared_layer(n: rt_field, source_indices: source_indices, shared_types: shared_types) && !rust_type_is_rc_wrapped(type_name: ty) {
    wrap_shared_type(target: Rust, inner: ty)
  } else { ty }
}

fn emit_struct_field_from_child(struct_name: String, child: v1.std.core.Node, generic_param_names: List<String>, recursive_types: Set<String>, shared_types: Set<String>, env: v1.compiler.infer_env.TypeEnv, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let rt_child = resolved_type(n: child)
  let authored_child_type = v1.std.core.field_node_type_expr(n: child)
  let ty = if generic_param_names |> count > 0 {
    render_rust_decl_type(n: rt_child, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
  } else if v1.std.core.find_property(props: child.properties, prop_name: "__applied_type_args", source_indices: env.source_indices) != none {
    render_rust_type_with_applied_binding(n: child, shared_types: shared_types, source_indices: env.source_indices, env: env)
  } else if v1.std.core.find_property(props: authored_child_type.properties, prop_name: "__applied_type_args", source_indices: env.source_indices) != none {
    render_rust_type_with_applied_binding(n: authored_child_type, shared_types: shared_types, source_indices: env.source_indices, env: env)
  } else if v1.std.core.find_property(props: rt_child.properties, prop_name: "__applied_type_args", source_indices: env.source_indices) != none {
    render_rust_type_with_applied_binding(n: rt_child, shared_types: shared_types, source_indices: env.source_indices, env: env)
  } else if v1.compiler.infer_types.is_product_type(n: rt_child) && rt_child.ident_span != none && rt_child.children |> count > 2 {
    let rt_child_name = v1.std.core.authored_name_at(source_indices: env.source_indices, node: rt_child)
    match v1.compiler.infer_env.lookup_type_by_name(env: env, name: rt_child_name) {
      Present { value: resolved } =>
        if resolved.params |> count > 0 {
          let base = v1.compiler.coercion.coerce_primitive_type(target: v1.compiler.artifact.Rust, dag_name: rt_child_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: rt_child))
          let param_names = resolved.params |> map(p => v1.compiler.emit_core_support.to_pascal(name: v1.std.core.generic_param_name_at(n: p, source_indices: env.source_indices)))
          let with_params = concat(base, "<", param_names |> join(separator: ", "), ">")
          render_rust_shared_type_if_needed(type_name: rt_child_name, rendered: with_params, shared_types: shared_types)
        } else {
          render_rust_type(n: rt_child, shared_types: shared_types, source_indices: env.source_indices, emit_info: emit_info)
        }
      Absent => render_rust_type(n: rt_child, shared_types: shared_types, source_indices: env.source_indices, emit_info: emit_info)
    }
  } else {
    render_rust_type(n: rt_child, shared_types: shared_types, source_indices: env.source_indices, emit_info: emit_info)
  }
  let final_ty = rust_field_carrier_final_type(rt_field: rt_child, ty: ty, recursive_types: recursive_types, shared_types: shared_types, source_indices: env.source_indices)
  let needs_serde = struct_needs_serde(name: struct_name, emit_info: emit_info)
  let rename_attr = if !needs_serde { "" } else {
    match child.properties |> filter(p => v1.std.core.field_init_node_name_at(n: p, source_indices: env.source_indices) == "from_key") |> first {
      Present { value: prop } => match v1.std.core.field_init_node_value(n: prop).expr_data {
        ExprLiteral { value: lv } => match lv {
          LitStr { value: key } => concat("    ", v1.compiler.emit_core_support.apply_type_template1(template: rust_serde_rename_template_text(), arg0: key), "\n")
          _ => ""
        }
        _ => ""
      }
      Absent => ""
    }
  }
  emit_rust_field_definition(authored: v1.compiler.infer_env.authored_name(env: env, node: child), final_ty: final_ty, rename_attr: rename_attr, indent: "    ", visibility: rust_visibility_prefix(), needs_serde: needs_serde)
}

fn emit_rust_field_definition(authored: String, final_ty: String, rename_attr: String, indent: String, visibility: String, needs_serde: Bool) -> String {
  let snake = v1.compiler.emit_core_support.to_snake(name: authored)
  let emitted = v1.compiler.emit.emit_ident(name: authored, target: v1.compiler.artifact.Rust)
  let keyword_rename = if needs_serde && emitted != snake && rename_attr == "" {
    concat(indent, "#[serde(rename = \"", snake, "\")]\n")
  } else { "" }
  concat(keyword_rename, rename_attr, indent, visibility, emitted, ": ", final_ty, ",")
}

fn enum_derives(name: String, children: std.types.List<v1.std.core.Node>, has_fn_fields: Bool, generic_param_names: std.types.List<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  v1.compiler.trait_derive_emit.v1_emit_enum_derives(
    children: children,
    has_fn_fields: has_fn_fields,
    map_key_required: set_contains(emit_info.map_key_required_type_names, name),
    generic_param_names: generic_param_names,
    source_indices: source_indices
  )
}

// Narrowing a coproduct's derive set to Clone is not only a fact about the derive line: a serde
// ATTRIBUTE has no macro left to consume it once the serde derives are gone, so an orphaned
// `#[serde(tag = ..)]` or a variant `#[serde(rename = ..)]` becomes "cannot find attribute serde
// in this scope" -- trading one error for another rather than removing it. The derive decision
// and the attribute decision are therefore one decision with two renderings, and both read the
// same has_fn_fields here rather than deriving it twice.
fn emit_enum_from_children(name: String, type_params: String, generic_param_names: std.types.List<String>, children: std.types.List<v1.std.core.Node>, recursive_types: std.types.Set<String>, shared_types: std.types.Set<String>, env: v1.compiler.infer_env.TypeEnv, serde_policy: RustEnumWireSerde, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let has_fn_fields = type_has_fn_fields(name: name, emit_info: emit_info)
  let derives = enum_derives(name: name, children: children, has_fn_fields: has_fn_fields, generic_param_names: generic_param_names, emit_info: emit_info, source_indices: env.source_indices)
  let effective_serde_policy = if has_fn_fields {
    rust_serde_policy(enum_attr: "", rename_prefix: none, rename_suffix: none, rename_style: none)
  } else { serde_policy }
  let variant_lines = children |> map(child => emit_variant_from_child(child: child, enum_name: name, generic_param_names: generic_param_names, recursive_types: recursive_types, shared_types: shared_types, env: env, serde_policy: effective_serde_policy, emit_info: emit_info))
  let variants_str = variant_lines |> join(separator: "\n")
  let tag_line = if effective_serde_policy.enum_attr == "" { "" } else { concat(effective_serde_policy.enum_attr, "\n") }
  let enum_def = concat(derives, "\n", tag_line, rust_visibility_prefix(), rust_items().enum_keyword, " ", name, type_params, " {\n", variants_str, "\n}")
  let accessor_impl = emit_enum_shared_accessors(name: name, type_params: type_params, generic_param_names: generic_param_names, children: children, recursive_types: recursive_types, shared_types: shared_types, env: env, emit_info: emit_info)
  let supplemental = v1.compiler.trait_derive_emit.v1_emit_enum_supplemental_impls(module_path: env.module_path, name: name, children: children, generic_param_names: generic_param_names, source_indices: env.source_indices)
  let with_accessors = if accessor_impl == "" { enum_def } else { concat(enum_def, "\n", accessor_impl) }
  if supplemental == "" { with_accessors } else { concat(with_accessors, supplemental) }
}

fn find_shared_enum_fields(children: std.types.List<v1.std.core.Node>, env: v1.compiler.infer_env.TypeEnv) -> std.types.List<String> {
  let fielded = children |> filter(child =>
    child.children |> count > 0
      && !variant_is_synthetic_positional_payload(fields: child.children, source_indices: env.source_indices)
  )
  if fielded |> count == 0 { return [] }
  let first_fields = match fielded |> first {
    Present { value: v } => v.children |> map(f => v1.compiler.infer_env.authored_name(env: env, node: f))
    Absent => []
  }
  first_fields |> filter(fname =>
    fielded |> all(variant =>
      variant.children |> any(f => v1.compiler.infer_env.authored_name(env: env, node: f) == fname)
    )
  )
}

fn emit_enum_shared_accessors(name: String, type_params: String, generic_param_names: std.types.List<String>, children: std.types.List<v1.std.core.Node>, recursive_types: std.types.Set<String>, shared_types: std.types.Set<String>, env: v1.compiler.infer_env.TypeEnv, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let all_shared = find_shared_enum_fields(children: children, env: env)
  if all_shared |> count == 0 { return "" }
  let fielded = children |> filter(child =>
    child.children |> count > 0
      && !variant_is_synthetic_positional_payload(fields: child.children, source_indices: env.source_indices)
  )
  if fielded |> count == 0 { return "compile_error!(\"enum shared accessor missing fielded variant\")" }
  let first_fielded = (fielded |> first).value
  let shared = all_shared |> filter(fname =>
    let types = fielded |> map(variant =>
      match variant.children |> filter(f => v1.compiler.infer_env.authored_name(env: env, node: f) == fname) |> first {
        Present { value: f } => render_rust_field_type_with_applied_binding(field: f, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
        Absent => ""
      }
    )
    let first_type = match types |> first {
      Present { value: t } => t
      Absent => ""
    }
    types |> all(t => t == first_type)
  )
  if shared |> count == 0 { return "" }
  let accessor_fns = shared |> map(fname =>
    let ty = match first_fielded.children |> filter(f => v1.compiler.infer_env.authored_name(env: env, node: f) == fname) |> first {
      Present { value: f } => render_rust_field_type_with_applied_binding(field: f, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
      Absent => "compile_error!(\"enum shared accessor missing field metadata\")"
    }
    let arms = children |> map(child =>
      let child_text = authored_name(env: env, node: child)
      let sharing = language_spec(target: Rust).sharing
      let variant_path = rust_variant_path(parent: name, rust_name: child_text)
      if child.children |> count == 0 {
        concat("            ", variant_path, " => panic!(\"no ", fname, " on unit variant\"),")
      } else if variant_is_synthetic_positional_payload(fields: child.children, source_indices: env.source_indices) {
        concat("            ", variant_path, "(_) => panic!(\"no ", fname, " on positional-payload variant\"),")
      } else {
        concat("            ", variant_path, " { ", emit_ident(name: fname, target: Rust), ": __val, .. } => ", apply_type_template1(template: sharing.clone_value, arg0: "__val"), ",")
      }
    )
    let arms_str = arms |> join(separator: "\n")
    concat("    pub fn ", v1.compiler.emit.emit_ident(name: fname, target: v1.compiler.artifact.Rust), "(&self) -> ", ty, " {\n        match self {\n", arms_str, "\n        }\n    }")
  )
  let fns_str = accessor_fns |> join(separator: "\n")
  let type_application_params = emit_bare_type_params(generic_param_names: generic_param_names)
  concat("impl", type_params, " ", name, type_application_params, " {\n", fns_str, "\n}")
}

fn string_without_prefix(value: String, prefix: String) -> String? {
  if string_length(s: prefix) == 0 {
    none
  } else if string_length(s: value) >= string_length(s: prefix) && substring(s: value, start: 0, end: string_length(s: prefix)) == prefix {
    Present { value: substring(s: value, start: string_length(s: prefix), end: string_length(s: value)) }
  } else {
    none
  }
}

fn string_without_suffix(value: String, suffix: String) -> String? {
  if string_length(s: suffix) == 0 {
    none
  } else if string_length(s: value) >= string_length(s: suffix) && substring(s: value, start: string_length(s: value) - string_length(s: suffix), end: string_length(s: value)) == suffix {
    Present { value: substring(s: value, start: 0, end: string_length(s: value) - string_length(s: suffix)) }
  } else {
    none
  }
}

fn string_index_of_from(haystack: String, needle: String, pos: Int) -> Int? {
  if pos + string_length(s: needle) > string_length(s: haystack) {
    none
  } else if substring(s: haystack, start: pos, end: pos + string_length(s: needle)) == needle {
    Present { value: pos }
  } else {
    string_index_of_from(haystack: haystack, needle: needle, pos: pos + 1)
  }
}

fn string_index_of(haystack: String, needle: String) -> Int? {
  string_index_of_from(haystack: haystack, needle: needle, pos: 0)
}

fn wire_variant_tag_for_policy(authored: String, policy: RustEnumWireSerde) -> String? {
  if policy.error_message != none {
    none
  } else {
    match policy.rename_style {
      Present { value: style } =>
        if style == "StripAffixAndSnakeCase" {
          let without_prefix = match policy.rename_prefix {
            Present { value: prefix } => match string_without_prefix(value: authored, prefix: prefix) {
              Present { value: stripped } => stripped
              Absent => return none
            }
            Absent => authored
          }
          let without_suffix = match policy.rename_suffix {
            Present { value: suffix } => match string_without_suffix(value: without_prefix, suffix: suffix) {
              Present { value: stripped } => stripped
              Absent => return none
            }
            Absent => without_prefix
          }
          Present { value: v1.compiler.emit_core_support.to_snake(name: without_suffix) }
        } else {
          none
        }
      Absent =>
        if contains(policy.enum_attr, "rename_all = \"snake_case\"") {
          Present { value: v1.compiler.emit_core_support.to_snake(name: authored) }
        } else if policy.enum_attr == "" && policy.rename_prefix == none && policy.rename_suffix == none {
          Present { value: authored }
        } else {
          none
        }
    }
  }
}

fn policy_serde_tag_field(policy: RustEnumWireSerde) -> String? {
  let needle = "tag = \""
  match string_index_of(haystack: policy.enum_attr, needle: needle) {
    Present { value: start } =>
      let after = start + string_length(s: needle)
      match string_index_of_from(haystack: policy.enum_attr, needle: "\"", pos: after) {
        Present { value: end } =>
          Present { value: substring(s: policy.enum_attr, start: after, end: end) }
        Absent => none
      }
    Absent => none
  }
}

fn policy_is_untagged(policy: RustEnumWireSerde) -> Bool {
  contains(policy.enum_attr, "untagged")
}

fn policy_is_string_variant(policy: RustEnumWireSerde) -> Bool {
  !contains(policy.enum_attr, "tag =")
    && policy.rename_prefix == none
    && policy.rename_suffix == none
    && policy.rename_style == none
}

fn wire_variant_rename_attr_for_policy(authored: String, policy: RustEnumWireSerde) -> String {
  match wire_variant_tag_for_policy(authored: authored, policy: policy) {
    Present { value: tag } =>
      match policy.rename_style {
        Present { value: style } =>
          if style == "StripAffixAndSnakeCase" {
            concat("    #[serde(rename = \"", tag, "\")]\n")
          } else {
            ""
          }
        Absent => ""
      }
    Absent => ""
  }
}

fn variant_rename_validation_for_policy(authored: String, policy: RustEnumWireSerde) -> String {
  match policy.rename_style {
    Present { value: style } =>
      if style == "StripAffixAndSnakeCase" {
        let without_prefix = match policy.rename_prefix {
          Present { value: prefix } => match string_without_prefix(value: authored, prefix: prefix) {
            Present { value: stripped } => stripped
            Absent => return emit_rust_compile_error_item(message: concat("variant ", authored, " does not satisfy declared wire rename prefix: ", prefix))
          }
          Absent => authored
        }
        match policy.rename_suffix {
          Present { value: suffix } => match string_without_suffix(value: without_prefix, suffix: suffix) {
            Present { value: _ } => ""
            Absent => emit_rust_compile_error_item(message: concat("variant ", authored, " does not satisfy declared wire rename suffix: ", suffix))
          }
          Absent => ""
        }
      } else {
        ""
      }
    Absent => ""
  }
}

fn variant_rename_validations_for_policy(children: std.types.List<v1.std.core.Node>, env: v1.compiler.infer_env.TypeEnv, serde_policy: RustEnumWireSerde) -> String {
  children
    |> map(child => variant_rename_validation_for_policy(authored: v1.compiler.infer_env.authored_name(env: env, node: child), policy: serde_policy))
    |> filter(text => text != "")
    |> join(separator: "\n")
}

fn enum_variant_field_type_node(env: v1.compiler.infer_env.TypeEnv, enum_name: String, variant_name: String, field_name: String, fallback: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node {
  match v1.compiler.infer_env.lookup_type_by_name(env: env, name: enum_name) {
    Present { value: enum_node } =>
      match v1.std.core.find_child_named(n: enum_node, name: variant_name, source_indices: source_indices) {
        Present { value: variant } =>
          match v1.std.core.find_child_named(n: variant, name: field_name, source_indices: source_indices) {
            Present { value: field } =>
              if field.inferred != none { resolved_type(n: field) } else { fallback }
            Absent => fallback
          }
        Absent => fallback
      }
    Absent => fallback
  }
}

fn render_variant_payload_type(n: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  if n.connective == v1.std.core.NoConnective && n.children |> count > 0 {
    let tn = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
    let args = n.children |> map(c => render_rust_type(n: v1.compiler.infer_types.child_type_node(ch: c), shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info()))
    let spec = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Rust)
    concat(v1.compiler.coercion.coerce_primitive_type(target: v1.compiler.artifact.Rust, dag_name: tn, decl_file: v1.compiler.coercion.type_reference_decl_file(n: n)), spec.type_arg_open, args |> join(separator: ", "), spec.type_arg_close)
  } else {
    render_rust_type(n: n, shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info())
  }
}

fn variant_is_synthetic_positional_payload(fields: std.types.List<v1.std.core.Node>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if fields |> count != 1 {
    false
  } else {
    match fields |> first {
      Present { value: f } => v1.std.core.field_node_name_at(n: f, source_indices: source_indices) == "0"
      Absent => false
    }
  }
}

fn emit_variant_from_child(child: v1.std.core.Node, enum_name: String, generic_param_names: std.types.List<String>, recursive_types: std.types.Set<String>, shared_types: std.types.Set<String>, env: v1.compiler.infer_env.TypeEnv, serde_policy: RustEnumWireSerde, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let child_text = v1.compiler.infer_env.authored_name(env: env, node: child)
  let rename_attr = wire_variant_rename_attr_for_policy(authored: child_text, policy: serde_policy)
  if child.children |> count == 0 {
    concat(rename_attr, "    ", child_text, ",")
  } else if child.children |> count == 1 {
    let positional_payload = variant_is_synthetic_positional_payload(fields: child.children, source_indices: env.source_indices)
    let tuple_style = positional_payload || (serde_policy.enum_attr == "#[serde(untagged)]")
    if tuple_style {
      match child.children |> first {
        Present { value: f } =>
          let fallback = resolved_type(n: f)
          let type_node = if positional_payload {
            enum_variant_field_type_node(env: env, enum_name: enum_name, variant_name: child_text, field_name: "0", fallback: fallback, source_indices: env.source_indices)
          } else { fallback }
          let raw_ty = if positional_payload {
            render_variant_payload_type(n: type_node, shared_types: shared_types, source_indices: env.source_indices)
          } else {
            render_rust_type(n: type_node, shared_types: shared_types, source_indices: env.source_indices, emit_info: emit_info)
          }
          let ty = if v1.std.core.find_property(props: type_node.properties, prop_name: "__applied_type_args", source_indices: env.source_indices) != none { render_rust_type_with_applied_binding(n: type_node, shared_types: shared_types, source_indices: env.source_indices, env: env) } else { raw_ty }
          let final_ty = if needs_box_wrapping(n: type_node, recursive_types: recursive_types, shared_types: shared_types, source_indices: env.source_indices) {
            concat("Box<", ty, ">")
          } else { ty }
          concat(rename_attr, "    ", child_text, "(", final_ty, "),")
        Absent => concat(rename_attr, "    ", child_text, ",")
      }
    } else {
      let field_lines = child.children |> map(f =>
        let rt_f = resolved_type(n: f)
        let ty = render_rust_field_type_with_applied_binding(field: f, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
        let final_ty = rust_field_carrier_final_type(rt_field: rt_f, ty: ty, recursive_types: recursive_types, shared_types: shared_types, source_indices: env.source_indices)
        emit_rust_field_definition(authored: authored_name(env: env, node: f), final_ty: final_ty, rename_attr: "", indent: "        ", visibility: "", needs_serde: true)
      )
      let fields_str = field_lines |> join(separator: "\n")
      concat(rename_attr, "    ", child_text, " {\n", fields_str, "\n    },")
    }
  } else {
    let field_lines = child.children |> map(f =>
      let rt_f = resolved_type(n: f)
      let ty = render_rust_field_type_with_applied_binding(field: f, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
      let final_ty = rust_field_carrier_final_type(rt_field: rt_f, ty: ty, recursive_types: recursive_types, shared_types: shared_types, source_indices: env.source_indices)
      emit_rust_field_definition(authored: authored_name(env: env, node: f), final_ty: final_ty, rename_attr: "", indent: "        ", visibility: "", needs_serde: true)
    )
    let fields_str = field_lines |> join(separator: "\n")
    concat(rename_attr, "    ", child_text, " {\n", fields_str, "\n    },")
  }
}

data v1_fn_body_derived_clone_param_names_note: String = "Extracted from emit_fn_def (dashboard node adhoc-574e999b-39c, Row 1b) rather than duplicated: this is the SAME derivation emit_fn_def already ran for the function being emitted -- structural (v1_generic_params_needing_clone_bound) unioned with RC-match-scrutinee (v1_rc_match_scrutinee_clone_bound_param_names, trait_bound_witness.dag) -- now callable a second time on a CALLEE's own declared params/inferred/body (looked up via emit_info.fn_decl_items), so a wrapper fn that forwards its args directly into an already-Clone-bounded callee can derive its own bound from that callee's real requirement (DESIGN.md S5 construction-over-validation: the fact already exists on the callee's declaration Node, never a text scan of emitted Rust) instead of the emitter reasoning about it ad hoc at each call site (DESIGN.md S2 -- one derivation, two call sites)."

fn v1_fn_body_derived_clone_param_names(params: std.types.List<v1.std.core.Node>, inferred: v1.std.core.Node, body: v1.std.core.Node, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> std.types.List<String> {
  let si = source_indices
  let type_params = function_type_params(params: params)
  let value_params = function_value_params(params: params)
  let generic_param_names = type_params |> map(p => v1.std.core.generic_param_name_at(n: p, source_indices: si))
  let value_param_names = value_params |> map(p => p.name)
  let ret_name = v1.std.core.authored_name_at(source_indices: si, node: inferred)
  let return_is_bare_generic = (generic_param_names |> filter(g => g == ret_name) |> count) > 0
  let body_is_param_ref = (value_param_names |> filter(n => n == body.name) |> count) > 0
  let derived_clone_param_names = v1.compiler.trait_derive_emit.v1_generic_params_needing_clone_bound(
    generic_param_names: generic_param_names,
    value_params: value_params,
    return_is_bare_generic: return_is_bare_generic,
    ret_name: ret_name,
    body_is_param_ref: body_is_param_ref,
    ret: inferred,
    bounds: emit_info.clone_impl_required_type_params,
    type_decl_items: emit_info.type_decl_items,
    source_indices: si
  )
  let rc_match_clone_param_names = match body.expr_data {
    ExprMatch =>
      let scrutinee = v1.std.core.match_scrutinee(texpr: body)
      match scrutinee.inferred {
        Present { value: v1.std.core.Resolved { node: rt } } =>
          let scrut_type = v1.std.core.authored_name_at(source_indices: si, node: rt)
          let arms = v1.std.core.match_arm_nodes(texpr: body)
          let rc_match = analyze_rc_match(
            scrutinee: scrutinee,
            arms: arms,
            scrut_type: scrut_type,
            shared_types: shared_types,
            emit_info: emit_info,
            source_indices: si
          )
          v1.compiler.trait_bound_witness.v1_rc_match_scrutinee_clone_bound_param_names(
            generic_param_names: generic_param_names,
            scrutinee_type_arg_names: rt.children |> map(c => v1.std.core.authored_name_at(source_indices: si, node: c)),
            rc_match_needs_deref: rc_match.needs_deref
          )
        _ => []
      }
    _ => []
  }
  v1_union_bound_param_names(
    base: derived_clone_param_names,
    extra: rc_match_clone_param_names
  )
}

// Joins the two derivations onto one per-param trait list so a param earning both renders
// `K: Clone + PartialEq`. Clone is listed first so the Clone-only case is byte-identical to what
// the previous single-trait renderer emitted, which is what lets the regen fixed point act as the
// oracle for "equality changed nothing that did not need changing".
fn v1_fn_bounds_by_param(
  clone_param_names: std.types.List<String>,
  eq_param_names: std.types.List<String>
) -> std.types.Map<String, std.types.List<String>> {
  let with_clone = clone_param_names |> fold(init: empty_map(), f: (m, n) => map_insert(m, n, ["Clone"]))
  eq_param_names |> fold(init: with_clone, f: (m, n) =>
    match map_get(m, n) {
      Present { value: traits } => map_insert(m, n, concat(traits, ["PartialEq"]))
      Absent => map_insert(m, n, ["PartialEq"])
    }
  )
}

// v1.std.core.Node-consuming extraction for the equality bound, kept here rather than in
// v1.compiler.trait_bound_witness for the reason that module's import note gives: the pure core
// lives there, the v1.std.core.Node walk lives at the call site, and reversing that would close an
// emit_rust -> trait_bound_witness -> emit_rust cycle.
//
// This is the RECURSIVE BODY WALKER that BoundedToDirectTopLevelMatchBody and
// BoundedToDirectSingleCallLambdaBody both name as their next-rung trigger. Unlike those two it
// declares no depth boundary: the specimen that motivated it puts the earning comparison inside a
// lambda, inside any(), inside a pipeline, inside the && of another lambda inside another any().
//
// The traversal is deliberately GENEROUS and the predicate deliberately EXACT, because the two
// directions have asymmetric cost. binop_left/binop_right are children 0 and 1, so descending
// every child reaches every operand; a node the walk somehow misses simply yields no bound, which
// is the status quo. But a spurious bound tightens the emitted signature and breaks callers, so
// precision must come from v1_equality_bound_param_name's type resolution, never from the shape of
// the walk.
fn v1_fn_body_equality_bound_param_names(
  body: v1.std.core.Node,
  generic_param_names: std.types.List<String>,
  source_indices: std.types.Map<String, v1.std.core.NewlineIndex>
) -> std.types.List<String> {
  let here = match body.expr_data {
    ExprBinOp { op: op, algebra_field: _ } =>
      if is_equality_comparison(op: op) {
        v1_equality_bound_param_name(
          left_type_name: v1_resolved_type_name_or_empty(e: binop_left(texpr: body), source_indices: source_indices),
          right_type_name: v1_resolved_type_name_or_empty(e: binop_right(texpr: body), source_indices: source_indices),
          generic_param_names: generic_param_names
        )
      } else {
        []
      }
    _ => []
  }
  body.children |> fold(init: here, f: (acc, child) =>
    v1_union_bound_param_names(
      base: acc,
      extra: v1_fn_body_equality_bound_param_names(
        body: child,
        generic_param_names: generic_param_names,
        source_indices: source_indices
      )
    )
  )
}

// Matches Eq/Ne bare exactly as is_string_comparison does in this module. The operator is genuinely
// a spelling, so reading it as one is correct; it is the OPERANDS that must be resolved by type.
fn is_equality_comparison(op: std.syntax.BinOp) -> Bool {
  match op {
    Eq => true
    Ne => true
    _ => false
  }
}

// Empty string means "no resolved type", which is why v1_equality_bound_param_name refuses on it
// rather than letting two unresolved operands compare equal and fabricate a bound.
fn v1_resolved_type_name_or_empty(e: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  match e.inferred {
    Present { value: extdeps.tools.Resolved { node: rt } } => authored_name_at(source_indices: source_indices, node: rt)
    _ => ""
  }
}

// The (callee declared param, call argument) fold shared by BOTH forwarding derivations below.
// It is trait-agnostic by construction: the only thing that distinguishes the Clone forwarding from
// the equality forwarding is WHICH of the callee's own generic params already earned a bound, and
// that arrives as callee_bound_param_names. Forking this fold per trait would be the second
// representation DESIGN.md S3 forbids -- the join it performs (callee param name -> call argument,
// via call_args_by_name) is one fact about a call site, not a fact about Clone.
fn v1_call_forwarding_forwarded_param_names(
  call: v1.std.core.Node,
  callee_value_params: List<v1.std.core.Node>,
  callee_generic_param_names: List<String>,
  callee_bound_param_names: List<String>,
  wrapper_generic_param_names: List<String>,
  source_indices: Map<String, v1.std.core.NewlineIndex>
) -> List<String> {
  let si = source_indices
  if (callee_bound_param_names |> count) == 0 {
    []
  } else {
    let arg_by_name = call_args_by_name(call: call, source_indices: si)
    let forwarded = callee_value_params
    |> flat_map(cp =>
      let callee_param_type_name = resolved_type_name(n: cp, source_indices: si)
      let callee_param_type_arg_names = resolved_type(n: cp).children |> map(c => authored_name_at(source_indices: si, node: c))
      let arg_type_name = match map_get(arg_by_name, cp.name) {
        Present { value: arg_node } => resolved_type_name(n: arg_node, source_indices: si)
        Absent => ""
      }
      let arg_type_arg_names = match map_get(arg_by_name, cp.name) {
        Present { value: arg_node } => resolved_type(n: arg_node).children |> map(c => authored_name_at(source_indices: si, node: c))
        Absent => []
      }
      v1_call_forwarding_bound_wrapper_param_names(
        callee_param_type_name: callee_param_type_name,
        callee_param_type_arg_names: callee_param_type_arg_names,
        callee_generic_param_names: callee_generic_param_names,
        callee_bound_param_names: callee_bound_param_names,
        arg_type_name: arg_type_name,
        arg_type_arg_names: arg_type_arg_names,
        wrapper_generic_param_names: wrapper_generic_param_names
      )
    )
    v1_union_bound_param_names(base: [], extra: forwarded)
  }
}

fn v1_call_forwarding_clone_bound_param_names(
  generic_param_names: std.types.List<String>,
  body: v1.std.core.Node,
  fn_decl_items: std.types.Map<String, v1.std.core.Node>,
  emit_info: v1.compiler.infer_emit_info.EmitGraphInfo,
  shared_types: std.types.Set<String>,
  source_indices: std.types.Map<String, v1.std.core.NewlineIndex>
) -> std.types.List<String> {
  let si = source_indices
  let call_node = match body.expr_data {
    ExprCall => Present { value: body }
    ExprLambda =>
      let lb = v1.std.core.lambda_body(texpr: body)
      match lb.expr_data {
        ExprCall => Present { value: lb }
        _ => none
      }
    _ => none
  }
  match call_node {
    Absent => []
    Present { value: call } =>
      let callee_name = v1.std.core.expr_call_func_at(texpr: call, source_indices: si)
      match map_get(fn_decl_items, callee_name) {
        Absent => []
        Present { value: callee_item } =>
          match callee_item.body {
            Absent => []
            Present { value: callee_body } =>
              let callee_params = callee_item.params
              let callee_type_params = function_type_params(params: callee_params)
              let callee_generic_param_names = callee_type_params |> map(p => v1.std.core.generic_param_name_at(n: p, source_indices: si))
              let callee_clone_param_names = v1_fn_body_derived_clone_param_names(
                params: callee_params,
                inferred: resolved_type(n: callee_item),
                body: callee_body,
                emit_info: emit_info,
                shared_types: shared_types,
                source_indices: si
              )
              v1_call_forwarding_forwarded_param_names(
                call: call,
                callee_value_params: function_value_params(params: callee_params),
                callee_generic_param_names: callee_generic_param_names,
                callee_bound_param_names: callee_clone_param_names,
                wrapper_generic_param_names: generic_param_names,
                source_indices: si
              )
          }
      }
  }
}

// The equality half of the same one-hop propagation, and the reason it exists is WELL-FORMEDNESS
// rather than convenience: once the emitter synthesizes `K: PartialEq` on the fn whose OWN body
// compares two K values, every caller that instantiates that fn's K with its OWN generic param is
// obliged by rustc to prove the bound it cannot state, so the seed emits a program that does not
// typecheck. The specimen is std.trait_derive_shape under gunbc#8605:
// repr_grounding_derive_shape_has_trait<K> compares `k == capability_key` and earns the bound,
// repr_grounding_derive_completeness_predicate<K> forwards its own K into that parameter and
// emitted bare, so regen refused with E0277 on a function whose own body compares nothing.
//
// THE WALK IS RECURSIVE WHERE THE CLONE HALF'S IS NOT, and that is a difference in the specimens,
// not a difference of opinion: the clone specimens are pass-through wrappers whose body IS the
// call, while the forwarding comparison here sits inside a lambda inside a pipelined all(), which
// the direct-shape lookup structurally cannot reach. It is the same generous-walk/exact-predicate
// asymmetry v1_fn_body_equality_bound_param_names is built on -- descending every child can only
// find more call sites, while precision stays where it belongs, in the type-resolving predicate
// v1_call_forwarding_bound_wrapper_param_names applies to each (callee param, argument) pair.
//
// COST SHAPE (DESIGN.md S6 bare-minimum-cost, not a per-site exception): the walk re-derives the
// callee's own equality bound at every call site it reaches, so it is charged once per (caller
// node, callee body). A fn with no type params of its own can never receive a forwarded bound, so
// that whole product is refused at the door rather than computed and discarded -- which is the
// overwhelming majority of the corpus's functions.
//
// WHY TWO WALKS AND NOT ONE, stated rather than left as an apparent duplication: the shared part
// -- the per-(callee param, argument) join and its predicate -- IS shared, as
// v1_call_forwarding_forwarded_param_names above. What differs is only the SCOPE each derivation
// walks, and pointing the Clone half at this recursive walk is not a refactor: it widens which
// functions receive a Clone bound across the whole corpus, which is the next-rung trigger
// BoundedToDirectSingleCallLambdaBody already names and is measured on its own regen, not smuggled
// in beside an equality fix.
//
// ONE HOP, DECLARED. A callee that earns its own bound only by forwarding two hops up is not
// bounded here in one pass; it is discovered as each intermediate fn is itself re-emitted, exactly
// as the clone half's note describes, and a specimen needing a fixpoint over the call graph is the
// next-rung trigger rather than a silent gap.
fn v1_call_forwarding_equality_bound_param_names(
  generic_param_names: List<String>,
  body: v1.std.core.Node,
  fn_decl_items: Map<String, v1.std.core.Node>,
  source_indices: Map<String, v1.std.core.NewlineIndex>
) -> List<String> {
  if (generic_param_names |> count) == 0 {
    return []
  }
  let here = match body.expr_data {
    ExprCall => v1_call_site_equality_forwarded_param_names(
      call: body,
      generic_param_names: generic_param_names,
      fn_decl_items: fn_decl_items,
      source_indices: source_indices
    )
    _ => []
  }
  body.children |> fold(init: here, f: (acc, child) =>
    v1_union_bound_param_names(
      base: acc,
      extra: v1_call_forwarding_equality_bound_param_names(
        generic_param_names: generic_param_names,
        body: child,
        fn_decl_items: fn_decl_items,
        source_indices: source_indices
      )
    )
  )
}

// One call site: resolve the callee's declaration, re-derive the callee's OWN equality bound with
// the same derivation emit_fn_def runs on itself (DESIGN.md S2 -- one derivation, two call sites,
// never a re-implementation), then forward it onto the wrapper's params.
fn v1_call_site_equality_forwarded_param_names(
  call: v1.std.core.Node,
  generic_param_names: List<String>,
  fn_decl_items: Map<String, v1.std.core.Node>,
  source_indices: Map<String, v1.std.core.NewlineIndex>
) -> List<String> {
  let si = source_indices
  let callee_name = expr_call_func_at(texpr: call, source_indices: si)
  match map_get(fn_decl_items, callee_name) {
    Absent => []
    Present { value: callee_item } =>
      match callee_item.body {
        Absent => []
        Present { value: callee_body } =>
          let callee_params = callee_item.params
          let callee_type_params = function_type_params(params: callee_params)
          let callee_generic_param_names = callee_type_params |> map(p => generic_param_name_at(n: p, source_indices: si))
          let callee_eq_param_names = v1_fn_body_equality_bound_param_names(
            body: callee_body,
            generic_param_names: callee_generic_param_names,
            source_indices: si
          )
          v1_call_forwarding_forwarded_param_names(
            call: call,
            callee_value_params: function_value_params(params: callee_params),
            callee_generic_param_names: callee_generic_param_names,
            callee_bound_param_names: callee_eq_param_names,
            wrapper_generic_param_names: generic_param_names,
            source_indices: si
          )
      }
  }
}

fn emit_fn_def(name: String, params: std.types.List<v1.std.core.Node>, inferred: v1.std.core.Node, body: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  let host_text_op = rust_host_string_op_fn_emit(name: name)
  if host_text_op != none {
    return match host_text_op {
      Present { value: op_fn } => op_fn
      Absent => ""
    }
  }
  match rust_host_string_seam_fn_emit(name: name) {
    Present { value: seam_fn } => { let _unused = seam_fn
      "" }
    Absent => {
  let type_params = function_type_params(params: params)
  let value_params = function_value_params(params: params)

  if function_type_params_have_collision(type_params: type_params) {
    return concat("compile_error!(\"type param name collides with a value param in fn '", name, "' — a value param shares its name with a declared type param; rename the value param or dissolve via ParamKind/params-slot partition\");\n")
  }
  let generic_param_names = type_params |> map(p => v1.std.core.generic_param_name_at(n: p, source_indices: si))
  let body_emit_info = v1.compiler.infer_emit_info.emit_info_with_fn_return(
    emit_info: v1.compiler.infer_emit_info.emit_info_with_fn_type_context(emit_info: emit_info, generic_param_names: generic_param_names, env: scope.type_env),
    fn_return_type: Present { value: inferred }
  )
  let value_param_names = value_params |> map(p => p.name)
  let ret_name = v1.std.core.authored_name_at(source_indices: si, node: inferred)
  let return_is_bare_generic = (generic_param_names |> filter(g => g == ret_name) |> count) > 0
  let body_is_param_ref = (value_param_names |> filter(n => n == body.name) |> count) > 0
  let self_derived_clone_param_names = v1_fn_body_derived_clone_param_names(
    params: params,
    inferred: inferred,
    body: body,
    emit_info: emit_info,
    shared_types: shared_types,
    source_indices: si
  )
  let call_forwarding_clone_param_names = v1_call_forwarding_clone_bound_param_names(
    generic_param_names: generic_param_names,
    body: body,
    fn_decl_items: emit_info.fn_decl_items,
    emit_info: emit_info,
    shared_types: shared_types,
    source_indices: si
  )
  let derived_clone_param_names_with_rc_match = v1_union_bound_param_names(
    base: self_derived_clone_param_names,
    extra: call_forwarding_clone_param_names
  )
  let module_path = scope.type_env.module_path
  let clone_param_names = if (generic_param_names |> count) > 0 && (
    v1.compiler.trait_derive_emit.trait_derive_emit_fn_clone_bound_keyed_carrier_module(module_path: module_path)
  ) {
    generic_param_names
  } else {
    derived_clone_param_names_with_rc_match
  }
  let self_eq_param_names = v1_fn_body_equality_bound_param_names(
    body: body,
    generic_param_names: generic_param_names,
    source_indices: si
  )
  let call_forwarding_eq_param_names = v1_call_forwarding_equality_bound_param_names(
    generic_param_names: generic_param_names,
    body: body,
    fn_decl_items: emit_info.fn_decl_items,
    source_indices: si
  )
  let eq_param_names = v1_union_bound_param_names(
    base: self_eq_param_names,
    extra: call_forwarding_eq_param_names
  )
  let bounds_by_param = v1_fn_bounds_by_param(
    clone_param_names: clone_param_names,
    eq_param_names: eq_param_names
  )
  let needs_bound = (clone_param_names |> count) > 0 || (eq_param_names |> count) > 0
  let type_params_str = if needs_bound {
    v1_emit_type_params_with_bounds(params: type_params, bounds_by_param: bounds_by_param, source_indices: si)
  } else {
    emit_type_params(params: type_params, source_indices: si)
  }
  let params_str = emit_params(params: value_params, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: si, read_only_params: emit_info.read_only_params, variant_to_enum: emit_info.variant_to_enum, env: scope.type_env, enclosing_returns_arrow: (inferred.params |> count) > 0)
  let ret_str = emit_inferred(inferred: inferred, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: si, variant_to_enum: emit_info.variant_to_enum, env: scope.type_env)
  let body_scope = v1.compiler.infer.build_params_scope(scope: scope, params: value_params)
  let depth = 0
  let use_tco = v1.compiler.emit.is_tco_eligible(name: name, body: body, registry: registry, source_indices: si)
  let needs_stacker = v1.compiler.emit.is_self_recursive(name: name, body: body, registry: registry, source_indices: si) && use_tco == false
  if use_tco {
    let tco_params_str = emit_tco_params(params: value_params, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: si, variant_to_enum: emit_info.variant_to_enum, env: scope.type_env)
    let body_str = emit_typed_tco_body(texpr: body, fn_name: name, params: value_params, registry: registry, scope: body_scope, depth: depth + 1, shared_types: shared_types, emit_info: body_emit_info)
    let kw = rust_items().func_keyword
    concat(rust_visibility_prefix(), kw, " ", v1.compiler.emit.emit_ident(name: name, target: v1.compiler.artifact.Rust), type_params_str, "(", tco_params_str, ")", ret_str, " {\n",
      v1.compiler.emit_core_support.make_indent(level: depth + 1),body_str, "\n}")
  } else {
    let return_is_unit = return_type_is_unit(n: inferred, source_indices: si)
    emit_fn_def_non_tco(name: name, type_params_str: type_params_str, params_str: params_str, ret_str: ret_str, body: body, registry: registry, scope: body_scope, depth: depth, shared_types: shared_types, emit_info: body_emit_info, needs_stacker: needs_stacker, return_is_unit: return_is_unit)
  }
    }
  }
}

fn return_type_is_unit(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let authored = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  let name = if authored != "" { authored } else { n.name }
  v1.compiler.infer_types.is_unit_like(n: n) && name == "Unit"
}

// A DAG fn whose DECLARED return type is an arrow returns a callable VALUE; Rust renders that
// type through callable_type_template as Rc<dyn Fn(..) -> ..>, so a bare closure in return
// position is an unsized-coercion type error (E0308) rather than a value of the declared type.
// The decision is structural — declared return connective is Arrow AND the returned expression
// is a lambda — never a scan of the rendered string; the realization itself is a target row
// (callable_value_wrap_template), so a target without one is unaffected by construction.
// MEASURED RESIDUE, NOT A CLOSED CLASS (review 53557, confirmed by execution 2026-08-18): the wrap
// below fires only when the RETURNED EXPRESSION ITSELF is a lambda. A declared arrow return whose
// lambda sits in a tail position -- an if arm, a match arm, or the body after a let -- still emits
// a bare closure under Rc<dyn Fn..>. All three forms were compiled and inspected: pick / pick_match
// / pick_let each emitted `|n| ...` with no wrap and no diagnostic. Closing it is a tail-position
// walk (wrap each tail leaf, not the whole rendered expression -- `Rc::new(move if c {..})` is not
// Rust), which is emission-shape work rather than a wider predicate here. Until that lands the
// class is NARROWED, not unwritable, and the honest arm for the residue is a located refusal: a
// bare closure at a declared-arrow return can never compile, so refusing it breaks nothing that
// currently works.
fn rust_declared_return_is_callable(emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> Bool {
  match emit_info.fn_return_type {
    Present { value: ret } => ret.connective == v2.std.node.Arrow
    Absent => false
  }
}

fn rust_callable_return_wrap(body_str: String, texpr: v1.std.core.Node, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let is_lambda_body = match texpr.expr_data {
    ExprLambda => true
    _ => false
  }
  let wrap_template = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Rust).callable_value_wrap_template
  if is_lambda_body && rust_declared_return_is_callable(emit_info: emit_info) {
    match wrap_template {
      Present { value: t } => v1.compiler.emit_core_support.apply_type_template1(template: t, arg0: body_str)
      Absent => body_str
    }
  } else { body_str }
}

fn emit_rust_fn_body_expr(texpr: v1.std.core.Node, return_is_unit: Bool, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  if return_is_unit {
    emit_rust_unit_discarding_stmt(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  } else {
    rust_callable_return_wrap(
      body_str: emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024),
      texpr: texpr,
      emit_info: emit_info
    )
  }
}

fn inferred_expr_is_optional(texpr: v1.std.core.Node) -> Bool {
  match texpr.inferred {
    Present { value: v1.std.core.Resolved { node: rt } } => rt.return_cardinality == v1.std.core.CardOptional
    _ => false
  }
}

fn emit_rust_unit_discarding_optional_typed(texpr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match texpr.expr_data {
    ExprLiteral { value: v } =>
      match v {
        LitNull => "()"
        _ => v1.compiler.emit.emit_error_expr(message: "unit-discard: optional literal with unexpected value shape", target: v1.compiler.artifact.Rust)
      }
    ExprRecordLit { parent_enum: _ } =>
      match texpr.children |> count {
        0 => "()"
        1 =>
          match texpr.children |> first {
            Present { value: f } =>
              emit_rust_unit_discarding_stmt(texpr: v1.std.core.field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
            Absent => v1.compiler.emit.emit_error_expr(message: "unit-discard: optional record literal missing payload field", target: v1.compiler.artifact.Rust)
          }
        _ => v1.compiler.emit.emit_error_expr(message: "unit-discard: optional record literal with unexpected field count", target: v1.compiler.artifact.Rust)
      }
    _ =>
      v1.compiler.emit.emit_error_expr(message: "unit-discard: unsupported optional expression form for Unit return", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_unit_discarding_stmt(texpr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  match texpr.expr_data {
    ExprLet =>
      let v = v1.std.core.let_value(texpr: texpr)
      let inner = v1.std.core.let_body(texpr: texpr)
      if inferred_expr_is_optional(texpr: v) {
        match inner {
          Present { value: bd } =>
            concat(emit_rust_unit_discarding_stmt(texpr: v, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info), "\n", emit_rust_unit_discarding_stmt(texpr: bd, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
          Absent => emit_rust_unit_discarding_stmt(texpr: v, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
        }
      } else {
        let n = v1.std.core.let_binding_name_at(texpr: texpr, source_indices: si)
        let val_str = emit_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
        let let_line = v1.compiler.emit.emit_let_binding(name: n, value: val_str, target: v1.compiler.artifact.Rust)
        match inner {
          Present { value: bd } =>
            concat(let_line, "\n", emit_rust_unit_discarding_stmt(texpr: bd, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
          Absent => let_line
        }
      }
    ExprBlock =>
      texpr.children
        |> map(child => emit_rust_unit_discarding_stmt(texpr: child, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
        |> join(separator: "\n")
    ExprIf =>
      let c = v1.std.core.if_condition(texpr: texpr)
      let t = v1.std.core.if_then_branch(texpr: texpr)
      let e = v1.std.core.if_else_branch(texpr: texpr)
      let cond_str = emit_typed_expr(texpr: c, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let then_str = emit_rust_unit_discarding_stmt(texpr: t, registry: registry, scope: scope, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
      match e {
        Present { value: eb } =>
          let else_str = emit_rust_unit_discarding_stmt(texpr: eb, registry: registry, scope: scope, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
          concat("if ", cond_str, " {\n", v1.compiler.emit_core_support.make_indent(level: depth + 1), then_str, "\n} else {\n", v1.compiler.emit_core_support.make_indent(level: depth + 1), else_str, "\n}")
        Absent =>
          concat("if ", cond_str, " {\n", v1.compiler.emit_core_support.make_indent(level: depth + 1), then_str, "\n}")
      }
    ExprRecordLit { parent_enum: _ } =>
      if inferred_expr_is_optional(texpr: texpr) {
        emit_rust_unit_discarding_optional_typed(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else {
        concat(emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ";")
      }
    ExprLiteral { value: v } =>
      if inferred_expr_is_optional(texpr: texpr) {
        emit_rust_unit_discarding_optional_typed(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else {
        match v { std.syntax.LitNull => "()"  _ => concat(emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ";") }
      }
    ExprVar { binding_kind: _ } =>
      concat(emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ";")
    _ =>
      concat(emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ";")
  }
}

fn emit_fn_def_non_tco(name: String, type_params_str: String, params_str: String, ret_str: String, body: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, needs_stacker: Bool, return_is_unit: Bool) -> String {
  if needs_stacker {
    let body_str = emit_rust_fn_body_expr(texpr: body, return_is_unit: return_is_unit, registry: registry, scope: scope, depth: depth + 2, shared_types: shared_types, emit_info: emit_info)
    let kw = rust_items().func_keyword
    concat(rust_visibility_prefix(), kw, " ", v1.compiler.emit.emit_ident(name: name, target: v1.compiler.artifact.Rust), type_params_str, "(", params_str, ")", ret_str, " {\n",
      v1.compiler.emit_core_support.make_indent(level: depth + 1), "stacker::maybe_grow(512 * 1024, 2 * 1024 * 1024, || {\n",
      v1.compiler.emit_core_support.make_indent(level: depth + 2), body_str, "\n",
      v1.compiler.emit_core_support.make_indent(level: depth + 1), "})\n}")
  } else {
    let body_str = emit_rust_fn_body_expr(texpr: body, return_is_unit: return_is_unit, registry: registry, scope: scope, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
    let kw = rust_items().func_keyword
    concat(rust_visibility_prefix(), kw, " ", v1.compiler.emit.emit_ident(name: name, target: v1.compiler.artifact.Rust), type_params_str, "(", params_str, ")", ret_str, " {\n",
      v1.compiler.emit_core_support.make_indent(level: depth + 1), body_str, "\n}")
  }
}

fn emit_func_def(
  name: String,
  params: std.types.List<v1.std.core.Node>,
  inferred: v1.std.core.Node,
  uses: std.types.List<v1.std.core.Node>,
  body: v1.std.core.Node,
  registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>,
  scope: v1.compiler.infer.InferScope,
  shared_types: std.types.Set<String>,
  emit_info: v1.compiler.infer_emit_info.EmitGraphInfo
) -> String {

  if function_type_params(params: params) |> count > 0 {
    return concat("compile_error!(\"emit_func_def saw type params in `", name, "` — func/pattern/interface don't route through the generic-fn split today; the parser invariant at parse_block_body_from_prefix has changed. Plumb type_params through this path or dissolve via ParamKind/params-slot partition.\");\n")
  }
  let depth = 0
  let service_names = match v1.compiler.emit.lookup_item(registry: registry, name: name) {
    Present { value: info } => info.service_names
    Absent => []
  }
  let params_str = emit_func_params(params: params, uses: uses, service_names: service_names, shared_types: shared_types, source_indices: scope.type_env.source_indices, read_only_params: emit_info.read_only_params, variant_to_enum: emit_info.variant_to_enum, env: scope.type_env)
  let ret_str = emit_func_inferred(inferred: inferred, shared_types: shared_types, source_indices: scope.type_env.source_indices)
  let body_scope = v1.compiler.infer.build_params_scope(scope: scope, params: params)
  let si = scope.type_env.source_indices
  let body_scope = fold(uses, init: body_scope, f: (s, u) =>
    v1.compiler.infer.extend_scope(scope: s, name: v1.std.core.resource_use_name_at(n: u, source_indices: si), resolved: v1.std.core.resource_use_resource(n: u), provenance: std.induction.SubValueUnknown)
  )
  let body_str = emit_func_body(body: body, registry: registry, scope: body_scope, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
  let items = rust_items()
  concat(rust_visibility_prefix(), items.async_prefix, items.func_keyword, " ", v1.compiler.emit.emit_ident(name: name, target: v1.compiler.artifact.Rust),
    "(", params_str, ")", ret_str, " {\n",
    v1.compiler.emit_core_support.make_indent(level: depth + 1),body_str, "\n}")
}

fn emit_func_body(body: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  match body.expr_data {
    ExprLet => {
      let n = v1.std.core.let_binding_name_at(texpr: body, source_indices: si)
      let v = v1.std.core.let_value(texpr: body)
      let inner = v1.std.core.let_body(texpr: body)
      let val_str = emit_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let let_line = v1.compiler.emit.emit_let_binding(name: n, value: val_str, target: v1.compiler.artifact.Rust)
      let next_scope = v1.compiler.infer.extend_scope(scope: scope, name: n, resolved: resolved_type(n: v), provenance: std.induction.SubValueUnknown)
      match inner {
        Present { value: bd } =>
          concat(let_line, "\n", emit_func_body(body: bd, registry: registry, scope: next_scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
        Absent => let_line
      }
    }
    ExprBlock => {
      let ss = body.children
      if ss |> count == 0 {
        "Ok(())"
      } else {
        let init_state = emit_rust_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth, shared_types: shared_types, emit_info: emit_info)
        let last_stmt = ss |> last
        let last_str = match last_stmt {
          Present { value: s } =>
            match s.expr_data {
              ExprReturn => concat("return Ok(", emit_typed_expr(texpr: v1.std.core.return_value(texpr: s), registry: registry, scope: init_state.scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ")")
              _ => concat("Ok(", emit_typed_expr(texpr: s, registry: registry, scope: init_state.scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ")")
            }
          Absent => "Ok(())"
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    }
    ExprReturn => concat("return Ok(", emit_typed_expr(texpr: v1.std.core.return_value(texpr: body), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ")")
    _ => concat("Ok(", emit_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ")")
  }
}

fn emit_tco_params(params: std.types.List<v1.std.core.Node>, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  let strs = params |> map(p => emit_tco_param(param: p, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env))
  strs |> join(separator: ", ")
}

fn emit_tco_param(param: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  let authored = v1.std.core.param_node_type_expr(n: param)
  let ty = if authored.params |> count > 0 {
    emit_rust_param_type(n: authored, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env, enclosing_returns_arrow: false)
  } else {
    render_rust_param_sig_type(param: param, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  concat("mut ", v1.compiler.emit.emit_ident(name: v1.std.core.param_node_name_at(n: param, source_indices: source_indices), target: v1.compiler.artifact.Rust), rust_items().param_type_sep, ty)
}

fn emit_func_params(params: std.types.List<v1.std.core.Node>, uses: std.types.List<v1.std.core.Node>, service_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, read_only_params: std.types.Set<String>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  let param_strs = params |> map(p => emit_param(param: p, generic_param_names: [], shared_types: shared_types, source_indices: source_indices, read_only_params: read_only_params, variant_to_enum: variant_to_enum, env: env, enclosing_returns_arrow: false))
  let resource_strs = uses |> map(u =>
    concat(v1.compiler.emit.emit_ident(name: v1.std.core.resource_use_name_at(n: u, source_indices: source_indices), target: v1.compiler.artifact.Rust), ": &", render_rust_type(n: v1.std.core.resource_use_resource(n: u), shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info()))
  )
  let service_strs = service_names |> map(sn =>
    concat(v1.compiler.emit_core_support.service_var_name(service_name: sn), ": &", v1.compiler.emit_core_support.sanitize_service_name(name: sn))
  )
  let all_params = concat(param_strs, resource_strs, service_strs)
  all_params |> join(separator: ", ")
}

fn emit_func_inferred(inferred: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  concat(" -> Result<", render_rust_type(n: inferred, shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info()), ", Box<dyn std::error::Error>>")
}

fn emit_params(params: std.types.List<v1.std.core.Node>, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, read_only_params: std.types.Set<String>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv, enclosing_returns_arrow: Bool) -> String {
  let strs = params |> map(p => emit_param(param: p, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, read_only_params: read_only_params, variant_to_enum: variant_to_enum, env: env, enclosing_returns_arrow: enclosing_returns_arrow))
  strs |> join(separator: ", ")
}

fn render_rust_param_sig_type(param: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  let type_node = resolved_type(n: param)
  render_rust_fn_sig_type(n: type_node, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
}

// The `+ 'static` is GATED on the enclosing function returning an arrow. An earlier revision
// emitted it unconditionally on the stated premise that it "cannot reject any expressible program".
// THAT PREMISE WAS FALSIFIED BY EXECUTION: installing the generation-2 regen candidate produced
// 161 rustc errors (E0373 closure may outlive / E0597 does not live long enough), concentrated in
// v1_compiler_emit.rs and v1_compiler_emit_rust.rs. The premise conflated WHAT is captured with HOW:
// the captured values are owned, but the emitter emits the closure WITHOUT `move`, so the capture is
// a borrow — and a non-move closure borrowing an owned local is not `'static` however owned the
// local is. The bound rejected 161 expressible programs.
//
// The gate is precise rather than a proxy: the `Rc::new(move |..| ..)` site that creates the
// obligation exists exactly when the function returns an arrow, and those lowering-emitted closures
// already carry `move`, so no call site needs to change and no additional clone is emitted. The
// discarded alternative — emitting `move` at every closure site to satisfy a bound synthesized at
// every parameter — is two unconditional widenings composing, and it is not free: a `move` closure
// takes ownership of its captures, so any value still live afterward must then be CLONED, which
// would have raised clone count on the exact axis this lane is driving down.
//
// Measured, which is what settles it against the earlier reasoning: the v1 seed closure contains 99
// `impl Fn` parameters and ZERO functions returning `Rc<dyn Fn>`, so the unconditional form bought
// nothing there and cost 161 rejections. The motivating specimen (v2/std/staging.dag `then_outcome`)
// is reached through the gate, not excluded by it.
//
// An arrow type realizes in Rust as `Rc<dyn Fn(..) -> ..>` (v1.compiler.languages rust_spec
// callable_type_template). A `dyn` trait object defaults to the `'static` lifetime, so a function
// whose body closes over its arrow-typed parameters and returns one of those cannot compile unless
// those parameters are `'static` — rustc E0310 at the `Rc::new(move |..| ..)` site, which is the
// realization's own consequence rather than anything the authored source asked for.
//
// The gate threads the enclosing function's return type into a renderer that otherwise sees only
// the parameter. That threading cost was the earlier revision's stated reason for declining the
// gate; it is four hops through a single call chain (emit_fn_def -> emit_params -> emit_param ->
// emit_rust_param_type), and it is what the 161 errors bought.
//
// The `+ Clone` beside it stays unconditional, and the asymmetry is the point rather than an
// inconsistency: `Clone` is satisfiable by every emitted call site, `'static` is not.
// It belongs here rather than in v2/std/staging.dag because the obligation is created by the
// realization choice: the source declares an arrow, and only the Rust row decides that an arrow
// becomes `Rc<dyn Fn>`. Declaring it at the source would require inventing Rust lifetime syntax in
// a medium-agnostic language — `'static` appears in no .dag source module — and would leave the
// next arrow-into-Rc site to be rediscovered the same way (DESIGN §3 layer inversion, §5
// construction over validation).
fn emit_rust_param_type(n: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv, enclosing_returns_arrow: Bool) -> String {
  if n.params |> count > 0 {
    let param_types = n.params |> map(p => render_rust_fn_sig_type(n: v1.std.core.param_node_type_expr(n: p), generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env))
    let param_str = param_types |> join(separator: ", ")
    let ret_str = match n.inferred {
      Present { value: v1.std.core.Resolved { node: rt } } => render_rust_fn_sig_type(n: rt, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      _ => "()"
    }
    let static_bound = if enclosing_returns_arrow { " + 'static" } else { "" }
    concat("impl Fn(", param_str, ") -> ", ret_str, " + Clone", static_bound)
  } else {
    render_rust_fn_sig_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
}

fn emit_param(param: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, read_only_params: std.types.Set<String>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv, enclosing_returns_arrow: Bool) -> String {
  let pname = v1.std.core.param_node_name_at(n: param, source_indices: source_indices)
  let authored = v1.std.core.param_node_type_expr(n: param)
  let ty = if authored.params |> count > 0 {
    emit_rust_param_type(n: authored, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env, enclosing_returns_arrow: enclosing_returns_arrow)
  } else {
    render_rust_param_sig_type(param: param, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  concat(v1.compiler.emit.emit_ident(name: pname, target: v1.compiler.artifact.Rust), rust_items().param_type_sep, ty)
}

fn emit_inferred(inferred: v1.std.core.Node, generic_param_names: std.types.List<String>, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, variant_to_enum: std.types.Map<String, String>, env: v1.compiler.infer_env.TypeEnv) -> String {
  concat(rust_items().return_arrow, render_rust_fn_sig_type(n: inferred, generic_param_names: generic_param_names, shared_types: shared_types, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env))
}

fn needs_reference_node(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  if n.connective != v1.std.core.NoConnective || n.children |> count > 0 {
    true
  } else {
    let is_copy = is_rust_value_type(n: n, source_indices: source_indices)
      || (v1.compiler.infer_types.is_product_type(n: n) && n.children |> count == 0)
    v1.compiler.coercion.is_copy == false
  }
}

fn is_string_lit_pattern(p: v1.std.core.MatchPattern) -> Bool {
  match p {
    LitPattern { value: v } =>
      match v { LitStr { value: _ } => true  _ => false }
    _ => false
  }
}

fn pattern_string_binding_name(path: std.types.List<String>) -> String {
  if path |> count == 0 {
    "__pos0_val"
  } else {
    let segments = path |> map(seg => v1.compiler.emit.emit_ident(name: seg, target: v1.compiler.artifact.Rust))
    concat("__pos_", segments |> join(separator: "_"), "_val")
  }
}

fn positional_payload_string_guard(fb_pat: v1.std.core.MatchPattern, bind_name: String) -> String {
  match fb_pat {
    LitPattern { value: LitStr { value: s } } =>
      concat(bind_name, " == ", v1.compiler.emit.emit_string_literal(s: s, suffix: ""))
    _ => ""
  }
}

fn collect_field_binding_string_guards(field_bindings: std.types.List<v1.std.core.Node>, path_prefix: std.types.List<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  let parts = field_bindings |> flat_map(fb =>
    let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices)
    let fb_pat = v1.std.core.field_binding_pattern(n: fb)
    if is_string_lit_pattern(p: fb_pat) {
      let field_path = if fb_name == "0" {
        list_push(path_prefix, "0")
      } else {
        list_push(path_prefix, fb_name)
      }
      let bind_name = pattern_string_binding_name(path: field_path)
      match positional_payload_string_guard(fb_pat: fb_pat, bind_name: bind_name) {
        "" => []
        guard => [guard]
      }
    } else {
      let nested_path = list_push(path_prefix, fb_name)
      let nested = collect_pattern_string_guards(pattern: fb_pat, path_prefix: nested_path, source_indices: source_indices)
      if nested == "" { [] } else { [nested] }
    }
  )
  parts |> join(separator: " && ")
}

fn collect_pattern_string_guards(pattern: v1.std.core.MatchPattern, path_prefix: std.types.List<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  match pattern {
    VariantPattern { name: n, parent_enum: parent, field_bindings: fbs } =>
      if n == "Present" && parent == Present { value: "Optional" } && fbs |> count == 1 {
        match fbs |> first {
          Present { value: fb } =>
            let fb_pat = v1.std.core.field_binding_pattern(n: fb)
            if is_string_lit_pattern(p: fb_pat) {
              match fb_pat {
                LitPattern { value: LitStr { value: s } } =>
                  concat("__some_val == ", v1.compiler.emit.emit_string_literal(s: s, suffix: ""))
                _ => ""
              }
            } else {

              collect_pattern_string_guards(pattern: fb_pat, path_prefix: list_push(path_prefix, "Some"), source_indices: source_indices)
            }
          Absent => ""
        }
      } else if fbs |> count == 1 {
        match fbs |> first {
          Present { value: fb } =>
            if v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices) == "0" {
              let fb_pat = v1.std.core.field_binding_pattern(n: fb)
              let pos_path = list_push(list_push(path_prefix, n), "0")
              if is_string_lit_pattern(p: fb_pat) {
                positional_payload_string_guard(fb_pat: fb_pat, bind_name: pattern_string_binding_name(path: pos_path))
              } else {
                collect_pattern_string_guards(pattern: fb_pat, path_prefix: pos_path, source_indices: source_indices)
              }
            } else {
              collect_field_binding_string_guards(field_bindings: fbs, path_prefix: list_push(path_prefix, n), source_indices: source_indices)
            }
          Absent => ""
        }
      } else {
        collect_field_binding_string_guards(field_bindings: fbs, path_prefix: list_push(path_prefix, n), source_indices: source_indices)
      }
    _ => ""
  }
}

fn all_arms_are_string_lit(arms: std.types.List<v1.std.core.Node>) -> Bool {
  arms |> all(arm =>
    match v1.std.core.arm_pattern(n: arm) {
      LitPattern { value: v } =>
        match v { LitStr { value: _ } => true  _ => false }
      Wildcard => true
      _ => false
    }
  ) && arms |> count > 0
}

fn has_string_lit_with_bind(arms: std.types.List<v1.std.core.Node>) -> Bool {
  let has_lit = arms |> any(arm => match v1.std.core.arm_pattern(n: arm) {
    LitPattern { value: v } => match v { LitStr { value: _ } => true  _ => false }
    _ => false
  })
  let has_bind = arms |> any(arm => match v1.std.core.arm_pattern(n: arm) {
    Bind { declaration: _ } => true
    _ => false
  })
  has_lit && has_bind
}

fn emit_pattern(pattern: v1.std.core.MatchPattern, path_prefix: std.types.List<String>, shared_types: std.types.Set<String>, scrut_type: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match pattern {
    Bind { declaration: declaration } => v1.compiler.emit.emit_ident(name: declaration.name, target: v1.compiler.artifact.Rust)
    LitPattern { value: v } => v1.compiler.emit.rust_literal_for_pattern(value: v)
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      emit_variant_pattern(name: n, parent_enum: parent_enum, field_bindings: fbs, path_prefix: path_prefix, shared_types: shared_types, scrut_type: scrut_type, source_indices: source_indices, emit_info: emit_info)
    Wildcard => "_"
  }
}

fn pattern_parent_enum(name: String, parent_enum: String?, scrut_type: String, type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>) -> String? {
  let scrut_is_known_enum = scrut_type != "" && is_enum_type_name(type_name: scrut_type, type_summaries: type_summaries)
  if parent_enum != none {
    parent_enum
  } else if scrut_is_known_enum {
    Present { value: scrut_type }
  } else {
    unique_variant_parent(type_summaries: type_summaries, variant_name: name)
  }
}

fn unique_variant_parent(type_summaries: std.types.Map<String, v1.compiler.infer_emit_info.TypeSummary>, variant_name: String) -> String? {
  let parent_matches = sorted_map_keys(type_summaries)
    |> filter(type_name =>
      is_enum_type_name(type_name: type_name, type_summaries: type_summaries) &&
      v1.compiler.infer_emit_info.variant_belongs_to_enum(type_summaries: type_summaries, variant_name: variant_name, enum_name: type_name)
    )
  if parent_matches |> count == 1 {
    parent_matches |> first
  } else {
    none
  }
}

fn is_optional_variant_name(name: String) -> Bool {
  name == "Present" || name == "Absent" || name == "Some" || name == "None"
}

fn is_optional_like_parent_name(name: String) -> Bool {
  name == "Optional" || name == "Diagnostics"
}

fn is_some_like_variant_name(name: String) -> Bool {
  name == "Present" || name == "Some"
}

fn is_optional_parent(parent_enum: String?) -> Bool {
  match parent_enum {
    Present { value: parent } => is_optional_like_parent_name(name: parent)
    Absent => false
  }
}

fn positional_payload_scrut_type(parent_enum: String?, variant_name: String, field_binding: v1.std.core.Node, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  let type_key = match parent_enum {
    Present { value: parent } => v1.compiler.infer_emit_info.variant_summary_key(enum_name: parent, variant_name: variant_name)
    Absent => variant_name
  }
  match v1.compiler.infer_emit_info.lookup_emit_type_summary(emit_info: emit_info, type_name: type_key) {
    Present { value: summary } =>
      match map_get(summary.field_type_map, "0") {
        Present { value: payload_type } => payload_type
        Absent =>
          match field_binding.inferred {
            Present { value: v1.std.core.Resolved { node: rt } } =>
              v1.std.core.authored_name_at(source_indices: source_indices, node: v1.compiler.infer_types.normalize_access_type_node(n: rt))
            _ => ""
          }
      }
    Absent =>
      match field_binding.inferred {
        Present { value: v1.std.core.Resolved { node: rt } } =>
          v1.std.core.authored_name_at(source_indices: source_indices, node: v1.compiler.infer_types.normalize_access_type_node(n: rt))
        _ => ""
      }
  }
}

data optional_pattern_unknown_parent_note: String = "Present/Absent patterns with an UNRESOLVED parent enum lower to Some/None (kernel Optional): a bare Present/Absent struct pattern is never valid emitted Rust (no bare variant of that name exists in any emitted scope), so the raw fallback arm could only ever produce a compile error. A modeled optional carrier (e.g. OptionalNode) still resolves its parent via pattern_parent_enum and takes the qualified path; only the parent-unknown residue (an unstamped scrutinee, e.g. a let-in-lambda pipeline) reroutes."

data variant_pattern_dotted_qualification_note: String = "Construction wall for the dotted-render class in every position that emits a Rust Parent::Variant path. A namespace-QUALIFIED variant/parent name (post source_authority, e.g. v2.extdeps.languages.dag.ParseSubtreeFound, or a dotted parent from annotate_pattern_parent_enums's authored_name_at, from derive_variant_to_enum's summary.name, or from resolved_type_name) is not a valid Rust path component: rustc reports 'expected one of ..., found {' or 'found .', a PARSE error that then masks every later error in the module. Emitted Rust never needs a crate::-qualified path here (only import-line synthesis, a separate seam, brings the bare enum into scope), so both halves route through qualified_last_segment (v1.std.core, the single authority) via rust_variant_path -- identity on an already-bare name, so every previously-correct render is byte-identical. THE COVERAGE RULE THIS WALL IS SCOPED BY, corrected 2026-08-21: a wall's coverage is over PRODUCERS of the output shape, not over POSITIONS in the source. The earlier revision of this note claimed PATTERN position and named alias_rhs_qualified_name_routing_note (TYPE) and value_ref_ident_dotted_fallback_note (VALUE) as the siblings that closed the rest -- a partition by position, which is not the partition the defect lives in. Enumerating instead by output shape (every site that concatenates a parent and a variant name into one Rust path) found five producers of that one shape, of which the position-partitioned account had walled two: emit_variant_pattern and emit_variant_pattern_rc_aware (authored patterns, walled) versus emit_discriminant_call_lowering (SYNTHESIZES match arms for a discriminant lowering -- no authored pattern exists at that site at all, so no caller of the pattern wall ever reaches it), emit_value_ref_ident and its rc-aware sibling (VALUE position was declared walled, but only the LEAF half was: the parent came from effective_variant_parent, i.e. authored_name_at, and rode out dotted), rust_qualify_type_leaf_name (TYPE position, parent from derive_variant_to_enum), emit_enum_shared_accessors (SYNTHESIZES the accessor match arms), and rust_witness_variant_ctor_path (parent reduced, variant half not). A synthesizing producer is invisible to a position census by construction, because the position it writes into has no authored source to census. The two byte-identical helpers variant_pattern_qualified_path and variant_pattern_shape_key were one concept under two names (DESIGN section 3) and are folded into rust_variant_path / rust_variant_path_opt, named for the output shape rather than for one of the positions that emits it -- a position-named authority is what licensed the position-partitioned coverage claim above."

fn rust_variant_path(parent: String, rust_name: String) -> String {
  concat(qualified_last_segment(name: parent), "::", qualified_last_segment(name: rust_name))
}

fn rust_variant_path_opt(rust_name: String, resolved_parent: String?) -> String {
  match resolved_parent {
    Present { value: parent } => rust_variant_path(parent: parent, rust_name: rust_name)
    Absent => qualified_last_segment(name: rust_name)
  }
}

fn variant_pattern_shape_str(qualified: String, rust_name: String, resolved_parent: String?, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let shape_key = rust_variant_path_opt(rust_name: rust_name, resolved_parent: resolved_parent)
  let is_positional = set_contains(emit_info.positional_payload_variants, shape_key)
    || set_contains(emit_info.positional_payload_variants, qualified)
  let is_fielded = set_contains(emit_info.fielded_variants, shape_key)
    || set_contains(emit_info.fielded_variants, qualified)
  if is_positional { concat(qualified, "(_)") }
  else if is_fielded { concat(qualified, " { .. }") } else { qualified }
}

fn emit_variant_pattern(name: String, parent_enum: String?, field_bindings: std.types.List<v1.std.core.Node>, path_prefix: std.types.List<String>, shared_types: std.types.Set<String>, scrut_type: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let bare_name = v1.std.core.qualified_last_segment(name: name)
  let resolved_parent = pattern_parent_enum(name: bare_name, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: emit_info.type_summaries)
  let optional_variant = is_optional_variant_name(name: bare_name)
    && (is_optional_parent(parent_enum: resolved_parent) || resolved_parent == none)
  let rust_name = if optional_variant {
    if is_some_like_variant_name(name: bare_name) { "Some" } else { "None" }
  } else { bare_name }
  let qualified = if optional_variant {
    rust_name
  } else {
    rust_variant_path_opt(rust_name: rust_name, resolved_parent: resolved_parent)
  }
  if optional_variant && is_some_like_variant_name(name: bare_name) && field_bindings |> count == 1 {
    match field_bindings |> first {
      Present { value: fb } =>
        let fb_pat = v1.std.core.field_binding_pattern(n: fb)
        if is_string_lit_pattern(p: fb_pat) {
          "Some(ref __some_val)"
        } else {
          let inner_pat = emit_pattern(pattern: fb_pat, path_prefix: list_push(path_prefix, rust_name), shared_types: shared_types, scrut_type: scrut_type, source_indices: source_indices, emit_info: emit_info)
          concat("Some(", inner_pat, ")")
        }
      Absent => qualified
    }
  } else if field_bindings |> count == 1 {
    match field_bindings |> first {
      Present { value: fb } =>
        if v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices) == "0" {
          let fb_pat = v1.std.core.field_binding_pattern(n: fb)
          let pos_path = list_push(list_push(path_prefix, bare_name), "0")
          let bind_name = pattern_string_binding_name(path: pos_path)
          if is_string_lit_pattern(p: fb_pat) {
            concat(qualified, "(ref ", bind_name, ")")
          } else {
            let payload_scrut = positional_payload_scrut_type(parent_enum: resolved_parent, variant_name: bare_name, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
            let inner_pat = emit_pattern(pattern: fb_pat, path_prefix: pos_path, shared_types: shared_types, scrut_type: payload_scrut, source_indices: source_indices, emit_info: emit_info)
            concat(qualified, "(", inner_pat, ")")
          }
        } else {
          let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices)
          let fb_pat = v1.std.core.field_binding_pattern(n: fb)
          if is_string_lit_pattern(p: fb_pat) {
            let bind_name = pattern_string_binding_name(path: list_push(list_push(path_prefix, bare_name), fb_name))
            concat(qualified, " { ref ", bind_name, ", .. }")
          } else {
            let pat_str = emit_pattern(pattern: fb_pat, path_prefix: list_push(list_push(path_prefix, bare_name), fb_name), shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
            concat(qualified, " { ", concat(v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust), ": ", pat_str), ", .. }")
          }
        }
      Absent => qualified
    }
  } else if field_bindings |> count == 0 {
    variant_pattern_shape_str(qualified: qualified, rust_name: rust_name, resolved_parent: resolved_parent, emit_info: emit_info)
  } else {
    let effective_bindings = field_bindings |> filter(fb =>
      match v1.std.core.field_binding_pattern(n: fb) { extdeps.cron.schedule_model.Wildcard => false  _ => true }
    )
    if effective_bindings |> count == 0 {
      variant_pattern_shape_str(qualified: qualified, rust_name: rust_name, resolved_parent: resolved_parent, emit_info: emit_info)
    } else {
      let binding_strs = effective_bindings |> map(fb =>
        let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices)
        let fb_pat = v1.std.core.field_binding_pattern(n: fb)
        if is_string_lit_pattern(p: fb_pat) {
          let field_path = if fb_name == "0" {
            list_push(list_push(path_prefix, bare_name), "0")
          } else {
            list_push(list_push(path_prefix, bare_name), fb_name)
          }
          let bind_name = pattern_string_binding_name(path: field_path)
          concat("ref ", bind_name)
        } else {
            let is_shorthand = match fb_pat { v2.std.node.Bind { declaration: declaration } => declaration.name == fb_name  _ => false }
            if is_shorthand { v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust) }
            else {
              let field_path = if fb_name == "0" {
                list_push(list_push(path_prefix, bare_name), "0")
              } else {
                list_push(list_push(path_prefix, bare_name), fb_name)
              }
              let pat_str = emit_pattern(pattern: fb_pat, path_prefix: field_path, shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
              concat(v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust), ": ", pat_str)
            }
        }
      )
      let bindings_str = binding_strs |> join(separator: ", ")
      concat(qualified, " { ", bindings_str, ", .. }")
    }
  }
}

type RcPatternAnalysis {
  matches_rc_variant: Bool
  matches_option_rc_variant: Bool
  needs_rc_pattern: Bool
  ref_bound_fields: std.types.List<String>
}

type RcMatchAnalysis {
  needs_option_deref: Bool
  needs_deref: Bool
  needs_rc_option_ref: Bool
}

fn empty_rc_pattern_analysis() -> RcPatternAnalysis {
  RcPatternAnalysis {
    matches_rc_variant: false,
    matches_option_rc_variant: false,
    needs_rc_pattern: false,
    ref_bound_fields: []
  }
}

fn field_needs_rc_ref(field_name: String, rc_analysis: RcPatternAnalysis) -> Bool {
  rc_analysis.ref_bound_fields |> any(name => name == field_name)
}

fn analyze_rc_pattern(pattern: v1.std.core.MatchPattern, scrut_type: String, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> RcPatternAnalysis {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      let bare_n = v1.std.core.qualified_last_segment(name: n)
      if is_optional_variant_name(name: bare_n) && is_optional_parent(parent_enum: parent_enum) {
        if fbs |> count == 1 {
          match fbs |> first {
            Present { value: fb } =>
              let inner = analyze_rc_pattern(pattern: v1.std.core.field_binding_pattern(n: fb), scrut_type: "", shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
              RcPatternAnalysis {
                matches_rc_variant: false,
                matches_option_rc_variant: is_some_like_variant_name(name: bare_n) && inner.matches_rc_variant,
                needs_rc_pattern: inner.needs_rc_pattern,
                ref_bound_fields: []
              }
            Absent => empty_rc_pattern_analysis()
          }
        } else { empty_rc_pattern_analysis() }
      } else {
        let resolved_parent = pattern_parent_enum(name: bare_n, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: emit_info.type_summaries)
        let matches_rc_variant = match resolved_parent {
          Present { value: enum_name } => set_contains(shared_types, enum_name)
          Absent => false
        }
        let ref_bound_fields = fbs |> flat_map(fb =>
          let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices)
          let inner_scrut = if fb_name == "0" {
            positional_payload_scrut_type(parent_enum: resolved_parent, variant_name: bare_n, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
          } else { "" }
          if analyze_rc_pattern(pattern: v1.std.core.field_binding_pattern(n: fb), scrut_type: inner_scrut, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices).matches_rc_variant {
            [fb_name]
          } else { [] }
        )
        RcPatternAnalysis {
          matches_rc_variant: matches_rc_variant,
          matches_option_rc_variant: false,
          needs_rc_pattern: ref_bound_fields |> count > 0,
          ref_bound_fields: ref_bound_fields
        }
      }
    _ => empty_rc_pattern_analysis()
  }
}

fn box_bound_fields_for_pattern(pattern: v1.std.core.MatchPattern, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, scope: v1.compiler.infer.InferScope) -> std.types.List<String> {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      let bare_n = v1.std.core.qualified_last_segment(name: n)
      if is_optional_variant_name(name: bare_n) && is_optional_parent(parent_enum: parent_enum) {
        []
      } else {
        fbs |> flat_map(fb =>
          let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: scope.type_env.source_indices)
          let fb_pat = v1.std.core.field_binding_pattern(n: fb)
          if fb_name == "0" {
            []
          } else {
            match fb_pat {
              Wildcard => []
              _ =>
                if rust_record_field_needs_box(scope: scope, emit_info: emit_info, shared_types: shared_types, struct_name: bare_n, field_name: fb_name) {
                  [fb_name]
                } else { [] }
            }
          }
        )
      }
    _ => []
  }
}

fn rc_pattern_analysis_with_box_fields(rc_analysis: RcPatternAnalysis, arm_pat: v1.std.core.MatchPattern, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, scope: v1.compiler.infer.InferScope) -> RcPatternAnalysis {
  let box_fields = box_bound_fields_for_pattern(pattern: arm_pat, shared_types: shared_types, emit_info: emit_info, scope: scope)
  if box_fields |> count == 0 {
    rc_analysis
  } else {
    RcPatternAnalysis {
      matches_rc_variant: rc_analysis.matches_rc_variant,
      matches_option_rc_variant: rc_analysis.matches_option_rc_variant,
      needs_rc_pattern: true,
      ref_bound_fields: concat(rc_analysis.ref_bound_fields, box_fields)
    }
  }
}

fn analyze_rc_match(scrutinee: v1.std.core.Node, arms: std.types.List<v1.std.core.Node>, scrut_type: String, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> RcMatchAnalysis {
  let arm_analyses = arms |> map(arm =>
    analyze_rc_pattern(pattern: v1.std.core.arm_pattern(n: arm), scrut_type: scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
  )
  let scrutinee_is_optional = match scrutinee.inferred {
    Present { value: v1.std.core.Resolved { node: rt } } => rt.return_cardinality == v1.std.core.CardOptional
    _ => false
  }
  let scrutinee_is_rc_wrapped = match scrutinee.inferred {
    Present { value: v1.std.core.Resolved { node: rt } } =>
      rust_carrier_is_at_shared_layer(n: rt, source_indices: source_indices, shared_types: shared_types)
    _ => false
  }
  let arms_want_option = arm_analyses |> any(a => a.matches_option_rc_variant)
  let arms_want_deref = arm_analyses |> any(a => a.matches_rc_variant)
  let scrutinee_is_rc_modeled_optional = match scrutinee.inferred {
    Present { value: v1.std.core.Resolved { node: rt } } =>
      is_optional_like_parent_name(name: v1.std.core.authored_name_at(source_indices: source_indices, node: rt))
        && rt.return_cardinality != v1.std.core.CardOptional
        && rust_carrier_is_at_shared_layer(n: rt, source_indices: source_indices, shared_types: shared_types)
    _ => false
  }

  RcMatchAnalysis {
    needs_option_deref: arms_want_option,
    needs_deref: if scrutinee_is_optional || scrutinee_is_rc_modeled_optional { false } else { scrutinee_is_rc_wrapped || arms_want_deref },
    needs_rc_option_ref: scrutinee_is_rc_modeled_optional
  }
}

fn emit_pattern_rc_aware(pattern: v1.std.core.MatchPattern, path_prefix: std.types.List<String>, rc_analysis: RcPatternAnalysis, shared_types: std.types.Set<String>, scrut_type: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match pattern {
    Bind { declaration: declaration } => v1.compiler.emit.emit_ident(name: declaration.name, target: v1.compiler.artifact.Rust)
    LitPattern { value: v } => v1.compiler.emit.rust_literal_for_pattern(value: v)
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      emit_variant_pattern_rc_aware(name: n, parent_enum: parent_enum, field_bindings: fbs, path_prefix: path_prefix, rc_analysis: rc_analysis, shared_types: shared_types, scrut_type: scrut_type, source_indices: source_indices, emit_info: emit_info)
    Wildcard => "_"
  }
}

fn emit_variant_pattern_rc_aware(name: String, parent_enum: String?, field_bindings: std.types.List<v1.std.core.Node>, path_prefix: std.types.List<String>, rc_analysis: RcPatternAnalysis, shared_types: std.types.Set<String>, scrut_type: String, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let bare_name = v1.std.core.qualified_last_segment(name: name)
  let resolved_parent = pattern_parent_enum(name: bare_name, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: emit_info.type_summaries)
  let optional_variant = is_optional_variant_name(name: bare_name)
    && (is_optional_parent(parent_enum: resolved_parent) || resolved_parent == none)
  let rust_name = if optional_variant {
    if is_some_like_variant_name(name: bare_name) { "Some" } else { "None" }
  } else { bare_name }
  let qualified = if optional_variant {
    rust_name
  } else {
    rust_variant_path_opt(rust_name: rust_name, resolved_parent: resolved_parent)
  }
  if optional_variant && is_some_like_variant_name(name: bare_name) && field_bindings |> count == 1 {
    match field_bindings |> first {
      Present { value: fb } =>
        let fb_pat = v1.std.core.field_binding_pattern(n: fb)
        if is_string_lit_pattern(p: fb_pat) {
          "Some(ref __some_val)"
        } else {
          let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
          let inner_pat = emit_pattern_rc_aware(pattern: fb_pat, path_prefix: list_push(path_prefix, rust_name), rc_analysis: inner_analysis, shared_types: shared_types, scrut_type: scrut_type, source_indices: source_indices, emit_info: emit_info)
          concat("Some(", inner_pat, ")")
        }
      Absent => qualified
    }
  } else if field_bindings |> count == 1 {
    match field_bindings |> first {
      Present { value: fb } =>
        if v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices) == "0" {
          let fb_pat = v1.std.core.field_binding_pattern(n: fb)
          let pos_path = list_push(list_push(path_prefix, bare_name), "0")
          let bind_name = pattern_string_binding_name(path: pos_path)
          if is_string_lit_pattern(p: fb_pat) {
            concat(qualified, "(ref ", bind_name, ")")
          } else {
            let payload_scrut = positional_payload_scrut_type(parent_enum: resolved_parent, variant_name: bare_name, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
            let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: payload_scrut, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
            let inner_pat = emit_pattern_rc_aware(pattern: fb_pat, path_prefix: pos_path, rc_analysis: inner_analysis, shared_types: shared_types, scrut_type: payload_scrut, source_indices: source_indices, emit_info: emit_info)
            concat(qualified, "(", inner_pat, ")")
          }
        } else {
          let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices)
          let fb_pat = v1.std.core.field_binding_pattern(n: fb)
          if is_string_lit_pattern(p: fb_pat) {
            let bind_name = pattern_string_binding_name(path: list_push(list_push(path_prefix, bare_name), fb_name))
            concat(qualified, " { ref ", bind_name, ", .. }")
          } else if field_needs_rc_ref(field_name: fb_name, rc_analysis: rc_analysis) {
            concat(qualified, " { ref ", v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust), ", .. }")
          } else {
            let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
            let pat_str = emit_pattern_rc_aware(pattern: fb_pat, path_prefix: list_push(list_push(path_prefix, bare_name), fb_name), rc_analysis: inner_analysis, shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
            concat(qualified, " { ", concat(v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust), ": ", pat_str), ", .. }")
          }
        }
      Absent => qualified
    }
  } else if field_bindings |> count == 0 {
    variant_pattern_shape_str(qualified: qualified, rust_name: rust_name, resolved_parent: resolved_parent, emit_info: emit_info)
  } else {
    let effective_bindings = field_bindings |> filter(fb =>
      match v1.std.core.field_binding_pattern(n: fb) { extdeps.cron.schedule_model.Wildcard => false  _ => true }
    )
    if effective_bindings |> count == 0 {
      variant_pattern_shape_str(qualified: qualified, rust_name: rust_name, resolved_parent: resolved_parent, emit_info: emit_info)
    } else {
      let binding_strs = effective_bindings |> map(fb =>
        let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices)
        let fb_pat = v1.std.core.field_binding_pattern(n: fb)
        if is_string_lit_pattern(p: fb_pat) {
          let field_path = if fb_name == "0" {
            list_push(list_push(path_prefix, bare_name), "0")
          } else {
            list_push(list_push(path_prefix, bare_name), fb_name)
          }
          let bind_name = pattern_string_binding_name(path: field_path)
          concat("ref ", bind_name)
        } else {
          if field_needs_rc_ref(field_name: fb_name, rc_analysis: rc_analysis) {
            concat("ref ", v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust))
          } else {
            let is_shorthand = match fb_pat { v2.std.node.Bind { declaration: declaration } => declaration.name == fb_name  _ => false }
            if is_shorthand { v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust) }
            else {
              let field_path = if fb_name == "0" {
                list_push(list_push(path_prefix, bare_name), "0")
              } else {
                list_push(list_push(path_prefix, bare_name), fb_name)
              }
              let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: "", shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
              let pat_str = emit_pattern_rc_aware(pattern: fb_pat, path_prefix: field_path, rc_analysis: inner_analysis, shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
              concat(v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust), ": ", pat_str)
            }
          }
        }
      )
      let bindings_str = binding_strs |> join(separator: ", ")
      concat(qualified, " { ", bindings_str, ", .. }")
    }
  }
}

fn match_pattern_is_irrefutable(pattern: v1.std.core.MatchPattern) -> Bool {
  match pattern {
    Bind { declaration: _ } => true
    Wildcard => true
    _ => false
  }
}

fn variant_pattern_shape_for(name: String, parent_enum: String?, scrut_type: String, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let bare_name = v1.std.core.qualified_last_segment(name: name)
  let resolved_parent = pattern_parent_enum(name: bare_name, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: emit_info.type_summaries)
  let optional_variant = is_optional_variant_name(name: bare_name)
    && (is_optional_parent(parent_enum: resolved_parent) || resolved_parent == none)
  let rust_name = if optional_variant {
    if is_some_like_variant_name(name: bare_name) { "Some" } else { "None" }
  } else { bare_name }
  let qualified = if optional_variant {
    rust_name
  } else {
    rust_variant_path_opt(rust_name: rust_name, resolved_parent: resolved_parent)
  }
  variant_pattern_shape_str(qualified: qualified, rust_name: rust_name, resolved_parent: resolved_parent, emit_info: emit_info)
}

fn collect_pattern_rc_variant_guards(pattern: v1.std.core.MatchPattern, rc_analysis: RcPatternAnalysis, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      let bare_n = v1.std.core.qualified_last_segment(name: n)
      if is_optional_variant_name(name: bare_n) && is_optional_parent(parent_enum: parent_enum) {
        if fbs |> count == 1 {
          match fbs |> first {
            Present { value: fb } =>
              let fb_pat = v1.std.core.field_binding_pattern(n: fb)
              let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: "", shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
              collect_pattern_rc_variant_guards(pattern: fb_pat, rc_analysis: inner_analysis, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
            Absent => ""
          }
        } else { "" }
      } else {
        let resolved_parent = pattern_parent_enum(name: bare_n, parent_enum: parent_enum, scrut_type: "", type_summaries: emit_info.type_summaries)
        let parts = fbs |> flat_map(fb =>
          let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices)
          if fb_name == "0" {
            let fb_pat = v1.std.core.field_binding_pattern(n: fb)
            let payload_scrut = positional_payload_scrut_type(parent_enum: resolved_parent, variant_name: bare_n, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
            let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: payload_scrut, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
            let inner = collect_pattern_rc_variant_guards(pattern: fb_pat, rc_analysis: inner_analysis, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
            if inner == "" { [] } else { [inner] }
          } else if field_needs_rc_ref(field_name: fb_name, rc_analysis: rc_analysis) {
            let fb_pat = v1.std.core.field_binding_pattern(n: fb)
            if match_pattern_is_irrefutable(pattern: fb_pat) { [] }
            else {
              match fb_pat {
                VariantPattern { name: inner_n, parent_enum: inner_parent, field_bindings: _ } =>
                  let shape = variant_pattern_shape_for(name: inner_n, parent_enum: inner_parent, scrut_type: "", emit_info: emit_info)
                  [concat("matches!(", v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust), ".as_ref(), ", shape, ")")]
                _ => []
              }
            }
          } else { [] }
        )
        parts |> join(separator: " && ")
      }
    _ => ""
  }
}

fn rc_pattern_preludes(pattern: v1.std.core.MatchPattern, rc_analysis: RcPatternAnalysis, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      let bare_n = v1.std.core.qualified_last_segment(name: n)
      if is_optional_variant_name(name: bare_n) && is_optional_parent(parent_enum: parent_enum) {
        if fbs |> count == 1 {
          match fbs |> first {
            Present { value: fb } =>
              let fb_pat = v1.std.core.field_binding_pattern(n: fb)
              let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: "", shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
              rc_pattern_preludes(pattern: fb_pat, rc_analysis: inner_analysis, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
            Absent => ""
          }
        } else { "" }
      } else {
        let resolved_parent = pattern_parent_enum(name: bare_n, parent_enum: parent_enum, scrut_type: "", type_summaries: emit_info.type_summaries)
        let preludes = fbs |> flat_map(fb =>
          let fb_name = v1.std.core.field_binding_name_at(n: fb, source_indices: source_indices)
          if fb_name == "0" {
            let payload_scrut = positional_payload_scrut_type(parent_enum: resolved_parent, variant_name: bare_n, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
            let inner_analysis = analyze_rc_pattern(pattern: v1.std.core.field_binding_pattern(n: fb), scrut_type: payload_scrut, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
            let inner_preludes = rc_pattern_preludes(pattern: v1.std.core.field_binding_pattern(n: fb), rc_analysis: inner_analysis, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
            if inner_preludes == "" { [] } else { [inner_preludes] }
          } else if field_needs_rc_ref(field_name: fb_name, rc_analysis: rc_analysis) {
            let fb_pat_here = v1.std.core.field_binding_pattern(n: fb)
            let bound_str = emit_pattern(pattern: fb_pat_here, path_prefix: list_push(list_push([], bare_n), fb_name), shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
            let tail = if match_pattern_is_irrefutable(pattern: fb_pat_here) {
              ";"
            } else {
              " else { unreachable!() };"
            }
            [concat("let ", bound_str, " = ", v1.compiler.emit.emit_ident(name: fb_name, target: v1.compiler.artifact.Rust), ".as_ref()", tail)]
          } else { [] }
        )
        preludes |> join(separator: " ")
      }
    _ => ""
  }
}

fn explicit_record_struct_name(type_name: String?, inferred_node: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  let is_optional = inferred_node.return_cardinality == v1.std.core.CardOptional
  if is_optional {
    let result = type_name
    return result
  }
  let has_structure = inferred_node.connective != v1.std.core.NoConnective
  let n = if inferred_node.type_annotation != none && has_structure {
    match inferred_node.children |> first {
      Present { value: base } => base
      Absent => inferred_node
    }
  } else { inferred_node }
  let is_product = v1.compiler.infer_types.is_product_type(n: n)
  let is_coproduct = v1.compiler.infer_types.is_coproduct_type(n: n)
  let n_is_error = if n.inferred != none { v1.std.core.is_compiler_error(inferred: n.inferred.value) } else { false }
  let nname = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  if nname == "__EmitTypeCacheMiss" { type_name }
    else if n_is_error { type_name }
    else if is_product {
      if n.ident_span == none { type_name } else { Present { value: nname } }
    } else if is_coproduct {
      type_name
    } else if n.children |> count == 0 && n.ident_span != none {
      Present { value: nname }
    } else {
      type_name
    }
}

fn is_simple_type_node(n: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool { is_rust_value_type(n: n, source_indices: source_indices) }

fn variant_parent_from_binding_kind(binding_kind: v1.std.core.VarBindingKind?) -> String? {
  match binding_kind {
    Present { value: v1.std.core.VariantValueBinding { parent_enum: parent_enum } } => Present { value: parent_enum }
    _ => none
  }
}

fn apply_clone(expr: String) -> String {
  v1.compiler.emit_core_support.apply_type_template1(template: v1.compiler.languages.sharing_for_target(target: v1.compiler.artifact.Rust).clone_value, arg0: expr)
}

fn apply_deref_clone(expr: String) -> String {
  v1.compiler.emit_core_support.apply_type_template1(template: v1.compiler.languages.sharing_for_target(target: v1.compiler.artifact.Rust).deref_clone, arg0: expr)
}

fn apply_field_clone(expr: String, field: String) -> String {
  v1.compiler.emit_core_support.apply_type_template2(template: v1.compiler.languages.sharing_for_target(target: v1.compiler.artifact.Rust).field_clone, arg0: expr, arg1: field)
}

fn clone_iterator_suffix() -> String {
  v1.compiler.languages.sharing_for_target(target: v1.compiler.artifact.Rust).clone_suffix
}

fn freemonoid_empty_from_variant_parent(leaf_name: String, enum_name: String) -> Bool {
  leaf_name == "Empty" && enum_name == "FreeMonoid"
}

fn freemonoid_empty_from_emit_info(leaf_name: String, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> Bool {
  leaf_name == "Empty" && match map_get(emit_info.variant_to_enum, "Empty") {
    Present { value: p } => p == "FreeMonoid"
    Absent => false
  }
}

fn emit_freemonoid_empty_rc_value() -> String {
  rust_shared_wrap_ctor(inner_expr: "vec![]")
}

fn emit_freemonoid_empty_variant_body() -> String {
  "vec![]"
}

fn effective_variant_parent_from_enum_lookup(leaf_name: String, rt: v1.std.core.Node, binding_kind: v1.std.core.VarBindingKind?, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  let rt_name = v1.std.core.authored_name_at(source_indices: source_indices, node: rt)
  if rt.ident_span != none && rt_name != leaf_name && v1.compiler.infer_emit_info.variant_belongs_to_enum(type_summaries: emit_info.type_summaries, variant_name: leaf_name, enum_name: rt_name) {
    Present { value: rt_name }
  } else {
    variant_parent_from_binding_kind(binding_kind: binding_kind)
  }
}

fn effective_variant_parent_from_resolved(leaf_name: String, rt: v1.std.core.Node, binding_kind: v1.std.core.VarBindingKind?, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  match rt.return_cardinality {
    CardOptional =>
      if is_optional_variant_name(name: leaf_name) { Present { value: "Optional" } } else { effective_variant_parent_from_enum_lookup(leaf_name: leaf_name, rt: rt, binding_kind: binding_kind, emit_info: emit_info, source_indices: source_indices) }
    _ => effective_variant_parent_from_enum_lookup(leaf_name: leaf_name, rt: rt, binding_kind: binding_kind, emit_info: emit_info, source_indices: source_indices)
  }
}

fn effective_variant_parent(name: String, binding_kind: v1.std.core.VarBindingKind?, resolved_type: v1.std.core.InferredNode?, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String? {
  let leaf_name = value_ref_qualified_leaf(name: name)
  let cached = match map_get(emit_info.variant_to_enum, leaf_name) {
    Present { value: p } => if p != "" { Present { value: p } } else { none }
    Absent => none
  }
  match cached {
    Present { value: parent } => Present { value: parent }
    Absent =>
      match resolved_type {
        Present { value: v1.std.core.Resolved { node: rt } } =>
          effective_variant_parent_from_resolved(leaf_name: leaf_name, rt: rt, binding_kind: binding_kind, emit_info: emit_info, source_indices: source_indices)
        _ => variant_parent_from_binding_kind(binding_kind: binding_kind)
      }
  }
}

fn variant_ref_self_wraps(name: String, enum_name: String, shared_types: std.types.Set<String>) -> Bool {
  freemonoid_empty_from_variant_parent(leaf_name: name, enum_name: enum_name) || set_contains(shared_types, enum_name)
}

data value_ref_ident_dotted_fallback_note: String = "Construction wall for the dotted-render class in VALUE-EXPRESSION position (sibling of variant_pattern_dotted_qualification_note/PATTERN, bare_qualified_name in emit_typed_record_lit/CONSTRUCTION, coerce_primitive_type_dotted_fallback_note/TYPE, and rust_fn_sig_leaf_name_dotted_note/FN-SIG TYPE). A namespace-qualified dotted name (e.g. v2.std.node.Edge) whose leaf misses the registry previously fell through to emit_ident(name: name, ...) with the FULL dotted string still attached — emit_ident has no dot-awareness (pure case-conversion/sanitization), so the dots rode straight into the emitted Rust as a bare field-access chain starting at the first segment (rustc: 'cannot find value v2 in this scope', E0425). Fixed by passing the already-computed leaf, the same qualified_last_segment (v1.std.core) reduction the Present arm already keys its registry lookup on — not a new fallback, the existing one corrected to use the value already in scope. The CALL-callee sibling (emit_typed_call's func_ident, e.g. a bare dotted function reference like v2.std.staging.resolve_probe(..) rendered verbatim) reuses this same fn directly rather than re-deriving the leaf a third time (DESIGN section 2/3: one shared helper, not a forked per-seam patch); its registry lookup (the `callee` binding) is likewise re-keyed on qualified_last_segment(func) so a dotted cross-module call resolves the same ItemInfo a bare call would. Every already-bare name renders exactly as before (qualified_last_segment is the identity on an unqualified name)."

data value_ref_cross_module_qualifier_routing_note: String = "Construction wall for cross-module qualified VALUE references when the flat item_registry leaf key collides (post-#7685 class, witness qualified_leaf_registry_collision_emit_witness_test): map_get(registry, leaf) returns whichever module won the last-write-wins insert, so emit_value_ref_ident must render crate paths from the authored qualifier prefix (value_ref_qualifier_prefix) rather than info.module_name from the collision winner. Same-module normalization (value_ref_normalize_self_module) remains the sibling wall for the qualifier == current-module case."

fn emit_value_ref_ident(name: String, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  if string_contains(s: name, pattern: ".") {
    let leaf = value_ref_qualified_leaf(name: name)
    let qualifier = value_ref_qualifier_prefix(name: name)
    if qualifier != "" {
      match lookup_item_for_value_ref(resolved_name: name, registry: registry) {
        Present { value: info } =>
          emit_qualified_value_ref_crate_ident(leaf: leaf, info: info, registry: registry)
        Absent =>
          v1.compiler.emit.emit_error_expr(message: "qualified value reference missing exact registry row — refuse authored qualifier", target: v1.compiler.artifact.Rust)
      }
    } else {
      match map_get(registry, leaf) {
        Present { value: info } =>
          emit_qualified_value_ref_crate_ident(leaf: leaf, info: info, registry: registry)
        Absent =>
          if freemonoid_empty_from_emit_info(leaf_name: leaf, emit_info: emit_info) { emit_freemonoid_empty_rc_value() }
          else { v1.compiler.emit.emit_ident(name: leaf, target: v1.compiler.artifact.Rust) }
      }
    }
  } else {
    v1.compiler.emit.emit_ident(name: name, target: v1.compiler.artifact.Rust)
  }
}

data none_undetermined_carrier_refuse_note: String = "Fail-open closed (sharp-bee-290 msg_6317aebe / DESIGN §5): when none/None has no resolved variant_parent, the emitter previously emitted Rust null as a fabricated plausible default. variant_parent == none conflated (a) bare Optional none with a determined CardOptional carrier and (b) undetermined carrier. Split: CardOptional → None (type-directed); any other determined non-optional carrier → typed refuse; undetermined (Absent / non-Resolved inferred) → typed refuse. Never null as a default. The refuse surfaces as emit_error_expr (UNRESOLVED_… diagnostic text in emitted Rust) so the deficit is countable; if the refusal spike is corpus-red-large, fold a named counted interim INSIDE this single decision with an explicit dissolution trigger — never restore an escaping Optional default at callers."

fn emit_none_keyword_for_resolved_type(resolved_type: v1.std.core.InferredNode?) -> String {
  match resolved_type {
    Present { value: v1.std.core.Resolved { node: rt } } =>
      match rt.return_cardinality {
        CardOptional => v1.compiler.emit.emit_keyword(key: "null", target: v1.compiler.artifact.Rust)
        _ => v1.compiler.emit.emit_error_expr(message: "none/None with non-optional resolved carrier — refuse fail-open null default", target: v1.compiler.artifact.Rust)
      }
    _ => v1.compiler.emit.emit_error_expr(message: "none/None with undetermined carrier — refuse fail-open null default", target: v1.compiler.artifact.Rust)
  }
}

fn emit_var_ref(name: String, binding_kind: v1.std.core.VarBindingKind?, resolved_type: v1.std.core.InferredNode?, shared_types: std.types.Set<String>, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_name: String) -> String {
  let resolved_name = value_ref_normalize_self_module(name: name, module_name: module_name)
  let leaf_name = value_ref_qualified_leaf(name: resolved_name)
  let variant_parent = effective_variant_parent(name: resolved_name, binding_kind: binding_kind, resolved_type: resolved_type, emit_info: emit_info, source_indices: source_indices)
  if (leaf_name == "none" || leaf_name == "None") && variant_parent == none { emit_none_keyword_for_resolved_type(resolved_type: resolved_type) }
  else if leaf_name == "true" || leaf_name == "false" { v1.compiler.emit.emit_keyword(key: leaf_name, target: v1.compiler.artifact.Rust) }
  else {

    let moves_by_value = set_contains(emit_info.movable, resolved_name)
    let sharing = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Rust).sharing
    let ref_str = match variant_parent {
      Present { value: enum_name } =>
        let body = if freemonoid_empty_from_variant_parent(leaf_name: leaf_name, enum_name: enum_name) {
          emit_freemonoid_empty_variant_body()
        } else if is_optional_variant_name(name: leaf_name) && is_optional_like_parent_name(name: enum_name) {
          if is_some_like_variant_name(name: leaf_name) { "Some" } else { "None" }
        } else {
          rust_variant_path(parent: enum_name, rust_name: leaf_name)
        }
        if variant_ref_self_wraps(name: leaf_name, enum_name: enum_name, shared_types: shared_types) {
          rust_shared_wrap_ctor(inner_expr: body)
        } else { body }
      Absent =>
        match lookup_item_for_value_ref(resolved_name: resolved_name, registry: registry) {
          Present { value: info } =>
            if is_duplicate_qualified_item_registry_marker(info: info) {
              value_ref_item_info_refusal(info: info)
            } else {
              let is_data = info.kind == v1.compiler.infer_items.DataItem
              if is_data { concat(emit_value_ref_ident(name: name, registry: registry, emit_info: emit_info), "()") }
              else {
              let is_function_value = match binding_kind {
                Present { value: v1.std.core.FunctionValueBinding } => true
                _ => false
              }
              let ident = emit_value_ref_ident(name: resolved_name, registry: registry, emit_info: emit_info)
              let ident_str = if is_function_value {
                ident
              } else if moves_by_value {
                ident
              } else { match resolved_type {
                Present { value: _ } => v1.compiler.emit_core_support.apply_type_template1(template: sharing.clone_value, arg0: ident)
                _ => ident
              } }
              ident_str
              }
            }
          Absent =>
            let ident = emit_value_ref_ident(name: resolved_name, registry: registry, emit_info: emit_info)
            let ident_str = if moves_by_value {
              ident
            } else { match resolved_type {
              Present { value: _ } => v1.compiler.emit_core_support.apply_type_template1(template: sharing.clone_value, arg0: ident)
              _ => ident
            } }
            ident_str
        }
    }
    ref_str
  }
}

fn emit_typed_expr_base(texpr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  match texpr.expr_data {
    ExprVar { binding_kind: binding_kind } =>
      let n = v1.std.core.expr_var_name_at(texpr: texpr, source_indices: si)
      let leaf_name = value_ref_qualified_leaf(name: n)
      let variant_parent = effective_variant_parent(name: n, binding_kind: binding_kind, resolved_type: texpr.inferred, emit_info: emit_info, source_indices: si)
      if (leaf_name == "none" || leaf_name == "None") && variant_parent == none { emit_none_keyword_for_resolved_type(resolved_type: texpr.inferred) }
      else if leaf_name == "true" || leaf_name == "false" { v1.compiler.emit.emit_keyword(key: leaf_name, target: v1.compiler.artifact.Rust) }
      else {
        match variant_parent {
          Present { value: enum_name } =>
            if freemonoid_empty_from_variant_parent(leaf_name: leaf_name, enum_name: enum_name) {
              emit_freemonoid_empty_rc_value()
            } else {
            let qualified = if is_optional_variant_name(name: leaf_name) && is_optional_like_parent_name(name: enum_name) {
              if is_some_like_variant_name(name: leaf_name) { "Some" } else { "None" }
            } else {
              rust_variant_path(parent: enum_name, rust_name: leaf_name)
            }
            if set_contains(shared_types, enum_name) {
              rust_shared_wrap_ctor(inner_expr: qualified)
            } else { qualified }
            }
          Absent =>
            match lookup_item_for_value_ref(
              resolved_name: value_ref_normalize_self_module(name: n, module_name: scope.module_name),
              registry: registry
            ) {
              Present { value: info } =>
                if is_duplicate_qualified_item_registry_marker(info: info) {
                  value_ref_item_info_refusal(info: info)
                } else {
                  let is_data = info.kind == v1.compiler.infer_items.DataItem
                  if is_data { concat(emit_value_ref_ident(name: n, registry: registry, emit_info: emit_info), "()") }
                  else { emit_value_ref_ident(name: n, registry: registry, emit_info: emit_info) }
                }
              Absent =>
                emit_value_ref_ident(name: n, registry: registry, emit_info: emit_info)
            }
        }
      }
    _ => emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  }
}

fn field_access_field_is_boxed(base: v1.std.core.Node, field: String, scope: v1.compiler.infer.InferScope, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> Bool {
  let base_struct = v1.compiler.infer.expand_type_for_field_access(n: resolved_type(n: base), env: scope.type_env, module_name: scope.module_name).resolved
  match v1.std.core.find_child_named(n: base_struct, name: field, source_indices: scope.type_env.source_indices) {
    Present { value: field_child } =>
      let field_ty = resolved_type(n: field_child)
      let field_ty_name = v1.std.core.authored_name_at(source_indices: scope.type_env.source_indices, node: field_ty)
      let grounds_to_host_scalar = rust_seed_host_numeric_alias(name: field_ty_name, decl_file: v1.compiler.coercion.type_reference_decl_file(n: field_ty)) != none
      if grounds_to_host_scalar { false }
      else {
        needs_box_wrapping(n: field_ty, recursive_types: emit_info.recursive_type_set, shared_types: shared_types, source_indices: scope.type_env.source_indices)
      }
    Absent => false
  }
}

fn emit_typed_field_access(base: v1.std.core.Node, field: String, summary: v1.std.core.FieldSummary?, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let base_str = emit_typed_expr_base(texpr: base, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  let base_is_anon_record = match base.inferred {
    Present { value: v1.std.core.Resolved { node: bt } } =>
      let is_product = v1.compiler.infer_types.is_product_type(n: bt)
      if is_product && bt.ident_span == none { true } else { false }
    _ => false
  }
  if base_is_anon_record {
    let bt = resolved_type(n: base)
    if bt.children |> count == 1 {
      emit_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
    } else {
      let matches = bt.children |> enumerate |> filter(pair => v1.std.core.authored_name_at(source_indices: scope.type_env.source_indices, node: pair.second) == field)
      match matches |> first {
        Present { value: m } =>
          let sharing = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Rust).sharing
          v1.compiler.emit_core_support.apply_type_template1(template: sharing.clone_value, arg0: concat(base_str, ".", v1.compiler.emit_core_support.to_string(value: m.first)))
        Absent => concat("compile_error!(\"anonymous record field not found: ", field, "\")")
      }
    }
  } else {
    let sharing = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Rust).sharing
    match summary {
      Present { value: field_summary } =>
        match field_summary.access_style {
          TupleFirst => v1.compiler.emit_core_support.apply_type_template1(template: sharing.clone_value, arg0: concat(base_str, ".0"))
          TupleSecond => v1.compiler.emit_core_support.apply_type_template1(template: sharing.clone_value, arg0: concat(base_str, ".1"))
          OptionalUnwrap => concat(v1.compiler.emit_core_support.apply_type_template1(template: sharing.clone_value, arg0: base_str), ".unwrap()")
          EnumAccessor => concat(base_str, ".", v1.compiler.emit.emit_ident(name: field, target: v1.compiler.artifact.Rust), "()")
          StoredField =>
            let base_is_owned = match base.expr_data {
              ExprVar { binding_kind: _ } =>
                let base_name = v1.std.core.expr_var_name_at(texpr: base, source_indices: scope.type_env.source_indices)
                set_contains(emit_info.owned_bindings, base_name)
              _ => false
            }
            let field_is_boxed = field_access_field_is_boxed(base: base, field: field, scope: scope, shared_types: shared_types, emit_info: emit_info)
            if field_is_boxed {
              v1.compiler.emit_core_support.apply_type_template1(template: sharing.deref_clone, arg0: concat(base_str, ".", v1.compiler.emit.emit_ident(name: field, target: v1.compiler.artifact.Rust)))
            } else if base_is_owned {
              concat(base_str, ".", v1.compiler.emit.emit_ident(name: field, target: v1.compiler.artifact.Rust))
            } else {
              v1.compiler.emit_core_support.apply_type_template1(template: sharing.clone_value, arg0: concat(base_str, ".", v1.compiler.emit.emit_ident(name: field, target: v1.compiler.artifact.Rust)))
            }
        }
      Absent => concat("compile_error!(\"field access missing reconcile summary for '", field, "'\")")
    }
  }
}

fn type_needs_rc(type_node: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  type_needs_rc_seen(type_node: type_node, seen: empty_map(), source_indices: source_indices)
}

fn type_needs_rc_seen(type_node: v1.std.core.Node, seen: std.types.Map<String, Bool>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let normed = v1.compiler.infer_types.normalize_access_type_node(n: type_node)
  let is_product = v1.compiler.infer_types.is_product_type(n: normed)
  let is_coproduct = v1.compiler.infer_types.is_coproduct_type(n: normed)
  if is_product {
    true
  } else if is_coproduct {
    normed.children |> any(child => child.children |> count > 0)
  } else {
    let canonical = v1.std.core.authored_name_at(source_indices: source_indices, node: normed)
    if normed.inferred != none {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      type_needs_rc_seen(type_node: resolved_type(n: normed), seen: next_seen, source_indices: source_indices)
    } else if canonical != "" && v1.compiler.infer_types.emit_map_has(m: seen, key: canonical) {
      false
    } else {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      let has_structure = normed.connective != v1.std.core.NoConnective
      if !has_structure && normed.children |> count == 0 {
        false
      } else {
        type_needs_rc_seen(type_node: normed, seen: next_seen, source_indices: source_indices)
      }
    }
  }
}

fn rust_runtime_bridge_passes_receiver_by_ref(function_name: String) -> Bool {
  map_contains_key(extdeps.languages.rust.emit.rt_ref_map_functions(), function_name)
}

fn rust_runtime_bridge_name(function_name: String) -> String {
  match map_get(extdeps.languages.rust.emit.rt_bridge_function_names(), function_name) {
    Present { value: runtime_name } => runtime_name
    Absent => function_name
  }
}

fn rust_empty_map_value_type_str(map_type: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  match map_type.children |> skip(1) |> first {
    Present { value: value_child } =>
      let rendered = render_rust_type(n: v1.compiler.infer_types.child_type_node(ch: value_child), shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info())
      if rendered == "" { "" } else { rendered }
    Absent => ""
  }
}

fn rust_empty_map_kv_type_str(map_type: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>) -> String {
  let key_str = match map_type.children |> first {
    Present { value: key_child } =>
      render_rust_type(n: v1.compiler.infer_types.child_type_node(ch: key_child), shared_types: shared_types, source_indices: source_indices, emit_info: v1.compiler.infer_emit_info.empty_emit_graph_info())
    Absent => ""
  }
  let val_str = rust_empty_map_value_type_str(map_type: map_type, shared_types: shared_types, source_indices: source_indices)
  if key_str != "" && val_str != "" {
    concat(key_str, ", ", val_str)
  } else { "" }
}

fn type_node_child_is_type_variable(c: v1.std.core.Node) -> Bool {
  let ch = v1.compiler.infer_types.child_type_node(ch: c)
  if ch.inferred != none { is_type_variable(inferred: ch.inferred.value) } else { false }
}

fn rust_btree_set_element_ord_eligible(elem_node: v1.std.core.Node, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> Bool {
  let elem_name = v1.std.core.authored_name_at(source_indices: source_indices, node: elem_node)
  let name_grain_eligible = elem_name == "String" || elem_name == "Int" || elem_name == "Bool" || elem_name == "Unit"
    || elem_name == "Secret" || elem_name == "Bytes" || rust_opaque_kernel_alias_type_eligible(name: elem_name)
  (name_grain_eligible && elem_node.children |> count == 0)
    || rust_nominal_ord_type_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info)
}

data rust_btree_set_ord_name_grain_note: String = "The name-grain arms admit ONLY CHILDLESS nodes: a scalar/opaque-alias name denotes a childless carrier, and a name roster never examines type arguments, so without this gate any shape wearing an eligible name would be Ord-eligible by name alone (Symbol carrying Float must refuse; the enrolled negative control rust_btree_set_ord_eligibility_requires_nominal_carrier_shape is the discriminating RED). Shape-bearing nominal carriers are judged by rust_nominal_ord_type_eligible, which does examine structure."

fn rust_empty_set_element_type_str(set_type: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match set_type.children |> first {
    Present { value: elem_child } =>
      let elem_node = v1.compiler.infer_types.child_type_node(ch: elem_child)
      let elem_is_type_var = if elem_node.inferred != none { is_type_variable(inferred: elem_node.inferred.value) } else { false }
      let elem_is_error = if elem_node.inferred != none { v1.std.core.is_compiler_error(inferred: elem_node.inferred.value) } else { false }
      if elem_is_type_var || elem_is_error { "" }
      else if !rust_btree_set_element_ord_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info) { "" }
      else {
        v1.compiler.emit.render_node_type(n: elem_node, target: v1.compiler.artifact.Rust, shared_types: shared_types, source_indices: source_indices)
      }
    Absent => ""
  }
}

fn emit_rust_empty_set_expr(set_type: v1.std.core.Node, shared_types: std.types.Set<String>, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match set_type.children |> first {
    Present { value: elem_child } =>
      let elem_node = v1.compiler.infer_types.child_type_node(ch: elem_child)
      let elem_is_type_var = if elem_node.inferred != none { is_type_variable(inferred: elem_node.inferred.value) } else { false }
      if elem_is_type_var {
        "v1_rt::rc_empty_set::<_>()"
      } else if !rust_btree_set_element_ord_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info) {
        let elem_name = v1.std.core.authored_name_at(source_indices: source_indices, node: elem_node)
        emit_rust_compile_error_expr(message: concat("empty_set element type ", elem_name, " is not Ord-eligible for BTreeSet"))
      } else {
        let elem_str = rust_empty_set_element_type_str(set_type: set_type, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
        if elem_str != "" {
          concat("v1_rt::rc_empty_set::<", elem_str, ">()")
        } else {
          "v1_rt::rc_empty_set::<_>()"
        }
      }
    Absent =>
      "v1_rt::rc_empty_set::<_>()"
  }
}

fn rust_runtime_bridge_wraps_collection_result_in_rc(function_name: String) -> Bool {

  map_contains_key(extdeps.languages.rust.emit.rt_wraps_result(), function_name)
    || map_contains_key(extdeps.languages.rust.emit.rust_method_wraps_result(), function_name)
}

fn rust_runtime_bridge_collection_result_needs_rc_elements(function_name: String, result_type: v1.std.core.InferredNode?) -> Bool {

  false
}

fn rust_wrap_runtime_collection_result(call_str: String, function_name: String, result_type: v1.std.core.InferredNode?) -> String {
  if rust_runtime_bridge_wraps_collection_result_in_rc(function_name: function_name) {
    if rust_runtime_bridge_collection_result_needs_rc_elements(function_name: function_name, result_type: result_type) {
      concat("Rc::new((", call_str, ").into_iter().map(Rc::new).collect::<Vec<_>>())")
    } else {
      rust_shared_wrap_ctor(inner_expr: call_str)
    }
  } else {
    call_str
  }
}

fn emit_rust_expr_var(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo, source_indices: std.types.Map<String, v1.std.core.NewlineIndex>, module_name: String) -> String {
  match expr.expr_data {
    ExprVar { binding_kind: binding_kind } =>
      let n = v1.std.core.expr_var_name_at(texpr: expr, source_indices: source_indices)
      emit_var_ref(name: n, binding_kind: binding_kind, resolved_type: expr.inferred, shared_types: shared_types, registry: registry, emit_info: emit_info, source_indices: source_indices, module_name: module_name)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_var expected ExprVar", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_field_access(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  match expr.expr_data {
    ExprFieldAccess { summary: summary } =>
      let f = v1.std.core.field_access_field_at(texpr: expr, source_indices: si)
      let b = v1.std.core.field_access_base(texpr: expr)
      if v1.compiler.infer_service.is_typed_service_call_receiver(receiver: expr, source_indices: scope.type_env.source_indices) {
        match v1.compiler.infer_service.extract_typed_service_name(receiver: expr, source_indices: scope.type_env.source_indices) {
          Present { value: svc_name } => v1.compiler.emit_core_support.service_var_name(service_name: svc_name)
          Absent => emit_typed_field_access(base: b, field: f, summary: summary, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
        }
      } else {
        emit_typed_field_access(base: b, field: f, summary: summary, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      }
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_field_access expected ExprFieldAccess", target: v1.compiler.artifact.Rust)
  }
}

fn call_semantics_is_function_value(cs: v1.std.core.CallSemantics?) -> Bool {
  match cs {
    Present { value: v1.std.core.FunctionValueCallSemantics } => true
    _ => false
  }
}

fn emit_rust_expr_call(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprCall { call_semantics: cs, descent_evidence: _ } =>
      let f = v1.std.core.expr_call_func_at(texpr: expr, source_indices: scope.type_env.source_indices)
      emit_typed_call_expr(func: f, args: expr.children, inferred: expr.inferred, callee_is_function_value: call_semantics_is_function_value(cs: cs), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_call expected ExprCall", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_method_call(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprMethodCall { method_semantics: method_semantics } =>
      let r = v1.std.core.method_receiver(texpr: expr)
      let a = v1.std.core.method_arg_nodes(texpr: expr)
      let m = v1.std.core.expr_method_name_at(texpr: expr, source_indices: scope.type_env.source_indices)
      emit_typed_method_call(method_call_node: expr, receiver: r, method: m, args: a, result_type: expr.inferred, method_semantics: method_semantics, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_method_call expected ExprMethodCall", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_match(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprMatch =>
      let s = v1.std.core.match_scrutinee(texpr: expr)
      let arm_list = v1.std.core.match_arm_nodes(texpr: expr)
      emit_typed_match(scrutinee: s, arms: arm_list, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_match expected ExprMatch", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_if(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprIf =>
      let c = v1.std.core.if_condition(texpr: expr)
      let t = v1.std.core.if_then_branch(texpr: expr)
      let e = v1.std.core.if_else_branch(texpr: expr)
      emit_typed_if(condition: c, then_branch: t, else_branch: e, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_if expected ExprIf", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_let(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprLet =>
      let n = v1.std.core.let_binding_name_at(texpr: expr, source_indices: scope.type_env.source_indices)
      let v = v1.std.core.let_value(texpr: expr)
      let bd = v1.std.core.let_body(texpr: expr)
      emit_typed_let(name: n, value: v, body: bd, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_let expected ExprLet", target: v1.compiler.artifact.Rust)
  }
}

data concrete_peel_optional_ctor_note: String = "The concrete-type peel below replaces the AUTHORED record-literal name with the resolved concrete type name, which is right for an ordinary record literal whose type resolved to a nominal carrier. It was WRONG for the built-in optional constructors: a cast reaching the payload (Present { value: text as Carrier }) gives the literal a concrete resolved type, so the peel fired and overwrote the authored `Present` with the payload's concrete name, and emit_typed_record_lit then never recognised the literal as an optional constructor. The lowering fell through to the generic arm and fabricated `Optional::String { value: .. }` — not a Rust constructor, so the emitted crate failed with E0433. This was the actual name-loss point (gunbc#7480); it is in the CALLER, not in emit_typed_record_lit's variant_surface_name fallback, which was the standing hypothesis until the peel was read. The gate is deliberately narrow: the peel is suppressed ONLY when the authored name is a built-in optional constructor AND the concrete type does not itself declare a variant of that name. A user-defined enum that declares its own `Present` still peels exactly as before, because variant_belongs_to_enum finds it there — so the special case keys on the resolved parent genuinely being the built-in Optional rather than on the spelling alone. Ordinary variants are untouched: is_optional_variant_name is false for them, so the guard collapses and the peel proceeds unchanged. The variant identity is preserved rather than inferred from the payload type. Evidence: dag/test/claim/emitter_optional_payload_cast_witness_test.dag, whose cast poles flip from known-red to green with this repair, alongside the ordinary-enum Wrap::Holds control that must stay green. A SECOND, independently required narrowing landed beside the peel guard (review on gunbc#7480, 2026-08-01): the optional classification in emit_typed_record_lit briefly carried a function-wide `fn_returns_optional` disjunct, read off emit_info.fn_return_type. That is a fact about the ENCLOSING FUNCTION, not about this record literal's position, so it misclassified any optional-looking user constructor appearing anywhere inside an optional-returning function -- MyOpt::Present built inside `fn f(..) -> String?` emitted `Some(..)`, overriding an effective_parent that had ALREADY correctly resolved to the user enum. It also falsified this note's own claim to key on the resolved parent rather than the spelling. The disjunct was deleted rather than gated: `resolved_type.return_cardinality == CardOptional` is the expression-local statement of the same fact, and executing all seven poles with the function-wide arm removed showed it was load-bearing for NONE of them -- it was a second representation of an expression-local fact (DESIGN section 3), not a needed fallback. Its negative control is user_defined_present_inside_optional_returning_fn_is_unaffected, which requires MyOpt::Present and forbids `Some(`, and which was confirmed RED against the emitter before the removal. This does NOT address nested-refinement lowering, which remains separately tracked by emitter_nested_refinement_cast_witness_test.dag."

fn emit_rust_expr_record_lit(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprRecordLit { parent_enum: parent_enum } =>
      let tn = v1.std.core.record_lit_type_name_at(texpr: expr, source_indices: scope.type_env.source_indices)
      let fs = expr.children

      let si = scope.type_env.source_indices
      let resolved_rt = resolved_type(n: expr)
      let expanded_rt = v1.compiler.infer.expand_type_for_field_access(n: resolved_rt, env: scope.type_env, module_name: scope.module_name).resolved
      let variant_name = match tn { Present { value: n } => n  Absent => "" }

      let concrete_peel_would_erase_optional_ctor = is_optional_variant_name(name: variant_name)
        && !v1.compiler.infer_emit_info.variant_belongs_to_enum(
          type_summaries: emit_info.type_summaries,
          variant_name: variant_name,
          enum_name: v1.std.core.authored_name_at(source_indices: si, node: expanded_rt)
        )
      let peeled_type_name = if parent_enum == none && expanded_rt.connective == v1.std.core.Conj && expanded_rt.ident_span != none && !concrete_peel_would_erase_optional_ctor {
        let concrete = v1.std.core.authored_name_at(source_indices: si, node: expanded_rt)
        if concrete != "" && concrete != variant_name { Present { value: concrete } } else { tn }
      } else { tn }
      let raw = emit_typed_record_lit(type_name: peeled_type_name, fields: fs, parent_enum: parent_enum, resolved_type: expanded_rt, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      let rc_name = match parent_enum {
        Present { value: en } => en
        Absent =>
          match contextual_variant_parent(variant_name: variant_name, parent_enum: parent_enum, resolved_type: expanded_rt, emit_info: emit_info, source_indices: si) {
            Present { value: p } => p
            Absent =>

              let expanded_name = v1.std.core.authored_name_at(source_indices: si, node: expanded_rt)
              if expanded_rt.ident_span != none && expanded_name != "" && expanded_name != variant_name && set_contains(shared_types, expanded_name) {
                expanded_name
              } else { variant_name }
          }
      }
      if rc_name != "" && set_contains(shared_types, rc_name) {
        rust_shared_wrap_ctor(inner_expr: raw)
      } else { raw }
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_record_lit expected ExprRecordLit", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_string_interp(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprStringInterp =>
      let ps = expr.children |> map(child => match child.expr_data {
        ExprLiteral { value: LitStr { value: text } } => v1.std.core.Text { value: text }
        _ => v1.std.core.Interpolation { expr: v1.std.core.arg_value(n: child) }
      })
      emit_typed_string_interp(parts: ps, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_string_interp expected ExprStringInterp", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_block(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprBlock =>
      emit_typed_block(stmts: expr.children, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_block expected ExprBlock", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_cast(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprCast =>
      v1.compiler.emit.emit_typed_cast_shared(
        expr: v1.std.core.cast_expr(texpr: expr),
        cast_target_node: v1.std.core.cast_target(texpr: expr),
        target: v1.compiler.artifact.Rust,
        recurse: child => emit_typed_expr(texpr: child, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024),
        source_indices: scope.type_env.source_indices)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_cast expected ExprCast", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_for_each(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprForEach =>
      let v = v1.std.core.foreach_variable_at(texpr: expr, source_indices: scope.type_env.source_indices)
      let c = v1.std.core.foreach_collection(texpr: expr)
      let bd = v1.std.core.foreach_body(texpr: expr)
      emit_typed_for_each(variable: v, collection: c, body: bd, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => v1.compiler.emit.emit_error_expr(message: "emit_rust_expr_for_each expected ExprForEach", target: v1.compiler.artifact.Rust)
  }
}

fn emit_rust_expr_index(expr: v1.std.core.Node, registry: std.types.Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, shared_types: std.types.Set<String>, emit_info: v1.compiler.infer_emit_info.EmitGraphInfo) -> String {
