fn render_rust_applied_via_emit_info(n: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  render_rust_applied_type_shared(n: n, generic_param_names: emit_info.fn_generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: emit_info.variant_to_enum, env: emit_info.fn_type_env)
}

fn render_rust_type(n: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices, corpus_repr: corpus_repr) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: emit_info.fn_generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: emit_info.variant_to_enum, env: emit_info.fn_type_env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  match n.inferred {
    Present { value: TypeVariable { id: tv } } =>
      if type_var_in_fn_generic_scope(id: tv, generic_param_names: emit_info.fn_generic_param_names) { to_pascal(name: tv) } else { "_" }
    _ =>
      match find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
        Present { value: applied } =>
          if applied.children |> count > 0 {
            render_rust_applied_via_emit_info(n: applied, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: emit_info)
          } else {
            render_rust_type_without_applied_binding(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: emit_info)
          }
        Absent => render_rust_type_without_applied_binding(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: emit_info)
      }
  }
}

fn render_rust_type_without_applied_binding(n: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices, corpus_repr: corpus_repr) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: emit_info.fn_generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: emit_info.variant_to_enum, env: emit_info.fn_type_env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  if n.connective == NoConnective && n.children |> count > 0 && !is_container_type(name: authored_name_at(source_indices: source_indices, node: n)) {
    render_rust_applied_via_emit_info(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: emit_info)
  } else if node_is_set_collection(n: n, source_indices: source_indices) {
    match n.children |> first {
      Present { value: elem_child } =>
        let elem_node = child_type_node(ch: elem_child)
        let elem_is_type_var = if elem_node.inferred != none { is_type_variable(inferred: elem_node.inferred.value) } else { false }
        if elem_is_type_var {
          emit_rust_compile_error_expr(message: "Set element type unresolved")
        } else if !rust_btree_set_element_ord_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info) {
          let elem_name = authored_name_at(source_indices: source_indices, node: elem_node)
          emit_rust_compile_error_expr(message: concat("Set element type ", elem_name, " is not Ord-eligible for BTreeSet"))
        } else {
          render_node_type(n: n, target: Rust, shared_types: shared_types, source_indices: source_indices)
        }
      Absent => emit_rust_compile_error_expr(message: "Set missing element type")
    }
  } else if node_is_keyed_collection(n: n, source_indices: source_indices) {
    match n.children |> first {
      Present { value: key_child } =>
        let key_node = child_type_node(ch: key_child)
        let val_node = match n.children |> skip(1) |> first {
          Present { value: val_child } => child_type_node(ch: val_child)
          Absent => type_variable_node(id: "map_value")
        }
        let key_str = render_rust_type(n: key_node, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: emit_info)
        let val_str = render_rust_type(n: val_node, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: emit_info)
        let tn = authored_name_at(source_indices: source_indices, node: n)
        let base = emit_map_type(key_type: key_str, val_type: val_str, target: Rust)
        render_rust_shared_type_with_optional(n: n, type_name: tn, rendered: base, shared_types: shared_types)
      Absent => render_node_type(n: n, target: Rust, shared_types: shared_types, source_indices: source_indices)
    }
  } else if node_is_element_collection(n: n, source_indices: source_indices) {
    match n.children |> first {
      Present { value: elem_child } =>
        let elem_node = child_type_node(ch: elem_child)
        let inner_str = render_rust_type(n: elem_node, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: emit_info)
        let tn = authored_name_at(source_indices: source_indices, node: n)
        let base = emit_container(kind: to_snake(name: tn), inner: inner_str, target: Rust)
        render_rust_shared_type_with_optional(n: n, type_name: tn, rendered: base, shared_types: shared_types)
      Absent => render_node_type(n: n, target: Rust, shared_types: shared_types, source_indices: source_indices)
    }
  } else {
    let tn = authored_name_at(source_indices: source_indices, node: n)
    if type_node_has_unbound_type_variable(n: n, generic_param_names: emit_info.fn_generic_param_names, source_indices: source_indices) {
      "_"
    } else if is_host_text_carrier_type(n: n, source_indices: source_indices, corpus_repr: corpus_repr) {
      rust_carrier_optional_wrap(n: n, rendered: render_rust_text_carrier(shared_types: shared_types))
    } else {
      render_node_type(n: n, target: Rust, shared_types: shared_types, source_indices: source_indices)
    }
  }
}

fn empty_string_bool_map() -> Map<String, Bool> {
  empty_map()
}

fn rust_type_is_rc_wrapped(type_name: String) -> Bool {
  string_length(s: type_name) >= 3 && substring(s: type_name, start: 0, end: 3) == "Rc<"
}

fn corpus_repr_is_faithful(corpus_repr: RustCorpusRepr) -> Bool {
  match corpus_repr { FaithfulFreeMonoid => true  HostNative => false }
}
fn corpus_repr_is_host(corpus_repr: RustCorpusRepr) -> Bool {
  match corpus_repr { HostNative => true  FaithfulFreeMonoid => false }
}
fn is_host_freemonoid_vec_alias(name: String) -> Bool {
  name == "FreeMonoid"
}

fn is_host_optional_carrier_alias(name: String) -> Bool {
  name == "Optional"
}

fn is_host_diagnostics_carrier_alias(name: String) -> Bool {
  name == "Diagnostics"
}

fn is_grounded_coproduct_native_alias(name: String) -> Bool {
  is_host_freemonoid_vec_alias(name: name)
    || is_host_optional_carrier_alias(name: name)
    || is_host_diagnostics_carrier_alias(name: name)
}

fn is_host_optional_carrier_type(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  authored_name_at(source_indices: source_indices, node: n) == "Optional" && n.children |> count > 0
}

fn is_host_diagnostics_carrier_type(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  authored_name_at(source_indices: source_indices, node: n) == "Diagnostics"
}

fn render_rust_diagnostics_carrier_applied(shared_types: Set<String>) -> String {
  concat("Option<", render_rust_shared_type_if_needed(type_name: "NonEmptyDiagnostics", rendered: "NonEmptyDiagnostics", shared_types: shared_types), ">")
}

fn render_rust_optional_carrier_inner(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  match n.children |> first {
    Present { value: elem } =>
      render_rust_applied_type_arg(n: elem, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
    Absent => "()"
  }
}

fn render_rust_optional_carrier_applied(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  concat("Option<", render_rust_optional_carrier_inner(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env), ">")
}
fn render_rust_text_carrier(shared_types: Set<String>) -> String {
  render_rust_shared_type_if_needed(type_name: "String", rendered: "String", shared_types: shared_types)
}

fn rust_string_grounded_type_alias_decl_line() -> String {
  concat(rust_visibility_prefix(), rust_items().type_alias_keyword, " String = std::string::String;")
}

fn emit_rust_host_to_dag_string_via_seam(host_expr: String, corpus_repr: RustCorpusRepr) -> String {
  host_expr
}

fn emit_rust_map_literal_key(field_name: String, key_is_string: Bool, corpus_repr: RustCorpusRepr) -> String {
  let key_literal = concat("\"", field_name, "\"")
  let host_expr = if key_is_string {
    concat(key_literal, ".to_string()")
  } else {
    key_literal
  }
  emit_rust_host_to_dag_string_via_seam(host_expr: host_expr, corpus_repr: corpus_repr)
}

fn map_literal_key_is_string(map_type_node: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match map_type_node.children |> first {
    Present { value: key_child } => is_rust_string_like(n: key_child, source_indices: source_indices)
    Absent =>
      match find_property(props: map_type_node.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
        Present { value: applied } =>
          match applied.children |> first {
            Present { value: akey } => is_rust_string_like(n: akey, source_indices: source_indices)
            Absent => false
          }
        Absent => false
      }
  }
}

fn emit_rust_dag_string_to_host_via_seam(dag_expr: String, corpus_repr: RustCorpusRepr) -> String {
  dag_expr
}

fn rust_host_string_seam_fn_emit(name: String) -> String? {
  if name == "host_string_text_from_rust_host" {
    Present { value: concat(
      "pub fn host_string_text_from_rust_host(host: String) -> String {\n",
      "    host.chars().fold(v1_rt::freemonoid_empty::<i64>(), ",
      "|acc, ch| v1_rt::list_snoc_item(acc, v1_rt::code_point(ch.to_string())))\n",
      "}\n"
    ) }
  } else if name == "host_string_text_to_rust_host" {
    Present { value: concat(
      "pub fn host_string_text_to_rust_host(text: String) -> String {\n",
      "    v1_rt::fold_list(text, String::new(), |acc, cp| v1_rt::concat(acc, v1_rt::from_code_point(cp)))\n",
      "}\n"
    ) }
  } else {
    none
  }
}

fn rust_host_string_op_fn_emit(name: String) -> String? {
  if name == "string_is_empty" {
    Present { value: concat(
      "pub fn string_is_empty(s: String) -> bool {\n",
      "    s.is_empty()\n",
      "}\n"
    ) }
  } else if name == "string_head" {
    Present { value: concat(
      "pub fn string_head(s: String) -> Rc<CharResult> {\n",
      "    match s.chars().next() {\n",
      "        Some(c) => Rc::new(CharResult::CharFound { value: Box::new(c as i64) }),\n",
      "        None => Rc::new(CharResult::CharAbsent),\n",
      "    }\n",
      "}\n"
    ) }
  } else if name == "string_tail" {
    Present { value: concat(
      "pub fn string_tail(s: String) -> Rc<ListTailResult<Char>> {\n",
      "    let mut __it = s.chars();\n",
      "    match __it.next() {\n",
      "        Some(_) => Rc::new(ListTailResult::TailFound { tail: Rc::new(__it.map(|c| c as i64).collect::<Vec<i64>>()) }),\n",
      "        None => Rc::new(ListTailResult::TailAbsent),\n",
      "    }\n",
      "}\n"
    ) }
  } else if name == "fold_source" {
    Present { value: concat(
      "pub fn fold_source<R: Clone>(src: String, algebra: Rc<SourceFold<R>>) -> R {\n",
      "    let mut __acc = (algebra.init)(src.clone());\n",
      "    for _ in src.chars() {\n",
      "        __acc = if (algebra.is_done)(__acc.clone()) { __acc } else { (algebra.step)(__acc) };\n",
      "    }\n",
      "    __acc\n",
      "}\n"
    ) }
  } else {
    none
  }
}

fn rust_opaque_kernel_alias_type_eligible(name: String) -> Bool {
  name == "Json" || name == "Bytes" || name == "Symbol"
}

fn rust_opaque_kernel_alias_carrier(name: String) -> String? {
  if rust_opaque_kernel_alias_type_eligible(name: name) {
    Present { value: coerce_primitive_type(target: Rust, dag_name: name) }
  } else {
    none
  }
}

fn rust_opaque_kernel_alias_type_decl(name: String) -> String {
  let carrier = coerce_primitive_type(target: Rust, dag_name: name)
  concat(rust_visibility_prefix(), rust_items().type_alias_keyword, " ", name, " = ", carrier, ";")
}

fn rust_ground_opaque_kernel_type_name(name: String) -> String {
  match rust_opaque_kernel_alias_carrier(name: name) {
    Present { value: carrier } => carrier
    Absent => name
  }
}

fn rust_seed_host_numeric_alias(name: String, corpus_repr: RustCorpusRepr) -> String? {
  if (name == "Nat" || name == "Int") && corpus_repr_is_host(corpus_repr: corpus_repr) {
    Present { value: "i64" }
  } else {
    none
  }
}

fn rust_scalar_checkpoint_render_base(dag_name: String, corpus_repr: RustCorpusRepr) -> String? {
  match lookup_checkpoint(target: Rust, dag_name: dag_name) {
    Present { value: cp } => Present { value: cp.target_type }
    Absent =>
      match rust_seed_host_numeric_alias(name: dag_name, corpus_repr: corpus_repr) {
        Present { value: host } => Present { value: host }
        Absent => none
      }
  }
}

data rust_checkpoint_scalar_phantom_params_note: String = "Construction wall for E0109 (type arguments are not allowed on builtin type i64). A checkpoint scalar (lookup_checkpoint / rust_seed_host_numeric_alias — Int, Nat, i64, etc.) has arity 0 in Rust; DAG phantom params from GroupCompletion<Nat> or Compose<Int, MachineWidth<>> must not surface as i64<T>. Root fix: refuse phantom arg emission at the type-node renderer when the leaf is a checkpoint scalar and children > 0 — not a post-hoc string strip on the rendered output (DESIGN section 5: widening instead of refusing)."

fn rust_render_checkpoint_scalar_bare(n: Node, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, shared_types: Set<String>) -> String? {
  if n.children |> count == 0 { none }
  else {
    let leaf = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
    match rust_scalar_checkpoint_render_base(dag_name: leaf, corpus_repr: corpus_repr) {
      Present { value: scalar } =>
        if set_contains(shared_types, leaf) && !rust_type_is_rc_wrapped(type_name: scalar) {
          Present { value: wrap_shared_type(target: Rust, inner: scalar) }
        } else {
          Present { value: scalar }
        }
      Absent => none
    }
  }
}

fn rust_seed_host_container_base(name: String, corpus_repr: RustCorpusRepr) -> String? {
  if name == "List" || name == "FreeMonoid" {
    Present { value: "Vec" }
  } else {
    none
  }
}

fn rust_host_text_carrier_elem_name(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  match n.children |> first {
    Present { value: ch } => authored_name_at(source_indices: source_indices, node: ch)
    Absent =>
      match find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
        Present { value: applied } =>
          match applied.children |> first {
            Present { value: ach } => authored_name_at(source_indices: source_indices, node: ach)
            Absent => ""
          }
        Absent => ""
      }
  }
}

fn is_host_text_carrier_type(n: Node, source_indices: Map<String, NewlineIndex>, corpus_repr: RustCorpusRepr) -> Bool {
  let nm = authored_name_at(source_indices: source_indices, node: n)
  if nm == "String" {
    true
  } else if nm == "FreeMonoid" || nm == "List" {
    rust_host_text_carrier_elem_name(n: n, source_indices: source_indices) == "Char"
  } else {
    false
  }
}

fn rust_seed_host_freemonoid_empty(carrier_name: String, corpus_repr: RustCorpusRepr) -> String? {
  match rust_seed_host_container_base(name: carrier_name, corpus_repr: corpus_repr) {
    Present { value: _ } => Present { value: "Rc::new(vec![])" }
    Absent => none
  }
}

fn rust_named_type_base(name: String, corpus_repr: RustCorpusRepr) -> String {
  if name == "Witness" || name == "witness" {
    "Witness"
  } else {
    coerce_primitive_type(target: Rust, dag_name: name)
  }
}

fn rust_applied_type_base(name: String, corpus_repr: RustCorpusRepr) -> String {
  rust_named_type_base(name: name, corpus_repr: corpus_repr)
}

fn rust_normalize_witness_type_text(rendered: String) -> String {
  replace(rendered, "witness<", "Witness<")
}

fn rust_witness_parent_leaf(parent: String) -> Bool {
  qualified_last_segment(name: parent) == "Witness"
}

data rust_witness_variant_arm_names_note: String = "Holds/Violates literals below are the two arms of std.witness.Witness<C> (dag/std/witness.dag) — not minted nicknames. Pattern position routes via variant_pattern_qualified_path like any other modeled enum; construction turbofish here keys type-arg resolution off the modeled arm names only."

fn rust_peel_one_rc_type_node(type_node: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  if qualified_last_segment(name: type_node.name) != "Rc" {
    type_node
  } else {
    match type_node.children |> first {
      Present { value: inner } => inner
      Absent =>
        match find_property(props: type_node.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
          Present { value: applied } =>
            match applied.children |> first {
              Present { value: inner } => inner
              Absent => type_node
            }
          Absent => type_node
        }
    }
  }
}

fn rust_peel_all_rc_type_node(type_node: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  if qualified_last_segment(name: type_node.name) == "Rc" {
    rust_peel_all_rc_type_node(type_node: rust_peel_one_rc_type_node(type_node: type_node, source_indices: source_indices), source_indices: source_indices)
  } else {
    type_node
  }
}

fn rust_witness_type_arg_admit_rendered(rendered: String, emit_info: EmitGraphInfo) -> String? {
  if rendered == "_" || rendered == "" { none }
  else if string_length(s: rendered) == 1 && rust_is_uppercase_letter(c: rendered) && !type_var_in_fn_generic_scope(id: rendered, generic_param_names: emit_info.fn_generic_param_names) { none }
  else if rust_fold_rendered_type_has_any_spurious_generic(type_str: rendered, generic_param_names: emit_info.fn_generic_param_names) { none }
  else { Present { value: rendered } }
}

fn rust_witness_applied_type_arg_node(type_node: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  match type_node.children |> first {
    Present { value: child } => Present { value: child }
    Absent =>
      match find_property(props: type_node.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
        Present { value: applied } =>
          match applied.children |> first {
            Present { value: child } => Present { value: child }
            Absent => none
          }
        Absent => none
      }
  }
}

fn rust_witness_carrier_from_type_node(type_node: Node, shared_types: Set<String>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  if type_node_has_unbound_type_variable(n: type_node, generic_param_names: emit_info.fn_generic_param_names, source_indices: source_indices) { return none }
  let peeled = rust_peel_all_rc_type_node(type_node: type_node, source_indices: source_indices)
  if qualified_last_segment(name: peeled.name) == "Witness" {
    match rust_witness_applied_type_arg_node(type_node: peeled, source_indices: source_indices) {
      Present { value: arg_node } =>
        rust_witness_type_arg_admit_rendered(
          rendered: render_rust_type(n: arg_node, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: source_indices, emit_info: emit_info),
          emit_info: emit_info
        )
      Absent => none
    }
  } else {
    rust_witness_type_arg_admit_rendered(
      rendered: render_rust_type(n: peeled, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: source_indices, emit_info: emit_info),
      emit_info: emit_info
    )
  }
}

fn rust_witness_type_arg_render(type_node: Node, shared_types: Set<String>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  rust_witness_carrier_from_type_node(type_node: type_node, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
}

fn rust_witness_type_arg_from_holds_value_field(fields: List<Node>, shared_types: Set<String>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  match fields |> filter(f => field_init_node_name_at(n: f, source_indices: source_indices) == "value") |> first {
    Present { value: f } =>
      let val_rt = resolved_type(n: field_init_node_value(n: f))
      match rust_witness_carrier_from_type_node(type_node: val_rt, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices) {
        Present { value: arg } => Present { value: arg }
        Absent => rust_witness_type_arg_from_fn_return(emit_info: emit_info, shared_types: shared_types, source_indices: source_indices)
      }
    Absent => none
  }
}

fn rust_witness_type_arg_from_fn_return(emit_info: EmitGraphInfo, shared_types: Set<String>, source_indices: Map<String, NewlineIndex>) -> String? {
  match emit_info.fn_return_type {
    Present { value: rt } => rust_witness_carrier_from_type_node(type_node: rt, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
    Absent => none
  }
}

fn rust_witness_type_arg_for_variant(variant_name: String, resolved_type: Node, fields: List<Node>, shared_types: Set<String>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  if variant_name == "Holds" {
    match rust_witness_type_arg_from_holds_value_field(fields: fields, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices) {
      Present { value: arg } => Present { value: arg }
      Absent => rust_witness_type_arg_from_fn_return(emit_info: emit_info, shared_types: shared_types, source_indices: source_indices)
    }
  } else if variant_name == "Violates" {
    match rust_witness_type_arg_from_fn_return(emit_info: emit_info, shared_types: shared_types, source_indices: source_indices) {
      Present { value: arg } => Present { value: arg }
      Absent => rust_witness_carrier_from_type_node(type_node: resolved_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
    }
  } else {
    rust_witness_carrier_from_type_node(type_node: resolved_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
  }
}

fn rust_witness_variant_ctor_path(variant_name: String, ctor_name: String, effective_parent: String?, resolved_type: Node, fields: List<Node>, shared_types: Set<String>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String {
  match effective_parent {
    Present { value: parent } =>
      if !rust_witness_parent_leaf(parent: parent) {
        concat(qualified_last_segment(name: parent), "::", variant_name)
      } else {
        match rust_witness_type_arg_for_variant(variant_name: variant_name, resolved_type: resolved_type, fields: fields, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices) {
          Present { value: arg } => concat("Witness::<", arg, ">::", variant_name)
          Absent => concat("compile_error!(\"witness carrier type arg unresolved for variant ", variant_name, "\")")
        }
      }
    Absent => ctor_name
  }
}

fn rust_normalize_partial_function_field_type_text(rendered: String) -> String {
  replace(
    replace(
      replace(rendered, "HashMap<K, V>", "PartialFunction<K, V>"),
      "Vec<K>", "FreeMonoid<K>"
    ),
    "Vec<V>", "FreeMonoid<V>"
  )
}

fn is_parametric_opaque_type_by_name(env: TypeEnv, type_name: String) -> Bool {
  match lookup_type_by_name(env: env, name: type_name) {
    Present { value: item } => is_parametric_opaque_type_decl_item(item: item, source_indices: env.source_indices)
    Absent => false
  }
}

fn is_parametric_opaque_type_base(type_name: String, def_mod_filename: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match type_item_by_name_in_module_filename(rhs_name: type_name, mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: item } => is_parametric_opaque_type_decl_item(item: item, source_indices: source_indices)
    Absent => false
  }
}

fn alias_base_is_zero_param_decl(type_name: String, def_mod_filename: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match type_item_by_name_in_module_filename(rhs_name: type_name, mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: item } => (item.params |> count) == 0
    Absent => false
  }
}

fn type_param_is_collection_element_in_values(param_name: String, value_params: List<Node>, source_indices: Map<String, NewlineIndex>) -> Bool {
  value_params |> any(vp =>
    let te = param_node_type_expr(n: vp)
    is_container_type(name: authored_name_at(source_indices: source_indices, node: te))
      && (te.children |> any(c => authored_name_at(source_indices: source_indices, node: c) == param_name))
  )
}

fn is_value_variant_type_arg(generic_param_names: List<String>, variant_to_enum: Map<String, String>, name: String) -> Bool {
  if generic_param_names |> any(g => g == name) {
    false
  } else {
    map_contains_key(variant_to_enum, name)
  }
}

fn type_leaf_name_for_collapse(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let a = authored_name_at(source_indices: source_indices, node: n)
  if a == "" { n.name } else { a }
}

fn is_machine_width_phantom_token(name: String) -> Bool {
  name == "Word8" || name == "Word16" || name == "Word32" || name == "Word64" || name == "Word128"
}

fn rust_type_arg_renders_as_unit(n: Node, generic_param_names: List<String>, variant_to_enum: Map<String, String>, source_indices: Map<String, NewlineIndex>) -> Bool {
  is_width_nat_type_literal(n: n) || is_machine_width_phantom_token(name: type_leaf_name_for_collapse(n: n, source_indices: source_indices)) || is_value_variant_type_arg(generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, name: type_leaf_name_for_collapse(n: n, source_indices: source_indices))
}

fn type_node_has_value_variant_arg(n: Node, generic_param_names: List<String>, variant_to_enum: Map<String, String>, source_indices: Map<String, NewlineIndex>) -> Bool {
  if is_value_variant_type_arg(generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, name: type_leaf_name_for_collapse(n: n, source_indices: source_indices)) {
    true
  } else if n.children |> any(c => type_node_has_value_variant_arg(n: c, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices)) {
    true
  } else {
    match find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
      Present { value: applied } => applied.children |> any(c => type_node_has_value_variant_arg(n: c, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices))
      Absent => false
    }
  }
}

fn render_rust_phantom_opaque_applied_type_arg(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, scope: InferScope, imports: List<Node>, registry: Map<String, ItemInfo>, module_name: String, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, module_index: ModuleIndex, variant_to_enum: Map<String, String>) -> String {
  if rust_type_arg_renders_as_unit(n: n, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
    "()"
  } else {
    render_rust_alias_rhs_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
  }
}

fn render_rust_phantom_opaque_applied_decl_arg(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  if rust_type_arg_renders_as_unit(n: n, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
    "()"
  } else {
    render_rust_decl_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
}

fn render_rust_applied_type_arg(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  if rust_type_arg_renders_as_unit(n: n, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
    "()"
  } else if type_node_has_unbound_type_variable(n: n, generic_param_names: generic_param_names, source_indices: source_indices) {
    "_"
  } else {
    match n.inferred {
      Present { value: TypeVariable { id: tv } } =>
        if type_var_in_fn_generic_scope(id: tv, generic_param_names: generic_param_names) { to_pascal(name: tv) } else { "_" }
      _ =>
        match rust_render_checkpoint_scalar_bare(n: n, corpus_repr: corpus_repr, source_indices: source_indices, shared_types: shared_types) {
          Present { value: scalar } => scalar
          Absent => render_rust_decl_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
        }
    }
  }
}

fn render_rust_applied_type(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices, corpus_repr: corpus_repr) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  let base_name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
  if n.children |> count == 0 {

    match rust_seed_host_container_base(name: base_name, corpus_repr: corpus_repr) {
      Present { value: host } => host
      Absent => rust_named_type_base(name: base_name, corpus_repr: corpus_repr)
    }
  } else {

    match rust_scalar_checkpoint_render_base(dag_name: base_name, corpus_repr: corpus_repr) {
      Present { value: scalar } => scalar
      Absent =>
    if rust_fn_sig_peel_closed_alias(env: env, n: n) {
      let bare = match rust_seed_host_container_base(name: base_name, corpus_repr: corpus_repr) {
        Present { value: host } => host
        Absent => rust_applied_type_base(name: base_name, corpus_repr: corpus_repr)
      }
      render_rust_shared_type_if_needed(type_name: base_name, rendered: bare, shared_types: shared_types)
    } else {
    let base = match rust_seed_host_container_base(name: base_name, corpus_repr: corpus_repr) {
      Present { value: host } => host
      Absent => rust_applied_type_base(name: base_name, corpus_repr: corpus_repr)
    }
    let peel = is_parametric_opaque_type_by_name(env: env, type_name: base_name)
    let args = n.children |> map(arg =>
      if peel {
        render_rust_phantom_opaque_applied_decl_arg(n: arg, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      } else {
        render_rust_applied_type_arg(n: arg, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      }
    ) |> join(separator: ", ")
    concat(base, "<", args, ">")
    }
    }
  }
}

fn render_rust_shared_type_if_needed(type_name: String, rendered: String, shared_types: Set<String>) -> String {
  if set_contains(shared_types, type_name) && !rust_type_is_rc_wrapped(type_name: rendered) {
    wrap_shared_type(target: Rust, inner: rendered)
  } else { rendered }
}

fn render_rust_shared_type_with_optional(n: Node, type_name: String, rendered: String, shared_types: Set<String>) -> String {
  rust_carrier_optional_wrap(n: n, rendered: render_rust_shared_type_if_needed(type_name: type_name, rendered: rendered, shared_types: shared_types))
}

fn render_rust_applied_type_shared(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  let rendered = render_rust_applied_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  let type_name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
  render_rust_shared_type_with_optional(n: n, type_name: type_name, rendered: rendered, shared_types: shared_types)
}

fn render_rust_decl_type(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices, corpus_repr: corpus_repr) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  let applied_prop = find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices)
  let applied_overlay = match applied_prop {
    Present { value: applied } =>
      if applied.children |> count > 0 { Present { value: applied } } else { none }
    Absent => none
  }
  match applied_overlay {
    Present { value: applied } =>
      let outer_name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
      if outer_name != "" && outer_name != "fn" && !is_container_type(name: outer_name) && n.connective == NoConnective && (n.children |> count) == 0 && rust_fn_sig_peel_closed_alias(env: env, n: n) && rust_fn_sig_preserves_authored_alias_leaf(name: outer_name, corpus_repr: corpus_repr) {
        render_rust_shared_type_with_optional(n: n, type_name: outer_name, rendered: outer_name, shared_types: shared_types)
      } else {
        render_rust_applied_type_shared(n: applied, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      }
    Absent =>
      let name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
      if n.connective == NoConnective && n.children |> count == 0 && (generic_param_names |> any(g => g == name)) {
        to_pascal(name: name)
      } else if n.connective == NoConnective && n.children |> count == 0 && applied_prop == none && is_host_text_carrier_type(n: n, source_indices: source_indices, corpus_repr: corpus_repr) {
        rust_carrier_optional_wrap(n: n, rendered: render_rust_text_carrier(shared_types: shared_types))
      } else if n.connective == NoConnective && n.children |> count == 0 && applied_prop == none && set_contains(shared_types, name) {
        let rendered = rust_render_type_leaf_name(name: name, variant_to_enum: variant_to_enum)
        render_rust_shared_type_with_optional(n: n, type_name: name, rendered: rendered, shared_types: shared_types)
      } else if n.connective == NoConnective && n.children |> count > 0 {
        match rust_render_checkpoint_scalar_bare(n: n, corpus_repr: corpus_repr, source_indices: source_indices, shared_types: shared_types) {
          Present { value: scalar } => render_rust_shared_type_with_optional(n: n, type_name: rust_fn_sig_leaf_name(source_indices: source_indices, n: n), rendered: scalar, shared_types: shared_types)
          Absent =>
        if !is_container_type(name: name) && rust_fn_sig_peel_closed_alias(env: env, n: n) {
          render_rust_shared_type_with_optional(n: n, type_name: name, rendered: name, shared_types: shared_types)
        } else {
        let base = rust_applied_type_base(name: name, corpus_repr: corpus_repr)
        let peel = is_parametric_opaque_type_by_name(env: env, type_name: name)
        let arg_list = n.children |> map(arg =>
          let typed_arg = render_rust_decl_type_container_arg(arg: arg, source_indices: source_indices, env: env)
          if peel {
            render_rust_phantom_opaque_applied_decl_arg(n: typed_arg, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
          } else if rust_type_arg_renders_as_unit(n: typed_arg, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
            "()"
          } else {
            match rust_render_checkpoint_scalar_bare(n: typed_arg, corpus_repr: corpus_repr, source_indices: source_indices, shared_types: shared_types) {
              Present { value: scalar } => scalar
              Absent => render_rust_decl_type(n: typed_arg, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
            }
          }
        )
        let applied_ty = if name == tuple_type_name {
          render_tuple_parts(parts: arg_list, target: Rust)
        } else if node_is_keyed_collection(n: n, source_indices: source_indices) {
          match arg_list |> first {
            Present { value: k } => match arg_list |> skip(1) |> first {
              Present { value: v } => emit_map_type(key_type: k, val_type: v, target: Rust)
              Absent => concat(base, "<", arg_list |> join(separator: ", "), ">")
            }
            Absent => concat(base, "<", arg_list |> join(separator: ", "), ">")
          }
        } else if node_is_collection(n: n, source_indices: source_indices) && (arg_list |> count == 1) {
          match arg_list |> first {
            Present { value: inner } => emit_container(kind: to_snake(name: name), inner: inner, target: Rust)
            Absent => concat(base, "<", arg_list |> join(separator: ", "), ">")
          }
        } else {
          concat(base, "<", arg_list |> join(separator: ", "), ">")
        }
        render_rust_shared_type_with_optional(n: n, type_name: name, rendered: applied_ty, shared_types: shared_types)
        }
        }
      } else if type_node_has_unbound_type_variable(n: n, generic_param_names: generic_param_names, source_indices: source_indices) {
        "_"
      } else {
        render_rust_type_with_applied_binding(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices)
      }
  }
}

fn rust_fn_sig_peel_closed_alias(env: TypeEnv, n: Node) -> Bool {
  let name = authored_name_at(source_indices: env.source_indices, node: n)
  if name == "String" {
    return false
  }
  let binding = match lookup_type_for(env: env, node: n) {
    Present { value: b } => b
    Absent =>
      let name = authored_name_at(source_indices: env.source_indices, node: n)
      match lookup_type_by_name(env: env, name: name) {
        Present { value: b } => b
        Absent => return false
      }
  }
  (binding.params |> count) == 0
}

fn rust_fn_sig_preserves_authored_alias_leaf(name: String, corpus_repr: RustCorpusRepr) -> Bool {
  if is_kernel_type(name: name) {
    false
  } else if rust_opaque_kernel_alias_type_eligible(name: name) {
    false
  } else if name == "Nat" {
    true
  } else {
    rust_seed_host_numeric_alias(name: name, corpus_repr: corpus_repr) == none
  }
}

fn rust_carrier_optional_wrap(n: Node, rendered: String) -> String {
  let is_optional = n.return_cardinality == CardOptional
  if is_optional {
    concat("Option<", rendered, ">")
  } else {
    rendered
  }
}

fn render_rust_fn_sig_type(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices, corpus_repr: corpus_repr) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  if is_host_optional_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_optional_carrier_applied(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  if is_host_diagnostics_carrier_type(n: n, source_indices: source_indices) {
    return render_rust_diagnostics_carrier_applied(shared_types: shared_types)
  }
  if type_node_has_value_variant_arg(n: n, generic_param_names: generic_param_names, variant_to_enum: variant_to_enum, source_indices: source_indices) {
    return render_rust_decl_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  let name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
  if n.connective == NoConnective && n.children |> count == 0 && is_host_text_carrier_type(n: n, source_indices: source_indices, corpus_repr: corpus_repr) {
    rust_carrier_optional_wrap(n: n, rendered: render_rust_text_carrier(shared_types: shared_types))
  } else if n.connective == NoConnective && n.children |> count == 0 && name != "" && name != "String" && !is_container_type(name: name) && rust_fn_sig_peel_closed_alias(env: env, n: n) && rust_fn_sig_preserves_authored_alias_leaf(name: name, corpus_repr: corpus_repr) {
    render_rust_shared_type_with_optional(n: n, type_name: name, rendered: name, shared_types: shared_types)
  } else if n.connective == NoConnective && n.children |> count > 0 && !is_container_type(name: name) && rust_fn_sig_peel_closed_alias(env: env, n: n) {
    render_rust_shared_type_with_optional(n: n, type_name: name, rendered: name, shared_types: shared_types)
  } else if generic_param_names |> count > 0 {
    render_rust_decl_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  } else {
    render_rust_fn_sig_type_applied_binding(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, env: env)
  }
}

fn render_rust_fn_sig_type_applied_binding(n: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, env: TypeEnv) -> String {
  match find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
    Present { value: applied } =>
      if applied.children |> count > 0 {
        let outer_name = rust_fn_sig_leaf_name(source_indices: source_indices, n: n)
        if outer_name != "" && outer_name != "fn" && !is_container_type(name: outer_name) && n.connective == NoConnective && (n.children |> count) == 0 && rust_fn_sig_peel_closed_alias(env: env, n: n) && rust_fn_sig_preserves_authored_alias_leaf(name: outer_name, corpus_repr: corpus_repr) {
          render_rust_shared_type_with_optional(n: n, type_name: outer_name, rendered: outer_name, shared_types: shared_types)
        } else {
          render_rust_type_with_applied_binding(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices)
        }
      } else {
        render_rust_type_with_applied_binding(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices)
      }
    Absent => render_rust_type_with_applied_binding(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices)
  }
}

fn rust_decl_type_container_arg_needs_resolved_overlay(arg: Node, source_indices: Map<String, NewlineIndex>, env: TypeEnv) -> Bool {
  let authored_is_leaf = arg.connective == NoConnective && (arg.children |> count) == 0
  let closed_alias = if authored_is_leaf {
    rust_fn_sig_peel_closed_alias(env: env, n: arg)
  } else {
    false
  }
  let applied_arg_count = match find_property(props: arg.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
    Present { value: applied } => Present { value: applied.children |> count }
    Absent => none
  }
  let resolved_child_count = match arg.inferred {
    Present { value: Resolved { node: rt } } => rt.children |> count
    _ => 0
  }
  rust_decl_type_container_overlay_is_admitted(
    authored_is_leaf: authored_is_leaf,
    closed_alias: closed_alias,
    applied_arg_count: applied_arg_count,
    resolved_child_count: resolved_child_count,
  )
}

fn render_rust_decl_type_container_arg(arg: Node, source_indices: Map<String, NewlineIndex>, env: TypeEnv) -> Node {
  if rust_decl_type_container_arg_needs_resolved_overlay(arg: arg, source_indices: source_indices, env: env) {
    child_type_node(ch: arg)
  } else {
    arg
  }
}

fn alias_rhs_container_arg(arg: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  match arg.inferred {
    Present { value: Resolved { node: rt } } =>
      if node_is_collection(n: rt, source_indices: source_indices) { rt } else { arg }
    _ => arg
  }
}

data rust_fn_sig_leaf_name_dotted_note: String = "Construction wall for the dotted-render class in FN-SIG TYPE position (sibling of coerce_primitive_type_dotted_fallback_note for primitives and emit_typed_record_lit's bare_qualified_name for record-lit construction). render_rust_fn_sig_type / render_rust_fn_sig_type_applied_binding / render_rust_decl_type all extract a leaf type's name via authored_name_at and then both (a) key lookups against is_container_type/shared_types/rust_fn_sig_peel_closed_alias and (b) pass that same string as literal Rust output via render_rust_shared_type_with_optional's `rendered` argument. A namespace-qualified closure-param or aliased-decl type (e.g. impl Fn(v2.lens.complexity_accumulator_copy.Finding) -> bool) previously reached (b) verbatim -- dots and all, an invalid Rust token sequence rustc reports as 'expected one of !, (, +, ::, or <, found .'. Since every lookup in (a) is keyed on the bare declared name (same reasoning as alias_rhs_qualified_name_routing_note below), the fix is to route the leaf-name extraction through rust_fn_sig_leaf_name (which wraps authored_name_at with qualified_last_segment, the single authority) so both the lookup key and the emitted text are bare together -- not a second dotted-name fallback forked per call site. Every already-bare name renders exactly as before."

fn rust_fn_sig_leaf_name(source_indices: Map<String, NewlineIndex>, n: Node) -> String {
  qualified_last_segment(name: authored_name_at(source_indices: source_indices, node: n))
}

data alias_rhs_qualified_name_routing_note: String = "Construction wall for the dotted-render class. A namespace-QUALIFIED name in a type position (post-PR 6848 resolution) arrives from authored_name_at as the full dotted spelling, e.g. std.algebra.FreeMonoid. Every routing lookup on this path — alias_rhs_rust_qualify_module_filename via lookup_item, rust_seed_host_container_base, alias_base_is_zero_param_decl, is_parametric_opaque_type_base, shared_types — is keyed on the BARE declared name, so a dotted spelling matched nothing, def_mod fell back to the local module, and the else arm rendered the dotted string VERBATIM into Rust. That is not valid Rust: rustc reports 'expected one of !, (, +, ::, ;, <, or where, found .', a PARSE error, which then masks every later error in the module.

Measured blast radius before the fix: the emitted 04_infer closure (50 files) contained exactly ONE such line — 'pub type List<T> = std.algebra.FreeMonoid<T>' in v2_std_collection.rs — and that single line blocked 4 of 5 self-host flip candidates, because std.collection sits in essentially every deep-module closure. The control that proves the fault is qualified-specific is the very next declaration: 'type Set<T> = PointwisePower<T>' (BARE) already routed correctly to Rc<crate::v2_std_algebra::PointwisePower<T>>.

Fix: route on the TERMINAL segment via qualified_last_segment (v1.std.core, the existing authority — a qualified name IS a containment path, and its last segment is the declared name the registry knows). Not a string dot-to-colon rewrite: that would FABRICATE a path from the spelling instead of RESOLVING the declaration, and would silently produce a wrong path whenever the qualifier does not match the defining module. Because qualified_last_segment is the identity on an unqualified name, every bare name renders exactly as before — the seed stays byte-identical by construction, which is why this lands with regen_divergence_count=0 rather than merely hoping for it.

The v2 corpus authors qualified names in type position only rarely today, which is why one line carried this much weight; the point of fixing the renderer rather than editing that one declaration is that the next qualified name must not reintroduce it (DESIGN: do not cement the seed's accidents)."

fn render_rust_alias_rhs_type(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, scope: InferScope, imports: List<Node>, registry: Map<String, ItemInfo>, module_name: String, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, module_index: ModuleIndex, variant_to_enum: Map<String, String>) -> String {
  match n.type_annotation {
    Present { value: _ } =>
      if n.connective == Conj && (n.children |> count) == 1 {
        match n.children |> first {
          Present { value: base_te } =>
            if rust_seed_host_numeric_alias(name: authored_name_at(source_indices: source_indices, node: base_te), corpus_repr: corpus_repr) != none {
              return render_rust_alias_rhs_type(n: base_te, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
            } else {
              return render_rust_type(n: base_te, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info())
            }
          Absent => {}
        }
      }
    Absent => {}
  }
  let name = authored_name_at(source_indices: source_indices, node: n)
  if n.connective == NoConnective && n.children |> count == 0 && (generic_param_names |> any(g => g == name)) {
    to_pascal(name: name)
  } else if n.connective == NoConnective && n.children |> count == 0 {
    match rust_seed_host_numeric_alias(name: name, corpus_repr: corpus_repr) {
      Present { value: host } => host
      Absent =>
      match rust_opaque_kernel_alias_carrier(name: name) {
        Present { value: carrier } => carrier
        Absent => {
          let rendered = rust_render_type_leaf_name(name: name, variant_to_enum: variant_to_enum)
          render_rust_shared_type_if_needed(type_name: name, rendered: rendered, shared_types: shared_types)
        }
      }
    }
  } else if n.connective == NoConnective && n.children |> count > 0 {
    let leaf = qualified_last_segment(name: name)
    let numeric_host_alias = match rust_scalar_checkpoint_render_base(dag_name: leaf, corpus_repr: corpus_repr) {
      Present { value: scalar } => Present { value: scalar }
      Absent => rust_seed_host_numeric_alias(name: leaf, corpus_repr: corpus_repr)
    }
    if numeric_host_alias != none {
      return match numeric_host_alias { Present { value: host } => host  Absent => "" }
    }
    let local_mod = module_to_filename(name: module_name)
    let def_mod = alias_rhs_rust_qualify_module_filename(name: leaf, alias_module: module_name, imports: imports, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
    let base = match rust_seed_host_container_base(name: leaf, corpus_repr: corpus_repr) {
      Present { value: host } => host
      Absent => if def_mod != local_mod {
        concat("crate::", def_mod, "::", leaf)
      } else {
        leaf
      }
    }
    let base_is_zero_param = rust_seed_host_container_base(name: leaf, corpus_repr: corpus_repr) == none && alias_base_is_zero_param_decl(type_name: leaf, def_mod_filename: def_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
    if base_is_zero_param {
      return if set_contains(shared_types, leaf) && !rust_type_is_rc_wrapped(type_name: base) { wrap_shared_type(target: Rust, inner: base) } else { base }
    }
    let peel = is_parametric_opaque_type_base(type_name: leaf, def_mod_filename: def_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
    let args = n.children |> map(arg =>
      if peel {
        render_rust_phantom_opaque_applied_type_arg(n: arg, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
      } else {
        render_rust_alias_rhs_type(n: alias_rhs_container_arg(arg: arg, source_indices: source_indices), generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, scope: scope, imports: imports, registry: registry, module_name: module_name, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index, variant_to_enum: variant_to_enum)
      }
    ) |> join(separator: ", ")
    let applied_ty = concat(base, "<", args, ">")
    if set_contains(shared_types, leaf) && !rust_type_is_rc_wrapped(type_name: applied_ty) {
      wrap_shared_type(target: Rust, inner: applied_ty)
    } else {
      applied_ty
    }
  } else {
    render_rust_type(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info())
  }
}

fn type_variable_node(id: String) -> Node {
  Node { name: "", span: make_span(start: 0, end: 0), ident_span: none, children: [], connective: NoConnective, params: [], inferred: Present { value: TypeVariable { id: id } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
}

fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

fn type_var_in_fn_generic_scope(id: String, generic_param_names: List<String>) -> Bool {
  generic_param_names |> any(g => g == id)
}

fn value_ref_qualified_leaf(name: String) -> String {
  if string_contains(s: name, pattern: ".") { qualified_last_segment(name: name) } else { name }
}

fn rust_is_uppercase_letter(c: String) -> Bool {
  c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" || c == "G" || c == "H" || c == "I" || c == "J" || c == "K" || c == "L" || c == "M" || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R" || c == "S" || c == "T" || c == "U" || c == "V" || c == "W" || c == "X" || c == "Y" || c == "Z"
}

fn rust_read_rendered_type_ident(type_str: String, start: Int) -> String {
  if start >= string_length(s: type_str) { "" }
  else {
    let c = char_at(s: type_str, pos: start)
    if c == ">" || c == "," || c == "<" || c == " " || c == "&" || c == "(" || c == ")" { "" }
    else { concat(c, rust_read_rendered_type_ident(type_str: type_str, start: start + 1)) }
  }
}

fn rust_fold_rendered_type_has_spurious_generic_atom(atom: String, generic_param_names: List<String>) -> Bool {
  if atom == "" { false }
  else if type_var_in_fn_generic_scope(id: atom, generic_param_names: generic_param_names) { false }
  else { true }
}

fn rust_fold_rendered_type_has_spurious_from_pos(type_str: String, search_from: Int, generic_param_names: List<String>) -> Bool {
  if type_str == "_" || type_str == "" { false }
  else {
    match string_index_of_from(haystack: type_str, needle: "<", pos: search_from) {
      Present { value: lt_pos } =>
        let atom = rust_read_rendered_type_ident(type_str: type_str, start: lt_pos + 1)
        if atom |> count == 1 && rust_is_uppercase_letter(c: atom) && rust_fold_rendered_type_has_spurious_generic_atom(atom: atom, generic_param_names: generic_param_names) {
          true
        } else {
          rust_fold_rendered_type_has_spurious_from_pos(type_str: type_str, search_from: lt_pos + 1, generic_param_names: generic_param_names)
        }
      Absent => false
    }
  }
}

fn rust_fold_rendered_type_has_any_spurious_generic(type_str: String, generic_param_names: List<String>) -> Bool {
  rust_fold_rendered_type_has_spurious_from_pos(type_str: type_str, search_from: 0, generic_param_names: generic_param_names)
}

fn type_leaf_is_unbound_in_closure_scope(name: String, generic_param_names: List<String>, env: TypeEnv) -> Bool {
  if type_var_in_fn_generic_scope(id: name, generic_param_names: generic_param_names) {
    false
  } else {
    match lookup_type_by_name(env: env, name: name) {
      Present { value: resolved_node } =>
        if resolved_node.inferred != none && is_type_variable(inferred: resolved_node.inferred.value) { true } else { false }
      Absent => true
    }
  }
}

fn type_node_has_closure_unbound_generic_atom(n: Node, generic_param_names: List<String>, env: TypeEnv, source_indices: Map<String, NewlineIndex>) -> Bool {
  let leaf_name = authored_name_at(source_indices: source_indices, node: n)
  if n.children |> count == 0 && leaf_name != "" {
    if type_leaf_is_unbound_in_closure_scope(name: leaf_name, generic_param_names: generic_param_names, env: env) { return true }
  }
  if n.inferred != none {
    match n.inferred.value {
      TypeVariable { id: tv } =>
        if !type_var_in_fn_generic_scope(id: tv, generic_param_names: generic_param_names) { return true }
      Resolved { node: rt } =>
        if type_node_has_closure_unbound_generic_atom(n: rt, generic_param_names: generic_param_names, env: env, source_indices: source_indices) { return true }
      _ => ()
    }
  }
  if n.children |> any(c => type_node_has_closure_unbound_generic_atom(n: child_type_node(ch: c), generic_param_names: generic_param_names, env: env, source_indices: source_indices)) {
    true
  } else {
    match find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
      Present { value: applied } => applied.children |> any(c => type_node_has_closure_unbound_generic_atom(n: c, generic_param_names: generic_param_names, env: env, source_indices: source_indices))
      Absent => false
    }
  }
}

fn type_node_has_unbound_type_variable(n: Node, generic_param_names: List<String>, source_indices: Map<String, NewlineIndex>) -> Bool {
  if n.inferred != none {
    match n.inferred.value {
      TypeVariable { id: tv } =>
        if !type_var_in_fn_generic_scope(id: tv, generic_param_names: generic_param_names) { return true }
      Resolved { node: rt } =>
        if type_node_has_unbound_type_variable(n: rt, generic_param_names: generic_param_names, source_indices: source_indices) { return true }
      _ => ()
    }
  }
  if n.children |> any(c => type_node_has_unbound_type_variable(n: child_type_node(ch: c), generic_param_names: generic_param_names, source_indices: source_indices)) {
    true
  } else {
    match find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
      Present { value: applied } => applied.children |> any(c => type_node_has_unbound_type_variable(n: c, generic_param_names: generic_param_names, source_indices: source_indices))
      Absent => false
    }
  }
}

fn is_rust_value_type(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let normed = normalize_access_type_node(n: n)
  match is_copy(target: Rust, dag_name: authored_name_at(source_indices: source_indices, node: normed)) {
    Present { value: v } => v
    Absent => false
  }
}

fn is_rust_string_like(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let normed = normalize_access_type_node(n: n)
  is_string_like(target: Rust, name: authored_name_at(source_indices: source_indices, node: normed))
}

fn rust_source_root() -> String {
  match scaffold_for_target(target: Rust).source_dir {
    Present { value: dir } => dir
    Absent => ""
  }
}

fn rust_source_ext() -> String {
  scaffold_for_target(target: Rust).source_file_extension
}

fn rust_visibility_prefix() -> String {

  match visibility_for_target(target: Rust) {
    KeywordVisibility { prefix: p } => p
    _ => "__VISIBILITY_SPEC_MISMATCH__"
  }
}

fn rust_items() -> ItemKeywords {
  language_spec(target: Rust).items
}

fn rust_ord_derives_text() -> String {
  "#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, serde::Serialize, serde::Deserialize)]"
}

fn rust_ord_derives_copy_text() -> String {
  "#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, serde::Serialize, serde::Deserialize)]"
}

fn rust_nominal_identity_carrier_def(name: String) -> String {
  concat(rust_ord_derives_text(), "\n", rust_visibility_prefix(), rust_items().struct_keyword, " ", name, "(pub String);")
}

fn rust_nominal_identity_carrier_type_eligible(type_name: String) -> Bool {
  false
}

fn rust_nominal_ord_derives_for_shape(name: String, children: List<Node>, source_indices: Map<String, NewlineIndex>) -> String {
  if rust_symbol_wrapped_ord_carrier_shape_eligible(children: children, source_indices: source_indices) {
    rust_ord_derives_text()
  } else {
    ""
  }
}

fn rust_nominal_ord_type_decl_ord_eligible(decl: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  rust_nominal_identity_carrier_shape_eligible(n: decl, source_indices: source_indices)
    || rust_symbol_wrapped_ord_carrier_shape_eligible(children: decl.children, source_indices: source_indices)
}

fn rust_nominal_ord_type_ref_eligible(elem_node: Node, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> Bool {
  let type_name = authored_name_at(source_indices: source_indices, node: elem_node)
  (elem_node.children |> count) == 0
    && (elem_node.params |> count) == 0
    && elem_node.connective == NoConnective
    && match lookup_emit_type_decl(emit_info: emit_info, type_name: type_name) {
      Present { value: decl } => rust_nominal_ord_type_decl_ord_eligible(decl: decl, source_indices: source_indices)
      Absent => false
    }
}

fn rust_nominal_ord_type_eligible(elem_node: Node, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> Bool {
  rust_nominal_identity_carrier_shape_eligible(n: elem_node, source_indices: source_indices)
    || rust_nominal_ord_type_ref_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info)
    || rust_symbol_wrapped_ord_carrier_shape_eligible(children: elem_node.children, source_indices: source_indices)
}

fn rust_serde_tag_attr() -> String {
  match serialization_for_target(target: Rust).tag_attribute {
    Present { value: attr } => attr
    Absent => emit_error_expr(message: "missing serde tag_attribute for Rust", target: Rust)
  }
}

type RustEnumWireSerde {
  enum_attr: String
  rename_prefix: String?
  rename_suffix: String?
  rename_style: String?
  error_message: String?
}

fn rust_serde_policy(enum_attr: String, rename_prefix: String?, rename_suffix: String?, rename_style: String?) -> RustEnumWireSerde {
  RustEnumWireSerde {
    enum_attr: enum_attr,
    rename_prefix: rename_prefix,
    rename_suffix: rename_suffix,
    rename_style: rename_style,
    error_message: none
  }
}

fn rust_serde_policy_error(message: String) -> RustEnumWireSerde {
  RustEnumWireSerde {
    enum_attr: "",
    rename_prefix: none,
    rename_suffix: none,
    rename_style: none,
    error_message: Present { value: message }
  }
}

fn rust_tagged_object_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: rust_serde_tag_attr(), rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn rust_untagged_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: "#[serde(untagged)]", rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn rust_serde_error_policy(message: String) -> RustEnumWireSerde {
  rust_serde_policy_error(message: message)
}

fn rust_string_as_authored_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: "", rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn rust_snake_string_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: rust_serde_rename_all_snake_case, rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn rust_screaming_snake_string_policy() -> RustEnumWireSerde {
  rust_serde_policy(enum_attr: rust_serde_rename_all_screaming_snake_case, rename_prefix: none, rename_suffix: none, rename_style: none)
}

fn field_value_by_name(record: Node, field_name: String, source_indices: Map<String, NewlineIndex>) -> Node? {
  match record.children |> filter(fi => field_init_node_name_at(n: fi, source_indices: source_indices) == field_name) |> first {
    Present { value: fi } => Present { value: field_init_node_value(n: fi) }
    Absent => none
  }
}

fn literal_string_value(n: Node) -> String? {
  match n.expr_data {
    ExprLiteral { value: lv } => match lv {
      LitStr { value: s } => Present { value: s }
      _ => none
    }
    _ => none
  }
}

fn record_string_field(record: Node, field_name: String, source_indices: Map<String, NewlineIndex>) -> String? {
  match field_value_by_name(record: record, field_name: field_name, source_indices: source_indices) {
    Present { value: value_node } => literal_string_value(n: value_node)
    Absent => none
  }
}

fn naming_policy_node(encoding: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  field_value_by_name(record: encoding, field_name: "naming", source_indices: source_indices)
}

fn coproduct_decl_ref_decl_name(body: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  match field_value_by_name(record: body, field_name: "coproduct", source_indices: source_indices) {
    Present { value: decl_ref_node } => record_string_field(record: decl_ref_node, field_name: "decl_name", source_indices: source_indices)
    Absent => none
  }
}

fn optional_string_record_field(record: Node, field_name: String, source_indices: Map<String, NewlineIndex>) -> String? {
  match field_value_by_name(record: record, field_name: field_name, source_indices: source_indices) {
    Present { value: n } => literal_string_value(n: n)
    Absent => none
  }
}

fn required_literal_string_policy_field(record: Node, field_name: String, source_indices: Map<String, NewlineIndex>) -> String? {
  match field_value_by_name(record: record, field_name: field_name, source_indices: source_indices) {
    Present { value: n } => literal_string_value(n: n)
    Absent => none
  }
}

fn rust_string_policy_for_naming(naming: Node, source_indices: Map<String, NewlineIndex>) -> RustEnumWireSerde {
  let naming_name = authored_name_at(source_indices: source_indices, node: naming)
  if naming_name == "AsAuthored" {
    rust_string_as_authored_policy()
  } else if naming_name == "SnakeCase" {
    rust_snake_string_policy()
  } else if naming_name == "ScreamingSnakeCase" {
    rust_screaming_snake_string_policy()
  } else if naming_name == "StripPrefixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "prefix", source_indices: source_indices) {
      Present { value: prefix } =>
        rust_serde_policy(
          enum_attr: "",
          rename_prefix: Present { value: prefix },
          rename_suffix: none,
          rename_style: Present { value: "StripAffixAndSnakeCase" }
        )
      Absent => rust_serde_error_policy(message: "StripPrefixAndSnakeCase requires a literal prefix")
    }
  } else if naming_name == "StripSuffixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "suffix", source_indices: source_indices) {
      Present { value: suffix } =>
        rust_serde_policy(
          enum_attr: "",
          rename_prefix: none,
          rename_suffix: Present { value: suffix },
          rename_style: Present { value: "StripAffixAndSnakeCase" }
        )
      Absent => rust_serde_error_policy(message: "StripSuffixAndSnakeCase requires a literal suffix")
    }
  } else if naming_name == "StripPrefixSuffixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "prefix", source_indices: source_indices) {
      Present { value: prefix } =>
        match required_literal_string_policy_field(record: naming, field_name: "suffix", source_indices: source_indices) {
          Present { value: suffix } =>
            rust_serde_policy(
              enum_attr: "",
              rename_prefix: Present { value: prefix },
              rename_suffix: Present { value: suffix },
              rename_style: Present { value: "StripAffixAndSnakeCase" }
            )
          Absent => rust_serde_error_policy(message: "StripPrefixSuffixAndSnakeCase requires a literal suffix")
        }
      Absent => rust_serde_error_policy(message: "StripPrefixSuffixAndSnakeCase requires a literal prefix")
    }
  } else {
    rust_serde_error_policy(message: concat("unsupported VariantNaming: ", naming_name))
  }
}

fn rust_internal_policy_for_naming(tag_field: String, naming: Node, source_indices: Map<String, NewlineIndex>) -> RustEnumWireSerde {
  let naming_name = authored_name_at(source_indices: source_indices, node: naming)
  if naming_name == "AsAuthored" {
    rust_serde_policy(enum_attr: concat("#[serde(tag = \"", tag_field, "\")]"), rename_prefix: none, rename_suffix: none, rename_style: none)
  } else if naming_name == "SnakeCase" {
    rust_serde_policy(enum_attr: concat("#[serde(tag = \"", tag_field, "\", rename_all = \"snake_case\")]"), rename_prefix: none, rename_suffix: none, rename_style: none)
  } else if naming_name == "ScreamingSnakeCase" {
    rust_serde_policy(enum_attr: concat("#[serde(tag = \"", tag_field, "\", rename_all = \"SCREAMING_SNAKE_CASE\")]"), rename_prefix: none, rename_suffix: none, rename_style: none)
  } else if naming_name == "StripPrefixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "prefix", source_indices: source_indices) {
      Present { value: prefix } =>
        rust_serde_policy(
          enum_attr: concat("#[serde(tag = \"", tag_field, "\")]"),
          rename_prefix: Present { value: prefix },
          rename_suffix: none,
          rename_style: Present { value: "StripAffixAndSnakeCase" }
        )
      Absent => rust_serde_error_policy(message: "StripPrefixAndSnakeCase requires a literal prefix")
    }
  } else if naming_name == "StripSuffixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "suffix", source_indices: source_indices) {
      Present { value: suffix } =>
        rust_serde_policy(
          enum_attr: concat("#[serde(tag = \"", tag_field, "\")]"),
          rename_prefix: none,
          rename_suffix: Present { value: suffix },
          rename_style: Present { value: "StripAffixAndSnakeCase" }
        )
      Absent => rust_serde_error_policy(message: "StripSuffixAndSnakeCase requires a literal suffix")
    }
  } else if naming_name == "StripPrefixSuffixAndSnakeCase" {
    match required_literal_string_policy_field(record: naming, field_name: "prefix", source_indices: source_indices) {
      Present { value: prefix } =>
        match required_literal_string_policy_field(record: naming, field_name: "suffix", source_indices: source_indices) {
          Present { value: suffix } =>
            rust_serde_policy(
              enum_attr: concat("#[serde(tag = \"", tag_field, "\")]"),
              rename_prefix: Present { value: prefix },
              rename_suffix: Present { value: suffix },
              rename_style: Present { value: "StripAffixAndSnakeCase" }
            )
          Absent => rust_serde_error_policy(message: "StripPrefixSuffixAndSnakeCase requires a literal suffix")
        }
      Absent => rust_serde_error_policy(message: "StripPrefixSuffixAndSnakeCase requires a literal prefix")
    }
  } else {
    rust_serde_error_policy(message: concat("unsupported VariantNaming: ", naming_name))
  }
}

fn rust_internal_policy_for_encoding(encoding: Node, source_indices: Map<String, NewlineIndex>) -> RustEnumWireSerde {
  match record_string_field(record: encoding, field_name: "tag_field", source_indices: source_indices) {
    Present { value: tag_field } =>
      match naming_policy_node(encoding: encoding, source_indices: source_indices) {
        Present { value: naming } => rust_internal_policy_for_naming(tag_field: tag_field, naming: naming, source_indices: source_indices)
        Absent => rust_serde_error_policy(message: "InternallyTaggedObject requires a naming policy")
      }
    Absent => rust_serde_error_policy(message: "InternallyTaggedObject requires a literal tag_field")
  }
}

fn resolve_wire_serde_policy_from_encoding_node(ve: Node, source_indices: Map<String, NewlineIndex>) -> RustEnumWireSerde {
  let encoding_name = authored_name_at(source_indices: source_indices, node: ve)
  if encoding_name == "InternallyTaggedObject" {
    rust_internal_policy_for_encoding(encoding: ve, source_indices: source_indices)
  } else if encoding_name == "StringVariant" {
    match naming_policy_node(encoding: ve, source_indices: source_indices) {
      Present { value: nv } => rust_string_policy_for_naming(naming: nv, source_indices: source_indices)
      Absent => rust_serde_error_policy(message: "StringVariant requires a naming policy")
    }
  } else if encoding_name == "UntaggedVariant" {
    rust_untagged_policy()
  } else if encoding_name == "TaggedVariant" {
    rust_tagged_object_policy()
  } else {
    rust_serde_error_policy(message: concat("unsupported VariantEncoding: ", encoding_name))
  }
}

fn resolve_wire_serde_policy(wire_item: Node, source_indices: Map<String, NewlineIndex>) -> RustEnumWireSerde {
  match wire_item.body {
    Present { value: ve } => resolve_wire_serde_policy_from_encoding_node(ve: ve, source_indices: source_indices)
    Absent =>
      match wire_item.expr_data {
        ExprRecordLit { parent_enum: _ } =>
          resolve_wire_serde_policy_from_encoding_node(ve: wire_item, source_indices: source_indices)
        _ => rust_serde_error_policy(message: "wire_contract: VariantEncoding could not be resolved (no initializer body and not a record literal)")
      }
  }
}

fn item_binding_is_named(env: TypeEnv, node: Node, name: String) -> Bool {
  authored_name(env: env, node: node) == name || node.name == name
}

fn resolve_wire_serde_policy_for_coproduct(wire_contract_item: Node?, source_indices: Map<String, NewlineIndex>, data_items: Map<String, List<Node>>) -> RustEnumWireSerde {
  resolve_wire_serde_policy_for_coproduct_seen(
    wire_contract_item: wire_contract_item,
    source_indices: source_indices,
    data_items: data_items,
    seen_aliases: empty_map(),
    fuel: 32
  )
}

fn resolve_wire_serde_policy_for_coproduct_seen(wire_contract_item: Node?, source_indices: Map<String, NewlineIndex>, data_items: Map<String, List<Node>>, seen_aliases: Map<String, Bool>, fuel: Int) -> RustEnumWireSerde {
  if fuel <= 0 {
    rust_serde_error_policy(message: "wire_contract: VariantEncoding alias chain exceeded recursion limit")
  } else { match wire_contract_item {
    Absent => rust_tagged_object_policy()
    Present { value: wc } =>
      if is_data_def_item(item: wc) {
        match wc.body {
          Absent =>
            rust_serde_error_policy(message: "wire_contract: data item has no initializer body")
          Present { value: init } =>
            match init.expr_data {
              ExprRecordLit { parent_enum: _ } =>
                resolve_wire_serde_policy(wire_item: init, source_indices: source_indices)
              ExprVar { binding_kind: _ } =>
                let alias_name = expr_var_name_at(texpr: init, source_indices: source_indices)
                if map_get(seen_aliases, alias_name) != none {
                  rust_serde_error_policy(message: concat("wire_contract: cyclic VariantEncoding alias: ", alias_name))
                } else {
                  match map_get(data_items, alias_name) {
                    Present { value: candidates } =>
                      if candidates |> count == 1 {
                        match first(candidates) {
                          Present { value: aliased_data } =>
                            resolve_wire_serde_policy_for_coproduct_seen(
                              wire_contract_item: Present { value: aliased_data },
                              source_indices: source_indices,
                              data_items: data_items,
                              seen_aliases: map_insert(seen_aliases, alias_name, true),
                              fuel: fuel - 1
                            )
                          Absent =>
                            rust_serde_error_policy(message: concat("wire_contract: missing VariantEncoding data alias: ", alias_name))
                        }
                      } else {
                        rust_serde_error_policy(message: concat("wire_contract: ambiguous VariantEncoding data alias: ", alias_name))
                      }
                  Absent =>
                    match init.inferred {
                      Absent =>
                        rust_serde_error_policy(message: "wire_contract: missing type inference on initializer (cannot resolve VariantEncoding alias)")
                      Present { value: inf } =>
                        match inf {
                          Resolved { node } =>
                            if is_data_def_item(item: node) {
                              resolve_wire_serde_policy_for_coproduct_seen(
                                wire_contract_item: Present { value: node },
                                source_indices: source_indices,
                                data_items: data_items,
                                seen_aliases: map_insert(seen_aliases, alias_name, true),
                                fuel: fuel - 1
                              )
                            } else {
                              resolve_wire_serde_policy(wire_item: node, source_indices: source_indices)
                            }
                          CompilerError { message, span: _ } =>
                            rust_serde_error_policy(message: concat("wire_contract: ", message))
                          TypeVariable { id: _ } =>
                            rust_serde_error_policy(message: "wire_contract: unresolved type variable in wire_contract initializer")
                        }
                    }
                }
                }
              _ =>
                match init.inferred {
                  Absent =>
                    rust_serde_error_policy(message: "wire_contract: missing type inference on initializer (cannot resolve VariantEncoding alias)")
                  Present { value: inf } =>
                    match inf {
                      Resolved { node } =>
                        if is_data_def_item(item: node) {
                          resolve_wire_serde_policy_for_coproduct_seen(
                            wire_contract_item: Present { value: node },
                            source_indices: source_indices,
                            data_items: data_items,
                            seen_aliases: seen_aliases,
                            fuel: fuel - 1
                          )
                        } else {
                          resolve_wire_serde_policy(wire_item: node, source_indices: source_indices)
                        }
                      CompilerError { message, span: _ } =>
                        rust_serde_error_policy(message: concat("wire_contract: ", message))
                      TypeVariable { id: _ } =>
                        rust_serde_error_policy(message: "wire_contract: unresolved type variable in wire_contract initializer")
                    }
                }
            }
        }
      } else {
        resolve_wire_serde_policy(wire_item: wc, source_indices: source_indices)
      }
  } }
}

fn coproduct_wire_contract_encoding(contract_item: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  match contract_item.body {
    Present { value: body } =>
      field_value_by_name(record: body, field_name: "encoding", source_indices: source_indices)
    Absent => none
  }
}

fn variant_encoding_is_string_variant(encoding: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  authored_name_at(source_indices: source_indices, node: encoding) == "StringVariant"
}

fn coproduct_wire_contract_targets(contract_item: Node, coproduct_name: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  match contract_item.body {
    Present { value: body } =>
      match coproduct_decl_ref_decl_name(body: body, source_indices: source_indices) {
        Present { value: target_name } => target_name == coproduct_name
        Absent => false
      }
    Absent => false
  }
}

fn emit_rust_compile_error_item(message: String) -> String {
  concat("compile_error!(\"", message, "\");")
}

fn emit_rust_compile_error_expr(message: String) -> String {
  concat("compile_error!(\"", message, "\")")
}

fn module_imports_std_serialization_coproduct_wire_contract(imports: List<Node>, source_indices: Map<String, NewlineIndex>) -> Bool {
  imports |> any(imp =>
    authored_name_at(source_indices: source_indices, node: imp) == "std.serialization"
    && (import_is_all(n: imp) || import_specific_names_at(n: imp, source_indices: source_indices) |> any(name => name == "CoproductWireContract"))
  )
}

fn data_item_type_is_coproduct_wire_contract(item: Node, imports: List<Node>, source_indices: Map<String, NewlineIndex>) -> Bool {
  match item.type_annotation {
    Present { value: type_node } =>
      authored_name_at(source_indices: source_indices, node: type_node) == "CoproductWireContract"
      && module_imports_std_serialization_coproduct_wire_contract(imports: imports, source_indices: source_indices)
    Absent => false
  }
}

fn module_defines_local_coproduct_wire_contract_type(module_items: List<Node>, source_indices: Map<String, NewlineIndex>) -> Bool {
  module_items
    |> any(item =>
      (
        is_type_def_item(item: item)
        || is_type_alias_item(item: item, source_indices: source_indices)
        || is_type_decl_item(item: item, source_indices: source_indices)
      )
      && authored_name_at(source_indices: source_indices, node: item) == "CoproductWireContract"
    )
}

fn is_coproduct_wire_contract_row(item: Node, module_items: List<Node>, imports: List<Node>, source_indices: Map<String, NewlineIndex>) -> Bool {
  if !is_data_def_item(item: item) {
    false
  } else if module_defines_local_coproduct_wire_contract_type(module_items: module_items, source_indices: source_indices) {
    false
  } else if !data_item_type_is_coproduct_wire_contract(item: item, imports: imports, source_indices: source_indices) {
    false
  } else {
    match item.body {
      Present { value: body } =>
        field_value_by_name(record: body, field_name: "coproduct", source_indices: source_indices) != none
        && field_value_by_name(record: body, field_name: "encoding", source_indices: source_indices) != none
      Absent => false
    }
  }
}

fn emit_coproduct_wire_contract_target_validation(contract_item: Node, local_coproduct_names: List<String>, source_indices: Map<String, NewlineIndex>) -> String {
  match contract_item.body {
    Present { value: body } =>
      match coproduct_decl_ref_decl_name(body: body, source_indices: source_indices) {
        Present { value: target_name } =>
          if any(local_coproduct_names, predicate: name => name == target_name) {
            ""
          } else {
            emit_rust_compile_error_item(message: concat("CoproductWireContract target does not name a local coproduct: ", target_name))
          }
        Absent =>
          emit_rust_compile_error_item(message: "CoproductWireContract.coproduct must be a DeclarationRef with a string decl_name")
      }
    Absent =>
      emit_rust_compile_error_item(message: "CoproductWireContract row missing initializer body")
  }
}

fn emit_coproduct_wire_contract_validations(module_items: List<Node>, imports: List<Node>, local_coproduct_names: List<String>, source_indices: Map<String, NewlineIndex>) -> String {
  if local_coproduct_names |> count == 0 {
    ""
  } else {
    module_items
      |> filter(item => is_coproduct_wire_contract_row(item: item, module_items: module_items, imports: imports, source_indices: source_indices))
      |> map(item => emit_coproduct_wire_contract_target_validation(contract_item: item, local_coproduct_names: local_coproduct_names, source_indices: source_indices))
      |> filter(text => text != "")
      |> join(separator: "\n")
  }
}

fn resolve_local_coproduct_wire_policy(coproduct_name: String, all_unit_variants: Bool, module_items: List<Node>, imports: List<Node>, source_indices: Map<String, NewlineIndex>) -> RustEnumWireSerde? {
  let contracts = module_items
    |> filter(item => is_coproduct_wire_contract_row(item: item, module_items: module_items, imports: imports, source_indices: source_indices) && coproduct_wire_contract_targets(contract_item: item, coproduct_name: coproduct_name, source_indices: source_indices))
  if contracts |> count == 0 {
    none
  } else if contracts |> count == 1 {
    match contracts |> first {
      Present { value: contract } =>
        match coproduct_wire_contract_encoding(contract_item: contract, source_indices: source_indices) {
          Present { value: encoding } =>
            if variant_encoding_is_string_variant(encoding: encoding, source_indices: source_indices) && !all_unit_variants {
              Present { value: rust_serde_error_policy(message: concat("CoproductWireContract StringVariant requires a nullary-only coproduct: ", coproduct_name)) }
            } else {
              Present { value: resolve_wire_serde_policy_from_encoding_node(ve: encoding, source_indices: source_indices) }
            }
          Absent =>
            Present { value: rust_serde_error_policy(message: concat("CoproductWireContract missing encoding for ", coproduct_name)) }
        }
      Absent => none
    }
  } else {
    Present {
      value: rust_serde_error_policy(message: concat("ambiguous CoproductWireContract rows for ", coproduct_name))
    }
  }
}

fn build_data_item_index(modules: List<TypedModule>) -> Map<String, Node> {
  modules |> fold(init: empty_map(), f: (acc, tm) =>
    let module_name = authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)
    tm.items
      |> filter(item => is_data_def_item(item: item))
      |> fold(init: acc, f: (item_acc, item) =>
        let item_name = authored_name_at(source_indices: tm.type_env.source_indices, node: item)
        let qualified_name = concat(module_name, ".", item_name)
        map_insert(item_acc, qualified_name, item)
      )
  )
}

fn insert_scoped_data_item(scoped: Map<String, List<Node>>, name: String, item: Node) -> Map<String, List<Node>> {
  let existing = match map_get(scoped, name) {
    Present { value: entries } => entries
    Absent => []
  }
  map_insert(scoped, name, concat(existing, [item]))
}

fn build_scoped_data_item_index(typed_module: TypedModule, data_items: Map<String, Node>) -> Map<String, List<Node>> {
  let module_name = authored_name_at(source_indices: typed_module.type_env.source_indices, node: typed_module.module)
  let local = typed_module.items
    |> filter(item => is_data_def_item(item: item))
    |> fold(init: empty_map(), f: (acc, item) =>
      insert_scoped_data_item(
        scoped: acc,
        name: authored_name_at(source_indices: typed_module.type_env.source_indices, node: item),
        item: item
      )
    )
  module_imports(n: typed_module.module)
    |> fold(init: local, f: (acc, imp) =>
      let import_path = authored_name_at(source_indices: typed_module.type_env.source_indices, node: imp)
      if import_is_all(imp) {
        acc
      } else {
        import_specific_names_at(n: imp, source_indices: typed_module.type_env.source_indices)
          |> fold(init: acc, f: (inner, imported_name) =>
            let qualified = concat(import_path, ".", imported_name)
            match map_get(data_items, qualified) {
              Present { value: imported_item } =>
                insert_scoped_data_item(scoped: inner, name: imported_name, item: imported_item)
              Absent => inner
            }
          )
      }
    )
}

fn augment_scoped_data_item_index_with_imports(scoped: Map<String, List<Node>>, imports: List<Node>, source_indices: Map<String, NewlineIndex>, data_items: Map<String, Node>) -> Map<String, List<Node>> {
  imports
    |> fold(init: scoped, f: (acc, imp) =>
      let import_path = authored_name_at(source_indices: source_indices, node: imp)
      if import_is_all(imp) {
        acc
      } else {
        import_specific_names_at(n: imp, source_indices: source_indices)
          |> fold(init: acc, f: (inner, imported_name) =>
            match map_get(inner, imported_name) {
              Present { value: _ } => inner
              Absent =>
                let qualified = concat(import_path, ".", imported_name)
                match map_get(data_items, qualified) {
                  Present { value: imported_item } =>
                    insert_scoped_data_item(scoped: inner, name: imported_name, item: imported_item)
                  Absent => inner
                }
            }
          )
      }
    )
}

fn rust_serde_rename_template_text() -> String {
  match serialization_for_target(target: Rust).rename_attribute_template {
    Present { value: template } => template
    Absent => emit_error_expr(message: "missing serde rename_attribute_template for Rust", target: Rust)
  }
}

fn rust_test_file_path(module_name: String) -> String {
  let conventions = test_conventions_for_target(target: Rust)
  let file_dir = match conventions.file_dir {
    Present { value: dir } => dir
    Absent => ""
  }
  let filename = module_to_filename(name: module_name)
  concat(file_dir, conventions.file_prefix, filename, conventions.file_suffix, rust_source_ext())
}

fn rust_test_name(projection: TestProjection) -> String {
  test_function_name(projection: projection, target: Rust)
}

fn rust_async_test_decorator() -> String {
  match test_conventions_for_target(target: Rust).async_decorator {
    Present { value: decorator } => decorator
    Absent => emit_error_expr(message: "missing async_decorator for Rust test conventions", target: Rust)
  }
}

fn emit_rust_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> BlockEmitState {
  match remaining |> first {
    Absent => BlockEmitState { text: text, scope: scope }
    Present { value: stmt } =>
      let line = emit_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let next_scope = scope_after_expr(texpr: stmt, scope: scope)
      emit_rust_block_stmts(remaining: remaining |> skip(1),
        text: list_push(text, line), scope: next_scope,
        registry: registry, depth: depth, shared_types: shared_types, emit_info: emit_info)
  }
}

fn emit_rust_init_block_stmts(remaining: List<Node>, text: List<String>,
    scope: InferScope, registry: Map<String, ItemInfo>, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> BlockEmitState {
  match remaining |> first {
    Absent => BlockEmitState { text: text, scope: scope }
    Present { value: stmt } =>
      let rest = remaining |> skip(1)
      match rest |> first {
        Absent => BlockEmitState { text: text, scope: scope }
        Present { value: _ } =>
          let raw_line = emit_typed_expr(texpr: stmt, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
          let is_let = match stmt.expr_data {
            ExprLet => true
            _ => false
          }
          let line = if is_let { raw_line } else { concat(raw_line, ";") }
          let next_scope = scope_after_expr(texpr: stmt, scope: scope)
          emit_rust_init_block_stmts(remaining: rest,
            text: list_push(text, line), scope: next_scope,
            registry: registry, depth: depth, shared_types: shared_types, emit_info: emit_info)
      }
  }
}

fn rust_qualify_type_leaf_name(name: String, variant_to_enum: Map<String, String>) -> String {
  match map_get(variant_to_enum, name) {
    Present { value: parent } =>
      if parent != "" { concat(parent, "::", name) } else { name }
    Absent => name
  }
}

fn rust_render_type_leaf_name(name: String, variant_to_enum: Map<String, String>) -> String {
  if is_value_variant_type_arg(generic_param_names: [], variant_to_enum: variant_to_enum, name: name) {
    "()"
  } else {
    match rust_opaque_kernel_alias_carrier(name: name) {
      Present { value: carrier } => carrier
      Absent => rust_qualify_type_leaf_name(name: name, variant_to_enum: variant_to_enum)
    }
  }
}

fn rust_phantom_zst_marker_def(vname: String) -> String {
  concat(
    "#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]\n",
    rust_visibility_prefix(), rust_items().struct_keyword, " ", vname, ";"
  )
}

fn emit_phantom_zst_markers_for_enum(children: List<Node>, env: TypeEnv) -> String {
  let markers = children
    |> filter(child => child.children |> count == 0)
    |> filter(child => is_phantom_unit_variant_type_arg(env: env, variant_name: authored_name(env: env, node: child)))
    |> map(child =>
      let vname = authored_name(env: env, node: child)
      rust_phantom_zst_marker_def(vname: vname)
    )
    |> join(separator: "\n")
  markers
}

fn phantom_marker_name_shadowed_by_real_type_item(items: List<Node>, source_indices: Map<String, NewlineIndex>, vname: String) -> Bool {
  items |> any(item =>
    authored_name_at(source_indices: source_indices, node: item) == vname
    && (is_type_alias_item(item: item, source_indices: source_indices) || is_type_decl_item(item: item, source_indices: source_indices))
  )
}

fn collect_phantom_zst_marker_names(items: List<Node>, env: TypeEnv) -> List<String> {
  items
    |> filter(item => is_type_def_item(item: item) && item.children |> all(c => c.children |> count == 0))
    |> fold(init: [], f: (acc, item) =>
      fold(item.children, init: acc, f: (inner, child) =>
        if child.children |> count == 0 {
          let vname = authored_name(env: env, node: child)
          if is_phantom_unit_variant_type_arg(env: env, variant_name: vname)
            && !inner |> any(n => n == vname)
            && !phantom_marker_name_shadowed_by_real_type_item(items: items, source_indices: env.source_indices, vname: vname) {
            concat(inner, [vname])
          } else { inner }
        } else { inner }
      )
    )
}

fn emit_module_phantom_zst_markers(items: List<Node>, env: TypeEnv) -> String {
  collect_phantom_zst_marker_names(items: items, env: env)
    |> map(vname => rust_phantom_zst_marker_def(vname: vname))
    |> join(separator: "\n")
}

fn has_complex_variants(item: Node) -> Bool {
  if item.children |> count == 0 { false }
  else {
    item.children |> any(c => c.connective != NoConnective)
  }
}

fn is_simple_disj(item: Node) -> Bool {
  let complex = item.children |> filter(v => v.children |> count > 0)
  complex |> count == 0
}

fn is_dag_value_type_name(name: String) -> Bool {
  match is_copy(target: Rust, dag_name: name) {
    Present { value: v } => v
    Absent => false
  }
}

fn is_type_constant(summary: TypeSummary, recursive_type_set: Set<String>) -> Bool {
  let is_recursive = set_contains(recursive_type_set, summary.name)
  let has_generics = (summary.generic_param_names |> count) > 0
  match summary.repr {
    EnumRepr { unit_only: unit_only } =>
      unit_only && !is_recursive && !has_generics && !summary.has_fn_fields
    StructRepr =>
      if is_recursive || has_generics || summary.has_fn_fields { false }
      else {
        let field_count = sorted_map_keys(summary.field_summaries) |> count
        let ft_count = sorted_map_keys(summary.field_type_map) |> count
        if ft_count < field_count { false }
        else { map_values(summary.field_type_map) |> all(tn => is_dag_value_type_name(name: tn)) }
      }
  }
}

fn maybe_mark_shared_type(acc: Set<String>, summary: TypeSummary, recursive_type_set: Set<String>, target_needs_sharing: Bool) -> Set<String> {
  let needs_sharing = target_needs_sharing && match summary.repr {
    StructRepr => true
    EnumRepr { unit_only: unit_only } => unit_only == false
  }
  if is_grounded_coproduct_native_alias(name: summary.name) {
    acc
  } else if needs_sharing && !is_type_constant(summary: summary, recursive_type_set: recursive_type_set) {
    set_insert(acc, summary.name)
  } else {
    acc
  }
}

fn build_shared_types(type_summaries: Map<String, TypeSummary>, recursive_type_set: Set<String>, target: RenderTarget) -> Set<String> {

  let sharing = sharing_for_target(target: target)
  let user_shared = map_values(type_summaries) |> fold(init: empty_set(), f: (acc, summary) =>
    maybe_mark_shared_type(acc: acc, summary: summary, recursive_type_set: recursive_type_set, target_needs_sharing: sharing.needs_sharing)
  )

  let collection_keys = sorted_map_keys(rust_container_templates)
    |> filter(k => sharing.needs_sharing && k != "optional" && k != "boolean_algebra")
  collection_keys |> fold(init: user_shared, f: (acc, key) =>
    let pascal = to_pascal(name: key)
    set_insert(acc, pascal)
  )
}

type OwnershipProofEntry {
  name: String
  proof: OwnershipProof
  param_names: Set<String>
}

type OwnershipBuildResult {
  ownership_index: Map<String, Set<String>>
  read_only_params_index: Map<String, Set<String>>
}

fn build_ownership_results(modules: List<TypedModule>) -> OwnershipBuildResult {
  let callable_set = modules |> fold(init: empty_set(), f: (acc, m) =>
    m.items |> filter(item => item.body != Absent) |> fold(init: acc, f: (inner, item) =>
      set_union(inner, collect_callable_refs(texpr: item.body.value, si: m.type_env.source_indices))
    )
  )
  let proofs = modules |> flat_map(m =>
    m.items |> filter(item => item.body != Absent) |> map(item =>
      let pnames = item.params |> fold(init: empty_set(), f: (acc, p) =>
        set_insert(acc, param_node_name_at(n: p, source_indices: m.type_env.source_indices))
      )
      let si = m.type_env.source_indices
      let qualified = concat(authored_name_at(source_indices: si, node: m.module), ".", authored_name_at(source_indices: si, node: item))
      OwnershipProofEntry { name: qualified, proof: analyze_ownership(func_name: authored_name_at(source_indices: si, node: item), params: item.params, body: item.body.value, si: si), param_names: pnames }
    )
  )
  proofs |> fold(init: OwnershipBuildResult { ownership_index: empty_map(), read_only_params_index: empty_map() }, f: (acc, entry) =>
    let read_only = if set_contains(callable_set, entry.proof.func_name) { empty_set() }
      else { build_read_only_params(proof: entry.proof, param_names: entry.param_names) }
    let movable = build_movable_set(proof: entry.proof, param_names: entry.param_names)
    OwnershipBuildResult {
      ownership_index: map_insert(acc.ownership_index, entry.name, movable),
      read_only_params_index: map_insert(acc.read_only_params_index, entry.name, read_only)
    }
  )
}

fn group_unlisted_type_names(diags: List<ErrorNode>) -> Map<String, List<String>> {
  diags |> fold(init: empty_map(), f: (acc, en) =>
    match en.diagnostic {
      UnlistedImportUse { name: nm, span: _ } =>
        let existing = match map_get(acc, en.module_name) { Present { value: v } => v  Absent => [] }
        map_insert(acc, en.module_name, concat(existing, [nm]))
      _ => acc
    })
}

fn emit_rust(typed: ResolvedGraph) -> EmitResult {
  let has_v1_seed = corpus_has_v1_seed_source_indices(modules: typed.modules)
  let base_info = build_emit_graph_info(modules: typed.modules, has_v1_seed: has_v1_seed)
  let ownership = build_ownership_results(modules: typed.modules)
  let shared = build_shared_types(type_summaries: base_info.type_summaries, recursive_type_set: base_info.recursive_type_set, target: Rust)
  let emit_info = EmitGraphInfo {
    type_summaries: base_info.type_summaries,
    type_decl_items: base_info.type_decl_items,
    recursive_type_set: base_info.recursive_type_set,
    fielded_variants: base_info.fielded_variants,
    positional_payload_variants: base_info.positional_payload_variants,
    shared_types: shared,
    ownership_index: ownership.ownership_index,
    movable: empty_set(),
    variant_to_enum: base_info.variant_to_enum,
    owned_bindings: empty_set(),
    read_only_params_index: ownership.read_only_params_index,
    read_only_params: empty_set(),
    corpus_repr: base_info.corpus_repr,
    fn_generic_param_names: base_info.fn_generic_param_names,
    fn_type_env: base_info.fn_type_env,
    fn_return_type: none
  }
  let shared_types = emit_info.shared_types
  let registry = typed.item_registry
  let data_items = build_data_item_index(modules: typed.modules)
  let workflow_funcs = collect_workflow_funcs(modules: typed.modules, registry: registry, read_only_params_index: emit_info.read_only_params_index)
  let workflow_default_diags = validate_workflow_param_defaults(workflow_funcs: workflow_funcs)
  if workflow_default_diags |> count > 0 {
    return EmitResult { files: [], diagnostics: workflow_default_diags }
  }
  let svc_module_map = typed.modules |> fold(init: empty_map(), f: (acc, tm) =>
    let svc_items = tm.items |> filter(item => is_service_item(item: item))
    let mod_filename = module_to_filename(name: authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module))
    svc_items |> fold(init: acc, f: (a, svc) =>
      map_insert(a, authored_name_at(source_indices: tm.type_env.source_indices, node: svc), mod_filename)
    )
  )
  let test_projections = extract_test_projections(typed: typed)
  let export_sets = build_module_export_sets(modules: typed.modules)
  let module_index = build_module_index(modules: typed.modules)
  let unlisted_type_names_by_module = group_unlisted_type_names(diags: typed.diagnostics)
  let module_files = typed.modules |> map(tm => emit_module_full(typed_module: tm, registry: registry, emit_info: emit_info, shared_types: shared_types, svc_module_map: svc_module_map, data_items: data_items, export_sets: export_sets, typed_modules: typed.modules, module_index: module_index, unlisted_type_names: match map_get(unlisted_type_names_by_module, authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)) { Present { value: v } => v  Absent => [] }))
  let test_files = typed.modules
    |> map(tm => emit_test_file(
      module_name: authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module),
      projections: test_projections |> filter(p => p.module_name == authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)),
      corpus_repr: emit_info.corpus_repr))
    |> filter(f => f.path != "")
  let has_services = has_service_items(typed: typed)
  let has_pipeline = typed.modules |> any(m => authored_name_at(source_indices: m.type_env.source_indices, node: m.module) == "v1.compiler.compile")
  let crate_name = if has_pipeline { "v1_compiler" } else { "v1_compiled" }
  let cargo = emit_cargo_toml(crate_name: crate_name, has_services: has_services)
  let main_file = emit_main_rs(workflow_funcs: workflow_funcs, modules: typed.modules, has_services: has_services, crate_name: crate_name, svc_module_map: svc_module_map)
  let rt_file = emit_v2_rt_module()
  let compiler_tests_file = if has_pipeline { [emit_compiler_tests_module()] } else { [] }
  let dry_run_file = if has_services {
    [emit_dry_run_module()]
  } else {
    []
  }

  let v2_std_text_stub = if corpus_repr_is_faithful(corpus_repr: emit_info.corpus_repr)
    && module_files_reference_v2_std_text(files: module_files)
    && !module_files_include_v2_std_text(files: module_files) {
    [emit_v2_std_text_closure_stub_module()]
  } else {
    []
  }
  let v2_std_integer_stub = if corpus_repr_is_faithful(corpus_repr: emit_info.corpus_repr)
    && module_files_reference_v2_std_integer(files: module_files)
    && !module_files_include_v2_std_integer(files: module_files) {
    [emit_v2_std_integer_closure_stub_module()]
  } else {
    []
  }
  let all_mod_files = concat(module_files, v2_std_text_stub, v2_std_integer_stub, [rt_file], dry_run_file)
  let lib_file = emit_lib_rs_from_files(all_module_files: all_mod_files, has_compiler_tests: has_pipeline)
  let files = concat([cargo, lib_file, main_file], all_mod_files, compiler_tests_file, test_files)
  EmitResult { files: files, diagnostics: [] }
}

fn emit_v2_rt_module() -> TextFile {
  TextFile { path: concat(rust_source_root(), "v1_rt", rust_source_ext()), content: rust_runtime_source() }
}

fn emit_compiler_tests_module() -> TextFile {
  TextFile { path: concat(rust_source_root(), "compiler_tests", rust_source_ext()), content: compiler_tests_source() }
}

fn module_files_reference_v2_std_text(files: List<TextFile>) -> Bool {
  files |> any(f => string_contains(s: f.content, pattern: "crate::v2_std_text::"))
}

fn module_files_reference_v2_std_integer(files: List<TextFile>) -> Bool {
  files |> any(f => string_contains(s: f.content, pattern: "v2_std_integer::"))
}

fn module_files_include_v2_std_text(files: List<TextFile>) -> Bool {
  let expected = concat(rust_source_root(), "v2_std_text", rust_source_ext())
  files |> any(f => f.path == expected)
}

fn module_files_include_v2_std_integer(files: List<TextFile>) -> Bool {
  let expected = concat(rust_source_root(), "v2_std_integer", rust_source_ext())
  files |> any(f => f.path == expected)
}

fn emit_v2_std_integer_closure_stub_module() -> TextFile {
  TextFile {
    path: concat(rust_source_root(), "v2_std_integer", rust_source_ext()),
    content: closure_stub_v2_std_integer_source()
  }
}

fn emit_v2_std_text_closure_stub_module() -> TextFile {
  TextFile {
    path: concat(rust_source_root(), "v2_std_text", rust_source_ext()),
    content: closure_stub_v2_std_text_source()
  }
}

fn emit_lib_rs_from_files(all_module_files: List<TextFile>, has_compiler_tests: Bool) -> TextFile {
  let src_prefix_len = string_length(s: rust_source_root())
  let ext_len = string_length(s: rust_source_ext())
  let mod_decls = all_module_files |> map(f =>
    let path_len = string_length(s: f.path)
    let mod_name = substring(s: f.path, start: src_prefix_len, end: path_len - ext_len)
    concat(rust_visibility_prefix(), rust_items().module_keyword, " ", mod_name, ";")
  )

  let hand_maintained_mods = if has_compiler_tests {
    generated_pub_mod_block
  } else {
    ""
  }
  let test_mod = if has_compiler_tests {
    "\n\n#[cfg(test)]\nmod compiler_tests;"
  } else {
    ""
  }
  let shared_types = emit_non_empty_wrappers()
  let content = concat("// Generated by v1 compiler -- do not edit.\n\n",
    "#![allow(unused_imports, unused_variables, unused_mut, unused_parens, dead_code, non_shorthand_field_patterns, suspicious_double_ref_op, clippy::all)]\n#![deny(unreachable_patterns)]\n",

    "#![recursion_limit = \"256\"]\n\n",
    "use im::\{OrdSet as BTreeSet, Vector as Vec\};\n\n",
    mod_decls |> join(separator: "\n"),
    hand_maintained_mods,
    "\n\n", shared_types,
    test_mod)
  TextFile { path: concat(rust_source_root(), "lib", rust_source_ext()), content: concat(content, "\n") }
}

fn emit_module(typed_module: TypedModule, registry: Map<String, ItemInfo>) -> TextFile {
  let has_v1_seed = corpus_has_v1_seed_source_indices(modules: [typed_module])
  let base_info = build_emit_graph_info(modules: [typed_module], has_v1_seed: has_v1_seed)
  let shared = build_shared_types(type_summaries: base_info.type_summaries, recursive_type_set: base_info.recursive_type_set, target: Rust)
  let emit_info = EmitGraphInfo {
    type_summaries: base_info.type_summaries,
    type_decl_items: base_info.type_decl_items,
    recursive_type_set: base_info.recursive_type_set,
    fielded_variants: base_info.fielded_variants,
    positional_payload_variants: base_info.positional_payload_variants,
    shared_types: shared,
    ownership_index: base_info.ownership_index,
    movable: base_info.movable,
    variant_to_enum: base_info.variant_to_enum,
    owned_bindings: empty_set(),
    read_only_params_index: base_info.read_only_params_index,
    read_only_params: empty_set(),
    corpus_repr: base_info.corpus_repr,
    fn_generic_param_names: base_info.fn_generic_param_names,
    fn_type_env: base_info.fn_type_env,
    fn_return_type: none
  }
  let shared_types = emit_info.shared_types
  let export_sets = build_module_export_sets(modules: [typed_module])
  let module_index = build_module_index(modules: [typed_module])
  emit_module_full(typed_module: typed_module, registry: registry, emit_info: emit_info, shared_types: shared_types, svc_module_map: empty_map(), data_items: build_data_item_index(modules: [typed_module]), export_sets: export_sets, typed_modules: [typed_module], module_index: module_index, unlisted_type_names: [])
}

fn build_module_export_sets(modules: List<TypedModule>) -> Map<String, Map<String, Bool>> {
  modules |> fold(init: empty_map(), f: (acc, tm) =>
    let m_name = authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)
    let exported = get_exported_names(module: tm.module, source_indices: tm.type_env.source_indices)
    let exported_set = exported |> fold(init: empty_map(), f: (inner, n) => map_insert(inner, n, true))
    map_insert(acc, m_name, exported_set)
  )
}

fn emit_inferred_type_leaf_name(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  match n.inferred {
    Present { value: Resolved { node: rt } } =>
      let is_optional = rt.return_cardinality == CardOptional
      if is_optional {
        authored_name_at(source_indices: source_indices, node: with_required_cardinality(n: rt))
      } else { authored_name_at(source_indices: source_indices, node: rt) }
    _ => ""
  }
}

fn anonymous_record_lit_surface_name(n: Node, source_indices: Map<String, NewlineIndex>, type_summaries: Map<String, TypeSummary>) -> String {
  let lit_field_names = n.children |> map(f => field_init_node_name_at(n: f, source_indices: source_indices))
  let field_type_hints = fold(n.children, init: empty_map(), f: (acc, f) =>
    let fname = field_init_node_name_at(n: f, source_indices: source_indices)
    let fval = field_init_node_value(n: f)
    match fval.inferred {
      Present { value: Resolved { node: type_node } } =>
        map_insert(acc, fname, authored_name_at(source_indices: source_indices, node: type_node))
      _ => acc
    }
  )
  match find_struct_name_by_fields(field_names: lit_field_names, field_type_hints: field_type_hints, type_summaries: type_summaries) {
    Present { value: sn } => sn
    Absent =>
      match find_unique_struct_name_by_fields(field_names: lit_field_names, type_summaries: type_summaries) {
        Present { value: sn } => sn
        Absent =>
          let rt = resolved_type(n: n)
          let rt_name = authored_name_at(source_indices: source_indices, node: rt)
          if rt.ident_span != none && map_contains_key(type_summaries, rt_name) { rt_name } else { "" }
      }
  }
}

fn record_lit_variant_payload_struct_surfaces(n: Node, source_indices: Map<String, NewlineIndex>, type_summaries: Map<String, TypeSummary>, variant_to_enum: Map<String, String>) -> List<String> {
  let variant_name = match record_lit_type_name_at(texpr: n, source_indices: source_indices) {
    Present { value: v } => v
    Absent => authored_name_at(source_indices: source_indices, node: n)
  }
  if variant_name == "" { [] } else {
    let enum_name = match map_get(variant_to_enum, variant_name) {
      Present { value: e } => e
      Absent => ""
    }
    if enum_name == "" { [] } else {
      match map_get(type_summaries, variant_summary_key(enum_name: enum_name, variant_name: variant_name)) {
        Present { value: summary } =>
          map_values(summary.field_type_map) |> filter(ft =>
            ft != "" && match map_get(type_summaries, ft) {
              Present { value: fts } =>
                match fts.repr {
                  StructRepr => true
                  _ => false
                }
              Absent => false
            }
          )
        Absent => []
      }
    }
  }
}

fn record_lit_field_type_hints(n: Node, source_indices: Map<String, NewlineIndex>) -> Map<String, String> {
  fold(n.children, init: empty_map(), f: (acc, f) =>
    let fname = field_init_node_name_at(n: f, source_indices: source_indices)
    let fval = field_init_node_value(n: f)
    match fval.inferred {
      Present { value: Resolved { node: type_node } } =>
        map_insert(acc, fname, authored_name_at(source_indices: source_indices, node: type_node))
      _ => acc
    }
  )
}

fn record_lit_resolved_ctor_import_names(type_name: String, n: Node, type_summaries: Map<String, TypeSummary>, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let from_template = match container_template_algebra(name: type_name) {
    Present { value: algebra } => if algebra != "" && algebra != type_name { [algebra] } else { [] }
    Absent => []
  }
  let from_fields = if type_name != "" {
    let lit_field_names = n.children |> map(f => field_init_node_name_at(n: f, source_indices: source_indices))
    let field_type_hints = record_lit_field_type_hints(n: n, source_indices: source_indices)
    match find_struct_name_by_fields(field_names: lit_field_names, field_type_hints: field_type_hints, type_summaries: type_summaries) {
      Present { value: sn } => if sn != "" && sn != type_name { [sn] } else { [] }
      Absent =>
        match find_unique_struct_name_by_fields(field_names: lit_field_names, type_summaries: type_summaries) {
          Present { value: sn } => if sn != "" && sn != type_name { [sn] } else { [] }
          Absent => []
        }
    }
  } else { [] }
  unique_strings(items: concat(from_template, from_fields))
}

fn record_lit_ref_names(n: Node, source_indices: Map<String, NewlineIndex>, type_summaries: Map<String, TypeSummary>, variant_to_enum: Map<String, String>) -> List<String> {
  match n.expr_data {
    ExprRecordLit { parent_enum: pe } =>
      let tn_list = match record_lit_type_name_at(texpr: n, source_indices: source_indices) {
        Present { value: t } => if t != "" { [t] } else { [] }
        Absent =>
          let inferred = emit_inferred_type_leaf_name(n: n, source_indices: source_indices)
          if inferred != "" { [inferred] } else {
            let anon = anonymous_record_lit_surface_name(n: n, source_indices: source_indices, type_summaries: type_summaries)
            if anon != "" { [anon] } else { [] }
          }
      }
      let ctor_names = tn_list |> flat_map(t => record_lit_resolved_ctor_import_names(type_name: t, n: n, type_summaries: type_summaries, source_indices: source_indices))
      let pe_list = match pe {
        Present { value: p } => if p != "" { [p] } else { [] }
        Absent => []
      }
      let payload_structs = record_lit_variant_payload_struct_surfaces(n: n, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)
      unique_strings(items: concat(concat(concat(tn_list, ctor_names), pe_list), payload_structs))
    _ => []
  }
}

fn collect_items_field_import_surface_names(items: List<Node>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let type_summaries = emit_info.type_summaries
  let variant_to_enum = emit_info.variant_to_enum
  unique_strings(items: items |> flat_map(item =>
    collect_item_emit_surface_names(item: item, source_indices: source_indices, emit_info: emit_info)
      |> flat_map(type_name =>
        let summary_lookup = match map_get(type_summaries, type_name) {
          Present { value: summary } => Present { value: summary }
          Absent =>
            match map_get(variant_to_enum, type_name) {
              Present { value: enum_name } =>
                if enum_name == "" { none } else {
                  map_get(type_summaries, variant_summary_key(enum_name: enum_name, variant_name: type_name))
                }
              Absent => none
            }
        }
        match summary_lookup {
          Present { value: summary } =>
            summary.field_import_surface_names |> filter(field_type =>
              field_type != "" && match map_get(type_summaries, field_type) {
                Present { value: ft } =>
                  match ft.repr {
                    StructRepr => true
                    _ => false
                  }
                Absent => false
              }
            )
          Absent => []
        }
      )
  ))
}

fn collect_value_ref_names(n: Node, source_indices: Map<String, NewlineIndex>, type_summaries: Map<String, TypeSummary>, variant_to_enum: Map<String, String>) -> List<String> {
  let self_name = match n.expr_data {
    ExprVar { binding_kind: bk } =>
      match bk {
        Present { value: FunctionValueBinding } =>
          let nm = authored_name_at(source_indices: source_indices, node: n)
          if nm != "" { [nm] } else { [] }
        _ => []
      }
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let nm = authored_name_at(source_indices: source_indices, node: n)
      if nm != "" { [nm] } else { [] }
    ExprRecordLit { parent_enum: _ } =>
      record_lit_ref_names(n: n, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)
    _ => []
  }
  let list_fields = concat(
    concat(
      n.children |> flat_map(c => collect_value_ref_names(n: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)),
      n.params |> flat_map(c => collect_value_ref_names(n: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum))
    ),
    concat(
      n.uses |> flat_map(c => collect_value_ref_names(n: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)),
      n.properties |> flat_map(c => collect_value_ref_names(n: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum))
    )
  )
  let opt_fields = concat(
    match n.body { Present { value: b } => collect_value_ref_names(n: b, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)  Absent => [] },
    concat(
      match n.transport { Present { value: t } => collect_value_ref_names(n: t, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)  Absent => [] },
      match n.type_annotation { Present { value: t } => collect_value_ref_names(n: t, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)  Absent => [] }
    )
  )
  concat(self_name, concat(list_fields, opt_fields))
}

fn collect_item_type_surface_names(item: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let from_ann = match item.type_annotation {
    Present { value: t } => collect_type_node_import_surface_names(n: t, source_indices: source_indices)
    Absent => []
  }
  let from_params = item.params |> flat_map(p =>
    collect_type_node_import_surface_names(n: param_node_type_expr(n: p), source_indices: source_indices)
  )
  let from_inferred = match item.inferred {
    Present { value: Resolved { node: rt } } => collect_type_node_import_surface_names(n: rt, source_indices: source_indices)
    _ => []
  }
  concat(from_ann, concat(from_params, from_inferred))
}

fn emit_scrutinee_type_name(scrutinee: Node, source_indices: Map<String, NewlineIndex>) -> String {
  emit_inferred_type_leaf_name(n: scrutinee, source_indices: source_indices)
}

fn collect_pattern_rc_prelude_parent_enums(pattern: MatchPattern, scrut_type: String, type_summaries: Map<String, TypeSummary>) -> List<String> {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: _ } =>
      let bare_n = qualified_last_segment(name: n)
      match pattern_parent_enum(name: bare_n, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: type_summaries) {
        Present { value: parent } => if parent != "" { [parent] } else { [] }
        Absent => []
      }
    _ => []
  }
}

fn collect_rc_pattern_prelude_parent_enums(pattern: MatchPattern, rc_analysis: RcPatternAnalysis, scrut_type: String, shared_types: Set<String>, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> List<String> {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      let bare_n = qualified_last_segment(name: n)
      if is_optional_variant_name(name: bare_n) && is_optional_parent(parent_enum: parent_enum) {
        if fbs |> count == 1 {
          match fbs |> first {
            Present { value: fb } =>
              let inner_analysis = analyze_rc_pattern(pattern: field_binding_pattern(n: fb), scrut_type: "", shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
              collect_rc_pattern_prelude_parent_enums(pattern: field_binding_pattern(n: fb), rc_analysis: inner_analysis, scrut_type: "", shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
            Absent => []
          }
        } else { [] }
      } else {
        fbs |> flat_map(fb =>
          let fb_name = field_binding_name_at(n: fb, source_indices: source_indices)
          if fb_name == "0" {
            let payload_scrut = positional_payload_scrut_type(parent_enum: pattern_parent_enum(name: bare_n, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: emit_info.type_summaries), variant_name: bare_n, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
            let inner_analysis = analyze_rc_pattern(pattern: field_binding_pattern(n: fb), scrut_type: payload_scrut, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
            collect_rc_pattern_prelude_parent_enums(pattern: field_binding_pattern(n: fb), rc_analysis: inner_analysis, scrut_type: payload_scrut, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
          } else if field_needs_rc_ref(field_name: fb_name, rc_analysis: rc_analysis) {
            collect_pattern_rc_prelude_parent_enums(pattern: field_binding_pattern(n: fb), scrut_type: "", type_summaries: emit_info.type_summaries)
          } else { [] }
        )
      }
    _ => []
  }
}

fn collect_match_pattern_parent_enums(expr: Node, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> List<String> {
  match expr.expr_data {
    ExprMatch =>
      let scrut = match_scrutinee(texpr: expr)
      let scrut_type = emit_scrutinee_type_name(scrutinee: scrut, source_indices: source_indices)
      let from_scrut = if scrut_type != "" { [scrut_type] } else { [] }
      let from_arms = match_arm_nodes(texpr: expr) |> flat_map(arm =>
        let arm_pat = arm_pattern(n: arm)
        let rc_analysis = analyze_rc_pattern(pattern: arm_pat, scrut_type: scrut_type, shared_types: emit_info.shared_types, emit_info: emit_info, source_indices: source_indices)
        concat(
          match arm_resolved_parent_enum(arm: arm, scrut_type: scrut_type, type_summaries: emit_info.type_summaries) {
            Present { value: parent } => if parent != "" { [parent] } else { [] }
            Absent => []
          },
          collect_rc_pattern_prelude_parent_enums(pattern: arm_pat, rc_analysis: rc_analysis, scrut_type: scrut_type, shared_types: emit_info.shared_types, source_indices: source_indices, emit_info: emit_info)
        )
      )
      unique_strings(items: concat(from_scrut, from_arms))
    _ => []
  }
}

fn variant_record_lit_summary_key(n: Node, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>) -> String {
  match n.expr_data {
    ExprRecordLit { parent_enum: pe } =>
      let variant_name = match record_lit_type_name_at(texpr: n, source_indices: source_indices) {
        Present { value: v } => v
        Absent => authored_name_at(source_indices: source_indices, node: n)
      }
      let enum_name = match pe {
        Present { value: e } => e
        Absent =>
          match map_get(variant_to_enum, variant_name) {
            Present { value: p } => p
            Absent => ""
          }
      }
      if enum_name != "" && variant_name != "" {
        variant_summary_key(enum_name: enum_name, variant_name: variant_name)
      } else { "" }
    _ => ""
  }
}

fn collect_record_lit_field_struct_surfaces(parent: Node, field_init: Node, source_indices: Map<String, NewlineIndex>, type_summaries: Map<String, TypeSummary>, variant_to_enum: Map<String, String>) -> List<String> {
  let field_name = field_init_node_name_at(n: field_init, source_indices: source_indices)
  if field_name == "" { [] } else {
    let field_value = field_init_node_value(n: field_init)
    match field_value.expr_data {
      ExprRecordLit { parent_enum: _ } =>
        let summary_key = variant_record_lit_summary_key(n: parent, source_indices: source_indices, variant_to_enum: variant_to_enum)
        if summary_key == "" { [] } else {
          match map_get(type_summaries, summary_key) {
            Present { value: summary } =>
              match map_get(summary.field_type_map, field_name) {
                Present { value: ft } =>
                  if ft != "" && match map_get(type_summaries, ft) {
                    Present { value: fts } =>
                      match fts.repr {
                        StructRepr => true
                        _ => false
                      }
                    Absent => false
                  } { [ft] } else { [] }
                Absent => []
              }
            Absent => []
          }
        }
      _ => []
    }
  }
}

fn collect_value_emit_type_surface_names(n: Node, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> List<String> {
  let variant_to_enum = emit_info.variant_to_enum
  let type_summaries = emit_info.type_summaries
  let self_names = match n.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      record_lit_ref_names(n: n, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)
    ExprMatch => collect_match_pattern_parent_enums(expr: n, source_indices: source_indices, emit_info: emit_info)
    _ =>
      let from_inferred = emit_inferred_type_leaf_name(n: n, source_indices: source_indices)
      let from_inferred_list = if from_inferred != "" { [from_inferred] } else { [] }
      let nm = authored_name_at(source_indices: source_indices, node: n)
      let from_variant = match map_get(variant_to_enum, nm) {
        Present { value: parent } => if parent != "" { [parent] } else { [] }
        Absent => []
      }
      unique_strings(items: concat(from_inferred_list, from_variant))
  }
  let child_names = match n.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      concat(
        n.children |> flat_map(c => collect_record_lit_field_struct_surfaces(parent: n, field_init: c, source_indices: source_indices, type_summaries: type_summaries, variant_to_enum: variant_to_enum)),
        n.children |> flat_map(c => collect_value_emit_type_surface_names(n: field_init_node_value(n: c), source_indices: source_indices, emit_info: emit_info))
      )
    _ =>
      concat(
        concat(
          n.children |> flat_map(c => collect_value_emit_type_surface_names(n: c, source_indices: source_indices, emit_info: emit_info)),
          n.params |> flat_map(c => collect_value_emit_type_surface_names(n: c, source_indices: source_indices, emit_info: emit_info))
        ),
        concat(
          n.uses |> flat_map(c => collect_value_emit_type_surface_names(n: c, source_indices: source_indices, emit_info: emit_info)),
          n.properties |> flat_map(c => collect_value_emit_type_surface_names(n: c, source_indices: source_indices, emit_info: emit_info))
        )
      )
  }
  let opt_names = concat(
    match n.body { Present { value: b } => collect_value_emit_type_surface_names(n: b, source_indices: source_indices, emit_info: emit_info)  Absent => [] },
    concat(
      match n.transport { Present { value: t } => collect_value_emit_type_surface_names(n: t, source_indices: source_indices, emit_info: emit_info)  Absent => [] },
      match n.type_annotation { Present { value: t } => collect_type_node_import_surface_names(n: t, source_indices: source_indices)  Absent => [] }
    )
  )
  unique_strings(items: concat(self_names, concat(child_names, opt_names)))
}

fn collect_item_emit_surface_names(item: Node, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> List<String> {
  let from_signature = collect_item_type_surface_names(item: item, source_indices: source_indices)
  let from_body = match item.body {
    Present { value: b } => collect_value_emit_type_surface_names(n: b, source_indices: source_indices, emit_info: emit_info)
    Absent => []
  }
  unique_strings(items: concat(from_signature, from_body))
}

fn provider_proven_exports_symbol(name: String, provider_module: String, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  name_in_transitive_export_surface(name: name, module_name: provider_module, visited: [], export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
}

fn imported_names_in_use_line(line: String) -> List<String> {
  if contains(line, "use ") == false {
    []
  } else {
    let after = match (line |> split(delimiter: "::")) |> last {
      Present { value: s } => s
      Absent => ""
    }
    let cleaned = replace(replace(replace(replace(after, "{", ""), "}", ""), ";", ""), "*", "")
    cleaned |> split(delimiter: ",") |> map(s => trim(s)) |> filter(s => s != "")
  }
}

data reference_derived_use_lines_note: String = "emit_import_closure_root (§5). emit_imports wires a per-module use-line only for names in an authored import list. Namespace-only resolution (post-PR 6848) references cross-module names WITHOUT importing them, so the ref is KNOWN but the use-line is declined (advisory UnlistedImportUse, is_error_diagnostic=false) — a §5 fail-open (⊤-as-ignorance) that emits invalid Rust (E0422/E0433/E0425 downstream). This pass derives the missing use-lines from the SAME resolver signal, split by reference kind onto its precise authority (§2 Realization: one closure, two consumers): (1) TYPE refs come from the resolver's UnlistedImportUse diagnostics (04_resolve.dag resolve_node, masked && not-in-SVN at type positions) threaded through ResolvedGraph.diagnostics — zero-drift by construction, the resolver already applied its SVN mask AT RESOLVE TIME; (2) VALUE-position refs come from collect_value_ref_names, a NARROW walk that structurally excludes the type over-collection classes (container heads, field labels, deep-inferred type names): fn/data refs (FunctionValueBinding ExprVar + ExprCall callee names) AND record-literal type constructions (ExprRecordLit type name + its parent_enum) — the latter matter because a GENERIC user type constructed as `T{..}` (e.g. RealizedStep<Nano>) is grounded by resolve_node (masked flips false into the defining-module descent) so it NEVER fires UnlistedImportUse, yet its bare `T` still needs a use-line; (3) TYPE-surface refs on item signatures come from collect_item_emit_surface_names (collect_item_type_surface_names + collect_value_emit_type_surface_names over data bodies) over each item's type_annotation, param types, inferred Resolved return/signature, AND value-position record-literal / variant-parent-enum surfaces the emitter will qualify (e.g. UriScheme::Https in a data anchor) — covering masked-at-resolve TYPE positions (e.g. partial-import return type PilotWidget) that never enter UnlistedImportUse and are not ExprVar/ExprCall harvests. Registry cross-module resolve + is_known_variant fallback keep variant constructors routed through their parent's import. CONSTRUCTION WALL (ROOT 3, §5): a candidate that registry-resolves to a provider module MUST also pass provider_proven_exports_symbol (name_in_transitive_export_surface) before any use-line is synthesized — never a plausible guess from the bare-name registry alone (the v1_rt::member fabrication class: registry homonym without export proof). NOTE the SVN authority is resolve-time-only: env.source_visible_names is built in 04_infer's unresolved_env and consumed by resolve_node, but is NOT persisted onto TypedModule.type_env (emit reads empty_map), so emit MUST NOT re-apply an SVN filter — it would be a no-op that (worse, when non-empty) diverges from the resolve-time mask. The union is instead already-imported filtered (a name already carried by an authored import / prelude / carrier use-line is skipped — this is what keeps a fully-imported SEED module zero-drift: its refs are all in an import line) and kernel filtered (no E0252 against the runtime prelude), then LOCAL-DECL filtered (any name the module itself declares — local_decl_names from authored_name_at over items, plus local_type_names aliases/phantoms — is never an import candidate: the containment tree binds a bare ref to the module's own declaration before any cross-module lookup, and the bare-name registry is last-write-wins, so a dual-tree homonym — dag/std List/Map/GroupCompletion vs their src/v2/std twins — steals the registry row and would otherwise synthesize a SELF-COLLIDING pub-use, the E0255 std_dup class measured on the 2026-07-22 curated 4-module baseline), then cross-module registry-resolved (a ref the registry maps to this same module is skipped), then reuses emit_specific_import_block for variant/reexport correctness with a §5 direct-emit fallback (arm (c): the name resolved via registry to provider AND export-proven). A candidate that registry-resolves to nothing, or resolves but fails export proof, is left unsynthesized (typed refusal at step-2 is future work); it never fabricates a use-line. SCOPE (emit_module_full): import-free modules run the full union (TYPE unlisted + VALUE refs) — the namespace-resolution case the post-PR-6848 regression is about. Import-bearing modules run reference_derived_use_lines ONLY when corpus_repr_is_faithful (FaithfulFreeMonoid / v2 namespace corpus): a partial-import namespace module (e.g. v2.std.node_query importing Outcome but calling outcome_with_diagnostics, or importing Outcome but annotating NamedEdgeTargetLookup) must synthesize BOTH the missing fn-value use-line AND the missing type use-line without duplicating names emit_imports already owns. HostNative import-bearing modules (v1 seed) get [] — running the walk there adds spurious/wrong use-lines (registry homonyms like kernel_span/is_type_variable) and breaks zero-drift seed regen."

fn expand_variant_payload_struct_imports(names: List<String>, type_summaries: Map<String, TypeSummary>, variant_to_enum: Map<String, String>) -> List<String> {
  names |> flat_map(n =>
    match map_get(variant_to_enum, n) {
      Present { value: enum_name } =>
        if enum_name == "" { [] } else {
          match map_get(type_summaries, variant_summary_key(enum_name: enum_name, variant_name: n)) {
            Present { value: summary } =>
              map_values(summary.field_type_map) |> filter(ft =>
                ft != "" && match map_get(type_summaries, ft) {
                  Present { value: fts } =>
                    match fts.repr {
                      StructRepr => true
                      _ => false
                    }
                  Absent => false
                }
              )
            Absent => []
          }
        }
      Absent => []
    }
  )
}

fn reference_derived_use_lines(items: List<Node>, unlisted_type_names: List<String>, this_module_name: String, registry: Map<String, ItemInfo>, emit_info: EmitGraphInfo, local_type_names: List<String>, already_imported_names: List<String>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> List<String> {
  {
    let value_names = unique_strings(items: items |> flat_map(item => collect_value_ref_names(n: item, source_indices: source_indices, type_summaries: emit_info.type_summaries, variant_to_enum: emit_info.variant_to_enum)))
    let type_surface_names = unique_strings(items: items |> flat_map(item => collect_item_emit_surface_names(item: item, source_indices: source_indices, emit_info: emit_info)))
    let field_surface_names = collect_items_field_import_surface_names(items: items, emit_info: emit_info, source_indices: source_indices)
    let variant_payload_structs = expand_variant_payload_struct_imports(names: type_surface_names, type_summaries: emit_info.type_summaries, variant_to_enum: emit_info.variant_to_enum)
    let candidates = unique_strings(items: concat(concat(concat(concat(unlisted_type_names, value_names), type_surface_names), field_surface_names), variant_payload_structs))
    let local_decl_names = items |> flat_map(item =>
      let nm = authored_name_at(source_indices: source_indices, node: item)
      if nm == "" { [] } else { [nm] }
    )
    let already = concat(already_imported_names, concat(local_type_names, local_decl_names))
      |> fold(init: empty_map(), f: (acc, nm) => map_insert(acc, nm, true))
    let unlisted = candidates |> flat_map(name =>
      if emit_map_has(m: already, key: name) || is_kernel_type(name: name) {
        []
      } else {
        match map_get(registry, name) {
          Present { value: info } =>
            if info.module_name != this_module_name
              && provider_proven_exports_symbol(name: name, provider_module: info.module_name, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
            { [name] } else { [] }
          Absent => []
        }
      }
    )
    let providers = unique_strings(items: unlisted |> flat_map(name =>
      match map_get(registry, name) {
        Present { value: info } => [info.module_name]
        Absent => []
      }
    ))
    providers |> flat_map(provider =>
      let names = unlisted |> filter(name =>
        match map_get(registry, name) {
          Present { value: info } => info.module_name == provider
          Absent => false
        }
      )
      let block = emit_specific_import_block(import_module: provider, mod_name: module_to_filename(name: provider), filtered_names: names, emit_info: emit_info, registry: registry, local_names: local_type_names, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
      let block_lines = if block == "" { [] } else { block |> split(delimiter: "\n") }
      let emitted_here = block_lines |> flat_map(l => imported_names_in_use_line(line: l))
      let fallback = names |> flat_map(nm =>
        if (emitted_here |> any(e => e == nm)) || is_known_variant(type_summaries: emit_info.type_summaries, name: nm) {
          []
        } else if provider_proven_exports_symbol(name: nm, provider_module: provider, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
          [concat(rust_visibility_prefix(), concat("use crate::", concat(module_to_filename(name: provider), concat("::", concat(emit_import_name(n: nm, registry: registry), ";")))))]
        } else {
          []
        }
      )
      concat(block_lines, fallback)
    )
  }
}

fn emit_module_full(typed_module: TypedModule, registry: Map<String, ItemInfo>, emit_info: EmitGraphInfo, shared_types: Set<String>, svc_module_map: Map<String, String>, data_items: Map<String, Node>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, module_index: ModuleIndex, unlisted_type_names: List<String>) -> TextFile {
  let m = typed_module.module
  let scope = module_emit_scope(typed_module: typed_module)
  let scoped_data_items = augment_scoped_data_item_index_with_imports(
    scoped: build_scoped_data_item_index(typed_module: typed_module, data_items: data_items),
    imports: contracts_imports_for_module(module_name: authored_name(env: scope.type_env, node: m), typed_modules: typed_modules, source_indices: scope.type_env.source_indices, module_index: module_index),
    source_indices: scope.type_env.source_indices,
    data_items: data_items
  )
  let prelude_imported_names = module_imports(n: m)
    |> flat_map(imp => import_specific_names_at(n: imp, source_indices: scope.type_env.source_indices))
  let local_type_names = concat(
    typed_module.items
      |> filter(item =>
        is_type_def_item(item: item)
        || is_type_alias_item(item: item, source_indices: scope.type_env.source_indices)
        || is_type_decl_item(item: item, source_indices: scope.type_env.source_indices)
      )
      |> map(item => authored_name(env: scope.type_env, node: item)),
    collect_phantom_zst_marker_names(items: typed_module.items, env: scope.type_env)
  )
  let prelude = emit_prelude(imported_names: prelude_imported_names, local_type_names: local_type_names)
  let imports_str = emit_imports(imports: module_imports(n: m), emit_info: emit_info, registry: registry, local_names: local_type_names, export_sets: export_sets, typed_modules: typed_modules, source_indices: scope.type_env.source_indices, module_index: module_index, supplement_items: typed_module.items)
  let dag_import_lines = if imports_str == "" { [] } else { imports_str |> split(delimiter: "\n") }
  let carrier_import_lines = if module_needs_faithful_carrier_imports(
    items: typed_module.items,
    corpus_repr: emit_info.corpus_repr,
    source_indices: scope.type_env.source_indices
  ) {
    emit_faithful_text_carrier_import_lines(
      imported_names: prelude_imported_names,
      local_type_names: local_type_names,
      items: typed_module.items,
      source_indices: scope.type_env.source_indices,
      corpus_repr: emit_info.corpus_repr,
      shared_types: shared_types,
      typed_modules: typed_modules
    )
  } else {
    []
  }
  let already_imported_names = concat(
    prelude_imported_names,
    concat(dag_import_lines, concat(carrier_import_lines, prelude |> split(delimiter: "\n"))) |> flat_map(l => imported_names_in_use_line(line: l))
  )
  let reference_use_lines = if module_imports(n: m) |> count == 0 {
    reference_derived_use_lines(
      items: typed_module.items,
      unlisted_type_names: unlisted_type_names,
      this_module_name: authored_name(env: scope.type_env, node: m),
      registry: registry,
      emit_info: emit_info,
      local_type_names: local_type_names,
      already_imported_names: already_imported_names,
      export_sets: export_sets,
      typed_modules: typed_modules,
      source_indices: scope.type_env.source_indices,
      module_index: module_index
    )
  } else if corpus_repr_is_faithful(corpus_repr: emit_info.corpus_repr) {
    reference_derived_use_lines(
      items: typed_module.items,
      unlisted_type_names: unlisted_type_names,
      this_module_name: authored_name(env: scope.type_env, node: m),
      registry: registry,
      emit_info: emit_info,
      local_type_names: local_type_names,
      already_imported_names: already_imported_names,
      export_sets: export_sets,
      typed_modules: typed_modules,
      source_indices: scope.type_env.source_indices,
      module_index: module_index
    )
  } else {
    []
  }
  let merged_imports = dedupe_rust_import_lines(lines: concat(concat(dag_import_lines, carrier_import_lines), reference_use_lines)) |> join(separator: "\n")
  let imports_section = if merged_imports == "" { "" } else { concat("\n", merged_imports) }
  let this_mod_filename = module_to_filename(name: authored_name(env: scope.type_env, node: m))
  let all_svc_names = typed_module.items |> flat_map(item =>
    match map_get(registry, authored_name(env: scope.type_env, node: item)) {
      Present { value: info } => info.service_names
      Absent => []
    }
  )
  let extern_svc_imports = unique_strings(items: all_svc_names) |> flat_map(sn =>
    match map_get(svc_module_map, sn) {
      Present { value: mod_file } =>
        if mod_file == this_mod_filename { [] }
        else { [concat(rust_visibility_prefix(), "use crate::", mod_file, "::", sanitize_service_name(name: sn), ";")] }
      Absent => []
    }
  )
  let svc_imports_str = if extern_svc_imports |> count == 0 { "" }
    else { concat("\n", extern_svc_imports |> join(separator: "\n")) }
  let local_enum_uses = typed_module.items
    |> filter(item => is_type_def_item(item: item) && is_coproduct_type(n: item)
      && !is_grounded_coproduct_native_alias(name: authored_name(env: scope.type_env, node: item)))
    |> map(item => concat("use self::", authored_name(env: scope.type_env, node: item), "::*;"))
  let local_coproduct_names = typed_module.items
    |> filter(item => is_type_def_item(item: item) && is_coproduct_type(n: item))
    |> map(item => authored_name(env: scope.type_env, node: item))
  let module_import_items = module_imports(n: m)
  let this_module_name = authored_name(env: scope.type_env, node: m)
  let wire_context_items = concat(typed_module.items, contracts_items_for_module(module_name: this_module_name, typed_modules: typed_modules, source_indices: scope.type_env.source_indices, module_index: module_index))
  let wire_context_imports = concat(module_import_items, contracts_imports_for_module(module_name: this_module_name, typed_modules: typed_modules, source_indices: scope.type_env.source_indices, module_index: module_index))
  let coproduct_wire_contract_validations = emit_coproduct_wire_contract_validations(module_items: wire_context_items, imports: wire_context_imports, local_coproduct_names: local_coproduct_names, source_indices: scope.type_env.source_indices)
  let coproduct_wire_contract_validation_section = if coproduct_wire_contract_validations == "" { "" } else { concat(coproduct_wire_contract_validations, "\n\n") }
  let local_uses_str = if local_enum_uses |> count == 0 { "" }
    else { concat("\n", local_enum_uses |> join(separator: "\n")) }
  let wire_contract_item = wire_context_items
    |> filter(i =>
      is_data_def_item(item: i)
      && authored_name_at(source_indices: scope.type_env.source_indices, node: i) == "wire_contract")
    |> first
  let items_str = typed_module.items
    |> map(item => emit_typed_item(item: item, module_name: authored_name(env: scope.type_env, node: m), registry: registry, scope: scope, shared_types: shared_types, emit_info: emit_info, wire_contract_item: wire_contract_item, data_items: scoped_data_items, module_items: wire_context_items, imports: wire_context_imports, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index))
    |> join(separator: "\n\n")
  let phantom_zst_markers = emit_module_phantom_zst_markers(items: typed_module.items, env: scope.type_env)
  let phantom_section = if phantom_zst_markers == "" { "" } else { concat("\n\n", phantom_zst_markers) }
  let raw_filename = module_to_filename(name: authored_name(env: scope.type_env, node: m))
  let filename = if raw_filename == "main" { "main_mod" } else { raw_filename }
  let module_attrs = if authored_name(env: scope.type_env, node: m) == "std.error_primitives" {
    "#![allow(non_camel_case_types)]\n\n"
  } else { "" }
  let content = concat("// Generated by v1 compiler -- do not edit.\n",
    "// Source module: ", authored_name(env: scope.type_env, node: m), "\n\n",
    module_attrs, prelude, imports_section, svc_imports_str, local_uses_str, "\n\n",
    coproduct_wire_contract_validation_section, items_str, phantom_section, "\n")
  TextFile { path: concat(rust_source_root(), filename, rust_source_ext()), content: content }
}

fn emit_import_name(n: String, registry: Map<String, ItemInfo>) -> String {
  let is_data = match map_get(registry, n) {
    Present { value: info } => info.kind == DataItem
    Absent => false
  }
  if is_data { to_snake(n) } else { n }
}

fn is_import_graph_type_name(name: String, import_module: String, typed_modules: List<TypedModule>, registry: Map<String, ItemInfo>, export_sets: Map<String, Map<String, Bool>>, type_summaries: Map<String, TypeSummary>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if has_physical_type_def_in_module_filename(rhs_name: name, mod_filename: module_to_filename(name: import_module), typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    true
  } else if match reexport_source_module_name(name: name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
    Present { value: src } => type_name_is_rust_importable_in_module(name: name, module_name: src, typed_modules: typed_modules, registry: registry, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
    Absent => false
  } {
    true
  } else if is_enum_in_summaries(type_summaries: type_summaries, type_name: name) {
    false
  } else if is_known_variant(type_summaries: type_summaries, name: name) {
    false
  } else {
    match map_get(export_sets, import_module) {
      Present { value: exported } =>
        if map_get(exported, name) == Present { value: true } {
          type_name_is_rust_importable_in_module(name: name, module_name: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
        } else { false }
      Absent => false
    }
  }
}

fn item_defining_module_filename(name: String, registry: Map<String, ItemInfo>, fallback: String) -> String {
  match lookup_item(registry: registry, name: name) {
    Present { value: info } => module_to_filename(name: info.module_name)
    Absent => fallback
  }
}

type ModuleIndex {
  by_name: Map<String, TypedModule>
  by_filename: Map<String, List<TypedModule>>
}

fn build_module_index(modules: List<TypedModule>) -> ModuleIndex {
  let by_name = modules |> fold(init: empty_map(), f: (acc, tm) =>
    let nm = authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module)
    match map_get(acc, nm) {
      Present { value: _ } => acc
      Absent => map_insert(acc, nm, tm)
    }
  )
  let by_filename = modules |> fold(init: empty_map(), f: (acc, tm) =>
    let fname = module_to_filename(name: authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module))
    match map_get(acc, fname) {
      Present { value: prior } => map_insert(acc, fname, list_push(prior, tm))
      Absent => map_insert(acc, fname, [tm])
    }
  )
  ModuleIndex { by_name: by_name, by_filename: by_filename }
}

fn typed_module_by_name(module_name: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> TypedModule? {
  map_get(module_index.by_name, module_name)
}

fn contracts_items_for_module(module_name: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> List<Node> {
  match typed_module_by_name(module_name: concat(module_name, "_contracts"), typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: tm } => tm.items
    Absent => []
  }
}

fn contracts_imports_for_module(module_name: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> List<Node> {
  match typed_module_by_name(module_name: concat(module_name, "_contracts"), typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: tm } => module_imports(n: tm.module)
    Absent => []
  }
}

fn module_name_from_filename(mod_filename: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> String? {
  match map_get(module_index.by_filename, mod_filename) {
    Present { value: mods } => mods |> map(tm => authored_name_at(source_indices: source_indices, node: tm.module)) |> first
    Absent => none
  }
}

fn has_physical_type_def_in_module_filename(rhs_name: String, mod_filename: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match map_get(module_index.by_filename, mod_filename) {
    Present { value: mods } => mods |> any(tm =>
      tm.items |> any(item =>
        authored_name_at(source_indices: source_indices, node: item) == rhs_name
        && (is_type_def_item(item: item)
          || is_type_alias_item(item: item, source_indices: source_indices)
          || is_type_decl_item(item: item, source_indices: source_indices))
      )
    )
    Absent => false
  }
}

fn find_variant_parent_in_module(variant_name: String, module_name: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> String? {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => Absent
    Present { value: tm } =>
      tm.items
        |> filter(item => is_type_def_item(item: item) && is_coproduct_type(n: item))
        |> filter(item =>
          item.children |> any(child =>
            authored_name_at(source_indices: source_indices, node: child) == variant_name
          )
        )
        |> map(item => authored_name_at(source_indices: source_indices, node: item))
        |> first
  }
}

fn type_name_is_export_source_in_module(name: String, module_name: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => false
    Present { value: tm } =>
      tm.items |> any(item =>
        authored_name_at(source_indices: source_indices, node: item) == name
        && (is_type_def_item(item: item)
          || is_type_alias_item(item: item, source_indices: source_indices)
          || is_type_decl_item(item: item, source_indices: source_indices))
      )
  }
}

fn type_name_is_rust_importable_in_module(name: String, module_name: String, typed_modules: List<TypedModule>, registry: Map<String, ItemInfo>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => false
    Present { value: tm } =>
      match tm.items
        |> filter(item =>
          authored_name_at(source_indices: source_indices, node: item) == name
          && (is_type_def_item(item: item)
            || is_type_alias_item(item: item, source_indices: source_indices)
            || is_type_decl_item(item: item, source_indices: source_indices))
        )
        |> first {
        Absent => false
        Present { value: item } =>
          type_item_has_rust_nominal_shell_authority(
            item: item,
            item_text: name,
            module_name: module_name,
            imports: module_imports(n: tm.module),
            scope: module_emit_scope(typed_module: tm),
            registry: registry,
            export_sets: export_sets,
            typed_modules: typed_modules,
            source_indices: source_indices,
          module_index: module_index)
      }
  }
}

fn imported_name_is_non_emittable_type(name: String, import_module: String, typed_modules: List<TypedModule>, registry: Map<String, ItemInfo>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  let defining_module = match reexport_source_module_name(name: name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
    Present { value: src } => src
    Absent => import_module
  }
  type_name_is_export_source_in_module(name: name, module_name: defining_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
  && type_name_is_rust_importable_in_module(name: name, module_name: defining_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, source_indices: source_indices, module_index: module_index) == false
}

fn name_in_transitive_export_surface(name: String, module_name: String, visited: List<String>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if visited |> any(v => v == module_name) {
    false
  } else {
    let in_local = match map_get(export_sets, module_name) {
      Present { value: exported } => map_get(exported, name) == Present { value: true }
      Absent => false
    }
    if in_local {
      true
    } else {
      match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
        Absent => false
        Present { value: tm } =>
          module_imports(n: tm.module)
            |> filter(imp => import_is_all(n: imp))
            |> any(imp =>
              name_in_transitive_export_surface(
                name: name,
                module_name: authored_name_at(source_indices: source_indices, node: imp),
                visited: concat(visited, [module_name]),
                export_sets: export_sets,
                typed_modules: typed_modules,
                source_indices: source_indices,
              module_index: module_index)
            )
      }
    }
  }
}

fn reexport_source_module_name(name: String, import_module: String, typed_modules: List<TypedModule>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> String? {
  reexport_source_module_name_with_visited(name: name, import_module: import_module, visited: [], typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
}

fn reexport_source_module_name_with_visited(name: String, import_module: String, visited: List<String>, typed_modules: List<TypedModule>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> String? {
  if visited |> any(v => v == import_module) {
    Absent
  } else {
    match typed_module_by_name(module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
      Absent => Absent
      Present { value: tm } =>
        if type_name_is_export_source_in_module(name: name, module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
          Present { value: import_module }
        } else {
          match find_variant_parent_in_module(
            variant_name: name,
            module_name: import_module,
            typed_modules: typed_modules,
            source_indices: source_indices,
          module_index: module_index) {
            Present { value: _parent } => Present { value: import_module }
            Absent =>
          match module_imports(n: tm.module) |> filter(imp =>
            import_is_all(n: imp) == false
            && import_specific_names_at(n: imp, source_indices: source_indices) |> any(n => n == name)
          ) |> map(imp => authored_name_at(source_indices: source_indices, node: imp)) |> first {
            Present { value: src } =>
              reexport_source_module_name_with_visited(
                name: name,
                import_module: src,
                visited: concat(visited, [import_module]),
                typed_modules: typed_modules,
                export_sets: export_sets,
                source_indices: source_indices,
              module_index: module_index)
            Absent =>
              match module_imports(n: tm.module) |> filter(imp => import_is_all(n: imp)) |> filter(imp =>
                let src_mod = authored_name_at(source_indices: source_indices, node: imp)
                name_in_transitive_export_surface(name: name, module_name: src_mod, visited: concat(visited, [import_module]), export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
              ) |> map(imp => authored_name_at(source_indices: source_indices, node: imp)) |> first {
                Present { value: src } =>
                  reexport_source_module_name_with_visited(
                    name: name,
                    import_module: src,
                    visited: concat(visited, [import_module]),
                    typed_modules: typed_modules,
                    export_sets: export_sets,
                    source_indices: source_indices,
                  module_index: module_index)
                Absent => Absent
              }
          }
          }
        }
    }
  }
}

fn import_module_enum_scope(import_module: String, registry: Map<String, ItemInfo>, type_summaries: Map<String, TypeSummary>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> List<String> {
  let physical = enum_names_in_module(module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
  let reexport_parents = match map_get(export_sets, import_module) {
    Present { value: exported } =>
      sorted_map_keys(exported) |> filter(n =>
        is_known_variant(type_summaries: type_summaries, name: n)
        && is_enum_in_summaries(type_summaries: type_summaries, type_name: n) == false
      ) |> map(n =>
        match reexport_variant_parent_in_import_module(
          variant_name: n,
          import_module: import_module,
          registry: registry,
          type_summaries: type_summaries,
          typed_modules: typed_modules,
          export_sets: export_sets,
          source_indices: source_indices,
        module_index: module_index) {
          Present { value: parent } => parent
          Absent => ""
        }
      ) |> filter(p => p != "")
    Absent => []
  }
  unique_strings(items: concat(physical, reexport_parents))
}

fn enum_names_in_module(module_name: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> List<String> {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => []
    Present { value: tm } =>
      tm.items
        |> filter(item => is_type_def_item(item: item) && is_coproduct_type(n: item))
        |> map(item => authored_name_at(source_indices: source_indices, node: item))
  }
}

fn enum_physically_defined_in_module(enum_name: String, module_name: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => false
    Present { value: tm } =>
      tm.items |> any(item =>
        authored_name_at(source_indices: source_indices, node: item) == enum_name
        && is_type_def_item(item: item)
        && is_coproduct_type(n: item)
      )
  }
}

fn wildcard_import_pool_surface_names(module_name: String, visited: List<String>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> List<String> {
  if visited |> any(v => v == module_name) {
    []
  } else {
    match typed_module_by_name(module_name: module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
      Absent => []
      Present { value: tm } =>
        module_imports(n: tm.module)
          |> filter(imp => import_is_all(n: imp))
          |> flat_map(imp =>
            let src_mod = authored_name_at(source_indices: source_indices, node: imp)
            let direct = match map_get(export_sets, src_mod) {
              Present { value: exported } => sorted_map_keys(exported)
              Absent => []
            }
            concat(
              direct,
              wildcard_import_pool_surface_names(
                module_name: src_mod,
                visited: concat(visited, [module_name]),
                export_sets: export_sets,
                typed_modules: typed_modules,
                source_indices: source_indices,
              module_index: module_index)
            )
          )
    }
  }
}

fn wildcard_reexport_surface_names(import_module: String, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> List<String> {
  let local_candidates = match map_get(export_sets, import_module) {
    Present { value: exported } => sorted_map_keys(exported)
    Absent => []
  }
  let wildcard_pool_candidates = wildcard_import_pool_surface_names(
    module_name: import_module,
    visited: [],
    export_sets: export_sets,
    typed_modules: typed_modules,
    source_indices: source_indices,
  module_index: module_index)
  unique_strings(items: concat(local_candidates, wildcard_pool_candidates) |> filter(n =>
    match reexport_source_module_name(name: n, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
      Present { value: src } => src != import_module
      Absent => false
    }
  ))
}

fn graph_type_import_module_filename(name: String, import_module: String, mod_name: String, typed_modules: List<TypedModule>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> String {
  if has_physical_type_def_in_module_filename(rhs_name: name, mod_filename: mod_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    mod_name
  } else {
    match reexport_source_module_name(name: name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
      Present { value: src } => module_to_filename(name: src)
      Absent => mod_name
    }
  }
}

fn variant_defining_module_filename_for_import(variant_name: String, import_module: String, typed_modules: List<TypedModule>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, fallback: String, module_index: ModuleIndex) -> String {
  match find_variant_parent_in_module(
    variant_name: variant_name,
    module_name: import_module,
    typed_modules: typed_modules,
    source_indices: source_indices,
  module_index: module_index) {
    Present { value: _parent } => module_to_filename(name: import_module)
    Absent =>
      match explicit_import_source_module_for_name(name: variant_name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
        Present { value: hop } =>
          if hop != import_module {
            variant_defining_module_filename_for_import(
              variant_name: variant_name,
              import_module: hop,
              typed_modules: typed_modules,
              export_sets: export_sets,
              source_indices: source_indices,
              fallback: fallback,
            module_index: module_index)
          } else { fallback }
        Absent => fallback
      }
  }
}

fn variant_parent_defining_module_filename(parent_enum: String, variant_name: String, import_module: String, typed_modules: List<TypedModule>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, registry: Map<String, ItemInfo>, fallback: String, module_index: ModuleIndex) -> String {
  match find_variant_parent_in_module(
    variant_name: variant_name,
    module_name: import_module,
    typed_modules: typed_modules,
    source_indices: source_indices,
  module_index: module_index) {
    Present { value: local_parent } =>
      if local_parent == parent_enum {
        module_to_filename(name: import_module)
      } else {
        variant_defining_module_filename_for_import(
          variant_name: variant_name,
          import_module: import_module,
          typed_modules: typed_modules,
          export_sets: export_sets,
          source_indices: source_indices,
          fallback: item_defining_module_filename(name: parent_enum, registry: registry, fallback: fallback),
        module_index: module_index)
      }
    Absent =>
      variant_defining_module_filename_for_import(
        variant_name: variant_name,
        import_module: import_module,
        typed_modules: typed_modules,
        export_sets: export_sets,
        source_indices: source_indices,
        fallback: item_defining_module_filename(name: parent_enum, registry: registry, fallback: fallback),
      module_index: module_index)
  }
}

fn explicit_import_source_module_for_name(name: String, import_module: String, typed_modules: List<TypedModule>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> String? {
  match typed_module_by_name(module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Absent => Absent
    Present { value: tm } =>
      match module_imports(n: tm.module) |> filter(imp =>
        import_is_all(n: imp) == false
        && import_specific_names_at(n: imp, source_indices: source_indices) |> any(n => n == name)
      ) |> map(imp => authored_name_at(source_indices: source_indices, node: imp)) |> first {
        Present { value: src } => Present { value: src }
        Absent =>
          match module_imports(n: tm.module) |> filter(imp => import_is_all(n: imp)) |> filter(imp =>
            let src_mod = authored_name_at(source_indices: source_indices, node: imp)
            match map_get(export_sets, src_mod) {
              Present { value: exported } => map_get(exported, name) == Present { value: true }
              Absent => false
            }
          ) |> map(imp => authored_name_at(source_indices: source_indices, node: imp)) |> first {
            Present { value: src } => Present { value: src }
            Absent => Absent
          }
      }
  }
}

fn reexport_variant_parent_in_import_module(variant_name: String, import_module: String, registry: Map<String, ItemInfo>, type_summaries: Map<String, TypeSummary>, typed_modules: List<TypedModule>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> String? {
  match reexport_source_module_name(name: variant_name, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
    Absent => Absent
    Present { value: src_mod } =>
      match find_variant_parent_in_module(
        variant_name: variant_name,
        module_name: src_mod,
        typed_modules: typed_modules,
        source_indices: source_indices,
      module_index: module_index) {
        Present { value: parent } => Present { value: parent }
        Absent =>
          match explicit_import_source_module_for_name(name: variant_name, import_module: src_mod, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
            Present { value: hop } =>
              if hop != src_mod {
                reexport_variant_parent_in_import_module(
                  variant_name: variant_name,
                  import_module: hop,
                  registry: registry,
                  type_summaries: type_summaries,
                  typed_modules: typed_modules,
                  export_sets: export_sets,
                  source_indices: source_indices,
                module_index: module_index)
              } else { none }
            Absent => none
          }
      }
  }
}

fn alias_rhs_rust_qualify_module_filename(name: String, alias_module: String, imports: List<Node>, scope: InferScope, registry: Map<String, ItemInfo>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> String {
  let spell_mod = alias_rhs_base_module_filename(name: name, alias_module: alias_module, imports: imports, source_indices: source_indices, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
  if has_physical_type_def_in_module_filename(rhs_name: name, mod_filename: spell_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    spell_mod
  } else {
    match module_name_from_filename(mod_filename: spell_mod, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
      Present { value: mod_name } =>
        match reexport_source_module_name(name: name, import_module: mod_name, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
          Present { value: src } => module_to_filename(name: src)
          Absent => spell_mod
        }
      Absent => spell_mod
    }
  }
}

fn alias_rhs_base_module_filename(name: String, alias_module: String, imports: List<Node>, source_indices: Map<String, NewlineIndex>, scope: InferScope, registry: Map<String, ItemInfo>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, module_index: ModuleIndex) -> String {
  let local_mod = module_to_filename(name: alias_module)
  match lookup_item(registry: scope.item_registry, name: name) {
    Present { value: info } =>
      if info.module_name == alias_module && (info.kind == TypeItem || info.kind == OtherItem) {
        local_mod
      } else {
        alias_rhs_base_module_from_import_or_registry(name: name, imports: imports, source_indices: source_indices, registry: registry, local_mod: local_mod, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
      }
    Absent =>
      alias_rhs_base_module_from_import_or_registry(name: name, imports: imports, source_indices: source_indices, registry: registry, local_mod: local_mod, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
  }
}

fn alias_rhs_base_module_from_import_or_registry(name: String, imports: List<Node>, source_indices: Map<String, NewlineIndex>, registry: Map<String, ItemInfo>, local_mod: String, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, module_index: ModuleIndex) -> String {
  match imports |> filter(imp =>
    import_specific_names_at(n: imp, source_indices: source_indices) |> any(n => n == name)
  ) |> map(imp => authored_name_at(source_indices: source_indices, node: imp)) |> first {
    Present { value: import_module } => module_to_filename(name: import_module)
    Absent =>
      match imports |> filter(imp => import_is_all(n: imp)) |> filter(imp =>
        let import_module = authored_name_at(source_indices: source_indices, node: imp)
        name_in_transitive_export_surface(name: name, module_name: import_module, visited: [], export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
      ) |> map(imp => authored_name_at(source_indices: source_indices, node: imp)) |> first {
        Present { value: import_module } => module_to_filename(name: import_module)
        Absent => item_defining_module_filename(name: name, registry: registry, fallback: local_mod)
      }
  }
}

fn item_generic_param_names(item: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  item.params |> map(p => generic_param_name_at(n: p, source_indices: source_indices))
}

fn type_item_by_name_in_module_filename(rhs_name: String, mod_filename: String, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Node? {
  match module_name_from_filename(mod_filename: mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: mod_name } =>
      match typed_module_by_name(module_name: mod_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
        Present { value: tm } =>
          tm.items |> filter(item =>
            authored_name_at(source_indices: source_indices, node: item) == rhs_name
            && (is_type_def_item(item: item)
              || is_type_alias_item(item: item, source_indices: source_indices)
              || is_type_decl_item(item: item, source_indices: source_indices))
          ) |> first
        Absent => none
      }
    Absent => none
  }
}

fn type_item_has_rust_nominal_shell_authority(item: Node, item_text: String, module_name: String, imports: List<Node>, scope: InferScope, registry: Map<String, ItemInfo>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if is_type_def_item(item: item) {
    true
  } else if is_type_alias_item(item: item, source_indices: source_indices) {
    true
  } else if is_type_decl_item(item: item, source_indices: source_indices) {
    if (item.params |> count) == 0 && (rust_nominal_identity_carrier_type_eligible(type_name: item_text) || rust_opaque_kernel_alias_type_eligible(name: item_text)) {
      true
    } else if (item.params |> count) > 0 {
      if is_parametric_opaque_type_decl_item(item: item, source_indices: source_indices) {
        true
      } else {
      let rhs = resolved_type(n: item)
      if is_type_alias_return_node(n: rhs, source_indices: source_indices) && (rhs.children |> count) > 0 {
        alias_rhs_nominal_shell_has_rust_authority(
          n: rhs,
          module_name: module_name,
          imports: imports,
          scope: scope,
          registry: registry,
          export_sets: export_sets,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index)
      } else if is_type_alias_return_node(n: rhs, source_indices: source_indices) {
        let rhs_name = authored_name_at(source_indices: source_indices, node: rhs)
        (rhs_name != item_text)
          && rhs_name != ""
          && alias_rhs_nominal_shell_has_rust_authority(
            n: rhs,
            module_name: module_name,
            imports: imports,
            scope: scope,
            registry: registry,
            export_sets: export_sets,
            typed_modules: typed_modules,
            source_indices: source_indices,
            module_index: module_index)
      } else {
        false
      }
      }
    } else {
      false
    }
  } else {
    false
  }
}

fn is_phantom_unit_variant_type_arg(env: TypeEnv, variant_name: String) -> Bool {
  match lookup_unit_variant_phantom_type(env: env, variant_name: variant_name) {
    Present { value: _ } => true
    Absent => false
  }
}

fn rhs_base_has_rust_type_authority_in_module(rhs_name: String, def_mod_filename: String, module_name: String, imports: List<Node>, scope: InferScope, registry: Map<String, ItemInfo>, typed_modules: List<TypedModule>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if is_phantom_unit_variant_type_arg(env: scope.type_env, variant_name: rhs_name) {
    true
  } else {
  match type_item_by_name_in_module_filename(rhs_name: rhs_name, mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
    Present { value: item } =>
      match module_name_from_filename(mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
        Present { value: def_module_name } =>
          match typed_module_by_name(module_name: def_module_name, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
            Present { value: tm } =>
              type_item_has_rust_nominal_shell_authority(
                item: item,
                item_text: rhs_name,
                module_name: def_module_name,
                imports: module_imports(n: tm.module),
                scope: module_emit_scope(typed_module: tm),
                registry: registry,
                export_sets: export_sets,
                typed_modules: typed_modules,
                source_indices: source_indices,
              module_index: module_index)
            Absent => false
          }
        Absent => false
      }
    Absent =>
      match module_name_from_filename(mod_filename: def_mod_filename, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
        Present { value: mod_name } =>
          match map_get(export_sets, mod_name) {
            Present { value: exported } =>
              if map_get(exported, rhs_name) == Present { value: true } {
                match reexport_source_module_name(name: rhs_name, import_module: mod_name, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
                  Present { value: src } =>
                    rhs_base_has_rust_type_authority_in_module(
                      rhs_name: rhs_name,
                      def_mod_filename: module_to_filename(name: src),
                      module_name: module_name,
                      imports: imports,
                      scope: scope,
                      registry: registry,
                      typed_modules: typed_modules,
                      export_sets: export_sets,
                      source_indices: source_indices,
                    module_index: module_index)
                  Absent => false
                }
              } else { false }
            Absent => false
          }
        Absent => false
      }
  }
  }
}

fn alias_rhs_nominal_shell_has_rust_authority(n: Node, module_name: String, imports: List<Node>, scope: InferScope, registry: Map<String, ItemInfo>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> Bool {
  if n.connective == NoConnective && n.children |> count > 0 {
    let name = authored_name_at(source_indices: source_indices, node: n)
    let def_mod = alias_rhs_base_module_filename(name: name, alias_module: module_name, imports: imports, source_indices: source_indices, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
    rhs_base_has_rust_type_authority_in_module(rhs_name: name, def_mod_filename: def_mod, module_name: module_name, imports: imports, scope: scope, registry: registry, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
      && n.children |> all(child =>
        alias_rhs_nominal_shell_has_rust_authority(
          n: child,
          module_name: module_name,
          imports: imports,
          scope: scope,
          registry: registry,
          export_sets: export_sets,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index)
      )
  } else if n.connective == NoConnective && n.children |> count == 0 {
    if n.inferred != none && is_type_variable(inferred: n.inferred.value) {
      true
    } else {
      let name = authored_name_at(source_indices: source_indices, node: n)
      if name == "" || is_kernel_type(name: name) {
        true
      } else if is_phantom_unit_variant_type_arg(env: scope.type_env, variant_name: name) {
        true
      } else {
        let def_mod = alias_rhs_base_module_filename(name: name, alias_module: module_name, imports: imports, source_indices: source_indices, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index)
        rhs_base_has_rust_type_authority_in_module(rhs_name: name, def_mod_filename: def_mod, module_name: module_name, imports: imports, scope: scope, registry: registry, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
      }
    }
  } else {
    true
  }
}

fn is_self_referential_opaque_type_resolved(item: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let item_text = authored_name_at(source_indices: source_indices, node: item)
  let rhs = resolved_type(n: item)
  is_type_alias_return_node(n: rhs, source_indices: source_indices)
    && authored_name_at(source_indices: source_indices, node: rhs) == item_text
}

fn is_zero_param_self_referential_opaque_decl(item: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  is_bare_leaf_item(item: item)
    && is_self_referential_opaque_type_resolved(item: item, source_indices: source_indices)
}

fn is_parametric_opaque_type_decl_item(item: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  (item.params |> count) > 0
    && item.body == none
    && item.transport == none
    && (item.children |> count) == 0
    && (
      !is_type_alias_return_node(n: resolved_type(n: item), source_indices: source_indices)
      || is_self_referential_opaque_type_resolved(item: item, source_indices: source_indices)
    )
}

fn emit_zero_param_phantom_opaque_struct(item: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let item_text = authored_name_at(source_indices: source_indices, node: item)
  concat(
    "#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]\n",
    rust_visibility_prefix(),
    rust_items().struct_keyword, " ", item_text, "(pub std::marker::PhantomData<()>);"
  )
}

fn emit_parametric_phantom_opaque_struct(item: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let item_text = authored_name_at(source_indices: source_indices, node: item)
  let type_params = emit_type_params(params: item.params, source_indices: source_indices)
  let generic_names = item_generic_param_names(item: item, source_indices: source_indices)
  let marker_ty = match generic_names |> first {
    Present { value: g } => concat("std::marker::PhantomData<", to_pascal(name: g), ">")
    Absent => "std::marker::PhantomData<()>"
  }
  concat(
    "#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]\n",
    rust_visibility_prefix(),
    rust_items().struct_keyword, " ", item_text, type_params, "(pub ", marker_ty, ");"
  )
}

fn is_emittable_parametric_type_alias_item(item: Node, item_text: String, source_indices: Map<String, NewlineIndex>, module_name: String, imports: List<Node>, scope: InferScope, registry: Map<String, ItemInfo>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, module_index: ModuleIndex) -> Bool {
  if (item.params |> count) == 0 {
    false
  } else {
    let rhs = resolved_type(n: item)
    if rhs.inferred != none && is_compiler_error(inferred: rhs.inferred.value) {
      false
    } else if !is_type_alias_return_node(n: rhs, source_indices: source_indices) {
      false
    } else {
      let rhs_name = authored_name_at(source_indices: source_indices, node: rhs)
      (rhs_name != item_text)
        && (
          (rhs.children |> count) > 0
          || (
            (rhs.children |> count) == 0
            && rhs_name != ""
            && alias_rhs_nominal_shell_has_rust_authority(
              n: rhs,
              module_name: module_name,
              imports: imports,
              scope: scope,
              registry: registry,
              export_sets: export_sets,
              typed_modules: typed_modules,
              source_indices: source_indices,
              module_index: module_index)
          )
        )
    }
  }
}

fn import_variant_parent_for_name(n: String, import_module: String, registry: Map<String, ItemInfo>, type_summaries: Map<String, TypeSummary>, typed_modules: List<TypedModule>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex, imported_enums: List<String>, import_module_enums: List<String>) -> String {
  if is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index) {
    ""
  } else if import_module_enums |> any(e => e == n) {
    ""
  } else {
    match find_variant_parent_in_module(
      variant_name: n,
      module_name: import_module,
      typed_modules: typed_modules,
      source_indices: source_indices,
    module_index: module_index) {
      Present { value: parent } => parent
      Absent =>
        match reexport_variant_parent_in_import_module(
          variant_name: n,
          import_module: import_module,
          registry: registry,
          type_summaries: type_summaries,
          typed_modules: typed_modules,
          export_sets: export_sets,
          source_indices: source_indices,
        module_index: module_index) {
          Present { value: parent } => parent
          Absent =>
            match find_variant_parent(type_summaries: type_summaries, variant_name: n, scope_enums: imported_enums) {
              Present { value: parent } => parent
              Absent =>
                match find_variant_parent(type_summaries: type_summaries, variant_name: n, scope_enums: import_module_enums) {
                  Present { value: parent } => parent
                  Absent => ""
                }
            }
        }
    }
  }
}

fn emit_specific_import_block(import_module: String, mod_name: String, filtered_names: List<String>, emit_info: EmitGraphInfo, registry: Map<String, ItemInfo>, local_names: List<String>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> String {
  let type_summaries = emit_info.type_summaries
  let deduped_names = unique_strings(items: filtered_names |> filter(n => local_names |> all(ln => ln != n)))
  if deduped_names |> count == 0 {
    ""
  } else {
    let import_module_enums = import_module_enum_scope(import_module: import_module, registry: registry, type_summaries: type_summaries, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
    let top_level = deduped_names |> filter(n =>
      if is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index) {
        true
      } else if is_known_variant(type_summaries: type_summaries, name: n) {
        import_module_enums |> any(e => e == n)
      } else if imported_name_is_non_emittable_type(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
        false
      } else if is_kernel_type(name: n) {
        false
      } else { true }
    )
    let imported_enums = deduped_names |> filter(n => import_module_enums |> any(e => e == n))
    let all_parents = deduped_names |> map(n =>
      import_variant_parent_for_name(n: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index, imported_enums: imported_enums, import_module_enums: import_module_enums)
    ) |> filter(p => p != "")
    let parent_list = unique_strings(items: all_parents)
    let non_variant_top = top_level |> filter(n =>
      if import_variant_parent_for_name(n: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index, imported_enums: imported_enums, import_module_enums: import_module_enums) != "" {
        false
      } else if is_known_variant(type_summaries: type_summaries, name: n) {
        import_module_enums |> any(e => e == n)
      } else { true }
    )
    let direct_names = unique_strings(items: non_variant_top)

    let local_parent_names = parent_list |> filter(p =>
      deduped_names |> any(n =>
        match find_variant_parent_in_module(
          variant_name: n,
          module_name: import_module,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index) {
          Present { value: found } => found == p
          Absent => false
        }
      )
    )
    let remote_parent_list = parent_list |> filter(p =>
      direct_names |> all(n => n != p)
    ) |> filter(p =>
      deduped_names |> any(n =>
        match find_variant_parent_in_module(
          variant_name: n,
          module_name: import_module,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index) {
          Present { value: found } => found == p
          Absent => false
        }
      ) == false
    )
    let merged_direct_names = unique_strings(items: concat(direct_names, local_parent_names))
    let type_direct_names = merged_direct_names |> filter(n =>
      is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index)
    )
    let other_direct_names = merged_direct_names |> filter(n =>
      is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index) == false
    )
    let type_direct_mods = unique_strings(items: type_direct_names |> map(n =>
      graph_type_import_module_filename(name: n, import_module: import_module, mod_name: mod_name, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index)
    ))
    let type_direct_lines = type_direct_mods |> map(def_mod =>
      let group = type_direct_names |> filter(n =>
        graph_type_import_module_filename(name: n, import_module: import_module, mod_name: mod_name, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) == def_mod
      )
      if group |> count > 0 {
        let names_str = group |> map(n =>
          emit_import_name(n: n, registry: registry)
        ) |> join(separator: ", ")
        concat(rust_visibility_prefix(), "use crate::", def_mod, "::{", names_str, "};")
      } else { "" }
    )
    let other_direct_line = if other_direct_names |> count > 0 {
      let names_str = other_direct_names |> map(n =>
        emit_import_name(n: n, registry: registry)
      ) |> join(separator: ", ")
      concat(rust_visibility_prefix(), "use crate::", mod_name, "::{", names_str, "};")
    } else { "" }
    let direct_lines = concat(type_direct_lines |> filter(l => l != ""), if other_direct_line != "" { [other_direct_line] } else { [] })
    let parent_defining_mods = unique_strings(items: remote_parent_list |> map(p =>
      let rep_variant = deduped_names |> filter(n =>
        match find_variant_parent_in_module(variant_name: n, module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
          Present { value: found } => found == p
          Absent =>
            match reexport_variant_parent_in_import_module(variant_name: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
              Present { value: found } => found == p
              Absent => false
            }
        }
      ) |> first
      match rep_variant {
        Present { value: v } => variant_parent_defining_module_filename(parent_enum: p, variant_name: v, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, registry: registry, fallback: mod_name, module_index: module_index)
        Absent => item_defining_module_filename(name: p, registry: registry, fallback: mod_name)
      }
    ))
    let parent_main_lines = parent_defining_mods |> map(def_mod =>
      let group = remote_parent_list |> filter(p =>
        let rep_variant = deduped_names |> filter(n =>
          match find_variant_parent_in_module(variant_name: n, module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
            Present { value: found } => found == p
            Absent =>
              match reexport_variant_parent_in_import_module(variant_name: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
                Present { value: found } => found == p
                Absent => false
              }
          }
        ) |> first
        match rep_variant {
          Present { value: v } => variant_parent_defining_module_filename(parent_enum: p, variant_name: v, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, registry: registry, fallback: mod_name, module_index: module_index) == def_mod
          Absent => item_defining_module_filename(name: p, registry: registry, fallback: mod_name) == def_mod
        }
      )
      if group |> count > 0 {
        let names_str = group |> join(separator: ", ")
        concat(rust_visibility_prefix(), "use crate::", def_mod, "::{", names_str, "};")
      } else { "" }
    )
    let main_lines = if direct_lines |> count > 0 {
      concat(direct_lines, parent_main_lines |> filter(l => l != ""))
    } else {
      parent_main_lines |> filter(l => l != "")
    }
    let variant_lines = parent_list |> map(parent =>
      if is_grounded_coproduct_native_alias(name: parent) { "" } else {
      let variants = deduped_names |> filter(n =>
        if n == "None" || n == "Some" {
          false
        } else if is_import_graph_type_name(name: n, import_module: import_module, typed_modules: typed_modules, registry: registry, export_sets: export_sets, type_summaries: type_summaries, source_indices: source_indices, module_index: module_index) {
          false
        } else if import_module_enums |> any(e => e == n) {
          false
        } else {
          match find_variant_parent_in_module(variant_name: n, module_name: import_module, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index) {
            Present { value: found } => found == parent
            Absent =>
              match reexport_variant_parent_in_import_module(variant_name: n, import_module: import_module, registry: registry, type_summaries: type_summaries, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, module_index: module_index) {
                Present { value: found } => found == parent
                Absent =>
                  match find_variant_parent(type_summaries: type_summaries, variant_name: n, scope_enums: [parent]) {
                    Present { value: _ } => true
                    Absent => false
                  }
              }
          }
        }
      )
      let parent_mod = match variants |> first {
        Present { value: v } => variant_parent_defining_module_filename(parent_enum: parent, variant_name: v, import_module: import_module, typed_modules: typed_modules, export_sets: export_sets, source_indices: source_indices, registry: registry, fallback: mod_name, module_index: module_index)
        Absent => item_defining_module_filename(name: parent, registry: registry, fallback: mod_name)
      }
      let vars_str = variants |> join(separator: ", ")
      concat("use crate::", parent_mod, "::", parent, "::{", vars_str, "};")
      }
    )
    let final_imported_enums = top_level |> filter(n => import_module_enums |> any(e => e == n))
    let wildcard_enum_lines = final_imported_enums
      |> filter(en => parent_list |> any(p => p == en) == false
        && !is_grounded_coproduct_native_alias(name: en))
      |> map(en => concat("use crate::", mod_name, "::", en, "::*;"))
    let all_lines = concat(
      main_lines |> filter(l => l != ""),
      variant_lines |> filter(l => l != ""),
      wildcard_enum_lines
    )
    all_lines |> join(separator: "\n")
  }
}

fn rust_use_crate_marker(line: String) -> String {
  if contains(line, "pub use crate::") {
    "pub use crate::"
  } else if contains(line, "use crate::") {
    "use crate::"
  } else {
    ""
  }
}

fn rust_use_after_crate(line: String) -> String {
  let marker = rust_use_crate_marker(line: line)
  if marker == "" {
    ""
  } else {
    match line |> split(delimiter: marker) |> skip(1) |> first {
      Present { value: rest } => rest
      Absent => ""
    }
  }
}

fn rust_pub_use_module_name(line: String) -> String {
  let rest = rust_use_after_crate(line: line)
  if rest == "" {
    ""
  } else if contains(rest, "::{") {
    match rest |> split(delimiter: "::{") |> first {
      Present { value: path } => path
      Absent => ""
    }
  } else if contains(rest, "::*") {
    match rest |> split(delimiter: "::*") |> first {
      Present { value: path } => path
      Absent => ""
    }
  } else {
    match rest |> split(delimiter: ";") |> first {
      Present { value: without_semi } =>
        let segments = without_semi |> split(delimiter: "::")
        let seg_count = segments |> count
        if seg_count <= 1 {
          ""
        } else {
          segments |> fold(init: { idx: 0, path: "" }, f: (acc, seg) =>
            if acc.idx < seg_count - 1 {
              let next = if acc.path == "" { seg } else { concat(acc.path, "::", seg) }
              { idx: acc.idx + 1, path: next }
            } else { acc }
          ).path
        }
      Absent => ""
    }
  }
}

fn rust_pub_use_singleton_name(line: String) -> String {
  let rest = rust_use_after_crate(line: line)
  if rest == "" || contains(rest, "::{") || contains(rest, "::*") {
    ""
  } else {
    match rest |> split(delimiter: ";") |> first {
      Present { value: without_semi } =>
        let segments = without_semi |> split(delimiter: "::")
        match segments |> last {
          Present { value: name } => name
          Absent => ""
        }
      Absent => ""
    }
  }
}

fn rust_pub_use_braced_names(line: String) -> List<String> {
  if contains(line, "::{") && rust_use_crate_marker(line: line) != "" {
    match line |> split(delimiter: "::{") |> skip(1) |> first {
      Present { value: rest } =>
        match rest |> split(delimiter: "}") |> first {
          Present { value: names } => names |> split(delimiter: ", ")
          Absent => []
        }
      Absent => []
    }
  } else {
    []
  }
}

fn rust_pub_use_braced_line_has_name(line: String, mod_name: String, name: String) -> Bool {
  rust_pub_use_module_name(line: line) == mod_name
    && contains(line, "::{")
    && (contains(line, concat("{", name, ","))
      || contains(line, concat(", ", name, ","))
      || contains(line, concat(", ", name, "}"))
      || contains(line, concat("{", name, "}")))
}

fn rust_pub_use_singleton_covered(line: String, lines: List<String>) -> Bool {
  let mod_name = rust_pub_use_module_name(line: line)
  let name = rust_pub_use_singleton_name(line: line)
  if mod_name == "" || name == "" {
    false
  } else {
    lines |> any(other => rust_pub_use_braced_line_has_name(line: other, mod_name: mod_name, name: name))
  }
}

fn rust_pub_use_braced_subset_covered(line: String, lines: List<String>) -> Bool {
  let mod_name = rust_pub_use_module_name(line: line)
  let names = rust_pub_use_braced_names(line: line)
  if mod_name == "" || names |> count == 0 {
    false
  } else {
    lines |> any(other =>
      other != line
        && rust_pub_use_module_name(line: other) == mod_name
        && contains(other, "::{")
        && (rust_pub_use_braced_names(line: other) |> count) > (names |> count)
        && names |> all(name => rust_pub_use_braced_line_has_name(line: other, mod_name: mod_name, name: name))
    )
  }
}

type BracedImportCoverAccum {
  found_current: Bool
  covered: Bool
}

fn rust_pub_use_braced_equal_prior_covered(line: String, lines: List<String>) -> Bool {
  let mod_name = rust_pub_use_module_name(line: line)
  let names = rust_pub_use_braced_names(line: line)
  if mod_name == "" || names |> count == 0 {
    false
  } else {
    let acc = lines |> fold(init: BracedImportCoverAccum { found_current: false, covered: false }, f: (inner, other) =>
      if inner.found_current || inner.covered {
        inner
      } else if other == line {
        BracedImportCoverAccum { found_current: true, covered: inner.covered }
      } else {
        let other_names = rust_pub_use_braced_names(line: other)
        let is_equal_cover = rust_pub_use_module_name(line: other) == mod_name
          && contains(other, "::{")
          && (other_names |> count) == (names |> count)
          && names |> all(name => rust_pub_use_braced_line_has_name(line: other, mod_name: mod_name, name: name))
        BracedImportCoverAccum { found_current: false, covered: is_equal_cover }
      }
    )
    acc.covered
  }
}

fn rust_use_bound_symbol(entry: String) -> String {
  match entry |> split(delimiter: " as ") |> skip(1) |> first {
    Present { value: bound_name } => bound_name
    Absent => entry
  }
}

data strip_repeated_use_symbols_note: String = "Cross-line symbol-ownership pass (the emitter-side construction fix for the last cssl sanitize rule, cssl_emit_artifact_sanitize_scaffold_debt): within one module header, a symbol binds through exactly ONE crate-use line — the first line to bind it keeps it, a later line re-importing the same bound name through a different transitive path (Optional via v2_std_grammar AND v2_std_collection, the measured 2026-07-22 emit_produced firing) drops the repeat, and a line reduced to zero symbols disappears. Glob lines (::*) and non-crate imports pass through unbound (glob shadowing is legal rust and the prelude is out of scope). The subset/equal coverage filters above drop whole redundant lines; this pass makes the residual PARTIAL overlap across two provider paths unwritable, so rustc E0252/E0255 duplicate-binding classes cannot be authored by the import merge. Coarser than rustc's per-namespace rule (one seen-set, not type/value split) — mirrors the sanitize rule it replaces; .dag naming (CamelCase types, snake_case values) keeps cross-namespace same-name pairs out of real emissions, and the seed (green, so free of duplicate bindings) is byte-inert under it by construction. This pass is post-hoc over rendered lines, not construction (DESIGN section 5) — a bounded scaffold. dissolve-on: the import surface derives from ONE symbol-to-provider ownership map built BEFORE any use-line renders (emit_imports + carrier + reference-derived streams selecting from the same map, so a duplicate binding is unwritable), OR the resolver step-2 typed refusal replaces reference-derived synthesis entirely (the nic_scaffold_dissolution_trigger event) — at either point this strip reduces to a dead assertion and is deleted; the raw_dup_pub_use sweep column is the census that proves it fired zero times first. Cost shape: one symbol-to-owning-line map built in a single pass, then a per-line projection against it — linear in total bound symbols (an owner line always retains its owned symbols, so first-binder-wins and the owner map agree); the earlier per-iteration recomputation of the seen set from all prior kept lines was a quadratic fold (bare-minimum-cost rule, 2026-07-10)."

fn rust_use_line_bound_symbols(line: String) -> List<String> {
  if rust_use_crate_marker(line: line) == "" || contains(line, "::*") {
    []
  } else {
    let braced = rust_pub_use_braced_names(line: line)
    if braced |> count > 0 {
      braced |> map(entry => rust_use_bound_symbol(entry: entry))
    } else {
      let singleton = rust_pub_use_singleton_name(line: line)
      if singleton == "" { [] } else { [singleton] }
    }
  }
}

fn strip_repeated_use_symbols(lines: List<String>) -> List<String> {
  let owners = lines |> fold(init: empty_map(), f: (acc, line) =>
    rust_use_line_bound_symbols(line: line) |> fold(init: acc, f: (inner, bound) =>
      if map_contains_key(inner, bound) { inner } else { map_insert(inner, bound, line) }
    )
  )
  lines |> flat_map(line =>
    if rust_use_crate_marker(line: line) == "" || contains(line, "::*") {
      [line]
    } else {
      let braced = rust_pub_use_braced_names(line: line)
      if braced |> count > 0 {
        let fresh_bounds = unique_strings(items: braced |> map(entry => rust_use_bound_symbol(entry: entry)))
          |> filter(bound => match map_get(owners, bound) {
            Present { value: owner } => owner == line
            Absent => false
          })
        let kept = fresh_bounds |> flat_map(bound =>
          match braced |> filter(entry => rust_use_bound_symbol(entry: entry) == bound) |> first {
            Present { value: entry } => [entry]
            Absent => []
          }
        )
        if kept |> count == 0 {
          []
        } else if (kept |> count) == (braced |> count) {
          [line]
        } else {
          match line |> split(delimiter: "::{") |> first {
            Present { value: prefix } => [concat(prefix, "::{", kept |> join(separator: ", "), "};")]
            Absent => [line]
          }
        }
      } else {
        let singleton = rust_pub_use_singleton_name(line: line)
        if singleton == "" {
          [line]
        } else {
          match map_get(owners, singleton) {
            Present { value: owner } => if owner == line { [line] } else { [] }
            Absent => [line]
          }
        }
      }
    }
  )
}

fn dedupe_rust_import_lines(lines: List<String>) -> List<String> {
  let exact = unique_strings(items: lines |> filter(line => line != ""))
  let covered = exact |> filter(line =>
    rust_pub_use_singleton_covered(line: line, lines: exact) == false
      && rust_pub_use_braced_subset_covered(line: line, lines: exact) == false
      && rust_pub_use_braced_equal_prior_covered(line: line, lines: exact) == false
  )
  strip_repeated_use_symbols(lines: covered)
}

fn emit_imports(imports: List<Node>, emit_info: EmitGraphInfo, registry: Map<String, ItemInfo>, local_names: List<String>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex, supplement_items: List<Node>) -> String {
  if imports |> count == 0 {
    ""
  } else {
    let import_modules = unique_strings(items: imports |> map(imp => authored_name_at(source_indices: source_indices, node: imp)))
    let import_lines = import_modules |> flat_map(import_module =>
      let mod_imports = imports |> filter(imp => authored_name_at(source_indices: source_indices, node: imp) == import_module)
      let mod_name = module_to_filename(name: import_module)
      let mod_has_wildcard = mod_imports |> any(imp => import_is_all(n: imp))
      let block = if mod_has_wildcard {
        let wildcard_line = concat("use crate::", mod_name, "::*;")
        let reexport_surface = wildcard_reexport_surface_names(import_module: import_module, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
        let merged_specific = unique_strings(items: concat(
          mod_imports
            |> filter(imp => import_is_all(n: imp) == false)
            |> flat_map(imp => import_specific_names_at(n: imp, source_indices: source_indices)),
          reexport_surface
        ))
        let specific_block = emit_specific_import_block(
          import_module: import_module,
          mod_name: mod_name,
          filtered_names: merged_specific,
          emit_info: emit_info,
          registry: registry,
          local_names: local_names,
          export_sets: export_sets,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index)
        if specific_block != "" {
          concat(wildcard_line, "\n", specific_block)
        } else {
          wildcard_line
        }
      } else {
        let specific_names = mod_imports |> flat_map(imp => import_specific_names_at(n: imp, source_indices: source_indices))
        let synth_for_module = module_data_field_struct_import_names(items: supplement_items, type_summaries: emit_info.type_summaries, import_module: import_module, export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
        let merged_specific = unique_strings(items: concat(specific_names, synth_for_module))
        emit_specific_import_block(
          import_module: import_module,
          mod_name: mod_name,
          filtered_names: merged_specific,
          emit_info: emit_info,
          registry: registry,
          local_names: local_names,
          export_sets: export_sets,
          typed_modules: typed_modules,
          source_indices: source_indices,
        module_index: module_index)
      }
      block |> split(delimiter: "\n")
    )
    dedupe_rust_import_lines(lines: import_lines) |> join(separator: "\n")
  }
}

fn type_node_is_faithful_string_leaf(n: Node, source_indices: Map<String, NewlineIndex>, corpus_repr: RustCorpusRepr) -> Bool {
  corpus_repr_is_faithful(corpus_repr: corpus_repr)
    && is_rust_string_like(n: n, source_indices: source_indices)
}

fn node_tree_has_faithful_string_leaf(n: Node, source_indices: Map<String, NewlineIndex>, corpus_repr: RustCorpusRepr) -> Bool {
  if type_node_is_faithful_string_leaf(n: n, source_indices: source_indices, corpus_repr: corpus_repr) {
    true
  } else {
    let child_hit = n.children |> any(child => node_tree_has_faithful_string_leaf(n: child, source_indices: source_indices, corpus_repr: corpus_repr))
    let annotation_hit = match n.type_annotation {
      Present { value: ta } => node_tree_has_faithful_string_leaf(n: ta, source_indices: source_indices, corpus_repr: corpus_repr)
      Absent => false
    }
    let inferred_hit = match n.inferred {
      Present { value: Resolved { node: rt } } => node_tree_has_faithful_string_leaf(n: rt, source_indices: source_indices, corpus_repr: corpus_repr)
      _ => false
    }
    child_hit || annotation_hit || inferred_hit
  }
}

fn node_tree_references_type_name(n: Node, type_name: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  if authored_name_at(source_indices: source_indices, node: n) == type_name {
    true
  } else {
    let child_hit = n.children |> any(child => node_tree_references_type_name(n: child, type_name: type_name, source_indices: source_indices))
    let annotation_hit = match n.type_annotation {
      Present { value: ta } => node_tree_references_type_name(n: ta, type_name: type_name, source_indices: source_indices)
      Absent => false
    }
    let inferred_hit = match n.inferred {
      Present { value: Resolved { node: rt } } => node_tree_references_type_name(n: rt, type_name: type_name, source_indices: source_indices)
      _ => false
    }
    child_hit || annotation_hit || inferred_hit
  }
}

data data_field_struct_import_provider_note: String = "§3 single authority for 'which module PROVIDES this field-struct name'. This synth exists because an ANONYMOUS record literal takes its type from the FIELD it initializes (an unnamed record literal on the `io` field), so the constructed type name appears NOWHERE in the source text and can therefore never sit in an authored import list — emit_imports, which derives use-lines only from import lists, has no candidate to work from and the emitted Rust refuses (E0422 `cannot find struct ... in this scope`).

The predicate was `has_physical_type_def_in_module_filename` — field type PHYSICALLY DEFINED in the module being imported from. That is strictly narrower than the question actually being asked, which is whether the imported module PROVIDES the name. `extdeps.realization.compile_stage_memo` imports CacheInterfaceCatalogFacts from `extdeps.cache.types` and constructs its `io` / `placement` fields, but those types are defined in the SIBLING modules `extdeps.cache.catalog_io` / `extdeps.cache.catalog_placement` and merely re-exported by `extdeps.cache.types` — so the physical-definition test rejected them and the use-line was never synthesized. Measured, not assumed: materialization_carriers first_error = error E0422 cannot find struct, variant or union type CacheInterfaceCatalogIoSemantics in this scope.

`name_in_transitive_export_surface` is the existing authority for that question (get_exported_names counts specific-import names as exports, which is exactly re-export), so this reuses it rather than minting a second reachability rule. Routing needs no change: graph_type_import_module_filename already groups emitted use-lines by the type's DEFINING module, so admitting the candidate yields a braced use-line against crate::extdeps_cache_catalog_io on its own.

INCREMENT 2 (generic-argument axis, #6986): build_field_type_map also walks the resolved field-type NODE TREE via collect_type_node_import_surface_names (04_emit_info.dag), populating TypeSummary.field_import_surface_names; this synth consumes that list so List<CacheEvidence> admits CacheEvidence (field_type_map still maps field→HEAD for lookup). Witness: field_import_surface_generic_arg_test. Re-probe 2026-07-21: materialization_carriers CacheEvidence E0422 cleared; first error advanced to E0425 cannot find value extdeps (namespace/dotted-path class — distinct blocker)."

fn module_data_field_struct_import_names(items: List<Node>, type_summaries: Map<String, TypeSummary>, import_module: String, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>, module_index: ModuleIndex) -> List<String> {
  unique_strings(items: items
    |> filter(item => is_data_def_item(item: item))
    |> flat_map(item => {
      let type_name = match item.type_annotation {
        Present { value: ta } => authored_name_at(source_indices: source_indices, node: ta)
        Absent => ""
      }
      if type_name == "" {
        []
      } else {
        match map_get(type_summaries, type_name) {
          Present { value: summary } =>
            summary.field_import_surface_names |> filter(field_type =>
              field_type != ""
              && name_in_transitive_export_surface(name: field_type, module_name: import_module, visited: [], export_sets: export_sets, typed_modules: typed_modules, source_indices: source_indices, module_index: module_index)
              && match map_get(type_summaries, field_type) {
                Present { value: ft } =>
                  match ft.repr {
                    StructRepr => true
                    _ => false
                  }
                Absent => false
              }
            )
          Absent => []
        }
      }
    }))
}

fn typed_closure_includes_module_filename(typed_modules: List<TypedModule>, filename: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  typed_modules |> any(tm => module_to_filename(name: authored_name_at(source_indices: source_indices, node: tm.module)) == filename)
}

fn module_item_has_faithful_string_leaf(item: Node, source_indices: Map<String, NewlineIndex>, corpus_repr: RustCorpusRepr) -> Bool {
  node_tree_has_faithful_string_leaf(n: item, source_indices: source_indices, corpus_repr: corpus_repr)
    || item.params |> any(p => node_tree_has_faithful_string_leaf(n: p, source_indices: source_indices, corpus_repr: corpus_repr))
    || match item.body {
      Present { value: body } => node_tree_has_faithful_string_leaf(n: body, source_indices: source_indices, corpus_repr: corpus_repr)
      Absent => false
    }
}

fn module_item_references_type_name(item: Node, type_name: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  node_tree_references_type_name(n: item, type_name: type_name, source_indices: source_indices)
    || match item.type_annotation {
      Present { value: ta } => node_tree_references_type_name(n: ta, type_name: type_name, source_indices: source_indices)
      Absent => false
    }
    || item.params |> any(p => node_tree_references_type_name(n: p, type_name: type_name, source_indices: source_indices))
    || match item.body {
      Present { value: body } => node_tree_references_type_name(n: body, type_name: type_name, source_indices: source_indices)
      Absent => false
    }
}

fn module_item_references_faithful_expanded_type(item: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  module_item_references_type_name(item: item, type_name: "ByteSize", source_indices: source_indices)
    || module_item_references_type_name(item: item, type_name: "Measure", source_indices: source_indices)
    || module_item_references_type_name(item: item, type_name: "Map", source_indices: source_indices)
}

fn module_needs_faithful_carrier_imports(items: List<Node>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> Bool {
  if !corpus_repr_is_faithful(corpus_repr: corpus_repr) {
    false
  } else {
    module_renders_faithful_text_carrier(items: items, corpus_repr: corpus_repr, source_indices: source_indices)
    || items |> any(item =>
      module_item_references_type_name(item: item, type_name: "FreeMonoid", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "Char", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "NonEmptyStr", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "Int", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "PartialFunction", source_indices: source_indices)
      || module_item_references_type_name(item: item, type_name: "Memory", source_indices: source_indices)
      || module_item_references_faithful_expanded_type(item: item, source_indices: source_indices)
    )
  }
}

fn module_renders_faithful_text_carrier(items: List<Node>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> Bool {
  if !corpus_repr_is_faithful(corpus_repr: corpus_repr) {
    false
  } else {
    items |> any(item => module_item_has_faithful_string_leaf(item: item, source_indices: source_indices, corpus_repr: corpus_repr))
  }
}

fn rust_import_name_already_resolved(imported_names: List<String>, local_type_names: List<String>, name: String) -> Bool {
  imported_names |> any(n => n == name) || local_type_names |> any(n => n == name)
}

fn emit_faithful_text_carrier_import_lines(imported_names: List<String>, local_type_names: List<String>, items: List<Node>, source_indices: Map<String, NewlineIndex>, corpus_repr: RustCorpusRepr, shared_types: Set<String>, typed_modules: List<TypedModule>) -> List<String> {
  let closure_has_std_measure = typed_closure_includes_module_filename(typed_modules: typed_modules, filename: "std_measure", source_indices: source_indices)
  let needs_free_monoid = items |> any(item =>
    module_item_has_faithful_string_leaf(item: item, source_indices: source_indices, corpus_repr: corpus_repr)
    || module_item_references_type_name(item: item, type_name: "FreeMonoid", source_indices: source_indices)
  )
  let needs_char = items |> any(item =>
    module_item_has_faithful_string_leaf(item: item, source_indices: source_indices, corpus_repr: corpus_repr)
    || module_item_references_type_name(item: item, type_name: "Char", source_indices: source_indices)
  )
  let needs_non_empty_str = items |> any(item => module_item_references_type_name(item: item, type_name: "NonEmptyStr", source_indices: source_indices))
  let needs_int = items |> any(item => module_item_references_type_name(item: item, type_name: "Int", source_indices: source_indices))
  let needs_partial_function = items |> any(item =>
    module_item_references_type_name(item: item, type_name: "PartialFunction", source_indices: source_indices)
    || module_item_references_type_name(item: item, type_name: "Map", source_indices: source_indices)
  )
  let needs_measure_phantoms = closure_has_std_measure && items |> any(item => module_item_references_faithful_expanded_type(item: item, source_indices: source_indices))
  let free_monoid = if !needs_free_monoid || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "FreeMonoid") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_algebra::FreeMonoid;")]
  }
  let char_line = if !needs_char || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "Char") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_types::Char;")]
  }
  let non_empty_str = if !needs_non_empty_str || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "NonEmptyStr") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_types::NonEmptyStr;")]
  }
  let int_line = if !needs_int || local_type_names |> any(n => n == "Int") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::v2_std_integer::Int;")]
  }
  let partial_function = if !needs_partial_function || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "PartialFunction") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_algebra::PartialFunction;")]
  }
  let memory = if !needs_measure_phantoms || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "Memory") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_measure::Memory;")]
  }
  let one = if !needs_measure_phantoms || rust_import_name_already_resolved(imported_names: imported_names, local_type_names: local_type_names, name: "One") {
    []
  } else {
    [concat(rust_visibility_prefix(), "use crate::std_measure::One;")]
  }
  concat(free_monoid, char_line, non_empty_str, int_line, partial_function, memory, one)
}

fn emit_prelude(imported_names: List<String>, local_type_names: List<String>) -> String {
  let base = concat(
    "use im::\{vector as vec, HashMap, OrdSet as BTreeSet, Vector as Vec\};\n",
    "use crate::v1_rt::\{VecCompat, VecJoin\};\n",
    "use std::rc::Rc;\n",
    "use crate::v1_rt;")
  let wrapper_use = "\nuse crate::NonEmptyVec;\nuse crate::NonEmptyBTreeSet;"
  concat(base, wrapper_use)
}

fn emit_non_empty_wrappers() -> String {
  let vec_wrapper = concat(
    "pub struct NonEmptyVec<T>(Vec<T>);\n\n",
    "impl<T: Clone + std::fmt::Debug> std::fmt::Debug for NonEmptyVec<T> {\n",
    "    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n",
    "        f.debug_tuple(\"NonEmptyVec\").field(&self.0).finish()\n",
    "    }\n",
    "}\n\n",
    "impl<T: Clone> Clone for NonEmptyVec<T> {\n",
    "    fn clone(&self) -> Self {\n",
    "        Self(self.0.clone())\n",
    "    }\n",
    "}\n\n",
    "impl<T: Clone + PartialEq> PartialEq for NonEmptyVec<T> {\n",
    "    fn eq(&self, other: &Self) -> bool {\n",
    "        self.0 == other.0\n",
    "    }\n",
    "}\n\n",
    "impl<T: Clone> NonEmptyVec<T> {\n",
    "    pub fn new(items: Vec<T>) -> Result<Self, &'static str> {\n",
    "        if items.is_empty() {\n",
    "            Err(\"NonEmptyVec requires at least one element\")\n",
    "        } else {\n",
    "            Ok(Self(items))\n",
    "        }\n",
    "    }\n\n",
    "    pub fn into_vec(self) -> Vec<T> {\n",
    "        self.0\n",
    "    }\n",
    "}"
  )
  let set_wrapper = concat(
    "#[derive(Debug, Clone, PartialEq)]\n",
    "pub struct NonEmptyBTreeSet<T: Ord>(std::collections::BTreeSet<T>);\n\n",
    "impl<T: Ord> NonEmptyBTreeSet<T> {\n",
    "    pub fn new(items: std::collections::BTreeSet<T>) -> Result<Self, &'static str> {\n",
    "        if items.is_empty() {\n",
    "            Err(\"NonEmptyBTreeSet requires at least one element\")\n",
    "        } else {\n",
    "            Ok(Self(items))\n",
    "        }\n",
    "    }\n\n",
    "    pub fn as_set(&self) -> &std::collections::BTreeSet<T> {\n",
    "        &self.0\n",
    "    }\n\n",
    "    pub fn into_set(self) -> std::collections::BTreeSet<T> {\n",
    "        self.0\n",
    "    }\n",
    "}"
  )
  concat(vec_wrapper, "\n\n", set_wrapper)
}

fn emit_typed_item(item: Node, module_name: String, registry: Map<String, ItemInfo>, scope: InferScope, shared_types: Set<String>, emit_info: EmitGraphInfo, wire_contract_item: Node?, data_items: Map<String, List<Node>>, module_items: List<Node>, imports: List<Node>, export_sets: Map<String, Map<String, Bool>>, typed_modules: List<TypedModule>, module_index: ModuleIndex) -> String {
  let env = scope.type_env
  let qualified_name = concat(module_name, ".", authored_name(env: env, node: item))
  let item_text = authored_name(env: env, node: item)
  if is_type_def_item(item: item) {
    emit_type_def_from_connective(item: item, recursive_types: emit_info.recursive_type_set, shared_types: shared_types, env: env, emit_info: emit_info, wire_contract_item: wire_contract_item, data_items: data_items, module_items: module_items, imports: imports)
  } else if is_type_alias_item(item: item, source_indices: env.source_indices) {

    if item_text == "String" {
      rust_string_grounded_type_alias_decl_line()
    } else if (item.params |> count) == 0 && rust_opaque_kernel_alias_type_eligible(name: item_text) {
      rust_opaque_kernel_alias_type_decl(name: item_text)
    } else if (item.params |> count) == 0 && rust_nominal_identity_carrier_type_eligible(type_name: item_text) {
      rust_nominal_identity_carrier_def(name: item_text)
    } else if is_zero_param_self_referential_opaque_decl(item: item, source_indices: env.source_indices) {
      emit_zero_param_phantom_opaque_struct(item: item, source_indices: env.source_indices)
    } else {
      match rust_scalar_checkpoint_render_base(dag_name: item_text, corpus_repr: emit_info.corpus_repr) {
        Present { value: host } =>
          concat(rust_visibility_prefix(), rust_items().type_alias_keyword, " ", item_text, " = ", host, ";")
        Absent =>
          concat(rust_visibility_prefix(), rust_items().type_alias_keyword, " ", item_text, " = ", render_rust_alias_rhs_type(
            n: resolved_type(n: item),
            generic_param_names: [],
            shared_types: shared_types,
            corpus_repr: emit_info.corpus_repr,
            source_indices: env.source_indices,
            scope: scope,
            imports: imports,
            registry: registry,
            module_name: module_name,
            export_sets: export_sets,
            typed_modules: typed_modules,
            module_index: module_index,
            variant_to_enum: emit_info.variant_to_enum), ";")
      }
    }
  } else if is_type_decl_item(item: item, source_indices: env.source_indices) {
    if (item.params |> count) == 0 && rust_opaque_kernel_alias_type_eligible(name: item_text) {
      rust_opaque_kernel_alias_type_decl(name: item_text)
    } else if (item.params |> count) == 0 && rust_nominal_identity_carrier_type_eligible(type_name: item_text) {
      rust_nominal_identity_carrier_def(name: item_text)
    } else {

      match rust_seed_host_container_base(name: item_text, corpus_repr: emit_info.corpus_repr) {
        Present { value: host } =>
          let type_params = emit_type_params(params: item.params, source_indices: env.source_indices)
          let generic_names = item_generic_param_names(item: item, source_indices: env.source_indices)
          concat(
            rust_visibility_prefix(),
            rust_items().type_alias_keyword,
            " ",
            item_text,
            type_params,
            " = ",
            host,
            "<",
            generic_names |> map(n => to_pascal(name: n)) |> join(separator: ", "),
            ">;"
          )
        Absent =>
          if is_emittable_parametric_type_alias_item(item: item, item_text: item_text, source_indices: env.source_indices, module_name: module_name, imports: imports, scope: scope, registry: registry, export_sets: export_sets, typed_modules: typed_modules, module_index: module_index) {
            let type_params = emit_type_params(params: item.params, source_indices: env.source_indices)
            let generic_names = item_generic_param_names(item: item, source_indices: env.source_indices)
            let alias_rhs = resolved_type(n: item)
            let unused_params = alias_unused_param_names(generic_param_names: generic_names, rhs: alias_rhs, source_indices: env.source_indices)
            let rhs_str = if unused_params |> count > 0 {
              concat("std::marker::PhantomData<", rust_phantom_marker_inner(unused: unused_params), ">")
            } else {
              render_rust_alias_rhs_type(
                n: alias_rhs,
                generic_param_names: generic_names,
                shared_types: shared_types,
                corpus_repr: emit_info.corpus_repr,
                source_indices: env.source_indices,
                scope: scope,
                imports: imports,
                registry: registry,
                module_name: module_name,
                export_sets: export_sets,
                typed_modules: typed_modules,
              module_index: module_index,
              variant_to_enum: emit_info.variant_to_enum)
            }
            concat(
              rust_visibility_prefix(),
              rust_items().type_alias_keyword,
              " ",
              item_text,
              type_params,
              " = ",
              rhs_str,
              ";"
            )
          } else if is_parametric_opaque_type_decl_item(item: item, source_indices: env.source_indices) {
            emit_parametric_phantom_opaque_struct(item: item, source_indices: env.source_indices)
          } else {
            ""
          }
      }
    }
  } else if is_function_item(item: item) {
    let fn_movable = match map_get(emit_info.ownership_index, qualified_name) {
      Present { value: m } => m
      Absent => empty_set()
    }
    let item_is_tco = is_tco_eligible(name: authored_name(env: env, node: item), body: item.body.value, registry: registry, source_indices: env.source_indices)
    let fn_read_only = if item_is_tco { empty_set() } else {
      match map_get(emit_info.read_only_params_index, qualified_name) {
        Present { value: m } => m
        Absent => empty_set()
      }
    }
    let fn_emit_info = EmitGraphInfo {
      type_summaries: emit_info.type_summaries,
      type_decl_items: emit_info.type_decl_items,
      recursive_type_set: emit_info.recursive_type_set,
      fielded_variants: emit_info.fielded_variants,
      positional_payload_variants: emit_info.positional_payload_variants,
      shared_types: emit_info.shared_types,
      ownership_index: emit_info.ownership_index,
      movable: fn_movable,
      variant_to_enum: emit_info.variant_to_enum,
      owned_bindings: empty_set(),
      read_only_params_index: emit_info.read_only_params_index,
      read_only_params: fn_read_only,
      corpus_repr: emit_info.corpus_repr,
      fn_generic_param_names: emit_info.fn_generic_param_names,
      fn_type_env: emit_info.fn_type_env,
      fn_return_type: emit_info.fn_return_type
    }

    let is_effectful = match lookup_item(registry: registry, name: authored_name(env: env, node: item)) {
      Present { value: info } => info.service_names |> count > 0 || info.resource_names |> count > 0
      Absent => false
    }
    if is_effectful {
      emit_func_def(name: item_text, params: item.params, inferred: resolved_type(n: item), uses: item.uses, body: item.body.value, registry: registry, scope: scope, shared_types: shared_types, emit_info: fn_emit_info)
    } else {
      emit_fn_def(name: item_text, params: item.params, inferred: resolved_type(n: item), body: item.body.value, registry: registry, scope: scope, shared_types: shared_types, emit_info: fn_emit_info)
    }
  } else if is_data_def_item(item: item) {
    emit_data_def(name: item_text, type_node: item.type_annotation.value, value: item.body.value, registry: registry, scope: scope, depth: 0, shared_types: shared_types, emit_info: emit_info)
  } else if is_service_def_item(item: item) {
    emit_service_def(item: item, registry: registry, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, env: env)
  } else if is_resource_def_item(item: item) {
    emit_resource_def(item: item, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, env: env)
  } else {
    concat("compile_error!(\"unhandled item: ", item_text, "\");")
  }
}

fn needs_box_wrapping(n: Node, recursive_types: Set<String>, shared_types: Set<String>, source_indices: Map<String, NewlineIndex>) -> Bool {
  let name = authored_name_at(source_indices: source_indices, node: n)
  if set_contains(shared_types, name) { false }
  else if set_contains(recursive_types, name) { true }
  else if n.children |> count == 0 {
    if coerce_primitive_type(target: Rust, dag_name: name) != name { false }
    else { set_contains(recursive_types, name) }
  } else {
    let is_optional = n.return_cardinality == CardOptional
    if is_optional {
      needs_box_wrapping(n: with_required_cardinality(n: n), recursive_types: recursive_types, shared_types: shared_types, source_indices: source_indices)
    } else {
      false
    }
  }
}

fn emit_type_params(params: List<Node>, source_indices: Map<String, NewlineIndex>) -> String {
  if params |> count == 0 { "" }
  else {
    let names = params |> map(p => to_pascal(name: generic_param_name_at(n: p, source_indices: source_indices)))
    concat("<", names |> join(separator: ", "), ">")
  }
}

fn emit_type_params_with_clone_bound(params: List<Node>, clone_param: String, source_indices: Map<String, NewlineIndex>) -> String {
  if params |> count == 0 { "" }
  else {
    let names = params |> map(p =>
      let pname = generic_param_name_at(n: p, source_indices: source_indices)
      let pascal = to_pascal(name: pname)
      if pname == clone_param { concat(pascal, ": Clone") } else { pascal }
    )
    concat("<", names |> join(separator: ", "), ">")
  }
}

fn is_function_type_param(param: Node) -> Bool {
  let type_expr = param_node_type_expr(n: param)
  let type_expr_is_var = match type_expr.inferred {
    Present { value: inf } => is_type_variable(inferred: inf)
    Absent => false
  }
  let same_source_span = param.span.file == type_expr.span.file && param.span.start == type_expr.span.start && param.span.end == type_expr.span.end

  param.name != "" && param.name == type_expr.name && (type_expr_is_var || same_source_span)
}

fn function_type_params(params: List<Node>) -> List<Node> {
  params |> filter(p => is_function_type_param(param: p))
}

fn function_value_params(params: List<Node>) -> List<Node> {
  params |> filter(p => !is_function_type_param(param: p))
}

fn function_type_params_have_collision(type_params: List<Node>) -> Bool {
  let names = type_params |> map(p => p.name)
  (names |> count) > (unique_strings(items: names) |> count)
}

fn emit_type_def_from_connective(item: Node, recursive_types: Set<String>, shared_types: Set<String>, env: TypeEnv, emit_info: EmitGraphInfo, wire_contract_item: Node?, data_items: Map<String, List<Node>>, module_items: List<Node>, imports: List<Node>) -> String {
  let type_params = emit_type_params(params: item.params, source_indices: env.source_indices)
  let item_text = authored_name(env: env, node: item)
  let is_product = is_product_type(n: item)
  if is_product {
    let generic_param_names = item.params |> map(p => generic_param_name_at(n: p, source_indices: env.source_indices))
    emit_struct_from_children(name: item_text, type_params: type_params, generic_param_names: generic_param_names, children: item.children, recursive_types: recursive_types, shared_types: shared_types, env: env, emit_info: emit_info)
  } else if is_host_optional_carrier_alias(name: item_text) {
    let elem_csv = item.params |> map(p => to_pascal(name: generic_param_name_at(n: p, source_indices: env.source_indices))) |> join(separator: ", ")
    concat(rust_visibility_prefix(), "type ", item_text, type_params, " = Option<", elem_csv, ">;")
  } else if is_host_freemonoid_vec_alias(name: item_text) {
    let elem_csv = item.params |> map(p => to_pascal(name: generic_param_name_at(n: p, source_indices: env.source_indices))) |> join(separator: ", ")
    concat(rust_visibility_prefix(), "type ", item_text, type_params, " = Vec<", elem_csv, ">;")
  } else if is_host_diagnostics_carrier_alias(name: item_text) {
    concat(rust_visibility_prefix(), "type ", item_text, type_params, " = ", render_rust_diagnostics_carrier_applied(shared_types: shared_types), ";")
  } else {
    let all_unit_variants = item.children |> all(child => child.children |> count == 0)
    let serde_policy = match resolve_local_coproduct_wire_policy(coproduct_name: item_text, all_unit_variants: all_unit_variants, module_items: module_items, imports: imports, source_indices: env.source_indices) {
      Present { value: local_policy } => local_policy
      Absent =>
        if all_unit_variants {
          match wire_contract_item {
            Present { value: _ } => resolve_wire_serde_policy_for_coproduct(wire_contract_item: wire_contract_item, source_indices: env.source_indices, data_items: data_items)
            Absent => rust_tagged_object_policy()
          }
        } else {
          rust_tagged_object_policy()
        }
    }
    let rename_validations = variant_rename_validations_for_policy(children: item.children, env: env, serde_policy: serde_policy)
    let policy_validation = match serde_policy.error_message {
      Present { value: message } => emit_rust_compile_error_item(message: message)
      Absent => ""
    }
    let validations = if policy_validation == "" {
      rename_validations
    } else if rename_validations == "" {
      policy_validation
    } else {
      concat(policy_validation, "\n", rename_validations)
    }
    let generic_param_names = item.params |> map(p => generic_param_name_at(n: p, source_indices: env.source_indices))
    let enum_text = emit_enum_from_children(name: item_text, type_params: type_params, generic_param_names: generic_param_names, children: item.children, recursive_types: recursive_types, shared_types: shared_types, env: env, serde_policy: serde_policy, emit_info: emit_info)
    if validations == "" {
      enum_text
    } else {
      concat(validations, "\n", enum_text)
    }
  }
}

fn type_node_mentions_name(n: Node, target: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  if authored_name_at(source_indices: source_indices, node: n) == target {
    true
  } else {
    n.children |> any(c => type_node_mentions_name(n: c, target: target, source_indices: source_indices))
  }
}

fn struct_unused_param_names(generic_param_names: List<String>, children: List<Node>, source_indices: Map<String, NewlineIndex>) -> List<String> {
  generic_param_names |> filter(p =>
    !(children |> any(child => type_node_mentions_name(n: field_node_type_expr(n: child), target: p, source_indices: source_indices)))
  )
}

fn alias_unused_param_names(generic_param_names: List<String>, rhs: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  generic_param_names |> filter(p =>
    !type_node_mentions_name(n: rhs, target: p, source_indices: source_indices)
  )
}

fn rust_phantom_marker_inner(unused: List<String>) -> String {
  let pascal_unused = unused |> map(n => to_pascal(name: n))
  if pascal_unused |> count == 1 {
    pascal_unused |> join(separator: ", ")
  } else {
    concat("(", pascal_unused |> join(separator: ", "), ")")
  }
}

fn rust_phantom_field_name() -> String { "_phantom" }

fn type_has_fn_fields(name: String, emit_info: EmitGraphInfo) -> Bool {
  match map_get(emit_info.type_summaries, name) {
    Present { value: ts } => ts.has_fn_fields
    Absent => false
  }
}

fn struct_needs_serde(name: String, emit_info: EmitGraphInfo) -> Bool {
  !type_has_fn_fields(name: name, emit_info: emit_info)
}

fn emit_struct_from_children(name: String, type_params: String, generic_param_names: List<String>, children: List<Node>, recursive_types: Set<String>, shared_types: Set<String>, env: TypeEnv, emit_info: EmitGraphInfo) -> String {
  let has_fn_fields = type_has_fn_fields(name: name, emit_info: emit_info)
  let surface = v1_emit_struct_from_capability_table(
    module_path: env.module_path,
    name: name,
    children: children,
    shared_types: shared_types,
    has_fn_fields: has_fn_fields,
    source_indices: env.source_indices
  )
  if children |> count == 0 {
    concat(surface.derive_attr, "\n", rust_visibility_prefix(), rust_items().struct_keyword, " ", name, type_params, ";")
  } else {
    let field_lines = children |> map(child => emit_struct_field_from_child(struct_name: name, child: child, generic_param_names: generic_param_names, recursive_types: recursive_types, shared_types: shared_types, env: env, emit_info: emit_info))

    let unused_params = struct_unused_param_names(generic_param_names: generic_param_names, children: children, source_indices: env.source_indices)
    let all_field_lines = if unused_params |> count > 0 {
      concat(field_lines, [concat("    ", rust_visibility_prefix(), rust_phantom_field_name(), ": std::marker::PhantomData<", rust_phantom_marker_inner(unused: unused_params), ">,")])
    } else { field_lines }
    let fields_str = all_field_lines |> join(separator: "\n")
    let struct_def = concat(surface.derive_attr, "\n", rust_visibility_prefix(), rust_items().struct_keyword, " ", name, type_params, " {\n", fields_str, "\n}")
    if surface.impl_bodies == "" { struct_def } else { concat(struct_def, surface.impl_bodies) }
  }
}

fn render_rust_type_with_applied_binding(n: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  if is_host_text_carrier_type(n: n, source_indices: source_indices, corpus_repr: corpus_repr) { return rust_carrier_optional_wrap(n: n, rendered: "String") }
  match find_property(props: n.properties, prop_name: "__applied_type_args", source_indices: source_indices) {
    Present { value: applied } =>
      if applied.children |> count > 0 {
        let outer_name = authored_name_at(source_indices: source_indices, node: n)
        let applied_name = authored_name_at(source_indices: source_indices, node: applied)
        if outer_name != "" && n.connective == NoConnective && (n.children |> count) == 0 {
          if outer_name != applied_name {
            render_rust_shared_type_with_optional(n: n, type_name: outer_name, rendered: outer_name, shared_types: shared_types)
          } else {
            render_rust_applied_type_shared(n: applied, generic_param_names: [], shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: empty_map(), env: TypeEnv { module_path: "", bindings: empty_map(), str_bindings: empty_map(), ancestry_str_bindings: empty_map(), parents: [], recursive_types: [], recursive_type_set: empty_map(), inductive_fields: empty_map(), source_indices: source_indices, intern_table: empty_intern_table(), source_visible_names: empty_map(), symbol_index: empty_symbol_index() })
          }
        } else {
          render_rust_applied_type_shared(n: applied, generic_param_names: [], shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: empty_map(), env: TypeEnv { module_path: "", bindings: empty_map(), str_bindings: empty_map(), ancestry_str_bindings: empty_map(), parents: [], recursive_types: [], recursive_type_set: empty_map(), inductive_fields: empty_map(), source_indices: source_indices, intern_table: empty_intern_table(), source_visible_names: empty_map(), symbol_index: empty_symbol_index() })
        }
      } else {
        render_rust_type(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info())
      }
    Absent => render_rust_type(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info())
  }
}

fn render_rust_field_type_with_applied_binding(field: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  let authored_type = field_node_type_expr(n: field)
  if generic_param_names |> count > 0 {
    render_rust_decl_type(n: resolved_type(n: field), generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  } else if find_property(props: field.properties, prop_name: "__applied_type_args", source_indices: source_indices) != none {
    render_rust_type_with_applied_binding(n: field, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices)
  } else if find_property(props: authored_type.properties, prop_name: "__applied_type_args", source_indices: source_indices) != none {
    render_rust_type_with_applied_binding(n: authored_type, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices)
  } else if authored_type.connective == NoConnective && authored_type.children |> count > 0 {
    render_rust_type(n: authored_type, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info())
  } else {
    render_rust_type_with_applied_binding(n: resolved_type(n: field), shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices)
  }
}

fn emit_struct_field_from_child(struct_name: String, child: Node, generic_param_names: List<String>, recursive_types: Set<String>, shared_types: Set<String>, env: TypeEnv, emit_info: EmitGraphInfo) -> String {
  let rt_child = resolved_type(n: child)
  let authored_child_type = field_node_type_expr(n: child)
  let ty = if generic_param_names |> count > 0 {
    render_rust_decl_type(n: rt_child, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
  } else if find_property(props: child.properties, prop_name: "__applied_type_args", source_indices: env.source_indices) != none {
    render_rust_type_with_applied_binding(n: child, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices)
  } else if find_property(props: authored_child_type.properties, prop_name: "__applied_type_args", source_indices: env.source_indices) != none {
    render_rust_type_with_applied_binding(n: authored_child_type, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices)
  } else if find_property(props: rt_child.properties, prop_name: "__applied_type_args", source_indices: env.source_indices) != none {
    render_rust_type_with_applied_binding(n: rt_child, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices)
  } else if is_product_type(n: rt_child) && rt_child.ident_span != none && rt_child.children |> count > 2 {
    let rt_child_name = authored_name_at(source_indices: env.source_indices, node: rt_child)
    match lookup_type_by_name(env: env, name: rt_child_name) {
      Present { value: resolved } =>
        if resolved.params |> count > 0 {
          let base = coerce_primitive_type(target: Rust, dag_name: rt_child_name)
          let param_names = resolved.params |> map(p => to_pascal(name: generic_param_name_at(n: p, source_indices: env.source_indices)))
          let with_params = concat(base, "<", param_names |> join(separator: ", "), ">")
          render_rust_shared_type_if_needed(type_name: rt_child_name, rendered: with_params, shared_types: shared_types)
        } else {
          render_rust_type(n: rt_child, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices, emit_info: emit_info)
        }
      Absent => render_rust_type(n: rt_child, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices, emit_info: emit_info)
    }
  } else {
    render_rust_type(n: rt_child, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices, emit_info: emit_info)
  }
  let generic_ty = if struct_name == "PartialFunction" {
    rust_normalize_partial_function_field_type_text(rendered: rust_normalize_witness_type_text(rendered: ty))
  } else {
    ty
  }
  let final_ty = if needs_box_wrapping(n: rt_child, recursive_types: recursive_types, shared_types: shared_types, source_indices: env.source_indices) {
    concat("Box<", generic_ty, ">")
  } else if rt_child.return_cardinality != CardOptional && set_contains(shared_types, authored_name_at(source_indices: env.source_indices, node: rt_child)) && !rust_type_is_rc_wrapped(type_name: generic_ty) {
    wrap_shared_type(target: Rust, inner: generic_ty)
  } else { generic_ty }
  let needs_serde = struct_needs_serde(name: struct_name, emit_info: emit_info)
  let rename_attr = if !needs_serde { "" } else {
    match child.properties |> filter(p => field_init_node_name_at(n: p, source_indices: env.source_indices) == "from_key") |> first {
      Present { value: prop } => match field_init_node_value(n: prop).expr_data {
        ExprLiteral { value: lv } => match lv {
          LitStr { value: key } => concat("    ", apply_type_template1(template: rust_serde_rename_template_text(), arg0: key), "\n")
          _ => ""
        }
        _ => ""
      }
      Absent => ""
    }
  }
  emit_rust_field_definition(authored: authored_name(env: env, node: child), final_ty: final_ty, rename_attr: rename_attr, indent: "    ", visibility: rust_visibility_prefix(), needs_serde: needs_serde)
}

fn emit_rust_field_definition(authored: String, final_ty: String, rename_attr: String, indent: String, visibility: String, needs_serde: Bool) -> String {
  let snake = to_snake(name: authored)
  let emitted = emit_ident(name: authored, target: Rust)
  let keyword_rename = if needs_serde && emitted != snake && rename_attr == "" {
    concat(indent, "#[serde(rename = \"", snake, "\")]\n")
  } else { "" }
  concat(keyword_rename, rename_attr, indent, visibility, emitted, ": ", final_ty, ",")
}

fn enum_derives(name: String, children: List<Node>, source_indices: Map<String, NewlineIndex>) -> String {
  v1_emit_enum_derives(children: children, source_indices: source_indices)
}

fn emit_enum_from_children(name: String, type_params: String, generic_param_names: List<String>, children: List<Node>, recursive_types: Set<String>, shared_types: Set<String>, env: TypeEnv, serde_policy: RustEnumWireSerde, emit_info: EmitGraphInfo) -> String {
  let derives = enum_derives(name: name, children: children, source_indices: env.source_indices)
  let variant_lines = children |> map(child => emit_variant_from_child(child: child, enum_name: name, generic_param_names: generic_param_names, recursive_types: recursive_types, shared_types: shared_types, env: env, serde_policy: serde_policy, emit_info: emit_info))
  let variants_str = variant_lines |> join(separator: "\n")
  let tag_line = if serde_policy.enum_attr == "" { "" } else { concat(serde_policy.enum_attr, "\n") }
  let enum_def = concat(derives, "\n", tag_line, rust_visibility_prefix(), rust_items().enum_keyword, " ", name, type_params, " {\n", variants_str, "\n}")
  let accessor_impl = emit_enum_shared_accessors(name: name, type_params: type_params, generic_param_names: generic_param_names, children: children, recursive_types: recursive_types, shared_types: shared_types, env: env, emit_info: emit_info)
  let supplemental = v1_emit_enum_supplemental_impls(module_path: env.module_path, name: name)
  let with_accessors = if accessor_impl == "" { enum_def } else { concat(enum_def, "\n", accessor_impl) }
  if supplemental == "" { with_accessors } else { concat(with_accessors, supplemental) }
}

fn find_shared_enum_fields(children: List<Node>, env: TypeEnv) -> List<String> {
  let fielded = children |> filter(child =>
    child.children |> count > 0
      && !variant_is_synthetic_positional_payload(fields: child.children, source_indices: env.source_indices)
  )
  if fielded |> count == 0 { return [] }
  let first_fields = match fielded |> first {
    Present { value: v } => v.children |> map(f => authored_name(env: env, node: f))
    Absent => []
  }
  first_fields |> filter(fname =>
    fielded |> all(variant =>
      variant.children |> any(f => authored_name(env: env, node: f) == fname)
    )
  )
}

fn emit_enum_shared_accessors(name: String, type_params: String, generic_param_names: List<String>, children: List<Node>, recursive_types: Set<String>, shared_types: Set<String>, env: TypeEnv, emit_info: EmitGraphInfo) -> String {
  let all_shared = find_shared_enum_fields(children: children, env: env)
  if all_shared |> count == 0 { return "" }
  let fielded = children |> filter(child =>
    child.children |> count > 0
      && !variant_is_synthetic_positional_payload(fields: child.children, source_indices: env.source_indices)
  )
  if fielded |> count == 0 { return "compile_error!(\"enum shared accessor missing fielded variant\")" }
  let first_fielded = (fielded |> first).value
  let shared = all_shared |> filter(fname =>
    let types = fielded |> map(variant =>
      match variant.children |> filter(f => authored_name(env: env, node: f) == fname) |> first {
        Present { value: f } => render_rust_field_type_with_applied_binding(field: f, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
        Absent => ""
      }
    )
    let first_type = match types |> first {
      Present { value: t } => t
      Absent => ""
    }
    types |> all(t => t == first_type)
  )
  if shared |> count == 0 { return "" }
  let accessor_fns = shared |> map(fname =>
    let ty = match first_fielded.children |> filter(f => authored_name(env: env, node: f) == fname) |> first {
      Present { value: f } => render_rust_field_type_with_applied_binding(field: f, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
      Absent => "compile_error!(\"enum shared accessor missing field metadata\")"
    }
    let arms = children |> map(child =>
      let child_text = authored_name(env: env, node: child)
      let sharing = language_spec(target: Rust).sharing
      if child.children |> count == 0 {
        concat("            ", name, "::", child_text, " => panic!(\"no ", fname, " on unit variant\"),")
      } else if variant_is_synthetic_positional_payload(fields: child.children, source_indices: env.source_indices) {
        concat("            ", name, "::", child_text, "(_) => panic!(\"no ", fname, " on positional-payload variant\"),")
      } else {
        concat("            ", name, "::", child_text, " { ", emit_ident(name: fname, target: Rust), ": __val, .. } => ", apply_type_template1(template: sharing.clone_value, arg0: "__val"), ",")
      }
    )
    let arms_str = arms |> join(separator: "\n")
    concat("    pub fn ", emit_ident(name: fname, target: Rust), "(&self) -> ", ty, " {\n        match self {\n", arms_str, "\n        }\n    }")
  )
  let fns_str = accessor_fns |> join(separator: "\n")
  concat("impl", type_params, " ", name, type_params, " {\n", fns_str, "\n}")
}

fn string_without_prefix(value: String, prefix: String) -> String? {
  if string_length(s: prefix) == 0 {
    none
  } else if string_length(s: value) >= string_length(s: prefix) && substring(s: value, start: 0, end: string_length(s: prefix)) == prefix {
    Present { value: substring(s: value, start: string_length(s: prefix), end: string_length(s: value)) }
  } else {
    none
  }
}

fn string_without_suffix(value: String, suffix: String) -> String? {
  if string_length(s: suffix) == 0 {
    none
  } else if string_length(s: value) >= string_length(s: suffix) && substring(s: value, start: string_length(s: value) - string_length(s: suffix), end: string_length(s: value)) == suffix {
    Present { value: substring(s: value, start: 0, end: string_length(s: value) - string_length(s: suffix)) }
  } else {
    none
  }
}

fn string_index_of_from(haystack: String, needle: String, pos: Int) -> Int? {
  if pos + string_length(s: needle) > string_length(s: haystack) {
    none
  } else if substring(s: haystack, start: pos, end: pos + string_length(s: needle)) == needle {
    Present { value: pos }
  } else {
    string_index_of_from(haystack: haystack, needle: needle, pos: pos + 1)
  }
}

fn string_index_of(haystack: String, needle: String) -> Int? {
  string_index_of_from(haystack: haystack, needle: needle, pos: 0)
}

fn wire_variant_tag_for_policy(authored: String, policy: RustEnumWireSerde) -> String? {
  if policy.error_message != none {
    none
  } else {
    match policy.rename_style {
      Present { value: style } =>
        if style == "StripAffixAndSnakeCase" {
          let without_prefix = match policy.rename_prefix {
            Present { value: prefix } => match string_without_prefix(value: authored, prefix: prefix) {
              Present { value: stripped } => stripped
              Absent => return none
            }
            Absent => authored
          }
          let without_suffix = match policy.rename_suffix {
            Present { value: suffix } => match string_without_suffix(value: without_prefix, suffix: suffix) {
              Present { value: stripped } => stripped
              Absent => return none
            }
            Absent => without_prefix
          }
          Present { value: to_snake(name: without_suffix) }
        } else {
          none
        }
      Absent =>
        if contains(policy.enum_attr, "rename_all = \"snake_case\"") {
          Present { value: to_snake(name: authored) }
        } else if policy.enum_attr == "" && policy.rename_prefix == none && policy.rename_suffix == none {
          Present { value: authored }
        } else {
          none
        }
    }
  }
}

fn policy_serde_tag_field(policy: RustEnumWireSerde) -> String? {
  let needle = "tag = \""
  match string_index_of(haystack: policy.enum_attr, needle: needle) {
    Present { value: start } =>
      let after = start + string_length(s: needle)
      match string_index_of_from(haystack: policy.enum_attr, needle: "\"", pos: after) {
        Present { value: end } =>
          Present { value: substring(s: policy.enum_attr, start: after, end: end) }
        Absent => none
      }
    Absent => none
  }
}

fn policy_is_untagged(policy: RustEnumWireSerde) -> Bool {
  contains(policy.enum_attr, "untagged")
}

fn policy_is_string_variant(policy: RustEnumWireSerde) -> Bool {
  !contains(policy.enum_attr, "tag =")
    && policy.rename_prefix == none
    && policy.rename_suffix == none
    && policy.rename_style == none
}

fn wire_variant_rename_attr_for_policy(authored: String, policy: RustEnumWireSerde) -> String {
  match wire_variant_tag_for_policy(authored: authored, policy: policy) {
    Present { value: tag } =>
      match policy.rename_style {
        Present { value: style } =>
          if style == "StripAffixAndSnakeCase" {
            concat("    #[serde(rename = \"", tag, "\")]\n")
          } else {
            ""
          }
        Absent => ""
      }
    Absent => ""
  }
}

fn variant_rename_validation_for_policy(authored: String, policy: RustEnumWireSerde) -> String {
  match policy.rename_style {
    Present { value: style } =>
      if style == "StripAffixAndSnakeCase" {
        let without_prefix = match policy.rename_prefix {
          Present { value: prefix } => match string_without_prefix(value: authored, prefix: prefix) {
            Present { value: stripped } => stripped
            Absent => return emit_rust_compile_error_item(message: concat("variant ", authored, " does not satisfy declared wire rename prefix: ", prefix))
          }
          Absent => authored
        }
        match policy.rename_suffix {
          Present { value: suffix } => match string_without_suffix(value: without_prefix, suffix: suffix) {
            Present { value: _ } => ""
            Absent => emit_rust_compile_error_item(message: concat("variant ", authored, " does not satisfy declared wire rename suffix: ", suffix))
          }
          Absent => ""
        }
      } else {
        ""
      }
    Absent => ""
  }
}

fn variant_rename_validations_for_policy(children: List<Node>, env: TypeEnv, serde_policy: RustEnumWireSerde) -> String {
  children
    |> map(child => variant_rename_validation_for_policy(authored: authored_name(env: env, node: child), policy: serde_policy))
    |> filter(text => text != "")
    |> join(separator: "\n")
}

fn enum_variant_field_type_node(env: TypeEnv, enum_name: String, variant_name: String, field_name: String, fallback: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  match lookup_type_by_name(env: env, name: enum_name) {
    Present { value: enum_node } =>
      match find_child_named(n: enum_node, name: variant_name, source_indices: source_indices) {
        Present { value: variant } =>
          match find_child_named(n: variant, name: field_name, source_indices: source_indices) {
            Present { value: field } =>
              if field.inferred != none { resolved_type(n: field) } else { fallback }
            Absent => fallback
          }
        Absent => fallback
      }
    Absent => fallback
  }
}

fn render_variant_payload_type(n: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  if n.connective == NoConnective && n.children |> count > 0 {
    let tn = authored_name_at(source_indices: source_indices, node: n)
    let args = n.children |> map(c => render_rust_type(n: child_type_node(ch: c), shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info()))
    let spec = language_spec(target: Rust)
    concat(coerce_primitive_type(target: Rust, dag_name: tn), spec.type_arg_open, args |> join(separator: ", "), spec.type_arg_close)
  } else {
    render_rust_type(n: n, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info())
  }
}

fn variant_is_synthetic_positional_payload(fields: List<Node>, source_indices: Map<String, NewlineIndex>) -> Bool {
  if fields |> count != 1 {
    false
  } else {
    match fields |> first {
      Present { value: f } => field_node_name_at(n: f, source_indices: source_indices) == "0"
      Absent => false
    }
  }
}

fn emit_variant_from_child(child: Node, enum_name: String, generic_param_names: List<String>, recursive_types: Set<String>, shared_types: Set<String>, env: TypeEnv, serde_policy: RustEnumWireSerde, emit_info: EmitGraphInfo) -> String {
  let child_text = authored_name(env: env, node: child)
  let rename_attr = wire_variant_rename_attr_for_policy(authored: child_text, policy: serde_policy)
  if child.children |> count == 0 {
    concat(rename_attr, "    ", child_text, ",")
  } else if child.children |> count == 1 {
    let positional_payload = variant_is_synthetic_positional_payload(fields: child.children, source_indices: env.source_indices)
    let tuple_style = positional_payload || (serde_policy.enum_attr == "#[serde(untagged)]")
    if tuple_style {
      match child.children |> first {
        Present { value: f } =>
          let fallback = resolved_type(n: f)
          let type_node = if positional_payload {
            enum_variant_field_type_node(env: env, enum_name: enum_name, variant_name: child_text, field_name: "0", fallback: fallback, source_indices: env.source_indices)
          } else { fallback }
          let raw_ty = if positional_payload {
            render_variant_payload_type(n: type_node, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices)
          } else {
            render_rust_type(n: type_node, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices, emit_info: emit_info)
          }
          let ty = if find_property(props: type_node.properties, prop_name: "__applied_type_args", source_indices: env.source_indices) != none { render_rust_type_with_applied_binding(n: type_node, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices) } else { raw_ty }
          let final_ty = if needs_box_wrapping(n: type_node, recursive_types: recursive_types, shared_types: shared_types, source_indices: env.source_indices) {
            concat("Box<", ty, ">")
          } else { ty }
          concat(rename_attr, "    ", child_text, "(", final_ty, "),")
        Absent => concat(rename_attr, "    ", child_text, ",")
      }
    } else {
      let field_lines = child.children |> map(f =>
        let rt_f = resolved_type(n: f)
        let ty = render_rust_field_type_with_applied_binding(field: f, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
        let final_ty = if needs_box_wrapping(n: rt_f, recursive_types: recursive_types, shared_types: shared_types, source_indices: env.source_indices) {
          concat("Box<", ty, ">")
        } else { ty }
        emit_rust_field_definition(authored: authored_name(env: env, node: f), final_ty: final_ty, rename_attr: "", indent: "        ", visibility: "", needs_serde: true)
      )
      let fields_str = field_lines |> join(separator: "\n")
      concat(rename_attr, "    ", child_text, " {\n", fields_str, "\n    },")
    }
  } else {
    let field_lines = child.children |> map(f =>
      let rt_f = resolved_type(n: f)
      let ty = render_rust_field_type_with_applied_binding(field: f, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: env.source_indices, variant_to_enum: emit_info.variant_to_enum, env: env)
      let final_ty = if needs_box_wrapping(n: rt_f, recursive_types: recursive_types, shared_types: shared_types, source_indices: env.source_indices) {
        concat("Box<", ty, ">")
      } else { ty }
      emit_rust_field_definition(authored: authored_name(env: env, node: f), final_ty: final_ty, rename_attr: "", indent: "        ", visibility: "", needs_serde: true)
    )
    let fields_str = field_lines |> join(separator: "\n")
    concat(rename_attr, "    ", child_text, " {\n", fields_str, "\n    },")
  }
}

fn emit_fn_def(name: String, params: List<Node>, inferred: Node, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  let host_text_op = if corpus_repr_is_host(corpus_repr: emit_info.corpus_repr) {
    rust_host_string_op_fn_emit(name: name)
  } else { none }
  if host_text_op != none {
    return match host_text_op {
      Present { value: op_fn } => op_fn
      Absent => ""
    }
  }
  match rust_host_string_seam_fn_emit(name: name) {
    Present { value: seam_fn } =>
      if corpus_repr_is_faithful(corpus_repr: emit_info.corpus_repr) { seam_fn } else { "" }
    Absent => {
  let type_params = function_type_params(params: params)
  let value_params = function_value_params(params: params)

  if function_type_params_have_collision(type_params: type_params) {
    return concat("compile_error!(\"type param name collides with a value param in fn '", name, "' — a value param shares its name with a declared type param; rename the value param or dissolve via ParamKind/params-slot partition\");\n")
  }
  let generic_param_names = type_params |> map(p => generic_param_name_at(n: p, source_indices: si))
  let body_emit_info = emit_info_with_fn_return(
    emit_info: emit_info_with_fn_type_context(emit_info: emit_info, generic_param_names: generic_param_names, env: scope.type_env),
    fn_return_type: Present { value: inferred }
  )
  let value_param_names = value_params |> map(p => p.name)
  let ret_name = authored_name_at(source_indices: si, node: inferred)
  let return_is_bare_generic = (generic_param_names |> filter(g => g == ret_name) |> count) > 0
  let body_is_param_ref = (value_param_names |> filter(n => n == body.name) |> count) > 0
  let clone_param_names = v1_generic_params_needing_clone_bound(
    generic_param_names: generic_param_names,
    value_params: value_params,
    return_is_bare_generic: return_is_bare_generic,
    ret_name: ret_name,
    body_is_param_ref: body_is_param_ref,
    source_indices: si
  )
  let needs_clone_bound = (clone_param_names |> count) > 0
  let type_params_str = if needs_clone_bound {
    v1_emit_type_params_with_clone_bounds(params: type_params, clone_param_names: clone_param_names, source_indices: si)
  } else {
    emit_type_params(params: type_params, source_indices: si)
  }
  let params_str = emit_params(params: value_params, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: si, read_only_params: emit_info.read_only_params, variant_to_enum: emit_info.variant_to_enum, env: scope.type_env)
  let ret_str = emit_inferred(inferred: inferred, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: si, variant_to_enum: emit_info.variant_to_enum, env: scope.type_env)
  let body_scope = build_params_scope(scope: scope, params: value_params)
  let depth = 0
  let use_tco = is_tco_eligible(name: name, body: body, registry: registry, source_indices: si)
  let needs_stacker = is_self_recursive(name: name, body: body, registry: registry, source_indices: si) && use_tco == false
  if use_tco {
    let tco_params_str = emit_tco_params(params: value_params, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: si, variant_to_enum: emit_info.variant_to_enum, env: scope.type_env)
    let body_str = emit_typed_tco_body(texpr: body, fn_name: name, params: value_params, registry: registry, scope: body_scope, depth: depth + 1, shared_types: shared_types, emit_info: body_emit_info)
    let kw = rust_items().func_keyword
    concat(rust_visibility_prefix(), kw, " ", emit_ident(name: name, target: Rust), type_params_str, "(", tco_params_str, ")", ret_str, " {\n",
      make_indent(level: depth + 1),body_str, "\n}")
  } else {
    let return_is_unit = return_type_is_unit(n: inferred, source_indices: si)
    emit_fn_def_non_tco(name: name, type_params_str: type_params_str, params_str: params_str, ret_str: ret_str, body: body, registry: registry, scope: body_scope, depth: depth, shared_types: shared_types, emit_info: body_emit_info, needs_stacker: needs_stacker, return_is_unit: return_is_unit)
  }
    }
  }
}

fn return_type_is_unit(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let authored = authored_name_at(source_indices: source_indices, node: n)
  let name = if authored != "" { authored } else { n.name }
  is_unit_like(n: n) && name == "Unit"
}

fn emit_rust_fn_body_expr(texpr: Node, return_is_unit: Bool, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  if return_is_unit {
    emit_rust_unit_discarding_stmt(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  } else {
    emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  }
}

fn inferred_expr_is_optional(texpr: Node) -> Bool {
  match texpr.inferred {
    Present { value: Resolved { node: rt } } => rt.return_cardinality == CardOptional
    _ => false
  }
}

fn emit_rust_unit_discarding_optional_typed(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match texpr.expr_data {
    ExprLiteral { value: v } =>
      match v {
        LitNull => "()"
        _ => emit_error_expr(message: "unit-discard: optional literal with unexpected value shape", target: Rust)
      }
    ExprRecordLit { parent_enum: _ } =>
      match texpr.children |> count {
        0 => "()"
        1 =>
          match texpr.children |> first {
            Present { value: f } =>
              emit_rust_unit_discarding_stmt(texpr: field_init_node_value(n: f), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
            Absent => emit_error_expr(message: "unit-discard: optional record literal missing payload field", target: Rust)
          }
        _ => emit_error_expr(message: "unit-discard: optional record literal with unexpected field count", target: Rust)
      }
    _ =>
      emit_error_expr(message: "unit-discard: unsupported optional expression form for Unit return", target: Rust)
  }
}

fn emit_rust_unit_discarding_stmt(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  match texpr.expr_data {
    ExprLet =>
      let v = let_value(texpr: texpr)
      let inner = let_body(texpr: texpr)
      if inferred_expr_is_optional(texpr: v) {
        match inner {
          Present { value: bd } =>
            concat(emit_rust_unit_discarding_stmt(texpr: v, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info), "\n", emit_rust_unit_discarding_stmt(texpr: bd, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
          Absent => emit_rust_unit_discarding_stmt(texpr: v, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
        }
      } else {
        let n = let_binding_name_at(texpr: texpr, source_indices: si)
        let val_str = emit_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
        let let_line = emit_let_binding(name: n, value: val_str, target: Rust)
        match inner {
          Present { value: bd } =>
            concat(let_line, "\n", emit_rust_unit_discarding_stmt(texpr: bd, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
          Absent => let_line
        }
      }
    ExprBlock =>
      texpr.children
        |> map(child => emit_rust_unit_discarding_stmt(texpr: child, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
        |> join(separator: "\n")
    ExprIf =>
      let c = if_condition(texpr: texpr)
      let t = if_then_branch(texpr: texpr)
      let e = if_else_branch(texpr: texpr)
      let cond_str = emit_typed_expr(texpr: c, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let then_str = emit_rust_unit_discarding_stmt(texpr: t, registry: registry, scope: scope, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
      match e {
        Present { value: eb } =>
          let else_str = emit_rust_unit_discarding_stmt(texpr: eb, registry: registry, scope: scope, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
          concat("if ", cond_str, " {\n", make_indent(level: depth + 1), then_str, "\n} else {\n", make_indent(level: depth + 1), else_str, "\n}")
        Absent =>
          concat("if ", cond_str, " {\n", make_indent(level: depth + 1), then_str, "\n}")
      }
    ExprRecordLit { parent_enum: _ } =>
      if inferred_expr_is_optional(texpr: texpr) {
        emit_rust_unit_discarding_optional_typed(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else {
        concat(emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ";")
      }
    ExprLiteral { value: v } =>
      if inferred_expr_is_optional(texpr: texpr) {
        emit_rust_unit_discarding_optional_typed(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      } else {
        match v { LitNull => "()"  _ => concat(emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ";") }
      }
    ExprVar { binding_kind: _ } =>
      concat(emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ";")
    _ =>
      concat(emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ";")
  }
}

fn emit_fn_def_non_tco(name: String, type_params_str: String, params_str: String, ret_str: String, body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo, needs_stacker: Bool, return_is_unit: Bool) -> String {
  if needs_stacker {
    let body_str = emit_rust_fn_body_expr(texpr: body, return_is_unit: return_is_unit, registry: registry, scope: scope, depth: depth + 2, shared_types: shared_types, emit_info: emit_info)
    let kw = rust_items().func_keyword
    concat(rust_visibility_prefix(), kw, " ", emit_ident(name: name, target: Rust), type_params_str, "(", params_str, ")", ret_str, " {\n",
      make_indent(level: depth + 1), "stacker::maybe_grow(512 * 1024, 2 * 1024 * 1024, || {\n",
      make_indent(level: depth + 2), body_str, "\n",
      make_indent(level: depth + 1), "})\n}")
  } else {
    let body_str = emit_rust_fn_body_expr(texpr: body, return_is_unit: return_is_unit, registry: registry, scope: scope, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
    let kw = rust_items().func_keyword
    concat(rust_visibility_prefix(), kw, " ", emit_ident(name: name, target: Rust), type_params_str, "(", params_str, ")", ret_str, " {\n",
      make_indent(level: depth + 1), body_str, "\n}")
  }
}

fn emit_func_def(
  name: String,
  params: List<Node>,
  inferred: Node,
  uses: List<Node>,
  body: Node,
  registry: Map<String, ItemInfo>,
  scope: InferScope,
  shared_types: Set<String>,
  emit_info: EmitGraphInfo
) -> String {

  if function_type_params(params: params) |> count > 0 {
    return concat("compile_error!(\"emit_func_def saw type params in `", name, "` — func/pattern/interface don't route through the generic-fn split today; the parser invariant at parse_block_body_from_prefix has changed. Plumb type_params through this path or dissolve via ParamKind/params-slot partition.\");\n")
  }
  let depth = 0
  let service_names = match lookup_item(registry: registry, name: name) {
    Present { value: info } => info.service_names
    Absent => []
  }
  let params_str = emit_func_params(params: params, uses: uses, service_names: service_names, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices, read_only_params: emit_info.read_only_params, variant_to_enum: emit_info.variant_to_enum, env: scope.type_env)
  let ret_str = emit_func_inferred(inferred: inferred, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: scope.type_env.source_indices)
  let body_scope = build_params_scope(scope: scope, params: params)
  let si = scope.type_env.source_indices
  let body_scope = fold(uses, init: body_scope, f: (s, u) =>
    extend_scope(scope: s, name: resource_use_name_at(n: u, source_indices: si), resolved: resource_use_resource(n: u), provenance: SubValueUnknown)
  )
  let body_str = emit_func_body(body: body, registry: registry, scope: body_scope, depth: depth + 1, shared_types: shared_types, emit_info: emit_info)
  let items = rust_items()
  concat(rust_visibility_prefix(), items.async_prefix, items.func_keyword, " ", emit_ident(name: name, target: Rust),
    "(", params_str, ")", ret_str, " {\n",
    make_indent(level: depth + 1),body_str, "\n}")
}

fn emit_func_body(body: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  match body.expr_data {
    ExprLet => {
      let n = let_binding_name_at(texpr: body, source_indices: si)
      let v = let_value(texpr: body)
      let inner = let_body(texpr: body)
      let val_str = emit_typed_expr(texpr: v, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
      let let_line = emit_let_binding(name: n, value: val_str, target: Rust)
      let next_scope = extend_scope(scope: scope, name: n, resolved: resolved_type(n: v), provenance: SubValueUnknown)
      match inner {
        Present { value: bd } =>
          concat(let_line, "\n", emit_func_body(body: bd, registry: registry, scope: next_scope, depth: depth, shared_types: shared_types, emit_info: emit_info))
        Absent => let_line
      }
    }
    ExprBlock => {
      let ss = body.children
      if ss |> count == 0 {
        "Ok(())"
      } else {
        let init_state = emit_rust_init_block_stmts(
          remaining: ss, text: [], scope: scope, registry: registry, depth: depth, shared_types: shared_types, emit_info: emit_info)
        let last_stmt = ss |> last
        let last_str = match last_stmt {
          Present { value: s } =>
            match s.expr_data {
              ExprReturn => concat("return Ok(", emit_typed_expr(texpr: return_value(texpr: s), registry: registry, scope: init_state.scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ")")
              _ => concat("Ok(", emit_typed_expr(texpr: s, registry: registry, scope: init_state.scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ")")
            }
          Absent => "Ok(())"
        }
        if init_state.text |> count == 0 { last_str } else { concat(init_state.text |> join(separator: "\n"), "\n", last_str) }
      }
    }
    ExprReturn => concat("return Ok(", emit_typed_expr(texpr: return_value(texpr: body), registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ")")
    _ => concat("Ok(", emit_typed_expr(texpr: body, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024), ")")
  }
}

fn emit_tco_params(params: List<Node>, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  let strs = params |> map(p => emit_tco_param(param: p, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env))
  strs |> join(separator: ", ")
}

fn emit_tco_param(param: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  let authored = param_node_type_expr(n: param)
  let ty = if authored.params |> count > 0 {
    emit_rust_param_type(n: authored, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  } else {
    render_rust_param_sig_type(param: param, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  concat("mut ", emit_ident(name: param_node_name_at(n: param, source_indices: source_indices), target: Rust), rust_items().param_type_sep, ty)
}

fn emit_func_params(params: List<Node>, uses: List<Node>, service_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, read_only_params: Set<String>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  let param_strs = params |> map(p => emit_param(param: p, generic_param_names: [], shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, read_only_params: read_only_params, variant_to_enum: variant_to_enum, env: env))
  let resource_strs = uses |> map(u =>
    concat(emit_ident(name: resource_use_name_at(n: u, source_indices: source_indices), target: Rust), ": &", render_rust_type(n: resource_use_resource(n: u), shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info()))
  )
  let service_strs = service_names |> map(sn =>
    concat(service_var_name(service_name: sn), ": &", sanitize_service_name(name: sn))
  )
  let all_params = concat(param_strs, resource_strs, service_strs)
  all_params |> join(separator: ", ")
}

fn emit_func_inferred(inferred: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  concat(" -> Result<", render_rust_type(n: inferred, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info()), ", Box<dyn std::error::Error>>")
}

fn emit_params(params: List<Node>, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, read_only_params: Set<String>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  let strs = params |> map(p => emit_param(param: p, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, read_only_params: read_only_params, variant_to_enum: variant_to_enum, env: env))
  strs |> join(separator: ", ")
}

fn render_rust_param_sig_type(param: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  let type_node = resolved_type(n: param)
  render_rust_fn_sig_type(n: type_node, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
}

fn emit_rust_param_type(n: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  if n.params |> count > 0 {
    let param_types = n.params |> map(p => render_rust_fn_sig_type(n: param_node_type_expr(n: p), generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env))
    let param_str = param_types |> join(separator: ", ")
    let ret_str = match n.inferred {
      Present { value: Resolved { node: rt } } => render_rust_fn_sig_type(n: rt, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
      _ => "()"
    }
    concat("impl Fn(", param_str, ") -> ", ret_str, " + Clone")
  } else {
    render_rust_fn_sig_type(n: n, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
}

fn emit_param(param: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, read_only_params: Set<String>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  let pname = param_node_name_at(n: param, source_indices: source_indices)
  let authored = param_node_type_expr(n: param)
  let ty = if authored.params |> count > 0 {
    emit_rust_param_type(n: authored, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  } else {
    render_rust_param_sig_type(param: param, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env)
  }
  concat(emit_ident(name: pname, target: Rust), rust_items().param_type_sep, ty)
}

fn emit_inferred(inferred: Node, generic_param_names: List<String>, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>, variant_to_enum: Map<String, String>, env: TypeEnv) -> String {
  concat(rust_items().return_arrow, render_rust_fn_sig_type(n: inferred, generic_param_names: generic_param_names, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, variant_to_enum: variant_to_enum, env: env))
}

fn needs_reference_node(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  if n.connective != NoConnective || n.children |> count > 0 {
    true
  } else {
    let is_copy = is_rust_value_type(n: n, source_indices: source_indices)
      || (is_product_type(n: n) && n.children |> count == 0)
    is_copy == false
  }
}

fn is_string_lit_pattern(p: MatchPattern) -> Bool {
  match p {
    LitPattern { value: v } =>
      match v { LitStr { value: _ } => true  _ => false }
    _ => false
  }
}

fn pattern_string_binding_name(path: List<String>) -> String {
  if path |> count == 0 {
    "__pos0_val"
  } else {
    let segments = path |> map(seg => emit_ident(name: seg, target: Rust))
    concat("__pos_", segments |> join(separator: "_"), "_val")
  }
}

fn positional_payload_string_guard(fb_pat: MatchPattern, bind_name: String) -> String {
  match fb_pat {
    LitPattern { value: LitStr { value: s } } =>
      concat(bind_name, " == ", emit_string_literal(s: s, suffix: ""))
    _ => ""
  }
}

fn collect_field_binding_string_guards(field_bindings: List<Node>, path_prefix: List<String>, source_indices: Map<String, NewlineIndex>) -> String {
  let parts = field_bindings |> flat_map(fb =>
    let fb_name = field_binding_name_at(n: fb, source_indices: source_indices)
    let fb_pat = field_binding_pattern(n: fb)
    if is_string_lit_pattern(p: fb_pat) {
      let field_path = if fb_name == "0" {
        list_push(path_prefix, "0")
      } else {
        list_push(path_prefix, fb_name)
      }
      let bind_name = pattern_string_binding_name(path: field_path)
      match positional_payload_string_guard(fb_pat: fb_pat, bind_name: bind_name) {
        "" => []
        guard => [guard]
      }
    } else {
      let nested_path = list_push(path_prefix, fb_name)
      let nested = collect_pattern_string_guards(pattern: fb_pat, path_prefix: nested_path, source_indices: source_indices)
      if nested == "" { [] } else { [nested] }
    }
  )
  parts |> join(separator: " && ")
}

fn collect_pattern_string_guards(pattern: MatchPattern, path_prefix: List<String>, source_indices: Map<String, NewlineIndex>) -> String {
  match pattern {
    VariantPattern { name: n, parent_enum: parent, field_bindings: fbs } =>
      if n == "Present" && parent == Present { value: "Optional" } && fbs |> count == 1 {
        match fbs |> first {
          Present { value: fb } =>
            let fb_pat = field_binding_pattern(n: fb)
            if is_string_lit_pattern(p: fb_pat) {
              match fb_pat {
                LitPattern { value: LitStr { value: s } } =>
                  concat("__some_val == ", emit_string_literal(s: s, suffix: ""))
                _ => ""
              }
            } else {

              collect_pattern_string_guards(pattern: fb_pat, path_prefix: list_push(path_prefix, "Some"), source_indices: source_indices)
            }
          Absent => ""
        }
      } else if fbs |> count == 1 {
        match fbs |> first {
          Present { value: fb } =>
            if field_binding_name_at(n: fb, source_indices: source_indices) == "0" {
              let fb_pat = field_binding_pattern(n: fb)
              let pos_path = list_push(list_push(path_prefix, n), "0")
              if is_string_lit_pattern(p: fb_pat) {
                positional_payload_string_guard(fb_pat: fb_pat, bind_name: pattern_string_binding_name(path: pos_path))
              } else {
                collect_pattern_string_guards(pattern: fb_pat, path_prefix: pos_path, source_indices: source_indices)
              }
            } else {
              collect_field_binding_string_guards(field_bindings: fbs, path_prefix: list_push(path_prefix, n), source_indices: source_indices)
            }
          Absent => ""
        }
      } else {
        collect_field_binding_string_guards(field_bindings: fbs, path_prefix: list_push(path_prefix, n), source_indices: source_indices)
      }
    _ => ""
  }
}

fn all_arms_are_string_lit(arms: List<Node>) -> Bool {
  arms |> all(arm =>
    match arm_pattern(n: arm) {
      LitPattern { value: v } =>
        match v { LitStr { value: _ } => true  _ => false }
      Wildcard => true
      _ => false
    }
  ) && arms |> count > 0
}

fn has_string_lit_with_bind(arms: List<Node>) -> Bool {
  let has_lit = arms |> any(arm => match arm_pattern(n: arm) {
    LitPattern { value: v } => match v { LitStr { value: _ } => true  _ => false }
    _ => false
  })
  let has_bind = arms |> any(arm => match arm_pattern(n: arm) {
    Bind { declaration: _ } => true
    _ => false
  })
  has_lit && has_bind
}

fn emit_pattern(pattern: MatchPattern, path_prefix: List<String>, shared_types: Set<String>, scrut_type: String, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  match pattern {
    Bind { declaration: n } => emit_ident(name: n.name, target: Rust)
    LitPattern { value: v } => rust_literal_for_pattern(value: v)
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      emit_variant_pattern(name: n, parent_enum: parent_enum, field_bindings: fbs, path_prefix: path_prefix, shared_types: shared_types, scrut_type: scrut_type, source_indices: source_indices, emit_info: emit_info)
    Wildcard => "_"
  }
}

fn pattern_parent_enum(name: String, parent_enum: String?, scrut_type: String, type_summaries: Map<String, TypeSummary>) -> String? {
  let scrut_is_known_enum = scrut_type != "" && is_enum_type_name(type_name: scrut_type, type_summaries: type_summaries)
  if parent_enum != none {
    parent_enum
  } else if scrut_is_known_enum {
    Present { value: scrut_type }
  } else {
    unique_variant_parent(type_summaries: type_summaries, variant_name: name)
  }
}

fn unique_variant_parent(type_summaries: Map<String, TypeSummary>, variant_name: String) -> String? {
  let parent_matches = sorted_map_keys(type_summaries)
    |> filter(type_name =>
      is_enum_type_name(type_name: type_name, type_summaries: type_summaries) &&
      variant_belongs_to_enum(type_summaries: type_summaries, variant_name: variant_name, enum_name: type_name)
    )
  if parent_matches |> count == 1 {
    parent_matches |> first
  } else {
    none
  }
}

fn is_optional_variant_name(name: String) -> Bool {
  name == "Present" || name == "Absent" || name == "Some" || name == "None"
}

fn is_optional_like_parent_name(name: String) -> Bool {
  name == "Optional" || name == "Diagnostics"
}

fn is_some_like_variant_name(name: String) -> Bool {
  name == "Present" || name == "Some"
}

fn is_optional_parent(parent_enum: String?) -> Bool {
  match parent_enum {
    Present { value: parent } => is_optional_like_parent_name(name: parent)
    Absent => false
  }
}

fn positional_payload_scrut_type(parent_enum: String?, variant_name: String, field_binding: Node, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String {
  let type_key = match parent_enum {
    Present { value: parent } => variant_summary_key(enum_name: parent, variant_name: variant_name)
    Absent => variant_name
  }
  match lookup_emit_type_summary(emit_info: emit_info, type_name: type_key) {
    Present { value: summary } =>
      match map_get(summary.field_type_map, "0") {
        Present { value: payload_type } => payload_type
        Absent =>
          match field_binding.inferred {
            Present { value: Resolved { node: rt } } =>
              authored_name_at(source_indices: source_indices, node: normalize_access_type_node(n: rt))
            _ => ""
          }
      }
    Absent =>
      match field_binding.inferred {
        Present { value: Resolved { node: rt } } =>
          authored_name_at(source_indices: source_indices, node: normalize_access_type_node(n: rt))
        _ => ""
      }
  }
}

data optional_pattern_unknown_parent_note: String = "Present/Absent patterns with an UNRESOLVED parent enum lower to Some/None (kernel Optional): a bare Present/Absent struct pattern is never valid emitted Rust (no bare variant of that name exists in any emitted scope), so the raw fallback arm could only ever produce a compile error. A modeled optional carrier (e.g. OptionalNode) still resolves its parent via pattern_parent_enum and takes the qualified path; only the parent-unknown residue (an unstamped scrutinee, e.g. a let-in-lambda pipeline) reroutes."

data variant_pattern_dotted_qualification_note: String = "Construction wall for the dotted-render class in PATTERN position (sibling of alias_rhs_qualified_name_routing_note, which covers TYPE position). A namespace-QUALIFIED variant/parent name in a match pattern (post source_authority, e.g. v2.extdeps.languages.dag.ParseSubtreeFound, or a dotted parent_enum from annotate_pattern_parent_enums's authored_name_at) is not a valid Rust path component: rustc reports 'expected one of ..., found {' or 'found .', a PARSE error that then masks every later error in the module. Rust pattern position never needs a crate::-qualified path (only import-line synthesis, a separate seam, brings the bare enum into scope) so the fix is simpler than alias_rhs: route both the variant name and the resolved parent through qualified_last_segment (v1.std.core, the same single authority) via variant_pattern_qualified_path, shared by emit_variant_pattern and emit_variant_pattern_rc_aware so the dotted-render fix is not forked a third time. Every already-bare pattern renders exactly as before (qualified_last_segment is the identity on an unqualified name)."

fn variant_pattern_qualified_path(rust_name: String, resolved_parent: String?) -> String {
  match resolved_parent {
    Present { value: parent } =>
      concat(qualified_last_segment(name: parent), "::", rust_name)
    Absent => rust_name
  }
}

fn variant_pattern_shape_key(rust_name: String, resolved_parent: String?) -> String {
  match resolved_parent {
    Present { value: parent } => concat(qualified_last_segment(name: parent), "::", rust_name)
    Absent => rust_name
  }
}

fn emit_variant_pattern(name: String, parent_enum: String?, field_bindings: List<Node>, path_prefix: List<String>, shared_types: Set<String>, scrut_type: String, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  let bare_name = qualified_last_segment(name: name)
  let resolved_parent = pattern_parent_enum(name: bare_name, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: emit_info.type_summaries)
  let optional_variant = is_optional_variant_name(name: bare_name)
    && (is_optional_parent(parent_enum: resolved_parent) || resolved_parent == none)
  let rust_name = if optional_variant {
    if is_some_like_variant_name(name: bare_name) { "Some" } else { "None" }
  } else { bare_name }
  let qualified = if optional_variant {
    rust_name
  } else {
    variant_pattern_qualified_path(rust_name: rust_name, resolved_parent: resolved_parent)
  }
  if optional_variant && is_some_like_variant_name(name: bare_name) && field_bindings |> count == 1 {
    match field_bindings |> first {
      Present { value: fb } =>
        let fb_pat = field_binding_pattern(n: fb)
        if is_string_lit_pattern(p: fb_pat) {
          "Some(ref __some_val)"
        } else {
          let inner_pat = emit_pattern(pattern: fb_pat, path_prefix: list_push(path_prefix, rust_name), shared_types: shared_types, scrut_type: scrut_type, source_indices: source_indices, emit_info: emit_info)
          concat("Some(", inner_pat, ")")
        }
      Absent => qualified
    }
  } else if field_bindings |> count == 1 {
    match field_bindings |> first {
      Present { value: fb } =>
        if field_binding_name_at(n: fb, source_indices: source_indices) == "0" {
          let fb_pat = field_binding_pattern(n: fb)
          let pos_path = list_push(list_push(path_prefix, bare_name), "0")
          let bind_name = pattern_string_binding_name(path: pos_path)
          if is_string_lit_pattern(p: fb_pat) {
            concat(qualified, "(ref ", bind_name, ")")
          } else {
            let payload_scrut = positional_payload_scrut_type(parent_enum: resolved_parent, variant_name: bare_name, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
            let inner_pat = emit_pattern(pattern: fb_pat, path_prefix: pos_path, shared_types: shared_types, scrut_type: payload_scrut, source_indices: source_indices, emit_info: emit_info)
            concat(qualified, "(", inner_pat, ")")
          }
        } else {
          let fb_name = field_binding_name_at(n: fb, source_indices: source_indices)
          let fb_pat = field_binding_pattern(n: fb)
          if is_string_lit_pattern(p: fb_pat) {
            let bind_name = pattern_string_binding_name(path: list_push(list_push(path_prefix, bare_name), fb_name))
            concat(qualified, " { ref ", bind_name, ", .. }")
          } else {
            let pat_str = emit_pattern(pattern: fb_pat, path_prefix: list_push(list_push(path_prefix, bare_name), fb_name), shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
            concat(qualified, " { ", concat(emit_ident(name: fb_name, target: Rust), ": ", pat_str), ", .. }")
          }
        }
      Absent => qualified
    }
  } else if field_bindings |> count == 0 {
    let shape_key = variant_pattern_shape_key(rust_name: rust_name, resolved_parent: resolved_parent)
    let is_positional = set_contains(emit_info.positional_payload_variants, shape_key)
      || set_contains(emit_info.positional_payload_variants, qualified)
    let is_fielded = set_contains(emit_info.fielded_variants, shape_key)
      || set_contains(emit_info.fielded_variants, qualified)
    if is_positional { concat(qualified, "(_)") }
    else if is_fielded { concat(qualified, " { .. }") } else { qualified }
  } else {
    let effective_bindings = field_bindings |> filter(fb =>
      match field_binding_pattern(n: fb) { Wildcard => false  _ => true }
    )
    if effective_bindings |> count == 0 {
      let shape_key2 = variant_pattern_shape_key(rust_name: rust_name, resolved_parent: resolved_parent)
      let is_positional2 = set_contains(emit_info.positional_payload_variants, shape_key2)
        || set_contains(emit_info.positional_payload_variants, qualified)
      let is_fielded2 = set_contains(emit_info.fielded_variants, shape_key2)
        || set_contains(emit_info.fielded_variants, qualified)
      if is_positional2 { concat(qualified, "(_)") }
      else if is_fielded2 { concat(qualified, " { .. }") } else { qualified }
    } else {
      let binding_strs = effective_bindings |> map(fb =>
        let fb_name = field_binding_name_at(n: fb, source_indices: source_indices)
        let fb_pat = field_binding_pattern(n: fb)
        if is_string_lit_pattern(p: fb_pat) {
          let field_path = if fb_name == "0" {
            list_push(list_push(path_prefix, bare_name), "0")
          } else {
            list_push(list_push(path_prefix, bare_name), fb_name)
          }
          let bind_name = pattern_string_binding_name(path: field_path)
          concat("ref ", bind_name)
        } else {
            let is_shorthand = match fb_pat { Bind { declaration: n } => n.name == fb_name  _ => false }
            if is_shorthand { emit_ident(name: fb_name, target: Rust) }
            else {
              let field_path = if fb_name == "0" {
                list_push(list_push(path_prefix, bare_name), "0")
              } else {
                list_push(list_push(path_prefix, bare_name), fb_name)
              }
              let pat_str = emit_pattern(pattern: fb_pat, path_prefix: field_path, shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
              concat(emit_ident(name: fb_name, target: Rust), ": ", pat_str)
            }
        }
      )
      let bindings_str = binding_strs |> join(separator: ", ")
      concat(qualified, " { ", bindings_str, ", .. }")
    }
  }
}

type RcPatternAnalysis {
  matches_rc_variant: Bool
  matches_option_rc_variant: Bool
  needs_rc_pattern: Bool
  ref_bound_fields: List<String>
}

type RcMatchAnalysis {
  needs_option_deref: Bool
  needs_deref: Bool
  needs_rc_option_ref: Bool
}

fn empty_rc_pattern_analysis() -> RcPatternAnalysis {
  RcPatternAnalysis {
    matches_rc_variant: false,
    matches_option_rc_variant: false,
    needs_rc_pattern: false,
    ref_bound_fields: []
  }
}

fn field_needs_rc_ref(field_name: String, rc_analysis: RcPatternAnalysis) -> Bool {
  rc_analysis.ref_bound_fields |> any(name => name == field_name)
}

fn analyze_rc_pattern(pattern: MatchPattern, scrut_type: String, shared_types: Set<String>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> RcPatternAnalysis {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      let bare_n = qualified_last_segment(name: n)
      if is_optional_variant_name(name: bare_n) && is_optional_parent(parent_enum: parent_enum) {
        if fbs |> count == 1 {
          match fbs |> first {
            Present { value: fb } =>
              let inner = analyze_rc_pattern(pattern: field_binding_pattern(n: fb), scrut_type: "", shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
              RcPatternAnalysis {
                matches_rc_variant: false,
                matches_option_rc_variant: is_some_like_variant_name(name: bare_n) && inner.matches_rc_variant,
                needs_rc_pattern: inner.needs_rc_pattern,
                ref_bound_fields: []
              }
            Absent => empty_rc_pattern_analysis()
          }
        } else { empty_rc_pattern_analysis() }
      } else {
        let resolved_parent = pattern_parent_enum(name: bare_n, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: emit_info.type_summaries)
        let matches_rc_variant = match resolved_parent {
          Present { value: enum_name } => set_contains(shared_types, enum_name)
          Absent => false
        }
        let ref_bound_fields = fbs |> flat_map(fb =>
          let fb_name = field_binding_name_at(n: fb, source_indices: source_indices)
          let inner_scrut = if fb_name == "0" {
            positional_payload_scrut_type(parent_enum: resolved_parent, variant_name: bare_n, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
          } else { "" }
          if analyze_rc_pattern(pattern: field_binding_pattern(n: fb), scrut_type: inner_scrut, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices).matches_rc_variant {
            [fb_name]
          } else { [] }
        )
        RcPatternAnalysis {
          matches_rc_variant: matches_rc_variant,
          matches_option_rc_variant: false,
          needs_rc_pattern: ref_bound_fields |> count > 0,
          ref_bound_fields: ref_bound_fields
        }
      }
    _ => empty_rc_pattern_analysis()
  }
}

fn box_bound_fields_for_pattern(pattern: MatchPattern, shared_types: Set<String>, emit_info: EmitGraphInfo, scope: InferScope) -> List<String> {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      let bare_n = qualified_last_segment(name: n)
      if is_optional_variant_name(name: bare_n) && is_optional_parent(parent_enum: parent_enum) {
        []
      } else {
        fbs |> flat_map(fb =>
          let fb_name = field_binding_name_at(n: fb, source_indices: scope.type_env.source_indices)
          let fb_pat = field_binding_pattern(n: fb)
          if fb_name == "0" {
            []
          } else {
            match fb_pat {
              Wildcard => []
              _ =>
                if rust_record_field_needs_box(scope: scope, emit_info: emit_info, shared_types: shared_types, struct_name: bare_n, field_name: fb_name) {
                  [fb_name]
                } else { [] }
            }
          }
        )
      }
    _ => []
  }
}

fn rc_pattern_analysis_with_box_fields(rc_analysis: RcPatternAnalysis, arm_pat: MatchPattern, shared_types: Set<String>, emit_info: EmitGraphInfo, scope: InferScope) -> RcPatternAnalysis {
  let box_fields = box_bound_fields_for_pattern(pattern: arm_pat, shared_types: shared_types, emit_info: emit_info, scope: scope)
  if box_fields |> count == 0 {
    rc_analysis
  } else {
    RcPatternAnalysis {
      matches_rc_variant: rc_analysis.matches_rc_variant,
      matches_option_rc_variant: rc_analysis.matches_option_rc_variant,
      needs_rc_pattern: true,
      ref_bound_fields: concat(rc_analysis.ref_bound_fields, box_fields)
    }
  }
}

fn analyze_rc_match(scrutinee: Node, arms: List<Node>, scrut_type: String, shared_types: Set<String>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> RcMatchAnalysis {
  let arm_analyses = arms |> map(arm =>
    analyze_rc_pattern(pattern: arm_pattern(n: arm), scrut_type: scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
  )
  let scrutinee_is_optional = match scrutinee.inferred {
    Present { value: Resolved { node: rt } } => rt.return_cardinality == CardOptional
    _ => false
  }
  let scrutinee_is_rc_wrapped = match scrutinee.inferred {
    Present { value: Resolved { node: rt } } =>
      if rt.children |> count == 0 && rt.ident_span != none {
        set_contains(shared_types, authored_name_at(source_indices: source_indices, node: rt))
      } else { false }
    _ => false
  }
  let arms_want_option = arm_analyses |> any(a => a.matches_option_rc_variant)
  let arms_want_deref = arm_analyses |> any(a => a.matches_rc_variant)
  let scrutinee_is_rc_modeled_optional = match scrutinee.inferred {
    Present { value: Resolved { node: rt } } =>
      is_optional_like_parent_name(name: authored_name_at(source_indices: source_indices, node: rt))
        && rt.return_cardinality != CardOptional
        && rust_type_is_rc_wrapped(type_name: render_rust_type(n: rt, shared_types: shared_types, corpus_repr: emit_info.corpus_repr, source_indices: source_indices, emit_info: emit_info))
    _ => false
  }

  RcMatchAnalysis {
    needs_option_deref: arms_want_option,
    needs_deref: if scrutinee_is_optional || scrutinee_is_rc_modeled_optional { false } else { scrutinee_is_rc_wrapped || arms_want_deref },
    needs_rc_option_ref: scrutinee_is_rc_modeled_optional
  }
}

fn emit_pattern_rc_aware(pattern: MatchPattern, path_prefix: List<String>, rc_analysis: RcPatternAnalysis, shared_types: Set<String>, scrut_type: String, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  match pattern {
    Bind { declaration: n } => emit_ident(name: n.name, target: Rust)
    LitPattern { value: v } => rust_literal_for_pattern(value: v)
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      emit_variant_pattern_rc_aware(name: n, parent_enum: parent_enum, field_bindings: fbs, path_prefix: path_prefix, rc_analysis: rc_analysis, shared_types: shared_types, scrut_type: scrut_type, source_indices: source_indices, emit_info: emit_info)
    Wildcard => "_"
  }
}

fn emit_variant_pattern_rc_aware(name: String, parent_enum: String?, field_bindings: List<Node>, path_prefix: List<String>, rc_analysis: RcPatternAnalysis, shared_types: Set<String>, scrut_type: String, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  let bare_name = qualified_last_segment(name: name)
  let resolved_parent = pattern_parent_enum(name: bare_name, parent_enum: parent_enum, scrut_type: scrut_type, type_summaries: emit_info.type_summaries)
  let optional_variant = is_optional_variant_name(name: bare_name)
    && (is_optional_parent(parent_enum: resolved_parent) || resolved_parent == none)
  let rust_name = if optional_variant {
    if is_some_like_variant_name(name: bare_name) { "Some" } else { "None" }
  } else { bare_name }
  let qualified = if optional_variant {
    rust_name
  } else {
    variant_pattern_qualified_path(rust_name: rust_name, resolved_parent: resolved_parent)
  }
  if optional_variant && is_some_like_variant_name(name: bare_name) && field_bindings |> count == 1 {
    match field_bindings |> first {
      Present { value: fb } =>
        let fb_pat = field_binding_pattern(n: fb)
        if is_string_lit_pattern(p: fb_pat) {
          "Some(ref __some_val)"
        } else {
          let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
          let inner_pat = emit_pattern_rc_aware(pattern: fb_pat, path_prefix: list_push(path_prefix, rust_name), rc_analysis: inner_analysis, shared_types: shared_types, scrut_type: scrut_type, source_indices: source_indices, emit_info: emit_info)
          concat("Some(", inner_pat, ")")
        }
      Absent => qualified
    }
  } else if field_bindings |> count == 1 {
    match field_bindings |> first {
      Present { value: fb } =>
        if field_binding_name_at(n: fb, source_indices: source_indices) == "0" {
          let fb_pat = field_binding_pattern(n: fb)
          let pos_path = list_push(list_push(path_prefix, bare_name), "0")
          let bind_name = pattern_string_binding_name(path: pos_path)
          if is_string_lit_pattern(p: fb_pat) {
            concat(qualified, "(ref ", bind_name, ")")
          } else {
            let payload_scrut = positional_payload_scrut_type(parent_enum: resolved_parent, variant_name: bare_name, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
            let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: payload_scrut, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
            let inner_pat = emit_pattern_rc_aware(pattern: fb_pat, path_prefix: pos_path, rc_analysis: inner_analysis, shared_types: shared_types, scrut_type: payload_scrut, source_indices: source_indices, emit_info: emit_info)
            concat(qualified, "(", inner_pat, ")")
          }
        } else {
          let fb_name = field_binding_name_at(n: fb, source_indices: source_indices)
          let fb_pat = field_binding_pattern(n: fb)
          if is_string_lit_pattern(p: fb_pat) {
            let bind_name = pattern_string_binding_name(path: list_push(list_push(path_prefix, bare_name), fb_name))
            concat(qualified, " { ref ", bind_name, ", .. }")
          } else if field_needs_rc_ref(field_name: fb_name, rc_analysis: rc_analysis) {
            concat(qualified, " { ref ", emit_ident(name: fb_name, target: Rust), ", .. }")
          } else {
            let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: scrut_type, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
            let pat_str = emit_pattern_rc_aware(pattern: fb_pat, path_prefix: list_push(list_push(path_prefix, bare_name), fb_name), rc_analysis: inner_analysis, shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
            concat(qualified, " { ", concat(emit_ident(name: fb_name, target: Rust), ": ", pat_str), ", .. }")
          }
        }
      Absent => qualified
    }
  } else if field_bindings |> count == 0 {
    let shape_key = variant_pattern_shape_key(rust_name: rust_name, resolved_parent: resolved_parent)
    let is_positional = set_contains(emit_info.positional_payload_variants, shape_key)
      || set_contains(emit_info.positional_payload_variants, qualified)
    let is_fielded = set_contains(emit_info.fielded_variants, shape_key)
      || set_contains(emit_info.fielded_variants, qualified)
    if is_positional { concat(qualified, "(_)") }
    else if is_fielded { concat(qualified, " { .. }") } else { qualified }
  } else {
    let effective_bindings = field_bindings |> filter(fb =>
      match field_binding_pattern(n: fb) { Wildcard => false  _ => true }
    )
    if effective_bindings |> count == 0 {
      let shape_key2 = variant_pattern_shape_key(rust_name: rust_name, resolved_parent: resolved_parent)
      let is_positional2 = set_contains(emit_info.positional_payload_variants, shape_key2)
        || set_contains(emit_info.positional_payload_variants, qualified)
      let is_fielded2 = set_contains(emit_info.fielded_variants, shape_key2)
        || set_contains(emit_info.fielded_variants, qualified)
      if is_positional2 { concat(qualified, "(_)") }
      else if is_fielded2 { concat(qualified, " { .. }") } else { qualified }
    } else {
      let binding_strs = effective_bindings |> map(fb =>
        let fb_name = field_binding_name_at(n: fb, source_indices: source_indices)
        let fb_pat = field_binding_pattern(n: fb)
        if is_string_lit_pattern(p: fb_pat) {
          let field_path = if fb_name == "0" {
            list_push(list_push(path_prefix, bare_name), "0")
          } else {
            list_push(list_push(path_prefix, bare_name), fb_name)
          }
          let bind_name = pattern_string_binding_name(path: field_path)
          concat("ref ", bind_name)
        } else {
          if field_needs_rc_ref(field_name: fb_name, rc_analysis: rc_analysis) {
            concat("ref ", emit_ident(name: fb_name, target: Rust))
          } else {
            let is_shorthand = match fb_pat { Bind { declaration: n } => n.name == fb_name  _ => false }
            if is_shorthand { emit_ident(name: fb_name, target: Rust) }
            else {
              let field_path = if fb_name == "0" {
                list_push(list_push(path_prefix, bare_name), "0")
              } else {
                list_push(list_push(path_prefix, bare_name), fb_name)
              }
              let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: "", shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
              let pat_str = emit_pattern_rc_aware(pattern: fb_pat, path_prefix: field_path, rc_analysis: inner_analysis, shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
              concat(emit_ident(name: fb_name, target: Rust), ": ", pat_str)
            }
          }
        }
      )
      let bindings_str = binding_strs |> join(separator: ", ")
      concat(qualified, " { ", bindings_str, ", .. }")
    }
  }
}

fn match_pattern_is_irrefutable(pattern: MatchPattern) -> Bool {
  match pattern {
    Bind { declaration: _ } => true
    Wildcard => true
    _ => false
  }
}

fn rc_pattern_preludes(pattern: MatchPattern, rc_analysis: RcPatternAnalysis, shared_types: Set<String>, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  match pattern {
    VariantPattern { name: n, parent_enum: parent_enum, field_bindings: fbs } =>
      let bare_n = qualified_last_segment(name: n)
      if is_optional_variant_name(name: bare_n) && is_optional_parent(parent_enum: parent_enum) {
        if fbs |> count == 1 {
          match fbs |> first {
            Present { value: fb } =>
              let fb_pat = field_binding_pattern(n: fb)
              let inner_analysis = analyze_rc_pattern(pattern: fb_pat, scrut_type: "", shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
              rc_pattern_preludes(pattern: fb_pat, rc_analysis: inner_analysis, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
            Absent => ""
          }
        } else { "" }
      } else {
        let resolved_parent = pattern_parent_enum(name: bare_n, parent_enum: parent_enum, scrut_type: "", type_summaries: emit_info.type_summaries)
        let preludes = fbs |> flat_map(fb =>
          let fb_name = field_binding_name_at(n: fb, source_indices: source_indices)
          if fb_name == "0" {
            let payload_scrut = positional_payload_scrut_type(parent_enum: resolved_parent, variant_name: bare_n, field_binding: fb, emit_info: emit_info, source_indices: source_indices)
            let inner_analysis = analyze_rc_pattern(pattern: field_binding_pattern(n: fb), scrut_type: payload_scrut, shared_types: shared_types, emit_info: emit_info, source_indices: source_indices)
            let inner_preludes = rc_pattern_preludes(pattern: field_binding_pattern(n: fb), rc_analysis: inner_analysis, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
            if inner_preludes == "" { [] } else { [inner_preludes] }
          } else if field_needs_rc_ref(field_name: fb_name, rc_analysis: rc_analysis) {
            let fb_pat_here = field_binding_pattern(n: fb)
            let bound_str = emit_pattern(pattern: fb_pat_here, path_prefix: list_push(list_push([], bare_n), fb_name), shared_types: shared_types, scrut_type: "", source_indices: source_indices, emit_info: emit_info)
            let tail = if match_pattern_is_irrefutable(pattern: fb_pat_here) {
              ";"
            } else {
              " else { unreachable!() };"
            }
            [concat("let ", bound_str, " = ", emit_ident(name: fb_name, target: Rust), ".as_ref()", tail)]
          } else { [] }
        )
        preludes |> join(separator: " ")
      }
    _ => ""
  }
}

fn explicit_record_struct_name(type_name: String?, inferred_node: Node, shared_types: Set<String>, source_indices: Map<String, NewlineIndex>) -> String? {
  let is_optional = inferred_node.return_cardinality == CardOptional
  if is_optional {
    let result = type_name
    return result
  }
  let has_structure = inferred_node.connective != NoConnective
  let n = if inferred_node.type_annotation != none && has_structure {
    match inferred_node.children |> first {
      Present { value: base } => base
      Absent => inferred_node
    }
  } else { inferred_node }
  let is_product = is_product_type(n: n)
  let is_coproduct = is_coproduct_type(n: n)
  let n_is_error = if n.inferred != none { is_compiler_error(inferred: n.inferred.value) } else { false }
  let nname = authored_name_at(source_indices: source_indices, node: n)
  if nname == "__EmitTypeCacheMiss" { type_name }
    else if n_is_error { type_name }
    else if is_product {
      if n.ident_span == none { type_name } else { Present { value: nname } }
    } else if is_coproduct {
      type_name
    } else if n.children |> count == 0 && n.ident_span != none {
      Present { value: nname }
    } else {
      type_name
    }
}

fn is_simple_type_node(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool { is_rust_value_type(n: n, source_indices: source_indices) }

fn variant_parent_from_binding_kind(binding_kind: VarBindingKind?) -> String? {
  match binding_kind {
    Present { value: VariantValueBinding { parent_enum: parent_enum } } => Present { value: parent_enum }
    _ => none
  }
}

fn apply_clone(expr: String) -> String {
  apply_type_template1(template: sharing_for_target(target: Rust).clone_value, arg0: expr)
}

fn apply_deref_clone(expr: String) -> String {
  apply_type_template1(template: sharing_for_target(target: Rust).deref_clone, arg0: expr)
}

fn apply_field_clone(expr: String, field: String) -> String {
  apply_type_template2(template: sharing_for_target(target: Rust).field_clone, arg0: expr, arg1: field)
}

fn clone_iterator_suffix() -> String {
  sharing_for_target(target: Rust).clone_suffix
}

fn freemonoid_empty_from_variant_parent(leaf_name: String, enum_name: String) -> Bool {
  leaf_name == "Empty" && enum_name == "FreeMonoid"
}

fn freemonoid_empty_from_emit_info(leaf_name: String, emit_info: EmitGraphInfo) -> Bool {
  leaf_name == "Empty" && match map_get(emit_info.variant_to_enum, "Empty") {
    Present { value: p } => p == "FreeMonoid"
    Absent => false
  }
}

fn emit_freemonoid_empty_rc_value() -> String {
  "Rc::new(vec![])"
}

fn emit_freemonoid_empty_variant_body() -> String {
  "vec![]"
}

fn effective_variant_parent_from_enum_lookup(leaf_name: String, rt: Node, binding_kind: VarBindingKind?, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  let rt_name = authored_name_at(source_indices: source_indices, node: rt)
  if rt.ident_span != none && rt_name != leaf_name && variant_belongs_to_enum(type_summaries: emit_info.type_summaries, variant_name: leaf_name, enum_name: rt_name) {
    Present { value: rt_name }
  } else {
    variant_parent_from_binding_kind(binding_kind: binding_kind)
  }
}

fn effective_variant_parent_from_resolved(leaf_name: String, rt: Node, binding_kind: VarBindingKind?, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  match rt.return_cardinality {
    CardOptional =>
      if is_optional_variant_name(name: leaf_name) { Present { value: "Optional" } } else { effective_variant_parent_from_enum_lookup(leaf_name: leaf_name, rt: rt, binding_kind: binding_kind, emit_info: emit_info, source_indices: source_indices) }
    _ => effective_variant_parent_from_enum_lookup(leaf_name: leaf_name, rt: rt, binding_kind: binding_kind, emit_info: emit_info, source_indices: source_indices)
  }
}

fn effective_variant_parent(name: String, binding_kind: VarBindingKind?, resolved_type: InferredNode?, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String? {
  let leaf_name = value_ref_qualified_leaf(name: name)
  let cached = match map_get(emit_info.variant_to_enum, leaf_name) {
    Present { value: p } => if p != "" { Present { value: p } } else { none }
    Absent => none
  }
  match cached {
    Present { value: parent } => Present { value: parent }
    Absent =>
      match resolved_type {
        Present { value: Resolved { node: rt } } =>
          effective_variant_parent_from_resolved(leaf_name: leaf_name, rt: rt, binding_kind: binding_kind, emit_info: emit_info, source_indices: source_indices)
        _ => variant_parent_from_binding_kind(binding_kind: binding_kind)
      }
  }
}

fn variant_ref_self_wraps(name: String, enum_name: String, shared_types: Set<String>, corpus_repr: RustCorpusRepr) -> Bool {
  freemonoid_empty_from_variant_parent(leaf_name: name, enum_name: enum_name) || set_contains(shared_types, enum_name)
}

data value_ref_ident_dotted_fallback_note: String = "Construction wall for the dotted-render class in VALUE-EXPRESSION position (sibling of variant_pattern_dotted_qualification_note/PATTERN, bare_qualified_name in emit_typed_record_lit/CONSTRUCTION, coerce_primitive_type_dotted_fallback_note/TYPE, and rust_fn_sig_leaf_name_dotted_note/FN-SIG TYPE). A namespace-qualified dotted name (e.g. v2.std.node.Edge) whose leaf misses the registry previously fell through to emit_ident(name: name, ...) with the FULL dotted string still attached — emit_ident has no dot-awareness (pure case-conversion/sanitization), so the dots rode straight into the emitted Rust as a bare field-access chain starting at the first segment (rustc: 'cannot find value v2 in this scope', E0425). Fixed by passing the already-computed leaf, the same qualified_last_segment (v1.std.core) reduction the Present arm already keys its registry lookup on — not a new fallback, the existing one corrected to use the value already in scope. The CALL-callee sibling (emit_typed_call's func_ident, e.g. a bare dotted function reference like v2.std.staging.resolve_probe(..) rendered verbatim) reuses this same fn directly rather than re-deriving the leaf a third time (DESIGN section 2/3: one shared helper, not a forked per-seam patch); its registry lookup (the `callee` binding) is likewise re-keyed on qualified_last_segment(func) so a dotted cross-module call resolves the same ItemInfo a bare call would. Every already-bare name renders exactly as before (qualified_last_segment is the identity on an unqualified name)."

fn emit_value_ref_ident(name: String, registry: Map<String, ItemInfo>, emit_info: EmitGraphInfo) -> String {
  if string_contains(s: name, pattern: ".") {
    let leaf = value_ref_qualified_leaf(name: name)
    match map_get(registry, leaf) {
      Present { value: info } =>
        concat("crate::", module_to_filename(name: info.module_name), "::", emit_import_name(n: leaf, registry: registry))
      Absent =>
        if freemonoid_empty_from_emit_info(leaf_name: leaf, emit_info: emit_info) { emit_freemonoid_empty_rc_value() }
        else { emit_ident(name: leaf, target: Rust) }
    }
  } else {
    emit_ident(name: name, target: Rust)
  }
}

data none_undetermined_carrier_refuse_note: String = "Fail-open closed (sharp-bee-290 msg_6317aebe / DESIGN §5): when none/None has no resolved variant_parent, the emitter previously emitted Rust null as a fabricated plausible default. variant_parent == none conflated (a) bare Optional none with a determined CardOptional carrier and (b) undetermined carrier. Split: CardOptional → None (type-directed); any other determined non-optional carrier → typed refuse; undetermined (Absent / non-Resolved inferred) → typed refuse. Never null as a default. The refuse surfaces as emit_error_expr (UNRESOLVED_… diagnostic text in emitted Rust) so the deficit is countable; if the refusal spike is corpus-red-large, fold a named counted interim INSIDE this single decision with an explicit dissolution trigger — never restore an escaping Optional default at callers."

fn emit_none_keyword_for_resolved_type(resolved_type: InferredNode?) -> String {
  match resolved_type {
    Present { value: Resolved { node: rt } } =>
      match rt.return_cardinality {
        CardOptional => emit_keyword(key: "null", target: Rust)
        _ => emit_error_expr(message: "none/None with non-optional resolved carrier — refuse fail-open null default", target: Rust)
      }
    _ => emit_error_expr(message: "none/None with undetermined carrier — refuse fail-open null default", target: Rust)
  }
}

fn emit_var_ref(name: String, binding_kind: VarBindingKind?, resolved_type: InferredNode?, shared_types: Set<String>, registry: Map<String, ItemInfo>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String {
  let leaf_name = value_ref_qualified_leaf(name: name)
  let variant_parent = effective_variant_parent(name: name, binding_kind: binding_kind, resolved_type: resolved_type, emit_info: emit_info, source_indices: source_indices)
  if (leaf_name == "none" || leaf_name == "None") && variant_parent == none { emit_none_keyword_for_resolved_type(resolved_type: resolved_type) }
  else if leaf_name == "true" || leaf_name == "false" { emit_keyword(key: leaf_name, target: Rust) }
  else {

    let moves_by_value = set_contains(emit_info.movable, name)
    let sharing = language_spec(target: Rust).sharing
    let ref_str = match variant_parent {
      Present { value: enum_name } =>
        let body = if freemonoid_empty_from_variant_parent(leaf_name: leaf_name, enum_name: enum_name) {
          emit_freemonoid_empty_variant_body()
        } else if is_optional_variant_name(name: leaf_name) && is_optional_like_parent_name(name: enum_name) {
          if is_some_like_variant_name(name: leaf_name) { "Some" } else { "None" }
        } else {
          concat(enum_name, "::", leaf_name)
        }
        if variant_ref_self_wraps(name: leaf_name, enum_name: enum_name, shared_types: shared_types, corpus_repr: emit_info.corpus_repr) {
          concat("Rc::new(", body, ")")
        } else { body }
      Absent =>
        match map_get(registry, name) {
          Present { value: info } =>
            let is_data = info.kind == DataItem
            if is_data { concat(to_snake(name: name), "()") }
            else {
              let is_function_value = match binding_kind {
                Present { value: FunctionValueBinding } => true
                _ => false
              }
              let ident = emit_value_ref_ident(name: name, registry: registry, emit_info: emit_info)
              let ident_str = if is_function_value {
                ident
              } else if moves_by_value {
                ident
              } else { match resolved_type {
                Present { value: _ } => apply_type_template1(template: sharing.clone_value, arg0: ident)
                _ => ident
              } }
              ident_str
            }
          Absent =>
            let ident = emit_value_ref_ident(name: name, registry: registry, emit_info: emit_info)
            let ident_str = if moves_by_value {
              ident
            } else { match resolved_type {
              Present { value: _ } => apply_type_template1(template: sharing.clone_value, arg0: ident)
              _ => ident
            } }
            ident_str
        }
    }
    ref_str
  }
}

fn emit_typed_expr_base(texpr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  match texpr.expr_data {
    ExprVar { binding_kind: binding_kind } =>
      let n = expr_var_name_at(texpr: texpr, source_indices: si)
      let leaf_name = value_ref_qualified_leaf(name: n)
      let variant_parent = effective_variant_parent(name: n, binding_kind: binding_kind, resolved_type: texpr.inferred, emit_info: emit_info, source_indices: si)
      if (leaf_name == "none" || leaf_name == "None") && variant_parent == none { emit_none_keyword_for_resolved_type(resolved_type: texpr.inferred) }
      else if leaf_name == "true" || leaf_name == "false" { emit_keyword(key: leaf_name, target: Rust) }
      else {
        match variant_parent {
          Present { value: enum_name } =>
            if freemonoid_empty_from_variant_parent(leaf_name: leaf_name, enum_name: enum_name) {
              emit_freemonoid_empty_rc_value()
            } else {
            let qualified = if is_optional_variant_name(name: leaf_name) && is_optional_like_parent_name(name: enum_name) {
              if is_some_like_variant_name(name: leaf_name) { "Some" } else { "None" }
            } else {
              concat(enum_name, "::", leaf_name)
            }
            if set_contains(shared_types, enum_name) {
              concat("Rc::new(", qualified, ")")
            } else { qualified }
            }
          Absent =>
            match map_get(registry, n) {
              Present { value: info } =>
                let is_data = info.kind == DataItem
                if is_data { concat(to_snake(name: n), "()") }
                else { emit_value_ref_ident(name: n, registry: registry, emit_info: emit_info) }
              Absent =>
                emit_value_ref_ident(name: n, registry: registry, emit_info: emit_info)
            }
        }
      }
    _ => emit_typed_expr(texpr: texpr, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
  }
}

fn field_access_field_is_boxed(base: Node, field: String, scope: InferScope, shared_types: Set<String>, emit_info: EmitGraphInfo) -> Bool {
  let base_struct = expand_type_for_field_access(n: resolved_type(n: base), env: scope.type_env, module_name: scope.module_name)
  match find_child_named(n: base_struct, name: field, source_indices: scope.type_env.source_indices) {
    Present { value: field_child } =>
      let field_ty = resolved_type(n: field_child)
      let field_ty_name = authored_name_at(source_indices: scope.type_env.source_indices, node: field_ty)
      let grounds_to_host_scalar = rust_seed_host_numeric_alias(name: field_ty_name, corpus_repr: emit_info.corpus_repr) != none
      if grounds_to_host_scalar { false }
      else {
        let faithful_nat_field = emit_info.corpus_repr == FaithfulFreeMonoid && (field_ty_name == "Nat" || substring(s: field_ty_name, start: 0, end: 4) == "Nat<")
        faithful_nat_field || needs_box_wrapping(n: field_ty, recursive_types: emit_info.recursive_type_set, shared_types: shared_types, source_indices: scope.type_env.source_indices)
      }
    Absent => false
  }
}

fn emit_typed_field_access(base: Node, field: String, summary: FieldSummary?, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let base_str = emit_typed_expr_base(texpr: base, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
  let base_is_anon_record = match base.inferred {
    Present { value: Resolved { node: bt } } =>
      let is_product = is_product_type(n: bt)
      if is_product && bt.ident_span == none { true } else { false }
    _ => false
  }
  if base_is_anon_record {
    let bt = resolved_type(n: base)
    if bt.children |> count == 1 {
      emit_typed_expr(texpr: base, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info, fuel: 1024)
    } else {
      let matches = bt.children |> enumerate |> filter(pair => authored_name_at(source_indices: scope.type_env.source_indices, node: pair.second) == field)
      match matches |> first {
        Present { value: m } =>
          let sharing = language_spec(target: Rust).sharing
          apply_type_template1(template: sharing.clone_value, arg0: concat(base_str, ".", to_string(value: m.first)))
        Absent => concat("compile_error!(\"anonymous record field not found: ", field, "\")")
      }
    }
  } else {
    let sharing = language_spec(target: Rust).sharing
    match summary {
      Present { value: field_summary } =>
        match field_summary.access_style {
          TupleFirst => apply_type_template1(template: sharing.clone_value, arg0: concat(base_str, ".0"))
          TupleSecond => apply_type_template1(template: sharing.clone_value, arg0: concat(base_str, ".1"))
          OptionalUnwrap => concat(apply_type_template1(template: sharing.clone_value, arg0: base_str), ".unwrap()")
          EnumAccessor => concat(base_str, ".", emit_ident(name: field, target: Rust), "()")
          StoredField =>
            let base_is_owned = match base.expr_data {
              ExprVar { binding_kind: _ } =>
                let base_name = expr_var_name_at(texpr: base, source_indices: scope.type_env.source_indices)
                set_contains(emit_info.owned_bindings, base_name)
              _ => false
            }
            let field_is_boxed = field_access_field_is_boxed(base: base, field: field, scope: scope, shared_types: shared_types, emit_info: emit_info)
            if field_is_boxed {
              apply_type_template1(template: sharing.deref_clone, arg0: concat(base_str, ".", emit_ident(name: field, target: Rust)))
            } else if base_is_owned {
              concat(base_str, ".", emit_ident(name: field, target: Rust))
            } else {
              apply_type_template1(template: sharing.clone_value, arg0: concat(base_str, ".", emit_ident(name: field, target: Rust)))
            }
        }
      Absent => concat("compile_error!(\"field access missing reconcile summary for '", field, "'\")")
    }
  }
}

fn type_needs_rc(type_node: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  type_needs_rc_seen(type_node: type_node, seen: empty_map(), source_indices: source_indices)
}

fn type_needs_rc_seen(type_node: Node, seen: Map<String, Bool>, source_indices: Map<String, NewlineIndex>) -> Bool {
  let normed = normalize_access_type_node(n: type_node)
  let is_product = is_product_type(n: normed)
  let is_coproduct = is_coproduct_type(n: normed)
  if is_product {
    true
  } else if is_coproduct {
    normed.children |> any(child => child.children |> count > 0)
  } else {
    let canonical = authored_name_at(source_indices: source_indices, node: normed)
    if normed.inferred != none {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      type_needs_rc_seen(type_node: resolved_type(n: normed), seen: next_seen, source_indices: source_indices)
    } else if canonical != "" && emit_map_has(m: seen, key: canonical) {
      false
    } else {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      let has_structure = normed.connective != NoConnective
      if !has_structure && normed.children |> count == 0 {
        false
      } else {
        type_needs_rc_seen(type_node: normed, seen: next_seen, source_indices: source_indices)
      }
    }
  }
}

fn rust_runtime_bridge_passes_receiver_by_ref(function_name: String) -> Bool {
  map_contains_key(rt_ref_map_functions(), function_name)
}

fn rust_runtime_bridge_name(function_name: String) -> String {
  match map_get(rt_bridge_function_names(), function_name) {
    Present { value: runtime_name } => runtime_name
    Absent => function_name
  }
}

fn rust_empty_map_value_type_str(map_type: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  match map_type.children |> skip(1) |> first {
    Present { value: value_child } =>
      let rendered = render_rust_type(n: child_type_node(ch: value_child), shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info())
      if rendered == "" { "" } else { rendered }
    Absent => ""
  }
}

fn rust_empty_map_kv_type_str(map_type: Node, shared_types: Set<String>, corpus_repr: RustCorpusRepr, source_indices: Map<String, NewlineIndex>) -> String {
  let key_str = match map_type.children |> first {
    Present { value: key_child } =>
      render_rust_type(n: child_type_node(ch: key_child), shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices, emit_info: empty_emit_graph_info())
    Absent => ""
  }
  let val_str = rust_empty_map_value_type_str(map_type: map_type, shared_types: shared_types, corpus_repr: corpus_repr, source_indices: source_indices)
  if key_str != "" && val_str != "" {
    concat(key_str, ", ", val_str)
  } else { "" }
}

fn type_node_child_is_type_variable(c: Node) -> Bool {
  let ch = child_type_node(ch: c)
  if ch.inferred != none { is_type_variable(inferred: ch.inferred.value) } else { false }
}

fn rust_btree_set_element_ord_eligible(elem_node: Node, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> Bool {
  let elem_name = authored_name_at(source_indices: source_indices, node: elem_node)
  elem_name == "String" || elem_name == "Int" || elem_name == "Bool" || elem_name == "Unit"
    || elem_name == "Secret" || elem_name == "Bytes" || rust_opaque_kernel_alias_type_eligible(name: elem_name)
    || rust_nominal_ord_type_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info)
}

fn rust_empty_set_element_type_str(set_type: Node, shared_types: Set<String>, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  match set_type.children |> first {
    Present { value: elem_child } =>
      let elem_node = child_type_node(ch: elem_child)
      let elem_is_type_var = if elem_node.inferred != none { is_type_variable(inferred: elem_node.inferred.value) } else { false }
      let elem_is_error = if elem_node.inferred != none { is_compiler_error(inferred: elem_node.inferred.value) } else { false }
      if elem_is_type_var || elem_is_error { "" }
      else if !rust_btree_set_element_ord_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info) { "" }
      else {
        render_node_type(n: elem_node, target: Rust, shared_types: shared_types, source_indices: source_indices)
      }
    Absent => ""
  }
}

fn emit_rust_empty_set_expr(set_type: Node, shared_types: Set<String>, source_indices: Map<String, NewlineIndex>, emit_info: EmitGraphInfo) -> String {
  match set_type.children |> first {
    Present { value: elem_child } =>
      let elem_node = child_type_node(ch: elem_child)
      let elem_is_type_var = if elem_node.inferred != none { is_type_variable(inferred: elem_node.inferred.value) } else { false }
      if elem_is_type_var {
        "v1_rt::rc_empty_set::<_>()"
      } else if !rust_btree_set_element_ord_eligible(elem_node: elem_node, source_indices: source_indices, emit_info: emit_info) {
        let elem_name = authored_name_at(source_indices: source_indices, node: elem_node)
        emit_rust_compile_error_expr(message: concat("empty_set element type ", elem_name, " is not Ord-eligible for BTreeSet"))
      } else {
        let elem_str = rust_empty_set_element_type_str(set_type: set_type, shared_types: shared_types, source_indices: source_indices, emit_info: emit_info)
        if elem_str != "" {
          concat("v1_rt::rc_empty_set::<", elem_str, ">()")
        } else {
          "v1_rt::rc_empty_set::<_>()"
        }
      }
    Absent =>
      "v1_rt::rc_empty_set::<_>()"
  }
}

fn rust_runtime_bridge_wraps_collection_result_in_rc(function_name: String) -> Bool {

  map_contains_key(rt_wraps_result(), function_name)
    || map_contains_key(rust_method_wraps_result(), function_name)
}

fn rust_runtime_bridge_collection_result_needs_rc_elements(function_name: String, result_type: InferredNode?) -> Bool {

  false
}

fn rust_wrap_runtime_collection_result(call_str: String, function_name: String, result_type: InferredNode?) -> String {
  if rust_runtime_bridge_wraps_collection_result_in_rc(function_name: function_name) {
    if rust_runtime_bridge_collection_result_needs_rc_elements(function_name: function_name, result_type: result_type) {
      concat("Rc::new((", call_str, ").into_iter().map(Rc::new).collect::<Vec<_>>())")
    } else {
      concat("Rc::new(", call_str, ")")
    }
  } else {
    call_str
  }
}

fn emit_rust_expr_var(expr: Node, registry: Map<String, ItemInfo>, shared_types: Set<String>, emit_info: EmitGraphInfo, source_indices: Map<String, NewlineIndex>) -> String {
  match expr.expr_data {
    ExprVar { binding_kind: binding_kind } =>
      let n = expr_var_name_at(texpr: expr, source_indices: source_indices)
      emit_var_ref(name: n, binding_kind: binding_kind, resolved_type: expr.inferred, shared_types: shared_types, registry: registry, emit_info: emit_info, source_indices: source_indices)
    _ => emit_error_expr(message: "emit_rust_expr_var expected ExprVar", target: Rust)
  }
}

fn emit_rust_expr_field_access(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  let si = scope.type_env.source_indices
  match expr.expr_data {
    ExprFieldAccess { summary: summary } =>
      let f = field_access_field_at(texpr: expr, source_indices: si)
      let b = field_access_base(texpr: expr)
      if is_typed_service_call_receiver(receiver: expr, source_indices: scope.type_env.source_indices) {
        match extract_typed_service_name(receiver: expr, source_indices: scope.type_env.source_indices) {
          Present { value: svc_name } => service_var_name(service_name: svc_name)
          Absent => emit_typed_field_access(base: b, field: f, summary: summary, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
        }
      } else {
        emit_typed_field_access(base: b, field: f, summary: summary, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      }
    _ => emit_error_expr(message: "emit_rust_expr_field_access expected ExprFieldAccess", target: Rust)
  }
}

fn emit_rust_expr_call(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let f = expr_call_func_at(texpr: expr, source_indices: scope.type_env.source_indices)
      emit_typed_call_expr(func: f, args: expr.children, inferred: expr.inferred, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => emit_error_expr(message: "emit_rust_expr_call expected ExprCall", target: Rust)
  }
}

fn emit_rust_expr_method_call(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprMethodCall { method_semantics: method_semantics } =>
      let r = method_receiver(texpr: expr)
      let a = method_arg_nodes(texpr: expr)
      let m = expr_method_name_at(texpr: expr, source_indices: scope.type_env.source_indices)
      emit_typed_method_call(method_call_node: expr, receiver: r, method: m, args: a, result_type: expr.inferred, method_semantics: method_semantics, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => emit_error_expr(message: "emit_rust_expr_method_call expected ExprMethodCall", target: Rust)
  }
}

fn emit_rust_expr_match(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprMatch =>
      let s = match_scrutinee(texpr: expr)
      let arm_list = match_arm_nodes(texpr: expr)
      emit_typed_match(scrutinee: s, arms: arm_list, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => emit_error_expr(message: "emit_rust_expr_match expected ExprMatch", target: Rust)
  }
}

fn emit_rust_expr_if(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprIf =>
      let c = if_condition(texpr: expr)
      let t = if_then_branch(texpr: expr)
      let e = if_else_branch(texpr: expr)
      emit_typed_if(condition: c, then_branch: t, else_branch: e, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => emit_error_expr(message: "emit_rust_expr_if expected ExprIf", target: Rust)
  }
}

fn emit_rust_expr_let(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprLet =>
      let n = let_binding_name_at(texpr: expr, source_indices: scope.type_env.source_indices)
      let v = let_value(texpr: expr)
      let bd = let_body(texpr: expr)
      emit_typed_let(name: n, value: v, body: bd, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => emit_error_expr(message: "emit_rust_expr_let expected ExprLet", target: Rust)
  }
}

fn emit_rust_expr_record_lit(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprRecordLit { parent_enum: parent_enum } =>
      let tn = record_lit_type_name_at(texpr: expr, source_indices: scope.type_env.source_indices)
      let fs = expr.children

      let si = scope.type_env.source_indices
      let resolved_rt = resolved_type(n: expr)
      let expanded_rt = expand_type_for_field_access(n: resolved_rt, env: scope.type_env, module_name: scope.module_name)
      let variant_name = match tn { Present { value: n } => n  Absent => "" }

      let peeled_type_name = if parent_enum == none && expanded_rt.connective == Conj && expanded_rt.ident_span != none {
        let concrete = authored_name_at(source_indices: si, node: expanded_rt)
        if concrete != "" && concrete != variant_name { Present { value: concrete } } else { tn }
      } else { tn }
      let raw = emit_typed_record_lit(type_name: peeled_type_name, fields: fs, parent_enum: parent_enum, resolved_type: expanded_rt, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
      let rc_name = match parent_enum {
        Present { value: en } => en
        Absent =>
          match contextual_variant_parent(variant_name: variant_name, parent_enum: parent_enum, resolved_type: expanded_rt, emit_info: emit_info, source_indices: si) {
            Present { value: p } => p
            Absent =>

              let expanded_name = authored_name_at(source_indices: si, node: expanded_rt)
              if expanded_rt.ident_span != none && expanded_name != "" && expanded_name != variant_name && set_contains(shared_types, expanded_name) {
                expanded_name
              } else { variant_name }
          }
      }
      if rc_name != "" && set_contains(shared_types, rc_name) {
        concat("Rc::new(", raw, ")")
      } else { raw }
    _ => emit_error_expr(message: "emit_rust_expr_record_lit expected ExprRecordLit", target: Rust)
  }
}

fn emit_rust_expr_string_interp(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprStringInterp =>
      let ps = expr.children |> map(child => match child.expr_data {
        ExprLiteral { value: LitStr { value: text } } => Text { value: text }
        _ => Interpolation { expr: arg_value(n: child) }
      })
      emit_typed_string_interp(parts: ps, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => emit_error_expr(message: "emit_rust_expr_string_interp expected ExprStringInterp", target: Rust)
  }
}

fn emit_rust_expr_block(expr: Node, registry: Map<String, ItemInfo>, scope: InferScope, depth: Int, shared_types: Set<String>, emit_info: EmitGraphInfo) -> String {
  match expr.expr_data {
    ExprBlock =>
      emit_typed_block(stmts: expr.children, registry: registry, scope: scope, depth: depth, shared_types: shared_types, emit_info: emit_info)
    _ => emit_error_expr(message: "emit_rust_expr_block expected ExprBlock", target: Rust)
