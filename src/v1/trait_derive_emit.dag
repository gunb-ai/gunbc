module v1.compiler.trait_derive_emit

import v1.compiler.infer_types { child_type_node }
import v1.std.core {
  Node, NewlineIndex, authored_name_at, generic_param_name_at, param_node_type_expr,
  NoConnective
}
import v1.compiler.emit { to_pascal }
import extdeps.languages.rust.emit {
  rust_struct_derives, rust_struct_derives_copy, rust_enum_derives
}
import std.types { is_container_type }

fn v1_ord_derives_text() -> String {
  "#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, serde::Serialize, serde::Deserialize)]"
}

fn v1_symbol_wrapped_ord_carrier_shape_eligible(children: List<Node>, source_indices: Map<String, NewlineIndex>) -> Bool {
  if (children |> count) != 1 {
    false
  } else {
    match children |> first {
      Present { value: child } =>
        authored_name_at(source_indices: source_indices, node: child_type_node(ch: child)) == "Symbol"
          && (child_type_node(ch: child).children |> count) == 0
          && (child_type_node(ch: child).params |> count) == 0
          && child_type_node(ch: child).connective == NoConnective
      Absent => false
    }
  }
}

fn v1_ord_derives_copy_text() -> String {
  "#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, serde::Serialize, serde::Deserialize)]"
}

fn v1_coproduct_all_variants_nullary(children: List<Node>) -> Bool {
  children |> all(v => v.children |> count == 0)
}

fn v1_emit_struct_derives(
  name: String,
  children: List<Node>,
  shared_types: Set<String>,
  has_fn_fields: Bool,
  source_indices: Map<String, NewlineIndex>
) -> String {
  if has_fn_fields {
    "#[derive(Clone)]"
  } else if v1_symbol_wrapped_ord_carrier_shape_eligible(children: children, source_indices: source_indices) {
    v1_ord_derives_text()
  } else if set_contains(shared_types, name) {
    rust_struct_derives
  } else {
    rust_struct_derives_copy
  }
}

fn v1_emit_enum_derives(children: List<Node>, source_indices: Map<String, NewlineIndex>) -> String {
  if v1_coproduct_all_variants_nullary(children: children) {
    v1_ord_derives_copy_text()
  } else {
    rust_enum_derives
  }
}

fn v1_generic_param_used_as_collection_element(
  param_name: String,
  value_params: List<Node>,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  value_params |> any(vp =>
    let te = param_node_type_expr(n: vp)
    is_container_type(name: authored_name_at(source_indices: source_indices, node: te))
      && (te.children |> any(c => authored_name_at(source_indices: source_indices, node: c) == param_name))
  )
}

fn v1_generic_params_needing_clone_bound(
  generic_param_names: List<String>,
  value_params: List<Node>,
  return_is_bare_generic: Bool,
  ret_name: String,
  body_is_param_ref: Bool,
  source_indices: Map<String, NewlineIndex>
) -> List<String> {
  generic_param_names |> filter(g =>
    (return_is_bare_generic && !body_is_param_ref && g == ret_name)
      || v1_generic_param_used_as_collection_element(param_name: g, value_params: value_params, source_indices: source_indices)
  )
}

fn v1_emit_type_params_with_clone_bounds(
  params: List<Node>,
  clone_param_names: List<String>,
  source_indices: Map<String, NewlineIndex>
) -> String {
  if params |> count == 0 { "" }
  else {
    let names = params |> map(p =>
      let pname = generic_param_name_at(n: p, source_indices: source_indices)
      let pascal = to_pascal(name: pname)
      if clone_param_names |> any(c => c == pname) {
        concat(pascal, ": Clone")
      } else {
        pascal
      }
    )
    concat("<", names |> join(separator: ", "), ">")
  }
}
