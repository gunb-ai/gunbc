module v1.compiler.trait_derive_emit

import v1.compiler.infer_types { is_coproduct_type, child_type_node }
import v1.std.core {
  Node, NewlineIndex, authored_name_at, generic_param_name_at, param_node_type_expr,
  NoConnective
}
import v1.compiler.emit { to_pascal }
import std.trait_derive_shape {
  ReprDeriveClone,
  ReprDeriveElemNullaryEnumCopy,
  ReprDeriveElemKernelInt,
  repr_grounding_derive_completeness_predicate,
  repr_grounding_derive_shape_has_trait,
  record_derive_traits_heap,
  record_derive_traits_copy,
  nullary_coproduct_derive_traits,
  payload_coproduct_derive_traits
}
import extdeps.languages.rust.emit { rust_trait_derive_attr_from_traits }
import std.types { is_container_type }

fn v1_trait_derive_refuse(message: String) -> String {
  concat("compile_error!(\"", message, "\");")
}

fn v1_coproduct_all_variants_nullary(children: List<Node>) -> Bool {
  children |> all(v => v.children |> count == 0)
}

fn v1_symbol_wrapped_ord_carrier_shape_eligible(children: List<Node>, source_indices: Map<String, NewlineIndex>) -> Bool {
  if (children |> count) != 1 {
    false
  } else {
    match children |> first {
      Present { value: child } =>
        authored_name_at(source_indices: source_indices, node: child_type_node(ch: child)) == "Symbol"
          && (child_type_node(ch: child).children |> count) == 0
          && (child_type_node(ch: child).params |> count) == 0
          && child_type_node(ch: child).connective == NoConnective
      Absent => false
    }
  }
}

fn v1_emit_struct_derives(
  name: String,
  children: List<Node>,
  shared_types: Set<String>,
  has_fn_fields: Bool,
  source_indices: Map<String, NewlineIndex>
) -> String {
  if has_fn_fields {
    "#[derive(Clone)]"
  } else if v1_symbol_wrapped_ord_carrier_shape_eligible(children: children, source_indices: source_indices) {
    if repr_grounding_derive_completeness_predicate(nullary_coproduct_derive_traits(), ReprDeriveElemNullaryEnumCopy) {
      rust_trait_derive_attr_from_traits(nullary_coproduct_derive_traits())
    } else {
      v1_trait_derive_refuse("trait_derive_emit: symbol-wrapped ord carrier refused")
    }
  } else {
    if set_contains(shared_types, name) {
      rust_trait_derive_attr_from_traits(record_derive_traits_heap())
    } else {
      rust_trait_derive_attr_from_traits(record_derive_traits_copy())
    }
  }
}

fn v1_emit_enum_derives(children: List<Node>, source_indices: Map<String, NewlineIndex>) -> String {
  if v1_coproduct_all_variants_nullary(children: children) {
    if repr_grounding_derive_completeness_predicate(nullary_coproduct_derive_traits(), ReprDeriveElemNullaryEnumCopy) {
      rust_trait_derive_attr_from_traits(nullary_coproduct_derive_traits())
    } else {
      v1_trait_derive_refuse("trait_derive_emit: nullary coproduct derive completeness refused")
    }
  } else {
    rust_trait_derive_attr_from_traits(payload_coproduct_derive_traits())
  }
}

fn v1_generic_param_used_as_collection_element(
  param_name: String,
  value_params: List<Node>,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  value_params |> any(vp =>
    let te = param_node_type_expr(n: vp)
    is_container_type(name: authored_name_at(source_indices: source_indices, node: te))
      && (te.children |> any(c => authored_name_at(source_indices: source_indices, node: c) == param_name))
  )
}

fn v1_type_param_needs_clone_bound(
  param_name: String,
  return_is_bare_generic: Bool,
  ret_name: String,
  body_is_param_ref: Bool,
  value_params: List<Node>,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  let structural = (return_is_bare_generic && !body_is_param_ref && param_name == ret_name)
    || v1_generic_param_used_as_collection_element(param_name: param_name, value_params: value_params, source_indices: source_indices)
  structural && repr_grounding_derive_shape_has_trait(ReprDeriveElemKernelInt, ReprDeriveClone)
}

fn v1_generic_params_needing_clone_bound(
  generic_param_names: List<String>,
  value_params: List<Node>,
  return_is_bare_generic: Bool,
  ret_name: String,
  body_is_param_ref: Bool,
  source_indices: Map<String, NewlineIndex>
) -> List<String> {
  generic_param_names |> filter(g =>
    v1_type_param_needs_clone_bound(
      param_name: g,
      return_is_bare_generic: return_is_bare_generic,
      ret_name: ret_name,
      body_is_param_ref: body_is_param_ref,
      value_params: value_params,
      source_indices: source_indices
    )
  )
}

fn v1_emit_type_params_with_clone_bounds(
  params: List<Node>,
  clone_param_names: List<String>,
  source_indices: Map<String, NewlineIndex>
) -> String {
  if params |> count == 0 { "" }
  else {
    let names = params |> map(p =>
      let pname = generic_param_name_at(n: p, source_indices: source_indices)
      let pascal = to_pascal(name: pname)
      if clone_param_names |> any(c => c == pname) {
        concat(pascal, ": Clone")
      } else {
        pascal
      }
    )
    concat("<", names |> join(separator: ", "), ">")
  }
}
