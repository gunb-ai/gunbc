module v1.compiler.runtime_go

fn go_rt_header() -> String {
  concat(
    "// Code generated by the v2 compiler -- do not edit.\n\n",
    "package v2rt\n\n",
    "import (\n",
    "\t\"fmt\"\n",
    "\t\"reflect\"\n",
    "\t\"sort\"\n",
    "\t\"strings\"\n",
    ")\n\n")
}

fn go_rt_concat() -> String {
  concat(
    "func Concat(parts ...interface\{\}) string \{\n",
    "\tvar b strings.Builder\n",
    "\tfor _, p := range parts \{\n",
    "\t\tb.WriteString(fmt.Sprint(p))\n",
    "\t\}\n",
    "\treturn b.String()\n",
    "\}\n\n",
    "func ToString(v interface\{\}) string \{\n",
    "\treturn fmt.Sprint(v)\n",
    "\}\n\n")
}

fn go_rt_slice_ops() -> String {
  concat(
    "func Map(xs interface\{\}, fn interface\{\}) interface\{\} \{\n",
    "\tswitch items := xs.(type) \{\n",
    "\tcase []interface\{\}:\n",
    "\t\tout := make([]interface\{\}, len(items))\n",
    "\t\tcall := reflect.ValueOf(fn)\n",
    "\t\tfor i, x := range items \{\n",
    "\t\t\tout[i] = call.Call([]reflect.Value\{reflect.ValueOf(x)\})[0].Interface()\n",
    "\t\t\}\n",
    "\t\treturn out\n",
    "\tdefault:\n",
    "\t\treturn xs\n",
    "\t\}\n",
    "\}\n\n",
    "func Filter(xs interface\{\}, fn interface\{\}) interface\{\} \{\n",
    "\tswitch items := xs.(type) \{\n",
    "\tcase []interface\{\}:\n",
    "\t\tcall := reflect.ValueOf(fn)\n",
    "\t\tout := make([]interface\{\}, 0, len(items))\n",
    "\t\tfor _, x := range items \{\n",
    "\t\t\tif call.Call([]reflect.Value\{reflect.ValueOf(x)\})[0].Bool() \{\n",
    "\t\t\t\tout = append(out, x)\n",
    "\t\t\t\}\n",
    "\t\t\}\n",
    "\t\treturn out\n",
    "\tdefault:\n",
    "\t\treturn xs\n",
    "\t\}\n",
    "\}\n\n",
    "func Any(xs interface\{\}, fn interface\{\}) bool \{\n",
    "\tswitch items := xs.(type) \{\n",
    "\tcase []interface\{\}:\n",
    "\t\tcall := reflect.ValueOf(fn)\n",
    "\t\tfor _, x := range items \{\n",
    "\t\t\tif call.Call([]reflect.Value\{reflect.ValueOf(x)\})[0].Bool() \{\n",
    "\t\t\t\treturn true\n",
    "\t\t\t\}\n",
    "\t\t\}\n",
    "\t\treturn false\n",
    "\tdefault:\n",
    "\t\treturn false\n",
    "\t\}\n",
    "\}\n\n",
    "func All(xs interface\{\}, fn interface\{\}) bool \{\n",
    "\tswitch items := xs.(type) \{\n",
    "\tcase []interface\{\}:\n",
    "\t\tcall := reflect.ValueOf(fn)\n",
    "\t\tfor _, x := range items \{\n",
    "\t\t\tif !call.Call([]reflect.Value\{reflect.ValueOf(x)\})[0].Bool() \{\n",
    "\t\t\t\treturn false\n",
    "\t\t\t\}\n",
    "\t\t\}\n",
    "\t\treturn true\n",
    "\tdefault:\n",
    "\t\treturn true\n",
    "\t\}\n",
    "\}\n\n",
    "func FlatMap(xs interface\{\}, fn interface\{\}) interface\{\} \{\n",
    "\tswitch items := xs.(type) \{\n",
    "\tcase []interface\{\}:\n",
    "\t\tcall := reflect.ValueOf(fn)\n",
    "\t\tout := make([]interface\{\}, 0)\n",
    "\t\tfor _, x := range items \{\n",
    "\t\t\tchunk := call.Call([]reflect.Value\{reflect.ValueOf(x)\})[0].Interface()\n",
    "\t\t\tif nested, ok := chunk.([]interface\{\}); ok \{\n",
    "\t\t\t\tout = append(out, nested...)\n",
    "\t\t\t\}\n",
    "\t\t\}\n",
    "\t\treturn out\n",
    "\tdefault:\n",
    "\t\treturn xs\n",
    "\t\}\n",
    "\}\n\n",
    "func Fold(xs interface\{\}, init interface\{\}, fn interface\{\}) interface\{\} \{\n",
    "\tswitch items := xs.(type) \{\n",
    "\tcase []interface\{\}:\n",
    "\t\tacc := init\n",
    "\t\tcall := reflect.ValueOf(fn)\n",
    "\t\tfor _, x := range items \{\n",
    "\t\t\tacc = call.Call([]reflect.Value\{reflect.ValueOf(acc), reflect.ValueOf(x)\})[0].Interface()\n",
    "\t\t\}\n",
    "\t\treturn acc\n",
    "\tdefault:\n",
    "\t\treturn init\n",
    "\t\}\n",
    "\}\n\n",
    "func SortBy(xs interface\{\}, keyFn interface\{\}) interface\{\} \{\n",
    "\tswitch items := xs.(type) \{\n",
    "\tcase []interface\{\}:\n",
    "\t\tcall := reflect.ValueOf(keyFn)\n",
    "\t\tout := append([]interface\{\}(nil), items...)\n",
    "\t\tsort.SliceStable(out, func(i, j int) bool \{\n",
    "\t\t\tki := call.Call([]reflect.Value\{reflect.ValueOf(out[i])\})[0].Interface()\n",
    "\t\t\tkj := call.Call([]reflect.Value\{reflect.ValueOf(out[j])\})[0].Interface()\n",
    "\t\t\treturn fmt.Sprint(ki) < fmt.Sprint(kj)\n",
    "\t\t\})\n",
    "\t\treturn out\n",
    "\tdefault:\n",
    "\t\treturn xs\n",
    "\t\}\n",
    "\}\n\n",
    "func Lookup(m interface\{\}, key interface\{\}) interface\{\} \{\n",
    "\tswitch table := m.(type) \{\n",
    "\tcase map[string]interface\{\}:\n",
    "\t\treturn table[fmt.Sprint(key)]\n",
    "\tdefault:\n",
    "\t\treturn nil\n",
    "\t\}\n",
    "\}\n\n")
}

fn go_rt_algebra() -> String {
  concat(
    "func Init(algebra interface\{\}, node interface\{\}) interface\{\} \{\n",
    "\tv := reflect.ValueOf(algebra)\n",
    "\tinitFn := v.FieldByName(\"Init\")\n",
    "\tif !initFn.IsValid() \{\n",
    "\t\treturn nil\n",
    "\t\}\n",
    "\treturn initFn.Call([]reflect.Value\{reflect.ValueOf(node)\})[0].Interface()\n",
    "\}\n\n",
    "func Step(algebra interface\{\}, acc interface\{\}, edge interface\{\}, sub interface\{\}) interface\{\} \{\n",
    "\tv := reflect.ValueOf(algebra)\n",
    "\tstepFn := v.FieldByName(\"Step\")\n",
    "\tif !stepFn.IsValid() \{\n",
    "\t\treturn acc\n",
    "\t\}\n",
    "\treturn stepFn.Call([]reflect.Value\{reflect.ValueOf(acc), reflect.ValueOf(edge), reflect.ValueOf(sub)\})[0].Interface()\n",
    "\}\n\n")
}

fn go_runtime_source() -> String {
  concat(
    go_rt_header(),
    go_rt_concat(),
    go_rt_slice_ops(),
    go_rt_algebra())
}
