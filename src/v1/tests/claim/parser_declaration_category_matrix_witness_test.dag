module v1.tests.claim.parser_declaration_category_matrix_witness_test

import std.types { Bool }
import v1.tests.claim.parser_declaration_matrix_support {
  pdc_row,
  pdc_zero_row,
  pdc_identity_row,
  pdc_parse_matrix,
  pdc_declares_nothing,
  pdc_index_entry_for_declaration,
  PdcTransportReady,
  PdcTransportRefused,
}

data pdc_matrix_witness_note: String = "Parser declaration-category denominator. Pins, per authored declaration form, the OccurrenceCategory population the v1 parser mints — including the forms that mint nothing. Observation-only: no resolution, exposure, or binding claim. The zero rows are the load-bearing half; minting a category later must edit this file."

data pdc_offline_recipe: String = "OFFLINE LOCAL RECIPE (requires v1 parser pool): target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/parser_declaration_category_matrix_witness_test.dag --functions witness_matrix_fixture_parses,witness_function_declaration_mints_callable,witness_second_function_declaration_mints_callable,witness_function_parameter_binds,witness_match_scrutinee_parameter_binds,witness_let_binder_binds,witness_pattern_binder_binds"

data pdc_dissolve_on: String = "DISSOLVE-ON: witness_layer_roots admits src/v1 for parser-transport witnesses, or the execution corpus carries per-entry source roots — then this recipe deletes and discovery enrollment suffices."

// One module carrying every declaration form the matrix ranges over, each with a distinct authored
// name so a per-name join is exact. Named `pdc_*` throughout: an authored name that collided with a
// real corpus declaration would make the join ambiguous against a homonym rather than wrong-looking.

// POSITIVE CONTROL. Without it, every "mints nothing" row below would pass vacuously if the fixture
// stopped parsing, and the matrix would describe a parser that mints nothing at all.
test fn witness_matrix_fixture_parses() -> Bool {
  match pdc_parse_matrix() {
    PdcTransportRefused => false
    PdcTransportReady { transport: transport } =>
      length(transport.declarations) > 0 && length(transport.references) > 0
  }
}

// ---------------------------------------------------------------------------------------------
// Derived requirements the parser ALREADY meets. These are regression controls: each is required by
// the language, and each happens to hold today, so a commit C that breaks one is caught.
// ---------------------------------------------------------------------------------------------

// A function declaration introduces a callable name into its module.
test fn witness_function_declaration_mints_callable() -> Bool {
  pdc_row(name: "pdc_function", expected: "|CallableOccurrence")
}

test fn witness_second_function_declaration_mints_callable() -> Bool {
  pdc_row(name: "pdc_matcher", expected: "|CallableOccurrence")
}

// A parameter binds a name in the function body's scope, so it is a declaration.
test fn witness_function_parameter_binds() -> Bool {
  pdc_row(name: "pdc_parameter", expected: "|LexicalValueOccurrence")
}

test fn witness_match_scrutinee_parameter_binds() -> Bool {
  pdc_row(name: "pdc_scrutinee", expected: "|LexicalValueOccurrence")
}

// A let introduces a binding.
test fn witness_let_binder_binds() -> Bool {
  pdc_row(name: "pdc_let_binder", expected: "|LexicalValueOccurrence")
}

// A destructuring pattern binds its binder name into the arm's scope.
test fn witness_pattern_binder_binds() -> Bool {
  pdc_row(name: "pdc_pattern_binder", expected: "|LexicalValueOccurrence")
}
