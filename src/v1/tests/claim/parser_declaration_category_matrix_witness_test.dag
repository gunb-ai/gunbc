module v1.tests.claim.parser_declaration_category_matrix_witness_test

import std.types { Bool, String, List, Int, NonEmptyStr }
import std.occurrence_identity {
  OccurrenceTransport,
  OccurrenceIndexEntry,
  DeclarationOccurrence,
  OccurrenceCategory,
  LexicalValueOccurrence,
  TypeOccurrence,
  CallableOccurrence,
  ConstructorOccurrence,
  NamespaceSegmentOccurrence,
  FieldOccurrence,
  MethodOccurrence,
}
import v1.gunbc.occurrence_binding_parser_walk {
  ParsedOccurrenceBindingSourceRefused,
  ParsedOccurrenceBindingSourceReady,
  parse_authored_occurrence_binding_source,
}

// WHY THIS WITNESS EXISTS, and what it is NOT.
//
// The import-deletion lane's keystone needs a cross-file reference to bind to a declaration in
// another file WITHOUT an import declaration naming that file. Before any of that can be built,
// one prior question has to be answered by execution rather than by reading a match arm: for each
// authored declaration FORM the .dag grammar admits, does the parser mint a declaration occurrence
// at all, and in which OccurrenceCategory?
//
// That question is the DENOMINATOR. A binding walk that only ever sees the forms the parser
// happens to mint will report a healthy population while the forms it never mints are invisible —
// and invisible is indistinguishable from bound. So this witness pins the whole matrix INCLUDING
// its zeroes: a form that mints nothing is asserted to mint nothing, by name, so that minting it
// later is a visible change to this file rather than a silent widening.
//
// It asserts ONLY what the parser produces. It makes no claim about resolution, exposure,
// candidate binding, provider files, or clause-(e) participation; those are separate seams with
// their own witnesses.
data pdc_matrix_witness_note: String = "Parser declaration-category denominator. Pins, per authored declaration form, the OccurrenceCategory population the v1 parser mints — including the forms that mint nothing. Observation-only: no resolution, exposure, or binding claim. The zero rows are the load-bearing half; minting a category later must edit this file."

data pdc_offline_recipe: String = "OFFLINE LOCAL RECIPE (requires v1 parser pool): target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/parser_declaration_category_matrix_witness_test.dag --functions witness_matrix_fixture_parses,witness_function_declaration_mints_callable,witness_second_function_declaration_mints_callable,witness_let_binder_mints_lexical_value,witness_pattern_field_name_mints_field,witness_pattern_binder_mints_lexical_value,witness_function_parameter_mints_lexical_value,witness_annotated_data_declaration_mints_nothing,witness_product_type_declaration_mints_nothing,witness_coproduct_type_declaration_mints_nothing,witness_nullary_constructor_mints_nothing,witness_payload_constructor_mints_nothing,witness_parser_mints_no_type_or_constructor_declarations"

data pdc_dissolve_on: String = "DISSOLVE-ON: witness_layer_roots admits src/v1 for parser-transport witnesses, or the execution corpus carries per-entry source roots — then this recipe deletes and discovery enrollment suffices."

// One module carrying every declaration form the matrix ranges over, each with a distinct authored
// name so a per-name join is exact. Named `pdc_*` throughout: an authored name that collided with a
// real corpus declaration would make the join ambiguous against a homonym rather than wrong-looking.
fn pdc_matrix_source() -> String {
  "module app.pdc_matrix\n" +
    "\n" +
    "type PdcProduct {\n" +
    "  pdc_product_field: Int\n" +
    "}\n" +
    "\n" +
    "type PdcSum = PdcNullary | PdcPayload { pdc_payload_field: Int }\n" +
    "\n" +
    "data pdc_annotated_datum: Int = 7\n" +
    "\n" +
    "fn pdc_function(pdc_parameter: Int) -> Int {\n" +
    "  let pdc_let_binder = pdc_parameter\n" +
    "  pdc_let_binder\n" +
    "}\n" +
    "\n" +
    "fn pdc_matcher(pdc_scrutinee: PdcSum) -> Int {\n" +
    "  match pdc_scrutinee {\n" +
    "    PdcNullary => {\n" +
    "      0\n" +
    "    }\n" +
    "    PdcPayload { pdc_payload_field: pdc_pattern_binder } => {\n" +
    "      pdc_pattern_binder\n" +
    "    }\n" +
    "  }\n" +
    "}\n"
}

type PdcTransport
  = PdcTransportReady { transport: OccurrenceTransport }
  | PdcTransportRefused

fn pdc_parse_matrix() -> PdcTransport {
  match parse_authored_occurrence_binding_source(
    file: "app/pdc_matrix.dag",
    source: pdc_matrix_source(),
  ) {
    ParsedOccurrenceBindingSourceRefused => PdcTransportRefused
    ParsedOccurrenceBindingSourceReady { transport: transport, module_path: _ } =>
      PdcTransportReady { transport: transport }
  }
}

// A total projection of the closed OccurrenceCategory coproduct onto a comparable tag. It is a
// projection rather than a Bool predicate per category so that an assertion names the category the
// parser ACTUALLY minted when it disagrees, instead of reporting only that some expectation failed.
fn pdc_category_tag(category: OccurrenceCategory) -> String {
  match category {
    LexicalValueOccurrence => "LexicalValueOccurrence"
    TypeOccurrence => "TypeOccurrence"
    CallableOccurrence => "CallableOccurrence"
    ConstructorOccurrence => "ConstructorOccurrence"
    NamespaceSegmentOccurrence => "NamespaceSegmentOccurrence"
    FieldOccurrence => "FieldOccurrence"
    MethodOccurrence => "MethodOccurrence"
  }
}

fn pdc_index_entry_for_declaration(
  transport: OccurrenceTransport,
  declaration: DeclarationOccurrence
) -> OccurrenceIndexEntry? {
  fold(
    transport.index.entries,
    init: none,
    f: (found, entry) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match entry.projection.occurrence.value == declaration.occurrence.value {
            true => Present { value: entry }
            false => Absent
          }
      },
  )
}

// Every category tag the parser minted for declarations carrying this authored name, in transport
// order. A name the parser never declared yields the empty list — which is the assertion the zero
// rows below make, and the reason this returns a population rather than an Optional.
fn pdc_declared_tags_for_name(
  transport: OccurrenceTransport,
  name: String
) -> List<String> {
  fold(
    transport.declarations,
    init: [],
    f: (acc, declaration) =>
      match pdc_index_entry_for_declaration(transport: transport, declaration: declaration) {
        Absent => acc
        Present { value: entry } =>
          match entry.projection.authored_name == name {
            true => concat(acc, [pdc_category_tag(category: declaration.category)])
            false => acc
          }
      },
  )
}

// The minted population rendered as one ordered, delimited string. Comparing the rendering rather
// than walking two lists in parallel keeps ORDER and MULTIPLICITY in the comparison: a name minted
// twice, or minted in the other order, is a different string. The leading delimiter is what makes
// that true at the edges — without it "A" would be a prefix-collision hazard against "AB".
fn pdc_render_tags(tags: List<String>) -> String {
  fold(tags, init: "", f: (acc, tag) => acc + "|" + tag)
}

fn pdc_declares_exactly(
  transport: OccurrenceTransport,
  name: String,
  expected: String
) -> Bool {
  pdc_render_tags(tags: pdc_declared_tags_for_name(transport: transport, name: name)) == expected
}

fn pdc_declares_nothing(transport: OccurrenceTransport, name: String) -> Bool {
  length(pdc_declared_tags_for_name(transport: transport, name: name)) == 0
}

// POSITIVE CONTROL. If the fixture stopped parsing, every zero row below would pass vacuously and
// the matrix would report a parser that mints nothing at all. This runs first and separately so
// that "the fixture parses" can never be inferred from "the zero assertions held".
test fn witness_matrix_fixture_parses() -> Bool {
  match pdc_parse_matrix() {
    PdcTransportRefused => false
    PdcTransportReady { transport: transport } =>
      length(transport.declarations) > 0 && length(transport.references) > 0
  }
}

// THE MATRIX — one test fn per authored declaration form.
//
// Deliberately NOT one conjunction over every row. A ten-clause `&&` reports "the matrix failed"
// and names neither the form that disagreed nor what it minted instead, which is the wrong signal
// from the one witness whose entire job is to say what the parser actually does. One fn per form
// costs a re-parse of a small in-memory fixture and buys a failure that identifies itself.
fn pdc_row(name: String, expected: String) -> Bool {
  match pdc_parse_matrix() {
    PdcTransportRefused => false
    PdcTransportReady { transport: transport } =>
      pdc_declares_exactly(transport: transport, name: name, expected: expected)
  }
}

fn pdc_zero_row(name: String) -> Bool {
  match pdc_parse_matrix() {
    PdcTransportRefused => false
    PdcTransportReady { transport: transport } =>
      pdc_declares_nothing(transport: transport, name: name)
  }
}

// MINTED — a bodied declaration with no type annotation.
test fn witness_function_declaration_mints_callable() -> Bool {
  pdc_row(name: "pdc_function", expected: "|CallableOccurrence")
}

test fn witness_second_function_declaration_mints_callable() -> Bool {
  pdc_row(name: "pdc_matcher", expected: "|CallableOccurrence")
}

// MINTED — binders inside a body.
test fn witness_let_binder_mints_lexical_value() -> Bool {
  pdc_row(name: "pdc_let_binder", expected: "|LexicalValueOccurrence")
}

// A destructuring pattern mints TWO declarations at two distinct authored names, not one. The
// field-binding node carries the FIELD's name (make_field_binding_node takes field_name) and is
// stamped FieldOccurrence; the binder introduced by the pattern is a separate nested node stamped
// LexicalValueOccurrence. Both rows are asserted because joining on either name alone would report
// a pattern that declares one thing, and which one you got would depend on which name you picked.
test fn witness_pattern_field_name_mints_field() -> Bool {
  pdc_row(name: "pdc_payload_field", expected: "|FieldOccurrence")
}

test fn witness_pattern_binder_mints_lexical_value() -> Bool {
  pdc_row(name: "pdc_pattern_binder", expected: "|LexicalValueOccurrence")
}

// MINTED — a function parameter. Stamped explicitly at the params list rather than classified by
// node shape, which is why it is a declaration while the type forms below are not.
test fn witness_function_parameter_mints_lexical_value() -> Bool {
  pdc_row(name: "pdc_parameter", expected: "|LexicalValueOccurrence")
}

// NOT MINTED — the zero rows. Each is an authored declaration a reader would reasonably expect to
// be a declaration occurrence, and none of them is one today. These are the load-bearing half of
// the matrix: they are what makes the missing population visible instead of merely absent.

// The finding that is easiest to miss: a `data` row is not skipped because it is data. It is
// skipped because parsed_occurrence_role_for_node classifies a bodied node by the ABSENCE of a
// type annotation, and `data x: T = v` carries one — so it falls through to
// ParsedOccurrenceUnclassified along a different route than the type forms, but to the same place.
test fn witness_annotated_data_declaration_mints_nothing() -> Bool {
  pdc_zero_row(name: "pdc_annotated_datum")
}

test fn witness_product_type_declaration_mints_nothing() -> Bool {
  pdc_zero_row(name: "PdcProduct")
}

test fn witness_coproduct_type_declaration_mints_nothing() -> Bool {
  pdc_zero_row(name: "PdcSum")
}

test fn witness_nullary_constructor_mints_nothing() -> Bool {
  pdc_zero_row(name: "PdcNullary")
}

test fn witness_payload_constructor_mints_nothing() -> Bool {
  pdc_zero_row(name: "PdcPayload")
}

// The category-level statement of the same fact, asserted over the WHOLE declaration population
// rather than by name. The by-name rows above could each be satisfied by a parser that minted the
// category under some other authored name; this one cannot. It is the row that must change when
// commit C starts minting types and constructors.
test fn witness_parser_mints_no_type_or_constructor_declarations() -> Bool {
  match pdc_parse_matrix() {
    PdcTransportRefused => false
    PdcTransportReady { transport: transport } =>
      fold(
        transport.declarations,
        init: true,
        f: (acc, declaration) =>
          acc
          && pdc_category_tag(category: declaration.category) != "TypeOccurrence"
          && pdc_category_tag(category: declaration.category) != "ConstructorOccurrence",
      )
  }
}
