module v1.tests.claim.carrier_realization_census

import v1.compiler.compile { SourceFile, ResolvedPipelineResult, compile_to_resolved }
import v1.compiler.emit_rust { is_host_text_carrier_type }
import v1.compiler.emit_core_support { is_type_def_item }
import v1.compiler.infer_types { is_coproduct_type, child_type_node }
import v1.compiler.coercion { type_realization_decision, type_reference_decl_file, decl_identity_file }
import v1.compiler.artifact { Rust }
import v1.compiler.infer_items { ResolvedGraph, TypedModule }
import v1.compiler.infer_env { TypeEnv, lookup_type_for }
import v1.std.core { Node, NewlineIndex, authored_name_at, param_node_type_expr, Resolved }
import std.coercion { TypeRealizationDecision, Realized, Unrealized, Refused }
import std.types { List, String, Map, Bool }

// THE STEP-1 SHADOW CENSUS. For every type-reference occurrence the v1 emitter would render,
// compute BOTH the legacy short-circuit answer and the strict identity authority's answer, and
// report where they disagree. It emits nothing, renders nothing and changes no byte: the
// divergence is a fact about two pure functions over one tree. The design is
// docs/plans/carrier-realization-arbiter-repair-design.md sections 1 and 2.
//
// The predicate is IMPORTED, never re-derived. A second copy of is_host_text_carrier_type would
// be the forked authority this census exists to measure.
//
// The authority queried is the STRICT type_realization_decision, never lookup_checkpoint, whose
// decl_file == "" arm preserves the bare-name fallback and would measure the bypass against
// itself.
//
// THIS MODULE WALKS THE TYPED GRAPH AND ONLY THE TYPED GRAPH, and the deleted half is the reason
// that is worth stating. An earlier revision also carried a census over front_end_sources, which
// returns the INPUT to normalization and inference rather than the tree emit_artifact consumes,
// so it asked whether inference had happened before the phase responsible for it had run. Its
// author withdrew that census's subject claim. It is DELETED here rather than kept beside this
// one: two instruments answering one question is the parallel authority DESIGN section 3 forbids,
// and the withdrawn one still runs and still produces a number, which is the shape a later reader
// quotes by accident.
//
//   compile_to_resolved -> ResolvedPipelineResult.graph -> ResolvedGraph.modules
//                       -> TypedModule.items + TypedModule.type_env
//
// NO HOST EFFECT APPEARS IN THIS MODULE. Subject sources arrive as SourceFile DATA and the result
// leaves as a String; reading the sources and writing the receipt are the driver's job. That is
// transport, not a second authority, and it is what keeps the emitted mirror buildable -- a
// Filesystem call in an ordinary fn emits an .await in a fn never made async.

// THREE ANSWERS, RECORDED INDEPENDENTLY, none allowed to stand in for another before
// comparison. That independence is the whole design: the defect under measurement is one
// arm serving two states, so an instrument that lets a missing answer be filled in by a
// present one reproduces the very conflation it exists to detect.
type DeclarationIdentityObservation
  = IdentityFromInference { decl_file: String }
  | IdentityFromEnvironment { decl_file: String }
  | IdentitiesAgree { decl_file: String }
  | IdentitiesDisagree { inferred: String, environment: String }
  | IdentityUnavailableBoth

// The raw reference-file value is an OBSERVATION OF CURRENT BEHAVIOUR and never an
// identity. It is carried in its own field under its own name so that no reader, and no
// later fold over these rows, can mistake it for one.
type LegacyKeyObservation = LegacyFallbackUsed { reference_file: String }
                          | LegacyKeyResolved { decl_file: String }

type CensusOutcome
  = Agrees
  | DivergesWithExactIdentity
  | IdentityUnavailable

// IdentityUnavailable is NOT folded into structural rendering. Unrealized (a known structural
// declaration) and Refused (identity not supplied) are different answers, and merging them
// reproduces the bypass under a newer name.
type TypedCarrierRow {
  module_file: String
  enclosing_decl: String
  position_kind: String
  authored_name: String
  identity: DeclarationIdentityObservation
  legacy: LegacyKeyObservation
  legacy_base: String
  authority_base: String
  outcome: CensusOutcome
}

fn identity_observation(inferred: String, environment: String) -> DeclarationIdentityObservation {
  if inferred == "" && environment == "" {
    IdentityUnavailableBoth
  } else if inferred == "" {
    IdentityFromEnvironment { decl_file: environment }
  } else if environment == "" {
    IdentityFromInference { decl_file: inferred }
  } else if inferred == environment {
    IdentitiesAgree { decl_file: inferred }
  } else {
    IdentitiesDisagree { inferred: inferred, environment: environment }
  }
}

// NOTE the asymmetry with type_reference_decl_file, and it is deliberate: this reads the
// resolved node ONLY, with no fallback to the reference's own span. An absent answer is
// reported as absent. That is the refusal the production helper does not make.
fn inferred_identity_file(n: Node) -> String {
  match n.inferred {
    Present { value: Resolved { node: rt } } => decl_identity_file(item: rt)
    _ => ""
  }
}

fn environment_identity_file(env: TypeEnv, n: Node) -> String {
  match lookup_type_for(env: env, node: n) {
    Present { value: d } => decl_identity_file(item: d)
    Absent => ""
  }
}

// The legacy key is LegacyFallbackUsed exactly when the production helper had no resolved
// node to read -- the arm that returns the reference's own file.
fn legacy_observation(had_inference: Bool, key: String) -> LegacyKeyObservation {
  if had_inference { LegacyKeyResolved { decl_file: key } } else { LegacyFallbackUsed { reference_file: key } }
}

fn identity_query_file(o: DeclarationIdentityObservation) -> String {
  match o {
    IdentityFromInference { decl_file: d } => d
    IdentityFromEnvironment { decl_file: d } => d
    IdentitiesAgree { decl_file: d } => d
    IdentitiesDisagree { inferred: _, environment: _ } => ""
    IdentityUnavailableBoth => ""
  }
}

fn legacy_claims_text(n: Node, si: Map<String, NewlineIndex>) -> Bool {
  is_host_text_carrier_type(n: n, source_indices: si)
}

fn authority_realizes(name: String, decl_file: String) -> Bool {
  match type_realization_decision(target: Rust, dag_name: name, decl_file: decl_file) {
    Realized { checkpoint: _ } => true
    Unrealized => false
    Refused { cause: _ } => false
  }
}

fn legacy_base_label(n: Node, si: Map<String, NewlineIndex>) -> String {
  if is_host_text_carrier_type(n: n, source_indices: si) { "String" } else { "<not-short-circuited>" }
}

fn authority_base_of(name: String, decl_file: String) -> String {
  match type_realization_decision(target: Rust, dag_name: name, decl_file: decl_file) {
    Realized { checkpoint: cp } => cp.target_type
    Unrealized => "<structural>"
    Refused { cause: _ } => "<refused>"
  }
}

// THE OUTCOME IS STRUCTURAL, NOT STRING EQUALITY, and the first reading of this census got that
// wrong. Comparing rendered spellings makes "String" (what the short-circuit emits) equal "String"
// (what a structural render of the alias LEAF spells), so the divergence being measured compares
// EQUAL. The mechanism is not a spelling difference: the short-circuit emits the HOST String type
// while the authority says no checkpoint governs this declaration and its own structure must be
// rendered instead.
fn outcome_of(claims_text: Bool, realizes: Bool, query_file: String) -> CensusOutcome {
  if query_file == "" {
    IdentityUnavailable
  } else if claims_text && !realizes {
    DivergesWithExactIdentity
  } else {
    Agrees
  }
}

fn typed_decision_row(
  module_file: String,
  enclosing: String,
  position_kind: String,
  n: Node,
  env: TypeEnv,
  si: Map<String, NewlineIndex>
) -> TypedCarrierRow {
  let inferred = inferred_identity_file(n: n)
  let environment = environment_identity_file(env: env, n: n)
  let legacy_key = type_reference_decl_file(n: n)
  let identity = identity_observation(inferred: inferred, environment: environment)
  let query_file = identity_query_file(o: identity)
  let name = authored_name_at(source_indices: si, node: n)
  let claims_text = legacy_claims_text(n: n, si: si)
  TypedCarrierRow {
    module_file: module_file,
    enclosing_decl: enclosing,
    position_kind: position_kind,
    authored_name: name,
    identity: identity,
    legacy: legacy_observation(had_inference: inferred != "", key: legacy_key),
    legacy_base: legacy_base_label(n: n, si: si),
    authority_base: authority_base_of(name: name, decl_file: query_file),
    outcome: outcome_of(claims_text: claims_text, realizes: authority_realizes(name: name, decl_file: query_file), query_file: query_file)
  }
}

// KNOWN OPEN DEFECT IN THE OCCURRENCE SET, recorded here rather than in a plan because it is the
// one thing that makes this instrument's output untrustworthy today and a reader of the rows must
// meet it before the rows. THE WALK ADMITS NON-CARRIER NODES. On the first typed subject its
// authored_name column holds `fn` for every function-typed declaration field -- child_type_node of
// an arrow field yields the arrow node itself -- and single-letter generic PARAMETER names, because
// item.params over a type declaration yields its type parameters rather than a signature's value
// parameters. The pre-reconcile census hit the identical class and its repair did not carry over
// here, which is the point: this is a property of the WALK, and it must be re-established at every
// grain the walk changes rather than assumed to travel with the fix.
//
// It is not repaired in the change that lands this module, deliberately. The repair is only
// verifiable against the calibration control -- the diagnostic-producing subset of the divergence
// rows must equal the arm-A sites the design already counted -- and an occurrence-set edit made
// without that control is how this instrument produced two published-and-withdrawn readings. NO
// COUNT FROM THIS CENSUS IS PUBLISHABLE UNTIL THAT CONTROL RUNS, and while the walk admits `fn`
// nodes no count would mean anything anyway.

fn no_typed_rows() -> List<TypedCarrierRow> {
  []
}

fn typed_field_rows(
  module_file: String, enclosing: String, fields: List<Node>, env: TypeEnv, si: Map<String, NewlineIndex>
) -> List<TypedCarrierRow> {
  fields |> fold(init: no_typed_rows(), f: (acc, fld) => concat(acc, [typed_decision_row(
    module_file: module_file, enclosing: enclosing, position_kind: "declaration_field",
    n: child_type_node(ch: fld), env: env, si: si)]))
}

fn typed_item_rows(module_file: String, item: Node, env: TypeEnv, si: Map<String, NewlineIndex>) -> List<TypedCarrierRow> {
  let enclosing = authored_name_at(source_indices: si, node: item)
  let decl_rows = if !is_type_def_item(item: item) {
    no_typed_rows()
  } else if is_coproduct_type(n: item) {
    item.children |> fold(init: no_typed_rows(), f: (acc, variant) =>
      concat(acc, typed_field_rows(module_file: module_file, enclosing: enclosing, fields: variant.children, env: env, si: si)))
  } else {
    typed_field_rows(module_file: module_file, enclosing: enclosing, fields: item.children, env: env, si: si)
  }
  let param_rows_t = if item.body == none {
    no_typed_rows()
  } else {
    item.params |> fold(init: no_typed_rows(), f: (acc, prm) => concat(acc, [typed_decision_row(
      module_file: module_file, enclosing: enclosing, position_kind: "fn_signature_param",
      n: param_node_type_expr(n: prm), env: env, si: si)]))
  }
  concat(decl_rows, param_rows_t)
}

fn typed_module_rows(m: TypedModule, si: Map<String, NewlineIndex>) -> List<TypedCarrierRow> {
  let module_file = authored_name_at(source_indices: si, node: m.module)
  m.items |> fold(init: no_typed_rows(), f: (acc, item) =>
    concat(acc, typed_item_rows(module_file: module_file, item: item, env: m.type_env, si: si)))
}

fn identity_label(o: DeclarationIdentityObservation) -> String {
  match o {
    IdentityFromInference { decl_file: _ } => "FromInference"
    IdentityFromEnvironment { decl_file: _ } => "FromEnvironment"
    IdentitiesAgree { decl_file: _ } => "Agree"
    IdentitiesDisagree { inferred: _, environment: _ } => "DISAGREE"
    IdentityUnavailableBoth => "UnavailableBoth"
  }
}

fn identity_file_label(o: DeclarationIdentityObservation) -> String {
  match o {
    IdentityFromInference { decl_file: d } => d
    IdentityFromEnvironment { decl_file: d } => d
    IdentitiesAgree { decl_file: d } => d
    IdentitiesDisagree { inferred: i, environment: e } => concat(concat(i, " != "), e)
    IdentityUnavailableBoth => ""
  }
}

fn legacy_label(l: LegacyKeyObservation) -> String {
  match l {
    LegacyFallbackUsed { reference_file: f } => concat("FALLBACK:", f)
    LegacyKeyResolved { decl_file: d } => concat("resolved:", d)
  }
}


fn outcome_label(o: CensusOutcome) -> String {
  match o {
    Agrees => "Agrees"
    DivergesWithExactIdentity => "DivergesWithExactIdentity"
    IdentityUnavailable => "IdentityUnavailable"
  }
}

fn tsv_escape(v: String) -> String {
  replace(replace(v, "\t", "\\t"), "\n", "\\n")
}

fn typed_census_header() -> String {
  "module_file\tenclosing_decl\tposition_kind\tauthored_name\tidentity\tidentity_file\tlegacy_key\tlegacy_base\tauthority_base\toutcome"
}

fn typed_row_tsv(r: TypedCarrierRow) -> String {
  [
    tsv_escape(v: r.module_file),
    tsv_escape(v: r.enclosing_decl),
    tsv_escape(v: r.position_kind),
    tsv_escape(v: r.authored_name),
    identity_label(o: r.identity),
    tsv_escape(v: identity_file_label(o: r.identity)),
    tsv_escape(v: legacy_label(l: r.legacy)),
    tsv_escape(v: r.legacy_base),
    tsv_escape(v: r.authority_base),
    outcome_label(o: r.outcome)
  ] |> join(separator: "\t")
}

fn typed_census_tsv(rows: List<TypedCarrierRow>) -> String {
  rows |> fold(init: typed_census_header(), f: (acc, r) => concat(concat(acc, "\n"), typed_row_tsv(r: r)))
}

// THE ENTRY THE DRIVER CALLS. Sources in as data, receipt out as a String; no host effect, no
// path, no process verdict. A compile that produces no graph REFUSES in the return value rather
// than yielding an empty table, because an empty receipt and a receipt that could not be produced
// must not share a spelling.
fn typed_census_from_sources(sources: List<SourceFile>) -> String {
  let result = compile_to_resolved(sources: sources)
  match result.graph {
    Absent => "REFUSED\tcompile_to_resolved produced no graph"
    Present { value: g } =>
      typed_census_tsv(rows: g.modules |> fold(init: no_typed_rows(), f: (acc, m) =>
        concat(acc, typed_module_rows(m: m, si: result.source_indices))))
  }
}
