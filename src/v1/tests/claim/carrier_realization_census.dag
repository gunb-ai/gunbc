module v1.tests.claim.carrier_realization_census

import v1.compiler.compile { SourceFile, FrontendResult, front_end_sources }
import v1.compiler.emit_rust { is_host_text_carrier_type }
import v1.compiler.emit_core_support { is_type_def_item }
import v1.compiler.infer_types { is_coproduct_type, child_type_node }
import v1.compiler.coercion { type_realization_decision, type_reference_decl_file }
import v1.compiler.artifact { Rust }
import v1.compiler.resolve { ModuleGraph, ResolvedModule }
import v1.std.core { Node, NewlineIndex, authored_name_at, module_items, param_node_type_expr }
import std.coercion { TypeRealizationDecision, Realized, Unrealized, Refused }
import std.types { List, String, Map }
import extdeps.filesystem.filesystem_io { Filesystem }

// The step-1 shadow census: for every type-reference occurrence the v1 emitter would
// render, compute BOTH the legacy short-circuit answer and the strict identity
// authority's answer, and report where they disagree. Emits nothing, renders nothing,
// changes no byte -- the divergence is a fact about two pure functions over one tree.
//
// The predicate is IMPORTED, never re-derived: a second copy of is_host_text_carrier_type
// would be the same forked authority this census exists to measure.
//
// The authority queried is the STRICT type_realization_decision, never lookup_checkpoint,
// whose decl_file == "" arm preserves the bare-name fallback and would measure the bypass
// against itself.

type CensusOutcome
  = Agrees
  | DivergesWithExactIdentity
  | IdentityUnavailable

// IdentityUnavailable is NOT folded into structural rendering. Unrealized (a known
// structural declaration) and Refused (identity not supplied) are different answers, and
// merging them reproduces the bypass under a newer name.
type CarrierDecisionRow {
  module_file: String
  enclosing_decl: String
  position_kind: String
  authored_name: String
  decl_file: String
  legacy_base: String
  authority_base: String
  outcome: CensusOutcome
}

fn no_rows() -> List<CarrierDecisionRow> {
  []
}

fn source_indices_of(fr: FrontendResult) -> Map<String, NewlineIndex> {
  fr.newline_indices |> fold(init: empty_map(), f: (acc, si) => map_insert(acc, si.file, si))
}

// The legacy answer, taken from the imported predicate rather than restated: when the
// short-circuit fires the renderer returns the literal "String" before any checkpoint or
// roster consultation, so that is the legacy base at this occurrence.
// THE OUTCOME IS STRUCTURAL, NOT STRING EQUALITY, and the first version of this census
// got that wrong. Comparing rendered spellings makes `String` (what the short-circuit
// emits) equal `String` (what a structural render of the alias LEAF spells), so the very
// divergence being measured compares equal. The mechanism is not a spelling difference:
// the short-circuit emits the HOST String type, while the authority says no checkpoint
// governs this declaration and its own structure must be rendered instead.
fn legacy_claims_text(n: Node, si: Map<String, NewlineIndex>) -> Bool {
  is_host_text_carrier_type(n: n, source_indices: si)
}

fn authority_realizes(name: String, decl_file: String) -> Bool {
  match type_realization_decision(target: Rust, dag_name: name, decl_file: decl_file) {
    Realized { checkpoint: _ } => true
    Unrealized => false
    Refused { cause: _ } => false
  }
}

fn legacy_base_label(n: Node, si: Map<String, NewlineIndex>) -> String {
  if is_host_text_carrier_type(n: n, source_indices: si) { "String" } else { "<not-short-circuited>" }
}

fn authority_base_of(name: String, decl_file: String) -> String {
  match type_realization_decision(target: Rust, dag_name: name, decl_file: decl_file) {
    Realized { checkpoint: cp } => cp.target_type
    Unrealized => "<structural>"
    Refused { cause: _ } => "<refused>"
  }
}

fn outcome_of(claims_text: Bool, realizes: Bool, decl_file: String) -> CensusOutcome {
  if decl_file == "" {
    IdentityUnavailable
  } else if claims_text && !realizes {
    DivergesWithExactIdentity
  } else {
    Agrees
  }
}

fn decision_row(
  module_file: String,
  enclosing: String,
  position_kind: String,
  n: Node,
  si: Map<String, NewlineIndex>
) -> CarrierDecisionRow {
  let name = authored_name_at(source_indices: si, node: n)
  let decl_file = type_reference_decl_file(n: n)
  let legacy = legacy_base_label(n: n, si: si)
  let authority = authority_base_of(name: name, decl_file: decl_file)
  CarrierDecisionRow {
    module_file: module_file,
    enclosing_decl: enclosing,
    position_kind: position_kind,
    authored_name: name,
    decl_file: decl_file,
    legacy_base: legacy,
    authority_base: authority,
    outcome: outcome_of(
      claims_text: legacy_claims_text(n: n, si: si),
      realizes: authority_realizes(name: name, decl_file: decl_file),
      decl_file: decl_file
    )
  }
}

// Field/variant-field type positions of one declaration, enumerated through the
// emitter's OWN enumeration (v1_item_field_type_exprs) rather than a parallel walk --
// a second traversal is the drift risk the calibration control exists to catch.
fn field_rows(
  module_file: String,
  enclosing: String,
  fields: List<Node>,
  si: Map<String, NewlineIndex>
) -> List<CarrierDecisionRow> {
  fields |> fold(init: no_rows(), f: (acc, fld) => concat(acc, [decision_row(
    module_file: module_file,
    enclosing: enclosing,
    position_kind: "declaration_field",
    n: child_type_node(ch: fld),
    si: si
  )]))
}

// A type declaration's FIELD type expressions -- and nothing else. The first version
// called v1_item_field_type_exprs on EVERY item, including fn items and generic-bearing
// type declarations, and read back `T`, `M`, `R` and `fn`: generic parameter names and
// the fn keyword, never a carrier reference.
fn item_decl_rows(
  module_file: String,
  item: Node,
  si: Map<String, NewlineIndex>
) -> List<CarrierDecisionRow> {
  let enclosing = authored_name_at(source_indices: si, node: item)
  if !is_type_def_item(item: item) {
    no_rows()
  } else if is_coproduct_type(n: item) {
    item.children |> fold(init: no_rows(), f: (acc, variant) =>
      concat(acc, field_rows(module_file: module_file, enclosing: enclosing, fields: variant.children, si: si)))
  } else {
    field_rows(module_file: module_file, enclosing: enclosing, fields: item.children, si: si)
  }
}

// A FUNCTION's signature parameters -- and only a function's. The body guard is what
// keeps a `type` declaration's GENERIC parameters out: item.params on a type declaration
// holds T, M, R, which the first reading duly reported as fn signature parameters.
fn param_rows(
  module_file: String,
  item: Node,
  si: Map<String, NewlineIndex>
) -> List<CarrierDecisionRow> {
  let enclosing = authored_name_at(source_indices: si, node: item)
  if item.body == none {
    no_rows()
  } else {
    item.params |> fold(init: no_rows(), f: (acc, p) => concat(acc, [decision_row(
      module_file: module_file,
      enclosing: enclosing,
      position_kind: "fn_signature_param",
      n: param_node_type_expr(n: p),
      si: si
    )]))
  }
}

fn module_rows(m: ResolvedModule, si: Map<String, NewlineIndex>) -> List<CarrierDecisionRow> {
  let module_file = authored_name_at(source_indices: si, node: m.module)
  module_items(n: m.module) |> fold(init: no_rows(), f: (acc, item) =>
    concat(concat(acc, item_decl_rows(module_file: module_file, item: item, si: si)),
           param_rows(module_file: module_file, item: item, si: si)))
}

fn census_rows(sources: List<SourceFile>) -> List<CarrierDecisionRow> {
  let fr = front_end_sources(sources: sources)
  let si = source_indices_of(fr: fr)
  match fr.graph {
    Absent => no_rows()
    Present { value: g } =>
      g.modules |> fold(init: no_rows(), f: (acc, m) => concat(acc, module_rows(m: m, si: si)))
  }
}

// ---------------------------------------------------------------------------
// Subject sources. FAIL-CLOSED: one unreadable path refuses the whole census.
//
// A census over a PARTIAL closure silently under-counts, and an under-count here is
// indistinguishable from a clean result -- the empty-observation narrow DESIGN section 5
// names, where an observation that could not see what changed is rendered as "nothing is
// affected". Skipping the file would zero this deficit's frequency by construction. So the
// arm refuses and names the path rather than widening or narrowing.
// ---------------------------------------------------------------------------

type CensusSources
  = SourcesRead { sources: List<SourceFile> }
  | SourceReadRefused { path: String }

fn census_sources_step(acc: CensusSources, path: String) -> CensusSources {
  match acc {
    SourceReadRefused { path: p } => SourceReadRefused { path: p }
    SourcesRead { sources: so_far } => {
      let read_out = Filesystem.Read(path: path)
      if !read_out.success {
        SourceReadRefused { path: path }
      } else {
        SourcesRead { sources: concat(so_far, [SourceFile { path: path, content: read_out.content }]) }
      }
    }
  }
}

fn census_sources_from_paths(paths: List<String>) -> CensusSources {
  paths |> fold(init: SourcesRead { sources: [] }, f: (acc, p) => census_sources_step(acc: acc, path: p))
}

// ---------------------------------------------------------------------------
// Receipt. The cross-tab is the artifact, so the row carries the raw fields the
// verdict was computed from -- a classifier that folds its discriminating input into
// its label destroys later re-adjudication, which is the instrument lesson this lane
// paid for once already.
// ---------------------------------------------------------------------------

fn outcome_label(o: CensusOutcome) -> String {
  match o {
    Agrees => "Agrees"
    DivergesWithExactIdentity => "DivergesWithExactIdentity"
    IdentityUnavailable => "IdentityUnavailable"
  }
}

// TSV FIELD ESCAPING, and it is not hygiene -- its absence UNDER-COUNTED the class this
// census measures. A `data ...: String` note body carrying a tab or newline leaked into the
// receipt and split one row across fields, so its outcome token no longer terminated the
// line and a line-anchored histogram scored 3 divergences where there were 4. The corrupted
// row was still present and still correct; the INSTRUMENT reading it was wrong, and the
// error direction was toward fewer findings, which is the direction nothing complains about.
fn tsv_escape(v: String) -> String {
  replace(replace(v, "\t", "\\t"), "\n", "\\n")
}

fn census_tsv_header() -> String {
  "module_file\tenclosing_decl\tposition_kind\tauthored_name\tdecl_file\tlegacy_base\tauthority_base\toutcome"
}

fn census_row_tsv(r: CarrierDecisionRow) -> String {
  concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(
    tsv_escape(v: r.module_file), "\t"), tsv_escape(v: r.enclosing_decl)), "\t"),
    tsv_escape(v: r.position_kind)), "\t"), tsv_escape(v: r.authored_name)), "\t"),
    tsv_escape(v: r.decl_file)), "\t"), tsv_escape(v: r.legacy_base)), "\t"),
    tsv_escape(v: r.authority_base)), "\t"), outcome_label(o: r.outcome))
}

fn census_tsv(rows: List<CarrierDecisionRow>) -> String {
  rows |> fold(init: census_tsv_header(), f: (acc, r) => concat(concat(acc, "\n"), census_row_tsv(r: r)))
}

fn census_receipt_for_paths(paths: List<String>) -> String {
  match census_sources_from_paths(paths: paths) {
    SourceReadRefused { path: p } => concat("REFUSED\tsource_read_failed\t", p)
    SourcesRead { sources: srcs } => census_tsv(rows: census_rows(sources: srcs))
  }
}

// First end-to-end subject: a small, self-contained closure that genuinely exercises the
// carrier -- dag/std/string_type.dag declares `type String = FreeMonoid<Char>`, which is the
// exact declaration the structural roster enrolls and the exact one the short-circuit
// short-circuits past. This is a MECHANISM proof, not the calibration subject: the
// calibration control runs against the 03_ingest closure and its 25 arm-A sites, and no
// divergence count from this entry may be published as the census result.
data census_smoke_subject_paths: List<String> = [
  "dag/std/algebra.dag",
  "dag/std/types.dag",
  "dag/std/string_type.dag"
]

fn census_smoke_receipt() -> String {
  census_receipt_for_paths(paths: census_smoke_subject_paths)
}

// SIDECAR RECEIPT AS A FILE, which is what the design specified and what the first
// readings did not do. Returning the TSV as the entry's value put it inside the run
// harness's own message -- `function ... returned <value>, not ProcessExit.` -- so the
// LAST row of every receipt carried a harness suffix, and a line-anchored histogram over
// that output silently dropped it. The receipt was always correct; the reading of it was
// short by exactly one row, and short in the direction that reports FEWER findings.
data census_smoke_receipt_path: String = "target/carrier-realization-census/smoke.tsv"

fn census_write_smoke_receipt() -> Bool {
  Filesystem.Write(
    path: census_smoke_receipt_path,
    content: census_receipt_for_paths(paths: census_smoke_subject_paths)
  ).success
}

// THE CALIBRATION CONTROL (smart-ram-730's ruling: mandatory, and the census is
// unreportable until it passes). The subject is the import closure of
// `src/v2/compiler/01_tokenize.dag`, computed by following `import` edges to a fixed
// point -- NOT the whole 03_ingest closure, because ALL 25 arm-A sites recorded in
// `arbiter_arms.tsv` are in `src/v2_compiler_tokenize.rs`, which this one module emits.
// Naming the larger closure would have made the control weaker, not stronger: every
// module beyond this one adds occurrences the control cannot join to any known site, so
// the reproduce-the-25 test would be diluted by rows it has no verdict for.
//
// WHAT THE CONTROL ASSERTS, and it is a JOIN, not a count: the divergence rows this walk
// produces must be exactly the DECLARATIONS the 25 arm-A sites consume -- joined on
// (source module, enclosing declaration, position kind), NEVER on line. The relation is
// many-to-one by construction: an arm-A site is a USE of a carrier-typed declaration, and
// several uses share one declaration, so |divergence rows| < 25 is EXPECTED and is not a
// miss. A count equality here would be the wrong oracle (DESIGN §5: completeness is an
// identity join, not a count equality).
//
// If the join leaves an arm-A site with no declaration in this set, the walk does not
// reach what the emitter reaches, and the census is WRONG -- report the mismatch, never a
// divergence count.
data census_calibration_subject_paths: List<String> = [
  "dag/std/algebra.dag",
  "dag/std/content_hash.dag",
  "dag/std/decl_ref.dag",
  "dag/std/disposition.dag",
  "dag/std/dissolution.dag",
  "dag/std/error_primitives.dag",
  "dag/std/occurrence_identity.dag",
  "dag/std/primitives.dag",
  "dag/std/source_annotation.dag",
  "dag/std/types.dag",
  "src/v2/compiler/01_tokenize.dag",
  "src/v2/std/algebra.dag",
  "src/v2/std/collection.dag",
  "src/v2/std/compilers/lexing.dag",
  "src/v2/std/diagnostic.dag",
  "src/v2/std/logic.dag",
  "src/v2/std/nat.dag",
  "src/v2/std/node.dag",
  "src/v2/std/node_shape.dag",
  "src/v2/std/optional.dag",
  "src/v2/std/text.dag",
  "src/v2/std/witness.dag"
]

data census_calibration_receipt_path: String = "target/carrier-realization-census/calibration.tsv"

fn census_write_calibration_receipt() -> Bool {
  Filesystem.Write(
    path: census_calibration_receipt_path,
    content: census_receipt_for_paths(paths: census_calibration_subject_paths)
  ).success
}
