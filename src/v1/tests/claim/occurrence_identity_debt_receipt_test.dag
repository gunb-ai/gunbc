module v1.tests.claim.occurrence_identity_debt_receipt_test


data occurrence_identity_debt_receipt_offline_recipe: String = "LOCAL CONTROL RECIPE: target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/occurrence_identity_debt_receipt_test.dag --functions w_rebuilt_reference_identity_preservation_executes_holds,w_structurally_equal_distinct_occurrences_execute_holds,w_pattern_declaration_reachability_executes_holds,w_same_spelling_parser_declaration_isolation_executes_holds"

data parser_reaching_witness_governed_placement_note: String = "GOVERNED PLACEMENT LAW for a witness importing the production v1 parser: discovery, compile-clean, stage0 regeneration, and scheduled execution are separate authorities and satisfying one does not satisfy the others. dag/test/claim is invalid because ordinary discovery resolves against witness_layer_roots = [dag, src/v2], where v1.compiler imports cannot resolve. dag/test/manual is discovery-excluded but remains inside the dag compile-clean universe, so the same imports hard-fail whole-tree compile-clean; exclusion from discovery is not exclusion from compile-clean. docs or any path outside dag, src/v2, and src/v1 avoids those failures only by becoming ungoverned, which is not a placement. src/v1/tests/claim is the governed home: compile_clean_source_roots includes src/v1, ordinary discovery does not scan it, and regen capture is the established gated pattern rather than a defect; the file and every newly reachable module in its import closure require registered generated_stage0_files projections. parser_transport_witness_entries supplies the remaining scoped per-PR EXECUTION consumer only. A roster row does not grant compile-clean roots or stage0 residency."

data occurrence_identity_debt_receipt_boundary_note: String = "Acceptance receipts for four occurrence-identity debts owned by namespace-reference-derived-closure. Every fixture enters through the production parser, and every asserted reference is consumed by std.occurrence_binding_resolve.resolve_reference_occurrence_binding, the canonical sidecar-consuming supplied-candidate boundary. The functions are green by local execution but their consumer debt rows remain until parser_transport_witness_entries exists on main and executes them per PR under the scoped dag and src/v1 parser-transport batch. The rebuilt-reference receipt additionally executes locally through the production compile/reconcile Node rebuild in the generated pipeline_occurrence_sidecar_serde_round_trip test: it parses the left source independently, compiles that same source, and requires byte-equal OccurrenceTransport ids and containment paths before serde. That Rust assertion is cargo-checked but not executed per PR. Discriminating RED packet: removing or reminting typed-module occurrence_transport propagation reds rebuilt-reference; resetting the allocator between identical reparses reds structurally-equal distinct identity; skipping nested Bind declarations in stamp_parsed_pattern reds pattern reachability; and keying any parser occurrence population by authored_name instead of std.occurrence_identity.OccurrenceId reds the same-spelling matrix. one-occurrence-collector-dedupe is deliberately absent: main has no occurrence-aware repeated-discovery collector, and a test-local deduper would not be a consumer."

fn oid_receipt_parse(
  source: String,
  file: String,
  allocator: OccurrenceIdAllocator
) -> ParseWithTableResult {
  parse_with_table_in_occurrence_scope(
    tokens: tokenize(source: source, file: file),
    source_indices: map_insert(
      empty_map(),
      file,
      build_newline_index(file: file, source: source),
    ),
    intern_table: empty_intern_table(),
    occurrence_allocator: allocator,
  )
}

fn oid_receipt_name_for_occurrence(
  transport: OccurrenceTransport,
  occurrence: std.occurrence_identity.OccurrenceId
) -> String? {
  match transport.index.entries
    |> filter(entry => entry.projection.occurrence.value == occurrence.value)
    |> first {
    Present { value: entry } => Present { value: entry.projection.authored_name }
    Absent => none
  }
}

fn oid_receipt_lexical_declarations_named(
  transport: OccurrenceTransport,
  name: String
) -> List<DeclarationOccurrence> {
  transport.declarations
    |> filter(declaration =>
      match declaration.category {
        LexicalValueOccurrence =>
          oid_receipt_name_for_occurrence(
            transport: transport,
            occurrence: declaration.occurrence,
          ) == Present { value: name }
        _ => false
      }
    )
}

fn oid_receipt_lexical_references_named(
  transport: OccurrenceTransport,
  name: String
) -> List<ReferenceOccurrence> {
  transport.references
    |> filter(reference =>
      match reference.category {
        LexicalValueOccurrence =>
          oid_receipt_name_for_occurrence(
            transport: transport,
            occurrence: reference.occurrence,
          ) == Present { value: name }
        _ => false
      }
    )
}

fn oid_receipt_exact_binding_holds(
  transport: OccurrenceTransport,
  reference: ReferenceOccurrence,
  declaration: DeclarationOccurrence
) -> Bool {
  match resolve_reference_occurrence_binding(
    transport: transport,
    occurrence: reference.occurrence,
    supplied_candidates: [declaration.occurrence],
  ) {
    OccurrenceReferenceBindingDecided {
      result: OccurrenceBound { binding: binding },
    } =>
      occurrence_containment_paths_equal(
        left: OccurrenceContainmentPath {
          ancestors: binding.occurrence.containment.ancestors,
          terminal: binding.occurrence.containment.terminal,
        },
        right: reference.containment,
      ) &&
      occurrence_containment_paths_equal(
        left: OccurrenceContainmentPath {
          ancestors: binding.candidate.containment.ancestors,
          terminal: binding.candidate.containment.terminal,
        },
        right: declaration.containment,
      )
    _ => false
  }
}

fn oid_receipt_unbound_reference_holds(
  transport: OccurrenceTransport,
  reference: ReferenceOccurrence
) -> Bool {
  match resolve_reference_occurrence_binding(
    transport: transport,
    occurrence: reference.occurrence,
    supplied_candidates: [],
  ) {
    OccurrenceReferenceBindingDecided {
      result: OccurrenceUnbound { occurrence: occurrence },
    } =>
      occurrence_containment_paths_equal(
        left: OccurrenceContainmentPath {
          ancestors: occurrence.containment.ancestors,
          terminal: occurrence.containment.terminal,
        },
        right: reference.containment,
      )
    _ => false
  }
}

fn oid_receipt_all_pairs_bind_exactly(
  transport: OccurrenceTransport,
  references: List<ReferenceOccurrence>,
  declarations: List<DeclarationOccurrence>
) -> Bool {
  references |> all(reference =>
    declarations |> all(declaration =>
      oid_receipt_exact_binding_holds(
        transport: transport,
        reference: reference,
        declaration: declaration,
      )
    )
  )
}

fn oid_receipt_single_pair_binds_exactly(
  transport: OccurrenceTransport,
  references: List<ReferenceOccurrence>,
  declarations: List<DeclarationOccurrence>
) -> Bool {
  if (references |> count) != 1 || (declarations |> count) != 1 {
    false
  } else {
    match references |> first {
      Absent => false
      Present { value: reference } =>
        match declarations |> first {
          Absent => false
          Present { value: declaration } =>
            oid_receipt_exact_binding_holds(
              transport: transport,
              reference: reference,
              declaration: declaration,
            )
        }
    }
  }
}

fn oid_receipt_single_populations_have_distinct_ids(
  first_references: List<ReferenceOccurrence>,
  first_declarations: List<DeclarationOccurrence>,
  second_references: List<ReferenceOccurrence>,
  second_declarations: List<DeclarationOccurrence>
) -> Bool {
  match first_references |> first {
    Absent => false
    Present { value: first_reference } =>
      match first_declarations |> first {
        Absent => false
        Present { value: first_declaration } =>
          match second_references |> first {
            Absent => false
            Present { value: second_reference } =>
              match second_declarations |> first {
                Absent => false
                Present { value: second_declaration } =>
                  first_reference.occurrence.value != second_reference.occurrence.value &&
                  first_declaration.occurrence.value != second_declaration.occurrence.value
              }
          }
      }
  }
}

fn oid_receipt_occurrence_ids_are_pairwise_distinct(
  occurrences: List<std.occurrence_identity.OccurrenceId>
) -> Bool {
  occurrences |> enumerate |> all(left =>
    occurrences |> enumerate |> all(right =>
      left.first == right.first || left.second.value != right.second.value
    )
  )
}

fn oid_receipt_containments_are_pairwise_distinct(
  containments: List<OccurrenceContainmentPath>
) -> Bool {
  containments |> enumerate |> all(left =>
    containments |> enumerate |> all(right =>
      left.first == right.first ||
      !occurrence_containment_paths_equal(
        left: left.second,
        right: right.second,
      )
    )
  )
}

fn oid_receipt_same_name_population_holds(
  transport: OccurrenceTransport,
  name: String,
  declaration_count: Int,
  reference_count: Int
) -> Bool {
  let declarations = oid_receipt_lexical_declarations_named(
    transport: transport,
    name: name,
  )
  let references = oid_receipt_lexical_references_named(
    transport: transport,
    name: name,
  )
  let ids = concat(
    declarations |> map(declaration => declaration.occurrence),
    references |> map(reference => reference.occurrence),
  )
  let paths = concat(
    declarations |> map(declaration => declaration.containment),
    references |> map(reference => reference.containment),
  )
  (declarations |> count) == declaration_count &&
  (references |> count) == reference_count &&
  oid_receipt_occurrence_ids_are_pairwise_distinct(occurrences: ids) &&
  oid_receipt_containments_are_pairwise_distinct(containments: paths) &&
  oid_receipt_all_pairs_bind_exactly(
    transport: transport,
    references: references,
    declarations: declarations,
  )
}

test fn w_rebuilt_reference_identity_preservation_executes_holds() -> Bool {
  let source = "module occurrence.receipt_rebuild\n\nfn keep(x: Int) -> Int { x }\nfn use() -> Int { keep(1) }\n"
  let file = "occurrence-receipt-rebuild.dag"
  let parsed = oid_receipt_parse(
    source: source,
    file: file,
    allocator: occurrence_id_allocator_initial(),
  )
  parsed.result.error == none &&
  match parsed.occurrence_transport.references |> first {
    Absent => false
    Present { value: reference } =>
      oid_receipt_unbound_reference_holds(
        transport: parsed.occurrence_transport,
        reference: reference,
      )
  }
}

test fn w_structurally_equal_distinct_occurrences_execute_holds() -> Bool {
  let source = "module occurrence.receipt_equal\n\nfn same(x: Int) -> Int { x }\n"
  let file = "occurrence-receipt-equal.dag"
  let first = oid_receipt_parse(
    source: source,
    file: file,
    allocator: occurrence_id_allocator_initial(),
  )
  let second = oid_receipt_parse(
    source: source,
    file: file,
    allocator: first.occurrence_allocator,
  )
  let first_declarations = oid_receipt_lexical_declarations_named(
    transport: first.occurrence_transport,
    name: "x",
  )
  let first_references = oid_receipt_lexical_references_named(
    transport: first.occurrence_transport,
    name: "x",
  )
  let second_declarations = oid_receipt_lexical_declarations_named(
    transport: second.occurrence_transport,
    name: "x",
  )
  let second_references = oid_receipt_lexical_references_named(
    transport: second.occurrence_transport,
    name: "x",
  )
  first.result.error == none &&
  second.result.error == none &&
  first.result.module == second.result.module &&
  (first_declarations |> count) == 1 &&
  (first_references |> count) == 1 &&
  (second_declarations |> count) == 1 &&
  (second_references |> count) == 1 &&
  oid_receipt_single_populations_have_distinct_ids(
    first_references: first_references,
    first_declarations: first_declarations,
    second_references: second_references,
    second_declarations: second_declarations,
  ) &&
  oid_receipt_single_pair_binds_exactly(
    transport: first.occurrence_transport,
    references: first_references,
    declarations: first_declarations,
  ) &&
  oid_receipt_single_pair_binds_exactly(
    transport: second.occurrence_transport,
    references: second_references,
    declarations: second_declarations,
  )
}

test fn w_pattern_declaration_reachability_executes_holds() -> Bool {
  let source = "module occurrence.receipt_patterns\n\nfn direct(input: Any) -> Any { match input { direct_bind => direct_bind } }\nfn explicit(input: Any) -> Any { match input { Pair { left: explicit_bind } => explicit_bind } }\nfn shorthand(input: Any) -> Any { match input { Shorthand { shorthand_only } => shorthand_only } }\nfn positional(input: Any) -> Any { match input { Left(positional_bind) => positional_bind } }\nfn nested(input: Any) -> Any { match input { Outer { pair: Pair { left: nested_bind } } => nested_bind } }\n"
  let parsed = oid_receipt_parse(
    source: source,
    file: "occurrence-receipt-patterns.dag",
    allocator: occurrence_id_allocator_initial(),
  )
  let names = [
    "direct_bind",
    "explicit_bind",
    "shorthand_only",
    "positional_bind",
    "nested_bind",
  ]
  parsed.result.error == none &&
  names |> all(name =>
    let declarations = oid_receipt_lexical_declarations_named(
      transport: parsed.occurrence_transport,
      name: name,
    )
    let references = oid_receipt_lexical_references_named(
      transport: parsed.occurrence_transport,
      name: name,
    )
    oid_receipt_single_pair_binds_exactly(
      transport: parsed.occurrence_transport,
      references: references,
      declarations: declarations,
    )
  )
}

test fn w_same_spelling_parser_declaration_isolation_executes_holds() -> Bool {
  let sibling_source = "module occurrence.receipt_sibling_arms\n\nfn sibling(input: Any) -> Any { match input { Left { value: y } => y, Right { value: y } => y } }\n"
  let sibling = oid_receipt_parse(
    source: sibling_source,
    file: "occurrence-receipt-sibling-arms.dag",
    allocator: occurrence_id_allocator_initial(),
  )
  let source = "module occurrence.receipt_same_spelling\n\nfn sibling(input: Any) -> Any { match input { Left { value: y } => y, Right { value: y } => y } }\nfn nested_let(input: Any) -> Any { match input { Left { value: y } => { let y = 1 y }, Right { value: other } => other } }\nfn lambda(items: List<Int>, y: Int) -> List<Int> { items |> map(y => y) }\nfn parameter(y: Int) -> Int { y }\n"
  let parsed = oid_receipt_parse(
    source: source,
    file: "occurrence-receipt-same-spelling.dag",
    allocator: occurrence_id_allocator_initial(),
  )
  sibling.result.error == none &&
  parsed.result.error == none &&
  oid_receipt_same_name_population_holds(
    transport: sibling.occurrence_transport,
    name: "y",
    declaration_count: 2,
    reference_count: 2,
  ) &&
  oid_receipt_same_name_population_holds(
    transport: parsed.occurrence_transport,
    name: "y",
    declaration_count: 7,
    reference_count: 5,
  )
}
