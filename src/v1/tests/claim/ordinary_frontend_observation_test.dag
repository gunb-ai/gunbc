module v1.tests.claim.ordinary_frontend_observation_test

import v1.compiler.compile { SourceFile }
import v1.compiler.frontend_observation {
  OrdinaryFrontendObservation,
  observe_ordinary_frontend
}

// Enrollment: the v1_claim_scoped_witness_entries roster (dag + src/v1), the
// same scoped batch caret_parse_smoke_test rides. The roster module is named
// here without its dotted path on purpose: the bare-reference closure scans
// text, so writing the path pulls that module — and its src/v2 imports, absent
// from these roots — into this witness's pool and the resolve refuses.
// Local reproduction:
// target/release/claim_batch --source-root dag --source-root src/v1 --entry
// src/v1/tests/claim/ordinary_frontend_observation_test.dag --functions
// w_map_typed_literal_is_a_map,w_record_literal_is_still_a_record,w_ordinary_frontend_runs_on_a_tiny_subject,w_ordinary_frontend_reports_a_broken_subject

// The map-literal representation, on a CONTROLLED fixture: this module authors
// both the input and the expected key population, so the assertion is not a
// measurement of the current tree copied back onto itself.
data probe_keyed_literal: Map<String, Bool> = {
  "alpha": true, "beta": false, "gamma": true
}

type ProbeRecord {
  alpha: Bool
  beta: Bool
}

data probe_record_literal: ProbeRecord = ProbeRecord { alpha: true, beta: false }

// DECLARED GAP AND ITS NEXT-RUNG TRIGGER (§4b: no untracked stall). The
// interpreter's map-literal key guard refuses any key type it cannot
// positively establish as string-like, and that REFUSAL ARM has no witness
// here. The class is can-climb-now-but-unbuilt, not cannot-climb: a refusing
// data initializer stops module evaluation instead of returning a Bool, so it
// cannot be an ordinary green arm — but the repo already has the mechanism for
// exactly that shape, the expecting-red quarantine probe, whose rows live at
// function grain on gunbc.explicit_witness_admission and run on the falsifier
// cadence where greening is a counted un-quarantine event. The trigger is a
// probe module declaring a non-string-keyed map literal, enrolled expecting
// red; if the guard ever stops refusing, that row greens and is counted rather
// than passing unnoticed. Not built in this lane, and named so it cannot stall
// silently.

// RED before this lane: `map_keys` refused a brace literal in a Map-typed
// position with `map_keys expects a map, got Record`, because the interpreter
// built a record where the emitter builds a HashMap.
fn w_map_typed_literal_is_a_map() -> Bool {
  let keys = map_keys(probe_keyed_literal) |> sort_by(k => k)
  (keys |> count) == 3
    && keys == ["alpha", "beta", "gamma"]
    && (map_values(probe_keyed_literal) |> filter(v => v) |> count) == 2
}

// The control that keeps the fix from over-converting: a literal in a NAMED
// record position stays a record, with ordinary field access.
fn w_record_literal_is_still_a_record() -> Bool {
  probe_record_literal.alpha && !probe_record_literal.beta
}

// The ordinary front end, observed executing.
fn tiny_subject() -> List<SourceFile> {
  [SourceFile {
    path: "tiny_subject.dag",
    content: "module tiny.subject\nfn probe() -> Bool { true }\n"
  }]
}

fn broken_subject() -> List<SourceFile> {
  [SourceFile {
    path: "broken_subject.dag",
    content: "module tiny.broken\nfn probe( -> Bool { true }\n"
  }]
}

fn w_ordinary_frontend_runs_on_a_tiny_subject() -> Bool {
  let observed = observe_ordinary_frontend(sources: tiny_subject())
  (observed.diagnostics |> count) == 0
    && observed.receipt.graph_present
    && observed.receipt.module_count == 1
    && observed.receipt.occurrence_count > 0
    && observed.receipt.declaration_count > 0
    && (observed.subject |> count) == 1
}

// The discriminating arm: a producer fabricating a clean observation, or one
// that never fed the subject to the front end at all, stays green on the arm
// above and reds here.
fn w_ordinary_frontend_reports_a_broken_subject() -> Bool {
  let observed = observe_ordinary_frontend(sources: broken_subject())
  (observed.diagnostics |> count) > 0
}
