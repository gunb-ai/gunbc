module v1.tests.claim.namespace_reference_derived_closure_production_admissions_witness_test

import gunbc.namespace_reference_derived_closure_admission {
  ReferenceDerivedClosureAdmission,
  ReferenceDerivedClosureEstablished,
  ReferenceDerivedClosureUnavailable,
  SameFileEarlierNeighbourVisible,
  SiblingDecisionBranchExcluded,
  LaterDeclarationExcluded,
  DistinctSameSpelledDeclarationsPreserved,
  RepeatedMentionsCollapseDependency,
  UnrelatedLoadedFileExcluded,
  P2aReferenceDependencyProjection7515,
  P2aPoolIndependentDependencyProjection7515,
}
import gunbc.namespace_reference_derived_closure_contract {
  reference_derived_closure_closing_frontier_count,
}
import v1.gunbc.namespace_reference_derived_closure_production_admissions {
  observe_same_file_earlier_neighbour_visible,
  observe_sibling_decision_branch_excluded,
  observe_later_declaration_excluded,
  observe_distinct_same_spelled_declarations_preserved,
}
import std.types { Bool, Int, List }

data namespace_reference_derived_closure_production_admissions_witness_note: String = "N3-A executing witnesses: each structural clause (a-d) is established by an independent production parse→P2a→assess path. Inline six-row lists here leave clauses (e-f) unavailable (frontier 2); the acceptance witness at v1.tests.claim.namespace_reference_derived_closure_acceptance composes the full closing list. Discriminating RED: witness_closing_contract_still_reds_until_dependency_clauses_land — the acceptance predicate is unchanged and must not green until all six capabilities establish."

test fn witness_structural_production_admissions_establish_clauses_a_through_d() -> Bool {
  let statuses: List<ReferenceDerivedClosureAdmission> = [
    observe_same_file_earlier_neighbour_visible(),
    observe_sibling_decision_branch_excluded(),
    observe_later_declaration_excluded(),
    observe_distinct_same_spelled_declarations_preserved(),
    ReferenceDerivedClosureUnavailable {
      capability: RepeatedMentionsCollapseDependency,
      trigger: P2aReferenceDependencyProjection7515,
    },
    ReferenceDerivedClosureUnavailable {
      capability: UnrelatedLoadedFileExcluded,
      trigger: P2aPoolIndependentDependencyProjection7515,
    },
  ]
  count(statuses) == 6
    && [
      SameFileEarlierNeighbourVisible,
      SiblingDecisionBranchExcluded,
      LaterDeclarationExcluded,
      DistinctSameSpelledDeclarationsPreserved,
    ] |> all(capability => statuses |> any(status => match status {
      ReferenceDerivedClosureEstablished { receipt } => receipt.capability == capability
      _ => false
    }))
    && statuses |> any(status => match status {
      ReferenceDerivedClosureUnavailable { capability, trigger } =>
        capability == RepeatedMentionsCollapseDependency
          && trigger == P2aReferenceDependencyProjection7515
      _ => false
    })
    && statuses |> any(status => match status {
      ReferenceDerivedClosureUnavailable { capability, trigger } =>
        capability == UnrelatedLoadedFileExcluded
          && trigger == P2aPoolIndependentDependencyProjection7515
      _ => false
    })
    && reference_derived_closure_closing_frontier_count(admissions: statuses) == 2
}

test fn witness_each_structural_production_observer_establishes_independently() -> Bool {
  match observe_same_file_earlier_neighbour_visible() {
    ReferenceDerivedClosureEstablished { receipt } =>
      receipt.capability == SameFileEarlierNeighbourVisible
    _ => false
  }
    && match observe_sibling_decision_branch_excluded() {
      ReferenceDerivedClosureEstablished { receipt } =>
        receipt.capability == SiblingDecisionBranchExcluded
      _ => false
    }
    && match observe_later_declaration_excluded() {
      ReferenceDerivedClosureEstablished { receipt } =>
        receipt.capability == LaterDeclarationExcluded
      _ => false
    }
    && match observe_distinct_same_spelled_declarations_preserved() {
      ReferenceDerivedClosureEstablished { receipt } =>
        receipt.capability == DistinctSameSpelledDeclarationsPreserved
      _ => false
    }
}

test fn witness_closing_contract_still_reds_until_dependency_clauses_land() -> Bool {
  reference_derived_closure_closing_frontier_count(
    admissions: [
      observe_same_file_earlier_neighbour_visible(),
      observe_sibling_decision_branch_excluded(),
      observe_later_declaration_excluded(),
      observe_distinct_same_spelled_declarations_preserved(),
      ReferenceDerivedClosureUnavailable {
        capability: RepeatedMentionsCollapseDependency,
        trigger: P2aReferenceDependencyProjection7515,
      },
      ReferenceDerivedClosureUnavailable {
        capability: UnrelatedLoadedFileExcluded,
        trigger: P2aPoolIndependentDependencyProjection7515,
      },
    ],
  ) == 2
}
