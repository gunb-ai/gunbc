module v1.tests.claim.namespace_reference_derived_closure_production_admissions_witness_test


data namespace_reference_derived_closure_production_admissions_witness_note: String = "N3-A production and assessment witnesses under src/v1/tests/claim — outside witness_layer_roots compile-clean entries, scheduled via v1_claim_scoped_witness_batch (dag plus src/v1 envelope). v1 production returns neutral ReferenceBindingObservation carriers; assess_reference_binding_observation projects capability admissions here. The namespace-structural-observations roadmap row stays ExecutionContractUnspecified until a semantic closing carrier lands (prior variant-presence predicate retracted 2026-08-04). Discriminating RED: witness_closing_contract_still_reds_until_dependency_clauses_land exercises the parent frontier count."

test fn witness_structural_production_returns_four_observations() -> Bool {
  count(namespace_structural_binding_observations_a_through_d()) == 4
}

test fn witness_structural_production_variants_match_clauses_a_through_d() -> Bool {
  let observations = namespace_structural_binding_observations_a_through_d()
  observations |> any(obs => match obs {
    SameFileNeighbourObservation { neighbour: _, resolution: _ } => true
    SameFileNeighbourProductionRefused { gap: _ } => true
    _ => false
  })
    && observations |> any(obs => match obs {
      SiblingBranchObservation {
        own_branch_declaration: _,
        sibling_branch_declaration: _,
        resolution: _,
      } => true
      SiblingBranchProductionRefused { gap: _ } => true
      _ => false
    })
    && observations |> any(obs => match obs {
      LaterDeclarationObservation { later_declaration: _, resolution: _ } => true
      LaterDeclarationProductionRefused { gap: _ } => true
      _ => false
    })
    && observations |> any(obs => match obs {
      DistinctHomonymObservation {
        first_declaration: _,
        second_declaration: _,
        resolution: _,
      } => true
      DistinctHomonymProductionRefused { gap: _ } => true
      _ => false
    })
}

test fn witness_structural_production_observations_establish_clauses_a_through_d() -> Bool {
  let admissions =
    namespace_structural_binding_observations_a_through_d()
      |> map(observation => assess_reference_binding_observation(observation: observation))
  count(admissions) == 4
    && [
      SameFileEarlierNeighbourVisible,
      SiblingDecisionBranchExcluded,
      LaterDeclarationExcluded,
      DistinctSameSpelledDeclarationsPreserved,
    ] |> all(capability => admissions |> any(status => match status {
      ReferenceDerivedClosureEstablished { receipt } => receipt.capability == capability
      _ => false
    }))
}

test fn witness_closing_contract_still_reds_until_dependency_clauses_land() -> Bool {
  let structural_admissions =
    namespace_structural_binding_observations_a_through_d()
      |> map(observation => assess_reference_binding_observation(observation: observation))
  gunbc.namespace_reference_derived_closure_contract.reference_derived_closure_closing_frontier_count(
    admissions: concat(
      structural_admissions,
      [
        gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
          capability: RepeatedMentionsCollapseDependency,
          trigger: P2aReferenceDependencyProjection7515,
        },
        gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
          capability: UnrelatedLoadedFileExcluded,
          trigger: P2aPoolIndependentDependencyProjection7515,
        },
      ],
    ),
  ) == 2
}
