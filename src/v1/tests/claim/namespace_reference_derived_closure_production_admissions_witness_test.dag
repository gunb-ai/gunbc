module v1.tests.claim.namespace_reference_derived_closure_production_admissions_witness_test

import gunbc.namespace_reference_derived_closure_admission {
  assess_reference_binding_observation,
  ReferenceDerivedClosureAdmission,
  ReferenceDerivedClosureEstablished,
  ReferenceDerivedClosureUnavailable,
  SameFileEarlierNeighbourVisible,
  SiblingDecisionBranchExcluded,
  LaterDeclarationExcluded,
  DistinctSameSpelledDeclarationsPreserved,
  RepeatedMentionsCollapseDependency,
  UnrelatedLoadedFileExcluded,
  P2aReferenceDependencyProjection7515,
  P2aPoolIndependentDependencyProjection7515,
}
import gunbc.namespace_reference_derived_closure_contract {
  reference_derived_closure_closing_frontier_count,
}
import std.reference_binding_observation {
  DistinctHomonymObservation,
  DistinctHomonymProductionRefused,
  LaterDeclarationObservation,
  LaterDeclarationProductionRefused,
  SameFileNeighbourObservation,
  SameFileNeighbourProductionRefused,
  SiblingBranchObservation,
  SiblingBranchProductionRefused,
}
import v1.gunbc.namespace_reference_derived_closure_production_observations {
  namespace_structural_binding_observations_a_through_d,
}
import v1.gunbc.namespace_reference_derived_closure_live_admissions {
  n3a_closing_receipt_holds,
  n3a_ordinary_compile_closing_receipt_holds,
  n3a_base_establishes_all_four,
  n3a_mutation_a_receipt,
  n3a_mutation_b_receipt,
  n3a_mutation_c_receipt,
  n3a_mutation_d_receipt,
}
import std.types { Bool, Int, List }

data namespace_reference_derived_closure_production_admissions_witness_note: String = "N3-A production and assessment witnesses under src/v1/tests/claim — outside witness_layer_roots compile-clean entries, scheduled via v1_claim_scoped_witness_batch (dag plus src/v1 envelope). v1 production returns neutral ReferenceBindingObservation carriers; assess_reference_binding_observation projects capability admissions here. The namespace-structural-observations roadmap row stays ExecutionContractUnspecified until a semantic closing carrier lands (prior variant-presence predicate retracted 2026-08-04). Discriminating RED: witness_closing_contract_still_reds_until_dependency_clauses_land exercises the parent frontier count. witness_n3a_mutation_* rows exercise the four discriminating mutations of the single ordinary-compiled specimen (namespace_reference_derived_closure_live_admissions) — each asserts its own clause breaks alone while the other three stay established."

test fn witness_structural_production_returns_four_observations() -> Bool {
  count(namespace_structural_binding_observations_a_through_d()) == 4
}

test fn witness_structural_production_variants_match_clauses_a_through_d() -> Bool {
  let observations = namespace_structural_binding_observations_a_through_d()
  observations |> any(obs => match obs {
    SameFileNeighbourObservation { neighbour: _, resolution: _ } => true
    SameFileNeighbourProductionRefused { gap: _ } => true
    _ => false
  })
    && observations |> any(obs => match obs {
      SiblingBranchObservation {
        own_branch_declaration: _,
        sibling_branch_declaration: _,
        resolution: _,
      } => true
      SiblingBranchProductionRefused { gap: _ } => true
      _ => false
    })
    && observations |> any(obs => match obs {
      LaterDeclarationObservation { later_declaration: _, resolution: _ } => true
      LaterDeclarationProductionRefused { gap: _ } => true
      _ => false
    })
    && observations |> any(obs => match obs {
      DistinctHomonymObservation {
        first_declaration: _,
        second_declaration: _,
        resolution: _,
      } => true
      DistinctHomonymProductionRefused { gap: _ } => true
      _ => false
    })
}

test fn witness_structural_production_observations_establish_clauses_a_through_d() -> Bool {
  let admissions =
    namespace_structural_binding_observations_a_through_d()
      |> map(observation => assess_reference_binding_observation(observation: observation))
  count(admissions) == 4
    && [
      SameFileEarlierNeighbourVisible,
      SiblingDecisionBranchExcluded,
      LaterDeclarationExcluded,
      DistinctSameSpelledDeclarationsPreserved,
    ] |> all(capability => admissions |> any(status => match status {
      ReferenceDerivedClosureEstablished { receipt } => receipt.capability == capability
      _ => false
    }))
}

test fn witness_n3a_base_specimen_establishes_all_four_clauses() -> Bool {
  n3a_base_establishes_all_four()
}

test fn witness_n3a_mutation_a_reds_same_file_neighbour_alone() -> Bool {
  n3a_mutation_a_receipt().target_reds_alone
}

test fn witness_n3a_mutation_b_reds_sibling_branch_alone() -> Bool {
  n3a_mutation_b_receipt().target_reds_alone
}

test fn witness_n3a_mutation_c_reds_later_declaration_alone() -> Bool {
  n3a_mutation_c_receipt().target_reds_alone
}

test fn witness_n3a_mutation_d_reds_distinct_homonym_alone() -> Bool {
  n3a_mutation_d_receipt().target_reds_alone
}

test fn witness_n3a_closing_receipt_holds() -> Bool {
  n3a_closing_receipt_holds()
}

test fn witness_n3a_ordinary_compile_closing_receipt_holds() -> Bool {
  n3a_ordinary_compile_closing_receipt_holds()
}

test fn witness_closing_contract_still_reds_until_dependency_clauses_land() -> Bool {
  let structural_admissions =
    namespace_structural_binding_observations_a_through_d()
      |> map(observation => assess_reference_binding_observation(observation: observation))
  reference_derived_closure_closing_frontier_count(
    admissions: concat(
      structural_admissions,
      [
        ReferenceDerivedClosureUnavailable {
          capability: RepeatedMentionsCollapseDependency,
          trigger: P2aReferenceDependencyProjection7515,
        },
        ReferenceDerivedClosureUnavailable {
          capability: UnrelatedLoadedFileExcluded,
          trigger: P2aPoolIndependentDependencyProjection7515,
        },
      ],
    ),
  ) == 2
}
