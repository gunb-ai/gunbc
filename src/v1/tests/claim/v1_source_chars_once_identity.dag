module v1.tests.claim.v1_source_chars_once_identity

// ROADMAP NODE v1-source-chars-converted-once -- the EXECUTED differential (semantics
// preserved) and the red/green pivot for this node.
//
// WHAT PROVES WHAT:
//  * The "one source->chars conversion per ingested file" property is carried by the TYPE
//    CHANGE plus the reviewed call sites, not by any test. `newline_index_from_char_codes`
//    takes `char_codes: List<Int>` -- already-converted codes -- so a correct ingest site can
//    only supply the tokenizer's single conversion. The two ingest sites,
//    v1.compile::front_end_sources and v1.compile::parse_revision_declarations_with_environment,
//    both pass char_codes: artifact.source_chars. The build_newline_index wrapper is retained
//    only for non-ingest callers; the ingest file no longer imports or calls it.
//  * This module EXECUTES the real constructors and compares their outputs -- the executed
//    evidence that the change is semantics-preserving. It does not, and cannot, count chars()
//    calls at run time: build_newline_index(file, source) and
//    newline_index_from_char_codes(file, chars(source)) are intentionally output-identical (that
//    is the semantics-preservation requirement), so no output property distinguishes which path
//    ran. That is exactly why the "once" property is a type/diff property, not a behavioural one,
//    and why a source-text grep would add no consumer here (gunbc.design_argument::fail_closed).
//
// RED/GREEN: this claim is the pivot. On main it cannot be satisfied -- the
// newline_index_from_char_codes constructor it consumes does not exist, so the ingest cannot yet
// take the tokenizer's characters. At the post-change head it resolves and passes: for each
// corpus file the index the NEW ingest builds (from V1LexArtifact.source_chars via
// newline_index_from_char_codes) is IDENTICAL to the index the OLD path built (its own
// chars(source) via build_newline_index) -- same file, same newline offsets -- and the character
// list the ingest feeds the index equals the raw chars(source) the old path converted, on small
// newline-shaped inputs. Token emission is byte-for-byte unchanged by the change (the artifact
// only gained a source_chars field), so the token stream is identical before/after by
// construction; this module is the executed newline-index / consumed-characters differential.
//
// (1) newline_index_identical_before_and_after_on_corpus -- per corpus file, same file + same
//     newline offsets (the index payload; sparse, so cheap). Full char_codes equality would be
//     O(n^2) in the interpreter on real sources, so char_codes equality is checked on small
//     inputs in (2); its general correctness also follows from v1.compiler.tokenize storing
//     source_chars: c where c = chars(source).
// (2) tokenizer_chars_equal_raw_source_chars_on_corpus -- artifact.source_chars equals raw
//     chars(source) on small, newline-shaped inputs (element-wise list equality is trivial cost).

import extdeps.filesystem.filesystem_io
import extdeps.languages.dag.syntax { dag_parse_environment }
import std.types { String, List, Int, Bool }
import v1.std.core { build_newline_index, newline_index_from_char_codes, NewlineIndex }
import v1.compiler.tokenize { tokenize_artifact }

fn read_source(path: String) -> String {
  (filesystem_read(path: path)).content
}

// What the ingest builds NOW: the newline index from the tokenizer's converted characters.
fn ingest_newline_index(path: String, source: String) -> NewlineIndex {
  let artifact = tokenize_artifact(source: source, file: path, env: dag_parse_environment)
  newline_index_from_char_codes(file: path, char_codes: artifact.source_chars)
}

// What the ingest built BEFORE: its own conversion of the raw source.
fn prechange_newline_index(path: String, source: String) -> NewlineIndex {
  build_newline_index(file: path, source: source)
}

// The newline index's payload equality: same file, same newline offsets.
fn index_offsets_equal(a: NewlineIndex, b: NewlineIndex) -> Bool {
  a.file == b.file && a.offsets == b.offsets
}

fn file_index_identical(path: String) -> Bool {
  let source = read_source(path)
  index_offsets_equal(ingest_newline_index(path, source), prechange_newline_index(path, source))
}

// Real ingest-corpus files (the compiler's own sources). Unrolled with && (the claim scope
// has no fold/all). Sizes are bounded: the two multi-thousand-line files are excluded purely
// to keep interpreter tokenization cheap; index equality is size-independent.
test fn newline_index_identical_before_and_after_on_corpus() -> Bool {
  file_index_identical("src/v1/01_tokenize.dag") &&
  file_index_identical("src/v1/03_resolve.dag") &&
  file_index_identical("src/v1/compile.dag") &&
  file_index_identical("dag/test/claim/v1_source_audit_witness.dag")
}

// For a newline-shaped source, the character list the ingest feeds the index (from the
// tokenizer) is exactly the raw chars(source) the old path converted itself.
fn char_codes_consumed_unchanged(file: String, source: String) -> Bool {
  ingest_newline_index(file, source).char_codes == prechange_newline_index(file, source).char_codes
}

// Small, edge-shaped sources so the element-wise char_codes equality is trivial cost while
// still exercising leading/trailing/consecutive newlines and a non-ASCII code point.
test fn tokenizer_chars_equal_raw_source_chars_on_corpus() -> Bool {
  char_codes_consumed_unchanged("a.dag", "") &&
  char_codes_consumed_unchanged("b.dag", "no newline") &&
  char_codes_consumed_unchanged("c.dag", "line one\nline two\n\nlast\n") &&
  char_codes_consumed_unchanged("d.dag", "\n\n\n") &&
  char_codes_consumed_unchanged("e.dag", "x\ntab\there\nend") &&
  char_codes_consumed_unchanged("f.dag", "héllo\nwörld\n")
}
