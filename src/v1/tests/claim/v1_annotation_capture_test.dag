module v1.tests.claim.v1_annotation_capture_test

import std.source_annotation { LeadingAfterLineIndent, TrailingAfterSemanticToken }
import v1.compiler.tokenize { tokenize, tokenize_artifact }

data v1_annotation_capture_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/v1_annotation_capture_test.dag --functions w_two_captures_preserved_in_source_order,w_captures_excluded_from_token_stream,w_eof_annotation_is_captured,w_leading_and_trailing_placements_differ,w_slash_slash_inside_string_is_not_an_annotation,w_annotation_free_source_captures_none"

data v1_annotation_capture_note: String = "The v1 SEED realization of the annotation channel, proven independently of v2. These execute against the .dag tokenizer source through the current stage0 binary, so they are pre-regen evidence: they establish that tokenize_artifact captures and that tokenize projects the captures away, BEFORE the long regen/rebuild cycle makes // live in real .dag source. The two realizations are tested separately on purpose — one shared test would pass if either alone were correct.

TOKEN EXCLUSION IS ASSERTED BY COUNT AGAINST A CLEAN CONTROL, not by scanning token text for the comment's words. A text scan would pass if the capture leaked in under a different spelling; comparing the annotated stream to the same source with the comment removed fails on any leak at all, including one that preserves no recognizable substring."

data src_two_comments: String = "// first\nfn a() -> Int { 1 }\n// second\n"
data src_two_comments_removed: String = "\nfn a() -> Int { 1 }\n\n"
data src_leading: String = "// note\nfn a() -> Int { 1 }\n"
data src_trailing: String = "fn a() -> Int { 1 } // note\n"
data src_clean: String = "fn a() -> Int { 1 }\n"
data src_eof_comment: String = "fn a() -> Int { 1 }\n// at eof"
data src_url_in_string: String = "data u: String = \"http://example.com\"\n"

fn captures(source: String) -> List<UnboundAnnotationCapture> {
  tokenize_artifact(source: source, file: "probe.dag").annotations
}

fn token_count(source: String) -> Int {
  count(tokenize(source: source, file: "probe.dag"))
}

test fn w_two_captures_preserved_in_source_order() -> Bool {
  let caps = captures(source: src_two_comments)
  count(caps) == 2 && caps[0].value.lexeme == "// first" && caps[1].value.lexeme == "// second"
}

test fn w_captures_excluded_from_token_stream() -> Bool {
  token_count(source: src_two_comments) == token_count(source: src_two_comments_removed)
}

test fn w_eof_annotation_is_captured() -> Bool {
  count(captures(source: src_eof_comment)) == 1
}

test fn w_leading_and_trailing_placements_differ() -> Bool {
  let leading = captures(source: src_leading)
  let trailing = captures(source: src_trailing)
  count(leading) == 1 && count(trailing) == 1 &&
    leading[0].value.placement == LeadingAfterLineIndent &&
    trailing[0].value.placement == TrailingAfterSemanticToken
}

test fn w_slash_slash_inside_string_is_not_an_annotation() -> Bool {
  count(captures(source: src_url_in_string)) == 0
}

test fn w_annotation_free_source_captures_none() -> Bool {
  count(captures(source: src_clean)) == 0
}
