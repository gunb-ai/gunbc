module v1.tests.claim.reference_derived_authored_source_gate_witness_test

import v1.compiler.emit_rust {
  reference_derived_candidate_spelled_in_module,
}

data reference_derived_authored_source_gate_witness_note: String = "Discriminating controls for reference_derived_candidate_spelled_in_module (the authored-source gate inside reference_derived_use_lines). GREEN: a name spelled in module source is admitted. RED: AuthoredTokenOrdinal-shaped over-collection against an http_path-like source that never mentions it is refused — the exact fabrication that previously emitted pub use crate::std_occurrence_binding_candidates::AuthoredTokenOrdinal from std.http_path with no .dag authority."

test fn authored_spelling_admits_candidate_holds() -> Bool {
  reference_derived_candidate_spelled_in_module(
    module_source: "type UrlPathToken = Segment | Slash\nfn join_path(parts: List<String>) -> String { parts }",
    name: "UrlPathToken",
  )
}

test fn unspelled_authored_token_ordinal_refused_holds() -> Bool {
  !reference_derived_candidate_spelled_in_module(
    module_source: "type UrlPathToken = Segment | Slash\nfn join_path(parts: List<String>) -> String { parts }",
    name: "AuthoredTokenOrdinal",
  )
}

test fn empty_module_source_admits_all_holds() -> Bool {
  reference_derived_candidate_spelled_in_module(
    module_source: "",
    name: "AuthoredTokenOrdinal",
  )
}
