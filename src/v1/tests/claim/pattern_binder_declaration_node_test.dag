module v1.tests.claim.pattern_binder_declaration_node_test

import v1.std.core {
  Node,
  NewlineIndex,
  SourceSpan,
  MatchPattern,
  Bind,
  LitPattern,
  VariantPattern,
  Wildcard,
  OccurrenceTransportViolation,
  NoExprData,
  field_binding_pattern,
  build_newline_index,
  empty_intern_table,
  intern_table_with_authored_token_ordinals,
  merge_intern_tables,
}
import v1.compiler.tokenize { tokenize }
import v1.compiler.parse {
  ParseContext,
  token_stream_new,
  parse_pattern,
  parse_with_table,
}
import v1.compiler.compile {
  resolve_frontend_occurrence_transport,
}
import std.occurrence_identity {
  OccurrenceId,
  OccurrenceProjection,
  OccurrenceContainmentPath,
  OccurrenceIndexEntry,
  OccurrenceIndex,
  OccurrenceTransport,
  DeclarationOccurrence,
  ReferenceOccurrence,
  LexicalValueOccurrence,
  CallableOccurrence,
  MissingAuthoredOccurrenceIdentity,
  DuplicateAuthoredOccurrenceIdentity,
  InconsistentOccurrenceContainment,
  WrongOccurrenceCategory,
  authored_token_ordinal_space_from_allocator,
  OccurrenceIdAllocator,
}

data pattern_binder_declaration_node_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/pattern_binder_declaration_node_test.dag --functions w_pattern_parser_materializes_dedicated_declaration_nodes,w_shorthand_wrapper_and_declaration_roles_remain_distinct,w_sequential_parse_uses_disjoint_authored_token_ordinal_ranges,w_parse_error_preserves_authored_token_ordinal_space,w_production_frontend_accepts_valid_occurrence_transport,w_production_frontend_refuses_missing_occurrence_identity,w_production_frontend_refuses_duplicate_occurrence_identity,w_production_frontend_refuses_wrong_occurrence_category,w_production_frontend_refuses_index_terminal_mismatch,w_production_frontend_refuses_ancestor_path_mismatch"

data pattern_binder_declaration_node_dissolve_on: String = "DISSOLVE-ON: move this claim into normal discovery when v1 compiler claims are admitted under the regular witness source-root and cost budget."

type ParsedFixturePattern
  = ParsedFixturePatternReady { pattern: MatchPattern }
  | ParsedFixturePatternRefused

fn parse_fixture_pattern(source: String) -> ParsedFixturePattern {
  let file = "pattern-binder-declaration-node.dag"
  let index = build_newline_index(file: file, source: source)
  let result = parse_pattern(
    tokens: token_stream_new(all: tokenize(source: source, file: file)),
    ctx: ParseContext {
      source_indices: map_insert(empty_map(), file, index),
      intern_table: empty_intern_table(),
    },
  )
  match result.err {
    Present { value: _ } => ParsedFixturePatternRefused
    Absent => ParsedFixturePatternReady { pattern: result.pattern }
  }
}

fn pattern_binder_named_count(
  pattern: MatchPattern,
  name: String
) -> Int {
  match pattern {
    Bind { declaration: declaration } =>
      if declaration.name == name { 1 } else { 0 }
    LitPattern { value: _ } => 0
    Wildcard => 0
    VariantPattern {
      name: _,
      parent_enum: _,
      field_bindings: bindings,
    } =>
      fold(
        bindings,
        init: 0,
        f: (count, binding) =>
          count + pattern_binder_named_count(
            pattern: field_binding_pattern(n: binding),
            name: name,
          ),
      )
  }
}

fn parsed_pattern_has_one_binder(
  source: String,
  name: String
) -> Bool {
  match parse_fixture_pattern(source: source) {
    ParsedFixturePatternRefused => false
    ParsedFixturePatternReady { pattern: pattern } =>
      pattern_binder_named_count(pattern: pattern, name: name) == 1
  }
}

fn transport_fixture_span() -> std.types.SourceSpan {
  std.types.SourceSpan {
    file: "occurrence-transport-production.dag",
    start: 7,
    end: 8,
  }
}

fn transport_fixture_path(
  occurrence: OccurrenceId
) -> OccurrenceContainmentPath {
  OccurrenceContainmentPath {
    ancestors: [],
    terminal: occurrence,
  }
}

fn transport_fixture_index_entry(
  occurrence: OccurrenceId
) -> OccurrenceIndexEntry {
  OccurrenceIndexEntry {
    projection: OccurrenceProjection {
      occurrence: occurrence,
      authored_name: "same",
      diagnostic_span: transport_fixture_span(),
    },
    containment: transport_fixture_path(occurrence: occurrence),
  }
}

fn transport_fixture_declaration(
  occurrence: OccurrenceId
) -> DeclarationOccurrence {
  DeclarationOccurrence {
    occurrence: occurrence,
    containment: transport_fixture_path(occurrence: occurrence),
    category: LexicalValueOccurrence,
    diagnostic_span: transport_fixture_span(),
  }
}

fn transport_fixture_reference(
  occurrence: OccurrenceId
) -> ReferenceOccurrence {
  ReferenceOccurrence {
    occurrence: occurrence,
    containment: transport_fixture_path(occurrence: occurrence),
    category: CallableOccurrence,
    diagnostic_span: transport_fixture_span(),
  }
}

test fn w_pattern_parser_materializes_dedicated_declaration_nodes() -> Bool {
  parsed_pattern_has_one_binder(
    source: "direct_bind",
    name: "direct_bind",
  ) &&
  parsed_pattern_has_one_binder(
    source: "Pair { left: explicit_bind }",
    name: "explicit_bind",
  ) &&
  parsed_pattern_has_one_binder(
    source: "Shorthand { shorthand_only }",
    name: "shorthand_only",
  ) &&
  parsed_pattern_has_one_binder(
    source: "Left(positional_bind)",
    name: "positional_bind",
  ) &&
  parsed_pattern_has_one_binder(
    source: "Outer { pair: Pair { left: nested_bind } }",
    name: "nested_bind",
  )
}

test fn w_shorthand_wrapper_and_declaration_roles_remain_distinct() -> Bool {
  match parse_fixture_pattern(source: "Shorthand { shorthand_only }") {
    ParsedFixturePatternRefused => false
    ParsedFixturePatternReady { pattern: pattern } =>
      match pattern {
        VariantPattern {
          name: _,
          parent_enum: _,
          field_bindings: bindings,
        } =>
          (bindings |> count) == 1 &&
          fold(
            bindings,
            init: true,
            f: (ok, wrapper) =>
              ok &&
              wrapper.name == "shorthand_only" &&
              match field_binding_pattern(n: wrapper) {
                Bind { declaration: declaration } =>
                  declaration.name == "shorthand_only" &&
                  match declaration.expr_data {
                    NoExprData =>
                      match declaration.match_pattern {
                        Present { value: _ } => false
                        Absent => true
                      }
                    _ => false
                  }
                _ => false
              },
          )
        _ => false
      }
  }
}

test fn w_sequential_parse_uses_disjoint_authored_token_ordinal_ranges() -> Bool {
  let first_file = "occurrence-sequential-first.dag"
  let first_source = "module occurrence.sequential_first\n\nfn same(x: Int) -> Int { x }\n"
  let first = parse_with_table(
    tokens: tokenize(source: first_source, file: first_file),
    source_indices: map_insert(
      empty_map(),
      first_file,
      build_newline_index(file: first_file, source: first_source)
    ),
    intern_table: empty_intern_table()
  )
  let second_file = "occurrence-sequential-second.dag"
  let second_source = "module occurrence.sequential_second\n\nfn same(x: Int) -> Int { x }\n"
  let second = parse_with_table(
    tokens: tokenize(source: second_source, file: second_file),
    source_indices: map_insert(
      empty_map(),
      second_file,
      build_newline_index(file: second_file, source: second_source)
    ),
    intern_table: first.intern_table
  )
  let disjoint = fold(
    first.occurrence_transport.index.entries,
    init: true,
    f: (outer_ok, left) =>
      outer_ok &&
      fold(
        second.occurrence_transport.index.entries,
        init: true,
        f: (inner_ok, right) =>
          inner_ok &&
          left.projection.occurrence.value != right.projection.occurrence.value
      )
  )
  let second_range_follows_first = fold(
    second.occurrence_transport.index.entries,
    init: true,
    f: (ok, entry) =>
      ok &&
      entry.projection.occurrence.value >= first.occurrence_allocator.next_id
  )
  let merged = merge_intern_tables(
    tables: [first.intern_table, second.intern_table]
  )
  first.result.error == none &&
  second.result.error == none &&
  (first.occurrence_transport.index.entries |> count) > 0 &&
  (second.occurrence_transport.index.entries |> count) > 0 &&
  disjoint &&
  second_range_follows_first &&
  first.intern_table.authored_token_ordinals.allocator.next_id ==
    first.occurrence_allocator.next_id &&
  second.intern_table.authored_token_ordinals.allocator.next_id ==
    second.occurrence_allocator.next_id &&
  merged.authored_token_ordinals.allocator.next_id ==
    second.occurrence_allocator.next_id &&
  second.occurrence_allocator.next_id > first.occurrence_allocator.next_id
}

test fn w_parse_error_preserves_authored_token_ordinal_space() -> Bool {
  let file = "occurrence-error-space.dag"
  let source = "module"
  let seeded = intern_table_with_authored_token_ordinals(
    table: empty_intern_table(),
    authored_token_ordinals: authored_token_ordinal_space_from_allocator(
      alloc: OccurrenceIdAllocator { next_id: 41 }
    )
  )
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: file),
    source_indices: map_insert(
      empty_map(),
      file,
      build_newline_index(file: file, source: source)
    ),
    intern_table: seeded
  )
  parsed.result.error != none &&
  parsed.occurrence_allocator.next_id >= 41 &&
  parsed.intern_table.authored_token_ordinals.allocator.next_id ==
    parsed.occurrence_allocator.next_id
}

test fn w_production_frontend_accepts_valid_occurrence_transport() -> Bool {
  let result = resolve_frontend_occurrence_transport(
    module_inputs: [],
    source_indices: empty_map(),
    occurrence_transport: OccurrenceTransport {
      index: OccurrenceIndex { entries: [] },
      declarations: [],
      references: [],
    }
  )
  result.graph != none &&
  (result.diagnostics |> count) == 0
}

test fn w_production_frontend_refuses_missing_occurrence_identity() -> Bool {
  let occurrence = OccurrenceId { value: 17 }
  let result = resolve_frontend_occurrence_transport(
    module_inputs: [],
    source_indices: empty_map(),
    occurrence_transport: OccurrenceTransport {
      index: OccurrenceIndex { entries: [] },
      declarations: [
        transport_fixture_declaration(occurrence: occurrence)
      ],
      references: [],
    }
  )
  result.graph == none &&
  match result.diagnostics |> first {
    Present { value: error } =>
      match error.diagnostic {
        OccurrenceTransportViolation {
          refusal: MissingAuthoredOccurrenceIdentity {
            diagnostic_span: span,
          },
        } => span == transport_fixture_span()
        _ => false
      }
    Absent => false
  }
}

test fn w_production_frontend_refuses_duplicate_occurrence_identity() -> Bool {
  let occurrence = OccurrenceId { value: 23 }
  let entry = transport_fixture_index_entry(occurrence: occurrence)
  let result = resolve_frontend_occurrence_transport(
    module_inputs: [],
    source_indices: empty_map(),
    occurrence_transport: OccurrenceTransport {
      index: OccurrenceIndex { entries: [entry, entry] },
      declarations: [
        transport_fixture_declaration(occurrence: occurrence)
      ],
      references: [],
    }
  )
  result.graph == none &&
  match result.diagnostics |> first {
    Present { value: error } =>
      match error.diagnostic {
        OccurrenceTransportViolation {
          refusal: DuplicateAuthoredOccurrenceIdentity {
            occurrence: observed,
            diagnostic_span: span,
          },
        } =>
          observed.value == occurrence.value &&
          span == transport_fixture_span()
        _ => false
      }
    Absent => false
  }
}

test fn w_production_frontend_refuses_wrong_occurrence_category() -> Bool {
  let occurrence = OccurrenceId { value: 29 }
  let result = resolve_frontend_occurrence_transport(
    module_inputs: [],
    source_indices: empty_map(),
    occurrence_transport: OccurrenceTransport {
      index: OccurrenceIndex {
        entries: [
          transport_fixture_index_entry(occurrence: occurrence)
        ],
      },
      declarations: [
        transport_fixture_declaration(occurrence: occurrence)
      ],
      references: [
        transport_fixture_reference(occurrence: occurrence)
      ],
    }
  )
  result.graph == none &&
  match result.diagnostics |> first {
    Present { value: error } =>
      match error.diagnostic {
        OccurrenceTransportViolation {
          refusal: WrongOccurrenceCategory {
            occurrence: observed,
            expected: LexicalValueOccurrence,
            observed: CallableOccurrence,
            diagnostic_span: span,
          },
        } =>
          observed.value == occurrence.value &&
          span == transport_fixture_span()
        _ => false
      }
    Absent => false
  }
}

test fn w_production_frontend_refuses_index_terminal_mismatch() -> Bool {
  let occurrence = OccurrenceId { value: 31 }
  let mismatched_terminal = OccurrenceId { value: 32 }
  let entry = transport_fixture_index_entry(occurrence: occurrence)
  let result = resolve_frontend_occurrence_transport(
    module_inputs: [],
    source_indices: empty_map(),
    occurrence_transport: OccurrenceTransport {
      index: OccurrenceIndex {
        entries: [
          OccurrenceIndexEntry {
            projection: entry.projection,
            containment: transport_fixture_path(
              occurrence: mismatched_terminal
            ),
          }
        ],
      },
      declarations: [],
      references: [],
    }
  )
  result.graph == none &&
  match result.diagnostics |> first {
    Present { value: error } =>
      match error.diagnostic {
        OccurrenceTransportViolation {
          refusal: InconsistentOccurrenceContainment {
            occurrence: observed,
            diagnostic_span: span,
          },
        } =>
          observed.value == occurrence.value &&
          span == transport_fixture_span()
        _ => false
      }
    Absent => false
  }
}

test fn w_production_frontend_refuses_ancestor_path_mismatch() -> Bool {
  let occurrence = OccurrenceId { value: 33 }
  let ancestor = OccurrenceId { value: 34 }
  let declaration = transport_fixture_declaration(occurrence: occurrence)
  let result = resolve_frontend_occurrence_transport(
    module_inputs: [],
    source_indices: empty_map(),
    occurrence_transport: OccurrenceTransport {
      index: OccurrenceIndex {
        entries: [
          transport_fixture_index_entry(occurrence: occurrence)
        ],
      },
      declarations: [
        DeclarationOccurrence {
          occurrence: declaration.occurrence,
          containment: OccurrenceContainmentPath {
            ancestors: [ancestor],
            terminal: occurrence,
          },
          category: declaration.category,
          diagnostic_span: declaration.diagnostic_span,
        }
      ],
      references: [],
    }
  )
  result.graph == none &&
  match result.diagnostics |> first {
    Present { value: error } =>
      match error.diagnostic {
        OccurrenceTransportViolation {
          refusal: InconsistentOccurrenceContainment {
            occurrence: observed,
            diagnostic_span: span,
          },
        } =>
          observed.value == occurrence.value &&
          span == transport_fixture_span()
        _ => false
      }
    Absent => false
  }
}
