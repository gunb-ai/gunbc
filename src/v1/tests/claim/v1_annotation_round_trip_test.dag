module v1.tests.claim.v1_annotation_round_trip_test

import std.types { Bool, Int, String, List }
import std.occurrence_identity { OccurrenceId, OccurrenceIndexEntry, OccurrenceTransport }
import std.source_annotation {
  KeyedAnnotationRow,
  SourceAnnotationGraph,
  annotation_attachment_result_graph,
  keyed_annotation_rows_agree,
  source_annotation_graph_rows
}
import v1.compiler.annotation_bind {
  AdmittedSourceAnnotations,
  bind_annotations,
  admit_source_annotations,
  keyed_annotation_rows,
  render_annotation_block,
  render_line_comment_delimiter,
  render_subject_annotation_blocks,
  subject_annotation_blocks_for
}
import v1.compiler.tokenize { V1LexArtifact, tokenize_artifact }
import v1.compiler.parse { ParseWithTableResult, parse_with_table }
import v1.std.core { build_newline_index, empty_intern_table, NewlineIndex }

data v1_annotation_round_trip_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/v1_annotation_round_trip_test.dag --functions w_two_blocks_survive_the_round_trip,w_a_renderer_without_the_blank_line_merges_them,w_one_block_spanning_two_lines_stays_one_block,w_identical_text_twice_stays_twice,w_authored_indentation_survives,w_an_empty_annotation_line_survives,w_a_source_with_no_prose_is_not_evidence,w_a_refused_source_is_not_evidence,w_the_two_declarations_share_an_occurrence_ordinal,w_same_text_same_position_different_declaration_disagrees,w_each_declaration_keeps_its_own_prose,w_a_parse_error_is_not_evidence,w_a_duplicated_authored_name_refuses_as_subject,w_mixed_subject_rows_cannot_reach_the_renderer"

data v1_annotation_round_trip_note: String = "D-C property 7: parse, render, parse — the graph survives. What agreement means is single-authored in std.source_annotation as keyed_annotation_rows_agree, so this file exercises the property rather than restating it.

AGREEMENT IS KEYED ON THE AUTHORED NAME, NOT ON THE OCCURRENCE ID, and that is a correctness fix rather than a convenience. The two graphs come from two parses with two allocators, so equal id values would mean equal allocation ORDINALS — identical prose above `data alpha` in one source and above `data beta` in another of the same shape would compare equal. There is a discriminating arm below for exactly that, because a false-positive oracle is the failure this file would otherwise be unable to see in itself.

EVERY GRAPH COMES THROUGH THE PRODUCTION ADMISSION SEAM. An earlier cut read the graph straight off the attachment result, which is the bypass the authority itself warns about: that accessor returns the attached rows even when others were refused, so a renderer that introduced an unattachable annotation could drop it and the surviving subset could still satisfy the comparison. admit_source_annotations is what both v1 frontend paths use, and requiring it on BOTH the original and the rendered source is what makes a dropped annotation fail the property instead of shrinking both sides of it.

THE PROPERTY IS OVER THE ANNOTATION CHANNEL, with the declaration text held fixed to isolate it. Property 4 already proved that annotations do not perturb the semantic projection or the emitted bytes; what this proves is that the prose itself makes the trip. See the scope note in the module authority for why no production authored-source renderer is wired: there is none in the tree to wire."

data single_parse_note: String = "ONE ARTIFACT AND ONE PARSE PER SOURCE VALUE, carried in a record so every consumer reads the same one, and THREADED rather than re-derived. Tokenizing the same source twice — once for the parser and once for the captures — is two runs of a fold that is supposed to produce one artifact, and it would mask a defect in which the two halves disagree.

Two cuts of this file got that wrong in two different ways, both caught by review, and the second is the reason the helpers below take a AnnotationParsedSource instead of a String. The FIRST cut had separate admitted_of and transport_of helpers, so the keyed projection paired a graph from one parse with an occurrence index from another — the keying resolves a subject id through the index, so ids were being resolved against a foreign table. The SECOND cut fixed the static call sites and still parsed the same source three times DYNAMICALLY: once for the `before` rows, once inside the renderer, once for the rendered result. One static call site is not one parse per execution, and a witness that states a one-pass invariant while re-deriving its own inputs is asserting something it does not do.

The rule the shape now enforces: a AnnotationParsedSource is produced once per distinct SOURCE TEXT and passed down. The round trip parses exactly twice by construction — the authored source, and the rendered source — because those are two different texts, which is the property."

type AnnotationParsedSource {
  artifact: V1LexArtifact
  parse: ParseWithTableResult
  admitted: AdmittedSourceAnnotations
}

fn annotation_parsed_of(source: String) -> AnnotationParsedSource {
  let artifact = tokenize_artifact(source: source, file: "rt.dag")
  let parse = parse_with_table(
    tokens: artifact.tokens,
    source_indices: map_insert(empty_map(), "rt.dag", build_newline_index(file: "rt.dag", source: source)),
    intern_table: empty_intern_table(),
  )
  AnnotationParsedSource {
    artifact: artifact,
    parse: parse,
    admitted: admit_source_annotations(
      transport: parse.occurrence_transport,
      captures: artifact.annotations,
      source_length: string_length(s: source)
    )
  }
}

data parse_health_note: String = "THE SEMANTIC PARSE MUST SUCCEED FOR THE ANNOTATION RESULT TO MEAN ANYTHING, and an earlier cut of this file discarded the fact that would have said so — it kept only the occurrence transport and asked the annotation diagnostics whether the source was good. Annotations are captured on a lexical channel, so the parser can report an error and STILL have produced the occurrences the annotation attachment binds to.

The false green that permits, in principle: a source whose valid prefix carries prose and a declaration and whose trailing syntax is malformed. Admission succeeds on the prefix, the renderer reproduces only the annotated subject and drops the malformed tail, the rendered source parses clean, and the rows agree — so `parse, render, parse` reports that the graph survived a trip whose second leg silently repaired the input. There is a control arm for exactly this below.

Evidence therefore requires the parse to be CLEAN — no error node AND a module produced — as well as admitted and nonempty. `error: Absent` alone is not the check: a result with neither error nor module is not a parse that succeeded."

fn annotation_parse_is_clean(parsed: AnnotationParsedSource) -> Bool {
  match parsed.parse.result.error {
    Present { value: _ } => false
    Absent =>
      match parsed.parse.result.module {
        Present { value: _ } => true
        Absent => false
      }
  }
}

data admitted_rows_note: String = "The keyed projection of a CLEANLY PARSED, ADMITTED graph, or Absent. Several distinct failures collapse to Absent here — the parse errored, the parse produced no module, the annotations were refused, or a subject would not resolve to a name — and every one of them must make a property arm fail rather than compare an empty list against an empty list, which is why the evidence predicate below requires nonemptiness explicitly."

fn keyed_rows_of(parsed: AnnotationParsedSource) -> List<KeyedAnnotationRow>? {
  if !annotation_parse_is_clean(parsed: parsed) {
    none
  } else if (parsed.admitted.diagnostics |> count) > 0 {
    none
  } else {
    keyed_annotation_rows(transport: parsed.parse.occurrence_transport, graph: parsed.admitted.graph)
  }
}

fn admitted_keyed_rows(source: String) -> List<KeyedAnnotationRow>? {
  keyed_rows_of(parsed: annotation_parsed_of(source: source))
}

fn admitted_row_count(source: String) -> Int {
  match admitted_keyed_rows(source: source) {
    Absent => 0 - 1
    Present { value: rows } => rows |> count
  }
}

data declaration_text: String = "data alpha: String = \"a\"\n"

data rendered_source_note: String = "Rebuilds a source from the CANONICAL rendering of an admitted graph, through subject_annotation_blocks_for and the production renderer rather than assembling annotation lines locally, so a defect in either reaches these claims. A source whose graph is refused, empty, or unresolvable renders as a marker that parses to no annotations, so the failure surfaces as a disagreement rather than as an accidentally-matching empty pair."

fn rendered_source_for_parsed(parsed: AnnotationParsedSource, subject_name: String, decl: String) -> String {
  match subject_named_in(parsed: parsed, name: subject_name) {
    Absent => "module rt\n\n"
    Present { value: subject } =>
      match subject_annotation_blocks_for(graph: parsed.admitted.graph, subject: subject) {
        Absent => "module rt\n\n"
        Present { value: blocks } =>
          concat(
            "module rt\n\n",
            concat(render_subject_annotation_blocks(blocks: blocks), concat("\n", decl))
          )
      }
  }
}

fn rendered_source_for(source: String, subject_name: String, decl: String) -> String {
  rendered_source_for_parsed(parsed: annotation_parsed_of(source: source), subject_name: subject_name, decl: decl)
}

data authored_name_uniqueness_note: String = "THE AUTHORED-NAME KEY IS SOUND ONLY WHERE THE NAME IS UNIQUE, so a second match REFUSES rather than resolving. An earlier cut folded to the last match and returned it, which is the quiet half of the same false-agreement direction the keying exists to close: with two module items sharing a name, `the subject called alpha` is not a question with an answer, and answering it anyway picks one by traversal order and calls the other one's prose the same subject's.

Zero matches and two matches are both Absent here because both mean `this name does not identify a subject`. They are distinguishable at the call site if a future arm needs to tell them apart; what must never happen is a confident wrong id."

fn subjects_named_in(parsed: AnnotationParsedSource, name: String) -> List<OccurrenceId> {
  fold(
    parsed.parse.occurrence_transport.index.entries,
    init: [],
    f: (acc, entry) =>
      if entry.projection.authored_name == name { list_push(acc, entry.projection.occurrence) } else { acc }
  )
}

fn subject_named_in(parsed: AnnotationParsedSource, name: String) -> OccurrenceId? {
  let matches = subjects_named_in(parsed: parsed, name: name)
  if (matches |> count) == 1 {
    fold(matches, init: none, f: (acc, id) => Present { value: id })
  } else {
    none
  }
}

fn subject_named(source: String, name: String) -> OccurrenceId? {
  subject_named_in(parsed: annotation_parsed_of(source: source), name: name)
}

data evidence_predicate_note: String = "ONE predicate for `this arm is evidence`, so no arm can pass on an empty comparison. It requires the authored source to parse CLEAN and be admitted with a NONEMPTY keyed projection, the rendered source to parse clean and be admitted too, and the two to agree. Agreement alone is satisfied by empty-against-empty, which is precisely how a round-trip witness greens while exercising nothing.

It takes an already-parsed `before` and the declaration to render beneath, rather than a source string and a fixed declaration. The parsed argument is what carries the one-parse rule (see single_parse_note); the declaration argument is what keeps the two-declaration arm honest, because rendering beta's prose above `data alpha` proves only that beta's TEXT was selected, never that it stayed attached to beta."

fn round_trip_is_evidence_for(before: AnnotationParsedSource, subject_name: String, decl: String) -> Bool {
  match keyed_rows_of(parsed: before) {
    Absent => false
    Present { value: rows } =>
      (rows |> count) > 0 &&
        match keyed_rows_of(
          parsed: annotation_parsed_of(
            source: rendered_source_for_parsed(parsed: before, subject_name: subject_name, decl: decl)
          )
        ) {
          Absent => false
          Present { value: after } => keyed_annotation_rows_agree(left: rows, right: after)
        }
  }
}

fn round_trip_is_evidence(source: String, subject_name: String) -> Bool {
  round_trip_is_evidence_for(
    before: annotation_parsed_of(source: source),
    subject_name: subject_name,
    decl: declaration_text
  )
}

data two_blocks_source: String = "module rt\n\n// first block\n\n// second block\ndata alpha: String = \"a\"\n"

data one_block_source: String = "module rt\n\n// first line\n// second line\ndata alpha: String = \"a\"\n"

data twice_source: String = "module rt\n\n// same text\n\n// same text\ndata alpha: String = \"a\"\n"

data indented_source: String = "module rt\n\n//   indented\ndata alpha: String = \"a\"\n"

data empty_line_source: String = "module rt\n\n// above\n//\n// below\ndata alpha: String = \"a\"\n"

data bare_source: String = "module rt\n\ndata alpha: String = \"a\"\n"

data discriminating_case_note: String = "THE CASE THAT DECIDES THE RENDERER. Two blocks separated by a blank line must come back as two rows. The arm asserts the count on BOTH sides as well as agreement, because agreement between two identically-merged graphs would also pass and the count is what pins which shape survived."

test fn w_two_blocks_survive_the_round_trip() -> Bool {
  admitted_row_count(source: two_blocks_source) == 2 &&
    admitted_row_count(
      source: rendered_source_for(source: two_blocks_source, subject_name: "alpha", decl: declaration_text)
    ) == 2 &&
    round_trip_is_evidence(source: two_blocks_source, subject_name: "alpha")
}

data blank_line_is_load_bearing_note: String = "The RED control: a renderer joining blocks with a single newline instead of a blank line. It is reconstructed here because the production renderer does not offer the wrong behaviour, and it asserts the round trip would have MERGED two authored blocks into one. Without it, the arm above passes for a renderer that is right and for one that is wrong in a way nothing else here observes."

fn merged_rendering(source: String) -> String {
  concat(
    "module rt\n\n",
    concat(
      source_annotation_graph_rows(graph: annotation_parsed_of(source: source).admitted.graph)
        |> map(row => render_annotation_block(text: row.text))
        |> join(separator: "\n"),
      concat("\n", declaration_text)
    )
  )
}

test fn w_a_renderer_without_the_blank_line_merges_them() -> Bool {
  admitted_row_count(source: merged_rendering(source: two_blocks_source)) == 1 &&
    match admitted_keyed_rows(source: two_blocks_source) {
      Absent => false
      Present { value: before } =>
        match admitted_keyed_rows(source: merged_rendering(source: two_blocks_source)) {
          Absent => false
          Present { value: after } => !keyed_annotation_rows_agree(left: before, right: after)
        }
    }
}

test fn w_one_block_spanning_two_lines_stays_one_block() -> Bool {
  admitted_row_count(source: one_block_source) == 1 &&
    round_trip_is_evidence(source: one_block_source, subject_name: "alpha")
}

test fn w_identical_text_twice_stays_twice() -> Bool {
  admitted_row_count(source: twice_source) == 2 &&
    admitted_row_count(
      source: rendered_source_for(source: twice_source, subject_name: "alpha", decl: declaration_text)
    ) == 2 &&
    round_trip_is_evidence(source: twice_source, subject_name: "alpha")
}

test fn w_authored_indentation_survives() -> Bool {
  render_line_comment_delimiter(line: "  indented") == "//   indented" &&
    round_trip_is_evidence(source: indented_source, subject_name: "alpha")
}

test fn w_an_empty_annotation_line_survives() -> Bool {
  render_line_comment_delimiter(line: "") == "//" &&
    admitted_row_count(source: empty_line_source) == 1 &&
    round_trip_is_evidence(source: empty_line_source, subject_name: "alpha")
}

data vacuity_note: String = "Vacuity is asserted to FAIL, not merely demonstrated. An earlier cut showed that empty agrees with empty and returned true, which proves the round trip is reflexive and says nothing about whether prose survives. The evidence predicate requires a nonempty admitted projection, so the bare fixture must NOT satisfy it — and it must still be admitted, so the failure is `no prose to carry` rather than `refused`."

test fn w_a_source_with_no_prose_is_not_evidence() -> Bool {
  admitted_row_count(source: bare_source) == 0 &&
    !round_trip_is_evidence(source: bare_source, subject_name: "alpha")
}

data refusal_blocks_evidence_note: String = "THE ARM THAT PROVES THE ADMISSION ROUTING, by contrasting the seam against the bypass on one source. This fixture carries admissible leading prose AND an unattachable trailing annotation, so the two paths disagree about it: the raw attachment accessor returns the one attached row while the trailing prose is silently dropped, and the admission seam withholds the graph entirely.

That is the whole hazard in one fixture. Reading the raw graph, a round trip over this source compares one row against one row and PASSES while an annotation was lost. Reading the seam, there is nothing to compare and the property correctly refuses to call it evidence. The arm asserts both halves, because asserting only the second would leave `the bypass would have passed` an unverified claim in a note."

data mixed_refusal_source: String = "module rt\n\n// good prose\ndata alpha: String = \"a\" // stray trailing\n"

fn bypassed_row_count(source: String) -> Int {
  let parsed = annotation_parsed_of(source: source)
  source_annotation_graph_rows(
    graph: annotation_attachment_result_graph(
      result: bind_annotations(
        transport: parsed.parse.occurrence_transport,
        captures: parsed.artifact.annotations,
        source_length: string_length(s: source)
      )
    )
  ) |> count
}

test fn w_a_refused_source_is_not_evidence() -> Bool {
  bypassed_row_count(source: mixed_refusal_source) == 1 &&
    admitted_row_count(source: mixed_refusal_source) == (0 - 1) &&
    !round_trip_is_evidence(source: mixed_refusal_source, subject_name: "alpha")
}

data cross_graph_identity_note: String = "THE FALSE-POSITIVE CONTROL for the keying decision. Both sources carry the same annotation text in the same position above a single declaration; only the declaration's NAME differs. Their subjects therefore receive the same allocation ordinal in their own parses, so an id-valued comparison would report agreement. Keyed on the authored name they must disagree — and the arm also asserts each side is nonempty, so disagreement cannot come from one side being absent."

data alpha_named_source: String = "module rt\n\n// shared text\ndata alpha: String = \"a\"\n"

data beta_named_source: String = "module rt\n\n// shared text\ndata beta: String = \"a\"\n"

data ordinal_collision_note: String = "The MEASURED fact that makes the control below discriminating rather than merely true. If the two declarations happened to receive different occurrence ordinals, `they disagree` would hold for the wrong reason and would keep holding even under the unsound id-valued comparison the keying replaced. They do not: alpha in one source and beta in the other are allocated the SAME id value, so an id-valued oracle agreed on two annotations naming different declarations. This arm pins that, so the pair reads as `same ordinal, different key, must disagree`."

fn subject_id_value(source: String, name: String) -> Int {
  match subject_named(source: source, name: name) {
    Absent => 0 - 1
    Present { value: id } => id.value
  }
}

test fn w_the_two_declarations_share_an_occurrence_ordinal() -> Bool {
  subject_id_value(source: alpha_named_source, name: "alpha") ==
    subject_id_value(source: beta_named_source, name: "beta") &&
    subject_id_value(source: alpha_named_source, name: "alpha") > (0 - 1)
}

test fn w_same_text_same_position_different_declaration_disagrees() -> Bool {
  match admitted_keyed_rows(source: alpha_named_source) {
    Absent => false
    Present { value: a } =>
      match admitted_keyed_rows(source: beta_named_source) {
        Absent => false
        Present { value: b } =>
          (a |> count) == 1 && (b |> count) == 1 && !keyed_annotation_rows_agree(left: a, right: b)
      }
  }
}

data two_declaration_note: String = "The control the single-declaration fixtures could not provide: two declarations each carrying their own prose. It asserts the blocks are selected PER SUBJECT — alpha's rendering contains alpha's text and not beta's — which is what the typed one-subject carrier exists to guarantee and what a bare row list silently got wrong.

BETA IS RENDERED ABOVE `data beta`, NOT ABOVE THE SHARED `data alpha`, and the difference is the whole claim. An earlier cut reused declaration_text for both subjects, so beta's expected rendering was literally `// about beta` above `data alpha` — a string that shows beta's TEXT was selected while quietly REATTACHING it to a declaration named alpha. Text selection is the weaker claim; the arm's name promises the stronger one.

So each rendering is reparsed and the prose is read back THROUGH ITS SUBJECT: beta's rendering must bind `// about beta` to the subject named beta. The old form is kept as the RED control, executed rather than described — rendering beta's blocks above `data alpha` and asserting that the reparse binds beta's prose to ALPHA. That is the misattachment the arm exists to exclude, so it is asserted to happen in the wrong form rather than merely avoided in the right one.

WHY THIS ARM DOES NOT USE round_trip_is_evidence: the fixture carries two subjects and any single rendering reproduces one, so `before` has two rows and `after` has one and the round trip correctly disagrees. Per-subject reattachment is the claim here; whole-source survival is what the single-declaration arms above prove."

data two_decl_source: String = "module rt\n\n// about alpha\ndata alpha: String = \"a\"\n\n// about beta\ndata beta: String = \"b\"\n"

data beta_declaration_text: String = "data beta: String = \"b\"\n"

fn reattached_block_text(rendered: String, name: String) -> String {
  let parsed = annotation_parsed_of(source: rendered)
  match subject_named_in(parsed: parsed, name: name) {
    Absent => ""
    Present { value: subject } =>
      match subject_annotation_blocks_for(graph: parsed.admitted.graph, subject: subject) {
        Absent => ""
        Present { value: blocks } => render_subject_annotation_blocks(blocks: blocks)
      }
  }
}

test fn w_each_declaration_keeps_its_own_prose() -> Bool {
  let parsed = annotation_parsed_of(source: two_decl_source)
  let alpha_rendered = rendered_source_for_parsed(parsed: parsed, subject_name: "alpha", decl: declaration_text)
  let beta_rendered = rendered_source_for_parsed(parsed: parsed, subject_name: "beta", decl: beta_declaration_text)
  admitted_row_count(source: two_decl_source) == 2 &&
    alpha_rendered == "module rt\n\n// about alpha\ndata alpha: String = \"a\"\n" &&
    beta_rendered == "module rt\n\n// about beta\ndata beta: String = \"b\"\n" &&
    reattached_block_text(rendered: alpha_rendered, name: "alpha") == "// about alpha" &&
    reattached_block_text(rendered: beta_rendered, name: "beta") == "// about beta" &&
    reattached_block_text(
      rendered: rendered_source_for_parsed(parsed: parsed, subject_name: "beta", decl: declaration_text),
      name: "alpha"
    ) == "// about beta"
}

data parse_error_control_note: String = "THE ARM THAT PROVES THE PARSE GATE, and it is tested AT ITS OWN SEAM rather than end to end, because the end-to-end interleaving is not reachable with any fixture tried.

MEASURED FIRST, then built accordingly. Five malformed shapes were probed — trailing garbage token, a declaration truncated after `=`, an unclosed `fn` parameter list, an unclosed `type` body, a stray `)` — and in every one the parse errors AND the annotation admission refuses, with an EMPTY graph. So the hypothesised false green (parse errors, annotations admit cleanly, renderer drops the malformed tail, rows agree) has no fixture in this tree today: admission refuses first, because a failed parse yields no module items for the capture to attach to. Reporting the end-to-end arm as proof of the parse gate would therefore have been the inert-check tier — an arm that greens whether or not the gate exists.

So the gate is discriminated where it actually lives, by a forged value that differs from a working one in EXACTLY the parse health and nothing else. Getting that minimal is the whole difficulty, and the first attempt failed its own mutation test: swapping in the malformed source's entire ParseWithTableResult also swapped its OCCURRENCE TRANSPORT, so the good graph's subject ids no longer resolved and the projection refused for the wrong reason — the arm greened with the gate deleted. What is forged now is only `result`, the error-and-module pair; the transport, intern table, allocator and admitted graph all stay the clean source's. Delete the gate and the arm reds, because the only remaining reason to refuse is the one under test.

That is a lesson about controls, not about this gate: a synthetic input that perturbs more than the property under test proves the wrong thing while looking like proof.

WHY THE GATE STAYS despite having no reachable end-to-end case: `annotations admit only when the parse succeeded` is a coupling in today's attachment implementation, not a property this witness is entitled to assume. The gate is the property stating its own precondition instead of inheriting it from a neighbour."

data malformed_tail_source: String = "module rt\n\n// good prose\ndata alpha: String = \"a\"\n\ndata beta: String =\n"

test fn w_a_parse_error_is_not_evidence() -> Bool {
  let good = annotation_parsed_of(source: alpha_named_source)
  let bad = annotation_parsed_of(source: malformed_tail_source)
  annotation_parse_is_clean(parsed: good) &&
    !annotation_parse_is_clean(parsed: bad) &&
    admitted_row_count(source: malformed_tail_source) == (0 - 1) &&
    !round_trip_is_evidence(source: malformed_tail_source, subject_name: "alpha") &&
    match keyed_rows_of(parsed: good) {
      Absent => false
      Present { value: rows } =>
        (rows |> count) > 0 &&
          match keyed_rows_of(
            parsed: AnnotationParsedSource {
              artifact: good.artifact,
              parse: ParseWithTableResult {
                result: bad.parse.result,
                intern_table: good.parse.intern_table,
                occurrence_allocator: good.parse.occurrence_allocator,
                occurrence_transport: good.parse.occurrence_transport,
              },
              admitted: good.admitted,
            }
          ) {
            Absent => true
            Present { value: _ } => false
          }
    }
}

data duplicate_name_note: String = "The control for the authored-name uniqueness refusal. Two module items share the name `alpha`, so `the subject called alpha` has no answer — and the resolver must say so rather than folding to whichever match traversal reaches last. The arm pins that the SAME source resolves a uniquely named sibling normally, so the Absent is the duplicate refusing and not the lookup being broken."

data duplicate_name_source: String = "module rt\n\n// about the first\ndata alpha: String = \"a\"\n\n// about the second\ndata alpha: String = \"b\"\n\n// about gamma\ndata gamma: String = \"c\"\n"

fn subject_match_count(source: String, name: String) -> Int {
  subjects_named_in(parsed: annotation_parsed_of(source: source), name: name) |> count
}

test fn w_a_duplicated_authored_name_refuses_as_subject() -> Bool {
  subject_match_count(source: duplicate_name_source, name: "alpha") == 2 &&
    subject_id_value(source: duplicate_name_source, name: "alpha") == (0 - 1) &&
    subject_match_count(source: duplicate_name_source, name: "gamma") == 1 &&
    subject_id_value(source: duplicate_name_source, name: "gamma") > (0 - 1)
}

data mixed_subject_note: String = "WHAT THIS ARM CAN AND CANNOT SHOW, stated because an earlier cut of it claimed the stronger half. The mixed-subject state is unrepresentable — SubjectAnnotationBlocks holds block TEXTS, and a text carries no subject to disagree with the carrier's — and unrepresentability is exactly the property no executed arm can witness: there is no value to hand the renderer, which is the point. What executes here is the SELECTION: over a two-declaration graph the factory yields only the named subject's blocks, and a subject carrying no prose yields Absent rather than an empty block list. The carrier's own claim, and the residue it does not close, are stated at its declaration."

test fn w_mixed_subject_rows_cannot_reach_the_renderer() -> Bool {
  let parsed = annotation_parsed_of(source: two_decl_source)
  match subject_named_in(parsed: parsed, name: "alpha") {
    Absent => false
    Present { value: alpha } =>
      match subject_annotation_blocks_for(graph: parsed.admitted.graph, subject: alpha) {
        Absent => false
        Present { value: blocks } =>
          (blocks.texts |> count) == 1 &&
            render_subject_annotation_blocks(blocks: blocks) == "// about alpha" &&
            match subject_named(source: bare_source, name: "alpha") {
              Absent => false
              Present { value: unannotated } =>
                match subject_annotation_blocks_for(
                  graph: annotation_parsed_of(source: bare_source).admitted.graph,
                  subject: unannotated
                ) {
                  Absent => true
                  Present { value: _ } => false
                }
            }
      }
  }
}

