module v1.tests.claim.required_expr_newline_continuation_test

import std.dissolution { DissolutionCondition, unbound_dissolution }

import v1.std.core {
  NewlineIndex,
  build_newline_index,
  empty_intern_table,
}
import v1.compiler.tokenize { tokenize }
import v1.compiler.parse {
  ParseContext,
  parse_with_table,
}

data required_expr_newline_continuation_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/required_expr_newline_continuation_test.dag --functions w_untyped_let_newline_before_initializer,w_typed_let_newline_before_initializer,w_return_newline_before_expression,w_for_newline_before_collection,w_statement_boundary_after_complete_initializer,w_untyped_let_newline_then_rbrace_refuses,w_return_newline_then_rbrace_refuses,w_for_newline_then_block_without_collection_refuses"

fn newline_parse_ctx(file: String, source: String) -> ParseContext {
  ParseContext {
    source_indices: map_insert(
      empty_map(),
      file,
      build_newline_index(file: file, source: source)
    ),
    intern_table: empty_intern_table(),
    occurrence_allocator: none,
    occurrence_index: none,
    declaration_occurrences: none,
    reference_occurrences: none,
  }
}

fn parse_module_source_ok(source: String, file: String) -> Bool {
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: file),
    source_indices: newline_parse_ctx(file: file, source: source).source_indices,
    intern_table: empty_intern_table()
  )
  parsed.result.error == none
}

fn parse_module_source_refuses(source: String, file: String) -> Bool {
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: file),
    source_indices: newline_parse_ctx(file: file, source: source).source_indices,
    intern_table: empty_intern_table()
  )
  parsed.result.error != none
}

test fn w_untyped_let_newline_before_initializer() -> Bool {
  parse_module_source_ok(
    source: "module test\nfn demo() -> Int {\n  let x =\n    1\n  x\n}\n",
    file: "untyped_let_newline.dag"
  )
}

test fn w_typed_let_newline_before_initializer() -> Bool {
  parse_module_source_ok(
    source: "module test\nfn demo() -> Int {\n  let x: Int =\n    1\n  x\n}\n",
    file: "typed_let_newline.dag"
  )
}

test fn w_return_newline_before_expression() -> Bool {
  parse_module_source_ok(
    source: "module test\nfn demo() -> Int {\n  return\n    1\n}\n",
    file: "return_newline.dag"
  )
}

test fn w_for_newline_before_collection() -> Bool {
  parse_module_source_ok(
    source: "module test\nfn demo() -> List<String> {\n  for ch in\n    \"abc\" { ch }\n}\n",
    file: "for_newline.dag"
  )
}

test fn w_statement_boundary_after_complete_initializer() -> Bool {
  parse_module_source_ok(
    source: "module test\nfn demo() -> Int {\n  let x = 1\n  let y = 2\n  y\n}\n",
    file: "let_statement_boundary.dag"
  )
}

test fn w_untyped_let_newline_then_rbrace_refuses() -> Bool {
  parse_module_source_refuses(
    source: "module test\nfn demo() -> Int {\n  let x =\n}\n",
    file: "untyped_let_newline_rbrace.dag"
  )
}

test fn w_return_newline_then_rbrace_refuses() -> Bool {
  parse_module_source_refuses(
    source: "module test\nfn demo() -> Int {\n  return\n}\n",
    file: "return_newline_rbrace.dag"
  )
}

test fn w_for_newline_then_block_without_collection_refuses() -> Bool {
  parse_module_source_refuses(
    source: "module test\nfn demo() -> List<String> {\n  for x in\n  { x }\n}\n",
    file: "for_newline_missing_collection.dag"
  )
}

data required_expr_newline_continuation_dissolve_on: DissolutionCondition = unbound_dissolution(description: "DISSOLVE-ON: fold into v2 parser witness corpus when v1 claim discovery is retired; until then this is the durable floor-enrolled authority for required-expression newline continuation (review #7564).")
