module v1.tests.claim.caret_parse_smoke_test

import v1.std.core {
  Node,
  ErrorNode,
  NewlineIndex,
  ExprData,
  ExprLiteral,
  ExprCall,
  TokenShape,
  ShCaret,
  ShIdent,
  ShLParen,
  ShEof,
  empty_intern_table,
  diagnostic_to_message,
  is_error_diagnostic,
}
import v1.compiler.tokenize { tokenize }
import v1.compiler.parse {
  ParseContext,
  token_stream_new,
  parse_caret_expr,
  parse_expr,
  parse_module,
}
import v1.compiler.compile { compile_sources, compile_to_resolved, SourceFile }
import v1.compiler.artifact { Rust }

data caret_parse_smoke_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/caret_parse_smoke_test.dag --functions w_caret_tokenizes_as_sh_caret,w_caret_paren_tokenizes_as_caret_then_lparen,w_parse_caret_ident_produces_literal,w_parse_caret_paren_produces_discriminant_call,w_parse_expr_caret_paren_full_pipeline,w_parse_expr_caret_var_arg_produces_discriminant_call,w_parse_module_let_caret_paren,w_compile_to_resolved_caret_probe5b_has_no_caret_function_error,w_emit_caret_ident_symbol_literal,w_emit_caret_paren_discriminant_sugar"

data caret_parse_smoke_dissolve_on: String = "DISSOLVE-ON: move this claim into normal discovery when v1 compiler claims are admitted under the regular witness source-root and cost budget."

fn caret_parse_ctx() -> ParseContext {
  let empty: Map<String, NewlineIndex> = empty_map()
  ParseContext {
    source_indices: empty,
    intern_table: empty_intern_table(),
    occurrence_allocator: none,
    occurrence_index: none,
    declaration_occurrences: none,
    reference_occurrences: none,
  }
}

fn caret_probe5b_source() -> String {
  concat(
    "module caret.probe5b\n\n",
    concat(
      "fn probe() -> Bool {\n",
      concat(
        "  let sugar = ^(1)\n",
        concat(
          "  true\n",
          "}\n",
        ),
      ),
    ),
  )
}

fn caret_emit_tag_source() -> String {
  concat(
    "module caret.emit_tag\n\n",
    concat(
      "fn caret_tag() -> Bool {\n",
      concat(
        "  let t = ^caret_emit_tag\n",
        concat(
          "  t == ^caret_emit_tag\n",
          "}\n",
        ),
      ),
    ),
  )
}

fn caret_emit_disc_source() -> String {
  concat(
    "module caret.emit_disc\n\n",
    concat(
      "type CaretShape\n",
      concat(
        "  = CaretAlpha { x: Int }\n\n",
        concat(
          "fn caret_disc() -> String {\n",
          concat(
            "  let v = CaretAlpha { x: 1 }\n",
            concat(
              "  discriminant(v: ^(v))\n",
              "}\n",
            ),
          ),
        ),
      ),
    ),
  )
}

fn caret_source_file(path: String, content: String) -> SourceFile {
  SourceFile { path: path, content: content }
}

fn caret_compile_rust_emitted(source: SourceFile) -> String {
  let result = compile_sources(sources: [source], target: Rust)
  result.files |> map(f => f.content) |> join(separator: "\n")
}

fn caret_compile_rust_has_no_errors(source: SourceFile) -> Bool {
  let result = compile_sources(sources: [source], target: Rust)
  (result.diagnostics |> any(d => is_error_diagnostic(d.diagnostic))) == false
}

fn caret_diagnostics_contain_pattern(diagnostics: List<ErrorNode>, pattern: String) -> Bool {
  any(diagnostics, d => contains(diagnostic_to_message(d.diagnostic), pattern))
}

fn caret_expr_is_literal(expr: Node) -> Bool {
  match expr.expr_data {
    ExprLiteral { value: _ } => true
    _ => false
  }
}

fn caret_expr_is_discriminant_call(expr: Node) -> Bool {
  match expr.expr_data {
    ExprCall { call_semantics: _, descent_evidence: _ } => expr.name == "discriminant"
    _ => false
  }
}

test fn w_caret_tokenizes_as_sh_caret() -> Bool {
  let tokens = tokenize(source: "^foo", file: "test.dag")
  match tokens |> first {
    Present { value: t } => t.shape == ShCaret
    Absent => false
  }
}

test fn w_caret_paren_tokenizes_as_caret_then_lparen() -> Bool {
  let tokens = tokenize(source: "^(1)", file: "test.dag")
  match tokens |> first {
    Present { value: t1 } =>
      match tokens |> skip(n: 1) |> first {
        Present { value: t2 } => t1.shape == ShCaret && t2.shape == ShLParen
        Absent => false
      }
    Absent => false
  }
}

test fn w_parse_caret_ident_produces_literal() -> Bool {
  let tokens = tokenize(source: "^foo_tag", file: "test.dag")
  let r = parse_caret_expr(tokens: token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none && caret_expr_is_literal(expr: r.expr)
}

test fn w_parse_caret_paren_produces_discriminant_call() -> Bool {
  let tokens = tokenize(source: "^(1)", file: "test.dag")
  let r = parse_caret_expr(tokens: token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none && caret_expr_is_discriminant_call(expr: r.expr)
}

test fn w_parse_expr_caret_paren_full_pipeline() -> Bool {
  let tokens = tokenize(source: "^(1)", file: "test.dag")
  let r = parse_expr(tokens: token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none && caret_expr_is_discriminant_call(expr: r.expr)
}

test fn w_parse_expr_caret_var_arg_produces_discriminant_call() -> Bool {
  let tokens = tokenize(source: "^(alpha)", file: "test.dag")
  let r = parse_expr(tokens: token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none && caret_expr_is_discriminant_call(expr: r.expr)
}

test fn w_parse_module_let_caret_paren() -> Bool {
  let tokens = tokenize(source: caret_probe5b_source(), file: "caret_probe5b.dag")
  let r = parse_module(tokens: token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none
}

test fn w_compile_to_resolved_caret_probe5b_has_no_caret_function_error() -> Bool {
  let result = compile_to_resolved(sources: [
    caret_source_file(path: "caret_probe5b.dag", content: caret_probe5b_source())
  ])
  caret_diagnostics_contain_pattern(diagnostics: result.diagnostics, pattern: "function '^'") == false
}

test fn w_emit_caret_ident_symbol_literal() -> Bool {
  let emitted = caret_compile_rust_emitted(
    source: caret_source_file(path: "caret_emit_tag.dag", content: caret_emit_tag_source())
  )
  contains(emitted, "\"caret_emit_tag\"")
}

test fn w_emit_caret_paren_discriminant_sugar() -> Bool {
  let emitted = caret_compile_rust_emitted(
    source: caret_source_file(path: "caret_emit_disc.dag", content: caret_emit_disc_source())
  )
  contains(emitted, "CaretAlpha")
    && caret_diagnostics_contain_pattern(
      diagnostics: compile_sources(
        sources: [caret_source_file(path: "caret_emit_disc.dag", content: caret_emit_disc_source())],
        target: Rust
      ).diagnostics,
      pattern: "function '^'"
    ) == false
    && contains(emitted, "compile_error") == false
}
