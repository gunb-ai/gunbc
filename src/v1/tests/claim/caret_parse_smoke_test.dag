module v1.tests.claim.caret_parse_smoke_test


data caret_parse_smoke_parser_transport_enrollment: String = "Scheduled per PR through gunbc.ci_layer_roots v1_claim_scoped_witness_entries and v1_claim_scoped_witness_batch, enrolled by scoped_witness_batches; v2.workflow.ci_floor_plan gunbc_ci_floor_ordinary_batches folds those generic instances into the floor. The scoped batch supplies exactly dag plus src/v1 without widening ordinary witness discovery. Local reproduction: target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/caret_parse_smoke_test.dag --functions w_caret_tokenizes_as_sh_caret,w_caret_paren_tokenizes_as_caret_then_lparen,w_parse_caret_ident_produces_literal,w_parse_caret_paren_produces_discriminant_call,w_parse_expr_caret_paren_full_pipeline,w_parse_expr_caret_var_arg_produces_discriminant_call,w_parse_module_let_caret_paren. The native compile and emit claims remain on cargo test -p v1-compiler --lib caret_parse_smoke_native_compile_emit_witnesses until v1.compile_sources is interpreter-runnable (same map_keys gap as probe_emit_interp.dag)."

fn caret_parse_ctx() -> v1.compiler.parse.ParseContext {
  let empty: Map<String, v1.std.core.NewlineIndex> = empty_map()
  v1.compiler.parse.ParseContext {
    source_indices: empty,
    intern_table: empty_intern_table(),
    occurrence_allocator: none,
    occurrence_index: none,
    declaration_occurrences: none,
    reference_occurrences: none,
  }
}

fn caret_probe5b_source() -> String {
  concat(
    "module caret.probe5b\n\n",
    concat(
      "fn probe() -> Bool {\n",
      concat(
        "  let sugar = ^(1)\n",
        concat(
          "  true\n",
          "}\n",
        ),
      ),
    ),
  )
}

fn caret_emit_tag_source() -> String {
  concat(
    "module caret.emit_tag\n\n",
    concat(
      "fn caret_tag() -> Bool {\n",
      concat(
        "  let t = ^caret_emit_tag\n",
        concat(
          "  t == ^caret_emit_tag\n",
          "}\n",
        ),
      ),
    ),
  )
}

fn caret_emit_disc_source() -> String {
  concat(
    "module caret.emit_disc\n\n",
    concat(
      "type CaretShape\n",
      concat(
        "  = CaretAlpha { x: Int }\n\n",
        concat(
          "fn caret_disc() -> String {\n",
          concat(
            "  let v = CaretAlpha { x: 1 }\n",
            concat(
              "  discriminant(v: ^(v))\n",
              "}\n",
            ),
          ),
        ),
      ),
    ),
  )
}

fn caret_source_file(path: String, content: String) -> v1.compiler.compile.SourceFile {
  v1.compiler.compile.SourceFile { path: path, content: content }
}

fn caret_compile_rust_emitted(source: v1.compiler.compile.SourceFile) -> String {
  let result = compile_sources(sources: [source], target: Rust)
  result.files |> map(f => f.content) |> join(separator: "\n")
}

fn caret_compile_rust_has_no_errors(source: v1.compiler.compile.SourceFile) -> Bool {
  let result = compile_sources(sources: [source], target: Rust)
  (result.diagnostics |> any(d => is_error_diagnostic(d.diagnostic))) == false
}

fn caret_diagnostics_contain_pattern(diagnostics: List<v1.std.core.ErrorNode>, pattern: String) -> Bool {
  any(diagnostics, d => contains(diagnostic_to_message(d.diagnostic), pattern))
}

fn caret_token_stream_only_eof_remains(stream: v1.compiler.parse.TokenStream) -> Bool {
  let remaining = stream.all |> skip(count: stream.pos)
  all(remaining, t => t.shape == ShEof)
}

fn caret_expr_is_symbol_literal(expr: v1.std.core.Node) -> Bool {
  expr_data_variant(data: expr.expr_data) == "ExprLiteral"
}

fn caret_expr_is_discriminant_call(expr: v1.std.core.Node) -> Bool {
  expr_data_variant(data: expr.expr_data) == "ExprCall"
    && expr_call_func_at(texpr: expr, source_indices: empty_map()) == "discriminant"
}

test fn w_caret_tokenizes_as_sh_caret() -> Bool {
  let tokens = tokenize(source: "^foo", file: "test.dag")
  match tokens |> first {
    Present { value: t1 } =>
      match tokens |> skip(count: 1) |> first {
        Present { value: t2 } => t1.shape == ShCaret && t2.shape == ShIdent
        Absent => false
      }
    Absent => false
  }
}

test fn w_caret_paren_tokenizes_as_caret_then_lparen() -> Bool {
  let tokens = tokenize(source: "^(alpha)", file: "test.dag")
  match tokens |> first {
    Present { value: t1 } =>
      match tokens |> skip(count: 1) |> first {
        Present { value: t2 } => t1.shape == ShCaret && t2.shape == ShLParen
        Absent => false
      }
    Absent => false
  }
}

test fn w_parse_caret_ident_produces_literal() -> Bool {
  let tokens = tokenize(source: "^foo_tag", file: "test.dag")
  let r = parse_caret_expr(tokens: v1.compiler.parse.token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none && caret_expr_is_symbol_literal(expr: r.expr)
}

test fn w_parse_caret_paren_produces_discriminant_call() -> Bool {
  let tokens = tokenize(source: "^(alpha)", file: "test.dag")
  let r = parse_caret_expr(tokens: v1.compiler.parse.token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none && caret_expr_is_discriminant_call(expr: r.expr)
}

test fn w_parse_expr_caret_paren_full_pipeline() -> Bool {
  let tokens = tokenize(source: "^(alpha)", file: "test.dag")
  let r = parse_expr(tokens: v1.compiler.parse.token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none
    && caret_token_stream_only_eof_remains(stream: r.tokens)
    && caret_expr_is_discriminant_call(expr: r.expr)
}

test fn w_parse_expr_caret_var_arg_produces_discriminant_call() -> Bool {
  let tokens = tokenize(source: "^(alpha)", file: "test.dag")
  let r = parse_expr(tokens: v1.compiler.parse.token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none && caret_expr_is_discriminant_call(expr: r.expr)
}

test fn w_parse_module_let_caret_paren() -> Bool {
  let tokens = tokenize(source: caret_probe5b_source(), file: "caret_probe5b.dag")
  let r = parse_module(tokens: v1.compiler.parse.token_stream_new(all: tokens), ctx: caret_parse_ctx())
  r.err == none
}

fn w_compile_to_resolved_caret_probe5b_has_no_caret_function_error() -> Bool {
  let result = compile_to_resolved(sources: [
    caret_source_file(path: "caret_probe5b.dag", content: caret_probe5b_source())
  ])
  caret_diagnostics_contain_pattern(diagnostics: result.diagnostics, pattern: "function '^'") == false
}

fn w_emit_caret_ident_symbol_literal() -> Bool {
  let source = caret_source_file(path: "caret_emit_tag.dag", content: caret_emit_tag_source())
  caret_compile_rust_has_no_errors(source: source)
    && contains(caret_compile_rust_emitted(source: source), "\"caret_emit_tag\"")
}

fn w_emit_caret_paren_discriminant_sugar() -> Bool {
  let source = caret_source_file(path: "caret_emit_disc.dag", content: caret_emit_disc_source())
  caret_compile_rust_has_no_errors(source: source)
    && contains(caret_compile_rust_emitted(source: source), "CaretAlpha")
    && caret_diagnostics_contain_pattern(
      diagnostics: compile_sources(sources: [source], target: Rust).diagnostics,
      pattern: "function '^'"
    ) == false
    && contains(caret_compile_rust_emitted(source: source), "compile_error") == false
}
