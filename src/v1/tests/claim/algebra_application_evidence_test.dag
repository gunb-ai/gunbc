module v1.tests.claim.algebra_application_evidence_test

import std.types { Bool, List, String, Int, Map }
import std.occurrence_identity { OccurrenceSynthetic }
import std.algebra { ReceiverElement }
import v1.std.core {
  Node, Connective, NoConnective, Disj, Required, NoExprData, NotAModuleItem,
  InferredNode, Resolved, int_type, kernel_span
}
import v1.compiler.infer_patterns { pattern_subject_from_node, pattern_binding_type }
import v1.compiler.infer_types { instantiate_algebra_type }

fn evidence_node(name: String, connective: Connective, children: List<Node>, inferred: InferredNode?) -> Node {
  Node {
    occurrence_identity: OccurrenceSynthetic,
    name: name, span: kernel_span(name: name), ident_span: Present { value: kernel_span(name: name) },
    children: children, connective: connective, params: [], inferred: inferred,
    return_cardinality: Required, uses: [], body: none, transport: none, properties: [],
    type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false,
    match_pattern: none, module_item_kind: NotAModuleItem, expr_data: NoExprData
  }
}

fn evidence_expansion() -> Node {
  evidence_node(name: "FreeMonoid", connective: Disj, children: [
    evidence_node(name: "Empty", connective: NoConnective, children: [], inferred: none),
    evidence_node(name: "Cons", connective: NoConnective, children: [], inferred: none)
  ], inferred: none)
}

// On the broken binder this extracts Empty rather than Int. Both the nominal
// argument and its distinct structural expansion are present in the input.
test fn binding_preserves_application_argument_instead_of_variant_member() -> Bool {
  let nominal = evidence_node(name: "List", connective: NoConnective, children: [int_type],
    inferred: Present { value: Resolved { node: evidence_expansion() } })
  let bound = pattern_binding_type(subject: pattern_subject_from_node(n: nominal))
  let result = instantiate_algebra_type(template: ReceiverElement, base: bound, source_indices: empty_map())
  result.ty.name == "Int" && result.ty.connective == NoConnective
    && result.ty.children |> count == 0 && result.diagnostics |> count == 0
}
