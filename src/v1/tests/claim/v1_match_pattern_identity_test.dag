module v1.tests.claim.v1_match_pattern_identity_test

import v1.std.core {
  Node, MatchPattern, LitPattern, VariantPattern, Wildcard,
  ExprLiteral,
  make_span, make_arm_node, make_field_binding_node, make_expr_node
}
import std.types { SourceSpan }
import std.syntax { LitInt, LitStr }
import v1.compiler.dag_collect_support { dag_node_surface_fingerprint }
import v1.compiler.dag_collect { dag_collect_insert_slots, dag_node_key }

data v1_match_pattern_identity_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/debug/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/v1_match_pattern_identity_test.dag --functions w_match_arms_differing_only_by_literal_pattern_get_distinct_fingerprints,w_match_arms_with_identical_literal_patterns_get_equal_fingerprints,w_match_arms_differing_only_by_variant_name_get_distinct_fingerprints,w_variant_pattern_field_bindings_are_registered_as_dag_artifacts,w_unrelated_field_binding_is_not_registered"

data v1_match_pattern_identity_note: String = "Node.match_pattern is classified a SubValueField in v1.std.core's own node_field_roles map, the same category as body and expr_data. Before this fix, both identity readers -- the content fingerprint (dag_collect_support.dag_node_surface_fingerprint_rec) and the DAG artifact collector (dag_collect.dag_collect_node_tree) -- walked children/params/body/uses/properties/type_annotation/inferred but never touched match_pattern. Two Match arms differing ONLY in their pattern (a different literal, a different variant name, a different embedded field-binding subtree) therefore aliased to the same cache identity: same fingerprint, same collection key, so the second arm was silently treated as a duplicate of the first anywhere that key drove deduplication (compile.dag's DAG artifact node table).

Each claim below pairs a discriminating case (patterns differ, fingerprints/registration must differ) with a control (patterns identical, fingerprints must be equal) so the discriminating case cannot pass vacuously."

fn zero_span() -> SourceSpan {
  make_span(start: 0, end: 0)
}

fn lit_body(text: String) -> Node {
  make_expr_node(expr_data: ExprLiteral { value: LitStr { value: text } }, children: [], inferred: none, span: zero_span())
}

fn arm_with_pattern(pattern: MatchPattern) -> Node {
  make_arm_node(pattern: pattern, guard: none, body: lit_body(text: "arm"), span: zero_span())
}

test fn w_match_arms_differing_only_by_literal_pattern_get_distinct_fingerprints() -> Bool {
  let arm_zero = arm_with_pattern(pattern: LitPattern { value: LitInt { value: 0 } })
  let arm_one = arm_with_pattern(pattern: LitPattern { value: LitInt { value: 1 } })
  dag_node_surface_fingerprint(node: arm_zero) != dag_node_surface_fingerprint(node: arm_one)
}

test fn w_match_arms_with_identical_literal_patterns_get_equal_fingerprints() -> Bool {
  let a = arm_with_pattern(pattern: LitPattern { value: LitInt { value: 0 } })
  let b = arm_with_pattern(pattern: LitPattern { value: LitInt { value: 0 } })
  dag_node_surface_fingerprint(node: a) == dag_node_surface_fingerprint(node: b)
}

test fn w_match_arms_differing_only_by_variant_name_get_distinct_fingerprints() -> Bool {
  let arm_some = arm_with_pattern(pattern: VariantPattern { name: "Some", parent_enum: none, field_bindings: [] })
  let arm_none = arm_with_pattern(pattern: VariantPattern { name: "None", parent_enum: none, field_bindings: [] })
  dag_node_surface_fingerprint(node: arm_some) != dag_node_surface_fingerprint(node: arm_none)
}

fn field_binding_x() -> Node {
  make_field_binding_node(field_name: "x", binding: Wildcard, span: zero_span(), name_span: zero_span())
}

fn field_binding_y() -> Node {
  make_field_binding_node(field_name: "y", binding: Wildcard, span: zero_span(), name_span: zero_span())
}

fn arm_with_bound_variant() -> Node {
  arm_with_pattern(pattern: VariantPattern { name: "Some", parent_enum: none, field_bindings: [field_binding_x()] })
}

test fn w_variant_pattern_field_bindings_are_registered_as_dag_artifacts() -> Bool {
  let slots = dag_collect_insert_slots(node: arm_with_bound_variant(), slots: empty_map(), collision_errors: [])
  match map_get(slots, dag_node_key(node: field_binding_x())) {
    Present { value: _ } => true
    Absent => false
  }
}

test fn w_unrelated_field_binding_is_not_registered() -> Bool {
  let slots = dag_collect_insert_slots(node: arm_with_bound_variant(), slots: empty_map(), collision_errors: [])
  match map_get(slots, dag_node_key(node: field_binding_y())) {
    Present { value: _ } => false
    Absent => true
  }
}
