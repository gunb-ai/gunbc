module v1.tests.claim.v1_annotation_binding_test

import std.types { Bool, Int, String, List }
import std.occurrence_identity { OccurrenceId, OccurrenceIndexEntry, OccurrenceTransport }
import std.source_annotation {
  AnnotationAttachmentRefusal,
  AnnotationAttachmentResult,
  BodyGrainNotModeled,
  SourceAnnotationDebt,
  TrailingNotModeled,
  UnattachedAtScopeEnd,
  annotation_attachment_result_graph,
  annotation_attachment_result_refusals,
  source_annotation_graph_rows
}
import v1.compiler.annotation_bind { AdmittedSourceAnnotations, admit_source_annotations, bind_annotations, strip_line_comment_delimiter }
import v1.compiler.tokenize { tokenize_artifact }
import v1.compiler.parse { parse_with_table }
import v1.std.core { build_newline_index, empty_intern_table, NewlineIndex }

data v1_annotation_binding_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/debug/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/v1_annotation_binding_test.dag --functions w_leading_prose_attaches_to_the_data_row_it_precedes,w_leading_prose_attaches_to_the_type_it_precedes,w_body_prose_refuses_rather_than_attaching_to_a_later_declaration,w_prose_above_module_attaches_to_the_module,w_prose_below_module_before_first_item_attaches_to_the_module,w_trailing_prose_refuses,w_annotation_free_source_binds_nothing,w_delimiter_normalization_keeps_authored_indentation,w_a_single_refusal_withholds_the_entire_graph,w_the_same_prose_without_the_refusal_is_admitted,w_adjacent_comment_lines_form_one_block,w_blank_line_separated_comments_form_two_blocks"

data v1_annotation_binding_note: String = "The end-to-end .dag witness: real source through the real tokenizer, the real parser, and the real binder, asserting WHICH declaration each piece of prose landed on. Everything upstream of this — the capture channel, the attachment fold — is proven separately on synthetic inputs; this is what proves the three fit together on the language the corpus is actually written in.

It asserts against AUTHORED NAMES rather than occurrence id values. Ids are allocator-local and would make the expected string a transcription of whatever the parser happened to number things on the day it was written, so a test asserting `7` would fail the moment an unrelated declaration was added above — and would be repaired by transcribing the new number, which checks nothing. A name is the fact the reader cares about."

data binding_fixture_note: String = "One module carrying prose in every position the rule distinguishes: above a data row, above a type, inside a function body, and trailing after code. The data row is the load-bearing case — every prose row this repository migrates is a module-scope `data` declaration, and those are absent from the parser's declaration-role projection, so a roster built from that projection would bind none of them."

data binding_source: String = "module p.q\n\n// about alpha\ndata alpha: String = \"a\"\n\n// about Thing\ntype Thing {\n  f: String\n}\n\nfn go(x: String) -> String {\n  // inside the body\n  let y = x\n  y\n}\n"

data clean_source: String = "module p.q\n\ndata alpha: String = \"a\"\n"

data header_source: String = "// file header prose\nmodule p.q\n\ndata alpha: String = \"a\"\n"

data post_module_header_source: String = "module p.q\n// module header prose\n\nimport std.types { String }\n\ndata alpha: String = \"a\"\n"

data trailing_source: String = "module p.q\n\ndata alpha: String = \"a\" // trailing prose\n"

fn transport_of(source: String) -> OccurrenceTransport {
  parse_with_table(
    tokens: tokenize_artifact(source: source, file: "probe.dag").tokens,
    source_indices: map_insert(empty_map(), "probe.dag", build_newline_index(file: "probe.dag", source: source)),
    intern_table: empty_intern_table(),
  ).occurrence_transport
}

fn bound(source: String) -> AnnotationAttachmentResult {
  bind_annotations(
    transport: transport_of(source: source),
    captures: tokenize_artifact(source: source, file: "probe.dag").annotations,
    source_length: string_length(s: source)
  )
}

data name_lookup_note: String = "Resolves an occurrence back to the name the author wrote, through the same index the roster was built from. An unresolvable id renders as a marker rather than an empty string so a lookup miss cannot be mistaken for an anonymous declaration."

fn name_of(transport: OccurrenceTransport, id: OccurrenceId) -> String {
  fold(
    transport.index.entries,
    init: "<unresolved>",
    f: (acc, entry) =>
      if entry.projection.occurrence.value == id.value { entry.projection.authored_name } else { acc }
  )
}

fn render(source: String) -> String {
  let transport = transport_of(source: source)
  fold(
    source_annotation_graph_rows(graph: annotation_attachment_result_graph(result: bound(source: source))),
    init: "",
    f: (acc, row) =>
      concat(acc, concat("|", concat(name_of(transport: transport, id: row.subject), concat("=", row.text))))
  )
}

fn count_body_grain(refusals: List<AnnotationAttachmentRefusal>) -> Int {
  fold(
    refusals,
    init: 0,
    f: (n, refusal) =>
      match refusal {
        BodyGrainNotModeled { origin: _ } => n + 1
        TrailingNotModeled { origin: _ } => n
        UnattachedAtScopeEnd { origin: _ } => n
      }
  )
}

fn count_trailing(refusals: List<AnnotationAttachmentRefusal>) -> Int {
  fold(
    refusals,
    init: 0,
    f: (n, refusal) =>
      match refusal {
        BodyGrainNotModeled { origin: _ } => n
        TrailingNotModeled { origin: _ } => n + 1
        UnattachedAtScopeEnd { origin: _ } => n
      }
  )
}

test fn w_leading_prose_attaches_to_the_data_row_it_precedes() -> Bool {
  render(source: binding_source) == "|alpha=about alpha|Thing=about Thing"
}

test fn w_leading_prose_attaches_to_the_type_it_precedes() -> Bool {
  let rows = source_annotation_graph_rows(graph: annotation_attachment_result_graph(result: bound(source: binding_source)))
  let transport = transport_of(source: binding_source)
  fold(
    rows,
    init: false,
    f: (found, row) =>
      found || (name_of(transport: transport, id: row.subject) == "Thing" && row.text == "about Thing")
  )
}

data body_grain_end_to_end_note: String = "The prose inside `go` names no module item. Without the containment rule it would resolve to whatever module item came next in the file, so this asserts BOTH that a refusal was counted AND that no row carries its text — a refusal count alone would still pass if the same prose had also been attached somewhere."

test fn w_body_prose_refuses_rather_than_attaching_to_a_later_declaration() -> Bool {
  count_body_grain(refusals: annotation_attachment_result_refusals(result: bound(source: binding_source))) == 1 &&
    render(source: binding_source) == "|alpha=about alpha|Thing=about Thing"
}

test fn w_prose_above_module_attaches_to_the_module() -> Bool {
  render(source: header_source) == "|p.q=file header prose"
}

test fn w_prose_below_module_before_first_item_attaches_to_the_module() -> Bool {
  render(source: post_module_header_source) == "|p.q=module header prose"
}

test fn w_trailing_prose_refuses() -> Bool {
  count_trailing(refusals: annotation_attachment_result_refusals(result: bound(source: trailing_source))) == 1 &&
    render(source: trailing_source) == ""
}

test fn w_annotation_free_source_binds_nothing() -> Bool {
  render(source: clean_source) == "" &&
    (annotation_attachment_result_refusals(result: bound(source: clean_source)) |> count) == 0
}

test fn w_delimiter_normalization_keeps_authored_indentation() -> Bool {
  strip_line_comment_delimiter(lexeme: "// plain") == "plain" &&
    strip_line_comment_delimiter(lexeme: "//   indented") == "  indented" &&
    strip_line_comment_delimiter(lexeme: "//tight") == "tight"
}

data admission_gate_note: String = "The P0 wall, by execution: unclassified prose does not ride along inside a successful result. A source whose only annotation is trailing yields NO graph rows and at least one blocking diagnostic, while the same source with the prose moved above the declaration yields the row and no diagnostic. The pair is what distinguishes a wall from a filter — a filter would have produced the admissible rows either way."

fn admitted(source: String) -> AdmittedSourceAnnotations {
  admit_source_annotations(
    transport: transport_of(source: source),
    captures: tokenize_artifact(source: source, file: "probe.dag").annotations,
    source_length: string_length(s: source)
  )
}

data mixed_source: String = "module p.q\n\n// good prose\ndata alpha: String = \"a\" // stray trailing\n"

test fn w_a_single_refusal_withholds_the_entire_graph() -> Bool {
  let a = admitted(source: mixed_source)
  (source_annotation_graph_rows(graph: a.graph) |> count) == 0 && (a.diagnostics |> count) == 1
}

test fn w_the_same_prose_without_the_refusal_is_admitted() -> Bool {
  let a = admitted(source: header_source)
  (source_annotation_graph_rows(graph: a.graph) |> count) == 1 && (a.diagnostics |> count) == 0
}

data end_to_end_blank_line_note: String = "The blank-line ruling proven on REAL source through the real lexer, not on synthetic capture rows. The synthetic pair proves the fold honours the flag; this proves the v1 lexer actually observes it, which is the half that cannot be checked by constructing captures by hand."

data two_adjacent_blocks_source: String = "module p.q\n\n// first line\n// second line\ndata alpha: String = \"a\"\n"

data two_separated_blocks_source: String = "module p.q\n\n// first block\n\n// second block\ndata alpha: String = \"a\"\n"

test fn w_adjacent_comment_lines_form_one_block() -> Bool {
  render(source: two_adjacent_blocks_source) == "|alpha=first line\nsecond line"
}

test fn w_blank_line_separated_comments_form_two_blocks() -> Bool {
  render(source: two_separated_blocks_source) == "|alpha=first block|alpha=second block"
}
