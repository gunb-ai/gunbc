module v1.tests.claim.namespace_occurrence_transport_test

import std.algebra { Empty }
import std.occurrence_identity {
  OccurrenceId,
  OccurrenceIdAllocator,
  OccurrenceContainmentPath,
  occurrence_id_allocator_initial,
}
import v1.std.core {
  SourceSpan,
  make_span,
  build_newline_index,
  empty_intern_table,
  OccurrenceIndex,
  OccurrenceIndexEntry,
  OccurrenceProjection,
  OccurrenceTransport,
  DeclarationOccurrence,
  ReferenceOccurrence,
  LexicalValueOccurrence,
  CallableOccurrence,
  FieldOccurrence,
  make_arm_node,
  leaf_node_with_span,
  MissingAuthoredOccurrenceIdentity,
  DuplicateAuthoredOccurrenceIdentity,
  WrongOccurrenceCategory,
  occurrence_transport_refusal,
}
import v1.compiler.tokenize { tokenize }
import v1.compiler.parse {
  ParseContext,
  ParseWithTableResult,
  token_stream_new,
  parse_pattern,
  stamp_parsed_node,
  ParsedOccurrenceUnclassified,
  occurrence_transport_from_parse_context,
  parse_with_table_in_occurrence_scope,
}

data namespace_occurrence_transport_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/namespace_occurrence_transport_test.dag --functions w_namespace_occurrence_transport_mints_distinct_equal_text,w_namespace_occurrence_transport_preserves_graph_allocator,w_namespace_occurrence_transport_covers_pattern_binder_forms,w_namespace_occurrence_transport_refuses_missing_duplicate_and_wrong_category"

data namespace_occurrence_transport_dissolve_on: String = "DISSOLVE-ON: move this claim into normal discovery when v1 compiler claims are admitted under the regular witness source-root and cost budget."

fn parse_transport(
  source: String,
  file: String,
  allocator: OccurrenceIdAllocator
) -> ParseWithTableResult {
  let index = build_newline_index(file: file, source: source)
  parse_with_table_in_occurrence_scope(
    tokens: tokenize(source: source, file: file),
    source_indices: map_insert(empty_map(), file, index),
    intern_table: empty_intern_table(),
    occurrence_allocator: allocator
  )
}

fn occurrence_ids_are_unique(ids: List<OccurrenceId>) -> Bool {
  fold(
    ids,
    init: true,
    f: (unique, occurrence) =>
      unique &&
      (ids |> filter(other => other.value == occurrence.value) |> count) == 1
  )
}

test fn w_namespace_occurrence_transport_mints_distinct_equal_text() -> Bool {
  let parsed = parse_transport(
    source: "module occurrence.fixture\n\nfn left(x: Int) -> Int { x }\nfn right(x: Int) -> Int { left(x) }\n",
    file: "occurrence_fixture.dag",
    allocator: occurrence_id_allocator_initial()
  )
  let ids = parsed.occurrence_transport.index.entries
    |> map(entry => entry.projection.occurrence)
  let equal_text_x = parsed.occurrence_transport.index.entries
    |> filter(entry => entry.projection.authored_name == "x")
  match parsed.result.error {
    Present { value: _ } => false
    Absent =>
      occurrence_ids_are_unique(ids: ids) &&
      (equal_text_x |> count) >= 4 &&
      parsed.occurrence_transport.declarations
        |> filter(declaration =>
          declaration.category == LexicalValueOccurrence
        )
        |> count >= 2 &&
      parsed.occurrence_transport.references
        |> filter(reference =>
          reference.category == LexicalValueOccurrence
        )
        |> count >= 2 &&
      parsed.occurrence_transport.references
        |> filter(reference =>
          reference.category == CallableOccurrence
        )
        |> count >= 1 &&
      occurrence_transport_refusal(
        transport: parsed.occurrence_transport
      ) == none
  }
}

test fn w_namespace_occurrence_transport_preserves_graph_allocator() -> Bool {
  let first_parse = parse_transport(
    source: "module occurrence.first\nfn first(x: Int) -> Int { x }\n",
    file: "first.dag",
    allocator: occurrence_id_allocator_initial()
  )
  let second_parse = parse_transport(
    source: "module occurrence.second\nfn second(x: Int) -> Int { x }\n",
    file: "second.dag",
    allocator: first_parse.occurrence_allocator
  )
  let first_ids = first_parse.occurrence_transport.index.entries
    |> map(entry => entry.projection.occurrence.value)
  let second_ids = second_parse.occurrence_transport.index.entries
    |> map(entry => entry.projection.occurrence.value)
  first_ids |> count > 0 &&
  second_ids |> count > 0 &&
  fold(
    first_ids,
    init: true,
    f: (separate, first_id) =>
      separate &&
      second_ids |> all(second_id => first_id != second_id)
  )
}

type PatternOccurrenceFixture
  = PatternOccurrenceReady { transport: OccurrenceTransport }
  | PatternOccurrenceRefused

fn pattern_occurrence_fixture(source: String) -> PatternOccurrenceFixture {
  let file = "pattern-occurrence-fixture.dag"
  let span = make_span(start: 0, end: 1)
  let source_indices = map_insert(
    empty_map(),
    file,
    build_newline_index(file: file, source: source)
  )
  let parsed = parse_pattern(
    tokens: token_stream_new(all: tokenize(source: source, file: file)),
    ctx: ParseContext {
      source_indices: source_indices,
      intern_table: empty_intern_table(),
      occurrence_allocator: none,
      occurrence_index: none,
      declaration_occurrences: none,
      reference_occurrences: none,
    }
  )
  match parsed.err {
    Present { value: _ } => PatternOccurrenceRefused
    Absent =>
      let stamped = stamp_parsed_node(
        node: make_arm_node(
          pattern: parsed.pattern,
          guard: none,
          body: leaf_node_with_span(name: "body", span: span),
          span: span
        ),
        ancestors: Empty,
        ctx: parsed.ctx,
        role: ParsedOccurrenceUnclassified
      )
      PatternOccurrenceReady {
        transport: occurrence_transport_from_parse_context(ctx: stamped.ctx),
      }
  }
}

fn pattern_fixture_has_roles(
  source: String,
  lexical_minimum: Int,
  field_minimum: Int
) -> Bool {
  match pattern_occurrence_fixture(source: source) {
    PatternOccurrenceRefused => false
    PatternOccurrenceReady { transport: transport } =>
      transport.declarations
        |> filter(declaration =>
          declaration.category == LexicalValueOccurrence
        )
        |> count >= lexical_minimum &&
      transport.declarations
        |> filter(declaration =>
          declaration.category == FieldOccurrence
        )
        |> count >= field_minimum &&
      occurrence_transport_refusal(transport: transport) == none
  }
}

test fn w_namespace_occurrence_transport_covers_pattern_binder_forms() -> Bool {
  pattern_fixture_has_roles(
    source: "direct_bind",
    lexical_minimum: 1,
    field_minimum: 0
  ) &&
  pattern_fixture_has_roles(
    source: "Pair { left: explicit_bind }",
    lexical_minimum: 1,
    field_minimum: 1
  ) &&
  pattern_fixture_has_roles(
    source: "Shorthand { shorthand_only }",
    lexical_minimum: 1,
    field_minimum: 1
  ) &&
  pattern_fixture_has_roles(
    source: "Left(positional_bind)",
    lexical_minimum: 1,
    field_minimum: 1
  ) &&
  pattern_fixture_has_roles(
    source: "Outer { pair: Pair { left: nested_bind } }",
    lexical_minimum: 1,
    field_minimum: 2
  )
}

fn fixture_span() -> SourceSpan {
  make_span(start: 7, end: 8)
}

fn fixture_path(id: OccurrenceId) -> OccurrenceContainmentPath {
  OccurrenceContainmentPath { ancestors: Empty, terminal: id }
}

fn fixture_index_entry(id: OccurrenceId) -> OccurrenceIndexEntry {
  OccurrenceIndexEntry {
    projection: OccurrenceProjection {
      occurrence: id,
      authored_name: "x",
      diagnostic_span: fixture_span(),
    },
    containment: fixture_path(id: id),
  }
}

test fn w_namespace_occurrence_transport_refuses_missing_duplicate_and_wrong_category() -> Bool {
  let id = OccurrenceId { value: 7 }
  let declaration = DeclarationOccurrence {
    occurrence: id,
    containment: fixture_path(id: id),
    category: LexicalValueOccurrence,
    diagnostic_span: fixture_span(),
  }
  let reference = ReferenceOccurrence {
    occurrence: id,
    containment: fixture_path(id: id),
    category: CallableOccurrence,
    diagnostic_span: fixture_span(),
  }
  let missing = OccurrenceTransport {
    index: OccurrenceIndex { entries: [] },
    declarations: [declaration],
    references: [],
  }
  let duplicate = OccurrenceTransport {
    index: OccurrenceIndex {
      entries: [fixture_index_entry(id: id), fixture_index_entry(id: id)],
    },
    declarations: [declaration],
    references: [],
  }
  let wrong = OccurrenceTransport {
    index: OccurrenceIndex { entries: [fixture_index_entry(id: id)] },
    declarations: [declaration],
    references: [reference],
  }
  match occurrence_transport_refusal(transport: missing) {
    Present { value: MissingAuthoredOccurrenceIdentity { diagnostic_span: _ } } =>
      match occurrence_transport_refusal(transport: duplicate) {
        Present {
          value: DuplicateAuthoredOccurrenceIdentity {
            occurrence: duplicate_id,
            diagnostic_span: _,
          },
        } =>
          duplicate_id.value == id.value &&
          match occurrence_transport_refusal(transport: wrong) {
            Present {
              value: WrongOccurrenceCategory {
                occurrence: wrong_id,
                expected: LexicalValueOccurrence,
                observed: CallableOccurrence,
                diagnostic_span: _,
              },
            } => wrong_id.value == id.value
            _ => false
          }
        _ => false
      }
    _ => false
  }
}
