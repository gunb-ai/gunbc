data idb_same_file_source_path: String = "dag/test/fixture/import_deletion_bridge/same_file.dag"

fn idb_same_file_source() -> String {
  "module test.fixture.import_deletion_bridge.same_file\n\ntype LiveTreeDisposition\n  = ReadsLiveTree\n  | SubstrateInputsOnly\n\nfn same_file_reads(d: LiveTreeDisposition) -> LiveTreeDisposition {\n  d\n}\n"
}

fn idb_source_for_candidate(path: String) -> String? {
  fold(idb_candidates(), init: none, f: (found, candidate) =>
    match found {
      Present { value: _ } => found
      Absent =>
        match candidate.file == path {
          true => Present { value: candidate.source }
          false => Absent
        }
    })
}

type IdbBridge
  = IdbBridgeProjected { projection: ReferenceDerivedDependencyProjection }
  | IdbBridgeWalkRefused { refusal: StructuralBindingIndexRefusal }
  | IdbBridgeIndexRefused { refusal: ModulePathFileIndexRefusal }
  | IdbBridgeAssemblyRefused { refusal: AssembledCrossFileBindingClosureRefusal }
  | IdbBridgeParseRefused { file: String }
  | IdbBridgeCandidateUnknown { file: String }
  | IdbBridgeSelectionRefused { observed: Int }

fn idb_parsed_row(path: String) -> ParsedOccurrenceBindingSource? {
  match idb_source_for_candidate(path: path) {
    Absent => none
    Present { value: source } =>
      Present { value: parse_authored_occurrence_binding_source(file: path, source: source) }
  }
}

fn idb_no_closure_rows() -> List<CrossFileBindingClosureRow> { [] }

fn idb_closure_row_for(
  path: String,
  grounding: DeclarationExposureGrounding
) -> List<CrossFileBindingClosureRow> {
  match idb_parsed_row(path: path) {
    Absent => idb_no_closure_rows()
    Present { value: ParsedOccurrenceBindingSourceRefused } => idb_no_closure_rows()
    Present { value: ParsedOccurrenceBindingSourceReady { transport: t, module_path: m } } =>
      [ CrossFileBindingClosureRow {
          transport: t,
          inputs: occurrence_binding_inputs_from_transport(
            module_path: m, transport: t, grounding: grounding,
          ),
          module_path: m,
          file_path: path,
        } ]
  }
}

fn idb_index_entry_for_occurrence(
  transport: OccurrenceTransport,
  occurrence: OccurrenceId
) -> OccurrenceIndexEntry? {
  fold(transport.index.entries, init: none, f: (found, entry) =>
    match found {
      Present { value: _ } => found
      Absent =>
        match entry.projection.occurrence.value == occurrence.value {
          true => Present { value: entry }
          false => Absent
        }
    })
}

fn idb_no_references() -> List<ReferenceOccurrence> { [] }

fn idb_name_in(names: List<String>, name: String) -> Bool {
  fold(names, init: false, f: (found, candidate) => found || (candidate == name))
}

fn idb_references_in_names(
  transport: OccurrenceTransport,
  names: List<String>
) -> List<ReferenceOccurrence> {
  fold(transport.references, init: idb_no_references(), f: (acc, reference) =>
    match idb_index_entry_for_occurrence(transport: transport, occurrence: reference.occurrence) {
      Absent => acc
      Present { value: entry } =>
        match idb_name_in(names: names, name: entry.projection.authored_name) {
          true => concat(acc, [reference])
          false => acc
        }
    })
}

fn idb_references_named(transport: OccurrenceTransport, name: String) -> List<ReferenceOccurrence> {
  fold(transport.references, init: idb_no_references(), f: (acc, reference) =>
    match idb_index_entry_for_occurrence(transport: transport, occurrence: reference.occurrence) {
      Absent => acc
      Present { value: entry } =>
        match entry.projection.authored_name == name {
          true => concat(acc, [reference])
          false => acc
        }
    })
}

fn idb_references_named_in_consumer(consumer_path: String) -> List<ReferenceOccurrence> {
  match idb_parsed_row(path: consumer_path) {
    Absent => idb_no_references()
    Present { value: ParsedOccurrenceBindingSourceRefused } => idb_no_references()
    Present { value: ParsedOccurrenceBindingSourceReady { transport: t, module_path: _ } } =>
      idb_references_named(transport: t, name: idb_subject_name)
  }
}

fn idb_project_from_assembled(
  closure: AssembledCrossFileBindingClosure,
  subject_names: List<String>,
  expected_references: Int
) -> IdbBridge {
  match closure {
    AssembledCrossFileBindingClosureRefused { refusal: refusal } =>
      IdbBridgeAssemblyRefused { refusal: refusal }
    AssembledCrossFileBindingClosureReady {
      transport: t, inputs: i, module_files: rows, consumer_file: _,
    } =>
      let selected = idb_references_in_names(transport: t, names: subject_names)
      match length(selected) == expected_references {
        false => IdbBridgeSelectionRefused { observed: length(selected) }
        true =>
          match module_path_file_index_from_rows(rows: rows) {
            ModulePathFileIndexRefused { refusal: refusal } =>
              IdbBridgeIndexRefused { refusal: refusal }
            ModulePathFileIndexReady { entries: entries } =>
              match structural_binding_walk_selected_references(
                transport: t, inputs: i, references: selected,
              ) {
                StructuralBindingWalkRefused { refusal: refusal } =>
                  IdbBridgeWalkRefused { refusal: refusal }
                StructuralBindingWalkReady { population: population } =>
                  IdbBridgeProjected {
                    projection: reference_derived_dependency_projection(
                      population: population, module_files: entries,
                    ),
                  }
              }
          }
    }
  }
}

fn idb_bridge_for(
  consumer_path: String,
  provider_paths: List<String>,
  subject_names: List<String>,
  expected_references: Int
) -> IdbBridge {
  match idb_source_for_candidate(path: consumer_path) {
    Absent => IdbBridgeCandidateUnknown { file: consumer_path }
    Present { value: _ } =>
      match fold(provider_paths, init: none, f: (missing, p) =>
        match missing {
          Present { value: _ } => missing
          Absent =>
            match idb_source_for_candidate(path: p) {
              Absent => Present { value: p }
              Present { value: _ } => Absent
            }
        }) {
        Present { value: unknown } => IdbBridgeCandidateUnknown { file: unknown }
        Absent =>
          match first(idb_closure_row_for(path: consumer_path, grounding: ModuleLocalMemberExposure)) {
                Absent => IdbBridgeParseRefused { file: consumer_path }
                Present { value: consumer_row } =>
                  let provider_rows = fold(provider_paths, init: idb_no_closure_rows(), f: (acc, p) =>
                    concat(acc, idb_closure_row_for(path: p, grounding: CrossFileProviderExportedExposure)))
                  match length(provider_rows) == length(provider_paths) {
                    false => IdbBridgeParseRefused { file: idb_malformed_source_path }
                    true =>
                      idb_project_from_assembled(
                        closure: assemble_cross_file_binding_closure(
                          consumer: consumer_row, providers: provider_rows,
                        ),
                        subject_names: subject_names,
                        expected_references: expected_references,
                      )
                  }
              }
      }
  }
}

fn idb_supplied_bridge() -> IdbBridge {
  idb_bridge_for(
    consumer_path: idb_consumer_source_path,
    provider_paths: [idb_live_tree_source_path],
    subject_names: [idb_subject_name],
    expected_references: 2,
  )
}

fn idb_ready_projection(bridge: IdbBridge) -> ReferenceDerivedDependencyProjection? {
  match bridge {
    IdbBridgeProjected { projection: projection } => Present { value: projection }
    _ => none
  }
}

fn idb_provenances(bridge: IdbBridge) -> List<CrossFileBindingProvenance> {
  match bridge {
    IdbBridgeProjected {
      projection: ReferenceDerivedDependencyProjectionReady {
        binding_provenance: rows, file_dependencies: _, bound_population: _,
      },
    } => rows
    _ => []
  }
}

fn idb_file_dependencies(bridge: IdbBridge) -> List<DirectFileDependency> {
  match bridge {
    IdbBridgeProjected {
      projection: ReferenceDerivedDependencyProjectionReady {
        binding_provenance: _, file_dependencies: edges, bound_population: _,
      },
    } => edges
    _ => []
  }
}

fn idb_is_ready(bridge: IdbBridge) -> Bool {
  match bridge {
    IdbBridgeProjected {
      projection: ReferenceDerivedDependencyProjectionReady {
        binding_provenance: _, file_dependencies: _, bound_population: _,
      },
    } => true
    _ => false
  }
}

fn idb_population_refused_unbound(bridge: IdbBridge) -> Bool {
  match bridge {
    IdbBridgeProjected {
      projection: ReferenceDerivedDependencyProjectionBindingRefused { population: population },
    } =>
      match population {
        ReferencePopulationRefused { first_failure: failure, more_failures: _ } =>
          match failure {
            ReferenceBindingProjectionUnbound { occurrence: _ } => true
            _ => false
          }
        _ => false
      }
    _ => false
  }
}

test fn witness_import_less_reference_reaches_the_supplied_provider() -> Bool {
  match idb_supplied_bridge() {
    IdbBridgeProjected {
      projection: ReferenceDerivedDependencyProjectionReady {
        binding_provenance: rows, file_dependencies: _, bound_population: _,
      },
    } =>
      fold(rows, init: length(rows) == 2, f: (ok, row) =>
        ok && (row.provider_file as String) == idb_live_tree_source_path)
    _ => false
  }
}

test fn witness_consumer_carries_no_import_declaration() -> Bool {
  let source = idb_consumer_source()
  !string_contains(s: source, pattern: "import ")
    && string_contains(s: source, pattern: idb_subject_name)
}

test fn witness_consumer_mentions_the_subject_twice() -> Bool {
  length(idb_references_named_in_consumer(consumer_path: idb_consumer_source_path)) == 2
}

test fn witness_two_mentions_project_two_binding_provenance_rows() -> Bool {
  length(idb_provenances(bridge: idb_supplied_bridge())) == 2
}

test fn witness_provenance_rows_dedupe_to_one_provider_file_dependency() -> Bool {
  let edges = idb_file_dependencies(bridge: idb_supplied_bridge())
  match length(edges) == 1 {
    false => false
    true =>
      match first(edges) {
        Absent => false
        Present { value: edge } =>
          (edge.provider_file as String) == idb_live_tree_source_path
            && (edge.consumer_file as String) == idb_consumer_source_path
            && !((edge.consumer_file as String) == (edge.provider_file as String))
      }
  }
}

data idb_withheld_control_note: String = "THE WITHHELD-PROVIDER CONTROL, asserting a typed refusal rather than an empty result. The earlier version asserted zero provenance rows and zero edges, which is satisfied equally by a REFUSAL and by a successful projection that produced nothing -- and only the first is safe for a loader. This asserts the population is ReferencePopulationRefused with an Unbound first failure, and separately that the projection is NOT Ready, so an empty success cannot pass."

test fn witness_withheld_provider_refuses_as_unbound() -> Bool {
  let bridge = idb_bridge_for(
    consumer_path: idb_consumer_source_path, provider_paths: [],
    subject_names: [idb_subject_name], expected_references: 2,
  )
  idb_population_refused_unbound(bridge: bridge) && !idb_is_ready(bridge: bridge)
}

data idb_fail_open_regression_receipt: String = "MEASURED, BY REINSTATING THE DEFECT. The fail-open adapter this file used to contain was put back temporarily -- filter to Bound, hand-mint AllReferencesBound from the survivors -- and exactly TWO rows red: witness_withheld_provider_refuses_as_unbound and witness_partially_bound_population_refuses_whole. Every other row, INCLUDING the 2-provenance-to-1-edge pair, passed under the defect. That is the whole argument for these two controls: the positive law never detected the fail-open and never could, because a fabricated success is still a success. They are the executing evidence that the totality property holds, so they stay enrolled rather than retiring now that the adapter is gone (DESIGN section 4b(4))."

data idb_partial_population_note: String = "THE PLANTED PARTIAL POPULATION -- the control that catches the fail-open this file used to contain. The consumer requires TWO cross-module type references and only ONE provider is supplied, so one reference binds and the other cannot. The whole population must refuse. Under the discarded adapter this case emitted a provider-file edge from the single successful binding and read as a complete closure."

test fn witness_partially_bound_population_refuses_whole() -> Bool {
  let bridge = idb_bridge_for(
    consumer_path: idb_partial_consumer_source_path,
    provider_paths: [idb_live_tree_source_path],
    subject_names: [idb_subject_name, idb_missing_provider_name],
    expected_references: 3,
  )
  !idb_is_ready(bridge: bridge)
    && length(idb_provenances(bridge: bridge)) == 0
    && length(idb_file_dependencies(bridge: bridge)) == 0
}

data idb_pool_equality_note: String = "POOL INDEPENDENCE, asserted as an EQUALITY rather than as a still-passes. Adding an unrelated module to the candidate population must leave the binding identities and the edge set unchanged -- that is what distinguishes derivation from pool-membership coincidence, which is the failure mode this whole lane exists to eliminate. Asserting only that the positive still greens would not detect an edge set that grew."

fn idb_edge_key(edges: List<DirectFileDependency>) -> String {
  fold(edges, init: "", f: (acc, edge) =>
    acc + "|" + (edge.consumer_file as String) + ">" + (edge.provider_file as String))
}

fn idb_provenance_key(rows: List<CrossFileBindingProvenance>) -> String {
  fold(rows, init: "", f: (acc, row) =>
    acc + "|" + to_string(row.reference_occurrence.value) + ">" + to_string(row.declaration_occurrence.value))
}

test fn witness_unrelated_candidate_changes_nothing() -> Bool {
  let without = idb_supplied_bridge()
  let with_unrelated = idb_bridge_for(
    consumer_path: idb_consumer_source_path,
    provider_paths: [idb_live_tree_source_path, idb_unrelated_source_path],
    subject_names: [idb_subject_name],
    expected_references: 2,
  )
  idb_is_ready(bridge: without)
    && idb_is_ready(bridge: with_unrelated)
    && (idb_edge_key(edges: idb_file_dependencies(bridge: without)) ==
      idb_edge_key(edges: idb_file_dependencies(bridge: with_unrelated)))
    && (idb_provenance_key(rows: idb_provenances(bridge: without)) ==
      idb_provenance_key(rows: idb_provenances(bridge: with_unrelated)))
}

data idb_same_file_note: String = "SAME-FILE RULING, exercised rather than trusted. A consumer whose provider declaration lives in its OWN file must retain its binding provenance and emit NO file self-edge -- the carrier law says so, and a projection that emitted a self-edge would make every file depend on itself and defeat the closure."

test fn witness_same_file_binding_retains_provenance_without_self_edge() -> Bool {
  let bridge = idb_bridge_for(
    consumer_path: idb_same_file_source_path, provider_paths: [],
    subject_names: [idb_subject_name], expected_references: 2,
  )
  idb_is_ready(bridge: bridge)
    && length(idb_provenances(bridge: bridge)) == 2
    && length(idb_file_dependencies(bridge: bridge)) == 0
}

data idb_unknown_candidate_note: String = "A path absent from the candidate population REFUSES and is never resolved to provider contents by default. This is the control for the defaulting behaviour the candidate rows replaced: under the old path switch this call would have parsed the real provider's text under an unrelated storage path and bound successfully, which would make every later provider-discovery control meaningless."

test fn witness_unknown_candidate_path_refuses() -> Bool {
  match idb_bridge_for(
    consumer_path: idb_consumer_source_path,
    provider_paths: ["dag/test/fixture/import_deletion_bridge/never_declared.dag"],
    subject_names: [idb_subject_name],
    expected_references: 2,
  ) {
    IdbBridgeCandidateUnknown { file: f } =>
      f == "dag/test/fixture/import_deletion_bridge/never_declared.dag"
    _ => false
  }
}

data idb_malformed_note: String = "A malformed provider source must surface as a parse refusal, not as an absent provider. Collapsing it to `no providers` would make an unparseable file indistinguishable from one that was never offered, and the remedies differ."

test fn witness_malformed_provider_source_refuses() -> Bool {
  match idb_bridge_for(
    consumer_path: idb_consumer_source_path,
    provider_paths: [idb_malformed_source_path],
    subject_names: [idb_subject_name],
    expected_references: 2,
  ) {
    IdbBridgeParseRefused { file: _ } => true
    _ => false
  }
}

data idb_selection_note: String = "THE SELECTION REFUSAL. Asking for a reference count the fixture does not carry must refuse rather than proceed on whatever was found -- otherwise the multiplicity law restates its input instead of testing the projection."

test fn witness_reference_count_mismatch_refuses() -> Bool {
  match idb_bridge_for(
    consumer_path: idb_consumer_source_path,
    provider_paths: [idb_live_tree_source_path],
    subject_names: [idb_subject_name],
    expected_references: 3,
  ) {
    IdbBridgeSelectionRefused { observed: n } => n == 2
    _ => false
  }
}

data idb_ambiguity_note: String = "AMBIGUITY MUST NAME THE COMPETING DECLARATIONS. Two admissible providers each declare LiveTreeDisposition, so the reference has two candidates and cannot be bound. The requirement is not that the count is two -- two ambiguity outcomes with the same cardinality over different declarations are different states with different remedies -- so this asserts the EXACT declaration identities: the two candidate terminals differ from each other, and each is a declaration of this name present in the assembled transport.

The identities are available because the carrier was repaired to keep them. resolve_reference_occurrence_binding already returned OccurrenceAmbiguous { occurrence, candidates } and the projection discarded the candidates with `candidates: _`; it now carries the upstream AmbiguousBindingCandidates<OccurrenceId> itself, so this control reads production data rather than a local reconstruction."

fn idb_declaration_occurrences_named(
  transport: OccurrenceTransport,
  name: String
) -> List<OccurrenceId> {
  fold(transport.declarations, init: idb_no_occurrence_ids(), f: (acc, declaration) =>
    match idb_index_entry_for_occurrence(transport: transport, occurrence: declaration.occurrence) {
      Absent => acc
      Present { value: entry } =>
        match entry.projection.authored_name == name {
          true => concat(acc, [declaration.occurrence])
          false => acc
        }
    })
}

fn idb_no_occurrence_ids() -> List<OccurrenceId> { [] }

fn idb_occurrence_in(ids: List<OccurrenceId>, id: OccurrenceId) -> Bool {
  fold(ids, init: false, f: (found, candidate) => found || (candidate.value == id.value))
}

fn idb_ambiguity_candidates_for_two_providers() -> AmbiguousBindingCandidates<OccurrenceId>? {
  match idb_bridge_for(
    consumer_path: idb_consumer_source_path,
    provider_paths: [idb_live_tree_source_path, idb_second_provider_source_path],
    subject_names: [idb_subject_name],
    expected_references: 2,
  ) {
    IdbBridgeProjected {
      projection: ReferenceDerivedDependencyProjectionBindingRefused { population: population },
    } =>
      match population {
        ReferencePopulationRefused { first_failure: failure, more_failures: _ } =>
          match failure {
            ReferenceBindingProjectionAmbiguous { occurrence: _, candidates: candidates } =>
              Present { value: candidates }
            _ => none
          }
        _ => none
      }
    _ => none
  }
}

fn idb_two_provider_transport_declarations() -> List<OccurrenceId> {
  match first(idb_closure_row_for(path: idb_consumer_source_path, grounding: ModuleLocalMemberExposure)) {
    Absent => idb_no_occurrence_ids()
    Present { value: consumer_row } =>
      match assemble_cross_file_binding_closure(
        consumer: consumer_row,
        providers: concat(
          idb_closure_row_for(path: idb_live_tree_source_path, grounding: CrossFileProviderExportedExposure),
          idb_closure_row_for(path: idb_second_provider_source_path, grounding: CrossFileProviderExportedExposure),
        ),
      ) {
        AssembledCrossFileBindingClosureRefused { refusal: _ } => idb_no_occurrence_ids()
        AssembledCrossFileBindingClosureReady {
          transport: t, inputs: _, module_files: _, consumer_file: _,
        } => idb_declaration_occurrences_named(transport: t, name: idb_subject_name)
      }
  }
}

test fn witness_two_providers_refuse_as_ambiguous_naming_both_candidates() -> Bool {
  match idb_ambiguity_candidates_for_two_providers() {
    Absent => false
    Present { value: candidates } =>
      let first_id = candidates.first.containment.terminal
      let second_id = candidates.second.containment.terminal
      let declared = idb_two_provider_transport_declarations()
      !(first_id.value == second_id.value)
        && idb_occurrence_in(ids: declared, id: first_id)
        && idb_occurrence_in(ids: declared, id: second_id)
        && length(declared) == 2
  }
}

data idb_nested_rc_pattern_emitter_defect: String = "EMITTER DEFECT, located rather than routed around silently. The ambiguity control was first authored as one nested pattern -- ReferenceDerivedDependencyProjectionBindingRefused { population: ReferencePopulationRefused { first_failure } } -- which the v1 interpreter accepts and the Rust emitter lowers to `let ... = projection.as_ref()` matching an Rc<BoundReferencePopulation> field against a bare BoundReferencePopulation pattern (E0308, emitted at src/v1/stage0/src/v1_tests_claim_import_deletion_bridge_witness.rs). So a nested coproduct pattern through a reference-counted field does not survive emission, and regen --verify reports divergence 0 while the crate does not compile: byte-fidelity is not target-language validity.

It is written here as two sequential matches, which is semantically identical and is the idiom the surrounding corpus already uses. That is NOT a repair, and it is recorded rather than left implicit because the class is the open Rc wrap-decision lane, whose whole subject is that the emitter decides Rc wrapping without a structural predicate. This control is not the place to change a load-bearing emitter.

DISSOLVE-ON: the wrap-decision predicate lands and a nested pattern through an Rc field emits valid Rust; then this note deletes and the nesting may collapse back to one pattern."

data idb_module_storage_note: String = "MODULE-TO-FILE CONTRADICTIONS MUST REFUSE, not resolve to one of the two answers. Two candidate files declare the SAME module path, so the module-to-file index has no single answer for it. That is a contradiction about storage, and either arm that catches it is a typed refusal -- what may never happen is a successful projection that silently picked a file, because the loader would then bring in one home and ignore the other.

WHICH stage refuses is measured, not assumed: closure ASSEMBLY refuses, before the module-to-file index is ever built by this file, because assembly validates the accumulated rows itself. A first version of this control tolerated either that arm or an index refusal, which is a two-answer assertion -- it would have passed had the contradiction moved between the two stages, and it would not have said which stage held the line. Narrowing it to the arm that actually fires required a second repair of the same information-discarding class the ambiguity carrier had: this file was collapsing the assembly refusal to a bare marker, so the exact contradiction was unavailable to assert. It now carries AssembledCrossFileBindingClosureRefusal through, and this row names the module path and both competing files."

test fn witness_conflicting_module_storage_refuses() -> Bool {
  let bridge = idb_bridge_for(
    consumer_path: idb_consumer_source_path,
    provider_paths: [idb_live_tree_source_path, idb_conflicting_source_path],
    subject_names: [idb_subject_name],
    expected_references: 2,
  )
  match bridge {
    IdbBridgeAssemblyRefused { refusal: refusal } =>
      match refusal {
        AssembledCrossFileBindingClosureModulePathFileRefused { refusal: index_refusal } =>
          match index_refusal {
            ModulePathFileConflict { module_path: m, first_file: a, second_file: b } =>
              (m as String) == idb_provider_module_name
                && !((a as String) == (b as String))
                && ((a as String) == idb_live_tree_source_path
                  || (a as String) == idb_conflicting_source_path)
                && ((b as String) == idb_live_tree_source_path
                  || (b as String) == idb_conflicting_source_path)
            _ => false
          }
      }
    _ => false
  }
}

data idb_missing_storage_note: String = "A MISSING module-to-file row must surface as a file-projection refusal, not as a dropped edge. This control supplies the production projection with an index from which the provider module's row has been REMOVED, so the binding succeeds and only the storage join fails -- which is exactly the state where an implementation that silently omitted the edge would under-load the closure while reporting success."

fn idb_index_without_provider_module() -> Map<String, FilePath>? {
  match first(idb_closure_row_for(path: idb_consumer_source_path, grounding: ModuleLocalMemberExposure)) {
    Absent => none
    Present { value: consumer_row } =>
      match assemble_cross_file_binding_closure(
        consumer: consumer_row,
        providers: idb_closure_row_for(
          path: idb_live_tree_source_path, grounding: CrossFileProviderExportedExposure,
        ),
      ) {
        AssembledCrossFileBindingClosureRefused { refusal: _ } => none
        AssembledCrossFileBindingClosureReady {
          transport: _, inputs: _, module_files: rows, consumer_file: _,
        } =>
          Present {
            value: fold(rows, init: empty_map(), f: (acc, row) =>
              match (row.module_path as String) == idb_provider_module_name {
                true => acc
                false => map_insert(acc, row.module_path as String, row.file_path)
              }),
          }
      }
  }
}

fn idb_population_for_supplied_provider() -> BoundReferencePopulation? {
  match first(idb_closure_row_for(path: idb_consumer_source_path, grounding: ModuleLocalMemberExposure)) {
    Absent => none
    Present { value: consumer_row } =>
      match assemble_cross_file_binding_closure(
        consumer: consumer_row,
        providers: idb_closure_row_for(
          path: idb_live_tree_source_path, grounding: CrossFileProviderExportedExposure,
        ),
      ) {
        AssembledCrossFileBindingClosureRefused { refusal: _ } => none
        AssembledCrossFileBindingClosureReady {
          transport: t, inputs: i, module_files: _, consumer_file: _,
        } =>
          match structural_binding_walk_selected_references(
            transport: t, inputs: i,
            references: idb_references_in_names(transport: t, names: [idb_subject_name]),
          ) {
            StructuralBindingWalkRefused { refusal: _ } => none
            StructuralBindingWalkReady { population: population } => Present { value: population }
          }
      }
  }
}

test fn witness_missing_provider_module_storage_row_refuses_file_projection() -> Bool {
  match idb_population_for_supplied_provider() {
    Absent => false
    Present { value: population } =>
      match idb_index_without_provider_module() {
        Absent => false
        Present { value: pruned } =>
          match reference_derived_dependency_projection(
            population: population, module_files: pruned,
          ) {
            ReferenceDerivedDependencyProjectionFileRefused {
              first_failure: _, more_failures: _,
            } => true
            _ => false
          }
      }
  }
}
