module v1.tests.claim.occurrence_binding_parser_walk_witness_test



data occurrence_binding_parser_walk_witness_note: String = "Parser integration witness (namespace-reference-derived-closure merge bar): every case begins at authored source, reaches the P2 structural walk through v1.compiler.parse.parse_with_table transport only — no hand-constructed OccurrenceTransport. Case 6 discharges projection law (A) only: repeated bound-reference providers for one declaration project to one DirectModuleDependency edge — not identity collapse, collector deduplication, or section-13 repeated-discovery collapse. Collector re-observation dedup (B) stays a distinct deferred debt on ProductionOccurrenceCollectorMissing. Case 7 parses once in one graph scope, preserves the parser-minted reference occurrence on the positive arm, and substitutes an occurrence id unknown within that same transport on the negative arm — never comparing allocator-local OccurrenceId values across standalone parses."

data occurrence_binding_parser_walk_offline_recipe: String = "OFFLINE LOCAL RECIPE (requires v1 parser pool): target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/occurrence_binding_parser_walk_witness_test.dag --functions namespace_reference_derived_closure_parser_integration_holds"

type ObcpwParsed
  = ObcpwParsedReady {
      transport: std.occurrence_identity.OccurrenceTransport,
      inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
      module_path: std.types.NonEmptyStr,
    }
  | ObcpwParsedRefused

fn obcpw_parse(file: String, source: String) -> ObcpwParsed {
  match parse_authored_occurrence_binding_source(file: file, source: source) {
    ParsedOccurrenceBindingSourceRefused => ObcpwParsedRefused
    ParsedOccurrenceBindingSourceReady { transport: transport, module_path: module_path } =>
      ObcpwParsedReady {
        transport: transport,
        module_path: module_path,
        inputs: occurrence_binding_inputs_from_transport(
          module_path: module_path,
          transport: transport,
        ),
      }
  }
}

fn obcpw_same_module(left: std.types.NonEmptyStr, right: std.types.NonEmptyStr) -> Bool {
  left == right
}

fn obcpw_module_sibling_source() -> String {
  "module app.sibling_module\n\nfn fn_a() -> Int {\n  10\n}\n\nfn fn_b() -> Int {\n  fn_a()\n}\n"
}

fn obcpw_pattern_arm_source() -> String {
  "module app.pattern_arm_module\n\ntype Side = Left { n: Int } | Right { n: Int }\n\nfn demo(t: Side) -> Int {\n  match t {\n    Left { n: x } => {\n      x + 1\n    }\n    Right { n: x } => {\n      x\n    }\n  }\n}\n"
}

fn obcpw_nested_lexical_source() -> String {
  "module app.block_module\n\nfn outer() -> Int {\n  let x = 1\n  x\n}\n\nfn inner() -> Int {\n  x\n}\n"
}

fn obcpw_source_order_source() -> String {
  "module app.order_module\n\nfn demo() -> Int {\n  fn_later()\n}\n\nfn fn_later() -> Int {\n  0\n}\n"
}

fn obcpw_ambiguous_source() -> String {
  "module app.ambiguous_module\n\nfn helper() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  1\n}\n\nfn demo() -> Int {\n  helper()\n}\n"
}

fn obcpw_greeter_source() -> String {
  "module gunbc.example.greeter\n\nfn format_greeting() -> String {\n  \"hi\"\n}\n\nfn greet() -> String {\n  format_greeting()\n}\n\nfn greet_again() -> String {\n  format_greeting()\n}\n"
}

fn obcpw_declarations_named(
  transport: std.occurrence_identity.OccurrenceTransport,
  name: String
) -> List<std.occurrence_identity.DeclarationOccurrence> {
  fold(
    transport.declarations,
    init: [],
    f: (acc, declaration) =>
      match index_entry_for_declaration(transport: transport, declaration: declaration) {
        Absent => acc
        Present { value: entry } =>
          match entry.projection.authored_name == name {
            true => concat(acc, [declaration])
            false => acc
          }
      },
  )
}

fn index_entry_for_declaration(
  transport: std.occurrence_identity.OccurrenceTransport,
  declaration: std.occurrence_identity.DeclarationOccurrence
) -> std.occurrence_identity.OccurrenceIndexEntry? {
  fold(
    transport.index.entries,
    init: none,
    f: (found, entry) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match entry.projection.occurrence.value == declaration.occurrence.value {
            true => Present { value: entry }
            false => Absent
          }
      },
  )
}

fn obcpw_references_named(
  transport: std.occurrence_identity.OccurrenceTransport,
  name: String
) -> List<std.occurrence_identity.ReferenceOccurrence> {
  fold(
    transport.references,
    init: [],
    f: (acc, reference) =>
      match index_entry_for_reference(transport: transport, reference: reference) {
        Absent => acc
        Present { value: entry } =>
          match entry.projection.authored_name == name {
            true => concat(acc, [reference])
            false => acc
          }
      },
  )
}

fn index_entry_for_reference(
  transport: std.occurrence_identity.OccurrenceTransport,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> std.occurrence_identity.OccurrenceIndexEntry? {
  fold(
    transport.index.entries,
    init: none,
    f: (found, entry) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match entry.projection.occurrence.value == reference.occurrence.value {
            true => Present { value: entry }
            false => Absent
          }
      },
  )
}

fn obcpw_reference_binds_to_declaration(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
  reference: std.occurrence_identity.ReferenceOccurrence,
  declaration: std.occurrence_identity.DeclarationOccurrence
) -> Bool {
  match resolve_reference_binding_via_structural_candidates(
    transport: transport,
    inputs: inputs,
    reference: reference,
  ) {
    ReferenceBindingProjectionBound { provider: provider } =>
      provider.declaration_occurrence.value == declaration.occurrence.value
    _ => false
  }
}

fn obcpw_reference_with_occurrence(
  reference: std.occurrence_identity.ReferenceOccurrence,
  occurrence: std.occurrence_identity.OccurrenceId
) -> std.occurrence_identity.ReferenceOccurrence {
  ReferenceOccurrence {
    occurrence: occurrence,
    containment: reference.containment,
    category: reference.category,
    diagnostic_span: reference.diagnostic_span,
  }
}

fn obcpw_reference_unbound_exactly(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> Bool {
  match resolve_reference_binding_via_structural_candidates(
    transport: transport,
    inputs: inputs,
    reference: reference,
  ) {
    ReferenceBindingProjectionUnbound { occurrence: unbound } =>
      unbound.value == reference.occurrence.value
    _ => false
  }
}

fn obcpw_unknown_occurrence_transport_refuses(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> Bool {
  match resolve_reference_binding_via_structural_candidates(
    transport: transport,
    inputs: inputs,
    reference: reference,
  ) {
    ReferenceBindingProjectionTransportRefused { refusal: _ } => true
    _ => false
  }
}

fn obcpw_candidate_ids_distinct(candidates: List<std.occurrence_identity.OccurrenceId>) -> Bool {
  match candidates |> first {
    Absent => false
    Present { value: first } =>
      match candidates |> reverse |> first {
        Absent => false
        Present { value: second } => first.value != second.value
      }
  }
}

test fn parser_module_sibling_visible_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-sibling.dag",
    source: obcpw_module_sibling_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: module_path } =>
      match reference_named(transport: transport, name: "fn_a") {
        Absent => false
        Present { value: reference } =>
          match resolve_reference_binding_via_structural_candidates(
            transport: transport,
            inputs: inputs,
            reference: reference,
          ) {
            ReferenceBindingProjectionBound { provider: provider } =>
              match occurrence_id_for_authored_name(transport: transport, name: "fn_a") {
                Present { value: fn_a_id } =>
                  provider.declaration_occurrence.value == fn_a_id.value
                    && provider.reference_occurrence.value == reference.occurrence.value
                    && obcpw_same_module(left: provider.consumer_module, right: module_path)
                    && obcpw_same_module(left: provider.provider_module, right: module_path)
                Absent => false
              }
            _ => false
          }
      }
  }
}

data parser_sibling_match_arm_pattern_binder_holds_note: String = "PARKED on B1 rollup: the §13 sibling-arm rule is discharged by occurrence_binding_candidates_witness (hand-built transport where the arm-body reference nests under the binder occurrence). Real v1.parse containment stamps match-arm bodies as siblings of pattern binders, not descendants, so containment-derived LexicalExposure cannot isolate arms from authored source alone. Dissolve-on: parser nests arm-body references under pattern-binder occurrences (or an equivalent exposure derivation that does not require that nesting) — then re-enroll this test in namespace_reference_derived_closure_parser_integration_holds."

test fn parser_sibling_match_arm_pattern_binder_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-pattern-arm.dag",
    source: obcpw_pattern_arm_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: _ } =>
      let x_declarations = obcpw_declarations_named(transport: transport, name: "x")
      let x_references = obcpw_references_named(transport: transport, name: "x")
      (x_declarations |> count) == 2
        && (x_references |> count) == 2
        && match x_declarations |> first {
          Present { value: arm_one_x } =>
            match x_declarations |> reverse |> first {
              Present { value: arm_two_x } =>
                arm_one_x.occurrence.value != arm_two_x.occurrence.value
                  && match x_references |> first {
                    Present { value: arm_one_ref } =>
                      match x_references |> reverse |> first {
                        Present { value: arm_two_ref } =>
                          obcpw_reference_binds_to_declaration(
                            transport: transport,
                            inputs: inputs,
                            reference: arm_one_ref,
                            declaration: arm_one_x,
                          )
                            && obcpw_reference_binds_to_declaration(
                              transport: transport,
                              inputs: inputs,
                              reference: arm_two_ref,
                              declaration: arm_two_x,
                            )
                            && !obcpw_reference_binds_to_declaration(
                              transport: transport,
                              inputs: inputs,
                              reference: arm_two_ref,
                              declaration: arm_one_x,
                            )
                        Absent => false
                      }
                    Absent => false
                  }
              Absent => false
            }
          Absent => false
        }
  }
}

test fn parser_nested_lexical_only_inside_scope_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-nested-lexical.dag",
    source: obcpw_nested_lexical_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: _ } =>
      let x_declarations = obcpw_declarations_named(transport: transport, name: "x")
      let x_references = obcpw_references_named(transport: transport, name: "x")
      (x_declarations |> count) == 1
        && (x_references |> count) == 2
        && match x_declarations |> first {
          Present { value: outer_x } =>
            match x_references |> first {
              Present { value: outer_ref } =>
                match x_references |> reverse |> first {
                  Present { value: inner_ref } =>
                    obcpw_reference_binds_to_declaration(
                      transport: transport,
                      inputs: inputs,
                      reference: outer_ref,
                      declaration: outer_x,
                    )
                      && match resolve_reference_binding_via_structural_candidates(
                        transport: transport,
                        inputs: inputs,
                        reference: inner_ref,
                      ) {
                        ReferenceBindingProjectionUnbound { occurrence: unbound } =>
                          unbound.value == inner_ref.occurrence.value
                        _ => false
                      }
                      && !obcpw_reference_binds_to_declaration(
                        transport: transport,
                        inputs: inputs,
                        reference: inner_ref,
                        declaration: outer_x,
                      )
                  Absent => false
                }
              Absent => false
            }
          Absent => false
        }
  }
}

test fn parser_declaration_below_occurrence_not_visible_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-source-order.dag",
    source: obcpw_source_order_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: _ } =>
      match reference_named(transport: transport, name: "fn_later") {
        Absent => false
        Present { value: reference } =>
          match resolve_reference_binding_via_structural_candidates(
            transport: transport,
            inputs: inputs,
            reference: reference,
          ) {
            ReferenceBindingProjectionUnbound { occurrence: unbound } =>
              unbound.value == reference.occurrence.value
            _ => false
          }
      }
  }
}

test fn parser_same_text_distinct_identities_ambiguous_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-ambiguous.dag",
    source: obcpw_ambiguous_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: _ } =>
      match reference_named(transport: transport, name: "helper") {
        Absent => false
        Present { value: reference } =>
          match occurrence_candidate_index_build(transport: transport, inputs: inputs) {
            OccurrenceCandidateIndexReady { index: index } =>
              let candidates = candidate_occurrence_ids_for_reference(
                index: index,
                reference: reference,
              )
              (candidates |> count) == 2
                && obcpw_candidate_ids_distinct(candidates: candidates)
                && match resolve_reference_binding_via_structural_candidates(
                  transport: transport,
                  inputs: inputs,
                  reference: reference,
                ) {
                  ReferenceBindingProjectionAmbiguous { occurrence: ambiguous } =>
                    ambiguous.value == reference.occurrence.value
                  _ => false
                }
            _ => false
          }
      }
  }
}

data parser_repeated_bindings_projection_law_note: String = "Case 6 — projection law (A) under the same-module ruling (slice A / PR 7515): two BoundReferenceProvider rows for one declaration (greet + greet_again → format_greeting) are retained; DirectModuleDependency emits NO M→M self-edge from those providers (edges count 0). Uses per-reference resolve — not structural_binding_walk over the whole transport — so incidental unbound type/name refs in the fixture cannot refuse the population. Cross-module one-edge dedup stays a distinct fixture when a multi-module authored source is available. Does NOT discharge Section13RepeatedDiscoverySameIdentityCollapse; collector re-observation dedup (B) remains deferred on ProductionOccurrenceCollectorMissing."

data parser_transport_scoped_identity_note: String = "Case 7 — single parse in one graph scope. Positive arm preserves the parser-minted reference occurrence; negative arm substitutes an occurrence id unknown within that same transport. OccurrenceId integers are allocator-local and must not be compared across standalone parses."

fn obcpw_bound_providers_named(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
  name: String
) -> List<std.occurrence_binding_candidates.BoundReferenceProvider> {
  reverse(fold(
    obcpw_references_named(transport: transport, name: name),
    init: [],
    f: (acc, reference) =>
      match resolve_reference_binding_via_structural_candidates(
        transport: transport,
        inputs: inputs,
        reference: reference,
      ) {
        ReferenceBindingProjectionBound { provider: provider } =>
          concat([provider], acc)
        _ => acc
      },
  ))
}

test fn parser_repeated_bindings_project_one_module_edge_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-greeter.dag",
    source: obcpw_greeter_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: module_path } =>
      match occurrence_id_for_authored_name(transport: transport, name: "format_greeting") {
        Absent => false
        Present { value: format_greeting_id } =>
          let providers = obcpw_bound_providers_named(
            transport: transport,
            inputs: inputs,
            name: "format_greeting",
          )
          (providers |> count) == 2
            && match providers |> first {
              Present { value: first } =>
                first.declaration_occurrence.value == format_greeting_id.value
                  && obcpw_same_module(left: first.consumer_module, right: module_path)
                  && obcpw_same_module(left: first.provider_module, right: module_path)
              Absent => false
            }
            && match direct_module_dependencies_from_bound_population(
              population: std.occurrence_binding_candidates.AllReferencesBound { providers: providers },
            ) {
              DirectModuleDependencyListReady { edges: edges } =>
                (edges |> count) == 0
              _ => false
            }
      }
  }
}

test fn parser_transport_scoped_preserved_identity_and_unknown_occurrence_refuses_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-identity.dag",
    source: obcpw_greeter_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: _ } =>
      match reference_named(transport: transport, name: "format_greeting") {
        Absent => false
        Present { value: format_reference } =>
          match occurrence_id_for_authored_name(transport: transport, name: "format_greeting") {
            Present { value: format_greeting_id } =>
              let preserved = obcpw_reference_with_occurrence(
                reference: format_reference,
                occurrence: format_reference.occurrence,
              )
              let unknown = obcpw_reference_with_occurrence(
                reference: format_reference,
                occurrence: std.occurrence_identity.OccurrenceId { value: 999999 },
              )
              match resolve_reference_binding_via_structural_candidates(
                transport: transport,
                inputs: inputs,
                reference: preserved,
              ) {
                ReferenceBindingProjectionBound { provider: provider } =>
                  provider.reference_occurrence.value == format_reference.occurrence.value
                    && provider.declaration_occurrence.value == format_greeting_id.value
                _ => false
              }
                && obcpw_unknown_occurrence_transport_refuses(
                  transport: transport,
                  inputs: inputs,
                  reference: unknown,
                )
            Absent => false
          }
      }
  }
}

test fn parser_production_call_binds_with_edge_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-production.dag",
    source: obcpw_greeter_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: module_path } =>
      match reference_named(transport: transport, name: "format_greeting") {
        Absent => false
        Present { value: reference } =>
          match resolve_reference_binding_via_structural_candidates(
            transport: transport,
            inputs: inputs,
            reference: reference,
          ) {
            ReferenceBindingProjectionBound { provider: provider } =>
              match occurrence_id_for_authored_name(transport: transport, name: "format_greeting") {
                Present { value: format_greeting_id } =>
                  provider.reference_occurrence.value == reference.occurrence.value
                    && provider.declaration_occurrence.value == format_greeting_id.value
                    && obcpw_same_module(left: provider.consumer_module, right: module_path)
                    && obcpw_same_module(left: provider.provider_module, right: module_path)
                    && match direct_module_dependencies_from_bound_population(
                      population: std.occurrence_binding_candidates.AllReferencesBound { providers: [provider] },
                    ) {
                      DirectModuleDependencyListReady { edges: edges } =>
                        (edges |> count) == 0
                      _ => false
                    }
                Absent => false
              }
            _ => false
          }
      }
  }
}

fn obcpw_declaration_for_occurrence(
  transport: std.occurrence_identity.OccurrenceTransport,
  occurrence: std.occurrence_identity.OccurrenceId
) -> std.occurrence_identity.DeclarationOccurrence? {
  fold(
    transport.declarations,
    init: none,
    f: (found, declaration) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match declaration.occurrence.value == occurrence.value {
            true => Present { value: declaration }
            false => Absent
          }
      },
  )
}

fn obcpw_inputs_with_lexical_fn_a(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs
) -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  match occurrence_id_for_authored_name(transport: transport, name: "fn_a") {
    Absent => inputs
    Present { value: fn_a_id } =>
      match obcpw_declaration_for_occurrence(transport: transport, occurrence: fn_a_id) {
        Absent => inputs
        Present { value: fn_a_declaration } =>
          OccurrenceBindingCandidateInputs {
            module_paths: inputs.module_paths,
            authored_order_rows: inputs.authored_order_rows,
            exposure_rows: reverse(fold(
              inputs.exposure_rows,
              init: [],
              f: (acc, row) =>
                match row.occurrence.value == fn_a_id.value {
                  true =>
                    concat([
                      DeclarationExposureRow {
                        occurrence: row.occurrence,
                        exposure: std.occurrence_binding_candidates.LexicalExposure {
                          exposing_scope: fn_a_declaration.containment,
                        },
                      },
                    ], acc)
                  false => concat([row], acc)
                },
            )),
          }
      }
  }
}

fn obcpw_inputs_without_fn_a_exposure(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs
) -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  match occurrence_id_for_authored_name(transport: transport, name: "fn_a") {
    Absent => inputs
    Present { value: fn_a_id } =>
      OccurrenceBindingCandidateInputs {
        module_paths: inputs.module_paths,
        authored_order_rows: inputs.authored_order_rows,
        exposure_rows: fold(
          inputs.exposure_rows,
          init: [],
          f: (acc, row) =>
            match row.occurrence.value == fn_a_id.value {
              true => acc
              false => concat([row], acc),
            },
        ) |> reverse,
      }
  }
}

fn obcpw_inputs_without_reference_authored_order(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  OccurrenceBindingCandidateInputs {
    module_paths: inputs.module_paths,
    exposure_rows: inputs.exposure_rows,
    authored_order_rows: fold(
      inputs.authored_order_rows,
      init: [],
      f: (acc, row) =>
        match row.occurrence.value == reference.occurrence.value {
          true => acc
          false => concat([row], acc),
        },
    ) |> reverse,
  }
}

data occurrence_binding_parser_walk_exact_red_note: String = "Blocker 5: each negative control asserts its exact typed outcome — remove ModuleExposure-equivalent by dropping the declaration exposure row => MissingDeclarationExposure for that declaration; drop the reference AuthoredOrderRow => MissingAuthoredOrderRow for that occurrence; wrong LexicalExposure on a module sibling => Unbound for the exact reference; unknown OccurrenceId => TransportRefused. Never accept anything-except-Bound."

test fn parser_module_sibling_without_module_exposure_reds() -> Bool {
  match obcpw_parse(
    file: "obcpw-sibling-red.dag",
    source: obcpw_module_sibling_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: _ } =>
      match reference_named(transport: transport, name: "fn_a") {
        Absent => false
        Present { value: reference } =>
          obcpw_reference_unbound_exactly(
            transport: transport,
            inputs: obcpw_inputs_with_lexical_fn_a(transport: transport, inputs: inputs),
            reference: reference,
          )
      }
  }
}

test fn parser_missing_declaration_exposure_refuses_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-missing-exposure.dag",
    source: obcpw_module_sibling_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: _ } =>
      match occurrence_id_for_authored_name(transport: transport, name: "fn_a") {
        Absent => false
        Present { value: fn_a_id } =>
          match reference_named(transport: transport, name: "fn_a") {
            Absent => false
            Present { value: reference } =>
              match resolve_reference_binding_via_structural_candidates(
                transport: transport,
                inputs: obcpw_inputs_without_fn_a_exposure(
                  transport: transport,
                  inputs: inputs,
                ),
                reference: reference,
              ) {
                ReferenceBindingProjectionExposureRefused {
                  refusal: MissingDeclarationExposure { occurrence: missing },
                } => missing.value == fn_a_id.value
                _ => false
              }
                && match structural_binding_walk(
                  transport: transport,
                  inputs: obcpw_inputs_without_fn_a_exposure(
                    transport: transport,
                    inputs: inputs,
                  ),
                ) {
                  StructuralBindingWalkRefused { refusal: walk_refusal } =>
                    match walk_refusal {
                      StructuralBindingExposureRefusal { refusal: exposure_refusal } =>
                        match exposure_refusal {
                          MissingDeclarationExposure { occurrence: missing } =>
                            missing.value == fn_a_id.value
                          _ => false
                        }
                      _ => false
                    }
                  _ => false
                }
          }
      }
  }
}

test fn parser_missing_authored_order_refuses_holds() -> Bool {
  match obcpw_parse(
    file: "obcpw-missing-order.dag",
    source: obcpw_source_order_source(),
  ) {
    ObcpwParsedRefused => false
    ObcpwParsedReady { transport: transport, inputs: inputs, module_path: _ } =>
      match reference_named(transport: transport, name: "fn_later") {
        Absent => false
        Present { value: reference } =>
          match resolve_reference_binding_via_structural_candidates(
            transport: transport,
            inputs: obcpw_inputs_without_reference_authored_order(
              transport: transport,
              inputs: inputs,
              reference: reference,
            ),
            reference: reference,
          ) {
            ReferenceBindingProjectionAuthoredOrderRefused {
              refusal: MissingAuthoredOrderRow { occurrence: missing },
            } => missing.value == reference.occurrence.value
            _ => false
          }
            && match structural_binding_walk(
              transport: transport,
              inputs: obcpw_inputs_without_reference_authored_order(
                transport: transport,
                inputs: inputs,
                reference: reference,
              ),
            ) {
              StructuralBindingWalkRefused { refusal: walk_refusal } =>
                match walk_refusal {
                  StructuralBindingAuthoredOrderRefusal { refusal: order_refusal } =>
                    match order_refusal {
                      MissingAuthoredOrderRow { occurrence: missing } =>
                        missing.value == reference.occurrence.value
                      _ => false
                    }
                  _ => false
                }
              _ => false
            }
      }
  }
}

test fn namespace_reference_derived_closure_parser_integration_holds() -> Bool {
  parser_module_sibling_visible_holds()
    && parser_nested_lexical_only_inside_scope_holds()
    && parser_declaration_below_occurrence_not_visible_holds()
    && parser_same_text_distinct_identities_ambiguous_holds()
    && parser_repeated_bindings_project_one_module_edge_holds()
    && parser_transport_scoped_preserved_identity_and_unknown_occurrence_refuses_holds()
    && parser_production_call_binds_with_edge_holds()
    && parser_module_sibling_without_module_exposure_reds()
    && parser_missing_declaration_exposure_refuses_holds()
    && parser_missing_authored_order_refuses_holds()
}

data occurrence_binding_parser_walk_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "DISSOLVE-ON: witness_layer_roots admits src/v1 for parser-transport witnesses without Node ambiguity, or execution corpus carries per-entry source roots — then this recipe deletes and discovery enrollment suffices.")
