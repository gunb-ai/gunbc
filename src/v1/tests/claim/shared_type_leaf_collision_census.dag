module v1.tests.claim.shared_type_leaf_collision_census

import v1.compiler.compile { SourceFile, compile_to_resolved }
import v1.compiler.infer { build_emit_graph_info }
import v1.compiler.infer_items { ResolvedGraph }
import v1.compiler.infer_emit_info {
  EmitGraphInfo, TypeSummary, TypeDeclIndex,
  TypeSummaryFound, TypeSummaryNotDeclared, TypeSummaryLeafAmbiguous,
  type_decl_identities_of_leaf, type_summary_at_key
}
import v1.compiler.emit_rust { maybe_mark_shared_type, merged_module_source_indices }
import v1.compiler.languages { sharing_for_target }
import v1.compiler.artifact { Rust }
import std.types { List, String, Bool }

// THE SHARED-TYPE SET IS KEYED ON DECLARATION IDENTITY (v1.compiler.emit_rust build_shared_types,
// TypeSummary.key). This module owns the leaf-name COINCIDENCE of two identities in one emitted
// closure, and the SUBJECT-GRAIN rustc build of that closure. Independent sharing is
// maybe_mark_shared_type per declaration. Two identities that share a leaf are not a collision:
// they build independently. rustc is one cargo run per subject, never stamped onto every
// different-sharing row.
//
// EmitGraphInfo.recursive_type_set is leaf-keyed last-write-wins. When a coinciding leaf is in
// that set, this module does not report SameSharing/DifferentSharing from it:
// SharingUndeterminedByDeclaration.
//
// compile_to_resolved over an authored source vector is called from the host.

type CollisionSharing
  = SameSharing
  | DifferentSharing
  | SharingUndeterminedByDeclaration

type SubjectBuild
  = BuildAccepted
  | BuildRefused { diagnostic: String }
  | BuildNotAttempted

type LeafCollisionRow {
  leaf: String
  declarers: List<String>
  would_share: List<Bool>
  sharing: CollisionSharing
}

type SubjectCollisionReport {
  rows: List<LeafCollisionRow>
  build: SubjectBuild
}

fn collision_sharing_of(would_share: List<Bool>) -> CollisionSharing {
  match would_share |> first {
    Absent => SameSharing
    Present { value: first_share } =>
      if (would_share |> any(s => s != first_share)) { DifferentSharing } else { SameSharing }
  }
}

fn sharing_of_collision(leaf: String, would_share: List<Bool>, recursive_type_set: Set<String>) -> CollisionSharing {
  if set_contains(recursive_type_set, leaf) {
    SharingUndeterminedByDeclaration
  } else {
    collision_sharing_of(would_share: would_share)
  }
}

fn leaf_collision_row(leaf: String, declarers: List<String>, would_share: List<Bool>, sharing: CollisionSharing) -> LeafCollisionRow {
  LeafCollisionRow {
    leaf: leaf
    declarers: declarers
    would_share: would_share
    sharing: sharing
  }
}

fn declaration_would_share(summary: TypeSummary, recursive_type_set: Set<String>, needs_sharing: Bool, type_decl_items: TypeDeclIndex, source_indices: Map<String, NewlineIndex>) -> Bool {
  set_contains(maybe_mark_shared_type(acc: empty_set(), summary: summary, recursive_type_set: recursive_type_set, target_needs_sharing: needs_sharing, type_decl_items: type_decl_items, source_indices: source_indices), summary.key)
}

fn would_share_of_identity(info: EmitGraphInfo, identity: String, needs_sharing: Bool, source_indices: Map<String, NewlineIndex>) -> Bool {
  match type_summary_at_key(index: info.type_summaries, key: identity) {
    TypeSummaryFound { summary: summary } =>
      declaration_would_share(summary: summary, recursive_type_set: info.recursive_type_set, needs_sharing: needs_sharing, type_decl_items: info.type_decl_items, source_indices: source_indices)
    TypeSummaryNotDeclared => false
    TypeSummaryLeafAmbiguous { leaf: _ } => false
  }
}

fn collision_row_of_leaf(info: EmitGraphInfo, leaf: String, needs_sharing: Bool, source_indices: Map<String, NewlineIndex>) -> LeafCollisionRow? {
  let declarers = type_decl_identities_of_leaf(index: info.type_decl_items, leaf: leaf) |> sort_by(i => i)
  if (declarers |> count) < 2 {
    none
  } else {
    let would_share = declarers |> map(identity => would_share_of_identity(info: info, identity: identity, needs_sharing: needs_sharing, source_indices: source_indices))
    Present {
      value: leaf_collision_row(leaf: leaf, declarers: declarers, would_share: would_share, sharing: sharing_of_collision(leaf: leaf, would_share: would_share, recursive_type_set: info.recursive_type_set))
    }
  }
}

fn collisions_of_graph(graph: ResolvedGraph) -> List<LeafCollisionRow> {
  let info = build_emit_graph_info(modules: graph.modules, registry: graph.item_registry)
  let source_indices = merged_module_source_indices(modules: graph.modules)
  let needs_sharing = sharing_for_target(target: Rust).needs_sharing
  map_keys(info.type_decl_items.identities_by_leaf)
    |> sort_by(k => k)
    |> fold(init: [], f: (acc, leaf) =>
      match collision_row_of_leaf(info: info, leaf: leaf, needs_sharing: needs_sharing, source_indices: source_indices) {
        Absent => acc
        Present { value: row } => list_push(acc, row)
      }
    )
}

fn collisions_from_sources(sources: List<SourceFile>) -> List<LeafCollisionRow>? {
  let result = compile_to_resolved(sources: sources)
  match result.graph {
    Absent => none
    Present { value: graph } => Present { value: collisions_of_graph(graph: graph) }
  }
}

fn subject_report(rows: List<LeafCollisionRow>, build: SubjectBuild) -> SubjectCollisionReport {
  SubjectCollisionReport { rows: rows, build: build }
}

fn build_accepted() -> SubjectBuild {
  BuildAccepted
}

fn build_refused(diagnostic: String) -> SubjectBuild {
  BuildRefused { diagnostic: diagnostic }
}

fn build_not_attempted() -> SubjectBuild {
  BuildNotAttempted
}

fn report_has_different_sharing(report: SubjectCollisionReport) -> Bool {
  report.rows |> any(r =>
    match r.sharing {
      DifferentSharing => true
      SameSharing => false
      SharingUndeterminedByDeclaration => false
    }
  )
}

fn report_has_no_collision(report: SubjectCollisionReport) -> Bool {
  (report.rows |> count) == 0
}

fn different_sharing_build_accepted(report: SubjectCollisionReport) -> Bool {
  match report.build {
    BuildAccepted => report_has_different_sharing(report: report)
    BuildRefused { diagnostic: _ } => false
    BuildNotAttempted => false
  }
}

fn report_has_undetermined_sharing(report: SubjectCollisionReport) -> Bool {
  report.rows |> any(r =>
    match r.sharing {
      SharingUndeterminedByDeclaration => true
      SameSharing => false
      DifferentSharing => false
    }
  )
}

fn undetermined_sharing_reported(report: SubjectCollisionReport) -> Bool {
  match report.build {
    BuildAccepted => report_has_undetermined_sharing(report: report) && !report_has_different_sharing(report: report)
    BuildRefused { diagnostic: _ } => false
    BuildNotAttempted => false
  }
}

fn green_control_holds(report: SubjectCollisionReport) -> Bool {
  match report.build {
    BuildAccepted => report_has_no_collision(report: report)
    BuildRefused { diagnostic: _ } => false
    BuildNotAttempted => false
  }
}

fn sharing_label(sharing: CollisionSharing) -> String {
  match sharing {
    SameSharing => "same"
    DifferentSharing => "different"
    SharingUndeterminedByDeclaration => "undetermined"
  }
}

fn build_label(build: SubjectBuild) -> String {
  match build {
    BuildAccepted => "accepted"
    BuildRefused { diagnostic: d } => concat("refused:", d)
    BuildNotAttempted => "not_attempted"
  }
}

fn would_share_cell(b: Bool) -> String {
  if b { "share" } else { "copy" }
}

fn collision_report_line(subject: String, row: LeafCollisionRow) -> String {
  concat(concat(concat(concat("leaf-name coincidence subject=", subject), concat(" leaf=", row.leaf)), concat(" identities=", row.declarers |> join(separator: ","))), concat(concat(" would_share=", row.would_share |> map(b => would_share_cell(b: b)) |> join(separator: ",")), concat(" sharing=", sharing_label(sharing: row.sharing))))
}

fn subject_summary_line(kind: String, name: String, report: SubjectCollisionReport) -> String {
  let same = report.rows |> filter(r =>
    match r.sharing {
      SameSharing => true
      DifferentSharing => false
      SharingUndeterminedByDeclaration => false
    }
  ) |> count
  let different = report.rows |> filter(r =>
    match r.sharing {
      DifferentSharing => true
      SameSharing => false
      SharingUndeterminedByDeclaration => false
    }
  ) |> count
  let undetermined = report.rows |> filter(r =>
    match r.sharing {
      SharingUndeterminedByDeclaration => true
      SameSharing => false
      DifferentSharing => false
    }
  ) |> count
  concat(concat(concat(concat(concat("subject kind=", kind), concat(" name=", name)),                     concat(" coinciding_leaves=", to_string(report.rows |> count))), concat(concat(" same_sharing=", to_string(same)), concat(" different_sharing=", to_string(different)))), concat(concat(" undetermined_sharing=", to_string(undetermined)), concat(" build=", build_label(build: report.build))))
}

fn control_line(name: String, held: Bool) -> String {
  concat(concat(concat("control ", name), " "), if held { "held" } else { "unmet" })
}

fn fixture_standing(independent_report: SubjectCollisionReport, recursive_report: SubjectCollisionReport, green_report: SubjectCollisionReport) -> String {
  let independent_held = different_sharing_build_accepted(report: independent_report)
  let recursive_held = undetermined_sharing_reported(report: recursive_report)
  let green_held = green_control_holds(report: green_report)
  let held = independent_held && recursive_held && green_held
  [
    concat("STANDING ", if held { "held" } else { "unmet" }),
    control_line(name: "DifferentSharingIdentitiesBuildIndependently", held: independent_held),
    control_line(name: "RecursiveLeafSharingUndeterminedByDeclaration", held: recursive_held),
    control_line(name: "green_no_collision_rustc_accepted", held: green_held)
  ] |> join(separator: "\n")
}

fn fixture_controls_hold(independent_report: SubjectCollisionReport, recursive_report: SubjectCollisionReport, green_report: SubjectCollisionReport) -> Bool {
  different_sharing_build_accepted(report: independent_report) && undetermined_sharing_reported(report: recursive_report) && green_control_holds(report: green_report)
}

fn observation_held(standing_held: Bool, live_unobserved: Bool) -> Bool {
  standing_held && !live_unobserved
}

fn build_is_reportable_finding(build: SubjectBuild) -> Bool {
  match build {
    BuildAccepted => true
    BuildRefused { diagnostic: _ } => true
    BuildNotAttempted => false
  }
}

fn build_is_refused_finding(build: SubjectBuild) -> Bool {
  match build {
    BuildRefused { diagnostic: _ } => true
    BuildAccepted => false
    BuildNotAttempted => false
  }
}
