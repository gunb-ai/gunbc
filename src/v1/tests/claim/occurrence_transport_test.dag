module v1.tests.claim.occurrence_transport_test

import std.occurrence_identity {
  AuthoredOccurrenceId,
  DeclarationOccurrence,
  ReferenceOccurrence,
  AuthoredDeclarationOccurrence,
  AuthoredReferenceOccurrence,
}

import v1.std.core {
  Node,
  MatchPattern,
  Bind,
  LitPattern,
  VariantPattern,
  Wildcard,
  ExprData,
  ExprLet,
  ExprLambda,
  ExprMatch,
  NewlineIndex,
  make_span,
  leaf_node_with_span,
  make_arm_node,
  make_expr_node,
  node_with_authored_occurrence,
  arm_pattern,
  arm_body,
  field_binding_pattern,
  int_type,
  build_newline_index,
  empty_intern_table,
}

import v1.compiler.tokenize { tokenize }

import v1.compiler.parse {
  ParseContext,
  token_stream_new_at,
  parse_pattern,
  parse_expr,
  parse_let,
  parse_param,
}

import v1.compiler.infer {
  substitute_generics_apply,
}

import v1.compiler.dag_collect {
  dag_node_key,
  dag_collect_insert_slots,
}

import v1.compiler.dag_collect_support {
  DagCollectSlot,
  dag_node_surface_fingerprint,
}

data occurrence_transport_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/release/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/occurrence_transport_test.dag --functions occurrence_transport_parser_forms_hold,occurrence_transport_rebuilt_reference_holds,occurrence_transport_collector_is_occurrence_safe"

data occurrence_transport_boundary_note: String = "These witnesses stop at transport. They compare typed authored occurrence categories and IDs, never resolve a declaration candidate or infer identity from SourceSpan, spelling, or Node structure."

fn declaration_node(name: String, id: Int) -> Node {
  node_with_authored_occurrence(
    node: leaf_node_with_span(
      name: name,
      span: make_span(start: 0, end: 0),
    ),
    occurrence: AuthoredDeclarationOccurrence {
      occurrence: DeclarationOccurrence {
        identity: AuthoredOccurrenceId { value: id },
      },
    },
  )
}

fn reference_node(name: String, id: Int) -> Node {
  reference_node_at(name: name, id: id, start: 0, end: 0)
}

fn reference_node_at(name: String, id: Int, start: Int, end: Int) -> Node {
  node_with_authored_occurrence(
    node: leaf_node_with_span(
      name: name,
      span: make_span(start: start, end: end),
    ),
    occurrence: AuthoredReferenceOccurrence {
      occurrence: ReferenceOccurrence {
        identity: AuthoredOccurrenceId { value: id },
      },
    },
  )
}

fn node_declaration_id(node: Node) -> Int? {
  match node.authored_occurrence {
    Present { value: AuthoredDeclarationOccurrence { occurrence: occurrence } } =>
      Present { value: occurrence.identity.value }
    _ => none
  }
}

fn node_reference_id(node: Node) -> Int? {
  match node.authored_occurrence {
    Present { value: AuthoredReferenceOccurrence { occurrence: occurrence } } =>
      Present { value: occurrence.identity.value }
    _ => none
  }
}

fn fixture_context(file: String, source: String) -> ParseContext {
  ParseContext {
    source_indices: map_insert(
      empty_map(),
      file,
      build_newline_index(file: file, source: source),
    ),
    intern_table: empty_intern_table(),
  }
}

fn parse_fixture_expr(source: String, occurrence_base: Int) -> Node? {
  let file = "occurrence-transport-expr.dag"
  let result = parse_expr(
    tokens: token_stream_new_at(
      all: tokenize(source: source, file: file),
      occurrence_base: occurrence_base,
    ),
    ctx: fixture_context(file: file, source: source),
  )
  match result.err {
    Present { value: _ } => none
    Absent => Present { value: result.expr }
  }
}

fn parse_fixture_let(source: String, occurrence_base: Int) -> Node? {
  let file = "occurrence-transport-let.dag"
  let result = parse_let(
    tokens: token_stream_new_at(
      all: tokenize(source: source, file: file),
      occurrence_base: occurrence_base,
    ),
    ctx: fixture_context(file: file, source: source),
  )
  match result.err {
    Present { value: _ } => none
    Absent => Present { value: result.expr }
  }
}

fn parse_fixture_param(source: String, occurrence_base: Int) -> Node? {
  let file = "occurrence-transport-param.dag"
  let result = parse_param(
    tokens: token_stream_new_at(
      all: tokenize(source: source, file: file),
      occurrence_base: occurrence_base,
    ),
    ctx: fixture_context(file: file, source: source),
  )
  match result.err {
    Present { value: _ } => none
    Absent => Present { value: result.param }
  }
}

type ParsedFixturePattern
  = ParsedFixturePatternReady { pattern: MatchPattern }
  | ParsedFixturePatternRefused

fn parse_fixture_pattern(source: String, occurrence_base: Int) -> ParsedFixturePattern {
  let file = "occurrence-transport-pattern.dag"
  let result = parse_pattern(
    tokens: token_stream_new_at(
      all: tokenize(source: source, file: file),
      occurrence_base: occurrence_base,
    ),
    ctx: fixture_context(file: file, source: source),
  )
  match result.err {
    Present { value: _ } => ParsedFixturePatternRefused
    Absent => ParsedFixturePatternReady { pattern: result.pattern }
  }
}

fn pattern_declaration_ids(pattern: MatchPattern) -> List<Int> {
  match pattern {
    Bind { declaration: declaration } =>
      match node_declaration_id(node: declaration) {
        Present { value: id } => [id]
        Absent => []
      }
    LitPattern { value: _ } => []
    Wildcard => []
    VariantPattern {
      name: _,
      parent_enum: _,
      field_bindings: bindings,
    } =>
      bindings |> flat_map(binding =>
        pattern_declaration_ids(pattern: field_binding_pattern(n: binding))
      )
  }
}

fn two_distinct(values: List<Int>) -> Bool {
  if (values |> count) != 2 {
    false
  } else {
    match values |> first {
      Absent => false
      Present { value: first_id } =>
        match values |> skip(1) |> first {
          Absent => false
          Present { value: second_id } => first_id != second_id
        }
    }
  }
}

fn parsed_pattern_has_one_typed_declaration(source: String, occurrence_base: Int) -> Bool {
  match parse_fixture_pattern(source: source, occurrence_base: occurrence_base) {
    ParsedFixturePatternRefused => false
    ParsedFixturePatternReady { pattern: pattern } =>
      (pattern_declaration_ids(pattern: pattern) |> count) == 1
  }
}

fn parser_pattern_binder_matrix_is_typed() -> Bool {
  parsed_pattern_has_one_typed_declaration(
    source: "direct_bind",
    occurrence_base: 1000,
  ) &&
  parsed_pattern_has_one_typed_declaration(
    source: "Pair { left: explicit_bind }",
    occurrence_base: 1100,
  ) &&
  parsed_pattern_has_one_typed_declaration(
    source: "Shorthand { shorthand_bind }",
    occurrence_base: 1200,
  ) &&
  parsed_pattern_has_one_typed_declaration(
    source: "Left(positional_bind)",
    occurrence_base: 1300,
  ) &&
  parsed_pattern_has_one_typed_declaration(
    source: "Outer { pair: Pair { left: nested_bind } }",
    occurrence_base: 1400,
  )
}

fn parser_explicit_alias_label_and_declaration_are_distinct() -> Bool {
  match parse_fixture_pattern(
    source: "Pair { left: explicit_bind }",
    occurrence_base: 1500,
  ) {
    ParsedFixturePatternRefused => false
    ParsedFixturePatternReady { pattern: pattern } =>
      match pattern {
        VariantPattern {
          name: _,
          parent_enum: _,
          field_bindings: bindings,
        } =>
          match bindings |> first {
            Absent => false
            Present { value: binding } =>
              let declarations = pattern_declaration_ids(
                pattern: field_binding_pattern(n: binding)
              )
              if (declarations |> count) != 1 {
                false
              } else {
                match node_reference_id(node: binding) {
                  Absent => false
                  Present { value: reference_id } =>
                    match declarations |> first {
                      Absent => false
                      Present { value: declaration_id } =>
                        reference_id != declaration_id
                    }
                }
              }
          }
        _ => false
      }
  }
}

fn parser_nested_same_spelling_is_distinct() -> Bool {
  match parse_fixture_pattern(
    source: "Outer { x, nested: Pair { x } }",
    occurrence_base: 1600,
  ) {
    ParsedFixturePatternRefused => false
    ParsedFixturePatternReady { pattern: pattern } =>
      two_distinct(values: pattern_declaration_ids(pattern: pattern))
  }
}

fn parser_sibling_arm_same_spelling_is_distinct() -> Bool {
  match parse_fixture_expr(
    source: "match source { Pair { value: x } => x, Pair { value: x } => x }",
    occurrence_base: 1700,
  ) {
    Absent => false
    Present { value: expression } =>
      match expression.expr_data {
        ExprMatch =>
          let arms = expression.children |> skip(1)
          let declarations = arms |> flat_map(arm =>
            pattern_declaration_ids(pattern: arm_pattern(n: arm))
          )
          let references = arms |> flat_map(arm =>
            match node_reference_id(node: arm_body(n: arm)) {
              Present { value: id } => [id]
              Absent => []
            }
          )
          two_distinct(values: declarations) &&
          two_distinct(values: references)
        _ => false
      }
  }
}

fn parser_let_and_reference_are_typed_distinct() -> Bool {
  match parse_fixture_let(source: "let kept = kept", occurrence_base: 100) {
    Absent => false
    Present { value: let_node } =>
      match let_node.children |> first {
        Absent => false
        Present { value: reference } =>
          node_declaration_id(node: let_node) != none &&
          node_reference_id(node: reference) != none &&
          node_declaration_id(node: let_node).value !=
            node_reference_id(node: reference).value
      }
  }
}

fn parser_lambda_and_reference_are_typed_distinct() -> Bool {
  match parse_fixture_expr(source: "arg => arg", occurrence_base: 200) {
    Absent => false
    Present { value: lambda } =>
      match lambda.expr_data {
        ExprLambda =>
          match lambda.children |> first {
            Absent => false
            Present { value: body } =>
              match lambda.children |> skip(1) |> first {
                Absent => false
                Present { value: parameter } =>
                  node_declaration_id(node: parameter) != none &&
                  node_reference_id(node: body) != none &&
                  node_declaration_id(node: parameter).value !=
                    node_reference_id(node: body).value
              }
          }
        _ => false
      }
  }
}

fn parser_function_parameter_and_reference_are_typed() -> Bool {
  match parse_fixture_param(source: "arg: Int", occurrence_base: 300) {
    Absent => false
    Present { value: parameter } =>
      match parse_fixture_expr(source: "arg", occurrence_base: 400) {
        Absent => false
        Present { value: reference } =>
          node_declaration_id(node: parameter) != none &&
          node_reference_id(node: reference) != none &&
          node_declaration_id(node: parameter).value !=
            node_reference_id(node: reference).value
      }
  }
}

test fn occurrence_transport_parser_forms_hold() -> Bool {
  parser_let_and_reference_are_typed_distinct() &&
  parser_lambda_and_reference_are_typed_distinct() &&
  parser_function_parameter_and_reference_are_typed() &&
  parser_pattern_binder_matrix_is_typed() &&
  parser_explicit_alias_label_and_declaration_are_distinct() &&
  parser_nested_same_spelling_is_distinct() &&
  parser_sibling_arm_same_spelling_is_distinct()
}

fn rebuilt_reference_keeps_id() -> Bool {
  let reference = reference_node(name: "T", id: 601)
  let rebuilt = substitute_generics_apply(
    n: reference,
    subst: map_insert(empty_map(), "T", int_type),
    source_indices: empty_map(),
  )
  node_reference_id(node: rebuilt) == Present { value: 601 }
}

test fn occurrence_transport_rebuilt_reference_holds() -> Bool {
  rebuilt_reference_keeps_id()
}

fn collector_insert(node: Node, slots: Map<String, DagCollectSlot>) -> Map<String, DagCollectSlot> {
  dag_collect_insert_slots(
    node: node,
    slots: slots,
    collision_errors: [],
  )
}

fn collector_dedupes_one_occurrence() -> Bool {
  let first_copy = reference_node_at(name: "same", id: 701, start: 0, end: 4)
  let rebuilt_copy = reference_node_at(name: "rebuilt", id: 701, start: 99, end: 106)
  let slots = collector_insert(
    node: rebuilt_copy,
    slots: collector_insert(node: first_copy, slots: empty_map()),
  )
  (slots |> count) == 1
}

fn collector_keeps_structurally_equal_occurrences() -> Bool {
  let first_authored = reference_node(name: "same", id: 801)
  let second_authored = reference_node(name: "same", id: 805)
  let same_surface = dag_node_surface_fingerprint(node: first_authored) == dag_node_surface_fingerprint(node: second_authored)
  let slots = collector_insert(
    node: second_authored,
    slots: collector_insert(node: first_authored, slots: empty_map()),
  )
  same_surface &&
  dag_node_key(node: first_authored) != dag_node_key(node: second_authored) &&
  (slots |> count) == 2
}

fn collector_reaches_pattern_declaration() -> Bool {
  let declaration = declaration_node(name: "bound", id: 900)
  let arm = make_arm_node(
    pattern: Bind { declaration: declaration },
    guard: none,
    body: make_expr_node(
      expr_data: ExprLet,
      children: [],
      inferred: none,
      span: make_span(start: 0, end: 0),
    ),
    span: make_span(start: 0, end: 0),
  )
  let slots = collector_insert(node: arm, slots: empty_map())
  map_has(slots, dag_node_key(node: declaration))
}

test fn occurrence_transport_collector_is_occurrence_safe() -> Bool {
  collector_dedupes_one_occurrence() &&
  collector_keeps_structurally_equal_occurrences() &&
  collector_reaches_pattern_declaration()
}
