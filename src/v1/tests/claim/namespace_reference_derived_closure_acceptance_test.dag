module v1.tests.claim.namespace_reference_derived_closure_acceptance

import gunbc.namespace_reference_derived_closure_admission {
  ReferenceDerivedClosureUnavailable,
  RepeatedMentionsCollapseDependency,
  UnrelatedLoadedFileExcluded,
  P2aReferenceDependencyProjection7515,
  P2aPoolIndependentDependencyProjection7515,
}
import gunbc.namespace_reference_derived_closure_contract {
  reference_derived_closure_closing_contract_holds,
}
import v1.gunbc.namespace_reference_derived_closure_production_admissions {
  observe_same_file_earlier_neighbour_visible,
  observe_sibling_decision_branch_excluded,
  observe_later_declaration_excluded,
  observe_distinct_same_spelled_declarations_preserved,
}
import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.types { Bool, List }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data namespace_reference_derived_closure_acceptance_note: String = "THE DISCRIMINATING CLOSING VALIDATION for roadmap node namespace-reference-derived-closure. RED ON PURPOSE while clauses (e-f) remain unavailable. Governed placement: src/v1/tests/claim because this witness imports v1.gunbc.* and must compile under compile_clean_source_roots without widening the witness_layer_roots pool (dag/test/claim would force a cross-tree pool that reds json_emit/rust_test_fixtures). Composition lives inline in this witness (operator ruling loyal-ram-550): the contract predicate is unchanged and takes admissions as a parameter; each lane owns ONE observe_* supplier; clauses (e-f) remain literal Unavailable until N3-B/N3-C land. Executes on v1_claim_scoped_known_red_probe_batch under the dag plus src/v1 envelope."

test fn witness_namespace_reference_derived_closure_closing_contract_holds() -> Bool {
  reference_derived_closure_closing_contract_holds(
    admissions: [
      observe_same_file_earlier_neighbour_visible(),
      observe_sibling_decision_branch_excluded(),
      observe_later_declaration_excluded(),
      observe_distinct_same_spelled_declarations_preserved(),
      ReferenceDerivedClosureUnavailable {
        capability: RepeatedMentionsCollapseDependency,
        trigger: P2aReferenceDependencyProjection7515,
      },
      ReferenceDerivedClosureUnavailable {
        capability: UnrelatedLoadedFileExcluded,
        trigger: P2aPoolIndependentDependencyProjection7515,
      },
    ],
  )
}
