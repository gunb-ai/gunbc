module v1.tests.claim.native_serve_main_order_test

import v1.compiler.emit_rust { emit_native_serve_driver_main_rs }
import v1.std.core { TextFile }

// THE EMITTED SERVE MAIN'S TWO ORDERINGS (v1.compiler.emit_rust emit_native_serve_driver_main_rs). A driver that declares
// native_serve_startup realizes its first worker -- which runs the startup fold, with its own bound -- BEFORE the bind, so a
// self-check that refuses never becomes reachable; a driver that declares none is emitted unchanged, binding first and
// realizing after. Both are read off the text before the first `TcpListener::bind`, the one site the order is decided at.

fn nsmo_before_bind(file: TextFile) -> String {
  match (file.content |> split(delimiter: "TcpListener::bind((")).first() {
    Present { value: head } => head
    Absent => ""
  }
}

fn nsmo_main(startup: Bool) -> TextFile {
  emit_native_serve_driver_main_rs(crate_name: "c", pipeline_module: "m", bindings: [], startup: startup)
}

test fn a_startup_entry_realizes_its_worker_before_it_binds_and_bounds_it_by_the_startup_deadline() -> Bool {
  let head = nsmo_before_bind(file: nsmo_main(startup: true))
  string_contains(s: head, pattern: "realize_generation(&stuck, ready_within)") && string_contains(s: head, pattern: "contract.startup_deadline")
}

test fn a_driver_with_no_startup_binds_before_it_realizes_its_worker_on_the_request_deadline() -> Bool {
  let file = nsmo_main(startup: false)
  let head = nsmo_before_bind(file: file)
  !string_contains(s: head, pattern: "realize_generation(&stuck") && string_contains(s: file.content, pattern: "realize_generation(&stuck, deadline)") && !string_contains(s: file.content, pattern: "startup_deadline")
}
