module v1.tests.claim.parser_declaration_requirements_expected_red_test

import std.types { Bool }
import std.occurrence_identity { DeclarationOccurrence }
import v1.tests.claim.parser_declaration_matrix_support {
  pdc_row,
  pdc_identity_row,
  pdc_parse_matrix,
  pdc_index_entry_for_declaration,
  PdcTransportReady,
  PdcTransportRefused,
}

data pdr_expected_red_note: String = "EXPECTED-RED BY CONSTRUCTION. Every test fn here asserts a requirement the .dag language imposes that the v1 parser does not yet meet. They are commit C's acceptance targets, and they are expected to FAIL until it lands. They live in their own file because the v1 claim scoped batch is required to be uniformly file-grain (witness_v1_claim_scoped_batch_is_file_grain_and_batch_owned asserts every entry has an empty function), so a file cannot mix green and deliberately-red rows. When commit C lands, these rows green and move to the enrolled green file as permanent regression controls -- they do not retire."


// ---------------------------------------------------------------------------------------------
// Derived requirements the parser DOES NOT meet. Expected red today; commit C's acceptance targets.
//
// `data pdc_annotated_datum` is deliberately absent from this section. Whether a top-level data row
// is honestly representable by an existing category and exposure, or whether its absence is a real
// model gap, must be settled by an actual cross-file binding control rather than chosen here for
// convenience — so it carries no derived row yet.
// ---------------------------------------------------------------------------------------------

// A named type declaration introduces a type name into its module. Both the product and the
// coproduct form must; a type ALIAS must too, and is a third shape (NoConnective with `inferred`
// present) that a connective-keyed rule would miss.
test fn witness_product_type_declaration_is_declared() -> Bool {
  pdc_row(name: "PdcProduct", expected: "|TypeOccurrence")
}

test fn witness_coproduct_type_declaration_is_declared() -> Bool {
  pdc_row(name: "PdcSum", expected: "|TypeOccurrence")
}

// A variant arm introduces a constructor name, whether or not it carries a payload. Both forms
// follow the same rule; asserting only the payload form would let a nullary-only regression pass.
test fn witness_nullary_constructor_is_declared() -> Bool {
  pdc_row(name: "PdcNullary", expected: "|ConstructorOccurrence")
}

test fn witness_payload_constructor_is_declared() -> Bool {
  pdc_row(name: "PdcPayload", expected: "|ConstructorOccurrence")
}

// A product type's field is declared by the type that owns it.
test fn witness_product_field_is_declared() -> Bool {
  pdc_row(name: "pdc_product_field", expected: "|FieldOccurrence")
}

// THE TWO ROWS THAT A NAME JOIN CANNOT STATE, and the reason this file keys on identity.
//
// `pdc_payload_field` is authored twice: at byte 109 as the coproduct's payload FIELD DECLARATION,
// and at byte 394 as the field position of the destructuring pattern. The second is a USE of the
// first — it names which field is being destructured; the binder is `pdc_pattern_binder`. So the
// language requires exactly one DECLARATION of this name, at 109, and the pattern position must not
// produce one.
//
// Today the parser does the opposite: the only declaration it mints sits at 394, and 109 mints
// nothing. Because both readings yield a population of size one, a count or a name assertion cannot
// tell them apart — which is why the earlier version of this file passed while describing the wrong
// occurrence. The spans are hard-coded deliberately: this fixture authors its own source, and a
// fixture edit that moves these positions SHOULD break these rows rather than silently re-point them.
test fn witness_coproduct_payload_field_is_declared_at_its_declaration_site() -> Bool {
  pdc_identity_row(
    name: "pdc_payload_field",
    expected: "|pdc_payload_field#FieldOccurrence#span:109-126#path:>app.pdc_matrix>PdcSum>PdcPayload",
  )
}

// Stated separately from the row above so the two defects are counted separately: even once the
// declaration at 109 exists, a parser that ALSO kept minting a declaration at 394 would still be
// wrong, and the row above alone would not say so.
test fn witness_pattern_field_position_is_not_a_declaration() -> Bool {
  match pdc_parse_matrix() {
    PdcTransportRefused => false
    PdcTransportReady { transport: transport } =>
      fold(
        transport.declarations,
        init: true,
        f: (acc, declaration) =>
          match pdc_index_entry_for_declaration(transport: transport, declaration: declaration) {
            Absent => acc
            Present { value: entry } =>
              acc && entry.projection.diagnostic_span.start != 394
          },
      )
  }
}

// THE THIRD ROW, so the two defects are independently discriminated.
//
// The population row above bundles two facts -- that a declaration exists at 109, and that nothing
// else carries this name -- so its failure cannot say which held. The sibling row isolates the
// second defect (a declaration at 394). This row isolates the FIRST: a declaration exists at the
// coproduct's declaration site, said without any claim about what else exists.
//
// With all three, commit C cannot green by fixing one defect and masking the other: this row fails
// if the declaration at 109 is still missing, the sibling fails if the use at 394 is still minted as
// a declaration, and the population row fails if a third occurrence of the name appears anywhere.
test fn witness_a_declaration_exists_at_the_coproduct_field_site() -> Bool {
  match pdc_parse_matrix() {
    PdcTransportRefused => false
    PdcTransportReady { transport: transport } =>
      fold(
        transport.declarations,
        init: false,
        f: (found, declaration) =>
          match pdc_index_entry_for_declaration(transport: transport, declaration: declaration) {
            Absent => found
            Present { value: entry } =>
              found || entry.projection.diagnostic_span.start == 109
          },
      )
  }
}
