module v1.tests.claim.v1_annotation_erasure_test


data v1_annotation_erasure_offline_recipe: String = "OFFLINE LOCAL RECIPE: target/debug/claim_batch --source-root dag --source-root src/v1 --entry src/v1/tests/claim/v1_annotation_erasure_test.dag --functions w_occurrence_identities_equal_in_the_annotated_module,w_occurrence_identities_equal_in_a_later_module,w_later_module_control_shifts_when_a_declaration_is_added,w_annotation_graph_differs_between_the_two_sources,w_declaration_provenance_still_reads_correctly_after_byte_shift,w_bare_source_provenance_control"

data v1_annotation_erasure_note: String = "The erasure controls: the same program written with and without prose must be the SAME PROGRAM. Each claim pairs an annotated source with a byte-different but semantically identical bare source and asserts a semantic fact is unchanged, or asserts the authored fact IS changed.

These are the proofs that make the annotation channel safe to turn on. Without them, `//` is readmitted to a language whose declaration identities are allocated in token order, and nothing establishes that adding a comment does not silently renumber the program."

data annotated_first: String = "module a.one\n\n// prose about alpha\ndata alpha: String = \"a\"\n\n// prose about beta\ndata beta: String = \"b\"\n"

data bare_first: String = "module a.one\n\ndata alpha: String = \"a\"\n\ndata beta: String = \"b\"\n"

data later_module: String = "module a.two\n\ndata gamma: String = \"g\"\n\nfn use_it(x: String) -> String {\n  x\n}\n"

data later_module_shifted: String = "module a.two\n\ndata inserted: String = \"i\"\n\ndata gamma: String = \"g\"\n\nfn use_it(x: String) -> String {\n  x\n}\n"

fn parse_in_scope(source: String, file: String, allocator: OccurrenceIdAllocator, table: InternTable) -> ParseWithTableResult {
  parse_with_table_in_occurrence_scope(
    tokens: tokenize_artifact(source: source, file: file).tokens,
    source_indices: map_insert(empty_map(), file, build_newline_index(file: file, source: source)),
    intern_table: table,
    occurrence_allocator: allocator,
  )
}

data scope_threading_note: String = "Both modules are parsed in ONE occurrence scope with the allocator threaded from the first into the second, exactly as front_end_sources threads it across a compilation. That threading is what makes proof (2) meaningful: if the annotated first module consumed even one extra identity, every identity in the SECOND module would shift, and a test that parsed each module in its own fresh scope could never observe it."

fn first_then_second(first_source: String, second_source: String) -> ParseWithTableResult {
  let first = parse_in_scope(
    source: first_source,
    file: "one.dag",
    allocator: occurrence_id_allocator_initial(),
    table: empty_intern_table()
  )
  parse_in_scope(
    source: second_source,
    file: "two.dag",
    allocator: first.occurrence_allocator,
    table: first.intern_table
  )
}

fn first_only(first_source: String) -> ParseWithTableResult {
  parse_in_scope(
    source: first_source,
    file: "one.dag",
    allocator: occurrence_id_allocator_initial(),
    table: empty_intern_table()
  )
}

data identity_rendering_note: String = "Renders name-to-identity pairs, deliberately WITHOUT spans. Spans are expected to differ — a comment shifts every byte offset after it, which is the whole reason proof (6) exists as a separate claim — so including them would make this control fail for the one reason it is not testing. What must not move is the IDENTITY each authored name received."

fn render_identities(transport: OccurrenceTransport) -> String {
  fold(
    transport.index.entries,
    init: "",
    f: (acc, entry) =>
      concat(acc, concat("|", concat(entry.projection.authored_name, concat("=", to_string(entry.projection.occurrence.value)))))
  )
}

fn annotation_row_count(source: String, file: String) -> Int {
  let artifact = tokenize_artifact(source: source, file: file)
  let parsed = parse_in_scope(
    source: source,
    file: file,
    allocator: occurrence_id_allocator_initial(),
    table: empty_intern_table()
  )
  source_annotation_graph_rows(
    graph: annotation_attachment_result_graph(
      result: bind_annotations(
        transport: parsed.occurrence_transport,
        captures: artifact.annotations,
        source_length: string_length(s: source)
      )
    )
  ) |> count
}

test fn w_occurrence_identities_equal_in_the_annotated_module() -> Bool {
  render_identities(transport: first_only(first_source: annotated_first).occurrence_transport) ==
    render_identities(transport: first_only(first_source: bare_first).occurrence_transport)
}

data later_module_proof_note: String = "Proof (2), the one the ruling singled out. The SECOND module is byte-identical in both runs; only the first differs, and only by prose. If capturing an annotation drew even one identity from the shared allocator, the second module's identities would all be offset by that amount and this equality would fail."

test fn w_occurrence_identities_equal_in_a_later_module() -> Bool {
  render_identities(transport: first_then_second(first_source: annotated_first, second_source: later_module).occurrence_transport) ==
    render_identities(transport: first_then_second(first_source: bare_first, second_source: later_module).occurrence_transport)
}

data later_module_control_note: String = "The discriminating control for proof (2). It shows the comparison above CAN fail: adding a real declaration to the second module does move identities, so the equality is detecting identity drift rather than comparing two things that happen to be equal for a structural reason. Without this, a rendering that silently produced the same string for every input would pass proof (2) and prove nothing."

test fn w_later_module_control_shifts_when_a_declaration_is_added() -> Bool {
  render_identities(transport: first_then_second(first_source: bare_first, second_source: later_module).occurrence_transport) !=
    render_identities(transport: first_then_second(first_source: bare_first, second_source: later_module_shifted).occurrence_transport)
}

test fn w_annotation_graph_differs_between_the_two_sources() -> Bool {
  annotation_row_count(source: annotated_first, file: "one.dag") == 2 &&
    annotation_row_count(source: bare_first, file: "one.dag") == 0
}

data provenance_proof_note: String = "Proof (6). Prose shifts every byte offset after it, so a declaration's recorded span must have shifted with it. This reads the annotated source back AT the recorded span and asserts the bytes there are the declaration keyword — if spans were recorded against the comment-stripped text, or not shifted at all, the slice would land in the middle of the prose instead."

fn slice_at_declaration(source: String, name: String) -> String {
  let parsed = first_only(first_source: source)
  fold(
    parsed.occurrence_transport.index.entries,
    init: "<missing>",
    f: (acc, entry) =>
      if entry.projection.authored_name == name {
        substring(s: source, start: entry.projection.diagnostic_span.start, end: entry.projection.diagnostic_span.end)
      } else {
        acc
      }
  )
}

test fn w_declaration_provenance_still_reads_correctly_after_byte_shift() -> Bool {
  slice_at_declaration(source: annotated_first, name: "beta") == "data"
}

test fn w_bare_source_provenance_control() -> Bool {
  slice_at_declaration(source: bare_first, name: "beta") == "data"
}

data structural_proofs_note: String = "Proofs (1) and (3), stated as what is actually true rather than as the obvious-looking equality.

MEASURED: v1's Node carries a `span` field, so raw Node equality between an annotated source and its bare twin FAILS — and it must. Prose shifts every byte after it, so the spans differ by construction, which is the same fact proof (6) asserts positively by reading the source back at the recorded offsets. Raw Node equality therefore compares PROVENANCE, not structure, and asserting it would have been asserting that annotations do not move byte offsets — which is false, and which nothing in the design ever claimed.

The span-independent surface fingerprint is the structure oracle, and it is equal. So the claim below asserts BOTH halves: structure identical, provenance different. That pair is strictly more informative than either alone — an implementation that accidentally erased spans would pass a naive equality test and fail this one."

fn module_fingerprint_of(source: String) -> String {
  match first_only(first_source: source).result.module {
    Present { value: m } => dag_node_surface_fingerprint(node: m)
    Absent => "<no module parsed>"
  }
}

test fn w_semantic_structure_equal_while_only_provenance_differs() -> Bool {
  module_fingerprint_of(source: annotated_first) == module_fingerprint_of(source: bare_first) &&
    first_only(first_source: annotated_first).result.module != first_only(first_source: bare_first).result.module
}

test fn w_semantic_fingerprint_equal_with_and_without_prose() -> Bool {
  module_fingerprint_of(source: annotated_first) == module_fingerprint_of(source: bare_first)
}

test fn w_semantic_fingerprint_control_moves_on_a_real_declaration() -> Bool {
  module_fingerprint_of(source: later_module) != module_fingerprint_of(source: later_module_shifted)
}
