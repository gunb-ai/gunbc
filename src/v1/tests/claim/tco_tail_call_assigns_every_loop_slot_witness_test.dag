module v1.tests.claim.tco_tail_call_assigns_every_loop_slot_witness

import v1.compiler.artifact { RenderTarget, Rust, Python, Go }
import v1.compiler.emit {
  shared_tco_reassign,
  tco_loop_slot_name
}
import v1.compiler.emit_core_support { language_spec }
import std.types { Bool }

// LOCAL DILIGENCE for tco_identity_passthrough_elision_after_slot_local_split. It lives here
// because the required floor's source roots are `dag` and `src/v2` only (witnesses.yml), and
// v1.compiler.emit is not in that closure — a dag/test/claim import of it refuses unresolved.
// Widening the floor to import v1 is a job-roster change and is not this file.
//
// THIS FILE IS NOT THE ENROLLED WALL. The merge-path wall for this class is the required build
// lane compiling the regenerated seed and running it over the corpus: a restored identity
// elision hangs parse_*_acc and is caught as a timeout (rung 1, mitigatable). The Rust #[test]
// tco_tail_call_assigns_every_loop_slot is the same standing (cargo test is off the merge path).
// Next-rung trigger is a CI lane that executes v1.compiler witnesses, named as a capability;
// today that lane is a declared gap.
//
//   gunbc run --source-root dag --source-root src/v1 --source-root src/v2 --claim-run \
//     --entry src/v1/tests/claim/tco_tail_call_assigns_every_loop_slot_witness_test.dag \
//     --function tco_shared_reassign_writes_every_slot_in_param_order

fn tco_slot_acc() -> String {
  tco_loop_slot_name(param_name: "acc")
}

fn tco_slot_n() -> String {
  tco_loop_slot_name(param_name: "n")
}

fn tco_fixture_args() -> List<String> {
  ["acc", "(n - 1)"]
}

fn tco_fixture_slots() -> List<String> {
  [tco_slot_acc(), tco_slot_n()]
}

fn tco_reassign_block(target: RenderTarget) -> String {
  shared_tco_reassign(
    ordered_args: tco_fixture_args(),
    param_names: tco_fixture_slots(),
    spec: language_spec(target: target)
  )
}

fn tco_slot_dests_once_in_order(block: String) -> Bool {
  string_contains(s: block, pattern: concat(tco_slot_acc(), " = __tco_0;\n", tco_slot_n(), " = __tco_1"))
    && string_contains(s: block, pattern: "continue")
}

fn tco_has_both_slot_dests(block: String) -> Bool {
  string_contains(s: block, pattern: concat(tco_slot_acc(), " ="))
    && string_contains(s: block, pattern: concat(tco_slot_n(), " ="))
}

test fn tco_shared_reassign_writes_every_slot_in_param_order() -> Bool {
  tco_slot_dests_once_in_order(block: tco_reassign_block(target: Rust))
    && tco_has_both_slot_dests(block: tco_reassign_block(target: Python))
    && tco_has_both_slot_dests(block: tco_reassign_block(target: Go))
}
