module test.claim.complexity_summary_space_witness

import std.logic { Bool }
import std.types { Int }
import std.measure { ByteSize, byte_size_count }
import v1.compiler.complexity {
  CostExpr, CostConst, CostAdd, CostMul, CostMax, CostSum, CostUnknown,
  SizeExpr, SizeConst, SizeVar, SizeLen,
  ComplexitySummary, Certainty, Proven, Conservative,
  space_of, fold_peak_space, derive_peak_space, cost_account_space_from_summary,
}

data complexity_summary_space_witness_note: String = "Space-complexity integration ACCEPT (space-complexity-design.md 5): ComplexitySummary now carries an OPTIONAL peak_space, derived at the finalized per-function summary via space_of(work) (+ output_size for collection results). cost_account_space_from_summary fills CostAccount.space (basis Derived) by evaluating peak_space at a closed size_env to a concrete ByteSize. Three witnesses: a WITH-peak summary yields the expected bytes; an ABSENT-peak summary returns none (the fail-closed SpaceBoundUnknown frontier, and the RED control that an optional field is skipped by the P0 field wall); a reducing-fold work is O(1) space regardless of n."

test fn summary_with_derived_peak_space_yields_bytes_holds() -> Bool {
  let body = CostConst { value: 4 }
  let out = CostSum { binder: "i", upper: SizeVar { name: "n" }, body: CostConst { value: 4 } }
  let peak = fold_peak_space(body_peak: body, output_size: out)
  let summary = ComplexitySummary {
    work: CostConst { value: 1 },
    span: CostConst { value: 1 },
    output_size: empty_map(),
    certainty: Proven,
    peak_space: Present { value: peak }
  }
  let env = map_insert(empty_map(), "n", 100)
  match cost_account_space_from_summary(summary: summary, size_env: env) {
    Present { value: bs } => byte_size_count(b: bs) == 404
    Absent => false
  }
}

test fn summary_without_peak_space_returns_none_holds() -> Bool {
  let summary = ComplexitySummary {
    work: CostConst { value: 1 },
    span: CostConst { value: 1 },
    output_size: empty_map(),
    certainty: Proven,
    peak_space: none
  }
  match cost_account_space_from_summary(summary: summary, size_env: empty_map()) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn summary_with_underivable_peak_returns_none_holds() -> Bool {
  let summary = ComplexitySummary {
    work: CostConst { value: 1 },
    span: CostConst { value: 1 },
    output_size: empty_map(),
    certainty: Conservative,
    peak_space: Present { value: CostUnknown { reason: "unmodeled primitive" } }
  }
  match cost_account_space_from_summary(summary: summary, size_env: empty_map()) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn reducing_fold_summary_is_constant_space_holds() -> Bool {
  let work = CostSum { binder: "i", upper: SizeVar { name: "n" }, body: CostConst { value: 1 } }
  let summary = ComplexitySummary {
    work: work,
    span: work,
    output_size: empty_map(),
    certainty: Proven,
    peak_space: Present { value: derive_peak_space(work: work, output_size: empty_map()) }
  }
  let small_env = map_insert(empty_map(), "n", 1)
  let big_env = map_insert(empty_map(), "n", 1000000)
  let small_bytes = match cost_account_space_from_summary(summary: summary, size_env: small_env) {
    Present { value: bs } => byte_size_count(b: bs)
    Absent => 0 - 1
  }
  let big_bytes = match cost_account_space_from_summary(summary: summary, size_env: big_env) {
    Present { value: bs } => byte_size_count(b: bs)
    Absent => 0 - 2
  }
  small_bytes == big_bytes && small_bytes == 1
}
