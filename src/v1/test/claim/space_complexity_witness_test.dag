module test.claim.space_complexity_witness

import std.logic { Bool }
import std.types { Int }
import v1.compiler.complexity {
  CostExpr, CostConst, CostAdd, CostMul, CostMax, CostSum, CostUnknown,
  SizeExpr, SizeConst, SizeVar, SizeLen,
  space_of, fold_peak_space, eval_cost_expr_concrete, eval_size_expr_concrete,
}

data space_complexity_witness_note: String = "Space-complexity increment 1a ACCEPT: peak working set as the structural dual of the time cost-expr, proven BEHAVIORALLY through the concrete evaluator (no structural wildcard matches — exhaustive Optional threading only). The headline — a reducing fold is O(n) time but O(1) space (CostSum collapses to its body) — plus the P1 residency duals (sequential CostAdd->CostMax releases: eval 50 not sum 80; parallel CostMax->CostAdd co-resides: eval 80 not max 50), concrete byte evaluation, and the fail-closed frontier (CostUnknown -> the evaluator refuses, the SpaceBoundUnknown counted bottom). All derived, none measured."

fn eval_space(work: CostExpr) -> Int? {
  eval_cost_expr_concrete(e: space_of(work: work), env: empty_map())
}

test fn reducing_fold_is_constant_space_holds() -> Bool {
  let reducing_fold_time = CostSum { binder: "i", upper: SizeVar { name: "n" }, body: CostConst { value: 1 } }
  match eval_space(work: reducing_fold_time) {
    Present { value: bytes } => bytes == 1
    Absent => false
  }
}

test fn sequential_releases_max_not_sum_holds() -> Bool {
  let seq_time = CostAdd { left: CostConst { value: 30 }, right: CostConst { value: 50 } }
  match eval_space(work: seq_time) {
    Present { value: bytes } => bytes == 50
    Absent => false
  }
}

test fn parallel_coresides_add_not_max_holds() -> Bool {
  let par_time = CostMax { left: CostConst { value: 30 }, right: CostConst { value: 50 } }
  match eval_space(work: par_time) {
    Present { value: bytes } => bytes == 80
    Absent => false
  }
}

test fn concrete_derived_bytes_holds() -> Bool {
  let expr = CostMax { left: CostConst { value: 40 }, right: CostAdd { left: CostConst { value: 10 }, right: CostConst { value: 20 } } }
  match eval_cost_expr_concrete(e: expr, env: empty_map()) {
    Present { value: bytes } => bytes == 40
    Absent => false
  }
}

test fn fold_that_builds_is_linear_space_holds() -> Bool {
  let per_element_body = CostConst { value: 4 }
  let output_size = CostSum { binder: "i", upper: SizeVar { name: "n" }, body: CostConst { value: 4 } }
  let peak = fold_peak_space(body_peak: per_element_body, output_size: output_size)
  let env = map_insert(empty_map(), "n", 100)
  match eval_cost_expr_concrete(e: peak, env: env) {
    Present { value: bytes } => bytes == 404
    Absent => false
  }
}

test fn unknown_cost_is_fail_closed_space_holds() -> Bool {
  let unknown_time = CostAdd { left: CostConst { value: 8 }, right: CostUnknown { reason: "unmodeled primitive" } }
  match eval_space(work: unknown_time) {
    Present { value: _ } => false
    Absent => true
  }
}
