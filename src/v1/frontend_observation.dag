module v1.compiler.frontend_observation


// The receipt is DERIVED from the carrier the front end returns, never authored
// beside it. Every field here is a byproduct of work that actually happened:
// module_count counts the modules parse produced, occurrence_count counts the
// occurrences the occurrence walk allocated, and graph_present says whether the
// resolve arm returned a graph. A producer that ran nothing cannot report a
// nonzero count, which is exactly the property a hand-written
// stages_executed list does not have (DESIGN §4b: the reported rung must equal
// the rung executed evidence establishes).
type FrontendPhaseReceipt {
  module_count: Int
  occurrence_count: Int
  declaration_count: Int
  reference_count: Int
  graph_present: Bool
}

type OrdinaryFrontendObservation {
  subject: List<v1.compiler.compile.SourceFile>
  occurrence_transport: std.occurrence_identity.OccurrenceTransport
  diagnostics: List<v1.std.core.ErrorNode>
  receipt: FrontendPhaseReceipt
}

fn frontend_phase_receipt(frontend: v1.compiler.compile.FrontendResult) -> FrontendPhaseReceipt {
  FrontendPhaseReceipt {
    module_count: match frontend.graph {
      Present { value: graph } => graph.modules |> count
      Absent => 0
    },
    occurrence_count: frontend.occurrence_transport.index.entries |> count,
    declaration_count: frontend.occurrence_transport.declarations |> count,
    reference_count: frontend.occurrence_transport.references |> count,
    graph_present: frontend.graph != none
  }
}

// The single producer. Which phases ran is a fact about THIS function's body —
// it calls front_end_sources and nothing downstream of it — so the observation
// never has to assert that resolve-and-beyond did not run (§5: construction
// over validation).
fn observe_ordinary_frontend(sources: List<v1.compiler.compile.SourceFile>) -> OrdinaryFrontendObservation {
  let frontend = front_end_sources(sources: sources)
  OrdinaryFrontendObservation {
    subject: sources,
    occurrence_transport: frontend.occurrence_transport,
    diagnostics: frontend.diagnostics,
    receipt: frontend_phase_receipt(frontend: frontend)
  }
}
