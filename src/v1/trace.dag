module v1.compiler.trace

import v1.std.core { SourceSpan }


type SpanMapping {
  generated_line: Int
  source_span: SourceSpan
}

type TraceEvent
  = TraceEnter { node_id: String, span: SourceSpan, inputs: Map<String, String> }
  | TraceExit { node_id: String, span: SourceSpan, output: String }
  | TraceError { node_id: String, span: SourceSpan, message: String }

type TraceFrame {
  func_name: String
  span: SourceSpan
  bindings: Map<String, String>
}

type Trace {
  events: List<TraceEvent>
  stack: List<TraceFrame>
}

fn empty_trace() -> Trace {
  Trace { events: [], stack: [] }
}

fn trace_push_event(trace: Trace, event: TraceEvent) -> Trace {
  Trace { events: list_push(trace.events, event), stack: trace.stack }
}

fn trace_push_frame(trace: Trace, frame: TraceFrame) -> Trace {
  Trace { events: trace.events, stack: list_push(trace.stack, frame) }
}

fn trace_pop_frame(trace: Trace) -> Trace {
  let n = trace.stack |> count
  if n <= 1 {
    Trace { events: trace.events, stack: [] }
  } else {
    Trace { events: trace.events, stack: trace.stack |> take(n - 1) }
  }
}

fn event_span(event: TraceEvent) -> SourceSpan {
  match event {
    TraceEnter { node_id: _, span: s, inputs: _ } => s
    TraceExit { node_id: _, span: s, output: _ } => s
    TraceError { node_id: _, span: s, message: _ } => s
  }
}

fn event_node_id(event: TraceEvent) -> String {
  match event {
    TraceEnter { node_id: id, span: _, inputs: _ } => id
    TraceExit { node_id: id, span: _, output: _ } => id
    TraceError { node_id: id, span: _, message: _ } => id
  }
}

type TraceFilter
  = FilterByFunc { func_name: String }
  | FilterBySpan { start: Int, end: Int }
  | FilterErrors

fn event_matches_span(event: TraceEvent, filter_start: Int, filter_end: Int) -> Bool {
  let sp = event_span(event: event)
  sp.start >= filter_start && sp.start < filter_end
}

fn replay_trace(trace: Trace, filter: TraceFilter) -> List<TraceEvent> {
  match filter {
    FilterByFunc { func_name: name } =>
      trace.events |> filter(e => event_node_id(event: e) == name)
    FilterBySpan { start: s, end: e } =>
      trace.events |> filter(ev => event_matches_span(event: ev, filter_start: s, filter_end: e))
    FilterErrors =>
      trace.events |> filter(e => match e {
        TraceError { node_id: _, span: _, message: _ } => true
        _ => false
      })
  }
}

fn format_span(sp: SourceSpan) -> String {
  concat("[", to_string(sp.start), "..", to_string(sp.end), ")")
}

fn format_trace_event(event: TraceEvent) -> String {
  match event {
    TraceEnter { node_id: id, span: sp, inputs: _ } =>
      concat("> ", id, " at ", format_span(sp: sp))
    TraceExit { node_id: id, span: sp, output: out } =>
      concat("< ", id, " at ", format_span(sp: sp), ": ", out)
    TraceError { node_id: id, span: sp, message: msg } =>
      concat("! ", id, " at ", format_span(sp: sp), ": ", msg)
  }
}

fn format_trace(trace: Trace) -> List<String> {
  trace.events |> map(e => format_trace_event(event: e))
}

type ReproCase {
  func_name: String
  inputs: Map<String, String>
  expected_output: String?
  trace: Trace?
}

fn capture_repro(func_name: String, inputs: Map<String, String>, trace: Trace) -> ReproCase {
  ReproCase {
    func_name: func_name,
    inputs: inputs,
    expected_output: none,
    trace: Present { value: trace }
  }
}

type SourceMap {
  generated_file: String
  mappings: List<SpanMapping>
}

fn remap_location(source_map: SourceMap, generated_line: Int) -> SourceSpan? {
  source_map.mappings
    |> filter(m => m.generated_line <= generated_line)
    |> last
    |> map(m => m.source_span)
}
