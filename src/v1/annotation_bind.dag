module v1.compiler.annotation_bind
// The .dag realization of annotation attachment: it turns what the tokenizer captured into gap-bound rows by calling std.source_annotation.attach_annotations. Everything here is either .dag-specific — what the comment delimiter looks like — or a projection of facts the parser already published: the occurrence index and the source-extent table. The RULE itself is not here; a second copy of the rule beside the shared one is the fork this lane exists to prevent.
//
// It is a PURE DOWNSTREAM READER of the parse result. No allocator is in scope, so the identities it reads were all minted by the semantic parser before it ran, and no edit to a comment can shift one.

import std.types { Bool, Int, String, SourceSpan, List }
import std.occurrence_identity {
  OccurrenceId,
  OccurrenceIndexEntry,
  OccurrenceTransport
}
import std.source_annotation {
  AnnotationGap,
  AnnotationRegion,
  AnnotationScope,
  FileScope,
  OccurrenceScope,
  ErasedSourceRegion,
  NormalizedAnnotationCapture,
  SourceAnnotationGraph,
  KeyedAnnotationRow,
  SourceAnnotationDebt,
  UnboundAnnotationCapture,
  annotation_scope_key,
  attach_annotations,
  source_annotation_graph_rows
}
import v1.compiler.parse {
  ParsedSourceExtents
}

// THE REGION ROSTER IS THE PARSER'S PUBLISHED SOURCE STRUCTURE, read, never rebuilt. Every occurrence the index carries contributes its RECORDED extent (v1.compiler.parse ParsedSourceExtents, roadmap parse-node-source-extent), and every erased scope the parser published -- the parentheses of `(x)`, the braces of a one-statement block -- contributes its own region. Nothing here derives a range from descendants: an occurrence without a recorded extent contributes no region.
//
// THE PARENTS COME FROM CONTAINMENT, in one interval sweep, because the semantic tree cannot supply them for erased scopes. An erased scope may sit between a node and its parent (`((x))`), inside an occurrence that absorbed what it enclosed while that occurrence kept other children (`(a.b)(x)` keeps the receiver `a`, which lies INSIDE the parentheses), or beside another erased scope absorbed by the same occurrence (`g((1), (2))()`). The parser's extents nest -- the whole-population control in v1.tests.claim.parse_source_extent_control_test holds every occurrence inside its parent -- so sorting all regions by start, then by end descending, and keeping a stack of the regions still open gives each region the innermost one containing it. Two regions of EQUAL extent are a wrapper and what it wraps (an argument and its expression, a property and its value): the shallower occurrence, by containment depth, is the outer one; an erased scope is wider than what it encloses, so it can only tie with that node's wrappers, and it is inside them. One sort and one pass: O(n log n) per source.
fn ancestor_depth(entry: OccurrenceIndexEntry) -> Int {
  count(entry.containment.ancestors)
}

type SweptRegion {
  scope: AnnotationScope
  extent: SourceSpan
  depth: Int
}

type RegionSweepAcc {
  open: List<SweptRegion>
  regions: List<AnnotationRegion>
}

// The order the sweep reads regions in: by start; at one start the wider first; at one extent the
// shallower first. Three STABLE sorts, least significant key first, so no key is packed into a
// shared integer that a large offset could overflow. An erased scope sorts after every occurrence of
// the same extent: when an argument `(x)` and its parentheses share an extent, the argument wraps
// the parentheses, which wrap x.
fn erased_region_depth() -> Int {
  1000000000
}

fn swept_region_order(regions: List<SweptRegion>) -> List<SweptRegion> {
  regions
    |> sort_by(r => r.depth)
    |> sort_by(r => 0 - r.extent.end)
    |> sort_by(r => r.extent.start)
}

fn close_regions_ending_by(open: List<SweptRegion>, at: Int) -> List<SweptRegion> {
  match open |> last {
    Present { value: top } =>
      if top.extent.end <= at { close_regions_ending_by(open: open |> take(count(open) - 1), at: at) } else { open }
    Absent => open
  }
}

fn region_sweep_step(acc: RegionSweepAcc, region: SweptRegion) -> RegionSweepAcc {
  let open = close_regions_ending_by(open: acc.open, at: region.extent.start)
  let parent = match open |> last {
    Present { value: top } => top.scope
    Absent => FileScope
  }
  RegionSweepAcc {
    open: list_push(open, region),
    regions: list_push(acc.regions, AnnotationRegion { scope: region.scope, extent: region.extent, parent: parent }),
  }
}

fn annotation_regions(transport: OccurrenceTransport, extents: ParsedSourceExtents) -> List<AnnotationRegion> {
  let recorded = fold(extents.extents, init: empty_map(), f: (acc, row) => map_insert(acc, row.occurrence.value, row.extent))
  let occurrences = fold(transport.index.entries, init: [], f: (acc, entry) =>
    match map_get(recorded, entry.projection.occurrence.value) {
      Present { value: extent } => list_push(acc, SweptRegion { scope: OccurrenceScope { occurrence: entry.projection.occurrence }, extent: extent, depth: ancestor_depth(entry: entry) })
      Absent => acc
    })
  let erased = extents.erased_scopes |> map(scope => SweptRegion { scope: ErasedSourceRegion { extent: scope.extent }, extent: scope.extent, depth: erased_region_depth() })
  let swept = fold(
    swept_region_order(regions: concat(occurrences, erased)),
    init: RegionSweepAcc { open: [], regions: [] },
    f: (acc, region) => region_sweep_step(acc: acc, region: region)
  )
  swept.regions
}

// THE SPELLING HALF: the delimiter is stripped and rendered here, once. render_annotation_block's consumer is the round trip in v1.tests.claim.annotation_gap_round_trip_test, which renders a parsed graph back into source and re-parses it. No production .dag-source renderer exists yet; one that rewrites authored .dag from the semantic graph must write prose back through this spelling or it drops it.

// The single place `//` is removed, and it is here rather than in the tokenizer on purpose. A capture carries RAW syntax so the lexer reports what it saw; normalization into durable text is a language fact, and .dag's fact is that the delimiter is two slashes optionally followed by one space.

// Exactly one space is consumed, never a run, because `//   indented` is authored indentation the writer chose and swallowing it would silently rewrite the prose. A lexeme not starting with the delimiter passes through unchanged rather than being truncated by a fixed offset — that arm is unreachable through the .dag annotation rule today, and the alternative is a normalizer that corrupts content when it is wrong about its input.
fn strip_line_comment_delimiter(lexeme: String) -> String {
  let len = string_length(s: lexeme)
  if starts_with(s: lexeme, prefix: "// ") {
    substring(s: lexeme, start: 3, end: len)
  } else if starts_with(s: lexeme, prefix: "//") {
    substring(s: lexeme, start: 2, end: len)
  } else {
    lexeme
  }
}

// THE CANONICAL .dag SPELLING, and the inverse of strip_line_comment_delimiter directly above. It sits beside its inverse deliberately: the delimiter is stated once, and a change to what .dag strips is in the same edit as what .dag writes. Two functions in two modules agreeing about `//` by coincidence is the fork this lane removes.

// The form is a single `//` followed by one space, then the line's normalized text. The empty line renders as a bare `//` with NO trailing space, and that is a correctness case rather than tidiness: `// ` and `//` both normalize to the empty string, so either round-trips, but a trailing space is the character formatters and editors strip on save — so choosing the spelling that survives contact with a text editor is choosing the one that keeps the fixed point stable. An empty line inside a block is reachable: an author writing a bare `//` between two commented lines produces one block whose middle line is empty.

// Text is NOT re-indented, re-wrapped, or trimmed. `//   indented` normalizes to two spaces plus `indented` and renders back to `//   indented`, because the authored indentation is content — the strip step consumes exactly one space for exactly this reason, and a renderer that trimmed would delete authored structure on the first round trip.
fn render_line_comment_delimiter(line: String) -> String {
  if string_length(s: line) == 0 { "//" } else { concat("// ", line) }
}

// One row becomes one BLOCK: its embedded line breaks become adjacent annotation lines with nothing between them. Adjacency is what the grouping fold reads back as `one block`, so the joiner here and the blank-line rule below are the two halves of one law stated in std.source_annotation.
fn render_annotation_block(text: String) -> String {
  split(s: text, delimiter: "\n")
    |> map(line => render_line_comment_delimiter(line: line))
    |> join(separator: "\n")
}

// THE STRUCTURAL KEY OF A REGION, stable across parses: its path from the file root, each step the region's ordinal among its parent's children in source order and its authored name (an erased scope's name is `()`). Two parses of the same structure produce the same key; the same ordinals over different syntax produce different names and disagree, which is what an occurrence ordinal cannot do.
type RegionKeyIndex {
  parent_of: Map<String, AnnotationScope>
  step_of: Map<String, String>
}

fn region_label(scope: AnnotationScope, names: Map<Int, String>) -> String {
  match scope {
    FileScope => ""
    OccurrenceScope { occurrence: o } =>
      match map_get(names, o.value) {
        Present { value: n } => n
        Absent => "?"
      }
    ErasedSourceRegion { extent: _ } => "()"
  }
}

fn region_key_index(transport: OccurrenceTransport, regions: List<AnnotationRegion>) -> RegionKeyIndex {
  let names = fold(transport.index.entries, init: empty_map(), f: (acc, entry) =>
    map_insert(acc, entry.projection.occurrence.value, entry.projection.authored_name))
  let ordered = regions |> sort_by(r => r.extent.start)
  let stepped = fold(ordered, init: RegionKeyStepAcc { seen: empty_map(), step_of: empty_map() }, f: (acc, region) =>
    let parent_key = annotation_scope_key(scope: region.parent)
    let ordinal = match map_get(acc.seen, parent_key) { Present { value: n } => n  Absent => 0 }
    RegionKeyStepAcc {
      seen: map_insert(acc.seen, parent_key, ordinal + 1),
      step_of: map_insert(acc.step_of, annotation_scope_key(scope: region.scope), concat(to_string(ordinal), ":", region_label(scope: region.scope, names: names))),
    })
  RegionKeyIndex {
    parent_of: fold(regions, init: empty_map(), f: (acc, region) => map_insert(acc, annotation_scope_key(scope: region.scope), region.parent)),
    step_of: stepped.step_of,
  }
}

type RegionKeyStepAcc {
  seen: Map<String, Int>
  step_of: Map<String, String>
}

// Walks parent links to the file; `depth` bounds the walk by the roster's size, so a malformed parent cycle ends rather than loops.
fn region_structural_key(index: RegionKeyIndex, scope: AnnotationScope, depth: Int) -> String {
  match scope {
    FileScope => "/"
    _ =>
      if depth <= 0 { "?" } else {
        let key = annotation_scope_key(scope: scope)
        let step = match map_get(index.step_of, key) { Present { value: s } => s  Absent => "?" }
        match map_get(index.parent_of, key) {
          Present { value: parent } => concat(region_structural_key(index: index, scope: parent, depth: depth - 1), "/", step)
          Absent => concat("/?", step)
        }
      }
  }
}

fn optional_region_key(index: RegionKeyIndex, scope: AnnotationScope?, depth: Int) -> String? {
  match scope {
    Present { value: s } => Present { value: region_structural_key(index: index, scope: s, depth: depth) }
    Absent => none
  }
}

// Projects a graph's rows onto the cross-parse structural keys std.source_annotation's agreement is defined over.
fn keyed_annotation_rows(
  transport: OccurrenceTransport,
  extents: ParsedSourceExtents,
  graph: SourceAnnotationGraph
) -> List<KeyedAnnotationRow> {
  let regions = annotation_regions(transport: transport, extents: extents)
  let index = region_key_index(transport: transport, regions: regions)
  let depth = count(regions) + 1
  source_annotation_graph_rows(graph: graph)
    |> map(row => KeyedAnnotationRow {
      scope_key: region_structural_key(index: index, scope: row.gap.scope, depth: depth),
      before_key: optional_region_key(index: index, scope: row.gap.before, depth: depth),
      after_key: optional_region_key(index: index, scope: row.gap.after, depth: depth),
      text: row.text,
    })
}

// Every region's structural key with its extent, from the same index keyed_annotation_rows reads. Its consumer is the render half of the round trip (v1.tests.claim.annotation_gap_round_trip_test), which writes a row back at the region its key names in a re-parsed source.
type KeyedAnnotationRegion {
  key: String
  extent: SourceSpan
}

fn keyed_annotation_regions(transport: OccurrenceTransport, extents: ParsedSourceExtents) -> List<KeyedAnnotationRegion> {
  let regions = annotation_regions(transport: transport, extents: extents)
  let index = region_key_index(transport: transport, regions: regions)
  let depth = count(regions) + 1
  regions |> map(r => KeyedAnnotationRegion { key: region_structural_key(index: index, scope: r.scope, depth: depth), extent: r.extent })
}

fn normalize_dag_annotation(capture: UnboundAnnotationCapture) -> NormalizedAnnotationCapture {
  NormalizedAnnotationCapture {
    text: strip_line_comment_delimiter(lexeme: capture.lexeme),
    origin: capture.origin,
    placement: capture.placement,
    preceded_by_blank_line: capture.preceded_by_blank_line,
    preceded_by_annotation_line: capture.preceded_by_annotation_line,
  }
}

// The .dag entry point: normalize, roster, attach. The attach step is the shared fold, so a change to the attachment rule reaches every realization together. It cannot refuse -- every comment has a gap -- so it returns the graph and nothing beside it.
fn bind_annotations(
  transport: OccurrenceTransport,
  extents: ParsedSourceExtents,
  captures: List<UnboundAnnotationCapture>
) -> SourceAnnotationGraph {
  attach_annotations(
    captures: captures |> map(capture => normalize_dag_annotation(capture: capture)),
    regions: annotation_regions(transport: transport, extents: extents)
  )
}
