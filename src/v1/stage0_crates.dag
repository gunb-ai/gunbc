module v1.compiler.stage0_crates

import v1.std.core { TextFile }
import v1.compiler.emit_rust { emit_non_empty_wrappers, emit_cargo_dep }
import extdeps.cargo { CargoDependency, CargoFeature, RegistryDep, LocalPathDep }
import extdeps.cargo_version { render_cargo_package_header_prefix }

type Stage0CrateKind
  = CoreCrate
  | EmitCoreCrate

type Stage0CrateSpec {
  package_name: String
  crate_dir: String
  kind: Stage0CrateKind
  header_doc: String
  modules: List<String>
  dependencies: List<CargoDependency>

  features: List<CargoFeature>

  carries_non_empty_wrappers: Bool
}

type Stage0CratePlan {
  crates: List<Stage0CrateSpec>
}

fn stage0_crate_allow_block() -> String {
  [
    "#![allow(",
    "    unused_imports,",
    "    unused_variables,",
    "    unused_mut,",
    "    unused_parens,",
    "    dead_code,",
    "    unreachable_patterns,",
    "    non_shorthand_field_patterns,",
    "    suspicious_double_ref_op,",
    "    non_camel_case_types,",
    "    clippy::all",
    ")]"
  ] |> join(separator: "\n")
}

fn stage0_core_header_doc() -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Crate boundary for generated v2 stage0 core authorities.",
    "//!",
    "//! The module bodies remain generated into `src/v1/stage0/src`. This crate",
    "//! exposes the lower std/runtime/artifact/language/infer support surface",
    "//! without copying generated module bodies. The root `NonEmpty*` wrappers are",
    "//! mirrored from the stage0 lib root because generated modules address them as",
    "//! `crate::NonEmptyVec` and `crate::NonEmptyBTreeSet`."
  ] |> join(separator: "\n")
}

fn stage0_emit_core_header_doc() -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Crate boundary proof for generated v2 emit core support.",
    "//!",
    "//! The semantic bodies remain generated from `src/v1/05_emit_core_support.dag`",
    "//! into the stage0 seed. This crate exposes that generated support surface",
    "//! through `v1-stage0-core`, avoiding copied Rust semantics."
  ] |> join(separator: "\n")
}

fn render_stage0_crate_dep(dep: CargoDependency) -> String {
  match dep.source {
    RegistryDep { version: version, features: features } =>
      emit_cargo_dep(name: dep.name, version: version, features: features)
    LocalPathDep { path: path } =>
      concat(dep.name, " = { path = \"", path, "\" }\n")
  }
}

fn render_stage0_crate_feature(feature: CargoFeature) -> String {
  if (feature.dependencies |> count) == 0 {
    concat(feature.name, " = []\n")
  } else {
    let dep_names = feature.dependencies |> map(d => concat("\"", d, "\"")) |> join(separator: ", ")
    concat(feature.name, " = [", dep_names, "]\n")
  }
}

fn render_stage0_crate_features_section(features: List<CargoFeature>) -> String {
  if (features |> count) == 0 {
    ""
  } else {
    concat(
      "\n[features]\n",
      "default = []\n",
      features |> map(render_stage0_crate_feature) |> join(separator: "")
    )
  }
}

fn emit_stage0_crate_manifest(spec: Stage0CrateSpec) -> TextFile {
  let deps = spec.dependencies |> map(render_stage0_crate_dep) |> join(separator: "")
  let content = concat(
    render_cargo_package_header_prefix(name: spec.package_name),
    "\nedition = \"2021\"",
    render_stage0_crate_features_section(features: spec.features),
    "\n\n[dependencies]\n",
    deps
  )
  TextFile { path: concat(spec.crate_dir, "/Cargo.toml"), content: content }
}

fn render_stage0_core_lib(spec: Stage0CrateSpec) -> String {
  let includes = spec.modules
    |> map(m => concat("#[path = \"../../stage0/src/", m, ".rs\"]\npub mod ", m, ";"))
    |> join(separator: "\n")
  let head = concat(
    spec.header_doc, "\n\n",
    stage0_crate_allow_block(), "\n\n",
    includes
  )
  if spec.carries_non_empty_wrappers {
    concat(head, "\n\n", emit_non_empty_wrappers(), "\n")
  } else {
    concat(head, "\n")
  }
}

fn render_stage0_emit_core_lib(spec: Stage0CrateSpec) -> String {
  let reexports = spec.modules
    |> map(m => concat("pub mod ", m, " {\n    pub use v1_stage0_core::", m, "::*;\n}"))
    |> join(separator: "\n\n")
  concat(
    spec.header_doc, "\n\n",
    stage0_crate_allow_block(), "\n\n",
    "pub use v1_stage0_core::\{NonEmptyBTreeSet, NonEmptyVec};", "\n\n",
    reexports, "\n\n",
    "#[path = \"../../stage0/src/v1_compiler_emit_core_support.rs\"]\npub mod v1_compiler_emit_core_support;", "\n\n",
    "pub use v1_compiler_emit_core_support::*;", "\n"
  )
}

fn emit_stage0_crate_lib(spec: Stage0CrateSpec) -> TextFile {
  let content = match spec.kind {
    CoreCrate => render_stage0_core_lib(spec)
    EmitCoreCrate => render_stage0_emit_core_lib(spec)
  }
  TextFile { path: concat(spec.crate_dir, "/src/lib.rs"), content: content }
}

fn stage0_crate_plan() -> Stage0CratePlan {
  Stage0CratePlan {
    crates: [
      Stage0CrateSpec {
        package_name: "v1-stage0-core",
        crate_dir: "src/v1/stage0_core",
        kind: CoreCrate,
        header_doc: stage0_core_header_doc(),
        modules: [
          "extdeps_external_authority",
          "extdeps_languages_dag_emit",
          "extdeps_languages_dag_syntax",
          "extdeps_languages_dag_types",
          "extdeps_languages_go_emit",
          "extdeps_languages_go_syntax",
          "extdeps_languages_go_types",
          "extdeps_languages_python_emit",
          "extdeps_languages_python_syntax",
          "extdeps_languages_python_types",
          "extdeps_languages_rust_emit",
          "extdeps_languages_rust_syntax",
          "extdeps_languages_rust_types",
          "extdeps_uri",
          "extdeps_uri_path",
          "std_algebra",
          "std_coercion",
          "std_computation",
          "std_effects",
          "std_emit_model",
          "std_error_primitives",
          "std_graph",
          "std_http_path",
          "std_induction",
          "std_integer",
          "std_iteration",
          "std_lens_verdict",
          "std_list",
          "std_logic",
          "std_machine_constraints",
          "std_magnitude",
          "std_measure",
          "std_nat",
          "std_node",
          "std_pareto",
          "std_realization_schedule",
          "std_serialization",
          "std_syntax",
          "std_termination",
          "std_types",
          "v1_compiler_artifact",
          "v1_compiler_infer_emit_info",
          "v1_compiler_infer_env",
          "v1_compiler_infer_items",
          "v1_compiler_infer_service",
          "v1_compiler_infer_sigs",
          "v1_compiler_infer_types",
          "v1_compiler_languages",
          "v1_rt",
          "v1_std_core"
        ],
        dependencies: [
          CargoDependency { name: "stacker", source: RegistryDep { version: "0.1", features: [] } },
          CargoDependency { name: "serde", source: RegistryDep { version: "1", features: ["derive", "rc"] } },
          CargoDependency { name: "serde_json", source: RegistryDep { version: "1", features: [] } },
          CargoDependency { name: "unicode-ident", source: RegistryDep { version: "1", features: [] } },
          CargoDependency { name: "unicode-properties", source: RegistryDep { version: "0.1", features: ["emoji"] } }
        ],
        features: [
          CargoFeature { name: "text_lookup_work_counter", dependencies: [] }
        ],
        carries_non_empty_wrappers: true
      },
      Stage0CrateSpec {
        package_name: "v1-stage0-emit-core",
        crate_dir: "src/v1/stage0_emit_core",
        kind: EmitCoreCrate,
        header_doc: stage0_emit_core_header_doc(),
        modules: [
          "v1_compiler_artifact",
          "v1_compiler_infer_items",
          "v1_compiler_infer_service",
          "v1_compiler_infer_types",
          "v1_compiler_languages",
          "v1_rt",
          "v1_std_core"
        ],
        dependencies: [
          CargoDependency { name: "stacker", source: RegistryDep { version: "0.1", features: [] } },
          CargoDependency { name: "serde", source: RegistryDep { version: "1", features: ["derive", "rc"] } },
          CargoDependency { name: "v1-stage0-core", source: LocalPathDep { path: "../stage0_core" } }
        ],
        features: [],
        carries_non_empty_wrappers: false
      }
    ]
  }
}

fn emit_stage0_crate_boundary_files(plan: Stage0CratePlan) -> List<TextFile> {
  plan.crates |> flat_map(spec => [
    emit_stage0_crate_manifest(spec),
    emit_stage0_crate_lib(spec)
  ])
}

fn stage0_crate_boundary_files() -> List<TextFile> {
  emit_stage0_crate_boundary_files(stage0_crate_plan())
}
