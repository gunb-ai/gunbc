module v1.compiler.stage0_crates

import v1.std.core { TextFile }
import v1.compiler.emit_rust { emit_non_empty_wrappers, emit_cargo_dep }
import extdeps.cargo { CargoDependency, CargoFeature, RegistryDep, LocalPathDep }
import extdeps.cargo_version { render_cargo_package_header_prefix }

type Stage0PartitionCrateKind
  = Stage0FoundationCrate
  | Stage0LayeredCoreCrate
  | Stage0EmitCoreCrate

type Stage0PartitionCrateRow {
  package_name: String
  crate_dir: String
  kind: Stage0PartitionCrateKind
  modules: List<String>
  reexport_packages: List<String>
  carries_non_empty_wrappers: Bool
}

data stage0_crate_plan_dissolve_on: String = "dissolve-on: stage0_crate_plan_interim_explicit — regen-closure mirror of v2.workflow.rust_crate_partition HandExplicit rows; dissolves when PolicyPartition replaces ExplicitPartition (see rust_crate_partition_dissolve_on)."

