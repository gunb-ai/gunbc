module v1.compiler.stage0_crates

import v1.std.core { TextFile }
import v1.compiler.emit_rust { emit_non_empty_wrappers, emit_cargo_dep }
import extdeps.cargo { CargoDependency, CargoFeature, RegistryDep, LocalPathDep }
import extdeps.cargo_version { render_cargo_package_header_prefix }
import v2.workflow.rust_crate_partition {
  Stage0EmitCoreCrate,
  Stage0FoundationCrate,
  Stage0LayeredCoreCrate,
  Stage0PartitionCrateRow,
  stage0_partition_crate_rows,
  stage0_partition_provenance,
  rust_crate_partition_dissolve_on,
  rust_crate_partition_note
}

type Stage0CrateKind
  = FoundationCrate
  | LayeredCoreCrate
  | EmitCoreCrate

type Stage0CrateSpec {
  package_name: String
  crate_dir: String
  kind: Stage0CrateKind
  header_doc: String
  modules: List<String>
  dependencies: List<CargoDependency>
  reexport_packages: List<String>
  features: List<CargoFeature>
  carries_non_empty_wrappers: Bool
}

type Stage0CratePlan {
  crates: List<Stage0CrateSpec>
}

data stage0_crate_plan_note: String = "Realizes the shared CompilationUnit shape via v2.workflow.rust_crate_partition (HandExplicit provenance; dissolves to PolicyDerived when balanced partition policy lands). Replaces the former hand membership ledger in stage0_crate_plan()."

fn stage0_crate_allow_block() -> String {
  [
    "#![allow(",
    "    unused_imports,",
    "    unused_variables,",
    "    unused_mut,",
    "    unused_parens,",
    "    dead_code,",
    "    unreachable_patterns,",
    "    non_shorthand_field_patterns,",
    "    suspicious_double_ref_op,",
    "    clippy::all",
    ")]"
  ] |> join(separator: "\n")
}

fn stage0_foundation_header_doc(package_name: String) -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Foundation crate boundary for generated v2 stage0 support (",
    package_name,
    ").",
    "//!",
    "//! Module bodies remain generated into `src/v1/stage0/src`. This crate",
    "//! is the first layer in the HandExplicit ~8-crate partition realized via",
    "//! `v2.workflow.rust_crate_partition` against the shared CompilationUnit home."
  ] |> join(separator: "\n")
}

fn stage0_layered_core_header_doc(package_name: String) -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Layered core crate boundary (",
    package_name,
    ").",
    "//!",
    "//! Re-exports lower partition layers at the crate root so generated",
    "//! module bodies can keep addressing dependencies as `crate::...`."
  ] |> join(separator: "\n")
}

fn stage0_emit_core_header_doc() -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Emit-core crate boundary for generated v2 emit support.",
    "//!",
    "//! The semantic bodies remain generated from `src/v1/05_emit_core_support.dag`",
    "//! into the stage0 seed. This crate exposes the emit surface through the",
    "//! partitioned stage0 stack, avoiding copied Rust semantics."
  ] |> join(separator: "\n")
}

fn render_stage0_crate_dep(dep: CargoDependency) -> String {
  match dep.source {
    RegistryDep { version: version, features: features } =>
      emit_cargo_dep(name: dep.name, version: version, features: features)
    LocalPathDep { path: path } =>
      concat(dep.name, " = { path = \"", path, "\" }\n")
  }
}

fn render_stage0_crate_feature(feature: CargoFeature) -> String {
  if (feature.dependencies |> count) == 0 {
    concat(feature.name, " = []\n")
  } else {
    let dep_names = feature.dependencies |> map(d => concat("\"", d, "\"")) |> join(separator: ", ")
    concat(feature.name, " = [", dep_names, "]\n")
  }
}

fn render_stage0_crate_features_section(features: List<CargoFeature>) -> String {
  if (features |> count) == 0 {
    ""
  } else {
    concat(
      "\n[features]\n",
      "default = []\n",
      features |> map(render_stage0_crate_feature) |> join(separator: "")
    )
  }
}

fn emit_stage0_crate_manifest(spec: Stage0CrateSpec) -> TextFile {
  let deps = spec.dependencies |> map(render_stage0_crate_dep) |> join(separator: "")
  let content = concat(
    render_cargo_package_header_prefix(name: spec.package_name),
    "\nedition = \"2021\"",
    render_stage0_crate_features_section(features: spec.features),
    "\n\n[dependencies]\n",
    deps
  )
  TextFile { path: concat(spec.crate_dir, "/Cargo.toml"), content: content }
}

fn render_stage0_foundation_lib(spec: Stage0CrateSpec) -> String {
  let includes = spec.modules
    |> map(m => concat("#[path = \"../../stage0/src/", m, ".rs\"]\npub mod ", m, ";"))
    |> join(separator: "\n")
  let head = concat(
    spec.header_doc, "\n\n",
    stage0_crate_allow_block(), "\n\n",
    includes
  )
  if spec.carries_non_empty_wrappers {
    concat(head, "\n\n", emit_non_empty_wrappers(), "\n")
  } else {
    concat(head, "\n")
  }
}

fn render_stage0_reexport_block(packages: List<String>) -> String {
  if (packages |> count) == 0 {
    ""
  } else {
    packages
      |> map(pkg => concat("pub use ", pkg, "::*;"))
      |> join(separator: "\n")
      |> concat("\n\n", _, "\n\n")
  }
}

fn render_stage0_layered_core_lib(spec: Stage0CrateSpec) -> String {
  let includes = spec.modules
    |> map(m => concat("#[path = \"../../stage0/src/", m, ".rs\"]\npub mod ", m, ";"))
    |> join(separator: "\n")
  concat(
    spec.header_doc, "\n\n",
    stage0_crate_allow_block(), "\n\n",
    render_stage0_reexport_block(packages: spec.reexport_packages),
    includes, "\n"
  )
}

fn render_stage0_emit_core_lib(spec: Stage0CrateSpec) -> String {
  let reexports = spec.modules
    |> map(m => concat("pub mod ", m, " {\n    pub use v1_stage0_v1_compiler::", m, "::*;\n}"))
    |> join(separator: "\n\n")
  concat(
    spec.header_doc, "\n\n",
    stage0_crate_allow_block(), "\n\n",
    "pub use v1_stage0_runtime::{NonEmptyBTreeSet, NonEmptyVec};", "\n\n",
    reexports, "\n\n",
    "#[path = \"../../stage0/src/v1_compiler_emit_core_support.rs\"]\npub mod v1_compiler_emit_core_support;", "\n\n",
    "pub use v1_compiler_emit_core_support::*;", "\n"
  )
}

fn emit_stage0_crate_lib(spec: Stage0CrateSpec) -> TextFile {
  let content = match spec.kind {
    FoundationCrate => render_stage0_foundation_lib(spec)
    LayeredCoreCrate => render_stage0_layered_core_lib(spec)
    EmitCoreCrate => render_stage0_emit_core_lib(spec)
  }
  TextFile { path: concat(spec.crate_dir, "/src/lib.rs"), content: content }
}

fn stage0_registry_dependencies() -> List<CargoDependency> {
  [
    CargoDependency { name: "stacker", source: RegistryDep { version: "0.1", features: [] } },
    CargoDependency { name: "im-rc", source: RegistryDep { version: "15.1", features: ["serde"] } },
    CargoDependency { name: "serde", source: RegistryDep { version: "1", features: ["derive", "rc"] } },
    CargoDependency { name: "serde_json", source: RegistryDep { version: "1", features: [] } },
    CargoDependency { name: "unicode-ident", source: RegistryDep { version: "1", features: [] } },
    CargoDependency { name: "unicode-properties", source: RegistryDep { version: "0.1", features: ["emoji"] } }
  ]
}

fn stage0_local_path_dep(name: String, path: String) -> CargoDependency {
  CargoDependency { name: name, source: LocalPathDep { path: path } }
}

fn stage0_reexport_path_deps(packages: List<String>) -> List<CargoDependency> {
  packages
    |> map(pkg => stage0_local_path_dep(
      name: pkg,
      path: concat("../", pkg |> replace(old: "v1-stage0-", new: "stage0_"))
    ))
}

fn stage0_partition_kind_from_row(kind: Stage0PartitionCrateKind) -> Stage0CrateKind {
  match kind {
    Stage0FoundationCrate => FoundationCrate
    Stage0LayeredCoreCrate => LayeredCoreCrate
    Stage0EmitCoreCrate => EmitCoreCrate
  }
}

fn stage0_header_doc_for_row(row: Stage0PartitionCrateRow) -> String {
  match row.kind {
    Stage0FoundationCrate => stage0_foundation_header_doc(package_name: row.package_name)
    Stage0LayeredCoreCrate => stage0_layered_core_header_doc(package_name: row.package_name)
    Stage0EmitCoreCrate => stage0_emit_core_header_doc()
  }
}

fn stage0_dependencies_for_row(row: Stage0PartitionCrateRow) -> List<CargoDependency> {
  match row.kind {
    Stage0FoundationCrate => stage0_registry_dependencies()
    Stage0LayeredCoreCrate =>
      stage0_registry_dependencies()
        |> concat(stage0_reexport_path_deps(packages: row.reexport_packages))
    Stage0EmitCoreCrate => [
      CargoDependency { name: "stacker", source: RegistryDep { version: "0.1", features: [] } },
      CargoDependency { name: "im-rc", source: RegistryDep { version: "15.1", features: ["serde"] } },
      CargoDependency { name: "serde", source: RegistryDep { version: "1", features: ["derive", "rc"] } },
      stage0_local_path_dep(name: "v1-stage0-v1-compiler", path: "../stage0_v1_compiler"),
      stage0_local_path_dep(name: "v1-stage0-runtime", path: "../stage0_runtime")
    ]
  }
}

fn stage0_features_for_row(row: Stage0PartitionCrateRow) -> List<CargoFeature> {
  match row.kind {
    Stage0FoundationCrate => [
      CargoFeature { name: "text_lookup_work_counter", dependencies: [] }
    ]
    Stage0LayeredCoreCrate => []
    Stage0EmitCoreCrate => []
  }
}

fn stage0_crate_spec_from_partition_row(row: Stage0PartitionCrateRow) -> Stage0CrateSpec {
  Stage0CrateSpec {
    package_name: row.package_name
    crate_dir: row.crate_dir
    kind: stage0_partition_kind_from_row(kind: row.kind)
    header_doc: stage0_header_doc_for_row(row: row)
    modules: row.modules
    dependencies: stage0_dependencies_for_row(row: row)
    reexport_packages: row.reexport_packages
    features: stage0_features_for_row(row: row)
    carries_non_empty_wrappers: row.carries_non_empty_wrappers
  }
}

fn stage0_crate_plan() -> Stage0CratePlan {
  Stage0CratePlan {
    crates: stage0_partition_crate_rows()
      |> map(stage0_crate_spec_from_partition_row)
  }
}

fn emit_stage0_crate_boundary_files(plan: Stage0CratePlan) -> List<TextFile> {
  plan.crates |> flat_map(spec => [
    emit_stage0_crate_manifest(spec),
    emit_stage0_crate_lib(spec)
  ])
}

fn stage0_crate_boundary_files() -> List<TextFile> {
  emit_stage0_crate_boundary_files(stage0_crate_plan())
}
