module v1.compiler.stage0_crates

import v1.std.core { TextFile }
import v1.compiler.emit_rust { emit_non_empty_wrappers, emit_cargo_dep }
import extdeps.cargo { CargoDependency, CargoFeature, RegistryDep, LocalPathDep }
import extdeps.cargo_version { render_cargo_package_header_prefix }
import gunbc.stage0_crate_partition_generated {
  GeneratedEmitCoreCrate,
  GeneratedFoundationCrate,
  GeneratedLayeredCoreCrate,
  GeneratedPartitionCrateRow,
  generated_partition_crate_rows
}

type Stage0CrateKind
  = FoundationCrate
  | LayeredCoreCrate
  | EmitCoreCrate

type Stage0CrateSpec {
  package_name: String
  crate_dir: String
  kind: Stage0CrateKind
  header_doc: String
  modules: List<String>
  reexport_packages: List<String>
  dependencies: List<CargoDependency>
  features: List<CargoFeature>
  carries_non_empty_wrappers: Bool
}

type Stage0CratePlan {
  crates: List<Stage0CrateSpec>
}

data stage0_crate_plan_note: String = "Derived from v2.workflow.rust_crate_partition via gunbc.stage0_crate_partition_generated (HandExplicit ~8-crate interim partition). Dissolve-on: rust_crate_partition_interim_explicit when PolicyPartition lands."

data stage0_crate_plan_list_wrapper_dissolve_on: String = "dissolve-on: stage0_crate_plan — deleted; receipt paths must call stage0_crate_plan_outcome (§5 empty-plan wrapper collapsed Stage0CratePlanRefused to crates:[]). workspace_members and regen_stage0 consume outcome surfaces only."

fn stage0_crate_allow_block() -> String {
  [
    "#![allow(",
    "    unused_imports,",
    "    unused_variables,",
    "    unused_mut,",
    "    unused_parens,",
    "    dead_code,",
    "    non_shorthand_field_patterns,",
    "    suspicious_double_ref_op,",
    "    clippy::all",
    ")]",
    "#![deny(unreachable_patterns)]"
  ] |> join(separator: "\n")
}

data unreachable_patterns_deny_note: String = "unreachable_patterns is DENIED, not allowed (DESIGN §5 no-escape-hatches). The emitter lowers a nested variant pattern by hoisting the inner discriminant out of the arm into a `let .. = x.as_ref() else { unreachable!() }` prelude, because Rust cannot match through Arc<T> in a pattern. That is sound for ONE arm per outer constructor; two arms sharing an outer constructor collapse to identical Rust patterns, so the second is unreachable and the FIRST panics on any value it did not expect. Allowing unreachable_patterns suppressed the one signal that detects this -- the deficit frequency was zero by construction, so it never ranked for fixing (the exact §5 absorbing shape). Denying converts each occurrence into a located compile error. Proven by execution: reintroducing the nested-pattern form in std.effects.check_modifier_vs_derivation reds std_effects.rs with `unreachable pattern`; the corpus otherwise carried exactly ONE occurrence (a redundant wildcard in v1.compiler.emit.classify_expr, removed with this change). RESIDUE: this is validation, not construction -- the emitter still GENERATES the broken lowering and is merely caught downstream. The construction fix is to group arms sharing an outer constructor into a nested match (the form the emitter already lowers correctly); tracked as follow-on emitter work."

fn stage0_foundation_header_doc() -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Foundation crate for the derived ~8-crate stage0 partition.",
    "//!",
    "//! Module bodies remain generated into `src/v1/stage0/src`. The root",
    "//! `NonEmpty*` wrappers are mirrored here because generated modules address",
    "//! them as `crate::NonEmptyVec` and `crate::NonEmptyBTreeSet`."
  ] |> join(separator: "\n")
}

fn stage0_layered_core_header_doc() -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Layered core crate in the derived stage0 partition.",
    "//!",
    "//! Owns its module bodies via path includes and re-exports lower partition",
    "//! crates so `crate::` references in generated modules keep resolving."
  ] |> join(separator: "\n")
}

fn stage0_emit_core_header_doc() -> String {
  [
    "//! Generated by regen_stage0 -- do not edit.",
    "//!",
    "//! Emit-shell crate in the derived stage0 partition.",
    "//!",
    "//! Re-exports the emit surface from module-bearing partition crates and",
    "//! hosts `v1_compiler_emit_core_support` without copying semantics."
  ] |> join(separator: "\n")
}

fn stage0_package_name_to_rust_ident(package_name: String) -> String {
  replace(package_name, "-", "_")
}

fn stage0_crate_dir_to_sibling_dep_path(crate_dir: String) -> String {
  replace(crate_dir, "src/v1/", "../")
}

fn stage0_partition_row_is_module_bearing(row: GeneratedPartitionCrateRow) -> Bool {
  match row.kind {
    GeneratedEmitCoreCrate => false
    GeneratedFoundationCrate => true
    GeneratedLayeredCoreCrate => true
  }
}

type Stage0ModuleOwnerRefusalCause
  = Stage0ModuleOwnerMissing { module_basename: String }

type Stage0ModuleOwnerLookup
  = Stage0ModuleOwnerFound { package_name: String }
  | Stage0ModuleOwnerRefused { cause: Stage0ModuleOwnerRefusalCause }

type Stage0PackageCrateDirRefusalCause
  = Stage0PackageCrateDirMissing { package_name: String }

type Stage0PackageCrateDirLookup
  = Stage0PackageCrateDirFound { crate_dir: String }
  | Stage0PackageCrateDirRefused { cause: Stage0PackageCrateDirRefusalCause }

type Stage0ReexportPathDepsOutcome
  = Stage0ReexportPathDepsOk { deps: List<CargoDependency> }
  | Stage0ReexportPathDepsRefused { cause: Stage0PackageCrateDirRefusalCause }

type Stage0EmitShellReexportsOutcome
  = Stage0EmitShellReexportsOk { lines: List<String> }
  | Stage0EmitShellReexportsRefused { cause: Stage0ModuleOwnerRefusalCause }

type Stage0PartitionRowDepsOutcome
  = Stage0PartitionRowDepsOk { deps: List<CargoDependency> }
  | Stage0PartitionRowDepsRefused { cause: Stage0PackageCrateDirRefusalCause }

type Stage0PartitionRowSpecOutcome
  = Stage0PartitionRowSpecOk { spec: Stage0CrateSpec }
  | Stage0PartitionRowSpecRefused { cause: Stage0PackageCrateDirRefusalCause }

type Stage0CratePlanOutcome
  = Stage0CratePlanOk { plan: Stage0CratePlan }
  | Stage0CratePlanRefused { cause: Stage0PackageCrateDirRefusalCause }

type Stage0CrateLibEmitOutcome
  = Stage0CrateLibEmitOk { file: TextFile }
  | Stage0CrateLibEmitRefused { cause: Stage0ModuleOwnerRefusalCause }

type Stage0CrateBoundaryEmitRefusalCause
  = Stage0CrateBoundaryEmitModuleOwnerMissing { module_basename: String }
  | Stage0CrateBoundaryEmitPackageCrateDirMissing { package_name: String }

type Stage0CrateBoundaryEmitOutcome
  = Stage0CrateBoundaryEmitOk { files: List<TextFile> }
  | Stage0CrateBoundaryEmitRefused { cause: Stage0CrateBoundaryEmitRefusalCause }

fn stage0_lookup_module_owner_package_name(module_basename: String) -> Stage0ModuleOwnerLookup {
  let matches = generated_partition_crate_rows
    |> filter(row =>
      stage0_partition_row_is_module_bearing(row: row)
        && (row.modules |> any(m => m == module_basename))
    )
  let package_name = matches
    |> map(row => row.package_name)
    |> fold(init: "", f: fn(acc, pkg) { if acc == "" { pkg } else { acc } })
  if package_name == "" {
    Stage0ModuleOwnerRefused {
      cause: Stage0ModuleOwnerMissing { module_basename: module_basename }
    }
  } else {
    Stage0ModuleOwnerFound { package_name: package_name }
  }
}

fn stage0_lookup_package_crate_dir(package_name: String) -> Stage0PackageCrateDirLookup {
  let matches = generated_partition_crate_rows
    |> filter(row => row.package_name == package_name)
  let crate_dir = matches
    |> fold(init: "", f: fn(acc, row) { if acc == "" { row.crate_dir } else { acc } })
  if crate_dir == "" {
    Stage0PackageCrateDirRefused {
      cause: Stage0PackageCrateDirMissing { package_name: package_name }
    }
  } else {
    Stage0PackageCrateDirFound { crate_dir: crate_dir }
  }
}

fn stage0_map_package_dir_refusal_to_boundary(
  cause: Stage0PackageCrateDirRefusalCause
) -> Stage0CrateBoundaryEmitRefusalCause {
  match cause {
    Stage0PackageCrateDirMissing { package_name: package_name } =>
      Stage0CrateBoundaryEmitPackageCrateDirMissing { package_name: package_name }
  }
}

fn stage0_map_module_owner_refusal_to_boundary(
  cause: Stage0ModuleOwnerRefusalCause
) -> Stage0CrateBoundaryEmitRefusalCause {
  match cause {
    Stage0ModuleOwnerMissing { module_basename: module_basename } =>
      Stage0CrateBoundaryEmitModuleOwnerMissing { module_basename: module_basename }
  }
}

fn stage0_crate_boundary_emit_refusal_message(
  cause: Stage0CrateBoundaryEmitRefusalCause
) -> String {
  match cause {
    Stage0CrateBoundaryEmitModuleOwnerMissing { module_basename: module_basename } =>
      concat(
        "stage0 partition emit refused: missing module owner for ",
        module_basename
      )
    Stage0CrateBoundaryEmitPackageCrateDirMissing { package_name: package_name } =>
      concat(
        "stage0 partition emit refused: missing package crate_dir for ",
        package_name
      )
  }
}

fn stage0_foundation_runtime_dependencies() -> List<CargoDependency> {
  [
    CargoDependency { name: "stacker", source: RegistryDep { version: "0.1", features: [] } },
    CargoDependency { name: "im", source: RegistryDep { version: "15.1", features: ["serde"] } },
    CargoDependency { name: "serde", source: RegistryDep { version: "1", features: ["derive", "rc"] } },
    CargoDependency { name: "serde_json", source: RegistryDep { version: "1", features: [] } },
    CargoDependency { name: "unicode-ident", source: RegistryDep { version: "1", features: [] } },
    CargoDependency { name: "unicode-properties", source: RegistryDep { version: "0.1", features: ["emoji"] } }
  ]
}

fn stage0_emit_shell_registry_dependencies() -> List<CargoDependency> {
  [
    CargoDependency { name: "stacker", source: RegistryDep { version: "0.1", features: [] } },
    CargoDependency { name: "im", source: RegistryDep { version: "15.1", features: ["serde"] } },
    CargoDependency { name: "serde", source: RegistryDep { version: "1", features: ["derive", "rc"] } }
  ]
}

fn stage0_reexport_path_dependencies_outcome(
  reexport_packages: List<String>
) -> Stage0ReexportPathDepsOutcome {
  reexport_packages
    |> fold(init: Stage0ReexportPathDepsOk { deps: [] }, f: fn(acc, pkg) {
      match acc {
        Stage0ReexportPathDepsRefused { cause: cause } =>
          Stage0ReexportPathDepsRefused { cause: cause }
        Stage0ReexportPathDepsOk { deps: deps } =>
          match stage0_lookup_package_crate_dir(package_name: pkg) {
            Stage0PackageCrateDirFound { crate_dir: crate_dir } =>
              Stage0ReexportPathDepsOk {
                deps: deps |> concat([
                  CargoDependency {
                    name: pkg,
                    source: LocalPathDep {
                      path: stage0_crate_dir_to_sibling_dep_path(crate_dir: crate_dir)
                    }
                  }
                ])
              }
            Stage0PackageCrateDirRefused { cause: cause } =>
              Stage0ReexportPathDepsRefused { cause: cause }
          }
      }
    })
}

fn stage0_emit_shell_path_dependencies() -> List<CargoDependency> {
  generated_partition_crate_rows
    |> filter(row => stage0_partition_row_is_module_bearing(row: row))
    |> map(row =>
      CargoDependency {
        name: row.package_name,
        source: LocalPathDep { path: stage0_crate_dir_to_sibling_dep_path(crate_dir: row.crate_dir) }
      }
    )
}

fn stage0_partition_row_kind(row: GeneratedPartitionCrateRow) -> Stage0CrateKind {
  match row.kind {
    GeneratedFoundationCrate => FoundationCrate
    GeneratedLayeredCoreCrate => LayeredCoreCrate
    GeneratedEmitCoreCrate => EmitCoreCrate
  }
}

fn stage0_partition_row_header_doc(row: GeneratedPartitionCrateRow) -> String {
  match row.kind {
    GeneratedFoundationCrate => stage0_foundation_header_doc()
    GeneratedLayeredCoreCrate => stage0_layered_core_header_doc()
    GeneratedEmitCoreCrate => stage0_emit_core_header_doc()
  }
}

fn stage0_partition_row_dependencies_outcome(
  row: GeneratedPartitionCrateRow
) -> Stage0PartitionRowDepsOutcome {
  match row.kind {
    GeneratedFoundationCrate =>
      Stage0PartitionRowDepsOk { deps: stage0_foundation_runtime_dependencies() }
    GeneratedLayeredCoreCrate =>
      match stage0_reexport_path_dependencies_outcome(reexport_packages: row.reexport_packages) {
        Stage0ReexportPathDepsOk { deps: reexport_deps } =>
          Stage0PartitionRowDepsOk {
            deps: stage0_foundation_runtime_dependencies() |> concat(reexport_deps)
          }
        Stage0ReexportPathDepsRefused { cause: cause } =>
          Stage0PartitionRowDepsRefused { cause: cause }
      }
    GeneratedEmitCoreCrate =>
      Stage0PartitionRowDepsOk {
        deps: stage0_foundation_runtime_dependencies()
          |> concat(stage0_emit_shell_path_dependencies())
      }
  }
}

fn stage0_partition_row_features(row: GeneratedPartitionCrateRow) -> List<CargoFeature> {
  match row.kind {
    GeneratedFoundationCrate => [CargoFeature { name: "text_lookup_work_counter", dependencies: [] }]
    GeneratedLayeredCoreCrate => []
    GeneratedEmitCoreCrate => []
  }
}

fn stage0_partition_row_to_spec_outcome(
  row: GeneratedPartitionCrateRow
) -> Stage0PartitionRowSpecOutcome {
  match stage0_partition_row_dependencies_outcome(row: row) {
    Stage0PartitionRowDepsRefused { cause: cause } =>
      Stage0PartitionRowSpecRefused { cause: cause }
    Stage0PartitionRowDepsOk { deps: deps } =>
      Stage0PartitionRowSpecOk {
        spec: Stage0CrateSpec {
          package_name: row.package_name,
          crate_dir: row.crate_dir,
          kind: stage0_partition_row_kind(row: row),
          header_doc: stage0_partition_row_header_doc(row: row),
          modules: row.modules,
          reexport_packages: row.reexport_packages,
          dependencies: deps,
          features: stage0_partition_row_features(row: row),
          carries_non_empty_wrappers: row.carries_non_empty_wrappers
        }
      }
  }
}

fn render_stage0_crate_dep(dep: CargoDependency) -> String {
  match dep.source {
    RegistryDep { version: version, features: features } =>
      emit_cargo_dep(name: dep.name, version: version, features: features)
    LocalPathDep { path: path } =>
      concat(dep.name, " = { path = \"", path, "\" }\n")
  }
}

fn render_stage0_crate_feature(feature: CargoFeature) -> String {
  if (feature.dependencies |> count) == 0 {
    concat(feature.name, " = []\n")
  } else {
    let dep_names = feature.dependencies |> map(d => concat("\"", d, "\"")) |> join(separator: ", ")
    concat(feature.name, " = [", dep_names, "]\n")
  }
}

fn render_stage0_crate_features_section(features: List<CargoFeature>) -> String {
  if (features |> count) == 0 {
    ""
  } else {
    concat(
      "\n[features]\n",
      "default = []\n",
      features |> map(render_stage0_crate_feature) |> join(separator: "")
    )
  }
}

fn emit_stage0_crate_manifest(spec: Stage0CrateSpec) -> TextFile {
  let deps = spec.dependencies |> map(render_stage0_crate_dep) |> join(separator: "")
  let content = concat(
    render_cargo_package_header_prefix(name: spec.package_name),
    "\nedition = \"2021\"",
    render_stage0_crate_features_section(features: spec.features),
    "\n\n[dependencies]\n",
    deps
  )
  TextFile { path: concat(spec.crate_dir, "/Cargo.toml"), content: content }
}

fn stage0_crate_mod_include(module_basename: String) -> String {
  concat(
    "#[rustfmt::skip]\n",
    "#[path = \"../../stage0/src/", module_basename, ".rs\"]\n",
    "pub mod ", module_basename, ";"
  )
}

fn render_stage0_foundation_lib(spec: Stage0CrateSpec) -> String {
  let includes = spec.modules
    |> map(m => stage0_crate_mod_include(module_basename: m))
    |> join(separator: "\n")
  let head = concat(
    spec.header_doc, "\n\n",
    stage0_crate_allow_block(), "\n\n",
    includes
  )
  if spec.carries_non_empty_wrappers {
    concat(head, "\n\n", emit_non_empty_wrappers(), "\n")
  } else {
    concat(head, "\n")
  }
}

fn render_stage0_layered_core_lib(spec: Stage0CrateSpec) -> String {
  let sorted_reexports = spec.reexport_packages
    |> sort_by(pkg => stage0_package_name_to_rust_ident(package_name: pkg))
  let reexports = sorted_reexports
    |> map(pkg =>
      concat(
        "pub use ",
        stage0_package_name_to_rust_ident(package_name: pkg),
        "::*;"
      )
    )
    |> join(separator: "\n")
  let includes = spec.modules
    |> map(m => stage0_crate_mod_include(module_basename: m))
    |> join(separator: "\n")
  concat(
    spec.header_doc, "\n\n",
    stage0_crate_allow_block(), "\n\n",
    reexports, "\n\n",
    includes, "\n"
  )
}

fn stage0_emit_shell_module_reexports_outcome(
  modules: List<String>
) -> Stage0EmitShellReexportsOutcome {
  modules
    |> fold(init: Stage0EmitShellReexportsOk { lines: [] }, f: fn(acc, module_basename) {
      match acc {
        Stage0EmitShellReexportsRefused { cause: cause } =>
          Stage0EmitShellReexportsRefused { cause: cause }
        Stage0EmitShellReexportsOk { lines: lines } =>
          match stage0_lookup_module_owner_package_name(module_basename: module_basename) {
            Stage0ModuleOwnerFound { package_name: owner } =>
              Stage0EmitShellReexportsOk {
                lines: lines |> concat([
                  concat(
                    "pub mod ", module_basename, " {\n    pub use ",
                    stage0_package_name_to_rust_ident(package_name: owner),
                    "::", module_basename, "::*;\n}"
                  )
                ])
              }
            Stage0ModuleOwnerRefused { cause: cause } =>
              Stage0EmitShellReexportsRefused { cause: cause }
          }
      }
    })
}

fn render_stage0_emit_core_lib_outcome(spec: Stage0CrateSpec) -> Stage0CrateLibEmitOutcome {
  match stage0_emit_shell_module_reexports_outcome(modules: spec.modules) {
    Stage0EmitShellReexportsRefused { cause: cause } =>
      Stage0CrateLibEmitRefused { cause: cause }
    Stage0EmitShellReexportsOk { lines: lines } =>
      Stage0CrateLibEmitOk {
        file: TextFile {
          path: concat(spec.crate_dir, "/src/lib.rs"),
          content: concat(
            spec.header_doc, "\n\n",
            stage0_crate_allow_block(), "\n\n",
            "pub use v1_stage0_runtime::\{NonEmptyBTreeSet, NonEmptyVec};", "\n\n",
            lines |> join(separator: "\n\n"), "\n\n",
            "#[rustfmt::skip]\n#[path = \"../../stage0/src/v1_compiler_emit_core_support.rs\"]\npub mod v1_compiler_emit_core_support;", "\n\n",
            "pub use v1_compiler_emit_core_support::*;", "\n"
          )
        }
      }
  }
}

fn stage0_partition_lookups_valid() -> Bool {
  match stage0_crate_boundary_emit_outcome() {
    Stage0CrateBoundaryEmitOk { files: _ } => true
    Stage0CrateBoundaryEmitRefused { cause: _ } => false
  }
}

fn emit_stage0_crate_lib_outcome(spec: Stage0CrateSpec) -> Stage0CrateLibEmitOutcome {
  match spec.kind {
    FoundationCrate =>
      Stage0CrateLibEmitOk {
        file: TextFile {
          path: concat(spec.crate_dir, "/src/lib.rs"),
          content: render_stage0_foundation_lib(spec)
        }
      }
    LayeredCoreCrate =>
      Stage0CrateLibEmitOk {
        file: TextFile {
          path: concat(spec.crate_dir, "/src/lib.rs"),
          content: render_stage0_layered_core_lib(spec)
        }
      }
    EmitCoreCrate => render_stage0_emit_core_lib_outcome(spec)
  }
}

fn stage0_crate_plan_outcome() -> Stage0CratePlanOutcome {
  generated_partition_crate_rows
    |> fold(init: Stage0CratePlanOk { plan: Stage0CratePlan { crates: [] } }, f: fn(acc, row) {
      match acc {
        Stage0CratePlanRefused { cause: cause } =>
          Stage0CratePlanRefused { cause: cause }
        Stage0CratePlanOk { plan: plan } =>
          match stage0_partition_row_to_spec_outcome(row: row) {
            Stage0PartitionRowSpecRefused { cause: cause } =>
              Stage0CratePlanRefused { cause: cause }
            Stage0PartitionRowSpecOk { spec: spec } =>
              Stage0CratePlanOk {
                plan: Stage0CratePlan {
                  crates: plan.crates |> concat([spec])
                }
              }
          }
      }
    })
}

fn emit_stage0_crate_boundary_files_outcome(
  plan: Stage0CratePlan
) -> Stage0CrateBoundaryEmitOutcome {
  plan.crates
    |> fold(init: Stage0CrateBoundaryEmitOk { files: [] }, f: fn(acc, spec) {
      match acc {
        Stage0CrateBoundaryEmitRefused { cause: cause } =>
          Stage0CrateBoundaryEmitRefused { cause: cause }
        Stage0CrateBoundaryEmitOk { files: files } =>
          match emit_stage0_crate_lib_outcome(spec: spec) {
            Stage0CrateLibEmitRefused { cause: cause } =>
              Stage0CrateBoundaryEmitRefused {
                cause: stage0_map_module_owner_refusal_to_boundary(cause: cause)
              }
            Stage0CrateLibEmitOk { file: lib_file } =>
              Stage0CrateBoundaryEmitOk {
                files: files |> concat([
                  emit_stage0_crate_manifest(spec),
                  lib_file
                ])
              }
          }
      }
    })
}

fn stage0_crate_boundary_emit_outcome() -> Stage0CrateBoundaryEmitOutcome {
  match stage0_crate_plan_outcome() {
    Stage0CratePlanRefused { cause: cause } =>
      Stage0CrateBoundaryEmitRefused {
        cause: stage0_map_package_dir_refusal_to_boundary(cause: cause)
      }
    Stage0CratePlanOk { plan: plan } =>
      emit_stage0_crate_boundary_files_outcome(plan: plan)
  }
}
