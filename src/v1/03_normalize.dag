module v1.compiler.normalize





type NormalizeResult {
  graph: v1.compiler.resolve.ModuleGraph
  diagnostics: List<v1.std.core.ErrorNode>
}

fn check_bare_containers(n: v1.std.core.Node, module_name: String, source_indices: Map<String, v1.std.core.NewlineIndex>) -> List<v1.std.core.ErrorNode> {
  let has_structure = match n.body { Present { value: _ } => true  Absent => false } || (n.uses |> count) > 0 || (n.properties |> count) > 0
  let is_expr = match n.expr_data { NoExprData => false  _ => true }
  let nname = authored_name_at(source_indices: source_indices, node: n)
  let self_diags = if is_expr { [] } else { match authored_container_spelling_verdict(node: n, source_indices: source_indices) {
    ContainerSpellingDeclared { arity: expected } =>
      if (n.children |> count) == 0 && (n.params |> count) == 0 && n.connective == NoConnective && !has_structure {
        [make_error_node(
          diagnostic: v1.std.core.ArityMismatch { name: nname, expected: expected, got: 0, span: n.span },
          module_name: module_name
        )]
      } else { [] }
    ContainerSpellingUnknown { container_leaf: leaf } =>
      [make_error_node(
        diagnostic: v1.std.core.ContainerSpellingUnrecognized { name: nname, container_leaf: leaf, span: n.span },
        module_name: module_name
      )]
    NotAContainerSpelling => []
  } }
  let child_diags = flat_map(n.children, c => check_bare_containers(n: c, module_name: module_name, source_indices: source_indices))
  let param_diags = flat_map(n.params, p => check_bare_containers(n: p, module_name: module_name, source_indices: source_indices))
  let type_ann_diags = match n.type_annotation {
    Present { value: ta } => check_bare_containers(n: ta, module_name: module_name, source_indices: source_indices)
    Absent => []
  }
  let body_diags = match n.body {
    Present { value: b } => check_bare_containers(n: b, module_name: module_name, source_indices: source_indices)
    Absent => []
  }
  let inferred_diags = if (n.params |> count) > 0 {
    []
  } else {
    match n.inferred {
      Present { value: inf } => match inf {
        v1.std.core.Resolved { node: rn } => check_bare_containers(n: rn, module_name: module_name, source_indices: source_indices)
        _ => []
      }
      Absent => []
    }
  }
  let uses_diags = flat_map(n.uses, u => check_bare_containers(n: u, module_name: module_name, source_indices: source_indices))
  let prop_diags = flat_map(n.properties, p => check_bare_containers(n: p, module_name: module_name, source_indices: source_indices))
  flat_map([self_diags, child_diags, param_diags, type_ann_diags, inferred_diags, body_diags, uses_diags, prop_diags], d => d)
}

fn normalize_module_diagnostics(m: v1.compiler.resolve.ResolvedModule, source_indices: Map<String, v1.std.core.NewlineIndex>) -> List<v1.std.core.ErrorNode> {
  let items = module_items(n: m.module)
  flat_map(items, item => check_bare_containers(n: item, module_name: authored_name_at(source_indices: source_indices, node: m.module), source_indices: source_indices))
}

fn normalize_graph(graph: v1.compiler.resolve.ModuleGraph, source_indices: Map<String, v1.std.core.NewlineIndex>) -> NormalizeResult {
  let diags = flat_map(graph.modules, m => normalize_module_diagnostics(m: m, source_indices: source_indices))
  NormalizeResult {
    graph: graph,
    diagnostics: diags
  }
}
