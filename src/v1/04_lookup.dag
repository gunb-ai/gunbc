fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

type KnownMethodResolution {
  semantics: MethodSemantics?
  result_type: Node?
  diagnostics: List<ErrorNode>
}

fn lookup_in_scope(locals: Map<String, TypeBinding>, name: String) -> Node? {
  match map_get(locals, name) {
    Present { value: binding } => Present { value: binding.resolved }
    Absent => Absent
  }
}

fn lookup_func_sig(func_env: ResolvedFuncEnv, type_env: TypeEnv, name: String) -> FuncSigLookup {
  match lookup_resolved_sig(env: func_env, name: name) {
    FuncSigResolved { sig: sig } => FuncSigResolved { sig: sig }
    FuncSigAmbiguous { candidates: cands } => FuncSigAmbiguous { candidates: cands }
    FuncSigUnresolved =>
      match func_sig_from_global_bare(type_env: type_env, name: name) {
        Present { value: sig } => FuncSigResolved { sig: sig }
        Absent => FuncSigUnresolved
      }
  }
}

fn func_sig_if_resolved(lookup: FuncSigLookup) -> ResolvedFuncSig? {
  match lookup {
    FuncSigResolved { sig: sig } => Present { value: sig }
    FuncSigUnresolved => Absent
    FuncSigAmbiguous { candidates: _ } => Absent
  }
}

type BorrowedCensusDecl {
  owner_module_path: String
  node: Node
}

fn borrowed_census_decl(type_env: TypeEnv, name: String) -> BorrowedCensusDecl? {
  if contains(name, ".") {
    match symbol_index_lookup(index: type_env.symbol_index, qualified_name: name) {
      Present { value: node } =>
        Present { value: BorrowedCensusDecl { owner_module_path: qualified_all_but_last(name: name), node: node } }
      Absent => none
    }
  } else {
    match map_get(type_env.symbol_index.global_bare, name) {
      Present { value: GlobalBareUniqueBinding { module_path: mp, binding: b } } =>
        Present { value: BorrowedCensusDecl { owner_module_path: mp, node: b.resolved } }
      Present { value: GlobalBareAmbiguousBinding { candidates: cands } } =>
        match global_bare_policy_candidate(env_module_path: type_env.module_path, candidates: cands) {
          Present { value: cand } =>
            Present { value: BorrowedCensusDecl { owner_module_path: cand.module_path, node: cand.binding.resolved } }
          Absent => none
        }
      Absent => none
    }
  }
}

data census_reserved_method_name_note: String = "Census precedence law (main-parity): the whole-pool census never serves an algebra method-template name (filter/any/contains/…) as a bare fn sig or tail callable. Those names belong to the known-method bridge in the ExprCall arm — a census sig for the UNLOADED v2.std.algebra typed filter(xs, f) as a plain call and the runtime died NoSuchFunction where main rewrote to the builtin method. Loaded providers are unaffected: lookup_resolved_sig runs before the census fallback."

fn func_sig_from_global_bare(type_env: TypeEnv, name: String) -> ResolvedFuncSig? {
  if algebra_method_template_name(name: name) {
    return none
  }
  match infer_builtin_call_type(name: name) {
    Present { value: _ } => none
    Absent =>
  let borrowed = match lookup_binding_by_name_local(env: type_env, name: name) {
    Present { value: binding } =>
      Present { value: BorrowedCensusDecl { owner_module_path: type_env.module_path, node: binding.resolved } }
    Absent => borrowed_census_decl(type_env: type_env, name: name)
  }
  match borrowed {
    Present { value: bd } =>
      let node = bd.node
      match (node.params |> count) > 0 || node.inferred != none || node.type_annotation != none {
        false => Absent
        true =>
        let excluded = borrowed_generic_param_names(params: node.params, source_indices: type_env.source_indices)
        let raw_return = match node.inferred {
          Present { value: Resolved { node: inferred } } => inferred
          _ => match node.type_annotation {
            Present { value: ann } => ann
            Absent => error_type
          }
        }
        if bd.owner_module_path == type_env.module_path {
          Present { value: ResolvedFuncSig {
            name: name,
            params: node.params,
            inferred: raw_return,
            is_async: false,
            output_provenance: [],
            variant_provenance: empty_map()
          } }
        } else {
          let qualified_return = qualify_borrowed_type_names(n: raw_return, owner_module_path: bd.owner_module_path, env: type_env, excluded: excluded)
          Present { value: ResolvedFuncSig {
            name: name,
            params: node.params,
            inferred: qualified_return,
            is_async: false,
            output_provenance: [],
            variant_provenance: empty_map()
          } }
        }
      }
    Absent => Absent
  }
  }
}

fn global_bare_callable_node(type_env: TypeEnv, name: String) -> Node? {
  if algebra_method_template_name(name: name) {
    return none
  }
  match lookup_binding_by_name(env: type_env, name: name) {
    Present { value: binding } =>
      if (binding.resolved.params |> count) > 0 || binding.resolved.inferred != none { Present { value: binding.resolved } }
      else { none }
    Absent => none
  }
}

fn lookup_field_type_node(n: Node, field_name: String, source_indices: Map<String, NewlineIndex>) -> Node? {
  let is_optional = n.return_cardinality == CardOptional
  if is_optional {
    let inner = with_required_cardinality(n: n)
    if field_name == "value" {
      Present { value: inner }
    } else {
      match lookup_field_type_node(n: inner, field_name: field_name, source_indices: source_indices) {
        Present { value: inner_result } => Present { value: with_optional_cardinality(n: inner_result) }
        Absent => none
      }
    }
  } else {
    let has_structure = n.connective != NoConnective
    if has_structure {
      let is_product = n.connective == Conj
      if is_product {
        match find_child_named(n: n, name: field_name, source_indices: source_indices) {
          Present { value: field_child } =>
            if node_is_keyed_collection(n: n, source_indices: source_indices) && field_name == "lookup" {
              let value_child = match n.children |> skip(1) |> first {
                Present { value: child } => child_type_node(ch: child)
                Absent => nominal_type_ref(name: "V")
              }
              Present { value: with_optional_cardinality(n: value_child) }
            } else {
              Present { value: child_type_node(ch: field_child) }
            }
          Absent => none
        }
      } else {
        lookup_coproduct_common_field_node(variants: n.children, field_name: field_name, source_indices: source_indices)
      }
    } else {

      match n.inferred {
        Present { value: Resolved { node: target } } =>
          lookup_field_type_node(n: target, field_name: field_name, source_indices: source_indices)
        _ => none
      }
    }
  }
}

fn lookup_coproduct_common_field_node(variants: List<Node>, field_name: String, source_indices: Map<String, NewlineIndex>) -> Node? {
  let found_in_all = variants |> all(v =>
    has_child_named(n: v, name: field_name, source_indices: source_indices)
  )
  let first_field = if found_in_all {
    match variants |> first {
      Present { value: first_variant } =>
        find_child_named(n: first_variant, name: field_name, source_indices: source_indices)
      Absent => none
    }
  } else { none }
  match first_field {
    Present { value: field_child } =>
      Present { value: child_type_node(ch: field_child) }
    Absent => none
  }
}

fn resolve_scrutinee_type_node(env: TypeEnv, n: Node) -> Node {
  resolve_scrutinee_type_node_seen(env: env, n: n, seen: empty_map())
}

fn resolve_method_receiver_type(receiver_type: Node, env: TypeEnv) -> Node {
  let raw_name = authored_name_at(source_indices: env.source_indices, node: receiver_type)
  if receiver_type.connective == Conj || is_declared_container_alias_spelling(name: raw_name) {
    receiver_type
  } else {
    let resolved = reground_alias_carrier_identity(n: resolve_scrutinee_type_node(env: env, n: receiver_type), source_indices: env.source_indices)
    let resolved_name = authored_name_at(source_indices: env.source_indices, node: resolved)
    if resolved.connective == Conj || (resolved_name != raw_name && is_declared_container_alias_spelling(name: resolved_name)) {
      resolved
    } else {
      receiver_type
    }
  }
}

fn resolve_scrutinee_type_node_seen(env: TypeEnv, n: Node, seen: Map<String, Bool>) -> Node {
  let n_is_type_var = if n.inferred != none { is_type_variable(inferred: n.inferred.value) } else { false }
  if n_is_type_var { return n }
  let normed = normalize_access_type_node(n: n)
  if normed.connective == NoConnective && normed.children |> count > 0 && normed.inferred != none {
    match normed.inferred {
      Present { value: Resolved { node: target } } => resolve_scrutinee_type_node_seen(env: env, n: target, seen: seen)
      _ => normed
    }
  } else if normed.connective == NoConnective && normed.children |> count == 0 {
    let canonical = authored_name(env: env, node: normed)
    if normed.inferred != none {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      match normed.inferred {
        Present { value: Resolved { node: target } } =>
          if authored_name(env: env, node: target) == canonical && target.inferred == none && target.connective == NoConnective && target.children |> count == 0 {
            normed
          } else {
            resolve_scrutinee_type_node_seen(env: env, n: target, seen: next_seen)
          }
        _ => normed
      }
    } else if canonical != "" && emit_map_has(m: seen, key: canonical) {
      nominal_type_ref(name: canonical)
    } else {
      let next_seen = if canonical == "" { seen } else { map_insert(seen, canonical, true) }
      match lookup_type_for(env: env, node: normed) {
        Present { value: resolved } =>
          if authored_name(env: env, node: resolved) == canonical && resolved.inferred == none && resolved.connective == NoConnective && resolved.children |> count == 0 {
            normed
          } else {
            let result = resolve_scrutinee_type_node_seen(env: env, n: resolved, seen: next_seen)
            let is_optional = normed.return_cardinality == CardOptional
            if is_optional { with_optional_cardinality(n: result) } else { result }
          }
        Absent => normed
      }
    }
  } else { normed }
}

fn map_value_type_in_env(type_node: Node, env: TypeEnv) -> Node? {
  let normed = normalize_access_type_node(n: type_node)
  let resolved = resolve_scrutinee_type_node(env: env, n: normed)
  let map_type = normalize_access_type_node(n: resolved)
  if node_is_keyed_collection(n: map_type, source_indices: env.source_indices) && map_type.children |> count >= 2 {
    match map_type.children |> skip(1) |> first {
      Present { value: value_type } => Present { value: value_type }
      Absent => none
    }
  } else {
    none
  }
}

fn map_key_type_in_env(type_node: Node, env: TypeEnv) -> Node? {
  let normed = normalize_access_type_node(n: type_node)
  let resolved = resolve_scrutinee_type_node(env: env, n: normed)
  let map_type = normalize_access_type_node(n: resolved)
  if node_is_keyed_collection(n: map_type, source_indices: env.source_indices) && map_type.children |> count >= 1 {
    match map_type.children |> first {
      Present { value: key_type } => Present { value: key_type }
      Absent => none
    }
  } else {
    none
  }
}

fn set_element_type_in_env(type_node: Node, env: TypeEnv) -> Node? {
  let normed = normalize_access_type_node(n: type_node)
  let resolved = resolve_scrutinee_type_node(env: env, n: normed)
  let set_type = normalize_access_type_node(n: resolved)
  if node_is_set_collection(n: set_type, source_indices: env.source_indices) && set_type.children |> count >= 1 {
    match set_type.children |> first {
      Present { value: elem_type } => Present { value: elem_type }
      Absent => none
    }
  } else {
    none
  }
}

fn field_summary_for_type(base_type: Node, env: TypeEnv, field: String) -> FieldSummary? {
  let resolved = resolve_scrutinee_type_node(env: env, n: base_type)
  let normed = normalize_access_type_node(n: resolved)
  let normed_opt = normed.return_cardinality == CardOptional
  if field == "value" && normed_opt {
    Present { value: FieldSummary { access_style: OptionalUnwrap, value_shape: PlainValue } }
  } else if normed_opt {
    let inner = with_required_cardinality(n: normed)
    match field_summary_for_type(base_type: inner, env: env, field: field) {
      Present { value: inner_summary } =>
        Present { value: FieldSummary {
          access_style: inner_summary.access_style,
          value_shape: OptionalValue
        } }
      Absent => none
    }
  } else {
    let no_structure = resolved.connective == NoConnective
    if no_structure {
      none
    } else {
      let is_product = resolved.connective == Conj
      if is_product {
        map_get(build_struct_field_summaries(parent: resolved, source_indices: env.source_indices), field)
      } else {
        map_get(build_enum_field_summaries(variants: resolved.children, source_indices: env.source_indices), field)
      }
    }
  }
}

type MethodFieldResult {
  field_node: Node
  result_type: Node
  size_effect: CollectionSizeEffect?
  cost_shape: CostShape?
  algebra_template: AlgebraFieldTemplate?
}

type StructuralMethodLookup {
  resolution: MethodFieldResult?
  kernel_diagnostics: List<ErrorNode>
}

fn product_field_result_type(field: Node) -> Node? {
  match field.inferred {
    Present { value: Resolved { node: rt } } =>
      if rt.params |> count > 0 {
        match rt.inferred {
          Present { value: Resolved { node: return_type } } => Present { value: return_type }
          _ => Present { value: rt }
        }
      } else {
        Present { value: rt }
      }
    _ => none
  }
}

fn map_lookup_result_type(product: Node, field: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  if authored_name_at(source_indices: source_indices, node: product) == "Map" {
    match product_field_result_type(field: field) {
      Present { value: raw } =>
        if (raw.return_cardinality == CardOptional) {
          Present { value: raw }
        } else {
          Present { value: with_optional_cardinality(n: raw) }
        }
      Absent => none
    }
  } else {
    none
  }
}

fn lookup_field_in_product(product: Node, method_name: String, source_indices: Map<String, NewlineIndex>) -> MethodFieldResult? {
  let matching = product.children |> filter(c => authored_name_at(source_indices: source_indices, node: c) == method_name)
  match matching |> first {
    Present { value: field } =>
      match if method_name == "lookup" { map_lookup_result_type(product: product, field: field, source_indices: source_indices) } else { none } {
        Present { value: lookup_rt } =>
          Present { value: MethodFieldResult { field_node: field, result_type: lookup_rt, size_effect: none, cost_shape: none, algebra_template: none } }
        Absent =>
          match product_field_result_type(field: field) {
            Present { value: rt } => Present { value: MethodFieldResult { field_node: field, result_type: rt, size_effect: none, cost_shape: none, algebra_template: none } }
            Absent => none
          }
        }
    Absent => none
  }
}

fn lookup_structural_method(receiver_type: Node, method_name: String, source_indices: Map<String, NewlineIndex>) -> StructuralMethodLookup {
  let is_product = receiver_type.connective == Conj
  if is_product {
    let direct = lookup_field_in_product(product: receiver_type, method_name: method_name, source_indices: source_indices)
    StructuralMethodLookup { resolution: direct, kernel_diagnostics: [] }
  } else {
    let enriched = enrich_kernel_type(name: authored_name_at(source_indices: source_indices, node: receiver_type), base: receiver_type, source_indices: source_indices)
    if enriched.ty.connective == Conj && enriched.ty.children |> count > 0 {
      let base_result = lookup_field_in_product(product: enriched.ty, method_name: method_name, source_indices: source_indices)
      match base_result {
        Present { value: mfr } =>
          let profile = kernel_profile_lookup(name: authored_name_at(source_indices: source_indices, node: receiver_type))
          let template_match = match profile {
            Present { value: p } =>
              let templates = algebra_templates_for_profile(profile: p)
              templates |> filter(t => t.name == method_name) |> first
            Absent => none
          }
          let resolution = match template_match {
            Present { value: t } =>
              Present { value: MethodFieldResult { field_node: mfr.field_node, result_type: mfr.result_type, size_effect: t.size_effect, cost_shape: t.cost_shape, algebra_template: Present { value: t } } }
            Absent => base_result
          }
          StructuralMethodLookup { resolution: resolution, kernel_diagnostics: enriched.diagnostics }
        Absent => StructuralMethodLookup { resolution: none, kernel_diagnostics: enriched.diagnostics }
      }
    } else {
      StructuralMethodLookup { resolution: none, kernel_diagnostics: enriched.diagnostics }
    }
  }
}

fn resolve_known_method_node(receiver: Node, receiver_type: Node, method_name: String, fold_accumulator_type: Node?, service_registry: Map<String, List<OpEntry>>, source_indices: Map<String, NewlineIndex>) -> KnownMethodResolution {

  let tier0 = lookup_structural_method(receiver_type: receiver_type, method_name: method_name, source_indices: source_indices)
  match tier0.resolution {
    Present { value: mfr } =>
      let semantics = AlgebraMethodSemantics { method_def: mfr.field_node, fold_accumulator_type: fold_accumulator_type, size_effect: mfr.size_effect, cost_shape: mfr.cost_shape, algebra_template: mfr.algebra_template }
      KnownMethodResolution {
        semantics: Present { value: semantics },
        result_type: Present { value: mfr.result_type },
        diagnostics: tier0.kernel_diagnostics
      }
    Absent =>
  match check_service_method_call_node(receiver_type: receiver_type, method: method_name, service_registry: service_registry, source_indices: source_indices) {
    Present { value: svc_result } =>
      KnownMethodResolution {
        semantics: Present { value: ServiceMethodSemantics { service_name: authored_name_at(source_indices: source_indices, node: receiver_type), op_params: svc_result.op_params } },
        result_type: Present { value: svc_result.result_type },
        diagnostics: tier0.kernel_diagnostics
      }
    Absent =>
      KnownMethodResolution { semantics: none, result_type: none, diagnostics: tier0.kernel_diagnostics }
  }
  }
}
