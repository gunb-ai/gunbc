module v1.compiler.infer_sigs

import v1.std.core {
  Node,
  ExprData, ExprCall, ExprVar, ExprMethodCall, expr_call_func_at,
  qualified_last_segment,
  ErrorNode, make_error_node,
  MissingAnnotation, no_span,
  DeclaredFuncSig,
  ResolvedFormal,
  DeclaredCallableIdentity,
  NewlineIndex,
  authored_name_at
}

import v1.compiler.infer_types { emit_map_has }

import v1.compiler.infer_occurrence_binding {
  module_path_owner_binding_decide,
  ModulePathBindingProjection,
}

import std.induction { SubValueRelation }

type ResolvedFuncSig {
  name: String
  params: List<Node>
  resolved_formals: ResolvedFormals
  inferred: Node
  is_async: Bool
  output_provenance: List<Map<String, SubValueRelation>>
  variant_provenance: Map<String, Map<String, Map<String, SubValueRelation>>>
}

type ResolvedFormals
  = DeclarationBoundFormals { formals: List<ResolvedFormal> }
  | KernelGroundedFormals { formals: List<ResolvedFormal> }
  | LocalFormalsAwaitingModuleContext {}

type ResolvedFuncEnv {
  name: String
  local: Map<String, ResolvedFuncSig>
  parents: List<ResolvedFuncEnv>
}

type ResolveFuncSigsResult {
  func_env: ResolvedFuncEnv
  diagnostics: List<ErrorNode>
}

type SigsAccum {
  signatures: Map<String, ResolvedFuncSig>
  diagnostics: List<ErrorNode>
}

type CallEdge {
  caller: String
  callee: String
}

// Cost shape (§6 bare-minimum cost): ResolvedFuncEnv.parents is the module's transitive import
// closure held FLAT — precedence-ordered (first = highest precedence: the last direct import's
// closure first, then earlier imports'; own local always wins before any parent), deduped by env
// name keeping the first occurrence. The prior shape nested each parent env recursively and lookup
// walked the shared import DAG as a TREE with no visited state, so a shared ancestor was probed
// once per PATH, not per module (measured: identical 541 signature requests cost 53.3M env probes,
// and 902.8M after one merge widened the host-effect closure by 54 modules — 16.95x from visibility
// alone), with a quadratic parents-prefix copy per recursion step. Flattening at the two assembly
// points (resolve_func_sigs at typecheck time; rewire_func_env_parent_links post-fold) makes lookup
// one ordered scan over closure members' own local maps: probes are bounded by distinct closure
// modules, never paths. The name dedup is load-bearing: without it flat lists compose additively
// along every import path and the list length re-becomes the path count. Shadowing is preserved
// exactly — the old deep-first, last-import-first walk linearizes to closure-of-last-import before
// closure-of-earlier-imports, and a member's own local precedes its parents' contributions.

type FlattenAccum {
  seen: Map<String, Bool>
  out: List<ResolvedFuncEnv>
}

fn flatten_parent_envs(direct_parents: List<ResolvedFuncEnv>) -> List<ResolvedFuncEnv> {
  let ordered = flat_map(direct_parents |> reverse, p => concat([p], p.parents))
  let dedup = fold(ordered, init: FlattenAccum { seen: empty_map(), out: [] }, f: (acc, p) =>
    if emit_map_has(m: acc.seen, key: p.name) { acc }
    else { FlattenAccum { seen: map_insert(acc.seen, p.name, true), out: list_push(acc.out, p) } }
  )
  dedup.out
}

type ParentSigScan {
  sig: ResolvedFuncSig?
  match_count: Int
  first_parent: String?
}

// namespace-resolution-design.md 13 / 8 step 1, fn path. `ResolvedFuncSig?` overloaded Absent as
// "keep looking" -- the census fallback fires on it -- so a refusal had nowhere to go, and the
// first-hit over func_env.parents was the fn silent-pick class (fn_parent_first_hit) with NO
// refusal arm at all. FuncSigLookup is the 3-state outcome: FuncSigResolved binds,
// FuncSigUnresolved means no admissible callable answered (the census fallback may still run),
// FuncSigAmbiguous carries every candidate and REFUSES -- it never falls through to a fallback.
// Under ImportScoped (host bracket false) the first-hit behaviour remains until the downstream
// production flip; under NamespaceOnlyY the candidates are COLLECTED and then decided.
// Own-module local hit stays first on both arms.
//
// WHAT THE 2026-08-22 CUT CHANGED, because the paragraph above was true when written and
// described a wall that could not describe the collision it was built for (gap-analysis row 30).
// Two independent mechanisms kept FuncSigAmbiguous unreachable for a cross-authority collision,
// and either one alone leaves the class open:
//
//   (a) THE CANDIDATE SET WAS NEVER ASSEMBLED. `lookup_func_sig` asked this environment first
//       and consulted the global/builtin path ONLY on the Unresolved arm, so a declared
//       `map_get` and the registered builtin `map_get` were never co-candidates -- the declared
//       one won by SHORT-CIRCUIT, and the arm was reachable only among declarations. The fix is
//       here and in `v1.compiler.infer_lookup` `callable_lookup_over_candidates`: one admissible
//       level is collected whole, then decided.
//   (b) WHERE AMBIGUITY WAS CONSTRUCTED, ONE PROJECTION ERASED IT. `func_sig_if_resolved` mapped
//       FuncSigAmbiguous to the same Absent that means "no such signature", and ten call sites
//       read the seed's inference through it. That projection is deleted; see its replacement's
//       note in `v1.compiler.infer_lookup`.
//
// The lesson this file keeps: a variant that exists, is named, and is documented as refusing
// still establishes nothing while nothing can construct it for the class it was built for. A
// grep for `FuncSigAmbiguous` reported this wall as built for as long as that was true.

// WHAT A CALLABLE NAME CAN RESOLVE TO, AS AN IDENTITY RATHER THAN A SPELLING.
//
// FuncSigAmbiguous carried List<String> and the strings were built at the point of refusal by
// pasting an owner path onto the referenced name. That is enough to print and not enough to
// decide with: it cannot represent a REGISTERED BUILTIN at all, and a builtin is one half of
// the collision this vocabulary exists to describe (gap-analysis row 30 -- `map_get` is both
// `v2.std.collection.map_get` returning Outcome<Optional<V>> and a builtin returning
// Optional<V>). So the candidate is the identity, and the label is a projection of it.
// DeclaredCallableIdentity IS NOT DECLARED HERE ANY MORE. It moved to v1.std.core because
// CallTargetIdentity -- which lives there, below this module -- now carries one, and a second
// spelling of the pair in this file to break the import direction would be the nicknaming defect
// DESIGN section 3 names. The reasoning for the record itself travels with the declaration.

type CallableIdentity
  = DeclaredCallable { identity: DeclaredCallableIdentity }
  | BuiltinCallable { primitive_name: String }

// `is_builtin` used to sit beside `identity` here. It was a second representation of the fact
// the identity variant already carries, and the decision below now reads the variant, so the
// two could no longer disagree only because nothing consulted the Bool. Deleted rather than
// kept in sync (DESIGN section 2/3).
type CallableCandidate {
  identity: CallableIdentity
  sig: ResolvedFuncSig
}

// The one rendering of a candidate for human-facing diagnostics. `<builtin:map_get>` is spelled
// with the brackets deliberately: it is not a qualified name and must not read as one, because
// the repair for it is not "qualify it" -- there is nothing to qualify.
fn callable_identity_label(identity: CallableIdentity) -> String {
  match identity {
    DeclaredCallable { identity: identity } => concat(identity.owner_module_path, ".", identity.decl_name)
    BuiltinCallable { primitive_name: prim } => concat("<builtin:", prim, ">")
  }
}

fn callable_candidate_labels(candidates: List<CallableCandidate>) -> List<String> {
  candidates |> map(c => callable_identity_label(identity: c.identity))
}

// THE OWNER IS PART OF THE RESOLUTION, NOT RECONSTRUCTIBLE AFTER IT.
//
// FuncSigResolved binds a signature AND the exact declaration it came from. A consumer that
// needs the target's identity -- emission target selection is the first -- must take it from
// here rather than re-running a lookup at a grain where the lexical scope that decided it has
// already been discarded. That re-lookup is the authority-substitution class: the leaf spelling
// survives into emission and a same-named unrelated declaration answers for the one inference
// actually chose.
type FuncSigLookup
  = FuncSigResolved { sig: ResolvedFuncSig, declared: DeclaredCallableIdentity }
  | FuncSigUnresolved
  | FuncSigAmbiguous { candidates: List<CallableCandidate> }

// THE PROJECTION THAT USED TO ERASE THE AMBIGUITY ARM, SPLIT SO IT CANNOT.
//
// `func_sig_if_resolved` returned `ResolvedFuncSig?` and mapped BOTH FuncSigUnresolved and
// FuncSigAmbiguous onto Absent. Ten call sites read the seed's inference through it -- nine
// provenance/descent derivations in `v1.compiler.infer` and one argument-ordering projection in
// `v1.compiler.emit` -- so every one of them read "two authorities answered" as "no authority
// answered". Those are different states with OPPOSITE repairs (qualify the reference / declare
// the function), which is DESIGN's not-applicable-versus-malformed conflation in its third
// recorded form.
//
// WHAT THE SITES ACTUALLY DO WITH IT, because the split must not be mistaken for a behaviour
// change at a seam that has no way to refuse: every one of them derives an OPTIONAL FACT off a
// signature -- output provenance, variant provenance, a receiver's parameter name, a named-arg
// ordering -- and contributes nothing when there is no single signature to read. Contributing
// nothing remains correct for an ambiguous callee: there is no one signature whose facts could
// be read, and the reference itself is refused at the decision seams (the ExprVar and ExprCall
// arms of `v1.compiler.infer`), so no `Accepted` program reaches emit carrying one. What the
// split changes is that the carrier can no longer SPELL the collapse: a site must name the arm
// it is handling, and a future site that wants to treat ambiguity differently has the candidate
// list in hand rather than an Absent that has already forgotten it.
type NoDerivableSigReason
  = DerivationSigUnresolved
  | DerivationSigAmbiguous { candidates: List<CallableCandidate> }

type DerivedCalleeSig
  = DerivedFromSig { sig: ResolvedFuncSig }
  | NoDerivableSig { reason: NoDerivableSigReason }

fn func_sig_for_derivation(lookup: FuncSigLookup) -> DerivedCalleeSig {
  match lookup {
    FuncSigResolved { sig: sig, declared: _ } => DerivedFromSig { sig: sig }
    FuncSigUnresolved => NoDerivableSig { reason: DerivationSigUnresolved }
    FuncSigAmbiguous { candidates: cands } =>
      NoDerivableSig { reason: DerivationSigAmbiguous { candidates: cands } }
  }
}

fn lookup_resolved_sig_unique_across_parents(env: ResolvedFuncEnv, name: String) -> FuncSigLookup {
  decide_callable_candidates(candidates: parent_closure_callable_candidates(env: env, name: name))
}

// COLLECT, THEN DECIDE -- the whole point of this lane.
//
// EVERY member of the flat parent closure that declares the name becomes a candidate. The old
// shape stopped at the FIRST hit and kept a separate owner list only to count with; the sig it
// answered with therefore came from a position in a list rather than from a decision, and a
// second authority that was not a `fn` at all could never appear beside it.
fn parent_closure_callable_candidates(env: ResolvedFuncEnv, name: String) -> List<CallableCandidate> {
  fold(env.parents, init: [], f: (acc, p) =>
    match map_get(p.local, name) {
      Present { value: sig } =>
        concat(acc, [CallableCandidate {
          identity: DeclaredCallable { identity: DeclaredCallableIdentity { owner_module_path: p.name, decl_name: name } },
          sig: sig
        }])
      Absent => acc
    }
  )
}

// THE DECISION, AND IT IS ORDER-INDEPENDENT BY CONSTRUCTION.
//
// Cardinality routes through module_path_owner_binding_decide exactly as the two existing
// candidate sites do -- 0/1/many is one authority in this compiler, not a count comparison
// re-spelled per call site. Position in the list is read ONLY after the count has proven the
// population is a singleton, which is extraction rather than selection (the rule
// gunbc.roadmap_publish states for the same move).
//
// A LONE BUILTIN ANSWERS UNRESOLVED, DELIBERATELY. The builtin has no declared parameter list
// in this compiler -- `builtin_function_registry` maps a name to a RETURN TYPE -- so a
// FuncSigResolved built over it would carry `params: []` and lie about the call's shape to
// every consumer of a sig. Unresolved is what the ExprCall arm already needs in order to route
// the call to the known-builtin bridge, which is the path that types builtins correctly. So the
// builtin is a CANDIDATE in the decision and never an answer: it can make a population
// ambiguous, and on its own it hands the call back to the bridge exactly as before.
fn decide_callable_candidates(candidates: List<CallableCandidate>) -> FuncSigLookup {
  match module_path_owner_binding_decide(
    owners: candidates |> map(c => callable_identity_label(identity: c.identity))
  ) {
    ModulePathBindingMiss => FuncSigUnresolved
    ModulePathBindingHit { owner: _ } =>
      match candidates |> first {
        Present { value: only } =>
          match only.identity {
            DeclaredCallable { identity: identity } => FuncSigResolved { sig: only.sig, declared: identity }
            BuiltinCallable { primitive_name: _ } => FuncSigUnresolved
          }
        Absent => FuncSigUnresolved
      }
    ModulePathBindingAmbiguous { owners: _ } =>
      FuncSigAmbiguous { candidates: candidates }
  }
}

// The legacy first-hit arms answered with a bare sig, so the parent that supplied it was known
// at the scan and discarded on return. FuncSigResolved now binds the declaration, so the scan
// keeps the owner it already computed instead of the caller re-deriving one it cannot see.
type ResolvedSigWithOwner {
  sig: ResolvedFuncSig
  owner_module_path: String
}

fn lookup_resolved_sig_with_telemetry(env: ResolvedFuncEnv, name: String) -> ResolvedSigWithOwner? {
  let scan = fold(env.parents, init: ParentSigScan { sig: none, match_count: 0, first_parent: none }, f: (acc, p) =>
    match map_get(p.local, name) {
      Present { value: sig } =>
        ParentSigScan {
          sig: if acc.sig != none { acc.sig } else { Present { value: sig } },
          match_count: acc.match_count + 1,
          first_parent: if acc.first_parent != none { acc.first_parent } else { Present { value: p.name } }
        }
      Absent => acc
    }
  )
  if scan.match_count >= 2 && scan.sig != none {
    match scan.first_parent {
      Present { value: chosen_parent } =>
        resolution_silent_pick_record_fn_parent_first_hit(
          env_module_path: env.name,
          name: name,
          parent_match_count: scan.match_count,
          chosen_parent_module: chosen_parent
        )
      Absent => {}
    }
  }
  match scan.sig {
    Present { value: sig } =>
      match scan.first_parent {
        Present { value: owner } => Present { value: ResolvedSigWithOwner { sig: sig, owner_module_path: owner } }
        Absent => none
      }
    Absent => none
  }
}

fn lookup_resolved_sig(env: ResolvedFuncEnv, name: String) -> FuncSigLookup {
  match map_get(env.local, name) {
    Present { value: sig } =>
      FuncSigResolved { sig: sig, declared: DeclaredCallableIdentity { owner_module_path: env.name, decl_name: name } }
    Absent =>
      if name_resolution_policy_is_namespace_only() {
        lookup_resolved_sig_unique_across_parents(env: env, name: name)
      } else {
        let first_hit = if resolution_silent_pick_is_enabled() {
          lookup_resolved_sig_with_telemetry(env: env, name: name)
        } else {
          fold(env.parents, init: none_resolved_sig_with_owner(), f: (acc, p) =>
            match acc {
              Present { value: found } => Present { value: found }
              Absent =>
                match map_get(p.local, name) {
                  Present { value: sig } => Present { value: ResolvedSigWithOwner { sig: sig, owner_module_path: p.name } }
                  Absent => none
                }
            }
          )
        }
        match first_hit {
          Present { value: found } =>
            FuncSigResolved {
              sig: found.sig,
              declared: DeclaredCallableIdentity { owner_module_path: found.owner_module_path, decl_name: name }
            }
          Absent => FuncSigUnresolved
        }
      }
  }
}

fn none_resolved_sig_with_owner() -> ResolvedSigWithOwner? {
  Absent
}

fn collect_func_call_edges(items: List<Node>, local_func_set: Map<String, Bool>, source_indices: Map<String, NewlineIndex>) -> List<CallEdge> {
  flat_map(items, item =>
    if item.params |> count > 0 && item.body != none {
      collect_calls_in_expr(caller: authored_name_at(source_indices: source_indices, node: item), texpr: item.body.value, local_func_set: local_func_set, source_indices: source_indices)
    } else {
      []
    }
  )
}

fn collect_calls_in_expr(caller: String, texpr: Node, local_func_set: Map<String, Bool>, source_indices: Map<String, NewlineIndex>) -> List<CallEdge> {
  let this_edges = match texpr.expr_data {
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let f = expr_call_func_at(texpr: texpr, source_indices: source_indices)
      if emit_map_has(m: local_func_set, key: f) { [CallEdge { caller: caller, callee: f }] }
      else { [] }
    _ => []
  }
  let child_edges = texpr.children |> flat_map(child =>
    collect_calls_in_expr(caller: caller, texpr: child, local_func_set: local_func_set, source_indices: source_indices)
  )
  let result = concat(this_edges, child_edges)
  result
}

// THE CALLABLE PARENT SUPPLY, DERIVED FROM REFERENCES AND RESOLVED BY CONTAINMENT.
//
// What a module may call used to be derived from its IMPORT LIST: `func_env_views_for_import`
// admitted a parent env whole for an all-import and a leaf-keyed selection for a listed one, at
// two independent assembly points (typecheck-time in `v1.compiler.infer`, and again post-fold in
// `rewire_func_env_parent_links`, which also serves a decoded cache). Both are replaced here by
// ONE supply with a single authority: the module's own REFERENCE NODES name what it reaches, and
// the containment tree decides which declaration a reference names.
//
// The decision downstream is unchanged and must stay unchanged: this function supplies
// CANDIDATES, never an answer. `decide_callable_candidates` still reads the population 0/1/many
// and returns FuncSigUnresolved / FuncSigResolved / FuncSigAmbiguous, so a name reached by two
// admissible declarations refuses here exactly as it refused under imports. Supplying a wider or
// narrower candidate set is the only thing that changes, and it changes as a function of what the
// author actually wrote rather than of a second positional naming scheme they also had to write.
//
// PARSED REFERENCE NODES, NOT TEXT. The names come from `ExprCall`, `ExprVar` and
// `ExprMethodCall` nodes walked out of the module's own item trees -- the three node kinds whose
// spelling reaches `lookup_func_sig` -- never from a dotted-identifier scan over source bytes,
// which cannot tell a reference from prose.
type CallableOwnerRow {
  owner_module_path: String
  sig: ResolvedFuncSig
}

// One index over every declaring module, keyed by the DECLARED leaf name. It is built once and
// extended per realized module rather than rebuilt per consumer: the supply is asked once per
// module, and a per-module rebuild over the whole population would be the quadratic fold DESIGN
// section 6 rules out regardless of the realized n.
type CallableOwnerIndex {
  by_name: Map<String, List<CallableOwnerRow>>
}

fn empty_callable_owner_index() -> CallableOwnerIndex {
  CallableOwnerIndex { by_name: empty_map() }
}

// The rows come from a module's OWN local map only. A module's `parents` are its former import
// closure; reading them here would re-admit the import universe through the replacement and make
// re-export position, rather than declaration, the owner of a name.
fn extend_callable_owner_index(index: CallableOwnerIndex, env: ResolvedFuncEnv) -> CallableOwnerIndex {
  CallableOwnerIndex {
    by_name: fold(map_keys(env.local), init: index.by_name, f: (acc, name) =>
      match map_get(env.local, name) {
        Present { value: sig } =>
          let row = CallableOwnerRow { owner_module_path: env.name, sig: sig }
          match map_get(acc, name) {
            Present { value: rows } => map_insert(acc, name, list_push(rows, row))
            Absent => map_insert(acc, name, [row])
          }
        Absent => acc
      }
    )
  }
}

fn callable_owner_index_from_envs(envs: List<ResolvedFuncEnv>) -> CallableOwnerIndex {
  fold(envs, init: empty_callable_owner_index(), f: (acc, env) => extend_callable_owner_index(index: acc, env: env))
}

fn callable_owner_index_from_own_env(index: CallableOwnerIndex, env: ResolvedFuncEnv) -> CallableOwnerIndex {
  extend_callable_owner_index(index: index, env: ResolvedFuncEnv { name: env.name, local: env.local, parents: [] })
}

// CONTAINMENT, STATED ONCE, AND IT IS THE UNIQUE-ON-CHAIN RULE THE v2 RESOLVER ALREADY STATES.
//
// A reference spelled `a.b.f` names the declaration `f` inside the containment path `a.b`, and a
// containment path is matched as a SUFFIX of the owner's module path -- `v1.std.core` is reached
// by `core`, `std.core` and its whole path alike. That is the downward projection half.
//
// A BARE `f` IS NOT UNCONSTRAINED, and getting this wrong is the pool-coincidence failure the cut
// exists to remove: it resolves against the ANCESTOR CHAIN of the referencing position, so an
// owner is admissible only when its module path is that position's module or one of its
// containment ancestors. Admitting every declaring module instead would make a bare name bind by
// corpus population -- measured, it re-bound 39 `contains` call sites onto an unrelated
// three-parameter declaration in a module the caller does not contain and is not contained by.
// Where the chain answers nothing, the name is not resolved HERE; the reference falls to the
// arms that already own it, which is a smaller claim than pretending the chain answered.
fn reference_containment_qualifier(name: String) -> String {
  let leaf = qualified_last_segment(name: name)
  let name_len = string_length(s: name)
  let leaf_len = string_length(s: leaf)
  if name_len > leaf_len { substring(s: name, start: 0, end: name_len - leaf_len - 1) } else { "" }
}

fn containment_chain_admits_owner(owner_module_path: String, referencing_module_path: String) -> Bool {
  let owner_len = string_length(s: owner_module_path)
  let referencing_len = string_length(s: referencing_module_path)
  if owner_len == referencing_len { owner_module_path == referencing_module_path }
  else if referencing_len > owner_len {
    substring(s: referencing_module_path, start: 0, end: owner_len + 1) == concat(owner_module_path, ".")
  }
  else { false }
}

fn containment_admits_owner(owner_module_path: String, qualifier: String) -> Bool {
  let owner_len = string_length(s: owner_module_path)
  let qualifier_len = string_length(s: qualifier)
  if qualifier_len == 0 { true }
  else if owner_len == qualifier_len { owner_module_path == qualifier }
  else if owner_len > qualifier_len {
    substring(s: owner_module_path, start: owner_len - qualifier_len - 1, end: owner_len) == concat(".", qualifier)
  }
  else { false }
}

fn callable_reference_names_in_node(n: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let here = match n.expr_data {
    ExprCall => [authored_name_at(source_indices: source_indices, node: n)]
    ExprVar { binding_kind: _ } => [authored_name_at(source_indices: source_indices, node: n)]
    ExprMethodCall { method_semantics: _ } => [authored_name_at(source_indices: source_indices, node: n)]
    _ => []
  }
  let body_names = match n.body {
    Present { value: b } => callable_reference_names_in_node(n: b, source_indices: source_indices)
    Absent => []
  }
  let child_names = n.children |> flat_map(c => callable_reference_names_in_node(n: c, source_indices: source_indices))
  concat(concat(here, body_names), child_names)
}

type ReferenceNameAccum {
  seen: Map<String, Bool>
  out: List<String>
}

fn callable_reference_names(items: List<Node>, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let all = flat_map(items, item => callable_reference_names_in_node(n: item, source_indices: source_indices))
  let dedup = fold(all, init: ReferenceNameAccum { seen: empty_map(), out: [] }, f: (acc, name) =>
    if emit_map_has(m: acc.seen, key: name) { acc }
    else { ReferenceNameAccum { seen: map_insert(acc.seen, name, true), out: list_push(acc.out, name) } }
  )
  dedup.out
}

// The env's local map is keyed by the SPELLING the reference used, because that is the key
// `callable_lookup_over_candidates` asks with. A bare reference therefore keys by its leaf,
// exactly as the import-derived selective view did; a qualified reference keys by its full
// spelling, which is the projection the containment rule exists to answer.
type ParentEnvSupplyAccum {
  by_owner: Map<String, Map<String, ResolvedFuncSig>>
  owner_order: List<String>
}

fn supply_admit_row(acc: ParentEnvSupplyAccum, owner: String, key: String, sig: ResolvedFuncSig) -> ParentEnvSupplyAccum {
  match map_get(acc.by_owner, owner) {
    Present { value: locals } =>
      ParentEnvSupplyAccum { by_owner: map_insert(acc.by_owner, owner, map_insert(locals, key, sig)), owner_order: acc.owner_order }
    Absent =>
      ParentEnvSupplyAccum {
        by_owner: map_insert(acc.by_owner, owner, map_insert(empty_map(), key, sig)),
        owner_order: list_push(acc.owner_order, owner)
      }
  }
}

fn reference_derived_parent_envs(
  items: List<Node>,
  index: CallableOwnerIndex,
  module_name: String,
  source_indices: Map<String, NewlineIndex>
) -> List<ResolvedFuncEnv> {
  let names = callable_reference_names(items: items, source_indices: source_indices)
  let supply = fold(names, init: ParentEnvSupplyAccum { by_owner: empty_map(), owner_order: [] }, f: (acc, name) =>
    let leaf = qualified_last_segment(name: name)
    let qualifier = reference_containment_qualifier(name: name)
    match map_get(index.by_name, leaf) {
      Present { value: rows } =>
        fold(rows, init: acc, f: (inner, row) =>
          if (if string_length(s: qualifier) == 0 {
                containment_chain_admits_owner(owner_module_path: row.owner_module_path, referencing_module_path: module_name)
              } else {
                containment_admits_owner(owner_module_path: row.owner_module_path, qualifier: qualifier)
              }) {
            supply_admit_row(acc: inner, owner: row.owner_module_path, key: name, sig: row.sig)
          } else { inner }
        )
      Absent => acc
    }
  )
  supply.owner_order |> flat_map(owner =>
    match map_get(supply.by_owner, owner) {
      Present { value: locals } => [ResolvedFuncEnv { name: owner, local: locals, parents: [] }]
      Absent => []
    }
  )
}

fn func_reaches_self(root: String, current: String, call_edges: List<CallEdge>, visited: Map<String, Bool>) -> Bool {
  if emit_map_has(m: visited, key: current) { false }
  else {
    let next_visited = map_insert(visited, current, true)
    let callees = call_edges |> filter(e => e.caller == current) |> map(e => e.callee)
    callees |> any(c =>
      if c == root { true }
      else { func_reaches_self(root: root, current: c, call_edges: call_edges, visited: next_visited) }
    )
  }
}

fn build_name_set(names: List<String>) -> Map<String, Bool> {
  fold(names, init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
}

fn declared_to_resolved(dsig: DeclaredFuncSig) -> ResolvedFuncSig {
  ResolvedFuncSig { name: dsig.name, params: dsig.params, resolved_formals: LocalFormalsAwaitingModuleContext {}, inferred: dsig.inferred.value, is_async: dsig.is_async, output_provenance: dsig.output_provenance, variant_provenance: dsig.variant_provenance }
}

fn merge_remaining_declared(declared_sigs: Map<String, DeclaredFuncSig>, resolved: Map<String, ResolvedFuncSig>) -> Map<String, ResolvedFuncSig> {
  fold(map_values(declared_sigs), init: resolved, f: (acc, dsig) =>
    if dsig.inferred != none {
      map_insert(acc, dsig.name, declared_to_resolved(dsig: dsig))
    } else { acc }
  )
}

fn topo_resolve_loop(
    remaining: List<String>,
    resolved: Map<String, ResolvedFuncSig>,
    declared_sigs: Map<String, DeclaredFuncSig>,
    call_edges: List<CallEdge>,
    local_func_set: Map<String, Bool>,
    module_name: String,
    diagnostics: List<ErrorNode>,
    parent_envs: List<ResolvedFuncEnv>,
    fuel: Int
) -> ResolveFuncSigsResult {
  if remaining |> count == 0 {
    let all_resolved = fold(map_values(declared_sigs), init: resolved, f: (acc, dsig) =>
      if dsig.inferred != none {
        map_insert(acc, dsig.name, declared_to_resolved(dsig: dsig))
      } else { acc }
    )
    return ResolveFuncSigsResult {
      func_env: ResolvedFuncEnv { name: module_name, local: all_resolved, parents: parent_envs },
      diagnostics: diagnostics
    }
  }

  let ready = remaining |> filter(fn_name =>
    let local_callees = call_edges
      |> filter(e => e.caller == fn_name)
      |> map(e => e.callee)
      |> filter(c => emit_map_has(m: local_func_set, key: c))
    local_callees |> all(c => map_get(resolved, c) != none)
  )

  if ready |> count == 0 {
    let cycle_accum = fold(remaining, init: SigsAccum { signatures: resolved, diagnostics: [] }, f: (acc, fn_name) =>
      match map_get(declared_sigs, fn_name) {
        Present { value: dsig } =>
          if dsig.inferred != none {
            SigsAccum { signatures: map_insert(acc.signatures, fn_name, declared_to_resolved(dsig: dsig)), diagnostics: acc.diagnostics }
          } else {
            SigsAccum { signatures: acc.signatures, diagnostics: list_push(acc.diagnostics, make_error_node(diagnostic: MissingAnnotation { fn_name: fn_name, what: "return type (recursive)", span: no_span() }, module_name: module_name)) }
          }
        Absent => acc
      }
    )
    let all_resolved = fold(map_values(declared_sigs), init: cycle_accum.signatures, f: (acc, dsig) =>
      if dsig.inferred != none {
        map_insert(acc, dsig.name, declared_to_resolved(dsig: dsig))
      } else { acc }
    )
    return ResolveFuncSigsResult {
      func_env: ResolvedFuncEnv { name: module_name, local: all_resolved, parents: parent_envs },
      diagnostics: concat(diagnostics, cycle_accum.diagnostics)
    }
  }

  let ready_accum = fold(ready, init: SigsAccum { signatures: resolved, diagnostics: diagnostics }, f: (acc, fn_name) =>
    match map_get(declared_sigs, fn_name) {
      Present { value: dsig } =>
        if dsig.inferred != none {
          SigsAccum { signatures: map_insert(acc.signatures, fn_name, declared_to_resolved(dsig: dsig)), diagnostics: acc.diagnostics }
        } else {
          SigsAccum { signatures: acc.signatures, diagnostics: list_push(acc.diagnostics, make_error_node(diagnostic: MissingAnnotation { fn_name: fn_name, what: "return type", span: no_span() }, module_name: module_name)) }
        }
      Absent => acc
    }
  )

  let ready_set = fold(ready, init: empty_map(), f: (acc, fn_name) => map_insert(acc, fn_name, true))
  let next_remaining = remaining |> filter(fn_name => emit_map_has(m: ready_set, key: fn_name) == false)

  topo_resolve_loop(
    remaining: next_remaining,
    resolved: ready_accum.signatures,
    declared_sigs: declared_sigs,
    call_edges: call_edges,
    local_func_set: local_func_set,
    module_name: module_name,
    diagnostics: ready_accum.diagnostics,
    parent_envs: parent_envs,
    fuel: fuel - 1
  )
}

fn resolve_func_sigs(
    declared_sigs: Map<String, DeclaredFuncSig>,
    parent_envs: List<ResolvedFuncEnv>,
    items: List<Node>,
    module_name: String,
    source_indices: Map<String, NewlineIndex>
) -> ResolveFuncSigsResult {
  let local_func_names = items
    |> filter(item => item.params |> count > 0 && item.body != none)
    |> map(item => authored_name_at(source_indices: source_indices, node: item))
  let local_func_set = build_name_set(names: local_func_names)
  let call_edges = collect_func_call_edges(items: items, local_func_set: local_func_set, source_indices: source_indices)
  topo_resolve_loop(
    remaining: local_func_names,
    resolved: empty_map(),
    declared_sigs: declared_sigs,
    call_edges: call_edges,
    local_func_set: local_func_set,
    module_name: module_name,
    diagnostics: [],
    parent_envs: flatten_parent_envs(direct_parents: parent_envs),
    fuel: local_func_names |> count
  )
}
