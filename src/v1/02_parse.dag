  mock_props: List<Node>,
  tokens: TokenStream, ctx: ParseContext, err: ErrorNode?
}
type UnitResult { tokens: TokenStream, err: ErrorNode? }
type StringLitResult { value: String, tokens: TokenStream, err: ErrorNode? }
type IntLitResult { value: Int, tokens: TokenStream, err: ErrorNode? }

type ParserHelperIdentity
  = ParserHelperSkipNewlines
  | ParserHelperSkipContinuationNewlines
  | ParserHelperWith

type ParserCallIdentity
  = ParserCallHelper { helper: ParserHelperIdentity }
  | ParserCallFunction { name: String }

type ParserResultWitness
  = ParserWitnessAdvance
  | ParserWitnessExpect
  | ParserWitnessEat
  | ParserWitnessCall { callee: ParserCallIdentity }
  | ParserWitnessOpaque

type DescResult { desc: String?, tokens: TokenStream }

fn token_span(tok: Token?) -> SourceSpan {
  match tok { Present { value: t } => t.span  Absent => make_span(start: 0, end: 0) }
}

fn advance(tokens: TokenStream) -> AdvanceResult {
  match token_stream_first(stream: tokens) {
    Present { value: t } => AdvanceOk { token: t, tokens: token_stream_advance(stream: tokens, n: 1) }
    Absent => AdvanceEof
  }
}

fn parse_error(msg: String, span: SourceSpan) -> ErrorNode {
  make_error_node(diagnostic: ParseError { message: msg, span: span }, module_name: "")
}

fn has_err(err: ErrorNode?) -> Bool {
  match err {
    Present { value: _ } => true
    Absent => false
  }
}

fn parse_string_literal_value(tokens: TokenStream) -> StringLitResult {
  let tok = token_stream_first(stream: tokens)
  match tok {
    Present { value: t } =>
      match t.shape {
        ShLitStr =>
          StringLitResult { value: t.text, tokens: token_stream_advance(stream: tokens, n: 1), err: none }
        _ =>
          StringLitResult { value: "", tokens: tokens, err: Present { value: parse_error(msg: "expected string literal", span: token_span(tok: tok)) } }
      }
    Absent =>
      StringLitResult { value: "", tokens: tokens, err: Present { value: parse_error(msg: "expected string literal", span: make_span(start: 0, end: 0)) } }
  }
}

fn parse_int_literal_value(tokens: TokenStream) -> IntLitResult {
  let tok = token_stream_first(stream: tokens)
  match tok {
    Present { value: t } =>
      match t.shape {
        ShLitInt =>
          let n_opt = parse_int(s: t.text)
          match n_opt {
            Present { value: n } =>
              IntLitResult { value: n, tokens: token_stream_advance(stream: tokens, n: 1), err: none }
            Absent =>
              IntLitResult { value: 0, tokens: tokens, err: Present { value: parse_error(msg: concat("internal: ShLitInt token text not parseable as int: '", t.text, "'"), span: token_span(tok: tok)) } }
          }
        _ =>
          IntLitResult { value: 0, tokens: tokens, err: Present { value: parse_error(msg: "expected integer literal", span: token_span(tok: tok)) } }
      }
    Absent =>
      IntLitResult { value: 0, tokens: tokens, err: Present { value: parse_error(msg: "expected integer literal", span: make_span(start: 0, end: 0)) } }
  }
}

fn is_ident_shape(shape: TokenShape) -> Bool { match shape { ShIdent => true  _ => false } }
fn is_lit_str_shape(shape: TokenShape) -> Bool { match shape { ShLitStr => true  _ => false } }
fn is_lit_int_shape(shape: TokenShape) -> Bool { match shape { ShLitInt => true  _ => false } }
fn is_lit_float_shape(shape: TokenShape) -> Bool { match shape { ShLitFloat => true  _ => false } }
