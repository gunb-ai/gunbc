type TokenStream {
  all: List<Token>
  pos: Int
}

fn token_stream_new(all: List<Token>) -> TokenStream {
  TokenStream { all: all, pos: 0 }
}

fn token_stream_empty() -> TokenStream {
  TokenStream { all: [], pos: 0 }
}

fn token_stream_position(stream: TokenStream) -> Int {
  stream.pos
}

fn token_stream_first(stream: TokenStream) -> Token? {
  get(xs: stream.all, index: stream.pos)
}

fn token_stream_advance(stream: TokenStream, n: Int) -> TokenStream {
  TokenStream { all: stream.all, pos: stream.pos + n }
}

fn token_stream_peek(stream: TokenStream, offset: Int) -> Token? {
  get(xs: stream.all, index: stream.pos + offset)
}

type ParseContext {
  source_indices: Map<String, NewlineIndex>
  intern_table: InternTable
}

type ParseResult {
  module: Node?
  error: ErrorNode?
}

type ParseWithTableResult {
  result: ParseResult
  intern_table: InternTable
}

type AdvanceResult
  = AdvanceOk { token: Token, tokens: TokenStream }
  | AdvanceEof
type EatResult
  = EatConsumed { token: Token, tokens: TokenStream }
  | EatUnchanged { tokens: TokenStream }

type TokenResult { token: Token, tokens: TokenStream, err: ErrorNode? }
