module v1.compiler.workspace_members


fn workspace_members_region_begin_marker() -> String {
  "    # BEGIN generated stage0 crate members -- regen_stage0 writes this region (authority: v1.compiler.workspace_members)"
}

fn workspace_members_region_end_marker() -> String {
  "    # END generated stage0 crate members"
}

fn stage0_member_entry(spec: v1.compiler.stage0_crates.Stage0CrateSpec) -> String {
  concat("    \"", spec.crate_dir, "\",")
}

fn stage0_workspace_member_region() -> String {
  match v1.compiler.stage0_crates.stage0_crate_plan_outcome() {
    v1.compiler.stage0_crates.Stage0CratePlanOk { plan: plan } =>
      plan.crates |> map(stage0_member_entry) |> join(separator: "\n")
    v1.compiler.stage0_crates.Stage0CratePlanRefused { cause: cause } =>
      concat(
        "    # REFUSED: ",
        v1.compiler.stage0_crates.stage0_crate_boundary_emit_refusal_message(
          cause: v1.compiler.stage0_crates.stage0_map_package_dir_refusal_to_boundary(cause: cause)
        )
      )
  }
}
