module v1.compiler.infer_method

import std.types { SourceSpan }
import v1.std.core {
  Node, TypeVariable, Resolved,
  NoConnective,
  Required,
  NoExprData,
  ErrorNode,
  make_span, with_optional_cardinality,
  unit_type, bool_type, string_type, hash_type, int_type
}
import v1.compiler.infer_types {
  make_container_type, make_map_type
}

fn type_variable_node(id: String) -> Node {
  Node { name: "", span: make_span(start: 0, end: 0), ident_span: none, children: [], connective: NoConnective, params: [], inferred: Present { value: TypeVariable { id: id } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
}

fn map_of_type_variables() -> Node {
  make_map_type(key: type_variable_node(id: "map_key"), value: type_variable_node(id: "map_value")).ty
}

fn list_of_type_variable(id: String) -> Node {
  make_container_type(kind_name: "List", element: type_variable_node(id: id)).ty
}

fn list_of_element(element: Node) -> Node {
  make_container_type(kind_name: "List", element: element).ty
}

fn witness_of_element(element: Node) -> Node {
  make_container_type(kind_name: "Witness", element: element).ty
}

fn seed_node_map(key: String, value: Node) -> Map<String, Node> {
  map_insert(empty_map(), key, value)
}

fn builtin_kernel_seed_diagnostics() -> List<ErrorNode> {
  concat(
    concat(
      make_map_type(key: type_variable_node(id: "map_key"), value: type_variable_node(id: "map_value")).diagnostics,
      make_container_type(kind_name: "List", element: type_variable_node(id: "collection_element")).diagnostics
    ),
    make_container_type(kind_name: "Set", element: type_variable_node(id: "set_elem")).diagnostics
  )
}

fn builtin_function_registry() -> Map<String, Node> {
  let m = seed_node_map(key: "count", value: int_type)
  let m = map_insert(m, "string_length", int_type)
  let m = map_insert(m, "code_point", int_type)
  let m = map_insert(m, "to_int", int_type)
  let m = map_insert(m, "scan_while", int_type)
  let m = map_insert(m, "scan_string_end", int_type)
  let m = map_insert(m, "scan_to_eol", int_type)
  let m = map_insert(m, "skip_horizontal_ws", int_type)
  let m = map_insert(m, "parse_int", with_optional_cardinality(n: int_type))
  let m = map_insert(m, "char_at", string_type)
  let m = map_insert(m, "substring", string_type)
  let m = map_insert(m, "from_code_point", string_type)
  let m = map_insert(m, "chars_to_string", string_type)
  let m = map_insert(m, "record_source_chars_index_lookup", unit_type)
  let m = map_insert(m, "to_string", string_type)

  let m = map_insert(m, "discriminant", string_type)
  let m = map_insert(m, "concat", string_type)
  let m = map_insert(m, "map_insert", map_of_type_variables())
  let m = map_insert(m, "map_merge", map_of_type_variables())
  let m = map_insert(m, "with", map_of_type_variables())
  let set_ty = make_container_type(kind_name: "Set", element: type_variable_node(id: "set_elem")).ty
  let m = map_insert(m, "empty_set", set_ty)
  let m = map_insert(m, "set_insert", set_ty)
  let m = map_insert(m, "set_union", set_ty)
  let m = map_insert(m, "map_contains_key", bool_type)
  let m = map_insert(m, "map_has", bool_type)
  let m = map_insert(m, "map_is_empty", bool_type)

  let m = map_insert(m, "rc_ptr_eq", bool_type)
  let m = map_insert(m, "rc_vec_ptr_eq", bool_type)
  let m = map_insert(m, "emit_map_has", bool_type)
  let m = map_insert(m, "set_contains", bool_type)
  let m = map_insert(m, "lookup", witness_of_element(element: type_variable_node(id: "map_value")))
  let m = map_insert(m, "map_get", with_optional_cardinality(n: type_variable_node(id: "map_value")))
  let m = map_insert(m, "Some", with_optional_cardinality(n: type_variable_node(id: "some_inner")))
  let m = map_insert(m, "map_keys", list_of_type_variable(id: "collection_element"))
  let m = map_insert(m, "map_values", list_of_type_variable(id: "collection_element"))
  let m = map_insert(m, "reverse", list_of_type_variable(id: "collection_element"))
  let m = map_insert(m, "list_push", list_of_type_variable(id: "collection_element"))
  let m = map_insert(m, "hash_combine", hash_type)
  let m = map_insert(m, "atom_identity_hash", hash_type)
  let m = map_insert(m, "string_contains", bool_type)
  let m = map_insert(m, "filesystem_read", type_variable_node(id: "filesystem_read_result"))
  let m = map_insert(m, "contiguous_loop_elementwise_kernel", list_of_type_variable(id: "collection_element"))
  let m = map_insert(m, "contiguous_loop_elementwise_float_kernel", list_of_type_variable(id: "collection_element"))
  let m = map_insert(m, "shell_materialize_argv_for_operation", list_of_element(element: string_type))
  let m = map_insert(m, "extdeps_shape_transport_policy_facts_for_qualified_name", type_variable_node(id: "extdeps_module_facts_record"))
  let m = map_insert(m, "extdeps_qualified_name_resolves_in_derived_module_set", bool_type)
  let m = map_insert(m, "extdeps_external_authority_anchor_kind_for_qualified_name", string_type)
  let m = map_insert(m, "extdeps_external_authority_scheme_identity_for_qualified_name", string_type)
  let m = map_insert(m, "extdeps_external_authority_locator_for_qualified_name", string_type)
  let m = map_insert(m, "extdeps_derived_extdeps_modules", list_of_type_variable(id: "extdeps_derived_extdeps_module_elem"))
  let m = map_insert(m, "extdeps_external_authority_backfill_entries", list_of_type_variable(id: "extdeps_external_authority_backfill_entry_elem"))
  let m = map_insert(m, "extdeps_external_authority_is_backfill_pending_for_qualified_name", bool_type)
  let m = map_insert(m, "extdeps_external_authority_is_machinery_exempt_for_qualified_name", bool_type)
  let m = map_insert(m, "extdeps_external_authority_is_clean_tree_roster_excluded_for_qualified_name", bool_type)
  let m = map_insert(m, "extdeps_external_authority_live_clean_tree_holds", bool_type)
  let m = map_insert(m, "extdeps_external_authority_anchor_shadow_masked_for_qualified_name", bool_type)
  let m = map_insert(m, "extdeps_external_authority_live_shadow_mask_holds", bool_type)
  let m = map_insert(m, "extdeps_external_authority_live_roster_module_count", int_type)
  let m = map_insert(m, "doc_graph_orphan_count", int_type)
  let m = map_insert(m, "doc_graph_dangling_link_count", int_type)
  let m = map_insert(m, "doc_graph_doc_count", int_type)
  let m = map_insert(m, "inert_carrier_count", int_type)
  let m = map_insert(m, "inert_carrier_unrostered_count", int_type)
  let m = map_insert(m, "inert_carrier_stale_roster_count", int_type)
  let m = map_insert(m, "inert_carrier_declared_count", int_type)
  let m = map_insert(m, "inert_lens_unreached_module_count", int_type)
  let m = map_insert(m, "inert_lens_top_level_module_count", int_type)
  let m = map_insert(m, "non_fold_residue_count", int_type)
  let m = map_insert(m, "non_fold_residue_unrostered_count", int_type)
  let m = map_insert(m, "non_fold_residue_stale_roster_count", int_type)
  let m = map_insert(m, "non_fold_residue_coproduct_universe_count", int_type)
  let m = map_insert(m, "census_corpus_roots_follow_layer_authority", bool_type)
  let m = map_insert(m, "transport_script_literal_violation_count_for_path", int_type)
  let m = map_insert(m, "layer_import_facts", list_of_type_variable(id: "layer_import_fact_elem"))
  let m = map_insert(m, "import_resolution_facts", list_of_type_variable(id: "import_resolution_fact_elem"))
  let m = map_insert(m, "module_declaration_facts", list_of_type_variable(id: "module_declaration_fact_elem"))
  let m = map_insert(m, "concept_decl_facts", list_of_type_variable(id: "concept_decl_elem"))
  let m = map_insert(m, "medium_structure_leak_facts", list_of_type_variable(id: "medium_structure_leak_fact_elem"))
  let m = map_insert(m, "fact_cardinality_cross_tree_coexistence_count", int_type)
  let m = map_insert(m, "fact_cardinality_cross_tree_diverged_fork_count", int_type)
  let m = map_insert(m, "fact_cardinality_cross_tree_is_coexistence", bool_type)
  let m = map_insert(m, "fact_cardinality_cross_tree_is_diverged_fork", bool_type)
  let m = map_insert(m, "languages_consumer_census_data_decl_count", int_type)
  let m = map_insert(m, "languages_consumer_census_per_language_row_count", int_type)
  let m = map_insert(m, "languages_consumer_census_format_row_count", int_type)
  let m = map_insert(m, "languages_consumer_census_external_consumer_count", int_type)
  let m = map_insert(m, "languages_consumer_census_is_composition_only", bool_type)
  let m = map_insert(m, "languages_consumer_census_has_external_consumer", bool_type)
  let m = map_insert(m, "is_xid_start", bool_type)
  let m = map_insert(m, "is_xid_continue", bool_type)
  let m = map_insert(m, "is_emoji_ident", bool_type)
  m
}

fn infer_builtin_call_type(name: String) -> Node? {
  map_get(builtin_function_registry(), name)
}

fn resolve_builtin_call_type(name: String) -> Node {
  match infer_builtin_call_type(name: name) {
    Present { value: v } => v
    Absent => unit_type
  }
}
