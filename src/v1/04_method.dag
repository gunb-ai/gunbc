  "complexity_linearity_syntactic_site_fired": bool_type,
  "fallback_arm_census_facts": list_of_type_variable(id: "fallback_arm_census_fact_elem"),
  "fallback_arm_census_class_count": int_type,
  "fallback_arm_census_total": int_type,
  "fallback_arm_census_reconciliation_holds": bool_type,
  "census_corpus_roots_follow_layer_authority": bool_type,
  "transport_script_position_facts_for_path": list_of_type_variable(id: "transport_script_position_fact_elem"),
  "layer_import_facts": list_of_type_variable(id: "layer_import_fact_elem"),
  "import_resolution_facts": list_of_type_variable(id: "import_resolution_fact_elem"),
  "reference_resolution_facts": list_of_type_variable(id: "import_resolution_fact_elem"),
  "dependency_resolution_facts": list_of_type_variable(id: "module_dependency_edge_elem"),
  "module_declaration_facts": list_of_type_variable(id: "module_declaration_fact_elem"),
  "concept_decl_facts": list_of_type_variable(id: "concept_decl_elem"),
  "decl_facts": list_of_type_variable(id: "decl_fact_elem"),
  "export_signature_facts": list_of_type_variable(id: "decl_fact_elem"),
  "data_decl_type_facts": list_of_type_variable(id: "data_decl_type_fact_elem"),
  "fact_cardinality_decl_facts": list_of_type_variable(id: "fact_cardinality_decl_fact_elem"),
  "languages_consumer_census_data_decl_count": int_type,
  "languages_consumer_census_per_language_row_count": int_type,
  "languages_consumer_census_format_row_count": int_type,
  "languages_consumer_census_external_consumer_count": int_type,
  "languages_consumer_census_is_composition_only": bool_type,
  "languages_consumer_census_has_external_consumer": bool_type,
  "is_xid_start": bool_type,
  "is_xid_continue": bool_type,
  "is_emoji_ident": bool_type
}

fn infer_builtin_call_type(name: String) -> Node? {
  map_get(builtin_function_registry, name)
}

fn resolve_builtin_call_type(name: String) -> Node {
  match infer_builtin_call_type(name: name) {
    Present { value: v } => v
    Absent => unit_type
  }
}
