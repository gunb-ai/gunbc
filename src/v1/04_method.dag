fn infer_builtin_call_type(name: String) -> v1.std.core.Node? {
  map_get(builtin_function_registry(), name)
}

fn resolve_builtin_call_type(name: String) -> v1.std.core.Node {
  match infer_builtin_call_type(name: name) {
    Present { value: v } => v
    Absent => v1.std.core.unit_type
  }
}
