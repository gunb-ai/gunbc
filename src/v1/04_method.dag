module v1.compiler.infer_method

import std.occurrence_identity { OccurrenceSynthetic }

import std.types { SourceSpan }

import std.algebra {
  AlgebraProfile, FreeMonoidCollectionProfile, all_algebra_profiles,
  AlgebraFieldTemplate, algebra_templates_for_profile,
  AlgebraTypeTemplate, ReceiverSelf, ReceiverElement, ReceiverKey, ReceiverValue,
  NamedTemplate, ContainerOf, ContainerSource, SameAsReceiver, Named,
  OptionalOf, WitnessOf, TupleOf, CallableOf, AlgebraTypeVariable
}

import v1.std.core {
  Node, TypeVariable, Resolved,
  NoConnective,
  Required,
  NoExprData,
  ErrorNode,
  no_span, with_optional_cardinality,
  unit_type, bool_type, string_type, hash_type, int_type
}
import v1.compiler.infer_types {
  make_container_type, make_map_type,
  make_kernel_record_type, make_kernel_record_field
}

// filesystem_read was registered as a bare type_variable_node, so `filesystem_read(path:
// p).content` established no type at all: the field lookup found nothing to look in, and the result
// was a fabricated Primitive() carrying no name. Downstream `.split` on that value was then
// accepted with no judgment behind it, which is #7479's shape one layer down — and it survived
// because the runtime dispatches split on the native String regardless, so nothing ever failed
// loudly enough to be found. The return type was never unknown; runtime_rust.dag rt_filesystem
// already emits `pub struct FilesystemReadResult { pub content: String }`. Declaring it here makes
// the seed's Rust struct and the compiler's type ONE fact rather than two (DESIGN §3), so the
// field's type is read from the declaration instead of invented. Any future builtin returning a
// product declares it the same way; a bare type variable is correct only where the result genuinely
// IS parametric.

type BuiltinParam {
  name: String
  ty: AlgebraTypeTemplate
}

type BuiltinSignature {
  params: List<BuiltinParam>
  returns: Node
}

fn algebra_param_templates(method: String) -> List<AlgebraTypeTemplate> {
  match all_algebra_profiles()
    |> flat_map(p => algebra_templates_for_profile(profile: p) |> filter(t => t.name == method))
    |> first {
    Present { value: t } => t.param_types
    Absent => []
  }
}

fn algebra_param_templates_in(profile: AlgebraProfile, method: String) -> List<AlgebraTypeTemplate> {
  match algebra_templates_for_profile(profile: profile) |> filter(t => t.name == method) |> first {
    Present { value: t } => t.param_types
    Absent => []
  }
}

// THE UNPAIRED FALLBACK IS A FABRICATED SUBSTITUTION AND NOTHING CHECKS IT. If a row declares more
// names than std.algebra declares templates, this yields a type variable spelled
// unpaired_declared_parameter rather than refusing, because a .dag data initializer has no refusal
// channel -- the registry is a `data` value and there is nowhere for a diagnostic to go at
// construction. That is DESIGN section 5's fabricated-plausible-output arm, named here rather than
// hidden: the line does not stop, it produces a plausible-looking type and carries on. The marker
// is greppable and appears in the emitted mirror, but NO CONSUMER ASSERTS ITS ABSENCE today, and an
// unchecked marker is an inert lens, not a wall. The declared drop for this is
// gunbc.rung_drop builtin_signature_arity_pairing_fabricates.
fn pair_declared_names(names: List<String>, templates: List<AlgebraTypeTemplate>) -> List<BuiltinParam> {
  names |> enumerate |> map(pair =>
    BuiltinParam {
      name: pair.second,
      ty: match templates |> get(pair.first) {
        Present { value: t } => t
        Absent => AlgebraTypeVariable { id: "unpaired_declared_parameter" }
      }
    })
}

fn derived_signature(names: List<String>, method: String, returns: Node) -> BuiltinSignature {
  BuiltinSignature {
    params: pair_declared_names(names: names, templates: algebra_param_templates(method: method)),
    returns: returns
  }
}

// THE PROFILE HERE IS DECLARED, NOT DERIVED, and the distinction is the point of this change. get
// is declared in three algebra profiles with two signatures -- (Self, Int) -> Element? in
// free_monoid_collection, (Self, Key) -> Value? in the two function profiles -- so the algebra does
// not answer which one a name-keyed registry means. The collection profile is chosen because the
// registry's own prior return type for get was Optional<collection_element>, which matches that arm
// and not the other. That is a COMPATIBILITY argument reading the structure being replaced, not a
// derivation from the algebra, and it is written as a declared choice so a later reader can reopen
// it against the algebra instead of finding a rule that looks derived. Measured before authoring:
// no call site reaches this row with a map receiver -- every free call passes a list and an index,
// and method-position calls resolve through the receiver-keyed profile path, with
// func_sig_from_global_bare short-circuiting every algebra method name before the registry.
fn derived_signature_in(profile: AlgebraProfile, names: List<String>, method: String, returns: Node) -> BuiltinSignature {
  BuiltinSignature {
    params: pair_declared_names(names: names, templates: algebra_param_templates_in(profile: profile, method: method)),
    returns: returns
  }
}

fn filesystem_read_result_type() -> Node {
  make_kernel_record_type(
    type_name: "FilesystemReadResult",
    fields: [make_kernel_record_field(field_name: "content", field_type: string_type)]
  )
}

fn type_variable_node(id: String) -> Node {
  Node { occurrence_identity: OccurrenceSynthetic, name: "", span: no_span(), ident_span: none, children: [], connective: NoConnective, params: [], inferred: Present { value: TypeVariable { id: id } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
}

fn map_of_type_variables() -> Node {
  make_map_type(key: type_variable_node(id: "map_key"), value: type_variable_node(id: "map_value")).ty
}

fn list_of_type_variable(id: String) -> Node {
  make_container_type(kind_name: "List", element: type_variable_node(id: id)).ty
}

fn list_of_element(element: Node) -> Node {
  make_container_type(kind_name: "List", element: element).ty
}

fn builtin_kernel_seed_diagnostics() -> List<ErrorNode> {
  concat(
    concat(
      make_map_type(key: type_variable_node(id: "map_key"), value: type_variable_node(id: "map_value")).diagnostics,
      make_container_type(kind_name: "List", element: type_variable_node(id: "collection_element")).diagnostics
    ),
    make_container_type(kind_name: "Set", element: type_variable_node(id: "set_elem")).diagnostics
  )
}

// WHY THIS ROW EXISTS, and why it is additive rather than contested (ladder-probe-corpus,
// operator-amended scope 2026-08-01). Its sibling compile_dag_rust_emit_check compiles a synthetic
// source and collapses the whole result to a Bool - it counts diagnostics passing
// compile_clean_diagnostic_is_hard and answers false when that count is nonzero. That discards
// three facts the guarantee probe corpus must observe: WHICH judgment fired (a probe refusing for
// any hard reason, a typo included, otherwise reads as the wall firing), whether it BLOCKS (the
// filter IS the severity predicate, so demoting a landed wall from blocking to advisory turns its
// RED silently green), and every advisory (so a positive control cannot state
// zero-diagnostics-of-ANY-severity, the assertion codex review 45357 added after an advisory
// MethodExistenceUndecided passed unnoticed as a green control). The Stage-0 receipt vocabulary
// gunbc.guarantee_measurement makes the gap structural rather than stylistic: RefusedTyped and
// AcceptedCounted both carry a diagnostic class and a count, and neither is inhabitable from a
// Bool, so without this row that schema is uninhabitable on every v1 path. MEASUREMENT ONLY - the
// host arm reports what the compile decided and filters nothing; callers filter. Registered as a
// type variable rather than a kernel record because the result is a COPRODUCT (observed census vs
// typed not-runnable, the top-as-answer/top-as-ignorance split), following
// shell_materialize_operation_argv's argv_materialization_result precedent;
// filesystem_read_result_type's make_kernel_record_type idiom is the right one only for a product.
// DISSOLUTION, answering the compile_clean_forcecheck objection in place: this registry is itself a
// flat global map that plan argues is a section-3 fork awaiting the PrimitiveDefinition identity
// join, and this row inherits that trigger EXACTLY as its sibling does - when the join dissolves
// the registry, the two migrate together. One additive row is linear cost against that dissolution;
// the alternative was a schema no v1 probe could inhabit.

// THE MULTI-MODULE COMPILE FIXTURE, and why it is a row rather than an argument to the census row
// above. compile_dag_diagnostic_census compiles ONE synthetic module and resolves its imports
// against build_module_path_index_from_witness_roots, which walks the live checkout - so it cannot
// express any subject whose content is the RELATIONSHIP BETWEEN TWO MODULES, because the second
// module cannot be authored and the corpus is always in the pool. This row registers a builtin
// whose subject is a caller-authored MANIFEST of modules compiled with no module index and no
// corpus roots at all. Registered as a type variable rather than a kernel record for the same
// reason its sibling is: the result is a COPRODUCT with three arms whose owners differ - the
// harness refusing, the subject refusing, and the subject passing. DISSOLUTION: inherits
// compile_dag_diagnostic_census_row_note PrimitiveDefinition identity-join trigger exactly - do not
// mint a fresh trigger.
// THE TWO CI-GATE ROWS ANSWER A COPRODUCT, and the reason is the same one
// compile_dag_diagnostic_census_row_note gives one row up. Their predecessors were three rows --
// consume_floor_compile_clean_gate_verdict as bool_type,
// consume_floor_compile_clean_gate_failure_detail as string_type,
// consume_generated_artifact_drift_gate_failure_detail as string_type -- and the Bool folded FIVE
// host states into false (lock poisoned, install failed, no in-run receipt, the receipt's typed
// Refused arm, and a real failed compile) while folding the scope disposition's Skipped into true.
// The String companions were second builtins over the SAME process global, so a caller
// reconstructed one fact from two correlated reads, and the generated-artifact one fabricated prose
// for the state the Bool had already erased. gunbc.ci_gate GateReceipt is the single carrier:
// GateObserved holds the verdict WITH its located detail, GateNotApplicable is the scope
// disposition answering, GateNotRun is could-not-measure. Registered as a type variable rather than
// a kernel record for the reason its two siblings are -- the result is a coproduct, so
// make_kernel_record_type is the wrong idiom. THE NAME CARRIES A FACT THE OLD ONE HID:
// install_or_consume MAY RUN A WHOLE-TREE COMPILE. Under the executor's lazy-install arm the first
// consume installs the receipt, which is that compile; the predecessor was spelled consume_ and
// documented as reading the receipt only, so a .dag reader had no way to see the cost. DISSOLUTION:
// inherits compile_dag_diagnostic_census_row_note's PrimitiveDefinition identity-join trigger
// exactly -- do not mint a fresh trigger.

// CLASS B binding-source observation for declared-import-closure-only compiles (#6985). Production
// classify_unlisted_import_binding_source already exists in cli_run.rs; this row exposes it through
// the same builtin-registry pattern as compile_dag_diagnostic_census: coproduct result (observed
// binding vs not-runnable), registered as type_variable_node(id:
// declared_import_closure_binding_result) rather than a kernel record. MEASUREMENT ONLY — callers
// judge ListedImport vs PoolCoincidence vs refusal. DISSOLUTION: inherits
// compile_dag_diagnostic_census_row_note's PrimitiveDefinition identity-join trigger exactly — one
// additive row is linear cost against that dissolution; do not mint a fresh trigger.

// `emit_map_has` WAS A ROW OF THE REGISTRY BELOW AND HAD NO RUNTIME AT ANY TIER
// (deleted 2026-08-23; it sat between `rc_vec_ptr_eq` and `set_contains`). This note is
// module-scope because that is the only annotation grain the language models -- a block
// inside the registry body is refused, so it is attached to the declaration instead.
//
// A registry row types a bare call; an interpreter arm runs it. This name had the first and
// not the second -- no free-call arm, no method arm, no bridge -- so `emit_map_has(m:, key:)`
// typechecked clean and answered `NoSuchFunction` when evaluated. Measured by execution, not
// by reading the dispatch table: a probe calling it bare through `gunbc run` refused with
// `NoSuchFunction { name: "emit_map_has" }` while the same probe's `map_get` and `length`
// calls returned 7 and 3.
//
// WHY THAT IS THE SAME CLASS AS gap-analysis row 30 WITH THE HALVES SWAPPED, which is why it
// is deleted alongside the callable-candidate work rather than filed separately: there, a
// consumer's import closure CHANGED a name's meaning; here the closure is the only thing
// SUPPLYING one. All 20 live call sites reach the declared `v1.compiler.infer_types`
// `emit_map_has` through their own closure, so every one of them resolves to the declaration
// and none was ever served by this row -- which is exactly what made it invisible. The first
// module to call the name without that closure would have been handed a certified call with
// nothing behind it.
//
// THE COUNT: 20 CALL SITES, not 21. An earlier revision of this note said 21, which counted
// the declaration in `04_types.dag` as one of its own callers -- the same measure-the-name-
// rather-than-the-binding error this whole change exists to close, committed inside the
// receipt for it. Recorded rather than silently corrected: a count that moves between two
// tellings with no reason given is the shape people stop trusting.
//
// Deleting the row costs no call site (20 of 20 keep resolving to the declaration) and makes
// the typecheck honest: a caller outside that closure now gets an unresolved-name refusal at
// compile time instead of a runtime `NoSuchFunction`.

// A CONSTANT, DECLARED AS ONE. This was a `fn` whose body rebuilt the whole map by 131
// sequential `map_insert`s on every call, and `infer_builtin_call_type` calls it once per
// lookup -- so a single "is this name a builtin" question cost a full reconstruction, and in
// the emitted mirror each insert saw a shared handle and deep-copied the map, making the
// rebuild quadratic in its own entry count. Measured on the seed closure (108 modules) at
// 12,351 calls / 3.9s inside `compile.reconcile`, and `05_emit_rust` asks the same question.
// As a `data` declaration the identical rows lower through the existing cached-constant path
// (the `kernel_type_set` shape in `std.types`), so the map is built once per thread and read
// by key. Same keys, same value expressions, same answers -- the `set_ty` local is inlined at
// its three uses because a `data` initializer has no let bindings.
// A WRONG MONOMORPHIC SIGNATURE THAT LOOKS SPECIFIC IS WORSE THAN `params: []`, WHICH AT LEAST
// ANNOUNCES THAT IT KNOWS NOTHING. That is the rule these 132 rows are authored under, and it
// decided three questions in this change rather than one. It is why NamedTemplate was not extended
// to name a record -- the arm accepts any string and answers with a well-formed FIELDLESS node, so
// filesystem_read's return would have typechecked against nothing instead of refusing. It is why
// concat stays BINARY rather than being declared signature-less: the signature is expressible and
// true, and erasing a fact that holds is a different failure from asserting one that does not. And
// it is why the type half is DERIVED from std.algebra wherever std.algebra declares it, instead of
// being re-authored here beside the authority that already answers.
//
// EVERY ROW IS CONVERTED, WITH NO REMAINDER, and that is a section 3 requirement rather than
// tidiness: a registry where some rows declare parameters and some do not cannot distinguish a
// NULLARY builtin from an UNDECLARED one, which is the state this change exists to close. The
// forty-five nullary rows here say `params: []` and mean it.
//
// PROVENANCE IS NOT UNIFORM ACROSS THESE ROWS AND THE PR BODY GRADES IT. Type derived from
// std.algebra for the twenty it also declares; name agreed by two sites whose provenance is NOT
// independent (this repository's own call sites and its own emitted runtime text were written to
// match each other); name declared against a disagreement; name evidenced by a single call site.
// One word "declared" covering all four would be the rung inflation the ladder names.
data builtin_function_registry: Map<String, BuiltinSignature> = {
  "count": derived_signature(names: ["xs"], method: "count", returns: int_type),
  "string_length": BuiltinSignature { params: [BuiltinParam { name: "s", ty: NamedTemplate { name: "String" } }], returns: int_type },
  "code_point": BuiltinSignature { params: [BuiltinParam { name: "c", ty: NamedTemplate { name: "String" } }], returns: int_type },
  "to_int": derived_signature(names: ["s"], method: "to_int", returns: int_type),
  "scan_while": BuiltinSignature { params: [BuiltinParam { name: "s", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "start", ty: NamedTemplate { name: "Int" } }, BuiltinParam { name: "pred", ty: CallableOf { params: [NamedTemplate { name: "String" }], return_type: NamedTemplate { name: "Bool" } } }], returns: int_type },
  "scan_string_end": BuiltinSignature { params: [BuiltinParam { name: "s", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "start", ty: NamedTemplate { name: "Int" } }], returns: int_type },
  "scan_to_eol": BuiltinSignature { params: [BuiltinParam { name: "s", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "start", ty: NamedTemplate { name: "Int" } }], returns: int_type },
  "skip_horizontal_ws": BuiltinSignature { params: [BuiltinParam { name: "s", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "start", ty: NamedTemplate { name: "Int" } }], returns: int_type },
  "parse_int": BuiltinSignature { params: [BuiltinParam { name: "s", ty: NamedTemplate { name: "String" } }], returns: with_optional_cardinality(n: int_type) },
  "char_at": BuiltinSignature { params: [BuiltinParam { name: "s", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "pos", ty: NamedTemplate { name: "Int" } }], returns: string_type },
  "substring": derived_signature(names: ["s", "start", "end"], method: "substring", returns: string_type),
  "from_code_point": BuiltinSignature { params: [BuiltinParam { name: "cp", ty: NamedTemplate { name: "Int" } }], returns: string_type },
  "chars_to_string": BuiltinSignature { params: [BuiltinParam { name: "chars", ty: ContainerOf { source: Named { name: "List" }, element: NamedTemplate { name: "Int" } } }, BuiltinParam { name: "start", ty: NamedTemplate { name: "Int" } }, BuiltinParam { name: "end", ty: NamedTemplate { name: "Int" } }], returns: string_type },
  "record_source_chars_index_lookup": BuiltinSignature { params: [], returns: unit_type },
  "resolution_silent_pick_is_enabled": BuiltinSignature { params: [], returns: bool_type },
  "name_resolution_policy_is_namespace_only": BuiltinSignature { params: [], returns: bool_type },
  "type_ref_hit_ne_bind_measure_active": BuiltinSignature { params: [], returns: bool_type },
  "resolution_silent_pick_record_global_bare_lcp_pick": BuiltinSignature { params: [BuiltinParam { name: "env_module_path", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "name", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "candidate_count", ty: NamedTemplate { name: "Int" } }, BuiltinParam { name: "chosen_module_path", ty: NamedTemplate { name: "String" } }], returns: unit_type },
  "resolution_silent_pick_record_global_bare_lcp_tie": BuiltinSignature { params: [BuiltinParam { name: "env_module_path", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "name", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "candidate_count", ty: NamedTemplate { name: "Int" } }], returns: unit_type },
  "resolution_silent_pick_record_fn_parent_first_hit": BuiltinSignature { params: [BuiltinParam { name: "env_module_path", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "name", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "parent_match_count", ty: NamedTemplate { name: "Int" } }, BuiltinParam { name: "chosen_parent_module", ty: NamedTemplate { name: "String" } }], returns: unit_type },
  "to_string": derived_signature(names: ["value"], method: "to_string", returns: string_type),
  "discriminant": BuiltinSignature { params: [BuiltinParam { name: "v", ty: AlgebraTypeVariable { id: "discriminant_subject" } }], returns: string_type },
  "concat": derived_signature(names: ["a", "b"], method: "concat", returns: string_type),
  "map_insert": derived_signature(names: ["m", "key", "value"], method: "map_insert", returns: map_of_type_variables()),
  "map_merge": derived_signature(names: ["m", "overlay"], method: "map_merge", returns: map_of_type_variables()),
  "with": derived_signature(names: ["m", "key", "value"], method: "with", returns: map_of_type_variables()),
  "empty_set": BuiltinSignature { params: [], returns: make_container_type(kind_name: "Set", element: type_variable_node(id: "set_elem")).ty },
  "set_insert": BuiltinSignature { params: [BuiltinParam { name: "set", ty: ContainerOf { source: Named { name: "Set" }, element: AlgebraTypeVariable { id: "set_elem" } } }, BuiltinParam { name: "item", ty: AlgebraTypeVariable { id: "set_elem" } }], returns: make_container_type(kind_name: "Set", element: type_variable_node(id: "set_elem")).ty },
  "set_union": BuiltinSignature { params: [BuiltinParam { name: "set", ty: ContainerOf { source: Named { name: "Set" }, element: AlgebraTypeVariable { id: "set_elem" } } }, BuiltinParam { name: "other", ty: ContainerOf { source: Named { name: "Set" }, element: AlgebraTypeVariable { id: "set_elem" } } }], returns: make_container_type(kind_name: "Set", element: type_variable_node(id: "set_elem")).ty },
  "map_contains_key": derived_signature(names: ["m", "key"], method: "map_contains_key", returns: bool_type),
  "map_has": derived_signature(names: ["m", "key"], method: "map_has", returns: bool_type),
  "map_is_empty": BuiltinSignature { params: [BuiltinParam { name: "m", ty: AlgebraTypeVariable { id: "map_subject" } }], returns: bool_type },
  "rc_ptr_eq": BuiltinSignature { params: [BuiltinParam { name: "a", ty: AlgebraTypeVariable { id: "rc_subject" } }, BuiltinParam { name: "b", ty: AlgebraTypeVariable { id: "rc_subject" } }], returns: bool_type },
  "rc_vec_ptr_eq": BuiltinSignature { params: [BuiltinParam { name: "a", ty: ContainerOf { source: Named { name: "List" }, element: AlgebraTypeVariable { id: "rc_subject" } } }, BuiltinParam { name: "b", ty: ContainerOf { source: Named { name: "List" }, element: AlgebraTypeVariable { id: "rc_subject" } } }], returns: bool_type },
  "set_contains": BuiltinSignature { params: [BuiltinParam { name: "set", ty: ContainerOf { source: Named { name: "Set" }, element: AlgebraTypeVariable { id: "set_elem" } } }, BuiltinParam { name: "item", ty: AlgebraTypeVariable { id: "set_elem" } }], returns: bool_type },
  "lookup": derived_signature(names: ["m", "key"], method: "lookup", returns: with_optional_cardinality(n: type_variable_node(id: "map_value"))),
  "map_get": derived_signature(names: ["m", "key"], method: "map_get", returns: with_optional_cardinality(n: type_variable_node(id: "map_value"))),
  "Some": BuiltinSignature { params: [BuiltinParam { name: "value", ty: AlgebraTypeVariable { id: "some_inner" } }], returns: with_optional_cardinality(n: type_variable_node(id: "some_inner")) },
  "map_keys": derived_signature(names: ["m"], method: "map_keys", returns: list_of_type_variable(id: "collection_element")),
  "sorted_map_keys": BuiltinSignature { params: [BuiltinParam { name: "m", ty: AlgebraTypeVariable { id: "map_subject" } }], returns: list_of_type_variable(id: "collection_element") },
  "map_values": derived_signature(names: ["m"], method: "map_values", returns: list_of_type_variable(id: "collection_element")),
  "get": derived_signature_in(profile: FreeMonoidCollectionProfile, names: ["xs", "index"], method: "get", returns: with_optional_cardinality(n: type_variable_node(id: "collection_element"))),
  "reverse": derived_signature(names: ["xs"], method: "reverse", returns: list_of_type_variable(id: "collection_element")),
  "list_push": derived_signature(names: ["xs", "item"], method: "list_push", returns: list_of_type_variable(id: "collection_element")),
  "hash_combine": BuiltinSignature { params: [BuiltinParam { name: "a", ty: NamedTemplate { name: "Hash" } }, BuiltinParam { name: "b", ty: NamedTemplate { name: "Hash" } }], returns: hash_type },
  "atom_identity_hash": BuiltinSignature { params: [BuiltinParam { name: "s", ty: NamedTemplate { name: "String" } }], returns: hash_type },
  "trace_mark": BuiltinSignature { params: [BuiltinParam { name: "label", ty: NamedTemplate { name: "String" } }], returns: unit_type },
  "observed_peak_resident_bytes": BuiltinSignature { params: [], returns: int_type },
  "observed_monotonic_nanos": BuiltinSignature { params: [], returns: int_type },
  "string_contains": BuiltinSignature { params: [BuiltinParam { name: "s", ty: NamedTemplate { name: "String" } }, BuiltinParam { name: "pattern", ty: NamedTemplate { name: "String" } }], returns: bool_type },
  "length": derived_signature(names: ["xs"], method: "length", returns: int_type),
  "starts_with": derived_signature(names: ["s", "prefix"], method: "starts_with", returns: bool_type),
  "replace": derived_signature(names: ["s", "from", "to"], method: "replace", returns: string_type),
  "filesystem_read": BuiltinSignature { params: [BuiltinParam { name: "path", ty: NamedTemplate { name: "String" } }], returns: filesystem_read_result_type() },
