fn builtin_signature(name: String) -> BuiltinSignature? {
  map_get(builtin_function_registry, name)
}

fn infer_builtin_call_type(name: String) -> Node? {
  match builtin_signature(name: name) {
    Present { value: sig } => Present { value: sig.returns }
    Absent => Absent
  }
}

fn resolve_builtin_call_type(name: String) -> Node {
  match infer_builtin_call_type(name: name) {
    Present { value: v } => v
    Absent => unit_type
  }
}
