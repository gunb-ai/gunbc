module v1.compiler.resolve

import std.types { kernel_type_set }
import v1.std.core { Node, Connective, Conj, Disj, NoConnective, ErrorNode, make_error_node, UnresolvedImport, MissingExport, DuplicateModule, CircularDependency, no_span, module_node, import_node, import_is_all, import_specific_names_at, module_imports, module_items, NewlineIndex, authored_name_at }

type ModuleGraph {
  modules: List<ResolvedModule>
  batches: List<List<ResolvedModule>>
  diagnostics: List<ErrorNode>
}

type ResolvedModule {
  module: Node
  resolved_imports: List<ResolvedImport>
  dep_order: Int
}

type ResolvedImport {
  module_path: String
  is_all: Bool
  specific_names: List<String>
  target_module: Node?
}

type DepEdge {
  from_module: String
  to_module: String
}

type ResolveAccum {
  imports_by_name: Map<String, List<ResolvedImport>>
  diagnostics: List<ErrorNode>
}

fn map_has(m: Map<String, Bool>, key: String) -> Bool {
  match map_get(m, key) {
    Present { value: _ } => true
    Absent => false
  }
}

fn resolve_modules(modules: List<Node>, source_indices: Map<String, NewlineIndex>) -> ModuleGraph {

  let dup_diags = check_duplicate_modules(modules: modules, source_indices: source_indices)

  let module_index = modules |> fold(init: empty_map(), f: (acc, m) =>
    map_insert(acc, authored_name_at(source_indices: source_indices, node: m), m)
  )

  let export_sets = modules |> fold(init: empty_map(), f: (acc, m) =>
    let exported = get_exported_names(module: m, source_indices: source_indices)
    let exported_set = fold(exported, init: empty_map(), f: (inner_acc, name) => map_insert(inner_acc, name, true))
    map_insert(acc, authored_name_at(source_indices: source_indices, node: m), exported_set)
  )

  let resolve_accum = modules |> fold(init: ResolveAccum {
    imports_by_name: empty_map(),
    diagnostics: []
  }, f: (acc, m) =>
    let result = resolve_module_imports(module: m, module_index: module_index, export_sets: export_sets, source_indices: source_indices)
    ResolveAccum {
      imports_by_name: map_insert(acc.imports_by_name, authored_name_at(source_indices: source_indices, node: m), result.resolved_imports),
      diagnostics: concat(acc.diagnostics, result.diagnostics)
    }
  )
  let imports_by_name = resolve_accum.imports_by_name
  let import_diags = resolve_accum.diagnostics

  let topo_result = topological_sort(modules: modules, source_indices: source_indices)
  let topo_diags = match topo_result.cycle_error {
    Present { value: diag } => [diag]
    Absent => []
  }

  let sorted_names = topo_result.sorted
  let sorted_order_map = sorted_names |> enumerate |> fold(init: empty_map(), f: (acc, pair) =>
    map_insert(acc, pair.second, pair.first)
  )
  let acyclic_resolved = modules |> flat_map(m =>
    match map_get(sorted_order_map, authored_name_at(source_indices: source_indices, node: m)) {
      Present { value: order } =>
        match map_get(imports_by_name, authored_name_at(source_indices: source_indices, node: m)) {
          Present { value: imps } =>
            [ResolvedModule {
              module: m,
              resolved_imports: imps,
              dep_order: order
            }]
          Absent => []
        }
      Absent => []
    }
  )

  let sorted_resolved = acyclic_resolved |> sort_by(m => m.dep_order)

  let resolved_by_name = sorted_resolved |> fold(init: empty_map(), f: (acc, rm) =>
    map_insert(acc, authored_name_at(source_indices: source_indices, node: rm.module), rm)
  )
  let batches = topo_result.waves |> map(wave =>
    wave |> flat_map(name =>
      match map_get(resolved_by_name, name) {
        Present { value: rm } => [rm]
        Absent => []
      }
    )
  )

  ModuleGraph {
    modules: sorted_resolved,
    batches: batches,
    diagnostics: concat(dup_diags, import_diags, topo_diags)
  }
}

fn find_module(module_index: Map<String, Node>, path: String) -> Node? {
  map_get(module_index, path)
}

type ModuleResolveResult {
  resolved_imports: List<ResolvedImport>
  diagnostics: List<ErrorNode>
}

fn resolve_module_imports(module: Node, module_index: Map<String, Node>, export_sets: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>) -> ModuleResolveResult {
  let results = module_imports(n: module) |> map(imp =>
    resolve_import(import: imp, module_index: module_index, importing_module: authored_name_at(source_indices: source_indices, node: module), export_sets: export_sets, source_indices: source_indices)
  )
  let resolved = results
    |> filter(r => r.resolved.target_module != none && (r.diagnostics |> count == 0))
    |> map(r => r.resolved)
  let diags = results |> flat_map(r => r.diagnostics)
  ModuleResolveResult {
    resolved_imports: resolved,
    diagnostics: diags
  }
}

type ImportResolveResult {
  resolved: ResolvedImport
  diagnostics: List<ErrorNode>
}

fn resolve_import(
  import: Node,
  module_index: Map<String, Node>,
  importing_module: String,
  export_sets: Map<String, Map<String, Bool>>,
  source_indices: Map<String, NewlineIndex>
) -> ImportResolveResult {
  let import_path = authored_name_at(source_indices: source_indices, node: import)
  let target = find_module(module_index: module_index, path: import_path)
  match target {
    Absent => {
      let diag = make_error_node(diagnostic: UnresolvedImport { module_path: import_path, importing_module: importing_module, span: import.span }, module_name: importing_module)
      ImportResolveResult {
        resolved: ResolvedImport {
          module_path: import_path,
          is_all: import_is_all(n: import),
          specific_names: import_specific_names_at(n: import, source_indices: source_indices),
          target_module: Absent
        },
        diagnostics: [diag]
      }
    }
    Present { value: target_mod } => {
      let exported_set = match map_get(export_sets, import_path) {
        Present { value: set } => set
        Absent => empty_map()
      }
      let name_diags = if import_is_all(n: import) { [] } else {
        import.children
          |> filter(child => map_has(m: exported_set, key: authored_name_at(source_indices: source_indices, node: child)) == false)
          |> map(child =>
            make_error_node(diagnostic: MissingExport { name: authored_name_at(source_indices: source_indices, node: child), module_path: import_path, importing_module: importing_module, span: child.span }, module_name: importing_module)
          )
      }
      ImportResolveResult {
        resolved: ResolvedImport {
          module_path: import_path,
          is_all: import_is_all(n: import),
          specific_names: import_specific_names_at(n: import, source_indices: source_indices),
          target_module: Present { value: target_mod }
        },
        diagnostics: name_diags
      }
    }
  }
}

fn get_exported_names(module: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let item_names = module_items(n: module) |> map(item => get_item_name(item: item, source_indices: source_indices))
  let variant_names = module_items(n: module)
    |> flat_map(item => get_variant_names(item: item, source_indices: source_indices))
  let imported_names = module_imports(n: module)
    |> flat_map(imp => if import_is_all(n: imp) { [] } else { import_specific_names_at(n: imp, source_indices: source_indices) })
  concat(item_names, variant_names, imported_names, map_keys(kernel_type_set))
}

fn get_item_name(item: Node, source_indices: Map<String, NewlineIndex>) -> String {
  authored_name_at(source_indices: source_indices, node: item)
}

fn get_variant_names(item: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let is_coproduct = item.connective == Disj
  if is_coproduct { item.children |> map(c => authored_name_at(source_indices: source_indices, node: c)) }
  else { [] }
}

type DuplicateCheckState {
  seen_names: Map<String, Bool>
  diagnostics: List<ErrorNode>
}

fn check_duplicate_modules(modules: List<Node>, source_indices: Map<String, NewlineIndex>) -> List<ErrorNode> {
  let result = modules |> fold(init: DuplicateCheckState {
    seen_names: empty_map(),
    diagnostics: []
  }, f: fn(state, m) {
    let m_name = authored_name_at(source_indices: source_indices, node: m)
    let is_dup = map_has(m: state.seen_names, key: m_name)
    if is_dup {
      DuplicateCheckState {
        seen_names: state.seen_names,
        diagnostics: concat(state.diagnostics, [make_error_node(diagnostic: DuplicateModule { name: m_name, span: m.span }, module_name: m_name)])
      }
    } else {
      DuplicateCheckState {
        seen_names: map_insert(state.seen_names, m_name, true),
        diagnostics: state.diagnostics
      }
    }
  })
  result.diagnostics
}

type TopoResult {
  sorted: List<String>
  waves: List<List<String>>
  cycle_error: ErrorNode?
}

fn adjacency_add_edge(adjacency: Map<String, List<String>>, from_module: String, to_module: String) -> Map<String, List<String>> {
  let existing = match map_get(adjacency, from_module) {
    Present { value: lst } => lst
    Absent => []
  }
  map_insert(adjacency, from_module, list_push(existing, to_module))
}

fn topo_sort_key(name: String) -> String {

  if name == "std.types" { "" } else { name }
}

fn topological_sort(modules: List<Node>, source_indices: Map<String, NewlineIndex>) -> TopoResult {
  let module_names = modules |> map(m => authored_name_at(source_indices: source_indices, node: m))

  let module_name_set = module_names |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, true)
  )

  let explicit_edges = modules |> flat_map(m =>
    module_imports(n: m)
      |> filter(imp => map_has(m: module_name_set, key: authored_name_at(source_indices: source_indices, node: imp)))
      |> map(imp => DepEdge { from_module: authored_name_at(source_indices: source_indices, node: imp), to_module: authored_name_at(source_indices: source_indices, node: m) })
  )

  let adjacency = explicit_edges |> fold(init: empty_map(), f: (acc, edge) =>
    adjacency_add_edge(adjacency: acc, from_module: edge.from_module, to_module: edge.to_module)
  )

  let in_degree_map = modules |> fold(init: empty_map(), f: (acc, m) =>
    let m_name = authored_name_at(source_indices: source_indices, node: m)
    map_insert(acc, m_name, module_imports(n: m)
      |> filter(imp => map_has(m: module_name_set, key: authored_name_at(source_indices: source_indices, node: imp)))
      |> count)
  )

  let initial_queue = module_names
    |> filter(name => match map_get(in_degree_map, name) {
      Present { value: 0 } => true
      _ => false
    })
    |> sort_by(name => topo_sort_key(name: name))
  let module_count = modules |> count

  let result = kahn_drain(
    queue: initial_queue,
    sorted: [],
    waves: [],
    in_degree_map: in_degree_map,
    adjacency: adjacency,
    fuel: module_count
  )

  if result.sorted |> count == module_count {
    TopoResult { sorted: result.sorted, waves: result.waves, cycle_error: Absent }
  } else {
    let sorted_set = result.sorted |> fold(init: empty_map(), f: (acc, name) =>
      map_insert(acc, name, true)
    )
    let cycle_members = module_names
      |> filter(name => map_has(m: sorted_set, key: name) == false)
    let cycle_desc = cycle_members |> join(separator: " -> ")
    TopoResult {
      sorted: result.sorted,
      waves: result.waves,
      cycle_error: Present { value: make_error_node(diagnostic: CircularDependency { modules: cycle_members, span: no_span() }, module_name: "") }
    }
  }
}

type KahnDrainState {
  sorted: List<String>
  waves: List<List<String>>
  in_degree_map: Map<String, Int>
}

fn kahn_drain(queue: List<String>, sorted: List<String>, waves: List<List<String>>, in_degree_map: Map<String, Int>, adjacency: Map<String, List<String>>, fuel: Int) -> KahnDrainState {
  if queue |> count == 0 {
    return KahnDrainState { sorted: sorted, waves: waves, in_degree_map: in_degree_map }
  }

  let batch_result = queue |> fold(init: KahnDrainState { sorted: sorted, waves: waves, in_degree_map: in_degree_map }, f: fn(state, node) {
    let new_sorted = list_push(state.sorted, node)
    let neighbors = match map_get(adjacency, node) {
      Present { value: ns } => ns
      Absent => []
    }
    let new_degrees = neighbors |> fold(init: state.in_degree_map, f: fn(deg_map, neighbor) {
      let current = match map_get(deg_map, neighbor) {
        Present { value: d } => d
        Absent => 0
      }
      map_insert(deg_map, neighbor, current - 1)
    })
    KahnDrainState { sorted: new_sorted, waves: state.waves, in_degree_map: new_degrees }
  })

  let new_zero_set = queue |> flat_map(node =>
    match map_get(adjacency, node) {
      Present { value: ns } => ns
      Absent => []
    }
  ) |> filter(neighbor =>
    match map_get(batch_result.in_degree_map, neighbor) {
      Present { value: 0 } => true
      _ => false
    }
  ) |> fold(init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
  let new_zero = map_keys(new_zero_set) |> sort_by(name => name)

  kahn_drain(
    queue: new_zero,
    sorted: batch_result.sorted,
    waves: list_push(waves, queue),
    in_degree_map: batch_result.in_degree_map,
    adjacency: adjacency,
    fuel: fuel - 1
  )
}
