type SourceFile {
  path: String
  content: String
}

// THIS MODULE IS THE COMPILER PIPELINE ENTRY, AND IT SAYS SO RATHER THAN BEING RECOGNISED BY
// NAME. The emitter used to select its entry-point arm by comparing a module name against the
// literal "v1.compiler.compile"; that literal discriminated seed generations rather than the
// role, so it could never be true of a self-emitted compiler. The driver shape is declared
// beside the role because it is a separate fact: this crate carries the retained host CLI
// kernel (v1_compiler.cli_run), and only a crate that contains it may render that driver.

data compiler_pipeline_entry: CompilerEntryDriver = RetainedHostCliKernel


type PipelineResult {
  files: List<TextFile>
  diagnostics: List<ErrorNode>
  complexity: ComplexityReport
  ownership: List<OwnershipProof>
  artifact_plan: ArtifactPlan
  newline_indices: List<NewlineIndex>
}

// The authored source annotation graph rides beside the semantic result rather than inside it.
// Every existing consumer reads the fields it already read and is unaffected; annotation-aware
// machinery reads the graph. Refusals are carried too, because a graph without them cannot
// distinguish prose that was never written from prose that was dropped.

type FrontendResult {
  graph: ModuleGraph?
  diagnostics: List<ErrorNode>
  newline_indices: List<NewlineIndex>
  intern_table: InternTable
  occurrence_transport: OccurrenceTransport
  annotations: SourceAnnotationGraph
}

type FrontendOccurrenceResolution {
  graph: ModuleGraph?
  diagnostics: List<ErrorNode>
}

type FrontendAccum {
  parse_results: List<ParseResult>
  module_inputs: List<ModuleOccurrenceInput>
  newline_indices: List<NewlineIndex>
  intern_table: InternTable
  occurrence_allocator: OccurrenceIdAllocator
  annotations: SourceAnnotationGraph
  annotation_diagnostics: List<ErrorNode>
}

data frontend_prepared_authored_note: String = "Carries the AUTHORED lexical result, not only the semantic tokens. `tokens` is what pre-interning and parsing consume, unchanged; `annotations` is what the annotation channel captured on the same pass, and `source_length` is what the binder needs to bound the last module item's extent.

Threading the captures through this record rather than re-tokenizing later is what keeps the two halves of one lexical pass from drifting: a second pass could observe a different source, and placement in particular is unrecoverable once whitespace is gone."

type FrontendPrepared {
  tokens: List<Token>
  annotations: List<UnboundAnnotationCapture>
  source_length: Int
  newline_index: NewlineIndex
}

fn merge_occurrence_transports(
  transports: List<OccurrenceTransport>
) -> OccurrenceTransport {
  OccurrenceTransport {
    index: OccurrenceIndex {
      entries: transports |> flat_map(transport => transport.index.entries),
    },
    declarations: transports |> flat_map(transport => transport.declarations),
    references: transports |> flat_map(transport => transport.references),
  }
}

fn extract_func_entries(typed: ResolvedGraph) -> List<FuncEntry> {
  typed.modules
    |> filter(m => m.items |> any(item => item.body != Absent))
    |> flat_map(m =>
      m.items |> filter(item => item.body != Absent) |> map(item =>
        FuncEntry {
          name: authored_name_at(source_indices: m.type_env.source_indices, node: item),
          body: item.body.value,
          params: item.params,
          span: item.span,
          is_tail_recursive: item.is_self_recursive && item.has_non_tail_self_call == false
        }
      )
    )
}

fn build_recursion_context(typed: ResolvedGraph) -> RecursionContext {
  RecursionContext {}
}

fn module_ownership_proofs(m: TypedModule) -> List<OwnershipProof> {
  m.items |> filter(item => item.body != Absent) |> map(item =>
    analyze_ownership(func_name: authored_name_at(source_indices: m.type_env.source_indices, node: item), params: item.params, body: item.body.value, si: m.type_env.source_indices)
  )
}

fn extract_ownership_proofs(typed: ResolvedGraph) -> List<OwnershipProof> {
  typed.modules
    |> filter(m => m.items |> any(item => item.body != Absent))
    |> flat_map(m => module_ownership_proofs(m: m))
}

fn ownership_diagnostics(proofs: List<OwnershipProof>) -> List<ErrorNode> {
  proofs |> flat_map(proof =>
    proof.decisions |> flat_map(decision =>
      match decision {
        SharedError { binding: binding, consumer_count: count, sites: sites } =>
          [make_error_node(diagnostic: OwnershipViolation { binding: binding, fn_name: proof.func_name, consumers: count, span: no_span() }, module_name: proof.func_name)]
        _ => []
      }
    )
  )
}

type CompilePipelineOptions {
  analyze_complexity: Bool,
  census_only_sources: List<SourceFile>
}

// Sources included in the NAME CENSUS but not compiled (fill = whole tree; policy gates lookup,
// never fill — namespace-resolution-design.md 7.5). Qualified references to modules outside the
// compile closure resolve against these; compiling them here instead would subject them to this
// invocation's pool-precedence tree view, where cross-tree bare names break (measured: 344
// diagnostics, the Empty/Cons poisoning class).

// TEST CODE IS ENTERED ONLY BY THE WITNESS RUNNER. A `test` marker (v1.std.core DeclarationMarker)
// segregates test code from serving code, and three references cross that segregation:
//   - a call whose resolved target is a TestMarked declaration, from anywhere, including another
//     test in its module: a test that calls a test re-runs a claim already enrolled on its own, so
//     its cost and verdict are duplicated work (DESIGN section 2) and it tests more than one
//     interface (section 3, a witness discriminates at one interface);
//   - a TestMarked declaration used as a function VALUE, or named in an import, which is how a
//     test reaches a caller without a call site: a value bound here and applied through a local
//     binding (LocallyBoundCall) is decided where the value is taken, not where it is applied;
//   - an import, by a module that declares no test, of a module that does: serving code
//     depending on test code.
// Both are decided here from the typed graph and the parsed marker, once per compile.
//
// THE LEDGER IS A RATCHET AT IDENTITY GRAIN. The references that existed when this wall landed
// are admitted per (module, referrer, target) with an exact count -- the count is only how many
// times one referrer names one target -- so a new target under an old referrer has no row and
// refuses, and a row whose observed count differs in either direction refuses too. The ceiling
// row is gunbc.compile_clean_diagnostic_policy advisory_class_ceilings TestCodeReferenceAdmitted,
// and every row carries the dissolution that ends it.

type TestReferenceOccurrence {
  module_name: String
  referrer: String
  target: String
  span: SourceSpan
}

type TestReferenceDebtRow {
  module_name: String
  referrer: String
  target: String
  occurrences: Int
  dissolution: DissolutionCondition
}

fn test_reference_debt_dissolution() -> DissolutionCondition {
  unbound_dissolution(description: "the reference is removed: a roll-up test that only re-asserts enrolled tests is deleted, or the shared logic moves into an ordinary fn that both callers use; the row is then deleted, which the equality budget forces" as NonEmptyStr)
}

fn test_reference_row(module_name: String, referrer: String, target: String, occurrences: Int) -> TestReferenceDebtRow {
  TestReferenceDebtRow { module_name: module_name, referrer: referrer, target: target, occurrences: occurrences, dissolution: test_reference_debt_dissolution() }
}

