fn test_reference_import_referrer() -> String {
  "<import>"
}

fn test_marked_declaration_keys(typed: ResolvedGraph, source_indices: Map<String, NewlineIndex>) -> Map<String, Bool> {
  typed.modules |> fold(init: empty_map(), f: (acc, m) =>
    m.items
      |> filter(item => item.declaration_marker == TestMarked)
      |> fold(init: acc, f: (inner, item) =>
        map_insert(inner, concat(authored_name_at(source_indices: source_indices, node: m.module), ".", authored_name_at(source_indices: source_indices, node: item)), true)
      )
  )
}

fn module_declares_tests(m: TypedModule) -> Bool {
  m.items |> any(item => item.declaration_marker == TestMarked)
}

fn call_semantics_source_target(semantics: CallSemantics?) -> String? {
  match semantics {
    Present { value: s } =>
      match s {
        PlainCallSemantics { target: t } => call_target_declaration_key(target: t)
        ResolvedDirectCallSemantics { target: t, application_plan: _ } => call_target_declaration_key(target: t)
        LookupCallSemantics { target: t } => call_target_declaration_key(target: t)
        FunctionValueCallSemantics => none
      }
    Absent => none
  }
}

fn call_target_declaration_key(target: CallTargetIdentity) -> String? {
  match target {
    SourceDeclarationCall { owner_module_path: owner, decl_name: decl } => Present { value: concat(owner, ".", decl) }
    RuntimePrimitiveCall { primitive_name: _, projected_from: _ } => none
    LocallyBoundCall { name: _ } => none
    CallableTargetUndetermined => none
  }
}

// The declaration key a bare function-value name denotes in this module: its own declaration, or
// the member of the module it was imported from. A local binding of the same spelling is not a
// FunctionValueBinding, so it never reaches this lookup.
fn visible_declaration_keys(m: TypedModule, module_name: String, source_indices: Map<String, NewlineIndex>) -> Map<String, String> {
  let own = m.items |> fold(init: empty_map(), f: (acc, item) =>
    map_insert(acc, authored_name_at(source_indices: source_indices, node: item), concat(module_name, ".", authored_name_at(source_indices: source_indices, node: item)))
  )
  module_imports(n: m.module) |> fold(init: own, f: (acc, imp) =>
    import_specific_names_at(n: imp, source_indices: source_indices) |> fold(init: acc, f: (inner, name) =>
      map_insert(inner, name, concat(authored_name_at(source_indices: source_indices, node: imp), ".", name))
    )
  )
}

fn function_value_target(texpr: Node, visible: Map<String, String>, source_indices: Map<String, NewlineIndex>) -> String? {
  match texpr.expr_data {
    ExprVar { binding_kind: bk } =>
      match bk {
        Present { value: kind } =>
          match kind {
            FunctionValueBinding => map_get(visible, authored_name_at(source_indices: source_indices, node: texpr))
            LocalValueBinding => none
            VariantValueBinding { parent_enum: _ } => none
            MatchBoundBinding => none
            ServiceValueBinding => none
          }
        Absent => none
      }
    ExprCall { call_semantics: cs, descent_evidence: _ } => call_semantics_source_target(semantics: cs)
    _ => none
  }
}

fn test_references_in_expr(module_name: String, referrer: String, texpr: Node, test_keys: Map<String, Bool>, visible: Map<String, String>, source_indices: Map<String, NewlineIndex>) -> List<TestReferenceOccurrence> {
  let here = match function_value_target(texpr: texpr, visible: visible, source_indices: source_indices) {
    Present { value: key } =>
      if map_contains_key(test_keys, key) { [TestReferenceOccurrence { module_name: module_name, referrer: referrer, target: key, span: texpr.span }] } else { [] }
    Absent => []
  }
  concat(here, texpr.children |> flat_map(child => test_references_in_expr(module_name: module_name, referrer: referrer, texpr: child, test_keys: test_keys, visible: visible, source_indices: source_indices)))
}

fn module_test_references(m: TypedModule, test_modules: Map<String, Bool>, test_keys: Map<String, Bool>, source_indices: Map<String, NewlineIndex>) -> List<TestReferenceOccurrence> {
  let module_name = authored_name_at(source_indices: source_indices, node: m.module)
  let visible = visible_declaration_keys(m: m, module_name: module_name, source_indices: source_indices)
  let body_refs = m.items |> flat_map(item =>
    match item.body {
      Present { value: body } => test_references_in_expr(module_name: module_name, referrer: authored_name_at(source_indices: source_indices, node: item), texpr: body, test_keys: test_keys, visible: visible, source_indices: source_indices)
      Absent => []
    }
  )
  let member_refs = module_imports(n: m.module) |> flat_map(imp =>
    import_specific_names_at(n: imp, source_indices: source_indices)
      |> map(name => concat(authored_name_at(source_indices: source_indices, node: imp), ".", name))
      |> filter(key => map_contains_key(test_keys, key))
      |> map(key => TestReferenceOccurrence { module_name: module_name, referrer: test_reference_import_referrer(), target: key, span: imp.span })
  )
  let module_refs = if map_contains_key(test_modules, module_name) { [] } else {
    module_imports(n: m.module)
      |> filter(imp => map_contains_key(test_modules, authored_name_at(source_indices: source_indices, node: imp)))
      |> map(imp => TestReferenceOccurrence { module_name: module_name, referrer: test_reference_import_referrer(), target: authored_name_at(source_indices: source_indices, node: imp), span: imp.span })
  }
  concat(body_refs, member_refs, module_refs)
}

fn test_reference_row_matches(row: TestReferenceDebtRow, o: TestReferenceOccurrence) -> Bool {
  row.module_name == o.module_name && row.referrer == o.referrer && row.target == o.target
}

fn test_reference_occurrence_diag(o: TestReferenceOccurrence, debt: List<TestReferenceDebtRow>) -> ErrorNode {
  let referrer = concat(o.module_name, ".", o.referrer)
  if debt |> any(r => test_reference_row_matches(row: r, o: o)) {
    make_error_node(diagnostic: TestCodeReferenceAdmitted { referrer: referrer, target: o.target, span: o.span }, module_name: o.module_name)
  } else {
    make_error_node(diagnostic: TestCodeReferenced { referrer: referrer, target: o.target, span: o.span }, module_name: o.module_name)
  }
}

fn test_reference_budget_diags(row: TestReferenceDebtRow, occurrences: List<TestReferenceOccurrence>, module_span: SourceSpan) -> List<ErrorNode> {
  let observed = occurrences |> filter(o => test_reference_row_matches(row: row, o: o))
  if (observed |> count) == row.occurrences { [] } else {
    let span = match observed |> first {
      Present { value: o } => o.span
      Absent => module_span
    }
    [make_error_node(diagnostic: TestCodeReferenceBudgetMismatch { referrer: concat(row.module_name, ".", row.referrer, " -> ", row.target), declared: row.occurrences, observed: observed |> count, span: span }, module_name: row.module_name)]
  }
}

fn test_reference_diagnostics(typed: ResolvedGraph, source_indices: Map<String, NewlineIndex>) -> List<ErrorNode> {
  let test_keys = test_marked_declaration_keys(typed: typed, source_indices: source_indices)
  let test_modules = typed.modules
    |> filter(m => module_declares_tests(m: m))
    |> fold(init: empty_map(), f: (acc, m) => map_insert(acc, authored_name_at(source_indices: source_indices, node: m.module), true))
  let occurrences = typed.modules |> flat_map(m => module_test_references(m: m, test_modules: test_modules, test_keys: test_keys, source_indices: source_indices))
  let debt = test_reference_debt()
  let occurrence_diags = occurrences |> map(o => test_reference_occurrence_diag(o: o, debt: debt))
  let budget_diags = typed.modules |> flat_map(m =>
    debt
      |> filter(r => r.module_name == authored_name_at(source_indices: source_indices, node: m.module))
      |> flat_map(r => test_reference_budget_diags(row: r, occurrences: occurrences, module_span: m.module.span))
  )
  concat(occurrence_diags, budget_diags)
}

fn default_compile_pipeline_options() -> CompilePipelineOptions {
  CompilePipelineOptions { analyze_complexity: false, census_only_sources: [] }
}

fn run_complexity_analysis(typed: ResolvedGraph, source_indices: Map<String, NewlineIndex>) -> ComplexityReport {
  let func_entries = extract_func_entries(typed: typed)
  let recursion_ctx = build_recursion_context(typed: typed)
  build_complexity_report(func_entries: func_entries, recursion_ctx: recursion_ctx, source_indices: source_indices)
}

fn complexity_diagnostics(complexity: ComplexityReport) -> List<ErrorNode> {
  complexity.violations |> map(v =>
    make_error_node(diagnostic: ComplexityUnknown { func_name: v.func_name, reason: v.reason, span: v.span }, module_name: v.func_name)
  )
}

fn empty_artifact_plan() -> ArtifactPlan {
  ArtifactPlan { artifacts: [], boundaries: [] }
}

fn compile_bundle_error(message: String) -> ErrorNode {
  make_error_node(diagnostic: InternalError { message: message, span: no_span() }, module_name: "")
}

fn emit_artifact(typed: ResolvedGraph, artifact: Artifact) -> EmitResult {
  let unmodeled_transports = concat(
    unmodeled_file_transport_diagnostics(typed: typed, target: artifact.target),
    unmodeled_shell_transport_diagnostics(typed: typed, target: artifact.target))
  if unmodeled_transports |> count > 0 {
    return EmitResult { files: [], diagnostics: unmodeled_transports }
  }
  match artifact.target {
    Rust => emit_rust_selected(typed: typed, selection: artifact.module_selection)
    Python => emit_python(typed: typed)
    Go => emit_go(typed: typed)
    Dag => emit_dag_artifact(typed: typed)
  }
}

fn json_list(items: List<String>) -> String {
  concat("[", items |> join(separator: ", "), "]")
}

fn json_optional_string(value: String?) -> String {
  match value {
    Present { value: inner } => json_quote(s: inner)
    Absent => "null"
  }
}

fn dag_node_missing_ref_error(node: Node) -> ErrorNode {
  make_error_node(
    diagnostic: InternalError {
      message: concat("dag artifact: node missing from nodes table (key=", dag_node_key(node: node), ")"),
      span: node.span
    },
    module_name: ""
  )
}

fn dag_emit_check_ref_target(node: Node, key_to_id: Map<String, String>) -> List<ErrorNode> {
  match map_get(key_to_id, dag_node_key(node: node)) {
    Present { value: _ } => []
    Absent => [dag_node_missing_ref_error(node: node)]
  }
}

fn dag_emit_check_optional_ref_target(value: Node?, key_to_id: Map<String, String>) -> List<ErrorNode> {
  match value {
    Present { value: inner } => dag_emit_check_ref_target(node: inner, key_to_id: key_to_id)
    Absent => []
  }
}

fn dag_emit_check_inferred_ref_target(value: InferredNode?, key_to_id: Map<String, String>) -> List<ErrorNode> {
  match value {
    Present { value: Resolved { node: n } } => dag_emit_check_ref_target(node: n, key_to_id: key_to_id)
    _ => []
  }
}

fn dag_emit_check_node_refs(node: Node, key_to_id: Map<String, String>) -> List<ErrorNode> {
  concat(
    if is_import_statement_node(n: node) {
      []
    } else {
      node.children |> flat_map(c => dag_emit_check_ref_target(node: c, key_to_id: key_to_id))
    },
    if is_module_shell_node(n: node) {
      []
    } else {
      node.params |> flat_map(p => dag_emit_check_ref_target(node: p, key_to_id: key_to_id))
    },
    node.uses |> flat_map(u => dag_emit_check_ref_target(node: u, key_to_id: key_to_id)),
    dag_emit_check_optional_ref_target(value: node.body, key_to_id: key_to_id),
    dag_emit_check_optional_ref_target(value: node.transport, key_to_id: key_to_id),
    node.properties |> flat_map(p => dag_emit_check_ref_target(node: p, key_to_id: key_to_id)),
    dag_emit_check_optional_ref_target(value: node.type_annotation, key_to_id: key_to_id),
    concat(
      dag_emit_check_inferred_ref_target(value: node.inferred, key_to_id: key_to_id),
      match node.expr_data {
        ExprCall { call_semantics: call_semantics, descent_evidence: _ } => match call_semantics {
          Present { value: semantics } => match semantics {
            ResolvedDirectCallSemantics { target: _, application_plan: plan } =>
              plan |> flat_map(application => concat(
                dag_emit_check_ref_target(node: application.formal.declared_type, key_to_id: key_to_id),
                concat(
                  dag_emit_check_ref_target(node: application.formal.declaration_bound_conformance, key_to_id: key_to_id),
                  dag_emit_check_ref_target(node: application.formal.substitution_basis, key_to_id: key_to_id)
                )
              ))
            _ => []
          }
          Absent => []
        }
        _ => []
      }
    )
  )
}

fn dag_emit_ref_errors(order: List<Node>, key_to_id: Map<String, String>) -> List<ErrorNode> {
  order |> flat_map(n => dag_emit_check_node_refs(node: n, key_to_id: key_to_id))
}

fn build_dag_key_to_id(order: List<Node>) -> Map<String, String> {
  order |> enumerate |> fold(init: empty_map(), f: (acc, pair) =>
    map_insert(acc, dag_node_key(node: pair.second), concat("n", to_string(value: pair.first)))
  )
}

fn dag_graph_source_indices(typed: ResolvedGraph) -> Map<String, NewlineIndex> {
  typed.modules |> fold(init: empty_map(), f: (acc, m) => map_merge(acc, m.type_env.source_indices))
}

fn serialize_node_ref(node: Node, key_to_id: Map<String, String>) -> String {
  match map_get(key_to_id, dag_node_key(node: node)) {
    Present { value: id } => concat("{\"$ref\": ", json_quote(s: id), "}")
    Absent => "{\"$ref\": null}"
  }
}

fn json_optional_node_ref(value: Node?, key_to_id: Map<String, String>) -> String {
  match value {
    Present { value: inner } => serialize_node_ref(node: inner, key_to_id: key_to_id)
    Absent => "null"
  }
}

fn json_optional_inferred_node_ref(value: InferredNode?, key_to_id: Map<String, String>) -> String {
  match value {
    Present { value: inner } => serialize_inferred_node_ref(inferred: inner, key_to_id: key_to_id)
    Absent => "null"
  }
}

fn json_optional_span(value: SourceSpan?) -> String {
  match value {
    Present { value: inner } => serialize_span(span: inner)
    Absent => "null"
  }
}

fn json_bool(value: Bool) -> String {
  if value { "true" } else { "false" }
}

fn cardinality_name(value: Cardinality) -> String {
  match value {
    Required => "Required"
    CardOptional => "CardOptional"
  }
}

fn field_access_style_name(value: FieldAccessStyle) -> String {
  match value {
    StoredField => "StoredField"
    EnumAccessor => "EnumAccessor"
    OptionalUnwrap => "OptionalUnwrap"
    TupleFirst => "TupleFirst"
    TupleSecond => "TupleSecond"
  }
}

fn field_value_shape_name(value: FieldValueShape) -> String {
  match value {
    PlainValue => "PlainValue"
    OptionalValue => "OptionalValue"
  }
}

fn var_binding_kind_name(value: VarBindingKind) -> String {
  match value {
    LocalValueBinding => "LocalValueBinding"
    FunctionValueBinding => "FunctionValueBinding"
    VariantValueBinding { parent_enum: _ } => "VariantValueBinding"
    MatchBoundBinding => "MatchBoundBinding"
    ServiceValueBinding => "ServiceValueBinding"
  }
}

fn serialize_call_target_identity(value: CallTargetIdentity) -> String {
  match value {
    RuntimePrimitiveCall { primitive_name: primitive_name, projected_from: _ } =>
      concat("{\"kind\": \"RuntimePrimitiveCall\", \"primitive_name\": ", json_quote(s: primitive_name), "}")
    SourceDeclarationCall { owner_module_path: owner, decl_name: decl } =>
      concat("{\"kind\": \"SourceDeclarationCall\", \"owner_module_path\": ", json_quote(s: owner), ", \"decl_name\": ", json_quote(s: decl), "}")
    LocallyBoundCall { name: _ } => "{\"kind\": \"LocallyBoundCall\"}"
    CallableTargetUndetermined => "{\"kind\": \"CallableTargetUndetermined\"}"
  }
}

fn expr_error_kind_name(value: ExprErrorKind) -> String {
  match value {
    ParseRecoveryError => "ParseRecoveryError"
    SemanticExprError => "SemanticExprError"
    InternalExprError => "InternalExprError"
    CensusHeadsBodyStripped => "CensusHeadsBodyStripped"
  }
}

fn bin_op_name(value: BinOp) -> String {
  match value {
    Add => "Add"
    Sub => "Sub"
    Mul => "Mul"
    Div => "Div"
    Mod => "Mod"
    Eq => "Eq"
    Ne => "Ne"
    Lt => "Lt"
    Gt => "Gt"
    Le => "Le"
    Ge => "Ge"
    And => "And"
    Or => "Or"
    NullCoalesce => "NullCoalesce"
  }
}

fn unary_op_name(value: UnaryOpKind) -> String {
  match value {
    Not => "Not"
    Neg => "Neg"
  }
}

fn serialize_span(span: SourceSpan) -> String {
  concat("{\"start\": ", to_string(value: span.start), ", \"end\": ", to_string(value: span.end), "}")
}

fn serialize_import_node(imp: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let names_json = if import_is_all(n: imp) {
    "{\"kind\": \"ImportAll\"}"
  } else {
    concat(
      "{\"kind\": \"ImportSpecific\", \"names\": ",
      json_list(items: import_specific_names_at(n: imp, source_indices: source_indices) |> map(v => json_quote(s: v))),
      "}")
  }
  concat(
    "{\"module_path\": ", json_quote(s: authored_name_at(source_indices: source_indices, node: imp)),
    ", \"names\": ", names_json,
    ", \"span\": ", serialize_span(span: imp.span),
    "}")
}

fn serialize_field_summary(summary: FieldSummary) -> String {
  concat(
    "{\"access_style\": ", json_quote(s: field_access_style_name(value: summary.access_style)),
    ", \"value_shape\": ", json_quote(s: field_value_shape_name(value: summary.value_shape)),
    "}")
}

fn serialize_literal(value: LiteralValue) -> String {
  match value {
    LitStr { value: inner } =>
      concat("{\"kind\": \"LitStr\", \"value\": ", json_quote(s: inner), "}")
    LitInt { value: inner } =>
      concat("{\"kind\": \"LitInt\", \"value\": ", to_string(value: inner), "}")
    LitFloat { value: inner } =>
      concat("{\"kind\": \"LitFloat\", \"value\": ", json_quote(s: inner), "}")
    LitBool { value: inner } =>
      concat("{\"kind\": \"LitBool\", \"value\": ", json_bool(value: inner), "}")
    LitNull => "{\"kind\": \"LitNull\"}"
    LitSymbol { value: inner } =>
      concat("{\"kind\": \"LitSymbol\", \"value\": ", json_quote(s: inner), "}")
  }
}

fn serialize_field_binding(binding: Node, source_indices: Map<String, NewlineIndex>) -> String {
  concat(
    "{\"field_name\": ", json_quote(s: field_binding_name_at(n: binding, source_indices: source_indices)),
    ", \"binding\": ", serialize_match_pattern(pattern: field_binding_pattern(n: binding), source_indices: source_indices),
    "}")
}

fn serialize_match_pattern(pattern: MatchPattern, source_indices: Map<String, NewlineIndex>) -> String {
  match pattern {
    Bind { declaration: declaration } =>
      concat("{\"kind\": \"Bind\", \"name\": ", json_quote(s: declaration.name), "}")
    LitPattern { value: inner } =>
      concat("{\"kind\": \"LitPattern\", \"value\": ", serialize_literal(value: inner), "}")
    VariantPattern { name: inner, parent_enum: parent_enum, field_bindings: field_bindings } =>
      concat(
        "{\"kind\": \"VariantPattern\", \"name\": ", json_quote(s: inner),
        ", \"parent_enum\": ", json_optional_string(value: parent_enum),
        ", \"field_bindings\": ", json_list(items: field_bindings |> map(fb => serialize_field_binding(binding: fb, source_indices: source_indices))),
        "}")
    Wildcard => "{\"kind\": \"Wildcard\"}"
  }
}

fn serialize_named_arg(arg: Node, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  concat(
    "{\"name\": ", json_optional_string(value: arg_name_at(n: arg, source_indices: source_indices)),
    ", \"value\": ", serialize_node_ref(node: arg_value(n: arg), key_to_id: key_to_id),
    "}")
}

fn serialize_match_arm(arm: Node, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  concat(
    "{\"pattern\": ", serialize_match_pattern(pattern: arm_pattern(n: arm), source_indices: source_indices),
    ", \"guard\": ", json_optional_node_ref(value: arm_guard(n: arm), key_to_id: key_to_id),
    ", \"body\": ", serialize_node_ref(node: arm_body(n: arm), key_to_id: key_to_id),
    "}")
}

fn serialize_field_init(field_init: Node, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  concat(
    "{\"name\": ", json_quote(s: field_init_node_name_at(n: field_init, source_indices: source_indices)),
    ", \"value\": ", serialize_node_ref(node: field_init_node_value(n: field_init), key_to_id: key_to_id),
    "}")
}

fn serialize_string_part(part: StringPart, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  match part {
    Text { value: inner } =>
      concat("{\"kind\": \"Text\", \"value\": ", json_quote(s: inner), "}")
    Interpolation { expr: inner } =>
      concat("{\"kind\": \"Interpolation\", \"expr\": ", serialize_node_ref(node: inner, key_to_id: key_to_id), "}")
  }
}

fn serialize_resolved_call_formal(value: ResolvedCallFormal, key_to_id: Map<String, String>) -> String {
  concat(
    "{\"formal_index\": ", to_string(value: value.formal_index),
    ", \"parameter_identity\": ", json_quote(s: value.formal.parameter_identity),
    ", \"declared_type\": ", serialize_node_ref(node: value.formal.declared_type, key_to_id: key_to_id),
    ", \"declaration_bound_conformance\": ", serialize_node_ref(node: value.formal.declaration_bound_conformance, key_to_id: key_to_id),
    ", \"substitution_basis\": ", serialize_node_ref(node: value.formal.substitution_basis, key_to_id: key_to_id),
    ", \"matched_argument_index\": ", match value.matched_argument_index {
      Present { value: index } => to_string(value: index)
      Absent => "null"
    },
    "}"
  )
}

fn serialize_call_semantics(value: CallSemantics?, key_to_id: Map<String, String>) -> String {
  match value {
    Present { value: PlainCallSemantics { target: target } } =>
      concat("{\"kind\": \"PlainCallSemantics\", \"target\": ", serialize_call_target_identity(value: target), "}")
    Present { value: ResolvedDirectCallSemantics { target: target, application_plan: plan } } =>
      concat("{\"kind\": \"ResolvedDirectCallSemantics\", \"target\": ", serialize_call_target_identity(value: target), ", \"application_plan\": ", json_list(items: plan |> map(formal => serialize_resolved_call_formal(value: formal, key_to_id: key_to_id))), "}")
    Present { value: LookupCallSemantics { target: target } } =>
      concat("{\"kind\": \"LookupCallSemantics\", \"target\": ", serialize_call_target_identity(value: target), "}")
    Present { value: FunctionValueCallSemantics } =>
      "{\"kind\": \"FunctionValueCallSemantics\"}"
    Absent => "null"
  }
}

fn serialize_method_semantics(value: MethodSemantics?, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  match value {
    Present { value: PlainMethodSemantics } =>
      "{\"kind\": \"PlainMethodSemantics\"}"
    Present { value: AlgebraMethodSemantics { method_def: method_def, fold_accumulator_type: fold_accumulator_type, size_effect: _, cost_shape: _, algebra_template: _ } } =>
      let mn = authored_name_at(source_indices: source_indices, node: method_def)
      concat(
        "{\"kind\": \"AlgebraMethodSemantics\", \"method_name\": ",
        json_quote(s: mn),
        ", \"fold_accumulator_type\": ",
        json_optional_node_ref(value: fold_accumulator_type, key_to_id: key_to_id),
        "}")
    Present { value: ServiceMethodSemantics { service_name: service_name, op_params: op_params } } =>
      concat(
        "{\"kind\": \"ServiceMethodSemantics\", \"service_name\": ",
        json_quote(s: service_name),
        ", \"op_params\": ",
        json_list(items: op_params |> map(p => serialize_param(param: p, source_indices: source_indices, key_to_id: key_to_id))),
        "}")
    Absent => "null"
  }
}

fn serialize_recursion_shape(shape: RecursionShape) -> String {
  match shape {
    DirectRecursion => "{\"_variant\": \"DirectRecursion\"}"
    ListRecursion => "{\"_variant\": \"ListRecursion\"}"
    OptionalRecursion => "{\"_variant\": \"OptionalRecursion\"}"
    SetRecursion => "{\"_variant\": \"SetRecursion\"}"
    MapValueRecursion => "{\"_variant\": \"MapValueRecursion\"}"
  }
}

fn serialize_inductive_field(field: InductiveField) -> String {
  concat(
    "{\"type_name\": ", json_quote(s: field.type_name),
    ", \"variant_name\": ", json_quote(s: field.variant_name),
    ", \"field_name\": ", json_quote(s: field.field_name),
    ", \"shape\": ", serialize_recursion_shape(shape: field.shape),
    "}")
}

fn serialize_positive_descent_amount(steps: PositiveDescentAmount) -> String {
  match steps {
    OneStep => "{\"_variant\": \"OneStep\"}"
    AdditionalStep { previous: p } =>
      concat("{\"_variant\": \"AdditionalStep\", \"previous\": ", serialize_positive_descent_amount(steps: p), "}")
  }
}

fn serialize_proportional_divisor(d: ProportionalDivisor) -> String {
  match d {
    DivideByTwo => "{\"_variant\": \"DivideByTwo\"}"
    StrictlyLarger { inner: i } =>
      concat("{\"_variant\": \"StrictlyLarger\", \"inner\": ", serialize_proportional_divisor(d: i), "}")
  }
}

fn serialize_shrink_factor(factor: ShrinkFactor) -> String {
  match factor {
    UnitShrink => "{\"_variant\": \"UnitShrink\"}"
    ConstantShrink { steps: s } =>
      concat("{\"_variant\": \"ConstantShrink\", \"steps\": ", serialize_positive_descent_amount(steps: s), "}")
    ProportionalShrink { divisor: d } =>
      concat("{\"_variant\": \"ProportionalShrink\", \"divisor\": ", serialize_proportional_divisor(d: d), "}")
  }
}

fn serialize_sub_value_relation(rel: SubValueRelation) -> String {
  match rel {
    StrictSubValue { field: f, factor: fac } =>
      concat(
        "{\"_variant\": \"StrictSubValue\", \"field\": ", serialize_inductive_field(field: f),
        ", \"factor\": ", serialize_shrink_factor(factor: fac), "}")
    IteratedSubValue { field: f } =>
      concat("{\"_variant\": \"IteratedSubValue\", \"field\": ", serialize_inductive_field(field: f), "}")
    ArithmeticDescent { param: p, factor: fac } =>
      concat("{\"_variant\": \"ArithmeticDescent\", \"param\": ", json_quote(s: p), ", \"factor\": ", serialize_shrink_factor(factor: fac), "}")
    PreservedValue => "{\"_variant\": \"PreservedValue\"}"
    NonIncreasingValue => "{\"_variant\": \"NonIncreasingValue\"}"
    StrictAxisErased => "{\"_variant\": \"StrictAxisErased\"}"
    MixedTop => "{\"_variant\": \"MixedTop\"}"
    SubValueUnknown => "{\"_variant\": \"SubValueUnknown\"}"
  }
}

fn serialize_descent_evidence(de: List<SubValueRelation>?) -> String {
  match de {
    Present { value: evidence } => json_list(items: evidence |> map(rel => serialize_sub_value_relation(rel: rel)))
    Absent => "null"
  }
}

fn serialize_expr_data(expr_node: Node, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  let ch = expr_node.children
  let name = authored_name_at(source_indices: source_indices, node: expr_node)
  match expr_node.expr_data {
    NoExprData => "{\"kind\": \"NoExprData\"}"
    ExprLiteral { value: value } =>
      concat("{\"kind\": \"ExprLiteral\", \"value\": ", serialize_literal(value: value), "}")
    ExprElaboratedLiteral { value: value, elaboration: _ } =>
      concat("{\"kind\": \"ExprElaboratedLiteral\", \"value\": ", serialize_literal(value: value), "}")
    ExprError { kind: kind, message: message } =>
      concat(
        "{\"kind\": \"ExprError\", \"error_kind\": ", json_quote(s: expr_error_kind_name(value: kind)),
        ", \"message\": ", json_quote(s: message),
        "}")
    ExprVar { binding_kind: binding_kind } =>
      concat(
        "{\"kind\": \"ExprVar\", \"name\": ", json_quote(s: name),
        ", \"binding_kind\": ",
        match binding_kind {
          Present { value: inner } =>
            concat("{\"kind\": ", json_quote(s: var_binding_kind_name(value: inner)),
              match inner {
                VariantValueBinding { parent_enum: parent_enum } =>
                  concat(", \"parent_enum\": ", json_quote(s: parent_enum))
                _ => ""
              },
            "}")
          Absent => "null"
        },
        "}")
    ExprFieldAccess { summary: summary } =>
      let field = field_access_field_at(texpr: expr_node, source_indices: source_indices)
      concat(
        "{\"kind\": \"ExprFieldAccess\", \"field\": ", json_quote(s: field),
        ", \"summary\": ",
        match summary {
          Present { value: inner } => serialize_field_summary(summary: inner)
          Absent => "null"
        },
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprCall { call_semantics: call_semantics, descent_evidence: de } =>
      let func = expr_call_func_at(texpr: expr_node, source_indices: source_indices)
      concat(
        "{\"kind\": \"ExprCall\", \"func\": ", json_quote(s: func),
        ", \"call_semantics\": ", serialize_call_semantics(value: call_semantics, key_to_id: key_to_id),
        ", \"descent_evidence\": ", serialize_descent_evidence(de: de),
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprMethodCall { method_semantics: method_semantics } =>
      let method = expr_method_name_at(texpr: expr_node, source_indices: source_indices)
      concat(
        "{\"kind\": \"ExprMethodCall\", \"method\": ", json_quote(s: method),
        ", \"method_semantics\": ", serialize_method_semantics(value: method_semantics, source_indices: source_indices, key_to_id: key_to_id),
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprBinOp { op: op, algebra_field: af } =>
      concat(
        "{\"kind\": \"ExprBinOp\", \"op\": ", json_quote(s: bin_op_name(value: op)),
        ", \"algebra_field\": ", match af { Present { value: f } => json_quote(s: algebra_field_kind_name(kind: f))  Absent => "null" },
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprUnaryOp { op: op } =>
      concat(
        "{\"kind\": \"ExprUnaryOp\", \"op\": ", json_quote(s: unary_op_name(value: op)),
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprLambda =>
      let params = lambda_param_names_at(texpr: expr_node, source_indices: source_indices)
      concat(
        "{\"kind\": \"ExprLambda\", \"params\": ", json_list(items: params |> map(p => json_quote(s: p))),
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprLet =>
      concat(
        "{\"kind\": \"ExprLet\", \"name\": ", json_quote(s: name),
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprRecordLit { parent_enum: parent_enum } =>
      let type_name = record_lit_type_name_at(texpr: expr_node, source_indices: source_indices)
      concat(
        "{\"kind\": \"ExprRecordLit\", \"type_name\": ", json_optional_string(value: type_name),
        ", \"parent_enum\": ", json_optional_string(value: parent_enum),
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprForEach =>
      let variable = foreach_variable_at(texpr: expr_node, source_indices: source_indices)
      concat(
        "{\"kind\": \"ExprForEach\", \"variable\": ", json_quote(s: variable),
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprMatch =>
      concat(
        "{\"kind\": \"ExprMatch\"",
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprIf =>
      concat(
        "{\"kind\": \"ExprIf\"",
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprListLit =>
      concat(
        "{\"kind\": \"ExprListLit\"",
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprStringInterp =>
      concat(
        "{\"kind\": \"ExprStringInterp\"",
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprBlock =>
      concat(
        "{\"kind\": \"ExprBlock\"",
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprCast =>
      concat(
        "{\"kind\": \"ExprCast\"",
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprIndex =>
      concat(
        "{\"kind\": \"ExprIndex\"",
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprSlice =>
      concat(
        "{\"kind\": \"ExprSlice\"",
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
    ExprReturn =>
      concat(
        "{\"kind\": \"ExprReturn\"",
        ", \"children\": ", json_list(items: ch |> map(c => serialize_node_ref(node: c, key_to_id: key_to_id))),
        "}")
  }
}

fn serialize_inferred_node_ref(inferred: InferredNode, key_to_id: Map<String, String>) -> String {
  match inferred {
    Resolved { node: node } =>
      concat("{\"kind\": \"Resolved\", \"node\": ", serialize_node_ref(node: node, key_to_id: key_to_id), "}")
    CompilerError { message: message, span: span } =>
      concat(
        "{\"kind\": \"CompilerError\", \"message\": ", json_quote(s: message),
        ", \"span\": ", serialize_span(span: span),
        "}")
    Divergent =>
      "{\"kind\": \"Divergent\"}"
    TypeVariable { id: id } =>
      concat("{\"kind\": \"TypeVariable\", \"id\": ", json_quote(s: id), "}")
  }
}

fn serialize_resource_use(resource_use: Node, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  concat(
    "{\"name\": ", json_quote(s: resource_use_name_at(n: resource_use, source_indices: source_indices)),
    ", \"resource\": ", serialize_node_ref(node: resource_use_resource(n: resource_use), key_to_id: key_to_id),
    ", \"span\": ", serialize_span(span: resource_use.span),
    "}")
}

fn serialize_field(field: Node, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  concat(
    "{\"name\": ", json_quote(s: field_node_name_at(n: field, source_indices: source_indices)),
    ", \"type_expr\": ", serialize_node_ref(node: field_node_type_expr(n: field), key_to_id: key_to_id),
    ", \"cardinality\": ", json_quote(s: cardinality_name(value: field_node_cardinality(n: field))),
    ", \"default_value\": ", json_optional_node_ref(value: field_node_default_value(n: field), key_to_id: key_to_id),
    ", \"from_key\": ", json_optional_string(value: field_node_from_key(n: field, source_indices: source_indices)),
    ", \"span\": ", serialize_span(span: field_node_span(n: field)),
    "}")
}

fn serialize_param(param: Node, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  concat(
    "{\"name\": ", json_quote(s: param_node_name_at(n: param, source_indices: source_indices)),
    ", \"type_expr\": ", serialize_node_ref(node: param_node_type_expr(n: param), key_to_id: key_to_id),
    ", \"default_value\": ", json_optional_node_ref(value: param_node_default_value(n: param), key_to_id: key_to_id),
    ", \"span\": ", serialize_span(span: param_node_span(n: param)),
    "}")
}

fn is_import_statement_node(n: Node) -> Bool {
  import_is_all(n: n) || (
    (n.children |> count) > 0 && n.body == none && n.expr_data == NoExprData
      && (n.params |> count) == 0)
}

fn serialize_node_params_json(node: Node, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  if is_module_shell_node(n: node) {
    "[]"
  } else {
    json_list(items: node.params |> map(param => serialize_param(param: param, source_indices: source_indices, key_to_id: key_to_id)))
  }
}

fn serialize_module_imports_json(node: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let imports = module_imports(n: node)
  if imports |> count == 0 {
    "[]"
  } else if imports |> all(imp => imp.params |> count == 0) {
    json_list(items: imports |> map(imp => serialize_import_node(imp: imp, source_indices: source_indices)))
  } else {
    "[]"
  }
}

fn serialize_node_record(node: Node, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  concat(
    "{\"name\": ", json_quote(s: authored_name_at(source_indices: source_indices, node: node)),
    ", \"imports\": ", serialize_module_imports_json(node: node, source_indices: source_indices),
    ", \"span\": ", serialize_span(span: node.span),
    ", \"ident_span\": ", json_optional_span(value: node.ident_span),
    ", \"children\": ", json_list(items: node.children |> map(child => serialize_node_ref(node: child, key_to_id: key_to_id))),
    ", \"connective\": ",
    match node.connective {
      Conj => json_quote(s: connective_name(value: Conj))
      Disj => json_quote(s: connective_name(value: Disj))
      NoConnective => "null"
      Arrow => json_quote(s: connective_name(value: Arrow))
    },
    ", \"params\": ", serialize_node_params_json(node: node, source_indices: source_indices, key_to_id: key_to_id),
    ", \"inferred\": ", json_optional_inferred_node_ref(value: node.inferred, key_to_id: key_to_id),
    ", \"return_cardinality\": ", json_quote(s: cardinality_name(value: node.return_cardinality)),
    ", \"uses\": ", json_list(items: node.uses |> map(item => serialize_resource_use(resource_use: item, source_indices: source_indices, key_to_id: key_to_id))),
    ", \"body\": ", json_optional_node_ref(value: node.body, key_to_id: key_to_id),
    ", \"transport\": ", json_optional_node_ref(value: node.transport, key_to_id: key_to_id),
    ", \"properties\": ", json_list(items: node.properties |> map(prop => serialize_field_init(field_init: prop, source_indices: source_indices, key_to_id: key_to_id))),
    ", \"type_annotation\": ", json_optional_node_ref(value: node.type_annotation, key_to_id: key_to_id),
    ", \"is_self_recursive\": ", json_bool(value: node.is_self_recursive),
    ", \"has_non_tail_self_call\": ", json_bool(value: node.has_non_tail_self_call),
    ", \"expr_data\": ", serialize_expr_data(expr_node: node, source_indices: source_indices, key_to_id: key_to_id),
    "}")
}

// THE KEY LISTS ARE ORDERED AT THE KEY, WHICH IS WHY BOTH SITES READ `sorted_map_keys` AND
// NOTHING SORTS THE EMITTED TEXT. `item_registry` is a host-ordered map; feeding `map_keys` of it
// into the artifact made `dag-artifact.json` run-to-run unstable -- same graph, same `$ref`s, the
// same key SET in a different order on every run (measured on main, gunbc#11072). An artifact
// whose identity moves without its input moving makes every byte-equality oracle over it -- regen
// fixed points, drift observers, emitted-closure identity -- unable to tell changed from
// reordered. `sorted_map_keys` carries `CanonicalOrder` in `std.primitive_identity`; `map_keys`
// carries `HostUnspecifiedOrder`, and that fact is the choice between them at any site whose
// result reaches an emitted byte.
fn serialize_typed_module(module: TypedModule, key_to_id: Map<String, String>) -> String {
  concat(
    "{\"module\": ", serialize_node_ref(node: module.module, key_to_id: key_to_id),
    ", \"items\": ", json_list(items: module.items |> map(item => serialize_node_ref(node: item, key_to_id: key_to_id))),
    ", \"item_registry_keys\": ", json_list(items: sorted_map_keys(module.item_registry) |> map(k => json_quote(s: k))),
    "}")
}

fn serialize_dag_nodes_table(order: List<Node>, source_indices: Map<String, NewlineIndex>, key_to_id: Map<String, String>) -> String {
  order |> enumerate |> map(pair =>
    concat(
      json_quote(s: concat("n", to_string(value: pair.first))),
      ": ",
      serialize_node_record(node: pair.second, source_indices: source_indices, key_to_id: key_to_id))
  ) |> join(separator: ", ")
}

fn serialize_diagnostic(diagnostic: ErrorNode) -> String {
  let severity = "error"
  concat(
    "{\"severity\": ", json_quote(s: severity),
    ", \"message\": ", json_quote(s: diagnostic_to_message(d: diagnostic.diagnostic)),
    ", \"span\": ", serialize_span(span: diagnostic_to_span(d: diagnostic.diagnostic)),
    ", \"module_name\": ", json_optional_string(value: Present { value: diagnostic.module_name }),
    ", \"category\": ", "null",
    "}")
}

fn emit_dag_artifact(typed: ResolvedGraph) -> EmitResult {
  let collected = collect_dag_nodes(typed: typed)
  let _ = trace_mark("compile.emit.dag.collect.done")
  if collected.collision_errors |> count > 0 {
    return EmitResult { files: [], diagnostics: collected.collision_errors }
  }
  let order = collected.order
  let key_to_id = build_dag_key_to_id(order: order)
  let ref_errors = dag_emit_ref_errors(order: order, key_to_id: key_to_id)
  if ref_errors |> count > 0 {
    return EmitResult { files: [], diagnostics: ref_errors }
  }
  let source_indices = dag_graph_source_indices(typed: typed)
  let nodes_json = serialize_dag_nodes_table(order: order, source_indices: source_indices, key_to_id: key_to_id)
  let modules_json = typed.modules |> map(m => serialize_typed_module(module: m, key_to_id: key_to_id)) |> join(separator: ", ")
  let diagnostics_json = typed.diagnostics |> map(d => serialize_diagnostic(diagnostic: d)) |> join(separator: ", ")
  let item_registry_json = sorted_map_keys(typed.item_registry) |> map(k => json_quote(s: k)) |> join(separator: ", ")
  let json = concat(
    "{\n  \"version\": \"0.2.0\",\n  \"nodes\": {", nodes_json,
    "},\n  \"modules\": [", modules_json,
    "],\n  \"item_registry_keys\": [", item_registry_json,
    "],\n  \"diagnostics\": [", diagnostics_json,
    "],\n  \"files\": []\n}"
  )
  let _ = trace_mark("compile.emit.dag.serialize.done")
  EmitResult {
    files: [TextFile { path: "dag-artifact.json", content: json }],
    diagnostics: []
  }
}

fn boundary_ref_error(names: List<String>, ref_name: String) -> List<ErrorNode> {
  if names |> any(n => n == ref_name) { [] }
  else { [compile_bundle_error(message: concat("boundary references unknown artifact '", ref_name, "'"))] }
}

fn validate_boundaries(plan: ArtifactPlan) -> List<ErrorNode> {
  let names = plan.artifacts |> map(a => a.name)
  plan.boundaries |> flat_map(b =>
    concat(
      boundary_ref_error(names: names, ref_name: b.from_artifact),
      boundary_ref_error(names: names, ref_name: b.to_artifact)
    )
  )
}

type EmittableGraph sole_constructor {
  graph: ResolvedGraph
}

fn emittable_graph(resolved: ResolvedPipelineResult) -> EmittableGraph? {
  let blocking = resolved.diagnostics |> filter(d => is_interpreter_blocking_diagnostic(d: d.diagnostic))
  if blocking |> count > 0 {
    none
  } else {
    match resolved.graph {
      Present { value: typed } => Present { value: EmittableGraph { graph: typed } }
      Absent => none
    }
  }
}

fn emittable_graph_from_graph(typed: ResolvedGraph) -> EmittableGraph {
  EmittableGraph { graph: typed }
}

fn emit_from_artifact_plan(emittable: EmittableGraph, artifact_plan: ArtifactPlan) -> EmitResult {
  let typed = emittable.graph
  if artifact_plan.artifacts |> count == 0 {
    return EmitResult {
      files: [],
      diagnostics: [compile_bundle_error(message: "compile_sources planned no artifacts")]
    }
  }
  let boundary_diags = validate_boundaries(plan: artifact_plan)
  if boundary_diags |> count > 0 {
    return EmitResult { files: [], diagnostics: boundary_diags }
  }
  let results = artifact_plan.artifacts |> map(artifact => emit_artifact(typed: typed, artifact: artifact))
  let all_files = results |> flat_map(r => r.files)
  let all_diags = results |> flat_map(r => r.diagnostics)
  EmitResult { files: all_files, diagnostics: all_diags }
}

fn collect_diagnostics(parse_results: List<ParseResult>) -> List<ErrorNode> {
  fold(parse_results, init: [], f: (acc, pr) =>
    match pr.error {
      Present { value: diag } => list_push(acc, diag)
      Absent => acc
    }
  )
}

fn resolve_frontend_occurrence_transport(
  module_inputs: List<ModuleOccurrenceInput>,
  source_indices: Map<String, NewlineIndex>,
  occurrence_transport: OccurrenceTransport
) -> FrontendOccurrenceResolution {
  match occurrence_transport_refusal(transport: occurrence_transport) {
    Present { value: refusal } =>
      FrontendOccurrenceResolution {
        graph: none,
        diagnostics: [
          make_error_node(
            diagnostic: OccurrenceTransportViolation { refusal: refusal },
            module_name: ""
          )
        ],
      }
    Absent =>
      let graph = resolve_modules_with_occurrence_transport(
        module_inputs: module_inputs,
        source_indices: source_indices,
        occurrence_transport: occurrence_transport
      )
      FrontendOccurrenceResolution {
        graph: Present { value: graph },
        diagnostics: graph.diagnostics,
      }
  }
}

fn front_end_sources(sources: List<SourceFile>) -> FrontendResult {
  let prepared = sources |> map(s =>
    let artifact = tokenize_artifact(source: s.content, file: s.path, env: dag_parse_environment)
    let si = build_newline_index(file: s.path, source: s.content)
    FrontendPrepared {
      tokens: artifact.tokens,
      annotations: artifact.annotations,
      source_length: string_length(s: s.content),
      newline_index: si,
    }
  )
  let intern_table = prepared |> fold(init: empty_intern_table(), f: (t, p) => pre_intern_tokens(tokens: p.tokens, table: t))
  let parsed = prepared |> fold(init: FrontendAccum {
    parse_results: [],
    module_inputs: [],
    newline_indices: [],
    intern_table: intern_table,
    occurrence_allocator: occurrence_id_allocator_initial(),
    annotations: source_annotation_graph_empty(),
    annotation_diagnostics: [],
  }, f: (acc, p) =>
    let parsed = parse_with_table_in_occurrence_scope(
      tokens: p.tokens,
      source_indices: map_insert(
        empty_map(),
        p.newline_index.file,
        p.newline_index
      ),
      intern_table: acc.intern_table,
      occurrence_allocator: acc.occurrence_allocator,
      env: dag_parse_environment
    )
    let bound = admit_source_annotations(
      transport: parsed.occurrence_transport,
      captures: p.annotations,
      source_length: p.source_length
    )
    FrontendAccum {
      parse_results: list_push(acc.parse_results, parsed.result),
      module_inputs: match parsed.result.module {
        Present { value: parsed_module } =>
          list_push(acc.module_inputs, module_occurrence_input(
            module: parsed_module,
            occurrence_transport: parsed.occurrence_transport
          ))
        Absent => acc.module_inputs
      },
      newline_indices: list_push(acc.newline_indices, p.newline_index),
      intern_table: parsed.intern_table,
      occurrence_allocator: parsed.occurrence_allocator,
      annotations: source_annotation_graph_concat(left: acc.annotations, right: bound.graph),
      annotation_diagnostics: concat(
        acc.annotation_diagnostics,
        bound.diagnostics |> map(d => make_error_node(diagnostic: d, module_name: p.newline_index.file))
      ),
    }
  )
  let parse_results = parsed.parse_results
  let newline_indices = parsed.newline_indices
  let parse_diagnostics = collect_diagnostics(parse_results: parse_results)
  let module_inputs = parsed.module_inputs
  let source_indices = fold(newline_indices, init: empty_map(), f: (acc, si) => map_insert(acc, si.file, si))
  let occurrence_transport = merge_occurrence_transports(
    transports: module_inputs |> map(input =>
      module_occurrence_input_transport(input: input)
    )
  )
  let resolution = resolve_frontend_occurrence_transport(
    module_inputs: module_inputs,
    source_indices: source_indices,
    occurrence_transport: occurrence_transport
  )
  FrontendResult {
    graph: resolution.graph,
    diagnostics: concat(concat(parse_diagnostics, resolution.diagnostics), parsed.annotation_diagnostics),
    newline_indices: newline_indices,
    intern_table: parsed.intern_table,
    occurrence_transport: occurrence_transport,
    annotations: parsed.annotations
  }
}

// A census head is the declaration projection of an already parsed Node. Signature
// subtrees and declaration identity survive; executable expressions and uses do not.
// A function keeps the parser's refusing body stand-in: body presence is the existing
// function-kind discriminator used by local_binding_for_item, not executable content.
fn census_heads_item_is_fn_decl(item: Node) -> Bool {
  item.connective == NoConnective && item.body != none && item.transport == none
}

fn census_heads_node(node: Node, children: List<Node>, body: Node?) -> Node {
  Node {
    occurrence_identity: node.occurrence_identity,
    name: node.name,
    ident: node.ident,
    span: node.span,
    ident_span: node.ident_span,
    children: children,
    connective: node.connective,
    params: node.params,
    inferred: node.inferred,
    return_cardinality: node.return_cardinality,
    uses: [],
    body: body,
    transport: node.transport,
    properties: node.properties,
    type_annotation: node.type_annotation,
    is_self_recursive: node.is_self_recursive,
    has_non_tail_self_call: node.has_non_tail_self_call,
    match_pattern: none,
    module_item_kind: node.module_item_kind, declaration_marker: node.declaration_marker,
    expr_data: NoExprData,
  }
}

fn census_heads_module_item(item: Node) -> Node {
  census_heads_node(
    node: item,
    children: item.children |> map(child => census_heads_module_item(item: child)),
    body: if census_heads_item_is_fn_decl(item: item) {
      Present { value: census_heads_body_stand_in() }
    } else { none }
  )
}

fn census_heads_module_node(module: Node) -> Node {
  census_heads_node(
    node: module,
    children: module_items(n: module) |> map(item => census_heads_module_item(item: item)),
    body: none
  )
}

type CensusFillParse {
  modules: List<Node>,
  newline_indices: List<NewlineIndex>,
  diagnostics: List<ErrorNode>
  occurrence_transport: OccurrenceTransport
  annotations: SourceAnnotationGraph
}

type CensusModuleRetention
  = RetainParsedModules
  | RetainDeclarationHeads

fn census_retain_module(module: Node, retention: CensusModuleRetention) -> Node {
  match retention {
    RetainParsedModules => module
    RetainDeclarationHeads => census_heads_module_node(module: module)
  }
}

fn census_retain_parse_result(result: ParseResult, retention: CensusModuleRetention) -> ParseResult {
  ParseResult {
    module: match result.module {
      Present { value: module_node } => Present { value: census_retain_module(module: module_node, retention: retention) }
      Absent => none
    },
    error: result.error
  }
}

// Parse-grade front end for census-only fill: tokenize + parse, NEVER resolve (a fill module's
// imports live in the compile closure or a different tree view; resolving against a fill-only pool
// fabricates unresolved-import diagnostics about the view, not the modules). Diagnostics are parse
// errors only — those are load-bearing (a broken-parse module contributes no names to the census)
// and must surface, never be skipped.

// TOKENIZE INSIDE THE FOLD, NOT INTO A LIST AHEAD OF IT. The census fill's population is the
// WHOLE indexed pool minus the compile closure, so for an `--entry` compile it is ~5.4k modules
// the entry never references. Materializing `prepared` first held every one of those modules'
// token streams resident simultaneously, for a fold that consumes each exactly once and in order
// — the token stream for module N was alive for the entire parse of modules N+1..5400 with no
// consumer. Fusing the tokenize into the fold frees each module's tokens before the next is read,
// which is DESIGN §2's "minimise the demand before materialising" applied to a RETENTION shape:
// the same work, the same order, the same results, held for the interval it is actually used.
// The instrument that re-derives the size of this term, rather than a number copied out of it
// (DESIGN §6): `gunbc compile --source-root dag --source-root src/v2 --entry
// src/v2/workflow/floor2_prepared_subject.dag --output-dir <dir> --target dag`, reading VmHWM
// from /proc/<pid>/status while it runs. The entry is chosen because its reference-derived
// closure is a handful of files while the census population is the whole pool, so peak RSS there
// is dominated by this fold rather than by the closure being compiled.
//
// THE PRE-INTERN PASS DISSOLVES WITH `prepared`, and that is a consequence rather than a
// separate decision: it existed only because the token lists were already all in hand. Interning
// is idempotent and `parse_with_table_in_occurrence_scope` already threads an updated table
// through the fold, so pre-interning module N's tokens immediately before parsing module N
// reaches that parse with the same table contents the two-pass form did. What changes is the
// ORDER ids are assigned in, which no consumer reads: names are resolved positionally through
// `authored_name_at` against the newline index, never by intern id.
//
// WHAT THIS DELIBERATELY DOES NOT CHANGE: every module is still parsed with FULL BODIES and its
// parse diagnostics still surface. That is load-bearing and is not a formality — a body-level
// parse break in a non-closure module (balanced braces, invalid inside) is invisible to the
// heads-only module index and is caught HERE and nowhere else. The discriminating RED is a
// planted `fn body_probe(x: Int) -> Int { let = = = 9 }` in a module outside the entry's
// closure: it must keep refusing with `expected name, found Eq`.
// ONE CENSUS FOLD, TWO AXES. Main parameterized this fold on RETENTION while this branch
// parameterized it on the parse ENVIRONMENT; keeping both variants would fork one fold into two
// bodies that drift (section 3), so the axes meet in a single core and the named wrappers delegate
// to it. A caller says only what it means to vary.
//
// THE ENVIRONMENT AXIS EXISTS because reading one revision's sources means reading them under THAT
// revision's grammar. `dag_parse_environment` is named in the wrappers and nowhere in the core, so a
// base-reading caller cannot pick up head rules by omission -- the defect
// gunbc.recurring_failure_mode.base_readability_gate_refuses_a_grammar_change names.
fn parse_census_fill_sources_with(
  sources: List<SourceFile>,
  retention: CensusModuleRetention,
  environment: ParseEnvironment
) -> CensusFillParse {
  let parsed = sources |> fold(init: FrontendAccum {
    parse_results: [],
    module_inputs: [],
    newline_indices: [],
    intern_table: empty_intern_table(),
    occurrence_allocator: occurrence_id_allocator_initial(),
    annotations: source_annotation_graph_empty(),
    annotation_diagnostics: [],
  }, f: (acc, s) =>
    let artifact = tokenize_artifact(source: s.content, file: s.path, env: environment)
    let p = FrontendPrepared {
      tokens: artifact.tokens,
      annotations: artifact.annotations,
      source_length: string_length(s: s.content),
      newline_index: build_newline_index(file: s.path, source: s.content),
    }
    let parsed = parse_with_table_in_occurrence_scope(
      tokens: p.tokens,
      source_indices: map_insert(
        empty_map(),
        p.newline_index.file,
        p.newline_index
      ),
      intern_table: pre_intern_tokens(tokens: p.tokens, table: acc.intern_table),
      occurrence_allocator: acc.occurrence_allocator,
      env: environment
    )
    let bound = admit_source_annotations(
      transport: parsed.occurrence_transport,
      captures: p.annotations,
      source_length: p.source_length
    )
    let retained_result = census_retain_parse_result(result: parsed.result, retention: retention)
    FrontendAccum {
      parse_results: list_push(acc.parse_results, retained_result),
      module_inputs: match retained_result.module {
        Present { value: parsed_module } =>
          list_push(acc.module_inputs, module_occurrence_input(
            module: parsed_module,
            occurrence_transport: parsed.occurrence_transport
          ))
        Absent => acc.module_inputs
      },
      newline_indices: list_push(acc.newline_indices, p.newline_index),
      intern_table: parsed.intern_table,
      occurrence_allocator: parsed.occurrence_allocator,
      annotations: source_annotation_graph_concat(left: acc.annotations, right: bound.graph),
      annotation_diagnostics: concat(
        acc.annotation_diagnostics,
        bound.diagnostics |> map(d => make_error_node(diagnostic: d, module_name: p.newline_index.file))
      ),
    }
  )
  let parse_results = parsed.parse_results
  let module_inputs = parsed.module_inputs
  CensusFillParse {
    modules: module_inputs |> map(input =>
      module_occurrence_input_node(input: input)
    ),
    newline_indices: parsed.newline_indices,
    diagnostics: concat(collect_diagnostics(parse_results: parse_results), parsed.annotation_diagnostics),
    occurrence_transport: merge_occurrence_transports(
      transports: module_inputs |> map(input =>
        module_occurrence_input_transport(input: input)
      )
    ),
    annotations: parsed.annotations,
  }
}

// THE THREE WRAPPERS, each varying ONE axis and defaulting the other. Every ordinary consumer
// parses the running binary's own corpus at full retention, so naming both axes at every call site
// would be noise; these are the only places `dag_parse_environment` is named on the census path. A
// caller reading ANOTHER revision must reach the environment form -- arriving here with base-side
// sources is precisely the silent head-rules read the parameter exists to prevent.
fn parse_census_fill_sources(sources: List<SourceFile>) -> CensusFillParse {
  parse_census_fill_sources_with(
    sources: sources,
    retention: RetainParsedModules,
    environment: dag_parse_environment
  )
}

// Singleton occurrence and namespace consumers select their module-retention projection; the
// grammar is the running binary's.
fn parse_census_fill_sources_with_retention(sources: List<SourceFile>, retention: CensusModuleRetention) -> CensusFillParse {
  parse_census_fill_sources_with(
    sources: sources,
    retention: retention,
    environment: dag_parse_environment
  )
}

// Base-side readers select the grammar and keep full retention, because a baseline compared against
// the head must carry the same declaration detail the head side carries.
fn parse_census_fill_sources_with_environment(
  sources: List<SourceFile>,
  environment: ParseEnvironment
) -> CensusFillParse {
  parse_census_fill_sources_with(
    sources: sources,
    retention: RetainParsedModules,
    environment: environment
  )
}

fn resolve_sources(sources: List<SourceFile>) -> CompileResult {
  let frontend = front_end_sources(sources: sources)
  CompileResult { files: [], diagnostics: frontend.diagnostics }
}

fn compile_sources(sources: List<SourceFile>, target: RenderTarget) -> PipelineResult {
  compile_sources_with_options(
    sources: sources,
    target: target,
    options: default_compile_pipeline_options()
  )
}

// THE CHANGE-DENOMINATED ENTRY. Same pipeline, same resolved graph, same diagnostics -- the
// selection reaches emission only, where it decides which modules are RENDERED. A caller that
// supplies RenderEveryModule here has written `compile_sources` the long way, which is why that
// wrapper stays the name for the whole-closure question.
fn compile_sources_selected(sources: List<SourceFile>, target: RenderTarget, selection: RustModuleRenderSelection) -> PipelineResult {
  emit_resolved_for_target_selected(
    resolved: compile_to_resolved_with_options(sources: sources, options: default_compile_pipeline_options()),
    target: target,
    selection: selection
  )
}

fn compile_sources_with_options(sources: List<SourceFile>, target: RenderTarget, options: CompilePipelineOptions) -> PipelineResult {
  emit_resolved_for_target(
    resolved: compile_to_resolved_with_options(sources: sources, options: options),
    target: target
  )
}

fn interpreter_blocking_diagnostic_messages(diagnostics: List<ErrorNode>) -> List<String> {
  diagnostics
    |> filter(d => is_interpreter_blocking_diagnostic(d: d.diagnostic))
    |> map(d => {
      let span = diagnostic_to_span(d: d.diagnostic)
      concat(
        diagnostic_to_message(d: d.diagnostic),
        " (",
        span.file,
        ":",
        to_string(value: span.start),
        "-",
        to_string(value: span.end),
        ")"
      )
    })
}

// The SUBJECT is the caller's fact, never this function's. Both arms once hardcoded
// "v2 self-compile" while the generic compile path reached them, so a user compiling
// their own fixture was told a compile they never ran had failed -- a false subject
// costs the next reader's search, the stale-citation harm class.
fn stage0_self_compile_refusal_message(subject: String, result: PipelineResult) -> String? {
  let hard_messages = interpreter_blocking_diagnostic_messages(diagnostics: result.diagnostics)
  if hard_messages |> count > 0 {
    Present {
      value: concat(
        subject,
        " produced ",
        to_string(value: hard_messages |> count),
        " hard diagnostic(s):\n",
        hard_messages |> join(separator: "\n")
      )
    }
  } else if result.files |> count == 0 {
    Present { value: concat(subject, " emitted no files") }
  } else {
    none
  }
}

type ResolvedPipelineResult {
  graph: ResolvedGraph?
  diagnostics: List<ErrorNode>
  source_indices: Map<String, NewlineIndex>
  complexity: ComplexityReport
  ownership: List<OwnershipProof>
  newline_indices: List<NewlineIndex>
}

fn compile_to_resolved(sources: List<SourceFile>) -> ResolvedPipelineResult {
  compile_to_resolved_with_options(
    sources: sources,
    options: default_compile_pipeline_options()
  )
}

fn compile_to_resolved_discovery_corpus_advisory(sources: List<SourceFile>) -> ResolvedPipelineResult {
  compile_to_resolved(sources: sources)
}

fn compile_to_resolved_with_options(sources: List<SourceFile>, options: CompilePipelineOptions) -> ResolvedPipelineResult {
  let _ = trace_mark("compile.frontend.begin")
  let frontend = front_end_sources(sources: sources)
  let _ = trace_mark("compile.frontend.done")
  let newline_indices = frontend.newline_indices
  match frontend.graph {
    Absent =>
      ResolvedPipelineResult {
        graph: none,
        diagnostics: frontend.diagnostics,
        source_indices: empty_map(),
        complexity: empty_complexity_report(),
        ownership: [],
        newline_indices: newline_indices
      }
    Present { value: graph } => {
      let source_indices = fold(newline_indices, init: empty_map(), f: (acc, index) => map_insert(acc, index.file, index))
      let norm = normalize_graph(graph: graph, source_indices: source_indices)
      let _ = trace_mark("compile.normalize.done")
      let norm_diags = norm.diagnostics
      let fill = parse_census_fill_sources_with_retention(
        sources: options.census_only_sources,
        retention: RetainDeclarationHeads
      )
      let census_si = fold(fill.newline_indices, init: source_indices, f: (acc, index) => map_insert(acc, index.file, index))
      let typed = reconcile_with_census_extra(graph: norm.graph, source_indices: source_indices, intern_table: frontend.intern_table, census_fill_modules: fill.modules, census_si: census_si)
      let _ = trace_mark("compile.reconcile.done")
      let typed_diags = typed.diagnostics
      let complexity = if options.analyze_complexity {
        run_complexity_analysis(typed: typed, source_indices: source_indices)
      } else {
        empty_complexity_report()
      }
      let complexity_diags = if options.analyze_complexity {
        complexity_diagnostics(complexity: complexity)
      } else {
        []
      }
      let all_diags = concat(typed_diags, complexity_diags)
      let ownership = extract_ownership_proofs(typed: typed)
      let ownership_diags = ownership_diagnostics(proofs: ownership)
      let test_reference_diags = test_reference_diagnostics(typed: typed, source_indices: source_indices)
      let _ = trace_mark("compile.analyses.done")
      ResolvedPipelineResult {
        graph: typed,
        diagnostics: concat(frontend.diagnostics, fill.diagnostics, norm_diags, all_diags, ownership_diags, test_reference_diags),
        source_indices: source_indices,
        complexity: complexity,
        ownership: ownership,
        newline_indices: newline_indices
      }
    }
  }
}

fn emit_resolved_for_target(resolved: ResolvedPipelineResult, target: RenderTarget) -> PipelineResult {
  emit_resolved_for_target_selected(resolved: resolved, target: target, selection: RenderEveryModule)
}

// WHY THE REFUSAL PRECONDITION A SCOPED ROUND RESTS ON LIVES HERE, one binding down.
//
// Under RenderSelectedMirrors the emitter observes import refusals only for the modules it
// rendered, so a reader is owed why that is EXACT rather than merely cheaper. It is exact
// because of `final_files` below: an emit carrying one error diagnostic returns NO FILES AT ALL.
// A committed mirror is therefore a file some emit returned, and no emit returns a file while
// any module in the closure refuses. So a tree that exists is a tree whose whole closure emitted
// clean, and the modules a scope declined to render had nothing to say.
//
// This is a construction rather than a claim about it: the `if` below is what makes the
// implication true, and `an_emit_that_refuses_hands_back_no_files` in
// `v1_compiler.required_regen_host` is its discriminating execution -- a fixture whose emit
// refuses, asserted to produce zero files rather than the ones that did render. It runs in the
// required unit step, so deleting the `if` goes red there, which is the only form this argument
// can take that a later reader can check.
fn emit_resolved_for_target_selected(resolved: ResolvedPipelineResult, target: RenderTarget, selection: RustModuleRenderSelection) -> PipelineResult {
  match emittable_graph(resolved: resolved) {
    Absent =>
      PipelineResult {
        files: [],
        diagnostics: resolved.diagnostics,
        complexity: resolved.complexity,
        ownership: resolved.ownership,
        artifact_plan: empty_artifact_plan(),
        newline_indices: resolved.newline_indices
      }
    Present { value: emittable } => {
      let typed = emittable.graph
      let artifact_plan = selected_artifact_plan(
        root_modules: typed.modules |> map(m => authored_name_at(source_indices: resolved.source_indices, node: m.module)),
        target: target,
        selection: selection
      )
      let _ = trace_mark("compile.emit.begin")
      let emit_result = emit_from_artifact_plan(emittable: emittable, artifact_plan: artifact_plan)
      let _ = trace_mark("compile.emit.done")
      let emit_files = emit_result.files
      let emit_diags = emit_result.diagnostics
      let emit_errors = emit_diags |> filter(d => is_error_diagnostic(d: d.diagnostic))
      let final_files = if emit_errors |> count > 0 { [] } else { emit_files }
      PipelineResult {
        files: final_files,
        diagnostics: concat(resolved.diagnostics, emit_diags),
        complexity: resolved.complexity,
        ownership: resolved.ownership,
        artifact_plan: artifact_plan,
        newline_indices: resolved.newline_indices
      }
    }
  }
}
