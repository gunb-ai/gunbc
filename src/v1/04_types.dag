fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

fn type_variable_node(id: String) -> Node {
  Node { occurrence_identity: OccurrenceSynthetic, name: "", span: no_span(), ident_span: none, children: [], connective: NoConnective, params: [], inferred: Present { value: TypeVariable { id: id } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
}

fn resolved_type(n: Node) -> Node {
  match n.inferred {
    Present { value: Resolved { node: rt } } => rt
    _ => error_type
  }
}

// AN ARROW'S inferred IS ITS RETURN TYPE, NOT ITS OWN TYPE: make_callable_type and
// parse_callable_type_expr store the codomain there, so reading it as "the type this child
// denotes" answered `Int` for the element of `List<fn() -> Int>` and every binding drawn from that
// element -- a lambda parameter, a match arm -- lost its callability and its call refused as
// `function 'r' not found in scope`. An Arrow child denotes itself.
// gunbc.recurring_failure_mode arity_proxy_for_callability_misroutes_a_found_local.
fn child_type_node(ch: Node) -> Node {
  if ch.inferred != none && (ch.connective != Arrow) { resolved_type(n: ch) } else { ch }
}

// THE JOIN'S ELEMENT READ -- the single reader both container-descend and container-alias-descend arms use
// (one authority for the subject; DESIGN 6b). An element of a container is read by its SHAPE. A bare leaf slot
// (no children) only NAMES a type: read it through child_type_node to what it resolves to. An unsolved one --
// the empty list's element -- then arrives as its type variable, and node_type_compatible defers on a type
// variable, so the empty list joins any List<X> (the corpus shapes std.materialization_ladder's
// ladder_distinct_identities and v2.workflow.native_route_progress_guard's native_progress_report, which a blanket nominal read refused by handing back the bare slot,
// whose inferred is a resolution, not a type variable, so nothing deferred). A resolved leaf arrives as the
// use node it names. An APPLIED element (children) is compared by its head, so it is kept as its own nominal
// node -- reading it through child_type_node handed back the declaration-body expansion (FreeMonoid<Symbol>
// -> Disj Empty | Cons), and the join refused a pair both authors wrote as List<QualifiedName>
// (recurring failure mode type_alias_identity_decided_by_spelling_at_each_check). This matches child_type_node on every leaf and generic on every
// application: it changes behaviour only where each was individually wrong at the join.
fn join_element_type(slot: Node) -> Node {
  if slot.children |> count == 0 { child_type_node(ch: slot) } else { slot }
}

fn is_type_expr_annotation(n: Node) -> Bool {
  match n.expr_data {
    NoExprData => true
    _ => false
  }
}

fn node_is_collection(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  (n.children |> count) > 0 && n.connective == NoConnective && is_declared_container_alias_spelling(name: authored_name_at(source_indices: source_indices, node: n))
}

// The arity conjunct is tested FIRST because it is free and the collection
// conjunct is not: node_is_collection ends in authored_name_at, which resolves a
// span against the newline index and slices source text on every call. Testing
// arity first is the SAME conjunction, so the answer cannot change, and it
// spares that lookup for every node that could not have been a keyed collection
// anyway (DESIGN §6 bare-minimum cost — a conjunction that puts its expensive
// term first is a cost-shape defect regardless of the realized n).
fn node_is_keyed_collection(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  (n.children |> count) == 2 && (node_is_collection(n: n, source_indices: source_indices) || node_is_keyed_algebra_spelling(n: n, source_indices: source_indices))
}

// THE KEYED ALGEBRA'S OWN SPELLING IS THE SAME CARRIER AS ITS ALIASES. std.algebra now writes
// `FinitelySupportedFunction<K, V>` where it wrote `Map<K, V>`; that spelling is deliberately not
// an alias row (canonical_spelling_sorts_ahead_of_alias_reason), so node_is_collection missed it
// and the Rust emitter rendered the algebra STRUCT beside HashMap callers (E0308). Only the keyed
// algebra is admitted here: the element algebras' own spellings (FreeMonoid) are v2 declarations
// with their own representation and must not lower to a host container by spelling.
// RESIDUE: this keys on the leaf spelling, not the declaration identity std.algebra.FinitelySupportedFunction;
// the emitter reaches only the authored spelling here. Tracked by gunbc.recurring_failure_mode
// emitter_keyed_container_lowering_is_keyed_by_leaf_spelling (same class as
// host_seam_realization_is_keyed_by_primitive_spelling).
fn node_is_keyed_algebra_spelling(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  n.connective == NoConnective && match container_template_algebra(name: qualified_last_segment(name: authored_name_at(source_indices: source_indices, node: n))) {
    Present { value: algebra } => algebra == "FinitelySupportedFunction"
    Absent => false
  }
}

fn collection_carrier_node(n: Node) -> Node {
  if (n.children |> count) == 0 {
    match n.inferred {
      Present { value: Resolved { node: rt } } => rt
      _ => n
    }
  } else { n }
}

fn node_is_element_collection(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let c = collection_carrier_node(n: n)
  (c.children |> count) == 1 && node_is_collection(n: c, source_indices: source_indices)
}

fn node_is_set_collection(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  node_is_element_collection(n: n, source_indices: source_indices) && qualified_last_segment(name: authored_name_at(source_indices: source_indices, node: n)) == "Set"
}

fn canonical_template_name(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let nm = authored_name_at(source_indices: source_indices, node: n)
  match container_template_algebra(name: qualified_last_segment(name: nm)) {
    Present { value: algebra } => algebra
    Absent => nm
  }
}

fn is_declared_container_alias_spelling(name: String) -> Bool {
  match container_template_alias_algebra(name: qualified_last_segment(name: name)) {
    Present { value: _ } => true
    Absent => false
  }
}

fn container_alias_canonical_spelling(algebra: String) -> String? {
  fold(sorted_map_keys(container_template_alias_rows), init: none, f: (acc, k) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        match map_get(container_template_alias_rows, k) {
          Present { value: v } => if v == algebra { Present { value: k } } else { none }
          Absent => none
        }
    }
  )
}

fn container_kind_canonical(name: String) -> String {
  let last = qualified_last_segment(name: name)
  match kernel_algebra_profile |> get(last) {
    Present { value: _ } => last
    Absent =>
      match container_template_algebra(name: last) {
        Present { value: algebra } =>
          match container_alias_canonical_spelling(algebra: algebra) {
            Present { value: canonical } => canonical
            Absent => last
          }
        Absent => last
      }
  }
}

fn kernel_profile_lookup(name: String) -> AlgebraProfile? {
  kernel_algebra_profile |> get(container_kind_canonical(name: name))
}

fn reground_alias_carrier_identity(n: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  if n.name != "" && n.name != authored_name_at(source_indices: source_indices, node: n) && is_declared_container_alias_spelling(name: n.name) {
    Node {
      occurrence_identity: OccurrenceSynthetic, name: n.name, span: n.span, ident_span: Present { value: kernel_span(name: n.name) },
      children: n.children, connective: n.connective, params: n.params, inferred: n.inferred,
      return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport,
      properties: n.properties, type_annotation: n.type_annotation,
      is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call,
      match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: n.expr_data
    }
  } else {
    n
  }
}

fn structural_carrier_template_name(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  if n.name != "" {
    canonical_template_name(n: Node {
      occurrence_identity: OccurrenceSynthetic, name: n.name, span: n.span, ident_span: Present { value: kernel_span(name: n.name) },
      children: n.children, connective: n.connective, params: n.params, inferred: n.inferred,
      return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport,
      properties: n.properties, type_annotation: n.type_annotation,
      is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call,
      match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: n.expr_data
    }, source_indices: source_indices)
  } else {
    canonical_template_name(n: n, source_indices: source_indices)
  }
}

fn is_product_type(n: Node) -> Bool { n.connective == Conj }
fn is_coproduct_type(n: Node) -> Bool { n.connective == Disj }
fn is_leaf_type(n: Node) -> Bool { n.connective == NoConnective }
fn is_unit_like(n: Node) -> Bool { n.connective == Conj && n.children |> count == 0 }

// The three answers this walk can give. Before this type existed the walk returned
// Bool, which has nowhere to put "I cannot classify this name": an unrecognized
// container spelling took the same Absent arm as String and every user record and
// came back "not under-parameterized" -- a resolution claim about a name whose
// arity is unknown. UnderResolved and ContainerSpellingUnresolvable are different
// states with different remedies (supply the type argument / declare the row), and
// the collapse to Bool below is now a NAMED collapse rather than a silent one.
type TypeResolutionVerdict
  = FullyResolved
  | UnderResolved
  | ContainerSpellingUnresolvable { name: String }
  | DivergentExpression

// Refusal dominates under-resolution dominates resolution: the strongest reason
// the walk found is the one it reports, so a refused child is never averaged away
// by resolved siblings. review 58547: the acc match is spelled over all four
// variants rather than a wildcard. A catch-all here would hide DivergentExpression
// at the verdict layer in exactly the way an absent name hid it at the node layer,
// which is the conflation this whole change exists to remove -- and the next
// variant added would be absorbed silently instead of refusing. The arms are
// deliberately identical in behaviour to the wildcard they replace: this states the
// existing dominance order, it does not change it.
fn combine_resolution_verdicts(acc: TypeResolutionVerdict, next: TypeResolutionVerdict) -> TypeResolutionVerdict {
  let stronger_of_next = match next {
    ContainerSpellingUnresolvable { name: _ } => next
    UnderResolved => UnderResolved
    DivergentExpression => next
    FullyResolved => acc
  }
  match acc {
    ContainerSpellingUnresolvable { name: _ } => acc
    UnderResolved => stronger_of_next
    DivergentExpression => stronger_of_next
    FullyResolved => stronger_of_next
  }
}

// AN ARROW IS RESOLVED WHEN ITS SIGNATURE IS: its parameter types sit in params and its codomain in
// inferred, and it has no children, so the child walk below read every Arrow as FullyResolved. It
// is asked first because the two checks after it read inferred as the node's OWN type, which on an
// Arrow is the codomain.
fn callable_resolution_verdict(n: Node, source_indices: Map<String, NewlineIndex>) -> TypeResolutionVerdict {
  let params_verdict = fold(n.params, init: FullyResolved, f: (acc, p) =>
    combine_resolution_verdicts(acc: acc, next: type_resolution_verdict(n: child_type_node(ch: param_node_type_expr(n: p)), source_indices: source_indices))
  )
  match n.inferred {
    Present { value: Resolved { node: ret } } =>
      combine_resolution_verdicts(acc: params_verdict, next: type_resolution_verdict(n: ret, source_indices: source_indices))
    _ => combine_resolution_verdicts(acc: params_verdict, next: UnderResolved)
  }
}

fn type_resolution_verdict(n: Node, source_indices: Map<String, NewlineIndex>) -> TypeResolutionVerdict {
  if (n.connective == Arrow) { callable_resolution_verdict(n: n, source_indices: source_indices) } else {
  let self_is_type_var = match n.inferred { Present { value: inf } => is_type_variable(inferred: inf)  Absent => false }
  if type_is_divergent(n: n) { DivergentExpression }
  else if self_is_type_var { UnderResolved }
  else {
    match authored_container_spelling_verdict(node: n, source_indices: source_indices) {
      ContainerSpellingUnknown { container_leaf: _ } =>
        ContainerSpellingUnresolvable { name: authored_name_at(source_indices: source_indices, node: n) }
      ContainerSpellingDeclared { arity: expected } =>
        if (n.children |> count) < expected {
          UnderResolved
        } else {
          fold(n.children, init: FullyResolved, f: (acc, ch) =>
            combine_resolution_verdicts(
              acc: acc,
              next: type_resolution_verdict(n: child_type_node(ch: ch), source_indices: source_indices)
            )
          )
        }
      NotAContainerSpelling =>
        fold(n.children, init: FullyResolved, f: (acc, ch) =>
          combine_resolution_verdicts(
            acc: acc,
            next: type_resolution_verdict(n: child_type_node(ch: ch), source_indices: source_indices)
          )
        )
    }
  }
  }
}

// The collapse the thirteen call sites consume. A refusal reads as NOT fully
// resolved, which is the conservative arm -- it declines to claim a resolution the
// walk could not establish, and it never widens to the resolved answer the old
// Absent arm gave. The located, counted report of the same class is emitted once
// per authored occurrence by v1.compiler.normalize check_bare_containers, which
// already owns a diagnostics channel; reporting from here instead would emit one
// diagnostic per query per node of every recursive walk that asks.
fn is_fully_resolved(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match type_resolution_verdict(n: n, source_indices: source_indices) {
    FullyResolved => true
    UnderResolved => false
    ContainerSpellingUnresolvable { name: _ } => false
    DivergentExpression => false
  }
}

// The divergence fact, asked of a type node directly. A consumer that needs to tell
// an expression producing NO value apart from a type it could not resolve asks this;
// asking whether the name is empty answers both at once and therefore neither.
fn type_is_divergent(n: Node) -> Bool {
  match n.inferred {
    Present { value: inf } =>
      match inf {
        Divergent => true
        _ => false
      }
    Absent => false
  }
}

fn bare_map_node() -> Node? {
  match container_param_name(kind_name: "Map", index: 0) {
    Present { value: key_id } =>
      match container_param_name(kind_name: "Map", index: 1) {
        Present { value: val_id } =>
          Present {
            value: Node { occurrence_identity: OccurrenceSynthetic, name: "Map", span: no_span(), ident_span: Present { value: no_span() }, children: [
              Node { occurrence_identity: OccurrenceSynthetic, name: key_id, span: no_span(), ident_span: Present { value: no_span() }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: type_variable_node(id: key_id) } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData },
              Node { occurrence_identity: OccurrenceSynthetic, name: val_id, span: no_span(), ident_span: Present { value: no_span() }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: type_variable_node(id: val_id) } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
            ], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
          }
        Absent => none
      }
    Absent => none
  }
}

fn bare_set_node() -> Node? {
  match container_param_name(kind_name: "Set", index: 0) {
    Present { value: elem_id } =>
      Present {
        value: Node { occurrence_identity: OccurrenceSynthetic, name: "Set", span: no_span(), ident_span: Present { value: no_span() }, children: [
          Node { occurrence_identity: OccurrenceSynthetic, name: elem_id, span: no_span(), ident_span: Present { value: no_span() }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: type_variable_node(id: elem_id) } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
        ], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
      }
    Absent => none
  }
}

fn kernel_container_profile_miss_diagnostic(kind_name: String) -> ErrorNode {
  let msg = concat("missing kernel container profile: ", kind_name)
  make_error_node(
    diagnostic: InternalError { message: msg, span: no_span() },
    module_name: "v1.compiler.infer_types"
  )
}

fn missing_kernel_container_profile_type(kind_name: String) -> Node {
  let msg = concat("missing kernel container profile: ", kind_name)
  Node {
    occurrence_identity: OccurrenceSynthetic, name: "",
    span: no_span(),
    ident_span: none,
    children: [],
    connective: NoConnective,
    params: [],
    inferred: Present { value: CompilerError { message: msg, span: no_span() } },
    return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [], type_annotation: none,
    is_self_recursive: false, has_non_tail_self_call: false,
    match_pattern: none,
    module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: ExprError { kind: InternalExprError, message: msg }
  }
}

type KernelTypeBuild {
  ty: Node
  diagnostics: List<ErrorNode>
}

// A builtin whose return type is registered as a bare type_variable_node establishes NOTHING about
// its result, so every field access on that result falls through lookup_field_type_node's Absent
// arm and the caller fabricates a success-shaped Primitive() in its place. That is this lane's own
// finding one level down — a missing judgment rendered as an accepted type — and it stayed
// invisible because the fabricated type propagates silently until some later stage asks a question
// it cannot answer. make_kernel_record_type lets a builtin declare the product type it actually
// returns, so the field's type is READ from the declaration rather than invented. It is the same
// Conj-with-named-children shape lookup_field_type_node already walks for authored records, not a
// second representation of one (DESIGN §3): the kernel path and the authored path resolve fields
// through the identical traversal, so a kernel record cannot drift from what an authored record
// means.

fn make_kernel_record_field(field_name: String, field_type: Node) -> Node {
  Node {
    occurrence_identity: OccurrenceSynthetic, name: field_name, span: kernel_span(name: field_name),
    ident_span: Present { value: kernel_span(name: field_name) },
    children: [], connective: NoConnective, params: [],
    inferred: Present { value: Resolved { node: field_type } },
    return_cardinality: Required, uses: [], body: none, transport: none,
    properties: [], type_annotation: none, is_self_recursive: false,
    has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData
  }
}

fn make_kernel_record_type(type_name: String, fields: List<Node>) -> Node {
  Node {
    occurrence_identity: OccurrenceSynthetic, name: type_name, span: kernel_span(name: type_name),
    ident_span: Present { value: kernel_span(name: type_name) },
    children: fields, connective: Conj, params: [], inferred: none,
    return_cardinality: Required, uses: [], body: none, transport: none,
    properties: [], type_annotation: none, is_self_recursive: false,
    has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData
  }
}

fn make_container_type(kind_name: String, element: Node) -> KernelTypeBuild {
  match container_param_name(kind_name: kind_name, index: 0) {
    Present { value: param_name } =>
      KernelTypeBuild {
        ty: Node { occurrence_identity: OccurrenceSynthetic, name: kind_name, span: kernel_span(name: kind_name), ident_span: Present { value: kernel_span(name: kind_name) }, children: [
          Node { occurrence_identity: OccurrenceSynthetic, name: param_name, span: kernel_span(name: param_name), ident_span: Present { value: kernel_span(name: param_name) }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: element } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
        ], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData },
        diagnostics: []
      }
    Absent =>
      KernelTypeBuild {
        ty: missing_kernel_container_profile_type(kind_name: kind_name),
        diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: kind_name)]
      }
  }
}

fn make_map_type(key: Node, value: Node) -> KernelTypeBuild {
  match container_param_name(kind_name: "Map", index: 0) {
    Present { value: key_name } =>
      match container_param_name(kind_name: "Map", index: 1) {
        Present { value: val_name } =>
          KernelTypeBuild {
            ty: Node { occurrence_identity: OccurrenceSynthetic, name: "Map", span: kernel_span(name: "Map"), ident_span: Present { value: kernel_span(name: "Map") }, children: [
              Node { occurrence_identity: OccurrenceSynthetic, name: key_name, span: kernel_span(name: key_name), ident_span: Present { value: kernel_span(name: key_name) }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: key } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData },
              Node { occurrence_identity: OccurrenceSynthetic, name: val_name, span: kernel_span(name: val_name), ident_span: Present { value: kernel_span(name: val_name) }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: value } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
            ], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData },
            diagnostics: []
          }
        Absent =>
          KernelTypeBuild {
            ty: missing_kernel_container_profile_type(kind_name: "Map"),
            diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: "Map")]
          }
      }
    Absent =>
      KernelTypeBuild {
        ty: missing_kernel_container_profile_type(kind_name: "Map"),
        diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: "Map")]
      }
  }
}

fn make_callable_type(func_params: List<Node>, ret: Node) -> Node {
  Node { occurrence_identity: OccurrenceSynthetic, name: "Callable", span: kernel_span(name: "Callable"), ident_span: Present { value: kernel_span(name: "Callable") }, children: [], connective: Arrow, params: func_params, inferred: Present { value: Resolved { node: ret } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
}

fn make_tuple_type(first: Node, second: Node) -> Node {
  Node { occurrence_identity: OccurrenceSynthetic, name: "", span: no_span(), ident_span: none, children: [
    Node { occurrence_identity: OccurrenceSynthetic, name: "first", span: kernel_span(name: "first"), ident_span: Present { value: kernel_span(name: "first") }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: first } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData },
    Node { occurrence_identity: OccurrenceSynthetic, name: "second", span: kernel_span(name: "second"), ident_span: Present { value: kernel_span(name: "second") }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: second } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
  ], connective: Conj, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
}

fn algebra_value_field(name: String, type_node: Node) -> Node {
  Node { occurrence_identity: OccurrenceSynthetic, name: name, span: kernel_span(name: name), ident_span: Present { value: kernel_span(name: name) }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: type_node } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
}

fn algebra_method_field(name: String, param_types: List<Node>, return_type: Node) -> Node {
  let params = param_types |> map(t => make_param_node(occurrence_identity: OccurrenceSynthetic, name: "_", type_expr: t, default_value: none, span: no_span(), name_span: no_span()))
  let callable = make_callable_type(func_params: params, ret: return_type)
  Node { occurrence_identity: OccurrenceSynthetic, name: name, span: kernel_span(name: name), ident_span: Present { value: kernel_span(name: name) }, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: callable } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
}

fn enrich_base_with_fields(name: String, base: Node, fields: List<Node>) -> Node {
  Node { occurrence_identity: base.occurrence_identity, name: name, span: base.span, ident_span: base.ident_span, children: fields, connective: Conj, params: base.params, inferred: base.inferred, return_cardinality: base.return_cardinality, uses: base.uses, body: base.body, transport: base.transport, properties: base.properties, type_annotation: base.type_annotation, is_self_recursive: base.is_self_recursive, has_non_tail_self_call: base.has_non_tail_self_call, match_pattern: base.match_pattern, module_item_kind: base.module_item_kind, declaration_marker: base.declaration_marker, declaration: base.declaration, expr_data: base.expr_data }
}

fn nominal_type_ref(name: String) -> Node {
  leaf_node_with_span(occurrence_identity: OccurrenceSynthetic, name: name, span: kernel_span(name: name))
}

// Positions are argument evidence only on the nominal application retained by
// the resolver and pattern binder. An expansion alone cannot recover them, so on an
// expansion the positional read below is UNSOUND and the diagnostic says so at the
// position it was asked for. It is carried at advisory severity rather than blocking
// because the evidence needed to answer correctly does not exist anywhere the caller
// can reach -- measured, not assumed: at the fold receiver in the emitted-call-target
// probe, base is the FreeMonoid COPRODUCT with params [T] and no argument, the
// receiver expression's own inferred type is that same un-applied node, and the record
// literal's field-inits carry no inferred type at all. Refusing there is a refusal the
// author cannot discharge. The positional value is returned unchanged from what the
// seed already returned, so nothing downstream moves; only the count is new.
// CORRECTED BY MEASUREMENT: "the evidence does not exist" holds at THIS seam, not upstream. At
// every site the class has fired on, an annotated twin of the same code is clean, so the argument
// was present in authored facts and an inference dropped it -- and the placeholder returned here
// for a dropped argument is the base itself, so the element is read as the container
// (gunbc.recurring_failure_mode unapplied_generic_accumulator_types_element_as_container). The
// repair is upstream at the dropping link; this seam stays advisory, with its ceiling row in
// gunbc.compile_clean_diagnostic_policy advisory_class_ceilings.
fn algebra_child_or_placeholder(base: Node, child_index: Int, placeholder: String) -> KernelTypeBuild {
  let evidence_diags = if base.connective != NoConnective {
    [make_error_node(
      diagnostic: AlgebraApplicationEvidenceUnavailable { receiver_type: base.name, argument_index: child_index, span: base.span },
      module_name: "v1.compiler.infer_types"
    )]
  } else { [] }
  match base.children |> enumerate |> filter(pair => pair.first == child_index) |> map(pair => pair.second) |> first {
    Present { value: child } => KernelTypeBuild { ty: child_type_node(ch: child), diagnostics: evidence_diags }
    Absent => KernelTypeBuild { ty: type_variable_node(id: placeholder), diagnostics: evidence_diags }
  }
}

fn instantiate_algebra_type(template: AlgebraTypeTemplate, base: Node, source_indices: Map<String, NewlineIndex>) -> KernelTypeBuild {
  match template {
    ReceiverSelf => KernelTypeBuild { ty: base, diagnostics: [] }
    ReceiverElement => algebra_child_or_placeholder(base: base, child_index: 0, placeholder: "T")
    ReceiverKey => algebra_child_or_placeholder(base: base, child_index: 0, placeholder: "K")
    ReceiverValue => algebra_child_or_placeholder(base: base, child_index: 1, placeholder: "V")
    NamedTemplate { name: n } => KernelTypeBuild { ty: nominal_type_ref(name: n), diagnostics: [] }
    AlgebraTypeVariable { id: var_id } => KernelTypeBuild { ty: type_variable_node(id: var_id), diagnostics: [] }
    ContainerOf { source: src, element: inner } =>
      let kind_name = match src { SameAsReceiver => container_kind_canonical(name: authored_name_at(source_indices: source_indices, node: base))  Named { name: n } => n }
      let inner_b = instantiate_algebra_type(template: inner, base: base, source_indices: source_indices)
      let built = make_container_type(kind_name: kind_name, element: inner_b.ty)
      KernelTypeBuild { ty: built.ty, diagnostics: concat(inner_b.diagnostics, built.diagnostics) }
    OptionalOf { inner: inner } =>
      let ib = instantiate_algebra_type(template: inner, base: base, source_indices: source_indices)
      KernelTypeBuild { ty: with_optional_cardinality(n: ib.ty), diagnostics: ib.diagnostics }
    WitnessOf { inner: inner } =>
      let ib = instantiate_algebra_type(template: inner, base: base, source_indices: source_indices)
      let built = make_container_type(kind_name: "Witness", element: ib.ty)
      KernelTypeBuild { ty: built.ty, diagnostics: concat(ib.diagnostics, built.diagnostics) }
    TupleOf { first: first, second: second } =>
      let fb = instantiate_algebra_type(template: first, base: base, source_indices: source_indices)
      let sb = instantiate_algebra_type(template: second, base: base, source_indices: source_indices)
      KernelTypeBuild { ty: make_tuple_type(first: fb.ty, second: sb.ty), diagnostics: concat(fb.diagnostics, sb.diagnostics) }
    CallableOf { params: p, return_type: r } =>
      let param_bs = p |> map(tp => instantiate_algebra_type(template: tp, base: base, source_indices: source_indices))
      let param_diags = param_bs |> flat_map(b => b.diagnostics)
      let param_nodes = param_bs |> map(b => b.ty)
      let rb = instantiate_algebra_type(template: r, base: base, source_indices: source_indices)
      KernelTypeBuild {
        ty: make_callable_type(func_params: param_nodes |> map(pn => make_param_node(occurrence_identity: OccurrenceSynthetic, name: "_", type_expr: pn, default_value: none, span: no_span(), name_span: no_span())), ret: rb.ty),
        diagnostics: concat(param_diags, rb.diagnostics)
      }
  }
}

fn instantiate_algebra_field(template: AlgebraFieldTemplate, base: Node, source_indices: Map<String, NewlineIndex>) -> KernelTypeBuild {
  let param_bs = template.param_types |> map(tp => instantiate_algebra_type(template: tp, base: base, source_indices: source_indices))
  let param_types = param_bs |> map(b => b.ty)
  let param_diags = param_bs |> flat_map(b => b.diagnostics)
  let return_b = instantiate_algebra_type(template: template.return_type, base: base, source_indices: source_indices)
  let field_ty = if param_types |> count > 0 {
    algebra_method_field(name: template.name, param_types: param_types, return_type: return_b.ty)
  } else {
    algebra_value_field(name: template.name, type_node: return_b.ty)
  }
  KernelTypeBuild { ty: field_ty, diagnostics: concat(param_diags, return_b.diagnostics) }
}

fn enrich_kernel_type(name: String, base: Node, source_indices: Map<String, NewlineIndex>) -> KernelTypeBuild {
  let profile = kernel_profile_lookup(name: name)
  match profile {
    Present { value: p } =>
      let field_bs = algebra_templates_for_profile(profile: p) |> map(template => instantiate_algebra_field(template: template, base: base, source_indices: source_indices))
      let fields = field_bs |> map(b => b.ty)
      let field_diags = field_bs |> flat_map(b => b.diagnostics)
      KernelTypeBuild { ty: enrich_base_with_fields(name: name, base: base, fields: fields), diagnostics: field_diags }
    Absent => KernelTypeBuild { ty: base, diagnostics: [] }
  }
}

// A CallableOf return variable binds to what a CALL of the argument produces: a lambda argument is
// typed as its body, a function value (named, or a let-bound lambda) as its arrow, so an arrow is
// read at its return.
fn unify_template(template: AlgebraTypeTemplate, concrete: Node, receiver: Node, subst: Map<String, Node>, source_indices: Map<String, NewlineIndex>) -> Map<String, Node> {
  match template {
    AlgebraTypeVariable { id: var_id } =>
      if map_get(subst, var_id) != none { subst }
      else { map_insert(subst, var_id, concrete) }
    ReceiverSelf =>
      let s1 = match concrete.children |> first {
        Present { value: k } =>
          if map_get(subst, "__key__") != none { subst } else { map_insert(subst, "__key__", child_type_node(ch: k)) }
        Absent => subst
      }
      match concrete.children |> skip(1) |> first {
        Present { value: v } =>
          if map_get(s1, "__value__") != none { s1 } else { map_insert(s1, "__value__", child_type_node(ch: v)) }
        Absent => s1
      }
    ReceiverKey =>
      if map_get(subst, "__key__") != none { subst }
      else { map_insert(subst, "__key__", concrete) }
    ReceiverValue =>
      if map_get(subst, "__value__") != none { subst }
      else { map_insert(subst, "__value__", concrete) }
    ReceiverElement =>
      if map_get(subst, "__element__") != none { subst }
      else { map_insert(subst, "__element__", concrete) }
    CallableOf { params: _, return_type: ret_template } =>
      let produced = match concrete.connective {
        Arrow => match concrete.inferred { Present { value: Resolved { node: r } } => r  _ => concrete }
        _ => concrete
      }
      unify_template(template: ret_template, concrete: produced, receiver: receiver, subst: subst, source_indices: source_indices)
    ContainerOf { source: src, element: elem_template } =>
      let expected_name = match src { SameAsReceiver => container_kind_canonical(name: authored_name_at(source_indices: source_indices, node: receiver))  Named { name: n } => n }
      if container_kind_canonical(name: authored_name_at(source_indices: source_indices, node: concrete)) != expected_name { subst }
      else {
        match concrete.children |> first {
          Present { value: child } => unify_template(template: elem_template, concrete: child_type_node(ch: child), receiver: receiver, subst: subst, source_indices: source_indices)
          Absent => subst
        }
      }
    OptionalOf { inner: inner_template } =>
      match concrete.children |> first {
        Present { value: child } => unify_template(template: inner_template, concrete: child_type_node(ch: child), receiver: receiver, subst: subst, source_indices: source_indices)
        Absent => subst
      }
    TupleOf { first: ft, second: st } =>
      let s2 = match concrete.children |> first {
        Present { value: c } => unify_template(template: ft, concrete: child_type_node(ch: c), receiver: receiver, subst: subst, source_indices: source_indices)
        Absent => subst
      }
      match concrete.children |> skip(1) |> first {
        Present { value: c } => unify_template(template: st, concrete: child_type_node(ch: c), receiver: receiver, subst: s2, source_indices: source_indices)
        Absent => s2
      }
    _ => subst
  }
}

fn is_receiver_self(t: AlgebraTypeTemplate) -> Bool {
  match t {
    ReceiverSelf => true
    _ => false
  }
}

fn build_type_substitution(param_templates: List<AlgebraTypeTemplate>, arg_types: List<Node>, receiver: Node, base_subst: Map<String, Node>, source_indices: Map<String, NewlineIndex>) -> Map<String, Node> {
  let first_is_self = match param_templates |> first {
    Present { value: t } => is_receiver_self(t: t)
    Absent => false
  }
  let non_receiver_templates = if first_is_self { param_templates |> skip(1) } else { param_templates }
  let pairs = non_receiver_templates |> enumerate |> filter(pair =>
    pair.first < (arg_types |> count)
  )
  pairs |> fold(init: base_subst, f: (subst, pair) =>
    let arg_type = match arg_types |> enumerate |> filter(ap => ap.first == pair.first) |> map(ap => ap.second) |> first {
      Present { value: a } => a
      Absent => error_type
    }
    unify_template(template: pair.second, concrete: arg_type, receiver: receiver, subst: subst, source_indices: source_indices)
  )
}

fn apply_type_substitution(template: AlgebraTypeTemplate, subst: Map<String, Node>, receiver: Node, source_indices: Map<String, NewlineIndex>) -> KernelTypeBuild {
  match template {
    AlgebraTypeVariable { id: var_id } =>
      match map_get(subst, var_id) {
        Present { value: resolved } => KernelTypeBuild { ty: resolved, diagnostics: [] }
        Absent => KernelTypeBuild { ty: type_variable_node(id: var_id), diagnostics: [] }
      }
    ReceiverSelf =>
      let receiver_name_str = container_kind_canonical(name: authored_name_at(source_indices: source_indices, node: receiver))
      let is_bare = is_container_type(name: receiver_name_str) && (receiver.children |> all(ch =>
        let inner = child_type_node(ch: ch)
        if inner.inferred != none { is_type_variable(inferred: inner.inferred.value) } else { inner.ident_span == none || !is_kernel_type(name: authored_name_at(source_indices: source_indices, node: inner)) }
      ))
      if is_bare {
        let arity = container_expected_arity(name: receiver_name_str)
        if arity == Present { value: 2 } {
          match map_get(subst, "__key__") {
            Present { value: key } =>
              let val = match map_get(subst, "__value__") {
                Present { value: v } => v
                Absent => type_variable_node(id: "V")
              }
              make_map_type(key: key, value: val)
            Absent => KernelTypeBuild { ty: receiver, diagnostics: [] }
          }
        } else if arity == Present { value: 1 } {
          match map_get(subst, "__element__") {
            Present { value: elem } => make_container_type(kind_name: container_kind_canonical(name: receiver_name_str), element: elem)
            Absent => KernelTypeBuild { ty: receiver, diagnostics: [] }
          }
        } else { KernelTypeBuild { ty: receiver, diagnostics: [] } }
      } else { KernelTypeBuild { ty: receiver, diagnostics: [] } }
    ReceiverElement =>
      match receiver.children |> first {
        Present { value: child } => KernelTypeBuild { ty: child_type_node(ch: child), diagnostics: [] }
        Absent =>
          match map_get(subst, "__element__") {
            Present { value: elem } => KernelTypeBuild { ty: elem, diagnostics: [] }
            Absent =>
              let rname = container_kind_canonical(name: authored_name_at(source_indices: source_indices, node: receiver))
              match container_param_name(kind_name: rname, index: 0) {
                Present { value: n } => KernelTypeBuild { ty: type_variable_node(id: n), diagnostics: [] }
                Absent =>
                  KernelTypeBuild {
                    ty: missing_kernel_container_profile_type(kind_name: rname),
                    diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: rname)]
                  }
              }
          }
      }
    ReceiverKey =>
      match receiver.children |> first {
        Present { value: child } => KernelTypeBuild { ty: child_type_node(ch: child), diagnostics: [] }
        Absent =>
          match map_get(subst, "__key__") {
            Present { value: key } => KernelTypeBuild { ty: key, diagnostics: [] }
            Absent =>
              let rname = container_kind_canonical(name: authored_name_at(source_indices: source_indices, node: receiver))
              match container_param_name(kind_name: rname, index: 0) {
                Present { value: n } => KernelTypeBuild { ty: type_variable_node(id: n), diagnostics: [] }
                Absent =>
                  KernelTypeBuild {
                    ty: missing_kernel_container_profile_type(kind_name: rname),
                    diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: rname)]
                  }
              }
          }
      }
    ReceiverValue =>
      match receiver.children |> skip(1) |> first {
        Present { value: child } => KernelTypeBuild { ty: child_type_node(ch: child), diagnostics: [] }
        Absent =>
          match map_get(subst, "__value__") {
            Present { value: val } => KernelTypeBuild { ty: val, diagnostics: [] }
            Absent =>
              let rname = container_kind_canonical(name: authored_name_at(source_indices: source_indices, node: receiver))
              match container_param_name(kind_name: rname, index: 1) {
                Present { value: n } => KernelTypeBuild { ty: type_variable_node(id: n), diagnostics: [] }
                Absent =>
                  KernelTypeBuild {
                    ty: missing_kernel_container_profile_type(kind_name: rname),
                    diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: rname)]
                  }
              }
          }
      }
    NamedTemplate { name: n } => KernelTypeBuild { ty: nominal_type_ref(name: n), diagnostics: [] }
    ContainerOf { source: src, element: inner } =>
      let kind_name = match src { SameAsReceiver => container_kind_canonical(name: authored_name_at(source_indices: source_indices, node: receiver))  Named { name: n } => n }
      let inner_applied = apply_type_substitution(template: inner, subst: subst, receiver: receiver, source_indices: source_indices)
      let built = make_container_type(kind_name: kind_name, element: inner_applied.ty)
      KernelTypeBuild { ty: built.ty, diagnostics: concat(inner_applied.diagnostics, built.diagnostics) }
    OptionalOf { inner: inner } =>
      let ib = apply_type_substitution(template: inner, subst: subst, receiver: receiver, source_indices: source_indices)
      KernelTypeBuild { ty: with_optional_cardinality(n: ib.ty), diagnostics: ib.diagnostics }
    WitnessOf { inner: inner } =>
      let ib = apply_type_substitution(template: inner, subst: subst, receiver: receiver, source_indices: source_indices)
      let built = make_container_type(kind_name: "Witness", element: ib.ty)
      KernelTypeBuild { ty: built.ty, diagnostics: concat(ib.diagnostics, built.diagnostics) }
    TupleOf { first: ft, second: st } =>
      let fb = apply_type_substitution(template: ft, subst: subst, receiver: receiver, source_indices: source_indices)
      let sb = apply_type_substitution(template: st, subst: subst, receiver: receiver, source_indices: source_indices)
      KernelTypeBuild { ty: make_tuple_type(first: fb.ty, second: sb.ty), diagnostics: concat(fb.diagnostics, sb.diagnostics) }
    CallableOf { params: p, return_type: r } =>
      let param_bs = p |> map(tp => apply_type_substitution(template: tp, subst: subst, receiver: receiver, source_indices: source_indices))
      let param_nodes = param_bs |> map(b => b.ty)
      let param_diags = param_bs |> flat_map(b => b.diagnostics)
      let rb = apply_type_substitution(template: r, subst: subst, receiver: receiver, source_indices: source_indices)
      KernelTypeBuild {
        ty: make_callable_type(func_params: param_nodes |> map(pn => make_param_node(occurrence_identity: OccurrenceSynthetic, name: "_", type_expr: pn, default_value: none, span: no_span(), name_span: no_span())), ret: rb.ty),
        diagnostics: concat(param_diags, rb.diagnostics)
      }
  }
}

fn template_return_is_receiver_self(template: AlgebraFieldTemplate) -> Bool {
  is_receiver_self(t: template.return_type)
}

fn template_return_has_variables(template: AlgebraFieldTemplate) -> Bool {
  has_type_variable(t: template.return_type)
}

fn has_type_variable(t: AlgebraTypeTemplate) -> Bool {
  match t {
    AlgebraTypeVariable { id: _ } => true
    ContainerOf { source: _, element: inner } => has_type_variable(t: inner)
    OptionalOf { inner: inner } => has_type_variable(t: inner)
    WitnessOf { inner: inner } => has_type_variable(t: inner)
    TupleOf { first: f, second: s } => has_type_variable(t: f) || has_type_variable(t: s)
    CallableOf { params: _, return_type: r } => has_type_variable(t: r)
    _ => false
  }
}

fn resolve_type_variables_from_template(template: AlgebraFieldTemplate, arg_types: List<Node>, receiver_type: Node, overrides: Map<String, Node>, source_indices: Map<String, NewlineIndex>) -> KernelTypeBuild {
  let subst = build_type_substitution(
    param_templates: template.param_types,
    arg_types: arg_types,
    receiver: receiver_type,
    base_subst: overrides,
    source_indices: source_indices
  )
  apply_type_substitution(template: template.return_type, subst: subst, receiver: receiver_type, source_indices: source_indices)
}

fn callable_inferred(n: Node) -> Node {
  let is_callable = n.params |> count > 0
  if is_callable {
    match n.inferred {
      Present { value: Resolved { node: ret } } =>
        if (ret.connective == Arrow) { ret } else { make_callable_type(func_params: n.params, ret: ret) }
      Absent => error_type
      _ => error_type
    }
  } else { n }
}

fn callable_return_type(n: Node) -> Node {
  if n.params |> count == 0 {
    match n.inferred {
      Present { value: Resolved { node: ret } } => ret
      _ => error_type
    }
  } else {
    match callable_inferred(n: n).inferred {
      Present { value: Resolved { node: callable } } =>
        match callable.inferred {
          Present { value: Resolved { node: ret } } => ret
          _ => error_type
        }
      _ => error_type
    }
  }
}

fn normalize_access_type_node(n: Node) -> Node {
  let has_structure = n.connective != NoConnective
  let unwrapped = if n.type_annotation != none && has_structure {
    n.children |> first
  } else { none }
  match unwrapped {
    Present { value: base } => normalize_access_type_node(n: base)
    Absent => n
  }
}

// AN APPLICATION RENDERS ITS ARGUMENTS in node_type_shape below, because without them the two
// sides of a type-ARGUMENT refusal print identically. Wrapper<KindB> at a Wrapper<KindA>
// position is a real refusal whose diagnostic read "declared 'Node(Wrapper)', produced
// 'Node(Wrapper)'" -- typed and located but carrying nothing a reader could act on, which is
// the located-but-uninformative half of DESIGN 5's typed-diagnostic duty. The container arm
// already renders its element for the same reason; this is that rule applied to the general
// application rather than a second idea.
fn node_type_shape_argument_list(args: List<Node>, source_indices: Map<String, NewlineIndex>) -> String {
  match args |> first {
    Present { value: a } =>
      let head = node_type_shape(n: child_type_node(ch: a), source_indices: source_indices)
      let rest = args |> skip(1)
      if (rest |> count) == 0 {
        head
      } else {
        concat(head, concat(",", node_type_shape_argument_list(args: rest, source_indices: source_indices)))
      }
    Absent => ""
  }
}

fn node_type_shape(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let __is_leaf = n.connective == NoConnective && n.children |> count == 0 && n.properties |> count == 0
  let n_name = authored_name_at(source_indices: source_indices, node: n)
  if __is_leaf {
    let __is_named_ref = match n.inferred {
      Present { value: Resolved { node: rt } } =>
        rt.connective == NoConnective && rt.children |> count == 0
          && rt.ident_span != none && authored_name_at(source_indices: source_indices, node: rt) != "None"
          && is_kernel_type(name: authored_name_at(source_indices: source_indices, node: rt)) == false
      _ => false
    }
    if __is_named_ref {
      concat("Named(", n_name, ")")
    } else {
      concat("Primitive(", n_name, ")")
    }
  } else if (n.connective == Arrow) {
    let codomain_shape = match n.inferred {
      Present { value: Resolved { node: ret } } => node_type_shape(n: ret, source_indices: source_indices)
      _ => "?"
    }
    let param_shapes = node_type_shape_argument_list(args: n.params |> map(p => param_node_type_expr(n: p)), source_indices: source_indices)
    concat("Callable(", param_shapes, "->", codomain_shape, ")")
  } else {
    let is_product = n.connective == Conj
    let is_coproduct = n.connective == Disj
    if is_product {
      if n.ident_span == none { "Product(<anon>)" } else { concat("Product(", n_name, ")") }
    } else if is_coproduct {
      if n.ident_span == none { "Coproduct(<anon>)" } else { concat("Coproduct(", n_name, ")") }
    } else {
      let __is_container = node_is_element_collection(n: n, source_indices: source_indices)
      let is_optional = n.return_cardinality == CardOptional
      let is_map = node_is_keyed_collection(n: n, source_indices: source_indices)
      if __is_container {
        let elem_shape = match n.children |> first {
          Present { value: el } => node_type_shape(n: child_type_node(ch: el), source_indices: source_indices)
          Absent => "?"
        }
        concat("Container(", n_name, ",", elem_shape, ")")
      } else if is_optional {
        let inner_shape = node_type_shape(n: with_required_cardinality(n: n), source_indices: source_indices)
        concat("Optional(", inner_shape, ")")
      } else if is_map {
        "Map(...)"
      } else if (n.children |> count) > 0 {
        concat("Node(", n_name, "<", node_type_shape_argument_list(args: n.children, source_indices: source_indices), ">)")
      } else {
        concat("Node(", n_name, ")")
      }
    }
  }
}

// The text judgment asks the corpus declaration index, which lives on the TypeEnv. The callers that do
// not ask are: v1.compiler.emit_info's variant field-summary builder (no census, and it asks whether a
// shared field has one type, not whether a value crosses a boundary); the callable-component ground
// check (callable values are the declared residue of gunbc.rung_drop text_boundary_identity_wall);
// and the witness binary's synthetic nodes.
// WHETHER A COMPARISON ASKS THE TEXT JUDGMENT IS A CLOSED CHOICE, NOT AN OPTIONAL ENV (review 72427).
// Every checker site passes TextJudgedIn with its env. A caller that does not ask must name WHY
// through a declared TextNotAskedReason; adding a caller that skips the wall means adding a variant
// here, where review sees it, never passing an absent value.
type TextJudgment
  = TextJudgedIn { env: TypeEnv }
  | TextNotAsked { reason: TextNotAskedReason }

type TextNotAskedReason
  = TextNotAskedInVariantFieldSummary
  | TextNotAskedForSyntheticWitnessNodes

fn text_crossing_in_judgment(left: Node, right: Node, text: TextJudgment) -> Bool {
  match text {
    TextJudgedIn { env: e } => text_crossing_by_identity(left: left, right: right, env: e)
    TextNotAsked { reason: _ } => false
  }
}

// CALLABILITY IS THE ARROW CONNECTIVE; A NON-EMPTY PARAMETER LIST IS SUFFICIENT, NEVER NECESSARY.
// Every callable value type is minted as an Arrow node (make_callable_type, parse_callable_type_expr),
// and a nullary `fn() -> R` is an Arrow with an empty parameter list. This predicate used to be
// `params |> count > 0` alone, which read "takes an argument" as "is a function type": every nullary
// function type answered false, so the call seam discarded a found nullary local and retried its
// name as a global ("function 'pick' not found in scope"), and the nominal brand checks below treated
// a nullary arrow as a named type. The params disjunct is kept because a declaration-shaped node
// carries its formals in params, and on such a node a non-empty list IS a callable fact.
// gunbc.recurring_failure_mode arity_proxy_for_callability_misroutes_a_found_local.
fn type_node_is_callable(n: Node) -> Bool {
  n.connective == Arrow || n.params |> count > 0
}

// THE TYPE AN APPLICATION OF A FIELD PRODUCES: a callable field type's codomain (an Arrow stores it
// in `inferred`), and any other field type itself -- a kernel nullary template is minted as a value
// field (`algebra_value_field`), so its type already is the application's. One read for every
// field-as-operation site (method call, binary-operator algebra field), so arity cannot stand in for
// callability at one of them while another asks the connective. Absent when the type is callable but
// records no codomain; each site keeps its own answer for that case. No Arrow reaches it, since
// `make_callable_type` and `parse_callable_type_expr` always record one.
fn applied_field_type(field_type: Node) -> Node? {
  if type_node_is_callable(n: field_type) {
    match field_type.inferred {
      Present { value: Resolved { node: codomain } } => Present { value: codomain }
      _ => none
    }
  } else { Present { value: field_type } }
}

fn node_declaration_file(n: Node) -> String {
  match n.ident_span {
    Present { value: sp } => sp.file
    Absent => ""
  }
}

fn node_declaration_identity(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  type_declaration_identity_key(
    decl_file: node_declaration_file(n: n),
    declared_name: authored_name_at(source_indices: source_indices, node: n))
}

// THE IDENTITY A REFERENCE CARRIES: a type application's resolved node is stamped with the
// declaration it applies (generic_declaration_application), and the reference reads it through
// `inferred`. A use-site reference's own span declares nothing, so the span join cannot recover it.
fn whole_declaration_carried(n: Node) -> DeclarationRef? {
  match n.declaration {
    Present { value: d } =>
      match d.field {
        WholeDeclaration => Present { value: d }
        NamedField { field_name: _ } => none
        TypeParameter { name: _ } => none
      }
    Absent => none
  }
}

fn declaration_carried_through_resolution(n: Node, hops: Int) -> DeclarationRef? {
  match whole_declaration_carried(n: n) {
    Present { value: d } => Present { value: d }
    Absent =>
      if hops <= 0 { none } else {
        match n.inferred {
          Present { value: Resolved { node: r } } => declaration_carried_through_resolution(n: r, hops: hops - 1)
          _ => none
        }
      }
  }
}

fn std_optional_declaration_ref() -> DeclarationRef {
  decl_ref(module_path: "std.optional", decl_name: "Optional")
}

// CANONICAL DeclarationRef EQUALITY against the one reference the kernel mint is bound to; no
// module-path or name part is compared on its own.
fn declaration_is_std_optional(d: DeclarationRef) -> Bool {
  d == std_optional_declaration_ref()
}

fn applied_arguments_identical(left_args: List<Node>, right_args: List<Node>, source_indices: Map<String, NewlineIndex>) -> Bool {
  arguments_agree_in_lockstep(left_args: left_args, right_args: right_args, agree: (l, r) => applied_argument_types_identical(left: l, right: r, source_indices: source_indices))
}

// ONE LOCKSTEP WALK for every pairwise relation over two argument lists (identity here, equality in
// the two-applied branch of node_type_equals_core): each list is peeled once, so the cost is linear in the arity.
fn arguments_agree_in_lockstep(left_args: List<Node>, right_args: List<Node>, agree: fn(Node, Node) -> Bool) -> Bool {
  match left_args |> first {
    Present { value: l } =>
      match right_args |> first {
        Present { value: r } =>
          agree(child_type_node(ch: l), child_type_node(ch: r))
            && arguments_agree_in_lockstep(left_args: left_args |> skip(1), right_args: right_args |> skip(1), agree: agree)
        Absent => false
      }
    Absent => right_args |> count == 0
  }
}

// AN APPLIED ARGUMENT AGREES BY IDENTITY, NEVER BY COMPATIBILITY. node_type_compatible is wider
// than identity on purpose: it admits a compiler-error side, an unresolved type variable, an
// optional against a unit, and a non-container application by its head name alone. None of those
// may stand as "the same instantiation" here, so this relation does not consult it. Two arguments
// are identical when their cardinality is equal, their heads are identical, and every applied
// argument is identical in turn.
fn applied_argument_types_identical(left: Node, right: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  left.return_cardinality == right.return_cardinality
    && applied_argument_heads_identical(left: left, right: right, source_indices: source_indices)
    && (left.children |> count) == (right.children |> count)
    && applied_arguments_identical(left_args: left.children, right_args: right.children, source_indices: source_indices)
}

// A HEAD IS IDENTICAL BY THE STRONGEST IDENTITY BOTH SIDES CARRY. A callable compares its whole
// signature under this same relation. A compiler-error side is never identical to anything. A type
// variable is identical only to the same owner's parameter (type_variables_identical_by_owner). Otherwise two carried whole-declaration refs must
// be equal; with no carried ref on either side, the reference identities (type_reference_identity's
// declaring file and declared name) must be equal and name something. One side carrying a ref and
// the other not declines, so the join stays refused.
fn applied_argument_heads_identical(left: Node, right: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  if type_node_is_callable(n: left) || type_node_is_callable(n: right) {
    type_node_is_callable(n: left) && type_node_is_callable(n: right)
      && callable_signatures_agree(left: left, right: right, agree: (a, b) => applied_argument_types_identical(left: a, right: b, source_indices: source_indices))
  } else {
    match left.inferred {
      Present { value: CompilerError { message: _, span: _ } } => false
      Present { value: TypeVariable { id: left_id } } =>
        match right.inferred {
          Present { value: TypeVariable { id: right_id } } =>
            type_variables_identical_by_owner(left: left, right: right, left_id: left_id, right_id: right_id)
          _ => false
        }
      _ =>
        match right.inferred {
          Present { value: CompilerError { message: _, span: _ } } => false
          Present { value: TypeVariable { id: _ } } => false
          _ =>
            match whole_declaration_carried(n: left) {
              Present { value: l } =>
                match whole_declaration_carried(n: right) {
                  Present { value: r } => declaration_ref_eq(a: l, b: r)
                  Absent => false
                }
              Absent =>
                match whole_declaration_carried(n: right) {
                  Present { value: _ } => false
                  Absent =>
                    match type_reference_identity_key(n: left, source_indices: source_indices) {
                      Present { value: li } =>
                        match type_reference_identity_key(n: right, source_indices: source_indices) {
                          Present { value: ri } => li == ri
                          Absent => false
                        }
                      Absent => false
                    }
                }
            }
        }
    }
  }
}

// A TYPE VARIABLE IS ITS OWNER'S PARAMETER, NOT ITS SPELLING. The resolver stamps a reference to a
// declaration's own parameter with a TypeParameter declaration ref naming that owner, so two `T`s
// from different declarations carry different refs. Both carrying a ref compares the refs; only two
// unowned synthetic variables fall back to the bare id; one owned and one unowned declines.
fn type_variables_identical_by_owner(left: Node, right: Node, left_id: String, right_id: String) -> Bool {
  match left.declaration {
    Present { value: l } =>
      match right.declaration {
        Present { value: r } => declaration_ref_eq(a: l, b: r)
        Absent => false
      }
    Absent =>
      match right.declaration {
        Present { value: _ } => false
        Absent => left_id == right_id
      }
  }
}

// type_reference_identity's key, refused when the reference names nothing: an empty declared name
// would make every unnamed reference in one file identical to every other.
fn type_reference_identity_key(n: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  let target = match n.inferred {
    Present { value: Resolved { node: rt } } => rt
    _ => n
  }
  if authored_name_at(source_indices: source_indices, node: target) == "" {
    none
  } else {
    Present { value: node_declaration_identity(n: target, source_indices: source_indices) }
  }
}

// ONE TYPE, TWO REPRESENTATIONS (gunbc.recurring_failure_mode optional_equality_answers_by_representation):
// `T?` is the payload type carrying CardOptional, and `Optional<P>` is the std.optional coproduct
// applied to P. They are the same type exactly when P is identical to T's required form. Identity,
// never compatibility, for the payload: a compiler-error side, a type variable or a unit must not
// stand as "the same payload". Every other pairing of an optional leaf with a required type stays
// refused by the `left_opt || right_opt` arm below.
fn optional_instance_at_payload_of(leaf: Node, instance: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  if instance.return_cardinality != Required { false }
  else {
    match declaration_carried_through_resolution(n: instance, hops: 3) {
      Present { value: d } =>
        declaration_is_std_optional(d: d)
          && (instance.children |> count) == 1
          && match instance.children |> first {
            Present { value: ch } => applied_argument_types_identical(left: with_required_cardinality(n: leaf), right: child_type_node(ch: ch), source_indices: source_indices)
            Absent => false
          }
      Absent => false
    }
  }
}

fn node_type_compatible(left: Node, right: Node, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> Bool {
  let left_err = if left.inferred != none { is_compiler_error(inferred: left.inferred.value) } else { false }
  let right_err = if right.inferred != none { is_compiler_error(inferred: right.inferred.value) } else { false }
  let left_tv = if left.inferred != none { is_type_variable(inferred: left.inferred.value) } else { false }
  let right_tv = if right.inferred != none { is_type_variable(inferred: right.inferred.value) } else { false }
  let left_opt = left.return_cardinality == CardOptional
  let right_opt = right.return_cardinality == CardOptional
  let right_is_unit = is_unit_like(n: right)
  let left_is_unit = is_unit_like(n: left)
  if left_err || right_err { true }
  else if left_tv || right_tv { true }
  else if text_crossing_in_judgment(left: left, right: right, text: text) { false }
  else if left_opt && right_is_unit { true }
  else if left_is_unit && right_opt { true }
  else if left.connective == Arrow && (right.connective == Arrow) {
    callable_signatures_agree(left: left, right: right, agree: (a, b) => node_type_compatible(left: a, right: b, source_indices: source_indices, text: text))
  }
  else {
    let left_is_container = node_is_element_collection(n: left, source_indices: source_indices)
    let right_is_container = node_is_element_collection(n: right, source_indices: source_indices)
    if left_is_container && right_is_container {
      if canonical_template_name(n: left, source_indices: source_indices) != canonical_template_name(n: right, source_indices: source_indices) { false }
      else {
        match left.children |> first {
          Present { value: left_ch } =>
            match right.children |> first {
              Present { value: right_ch } =>
                let left_el = join_element_type(slot: left_ch)
                let right_el = join_element_type(slot: right_ch)
                let left_el_is_unit = is_unit_like(n: left_el)
                let right_el_is_unit = is_unit_like(n: right_el)
                if left_el_is_unit || right_el_is_unit { true }
                else { node_type_compatible(left: left_el, right: right_el, source_indices: source_indices, text: text) }
              Absent => true
            }
          Absent => true
        }
      }
    }
    else if (((canonical_template_name(n: left, source_indices: source_indices) == canonical_template_name(n: right, source_indices: source_indices))
      && (authored_name_at(source_indices: source_indices, node: left) != authored_name_at(source_indices: source_indices, node: right)))
      && (left.children |> count == 1)) && (right.children |> count == 1)
      && (is_declared_container_alias_spelling(name: authored_name_at(source_indices: source_indices, node: left))
        || is_declared_container_alias_spelling(name: authored_name_at(source_indices: source_indices, node: right))) {

      match left.children |> first {
        Present { value: left_ch } =>
          match right.children |> first {
            Present { value: right_ch } =>
              let left_el = join_element_type(slot: left_ch)
              let right_el = join_element_type(slot: right_ch)
              if is_unit_like(n: left_el) || is_unit_like(n: right_el) { true }
              else { node_type_compatible(left: left_el, right: right_el, source_indices: source_indices, text: text) }
            Absent => true
          }
        Absent => true
      }
    }
    else if left_opt && right_opt {
      let left_inner = with_required_cardinality(n: left)
      let right_inner = with_required_cardinality(n: right)
      let left_inner_is_unit = is_unit_like(n: left_inner)
      let right_inner_is_unit = is_unit_like(n: right_inner)
      if left_inner_is_unit || right_inner_is_unit { true }
      else { node_type_compatible(left: left_inner, right: right_inner, source_indices: source_indices, text: text) }
    }
    else if (left_opt && optional_instance_at_payload_of(leaf: left, instance: right, source_indices: source_indices))
      || (right_opt && optional_instance_at_payload_of(leaf: right, instance: left, source_indices: source_indices)) { true }
    else if left_opt || right_opt { false }
    else {
      type_name_compatible(a: authored_name_at(source_indices: source_indices, node: left), b: authored_name_at(source_indices: source_indices, node: right))
        || alias_identity_in_judgment(left: left, right: right, source_indices: source_indices, text: text)
    }
  }
}

// A DECLARED APPLICATION IS JUDGED AT EVERY ARGUMENT POSITION, NOT BY ITS HEAD. Two applications of
// one container template (List<A> against List<B>, Map<K, V> against Map<K2, V2>) agree only when
// every argument pair agrees, compared positionally and recursively, each argument read through the
// one routed read (generic_actual_position_type, the read #15132 put at the generic binding) and each
// leaf through node_type_compatible, which owns alias identity. Before this rule the declared-position
// judgment compared the first child of an element collection one level deep and accepted every keyed
// collection unjudged, so `let q: Map<Bool, Bool> = m` over a Map<String, Int> was accepted and
// emitted (gunbc.recurring_failure_mode a_declared_container_type_is_checked_by_head_only).
// THREE-VALUED, because a position holding a type variable or a compiler error is not evidence of
// agreement: such a position is ArgumentsUndecided, but a concrete disagreement at a SIBLING position
// still refuses -- an unsolved K does not license a wrong V. The recursion descends the finite type
// tree, one child per step.
type ApplicationArgumentsVerdict = ArgumentsAgree | ArgumentsDisagree | ArgumentsUndecided | NotAnApplicationPair

fn application_arguments_verdict(declared: Node, produced: Node, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> ApplicationArgumentsVerdict {
  let both_collections = node_is_collection(n: declared, source_indices: source_indices)
    && node_is_collection(n: produced, source_indices: source_indices)
  if !both_collections || declared.return_cardinality != produced.return_cardinality { NotAnApplicationPair }
  else if canonical_template_name(n: declared, source_indices: source_indices) != canonical_template_name(n: produced, source_indices: source_indices) { ArgumentsDisagree }
  else if (declared.children |> count) != (produced.children |> count) { ArgumentsDisagree }
  else { application_argument_pairs_verdict(declared: declared.children, produced: produced.children, acc: ArgumentsAgree, source_indices: source_indices, text: text) }
}

fn application_argument_pairs_verdict(declared: List<Node>, produced: List<Node>, acc: ApplicationArgumentsVerdict, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> ApplicationArgumentsVerdict {
  match declared |> first {
    Absent => acc
    Present { value: d } =>
      match produced |> first {
        Absent => acc
        Present { value: p } =>
          match application_argument_verdict(
              declared: generic_actual_position_type(slot: join_element_type(slot: d)),
              produced: generic_actual_position_type(slot: join_element_type(slot: p)),
              source_indices: source_indices, text: text) {
            ArgumentsDisagree => ArgumentsDisagree
            ArgumentsUndecided => application_argument_pairs_verdict(declared: declared |> skip(1), produced: produced |> skip(1), acc: ArgumentsUndecided, source_indices: source_indices, text: text)
            _ => application_argument_pairs_verdict(declared: declared |> skip(1), produced: produced |> skip(1), acc: acc, source_indices: source_indices, text: text)
          }
      }
  }
}

fn type_node_is_opaque_argument(n: Node) -> Bool {
  match n.inferred {
    Present { value: v } => is_type_variable(inferred: v) || is_compiler_error(inferred: v)
    Absent => false
  }
}

fn application_argument_verdict(declared: Node, produced: Node, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> ApplicationArgumentsVerdict {
  if type_node_is_opaque_argument(n: declared) || type_node_is_opaque_argument(n: produced) || is_unit_like(n: declared) || is_unit_like(n: produced) { ArgumentsUndecided }
  else {
    match application_arguments_verdict(declared: declared, produced: produced, source_indices: source_indices, text: text) {
      NotAnApplicationPair =>
        if node_type_compatible(left: declared, right: produced, source_indices: source_indices, text: text) { ArgumentsAgree } else { ArgumentsDisagree }
      v => v
    }
  }
}

fn alias_identity_in_judgment(left: Node, right: Node, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> Bool {
  match text {
    TextJudgedIn { env: e } =>
      alias_settled_agree(left: left, right: right, source_indices: source_indices, env: e,
        agree: (a, b) => applied_argument_agrees(left: child_type_node(ch: a), right: child_type_node(ch: b), source_indices: source_indices, text: text))
    TextNotAsked { reason: _ } => false
  }
}

// The name-only entry of the same relation: a seam holding only two spellings reads each as the declaration it names and settles them
// exactly as alias_identity_in_judgment settles two nodes, arguments judged by the same rule.
fn alias_names_identity_in_judgment(left: String, right: String, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> Bool {
  match text {
    TextJudgedIn { env: e } =>
      alias_names_settled_agree(left: left, right: right, source_indices: source_indices, env: e,
        agree: (a, b) => applied_argument_agrees(left: child_type_node(ch: a), right: child_type_node(ch: b), source_indices: source_indices, text: text))
    TextNotAsked { reason: _ } => false
  }
}

// An applied argument of an alias-settled pair is judged by the declaration it settles to, under the same declared-arity rule as the
// top level (alias_settled_agree): identical head, and for a parameterized head every argument agrees in turn, a side exposing none
// refusing. Only an argument that names no declaration (a kernel scalar, a container, a type variable) falls to node_type_compatible,
// which owns those kernel readings; node_type_compatible alone would pass `Inner<Int>` for `Inner<Bool>` by head name.
// Identity the compatibility relation cannot give: a cardinality difference, a compiler-error side and a type variable are each
// decided here and never reach node_type_compatible, which admits all three. A type variable is identical only to the same owner's
// parameter (two carried declaration refs compare equal); two unowned synthetic variables compare their bare id; one owned and one
// unowned decline. Answers none for every other pair.
fn applied_argument_opaque_identity(left: Node, right: Node) -> Bool? {
  if left.return_cardinality != right.return_cardinality { return Present { value: false } }
  match left.inferred {
    Present { value: CompilerError { message: _, span: _ } } => Present { value: false }
    Present { value: TypeVariable { id: left_id } } =>
      match right.inferred {
        Present { value: TypeVariable { id: right_id } } =>
          match left.declaration {
            Present { value: l } =>
              match right.declaration {
                Present { value: r } => Present { value: declaration_ref_eq(a: l, b: r) }
                Absent => Present { value: false }
              }
            Absent =>
              match right.declaration {
                Present { value: _ } => Present { value: false }
                Absent => Present { value: left_id == right_id }
              }
          }
        _ => Present { value: false }
      }
    _ =>
      match right.inferred {
        Present { value: CompilerError { message: _, span: _ } } => Present { value: false }
        Present { value: TypeVariable { id: _ } } => Present { value: false }
        _ => none
      }
  }
}

fn applied_argument_agrees(left: Node, right: Node, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> Bool {
  match applied_argument_opaque_identity(left: left, right: right) {
    Present { value: verdict } => verdict
    Absent => applied_argument_declared_agrees(left: left, right: right, source_indices: source_indices, text: text)
  }
}

fn applied_argument_declared_agrees(left: Node, right: Node, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> Bool {
  match text {
    TextJudgedIn { env: e } =>
      match settled_type(n: left, source_indices: source_indices, env: e, fuel: 16) {
        Absent => node_type_compatible(left: left, right: right, source_indices: source_indices, text: text)
        Present { value: _ } =>
          match settled_type(n: right, source_indices: source_indices, env: e, fuel: 16) {
            Absent => node_type_compatible(left: left, right: right, source_indices: source_indices, text: text)
            Present { value: _ } =>
              alias_settled_agree(left: left, right: right, source_indices: source_indices, env: e,
                agree: (a, b) => applied_argument_agrees(left: child_type_node(ch: a), right: child_type_node(ch: b), source_indices: source_indices, text: text))
          }
      }
    TextNotAsked { reason: _ } => node_type_compatible(left: left, right: right, source_indices: source_indices, text: text)
  }
}

fn prefer_specific_type(left: Node, right: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  let left_is_container = node_is_element_collection(n: left, source_indices: source_indices)
  let left_is_optional = left.return_cardinality == CardOptional
  let left_first_child = left.children |> first
  let left_norm_name = authored_name_at(source_indices: source_indices, node: left)
  let left_is_unit_inner = if left_is_container {
    match left_first_child {
      Present { value: ch } =>
        let el = child_type_node(ch: ch)
        let el_is_unit = is_unit_like(n: el)
        el_is_unit
      Absent => false
    }
  } else if left_is_optional {
    let left_is_unit = is_unit_like(n: left)
    left_is_unit
  } else { false }
  let right_is_container = node_is_element_collection(n: right, source_indices: source_indices)
  let right_is_optional = right.return_cardinality == CardOptional
  let same_kind = if left_is_container && right_is_container {
    left_norm_name == authored_name_at(source_indices: source_indices, node: right)
  } else if left_is_optional && right_is_optional {
    true
  } else { false }
  if same_kind && left_is_unit_inner { right }
  else if is_fully_resolved(n: right, source_indices: source_indices) && !is_fully_resolved(n: left, source_indices: source_indices) { right }
  else if left.connective == NoConnective && left.children |> count == 0
    && (right.connective != NoConnective || right.children |> count > 0)
    && type_name_compatible(a: left_norm_name, b: authored_name_at(source_indices: source_indices, node: right)) { right }
  else { left }
}

fn node_type_equals(left: Node, right: Node, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> Bool {
  let left_err = if left.inferred != none { is_compiler_error(inferred: left.inferred.value) } else { false }
  let right_err = if right.inferred != none { is_compiler_error(inferred: right.inferred.value) } else { false }
  let left_tv = if left.inferred != none { is_type_variable(inferred: left.inferred.value) } else { false }
  let right_tv = if right.inferred != none { is_type_variable(inferred: right.inferred.value) } else { false }
  let left_opt = left.return_cardinality == CardOptional
  let right_opt = right.return_cardinality == CardOptional
  let right_is_unit_eq = is_unit_like(n: right)
  let left_is_unit_eq = is_unit_like(n: left)
  if left_err || right_err { true }
  else if left_tv && right_tv { true }
  else if left_tv || right_tv { false }
  else if left_opt && right_is_unit_eq { true }
  else if left_is_unit_eq && right_opt { true }
  else if left_opt && right_opt {
    node_type_equals_core(left: with_required_cardinality(n: left), right: with_required_cardinality(n: right), source_indices: source_indices, text: text)
  }
  else {
    node_type_equals_core(left: left, right: right, source_indices: source_indices, text: text)
  }
}

// TEXT REPRESENTATIONS ARE COMPARED BY THE DECLARATION THEY RESOLVE TO, NOT BY SPELLING (XL-0T
// ruling B; gunbc.rung_drop text_boundary_identity_wall; review 72252). Kernel String is host text
// and std.algebra FreeMonoid over std.types Char is a code-point sequence; v1.compiler.infer_env
// text_crossing_by_identity reads each side's declaration by its declaring span or qualified name,
// never by re-resolving the spelling in this comparison's scope, and refuses an IDENTIFIED host-text /
// code-point pairing before any leaf-name arm can match `String` against `String`. A side with no
// readable identity is NOT judged here: base compatibility decides it, v1.compiler.infer
// text_unjudged_advisories counts it, and gunbc.rung_drop text_boundary_identity_wall bounds it.
// That is why these relations carry the TypeEnv: the corpus-wide declaration index lives there. A kernel LITERAL never reaches this
// point at a code-point-sequence boundary -- v1.compiler.infer literal_boundary_elaboration has
// already replaced it with its unfold image, typed as the destination -- so what this refuses is
// exactly the NON-literal crossing, which has no declared route. The wall was once landed in these
// arms and withdrawn because dag/gunbc/roadmap/roadmap_page.dag script_src_attr joined a
// std.string_type String field against a kernel "" and refused. That join was a real crossing
// hidden by a nickname: std.markup meant host text and imported the structural declaration. The
// import is deleted, the join is kernel against kernel, and nothing here exempts it.
// A CALLABLE SIGNATURE IS ITS ARITY, ITS PARAMETER TYPES AND ITS CODOMAIN -- one relation over
// them, parameterised by the component relation, so equality and compatibility cannot drift apart.
// The signature lives in params and inferred, never in children, which is why an Arrow must be
// asked here rather than through the childless-structural arm: that arm compared two Arrows by
// the name "Callable" alone, so `List<fn() -> Int>` and `List<fn() -> String>` compared equal once
// v1.compiler.infer_types child_type_node stopped erasing the arrow to its codomain.
fn callable_signatures_agree(left: Node, right: Node, agree: fn(Node, Node) -> Bool) -> Bool {
  if left.params |> count != right.params |> count { false }
  else {
    let params_agree = left.params |> enumerate |> all(pair =>
      match right.params |> skip(pair.first) |> first {
        Present { value: right_param } => agree(param_node_type_expr(n: pair.second), param_node_type_expr(n: right_param))
        Absent => false
      }
    )
    if params_agree == false { false }
    else {
      match left.inferred {
        Present { value: Resolved { node: left_ret } } =>
          match right.inferred {
            Present { value: Resolved { node: right_ret } } => agree(left_ret, right_ret)
            Absent => false
            _ => false
          }
        Absent => right.inferred == none
        _ => false
      }
    }
  }
}

// AN APPLICATION AGAINST A NON-APPLIED SPELLING IS NOT EQUALITY (gunbc.recurring_failure_mode optional_equality_answers_by_representation).
// Box<Int> against Box<Bool>'s expansion, a leaf, a bare generic or a field list: head identity separates declarations, never the
// arguments applied to one, and a non-applied side retains no arguments to compare (slots were replaced by name and the declared
// parameter list cleared, so nothing records which parameter supplied which occurrence). The branch refuses whatever the application's
// inferred state is: a stripped or absent expansion must not reopen a comparison against the other side's fields or variants.
// Two APPLIED spellings still descend element-wise above, so FreeMonoid<Int> against FreeMonoid<Bool> keeps refusing. Admitting the
// mixed case would be an instantiation relation, not equality; the rung that would (a retained-instantiation carrier on the expansion,
// trigger: a consumer needs application-vs-expansion equality) is named on that row.
// APPLIED-vs-APPLIED IDENTITY (lands as #14056; measured on the PR-2 vehicle): two applied nodes are the
// same applied type when their HEADS are one declaration. With both sides stamped the stamps decide; when a
// side carries no stamp it is resolved through the judging env to its alias-resolved head declaration and the
// heads compare. A side that resolves to no declaration keeps the existing refusal - there is deliberately no
// spelling fallback: identity comes from the declaration, never from printed text
// (gunbc.rung_drop.text_boundary_identity_wall; DESIGN section 5 forbids the silent widen).
fn applied_head_identity_agrees(left: Node, right: Node, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> Bool {
  let both_stamped = match left.declaration {
    Present { value: ld } =>
      match right.declaration {
        Present { value: rd } => Present { value: ld.module_path == rd.module_path && ld.decl_name == rd.decl_name }
        Absent => Absent
      }
    Absent => Absent
  }
  match both_stamped {
    Present { value: stamped_agree } => stamped_agree
    Absent =>
      match text {
        TextJudgedIn { env: e } =>
          match settled_type(n: left, source_indices: source_indices, env: e, fuel: 16) {
            Absent => false
            Present { value: ls } =>
              match settled_type(n: right, source_indices: source_indices, env: e, fuel: 16) {
                Absent => false
                Present { value: rs } => ls.head.module_path == rs.head.module_path && ls.head.decl_name == rs.head.decl_name
              }
          }
        TextNotAsked { reason: _ } => false
      }
  }
}

fn node_type_equals_core(left: Node, right: Node, source_indices: Map<String, NewlineIndex>, text: TextJudgment) -> Bool {
  if text_crossing_in_judgment(left: left, right: right, text: text) {
    false
  } else if left.connective == Arrow || (right.connective == Arrow) {
    left.connective == right.connective
      && callable_signatures_agree(left: left, right: right, agree: (a, b) => node_type_equals(left: a, right: b, source_indices: source_indices, text: text))
  } else {
  let left_leaf = left.connective == NoConnective && left.children |> count == 0 && left.properties |> count == 0
  let right_leaf = right.connective == NoConnective && right.children |> count == 0 && right.properties |> count == 0
  let left_struct = left.connective != NoConnective
  let right_struct = right.connective != NoConnective
  let left_applied = left.connective == NoConnective && !left_leaf
  let right_applied = right.connective == NoConnective && !right_leaf
  let left_name = authored_name_at(source_indices: source_indices, node: left)
  let right_name = authored_name_at(source_indices: source_indices, node: right)
  if left_leaf && right_leaf {
    type_name_compatible(a: left_name, b: right_name)
  }
  else if left_struct && right_struct {
    if !type_name_compatible(a: left_name, b: right_name) { false }
    else if (left.connective == Conj) != (right.connective == Conj) { false }
    else if left.children |> count != right.children |> count { false }
    else {
      left.children |> enumerate |> all(pair =>
        match right.children |> skip(pair.first) |> first {
          Present { value: right_child } => node_type_equals(left: pair.second, right: right_child, source_indices: source_indices, text: text)
          Absent => false
        }
      )
    }
  }
  else if left_leaf && right_struct {
    type_name_compatible(a: left_name, b: right_name)
  }
  else if left_struct && right_leaf {
    type_name_compatible(a: left_name, b: right_name)
  }
  else if (left_applied && (right_leaf || right_struct)) || (right_applied && (left_leaf || left_struct)) {
    false
  }
  else {
    let left_is_container = node_is_element_collection(n: left, source_indices: source_indices)
    let right_is_container = node_is_element_collection(n: right, source_indices: source_indices)
    if left_is_container && right_is_container {
      if left_name != right_name { false }
      else {
        match left.children |> first {
          Present { value: left_ch } =>
            match right.children |> first {
              Present { value: right_ch } => node_type_equals(left: child_type_node(ch: left_ch), right: child_type_node(ch: right_ch), source_indices: source_indices, text: text)
              Absent => false
            }
          Absent => false
        }
      }
    }
    else {
      let both_maps = node_is_keyed_collection(n: left, source_indices: source_indices) && node_is_keyed_collection(n: right, source_indices: source_indices)
      if both_maps {
        if left.children |> count == 2 && right.children |> count == 2 {
          match left.children |> first {
            Present { value: left_first } =>
              match right.children |> first {
                Present { value: right_first } =>
                  match left.children |> skip(1) |> first {
                    Present { value: left_second } =>
                      match right.children |> skip(1) |> first {
                        Present { value: right_second } =>
                          node_type_equals(left: child_type_node(ch: left_first), right: child_type_node(ch: right_first), source_indices: source_indices, text: text) && node_type_equals(left: child_type_node(ch: left_second), right: child_type_node(ch: right_second), source_indices: source_indices, text: text)
                        Absent => false
                      }
                    Absent => false
                  }
                Absent => false
              }
            Absent => false
          }
        } else {
          false
        }
      }
      else if left.params |> count > 0 && right.params |> count > 0 {
        callable_signatures_agree(left: left, right: right, agree: (a, b) => node_type_equals(left: a, right: b, source_indices: source_indices, text: text))
      }
      else if applied_head_identity_agrees(left: left, right: right, source_indices: source_indices, text: text) {
        left.children |> count == right.children |> count
          && left.children |> enumerate |> all(pair =>
            match right.children |> skip(pair.first) |> first {
              Present { value: right_child } => node_type_equals(left: child_type_node(ch: pair.second), right: child_type_node(ch: right_child), source_indices: source_indices, text: text)
              Absent => false
            }
          )
      }
      else {
        false
      }
    }
  }
  }
}

fn node_type_deps(n: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let n_is_type_var = if n.inferred != none { is_type_variable(inferred: n.inferred.value) } else { false }
  if n_is_type_var { return [] }
  let __is_named_ref = if n.inferred == none { false }
  else {
    match n.inferred {
      Present { value: Resolved { node: rt } } =>
        rt.connective == NoConnective && rt.children |> count == 0
          && rt.ident_span != none && authored_name_at(source_indices: source_indices, node: rt) != "None"
          && is_kernel_type(name: authored_name_at(source_indices: source_indices, node: rt)) == false
      _ => false
    }
  }
  let has_structure = n.connective != NoConnective
  let n_name = authored_name_at(source_indices: source_indices, node: n)
  if __is_named_ref {
    match n.inferred { Present { value: Resolved { node: rt } } => [authored_name_at(source_indices: source_indices, node: rt)]  _ => [] }
  } else if has_structure {
    flat_map(n.children, child =>
      match child.inferred {
        Present { value: Resolved { node: rt } } => node_type_deps(n: rt, source_indices: source_indices)
        _ => if child.inferred == none { node_type_deps(n: child, source_indices: source_indices) } else { [] }
      }
    )
  } else if n.inferred != none {
    match n.inferred { Present { value: Resolved { node: rt } } => node_type_deps(n: rt, source_indices: source_indices)  _ => [] }
  } else if n.children |> count > 0 {
    let child_deps = flat_map(n.children, child => node_type_deps(n: child, source_indices: source_indices))
    if n.ident_span != none && is_kernel_type(name: n_name) == false {
      concat([n_name], child_deps)
    } else { child_deps }
  } else if is_kernel_type(name: n_name) || n_name == "None" || n.ident_span == none {
    []
  } else {
    [n_name]
  }
}

fn infer_literal_node(lit: LiteralValue) -> Node {
  match lit {
    LitStr { value: _ } => string_type
    LitInt { value: _ } => int_type
    LitFloat { value: _ } => float_type
    LitBool { value: _ } => bool_type
    LitNull => with_optional_cardinality(n: unit_type)

    LitSymbol { value: _ } => symbol_type
  }
}

fn method_receiver_element_node(receiver_type: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  let normed = normalize_access_type_node(n: receiver_type)
  let maybe_element = if node_is_keyed_collection(n: normed, source_indices: source_indices) {
    match normed.children |> skip(1) |> first {
      Present { value: ch } => Present { value: child_type_node(ch: ch) }
      Absent => none
    }
  } else if normed.connective == NoConnective && normed.children |> count == 1 {
    match normed.children |> first {
      Present { value: ch } => Present { value: child_type_node(ch: ch) }
      Absent => none
    }
  } else {
    none
  }
  match maybe_element {
    Present { value: el } => el
    Absent => receiver_type
  }
}

fn extract_optional_inner_node(n: Node) -> Node {
  let is_optional = n.return_cardinality == CardOptional
  if is_optional {
    with_required_cardinality(n: n)
  } else if n.name == "Optional" && n.children |> count == 1 {
    match n.children |> first {
      Present { value: inner } => inner
      Absent => n
    }
  } else { n }
}

fn algebra_field_kind_name(kind: AlgebraFieldKind) -> String {
  match kind {
    AlgAdd => "add"
    AlgMul => "mul"
    AlgReciprocal => "reciprocal"
    AlgQuotient => "quotient"
    AlgRemainder => "remainder"
    AlgCompare => "compare"
    AlgMeet => "meet"
    AlgJoin => "join"
  }
}

fn binop_algebra_fields(op: BinOp) -> List<AlgebraFieldKind> {
  match op {
    Add => [AlgAdd]
    Sub => [AlgAdd]
    Mul => [AlgMul]
    Div => [AlgReciprocal, AlgQuotient]
    Mod => [AlgRemainder]
    Eq => [AlgCompare]
    Ne => [AlgCompare]
    Lt => [AlgCompare]
    Gt => [AlgCompare]
    Le => [AlgCompare]
    Ge => [AlgCompare]
    And => [AlgMeet]
    Or => [AlgJoin]
    NullCoalesce => []
  }
}

type AlgebraFieldMatch {
  field_kind: AlgebraFieldKind
  field_node: Node
}

fn first_matching_algebra_field(n: Node, candidates: List<AlgebraFieldKind>, source_indices: Map<String, NewlineIndex>) -> AlgebraFieldMatch? {
  match candidates |> first {
    Absent => none
    Present { value: kind } =>
      match find_child_named(n: n, name: algebra_field_kind_name(kind: kind), source_indices: source_indices) {
        Present { value: f } => Present { value: AlgebraFieldMatch { field_kind: kind, field_node: f } }
        Absent => first_matching_algebra_field(n: n, candidates: candidates |> skip(1), source_indices: source_indices)
      }
  }
}

type BinOpInferred {
  result_type: Node
  algebra_field: AlgebraFieldKind?
}

// The one reading of std.coercion's subtraction rows for an operand type: its resolved declaration,
// then the three-valued answer. infer_binop_type_node types from it and the binop arm of infer
// refuses on its Ambiguous arm, so the type and the diagnostic cannot disagree.
fn subtraction_refinement_of(left_type: Node, source_indices: Map<String, NewlineIndex>, env: TypeEnv) -> SubtractionRefinement {
  match type_reference_declaration_ref(n: left_type, source_indices: source_indices, env: env) {
    Present { value: operand } => dag_subtraction_refinement(operand: operand)
    Absent => SubtractionStaysInOperandAlgebra
  }
}

fn infer_binop_type_node(op: BinOp, left_type: Node, source_indices: Map<String, NewlineIndex>, env: TypeEnv) -> BinOpInferred {
  match op {
    Sub =>
      match subtraction_refinement_of(left_type: left_type, source_indices: source_indices, env: env) {
        SubtractionEscapesTo { from_type: from_type } => BinOpInferred { result_type: nominal_type_ref(name: from_type), algebra_field: none }
        SubtractionRefinementAmbiguous { from_types: _ } => BinOpInferred { result_type: error_type, algebra_field: none }
        SubtractionStaysInOperandAlgebra => infer_arithmetic_binop_type_node(op: op, left_type: left_type, source_indices: source_indices)
      }
    _ => infer_arithmetic_binop_type_node(op: op, left_type: left_type, source_indices: source_indices)
  }
}

fn infer_arithmetic_binop_type_node(op: BinOp, left_type: Node, source_indices: Map<String, NewlineIndex>) -> BinOpInferred {
  match op {
    Eq => BinOpInferred { result_type: bool_type, algebra_field: none }
    Ne => BinOpInferred { result_type: bool_type, algebra_field: none }
    Lt => BinOpInferred { result_type: bool_type, algebra_field: none }
    Gt => BinOpInferred { result_type: bool_type, algebra_field: none }
    Le => BinOpInferred { result_type: bool_type, algebra_field: none }
    Ge => BinOpInferred { result_type: bool_type, algebra_field: none }
    And => BinOpInferred { result_type: bool_type, algebra_field: none }
    Or => BinOpInferred { result_type: bool_type, algebra_field: none }
    NullCoalesce => BinOpInferred { result_type: extract_optional_inner_node(n: left_type), algebra_field: none }
    _ =>
      let candidates = binop_algebra_fields(op: op)
      let is_product = left_type.connective == Conj
      if is_product {
        match first_matching_algebra_field(n: left_type, candidates: candidates, source_indices: source_indices) {
          Present { value: m } =>
            match m.field_node.inferred {
              Present { value: Resolved { node: rt } } =>
                match applied_field_type(field_type: rt) {
                  Present { value: applied } => BinOpInferred { result_type: applied, algebra_field: Present { value: m.field_kind } }
                  Absent => BinOpInferred { result_type: left_type, algebra_field: Present { value: m.field_kind } }
                }
              _ => BinOpInferred { result_type: left_type, algebra_field: none }
            }
          Absent => BinOpInferred { result_type: left_type, algebra_field: none }
        }
      } else { BinOpInferred { result_type: left_type, algebra_field: none } }
  }
}

fn for_each_element_type_node(n: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  let normed = normalize_access_type_node(n: n)
  let is_single_child = normed.connective == NoConnective && normed.children |> count == 1
  let extracted = if is_single_child {
    match normed.children |> first {
      Present { value: ch } => Present { value: child_type_node(ch: ch) }
      Absent => none
    }
  } else { none }
  match extracted {
    Present { value: el } => el
    Absent =>
      if normed.connective == NoConnective && normed.children |> count == 0 && normed.properties |> count == 0 && authored_name_at(source_indices: source_indices, node: normed) == "String" { string_type }
      else { normed }
  }
}

fn emit_map_has(m: Map<String, Bool>, key: String) -> Bool {
  match map_get(m, key) {
    Present { value: _ } => true
    Absent => false
  }
}
