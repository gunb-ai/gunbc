module v1.compiler.infer_types







fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

fn type_variable_node(id: String) -> v1.std.core.Node {
  v1.std.core.Node { name: "", span: v1.std.core.no_span(), ident_span: none, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.TypeVariable { id: id } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
}

fn resolved_type(n: v1.std.core.Node) -> v1.std.core.Node {
  match n.inferred {
    Present { value: v1.std.core.Resolved { node: rt } } => rt
    _ => v1.std.core.error_type
  }
}

fn child_type_node(ch: v1.std.core.Node) -> v1.std.core.Node {
  if ch.inferred != none { resolved_type(n: ch) } else { ch }
}

fn is_type_expr_annotation(n: v1.std.core.Node) -> Bool {
  match n.expr_data {
    NoExprData => true
    _ => false
  }
}

fn child_type_at(n: v1.std.core.Node, index: Int) -> v1.std.core.Node? {
  match n.children |> skip(index) |> first {
    Present { value: ch } => Present { value: child_type_node(ch: ch) }
    Absent => none
  }
}

fn node_is_collection(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Bool {
  (n.children |> count) > 0 && n.connective == v1.std.core.NoConnective && is_declared_container_alias_spelling(name: v1.std.core.authored_name_at(source_indices: source_indices, node: n))
}

// The arity conjunct is tested FIRST because it is free and the collection
// conjunct is not: node_is_collection ends in authored_name_at, which resolves a
// span against the newline index and slices source text on every call. Testing
// arity first is the SAME conjunction, so the answer cannot change, and it
// spares that lookup for every node that could not have been a keyed collection
// anyway (DESIGN §6 bare-minimum cost — a conjunction that puts its expensive
// term first is a cost-shape defect regardless of the realized n).
fn node_is_keyed_collection(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Bool {
  (n.children |> count) == 2 && node_is_collection(n: n, source_indices: source_indices)
}

fn node_is_element_collection(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Bool {
  (n.children |> count) == 1 && node_is_collection(n: n, source_indices: source_indices)
}

fn node_is_set_collection(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Bool {
  node_is_element_collection(n: n, source_indices: source_indices) && v1.std.core.qualified_last_segment(name: v1.std.core.authored_name_at(source_indices: source_indices, node: n)) == "Set"
}

fn canonical_template_name(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  let nm = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  match std.types.container_template_algebra(name: v1.std.core.qualified_last_segment(name: nm)) {
    Present { value: algebra } => algebra
    Absent => nm
  }
}

fn is_declared_container_alias_spelling(name: String) -> Bool {
  match std.types.container_template_alias_algebra(name: v1.std.core.qualified_last_segment(name: name)) {
    Present { value: _ } => true
    Absent => false
  }
}

fn container_alias_canonical_spelling(algebra: String) -> String? {
  fold(sorted_map_keys(std.types.container_template_alias_rows), init: none, f: (acc, k) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        match map_get(container_template_alias_rows, k) {
          Present { value: v } => if v == algebra { Present { value: k } } else { none }
          Absent => none
        }
    }
  )
}

fn container_kind_canonical(name: String) -> String {
  let last = v1.std.core.qualified_last_segment(name: name)
  match std.algebra.kernel_algebra_profile |> get(last) {
    Present { value: _ } => last
    Absent =>
      match std.types.container_template_algebra(name: last) {
        Present { value: algebra } =>
          match container_alias_canonical_spelling(algebra: algebra) {
            Present { value: canonical } => canonical
            Absent => last
          }
        Absent => last
      }
  }
}

fn kernel_profile_lookup(name: String) -> std.algebra.AlgebraProfile? {
  std.algebra.kernel_algebra_profile |> get(container_kind_canonical(name: name))
}

fn reground_alias_carrier_identity(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node {
  if n.name != "" && n.name != v1.std.core.authored_name_at(source_indices: source_indices, node: n) && is_declared_container_alias_spelling(name: n.name) {
    v1.std.core.Node {
      name: n.name, span: n.span, ident_span: Present { value: v1.std.core.kernel_span(name: n.name) },
      children: n.children, connective: n.connective, params: n.params, inferred: n.inferred,
      return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport,
      properties: n.properties, type_annotation: n.type_annotation,
      is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call,
      match_pattern: n.match_pattern, expr_data: n.expr_data
    }
  } else {
    n
  }
}

fn structural_carrier_template_name(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  if n.name != "" {
    canonical_template_name(n: v1.std.core.Node {
      name: n.name, span: n.span, ident_span: Present { value: v1.std.core.kernel_span(name: n.name) },
      children: n.children, connective: n.connective, params: n.params, inferred: n.inferred,
      return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport,
      properties: n.properties, type_annotation: n.type_annotation,
      is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call,
      match_pattern: n.match_pattern, expr_data: n.expr_data
    }, source_indices: source_indices)
  } else {
    canonical_template_name(n: n, source_indices: source_indices)
  }
}

fn is_product_type(n: v1.std.core.Node) -> Bool { n.connective == v1.std.core.Conj }
fn is_coproduct_type(n: v1.std.core.Node) -> Bool { n.connective == v1.std.core.Disj }
fn is_leaf_type(n: v1.std.core.Node) -> Bool { n.connective == v1.std.core.NoConnective }
fn is_unit_like(n: v1.std.core.Node) -> Bool { n.connective == v1.std.core.Conj && n.children |> count == 0 }

// The three answers this walk can give. Before this type existed the walk returned
// Bool, which has nowhere to put "I cannot classify this name": an unrecognized
// container spelling took the same Absent arm as String and every user record and
// came back "not under-parameterized" -- a resolution claim about a name whose
// arity is unknown. UnderResolved and ContainerSpellingUnresolvable are different
// states with different remedies (supply the type argument / declare the row), and
// the collapse to Bool below is now a NAMED collapse rather than a silent one.
type TypeResolutionVerdict
  = FullyResolved
  | UnderResolved
  | ContainerSpellingUnresolvable { name: String }

// Refusal dominates under-resolution dominates resolution: the strongest reason
// the walk found is the one it reports, so a refused child is never averaged away
// by resolved siblings.
fn combine_resolution_verdicts(acc: TypeResolutionVerdict, next: TypeResolutionVerdict) -> TypeResolutionVerdict {
  match acc {
    ContainerSpellingUnresolvable { name: _ } => acc
    _ =>
      match next {
        ContainerSpellingUnresolvable { name: _ } => next
        UnderResolved => UnderResolved
        FullyResolved => acc
      }
  }
}

fn type_resolution_verdict(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> TypeResolutionVerdict {
  let self_is_type_var = match n.inferred { Present { value: inf } => is_type_variable(inferred: inf)  Absent => false }
  if self_is_type_var { UnderResolved }
  else {
    match authored_container_spelling_verdict(node: n, source_indices: source_indices) {
      ContainerSpellingUnknown { container_leaf: _ } =>
        ContainerSpellingUnresolvable { name: authored_name_at(source_indices: source_indices, node: n) }
      ContainerSpellingDeclared { arity: expected } =>
        if (n.children |> count) < expected {
          UnderResolved
        } else {
          fold(n.children, init: FullyResolved, f: (acc, ch) =>
            combine_resolution_verdicts(
              acc: acc,
              next: type_resolution_verdict(n: child_type_node(ch: ch), source_indices: source_indices)
            )
          )
        }
      NotAContainerSpelling =>
        fold(n.children, init: FullyResolved, f: (acc, ch) =>
          combine_resolution_verdicts(
            acc: acc,
            next: type_resolution_verdict(n: child_type_node(ch: ch), source_indices: source_indices)
          )
        )
    }
  }
}

// The collapse the thirteen call sites consume. A refusal reads as NOT fully
// resolved, which is the conservative arm -- it declines to claim a resolution the
// walk could not establish, and it never widens to the resolved answer the old
// Absent arm gave. The located, counted report of the same class is emitted once
// per authored occurrence by v1.compiler.normalize check_bare_containers, which
// already owns a diagnostics channel; reporting from here instead would emit one
// diagnostic per query per node of every recursive walk that asks.
fn is_fully_resolved(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Bool {
  match type_resolution_verdict(n: n, source_indices: source_indices) {
    FullyResolved => true
    UnderResolved => false
    ContainerSpellingUnresolvable { name: _ } => false
  }
}

fn bare_map_node() -> v1.std.core.Node? {
  match std.types.container_param_name(kind_name: "Map", index: 0) {
    Present { value: key_id } =>
      match std.types.container_param_name(kind_name: "Map", index: 1) {
        Present { value: val_id } =>
          Present {
            value: v1.std.core.Node { name: "Map", span: v1.std.core.no_span(), ident_span: Present { value: v1.std.core.no_span() }, children: [
              v1.std.core.Node { name: key_id, span: v1.std.core.no_span(), ident_span: Present { value: v1.std.core.no_span() }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: type_variable_node(id: key_id) } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData },
              v1.std.core.Node { name: val_id, span: v1.std.core.no_span(), ident_span: Present { value: v1.std.core.no_span() }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: type_variable_node(id: val_id) } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
            ], connective: v1.std.core.NoConnective, params: [], inferred: none, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
          }
        Absent => none
      }
    Absent => none
  }
}

fn bare_set_node() -> v1.std.core.Node? {
  match std.types.container_param_name(kind_name: "Set", index: 0) {
    Present { value: elem_id } =>
      Present {
        value: v1.std.core.Node { name: "Set", span: v1.std.core.no_span(), ident_span: Present { value: v1.std.core.no_span() }, children: [
          v1.std.core.Node { name: elem_id, span: v1.std.core.no_span(), ident_span: Present { value: v1.std.core.no_span() }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: type_variable_node(id: elem_id) } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
        ], connective: v1.std.core.NoConnective, params: [], inferred: none, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
      }
    Absent => none
  }
}

fn kernel_container_profile_miss_diagnostic(kind_name: String) -> v1.std.core.ErrorNode {
  let msg = concat("missing kernel container profile: ", kind_name)
  v1.std.core.make_error_node(
    diagnostic: v1.std.core.InternalError { message: msg, span: v1.std.core.no_span() },
    module_name: "v1.compiler.infer_types"
  )
}

fn missing_kernel_container_profile_type(kind_name: String) -> v1.std.core.Node {
  let msg = concat("missing kernel container profile: ", kind_name)
  v1.std.core.Node {
    name: "",
    span: v1.std.core.no_span(),
    ident_span: none,
    children: [],
    connective: v1.std.core.NoConnective,
    params: [],
    inferred: Present { value: v1.std.core.CompilerError { message: msg, span: v1.std.core.no_span() } },
    return_cardinality: v1.std.core.Required,
    uses: [], body: none, transport: none, properties: [], type_annotation: none,
    is_self_recursive: false, has_non_tail_self_call: false,
    match_pattern: none,
    expr_data: v1.std.core.ExprError { kind: v1.std.core.InternalExprError, message: msg }
  }
}

type KernelTypeBuild {
  ty: v1.std.core.Node
  diagnostics: List<v1.std.core.ErrorNode>
}

data kernel_record_type_note: String = "A builtin whose return type is registered as a bare type_variable_node establishes NOTHING about its result, so every field access on that result falls through lookup_field_type_node's Absent arm and the caller fabricates a success-shaped Primitive() in its place. That is this lane's own finding one level down — a missing judgment rendered as an accepted type — and it stayed invisible because the fabricated type propagates silently until some later stage asks a question it cannot answer. make_kernel_record_type lets a builtin declare the product type it actually returns, so the field's type is READ from the declaration rather than invented. It is the same Conj-with-named-children shape lookup_field_type_node already walks for authored records, not a second representation of one (DESIGN §3): the kernel path and the authored path resolve fields through the identical traversal, so a kernel record cannot drift from what an authored record means."

fn make_kernel_record_field(field_name: String, field_type: v1.std.core.Node) -> v1.std.core.Node {
  v1.std.core.Node {
    name: field_name, span: v1.std.core.kernel_span(name: field_name),
    ident_span: Present { value: v1.std.core.kernel_span(name: field_name) },
    children: [], connective: v1.std.core.NoConnective, params: [],
    inferred: Present { value: v1.std.core.Resolved { node: field_type } },
    return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none,
    properties: [], type_annotation: none, is_self_recursive: false,
    has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData
  }
}

fn make_kernel_record_type(type_name: String, fields: List<v1.std.core.Node>) -> v1.std.core.Node {
  v1.std.core.Node {
    name: type_name, span: v1.std.core.kernel_span(name: type_name),
    ident_span: Present { value: v1.std.core.kernel_span(name: type_name) },
    children: fields, connective: v1.std.core.Conj, params: [], inferred: none,
    return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none,
    properties: [], type_annotation: none, is_self_recursive: false,
    has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData
  }
}

fn make_container_type(kind_name: String, element: v1.std.core.Node) -> KernelTypeBuild {
  match std.types.container_param_name(kind_name: kind_name, index: 0) {
    Present { value: param_name } =>
      KernelTypeBuild {
        ty: v1.std.core.Node { name: kind_name, span: v1.std.core.kernel_span(name: kind_name), ident_span: Present { value: v1.std.core.kernel_span(name: kind_name) }, children: [
          v1.std.core.Node { name: param_name, span: v1.std.core.kernel_span(name: param_name), ident_span: Present { value: v1.std.core.kernel_span(name: param_name) }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: element } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
        ], connective: v1.std.core.NoConnective, params: [], inferred: none, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData },
        diagnostics: []
      }
    Absent =>
      KernelTypeBuild {
        ty: missing_kernel_container_profile_type(kind_name: kind_name),
        diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: kind_name)]
      }
  }
}

fn make_map_type(key: v1.std.core.Node, value: v1.std.core.Node) -> KernelTypeBuild {
  match std.types.container_param_name(kind_name: "Map", index: 0) {
    Present { value: key_name } =>
      match std.types.container_param_name(kind_name: "Map", index: 1) {
        Present { value: val_name } =>
          KernelTypeBuild {
            ty: v1.std.core.Node { name: "Map", span: v1.std.core.kernel_span(name: "Map"), ident_span: Present { value: v1.std.core.kernel_span(name: "Map") }, children: [
              v1.std.core.Node { name: key_name, span: v1.std.core.kernel_span(name: key_name), ident_span: Present { value: v1.std.core.kernel_span(name: key_name) }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: key } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData },
              v1.std.core.Node { name: val_name, span: v1.std.core.kernel_span(name: val_name), ident_span: Present { value: v1.std.core.kernel_span(name: val_name) }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: value } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
            ], connective: v1.std.core.NoConnective, params: [], inferred: none, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData },
            diagnostics: []
          }
        Absent =>
          KernelTypeBuild {
            ty: missing_kernel_container_profile_type(kind_name: "Map"),
            diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: "Map")]
          }
      }
    Absent =>
      KernelTypeBuild {
        ty: missing_kernel_container_profile_type(kind_name: "Map"),
        diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: "Map")]
      }
  }
}

fn make_callable_type(func_params: List<v1.std.core.Node>, ret: v1.std.core.Node) -> v1.std.core.Node {
  v1.std.core.Node { name: "Callable", span: v1.std.core.kernel_span(name: "Callable"), ident_span: Present { value: v1.std.core.kernel_span(name: "Callable") }, children: [], connective: v1.std.core.Arrow, params: func_params, inferred: Present { value: v1.std.core.Resolved { node: ret } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
}

fn make_tuple_type(first: v1.std.core.Node, second: v1.std.core.Node) -> v1.std.core.Node {
  v1.std.core.Node { name: "", span: v1.std.core.no_span(), ident_span: none, children: [
    v1.std.core.Node { name: "first", span: v1.std.core.kernel_span(name: "first"), ident_span: Present { value: v1.std.core.kernel_span(name: "first") }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: first } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData },
    v1.std.core.Node { name: "second", span: v1.std.core.kernel_span(name: "second"), ident_span: Present { value: v1.std.core.kernel_span(name: "second") }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: second } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
  ], connective: v1.std.core.Conj, params: [], inferred: none, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
}

fn algebra_value_field(name: String, type_node: v1.std.core.Node) -> v1.std.core.Node {
  v1.std.core.Node { name: name, span: v1.std.core.kernel_span(name: name), ident_span: Present { value: v1.std.core.kernel_span(name: name) }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: type_node } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
}

fn algebra_method_field(name: String, param_types: List<v1.std.core.Node>, return_type: v1.std.core.Node) -> v1.std.core.Node {
  let params = param_types |> map(t => v1.std.core.make_param_node(name: "_", type_expr: t, default_value: none, span: v1.std.core.no_span(), name_span: v1.std.core.no_span()))
  let callable = make_callable_type(func_params: params, ret: return_type)
  v1.std.core.Node { name: name, span: v1.std.core.kernel_span(name: name), ident_span: Present { value: v1.std.core.kernel_span(name: name) }, children: [], connective: v1.std.core.NoConnective, params: [], inferred: Present { value: v1.std.core.Resolved { node: callable } }, return_cardinality: v1.std.core.Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: v1.std.core.NoExprData }
}

fn enrich_base_with_fields(name: String, base: v1.std.core.Node, fields: List<v1.std.core.Node>) -> v1.std.core.Node {
  v1.std.core.Node { name: name, span: base.span, ident_span: base.ident_span, children: fields, connective: v1.std.core.Conj, params: base.params, inferred: base.inferred, return_cardinality: base.return_cardinality, uses: base.uses, body: base.body, transport: base.transport, properties: base.properties, type_annotation: base.type_annotation, is_self_recursive: base.is_self_recursive, has_non_tail_self_call: base.has_non_tail_self_call, match_pattern: base.match_pattern, expr_data: base.expr_data }
}

fn placeholder_type_node(name: String) -> v1.std.core.Node {
  nominal_type_ref(name: name)
}

fn nominal_type_ref(name: String) -> v1.std.core.Node {
  v1.std.core.leaf_node_with_span(name: name, span: v1.std.core.kernel_span(name: name))
}

fn algebra_child_or_placeholder(base: v1.std.core.Node, child_index: Int, placeholder: String) -> v1.std.core.Node {
  match base.children |> enumerate |> filter(pair => pair.first == child_index) |> map(pair => pair.second) |> first {
    Present { value: child } => child_type_node(ch: child)
    Absent => type_variable_node(id: placeholder)
  }
}

fn instantiate_algebra_type(template: std.algebra.AlgebraTypeTemplate, base: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> KernelTypeBuild {
  let elem = algebra_child_or_placeholder(base: base, child_index: 0, placeholder: "T")
  let key_node = algebra_child_or_placeholder(base: base, child_index: 0, placeholder: "K")
  let val_node = algebra_child_or_placeholder(base: base, child_index: 1, placeholder: "V")
  match template {
    ReceiverSelf => KernelTypeBuild { ty: base, diagnostics: [] }
    ReceiverElement => KernelTypeBuild { ty: elem, diagnostics: [] }
    ReceiverKey => KernelTypeBuild { ty: key_node, diagnostics: [] }
    ReceiverValue => KernelTypeBuild { ty: val_node, diagnostics: [] }
    NamedTemplate { name: n } => KernelTypeBuild { ty: nominal_type_ref(name: n), diagnostics: [] }
    AlgebraTypeVariable { id: var_id } => KernelTypeBuild { ty: type_variable_node(id: var_id), diagnostics: [] }
    ContainerOf { source: src, element: inner } =>
      let kind_name = match src { std.algebra.SameAsReceiver => container_kind_canonical(name: v1.std.core.authored_name_at(source_indices: source_indices, node: base))  std.algebra.Named { name: n } => n }
      let inner_b = instantiate_algebra_type(template: inner, base: base, source_indices: source_indices)
      let built = make_container_type(kind_name: kind_name, element: inner_b.ty)
      KernelTypeBuild { ty: built.ty, diagnostics: concat(inner_b.diagnostics, built.diagnostics) }
    OptionalOf { inner: inner } =>
      let ib = instantiate_algebra_type(template: inner, base: base, source_indices: source_indices)
      KernelTypeBuild { ty: v1.std.core.with_optional_cardinality(n: ib.ty), diagnostics: ib.diagnostics }
    WitnessOf { inner: inner } =>
      let ib = instantiate_algebra_type(template: inner, base: base, source_indices: source_indices)
      let built = make_container_type(kind_name: "Witness", element: ib.ty)
      KernelTypeBuild { ty: built.ty, diagnostics: concat(ib.diagnostics, built.diagnostics) }
    TupleOf { first: first, second: second } =>
      let fb = instantiate_algebra_type(template: first, base: base, source_indices: source_indices)
      let sb = instantiate_algebra_type(template: second, base: base, source_indices: source_indices)
      KernelTypeBuild { ty: make_tuple_type(first: fb.ty, second: sb.ty), diagnostics: concat(fb.diagnostics, sb.diagnostics) }
    CallableOf { params: p, return_type: r } =>
      let param_bs = p |> map(tp => instantiate_algebra_type(template: tp, base: base, source_indices: source_indices))
      let param_diags = param_bs |> flat_map(b => b.diagnostics)
      let param_nodes = param_bs |> map(b => b.ty)
      let rb = instantiate_algebra_type(template: r, base: base, source_indices: source_indices)
      KernelTypeBuild {
        ty: make_callable_type(func_params: param_nodes |> map(pn => v1.std.core.make_param_node(name: "_", type_expr: pn, default_value: none, span: v1.std.core.no_span(), name_span: v1.std.core.no_span())), ret: rb.ty),
        diagnostics: concat(param_diags, rb.diagnostics)
      }
  }
}

fn instantiate_algebra_field(template: std.algebra.AlgebraFieldTemplate, base: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> KernelTypeBuild {
  let param_bs = template.param_types |> map(tp => instantiate_algebra_type(template: tp, base: base, source_indices: source_indices))
  let param_types = param_bs |> map(b => b.ty)
  let param_diags = param_bs |> flat_map(b => b.diagnostics)
  let return_b = instantiate_algebra_type(template: template.return_type, base: base, source_indices: source_indices)
  let field_ty = if param_types |> count > 0 {
    algebra_method_field(name: template.name, param_types: param_types, return_type: return_b.ty)
  } else {
    algebra_value_field(name: template.name, type_node: return_b.ty)
  }
  KernelTypeBuild { ty: field_ty, diagnostics: concat(param_diags, return_b.diagnostics) }
}

fn enrich_kernel_type(name: String, base: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> KernelTypeBuild {
  let profile = kernel_profile_lookup(name: name)
  match profile {
    Present { value: p } =>
      let field_bs = std.algebra.algebra_templates_for_profile(profile: p) |> map(template => instantiate_algebra_field(template: template, base: base, source_indices: source_indices))
      let fields = field_bs |> map(b => b.ty)
      let field_diags = field_bs |> flat_map(b => b.diagnostics)
      KernelTypeBuild { ty: enrich_base_with_fields(name: name, base: base, fields: fields), diagnostics: field_diags }
    Absent => KernelTypeBuild { ty: base, diagnostics: [] }
  }
}

fn unify_template(template: std.algebra.AlgebraTypeTemplate, concrete: v1.std.core.Node, receiver: v1.std.core.Node, subst: Map<String, v1.std.core.Node>, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Map<String, v1.std.core.Node> {
  match template {
    AlgebraTypeVariable { id: var_id } =>
      if map_get(subst, var_id) != none { subst }
      else { map_insert(subst, var_id, concrete) }
    ReceiverSelf =>
      let s1 = match concrete.children |> first {
        Present { value: k } =>
          if map_get(subst, "__key__") != none { subst } else { map_insert(subst, "__key__", child_type_node(ch: k)) }
        Absent => subst
      }
      match concrete.children |> skip(1) |> first {
        Present { value: v } =>
          if map_get(s1, "__value__") != none { s1 } else { map_insert(s1, "__value__", child_type_node(ch: v)) }
        Absent => s1
      }
    ReceiverKey =>
      if map_get(subst, "__key__") != none { subst }
      else { map_insert(subst, "__key__", concrete) }
    ReceiverValue =>
      if map_get(subst, "__value__") != none { subst }
      else { map_insert(subst, "__value__", concrete) }
    ReceiverElement =>
      if map_get(subst, "__element__") != none { subst }
      else { map_insert(subst, "__element__", concrete) }
    CallableOf { params: _, return_type: ret_template } =>
      unify_template(template: ret_template, concrete: concrete, receiver: receiver, subst: subst, source_indices: source_indices)
    ContainerOf { source: src, element: elem_template } =>
      let expected_name = match src { std.algebra.SameAsReceiver => container_kind_canonical(name: v1.std.core.authored_name_at(source_indices: source_indices, node: receiver))  std.algebra.Named { name: n } => n }
      if container_kind_canonical(name: v1.std.core.authored_name_at(source_indices: source_indices, node: concrete)) != expected_name { subst }
      else {
        match concrete.children |> first {
          Present { value: child } => unify_template(template: elem_template, concrete: child_type_node(ch: child), receiver: receiver, subst: subst, source_indices: source_indices)
          Absent => subst
        }
      }
    OptionalOf { inner: inner_template } =>
      match concrete.children |> first {
        Present { value: child } => unify_template(template: inner_template, concrete: child_type_node(ch: child), receiver: receiver, subst: subst, source_indices: source_indices)
        Absent => subst
      }
    TupleOf { first: ft, second: st } =>
      let s2 = match concrete.children |> first {
        Present { value: c } => unify_template(template: ft, concrete: child_type_node(ch: c), receiver: receiver, subst: subst, source_indices: source_indices)
        Absent => subst
      }
      match concrete.children |> skip(1) |> first {
        Present { value: c } => unify_template(template: st, concrete: child_type_node(ch: c), receiver: receiver, subst: s2, source_indices: source_indices)
        Absent => s2
      }
    _ => subst
  }
}

fn is_receiver_self(t: std.algebra.AlgebraTypeTemplate) -> Bool {
  match t {
    ReceiverSelf => true
    _ => false
  }
}

fn build_type_substitution(param_templates: List<std.algebra.AlgebraTypeTemplate>, arg_types: List<v1.std.core.Node>, receiver: v1.std.core.Node, base_subst: Map<String, v1.std.core.Node>, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Map<String, v1.std.core.Node> {
  let first_is_self = match param_templates |> first {
    Present { value: t } => is_receiver_self(t: t)
    Absent => false
  }
  let non_receiver_templates = if first_is_self { param_templates |> skip(1) } else { param_templates }
  let pairs = non_receiver_templates |> enumerate |> filter(pair =>
    pair.first < (arg_types |> count)
  )
  pairs |> fold(init: base_subst, f: (subst, pair) =>
    let arg_type = match arg_types |> enumerate |> filter(ap => ap.first == pair.first) |> map(ap => ap.second) |> first {
      Present { value: a } => a
      Absent => v1.std.core.error_type
    }
    unify_template(template: pair.second, concrete: arg_type, receiver: receiver, subst: subst, source_indices: source_indices)
  )
}

fn apply_type_substitution(template: std.algebra.AlgebraTypeTemplate, subst: Map<String, v1.std.core.Node>, receiver: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> KernelTypeBuild {
  match template {
    AlgebraTypeVariable { id: var_id } =>
      match map_get(subst, var_id) {
        Present { value: resolved } => KernelTypeBuild { ty: resolved, diagnostics: [] }
        Absent => KernelTypeBuild { ty: type_variable_node(id: var_id), diagnostics: [] }
      }
    ReceiverSelf =>
      let receiver_name_str = container_kind_canonical(name: v1.std.core.authored_name_at(source_indices: source_indices, node: receiver))
      let is_bare = std.types.is_container_type(name: receiver_name_str) && (receiver.children |> all(ch =>
        let inner = child_type_node(ch: ch)
        if inner.inferred != none { is_type_variable(inferred: inner.inferred.value) } else { inner.ident_span == none || !std.types.is_kernel_type(name: v1.std.core.authored_name_at(source_indices: source_indices, node: inner)) }
      ))
      if is_bare {
        let arity = std.types.container_expected_arity(name: receiver_name_str)
        if arity == Present { value: 2 } {
          match map_get(subst, "__key__") {
            Present { value: key } =>
              let val = match map_get(subst, "__value__") {
                Present { value: v } => v
                Absent => type_variable_node(id: "V")
              }
              make_map_type(key: key, value: val)
            Absent => KernelTypeBuild { ty: receiver, diagnostics: [] }
          }
        } else if arity == Present { value: 1 } {
          match map_get(subst, "__element__") {
            Present { value: elem } => make_container_type(kind_name: container_kind_canonical(name: receiver_name_str), element: elem)
            Absent => KernelTypeBuild { ty: receiver, diagnostics: [] }
          }
        } else { KernelTypeBuild { ty: receiver, diagnostics: [] } }
      } else { KernelTypeBuild { ty: receiver, diagnostics: [] } }
    ReceiverElement =>
      match receiver.children |> first {
        Present { value: child } => KernelTypeBuild { ty: child_type_node(ch: child), diagnostics: [] }
        Absent =>
          match map_get(subst, "__element__") {
            Present { value: elem } => KernelTypeBuild { ty: elem, diagnostics: [] }
            Absent =>
              let rname = container_kind_canonical(name: v1.std.core.authored_name_at(source_indices: source_indices, node: receiver))
              match std.types.container_param_name(kind_name: rname, index: 0) {
                Present { value: n } => KernelTypeBuild { ty: type_variable_node(id: n), diagnostics: [] }
                Absent =>
                  KernelTypeBuild {
                    ty: missing_kernel_container_profile_type(kind_name: rname),
                    diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: rname)]
                  }
              }
          }
      }
    ReceiverKey =>
      match receiver.children |> first {
        Present { value: child } => KernelTypeBuild { ty: child_type_node(ch: child), diagnostics: [] }
        Absent =>
          match map_get(subst, "__key__") {
            Present { value: key } => KernelTypeBuild { ty: key, diagnostics: [] }
            Absent =>
              let rname = container_kind_canonical(name: v1.std.core.authored_name_at(source_indices: source_indices, node: receiver))
              match std.types.container_param_name(kind_name: rname, index: 0) {
                Present { value: n } => KernelTypeBuild { ty: type_variable_node(id: n), diagnostics: [] }
                Absent =>
                  KernelTypeBuild {
                    ty: missing_kernel_container_profile_type(kind_name: rname),
                    diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: rname)]
                  }
              }
          }
      }
    ReceiverValue =>
      match receiver.children |> skip(1) |> first {
        Present { value: child } => KernelTypeBuild { ty: child_type_node(ch: child), diagnostics: [] }
        Absent =>
          match map_get(subst, "__value__") {
            Present { value: val } => KernelTypeBuild { ty: val, diagnostics: [] }
            Absent =>
              let rname = container_kind_canonical(name: v1.std.core.authored_name_at(source_indices: source_indices, node: receiver))
              match std.types.container_param_name(kind_name: rname, index: 1) {
                Present { value: n } => KernelTypeBuild { ty: type_variable_node(id: n), diagnostics: [] }
                Absent =>
                  KernelTypeBuild {
                    ty: missing_kernel_container_profile_type(kind_name: rname),
                    diagnostics: [kernel_container_profile_miss_diagnostic(kind_name: rname)]
                  }
              }
          }
      }
    NamedTemplate { name: n } => KernelTypeBuild { ty: nominal_type_ref(name: n), diagnostics: [] }
    ContainerOf { source: src, element: inner } =>
      let kind_name = match src { std.algebra.SameAsReceiver => container_kind_canonical(name: v1.std.core.authored_name_at(source_indices: source_indices, node: receiver))  std.algebra.Named { name: n } => n }
      let inner_applied = apply_type_substitution(template: inner, subst: subst, receiver: receiver, source_indices: source_indices)
      let built = make_container_type(kind_name: kind_name, element: inner_applied.ty)
      KernelTypeBuild { ty: built.ty, diagnostics: concat(inner_applied.diagnostics, built.diagnostics) }
    OptionalOf { inner: inner } =>
      let ib = apply_type_substitution(template: inner, subst: subst, receiver: receiver, source_indices: source_indices)
      KernelTypeBuild { ty: v1.std.core.with_optional_cardinality(n: ib.ty), diagnostics: ib.diagnostics }
    WitnessOf { inner: inner } =>
      let ib = apply_type_substitution(template: inner, subst: subst, receiver: receiver, source_indices: source_indices)
      let built = make_container_type(kind_name: "Witness", element: ib.ty)
      KernelTypeBuild { ty: built.ty, diagnostics: concat(ib.diagnostics, built.diagnostics) }
    TupleOf { first: ft, second: st } =>
      let fb = apply_type_substitution(template: ft, subst: subst, receiver: receiver, source_indices: source_indices)
      let sb = apply_type_substitution(template: st, subst: subst, receiver: receiver, source_indices: source_indices)
      KernelTypeBuild { ty: make_tuple_type(first: fb.ty, second: sb.ty), diagnostics: concat(fb.diagnostics, sb.diagnostics) }
    CallableOf { params: p, return_type: r } =>
      let param_bs = p |> map(tp => apply_type_substitution(template: tp, subst: subst, receiver: receiver, source_indices: source_indices))
      let param_nodes = param_bs |> map(b => b.ty)
      let param_diags = param_bs |> flat_map(b => b.diagnostics)
      let rb = apply_type_substitution(template: r, subst: subst, receiver: receiver, source_indices: source_indices)
      KernelTypeBuild {
        ty: make_callable_type(func_params: param_nodes |> map(pn => v1.std.core.make_param_node(name: "_", type_expr: pn, default_value: none, span: v1.std.core.no_span(), name_span: v1.std.core.no_span())), ret: rb.ty),
        diagnostics: concat(param_diags, rb.diagnostics)
      }
  }
}

fn template_return_is_receiver_self(template: std.algebra.AlgebraFieldTemplate) -> Bool {
  is_receiver_self(t: template.return_type)
}

fn template_return_has_variables(template: std.algebra.AlgebraFieldTemplate) -> Bool {
  has_type_variable(t: template.return_type)
}

fn has_type_variable(t: std.algebra.AlgebraTypeTemplate) -> Bool {
  match t {
    AlgebraTypeVariable { id: _ } => true
    ContainerOf { source: _, element: inner } => has_type_variable(t: inner)
    OptionalOf { inner: inner } => has_type_variable(t: inner)
    WitnessOf { inner: inner } => has_type_variable(t: inner)
    TupleOf { first: f, second: s } => has_type_variable(t: f) || has_type_variable(t: s)
    CallableOf { params: _, return_type: r } => has_type_variable(t: r)
    _ => false
  }
}

fn resolve_type_variables_from_template(template: std.algebra.AlgebraFieldTemplate, arg_types: List<v1.std.core.Node>, receiver_type: v1.std.core.Node, overrides: Map<String, v1.std.core.Node>, source_indices: Map<String, v1.std.core.NewlineIndex>) -> KernelTypeBuild {
  let subst = build_type_substitution(
    param_templates: template.param_types,
    arg_types: arg_types,
    receiver: receiver_type,
    base_subst: overrides,
    source_indices: source_indices
  )
  apply_type_substitution(template: template.return_type, subst: subst, receiver: receiver_type, source_indices: source_indices)
}

fn callable_inferred(n: v1.std.core.Node) -> v1.std.core.Node {
  let is_callable = n.params |> count > 0
  if is_callable {
    match n.inferred {
      Present { value: v1.std.core.Resolved { node: ret } } =>
        if (ret.connective == v1.std.core.Arrow) { ret } else { make_callable_type(func_params: n.params, ret: ret) }
      Absent => v1.std.core.error_type
      _ => v1.std.core.error_type
    }
  } else { n }
}

fn callable_return_type(n: v1.std.core.Node) -> v1.std.core.Node {
  if n.params |> count == 0 {
    match n.inferred {
      Present { value: v1.std.core.Resolved { node: ret } } => ret
      _ => v1.std.core.error_type
    }
  } else {
    match callable_inferred(n: n).inferred {
      Present { value: v1.std.core.Resolved { node: callable } } =>
        match callable.inferred {
          Present { value: v1.std.core.Resolved { node: ret } } => ret
          _ => v1.std.core.error_type
        }
      _ => v1.std.core.error_type
    }
  }
}

fn global_bare_callable_binding(binding: v1.compiler.infer_env.TypeBinding) -> Bool {
  binding.resolved.transport == none
    && binding.resolved.expr_data == v1.std.core.NoExprData
    && binding.resolved.connective == v1.std.core.NoConnective
    && binding.resolved.inferred != none
    && binding.resolved.properties |> count == 0
    && binding.resolved.type_annotation == none
}

fn value_binding_expr_type_node(resolved: v1.std.core.Node) -> v1.std.core.Node {
  match resolved.inferred {
    Present { value: v1.std.core.Resolved { node: ty } } => ty
    _ => resolved
  }
}

fn normalize_access_type_node(n: v1.std.core.Node) -> v1.std.core.Node {
  let has_structure = n.connective != v1.std.core.NoConnective
  let unwrapped = if n.type_annotation != none && has_structure {
    n.children |> first
  } else { none }
  match unwrapped {
    Present { value: base } => normalize_access_type_node(n: base)
    Absent => n
  }
}

fn node_type_shape(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  let __is_leaf = n.connective == v1.std.core.NoConnective && n.children |> count == 0 && n.properties |> count == 0
  let n_name = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  if __is_leaf {
    let __is_named_ref = match n.inferred {
      Present { value: v1.std.core.Resolved { node: rt } } =>
        rt.connective == v1.std.core.NoConnective && rt.children |> count == 0
          && rt.ident_span != none && v1.std.core.authored_name_at(source_indices: source_indices, node: rt) != "None"
          && std.types.is_kernel_type(name: v1.std.core.authored_name_at(source_indices: source_indices, node: rt)) == false
      _ => false
    }
    if __is_named_ref {
      concat("Named(", n_name, ")")
    } else {
      concat("Primitive(", n_name, ")")
    }
  } else {
    let is_product = n.connective == v1.std.core.Conj
    let is_coproduct = n.connective == v1.std.core.Disj
    if is_product {
      if n.ident_span == none { "Product(<anon>)" } else { concat("Product(", n_name, ")") }
    } else if is_coproduct {
      if n.ident_span == none { "Coproduct(<anon>)" } else { concat("Coproduct(", n_name, ")") }
    } else {
      let __is_container = node_is_element_collection(n: n, source_indices: source_indices)
      let is_optional = n.return_cardinality == v1.std.core.CardOptional
      let is_map = node_is_keyed_collection(n: n, source_indices: source_indices)
      if __is_container {
        let elem_shape = match n.children |> first {
          Present { value: el } => node_type_shape(n: child_type_node(ch: el), source_indices: source_indices)
          Absent => "?"
        }
        concat("Container(", n_name, ",", elem_shape, ")")
      } else if is_optional {
        let inner_shape = node_type_shape(n: v1.std.core.with_required_cardinality(n: n), source_indices: source_indices)
        concat("Optional(", inner_shape, ")")
      } else if is_map {
        "Map(...)"
      } else {
        concat("Node(", n_name, ")")
      }
    }
  }
}

fn node_type_compatible(left: v1.std.core.Node, right: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let left_err = if left.inferred != none { v1.std.core.is_compiler_error(inferred: left.inferred.value) } else { false }
  let right_err = if right.inferred != none { v1.std.core.is_compiler_error(inferred: right.inferred.value) } else { false }
  let left_tv = if left.inferred != none { is_type_variable(inferred: left.inferred.value) } else { false }
  let right_tv = if right.inferred != none { is_type_variable(inferred: right.inferred.value) } else { false }
  let left_opt = left.return_cardinality == v1.std.core.CardOptional
  let right_opt = right.return_cardinality == v1.std.core.CardOptional
  let right_is_unit = is_unit_like(n: right)
  let left_is_unit = is_unit_like(n: left)
  if left_err || right_err { true }
  else if left_tv || right_tv { true }
  else if left_opt && right_is_unit { true }
  else if left_is_unit && right_opt { true }
  else {
    let left_is_container = node_is_element_collection(n: left, source_indices: source_indices)
    let right_is_container = node_is_element_collection(n: right, source_indices: source_indices)
    if left_is_container && right_is_container {
      if canonical_template_name(n: left, source_indices: source_indices) != canonical_template_name(n: right, source_indices: source_indices) { false }
      else {
        match left.children |> first {
          Present { value: left_ch } =>
            match right.children |> first {
              Present { value: right_ch } =>
                let left_el = child_type_node(ch: left_ch)
                let right_el = child_type_node(ch: right_ch)
                let left_el_is_unit = is_unit_like(n: left_el)
                let right_el_is_unit = is_unit_like(n: right_el)
                if left_el_is_unit || right_el_is_unit { true }
                else { node_type_compatible(left: left_el, right: right_el, source_indices: source_indices) }
              Absent => true
            }
          Absent => true
        }
      }
    }
    else if (((canonical_template_name(n: left, source_indices: source_indices) == canonical_template_name(n: right, source_indices: source_indices))
      && (v1.std.core.authored_name_at(source_indices: source_indices, node: left) != v1.std.core.authored_name_at(source_indices: source_indices, node: right)))
      && (left.children |> count == 1)) && (right.children |> count == 1)
      && (is_declared_container_alias_spelling(name: v1.std.core.authored_name_at(source_indices: source_indices, node: left))
        || is_declared_container_alias_spelling(name: v1.std.core.authored_name_at(source_indices: source_indices, node: right))) {

      match left.children |> first {
        Present { value: left_ch } =>
          match right.children |> first {
            Present { value: right_ch } =>
              let left_el = child_type_node(ch: left_ch)
              let right_el = child_type_node(ch: right_ch)
              if is_unit_like(n: left_el) || is_unit_like(n: right_el) { true }
              else { node_type_compatible(left: left_el, right: right_el, source_indices: source_indices) }
            Absent => true
          }
        Absent => true
      }
    }
    else if left_opt && right_opt {
      let left_inner = v1.std.core.with_required_cardinality(n: left)
      let right_inner = v1.std.core.with_required_cardinality(n: right)
      let left_inner_is_unit = is_unit_like(n: left_inner)
      let right_inner_is_unit = is_unit_like(n: right_inner)
      if left_inner_is_unit || right_inner_is_unit { true }
      else { node_type_compatible(left: left_inner, right: right_inner, source_indices: source_indices) }
    }
    else if left_opt || right_opt { false }
    else { v1.std.core.type_name_compatible(a: v1.std.core.authored_name_at(source_indices: source_indices, node: left), b: v1.std.core.authored_name_at(source_indices: source_indices, node: right)) }
  }
}

fn prefer_specific_type(left: v1.std.core.Node, right: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node {
  let left_is_container = node_is_element_collection(n: left, source_indices: source_indices)
  let left_is_optional = left.return_cardinality == v1.std.core.CardOptional
  let left_first_child = left.children |> first
  let left_norm_name = v1.std.core.authored_name_at(source_indices: source_indices, node: left)
  let left_is_unit_inner = if left_is_container {
    match left_first_child {
      Present { value: ch } =>
        let el = child_type_node(ch: ch)
        let el_is_unit = is_unit_like(n: el)
        el_is_unit
      Absent => false
    }
  } else if left_is_optional {
    let left_is_unit = is_unit_like(n: left)
    left_is_unit
  } else { false }
  let right_is_container = node_is_element_collection(n: right, source_indices: source_indices)
  let right_is_optional = right.return_cardinality == v1.std.core.CardOptional
  let same_kind = if left_is_container && right_is_container {
    left_norm_name == v1.std.core.authored_name_at(source_indices: source_indices, node: right)
  } else if left_is_optional && right_is_optional {
    true
  } else { false }
  if same_kind && left_is_unit_inner { right }
  else if is_fully_resolved(n: right, source_indices: source_indices) && !is_fully_resolved(n: left, source_indices: source_indices) { right }
  else if left.connective == v1.std.core.NoConnective && left.children |> count == 0
    && (right.connective != v1.std.core.NoConnective || right.children |> count > 0)
    && v1.std.core.type_name_compatible(a: left_norm_name, b: v1.std.core.authored_name_at(source_indices: source_indices, node: right)) { right }
  else { left }
}

fn node_type_equals(left: v1.std.core.Node, right: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let left_err = if left.inferred != none { v1.std.core.is_compiler_error(inferred: left.inferred.value) } else { false }
  let right_err = if right.inferred != none { v1.std.core.is_compiler_error(inferred: right.inferred.value) } else { false }
  let left_tv = if left.inferred != none { is_type_variable(inferred: left.inferred.value) } else { false }
  let right_tv = if right.inferred != none { is_type_variable(inferred: right.inferred.value) } else { false }
  let left_opt = left.return_cardinality == v1.std.core.CardOptional
  let right_opt = right.return_cardinality == v1.std.core.CardOptional
  let right_is_unit_eq = is_unit_like(n: right)
  let left_is_unit_eq = is_unit_like(n: left)
  if left_err || right_err { true }
  else if left_tv && right_tv { true }
  else if left_tv || right_tv { false }
  else if left_opt && right_is_unit_eq { true }
  else if left_is_unit_eq && right_opt { true }
  else if left_opt && right_opt {
    node_type_equals_core(left: v1.std.core.with_required_cardinality(n: left), right: v1.std.core.with_required_cardinality(n: right), source_indices: source_indices)
  }
  else {
    node_type_equals_core(left: left, right: right, source_indices: source_indices)
  }
}

fn node_type_equals_core(left: v1.std.core.Node, right: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Bool {
  let left_leaf = left.connective == v1.std.core.NoConnective && left.children |> count == 0 && left.properties |> count == 0
  let right_leaf = right.connective == v1.std.core.NoConnective && right.children |> count == 0 && right.properties |> count == 0
  let left_struct = left.connective != v1.std.core.NoConnective
  let right_struct = right.connective != v1.std.core.NoConnective
  let left_name = v1.std.core.authored_name_at(source_indices: source_indices, node: left)
  let right_name = v1.std.core.authored_name_at(source_indices: source_indices, node: right)
  if left_leaf && right_leaf {
    v1.std.core.type_name_compatible(a: left_name, b: right_name)
  }
  else if left_struct && right_struct {
    if !v1.std.core.type_name_compatible(a: left_name, b: right_name) { false }
    else if (left.connective == v1.std.core.Conj) != (right.connective == v1.std.core.Conj) { false }
    else if left.children |> count != right.children |> count { false }
    else {
      left.children |> enumerate |> all(pair =>
        match right.children |> skip(pair.first) |> first {
          Present { value: right_child } => node_type_equals(left: pair.second, right: right_child, source_indices: source_indices)
          Absent => false
        }
      )
    }
  }
  else if left_leaf && right_struct {
    v1.std.core.type_name_compatible(a: left_name, b: right_name)
  }
  else if left_struct && right_leaf {
    v1.std.core.type_name_compatible(a: left_name, b: right_name)
  }
  else {
    let left_is_container = node_is_element_collection(n: left, source_indices: source_indices)
    let right_is_container = node_is_element_collection(n: right, source_indices: source_indices)
    if left_is_container && right_is_container {
      if left_name != right_name { false }
      else {
        match left.children |> first {
          Present { value: left_ch } =>
            match right.children |> first {
              Present { value: right_ch } => node_type_equals(left: child_type_node(ch: left_ch), right: child_type_node(ch: right_ch), source_indices: source_indices)
              Absent => false
            }
          Absent => false
        }
      }
    }
    else {
      let both_maps = node_is_keyed_collection(n: left, source_indices: source_indices) && node_is_keyed_collection(n: right, source_indices: source_indices)
      if both_maps {
        if left.children |> count == 2 && right.children |> count == 2 {
          match left.children |> first {
            Present { value: left_first } =>
              match right.children |> first {
                Present { value: right_first } =>
                  match left.children |> skip(1) |> first {
                    Present { value: left_second } =>
                      match right.children |> skip(1) |> first {
                        Present { value: right_second } =>
                          node_type_equals(left: child_type_node(ch: left_first), right: child_type_node(ch: right_first), source_indices: source_indices) && node_type_equals(left: child_type_node(ch: left_second), right: child_type_node(ch: right_second), source_indices: source_indices)
                        Absent => false
                      }
                    Absent => false
                  }
                Absent => false
              }
            Absent => false
          }
        } else {
          false
        }
      }
      else if left.params |> count > 0 && right.params |> count > 0 {
        if left.params |> count != right.params |> count { false }
        else {
          let params_eq = left.params |> enumerate |> all(pair =>
            match right.params |> skip(pair.first) |> first {
              Present { value: right_param } =>
                node_type_equals(left: v1.std.core.param_node_type_expr(n: pair.second), right: v1.std.core.param_node_type_expr(n: right_param), source_indices: source_indices)
              Absent => false
            }
          )
          if params_eq == false { false }
          else {
            match left.inferred {
              Present { value: v1.std.core.Resolved { node: left_ret } } =>
                match right.inferred {
                  Present { value: v1.std.core.Resolved { node: right_ret } } => node_type_equals(left: left_ret, right: right_ret, source_indices: source_indices)
                  Absent => false
                  _ => false
                }
              Absent => right.inferred == none
              _ => false
            }
          }
        }
      }
      else {
        false
      }
    }
  }
}

fn node_type_deps(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> List<String> {
  let n_is_type_var = if n.inferred != none { is_type_variable(inferred: n.inferred.value) } else { false }
  if n_is_type_var { return [] }
  let __is_named_ref = if n.inferred == none { false }
  else {
    match n.inferred {
      Present { value: v1.std.core.Resolved { node: rt } } =>
        rt.connective == v1.std.core.NoConnective && rt.children |> count == 0
          && rt.ident_span != none && v1.std.core.authored_name_at(source_indices: source_indices, node: rt) != "None"
          && std.types.is_kernel_type(name: v1.std.core.authored_name_at(source_indices: source_indices, node: rt)) == false
      _ => false
    }
  }
  let has_structure = n.connective != v1.std.core.NoConnective
  let n_name = v1.std.core.authored_name_at(source_indices: source_indices, node: n)
  if __is_named_ref {
    match n.inferred { Present { value: v1.std.core.Resolved { node: rt } } => [v1.std.core.authored_name_at(source_indices: source_indices, node: rt)]  _ => [] }
  } else if has_structure {
    flat_map(n.children, child =>
      match child.inferred {
        Present { value: v1.std.core.Resolved { node: rt } } => node_type_deps(n: rt, source_indices: source_indices)
        _ => if child.inferred == none { node_type_deps(n: child, source_indices: source_indices) } else { [] }
      }
    )
  } else if n.inferred != none {
    match n.inferred { Present { value: v1.std.core.Resolved { node: rt } } => node_type_deps(n: rt, source_indices: source_indices)  _ => [] }
  } else if n.children |> count > 0 {
    let child_deps = flat_map(n.children, child => node_type_deps(n: child, source_indices: source_indices))
    if n.ident_span != none && std.types.is_kernel_type(name: n_name) == false {
      concat([n_name], child_deps)
    } else { child_deps }
  } else if std.types.is_kernel_type(name: n_name) || n_name == "None" || n.ident_span == none {
    []
  } else {
    [n_name]
  }
}

fn infer_literal_node(lit: std.syntax.LiteralValue) -> v1.std.core.Node {
  match lit {
    LitStr { value: _ } => v1.std.core.string_type
    LitInt { value: _ } => v1.std.core.int_type
    LitFloat { value: _ } => v1.std.core.float_type
    LitBool { value: _ } => v1.std.core.bool_type
    LitNull => v1.std.core.with_optional_cardinality(n: v1.std.core.unit_type)

    LitSymbol { value: _ } => v1.std.core.string_type
  }
}

fn method_receiver_element_node(receiver_type: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node {
  let normed = normalize_access_type_node(n: receiver_type)
  let maybe_element = if node_is_keyed_collection(n: normed, source_indices: source_indices) {
    match normed.children |> skip(1) |> first {
      Present { value: ch } => Present { value: child_type_node(ch: ch) }
      Absent => none
    }
  } else if normed.connective == v1.std.core.NoConnective && normed.children |> count == 1 {
    match normed.children |> first {
      Present { value: ch } => Present { value: child_type_node(ch: ch) }
      Absent => none
    }
  } else {
    none
  }
  match maybe_element {
    Present { value: el } => el
    Absent => receiver_type
  }
}

fn extract_optional_inner_node(n: v1.std.core.Node) -> v1.std.core.Node {
  let is_optional = n.return_cardinality == v1.std.core.CardOptional
  if is_optional {
    v1.std.core.with_required_cardinality(n: n)
  } else if n.name == "Optional" && n.children |> count == 1 {

    match n.children |> first {
      Present { value: inner } => inner
      Absent => n
    }
  } else { n }
}

fn algebra_field_kind_name(kind: std.syntax.AlgebraFieldKind) -> String {
  match kind {
    AlgAdd => "add"
    AlgMul => "mul"
    AlgReciprocal => "reciprocal"
    AlgQuotient => "quotient"
    AlgRemainder => "remainder"
    AlgCompare => "compare"
    AlgMeet => "meet"
    AlgJoin => "join"
  }
}

fn binop_algebra_fields(op: std.syntax.BinOp) -> List<std.syntax.AlgebraFieldKind> {
  match op {
    Add => [std.syntax.AlgAdd]
    Sub => [std.syntax.AlgAdd]
    Mul => [std.syntax.AlgMul]
    Div => [std.syntax.AlgReciprocal, std.syntax.AlgQuotient]
    Mod => [std.syntax.AlgRemainder]
    Eq => [std.syntax.AlgCompare]
    Ne => [std.syntax.AlgCompare]
    Lt => [std.syntax.AlgCompare]
    Gt => [std.syntax.AlgCompare]
    Le => [std.syntax.AlgCompare]
    Ge => [std.syntax.AlgCompare]
    And => [std.syntax.AlgMeet]
    Or => [std.syntax.AlgJoin]
    NullCoalesce => []
  }
}

type AlgebraFieldMatch {
  field_kind: std.syntax.AlgebraFieldKind
  field_node: v1.std.core.Node
}

fn first_matching_algebra_field(n: v1.std.core.Node, candidates: List<std.syntax.AlgebraFieldKind>, source_indices: Map<String, v1.std.core.NewlineIndex>) -> AlgebraFieldMatch? {
  match candidates |> first {
    Absent => none
    Present { value: kind } =>
      match v1.std.core.find_child_named(n: n, name: algebra_field_kind_name(kind: kind), source_indices: source_indices) {
        Present { value: f } => Present { value: AlgebraFieldMatch { field_kind: kind, field_node: f } }
        Absent => first_matching_algebra_field(n: n, candidates: candidates |> skip(1), source_indices: source_indices)
      }
  }
}

type BinOpInferred {
  result_type: v1.std.core.Node
  algebra_field: std.syntax.AlgebraFieldKind?
}

fn infer_binop_type_node(op: std.syntax.BinOp, left_type: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> BinOpInferred {
  match op {
    Eq => BinOpInferred { result_type: v1.std.core.bool_type, algebra_field: none }
    Ne => BinOpInferred { result_type: v1.std.core.bool_type, algebra_field: none }
    Lt => BinOpInferred { result_type: v1.std.core.bool_type, algebra_field: none }
    Gt => BinOpInferred { result_type: v1.std.core.bool_type, algebra_field: none }
    Le => BinOpInferred { result_type: v1.std.core.bool_type, algebra_field: none }
    Ge => BinOpInferred { result_type: v1.std.core.bool_type, algebra_field: none }
    And => BinOpInferred { result_type: v1.std.core.bool_type, algebra_field: none }
    Or => BinOpInferred { result_type: v1.std.core.bool_type, algebra_field: none }
    NullCoalesce => BinOpInferred { result_type: extract_optional_inner_node(n: left_type), algebra_field: none }
    _ =>
      let candidates = binop_algebra_fields(op: op)
      let is_product = left_type.connective == v1.std.core.Conj
      if is_product {
        match first_matching_algebra_field(n: left_type, candidates: candidates, source_indices: source_indices) {
          Present { value: m } =>
            match m.field_node.inferred {
              Present { value: v1.std.core.Resolved { node: rt } } =>
                if rt.params |> count > 0 {
                  match rt.inferred {
                    Present { value: v1.std.core.Resolved { node: return_type } } => BinOpInferred { result_type: return_type, algebra_field: Present { value: m.field_kind } }
                    _ => BinOpInferred { result_type: left_type, algebra_field: Present { value: m.field_kind } }
                  }
                } else { BinOpInferred { result_type: rt, algebra_field: Present { value: m.field_kind } } }
              _ => BinOpInferred { result_type: left_type, algebra_field: none }
            }
          Absent => BinOpInferred { result_type: left_type, algebra_field: none }
        }
      } else { BinOpInferred { result_type: left_type, algebra_field: none } }
  }
}

fn for_each_element_type_node(n: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> v1.std.core.Node {
  let normed = normalize_access_type_node(n: n)
  let is_single_child = normed.connective == v1.std.core.NoConnective && normed.children |> count == 1
  let extracted = if is_single_child {
    match normed.children |> first {
      Present { value: ch } => Present { value: child_type_node(ch: ch) }
      Absent => none
    }
  } else { none }
  match extracted {
    Present { value: el } => el
    Absent =>
      if normed.connective == v1.std.core.NoConnective && normed.children |> count == 0 && normed.properties |> count == 0 && v1.std.core.qualified_last_segment(name: v1.std.core.authored_name_at(source_indices: source_indices, node: normed)) == "String" { v1.std.core.string_type }
      else { normed }
  }
}

fn emit_map_has(m: Map<String, Bool>, key: String) -> Bool {
  match map_get(m, key) {
    Present { value: _ } => true
    Absent => false
  }
}
