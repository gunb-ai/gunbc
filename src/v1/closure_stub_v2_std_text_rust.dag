module v1.compiler.closure_stub_v2_std_text_rust

// dissolve-on (FreeMonoid pass 2026-07-20): NOT a second v2.std.text authority — a minimal closure
// projection when narrow typed.modules omits v2.std.text but emitted refs need
// crate::v2_std_text::. Dissolves when emit_lib_rs_from_paths derives pub-mod membership from the
// emitted ref set and emits the real v2.std.text module instead.

fn closure_stub_v2_std_text_source() -> String {
  concat(
    "// Generated closure stub — dissolve-on: derive from emitted ref set\n",
    "// Source module: v2.std.text (closure projection; std_algebra + std_types only)\n\n",
    "use std::rc::Rc;\n",
    "use crate::std_types::Char;\n\n",
    "pub type String = Rc<crate::std_algebra::FreeMonoid<Char>>;\n"
  )
}
