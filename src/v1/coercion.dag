fn target_checkpoints(target: RenderTarget) -> List<TypeCheckpoint> {
  match target {
    Rust => rust_type_checkpoints
    Python => python_type_checkpoints
    Go => go_type_checkpoints
    Dag => dag_type_checkpoints
  }
}

fn target_inhabitants(target: RenderTarget) -> List<InhabitantDecl> {
  match target {
    Rust => rust_algebra_inhabitants
    Python => python_algebra_inhabitants
    Go => go_algebra_inhabitants
    Dag => []
  }
}

fn target_callable(target: RenderTarget) -> CallableRepr {
  match target {
    Rust => rust_callable
    Python => python_callable
    Go => go_callable
    Dag => CallableRepr {
      template: "fn(\{params\}) -> \{return\}",
      param_separator: ", ",
      return_separator: " -> ",
      import_path: none
    }
  }
}

fn target_optional_template(target: RenderTarget) -> String {
  match target {
    Rust => rust_optional_template
    Python => python_optional_template
    Go => go_optional_template
    Dag => "\{0\}?"
  }
}

fn target_cast_syntax(target: RenderTarget) -> CastSyntax? {
  match target {
    Rust => Present { value: rust_cast_syntax }
    Python => Present { value: python_cast_syntax }
    Go => Present { value: go_cast_syntax }
    Dag => none
  }
}

fn can_cast(target: RenderTarget, source_type: String, target_type: String) -> Bool {
  match target_cast_syntax(target: target) {
    Present { value: syntax } => syntax.cast_rules |> any(r => r.from_type == source_type && r.to_type == target_type)
    Absent => false
  }
}

fn render_cast(expr_str: String, type_str: String, target: RenderTarget) -> String {
  let syntax = match target_cast_syntax(target: target) {
    Present { value: s } => s
    Absent => CastSyntax { template: "\{expr\}", cast_rules: [] }
  }
  replace(replace(syntax.template, "\{expr\}", expr_str), "\{type\}", type_str)
}

// THE IDENTITY OF A DECLARATION, AS A STATE SPACE RATHER THAN AS A STRING. The value threaded to
// every realization gate used to be a file path, and it carried three disjoint inhabitants in one
// String: a real corpus file, the synthetic pseudo-file the kernel mints for a node with no
// declaration, and the empty string meaning identity is unknown. Every consumer discriminated only
// empty from non-empty, so the other two were told apart -- where they were told apart at all -- by
// four separate spelling tests scattered across the emitter.
//
// The kernel arm is EXACT EQUALITY AGAINST THE MINTER, not a prefix test. v1.std.core kernel_span
// is what synthesizes the pseudo-file, and every kernel construction in the seed sets
// ident_span: kernel_span(name: <the node's own name>) beside name: <that same name> -- so
// comparing the span's file to kernel_span(name: item.name).file asks the constructor whether it
// built this node. That is why no fifth spelling test appears here: the four that existed are
// deleted rather than joined.
//
// CAVEAT ON THAT DERIVATION, recorded because it bounds what this construction may CLAIM. There are
// TWO declarations of kernel_span -- v1.std.core's and v1.compiler.infer's -- with byte-identical
// bodies, and v1.compiler.infer's own call sites bind its local twin by shadowing. This module
// consumes v1.std.core's. The derivation is exact TODAY BECAUSE the two bodies agree, which is a
// coincidence the tree does not enforce: nothing refuses if one is edited. So this is a consumption
// of the authority this module imports, and NOT a consolidation of the two.

data type_reference_identity_note: String = "A realization decision is made at REFERENCE sites, not only at the declaration site, so every site that asks what a named type realizes as must supply that name's resolved declaring identity. THAT IDENTITY IS NO LONGER A STRING AND NO LONGER TRAVELS. It was a decl_file path threaded to ninety-five call sites, each of which then asked a gate here to make the same decision at the periphery; DESIGN section 3 says the dispatch that selects a realization is itself realization and sits peripheral rather than in the interface, and a ninety-five-site-wide identity channel was that sentence inverted. The decision is taken once, at type_reference_realization (reference sites) or declaration_realization (declaration sites), and what travels to the renderers is a std.coercion TypeRealizationDecision. A NAME MAY STILL BE A STRING; AN IDENTITY MAY NOT -- dag_name stays a parameter because which peel of a reference is meant (authored spelling, fn-sig leaf, qualified last segment) is a fact the SITE holds and no mint can derive without guessing. The regression this note has always existed to prevent is unchanged and is now unwritable rather than merely warned about: passing the empty string used to mean identity unknown, and a site that omitted identity rendered structurally in silence -- the seed's own dag/std/integer.dag aliases once rendered as crate::std_nat::Nat instead of i64 because eight reference sites passed an empty identity. There is no empty string to pass. An absent identity is std.coercion DeclarationIdentityAbsent, and the answer it still reaches from the bare table is stamped GroundedByUnidentifiedBareRow so that a declared drop is countable instead of indistinguishable from a keyed answer. Homed in v1.compiler.coercion rather than v1.compiler.emit_rust because the decision is target-generic and shared by v1.compiler.emit as well; the provenance itself and its recognizer are homed further down still, in std.coercion and v1.std.core beside the kernel_span minter they read."

fn structural_declaration_modules_for(dag_name: String) -> List<String> {
  match dag_name {
    "Hash" => ["src/v2/std/node.dag"]
    "String" => ["src/v2/std/text.dag", "dag/std/string_type.dag"]
    "Bool" => ["src/v2/std/logic.dag"]
    _ => []
  }
}

data structural_declaration_gate_note: String = "Companion to checkpoint_table_bypasses_identity_note (v1.compiler.emit_rust): a checkpoint row states how a target spells a name, never which declaration that name resolves to at a given reference site, so a bare-name-keyed table cannot by itself discriminate a name with two competing declarations. structural_declaration_modules_for is the corpus-side half DESIGN section 3 requires kept OUT of the extdeps row -- a row per colliding dag_name naming the module(s) whose declaration of that name is a structural (non-checkpoint-eligible) realization, never a positive roster of every module that realizes natively (that shape already exists for Nat/Int as numeric_realization_declaring_modules, below in this same module since the 2026-08-21 relocation off v1.compiler.emit_rust, because those two have a genuine native declaring module to match against). Hash has no native dag declaration anywhere -- lookup_checkpoint's row for Hash exists only because the seed's own runtime type happens to share the spelling -- so the correct gate is inverted: refuse the row when the reference resolves to the KNOWN structural declaration, and let every other decl_file (including unknown, the empty string) continue to answer from the row exactly as before. Widening this roster is bound by the same discipline numeric_realization_roster_extension_note states for the positive form: a name is added here because its structural declaration is a fact already true, never to silence a diagnostic at some call site by declaring victory over it."

// The roster is a list of corpus FILE PATHS matched by contains, and that is the residue this
// change deliberately does not remove: what the declaration REALIZES AS is still answered
// positionally. What it does remove is the two arms that were never paths at all -- a kernel mint
// can no longer be compared against a roster of real paths (it never matched, so the gate was
// unreachable for it by construction rather than by decision), and an absent identity is refused
// upstream rather than falling through a string comparison. v1.compiler.infer_env
// global_bare_fallback_invariant already states the terminal key for the surviving arm: filepaths
// are irrelevant, the declared module path is the containment tree.
fn provenance_declares_structurally(dag_name: String, p: TypeDeclarationProvenance) -> Bool {
  match p {
    CorpusDeclared { decl_file: f } => structural_declaration_modules_for(dag_name: dag_name) |> any(m => contains(f, m))
    KernelMinted { minted_name: _ } => false
    DeclarationIdentityAbsent => false
  }
}

data numeric_realization_identity_note: String = "Realization is keyed on the DECLARING MODULE of the type, never on the authored spelling alone. Two declarations may share a spelling -- std.nat.Nat is CommutativeSemiring<Magnitude> and realizes natively, while v2.std.nat.Nat is the Peano coproduct Zero|Succ and must NOT -- so a bare-name rule realizes the wrong one. decl_file is the resolved declaration's ident_span file; the empty string means identity is UNKNOWN at this site, which yields NO realization (render structurally) rather than a guess. This replaces the deleted rust_corpus_repr closure-provenance switch: what a declaration realizes as is a fact about that declaration and its target, never about which other sources happen to share the closure. RELOCATED here from v1.compiler.emit_rust (smart-ram-730, adhoc-2ea6fb98-a3f, 2026-08-21, review 54335) alongside numeric_realization_roster_extension_note, numeric_realization_declaring_modules, decl_file_realizes_natively and rust_seed_host_numeric_alias -- completing the relocation structural_declaration_modules_for's own precedent already established for the negative-form (structural) half of this two-authority shape; emit_rust now imports rust_seed_host_numeric_alias back from here exactly as it already imports lookup_checkpoint, one direction, no cycle. See v1.compiler.emit_rust numeric_realization_relocation_note for the fuller account."

data numeric_realization_roster_extension_note: String = "THIS ROSTER IS A LIVE ENUMERATION AND A ROW MAY ONLY BE ADDED FOR A DECLARATION WHOSE NATIVE REALIZATION IS ALREADY TRUE, NEVER TO MAKE A FAILING SITE COMPILE. A module belongs here when the types it declares ARE the host numeric type at the target -- dag/std/nat.dag and dag/std/integer.dag are the two grounded numeric authorities, and the <kernel: prefix covers declarations the seed mints with no source file. Adding a module to silence an E0308 or an E0109 at some call site is the §5 workaround: it converts one site's diagnostic into a corpus-wide realization change, and it does so by editing the roster rather than the fact the roster reports. The tell is that the author cannot say what the added module's type IS at the target without referring to the site that failed. If a site needs a realization this roster does not grant, the question is whether that declaration is genuinely a host numeric -- and if it is not, the fix is at the site or in the checkpoint binding, never here. This enumeration is itself provisional: it exists because there is no corpus-side declaration-to-Rust-type binding yet, and it dissolves into that binding when it lands -- see checkpoint_table_bypasses_identity_note for the two-authority shape."

// THE ROSTER IS NOW MODULES ONLY. It used to carry a fourth entry, the literal "<kernel:", which
// was a magic string sitting in a list of real module paths so that a kernel-minted node would
// substring-match it and be answered natively. That is the same fact the KernelMinted arm below
// states as a constructor, so the row is deleted rather than kept beside it: a roster of module
// paths that also has to be readable as a sentinel is two authorities wearing one type.
fn numeric_realization_declaring_modules() -> List<String> {
  ["dag/std/nat.dag", "dag/std/integer.dag"]
}

// ANSWER PRESERVED EXACTLY. A kernel-minted node matched the deleted "<kernel:" row and was
// answered natively; it is answered natively here, by an arm that says so. An absent identity
// returned false through an empty-string guard; it returns false through its own arm.
fn provenance_realizes_natively(p: TypeDeclarationProvenance) -> Bool {
  match p {
    CorpusDeclared { decl_file: f } => numeric_realization_declaring_modules() |> any(m => contains(f, m))
    KernelMinted { minted_name: _ } => true
    DeclarationIdentityAbsent => false
  }
}

fn provenance_host_numeric_alias(name: String, p: TypeDeclarationProvenance) -> String? {
  if (name == "Nat" || name == "Int") && provenance_realizes_natively(p: p) {
    Present { value: "i64" }
  } else {
    none
  }
}

// SUPERSESSION HEADER FOR EVERY NOTE BETWEEN HERE AND type_realization_decision BELOW, added rather
// than editing them in place, because these paragraphs carry REASONING whose conclusions still hold
// and whose premises named a shape that no longer exists. A silent rewrite would erase the argument
// that produced the decision; a stale citation would send a reader to a symbol that is gone. So the
// history stands and this paragraph states what moved.
//
// WHAT MOVED (2026-09-02). The identity key is no longer a `decl_file: String` threaded to the
// periphery. It is std.coercion TypeDeclarationProvenance, minted from the node by v1.std.core
// declaration_provenance_of, and the DECISION is taken once at the mint rather than at each caller.
// Read the notes below with these substitutions: `lookup_checkpoint` is type_realization_decision
// reached through realized_checkpoint; `decl_file_declares_structurally` is
// provenance_declares_structurally; `decl_file_realizes_natively` is provenance_realizes_natively;
// `rust_seed_host_numeric_alias` is provenance_host_numeric_alias, and its peripheral question is
// now answered by realization_is_host_numeric off the decision's ground; `is_kernel_minted_file` is
// DELETED with no successor predicate, because the state it tested for is a constructor.
//
// WHAT DID NOT MOVE, AND IS THE REASON THESE NOTES ARE KEPT: every ANSWER is preserved bit for bit.
// The `decl_file == ""` bypass these paragraphs argue about at length still answers from the bare
// table -- it is now the DeclarationIdentityAbsent arm of type_realization_decision, and it stamps
// its answer GroundedByUnidentifiedBareRow so the declared drop is countable rather than
// indistinguishable. Its restoration trigger below is UNCHANGED and is NOT discharged by this
// change: threading identity was never the missing capability, and what these notes call
// "threaded with decl_file" is now "reached with a provenance that is not DeclarationIdentityAbsent".
// The surviving positional residue is likewise unchanged: CorpusDeclared still carries a path
// matched by contains, so WHAT a declaration realizes as is still answered by file rather than by
// the declared module path v1.compiler.infer_env global_bare_fallback_invariant names as the key.

// The DeclarationRef -> target-realization query the map-key-alias-hop and derive-set-narrowing
// lanes are both blocked on (v1.compiler.trait_derive_emit map_key_alias_hop_gap_note):
// generalizes decl_file_declares_structurally's single Hash row into one derived decision any
// declaration-identity-aware consumer can call directly, instead of re-deriving Present/Absent and
// re-discovering the structural gate per call site. Keyed on (dag_name, decl_file) rather than a
// minted std.decl_ref.DeclarationRef: decl_file is already threaded to every production call site
// (type_reference_identity_note above) and module_storage_binding_authority_note
// (v2.compiler.source_authority) establishes file<->module as the LIVE 1:1 binding this tree
// enforces today, so decl_file is a faithful identity key for this decision without a new
// module_path lookup -- a real cost (a corpus-wide file->module_path index is not yet exposed to
// .dag land; data_initializer_identity.rs module_path_for_type_decl_node is the one host precedent
// and it is Rust-internal) that buys nothing this decision needs, since decl_name + decl_file
// already discriminate every specimen the gap note names (Hash vs Int/Nat, same-spelling-
// different-declaration). Adopting the full std.decl_ref.DeclarationRef triple is deferred to the
// first consumer that needs the human-readable module_path rather than identity equality (DESIGN
// section 6 pricing discipline), and this note is that deferral's record. RealizationRefused is a genuinely
// NEW answer this decision introduces -- no existing lookup_checkpoint call site can regress into
// it, because lookup_checkpoint below preserves its exact prior decl_file=="" fallback rather than
// routing that case through this decision.
//
// GAP CLOSED (smart-ram-730, adhoc-2ea6fb98-a3f, 2026-08-21, review 54335 on top of review 54323
// finding 2's own landing): this decision previously answered Unrealized for Nat/Int declared at
// their genuine native modules (dag/std/nat.dag, dag/std/integer.dag, the kernel), which was
// wrong -- those two realize natively as i64 in the Rust target. numeric_realization_declaring_modules,
// decl_file_realizes_natively and rust_seed_host_numeric_alias, formerly a separate positive roster
// in v1.compiler.emit_rust that this decision could not import without closing a cycle (emit_rust
// already imports FROM this module), are now RELOCATED into this module (above, beside
// target_checkpoints and structural_declaration_modules_for) and consulted directly below with no
// import at all -- completing the relocation structural_declaration_modules_for's own precedent
// already established for the negative-form half of this two-authority shape
// (checkpoint_table_bypasses_identity_note, v1.compiler.emit_rust). emit_rust now imports
// rust_seed_host_numeric_alias back from here, one direction, no cycle; see
// numeric_realization_relocation_note there for the fuller account. This decision's Realized
// branch is exercised by test.claim.map_key_alias_hop_witness's negative case (a locally-declared
// alias reusing a checkpoint dag_name, so this decision answers Realized rather than Unrealized,
// and the aliased record correctly does not gain a derive) -- that fixture demonstrates the
// mechanism generically rather than naming Nat/Int specifically, because dag/test/claim witnesses
// cannot import v1.compiler.* directly (only src/v1 sees this module; the required floor's
// source roots do not) and so cannot call this decision against the real dag/std/integer.dag or
// dag/std/nat.dag declarations the way a src/v1-hosted test could. A dedicated same-spelling-
// different-decl_file pair naming Nat/Int through THIS decision specifically remains unwitnessed
// for that structural reason, the same residue class checkpoint_identity_keying_witness_test
// already documents for five of its own seven rows (checkpoint_identity_keying_migration_note) --
// not a new gap this relocation introduces.
//
// DERIVE-SET-NARROWING ALIAS HOP: LANDED (tidy-raven-252, adhoc-be86d536-532, 2026-08-23).
// The sibling consumer named here now asks this decision through lookup_checkpoint while building
// the function-reachability graph in v1.compiler.infer_emit_info. A structural alias contributes
// its resolved RHS names (and a separate direct-arrow fact, because an Arrow has no authored name)
// to the SAME transitive closure that already handles direct fields, containers and coproduct
// payloads. A Rust-native alias contributes neither: its declared RHS is not the representation the
// emitter writes, so traversing it would recreate the Int/Nat false-positive class this decision
// was introduced to prevent. The derive selector still consumes one has_fn_fields answer and emits
// Clone alone; no alias-specific derive roster exists. Executing controls live in
// test.claim.function_derive_alias_hop_witness: structural alias to fn narrows, native Bytes alias
// does not, and structural alias to a plain record stays full-derive. No population count is claimed
// here: the earlier per-code boards use incompatible subjects and refs, and cross-code partitioning
// owns any later census rather than this producer repair.
// THIS IS THE ONE PLACE THE ROSTERS ARE CONSULTED, and after this change it is the only place any
// caller reaches them. The absent-identity arm is the bare-table bypass that used to live in
// lookup_checkpoint as a String comparison against "": it answers exactly what it answered before,
// and now says so with GroundedByUnidentifiedBareRow, so an answer given without a declaration is
// countable instead of indistinguishable. Nothing here changed WHAT is answered; what changed is
// that each answer names the ground it stands on.
fn type_realization_decision(
  target: RenderTarget, dag_name: String, provenance: TypeDeclarationProvenance
) -> TypeRealizationDecision {
  match provenance {
    DeclarationIdentityAbsent =>
      match target_checkpoints(target: target) |> filter(cp => cp.dag_name == dag_name) |> first {
        Present { value: cp } => Realized { checkpoint: cp, ground: GroundedByUnidentifiedBareRow }
        Absent => RealizationRefused { cause: DeclarationIdentityUnavailable }
      }
    _ =>
  if provenance_declares_structurally(dag_name: dag_name, p: provenance) {
    Unrealized
  } else if target == Rust && !rust_checkpoint_row_keeps_bare_row(dag_name: dag_name) {
    RealizationRefused { cause: BareRowMigratedToExactBinding { dag_name: dag_name } }
  } else {
    match target_checkpoints(target: target) |> filter(cp => cp.dag_name == dag_name) |> first {
      Present { value: cp } => Realized { checkpoint: cp, ground: GroundedByCheckpointRow }
      Absent =>
        let native = if (target == Rust) { provenance_host_numeric_alias(name: dag_name, p: provenance) } else { none }
        match native {
          Present { value: host } => Realized { checkpoint: TypeCheckpoint { dag_name: dag_name, target_type: host, grounding_type: host, default_expr: none, is_copy: none, literal_suffix: none }, ground: GroundedByHostNumericAlias }
          Absent => Unrealized
        }
    }
  }
  }
}

// Rust-target closure over the native-numeric gap (review 54323 finding 2): Nat/Int declared at
// dag/std/nat.dag or dag/std/integer.dag (or minted by the kernel) answer Realized with a
// synthesized TypeCheckpoint (target_type: "i64", the same string rust_seed_host_numeric_alias
// (v1.compiler.emit_rust) always returned) rather than Unrealized -- restoring the fifth
// discriminating witness this decision was landed without: Nat at dag/std/nat.dag now answers
// Realized:i64 while Nat at src/v2/std/nat.dag continues to answer Unrealized, for the same
// declaration-identity reason the Hash witness already demonstrated (decl_file discriminating two
// declarations sharing a spelling), not merely two different Unrealized causes. Gated on
// target == Rust because rust_seed_host_numeric_alias is a Rust-target fact (its name says so) and
// this decision is target-generic across Rust/Python/Go/Dag; applying it unconditionally would
// answer Realized:i64 for a Python or Go render that has no such native alias. The synthesized
// TypeCheckpoint's non-target_type fields (default_expr, is_copy, literal_suffix) are none rather
// than guessed, matching what rust_seed_host_numeric_alias itself has always carried -- it returns
// a bare String, not a full checkpoint row, so this decision is not inventing information the prior
// mechanism lacked.

// decl_file == "" is NOT routed through type_realization_decision's RealizationRefused arm here: dozens of
// production call sites across v1.compiler.emit_rust and v1.compiler.emit already pass an empty
// decl_file expecting the bare-name table answer (the behavior type_reference_identity_note
// documents and depends on), and widening this function's refusal to cover them is an unmeasured,
// unowned behavior change across files this module does not write. type_realization_decision is
// the strict, honestly-refusing primitive for a NEW caller that has never before answered this
// question (the alias-hop arm this pair of functions exists to unblock); lookup_checkpoint stays
// byte-behavior-identical to its prior definition for every existing caller, now expressed as a
// thin derivation of the same decision so there is one authority underneath both answers, not two.
// This short-circuit is behavior-preserving only because decl_file_declares_structurally(dag_name,
// "") is false by construction (its own decl_file == "" guard above returns false before
// consulting structural_declaration_modules_for) -- so decl_file == "" can never reach
// type_realization_decision's Unrealized-via-structural-gate arm even if this bypass were removed,
// and the two branches of this if are answering the SAME underlying decision for the empty-
// identity case, not two independently-diverging ones (smart-ram-730, adhoc-2ea6fb98-a3f review,
// 2026-08-21, review 54292).
//
// DECLARED RESIDUE (DESIGN section 3, dual authority with a stated end, not a silent fork): this
// cut does NOT supersede lookup_checkpoint's existing decl_file=="" bypass -- it narrows it. The
// tree now answers 'what does this name realize as' two ways: type_realization_decision, which
// refuses on unknown identity and is the authority every NEW caller must answer from, directly or
// through lookup_checkpoint's decl_file != "" arm (a thin derivation of this same decision, not a
// second one -- v1.compiler.trait_derive_emit's alias-hop arm, gunbc#8736, reaches it this way,
// per map_key_alias_hop_reconciliation_note there); and lookup_checkpoint's
// decl_file=="" arm, which still answers from the bare-name table alone for every EXISTING caller
// across v1.compiler.emit_rust and v1.compiler.emit that has never supplied identity. The residue
// population is exactly those existing call sites, not counted here (a corpus-wide count is a
// separate, costed measurement, not asserted by this note). TRIGGER: this residue retires when
// those call sites are threaded with decl_file (the same identity-threading
// type_reference_identity_note already did for the sites that DO supply it) and measured to still
// answer correctly under type_realization_decision -- at which point decl_file=="" stops being a
// legitimate steady state for a production call site and lookup_checkpoint's bypass arm deletes,
// leaving type_realization_decision as the sole authority. Until then this is a declared, bounded
// narrowing, not a completed supersession.
// THE MINT. This is the single entry point every realization question now enters through, and it is
// the whole of the change: the decision is taken HERE, from the node, and what travels to the
// renderers is the answer. Before, a String identity key was threaded to ninety-five sites so that
// each could ask lookup_checkpoint to make this same decision at the periphery -- DESIGN section 3
// says the dispatch that selects a realization is itself realization and sits peripheral, never in
// the interface, and a ninety-five-site-wide identity channel was that sentence inverted.
//
// A NAME MAY BE A STRING; AN IDENTITY MAY NOT. dag_name stays a parameter deliberately. Which peel
// of a reference is meant -- the authored spelling, the fn-sig leaf, the qualified last segment --
// is a fact the SITE holds and this function cannot derive; guessing it would be a heuristic
// standing exactly where a richer source was available.
fn type_reference_realization(n: Node, dag_name: String, target: RenderTarget) -> TypeRealizationDecision {
  type_realization_decision(target: target, dag_name: dag_name, provenance: type_reference_provenance(n: n))
}

// The declaration-site counterpart, for a caller holding the declaration item itself rather than a
// reference to it.
fn declaration_realization(item: Node, dag_name: String, target: RenderTarget) -> TypeRealizationDecision {
  type_realization_decision(target: target, dag_name: dag_name, provenance: declaration_provenance_of(item: item))
}

fn realized_checkpoint(decision: TypeRealizationDecision) -> TypeCheckpoint? {
  match decision {
    Realized { checkpoint: cp, ground: _ } => Present { value: cp }
    Unrealized => none
    RealizationRefused { cause: _ } => none
  }
}

// Whether this realization is the host numeric alias rather than a checkpoint row. Consumers used
// to ask this by calling the numeric roster a second time with the same name and file; the ground
// answers it from the decision they already hold.
fn realization_is_host_numeric(decision: TypeRealizationDecision) -> Bool {
  match decision {
    Realized { checkpoint: _, ground: GroundedByHostNumericAlias } => true
    _ => false
  }
}

fn realization_host_numeric_spelling(decision: TypeRealizationDecision) -> String? {
  match decision {
    Realized { checkpoint: cp, ground: GroundedByHostNumericAlias } => Present { value: cp.target_type }
    _ => none
  }
}

// THE EXACT PATH. A caller holding the resolved declaration (std.decl_ref DeclarationRef) answers
// from gunbc.rust_source_type_bindings, keyed on the declaration and never on its spelling, and the
// spelling it receives is the fully qualified one extdeps.languages.rust.representation carries for
// the bound representation. The three non-resolving arms are typed and located: absent (render the
// declaration; a refusal only where the declaration is opaque, which the renderer decides), ambiguous
// (two rows for one declaration -- corpus authoring defect), and identity unavailable (the caller
// reached a declaration-keyed authority with a spelling -- the bare-name fallback this path deletes).
// No arm consults rust_type_checkpoints.
fn rust_lookup_exact_binding(source: DeclarationRef?) -> ExactBindingResolution<RustRepresentation> {
  resolve_exact_binding(source: source, rows: rust_source_type_binding_rows)
}

// The decision the emitter and std.reference_realization already consume, produced from the exact
// path: a synthesized TypeCheckpoint whose dag_name is the DECLARATION's name and whose two spellings
// are the representation's qualified reference/grounding spellings. A bound representation with no
// realization row (RustSymbolNewtype, RustInternedSymbol) refuses rather than inventing a spelling.
fn rust_exact_realization_decision(source: DeclarationRef?) -> TypeRealizationDecision {
  match rust_lookup_exact_binding(source: source) {
    ResolvedExactBinding { binding: b } =>
      match rust_exact_type_checkpoint(binding: b) {
        Present { value: cp } => Realized { checkpoint: cp, ground: GroundedByCheckpointRow }
        Absent => RealizationRefused { cause: BoundRepresentationHasNoRealizationRow { decl_name: b.source.decl_name as String } }
      }
    ExactBindingAbsent => Unrealized
    ExactBindingAmbiguous { candidate_count: _ } => RealizationRefused { cause: ExactBindingAmbiguousForOneDeclaration }
    ExactSourceIdentityUnavailable { cause: c } => RealizationRefused { cause: ExactSourceIdentityAbsent { detail: c } }
  }
}

// Whether a bare-name row may still answer for this spelling: every row of rust_type_checkpoints
// carries a verdict in gunbc.rust_source_type_bindings, and a name with no verdict is not a table
// row at all (false here means the spelling-keyed arm refuses for it). Consulted by
// type_realization_decision ahead of the table so a Migrated name cannot be answered by spelling.
// Whether a DECLARATION realizes natively on the Rust target: the exact binding first
// (gunbc.rust_source_type_bindings), then the spelling-keyed checkpoint under the declaration's own
// identity gate (lookup_checkpoint, which refuses a known structural declaration and honours the
// bare-row verdicts). This is the ONE question std.literal_elaboration and std.operator_realization
// ask of the target (XL-0N): a native declaration takes the kernel literal and the host operator
// directly; anything else is a structural operand.
fn declaration_realizes_natively_on_rust(declaration: DeclarationRef, spelling_decision: TypeRealizationDecision) -> Bool {
  match rust_exact_realization_decision(source: Present { value: declaration }) {
    Realized { checkpoint: _, ground: _ } => true
    _ => realized_checkpoint(decision: spelling_decision) != none
  }
}

fn rust_checkpoint_row_keeps_bare_row(dag_name: String) -> Bool {
  if dag_name == "" { false }
  else {
    match checkpoint_row_migration_for(dag_name: dag_name as NonEmptyStr, migrations: checkpoint_row_migration_rows()) {
      Present { value: m } => checkpoint_row_disposition_keeps_bare_row(disposition: m.disposition)
      Absent => true
    }
  }
}

data coerce_primitive_type_dotted_fallback_note: String = "Construction wall for the dotted-render class in TYPE position (sibling of variant_pattern_dotted_qualification_note in v1.compiler.05_emit_rust, which as of 2026-08-21 covers every position that emits a Rust Parent::Variant path, enumerated by producer rather than by position). Every target's checkpoint dag_names are bare (Int, String, ...), so a namespace-QUALIFIED type name (post source_authority, e.g. v2.std.node.Edge) never matches a checkpoint and previously fell through this Absent arm verbatim, dots and all -- not a valid identifier in any target language, a PARSE error masking every later diagnostic in the module. Rendering a type never needs a crate::-qualified path here (this fn is target-agnostic, shared by Rust/Python/Go/Dag, and the existing convention across all of them is a bare type name; qualification, where a target needs it, is a separate import-line-synthesis seam) so the fix is to route the fallback through qualified_last_segment (v1.std.core, the same single authority rust_variant_path reuses) instead of forking a second dotted-name fallback. Every already-bare dag_name renders exactly as before (qualified_last_segment is the identity on an unqualified name)."

fn coerce_primitive_type(decision: TypeRealizationDecision, dag_name: String) -> String {
  match realized_checkpoint(decision: decision) {
    Present { value: cp } => cp.target_type
    Absent => qualified_last_segment(name: dag_name)
  }
}

fn is_copy(decision: TypeRealizationDecision) -> Bool? {
  match realized_checkpoint(decision: decision) {
    Present { value: cp } => cp.is_copy
    Absent => none
  }
}

fn literal_suffix(decision: TypeRealizationDecision) -> String? {
  match realized_checkpoint(decision: decision) {
    Present { value: cp } => match cp.literal_suffix {
      Present { value: s } => Present { value: s }
      Absent => Present { value: "" }
    }
    Absent => none
  }
}

fn lookup_inhabitant(target: RenderTarget, algebra: String) -> InhabitantDecl? {
  target_inhabitants(target: target) |> filter(inh => inh.algebra == algebra) |> first
}

fn coerce_container_template(target: RenderTarget, container_name: String) -> String? {
  match container_template_algebra(name: container_name) {
    Present { value: algebra } => match lookup_inhabitant(target: target, algebra: algebra) {
      Present { value: inh } => Present { value: inh.template }
      Absent => none
    }
    Absent => none
  }
}

fn apply_inhabitant_template1(template: String, inner: String) -> String {
  replace(template, "\{0\}", inner)
}

fn apply_inhabitant_template2(template: String, first: String, second: String) -> String {
  replace(replace(template, "\{0\}", first), "\{1\}", second)
}

type CoercionAssertion
  = CheckpointAssertion { target: RenderTarget, dag_name: String, expected_type: String }
  | ContainerAssertion { target: RenderTarget, container_name: String, expected_template: String }
  | CopyAssertion { target: RenderTarget, dag_name: String, expected_copy: Bool }
  | TemplateAssertion { template: String, args: List<String>, expected: String }

type CoercionTestEntry {
  test_name: String
  assertions: List<CoercionAssertion>
}

fn target_label(target: RenderTarget) -> String {
  match target {
    Rust => "rust"
    Python => "python"
    Go => "go"
    Dag => "dag"
  }
}

fn checkpoint_tests(target: RenderTarget) -> List<CoercionTestEntry> {
  let label = target_label(target: target)
  let cps = target_checkpoints(target: target)
  if cps |> count == 0 { [] }
  else {
    [CoercionTestEntry {
      test_name: concat("coercion_", label, "_checkpoint_resolves_primitives"),
      assertions: cps |> map(cp =>
        CheckpointAssertion { target: target, dag_name: cp.dag_name, expected_type: cp.target_type })
    }]
  }
}

fn inhabitant_test_names() -> List<String> {
  canonical_container_names()
}

fn inhabitant_tests(target: RenderTarget) -> List<CoercionTestEntry> {
  let label = target_label(target: target)
  let assertions = inhabitant_test_names() |> flat_map(name =>
    match coerce_container_template(target: target, container_name: name) {
      Present { value: tmpl } => [ContainerAssertion { target: target, container_name: name, expected_template: tmpl }]
      Absent => []
    })
  if assertions |> count == 0 { [] }
  else {
    [CoercionTestEntry {
      test_name: concat("coercion_", label, "_inhabitant_resolves_containers"),
      assertions: assertions
    }]
  }
}

fn copy_tests() -> List<CoercionTestEntry> {
  let cps = target_checkpoints(target: Rust)
  let copy_assertions = cps |> flat_map(cp =>
    match cp.is_copy {
      Present { value: v } => [CopyAssertion { target: Rust, dag_name: cp.dag_name, expected_copy: v }]
      Absent => []
    })
  if copy_assertions |> count == 0 { [] }
  else {
    [CoercionTestEntry {
      test_name: "coercion_is_copy_from_checkpoint",
      assertions: copy_assertions
    }]
  }
}

fn unique_inhabitants_for_template_tests(inhs: List<InhabitantDecl>) -> List<InhabitantDecl> {
  inhs |> fold(init: [], f: fn(acc, inh) {
    if acc |> any(prev => prev.template == inh.template && prev.arity == inh.arity) { acc }
    else { concat(acc, [inh]) }
  })
}

fn template_application_tests() -> List<CoercionTestEntry> {
  let targets = [Rust, Python, Go]
  let assertions = targets |> flat_map(t =>
    let inhs = unique_inhabitants_for_template_tests(inhs: target_inhabitants(target: t))
    let int_target = coerce_primitive_type(decision: type_realization_decision(target: t, dag_name: "Int", provenance: DeclarationIdentityAbsent), dag_name: "Int")
    let str_target = coerce_primitive_type(decision: type_realization_decision(target: t, dag_name: "String", provenance: DeclarationIdentityAbsent), dag_name: "String")
    inhs |> flat_map(inh =>
      if inh.arity == 1 {
        let expected = apply_inhabitant_template1(template: inh.template, inner: int_target)
        [TemplateAssertion { template: inh.template, args: [int_target], expected: expected }]
      } else if inh.arity == 2 {
        let expected = apply_inhabitant_template2(template: inh.template, first: str_target, second: int_target)
        [TemplateAssertion { template: inh.template, args: [str_target, int_target], expected: expected }]
      } else { [] }))
  if assertions |> count == 0 { [] }
  else {
    [CoercionTestEntry {
      test_name: "coercion_template_application",
      assertions: assertions
    }]
  }
}

fn extract_coercion_tests() -> List<CoercionTestEntry> {
  concat(
    checkpoint_tests(target: Rust),
    checkpoint_tests(target: Python),
    checkpoint_tests(target: Go),
    inhabitant_tests(target: Rust),
    inhabitant_tests(target: Python),
    inhabitant_tests(target: Go),
    copy_tests(),
    template_application_tests())
}
