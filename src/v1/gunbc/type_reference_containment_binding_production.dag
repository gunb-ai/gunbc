module v1.gunbc.type_reference_containment_binding_production

import std.types { NonEmptyStr }
import gunbc.type_reference_binding_context {
  TypeReferenceBindingContext,
  ModuleOccurrenceBindingSource,
  build_type_reference_binding_context,
  build_graph_type_reference_binding_inputs,
  occurrence_binding_inputs_from_module_transport,
  declaration_exposure_from_containment_tree,
  merge_occurrence_binding_input_rows,
  type_reference_binding_context_authority_note,
}
import v1.compiler.resolve { ModuleGraph, ResolvedModule }
import v1.std.core { authored_name_at, NewlineIndex }

data type_reference_containment_binding_production_note: String = "N2 slice 2 PR-B adapter (quiet-hawk-219): projects v1 ModuleGraph ResolvedModule rows into gunbc.type_reference_binding_context.ModuleOccurrenceBindingSource for resolve_node_bounded threading on the RESOLVE path only. Emit-side item_registry leaf-key collision is a separate LIVE instance (#7705 RED control on main; warm-wolf-814 owns fix — cite in PR-B motivation per type_reference_binding_context_pr_b_motivation_note, do not fix here). PR-A authority: dag/gunbc/type_reference_binding_context.dag. DISSOLVE-ON: gunbc.type_reference_containment_binding type_reference_containment_binding_dissolve_on."

fn module_occurrence_binding_sources_from_graph(
  modules: List<ResolvedModule>,
  source_indices: Map<String, NewlineIndex>
) -> List<ModuleOccurrenceBindingSource> {
  map(modules, resolved =>
    ModuleOccurrenceBindingSource {
      module_path: authored_name_at(
        source_indices: source_indices,
        node: resolved.module,
      ) as NonEmptyStr,
      transport: resolved.occurrence_transport,
    }
  )
}

fn build_type_reference_binding_context_from_graph(
  graph: ModuleGraph,
  source_indices: Map<String, NewlineIndex>
) -> TypeReferenceBindingContext {
  build_type_reference_binding_context(
    transport: graph.occurrence_transport,
    sources: module_occurrence_binding_sources_from_graph(
      modules: graph.modules,
      source_indices: source_indices,
    ),
  )
}
