module v1.gunbc.occurrence_binding_parser_walk


data occurrence_binding_parser_walk_authority_note: String = "Parser-to-P2-walk bridge (namespace-reference-derived-closure slice B): authored source is parsed through v1.compiler.parse.parse_with_table; OccurrenceTransport and module path come from the parser only. OccurrenceBindingCandidateInputs are projected from parser facts — module paths for every indexed occurrence, authored order from diagnostic_span.start (never OccurrenceId.value), and DeclarationExposure from containment shape (empty / single-ancestor => ModuleExposure, else LexicalExposure with parent scope). Category is never read for exposure. Index-build refusals are carried intact as StructuralBindingWalkRefused — never coarsened to a unit variant (blocker 6)."

type ParsedOccurrenceBindingSource
  = ParsedOccurrenceBindingSourceReady {
      transport: std.occurrence_identity.OccurrenceTransport,
      module_path: std.types.NonEmptyStr,
    }
  | ParsedOccurrenceBindingSourceRefused

fn parse_authored_occurrence_binding_source(
  file: String,
  source: String
) -> v1.gunbc.occurrence_binding_parser_walk.ParsedOccurrenceBindingSource {
  let index = build_newline_index(file: file, source: source)
  let parsed = parse_with_table(
    tokens: v1.compiler.tokenize.tokenize(source: source, file: file),
    source_indices: map_insert(empty_map(), file, index),
    intern_table: empty_intern_table(),
  )
  match parse_with_table_ready_module_path(parsed: parsed) {
    Absent => ParsedOccurrenceBindingSourceRefused
    Present { value: module_path } =>
      ParsedOccurrenceBindingSourceReady {
        transport: parsed.occurrence_transport,
        module_path: module_path as std.types.NonEmptyStr,
      }
  }
}

data declaration_exposure_from_containment_note: String = "Exposure derivation site: inputs are containment prefix shape and module path only — OccurrenceCategory is not consulted. Delegates to the single exposure authority std.occurrence_binding_candidates declaration_exposure_from_containment under ModuleLocalMemberExposure grounding (N3-B0): module-root and direct-module-child shapes => ModuleExposure; nested declaration => LexicalExposure whose exposing_scope is the nearest ancestor. Binder-as-own-path LexicalExposure (the hand-built §13 fixture shape) is correct only when uses nest under the binder in the parse tree (lets do; match-arm bodies currently do not — see parser_sibling_match_arm_pattern_binder_holds_note)."

fn authored_order_row_from_entry(entry: std.occurrence_identity.OccurrenceIndexEntry) -> std.occurrence_binding_candidates.AuthoredOrderRow {
  std.occurrence_binding_candidates.AuthoredOrderRow {
    occurrence: entry.projection.occurrence,
    ordinal: std.occurrence_identity.AuthoredTokenOrdinal {
      value: entry.projection.diagnostic_span.start,
    },
  }
}

data occurrence_binding_inputs_accumulator_note: String = "Input projection accumulates by prepend during fold and reverses once at the end — never concat(acc, [row]) (§6 bare-minimum cost / blocker 6)."

fn occurrence_binding_inputs_from_transport(
  module_path: std.types.NonEmptyStr,
  transport: std.occurrence_identity.OccurrenceTransport
) -> std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
  std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs {
    module_paths: reverse(fold(
      transport.index.entries,
      init: [],
      f: (acc, entry) =>
        concat([
          std.occurrence_binding_candidates.OccurrenceModulePathRow {
            occurrence: entry.projection.occurrence,
            module_path: module_path,
          },
        ], acc),
    )),
    exposure_rows: reverse(fold(
      transport.declarations,
      init: [],
      f: (acc, declaration) =>
        concat([
          std.occurrence_binding_candidates.DeclarationExposureRow {
            occurrence: declaration.occurrence,
            exposure: declaration_exposure_from_containment(
              module_path: module_path,
              containment: declaration.containment,
              grounding: ModuleLocalMemberExposure,
            ),
          },
        ], acc),
    )),
    authored_order_rows: reverse(fold(
      transport.index.entries,
      init: [],
      f: (acc, entry) =>
        concat([v1.gunbc.occurrence_binding_parser_walk.authored_order_row_from_entry(entry: entry)], acc),
    )),
  }
}

data structural_binding_walk_refusal_note: String = "structural_binding_walk / StructuralBindingWalk / StructuralBindingIndexRefusal are the single authority in std.occurrence_binding_candidates (N3-B0) — StructuralBindingWalkRefused wraps the exact index-build refusal payload (transport / module-path / exposure / authored-order / declaration-bucket). Coarse unit variants that discard nested refusal evidence are forbidden (operator blocker 6 / review on PR 7515)."

fn reference_named(
  transport: std.occurrence_identity.OccurrenceTransport,
  name: String
) -> std.occurrence_identity.ReferenceOccurrence? {
  match references_named(transport: transport, name: name) |> first {
    Present { value: reference } => Present { value: reference }
    Absent => none
  }
}

fn references_named(
  transport: std.occurrence_identity.OccurrenceTransport,
  name: String
) -> List<std.occurrence_identity.ReferenceOccurrence> {
  fold(
    transport.references,
    init: [],
    f: (acc, reference) =>
      match index_entry_for_occurrence(
        transport: transport,
        occurrence: reference.occurrence,
      ) {
        Absent => acc
        Present { value: entry } =>
          match entry.projection.authored_name == name {
            true => concat(acc, [reference])
            false => acc
          }
      },
  )
}

fn declarations_named(
  transport: std.occurrence_identity.OccurrenceTransport,
  name: String
) -> List<std.occurrence_identity.DeclarationOccurrence> {
  fold(
    transport.declarations,
    init: [],
    f: (acc, declaration) =>
      match index_entry_for_occurrence(
        transport: transport,
        occurrence: declaration.occurrence,
      ) {
        Absent => acc
        Present { value: entry } =>
          match entry.projection.authored_name == name {
            true => concat(acc, [declaration])
            false => acc
          }
      },
  )
}

fn index_entry_for_occurrence(
  transport: std.occurrence_identity.OccurrenceTransport,
  occurrence: std.occurrence_identity.OccurrenceId
) -> std.occurrence_identity.OccurrenceIndexEntry? {
  fold(
    transport.index.entries,
    init: none,
    f: (found, entry) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match entry.projection.occurrence.value == occurrence.value {
            true => Present { value: entry }
            false => Absent
          }
      },
  )
}

fn occurrence_id_for_authored_name(
  transport: std.occurrence_identity.OccurrenceTransport,
  name: String
) -> std.occurrence_identity.OccurrenceId? {
  match fold(
    transport.index.entries,
    init: none,
    f: (found, entry) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match entry.projection.authored_name == name {
            true => Present { value: entry.projection.occurrence }
            false => Absent
          }
      },
  ) {
    Present { value: occurrence } => Present { value: occurrence }
    Absent => none
  }
}
