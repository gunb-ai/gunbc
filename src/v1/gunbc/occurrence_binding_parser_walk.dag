module v1.gunbc.occurrence_binding_parser_walk

import std.types { String, List, NonEmptyStr }
import std.algebra { FreeMonoid, Empty, Cons }
import std.occurrence_identity {
  OccurrenceId,
  OccurrenceIndexEntry,
  OccurrenceTransport,
  OccurrenceTransportRefusal,
  ReferenceOccurrence,
  OccurrenceContainmentPath,
  DeclarationOccurrence,
  AuthoredTokenOrdinal,
}
import std.occurrence_binding_candidates {
  OccurrenceModulePathRow,
  DeclarationExposureRow,
  DeclarationExposure,
  LexicalExposure,
  ModuleExposure,
  AuthoredOrderRow,
  OccurrenceBindingCandidateInputs,
  BoundReferencePopulation,
  OccurrenceModulePathIndexRefusal,
  DeclarationExposureIndexRefusal,
  AuthoredOrderIndexRefusal,
  occurrence_candidate_index_build,
  OccurrenceCandidateIndexTransportRefused,
  OccurrenceCandidateIndexModulePathRefused,
  OccurrenceCandidateIndexExposureRefused,
  OccurrenceCandidateIndexAuthoredOrderRefused,
  OccurrenceCandidateIndexDeclarationBucketRefused,
  OccurrenceCandidateIndexReady,
  resolve_all_references_via_structural_candidates,
  bound_reference_population_from_projections,
}
import v1.compiler.tokenize { tokenize }
import v1.compiler.parse {
  parse_with_table,
  parse_with_table_ready_module_path,
}
import v1.std.core {
  build_newline_index,
  empty_intern_table,
  NewlineIndex,
}

data occurrence_binding_parser_walk_authority_note: String = "Parser-to-P2-walk bridge (namespace-reference-derived-closure slice B): authored source is parsed through v1.compiler.parse.parse_with_table; OccurrenceTransport and module path come from the parser only. OccurrenceBindingCandidateInputs are projected from parser facts — module paths for every indexed occurrence, authored order from diagnostic_span.start (never OccurrenceId.value), and DeclarationExposure from containment shape (empty / single-ancestor => ModuleExposure, else LexicalExposure with parent scope). Category is never read for exposure. Index-build refusals are carried intact as StructuralBindingWalkRefused — never coarsened to a unit variant (blocker 6)."

type ParsedOccurrenceBindingSource
  = ParsedOccurrenceBindingSourceReady {
      transport: OccurrenceTransport,
      module_path: NonEmptyStr,
    }
  | ParsedOccurrenceBindingSourceRefused

fn parse_authored_occurrence_binding_source(
  file: String,
  source: String
) -> ParsedOccurrenceBindingSource {
  let index = build_newline_index(file: file, source: source)
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: file),
    source_indices: map_insert(empty_map(), file, index),
    intern_table: empty_intern_table(),
  )
  match parse_with_table_ready_module_path(parsed: parsed) {
    Absent => ParsedOccurrenceBindingSourceRefused
    Present { value: module_path } =>
      ParsedOccurrenceBindingSourceReady {
        transport: parsed.occurrence_transport,
        module_path: module_path as NonEmptyStr,
      }
  }
}

data declaration_exposure_from_containment_note: String = "Exposure derivation site: inputs are containment prefix shape and module path only — OccurrenceCategory is not consulted. Empty or single-ancestor chain => ModuleExposure; nested declaration => LexicalExposure with parent scope path. Raw containment derives the exposure row; P2a decisions read only DeclarationExposure."

fn declaration_exposure_from_containment(
  module_path: NonEmptyStr,
  containment: OccurrenceContainmentPath
) -> DeclarationExposure {
  match containment.ancestors {
    Empty => ModuleExposure { module: module_path }
    Cons { head: _, tail: Empty } =>
      ModuleExposure { module: module_path }
    Cons { head: parent_terminal, tail: rest } =>
      LexicalExposure {
        exposing_scope: OccurrenceContainmentPath {
          ancestors: rest,
          terminal: parent_terminal,
        },
      }
  }
}

fn authored_order_row_from_entry(entry: OccurrenceIndexEntry) -> AuthoredOrderRow {
  AuthoredOrderRow {
    occurrence: entry.projection.occurrence,
    ordinal: AuthoredTokenOrdinal {
      value: entry.projection.diagnostic_span.start,
    },
  }
}

data occurrence_binding_inputs_accumulator_note: String = "Input projection accumulates by prepend during fold and reverses once at the end — never concat(acc, [row]) (§6 bare-minimum cost / blocker 6)."

fn occurrence_binding_inputs_from_transport(
  module_path: NonEmptyStr,
  transport: OccurrenceTransport
) -> OccurrenceBindingCandidateInputs {
  OccurrenceBindingCandidateInputs {
    module_paths: reverse(fold(
      transport.index.entries,
      init: [],
      f: (acc, entry) =>
        concat([
          OccurrenceModulePathRow {
            occurrence: entry.projection.occurrence,
            module_path: module_path,
          },
        ], acc),
    )),
    exposure_rows: reverse(fold(
      transport.declarations,
      init: [],
      f: (acc, declaration) =>
        concat([
          DeclarationExposureRow {
            occurrence: declaration.occurrence,
            exposure: declaration_exposure_from_containment(
              module_path: module_path,
              containment: declaration.containment,
            ),
          },
        ], acc),
    )),
    authored_order_rows: reverse(fold(
      transport.index.entries,
      init: [],
      f: (acc, entry) =>
        concat([authored_order_row_from_entry(entry: entry)], acc),
    )),
  }
}

data structural_binding_walk_refusal_note: String = "StructuralBindingWalkRefused wraps the exact index-build refusal payload (transport / module-path / exposure / authored-order / declaration-bucket). Coarse unit variants that discard nested refusal evidence are forbidden (operator blocker 6 / review on PR 7515)."

type StructuralBindingIndexRefusal
  = StructuralBindingTransportRefusal {
      refusal: OccurrenceTransportRefusal,
    }
  | StructuralBindingModulePathRefusal {
      refusal: OccurrenceModulePathIndexRefusal,
    }
  | StructuralBindingExposureRefusal {
      refusal: DeclarationExposureIndexRefusal,
    }
  | StructuralBindingAuthoredOrderRefusal {
      refusal: AuthoredOrderIndexRefusal,
    }
  | StructuralBindingDeclarationBucketRefusal {
      occurrence: OccurrenceId,
    }

type StructuralBindingWalk
  = StructuralBindingWalkReady { population: BoundReferencePopulation }
  | StructuralBindingWalkRefused { refusal: StructuralBindingIndexRefusal }

fn structural_binding_walk(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs
) -> StructuralBindingWalk {
  match occurrence_candidate_index_build(transport: transport, inputs: inputs) {
    OccurrenceCandidateIndexTransportRefused { refusal: refusal } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingTransportRefusal { refusal: refusal },
      }
    OccurrenceCandidateIndexModulePathRefused { refusal: refusal } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingModulePathRefusal { refusal: refusal },
      }
    OccurrenceCandidateIndexExposureRefused { refusal: refusal } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingExposureRefusal { refusal: refusal },
      }
    OccurrenceCandidateIndexAuthoredOrderRefused { refusal: refusal } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingAuthoredOrderRefusal { refusal: refusal },
      }
    OccurrenceCandidateIndexDeclarationBucketRefused { occurrence: occurrence } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingDeclarationBucketRefusal {
          occurrence: occurrence,
        },
      }
    OccurrenceCandidateIndexReady { index: index } =>
      StructuralBindingWalkReady {
        population: bound_reference_population_from_projections(
          projections: resolve_all_references_via_structural_candidates(
            transport: transport,
            index: index,
            references: transport.references,
          ),
        ),
      }
  }
}

fn reference_named(
  transport: OccurrenceTransport,
  name: String
) -> ReferenceOccurrence? {
  fold(
    transport.references,
    init: none,
    f: (found, reference) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match index_entry_for_occurrence(
            transport: transport,
            occurrence: reference.occurrence,
          ) {
            Absent => Absent
            Present { value: entry } =>
              match entry.projection.authored_name == name {
                true => Present { value: reference }
                false => Absent
              }
          }
      },
  )
}

fn index_entry_for_occurrence(
  transport: OccurrenceTransport,
  occurrence: OccurrenceId
) -> OccurrenceIndexEntry? {
  fold(
    transport.index.entries,
    init: none,
    f: (found, entry) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match entry.projection.occurrence.value == occurrence.value {
            true => Present { value: entry }
            false => Absent
          }
      },
  )
}

fn occurrence_id_for_authored_name(
  transport: OccurrenceTransport,
  name: String
) -> OccurrenceId? {
  match fold(
    transport.index.entries,
    init: none,
    f: (found, entry) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match entry.projection.authored_name == name {
            true => Present { value: entry.projection.occurrence }
            false => Absent
          }
      },
  ) {
    Present { value: occurrence } => Present { value: occurrence }
    Absent => none
  }
}
