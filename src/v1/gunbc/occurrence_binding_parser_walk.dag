  structural_binding_walk,
}
import v1.compiler.tokenize { tokenize }
import v1.compiler.parse {
  parse_with_table,
  parse_with_table_ready_module_path,
}
import v1.std.core {
  build_newline_index,
  empty_intern_table,
  InternTable,
  NewlineIndex,
}

data occurrence_binding_parser_walk_authority_note: String = "Parser-to-P2-walk bridge (namespace-reference-derived-closure slice B): authored source is parsed through v1.compiler.parse.parse_with_table; OccurrenceTransport and module path come from the parser only. OccurrenceBindingCandidateInputs are projected from parser facts — module paths for every indexed occurrence, authored order from diagnostic_span.start (never OccurrenceId.value), and DeclarationExposure from containment shape (empty / single-ancestor => ModuleExposure, else LexicalExposure with parent scope). Category is never read for exposure. Index-build refusals are carried intact as StructuralBindingWalkRefused — never coarsened to a unit variant (blocker 6). Cross-file parse and assembly refusals likewise carry typed payloads through ParsedCrossFileBindingClosureRefused — never unit variants that erase ModulePathFileIndexRefusal or parse-site location."

type ParsedOccurrenceBindingSourceRefusal
  = ParsedOccurrenceBindingModulePathAbsent { file: String }

type ParsedOccurrenceBindingSource
  = ParsedOccurrenceBindingSourceReady {
      transport: OccurrenceTransport,
      module_path: NonEmptyStr,
      intern_table: InternTable,
    }
  | ParsedOccurrenceBindingSourceRefused {
      refusal: ParsedOccurrenceBindingSourceRefusal,
    }

fn parse_authored_occurrence_binding_source(
  file: String,
  source: String,
  intern_table: InternTable,
) -> ParsedOccurrenceBindingSource {
  let index = build_newline_index(file: file, source: source)
  let parsed = parse_with_table(
    tokens: tokenize(source: source, file: file),
    source_indices: map_insert(empty_map(), file, index),
    intern_table: intern_table,
  )
  match parse_with_table_ready_module_path(parsed: parsed) {
    Absent =>
      ParsedOccurrenceBindingSourceRefused {
        refusal: ParsedOccurrenceBindingModulePathAbsent { file: file },
      }
    Present { value: module_path } =>
      ParsedOccurrenceBindingSourceReady {
        transport: parsed.occurrence_transport,
        module_path: module_path as NonEmptyStr,
        intern_table: parsed.intern_table,
      }
  }
}

fn authored_order_row_from_entry(entry: OccurrenceIndexEntry) -> AuthoredOrderRow {
  AuthoredOrderRow {
    occurrence: entry.projection.occurrence,
    ordinal: AuthoredTokenOrdinal {
      value: entry.projection.diagnostic_span.start,
    },
  }
}

data occurrence_binding_inputs_accumulator_note: String = "Input projection accumulates by prepend during fold and reverses once at the end — never concat(acc, [row]) (§6 bare-minimum cost / blocker 6)."

fn occurrence_binding_inputs_from_transport(
  module_path: NonEmptyStr,
  transport: OccurrenceTransport,
  exposure_grounding: DeclarationExposureGrounding,
) -> OccurrenceBindingCandidateInputs {
  OccurrenceBindingCandidateInputs {
    module_paths: reverse(fold(
      transport.index.entries,
      init: [],
      f: (acc, entry) =>
        concat([
          OccurrenceModulePathRow {
            occurrence: entry.projection.occurrence,
            module_path: module_path,
          },
        ], acc),
    )),
    exposure_rows: reverse(fold(
      transport.declarations,
      init: [],
      f: (acc, declaration) =>
        concat([
          DeclarationExposureRow {
            occurrence: declaration.occurrence,
            exposure: declaration_exposure_from_containment(
              module_path: module_path,
              containment: declaration.containment,
              grounding: exposure_grounding,
            ),
          },
        ], acc),
    )),
    authored_order_rows: reverse(fold(
      transport.index.entries,
      init: [],
      f: (acc, entry) =>
        concat([authored_order_row_from_entry(entry: entry)], acc),
    )),
  }
}

data structural_binding_walk_refusal_note: String = "Re-export note: StructuralBindingWalk lives in std.occurrence_binding_candidates. Parser witnesses import through this module for historical enrollment only."

data cross_file_binding_closure_note: String = "Cross-file binding closure: parse consumer then providers through one graph-scoped intern_table / OccurrenceIdAllocator (occurrence_identity_scope_law — pattern_binder_declaration_node_test threads first.intern_table into the second parse). assemble_cross_file_binding_closure rekeys with one fresh old-id map per source scope before merge. Consumer exposure rows derive with ModuleLocalMemberExposure; provider rows derive with CrossFileProviderExportedExposure at declaration_exposure_from_containment — no post-hoc ModuleExposure upgrade."

type CrossFileBindingSourceRow {
  file: String
  source: String
}

type ParsedCrossFileBindingClosureRefusal
  = ParsedCrossFileBindingClosureConsumerParseRefused {
      refusal: ParsedOccurrenceBindingSourceRefusal,
    }
  | ParsedCrossFileBindingClosureProviderParseRefused {
      refusal: ParsedOccurrenceBindingSourceRefusal,
    }
  | ParsedCrossFileBindingClosureAssemblyRefused {
      refusal: AssembledCrossFileBindingClosureRefusal,
    }

type ParsedCrossFileBindingClosure
  = ParsedCrossFileBindingClosureReady {
      transport: OccurrenceTransport,
      inputs: OccurrenceBindingCandidateInputs,
      module_files: List<ModulePathFileRow>,
      consumer_file: String,
    }
  | ParsedCrossFileBindingClosureRefused {
      refusal: ParsedCrossFileBindingClosureRefusal,
    }

type CrossFileProviderRowsAccum
  = CrossFileProviderRowsAccumReady {
      rows: List<CrossFileBindingClosureRow>,
      intern_table: InternTable,
    }
  | CrossFileProviderRowsAccumRefused {
      refusal: ParsedOccurrenceBindingSourceRefusal,
    }

fn cross_file_provider_rows_from_sources(
  providers: List<CrossFileBindingSourceRow>,
  intern_table: InternTable,
) -> CrossFileProviderRowsAccum {
  fold(
    providers,
    init: CrossFileProviderRowsAccumReady {
      rows: [],
      intern_table: intern_table,
    },
    f: (acc, provider_row) =>
      match acc {
        CrossFileProviderRowsAccumRefused { refusal: _ } => acc
        CrossFileProviderRowsAccumReady { rows: rows, intern_table: table } =>
          match parse_authored_occurrence_binding_source(
            file: provider_row.file,
            source: provider_row.source,
            intern_table: table,
          ) {
            ParsedOccurrenceBindingSourceRefused { refusal: refusal } =>
              CrossFileProviderRowsAccumRefused { refusal: refusal }
            ParsedOccurrenceBindingSourceReady {
              transport: provider_transport,
              module_path: provider_module,
              intern_table: next_table,
            } =>
              let base_inputs = occurrence_binding_inputs_from_transport(
                module_path: provider_module,
                transport: provider_transport,
                exposure_grounding: CrossFileProviderExportedExposure,
              )
              CrossFileProviderRowsAccumReady {
                rows: concat([
                  cross_file_binding_closure_row(
                    transport: provider_transport,
                    module_path: provider_module,
                    file_path: provider_row.file,
                    exposure_rows: base_inputs.exposure_rows,
                    module_paths: base_inputs.module_paths,
                    authored_order_rows: base_inputs.authored_order_rows,
                  ),
                ], rows),
                intern_table: next_table,
              }
          }
      },
  )
}

fn parse_cross_file_binding_closure(
  consumer: CrossFileBindingSourceRow,
  providers: List<CrossFileBindingSourceRow>
) -> ParsedCrossFileBindingClosure {
  match parse_authored_occurrence_binding_source(
    file: consumer.file,
    source: consumer.source,
    intern_table: empty_intern_table(),
  ) {
    ParsedOccurrenceBindingSourceRefused { refusal: refusal } =>
      ParsedCrossFileBindingClosureRefused {
        refusal: ParsedCrossFileBindingClosureConsumerParseRefused {
          refusal: refusal,
        },
      }
    ParsedOccurrenceBindingSourceReady {
      transport: consumer_transport,
      module_path: consumer_module,
      intern_table: consumer_intern_table,
    } =>
      let consumer_row = CrossFileBindingClosureRow {
        transport: consumer_transport,
        inputs: occurrence_binding_inputs_from_transport(
          module_path: consumer_module,
          transport: consumer_transport,
          exposure_grounding: ModuleLocalMemberExposure,
        ),
        module_path: consumer_module,
        file_path: consumer.file,
      }
      match cross_file_provider_rows_from_sources(
        providers: providers,
        intern_table: consumer_intern_table,
      ) {
        CrossFileProviderRowsAccumRefused { refusal: refusal } =>
          ParsedCrossFileBindingClosureRefused {
            refusal: ParsedCrossFileBindingClosureProviderParseRefused {
              refusal: refusal,
            },
          }
        CrossFileProviderRowsAccumReady { rows: provider_rows, intern_table: _ } =>
          match assemble_cross_file_binding_closure(
            consumer: consumer_row,
            providers: provider_rows,
          ) {
            AssembledCrossFileBindingClosureReady {
              transport: transport,
              inputs: inputs,
              module_files: module_files,
              consumer_file: consumer_file,
            } =>
              ParsedCrossFileBindingClosureReady {
                transport: transport,
                inputs: inputs,
                module_files: module_files,
                consumer_file: consumer_file as String,
              }
            AssembledCrossFileBindingClosureRefused { refusal: refusal } =>
              ParsedCrossFileBindingClosureRefused {
                refusal: ParsedCrossFileBindingClosureAssemblyRefused {
                  refusal: refusal,
                },
              }
          }
      }
  }
}

fn reference_named(
  transport: OccurrenceTransport,
  name: String
) -> ReferenceOccurrence? {
  match references_named(transport: transport, name: name) |> first {
    Present { value: reference } => Present { value: reference }
    Absent => none
  }
}

fn references_named(
  transport: OccurrenceTransport,
  name: String
) -> List<ReferenceOccurrence> {
  fold(
    transport.references,
    init: [],
    f: (acc, reference) =>
      match index_entry_for_occurrence(
        transport: transport,
        occurrence: reference.occurrence,
      ) {
        Absent => acc
        Present { value: entry } =>
          match entry.projection.authored_name == name {
            true => concat(acc, [reference])
            false => acc
          }
      },
  )
}

fn declarations_named(
  transport: OccurrenceTransport,
  name: String
) -> List<DeclarationOccurrence> {
  fold(
    transport.declarations,
    init: [],
    f: (acc, declaration) =>
      match index_entry_for_occurrence(
        transport: transport,
        occurrence: declaration.occurrence,
      ) {
        Absent => acc
        Present { value: entry } =>
          match entry.projection.authored_name == name {
            true => concat(acc, [declaration])
            false => acc
          }
      },
  )
}

fn index_entry_for_occurrence(
  transport: OccurrenceTransport,
  occurrence: OccurrenceId
) -> OccurrenceIndexEntry? {
  fold(
    transport.index.entries,
    init: none,
    f: (found, entry) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match entry.projection.occurrence.value == occurrence.value {
            true => Present { value: entry }
            false => Absent
          }
      },
  )
}

fn occurrence_id_for_authored_name(
  transport: OccurrenceTransport,
  name: String
) -> OccurrenceId? {
  match fold(
    transport.index.entries,
    init: none,
    f: (found, entry) =>
      match found {
        Present { value: _ } => found
        Absent =>
          match entry.projection.authored_name == name {
            true => Present { value: entry.projection.occurrence }
            false => Absent
          }
      },
  ) {
    Present { value: occurrence } => Present { value: occurrence }
    Absent => none
  }
}
