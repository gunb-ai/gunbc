module v1.gunbc.nested_match_6777_length_classifier

import std.logic { Bool }

data nested_match_6777_reproducer_note: String = "Fixture specimen for gunbc.roadmap_authority unreachable_patterns_construction_residue_note (#6777 declared construction residue): two sibling Cons arms differing only by nested tail subpattern (Empty vs Cons). Authored match is correct; pre-fix emitter collapsed to the first Cons arm body for every nonempty list. Permanent regression control for freemonoid nested-tail grouping (DESIGN §4b)."

type LengthClass
  = Zero
  | One
  | Many

fn mk_list(n: Int) -> List<Int> {
  if n <= 0 {
    Empty
  } else {
    Cons { head: 1, tail: mk_list(n: n - 1) }
  }
}

fn classify_length(xs: List<Int>) -> LengthClass {
  match xs {
    Empty => Zero
    Cons { head: _, tail: Empty } => One
    Cons { head: _, tail: Cons { head: _, tail: _ } } => Many
  }
}

fn classify_length_tag(n: Int) -> String {
  match classify_length(xs: mk_list(n: n)) {
    Zero => "Zero"
    One => "One"
    Many => "Many"
  }
}
