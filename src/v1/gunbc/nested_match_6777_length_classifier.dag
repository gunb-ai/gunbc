module v1.gunbc.nested_match_6777_length_classifier

import std.logic { Bool }

data nested_match_6777_reproducer_note: String = "Reproducer for #6777 construction residue: two sibling Cons arms differing only by nested tail subpattern (Empty vs Cons). Authored match is correct; main emitter collapses to the first Cons arm body for every nonempty list. Permanent regression control once nested-match grouping lands (DESIGN §4b)."

type LengthClass
  = Zero
  | One
  | Many

fn mk_list(n: Int) -> List<Int> {
  if n <= 0 {
    Empty
  } else {
    Cons { head: 1, tail: mk_list(n: n - 1) }
  }
}

fn classify_length(xs: List<Int>) -> LengthClass {
  match xs {
    Empty => Zero
    Cons { head: _, tail: Empty } => One
    Cons { head: _, tail: Cons { head: _, tail: _ } } => Many
  }
}

test fn classify_length_witness_holds() -> Bool {
  classify_length(xs: mk_list(n: 0)) == Zero
    && classify_length(xs: mk_list(n: 1)) == One
    && classify_length(xs: mk_list(n: 2)) == Many
    && classify_length(xs: mk_list(n: 3)) == Many
}
