  "module gunbc.closure_fixture.namespace_reference_derived_closure_specimen\n\nfn fn_a() -> Int {\n  10\n}\n\nfn fn_b() -> Int {\n  fn_a()\n}\n\nfn sibling_branch_demo(b: Bool) -> Int {\n  if b {\n    let x = 1\n    x\n  } else {\n    let x = 2\n    x\n  }\n}\n\nfn later_declaration_demo() -> Int {\n  fn_later()\n}\n\nfn helper() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  1\n}\n\nfn distinct_homonym_demo() -> Int {\n  helper()\n}\n"
}

fn nrdfc_specimen_source_mutation_d() -> String {
  "module gunbc.closure_fixture.namespace_reference_derived_closure_specimen\n\nfn fn_a() -> Int {\n  10\n}\n\nfn fn_b() -> Int {\n  fn_a()\n}\n\nfn sibling_branch_demo(b: Bool) -> Int {\n  if b {\n    let x = 1\n    x\n  } else {\n    let x = 2\n    x\n  }\n}\n\nfn later_declaration_demo() -> Int {\n  fn_later()\n}\n\nfn fn_later() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  0\n}\n\nfn distinct_homonym_demo() -> Int {\n  helper()\n}\n"
}

fn same_file_neighbour_observation(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
) -> ReferenceBindingObservation {
  match reference_named(transport: transport, name: "fn_a") {
    Absent =>
      SameFileNeighbourProductionRefused {
        gap: ReferenceBindingNamedReferenceAbsent,
      }
    Present { value: reference } =>
      match declarations_named(transport: transport, name: "fn_a") |> first {
        Absent =>
          SameFileNeighbourProductionRefused {
            gap: ReferenceBindingNamedDeclarationAbsent,
          }
        Present { value: neighbour } =>
          SameFileNeighbourObservation {
            neighbour: neighbour.occurrence,
            resolution: structural_binding_resolution_from_candidates(
              transport: transport,
              inputs: inputs,
              reference: reference,
            ),
          }
      }
  }
}

fn sibling_branch_observation(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
) -> ReferenceBindingObservation {
  let x_declarations = declarations_named(transport: transport, name: "x")
  let x_references = references_named(transport: transport, name: "x")
  match x_declarations |> first {
    Absent =>
      SiblingBranchProductionRefused {
        gap: ReferenceBindingNamedDeclarationAbsent,
      }
    Present { value: then_branch_x } =>
      match x_declarations |> reverse |> first {
        Absent =>
          SiblingBranchProductionRefused {
            gap: ReferenceBindingNamedDeclarationAbsent,
          }
        Present { value: else_branch_x } =>
          match x_references |> reverse |> first {
            Absent =>
              SiblingBranchObservation {
                own_branch_declaration: else_branch_x.occurrence,
                sibling_branch_declaration: then_branch_x.occurrence,
                resolution: StructuralBindingProductionRefused {
                  gap: ReferenceBindingNamedReferenceAbsent,
                },
              }
            Present { value: else_branch_ref } =>
              SiblingBranchObservation {
                own_branch_declaration: else_branch_x.occurrence,
                sibling_branch_declaration: then_branch_x.occurrence,
                resolution: structural_binding_resolution_from_candidates(
                  transport: transport,
                  inputs: inputs,
                  reference: else_branch_ref,
                ),
              }
          }
      }
  }
}

fn later_declaration_observation(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
) -> ReferenceBindingObservation {
  match reference_named(transport: transport, name: "fn_later") {
    Absent =>
      LaterDeclarationProductionRefused {
        gap: ReferenceBindingNamedReferenceAbsent,
      }
    Present { value: reference } =>
      match declarations_named(transport: transport, name: "fn_later") |> first {
        Absent =>
          LaterDeclarationProductionRefused {
            gap: ReferenceBindingNamedDeclarationAbsent,
          }
        Present { value: later_declaration } =>
          LaterDeclarationObservation {
            later_declaration: later_declaration.occurrence,
            resolution: structural_binding_resolution_from_candidates(
              transport: transport,
              inputs: inputs,
              reference: reference,
            ),
          }
      }
  }
}

fn distinct_homonym_observation(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
) -> ReferenceBindingObservation {
  match reference_named(transport: transport, name: "helper") {
    Absent =>
      DistinctHomonymProductionRefused {
        gap: ReferenceBindingNamedReferenceAbsent,
      }
    Present { value: reference } =>
      let helpers = declarations_named(transport: transport, name: "helper")
      match helpers |> first {
        Absent =>
          DistinctHomonymProductionRefused {
            gap: ReferenceBindingNamedDeclarationAbsent,
          }
        Present { value: first_helper } =>
          match helpers |> reverse |> first {
            Absent =>
              DistinctHomonymProductionRefused {
                gap: ReferenceBindingNamedDeclarationAbsent,
              }
            Present { value: second_helper } =>
              DistinctHomonymObservation {
                first_declaration: first_helper.occurrence,
                second_declaration: second_helper.occurrence,
                resolution: structural_binding_resolution_from_candidates(
                  transport: transport,
                  inputs: inputs,
                  reference: reference,
                ),
              }
          }
      }
  }
}

fn namespace_structural_binding_observations_for_source(
  file: String,
  source: String,
) -> List<ReferenceBindingObservation> {
  match nrdfc_parse(file: file, source: source) {
    NrdfcParsedRefused =>
      [
        SameFileNeighbourProductionRefused { gap: ReferenceBindingParserTransportRefused },
        SiblingBranchProductionRefused { gap: ReferenceBindingParserTransportRefused },
        LaterDeclarationProductionRefused { gap: ReferenceBindingParserTransportRefused },
        DistinctHomonymProductionRefused { gap: ReferenceBindingParserTransportRefused },
      ]
    NrdfcParsedReady { transport: transport, inputs: inputs } =>
      [
        same_file_neighbour_observation(transport: transport, inputs: inputs),
        sibling_branch_observation(transport: transport, inputs: inputs),
        later_declaration_observation(transport: transport, inputs: inputs),
        distinct_homonym_observation(transport: transport, inputs: inputs),
      ]
  }
}

fn namespace_structural_binding_observations_a_through_d() -> List<ReferenceBindingObservation> {
  namespace_structural_binding_observations_for_source(
    file: "gunbc/closure_fixture/namespace_reference_derived_closure_specimen.dag",
    source: nrdfc_specimen_source(),
  )
}

