module v1.gunbc.namespace_reference_derived_closure_production_observations

import std.occurrence_identity { OccurrenceTransport, OccurrenceId }
import std.occurrence_binding_candidates {
  OccurrenceBindingCandidateInputs,
}
import std.reference_binding_observation {
  ReferenceBindingObservation,
  StructuralBindingProductionRefused,
  ReferenceBindingParserTransportRefused,
  ReferenceBindingNamedReferenceAbsent,
  ReferenceBindingNamedDeclarationAbsent,
  SameFileNeighbourObservation,
  SameFileNeighbourProductionRefused,
  SiblingBranchObservation,
  SiblingBranchProductionRefused,
  LaterDeclarationObservation,
  LaterDeclarationProductionRefused,
  DistinctHomonymObservation,
  DistinctHomonymProductionRefused,
  structural_binding_resolution_from_candidates,
}
import std.types { List, String }
import extdeps.filesystem.filesystem_io
import v1.gunbc.occurrence_binding_parser_walk {
  ParsedOccurrenceBindingSourceReady,
  ParsedOccurrenceBindingSourceRefused,
  parse_authored_occurrence_binding_source,
  occurrence_binding_inputs_from_transport,
  reference_named,
  declarations_named,
  references_named,
}

data namespace_reference_derived_closure_production_observations_note: String = "N3-A production observers for namespace-reference-derived-closure clauses (a-d). Returns neutral std.reference_binding_observation.ReferenceBindingObservation carriers only — no roadmap capability vocabulary and no assessment at this seam. namespace_structural_binding_observations_a_through_d is the sole base export; capability projection lives in dag witnesses / the src/v1 execution bridge."

data namespace_reference_derived_closure_filesystem_import_note: String = "The extdeps.filesystem.filesystem_io import above brings no named symbol into scope — filesystem_read itself is a v1 host builtin (registered in 04_method.dag), not an export of this module. The import exists solely for its grounding side effect: it puts the declared service Filesystem { operation Read } into this file's reachable graph.modules, which is what makes Filesystem.Read appear in the compiled program's service_ops so hermetic execution admits the filesystem_read call below instead of refusing it."

data namespace_reference_derived_closure_production_specimen_note: String = "ONE ordinary compiled specimen is loaded through the ordinary compilation path — a real file on disk under src/v1/gunbc/closure_fixture, read via the filesystem_read builtin (the same host-effect primitive dag/tools/extdeps_scope_placement_gate.dag and dag/test/claim/filesystem_read_hermetic_witness.dag use; hermetic execution serves it as a real checkout-input read, never a fabricated fixture) — and parsed once through the real tokenizer/parser, with all four clause observations derived from that single OccurrenceTransport. namespace_structural_binding_observations_for_source is the shared load-once/parse-once seam every export (base and mutation) routes through. The fixture files carry a .dag.txt extension, not .dag, so they are real authored files on disk yet never swept into src/v1's own .dag module discovery (stage0 regen / dag_compile_clean_gate both glob strictly on the .dag extension) — the specimen intentionally declares helper() twice at module scope to exercise DistinctSameSpelledDeclarationsPreserved, which the ordinary binder (unlike this occurrence-binding walker) would refuse as a duplicate declaration. Four discriminating mutation files (namespace_reference_derived_closure_specimen_mutation_a..d.dag.txt) each delete exactly the one declaration a single clause depends on, leaving the other three clauses' declarations byte-identical; src/v1/gunbc/namespace_reference_derived_closure_live_admissions.dag folds base-establishes-all-four and each-mutation-breaks-exactly-its-own-clause into the N3-A closing receipt. Sibling decision-branch uses if/else let arms (parse_block nesting) because match-arm bodies remain siblings of pattern binders in v1.parse containment."

type NrdfcParsed
  = NrdfcParsedReady {
      transport: OccurrenceTransport,
      inputs: OccurrenceBindingCandidateInputs,
    }
  | NrdfcParsedRefused

fn nrdfc_parse(file: String, source: String) -> NrdfcParsed {
  match parse_authored_occurrence_binding_source(file: file, source: source) {
    ParsedOccurrenceBindingSourceRefused => NrdfcParsedRefused
    ParsedOccurrenceBindingSourceReady { transport: transport, module_path: module_path } =>
      NrdfcParsedReady {
        transport: transport,
        inputs: occurrence_binding_inputs_from_transport(
          module_path: module_path,
          transport: transport,
        ),
      }
  }
}

data nrdfc_specimen_path: String = "src/v1/gunbc/closure_fixture/namespace_reference_derived_closure_specimen.dag.txt"

data nrdfc_specimen_mutation_a_path: String = "src/v1/gunbc/closure_fixture/namespace_reference_derived_closure_specimen_mutation_a.dag.txt"

data nrdfc_specimen_mutation_b_path: String = "src/v1/gunbc/closure_fixture/namespace_reference_derived_closure_specimen_mutation_b.dag.txt"

data nrdfc_specimen_mutation_c_path: String = "src/v1/gunbc/closure_fixture/namespace_reference_derived_closure_specimen_mutation_c.dag.txt"

data nrdfc_specimen_mutation_d_path: String = "src/v1/gunbc/closure_fixture/namespace_reference_derived_closure_specimen_mutation_d.dag.txt"

fn nrdfc_load_specimen(path: String) -> String {
  filesystem_read(path: path).content
}

fn same_file_neighbour_observation(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
) -> ReferenceBindingObservation {
  match reference_named(transport: transport, name: "fn_a") {
    Absent =>
      SameFileNeighbourProductionRefused {
        gap: ReferenceBindingNamedReferenceAbsent,
      }
    Present { value: reference } =>
      match declarations_named(transport: transport, name: "fn_a") |> first {
        Absent =>
          SameFileNeighbourProductionRefused {
            gap: ReferenceBindingNamedDeclarationAbsent,
          }
        Present { value: neighbour } =>
          SameFileNeighbourObservation {
            neighbour: neighbour.occurrence,
            resolution: structural_binding_resolution_from_candidates(
              transport: transport,
              inputs: inputs,
              reference: reference,
            ),
          }
      }
  }
}

fn sibling_branch_observation(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
) -> ReferenceBindingObservation {
  let x_declarations = declarations_named(transport: transport, name: "x")
  let x_references = references_named(transport: transport, name: "x")
  match x_declarations |> first {
    Absent =>
      SiblingBranchProductionRefused {
        gap: ReferenceBindingNamedDeclarationAbsent,
      }
    Present { value: then_branch_x } =>
      match x_declarations |> reverse |> first {
        Absent =>
          SiblingBranchProductionRefused {
            gap: ReferenceBindingNamedDeclarationAbsent,
          }
        Present { value: else_branch_x } =>
          match x_references |> reverse |> first {
            Absent =>
              SiblingBranchObservation {
                own_branch_declaration: else_branch_x.occurrence,
                sibling_branch_declaration: then_branch_x.occurrence,
                resolution: StructuralBindingProductionRefused {
                  gap: ReferenceBindingNamedReferenceAbsent,
                },
              }
            Present { value: else_branch_ref } =>
              SiblingBranchObservation {
                own_branch_declaration: else_branch_x.occurrence,
                sibling_branch_declaration: then_branch_x.occurrence,
                resolution: structural_binding_resolution_from_candidates(
                  transport: transport,
                  inputs: inputs,
                  reference: else_branch_ref,
                ),
              }
          }
      }
  }
}

fn later_declaration_observation(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
) -> ReferenceBindingObservation {
  match reference_named(transport: transport, name: "fn_later") {
    Absent =>
      LaterDeclarationProductionRefused {
        gap: ReferenceBindingNamedReferenceAbsent,
      }
    Present { value: reference } =>
      match declarations_named(transport: transport, name: "fn_later") |> first {
        Absent =>
          LaterDeclarationProductionRefused {
            gap: ReferenceBindingNamedDeclarationAbsent,
          }
        Present { value: later_declaration } =>
          LaterDeclarationObservation {
            later_declaration: later_declaration.occurrence,
            resolution: structural_binding_resolution_from_candidates(
              transport: transport,
              inputs: inputs,
              reference: reference,
            ),
          }
      }
  }
}

fn distinct_homonym_observation(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
) -> ReferenceBindingObservation {
  match reference_named(transport: transport, name: "helper") {
    Absent =>
      DistinctHomonymProductionRefused {
        gap: ReferenceBindingNamedReferenceAbsent,
      }
    Present { value: reference } =>
      let helpers = declarations_named(transport: transport, name: "helper")
      match helpers |> first {
        Absent =>
          DistinctHomonymProductionRefused {
            gap: ReferenceBindingNamedDeclarationAbsent,
          }
        Present { value: first_helper } =>
          match helpers |> reverse |> first {
            Absent =>
              DistinctHomonymProductionRefused {
                gap: ReferenceBindingNamedDeclarationAbsent,
              }
            Present { value: second_helper } =>
              DistinctHomonymObservation {
                first_declaration: first_helper.occurrence,
                second_declaration: second_helper.occurrence,
                resolution: structural_binding_resolution_from_candidates(
                  transport: transport,
                  inputs: inputs,
                  reference: reference,
                ),
              }
          }
      }
  }
}

fn namespace_structural_binding_observations_for_source(
  file: String,
  source: String,
) -> List<ReferenceBindingObservation> {
  match nrdfc_parse(file: file, source: source) {
    NrdfcParsedRefused =>
      [
        SameFileNeighbourProductionRefused { gap: ReferenceBindingParserTransportRefused },
        SiblingBranchProductionRefused { gap: ReferenceBindingParserTransportRefused },
        LaterDeclarationProductionRefused { gap: ReferenceBindingParserTransportRefused },
        DistinctHomonymProductionRefused { gap: ReferenceBindingParserTransportRefused },
      ]
    NrdfcParsedReady { transport: transport, inputs: inputs } =>
      [
        same_file_neighbour_observation(transport: transport, inputs: inputs),
        sibling_branch_observation(transport: transport, inputs: inputs),
        later_declaration_observation(transport: transport, inputs: inputs),
        distinct_homonym_observation(transport: transport, inputs: inputs),
      ]
  }
}

fn namespace_structural_binding_observations_a_through_d() -> List<ReferenceBindingObservation> {
  namespace_structural_binding_observations_for_source(
    file: nrdfc_specimen_path,
    source: nrdfc_load_specimen(path: nrdfc_specimen_path),
  )
}

fn namespace_structural_binding_observations_mutation_a() -> List<ReferenceBindingObservation> {
  namespace_structural_binding_observations_for_source(
    file: nrdfc_specimen_mutation_a_path,
    source: nrdfc_load_specimen(path: nrdfc_specimen_mutation_a_path),
  )
}

fn namespace_structural_binding_observations_mutation_b() -> List<ReferenceBindingObservation> {
  namespace_structural_binding_observations_for_source(
    file: nrdfc_specimen_mutation_b_path,
    source: nrdfc_load_specimen(path: nrdfc_specimen_mutation_b_path),
  )
}

fn namespace_structural_binding_observations_mutation_c() -> List<ReferenceBindingObservation> {
  namespace_structural_binding_observations_for_source(
    file: nrdfc_specimen_mutation_c_path,
    source: nrdfc_load_specimen(path: nrdfc_specimen_mutation_c_path),
  )
}

fn namespace_structural_binding_observations_mutation_d() -> List<ReferenceBindingObservation> {
  namespace_structural_binding_observations_for_source(
    file: nrdfc_specimen_mutation_d_path,
    source: nrdfc_load_specimen(path: nrdfc_specimen_mutation_d_path),
  )
}
