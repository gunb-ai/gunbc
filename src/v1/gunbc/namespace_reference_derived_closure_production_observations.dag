                gap: std.reference_binding_observation.ReferenceBindingNamedDeclarationAbsent,
              }
            Present { value: later_declaration } =>
              std.reference_binding_observation.LaterDeclarationObservation {
                later_declaration: later_declaration.occurrence,
                resolution: std.reference_binding_observation.structural_binding_resolution_from_candidates(
                  transport: transport,
                  inputs: inputs,
                  reference: reference,
                ),
              }
          }
      }
  }
}

fn distinct_homonym_observation() -> std.reference_binding_observation.ReferenceBindingObservation {
  match nrdfc_parse(
    file: "gunbc/closure_fixture/distinct_homonym.dag",
    source: nrdfc_distinct_homonym_source(),
  ) {
    NrdfcParsedRefused =>
      std.reference_binding_observation.DistinctHomonymProductionRefused {
        gap: std.reference_binding_observation.ReferenceBindingParserTransportRefused,
      }
    NrdfcParsedReady { transport: transport, inputs: inputs } =>
      match v1.gunbc.occurrence_binding_parser_walk.reference_named(transport: transport, name: "helper") {
        Absent =>
          std.reference_binding_observation.DistinctHomonymProductionRefused {
            gap: std.reference_binding_observation.ReferenceBindingNamedReferenceAbsent,
          }
        Present { value: reference } =>
          let helpers = v1.gunbc.occurrence_binding_parser_walk.declarations_named(transport: transport, name: "helper")
          match helpers |> first {
            Absent =>
              std.reference_binding_observation.DistinctHomonymProductionRefused {
                gap: std.reference_binding_observation.ReferenceBindingNamedDeclarationAbsent,
              }
            Present { value: first_helper } =>
              match helpers |> reverse |> first {
                Absent =>
                  std.reference_binding_observation.DistinctHomonymProductionRefused {
                    gap: std.reference_binding_observation.ReferenceBindingNamedDeclarationAbsent,
                  }
                Present { value: second_helper } =>
                  std.reference_binding_observation.DistinctHomonymObservation {
                    first_declaration: first_helper.occurrence,
                    second_declaration: second_helper.occurrence,
                    resolution: std.reference_binding_observation.structural_binding_resolution_from_candidates(
                      transport: transport,
                      inputs: inputs,
                      reference: reference,
                    ),
                  }
              }
          }
      }
  }
}

fn namespace_structural_binding_observations_a_through_d() -> List<std.reference_binding_observation.ReferenceBindingObservation> {
  [
    same_file_neighbour_observation(),
    sibling_branch_observation(),
    later_declaration_observation(),
    distinct_homonym_observation(),
  ]
}
