module v1.gunbc.namespace_reference_derived_closure_production_observations


data namespace_reference_derived_closure_production_observations_note: String = "N3-A production observers for namespace-reference-derived-closure clauses (a-d). Returns neutral std.reference_binding_observation.ReferenceBindingObservation carriers only — no roadmap capability vocabulary and no assessment at this seam. namespace_structural_binding_observations_a_through_d is the sole export; capability projection lives in dag witnesses."

data namespace_reference_derived_closure_production_fixture_note: String = "Four independent hand-built fixtures — one per structural clause — exercised as discriminating evidence in src/v1/tests/claim/namespace_reference_derived_closure_production_admissions_witness_test.dag. They do NOT satisfy the namespace-structural-observations closing contract, which waits for ONE ORDINARY COMPILED FILE producing all four observations; each case shown failing on its own is the per-clause red-control requirement, not a licence for four separate fixture strings. Same-file neighbour and source-order/ambiguity fixtures mirror occurrence_binding_parser_walk_witness_test shapes; sibling decision-branch uses if/else let arms (parse_block nesting) because match-arm bodies remain siblings of pattern binders in v1.parse containment."

type NrdfcParsed
  = NrdfcParsedReady {
      transport: std.occurrence_identity.OccurrenceTransport,
      inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
    }
  | NrdfcParsedRefused

fn nrdfc_parse(file: String, source: String) -> NrdfcParsed {
  match v1.gunbc.occurrence_binding_parser_walk.parse_authored_occurrence_binding_source(file: file, source: source) {
    v1.gunbc.occurrence_binding_parser_walk.ParsedOccurrenceBindingSourceRefused => NrdfcParsedRefused
    v1.gunbc.occurrence_binding_parser_walk.ParsedOccurrenceBindingSourceReady { transport: transport, module_path: module_path } =>
      NrdfcParsedReady {
        transport: transport,
        inputs: v1.gunbc.occurrence_binding_parser_walk.occurrence_binding_inputs_from_transport(
          module_path: module_path,
          transport: transport,
        ),
      }
  }
}

fn nrdfc_same_file_neighbour_source() -> String {
  "module gunbc.closure_fixture.same_file_neighbour\n\nfn fn_a() -> Int {\n  10\n}\n\nfn fn_b() -> Int {\n  fn_a()\n}\n"
}

fn nrdfc_sibling_branch_source() -> String {
  "module gunbc.closure_fixture.sibling_branch\n\nfn demo(b: Bool) -> Int {\n  if b {\n    let x = 1\n    x\n  } else {\n    let x = 2\n    x\n  }\n}\n"
}

fn nrdfc_later_declaration_source() -> String {
  "module gunbc.closure_fixture.later_declaration\n\nfn demo() -> Int {\n  fn_later()\n}\n\nfn fn_later() -> Int {\n  0\n}\n"
}

fn nrdfc_distinct_homonym_source() -> String {
  "module gunbc.closure_fixture.distinct_homonym\n\nfn helper() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  1\n}\n\nfn demo() -> Int {\n  helper()\n}\n"
}

fn same_file_neighbour_observation() -> std.reference_binding_observation.ReferenceBindingObservation {
  match nrdfc_parse(
    file: "gunbc/closure_fixture/same_file_neighbour.dag",
    source: nrdfc_same_file_neighbour_source(),
  ) {
    NrdfcParsedRefused =>
      std.reference_binding_observation.SameFileNeighbourProductionRefused {
        gap: std.reference_binding_observation.ReferenceBindingParserTransportRefused,
      }
    NrdfcParsedReady { transport: transport, inputs: inputs } =>
      match v1.gunbc.occurrence_binding_parser_walk.reference_named(transport: transport, name: "fn_a") {
        Absent =>
          std.reference_binding_observation.SameFileNeighbourProductionRefused {
            gap: std.reference_binding_observation.ReferenceBindingNamedReferenceAbsent,
          }
        Present { value: reference } =>
          match v1.gunbc.occurrence_binding_parser_walk.declarations_named(transport: transport, name: "fn_a") |> first {
            Absent =>
              std.reference_binding_observation.SameFileNeighbourProductionRefused {
                gap: std.reference_binding_observation.ReferenceBindingNamedDeclarationAbsent,
              }
            Present { value: neighbour } =>
              std.reference_binding_observation.SameFileNeighbourObservation {
                neighbour: neighbour.occurrence,
                resolution: std.reference_binding_observation.structural_binding_resolution_from_candidates(
                  transport: transport,
                  inputs: inputs,
                  reference: reference,
                ),
              }
          }
      }
  }
}

fn sibling_branch_observation() -> std.reference_binding_observation.ReferenceBindingObservation {
  match nrdfc_parse(
    file: "gunbc/closure_fixture/sibling_branch.dag",
    source: nrdfc_sibling_branch_source(),
  ) {
    NrdfcParsedRefused =>
      std.reference_binding_observation.SiblingBranchProductionRefused {
        gap: std.reference_binding_observation.ReferenceBindingParserTransportRefused,
      }
    NrdfcParsedReady { transport: transport, inputs: inputs } =>
      let x_declarations = v1.gunbc.occurrence_binding_parser_walk.declarations_named(transport: transport, name: "x")
      let x_references = v1.gunbc.occurrence_binding_parser_walk.references_named(transport: transport, name: "x")
      match x_declarations |> first {
        Absent =>
          std.reference_binding_observation.SiblingBranchProductionRefused {
            gap: std.reference_binding_observation.ReferenceBindingNamedDeclarationAbsent,
          }
        Present { value: then_branch_x } =>
          match x_declarations |> reverse |> first {
            Absent =>
              std.reference_binding_observation.SiblingBranchProductionRefused {
                gap: std.reference_binding_observation.ReferenceBindingNamedDeclarationAbsent,
              }
            Present { value: else_branch_x } =>
              match x_references |> reverse |> first {
                Absent =>
                  std.reference_binding_observation.SiblingBranchObservation {
                    own_branch_declaration: else_branch_x.occurrence,
                    sibling_branch_declaration: then_branch_x.occurrence,
                    resolution: std.reference_binding_observation.StructuralBindingProductionRefused {
                      gap: std.reference_binding_observation.ReferenceBindingNamedReferenceAbsent,
                    },
                  }
                Present { value: else_branch_ref } =>
                  std.reference_binding_observation.SiblingBranchObservation {
                    own_branch_declaration: else_branch_x.occurrence,
                    sibling_branch_declaration: then_branch_x.occurrence,
                    resolution: std.reference_binding_observation.structural_binding_resolution_from_candidates(
                      transport: transport,
                      inputs: inputs,
                      reference: else_branch_ref,
                    ),
                  }
              }
          }
      }
  }
}

