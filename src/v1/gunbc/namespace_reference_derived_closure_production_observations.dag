    NrdfcParsedReady { transport: transport, inputs: inputs } =>
      match v1.gunbc.occurrence_binding_parser_walk.reference_named(transport: transport, name: "fn_later") {
        Absent =>
          std.reference_binding_observation.LaterDeclarationProductionRefused {
            gap: std.reference_binding_observation.ReferenceBindingNamedReferenceAbsent,
          }
        Present { value: reference } =>
          match v1.gunbc.occurrence_binding_parser_walk.declarations_named(transport: transport, name: "fn_later") |> first {
