module v1.gunbc.namespace_reference_derived_closure_production_observations

import std.occurrence_identity { OccurrenceTransport, OccurrenceId }
import std.occurrence_binding_candidates {
  OccurrenceBindingCandidateInputs,
}
import std.reference_binding_observation {
  ReferenceBindingObservation,
  StructuralBindingProductionRefused,
  ReferenceBindingParserTransportRefused,
  ReferenceBindingNamedReferenceAbsent,
  ReferenceBindingNamedDeclarationAbsent,
  SameFileNeighbourObservation,
  SameFileNeighbourProductionRefused,
  SiblingBranchObservation,
  SiblingBranchProductionRefused,
  LaterDeclarationObservation,
  LaterDeclarationProductionRefused,
  DistinctHomonymObservation,
  DistinctHomonymProductionRefused,
  structural_binding_resolution_from_candidates,
}
import std.types { List, String }
import v1.gunbc.occurrence_binding_parser_walk {
  ParsedOccurrenceBindingSourceReady,
  ParsedOccurrenceBindingSourceRefused,
  parse_authored_occurrence_binding_source,
  occurrence_binding_inputs_from_transport,
  reference_named,
  declarations_named,
  references_named,
}

data namespace_reference_derived_closure_production_observations_note: String = "N3-A production observers for namespace-reference-derived-closure clauses (a-d). Returns neutral std.reference_binding_observation.ReferenceBindingObservation carriers only — no roadmap capability vocabulary and no assessment at this seam. namespace_structural_binding_observations_a_through_d is the sole base export; capability projection lives in dag witnesses / the src/v1 execution bridge."

data namespace_reference_derived_closure_production_specimen_note: String = "ONE ordinary compiled specimen (nrdfc_specimen_source) is parsed once through the real tokenizer/parser and all four clause observations are derived from that single OccurrenceTransport — namespace_structural_binding_observations_for_source is the shared parse-once seam every export (base and mutation) routes through. Four discriminating mutations (nrdfc_specimen_source_mutation_a..d) each delete exactly the one declaration a single clause depends on, leaving the other three clauses' declarations byte-identical; src/v1/gunbc/namespace_reference_derived_closure_live_admissions.dag folds base-establishes-all-four and each-mutation-breaks-exactly-its-own-clause into the N3-A closing receipt. Sibling decision-branch uses if/else let arms (parse_block nesting) because match-arm bodies remain siblings of pattern binders in v1.parse containment."

type NrdfcParsed
  = NrdfcParsedReady {
      transport: OccurrenceTransport,
      inputs: OccurrenceBindingCandidateInputs,
    }
  | NrdfcParsedRefused

fn nrdfc_parse(file: String, source: String) -> NrdfcParsed {
  match parse_authored_occurrence_binding_source(file: file, source: source) {
    ParsedOccurrenceBindingSourceRefused => NrdfcParsedRefused
    ParsedOccurrenceBindingSourceReady { transport: transport, module_path: module_path } =>
      NrdfcParsedReady {
        transport: transport,
        inputs: occurrence_binding_inputs_from_transport(
          module_path: module_path,
          transport: transport,
        ),
      }
  }
}

fn nrdfc_specimen_source() -> String {
  "module gunbc.closure_fixture.namespace_reference_derived_closure_specimen\n\nfn fn_a() -> Int {\n  10\n}\n\nfn fn_b() -> Int {\n  fn_a()\n}\n\nfn sibling_branch_demo(b: Bool) -> Int {\n  if b {\n    let x = 1\n    x\n  } else {\n    let x = 2\n    x\n  }\n}\n\nfn later_declaration_demo() -> Int {\n  fn_later()\n}\n\nfn fn_later() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  1\n}\n\nfn distinct_homonym_demo() -> Int {\n  helper()\n}\n"
}

fn nrdfc_specimen_source_mutation_a() -> String {
  "module gunbc.closure_fixture.namespace_reference_derived_closure_specimen\n\nfn fn_b() -> Int {\n  fn_a()\n}\n\nfn sibling_branch_demo(b: Bool) -> Int {\n  if b {\n    let x = 1\n    x\n  } else {\n    let x = 2\n    x\n  }\n}\n\nfn later_declaration_demo() -> Int {\n  fn_later()\n}\n\nfn fn_later() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  1\n}\n\nfn distinct_homonym_demo() -> Int {\n  helper()\n}\n"
}

fn nrdfc_specimen_source_mutation_b() -> String {
  "module gunbc.closure_fixture.namespace_reference_derived_closure_specimen\n\nfn fn_a() -> Int {\n  10\n}\n\nfn fn_b() -> Int {\n  fn_a()\n}\n\nfn sibling_branch_demo(b: Bool) -> Int {\n  if b {\n    let x = 1\n    x\n  } else {\n    5\n  }\n}\n\nfn later_declaration_demo() -> Int {\n  fn_later()\n}\n\nfn fn_later() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  0\n}\n\nfn helper() -> Int {\n  1\n}\n\nfn distinct_homonym_demo() -> Int {\n  helper()\n}\n"
}

