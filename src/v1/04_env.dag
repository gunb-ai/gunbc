module v1.compiler.infer_env






type TypeEnv {
  bindings: Map<Int, v1.compiler.infer_env.TypeBinding>
  str_bindings: Map<String, v1.compiler.infer_env.TypeBinding>
  ancestry_str_bindings: Map<String, v1.compiler.infer_env.TypeBinding>
  parents: List<v1.compiler.infer_env.TypeEnv>
  recursive_types: List<Int>
  recursive_type_set: Map<Int, Bool>
  inductive_fields: Map<String, List<std.induction.InductiveField>>
  source_indices: Map<String, v1.std.core.NewlineIndex>
  intern_table: v1.std.core.InternTable
  source_visible_names: Map<String, Bool>
  symbol_index: v1.compiler.infer_env.SymbolIndex
  module_path: String
}

type TypeBinding {
  name: String
  resolved: v1.std.core.Node
  provenance: std.induction.SubValueRelation
}

data global_bare_fallback_invariant: String = "Corpus-wide bare-name census, resolved by ONE uniform containment walk (operator ruling 2026-07-18: global uniqueness is NOT a special tier — it is the shallowest level of the same walk; filepaths are irrelevant, the declared module path is the containment tree). SymbolIndex.global_bare is keyed on the bare declared name and built once by build_symbol_index_census over graph.modules before any module typechecks (order-independent). Tracking is decl-only via symbol_index_insert_decl / local_binding_for_item (type/fn/data names) plus corpus-globally-unique v1.std.core.Disj variant aliases (unique across the WHOLE bare-name space: a variant whose name any type/fn/data decl claims stays qualified-only, never a global_bare candidate — else a type-vs-variant tie, e.g. actions.Job vs ExpressionContext.Job, refuses every far use of the TYPE); every homonym keeps its FULL candidate list (module_path + binding), never a candidate-free Ambiguous tombstone. Resolution (global_bare_lookup): a single candidate resolves from anywhere (the one-candidate degenerate case of the walk); multiple candidates resolve by nearest-ancestor containment under ImportScoped, while NamespaceOnlyY filters to the referencing module's containment chain and routes 0/1/many through module_path_owner_binding_decide. The production flip that removes the corpus fallback is downstream of reference-derived closure. lookup_binding_by_name consults global_bare only after str_bindings/ancestry_str_bindings/intern+bindings all miss. Variant arms additionally merge into per-module variant_locals via merge_global_bare_variant_locals (constructor_binding_authority — owner is the coproduct node)."

data qualified_module_projection_invariant: String = "Grammar lane G1/G1b: container.member module projection in value/type/pattern and fn/data/let type-annotation positions resolves via symbol_index_lookup on the full qualified path (module projection), not value field-access — v2 resolve: TypeNode Conj QN spines; v1 typecheck: lookup_binding_by_name after global_bare; v1 patterns: lookup_variant_in_type routes dotted variant names through symbol_index_lookup. build_symbol_index_census materializes declared-module item paths plus module-unique v1.std.core.Disj variant aliases (qualified path always; corpus-unique variants also enter global_bare — mirrors v2 symbol_index_fill_unique_variant_aliases); lookup_qualified_module_projection runs only when the reference carries a dot (fail-closed on miss — never widens to field-access semantics)."

type GlobalBareCandidate {
  module_path: String
  binding: v1.compiler.infer_env.TypeBinding
}

type GlobalBareLookupState
  = GlobalBareUniqueBinding { module_path: String, binding: v1.compiler.infer_env.TypeBinding }
  | GlobalBareAmbiguousBinding { candidates: List<v1.compiler.infer_env.GlobalBareCandidate> }

type ImportBinding {
  name: String
  resolved: v1.std.core.Node
}

type ScopeBinding {
  name: String
  resolved: v1.std.core.Node
  provenance: std.induction.SubValueRelation
}

type ServiceCensusEntry {
  module_path: String
  item: v1.std.core.Node
}

type SymbolIndex {
  entries: Map<String, v1.std.core.Node>
  global_bare: Map<String, v1.compiler.infer_env.GlobalBareLookupState>
  services: Map<String, v1.compiler.infer_env.ServiceCensusEntry>
}

type Scope {
  locals: Map<String, v1.compiler.infer_env.ScopeBinding>
}

fn empty_symbol_index() -> v1.compiler.infer_env.SymbolIndex {
  SymbolIndex { entries: empty_map(), global_bare: empty_map(), services: empty_map() }
}

fn empty_type_env() -> v1.compiler.infer_env.TypeEnv {
  TypeEnv {
    module_path: "",
    bindings: empty_map(),
    str_bindings: empty_map(),
    ancestry_str_bindings: empty_map(),
    parents: [],
    recursive_types: [],
    recursive_type_set: empty_map(),
    inductive_fields: empty_map(),
    source_indices: empty_map(),
    intern_table: empty_intern_table(),
    source_visible_names: empty_map(),
    symbol_index: v1.compiler.infer_env.empty_symbol_index()
  }
}

fn symbol_index_lookup(index: v1.compiler.infer_env.SymbolIndex, qualified_name: String) -> v1.std.core.Node? {
  map_get(index.entries, qualified_name)
}

fn global_bare_candidates_contain(candidates: List<v1.compiler.infer_env.GlobalBareCandidate>, resolved: v1.std.core.Node) -> Bool {
  candidates |> any(c => c.binding.resolved == resolved)
}

fn symbol_index_track_global_bare(
  global_bare: Map<String, v1.compiler.infer_env.GlobalBareLookupState>,
  module_path: String,
  binding: v1.compiler.infer_env.TypeBinding
) -> Map<String, v1.compiler.infer_env.GlobalBareLookupState> {
  match map_get(global_bare, binding.name) {
    Present { value: GlobalBareAmbiguousBinding { candidates: cands } } =>
      if global_bare_candidates_contain(candidates: cands, resolved: binding.resolved) {
        global_bare
      } else {
        map_insert(global_bare, binding.name, GlobalBareAmbiguousBinding {
          candidates: concat(cands, [GlobalBareCandidate { module_path: module_path, binding: binding }])
        })
      }
    Present { value: GlobalBareUniqueBinding { module_path: existing_path, binding: existing } } =>
      if existing.resolved == binding.resolved {
        global_bare
      } else {
        map_insert(global_bare, binding.name, GlobalBareAmbiguousBinding {
          candidates: [
            GlobalBareCandidate { module_path: existing_path, binding: existing },
            v1.compiler.infer_env.GlobalBareCandidate { module_path: module_path, binding: binding }
          ]
        })
      }
    Absent => map_insert(global_bare, binding.name, GlobalBareUniqueBinding { module_path: module_path, binding: binding })
  }
}

fn symbol_index_insert(index: v1.compiler.infer_env.SymbolIndex, qualified_name: String, resolved: v1.std.core.Node) -> v1.compiler.infer_env.SymbolIndex {
  SymbolIndex {
    entries: map_insert(index.entries, qualified_name, resolved),
    global_bare: index.global_bare,
    services: index.services
  }
}

fn symbol_index_insert_decl(index: v1.compiler.infer_env.SymbolIndex, module_path: String, binding: v1.compiler.infer_env.TypeBinding) -> v1.compiler.infer_env.SymbolIndex {
  SymbolIndex {
    entries: map_insert(index.entries, concat(module_path, ".", binding.name), binding.resolved),
    global_bare: v1.compiler.infer_env.symbol_index_track_global_bare(global_bare: index.global_bare, module_path: module_path, binding: binding),
    services: index.services
  }
}

fn symbol_index_insert_service(index: v1.compiler.infer_env.SymbolIndex, name: String, module_path: String, item: v1.std.core.Node) -> v1.compiler.infer_env.SymbolIndex {
  SymbolIndex {
    entries: index.entries,
    global_bare: index.global_bare,
    services: map_insert(index.services, name, v1.compiler.infer_env.ServiceCensusEntry { module_path: module_path, item: item })
  }
}

fn empty_scope() -> v1.compiler.infer_env.Scope {
  Scope { locals: empty_map() }
}

fn scope_lookup(scope: v1.compiler.infer_env.Scope, name: String) -> v1.compiler.infer_env.ScopeBinding? {
  map_get(scope.locals, name)
}

fn scope_push(scope: v1.compiler.infer_env.Scope, binding: v1.compiler.infer_env.ScopeBinding) -> v1.compiler.infer_env.Scope {
  Scope { locals: map_insert(scope.locals, binding.name, binding) }
}

type TypeEnvCache {
  deps_map: Map<String, List<String>>
  str_bindings: Map<String, v1.compiler.infer_env.TypeBinding>
  cycle_set_str: Map<String, Bool>
  variant_locals: Map<String, v1.compiler.infer_env.TypeBinding>
}

data visible_bindings_invariant: String = "B1 build_type_env populates ancestry_str_bindings for import chains; lookup_binding_by_name is fail-closed on miss (str_bindings then ancestry_str_bindings then intern+bindings only; 6de571f3 reverted in 80ab63a). flatten_visible_bindings and merge_envs are DELETED (2026-07-06 operator ruling: the parent-recurse counter was a parallel representation guarding a fallback; the fallback is now unwritable by construction — no whole-env flatten exists to call). Visibility reads are one-level: local str_bindings/ancestry_str_bindings, or a fold over parent.str_bindings only (see collect_unit_variant_phantom_matches). Dissolve-on: namespace-as-sole-authority ruling — env maps become a derived projection of namespace reachability."

fn empty_type_env_cache() -> v1.compiler.infer_env.TypeEnvCache {
  TypeEnvCache {
    deps_map: empty_map(),
    str_bindings: empty_map(),
    cycle_set_str: empty_map(),
    variant_locals: empty_map()
  }
}

type TypeEnvCacheMergeConflict {
  name: String
  import_path: String
  existing_site: String
  incoming_site: String
  span: std.types.SourceSpan
  same_tree: Bool
}

data source_tree_partition_note: String = "Tree partition for the binding-fork ledger (lane ruling REVISED 2026-07-11: NOVELTY, not TREE, is the refusal axis). Tree does NOT decide refuse-vs-ledger anymore - it only LABELS the dissolution partition of an already-ledgered fork: same-tree (both decls under one tree, incl. dag-vs-dag across dirs) = a homonym/fork to consolidate within that tree; cross-tree (dag/ vs src/v2/) = the v1-seed-vs-v2 whole-file duplication the namespace census named; kernel-synthetic sites (<kernel:...>) are their own tree = the kernel-shadow class. ALL of these are LEDGERED (pre-existing forks already resolved on main by overlay-wins; refusing retroactively would regress working resolution), keeping the pre-guard import-order winner. Refusal is reserved for forks a PR NEWLY introduces (the novelty gate, a separate follow-up comparing this ledger to a drift-gated baseline). Partition on tree, never dir."

fn source_tree_of(file: String) -> String {
  if contains(file, "<kernel:") {
    "kernel"
  } else if contains(file, "src/v2") {
    "src/v2"
  } else if contains(file, "src/v1") {
    "src/v1"
  } else if contains(file, "dag/") {
    "dag"
  } else {
    "other"
  }
}

fn conflict_is_cross_tree(c: v1.compiler.infer_env.TypeEnvCacheMergeConflict) -> Bool {
  source_tree_of(file: c.existing_site) != source_tree_of(file: c.incoming_site)
}

type GuardedTypeEnvCacheMerge {
  cache: v1.compiler.infer_env.TypeEnvCache
  conflicts: List<v1.compiler.infer_env.TypeEnvCacheMergeConflict>
}

data guarded_cache_union_note: String = "Cross-parent cache union (S2a move 2 increment B; lane ruling REVISED 2026-07-11: NOVELTY, not TREE, is the refusal axis). A name reachable from two PEER imports with different bindings is a binding FORK. The union is order-INDEPENDENT by construction: keys present in both sides carrying the SAME binding (declaration-site span fast path, structural fallback) are SKIPPED (also the retained-bytes fix - the unguarded merge materialized a fresh O(|ancestry|) HAMT per module via rc_map_merge path-copy, the measured ~16.3MiB/module residency class); keys carrying DIFFERENT bindings are recorded as a typed, located conflict AND resolved by the pre-cut import-order overlay-wins winner (behavior-preserving: main already resolves these by overlay-wins, so refusing retroactively would regress working resolution, NOT close a fail-open). These conflicts are LEDGERED (out-of-band binding_forks channel, partitioned by tree for dissolution), never diagnostics; refusal is reserved for forks a PR NEWLY introduces (the separate novelty gate). Positional layers keep overlay-wins outside the guard: the kernel scope layer (merge_type_env_cache below) and locals-over-ancestry are lexical nearest-wins from the containment ruling, not peer-merge forks."

fn binding_same_authority(a: v1.compiler.infer_env.TypeBinding, b: v1.compiler.infer_env.TypeBinding) -> Bool {
  if a.resolved.span == b.resolved.span {
    true
  } else {
    a == b
  }
}

data union_base_choice_note: String = "M1a base-choice (v1-run-stability-throughline §2.1, M0 receipt dup_factor=1.00): each union walks the SMALLER side's keys into the LARGER side's HAMT, so the result Rc-shares the large spine instead of freshly path-copying it key-by-key (the pre-cut accumulator was always the first parent - typically a small leaf - so every module materialized ~its whole closure's name surface fresh, across four maps). The winner is ORIENTATION-INDEPENDENT: each public union dispatches on count (O(1) on the persistent map) between an into-acc body (the pre-cut walk) and an into-overlay mirror whose conflict winner is identical (overlay-wins for str_bindings/deps_map/variant_locals, acc-wins for cycle_set_str); same-authority keys keep the retained side's copy - the span fast path declares the copies the same binding, and the whole-corpus fingerprint oracle is the drift check. Fold order stays import-order; conflict rows keep semantic roles (existing = accumulated side, incoming = overlay side) regardless of walk direction - the ledger's consumers are count/partition-grain, row order is not load-bearing."

fn guarded_union_str_bindings_into_acc(
  acc: Map<String, v1.compiler.infer_env.TypeBinding>,
  overlay: Map<String, v1.compiler.infer_env.TypeBinding>,
  import_path: String,
  conflicts: List<v1.compiler.infer_env.TypeEnvCacheMergeConflict>
) -> v1.compiler.infer_env.GuardedStrBindingsUnion {
  fold(overlay |> map_keys, init: v1.compiler.infer_env.GuardedStrBindingsUnion { bindings: acc, conflicts: conflicts }, f: (state, name) =>
    match map_get(overlay, name) {
      Absent => state
      Present { value: incoming } =>
        match map_get(state.bindings, name) {
          Absent => GuardedStrBindingsUnion {
            bindings: map_insert(state.bindings, name, incoming),
            conflicts: state.conflicts
          }
          Present { value: existing } =>
            if binding_same_authority(a: existing, b: incoming) {
              state
            } else {
              GuardedStrBindingsUnion {
                bindings: map_insert(state.bindings, name, incoming),
                conflicts: concat(state.conflicts, [TypeEnvCacheMergeConflict { name: name, import_path: import_path, existing_site: existing.resolved.span.file, incoming_site: incoming.resolved.span.file, span: incoming.resolved.span, same_tree: source_tree_of(file: existing.resolved.span.file) == source_tree_of(file: incoming.resolved.span.file) }])
              }
            }
        }
    }
  )
}

fn guarded_union_str_bindings_into_overlay(
  acc: Map<String, v1.compiler.infer_env.TypeBinding>,
  overlay: Map<String, v1.compiler.infer_env.TypeBinding>,
  import_path: String,
  conflicts: List<v1.compiler.infer_env.TypeEnvCacheMergeConflict>
) -> v1.compiler.infer_env.GuardedStrBindingsUnion {
  fold(acc |> map_keys, init: v1.compiler.infer_env.GuardedStrBindingsUnion { bindings: overlay, conflicts: conflicts }, f: (state, name) =>
    match map_get(acc, name) {
      Absent => state
      Present { value: accumulated } =>
        match map_get(state.bindings, name) {
          Absent => GuardedStrBindingsUnion {
            bindings: map_insert(state.bindings, name, accumulated),
            conflicts: state.conflicts
          }
          Present { value: incoming } =>
            if binding_same_authority(a: accumulated, b: incoming) {
              state
            } else {
              GuardedStrBindingsUnion {
                bindings: state.bindings,
                conflicts: concat(state.conflicts, [TypeEnvCacheMergeConflict { name: name, import_path: import_path, existing_site: accumulated.resolved.span.file, incoming_site: incoming.resolved.span.file, span: incoming.resolved.span, same_tree: source_tree_of(file: accumulated.resolved.span.file) == source_tree_of(file: incoming.resolved.span.file) }])
              }
            }
        }
    }
  )
}

fn guarded_union_str_bindings(
  acc: Map<String, v1.compiler.infer_env.TypeBinding>,
  overlay: Map<String, v1.compiler.infer_env.TypeBinding>,
  import_path: String,
  conflicts: List<v1.compiler.infer_env.TypeEnvCacheMergeConflict>
) -> v1.compiler.infer_env.GuardedStrBindingsUnion {
  if (acc |> count) >= (overlay |> count) {
    guarded_union_str_bindings_into_acc(acc: acc, overlay: overlay, import_path: import_path, conflicts: conflicts)
  } else {
    guarded_union_str_bindings_into_overlay(acc: acc, overlay: overlay, import_path: import_path, conflicts: conflicts)
  }
}

type GuardedStrBindingsUnion {
  bindings: Map<String, v1.compiler.infer_env.TypeBinding>
  conflicts: List<v1.compiler.infer_env.TypeEnvCacheMergeConflict>
}

fn union_deps_map_into_acc(acc: Map<String, List<String>>, overlay: Map<String, List<String>>) -> Map<String, List<String>> {
  fold(overlay |> map_keys, init: acc, f: (m, name) =>
    match map_get(overlay, name) {
      Absent => m
      Present { value: incoming } =>
        match map_get(m, name) {
          Absent => map_insert(m, name, incoming)
          Present { value: existing } => if existing == incoming { m } else { map_insert(m, name, incoming) }
        }
    }
  )
}

fn union_deps_map_into_overlay(acc: Map<String, List<String>>, overlay: Map<String, List<String>>) -> Map<String, List<String>> {
  fold(acc |> map_keys, init: overlay, f: (m, name) =>
    match map_get(acc, name) {
      Absent => m
      Present { value: accumulated } =>
        match map_get(m, name) {
          Absent => map_insert(m, name, accumulated)
          Present { value: _incoming } => m
        }
    }
  )
}

fn union_deps_map_skip_equal(acc: Map<String, List<String>>, overlay: Map<String, List<String>>) -> Map<String, List<String>> {
  if (acc |> count) >= (overlay |> count) {
    union_deps_map_into_acc(acc: acc, overlay: overlay)
  } else {
    union_deps_map_into_overlay(acc: acc, overlay: overlay)
  }
}

fn union_bool_set_into_acc(acc: Map<String, Bool>, overlay: Map<String, Bool>) -> Map<String, Bool> {
  fold(overlay |> map_keys, init: acc, f: (m, name) =>
    match map_get(m, name) {
      Present { value: _ } => m
      Absent =>
        match map_get(overlay, name) {
          Present { value: v } => map_insert(m, name, v)
          Absent => m
        }
    }
  )
}

fn union_bool_set_into_overlay(acc: Map<String, Bool>, overlay: Map<String, Bool>) -> Map<String, Bool> {
  fold(acc |> map_keys, init: overlay, f: (m, name) =>
    match map_get(acc, name) {
      Absent => m
      Present { value: accumulated } =>
        match map_get(m, name) {
          Absent => map_insert(m, name, accumulated)
          Present { value: incoming } => if incoming == accumulated { m } else { map_insert(m, name, accumulated) }
        }
    }
  )
}

fn union_bool_set_skip_equal(acc: Map<String, Bool>, overlay: Map<String, Bool>) -> Map<String, Bool> {
  if (acc |> count) >= (overlay |> count) {
    union_bool_set_into_acc(acc: acc, overlay: overlay)
  } else {
    union_bool_set_into_overlay(acc: acc, overlay: overlay)
  }
}

fn union_variant_locals_into_acc(acc: Map<String, v1.compiler.infer_env.TypeBinding>, overlay: Map<String, v1.compiler.infer_env.TypeBinding>) -> Map<String, v1.compiler.infer_env.TypeBinding> {
  fold(overlay |> map_keys, init: acc, f: (m, name) =>
    match map_get(overlay, name) {
      Absent => m
      Present { value: incoming } =>
        match map_get(m, name) {
          Absent => map_insert(m, name, incoming)
          Present { value: _existing } => map_insert(m, name, incoming)
        }
    }
  )
}

fn union_variant_locals_into_overlay(acc: Map<String, v1.compiler.infer_env.TypeBinding>, overlay: Map<String, v1.compiler.infer_env.TypeBinding>) -> Map<String, v1.compiler.infer_env.TypeBinding> {
  fold(acc |> map_keys, init: overlay, f: (m, name) =>
    match map_get(acc, name) {
      Absent => m
      Present { value: accumulated } =>
        match map_get(m, name) {
          Absent => map_insert(m, name, accumulated)
          Present { value: _incoming } => m
        }
    }
  )
}

fn union_variant_locals_skip_equal(acc: Map<String, v1.compiler.infer_env.TypeBinding>, overlay: Map<String, v1.compiler.infer_env.TypeBinding>) -> Map<String, v1.compiler.infer_env.TypeBinding> {
  if (acc |> count) >= (overlay |> count) {
    union_variant_locals_into_acc(acc: acc, overlay: overlay)
  } else {
    union_variant_locals_into_overlay(acc: acc, overlay: overlay)
  }
}

fn merge_type_env_cache_guarded(
  base: v1.compiler.infer_env.TypeEnvCache,
  overlay: v1.compiler.infer_env.TypeEnvCache,
  import_path: String,
  conflicts: List<v1.compiler.infer_env.TypeEnvCacheMergeConflict>
) -> v1.compiler.infer_env.GuardedTypeEnvCacheMerge {
  let str_union = guarded_union_str_bindings(acc: base.str_bindings, overlay: overlay.str_bindings, import_path: import_path, conflicts: conflicts)
  GuardedTypeEnvCacheMerge {
    cache: v1.compiler.infer_env.TypeEnvCache {
      deps_map: union_deps_map_skip_equal(acc: base.deps_map, overlay: overlay.deps_map),
      str_bindings: str_union.bindings,
      cycle_set_str: union_bool_set_skip_equal(acc: base.cycle_set_str, overlay: overlay.cycle_set_str),
      variant_locals: union_variant_locals_skip_equal(acc: base.variant_locals, overlay: overlay.variant_locals)
    },
    conflicts: str_union.conflicts
  }
}

fn merge_type_env_cache(base: v1.compiler.infer_env.TypeEnvCache, overlay: v1.compiler.infer_env.TypeEnvCache) -> v1.compiler.infer_env.TypeEnvCache {
  TypeEnvCache {
    deps_map: map_merge(base.deps_map, overlay.deps_map),
    str_bindings: map_merge(base.str_bindings, overlay.str_bindings),
    cycle_set_str: map_merge(base.cycle_set_str, overlay.cycle_set_str),
    variant_locals: map_merge(base.variant_locals, overlay.variant_locals)
  }
}

fn lookup_binding_local_by_name(env: v1.compiler.infer_env.TypeEnv, name: String) -> v1.compiler.infer_env.TypeBinding? {
  match intern_find(table: env.intern_table, s: name) {
    Present { value: ident } =>
      match map_get(env.bindings, ident) {
        Present { value: binding } => Present { value: binding }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn str_bindings_from_bindings(bindings: Map<Int, v1.compiler.infer_env.TypeBinding>) -> Map<String, v1.compiler.infer_env.TypeBinding> {
  fold(bindings |> map_values, init: empty_map(), f: (acc, binding) =>
    map_insert(acc, binding.name, binding)
  )
}

fn lookup_binding_by_name_local(env: v1.compiler.infer_env.TypeEnv, name: String) -> v1.compiler.infer_env.TypeBinding? {
  match map_get(env.str_bindings, name) {
    Present { value: binding } => Present { value: binding }
    Absent =>
      match map_get(env.ancestry_str_bindings, name) {
        Present { value: binding } => Present { value: binding }
        Absent =>
          match intern_find(table: env.intern_table, s: name) {
            Present { value: id } => map_get(env.bindings, id)
            Absent => Absent
          }
      }
  }
}

fn lookup_binding_by_name(env: v1.compiler.infer_env.TypeEnv, name: String) -> v1.compiler.infer_env.TypeBinding? {
  match lookup_binding_by_name_local(env: env, name: name) {
    Present { value: binding } => Present { value: binding }
    Absent => lookup_binding_after_global_bare(env: env, name: name)
  }
}

data closure_independent_bare_free_call_note: String = "Closure-independent bare free-call binding (#6985 / #8062): symbols registered here refuse global_bare / pool-coincidence resolution unless the name is in source_visible_names (selective import or kernel surface). Dissolve-on: PrimitiveDefinition identity-join closes the denominator so every importable free fn is registered once with its definer module — not a hand-maintained trim-only list."

fn lookup_binding_after_global_bare(env: v1.compiler.infer_env.TypeEnv, name: String) -> v1.compiler.infer_env.TypeBinding? {
  match global_bare_lookup(env: env, name: name) {
    Present { value: binding } => Present { value: binding }
    Absent => lookup_qualified_module_projection(env: env, name: name)
  }
}

fn lookup_qualified_module_projection(env: v1.compiler.infer_env.TypeEnv, name: String) -> v1.compiler.infer_env.TypeBinding? {
  match contains(name, ".") {
    false => Absent
    true =>
      match v1.compiler.infer_env.symbol_index_lookup(index: env.symbol_index, qualified_name: name) {
        Present { value: resolved } =>
          Present {
            value: v1.compiler.infer_env.TypeBinding {
              name: name,
              resolved: resolved,
              provenance: SubValueUnknown
            }
          }
        Absent => Absent
      }
  }
}

type SegmentLcpScan {
  remaining: List<String>
  matched: Int
  live: Bool
}

fn segment_lcp_len(a: List<String>, b: List<String>) -> Int {
  let scan = fold(a, init: v1.compiler.infer_env.SegmentLcpScan { remaining: b, matched: 0, live: true }, f: (acc, seg) =>
    if acc.live {
      match acc.remaining |> first {
        Present { value: bh } =>
          if bh == seg {
            SegmentLcpScan { remaining: acc.remaining |> skip(1), matched: acc.matched + 1, live: true }
          } else {
            SegmentLcpScan { remaining: acc.remaining, matched: acc.matched, live: false }
          }
        Absent => SegmentLcpScan { remaining: acc.remaining, matched: acc.matched, live: false }
      }
    } else { acc }
  )
  scan.matched
}

type GlobalBareNearestScan {
  best_lcp: Int
  best: v1.compiler.infer_env.TypeBinding?
  tie: Bool
}

type GlobalBareNearestCandidateScan {
  best_lcp: Int
  best: v1.compiler.infer_env.GlobalBareCandidate?
  tie: Bool
}

fn global_bare_nearest_ancestor_candidate(env_module_path: String, candidates: List<v1.compiler.infer_env.GlobalBareCandidate>) -> v1.compiler.infer_env.GlobalBareCandidate? {
  let env_segs = module_path_segments(path: env_module_path)
  let scan = fold(candidates, init: v1.compiler.infer_env.GlobalBareNearestCandidateScan { best_lcp: 0 - 1, best: none, tie: false }, f: (acc, cand) =>
    let l = segment_lcp_len(a: env_segs, b: module_path_segments(path: cand.module_path))
    if l > acc.best_lcp {
      GlobalBareNearestCandidateScan { best_lcp: l, best: Present { value: cand }, tie: false }
    } else if l == acc.best_lcp {
      GlobalBareNearestCandidateScan { best_lcp: acc.best_lcp, best: acc.best, tie: true }
    } else { acc }
  )
  match scan.tie {
    true => Absent
    false => scan.best
  }
}

fn global_bare_nearest_ancestor(env_module_path: String, candidates: List<v1.compiler.infer_env.GlobalBareCandidate>) -> v1.compiler.infer_env.TypeBinding? {
  match global_bare_nearest_ancestor_candidate(env_module_path: env_module_path, candidates: candidates) {
    Present { value: cand } => Present { value: cand.binding }
    Absent => Absent
  }
}

data unique_on_chain_policy_note: String = "namespace-resolution-design.md 13 (operator-ratified 2026-07-21), landed as 8 step 1 with step-4 default ON = NamespaceOnlyY (name_resolution_policy_is_namespace_only; host bracket false = ImportScoped byte-for-byte): a bare homonym resolves to the UNIQUE binder on the referencing module's ancestor chain — a candidate is on the chain iff its declaring module path is a leading-segment prefix of (or equal to) TypeEnv.module_path. Exactly one on-chain candidate resolves; two-plus on-chain REFUSES as typed AmbiguousReference with the full chain population; zero on-chain REFUSES as UnresolvedType. Cardinality for the chain population routes through module_path_owner_binding_decide."

// The single definition of "on the referencing module's ancestor chain", per
// unique_on_chain_policy_note. Both the unique and the ambiguous global-bare arms consult
// THIS predicate, so visibility is decided one way for one name regardless of how many
// candidates happen to carry that spelling.
fn global_bare_module_on_chain(env_module_path: String, cand_module_path: String) -> Bool {
  let cand_segs = module_path_segments(path: cand_module_path)
  segment_lcp_len(a: cand_segs, b: module_path_segments(path: env_module_path)) == (cand_segs |> count)
}

fn global_bare_chain_candidates(env_module_path: String, candidates: List<v1.compiler.infer_env.GlobalBareCandidate>) -> List<v1.compiler.infer_env.GlobalBareCandidate> {
  candidates |> filter(cand =>
    global_bare_module_on_chain(env_module_path: env_module_path, cand_module_path: cand.module_path)
  )
}

fn global_bare_unique_chain_candidate(env_module_path: String, candidates: List<v1.compiler.infer_env.GlobalBareCandidate>) -> v1.compiler.infer_env.GlobalBareCandidate? {
  let chain = global_bare_chain_candidates(env_module_path: env_module_path, candidates: candidates)
  match module_path_owner_binding_decide(owners: chain |> map(c => c.module_path)) {
    ModulePathBindingHit { owner: owner } =>
      chain |> filter(c => c.module_path == owner) |> first
    ModulePathBindingMiss => Absent
    ModulePathBindingAmbiguous { owners: _ } => Absent
  }
}

fn global_bare_policy_candidate(env_module_path: String, candidates: List<v1.compiler.infer_env.GlobalBareCandidate>) -> v1.compiler.infer_env.GlobalBareCandidate? {
  if name_resolution_policy_is_namespace_only() {
    global_bare_unique_chain_candidate(env_module_path: env_module_path, candidates: candidates)
  } else {
    global_bare_nearest_ancestor_candidate(env_module_path: env_module_path, candidates: candidates)
  }
}

fn global_bare_strict_ambiguity_candidates(env: v1.compiler.infer_env.TypeEnv, name: String) -> List<String> {
  if name_resolution_policy_is_namespace_only() == false {
    return []
  }
  match map_get(env.symbol_index.global_bare, name) {
    Present { value: GlobalBareAmbiguousBinding { candidates: cands } } =>
      let chain = global_bare_chain_candidates(env_module_path: env.module_path, candidates: cands)
      ambiguity_labels_from_decide(
        owners: chain |> map(c => c.module_path),
        name: name,
      )
    _ => []
  }
}

// A bodyless type declaration -- `type Opaque<Config>` -- carries nothing but its
// name, so grounding a use of it from another module reaches the name itself and
// re-enters bare lookup, which filters to the REFERENCING module's containment
// chain and therefore misses. Measured: `probe.hollow.Opaque<T>` used from
// probe.user is unresolved, and used from probe.hollow.user -- on the chain --
// resolves; nine corpus rows on v2.std.patch ConfigPatchRecord and four on
// cpp_abi are that one shape, all reported at the DECLARATION rather than at
// the use, which is what made them read as broken declarations.
//
// Grounding descends into DEFINING-module structure, where the binding is that
// module's responsibility rather than the use-site's -- the same reason the mask
// check does not fire there. But silence cannot be unconditional: a qualified
// reference to a type no module declares would then pass. This answers the
// narrower question the census can decide -- does ANY module declare this name --
// so a real declaration grounds and an invented one still refuses.
fn name_is_declared_somewhere(env: v1.compiler.infer_env.TypeEnv, name: String) -> Bool {
  match map_get(env.symbol_index.global_bare, name) {
    Present { value: _ } => true
    Absent => false
  }
}

// A KERNEL type the compiler synthesizes -- Witness's Violates payload -- names
// a type the corpus declares, not a name written at any use site, so the
// containment chain of whatever module happens to be compiling is not the right
// filter for it: `Diagnostic` is declared exactly once corpus-wide, and
// global_bare_lookup refused it from every module outside v2.std.diagnostic's
// own chain. This answers only the unambiguous case -- one declaration, no
// chain test -- and is for synthesis, never for a name a user wrote.
fn globally_unique_declaring_module(env: v1.compiler.infer_env.TypeEnv, name: String) -> String? {
  match map_get(env.symbol_index.global_bare, name) {
    Present { value: GlobalBareUniqueBinding { module_path: mp, binding: _ } } =>
      Present { value: mp }
    _ => none
  }
}

fn bare_name_miss_diagnostic(env: v1.compiler.infer_env.TypeEnv, name: String, span: std.types.SourceSpan) -> v1.std.core.CompilerDiagnostic {
  let cands = global_bare_strict_ambiguity_candidates(env: env, name: name)
  if cands |> count > 0 {
    v1.std.core.AmbiguousReference { name: name, candidates: cands, span: span }
  } else {
    v1.std.core.UnresolvedType { name: name, span: span }
  }
}

fn global_bare_owner_module(env: v1.compiler.infer_env.TypeEnv, owner_module_path: String, name: String) -> String? {
  match map_get(env.symbol_index.global_bare, name) {
    Present { value: GlobalBareUniqueBinding { module_path: mp, binding: b } } =>
      match binding_declares_name(binding: b, name: name, source_indices: env.source_indices) {
        true => Present { value: mp }
        false => Absent
      }
    Present { value: GlobalBareAmbiguousBinding { candidates: cands } } =>
      match global_bare_policy_candidate(env_module_path: owner_module_path, candidates: cands) {
        Present { value: cand } =>
          match binding_declares_name(binding: cand.binding, name: name, source_indices: env.source_indices) {
            true => Present { value: cand.module_path }
            false => Absent
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn binding_declares_name(binding: v1.compiler.infer_env.TypeBinding, name: String, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Bool {
  authored_name_at(source_indices: source_indices, node: binding.resolved) == name
}

fn borrowed_generic_param_names(params: List<v1.std.core.Node>, source_indices: Map<String, v1.std.core.NewlineIndex>) -> Map<String, Bool> {
  fold(params, init: empty_map(), f: (acc, p) =>
    let pt = param_node_type_expr(n: p)
    let pname = param_node_name_at(n: p, source_indices: source_indices)
    let tname = authored_name_at(source_indices: source_indices, node: pt)
    if (pt.children |> count) == 0 && pt.connective == NoConnective && pname != "" && (pname == tname || pname == pt.name) {
      map_insert(acc, pname, true)
    } else { acc }
  )
}

data qualify_declaration_position_invariant: String = "qualify_borrowed_type_names rewrites REFERENCE positions only. Within a type expression, a NoConnective node's children are generic ARGS (references - rename-eligible); a STRUCTURED node's (v1.std.core.Disj/Conj) children are DECLARATIONS (variant names, field names) whose names must never be rewritten - renaming them detaches bare patterns/projections from the decl (a projected coproduct's Independent became std.realization.Independent and every bare match arm missed). Declaration subtrees are walked by qualify_decl_reference_positions: keep the declared name, qualify the inferred payload (a type expr - reference position), recurse into child declarations. The census type-decl pass (census_upgrade_type_decl_binding) uses the SAME walk - one authority for the declaration/reference distinction."

fn qualify_decl_reference_positions(n: v1.std.core.Node, owner_module_path: String, env: v1.compiler.infer_env.TypeEnv, excluded: Map<String, Bool>) -> v1.std.core.Node {
  let inf2 = qualify_borrowed_inferred(inferred: n.inferred, owner_module_path: owner_module_path, env: env, excluded: excluded)
  let ch2 = n.children |> map(c => qualify_decl_reference_positions(n: c, owner_module_path: owner_module_path, env: env, excluded: excluded))
  node_with_children(n: node_with_inferred(n: n, inferred: inf2), children: ch2)
}

fn qualify_borrowed_type_names(n: v1.std.core.Node, owner_module_path: String, env: v1.compiler.infer_env.TypeEnv, excluded: Map<String, Bool>) -> v1.std.core.Node {
  let qualified_children = if (n.connective == NoConnective) {
    n.children |> map(c => qualify_borrowed_type_names(n: c, owner_module_path: owner_module_path, env: env, excluded: excluded))
  } else {
    n.children |> map(c => qualify_decl_reference_positions(n: c, owner_module_path: owner_module_path, env: env, excluded: excluded))
  }
  let name = authored_name_at(source_indices: env.source_indices, node: n)
  let is_type_var = match n.inferred {
    Present { value: v1.std.core.TypeVariable { id: _ } } => true
    _ => false
  }
  let rewrite = n.connective == NoConnective
    && name != ""
    && !contains(name, ".")
    && !is_kernel_type(name: name)
    && !map_has(excluded, name)
    && !is_type_var
  let owner_hit = if rewrite {
    global_bare_owner_module(env: env, owner_module_path: owner_module_path, name: name)
  } else { none }
  match owner_hit {
    Present { value: mp } =>
      if mp == "" {
        node_with_children(n: n, children: qualified_children)
      } else {
        let qname = concat(mp, ".", name)
        v1.std.core.Node {
          name: qname, span: n.span, ident_span: Present { value: v1.std.core.kernel_span(name: qname) },
          children: qualified_children, connective: n.connective, params: n.params,
          inferred: n.inferred, return_cardinality: n.return_cardinality, uses: n.uses,
          body: n.body, transport: n.transport, properties: n.properties,
          type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive,
          has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern,
          expr_data: n.expr_data
        }
      }
    Absent => node_with_children(n: n, children: qualified_children)
  }
}

fn node_with_children(n: v1.std.core.Node, children: List<v1.std.core.Node>) -> v1.std.core.Node {
  v1.std.core.Node {
    name: n.name, ident: n.ident, span: n.span, ident_span: n.ident_span,
    children: children, connective: n.connective, params: n.params,
    inferred: n.inferred, return_cardinality: n.return_cardinality, uses: n.uses,
    body: n.body, transport: n.transport, properties: n.properties,
    type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive,
    has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern,
    expr_data: n.expr_data
  }
}

fn node_with_inferred(n: v1.std.core.Node, inferred: v1.std.core.InferredNode?) -> v1.std.core.Node {
  v1.std.core.Node {
    name: n.name, ident: n.ident, span: n.span, ident_span: n.ident_span,
    children: n.children, connective: n.connective, params: n.params,
    inferred: inferred, return_cardinality: n.return_cardinality, uses: n.uses,
    body: n.body, transport: n.transport, properties: n.properties,
    type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive,
    has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern,
    expr_data: n.expr_data
  }
}

fn qualify_borrowed_inferred(inferred: v1.std.core.InferredNode?, owner_module_path: String, env: v1.compiler.infer_env.TypeEnv, excluded: Map<String, Bool>) -> v1.std.core.InferredNode? {
  match inferred {
    Present { value: v1.std.core.Resolved { node: t } } =>
      Present { value: v1.std.core.Resolved { node: qualify_borrowed_type_names(n: t, owner_module_path: owner_module_path, env: env, excluded: excluded) } }
    _ => inferred
  }
}

fn qualified_all_but_last(name: String) -> String {
  let segs = module_path_segments(path: name)
  let seg_count = segs |> count
  if seg_count <= 1 {
    ""
  } else {
    let scan = fold(segs |> take(seg_count - 1), init: "", f: (acc, seg) =>
      if acc == "" { seg } else { concat(acc, ".", seg) }
    )
    scan
  }
}

fn record_global_bare_ambiguous_silent_pick(
  env_module_path: String,
  name: String,
  cands: List<v1.compiler.infer_env.GlobalBareCandidate>
) -> Unit {
  let cand_count = cands |> count
  match global_bare_nearest_ancestor_candidate(env_module_path: env_module_path, candidates: cands) {
    Present { value: cand } =>
      resolution_silent_pick_record_global_bare_lcp_pick(
        env_module_path: env_module_path,
        name: name,
        candidate_count: cand_count,
        chosen_module_path: cand.module_path
      )
    Absent =>
      resolution_silent_pick_record_global_bare_lcp_tie(
        env_module_path: env_module_path,
        name: name,
        candidate_count: cand_count
      )
  }
}

fn global_bare_lookup(env: v1.compiler.infer_env.TypeEnv, name: String) -> v1.compiler.infer_env.TypeBinding? {
  match map_get(env.symbol_index.global_bare, name) {
    Present { value: GlobalBareUniqueBinding { module_path: mp, binding: binding } } =>
      if name_resolution_policy_is_namespace_only() {
        if global_bare_module_on_chain(env_module_path: env.module_path, cand_module_path: mp) {
          Present { value: binding }
        } else {
          none
        }
      } else {
        Present { value: binding }
      }
    Present { value: GlobalBareAmbiguousBinding { candidates: cands } } => {
      if name_resolution_policy_is_namespace_only() {
        match global_bare_unique_chain_candidate(env_module_path: env.module_path, candidates: cands) {
          Present { value: cand } => Present { value: cand.binding }
          Absent => Absent
        }
      } else {
        if resolution_silent_pick_is_enabled() && (cands |> count) >= 2 {
          record_global_bare_ambiguous_silent_pick(env_module_path: env.module_path, name: name, cands: cands)
        }
        global_bare_nearest_ancestor(env_module_path: env.module_path, candidates: cands)
      }
    }
    Absent => Absent
  }
}

fn global_bare_is_ambiguous(env: v1.compiler.infer_env.TypeEnv, name: String) -> Bool {
  match map_get(env.symbol_index.global_bare, name) {
    Present { value: GlobalBareAmbiguousBinding { candidates: cands } } =>
      if name_resolution_policy_is_namespace_only() {
        let chain = global_bare_chain_candidates(env_module_path: env.module_path, candidates: cands)
        match module_path_owner_binding_decide(owners: chain |> map(c => c.module_path)) {
          ModulePathBindingAmbiguous { owners: _ } => true
          ModulePathBindingHit { owner: _ } => false
          ModulePathBindingMiss => false
        }
      } else {
        global_bare_nearest_ancestor(env_module_path: env.module_path, candidates: cands) == none
      }
    Present { value: GlobalBareUniqueBinding { module_path: _, binding: _ } } => false
    Absent => false
  }
}

fn lookup_binding(env: v1.compiler.infer_env.TypeEnv, ident: Int) -> v1.compiler.infer_env.TypeBinding? {
  match map_get(env.bindings, ident) {
    Present { value: binding } => Present { value: binding }
    Absent =>
      let name = intern_str(table: env.intern_table, id: ident)
      lookup_binding_by_name(env: env, name: name)
  }
}

fn is_recursive_type(env: v1.compiler.infer_env.TypeEnv, ident: Int) -> Bool {
  match map_get(env.recursive_type_set, ident) {
    Present { value: _ } => true
    Absent => false
  }
}

fn is_recursive_type_by_name(env: v1.compiler.infer_env.TypeEnv, name: String) -> Bool {
  match intern_find(table: env.intern_table, s: name) {
    Present { value: id } => is_recursive_type(env: env, ident: id)
    Absent => false
  }
}

fn lookup_type(env: v1.compiler.infer_env.TypeEnv, ident: Int) -> v1.std.core.Node? {
  match lookup_binding(env: env, ident: ident) {
    Present { value: binding } => Present { value: binding.resolved }
    Absent => Absent
  }
}

fn lookup_type_by_name(env: v1.compiler.infer_env.TypeEnv, name: String) -> v1.std.core.Node? {
  match lookup_binding_by_name(env: env, name: name) {
    Present { value: binding } =>
      match contains(name, ".") || binding_declares_name(binding: binding, name: name, source_indices: env.source_indices) {
        true => Present { value: binding.resolved }
        false =>
          match variant_arm_type_projection(env: env, owner: binding.resolved, name: name) {
            Present { value: arm } => Present { value: arm }
            Absent => Present { value: binding.resolved }
          }
      }
    Absent => Absent
  }
}

data type_ref_hit_ne_bind_measure_active_note: String = "Host bracket in v1_rt (type_ref_hit_ne_bind_measure_active / _set / with_type_ref_hit_ne_bind_measure) — same shape as name_resolution_policy_is_namespace_only. Armed only by compile_dag_diagnostic_census for the nested synthetic compile (N1a). Default false = production fail-open. Zero production gates consult this. No .dag body can flip it."

data type_ref_measure_binding_authority_fn_note: String = "MEASUREMENT-ONLY — see gunbc.type_ref_hit_ne_bind_measure type_ref_measure_binding_authority_note. Two arms: bare exact import/local key; qualified self/ancestor containment + symbol_index hit. No same-leaf×span OR-arm."

fn type_ref_module_path_is_containment_prefix(ancestor: String, descendant: String) -> Bool {
  let a_segs = module_path_segments(path: ancestor)
  let d_segs = module_path_segments(path: descendant)
  (a_segs |> count) > 0 && segment_lcp_len(a: a_segs, b: d_segs) == (a_segs |> count)
}

fn type_ref_measure_binding_authority(env: v1.compiler.infer_env.TypeEnv, name: String) -> Bool {
  if map_has(m: env.str_bindings, key: name) || map_has(m: env.ancestry_str_bindings, key: name) {
    true
  } else if contains(name, ".") {
    let prefix = qualified_all_but_last(name: name)
    if type_ref_module_path_is_containment_prefix(ancestor: prefix, descendant: env.module_path) {
      match v1.compiler.infer_env.symbol_index_lookup(index: env.symbol_index, qualified_name: name) {
        Present { value: _ } => true
        Absent => false
      }
    } else {
      false
    }
  } else {
    false
  }
}

fn variant_arm_type_projection(env: v1.compiler.infer_env.TypeEnv, owner: v1.std.core.Node, name: String) -> v1.std.core.Node? {
  match owner.connective {
    v1.std.core.Disj =>
      match find_child_named(n: owner, name: name, source_indices: env.source_indices) {
        Present { value: arm } =>
          match (arm.children |> count) == 0 {
            true => Present { value: arm }
            false => Absent
          }
        Absent => Absent
      }
    _ => Absent
  }
}

fn authored_name(env: v1.compiler.infer_env.TypeEnv, node: v1.std.core.Node) -> String {
  authored_name_at(source_indices: env.source_indices, node: node)
}

fn lookup_type_for(env: v1.compiler.infer_env.TypeEnv, node: v1.std.core.Node) -> v1.std.core.Node? {
  match node.ident {
    Present { value: id } =>
      match lookup_type(env: env, ident: id) {
        Present { value: resolved } =>
          let name = authored_name(env: env, node: node)
          match resolved.connective == v1.std.core.Disj && authored_name_at(source_indices: env.source_indices, node: resolved) != name {
            true =>
              match variant_arm_type_projection(env: env, owner: resolved, name: name) {
                Present { value: arm } => Present { value: arm }
                Absent => Present { value: resolved }
              }
            false => Present { value: resolved }
          }
        Absent => Absent
      }
    Absent => lookup_type_by_name(env: env, name: authored_name(env: env, node: node))
  }
}

fn is_recursive_type_for(env: v1.compiler.infer_env.TypeEnv, node: v1.std.core.Node) -> Bool {
  match node.ident {
    Present { value: id } => is_recursive_type(env: env, ident: id)
    Absent => is_recursive_type_by_name(env: env, name: authored_name(env: env, node: node))
  }
}

fn inductive_fields_for(env: v1.compiler.infer_env.TypeEnv, type_name: String) -> List<std.induction.InductiveField> {
  let local = match map_get(env.inductive_fields, type_name) {
    Present { value: fields } => fields
    Absent => []
  }
  if local |> count > 0 {
    local
  } else {
    fold(env.parents, init: [], f: (acc, parent) =>
      if acc |> count > 0 {
        acc
      } else {
        inductive_fields_for(env: parent, type_name: type_name)
      }
    )
  }
}

fn is_inductive_field(env: v1.compiler.infer_env.TypeEnv, type_name: String, variant_name: String, field_name: String) -> Bool {
  inductive_fields_for(env: env, type_name: type_name)
    |> any(f => f.variant_name == variant_name && f.field_name == field_name)
}

data put_inductive_field_guard_note: String = "M1a base-case guard (PR #6528 review commitment): the merge layer (merge_inductive_fields below) keeps lists duplicate-free by induction, but its base case - the local collection through these two put functions - was OBSERVED duplicate-free, not constructed (a source declaring the same (variant, field, shape, element) fact twice within one module would seed a duplicate the merge then faithfully preserves). The guarded append closes the last hand-concat site of the class: a fact already present by identity is a skip, so duplicate-freedom holds by construction at every layer (DESIGN §5 - construction, not validation). Local lists are per-(module, type) and small, so the linear any-scan per insert is bounded by per-type field count."

fn append_inductive_field_absent(existing: List<std.induction.InductiveField>, incoming: std.induction.InductiveField) -> List<std.induction.InductiveField> {
  if existing |> any(f => inductive_field_key(f: f) == inductive_field_key(f: incoming)) {
    existing
  } else {
    concat(existing, [incoming])
  }
}

fn put_inductive_field(fields: Map<String, List<std.induction.InductiveField>>, type_name: String, variant_name: String, field_name: String, shape: std.induction.RecursionShape) -> Map<String, List<std.induction.InductiveField>> {
  let existing = match map_get(fields, type_name) {
    Present { value: fs } => fs
    Absent => []
  }
  map_insert(fields, type_name, append_inductive_field_absent(existing: existing, incoming: std.induction.InductiveField { type_name: type_name, variant_name: variant_name, field_name: field_name, shape: shape, element_type: type_name }))
}

fn put_inductive_field_cross(fields: Map<String, List<std.induction.InductiveField>>, type_name: String, variant_name: String, field_name: String, shape: std.induction.RecursionShape, element_type: String) -> Map<String, List<std.induction.InductiveField>> {
  let existing = match map_get(fields, type_name) {
    Present { value: fs } => fs
    Absent => []
  }
  map_insert(fields, type_name, append_inductive_field_absent(existing: existing, incoming: std.induction.InductiveField { type_name: type_name, variant_name: variant_name, field_name: field_name, shape: shape, element_type: element_type }))
}

data merge_inductive_fields_dedupe_note: String = "Set-semantics merge (v1-run-stability-throughline M1b + M1b-2, M0 receipt 2026-07-13): a type's inductive fields are a SET of (variant, field, shape, element) facts - multiplicity carries no information. The unguarded concat-on-collision compounded diamond ancestry multiplicatively along the import DAG (measured 409,240,584 retained InductiveField slots corpus-wide, ~3.3 GB of Vec slots alone; worst single module 22.6M entries at ~1,338 types), and even skip-if-equal alone left 95,050,553 slots because differing lists carried baked-in duplicate multiplicities (worst module still 4.1M at ~3k dupes/type). So the merge appends ONLY fields not already present (identity = variant|field|shape|element; type_name is the map key): equal or subset incoming lists SKIP (the sharing fast path - absent keys insert the incoming list Rc directly, never concat-with-empty), and every list is duplicate-free by induction (local collection is duplicate-free; merges never append a present fact). Genuinely new fields still append in the pre-cut encounter order. Same treatment class as guarded_union_str_bindings' skip-if-equal (#6487 cut 2); receipts on the throughline doc."

fn recursion_shape_key(shape: std.induction.RecursionShape) -> String {
  match shape {
    DirectRecursion => "direct"
    ListRecursion => "list"
    OptionalRecursion => "optional"
    SetRecursion => "set"
    MapValueRecursion => "map_value"
  }
}

fn inductive_field_key(f: std.induction.InductiveField) -> String {
  concat(concat(concat(concat(concat(concat(f.variant_name, "|"), f.field_name), "|"), recursion_shape_key(shape: f.shape)), "|"), f.element_type)
}

fn merge_inductive_fields(left: Map<String, List<std.induction.InductiveField>>, right: Map<String, List<std.induction.InductiveField>>) -> Map<String, List<std.induction.InductiveField>> {
  right |> map_keys |> fold(init: left, f: (acc, type_name) =>
    match map_get(right, type_name) {
      Present { value: incoming } =>
        match map_get(acc, type_name) {
          Present { value: existing } =>
            if existing == incoming {
              acc
            } else {
              let seen = existing |> fold(init: empty_set(), f: (s, f) => set_insert(s, inductive_field_key(f: f)))
              let additions = incoming |> filter(f => set_contains(seen, inductive_field_key(f: f)) == false)
              if additions |> count == 0 {
                acc
              } else {
                map_insert(acc, type_name, concat(existing, additions))
              }
            }
          Absent => map_insert(acc, type_name, incoming)
        }
      Absent => acc
    }
  )
}

fn inductive_fields_list_to_map(fields: List<std.induction.InductiveField>) -> Map<String, List<std.induction.InductiveField>> {
  fields |> fold(init: empty_map(), f: (acc, field) =>
    let existing = match map_get(acc, field.type_name) {
      Present { value: fs } => fs
      Absent => []
    }
    map_insert(acc, field.type_name, concat(existing, [field]))
  )
}



fn env_with_type_variable_bindings(env: v1.compiler.infer_env.TypeEnv, tp_names: List<String>) -> v1.compiler.infer_env.TypeEnv {
  fold(tp_names, init: env, f: (e, tp_name) =>
    let tp_binding = TypeBinding {
      name: tp_name,
      resolved: v1.std.core.Node { name: tp_name, span: v1.std.core.kernel_span(name: tp_name), ident_span: Present { value: v1.std.core.kernel_span(name: tp_name) }, children: [], connective: NoConnective, params: [], inferred: Present { value: v1.std.core.TypeVariable { id: tp_name } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData },
      provenance: SubValueUnknown
    }
    TypeEnv { module_path: e.module_path,
      bindings: map_insert(e.bindings, intern(table: e.intern_table, s: tp_name).id, tp_binding),
      str_bindings: map_insert(e.str_bindings, tp_name, tp_binding),
      ancestry_str_bindings: e.ancestry_str_bindings,
      parents: e.parents,
      recursive_types: e.recursive_types,
      recursive_type_set: e.recursive_type_set,
      inductive_fields: e.inductive_fields,
      source_indices: e.source_indices,
      intern_table: e.intern_table,
      source_visible_names: map_insert(e.source_visible_names, tp_name, true),
      symbol_index: e.symbol_index
    }
  )
}
