module v1.compiler.infer_env

import v1.std.core { Node, NewlineIndex, InternTable, empty_intern_table, merge_intern_tables, intern, intern_find, intern_str, source_text_at, authored_name_at }
import std.induction { InductiveField, RecursionShape, DirectRecursion, ListRecursion, OptionalRecursion, SubValueRelation, SubValueUnknown, PreservedValue }

type TypeEnv {
  bindings: Map<Int, TypeBinding>
  str_bindings: Map<String, TypeBinding>
  ancestry_str_bindings: Map<String, TypeBinding>
  parents: List<TypeEnv>
  recursive_types: List<Int>
  recursive_type_set: Map<Int, Bool>
  inductive_fields: Map<String, List<InductiveField>>
  source_indices: Map<String, NewlineIndex>
  intern_table: InternTable
}

type TypeBinding {
  name: String
  resolved: Node
  provenance: SubValueRelation
}

type ImportBinding {
  name: String
  resolved: Node
}

type ScopeBinding {
  name: String
  resolved: Node
  provenance: SubValueRelation
}

type SymbolIndex {
  entries: Map<String, Node>
}

type Scope {
  locals: Map<String, ScopeBinding>
}

fn empty_symbol_index() -> SymbolIndex {
  SymbolIndex { entries: empty_map() }
}

fn symbol_index_lookup(index: SymbolIndex, qualified_name: String) -> Node? {
  map_get(index.entries, qualified_name)
}

fn symbol_index_insert(index: SymbolIndex, qualified_name: String, resolved: Node) -> SymbolIndex {
  SymbolIndex { entries: map_insert(index.entries, qualified_name, resolved) }
}

fn empty_scope() -> Scope {
  Scope { locals: empty_map() }
}

fn scope_lookup(scope: Scope, name: String) -> ScopeBinding? {
  map_get(scope.locals, name)
}

fn scope_push(scope: Scope, binding: ScopeBinding) -> Scope {
  Scope { locals: map_insert(scope.locals, binding.name, binding) }
}

fn qualified_symbol_name(module_path: String, item_name: String) -> String {
  concat(module_path, ".", item_name)
}

data symbol_index_fill_once_dissolution_trigger: String = "🟡 dissolve-on: build_symbol_index prepass replaces per-module ancestry_str_bindings materialization in build_type_env — consumer wiring lands after scaling receipt (type-env-single-authority-design.md §5–§6)."

data ancestry_cache_sharing_dissolution_trigger: String = "🟡 dissolve-on: single-parent ancestry_str_bindings borrows parent.type_env_cache.str_bindings (Rc-shared visible surface) instead of map_merge(parent.ancestry_str_bindings, parent.str_bindings) per module — kills O(M²) SipHash/map_merge churn on import chains; full SymbolIndex authority is the follow-on (type-env-single-authority-design.md)."

data symbol_index_single_authority_dissolution_trigger: String = "🟡 dissolve-on: SymbolIndex + Scope replace TypeEnv.ancestry_str_bindings materialization — see docs/plans/type-env-single-authority-design.md §4–§5; gated on import-chain sub-quadratic scaling receipt (reference_carrier_witness_test) + whole-corpus compile-clean wall-clock baseline."

type TypeEnvCache {
  deps_map: Map<String, List<String>>
  str_bindings: Map<String, TypeBinding>
  cycle_set_str: Map<String, Bool>
  variant_locals: Map<String, TypeBinding>
}

data type_env_compositional_authority_dissolution_trigger: String = "🟡 dissolve-on: compositional TypeEnv.parents + ancestry_str_bindings rewire passes in stage0 — ground in v2 std.type_env when PerformanceReceipt subsumes type_env_work_count_profiling_dissolution_trigger."
data type_env_profiling_dissolution_trigger: String = "🟡 dissolve-on: host atomic profiling until PerformanceReceipt carrier lands (realization-measurement-loop Phase 0)."
data type_env_work_count_profiling_dissolution_trigger: String = "🟡 dissolve-on: build_type_env + merge_type_env_cache + rewire pass counters — fold into PerformanceReceipt at realization-measurement-loop Phase 0."
data type_env_cache_parallel_repr_dissolution_trigger: String = "🟡 dissolve-on: TypeEnvCache String-keyed str_bindings and cycle_set_str parallel to TypeEnv Int-keyed bindings and recursive_type_set — fold into single authority at v2 regen."
data type_env_cache_key_determinism_authority: String = "Cache-key determinism for resolved_graph disk tier: resolved_graph_cache::encode_cache_payload applies sort_json_value at serialization boundary (not merge_type_env_cache / build_type_env hot paths). B2 de-fork: Rust seed must match this .dag plain map_merge authority."
data flatten_visible_bindings_invariant: String = "B1 build_type_env populates ancestry_str_bindings for import chains; lookup_binding_by_name is fail-closed on miss (str_bindings then ancestry_str_bindings then intern+bindings only — no flatten_visible_bindings fallback; 6de571f3 reverted in 80ab63a). flatten_visible_bindings: parent fold map_merge(flatten(parent), acc) — earlier env.parents win over later on collision; local map_merge(ancestry_str_bindings, str_bindings) then map_merge(from_parents, local) — str_bindings wins ancestry, local wins parents. Parent-recurse counter is stub-only on import chains (witness flatten_visible_parent_recurses==0); merge_envs still calls flatten for one-shot env merge."

fn empty_type_env_cache() -> TypeEnvCache {
  TypeEnvCache {
    deps_map: empty_map(),
    str_bindings: empty_map(),
    cycle_set_str: empty_map(),
    variant_locals: empty_map()
  }
}

fn build_type_env_calls() -> Int { 0 }
fn merge_type_env_cache_calls() -> Int { 0 }
fn rewire_type_env_parent_links_calls() -> Int { 0 }
fn rewire_type_env_import_str_binding_calls() -> Int { 0 }
data type_env_counter_dissolution: String = "The 2026-07-04 use-site inference pathology instrument (env-amplification counters) dissolves with the pathology it measured: the record_* statement calls and their stub fns are deleted (they were also the only corpus instances of a statement-then-expression block the Rust emitter mis-renders — that emitter deficiency is ledgered with the emit-stage work). The Int getter stubs below stay for API compatibility with the hand-maintained phase_profile heartbeat until that consumer drops them."

fn merge_type_env_cache(base: TypeEnvCache, overlay: TypeEnvCache) -> TypeEnvCache {
  TypeEnvCache {
    deps_map: map_merge(base.deps_map, overlay.deps_map),
    str_bindings: map_merge(base.str_bindings, overlay.str_bindings),
    cycle_set_str: map_merge(base.cycle_set_str, overlay.cycle_set_str),
    variant_locals: map_merge(base.variant_locals, overlay.variant_locals)
  }
}

fn lookup_binding_local_by_name(env: TypeEnv, name: String) -> TypeBinding? {
  match intern_find(table: env.intern_table, s: name) {
    Present { value: ident } =>
      match map_get(env.bindings, ident) {
        Present { value: binding } => Present { value: binding }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn str_bindings_from_bindings(bindings: Map<Int, TypeBinding>) -> Map<String, TypeBinding> {
  fold(bindings |> map_values, init: empty_map(), f: (acc, binding) =>
    map_insert(acc, binding.name, binding)
  )
}

fn lookup_binding_by_name(env: TypeEnv, name: String) -> TypeBinding? {
  match map_get(env.str_bindings, name) {
    Present { value: binding } => Present { value: binding }
    Absent =>
      match map_get(env.ancestry_str_bindings, name) {
        Present { value: binding } => Present { value: binding }
        Absent =>
          match intern_find(table: env.intern_table, s: name) {
            Present { value: id } => map_get(env.bindings, id)
            Absent => Absent
          }
      }
  }
}

fn lookup_binding(env: TypeEnv, ident: Int) -> TypeBinding? {
  match map_get(env.bindings, ident) {
    Present { value: binding } => Present { value: binding }
    Absent =>
      let name = intern_str(table: env.intern_table, id: ident)
      lookup_binding_by_name(env: env, name: name)
  }
}

fn is_recursive_type(env: TypeEnv, ident: Int) -> Bool {
  match map_get(env.recursive_type_set, ident) {
    Present { value: _ } => true
    Absent => false
  }
}

fn is_recursive_type_by_name(env: TypeEnv, name: String) -> Bool {
  match intern_find(table: env.intern_table, s: name) {
    Present { value: id } => is_recursive_type(env: env, ident: id)
    Absent => false
  }
}

fn lookup_type(env: TypeEnv, ident: Int) -> Node? {
  match lookup_binding(env: env, ident: ident) {
    Present { value: binding } => Present { value: binding.resolved }
    Absent => Absent
  }
}

fn lookup_type_by_name(env: TypeEnv, name: String) -> Node? {
  match lookup_binding_by_name(env: env, name: name) {
    Present { value: binding } => Present { value: binding.resolved }
    Absent => Absent
  }
}

fn authored_name(env: TypeEnv, node: Node) -> String {
  authored_name_at(source_indices: env.source_indices, node: node)
}

fn lookup_type_for(env: TypeEnv, node: Node) -> Node? {
  match node.ident {
    Present { value: id } => lookup_type(env: env, ident: id)
    Absent => lookup_type_by_name(env: env, name: authored_name(env: env, node: node))
  }
}

fn is_recursive_type_for(env: TypeEnv, node: Node) -> Bool {
  match node.ident {
    Present { value: id } => is_recursive_type(env: env, ident: id)
    Absent => is_recursive_type_by_name(env: env, name: authored_name(env: env, node: node))
  }
}

fn inductive_fields_for(env: TypeEnv, type_name: String) -> List<InductiveField> {
  let local = match map_get(env.inductive_fields, type_name) {
    Present { value: fields } => fields
    Absent => []
  }
  if local |> count > 0 {
    local
  } else {
    fold(env.parents, init: [], f: (acc, parent) =>
      if acc |> count > 0 {
        acc
      } else {
        inductive_fields_for(env: parent, type_name: type_name)
      }
    )
  }
}

fn is_inductive_field(env: TypeEnv, type_name: String, variant_name: String, field_name: String) -> Bool {
  inductive_fields_for(env: env, type_name: type_name)
    |> any(f => f.variant_name == variant_name && f.field_name == field_name)
}

fn put_inductive_field(fields: Map<String, List<InductiveField>>, type_name: String, variant_name: String, field_name: String, shape: RecursionShape) -> Map<String, List<InductiveField>> {
  let existing = match map_get(fields, type_name) {
    Present { value: fs } => fs
    Absent => []
  }
  map_insert(fields, type_name, concat(existing, [InductiveField { type_name: type_name, variant_name: variant_name, field_name: field_name, shape: shape, element_type: type_name }]))
}

fn put_inductive_field_cross(fields: Map<String, List<InductiveField>>, type_name: String, variant_name: String, field_name: String, shape: RecursionShape, element_type: String) -> Map<String, List<InductiveField>> {
  let existing = match map_get(fields, type_name) {
    Present { value: fs } => fs
    Absent => []
  }
  map_insert(fields, type_name, concat(existing, [InductiveField { type_name: type_name, variant_name: variant_name, field_name: field_name, shape: shape, element_type: element_type }]))
}

fn merge_inductive_fields(left: Map<String, List<InductiveField>>, right: Map<String, List<InductiveField>>) -> Map<String, List<InductiveField>> {
  right |> map_keys |> fold(init: left, f: (acc, type_name) =>
    match map_get(right, type_name) {
      Present { value: incoming } =>
        let existing = match map_get(acc, type_name) {
          Present { value: fs } => fs
          Absent => []
        }
        map_insert(acc, type_name, concat(existing, incoming))
      Absent => acc
    }
  )
}

fn inductive_fields_list_to_map(fields: List<InductiveField>) -> Map<String, List<InductiveField>> {
  fields |> fold(init: empty_map(), f: (acc, field) =>
    let existing = match map_get(acc, field.type_name) {
      Present { value: fs } => fs
      Absent => []
    }
    map_insert(acc, field.type_name, concat(existing, [field]))
  )
}

fn flatten_visible_parent_recurses() -> Int { 0 }
fn reset_flatten_visible_profile() -> Unit { }
fn reset_type_env_lookup_profile() -> Unit { reset_flatten_visible_profile() }
fn maybe_print_type_env_lookup_profile() -> Unit { }

fn flatten_visible_bindings(env: TypeEnv) -> Map<String, TypeBinding> {
  let from_parents = fold(env.parents, init: empty_map(), f: (acc, parent) =>
    map_merge(flatten_visible_bindings(env: parent), acc)
  )
  let local_by_name = map_merge(env.ancestry_str_bindings, env.str_bindings)
  map_merge(from_parents, local_by_name)
}

fn merge_envs(envs: List<TypeEnv>) -> TypeEnv {
  let merged_bindings = fold(envs, init: empty_map(), f: (acc, env) =>
    map_merge(acc, flatten_visible_bindings(env: env))
  )
  let merged_recursive = fold(envs, init: [], f: (acc, env) => concat(acc, env.recursive_types))
  let merged_recursive_set = fold(envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.recursive_type_set))
  let merged_inductive_fields = fold(envs, init: empty_map(), f: (acc, env) => merge_inductive_fields(left: acc, right: env.inductive_fields))
  let merged_source_indices = fold(envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.source_indices))
  let merged_intern_table = match envs |> first {
    Present { value: first_env } => first_env.intern_table
    Absent => empty_intern_table()
  }
  let merged_bindings_by_ident = fold(merged_bindings |> map_values, init: empty_map(), f: (acc, binding) =>
    map_insert(acc, intern(table: merged_intern_table, s: binding.name).id, binding)
  )
  TypeEnv { bindings: merged_bindings_by_ident, str_bindings: merged_bindings, ancestry_str_bindings: empty_map(), parents: [], recursive_types: merged_recursive, recursive_type_set: merged_recursive_set, inductive_fields: merged_inductive_fields, source_indices: merged_source_indices, intern_table: merged_intern_table }
}
