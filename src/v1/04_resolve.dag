// KIND INHABITANCE AT AN APPLIED TYPE ARGUMENT -- the wall that makes a kinded parameter position
// mean something. It sits beside the arity check in resolve_node_bounded's generic-use-site branch
// because that is the ONE place an applied user generic is judged, so every occurrence is reached
// rather than only the field-access route alias_chain_arity_diagnostics covers.
//
// THE ADMITTING ARMS, AND THE HONEST CEILING OF EACH; the arms themselves are read from
// type_arg_kind_inhabitance below rather than counted here, because a count in prose rots the first
// time an arm is added. TWO of them are admitted WITHOUT consulting the kind at all. A type variable
// or an in-scope generic parameter is admitted and judged at INSTANTIATION instead -- this position
// cannot know the argument yet, and refusing it would refuse every generic function over a kinded
// parameter. A NAT LITERAL is admitted UNCONDITIONALLY, before the kind declaration is looked up, so
// no variant, field count or kind identity is ever consulted for it. Everything else is judged
// against the KIND ITSELF: the kind's declared alias target and its declared children are the roster
// of admissible named inhabitants, matched by identity rather than by shape.
//
// THE LITERAL ARM IS THE WEAK ONE AND IS STATED RATHER THAN DRESSED UP, AND AN EARLIER REVISION OF
// THIS PARAGRAPH OVERSTATED IT (review 69986, BLOCKING). It said the literal was admitted only where
// the kind declares a one-field variant, and priced the residual risk on that reading. The code does
// no such thing and never did at this head: `expr_literal_int_optional(expr: arg) != none` admits any
// integer literal in any kinded position. Literal admissibility is a LANGUAGE-LEVEL rule here rather
// than a per-kind fact, the frontier is declared at std.machine_constraints
// machine_width_literal_roster_frontier, and the same weaker account is written on
// type_arg_kind_inhabitance itself. RUNG HONESTY (DESIGN 4b(1)): a class's rung is the minimum across
// its paths, so this position's rung is set by the LITERAL axis and not by the named one, and an
// annotation crediting the arm with a per-kind judgment it does not perform is rung inflation in
// prose -- in a change whose whole subject is refusing exactly that.
fn type_param_kind_diagnostics(carrier: Node, decl: Node, type_name: String, env: TypeEnv, module_name: String) -> List<ErrorNode> {
  decl.params |> enumerate |> flat_map(pair =>
    match find_property(props: pair.second.properties, prop_name: type_param_kind_property_name(), source_indices: env.source_indices) {
      Absent => []
      Present { value: kind_node } =>
        match carrier.children |> skip(pair.first) |> first {
          Absent => []
          Present { value: arg } =>
            let kind_name = authored_name(env: env, node: kind_node)
            let param_name = authored_name_at(source_indices: env.source_indices, node: pair.second)
            match type_arg_kind_inhabitance(arg: arg, kind_node: kind_node, env: env, module_name: module_name) {
              KindInhabited => []
              KindNotInhabited =>
                [make_error_node(
                  diagnostic: TypeArgumentKindMismatch {
                    type_name: type_name, param_name: param_name, kind_name: kind_name,
                    supplied: concat(type_arg_display_spelling(n: arg, env: env), " [", kind_lookup_trace(kind_decl: kind_decl_for_message(kind_node: kind_node, env: env), env: env), "]", raven_probe_wall_dump(arg: arg, env: env, module_name: module_name)), span: arg.span
                  },
                  module_name: module_name
                )]
              KindDeclarationUnresolved =>
                [make_error_node(
                  diagnostic: TypeArgumentKindMismatch {
                    type_name: type_name, param_name: param_name, kind_name: kind_name,
                    supplied: concat("(kind declaration '", kind_name, "' did not resolve, so inhabitance could not be established)"),
                    span: arg.span
                  },
                  module_name: module_name
                )]
              FwdParameterUnidentified =>
                [make_error_node(
                  diagnostic: ForwardedParameterUnidentified {
                    type_name: type_name, param_name: param_name, kind_name: kind_name,
                    supplied: concat("(forwarded argument '", type_arg_display_spelling(n: arg, env: env), "' carries no type-parameter declaration, so its kind is unknown and nothing is admitted)"),
                    span: arg.span
                  },
                  module_name: module_name
                )]
              FwdParameterOwnerUnresolved =>
                [make_error_node(
                  diagnostic: ForwardedParameterOwnerUnresolved {
                    type_name: type_name, param_name: param_name, kind_name: kind_name,
                    supplied: concat("(the declaration said to own the forwarded parameter '", type_arg_display_spelling(n: arg, env: env), "' did not resolve to one declaring module, so its kind could not be read)", raven_probe_kind_link(arg: arg, slot_kind_node: kind_node, env: env, module_name: module_name)),
                    span: arg.span
                  },
                  module_name: module_name
                )]
              FwdParameterNotDeclaredByOwner =>
                [make_error_node(
                  diagnostic: ForwardedParameterNotDeclaredByOwner {
                    type_name: type_name, param_name: param_name, kind_name: kind_name,
                    supplied: concat("('", type_arg_display_spelling(n: arg, env: env), "' is not a parameter of the declaration its binder names, so no kind was declared for it)", raven_probe_kind_link(arg: arg, slot_kind_node: kind_node, env: env, module_name: module_name)),
                    span: arg.span
                  },
                  module_name: module_name
                )]
              FwdParameterUnkinded =>
                [make_error_node(
                  diagnostic: ForwardedParameterUnkinded {
                    type_name: type_name, param_name: param_name, kind_name: kind_name,
                    supplied: concat("(the forwarded parameter '", type_arg_display_spelling(n: arg, env: env), "' declares no kind, so it cannot be shown to inhabit '", kind_name, "')", raven_probe_wall_dump(arg: arg, env: env, module_name: module_name)),
                    span: arg.span
                  },
                  module_name: module_name
                )]
              FwdParameterKindUnresolved =>
                [make_error_node(
                  diagnostic: ForwardedParameterKindUnresolved {
                    type_name: type_name, param_name: param_name, kind_name: kind_name,
                    supplied: concat("(a kind on the forwarded parameter '", type_arg_display_spelling(n: arg, env: env), "' did not resolve to a single declaring position, so the two kinds could not be compared)", raven_probe_kind_link(arg: arg, slot_kind_node: kind_node, env: env, module_name: module_name)),
                    span: arg.span
                  },
                  module_name: module_name
                )]
              FwdParameterKindDiffers =>
                [make_error_node(
                  diagnostic: ForwardedParameterKindDiffers {
                    type_name: type_name, param_name: param_name, kind_name: kind_name,
                    supplied: concat("(the forwarded parameter '", type_arg_display_spelling(n: arg, env: env), "' declares its own kind, and that kind resolves to a different declaration than the slot's '", kind_name, "')", raven_probe_kind_link(arg: arg, slot_kind_node: kind_node, env: env, module_name: module_name)),
                    span: arg.span
                  },
                  module_name: module_name
                )]
            }
        }
    }
  )
}

fn type_arg_display_spelling(n: Node, env: TypeEnv) -> String {
  match expr_literal_int_optional(expr: n) {
    Present { value: v } => to_string(value: v)
    Absent => authored_name(env: env, node: n)
  }
}

// THREE ANSWERS, NOT TWO, AND THE THIRD IS WHY THIS IS A COPRODUCT. The first version returned Bool
// with `Absent => true` when the kind declaration did not resolve -- an absorbing fallback that
// ADMITTED EVERYTHING exactly where it could establish nothing, which is the failure arm DESIGN
// section 5 forbids by name. A Bool cannot tell "this argument inhabits the kind" apart from "I
// could not look the kind up", so both answered true and the fail-open had somewhere to hide.
type KindInhabitance
  = KindInhabited
  | KindNotInhabited
  | KindDeclarationUnresolved
  // A forwarded parameter is JUDGED, never deferred: each unknown answers with its own cause, and
  // none of them admits. See forwarded_parameter_kind_matches for why an unjudged forward is the
  // widen this replaces.
  | FwdParameterUnidentified
  | FwdParameterOwnerUnresolved
  | FwdParameterNotDeclaredByOwner
  | FwdParameterUnkinded
  | FwdParameterKindUnresolved
  | FwdParameterKindDiffers

// WHAT THIS CHECKS, AND WHAT IT DELIBERATELY DOES NOT. The NAMED half is identity-keyed against the
// kind's declared alias target, so a kind naming PointerWidth cannot be satisfied by an unrelated
// declaration of the same shape -- that is the difference from the variant-shape proxy this
// replaced, which admitted any argument so long as the kind happened to own a one-field variant and
// never consulted the kind's identity at all.
//
// A NAT LITERAL IS ADMITTED IN ANY KINDED POSITION, and that is a LANGUAGE-LEVEL rule rather than a
// per-kind fact. Stated rather than hidden: this wall does not ground the literal half. It is NOT a
// regression -- before this change the check did not fire at all, so a literal was admitted in every
// kinded position already and still is. The per-kind literal roster is a declared frontier; every
// carrier available today fails to express it, enumerated at std.machine_constraints.
// RUNG HONESTY: a class's rung is the minimum across its paths, so this position's rung is set by
// the LITERAL axis, not by the named one. The position is NOT fully grounded and must not be cited
// as such.
fn type_arg_kind_inhabitance(arg: Node, kind_node: Node, env: TypeEnv, module_name: String) -> KindInhabitance {
  let arg_is_type_var = match arg.inferred {
    Present { value: inf } => is_type_variable(inferred: inf)
    Absent => false
  }
  // ARM 1, CARRIER-FIRST. Two steps, and the ORDER of the two tests is the whole finding. A type
  // variable used to be admitted here on being a type variable, which let a parameter declared
  // Quantity satisfy a Scale slot; it is now judged on the kind its own declaration gives it. And the
  // test that ROUTES here asks what the node CARRIES before it asks what its INFERENCE says, because
  // measured on the real corpus the forwarded parameters arrive with `inferred=absent` -- all four
  // refusals fell through to the inhabitants arm and were refused as spellings ("'S [decl='Scale'
  // inferred=absent resolved_target='' children=23]' is not one of its inhabitants"), which is the
  // name-keyed reading this arm exists to replace. The carrier is the fact; inference is a hint.
  // A variable that carries nothing answers FwdParameterUnidentified: being an inference unknown
  // is not evidence of inhabiting anything, and this arm admits nobody.
  if node_is_type_parameter_reference(n: arg) { forwarded_parameter_kind_matches(arg: arg, slot_kind_node: kind_node, env: env, module_name: module_name) }
  else if arg_is_type_var { FwdParameterUnidentified }
  else if expr_literal_int_optional(expr: arg) != none { KindInhabited }
  else {
    match lookup_type_by_name(env: env, name: authored_name(env: env, node: kind_node)) {
      Absent => KindDeclarationUnresolved
      Present { value: kind_decl } =>
        let arg_name = authored_name(env: env, node: arg)
        if kind_decl.children |> any(c => node_authored_or_own_name(n: c, env: env) == arg_name) { KindInhabited }
        else if kind_names_admissible_inhabitant(kind_decl: kind_decl, arg_name: arg_name, env: env) { KindInhabited }
        else if kind_inhabitant_matches_resolved(kind_node: kind_node, arg: arg, env: env, module_name: module_name) { KindInhabited }
        // THE NAME-KEYED ADMIT IS GONE. This arm used to answer KindInhabited for any bare name that
        // resolved to a type-variable binder, judging nothing; a forwarded parameter now arrives on
        // arm 1 carrying the authority's binder and is judged there. Re-adding an admit here would
        // resurrect the widen.
        else { KindNotInhabited }
    }
  }
}

// The kind's alias target IS the roster of admissible named inhabitants. CEILING, STATED: an alias
// carries exactly one target, so exactly one named inhabitant is expressible, and the comparison is
// NOMINAL against that target rather than a resolved-node identity. Both are narrower than the truth
// and narrow in the REFUSING direction, which is the correct direction for a wall to be wrong in.
fn kind_names_admissible_inhabitant(kind_decl: Node, arg_name: String, env: TypeEnv) -> Bool {
  kind_admissible_inhabitant_name(kind_decl: kind_decl, env: env) == arg_name
}

// RESOLVE BOTH SIDES AND COMPARE, because the kind declaration does NOT carry its target where this
// check can read it. MEASURED, by a trace this refusal printed on the real corpus:
//   'PointerWidth [decl=WidthResolution inferred=absent resolved_target= children=0]'
// A single-arm `type WidthResolution = PointerWidth` is parsed as a TYPE ALIAS, so the declaration
// reaching this site is a bare nominal node -- no inferred target, no children. Reading
// kind_decl.inferred therefore answers nothing, which is why the wall refused its own declared
// inhabitant and the positive control failed. Three separate readings of local_binding_for_item and
// lookup_type_by_name predicted otherwise; the trace is what settled it.
// So both sides go through the module's own resolution, symmetrically, and are compared on the
// resolved identity rather than on a field one side happens not to carry.
fn kind_inhabitant_matches_resolved(kind_node: Node, arg: Node, env: TypeEnv, module_name: String) -> Bool {
  let resolved_kind = resolve_node_bounded(n: kind_node, env: env, module_name: module_name, depth: 0, masked: false).resolved
  let resolved_arg = resolve_node_bounded(n: arg, env: env, module_name: module_name, depth: 0, masked: false).resolved
  let kind_name = node_authored_or_own_name(n: resolved_kind, env: env)
  let arg_name = node_authored_or_own_name(n: resolved_arg, env: env)
  kind_name != "" && kind_name == arg_name
}

// AUTHORED NAME, ELSE THE NODE'S OWN NAME. authored_name reads the SOURCE TEXT at a node's
// ident_span and answers "" for a synthetic or span-less node, which is what the alias target of a
// resolved kind declaration is -- so comparing authored names alone refused the kind's OWN declared
// inhabitant and made the wall refuse everything, positive control included. This is the corpus's
// existing idiom for the same problem (v1.compiler.emit_rust type_leaf_name_for_collapse), not a new
// one. Applied to BOTH sides so the comparison cannot be lopsided.
fn kind_admissible_inhabitant_name(kind_decl: Node, env: TypeEnv) -> String {
  match kind_decl.inferred {
    Present { value: Resolved { node: target } } => node_authored_or_own_name(n: target, env: env)
    _ => ""
  }
}

// A DIAGNOSTIC THAT NAMES WHAT IT LOOKED AT. The refusal reported an empty declared inhabitant and
// could not say WHY -- whether the kind declaration carried no resolved target, or carried one whose
// name read empty. Those have different repairs, so the message carries both facts rather than
// costing another build cycle to distinguish them.
fn kind_lookup_trace(kind_decl: Node, env: TypeEnv) -> String {
  concat(
    "decl='", node_authored_or_own_name(n: kind_decl, env: env),
    "' inferred=", match kind_decl.inferred { Present { value: _ } => "present"  Absent => "absent" },
    " resolved_target='", kind_admissible_inhabitant_name(kind_decl: kind_decl, env: env),
    "' children=", to_string(value: kind_decl.children |> count)
  )
}

// PROBE ONLY (scratch branch agent/v1-param-binder-probe; never merged, named so it can be re-run).
// Appends the ARGUMENT-SIDE facts the refusal does not otherwise carry, so the two surviving
// populations can be told apart without minting any new diagnostic: (a) a node the marking pass
// never visited is an untouched authored leaf -- children=0, params=0, decl=none; (b) a node whose
// carrier was dropped by a rebuild carries the substituted body -- children>0, inferred=present.
// A stamped control (the 20 realization_measurement refusals) reads decl=paramref. The fields ride
// the EXISTING refusal message: no new diagnostic exists, so no module's abandonment changes.
fn raven_probe_wall_dump(arg: Node, env: TypeEnv, module_name: String) -> String {
  let occ_text = match arg.occurrence_identity {
    OccurrenceMinted { id: _ } => "m"
    OccurrenceProjected { id: _, caused_by: _ } => "p"
    OccurrencePending { caused_by: _ } => "x"
    _ => "s"
  }
  let inferred_text = match arg.inferred { Present { value: _ } => "p"  Absent => "a" }
  let decl_text = match arg.declaration {
    Absent => "n"
    Present { value: r } => if declaration_ref_is_type_parameter(ref: r) { "t" } else { "o" }
  }
  concat(
    "|P o=", occ_text,
    " c=", to_string(value: arg.children |> count),
    " p=", to_string(value: arg.params |> count),
    " i=", inferred_text,
    " d=", decl_text,
    " s=", to_string(value: arg.span.start), "-", to_string(value: arg.span.end)
  )
}

// PRINT-ONLY (probe branch; msg_86fef5fe asks for the earliest link per row): re-runs the JUDGMENT'S
// OWN lookups -- the same functions, not a parallel implementation -- and reports which one came back
// empty, with the exact qualified name each side tried. Message-side only: it mints nothing and
// cannot change a verdict (the verdict is the KindInhabitance the judgment already returned).
// bk= / sk= also print whether the SAME kind terminal resolves under std.measure, which is the only
// module that declares Scale and Quantity: bk=n with measureHit=y is the named-import not followed.
fn raven_probe_kind_link(arg: Node, slot_kind_node: Node, env: TypeEnv, module_name: String) -> String {
  match arg.declaration {
    Absent => "|K d=n"
    Present { value: carrier } =>
      if !declaration_ref_is_type_parameter(ref: carrier) { "|K d=x" }
      else {
        match decl_type_parameter_name(ref: carrier) {
          Absent => "|K pn=n"
          Present { value: parameter_name } =>
            let owner_qualified = concat(carrier.module_path as String, ".", carrier.decl_name as String)
            match symbol_index_lookup(index: env.symbol_index, qualified_name: owner_qualified) {
              Absent => concat("|K own=n tried=", owner_qualified)
              Present { value: owner_decl } =>
                match map_get(env.symbol_index.file_modules, owner_decl.span.file) {
                  Absent => "|K fmod=n"
                  Present { value: owner_module } =>
                    if owner_module != (carrier.module_path as String) { "|K own!=mod" }
                    else {
                      match owner_decl.params |> filter(param =>
                          authored_name_at(source_indices: env.source_indices, node: param) == parameter_name) |> first {
                        Absent => "|K par=n"
                        Present { value: binder } =>
                          match find_property(props: binder.properties, prop_name: type_param_kind_property_name(), source_indices: env.source_indices) {
                            Absent => "|K pk=n"
                            Present { value: binder_kind_node } =>
                              let binder_kind_name = concat(owner_module, ".", authored_name(env: env, node: binder_kind_node))
                              let slot_kind_name = concat(module_name, ".", authored_name(env: env, node: slot_kind_node))
                              match kind_declaring_position(kind_node: binder_kind_node, env: env) {
                                Absent => concat(concat(concat(concat("|K bk=n binderKind=", binder_kind_name), " slotKind="), slot_kind_name), measure_hit_text(kind_node: binder_kind_node, env: env))
                                Present { value: binder_kind_decl } =>
                                  match kind_declaring_position(kind_node: slot_kind_node, env: env) {
                                    Absent => concat(concat(concat(concat("|K sk=n binderKind=", binder_kind_name), " slotKind="), slot_kind_name), measure_hit_text(kind_node: slot_kind_node, env: env))
                                    Present { value: slot_kind_decl } =>
                                      if slot_kind_decl.span.file == binder_kind_decl.span.file
                                        && slot_kind_decl.span.start == binder_kind_decl.span.start
                                        && slot_kind_decl.span.end == binder_kind_decl.span.end {
                                        concat("|K cmp=same binderKind=", binder_kind_name)
                                      } else {
                                        concat(concat(concat(concat("|K cmp=diff binderKind=", binder_kind_name), " slotKind="), slot_kind_name), concat(concat("|K binderFile=", binder_kind_decl.span.file), concat(" slotFile=", slot_kind_decl.span.file)))
                                      }
                                  }
                              }
                          }
                      }
                    }
                }
            }
        }
      }
  }
}

// PROBE ONLY (scratch branch, never merged): does a std.measure-qualified query of this kind NAME
// find a declaration? A 'yes' beside a failed authored-scope lookup says the name IS std.measure's,
// reached only through the import chain. Deliberately the raw composed-name query the shipped
// resolver no longer performs -- it asks 'would the OLD lookup have hit', which the kernel route
// cannot answer.
fn measure_hit_text(kind_node: Node, env: TypeEnv) -> String {
  let qualified = concat("std.measure.", authored_name(env: env, node: kind_node))
  match symbol_index_lookup(index: env.symbol_index, qualified_name: qualified) {
    Present { value: _ } => " measureHit=y"
    Absent => " measureHit=n"
  }
}

// The refusal names what it COMPARED AGAINST, not just what was supplied. A wall that says only
// "X is not an inhabitant" makes its own misbehaviour unreadable -- this one refused its own declared
// inhabitant and the message could not distinguish that from a correct refusal.
fn kind_decl_for_message(kind_node: Node, env: TypeEnv) -> Node {
  match lookup_type_by_name(env: env, name: authored_name(env: env, node: kind_node)) {
    Present { value: d } => d
    Absent => kind_node
  }
}

fn node_authored_or_own_name(n: Node, env: TypeEnv) -> String {
  let a = authored_name(env: env, node: n)
  if a == "" { n.name } else { a }
}

// A FORWARDED PARAMETER IS JUDGED ON THE KIND ITS OWN DECLARATION SAYS IT HAS, against the kind the
// slot requires, and the two kinds are compared by the DECLARATION EACH ONE RESOLVES TO -- never by
// matching a spelling to a name. This is the v1 counterpart of the judgment v2.compiler.resolve
// gained in PR #14327, written with the only lookups v1 has, and it mirrors the shape of
// applied_arg_is_width_resolution_position directly below: a kind is resolved in the module that
// DECLARES the thing carrying it, through the symbol index, and identity is source location.
//
// WHY THE OLD ARMS HAD TO GO. Arm 1 of type_arg_kind_inhabitance admitted any argument whose inferred
// type was a TypeVariable, and arm 4 admitted any bare name that resolved to such a binder. Neither
// read a kind. So once a declaration's own parameters carried the authority's binder (v1.compiler.infer
// build_type_env, routed through env_with_type_variable_bindings), a parameter declared Quantity could
// be forwarded into a Scale slot and be admitted without any check -- the silent widen DESIGN section 5
// forbids, and the exact defect #14327 deleted on the v2 side (ArgumentTypeParameterUnjudged => acc).
//
// EVERY UNKNOWN REFUSES, each with its own cause, so a future producer cannot land a defer-and-admit:
// the carrier is absent or not a parameter; the owner declaration is not in the index or is not the
// module the carrier names; the owner declares no such parameter; the parameter has no declared kind;
// or either kind cannot be resolved to a single declaring position.
fn forwarded_parameter_kind_matches(arg: Node, slot_kind_node: Node, env: TypeEnv, module_name: String) -> KindInhabitance {
  match arg.declaration {
    Absent => FwdParameterUnidentified
    Present { value: carrier } =>
      if !declaration_ref_is_type_parameter(ref: carrier) { FwdParameterUnidentified }
      else {
        match decl_type_parameter_name(ref: carrier) {
          Absent => FwdParameterUnidentified
          Present { value: parameter_name } =>
            // The owner is found in the module the CARRIER names, and the row reached must be that
            // module's own: a same-named declaration living elsewhere is not this parameter's owner.
            let owner_qualified = concat(carrier.module_path as String, ".", carrier.decl_name as String)
            match symbol_index_lookup(index: env.symbol_index, qualified_name: owner_qualified) {
              Absent => FwdParameterOwnerUnresolved
              Present { value: owner_decl } =>
                match map_get(env.symbol_index.file_modules, owner_decl.span.file) {
                  Absent => FwdParameterOwnerUnresolved
                  Present { value: owner_module } =>
                    if owner_module != (carrier.module_path as String) { FwdParameterOwnerUnresolved }
                    else {
                      match owner_decl.params |> filter(param =>
                          authored_name_at(source_indices: env.source_indices, node: param) == parameter_name)
                          |> first {
                        Absent => FwdParameterNotDeclaredByOwner
                        Present { value: binder } =>
                          match find_property(props: binder.properties, prop_name: type_param_kind_property_name(), source_indices: env.source_indices) {
                            Absent => FwdParameterUnkinded
                            Present { value: binder_kind_node } =>
                              match kind_declaring_position(kind_node: binder_kind_node, env: env) {
                                Absent => FwdParameterKindUnresolved
                                Present { value: binder_kind_decl } =>
                                  match kind_declaring_position(kind_node: slot_kind_node, env: env) {
                                    Absent => FwdParameterKindUnresolved
                                    Present { value: slot_kind_decl } =>
                                      if slot_kind_decl.span.file == binder_kind_decl.span.file
                                        && slot_kind_decl.span.start == binder_kind_decl.span.start
                                        && slot_kind_decl.span.end == binder_kind_decl.span.end {
                                        KindInhabited
                                      } else { FwdParameterKindDiffers }
                                  }
                              }
                          }
                      }
                    }
                }
            }
        }
      }
  }
}

// THE POSITION A KIND NAME DENOTES. A kind name is an ordinary name: it reaches its declaration the
// way every other bare name does, through the ONE binding kernel the typechecker uses
// (v1.compiler.infer bare_occurrence_binding -- own-file declaration, then the file's NAMED imports
// walked to the module that DECLARES the name, then the kernel check; an unimported name is
// Undecided and refuses). Composing <declaring module>.<kind name> and querying the index bypassed
// that kernel: it answered only for a kind declared in the SAME module as the annotated parameter,
// so every correctly-imported `S: Scale` in std.realization_measurement, std.realization_schedule,
// std.realization_width and std.realization refused with FwdParameterKindUnresolved while the
// same-module witness fixtures passed. THE COMPOSED-NAME LOOKUP IS DELETED; no second path survives
// beside this one. The scope is taken from the annotation's OWN span: v1.compiler.parse
// with_type_param_kind_property stores the kind token verbatim (span: k.span), so the file the name
// was AUTHORED in is the file whose imports decide its scope -- which is also why a parameter
// annotated with a kind its module does not import still refuses, under Undecided. Absent covers
// "no such declaration", "the chain did not end" and "no module recorded for the file it was found
// in", so a caller cannot read an unresolved kind as a judgment either way.
fn kind_declaring_position(kind_node: Node, env: TypeEnv) -> Node? {
  let kind_name = authored_name(env: env, node: kind_node)
  match bare_occurrence_binding(index: env.symbol_index, name: kind_name, reference: kind_node) {
    BareOccurrenceDeclaredInItsFile { declaration: kind_decl } =>
      match map_get(env.symbol_index.file_modules, kind_decl.span.file) {
        Absent => Absent
        Present { value: _ } => Present { value: kind_decl }
      }
    BareOccurrenceImportedByName { module_path: _, declaration: kind_decl } =>
      match map_get(env.symbol_index.file_modules, kind_decl.span.file) {
        Absent => Absent
        Present { value: _ } => Present { value: kind_decl }
      }
    BareOccurrenceIsKernelName => Absent
    BareOccurrenceUndecided => Absent
  }
}

// A literal argument is the Nat-indexed width arm only where the applied type's parameter at that
// position is of kind WidthResolution. The kind is read from the declaration of the type being
// applied (`MachineWidth<bits: WidthResolution>`): its __param_kind property names the kind, which is
// resolved in the AUTHORED scope of the annotation through the ONE binding kernel (kind_declaring_position)
// and compared to the WidthResolution declaration by source location. Any other kind (or none) is not
// a width position.
fn applied_arg_is_width_resolution_position(applied: Node, arg: Node, env: TypeEnv) -> Bool {
  if !is_user_generic_use_site(n: applied, env: env) { false }
  else {
    let decl = resolve_generic_use_decl(env: env, n: applied)
    match width_resolution_declaration(env: env) {
      Absent => false
      Present { value: width_decl } =>
        match map_get(env.symbol_index.file_modules, decl.span.file) {
          Absent => false
          Present { value: _ } =>
            decl.params |> enumerate |> any(pair =>
              match applied.children |> skip(pair.first) |> first {
                Absent => false
                Present { value: supplied } =>
                  supplied.span.file == arg.span.file && supplied.span.start == arg.span.start && supplied.span.end == arg.span.end
                  && match find_property(props: pair.second.properties, prop_name: type_param_kind_property_name(), source_indices: env.source_indices) {
                    Absent => false
                    Present { value: kind_node } =>
                      match kind_declaring_position(kind_node: kind_node, env: env) {
                        Present { value: kind_decl } => kind_decl.span.file == width_decl.span.file && kind_decl.span.start == width_decl.span.start
                        Absent => false
                      }
                  }
              }
            )
        }
    }
  }
}

fn is_width_nat_type_literal(n: Node) -> Bool {
  match n.expr_data {
    ExprLiteral { value: LitInt { value: _ } } => true
    _ => false
  }
}
fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

fn with_authored_identity(identity: Node, structural: Node) -> Node {
  Node {
    occurrence_identity: OccurrenceSynthetic, name: structural.name, ident: structural.ident, span: structural.span, ident_span: identity.ident_span,
    children: structural.children, connective: structural.connective, params: structural.params,
    inferred: structural.inferred, return_cardinality: join_optional_cardinality(left: identity.return_cardinality, right: structural.return_cardinality),
    uses: structural.uses, body: structural.body, transport: structural.transport,
    properties: structural.properties, type_annotation: structural.type_annotation,
    is_self_recursive: structural.is_self_recursive, has_non_tail_self_call: structural.has_non_tail_self_call,
    match_pattern: structural.match_pattern, module_item_kind: structural.module_item_kind, declaration_marker: structural.declaration_marker, declaration: structural.declaration, expr_data: structural.expr_data
  }
}

fn is_transparent_primitive_alias_rhs(structural: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  structural.connective == NoConnective && structural.children |> count == 0
    && is_kernel_type(name: authored_name_at(source_indices: source_indices, node: structural))
}

fn preserve_nominal_brand_on_resolve(
  identity: Node,
  structural: Node,
  brand_name: String,
  source_indices: Map<String, NewlineIndex>
) -> Node {
  if brand_name != "" && brand_name != authored_name_at(source_indices: source_indices, node: structural)
    && !is_declared_container_alias_spelling(name: brand_name)
    && (!is_transparent_primitive_alias_rhs(structural: structural, source_indices: source_indices)
      || is_kernel_type(name: qualified_last_segment(name: brand_name))) {
    with_authored_identity(identity: identity, structural: structural)
  } else { preserve_outer_optional_cardinality(outer: identity, inner: structural) }
}

// A TYPE-PARAMETER REFERENCE IS NOT A NOMINAL ALIAS, AND IT IS KNOWN BY ITS MARK, NOT ITS SPELLING
// (docs/plans/derived-node-identity-design.md, copy law L1; class gunbc.recurring_failure_mode
// generic_identity_decided_by_spelling). binder_marked_type records (owner, TypeParameter) on every
// reference to an item's own parameter. This function then looked the node up BY NAME and returned
// whatever the environment bound to that spelling, so a parameter spelled like some other binding in
// scope was replaced by that binding and its own identity was dropped: measured by
// //gunbc/instruments:generic-identity-census as formal_declaration_bound_conformance leaves carrying
// neither mark, where the signature they were read from carried both. There is nothing to peel
// beneath a parameter, so a node carrying the mark is returned as it was given.
fn node_is_type_parameter_reference(n: Node) -> Bool {
  match n.declaration {
    Present { value: ref } => declaration_ref_is_type_parameter(ref: ref)
    Absent => false
  }
}

// EXPANSION, NOT IDENTITY: reads the structure an alias RHS expands to (connective, children, kernel head). Which declaration a type
// denotes, or whether two types are the same, is alias_settled_agree / alias_identity_in_judgment (DESIGN 6b: one relation).
fn expand_nominal_alias_rhs(n: Node, env: TypeEnv, module_name: String) -> Node {
  if node_is_type_parameter_reference(n: n) { n } else { expand_nominal_alias_rhs_by_name(n: n, env: env, module_name: module_name) }
}

fn expand_nominal_alias_rhs_by_name(n: Node, env: TypeEnv, module_name: String) -> Node {
  let source_indices = env.source_indices
  let brand = authored_name_at(source_indices: source_indices, node: n)
  match lookup_type_for(env: env, node: n) {
    Present { value: resolved } =>
      let structural = if resolved.connective == NoConnective && resolved.children |> count == 0 && resolved.inferred != none {
        match resolved.inferred {
          Present { value: Resolved { node: target } } =>
            resolve_node_bounded(n: target, env: env, module_name: module_name, depth: 0, masked: false).resolved
          _ => resolve_node_bounded(n: resolved, env: env, module_name: module_name, depth: 0, masked: false).resolved
        }
      } else {
        resolve_node_bounded(n: resolved, env: env, module_name: module_name, depth: 0, masked: false).resolved
      }
      if brand != "" && brand != authored_name_at(source_indices: source_indices, node: structural)
        && !is_declared_container_alias_spelling(name: brand)
        && (!is_transparent_primitive_alias_rhs(structural: structural, source_indices: source_indices)
          || is_kernel_type(name: qualified_last_segment(name: brand))) {
        with_authored_identity(identity: n, structural: structural)
      } else if resolved.connective == NoConnective && resolved.children |> count == 0 && resolved.inferred != none {
        match resolved.inferred {
          Present { value: Resolved { node: target } } =>
            with_authored_identity(identity: n, structural: structural)
          _ => resolved
        }
      } else { resolved }
    Absent => n
  }
}

type NodeResolveResult {
  resolved: Node
  diagnostics: List<ErrorNode>
}

type ItemResolveResult {
  item: Node
  diagnostics: List<ErrorNode>
}

type FieldResolveResult {
  field: Node
  diagnostics: List<ErrorNode>
}

type ExprResolveResult {
  expr: Node
  diagnostics: List<ErrorNode>
}

type NamedArgResolveResult {
  arg: Node
  diagnostics: List<ErrorNode>
}

type MatchArmResolveResult {
  arm: Node
  diagnostics: List<ErrorNode>
}

type FieldInitResolveResult {
  field_init: Node
  diagnostics: List<ErrorNode>
}

type StringPartResolveResult {
  part: StringPart
  diagnostics: List<ErrorNode>
}

type TransportResolveResult {
  transport: Node
  diagnostics: List<ErrorNode>
}

type ParamResolveResult {
  param: Node
  diagnostics: List<ErrorNode>
}

type ResourceUseResult {
  resource_use: Node
  diagnostics: List<ErrorNode>
}

// ONE CONSTRUCTION OF A GENERIC DECLARATION'S APPLICATION: the nominal carrier keeps its type
// arguments as children and carries the declaration's members, with each slot substituted, as its
// expansion. resolve_node_bounded reaches it after resolving authored arguments; a caller that
// already holds resolved arguments -- an operation's output record is one, and re-resolving its
// fields as type names would be wrong -- reaches the same construction with those arguments.
// THE APPLICATION NAMES THE DECLARATION IT APPLIES. A reference the resolver already stamped keeps
// its identity; otherwise the declaration node the lookup landed on is the definition of it (the
// same mint field_inferred_with_declaration writes through), so `Optional<T>` as a return or
// parameter type is identified at the node the checker reads, not left to a spelling.
fn generic_declaration_application(n: Node, decl: Node, type_name: String, resolved_args: List<Node>, slot_bindings: Map<String, Node>, env: TypeEnv) -> Node {
  let substituted_children = decl.children |> map(child =>
    substitute_type_slots(n: child, slot_bindings: slot_bindings, decl_name: type_name, source_indices: env.source_indices)
  )
  let is_recursive = is_recursive_type_by_name(env: env, name: type_name)
  let applied_declaration = match n.declaration {
    Present { value: d } => Present { value: d }
    Absent => declaration_ref_of_declaration_node(decl: decl, source_indices: env.source_indices, env: env)
  }
  let expanded_node = Node { occurrence_identity: OccurrenceSynthetic, name: type_name, span: n.span, ident_span: n.ident_span, children: substituted_children, connective: decl.connective, params: [], inferred: n.inferred, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: decl.properties, type_annotation: n.type_annotation, is_self_recursive: is_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: applied_declaration, expr_data: n.expr_data }
  Node { occurrence_identity: n.occurrence_identity, name: type_name, span: n.span, ident_span: n.ident_span, children: resolved_args, connective: NoConnective, params: [], inferred: Present { value: Resolved { node: expanded_node } }, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: decl.properties, type_annotation: n.type_annotation, is_self_recursive: is_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: applied_declaration, expr_data: n.expr_data }
}

fn resolve_node(n: Node, env: TypeEnv, module_name: String) -> NodeResolveResult {
  resolve_node_bounded(n: n, env: env, module_name: module_name, depth: 0, masked: true)
}

data parameterized_use_site_prefers_parameterized_decl: String = "A use site WITH type arguments (children > 0) whose primary name lookup lands on a PARAMLESS decl is definitionally mis-resolved - type args imply a generic declaration. The concrete seam: the kernel prelude binding for a name (e.g. the kernel Optional) shadows an explicitly imported user generic of the same name in the ancestry rung, so v2's Optional<T> consumers resolved the paramless kernel decl, is_user_generic_use_site went false, the sig return was never expanded, and pattern bindings went error-typed with zero diagnostics (the interpreted-parse cascade; pre-existing on main). Retry the DIRECT import parents (str_bindings) for a parameterized decl before accepting the paramless one - the params filter naturally excludes the kernel parent, and the ancestry rung itself carries the kernel-shadowed entry so it cannot serve as the retry source."

fn resolve_paramless_generic_use_decl_with_children(env: TypeEnv, n: Node, decl: Node, brand: String) -> Node {
  match env.parents |> filter(parent =>
    match map_get(parent.str_bindings, brand) {
      Present { value: b } => b.resolved.params |> count > 0
      Absent => false
    }
  ) |> first {
    Present { value: parent } =>
      match map_get(parent.str_bindings, brand) {
        Present { value: b } => b.resolved
        Absent => decl
      }
    Absent =>
      if n.name != "" && n.name != brand {
        match lookup_type_by_name(env: env, name: n.name) {
          Present { value: structural } => structural
          Absent => decl
        }
      } else { decl }
  }
}

fn resolve_paramless_generic_use_decl(env: TypeEnv, n: Node, decl: Node, brand: String) -> Node {
  if n.children |> count == 0 { decl }
  else { resolve_paramless_generic_use_decl_with_children(env: env, n: n, decl: decl, brand: brand) }
}

fn resolve_generic_use_decl(env: TypeEnv, n: Node) -> Node {
  let brand = authored_name(env: env, node: n)
  match lookup_type_for(env: env, node: n) {
    Present { value: decl } =>
      if decl.params |> count > 0 { decl }
      else { resolve_paramless_generic_use_decl(env: env, n: n, decl: decl, brand: brand) }
    Absent =>
      match lookup_type_by_name(env: env, name: n.name) {
        Present { value: decl } => decl
        Absent => n
      }
  }
}

fn is_user_generic_use_site(n: Node, env: TypeEnv) -> Bool {
  let has_structure = n.connective != NoConnective
  if has_structure { false }
  else {
    let decl = resolve_generic_use_decl(env: env, n: n)
    if decl.params |> count > 0 {
      if is_container_type(name: n.name) { false }
      else if decl.inferred != none { true }
      else { true }
    } else { false }
  }
}

fn substitute_type_slots(n: Node, slot_bindings: Map<String, Node>, decl_name: String, source_indices: Map<String, NewlineIndex>) -> Node {
  substitute_type_slots_scoped(n: n, slot_bindings: slot_bindings, decl_name: decl_name, source_indices: source_indices, bind_type_variables: false)
}

fn substitute_type_slots_scoped(n: Node, slot_bindings: Map<String, Node>, decl_name: String, source_indices: Map<String, NewlineIndex>, bind_type_variables: Bool) -> Node {
  let tv_slot = if bind_type_variables {
    match n.inferred {
      Present { value: TypeVariable { id: tv_id } } => map_get(slot_bindings, tv_id)
      _ => none
    }
  } else { none }
  if tv_slot != none { return preserve_outer_optional_cardinality(outer: n, inner: tv_slot.value) }
  let is_slot = n.children |> count == 0 && n.connective == NoConnective && n.body == none && n.inferred == none
  if is_slot {
    match map_get(slot_bindings, authored_name_at(source_indices: source_indices, node: n)) {
      Present { value: concrete } => preserve_outer_optional_cardinality(outer: n, inner: concrete)
      Absent => n
    }
  } else {
    let new_children = n.children |> map(child =>
      if authored_name_at(source_indices: source_indices, node: child) == decl_name {
        let substituted_args = child.children |> map(arg =>
          substitute_type_slots_scoped(n: arg, slot_bindings: slot_bindings, decl_name: decl_name, source_indices: source_indices, bind_type_variables: bind_type_variables)
        )
        Node {
          occurrence_identity: child.occurrence_identity, name: child.name, span: child.span, ident_span: child.ident_span, children: substituted_args,
          connective: child.connective, params: child.params,
          inferred: child.inferred, return_cardinality: child.return_cardinality,
          uses: child.uses, body: child.body, transport: child.transport,
          properties: child.properties, type_annotation: child.type_annotation,
          is_self_recursive: child.is_self_recursive,
          has_non_tail_self_call: child.has_non_tail_self_call, match_pattern: child.match_pattern, module_item_kind: child.module_item_kind, declaration_marker: child.declaration_marker, declaration: child.declaration, expr_data: child.expr_data
        }
      } else {
        substitute_type_slots_scoped(n: child, slot_bindings: slot_bindings, decl_name: decl_name, source_indices: source_indices, bind_type_variables: bind_type_variables)
      }
    )
    let new_inferred = match n.inferred {
      Present { value: Resolved { node: rt } } =>
        Present { value: Resolved { node: substitute_type_slots_scoped(n: rt, slot_bindings: slot_bindings, decl_name: decl_name, source_indices: source_indices, bind_type_variables: bind_type_variables) } }
      _ => n.inferred
    }
    Node {
      occurrence_identity: n.occurrence_identity, name: n.name, span: n.span, ident_span: n.ident_span, children: new_children,
      connective: n.connective, params: n.params,
      inferred: new_inferred, return_cardinality: n.return_cardinality,
      uses: n.uses, body: n.body, transport: n.transport,
      properties: n.properties, type_annotation: n.type_annotation,
      is_self_recursive: n.is_self_recursive,
      has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: n.expr_data
    }
  }
}

type AliasKind = AliasParameterized | AliasLeaf | AliasPassthrough

fn classify_alias(target: Node) -> AliasKind {
  let nc = target.connective == NoConnective
  if target.children |> count > 0 && nc { AliasParameterized }
  else if target.children |> count == 0 && nc && target.ident_span != none { AliasLeaf }
  else { AliasPassthrough }
}

fn resolve_alias_target(target: Node, env: TypeEnv, module_name: String, depth: Int) -> Node {
  match classify_alias(target: target) {
    AliasParameterized =>
      resolve_node_bounded(n: target, env: env, module_name: module_name, depth: depth + 1, masked: false).resolved
    AliasLeaf =>
      match lookup_type_by_name(env: env, name: authored_name_at(source_indices: env.source_indices, node: target)) {
        Present { value: env_target } => env_target
        Absent => target
      }
    AliasPassthrough => target
  }
}

fn is_parametric_type_alias_decl(item: Node) -> Bool {
  (item.params |> count) > 0 && item.connective == NoConnective && item.body == none && item.transport == none && item.inferred != none
}

fn resolve_nominal_alias_rhs(n: Node, env: TypeEnv, module_name: String) -> NodeResolveResult {
  if n.connective == NoConnective && n.children |> count > 0 {
    let arg_results = n.children |> map(child => resolve_nominal_alias_rhs(n: child, env: env, module_name: module_name))
    let resolved_args = map(arg_results, ar => ar.resolved)
    let arg_diags = flat_map(arg_results, ar => ar.diagnostics)
    let validation = resolve_node(n: n, env: env, module_name: module_name)
    NodeResolveResult {
      resolved: Node {
        occurrence_identity: n.occurrence_identity, name: n.name, ident: n.ident, span: n.span, ident_span: n.ident_span, children: resolved_args,
        connective: n.connective, params: n.params, inferred: n.inferred,
        return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport,
        properties: n.properties, type_annotation: n.type_annotation,
        is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: NoExprData
      },
      diagnostics: concat(arg_diags, validation.diagnostics)
    }
  } else {
    resolve_node(n: n, env: env, module_name: module_name)
  }
}

data resolve_node_bounded_masked_boundary: String = "Selective-import fail-closed (§5): 'masked' is TRUE at the resolve_node source entry and INHERITS through structural recursions (product base :391, product child rt :406, optional inner :426, variant field rt :444, generic args :477, map k/v :519/:522, list elem :538), so every use-site type-argument reaches the leaf mask check masked. It flips FALSE only into GROUNDING recursions (expand_nominal_alias_rhs :150/:151/:154/:163, resolve_alias_target :342, parameterized-alias target :494, resolved-name grounding :561, and the field-access alias peel — v1.compiler.infer peel_alias_once_for_field_access, added 2026-09-09 after the census measured it charging definer-tree names to importers), which descend into DEFINING-module structure (the import responsibility of that module, not the use-site). INVARIANT (reviewed lively-raven-355 2026-07-06): grounding recursions must only ever descend into defining-module structure; the :561 arm relies on the resolved.children==0 leaf guard AND the :550-552 coproduct-container short-circuit — if a future refactor lets a parameterized use reach :561, a use-site arg could be inlined into grounding and skipped (a false-NEGATIVE / missing diagnostic once this is a hard refusal, not an availability bug in diagnostic-collect). Mask check (:568 Present arm) emits UnlistedImportUse when masked && name NOT in env.source_visible_names; keeps 'resolved' intact (diagnostic-collect, advisory). source_visible_names = locals + kernel + selective specific_names + is_all-module exports + type-params (:971). SCAFFOLD dissolve-on (§6): the advisory/non-erroring posture (is_error_diagnostic=false, 00_core.dag) is diagnostic-collect, NOT the final wall. Dissolves when (a) family-closure SVN lands — each imported name resolves to its whole coproduct family (owner + ALL siblings, lively-raven-355 ruling 2026-07-06) so the variant-owner-reverse false-positive class (import variant B then use owner E, or sibling A) is gone, AND (b) the corpus burndown of genuine unlisted uses (Symbol in v2/std/diagnostic.dag, NonEmptyStr in gcp, ...) reaches zero — at which point UnlistedImportUse promotes to a hard UnresolvedType/Refused joining §5's fail-closed wall, and the empty-source_visible_names guard (:345 count>0, a §3 dual-signal with 'masked' — flagged by claude-opus-4-7) collapses so 'masked' is the sole authority."

// N1a MEASUREMENT ARM (quiet-hawk-219): when type_ref_hit_ne_bind_measure_active (v1_rt host
// bracket), a masked leaf pool-hit without type_ref_measure_binding_authority emits UnresolvedType
// via bare_name_miss_diagnostic — never Product(<anon>). Production (measure off) keeps the
// UnlistedImportUse advisory path. Leaf path only; is_user_generic_use_site unchanged. Dissolve-on:
// gunbc.type_ref_hit_ne_bind_measure.authority type_ref_hit_ne_bind_measure_dissolve_trigger.

fn resolve_node_bounded(n: Node, env: TypeEnv, module_name: String, depth: Int, masked: Bool) -> NodeResolveResult {
  if depth > 100 {
    return NodeResolveResult {
      resolved: n,
      diagnostics: [make_error_node(diagnostic: InternalError { message: concat("internal: type resolution exceeded depth 100 for '", authored_name(env: env, node: n), "'"), span: n.span }, module_name: module_name)]
    }
  }
  let has_structure = n.connective != NoConnective
  let n_is_callable_type = match n.connective { Arrow => true  _ => false }
  if n_is_callable_type {
    let param_results = n.params |> map(p =>
      let authored_param_type = param_node_type_expr(n: p)
      let pr = resolve_node_bounded(n: authored_param_type, env: env, module_name: module_name, depth: depth + 1, masked: masked)
      ParamResolveResult {
        param: make_resolved_param_node(
          occurrence_identity: p.occurrence_identity,
          name: param_node_name_at(n: p, source_indices: env.source_indices),
          type_expr: rendered_use_site_type(authored: authored_param_type, resolved: pr.resolved),
          default_value: param_node_default_value(n: p),
          properties: concat(p.properties, pr.resolved.properties),
          span: p.span,
          name_span: node_name_span(n: p)
        ),
        diagnostics: pr.diagnostics
      }
    )
    let resolved_params = map(param_results, pr => pr.param)
    let param_diags = flat_map(param_results, pr => pr.diagnostics)
    let return_resolution = match n.inferred {
      Present { value: Resolved { node: rt } } =>
        let rr = resolve_node_bounded(n: rt, env: env, module_name: module_name, depth: depth + 1, masked: masked)
        NodeResolveResult { resolved: rendered_use_site_type(authored: rt, resolved: rr.resolved), diagnostics: rr.diagnostics }
      _ => NodeResolveResult { resolved: unit_type, diagnostics: [] }
    }
    let resolved_inferred = match n.inferred {
      Present { value: Resolved { node: _ } } => Present { value: Resolved { node: return_resolution.resolved } }
      _ => n.inferred
    }
    let return_diags = match n.inferred {
      Present { value: Resolved { node: _ } } => return_resolution.diagnostics
      _ => []
    }
    NodeResolveResult {
      resolved: Node { occurrence_identity: n.occurrence_identity, name: n.name, span: n.span, ident_span: n.ident_span, children: n.children, connective: n.connective, params: resolved_params, inferred: resolved_inferred, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: n.expr_data },
      diagnostics: concat(param_diags, return_diags)
    }
  } else if has_structure {
    let is_product = n.connective == Conj
    if is_product {
      if n.type_annotation != none {
        match n.children |> first {
          Present { value: base } =>
            let base_result = resolve_node_bounded(n: base, env: env, module_name: module_name, depth: depth + 1, masked: masked)
            let base_resolved = base_result.resolved
            let base_diags = base_result.diagnostics
            NodeResolveResult {
              resolved: Node { occurrence_identity: n.occurrence_identity, name: n.name, span: n.span, ident_span: n.ident_span, children: [base_resolved], connective: n.connective, params: n.params, inferred: n.inferred, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: NoExprData },
              diagnostics: base_diags
            }
          Absent => NodeResolveResult { resolved: n, diagnostics: [] }
        }
      } else {
        let child_results = map(n.children, child =>
          if child.inferred == none {
            NodeResolveResult { resolved: child, diagnostics: [] }
          } else {
            let child_rt = resolved_type(n: child)
            let rt_result = resolve_node_bounded(n: child_rt, env: env, module_name: module_name, depth: depth + 1, masked: masked)
            let rt_resolved = rt_result.resolved
            let rt_diags = rt_result.diagnostics
            NodeResolveResult {
              resolved: Node { occurrence_identity: child.occurrence_identity, name: child.name, span: child.span, ident_span: child.ident_span, children: child.children, connective: child.connective, params: child.params, inferred: Present { value: Resolved { node: rt_resolved } }, return_cardinality: child.return_cardinality, uses: child.uses, body: child.body, transport: child.transport, properties: concat(child.properties, rt_resolved.properties), type_annotation: child.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: child.module_item_kind, declaration_marker: child.declaration_marker, declaration: child.declaration, expr_data: NoExprData },
              diagnostics: rt_diags
            }
          }
        )
        let resolved_children = map(child_results, cr => cr.resolved)
        let all_diags = flat_map(child_results, cr => cr.diagnostics)
        NodeResolveResult {
          resolved: Node { occurrence_identity: n.occurrence_identity, name: n.name, span: n.span, ident_span: n.ident_span, children: resolved_children, connective: n.connective, params: n.params, inferred: n.inferred, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: NoExprData },
          diagnostics: all_diags
        }
      }
    } else {
      let is_optional = n.return_cardinality == CardOptional
      if is_optional {
        let inner = with_required_cardinality(n: n)
        let inner_result = resolve_node_bounded(n: inner, env: env, module_name: module_name, depth: depth + 1, masked: masked)
        let inner_resolved = inner_result.resolved
        let inner_diags = inner_result.diagnostics
        NodeResolveResult {
          resolved: with_optional_cardinality(n: inner_resolved),
          diagnostics: inner_diags
        }
      } else {
        let variant_results = map(n.children, variant_child =>
          let field_results = map(variant_child.children, field_child =>
            if field_child.inferred == none {
              NodeResolveResult { resolved: field_child, diagnostics: [] }
            } else {
              let field_rt = resolved_type(n: field_child)
              let is_self_ref = authored_name(env: env, node: field_rt) == authored_name(env: env, node: n) && field_rt.children |> count > 0
              let rt_result = if is_self_ref {
                NodeResolveResult { resolved: field_rt, diagnostics: [] }
              } else {
                resolve_node_bounded(n: field_rt, env: env, module_name: module_name, depth: depth + 1, masked: masked)
              }
              let rt_resolved = rt_result.resolved
              let rt_diags = rt_result.diagnostics
              NodeResolveResult {
                resolved: Node { occurrence_identity: field_child.occurrence_identity, name: field_child.name, span: field_child.span, ident_span: field_child.ident_span, children: field_child.children, connective: field_child.connective, params: field_child.params, inferred: Present { value: Resolved { node: rt_resolved } }, return_cardinality: field_child.return_cardinality, uses: field_child.uses, body: field_child.body, transport: field_child.transport, properties: concat(field_child.properties, rt_resolved.properties), type_annotation: field_child.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: field_child.module_item_kind, declaration_marker: field_child.declaration_marker, declaration: field_child.declaration, expr_data: NoExprData },
                diagnostics: rt_diags
              }
            }
          )
          let resolved_fields = map(field_results, fr => fr.resolved)
          let field_diags = flat_map(field_results, fr => fr.diagnostics)
          NodeResolveResult {
            resolved: Node { occurrence_identity: variant_child.occurrence_identity, name: variant_child.name, span: variant_child.span, ident_span: variant_child.ident_span, children: resolved_fields, connective: variant_child.connective, params: variant_child.params, inferred: variant_child.inferred, return_cardinality: variant_child.return_cardinality, uses: variant_child.uses, body: variant_child.body, transport: variant_child.transport, properties: variant_child.properties, type_annotation: variant_child.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: variant_child.module_item_kind, declaration_marker: variant_child.declaration_marker, declaration: variant_child.declaration, expr_data: NoExprData },
            diagnostics: field_diags
          }
        )
        let resolved_variants = map(variant_results, vr => vr.resolved)
        let all_diags = flat_map(variant_results, vr => vr.diagnostics)
        NodeResolveResult {
          resolved: Node { occurrence_identity: n.occurrence_identity, name: n.name, span: n.span, ident_span: n.ident_span, children: resolved_variants, connective: n.connective, params: n.params, inferred: n.inferred, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: NoExprData },
          diagnostics: all_diags
        }
      }
    }
  } else if n.children |> count > 0 && is_user_generic_use_site(n: n, env: env) {
    let type_name = authored_name(env: env, node: n)
    let decl = resolve_generic_use_decl(env: env, n: n)
    let expected_arity = decl.params |> count
    let actual_arity = n.children |> count
    let arity_diags = if expected_arity != actual_arity {
      [make_error_node(diagnostic: ArityMismatch { name: type_name, expected: expected_arity, got: actual_arity, span: n.span }, module_name: module_name)]
    } else { [] }
    let kind_diags = type_param_kind_diagnostics(carrier: n, decl: decl, type_name: type_name, env: env, module_name: module_name)
    let arg_results = n.children |> map(child => resolve_node_bounded(n: child, env: env, module_name: module_name, depth: depth + 1, masked: masked))
    // A nested type application is a use site, the same fact rendered_use_site_type stamps at a
    // parameter root. The container arm leaves List.inferred empty; without this wrap, Optional<List<T>>
    // carries an unstamped List while List<T> as the root is stamped -- one construction of one question.
    let resolved_args = n.children |> enumerate |> map(pair =>
      match arg_results |> skip(pair.first) |> first {
        Present { value: ar } => rendered_use_site_type(authored: pair.second, resolved: ar.resolved)
        Absent => pair.second
      }
    )
    let arg_diags = flat_map(arg_results, ar => ar.diagnostics)
    let slot_bindings = decl.params |> enumerate |> fold(init: empty_map(), f: (acc, pair) =>
      let idx = pair.first
      let slot_name = authored_name_at(source_indices: env.source_indices, node: pair.second)
      match resolved_args |> enumerate |> filter(p => p.first == idx) |> map(p => p.second) |> first {
        Present { value: arg } => map_insert(acc, slot_name, arg)
        Absent => acc
      }
    )
    let is_parameterized_alias = decl.inferred != none && decl.children |> count == 0 && decl.connective == NoConnective
    if is_parameterized_alias {
      let alias_target = match decl.inferred {
        Present { value: Resolved { node: target } } => substitute_type_slots(n: target, slot_bindings: slot_bindings, decl_name: type_name, source_indices: env.source_indices)
        _ => n
      }
      let target_result = resolve_node_bounded(n: alias_target, env: env, module_name: module_name, depth: depth + 1, masked: false)
      let is_recursive = is_recursive_type_by_name(env: env, name: type_name)
      let expanded_node = Node { occurrence_identity: OccurrenceSynthetic, name: type_name, span: n.span, ident_span: n.ident_span, children: target_result.resolved.children, connective: target_result.resolved.connective, params: [], inferred: target_result.resolved.inferred, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: target_result.resolved.properties, type_annotation: n.type_annotation, is_self_recursive: is_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: n.expr_data }
      let resolved_node = Node { occurrence_identity: n.occurrence_identity, name: type_name, span: n.span, ident_span: n.ident_span, children: resolved_args, connective: NoConnective, params: [], inferred: Present { value: Resolved { node: expanded_node } }, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: target_result.resolved.properties, type_annotation: n.type_annotation, is_self_recursive: is_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: n.expr_data }
      NodeResolveResult { resolved: resolved_node, diagnostics: concat(arity_diags, kind_diags, arg_diags, target_result.diagnostics) }
    } else {
      let result = NodeResolveResult {
        resolved: generic_declaration_application(n: n, decl: decl, type_name: type_name, resolved_args: resolved_args, slot_bindings: slot_bindings, env: env),
        diagnostics: concat(arity_diags, kind_diags, arg_diags)
      }
      result
    }
  } else {
    let is_map = node_is_keyed_collection(n: n, source_indices: env.source_indices)
    if is_map {
      let type_name = authored_name(env: env, node: n)
      let key_child_node = match n.children |> first { Present { value: k } => k  Absent => unit_type }
      let val_child_node = match skip(n.children, 1) |> first { Present { value: v } => v  Absent => unit_type }
      let key_type = child_type_node(ch: key_child_node)
      let val_type = child_type_node(ch: val_child_node)
      let key_result = resolve_node_bounded(n: key_type, env: env, module_name: module_name, depth: depth + 1, masked: masked)
      let key_resolved = key_result.resolved
      let key_diags = key_result.diagnostics
      let val_result = resolve_node_bounded(n: val_type, env: env, module_name: module_name, depth: depth + 1, masked: masked)
      let val_resolved = val_result.resolved
      let val_diags = val_result.diagnostics
      let key_param_name = if key_child_node.inferred != none { authored_name(env: env, node: key_child_node) } else { match container_param_name(kind_name: type_name, index: 0) { Present { value: pn } => pn  Absent => authored_name(env: env, node: key_child_node) } }
      let val_param_name = if val_child_node.inferred != none { authored_name(env: env, node: val_child_node) } else { match container_param_name(kind_name: type_name, index: 1) { Present { value: pn } => pn  Absent => authored_name(env: env, node: val_child_node) } }
      let resolved_key_child = Node { occurrence_identity: key_child_node.occurrence_identity, name: key_param_name, span: key_child_node.span, ident_span: key_child_node.ident_span, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: key_resolved } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
      let resolved_val_child = Node { occurrence_identity: val_child_node.occurrence_identity, name: val_param_name, span: val_child_node.span, ident_span: val_child_node.ident_span, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: val_resolved } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
      NodeResolveResult {
        resolved: stamp_kernel_collection(n: Node { occurrence_identity: n.occurrence_identity, name: type_name, span: n.span, ident_span: n.ident_span, children: [resolved_key_child, resolved_val_child], connective: n.connective, params: n.params, inferred: none, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: NoExprData }),
        diagnostics: concat(key_diags, val_diags)
      }
    } else if n.children |> count == 1 {
    let type_name = authored_name(env: env, node: n)
    match n.children |> first {
      Present { value: child_node } =>
        let el_type = child_type_node(ch: child_node)
        let el_result = resolve_node_bounded(n: el_type, env: env, module_name: module_name, depth: depth + 1, masked: masked)
        let el_resolved = el_result.resolved
        let el_diags = el_result.diagnostics
        let el_param_name = if child_node.inferred != none { authored_name(env: env, node: child_node) } else { match container_param_name(kind_name: type_name, index: 0) { Present { value: pn } => pn  Absent => authored_name(env: env, node: child_node) } }
        let resolved_child = Node { occurrence_identity: child_node.occurrence_identity, name: el_param_name, span: child_node.span, ident_span: child_node.ident_span, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: el_resolved } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }
        NodeResolveResult {
          resolved: stamp_kernel_collection(n: reference_with_declaration(env: env, n: Node { occurrence_identity: n.occurrence_identity, name: type_name, span: n.span, ident_span: n.ident_span, children: [resolved_child], connective: n.connective, params: n.params, inferred: none, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: NoExprData })),
          diagnostics: el_diags
        }
      Absent => NodeResolveResult { resolved: n, diagnostics: [] }
    }
  } else if n.children |> count == 0 {
    let n_is_callable = n.params |> count > 0
    let n_target_is_coproduct_container = match n.inferred { Present { value: Resolved { node: target } } => target.connective == NoConnective && target.children |> count > 0 && is_container_type(name: target.name) && resolve_generic_use_decl(env: env, n: target).connective == Disj  _ => false }
    if n_is_callable || is_recursive_type_for(env: env, node: n) || n_target_is_coproduct_container {
      NodeResolveResult { resolved: reference_with_declaration(n: n, env: env), diagnostics: [] }
    } else {
      match lookup_type_for(env: env, node: n) {
        Present { value: resolved } =>
          let structurally_resolved = if resolved.connective == NoConnective && resolved.children |> count == 0 && resolved.inferred != none {
            match resolved.inferred {
              Present { value: Resolved { node: target } } =>
                let target_is_coproduct_use = target.connective == NoConnective && target.children |> count > 0 && is_user_generic_use_site(n: target, env: env) && resolve_generic_use_decl(env: env, n: target).connective == Disj
                if target_is_coproduct_use {
                  resolve_node_bounded(n: target, env: env, module_name: module_name, depth: depth + 1, masked: false).resolved
                } else {
                  preserve_nominal_brand_on_resolve(
                    identity: resolved,
                    structural: target,
                    brand_name: authored_name_at(source_indices: env.source_indices, node: resolved),
                    source_indices: env.source_indices
                  )
                }
              _ => resolved
            }
          } else { resolved }
          let type_name = authored_name(env: env, node: n)
          let is_optional = n.return_cardinality == CardOptional
          let final_resolved = if is_optional { with_optional_cardinality(n: structurally_resolved) } else { structurally_resolved }
          if masked
            && type_ref_hit_ne_bind_measure_active()
            && type_ref_measure_binding_authority(env: env, name: type_name) == false
            && is_kernel_type(name: type_name) == false
            && is_kernel_type(name: qualified_last_segment(name: type_name)) == false {
            NodeResolveResult {
              resolved: final_resolved,
              diagnostics: [make_error_node(diagnostic: bare_name_miss_diagnostic(env: env, name: type_name, span: n.span), module_name: module_name)]
            }
          } else {
            let unlisted_diags = if masked && map_is_empty(m: env.source_visible_names) == false && map_has(m: env.source_visible_names, key: type_name) == false && resolved_node_is_kernel_identity_for_name(node: n, name: type_name) == false {
              [make_error_node(diagnostic: UnlistedImportUse { name: type_name, span: n.span }, module_name: module_name)]
            } else { [] }
            NodeResolveResult { resolved: final_resolved, diagnostics: unlisted_diags }
          }
        Absent =>
          let n_is_error = if n.inferred != none { is_compiler_error(inferred: n.inferred.value) } else { false }
          let n_is_type_var = if n.inferred != none { is_type_variable(inferred: n.inferred.value) } else { false }

          if is_width_nat_type_literal(n: n) || is_kernel_type(name: authored_name(env: env, node: n)) || n_is_type_var || n_is_error {
            NodeResolveResult { resolved: n, diagnostics: [] }
          } else {
            match lookup_unit_variant_phantom_type(env: env, variant_name: authored_name(env: env, node: n)) {
              UnitVariantPhantomPresent { variant: phantom } => NodeResolveResult { resolved: phantom, diagnostics: [] }
              UnitVariantPhantomAbsent =>
                NodeResolveResult {
                  resolved: n,
                  diagnostics: [make_error_node(diagnostic: bare_name_miss_diagnostic(env: env, name: authored_name(env: env, node: n), span: n.span), module_name: module_name)]
                }
              UnitVariantPhantomEvidenceUnavailable =>
                NodeResolveResult {
                  resolved: n,
                  diagnostics: [make_error_node(diagnostic: UnitVariantPhantomIdentityEvidenceUnavailable { name: authored_name(env: env, node: n), span: n.span }, module_name: module_name)]
                }
            }
          }
      }
    }
    } else {
      NodeResolveResult { resolved: n, diagnostics: [] }
    }
  }
}

fn missing_generic_args_diagnostics(n: Node, env: TypeEnv, module_name: String) -> List<ErrorNode> {
  if n.children |> count == 0 && n.params |> count == 0 && is_user_generic_use_site(n: n, env: env) {
    let type_name = authored_name(env: env, node: n)
    let decl = match lookup_type_for(env: env, node: n) { Present { value: d } => d  Absent => n }
    [make_error_node(diagnostic: ArityMismatch { name: type_name, expected: decl.params |> count, got: 0, span: n.span }, module_name: module_name)]
  } else {
    []
  }
}

// The Divergent arm: an expression that produces no value has nothing to resolve to.
// Returning unit_type would fabricate a type for unreachable code, and emitting a
// diagnostic would refuse a program that is not wrong -- so resolution carries the
// divergence forward unchanged and lets the consumer that cares decide. review
// 5085499375 (D1).
fn resolve_optional_node(n: InferredNode?, env: TypeEnv, module_name: String) -> NodeResolveResult {
  if n == none { NodeResolveResult { resolved: unit_type, diagnostics: [] } }
  else {
    match n.value {
      Resolved { node: inner } => resolve_node(n: inner, env: env, module_name: module_name)
      CompilerError { message: msg, span: sp } =>
        NodeResolveResult {
          resolved: make_expr_error_node(occurrence_identity: OccurrenceSynthetic, kind: SemanticExprError, message: msg, span: sp),
          diagnostics: [make_error_node(diagnostic: InternalError { message: msg, span: sp }, module_name: module_name)]
        }
      Divergent => NodeResolveResult { resolved: divergent_type(), diagnostics: [] }
      TypeVariable { id: tv } =>
        NodeResolveResult { resolved: Node { occurrence_identity: OccurrenceSynthetic, name: tv, span: kernel_span(name: tv), ident_span: Present { value: kernel_span(name: tv) }, children: [], connective: NoConnective, params: [], inferred: Present { value: TypeVariable { id: tv } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData }, diagnostics: [] }
    }
  }
}

fn resolve_field(field: Node, env: TypeEnv, module_name: String) -> FieldResolveResult {
  let authored_type = field_node_type_expr(n: field)
  let type_result = resolve_node(n: authored_type, env: env, module_name: module_name)
  let type_resolved = type_result.resolved
  let type_diags = concat(type_result.diagnostics, missing_generic_args_diagnostics(n: authored_type, env: env, module_name: module_name))
  let default_resolved = match field_node_default_value(n: field) {
    Present { value: default_value } => Present { value: resolve_expr_types(texpr: default_value, env: env, module_name: module_name) }
    Absent => none
  }
  let default_diags = match default_resolved {
    Present { value: result } => result.diagnostics
    Absent => []
  }
  FieldResolveResult {
    field: make_field_node(occurrence_identity: field.occurrence_identity,
      name: field_node_name_at(n: field, source_indices: env.source_indices),
      type_expr: type_resolved,
      cardinality: field_node_cardinality(n: field),
      default_value: match default_resolved {
        Present { value: result } => Present { value: result.expr }
        Absent => none
      },
      from_key_properties: field.properties |> filter(p => field_init_node_name_at(n: p, source_indices: env.source_indices) == field_from_key_property_name),
      span: field.span, name_span: node_name_span(n: field)
    ),
    diagnostics: concat(type_diags, default_diags)
  }
}

// Kernel collections (List/Set/Map) are the producer of their own use-site stamp. The parse
// node carries inferred=none; leaving it that way meant only a later rendered_use_site_type at a
// parameter root stamped List, so Optional<List<T>> / a record field / another generic's argument
// kept an unstamped collection. Stamp here, once, wherever the container arm runs.
fn stamp_kernel_collection(n: Node) -> Node {
  Node { occurrence_identity: n.occurrence_identity, name: n.name, span: n.span, ident_span: n.ident_span, children: n.children, connective: n.connective, params: n.params, inferred: Present { value: Resolved { node: n } }, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: n.expr_data }
}

fn rendered_use_site_type(authored: Node, resolved: Node) -> Node {
  if authored.children |> count > 0 {
    Node { occurrence_identity: authored.occurrence_identity, name: authored.name, span: authored.span, ident_span: authored.ident_span, children: resolved.children, connective: authored.connective, params: authored.params, inferred: Present { value: Resolved { node: resolved } }, return_cardinality: authored.return_cardinality, uses: authored.uses, body: authored.body, transport: authored.transport, properties: resolved.properties, type_annotation: authored.type_annotation, is_self_recursive: authored.is_self_recursive, has_non_tail_self_call: authored.has_non_tail_self_call, match_pattern: authored.match_pattern, module_item_kind: authored.module_item_kind, declaration_marker: authored.declaration_marker, declaration: authored.declaration, expr_data: authored.expr_data }
  } else {
    Node { occurrence_identity: authored.occurrence_identity, name: resolved.name, span: resolved.span, ident_span: resolved.ident_span, children: resolved.children, connective: resolved.connective, params: resolved.params, inferred: resolved.inferred, return_cardinality: resolved.return_cardinality, uses: resolved.uses, body: resolved.body, transport: resolved.transport, properties: resolved.properties, type_annotation: resolved.type_annotation, is_self_recursive: resolved.is_self_recursive, has_non_tail_self_call: resolved.has_non_tail_self_call, match_pattern: resolved.match_pattern, module_item_kind: resolved.module_item_kind, declaration_marker: resolved.declaration_marker, declaration: resolved.declaration, expr_data: resolved.expr_data }
  }
}

fn resolve_param(param: Node, env: TypeEnv, module_name: String) -> ParamResolveResult {
  let authored_type = param_node_type_expr(n: param)
  let type_result = resolve_node(n: authored_type, env: env, module_name: module_name)
  let type_resolved = type_result.resolved
  let rendered_type = rendered_use_site_type(authored: authored_type, resolved: type_resolved)
  let type_diags = concat(type_result.diagnostics, missing_generic_args_diagnostics(n: authored_type, env: env, module_name: module_name))
  let default_resolved = match param_node_default_value(n: param) {
    Present { value: default_value } => Present { value: resolve_expr_types(texpr: default_value, env: env, module_name: module_name) }
    Absent => none
  }
  let default_diags = match default_resolved {
    Present { value: result } => result.diagnostics
    Absent => []
  }
  let default_expr = match default_resolved {
    Present { value: result } => Present { value: result.expr }
    Absent => none
  }
  ParamResolveResult {
    param: make_resolved_param_node(occurrence_identity: param.occurrence_identity,
      name: param_node_name_at(n: param, source_indices: env.source_indices),
      type_expr: rendered_type,
      default_value: default_expr,
      properties: concat(param.properties, type_resolved.properties),
      span: param.span,
      name_span: node_name_span(n: param)
    ),
    diagnostics: concat(type_diags, default_diags)
  }
}

fn resolve_resource_use(ru: Node, env: TypeEnv, module_name: String) -> ResourceUseResult {
  let type_result = resolve_node(n: resource_use_resource(n: ru), env: env, module_name: module_name)
  let type_resolved = type_result.resolved
  let type_diags = type_result.diagnostics
  ResourceUseResult {
    resource_use: make_resource_use_node(occurrence_identity: ru.occurrence_identity, name: resource_use_name_at(n: ru, source_indices: env.source_indices), resource: type_resolved, span: ru.span, name_span: node_name_span(n: ru)),
    diagnostics: type_diags
  }
}

fn resolve_named_arg(arg: Node, env: TypeEnv, module_name: String) -> NamedArgResolveResult {
  let value_result = resolve_expr_types(texpr: arg_value(n: arg), env: env, module_name: module_name)
  let value_expr = value_result.expr
  let value_diags = value_result.diagnostics
  NamedArgResolveResult {
    arg: make_arg_node(occurrence_identity: arg.occurrence_identity, name: arg_name_at(n: arg, source_indices: env.source_indices), value: value_expr, span: arg.span, name_span: node_name_span(n: arg)),
    diagnostics: value_diags
  }
}

fn resolve_field_init(field_init: Node, env: TypeEnv, module_name: String) -> FieldInitResolveResult {
  let value_result = resolve_expr_types(texpr: field_init_node_value(n: field_init), env: env, module_name: module_name)
  let value_expr = value_result.expr
  let value_diags = value_result.diagnostics
  FieldInitResolveResult {
    field_init: make_field_init_node(occurrence_identity: field_init.occurrence_identity, name: field_init_node_name_at(n: field_init, source_indices: env.source_indices), value: value_expr, span: field_init.span, name_span: node_name_span(n: field_init)),
    diagnostics: value_diags
  }
}

fn resolve_match_arm(arm: Node, env: TypeEnv, module_name: String) -> MatchArmResolveResult {
  let arm_g = arm_guard(n: arm)
  let guard_result = match arm_g {
    Present { value: guard } => Present { value: resolve_expr_types(texpr: guard, env: env, module_name: module_name) }
    Absent => none
  }
  let guard_diags = match guard_result {
    Present { value: result } => result.diagnostics
    Absent => []
  }
  let body_result = resolve_expr_types(texpr: arm_body(n: arm), env: env, module_name: module_name)
  let body_expr = body_result.expr
  let body_diags = body_result.diagnostics
  MatchArmResolveResult {
    arm: make_arm_node(occurrence_identity: arm.occurrence_identity,
      pattern: arm_pattern(n: arm),
      guard: match guard_result {
        Present { value: result } => Present { value: result.expr }
        Absent => none
      },
      body: body_expr,
      span: arm.span
    ),
    diagnostics: concat(guard_diags, body_diags)
  }
}

fn resolve_string_part(part: StringPart, env: TypeEnv, module_name: String) -> StringPartResolveResult {
  match part {
    Text { value: value } =>
      StringPartResolveResult {
        part: Text { value: value },
        diagnostics: []
      }
    Interpolation { expr: expr } =>
      let expr_result = resolve_expr_types(texpr: expr, env: env, module_name: module_name)
      let resolved_expr = expr_result.expr
      let expr_diags = expr_result.diagnostics
      StringPartResolveResult {
        part: Interpolation { expr: resolved_expr },
        diagnostics: expr_diags
      }
  }
}

fn resolve_transport_binding(transport: Node, env: TypeEnv, module_name: String) -> TransportResolveResult {
  if is_local_transport(t: transport, source_indices: env.source_indices) {
    TransportResolveResult { transport: transport, diagnostics: [] }
  } else {
    let prop_results = map(transport.properties, p =>
      let val_result = resolve_expr_types(texpr: field_init_node_value(n: p), env: env, module_name: module_name)
      FieldInitResolveResult { field_init: make_field_init_node(occurrence_identity: p.occurrence_identity, name: field_init_node_name_at(n: p, source_indices: env.source_indices), value: val_result.expr, span: p.span, name_span: node_name_span(n: p)), diagnostics: val_result.diagnostics }
    )
    let resolved_props = map(prop_results, pr => pr.field_init)
    let prop_diags = flat_map(prop_results, pr => pr.diagnostics)
    let child_results = map(transport.children, c => resolve_expr_types(texpr: c, env: env, module_name: module_name))
    let resolved_children = map(child_results, cr => cr.expr)
    let child_diags = flat_map(child_results, cr => cr.diagnostics)
    let body_diags = match transport_request_body(t: transport, source_indices: env.source_indices) {
      Present { value: b } => match b.expr_data {
        ExprRecordLit => []
        _ => [make_error_node(diagnostic: InternalError { message: "transport body must be a record expression { field: value, ... }", span: b.span }, module_name: module_name)]
      }
      Absent => []
    }
    TransportResolveResult {
      transport: make_transport_node(occurrence_identity: transport.occurrence_identity, properties: resolved_props, children: resolved_children, body: transport.body, span: transport.span),
      diagnostics: concat(prop_diags, child_diags, body_diags)
    }
  }
}

fn resolve_expr_types(texpr: Node, env: TypeEnv, module_name: String) -> ExprResolveResult {
  match texpr.expr_data {
    ExprLiteral { value: _ } => ExprResolveResult { expr: texpr, diagnostics: [] }
    ExprElaboratedLiteral { value: _, elaboration: _ } => ExprResolveResult { expr: texpr, diagnostics: [] }
    ExprError { kind: kind, message: message } =>
      ExprResolveResult {
        expr: make_expr_error_node(occurrence_identity: OccurrenceSynthetic, kind: kind, message: message, span: texpr.span),
        diagnostics: [make_error_node(diagnostic: InternalError { message: message, span: texpr.span }, module_name: module_name)]
      }
    ExprVar { binding_kind: _ } => ExprResolveResult { expr: texpr, diagnostics: [] }
    ExprFieldAccess { summary: _ } =>
      let r = match texpr.children |> first {
        Present { value: base } => resolve_expr_types(texpr: base, env: env, module_name: module_name)
        Absent => ExprResolveResult { expr: texpr, diagnostics: [] }
      }
      ExprResolveResult { expr: map_children(node: texpr, transform: child => r.expr), diagnostics: r.diagnostics }
    ExprCall { call_semantics: cs, descent_evidence: de } =>

      let arg_results = texpr.children |> map(arg_node =>
        let val = match arg_node.children |> first { Present { value: v } => v  Absent => arg_node }
        let vr = resolve_expr_types(texpr: val, env: env, module_name: module_name)
        ExprResolveResult { expr: make_arg_node(occurrence_identity: arg_node.occurrence_identity, name: if arg_node.ident_span == none { none } else { Present { value: authored_name(env: env, node: arg_node) } }, value: vr.expr, span: arg_node.span, name_span: node_name_span(n: arg_node)), diagnostics: vr.diagnostics }
      )
      let resolved_children = arg_results |> map(r => r.expr)
      let all_diags = flat_map(arg_results, r => r.diagnostics)
      ExprResolveResult { expr: make_named_expr_node(occurrence_identity: texpr.occurrence_identity, name: expr_call_func_at(texpr: texpr, source_indices: env.source_indices), expr_data: ExprCall { call_semantics: cs, descent_evidence: de }, children: resolved_children, inferred: texpr.inferred, span: texpr.span, name_span: node_name_span(n: texpr)), diagnostics: all_diags }
    ExprMethodCall { method_semantics: ms } =>

      let mc_results = texpr.children |> enumerate |> map(pair =>
        let idx = pair.first
        let child = pair.second
        if idx == 0 {
          let rr = resolve_expr_types(texpr: child, env: env, module_name: module_name)
          ExprResolveResult { expr: rr.expr, diagnostics: rr.diagnostics }
        } else {
          let val = match child.children |> first { Present { value: v } => v  Absent => child }
          let vr = resolve_expr_types(texpr: val, env: env, module_name: module_name)
          ExprResolveResult { expr: make_arg_node(occurrence_identity: child.occurrence_identity, name: if child.ident_span == none { none } else { Present { value: authored_name_at(source_indices: env.source_indices, node: child) } }, value: vr.expr, span: child.span, name_span: node_name_span(n: child)), diagnostics: vr.diagnostics }
        }
      )
      let resolved_children = mc_results |> map(r => r.expr)
      let all_diags = flat_map(mc_results, r => r.diagnostics)
      ExprResolveResult { expr: make_named_expr_node(occurrence_identity: texpr.occurrence_identity, name: expr_method_name_at(texpr: texpr, source_indices: env.source_indices), expr_data: ExprMethodCall { method_semantics: ms }, children: resolved_children, inferred: texpr.inferred, span: texpr.span, name_span: node_name_span(n: texpr)), diagnostics: all_diags }
    ExprMatch =>

      let match_results = texpr.children |> enumerate |> map(pair =>
        let idx = pair.first
        let child = pair.second
        if idx == 0 {
          let sr = resolve_expr_types(texpr: child, env: env, module_name: module_name)
          ExprResolveResult { expr: sr.expr, diagnostics: sr.diagnostics }
        } else {
          let arm_ch = child.children
          let has_guard = arm_ch |> count == 2
          if has_guard {
            let guard_r = match arm_ch |> first { Present { value: g } => resolve_expr_types(texpr: g, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: child, diagnostics: [] } }
            let body_r = match arm_ch |> skip(1) |> first { Present { value: b } => resolve_expr_types(texpr: b, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: child, diagnostics: [] } }
            ExprResolveResult { expr: make_arm_node(occurrence_identity: child.occurrence_identity, pattern: match child.match_pattern { Present { value: p } => p  Absent => Wildcard }, guard: Present { value: guard_r.expr }, body: body_r.expr, span: child.span), diagnostics: concat(guard_r.diagnostics, body_r.diagnostics) }
          } else {
            let body_r = match arm_ch |> first { Present { value: b } => resolve_expr_types(texpr: b, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: child, diagnostics: [] } }
            ExprResolveResult { expr: make_arm_node(occurrence_identity: child.occurrence_identity, pattern: match child.match_pattern { Present { value: p } => p  Absent => Wildcard }, guard: none, body: body_r.expr, span: child.span), diagnostics: body_r.diagnostics }
          }
        }
      )
      let resolved_children = match_results |> map(r => r.expr)
      let all_diags = flat_map(match_results, r => r.diagnostics)
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprMatch, children: resolved_children, inferred: texpr.inferred, span: texpr.span), diagnostics: all_diags }
    ExprIf =>
      let ch = texpr.children
      let cr = match ch |> first { Present { value: c } => resolve_expr_types(texpr: c, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      let tr = match ch |> skip(1) |> first { Present { value: t } => resolve_expr_types(texpr: t, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      let er = match ch |> skip(2) |> first { Present { value: e } => Present { value: resolve_expr_types(texpr: e, env: env, module_name: module_name) }  Absent => none }
      let resolved_children = match er { Present { value: r } => [cr.expr, tr.expr, r.expr]  Absent => [cr.expr, tr.expr] }
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprIf, children: resolved_children, inferred: texpr.inferred, span: texpr.span), diagnostics: concat(cr.diagnostics, tr.diagnostics, match er { Present { value: r } => r.diagnostics  Absent => [] }) }
    ExprLet =>
      let ch = texpr.children
      let vr = match ch |> first { Present { value: v } => resolve_expr_types(texpr: v, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      let br = match ch |> skip(1) |> first { Present { value: bd } => Present { value: resolve_expr_types(texpr: bd, env: env, module_name: module_name) }  Absent => none }
      let resolved_children = match br { Present { value: r } => [vr.expr, r.expr]  Absent => [vr.expr] }
      let anno_resolved = if texpr.type_annotation == none {
        NodeResolveResult { resolved: unit_type, diagnostics: [] }
      } else if is_type_expr_annotation(n: texpr.type_annotation.value) {
        resolve_node(n: texpr.type_annotation.value, env: env, module_name: module_name)
      } else {
        NodeResolveResult { resolved: texpr.type_annotation.value, diagnostics: [] }
      }
      let resolved_anno = if texpr.type_annotation == none { none } else if is_type_expr_annotation(n: texpr.type_annotation.value) { Present { value: anno_resolved.resolved } } else { texpr.type_annotation }
      let let_node = Node {
        occurrence_identity: OccurrenceSynthetic, name: let_binding_name_at(texpr: texpr, source_indices: env.source_indices),
        span: texpr.span,
        ident_span: default_ident_span(name: let_binding_name_at(texpr: texpr, source_indices: env.source_indices), span: node_name_span(n: texpr)),
        children: resolved_children,
        connective: NoConnective,
        params: [],
        inferred: texpr.inferred,
        return_cardinality: Required,
        uses: [],
        body: none,
        transport: none,
        properties: [],
        type_annotation: resolved_anno,
        is_self_recursive: false,
        has_non_tail_self_call: false,
        match_pattern: none,
        module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: ExprLet
      }
      ExprResolveResult { expr: let_node, diagnostics: concat(vr.diagnostics, match br { Present { value: r } => r.diagnostics  Absent => [] }, anno_resolved.diagnostics) }
    ExprRecordLit { parent_enum: pe } =>

      let fi_results = texpr.children |> map(fi_node =>
        let val = match fi_node.children |> first { Present { value: v } => v  Absent => fi_node }
        let vr = resolve_expr_types(texpr: val, env: env, module_name: module_name)
        ExprResolveResult { expr: make_field_init_node(occurrence_identity: fi_node.occurrence_identity, name: authored_name(env: env, node: fi_node), value: vr.expr, span: fi_node.span, name_span: node_name_span(n: fi_node)), diagnostics: vr.diagnostics }
      )
      let resolved_children = fi_results |> map(r => r.expr)
      let all_diags = flat_map(fi_results, r => r.diagnostics)
      ExprResolveResult { expr: make_named_expr_node(occurrence_identity: texpr.occurrence_identity, name: authored_name_at(source_indices: env.source_indices, node: texpr), expr_data: ExprRecordLit { parent_enum: pe }, children: resolved_children, inferred: texpr.inferred, span: texpr.span, name_span: node_name_span(n: texpr)), diagnostics: all_diags }
    ExprListLit =>
      let el_results = texpr.children |> map(el => resolve_expr_types(texpr: el, env: env, module_name: module_name))
      let resolved_children = el_results |> map(r => r.expr)
      let all_diags = flat_map(el_results, r => r.diagnostics)
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprListLit, children: resolved_children, inferred: texpr.inferred, span: texpr.span), diagnostics: all_diags }
    ExprBinOp { op: op, algebra_field: af, operand: od } =>
      let ch = texpr.children
      let lr = match ch |> first { Present { value: l } => resolve_expr_types(texpr: l, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      let rr = match ch |> skip(1) |> first { Present { value: r } => resolve_expr_types(texpr: r, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprBinOp { op: op, algebra_field: af, operand: od }, children: [lr.expr, rr.expr], inferred: texpr.inferred, span: texpr.span), diagnostics: concat(lr.diagnostics, rr.diagnostics) }
    ExprUnaryOp { op: op } =>
      let r = match texpr.children |> first { Present { value: o } => resolve_expr_types(texpr: o, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprUnaryOp { op: op }, children: [r.expr], inferred: texpr.inferred, span: texpr.span), diagnostics: r.diagnostics }
    ExprLambda =>
      let lam_param_nodes = texpr.children |> skip(1)
      let r = match texpr.children |> first { Present { value: b } => resolve_expr_types(texpr: b, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprLambda, children: concat([r.expr], lam_param_nodes), inferred: texpr.inferred, span: texpr.span), diagnostics: r.diagnostics }
    ExprStringInterp =>

      let part_results = texpr.children |> map(part_node =>
        match part_node.expr_data {
          ExprLiteral { value: _ } => ExprResolveResult { expr: part_node, diagnostics: [] }
          _ =>
            match part_node.children |> first {
              Present { value: inner } =>
                let r = resolve_expr_types(texpr: inner, env: env, module_name: module_name)
                ExprResolveResult { expr: make_interp_part_node(occurrence_identity: part_node.occurrence_identity, expr: r.expr, span: part_node.span), diagnostics: r.diagnostics }
              Absent => ExprResolveResult { expr: part_node, diagnostics: [] }
            }
        }
      )
      let resolved_children = part_results |> map(r => r.expr)
      let all_diags = flat_map(part_results, r => r.diagnostics)
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprStringInterp, children: resolved_children, inferred: texpr.inferred, span: texpr.span), diagnostics: all_diags }
    ExprBlock =>
      let stmt_results = texpr.children |> map(s => resolve_expr_types(texpr: s, env: env, module_name: module_name))
      let resolved_children = stmt_results |> map(r => r.expr)
      let all_diags = flat_map(stmt_results, r => r.diagnostics)
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprBlock, children: resolved_children, inferred: texpr.inferred, span: texpr.span), diagnostics: all_diags }
    ExprCast =>
      let ch = texpr.children
      let r = match ch |> first { Present { value: inner } => resolve_expr_types(texpr: inner, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      let tr = match ch |> skip(1) |> first { Present { value: target } => resolve_node(n: target, env: env, module_name: module_name)  Absent => NodeResolveResult { resolved: unit_type, diagnostics: [] } }
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprCast, children: [r.expr, tr.resolved], inferred: texpr.inferred, span: texpr.span), diagnostics: concat(r.diagnostics, tr.diagnostics) }
    ExprForEach =>
      let ch = texpr.children
      let cr = match ch |> first { Present { value: c } => resolve_expr_types(texpr: c, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      let br = match ch |> skip(1) |> first { Present { value: b } => resolve_expr_types(texpr: b, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      ExprResolveResult { expr: make_named_expr_node(occurrence_identity: texpr.occurrence_identity, name: foreach_variable_at(texpr: texpr, source_indices: env.source_indices), expr_data: ExprForEach, children: [cr.expr, br.expr], inferred: texpr.inferred, span: texpr.span, name_span: node_name_span(n: texpr)), diagnostics: concat(cr.diagnostics, br.diagnostics) }
    ExprIndex =>
      let ch = texpr.children
      let br = match ch |> first { Present { value: base } => resolve_expr_types(texpr: base, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      let ir = match ch |> skip(1) |> first { Present { value: index } => resolve_expr_types(texpr: index, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprIndex, children: [br.expr, ir.expr], inferred: texpr.inferred, span: texpr.span), diagnostics: concat(br.diagnostics, ir.diagnostics) }
    ExprSlice =>
      let ch = texpr.children
      let br = match ch |> first { Present { value: base } => resolve_expr_types(texpr: base, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      let sr = match ch |> skip(1) |> first { Present { value: start } => resolve_expr_types(texpr: start, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      let er = match ch |> skip(2) |> first { Present { value: end_e } => resolve_expr_types(texpr: end_e, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprSlice, children: [br.expr, sr.expr, er.expr], inferred: texpr.inferred, span: texpr.span), diagnostics: concat(br.diagnostics, sr.diagnostics, er.diagnostics) }
    ExprReturn =>
      let r = match texpr.children |> first { Present { value: inner } => resolve_expr_types(texpr: inner, env: env, module_name: module_name)  Absent => ExprResolveResult { expr: texpr, diagnostics: [] } }
      ExprResolveResult { expr: make_expr_node(occurrence_identity: texpr.occurrence_identity, expr_data: ExprReturn, children: [r.expr], inferred: texpr.inferred, span: texpr.span), diagnostics: r.diagnostics }
    NoExprData => ExprResolveResult { expr: texpr, diagnostics: [] }
  }
}

// THE BINDER ROSTER, from DECLARATION FORM. A parameter is a type parameter when the PARSE says it was
// minted in this item's `< ... >` header (v1.compiler.parse with_type_param_declaration_form_property,
// written unconditionally at the single grammar-position mint, collect_type_param_names). Both
// declaration forms -- fn and type -- route their headers through that one function, so one rule covers
// both, bare and kinded alike.
//
// THE SPELLING TEST IT REPLACED (manager ruling msg_9ac89964, "not by widening the heuristic") asked
// whether a parameter's AUTHORED NAME EQUALLED THE TEXT OF ITS TYPE EXPRESSION. That is a test of
// spelling, not of form, and it was wrong at both ends, measured:
//   - a VALUE parameter whose type happens to be spelled like its own name was admitted as a binder;
//   - a kinded header parameter `T: Kind` survived only by accident, because the parse mints the kinded
//     form's type expression as a SELF-NAMING leaf (v1.compiler.parse parse_type_param_after_name,
//     leaf_type_node(name: r.name)) carrying the kind as a property -- so name==text held for it too,
//     which is why the filter never actually dropped kinded parameters, an assumption corrected in
//     msg_7b15f245. The filter was deleted under DESIGN.md 3c as a spelling test standing in for a
//     declaration, not because it was losing parameters.
// The marker is read as a property rather than carried on a dedicated Node field because properties are
// the channel this tree already uses for parse-recorded facts about a parameter (the kind rides the same
// way), and they survive resolve: every rebuild on the resolve path copies `properties`.
fn fn_type_param_names(item: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  item.params |> filter(p =>
    // find_property already UNWRAPS the field-init: it returns field_init_node_value, the value node
    // itself (v1.std.core find_property -> n.children |> first). So the literal is read off the value
    // node's OWN expr_data, not off a child of it -- matching a child would answer Absent for every
    // parameter and silently empty the roster.
    match find_property(props: p.properties, prop_name: type_param_declaration_form_property_name(), source_indices: source_indices) {
      Absent => false
      Present { value: v } => match v.expr_data {
        ExprLiteral { value: LitBool { value: b } } => b
        _ => false
      }
    }
  ) |> map(p => param_node_name_at(n: p, source_indices: source_indices))
}

fn first_duplicate_type_param_name(names: List<String>) -> String? {
  names |> enumerate |> filter(pair => names |> skip(pair.first + 1) |> any(other => other == pair.second)) |> map(pair => pair.second) |> first
}

// A DECLARATION FIELD'S TYPE REFERENCE RECORDS THE DECLARATION RESOLVE BOUND IT TO. The parser
// (v1.compiler.parse field_to_child_node) stores the authored reference as the field's `inferred`.
// resolve_item_types resolved that reference and kept only its properties, so the typed tree's
// field reference named no declaration and every consumer re-derived one by spelling in its own
// scope (gunbc.recurring_failure_mode resolved_value_computed_then_discarded_for_the_authored_one).
// IDENTITY GOES ON Node.declaration, NEVER ON `inferred`. Measured: writing the declaration into the
// reference's `inferred` slot broke the generation-2 compiler (derives vanished; rustc E0369 and
// E0373), because consumers read `inferred` as the resolved STRUCTURE and chased it into the
// declaration body. Identity and structure are two facts, so they have two slots
// (neat-boar-16 ruling, 2026-09-29).
// The identity is the resolver's own ident-keyed binding (lookup_type_for) in the item's scope, the
// scope the reference was authored in, minted by v1.compiler.infer_env
// declaration_ref_of_declaration_node from that DECLARATION node. It never goes through the
// reference-side joins it is built to replace. A kernel spelling names no corpus declaration and is
// left as authored.
fn field_inferred_with_declaration(field: Node, binders: List<String>, env: TypeEnv) -> InferredNode? {
  match field.inferred {
    Present { value: Resolved { node: authored } } => Present { value: Resolved { node: stamp_collections_in_reference(n: reference_tree_with_declaration(n: authored, binders: binders, env: env), source_indices: env.source_indices) } }
    _ => field.inferred
  }
}

// THE WHOLE REFERENCE, NOT ONLY ITS HEAD. A field's type reference has references beneath it -- its
// type arguments, and for a function type its parameter types and its return -- and each of them is
// a position the Rust emitter reads on its own (v1.compiler.infer_emit_info resolve_type_decl_routed).
// Stamping only the head left `decide: fn(AccessRequest<S, A, O, C, E>) -> AccessDecision` with an
// unstamped AccessRequest, in a closure where two modules declare that leaf. The walk visits the
// positions binder_marked_type visits, and for the same reason: they are the type positions of the
// reference. It writes nothing but Node.declaration, through the one writer.
// THREE THINGS IT DOES NOT WALK INTO. A reference to one of the item's own type parameters is a
// binder (binder_marked_type marks it), so it is left for that walk rather than stamped with a
// same-named declaration from elsewhere in the corpus. A DECLARATION node's children are its fields
// or variants, not type arguments, and it already carries its declaring span. A kernel spelling
// names no corpus declaration.
// A SIGNATURE'S PARAMETER TYPES AND ITS RETURN ARE THE SAME POSITIONS on a function item
// (resolve_item_types): std.authorization_profile's generic fns return AccessRequest<..>, and their
// signature references were unstamped until this walk reached them.
// A FIELD'S TYPE REFERENCE CARRIES THE USE-SITE STAMP OF EVERY COLLECTION BENEATH IT. A field typed
// `Optional<List<T>>` reaches the emitter as the authored reference; the container arm of
// resolve_node_bounded stamps a collection's use site only where it resolves one, and a field's
// authored reference never passes through it, so the nested List stayed unresolved and the seed Rust
// emit read it as `()`. This writes nothing but `inferred` on a collection that has none, through
// stamp_kernel_collection, the one writer the resolve arm uses, and walks arguments and the
// reference a carrier argument holds in `inferred`.
fn stamp_collections_in_reference(n: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  if n.children |> count == 0 {
    n
  } else {
    let children = map(n.children, c => stamp_collections_in_reference(n: c, source_indices: source_indices))
    let inferred = match n.inferred {
      Present { value: Resolved { node: t } } => Present { value: Resolved { node: stamp_collections_in_reference(n: t, source_indices: source_indices) } }
      _ => n.inferred
    }
    let walked = node_with_children_params_inferred(n: n, children: children, params: n.params, inferred: inferred)
    if n.inferred == none && node_is_collection(n: n, source_indices: source_indices) {
      stamp_kernel_collection(n: walked)
    } else {
      walked
    }
  }
}

fn field_children_with_stamped_type(field: Node, source_indices: Map<String, NewlineIndex>) -> List<Node> {
  match field.children |> first {
    Present { value: te } => concat([stamp_collections_in_reference(n: te, source_indices: source_indices)], field.children |> skip(1))
    Absent => field.children
  }
}

fn reference_tree_with_declaration(n: Node, binders: List<String>, env: TypeEnv) -> Node {
  let name = authored_name(env: env, node: n)
  let is_binder_reference = n.children |> count == 0 && n.params |> count == 0 && binders |> any(b => b == name)
  let is_declaration = match n.module_item_kind { ModuleItemTypeDeclaration => true  _ => false }
  if is_binder_reference || is_declaration || is_kernel_type(name: name) {
    n
  } else {
    let is_arrow = match n.connective { Arrow => true  _ => false }
    let children = map(n.children, c => reference_argument_with_declaration(argument: c, binders: binders, env: env))
    let params = if is_arrow { map(n.params, p => reference_param_with_declaration(param: p, binders: binders, env: env)) } else { n.params }
    let inferred = if is_arrow { reference_inferred_with_declaration(inferred: n.inferred, binders: binders, env: env) } else { n.inferred }
    reference_with_declaration(n: node_with_children_params_inferred(n: n, children: children, params: params, inferred: inferred), env: env)
  }
}

fn reference_inferred_with_declaration(inferred: InferredNode?, binders: List<String>, env: TypeEnv) -> InferredNode? {
  match inferred {
    Present { value: Resolved { node: t } } => Present { value: Resolved { node: reference_tree_with_declaration(n: t, binders: binders, env: env) } }
    _ => inferred
  }
}

// A type argument is either the reference itself or a carrier whose `inferred` holds it
// (v1.compiler.infer_types child_type_node reads it that way); an arrow argument denotes itself and
// its `inferred` is its return, which the tree walk already covers.
fn reference_argument_with_declaration(argument: Node, binders: List<String>, env: TypeEnv) -> Node {
  let is_arrow = match argument.connective { Arrow => true  _ => false }
  if is_arrow {
    reference_tree_with_declaration(n: argument, binders: binders, env: env)
  } else {
    reference_tree_with_declaration(
      n: node_with_children_params_inferred(n: argument, children: argument.children, params: argument.params, inferred: reference_inferred_with_declaration(inferred: argument.inferred, binders: binders, env: env)),
      binders: binders,
      env: env)
  }
}

fn reference_param_with_declaration(param: Node, binders: List<String>, env: TypeEnv) -> Node {
  match param.children |> first {
    Present { value: te } =>
      node_with_children_params_inferred(
        n: param,
        children: concat([reference_tree_with_declaration(n: te, binders: binders, env: env)], param.children |> skip(1)),
        params: param.params,
        inferred: param.inferred
      )
    Absent => param
  }
}

// THE ONE WRITER OF Node.declaration. Resolve's own ident-keyed binding (lookup_type_for) in the
// scope the reference is resolved in, minted by v1.compiler.infer_env
// declaration_ref_of_declaration_node from that DECLARATION node, never through the reference-side
// joins it replaces. It changes nothing but the identity slot. A kernel spelling names
// no corpus declaration and is returned as authored, and so is a reference with no binding.
fn reference_with_declaration(n: Node, env: TypeEnv) -> Node {
  if n.declaration != none || is_kernel_type(name: authored_name(env: env, node: n)) {
    n
  } else {
    match lookup_type_for(env: env, node: n) {
      Present { value: bound } =>
        match declaration_ref_of_declaration_node(decl: bound, source_indices: env.source_indices, env: env) {
          Present { value: d } => node_with_declaration(n: n, declaration: d)
          Absent => n
        }
      Absent => n
    }
  }
}

fn node_with_declaration(n: Node, declaration: DeclarationRef) -> Node {
  Node { occurrence_identity: n.occurrence_identity, name: n.name, span: n.span, ident_span: n.ident_span, children: n.children, connective: n.connective, params: n.params, inferred: n.inferred, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: Present { value: declaration }, expr_data: n.expr_data }
}

// A REFERENCE TO ONE OF THIS ITEM'S OWN TYPE PARAMETERS NAMES A BINDER, identified as
// (owner, TypeParameter { name }) on std.decl_ref DeclarationRef (quiet-gull-780 ruling, cause 3).
// The owner is the item whose header binds the name. A nested item is resolved first and marks its
// own binders, and a node that already carries an identity is never re-marked, so the NEAREST
// enclosing header wins. These walks touch only Node.declaration, and they visit the positions
// v1.tests.claim.carrier_realization_census reads: declaration fields, signature parameter types,
// the return, the type arguments beneath them, and an arrow's parameter and return positions.
fn binder_marked_type(n: Node, owner: DeclarationRef, binders: List<String>, source_indices: Map<String, NewlineIndex>) -> Node {
  let name = authored_name_at(source_indices: source_indices, node: n)
  let is_binder_reference = n.declaration == none
    && n.children |> count == 0
    && n.params |> count == 0
    && binders |> any(b => b == name)
  if is_binder_reference {
    node_with_declaration(n: n, declaration: decl_type_parameter_ref(module_path: owner.module_path as String, decl_name: owner.decl_name as String, parameter: name))
  } else {
    let is_arrow = match n.connective { Arrow => true  _ => false }
    let children = map(n.children, c => binder_marked_type(n: c, owner: owner, binders: binders, source_indices: source_indices))
    let params = if is_arrow { map(n.params, p => binder_marked_param(param: p, owner: owner, binders: binders, source_indices: source_indices)) } else { n.params }
    let inferred = if is_arrow { binder_marked_inferred(inferred: n.inferred, owner: owner, binders: binders, source_indices: source_indices) } else { n.inferred }
    node_with_children_params_inferred(n: n, children: children, params: params, inferred: inferred)
  }
}

fn binder_marked_inferred(inferred: InferredNode?, owner: DeclarationRef, binders: List<String>, source_indices: Map<String, NewlineIndex>) -> InferredNode? {
  match inferred {
    Present { value: Resolved { node: t } } => Present { value: Resolved { node: binder_marked_type(n: t, owner: owner, binders: binders, source_indices: source_indices) } }
    _ => inferred
  }
}

fn binder_marked_param(param: Node, owner: DeclarationRef, binders: List<String>, source_indices: Map<String, NewlineIndex>) -> Node {
  match param.children |> first {
    Present { value: te } =>
      node_with_children_params_inferred(
        n: param,
        children: concat([binder_marked_type(n: te, owner: owner, binders: binders, source_indices: source_indices)], param.children |> skip(1)),
        params: param.params,
        inferred: param.inferred
      )
    Absent => param
  }
}

// A field of a product carries its type reference in `inferred`; a coproduct variant carries fields.
fn binder_marked_member(member: Node, owner: DeclarationRef, binders: List<String>, source_indices: Map<String, NewlineIndex>) -> Node {
  // A member's FIRST child is its type expression (`value: Width<T>`), and the kind wall judges the
  // argument nodes inside that expression. The walker used to recurse through members without ever
  // consulting binder_marked_type, so a binder reference standing in a member's type position carried
  // no identity: measured, the four rows that fell through to the inhabitants arm (std.measure:269
  // MeasureSubtraction<Q, S>, std.realization_schedule:79-80 CostTimeAxis<S>) and the matching-kind
  // positive witness are all member type positions. One rule, no special case per site: wherever a
  // type expression stands, the type walker stamps it. Recursing the remaining children happens in
  // both arms now; the old leaf shortcut only saved a rebuild, and every stamping helper here is an
  // identity-preserving node_with_* rebuild, so the extra descent adds no behaviour beyond identity.
  let marked_children = match member.children |> first {
    Present { value: te } =>
      concat([binder_marked_type(n: te, owner: owner, binders: binders, source_indices: source_indices)], map(member.children |> skip(1), f => binder_marked_member(member: f, owner: owner, binders: binders, source_indices: source_indices)))
    Absent => map(member.children, f => binder_marked_member(member: f, owner: owner, binders: binders, source_indices: source_indices))
  }
  node_with_children_params_inferred(n: member, children: marked_children, params: member.params, inferred: binder_marked_inferred(inferred: member.inferred, owner: owner, binders: binders, source_indices: source_indices))
}

// THE ONE MARKING PASS, run by resolve_item_types BEFORE it resolves anything, over the positions
// that item's OWN header owns: its parameters, its return, its members, its body, its type
// annotation. Every item kind that declares binders is covered by this single walk -- fn, record,
// alias, coproduct -- so no per-kind copy of the stamping exists anywhere (the pass it replaces
// reached fn params/return and Conj/Disj members only, which is why an alias-style declaration was
// never stamped at all). It is SHALLOW on purpose: a nested item keeps its own positions to itself,
// because resolve_item_types is called on it separately and marks its own binders. binder_marked_type
// never re-marks a node that already carries an identity, so the NEAREST enclosing header wins.
fn binder_marked_item(item: Node, owner: DeclarationRef, binders: List<String>, source_indices: Map<String, NewlineIndex>) -> Node {
  let marked_params = map(item.params, p => binder_marked_param(param: p, owner: owner, binders: binders, source_indices: source_indices))
  let marked_children = if (item.connective == Conj || item.connective == Disj) && item.transport == none {
    map(item.children, c => binder_marked_member(member: c, owner: owner, binders: binders, source_indices: source_indices))
  } else {
    map(item.children, c => binder_marked_body_expr(n: c, owner: owner, binders: binders, source_indices: source_indices))
  }
  let marked_body = match item.body {
    Present { value: body } => Present { value: binder_marked_body_expr(n: body, owner: owner, binders: binders, source_indices: source_indices) }
    Absent => none
  }
  let marked_anno = match item.type_annotation {
    Present { value: anno } => Present { value: binder_marked_type(n: anno, owner: owner, binders: binders, source_indices: source_indices) }
    Absent => none
  }
  Node {
    occurrence_identity: item.occurrence_identity, name: item.name, span: item.span,
    ident_span: item.ident_span,
    children: marked_children, connective: item.connective, params: marked_params,
    inferred: binder_marked_inferred(inferred: item.inferred, owner: owner, binders: binders, source_indices: source_indices),
    return_cardinality: item.return_cardinality, uses: item.uses, body: marked_body,
    transport: item.transport, properties: item.properties, type_annotation: marked_anno,
    is_self_recursive: item.is_self_recursive, has_non_tail_self_call: item.has_non_tail_self_call,
    match_pattern: item.match_pattern, module_item_kind: item.module_item_kind,
    declaration_marker: item.declaration_marker, declaration: item.declaration, expr_data: item.expr_data
  }
}

// The expression-level descent of binder_marked_item. A node that IS a declaration (module_item_kind
// is set) is returned untouched -- its own resolve_item_types pass marks its binders, which is what
// stops an inner `fn f<T>` from borrowing the enclosing item's T. Everything else is a type-bearing
// position, so its `inferred` is stamped through binder_marked_type.
fn binder_marked_body_expr(n: Node, owner: DeclarationRef, binders: List<String>, source_indices: Map<String, NewlineIndex>) -> Node {
  if n.module_item_kind != NotAModuleItem {
    n
  } else {
    node_with_children_params_inferred(
      n: n,
      children: map(n.children, c => binder_marked_body_expr(n: c, owner: owner, binders: binders, source_indices: source_indices)),
      params: n.params,
      inferred: binder_marked_inferred(inferred: n.inferred, owner: owner, binders: binders, source_indices: source_indices)
    )
  }
}

fn node_with_children_params_inferred(n: Node, children: List<Node>, params: List<Node>, inferred: InferredNode?) -> Node {
  Node { occurrence_identity: n.occurrence_identity, name: n.name, span: n.span, ident_span: n.ident_span, children: children, connective: n.connective, params: params, inferred: inferred, return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, module_item_kind: n.module_item_kind, declaration_marker: n.declaration_marker, declaration: n.declaration, expr_data: n.expr_data }
}

// THE ROSTER, IN ONE PLACE. The hoisted pass below and resolve_item_types must agree on which
// parameters a declaration binds, or the same node would be stamped by one and not the other. Both
// declaration forms are covered: fn and type headers are minted by one parse function and carry the
// parse-recorded declaration-form marker (v1.compiler.parse
// with_type_param_declaration_form_property), while a generic declaration's own `params` ARE its binder
// list -- which is why that branch takes every parameter, and why the kernel's type nodes (which all
// carry params: []) contribute nothing either way.
fn item_type_param_names(item: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  if item.connective != NoConnective && item.transport == none {
    item.params |> map(p => generic_param_name_at(n: p, source_indices: source_indices))
  } else {
    fn_type_param_names(item: item, source_indices: source_indices)
  }
}

// ONE MARKING PASS FOR ONE FACT, reached from both ends: the hoist in v1.compiler.infer
// typecheck_module (BEFORE the environment build, which is where the kind wall judges a signature) and
// resolve_item_types below.
//
// THE ORDERING IS THE DEFECT THIS EXISTS FOR. The identity a forwarded type parameter needs is written
// by this cluster, and the environment build READS it: a generic application in a signature -- fn
// measure_sub<Q: Quantity, S: Scale>(a: Measure<Q, S, Nat>, ...) -- fires the kind wall there, and the
// wall asks what the argument's declaration IS. While this pass ran only inside resolve_item_types,
// whose sole caller is analyze_item, the wall was judged before any identity existed; the argument fell
// through to the name-keyed inhabitant list and was refused, and because that refusal is error-severity,
// typecheck_module took its AbandonedBeforeItems exit, returned items: [], and analyze_item never ran at
// all -- the refusal destroyed the pass that would have justified it. Measured: PASS_ROWS=0 for
// std.measure while the same class printed 30 rows for std.realization_measurement, and std.measure's
// callables never reached the effect registry. Manager ruling msg_38fd5b61: mark before resolution; do
// NOT move the wall after the marking pass, which would keep the ordering dependence and only change
// where it bites.
//
// IDEMPOTENT, so being called twice yields one fact rather than two registries: binder_marked_type
// stamps only where `n.declaration == none`, and every rebuild on the resolve path copies
// `declaration`, so the second visit finds the carrier present and changes nothing. DESIGN.md 3 forbids
// a second name for one concept; a stamped node is its own evidence that the pass already ran.
fn binder_marked_module_item(item: Node, module_name: String, source_indices: Map<String, NewlineIndex>, inherited_owner: DeclarationRef?, inherited_binders: List<String>) -> Node {
  // ONE RULE, applied at every re-entry: the binder scope is the DECLARATION THAT OWNS THE HEADER, and a
  // variant is not a binder scope. parse already says so -- variant_to_child_node mints each variant with
  // params: [] (v1.compiler.parse, 02_parse.dag:2880), so a variant declares no parameters of its own and
  // must be walked under its enclosing declaration's binders and owner. Recomputing the roster from the
  // child's own params returned [] for a variant (the generic branch maps params: [] and the fn branch
  // finds no marked header), so no binder reference inside a variant's member types was ever stamped:
  // measured, all four rows that fall through to the inhabitant-list refusal are exactly those positions.
  let owner = match inherited_owner { Present { value: o } => o  Absent => decl_ref(module_path: module_name, decl_name: authored_name_at(source_indices: source_indices, node: item)) }
  // An EMPTY inherited list means nothing was inherited (a top-level item), so the item's own header is the
  // scope; a non-empty one means this item is being walked inside a declaration that owns the header.
  let binders = if (inherited_binders |> count) > 0 { inherited_binders } else { item_type_param_names(item: item, source_indices: source_indices) }
  let marked = binder_marked_item(item: item, owner: owner, binders: binders, source_indices: source_indices)
  // A coproduct's variants are items in their own right -- resolve_item_types maps them through itself
  // -- so the hoist re-enters each one, UNDER THE OWNER THAT DECLARES THE HEADERS. A record's children
  // are MEMBERS, which binder_marked_item already walks, so they are not re-entered.
  // The `&& item.transport == none` conjunct is not a second condition of substance here: bare
  // `if item.connective == Disj {` does not parse, because `Disj {` reads as a data literal. The
  // conjunct is the guard this file already uses for the same test (see the Disj arm of
  // resolve_item_types), and a marked variant with a transport is not a thing this pass is asked about.
  if item.connective == Disj && item.transport == none {
    node_with_children_params_inferred(
      n: marked,
      children: map(marked.children, c => binder_marked_module_item(item: c, module_name: module_name, source_indices: source_indices, inherited_owner: Present { value: owner }, inherited_binders: binders)),
      params: marked.params,
      inferred: marked.inferred
    )
  } else {
    marked
  }
}

fn resolve_item_types(item: Node, env: TypeEnv, module_name: String, inherited_owner: DeclarationRef?, inherited_binders: List<String>) -> ItemResolveResult {
  // THE SAME RULE AS THE MARKING PASS, ONE RULE NOT TWO FIXES: binder scope is the declaration that owns
  // the header, and a variant is not a binder scope (parse mints it with params: []). A nested item that
  // declares its own header keeps its own scope; one that declares none is walked under the enclosing
  // declaration's binders and owner.
  let declares_own_header = (inherited_binders |> count) == 0 || (item.params |> count) > 0
  let tp_names = if declares_own_header { item_type_param_names(item: item, source_indices: env.source_indices) } else { inherited_binders }
  let owner = match inherited_owner { Present { value: o } => if declares_own_header { decl_ref(module_path: module_name, decl_name: authored_name(env: env, node: item)) } else { o }  Absent => decl_ref(module_path: module_name, decl_name: authored_name(env: env, node: item)) }
  // ONE MARKING PASS, FIRST, FOR EVERY ITEM KIND THAT DECLARES BINDERS. Measured on the real corpus,
  // the old stamping ran AFTER the nested resolves below (params, inferred, uses, body, annotation,
  // transport, properties, children) and the kind wall fires INSIDE those resolves, so it judged
  // nodes that carried no identity yet: 2264/2264 wall arguments had arg_decl=None, and an alias-style
  // `type Measure<Q, S, M> = ...` produced ZERO stamps at all, because the pass covered only fn
  // params/return (is_function_item) and Conj/Disj members. ORDER plus COVERAGE, one defect. So the
  // identity goes on the authored occurrence before anything is resolved, from this item's own header.
  let item_marked = binder_marked_item(item: item, owner: owner, binders: tp_names, source_indices: env.source_indices)
  let collision_diags = match first_duplicate_type_param_name(names: tp_names) {
    Present { value: dup } =>
      [make_error_node(diagnostic: InternalError { message: concat(concat(concat("the name '", dup), concat("' is bound twice in the header of '", authored_name_at(source_indices: env.source_indices, node: item))), "': either a type parameter is repeated (`type Pair<T, T>`), or a value parameter shares a type parameter's name (`fn f<T>(T: T)`). A type parameter's identity is (owner, name), so one header may bind a name once. Rename one of them."), span: item.span }, module_name: module_name)]
    Absent => []
  }
  // MEASURED, this local binder never reaches the kind wall: fn_type_param_names admits only a header
  // parameter whose type expression is its own bare name, so a typed parameter such as
  // `left: Measure<Q, S, M>` contributes nothing here and the wall reads the module-env binder
  // instead. Passing Absent therefore keeps that binder identity-free rather than minting a reference
  // from a name that does not own it; the owner-named route is census_declaration_type_env.
  let env = env_with_type_variable_bindings(env: env, tp_names: tp_names)
  let param_results = map(item_marked.params, p => resolve_param(param: p, env: env, module_name: module_name))
  let resolved_params = map(param_results, pr => pr.param)
  let param_diags = flat_map(param_results, pr => pr.diagnostics)

  let ret_result = if is_parametric_type_alias_decl(item: item) {
    match item_marked.inferred {
      Present { value: Resolved { node: authored_rhs } } => resolve_nominal_alias_rhs(n: authored_rhs, env: env, module_name: module_name)
      _ => resolve_optional_node(n: item_marked.inferred, env: env, module_name: module_name)
    }
  } else {
    resolve_optional_node(n: item_marked.inferred, env: env, module_name: module_name)
  }
  let ret_resolved = ret_result.resolved
  let ret_diags = ret_result.diagnostics
  let resolved_ret = if item_marked.inferred == none { none } else { Present { value: Resolved { node: ret_resolved } } }

  let use_results = map(item.uses, u => resolve_resource_use(ru: u, env: env, module_name: module_name))
  let resolved_uses = map(use_results, ur => ur.resource_use)
  let use_diags = flat_map(use_results, ur => ur.diagnostics)

  let body_resolved = if item_marked.body == none {
    ExprResolveResult { expr: item_marked, diagnostics: [] }
  } else {
    resolve_expr_types(texpr: item_marked.body.value, env: env, module_name: module_name)
  }
  let resolved_body = if item.body == none { none } else { Present { value: body_resolved.expr } }
  let body_diags = if item.body == none { [] } else { body_resolved.diagnostics }

  let anno_resolved = if item_marked.type_annotation == none {
    NodeResolveResult { resolved: unit_type, diagnostics: [] }
  } else {
    resolve_node(n: item_marked.type_annotation.value, env: env, module_name: module_name)
  }
  let resolved_anno = if item_marked.type_annotation == none { none } else { Present { value: anno_resolved.resolved } }
  let anno_diags = anno_resolved.diagnostics

  let transport_resolved = if item.transport == none {
    TransportResolveResult { transport: local_transport_node(occurrence_identity: OccurrenceSynthetic, span: no_span()), diagnostics: [] }
  } else {
    resolve_transport_binding(transport: item.transport.value, env: env, module_name: module_name)
  }
  let resolved_transport = if item.transport == none { none } else { Present { value: transport_resolved.transport } }
  let transport_diags = transport_resolved.diagnostics

  let prop_results = map(item.properties, p => resolve_field_init(field_init: p, env: env, module_name: module_name))
  let resolved_props = map(prop_results, pr => pr.field_init)
  let prop_diags = flat_map(prop_results, pr => pr.diagnostics)

  let child_results = if item.connective == Conj && item.transport == none {
    item_marked.children |> map(child =>
      let authored_type = field_node_type_expr(n: child)
      let tr = resolve_node(n: authored_type, env: env, module_name: module_name)
      let type_diags = concat(tr.diagnostics, missing_generic_args_diagnostics(n: authored_type, env: env, module_name: module_name))
      ItemResolveResult {
        item: Node { occurrence_identity: child.occurrence_identity, name: child.name, span: child.span, ident_span: child.ident_span, children: field_children_with_stamped_type(field: child, source_indices: env.source_indices), connective: child.connective, params: child.params, inferred: field_inferred_with_declaration(field: child, binders: tp_names, env: env), return_cardinality: child.return_cardinality, uses: child.uses, body: child.body, transport: child.transport, properties: concat(child.properties, tr.resolved.properties), type_annotation: child.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: child.module_item_kind, declaration_marker: child.declaration_marker, declaration: child.declaration, expr_data: NoExprData },
        diagnostics: type_diags
      }
    )
  } else if item.connective == Disj && item.transport == none {
    // item_marked, not item: the binder identity lives on the marked children (binder_marked_item
    // stamped them before any nested resolve ran), and reading the raw ones threw that away -- the
    // four rows that fell through to the inhabitant-list refusal were Disj member type positions.
    item_marked.children |> map(variant =>
      let field_results = variant.children |> map(field =>
        let authored_type = field_node_type_expr(n: field)
        let tr = resolve_node(n: authored_type, env: env, module_name: module_name)
        let type_diags = concat(tr.diagnostics, missing_generic_args_diagnostics(n: authored_type, env: env, module_name: module_name))
        ItemResolveResult {
          item: Node { occurrence_identity: field.occurrence_identity, name: field.name, span: field.span, ident_span: field.ident_span, children: field_children_with_stamped_type(field: field, source_indices: env.source_indices), connective: field.connective, params: field.params, inferred: field_inferred_with_declaration(field: field, binders: tp_names, env: env), return_cardinality: field.return_cardinality, uses: field.uses, body: field.body, transport: field.transport, properties: concat(field.properties, tr.resolved.properties), type_annotation: field.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: field.module_item_kind, declaration_marker: field.declaration_marker, declaration: field.declaration, expr_data: NoExprData },
          diagnostics: type_diags
        }
      )
      let resolved_fields = map(field_results, fr => fr.item)
      let field_diags = flat_map(field_results, fr => fr.diagnostics)
      ItemResolveResult {
        item: Node { occurrence_identity: variant.occurrence_identity, name: variant.name, span: variant.span, ident_span: variant.ident_span, children: resolved_fields, connective: variant.connective, params: variant.params, inferred: variant.inferred, return_cardinality: variant.return_cardinality, uses: variant.uses, body: variant.body, transport: variant.transport, properties: variant.properties, type_annotation: variant.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: variant.module_item_kind, declaration_marker: variant.declaration_marker, declaration: variant.declaration, expr_data: NoExprData },
        diagnostics: field_diags
      }
    )
  } else {
    map(item_marked.children, child => resolve_item_types(item: child, env: env, module_name: module_name, inherited_owner: Present { value: owner }, inherited_binders: tp_names))
  }
  let child_diags = flat_map(child_results, cr => cr.diagnostics)
  // The post-hoc binder_marked_member / binder_marked_param / binder_marked_inferred layers this line
  // replaces are DELETED, per DESIGN.md 4b ("a climb deletes the lower-rung production machinery it
  // obsoletes"): binder_marked_item marked these same positions before the nested resolves ran, and
  // every rebuild on this path copies `declaration: n.declaration`, so the identity is already on the
  // resolved node. The reference_* pass below is NOT part of that machinery: it installs the scope
  // declaration of a NON-binder reference (reference_with_declaration), a different fact, and it
  // leaves an already-marked node alone.
  let resolved_children = map(child_results, cr => cr.item)
  let is_function_item = match item.module_item_kind { ModuleItemFunction => true  _ => false }
  let stamped_params = if is_function_item { map(resolved_params, p => reference_param_with_declaration(param: p, binders: tp_names, env: env)) } else { resolved_params }
  let stamped_ret = if is_function_item { reference_inferred_with_declaration(inferred: resolved_ret, binders: tp_names, env: env) } else { resolved_ret }

  ItemResolveResult {
    item: Node {
      occurrence_identity: OccurrenceSynthetic, name: item.name, span: item.span, ident_span: item.ident_span, children: resolved_children,
      params: stamped_params, inferred: stamped_ret,
      return_cardinality: item.return_cardinality,
      uses: resolved_uses, body: resolved_body,
      connective: item.connective, transport: resolved_transport,
      properties: resolved_props, type_annotation: resolved_anno,
      is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: item.module_item_kind, declaration_marker: item.declaration_marker, declaration: item.declaration, expr_data: NoExprData
    },
    diagnostics: concat(collision_diags, param_diags, ret_diags, use_diags, body_diags, anno_diags, transport_diags, prop_diags, child_diags)
  }
}
