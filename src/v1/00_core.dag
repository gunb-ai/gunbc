  find_property(props: n.properties, prop_name: "svc_auth_source", source_indices: source_indices)
}

fn module_node(name: String, imports: List<Node>, items: List<Node>, span: SourceSpan) -> Node {
  Node {
    name: name, span: span, ident_span: default_ident_span(name: name, span: span), children: items, connective: NoConnective,

    params: imports, inferred: none, return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [],
    type_annotation: none, is_self_recursive: false,
    has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
  }
}

fn import_node(module_path: String, is_all: Bool, specific_names: List<Node>, span: SourceSpan, name_span: SourceSpan) -> Node {
  let wildcard_marker = if is_all {
    Present { value: Node { name: "", span: span, ident_span: none, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData } }
  } else { none }
  Node {
    name: module_path, span: span, ident_span: Present { value: name_span }, children: specific_names, connective: NoConnective,

    params: [], inferred: none, return_cardinality: Required,
    uses: [], body: wildcard_marker, transport: none, properties: [],
    type_annotation: none, is_self_recursive: false,
    has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
  }
}

fn import_is_all(n: Node) -> Bool {
  n.body != none
}

fn import_specific_names_at(n: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  n.children |> map(c => authored_name_at(source_indices: source_indices, node: c))
}

fn module_imports(n: Node) -> List<Node> {
  n.params
}

fn module_items(n: Node) -> List<Node> {
  n.children
}

fn leaf_node_with_span(name: String, span: SourceSpan) -> Node {
  Node { name: name, span: span, ident_span: default_ident_span(name: name, span: span), children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
}

fn kernel_span(name: String) -> SourceSpan {
  SourceSpan { file: concat("<kernel:", name, ">"), start: 0, end: string_length(s: name) }
}

data unit_type: Node = Node { name: "Unit", span: kernel_span(name: "Unit"), ident_span: Present { value: kernel_span(name: "Unit") }, children: [], connective: Conj, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data bool_type: Node = Node { name: "Bool", span: kernel_span(name: "Bool"), ident_span: Present { value: kernel_span(name: "Bool") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data string_type: Node = Node { name: "String", span: kernel_span(name: "String"), ident_span: Present { value: kernel_span(name: "String") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data hash_type: Node = Node { name: "Hash", span: kernel_span(name: "Hash"), ident_span: Present { value: kernel_span(name: "Hash") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data int_type: Node = Node { name: "Int", span: kernel_span(name: "Int"), ident_span: Present { value: kernel_span(name: "Int") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data float_type: Node = Node { name: "Float", span: kernel_span(name: "Float"), ident_span: Present { value: kernel_span(name: "Float") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data none_type: Node = Node { name: "None", span: kernel_span(name: "None"), ident_span: Present { value: kernel_span(name: "None") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data tuple_type_name: String = "Tuple"
data error_type: Node = Node { name: "", span: make_span(start: 0, end: 0), ident_span: none, children: [], connective: NoConnective, params: [], inferred: Present { value: CompilerError { message: "unresolved type", span: make_span(start: 0, end: 0) } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: ExprError { kind: SemanticExprError, message: "unresolved type" } }

fn make_span(start: Int, end: Int) -> SourceSpan {
  SourceSpan { file: "<synthetic>", start: start, end: end }
}

fn make_file_span(file: String, start: Int, end: Int) -> SourceSpan {
  SourceSpan { file: file, start: start, end: end }
}

fn no_span() -> SourceSpan {
  make_span(start: 0, end: 0)
}

type LineCol {
  line: Int
  col: Int
}

type NewlineIndex {
  file: String
  offsets: List<Int>
  char_codes: List<Int>
}

fn build_newline_index(file: String, source: String) -> NewlineIndex {
  let char_codes = source |> chars
  let offsets = char_codes |> enumerate |> fold(init: [], f: (acc, pair) =>
    if pair.second == 10 { list_push(acc, pair.first) } else { acc }
  )
  NewlineIndex { file: file, offsets: offsets, char_codes: char_codes }
}

fn byte_to_line_col(index: NewlineIndex, offset: Int) -> LineCol {
  let clamped = if offset < 0 { 0 } else { offset }
  let line = (index.offsets |> filter(o => o < clamped) |> count) + 1
  let line_start = if line <= 1 { 0 }
    else {
      match index.offsets |> skip(line - 2) |> first {
        Present { value: o } => o + 1
        Absent => 0
      }
    }
  let col = clamped - line_start + 1
  LineCol { line: line, col: col }
}

fn source_line_at(index: NewlineIndex, line: Int) -> String {
  let src_len = count(index.char_codes)
  let line_start = if line <= 1 { 0 }
    else {
      match index.offsets |> skip(line - 2) |> first {
        Present { value: o } => o + 1
        Absent => src_len
      }
    }
  let line_end = match index.offsets |> skip(line - 1) |> first {
    Present { value: o } => o
    Absent => src_len
  }
  chars_to_string(chars: index.char_codes, start: line_start, end: line_end)
}

fn source_text_at(index: NewlineIndex, span: SourceSpan) -> String {
  chars_to_string(chars: index.char_codes, start: span.start, end: span.end)
}

type InternTable {
  strings: List<String>
  index: Map<String, Int>
  next_id: Int
  authored_token_ordinals: AuthoredTokenOrdinalSpace
}

type InternResult {
  table: InternTable
  id: Int
}

fn empty_intern_table() -> InternTable {
  InternTable {
    strings: [""],
    index: map_insert(empty_map(), "", 0),
    next_id: 1,
    authored_token_ordinals: authored_token_ordinal_space_initial(),
  }
}

fn intern_table_with_authored_token_ordinals(
  table: InternTable,
  authored_token_ordinals: AuthoredTokenOrdinalSpace
) -> InternTable {
  InternTable {
    strings: table.strings,
    index: table.index,
    next_id: table.next_id,
    authored_token_ordinals: authored_token_ordinals,
  }
}

fn intern(table: InternTable, s: String) -> InternResult {
  match map_get(table.index, s) {
    Present { value: id } => InternResult { table: table, id: id }
    Absent =>
      let id = table.next_id
      InternResult {
        table: InternTable {
          strings: list_push(table.strings, s),
          index: map_insert(table.index, s, id),
          next_id: id + 1,
          authored_token_ordinals: table.authored_token_ordinals,
        },
        id: id
      }
  }
}

fn intern_str(table: InternTable, id: Int) -> String {
  match table.strings |> get(id) {
    Present { value: s } => s
    Absent => ""
  }
}

fn intern_find(table: InternTable, s: String) -> Int? {
  match map_get(table.index, s) {
    Present { value: id } => Present { value: id }
    Absent => none
  }
}

fn intern_find_or_empty(table: InternTable, s: String) -> Int {
  match map_get(table.index, s) {
    Present { value: id } => id
    Absent => 0
  }
}

fn merge_intern_tables(tables: List<InternTable>) -> InternTable {
  tables |> fold(init: empty_intern_table(), f: (merged, t) =>
    let merged_allocator = occurrence_id_allocator_advance_to(
      alloc: merged.authored_token_ordinals.allocator,
      min_next: t.authored_token_ordinals
    )
    let merged = intern_table_with_authored_token_ordinals(
      table: merged,
      authored_token_ordinals: authored_token_ordinal_space_from_allocator(
        alloc: merged_allocator
      )
    )
    t.strings |> fold(init: merged, f: (m, s) =>
      if s == "" { m } else { intern(table: m, s: s).table }
    )
  )
}

fn is_internable_token(shape: TokenShape) -> Bool {
  match shape { ShIdent => true  ShKeyword => true  _ => false }
}

fn pre_intern_tokens(tokens: List<Token>, table: InternTable) -> InternTable {
  fold(tokens, init: table, f: (t, tok) =>
    if is_internable_token(shape: tok.shape) {
      intern(table: t, s: tok.text).table
    } else { t }
  )
}

fn with_optional_cardinality(n: Node) -> Node {
  Node { name: n.name, ident: n.ident, span: n.span, ident_span: n.ident_span, children: n.children, connective: n.connective, params: n.params, inferred: n.inferred, return_cardinality: CardOptional, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, expr_data: n.expr_data }
}

fn with_required_cardinality(n: Node) -> Node {
  Node { name: n.name, ident: n.ident, span: n.span, ident_span: n.ident_span, children: n.children, connective: n.connective, params: n.params, inferred: n.inferred, return_cardinality: Required, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, expr_data: n.expr_data }
}

fn join_optional_cardinality(left: Cardinality, right: Cardinality) -> Cardinality {
  let merge_optional = left == CardOptional || right == CardOptional
  if merge_optional { CardOptional } else { right }
}

fn preserve_outer_optional_cardinality(outer: Node, inner: Node) -> Node {
  let joined = join_optional_cardinality(outer.return_cardinality, inner.return_cardinality)
  let needs_restore = joined == CardOptional && inner.return_cardinality != CardOptional
  if needs_restore { with_optional_cardinality(n: inner) } else { inner }
}

fn module_path_segments(path: String) -> List<String> {
  if path == "" { [] } else { path |> split(delimiter: ".") }
}

fn qualified_last_segment(name: String) -> String {
  match module_path_segments(path: name) |> last {
    Present { value: s } => s
    Absent => name
  }
}

fn type_name_compatible(a: String, b: String) -> Bool {
  if a == b { true }
  else if contains(a, ".") && contains(b, ".") { false }
  else { qualified_last_segment(name: a) == qualified_last_segment(name: b) }
}
