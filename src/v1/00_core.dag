fn is_config_reserved_key(name: String) -> Bool {
  name == transport_url_key || name == transport_path_key || name == transport_auth_scheme_key
    || name == transport_auth_header_key || name == transport_auth_token_key
    || name == transport_method_key || name == transport_path_template_key
    || name == transport_query_key || name == transport_body_key || name == transport_stdin_key
    || name == transport_response_format_key || name == transport_headers_key
    || name == transport_auth_basic_key || name == transport_tls_key
}

fn transport_auth_basic(t: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  find_property(props: t.properties, prop_name: transport_auth_basic_key, source_indices: source_indices)
}

fn transport_tls_posture(t: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  match find_property(props: t.properties, prop_name: transport_tls_key, source_indices: source_indices) {
    Present { value: n } => Present { value: authored_name_at(source_indices: source_indices, node: n) }
    Absent => Absent
  }
}

fn transport_headers(t: Node, source_indices: Map<String, NewlineIndex>) -> List<Node> {
  t.properties |> filter(p =>
    !is_config_reserved_key(name: field_init_node_name_at(n: p, source_indices: source_indices))
  )
}

fn transport_env(t: Node, source_indices: Map<String, NewlineIndex>) -> List<Node> {
  t.properties |> filter(p =>
    !is_config_reserved_key(name: field_init_node_name_at(n: p, source_indices: source_indices))
  )
}

fn map_children(node: Node, transform: fn(Node) -> Node) -> Node {
  Node { occurrence_identity: node.occurrence_identity,
    name: node.name, ident: node.ident, span: node.span, ident_span: node.ident_span,
    children: node.children |> map(child => transform(child)),
    connective: node.connective,
    params: node.params, inferred: node.inferred,
    return_cardinality: node.return_cardinality, uses: node.uses,
    body: node.body, transport: node.transport,
    properties: node.properties, type_annotation: node.type_annotation,
    is_self_recursive: node.is_self_recursive,
    has_non_tail_self_call: node.has_non_tail_self_call,
    match_pattern: node.match_pattern, expr_data: node.expr_data
  }
}

fn expr_has_self_call(texpr: Node, fn_name: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  match texpr.expr_data {
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      if expr_call_func_at(texpr: texpr, source_indices: source_indices) == fn_name { true }
      else { texpr.children |> any(child => expr_has_self_call(texpr: child, fn_name: fn_name, source_indices: source_indices)) }
    _ => texpr.children |> any(child => expr_has_self_call(texpr: child, fn_name: fn_name, source_indices: source_indices))
  }
}

fn expr_has_non_tail_self_call(texpr: Node, fn_name: String, in_tail: Bool, source_indices: Map<String, NewlineIndex>) -> Bool {
  match texpr.expr_data {
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      if expr_call_func_at(texpr: texpr, source_indices: source_indices) == fn_name {
        if in_tail == false { true }
        else { texpr.children |> any(child => expr_has_non_tail_self_call(texpr: child, fn_name: fn_name, in_tail: false, source_indices: source_indices)) }
      } else {
        texpr.children |> any(child => expr_has_non_tail_self_call(texpr: child, fn_name: fn_name, in_tail: false, source_indices: source_indices))
      }
    ExprError { kind: _, message: _ } => false
    ExprVar { binding_kind: _ } => false
    ExprLiteral { value: _ } => false
    ExprElaboratedLiteral { value: _, elaboration: _ } => false
    ExprFieldAccess { summary: _ } =>
      texpr.children |> any(child => expr_has_non_tail_self_call(texpr: child, fn_name: fn_name, in_tail: false, source_indices: source_indices))
    ExprMethodCall { method_semantics: _ } =>
      texpr.children |> any(child => expr_has_non_tail_self_call(texpr: child, fn_name: fn_name, in_tail: false, source_indices: source_indices))
    ExprIf =>
      let cond_bad = expr_has_non_tail_self_call(texpr: if_condition(texpr: texpr), fn_name: fn_name, in_tail: false, source_indices: source_indices)
      let then_bad = expr_has_non_tail_self_call(texpr: if_then_branch(texpr: texpr), fn_name: fn_name, in_tail: in_tail, source_indices: source_indices)
      let else_bad = match if_else_branch(texpr: texpr) { Present { value: e } => expr_has_non_tail_self_call(texpr: e, fn_name: fn_name, in_tail: in_tail, source_indices: source_indices)  Absent => false }
      cond_bad || then_bad || else_bad
    ExprMatch =>
      let scrut_bad = expr_has_non_tail_self_call(texpr: match_scrutinee(texpr: texpr), fn_name: fn_name, in_tail: false, source_indices: source_indices)
      let arms_bad = match_arm_nodes(texpr: texpr) |> any(arm_node =>
        expr_has_non_tail_self_call(texpr: arm_body(n: arm_node), fn_name: fn_name, in_tail: in_tail, source_indices: source_indices))
      scrut_bad || arms_bad
    ExprLet =>
      let val_bad = expr_has_non_tail_self_call(texpr: let_value(texpr: texpr), fn_name: fn_name, in_tail: false, source_indices: source_indices)
      let body_bad = match let_body(texpr: texpr) { Present { value: b } => expr_has_non_tail_self_call(texpr: b, fn_name: fn_name, in_tail: in_tail, source_indices: source_indices)  Absent => false }
      val_bad || body_bad
    ExprBlock =>
      let ss = texpr.children
      let ss_count = ss |> count
      if ss_count == 0 { false }
      else {
        let init_bad = ss |> enumerate
          |> filter(p => p.first < ss_count - 1)
          |> any(p => expr_has_non_tail_self_call(texpr: p.second, fn_name: fn_name, in_tail: false, source_indices: source_indices))
        let last_bad = match ss |> last {
          Present { value: last_expr } =>
            expr_has_non_tail_self_call(texpr: last_expr, fn_name: fn_name, in_tail: in_tail, source_indices: source_indices)
          Absent => false
        }
        init_bad || last_bad
      }
    ExprReturn =>
      texpr.children |> any(child => expr_has_non_tail_self_call(texpr: child, fn_name: fn_name, in_tail: true, source_indices: source_indices))
    NoExprData =>
      texpr.children |> any(child => expr_has_non_tail_self_call(texpr: child, fn_name: fn_name, in_tail: in_tail, source_indices: source_indices))
    _ =>
      texpr.children |> any(child => expr_has_non_tail_self_call(texpr: child, fn_name: fn_name, in_tail: false, source_indices: source_indices))
  }
}

// THE SERVICE-CONFIG FIELD SET IS ONE AUTHORITY, and it is a coproduct rather than a list of
// string literals because the property spellings had THREE copies before this: minted here,
// matched in `04_infer` `service_config_field_judgment`, and (in authored spelling) matched in
// `02_parse` `parse_config_fields`. Review 55463 on gunbc#9028 caught the cost exactly: the
// judgment claimed a new field would fail to compile, and it would not — it was an `if/else if`
// chain over string literals whose else-arm classified any unrecognised property as carrying no
// reference, so a field added to the parser without a matching arm routed silently to
// `diagnostics: []`. That recreates the fail-open the change exists to close, one level up.
//
// With the spellings derived from this coproduct and the judgment matching it totally, a new
// variant forces an arm in `service_config_field_property_name` AND in the judgment. The residue
// is declared rather than papered over: `service_config_known_fields` is a hand-authored roster,
// so a variant added without a row there is unreachable from the judgment and lands in the
// carries-no-reference arm. Its next-rung trigger is a variant-enumeration primitive; until one
// exists, the roster is the one place that must be edited and every other site refuses.
type ServiceConfigField
  = SvcEndpoint
  | SvcAuth
  | SvcAuthInput
  | SvcAuthSource
  | SvcRateLimit

fn service_config_field_property_name(field: ServiceConfigField) -> String {
  match field {
    SvcEndpoint => "svc_endpoint"
    SvcAuth => "svc_auth"
    SvcAuthInput => "svc_auth_input"
    SvcAuthSource => "svc_auth_source"
    SvcRateLimit => "svc_rate_limit"
  }
}

fn service_config_known_fields() -> List<ServiceConfigField> {
  [SvcEndpoint, SvcAuth, SvcAuthInput, SvcAuthSource, SvcRateLimit]
}

fn service_config_field_for_property_name(name: String) -> ServiceConfigField? {
  service_config_known_fields()
    |> filter(f => service_config_field_property_name(field: f) == name)
    |> first
}

// `retry` WAS A FIELD HERE AND IS DELETED AT THE ROOT, not left parsed-and-unread.
// Measured before removal: `service_config_retry` had zero callers in the whole tree, and
// NEITHER realization retries anything -- `05_emit_rust.dag` has no occurrence of retry or
// backoff, and the interpreter's only match for either word is an unrelated doc comment. So
// the field was declared policy with no consumer (DESIGN section 5, specification without
// execution). It was also in the wrong layer: `max_attempts: 3` is OUR policy authored
// inside a cited upstream module, which is the literal-where-a-parameter-should-be-received
// tell for the section 3 layer inversion. `rate_limit` is deliberately NOT deleted beside
// it -- a published request ceiling is a fact ABOUT the dependency and belongs in extdeps;
// a retry policy is a fact about how WE call it and belongs to the caller. When a retrying
// realization exists, its policy arrives as a workflow-layer carrier parameterized per call
// site, not as a literal frozen into a dependency's module.
fn service_config_properties(endpoint: Node, auth: Node?, auth_input: Node?, auth_source: Node?, rate_limit: Node?) -> List<Node> {
  let zero_span = no_span()
  let ep_prop = [make_field_init_node(occurrence_identity: OccurrenceSynthetic, name: service_config_field_property_name(field: SvcEndpoint), value: endpoint, span: zero_span, name_span: zero_span)]
  let auth_prop = match auth {
    Present { value: a } => [make_field_init_node(occurrence_identity: OccurrenceSynthetic, name: service_config_field_property_name(field: SvcAuth), value: a, span: zero_span, name_span: zero_span)]
    Absent => []
  }
  let auth_input_prop = match auth_input {
    Present { value: ai } => [make_field_init_node(occurrence_identity: OccurrenceSynthetic, name: service_config_field_property_name(field: SvcAuthInput), value: ai, span: zero_span, name_span: zero_span)]
    Absent => []
  }
  let auth_source_prop = match auth_source {
    Present { value: src } => [make_field_init_node(occurrence_identity: OccurrenceSynthetic, name: service_config_field_property_name(field: SvcAuthSource), value: src, span: zero_span, name_span: zero_span)]
    Absent => []
  }
  let rate_prop = match rate_limit {
    Present { value: r } => [make_field_init_node(occurrence_identity: OccurrenceSynthetic, name: service_config_field_property_name(field: SvcRateLimit), value: r, span: zero_span, name_span: zero_span)]
    Absent => []
  }
  concat(ep_prop, auth_prop, auth_input_prop, auth_source_prop, rate_prop)
}

fn has_service_config(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  n.properties |> any(p => field_init_node_name_at(n: p, source_indices: source_indices) == "svc_endpoint")
}

fn service_config_endpoint(n: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  find_property(props: n.properties, prop_name: "svc_endpoint", source_indices: source_indices)
}

fn service_config_auth(n: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  find_property(props: n.properties, prop_name: "svc_auth", source_indices: source_indices)
}

fn service_config_rate_limit(n: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  find_property(props: n.properties, prop_name: "svc_rate_limit", source_indices: source_indices)
}

fn service_config_auth_input(n: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  find_property(props: n.properties, prop_name: "svc_auth_input", source_indices: source_indices)
}

fn service_config_auth_source(n: Node, source_indices: Map<String, NewlineIndex>) -> Node? {
  find_property(props: n.properties, prop_name: "svc_auth_source", source_indices: source_indices)
}

fn module_node(occurrence_identity: NodeOccurrenceIdentity, name: String, imports: List<Node>, items: List<Node>, span: SourceSpan) -> Node {
  Node { occurrence_identity: occurrence_identity,
    name: name, span: span, ident_span: default_ident_span(name: name, span: span), children: items, connective: NoConnective,

    params: imports, inferred: none, return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [],
    type_annotation: none, is_self_recursive: false,
    has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
  }
}

fn import_node(occurrence_identity: NodeOccurrenceIdentity, module_path: String, is_all: Bool, specific_names: List<Node>, span: SourceSpan, name_span: SourceSpan) -> Node {
  let wildcard_marker = if is_all {
    Present { value: Node { occurrence_identity: OccurrenceSynthetic, name: "", span: span, ident_span: none, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData } }
  } else { none }
  Node { occurrence_identity: occurrence_identity,
    name: module_path, span: span, ident_span: Present { value: name_span }, children: specific_names, connective: NoConnective,

    params: [], inferred: none, return_cardinality: Required,
    uses: [], body: wildcard_marker, transport: none, properties: [],
    type_annotation: none, is_self_recursive: false,
    has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
  }
}

fn import_is_all(n: Node) -> Bool {
  n.body != none
}

fn import_specific_names_at(n: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  n.children |> map(c => authored_name_at(source_indices: source_indices, node: c))
}

fn module_imports(n: Node) -> List<Node> {
  n.params
}

fn module_items(n: Node) -> List<Node> {
  n.children
}

fn leaf_node_with_span(occurrence_identity: NodeOccurrenceIdentity, name: String, span: SourceSpan) -> Node {
  Node { occurrence_identity: occurrence_identity, name: name, span: span, ident_span: default_ident_span(name: name, span: span), children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
}

fn kernel_span(name: String) -> SourceSpan {
  SourceSpan { file: concat("<kernel:", name, ">"), start: 0, end: string_length(s: name) }
}

// THE RECOGNIZER, HOMED BESIDE ITS MINTER. kernel_span above is what synthesizes the pseudo-file a
// kernel node carries, and every kernel construction in this seed sets
// ident_span: kernel_span(name: <the node's own name>) beside name: <that same name>. So comparing
// a span's file against kernel_span(name: item.name).file asks the CONSTRUCTOR whether it built
// this node -- exact equality against the authority rather than a prefix test over its output.
// Four separate spelling tests for this state existed across the emitter and are deleted by this
// function rather than joined by it.
//
// CAVEAT THAT BOUNDS WHAT THIS MAY CLAIM. There are two declarations of kernel_span in this seed --
// this one and v1.compiler.infer's -- with byte-identical bodies, and that module's own call sites
// bind its local twin by shadowing. The derivation here is exact TODAY BECAUSE the two bodies
// agree, which is a coincidence nothing enforces: no refusal fires if one is edited. This is a
// consumption of the authority in this module, not a consolidation of the two.
fn declaration_provenance_of(item: Node) -> TypeDeclarationProvenance {
  match item.ident_span {
    Absent => DeclarationIdentityAbsent
    Present { value: sp } =>
      if sp.file == "" {
        DeclarationIdentityAbsent
      } else if sp.file == kernel_span(name: item.name).file {
        KernelMinted { minted_name: item.name }
      } else {
        CorpusDeclared { decl_file: sp.file }
      }
  }
}

// The reference-site counterpart: project the resolved node bound to the reference, and fall back
// to the node's own ident_span when the reference IS the declaration. The shape defect this
// projection has always had is unchanged and is NOT repaired here -- it cannot tell `this node is
// its own declaration` from `this reference was not resolved here`, and in the second case answers
// about the file the REFERENCE sits in. What changes is that its answer is no longer a String a
// consumer may re-interpret: it is a provenance, and the only thing downstream of it is a decision.
fn type_reference_provenance(n: Node) -> TypeDeclarationProvenance {
  match n.inferred {
    Present { value: Resolved { node: rt } } => declaration_provenance_of(item: rt)
    _ => declaration_provenance_of(item: n)
  }
}

// FOR REPORTING ONLY -- an instrument or a diagnostic rendering a provenance as the path it stands
// on. Nothing that DECIDES may consult this: reading a decision's input back out of a string is
// precisely the round trip this construction removed, and the empty answer for an absent identity is
// a rendering choice rather than an identity.
fn provenance_reported_file(p: TypeDeclarationProvenance) -> String {
  match p {
    CorpusDeclared { decl_file: f } => f
    KernelMinted { minted_name: nm } => kernel_span(name: nm).file
    DeclarationIdentityAbsent => ""
  }
}

data unit_type: Node = Node { occurrence_identity: OccurrenceSynthetic, name: "Unit", span: kernel_span(name: "Unit"), ident_span: Present { value: kernel_span(name: "Unit") }, children: [], connective: Conj, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data bool_type: Node = Node { occurrence_identity: OccurrenceSynthetic, name: "Bool", span: kernel_span(name: "Bool"), ident_span: Present { value: kernel_span(name: "Bool") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data string_type: Node = Node { occurrence_identity: OccurrenceSynthetic, name: "String", span: kernel_span(name: "String"), ident_span: Present { value: kernel_span(name: "String") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data hash_type: Node = Node { occurrence_identity: OccurrenceSynthetic, name: "Hash", span: kernel_span(name: "Hash"), ident_span: Present { value: kernel_span(name: "Hash") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data int_type: Node = Node { occurrence_identity: OccurrenceSynthetic, name: "Int", span: kernel_span(name: "Int"), ident_span: Present { value: kernel_span(name: "Int") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data float_type: Node = Node { occurrence_identity: OccurrenceSynthetic, name: "Float", span: kernel_span(name: "Float"), ident_span: Present { value: kernel_span(name: "Float") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data none_type: Node = Node { occurrence_identity: OccurrenceSynthetic, name: "None", span: kernel_span(name: "None"), ident_span: Present { value: kernel_span(name: "None") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
data tuple_type_name: String = "Tuple"
data error_type: Node = Node { occurrence_identity: OccurrenceSynthetic, name: "", span: no_span(), ident_span: none, children: [], connective: NoConnective, params: [], inferred: Present { value: CompilerError { message: "unresolved type", span: no_span() } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: ExprError { kind: SemanticExprError, message: "unresolved type" } }

fn make_file_span(file: String, start: Int, end: Int) -> SourceSpan {
  SourceSpan { file: file, start: start, end: end }
}

// The ONLY fileless SourceSpan constructor, and it takes no offsets. A span either
// names the file it was authored in (make_file_span / kernel_span) or is the null span:
// there is no third constructor that accepts real start/end offsets while fabricating
// the file, because such a span asserts a located range inside a file that does not
// exist. make_span(start:, end:) was exactly that constructor and is deleted; every one
// of its call sites passed 0, 0, so the offset parameters only ever served to make the
// fabrication look located.
//
// The "<synthetic>" file name itself is NOT this rule's subject -- it is the FilePath
// non_empty sentinel tracked by std.types file_path_sentinel_scaffold_note and dissolves
// with feature:optional-textfile-and-source-span.
fn no_span() -> SourceSpan {
  SourceSpan { file: "<synthetic>", start: 0, end: 0 }
}

type LineCol {
  line: Int
  col: Int
}

type NewlineIndex {
  file: String
  offsets: List<Int>
  char_codes: List<Int>
}

fn build_newline_index(file: String, source: String) -> NewlineIndex {
  let char_codes = source |> chars
  let offsets = char_codes |> enumerate |> fold(init: [], f: (acc, pair) =>
    if pair.second == 10 { list_push(acc, pair.first) } else { acc }
  )
  NewlineIndex { file: file, offsets: offsets, char_codes: char_codes }
}

fn byte_to_line_col(index: NewlineIndex, offset: Int) -> LineCol {
  let clamped = if offset < 0 { 0 } else { offset }
  let line = (index.offsets |> filter(o => o < clamped) |> count) + 1
  let line_start = if line <= 1 { 0 }
    else {
      match index.offsets |> skip(line - 2) |> first {
        Present { value: o } => o + 1
        Absent => 0
      }
    }
  let col = clamped - line_start + 1
  LineCol { line: line, col: col }
}

fn source_line_at(index: NewlineIndex, line: Int) -> String {
  let src_len = count(index.char_codes)
  let line_start = if line <= 1 { 0 }
    else {
      match index.offsets |> skip(line - 2) |> first {
        Present { value: o } => o + 1
        Absent => src_len
      }
    }
  let line_end = match index.offsets |> skip(line - 1) |> first {
    Present { value: o } => o
    Absent => src_len
  }
  chars_to_string(chars: index.char_codes, start: line_start, end: line_end)
}

fn source_text_at(index: NewlineIndex, span: SourceSpan) -> String {
  chars_to_string(chars: index.char_codes, start: span.start, end: span.end)
}

type InternTable {
  strings: List<String>
  index: Map<String, Int>
  next_id: Int
  authored_token_ordinals: AuthoredTokenOrdinalSpace
}

type InternResult {
  table: InternTable
  id: Int
}

fn empty_intern_table() -> InternTable {
  InternTable {
    strings: [""],
    index: map_insert(empty_map(), "", 0),
    next_id: 1,
    authored_token_ordinals: authored_token_ordinal_space_initial(),
  }
}

fn intern_table_with_authored_token_ordinals(
  table: InternTable,
  authored_token_ordinals: AuthoredTokenOrdinalSpace
) -> InternTable {
  InternTable {
    strings: table.strings,
    index: table.index,
    next_id: table.next_id,
    authored_token_ordinals: authored_token_ordinals,
  }
}

fn intern(table: InternTable, s: String) -> InternResult {
  match map_get(table.index, s) {
    Present { value: id } => InternResult { table: table, id: id }
    Absent =>
      let id = table.next_id
      InternResult {
        table: InternTable {
          strings: list_push(table.strings, s),
          index: map_insert(table.index, s, id),
          next_id: id + 1,
          authored_token_ordinals: table.authored_token_ordinals,
        },
        id: id
      }
  }
}

fn intern_str(table: InternTable, id: Int) -> String {
  match table.strings |> get(id) {
    Present { value: s } => s
    Absent => ""
  }
}

fn intern_find(table: InternTable, s: String) -> Int? {
  match map_get(table.index, s) {
    Present { value: id } => Present { value: id }
    Absent => none
  }
}

fn intern_find_or_empty(table: InternTable, s: String) -> Int {
  match map_get(table.index, s) {
    Present { value: id } => id
    Absent => 0
  }
}

fn merge_intern_tables(tables: List<InternTable>) -> InternTable {
  tables |> fold(init: empty_intern_table(), f: (merged, t) =>
    let merged_allocator = occurrence_id_allocator_advance_to(
      alloc: merged.authored_token_ordinals.allocator,
      min_next: t.authored_token_ordinals
    )
    let merged = intern_table_with_authored_token_ordinals(
      table: merged,
      authored_token_ordinals: authored_token_ordinal_space_from_allocator(
        alloc: merged_allocator
      )
    )
    t.strings |> fold(init: merged, f: (m, s) =>
      if s == "" { m } else { intern(table: m, s: s).table }
    )
  )
}

fn is_internable_token(shape: TokenShape) -> Bool {
  match shape { ShIdent => true  ShKeyword => true  _ => false }
}

fn pre_intern_tokens(tokens: List<Token>, table: InternTable) -> InternTable {
  fold(tokens, init: table, f: (t, tok) =>
    if is_internable_token(shape: tok.shape) {
      intern(table: t, s: tok.text).table
    } else { t }
  )
}

fn with_optional_cardinality(n: Node) -> Node {
  Node { occurrence_identity: n.occurrence_identity, name: n.name, ident: n.ident, span: n.span, ident_span: n.ident_span, children: n.children, connective: n.connective, params: n.params, inferred: n.inferred, return_cardinality: CardOptional, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, expr_data: n.expr_data }
}

fn with_required_cardinality(n: Node) -> Node {
  Node { occurrence_identity: n.occurrence_identity, name: n.name, ident: n.ident, span: n.span, ident_span: n.ident_span, children: n.children, connective: n.connective, params: n.params, inferred: n.inferred, return_cardinality: Required, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call, match_pattern: n.match_pattern, expr_data: n.expr_data }
}

fn join_optional_cardinality(left: Cardinality, right: Cardinality) -> Cardinality {
  let merge_optional = left == CardOptional || right == CardOptional
  if merge_optional { CardOptional } else { right }
}

fn preserve_outer_optional_cardinality(outer: Node, inner: Node) -> Node {
  let joined = join_optional_cardinality(outer.return_cardinality, inner.return_cardinality)
  let needs_restore = joined == CardOptional && inner.return_cardinality != CardOptional
  if needs_restore { with_optional_cardinality(n: inner) } else { inner }
}

fn module_path_segments(path: String) -> List<String> {
  if path == "" { [] } else { path |> split(delimiter: ".") }
}

fn qualified_last_segment(name: String) -> String {
  match module_path_segments(path: name) |> last {
    Present { value: s } => s
    Absent => name
  }
}

// A container-table lookup has THREE answers, not two. container_expected_arity
// returning Absent conflates "this name is not a container" -- String, Bool, and
// every user record, which is the correct answer for the overwhelming majority of
// type-position names -- with "this IS a container spelling, and it is one we do
// not recognize", which is ignorance. Rendering the second as the first is the
// empty-observation narrow of DESIGN section 5: the arm answers "not under-
// parameterized" / "not a keyed map" about a name it could not classify at all,
// and the wrong answer produces no evidence of itself.
//
// The discriminator refuses; it never DECIDES. Matching on the leaf to pick a
// container kind would collapse a qualified spelling onto the kernel row and
// silently realize the wrong one (the std.nat.Nat collision class). Matching on
// the leaf to REFUSE selects no kind and no template: its worst case is a located
// diagnostic closed by declaring the row it names.
type ContainerSpellingVerdict
  = ContainerSpellingDeclared { arity: Int }
  | NotAContainerSpelling
  | ContainerSpellingUnknown { container_leaf: String }

// The known container leaves are read from container_type_arity itself -- the same
// authority the Present arm consults -- so this is not a third roster (DESIGN
// section 3). The lowercase alias spellings that container_template_alias_rows
// additionally carries are deliberately NOT read here: "list", "map" and "set" are
// ordinary identifier spellings, so a binder or field named `map` would be refused
// as an unrecognized container. The wall is drawn where the refusal cannot be
// wrong about what kind of name it is looking at.
fn known_container_leaf(name: String) -> String? {
  let leaf = qualified_last_segment(name: name)
  match container_expected_arity(name: leaf) {
    Present { value: _ } => Present { value: leaf }
    Absent => none
  }
}

fn container_spelling_verdict(name: String) -> ContainerSpellingVerdict {
  match container_expected_arity(name: name) {
    Present { value: arity } => ContainerSpellingDeclared { arity: arity }
    Absent =>
      match known_container_leaf(name: name) {
        Present { value: leaf } => ContainerSpellingUnknown { container_leaf: leaf }
        Absent => NotAContainerSpelling
      }
  }
}

// Only a name the compiler can read back out of real authored source may be
// refused. A synthesized type node carries a <kernel:...> span whose file is in no
// source index -- and the service path is exactly that: check_service_field_access_node
// builds nominal_type_ref(name: "cron.Tab.List"), a LEAF TYPE NODE whose last
// segment is a container name and which is not a container. Excluding it by
// authorship rather than by an exception list is what keeps the six known
// false-refusals (cron.Tab.List, Filesystem.List, github.Pulls.List,
// tmux.Session.List, os.Hostname.Set, req.Header.Set) out by construction: a
// seventh service operation named after a container needs no edit here.
fn type_node_name_is_authored(node: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match node.ident_span {
    Present { value: span } =>
      match map_get(source_indices, span.file) {
        Present { value: _ } => true
        Absent => false
      }
    Absent => false
  }
}

fn authored_container_spelling_verdict(node: Node, source_indices: Map<String, NewlineIndex>) -> ContainerSpellingVerdict {
  if type_node_name_is_authored(node: node, source_indices: source_indices) {
    container_spelling_verdict(name: authored_name_at(source_indices: source_indices, node: node))
  } else {
    match container_expected_arity(name: authored_name_at(source_indices: source_indices, node: node)) {
      Present { value: arity } => ContainerSpellingDeclared { arity: arity }
      Absent => NotAContainerSpelling
    }
  }
}

fn type_name_compatible(a: String, b: String) -> Bool {
  if a == b { true }
  else if contains(a, ".") && contains(b, ".") { false }
  else { qualified_last_segment(name: a) == qualified_last_segment(name: b) }
}
