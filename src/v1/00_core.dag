}

fn transport_has_auth(t: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match find_property(props: t.properties, prop_name: transport_auth_token_key, source_indices: source_indices) {
    Present { value: _ } => true
    Absent => false
  }
}

