module v1.compiler.infer_service

import std.occurrence_identity { OccurrenceSynthetic }

import std.types { SourceSpan }

import v1.std.core {
  call_semantics_target, callable_identity, DeclaredCallableIdentity,
  CallSemantics, FunctionValueCallSemantics,
  CallTargetIdentity, SourceDeclarationCall, RuntimePrimitiveCall, CallableTargetUndetermined,
  Node,
  Connective, Conj, NoConnective,
  ExprData, NoExprData,
  ExprFieldAccess, ExprMethodCall, ExprCall, ExprVar,
  Cardinality, Required,
  InferredNode, Resolved,
  NewlineIndex,
  no_span,
  unit_type,
  expr_var_name_at, expr_call_func_at, field_access_field_at, field_access_base,
  method_receiver, param_node_type_expr,
  authored_name_at
}

import v1.compiler.infer_types {
  emit_map_has, nominal_type_ref
}

import v1.compiler.infer_items {
  ItemInfo, ItemKind, FuncItem, TypedModule,
  inferred_to_outputs
}


type UniqueAccum {
  seen: Map<String, Bool>
  result: List<String>
}

type OpEntry {
  name: String
  outputs: List<Node>
  params: List<Node>
}

type ServiceMethodResult {
  result_type: Node
  op_params: List<Node>
}

// THE JUDGMENT IS READ, NOT RE-DERIVED. service_spine_projection resolved this occurrence against
// the service registry and stamped ServiceValueBinding on the result; this fn asks for that stamp
// and nothing else. It cannot be wrong about a name it does not read.
//
// WHY NOT CONSULT THE REGISTRY HERE, which is the obvious alternative: the emitters cannot reach
// it. 371 functions across 05_emit, 05_emit_rust, 05_emit_go and 05_emit_python thread
// `source_indices`, and adding a parallel `services` parameter beside it would duplicate that
// plumbing to carry a fact the node can carry itself.
//
// THREE EARLIER SHAPES GUESSED, AND EACH GUESS WAS WRONG IN ITS OWN WAY. A field access rooted in a
// variable with an ASCII-uppercase leaf admitted `x.inner.User`, an ordinary value. Name-equals-its-
// own-resolved-type-name admitted single-segment `Filesystem`, which deleted the fail-closed
// "unrealized host seam" refusal a service op in a pure fn must produce — CI caught that one — and
// admitted bare namespace roots like `cargo`, which are not services at all. Requiring a dot
// reproduced the previous behaviour exactly and was still a semantic fact inferred from a
// character. The stamp ends the sequence rather than adding a fourth spelling to it.
// THE VARIANT IS MATCHED IN ITS OWN match RATHER THAN NESTED IN THE OUTER PATTERN, and that is an
// emission constraint rather than a style choice: spelling it as
// `ExprVar { binding_kind: Present { value: ServiceValueBinding } }` emits Rust that matches a bare
// variant against an `Rc<VarBindingKind>` field and does not compile. Binding the payload and
// eliminating it separately emits correctly. Measured by regen, not assumed.
fn service_receiver_resolved_name(receiver: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  match receiver.expr_data {
    ExprVar { binding_kind: Present { value: bk } } =>
      match bk {
        ServiceValueBinding =>
          Present { value: expr_var_name_at(texpr: receiver, source_indices: source_indices) }
        _ => none
      }
    _ => none
  }
}

fn is_typed_service_call_receiver(receiver: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match service_receiver_resolved_name(receiver: receiver, source_indices: source_indices) {
    Present { value: _ } => true
    Absent => false
  }
}

fn extract_typed_service_name(receiver: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  service_receiver_resolved_name(receiver: receiver, source_indices: source_indices)
}

fn collect_typed_service_calls(texpr: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let result = collect_typed_service_calls_into(texpr: texpr, acc: UniqueAccum { seen: empty_map(), result: [] }, source_indices: source_indices)
  result.result
}

fn collect_typed_service_calls_into(texpr: Node, acc: UniqueAccum, source_indices: Map<String, NewlineIndex>) -> UniqueAccum {
  let this_acc = match texpr.expr_data {
    ExprMethodCall { method_semantics: _ } =>
      let r = method_receiver(texpr: texpr)
      if is_typed_service_call_receiver(receiver: r, source_indices: source_indices) {
        match extract_typed_service_name(receiver: r, source_indices: source_indices) {
          Present { value: service_name } =>
            if emit_map_has(m: acc.seen, key: service_name) { acc }
            else { UniqueAccum { seen: map_insert(acc.seen, service_name, true), result: list_push(acc.result, service_name) } }
          Absent => acc
        }
      } else { acc }
    _ => acc
  }
  let result = texpr.children |> fold(init: this_acc, f: (a, child) =>
    collect_typed_service_calls_into(texpr: child, acc: a, source_indices: source_indices)
  )
  result
}

// A callee edge is the resolved answer to "which declaration does this call reach", carried as a
// value so that not-knowing is representable. Collapsing the third arm into an absence is what
// makes an incomplete effect summary indistinguishable from a complete empty one.
type CalleeEdge
  = ResolvedCallee { identity: DeclaredCallableIdentity }
  | PrimitiveCallee
  | FunctionValueCallee
  | UnresolvedCallee { spelling: String }

type CalleeAccum {
  seen: Map<String, Bool>
  result: List<CalleeEdge>
}

// THE CALLEE EDGE, KEYED ON THE IDENTITY INFERENCE ALREADY ESTABLISHED.
//
// This arm used to destructure `call_semantics` and discard it, then key the edge on the authored
// spelling from `expr_call_func_at`. That is the owner-discarding join: two modules declaring the
// same authored name produce ONE edge key, so their effect summaries merge and a caller can be
// told it depends on a service its actual callee never touches -- or, worse, told it depends on
// nothing. The identity was on the node the whole time; `SourceDeclarationCall` names the owner
// module and the declaration, which is exactly the canonical key the registry is built under.
//
// The three arms are distinct and none of them may collapse into another:
//   - a source declaration contributes its identity, and its summary joins by that identity;
//   - a runtime primitive has no `ItemInfo` and carries no declared effects, so it contributes
//     no edge -- an absence that is CORRECT rather than unknown;
//   - an unestablished target contributes an UNRESOLVED edge, which must not silently vanish.
//     Dropping it would under-propagate effects exactly the way the authored-spelling join did,
//     and falling back to the spelling would reinstate the defect this arm exists to remove. It
//     is carried so the caller can refuse rather than publish a summary it cannot vouch for.
fn callee_edge_of_semantics(cs: CallSemantics?, spelling: String) -> CalleeEdge {
  match cs {
    Present { value: FunctionValueCallSemantics } => FunctionValueCallee
    Absent => UnresolvedCallee { spelling: spelling }
    _ =>
      match call_semantics_target(cs: cs) {
        SourceDeclarationCall { owner_module_path: owner, decl_name: decl } =>
          ResolvedCallee { identity: DeclaredCallableIdentity { owner_module_path: owner, decl_name: decl } }
        RuntimePrimitiveCall { primitive_name: _, projected_from: _ } => PrimitiveCallee
        CallableTargetUndetermined => UnresolvedCallee { spelling: spelling }
      }
  }
}

// The dedup key is a DISCRIMINATED spelling, not the bare string: a resolved identity and an
// unresolved authored spelling can coincide textually, and folding them together would let an
// unresolved edge be silently absorbed by a resolved one and disappear from the refusal set. A
// primitive edge has no key because it is dropped at collection -- the one absence that is an
// answer rather than a gap.
fn callee_edge_dedup_key(edge: CalleeEdge) -> String {
  match edge {
    ResolvedCallee { identity: identity } => concat("d:", callable_identity(id: identity))
    UnresolvedCallee { spelling: spelling } => concat("u:", spelling)
    FunctionValueCallee => ""
    PrimitiveCallee => ""
  }
}

fn collect_callee_edges_into(texpr: Node, acc: CalleeAccum, source_indices: Map<String, NewlineIndex>) -> CalleeAccum {
  let this_acc = match texpr.expr_data {
    ExprCall { call_semantics: cs, descent_evidence: _ } =>
      let edge = callee_edge_of_semantics(cs: cs, spelling: expr_call_func_at(texpr: texpr, source_indices: source_indices))
      let key = callee_edge_dedup_key(edge: edge)
      if key == "" { acc }
      else if emit_map_has(m: acc.seen, key: key) { acc }
      else { CalleeAccum { seen: map_insert(acc.seen, key, true), result: list_push(acc.result, edge) } }
    _ => acc
  }
  let result = texpr.children |> fold(init: this_acc, f: (a, child) =>
    collect_callee_edges_into(texpr: child, acc: a, source_indices: source_indices)
  )
  result
}

fn collect_callee_edges(texpr: Node, source_indices: Map<String, NewlineIndex>) -> List<CalleeEdge> {
  let result = collect_callee_edges_into(texpr: texpr, acc: CalleeAccum { seen: empty_map(), result: [] }, source_indices: source_indices)
  result.result
}

// THE CALLEE EDGES ARE LOOP-INVARIANT, and used to be recomputed on every pass. The fixpoint
// updates only `registry.service_names`; `modules` is threaded through the recursion unchanged, so
// an item's body and its module's source_indices are identical on pass 5 and pass 1 — yet the
// collector walked the WHOLE body tree of every item on each pass, up to 5 full corpus AST
// traversals per resolve to recompute the same lists.
//
// They are precomputed ONCE, in the same nesting and order as the fold that consumes them. The
// positional layout used to be load-bearing for a second reason: the registry keyed items by
// authored name, so two modules declaring the same name shared a key, and a name-keyed precompute
// would have handed one item the other's callees -- position preserved that collision rather than
// widening it. THAT REASON IS GONE. Items are keyed by canonical identity now, so position is
// retained only because it is the cheapest faithful order, not because it is compensating for a
// key that cannot tell two declarations apart.
type ItemCallees {
  item_identity: DeclaredCallableIdentity
  has_body: Bool
  called: List<CalleeEdge>
}

type ModuleCallees {
  items: List<ItemCallees>
}

fn item_callees_for(m: TypedModule, module_name: String, item: Node) -> ItemCallees {
  let item_identity = DeclaredCallableIdentity {
    owner_module_path: module_name,
    decl_name: authored_name_at(source_indices: m.type_env.source_indices, node: item)
  }
  let has_no_body = item.body == none
  if has_no_body {
    ItemCallees { item_identity: item_identity, has_body: false, called: [] }
  } else {
    ItemCallees {
      item_identity: item_identity,
      has_body: true,
      called: collect_callee_edges(texpr: item.body.value, source_indices: m.type_env.source_indices)
    }
  }
}

fn build_module_callees(modules: List<TypedModule>) -> List<ModuleCallees> {
  modules |> map(m =>
    let module_name = authored_name_at(source_indices: m.type_env.source_indices, node: m.module)
    ModuleCallees { items: m.items |> map(item => item_callees_for(m: m, module_name: module_name, item: item)) }
  )
}

fn expand_transitive_services_once(module_callees: List<ModuleCallees>, registry: Map<String, ItemInfo>) -> Map<String, ItemInfo> {
  module_callees |> fold(init: registry, f: (reg, m) =>
    m.items |> fold(init: reg, f: (reg2, entry) =>
    let item_identity = entry.item_identity
    match map_get(reg2, callable_identity(id: item_identity)) {
      Present { value: info } =>
        let has_no_body = !entry.has_body
        if has_no_body { reg2 }
        else {
          let called = entry.called
          let extra = called |> flat_map(edge =>
            match edge {
              ResolvedCallee { identity: callee_identity } =>
                match map_get(reg2, callable_identity(id: callee_identity)) {
                  Present { value: callee_info } => callee_info.service_names
                  Absent => []
                }
              PrimitiveCallee => []
              FunctionValueCallee => []
              UnresolvedCallee { spelling: _ } => []
            }
          )
          let merged = extra |> fold(init: info.service_names, f: (svc_list, svc) =>
            if svc_list |> any(s => s == svc) { svc_list }
            else { list_push(svc_list, svc) }
          )
          let same_count = merged |> count == info.service_names |> count
          if same_count { reg2 }
          else {
            map_insert(reg2, callable_identity(id: item_identity), ItemInfo {
              name: info.name,
              module_name: info.module_name,
              kind: info.kind,
              service_names: merged,
              resource_names: info.resource_names,
              params: info.params,
              is_self_recursive: info.is_self_recursive,
              has_non_tail_self_call: info.has_non_tail_self_call
            })
          }
        }
      Absent => reg2
    }
  ))
}

fn total_service_count(registry: Map<String, ItemInfo>) -> Int {
  map_values(registry) |> fold(init: 0, f: (acc, info) => acc + info.service_names |> count)
}

// WHY EXHAUSTION IS A DIFFERENT ANSWER FROM CONVERGENCE, AND MUST NOT SHARE ITS RETURN.
//
// The loop has two ways to stop and they mean opposite things. Reaching a fixed point means the
// summary is COMPLETE: another pass would change nothing. Running out of passes means the summary
// is UNFINISHED and nobody knows by how much. This function used to return the same ordinary
// registry either way, so a truncated answer was indistinguishable from a settled one at every
// consumer -- signatures and call sites alike -- and the deficit could never be counted, let
// alone ranked for repair. A budget is a legitimate operational limit; spending it and then
// publishing the partial result as though it were the answer is the absorbing fallback.
//
// The convergence test compares total service counts, which is sound ONLY because merging is
// monotone: `merged` grows by deduplicating pushes and an item is rewritten only when its count
// changed, so equal totals across a pass imply no item changed. If merging ever gains a removal
// arm, this test stops being a fixed-point test and becomes a coincidence.
// COMPLETENESS IS NOT A SIBLING FIELD, BECAUSE A SIBLING FIELD IS OPTIONAL TO ITS READER.
//
// The first shape of this carrier was a record with the registry beside a list of incompleteness
// reasons, and every consumer could take the registry and never look at the list -- which is the
// same defect one layer up: an unfinished summary presenting itself as a finished one. The
// repository already learned this at `TypedModule.progress`, where an empty item list conflated
// "checked, nothing there" with "never checked", and whose dissolution note names the terminal
// construction: put the population INSIDE the completed arm so obtaining it requires handling
// whether the analysis happened at all.
//
// So the finalized map is reachable only through `EffectsComplete`. The incomplete arm still
// carries what was computed, because a partial result is useful for diagnosis and measurement,
// but it is named `partial` and cannot be mistaken for the answer by a reader that did not look.
type ServiceEffectAnalysis
  = EffectsComplete { registry: Map<String, ItemInfo> }
  | EffectsIncomplete { partial: Map<String, ItemInfo>, causes: List<EffectIncompleteness> }

// Two ways an effect summary can fail to be trustworthy, kept apart because they have different
// causes and different repairs: a callee whose identity was never established, and a closure the
// pass budget did not finish walking.
type EffectIncompleteness
  = UnresolvedCalleeEdge { item_identity: DeclaredCallableIdentity, spelling: String }
  | ExpansionBudgetExhausted { remaining_delta: Int }

// The unresolved edges are a property of the PRECOMPUTED callee lists, not of any iteration, so
// they are read once from the same structure the fold consumes rather than re-derived per pass.
fn unresolved_callee_edges(module_callees: List<ModuleCallees>) -> List<EffectIncompleteness> {
  module_callees |> flat_map(m =>
    m.items |> flat_map(entry =>
      entry.called |> flat_map(edge =>
        match edge {
          UnresolvedCallee { spelling: spelling } =>
            [UnresolvedCalleeEdge { item_identity: entry.item_identity, spelling: spelling }]
          ResolvedCallee { identity: _ } => []
          PrimitiveCallee => []
          FunctionValueCallee => []
        }
      )
    )
  )
}

fn expand_transitive_services_loop(module_callees: List<ModuleCallees>, registry: Map<String, ItemInfo>, remaining_passes: Int) -> ServiceEffectAnalysis {
  let before = total_service_count(registry: registry)
  let next = expand_transitive_services_once(module_callees: module_callees, registry: registry)
  let after = total_service_count(registry: next)
  if before == after {
    EffectsComplete { registry: registry }
  } else if remaining_passes <= 1 {
    EffectsIncomplete {
      partial: next,
      causes: [ExpansionBudgetExhausted { remaining_delta: after - before }]
    }
  } else {
    expand_transitive_services_loop(module_callees: module_callees, registry: next, remaining_passes: remaining_passes - 1)
  }
}

fn expand_transitive_services(modules: List<TypedModule>, registry: Map<String, ItemInfo>, remaining_passes: Int) -> ServiceEffectAnalysis {
  let module_callees = build_module_callees(modules: modules)
  let unresolved = unresolved_callee_edges(module_callees: module_callees)
  let closed = expand_transitive_services_loop(module_callees: module_callees, registry: registry, remaining_passes: remaining_passes)
  match closed {
    EffectsComplete { registry: closed_registry } =>
      if unresolved |> count == 0 { EffectsComplete { registry: closed_registry } }
      else { EffectsIncomplete { partial: closed_registry, causes: unresolved } }
    EffectsIncomplete { partial: partial, causes: causes } =>
      EffectsIncomplete { partial: partial, causes: concat(unresolved, causes) }
  }
}

// ONE HOP, AND DELIBERATELY STILL ONE HOP. This fn answers a narrow question — is
// `<base> "." <field>` itself a complete registered service — and it is left exactly as it was.
// Arbitrary segmentation is NOT solved here; it is solved by resolving the whole dotted occurrence
// at once in service_spine_projection (src/v1/04_infer.dag), before any hop-by-hop inference runs.
//
// AN EARLIER REVISION OF THIS FN SOLVED IT HERE AND WAS WRONG. It added an Absent arm returning a
// nominal type whenever the joined path was a PREFIX of some registry key, so that a walk could
// continue through an intermediate namespace. That conflated two different facts — "a declaration
// exists below this namespace" and "this namespace denotes a value" — and the second is false:
// with `diagnostic.ipmi.Tool` registered, bare `diagnostic.ipmi` became an admissible expression
// naming nothing at all, because nothing required a further field hop to complete it. It also
// scanned the entire service population on every intermediate lookup, which is the cost shape
// DESIGN §6 fixes regardless of realized n. Resolving the complete occurrence has neither problem:
// a prefix is never looked up, so it can never be admitted, and one map_get answers the question.
fn check_service_field_access_node(base_type: Node, field: String, service_registry: Map<String, List<OpEntry>>, source_indices: Map<String, NewlineIndex>) -> Node? {
  if base_type.connective == NoConnective && base_type.children |> count == 0 {
    let path = concat(authored_name_at(source_indices: source_indices, node: base_type), ".", field)
    match map_get(service_registry, path) {
      Present { value: _ } => Present { value: nominal_type_ref(name: path) }
      Absent => none
    }
  } else { none }
}

fn check_service_method_call_node(receiver_type: Node, method: String, service_registry: Map<String, List<OpEntry>>, source_indices: Map<String, NewlineIndex>) -> ServiceMethodResult? {
  if receiver_type.connective == NoConnective && receiver_type.children |> count == 0 {
    match map_get(service_registry, authored_name_at(source_indices: source_indices, node: receiver_type)) {
      Present { value: ops } =>
        let matching = ops |> filter(op => op.name == method)
        match matching |> first {
          Present { value: op } =>
            if op.outputs |> count == 0 {
              Present { value: ServiceMethodResult { result_type: unit_type, op_params: op.params } }
            } else {
              Present { value: ServiceMethodResult {
                result_type: Node {
                  occurrence_identity: OccurrenceSynthetic, name: "", span: no_span(), ident_span: none,
                  children: map(op.outputs, f => Node { occurrence_identity: OccurrenceSynthetic, name: f.name, span: f.span, ident_span: f.ident_span, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: param_node_type_expr(n: f) } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, expr_data: NoExprData }),
                  connective: Conj,
                  params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, expr_data: NoExprData
                },
                op_params: op.params
              } }
            }
          Absent => none
        }
      Absent => none
    }
  } else { none }
}

fn service_op_entry(child: Node, source_indices: Map<String, NewlineIndex>) -> OpEntry {
  OpEntry { name: authored_name_at(source_indices: source_indices, node: child), outputs: inferred_to_outputs(inferred: child.inferred, span: child.span, source_indices: source_indices), params: child.params }
}
