module v1.compiler.infer_service

import std.occurrence_identity { OccurrenceSynthetic }

import std.types { SourceSpan }

import v1.std.core {
  Node,
  Connective, Conj, NoConnective,
  ExprData, NoExprData,
  ExprFieldAccess, ExprMethodCall, ExprCall, ExprVar,
  Cardinality, Required,
  InferredNode, Resolved,
  NewlineIndex,
  no_span,
  unit_type,
  expr_var_name_at, expr_call_func_at, field_access_field_at, field_access_base,
  method_receiver, param_node_type_expr,
  authored_name_at
}

import v1.compiler.infer_types {
  emit_map_has, nominal_type_ref
}

import v1.compiler.infer_items {
  ItemInfo, ItemKind, FuncItem, TypedModule,
  inferred_to_outputs
}


type UniqueAccum {
  seen: Map<String, Bool>
  result: List<String>
}

type OpEntry {
  name: String
  outputs: List<Node>
  params: List<Node>
}

type ServiceMethodResult {
  result_type: Node
  op_params: List<Node>
}

// WHAT MAKES AN EXPRESSION A SERVICE RECEIVER IS ITS RESOLVED TYPE, NOT ITS SPELLING.
//
// THE SHAPE THESE PREDICATES NOW READ is the one service_spine_projection (v1.compiler.infer)
// produces: a service occurrence is resolved as a WHOLE dotted name against the service registry
// and admitted as a named expression whose own name and whose resolved type name are the SAME
// dotted string. That coincidence is the marker, and it is not a new convention invented here —
// binding_is_namespace_root_nominal already identifies a namespace binding by exactly the same
// test (resolved.name == binding.name, nominal, childless). An ordinary value never satisfies it:
// `x: Foo` has expression name `x` and type name `Foo`.
//
// WHAT WAS HERE BEFORE, AND WHY IT WAS REPLACED RATHER THAN EXTENDED. The previous predicate
// recognized a SYNTACTIC shape — a field access rooted directly in a variable whose final
// component starts with an ASCII uppercase letter — and never consulted the resolution that had
// already decided the question. That is a classifier guessing at a fact the compiler already
// knew. Extending its field spine to accept deeper dotted names (the first attempt at
// arbitrary segmentation) made it strictly worse: `x.inner.User`, an ordinary value expression,
// then satisfied it, so an ordinary field access could be collected as a service dependency and
// reach generated function parameters. Widening a spelling heuristic does not make it a semantic
// authority; the repair is to stop guessing.
//
// THESE PREDICATES ARE CONSUMED BY EMISSION, not by diagnostics: collect_typed_service_calls_into
// gathers the names that become generated service parameters, and 05_emit / 05_emit_go /
// 05_emit_python decide call shape from them. A false positive here mints a parameter for a
// service that does not exist; a false negative drops the parameter a real call needs. Both are
// silent in the emitted program, which is why this judgment must come from resolution.
fn service_receiver_resolved_name(receiver: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  match receiver.expr_data {
    ExprVar { binding_kind: _ } =>
      match receiver.inferred {
        Present { value: Resolved { node: rt } } =>
          if rt.connective == NoConnective && (rt.children |> count) == 0 {
            let type_name = authored_name_at(source_indices: source_indices, node: rt)
            let expr_name = expr_var_name_at(texpr: receiver, source_indices: source_indices)
            if type_name != "" && type_name == expr_name {
              Present { value: type_name }
            } else {
              none
            }
          } else {
            none
          }
        _ => none
      }
    _ => none
  }
}

fn is_typed_service_call_receiver(receiver: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match service_receiver_resolved_name(receiver: receiver, source_indices: source_indices) {
    Present { value: _ } => true
    Absent => false
  }
}

fn extract_typed_service_name(receiver: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  service_receiver_resolved_name(receiver: receiver, source_indices: source_indices)
}

fn collect_typed_service_calls(texpr: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let result = collect_typed_service_calls_into(texpr: texpr, acc: UniqueAccum { seen: empty_map(), result: [] }, source_indices: source_indices)
  result.result
}

fn collect_typed_service_calls_into(texpr: Node, acc: UniqueAccum, source_indices: Map<String, NewlineIndex>) -> UniqueAccum {
  let this_acc = match texpr.expr_data {
    ExprMethodCall { method_semantics: _ } =>
      let r = method_receiver(texpr: texpr)
      if is_typed_service_call_receiver(receiver: r, source_indices: source_indices) {
        match extract_typed_service_name(receiver: r, source_indices: source_indices) {
          Present { value: service_name } =>
            if emit_map_has(m: acc.seen, key: service_name) { acc }
            else { UniqueAccum { seen: map_insert(acc.seen, service_name, true), result: list_push(acc.result, service_name) } }
          Absent => acc
        }
      } else { acc }
    _ => acc
  }
  let result = texpr.children |> fold(init: this_acc, f: (a, child) =>
    collect_typed_service_calls_into(texpr: child, acc: a, source_indices: source_indices)
  )
  result
}

fn collect_called_func_names_into(texpr: Node, acc: UniqueAccum, source_indices: Map<String, NewlineIndex>) -> UniqueAccum {
  let this_acc = match texpr.expr_data {
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let f = expr_call_func_at(texpr: texpr, source_indices: source_indices)
      if emit_map_has(m: acc.seen, key: f) { acc }
      else { UniqueAccum { seen: map_insert(acc.seen, f, true), result: list_push(acc.result, f) } }
    _ => acc
  }
  let result = texpr.children |> fold(init: this_acc, f: (a, child) =>
    collect_called_func_names_into(texpr: child, acc: a, source_indices: source_indices)
  )
  result
}

fn collect_called_func_names(texpr: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let result = collect_called_func_names_into(texpr: texpr, acc: UniqueAccum { seen: empty_map(), result: [] }, source_indices: source_indices)
  result.result
}

// THE CALLEE NAMES ARE LOOP-INVARIANT, and used to be recomputed on every pass. The fixpoint
// updates only `registry.service_names`; `modules` is threaded through the recursion unchanged, so
// an item's body and its module's source_indices are identical on pass 5 and pass 1 — yet
// collect_called_func_names walked the WHOLE body tree of every item on each pass, up to 5 full
// corpus AST traversals per resolve to recompute the same lists.
//
// They are precomputed ONCE, in the same nesting and order as the fold that consumes them, as a
// positional list rather than a map keyed by item name: the registry treats item names as global
// keys, so two modules declaring the same authored name share a key, and a name-keyed precompute
// would silently hand one item the other's callees. Position preserves the original iteration
// exactly, including that collision.
type ItemCallees {
  item_name: String
  has_body: Bool
  called: List<String>
}

type ModuleCallees {
  items: List<ItemCallees>
}

fn item_callees_for(m: TypedModule, item: Node) -> ItemCallees {
  let item_name = authored_name_at(source_indices: m.type_env.source_indices, node: item)
  let has_no_body = item.body == none
  if has_no_body {
    ItemCallees { item_name: item_name, has_body: false, called: [] }
  } else {
    ItemCallees {
      item_name: item_name,
      has_body: true,
      called: collect_called_func_names(texpr: item.body.value, source_indices: m.type_env.source_indices)
    }
  }
}

fn build_module_callees(modules: List<TypedModule>) -> List<ModuleCallees> {
  modules |> map(m => ModuleCallees { items: m.items |> map(item => item_callees_for(m: m, item: item)) })
}

fn expand_transitive_services_once(module_callees: List<ModuleCallees>, registry: Map<String, ItemInfo>) -> Map<String, ItemInfo> {
  module_callees |> fold(init: registry, f: (reg, m) =>
    m.items |> fold(init: reg, f: (reg2, entry) =>
    let item_name = entry.item_name
    match map_get(reg2, item_name) {
      Present { value: info } =>
        let has_no_body = !entry.has_body
        if has_no_body { reg2 }
        else {
          let called = entry.called
          let extra = called |> flat_map(callee_name =>
            match map_get(reg2, callee_name) {
              Present { value: callee_info } => callee_info.service_names
              Absent => []
            }
          )
          let merged = extra |> fold(init: info.service_names, f: (svc_list, svc) =>
            if svc_list |> any(s => s == svc) { svc_list }
            else { list_push(svc_list, svc) }
          )
          let same_count = merged |> count == info.service_names |> count
          if same_count { reg2 }
          else {
            map_insert(reg2, item_name, ItemInfo {
              name: info.name,
              module_name: info.module_name,
              kind: info.kind,
              service_names: merged,
              resource_names: info.resource_names,
              params: info.params,
              is_self_recursive: info.is_self_recursive,
              has_non_tail_self_call: info.has_non_tail_self_call
            })
          }
        }
      Absent => reg2
    }
  ))
}

fn total_service_count(registry: Map<String, ItemInfo>) -> Int {
  map_values(registry) |> fold(init: 0, f: (acc, info) => acc + info.service_names |> count)
}

fn expand_transitive_services_loop(module_callees: List<ModuleCallees>, registry: Map<String, ItemInfo>, remaining_passes: Int) -> Map<String, ItemInfo> {
  if remaining_passes <= 0 { registry }
  else {
    let before = total_service_count(registry: registry)
    let next = expand_transitive_services_once(module_callees: module_callees, registry: registry)
    let after = total_service_count(registry: next)
    if before == after { registry }
    else { expand_transitive_services_loop(module_callees: module_callees, registry: next, remaining_passes: remaining_passes - 1) }
  }
}

fn expand_transitive_services(modules: List<TypedModule>, registry: Map<String, ItemInfo>, remaining_passes: Int) -> Map<String, ItemInfo> {
  expand_transitive_services_loop(module_callees: build_module_callees(modules: modules), registry: registry, remaining_passes: remaining_passes)
}

// ONE HOP, AND DELIBERATELY STILL ONE HOP. This fn answers a narrow question — is
// `<base> "." <field>` itself a complete registered service — and it is left exactly as it was.
// Arbitrary segmentation is NOT solved here; it is solved by resolving the whole dotted occurrence
// at once in service_spine_projection (src/v1/04_infer.dag), before any hop-by-hop inference runs.
//
// AN EARLIER REVISION OF THIS FN SOLVED IT HERE AND WAS WRONG. It added an Absent arm returning a
// nominal type whenever the joined path was a PREFIX of some registry key, so that a walk could
// continue through an intermediate namespace. That conflated two different facts — "a declaration
// exists below this namespace" and "this namespace denotes a value" — and the second is false:
// with `diagnostic.ipmi.Tool` registered, bare `diagnostic.ipmi` became an admissible expression
// naming nothing at all, because nothing required a further field hop to complete it. It also
// scanned the entire service population on every intermediate lookup, which is the cost shape
// DESIGN §6 fixes regardless of realized n. Resolving the complete occurrence has neither problem:
// a prefix is never looked up, so it can never be admitted, and one map_get answers the question.
fn check_service_field_access_node(base_type: Node, field: String, service_registry: Map<String, List<OpEntry>>, source_indices: Map<String, NewlineIndex>) -> Node? {
  if base_type.connective == NoConnective && base_type.children |> count == 0 {
    let path = concat(authored_name_at(source_indices: source_indices, node: base_type), ".", field)
    match map_get(service_registry, path) {
      Present { value: _ } => Present { value: nominal_type_ref(name: path) }
      Absent => none
    }
  } else { none }
}

fn check_service_method_call_node(receiver_type: Node, method: String, service_registry: Map<String, List<OpEntry>>, source_indices: Map<String, NewlineIndex>) -> ServiceMethodResult? {
  if receiver_type.connective == NoConnective && receiver_type.children |> count == 0 {
    match map_get(service_registry, authored_name_at(source_indices: source_indices, node: receiver_type)) {
      Present { value: ops } =>
        let matching = ops |> filter(op => op.name == method)
        match matching |> first {
          Present { value: op } =>
            if op.outputs |> count == 0 {
              Present { value: ServiceMethodResult { result_type: unit_type, op_params: op.params } }
            } else {
              Present { value: ServiceMethodResult {
                result_type: Node {
                  occurrence_identity: OccurrenceSynthetic, name: "", span: no_span(), ident_span: none,
                  children: map(op.outputs, f => Node { occurrence_identity: OccurrenceSynthetic, name: f.name, span: f.span, ident_span: f.ident_span, children: [], connective: NoConnective, params: [], inferred: Present { value: Resolved { node: param_node_type_expr(n: f) } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }),
                  connective: Conj,
                  params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
                },
                op_params: op.params
              } }
            }
          Absent => none
        }
      Absent => none
    }
  } else { none }
}

fn service_op_entry(child: Node, source_indices: Map<String, NewlineIndex>) -> OpEntry {
  OpEntry { name: authored_name_at(source_indices: source_indices, node: child), outputs: inferred_to_outputs(inferred: child.inferred, span: child.span, source_indices: source_indices), params: child.params }
}
