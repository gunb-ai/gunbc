fn merge_scope_from_imports(remaining: List<ResolvedImport>, parent_index: Map<String, TypedModule>, env: TypeEnv,
    svc_registry: Map<String, List<OpEntry>>,
    svc_locals: Map<String, TypeBinding>) -> InferScopeComponents {
  match remaining |> first {
    Absent => InferScopeComponents {
      svc_registry: svc_registry,
      svc_locals: svc_locals
    }
    Present { value: imp } =>
      match map_get(parent_index, imp.module_path) {
        Present { value: typed_parent } =>
          let parent_result = fold(typed_parent.items, init: InferScopeComponents {
            svc_registry: svc_registry,
            svc_locals: svc_locals
          }, f: (acc, titem) =>
            if titem.transport != none && titem.children |> count > 0 {
              let entries = titem.children |> map(c =>
                OpEntry { name: authored_name_at(source_indices: env.source_indices, node: c), outputs: inferred_to_outputs(inferred: c.inferred, span: c.span, source_indices: env.source_indices), params: c.params }
              )
              let root = namespace_root_from_properties(properties: titem.properties, name: authored_name_at(source_indices: env.source_indices, node: titem), source_indices: env.source_indices)
              InferScopeComponents {
                svc_registry: map_insert(acc.svc_registry, authored_name_at(source_indices: env.source_indices, node: titem), entries),
                svc_locals: map_insert(acc.svc_locals, root, nominal_type_binding(name: root))
              }
            }
            else if titem.body != none && (titem.params |> count == 0) && titem.transport == none && titem.connective == NoConnective && titem.inferred != none {
              InferScopeComponents {
                svc_registry: acc.svc_registry,
                svc_locals: map_insert(acc.svc_locals, authored_name_at(source_indices: env.source_indices, node: titem), TypeBinding { name: authored_name_at(source_indices: env.source_indices, node: titem), resolved: resolved_type(n: titem), provenance: SubValueUnknown })
              }
            }
            else {
              acc
            }
          )
          merge_scope_from_imports(remaining: remaining |> skip(1), parent_index: parent_index, env: env,
            svc_registry: parent_result.svc_registry, svc_locals: parent_result.svc_locals)
        Absent =>
          merge_scope_from_imports(remaining: remaining |> skip(1), parent_index: parent_index, env: env,
            svc_registry: svc_registry,
            svc_locals: svc_locals)
      }
  }
}

fn nominal_leaf_type(name: String) -> Node {
  nominal_type_ref(name: name)
}

fn nominal_type_binding(name: String) -> TypeBinding {
  TypeBinding { name: name, resolved: nominal_leaf_type(name: name), provenance: SubValueUnknown }
}

type FieldRecursionResult {
  shape: RecursionShape
  element_type: String
}

fn classify_field_recursion(field_node: Node, parent_name: String, recursive_type_set: Set<String>, source_indices: Map<String, NewlineIndex>) -> FieldRecursionResult? {
  let type_expr = match field_node.inferred {
    Present { value: Resolved { node: rt } } => rt
    _ => field_node_type_expr(n: field_node)
  }
  let field_type_name = authored_name_at(source_indices: source_indices, node: type_expr)
  if field_type_name == parent_name {
    match field_node.return_cardinality {
      CardOptional => Present { value: FieldRecursionResult { shape: OptionalRecursion, element_type: parent_name } }
      _ => Present { value: FieldRecursionResult { shape: DirectRecursion, element_type: parent_name } }
    }
  } else if is_container_type(name: field_type_name) {
    let arity = match container_expected_arity(name: field_type_name) {
      Present { value: a } => a
      Absent => 0
    }
    let value_index = if arity == 2 { 1 } else { 0 }
    let value_type = match type_expr.children |> skip(value_index) |> first {
      Present { value: t } => authored_name_at(source_indices: source_indices, node: t)
      Absent => ""
    }
    let is_recursive_element = value_type == parent_name || set_contains(recursive_type_set, value_type)
    if is_recursive_element {
      let elem = if value_type == parent_name { parent_name } else { value_type }
      match field_type_name {
        "List" => Present { value: FieldRecursionResult { shape: ListRecursion, element_type: elem } }
        "Set" => Present { value: FieldRecursionResult { shape: SetRecursion, element_type: elem } }
        "Map" => Present { value: FieldRecursionResult { shape: MapValueRecursion, element_type: elem } }
        _ => none
      }
    } else { none }
  } else if set_contains(recursive_type_set, field_type_name) {
    match field_node.return_cardinality {
      CardOptional => Present { value: FieldRecursionResult { shape: OptionalRecursion, element_type: field_type_name } }
      _ => Present { value: FieldRecursionResult { shape: DirectRecursion, element_type: field_type_name } }
    }
  } else { none }
}

fn collect_fields_inductive(fields: List<Node>, parent_name: String, variant_name: String, recursive_type_set: Set<String>, acc: Map<String, List<InductiveField>>, source_indices: Map<String, NewlineIndex>) -> Map<String, List<InductiveField>> {
  fields |> fold(init: acc, f: (field_acc, field_node) =>
    match classify_field_recursion(field_node: field_node, parent_name: parent_name, recursive_type_set: recursive_type_set, source_indices: source_indices) {
      Present { value: result } =>
        put_inductive_field_cross(fields: field_acc, type_name: parent_name, variant_name: variant_name, field_name: authored_name_at(source_indices: source_indices, node: field_node), shape: result.shape, element_type: result.element_type)
      Absent => field_acc
    }
  )
}

fn collect_item_inductive_fields(item: Node, recursive_type_set: Set<String>, source_indices: Map<String, NewlineIndex>) -> Map<String, List<InductiveField>> {
  let item_name = authored_name_at(source_indices: source_indices, node: item)
  match item.connective {
    Disj =>
      item.children |> fold(init: empty_map(), f: (variant_acc, variant_node) =>
        collect_fields_inductive(fields: variant_node.children, parent_name: item_name, variant_name: authored_name_at(source_indices: source_indices, node: variant_node), recursive_type_set: recursive_type_set, acc: variant_acc, source_indices: source_indices)
      )
    Conj =>
      collect_fields_inductive(fields: item.children, parent_name: item_name, variant_name: "", recursive_type_set: recursive_type_set, acc: empty_map(), source_indices: source_indices)
    _ => empty_map()
  }
}

fn build_item_inductive_fields(items: List<Node>, recursive_type_set: Set<String>, source_indices: Map<String, NewlineIndex>) -> Map<String, List<InductiveField>> {
  items |> fold(init: empty_map(), f: (acc, item) =>
    merge_inductive_fields(left: acc, right: collect_item_inductive_fields(item: item, recursive_type_set: recursive_type_set, source_indices: source_indices))
  )
}

fn nominal_ref_node(name: String, span: SourceSpan, ident_span: SourceSpan?) -> Node {
  Node {
    name: name, span: span, ident_span: ident_span, children: [],
    connective: NoConnective, params: [],
    inferred: Present { value: Resolved { node: nominal_leaf_type(name: name) } },
    return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [],
    type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
  }
}

fn resolved_callable_type(func_params: List<Node>, ret: Node) -> Node {
  make_callable_type(func_params: func_params, ret: ret)
}

fn namespace_root_from_properties(properties: List<Node>, name: String, source_indices: Map<String, NewlineIndex>) -> String {
  match properties |> filter(p => field_init_node_name_at(n: p, source_indices: source_indices) == "namespace_root") |> first {
    Present { value: ns_prop } =>
      match expr_literal_string_optional(expr: field_init_node_value(n: ns_prop)) {
        Present { value: root } => root
        Absent => name
      }
    Absent => name
  }
}

fn namespace_alias_target_path(item: Node, source_indices: Map<String, NewlineIndex>) -> String? {
  find_property_string(props: item.properties, prop_name: "namespace_alias_target", source_indices: source_indices)
}

fn is_namespace_alias_item(item: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match namespace_alias_target_path(item: item, source_indices: source_indices) {
    Present { value: _ } => true
    Absent => false
  }
}

fn namespace_alias_binding_for_target(
  item: Node,
  target_node: Node,
  source_indices: Map<String, NewlineIndex>
) -> TypeBinding {
  TypeBinding {
    name: authored_name_at(source_indices: source_indices, node: item),
    resolved: target_node,
    provenance: SubValueUnknown
  }
}

fn expr_span(texpr: Node) -> SourceSpan {
  texpr.span
}

fn ok_infer(texpr: Node) -> InferResult {
  InferResult {
    typed: texpr,
    diagnostics: []
  }
}

fn semantic_expr_error_node(message: String, span: SourceSpan) -> Node {
  make_expr_error_node(kind: SemanticExprError, message: message, span: span)
}

fn internal_expr_error_node(message: String, span: SourceSpan) -> Node {
  make_expr_error_node(kind: InternalExprError, message: message, span: span)
}

fn lookup_variant_parent_enum(scope: InferScope, name: String) -> String? {

  match map_get(scope.locals, name) {
    Present { value: binding } =>
      match lookup_type_for(env: scope.type_env, node: binding.resolved) {
        Present { value: parent } =>
          let is_coproduct = parent.connective == Disj
          if is_coproduct {
            if has_child_named(n: parent, name: name, source_indices: scope.type_env.source_indices) {
              Present { value: authored_name_at(source_indices: scope.type_env.source_indices, node: binding.resolved) }
            } else { none }
          } else { none }
        Absent => none
      }
    Absent => none
  }
}

// A bare variant reference's inferred type is its OWNER coproduct, and resolution
// binds that owner as the DECLARATION node — whose children are the coproduct's arms,
// not type arguments. A generic owner therefore reaches emission uninstantiated and the
// renderer consumes an arm as a type argument: `type Optional<T> = Absent | Present {
// value: T }` renders `Option<Absent>` from child 0, which is not a Rust type.
// When the context supplies an expected type that owns this variant, that expected node
// IS the instantiated owner, so prefer it. Returns none when there is no expected type
// or it does not own this variant, leaving the declaration-node behavior unchanged.
// This is the same lookup the unresolved-name arm below already performs; it is hoisted
// here so a variant that RESOLVES gets it too, rather than only one that does not.
fn expected_variant_owner_instantiation(expected: Node?, name: String, scope: InferScope) -> Node? {
  match expected {
    Present { value: exp } =>
      let exp_enum = expand_scrut_type_for_variant_lookup(scrut_node: exp, env: scope.type_env)
      match find_child_named(n: exp_enum, name: name, source_indices: scope.type_env.source_indices) {
        Present { value: _ } => Present { value: exp_enum }
        Absent => none
      }
    Absent => none
  }
}

// Deliberately narrower than "the expected type wins", on TWO axes.
//
// IDENTITY: the expected type is adopted only when its OWN head names the coproduct
// resolution already bound (owner_name), so this is an INSTANTIATION of the owner the
// binder chose, never a re-targeting to a different coproduct that happens to declare
// an arm of the same name (Absent is an arm of Optional, ObservationVerdict and
// ConvergeVerdict alike). Re-targeting would leave the returned parent_enum naming one
// coproduct while the inferred type named another.
//
// CARDINALITY: optionality is NOT a wrapper type here — `BinOp?` is a BinOp node whose
// return_cardinality is CardOptional (00_core with_optional_cardinality), so a head-name
// comparison alone cannot see it. For `binop: Mod` against an expected `BinOp?` the head
// IS "BinOp" and the arm IS found, but the constructor's own type is BinOp and the
// optionality is a coercion the emitter performs; adopting the expected node makes the
// value look already-optional, the wrap is skipped, and `binop: BinOp::Mod` is emitted
// where `Some(BinOp::Mod)` is owed. So adoption additionally requires the expected node
// to be Required: the variant must belong to the coproduct at the expected type's OWN
// level (Absent IS an arm of Optional) rather than being reached through a coercion.
// Both halves were caught by the self-host fixed point re-emitting v1's own sources,
// not by reasoning about them — a head-only check and then a name+identity check each
// passed every other measurement while still dropping the wrapper.
fn variant_reference_inferred_node(expected: Node?, name: String, owner_name: String, scope: InferScope, fallback: Node) -> Node {
  match expected {
    Present { value: exp } =>
      if exp.return_cardinality == Required
        && authored_name_at(source_indices: scope.type_env.source_indices, node: exp) == owner_name {
        match expected_variant_owner_instantiation(expected: expected, name: name, scope: scope) {
          Present { value: _ } => exp
          Absent => fallback
        }
      } else { fallback }
    Absent => fallback
  }
}

fn variant_owner_node(scope: InferScope, name: String) -> Node? {
  if contains(name, ".") {
    match symbol_index_lookup(index: scope.type_env.symbol_index, qualified_name: name) {
      Present { value: resolved } =>
        if resolved.connective == Disj && has_child_named(n: resolved, name: qualified_last_segment(name: name), source_indices: scope.type_env.source_indices) {
          Present { value: resolved }
        } else { none }
      Absent => none
    }
  } else {
  match map_get(scope.locals, name) {
    Present { value: binding } =>
      match lookup_type_for(env: scope.type_env, node: binding.resolved) {
        Present { value: owner } =>
          let owner_is_coproduct = owner.connective == Disj
          if owner_is_coproduct {
            if has_child_named(n: owner, name: name, source_indices: scope.type_env.source_indices) {
              Present { value: owner }
            } else { none }
          } else { none }
        Absent => none
      }
    Absent => none
  }
  }
}

fn infer_var_binding_kind(scope: InferScope, name: String) -> VarBindingKind {
  match lookup_variant_parent_enum(scope: scope, name: name) {
    Present { value: parent_enum } => VariantValueBinding { parent_enum: parent_enum }
    Absent =>
      match map_get(scope.locals, name) {
        Present { value: _ } =>
          if map_has(scope.match_bound_names, name) { MatchBoundBinding }
          else { LocalValueBinding }
        Absent => FunctionValueBinding
      }
  }
}

fn inference_error(message: String, span: SourceSpan, module_name: String) -> ErrorNode {
  make_error_node(diagnostic: InternalError { message: message, span: span }, module_name: module_name)
}

fn ambiguous_reference_refusal(name: String, candidates: List<String>, span: SourceSpan, scope: InferScope) -> InferResult {
  InferResult {
    typed: semantic_expr_error_node(message: concat("ambiguous reference '", name, "'"), span: span),
    diagnostics: [make_error_node(diagnostic: AmbiguousReference { name: name, candidates: candidates, span: span }, module_name: scope.module_name)]
  }
}

data constructor_reference_admission_enforced: Bool = true

data constructor_reference_admission_frontier_note: String = "Counted v1 seed realization for ConstructorReferenceAdmission (Horn 3, msg_968d6c24): unified infer construction-admission beside sole_constructor record-literal refusal. Dissolves when compiler_frontier_row_04_infer self-emits CargoGreen and v2 infer is the production typecheck path (^migrate_when_closure_self_emits_cargo_green)."

fn constructor_reference_admission_enforced_now() -> Bool {
  constructor_reference_admission_enforced
}

fn decl_ref_coords_equal(a: DeclRefCoords, b: DeclRefCoords) -> Bool {
  a.module_path == b.module_path && a.decl_name == b.decl_name
}

fn caller_decl_coords(scope: InferScope) -> DeclRefCoords? {
  if scope.caller_decl_name == "" {
    none
  } else {
    Present {
      value: DeclRefCoords {
        module_path: scope.module_name,
        decl_name: scope.caller_decl_name
      }
    }
  }
}

fn declaration_lookup_failure_label(cause: DeclarationLookupFailure) -> String {
  match cause {
    DeclarationNotIndexedAtQualifiedName { qualified_name: qn } =>
      concat("no declaration is indexed at '", qn, "'")
  }
}

// ADMISSION IS EXACT FOR EVERY CALLER, INCLUDING SAME-MODULE ONES.
//
// This function used to skip the permitted-list comparison entirely when caller and callee shared
// a module, so the semantics the compiler implemented were "a permitted caller OR any declaration
// in the defining module" -- an implicit wildcard that never appeared in the authored declaration
// and that no reader of a sealed `fn` could see. Measured before the repair: a probe added to
// gunbc.host_effect_realize, absent from the admitted list, calling the elevated execution leaf
// with ["/bin/rm", "-rf", "/"], typechecked and resolved with no diagnostic at all, while the same
// call from another module refused.
//
// That made every same-module permitted list unverified data rather than an executable
// declaration: a "private handler" co-located with its serializer was not private, an arbitrary
// helper added inside the module bypassed the wall, and an incorrect caller list could sit green
// forever. The last one is not hypothetical -- the srv3 seal's own lists were first authored by
// hand with a caller that does not exist and two attributed to the wrong enclosing function, and
// nothing in the compiler would have said so.
//
// The repair deletes the branch and nothing else: the exact caller-coordinate comparison, the
// ConstructorCallAdmissionRefused diagnostic, and the caller-identity-unavailable arm were all
// already here and already correct. Self-calls obey the same rule -- a recursive sealed function
// lists itself -- because an invisible self exception would replace the module wildcard with a
// smaller undeclared one.
fn constructor_call_admission_diags(
  callee_name: String,
  scope: InferScope,
  span: SourceSpan
) -> List<ErrorNode> {
  if !constructor_reference_admission_enforced_now() {
    []
  } else {
    match func_decl_binding_for_call(
      func_env: scope.func_env,
      type_env: scope.type_env,
      name: callee_name
    ) {
      ExactConstructorDeclaration { identity: identity, declaration: declaration_node } =>
        match fn_admit_callers(n: declaration_node, source_indices: scope.type_env.source_indices) {
          Present { value: permitted } =>
              match caller_decl_coords(scope: scope) {
                Present { value: caller } =>
                  if permitted |> any(p => decl_ref_coords_equal(a: p, b: caller)) {
                    []
                  } else {
                    [
                      make_error_node(
                        diagnostic: ConstructorCallAdmissionRefused {
                          constructor_module_path: identity.owner_module_path,
                          constructor_decl_name: identity.decl_name,
                          caller_module_path: caller.module_path,
                          caller_decl_name: caller.decl_name,
                          permitted_callers: permitted |> map(p => decl_ref_coords_label(coords: p)),
                          span: span
                        },
                        module_name: scope.module_name
                      )
                    ]
                  }
                Absent =>
                  [
                    make_error_node(
                      diagnostic: ConstructorCallAdmissionRefused {
                        constructor_module_path: identity.owner_module_path,
                        constructor_decl_name: identity.decl_name,
                        caller_module_path: scope.module_name,
                        caller_decl_name: "<unknown>",
                        permitted_callers: permitted |> map(p => decl_ref_coords_label(coords: p)),
                        span: span
                      },
                      module_name: scope.module_name
                    )
                  ]
              }
          Absent => []
        }
      NotAdmissionBearingReference => []
      AdmissionBearingDeclarationUnavailable { identity: identity, cause: cause } =>
        [
          inference_error(
            message: concat(
              "constructor reference admission cannot establish the declaration identity of '",
              identity.decl_name, "' owned by '", identity.owner_module_path, "': ",
              declaration_lookup_failure_label(cause: cause),
              " -- refusing rather than reading admission facts off a resolved value node"),
            span: span,
            module_name: scope.module_name
          )
        ]
    }
  }
}

fn constructor_reference_admission_refusal(
  callee_name: String,
  span: SourceSpan,
  scope: InferScope
) -> InferResult {
  InferResult {
    typed: semantic_expr_error_node(
      message: concat("constructor call admission refused for '", callee_name, "'"),
      span: span
    ),
    diagnostics: constructor_call_admission_diags(callee_name: callee_name, scope: scope, span: span)
  }
}

// Admission decides a RESOLVED DECLARATION IDENTITY, never an identifier spelling. A body
// binding shadows any declaration of the same spelling, so a local named `token` must win
// normally even when a sealed `token` constructor exists elsewhere; refusing it would be a
// fabricated refusal, which DESIGN section 5 forbids exactly as it forbids the fail-open this
// wall closes. body_locals is the corpus's existing shadowing authority for precisely this
// question (call_locals_shadow_note: a let-bound or parameter callee skips sig lookup), so it
// is reused rather than a second notion of shadowing being minted beside it.
// EXECUTED EVIDENCE COVERS TWO BINDER FORMS, not four. The controls prove fn-parameter and
// let shadowing (ct_constructor_call_admission_shadowing_test). Whatever binder forms
// body_locals populates -- match binders and lambda parameters among them -- inherit this arm
// by construction, because the arm reads body_locals rather than enumerating forms; but
// inheritance by construction is not execution, and this comment previously asserted all four
// as though they were controlled. Adding the two missing forms is a control addition, not a
// design change: the discriminator is already the right one.
fn constructor_reference_admission_unshadowed(
  callee_name: String,
  span: SourceSpan,
  scope: InferScope
) -> InferResult? {
  if map_has(scope.body_locals, callee_name) {
    none
  } else {
    constructor_reference_admission_early_refusal(callee_name: callee_name, span: span, scope: scope)
  }
}

fn constructor_reference_admission_early_refusal(
  callee_name: String,
  span: SourceSpan,
  scope: InferScope
) -> InferResult? {
  let admission_diags = constructor_call_admission_diags(callee_name: callee_name, scope: scope, span: span)
  match admission_diags |> first {
    Present { value: _ } =>
      Present { value: constructor_reference_admission_refusal(callee_name: callee_name, span: span, scope: scope) }
    Absent => Absent
  }
}

fn type_mismatch_error(expected: String, got: String, span: SourceSpan, module_name: String) -> ErrorNode {
  make_error_node(diagnostic: TypeMismatch { expected: expected, got: got, span: span }, module_name: module_name)
}

data seed_node_traversal_frontier: String = "\u{1F7E1} dissolve-on: v1_seed_deleted_at_v2_self_host (opened 2026-07-31) — the v1 seed reads and recurses substrate Node storage directly instead of consuming a canonical traversal surface. Recorded as ONE frontier row for the CLASS, because that is the honest grain: the idiom is 16 self-recursive `children |> flat_map` sites on origin/main across 04_emit_info, 04_sigs, 04_infer, 05_emit, 05_emit_rust, compile and complexity (collect_type_names_from_node, named_type_vars_in_node, collect_value_ref_names and siblings), plus 579 direct Node-storage field reads in 04_infer alone. collect_explicit_return_values is the 17th instance and v1.compiler.trait_derive_emit.v1_type_expr_contains_param_name the 18th (codex review 47248), not new classes, and a per-function row would assert separable work that does not exist while 16 identical siblings carried none (codex reviews 45570, 45580, 45666). SIBLING COUNT IS NOT THE JUSTIFICATION and the reviewer is right to reject that reading — precedent is debt, not permission. The justification is that no canonical surface is REACHABLE here: fold_node and node_query are v2 substrate, no v1 seed module imports v2, and v1 COMPILES v2, so routing seed inference through v2's fold inverts the bootstrap; and no shared v1 walker exists to route through, because every v1 collector recurses itself. DESIGN's fold_node line is scoped to the 7 v2 stages. COST OF CLOSING NOW, which is why this is retained rather than accepted: building a v1-local generic traversal for one call site adds another shape without removing any of the existing ones, and migrating all 18 is a seed-wide refactor of the stage that IS the traversal — against a seed whose declared endpoint is deletion. DISSOLVES WHEN the v1 seed is deleted at v2 self-host, at which point every row in this class goes with it; the same trigger compiler_diagnostic_seed_projection_note carries for the hand-Rust arms, because it is the same seed and the same endpoint."

fn collect_explicit_return_values(n: Node) -> List<Node> {
  match n.expr_data {
    ExprLambda => []
    ExprReturn =>
      concat(
        [return_value(texpr: n)],
        n.children |> flat_map(c => collect_explicit_return_values(n: c)))
    _ => n.children |> flat_map(c => collect_explicit_return_values(n: c))
  }
}

fn explicit_return_conformance_diags(declared: Node, body_typed: Node, scope: InferScope) -> List<ErrorNode> {
  collect_explicit_return_values(n: body_typed)
    |> flat_map(returned => declared_type_conformance_diags(
         declared: declared,
         produced: resolved_type(n: returned),
         span: returned.span,
         scope: scope))
}

data explicit_return_conformance_note: String = "An EARLY return is a second exit from the same declaration and must meet the same declared type as the last expression. The conformance wall first checked only the body's final inferred type, so `fn f(cond: Bool) -> Int { if cond { return \"wrong\" } 1 }` compiled clean — the block's value is the trailing 1, which conforms, and the wrong-typed exit was never compared against anything (codex review 45472, confirmed by execution: exit 0 before, a located TypeMismatch after). The check reuses declared_type_conformance_diags rather than minting a second relation, so the early exit is judged by exactly the ground-kernel-scalar and ground-element-collection discipline the trailing expression is judged by, and it widens with that gate rather than beside it. THE WALK STOPS AT A LAMBDA BOUNDARY, and it did not at first. A `return` inside a nested lambda belongs to the LAMBDA's callable return type, not the enclosing declaration's, so recursing through ExprLambda checked it against the wrong declaration and refused correct code — a fabricated refusal, which §5 forbids exactly as it forbids a fabricated success, and the mirror image of the hole this fn was added to close (codex review 45481, confirmed by execution: a lambda returning String inside a fn declared -> Int refused with expected Primitive(Int) got Primitive(String)). Every callable boundary is a new declaration and its returns are judged against it, not against whatever encloses it. THE WALKER'S OWN DISPOSITION, distinct from the lambda-coverage trigger below and asked for separately (codex review 45580): it is the seed's, not this function's. Self-recursive `children |> flat_map` collection is the v1 seed's only traversal idiom — 16 such sites on origin/main across 04_emit_info, 04_sigs, 04_infer, 05_emit, 05_emit_rust, compile and complexity (collect_type_names_from_node, named_type_vars_in_node, collect_value_ref_names and siblings) — and there is no shared v1 walker to route through, because each collector recurses itself. Nor is there a canonical fold to reach for: fold_node and node_query are v2 substrate, no v1 seed module imports v2, and v1 COMPILES v2, so routing seed inference through v2's fold inverts the bootstrap. DESIGN's fold_node line is scoped to the 7 v2 stages. So this is the 17th instance of a 16-instance idiom, and its trigger is the one every sibling carries: the v1 seed shrinks to zero at v2 self-host and they dissolve together. Generalizing a shared collector for this one call site alone would ADD a 17th shape rather than remove one; the dissolution that is real is the seed's. That reasoning was recorded on where_refinement_receiver_peel_note for the same class and NOT here, which is why it had to be found twice — a disposition stated on one carrier and omitted from its sibling is not stated. Lambda returns are consequently NOT yet judged here — the lambda's own declared return is not threaded to this post-pass — which is a narrowing, stated rather than implied, and it dissolves when the walk carries each callable's declared return rather than only infer_item's."

fn declared_return_type_node(item: Node) -> Node {
  preserve_outer_optional_cardinality(outer: item, inner: resolved_type(n: item))
}

fn conformance_ground_kernel_scalar(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let plain_shape = n.connective == NoConnective && n.children |> count == 0
  let required = n.return_cardinality == Required
  let kernel_named = is_kernel_type(name: authored_name_at(source_indices: source_indices, node: n))
  plain_shape && required && kernel_named
}

fn conformance_ground_element_collection(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let shaped_container = n.connective == NoConnective
    && node_is_element_collection(n: n, source_indices: source_indices)
    && node_is_keyed_collection(n: n, source_indices: source_indices) == false
  let required = n.return_cardinality == Required
  let element_ground = match n.children |> first {
    Present { value: el } => conformance_ground_kernel_scalar(n: child_type_node(ch: el), source_indices: source_indices)
    Absent => false
  }
  shaped_container && required && element_ground
}

fn conformance_ground_type(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  conformance_ground_kernel_scalar(n: n, source_indices: source_indices)
    || conformance_ground_element_collection(n: n, source_indices: source_indices)
}

data conformance_unjudged_live_hole_note: String = "PROVEN LIVE HOLE, AND THE REASON THE UNJUDGED ADVISORY IS EXCLUDED FROM THIS PR (codex reviews 45647, 45767). The branch now returns [] for the unjudged case, matching origin/main exactly, so this PR neither closes nor worsens the class; it lands with the identity capability instead. The record below is kept because the witness and the five measured attempts are what that lane starts from. The unjudged branch is not merely unmeasured — a program that is simply WRONG reaches emission through it. Executed witness: `type R \{ x: Int \}` `type S \{ y: String \}` `fn wrong_record() -> R \{ S \{ y: \"a\" \} \}` compiles EXIT 0 and EMITS TWO FILES, on this branch and on origin/main alike. Two structurally unrelated named records is not a representation gap; it is the conformance half of #7479. It was briefly reported as a counted advisory here, and that is precisely what was removed: counting it protects nothing, and a number beside a wrong program is the fabricated success DESIGN 5 forbids, one level up. THE FIX WAS ATTEMPTED AND IS NOT LANDED, and the measurements are recorded because they are the real cost of the next attempt rather than a reason to stop looking. Three successive narrowings of a refuse-when-both-sides-are-named-structured rule were each run against the whole corpus: (1) both sides structured and named -> 90 refusals of CORRECT code, dominated by the two-representation optionality class (24 Node(Optional) vs Primitive(Node), plus Coproduct(X) vs Coproduct(Optional)); (2) narrowed to inhabited named RECORDS with kernel scope names excluded -> 15; (3) additionally guarding the raw nodes -> 27, and the population had by then shifted to a NEW class, produced sides that are let-BINDING names (module_emit_scope, scope_after_expr, lookup_item) rather than types. The count moving 90 -> 15 -> 27 rather than monotonically down is the finding: each guard displaces the false-positive population instead of shrinking it, which is the exemption-accumulation this wall refuses elsewhere, and shipping any of the three would red correct code. So the arm is NOT landed, and with no arm to land the residue is left exactly where main leaves it rather than dressed up as partial coverage. The blocking obstacle is named and is not vague: the produced-side node reaching this branch is not reliably a TYPE — it can be a nominal reference, a kernel encoding of cardinality or absence, an anonymous literal, or a let-binding identity — so no predicate over its shape can separate a real mismatch from a representation gap until produced-side type identity is established upstream. A FOURTH attempt isolated the obstacle exactly, and it is the reason the other three moved the population instead of shrinking it: guarding on `both sides are Conj whose authored name RESOLVES via lookup_type_by_name to a record declaration` still refused 14 seed sites, and every one had a LET-BINDING name on the produced side (module_emit_scope, scope_after_expr, lookup_item, service_fallback_transport). lookup_type_by_name resolves those because bindings and types inhabit ONE name environment, so the guard cannot tell a type identity from a binding identity — which is the stated obstacle, now demonstrated rather than inferred. A FIFTH attempt tested the one discriminator that looked left — requiring the resolved declaration to NAME ITSELF, on the theory that a type declares its own name while a binding resolves to a type named differently — and it returned the IDENTICAL 14 sites, because lookup_type_by_name on a binding returns a node carrying the BINDING's name, not its type's. The name environment does not merely conflate the two lookups; the resolved node itself carries no separable type identity. No predicate over the produced node's shape or name can close this class. Dissolve-on: feature:conformance-produced-type-identity — the produced node carries a resolved type identity rather than a shape to be guessed at, at which point the refusal arm is one predicate over two identities and this row deletes. THE PERMISSION IS NOT THIS PATH'S AND THAT WAS MEASURED, NOT ASSERTED: the identical program built against origin/main compiles EXIT 0, emits 2 files and reports ZERO diagnostics, and this branch now does the same, because the unjudged branch returns the same empty list main returns. So the conformance path neither newly permits the emission nor closes it. THE COUNTED-ADVISORY MIDDLE GROUND WAS TRIED AND REJECTED, and the rejection is the useful part of this row: an advisory made the fail-open visible without making it stop, and review held that visibility is not protection when the program is PROVABLY wrong rather than merely unproven (codex reviews 45647, 45695, 45711, 45767, 45777). Agreed on execution — the R/S witness above emitted two files under the advisory. So the class is left at main's behavior and named here with its trigger, and what ships is the method-existence wall, which does refuse and does emit nothing. That is a judgment about sequencing, not a claim that the hole is acceptable: a declared boundary with an executed witness, an owner-facing trigger and a measured cost, and deliberately NOT a success path with a number beside it."

data conformance_expansion_depth_note: String = "MEASUREMENT RECEIPT FOR THE NEXT LANE, NOT A DESCRIPTION OF LIVE CODE — the expansion-peeling comparison it records was deleted together with the unjudged advisory it fed (codex review 45767), and this row is kept because the measurement is what the next attempt starts from rather than re-derives. A declared type and a produced type routinely arrive at DIFFERENT EXPANSION DEPTHS: the declaration side is a nominal reference to T while the body side is T's already-expanded body, so comparing them as they arrive reads one type as two. Measured over the whole corpus that was the majority of the unjudged residue — 203 Node, 173 Outcome, 46 Witness, 43 Optional, 38 PipelineStep and a long tail, each a reference and its own body — which is why the frontier first read 3005 and then 1566 once each side was resolved through lookup_type_for and peeled through peel_where_refinement_base, the SAME peel the method wall uses (DESIGN section 3: one authority, two consumers, not a second one minted here). Reporting those as unjudged was not a conservative silence but a WRONG COUNT, and an inflated frontier buries the residue that genuinely cannot be decided under pairs that were never in doubt. THE COMPARISON MUST BE THE STRUCTURAL RELATION, NOT A RENDERED SHAPE STRING, and the first version of this got that wrong in a way worth keeping on the record: it compared node_type_shape output, which collapses every anonymous product to the literal text Product(<anon>) and every named product to its OUTER NAME ONLY, discarding fields, variants and their types. So two structurally different records compared EQUAL and were stamped proven-conforming — the exact fail-open this wall exists to delete, reintroduced while removing a different one, and by the same mechanism as the earlier 1.0/0.0 seam: a projection that looks like evidence used where a proof was required (codex review 45600). A display projection is for MESSAGES; a judgment must consume the structural relation. That constraint outlives the deleted code and binds whoever rebuilds it: node_type_compatible recurses into container elements and compares canonical template names, so identity is established rather than rendered, but its known imprecision is only safe where a mismatch costs a count rather than a refusal — it reports MISMATCH for the four classes of correct code enumerated in declared_type_conformance_note, so wiring it to a refusal without first establishing produced-side type identity (feature:conformance-produced-type-identity) reds correct code. That is the trap the five measured attempts in conformance_unjudged_live_hole_note fell into."

fn declared_type_conformance_diags(declared: Node, produced: Node, span: SourceSpan, scope: InferScope) -> List<ErrorNode> {
  let si = scope.type_env.source_indices
  let both_ground = conformance_ground_type(n: declared, source_indices: si)
    && conformance_ground_type(n: produced, source_indices: si)
  if !both_ground { [] }
  else if node_type_compatible(left: declared, right: produced, source_indices: si) { [] }
  else {
    [type_mismatch_error(
      expected: node_type_shape(n: declared, source_indices: si),
      got: node_type_shape(n: produced, source_indices: si),
      span: span,
      module_name: scope.module_name
    )]
  }
}

data declared_type_conformance_note: String = "WALL (DESIGN §5) — a declaration must CONSTRAIN the value it declares, not merely state an intent beside it. infer_item passed the declared return into body inference as expected but then kept the declaration own inferred return REGARDLESS of what the body produced, and the generic expected handling in infer_expr applies where-refinement checks rather than a general actual-subtype-of-declared judgment. So fn f() -> Int { \"wrong\" } typechecked with ZERO diagnostics and the lie surfaced at the first consumer, field access, or host parser. Three positions are checked against their declaration: a fn body vs its declared return (both the param-carrying and paramless arms) and a data value vs its type annotation. THE SCOPE IS DELIBERATELY NARROW AND THE NARROWING IS THE FINDING. node_type_compatible is the corpus compatibility relation and it is NOT sound as a general declared-versus-produced conformance judgment: measured over the whole tree, four independent classes of CORRECT code reported a mismatch, each a place where the relation compares names across representations it never peels. (1) OPTIONALITY LIVES IN TWO REPRESENTATIONS — a fn declared -> String? carries optionality in item.return_cardinality while its body produces the nominal Optional coproduct, so 4 correct sites in 05_emit_rust.dag read as expected Primitive(String) got Coproduct(Optional). (2) BRAND ALIASES ARE NOT PEELED — Hash is ContentHash is a branded String, so 3 correct sites in dag_collect_support.dag read as expected Primitive(String) got Primitive(Hash); the same class the method wall measured as NonEmptyStr arriving as Product(NonEmptyStr). (3) ANONYMOUS RECORD LITERALS — the corpus writes a typed list as [ { name: ..., .. }, .. ] without repeating the nominal type, so 8+ correct rows in dag/std/algebra.dag read as expected Container(List,Product(AlgebraFieldTemplate)) got Container(List,Product(<anon>)). (4) CARDINALITY IS NOT ON THE RESOLVED TYPE NODE — resolved_type(n: item) drops the declaration optional marker, which is why the declared side is built through preserve_outer_optional_cardinality, the existing single authority for carrying an outer node cardinality onto an inner type node. Each class was found by RUNNING the wall over the corpus, never by reasoning about it, and the list is not known to be exhaustive — which is precisely why this wall does not chase them with exemptions. Four ad-hoc carve-outs would leave a wall that is neither principled nor trustworthy, and fabricating a refusal is the mirror image of the fabricated success the wall exists to delete. So the predicate is POSITIVE ESTABLISHMENT, the same discipline the method wall uses: judge ONLY when both sides are ground kernel scalars — plain shape, Required cardinality, and a name in std.types kernel_type_set — because then a name difference IS a real difference with no alias, brand, container, coproduct or cardinality representation in between. That admits the whole class the operator named (declaring one primitive and returning another, fn f() -> Int { \"a string\" } and data d: Int = \"a string\") and admits nothing it cannot prove. THE GATE WAS FIRST WRITTEN AS SCALAR-ONLY AND THAT WAS TOO NARROW, which review found before any consumer did: a plain shape excludes a List, so a declared List<Int> whose body produced a List<String> was indistinguishable from a conforming declaration and compiled clean, and calling that state UNJUDGED in prose did not model it (codex review 45398). The widening is the SAME argument, not an exception to it — a container of a ground kernel scalar has no alias, brand, coproduct, anonymous-literal or cardinality representation standing between the two sides either, so a difference in the element name is a real difference exactly as a difference in a scalar name is. conformance_ground_type therefore admits a ground kernel scalar OR a Required, non-keyed element collection whose element is one, and the whole dag + src/v2 corpus stays clean under it, which is the same instrument that found the four false-positive classes above. The discriminating control was run against the PRIOR compiler rather than reasoned about: `fn f() -> List<Int> { [\"a\", \"b\"] }` with `data d: List<String> = [1, 2]` compiles with exit 0 on the pre-widening binary and refuses with two located mismatches on this one. EVERYTHING STILL WIDER IS UNJUDGED, AND IN THIS PR UNJUDGED IS A SILENCE — a deliberate narrowing, not an oversight. It is worth stating why the opposite was tried first: an unproven declaration returning an empty diagnostic list is byte-for-byte indistinguishable in the output from a proven-conforming one, so the absence of a check reads as the presence of a proof (codex review 45500). Making it a counted DeclaredTypeConformanceUnjudged advisory answered that objection and raised a larger one — an advisory does not stop a wrong program, so a proven-wrong program still emitted with a number beside it (codex reviews 45647, 45695, 45711, 45777). That advisory measured the frontier at 1566 declarations whole-tree and is EXCLUDED here (codex review 45767), because the branch could not be made to refuse safely either — see conformance_unjudged_live_hole_note for the executed witness and the five measured attempts. So this branch returns [] for the unjudged case, which is byte-for-byte what origin/main does, and this PR's contribution to conformance is exactly the REFUSALS it can prove: ground kernel scalars and ground element collections. Nothing about the unjudged class is worse than main; it is simply not addressed here, and it lands with the identity capability rather than beside it. IT WAS FIRST MEASURED AT 3005 AND THAT NUMBER WAS WRONG, which matters because the count is the whole bound: nearly half of it was one type compared against ITSELF at two expansion depths (a declaration naming T versus a body producing T's expanded body), so the frontier was reported almost twice its true size — see conformance_expansion_depth_note. An inflated frontier is not a conservative error; it hides the residue that genuinely cannot be decided underneath pairs that were never in doubt. It fires only where the declared and produced SHAPES DIFFER, because identical shapes have nothing to prove and counting them would bury the signal under declarations nobody doubts — the residue that matters is exactly the set where a mismatch could hide. Each numbered class above is a promotion trigger, and each promotion should be visible as a drop in that count. Keyed collections are deliberately not admitted yet — the key and value axes need their own corpus measurement, and guessing that the element argument transfers is precisely the move this note refuses elsewhere. Dissolve-on: a peeling conformance relation that grounds brand aliases to their base, reconciles the two optionality representations, and grounds an anonymous literal against its expected nominal type — at which point the ground-kernel-scalar gate widens class by class and finally deletes. Not covered here and each its own lane: direct-call argument types inside compiler modules (the v2. / v1.compiler. exemption), default field values, generic record instantiation, and post-substitution generic field access."

fn rejects_string_for_optional_coproduct_field(expected: Node, got: Node, source_indices: Map<String, NewlineIndex>, env: TypeEnv) -> Bool {
  let expected_resolved = match lookup_type_for(env: env, node: with_required_cardinality(n: expected)) {
    Present { value: resolved } => resolved
    Absent => with_required_cardinality(n: expected)
  }
  let expected_is_optional_coproduct = expected.return_cardinality == CardOptional && expected_resolved.connective == Disj
  let got_is_string = node_type_shape(n: got, source_indices: source_indices) == "Primitive(String)" || authored_name_at(source_indices: source_indices, node: got) == "String"
  expected_is_optional_coproduct && got_is_string
}

data bare_none_construction_wall_note: String = "CONSTRUCTION WALL (DESIGN 4b): the bare name `None` carries absence and NOTHING else, so a construction position whose declared field type cannot carry absence must refuse it rather than adopt whichever `None` variant happens to be in scope. MEASURED HOLE this closes, on the pre-wall binary: with `type Diags = None | Some \{ n: Int \}` in scope, `Holder \{ n: None \}` for `n: Int` and `ListHolder \{ xs: None \}` for `xs: List<Int>` compiled with ZERO blocking diagnostics and emitted `n: Rc::new(Diags::None)` / `xs: Rc::new(Diags::None)` — a Rust program the declared types refute, produced silently. WHY THIS SLICE AND NOT THE GENERAL CONFORMANCE RULE: conformance_unjudged_live_hole_note records five successive attempts at a general named-vs-named refusal, each of which red correct code because the produced side carries no separable type identity. A bare `None` reference needs no produced-side identity — it is a SYNTACTIC form whose only meaning is absence — so admissibility is decided entirely from the DECLARED side, which is exactly why this class is decidable where the general one is not. ADMISSION is deliberately two-armed and nothing else: optional cardinality (the `T?` carrier), or a coproduct that declares a `None` variant at its own level (std.cache_interface AuthScope, v2.std.diagnostic Diagnostics — the two live carriers). A qualified `Owner.None` is not a bare reference and is not judged here. COVERAGE BOUNDARY, stated rather than left to be found: the wall fires only where the field s declared type is known at this site; a field whose declared type does not resolve is not judged, which is the check s precision frontier and not a failure arm."

fn field_declared_type_is_identified(ft: Node, scope: InferScope) -> Bool {
  let required = match lookup_type_for(env: scope.type_env, node: with_required_cardinality(n: ft)) {
    Present { value: resolved } => resolved
    Absent => with_required_cardinality(n: ft)
  }
  authored_name_at(source_indices: scope.type_env.source_indices, node: required) != ""
}

fn field_type_admits_bare_none(ft: Node, scope: InferScope) -> Bool {
  let required = match lookup_type_for(env: scope.type_env, node: with_required_cardinality(n: ft)) {
    Present { value: resolved } => resolved
    Absent => with_required_cardinality(n: ft)
  }
  let expanded = expand_scrut_type_for_variant_lookup(scrut_node: required, env: scope.type_env)
  let declares_none_variant = expanded.connective == Disj
    && has_child_named(n: expanded, name: "None", source_indices: scope.type_env.source_indices)
  ft.return_cardinality == CardOptional || declares_none_variant
}

fn expr_is_bare_none_reference(texpr: Node, scope: InferScope) -> Bool {
  match texpr.expr_data {
    ExprVar { binding_kind: _ } =>
      expr_var_name_at(texpr: texpr, source_indices: scope.type_env.source_indices) == "None"
    _ => false
  }
}

fn bare_none_field_construction_diags(
  fi: Node,
  fi_name: String,
  field_declared_type: Node?,
  type_name_for_message: String,
  scope: InferScope
) -> List<ErrorNode> {
  match field_declared_type {
    Absent => []
    Present { value: ft } =>
      let value_expr = field_init_node_value(n: fi)
      if expr_is_bare_none_reference(texpr: value_expr, scope: scope)
        && field_declared_type_is_identified(ft: ft, scope: scope)
        && field_type_admits_bare_none(ft: ft, scope: scope) == false {
        [make_error_node(
          diagnostic: BareNoneNotAdmittedByFieldType {
            field: fi_name,
            type_name: type_name_for_message,
            declared_type: node_type_shape(n: ft, source_indices: scope.type_env.source_indices),
            span: value_expr.span
          },
          module_name: scope.module_name
        )]
      } else { [] }
  }
}

fn field_type_is_optional_coproduct(ft: Node, env: TypeEnv) -> Bool {
  let inner = match lookup_type_for(env: env, node: with_required_cardinality(n: ft)) {
    Present { value: resolved } => resolved
    Absent => with_required_cardinality(n: ft)
  }
  ft.return_cardinality == CardOptional && inner.connective == Disj
}

fn record_lit_expected_fields(type_name: String?, scope: InferScope) -> List<Node> {
  match type_name {
    Present { value: tn } =>
      match lookup_type_by_name(env: scope.type_env, name: tn) {
        Present { value: direct } => direct.children
        Absent =>
          match variant_owner_node(scope: scope, name: tn) {
            Present { value: parent } =>
              match parent.children |> filter(v => authored_name_at(source_indices: scope.type_env.source_indices, node: v) == tn) |> first {
                Present { value: variant } => variant.children
                Absent => []
              }
            Absent => []
          }
      }
    Absent => []
  }
}

fn record_lit_expanded_from_expected(type_name: String?, expected: Node?, scope: InferScope) -> Node? {
  match type_name {
    Present { value: tn } =>
      match expected {
        Present { value: exp } =>
          if authored_name_at(source_indices: scope.type_env.source_indices, node: exp) == tn
            && exp.connective == Conj
            && exp.children |> count > 0 {
            Present { value: exp }
          } else {
            match exp.inferred {
              Present { value: Resolved { node: expanded } } =>
                if authored_name_at(source_indices: scope.type_env.source_indices, node: expanded) == tn {
                  Present { value: expanded }
                } else { none }
              _ =>
                let rt = resolved_type(n: exp)
                if authored_name_at(source_indices: scope.type_env.source_indices, node: rt) == tn {
                  Present { value: rt }
                } else { none }
            }
          }
        Absent => none
      }
    Absent => none
  }
}

fn record_lit_expected_coproduct(expected: Node?, scope: InferScope) -> Node? {
  match expected {
    Present { value: exp } =>
      let resolved = match lookup_type_for(env: scope.type_env, node: exp) {
        Present { value: r } => r
        Absent => exp
      }
      let nominal = if node_is_element_collection(n: resolved, source_indices: scope.type_env.source_indices) {
        match resolved.children |> first {
          Present { value: elem } =>
            let elem_ty = child_type_node(ch: elem)
            match lookup_type_for(env: scope.type_env, node: elem_ty) {
              Present { value: r } => Present { value: r }
              Absent => Present { value: elem_ty }
            }
          Absent => none
        }
      } else {
        Present { value: resolved }
      }
      match nominal {
        Present { value: n } =>
          if (n.connective == Disj) { Present { value: n } } else { none }
        Absent => none
      }
    Absent => none
  }
}

// When lookup_variant_parent_enum and variant_owner_node miss under composed symbol
// index (#7836 per-entry assembly), derive parent_enum from expected coproduct
// evidence: stamp only if record_lit_variant_from_expected proves the variant arm
// exists in the expected type's coproduct — refuses on miss, never guesses.
fn record_lit_parent_enum_from_expected(type_name: String, expected: Node?, scope: InferScope) -> String? {
  match record_lit_variant_from_expected(type_name: Present { value: type_name }, expected: expected, scope: scope) {
    Present { value: _ } =>
      match record_lit_expected_coproduct(expected: expected, scope: scope) {
        Present { value: coproduct } =>
          Present { value: authored_name_at(source_indices: scope.type_env.source_indices, node: coproduct) }
        Absent => none
      }
    Absent => none
  }
}

fn record_lit_variant_from_expected(type_name: String?, expected: Node?, scope: InferScope) -> Node? {
  match type_name {
    Present { value: tn } =>
      match record_lit_expected_coproduct(expected: expected, scope: scope) {
        Present { value: coproduct } =>
          coproduct.children |> filter(v => authored_name_at(source_indices: scope.type_env.source_indices, node: v) == qualified_last_segment(name: tn)) |> first
        Absent => none
      }
    Absent => none
  }
}

fn record_lit_fields_from_expected(type_name: String?, expected: Node?, scope: InferScope) -> List<Node>? {
  match record_lit_expanded_from_expected(type_name: type_name, expected: expected, scope: scope) {
    Present { value: expanded } =>
      if expanded.connective == Conj && expanded.children |> count > 0 {
        Present { value: expanded.children }
      } else { none }
    Absent => none
  }
}

fn field_type_expr_is_stripped_placeholder(te: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  authored_name_at(source_indices: source_indices, node: te) == ""
    && te.children |> count == 0
    && te.params |> count == 0
}

fn field_substitution_carrier(sf: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  let te = field_node_type_expr(n: sf)
  if field_type_expr_is_stripped_placeholder(te: te, source_indices: source_indices) {
    match sf.inferred {
      Present { value: Resolved { node: rt } } => preserve_outer_optional_cardinality(outer: sf, inner: rt)
      _ => te
    }
  } else { te }
}

fn record_lit_instantiated_fields(type_name: String?, expected: Node?, scope: InferScope) -> List<Node>? {
  match type_name {
    Present { value: tn } =>
      match expected {
        Present { value: exp } =>
          if type_name_compatible(a: authored_name_at(source_indices: scope.type_env.source_indices, node: exp), b: tn) == false {
            none
          } else if exp.children |> count == 0 {
            none
          } else {
            match lookup_type_for(env: scope.type_env, node: exp) {
              Present { value: decl } =>
                if (decl.params |> count) != (exp.children |> count) {
                  none
                } else {
                  let subst = fold(decl.params |> enumerate, init: empty_map(), f: (acc, pair) =>
                    let slot = authored_name_at(source_indices: scope.type_env.source_indices, node: pair.second)
                    match exp.children |> skip(pair.first) |> first {
                      Present { value: arg } => map_insert(acc, slot, resolved_type(n: arg))
                      Absent => acc
                    }
                  )
                  let template_fields = decl.children
                  Present { value: template_fields |> map(sf =>
                    Node {
                      name: sf.name, span: sf.span, ident_span: sf.ident_span,
                      children: sf.children, connective: sf.connective, params: sf.params,
                      inferred: Present { value: Resolved { node: substitute_generics(n: field_substitution_carrier(sf: sf, source_indices: scope.type_env.source_indices), subst: subst, source_indices: scope.type_env.source_indices) } },
                      return_cardinality: sf.return_cardinality, uses: sf.uses, body: sf.body,
                      transport: sf.transport, properties: sf.properties,
                      type_annotation: sf.type_annotation, is_self_recursive: sf.is_self_recursive,
                      has_non_tail_self_call: sf.has_non_tail_self_call, match_pattern: sf.match_pattern,
                      expr_data: sf.expr_data
                    }
                  ) }
                }
              Absent => none
            }
          }
        Absent => none
      }
    Absent => none
  }
}

type KernelListTyDiag {
  ty: Node
  miss_diags: List<ErrorNode>
}

fn list_kernel_ty_from_element(element: Node) -> KernelListTyDiag {
  let b = make_container_type(kind_name: "List", element: element)
  KernelListTyDiag { ty: b.ty, miss_diags: b.diagnostics }
}

fn set_kernel_ty_from_element(element: Node) -> KernelListTyDiag {
  let b = make_container_type(kind_name: "Set", element: element)
  KernelListTyDiag { ty: b.ty, miss_diags: b.diagnostics }
}

fn set_builtin_receiver_is_set(receiver_arg: Node, scope: InferScope) -> Bool {
  match arg_value(n: receiver_arg).inferred {
    Present { value: Resolved { node: receiver_type } } =>
      node_is_set_collection(n: receiver_type, source_indices: scope.type_env.source_indices)
    _ => false
  }
}

fn set_union_other_operand_is_resolved_non_set(other_arg: Node, scope: InferScope) -> Bool {
  match arg_value(n: other_arg).inferred {
    Present { value: Resolved { node: other_type } } =>
      !node_is_set_collection(n: other_type, source_indices: scope.type_env.source_indices)
    _ => false
  }
}

fn set_element_type_from_receiver(receiver_type: Node, scope: InferScope) -> Node? {
  match set_element_type_in_env(type_node: receiver_type, env: scope.type_env) {
    Present { value: elem_slot } => Present { value: child_type_node(ch: elem_slot) }
    Absent => none
  }
}

fn set_element_type_is_concrete(elem: Node) -> Bool {
  match elem.inferred {
    Present { value: inf } => !is_type_variable(inferred: inf)
    Absent => true
  }
}

fn set_element_types_mismatch(recv_elem: Node, operand_elem: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  set_element_type_is_concrete(elem: recv_elem)
    && set_element_type_is_concrete(elem: operand_elem)
    && !node_type_compatible(left: recv_elem, right: operand_elem, source_indices: source_indices)
}

fn type_node_is_established(n: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  authored_name_at(source_indices: source_indices, node: n) != ""
    || n.children |> count > 0
    || n.params |> count > 0
}

fn type_node_is_callable(n: Node) -> Bool {
  n.params |> count > 0
}

// THE v1.compiler.* ARM IS DELETED RATHER THAN REPAIRED, and the deletion preserves live behaviour
// by construction rather than by argument. It read:
//
//   string_length(s: module_name) >= 13 && substring(s: module_name, start: 0, end: 13) == "v1.compiler."
//
// "v1.compiler." is TWELVE characters, so a thirteen-character slice could never equal it. The arm
// has never returned true, for any module, since it was written - compiler modules have been
// receiving the direct-call argument judgment the whole time, and the corpus is green under it.
//
// There are two candidate fixes and only one is honest. Changing 13 to 12 would ACTIVATE an
// exemption that has never been in force, silencing a judgment the tree currently passes: a
// behaviour change wearing the costume of a typo fix, and one that would need evidence of false
// positives nobody has. Deleting the arm keeps live behaviour exactly and removes the dead branch
// together with the claim attached to it - direct_call_shape_wall_note describes this exemption as
// protecting the TYPE judgment in compiler modules from representation-gap false positives, and
// that protection was never real. A comment asserting a wall that does not exist is the inert
// mechanism DESIGN 6 names.
//
// The v2. arm is untouched and DOES fire.
fn module_skips_direct_call_arg_check(module_name: String) -> Bool {
  string_length(s: module_name) >= 3 && substring(s: module_name, start: 0, end: 3) == "v2."
}

fn brand_grounds_transparently_to(name: String, other: Node, type_env: TypeEnv, source_indices: Map<String, NewlineIndex>) -> Bool {
  match lookup_type_by_name(env: type_env, name: name) {
    Present { value: resolved } =>
      resolved.connective == NoConnective && (resolved.children |> count) == 0 && resolved.inferred != none
        && match resolved.inferred {
          Present { value: Resolved { node: target } } =>
            let target_name = authored_name_at(source_indices: source_indices, node: target)
            let other_name = authored_name_at(source_indices: source_indices, node: other)
            (is_kernel_type(name: target_name) && target_name == other_name)
              || qualified_last_segment(name: target_name) == qualified_last_segment(name: other_name)
          _ => false
        }
    Absent => false
  }
}

fn nominal_call_arg_brand_mismatch(formal: Node, actual: Node, type_env: TypeEnv, source_indices: Map<String, NewlineIndex>) -> Bool {
  let formal_name = authored_name_at(source_indices: source_indices, node: formal)
  let actual_name = authored_name_at(source_indices: source_indices, node: actual)
  formal.connective != Arrow && actual.connective != Arrow
    && formal_name != ""
    && actual_name != ""
    && qualified_last_segment(name: formal_name) != qualified_last_segment(name: actual_name)
    && structural_carrier_template_name(n: formal, source_indices: source_indices) == structural_carrier_template_name(n: actual, source_indices: source_indices)
    && !is_declared_container_alias_spelling(name: formal_name)
    && !is_declared_container_alias_spelling(name: actual_name)
    && !brand_grounds_transparently_to(name: formal_name, other: actual, type_env: type_env, source_indices: source_indices)
    && !brand_grounds_transparently_to(name: actual_name, other: formal, type_env: type_env, source_indices: source_indices)
}

fn is_where_refinement_type(ty: Node) -> Bool {
  ty.connective == Conj && ty.type_annotation != none && (ty.children |> count) == 1
}

fn where_refinement_chain(ty: Node, type_env: TypeEnv) -> List<Node> {
  if is_where_refinement_type(ty: ty) {
    match ty.children |> first {
      Present { value: base } =>
        let base_resolved = match lookup_type_for(env: type_env, node: base) {
          Present { value: resolved } => resolved
          Absent => base
        }
        concat([ty], where_refinement_chain(ty: base_resolved, type_env: type_env))
      Absent => [ty]
    }
  } else {
    [ty]
  }
}

fn type_expr_where_refinement_predicates(ty: Node) -> List<Node> {
  if is_where_refinement_type(ty: ty) {
    match ty.type_annotation {
      Present { value: annot } =>
        match annot.connective {
          Conj => annot.children
          _ => [annot]
        }
      Absent => []
    }
  } else { [] }
}

fn type_where_refinement_predicates_transitive(ty: Node, type_env: TypeEnv) -> List<Node> {
  where_refinement_chain(ty: ty, type_env: type_env)
    |> flat_map(link => type_expr_where_refinement_predicates(ty: link))
}

fn peel_where_refinement_base(ty: Node, type_env: TypeEnv) -> Node {
  match where_refinement_chain(ty: ty, type_env: type_env) |> last {
    Present { value: ground } => ground
    Absent => ty
  }
}

fn where_predicate_name_at(pred: Node, source_indices: Map<String, NewlineIndex>) -> String {
  field_init_node_name_at(n: pred, source_indices: source_indices)
}

fn where_predicate_named_int_arg(pred: Node, field: String, source_indices: Map<String, NewlineIndex>) -> Int? {
  match record_lit_named_field_value_optional(
    record_expr: field_init_node_value(n: pred),
    field: field,
    source_indices: source_indices
  ) {
    Present { value: field_expr } => expr_literal_int_optional(expr: field_expr)
    Absent => none
  }
}

fn where_predicate_canonical_name(pred_name: String) -> String {
  if pred_name == "brand" { "Brand" } else { pred_name }
}

fn where_predicate_optional_int_args_match(
  left: Node,
  right: Node,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  let min_ok = where_predicate_int_bound_args_equivalent(
    left: left, right: right, field: "min", source_indices: source_indices
  )
  let max_ok = where_predicate_int_bound_args_equivalent(
    left: left, right: right, field: "max", source_indices: source_indices
  )
  min_ok && max_ok
}

fn where_predicate_int_bound_args_equivalent(
  left: Node,
  right: Node,
  field: String,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  match record_lit_named_field_value_optional(
    record_expr: field_init_node_value(n: left),
    field: field,
    source_indices: source_indices
  ) {
    Absent =>
      match record_lit_named_field_value_optional(
        record_expr: field_init_node_value(n: right),
        field: field,
        source_indices: source_indices
      ) {
        Absent => true
        Present { value: _ } => false
      }
    Present { value: left_expr } =>
      match record_lit_named_field_value_optional(
        record_expr: field_init_node_value(n: right),
        field: field,
        source_indices: source_indices
      ) {
        Absent => false
        Present { value: right_expr } =>
          match expr_literal_int_optional(expr: left_expr) {
            Present { value: a } =>
              match expr_literal_int_optional(expr: right_expr) {
                Present { value: b } => a == b
                Absent => false
              }
            Absent => false
          }
      }
  }
}

fn where_predicate_literal_string_args_match(left: Node, right: Node) -> Bool {
  match expr_literal_string_optional(expr: field_init_node_value(n: left)) {
    Present { value: a } =>
      match expr_literal_string_optional(expr: field_init_node_value(n: right)) {
        Present { value: b } => a == b
        Absent => false
      }
    Absent =>
      match expr_literal_string_optional(expr: field_init_node_value(n: right)) {
        Present { value: _ } => false
        Absent => true
      }
  }
}

fn where_refinement_predicates_equivalent(
  formal_pred: Node,
  actual_pred: Node,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  let formal_name = where_predicate_canonical_name(
    pred_name: where_predicate_name_at(pred: formal_pred, source_indices: source_indices)
  )
  let actual_name = where_predicate_canonical_name(
    pred_name: where_predicate_name_at(pred: actual_pred, source_indices: source_indices)
  )
  if formal_name != actual_name {
    false
  } else if formal_name == "range" {
    where_predicate_optional_int_args_match(
      left: formal_pred, right: actual_pred, source_indices: source_indices
    )
  } else if formal_name == "Brand"
    || formal_name == "Pattern"
    || formal_name == "Format"
    || formal_name == "ContentEncoding"
    || formal_name == "Domain" {
    where_predicate_literal_string_args_match(left: formal_pred, right: actual_pred)
  } else {
    true
  }
}

data where_refinement_min_length_implication_note: String = "THE FRAGMENT IS TWO PARTIAL FUNCTIONS, NOT AN IMPLICATION ENGINE, and the asymmetry between them is the entire soundness argument. Predicate implication in general is undecidable, so this decides exactly one relation and refuses outside it: a value whose refinement GUARANTEES a minimum length satisfies a formal position whose refinement DEMANDS a minimum length AND NOTHING ELSE. Provider and demander are separate partial functions over the same closed predicate vocabulary because a predicate can inhabit one side and not the other, and collapsing them into one min-length table is a FAIL-OPEN that the obvious framing walks straight into: model lower_hex_64 as min-length 64 on both sides and a formal lower_hex_64 is then satisfied by an actual lower_hex_128, since 128 >= 64 — but those predicates demand DIFFERENT EXACT LENGTHS and a 128-digit string is not a valid sha256 hex. lower_hex_N therefore appears as a PROVIDER only (it guarantees exactly N lower-hex digits, hence at least N characters) and never as a demander (it demands an exact length and a charset, neither of which a length lower bound establishes). non_empty is the only predicate in the live vocabulary that is a pure length lower bound, so it is the only demander, and it is a provider too because it demands what it guarantees. Everything outside both tables answers Absent and the caller falls through to the pre-existing name-equality path unchanged, so this widens what the wall can DECIDE and narrows nothing it already decided. oci_other_digest_algorithm and oci_other_digest_encoded are deliberately NOT providers even though their grammars happen to exclude the empty string: that fact lives in oci_digest_algorithm_wire_holds / oci_encoded_digest_syntax_valid as a consequence of a syntax walk, not as a declared constant this table could cite, and asserting a bound the predicate does not state is the fabrication DESIGN §5 forbids. The four lower_hex_N bounds ARE declared constants — each is content_hash_validate_lower_hex_length(text, expected_hex_digits: N), whose body is text.length() == N — so the number in this table is the number in the predicate, cited rather than restated. WHY THIS IS A WALL AND NOT A WIDENING: the two corpus sites it closes (std.content_hash serialize_content_hash, `s.digest as NonEmptyStr` over Fnv1a64StructuralDigestHex and `d.hex as NonEmptyStr` over Sha1DigestHex) were carrying WhereRefinementUnenforced advisories for REFUSED evidence, not absent evidence — the value's own declared type already proved the property and where_refinement_predicates_equivalent could not see it because it compares predicate NAMES for equality, and lower_hex_40 != non_empty. WHAT IS NOT STRUCTURAL, STATED AT ITS HONEST RUNG (§4b) BECAUSE A TABLE PAIR WHOSE SOUNDNESS LIVES IN PROSE DECAYS SILENTLY: nothing prevents a predicate from being enrolled in BOTH tables, and membership in both is NOT the fail-open — non_empty is deliberately in both and is sound there, because it demands exactly what it guarantees. The real enrollment condition is narrower: a predicate may take a REQUIRED row only if its entire semantics is a length lower bound and nothing else. lower_hex_64 in both tables would be unsound not because it appears twice but because it demands an exact length and a charset that a lower bound does not establish. That condition is enforced by nobody: these are two hand-written name-keyed partial functions, so a future demander row asserting more than length would fail open and no check would fire. The decided relation guaranteed >= required is mechanically enforced; the authoring discipline that populates the demander table is DILIGENCE, rung MITIGATABLE, and it is contained only by the vocabulary being closed and small. Next-rung trigger is the same dissolve-on below: once the bounds are fields on WhereRefinementPredicateKind's own declaration, a predicate states its guarantee and its demand once and the mis-enrollment has no place to be written. Dissolve-on: feature:where-refinement-predicate-coproduct — when WhereRefinementPredicateKind replaces the string classifiers, the guaranteed and required bounds become fields on the predicate's own declaration rather than two tables a reader must keep in lockstep with where_refinement_is_string_literal_predicate and decidable_where_string_predicate_holds."

fn where_predicate_guaranteed_min_length(pred_name: String) -> Int? {
  if pred_name == "non_empty" {
    Present { value: 1 }
  } else if pred_name == "lower_hex_16" {
    Present { value: 16 }
  } else if pred_name == "lower_hex_40" {
    Present { value: 40 }
  } else if pred_name == "lower_hex_64" {
    Present { value: 64 }
  } else if pred_name == "lower_hex_128" {
    Present { value: 128 }
  } else {
    none
  }
}

fn where_predicate_required_min_length(pred_name: String) -> Int? {
  if pred_name == "non_empty" {
    Present { value: 1 }
  } else {
    none
  }
}

fn where_refinement_predicate_min_length_implies(
  formal_pred: Node,
  actual_pred: Node,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  match where_predicate_required_min_length(
    pred_name: where_predicate_canonical_name(
      pred_name: where_predicate_name_at(pred: formal_pred, source_indices: source_indices)
    )
  ) {
    Present { value: required } =>
      match where_predicate_guaranteed_min_length(
        pred_name: where_predicate_canonical_name(
          pred_name: where_predicate_name_at(pred: actual_pred, source_indices: source_indices)
        )
      ) {
        Present { value: guaranteed } => guaranteed >= required
        Absent => false
      }
    Absent => false
  }
}

fn where_refinement_predicate_satisfied_by(
  formal_pred: Node,
  actual_pred: Node,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  where_refinement_predicates_equivalent(
    formal_pred: formal_pred, actual_pred: actual_pred, source_indices: source_indices
  ) || where_refinement_predicate_min_length_implies(
    formal_pred: formal_pred, actual_pred: actual_pred, source_indices: source_indices
  )
}

fn where_refinement_predicates_covered(
  formal_preds: List<Node>,
  actual_preds: List<Node>,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  formal_preds |> all(fp =>
    actual_preds |> any(ap =>
      where_refinement_predicate_satisfied_by(
        formal_pred: fp, actual_pred: ap, source_indices: source_indices
      )
    )
  )
}

fn decidable_where_int_predicate_holds(pred_name: String, pred: Node, value: Int, source_indices: Map<String, NewlineIndex>) -> Bool? {
  if pred_name == "gt_zero" {
    Present { value: value > 0 }
  } else if pred_name == "range" {
    let passes_min = match record_lit_named_field_value_optional(
      record_expr: field_init_node_value(n: pred),
      field: "min",
      source_indices: source_indices
    ) {
      Absent => Present { value: true }
      Present { value: field_expr } =>
        match expr_literal_int_optional(expr: field_expr) {
          Present { value: lo } => Present { value: value >= lo }
          Absent => none
        }
    }
    let passes_max = match record_lit_named_field_value_optional(
      record_expr: field_init_node_value(n: pred),
      field: "max",
      source_indices: source_indices
    ) {
      Absent => Present { value: true }
      Present { value: field_expr } =>
        match expr_literal_int_optional(expr: field_expr) {
          Present { value: hi } => Present { value: value <= hi }
          Absent => none
        }
    }
    match passes_min {
      Present { value: min_ok } =>
        match passes_max {
          Present { value: max_ok } => Present { value: min_ok && max_ok }
          Absent => none
        }
      Absent => none
    }
  } else {
    none
  }
}

data where_refinement_predicate_kind_scaffold_note: String = "owner: v1.compiler.infer. lane: where_refinement_diags_for_predicate dispatch. interim: predicate kind routed via where_refinement_is_*_literal_predicate / where_refinement_is_deferred_predicate closed string sets — must stay in lockstep with decidable_*_predicate_holds and where_refinement_predicates_equivalent. bound: vocabulary changes require updating all classifier fns + eval + equivalence arms in one commit. dissolve-on: feature:where-refinement-predicate-coproduct (WhereRefinementPredicateKind coproduct replacing string classifiers)."

fn where_refinement_is_int_literal_predicate(pred_name: String) -> Bool {
  pred_name == "gt_zero" || pred_name == "range"
}

fn where_refinement_is_string_literal_predicate(pred_name: String) -> Bool {
  pred_name == "non_empty"
    || pred_name == "lower_hex_64"
    || pred_name == "lower_hex_40"
    || pred_name == "lower_hex_128"
    || pred_name == "lower_hex_16"
    || pred_name == "oci_other_digest_algorithm"
    || pred_name == "oci_other_digest_encoded"
}

fn where_refinement_is_deferred_predicate(pred_name: String) -> Bool {
  pred_name == "brand" || pred_name == "Brand"
    || pred_name == "unicode_scalar"
    || pred_name == "is_text_readable"
    || pred_name == "Pattern"
    || pred_name == "Format"
    || pred_name == "ContentEncoding"
    || pred_name == "Domain"
}

fn decidable_where_string_predicate_holds(pred_name: String, value: String) -> Bool? {
  if pred_name == "non_empty" {
    Present { value: string_length(s: value) > 0 }
  } else if pred_name == "lower_hex_64" {
    Present {
      value: content_hash_validate_lower_hex_length(text: value, expected_hex_digits: 64),
    }
  } else if pred_name == "lower_hex_40" {
    Present {
      value: content_hash_validate_lower_hex_length(text: value, expected_hex_digits: 40),
    }
  } else if pred_name == "lower_hex_128" {
    Present {
      value: content_hash_validate_lower_hex_length(text: value, expected_hex_digits: 128),
    }
  } else if pred_name == "lower_hex_16" {
    Present {
      value: content_hash_validate_lower_hex_length(text: value, expected_hex_digits: 16),
    }
  } else if pred_name == "oci_other_digest_algorithm" {
    Present { value: oci_other_digest_algorithm(value: value) }
  } else if pred_name == "oci_other_digest_encoded" {
    Present { value: oci_other_digest_encoded(value: value) }
  } else {
    none
  }
}

fn where_predicate_range_non_literal_bound_reason(
  pred: Node,
  source_indices: Map<String, NewlineIndex>
) -> String? {
  match record_lit_named_field_value_optional(
    record_expr: field_init_node_value(n: pred),
    field: "min",
    source_indices: source_indices
  ) {
    Present { value: min_expr } =>
      match expr_literal_int_optional(expr: min_expr) {
        Present { value: _ } =>
          match record_lit_named_field_value_optional(
            record_expr: field_init_node_value(n: pred),
            field: "max",
            source_indices: source_indices
          ) {
            Present { value: max_expr } =>
              match expr_literal_int_optional(expr: max_expr) {
                Present { value: _ } => none
                Absent => Present { value: "predicate argument is not an int literal" }
              }
            Absent => none
          }
        Absent => Present { value: "predicate argument is not an int literal" }
      }
    Absent =>
      match record_lit_named_field_value_optional(
        record_expr: field_init_node_value(n: pred),
        field: "max",
        source_indices: source_indices
      ) {
        Present { value: max_expr } =>
          match expr_literal_int_optional(expr: max_expr) {
            Present { value: _ } => none
            Absent => Present { value: "predicate argument is not an int literal" }
          }
        Absent => none
      }
  }
}

fn where_refinement_unenforced_error(
  predicate: String,
  formal: Node,
  reason: String,
  span: SourceSpan,
  module_name: String,
  source_indices: Map<String, NewlineIndex>
) -> ErrorNode {
  make_error_node(
    diagnostic: WhereRefinementUnenforced {
      predicate: predicate,
      formal_type: node_type_shape(n: formal, source_indices: source_indices),
      reason: reason,
      span: span
    },
    module_name: module_name
  )
}

fn where_refinement_diags_for_predicate(
  pred: Node,
  formal: Node,
  value_expr: Node,
  span: SourceSpan,
  module_name: String,
  source_indices: Map<String, NewlineIndex>
) -> List<ErrorNode> {
  let pname = field_init_node_name_at(n: pred, source_indices: source_indices)
  let refinement_refusal = [type_mismatch_error(
    expected: node_type_shape(n: formal, source_indices: source_indices),
    got: node_type_shape(n: resolved_type(n: value_expr), source_indices: source_indices),
    span: span,
    module_name: module_name
  )]
  if where_refinement_is_int_literal_predicate(pred_name: pname) {
    match expr_literal_int_optional(expr: value_expr) {
      Present { value: v } =>
        match decidable_where_int_predicate_holds(pred_name: pname, pred: pred, value: v, source_indices: source_indices) {
          Present { value: holds } =>
            if !holds { refinement_refusal } else { [] }
          Absent =>
            if pname == "range" {
              match where_predicate_range_non_literal_bound_reason(pred: pred, source_indices: source_indices) {
                Present { value: reason } =>
                  [where_refinement_unenforced_error(
                    predicate: pname, formal: formal, reason: reason,
                    span: span, module_name: module_name, source_indices: source_indices
                  )]
                Absent =>
                  [where_refinement_unenforced_error(
                    predicate: pname, formal: formal, reason: "int predicate not implemented",
                    span: span, module_name: module_name, source_indices: source_indices
                  )]
              }
            } else {
              [where_refinement_unenforced_error(
                predicate: pname, formal: formal, reason: "int predicate not implemented",
                span: span, module_name: module_name, source_indices: source_indices
              )]
            }
        }
      Absent =>
        if expr_is_any_literal(expr: value_expr) {
          refinement_refusal
        } else {
          [where_refinement_unenforced_error(
            predicate: pname, formal: formal, reason: "non-literal value at refined position",
            span: span, module_name: module_name, source_indices: source_indices
          )]
        }
    }
  } else if where_refinement_is_string_literal_predicate(pred_name: pname) {
    let string_literal_value = match expr_literal_string_optional(expr: value_expr) {
      Present { value: v } => Present { value: v }
      Absent => expr_literal_symbol_optional(expr: value_expr)
    }
    match string_literal_value {
      Present { value: v } =>
        match decidable_where_string_predicate_holds(pred_name: pname, value: v) {
          Present { value: holds } =>
            if !holds { refinement_refusal } else { [] }
          Absent => [where_refinement_unenforced_error(
            predicate: pname, formal: formal, reason: "string predicate not implemented",
            span: span, module_name: module_name, source_indices: source_indices
          )]
        }
      Absent =>
        if expr_is_any_literal(expr: value_expr) {
          refinement_refusal
        } else {
          [where_refinement_unenforced_error(
            predicate: pname, formal: formal, reason: "non-literal value at refined position",
            span: span, module_name: module_name, source_indices: source_indices
          )]
        }
    }
  } else if where_refinement_is_deferred_predicate(pred_name: pname) {
    [where_refinement_unenforced_error(
      predicate: pname, formal: formal, reason: "predicate deferred at compile time",
      span: span, module_name: module_name, source_indices: source_indices
    )]
  } else {
    [where_refinement_unenforced_error(
      predicate: pname, formal: formal, reason: "predicate not enforced at compile time",
      span: span, module_name: module_name, source_indices: source_indices
    )]
  }
}

fn where_refinement_value_under_cast(value_expr: Node) -> Node {
  match value_expr.expr_data {
    ExprCast => where_refinement_value_under_cast(value_expr: cast_expr(texpr: value_expr))
    _ => value_expr
  }
}

data where_refinement_peel_cost_note: String = "Cost shape (bare-minimum-cost, DESIGN 6): peel_nominal_alias_identity runs only on the refusal path (predicates present AND not covered), inside the final else of where_refinement_mismatch_diags. That fn runs on EVERY infer_expr with an expected type; 97% of calls find zero predicates, and an eager peel at fn entry was 6.5s of discarded resolve_node_bounded work per host_effect_realize entry compile (typecheck-perf investigation, 2026-07-31). formal_checked is consumed only by where_refinement_diags_for_predicate, so the sink is behavior-identical: peel is pure and its NodeResolveResult diagnostics were already discarded."

fn where_refinement_mismatch_diags(
  formal: Node,
  value_expr: Node,
  span: SourceSpan,
  module_name: String,
  type_env: TypeEnv
) -> List<ErrorNode> {
  let source_indices = type_env.source_indices
  let formal_resolved = match lookup_type_for(env: type_env, node: formal) {
    Present { value: resolved } => resolved
    Absent => formal
  }
  let preds = type_where_refinement_predicates_transitive(ty: formal_resolved, type_env: type_env)
  if preds |> count == 0 {
    []
  } else {
    let value_for_refinement = where_refinement_value_under_cast(value_expr: value_expr)
    let actual_raw = resolved_type(n: value_for_refinement)
    let actual_resolved = match lookup_type_for(env: type_env, node: actual_raw) {
      Present { value: resolved } => resolved
      Absent => actual_raw
    }
    let actual_preds = type_where_refinement_predicates_transitive(ty: actual_resolved, type_env: type_env)
    if where_refinement_predicates_covered(
      formal_preds: preds,
      actual_preds: actual_preds,
      source_indices: source_indices
    ) {
      []
    } else {
      let formal_checked = peel_nominal_alias_identity(n: formal_resolved, env: type_env, module_name: module_name)
      flat_map(
        preds,
        pred => where_refinement_diags_for_predicate(
          pred: pred,
          formal: formal_checked,
          value_expr: value_for_refinement,
          span: span,
          module_name: module_name,
          source_indices: source_indices
        )
      )
    }
  }
}

fn with_expected_where_refinement_diags(result: InferResult, expected: Node?, scope: InferScope) -> InferResult {
  match expected {
    Present { value: expected_ty } =>
      match result.typed.expr_data {
        ExprCast => result
        _ =>
          InferResult {
            typed: result.typed,
            diagnostics: concat(
              result.diagnostics,
              where_refinement_mismatch_diags(
                formal: expected_ty,
                value_expr: result.typed,
                span: result.typed.span,
                module_name: scope.module_name,
                type_env: scope.type_env
              )
            )
          }
      }
    Absent => result
  }
}

fn infer_expr(texpr: Node, scope: InferScope, expected: Node?) -> InferResult {
  with_expected_where_refinement_diags(
    result: infer_expr_body(texpr: texpr, scope: scope, expected: expected),
    expected: expected,
    scope: scope
  )
}

fn kernel_value_declared_type_mismatch(formal: Node, actual: Node, type_env: TypeEnv, source_indices: Map<String, NewlineIndex>) -> Bool {
  if formal.connective == Arrow || actual.connective == Arrow || (actual.children |> count) > 0 {
    false
  } else {
    let formal_base = peel_where_refinement_base(ty: formal, type_env: type_env)
    let actual_name = authored_name_at(source_indices: source_indices, node: actual)
    if is_kernel_type(name: actual_name) == false || actual_name == "Unit" {
      false
    } else {
      let formal_name = authored_name_at(source_indices: source_indices, node: formal_base)
      if formal_name == "" || qualified_last_segment(name: formal_name) == qualified_last_segment(name: actual_name) || dag_can_cast(source_type: actual_name, target_type: formal_name) {
        false
      } else if structural_carrier_template_name(n: formal_base, source_indices: source_indices) == structural_carrier_template_name(n: actual, source_indices: source_indices) {
        false
      } else {
        if is_kernel_type(name: formal_name) {
          true
        } else {
          match lookup_type_by_name(env: type_env, name: formal_name) {
            Present { value: decl } =>
              let decl_is_refinement_over_actual = decl.connective == Conj && (decl.children |> count) == 1
                && (decl.type_annotation != none
                  || (match decl.children |> first {
                    Present { value: refinement_child } => authored_name_at(source_indices: source_indices, node: refinement_child) == actual_name
                    Absent => false
                  }))
              (decl.connective == Conj || decl.connective == Disj) && (decl.children |> count) > 0 && decl_is_refinement_over_actual == false
            Absent => false
          }
        }
      }
    }
  }
}

fn application_type_name_identity(
  type_name: String,
  type_env: TypeEnv,
  module_name: String,
  source_indices: Map<String, NewlineIndex>
) -> String {
  match lookup_type_by_name(env: type_env, name: type_name) {
    Present { value: decl } =>
      match decl.inferred {
        Present { value: Resolved { node: target } } =>
          authored_name_at(
            source_indices: source_indices,
            node: peel_nominal_alias_identity(n: target, env: type_env, module_name: module_name))
        _ =>
          authored_name_at(
            source_indices: source_indices,
            node: peel_nominal_alias_identity(n: decl, env: type_env, module_name: module_name))
      }
    Absent => type_name
  }
}

fn structured_application_structural_type_name(
  type_name: String,
  scope: InferScope
) -> String {
  application_type_name_identity(
    type_name: type_name,
    type_env: scope.type_env,
    module_name: scope.module_name,
    source_indices: scope.type_env.source_indices)
}

fn structured_application_record_lit_nominal_name(
  lit_name: String,
  scope: InferScope
) -> String {
  structured_application_structural_type_name(type_name: lit_name, scope: scope)
}

fn structured_application_lit_is_declared_optional_variant(
  formal: Node,
  lit_name: String,
  scope: InferScope
) -> Bool {
  let source_indices = scope.type_env.source_indices
  let formal_resolved = match lookup_type_for(env: scope.type_env, node: with_required_cardinality(n: formal)) {
    Present { value: resolved } => resolved
    Absent => with_required_cardinality(n: formal)
  }
  if formal.return_cardinality == CardOptional && (lit_name == "Present" || lit_name == "Absent") {
    true
  } else {
    has_child_named(n: formal_resolved, name: lit_name, source_indices: source_indices)
  }
}

fn application_type_names_compatible(
  formal_name: String,
  lit_name: String,
  type_env: TypeEnv,
  module_name: String,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  if formal_name == "" || lit_name == "" {
    formal_name == lit_name
  } else if formal_name == lit_name {
    true
  } else {
    let formal_identity = application_type_name_identity(
      type_name: formal_name, type_env: type_env, module_name: module_name, source_indices: source_indices)
    let lit_identity = application_type_name_identity(
      type_name: lit_name, type_env: type_env, module_name: module_name, source_indices: source_indices)
    if formal_identity == lit_identity {
      true
    } else if dag_can_cast(source_type: lit_name, target_type: formal_name) {
      true
    } else if type_name_transparently_aliases_to(
      alias_name: lit_name, target_name: formal_name, type_env: type_env, module_name: module_name, source_indices: source_indices)
      || type_name_transparently_aliases_to(
        alias_name: formal_name, target_name: lit_name, type_env: type_env, module_name: module_name, source_indices: source_indices) {
      true
    } else {
      match lookup_type_by_name(env: type_env, name: formal_name) {
        Present { value: formal_decl } =>
          brand_grounds_transparently_to(name: lit_name, other: formal_decl, type_env: type_env, source_indices: source_indices)
        Absent => false
      }
    }
  }
}

fn type_name_transparently_aliases_to(
  alias_name: String,
  target_name: String,
  type_env: TypeEnv,
  module_name: String,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  match lookup_type_by_name(env: type_env, name: alias_name) {
    Present { value: decl } =>
      let peeled = peel_nominal_alias_identity(n: decl, env: type_env, module_name: module_name)
      let peeled_name = authored_name_at(source_indices: source_indices, node: peeled)
      if peeled_name == alias_name {
        false
      } else if peeled_name == target_name {
        true
      } else {
        type_name_transparently_aliases_to(
          alias_name: peeled_name, target_name: target_name, type_env: type_env, module_name: module_name, source_indices: source_indices)
      }
    Absent => false
  }
}

// The peeling entry point, retained for the record-literal FIELD site, which has
// no prepared call plan to carry a peeled formal. It peels inside the ExprRecordLit
// arm exactly as before, so a non-record-literal actual still pays nothing.
fn structured_application_site_type_mismatch(
  formal: Node,
  actual_expr: Node,
  scope: InferScope
) -> Bool {
  match actual_expr.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      structured_application_site_type_mismatch_with_peeled(
        formal: formal,
        formal_peeled: peel_nominal_alias_identity(n: formal, env: scope.type_env, module_name: scope.module_name),
        actual_expr: actual_expr,
        scope: scope
      )
    _ => false
  }
}

// Takes the peeled formal the caller ALREADY HAS instead of recomputing it. At the
// direct-call seam build_call_application_plan stores peel(formal_subst) as
// CallFormalApplication.formal, and this predicate was handed formal_subst and then
// recomputed exactly that peel -- the same function on the same node, once per
// structured record-literal argument. #8431 built the value and left this consumer
// recomputing it. Both formals are carried because the body still needs the unpeeled
// one for structured_application_lit_is_declared_optional_variant.
fn structured_application_site_type_mismatch_with_peeled(
  formal: Node,
  formal_peeled: Node,
  actual_expr: Node,
  scope: InferScope
) -> Bool {
  match actual_expr.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      let source_indices = scope.type_env.source_indices
      if type_node_is_callable(n: formal_peeled) {
        false
      } else {
        let formal_name = authored_name_at(source_indices: source_indices, node: formal_peeled)
        if formal_name == "" {
          false
        } else {
          let formal_structural = structured_application_structural_type_name(type_name: formal_name, scope: scope)
          match record_lit_type_name_at(texpr: actual_expr, source_indices: source_indices) {
            Present { value: lit_name } =>
              if application_type_names_compatible(
                formal_name: formal_name, lit_name: lit_name,
                type_env: scope.type_env, module_name: scope.module_name, source_indices: source_indices) {
                false
              } else {
              let lit_nominal = structured_application_record_lit_nominal_name(lit_name: lit_name, scope: scope)
              if lit_name == "" || structured_application_lit_is_declared_optional_variant(
                formal: formal, lit_name: lit_name, scope: scope) {
                false
              } else if match record_lit_alias_struct_expansion(type_name: lit_name, scope: scope) {
                Present { value: expansion } =>
                  let expanded_name = authored_name_at(source_indices: source_indices, node: expansion.resolved)
                  expanded_name == formal_structural
                    || application_type_names_compatible(
                      formal_name: formal_structural, lit_name: expanded_name,
                      type_env: scope.type_env, module_name: scope.module_name, source_indices: source_indices)
                Absent => false
              } {
                false
              } else if brand_grounds_transparently_to(
                name: lit_name, other: formal_peeled, type_env: scope.type_env, source_indices: source_indices) {
                false
              } else if formal_structural == lit_nominal
                || formal_structural == lit_name
                || application_type_names_compatible(
                  formal_name: formal_structural, lit_name: lit_nominal,
                  type_env: scope.type_env, module_name: scope.module_name, source_indices: source_indices)
                || application_type_names_compatible(
                  formal_name: formal_structural, lit_name: lit_name,
                  type_env: scope.type_env, module_name: scope.module_name, source_indices: source_indices) {
                false
              } else {
                let formal_decl = match lookup_type_for(env: scope.type_env, node: with_required_cardinality(n: formal_peeled)) {
                  Present { value: resolved } => Present { value: resolved }
                  Absent => lookup_type_by_name(env: scope.type_env, name: formal_name)
                }
                match formal_decl {
                  Present { value: decl } =>
                    match decl.connective {
                      Disj =>
                        if has_child_named(n: decl, name: lit_name, source_indices: source_indices) {
                          false
                        } else {
                          match variant_owner_node(scope: scope, name: lit_name) {
                            Present { value: owner } =>
                              let owner_name = authored_name_at(source_indices: source_indices, node: owner)
                              !application_type_names_compatible(
                                formal_name: formal_name, lit_name: owner_name,
                                type_env: scope.type_env, module_name: scope.module_name, source_indices: source_indices)
                            Absent => true
                          }
                        }
                      Conj =>
                        let decl_name = structured_application_structural_type_name(
                          type_name: authored_name_at(source_indices: source_indices, node: decl), scope: scope)
                        !application_type_names_compatible(
                          formal_name: decl_name, lit_name: lit_nominal,
                          type_env: scope.type_env, module_name: scope.module_name, source_indices: source_indices)
                          && !application_type_names_compatible(
                            formal_name: decl_name, lit_name: lit_name,
                            type_env: scope.type_env, module_name: scope.module_name, source_indices: source_indices)
                      _ => false
                    }
                  Absent =>
                    if is_kernel_type(name: formal_name) {
                      match lookup_type_by_name(env: scope.type_env, name: lit_name) {
                        Present { value: lit_decl } =>
                          lit_decl.connective == Conj || lit_decl.connective == Disj
                        Absent => match variant_owner_node(scope: scope, name: lit_name) {
                          Present { value: _ } => true
                          Absent => false
                        }
                      }
                    } else if lookup_type_by_name(env: scope.type_env, name: lit_name) != none
                      && lookup_type_by_name(env: scope.type_env, name: formal_name) != none {
                      true
                    } else {
                      false
                    }
                }
              }
              }
            Absent => false
          }
        }
      }
    _ => false
  }
}

fn direct_call_structured_record_literal_resolved_type_mismatch(
  formal: Node,
  actual_expr: Node,
  type_env: TypeEnv,
  module_name: String,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  match actual_expr.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      let formal_peeled = peel_nominal_alias_identity(n: formal, env: type_env, module_name: module_name)
      let formal_name = authored_name_at(source_indices: source_indices, node: formal_peeled)
      match record_lit_type_name_at(texpr: actual_expr, source_indices: source_indices) {
        Present { value: lit_name } =>
          if application_type_names_compatible(
            formal_name: formal_name, lit_name: lit_name,
            type_env: type_env, module_name: module_name, source_indices: source_indices) {
            false
          } else {
            let actual_raw = resolved_type(n: actual_expr)
            let actual = peel_nominal_alias_identity(n: actual_raw, env: type_env, module_name: module_name)
            direct_call_arg_type_mismatch(
              formal: formal, actual: actual, type_env: type_env, module_name: module_name, source_indices: source_indices)
          }
        Absent =>
          let actual_raw = resolved_type(n: actual_expr)
          let actual = peel_nominal_alias_identity(n: actual_raw, env: type_env, module_name: module_name)
          direct_call_arg_type_mismatch(
            formal: formal, actual: actual, type_env: type_env, module_name: module_name, source_indices: source_indices)
      }
    _ => false
  }
}

type CallFormalApplication {
  index: Int
  param_name: String
  formal_subst: Node
  formal: Node
  matched_arg: Optional<Node>
}

data call_application_plan_note: String = "Cost shape (DESIGN §6 bare-minimum-cost) and single authority (§3). direct_call_arg_mismatch_diags and direct_call_structured_application_mismatch_diags were line-for-line duplicates of the same per-formal prologue: param_node_type_expr, substitute_generics, peel_nominal_alias_identity, authored_name_at, and the named-then-positional actual search. Both run over the SAME value_params, typed_args and call_subst at the one direct-call seam, so every formal was canonicalized twice per call. peel_nominal_alias_identity is resolve_node_bounded, an unmemoized recursive rebuild allocating a fresh Node per level, and it measured as the ENTIRE cost of the conformance seam: on gunbc.host_effect_realize the two timed peels inside direct_call_arg_mismatch_diags accounted for that function to within instrument overhead (62719ms + 62804ms against 125438ms over 330 calls), while the timer around direct_call_arg_type_mismatch never entered the top fourteen operations and substitute_generics already short-circuits an empty substitution. That module holds 63% of all corpus type inference. Building the binding ONCE and passing it to both consumers is the deduplication, not a cache: no map is introduced, so nothing here becomes an order-exposing operation in the v2.std.determinism denominator. Behavior is identical because every recomputed term is a pure function of arguments both callers already share."

fn build_call_application_plan(
  value_params: List<Node>,
  typed_args: List<Node>,
  call_subst: Map<String, Node>,
  type_env: TypeEnv,
  module_name: String
) -> List<CallFormalApplication> {
  let source_indices = type_env.source_indices
  map(
    value_params |> enumerate,
    pair =>
      let formal_raw = param_node_type_expr(n: pair.second)
      let formal_subst = substitute_generics(n: formal_raw, subst: call_subst, source_indices: source_indices)
      let param_name = authored_name_at(source_indices: source_indices, node: pair.second)
      CallFormalApplication {
        index: pair.first,
        param_name: param_name,
        formal_subst: formal_subst,
        formal: peel_nominal_alias_identity(n: formal_subst, env: type_env, module_name: module_name),
        matched_arg: match typed_args |> filter(ta => arg_has_name(arg: ta, name: param_name, source_indices: source_indices)) |> first {
          Present { value: named_ta } => Present { value: named_ta }
          Absent => typed_args |> skip(pair.first) |> first
        }
      }
  )
}

fn direct_call_structured_application_mismatch_diags(
  plan: List<CallFormalApplication>,
  scope: InferScope
) -> List<ErrorNode> {
  let type_env = scope.type_env
  let module_name = scope.module_name
  let source_indices = type_env.source_indices
  flat_map(
    plan,
    app =>
      let formal_subst = app.formal_subst
      let formal = app.formal
      match app.matched_arg {
        Present { value: ta } =>
          let actual_expr = arg_value(n: ta)
          if structured_application_site_type_mismatch_with_peeled(formal: formal_subst, formal_peeled: formal, actual_expr: actual_expr, scope: scope)
            || direct_call_structured_record_literal_resolved_type_mismatch(
              formal: formal, actual_expr: actual_expr, type_env: type_env, module_name: module_name, source_indices: source_indices) {
            let actual_raw = resolved_type(n: actual_expr)
            let actual = peel_nominal_alias_identity(n: actual_raw, env: type_env, module_name: module_name)
            [type_mismatch_error(
              expected: node_type_shape(n: formal, source_indices: source_indices),
              got: node_type_shape(n: actual, source_indices: source_indices),
              span: actual_expr.span,
              module_name: module_name
            )]
          } else {
            []
          }
        Absent => []
      }
  )
}

fn container_element_nominal_brand_mismatch(
  formal: Node,
  actual: Node,
  type_env: TypeEnv,
  module_name: String,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  if node_is_element_collection(n: formal, source_indices: source_indices)
    && node_is_element_collection(n: actual, source_indices: source_indices)
    && authored_name_at(source_indices: source_indices, node: formal) == authored_name_at(source_indices: source_indices, node: actual) {
    match formal.children |> first {
      Present { value: formal_ch } =>
        match actual.children |> first {
          Present { value: actual_ch } =>
            let formal_el = peel_nominal_alias_identity(
              n: child_type_node(ch: formal_ch), env: type_env, module_name: module_name)
            let actual_el = peel_nominal_alias_identity(
              n: child_type_node(ch: actual_ch), env: type_env, module_name: module_name)
            nominal_call_arg_brand_mismatch(formal: formal_el, actual: actual_el, type_env: type_env, source_indices: source_indices)
          Absent => false
        }
      Absent => false
    }
  } else { false }
}

fn direct_call_arg_type_mismatch(
  formal: Node,
  actual: Node,
  type_env: TypeEnv,
  module_name: String,
  source_indices: Map<String, NewlineIndex>
) -> Bool {
  if type_node_is_callable(n: formal) || type_node_is_callable(n: actual) { false }
  else {
    nominal_call_arg_brand_mismatch(formal: formal, actual: actual, type_env: type_env, source_indices: source_indices)
      || container_element_nominal_brand_mismatch(
        formal: formal, actual: actual, type_env: type_env, module_name: module_name, source_indices: source_indices)
      || kernel_value_declared_type_mismatch(
        formal: formal, actual: actual, type_env: type_env, source_indices: source_indices)
  }
}

fn borrowed_callable_call_type(gnode: Node, typed_args: List<Node>, scope: InferScope) -> Node {
  let source_indices = scope.type_env.source_indices
  let base = callable_inferred(n: gnode)
  let tp_names = fn_type_param_names(item: gnode, source_indices: source_indices)
  if tp_names |> count == 0 {
    base
  } else {
    let value_params = gnode.params |> filter(p => !param_is_generic_decl(p: p, source_indices: source_indices))
    let subst = fold(value_params |> enumerate, init: empty_map(), f: (acc, pair) =>
      let formal_raw = param_node_type_expr(n: pair.second)
      let param_name = authored_name_at(source_indices: source_indices, node: pair.second)
      let matched_arg = match typed_args |> filter(ta => arg_has_name(arg: ta, name: param_name, source_indices: source_indices)) |> first {
        Present { value: named_ta } => Present { value: named_ta }
        Absent => typed_args |> skip(pair.first) |> first
      }
      match matched_arg {
        Present { value: ta } => unify_generics(formal: formal_raw, actual: resolved_type(n: arg_value(n: ta)), generic_names: tp_names, source_indices: source_indices, acc: acc)
        Absent => acc
      }
    )
    substitute_generics(n: base, subst: subst, source_indices: source_indices)
  }
}

fn is_anonymous_bound_name(name: String) -> Bool { name == "_" }

fn call_arg_label_matches_param(param_name: String, arg_label: String) -> Bool {
  param_name == arg_label
    || param_name == "_"
    || (string_length(s: param_name) >= 1
        && substring(s: param_name, start: 0, end: 1) == "_"
        && substring(s: param_name, start: 1, end: string_length(s: param_name)) == arg_label)
}

fn param_binds_positionally(p: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match p.children |> first {
    Present { value: type_expr } =>
      authored_name_at(source_indices: source_indices, node: type_expr) != authored_name_at(source_indices: source_indices, node: p)
    Absent => false
  }
}

data call_arg_bound_param_at_binding_key_note: String = "Runtime (v1_interpreter.rs call_function_inner) keys `bindings` differently per argument form: a NAMED actual is inserted under its own literal caller label (`bindings.insert(ctx.sym(name), ...)` — the raw label, never resolved through the underscore idiom to a declared name), while a POSITIONAL actual is inserted under the declared name it fills by running positional index (`bindings.insert(ctx.sym(&param_names[positional_idx]), ...)`). Two named actuals therefore collide only when they carry the SAME literal label, and a positional-then-named collision (`one(1, a: 2)`) only when the named label equals the positional slot's declared name (found by review 48724). Resolving a named actual's key through declared_names via call_arg_label_matches_param (the prior form of this function) is a DIFFERENT and wrong key: filter-then-first picks whichever declared param the caller-label test hits first in declaration order, and an underscore-named param (`_: Edge`) matches ANY label unconditionally, so a later exact-named actual (`child:` against declared `child`) could be shadowed into colliding with an unrelated earlier underscore-idiom actual (`e:` against declared `_`) even though the runtime keys them apart as \"e\" and \"child\" — the false positive measured live at src/v2/std/cardinality.dag's termination_proof_fold_step(acc:, e:, child:) call against fn termination_proof_fold_step(acc, _: Edge, child), which compiled clean before this correction and fails at this wall after it without the fix."

type CallArgBoundParamAccum {
  bound: String?
  pos: Int
}

fn call_arg_bound_param_at(
  idx: Int,
  typed_args: List<Node>,
  source_indices: Map<String, NewlineIndex>,
  positionally_eligible_names: List<String>
) -> String? {
  typed_args |> take(idx + 1) |> fold(init: CallArgBoundParamAccum { bound: none, pos: 0 }, f: (acc, ta) =>
    match arg_name_at(n: ta, source_indices: source_indices) {
      Present { value: label } =>
        (CallArgBoundParamAccum { bound: Present { value: label }, pos: acc.pos })
      Absent =>
        (CallArgBoundParamAccum { bound: positionally_eligible_names |> skip(acc.pos) |> first, pos: acc.pos + 1 })
    }).bound
}

type CallShapeArityScan {
  positional_slot: Int
  required_count: Int
  supplied_count: Int
  deficit_param: Node?
}

fn scan_call_shape_arity(
  sig_params: List<Node>,
  typed_args: List<Node>,
  positional_args: List<Node>,
  source_indices: Map<String, NewlineIndex>
) -> CallShapeArityScan {
  fold(
    sig_params,
    init: CallShapeArityScan {
      positional_slot: 0,
      required_count: 0,
      supplied_count: 0,
      deficit_param: none
    },
    f: (st, param) =>
      if st.deficit_param != none {
        st
      } else if param_is_generic_decl(p: param, source_indices: source_indices) {
        st
      } else if param_node_default_value(n: param) != none {
        st
      } else {
        let param_name = authored_name_at(source_indices: source_indices, node: param)
        let named_supplied = typed_args |> any(ta =>
          match arg_name_at(n: ta, source_indices: source_indices) {
            Present { value: label } => call_arg_label_matches_param(param_name: param_name, arg_label: label)
            Absent => false
          })
        let next_required = st.required_count + 1
        if named_supplied {
          CallShapeArityScan {
            positional_slot: st.positional_slot,
            required_count: next_required,
            supplied_count: st.supplied_count + 1,
            deficit_param: none
          }
        } else if param_binds_positionally(p: param, source_indices: source_indices) {
          if st.positional_slot < length(xs: positional_args) {
            CallShapeArityScan {
              positional_slot: st.positional_slot + 1,
              required_count: next_required,
              supplied_count: st.supplied_count + 1,
              deficit_param: none
            }
          } else {
            CallShapeArityScan {
              positional_slot: st.positional_slot,
              required_count: next_required,
              supplied_count: st.supplied_count,
              deficit_param: Present { value: param }
            }
          }
        } else {
          CallShapeArityScan {
            positional_slot: st.positional_slot,
            required_count: next_required,
            supplied_count: st.supplied_count,
            deficit_param: Present { value: param }
          }
        }
      }
  )
}

fn direct_call_shape_diags(func_name: String, sig_params: List<Node>, typed_args: List<Node>, type_env: TypeEnv, module_name: String, call_span: SourceSpan) -> List<ErrorNode> {
  let source_indices = type_env.source_indices
  let declared_names = sig_params |> map(p => authored_name_at(source_indices: source_indices, node: p))
  let positionally_eligible_names = sig_params |> filter(p => param_binds_positionally(p: p, source_indices: source_indices)) |> map(p => authored_name_at(source_indices: source_indices, node: p))
  let unknown_label_diags = typed_args |> flat_map(ta =>
    match arg_name_at(n: ta, source_indices: source_indices) {
      Present { value: label } =>
        if any(declared_names, pn => call_arg_label_matches_param(param_name: pn, arg_label: label)) { [] }
        else {
          [make_error_node(
            diagnostic: CallArgumentNameUnknown { callee: func_name, argument: label, declared: declared_names, span: ta.span },
            module_name: module_name)]
        }
      Absent => []
    })
  let positional_capacity = sig_params |> filter(p => param_binds_positionally(p: p, source_indices: source_indices)) |> count
  let positional_args = typed_args |> filter(ta => arg_name_at(n: ta, source_indices: source_indices) == none)
  let surplus_diags = if (positional_args |> count) > positional_capacity {
    match positional_args |> skip(positional_capacity) |> first {
      Present { value: overflow } =>
        [make_error_node(
          diagnostic: CallPositionalSurplus { callee: func_name, supplied: positional_args |> count, capacity: positional_capacity, span: overflow.span },
          module_name: module_name)]
      Absent => []
    }
  } else { [] }
  let duplicate_label_diags = typed_args |> enumerate |> flat_map(pair =>
    let current_bound = call_arg_bound_param_at(idx: pair.first, typed_args: typed_args, source_indices: source_indices, positionally_eligible_names: positionally_eligible_names)
    match current_bound {
      Present { value: bound_name } =>
        let earlier_dup = typed_args |> enumerate |> any(other =>
               other.first < pair.first
                 && call_arg_bound_param_at(idx: other.first, typed_args: typed_args, source_indices: source_indices, positionally_eligible_names: positionally_eligible_names) == current_bound)
        if earlier_dup && !is_anonymous_bound_name(name: bound_name) {
          [make_error_node(
            diagnostic: CallArgumentDuplicate { callee: func_name, argument: bound_name, span: pair.second.span },
            module_name: module_name)]
        } else { [] }
      Absent => []
    })
  let arity_scan = scan_call_shape_arity(
    sig_params: sig_params,
    typed_args: typed_args,
    positional_args: positional_args,
    source_indices: source_indices
  )
  let deficit_diags = match arity_scan.deficit_param {
    Present { value: missing_param } =>
      [make_error_node(
        diagnostic: CallPositionalDeficit {
          callee: func_name,
          parameter: authored_name_at(source_indices: source_indices, node: missing_param),
          supplied: arity_scan.supplied_count,
          required: arity_scan.required_count,
          span: call_span
        },
        module_name: module_name)]
    Absent => []
  }
  concat(concat(unknown_label_diags, surplus_diags), concat(duplicate_label_diags, deficit_diags))
}

fn function_value_call_named_arg_diags(
  func_name: String,
  typed_args: List<Node>,
  type_env: TypeEnv,
  module_name: String,
  body_locals: Map<String, Bool>,
  locals: Map<String, TypeBinding>
) -> List<ErrorNode> {
  match map_get(body_locals, func_name) {
    Absent => []
    Present { value: _ } => {
      let named_diags = typed_args |> flat_map(ta =>
        match arg_name_at(n: ta, source_indices: type_env.source_indices) {
          Present { value: label } =>
            [make_error_node(
              diagnostic: CallNamedArgOnFunctionValue { callee: func_name, argument: label, span: ta.span },
              module_name: module_name)]
          Absent => []
        })
      let arity_diags = match map_get(locals, func_name) {
        Present { value: binding } =>
          let param_count = binding.resolved.params |> count
          if param_count > 0 {
            let supplied = typed_args |> count
            if supplied > param_count {
              match typed_args |> skip(param_count) |> first {
                Present { value: overflow } =>
                  [make_error_node(
                    diagnostic: CallPositionalSurplus {
                      callee: func_name,
                      supplied: supplied,
                      capacity: param_count,
                      span: overflow.span
                    },
                    module_name: module_name)]
                Absent => []
              }
            } else { [] }
          } else { [] }
        Absent => []
      }
      concat(named_diags, arity_diags)
    }
  }
}

data function_value_named_application_wall_note: String = "WALL (DESIGN §5) — RUNG (§4b): mitigatable minimum for the class named actuals on function-value application. Reason: coverage path (5) — record-field fn value invoked as cfg.callback(a:) via ExprMethodCall — is compile-clean Accepted today and bypasses both this wall and #7519; executing probe function_value_field_method_known_hole_probe (ct_function_value_field_method_known_hole_probe_test) pins that hole and flips to a permanent regression control when the method-call label wall lands. The direct-call label wall (direct_call_shape_wall_note, gunbc#7519) runs only when a module fn sig resolves at the ExprCall seam. Function-value calls route through body_locals shadowing (call_locals_shadow_note): a let-bound or parameter callee skips sig lookup, so named actuals were silently accepted while the emitter's order_typed_call_args cannot reorder them (lookup_func_sig_in_scope returns Absent) and labels are not validated against any declared parameter authority. This wall refuses every named actual when the callee is a body-scope binding — the function-value path — until declaration-identity join can validate labels against the underlying fn. Positional calls on function values stay allowed. Named actuals on direct module/builtin calls (sig resolved) remain on the sibling wall. COVERAGE ACROSS CALLEE PATHS (§4b rung honesty — class rung is the minimum in-scope path, specimens measured by execution): (1) ExprCall bare name in body_locals (fn param, let, match binder, lambda param) — THIS WALL; structurally guaranteed for named actuals on that path. (2) ExprCall bare name with module fn sig resolved — sibling direct_call_shape_wall_note (#7519). (3) Module-level data binding with typed fn value called by bare name (data cb: fn(...) = ...) — NOT body_locals; routes #7519 when lookup resolves (specimen: CallArgumentNameUnknown on cb(a:, b:)). (4) Generic HO param where the arrow is a type variable (agree: F) — body_locals; same wall as (1). (5) Record field holding fn value invoked as cfg.callback(a:) — UNCOVERED HOLE: parser make_call_expr maps ExprFieldAccess callee to ExprMethodCall, not ExprCall; neither this wall nor #7519 runs; specimen compiles clean with named actuals; executing probe function_value_field_method_known_hole_probe. Dissolve-on: method-call / ExprMethodCall argument-label wall (direct_call_shape_wall_note unwalled class (3)). (6) Immediate apply f()(a:) on a call result — syntax parses (make_call_expr default → ExprCall name \"<expr>\"); NOT body_locals, sig does not resolve; neither wall fires on named args; specimen fails InternalError before Accepted (non-identifier ExprCall callee not modeled) — unwritable as Accepted today, not a live compile-clean named-arg hole."

data direct_call_shape_wall_note: String = "WALL (DESIGN §5) — the compile seam now refuses the four direct-call shape states the interpreter refuses at runtime, so the two authorities agree instead of one refusing and the other absorbing. The runtime authority is v1_interpreter.rs call_function_inner: a caller label naming no declared parameter raises CallContractMismatch (accepting label x against a declared x, _x, or _ — the deliberately-unused-parameter idiom, mirrored here in call_arg_label_matches_param); a positional argument beyond the positional parameter list raises CallContractMismatch too; a required parameter omitted without a declared default raises CallContractMismatch too (param_node_default_value legitimately fills omissions that carry a default — only non-default params count as required); and a second actual binding under one already-bound parameter key raises CallContractMismatch too ('argument supplied more than once'). Before this wall the compile seam was SILENT on all four, and the divergence was three-way on the first two (measured live, 2026-07-31, the probe-2 receipt in the guarantee-lane census): `sub(a: 10, bb: 3)` against `fn sub(a: Int, b: Int)` compiled with zero diagnostics, the interpreter refused it loudly, and the Rust emitter silently REORDERED it positionally — order_typed_call_args's name-match-else-positional arm bound bb's value to b, so the emitted realization computed an answer the interpreter refuses: two realizations of one program disagreeing silently, the exact state the guarantee ladder calls silent wrongness. The mechanism of the compile silence was the same absorbing fallback one seam over: direct_call_arg_mismatch_diags walks PARAMS and falls back positionally (`typed_args |> skip(pair.first) |> first`) when no arg carries the param's name, so a mislabeled arg is absorbed into a position and only its TYPE is ever judged — the label itself was never a checked fact. This wall checks application shape at the direct-call seam via direct_call_shape_diags: every labeled actual must name a declared parameter (modulo the underscore idiom); unlabeled actuals must fit within the positional capacity; every required parameter (no default) must be supplied by name or positional slot — scan_call_shape_arity mirrors call_function_inner's binding walk, including the same positional-capacity predicate (a param binds positionally iff its type-expr child's authored name differs from its own); and no two actuals may resolve to the same declared parameter — call_arg_bound_param_at (binding-key discipline documented at call_arg_bound_param_at_binding_key_note) resolves each actual, named or positional, to the parameter it fills, mirroring exactly how call_function_inner keys `bindings`. WHY THIS CHECK IS NOT UNDER module_skips_direct_call_arg_check: that exemption exists for the TYPE judgment, whose false-positive classes are representation gaps (brand aliases, optionality's two forms, anonymous literals, expansion depth — the conformance wall's four measured classes). A LABEL has no representation: it is a surface string matched against a declared surface string, the same exact-membership judgment the interpreter performs, so the exemption's reason does not reach it and the wall runs over every module including the compiler's own sources. All four diagnostics BLOCK (CallArgumentNameUnknown, CallPositionalSurplus, CallPositionalDeficit, CallArgumentDuplicate — is_error_diagnostic and is_interpreter_blocking_diagnostic default arms), so a refused program never reaches emit — which retires the emission path's silent reorder for Accepted programs at this seam without touching order_typed_call_args: its positional arm remains the legitimate binding rule for unlabeled args, and the states it could absorb are no longer writable in an Accepted program. DELIBERATELY NOT WALLED, with its trigger: method/pipe-seam argument labels — this wall covers the direct-call seam (the sig != none branch); the method-call path binds its arguments through its own inference arms and is the method wall's territory. The subject grain of the climb, stated per the ladder's rung-honesty rule: the classes 'unknown argument label', 'positional surplus', 'missing required argument', and 'a caller label or slot is bound more than once' each move from mitigatable (runtime refusal on the interpretation path; silent wrong output or deferred NoSuchVariable on the emission path) to structurally guaranteed at the direct-call seam — no Accepted program contains one — while the method-pipe path stays at its measured rung, named here rather than implied climbed. DEFICIT REQUIRED-GRAIN RULING (measured 2026-08-05, option b): the only writable shape where scan_call_shape_arity's required set (skip param_is_generic_decl, else require when not positionally supplied) diverges from call_function_inner's is_value_param (`type_expr authored name != param name`) is a param spelled `x: x<...>` — the param name equals the applied-type constructor with a non-leaf type-expr — corpus census `grep -rPno '\\b([a-z_][a-z0-9_]*): \\1<'` over dag/ src/v1/ src/v2/: 0 sites; params with no type-expr child are unwritable from authored surface. This seam refuses that shape as CallPositionalDeficit; the interpreter does not — compile is authoritative here because a non-positional param with no default and no supplied binding cannot be bound; matching the looser runtime predicate would copy an interpreter deficit for symmetry, not prevent silent wrongness. THE CENSUS RECEIPT, run before landing rather than promised after (2026-07-31): the label/surplus wall refused 28 live sites across the [src/v1, dag] regen closure and the dag + src/v2 compile-clean closure, and every one was the same defect — a parameter renamed at its declaration while call sites kept the old label, absorbed positionally ever since: to_string(i:) against the renamed value (8 sites, src/v1/compile.dag), arm_body(arm:) against n, is_import_slot_node(p:) against n, fold_list(init:) against this corpus's declared empty (17 sites, one file), and floor_discovery_walk_failure_refusal_reason(path:) against path_opt. All were relabeled to the declared authority in the same change. The fold_list rows carry the sharpest lesson about WHY compile must hold this fact even where runtime does not: those 17 sites never failed live because the interpreter grounds fold_list natively (label-blind), while call_function_inner would refuse the same label on the user-fn path — so the program's meaning depended on WHICH dispatch tier happened to serve the call, and the label's truth was untested precisely where it was wrong. The wall pins the label to the one declared authority regardless of tier, which is what keeps the call sites correct when the native grounding dissolves into the declared surface (the primitive-realization-single-authority trigger). MEASURED BLIND SPOT, stated rather than implied covered: 3 more to_string(i:) sites in src/v1/dag_collect.dag never reached the wall because their callee resolves NO sig at this seam (no import, global-bare miss) — the sig == none fallthrough routes to the method bridge and this wall never sees the call. They were found by grep on the fossil's shape and fixed with the rest, but the CLASS stays open: a call whose callee sig does not resolve is judged by nothing here, and that fallthrough closes with resolution coverage (the namespace lane), not with a wider label check. (Corrected 2026-08-05: the duplicate-label class LANDED in the order this note originally specified — v1_interpreter.rs call_function_inner now refuses a second binding under one caller label (CallContractMismatch, 'argument supplied more than once') before this seam was given its mirror, CallArgumentDuplicate. The class 'a caller label is supplied more than once' therefore climbs from mitigatable (silent last-write-wins) to structurally guaranteed at the direct-call seam, alongside the other three; a whole-tree census at landing found zero live duplicate-label call sites, so the wall adds no new refusal to any existing corpus form.) (Corrected 2026-08-05, cursor review 48724: an interim version of the duplicate-label mirror keyed CallArgumentDuplicate on exact caller-label string equality, which overclaimed. The runtime authority (call_function_inner) keys `bindings` by resolved PARAMETER symbol, not by caller-label string, and populates that key from a positional bind exactly as it does from a named one — so a positional bind of the sole parameter followed by a same-parameter named actual (`one(1, a: 2)` against `fn one(a: Int)`) collides and refuses at runtime, a state the label-string-only compile check could not see (`Absent => false` for positional predecessors) and so compiled clean, reaching emit. CallArgumentDuplicate is now keyed the same way the runtime is: call_arg_bound_param_at resolves each actual — named or positional — to the declared parameter it fills (positional actuals against the interpreter's own filtered param_binds_positionally list, in running positional order; named actuals through call_arg_label_matches_param, the same underscore-idiom equality unknown-label matching already uses) and the wall refuses a second actual resolving to the same parameter, never comparing raw caller-label strings against each other. The measured false-negative this closes and its discriminating fixture: call_duplicate_mixed_red_source, a single-parameter positional-then-named collision that a label-string-only check could not distinguish from the corpus's positional-only and named-only green controls.) (Corrected 2026-08-05, live cardinality.dag false positive: the prior correction's 'resolves a NAMED actual through call_arg_label_matches_param to a declared parameter' also overclaimed. The runtime keys a named actual under its own LITERAL caller label, never resolved through the underscore idiom to a declared name; only a positional actual is keyed by resolved declared name. Resolving named actuals through declared_names let an underscore-named param (matching ANY label unconditionally) shadow an unrelated later exact-named actual into a false collision — measured live at termination_proof_fold_step(acc: acc, e: e, child: child) against fn termination_proof_fold_step(acc, _: Edge, child), which this wall wrongly refused on 'child' until call_arg_bound_param_at's named branch was corrected to bind directly to the caller's literal label.) (Corrected 2026-08-05, #7848 merge: this note previously described only the label/surplus/deficit trio or only the duplicate-label mirror depending on branch; merging the two PRs' parallel work on this same wall found no consistency defect between the two additions — both diagnostics BLOCK, both use the same declared-parameter binding discipline as their keying authority, and both honor the underscore idiom identically, so the merge is a union of coverage, not a reconciliation of conflicting semantics.) (Corrected 2026-08-05, review from parent session loyal-ant-382: the duplicate-binding key, as landed, keyed EVERY anonymous ('_') parameter under the same literal string regardless of position, so a signature with two or more anonymous parameters bound positionally (or a mix of positional and record-field/method-value invocation of the same signature) false-refused CallArgumentDuplicate on its second anonymous actual — a live specimen, provider_readiness_independence_claim in dag/gunbc/provider_readiness_claim_evidence.dag, carries exactly this shape. The class 'a caller label or slot is bound more than once' does NOT climb to structurally guaranteed for anonymous parameters and never claimed to on a correct reading — 'more than once' presupposes the binding is READ twice, and an anonymous parameter's body cannot read it at all, so two anonymous parameters filled at two positions are two distinct, unreadable slots, not one key bound twice. call_arg_bound_param_at's duplicate check (this file) now excludes a resolved binding of exactly '_' from the collision check via the top-level `is_anonymous_bound_name` function (the earlier-duplicate scan still runs unconditionally; its result is combined with `!is_anonymous_bound_name(name: bound_name)` in the final `if`) — an anonymous parameter can never collide with another anonymous parameter under this authority, named or positional. `is_anonymous_bound_name` is a top-level function rather than an inline comparison for the same reason `call_arg_label_matches_param` already is one in this file: 'what counts as anonymous' is a single fact the whole module should ask one authority for, not a `== '_'` literal repeated ad hoc at each call site that cares — the existing pattern, not a new one. The runtime mirror (v1_interpreter.rs call_function_inner) excludes '_' from its collision check the same way, but — unlike an outright exclusion from binding — still INSERTS the value under the '_' key on every anonymous bind: the insert is what the required-argument check (`param_supplied_at_call`, reading `bindings.contains_key`) depends on to see an anonymous parameter as filled, so removing the insert entirely (the fix's first, corrected draft) turned every anonymous-but-positionally-supplied parameter into a false CallPositionalDeficit/'missing required argument' one layer downstream of the duplicate check it was fixing. Harmless repeated overwrite under one dead key, never read by the body, is the correct shape here — not 'never bound' literally, but 'never checked for collision, and immaterial which write wins.' The two required regression fixtures: a call binding two-or-more anonymous parameters positionally (direct and via a stored function value) stays ACCEPTED; the existing named/mixed duplicate fixtures (call_duplicate_mixed_red_source, the cardinality.dag underscore-shadow control) stay RED, because those collide on a NAMED, readable label, not an anonymous one.)"

// Record-literal actuals skip this path; handoff lives in
// direct_call_structured_application_mismatch_diags (+ resolved-type legacy checks there).
fn direct_call_arg_mismatch_diags(
  plan: List<CallFormalApplication>,
  type_env: TypeEnv,
  module_name: String
) -> List<ErrorNode> {
  let source_indices = type_env.source_indices
  flat_map(
    plan,
    app =>
      let formal = app.formal
      match app.matched_arg {
        Present { value: ta } =>
          let actual_expr = arg_value(n: ta)
          if match actual_expr.expr_data {
            ExprRecordLit { parent_enum: _ } => true
            _ => false
          } {
            []
          } else {
          let actual_raw = resolved_type(n: actual_expr)
          let actual = peel_nominal_alias_identity(n: actual_raw, env: type_env, module_name: module_name)
          if direct_call_arg_type_mismatch(
            formal: formal, actual: actual, type_env: type_env, module_name: module_name, source_indices: source_indices) {
            [type_mismatch_error(
              expected: node_type_shape(n: formal, source_indices: source_indices),
              got: node_type_shape(n: actual, source_indices: source_indices),
              span: actual_expr.span,
              module_name: module_name
            )]
          } else {
            []
          }
          }
        Absent => []
      }
  )
}

type Tier2bBt {
  bt: Node
  kernel_diags: List<ErrorNode>
}

fn infer_tier2b_builtin_with_kernel_diags(func_name: String, typed_args: List<Node>, scope: InferScope, span: SourceSpan) -> Tier2bBt {
  if func_name == "lookup" || func_name == "map_get" {
    Tier2bBt {
      bt: match typed_args |> first {
        Present { value: receiver_arg } =>
          match arg_value(n: receiver_arg).inferred {
            Present { value: Resolved { node: receiver_type } } =>
              match map_value_type_in_env(type_node: receiver_type, env: scope.type_env) {
                Present { value: value_type } =>
                  with_optional_cardinality(n: value_type)
                Absent => resolve_builtin_call_type(name: func_name)
              }
            _ => resolve_builtin_call_type(name: func_name)
          }
        Absent => resolve_builtin_call_type(name: func_name)
      },
      kernel_diags: []
    }
  } else if func_name == "map_keys" || func_name == "sorted_map_keys" {
    match typed_args |> first {
      Present { value: receiver_arg } =>
        match arg_value(n: receiver_arg).inferred {
          Present { value: Resolved { node: receiver_type } } =>
            match map_key_type_in_env(type_node: receiver_type, env: scope.type_env) {
              Present { value: key_type } =>
                let lk = list_kernel_ty_from_element(element: key_type)
                Tier2bBt { bt: lk.ty, kernel_diags: lk.miss_diags }
              Absent => Tier2bBt { bt: resolve_builtin_call_type(name: func_name), kernel_diags: [] }
            }
          _ => Tier2bBt { bt: resolve_builtin_call_type(name: func_name), kernel_diags: [] }
        }
      Absent => Tier2bBt { bt: resolve_builtin_call_type(name: func_name), kernel_diags: [] }
    }
  } else if func_name == "map_values" {
    match typed_args |> first {
      Present { value: receiver_arg } =>
        match arg_value(n: receiver_arg).inferred {
          Present { value: Resolved { node: receiver_type } } =>
            match map_value_type_in_env(type_node: receiver_type, env: scope.type_env) {
              Present { value: value_type } =>
                let lv = list_kernel_ty_from_element(element: value_type)
                Tier2bBt { bt: lv.ty, kernel_diags: lv.miss_diags }
              Absent => Tier2bBt { bt: resolve_builtin_call_type(name: func_name), kernel_diags: [] }
            }
          _ => Tier2bBt { bt: resolve_builtin_call_type(name: func_name), kernel_diags: [] }
        }
      Absent => Tier2bBt { bt: resolve_builtin_call_type(name: func_name), kernel_diags: [] }
    }
  } else if func_name == "set_insert" || func_name == "set_union" || func_name == "set_contains" {
    let operand_elem = if func_name == "set_insert" || func_name == "set_contains" {
      match typed_args |> skip(1) |> first {
        Present { value: insert_arg } =>
          match arg_value(n: insert_arg).inferred {
            Present { value: Resolved { node: elem } } => Present { value: elem }
            _ => none
          }
        Absent => none
      }
    } else {
      match typed_args |> skip(1) |> first {
        Present { value: other_arg } =>
          match arg_value(n: other_arg).inferred {
            Present { value: Resolved { node: other_type } } =>
              match set_element_type_in_env(type_node: other_type, env: scope.type_env) {
                Present { value: elem_slot } => Present { value: child_type_node(ch: elem_slot) }
                Absent => none
              }
            _ => none
          }
        Absent => none
      }
    }
    let recv_is_set = match typed_args |> first {
      Present { value: receiver_arg } => set_builtin_receiver_is_set(receiver_arg: receiver_arg, scope: scope)
      Absent => false
    }
    let union_other_bad = if func_name == "set_union" {
      match typed_args |> skip(1) |> first {
        Present { value: other_arg } => set_union_other_operand_is_resolved_non_set(other_arg: other_arg, scope: scope)
        Absent => false
      }
    } else { false }
    let recv_elem = match typed_args |> first {
      Present { value: receiver_arg } =>
        match arg_value(n: receiver_arg).inferred {
          Present { value: Resolved { node: receiver_type } } =>
            set_element_type_from_receiver(receiver_type: receiver_type, scope: scope)
          _ => none
        }
      Absent => none
    }
    let elem_mismatch = match recv_elem {
      Present { value: re } =>
        match operand_elem {
          Present { value: oe } =>
            set_element_types_mismatch(recv_elem: re, operand_elem: oe, source_indices: scope.type_env.source_indices)
          Absent => false
        }
      Absent => false
    }
    let wrong_receiver_diags = if recv_is_set { [] } else {
      [inference_error(message: concat(func_name, " receiver must be a Set"), span: span, module_name: scope.module_name)]
    }
    let wrong_union_other_diags = if union_other_bad {
      [inference_error(message: "set_union second operand must be a Set", span: span, module_name: scope.module_name)]
    } else { [] }
    let mismatch_diags = if elem_mismatch {
      [inference_error(message: concat(func_name, " incompatible set element types"), span: span, module_name: scope.module_name)]
    } else { [] }
    let result_bt = if func_name == "set_contains" {
      if recv_is_set && !elem_mismatch { bool_type } else { resolve_builtin_call_type(name: func_name) }
    } else {
      match typed_args |> first {
        Present { value: receiver_arg } =>
          if recv_is_set && !elem_mismatch && !union_other_bad {
            match arg_value(n: receiver_arg).inferred {
              Present { value: Resolved { node: receiver_type } } =>
                match recv_elem {
                  Present { value: _ } => receiver_type
                  Absent =>
                    match operand_elem {
                      Present { value: element } => set_kernel_ty_from_element(element: element).ty
                      Absent => resolve_builtin_call_type(name: func_name)
                    }
                }
              _ => resolve_builtin_call_type(name: func_name)
            }
          } else {
            resolve_builtin_call_type(name: func_name)
          }
        Absent => resolve_builtin_call_type(name: func_name)
      }
    }
    let build_diags = if func_name == "set_contains" {
      []
    } else {
      match operand_elem {
        Present { value: element } =>
          if recv_is_set && !elem_mismatch && !union_other_bad { set_kernel_ty_from_element(element: element).miss_diags } else { [] }
        Absent => []
      }
    }
    Tier2bBt { bt: result_bt, kernel_diags: concat(wrong_receiver_diags, concat(wrong_union_other_diags, concat(mismatch_diags, build_diags))) }
  } else {
    Tier2bBt { bt: resolve_builtin_call_type(name: func_name), kernel_diags: [] }
  }
}

type MethodPipeFallback {
  result_ty: Node
  kernel_diags: List<ErrorNode>
}

fn method_existence_decision(recv_rt: Node, method_name: String, scope: InferScope, span: SourceSpan) -> MethodPipeFallback {
  let recv_shape = node_type_shape(n: recv_rt, source_indices: scope.type_env.source_indices)
  let recv_surface_established = kernel_profile_lookup(name: authored_name_at(source_indices: scope.type_env.source_indices, node: recv_rt)) != none
  if recv_surface_established {
    MethodPipeFallback {
      result_ty: error_type,
      kernel_diags: [make_error_node(
        diagnostic: MethodNotFound { method: method_name, receiver_type: recv_shape, span: span },
        module_name: scope.module_name
      )]
    }
  } else {
    let peeled = peel_where_refinement_base(ty: recv_rt, type_env: scope.type_env)
    let peeled_lookup = lookup_structural_method(receiver_type: peeled, method_name: method_name, source_indices: scope.type_env.source_indices)
    match peeled_lookup.resolution {
      Present { value: mfr } =>
        MethodPipeFallback { result_ty: mfr.result_type, kernel_diags: peeled_lookup.kernel_diagnostics }
      Absent =>
        let peeled_shape = node_type_shape(n: peeled, source_indices: scope.type_env.source_indices)
        let peeled_surface_established = kernel_profile_lookup(name: authored_name_at(source_indices: scope.type_env.source_indices, node: peeled)) != none
        if peeled_surface_established {
          MethodPipeFallback {
            result_ty: error_type,
            kernel_diags: [make_error_node(
              diagnostic: MethodNotFound { method: method_name, receiver_type: peeled_shape, span: span },
              module_name: scope.module_name
            )]
          }
        } else {
          match unresolved_method_frontier_trigger(module_name: scope.module_name, method: method_name, receiver_shape: recv_shape) {
            Present { value: trigger } =>
              if authored_name_at(source_indices: scope.type_env.source_indices, node: recv_rt) == "" {
                MethodPipeFallback {
                  result_ty: error_type,
                  kernel_diags: [make_error_node(
                    diagnostic: ReceiverTypeUnestablished { method: method_name, span: span },
                    module_name: scope.module_name
                  )]
                }
              } else {
                MethodPipeFallback {
                  result_ty: error_type,
                  kernel_diags: [make_error_node(
                    diagnostic: MethodExistenceFrontierAdmitted { method: method_name, receiver_type: recv_shape, trigger: dissolution_description(condition: trigger), span: span },
                    module_name: scope.module_name
                  )]
                }
              }
            Absent =>
              MethodPipeFallback {
                result_ty: error_type,
                kernel_diags: [make_error_node(
                  diagnostic: MethodExistenceUndecided { method: method_name, receiver_type: recv_shape, span: span },
                  module_name: scope.module_name
                )]
              }
          }
        }
    }
  }
}

fn method_pipe_map_keys_values_fallback(recv_rt: Node, method_name: String, scope: InferScope, span: SourceSpan) -> MethodPipeFallback {
  if method_name == "map_keys" || method_name == "sorted_map_keys" {
    match map_key_type_in_env(type_node: recv_rt, env: scope.type_env) {
      Present { value: key_type } =>
        let lk = list_kernel_ty_from_element(element: key_type)
        MethodPipeFallback { result_ty: lk.ty, kernel_diags: lk.miss_diags }
      Absent => method_existence_decision(recv_rt: recv_rt, method_name: method_name, scope: scope, span: span)
    }
  } else if method_name == "map_values" {
    match map_value_type_in_env(type_node: recv_rt, env: scope.type_env) {
      Present { value: value_type } =>
        let lv = list_kernel_ty_from_element(element: value_type)
        MethodPipeFallback { result_ty: lv.ty, kernel_diags: lv.miss_diags }
      Absent => method_existence_decision(recv_rt: recv_rt, method_name: method_name, scope: scope, span: span)
    }
  } else {
    method_existence_decision(recv_rt: recv_rt, method_name: method_name, scope: scope, span: span)
  }
}

data method_existence_wall_note: String = "WALL (DESIGN §5) — an unresolved method REFUSES; it never inherits the receiver type. The deleted else-arm returned recv_rt with an EMPTY diagnostic list, so an unknown method on List<T> became another List<T>: a success-shaped answer that survived a whole collection pipeline, stamped PlainMethodSemantics as if it had resolved. Nothing refused until InterpError::Unimplemented { what: \"method 'filter_map'\" } — whole-tree compile reported ZERO blocking errors while live dispatch returned HTTP 500 (#7479). THE DECIDABILITY PREDICATE IS THE LOAD-BEARING PART. It is PER-RECEIVER, not per-name: refuse exactly when kernel_profile_lookup returns a profile for the receiver canonical container kind, because tier0 (lookup_structural_method) has already consulted that profile algebra templates and missed — so reaching this arm with a kernel-profiled receiver PROVES the method is absent from that receiver complete declared surface. This is the same authority tier0 reads, not a second relation minted here (§3). A NAME-GRAIN PREDICATE WAS TRIED AND IS WRONG, and the receipt is worth keeping because it is subtle: gating on membership in a declared method-name roster admits any rostered name on ANY receiver, so List<Int> |> starts_with(..) and List<Int> |> to_upper() compiled clean while the diagnostic claimed the receiver was under-resolved — a fail-open with a message that also LIED about its cause, since Container(List,Primitive(Int)) is fully resolved (codex review 45327, confirmed by execution). Per-receiver closes both: those two now REFUSE. THE ONE MEASURED OBSTACLE TO PER-RECEIVER WAS A REAL §3 FORK, AND IT IS FIXED HERE RATHER THAN WORKED AROUND: free_monoid_scalar_templates omitted count while the interpreter dispatches it natively on strings (the length/count/size arm), so String |> count reached this arm and was admitted only by the fail-open — a hollow green. count is now declared on the String profile, matching the runtime, so it resolves at tier0 and never reaches here. WHAT STAYS UNDECIDED, and why refusing there would fabricate: a receiver with NO kernel profile has no complete declared surface to prove absence against. THE LARGEST MEASURED CLASS WAS NOT UNDECIDABLE AT ALL AND IS NOW DECIDED — a where-refinement alias arrived as Product(NonEmptyStr) only because resolve_method_receiver_type short-circuits on Conj and never peeled to the String base; peeling it (where_refinement_receiver_peel_note) moved 12 corpus sites out of this residue in both directions at once, resolving the correct .length() calls AND making a bogus method on a branded string a hard MethodNotFound. What remains genuinely has no surface: a lambda parameter whose type never propagates so the receiver has no authored name at all (the LexMatchThunk { apply: fn(s) } idiom in src/v2/compiler/01_tokenize.dag and the StoreObjectFold lambdas in extdeps/git/object_store.dag), a coproduct payload bound by pattern destructuring arriving typed Primitive(ok) (a correct labels |> list_push(label)), a bare type variable, and an Optional whose cardinality is dropped before lookup so the inner product is what arrives. Refusing those would red correct code, which is the mirror image of the fabricated success this wall deletes. A RECEIVER WITH NO AUTHORED NAME AT ALL is not weak evidence about the method — it is no evidence about anything, because the receiver's own type was never established upstream. That is a different judgment failure from 'this receiver has a surface and the method is not on it', so it carries its own diagnostic, ReceiverTypeUnestablished, whose message names that cause instead of implying the method is missing. THE DIAGNOSTIC NAMES THE CAUSE; THE ROSTER BOUNDS THE ADMISSION, and separating those two was a correction. The class was first admitted on the CAUSE alone — any anonymous receiver, non-blocking — on the reasoning that the wall cannot tell an existing method from a nonexistent one when the receiver has no type, so refusing would refuse both. That reasoning is sound about DECIDABILITY and wrong about ADMISSION: it made every future anonymous-receiver call green, including one whose method does not exist, so the exception was unbounded exactly where existence is unknown (codex review 45459). Counting a diagnostic does not stop invalid code reaching the live system. Admission is now gated on the same declared roster as every other unestablished shape, keyed (module, method, Primitive()), so the seven measured occurrences are admitted and a new one anywhere else REFUSES as MethodExistenceUndecided. That is a ratchet that can only shrink, and blocking a new instance of a known deficit is the factory model rather than an inconvenience. Everything that has a name but no surface stays in the same shape-keyed roster. MethodExistenceUndecided carries what is left as a typed, located, COUNTED non-blocking diagnostic (the is_error_diagnostic partition, UnlistedImportUse precedent) so the frequency stays observable and prioritizable rather than zeroed by construction — and it now means exactly ONE thing, receiver surface not established, rather than doubling as a name-grain escape. Both arms return error_type, never recv_rt, so one located refusal does not cascade downstream. AND THE WALL IS REACHED FROM EVERY ARM, WHICH IT WAS NOT AT FIRST: the decision lived inline in the final else of method_pipe_map_keys_values_fallback, so an unresolved map_keys, sorted_map_keys or map_values whose receiver is not a keyed collection took an EARLIER branch and returned recv_rt with an empty diagnostic list — the identical success-shaped fallback this wall exists to delete, preserved in the two special cases that ran before it (codex review 45430). A wall reachable only from the default arm is not a wall, and prose about the default arm cannot see the two arms in front of it. The decision is now method_existence_decision, held once and called from all three, with the control run against the prior binary rather than reasoned about: List<Int> |> map_keys and |> map_values compile with exit 0 on the pre-routing binary and produce two located MethodNotFound refusals on this one. Positive controls: map/filter/fold/flat_map resolve at tier0 and service ops at tier1, neither reaching this arm. THE UPSTREAM DEFECTS ARE NAMED BY THE MEASUREMENT, one fixed here and the rest left as promotion triggers that would each let the wall decide a further non-kernel receiver: (1) FIXED — a where-refinement alias resolving to a Product shape instead of peeling to its declared base before method lookup; (2) a lambda parameter receiver whose type never propagates from the declared fn type it is bound under; (3) a coproduct payload binding typed as the VARIANT name rather than the field type; (4) an optional receiver whose cardinality is dropped so the inner product reaches lookup in place of Optional own surface. Each is carried as a row in unresolved_method_frontier, keyed on the receiver shape that is the evidence for it, except (2) which is the ReceiverTypeUnestablished cause class above. THE INSTRUMENT WAS WRONG BEFORE THE WALL WAS, and that is the most transferable thing here: this wall was measured with `gunbc run --entry dag/tools/generated_artifact_gate.dag`, which reaches only that gate's import closure, and it reported CLEAN while twelve real sites sat outside it — they surfaced from CI instead. The whole-corpus instrument is `gunbc compile --source-root dag --source-root src/v2 --target dag`, the same compile-clean gate CI runs, and it resolves 1629 sources against 2740 indexed modules. A narrow instrument reporting clean is indistinguishable from a wall that works, which is the §5 specification-without-execution trap wearing the shape of a green run. A FOURTH SHAPE was then found and NOT fixed: a brand alias can also arrive as a plain qualified LEAF (Primitive(std.types.NonEmptyStr)) rather than the refinement Conj the peel walks. Three head-resolution strategies were implemented and measured against it — lookup_type_for on the node, lookup_type_by_name on the qualified name, and on its last segment — none recovered the refinement, so the machinery was DELETED rather than shipped unproven and the site is a declared row. Unproven machinery that decides nothing is worse than a declared row that admits what it cannot decide. Dissolve-on: primitive-realization-single-authority — one PrimitiveDefinition identity joining semantic definition, interpreter dispatch and per-target emit handler, at which point every receiver has a complete surface, the count-style forks are unwritable rather than hand-reconciled, and MethodExistenceUndecided is deleted."

data where_refinement_receiver_peel_note: String = "A where-refinement type is a Conj carrying its base as its single child and its predicates in type_annotation, and resolve_method_receiver_type SHORT-CIRCUITS on connective == Conj — it treats any product as already-structural and returns it untouched. So NonEmptyStr, declared `String where non_empty`, reached method lookup as Product(NonEmptyStr) and String's algebra profile was never consulted: `.length()` on a branded string had no surface to resolve against and no surface to prove absence against either, which put 12 correct corpus sites (8 in extdeps.filesystem.linux, 4 across gunbc.design) in the wall's undecided residue. This peel is the fix, and the FIRST version of it was a §3 violation that this note asserted its way past — worth recording, because the note is where the defect actually lived. It hand-rolled a second recursive walker over the Conj/annotation/single-child shape and then CLAIMED, in this sentence, that the refinement chain had one traversal authority and the peel was its second consumer. Both walkers independently encoded the shape test, the lookup_type_for base resolution and the recursion, so they could drift apart silently; the prose asserted the property instead of the code establishing it (codex review 45410). WHY THESE READ NODE STORAGE DIRECTLY, since it is asked and the answer is not a per-function one: they are 2 of the 589 direct Node-storage reads in this file (579 of them on origin/main), which is the v1 seed's pervasive and only idiom — the seed IS the traversal, the stage that walks the tree so that later stages need not. There is no canonical query or fold surface reachable from here: fold_node and node_query live in src/v2/std, no v1 seed module imports v2 at all, and v1 COMPILES v2, so routing v1 inference through v2's fold inverts the bootstrap rather than tidying it. DESIGN's fold_node line is scoped to the 7 v2 stages and is a DRY example within v2, not a rule binding the seed. So the disposition here is the SEED'S disposition, the same trigger the hand-Rust receipt carries — the v1 seed shrinks to zero at v2 self-host and these dissolve with it — and attaching a separate per-function trigger to 2 reads while 587 identical reads beside them carry none would be a fabricated bound, describing separable work that does not exist (codex review 45570). The repair is the extraction the claim described: where_refinement_chain is the one walk, it yields the refinement chain from the surface alias down to its ground base, and it has exactly two consumers — type_where_refinement_predicates_transitive flat_maps the immediate predicates over the chain, and peel_where_refinement_base takes its last link. The shape test itself is is_where_refinement_type, held once. Now there is one traversal authority, and it is one because the code says so. It runs only where the wall was already about to refuse or admit, so no previously-resolving call changes meaning; tier0 keeps first claim on the unpeeled receiver, which is what preserves a method declared on the brand itself. The consequence that matters is not that 12 sites went green — it is that they became DECIDABLE IN BOTH DIRECTIONS: once the peeled receiver is kernel-profiled, a method genuinely absent from String now refuses as MethodNotFound instead of resting in the frontier. Widening what the wall can decide is the only move that shrinks the frontier without either fabricating a success or fabricating a refusal."

type UnresolvedMethodFrontierRow {
  module_name: String
  method: String
  receiver_shape: String
  occurrences: Int
  cause: String
  dissolution: DissolutionCondition
}

fn unresolved_method_frontier() -> List<UnresolvedMethodFrontierRow> {
  [
    {
      module_name: "v2.compiler.tokenize",
      method: "apply",
      occurrences: 7,
      receiver_shape: "Primitive()",
      cause: "receiver is a lambda parameter whose type is never inferred, so it arrives with NO authored name at all. The call is a product FIELD holding a callable — the LexMatchThunk { apply: fn(s) } idiom — not a method at all.",
      dissolution: unbound_dissolution(description: "lambda-parameter receiver typing, so the receiver resolves to its declared product and apply is found as a field")
    },
    {
      module_name: "extdeps.git.object_store",
      method: "map",
      occurrences: 2,
      receiver_shape: "Primitive()",
      cause: "receiver is `tree.entries` where `tree` is the parameter of a lambda stored in a StoreObjectFold record field, so the field's declared fn type never reaches the lambda's parameter and the projection off it has no established type.",
      dissolution: unbound_dissolution(description: "lambda-parameter receiver typing from the declared fn type of the record field the lambda is stored in")
    },
    {
      module_name: "extdeps.git.object_store",
      method: "flat_map",
      occurrences: 1,
      receiver_shape: "Primitive()",
      cause: "same StoreObjectFold lambda-parameter shape as the `map` row above; listed separately because the key names one method on one receiver shape, never a module-wide pass.",
      dissolution: unbound_dissolution(description: "lambda-parameter receiver typing from the declared fn type of the record field the lambda is stored in")
    },
    {
      module_name: "extdeps.mercurial",
      method: "any",
      occurrences: 3,
      receiver_shape: "Primitive()",
      cause: "receiver is an untyped parameter of a lambda stored in a fold record field, the same shape as the object_store rows.",
      dissolution: unbound_dissolution(description: "lambda-parameter receiver typing from the declared fn type of the record field the lambda is stored in")
    },
    {
      module_name: "gunbc.scm_compatibility.mercurial",
      method: "map",
      occurrences: 3,
      receiver_shape: "Primitive()",
      cause: "receiver is `missing_changesets`, an untyped parameter of the `partial:` lambda in a MercurialRepositoryCompletenessFold record field.",
      dissolution: unbound_dissolution(description: "lambda-parameter receiver typing from the declared fn type of the record field the lambda is stored in")
    },
    {
      module_name: "extdeps.dns.domain_name",
      method: "list_push",
      occurrences: 1,
      receiver_shape: "Primitive(ok)",
      cause: "receiver is a coproduct payload bound by pattern destructuring, which arrives typed as the VARIANT name rather than the field type.",
      dissolution: unbound_dissolution(description: "coproduct payload binding typed as the field type, at which point the receiver is List and DECIDABLE")
    },
    {
      module_name: "v1.compiler.trace",
      method: "map",
      occurrences: 1,
      receiver_shape: "Product(SpanMapping)",
      cause: "receiver is an Optional produced by `|> last`, and the optional functor is being mapped over. It arrives as the INNER product because the optional cardinality is dropped before method lookup, so Optional's own surface is never consulted.",
      dissolution: unbound_dissolution(description: "reconciling the two optionality representations (cardinality-marked node vs the nominal Optional coproduct) so an optional receiver keeps its optional surface at method lookup")
    },
    {
      module_name: "gunbc.source_integration_landing_spine",
      method: "map",
      occurrences: 1,
      receiver_shape: "Node(Optional)",
      cause: "same optional-functor class as the v1.compiler.trace row, in its OTHER surface form: here the Optional survives as a named node rather than collapsing to its inner product, and neither form carries a method surface. Two shapes for one concept is itself the defect the trigger names.",
      dissolution: unbound_dissolution(description: "reconciling the two optionality representations so an optional receiver keeps its optional surface at method lookup")
    },
    {
      module_name: "test.claim.sccache_local_content_verified_on_read",
      method: "contains",
      occurrences: 1,
      receiver_shape: "Primitive(std.types.NonEmptyStr)",
      cause: "the brand-alias class in its LEAF form. The receiver is a coproduct variant payload whose declared type is NonEmptyStr, and it arrives not as the refinement Conj the peel walks but as a plain leaf carrying the QUALIFIED name std.types.NonEmptyStr — so there is no refinement chain to descend and no kernel profile under that name. Three head-resolution strategies were tried against this site and measured: resolving the leaf through lookup_type_for, through lookup_type_by_name on the qualified name, and on its last segment. NONE of them recovered the refinement, so the machinery was deleted rather than shipped unproven, and the site is declared here instead. Why the peel reaches the Conj form but not this one is not yet understood, and saying so is more useful than a fourth guess.",
      dissolution: unbound_dissolution(description: "one representation for a brand alias at method lookup — the same reconciliation the conformance wall's class (2) names — so the leaf and Conj forms stop being two shapes for one concept")
    },
    {
      module_name: "v2.std.compilers.target_model",
      method: "lookup",
      occurrences: 1,
      receiver_shape: "Primitive(T)",
      cause: "receiver is a bare type variable. This one is genuinely undecidable at this seam rather than a resolution defect: nothing establishes what T offers.",
      dissolution: unbound_dissolution(description: "primitive-realization-single-authority, giving every receiver a complete declared method surface")
    }
  ]
}

fn frontier_diag_matches_row(d: CompilerDiagnostic, method: String, receiver_shape: String) -> Bool {
  match diagnostic_frontier_occurrence_key(d: d) {
    Present { value: key } => key.method == method && key.receiver_shape == receiver_shape
    Absent => false
  }
}

fn frontier_row_observed(diagnostics: List<ErrorNode>, method: String, receiver_shape: String) -> List<ErrorNode> {
  diagnostics |> filter(e => frontier_diag_matches_row(d: e.diagnostic, method: method, receiver_shape: receiver_shape))
}

fn frontier_row_budget_span(observed: List<ErrorNode>, module_span: SourceSpan) -> SourceSpan {
  match observed |> first {
    Present { value: witness } => diagnostic_to_span(d: witness.diagnostic)
    Absent => module_span
  }
}

fn frontier_row_budget_diags(row: UnresolvedMethodFrontierRow, diagnostics: List<ErrorNode>, module_name: String, module_span: SourceSpan) -> List<ErrorNode> {
  if (frontier_row_observed(diagnostics: diagnostics, method: row.method, receiver_shape: row.receiver_shape) |> count) == row.occurrences {
    []
  } else {
    [make_error_node(
      diagnostic: FrontierOccurrenceBudgetExceeded {
        method: row.method,
        receiver_type: row.receiver_shape,
        declared: row.occurrences,
        observed: frontier_row_observed(diagnostics: diagnostics, method: row.method, receiver_shape: row.receiver_shape) |> count,
        span: frontier_row_budget_span(
          observed: frontier_row_observed(diagnostics: diagnostics, method: row.method, receiver_shape: row.receiver_shape),
          module_span: module_span)
      },
      module_name: module_name)]
  }
}

fn frontier_occurrence_budget_diags(module_name: String, module_span: SourceSpan, diagnostics: List<ErrorNode>) -> List<ErrorNode> {
  unresolved_method_frontier()
    |> filter(r => r.module_name == module_name)
    |> flat_map(r => frontier_row_budget_diags(row: r, diagnostics: diagnostics, module_name: module_name, module_span: module_span))
}

data frontier_occurrence_budget_note: String = "THE COUNT IS WHAT MAKES THE FRONTIER A RATCHET INSTEAD OF AN EXEMPTION. Keying admission on (module, method, receiver_shape) bounds WHERE an unresolved call may live but not HOW MANY may live there, so a second call in the same module, on the same method, failing to resolve the same way, inherited the admission — and that is not hypothetical: the measured rows are not all singletons (v2.compiler.tokenize admits seven `apply` calls, extdeps.mercurial three `any`, gunbc.scm_compatibility.mercurial three `map`), so a row admitting seven would silently admit an eighth (codex review 45464). Each row therefore declares its MEASURED occurrence count and this fold refuses the excess, located on the first offending call. THE COMPARISON IS EQUALITY, AND IT WAS FIRST WRITTEN AS A CEILING, WHICH DID NOT RATCHET. `observed > declared` was justified here on the reasoning that a narrower compile closure sees fewer occurrences of a module's rows, so equality would red a partial build. That reasoning is WRONG about this check: it runs per MODULE, and every occurrence of a module's rows is present whenever that module is typechecked at all — a closure that omits the module never runs its rows, so there is no partial-visibility case to protect. What the ceiling actually did was let seven shrink to six while the declared seven stood, so a seventh call could return silently: a static limit, not a ratchet, and the note claimed the ratchet anyway (codex review 45491). Equality closes it in the only way that works — fixing a call reds until the declared count is lowered, which removes the headroom a reintroduction would have slipped into. Both directions are asserted in the witness, because the under-count half is the half that makes it a ratchet and it is the one an author is tempted to relax. WHY NOT A STABLE PER-OCCURRENCE KEY, which would close this exactly: std.occurrence_identity is the corpus authority for occurrence identity and its own scope law forbids filename, SourceSpan, authored name, structural Node equality and content hash as identity inputs, allocating OccurrenceId inside one graph-scoped allocator instead. An allocator-assigned integer cannot appear as a literal in a declared row, because it is not stable across compiles — so a per-occurrence key is not merely unimplemented here, it is unavailable from the authority that owns the concept. The count is the strongest bound the substrate currently supports. Dissolve-on: a content-addressed occurrence identity stable across edits (the namespace lane's containment addressing), at which point rows key on the occurrence itself and the count field deletes."

fn frontier_occurrence_budget_checked(module_name: String, module_span: SourceSpan, diagnostics: List<ErrorNode>) -> List<ErrorNode> {
  concat(diagnostics, frontier_occurrence_budget_diags(module_name: module_name, module_span: module_span, diagnostics: diagnostics))
}

fn unresolved_method_frontier_trigger(module_name: String, method: String, receiver_shape: String) -> DissolutionCondition? {
  match unresolved_method_frontier()
    |> filter(r => r.module_name == module_name && r.method == method && r.receiver_shape == receiver_shape)
    |> first {
    Present { value: row } => Present { value: row.dissolution }
    Absent => none
  }
}

data unresolved_method_frontier_note: String = "The declared frontier for method calls whose receiver establishes NO method surface even after where-refinement peeling (DESIGN §7: a declared row with a reason and a migration trigger, countable and prioritizable, never a silent escape hatch). WHY A ROSTER AT ALL: MethodExistenceUndecided BLOCKS. Leaving the undecided class non-blocking meant emittable_graph still emitted code containing a method whose existence was never established — the same fail-open the wall claims to close, correctly refused twice in review (codex reviews 45357 and 45383). Blocking it outright was not available either: the residue is CORRECT, WORKING code, seven sites of it the v2 tokenizer own LexMatchThunk { apply: fn(s) } idiom, so a blanket refusal would refuse the compiler v2 is migrating to — fabricating a refusal, which §5 forbids exactly as it forbids fabricating a success. THE KEY IS (module, method, receiver_shape), AND THE THIRD COMPONENT IS THE CORRECTION. A (module, method) key was shipped first and was wrong on two counts, one found by review and one by execution, which is worth recording because they are the same defect seen from two sides. Review found it as a fail-open: any NEW apply call in v2.compiler.tokenize would inherit the pass even on a fully resolved receiver, so the note claim that no new fail-open can enter was false (codex review 45398). Execution found it as an UNDERCOUNT: the roster was measured over the v1 self-compile closure alone, and the first whole-corpus run reded seven sites in three modules the roster had never seen. Both dissolve into the same fix — the frontier admits a receiver whose surface could not be established, so the SHAPE of that receiver is the evidence, and keying on it means a new call refuses unless it reproduces the exact unestablished shape the row was measured on. The residue after that is 13 sites in four shapes: Primitive() with no authored name (a lambda parameter whose type never propagates, 10 sites), Primitive(T) (a bare type variable), Primitive(ok) (a coproduct payload typed as its variant name), and a Product that is really an Optional whose cardinality was dropped. Every one is an upstream receiver-resolution defect, not a method-existence fact, which is exactly why the wall cannot decide them and why each row names the resolution fix rather than a permanent exemption. Admitted rows still emit MethodExistenceFrontierAdmitted, counted and carrying its own trigger, so the frequency stays observable rather than zeroed by construction (§5). THE RESIDUAL WIDENING, STATED RATHER THAN CLAIMED AWAY: a second unresolved call to the same method, in the same module, on a receiver that fails to resolve in the same way, is still admitted. That is narrower than the module-wide pass it replaces and it is not zero. Closing it entirely needs an occurrence identity stable across edits — content-addressed, not line-anchored — which is the same containment/content-hash authority the namespace lane is landing; until then the honest bound is this key, and the peel above is the mechanism that actually SHRINKS the frontier rather than administering it."

fn categorized_error(message: String, span: SourceSpan, module_name: String, category: String) -> ErrorNode {
  make_error_node(diagnostic: InternalError { message: message, span: span }, module_name: module_name)
}

fn validate_cast(source_inferred: InferredNode?, target_name: String, span: SourceSpan, source_indices: Map<String, NewlineIndex>, module_name: String) -> ErrorNode? {
  match source_inferred {
    Present { value: Resolved { node: src_node } } =>
      let source_name = authored_name_at(source_indices: source_indices, node: src_node)
      if source_name == target_name { none }
      else if !is_dag_cast_domain_type(name: source_name) { none }
      else if !is_dag_cast_domain_type(name: target_name) { none }
      else if dag_can_cast(source_type: source_name, target_type: target_name) { none }
      else {
        let msg = concat("invalid cast: ", source_name, " as ", target_name)
        let diag = InternalError { message: msg, span: span }
        Present { value: make_error_node(diagnostic: diag, module_name: module_name) }
      }
    _ => none
  }
}

// THE LEAKED-OPTIONAL WALL. A cast does not eliminate absence -- it re-types the node and
// leaves the value alone, so `reading as String` over a `NonEmptyStr?` rendered the WRAPPER:
// production receipts on 2026-08-20 carried `probed_at=Present { value: 2026-08-20T21:11:38Z }`
// from fourteen such sites. `gunbc.clock_read` `probed_at_word` fixed those sites, and
// `test.claim.probed_at_word_witness_test` recorded the honest rung: reverting any one of them
// left both witnesses green, because a witness on the rendering authority cannot see who calls it.
// This is that carrier's declared next-rung trigger. Membership is decidable from the inferred
// cardinality alone -- no corpus knowledge, no name list -- so it is a wall (DESIGN section 5),
// and it refuses every cast off an optional source rather than only the text targets that made
// the defect visible, because the loss is the elimination that never happened, not the target's
// spelling. A cast whose TARGET is itself optional is not this class: it re-types the carrier
// with the absence intact, so it is left to validate_cast.
//
// WAS `source_name == "Optional"`, and a BARE-SPELLING comparison is the defect: authored
// names reach here qualified as often as not, so a source typed `v2.std.optional.Optional`
// was not recognised as optional at all and its cast escaped OptionalCastNotEliminated
// entirely. qualified_last_segment is the authority this file already uses for exactly this
// question (nominal_call_arg_brand_mismatch, is_set_collection); asking it here is using the
// existing one rather than minting a second.
//
// SCOPE, so this is not read as more than it is: this repairs ONE spelling comparison. The
// wider fact that `T?` and `Optional<T>` are two carriers for one concept is untouched and
// its remedy is upstream of this seam -- a `String?` field lost its optional marker at
// pattern destructuring long before any comparison runs, so reconciling the two carriers
// HERE would not clear those sites. That was measured and the repair withdrawn rather than
// shipped on a plausible story.
fn optional_cast_diags(
  source_inferred: InferredNode?,
  target_type: Node,
  span: SourceSpan,
  source_indices: Map<String, NewlineIndex>,
  module_name: String
) -> List<ErrorNode> {
  match source_inferred {
    Present { value: Resolved { node: src_node } } =>
      let source_name = authored_name_at(source_indices: source_indices, node: src_node)
      let source_is_optional = src_node.return_cardinality == CardOptional
        || qualified_last_segment(name: source_name) == "Optional"
      let target_is_optional = target_type.return_cardinality == CardOptional
      if source_is_optional && !target_is_optional {
        [make_error_node(
          diagnostic: OptionalCastNotEliminated {
            source_type: concat(source_name, "?"),
            target_type: authored_name_at(source_indices: source_indices, node: target_type),
            span: span
          },
          module_name: module_name)]
      } else { [] }
    _ => []
  }
}

fn type_variable_node(id: String) -> Node {
  Node { name: "", span: no_span(), ident_span: none, children: [], connective: NoConnective, params: [], inferred: Present { value: TypeVariable { id: id } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
}

fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

fn inferred_or_error(result: InferredNode?, fallback_message: String, fallback_span: SourceSpan) -> InferredNode {
  match result {
    Present { value: inferred } => inferred
    Absent => CompilerError { message: fallback_message, span: fallback_span }
  }
}

fn resolve_pattern_subject(scope: InferScope, scrutinee_subject: PatternSubject) -> PatternSubject {
  match scrutinee_subject {
    PatternResolved { node: scrutinee_type } =>
      pattern_subject_from_node(n: preserve_outer_optional_cardinality(outer: scrutinee_type, inner: resolve_scrutinee_type_node(env: scope.type_env, n: scrutinee_type)))
    PatternDynamic { span: dynamic_span } =>
      PatternDynamic { span: dynamic_span }
    PatternLookupBlocked =>
      PatternLookupBlocked
  }
}

fn annotate_pattern_parent_enums(pattern: MatchPattern, scrutinee_subject: PatternSubject, scope: InferScope) -> MatchPattern {
  match pattern {
    VariantPattern { name: variant_name, parent_enum: _, field_bindings: bindings } =>
      let resolved_scrut = resolve_pattern_subject(scope: scope, scrutinee_subject: scrutinee_subject)
      let inferred_parent = match resolved_scrut {
        PatternResolved { node: resolved_scrut_node } =>
          let scrutinee_name = authored_name_at(source_indices: scope.type_env.source_indices, node: resolved_scrut_node)
          let optional_cardinality_subject = resolved_scrut_node.return_cardinality == CardOptional && scrutinee_name != "Optional"
          let optional_coproduct_subject = scrutinee_name == "Optional" && (variant_name == "Present" || variant_name == "Absent")
          let witness_container_subject = is_witness_type_name(name: scrutinee_name) && (variant_name == "Holds" || variant_name == "Violates")
          if (optional_cardinality_subject || optional_coproduct_subject) && (variant_name == "Present" || variant_name == "Absent") {
            Present { value: "Optional" }
          } else if witness_container_subject {
            Present { value: "Witness" }
          } else {
            let is_coproduct = resolved_scrut_node.connective == Disj
            if is_coproduct {
              Present { value: scrutinee_name }
            } else { none }
          }
        PatternDynamic { span: _ } => none
        PatternLookupBlocked => none
      }
      let annotated_variant_name = variant_name
      let variant_lookup = lookup_variant_in_type(scrut: resolved_scrut, variant_name: variant_name, module_name: scope.module_name, env: scope.type_env, field_binding_count: bindings |> count)
      let variant_subject = lookup_result_subject(result: variant_lookup)
      let annotated_bindings = bindings |> map(binding =>
        let field_lookup = lookup_field_in_variant(variant: variant_subject, field_name: field_binding_name_at(n: binding, source_indices: scope.type_env.source_indices), module_name: scope.module_name, source_indices: scope.type_env.source_indices)
        let field_subject = lookup_result_subject(result: field_lookup)
        make_field_binding_node(field_name: field_binding_name_at(n: binding, source_indices: scope.type_env.source_indices), binding: annotate_pattern_parent_enums(pattern: field_binding_pattern(n: binding), scrutinee_subject: field_subject, scope: scope), span: binding.span, name_span: node_name_span(n: binding))
      )
      match inferred_parent {
        Present { value: parent_name } =>
          VariantPattern {
            name: annotated_variant_name,
            parent_enum: parent_name,
            field_bindings: annotated_bindings
          }
        Absent =>
          VariantPattern { name: variant_name, parent_enum: none, field_bindings: annotated_bindings }
      }
    _ => pattern
  }
}

fn build_params_scope(scope: InferScope, params: List<Node>) -> InferScope {
  let new_locals = fold(params, init: scope.locals, f: (acc, p) =>
    map_insert(acc, param_node_name_at(n: p, source_indices: scope.type_env.source_indices), TypeBinding { name: param_node_name_at(n: p, source_indices: scope.type_env.source_indices), resolved: param_node_type_expr(n: p), provenance: PreservedValue })
  )
  let new_body_locals = fold(params, init: scope.body_locals, f: (acc, p) =>
    map_insert(acc, param_node_name_at(n: p, source_indices: scope.type_env.source_indices), true)
  )
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: new_locals,
    body_locals: new_body_locals,
    match_bound_names: scope.match_bound_names,
    module_name: scope.module_name,
    service_registry: scope.service_registry,
    item_registry: scope.item_registry,
    caller_decl_name: scope.caller_decl_name,
    lambda_param_provenance: empty_map()
  }
}

fn extend_scope(scope: InferScope, name: String, resolved: Node, provenance: SubValueRelation) -> InferScope {
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: map_insert(scope.locals, name, TypeBinding { name: name, resolved: resolved, provenance: provenance }),
    body_locals: map_insert(scope.body_locals, name, true),
    match_bound_names: scope.match_bound_names,
    module_name: scope.module_name,
    service_registry: scope.service_registry,
    item_registry: scope.item_registry,
    caller_decl_name: scope.caller_decl_name,
    lambda_param_provenance: scope.lambda_param_provenance
  }
}

fn extend_scope_match_bound(scope: InferScope, name: String, resolved: Node, provenance: SubValueRelation) -> InferScope {
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: map_insert(scope.locals, name, TypeBinding { name: name, resolved: resolved, provenance: provenance }),
    body_locals: map_insert(scope.body_locals, name, true),
    match_bound_names: map_insert(scope.match_bound_names, name, true),
    module_name: scope.module_name,
    service_registry: scope.service_registry,
    item_registry: scope.item_registry,
    caller_decl_name: scope.caller_decl_name,
    lambda_param_provenance: scope.lambda_param_provenance
  }
}

fn extend_scope_with_params(scope: InferScope, params: List<String>) -> InferScope {
  let new_locals = fold(params, init: scope.locals, f: (acc, p) =>
    map_insert(acc, p, TypeBinding { name: p, resolved: type_variable_node(id: "lambda_param"), provenance: SubValueUnknown })
  )
  let new_body_locals = fold(params, init: scope.body_locals, f: (acc, p) =>
    map_insert(acc, p, true)
  )
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: new_locals,
    body_locals: new_body_locals,
    match_bound_names: scope.match_bound_names,
    module_name: scope.module_name,
    service_registry: scope.service_registry,
    item_registry: scope.item_registry,
    caller_decl_name: scope.caller_decl_name,
    lambda_param_provenance: scope.lambda_param_provenance
  }
}

fn scope_after_stmt_node(stmt: Node, stmt_type: Node, scope: InferScope) -> InferScope {
  match stmt.expr_data {
    ExprLet =>
      if stmt.children |> count <= 1 {
        let val = match stmt.children |> first {
          Present { value: v } => v
          Absent => stmt
        }
        extend_scope(scope: scope, name: let_binding_name_at(texpr: stmt, source_indices: scope.type_env.source_indices), resolved: stmt_type, provenance: classify_binding_provenance(val: val, scope: scope))
      } else {
        scope
      }
    _ => scope
  }
}

fn derive_field_provenance(scope: InferScope, scrutinee_provenance: SubValueRelation, scrutinee_subject: PatternSubject, variant_name: String, field_name: String) -> SubValueRelation {
  match scrutinee_provenance {
    SubValueUnknown => SubValueUnknown
    _ =>
      let scrut_type_name = match scrutinee_subject {
        PatternResolved { node: n } => authored_name_at(source_indices: scope.type_env.source_indices, node: resolved_type(n: n))
        _ => ""
      }
      if scrut_type_name == "" { SubValueUnknown }
      else {
        let ind_fields = inductive_fields_for(env: scope.type_env, type_name: scrut_type_name)
        let matching = ind_fields |> filter(f => f.variant_name == variant_name && f.field_name == field_name) |> first
        match matching {
          Present { value: ind_field } => compose_sub_value(base: scrutinee_provenance, field: ind_field)
          Absent => SubValueUnknown
        }
      }
  }
}

fn extend_scope_with_pattern_node(scope: InferScope, pattern: MatchPattern, scrutinee_subject: PatternSubject, scrutinee_provenance: SubValueRelation) -> PatternScopeResult {
  match pattern {
    Bind { declaration: declaration } => PatternScopeResult { scope: extend_scope_match_bound(scope: scope, name: declaration.name, resolved: pattern_binding_type(subject: scrutinee_subject), provenance: scrutinee_provenance), diagnostics: [] }
    Wildcard => PatternScopeResult { scope: scope, diagnostics: [] }
    LitPattern { value: _ } => PatternScopeResult { scope: scope, diagnostics: [] }
    VariantPattern { name: vname, parent_enum: _, field_bindings: bindings } =>
      let resolved_scrut = resolve_pattern_subject(scope: scope, scrutinee_subject: scrutinee_subject)
      let variant_lookup = lookup_variant_in_type(scrut: resolved_scrut, variant_name: vname, module_name: scope.module_name, env: scope.type_env, field_binding_count: bindings |> count)
      let variant_subject = lookup_result_subject(result: variant_lookup)
      let variant_diags = variant_lookup.diagnostics
      fold(bindings, init: PatternScopeResult { scope: scope, diagnostics: variant_diags }, f: (acc, fb) =>
        let field_name = field_binding_name_at(n: fb, source_indices: scope.type_env.source_indices)
        let field_lookup = lookup_field_in_variant(variant: variant_subject, field_name: field_name, module_name: scope.module_name, source_indices: scope.type_env.source_indices)
        let field_subject = lookup_result_subject(result: field_lookup)
        let field_type = pattern_binding_type(subject: field_subject)
        let field_provenance = derive_field_provenance(scope: scope, scrutinee_provenance: scrutinee_provenance, scrutinee_subject: scrutinee_subject, variant_name: vname, field_name: field_name)
        let fb_pattern = field_binding_pattern(n: fb)
        match fb_pattern {
          Bind { declaration: declaration } => PatternScopeResult {
            scope: extend_scope_match_bound(scope: acc.scope, name: declaration.name, resolved: field_type, provenance: field_provenance),
            diagnostics: concat(acc.diagnostics, field_lookup.diagnostics)
          }
          _ =>
            let nested = extend_scope_with_pattern_node(scope: acc.scope, pattern: fb_pattern, scrutinee_subject: field_subject, scrutinee_provenance: field_provenance)
            PatternScopeResult {
              scope: nested.scope,
              diagnostics: concat(acc.diagnostics, concat(field_lookup.diagnostics, nested.diagnostics))
            }
        }
      )
  }
}

fn method_name_is(opt: String?, expected: String) -> Bool {
  if opt == none { false } else { opt.value == expected }
}

fn arg_has_name(arg: Node, name: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  let n = arg_name_at(n: arg, source_indices: source_indices)
  if n == none { false } else { n.value == name }
}

fn extract_fold_init_info(method_name: String?, method_args: List<Node>, min_args: Int, scope: InferScope, expected: Node?) -> ArgInferResult? {
  let is_fold = method_name_is(opt: method_name, expected: "fold")
  if is_fold && method_args |> count >= min_args {
    let init_arg = match method_args |> filter(a => arg_has_name(arg: a, name: "init", source_indices: scope.type_env.source_indices)) |> first {
      Present { value: a } => Present { value: a }
      Absent => method_args |> first
    }
    match init_arg {
      Present { value: ia } =>
        let init_result = infer_expr(texpr: arg_value(n: ia), scope: scope, expected: expected)
        Present { value: ArgInferResult { typed_arg: make_arg_node(name: arg_name_at(n: ia, source_indices: scope.type_env.source_indices), value: init_result.typed, span: ia.span, name_span: ia.span), diagnostics: init_result.diagnostics } }
      Absent => none
    }
  } else { none }
}

fn derive_element_provenance(coll_expr: Node, elem_type: Node, scope: InferScope) -> SubValueRelation {
  let coll_prov = classify_binding_provenance(val: coll_expr, scope: scope)
  match coll_prov {
    SubValueUnknown => SubValueUnknown
    _ =>
      if authored_name_at(source_indices: scope.type_env.source_indices, node: elem_type) == "" { SubValueUnknown }
      else {
        let ind_fields = inductive_fields_for(env: scope.type_env, type_name: authored_name_at(source_indices: scope.type_env.source_indices, node: elem_type))
        let list_field = ind_fields |> filter(f => match f.shape { ListRecursion => true, _ => false }) |> first
        match list_field {
          Present { value: f } => IteratedSubValue { field: f }
          Absent => SubValueUnknown
        }
      }
  }
}

fn infer_method_args_with_fold(method_name: String?, method_args: List<Node>, fold_info: ArgInferResult?, fold_acc_type: Node, element_type: Node, elem_provenance: SubValueRelation, arg_contract: DeclaredArgContract, scope: InferScope) -> List<ArgInferResult> {
  let is_fold = method_name_is(opt: method_name, expected: "fold")
  method_args |> enumerate |> map(idx_pair =>
    let a = idx_pair.second
    let idx = idx_pair.first
    let is_init_arg = arg_has_name(arg: a, name: "init", source_indices: scope.type_env.source_indices) || (arg_name_at(n: a, source_indices: scope.type_env.source_indices) == none && idx == 0)
    if is_fold && fold_info != none && is_init_arg {
      match fold_info {
        Present { value: fi } => fi
        Absent => infer_arg_with_element_type(arg: a, element_type: element_type, scope: scope)
      }
    } else if is_fold && fold_info != none {
      let fold_params = [
        make_param_node(name: "acc", type_expr: fold_acc_type, default_value: none, span: no_span(), name_span: no_span()),
        make_param_node(name: "elem", type_expr: element_type, default_value: none, span: no_span(), name_span: no_span())
      ]
      let fold_callable = Node {
        name: "", span: no_span(), ident_span: none, children: [],
        connective: NoConnective, params: fold_params, inferred: none,
        return_cardinality: Required, uses: [], body: none, transport: none,
        properties: [], type_annotation: none, is_self_recursive: false,
        has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
      }
      let lam_value = arg_value(n: a)
      let prov_map = match elem_provenance {
        SubValueUnknown => empty_map()
        _ => map_insert(empty_map(), "elem", elem_provenance)
      }
      let fold_scope = InferScope {
        type_env: scope.type_env,
        func_env: scope.func_env,
        locals: scope.locals,
        body_locals: scope.body_locals,
        match_bound_names: scope.match_bound_names,
        module_name: scope.module_name,
        service_registry: scope.service_registry,
        item_registry: scope.item_registry,
        caller_decl_name: scope.caller_decl_name,
        lambda_param_provenance: prov_map
      }
      let ar = infer_expr(texpr: lam_value, scope: fold_scope, expected: Present { value: fold_callable })
      ArgInferResult { typed_arg: make_arg_node(name: arg_name_at(n: a, source_indices: scope.type_env.source_indices), value: ar.typed, span: a.span, name_span: a.span), diagnostics: ar.diagnostics }
    } else {
      let nf_lam_value = arg_value(n: a)
      let nf_prov_map = match elem_provenance {
        SubValueUnknown => empty_map()
        _ => map_insert(empty_map(), "elem", elem_provenance)
      }
      let nf_scope = if is_lambda_expr(e: nf_lam_value) {
        InferScope {
          type_env: scope.type_env,
          func_env: scope.func_env,
          locals: scope.locals,
          body_locals: scope.body_locals,
          match_bound_names: scope.match_bound_names,
          module_name: scope.module_name,
          service_registry: scope.service_registry,
          item_registry: scope.item_registry,
          caller_decl_name: scope.caller_decl_name,
          lambda_param_provenance: nf_prov_map
        }
      } else { scope }
      match arg_contract {
        MethodUnresolved => infer_arg_with_element_type(arg: a, element_type: element_type, scope: nf_scope)
        ContractUnavailable =>
          let ar = infer_expr(texpr: nf_lam_value, scope: nf_scope, expected: none)
          let contract_diag = categorized_error(message: "no declared argument contract is available for this method call; refusing rather than substituting the receiver element type", span: a.span, module_name: nf_scope.module_name, category: "method-arg-contract-unavailable")
          ArgInferResult { typed_arg: make_arg_node(name: arg_name_at(n: a, source_indices: nf_scope.type_env.source_indices), value: ar.typed, span: a.span, name_span: a.span), diagnostics: concat(ar.diagnostics, [contract_diag]) }
        ContractKnown { types: declared_types } =>
          match declared_types |> skip(idx) |> first {
            Present { value: declared_type } => infer_arg_with_element_type(arg: a, element_type: declared_type, scope: nf_scope)
            Absent =>
              let ar = infer_expr(texpr: nf_lam_value, scope: nf_scope, expected: none)
              let contract_diag = categorized_error(message: "no declared argument contract is available at this parameter position; refusing rather than substituting the receiver element type", span: a.span, module_name: nf_scope.module_name, category: "method-arg-contract-unavailable")
              ArgInferResult { typed_arg: make_arg_node(name: arg_name_at(n: a, source_indices: nf_scope.type_env.source_indices), value: ar.typed, span: a.span, name_span: a.span), diagnostics: concat(ar.diagnostics, [contract_diag]) }
          }
      }
    }
  )
}

fn is_lambda_expr(e: Node) -> Bool {
  match e.expr_data {
    ExprLambda => true
    _ => false
  }
}

fn seed_override_map() -> Map<String, Node> {
  fold([""], init: empty_map(), f: (acc, k) => map_insert(acc, k, unit_type))
}

fn fold_override_map(key: String, value: Node) -> Map<String, Node> {
  map_insert(seed_override_map(), key, value)
}

fn empty_override_map() -> Map<String, Node> {
  seed_override_map()
}

fn infer_arg_with_element_type(arg: Node, element_type: Node, scope: InferScope) -> ArgInferResult {
  let ar = infer_expr(texpr: arg_value(n: arg), scope: scope, expected: Present { value: element_type })
  ArgInferResult { typed_arg: make_arg_node(name: arg_name_at(n: arg, source_indices: scope.type_env.source_indices), value: ar.typed, span: arg.span, name_span: arg.span), diagnostics: ar.diagnostics }
}

fn binding_is_namespace_root_nominal(binding: TypeBinding) -> Bool {
  binding.resolved.name == binding.name
    && binding.resolved.connective == NoConnective
    && (binding.resolved.children |> count) == 0
}

fn spine_root_is_shadowed(scope: InferScope, root: String) -> Bool {
  match map_get(scope.locals, root) {
    Present { value: root_binding } => !binding_is_namespace_root_nominal(binding: root_binding)
    Absent => false
  }
}

fn qualified_value_projection(texpr: Node, scope: InferScope, span: SourceSpan) -> InferResult? {
  match field_access_spine(texpr: texpr, source_indices: scope.type_env.source_indices) {
    Absent => none
    Present { value: spine } =>
      match spine_root_is_shadowed(scope: scope, root: spine.root) {
        true => none
        false =>
          match symbol_index_lookup(index: scope.type_env.symbol_index, qualified_name: spine.dotted) {
            Absent => none
            Present { value: decl } =>
              let raw_value_type = match decl.inferred {
                Present { value: Resolved { node: rt } } => rt
                _ => match decl.type_annotation {
                  Present { value: ann } => ann
                  Absent => decl
                }
              }
              let value_type = qualify_borrowed_type_names(
                n: raw_value_type,
                owner_module_path: qualified_all_but_last(name: spine.dotted),
                env: scope.type_env,
                excluded: empty_map()
              )
              Present { value: ok_infer(texpr: make_named_expr_node(
                name: spine.dotted,
                expr_data: ExprVar { binding_kind: Present { value: FunctionValueBinding } },
                children: [],
                inferred: Present { value: Resolved { node: value_type } },
                span: span,
                name_span: kernel_span(name: spine.dotted)
              )) }
          }
      }
  }
}

fn infer_expr_body(texpr: Node, scope: InferScope, expected: Node?) -> InferResult {
  match texpr.expr_data {
    ExprLiteral { value: lit } =>
      let span = texpr.span
      ok_infer(texpr: make_expr_node(expr_data: ExprLiteral { value: lit }, children: [], inferred: Present { value: Resolved { node: infer_literal_node(lit: lit) } }, span: span))

    ExprError { kind: kind, message: message } =>
      let span = texpr.span
      let diagnostics = match kind {
        CensusHeadsBodyStripped =>
          [inference_error(message: message, span: span, module_name: scope.module_name)]
        _ => []
      }
      InferResult {
        typed: make_expr_error_node(kind: kind, message: message, span: span),
        diagnostics: diagnostics
      }

    ExprVar { binding_kind: _ } =>
      let name = expr_var_name_at(texpr: texpr, source_indices: scope.type_env.source_indices)
      let span = texpr.span
      match constructor_reference_admission_unshadowed(callee_name: name, span: span, scope: scope) {
        Present { value: refusal } => refusal
        Absent =>
      match map_get(scope.locals, name) {
        Present { value: binding } =>
          let scope_parent = lookup_variant_parent_enum(scope: scope, name: name)
          match scope_parent {
            Present { value: scope_enum } =>
              ok_infer(texpr: make_named_expr_node(
                name: name,
                expr_data: ExprVar { binding_kind: Present { value: VariantValueBinding { parent_enum: scope_enum } } },
                children: [],
                inferred: Present { value: Resolved { node: variant_reference_inferred_node(expected: expected, name: name, owner_name: scope_enum, scope: scope, fallback: binding.resolved) } },
                span: span,
                name_span: span
              ))
            Absent =>
              let binding_kind = infer_var_binding_kind(scope: scope, name: name)
              ok_infer(texpr: make_named_expr_node(
                name: name,
                expr_data: ExprVar { binding_kind: Present { value: binding_kind } },
                children: [],
                inferred: Present { value: Resolved { node: binding.resolved } },
                span: span,
                name_span: span
              ))
          }
        Absent =>
          match lookup_func_sig(func_env: scope.func_env, type_env: scope.type_env, name: name) {
            FuncSigResolved { sig: fsig } =>
                  match (fsig.params |> count) == 0 {
                    true =>
                      ok_infer(texpr: make_named_expr_node(
                        name: name,
                        expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                        children: [],
                        inferred: Present { value: Resolved { node: fsig.inferred } },
                        span: span,
                        name_span: span
                      ))
                    false =>
                      ok_infer(texpr: make_named_expr_node(
                        name: name,
                        expr_data: ExprVar { binding_kind: Present { value: FunctionValueBinding } },
                        children: [],
                        inferred: Present { value: Resolved { node: resolved_callable_type(func_params: fsig.params, ret: fsig.inferred) } },
                        span: span,
                        name_span: span
                      ))
                  }
            FuncSigAmbiguous { candidates: ambiguous_fn_candidates } =>
              ambiguous_reference_refusal(name: name, candidates: ambiguous_fn_candidates, span: span, scope: scope)
            FuncSigUnresolved =>
              match lookup_binding_by_name(env: scope.type_env, name: name) {
                Present { value: gbinding } =>
                  let scope_parent = lookup_variant_parent_enum(scope: scope, name: name)
                  match scope_parent {
                    Present { value: scope_enum } =>
                      ok_infer(texpr: make_named_expr_node(
                        name: name,
                        expr_data: ExprVar { binding_kind: Present { value: VariantValueBinding { parent_enum: scope_enum } } },
                        children: [],
                        inferred: Present { value: Resolved { node: variant_reference_inferred_node(expected: expected, name: name, owner_name: scope_enum, scope: scope, fallback: gbinding.resolved) } },
                        span: span,
                        name_span: span
                      ))
                    Absent =>
                      let binding_kind = infer_var_binding_kind(scope: scope, name: name)
                      ok_infer(texpr: make_named_expr_node(
                        name: name,
                        expr_data: ExprVar { binding_kind: Present { value: binding_kind } },
                        children: [],
                        inferred: Present { value: Resolved { node: gbinding.resolved } },
                        span: span,
                        name_span: span
                      ))
                  }
                Absent =>
                  let expected_variant_enum = expected_variant_owner_instantiation(expected: expected, name: name, scope: scope)
                  match expected_variant_enum {
                    Present { value: exp_enum } =>
                      ok_infer(texpr: make_named_expr_node(
                        name: name,
                        expr_data: ExprVar { binding_kind: Present { value: VariantValueBinding { parent_enum: authored_name_at(source_indices: scope.type_env.source_indices, node: exp_enum) } } },
                        children: [],
                        inferred: Present { value: Resolved { node: exp_enum } },
                        span: span,
                        name_span: span
                      ))
                    Absent =>
                      let var_ambiguity_cands = global_bare_strict_ambiguity_candidates(env: scope.type_env, name: name)
                      if (var_ambiguity_cands |> count) > 0 {
                        ambiguous_reference_refusal(name: name, candidates: var_ambiguity_cands, span: span, scope: scope)
                      } else {
                      let err_texpr = make_named_expr_node(
                        name: name,
                        expr_data: ExprVar { binding_kind: none },
                        children: [],
                        inferred: Present { value: Resolved { node: error_type } },
                        span: span,
                        name_span: span
                      )
                      InferResult {
                        typed: err_texpr,
                        diagnostics: [inference_error(
                          message: concat("undefined variable '", name, "'"),
                          span: span,
                          module_name: scope.module_name
                        )]
                      }
                      }
                  }
              }
          }
      }
      }

    ExprFieldAccess { summary: _ } =>
      let field_name = field_access_field_at(texpr: texpr, source_indices: scope.type_env.source_indices)
      let span = texpr.span
      let base_expr = field_access_base(texpr: texpr)
      match qualified_value_projection(texpr: texpr, scope: scope, span: span) {
        Present { value: proj } => proj
        Absent =>
      let base_result = infer_expr(texpr: base_expr, scope: scope, expected: none)
      let base_typed = base_result.typed
      let base_diags = base_result.diagnostics
      let base_rt = resolved_type(n: base_typed)
      let base_expansion = if is_deferred_field_access_base(n: base_rt, env: scope.type_env) {
        NodeResolveResult { resolved: base_rt, diagnostics: [] }
      } else {
        expand_type_for_field_access(n: base_rt, env: scope.type_env, module_name: scope.module_name)
      }
      let resolved_base = base_expansion.resolved
      let resolved_base_diags = base_expansion.diagnostics
      let resolved_base_is_error = if resolved_base.inferred != none { is_compiler_error(inferred: resolved_base.inferred.value) } else { false }
      if resolved_base_is_error {
        InferResult {
          typed: make_expr_error_node(kind: SemanticExprError, message: "error type cascade", span: span),
          diagnostics: concat(base_diags, resolved_base_diags)
        }
      } else {
      let field_type_lookup = lookup_field_type_node(n: resolved_base, field_name: field_name, source_indices: scope.type_env.source_indices)
      match field_type_lookup {
        Present { value: raw_field_type } =>

          let field_type = stamp_field_type_from_decl_params(field_type: raw_field_type, serving_decl: resolved_base, source_indices: scope.type_env.source_indices)
          let field_summary = match field_summary_for_type(base_type: base_rt, env: scope.type_env, field: field_name) {
            Present { value: s } => Present { value: s }
            Absent => field_summary_for_type(base_type: resolved_base, env: scope.type_env, field: field_name)
          }
          let fa_texpr = make_named_expr_node(
            name: field_name,
            expr_data: ExprFieldAccess { summary: field_summary },
            children: [base_typed],
            inferred: Present { value: Resolved { node: field_type } },
            span: span,
            name_span: node_name_span(n: texpr)
          )
          InferResult {
            typed: fa_texpr,
            diagnostics: concat(base_diags, resolved_base_diags)
          }
        Absent =>
          let base_is_type_var = is_deferred_field_access_base(n: resolved_base, env: scope.type_env)
          if base_is_type_var {
            let fa_texpr = make_named_expr_node(
              name: field_name,
              expr_data: ExprFieldAccess { summary: Present { value: FieldSummary { access_style: StoredField, value_shape: PlainValue } } },
              children: [base_typed],
              inferred: Present { value: TypeVariable { id: "field_of_type_var" } },
              span: span,
              name_span: node_name_span(n: texpr)
            )
            InferResult {
              typed: fa_texpr,
              diagnostics: concat(base_diags, resolved_base_diags)
            }
          } else {
            match check_service_field_access_node(base_type: base_rt, field: field_name, service_registry: scope.service_registry, source_indices: scope.type_env.source_indices) {
              Present { value: svc_type } =>
                let fa_texpr = make_named_expr_node(
                  name: field_name,
                  expr_data: ExprFieldAccess { summary: Present { value: FieldSummary { access_style: StoredField, value_shape: PlainValue } } },
                  children: [base_typed],
                  inferred: Present { value: Resolved { node: svc_type } },
                  span: span,
                  name_span: node_name_span(n: texpr)
                )
                InferResult {
                  typed: fa_texpr,
                  diagnostics: concat(base_diags, resolved_base_diags)
                }
              Absent =>
                let error_message = concat("no field '", field_name, "' on type '", authored_name_at(source_indices: scope.type_env.source_indices, node: resolved_base), "'")
                let fa_texpr = make_expr_error_node(kind: SemanticExprError, message: error_message, span: span)
                InferResult {
                  typed: fa_texpr,
                  diagnostics: concat(concat(base_diags, resolved_base_diags), [inference_error(
                    message: error_message,
                    span: span,
                    module_name: scope.module_name
                  )])
                }
            }
          }
      }
      }
      }

    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let func_name = expr_call_func_at(texpr: texpr, source_indices: scope.type_env.source_indices)
      let span = texpr.span
      let call_args = texpr.children

      let call_sig_lookup = body_shadow_aware_func_sig(scope: scope, func_name: func_name)
      match call_sig_lookup {
      FuncSigAmbiguous { candidates: ambiguous_fn_candidates } =>
        ambiguous_reference_refusal(name: func_name, candidates: ambiguous_fn_candidates, span: span, scope: scope)
      _ =>
      match constructor_reference_admission_unshadowed(callee_name: func_name, span: span, scope: scope) {
        Present { value: refusal } => refusal
        Absent =>
      let sig = func_sig_if_resolved(lookup: call_sig_lookup)
      let sig_params = match sig {
        Present { value: s } => s.params
        Absent => []
      }
      let call_sig_split = split_sig_params(params: sig_params, source_indices: scope.type_env.source_indices)
      let has_lambda = call_args |> any(a => is_lambda_expr(e: arg_value(n: a)))
      let call_method_args = call_args |> skip(1)
      let call_method_name = Present { value: func_name }
      let call_fold_info = extract_fold_init_info(method_name: call_method_name, method_args: call_method_args, min_args: 2, scope: scope, expected: expected)
      let call_fold_acc_type = match call_fold_info {
        Present { value: fi } => resolved_type(n: arg_value(n: fi.typed_arg))
        Absent => error_type
      }
      let arg_call = if has_lambda && call_args |> count >= 2 && sig == none {
        ArgGenericFoldState { subst: empty_map(), results: match call_args |> first {
          Present { value: first_arg } =>
            let first_result = infer_expr(texpr: arg_value(n: first_arg), scope: scope, expected: none)
            let first_type = resolved_type(n: first_result.typed)
            let elem_type = for_each_element_type_node(n: first_type, source_indices: scope.type_env.source_indices)
            let call_elem_provenance = derive_element_provenance(coll_expr: first_result.typed, elem_type: elem_type, scope: scope)
            let remaining_results = infer_method_args_with_fold(method_name: call_method_name, method_args: call_method_args, fold_info: call_fold_info, fold_acc_type: call_fold_acc_type, element_type: elem_type, elem_provenance: call_elem_provenance, arg_contract: MethodUnresolved, scope: scope)
            concat(
              [ArgInferResult { typed_arg: make_arg_node(name: arg_name_at(n: first_arg, source_indices: scope.type_env.source_indices), value: first_result.typed, span: first_arg.span, name_span: first_arg.span), diagnostics: first_result.diagnostics }],
              remaining_results
            )
          Absent =>
            []
        } }
      } else {

        let value_params = call_sig_split.value_params
        let generic_names = call_sig_split.generic_names
        let final_state = fold(call_args |> enumerate, init: ArgGenericFoldState { results: [], subst: empty_map() }, f: (st, pair) =>
          let a = pair.second
          let formal_lookup = value_params |> skip(pair.first) |> first
          let formal_raw = match formal_lookup {
            Present { value: p } => param_node_type_expr(n: p)
            Absent => type_variable_node(id: "callable_param")
          }
          let has_formal = match formal_lookup { Present { value: _ } => true  Absent => false }
          let formal_param_type = substitute_generics(n: formal_raw, subst: st.subst, source_indices: scope.type_env.source_indices)
          let expected = if has_formal { Present { value: formal_param_type } } else { none }
          let ar = infer_expr(texpr: arg_value(n: a), scope: scope, expected: expected)
          let next_subst = if is_lambda_expr(e: arg_value(n: a)) || !has_formal {
            st.subst
          } else if should_unify_record_lit_generics(formal: formal_raw, arg_expr: arg_value(n: a), generic_names: generic_names, source_indices: scope.type_env.source_indices) {
            unify_record_lit_generics(formal: formal_raw, record: ar.typed, generic_names: generic_names, scope: scope, acc: st.subst)
          } else {
            unify_generics(formal: formal_raw, actual: resolved_type(n: ar.typed), generic_names: generic_names, source_indices: scope.type_env.source_indices, acc: st.subst)
          }
          ArgGenericFoldState {
            results: concat(st.results, [ArgInferResult { typed_arg: make_arg_node(name: arg_name_at(n: a, source_indices: scope.type_env.source_indices), value: ar.typed, span: a.span, name_span: a.span), diagnostics: ar.diagnostics }]),
            subst: next_subst
          }
        )
        final_state
      }
      let arg_infer_results = arg_call.results

      let call_subst = arg_call.subst
      let typed_args = arg_infer_results |> map(air => air.typed_arg)
      let arg_diags = concat(
        flat_map(arg_infer_results, air => air.diagnostics),
        function_value_call_named_arg_diags(
          func_name: func_name,
          typed_args: typed_args,
          type_env: scope.type_env,
          module_name: scope.module_name,
          body_locals: scope.body_locals,
          locals: scope.locals
        )
      )
      let typed_arg_nodes = typed_args
      if sig != none {
        let resolved_type = match sig {
          Present { value: s } => substitute_generics(n: s.inferred, subst: call_subst, source_indices: scope.type_env.source_indices)
          Absent => error_type
        }
        let value_params_for_check = call_sig_split.value_params
        let arg_shape_diags = direct_call_shape_diags(
          func_name: func_name,
          sig_params: sig_params,
          typed_args: typed_args,
          type_env: scope.type_env,
          module_name: scope.module_name,
          call_span: span
        )
        let call_application_plan = build_call_application_plan(
          value_params: value_params_for_check,
          typed_args: typed_args,
          call_subst: call_subst,
          type_env: scope.type_env,
          module_name: scope.module_name
        )
        let arg_compat_diags = if module_skips_direct_call_arg_check(module_name: scope.module_name) { [] } else {
          direct_call_arg_mismatch_diags(
            plan: call_application_plan,
            type_env: scope.type_env,
            module_name: scope.module_name
          )
        }
        let structured_arg_diags = direct_call_structured_application_mismatch_diags(
          plan: call_application_plan,
          scope: scope
        )
        InferResult {
          typed: make_named_expr_node(
            name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
            children: typed_arg_nodes,
            inferred: Present { value: Resolved { node: resolved_type } },
            span: span,
            name_span: node_name_span(n: texpr)
          ),
          diagnostics: concat(arg_diags, concat(arg_shape_diags, concat(arg_compat_diags, structured_arg_diags)))
        }
      } else {
        let first_arg_type = match typed_args |> first {
          Present { value: ta } => resolved_type(n: arg_value(n: ta))
          Absent => unit_type
        }
        let method_receiver = match typed_args |> first {
          Present { value: ta } => arg_value(n: ta)
          Absent => internal_expr_error_node(message: "method bridge missing receiver", span: span)
        }
        let call_acc_is_under_resolved = !is_fully_resolved(n: call_fold_acc_type, source_indices: scope.type_env.source_indices)
        let refined_call_fold_acc_type = if call_fold_info != none && call_acc_is_under_resolved {
          match typed_args |> filter(a => is_lambda_expr(e: arg_value(n: a))) |> first {
            Present { value: lambda_arg } => resolved_type(n: arg_value(n: lambda_arg))
            Absent => call_fold_acc_type
          }
        } else { call_fold_acc_type }
        let method_resolution = if listed_import_required_bare_call_blocked(env: scope.type_env, name: func_name) {
          KnownMethodResolution { semantics: none, result_type: none, diagnostics: [] }
        } else {
          resolve_known_method_node(
            receiver: method_receiver,
            receiver_type: resolve_method_receiver_type(receiver_type: first_arg_type, env: scope.type_env),
            method_name: func_name,
            fold_accumulator_type: if call_fold_info != none { Present { value: refined_call_fold_acc_type } } else { none },
            service_registry: scope.service_registry,
            source_indices: scope.type_env.source_indices
          )
        }
        let callee_is_body_binding = map_has(scope.body_locals, func_name)
        let is_known_method = !callee_is_body_binding && method_resolution.result_type != none
        if is_known_method && typed_args |> count > 0 {
          let receiver = method_receiver
          let remaining = typed_args |> skip(1)
          let base_result_type = match method_resolution.result_type {
            Present { value: mt } => mt
            Absent => error_type
          }
          let method_tv = if method_resolution.semantics == none {
            KernelTypeBuild { ty: base_result_type, diagnostics: [] }
          } else {
            match method_resolution.semantics.value {
              AlgebraMethodSemantics { method_def: _, fold_accumulator_type: _, size_effect: _, cost_shape: _, algebra_template: at } =>
                match at {
                  Present { value: t } =>
                    if template_return_has_variables(template: t) || !is_fully_resolved(n: base_result_type, source_indices: scope.type_env.source_indices) {
                      let call_arg_types = remaining |> map(a => resolved_type(n: arg_value(n: a)))
                      let fold_overrides = if call_fold_info != none { fold_override_map(key: "FoldAccumulator", value: refined_call_fold_acc_type) } else { empty_override_map() }
                      resolve_type_variables_from_template(template: t, arg_types: call_arg_types, receiver_type: first_arg_type, overrides: fold_overrides, source_indices: scope.type_env.source_indices)
                    } else {
                      KernelTypeBuild { ty: base_result_type, diagnostics: [] }
                    }
                  Absent => KernelTypeBuild { ty: base_result_type, diagnostics: [] }
                }
              _ => KernelTypeBuild { ty: base_result_type, diagnostics: [] }
            }
          }
          let bridge_result_type = method_tv.ty
          let template_subst_diags = method_tv.diagnostics
          let returns_receiver_self = if method_resolution.semantics == none { false } else {
            match method_resolution.semantics.value {
              AlgebraMethodSemantics { method_def: _, fold_accumulator_type: _, size_effect: _, cost_shape: _, algebra_template: at } =>
                match at {
                  Present { value: t } => template_return_is_receiver_self(template: t)
                  Absent => false
                }
              _ => false
            }
          }
          let final_receiver = if returns_receiver_self && is_fully_resolved(n: bridge_result_type, source_indices: scope.type_env.source_indices) && !is_fully_resolved(n: first_arg_type, source_indices: scope.type_env.source_indices) {
            Node {
              name: receiver.name, span: receiver.span, ident_span: receiver.ident_span,
              children: bridge_result_type.children,
              connective: receiver.connective, params: receiver.params,
              inferred: Present { value: Resolved { node: bridge_result_type } },
              return_cardinality: receiver.return_cardinality, uses: receiver.uses,
              body: receiver.body, transport: receiver.transport,
              properties: receiver.properties, type_annotation: receiver.type_annotation,
              is_self_recursive: receiver.is_self_recursive, has_non_tail_self_call: receiver.has_non_tail_self_call,
              match_pattern: receiver.match_pattern, expr_data: receiver.expr_data
            }
          } else { receiver }
          let remaining_arg_nodes = remaining |> map(ta => make_arg_node(name: arg_name_at(n: ta, source_indices: scope.type_env.source_indices), value: arg_value(n: ta), span: span, name_span: span))
          InferResult {
            typed: make_named_expr_node(
              name: func_name, expr_data: ExprMethodCall { method_semantics: method_resolution.semantics },
              children: concat([final_receiver], remaining_arg_nodes),
              inferred: Present { value: Resolved { node: bridge_result_type } },
              span: span,
              name_span: node_name_span(n: texpr)
            ),
            diagnostics: concat(concat(arg_diags, method_resolution.diagnostics), template_subst_diags)
          }
        } else if !callee_is_body_binding && func_name == "empty_map" {
          let bare_m = bare_map_node()
          match expected {
            Present { value: exp } =>
              if node_is_keyed_collection(n: exp, source_indices: scope.type_env.source_indices) {
                InferResult {
                  typed: make_named_expr_node(
                    name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                    children: typed_arg_nodes,
                    inferred: Present { value: Resolved { node: exp } },
                    span: span,
                    name_span: node_name_span(n: texpr)
                  ),
                  diagnostics: arg_diags
                }
              } else {
                let empty_map_diags = concat(arg_diags, [inference_error(message: "empty_map(): expected type is not a keyed collection", span: span, module_name: scope.module_name)])
                match bare_m {
                  Present { value: map_t } =>
                    InferResult {
                      typed: make_named_expr_node(
                        name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                        children: typed_arg_nodes,
                        inferred: Present { value: Resolved { node: map_t } },
                        span: span,
                        name_span: node_name_span(n: texpr)
                      ),
                      diagnostics: empty_map_diags
                    }
                  Absent =>
                    InferResult {
                      typed: make_named_expr_node(
                        name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                        children: typed_arg_nodes,
                        inferred: Present { value: CompilerError { message: "empty_map(): Map kernel container profile missing (compiler misconfigured)", span: span } },
                        span: span,
                        name_span: node_name_span(n: texpr)
                      ),
                      diagnostics: concat(empty_map_diags, [inference_error(message: "empty_map(): Map kernel container profile missing", span: span, module_name: scope.module_name)])
                    }
                }
              }
            Absent =>
              match bare_m {
                Present { value: map_t } =>
                  InferResult {
                    typed: make_named_expr_node(
                      name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                      children: typed_arg_nodes,
                      inferred: Present { value: Resolved { node: map_t } },
                      span: span,
                      name_span: node_name_span(n: texpr)
                    ),
                    diagnostics: arg_diags
                  }
                Absent =>
                  InferResult {
                    typed: make_named_expr_node(
                      name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                      children: typed_arg_nodes,
                      inferred: Present { value: CompilerError { message: "empty_map(): Map kernel container profile missing (compiler misconfigured)", span: span } },
                      span: span,
                      name_span: node_name_span(n: texpr)
                    ),
                    diagnostics: concat(arg_diags, [inference_error(message: "empty_map(): Map kernel container profile missing", span: span, module_name: scope.module_name)])
                  }
              }
          }
        } else if !callee_is_body_binding && func_name == "empty_set" {
          let bare_s = bare_set_node()
          match expected {
            Present { value: exp } =>
              if node_is_set_collection(n: exp, source_indices: scope.type_env.source_indices) {
                InferResult {
                  typed: make_named_expr_node(
                    name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                    children: typed_arg_nodes,
                    inferred: Present { value: Resolved { node: exp } },
                    span: span,
                    name_span: node_name_span(n: texpr)
                  ),
                  diagnostics: arg_diags
                }
              } else {
                let empty_set_diags = concat(arg_diags, [inference_error(message: "empty_set(): expected type is not Set<...>", span: span, module_name: scope.module_name)])
                match bare_s {
                  Present { value: set_t } =>
                    InferResult {
                      typed: make_named_expr_node(
                        name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                        children: typed_arg_nodes,
                        inferred: Present { value: Resolved { node: set_t } },
                        span: span,
                        name_span: node_name_span(n: texpr)
                      ),
                      diagnostics: empty_set_diags
                    }
                  Absent =>
                    InferResult {
                      typed: make_named_expr_node(
                        name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                        children: typed_arg_nodes,
                        inferred: Present { value: CompilerError { message: "empty_set(): Set kernel container profile missing (compiler misconfigured)", span: span } },
                        span: span,
                        name_span: node_name_span(n: texpr)
                      ),
                      diagnostics: concat(empty_set_diags, [inference_error(message: "empty_set(): Set kernel container profile missing", span: span, module_name: scope.module_name)])
                    }
                }
              }
            Absent =>
              match bare_s {
                Present { value: set_t } =>
                  InferResult {
                    typed: make_named_expr_node(
                      name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                      children: typed_arg_nodes,
                      inferred: Present { value: Resolved { node: set_t } },
                      span: span,
                      name_span: node_name_span(n: texpr)
                    ),
                    diagnostics: arg_diags
                  }
                Absent =>
                  InferResult {
                    typed: make_named_expr_node(
                      name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                      children: typed_arg_nodes,
                      inferred: Present { value: CompilerError { message: "empty_set(): Set kernel container profile missing (compiler misconfigured)", span: span } },
                      span: span,
                      name_span: node_name_span(n: texpr)
                    ),
                    diagnostics: concat(arg_diags, [inference_error(message: "empty_set(): Set kernel container profile missing", span: span, module_name: scope.module_name)])
                  }
              }
          }
        } else if !callee_is_body_binding && infer_builtin_call_type(name: func_name) != none {
          let tier2b = infer_tier2b_builtin_with_kernel_diags(func_name: func_name, typed_args: typed_args, scope: scope, span: span)
          let bt = tier2b.bt
          let call_semantics = if func_name == "lookup" {
            Present { value: LookupCallSemantics }
          } else {
            Present { value: PlainCallSemantics }
          }
          InferResult {
            typed: make_named_expr_node(
              name: func_name, expr_data: ExprCall { call_semantics: call_semantics, descent_evidence: none },
              children: typed_arg_nodes,
              inferred: Present { value: Resolved { node: bt } },
              span: span,
              name_span: node_name_span(n: texpr)
            ),
            diagnostics: concat(arg_diags, tier2b.kernel_diags)
          }
        } else {
          let callable_local = match map_get(scope.locals, func_name) {
            Present { value: binding } =>
              if binding.resolved.params |> count > 0 { Present { value: binding.resolved } }
              else { none }
            Absent => none
          }
          if callable_local != none {
            let callable_type = match callable_local {
              Present { value: ct } => ct
              Absent => error_type
            }
            let resolved_type = match callable_type.inferred {
              Present { value: Resolved { node: ret } } => ret
              _ => error_type
            }
            InferResult {
              typed: make_named_expr_node(
                name: func_name, expr_data: ExprCall { call_semantics: Present { value: if callee_is_body_binding { FunctionValueCallSemantics } else { PlainCallSemantics } }, descent_evidence: none },
                children: typed_arg_nodes,
                inferred: Present { value: Resolved { node: resolved_type } },
                span: span,
                name_span: node_name_span(n: texpr)
              ),
              diagnostics: arg_diags
            }
          } else {
          match infer_variant_constructor_call(func_name: func_name, call_args: call_args, span: span, name_span: node_name_span(n: texpr), scope: scope) {
            Present { value: ctor_result } => ctor_result
            Absent =>
              let type_match = lookup_type_by_name(env: scope.type_env, name: func_name)
              let global_bare_callable = match type_match {
                Present { value: _ } => none
                Absent => global_bare_callable_node(type_env: scope.type_env, name: func_name)
              }
              let resolved_type = match type_match {
                Present { value: tn } => tn
                Absent => match global_bare_callable {
                  Present { value: gnode } =>
                    if (gnode.params |> count) > 0 { borrowed_callable_call_type(gnode: gnode, typed_args: typed_arg_nodes, scope: scope) }
                    else { callable_return_type(n: gnode) }
                  Absent => error_type
                }
              }
              let call_diags = match type_match {
                Present { value: _ } => []
                Absent => match global_bare_callable {
                  Present { value: _ } => []
                  Absent =>
                    let call_ambiguity_cands = global_bare_strict_ambiguity_candidates(env: scope.type_env, name: func_name)
                    if (call_ambiguity_cands |> count) > 0 {
                      [make_error_node(diagnostic: AmbiguousReference { name: func_name, candidates: call_ambiguity_cands, span: span }, module_name: scope.module_name)]
                    } else {
                      [inference_error(
                        message: concat("function '", func_name, "' not found in scope"),
                        span: span,
                        module_name: scope.module_name
                      )]
                    }
                }
              }
              InferResult {
                typed: make_named_expr_node(
                  name: func_name, expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                  children: typed_arg_nodes,
                  inferred: Present { value: Resolved { node: resolved_type } },
                  span: span,
                  name_span: node_name_span(n: texpr)
                ),
                diagnostics: concat(arg_diags, call_diags)
              }
          }
        }
        }
      }
      }
      }

    ExprMethodCall { method_semantics: _ } =>
      let method_name = expr_method_name_at(texpr: texpr, source_indices: scope.type_env.source_indices)
      let span = texpr.span
      let recv = method_receiver(texpr: texpr)
      let mc_args = method_arg_nodes(texpr: texpr)
      let qualified_direct_call = match field_access_spine(texpr: recv, source_indices: scope.type_env.source_indices) {
        Absent => none
        Present { value: recv_spine } =>
          match spine_root_is_shadowed(scope: scope, root: recv_spine.root) {
            true => none
            false =>
              let dotted = concat(recv_spine.dotted, ".", method_name)
              match symbol_index_lookup(index: scope.type_env.symbol_index, qualified_name: dotted) {
                Absent => none
                Present { value: _ } =>
                  Present { value: infer_expr(
                    texpr: make_named_expr_node(
                      name: dotted,
                      expr_data: ExprCall { call_semantics: Present { value: PlainCallSemantics }, descent_evidence: none },
                      children: mc_args,
                      inferred: none,
                      span: span,
                      name_span: kernel_span(name: dotted)
                    ),
                    scope: scope,
                    expected: expected
                  ) }
              }
          }
      }
      match qualified_direct_call {
        Present { value: qdc } => qdc
        Absent =>
      let recv_result = infer_expr(texpr: recv, scope: scope, expected: none)
      let recv_typed = recv_result.typed
      let recv_diags = recv_result.diagnostics
      let recv_rt = resolve_method_receiver_type(receiver_type: resolved_type(n: recv_typed), env: scope.type_env)
      let recv_elem_type = for_each_element_type_node(n: recv_rt, source_indices: scope.type_env.source_indices)
      let mc_method_name = Present { value: method_name }
      let fold_info = extract_fold_init_info(method_name: mc_method_name, method_args: mc_args, min_args: 2, scope: scope, expected: expected)
      let fold_acc_type = match fold_info {
        Present { value: fi } => resolved_type(n: arg_value(n: fi.typed_arg))
        Absent => error_type
      }
      let mc_elem_provenance = derive_element_provenance(coll_expr: recv_typed, elem_type: recv_elem_type, scope: scope)
      let mc_arg_contract = declared_arg_types_for_method(receiver_type: recv_rt, method_name: method_name, source_indices: scope.type_env.source_indices, expand_field_type: n => expand_type_for_field_access(n: n, env: scope.type_env, module_name: scope.module_name).resolved)
      let mc_arg_infer_results = infer_method_args_with_fold(method_name: mc_method_name, method_args: mc_args, fold_info: fold_info, fold_acc_type: fold_acc_type, element_type: recv_elem_type, elem_provenance: mc_elem_provenance, arg_contract: mc_arg_contract, scope: scope)
      let typed_mc_args = mc_arg_infer_results |> map(air => air.typed_arg)
      let mc_arg_diags = flat_map(mc_arg_infer_results, air => air.diagnostics)
      let mc_acc_is_under_resolved = !is_fully_resolved(n: fold_acc_type, source_indices: scope.type_env.source_indices)
      let refined_fold_acc_type = if fold_info != none && mc_acc_is_under_resolved {
        match typed_mc_args |> filter(a => is_lambda_expr(e: arg_value(n: a))) |> first {
          Present { value: lambda_arg } => resolved_type(n: arg_value(n: lambda_arg))
          Absent => fold_acc_type
        }
      } else { fold_acc_type }
      let method_resolution = resolve_known_method_node(
        receiver: recv_typed,
        receiver_type: recv_rt,
        method_name: method_name,
        fold_accumulator_type: if fold_info != none { Present { value: refined_fold_acc_type } } else { none },
        service_registry: scope.service_registry,
        source_indices: scope.type_env.source_indices
      )
      let pipe_fb = match method_resolution.result_type {
        Present { value: rt } => MethodPipeFallback { result_ty: rt, kernel_diags: [] }
        Absent =>
          method_pipe_map_keys_values_fallback(recv_rt: recv_rt, method_name: method_name, scope: scope, span: span)
      }
      let base_result_type = pipe_fb.result_ty
      let method_tv_mc = if method_resolution.semantics == none {
        KernelTypeBuild { ty: base_result_type, diagnostics: [] }
      } else {
        match method_resolution.semantics.value {
          AlgebraMethodSemantics { method_def: _, fold_accumulator_type: _, size_effect: _, cost_shape: _, algebra_template: at } =>
            match at {
              Present { value: t } =>
                if template_return_has_variables(template: t) || !is_fully_resolved(n: base_result_type, source_indices: scope.type_env.source_indices) {
                  let mc_arg_types = typed_mc_args |> map(a => resolved_type(n: arg_value(n: a)))
                  let mc_fold_overrides = if fold_info != none { fold_override_map(key: "FoldAccumulator", value: refined_fold_acc_type) } else { empty_override_map() }
                  resolve_type_variables_from_template(template: t, arg_types: mc_arg_types, receiver_type: recv_rt, overrides: mc_fold_overrides, source_indices: scope.type_env.source_indices)
                } else {
                  KernelTypeBuild { ty: base_result_type, diagnostics: [] }
                }
              Absent => KernelTypeBuild { ty: base_result_type, diagnostics: [] }
            }
          _ => KernelTypeBuild { ty: base_result_type, diagnostics: [] }
        }
      }
      let result_type = method_tv_mc.ty
      let mc_template_diags = method_tv_mc.diagnostics
      let method_semantics = if method_resolution.semantics != none { method_resolution.semantics } else { Present { value: PlainMethodSemantics } }
      let typed_mc_arg_nodes = typed_mc_args
      let mc_texpr = make_named_expr_node(
        name: method_name, expr_data: ExprMethodCall { method_semantics: method_semantics },
        children: concat([recv_typed], typed_mc_arg_nodes),
        inferred: Present { value: Resolved { node: result_type } },
        span: span,
        name_span: node_name_span(n: texpr)
      )
      InferResult {
        typed: mc_texpr,
        diagnostics: concat(concat(concat(recv_diags, mc_arg_diags), pipe_fb.kernel_diags), concat(method_resolution.diagnostics, mc_template_diags))
      }
      }

    ExprMatch =>
      let span = texpr.span
      let scrut = match_scrutinee(texpr: texpr)
      let arm_nodes = match_arm_nodes(texpr: texpr)
      let scrut_result = infer_expr(texpr: scrut, scope: scope, expected: none)
      let scrut_typed = scrut_result.typed
      let scrut_diags = scrut_result.diagnostics
      let scrut_rt = resolved_type(n: scrut_typed)
      let scrut_subject = pattern_subject_from_inferred(n: scrut_typed.inferred)
      let scrut_provenance = classify_binding_provenance(val: scrut, scope: scope)
      let arm_infer_results = arm_nodes |> map(arm_node =>
        let arm_pat = arm_pattern(n: arm_node)
        let arm_g = arm_guard(n: arm_node)
        let arm_b = arm_body(n: arm_node)
        let typed_pattern = annotate_pattern_parent_enums(pattern: arm_pat, scrutinee_subject: scrut_subject, scope: scope)
        let pattern_result = extend_scope_with_pattern_node(scope: scope, pattern: typed_pattern, scrutinee_subject: scrut_subject, scrutinee_provenance: scrut_provenance)
        let arm_scope = pattern_result.scope
        let pattern_diags = pattern_result.diagnostics
        let guard_result = if arm_g != none {
          Present { value: infer_expr(texpr: arm_g.value, scope: arm_scope, expected: none) }
        } else {
          none
        }
        let body_result = infer_expr(texpr: arm_b, scope: arm_scope, expected: expected)
        let body_typed = body_result.typed
        let body_diags = body_result.diagnostics
        let guard_unwrapped = match guard_result {
          Present { value: gr } => gr
          Absent => InferResult { typed: arm_b, diagnostics: [] }
        }
        let guard_diags = if guard_result != none { guard_unwrapped.diagnostics } else { [] }
        ArmInferResult {
          typed_arm: make_arm_node(
            pattern: typed_pattern,
            guard: if guard_result != none { Present { value: guard_unwrapped.typed } } else { none },
            body: body_typed,
            span: span
          ),
          diagnostics: concat(pattern_diags, concat(guard_diags, body_diags)),
          body_type: resolved_type(n: body_typed)
        }
      )
      let arm_body_types = arm_infer_results |> map(ar => ar.body_type)
      let unified_arm_type = match arm_body_types |> first {
        Present { value: first_type } =>
          arm_body_types |> skip(1) |> fold(init: first_type, f: (acc, t) =>
            prefer_specific_type(left: acc, right: t, source_indices: scope.type_env.source_indices)
          )
        Absent => scrut_rt
      }
      let arm_infer_results = if is_fully_resolved(n: unified_arm_type, source_indices: scope.type_env.source_indices) {
        arm_nodes |> enumerate |> map(pair =>
          let idx = pair.first
          let arm_node = pair.second
          let original_list = arm_infer_results |> enumerate |> filter(ap => ap.first == idx) |> map(ap => ap.second)
          let original = match original_list |> first {
            Present { value: ar } => ar
            Absent => ArmInferResult { typed_arm: arm_node, diagnostics: [], body_type: scrut_rt }
          }
          if !is_fully_resolved(n: original.body_type, source_indices: scope.type_env.source_indices) {
            let arm_pat = arm_pattern(n: arm_node)
            let arm_g = arm_guard(n: arm_node)
            let arm_b = arm_body(n: arm_node)
            let typed_pattern = annotate_pattern_parent_enums(pattern: arm_pat, scrutinee_subject: scrut_subject, scope: scope)
            let pattern_result = extend_scope_with_pattern_node(scope: scope, pattern: typed_pattern, scrutinee_subject: scrut_subject, scrutinee_provenance: scrut_provenance)
            let arm_scope = pattern_result.scope
            let pattern_diags = pattern_result.diagnostics
            let guard_result = if arm_g != none {
              Present { value: infer_expr(texpr: arm_g.value, scope: arm_scope, expected: none) }
            } else { none }
            let body_result = infer_expr(texpr: arm_b, scope: arm_scope, expected: Present { value: unified_arm_type })
            let body_typed = body_result.typed
            let body_diags = body_result.diagnostics
            let guard_unwrapped = match guard_result {
              Present { value: gr } => gr
              Absent => InferResult { typed: arm_b, diagnostics: [] }
            }
            let guard_diags = if guard_result != none { guard_unwrapped.diagnostics } else { [] }
            ArmInferResult {
              typed_arm: make_arm_node(
                pattern: typed_pattern,
                guard: if guard_result != none { Present { value: guard_unwrapped.typed } } else { none },
                body: body_typed,
                span: span
              ),
              diagnostics: concat(pattern_diags, concat(guard_diags, body_diags)),
              body_type: resolved_type(n: body_typed)
            }
          } else { original }
        )
      } else { arm_infer_results }
      let typed_arms = arm_infer_results |> map(ar => ar.typed_arm)
      let arm_diags = flat_map(arm_infer_results, ar => ar.diagnostics)
      let result_type = unified_arm_type
      let empty_arms_diags = if count(arm_infer_results) == 0 {
        [inference_error(
          message: "match expression has no arms",
          span: span,
          module_name: scope.module_name
        )]
      } else {
        []
      }
      let exhaustiveness_diags = match resolve_pattern_subject(scope: scope, scrutinee_subject: scrut_subject) {
        PatternResolved { node: resolved_scrutinee } =>
          check_match_exhaustiveness(
            scrutinee_type: resolved_scrutinee,
            arms: typed_arms,
            env: scope.type_env,
            span: span,
            module_name: scope.module_name
          )
        PatternDynamic { span: _ } => []
        PatternLookupBlocked => []
      }
      let match_texpr = make_expr_node(expr_data: ExprMatch, children: concat([scrut_typed], typed_arms), inferred: Present { value: Resolved { node: result_type } }, span: span)
      InferResult {
        typed: match_texpr,
        diagnostics: concat(scrut_diags, arm_diags, empty_arms_diags, exhaustiveness_diags)
      }

    ExprIf =>
      let span = texpr.span
      let cond = if_condition(texpr: texpr)
      let then_expr = if_then_branch(texpr: texpr)
      let else_expr = if_else_branch(texpr: texpr)
      let cond_result = infer_expr(texpr: cond, scope: scope, expected: none)
      let cond_typed = cond_result.typed
      let cond_diags = cond_result.diagnostics
      let then_result = infer_expr(texpr: then_expr, scope: scope, expected: expected)
      let then_typed = then_result.typed
      let then_diags = then_result.diagnostics
      match else_expr {
        Present { value: else_branch } =>
          let else_result = infer_expr(texpr: else_branch, scope: scope, expected: expected)
          let then_rt = resolved_type(n: then_result.typed)
          let else_rt = resolved_type(n: else_result.typed)
          let then_result = if !is_fully_resolved(n: then_rt, source_indices: scope.type_env.source_indices) && is_fully_resolved(n: else_rt, source_indices: scope.type_env.source_indices) {
            infer_expr(texpr: then_expr, scope: scope, expected: Present { value: else_rt })
          } else { then_result }
          let else_result = if !is_fully_resolved(n: else_rt, source_indices: scope.type_env.source_indices) && is_fully_resolved(n: then_rt, source_indices: scope.type_env.source_indices) {
            infer_expr(texpr: else_branch, scope: scope, expected: Present { value: then_rt })
          } else { else_result }
          let then_typed = then_result.typed
          let then_diags = then_result.diagnostics
          let else_typed = else_result.typed
          let else_diags = else_result.diagnostics
          let then_rt = resolved_type(n: then_typed)
          let else_rt = resolved_type(n: else_typed)
          let unified = prefer_specific_type(left: then_rt, right: else_rt, source_indices: scope.type_env.source_indices)
          let branch_diags = if node_type_compatible(
            left: then_rt,
            right: else_rt,
            source_indices: scope.type_env.source_indices
          ) {
            []
          } else {
            [inference_error(
              message: concat(
                "if branches resolve to incompatible types: ",
                node_type_shape(n: then_rt, source_indices: scope.type_env.source_indices),
                " vs ",
                node_type_shape(n: else_rt, source_indices: scope.type_env.source_indices)
              ),
              span: span,
              module_name: scope.module_name
            )]
          }
          let if_texpr = make_expr_node(expr_data: ExprIf, children: [cond_typed, then_typed, else_typed], inferred: Present { value: Resolved { node: unified } }, span: span)
          InferResult {
            typed: if_texpr,
            diagnostics: concat(cond_diags, then_diags, else_diags, branch_diags)
          }
        Absent =>
          let if_texpr2 = make_expr_node(expr_data: ExprIf, children: [cond_typed, then_typed], inferred: Present { value: Resolved { node: unit_type } }, span: span)
          InferResult {
            typed: if_texpr2,
            diagnostics: concat(cond_diags, then_diags)
          }
      }

    ExprLet =>
      let let_name = let_binding_name_at(texpr: texpr, source_indices: scope.type_env.source_indices)
      let span = texpr.span
      let val_expr = let_value(texpr: texpr)
      let body_expr = let_body(texpr: texpr)
      let is_tail_return = match body_expr {
        Present { value: bd } =>
          match bd.expr_data {
            ExprVar { binding_kind: _ } => authored_name_at(source_indices: scope.type_env.source_indices, node: bd) == let_name
            _ => false
          }
        Absent => false
      }
      let val_expected = if texpr.type_annotation != none && is_type_expr_annotation(n: texpr.type_annotation.value) {
        Present { value: texpr.type_annotation.value }
      } else if is_tail_return {
        expected
      } else {
        none
      }
      let val_result = infer_expr(texpr: val_expr, scope: scope, expected: val_expected)
      let val_typed = val_result.typed
      let val_diags = val_result.diagnostics
      let val_type = resolved_type(n: val_typed)
      if body_expr == none {
        let let_texpr = make_named_expr_node(name: let_name, expr_data: ExprLet, children: [val_typed], inferred: Present { value: Resolved { node: val_type } }, span: span, name_span: node_name_span(n: texpr))
        InferResult {
          typed: let_texpr,
          diagnostics: val_diags
        }
      } else {
        let extended = extend_scope(scope: scope, name: let_name, resolved: val_type, provenance: classify_binding_provenance(val: val_typed, scope: scope))
        let body_result = infer_expr(texpr: body_expr.value, scope: extended, expected: expected)
        let body_typed = body_result.typed
        let body_diags = body_result.diagnostics
        let let_texpr2 = make_named_expr_node(name: let_name, expr_data: ExprLet, children: [val_typed, body_typed], inferred: body_typed.inferred, span: span, name_span: node_name_span(n: texpr))
        InferResult {
          typed: let_texpr2,
          diagnostics: concat(val_diags, body_diags)
        }
      }

    ExprRecordLit { parent_enum: _ } =>
      let span = texpr.span
      let field_inits = texpr.children
      infer_record_lit(type_name: record_lit_type_name_at(texpr: texpr, source_indices: scope.type_env.source_indices), field_inits: field_inits, span: span, name_span: node_name_span(n: texpr), scope: scope, expected: expected)

    ExprListLit =>
      let span = texpr.span
      let elements = texpr.children
      let elem_expected = match expected {
        Present { value: exp } =>
          if node_is_element_collection(n: exp, source_indices: scope.type_env.source_indices) {
            match exp.children |> first { Present { value: elem } => Present { value: child_type_node(ch: elem) }  Absent => none }
          } else { none }
        Absent => none
      }
      let elem_results = elements |> map(e => infer_expr(texpr: e, scope: scope, expected: elem_expected))
      let typed_elements = elem_results |> map(r => r.typed)
      let elem_diags = flat_map(elem_results, r => r.diagnostics)
      let elem_type_node = if count(elem_results) > 0 {
        match first(elem_results) {
          Present { value: r } => resolved_type(n: r.typed)
          Absent => unit_type
        }
      } else {
        match expected {
          Present { value: exp } =>
            if node_is_element_collection(n: exp, source_indices: scope.type_env.source_indices) {
              match exp.children |> first {
                Present { value: elem } => child_type_node(ch: elem)
                Absent => unit_type
              }
            } else { unit_type }
          Absent => unit_type
        }
      }
      let empty_list_diags = if count(elem_results) == 0 {
        match expected {
          Present { value: exp } =>
            if node_is_element_collection(n: exp, source_indices: scope.type_env.source_indices) {
              match exp.children |> first {
                Present { value: _ } => []
                Absent => [inference_error(message: "empty list literal: expected type has no element type", span: span, module_name: scope.module_name)]
              }
            } else { [inference_error(message: "empty list literal: expected type is not a collection", span: span, module_name: scope.module_name)] }
          Absent => []
        }
      } else { [] }
      let list_k = list_kernel_ty_from_element(element: elem_type_node)
      let ll_texpr = make_expr_node(expr_data: ExprListLit, children: typed_elements, inferred: Present { value: Resolved { node: list_k.ty } }, span: span)
      InferResult {
        typed: ll_texpr,
        diagnostics: concat(concat(elem_diags, empty_list_diags), list_k.miss_diags)
      }

    ExprBinOp { op: op, algebra_field: _ } =>
      let span = texpr.span
      let left_expr = binop_left(texpr: texpr)
      let right_expr = binop_right(texpr: texpr)
      let left_result = infer_expr(texpr: left_expr, scope: scope, expected: none)
      let left_typed = left_result.typed
      let left_diags = left_result.diagnostics
      let right_result = infer_expr(texpr: right_expr, scope: scope, expected: none)
      let right_typed = right_result.typed
      let right_diags = right_result.diagnostics
      let binop_info = infer_binop_type_node(op: op, left_type: resolved_type(n: left_typed), source_indices: scope.type_env.source_indices)
      let bo_texpr = make_expr_node(expr_data: ExprBinOp { op: op, algebra_field: binop_info.algebra_field }, children: [left_typed, right_typed], inferred: Present { value: Resolved { node: binop_info.result_type } }, span: span)
      InferResult {
        typed: bo_texpr,
        diagnostics: concat(left_diags, right_diags)
      }

    ExprUnaryOp { op: op } =>
      let span = texpr.span
      let operand_expr = unaryop_operand(texpr: texpr)
      let operand_result = infer_expr(texpr: operand_expr, scope: scope, expected: none)
      let operand_typed = operand_result.typed
      let operand_diags = operand_result.diagnostics
      let result_type = match op {
        Not => bool_type
        Neg => resolved_type(n: operand_typed)
      }
      let uo_texpr = make_expr_node(expr_data: ExprUnaryOp { op: op }, children: [operand_typed], inferred: Present { value: Resolved { node: result_type } }, span: span)
      InferResult {
        typed: uo_texpr,
        diagnostics: operand_diags
      }

    ExprLambda =>
      let span = texpr.span
      let lam_body = lambda_body(texpr: texpr)
      let lam_params = lambda_param_names_at(texpr: texpr, source_indices: scope.type_env.source_indices)
      let lam_param_nodes = texpr.children |> skip(1)
      let elem_prov = match map_get(scope.lambda_param_provenance, "elem") {
        Present { value: p } => p
        Absent => SubValueUnknown
      }
      let lam_scope = if expected != none {
        let exp = expected.value
        if exp.params |> count > 0 {
          fold(lam_params |> enumerate, init: scope, f: (acc, pair) =>
            let param_prov = if pair.first == (lam_params |> count) - 1 { elem_prov } else { SubValueUnknown }
            match exp.params |> skip(pair.first) |> first {
              Present { value: cp } => extend_scope(scope: acc, name: pair.second, resolved: param_node_type_expr(n: cp), provenance: param_prov)
              Absent => extend_scope(scope: acc, name: pair.second, resolved: type_variable_node(id: "callable_param"), provenance: param_prov)
            }
          )
        } else if lam_params |> count == 1 {
          match lam_params |> first {
            Present { value: p } =>
              extend_scope(scope: scope, name: p, resolved: exp, provenance: elem_prov)
            Absent => scope
          }
        } else {
          fold(lam_params |> enumerate, init: scope, f: (acc, pair) =>
            let param_prov = if pair.first == (lam_params |> count) - 1 { elem_prov } else { SubValueUnknown }
            if pair.first == (lam_params |> count) - 1 {
              extend_scope(scope: acc, name: pair.second, resolved: exp, provenance: param_prov)
            } else {
              extend_scope(scope: acc, name: pair.second, resolved: type_variable_node(id: "lambda_param"), provenance: param_prov)
            }
          )
        }
      } else {
        extend_scope_with_params(scope: scope, params: lam_params)
      }
      let body_expected = if expected != none {
        let exp = expected.value
        if exp.params |> count > 0 {
          match exp.inferred {
            Present { value: Resolved { node: declared_ret } } =>
              if type_node_is_established(n: declared_ret, source_indices: scope.type_env.source_indices)
                && is_fully_resolved(n: declared_ret, source_indices: scope.type_env.source_indices) {
                Present { value: declared_ret }
              } else { none }
            _ => none
          }
        } else { none }
      } else { none }
      let body_scope = InferScope {
        type_env: lam_scope.type_env, func_env: lam_scope.func_env,
        locals: lam_scope.locals, body_locals: lam_scope.body_locals,
        match_bound_names: lam_scope.match_bound_names,
        module_name: lam_scope.module_name, service_registry: lam_scope.service_registry,
        item_registry: lam_scope.item_registry, caller_decl_name: lam_scope.caller_decl_name, lambda_param_provenance: empty_map()
      }
      let body_result = infer_expr(texpr: lam_body, scope: body_scope, expected: body_expected)
      let body_typed = body_result.typed
      let body_diags = body_result.diagnostics
      let typed_param_nodes = lam_param_nodes |> enumerate |> map(pair =>
        let pn = pair.second
        let param_name = match lam_params |> skip(pair.first) |> first { Present { value: n } => n  Absent => "" }
        let param_type = match map_get(lam_scope.locals, param_name) {
          Present { value: binding } => Present { value: Resolved { node: binding.resolved } }
          Absent => none
        }
        Node {
          name: pn.name, ident: pn.ident, span: pn.span, ident_span: pn.ident_span, children: pn.children,
          connective: pn.connective, params: pn.params, inferred: param_type,
          return_cardinality: pn.return_cardinality, uses: pn.uses, body: pn.body,
          transport: pn.transport, properties: pn.properties, type_annotation: pn.type_annotation,
          is_self_recursive: pn.is_self_recursive, has_non_tail_self_call: pn.has_non_tail_self_call,
          match_pattern: pn.match_pattern, expr_data: pn.expr_data
        }
      )
      let lam_texpr = make_expr_node(
        expr_data: ExprLambda,
        children: concat([body_typed], typed_param_nodes),
        inferred: body_typed.inferred,
        span: span
      )
      InferResult {
        typed: lam_texpr,
        diagnostics: body_diags
      }

    ExprStringInterp =>
      let span = texpr.span
      let typed_part_nodes = texpr.children |> map(part_node =>
        match part_node.expr_data {
          ExprLiteral { value: _ } => part_node
          _ =>
            match part_node.children |> first {
              Present { value: inner } =>
                let r = infer_expr(texpr: inner, scope: scope, expected: none)
                make_interp_part_node(expr: r.typed, span: part_node.span)
              Absent => part_node
            }
        }
      )
      let interp_diags = texpr.children |> flat_map(part_node =>
        match part_node.expr_data {
          ExprLiteral { value: _ } => []
          _ =>
            match part_node.children |> first {
              Present { value: inner } =>
                let r = infer_expr(texpr: inner, scope: scope, expected: none)
                r.diagnostics
              Absent => []
            }
        }
      )
      let si_texpr = make_expr_node(expr_data: ExprStringInterp, children: typed_part_nodes, inferred: Present { value: Resolved { node: string_type } }, span: span)
      InferResult {
        typed: si_texpr,
        diagnostics: interp_diags
      }

    ExprBlock =>
      let span = texpr.span
      let stmts = texpr.children
      if count(stmts) > 0 {
        let state = infer_block_stmts(
          remaining: stmts, remaining_count: count(stmts), scope: scope,
          typed_stmts: [], diag_chunks: [],
          last_type: unit_type, expected: expected
        )
        let blk_texpr = make_expr_node(expr_data: ExprBlock, children: state.typed_stmts, inferred: Present { value: Resolved { node: state.last_type } }, span: span)
        InferResult {
          typed: blk_texpr,
          diagnostics: flat_map(state.diag_chunks, c => c)
        }
      } else {
        ok_infer(texpr: make_expr_node(expr_data: ExprBlock, children: [], inferred: Present { value: Resolved { node: unit_type } }, span: span))
      }

    ExprCast =>
      let span = texpr.span
      let cast_inner = cast_expr(texpr: texpr)
      let target_type = cast_target(texpr: texpr)
      let inner_result = infer_expr(texpr: cast_inner, scope: scope, expected: none)
      let inner_typed = inner_result.typed
      let inner_diags = inner_result.diagnostics
      let si = scope.type_env.source_indices
      let target_name = authored_name_at(source_indices: si, node: target_type)
      let cast_diag = validate_cast(source_inferred: inner_typed.inferred, target_name: target_name, span: span, source_indices: si, module_name: scope.module_name)
      let cast_diags = match cast_diag {
        Present { value: d } => [d]
        Absent => []
      }
      let cast_optional_diags = optional_cast_diags(
        source_inferred: inner_typed.inferred,
        target_type: target_type,
        span: span,
        source_indices: si,
        module_name: scope.module_name
      )
      let cast_sole_ctor_diags = sole_constructor_construction_diags(type_name: target_name, span: span, scope: scope)
      let cast_refinement_diags = where_refinement_mismatch_diags(
        formal: target_type,
        value_expr: inner_typed,
        span: span,
        module_name: scope.module_name,
        type_env: scope.type_env
      )
      let cast_texpr = make_expr_node(expr_data: ExprCast, children: [inner_typed, target_type], inferred: Present { value: Resolved { node: target_type } }, span: span)
      InferResult {
        typed: cast_texpr,
        diagnostics: concat(concat(concat(concat(inner_diags, cast_diags), cast_optional_diags), cast_sole_ctor_diags), cast_refinement_diags)
      }

    ExprForEach =>
      let variable = foreach_variable_at(texpr: texpr, source_indices: scope.type_env.source_indices)
      let span = texpr.span
      let coll = foreach_collection(texpr: texpr)
      let body_expr = foreach_body(texpr: texpr)
      let coll_result = infer_expr(texpr: coll, scope: scope, expected: none)
      let coll_typed = coll_result.typed
      let coll_diags = coll_result.diagnostics
      let elem_type_node = for_each_element_type_node(n: resolved_type(n: coll_typed), source_indices: scope.type_env.source_indices)
      let elem_provenance = derive_element_provenance(coll_expr: coll_typed, elem_type: elem_type_node, scope: scope)
      let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type_node, provenance: elem_provenance)
      let body_result = infer_expr(texpr: body_expr, scope: body_scope, expected: none)
      let body_typed = body_result.typed
      let body_diags = body_result.diagnostics
      let fe_texpr = make_named_expr_node(name: variable, expr_data: ExprForEach, children: [coll_typed, body_typed], inferred: body_typed.inferred, span: span, name_span: node_name_span(n: texpr))
      InferResult {
        typed: fe_texpr,
        diagnostics: concat(coll_diags, body_diags)
      }

    ExprIndex =>
      let span = texpr.span
      let base_expr = index_base(texpr: texpr)
      let idx_key = index_expr(texpr: texpr)
      let base_result = infer_expr(texpr: base_expr, scope: scope, expected: none)
      let base_typed = base_result.typed
      let base_diags = base_result.diagnostics
      let index_result = infer_expr(texpr: idx_key, scope: scope, expected: none)
      let index_typed = index_result.typed
      let index_diags = index_result.diagnostics
      let index_check = match base_typed.inferred {
        Present { value: Resolved { node: base_type } } =>
          match index_typed.inferred {
            Present { value: Resolved { node: index_type } } =>
              Present { value: check_index_access_node(
                base_type: base_type,
                index_type: index_type,
                span: span,
                module_name: scope.module_name,
                source_indices: scope.type_env.source_indices
              ) }
            _ => none
          }
        _ => none
      }
      let access_failure_inferred = match base_typed.inferred {
        Present { value: Resolved { node: _ } } => index_typed.inferred
        _ => base_typed.inferred
      }
      let idx_inferred = match index_check {
        Present { value: checked } => checked.inferred
        Absent => Present { value: inferred_or_error(result: access_failure_inferred, fallback_message: "invalid index access", fallback_span: span) }
      }
      let index_access_diags = match index_check {
        Present { value: checked } => checked.diagnostics
        Absent => []
      }
      let idx_texpr = make_expr_node(expr_data: ExprIndex, children: [base_typed, index_typed], inferred: idx_inferred, span: span)
      InferResult {
        typed: idx_texpr,
        diagnostics: concat(base_diags, index_diags, index_access_diags)
      }

    ExprSlice =>
      let span = texpr.span
      let base_expr = slice_base(texpr: texpr)
      let start_expr = slice_start(texpr: texpr)
      let end_expr = slice_end(texpr: texpr)
      let base_result = infer_expr(texpr: base_expr, scope: scope, expected: none)
      let base_typed = base_result.typed
      let base_diags = base_result.diagnostics
      let start_result = infer_expr(texpr: start_expr, scope: scope, expected: none)
      let start_typed = start_result.typed
      let start_diags = start_result.diagnostics
      let end_result = infer_expr(texpr: end_expr, scope: scope, expected: none)
      let end_typed = end_result.typed
      let end_diags = end_result.diagnostics
      let slice_check = match base_typed.inferred {
        Present { value: Resolved { node: base_type } } =>
          match start_typed.inferred {
            Present { value: Resolved { node: start_type } } =>
              match end_typed.inferred {
                Present { value: Resolved { node: end_type } } =>
                  Present { value: check_slice_access_node(
                    base_type: base_type,
                    start_type: start_type,
                    end_type: end_type,
                    span: span,
                    module_name: scope.module_name,
                    source_indices: scope.type_env.source_indices
                  ) }
                _ => none
              }
            _ => none
          }
        _ => none
      }
      let access_failure_inferred = match base_typed.inferred {
        Present { value: Resolved { node: _ } } =>
          match start_typed.inferred {
            Present { value: Resolved { node: _ } } => end_typed.inferred
            _ => start_typed.inferred
          }
        _ => base_typed.inferred
      }
      let slc_inferred = match slice_check {
        Present { value: checked } => checked.inferred
        Absent => Present { value: inferred_or_error(result: access_failure_inferred, fallback_message: "invalid slice access", fallback_span: span) }
      }
      let slice_access_diags = match slice_check {
        Present { value: checked } => checked.diagnostics
        Absent => []
      }
      let slc_texpr = make_expr_node(expr_data: ExprSlice, children: [base_typed, start_typed, end_typed], inferred: slc_inferred, span: span)
      InferResult {
        typed: slc_texpr,
        diagnostics: concat(base_diags, start_diags, end_diags, slice_access_diags)
      }

    ExprReturn =>
      let span = texpr.span
      let inner_expr = return_value(texpr: texpr)
      let inner_result = infer_expr(texpr: inner_expr, scope: scope, expected: expected)
      let ret_texpr = make_expr_node(expr_data: ExprReturn, children: [inner_result.typed], inferred: inner_result.typed.inferred, span: span)
      InferResult {
        typed: ret_texpr,
        diagnostics: inner_result.diagnostics
      }

    _ =>
      let span = texpr.span
      InferResult {
        typed: make_expr_error_node(kind: InternalExprError, message: "unhandled expression variant in infer_expr", span: span),
        diagnostics: [inference_error(
          message: "unhandled expression variant in infer_expr",
          span: span,
          module_name: scope.module_name
        )]
      }
  }
}

fn infer_variant_constructor_call(func_name: String, call_args: List<Node>, span: SourceSpan, name_span: SourceSpan, scope: InferScope) -> InferResult? {
  match lookup_variant_parent_enum(scope: scope, name: func_name) {
    Absent => none
    Present { value: parent_enum } =>
      let si = scope.type_env.source_indices
      match lookup_type_by_name(env: scope.type_env, name: parent_enum) {
        Present { value: parent_node } =>
          match find_child_named(n: parent_node, name: func_name, source_indices: si) {
            Present { value: variant_node } =>
              if variant_has_positional_payload_shape(variant: variant_node, source_indices: si) {
                if call_args |> count == 1 {
                  match call_args |> first {
                    Present { value: arg } =>
                      match arg_name_at(n: arg, source_indices: si) {
                        Present { value: arg_name } =>
                          let msg = concat(
                            "positional variant constructor '", func_name,
                            "' does not accept named arguments (got '", arg_name, ": ...')"
                          )
                          Present { value: InferResult {
                            typed: semantic_expr_error_node(message: msg, span: arg.span),
                            diagnostics: [inference_error(message: msg, span: arg.span, module_name: scope.module_name)]
                          } }
                        Absent =>
                          let payload_expr = arg_value(n: arg)
                          let payload_init = make_field_init_node(
                            name: "0",
                            value: payload_expr,
                            span: payload_expr.span,
                            name_span: kernel_span(name: "0")
                          )
                          Present { value: infer_record_lit(
                            type_name: Present { value: func_name },
                            field_inits: [payload_init],
                            span: span,
                            name_span: name_span,
                            scope: scope,
                            expected: none
                          ) }
                      }
                    Absent => none
                  }
                } else {
                  let arity_msg = concat(
                    "positional variant constructor '", func_name,
                    "' expects exactly one argument"
                  )
                  Present { value: InferResult {
                    typed: semantic_expr_error_node(message: arity_msg, span: span),
                    diagnostics: [inference_error(message: arity_msg, span: span, module_name: scope.module_name)]
                  } }
                }
              } else { none }
            Absent => none
          }
        Absent => none
      }
  }
}

fn is_deferred_field_access_base(n: Node, env: TypeEnv) -> Bool {
  if n.inferred != none && is_type_variable(inferred: n.inferred.value) { true }
  else if n.connective == NoConnective && n.children |> count == 0 && n.inferred == none {
    let name = authored_name_at(source_indices: env.source_indices, node: n)
    match lookup_type_by_name(env: env, name: name) {
      Present { value: decl } => (decl.params |> count) > 0
      Absent => false
    }
  } else { false }
}

fn needs_alias_field_expansion(n: Node, env: TypeEnv) -> Bool {
  if is_deferred_field_access_base(n: n, env: env) { false }
  else if (n.connective == Conj || n.connective == Disj) {
    false
  } else if n.connective == NoConnective && n.children |> count > 0 && n.inferred == none {
    is_user_generic_use_site(n: n, env: env)
  } else {
    match lookup_type_for(env: env, node: n) {
      Present { value: binding } =>
        if (binding.connective == Conj || binding.connective == Disj) {
          n.connective == NoConnective && n.children |> count == 0
        } else if binding.connective == NoConnective && binding.children |> count == 0 && binding.inferred != none {
          true
        } else if binding.connective == NoConnective && binding.children |> count > 0 {
          is_user_generic_use_site(n: binding, env: env) || binding.inferred != none
        } else {
          false
        }
      Absent => false
    }
  }
}

data call_locals_shadow_note: String = "Body-scope binders shadow the fn-sig lookup in the ExprCall arm (nearest-first precedence: body locals > module fns > census global_bare). Without this gate a corpus-unique census homonym out-precedes a `let` callee: refinement.dag's `let classify = by.classify; match classify(base)` typed the scrutinee as a v2 lens test module's `fn classify -> Optional<Finding>`, refusing the match arms against the wrong enum (variant not found in Optional + non-exhaustive missing Absent/Present). The gate reads body_locals — the strict body-grain subset (let / match pattern / fn+lambda params) of scope.locals — because the module context pre-seeds locals with variant and service census bindings that must NOT eclipse fn sigs (an imported 0-arg fn would lose its sig to its own census row: html_fragment.dag's html_markup_medium() typed as an unresolved primitive). Absent sends the call down the local-callable path exactly as the pre-census seed did. Companion precedence law lives in func_sig_from_global_bare (infer_lookup): the census fallback never serves an algebra method-template name (filter/any/contains/…) — a whole-pool census entry for the UNLOADED v2.std.algebra must not preempt the known-method bridge (main-parity: on main such free calls type through the bridge; a census-served sig typed filter(xs, f) as a plain call to a never-loaded module and the runtime died NoSuchFunction)."

data peel_alias_fixpoint_guard_note: String = "Termination (§4 boundedness) and diagnostic completeness (§5): peel iterates resolve_node toward a groundable form; a node that resolves to ITSELF (a self-resolving generic constructor such as List — NoConnective, children>0, inferred=none, unbound-or-identity under resolve) is a resolve FIXED POINT, the expansion frontier. Without the once==n check the recurse arm loops forever on that shape (measured: one peel call spun 3M+ iterations / 396M resolve calls on the #6640 total-census tree, witness test.claim.bmc_bootstrap_provision_witness, fp trace c1f861179e→d33138c3f8→256ee7d351 repeating — progress-then-self-loop, no >1-cycle, so consecutive-equal suffices; a memo cannot terminate it, only make each spin fast). The fixed-point/non-alias arm is a legitimate speculative probe miss ONLY when resolve_node returns no diagnostics. The old Node return projected .resolved and discarded .diagnostics, making that quiet miss byte-identical to a real resolver refusal and zeroing the refusal's frequency before CompileResult, compile-clean, and the diagnostic census could observe it. The peel now returns the existing NodeResolveResult authority and accumulates every hop's diagnostics. ExprFieldAccess and record-literal alias field discovery are judgment-producing callers and must carry those diagnostics. Variant-membership and emit-shaping callers are metadata-only probes: they may inspect .resolved but do not admit an executable artifact or own a diagnostic ledger, so making them emit would turn speculative shape lookup into a false red. No second peel outcome vocabulary is minted beside the resolver's own typed carrier."

fn peel_alias_once_for_field_access(n: Node, env: TypeEnv, module_name: String) -> NodeResolveResult {
  let once = resolve_node(n: n, env: env, module_name: module_name)
  let resolved_once = once.resolved
  if (resolved_once.connective == Conj || resolved_once.connective == Disj) {
    once
  } else if resolved_once.connective == NoConnective && resolved_once.children |> count > 0 && resolved_once.inferred == none {
    if resolved_once == n { once }
    else {
      let rest = peel_alias_once_for_field_access(n: resolved_once, env: env, module_name: module_name)
      NodeResolveResult { resolved: rest.resolved, diagnostics: concat(once.diagnostics, rest.diagnostics) }
    }
  } else {
    once
  }
}

fn structural_from_expanded_type(normed: Node) -> Node {
  match normed.connective {
    Conj => normed
    Disj => normed
    _ =>
      match normed.inferred {
        Present { value: Resolved { node: target } } =>
          match target.connective {
            Conj => target
            Disj => target
            _ => normed
          }
        _ => normed
      }
  }
}

fn record_field_type_is_unresolved_param(field: Node, param_names: List<String>, env: TypeEnv) -> Bool {
  match product_field_result_type(field: field) {
    Present { value: ft } =>
      if ft.connective == NoConnective && ft.children |> count == 0 {
        match ft.inferred {
          Present { value: inf } => is_type_variable(inferred: inf)
          Absent =>
            let fname = authored_name_at(source_indices: env.source_indices, node: ft)
            let in_params = param_names |> any(pn => pn == fname)
            let conv = is_type_variable_name(name: fname)
            in_params || conv
        }
      } else { false }
    Absent => false
  }
}

fn record_has_unresolved_param_field(record: Node, env: TypeEnv) -> Bool {
  let param_names = record.params |> map(p => generic_param_name_at(n: p, source_indices: env.source_indices))
  record.children |> any(f => record_field_type_is_unresolved_param(field: f, param_names: param_names, env: env))
}

fn alias_chain_generic_decl(env: TypeEnv, carrier: Node, target: Node) -> Node {
  if target.params |> count > 0 { target }
  else { resolve_generic_use_decl(env: env, n: carrier) }
}

fn alias_chain_type_arg_subst(env: TypeEnv, carrier: Node, target: Node, type_args: List<Node>) -> Map<String, Node> {
  let decl = alias_chain_generic_decl(env: env, carrier: carrier, target: target)
  fold(decl.params |> enumerate, init: empty_map(), f: (acc, pair) =>
    let slot = generic_param_name_at(n: pair.second, source_indices: env.source_indices)
    match type_args |> skip(pair.first) |> first {
      Present { value: arg } => map_insert(acc, slot, resolve_scrutinee_type_node(env: env, n: arg))
      Absent => acc
    }
  )
}

fn alias_chain_target_after_args(target: Node, carrier: Node, env: TypeEnv) -> Node {
  let type_args = carrier.children
  if type_args |> count == 0 { target }
  else {
    let decl = alias_chain_generic_decl(env: env, carrier: carrier, target: target)
    let subst = alias_chain_type_arg_subst(env: env, carrier: carrier, target: target, type_args: type_args)
    let is_parameterized_alias = decl.inferred != none && decl.children |> count == 0 && decl.connective == NoConnective
    if is_parameterized_alias {
      match decl.inferred {
        Present { value: Resolved { node: alias_body } } => substitute_generics(n: alias_body, subst: subst, source_indices: env.source_indices)
        _ => target
      }
    } else {
      substitute_generics(n: decl, subst: subst, source_indices: env.source_indices)
    }
  }
}

fn alias_chain_carrier(n: Node) -> Node {
  if n.connective == NoConnective && n.name != "" { n }
  else { structural_from_expanded_type(normed: n) }
}

fn expand_alias_chain_for_field_access(n: Node, env: TypeEnv, module_name: String, origin_name: String, seen: Map<String, Bool>, lossy: Bool) -> NodeResolveResult {
  let peel_result = if needs_alias_field_expansion(n: n, env: env) {
    peel_alias_once_for_field_access(n: n, env: env, module_name: module_name)
  } else {
    NodeResolveResult { resolved: n, diagnostics: [] }
  }
  let peeled = peel_result.resolved
  let carrier = alias_chain_carrier(n: peeled)
  let carrier_name = if carrier.name != "" { carrier.name } else { authored_name_at(source_indices: env.source_indices, node: carrier) }
  let structural = structural_from_expanded_type(normed: resolve_scrutinee_type_node(env: env, n: peeled))
  let is_record = structural.connective == Conj || structural.connective == Disj
  if is_record {
    let resolved_record = if record_has_unresolved_param_field(record: structural, env: env) && (carrier.children |> count) > 0 && carrier_name != "" {
      match lookup_type_by_name(env: env, name: carrier_name) {
        Present { value: target } =>
          let subst = alias_chain_type_arg_subst(env: env, carrier: carrier, target: target, type_args: carrier.children)
          substitute_generics(n: structural, subst: subst, source_indices: env.source_indices)
        Absent => structural
      }
    } else { structural }
    let fail_closed = lossy && record_has_unresolved_param_field(record: resolved_record, env: env)
    if fail_closed {
      NodeResolveResult { resolved: nominal_type_ref(name: origin_name), diagnostics: peel_result.diagnostics }
    } else { NodeResolveResult { resolved: resolved_record, diagnostics: peel_result.diagnostics } }
  } else {
    let next_name = carrier_name

    let is_optional = structural.return_cardinality == CardOptional
    if is_optional {
      let expanded_inner = expand_alias_chain_for_field_access(n: with_required_cardinality(n: structural), env: env, module_name: module_name, origin_name: origin_name, seen: seen, lossy: lossy)
      NodeResolveResult {
        resolved: with_optional_cardinality(n: expanded_inner.resolved),
        diagnostics: concat(peel_result.diagnostics, expanded_inner.diagnostics)
      }
    } else {
    let stop = next_name == "" || emit_map_has(m: seen, key: next_name)
    if stop {
      NodeResolveResult { resolved: structural, diagnostics: peel_result.diagnostics }
    } else {
      match lookup_type_by_name(env: env, name: next_name) {
        Present { value: target } =>
          let next_seen = map_insert(seen, next_name, true)
          let type_arg_count = carrier.children |> count
          let decl = alias_chain_generic_decl(env: env, carrier: carrier, target: target)
          let param_count = decl.params |> count
          let dropped_args = type_arg_count > 0 && param_count > 0 && param_count != type_arg_count
          let next_lossy = lossy || dropped_args
          let next_n = if type_arg_count > 0 && !dropped_args {
            alias_chain_target_after_args(target: target, carrier: carrier, env: env)
          } else { target }
          let expanded_next = expand_alias_chain_for_field_access(n: next_n, env: env, module_name: module_name, origin_name: origin_name, seen: next_seen, lossy: next_lossy)
          NodeResolveResult {
            resolved: expanded_next.resolved,
            diagnostics: concat(peel_result.diagnostics, expanded_next.diagnostics)
          }
        Absent => NodeResolveResult { resolved: structural, diagnostics: peel_result.diagnostics }
      }
    }
    }
  }
}

fn expand_type_for_field_access_with_seen(n: Node, env: TypeEnv, module_name: String, seen: Map<String, Bool>) -> NodeResolveResult {
  if is_deferred_field_access_base(n: n, env: env) {
    NodeResolveResult { resolved: n, diagnostics: [] }
  } else {
    let origin_name = authored_name_at(source_indices: env.source_indices, node: n)
    expand_alias_chain_for_field_access(n: n, env: env, module_name: module_name, origin_name: origin_name, seen: seen, lossy: false)
  }
}

fn expand_type_for_field_access(n: Node, env: TypeEnv, module_name: String) -> NodeResolveResult {
  expand_type_for_field_access_with_seen(n: n, env: env, module_name: module_name, seen: empty_map())
}

fn record_lit_alias_struct_expansion(type_name: String, scope: InferScope) -> NodeResolveResult? {
  match lookup_type_by_name(env: scope.type_env, name: type_name) {
    Present { value: decl } =>
      let to_expand = if decl.connective == NoConnective && decl.children |> count == 0 && decl.inferred != none {
        match decl.inferred {
          Present { value: Resolved { node: target } } => target
          _ => decl
        }
      } else { decl }
      Present { value: expand_type_for_field_access(n: to_expand, env: scope.type_env, module_name: scope.module_name) }
    Absent => none
  }
}

fn record_lit_construction_field_names(type_name: String, scope: InferScope) -> List<String>? {
  let si = scope.type_env.source_indices
  match lookup_type_by_name(env: scope.type_env, name: type_name) {
    Present { value: decl } =>
      if (decl.params |> count == 0) && (decl.connective == Conj) && (decl.children |> count > 0) {
        Present { value: decl.children |> map(f => authored_name_at(source_indices: si, node: f)) }
      } else {
        none
      }
    Absent => none
  }
}

fn field_in_any_variant_named(type_name: String, field: String, scope: InferScope) -> Bool {
  let si = scope.type_env.source_indices
  match variant_owner_node(scope: scope, name: type_name) {
    Present { value: owner } =>
      owner.children |> any(arm =>
        if authored_name_at(source_indices: si, node: arm) == type_name {
          let ea = expand_type_for_field_access(n: arm, env: scope.type_env, module_name: scope.module_name).resolved
          let fields = if (ea.connective == Conj) { ea.children } else { arm.children }
          fields |> any(f => authored_name_at(source_indices: si, node: f) == field)
        } else { false }
      )
    Absent => false
  }
}

fn type_has_sole_constructor(type_name: String, scope: InferScope) -> Bool {
  match lookup_type_by_name(env: scope.type_env, name: type_name) {
    Present { value: decl } => decl.properties |> any(p => p.name == "sole_constructor")
    Absent => false
  }
}

// sole_constructor is a property of the TYPE, so every construction form producing an inhabitant
// consults ONE authority here rather than each arm re-deriving the same definer-file comparison.
// Two forms reach it: the record literal (infer_record_lit) and the CAST (`x as Sealed`).
//
// WHY THE CAST NEEDED ITS OWN WIRING. validate_cast judges a cast only when source AND target are
// both inside std.coercion's dag_cast_rules primitive domain, so `String as SomeRecord` fell through
// its `!is_dag_cast_domain_type` arm unjudged — a cast into a sealed type re-typed the value with no
// diagnostic at all. A cast IS construction: it is the one expression form that produces a value of
// the target type from a value that is not one, which is exactly what a sole_constructor type says
// only its definer may do. This is the gap the capability audit names by example (casts like
// `as TransportScript`).
//
// The refusal grain matches the record-literal arm exactly (the definer's FILE, decl.span.file), so a
// sealed type's own module keeps every construction form and no other module gets any of them.
fn sole_constructor_construction_diags(
  type_name: String,
  span: SourceSpan,
  scope: InferScope
) -> List<ErrorNode> {
  if type_has_sole_constructor(type_name: type_name, scope: scope) {
    match lookup_type_by_name(env: scope.type_env, name: type_name) {
      Present { value: decl } =>
        if decl.span.file == span.file {
          []
        } else {
          [make_error_node(diagnostic: SoleConstructorViolation { type_name: type_name, span: span }, module_name: scope.module_name)]
        }
      Absent => []
    }
  } else { [] }
}

data zero_field_variant_tag_reference_frontier_note: String = "P0 field-wall frontier (operator Ruling 1a, 2026-07-15): a ZERO-field literal of a coproduct VARIANT (field_inits empty AND variant_owner_node != none) is sanctioned as a TAG REFERENCE, not a construction — the `discriminant(v: PrefixToken {})` idiom (16+ sites in src/v2/std/compilers/target_model.dag) names a variant to obtain its stable tag identity without materializing a value. Presence checking is skipped for exactly this shape; PARTIAL literals (any field present) stay red, and zero-field literals of NON-variant records (variant_owner_node == none) stay red — so the audit F1 probes (CacheProvider/CostAccount partial literals) are unaffected. This is a decidable structural exemption (not an absorbing fallback: it refuses precisely, never widens on failure). DISSOLVE-ON: a first-class variant-tag carrier that types the discriminant argument position, at which point the exemption is deleted and the sites migrate to the carrier."

data presence_check_census_gate_note: String = "Field-presence enforcement (P0 wall, #6663) stands down when the literal's bare type name is AMBIGUOUS in the corpus-wide census (global_bare, order-independent): with two same-named decls in the closure, every name-keyed template lookup below resolves by overlay-wins import order (a LEDGERED binding fork, see guarded_cache_union_note), so enforcing would GUESS which decl the author meant and red correct literals against the wrong layer's fields (2026-07-16 main-red: v2 nested Monoid/BooleanAlgebra/OrderedRing literals checked against dag/std flat shapes). Skipping on ambiguity is the pre-wall behavior for exactly those names; enforcement stays live for census-unique names (~98 percent of the corpus) AND for names this module DECLARES LOCALLY. The local carve-out is the one census-ambiguous case that still enforces, and it is read from TypeEnv.str_bindings ONLY: build_type_env sets str_bindings = local_str_bindings (this module's own declarations; the direct-import overlay lands in ancestry_str_bindings), and lookup_binding_by_name_local consults str_bindings FIRST, so a locally-declared name resolves to the local decl deterministically and order-independently - the precedence note's 'locals > kernel > direct-selected > transitive union' with no fork to guess (direct_import_export_precedence_note). The gate must NOT reach lookup_type_by_name here: that walks on into ancestry_str_bindings, i.e. the import-order overlay, which makes the WALL ITSELF order-dependent - the same source text refusing under one import order and passing under the other (reproduced 2026-07-20, target/probe-presencewall ARM SET A: probe.c1 'import a then b' passes while probe.c2 'import b then a' reds on one identical literal), which is exactly the GUESS this gate exists to refuse. Dissolve-on: containment SymbolIndex (namespace lane) makes the expected type scope-resolved; then this gate is dead code and the wall goes total. Ratchet (PR #6709 review, accepted): before the wall goes total, stand-downs become counted out-of-band ledger rows (binding_forks channel shape — LEDGERED, never diagnostics; a red refusal would re-red correct literals), landing with the SymbolIndex work that dissolves this gate."

fn map_literal_expected_keyed_node(type_name: String?, expected: Node?, scope: InferScope) -> Node? {
  match type_name {
    Present { value: _ } => none
    Absent =>
      match expected {
        Present { value: e } =>
          if node_is_keyed_collection(n: e, source_indices: scope.type_env.source_indices) {
            Present { value: e }
          } else { none }
        Absent => none
      }
  }
}

fn infer_map_literal(map_node: Node, field_inits: List<Node>, span: SourceSpan, scope: InferScope) -> InferResult {
  let value_expected = match map_node.children |> skip(n: 1) |> first {
    Present { value: v } => Present { value: v }
    Absent => none
  }
  let fi_results = field_inits |> map(fi =>
    let ar = infer_expr(texpr: field_init_node_value(n: fi), scope: scope, expected: value_expected)
    FieldInferResult {
      typed_field: make_field_init_node(
        name: field_init_node_name_at(n: fi, source_indices: scope.type_env.source_indices),
        value: ar.typed,
        span: fi.span,
        name_span: node_name_span(n: fi)
      ),
      infer_result: ar,
      diagnostics: ar.diagnostics
    }
  )
  InferResult {
    typed: make_expr_node(
      expr_data: ExprRecordLit { parent_enum: none },
      children: fi_results |> map(fir => fir.typed_field),
      inferred: Present { value: Resolved { node: map_node } },
      span: span
    ),
    diagnostics: flat_map(fi_results, fir => fir.diagnostics)
  }
}

fn infer_record_lit(type_name: String?, field_inits: List<Node>, span: SourceSpan, name_span: SourceSpan, scope: InferScope, expected: Node?) -> InferResult {
  match map_literal_expected_keyed_node(type_name: type_name, expected: expected, scope: scope) {
    Present { value: map_node } =>
      infer_map_literal(map_node: map_node, field_inits: field_inits, span: span, scope: scope)
    Absent =>
      infer_record_lit_structural(
        type_name: type_name,
        field_inits: field_inits,
        span: span,
        name_span: name_span,
        scope: scope,
        expected: expected
      )
  }
}

fn infer_record_lit_structural(type_name: String?, field_inits: List<Node>, span: SourceSpan, name_span: SourceSpan, scope: InferScope, expected: Node?) -> InferResult {
  let instantiated_struct_fields = record_lit_instantiated_fields(type_name: type_name, expected: expected, scope: scope)
  let expected_struct_fields = if instantiated_struct_fields == none {
    record_lit_fields_from_expected(type_name: type_name, expected: expected, scope: scope)
  } else { none }
  let expected_variant_node = if instantiated_struct_fields == none && expected_struct_fields == none {
    match type_name {
      Present { value: _ } => record_lit_variant_from_expected(type_name: type_name, expected: expected, scope: scope)
      Absent => none
    }
  } else { none }
  let alias_struct_expansion = match type_name {
    Present { value: tn } =>
      if instantiated_struct_fields == none && expected_struct_fields == none && expected_variant_node == none && expected == none {
        record_lit_alias_struct_expansion(type_name: tn, scope: scope)
      } else { none }
    Absent => none
  }
  let struct_fields = match type_name {
    Present { value: _ } =>
      match instantiated_struct_fields {
        Present { value: fields } => fields
        Absent =>
          match expected_struct_fields {
            Present { value: fields } => fields
            Absent =>
              match expected_variant_node {
                Present { value: variant_node } => variant_node.children
                Absent =>
              match expected {
                Present { value: _ } => record_lit_expected_fields(type_name: type_name, scope: scope)
                Absent =>
                  match alias_struct_expansion {
                    Present { value: expansion } =>
                      if expansion.resolved.connective == Conj && expansion.resolved.children |> count > 0 {
                        expansion.resolved.children
                      } else { record_lit_expected_fields(type_name: type_name, scope: scope) }
                    Absent => record_lit_expected_fields(type_name: type_name, scope: scope)
                  }
              }
              }
          }
      }
    Absent =>
      match instantiated_struct_fields {
        Present { value: fields } => fields
        Absent =>
          match expected_struct_fields {
            Present { value: fields } => fields
            Absent => record_lit_expected_fields(type_name: type_name, scope: scope)
          }
      }
  }
  let alias_struct_diags = match alias_struct_expansion {
    Present { value: expansion } => expansion.diagnostics
    Absent => []
  }
  let construction_field_names = match type_name {
    Present { value: tn } => record_lit_construction_field_names(type_name: tn, scope: scope)
    Absent => none
  }
  let tn_str = match type_name {
    Present { value: tn } => tn
    Absent => ""
  }
  let si_presence = scope.type_env.source_indices
  let presence_variant_owner = variant_owner_node(scope: scope, name: tn_str)
  let presence_fields = if tn_str == "" {
    []
  } else {
    match presence_variant_owner {
      Present { value: variant_owner } =>
        match variant_owner.children |> filter(v => authored_name_at(source_indices: si_presence, node: v) == qualified_last_segment(name: tn_str)) |> first {
          Present { value: variant_node } => variant_node.children
          Absent => []
        }
      Absent =>
        match record_lit_variant_from_expected(type_name: type_name, expected: expected, scope: scope) {
          Present { value: variant_node } => variant_node.children
          Absent =>
        match instantiated_struct_fields {
          Present { value: inst_fields } => inst_fields
          Absent =>
            match lookup_type_by_name(env: scope.type_env, name: tn_str) {
              Present { value: decl } =>
                if decl.connective == Conj && (decl.params |> count) == 0 && (decl.children |> count) > 0 {
                  decl.children
                } else {
                  []
                }
              Absent => record_lit_expected_fields(type_name: type_name, scope: scope)
            }
        }
        }
    }
  }
  let is_zero_field_variant_tag_reference = (field_inits |> count) == 0
    && presence_variant_owner != none
  let presence_name_is_ambiguous = global_bare_is_ambiguous(env: scope.type_env, name: tn_str)
    && map_get(scope.type_env.str_bindings, tn_str) == none
  let presence_ambiguity_refusal_diags = if tn_str != "" && map_get(scope.type_env.str_bindings, tn_str) == none {
    let strict_cands = global_bare_strict_ambiguity_candidates(env: scope.type_env, name: tn_str)
    if strict_cands |> count > 0 {
      [make_error_node(diagnostic: AmbiguousReference { name: tn_str, candidates: strict_cands, span: name_span }, module_name: scope.module_name)]
    } else { [] }
  } else { [] }
  let missing_field_diags = if tn_str == "" || (presence_fields |> count) == 0 || is_zero_field_variant_tag_reference || presence_name_is_ambiguous {
      []
    } else {
      presence_fields
        |> filter(sf =>
          let sf_type = match sf.inferred {
            Present { value: Resolved { node: rt } } => rt
            _ => field_node_type_expr(n: sf)
          }
          sf_type.return_cardinality != CardOptional
            && sf.body == none
            && (field_inits |> any(fi => field_init_node_name_at(n: fi, source_indices: si_presence) == authored_name_at(source_indices: si_presence, node: sf))) == false)
        |> map(sf => make_error_node(
          diagnostic: MissingField {
            field: authored_name_at(source_indices: si_presence, node: sf),
            type_name: tn_str,
            span: name_span
          },
          module_name: scope.module_name
        ))
    }
  let fi_infer_results = map(field_inits, fi =>
    let fi_name = field_init_node_name_at(n: fi, source_indices: scope.type_env.source_indices)

    let unknown_field_diags = match construction_field_names {
      Present { value: names } =>
        if (names |> any(n => n == fi_name)) || field_in_any_variant_named(type_name: tn_str, field: fi_name, scope: scope) {
          []
        } else {
          [make_error_node(diagnostic: FieldNotFound { field: fi_name, type_name: tn_str, span: fi.span }, module_name: scope.module_name)]
        }
      Absent => []
    }
    let field_declared_type = match struct_fields |> filter(sf => authored_name_at(source_indices: scope.type_env.source_indices, node: sf) == fi_name) |> first {
      Present { value: sf } =>
        let ft = match sf.inferred {
          Present { value: Resolved { node: rt } } => preserve_outer_optional_cardinality(outer: sf, inner: rt)
          _ => field_node_type_expr(n: sf)
        }
        Present { value: ft }
      Absent => none
    }
    let field_expected = match field_declared_type {
      Present { value: ft } =>
        if ft.ident_span != none || type_node_is_callable(n: ft) || ft.return_cardinality == CardOptional || field_type_is_optional_coproduct(ft: ft, env: scope.type_env) {
          Present { value: ft }
        } else { none }
      Absent => none
    }
    let ar = infer_expr(texpr: field_init_node_value(n: fi), scope: scope, expected: field_expected)
    let ar_typed = ar.typed
    let ar_diags = ar.diagnostics
    let field_type_diags = match field_declared_type {
      Present { value: expected_node } =>
        let got_node = resolved_type(n: ar_typed)
        if rejects_string_for_optional_coproduct_field(
          expected: expected_node,
          got: got_node,
          source_indices: scope.type_env.source_indices,
          env: scope.type_env
        ) {
          let expected_for_shape = match lookup_type_for(env: scope.type_env, node: with_required_cardinality(n: expected_node)) {
            Present { value: resolved } => resolved
            Absent => expected_node
          }
          [type_mismatch_error(
            expected: node_type_shape(n: expected_for_shape, source_indices: scope.type_env.source_indices),
            got: node_type_shape(n: got_node, source_indices: scope.type_env.source_indices),
            span: ar_typed.span,
            module_name: scope.module_name
          )]
        } else {
          let expected_required = match lookup_type_for(env: scope.type_env, node: with_required_cardinality(n: expected_node)) {
            Present { value: resolved } => resolved
            Absent => with_required_cardinality(n: expected_node)
          }
          let formal_peeled = peel_nominal_alias_identity(n: expected_required, env: scope.type_env, module_name: scope.module_name)
          let actual_peeled = peel_nominal_alias_identity(n: got_node, env: scope.type_env, module_name: scope.module_name)
          if kernel_value_declared_type_mismatch(formal: formal_peeled, actual: actual_peeled, type_env: scope.type_env, source_indices: scope.type_env.source_indices) {
            [type_mismatch_error(
              expected: node_type_shape(n: formal_peeled, source_indices: scope.type_env.source_indices),
              got: node_type_shape(n: actual_peeled, source_indices: scope.type_env.source_indices),
              span: ar_typed.span,
              module_name: scope.module_name
            )]
          } else if structured_application_site_type_mismatch(
            formal: expected_node, actual_expr: field_init_node_value(n: fi), scope: scope) {
            [type_mismatch_error(
              expected: node_type_shape(n: formal_peeled, source_indices: scope.type_env.source_indices),
              got: node_type_shape(n: actual_peeled, source_indices: scope.type_env.source_indices),
              span: ar_typed.span,
              module_name: scope.module_name
            )]
          } else {
            []
          }
        }
      Absent => []
    }
    FieldInferResult {
      typed_field: make_field_init_node(name: fi_name, value: ar_typed, span: fi.span, name_span: node_name_span(n: fi)),
      infer_result: ar,
      diagnostics: concat(concat(concat(ar_diags, field_type_diags), unknown_field_diags), bare_none_field_construction_diags(
        fi: fi,
        fi_name: fi_name,
        field_declared_type: field_declared_type,
        type_name_for_message: tn_str,
        scope: scope
      ))
    }
  )
  let typed_fields = fi_infer_results |> map(fir => fir.typed_field)
  let fi_diags = flat_map(fi_infer_results, fir => fir.diagnostics)
  if type_name == none {
    let child_nodes = fi_infer_results |> map(fir =>
      Node {
        name: field_init_node_name_at(n: fir.typed_field, source_indices: scope.type_env.source_indices), span: fir.typed_field.span, ident_span: fir.typed_field.ident_span,
        children: [], connective: NoConnective,
               params: [], inferred: fir.infer_result.typed.inferred, return_cardinality: Required, uses: [],
        body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
      }
    )
    let anon_node = Node {
      name: "", span: no_span(), ident_span: none,
      children: child_nodes, connective: Conj,
           params: [], inferred: none, return_cardinality: Required, uses: [],
      body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
    }
    let typed_field_nodes = typed_fields
    let texpr = make_expr_node(expr_data: ExprRecordLit { parent_enum: none }, children: typed_field_nodes, inferred: Present { value: Resolved { node: anon_node } }, span: span)
    InferResult {
      typed: texpr,
      diagnostics: concat(fi_diags, alias_struct_diags)
    }
  } else {
    let type_lookup = lookup_type_by_name(env: scope.type_env, name: type_name.value)
    let local_variant_parent = match lookup_variant_parent_enum(scope: scope, name: type_name.value) {
      Present { value: p } => Present { value: p }
      Absent =>
        match variant_owner_node(scope: scope, name: type_name.value) {
          Present { value: owner } => Present { value: authored_name_at(source_indices: scope.type_env.source_indices, node: owner) }
          Absent => record_lit_parent_enum_from_expected(type_name: type_name.value, expected: expected, scope: scope)
        }
    }
    let effective_lookup = match type_lookup {
      Present { value: _ } => type_lookup
      Absent =>
        let local_lookup = lookup_in_scope(locals: scope.locals, name: type_name.value)
        match local_lookup {
          Present { value: local_node } =>
            lookup_type_for(env: scope.type_env, node: local_node)
          Absent =>
            match record_lit_variant_from_expected(type_name: type_name, expected: expected, scope: scope) {
              Present { value: _ } => record_lit_expected_coproduct(expected: expected, scope: scope)
              Absent => Absent
            }
        }
    }
    let variant_lookup_resolved = match effective_lookup {
      Present { value: tn } => tn
      Absent => error_type
    }
    let type_name_declares_own_type = match lookup_binding_by_name(env: scope.type_env, name: type_name.value) {
      Present { value: name_binding } =>
        binding_declares_name(binding: name_binding, name: type_name.value, source_indices: scope.type_env.source_indices)
      Absent => false
    }
    let raw_resolved = match local_variant_parent {
      Present { value: parent_name } =>
        if parent_name == "Optional" || type_name_declares_own_type { variant_lookup_resolved } else {
          match lookup_type_by_name(env: scope.type_env, name: parent_name) {
            Present { value: parent_decl } => parent_decl
            Absent => variant_lookup_resolved
          }
        }
      Absent => variant_lookup_resolved
    }
    let expected_optional_parent = Present { value: "Optional" }
    let is_present_ctor = type_name.value == "Present" && local_variant_parent == expected_optional_parent
    let resolved_node = if is_present_ctor {
      let val_field = fi_infer_results |> filter(fir => field_init_node_name_at(n: fir.typed_field, source_indices: scope.type_env.source_indices) == "value") |> first
      match val_field {
        Present { value: val_fir } => with_optional_cardinality(n: resolved_type(n: val_fir.infer_result.typed))
        Absent => raw_resolved
      }
    } else { raw_resolved }
    let type_diags = match effective_lookup {
      Present { value: _ } => []
      Absent => [make_error_node(
        diagnostic: bare_name_miss_diagnostic(env: scope.type_env, name: type_name.value, span: span),
        module_name: scope.module_name
      )]
    }
    let sole_ctor_diags = sole_constructor_construction_diags(type_name: type_name.value, span: span, scope: scope)
    let typed_field_nodes2 = typed_fields
    let rl_name = match type_name { Present { value: tn_val } => tn_val  Absent => "" }
    let texpr = make_named_expr_node(
      name: rl_name,
      expr_data: ExprRecordLit { parent_enum: local_variant_parent },
      children: typed_field_nodes2,
      inferred: Present { value: Resolved { node: resolved_node } },
      span: span,
      name_span: name_span
    )
    let presence_ambiguity_diags = if (type_diags |> count) > 0 { [] } else { presence_ambiguity_refusal_diags }
    InferResult {
      typed: texpr,
      diagnostics: concat(concat(concat(concat(concat(fi_diags, alias_struct_diags), type_diags), sole_ctor_diags), missing_field_diags), presence_ambiguity_diags)
    }
  }
}

type DescentSizeExpr
  = ParamSize { param: String }
  | DividedSize { param: String, divisor: Int }

type DescentContext {
  fn_name: String
  param_names: Map<String, String>
  param_order: List<String>
  type_env: TypeEnv
  sub_value_vars: Map<String, SubValueRelation>
  size_aliases: Map<String, DescentSizeExpr>
  scope_locals: Map<String, TypeBinding>
  func_env: ResolvedFuncEnv
  per_field_vars: Map<String, Map<String, SubValueRelation>>
}

fn classify_size_expr(val: Node, ctx: DescentContext) -> DescentSizeExpr? {
  match val.expr_data {
    ExprMethodCall { method_semantics: _ } =>
      let mname = expr_method_name_at(texpr: val, source_indices: ctx.type_env.source_indices)
      if mname == "count" {
        let receiver = method_receiver(texpr: val)
        match receiver.expr_data {
          ExprVar { binding_kind: _ } =>
            let rname = expr_var_name_at(texpr: receiver, source_indices: ctx.type_env.source_indices)
            match map_get(ctx.param_names, rname) {
              Present { value: _ } => Present { value: ParamSize { param: rname } }
              Absent => none
            }
          _ => none
        }
      } else { none }
    ExprBinOp { op: _, algebra_field: _ } =>
      let left = binop_left(texpr: val)
      let right = binop_right(texpr: val)
      match val.expr_data {
        ExprBinOp { op: Div, algebra_field: _ } =>
          match left.expr_data {
            ExprVar { binding_kind: _ } =>
              let lname = expr_var_name_at(texpr: left, source_indices: ctx.type_env.source_indices)
              match map_get(ctx.size_aliases, lname) {
                Present { value: ParamSize { param: p } } =>
                  match expr_literal_int_optional(expr: right) {
                    Present { value: d } =>
                      if d > 0 { Present { value: DividedSize { param: p, divisor: d } } }
                      else { none }
                    Absent => none
                  }
                _ => none
              }
            _ => none
          }
        _ => none
      }
    _ => none
  }
}

fn proportional_skip_alias_plus_literal(alias_expr: Node, lit_expr: Node, param_name: String, ctx: DescentContext) -> SubValueRelation? {
  match alias_expr.expr_data {
    ExprVar { binding_kind: _ } =>
      let aname = expr_var_name_at(texpr: alias_expr, source_indices: ctx.type_env.source_indices)
      match map_get(ctx.size_aliases, aname) {
        Present { value: DividedSize { param: p, divisor: d } } =>
          if p == param_name {
            match expr_literal_int_optional(expr: lit_expr) {
              Present { value: k } =>
                if k > 0 {
                  match proportional_divisor_from_int_at_least_two(k: d) {
                    Present { value: div_w } =>
                      let synth_field = InductiveField { type_name: param_name, variant_name: "", field_name: "skip", shape: ListRecursion, element_type: param_name }
                      Present { value: StrictSubValue { field: synth_field, factor: ProportionalShrink { divisor: div_w } } }
                    Absent => none
                  }
                } else { none }
              Absent => none
            }
          } else { none }
        _ => none
      }
    _ => none
  }
}

fn classify_collection_shrink(arg_expr: Node, param_name: String, ctx: DescentContext) -> SubValueRelation {
  match arg_expr.expr_data {
    ExprMethodCall { method_semantics: _ } =>
      let mname = expr_method_name_at(texpr: arg_expr, source_indices: ctx.type_env.source_indices)
      if mname == "take" || mname == "skip" {
        let receiver = method_receiver(texpr: arg_expr)
        match receiver.expr_data {
          ExprVar { binding_kind: _ } =>
            let rname = expr_var_name_at(texpr: receiver, source_indices: ctx.type_env.source_indices)
            if rname == param_name {
              let args = method_arg_nodes(texpr: arg_expr)
              match args |> first {
                Present { value: arg_node } =>
                  let arg_val = arg_value(n: arg_node)
                  match expr_literal_int_optional(expr: arg_val) {
                    Present { value: k } =>
                      if k > 0 && mname == "skip" {
                        match positive_descent_amount_from_positive_int(k: k) {
                          Present { value: steps } =>
                            let synth_field = InductiveField { type_name: param_name, variant_name: "", field_name: mname, shape: ListRecursion, element_type: param_name }
                            StrictSubValue { field: synth_field, factor: ConstantShrink { steps: steps } }
                          Absent => SubValueUnknown
                        }
                      } else { SubValueUnknown }
                    Absent =>
                      match arg_val.expr_data {
                    ExprVar { binding_kind: _ } =>
                      let aname = expr_var_name_at(texpr: arg_val, source_indices: ctx.type_env.source_indices)
                      match map_get(ctx.size_aliases, aname) {
                        Present { value: DividedSize { param: p, divisor: d } } =>
                          if p == param_name {
                            match proportional_divisor_from_int_at_least_two(k: d) {
                              Present { value: div_w } =>
                                let synth_field = InductiveField { type_name: param_name, variant_name: "", field_name: mname, shape: ListRecursion, element_type: param_name }
                                StrictSubValue { field: synth_field, factor: ProportionalShrink { divisor: div_w } }
                              Absent => SubValueUnknown
                            }
                          } else { SubValueUnknown }
                        _ => SubValueUnknown
                      }

                    ExprBinOp { op: op, algebra_field: _ } =>
                      match op {
                        Add =>
                          if mname == "skip" {
                            let left = binop_left(texpr: arg_val)
                            let right = binop_right(texpr: arg_val)
                            match proportional_skip_alias_plus_literal(alias_expr: left, lit_expr: right, param_name: param_name, ctx: ctx) {
                              Present { value: rel } => rel
                              Absent =>
                                match proportional_skip_alias_plus_literal(alias_expr: right, lit_expr: left, param_name: param_name, ctx: ctx) {
                                  Present { value: rel } => rel
                                  Absent => SubValueUnknown
                                }
                            }
                          } else { SubValueUnknown }
                        Sub => SubValueUnknown
                        _ => SubValueUnknown
                      }
                    _ => SubValueUnknown
                      }
                  }
                Absent => SubValueUnknown
              }
            } else { SubValueUnknown }
          _ => SubValueUnknown
        }
      } else { SubValueUnknown }
    _ => SubValueUnknown
  }
}

type BlockAnnotateAcc {
  ctx: DescentContext
  children: List<Node>
}

fn method_callback_element_position(semantics: MethodSemantics?) -> Int? {
  match semantics {
    Present { value: AlgebraMethodSemantics { method_def: _, fold_accumulator_type: _, size_effect: _, cost_shape: _, algebra_template: at } } =>
      match at {
        Present { value: template } => template.callback_element_position
        Absent => none
      }
    _ => none
  }
}

fn maybe_insert_composed_field_relation(acc: Map<String, SubValueRelation>, fname: String, composed: SubValueRelation?) -> Map<String, SubValueRelation> {
  match composed {
    Present { value: rel } =>
      match rel {
        SubValueUnknown => acc
        _ => map_insert(acc, fname, rel)
      }
    Absent => acc
  }
}

fn maybe_insert_output_field_relation(acc: Map<String, SubValueRelation>, idx: Int, fname: String, sig: ResolvedFuncSig, val: Node, ctx: DescentContext) -> Map<String, SubValueRelation> {
  let composed = match sig.output_provenance |> skip(idx) |> first {
    Present { value: param_map } => classify_call_via_provenance(call: val, param_map: param_map, ctx: ctx)
    Absent => none
  }
  maybe_insert_composed_field_relation(acc: acc, fname: fname, composed: composed)
}

fn maybe_insert_match_field_relation(fp_acc: Map<String, SubValueRelation>, pname: String, field_label: String, vname: String, scrut_rel: SubValueRelation?, param_types: Map<String, String>, type_env: TypeEnv) -> Map<String, SubValueRelation> {
  match scrut_rel {
    Present { value: rel } =>
      let lookup_type = match rel {
        PreservedValue => match map_get(param_types, pname) { Present { value: t } => t  Absent => "" }
        StrictSubValue { field: f, factor: _ } => f.element_type
        IteratedSubValue { field: f } => f.element_type
        _ => ""
      }
      if lookup_type != "" {
        let ind_fields = inductive_fields_for(env: type_env, type_name: lookup_type)
        let matching = ind_fields |> filter(f => f.field_name == field_label && (f.variant_name == vname || f.variant_name == "")) |> first
        match matching {
          Present { value: ind_field } => map_insert(fp_acc, pname, compose_sub_value(base: rel, field: ind_field))
          Absent => fp_acc
        }
      } else { fp_acc }
    Absent => fp_acc
  }
}

fn build_per_field_for_let(val: Node, binding_name: String, ctx: DescentContext) -> Map<String, Map<String, SubValueRelation>> {
  match val.expr_data {
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let callee = expr_call_func_at(texpr: val, source_indices: ctx.type_env.source_indices)
      match func_sig_if_resolved(lookup: lookup_func_sig(func_env: ctx.func_env, type_env: ctx.type_env, name: callee)) {
        Present { value: sig } =>
          if sig.output_provenance |> count > 1 {
            let return_type = sig.inferred
            let field_map = return_type.children |> enumerate |> fold(init: empty_map(), f: (acc, pair) =>
              let idx = pair.first
              let field_node = pair.second
              let fname = authored_name_at(source_indices: ctx.type_env.source_indices, node: field_node)
              maybe_insert_output_field_relation(acc: acc, idx: idx, fname: fname, sig: sig, val: val, ctx: ctx)
            )
            if map_keys(field_map) |> count > 0 {
              map_insert(ctx.per_field_vars, binding_name, field_map)
            } else { ctx.per_field_vars }
          } else { ctx.per_field_vars }
        Absent => ctx.per_field_vars
      }
    ExprMethodCall { method_semantics: _ } =>
      let callee = expr_method_name_at(texpr: val, source_indices: ctx.type_env.source_indices)
      match func_sig_if_resolved(lookup: lookup_func_sig(func_env: ctx.func_env, type_env: ctx.type_env, name: callee)) {
        Present { value: sig } =>
          if sig.output_provenance |> count > 1 {
            let return_type = sig.inferred
            let field_map = return_type.children |> enumerate |> fold(init: empty_map(), f: (acc, pair) =>
              let idx = pair.first
              let field_node = pair.second
              let fname = authored_name_at(source_indices: ctx.type_env.source_indices, node: field_node)
              maybe_insert_output_field_relation(acc: acc, idx: idx, fname: fname, sig: sig, val: val, ctx: ctx)
            )
            if map_keys(field_map) |> count > 0 {
              map_insert(ctx.per_field_vars, binding_name, field_map)
            } else { ctx.per_field_vars }
          } else { ctx.per_field_vars }
        Absent => ctx.per_field_vars
      }
    _ => ctx.per_field_vars
  }
}

fn resolve_collection_field(expr: Node, ctx: DescentContext) -> InductiveField? {
  match expr.expr_data {
    ExprFieldAccess { summary: _ } =>
      let base = field_access_base(texpr: expr)
      let fname = field_access_field_at(texpr: expr, source_indices: ctx.type_env.source_indices)
      match base.expr_data {
        ExprVar { binding_kind: _ } =>
          let bname = expr_var_name_at(texpr: base, source_indices: ctx.type_env.source_indices)
          let base_type = match map_get(ctx.param_names, bname) {
            Present { value: t } => t
            Absent =>
              match map_get(ctx.sub_value_vars, bname) {
                Present { value: rel } =>
                  match rel {
                    StrictSubValue { field: f, factor: _ } => f.element_type
                    IteratedSubValue { field: f } => f.element_type
                    _ => ""
                  }
                Absent => ""
              }
          }
          if base_type != "" {
            inductive_fields_for(env: ctx.type_env, type_name: base_type)
              |> filter(f => f.field_name == fname)
              |> filter(f => match f.shape { ListRecursion => true  _ => false })
              |> first
          } else { none }
        _ => none
      }
    ExprVar { binding_kind: _ } =>
      let rname = expr_var_name_at(texpr: expr, source_indices: ctx.type_env.source_indices)
      match map_get(ctx.sub_value_vars, rname) {
        Present { value: rel } =>
          match rel {
            StrictSubValue { field: f, factor: _ } =>
              match f.shape { ListRecursion => Present { value: f }  _ => none }
            IteratedSubValue { field: f } =>
              match f.shape { ListRecursion => Present { value: f }  _ => none }
            _ => none
          }
        Absent => none
      }
    ExprMethodCall { method_semantics: _ } =>
      let inner_mname = expr_method_name_at(texpr: expr, source_indices: ctx.type_env.source_indices)
      let is_collection_preserving = inner_mname == "enumerate" || inner_mname == "skip" || inner_mname == "take" || inner_mname == "filter" || inner_mname == "reverse"
      if is_collection_preserving {
        resolve_collection_field(expr: method_receiver(texpr: expr), ctx: ctx)
      } else { none }
    _ => none
  }
}

fn classify_binding_provenance(val: Node, scope: InferScope) -> SubValueRelation {
  match val.expr_data {
    ExprVar { binding_kind: _ } =>
      let vname = expr_var_name_at(texpr: val, source_indices: scope.type_env.source_indices)
      match map_get(scope.locals, vname) {
        Present { value: binding } => binding.provenance
        Absent => SubValueUnknown
      }
    ExprFieldAccess { summary: _ } =>
      let base = field_access_base(texpr: val)
      let field = field_access_field_at(texpr: val, source_indices: scope.type_env.source_indices)
      match base.expr_data {
        ExprVar { binding_kind: _ } =>
          let bname = expr_var_name_at(texpr: base, source_indices: scope.type_env.source_indices)
          match map_get(scope.locals, bname) {
            Present { value: binding } =>
              let fields = inductive_fields_for(env: scope.type_env, type_name: authored_name_at(source_indices: scope.type_env.source_indices, node: binding.resolved))
              let matching = fields |> filter(f => f.field_name == field) |> first
              match matching {
                Present { value: ind_field } => compose_sub_value(base: binding.provenance, field: ind_field)
                Absent => SubValueUnknown
              }
            Absent => SubValueUnknown
          }
        _ => SubValueUnknown
      }
    _ => SubValueUnknown
  }
}

fn classify_let_value(val: Node, ctx: DescentContext) -> SubValueRelation? {
  match val.expr_data {
    ExprVar { binding_kind: _ } =>
      let vname = expr_var_name_at(texpr: val, source_indices: ctx.type_env.source_indices)

      match map_get(ctx.scope_locals, vname) {
        Present { value: binding } =>
          match binding.provenance {
            SubValueUnknown => none
            _ => Present { value: binding.provenance }
          }
        Absent => none
      }
    ExprFieldAccess { summary: _ } =>
      let base = field_access_base(texpr: val)
      let field = field_access_field_at(texpr: val, source_indices: ctx.type_env.source_indices)
      match base.expr_data {
        ExprVar { binding_kind: _ } =>
          let bname = expr_var_name_at(texpr: base, source_indices: ctx.type_env.source_indices)
          let from_per_field = match map_get(ctx.per_field_vars, bname) {
            Present { value: field_map } => map_get(field_map, field)
            Absent => none
          }
          match from_per_field {
            Present { value: rel } => Present { value: rel }
            Absent =>

              let type_name = match map_get(ctx.scope_locals, bname) {
                Present { value: binding } => authored_name_at(source_indices: ctx.type_env.source_indices, node: binding.resolved)
                Absent =>
                  match map_get(ctx.param_names, bname) {
                    Present { value: t } => t
                    Absent => ""
                  }
              }
              if type_name != "" {
                let fields = inductive_fields_for(env: ctx.type_env, type_name: type_name)
                let matching = fields |> filter(f => f.field_name == field) |> first
                match matching {
                  Present { value: ind_field } => Present { value: StrictSubValue { field: ind_field, factor: UnitShrink } }
                  Absent => none
                }
              } else { none }
          }
        _ => none
      }
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let callee = expr_call_func_at(texpr: val, source_indices: ctx.type_env.source_indices)
      let from_provenance = match func_sig_if_resolved(lookup: lookup_func_sig(func_env: ctx.func_env, type_env: ctx.type_env, name: callee)) {
        Present { value: sig } =>
          match sig.output_provenance |> first {
            Present { value: param_map } =>
              classify_call_via_provenance(call: val, param_map: param_map, ctx: ctx)
            Absent => none
          }
        Absent => none
      }
      match from_provenance {
        Present { value: _ } => from_provenance
        Absent =>
          if is_child_accessor_in_model(name: callee) || is_tree_size_reducing(func_name: callee) {
            let call_args = val.children
            match call_args |> first {
              Present { value: first_arg } =>
                let inner = arg_value(n: first_arg)
                match inner.expr_data {
                  ExprVar { binding_kind: _ } =>
                    let iname = expr_var_name_at(texpr: inner, source_indices: ctx.type_env.source_indices)
                    let inner_type = match map_get(ctx.param_names, iname) {
                      Present { value: t } => t
                      Absent =>
                        match map_get(ctx.sub_value_vars, iname) {
                          Present { value: rel } =>
                            match rel {
                              StrictSubValue { field: f, factor: _ } => f.element_type
                              IteratedSubValue { field: f } => f.element_type
                              _ => ""
                            }
                          Absent => ""
                        }
                    }
                    if inner_type != "" {
                      let fields = inductive_fields_for(env: ctx.type_env, type_name: inner_type)
                      let cf = fields |> filter(f => match f.shape { ListRecursion => true  _ => false }) |> first
                      match cf {
                        Present { value: ind_field } => Present { value: StrictSubValue { field: ind_field, factor: UnitShrink } }
                        Absent => none
                      }
                    } else { none }
                  _ => none
                }
              Absent => none
            }
          } else { none }
      }
    _ =>
      let type_based = match val.inferred {
        Present { value: Resolved { node: rt } } =>
          if is_container_type(name: authored_name_at(source_indices: ctx.type_env.source_indices, node: rt)) {
            let elem = match rt.children |> first {
              Present { value: c } => authored_name_at(source_indices: ctx.type_env.source_indices, node: c)
              Absent => ""
            }
            if elem != "" && is_recursive_type_by_name(env: ctx.type_env, name: elem) {
              let fields = inductive_fields_for(env: ctx.type_env, type_name: elem)
              let cf = fields |> filter(f => match f.shape { ListRecursion => true  _ => false }) |> first
              match cf {
                Present { value: ind_field } => Present { value: StrictSubValue { field: ind_field, factor: UnitShrink } }
                Absent => none
              }
            } else { none }
          } else { none }
        _ => none
      }
      match type_based {
        Present { value: _ } => type_based
        Absent =>
          match val.expr_data {
    ExprBinOp { op: op } =>
      let left = binop_left(texpr: val)
      let right = binop_right(texpr: val)
      match op {
        Sub =>
          match left.expr_data {
            ExprVar { binding_kind: _ } =>
              let lname = expr_var_name_at(texpr: left, source_indices: ctx.type_env.source_indices)
              if map_get(ctx.param_names, lname) != none || map_get(ctx.sub_value_vars, lname) != none {
                match expr_literal_int_optional(expr: right) {
                  Present { value: k } =>
                    match positive_descent_amount_from_positive_int(k: k) {
                      Present { value: steps } =>
                        Present { value: ArithmeticDescent { param: lname, factor: ConstantShrink { steps: steps } } }
                      Absent => none
                    }
                  Absent => none
                }
              } else { none }
            _ => none
          }
        Div =>
          let left_name = match left.expr_data {
            ExprVar { binding_kind: _ } =>
              let lname = expr_var_name_at(texpr: left, source_indices: ctx.type_env.source_indices)
              if map_get(ctx.param_names, lname) != none || map_get(ctx.sub_value_vars, lname) != none { lname } else { "" }
            ExprBinOp { op: Sub } =>
              let inner_left = binop_left(texpr: left)
              match inner_left.expr_data {
                ExprVar { binding_kind: _ } =>
                  let lname = expr_var_name_at(texpr: inner_left, source_indices: ctx.type_env.source_indices)
                  if map_get(ctx.param_names, lname) != none || map_get(ctx.sub_value_vars, lname) != none { lname } else { "" }
                _ => ""
              }
            _ => ""
          }
          if left_name != "" {
            match expr_literal_int_optional(expr: right) {
              Present { value: k } =>
                match proportional_divisor_from_int_at_least_two(k: k) {
                  Present { value: div_w } =>
                    Present { value: ArithmeticDescent { param: left_name, factor: ProportionalShrink { divisor: div_w } } }
                  Absent => none
                }
              Absent => none
            }
          } else { none }
        Add =>
          none
        _ => none
      }
    ExprMethodCall { method_semantics: _ } =>
      let mname = expr_method_name_at(texpr: val, source_indices: ctx.type_env.source_indices)
      let is_collection_preserving = mname == "skip" || mname == "filter" || mname == "take" || mname == "enumerate" || mname == "reverse"
      if is_collection_preserving {
        let receiver = method_receiver(texpr: val)
        let coll_field = resolve_collection_field(expr: receiver, ctx: ctx)
        match coll_field {
          Present { value: ind_field } => Present { value: StrictSubValue { field: ind_field, factor: UnitShrink } }
          Absent =>
            if mname == "skip" {
              let skip_args = method_arg_nodes(texpr: val)
              let skip_amount = match skip_args |> first {
                Present { value: a } =>
                  match expr_literal_int_optional(expr: arg_value(n: a)) {
                    Present { value: k } => if k > 0 { k } else { 0 }
                    Absent => 0
                  }
                Absent => 0
              }
              if skip_amount > 0 {
                match receiver.expr_data {
                  ExprVar { binding_kind: _ } =>
                    let rname = expr_var_name_at(texpr: receiver, source_indices: ctx.type_env.source_indices)
                    if map_get(ctx.param_names, rname) != none || map_get(ctx.sub_value_vars, rname) != none {
                      match positive_descent_amount_from_positive_int(k: skip_amount) {
                        Present { value: steps } =>
                          let synth_field = InductiveField { type_name: rname, variant_name: "", field_name: mname, shape: ListRecursion, element_type: rname }
                          Present { value: StrictSubValue { field: synth_field, factor: ConstantShrink { steps: steps } } }
                        Absent => none
                      }
                    } else { none }
                  _ => none
                }
              } else { none }
            } else { none }
        }
      } else { none }
            _ => none
          }
      }
  }
}

fn classify_call_via_provenance(call: Node, param_map: Map<String, SubValueRelation>, ctx: DescentContext) -> SubValueRelation? {
  let call_args = call.children
  let arg_by_name = fold(call_args, init: empty_map(), f: (acc, arg_node) =>
    match arg_name_at(n: arg_node, source_indices: ctx.type_env.source_indices) {
      Present { value: aname } => map_insert(acc, aname, arg_value(n: arg_node))
      Absent => acc
    }
  )
  fold(param_map |> map_keys, init: none, f: (result, callee_pname) =>
    match map_get(param_map, callee_pname) {
      Present { value: callee_rel } =>
        match map_get(arg_by_name, callee_pname) {
          Present { value: arg_expr } =>
            let arg_rel = classify_call_arg_provenance(arg_expr: arg_expr, ctx: ctx)
            match arg_rel {
              Present { value: arel } =>
                let composed = compose_output_relations(arg_rel: arel, callee_rel: callee_rel)
                match result {
                  Present { value: prev } => Present { value: meet_sub_value(a: prev, b: composed) }
                  Absent => Present { value: composed }
                }
              Absent => result
            }
          Absent => result
        }
      Absent => result
    }
  )
}

fn classify_call_arg_provenance(arg_expr: Node, ctx: DescentContext) -> SubValueRelation? {
  match arg_expr.expr_data {
    ExprVar { binding_kind: _ } =>
      let name = expr_var_name_at(texpr: arg_expr, source_indices: ctx.type_env.source_indices)
      if map_get(ctx.param_names, name) != none {
        Present { value: PreservedValue }
      } else {
        map_get(ctx.sub_value_vars, name)
      }
    _ => classify_let_value(val: arg_expr, ctx: ctx)
  }
}

fn merge_argument_relations(rels: List<SubValueRelation>) -> SubValueRelation {
  match rels |> first {
    Absent => SubValueUnknown
    Present { value: first_rel } =>
      rels |> skip(1) |> fold(init: first_rel, f: (acc, rel) =>
        meet_sub_value(a: acc, b: rel)
      )
  }
}

fn classify_argument(arg_expr: Node, param_name: String, ctx: DescentContext) -> SubValueRelation {
  match arg_expr.expr_data {
    ExprVar { binding_kind: _ } =>
      let vname = expr_var_name_at(texpr: arg_expr, source_indices: ctx.type_env.source_indices)
      if vname == param_name { PreservedValue }
      else {
        match map_get(ctx.sub_value_vars, vname) {
          Present { value: rel } => rel
          Absent => SubValueUnknown
        }
      }
    ExprFieldAccess { summary: _ } =>
      let base = field_access_base(texpr: arg_expr)
      let field = field_access_field_at(texpr: arg_expr, source_indices: ctx.type_env.source_indices)
      match base.expr_data {
        ExprVar { binding_kind: _ } =>
          let bname = expr_var_name_at(texpr: base, source_indices: ctx.type_env.source_indices)
          let type_name = match map_get(ctx.param_names, bname) {
            Present { value: t } => t
            Absent =>
              match map_get(ctx.sub_value_vars, bname) {
                Present { value: rel } =>
                  match rel {
                    StrictSubValue { field: f, factor: _ } => f.element_type
                    IteratedSubValue { field: f } => f.element_type
                    _ => ""
                  }
                Absent => ""
              }
          }
          let fields = inductive_fields_for(env: ctx.type_env, type_name: type_name)
          let matching = fields |> filter(f => f.field_name == field) |> first
          match matching {
            Present { value: ind_field } => StrictSubValue { field: ind_field, factor: UnitShrink }
            Absent => SubValueUnknown
          }
        _ => SubValueUnknown
      }
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let call_args = arg_expr.children
      match call_args |> first {
        Present { value: first_arg } =>
          let inner = arg_value(n: first_arg)
          let inner_rel = classify_argument(arg_expr: inner, param_name: param_name, ctx: ctx)
          match inner_rel {
            StrictSubValue { field: _, factor: _ } => inner_rel
            IteratedSubValue { field: _ } => inner_rel
            ArithmeticDescent { param: _, factor: _ } => inner_rel
            PreservedValue =>
              let callee = expr_call_func_at(texpr: arg_expr, source_indices: ctx.type_env.source_indices)
              let from_provenance = match func_sig_if_resolved(lookup: lookup_func_sig(func_env: ctx.func_env, type_env: ctx.type_env, name: callee)) {
                Present { value: sig } =>
                  match sig.output_provenance |> first {
                    Present { value: param_map } =>
                      classify_call_via_provenance(call: arg_expr, param_map: param_map, ctx: ctx)
                    Absent => none
                  }
                Absent => none
              }
              match from_provenance {
                Present { value: prov_rel } => prov_rel
                Absent =>
                  if is_child_accessor_in_model(name: callee) || is_tree_size_reducing(func_name: callee) {
                    let type_name = match map_get(ctx.param_names, param_name) { Present { value: t } => t  Absent => "" }
                    let fields = inductive_fields_for(env: ctx.type_env, type_name: type_name)
                    let cf = fields |> filter(f => match f.shape { ListRecursion => true  _ => false }) |> first
                    match cf {
                      Present { value: ind_field } => StrictSubValue { field: ind_field, factor: UnitShrink }
                      Absent => PreservedValue
                    }
                  } else if is_property_contraction(func_name: callee) {
                    ArithmeticDescent { param: param_name, factor: ConstantShrink { steps: OneStep } }
                  } else { PreservedValue }
              }
            NonIncreasingValue => NonIncreasingValue
            StrictAxisErased => StrictAxisErased
            MixedTop => MixedTop
            SubValueUnknown => SubValueUnknown
          }
        Absent => SubValueUnknown
      }
    ExprMethodCall { method_semantics: _ } =>
      classify_collection_shrink(arg_expr: arg_expr, param_name: param_name, ctx: ctx)

    ExprBinOp { op: op } =>
      let left = binop_left(texpr: arg_expr)
      let right = binop_right(texpr: arg_expr)
      match op {
        Sub =>
          let left_is_param = match left.expr_data {
            ExprVar { binding_kind: _ } => expr_var_name_at(texpr: left, source_indices: ctx.type_env.source_indices) == param_name || map_get(ctx.sub_value_vars, expr_var_name_at(texpr: left, source_indices: ctx.type_env.source_indices)) != none
            _ => false
          }
          if left_is_param {
            match expr_literal_int_optional(expr: right) {
              Present { value: k } =>
                match positive_descent_amount_from_positive_int(k: k) {
                  Present { value: steps } =>
                    ArithmeticDescent { param: param_name, factor: ConstantShrink { steps: steps } }
                  Absent => SubValueUnknown
                }
              Absent => SubValueUnknown
            }
          } else {

            SubValueUnknown
          }
        Div =>
          let left_is_param = match left.expr_data {
            ExprVar { binding_kind: _ } => expr_var_name_at(texpr: left, source_indices: ctx.type_env.source_indices) == param_name || map_get(ctx.sub_value_vars, expr_var_name_at(texpr: left, source_indices: ctx.type_env.source_indices)) != none
            ExprBinOp { op: Sub } =>
              let inner_left = binop_left(texpr: left)
              match inner_left.expr_data {
                ExprVar { binding_kind: _ } => expr_var_name_at(texpr: inner_left, source_indices: ctx.type_env.source_indices) == param_name || map_get(ctx.sub_value_vars, expr_var_name_at(texpr: inner_left, source_indices: ctx.type_env.source_indices)) != none
                _ => false
              }
            _ => false
          }
          if left_is_param {
            match expr_literal_int_optional(expr: right) {
              Present { value: k } =>
                match proportional_divisor_from_int_at_least_two(k: k) {
                  Present { value: div_w } =>
                    ArithmeticDescent { param: param_name, factor: ProportionalShrink { divisor: div_w } }
                  Absent => SubValueUnknown
                }
              Absent => SubValueUnknown
            }
          } else { SubValueUnknown }
        Add =>
          SubValueUnknown
        _ => SubValueUnknown
      }

    ExprMatch =>
      let arm_rels = match_arm_nodes(texpr: arg_expr) |> map(arm =>
        classify_argument(arg_expr: arm_body(n: arm), param_name: param_name, ctx: ctx)
      )
      merge_argument_relations(rels: arm_rels)
    ExprIf =>
      let then_rel = classify_argument(arg_expr: if_then_branch(texpr: arg_expr), param_name: param_name, ctx: ctx)
      let else_rel = match if_else_branch(texpr: arg_expr) {
        Present { value: e } => classify_argument(arg_expr: e, param_name: param_name, ctx: ctx)
        Absent => SubValueUnknown
      }
      merge_argument_relations(rels: [then_rel, else_rel])
    ExprBlock =>
      match arg_expr.children |> last {
        Present { value: last_expr } => classify_argument(arg_expr: last_expr, param_name: param_name, ctx: ctx)
        Absent => SubValueUnknown
      }
    ExprLet =>
      match let_body(texpr: arg_expr) {
        Present { value: body } => classify_argument(arg_expr: body, param_name: param_name, ctx: ctx)
        Absent => SubValueUnknown
      }
    ExprCast =>
      classify_argument(arg_expr: cast_expr(texpr: arg_expr), param_name: param_name, ctx: ctx)
    ExprReturn =>
      match arg_expr.children |> first {
        Present { value: inner } => classify_argument(arg_expr: inner, param_name: param_name, ctx: ctx)
        Absent => SubValueUnknown
      }
    _ => SubValueUnknown
  }
}

fn read_arg_provenance(arg_expr: Node, param_name: String, ctx: DescentContext) -> SubValueRelation {
  match arg_expr.expr_data {
    ExprVar { binding_kind: _ } =>
      let vname = expr_var_name_at(texpr: arg_expr, source_indices: ctx.type_env.source_indices)
      match map_get(ctx.scope_locals, vname) {
        Present { value: binding } =>
          match binding.provenance {
            SubValueUnknown =>
              classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
            _ => binding.provenance
          }
        Absent =>
          classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
      }
    ExprFieldAccess { summary: _ } =>
      let base = field_access_base(texpr: arg_expr)
      let field = field_access_field_at(texpr: arg_expr, source_indices: ctx.type_env.source_indices)
      match base.expr_data {
        ExprVar { binding_kind: _ } =>
          let bname = expr_var_name_at(texpr: base, source_indices: ctx.type_env.source_indices)
          match map_get(ctx.scope_locals, bname) {
            Present { value: binding } =>
              match binding.provenance {
                SubValueUnknown =>
                  classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
                _ =>
                  let fields = inductive_fields_for(env: ctx.type_env, type_name: authored_name_at(source_indices: ctx.type_env.source_indices, node: binding.resolved))
                  let matching = fields |> filter(f => f.field_name == field) |> first
                  match matching {
                    Present { value: ind_field } => compose_sub_value(base: binding.provenance, field: ind_field)
                    Absent => SubValueUnknown
                  }
              }
            Absent =>
              classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
          }
        _ => SubValueUnknown
      }
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
    ExprMethodCall { method_semantics: _ } =>
      classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
    ExprBinOp { op: _ } =>
      classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
    ExprMatch =>
      classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
    ExprIf =>
      classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
    ExprBlock =>
      classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
    ExprLet =>
      classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
    ExprCast =>
      classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
    ExprReturn =>
      classify_argument(arg_expr: arg_expr, param_name: param_name, ctx: ctx)
    _ => SubValueUnknown
  }
}

fn build_call_evidence(call_node: Node, ctx: DescentContext) -> List<SubValueRelation> {
  let arg_map = call_node.children |> enumerate |> fold(init: empty_map(), f: (acc, pair) =>
    let idx = pair.first
    let arg_node = pair.second
    let aname = arg_name_at(n: arg_node, source_indices: ctx.type_env.source_indices)
    match aname {
      Present { value: pname } => map_insert(acc, pname, arg_value(n: arg_node))
      Absent => acc
    }
  )
  let positional_args = call_node.children |> filter(arg_node => arg_name_at(n: arg_node, source_indices: ctx.type_env.source_indices) == none) |> map(arg_node => arg_value(n: arg_node))
  let positional_idx = 0
  ctx.param_order |> enumerate |> map(pair =>
    let def_idx = pair.first
    let pname = pair.second
    match map_get(arg_map, pname) {
      Present { value: arg_val } => read_arg_provenance(arg_expr: arg_val, param_name: pname, ctx: ctx)
      Absent =>
        match positional_args |> skip(def_idx) |> first {
          Present { value: arg_val } => read_arg_provenance(arg_expr: arg_val, param_name: pname, ctx: ctx)
          Absent => SubValueUnknown
        }
    }
  )
}

fn descent_source_type(found: String, arg_node: Node, ctx: DescentContext) -> String {
  if found != "" { found }
  else {
    match arg_value(n: arg_node).expr_data {
      ExprLambda => found
      _ =>
        let arg_val = arg_value(n: arg_node)
        match arg_val.expr_data {
          ExprVar { binding_kind: _ } =>
            let vname = expr_var_name_at(texpr: arg_val, source_indices: ctx.type_env.source_indices)
            match map_get(ctx.param_names, vname) { Present { value: t } => t  Absent => "" }
          _ => ""
        }
    }
  }
}

fn annotate_descent(body: Node, ctx: DescentContext) -> Node {
  match body.expr_data {
    ExprCall { call_semantics: cs, descent_evidence: _ } =>

      let evidence = build_call_evidence(call_node: body, ctx: ctx)
      let source_type = body.children |> fold(init: "", f: (found, arg_node) =>
        descent_source_type(found: found, arg_node: arg_node, ctx: ctx)
      )
      let annotated_children = body.children |> map(child =>
        let arg_val = arg_value(n: child)
        match arg_val.expr_data {
          ExprLambda =>
            if source_type != "" {
              let lparams = lambda_param_names_at(texpr: arg_val, source_indices: ctx.type_env.source_indices)
              let p1 = match lparams |> first { Present { value: n } => n  Absent => "" }
              let p2 = match lparams |> skip(1) |> first { Present { value: n } => n  Absent => "" }
              let lambda_ctx = DescentContext {
                fn_name: ctx.fn_name,
                param_names: if p2 != "" { map_insert(map_insert(ctx.param_names, p1, source_type), p2, source_type) }
                  else if p1 != "" { map_insert(ctx.param_names, p1, source_type) }
                  else { ctx.param_names },
                param_order: ctx.param_order, type_env: ctx.type_env,
                sub_value_vars: if p1 != "" {
                  let source_fields = inductive_fields_for(env: ctx.type_env, type_name: source_type)
                  let cf = source_fields |> filter(f => match f.shape { ListRecursion => true  _ => false }) |> first
                  let rel = match cf { Present { value: f } => IteratedSubValue { field: f }  Absent => PreservedValue }
                  if p2 != "" { map_insert(map_insert(ctx.sub_value_vars, p1, rel), p2, rel) }
                  else { map_insert(ctx.sub_value_vars, p1, rel) }
                } else { ctx.sub_value_vars },
                size_aliases: ctx.size_aliases,
                scope_locals: ctx.scope_locals, func_env: ctx.func_env,
                per_field_vars: ctx.per_field_vars
              }
              make_arg_node(name: arg_name_at(n: child, source_indices: ctx.type_env.source_indices), value: annotate_descent(body: arg_val, ctx: lambda_ctx), span: child.span, name_span: child.span)
            } else {
              make_arg_node(name: arg_name_at(n: child, source_indices: ctx.type_env.source_indices), value: annotate_descent(body: arg_val, ctx: ctx), span: child.span, name_span: child.span)
            }
          _ => make_arg_node(name: arg_name_at(n: child, source_indices: ctx.type_env.source_indices), value: annotate_descent(body: arg_val, ctx: ctx), span: child.span, name_span: child.span)
        }
      )
      Node {
        name: body.name, span: body.span, ident_span: body.ident_span,
        children: annotated_children, connective: body.connective, params: body.params,
        inferred: body.inferred, return_cardinality: body.return_cardinality,
        uses: body.uses, body: body.body, transport: body.transport,
        properties: body.properties, type_annotation: body.type_annotation,
        is_self_recursive: body.is_self_recursive,
        has_non_tail_self_call: body.has_non_tail_self_call,
        match_pattern: body.match_pattern,
        expr_data: ExprCall { call_semantics: cs, descent_evidence: Present { value: evidence } }
      }
    ExprMatch =>
      let scrut = match_scrutinee(texpr: body)
      let scrut_type = match scrut.expr_data {
        ExprVar { binding_kind: _ } =>
          let sname = expr_var_name_at(texpr: scrut, source_indices: ctx.type_env.source_indices)
          match map_get(ctx.param_names, sname) {
            Present { value: t } => t
            Absent =>
              match map_get(ctx.sub_value_vars, sname) {
                Present { value: rel } =>
                  match rel {
                    StrictSubValue { field: f, factor: _ } => f.element_type
                    IteratedSubValue { field: f } => f.element_type
                    _ => ""
                  }
                Absent => ""
              }
          }
        _ =>

          ""
      }
      let scrut_inducing_field = match scrut.expr_data {
        ExprFieldAccess { summary: _ } =>
          let base = field_access_base(texpr: scrut)
          let fname = field_access_field_at(texpr: scrut, source_indices: ctx.type_env.source_indices)
          match base.expr_data {
            ExprVar { binding_kind: _ } =>
              let bname = expr_var_name_at(texpr: base, source_indices: ctx.type_env.source_indices)
              let base_type = match map_get(ctx.param_names, bname) {
                Present { value: t } => t
                Absent => ""
              }
              if base_type != "" {
                let ind_fields = inductive_fields_for(env: ctx.type_env, type_name: base_type)
                ind_fields |> filter(f => f.field_name == fname) |> first
              } else { none }
            _ => none
          }
        ExprMethodCall { method_semantics: _ } =>
          let mname = expr_method_name_at(texpr: scrut, source_indices: ctx.type_env.source_indices)
          if mname == "first" || mname == "last" {
            let receiver = method_receiver(texpr: scrut)
            resolve_collection_field(expr: receiver, ctx: ctx)
          } else { none }
        _ => none
      }
      let scrut_has_inductive = (scrut_type != "" && inductive_fields_for(env: ctx.type_env, type_name: scrut_type) |> count > 0) || scrut_inducing_field != none

      let scrut_variant_sig = match scrut.expr_data {
        ExprCall { call_semantics: _, descent_evidence: _ } =>
          let callee = expr_call_func_at(texpr: scrut, source_indices: ctx.type_env.source_indices)
          match func_sig_if_resolved(lookup: lookup_func_sig(func_env: ctx.func_env, type_env: ctx.type_env, name: callee)) {
            Present { value: sig } =>
              if map_keys(sig.variant_provenance) |> count > 0 { Present { value: sig } }
              else { none }
            Absent => none
          }
        _ => none
      }
      let annotated_scrut = annotate_descent(body: scrut, ctx: ctx)
      let annotated_arms = match_arm_nodes(texpr: body) |> map(arm_node =>
        let variant_arm_ctx = match scrut_variant_sig {
          Present { value: sig } =>
            arm_ctx_from_variant_provenance(arm_node: arm_node, sig: sig, scrut: scrut, ctx: ctx)
          Absent => none
        }
        let arm_ctx = match variant_arm_ctx {
          Present { value: c } => c
          Absent =>
        if scrut_has_inductive {
          match arm_pattern(n: arm_node) {
            VariantPattern { name: vname, parent_enum: _, field_bindings: bindings } =>
              match scrut_inducing_field {
                Present { value: ind_field } =>
                  if vname == "Present" {
                    bindings |> fold(init: ctx, f: (c, fb) =>
                      match field_binding_pattern(n: fb) {
                        Bind { declaration: declaration } =>
                          DescentContext {
                            fn_name: c.fn_name,
                            param_names: map_insert(c.param_names, declaration.name, ind_field.element_type),
                            param_order: c.param_order, type_env: c.type_env,
                            sub_value_vars: map_insert(c.sub_value_vars, declaration.name, StrictSubValue { field: ind_field, factor: UnitShrink }),
                            size_aliases: c.size_aliases,
                            scope_locals: c.scope_locals, func_env: c.func_env,
                            per_field_vars: c.per_field_vars
                          }
                        VariantPattern { name: inner_vname, parent_enum: _, field_bindings: inner_bindings } =>
                          let inner_ind_fields = inductive_fields_for(env: c.type_env, type_name: ind_field.element_type)
                          inner_bindings |> fold(init: c, f: (ic, inner_fb) =>
                            let inner_field_name = field_binding_name_at(n: inner_fb, source_indices: ctx.type_env.source_indices)
                            let inner_bind_name = match field_binding_pattern(n: inner_fb) {
                              Bind { declaration: declaration } => declaration.name
                              _ => ""
                            }
                            let inner_matching = inner_ind_fields |> filter(f => f.variant_name == inner_vname && f.field_name == inner_field_name) |> first
                            match inner_matching {
                              Present { value: inner_ind_field } =>
                                if inner_bind_name != "" {
                                  DescentContext {
                                    fn_name: ic.fn_name,
                                    param_names: map_insert(ic.param_names, inner_bind_name, inner_ind_field.element_type),
                                    param_order: ic.param_order, type_env: ic.type_env,
                                    sub_value_vars: map_insert(ic.sub_value_vars, inner_bind_name, StrictSubValue { field: inner_ind_field, factor: UnitShrink }),
                                    size_aliases: ic.size_aliases,
                                    scope_locals: ic.scope_locals, func_env: ic.func_env,
                                    per_field_vars: ic.per_field_vars
                                  }
                                } else { ic }
                              Absent => ic
                            }
                          )
                        _ => c
                      }
                    )
                  } else { ctx }
                Absent =>
                  let ind_fields = inductive_fields_for(env: ctx.type_env, type_name: scrut_type)
                  bindings |> fold(init: ctx, f: (c, fb) =>
                    let field_name = field_binding_name_at(n: fb, source_indices: ctx.type_env.source_indices)
                    let bind_name = match field_binding_pattern(n: fb) {
                      Bind { declaration: declaration } => declaration.name
                      _ => ""
                    }
                    let matching = ind_fields |> filter(f => f.variant_name == vname && f.field_name == field_name) |> first
                    match matching {
                      Present { value: ind_field } =>
                        if bind_name != "" {
                          DescentContext {
                            fn_name: c.fn_name, param_names: c.param_names, param_order: c.param_order, type_env: c.type_env,
                            sub_value_vars: map_insert(c.sub_value_vars, bind_name, StrictSubValue { field: ind_field, factor: UnitShrink }),
                            size_aliases: c.size_aliases,
                            scope_locals: c.scope_locals, func_env: c.func_env,
                            per_field_vars: c.per_field_vars
                          }
                        } else { c }
                      Absent => c
                    }
                  )
              }
            Bind { declaration: declaration } =>
              if scrut_type != "" {
                DescentContext {
                  fn_name: ctx.fn_name,
                  param_names: map_insert(ctx.param_names, declaration.name, scrut_type),
                  param_order: ctx.param_order, type_env: ctx.type_env,
                  sub_value_vars: map_insert(ctx.sub_value_vars, declaration.name, PreservedValue),
                  size_aliases: ctx.size_aliases,
                  scope_locals: ctx.scope_locals, func_env: ctx.func_env,
                  per_field_vars: ctx.per_field_vars
                }
              } else {
                match scrut_inducing_field {
                  Present { value: ind_field } =>
                    DescentContext {
                      fn_name: ctx.fn_name,
                      param_names: map_insert(ctx.param_names, declaration.name, ind_field.element_type),
                      param_order: ctx.param_order, type_env: ctx.type_env,
                      sub_value_vars: map_insert(ctx.sub_value_vars, declaration.name, StrictSubValue { field: ind_field, factor: UnitShrink }),
                      size_aliases: ctx.size_aliases,
                      scope_locals: ctx.scope_locals, func_env: ctx.func_env,
                      per_field_vars: ctx.per_field_vars
                    }
                  Absent => ctx
                }
              }
            _ => ctx
          }
        } else { ctx }
        }
        let annotated_body = annotate_descent(body: arm_body(n: arm_node), ctx: arm_ctx)
        make_arm_node(pattern: arm_pattern(n: arm_node), guard: arm_guard(n: arm_node), body: annotated_body, span: arm_node.span)
      )
      Node {
        name: body.name, span: body.span, ident_span: body.ident_span,
        children: concat([annotated_scrut], annotated_arms),
        connective: body.connective, params: body.params,
        inferred: body.inferred, return_cardinality: body.return_cardinality,
        uses: body.uses, body: body.body, transport: body.transport,
        properties: body.properties, type_annotation: body.type_annotation,
        is_self_recursive: body.is_self_recursive,
        has_non_tail_self_call: body.has_non_tail_self_call,
        match_pattern: body.match_pattern, expr_data: body.expr_data
      }
    ExprLet =>
      let val = let_value(texpr: body)
      let binding_name = let_binding_name_at(texpr: body, source_indices: ctx.type_env.source_indices)
      let val_relation = classify_let_value(val: val, ctx: ctx)
      let size_alias = classify_size_expr(val: val, ctx: ctx)
      let inner_size_aliases = match size_alias {
        Present { value: se } => map_insert(ctx.size_aliases, binding_name, se)
        Absent => ctx.size_aliases
      }
      let inner_per_field = build_per_field_for_let(val: val, binding_name: binding_name, ctx: ctx)
      let inner_ctx = match val_relation {
        Present { value: rel } =>
          let sub_type = match rel {
            StrictSubValue { field: f, factor: _ } => f.element_type
            IteratedSubValue { field: f } => f.element_type
            _ => ""
          }
          DescentContext {
            fn_name: ctx.fn_name,
            param_names: if sub_type != "" { map_insert(ctx.param_names, binding_name, sub_type) } else { ctx.param_names },
            param_order: ctx.param_order, type_env: ctx.type_env,
            sub_value_vars: map_insert(ctx.sub_value_vars, binding_name, rel),
            size_aliases: inner_size_aliases,
            scope_locals: map_insert(ctx.scope_locals, binding_name, TypeBinding { name: binding_name, resolved: resolved_type(n: val), provenance: rel }),
            func_env: ctx.func_env,
            per_field_vars: inner_per_field
          }
        Absent =>
          DescentContext {
            fn_name: ctx.fn_name, param_names: ctx.param_names, param_order: ctx.param_order, type_env: ctx.type_env,
            sub_value_vars: ctx.sub_value_vars,
            size_aliases: inner_size_aliases,
            scope_locals: map_insert(ctx.scope_locals, binding_name, TypeBinding { name: binding_name, resolved: resolved_type(n: val), provenance: SubValueUnknown }),
            func_env: ctx.func_env,
            per_field_vars: inner_per_field
          }
      }
      let annotated_value = annotate_descent(body: val, ctx: ctx)
      let annotated_children = match let_body(texpr: body) {
        Present { value: body_child } => [annotated_value, annotate_descent(body: body_child, ctx: inner_ctx)]
        Absent => [annotated_value]
      }
      Node {
        name: body.name, span: body.span, ident_span: body.ident_span,
        children: annotated_children, connective: body.connective, params: body.params,
        inferred: body.inferred, return_cardinality: body.return_cardinality,
        uses: body.uses, body: body.body, transport: body.transport,
        properties: body.properties, type_annotation: body.type_annotation,
        is_self_recursive: body.is_self_recursive,
        has_non_tail_self_call: body.has_non_tail_self_call,
        match_pattern: body.match_pattern, expr_data: body.expr_data
      }
    ExprBlock =>
      let threaded = body.children |> fold(init: BlockAnnotateAcc { ctx: ctx, children: [] }, f: (acc, child) =>
        let annotated = annotate_descent(body: child, ctx: acc.ctx)
        let next_ctx = match child.expr_data {
          ExprLet =>
            let val = let_value(texpr: child)
            let bname = let_binding_name_at(texpr: child, source_indices: ctx.type_env.source_indices)
            let val_rel = classify_let_value(val: val, ctx: acc.ctx)
            let sa = classify_size_expr(val: val, ctx: acc.ctx)
            let new_sa = match sa {
              Present { value: se } => map_insert(acc.ctx.size_aliases, bname, se)
              Absent => acc.ctx.size_aliases
            }
            match val_rel {
              Present { value: rel } =>
                let sub_type = match rel {
                  StrictSubValue { field: f, factor: _ } => f.element_type
                  IteratedSubValue { field: f } => f.element_type
                  _ => ""
                }
                DescentContext {
                  fn_name: acc.ctx.fn_name,
                  param_names: if sub_type != "" { map_insert(acc.ctx.param_names, bname, sub_type) } else { acc.ctx.param_names },
                  param_order: acc.ctx.param_order, type_env: acc.ctx.type_env,
                  sub_value_vars: map_insert(acc.ctx.sub_value_vars, bname, rel),
                  size_aliases: new_sa,
                  scope_locals: map_insert(acc.ctx.scope_locals, bname, TypeBinding { name: bname, resolved: resolved_type(n: val), provenance: rel }),
                  func_env: acc.ctx.func_env,
                  per_field_vars: acc.ctx.per_field_vars
                }
              Absent =>
                DescentContext {
                  fn_name: acc.ctx.fn_name, param_names: acc.ctx.param_names, param_order: acc.ctx.param_order, type_env: acc.ctx.type_env,
                  sub_value_vars: acc.ctx.sub_value_vars,
                  size_aliases: new_sa,
                  scope_locals: map_insert(acc.ctx.scope_locals, bname, TypeBinding { name: bname, resolved: resolved_type(n: val), provenance: SubValueUnknown }),
                  func_env: acc.ctx.func_env,
                  per_field_vars: acc.ctx.per_field_vars
                }
            }
          _ => acc.ctx
        }
        BlockAnnotateAcc { ctx: next_ctx, children: concat(acc.children, [annotated]) }
      )
      Node {
        name: body.name, span: body.span, ident_span: body.ident_span,
        children: threaded.children, connective: body.connective, params: body.params,
        inferred: body.inferred, return_cardinality: body.return_cardinality,
        uses: body.uses, body: body.body, transport: body.transport,
        properties: body.properties, type_annotation: body.type_annotation,
        is_self_recursive: body.is_self_recursive,
        has_non_tail_self_call: body.has_non_tail_self_call,
        match_pattern: body.match_pattern, expr_data: body.expr_data
      }
    ExprMethodCall { method_semantics: ms } =>
      let mname = expr_method_name_at(texpr: body, source_indices: ctx.type_env.source_indices)
      let elem_position = method_callback_element_position(semantics: ms)
      if elem_position != none {
        let raw_receiver = method_receiver(texpr: body)
        let receiver = match raw_receiver.expr_data {
          ExprMethodCall { method_semantics: _ } =>
            let inner_mname = expr_method_name_at(texpr: raw_receiver, source_indices: ctx.type_env.source_indices)
            if inner_mname == "enumerate" { method_receiver(texpr: raw_receiver) } else { raw_receiver }
          _ => raw_receiver
        }
        let receiver_field = match receiver.expr_data {
          ExprFieldAccess { summary: _ } =>
            let base = field_access_base(texpr: receiver)
            let fname = field_access_field_at(texpr: receiver, source_indices: ctx.type_env.source_indices)
            match base.expr_data {
              ExprVar { binding_kind: _ } =>
                let bname = expr_var_name_at(texpr: base, source_indices: ctx.type_env.source_indices)
                let base_type = match map_get(ctx.param_names, bname) {
                  Present { value: t } => t
                  Absent =>
                    match map_get(ctx.sub_value_vars, bname) {
                      Present { value: rel } =>
                        match rel {
                          StrictSubValue { field: f, factor: _ } => f.element_type
                          IteratedSubValue { field: f } => f.element_type
                          _ => ""
                        }
                      Absent => ""
                    }
                }
                if base_type != "" {
                  inductive_fields_for(env: ctx.type_env, type_name: base_type) |> filter(f => f.field_name == fname) |> first
                } else { none }
              _ => none
            }
          ExprVar { binding_kind: _ } =>
            let rname = expr_var_name_at(texpr: receiver, source_indices: ctx.type_env.source_indices)
            match map_get(ctx.sub_value_vars, rname) {
              Present { value: rel } =>
                match rel {
                  StrictSubValue { field: f, factor: _ } =>
                    match f.shape { ListRecursion => Present { value: f }  _ => none }
                  IteratedSubValue { field: f } =>
                    match f.shape { ListRecursion => Present { value: f }  _ => none }
                  _ => none
                }
              Absent => none
            }
          _ => none
        }
        let method_args = method_arg_nodes(texpr: body)
        let lambda_arg = method_args |> filter(a =>
          match arg_value(n: a).expr_data { ExprLambda => true  _ => false }
        ) |> first
        let lambda_elem_info = match lambda_arg {
          Present { value: la } =>
            let lambda_node = arg_value(n: la)
            let lparams = lambda_param_names_at(texpr: lambda_node, source_indices: ctx.type_env.source_indices)
            lparams |> skip(elem_position.value) |> first
          Absent => none
        }

        let is_fold = elem_position.value > 0
        let inner_ctx = match lambda_elem_info {
          Present { value: elem_name } =>
            match receiver_field {
              Present { value: ind_field } =>
                DescentContext {
                  fn_name: ctx.fn_name,
                  param_names: map_insert(ctx.param_names, elem_name, ind_field.element_type),
                  param_order: ctx.param_order, type_env: ctx.type_env,
                  sub_value_vars: if is_fold { map_insert(empty_map(), elem_name, IteratedSubValue { field: ind_field }) }
                    else { map_insert(ctx.sub_value_vars, elem_name, IteratedSubValue { field: ind_field }) },
                  size_aliases: ctx.size_aliases,
                  scope_locals: ctx.scope_locals, func_env: ctx.func_env,
                  per_field_vars: ctx.per_field_vars
                }
              Absent =>
                DescentContext {
                  fn_name: ctx.fn_name, param_names: ctx.param_names,
                  param_order: ctx.param_order, type_env: ctx.type_env,
                  sub_value_vars: if is_fold { empty_map() } else { ctx.sub_value_vars },
                  size_aliases: ctx.size_aliases,
                  scope_locals: ctx.scope_locals, func_env: ctx.func_env,
                  per_field_vars: ctx.per_field_vars
                }
            }
          Absent => ctx
        }
        let annotated_receiver = annotate_descent(body: method_receiver(texpr: body), ctx: ctx)
        let annotated_args = method_arg_nodes(texpr: body) |> map(arg_node =>
          let arg_val = arg_value(n: arg_node)
          let is_lambda = match arg_val.expr_data { ExprLambda => true  _ => false }
          if is_lambda {
            make_arg_node(name: match arg_name_at(n: arg_node, source_indices: ctx.type_env.source_indices) { Present { value: n } => Present { value: n }  Absent => none }, value: annotate_descent(body: arg_val, ctx: inner_ctx), span: arg_node.span, name_span: arg_node.span)
          } else {
            make_arg_node(name: match arg_name_at(n: arg_node, source_indices: ctx.type_env.source_indices) { Present { value: n } => Present { value: n }  Absent => none }, value: annotate_descent(body: arg_val, ctx: ctx), span: arg_node.span, name_span: arg_node.span)
          }
        )
        Node {
          name: body.name, span: body.span, ident_span: body.ident_span,
          children: concat([annotated_receiver], annotated_args),
          connective: body.connective, params: body.params,
          inferred: body.inferred, return_cardinality: body.return_cardinality,
          uses: body.uses, body: body.body, transport: body.transport,
          properties: body.properties, type_annotation: body.type_annotation,
          is_self_recursive: body.is_self_recursive,
          has_non_tail_self_call: body.has_non_tail_self_call,
          match_pattern: body.match_pattern, expr_data: body.expr_data
        }
      } else {
        map_children(node: body, transform: child => annotate_descent(body: child, ctx: ctx))
      }
    ExprForEach =>
      let coll = foreach_collection(texpr: body)
      let fe_body = foreach_body(texpr: body)
      let fe_var = foreach_variable_at(texpr: body, source_indices: ctx.type_env.source_indices)
      let coll_field = resolve_collection_field(expr: coll, ctx: ctx)
      let inner_ctx = match coll_field {
        Present { value: ind_field } =>
          DescentContext {
            fn_name: ctx.fn_name,
            param_names: map_insert(ctx.param_names, fe_var, ind_field.element_type),
            param_order: ctx.param_order, type_env: ctx.type_env,
            sub_value_vars: map_insert(empty_map(), fe_var, IteratedSubValue { field: ind_field }),
            size_aliases: ctx.size_aliases,
            scope_locals: ctx.scope_locals, func_env: ctx.func_env,
            per_field_vars: ctx.per_field_vars
          }
        Absent =>
          DescentContext {
            fn_name: ctx.fn_name, param_names: ctx.param_names,
            param_order: ctx.param_order, type_env: ctx.type_env,
            sub_value_vars: empty_map(),
            size_aliases: ctx.size_aliases,
            scope_locals: ctx.scope_locals, func_env: ctx.func_env,
            per_field_vars: ctx.per_field_vars
          }
      }
      let annotated_coll = annotate_descent(body: coll, ctx: ctx)
      let annotated_body = annotate_descent(body: fe_body, ctx: inner_ctx)
      Node {
        name: body.name, span: body.span, ident_span: body.ident_span,
        children: [annotated_coll, annotated_body], connective: body.connective, params: body.params,
        inferred: body.inferred, return_cardinality: body.return_cardinality,
        uses: body.uses, body: body.body, transport: body.transport,
        properties: body.properties, type_annotation: body.type_annotation,
        is_self_recursive: body.is_self_recursive,
        has_non_tail_self_call: body.has_non_tail_self_call,
        match_pattern: body.match_pattern, expr_data: body.expr_data
      }
    _ =>
      map_children(node: body, transform: child => annotate_descent(body: child, ctx: ctx))
  }
}

fn resolved_type_name(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  match n.inferred {
    Present { value: Resolved { node: rt } } => authored_name_at(source_indices: source_indices, node: rt)
    _ =>
      match n.children |> first {
        Present { value: c } => authored_name_at(source_indices: source_indices, node: c)
        Absent => ""
      }
  }
}

fn infer_output_provenance(body: Node, params: List<Node>, type_env: TypeEnv, scope_locals: Map<String, TypeBinding>, func_env: ResolvedFuncEnv) -> List<Map<String, SubValueRelation>> {
  let param_names = params |> map(p => param_node_name_at(n: p, source_indices: type_env.source_indices))
  let param_types = fold(params, init: empty_map(), f: (acc, p) =>
    let pname = param_node_name_at(n: p, source_indices: type_env.source_indices)
    let ptype = resolved_type_name(n: p, source_indices: type_env.source_indices)
    if pname != "" && ptype != "" { map_insert(acc, pname, ptype) } else { acc }
  )

  let scalar = classify_body_provenance(
    expr: body, param_names: param_names, param_types: param_types,
    type_env: type_env, func_env: func_env, let_prov: empty_map()
  )
  if map_keys(scalar) |> count > 0 { [scalar] }
  else {
    let per_field = classify_body_per_field(
      expr: body, param_names: param_names, param_types: param_types,
      type_env: type_env, func_env: func_env, let_prov: empty_map()
    )
    if per_field |> count > 0 && per_field |> any(m => map_keys(m) |> count > 0) {
      per_field
    } else { [] }
  }
}

fn classify_body_provenance(expr: Node, param_names: List<String>, param_types: Map<String, String>, type_env: TypeEnv, func_env: ResolvedFuncEnv, let_prov: Map<String, Map<String, SubValueRelation>>) -> Map<String, SubValueRelation> {
  match expr.expr_data {
    ExprVar { binding_kind: _ } =>
      let vname = expr_var_name_at(texpr: expr, source_indices: type_env.source_indices)
      match map_get(let_prov, vname) {
        Present { value: prov } => prov
        Absent =>
          if param_names |> any(pn => pn == vname) {
            map_insert(empty_map(), vname, PreservedValue)
          } else {
            empty_map()
          }
      }

    ExprFieldAccess { summary: _ } =>
      let base = field_access_base(texpr: expr)
      let field = field_access_field_at(texpr: expr, source_indices: type_env.source_indices)
      let base_prov = classify_body_provenance(expr: base, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
      fold(base_prov |> map_keys, init: empty_map(), f: (acc, pname) =>
        match map_get(base_prov, pname) {
          Present { value: base_rel } =>
            let type_for_lookup = match base_rel {
              PreservedValue => match map_get(param_types, pname) { Present { value: t } => t  Absent => "" }
              StrictSubValue { field: f, factor: _ } => f.element_type
              IteratedSubValue { field: f } => f.element_type
              _ => ""
            }
            if type_for_lookup != "" {
              let fields = inductive_fields_for(env: type_env, type_name: type_for_lookup)
              let matching = fields |> filter(f => f.field_name == field) |> first
              match matching {
                Present { value: ind_field } => map_insert(acc, pname, compose_sub_value(base: base_rel, field: ind_field))
                Absent => acc
              }
            } else { acc }
          Absent => acc
        }
      )

    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let callee = expr_call_func_at(texpr: expr, source_indices: type_env.source_indices)
      compose_callee_provenance(callee: callee, arg_by_name: call_args_by_name(call: expr, source_indices: type_env.source_indices), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)

    ExprMethodCall { method_semantics: ms } =>
      let mname = expr_method_name_at(texpr: expr, source_indices: type_env.source_indices)
      let callee_result = compose_callee_provenance(callee: mname, arg_by_name: method_call_args_by_name(call: expr, func_env: func_env, type_env: type_env, source_indices: type_env.source_indices), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
      if map_keys(callee_result) |> count > 0 { callee_result }
      else {
        let is_shrink = match ms {
          Present { value: AlgebraMethodSemantics { method_def: _, fold_accumulator_type: _, size_effect: se, cost_shape: _, algebra_template: _ } } =>
            match se { Present { value: ShrinkEffect } => true  _ => false }
          _ => false
        }
        if is_shrink
          && match method_arg_nodes(texpr: expr) |> first {
            Present { value: arg_node } =>
              match expr_literal_int_optional(expr: arg_value(n: arg_node)) {
                Present { value: n } => n > 0
                Absent => false
              }
            Absent => false
          }
        {
          let recv = method_receiver(texpr: expr)
          let recv_prov = classify_body_provenance(expr: recv, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
          fold(map_keys(recv_prov), init: empty_map(), f: (acc, pname) =>
            match map_get(recv_prov, pname) {
              Present { value: recv_rel } =>
                let synth_field = InductiveField { type_name: pname, variant_name: "", field_name: mname, shape: ListRecursion, element_type: pname }
                map_insert(acc, pname, compose_sub_value(base: recv_rel, field: synth_field))
              Absent => acc
            }
          )
        } else { empty_map() }
      }

    ExprMatch =>
      let scrut = match_scrutinee(texpr: expr)
      let scrut_prov = classify_body_provenance(expr: scrut, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
      let arms = match_arm_nodes(texpr: expr)
      let arm_provs = arms |> map(arm =>

        let arm_let_prov = match arm_pattern(n: arm) {
          VariantPattern { name: vname, parent_enum: _, field_bindings: bindings } =>
            fold(bindings, init: let_prov, f: (acc, binding) =>
              let field_label = field_binding_name_at(n: binding, source_indices: type_env.source_indices)
              let bind_name = match field_binding_pattern(n: binding) {
                Bind { declaration: declaration } => declaration.name
                _ => ""
              }
              if bind_name != "" && field_label != "" {
                let field_prov = fold(map_keys(scrut_prov), init: empty_prov_map(), f: (fp_acc, pname) =>
                  maybe_insert_match_field_relation(fp_acc: fp_acc, pname: pname, field_label: field_label, vname: vname, scrut_rel: map_get(scrut_prov, pname), param_types: param_types, type_env: type_env)
                )
                map_insert(acc, bind_name, field_prov)
              } else { acc }
            )
          Bind { declaration: declaration } =>
            map_insert(let_prov, declaration.name, scrut_prov)
          _ => let_prov
        }
        classify_body_provenance(expr: arm_body(n: arm), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: arm_let_prov)
      )
      meet_body_provenance_maps(provs: arm_provs)

    ExprIf =>
      let then_prov = classify_body_provenance(expr: if_then_branch(texpr: expr), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
      match if_else_branch(texpr: expr) {
        Present { value: else_expr } =>
          let else_prov = classify_body_provenance(expr: else_expr, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
          meet_body_provenance_maps(provs: [then_prov, else_prov])
        Absent => then_prov
      }

    ExprLet =>
      let value = let_value(texpr: expr)
      let bname = let_binding_name_at(texpr: expr, source_indices: type_env.source_indices)
      let value_prov = classify_body_provenance(expr: value, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
      let updated = map_insert(let_prov, bname, value_prov)
      match let_body(texpr: expr) {
        Present { value: body } =>
          classify_body_provenance(expr: body, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: updated)
        Absent => empty_map()
      }

    ExprBlock =>
      let block_result = fold(expr.children, init: BlockProvFoldState { prov: let_prov, last: empty_prov_map() }, f: (state, stmt) =>
        match stmt.expr_data {
          ExprLet =>
            let bname = let_binding_name_at(texpr: stmt, source_indices: type_env.source_indices)
            let value = let_value(texpr: stmt)
            let value_prov = classify_body_provenance(expr: value, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: state.prov)
            let updated_prov = map_insert(state.prov, bname, value_prov)
            match let_body(texpr: stmt) {
              Present { value: body } =>
                BlockProvFoldState { prov: state.prov, last: classify_body_provenance(expr: body, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: updated_prov) }
              Absent =>
                BlockProvFoldState { prov: updated_prov, last: value_prov }
            }
          _ =>
            BlockProvFoldState { prov: state.prov, last: classify_body_provenance(expr: stmt, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: state.prov) }
        }
      )
      block_result.last

    ExprCast =>
      classify_body_provenance(expr: cast_expr(texpr: expr), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)

    ExprReturn =>
      match expr.children |> first {
        Present { value: inner } =>
          classify_body_provenance(expr: inner, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
        Absent => empty_map()
      }

    _ => empty_map()
  }
}

type BlockProvFoldState {
  prov: Map<String, Map<String, SubValueRelation>>
  last: Map<String, SubValueRelation>
}

fn call_args_by_name(call: Node, source_indices: Map<String, NewlineIndex>) -> Map<String, Node> {
  fold(call.children, init: empty_map(), f: (acc, arg_node) =>
    match arg_name_at(n: arg_node, source_indices: source_indices) {
      Present { value: aname } => map_insert(acc, aname, arg_value(n: arg_node))
      Absent => acc
    }
  )
}

fn method_call_args_by_name(call: Node, func_env: ResolvedFuncEnv, type_env: TypeEnv, source_indices: Map<String, NewlineIndex>) -> Map<String, Node> {
  let mname = expr_method_name_at(texpr: call, source_indices: source_indices)
  let recv = method_receiver(texpr: call)
  let mc_args = method_arg_nodes(texpr: call)
  let base = match func_sig_if_resolved(lookup: lookup_func_sig(func_env: func_env, type_env: type_env, name: mname)) {
    Present { value: sig } =>
      match sig.params |> first {
        Present { value: first_p } =>
          let first_pname = param_node_name_at(n: first_p, source_indices: source_indices)
          if first_pname != "" { map_insert(empty_map(), first_pname, recv) } else { empty_map() }
        Absent => empty_map()
      }
    Absent => empty_map()
  }
  fold(mc_args, init: base, f: (acc, arg_node) =>
    match arg_name_at(n: arg_node, source_indices: source_indices) {
      Present { value: aname } => map_insert(acc, aname, arg_value(n: arg_node))
      Absent => acc
    }
  )
}

fn compose_callee_provenance(callee: String, arg_by_name: Map<String, Node>, param_names: List<String>, param_types: Map<String, String>, type_env: TypeEnv, func_env: ResolvedFuncEnv, let_prov: Map<String, Map<String, SubValueRelation>>) -> Map<String, SubValueRelation> {
  match func_sig_if_resolved(lookup: lookup_func_sig(func_env: func_env, type_env: type_env, name: callee)) {
    Present { value: sig } =>
      match sig.output_provenance |> first {
        Present { value: callee_prov } =>
          fold(callee_prov |> map_keys, init: empty_map(), f: (acc, callee_pname) =>
            match map_get(callee_prov, callee_pname) {
              Present { value: callee_rel } =>
                match map_get(arg_by_name, callee_pname) {
                  Present { value: arg } =>
                    let arg_prov = classify_body_provenance(expr: arg, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
                    fold(arg_prov |> map_keys, init: acc, f: (inner, pname) =>
                      match map_get(arg_prov, pname) {
                        Present { value: arg_rel } =>
                          let composed = compose_sub_value_relations(arg_rel: arg_rel, callee_rel: callee_rel)
                          match composed { SubValueUnknown => inner  _ =>
                            match map_get(inner, pname) {
                              Present { value: existing } => map_insert(inner, pname, meet_sub_value(a: existing, b: composed))
                              Absent => map_insert(inner, pname, composed)
                            }
                          }
                        Absent => inner
                      }
                    )
                  Absent => acc
                }
              Absent => acc
            }
          )
        Absent => empty_map()
      }
    Absent => empty_map()
  }
}

fn classify_body_per_field(expr: Node, param_names: List<String>, param_types: Map<String, String>, type_env: TypeEnv, func_env: ResolvedFuncEnv, let_prov: Map<String, Map<String, SubValueRelation>>) -> List<Map<String, SubValueRelation>> {
  let unwrapped = unwrap_body_terminal(expr: expr, let_prov: let_prov, type_env: type_env)
  let terminal = unwrapped.expr
  let terminal_prov = unwrapped.let_prov
  classify_terminal_per_field(expr: terminal, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: terminal_prov)
}

fn classify_terminal_per_field(expr: Node, param_names: List<String>, param_types: Map<String, String>, type_env: TypeEnv, func_env: ResolvedFuncEnv, let_prov: Map<String, Map<String, SubValueRelation>>) -> List<Map<String, SubValueRelation>> {
  match expr.expr_data {
    ExprRecordLit { parent_enum: _ } =>
      expr.children |> map(fi =>
        classify_body_provenance(expr: field_init_node_value(n: fi), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
      )
    ExprMatch =>
      let arm_results = match_arm_nodes(texpr: expr) |> map(arm =>
        let arm_unwrapped = unwrap_body_terminal(expr: arm_body(n: arm), let_prov: let_prov, type_env: type_env)
        match arm_unwrapped.expr.expr_data {
          ExprRecordLit { parent_enum: _ } =>
            arm_unwrapped.expr.children |> map(fi =>
              classify_body_provenance(expr: field_init_node_value(n: fi), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: arm_unwrapped.let_prov)
            )
          _ => []
        }
      )
      meet_per_field_results(results: arm_results)
    ExprIf =>
      let then_unwrapped = unwrap_body_terminal(expr: if_then_branch(texpr: expr), let_prov: let_prov, type_env: type_env)
      let then_result = match then_unwrapped.expr.expr_data {
        ExprRecordLit { parent_enum: _ } =>
          then_unwrapped.expr.children |> map(fi =>
            classify_body_provenance(expr: field_init_node_value(n: fi), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: then_unwrapped.let_prov)
          )
        _ => []
      }
      match if_else_branch(texpr: expr) {
        Present { value: else_expr } =>
          let else_unwrapped = unwrap_body_terminal(expr: else_expr, let_prov: let_prov, type_env: type_env)
          let else_result = match else_unwrapped.expr.expr_data {
            ExprRecordLit { parent_enum: _ } =>
              else_unwrapped.expr.children |> map(fi =>
                classify_body_provenance(expr: field_init_node_value(n: fi), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: else_unwrapped.let_prov)
              )
            _ => []
          }
          meet_per_field_results(results: [then_result, else_result])
        Absent => then_result
      }
    _ => []
  }
}

type BodyTerminal {
  expr: Node
  let_prov: Map<String, Map<String, SubValueRelation>>
}

fn unwrap_body_terminal(expr: Node, let_prov: Map<String, Map<String, SubValueRelation>>, type_env: TypeEnv) -> BodyTerminal {
  match expr.expr_data {
    ExprBlock =>
      match expr.children |> last {
        Present { value: last_stmt } => BodyTerminal { expr: last_stmt, let_prov: let_prov }
        Absent => BodyTerminal { expr: expr, let_prov: let_prov }
      }
    _ => BodyTerminal { expr: expr, let_prov: let_prov }
  }
}

fn meet_per_field_results(results: List<List<Map<String, SubValueRelation>>>) -> List<Map<String, SubValueRelation>> {
  match results |> first {
    Absent => []
    Present { value: first_result } =>
      if first_result |> count == 0 { [] }
      else {
        let all_same_count = results |> all(r => r |> count == first_result |> count)
        if !all_same_count { [] }
        else {
          first_result |> enumerate |> map(pair =>
            let idx = pair.first
            let field_provs = results |> map(r =>
              match r |> skip(idx) |> first {
                Present { value: m } => m
                Absent => empty_prov_map()
              }
            )
            meet_body_provenance_maps(provs: field_provs)
          )
        }
      }
  }
}

fn empty_prov_map() -> Map<String, SubValueRelation> { empty_map() }

fn meet_body_provenance_maps(provs: List<Map<String, SubValueRelation>>) -> Map<String, SubValueRelation> {
  match provs |> first {
    Absent => empty_prov_map()
    Present { value: first_prov } =>
      provs |> skip(1) |> fold(init: first_prov, f: (acc, prov) =>
        intersect_prov_maps(a: acc, b: prov)
      )
  }
}

fn intersect_prov_maps(a: Map<String, SubValueRelation>, b: Map<String, SubValueRelation>) -> Map<String, SubValueRelation> {
  fold(map_keys(a), init: empty_prov_map(), f: (result, key) =>
    match map_get(b, key) {
      Present { value: b_rel } =>
        match map_get(a, key) {
          Present { value: a_rel } =>
            map_insert(result, key, meet_sub_value(a: a_rel, b: b_rel))
          Absent => result
        }
      Absent => result
    }
  )
}

fn arm_ctx_from_variant_provenance(arm_node: Node, sig: ResolvedFuncSig, scrut: Node, ctx: DescentContext) -> DescentContext? {
  match arm_pattern(n: arm_node) {
    VariantPattern { name: vname, parent_enum: _, field_bindings: bindings } =>
      match map_get(sig.variant_provenance, vname) {
        Present { value: variant_field_map } =>
          let call_args = call_args_by_name(call: scrut, source_indices: ctx.type_env.source_indices)
          let extended = bindings |> fold(init: ctx, f: (c, fb) =>
            let field_label = field_binding_name_at(n: fb, source_indices: ctx.type_env.source_indices)
            let bind_name = match field_binding_pattern(n: fb) { Bind { declaration: declaration } => declaration.name  _ => "" }
            if bind_name == "" || field_label == "" { c }
            else {
              match map_get(variant_field_map, field_label) {
                Present { value: param_map } =>
                  let composed = compose_callee_param_map(callee_prov: param_map, arg_by_name: call_args, param_names: c.param_order, param_types: c.param_names, type_env: c.type_env, func_env: c.func_env, let_prov: empty_map())
                  let all_rels = map_keys(composed) |> map(k => match map_get(composed, k) { Present { value: r } => r  Absent => SubValueUnknown })
                  let best = merge_argument_relations(rels: all_rels)
                  match best {
                    SubValueUnknown => c
                    _ => DescentContext { fn_name: c.fn_name, param_names: c.param_names, param_order: c.param_order, type_env: c.type_env, sub_value_vars: map_insert(c.sub_value_vars, bind_name, best), size_aliases: c.size_aliases, scope_locals: c.scope_locals, func_env: c.func_env, per_field_vars: c.per_field_vars }
                  }
                Absent => c
              }
            }
          )
          Present { value: extended }
        Absent => none
      }
    _ => none
  }
}

fn compose_callee_param_map(callee_prov: Map<String, SubValueRelation>, arg_by_name: Map<String, Node>, param_names: List<String>, param_types: Map<String, String>, type_env: TypeEnv, func_env: ResolvedFuncEnv, let_prov: Map<String, Map<String, SubValueRelation>>) -> Map<String, SubValueRelation> {
  fold(callee_prov |> map_keys, init: empty_map(), f: (acc, callee_pname) =>
    match map_get(callee_prov, callee_pname) {
      Present { value: callee_rel } =>
        match map_get(arg_by_name, callee_pname) {
          Present { value: arg } =>
            let arg_prov = classify_body_provenance(expr: arg, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
            fold(arg_prov |> map_keys, init: acc, f: (inner, pname) =>
              match map_get(arg_prov, pname) {
                Present { value: arg_rel } =>
                  let composed = compose_sub_value_relations(arg_rel: arg_rel, callee_rel: callee_rel)
                  match composed { SubValueUnknown => inner  _ => map_insert(inner, pname, composed) }
                Absent => inner
              }
            )
          Absent => acc
        }
      Absent => acc
    }
  )
}

fn compose_output_relations(arg_rel: SubValueRelation, callee_rel: SubValueRelation) -> SubValueRelation {
  compose_sub_value_relations(arg_rel: arg_rel, callee_rel: callee_rel)
}

fn compute_variant_provenance(body: Node, return_type: Node, params: List<Node>, type_env: TypeEnv, func_env: ResolvedFuncEnv) -> Map<String, Map<String, Map<String, SubValueRelation>>> {
  let rt_name = authored_name_at(source_indices: type_env.source_indices, node: return_type)
  let rt_def = lookup_type_by_name(env: type_env, name: rt_name)
  match rt_def {
    Present { value: def_node } =>
      match def_node.connective {
        Disj =>
          let param_names = params |> map(p => param_node_name_at(n: p, source_indices: type_env.source_indices))
          let param_types = fold(params, init: empty_map(), f: (acc, p) =>
            let pname = param_node_name_at(n: p, source_indices: type_env.source_indices)
            let ptype = resolved_type_name(n: p, source_indices: type_env.source_indices)
            if pname != "" && ptype != "" { map_insert(acc, pname, ptype) } else { acc }
          )
          collect_variant_constructors(body: body, parent_enum: rt_name, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: empty_map(), acc: empty_map())
        _ => empty_map()
      }
    Absent => empty_map()
  }
}

fn collect_variant_constructors(body: Node, parent_enum: String, param_names: List<String>, param_types: Map<String, String>, type_env: TypeEnv, func_env: ResolvedFuncEnv, let_prov: Map<String, Map<String, SubValueRelation>>, acc: Map<String, Map<String, Map<String, SubValueRelation>>>) -> Map<String, Map<String, Map<String, SubValueRelation>>> {
  match body.expr_data {
    ExprRecordLit { parent_enum: pe } =>
      match pe {
        Present { value: enum_name } =>
          if enum_name == parent_enum {
            let variant_name = body.name
            let field_prov_map = body.children |> fold(init: empty_map(), f: (m, fi) =>
              let fname = field_init_node_name_at(n: fi, source_indices: type_env.source_indices)
              let fprov = classify_body_provenance(expr: field_init_node_value(n: fi), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
              if fname != "" { map_insert(m, fname, fprov) } else { m }
            )
            match map_get(acc, variant_name) {
              Present { value: existing } =>
                let merged = merge_field_prov_maps(a: existing, b: field_prov_map)
                map_insert(acc, variant_name, merged)
              Absent => map_insert(acc, variant_name, field_prov_map)
            }
          } else { acc }
        Absent => acc
      }
    ExprCall { call_semantics: _, descent_evidence: _ } =>
      let callee = expr_call_func_at(texpr: body, source_indices: type_env.source_indices)
      match func_sig_if_resolved(lookup: lookup_func_sig(func_env: func_env, type_env: type_env, name: callee)) {
        Present { value: sig } =>
          if authored_name_at(source_indices: type_env.source_indices, node: sig.inferred) == parent_enum
            && (map_keys(sig.variant_provenance) |> count > 0) {
            let call_args = call_args_by_name(call: body, source_indices: type_env.source_indices)
            fold(map_keys(sig.variant_provenance), init: acc, f: (variant_acc, variant_name) =>
              match map_get(sig.variant_provenance, variant_name) {
                Present { value: field_map } =>
                  let composed_field_map = fold(map_keys(field_map), init: empty_map(), f: (fm_acc, field_name) =>
                    match map_get(field_map, field_name) {
                      Present { value: param_map } =>
                        let composed = compose_callee_param_map(callee_prov: param_map, arg_by_name: call_args, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
                        if map_keys(composed) |> count > 0 { map_insert(fm_acc, field_name, composed) }
                        else { fm_acc }
                      Absent => fm_acc
                    }
                  )
                  if map_keys(composed_field_map) |> count > 0 {
                    match map_get(variant_acc, variant_name) {
                      Present { value: existing } => map_insert(variant_acc, variant_name, merge_field_prov_maps(a: existing, b: composed_field_map))
                      Absent => map_insert(variant_acc, variant_name, composed_field_map)
                    }
                  } else { variant_acc }
                Absent => variant_acc
              }
            )
          } else { acc }
        Absent => acc
      }
    ExprMatch =>
      match_arm_nodes(texpr: body) |> fold(init: acc, f: (a, arm) =>
        collect_variant_constructors(body: arm_body(n: arm), parent_enum: parent_enum, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov, acc: a)
      )
    ExprIf =>
      let then_acc = collect_variant_constructors(body: if_then_branch(texpr: body), parent_enum: parent_enum, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov, acc: acc)
      match if_else_branch(texpr: body) {
        Present { value: eb } =>
          collect_variant_constructors(body: eb, parent_enum: parent_enum, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov, acc: then_acc)
        Absent => then_acc
      }
    ExprLet =>
      match let_body(texpr: body) {
        Present { value: b } =>
          let bname = let_binding_name_at(texpr: body, source_indices: type_env.source_indices)
          let value_prov = classify_body_provenance(expr: let_value(texpr: body), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: let_prov)
          let new_lp = map_insert(let_prov, bname, value_prov)
          collect_variant_constructors(body: b, parent_enum: parent_enum, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: new_lp, acc: acc)
        Absent => acc
      }
    ExprBlock =>
      let stmts = body.children
      let stmt_count = stmts |> count
      if stmt_count == 0 { acc }
      else {
        let final_lp = stmts |> take(stmt_count - 1) |> fold(init: let_prov, f: (lp, stmt) =>
          match stmt.expr_data {
            ExprLet =>
              let bname = let_binding_name_at(texpr: stmt, source_indices: type_env.source_indices)
              let vprov = classify_body_provenance(expr: let_value(texpr: stmt), param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: lp)
              map_insert(lp, bname, vprov)
            _ => lp
          }
        )
        match stmts |> skip(stmt_count - 1) |> first {
          Present { value: last } =>
            collect_variant_constructors(body: last, parent_enum: parent_enum, param_names: param_names, param_types: param_types, type_env: type_env, func_env: func_env, let_prov: final_lp, acc: acc)
          Absent => acc
        }
      }
    _ => acc
  }
}

fn merge_field_prov_maps(a: Map<String, Map<String, SubValueRelation>>, b: Map<String, Map<String, SubValueRelation>>) -> Map<String, Map<String, SubValueRelation>> {
  let from_a = fold(map_keys(a), init: empty_map(), f: (result, fname) =>
    match map_get(a, fname) {
      Present { value: a_prov } =>
        match map_get(b, fname) {
          Present { value: b_prov } => map_insert(result, fname, union_prov_maps(a: a_prov, b: b_prov))
          Absent => map_insert(result, fname, a_prov)
        }
      Absent => result
    }
  )
  fold(map_keys(b), init: from_a, f: (result, fname) =>
    if map_get(result, fname) != none { result }
    else {
      match map_get(b, fname) {
        Present { value: b_prov } => map_insert(result, fname, b_prov)
        Absent => result
      }
    }
  )
}

fn union_prov_maps(a: Map<String, SubValueRelation>, b: Map<String, SubValueRelation>) -> Map<String, SubValueRelation> {
  let from_a = fold(map_keys(a), init: empty_prov_map(), f: (result, key) =>
    match map_get(a, key) {
      Present { value: a_rel } =>
        match map_get(b, key) {
          Present { value: b_rel } => map_insert(result, key, join_sub_value(a: a_rel, b: b_rel))
          Absent => map_insert(result, key, a_rel)
        }
      Absent => result
    }
  )
  fold(map_keys(b), init: from_a, f: (result, key) =>
    if map_get(result, key) != none { result }
    else {
      match map_get(b, key) {
        Present { value: b_rel } => map_insert(result, key, b_rel)
        Absent => result
      }
    }
  )
}

fn populate_output_provenance(typed_items: List<Node>, func_env: ResolvedFuncEnv, type_env: TypeEnv, locals: Map<String, TypeBinding>) -> ResolvedFuncEnv {
  let updated_local = fold(typed_items, init: func_env.local, f: (acc, item) =>
    if item.params |> count > 0 {
      let fn_name = authored_name_at(source_indices: type_env.source_indices, node: item)
      if is_child_accessor_in_model(name: fn_name) || is_tree_size_reducing(func_name: fn_name) {
        match item.params |> first {
          Present { value: first_param } =>
            let pname = param_node_name_at(n: first_param, source_indices: type_env.source_indices)
            let ptype = resolved_type_name(n: first_param, source_indices: type_env.source_indices)
            if ptype != "" && pname != "" {
              let fields = inductive_fields_for(env: type_env, type_name: ptype)
              let list_field = fields |> filter(f => match f.shape { ListRecursion => true  _ => false }) |> first
              match list_field {
                Present { value: ind_field } =>
                  let relation = StrictSubValue { field: ind_field, factor: UnitShrink }
                  let provenance = [map_insert(empty_map(), pname, relation)]
                  match map_get(acc, fn_name) {
                    Present { value: sig } =>
                      map_insert(acc, fn_name, ResolvedFuncSig {
                        name: sig.name, params: sig.params, inferred: sig.inferred,
                        is_async: sig.is_async, output_provenance: provenance,
                        variant_provenance: sig.variant_provenance
                      })
                    Absent => acc
                  }
                Absent => acc
              }
            } else { acc }
          Absent => acc
        }
      } else {
        match item.body {
          Present { value: body } =>
            if !expr_has_self_call(texpr: body, fn_name: fn_name, source_indices: type_env.source_indices) {
              let working_env = ResolvedFuncEnv { name: func_env.name, local: acc, parents: func_env.parents }
              let provenance = infer_output_provenance(body: body, params: item.params, type_env: type_env, scope_locals: locals, func_env: working_env)
              let variant_prov = match item.inferred {
                Present { value: Resolved { node: rt } } =>
                  compute_variant_provenance(body: body, return_type: rt, params: item.params, type_env: type_env, func_env: working_env)
                _ => empty_map()
              }
              let has_scalar = provenance |> count > 0
              let has_variant = map_keys(variant_prov) |> count > 0
              if has_scalar || has_variant {
                match map_get(acc, fn_name) {
                  Present { value: sig } =>
                    map_insert(acc, fn_name, ResolvedFuncSig {
                      name: sig.name, params: sig.params, inferred: sig.inferred,
                      is_async: sig.is_async,
                      output_provenance: if has_scalar { provenance } else { sig.output_provenance },
                      variant_provenance: if has_variant { variant_prov } else { sig.variant_provenance }
                    })
                  Absent => acc
                }
              } else { acc }
            } else { acc }
          Absent => acc
        }
      }
    } else { acc }
  )
  ResolvedFuncEnv { name: func_env.name, local: updated_local, parents: func_env.parents }
}

fn annotate_descent_evidence(body: Node, fn_name: String, params: List<Node>, type_env: TypeEnv, scope_locals: Map<String, TypeBinding>, func_env: ResolvedFuncEnv) -> Node {
  let param_name_map = params |> fold(init: empty_map(), f: (acc, p) =>
    let pname = param_node_name_at(n: p, source_indices: type_env.source_indices)
    let ptype = resolved_type_name(n: p, source_indices: type_env.source_indices)
    map_insert(acc, pname, ptype)
  )
  let param_order_list = params |> map(p => param_node_name_at(n: p, source_indices: type_env.source_indices))
  let ctx = DescentContext {
    fn_name: fn_name,
    param_names: param_name_map,
    param_order: param_order_list,
    type_env: type_env,
    sub_value_vars: empty_map(),
    size_aliases: empty_map(),
    scope_locals: scope_locals,
    func_env: func_env,
    per_field_vars: empty_map()
  }
  annotate_descent(body: body, ctx: ctx)
}

type InferPropertiesResult {
  props: List<Node>
  diagnostics: List<ErrorNode>
}

type InferTransportResult {
  transport: Node?
  diagnostics: List<ErrorNode>
}

fn infer_property_values(props: List<Node>, scope: InferScope) -> InferPropertiesResult {
  let results = props |> map(p =>
    let val = field_init_node_value(n: p)
    let val_result = infer_expr(texpr: val, scope: scope, expected: none)
    {
      prop: Node {
        name: p.name, span: p.span, ident_span: p.ident_span,
        children: [val_result.typed], connective: p.connective,
        params: p.params, inferred: p.inferred, return_cardinality: p.return_cardinality,
        uses: p.uses, body: p.body, transport: p.transport, properties: p.properties,
        type_annotation: p.type_annotation, is_self_recursive: p.is_self_recursive,
        has_non_tail_self_call: p.has_non_tail_self_call, match_pattern: p.match_pattern,
        expr_data: p.expr_data
      },
      diagnostics: val_result.diagnostics
    }
  )
  InferPropertiesResult {
    props: results |> map(r => r.prop),
    diagnostics: results |> flat_map(r => r.diagnostics)
  }
}

fn infer_auth_source_properties(props: List<Node>, scope: InferScope) -> InferPropertiesResult {
  let results = props |> map(p =>
    if field_init_node_name_at(n: p, source_indices: scope.type_env.source_indices) == "svc_auth_source" {
      let val = field_init_node_value(n: p)
      let val_result = infer_expr(texpr: val, scope: scope, expected: none)
      {
        prop: Node {
          name: p.name, span: p.span, ident_span: p.ident_span,
          children: [val_result.typed], connective: p.connective,
          params: p.params, inferred: p.inferred, return_cardinality: p.return_cardinality,
          uses: p.uses, body: p.body, transport: p.transport, properties: p.properties,
          type_annotation: p.type_annotation, is_self_recursive: p.is_self_recursive,
          has_non_tail_self_call: p.has_non_tail_self_call, match_pattern: p.match_pattern,
          expr_data: p.expr_data
        },
        diagnostics: val_result.diagnostics
      }
    } else {
      { prop: p, diagnostics: [] }
    }
  )
  InferPropertiesResult {
    props: results |> map(r => r.prop),
    diagnostics: results |> flat_map(r => r.diagnostics)
  }
}

fn infer_transport_node(transport: Node?, scope: InferScope) -> InferTransportResult {
  match transport {
    Absent => InferTransportResult { transport: none, diagnostics: [] }
    Present { value: t } =>
      let prop_result = infer_property_values(props: t.properties, scope: scope)
      InferTransportResult {
        transport: Present { value: Node {
          name: t.name, span: t.span, ident_span: t.ident_span,
          children: t.children, connective: t.connective,
          params: t.params, inferred: t.inferred, return_cardinality: t.return_cardinality,
          uses: t.uses, body: t.body, transport: t.transport, properties: prop_result.props,
          type_annotation: t.type_annotation, is_self_recursive: t.is_self_recursive,
          has_non_tail_self_call: t.has_non_tail_self_call, match_pattern: t.match_pattern,
          expr_data: t.expr_data
        } },
        diagnostics: prop_result.diagnostics
      }
  }
}

fn infer_item(item: Node, scope: InferScope) -> TypedItemResult {
  let typed_anno = item.type_annotation
  let transport_scope = if item.params |> count > 0 {
    build_params_scope(scope: scope, params: item.params)
  } else { scope }
  let transport_result = infer_transport_node(transport: item.transport, scope: transport_scope)
  let typed_transport = transport_result.transport
  let transport_diags = transport_result.diagnostics
  let props_result = infer_auth_source_properties(props: item.properties, scope: scope)
  let typed_properties = props_result.props
  let props_diags = props_result.diagnostics
  if item.connective != NoConnective && item.transport == none {
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, ident_span: item.ident_span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        inferred: Present { value: Resolved { node: unit_type } }, return_cardinality: item.return_cardinality, uses: item.uses, body: none,
        connective: item.connective, transport: typed_transport,
               properties: typed_properties, type_annotation: typed_anno,
        is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
      },
      diagnostics: concat(transport_diags, props_diags)
    }
  }
  else if item.body != none && item.params |> count > 0 {
    let fn_scope = build_params_scope(scope: scope, params: item.params)
    let fn_scope = fold(item.uses, init: fn_scope, f: (s, u) =>
      extend_scope(scope: s, name: resource_use_name_at(n: u, source_indices: scope.type_env.source_indices), resolved: resource_use_resource(n: u), provenance: SubValueUnknown)
    )
    let fn_decl_name = authored_name_at(source_indices: scope.type_env.source_indices, node: item)
    let fn_scope = InferScope {
      type_env: fn_scope.type_env,
      func_env: fn_scope.func_env,
      locals: fn_scope.locals,
      body_locals: fn_scope.body_locals,
      match_bound_names: fn_scope.match_bound_names,
      module_name: fn_scope.module_name,
      service_registry: fn_scope.service_registry,
      item_registry: fn_scope.item_registry,
      caller_decl_name: fn_decl_name,
      lambda_param_provenance: fn_scope.lambda_param_provenance
    }
    let fn_return_expected = if item.inferred != none { Present { value: resolved_type(n: item) } } else { none }
    let body_result = infer_expr(texpr: item.body.value, scope: fn_scope, expected: fn_return_expected)
    let body_typed = body_result.typed
    let body_diags = body_result.diagnostics
    let inferred_ret = if item.inferred != none { item.inferred } else { body_typed.inferred }
    let return_conformance_diags = if item.inferred != none {
      concat(
        declared_type_conformance_diags(declared: declared_return_type_node(item: item), produced: resolved_type(n: body_typed), span: item.body.value.span, scope: scope),
        explicit_return_conformance_diags(declared: declared_return_type_node(item: item), body_typed: body_typed, scope: scope))
    } else { [] }

    let is_recursive = expr_has_self_call(texpr: body_typed, fn_name: authored_name_at(source_indices: scope.type_env.source_indices, node: item), source_indices: scope.type_env.source_indices)
    let annotated_body = if is_recursive {
      annotate_descent_evidence(body: body_typed, fn_name: authored_name_at(source_indices: scope.type_env.source_indices, node: item), params: item.params, type_env: scope.type_env, scope_locals: fn_scope.locals, func_env: scope.func_env)
    } else { body_typed }
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, ident_span: item.ident_span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        inferred: inferred_ret, return_cardinality: item.return_cardinality, uses: item.uses, body: Present { value: annotated_body },
        connective: NoConnective, transport: typed_transport,
               properties: typed_properties, type_annotation: typed_anno,
        is_self_recursive: is_recursive,
        has_non_tail_self_call: expr_has_non_tail_self_call(texpr: body_typed, fn_name: authored_name_at(source_indices: scope.type_env.source_indices, node: item), in_tail: true, source_indices: scope.type_env.source_indices),
        match_pattern: none, expr_data: NoExprData
      },
      diagnostics: concat(transport_diags, props_diags, concat(body_diags, return_conformance_diags))
    }
  }
  else if item.body != none && item.params |> count == 0 && item.inferred != none {
    let fn_decl_name = authored_name_at(source_indices: scope.type_env.source_indices, node: item)
    let fn_scope = InferScope {
      type_env: scope.type_env,
      func_env: scope.func_env,
      locals: scope.locals,
      body_locals: scope.body_locals,
      match_bound_names: scope.match_bound_names,
      module_name: scope.module_name,
      service_registry: scope.service_registry,
      item_registry: scope.item_registry,
      caller_decl_name: fn_decl_name,
      lambda_param_provenance: scope.lambda_param_provenance
    }
    let body_result = infer_expr(texpr: item.body.value, scope: fn_scope, expected: Present { value: resolved_type(n: item) })
    let body_typed = body_result.typed
    let body_diags = concat(
      body_result.diagnostics,
      concat(
        declared_type_conformance_diags(declared: declared_return_type_node(item: item), produced: resolved_type(n: body_typed), span: item.body.value.span, scope: scope),
        explicit_return_conformance_diags(declared: declared_return_type_node(item: item), body_typed: body_typed, scope: scope))
    )
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, ident_span: item.ident_span, children: [], params: [],
        inferred: item.inferred, return_cardinality: item.return_cardinality, uses: [], body: Present { value: body_typed },
        connective: NoConnective, transport: typed_transport,
               properties: typed_properties, type_annotation: typed_anno,
        is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
      },
      diagnostics: concat(transport_diags, props_diags, body_diags)
    }
  }
  else if item.body != none && item.params |> count == 0 {
    let data_expected = if item.type_annotation != none { Present { value: item.type_annotation.value } } else { none }
    let val_result = infer_expr(texpr: item.body.value, scope: scope, expected: data_expected)
    let val_typed = val_result.typed
    let val_diags = if item.type_annotation != none {
      concat(
        val_result.diagnostics,
        declared_type_conformance_diags(declared: item.type_annotation.value, produced: resolved_type(n: val_typed), span: item.body.value.span, scope: scope)
      )
    } else { val_result.diagnostics }
    let inferred_ret = if item.type_annotation != none { Present { value: Resolved { node: item.type_annotation.value } } } else { val_typed.inferred }
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, ident_span: item.ident_span, children: [], params: [],
        inferred: inferred_ret, return_cardinality: item.return_cardinality, uses: [], body: Present { value: val_typed },
        connective: NoConnective, transport: typed_transport,
               properties: typed_properties, type_annotation: typed_anno,
        is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
      },
      diagnostics: concat(transport_diags, props_diags, val_diags)
    }
  }
  else if item.params |> count > 0 && item.body == none {
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, ident_span: item.ident_span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        inferred: if item.inferred != none { item.inferred } else { Present { value: Resolved { node: unit_type } } }, return_cardinality: item.return_cardinality, uses: item.uses, body: none,
        connective: NoConnective, transport: typed_transport,
               properties: typed_properties, type_annotation: typed_anno,
        is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
      },
      diagnostics: concat(transport_diags, props_diags)
    }
  }
  else {
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, ident_span: item.ident_span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        inferred: if item.inferred != none { item.inferred } else { Present { value: Resolved { node: unit_type } } }, return_cardinality: item.return_cardinality, uses: item.uses, body: none,
        connective: item.connective, transport: typed_transport,
               properties: typed_properties, type_annotation: typed_anno,
        is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
      },
      diagnostics: concat(transport_diags, props_diags)
    }
  }
}

fn infer_items(items: List<Node>, scope: InferScope) -> List<TypedItemResult> {
  map(items, item => infer_item(item: item, scope: scope))
}

fn is_type_variable_name(name: String) -> Bool {
  name == "T" || name == "K" || name == "V" || name == "MappedElement" || name == "FoldAccumulator"
}

type ArgGenericFoldState { results: List<ArgInferResult>, subst: Map<String, Node> }

fn type_node_label(n: Node, source_indices: Map<String, NewlineIndex>) -> String {
  let authored = authored_name_at(source_indices: source_indices, node: n)
  if authored != "" {
    authored
  } else {
    match n.inferred {
      Present { value: TypeVariable { id: tv_id } } => tv_id
      _ => n.name
    }
  }
}

type SigParamSplit {
  value_params: List<Node>
  generic_names: List<String>
}

fn body_shadow_aware_func_sig(scope: InferScope, func_name: String) -> FuncSigLookup {
  match map_get(scope.body_locals, func_name) {
    Present { value: _ } => FuncSigUnresolved
    Absent => lookup_func_sig(func_env: scope.func_env, type_env: scope.type_env, name: func_name)
  }
}

fn split_sig_params(params: List<Node>, source_indices: Map<String, NewlineIndex>) -> SigParamSplit {
  SigParamSplit {
    value_params: params |> filter(p => !param_is_generic_decl(p: p, source_indices: source_indices)),
    generic_names: params
      |> filter(p => param_is_generic_decl(p: p, source_indices: source_indices))
      |> map(p => param_node_name_at(n: p, source_indices: source_indices))
  }
}

fn param_is_generic_decl(p: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  let pt = param_node_type_expr(n: p)
  let pname = param_node_name_at(n: p, source_indices: source_indices)
  let tname = type_node_label(n: pt, source_indices: source_indices)
  let type_expr_is_var = match pt.inferred {
    Present { value: inf } => is_type_variable(inferred: inf)
    Absent => false
  }

  (pt.children |> count == 0 && pt.connective == NoConnective)
    && pname != ""
    && (pname == tname || (type_expr_is_var && pname == pt.name))
}

fn unify_generics(formal: Node, actual: Node, generic_names: List<String>, source_indices: Map<String, NewlineIndex>, acc: Map<String, Node>) -> Map<String, Node> {
  let bind_name = type_node_label(n: formal, source_indices: source_indices)
  let f_bare = formal.children |> count == 0 && formal.connective == NoConnective
  if (f_bare || match formal.inferred { Present { value: TypeVariable { id: _ } } => true  _ => false })
    && (generic_names |> any(g => g == bind_name)) {

    match map_get(acc, bind_name) {
      Absent => map_insert(acc, bind_name, actual)
      Present { value: _ } => acc
    }
  } else if formal.children |> count == 1 && actual.children |> count == 1 {
    match formal.children |> first {
      Present { value: fc } =>
        match actual.children |> first {
          Present { value: ac } => unify_generics(formal: fc, actual: ac, generic_names: generic_names, source_indices: source_indices, acc: acc)
          Absent => acc
        }
      Absent => acc
    }
  } else { acc }
}

fn should_unify_record_lit_generics(formal: Node, arg_expr: Node, generic_names: List<String>, source_indices: Map<String, NewlineIndex>) -> Bool {
  match record_lit_expr_optional(expr: arg_expr) {
    Absent => false
    Present { value: record_expr } =>
      if generic_names |> count == 0 {
        false
      } else if formal.children |> count > 0 {
        true
      } else {
        let formal_name = type_node_label(n: formal, source_indices: source_indices)
        let record_name = type_node_label(n: record_expr, source_indices: source_indices)
        formal_name != "" && record_name != "" && formal_name == record_name
      }
  }
}

fn unify_record_lit_field_walk(struct_fields: List<Node>, record: Node, generic_names: List<String>, scope: InferScope, acc: Map<String, Node>) -> Map<String, Node> {
  fold(struct_fields, init: acc, f: (st, sf) =>
    let field_name = authored_name_at(source_indices: scope.type_env.source_indices, node: sf)
    match record.children |> filter(fi => field_init_node_name_at(n: fi, source_indices: scope.type_env.source_indices) == field_name) |> first {
      Present { value: fi } =>
        let actual_value = field_init_node_value(n: fi)
        let field_formal = match sf.inferred {
          Present { value: Resolved { node: rt } } => rt
          _ => field_node_type_expr(n: sf)
        }
        match record_lit_expr_optional(expr: actual_value) {
          Present { value: nested_record } =>
            unify_record_lit_generics(formal: field_formal, record: nested_record, generic_names: generic_names, scope: scope, acc: st)
          Absent =>
            unify_generics(formal: field_formal, actual: resolved_type(n: actual_value), generic_names: generic_names, source_indices: scope.type_env.source_indices, acc: st)
        }
      Absent => st
    }
  )
}

fn unify_record_lit_generics(formal: Node, record: Node, generic_names: List<String>, scope: InferScope, acc: Map<String, Node>) -> Map<String, Node> {
  if formal.children |> count == 0 {
    let formal_name = type_node_label(n: formal, source_indices: scope.type_env.source_indices)
    let is_generic_slot = generic_names |> any(g => g == formal_name)
    if is_generic_slot {
      unify_generics(formal: formal, actual: resolved_type(n: record), generic_names: generic_names, source_indices: scope.type_env.source_indices, acc: acc)
    } else {
      match record_lit_expr_optional(expr: record) {
        Present { value: record_lit } =>
          let record_type_name = type_node_label(n: record_lit, source_indices: scope.type_env.source_indices)
          if record_type_name != "" && formal_name == record_type_name {
            unify_record_lit_field_walk(
              struct_fields: record_lit_expected_fields(type_name: Present { value: record_type_name }, scope: scope),
              record: record_lit,
              generic_names: generic_names,
              scope: scope,
              acc: acc
            )
          } else {
            unify_generics(formal: formal, actual: resolved_type(n: record), generic_names: generic_names, source_indices: scope.type_env.source_indices, acc: acc)
          }
        Absent =>
          unify_generics(formal: formal, actual: resolved_type(n: record), generic_names: generic_names, source_indices: scope.type_env.source_indices, acc: acc)
      }
    }
  } else {
    let type_name = type_node_label(n: formal, source_indices: scope.type_env.source_indices)
    unify_record_lit_field_walk(
      struct_fields: record_lit_expected_fields(type_name: Present { value: type_name }, scope: scope),
      record: record,
      generic_names: generic_names,
      scope: scope,
      acc: acc
    )
  }
}

fn substitute_generics(n: Node, subst: Map<String, Node>, source_indices: Map<String, NewlineIndex>) -> Node {

  if map_is_empty(subst) { n }
  else { substitute_generics_apply(n: n, subst: subst, source_indices: source_indices) }
}

fn substitute_generics_apply(n: Node, subst: Map<String, Node>, source_indices: Map<String, NewlineIndex>) -> Node {
  match n.inferred {
    Present { value: TypeVariable { id: tv_id } } =>
      match map_get(subst, tv_id) {
        Present { value: c } => c
        Absent => n
      }
    _ =>
  let nm = type_node_label(n: n, source_indices: source_indices)
  let is_bare = n.children |> count == 0 && n.connective == NoConnective && n.params |> count == 0
  if is_bare {
    match map_get(subst, nm) {
      Present { value: c } => c
      Absent => n
    }
  } else {

    let new_children = n.children |> map(c => substitute_generics_apply(n: c, subst: subst, source_indices: source_indices))
    let new_params = n.params |> map(p => substitute_generics_apply(n: p, subst: subst, source_indices: source_indices))
    let new_inferred = match n.inferred {
      Present { value: Resolved { node: rt } } =>
        let new_rt = substitute_generics_apply(n: rt, subst: subst, source_indices: source_indices)
        if rc_ptr_eq(new_rt, rt) { n.inferred }
        else { Present { value: Resolved { node: new_rt } } }
      _ => n.inferred
    }
    if rc_vec_ptr_eq(new_children, n.children) && rc_vec_ptr_eq(new_params, n.params) && new_inferred == n.inferred {
      n
    } else {
      Node {
        name: n.name, span: n.span, ident_span: n.ident_span,
        children: new_children,
        connective: n.connective,
        params: new_params,
        inferred: new_inferred,
        return_cardinality: n.return_cardinality, uses: n.uses, body: n.body, transport: n.transport,
        properties: n.properties, type_annotation: n.type_annotation,
        is_self_recursive: n.is_self_recursive, has_non_tail_self_call: n.has_non_tail_self_call,
        match_pattern: n.match_pattern, expr_data: n.expr_data
      }
    }
  }
  }
}

fn kernel_span(name: String) -> SourceSpan {
  SourceSpan { file: concat("<kernel:", name, ">"), start: 0, end: string_length(s: name) }
}

fn deps_excluding_leaf_self(b: TypeBinding, source_indices: Map<String, NewlineIndex>) -> List<String> {
  let deps0 = node_type_deps(n: b.resolved, source_indices: source_indices)
  let is_bare_self = b.resolved.connective == NoConnective && (b.resolved.children |> count) == 0 && (deps0 |> count) == 1 && (deps0 |> any(d => d == b.name))
  if is_bare_self { [] } else { deps0 }
}

fn compiler_recursive_name_set() -> Map<String, Bool> {
  fold(map_keys(compiler_recursive_types), init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, true)
  )
}

fn type_env_cache_from_bindings(
  bindings: Map<Int, TypeBinding>,
  source_indices: Map<String, NewlineIndex>,
  cycle_set_str: Map<String, Bool>
) -> TypeEnvCache {
  let str_bindings = fold(bindings |> map_values, init: empty_map(), f: (acc, b) =>
    map_insert(acc, b.name, b)
  )
  let deps_map = fold(bindings |> map_values, init: empty_map(), f: (acc, b) =>
    map_insert(acc, b.name, deps_excluding_leaf_self(b: b, source_indices: source_indices))
  )
  TypeEnvCache {
    deps_map: deps_map,
    str_bindings: str_bindings,
    cycle_set_str: cycle_set_str,
    variant_locals: empty_map()
  }
}

type ParentCacheRow {
  import_path: String
  cache: TypeEnvCache
}

fn union_parent_type_env_caches(
  resolved_imports: List<ResolvedImport>,
  parent_index: Map<String, TypedModule>
) -> GuardedTypeEnvCacheMerge {
  let parent_caches = flat_map(resolved_imports, imp =>
    match map_get(parent_index, imp.module_path) {
      Present { value: parent } => [ParentCacheRow { import_path: imp.module_path, cache: parent.interface.cache }]
      Absent => []
    }
  )
  match parent_caches |> first {
    Absent => GuardedTypeEnvCacheMerge { cache: empty_type_env_cache(), conflicts: [] }
    Present { value: head } =>
      fold(parent_caches |> skip(1), init: GuardedTypeEnvCacheMerge { cache: head.cache, conflicts: [] }, f: (acc, row) =>
        merge_type_env_cache_guarded(base: acc.cache, overlay: row.cache, import_path: row.import_path, conflicts: acc.conflicts)
      )
  }
}

fn kernel_coproduct_variant_locals(env: TypeEnv) -> Map<String, TypeBinding> {
  match env.parents |> last {
    Present { value: kernel } =>
      fold(
        kernel.bindings |> map_values |> sort_by(b => b.name),
        init: empty_map(),
        f: (acc, binding) =>
          let is_coproduct = binding.resolved.connective == Disj
          if is_coproduct {
            fold(binding.resolved.children, init: acc, f: (vacc, child) =>
              let child_name = authored_name_at(source_indices: env.source_indices, node: child)
              match map_get(vacc, child_name) {
                Present { value: _prev } => vacc
                Absent => map_insert(vacc, child_name, TypeBinding { name: child_name, resolved: binding.resolved, provenance: SubValueUnknown })
              }
            )
          } else { acc }
      )
    Absent => empty_map()
  }
}

fn merge_kernel_variant_locals_low_priority(
  env: TypeEnv,
  locals: Map<String, TypeBinding>
) -> Map<String, TypeBinding> {
  let kernel_locals = kernel_coproduct_variant_locals(env: env)
  fold(kernel_locals |> map_keys, init: locals, f: (acc, variant_name) =>
    match map_get(acc, variant_name) {
      Present { value: _ } => acc
      Absent =>
        match map_get(kernel_locals, variant_name) {
          Present { value: binding } => map_insert(acc, variant_name, binding)
          Absent => acc
        }
    }
  )
}

fn type_env_for_import(module_path: String, parent_env: TypeEnv) -> TypeEnv {
  if module_path == "std.types" {
    let filtered = fold(map_keys(parent_env.bindings), init: empty_map(), f: (acc, ident) =>
      let name = intern_str(table: parent_env.intern_table, id: ident)
      if is_type_variable_name(name: name) { acc }
      else {
        match map_get(parent_env.bindings, ident) {
          Present { value: binding } => map_insert(acc, ident, binding)
          Absent => acc
        }
      }
    )
    let filtered_str = fold(map_keys(parent_env.str_bindings), init: empty_map(), f: (acc, name) =>
      if is_type_variable_name(name: name) { acc }
      else {
        match map_get(parent_env.str_bindings, name) {
          Present { value: binding } => map_insert(acc, name, binding)
          Absent => acc
        }
      }
    )
    let filtered_ancestry = fold(map_keys(parent_env.ancestry_str_bindings), init: empty_map(), f: (acc, name) =>
      if is_type_variable_name(name: name) { acc }
      else {
        match map_get(parent_env.ancestry_str_bindings, name) {
          Present { value: binding } => map_insert(acc, name, binding)
          Absent => acc
        }
      }
    )
    TypeEnv { module_path: module_path,
      bindings: filtered,
      str_bindings: filtered_str,
      ancestry_str_bindings: filtered_ancestry,
      parents: parent_env.parents,
      recursive_types: parent_env.recursive_types,
      recursive_type_set: parent_env.recursive_type_set,
      inductive_fields: parent_env.inductive_fields,
      source_indices: parent_env.source_indices,
      intern_table: parent_env.intern_table,
      source_visible_names: parent_env.source_visible_names,
      symbol_index: parent_env.symbol_index
    }
  } else { parent_env }
}

data interface_env_for_import_note: String = "Interface-grain scope parent (S2a move 2 increment B, resolver-graph-major-design.md 7): a dependent's typecheck may read exactly its direct import's exported surface - str_bindings, the flattened ancestry maps, the MERGED inductive_fields/recursive sets (each inductively carries the parent's own ancestry, so one level suffices) - and never the parent's parent-chain env OBJECTS. parents: [] cuts the whole-ancestry retention (the measured ~16.3MiB/module residency class) while every chain consumer stays satisfied: phantom-variant and paramless-generic retries read direct parents' str_bindings (carried), inductive_fields_for reads the merged fields (carried), and the kernel stays the dependent's own last scope parent. Discriminating receipt: transitive_interface_binding_test (green arm = a C-declared record projected through B's exported signature still typechecks in A; red control = a bogus field on the same transitive record still errors)."

fn interface_env_for_import(module_path: String, parent_env: TypeEnv) -> TypeEnv {
  let filtered = type_env_for_import(module_path: module_path, parent_env: parent_env)
  TypeEnv { module_path: module_path,
    bindings: filtered.bindings,
    str_bindings: filtered.str_bindings,
    ancestry_str_bindings: filtered.ancestry_str_bindings,
    parents: [],
    recursive_types: filtered.recursive_types,
    recursive_type_set: filtered.recursive_type_set,
    inductive_fields: filtered.inductive_fields,
    source_indices: filtered.source_indices,
    intern_table: filtered.intern_table,
    source_visible_names: filtered.source_visible_names,
    symbol_index: filtered.symbol_index
  }
}

data interface_summary_consumer_note: String = "S2a move 2 increment B (resolver-graph-major-design.md §7): build_type_env reads a direct import's ModuleInterface (std.interface_summary carrier + interface-grain env/cache realization) — never the parent's full TypeEnv+TypeEnvCache chains. interface.env is the export surface with parents: [] (ancestry-complete via flattened str_bindings/ancestry maps and merged inductive/recursive sets); interface.cache is the flattened import-union grain (variant_locals stripped — interpretation-local). Consumption still runs interface_env_for_import for importer-specific std.types filtering. Discriminating receipt: transitive_interface_binding_test."

data interface_signature_fingerprint_v0_note: String = "Interim v0 export signature fingerprint (export_entry_from_item): name-grain, NOT yet structural type shape. Type/data/service exports fingerprint name + authored_name_at(binding.resolved) under tag v1-interface-sig-v0; fn/func exports fingerprint name + param resolved-type names + return-type authored name under tag v1-interface-fn-sig-v0 (the fn arm landed with the typed-module content key, PR-alpha — before it, fn exports produced NO entry, so a fn-only module's interface_hash was the constant empty rollup and the content key's import term was vacuous; the key's import-term RED control is the discriminating receipt). Two exports whose names and resolved authored-name strings all match still collide even if type STRUCTURE differs; increment-B receipt is binding transitivity (transitive_interface_binding_test), not hash-discriminated deep structure. Structural fingerprint authority: std.interface_summary.interface_summary_v0_dissolution_trigger → export_entry_fingerprint when type-structure hashing lands."

fn interface_env_surface(env: TypeEnv) -> TypeEnv {
  TypeEnv { module_path: env.module_path,
    bindings: env.bindings,
    str_bindings: env.str_bindings,
    ancestry_str_bindings: env.ancestry_str_bindings,
    parents: [],
    recursive_types: env.recursive_types,
    recursive_type_set: env.recursive_type_set,
    inductive_fields: env.inductive_fields,
    source_indices: env.source_indices,
    intern_table: env.intern_table,
    source_visible_names: env.source_visible_names,
    symbol_index: env.symbol_index
  }
}

fn interface_cache_from_module(cache: TypeEnvCache) -> TypeEnvCache {
  TypeEnvCache {
    deps_map: cache.deps_map,
    str_bindings: cache.str_bindings,
    cycle_set_str: cache.cycle_set_str,
    variant_locals: empty_map()
  }
}

fn export_kind_of_item_kind(kind: ItemKind) -> ExportKind? {
  match kind {
    FnItem => Present { value: ExportFn }
    FuncItem => Present { value: ExportFn }
    TypeItem => Present { value: ExportType }
    DataItem => Present { value: ExportData }
    ServiceItem => Present { value: ExportService }
    OtherItem => Absent
  }
}

fn fn_signature_fingerprint(item: Node, source_indices: Map<String, NewlineIndex>) -> Fnv1a64Structural {
  let params_acc = fold(item.params, init: content_hash_atom(value: "v1-interface-fn-sig-v0"), f: (acc, p) =>
    content_hash_combine_structural(
      left: acc,
      right: content_hash_atom(value: resolved_type_name(n: p, source_indices: source_indices))
    )
  )
  match item.inferred {
    Present { value: Resolved { node: rt } } =>
      content_hash_combine_structural(
        left: params_acc,
        right: content_hash_atom(value: authored_name_at(source_indices: source_indices, node: rt))
      )
    _ => params_acc
  }
}

fn export_entry_from_item(item: Node, env: TypeEnv, source_indices: Map<String, NewlineIndex>) -> ExportEntry? {
  let name = authored_name_at(source_indices: source_indices, node: item)
  match export_kind_of_item_kind(kind: item_kind(item: item)) {
    Absent => Absent
    Present { value: kind } =>
      match kind {
        ExportFn =>
          Present {
            value: ExportEntry {
              name: name,
              kind: kind,
              contract: signature_contract(
                signature: content_hash_tagged_structural(
                  tag: "v1-interface-fn-sig-v0",
                  payload: content_hash_combine_structural(
                    left: content_hash_atom(value: name),
                    right: fn_signature_fingerprint(item: item, source_indices: source_indices)
                  )
                )
              )
            }
          }
        _ =>
          match map_get(env.str_bindings, name) {
            Present { value: binding } =>
              Present {
                value: ExportEntry {
                  name: name,
                  kind: kind,
                  contract: signature_contract(
                    signature: content_hash_tagged_structural(
                      tag: "v1-interface-sig-v0",
                      payload: content_hash_combine_structural(
                        left: content_hash_atom(value: binding.name),
                        right: content_hash_atom(value: authored_name_at(source_indices: source_indices, node: binding.resolved))
                      )
                    )
                  )
                }
              }
            Absent => Absent
          }
      }
  }
}

fn export_entries_from_module(module: Node, env: TypeEnv, source_indices: Map<String, NewlineIndex>) -> List<ExportEntry> {
  flat_map(module_items(n: module), item =>
    match export_entry_from_item(item: item, env: env, source_indices: source_indices) {
      Present { value: entry } => [entry]
      Absent => []
    }
  )
}

fn build_module_interface(
  module_path: String,
  module: Node,
  env: TypeEnv,
  cache: TypeEnvCache,
  source_indices: Map<String, NewlineIndex>
) -> ModuleInterface {
  let exports = export_entries_from_module(module: module, env: env, source_indices: source_indices)
  ModuleInterface {
    summary: InterfaceSummary {
      module_path: module_path,
      exports: exports,
      interface_hash: interface_summary_rollup(exports: exports)
    },
    env: interface_env_surface(env: env),
    cache: interface_cache_from_module(cache: cache)
  }
}


fn local_binding_for_item(item: Node, source_indices: Map<String, NewlineIndex>) -> TypeBinding? {
  if is_namespace_alias_item(item: item, source_indices: source_indices) {
    none
  } else {
  let has_structure = item.connective != NoConnective
  if has_structure {
    let type_node = Node {
      name: item.name, span: item.span, ident_span: item.ident_span, children: item.children,
      connective: item.connective, params: item.params, inferred: none,
      return_cardinality: item.return_cardinality,
      uses: [], body: none, transport: none, properties: item.properties,
      type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
    }
    Present { value: TypeBinding { name: authored_name_at(source_indices: source_indices, node: item), resolved: type_node, provenance: SubValueUnknown } }
  } else if item.body != none && item.transport == none {
    let fn_node = Node {
      name: item.name, span: item.span, ident_span: item.ident_span, children: [],
      connective: NoConnective, params: item.params, inferred: item.inferred,
      return_cardinality: item.return_cardinality,
      uses: [], body: none, transport: none, properties: item.properties,
      type_annotation: item.type_annotation, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
    }
    Present { value: TypeBinding { name: authored_name_at(source_indices: source_indices, node: item), resolved: fn_node, provenance: SubValueUnknown } }
  } else if item.inferred != none && item.params |> count == 0 && item.body == none {
    let alias_node = Node {
      name: item.name, span: item.span, ident_span: item.ident_span, children: [],
      connective: NoConnective, params: [], inferred: item.inferred,
      return_cardinality: item.return_cardinality,
      uses: [], body: none, transport: none, properties: [],
      type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
    }
    Present { value: TypeBinding { name: authored_name_at(source_indices: source_indices, node: item), resolved: alias_node, provenance: SubValueUnknown } }
  } else if item.transport == none && item.children |> count > 0 {
    let ref_node = nominal_ref_node(name: authored_name_at(source_indices: source_indices, node: item), span: item.span, ident_span: item.ident_span)
    Present { value: TypeBinding { name: authored_name_at(source_indices: source_indices, node: item), resolved: ref_node, provenance: SubValueUnknown } }
  } else if item.params |> count > 0 && item.connective == NoConnective && item.body == none && item.transport == none {
    let bare_node = Node {
      name: item.name, span: item.span, ident_span: item.ident_span, children: [],
      connective: NoConnective, params: item.params, inferred: item.inferred,
      return_cardinality: item.return_cardinality,
      uses: [], body: none, transport: none, properties: [],
      type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData
    }
    Present { value: TypeBinding { name: authored_name_at(source_indices: source_indices, node: item), resolved: bare_node, provenance: SubValueUnknown } }
  } else if item.properties |> count > 0 && item.connective == NoConnective && item.transport == none && item.inferred == none && item.params |> count == 0 {
    Present { value: nominal_type_binding(name: authored_name_at(source_indices: source_indices, node: item)) }
  } else {
    none
  }
  }
}

fn symbol_index_insert_item(
  index: SymbolIndex,
  module_path: String,
  item: Node,
  source_indices: Map<String, NewlineIndex>
) -> SymbolIndex {
  let with_decl = if is_namespace_alias_item(item: item, source_indices: source_indices) {
    match namespace_alias_target_path(item: item, source_indices: source_indices) {
      Absent => index
      Present { value: target_path } =>
        match symbol_index_lookup(index: index, qualified_name: target_path) {
          Absent => index
          Present { value: target_node } =>
            symbol_index_insert_decl(
              index: index,
              module_path: module_path,
              binding: namespace_alias_binding_for_target(
                item: item,
                target_node: target_node,
                source_indices: source_indices
              )
            )
        }
    }
  } else {
    match local_binding_for_item(item: item, source_indices: source_indices) {
      Absent => index
      Present { value: binding } =>
        symbol_index_insert_decl(
          index: index,
          module_path: module_path,
          binding: binding
        )
    }
  }
  if item.transport != none && item.children |> count > 0 {
    symbol_index_insert_service(
      index: with_decl,
      name: authored_name_at(source_indices: source_indices, node: item),
      module_path: module_path,
      item: item
    )
  } else { with_decl }
}

fn disj_variant_name_count_inc(counts: Map<String, Int>, name: String) -> Map<String, Int> {
  match map_get(counts, name) {
    Present { value: n } => map_insert(counts, name, n + 1)
    Absent => map_insert(counts, name, 1)
  }
}

fn disj_variant_name_counts(items: List<Node>, source_indices: Map<String, NewlineIndex>) -> Map<String, Int> {
  fold(items, init: empty_map(), f: (counts, item) =>
    match item.connective {
      Disj =>
        fold(item.children, init: counts, f: (c, child) =>
          disj_variant_name_count_inc(counts: c, name: authored_name_at(source_indices: source_indices, node: child))
        )
      _ => counts
    }
  )
}

data census_node_base_note: String = "The census reads only the module NODE, so the node list is its true input: one census over two front ends (resolved closures and parse-grade pool fills). ResolvedModule entry points delegate through census_module_nodes."

fn census_module_nodes(modules: List<ResolvedModule>) -> List<Node> {
  modules |> map(rm => rm.module)
}

fn corpus_disj_variant_name_counts_nodes(module_nodes: List<Node>, source_indices: Map<String, NewlineIndex>) -> Map<String, Int> {
  fold(module_nodes, init: empty_map(), f: (counts, module_node) =>
    fold(module_items(n: module_node), init: counts, f: (c, item) =>
      match item.connective {
        Disj =>
          fold(item.children, init: c, f: (c2, child) =>
            disj_variant_name_count_inc(counts: c2, name: authored_name_at(source_indices: source_indices, node: child))
          )
        _ => c
      }
    )
  )
}

fn corpus_disj_variant_name_counts(modules: List<ResolvedModule>, source_indices: Map<String, NewlineIndex>) -> Map<String, Int> {
  corpus_disj_variant_name_counts_nodes(module_nodes: census_module_nodes(modules: modules), source_indices: source_indices)
}

fn corpus_item_name_counts_nodes(module_nodes: List<Node>, source_indices: Map<String, NewlineIndex>) -> Map<String, Int> {
  fold(module_nodes, init: empty_map(), f: (counts, module_node) =>
    fold(module_items(n: module_node), init: counts, f: (c, item) =>
      disj_variant_name_count_inc(counts: c, name: authored_name_at(source_indices: source_indices, node: item))
    )
  )
}

fn corpus_item_name_counts(modules: List<ResolvedModule>, source_indices: Map<String, NewlineIndex>) -> Map<String, Int> {
  corpus_item_name_counts_nodes(module_nodes: census_module_nodes(modules: modules), source_indices: source_indices)
}

// Unconditional fully-qualified insertion, ahead of the uniqueness-gated 2-segment
// aliases below: `module_path.TypeName.variant_name` disambiguates by construction
// (a variant name is unique within one Disj, and a TypeName is unique within one
// module), so it needs no corpus-wide uniqueness check the way the bare `module_path.
// variant_name` shortcut does. This closes the population-A gap named in
// direct_call_shape_wall_note: a qualified constructor call site like
// `gunbc.WitnessBin.Run(...)` builds exactly this 3-segment dotted name
// (ExprMethodCall's qualified_direct_call gate, and func_sig_from_global_bare's
// borrowed_census_decl, both call symbol_index_lookup on it) and previously found
// nothing, falling through to the generic method-call bridge instead of the
// direct_call_shape_diags wall.
fn symbol_index_insert_unique_disj_variant_aliases(
  index: SymbolIndex,
  module_path: String,
  items: List<Node>,
  source_indices: Map<String, NewlineIndex>,
  corpus_variant_counts: Map<String, Int>,
  corpus_item_counts: Map<String, Int>
) -> SymbolIndex {
  let counts = disj_variant_name_counts(items: items, source_indices: source_indices)
  fold(items, init: index, f: (acc, item) =>
    match item.connective {
      Disj =>
        let tname = authored_name_at(source_indices: source_indices, node: item)
        fold(item.children, init: acc, f: (a2, child) =>
          let vname = authored_name_at(source_indices: source_indices, node: child)
          let a2_qualified = symbol_index_insert(
            index: a2,
            qualified_name: concat(concat(module_path, ".", tname), ".", vname),
            resolved: item
          )
          match map_get(counts, vname) {
            Present { value: 1 } =>
              match map_get(corpus_variant_counts, vname) {
                Present { value: 1 } =>
                  if map_get(corpus_item_counts, vname) != none || overlay_skips_kernel_name(name: vname) {
                    symbol_index_insert(
                      index: a2_qualified,
                      qualified_name: concat(module_path, ".", vname),
                      resolved: item
                    )
                  } else {
                  symbol_index_insert_decl(
                    index: a2_qualified,
                    module_path: module_path,
                    binding: TypeBinding {
                      name: vname,
                      resolved: item,
                      provenance: SubValueUnknown
                    }
                  )
                  }
                _ =>
                  symbol_index_insert(
                    index: a2_qualified,
                    qualified_name: concat(module_path, ".", vname),
                    resolved: item
                  )
              }
            _ => a2_qualified
          }
        )
      _ => acc
    }
  )
}

fn build_symbol_index_census_raw_nodes(module_nodes: List<Node>, source_indices: Map<String, NewlineIndex>) -> SymbolIndex {
  let corpus_variant_counts = corpus_disj_variant_name_counts_nodes(module_nodes: module_nodes, source_indices: source_indices)
  let corpus_item_counts = corpus_item_name_counts_nodes(module_nodes: module_nodes, source_indices: source_indices)
  fold(module_nodes, init: empty_symbol_index(), f: (index, module_node) =>
    let module_path = authored_name_at(source_indices: source_indices, node: module_node)
    let items = module_items(n: module_node)
    let with_items = fold(items, init: index, f: (acc, item) =>
      symbol_index_insert_item(
        index: acc,
        module_path: module_path,
        item: item,
        source_indices: source_indices
      )
    )
    symbol_index_insert_unique_disj_variant_aliases(
      index: with_items,
      module_path: module_path,
      items: items,
      source_indices: source_indices,
      corpus_variant_counts: corpus_variant_counts,
      corpus_item_counts: corpus_item_counts
    )
  )
}

fn build_symbol_index_census_raw(modules: List<ResolvedModule>, source_indices: Map<String, NewlineIndex>) -> SymbolIndex {
  build_symbol_index_census_raw_nodes(module_nodes: census_module_nodes(modules: modules), source_indices: source_indices)
}

data census_borrowed_sig_resolution_note: String = "Borrowed-sig hoist (namespace lane): the census stores raw pre-typecheck fn nodes, so a borrowed generic fn's return leaked bare type-param leaves (T/V/E) and owner-local names into consumers — the local/borrowed asymmetry (locals resolve once per module in resolve_item_types with type params bound as TypeVariables; borrows got the raw node per lookup). Pass 2 resolves each borrowable GENERIC fn signature's return ONCE at census build, in a synthetic env at the OWNER's containment position (module_path = the candidate's declaring module; symbol_index = the completed pass-1 census; type params bound via env_with_type_variable_bindings) — order-independent (resolution reads only the completed raw census, never a partial one), once per decl (never per lookup — the per-lookup variant re-resolved recursive carriers to the depth bound on every call), and staged fail-closed: ANY resolution diagnostic keeps the raw binding, so the consumer-side refusal surface is unchanged (upgraded | raw is a typed frontier, not a widen). Scope: fn sigs with value params (params non-empty; type params may be zero — a NON-generic fn's return can still USE a generic type, e.g. Outcome<Medium<String>>, and needs the same owner-position expansion for variant-payload substitution); 0-arg fns and aliases share a census shape (body stripped) and stay raw pending a discriminator."

fn census_fn_sig_env(census: SymbolIndex, module_path: String, tp_names: List<String>, source_indices: Map<String, NewlineIndex>) -> TypeEnv {
  let base = TypeEnv {
    module_path: module_path,
    bindings: empty_map(),
    str_bindings: empty_map(),
    ancestry_str_bindings: empty_map(),
    parents: [],
    recursive_types: [],
    recursive_type_set: empty_map(),
    inductive_fields: empty_map(),
    source_indices: source_indices,
    intern_table: empty_intern_table(),
    source_visible_names: empty_map(),
    symbol_index: census
  }
  env_with_type_variable_bindings(env: base, tp_names: tp_names)
}

fn census_binding_is_borrowable_fn_sig(binding: TypeBinding, source_indices: Map<String, NewlineIndex>) -> Bool {
  let node = binding.resolved
  node.connective == NoConnective
    && (node.children |> count) == 0
    && node.body == none
    && node.transport == none
    && node.inferred != none
    && (node.params |> count) > 0
}

fn census_qualify_sig_return_binding(binding: TypeBinding, module_path: String, census: SymbolIndex, source_indices: Map<String, NewlineIndex>) -> TypeBinding {
  let node = binding.resolved
  let env = census_fn_sig_env(census: census, module_path: module_path, tp_names: [], source_indices: source_indices)
  TypeBinding {
    name: binding.name,
    resolved: node_with_inferred(n: node, inferred: qualify_borrowed_inferred(inferred: node.inferred, owner_module_path: module_path, env: env, excluded: empty_map())),
    provenance: binding.provenance
  }
}

fn census_upgrade_sig_binding(binding: TypeBinding, module_path: String, census: SymbolIndex, source_indices: Map<String, NewlineIndex>, tp_names: List<String>) -> TypeBinding {
  if (tp_names |> count) > 0 {
    let node = binding.resolved
    match node.inferred {
      Present { value: Resolved { node: raw_ret } } =>
        let env = census_fn_sig_env(census: census, module_path: module_path, tp_names: tp_names, source_indices: source_indices)
        let ret_result = resolve_node(n: raw_ret, env: env, module_name: module_path)
        if (ret_result.diagnostics |> count) == 0 {
          let preserved = preserve_nominal_brand_on_resolve(identity: raw_ret, structural: ret_result.resolved, brand_name: authored_name_at(source_indices: source_indices, node: raw_ret), source_indices: source_indices)
          TypeBinding {
            name: binding.name,
            resolved: node_with_inferred(n: node, inferred: Present { value: Resolved { node: preserved } }),
            provenance: binding.provenance
          }
        } else { binding }
      _ => binding
    }
  } else { binding }
}

fn stamp_field_type_from_decl_params(field_type: Node, serving_decl: Node, source_indices: Map<String, NewlineIndex>) -> Node {
  if (serving_decl.params |> count) == 0 || field_type.inferred != none {
    field_type
  } else {
    let is_bare = (field_type.children |> count) == 0 && field_type.connective == NoConnective && (field_type.params |> count) == 0
    if is_bare {
      let nm = type_node_label(n: field_type, source_indices: source_indices)
      let is_param = fold(
        serving_decl.params |> map(p => generic_param_name_at(n: p, source_indices: source_indices)),
        init: false,
        f: (acc, pn) => acc || pn == nm
      )
      if is_param { node_with_inferred(n: field_type, inferred: Present { value: TypeVariable { id: nm } }) } else { field_type }
    } else { field_type }
  }
}

fn stamp_type_param_occurrences(n: Node, param_names: Map<String, Bool>, source_indices: Map<String, NewlineIndex>) -> Node {
  let is_bare = (n.children |> count) == 0 && n.connective == NoConnective && (n.params |> count) == 0
  if is_bare {
    if n.inferred == none {
      let nm = type_node_label(n: n, source_indices: source_indices)
      match map_get(param_names, nm) {
        Present { value: _ } => node_with_inferred(n: n, inferred: Present { value: TypeVariable { id: nm } })
        _ => n
      }
    } else { n }
  } else {
    node_with_children(n: n, children: n.children |> map(c => stamp_type_param_occurrences(n: c, param_names: param_names, source_indices: source_indices)))
  }
}

fn census_upgrade_type_decl_binding(binding: TypeBinding, module_path: String, census: SymbolIndex, source_indices: Map<String, NewlineIndex>) -> TypeBinding {
  let node = binding.resolved
  let param_names = node.params |> map(p => generic_param_name_at(n: p, source_indices: source_indices))
  let excluded = fold(
    param_names,
    init: map_insert(empty_map(), binding.name, true),
    f: (acc, nm) => map_insert(acc, nm, true)
  )
  let env = census_fn_sig_env(census: census, module_path: module_path, tp_names: param_names, source_indices: source_indices)
  TypeBinding {
    name: binding.name,
    resolved: qualify_decl_reference_positions(n: node, owner_module_path: module_path, env: env, excluded: excluded),
    provenance: binding.provenance
  }
}

fn census_qualify_leaf_binding(binding: TypeBinding, module_path: String, census: SymbolIndex, source_indices: Map<String, NewlineIndex>) -> TypeBinding {
  let node = binding.resolved
  let excluded = fold(
    node.params |> map(p => generic_param_name_at(n: p, source_indices: source_indices)),
    init: map_insert(empty_map(), binding.name, true),
    f: (acc, nm) => map_insert(acc, nm, true)
  )
  let env = census_fn_sig_env(census: census, module_path: module_path, tp_names: [], source_indices: source_indices)
  TypeBinding {
    name: binding.name,
    resolved: node_with_inferred(n: node, inferred: qualify_borrowed_inferred(inferred: node.inferred, owner_module_path: module_path, env: env, excluded: excluded)),
    provenance: binding.provenance
  }
}

fn census_upgrade_binding(binding: TypeBinding, module_path: String, census: SymbolIndex, source_indices: Map<String, NewlineIndex>) -> TypeBinding {
  if census_binding_is_borrowable_fn_sig(binding: binding, source_indices: source_indices) {
    let tp_names = fn_type_param_names(item: binding.resolved, source_indices: source_indices)
    if (tp_names |> count) > 0 {
      census_upgrade_sig_binding(binding: binding, module_path: module_path, census: census, source_indices: source_indices, tp_names: tp_names)
    } else {
      census_qualify_sig_return_binding(binding: binding, module_path: module_path, census: census, source_indices: source_indices)
    }
  } else if (binding.resolved.connective != NoConnective) {
    census_upgrade_type_decl_binding(binding: binding, module_path: module_path, census: census, source_indices: source_indices)
  } else if binding.resolved.inferred != none {
    census_qualify_leaf_binding(binding: binding, module_path: module_path, census: census, source_indices: source_indices)
  } else { binding }
}

fn census_upgrade_type_expr(raw: Node, env: TypeEnv, module_path: String, source_indices: Map<String, NewlineIndex>) -> Node {
  if raw.connective != NoConnective && (raw.children |> count) > 0 {
    let fields2 = raw.children |> map(f =>
      match f.inferred {
        Present { value: Resolved { node: ft } } =>
          node_with_inferred(n: f, inferred: Present { value: Resolved { node: census_upgrade_type_expr(raw: ft, env: env, module_path: module_path, source_indices: source_indices) } })
        _ => f
      }
    )
    node_with_children(n: raw, children: fields2)
  } else {
    let r = resolve_node(n: raw, env: env, module_name: module_path)
    if (r.diagnostics |> count) == 0 {
      preserve_nominal_brand_on_resolve(identity: raw, structural: r.resolved, brand_name: authored_name_at(source_indices: source_indices, node: raw), source_indices: source_indices)
    } else { raw }
  }
}

fn census_upgrade_service_item(item: Node, module_path: String, census: SymbolIndex, source_indices: Map<String, NewlineIndex>) -> Node {
  let env = census_fn_sig_env(census: census, module_path: module_path, tp_names: [], source_indices: source_indices)
  let ops2 = item.children |> map(c =>
    match c.inferred {
      Present { value: Resolved { node: raw_out } } =>
        node_with_inferred(n: c, inferred: Present { value: Resolved { node: census_upgrade_type_expr(raw: raw_out, env: env, module_path: module_path, source_indices: source_indices) } })
      _ => c
    }
  )
  node_with_children(n: item, children: ops2)
}

fn census_with_resolved_fn_sigs(index: SymbolIndex, source_indices: Map<String, NewlineIndex>) -> SymbolIndex {
  let entry_keys = sorted_map_keys(index.entries)
  let entries2 = fold(entry_keys, init: index.entries, f: (acc, k) =>
    match map_get(index.entries, k) {
      Present { value: node } =>
        let upgraded = census_upgrade_binding(
          binding: TypeBinding { name: qualified_last_segment(name: k), resolved: node, provenance: SubValueUnknown },
          module_path: qualified_all_but_last(name: k),
          census: index,
          source_indices: source_indices
        )
        if upgraded.resolved == node { acc } else { map_insert(acc, k, upgraded.resolved) }
      Absent => acc
    }
  )
  let bare_keys = sorted_map_keys(index.global_bare)
  let global2 = fold(bare_keys, init: index.global_bare, f: (acc, k) =>
    match map_get(index.global_bare, k) {
      Present { value: GlobalBareUniqueBinding { module_path: mp, binding: b } } =>
        let b2 = census_upgrade_binding(binding: b, module_path: mp, census: index, source_indices: source_indices)
        if b2.resolved == b.resolved { acc } else { map_insert(acc, k, GlobalBareUniqueBinding { module_path: mp, binding: b2 }) }
      Present { value: GlobalBareAmbiguousBinding { candidates: cands } } =>
        let cands2 = cands |> map(c => GlobalBareCandidate {
          module_path: c.module_path,
          binding: census_upgrade_binding(binding: c.binding, module_path: c.module_path, census: index, source_indices: source_indices)
        })
        map_insert(acc, k, GlobalBareAmbiguousBinding { candidates: cands2 })
      Absent => acc
    }
  )
  let service_keys = sorted_map_keys(index.services)
  let services2 = fold(service_keys, init: index.services, f: (acc, k) =>
    match map_get(index.services, k) {
      Present { value: sentry } =>
        let upgraded = census_upgrade_service_item(item: sentry.item, module_path: sentry.module_path, census: index, source_indices: source_indices)
        if upgraded == sentry.item { acc } else { map_insert(acc, k, ServiceCensusEntry { module_path: sentry.module_path, item: upgraded }) }
      Absent => acc
    }
  )
  SymbolIndex { entries: entries2, global_bare: global2, services: services2 }
}

fn build_symbol_index_census(modules: List<ResolvedModule>, source_indices: Map<String, NewlineIndex>) -> SymbolIndex {
  let raw = build_symbol_index_census_raw(modules: modules, source_indices: source_indices)
  census_with_resolved_fn_sigs(index: raw, source_indices: source_indices)
}

data census_layering_note: String = "Layered census (namespace-resolution-design.md 7.5: fill = whole tree; policy gates lookup, never fill). The closure census is byte-identical to the no-fill build — bare visibility, variant-alias corpus gating, and services stay closure-scoped, so a pool homonym cannot shift what a compiled module's bare names mean (measured on the whole-tree gate: a single whole-pool census vanished bare GET/Persistent/JsonValue across 28 witness rows via the corpus-count gate and unique-to-ambiguous flips). Census-only fill modules are PARSE-GRADE (tokenize + parse, never resolve: fill imports point into the compile closure or another tree view, and resolving fill against a fill-only pool fabricated 797 unresolved-import diagnostics about the view, not the modules) and enter a QUALIFIED-ONLY entries underlay — no bare reach INTO fill is needed because cross-tree references are qualified, the migration direction. The cli_run reconcile additionally underlays each typechecked module's OWN tree-closure bare census (root modules plus import-reached pool modules — gate parity by construction: e.g. dag witnesses' bare LiveTreeDisposition is declared only in v2.std.live_tree but import-reached from the dag tree)."

fn build_symbol_index_census_nodes(module_nodes: List<Node>, source_indices: Map<String, NewlineIndex>) -> SymbolIndex {
  let raw = build_symbol_index_census_raw_nodes(module_nodes: module_nodes, source_indices: source_indices)
  census_with_resolved_fn_sigs(index: raw, source_indices: source_indices)
}

data underlay_fill_direction_note: String = "Fill composition overlays the CLOSURE onto the shared underlay, never the reverse. Both directions denote the same map (union of key sets, closure wins the intersection); only the cost grain differs — the underlay is a per-index memo, so walking its keys charges every entry O(|whole pool|) for an index that differs by its own closure. Receipt: docs/plans/fill-composition-overlay-direction-receipt.md. Witness: symbol_index_fill_overlay_direction_test."

fn symbol_index_with_bare_fill(closure: SymbolIndex, tree: SymbolIndex) -> SymbolIndex {
  let global2 = map_merge(tree.global_bare, closure.global_bare)
  let services2 = map_merge(tree.services, closure.services)
  SymbolIndex { entries: closure.entries, global_bare: global2, services: services2 }
}

fn build_symbol_index_qualified_fill(modules: List<Node>, source_indices: Map<String, NewlineIndex>) -> SymbolIndex {
  let raw = fold(modules, init: empty_symbol_index(), f: (index, module_node) =>
    let module_path = authored_name_at(source_indices: source_indices, node: module_node)
    let items = module_items(n: module_node)
    let with_items = fold(items, init: index, f: (acc, item) =>
      match local_binding_for_item(item: item, source_indices: source_indices) {
        Absent => acc
        Present { value: binding } =>
          symbol_index_insert(index: acc, qualified_name: concat(concat(module_path, "."), binding.name), resolved: binding.resolved)
      }
    )
    let counts = disj_variant_name_counts(items: items, source_indices: source_indices)
    fold(items, init: with_items, f: (acc, item) =>
      match item.connective {
        Disj =>
          fold(item.children, init: acc, f: (a2, child) =>
            let vname = authored_name_at(source_indices: source_indices, node: child)
            match map_get(counts, vname) {
              Present { value: 1 } =>
                symbol_index_insert(index: a2, qualified_name: concat(concat(module_path, "."), vname), resolved: item)
              _ => a2
            }
          )
        _ => acc
      }
    )
  )
  census_with_resolved_fn_sigs(index: raw, source_indices: source_indices)
}

fn symbol_index_with_qualified_fill(closure: SymbolIndex, fill: SymbolIndex) -> SymbolIndex {
  let entries2 = map_merge(fill.entries, closure.entries)
  SymbolIndex { entries: entries2, global_bare: closure.global_bare, services: closure.services }
}

data direct_import_export_precedence_note: String = "Direct-selected exports beat transitive leaks (2026-07-16, the #6663 x #6686 main-red). The ancestry union folds each direct import's WHOLE flattened cache (its own exports AND everything it inherited), so a later import's transitively-leaked homonym could overlay an earlier import's OWN export that this module's import statement explicitly selects - import v2.std.algebra { Monoid } lost 'Monoid' to dag-root std.algebra riding v2.std.node's ancestry via std.types, and #6663's field-presence wall read the wrong shape at 28 sites. This overlay re-applies, in import order, each direct import's OWN export surface (interface.env.str_bindings - locals only, never its ancestry) restricted to the names the import statement makes visible (specific_names; is_all = the parent's whole local surface, type-variable names filtered per the std.types precedent). Winner semantics: direct-selected vs transitive leak = direct wins (lexical nearest-wins, the containment ruling one hop out - the sanctioned 1c universe is own declarations UNION direct import lists); direct vs direct = unchanged import-order overlay-wins (the ledgered peer-fork ruling, 2026-07-11: later import wins, conflict stays LEDGERED on binding_forks); leak vs leak = unchanged union winner; KERNEL names are never overridden (overlay_skips_kernel_name: kernel_type_set, the container_type_arity names List/Set/Map/Witness, plus Unit/Optional/Present/Absent) - the kernel scope layer stays positionally above imports per the same ruling, because builtin typing (first, skip, string ops) grounds on kernel identities and the v2 substrate models of those concepts (v2.std.collection List=FreeMonoid, Optional; v2.std.text String) are the known dual-representation debt, resolved corpus-wide by kernel-wins today. Full precedence, nearest first: locals > kernel > direct-selected > transitive union. The fork LEDGER is untouched - rows still record every union conflict; this layer only corrects which binding serves lookups. DISSOLVES WHEN namespace Rule-1 lands (containment tree is the naming authority; imports become parse errors) - the union leak itself disappears and this overlay with it. Receipt: direct_import_precedence_over_transitive_leak_test (green arm = selected name resolves the selected module's shape regardless of import order; red control = the field wall still refuses the true shape's missing fields, with that arm's modules placed so the homonym is census-UNAMBIGUOUS by containment (realleaf under the consumer's own parent, leakleaf under a sibling parent) - a census-ambiguous name stands the wall down BY DESIGN (presence_check_census_gate_note), so without that placement the control asserts a diagnostic the gate exists to suppress and silently measures the gate instead of the overlay; ledger arm = the fork row is still recorded)."

fn overlay_skips_kernel_name(name: String) -> Bool {
  is_kernel_type(name: name)
    || is_container_type(name: name)
    || name == "Unit"
    || name == "Optional"
    || name == "Present"
    || name == "Absent"
}

fn overlay_direct_import_exports(ancestry_str_bindings: Map<String, TypeBinding>, resolved_imports: List<ResolvedImport>, parent_index: Map<String, TypedModule>) -> Map<String, TypeBinding> {
  fold(resolved_imports, init: ancestry_str_bindings, f: (acc, imp) =>
    match map_get(parent_index, imp.module_path) {
      Present { value: typed_parent } =>
        let export_surface = interface_env_for_import(module_path: imp.module_path, parent_env: typed_parent.interface.env)
        let selected = if imp.is_all {
          export_surface.str_bindings |> map_keys |> filter(name => is_type_variable_name(name: name) == false)
        } else {
          imp.specific_names
        }
        fold(selected, init: acc, f: (bacc, name) =>
          if overlay_skips_kernel_name(name: name) {
            bacc
          } else {
            match map_get(export_surface.str_bindings, name) {
              Present { value: binding } => map_insert(bacc, name, binding)
              Absent => bacc
            }
          }
        )
      Absent => acc
    }
  )
}

fn build_type_env(module: ResolvedModule, parent_index: Map<String, TypedModule>, source_indices: Map<String, NewlineIndex>, intern_table: InternTable, symbol_index: SymbolIndex) -> BuildTypeEnvResult {
  let source_indices = fold(map_keys(kernel_type_set), init: source_indices, f: (acc, name) =>
    map_insert(acc, concat("<kernel:", name, ">"), build_newline_index(file: concat("<kernel:", name, ">"), source: name))
  )
  let source_indices = fold(["Optional", "Present", "Absent", "value", "none"], init: source_indices, f: (acc, name) =>
    map_insert(acc, concat("<kernel:", name, ">"), build_newline_index(file: concat("<kernel:", name, ">"), source: name))
  )
  let intern_table = seed_kernel_intern_table(intern_table: intern_table)
  let kernel_bindings_base = fold(
    map_keys(kernel_type_set),
    init: empty_map(),
    f: (acc, name) => map_insert(acc, intern(table: intern_table, s: name).id, TypeBinding {
      name: name,
      resolved: Node { name: name, span: kernel_span(name: name), ident_span: Present { value: kernel_span(name: name) }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData },
      provenance: SubValueUnknown
    })
  )
  let unit_span = kernel_span(name: "Unit")
  let kernel_bindings = map_insert(kernel_bindings_base, intern(table: intern_table, s: "Unit").id, TypeBinding {
    name: "Unit",
    resolved: Node { name: "Unit", span: unit_span, ident_span: Present { value: unit_span }, children: [], connective: Conj, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData },
    provenance: SubValueUnknown
  })
  let present_value_field = Node { name: "value", span: kernel_span(name: "value"), ident_span: Present { value: kernel_span(name: "value") }, children: [], connective: NoConnective, params: [], inferred: Present { value: TypeVariable { id: "present_value" } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let present_variant = Node { name: "Present", span: kernel_span(name: "Present"), ident_span: Present { value: kernel_span(name: "Present") }, children: [present_value_field], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let absent_variant = Node { name: "Absent", span: kernel_span(name: "Absent"), ident_span: Present { value: kernel_span(name: "Absent") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let kernel_optional = Node { name: "Optional", span: kernel_span(name: "Optional"), ident_span: Present { value: kernel_span(name: "Optional") }, children: [present_variant, absent_variant], connective: Disj, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let kernel_bindings = map_insert(kernel_bindings, intern(table: intern_table, s: "Optional").id, TypeBinding { name: "Optional", resolved: kernel_optional, provenance: SubValueUnknown })

  let node_fields = inductive_fields_list_to_map(fields: compiler_inductive_fields)
  let kernel_recursive_types = map_keys(compiler_recursive_types) |> map(name => intern(table: intern_table, s: name).id)
  let kernel_recursive_type_set = fold(map_keys(compiler_recursive_types), init: empty_map(), f: (acc, name) => map_insert(acc, intern(table: intern_table, s: name).id, true))
  let kernel = TypeEnv { module_path: "", bindings: kernel_bindings, str_bindings: str_bindings_from_bindings(bindings: kernel_bindings), ancestry_str_bindings: empty_map(), parents: [], recursive_types: kernel_recursive_types, recursive_type_set: kernel_recursive_type_set, inductive_fields: node_fields, source_indices: source_indices, intern_table: intern_table, source_visible_names: empty_map(), symbol_index: empty_symbol_index() }

  let module_name_str = authored_name_at(source_indices: source_indices, node: module.module)
  let import_parents = flat_map(module.resolved_imports, imp =>
    match map_get(parent_index, imp.module_path) {
      Present { value: typed_parent } => [interface_env_for_import(module_path: imp.module_path, parent_env: typed_parent.interface.env)]
      Absent => []
    }
  )
  let scope_parents = concat(import_parents, [kernel])
  let import_diags = flat_map(module.resolved_imports, imp => match map_get(parent_index, imp.module_path) { Present { value: _ } => [] Absent => [make_error_node(diagnostic: InternalError { message: concat("missing parent environment for imported module '", imp.module_path, "' while typechecking '", module_name_str, "'"), span: imp.target_module.value.span }, module_name: module_name_str)] })
  let namespace_alias_diags = flat_map(module_items(n: module.module), item =>
    if is_namespace_alias_item(item: item, source_indices: source_indices) {
      match namespace_alias_target_path(item: item, source_indices: source_indices) {
        Absent => []
        Present { value: target_path } =>
          match symbol_index_lookup(index: symbol_index, qualified_name: target_path) {
            Present { value: _ } => []
            Absent => [make_error_node(diagnostic: UnresolvedType { name: target_path, span: item.span }, module_name: module_name_str)]
          }
      }
    } else { [] }
  )

  let local_bindings = fold(module_items(n: module.module), init: empty_map(), f: (acc, item) =>
    if is_namespace_alias_item(item: item, source_indices: source_indices) {
      match namespace_alias_target_path(item: item, source_indices: source_indices) {
        Absent => acc
        Present { value: target_path } =>
          match symbol_index_lookup(index: symbol_index, qualified_name: target_path) {
            Absent => acc
            Present { value: target_node } =>
              let binding = namespace_alias_binding_for_target(
                item: item,
                target_node: target_node,
                source_indices: source_indices
              )
              map_insert(acc, intern(table: intern_table, s: binding.name).id, binding)
          }
      }
    } else {
      match local_binding_for_item(item: item, source_indices: source_indices) {
        Present { value: binding } => map_insert(acc, intern(table: intern_table, s: binding.name).id, binding)
        Absent => acc
      }
    }
  )

  let param_bindings = fold(module_items(n: module.module), init: empty_map(), f: (acc, item) =>
    let is_type_decl = match map_get(local_bindings, intern(table: intern_table, s: authored_name_at(source_indices: source_indices, node: item)).id) { Present { value: _ } => true  Absent => false }
    if item.params |> count > 0 && is_type_decl && item.body == none {
      let result = fold(item.params, init: acc, f: (pacc, p) =>
        map_insert(pacc, intern(table: intern_table, s: authored_name_at(source_indices: source_indices, node: p)).id, nominal_type_binding(name: authored_name_at(source_indices: source_indices, node: p)))
      )
      result
    } else { acc }
  )
  let local_name_set = fold(local_bindings |> map_keys, init: empty_map(), f: (acc, ident) => map_insert(acc, ident, true))
  let all_local_bindings = map_merge(local_bindings, param_bindings)

  let kernel_cache = type_env_cache_from_bindings(
    bindings: kernel_bindings,
    source_indices: source_indices,
    cycle_set_str: compiler_recursive_name_set()
  )
  let import_union = union_parent_type_env_caches(resolved_imports: module.resolved_imports, parent_index: parent_index)
  let import_cache = import_union.cache
  let binding_forks = import_union.conflicts
  let ancestry_cache = if module.resolved_imports |> count == 1 {
    import_cache
  } else {
    merge_type_env_cache(base: import_cache, overlay: kernel_cache)
  }

  let local_deps_map = fold(all_local_bindings |> map_values, init: empty_map(), f: (acc, b) =>
    map_insert(acc, b.name, deps_excluding_leaf_self(b: b, source_indices: source_indices))
  )
  let local_str_bindings = fold(all_local_bindings |> map_values, init: empty_map(), f: (acc, b) =>
    map_insert(acc, b.name, b)
  )

  let all_deps_map = map_merge(ancestry_cache.deps_map, local_deps_map)
  let new_cycle_names = detect_type_cycles_kahn(deps_map: all_deps_map, bindings: local_str_bindings)
  let new_cycle_set_str = fold(new_cycle_names, init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
  let cycle_set_str = map_merge(map_merge(ancestry_cache.cycle_set_str, new_cycle_set_str), compiler_recursive_name_set())
  let cycle_set = map(sorted_map_keys(cycle_set_str), name => intern(table: intern_table, s: name).id)
  let cross_type_set = fold(sorted_map_keys(cycle_set_str), init: empty_map(), f: (acc, name) => map_insert(acc, intern(table: intern_table, s: name).id, true))
  let cycle_set_for_inductive = fold(sorted_map_keys(cycle_set_str), init: empty_set(), f: (acc, name) => set_insert(acc, name))
  let local_inductive_fields = build_item_inductive_fields(items: module_items(n: module.module), recursive_type_set: cycle_set_for_inductive, source_indices: source_indices)
  let parent_inductive_fields = match scope_parents |> first {
    Present { value: head_parent } =>
      fold(scope_parents |> skip(1), init: head_parent.inductive_fields, f: (acc, parent) =>
        merge_inductive_fields(left: acc, right: parent.inductive_fields)
      )
    Absent => empty_map()
  }
  let merged_inductive_fields = merge_inductive_fields(left: parent_inductive_fields, right: local_inductive_fields)
  let ancestry_str_bindings = overlay_direct_import_exports(
    ancestry_str_bindings: ancestry_cache.str_bindings,
    resolved_imports: module.resolved_imports,
    parent_index: parent_index
  )
  let svn_local = fold(map_keys(local_str_bindings), init: empty_map(), f: (acc, n) => map_insert(acc, n, true))
  let svn_kernel = fold(map_keys(kernel_type_set), init: svn_local, f: (acc, n) => map_insert(acc, n, true))
  let source_visible_names = fold(module.resolved_imports, init: svn_kernel, f: (acc, imp) =>
    if imp.is_all {
      match map_get(parent_index, imp.module_path) {
        Present { value: parent_mod } =>
          let a1 = fold(map_keys(parent_mod.interface.env.str_bindings), init: acc, f: (x, n) => map_insert(x, n, true))
          fold(map_keys(parent_mod.interface.env.ancestry_str_bindings), init: a1, f: (x, n) => map_insert(x, n, true))
        Absent => acc
      }
    } else {
      fold(imp.specific_names, init: acc, f: (x, n) => map_insert(x, n, true))
    }
  )
  let unresolved_env = TypeEnv { module_path: module_name_str, bindings: all_local_bindings, str_bindings: local_str_bindings, ancestry_str_bindings: ancestry_str_bindings, parents: scope_parents, recursive_types: cycle_set, recursive_type_set: cross_type_set, inductive_fields: merged_inductive_fields, source_indices: source_indices, intern_table: intern_table, source_visible_names: source_visible_names, symbol_index: symbol_index }
  let resolved = resolve_env_bindings(env: unresolved_env, module_name: module_name_str, local_names: local_name_set, deps_map: all_deps_map)
  let resolved_env_out = resolved.env
  let resolved_diags = resolved.diagnostics
  let final_env = TypeEnv { module_path: module_name_str,
    bindings: resolved_env_out.bindings,
    str_bindings: resolved_env_out.str_bindings,
    ancestry_str_bindings: resolved_env_out.ancestry_str_bindings,
    parents: scope_parents,
    recursive_types: resolved_env_out.recursive_types,
    recursive_type_set: resolved_env_out.recursive_type_set,
    inductive_fields: resolved_env_out.inductive_fields,
    source_indices: resolved_env_out.source_indices,
    intern_table: intern_table,
    source_visible_names: source_visible_names,
    symbol_index: resolved_env_out.symbol_index,
  }
  let cache_str_bindings = map_merge(final_env.ancestry_str_bindings, final_env.str_bindings)
  let type_env_cache = TypeEnvCache {
    deps_map: all_deps_map,
    str_bindings: cache_str_bindings,
    cycle_set_str: cycle_set_str,
    variant_locals: empty_map()
  }
  BuildTypeEnvResult {
    env: final_env,
    cache: type_env_cache,
    diagnostics: concat(concat(import_diags, namespace_alias_diags), resolved_diags),
    binding_forks: binding_forks
  }
}

fn build_type_env_unresolved(module: ResolvedModule, parent_index: Map<String, TypedModule>, source_indices: Map<String, NewlineIndex>, intern_table: InternTable) -> BuildTypeEnvResult {
  let intern_table = fold(map_keys(kernel_type_set), init: intern_table, f: (t, name) => intern(table: t, s: name).table)
  let intern_table = fold(["Optional"], init: intern_table, f: (t, name) => intern(table: t, s: name).table)
  let zero_span = no_span()
  let kernel_bindings = fold(
    map_keys(kernel_type_set),
    init: empty_map(),
    f: (acc, name) => map_insert(acc, intern(table: intern_table, s: name).id, TypeBinding { name: name, resolved: Node { name: name, span: kernel_span(name: name), ident_span: Present { value: kernel_span(name: name) }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }, provenance: SubValueUnknown })
  )
  let present_value_field = Node { name: "value", span: kernel_span(name: "value"), ident_span: Present { value: kernel_span(name: "value") }, children: [], connective: NoConnective, params: [], inferred: Present { value: TypeVariable { id: "present_value" } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let present_variant = Node { name: "Present", span: kernel_span(name: "Present"), ident_span: Present { value: kernel_span(name: "Present") }, children: [present_value_field], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let absent_variant = Node { name: "Absent", span: kernel_span(name: "Absent"), ident_span: Present { value: kernel_span(name: "Absent") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let kernel_optional = Node { name: "Optional", span: kernel_span(name: "Optional"), ident_span: Present { value: kernel_span(name: "Optional") }, children: [present_variant, absent_variant], connective: Disj, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let kernel_bindings = map_insert(kernel_bindings, intern(table: intern_table, s: "Optional").id, TypeBinding { name: "Optional", resolved: kernel_optional, provenance: SubValueUnknown })
  let kernel = TypeEnv { module_path: "", bindings: kernel_bindings, str_bindings: str_bindings_from_bindings(bindings: kernel_bindings), ancestry_str_bindings: empty_map(), parents: [], recursive_types: [], recursive_type_set: empty_map(), inductive_fields: empty_map(), source_indices: source_indices, intern_table: intern_table, source_visible_names: empty_map(), symbol_index: empty_symbol_index() }

  let module_name_str = authored_name_at(source_indices: source_indices, node: module.module)
  let import_parents = flat_map(module.resolved_imports, imp =>
    match map_get(parent_index, imp.module_path) {
      Present { value: typed_parent } => [interface_env_for_import(module_path: imp.module_path, parent_env: typed_parent.interface.env)]
      Absent => []
    }
  )
  let scope_parents = concat(import_parents, [kernel])
  let local_bindings = fold(module_items(n: module.module), init: empty_map(), f: (acc, item) =>
    if is_namespace_alias_item(item: item, source_indices: source_indices) {
      acc
    } else {
    let item_ident = intern(table: intern_table, s: authored_name_at(source_indices: source_indices, node: item)).id
    let has_structure = item.connective != NoConnective
    if has_structure {
      let type_node = Node { name: item.name, span: item.span, ident_span: item.ident_span, children: item.children, connective: item.connective, params: [], inferred: none, return_cardinality: item.return_cardinality, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
      map_insert(acc, item_ident, TypeBinding { name: authored_name_at(source_indices: source_indices, node: item), resolved: type_node, provenance: SubValueUnknown })
    } else if item.inferred != none && item.params |> count == 0 && item.body == none {
      let alias_node = Node { name: item.name, span: item.span, ident_span: item.ident_span, children: [], connective: NoConnective, params: [], inferred: item.inferred, return_cardinality: item.return_cardinality, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
      map_insert(acc, item_ident, TypeBinding { name: authored_name_at(source_indices: source_indices, node: item), resolved: alias_node, provenance: SubValueUnknown })
    } else if item.transport == none && item.children |> count > 0 {
      let ref_node = nominal_ref_node(name: authored_name_at(source_indices: source_indices, node: item), span: item.span, ident_span: item.ident_span)
      map_insert(acc, item_ident, TypeBinding { name: authored_name_at(source_indices: source_indices, node: item), resolved: ref_node, provenance: SubValueUnknown })
    } else if item.properties |> count > 0 && item.connective == NoConnective && item.transport == none && item.inferred == none && item.params |> count == 0 {
      map_insert(acc, item_ident, nominal_type_binding(name: authored_name_at(source_indices: source_indices, node: item)))
    } else {
      acc
    }
    }
  )
  let kernel_cache = type_env_cache_from_bindings(
    bindings: kernel_bindings,
    source_indices: source_indices,
    cycle_set_str: compiler_recursive_name_set()
  )
  let import_cache = union_parent_type_env_caches(resolved_imports: module.resolved_imports, parent_index: parent_index).cache
  let ancestry_cache = if module.resolved_imports |> count == 1 {
    import_cache
  } else {
    merge_type_env_cache(base: import_cache, overlay: kernel_cache)
  }

  let local_deps_map = fold(local_bindings |> map_values, init: empty_map(), f: (acc, b) =>
    map_insert(acc, b.name, deps_excluding_leaf_self(b: b, source_indices: source_indices))
  )
  let local_str_bindings = fold(local_bindings |> map_values, init: empty_map(), f: (acc, b) =>
    map_insert(acc, b.name, b)
  )

  let all_deps_map = map_merge(ancestry_cache.deps_map, local_deps_map)
  let new_cycle_names = detect_type_cycles_kahn(deps_map: all_deps_map, bindings: local_str_bindings)
  let new_cycle_set_str = fold(new_cycle_names, init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
  let cycle_set_str = map_merge(map_merge(ancestry_cache.cycle_set_str, new_cycle_set_str), compiler_recursive_name_set())
  let cycle_set = map(sorted_map_keys(cycle_set_str), name => intern(table: intern_table, s: name).id)
  let cross_type_set = fold(sorted_map_keys(cycle_set_str), init: empty_map(), f: (acc, name) => map_insert(acc, intern(table: intern_table, s: name).id, true))
  let cycle_set_for_inductive = fold(sorted_map_keys(cycle_set_str), init: empty_set(), f: (acc, name) => set_insert(acc, name))
  let local_inductive_fields = build_item_inductive_fields(items: module_items(n: module.module), recursive_type_set: cycle_set_for_inductive, source_indices: source_indices)
  let parent_inductive_fields = match scope_parents |> first {
    Present { value: head_parent } =>
      fold(scope_parents |> skip(1), init: head_parent.inductive_fields, f: (acc, parent) =>
        merge_inductive_fields(left: acc, right: parent.inductive_fields)
      )
    Absent => empty_map()
  }
  let merged_inductive_fields = merge_inductive_fields(left: parent_inductive_fields, right: local_inductive_fields)
  let ancestry_str_bindings = ancestry_cache.str_bindings
  let visible_str_bindings = map_merge(ancestry_str_bindings, local_str_bindings)
  let unresolved_env = TypeEnv { module_path: module_name_str, bindings: local_bindings, str_bindings: local_str_bindings, ancestry_str_bindings: ancestry_str_bindings, parents: scope_parents, recursive_types: cycle_set, recursive_type_set: cross_type_set, inductive_fields: merged_inductive_fields, source_indices: source_indices, intern_table: intern_table, source_visible_names: empty_map(), symbol_index: empty_symbol_index() }
  let type_env_cache = TypeEnvCache {
    deps_map: all_deps_map,
    str_bindings: visible_str_bindings,
    cycle_set_str: cycle_set_str,
    variant_locals: empty_map()
  }
  BuildTypeEnvResult { env: unresolved_env, cache: type_env_cache, diagnostics: [], binding_forks: [] }
}

fn build_item_info(item: Node, source_indices: Map<String, NewlineIndex>, module_name: String) -> ItemInfo {
  let kind = item_kind(item: item)
  let res_names = item.uses |> map(u => resource_use_name_at(n: u, source_indices: source_indices))
  let item_name_str = authored_name_at(source_indices: source_indices, node: item)
  match kind {
    FuncItem =>
      ItemInfo {
        name: item_name_str,
        module_name: module_name,
        kind: kind,
        service_names: if item.body == none { [] } else { collect_typed_service_calls(texpr: item.body.value, source_indices: source_indices) },
        resource_names: res_names,
        params: item.params,
        is_self_recursive: false,
        has_non_tail_self_call: false
      }
    FnItem =>
      ItemInfo {
        name: item_name_str,
        module_name: module_name,
        kind: kind,
        service_names: if item.body == none { [] } else { collect_typed_service_calls(texpr: item.body.value, source_indices: source_indices) },
        resource_names: res_names,
        params: item.params,
        is_self_recursive: if item.body == none { false } else { expr_has_self_call(texpr: item.body.value, fn_name: item_name_str, source_indices: source_indices) },
        has_non_tail_self_call: if item.body == none { false } else { expr_has_non_tail_self_call(texpr: item.body.value, fn_name: item_name_str, in_tail: true, source_indices: source_indices) }
      }
    _ =>
      ItemInfo {
        name: item_name_str,
        module_name: module_name,
        kind: kind,
        service_names: [],
        resource_names: res_names,
        params: item.params,
        is_self_recursive: false,
        has_non_tail_self_call: false
      }
  }
}

fn analyze_item(item: Node, env: TypeEnv, module_name: String) -> ItemContribution {
  let resolved = resolve_item_types(item: item, env: env, module_name: module_name)
  let ritem = resolved.item
  let is_func = ritem.params |> count > 0
  let is_zero_arg_func = ritem.params |> count == 0 && ritem.inferred != none && ritem.body != none
  let func_sig = if is_func || is_zero_arg_func {
    let declared_rt = if ritem.inferred != none {
      Present { value: resolved_type(n: ritem) }
    } else {
      none
    }
    Present { value: DeclaredFuncSig {
      name: authored_name_at(source_indices: env.source_indices, node: ritem),
      params: ritem.params,
      inferred: declared_rt,
      is_async: ritem.uses |> count > 0,
      output_provenance: [],
      variant_provenance: empty_map()
    } }
  } else {
    none
  }
  let svc_entries = if ritem.transport != none && ritem.children |> count > 0 {
    ritem.children |> map(c => service_op_entry(child: c, source_indices: env.source_indices))
  } else {
    []
  }
  let svc_local = if ritem.transport != none && ritem.children |> count > 0 {
    let root = namespace_root_from_properties(properties: ritem.properties, name: authored_name_at(source_indices: env.source_indices, node: ritem), source_indices: env.source_indices)
    Present { value: nominal_type_binding(name: root) }
  } else {
    none
  }
  ItemContribution {
    resolved_item: ritem,
    resolve_diagnostics: resolved.diagnostics,
    func_sig: func_sig,
    svc_entries: svc_entries,
    svc_local: svc_local,
    item_info: build_item_info(item: ritem, source_indices: env.source_indices, module_name: module_name)
  }
}

fn fold_module_contributions(remaining: List<ItemContribution>,
    resolved_items: List<Node>,
    func_sigs: Map<String, DeclaredFuncSig>,
    svc_registry: Map<String, List<OpEntry>>,
    svc_locals: Map<String, TypeBinding>,
    item_registry: Map<String, ItemInfo>,
    diag_chunks: List<List<ErrorNode>>,
    source_indices: Map<String, NewlineIndex>) -> LocalContributionState {
  match remaining |> first {
    Absent =>
      LocalContributionState {
        resolved_items: resolved_items,
        func_sigs: func_sigs,
        svc_registry: svc_registry,
        svc_locals: svc_locals,
        item_registry: item_registry,
        diag_chunks: diag_chunks
      }
    Present { value: contribution } =>
      let next_func_sigs = match contribution.func_sig {
        Present { value: sig } => map_insert(func_sigs, sig.name, sig)
        Absent => func_sigs
      }
      let next_svc_registry = if contribution.svc_entries |> count > 0 {
        map_insert(svc_registry, authored_name_at(source_indices: source_indices, node: contribution.resolved_item), contribution.svc_entries)
      } else {
        svc_registry
      }
      let next_svc_locals = match contribution.svc_local {
        Present { value: binding } => map_insert(svc_locals, binding.name, binding)
        Absent => svc_locals
      }
      fold_module_contributions(
        remaining: remaining |> skip(1),
        resolved_items: list_push(resolved_items, contribution.resolved_item),
        func_sigs: next_func_sigs,
        svc_registry: next_svc_registry,
        svc_locals: next_svc_locals,
        item_registry: map_insert(item_registry, contribution.item_info.name, contribution.item_info),
        diag_chunks: list_push(diag_chunks, contribution.resolve_diagnostics),
        source_indices: source_indices
      )
  }
}

data constructor_binding_authority: String = "Constructor-owner ruling (§1c): a module's constructor namespace is FLAT — its own coproduct declarations plus its DIRECT imports' contributions, never transitive ancestry. Each arm name binds to its owning coproduct NODE (the binding edge carries the owner; no name re-lookup, so the owner need not be name-visible). One arm name bound to two DIFFERENT owners in one file = VariantCollision at env construction (the per-file wall); the same declaration reached via two import paths is one owner, not a collision. Kernel coproduct arms (Optional/Witness/...) merge low-priority afterwards, prelude semantics."

fn insert_variant_owner_checked(state: VariantFoldState, arm_name: String, owner: Node, source_indices: Map<String, NewlineIndex>, module_name: String) -> VariantFoldState {
  match map_get(state.locals, arm_name) {
    Present { value: prev } =>
      let prev_name = authored_name_at(source_indices: source_indices, node: prev.resolved)
      let owner_name = authored_name_at(source_indices: source_indices, node: owner)
      let same_owner = prev_name == owner_name
        && prev.resolved.span.file == owner.span.file
        && prev.resolved.span.start == owner.span.start
      if same_owner {
        state
      } else {
        VariantFoldState {
          locals: state.locals,
          collision_errors: concat(state.collision_errors, [make_error_node(
            diagnostic: VariantCollision { variant: arm_name, enum1: prev_name, enum2: owner_name, span: owner.span },
            module_name: module_name
          )])
        }
      }
    Absent =>
      VariantFoldState {
        locals: map_insert(state.locals, arm_name, TypeBinding { name: arm_name, resolved: owner, provenance: SubValueUnknown }),
        collision_errors: state.collision_errors
      }
  }
}

fn bind_coproduct_item_arms(state: VariantFoldState, item: Node, source_indices: Map<String, NewlineIndex>, module_name: String) -> VariantFoldState {
  fold(item.children, init: state, f: (vacc, child) =>
    insert_variant_owner_checked(
      state: vacc,
      arm_name: authored_name_at(source_indices: source_indices, node: child),
      owner: item,
      source_indices: source_indices,
      module_name: module_name
    )
  )
}

fn build_local_variants(items: List<Node>, source_indices: Map<String, NewlineIndex>, module_name: String, init: VariantFoldState) -> VariantFoldState {
  fold(items, init: init, f: (acc, item) =>
    let item_is_coproduct = item.connective == Disj
    if item_is_coproduct {
      bind_coproduct_item_arms(state: acc, item: item, source_indices: source_indices, module_name: module_name)
    } else { acc }
  )
}

data merge_global_bare_variant_locals_cost_note: String = "Cost shape (bare-minimum-cost, DESIGN 6): the census-eligible variant-owner pairs depend only on global_bare and the name-census si — whole-closure facts identical for every module — so build_global_bare_variant_locals computes them ONCE per closure in typecheck_with_census_extra and the base map threads down realize_module -> typecheck_module -> build_module_context. The former per-module shape rescanned the whole census and re-inserted every eligible pair into every module's locals: 464 modules x 12,554 census keys = 5.8M iterations and 1.29M persistent-map inserts = 31s of the host_effect_realize entry compile (typecheck-perf investigation, 2026-07-31; PR 7398 landed build_global_bare_variant_locals beside the per-module fold but never wired it). map_merge(base, state.locals) is value-identical to the old fold: overlay wins on collision exactly as the old skip-if-present arm kept state's binding, and the old checked-insert collision arm was unreachable (presence was checked before insert), so the global merge contributed zero collision errors then and now. Fidelity of the hoisted si: authored_name_at reads names identically under the raw closure source_indices and the kernel-augmented env.source_indices (kernel spans compute the same name in both arms; non-kernel misses fall back to node.name in both), and the census owners all live in closure files, so eligibility is unchanged."

fn merge_global_bare_variant_locals(
  state: VariantFoldState,
  global_variant_base: Map<String, TypeBinding>
) -> VariantFoldState {
  VariantFoldState {
    locals: map_merge(global_variant_base, state.locals),
    collision_errors: state.collision_errors
  }
}

fn build_global_bare_census(modules: List<ResolvedModule>, source_indices: Map<String, NewlineIndex>) -> Map<String, GlobalBareLookupState> {
  build_symbol_index_census(modules: modules, source_indices: source_indices).global_bare
}

fn build_global_bare_variant_locals(
  global_bare: Map<String, GlobalBareLookupState>,
  source_indices: Map<String, NewlineIndex>
) -> Map<String, TypeBinding> {
  fold(global_bare |> map_keys, init: empty_map(), f: (acc, name) =>
    match map_get(global_bare, name) {
      Present { value: GlobalBareUniqueBinding { module_path: _, binding: binding } } =>
        let owner = binding.resolved
        if owner.connective == Disj && has_child_named(n: owner, name: name, source_indices: source_indices) {
          map_insert(acc, name, TypeBinding { name: name, resolved: owner, provenance: SubValueUnknown })
        } else {
          acc
        }
      _ => acc
    }
  )
}

data reexport_chain_authority: String = "A module re-exports its specific-name imports (get_exported_names in v1.compiler.resolve), so `import proxy { B }` where proxy itself imports B is an EXPLICIT import under the §1c ruling — the binder follows the specific-name chain to the defining module's coproduct (the import DAG is acyclic, so the recursion terminates; a chain hop that dead-ends binds nothing and the use site fails closed as UnresolvedType). Glob (is_all) imports bind the target's OWN coproduct arms only — glob re-export pass-through is not modeled here, matching get_exported_names which excludes is_all imports from the export surface."

fn empty_variant_export_surface() -> VariantExportSurface {
  VariantExportSurface { arm_owners: empty_map(), enum_items: empty_map() }
}

fn add_coproduct_to_variant_surface(acc: VariantExportSurface, item: Node, source_indices: Map<String, NewlineIndex>) -> VariantExportSurface {
  let enum_items = map_insert(acc.enum_items, authored_name_at(source_indices: source_indices, node: item), item)
  let arm_owners = fold(item.children, init: acc.arm_owners, f: (arms, child) =>
    map_insert(arms, authored_name_at(source_indices: source_indices, node: child), item)
  )
  VariantExportSurface { arm_owners: arm_owners, enum_items: enum_items }
}

fn collect_own_variant_export_surface(items: List<Node>, source_indices: Map<String, NewlineIndex>) -> VariantExportSurface {
  fold(items, init: empty_variant_export_surface(), f: (acc, item) =>
    let item_is_coproduct = item.connective == Disj
    if item_is_coproduct {
      add_coproduct_to_variant_surface(acc: acc, item: item, source_indices: source_indices)
    } else { acc }
  )
}

fn merge_name_from_proxy_surface(acc: VariantExportSurface, proxy: VariantExportSurface, name: String) -> VariantExportSurface {
  let with_arm = match map_get(proxy.arm_owners, name) {
    Present { value: owner } => VariantExportSurface { arm_owners: map_insert(acc.arm_owners, name, owner), enum_items: acc.enum_items }
    Absent => acc
  }
  match map_get(proxy.enum_items, name) {
    Present { value: item } => VariantExportSurface { arm_owners: with_arm.arm_owners, enum_items: map_insert(with_arm.enum_items, name, item) }
    Absent => with_arm
  }
}

fn reexport_variant_surface_fragment(imp: Node, surfaces: Map<String, VariantExportSurface>, source_indices: Map<String, NewlineIndex>) -> VariantExportSurface {
  let proxy_path = import_module_path_at(imp: imp, source_indices: source_indices)
  match map_get(surfaces, proxy_path) {
    Absent => empty_variant_export_surface()
    Present { value: proxy } =>
      fold(import_specific_names_at(n: imp, source_indices: source_indices), init: empty_variant_export_surface(), f: (acc, name) =>
        merge_name_from_proxy_surface(acc: acc, proxy: proxy, name: name)
      )
  }
}

fn merge_variant_surface_fragments(acc: VariantExportSurface, frag: VariantExportSurface) -> VariantExportSurface {
  VariantExportSurface {
    arm_owners: map_merge(acc.arm_owners, frag.arm_owners),
    enum_items: map_merge(acc.enum_items, frag.enum_items)
  }
}

fn build_variant_export_surface(tm: TypedModule, surfaces: Map<String, VariantExportSurface>, source_indices: Map<String, NewlineIndex>) -> VariantExportSurface {
  let own = collect_own_variant_export_surface(items: tm.items, source_indices: source_indices)
  let reexports = fold(
    module_imports(n: tm.module) |> filter(imp => !import_is_all(n: imp)),
    init: empty_variant_export_surface(),
    f: (acc, imp) =>
      merge_variant_surface_fragments(
        acc: acc,
        frag: reexport_variant_surface_fragment(imp: imp, surfaces: surfaces, source_indices: source_indices)
      )
  )
  VariantExportSurface {
    arm_owners: map_merge(reexports.arm_owners, own.arm_owners),
    enum_items: map_merge(reexports.enum_items, own.enum_items)
  }
}

fn bind_imported_name_from_surface(state: VariantFoldState, surface: VariantExportSurface, name: String, source_indices: Map<String, NewlineIndex>, module_name: String) -> VariantFoldState {
  let after_enum = match map_get(surface.enum_items, name) {
    Present { value: item } => bind_coproduct_item_arms(state: state, item: item, source_indices: source_indices, module_name: module_name)
    Absent => state
  }
  match map_get(surface.arm_owners, name) {
    Present { value: owner } => insert_variant_owner_checked(state: after_enum, arm_name: name, owner: owner, source_indices: source_indices, module_name: module_name)
    Absent => after_enum
  }
}

fn build_imported_variants(resolved_imports: List<ResolvedImport>, parent_index: Map<String, TypedModule>, variant_surfaces: Map<String, VariantExportSurface>, source_indices: Map<String, NewlineIndex>, module_name: String, init: VariantFoldState) -> VariantFoldState {
  fold(resolved_imports, init: init, f: (acc, imp) =>
    let with_glob = if imp.is_all {
      let source_items = match map_get(parent_index, imp.module_path) {
        Present { value: parent_tm } => parent_tm.items
        Absent => []
      }
      fold(source_items, init: acc, f: (iacc, item) =>
        let item_is_coproduct = item.connective == Disj
        if item_is_coproduct {
          bind_coproduct_item_arms(state: iacc, item: item, source_indices: source_indices, module_name: module_name)
        } else { iacc }
      )
    } else { acc }
    fold(imp.specific_names, init: with_glob, f: (nacc, name) =>
      let surface = match map_get(variant_surfaces, imp.module_path) {
        Present { value: s } => s
        Absent => empty_variant_export_surface()
      }
      bind_imported_name_from_surface(state: nacc, surface: surface, name: name, source_indices: source_indices, module_name: module_name)
    )
  )
}

fn build_module_context(contributions: List<ItemContribution>,
    parent_index: Map<String, TypedModule>,
    variant_surfaces: Map<String, VariantExportSurface>,
    resolved_imports: List<ResolvedImport>,
    env: TypeEnv,
    module_name: String,
    global_variant_base: Map<String, TypeBinding>) -> ModuleContext {
  let local = fold_module_contributions(
    remaining: contributions,
    resolved_items: [],
    func_sigs: empty_map(),
    svc_registry: empty_map(),
    svc_locals: empty_map(),
    item_registry: empty_map(),
    diag_chunks: [],
    source_indices: env.source_indices
  )
  let local_variant_fold = build_local_variants(
    items: local.resolved_items,
    source_indices: env.source_indices,
    module_name: module_name,
    init: VariantFoldState { locals: empty_map(), collision_errors: [] }
  )
  let variant_fold = merge_global_bare_variant_locals(
    state: build_imported_variants(
      resolved_imports: resolved_imports,
      parent_index: parent_index,
      variant_surfaces: variant_surfaces,
      source_indices: env.source_indices,
      module_name: module_name,
      init: local_variant_fold
    ),
    global_variant_base: global_variant_base
  )
  let variant_collision_errors = variant_fold.collision_errors
  let env_variant_locals = merge_kernel_variant_locals_low_priority(env: env, locals: variant_fold.locals)
  let census_scope = fold(env.symbol_index.services |> map_keys, init: InferScopeComponents { svc_registry: empty_map(), svc_locals: empty_map() }, f: (acc, sname) =>
    match map_get(env.symbol_index.services, sname) {
      Present { value: sentry } =>
        let sitem = sentry.item
        let entries = sitem.children |> map(c =>
          OpEntry {
            name: authored_name_at(source_indices: env.source_indices, node: c),
            outputs: inferred_to_outputs(
              inferred: qualify_borrowed_inferred(inferred: c.inferred, owner_module_path: sentry.module_path, env: env, excluded: empty_map()),
              span: c.span,
              source_indices: env.source_indices
            ),
            params: c.params
          }
        )
        let root = namespace_root_from_properties(properties: sitem.properties, name: sname, source_indices: env.source_indices)
        InferScopeComponents {
          svc_registry: map_insert(acc.svc_registry, sname, entries),
          svc_locals: map_insert(acc.svc_locals, root, nominal_type_binding(name: root))
        }
      Absent => acc
    }
  )
  let merged_scope = merge_scope_from_imports(
    remaining: resolved_imports,
    parent_index: parent_index,
    env: env,
    svc_registry: map_merge(census_scope.svc_registry, local.svc_registry),
    svc_locals: map_merge(census_scope.svc_locals, local.svc_locals)
  )
  let parent_envs = flat_map(resolved_imports, imp =>
    match map_get(parent_index, imp.module_path) {
      Present { value: typed_parent } => [typed_parent.func_env]
      Absent => []
    }
  )
  let resolve_result = resolve_func_sigs(
    declared_sigs: local.func_sigs,
    parent_envs: parent_envs,
    items: local.resolved_items,
    module_name: module_name,
    source_indices: env.source_indices
  )
  let all_locals = fold(merged_scope.svc_locals |> map_values, init: env_variant_locals, f: (acc, binding) =>
    map_insert(acc, binding.name, binding)
  )
  ModuleContext {
    resolved_items: local.resolved_items,
    func_env: resolve_result.func_env,
    svc_registry: merged_scope.svc_registry,
    locals: all_locals,
    variant_locals: env_variant_locals,
    item_registry: local.item_registry,
    diagnostics: concat(concat(flat_map(local.diag_chunks, c => c), resolve_result.diagnostics), variant_collision_errors)
  }
}

type TypecheckModuleResult {
  typed: TypedModule
  diagnostics: List<ErrorNode>
  binding_forks: List<TypeEnvCacheMergeConflict>
}

fn typecheck_module(resolved: ResolvedModule, parent_index: Map<String, TypedModule>, variant_surfaces: Map<String, VariantExportSurface>, source_indices: Map<String, NewlineIndex>, intern_table: InternTable, symbol_index: SymbolIndex, global_variant_base: Map<String, TypeBinding>) -> TypecheckModuleResult {
  let env_result = build_type_env(module: resolved, parent_index: parent_index, source_indices: source_indices, intern_table: intern_table, symbol_index: symbol_index)
  let env = env_result.env
  let env_cache = env_result.cache
  let env_diags = env_result.diagnostics

  let env_errors = env_diags |> filter(d => is_error_diagnostic(d: d.diagnostic))
  let seed_diags = builtin_kernel_seed_diagnostics()
  if env_errors |> count > 0 {
    return TypecheckModuleResult {
      typed: TypedModule {
        module: resolved.module,
        items: [],
        type_env: env,
        type_env_cache: env_cache,
        interface: build_module_interface(
          module_path: authored_name_at(source_indices: source_indices, node: resolved.module),
          module: resolved.module,
          env: env,
          cache: env_cache,
          source_indices: source_indices
        ),
        func_env: ResolvedFuncEnv { name: authored_name_at(source_indices: source_indices, node: resolved.module), local: empty_map(), parents: [] },
        item_registry: empty_map(),
        occurrence_transport: Present { value: resolved.occurrence_transport },
      },
      diagnostics: concat(env_diags, seed_diags),
      binding_forks: env_result.binding_forks
    }
  }

  let resolved_module_name = authored_name_at(source_indices: source_indices, node: resolved.module)
  let contributions = map(module_items(n: resolved.module), item =>
    analyze_item(item: item, env: env, module_name: resolved_module_name)
  )
  let ctx = build_module_context(
    contributions: contributions,
    parent_index: parent_index,
    variant_surfaces: variant_surfaces,
    resolved_imports: resolved.resolved_imports,
    env: env,
    module_name: resolved_module_name,
    global_variant_base: global_variant_base
  )

  let data_locals = fold(ctx.resolved_items, init: ctx.locals, f: (acc, item) =>
    if item.body != none && item.params |> count == 0 && item.inferred == none && item.type_annotation != none {
      map_insert(acc, authored_name_at(source_indices: source_indices, node: item), TypeBinding { name: authored_name_at(source_indices: source_indices, node: item), resolved: item.type_annotation.value, provenance: SubValueUnknown })
    } else {
      acc
    }
  )
  let infer_scope = InferScope {
    type_env: env,
    func_env: ctx.func_env,
    locals: data_locals,
    body_locals: empty_map(),
    match_bound_names: empty_map(),
    module_name: resolved_module_name,
    service_registry: ctx.svc_registry,
    item_registry: ctx.item_registry,
    caller_decl_name: "",
    lambda_param_provenance: empty_map()
  }
  let typed_item_results = infer_items(items: ctx.resolved_items, scope: infer_scope)
  let typed_items = map(typed_item_results, tir => tir.item)
  let infer_diags = flat_map(typed_item_results, tir => tir.diagnostics)
  let updated_func_env = populate_output_provenance(
    typed_items: typed_items, func_env: ctx.func_env,
    type_env: env, locals: data_locals
  )
  let reannotated_items = map(typed_items, item =>
    if item.is_self_recursive && item.body != none {
      Node {
        name: item.name, span: item.span, ident_span: item.ident_span,
        children: item.children, params: item.params,
        inferred: item.inferred, return_cardinality: item.return_cardinality,
        uses: item.uses,
        body: Present { value: annotate_descent_evidence(
          body: item.body.value, fn_name: authored_name_at(source_indices: source_indices, node: item), params: item.params,
          type_env: env, scope_locals: data_locals,
          func_env: updated_func_env
        ) },
        connective: item.connective, transport: item.transport,
        properties: item.properties, type_annotation: item.type_annotation,
        is_self_recursive: item.is_self_recursive,
        has_non_tail_self_call: item.has_non_tail_self_call,
        match_pattern: item.match_pattern, expr_data: item.expr_data
      }
    } else { item }
  )
  let module_type_env_cache = TypeEnvCache {
    deps_map: env_cache.deps_map,
    str_bindings: env_cache.str_bindings,
    cycle_set_str: env_cache.cycle_set_str,
    variant_locals: ctx.variant_locals
  }
  let typed_base = module_node(name: resolved_module_name, imports: module_imports(n: resolved.module), items: ctx.resolved_items, span: resolved.module.span)
  let typed_module = with(typed_base, { ident_span: resolved.module.ident_span })

  TypecheckModuleResult {
    typed: TypedModule {
      module: typed_module,
      items: reannotated_items,
      type_env: env,
      type_env_cache: module_type_env_cache,
      interface: build_module_interface(
        module_path: resolved_module_name,
        module: typed_module,
        env: env,
        cache: module_type_env_cache,
        source_indices: source_indices
      ),
      func_env: updated_func_env,
      item_registry: ctx.item_registry,
      occurrence_transport: Present { value: resolved.occurrence_transport },
    },
    diagnostics: frontier_occurrence_budget_checked(
      module_name: resolved_module_name,
      module_span: resolved.module.span,
      diagnostics: concat(env_diags, ctx.diagnostics, infer_diags, seed_diags)),
    binding_forks: env_result.binding_forks
  }
}

fn typecheck_module_isolated(resolved: ResolvedModule, parent_index: Map<String, TypedModule>, source_indices: Map<String, NewlineIndex>, intern_table: InternTable) -> TypecheckModuleResult {
  typecheck_module(resolved: resolved, parent_index: parent_index, variant_surfaces: empty_map(), source_indices: source_indices, intern_table: intern_table, symbol_index: empty_symbol_index(), global_variant_base: empty_map())
}

type EnvResolveResult {
  env: TypeEnv
  diagnostics: List<ErrorNode>
}

type BindingResult {
  binding: TypeBinding
  diagnostics: List<ErrorNode>
}

type BindingsAccum {
  bindings: Map<Int, TypeBinding>
  str_bindings: Map<String, TypeBinding>
  diagnostics: List<ErrorNode>
}

fn resolve_env_bindings(env: TypeEnv, module_name: String, local_names: Map<Int, Bool>, deps_map: Map<String, List<String>>) -> EnvResolveResult {
  let remaining = map(
    filter(env.bindings |> map_values, b => map_contains_key(local_names, intern(table: env.intern_table, s: b.name).id)),
    b => b.name
  )
  topo_resolve_types(remaining: remaining, env: env, module_name: module_name, diagnostics: [], local_names: local_names, deps_map: deps_map, fuel: remaining |> count)
}

fn topo_resolve_types(
    remaining: List<String>,
    env: TypeEnv,
    module_name: String,
    diagnostics: List<ErrorNode>,
    local_names: Map<Int, Bool>,
    deps_map: Map<String, List<String>>,
    fuel: Int
) -> EnvResolveResult {
  if remaining |> count == 0 {
    return EnvResolveResult { env: env, diagnostics: diagnostics }
  }

  let remaining_set = fold(remaining, init: empty_set(), f: (acc, name) => set_insert(acc, name))
  let ready = filter(remaining, name =>
    match map_get(deps_map, name) {
      Present { value: deps } =>
        all(deps, dep => is_kernel_type(name: dep) || dep == "None" || dep == "" || is_recursive_type_by_name(env: env, name: dep) || set_contains(remaining_set, dep) == false)
      Absent => true
    }
  )

  if ready |> count == 0 {
    let stuck_accum = fold(remaining, init: BindingsAccum { bindings: env.bindings, str_bindings: env.str_bindings, diagnostics: [] }, f: (acc, name) =>
      let ident = intern(table: env.intern_table, s: name).id
      match map_get(env.bindings, ident) {
        Present { value: binding } =>
          let pre = binding.resolved
          let result = resolve_node(n: pre, env: env, module_name: module_name)
          let resolved = preserve_nominal_brand_on_resolve(
            identity: pre, structural: result.resolved, brand_name: binding.name, source_indices: env.source_indices)
          let updated_binding = TypeBinding { name: name, resolved: resolved, provenance: SubValueUnknown }
          BindingsAccum {
            bindings: map_insert(acc.bindings, ident, updated_binding),
            str_bindings: map_insert(acc.str_bindings, name, updated_binding),
            diagnostics: concat(acc.diagnostics, result.diagnostics)
          }
        Absent => acc
      }
    )
    return EnvResolveResult {
      env: TypeEnv { module_path: env.module_path, bindings: stuck_accum.bindings, str_bindings: stuck_accum.str_bindings, ancestry_str_bindings: env.ancestry_str_bindings, parents: env.parents, recursive_types: env.recursive_types, recursive_type_set: env.recursive_type_set, inductive_fields: env.inductive_fields, source_indices: env.source_indices, intern_table: env.intern_table, source_visible_names: env.source_visible_names, symbol_index: env.symbol_index },
      diagnostics: concat(diagnostics, stuck_accum.diagnostics)
    }
  }

  let ready_accum = fold(ready, init: BindingsAccum { bindings: env.bindings, str_bindings: env.str_bindings, diagnostics: [] }, f: (acc, name) =>
    let ident = intern(table: env.intern_table, s: name).id
    match map_get(env.bindings, ident) {
      Present { value: binding } =>
        let pre = binding.resolved
        let result = resolve_node(n: pre, env: env, module_name: module_name)
        let resolved = preserve_nominal_brand_on_resolve(
          identity: pre, structural: result.resolved, brand_name: binding.name, source_indices: env.source_indices)
        let updated_binding = TypeBinding { name: name, resolved: resolved, provenance: SubValueUnknown }
        BindingsAccum {
          bindings: map_insert(acc.bindings, ident, updated_binding),
          str_bindings: map_insert(acc.str_bindings, name, updated_binding),
          diagnostics: concat(acc.diagnostics, result.diagnostics)
        }
      Absent => acc
    }
  )

  let ready_set = fold(ready, init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
  let next_remaining = filter(remaining, name => emit_map_has(m: ready_set, key: name) == false)

  topo_resolve_types(
    remaining: next_remaining,
    env: TypeEnv { module_path: env.module_path, bindings: ready_accum.bindings, str_bindings: ready_accum.str_bindings, ancestry_str_bindings: env.ancestry_str_bindings, parents: env.parents, recursive_types: env.recursive_types, recursive_type_set: env.recursive_type_set, inductive_fields: env.inductive_fields, source_indices: env.source_indices, intern_table: env.intern_table, source_visible_names: env.source_visible_names, symbol_index: env.symbol_index },
    module_name: module_name,
    diagnostics: concat(diagnostics, ready_accum.diagnostics),
    local_names: local_names,
    deps_map: deps_map,
    fuel: fuel - 1
  )
}

fn collect_parent_envs(resolved: ResolvedModule, module_index: Map<String, TypedModule>, source_indices: Map<String, NewlineIndex>) -> ParentModulesResult {
  let modules = flat_map(resolved.resolved_imports, imp =>
    match map_get(module_index, imp.module_path) {
      Present { value: typed } => [typed]
      Absent => []
    }
  )
  let resolved_mod_name = authored_name_at(source_indices: source_indices, node: resolved.module)
  let diagnostics = flat_map(resolved.resolved_imports, imp =>
    match map_get(module_index, imp.module_path) {
      Present { value: _ } => []
      Absent => [make_error_node(diagnostic: InternalError { message: concat("missing parent environment for imported module '", imp.module_path, "' while ordering '", resolved_mod_name, "'"), span: imp.target_module.value.span }, module_name: resolved_mod_name)]
    }
  )
  ParentModulesResult { modules: modules, diagnostics: diagnostics }
}

fn variant_has_positional_payload_shape(variant: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  variant.children |> count == 1 && match variant.children |> first {
    Present { value: f } => field_node_name_at(n: f, source_indices: source_indices) == "0"
    Absent => false
  }
}

type EnumVariantShapeSets {
  fielded: Set<String>
  positional_payload: Set<String>
}

fn enum_variant_shape_sets_for_item(acc: EnumVariantShapeSets, item: Node, si: Map<String, NewlineIndex>, type_summaries: Map<String, TypeSummary>) -> EnumVariantShapeSets {
  let item_name = authored_name_at(source_indices: si, node: item)
  let is_enum = match map_get(type_summaries, item_name) {
    Present { value: summary } => match summary.repr {
      EnumRepr { unit_only: _ } => true
      _ => false
    }
    Absent => false
  }
  if is_enum {
    item.children |> fold(init: acc, f: (vacc, variant) =>
      let qualified = concat(item_name, "::", authored_name_at(source_indices: si, node: variant))
      let is_positional_payload = variant_has_positional_payload_shape(variant: variant, source_indices: si)
      let has_fields = variant.children |> count > 0
      if is_positional_payload {
        EnumVariantShapeSets { fielded: vacc.fielded, positional_payload: set_insert(vacc.positional_payload, qualified) }
      } else {
        if has_fields {
          EnumVariantShapeSets { fielded: set_insert(vacc.fielded, qualified), positional_payload: vacc.positional_payload }
        } else { vacc }
      }
    )
  } else { acc }
}

fn build_enum_variant_shape_sets(modules: List<TypedModule>, type_summaries: Map<String, TypeSummary>) -> EnumVariantShapeSets {
  modules |> fold(init: EnumVariantShapeSets { fielded: empty_set(), positional_payload: empty_set() }, f: (acc, m) =>
    m.items |> fold(init: acc, f: (inner, item) =>
      enum_variant_shape_sets_for_item(acc: inner, item: item, si: m.type_env.source_indices, type_summaries: type_summaries)
    )
  )
}

fn build_emit_graph_info(modules: List<TypedModule>) -> EmitGraphInfo {
  let init = EmitInfoBuildState {
    type_summaries: empty_map(),
    type_decl_items: empty_map(),
    fn_decl_items: empty_map()
  }
  let built_raw = modules |> fold(init: init, f: (state, typed_module) =>
    typed_module.items |> fold(init: state, f: (inner_state, item) =>
      add_emit_item_summary(state: inner_state, item: item, source_indices: typed_module.type_env.source_indices)
    )
  )
  let built = EmitInfoBuildState { type_summaries: close_fn_fields(summaries: built_raw.type_summaries), type_decl_items: built_raw.type_decl_items, fn_decl_items: built_raw.fn_decl_items }
  let all_recursive = modules |> fold(init: empty_set(), f: (acc, m) =>
    fold(map_keys(m.type_env.recursive_type_set), init: acc, f: (inner, ident) =>
      set_insert(inner, intern_str(table: m.type_env.intern_table, id: ident))
    )
  )
  let variant_shapes = build_enum_variant_shape_sets(modules: modules, type_summaries: built.type_summaries)
  let vtoe = derive_variant_to_enum(type_summaries: built.type_summaries)
  EmitGraphInfo {
    type_summaries: built.type_summaries,
    type_decl_items: built.type_decl_items,
    fn_decl_items: built.fn_decl_items,
    recursive_type_set: all_recursive,
    fielded_variants: variant_shapes.fielded,
    positional_payload_variants: variant_shapes.positional_payload,
    shared_types: empty_set(),
    ownership_index: empty_map(),
    movable: empty_set(),
    variant_to_enum: vtoe,
    owned_bindings: empty_set(),
    read_only_params_index: empty_map(),
    read_only_params: empty_set(),
    clone_bounded_type_params: empty_map(),
    map_key_required_type_names: empty_set(),
    clone_impl_required_type_params: empty_map(),
    fn_generic_param_names: [],
    fn_type_env: empty_type_env(),
    fn_return_type: none
  }
}

fn seed_kernel_intern_table(intern_table: InternTable) -> InternTable {
  let intern_table = fold(map_keys(kernel_type_set), init: intern_table, f: (t, name) => intern(table: t, s: name).table)
  let intern_table = fold(["Optional", "Present", "Absent", "value", "none"], init: intern_table, f: (t, name) => intern(table: t, s: name).table)
  fold(map_keys(compiler_recursive_types), init: intern_table, f: (t, name) => intern(table: t, s: name).table)
}

type RealizeState {
  module_index: Map<String, TypedModule>
  variant_surfaces: Map<String, VariantExportSurface>
  item_registry: Map<String, ItemInfo>
  diags_by_name: Map<String, List<ErrorNode>>
}

fn typecheck(graph: ModuleGraph, source_indices: Map<String, NewlineIndex>, intern_table: InternTable) -> TypedGraph {
  typecheck_with_census_extra(graph: graph, source_indices: source_indices, intern_table: intern_table, census_fill_modules: [], census_si: source_indices)
}

fn typecheck_with_census_extra(graph: ModuleGraph, source_indices: Map<String, NewlineIndex>, intern_table: InternTable, census_fill_modules: List<Node>, census_si: Map<String, NewlineIndex>) -> TypedGraph {
  let intern_table = seed_kernel_intern_table(intern_table: intern_table)
  let resolved_by_name = graph.modules |> fold(init: empty_map(), f: (acc, rm) =>
    map_insert(acc, authored_name_at(source_indices: source_indices, node: rm.module), rm)
  )
  let symbol_index = symbol_index_with_qualified_fill(
    closure: build_symbol_index_census(modules: graph.modules, source_indices: census_si),
    fill: build_symbol_index_qualified_fill(modules: census_fill_modules, source_indices: census_si)
  )
  let global_variant_base = build_global_bare_variant_locals(global_bare: symbol_index.global_bare, source_indices: source_indices)
  let state = graph.modules |> fold(init: RealizeState {
    module_index: empty_map(),
    variant_surfaces: empty_map(),
    item_registry: empty_map(),
    diags_by_name: empty_map()
  }, f: (st, rm) =>
    realize_module(
      name: authored_name_at(source_indices: source_indices, node: rm.module),
      resolved_by_name: resolved_by_name,
      state: st,
      source_indices: source_indices,
      intern_table: intern_table,
      symbol_index: symbol_index,
      global_variant_base: global_variant_base
    )
  )
  let modules = graph.modules |> flat_map(rm =>
    match map_get(state.module_index, authored_name_at(source_indices: source_indices, node: rm.module)) {
      Present { value: typed } => [typed]
      Absent => []
    }
  )
  let diag_chunks = graph.modules |> map(rm =>
    match map_get(state.diags_by_name, authored_name_at(source_indices: source_indices, node: rm.module)) {
      Present { value: d } => d
      Absent => []
    }
  )
  let expanded_registry = expand_transitive_services(modules: modules, registry: state.item_registry, remaining_passes: 5)
  TypedGraph { modules: modules, item_registry: expanded_registry, diagnostics: flat_map(diag_chunks, c => c) }
}

fn realize_module(
  name: String,
  resolved_by_name: Map<String, ResolvedModule>,
  state: RealizeState,
  source_indices: Map<String, NewlineIndex>,
  intern_table: InternTable,
  symbol_index: SymbolIndex,
  global_variant_base: Map<String, TypeBinding>
) -> RealizeState {
  match map_get(state.module_index, name) {
    Present { value: _ } => state
    Absent =>
      match map_get(resolved_by_name, name) {
        Absent => state
        Present { value: resolved } =>
          let dep_state = resolved.resolved_imports |> fold(init: state, f: (st, imp) =>
            realize_module(
              name: imp.module_path,
              resolved_by_name: resolved_by_name,
              state: st,
              source_indices: source_indices,
              intern_table: intern_table,
              symbol_index: symbol_index,
              global_variant_base: global_variant_base
            )
          )
          let parent_result = collect_parent_envs(resolved: resolved, module_index: dep_state.module_index, source_indices: source_indices)
          let tc_result = typecheck_module(resolved: resolved, parent_index: dep_state.module_index, variant_surfaces: dep_state.variant_surfaces, source_indices: source_indices, intern_table: intern_table, symbol_index: symbol_index, global_variant_base: global_variant_base)
          let typed = tc_result.typed
          let typed_path = authored_name_at(source_indices: source_indices, node: typed.module)
          RealizeState {
            module_index: map_insert(dep_state.module_index, typed_path, typed),
            variant_surfaces: map_insert(
              dep_state.variant_surfaces,
              typed_path,
              build_variant_export_surface(tm: typed, surfaces: dep_state.variant_surfaces, source_indices: source_indices)
            ),
            item_registry: map_merge(dep_state.item_registry, typed.item_registry),
            diags_by_name: map_insert(dep_state.diags_by_name, typed_path, concat(parent_result.diagnostics, tc_result.diagnostics))
          }
      }
  }
}

type StrBindingsRewireAccum {
  str_bindings: Map<String, TypeBinding>
  ancestry_str_bindings: Map<String, TypeBinding>
}

fn import_module_path_at(imp: Node, source_indices: Map<String, NewlineIndex>) -> String {
  authored_name_at(source_indices: source_indices, node: imp)
}

// `seen_names` is keyed rather than a `Set` because this population is read two ways: the module's
// own export set is tested for MEMBERSHIP (`local_names`), and each direct import's export set is
// ENUMERATED to accumulate the per-name exporter count. A `Set` in this substrate supports the
// first and not the second, so the enumeration had to be simulated by re-testing membership once
// per candidate name — the scan `direct_import_exporter_counts` replaces. One keyed carrier serves
// both readings; it is not a second representation of the set, it is the only one.
type ExportIndexModuleAccum {
  index: Map<String, TypeNameExportFacts>
  seen_names: Map<String, Bool>
}

// ONE POPULATION, ONE TRAVERSAL, TWO DERIVED PROJECTIONS. Both access patterns are legitimate;
// scanning the whole module population twice to get them is not. This is a BUILD-LOCAL
// accumulator for the rewiring pass and deliberately not a new compiler authority: when the
// post-hoc rewiring is deleted — early tiers born correct, so nothing needs repairing — this type
// is deleted with it rather than surviving as a second census beside SymbolIndex.
type ExportedTypeRelationBuild {
  by_name: Map<String, TypeNameExportFacts>
  by_module: Map<String, Map<String, Bool>>
}

data export_index_canonical_is_the_fold_element_note: String = "§6 bare-minimum cost, same receipt as module_exported_type_names_cost_note. The export-index module walk's canonical binding was `filter(bindings |> map_values, b => b.name == name) |> first` — a rescan of the WHOLE binding map (with a fresh Vec allocation) once per distinct name, i.e. O(|bindings|^2) per module per closure assembly. It is dead work by construction: the enclosing fold walks THAT SAME map_values sequence in order, and seen_names skips every repeat, so the first element whose name matches is always the fold's own current element. `canonical = binding` is therefore the identical value, not an approximation of it — the order both expressions read is one traversal of one map value, so the equality does not depend on map_values being stable ACROSS runs (§5941 determinism), only on the two reads of the same value agreeing, which the rewrite removes the need for entirely."

fn export_index_module_state(acc: Map<String, TypeNameExportFacts>, m: TypedModule) -> ExportIndexModuleAccum {
  fold(m.type_env.bindings |> map_values, init: ExportIndexModuleAccum { index: acc, seen_names: empty_map() }, f: (state, binding) =>
    let name = binding.name
    if map_contains_key(state.seen_names, name) {
      state
    } else {
      let canonical = binding
      let seen_names = map_insert(state.seen_names, name, true)
      let index = match map_get(state.index, name) {
        Absent =>
          map_insert(state.index, name, TypeNameExportFacts { exporter_count: 1, canonical_binding: Present { value: canonical } })
        Present { value: facts } =>
          map_insert(state.index, name, TypeNameExportFacts {
            exporter_count: facts.exporter_count + 1,
            canonical_binding: Present { value: canonical }
          })
      }
      ExportIndexModuleAccum { index: index, seen_names: seen_names }
    }
  )
}

// Both projections read ONE relation — the (module, exported-name) pairs — and each used to be
// built by its own whole-corpus fold that walked every module's bindings again. The second was in
// fact already computed and thrown away: the per-module `seen_names` accumulated inside the module
// walk IS that module's distinct binding-name set, which is exactly what the separate by-module
// builder recomputed. One traversal now yields both, and the discarded value is the returned one.
fn export_index_merge_module_both(acc: ExportedTypeRelationBuild, m: TypedModule, source_indices: Map<String, NewlineIndex>) -> ExportedTypeRelationBuild {
  let state = export_index_module_state(acc: acc.by_name, m: m)
  ExportedTypeRelationBuild {
    by_name: state.index,
    by_module: map_insert(acc.by_module, authored_name_at(source_indices: source_indices, node: m.module), state.seen_names)
  }
}

fn build_export_indexes(modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>) -> ExportedTypeRelationBuild {
  fold(modules, init: ExportedTypeRelationBuild { by_name: empty_map(), by_module: empty_map() }, f: (acc, m) =>
    export_index_merge_module_both(acc: acc, m: m, source_indices: source_indices))
}

data module_exported_type_names_cost_note: String = "Cost shape (§6 bare-minimum cost, floor batch-3 receipt 2026-07-25): the type names a module exports is ONE derived fact — a set — and both consumers in rewire_type_env_import_str_binding_identity read it. Before this row it existed twice: the caller's per-module `local_names` fold, and `module_exports_type_name`, a LINEAR SCAN (map_values allocates a Vec of every binding, then filters by name) re-run once per (consumer module x inherited key x direct import). Measured on 79 discovery entries: that pass alone was 191.1s of a 331.9s resolve wall (99% of all rewire time, 2.4s/entry) while the other two rewire passes together cost 1.8s. Hoisting the set per module and testing membership made the per-name exporter count O(direct imports) instead of O(direct imports x |parent bindings|), with no change to the predicate it computes. That per-name scan is itself now gone: direct_import_exporter_counts accumulates the whole relation in one traversal of the same sets and rewire_canonical_rewrites reads it by key, so the pass no longer pays a scan per candidate name at all. The caller reads its own row out of the SAME index rather than re-folding it (review 42566) — the Absent arm computes the true value from this one authority, so it is a structurally-unreachable fallback that is still honest, never a fabricated default (DESIGN section 5)."

fn module_exported_type_names(m: TypedModule) -> Map<String, Bool> {
  fold(m.type_env.bindings |> map_values, init: empty_map(), f: (acc, b) => map_insert(acc, b.name, true))
}

fn direct_import_export_name_sets(m: TypedModule, export_name_index: Map<String, Map<String, Bool>>, source_indices: Map<String, NewlineIndex>) -> List<Map<String, Bool>> {
  flat_map(module_imports(n: m.module), imp =>
    let path = import_module_path_at(imp: imp, source_indices: source_indices)
    match map_get(export_name_index, path) {
      Present { value: names } => [names]
      Absent => []
    }
  )
}

// ONE PASS OVER THE IMPORT SETS, NOT ONE PASS PER CANDIDATE NAME. `direct_import_exporter_count`
// answered "how many direct imports export this name" by scanning every direct import's export set
// — and allocating a fresh list of the matching sets to take its length — once per inherited key.
// The question is asked for every key in the module's inherited keyspace, so the pass cost
// K x I set probes plus K list allocations, where K is that keyspace and I the direct-import count,
// to compute a relation whose whole content is one traversal of the same sets: O(sum |S_i| + K).
// The counts are accumulated here once per module and read by key.
//
// Equivalence is by counting, not by argument: each occurrence in `import_export_names` contributes
// exactly 1 to each of its names, which is what the filter-and-count did per name. A path listed
// twice among a module's imports therefore still counts twice, exactly as before — the reason this
// keeps the count rather than deriving the ">1" verdict from `TypeNameExportFacts.exporter_count`,
// which counts distinct closure modules and would silently disagree on that duplicate.
fn direct_import_exporter_counts(import_export_names: List<Map<String, Bool>>) -> Map<String, Int> {
  fold(import_export_names, init: empty_map(), f: (acc, names) =>
    fold(names |> map_keys, init: acc, f: (inner, name) =>
      match map_get(inner, name) {
        Present { value: seen } => map_insert(inner, name, seen + 1)
        Absent => map_insert(inner, name, 1)
      }
    )
  )
}

fn direct_import_exporter_count_of(exporter_counts: Map<String, Int>, name: String) -> Int {
  match map_get(exporter_counts, name) {
    Present { value: n } => n
    Absent => 0
  }
}

// THE DECISION, separated from the writing. Each name's verdict depends only on the two indexes,
// the module's own export set and its direct imports — never on what earlier names decided — so the
// per-name fold that used to thread both binding maps through every iteration was carrying state
// nothing read. What that threading costs is a count, and the count is what changes here: the old
// shape performed one insert into each FULL binding map per inherited name; the new shape performs
// one insert per name into a rewrites map holding only the names actually rewritten, then one
// merge per binding map. Whether each of those inserts also deep-copied its map is UNPROVEN here
// — the emitted `Rc::make_mut` copies only when the handle is shared, and no control in this
// change measures it — so the claim made is the structural one about how many writes reach the
// large maps, not a claim about the copy mechanism.
//
// Two facts make the restructure exactly equivalent rather than approximately so, and both are
// properties of the old code rather than assumptions about it: the verdict reads none of the
// accumulated bindings, and the str_bindings arm only ever OVERWRITES a key it already found
// present, so the key set of str_bindings is invariant across the fold and a later name's
// `map_get(str_bindings, name)` cannot observe an earlier iteration's insert.
fn rewire_canonical_rewrites(
  type_name_index: Map<String, TypeNameExportFacts>,
  exporter_counts: Map<String, Int>,
  local_names: Map<String, Bool>,
  inherited_keys: List<String>
) -> Map<String, TypeBinding> {
  fold(inherited_keys, init: empty_map(), f: (acc, name) =>
    match map_get(type_name_index, name) {
      Absent => acc
      Present { value: facts } =>
        if map_contains_key(local_names, name) || direct_import_exporter_count_of(exporter_counts: exporter_counts, name: name) > 1 || facts.exporter_count > 1 {
          acc
        } else {
          match facts.canonical_binding {
            Present { value: canonical } => map_insert(acc, name, canonical)
            Absent => acc
          }
        }
    }
  )
}

fn rewire_str_binding_overlay(str_bindings: Map<String, TypeBinding>, rewrites: Map<String, TypeBinding>) -> Map<String, TypeBinding> {
  fold(rewrites |> map_keys, init: empty_map(), f: (acc, name) =>
    match map_get(str_bindings, name) {
      Present { value: _ } =>
        match map_get(rewrites, name) {
          Present { value: canonical } => map_insert(acc, name, canonical)
          Absent => acc
        }
      Absent => acc
    }
  )
}

fn rewire_type_env_import_str_binding_identity(modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>) -> List<TypedModule> {
  let export_indexes = build_export_indexes(modules: modules, source_indices: source_indices)
  let type_name_index = export_indexes.by_name
  let export_name_index = export_indexes.by_module
  map(modules, m =>
    let local_names = match map_get(export_name_index, authored_name_at(source_indices: source_indices, node: m.module)) {
      Present { value: names } => names
      Absent => module_exported_type_names(m: m)
    }
    let import_export_names = direct_import_export_name_sets(m: m, export_name_index: export_name_index, source_indices: source_indices)
    let exporter_counts = direct_import_exporter_counts(import_export_names: import_export_names)
    let ancestry_keys = m.type_env.ancestry_str_bindings |> map_keys
    let str_keys = m.type_env.str_bindings |> map_keys
    let inherited_keys = concat(ancestry_keys, str_keys)
    let rewrites = rewire_canonical_rewrites(
      type_name_index: type_name_index,
      exporter_counts: exporter_counts,
      local_names: local_names,
      inherited_keys: inherited_keys
    )
    let rewired = StrBindingsRewireAccum {
      str_bindings: map_merge(m.type_env.str_bindings, rewire_str_binding_overlay(str_bindings: m.type_env.str_bindings, rewrites: rewrites)),
      ancestry_str_bindings: map_merge(m.type_env.ancestry_str_bindings, rewrites)
    }
    TypedModule {
      module: m.module,
      items: m.items,
      type_env: TypeEnv { module_path: m.type_env.module_path,
        bindings: m.type_env.bindings,
        str_bindings: rewired.str_bindings,
        ancestry_str_bindings: rewired.ancestry_str_bindings,
        parents: m.type_env.parents,
        recursive_types: m.type_env.recursive_types,
        recursive_type_set: m.type_env.recursive_type_set,
        inductive_fields: m.type_env.inductive_fields,
        source_indices: m.type_env.source_indices,
        intern_table: m.type_env.intern_table,
        source_visible_names: m.type_env.source_visible_names,
        symbol_index: m.type_env.symbol_index
      },
      type_env_cache: m.type_env_cache,
      interface: m.interface,
      func_env: m.func_env,
      item_registry: m.item_registry,
      occurrence_transport: m.occurrence_transport,
    }
  )
}

fn compiler_kernel_type_env(source_indices: Map<String, NewlineIndex>, intern_table: InternTable) -> TypeEnv {
  let kernel_bindings_base = fold(
    map_keys(kernel_type_set),
    init: empty_map(),
    f: (acc, name) => map_insert(acc, intern(table: intern_table, s: name).id, TypeBinding {
      name: name,
      resolved: Node { name: name, span: kernel_span(name: name), ident_span: Present { value: kernel_span(name: name) }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData },
      provenance: SubValueUnknown
    })
  )
  let unit_span = kernel_span(name: "Unit")
  let kernel_bindings = map_insert(kernel_bindings_base, intern(table: intern_table, s: "Unit").id, TypeBinding {
    name: "Unit",
    resolved: Node { name: "Unit", span: unit_span, ident_span: Present { value: unit_span }, children: [], connective: Conj, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData },
    provenance: SubValueUnknown
  })
  let present_value_field = Node { name: "value", span: kernel_span(name: "value"), ident_span: Present { value: kernel_span(name: "value") }, children: [], connective: NoConnective, params: [], inferred: Present { value: TypeVariable { id: "present_value" } }, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let present_variant = Node { name: "Present", span: kernel_span(name: "Present"), ident_span: Present { value: kernel_span(name: "Present") }, children: [present_value_field], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let absent_variant = Node { name: "Absent", span: kernel_span(name: "Absent"), ident_span: Present { value: kernel_span(name: "Absent") }, children: [], connective: NoConnective, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let kernel_optional = Node { name: "Optional", span: kernel_span(name: "Optional"), ident_span: Present { value: kernel_span(name: "Optional") }, children: [present_variant, absent_variant], connective: Disj, params: [], inferred: none, return_cardinality: Required, uses: [], body: none, transport: none, properties: [], type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, expr_data: NoExprData }
  let kernel_bindings = map_insert(kernel_bindings, intern(table: intern_table, s: "Optional").id, TypeBinding { name: "Optional", resolved: kernel_optional, provenance: SubValueUnknown })
  let node_fields = inductive_fields_list_to_map(fields: compiler_inductive_fields)
  let kernel_recursive_types = map_keys(compiler_recursive_types) |> map(name => intern(table: intern_table, s: name).id)
  let kernel_recursive_type_set = fold(map_keys(compiler_recursive_types), init: empty_map(), f: (acc, name) => map_insert(acc, intern(table: intern_table, s: name).id, true))
  TypeEnv { module_path: "", bindings: kernel_bindings, str_bindings: str_bindings_from_bindings(bindings: kernel_bindings), ancestry_str_bindings: empty_map(), parents: [], recursive_types: kernel_recursive_types, recursive_type_set: kernel_recursive_type_set, inductive_fields: node_fields, source_indices: source_indices, intern_table: intern_table, source_visible_names: empty_map(), symbol_index: empty_symbol_index() }
}

fn rewire_type_env_parent_links(modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>) -> List<TypedModule> {
  let index = fold(modules, init: empty_map(), f: (acc, m) =>
    map_insert(acc, authored_name_at(source_indices: source_indices, node: m.module), m)
  )
  let shared_kernel = match modules |> flat_map(m =>
      match m.type_env.parents |> last {
        Present { value: kernel } => if map_is_empty(kernel.bindings) { [] } else { [kernel] }
        Absent => []
      }
    ) |> first {
    Present { value: kernel } => kernel
    Absent =>
      match modules |> first {
        Present { value: m } => compiler_kernel_type_env(source_indices: source_indices, intern_table: m.type_env.intern_table)
        Absent => compiler_kernel_type_env(source_indices: source_indices, intern_table: empty_intern_table())
      }
  }
  map(modules, m =>
    let import_parents = flat_map(module_imports(n: m.module), imp =>
      let path = import_module_path_at(imp: imp, source_indices: source_indices)
      match map_get(index, path) {
        Present { value: parent } => [interface_env_for_import(module_path: path, parent_env: parent.type_env)]
        Absent => []
      }
    )
    TypedModule {
      module: m.module,
      items: m.items,
      type_env: TypeEnv { module_path: m.type_env.module_path,
        bindings: m.type_env.bindings,
        str_bindings: m.type_env.str_bindings,
        ancestry_str_bindings: m.type_env.ancestry_str_bindings,
        parents: concat(import_parents, [shared_kernel]),
        recursive_types: m.type_env.recursive_types,
        recursive_type_set: m.type_env.recursive_type_set,
        inductive_fields: m.type_env.inductive_fields,
        source_indices: m.type_env.source_indices,
        intern_table: m.type_env.intern_table,
        source_visible_names: m.type_env.source_visible_names,
        symbol_index: m.type_env.symbol_index
      },
      type_env_cache: m.type_env_cache,
      interface: m.interface,
      func_env: m.func_env,
      item_registry: m.item_registry,
      occurrence_transport: m.occurrence_transport,
    }
  )
}

fn rewire_func_env_parent_links(modules: List<TypedModule>, source_indices: Map<String, NewlineIndex>) -> List<TypedModule> {
  let index = fold(modules, init: empty_map(), f: (acc, m) =>
    map_insert(acc, authored_name_at(source_indices: source_indices, node: m.module), m)
  )
  map(modules, m =>
    let parents = flat_map(module_imports(n: m.module), imp =>
      let path = import_module_path_at(imp: imp, source_indices: source_indices)
      match map_get(index, path) {
        Present { value: parent } => [parent.func_env]
        Absent => []
      }
    )
    TypedModule {
      module: m.module,
      items: m.items,
      type_env: m.type_env,
      type_env_cache: m.type_env_cache,
      interface: m.interface,
      func_env: ResolvedFuncEnv { name: m.func_env.name, local: m.func_env.local, parents: flatten_parent_envs(direct_parents: parents) },
      item_registry: m.item_registry,
      occurrence_transport: m.occurrence_transport,
    }
  )
}

fn reconcile(graph: ModuleGraph, source_indices: Map<String, NewlineIndex>, intern_table: InternTable) -> ResolvedGraph {
  reconcile_with_census_extra(graph: graph, source_indices: source_indices, intern_table: intern_table, census_fill_modules: [], census_si: source_indices)
}

fn reconcile_with_census_extra(graph: ModuleGraph, source_indices: Map<String, NewlineIndex>, intern_table: InternTable, census_fill_modules: List<Node>, census_si: Map<String, NewlineIndex>) -> ResolvedGraph {
  let typed = typecheck_with_census_extra(graph: graph, source_indices: source_indices, intern_table: intern_table, census_fill_modules: census_fill_modules, census_si: census_si)
  let modules = rewire_type_env_parent_links(modules: typed.modules, source_indices: source_indices)
  let modules = rewire_type_env_import_str_binding_identity(modules: modules, source_indices: source_indices)
  let modules = rewire_func_env_parent_links(modules: modules, source_indices: source_indices)
  let emit_info = build_emit_graph_info(modules: modules)
  ResolvedGraph {
    modules: modules,
    item_registry: typed.item_registry,
    diagnostics: typed.diagnostics,
    emit_graph_info: emit_info,
  }
}
