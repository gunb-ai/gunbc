module v1.compiler.expected_red_roster_join

import v1.compiler.emit_core_support { to_string }

// Identity-grain join of the floor's expected-red roster against witness verdicts.
//
// Every enrolled identity receives exactly one of three outcomes:
// - StillRed — the witness ran and failed on its subject (not infra/budget flake).
// - NowPasses — the witness ran and returned true; retire the enrollment, keep the witness.
// - NotEvaluated — no subject verdict (not in manifest, host tool missing, ...).
//
// Completeness is an identity join over the full roster, never a scan of failure-log lines.
// This module is pure logic ported from the hand-authored expected_red_roster_join.rs
// (#8428) so its .rs realization is emitted, not hand-maintained; file I/O and
// diagnostic printing stay in cli_run.rs, which is already a registered hand-maintained
// support module (v2.compiler.self_host.stage0_crate_layout).

type BudgetVerdictCompletion
  = Interrupted
  | CompletedOverBudget

// WHY A RUN COULD NOT REALIZE ONE OPERATION, closed and companion-local exactly as
// BudgetVerdictCompletion above is. Each arm names a DIFFERENT remedy, which is the whole
// reason it is not one String: an unpublished mock case is closed by publishing the case, a
// missing mock_response by authoring one, a filesystem removal only by a wet route, since
// removal's whole content is the effect and there is no mock arm to author, and a witness frame
// only by a hermetic run, since a modeled realization is admitted nowhere else. The MODE the
// run was in is not a second field beside the ground: it is derived from it by
// effect_refusal_mode, so the pair cannot disagree and the remedy follows the mode.
type EffectRefusalGround
  = UnpublishedMockCase
  | NoMockResponse
  | FilesystemRemoval
  | FrameNotRealizableUnderMode

type EffectRefusalMode
  = RefusedUnderHermetic
  | RefusedUnderWet

// HostEffectRefused IS A ROUTE GAP, NOT A VERDICT. The witness never reached its subject: the
// route it was given has no arm for a host effect it reached for. That is the same distinction
// HostToolUnresolved and BudgetExceeded/Interrupted already draw here — an outcome that
// produces no verdict is NotEvaluated, never StillRed — and the arm exists for the same reason
// they do. Before it, the three hermetic refusal sites produced RuntimeError-shaped prose, so a
// witness never given a runnable route was indistinguishable from a witness that ran and
// errored on its subject. The required floor resolved that ambiguity by declining the whole
// population instead, which is how 778 identities came to be discovered and never executed.
//
// AND THE ARM THE SEED'S TYPED PROCESS REFUSAL NEEDED (2026-09-14, gunbc#11342 review): a witness
// that ran to a nonzero process exit IS a verdict -- the subject was reached and the gate
// refused, carrying its reason -- so it is StillRed, not an absence of one. The vocabulary had no
// arm for it, and the seed's mapping returning not_observed was then rewritten by
// finalize_not_observed into NotEvaluated { reason: "not_in_executed_manifest" }, a fabricated
// ledger claim: the claim DID execute and DID reach a failing verdict. Borrowing BoolFalse was
// never available either -- it would publish the specific falsehood that the function returned a
// Bool. The arm carries the observed exit code and the failing site's reason so the detail can
// distinguish a subject refusal from an infra failure without log archaeology.
type WitnessEvalVerdict
  = Passed
  | BoolFalse
  | NotBool { got: String }
  | RuntimeError { message: String }
  | HostToolUnresolved { name: String, probed: List<String> }
  | HostEffectRefused { operation: String, ground: EffectRefusalGround }
  | BudgetExceeded { elapsed_ms: Int, budget_ms: Int, kind: String, completion: BudgetVerdictCompletion }
  | ExitFailure { code: Int, reason: String }

// WHY A SUPPRESSED ROW IS ITS OWN DISPOSITION AND NOT A NotEvaluated REASON. NotEvaluated says
// the identity was ATTEMPTED and produced no verdict -- host tool missing, hermetic route gap,
// budget interrupt. A suppressed row was never attempted at all: the floor removed it from the
// roster BEFORE the fold, because its module is outside the required gate, the cost-debt roster
// withholds it, or the changed-witness sublane declined it as a declared BinWitnessWet row. Same absence of a verdict, different fact and a different remedy -- one needs a
// route or a budget, the other needs a gate roster edit or a debt to clear -- so collapsing them
// would be the state-space conflation DESIGN section 5 names.
//
// AND THE REASON THIS EXISTS AT ALL: without it the suppressed rows were not in the report,
// which made the run_note's "every enrolled identity" sentence FALSE on its own face. Measured
// 2026-09-01 on head 4c6c509e: 73 enrolled, 26 in the join, 39 outside the gate and 8 withheld --
// so the artifact a reader consults for the roster's standing described 26 of 73 while saying it
// described all of them, and a merge decision was taken on it that night.
type ExpectedRedSuppressionGround
  = OutsideRequiredGate
  | WithheldCostDebt
  | DeclinedNoCiWetLane

type ExpectedRedJoinDisposition
  = StillRed
  | NowPasses
  | NotEvaluated { reason: String }
  | Suppressed { ground: ExpectedRedSuppressionGround }

type ExpectedRedRosterJoinRow {
  identity: String
  disposition: ExpectedRedJoinDisposition
  detail: String
}

type ExpectedRedRosterJoinReport {
  run_head: String?
  run_note: String
  rows: List<ExpectedRedRosterJoinRow>
}

type VerdictClassification {
  disposition: ExpectedRedJoinDisposition
  detail: String
}

fn effect_refusal_mode(ground: EffectRefusalGround) -> EffectRefusalMode {
  match ground {
    UnpublishedMockCase => RefusedUnderHermetic
    NoMockResponse => RefusedUnderHermetic
    FilesystemRemoval => RefusedUnderHermetic
    FrameNotRealizableUnderMode => RefusedUnderWet
  }
}

fn effect_refusal_ground_label(ground: EffectRefusalGround) -> String {
  match ground {
    UnpublishedMockCase => "no published mock case for a corpus-governed service"
    NoMockResponse => "operation declares no mock_response"
    FilesystemRemoval => "filesystem removal has no mock arm; only a wet route can run it"
    FrameNotRealizableUnderMode => "a modeled witness frame is admitted only under Hermetic execution"
  }
}

fn effect_refusal_mode_label(mode: EffectRefusalMode) -> String {
  match mode {
    RefusedUnderHermetic => "hermetic route has no arm for"
    RefusedUnderWet => "wet run cannot realize"
  }
}

// The remedy depends only on the mode: a hermetic run is given a wet route, a wet run a hermetic
// one. The Hermetic spelling names both entry points, so no caller re-spells it per CLI.
fn effect_refusal_remedy(mode: EffectRefusalMode) -> String {
  match mode {
    RefusedUnderHermetic => "re-run with --wet"
    RefusedUnderWet => "re-run under Hermetic execution (`gunbc --dry-run run`, or claim_batch without --wet)"
  }
}

fn classify_verdict(verdict: WitnessEvalVerdict) -> VerdictClassification {
  match verdict {
    Passed =>
      VerdictClassification { disposition: NowPasses, detail: "witness returned Bool(true)" },
    BoolFalse =>
      VerdictClassification { disposition: StillRed, detail: "witness returned Bool(false)" },
    NotBool { got: got } =>
      VerdictClassification { disposition: StillRed, detail: concat("witness answered ", got, ", not a Bool") },
    RuntimeError { message: message } =>
      VerdictClassification { disposition: StillRed, detail: message },
    HostToolUnresolved { name: name, probed: probed } =>
      VerdictClassification {
        disposition: NotEvaluated { reason: "host_tool_unresolved" },
        detail: concat("host tool unresolved: ", name, " (probed: ", probed |> join(separator: ", "), ")")
      },
    HostEffectRefused { operation: operation, ground: ground } =>
      VerdictClassification {
        disposition: NotEvaluated { reason: "host_effect_refused" },
        detail: concat(
          effect_refusal_mode_label(mode: effect_refusal_mode(ground: ground)), " ", operation, " (", effect_refusal_ground_label(ground: ground),
          ") — the witness never reached its subject, so this is a route gap, not a verdict"
        )
      },
    BudgetExceeded { elapsed_ms: elapsed_ms, budget_ms: budget_ms, kind: kind, completion: Interrupted } =>
      VerdictClassification {
        disposition: NotEvaluated { reason: "budget_refused" },
        detail: concat(
          "exceeded ", kind, " budget ", to_string(budget_ms),
          "ms; cost=UNMEASURED — interrupted before ",
          "any verdict, so the cost is above the ",
          "budget with no upper bound. interrupt_point=", to_string(elapsed_ms),
          "ms is a property of the ceiling, not of this row"
        )
      },
    BudgetExceeded { elapsed_ms: elapsed_ms, budget_ms: budget_ms, kind: kind, completion: CompletedOverBudget } =>
      VerdictClassification {
        disposition: NowPasses,
        detail: concat(
          "passed then exceeded ", kind, " budget ", to_string(budget_ms),
          "ms; cost=", to_string(elapsed_ms),
          "ms EXACT — ran to completion. Stale roster ",
          "row: prune enrollment, cost debt is separate"
        )
      },
    ExitFailure { code: code, reason: reason } =>
      VerdictClassification {
        disposition: StillRed,
        detail: concat("exit ", to_string(code), ": ", reason)
      }
  }
}

fn is_not_observed(disposition: ExpectedRedJoinDisposition) -> Bool {
  match disposition {
    NotEvaluated { reason: reason } => reason == "not_observed",
    _ => false
  }
}

fn row_finalized_if_not_observed(row: ExpectedRedRosterJoinRow) -> ExpectedRedRosterJoinRow {
  if is_not_observed(disposition: row.disposition) {
    ExpectedRedRosterJoinRow {
      identity: row.identity,
      disposition: NotEvaluated { reason: "not_in_executed_manifest" },
      detail: "enrolled on roster but no matching claim executed in this run"
    }
  } else {
    row
  }
}

// Pure equivalent of ExpectedRedRosterJoinReport::finalize_not_observed: every row still
// carrying the initial "not_observed" placeholder is reclassified to "not_in_executed_manifest".
fn finalize_not_observed(report: ExpectedRedRosterJoinReport) -> ExpectedRedRosterJoinReport {
  ExpectedRedRosterJoinReport {
    run_head: report.run_head,
    run_note: report.run_note,
    rows: report.rows |> map(row_finalized_if_not_observed)
  }
}
