module v1.compiler.ownership

import v1.std.core {
  Node,
  ExprData, NoExprData, ExprError,
  ExprLiteral, ExprElaboratedLiteral, ExprVar, ExprFieldAccess, ExprCall, ExprMethodCall,
  ExprMatch, ExprIf, ExprLet, ExprBlock, ExprReturn, ExprLambda, ExprForEach,
  ExprRecordLit,
  VarBindingKind, LocalValueBinding, FunctionValueBinding,
  InferredNode, Resolved,
  Cardinality, Required,
  arg_value, arm_body,
  field_access_base,
  if_condition, if_then_branch, if_else_branch,
  let_value, let_body, lambda_body, lambda_param_names_at,
  match_scrutinee, match_arm_nodes,
  method_receiver, method_arg_nodes,
  foreach_collection, foreach_body,
  param_node_type_expr,
  expr_var_name_at, expr_call_func_at, expr_method_name_at, field_access_field_at, authored_name_at,
  NewlineIndex
}

import v1.compiler.emit_core_support { to_string }
import std.occurrence_identity { OccurrenceId, authored_occurrence_of }


// Read is the ELSE OF in_tail, not a finding that the use borrows. walk_expr's ExprVar arm
// branches on one bit: in_tail selects Consumed, and everything else -- every argument position,
// every receiver, every scrutinee -- falls to Read. So Read conflates two states whose remedies
// differ: "this use is provably non-consuming" and "this use was never classified". Consumed is
// the deliberate wall (only a tail position is proven to consume); Read is its residue.
//
// The consequence, which is what this note exists for: DO NOT KEY AN OPTIMIZATION ON Read. An arm
// that emits a borrow wherever Read appears fires on genuine by-value-consuming positions and
// emits a borrow where an owned value is required. That arm was proposed and refuted on this
// reasoning in 2026-08, before it was written.
//
// A borrow-safety decision wants a LOCAL proof instead. The iter_owned receiver disposition in
// 05_emit_rust.dag is the worked example: the syntactic position of the receiver as an iter_owned
// argument is itself the borrow-position proof, so it consults no ownership classification at all.
//
// PRIOR ART, so the next reader does not rebuild it blind: the split was built and verified --
// two orthogonal axes (UsePosition = tail/non-tail, UseContext = the syntactic role), threaded
// through walk_expr and record_use, behaviour-preserving at gen-2 first_generation_equal 129 of
// 129. It was CLOSED UNMERGED in gunbc#8689 for want of a consumer: it wrote the context at 34
// sites and nothing read it, which is the DESIGN.md section 6 experimental-residue tell. The
// conflation described above is real and unfixed; the code that fixes it is quarry in that PR.
// Rebuild it when a decision actually needs to distinguish the two states, and land them together.
//
// PassedByValue IS THAT DECISION, AND ITS CONSUMER IS build_movable_set. A bare binding handed as
// an argument to a call is an owned value going into a by-value parameter: in the emitted Rust every
// declared callee parameter, and every bridge that is not passes_by_ref, takes its argument by
// value. Recorded as Read, the argument was cloned even at the binding's last use, and a clone of an
// Rc-held persistent vector makes the callee's make_mut copy the tail chunk on every push: measured
// on the emitted list_map (fold_list + list_push), 16000 of 16000 pushes saw a shared Rc and the walk
// ran 9.1x host; with the last-use clones moved, 0 of 16000 and 1.43x
// (gunbc.recurring_failure_mode a_last_use_argument_is_cloned_into_a_by_value_parameter).
// It is NOT Consumed: Consumed keys SoleOwner, the proof that a tail binding moves, and `f(x)` beside
// `g(x)` is two ordinary reads. A method
// RECEIVER stays Read: receiver lowerings go through templates that are not audited for splicing the
// receiver once, so a moved receiver could be used twice in the emitted text; that is the frontier.
//
// Invoked IS THE CALLEE OF A CALL, which walk_expr never recorded: `snoc(fold_list_right(t, empty,
// snoc), h)` read as ONE use of snoc, the argument, and once that argument moved, the call after it
// used a moved value (rustc E0505 and E0382 in std.algebra fold_list_right and zip_map on the
// regen round that introduced PassedByValue). It is a whole-value use, so it blocks a move; it is
// kept out of binding_fan_out so that a function parameter that is only called does not newly
// become a read-only parameter.
type EdgeKind = Consumed | Read | Threaded | Projected | PassedByValue | Invoked

// `occurrence` is the authored occurrence the use answers for (std.occurrence_identity
// authored_occurrence_of), carried where a decision is keyed by occurrence: a by-value argument.
type EdgeClassification {
  kind: EdgeKind
  site: String
  span_start: Int
  occurrence: OccurrenceId?
}

type BindingUsage {
  name: String
  binding_kind: VarBindingKind?
  consumers: List<EdgeClassification>
}

fn semantic_consumer_count(usage: BindingUsage) -> Int {
  usage.consumers |> filter(c => match c.kind { Consumed => true, _ => false }) |> count
}

fn binding_fan_out(usage: BindingUsage) -> Int {
  usage.consumers |> filter(c => match c.kind { Threaded => false, Invoked => false, _ => true }) |> count
}

type OwnershipDecision
  = SoleOwner { binding: String, site: String }
  | Unclassified { binding: String, reason: String }

type FoldAccUnwrapProof {
  site_key: String
  acc_param_name: String
  acc_type_name: String
  body_constructs_acc: Bool
  whole_acc_single_use: Bool
  safe_field_moves: Bool
  eligible: Bool
}

type FoldAccUseSummary {
  whole_acc_uses: Int
  field_moves: List<String>
  nested_acc_refs: Bool
}

type OwnershipProof {
  func_name: String
  bindings: Map<String, BindingUsage>
  decisions: List<OwnershipDecision>
  fold_acc_unwrap: List<FoldAccUnwrapProof>
}

type UsageAccum {
  bindings: Map<String, BindingUsage>
  fold_call_nodes: List<Node>
  touched: List<String>
}

fn empty_usage_accum() -> UsageAccum {
  UsageAccum { bindings: empty_map(), fold_call_nodes: [], touched: [] }
}

fn record_use(accum: UsageAccum, name: String, kind: EdgeKind, site: String, binding_kind: VarBindingKind?, span_start: Int) -> UsageAccum {
  record_use_at(accum: accum, name: name, kind: kind, site: site, binding_kind: binding_kind, span_start: span_start, occurrence: none)
}

fn record_use_at(accum: UsageAccum, name: String, kind: EdgeKind, site: String, binding_kind: VarBindingKind?, span_start: Int, occurrence: OccurrenceId?) -> UsageAccum {
  let edge = EdgeClassification { kind: kind, site: site, span_start: span_start, occurrence: occurrence }
  let existing = match map_get(accum.bindings, name) {
    Present { value: usage } => usage
    Absent => BindingUsage { name: name, binding_kind: none, consumers: [] }
  }
  let effective_kind = if existing.binding_kind != none { existing.binding_kind } else { binding_kind }
  let updated = BindingUsage {
    name: name,
    binding_kind: effective_kind,
    consumers: list_push(existing.consumers, edge)
  }
  UsageAccum {
    bindings: map_insert(accum.bindings, name, updated),
    fold_call_nodes: accum.fold_call_nodes,
    touched: list_push(accum.touched, name)
  }
}

// A name that resolves to a function, a variant constructor or a service value is not a binding: it
// has no owner, nothing is moved out of it and nothing can be consumed twice, so a use of it records
// no edge. Recording one made `return Unreadable` beside a tail `Unreadable` count two consumers of a
// nullary variant. An unresolved kind (none) keeps recording, as a parameter's seed entry carries none.
fn names_a_binding(kind: VarBindingKind?) -> Bool {
  match kind {
    Present { value: FunctionValueBinding } => false
    Present { value: VariantValueBinding { parent_enum: _, parent_identity: _ } } => false
    Present { value: ServiceValueBinding } => false
    _ => true
  }
}

// The one recording point for an ExprVar use, so every position (tail, read, projection base, fold
// seed, by-value argument) applies names_a_binding and none of them can record a non-binding.
fn record_var_use(accum: UsageAccum, name: String, kind: EdgeKind, site: String, binding_kind: VarBindingKind?, span_start: Int, occurrence: OccurrenceId?) -> UsageAccum {
  if names_a_binding(kind: binding_kind) {
    record_use_at(accum: accum, name: name, kind: kind, site: site, binding_kind: binding_kind, span_start: span_start, occurrence: occurrence)
  } else {
    accum
  }
}

// Consumer: build_movable_set must see whole-value Read evidence from every branch.
// Fan-out still selects the path for semantic consumer counts; reads on another path must not
// disappear merely because that path has fewer projections. Shared-prefix reads are retained
// once, so repeated joins do not manufacture extra uses. Projected remains distinct from Read.
// Read is non-tail residue: retaining it conservatively clones until the ownership fold carries
// per-path last-use evidence. No emitter ordering or move rule is introduced here.
fn max_usage_by_fan_out(a: BindingUsage, b: BindingUsage) -> BindingUsage {
  let b_is_larger = binding_fan_out(usage: b) > binding_fan_out(usage: a)
  let selected = if b_is_larger { b } else { a }
  let other = if b_is_larger { a } else { b }
  // A by-value argument on the other path is carried exactly as a Read is: dropping it would let a
  // path that moves the value into a call and then consumes it pass for a single consume. Carrying
  // it can make two exclusive moves read as two uses, which only keeps a clone.
  let missing_reads = other.consumers |> filter(edge =>
    match edge.kind {
      Read => selected.consumers |> any(existing => existing.kind == Read && existing.span_start == edge.span_start && existing.site == edge.site) == false
      PassedByValue => selected.consumers |> any(existing => existing.kind == PassedByValue && existing.span_start == edge.span_start && existing.site == edge.site) == false
      Invoked => selected.consumers |> any(existing => existing.kind == Invoked && existing.span_start == edge.span_start && existing.site == edge.site) == false
      _ => false
    }
  )
  BindingUsage { name: selected.name, binding_kind: selected.binding_kind, consumers: concat(selected.consumers, missing_reads) }
}

fn map_usage_merge_at(base: Map<String, BindingUsage>, key: String, new_val: BindingUsage) -> Map<String, BindingUsage> {
  match map_get(base, key) {
    Present { value: existing } => map_insert(base, key, max_usage_by_fan_out(a: existing, b: new_val))
    Absent => map_insert(base, key, new_val)
  }
}

fn branch_seed(from: UsageAccum) -> UsageAccum {
  UsageAccum { bindings: from.bindings, fold_call_nodes: from.fold_call_nodes, touched: [] }
}

fn merge_branch_usages(base: UsageAccum, branches: List<UsageAccum>) -> UsageAccum {
  let binding_merged = branches |> fold(init: base.bindings, f: (merged, branch) =>
    branch.touched |> fold(init: merged, f: (acc, name) =>
      match map_get(branch.bindings, name) {
        Present { value: usage } => map_usage_merge_at(base: acc, key: name, new_val: usage)
        Absent => acc
      }
    )
  )
  let touched_merged = branches |> fold(init: base.touched, f: (acc, branch) => concat(acc, branch.touched))
  let base_fold_count = base.fold_call_nodes |> count
  let branch_fold_nodes = branches |> flat_map(b => b.fold_call_nodes |> skip(base_fold_count))
  UsageAccum {
    bindings: binding_merged,
    fold_call_nodes: base.fold_call_nodes |> concat(branch_fold_nodes),
    touched: touched_merged
  }
}

fn walk_expr(accum: UsageAccum, texpr: Node, in_tail: Bool, si: Map<String, NewlineIndex>) -> UsageAccum {
  match texpr.expr_data {
    ExprVar { binding_kind: bk } =>
      let n = expr_var_name_at(texpr: texpr, source_indices: si)
      if in_tail {
        record_var_use(accum: accum, name: n, kind: Consumed, site: "return", binding_kind: bk, span_start: texpr.span.start, occurrence: none)
      } else {
        record_var_use(accum: accum, name: n, kind: Read, site: "read", binding_kind: bk, span_start: texpr.span.start, occurrence: none)
      }

    ExprLiteral { value: _ } => accum
    ExprElaboratedLiteral { value: _, elaboration: _ } => accum

    ExprFieldAccess =>
      let base_node = field_access_base(texpr: texpr)
      match base_node.expr_data {
        ExprVar { binding_kind: bk } =>
          let vn = expr_var_name_at(texpr: base_node, source_indices: si)
          let f = field_access_field_at(texpr: texpr, source_indices: si)
          record_var_use(accum: accum, name: vn, kind: Projected, site: concat(".", f), binding_kind: bk, span_start: texpr.span.start, occurrence: none)
        _ => walk_expr(accum: accum, texpr: base_node, in_tail: false, si: si)
      }

    ExprCall =>
      let fname = expr_call_func_at(texpr: texpr, source_indices: si)
      // The callee name is recorded whether or not it names a binding: a global function name only
      // makes a binding no parameter or local matches, and an extra edge can only keep a clone.
      let called = record_use(accum: accum, name: fname, kind: Invoked, site: "callee", binding_kind: none, span_start: texpr.span.start)
      if fname == "fold" {
        let init_arg = texpr.children |> filter(a => authored_name_at(source_indices: si, node: a) == "init") |> first
        let threaded_accum = match init_arg {
          Present { value: ia } =>
            let ia_val = arg_value(n: ia)
            match ia_val.expr_data {
              ExprVar { binding_kind: bk } =>
                let vn = expr_var_name_at(texpr: ia_val, source_indices: si)
                record_var_use(accum: called, name: vn, kind: Threaded, site: "fold_init", binding_kind: bk, span_start: ia_val.span.start, occurrence: none)
              _ => walk_expr(accum: called, texpr: ia_val, in_tail: false, si: si)
            }
          Absent => called
        }
        let non_init = texpr.children |> filter(a => authored_name_at(source_indices: si, node: a) != "init")
        non_init |> fold(init: threaded_accum, f: (acc, a) =>
          walk_expr(accum: acc, texpr: arg_value(n: a), in_tail: false, si: si)
        )
      } else {
        texpr.children |> fold(init: called, f: (acc, a) =>
          walk_call_argument(accum: acc, arg: arg_value(n: a), si: si)
        )
      }

    ExprMethodCall =>
      let recv = method_receiver(texpr: texpr)
      let mc_args = method_arg_nodes(texpr: texpr)
      let mname = expr_method_name_at(texpr: texpr, source_indices: si)
      if mname == "fold" {
        let recv_accum = walk_expr(accum: accum, texpr: recv, in_tail: false, si: si)
        let init_arg = mc_args |> filter(a => authored_name_at(source_indices: si, node: a) == "init") |> first
        let threaded_accum = match init_arg {
          Present { value: ia } =>
            let ia_val = arg_value(n: ia)
            match ia_val.expr_data {
              ExprVar { binding_kind: bk } =>
                let vn = expr_var_name_at(texpr: ia_val, source_indices: si)
                record_var_use(accum: recv_accum, name: vn, kind: Threaded, site: "fold_init", binding_kind: bk, span_start: ia_val.span.start, occurrence: none)
              _ => walk_expr(accum: recv_accum, texpr: ia_val, in_tail: false, si: si)
            }
          Absent => recv_accum
        }
        let non_init = mc_args |> filter(a => authored_name_at(source_indices: si, node: a) != "init")
        let walked = non_init |> fold(init: threaded_accum, f: (acc, a) =>
          walk_expr(accum: acc, texpr: arg_value(n: a), in_tail: false, si: si)
        )
        UsageAccum { bindings: walked.bindings, fold_call_nodes: list_push(walked.fold_call_nodes, texpr), touched: walked.touched }
      } else {
        let recv_accum = walk_expr(accum: accum, texpr: recv, in_tail: false, si: si)
        mc_args |> fold(init: recv_accum, f: (acc, a) =>
          walk_expr(accum: acc, texpr: arg_value(n: a), in_tail: false, si: si)
        )
      }

    ExprMatch =>
      let scrut = match_scrutinee(texpr: texpr)
      let arm_nodes = match_arm_nodes(texpr: texpr)
      let s_accum = walk_expr(accum: accum, texpr: scrut, in_tail: false, si: si)
      let seed = branch_seed(from: s_accum)
      let branch_accums = arm_nodes |> map(arm_node =>
        walk_expr(accum: seed, texpr: arm_body(n: arm_node), in_tail: in_tail, si: si)
      )
      merge_branch_usages(base: s_accum, branches: branch_accums)

    ExprIf =>
      let c = if_condition(texpr: texpr)
      let t = if_then_branch(texpr: texpr)
      let c_accum = walk_expr(accum: accum, texpr: c, in_tail: false, si: si)
      let seed = branch_seed(from: c_accum)
      let t_accum = walk_expr(accum: seed, texpr: t, in_tail: in_tail, si: si)
      let e_accum = match if_else_branch(texpr: texpr) {
        Present { value: eb } => walk_expr(accum: seed, texpr: eb, in_tail: in_tail, si: si)
        Absent => seed
      }
      merge_branch_usages(base: c_accum, branches: [t_accum, e_accum])

    ExprLet =>
      let v = let_value(texpr: texpr)
      let v_accum = walk_expr(accum: accum, texpr: v, in_tail: false, si: si)
      match let_body(texpr: texpr) {
        Present { value: b } => walk_expr(accum: v_accum, texpr: b, in_tail: in_tail, si: si)
        Absent => v_accum
      }

    ExprBlock =>
      let ss = texpr.children
      let ss_count = ss |> count
      if ss_count == 0 { accum }
      else {
        let init_accum = ss |> enumerate
          |> filter(p => p.first < ss_count - 1)
          |> fold(init: accum, f: (acc, p) =>
            walk_expr(accum: acc, texpr: p.second, in_tail: false, si: si)
          )
        match ss |> last {
          Present { value: last_expr } =>
            walk_expr(accum: init_accum, texpr: last_expr, in_tail: in_tail, si: si)
          Absent => init_accum
        }
      }

    ExprReturn =>
      texpr.children |> fold(init: accum, f: (acc, child) =>
        walk_expr(accum: acc, texpr: child, in_tail: true, si: si)
      )

    ExprLambda =>
      let body = lambda_body(texpr: texpr)
      let inner = walk_expr(accum: empty_usage_accum(), texpr: body, in_tail: false, si: si)
      let binding_merged = inner.bindings |> map_values |> fold(init: accum, f: (acc, usage) =>
        record_use(accum: acc, name: usage.name, kind: Read, site: "lambda-capture", binding_kind: none, span_start: 0)
      )
      UsageAccum { bindings: binding_merged.bindings, fold_call_nodes: binding_merged.fold_call_nodes |> concat(inner.fold_call_nodes), touched: binding_merged.touched }

    ExprForEach =>
      let coll = foreach_collection(texpr: texpr)
      let coll_accum = walk_expr(accum: accum, texpr: coll, in_tail: false, si: si)
      let body = foreach_body(texpr: texpr)
      let inner = walk_expr(accum: empty_usage_accum(), texpr: body, in_tail: false, si: si)
      let binding_merged = inner.bindings |> map_values |> fold(init: coll_accum, f: (acc, usage) =>
        record_use(accum: acc, name: usage.name, kind: Read, site: "foreach-capture", binding_kind: none, span_start: 0)
      )
      UsageAccum { bindings: binding_merged.bindings, fold_call_nodes: binding_merged.fold_call_nodes |> concat(inner.fold_call_nodes), touched: binding_merged.touched }

    _ =>
      texpr.children |> fold(init: accum, f: (acc, child) =>
        walk_expr(accum: acc, texpr: child, in_tail: false, si: si)
      )
  }
}

// A bare binding in argument position is handed over by value; any other argument expression is
// walked as before, so a binding inside it (a field, a nested call's own argument) is classified by
// its own position.
fn walk_call_argument(accum: UsageAccum, arg: Node, si: Map<String, NewlineIndex>) -> UsageAccum {
  match arg.expr_data {
    ExprVar { binding_kind: bk } =>
      record_var_use(accum: accum, name: expr_var_name_at(texpr: arg, source_indices: si), kind: PassedByValue, site: "argument", binding_kind: bk, span_start: arg.span.start, occurrence: authored_occurrence_of(identity: arg.occurrence_identity))
    _ => walk_expr(accum: accum, texpr: arg, in_tail: false, si: si)
  }
}

fn make_decision(usage: BindingUsage) -> OwnershipDecision {
  let sc = semantic_consumer_count(usage: usage)
  if sc == 1 {
    let consumed_sites = usage.consumers
      |> filter(c => match c.kind { Consumed => true, _ => false })
    let site = match consumed_sites |> first {
      Present { value: c } => c.site
      Absent => "unknown"
    }
    SoleOwner { binding: usage.name, site: site }
  } else {
    // Consumed is recorded only at an exit of the body (tail or `return`), and exits are mutually
    // exclusive, so more than one is several paths each moving the value once, never a double consume.
    // Such a binding is not the sole owner at one exit, so it is not movable; it is not an error.
    if sc > 1 {
      Unclassified { binding: usage.name, reason: "consumed at more than one exit" }
    } else {
      Unclassified { binding: usage.name, reason: "no consumers found" }
    }
  }
}

fn is_owned_local(kind: VarBindingKind?) -> Bool {
  match kind {
    Present { value: LocalValueBinding } => true
    _ => false
  }
}

// Every use that needs the whole value other than the one move: a by-value argument is one, or a
// tail Consumed beside it (`let_body(texpr: body)` then `body` on another arm) would move the value
// into the call and then return it. Leaving PassedByValue out of this count did exactly that to
// fold_terminal_expr on the first regen round (rustc E0382, use of moved value `body`).
fn whole_value_borrow_count(usage: BindingUsage) -> Int {
  usage.consumers |> filter(c => match c.kind { Read => true, Threaded => true, PassedByValue => true, Invoked => true, _ => false }) |> count
}

// A binding whose ONE use is a by-value argument is moved there. One edge on the selected path means
// nothing reads it before or after the call (a read inside a lambda or loop body surfaces here as a
// capture Read, so a use that executes more than once is never the only edge). Exactly one edge also
// keeps this disjoint from build_read_only_params, which needs a fan-out above one.
fn moved_at_its_only_argument(usage: BindingUsage) -> Bool {
  (usage.consumers |> count) == 1 && usage.consumers |> all(c => c.kind == PassedByValue)
}

fn build_movable_set(proof: OwnershipProof, param_names: Set<String>) -> Set<String> {
  proof.bindings |> map_values
    |> filter(usage =>
      (match make_decision(usage: usage) { SoleOwner { binding: _, site: _ } => true, _ => false })
      && whole_value_borrow_count(usage: usage) == 0
      && (is_owned_local(kind: usage.binding_kind) || set_contains(param_names, usage.name)))
    |> fold(init: empty_set(), f: (acc, usage) => set_insert(acc, usage.name))
}

// THE MOVE AT A BY-VALUE ARGUMENT IS AUTHORIZED AT ONE OCCURRENCE, NOT FOR A SPELLING. The proof
// keys a binding by its name, and a name can be bound twice in one function (a let, a lambda
// parameter, an arm binder). A name-keyed movable set would then let the proof for one binding move
// a different binding of the same spelling (DESIGN section 4: key on the exact declaration). An
// ExprVar carries no declaration identity in v1, but it carries its own occurrence identity, and the
// fact proved here is about one occurrence: this edge is the only use the proof saw under this
// spelling. Every occurrence of the spelling in the scope is an edge (a nested lambda's uses surface
// as captures), so one edge is one occurrence, and the move happens exactly there and nowhere else.
// The key is that occurrence's authored OccurrenceId, read through the one keying authority
// (std.occurrence_identity authored_occurrence_of), never a second key; a synthetic node answers for
// no occurrence, so it keys nothing and is never moved. The emitter reads the same identity
// (v1.compiler.emit_rust emit_rust_expr_var). The pre-existing tail consume above stays keyed by name
// as on main; this change only makes it more conservative.

// `locals_admitted` is false for a lambda's own proof: there a name that is not a parameter is a
// capture of the enclosing frame, even when it is a local there, and a capture never moves out of an
// Fn closure (rustc E0507 on the regen round that admitted them: separator, item, eq, xs, ys in
// std.algebra closures handed to declared callees).
fn build_moved_argument_occurrences(proof: OwnershipProof, param_names: Set<String>, locals_admitted: Bool) -> Set<Int> {
  proof.bindings |> map_values
    |> filter(usage => moved_at_its_only_argument(usage: usage)
      && ((locals_admitted && is_owned_local(kind: usage.binding_kind)) || set_contains(param_names, usage.name)))
    |> fold(init: empty_set(), f: (acc, usage) =>
      usage.consumers |> fold(init: acc, f: (inner, edge) =>
        match edge.occurrence {
          Present { value: id } => set_insert(inner, id.value)
          Absent => inner
        }))
}

fn build_read_only_params(proof: OwnershipProof, param_names: Set<String>) -> Set<String> {
  proof.bindings |> map_values
    |> filter(usage =>
      set_contains(param_names, usage.name)
      && is_owned_local(kind: usage.binding_kind)
      && binding_fan_out(usage: usage) > 1
      && usage.consumers |> all(c => match c.kind { Read => true, Projected => true, Threaded => true, PassedByValue => true, Invoked => true, _ => false })
    )
    |> fold(init: empty_set(), f: (acc, usage) => set_insert(acc, usage.name))
}

fn collect_callable_refs(texpr: Node, si: Map<String, NewlineIndex>) -> Set<String> {
  match texpr.expr_data {
    ExprVar { binding_kind: bk } =>
      match bk {
        Present { value: FunctionValueBinding } =>
          let n = expr_var_name_at(texpr: texpr, source_indices: si)
          set_insert(empty_set(), n)
        _ => empty_set()
      }
    ExprLiteral { value: _ } => empty_set()
    ExprElaboratedLiteral { value: _, elaboration: _ } => empty_set()
    ExprFieldAccess =>
      collect_callable_refs(texpr: field_access_base(texpr: texpr), si: si)
    ExprCall =>
      texpr.children |> fold(init: empty_set(), f: (acc, a) =>
        set_union(acc, collect_callable_refs(texpr: arg_value(n: a), si: si))
      )
    ExprMethodCall { method_semantics: _ } =>
      let recv = collect_callable_refs(texpr: method_receiver(texpr: texpr), si: si)
      method_arg_nodes(texpr: texpr) |> fold(init: recv, f: (acc, a) =>
        set_union(acc, collect_callable_refs(texpr: arg_value(n: a), si: si))
      )
    ExprIf =>
      let cond = collect_callable_refs(texpr: if_condition(texpr: texpr), si: si)
      let then_br = collect_callable_refs(texpr: if_then_branch(texpr: texpr), si: si)
      let else_br = match if_else_branch(texpr: texpr) {
        Present { value: eb } => collect_callable_refs(texpr: eb, si: si)
        Absent => empty_set()
      }
      set_union(set_union(cond, then_br), else_br)
    ExprMatch =>
      let scrut = collect_callable_refs(texpr: match_scrutinee(texpr: texpr), si: si)
      match_arm_nodes(texpr: texpr) |> fold(init: scrut, f: (acc, arm) =>
        set_union(acc, collect_callable_refs(texpr: arm_body(n: arm), si: si))
      )
    ExprLet =>
      let val = collect_callable_refs(texpr: let_value(texpr: texpr), si: si)
      match let_body(texpr: texpr) {
        Present { value: lb } => set_union(val, collect_callable_refs(texpr: lb, si: si))
        Absent => val
      }
    ExprBlock =>
      texpr.children |> fold(init: empty_set(), f: (acc, child) =>
        set_union(acc, collect_callable_refs(texpr: child, si: si))
      )
    ExprReturn =>
      match texpr.children |> first {
        Present { value: child } => collect_callable_refs(texpr: child, si: si)
        Absent => empty_set()
      }
    ExprLambda =>
      collect_callable_refs(texpr: lambda_body(texpr: texpr), si: si)
    ExprForEach =>
      let col = collect_callable_refs(texpr: foreach_collection(texpr: texpr), si: si)
      set_union(col, collect_callable_refs(texpr: foreach_body(texpr: texpr), si: si))
    ExprRecordLit =>
      texpr.children |> fold(init: empty_set(), f: (acc, field) =>
        set_union(acc, collect_callable_refs(texpr: arg_value(n: field), si: si))
      )
    _ => empty_set()
  }
}

fn fold_terminal_expr(body: Node) -> Node {
  match body.expr_data {
    ExprLet => match let_body(texpr: body) {
      Present { value: inner } => fold_terminal_expr(body: inner)
      Absent => body
    }
    ExprBlock => match body.children |> last {
      Present { value: last_child } => fold_terminal_expr(body: last_child)
      Absent => body
    }
    _ => body
  }
}

fn empty_fold_acc_use_summary() -> FoldAccUseSummary {
  FoldAccUseSummary { whole_acc_uses: 0, field_moves: [], nested_acc_refs: false }
}

fn merge_fold_acc_use_summaries(left: FoldAccUseSummary, right: FoldAccUseSummary) -> FoldAccUseSummary {
  FoldAccUseSummary {
    whole_acc_uses: left.whole_acc_uses + right.whole_acc_uses,
    field_moves: concat(left.field_moves, right.field_moves),
    nested_acc_refs: left.nested_acc_refs || right.nested_acc_refs
  }
}

fn summarize_fold_acc_uses(node: Node, acc_name: String, si: Map<String, NewlineIndex>, inside_nested: Bool) -> FoldAccUseSummary {
  match node.expr_data {
    ExprVar { binding_kind: _ } =>
      if expr_var_name_at(texpr: node, source_indices: si) == acc_name {
        if inside_nested {
          FoldAccUseSummary { whole_acc_uses: 0, field_moves: [], nested_acc_refs: true }
        } else {
          FoldAccUseSummary { whole_acc_uses: 1, field_moves: [], nested_acc_refs: false }
        }
      } else {
        empty_fold_acc_use_summary()
      }

    ExprFieldAccess { summary: _ } =>
      let base = field_access_base(texpr: node)
      let is_direct = match base.expr_data {
        ExprVar { binding_kind: _ } => expr_var_name_at(texpr: base, source_indices: si) == acc_name
        _ => false
      }
      if is_direct {
        if inside_nested {
          FoldAccUseSummary { whole_acc_uses: 0, field_moves: [], nested_acc_refs: true }
        } else {
          FoldAccUseSummary {
            whole_acc_uses: 0,
            field_moves: [field_access_field_at(texpr: node, source_indices: si)],
            nested_acc_refs: false
          }
        }
      } else {
        node.children |> fold(init: empty_fold_acc_use_summary(), f: (acc, child) =>
          merge_fold_acc_use_summaries(left: acc, right: summarize_fold_acc_uses(node: child, acc_name: acc_name, si: si, inside_nested: inside_nested))
        )
      }

    ExprLambda =>
      let body_summary = summarize_fold_acc_uses(node: lambda_body(texpr: node), acc_name: acc_name, si: si, inside_nested: true)
      if body_summary.whole_acc_uses > 0 || body_summary.field_moves |> count > 0 || body_summary.nested_acc_refs {
        FoldAccUseSummary { whole_acc_uses: 0, field_moves: [], nested_acc_refs: true }
      } else {
        empty_fold_acc_use_summary()
      }

    ExprForEach =>
      let coll_summary = summarize_fold_acc_uses(node: foreach_collection(texpr: node), acc_name: acc_name, si: si, inside_nested: inside_nested)
      let body_summary = summarize_fold_acc_uses(node: foreach_body(texpr: node), acc_name: acc_name, si: si, inside_nested: true)
      let nested_summary = if body_summary.whole_acc_uses > 0 || body_summary.field_moves |> count > 0 || body_summary.nested_acc_refs {
        FoldAccUseSummary { whole_acc_uses: 0, field_moves: [], nested_acc_refs: true }
      } else {
        empty_fold_acc_use_summary()
      }
      merge_fold_acc_use_summaries(left: coll_summary, right: nested_summary)

    _ =>
      node.children |> fold(init: empty_fold_acc_use_summary(), f: (acc, child) =>
        merge_fold_acc_use_summaries(left: acc, right: summarize_fold_acc_uses(node: child, acc_name: acc_name, si: si, inside_nested: inside_nested))
      )
  }
}

fn fold_lambda_acc_use_summary(lambda_node: Node, acc_name: String, si: Map<String, NewlineIndex>) -> FoldAccUseSummary {
  match lambda_node.expr_data {
    ExprLambda => summarize_fold_acc_uses(node: lambda_body(texpr: lambda_node), acc_name: acc_name, si: si, inside_nested: false)
    _ => empty_fold_acc_use_summary()
  }
}

fn fold_body_constructs_acc_struct(lambda_node: Node, acc_type_name: String, si: Map<String, NewlineIndex>) -> Bool {
  match lambda_node.expr_data {
    ExprLambda =>
      let body = lambda_body(texpr: lambda_node)
      let terminal = fold_terminal_expr(body: body)
      match terminal.expr_data {
        ExprRecordLit { parent_enum: _ } => authored_name_at(source_indices: si, node: terminal) == acc_type_name
        _ => false
      }
    _ => false
  }
}

fn fold_body_safe_field_moves(lambda_node: Node, acc_name: String, si: Map<String, NewlineIndex>) -> Bool {
  let summary = fold_lambda_acc_use_summary(lambda_node: lambda_node, acc_name: acc_name, si: si)
  let deduped = summary.field_moves |> fold(init: empty_map(), f: (seen, field) => map_insert(seen, field, true))
  !summary.nested_acc_refs
    && summary.whole_acc_uses == 0
    && (map_keys(deduped) |> count == summary.field_moves |> count)
}

fn fold_body_consumes_acc_once(lambda_node: Node, acc_name: String, si: Map<String, NewlineIndex>) -> Bool {
  let summary = fold_lambda_acc_use_summary(lambda_node: lambda_node, acc_name: acc_name, si: si)
  !summary.nested_acc_refs
    && summary.whole_acc_uses == 1
    && (summary.field_moves |> count == 0)
}

// A branch-ended accumulator. The lambda body is an if-chain whose conditions may read fields of the
// accumulator and whose branch leaves use it at most once and as a whole value, never a field. Every
// field read runs before the branch is taken, and branches are exclusive, so the single whole use in
// the taken branch is the accumulator's last use and the emitter may move it instead of cloning it.
fn fold_branch_ends_move_acc(node: Node, acc_name: String, si: Map<String, NewlineIndex>) -> Bool {
  match node.expr_data {
    ExprIf =>
      let cond = summarize_fold_acc_uses(node: if_condition(texpr: node), acc_name: acc_name, si: si, inside_nested: false)
      let then_ok = fold_branch_ends_move_acc(node: if_then_branch(texpr: node), acc_name: acc_name, si: si)
      let else_ok = match if_else_branch(texpr: node) {
        Present { value: e } => fold_branch_ends_move_acc(node: e, acc_name: acc_name, si: si)
        Absent => false
      }
      !cond.nested_acc_refs && cond.whole_acc_uses == 0 && then_ok && else_ok
    _ =>
      let leaf = summarize_fold_acc_uses(node: node, acc_name: acc_name, si: si, inside_nested: false)
      !leaf.nested_acc_refs && leaf.whole_acc_uses == 1 && (leaf.field_moves |> count == 0)
  }
}

fn fold_body_branch_ends_move_acc(lambda_node: Node, acc_name: String, si: Map<String, NewlineIndex>) -> Bool {
  match lambda_node.expr_data {
    ExprLambda => match lambda_body(texpr: lambda_node).expr_data {
      ExprIf => fold_branch_ends_move_acc(node: lambda_body(texpr: lambda_node), acc_name: acc_name, si: si)
      _ => false
    }
    _ => false
  }
}

fn analyze_single_fold(method_call: Node, si: Map<String, NewlineIndex>) -> FoldAccUnwrapProof {
  let args = method_arg_nodes(texpr: method_call)
  let init_arg_node = match args |> first {
    Present { value: a } => arg_value(n: a)
    Absent => method_call
  }
  let fold_lambda_node = match args |> skip(1) |> first {
    Present { value: a } => arg_value(n: a)
    Absent => method_call
  }
  let acc_param_name = match fold_lambda_node.expr_data {
    ExprLambda => match lambda_param_names_at(texpr: fold_lambda_node, source_indices: si) |> first {
      Present { value: n } => n
      Absent => ""
    }
    _ => ""
  }
  let acc_type_name = match init_arg_node.inferred {
    Present { value: Resolved { node: type_node } } => authored_name_at(source_indices: si, node: type_node)
    _ => ""
  }
  let cond_required = match init_arg_node.inferred {
    Present { value: Resolved { node: type_node } } => type_node.return_cardinality == Required
    _ => false
  }
  let cond_struct = fold_body_constructs_acc_struct(lambda_node: fold_lambda_node, acc_type_name: acc_type_name, si: si)
  let cond_whole_acc = fold_body_consumes_acc_once(lambda_node: fold_lambda_node, acc_name: acc_param_name, si: si)
  let cond_safe = fold_body_safe_field_moves(lambda_node: fold_lambda_node, acc_name: acc_param_name, si: si)
  let cond_branch_ends = fold_body_branch_ends_move_acc(lambda_node: fold_lambda_node, acc_name: acc_param_name, si: si)
  let eligible = cond_required && acc_type_name != "" && ((cond_struct && cond_safe) || cond_whole_acc || cond_branch_ends)
  FoldAccUnwrapProof {
    site_key: to_string(value: method_call.span.start),
    acc_param_name: acc_param_name,
    acc_type_name: acc_type_name,
    body_constructs_acc: cond_struct,
    whole_acc_single_use: cond_whole_acc || cond_branch_ends,
    safe_field_moves: cond_safe,
    eligible: eligible
  }
}

// A DYING BASE HANDLE. A parameter is a base handle that dies at a record literal when the literal is
// in terminal position of the body, has the parameter's own type, and the parameter has no use except
// field projections (no whole-value use, no capture by a nested lambda or loop). Every projection runs
// before the literal is built, so the value the parameter held is dead once the literal exists: the
// emitter may build the result in the parameter's own box when that box is uniquely held. This is the
// same field-granular last-use evidence a fold accumulator is judged by (summarize_fold_acc_uses),
// applied to a fn parameter, which analyze_ownership never classified field-granularly.
//
// What the fact does NOT claim: that the box is uniquely held. Uniqueness is the runtime reading the
// emitter's Rc::get_mut takes; a shared box takes the allocating arm, which is the arm without this
// fact. So the fact decides WHERE reuse is attempted, and correctness does not depend on runtime uniqueness, provided eligibility, the field-storage conversions and the fallback construction are correct.
fn terminal_record_literals(body: Node) -> List<Node> {
  match body.expr_data {
    ExprLet => match let_body(texpr: body) {
      Present { value: inner } => terminal_record_literals(body: inner)
      Absent => []
    }
    ExprBlock => match body.children |> last {
      Present { value: last_child } => terminal_record_literals(body: last_child)
      Absent => []
    }
    ExprIf =>
      let then_sites = terminal_record_literals(body: if_then_branch(texpr: body))
      match if_else_branch(texpr: body) {
        Present { value: e } => concat(then_sites, terminal_record_literals(body: e))
        Absent => then_sites
      }
    ExprMatch => match_arm_nodes(texpr: body) |> flat_map(arm => terminal_record_literals(body: arm_body(n: arm)))
    ExprRecordLit { parent_enum: parent } =>
      match parent {
        Present { value: _ } => []
        Absent => [body]
      }
    _ => []
  }
}

fn analyze_dying_base_sites(params: List<Node>, body: Node, si: Map<String, NewlineIndex>) -> Map<String, String> {
  let literals = terminal_record_literals(body: body)
  if literals |> count == 0 {
    empty_map()
  } else {
    params |> fold(init: empty_map(), f: (found, p) =>
      let pname = authored_name_at(source_indices: si, node: p)
      let ptype = authored_name_at(source_indices: si, node: param_node_type_expr(n: p))
      let summary = summarize_fold_acc_uses(node: body, acc_name: pname, si: si, inside_nested: false)
      if ptype == "" || summary.whole_acc_uses > 0 || summary.nested_acc_refs {
        found
      } else {
        literals |> filter(lit => authored_name_at(source_indices: si, node: lit) == ptype)
          |> fold(init: found, f: (acc, lit) => map_insert(acc, to_string(value: lit.span.start), pname))
      }
    )
  }
}

fn analyze_ownership(func_name: String, params: List<Node>, body: Node, si: Map<String, NewlineIndex>) -> OwnershipProof {
  analyze_ownership_of_names(func_name: func_name, param_names: params |> map(p => authored_name_at(source_indices: si, node: p)), body: body, si: si)
}

// The same proof keyed by parameter NAME, for a lambda, whose parameters are names rather than
// declaration nodes (v1.compiler.emit_rust user_call_lambda_emit_info).
fn analyze_ownership_of_names(func_name: String, param_names: List<String>, body: Node, si: Map<String, NewlineIndex>) -> OwnershipProof {
  let initial = param_names |> fold(init: empty_usage_accum(), f: (acc, p_name) =>
    UsageAccum {
      bindings: map_insert(acc.bindings, p_name, BindingUsage { name: p_name, binding_kind: none, consumers: [] }),
      fold_call_nodes: acc.fold_call_nodes,
      touched: acc.touched
    }
  )
  let result = walk_expr(accum: initial, texpr: body, in_tail: true, si: si)

  let binding_list = result.bindings |> map_values
  let decisions = binding_list |> map(usage => make_decision(usage: usage))
  let fold_proofs = result.fold_call_nodes |> map(n => analyze_single_fold(method_call: n, si: si))
  OwnershipProof {
    func_name: func_name,
    bindings: result.bindings,
    decisions: decisions,
    fold_acc_unwrap: fold_proofs
  }
}

