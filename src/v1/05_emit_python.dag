fn emit_python(typed: v1.compiler.infer_items.ResolvedGraph) -> v1.compiler.emit_core_support.EmitResult {
  let registry = typed.item_registry
  let test_projections = v1.compiler.emit_core_support.extract_test_projections(typed: typed)
  let module_files = typed.modules |> map(tm => emit_py_module(typed_module: tm, registry: registry))
  let test_files = typed.modules
    |> map(tm => emit_py_test_file(
      module_name: v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module),
      projections: test_projections |> filter(p => p.module_name == v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module))))
    |> filter(f => string_length(s: f.content) > 0)
  let init_file = emit_init_py(modules: typed.modules)
  let requirements = emit_requirements_txt(has_services: v1.compiler.emit.has_service_items(typed: typed))
  let files = concat([requirements, init_file], module_files, test_files)
  v1.compiler.emit_core_support.EmitResult { files: files, diagnostics: [] }
}

fn py_derive_attribute() -> String {
  match v1.compiler.languages.serialization_for_target(target: v1.compiler.artifact.Python).derive_attribute {
    Present { value: attr } => attr
    Absent => "@dataclass"
  }
}

fn py_default_value() -> String {
  match v1.compiler.languages.serialization_for_target(target: v1.compiler.artifact.Python).default_value {
    Present { value: value } => value
    Absent => "None"
  }
}

fn emit_init_py(modules: List<v1.compiler.infer_items.TypedModule>) -> v1.std.core.TextFile {
  let import_lines = modules |> map(tm =>
    let mod_name = v1.compiler.emit_core_support.module_to_filename(name: v1.std.core.authored_name_at(source_indices: tm.type_env.source_indices, node: tm.module))
    let items = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items
    concat(items.import_from_keyword, " . ", items.import_keyword, " ", mod_name)
  )
  let content = concat("# Generated by v1 compiler -- do not edit.\n\n",
    import_lines |> join(separator: "\n"), "\n")
  let init_path = match v1.compiler.languages.scaffold_for_target(target: v1.compiler.artifact.Python).module_init_file {
    Present { value: path } => path
    Absent => "__init__.py"
  }
  v1.std.core.TextFile { path: init_path, content: content }
}

fn python_test_signature_comment(projection: v1.compiler.emit_core_support.TestProjection) -> String {
  let params_str = projection.params
    |> map(p => concat(v1.std.core.param_node_name_at(n: p, source_indices: projection.source_indices), ": ", v1.compiler.emit.emit_node_type(n: v1.std.core.param_node_type_expr(n: p), target: v1.compiler.artifact.Python, source_indices: projection.source_indices)))
    |> join(separator: ", ")
  concat(
    "# Signature: ",
    v1.compiler.emit_core_support.sanitize_service_name(name: projection.service_name), ".",
    projection.operation_name,
    "(",
    params_str,
    ") -> ",
    v1.compiler.emit.emit_node_type(n: projection.inferred, target: v1.compiler.artifact.Python, source_indices: projection.source_indices))
}

fn emit_py_test_file(module_name: String, projections: List<v1.compiler.emit_core_support.TestProjection>) -> v1.std.core.TextFile {
  if projections |> count == 0 {
    v1.std.core.TextFile { path: "<none>", content: "" }
  } else {
    let tests_str = projections
      |> map(p => emit_py_operation_test(projection: p, depth: 0))
      |> join(separator: "\n\n")
    let content = concat(
      "# Generated tests -- do not edit.\n",
      "# Source module: ", module_name, "\n\n",
      tests_str, "\n")
    v1.std.core.TextFile { path: v1.compiler.emit.test_file_path(module_name: module_name, target: v1.compiler.artifact.Python), content: content }
  }
}

fn emit_py_operation_test(projection: v1.compiler.emit_core_support.TestProjection, depth: Int) -> String {
  let test_name = v1.compiler.emit_core_support.test_function_name(projection: projection, target: v1.compiler.artifact.Python)
  let indent = v1.compiler.emit_core_support.make_indent(level: depth + 1)
  let mock_setup = projection.mock_field_inits
    |> map(mp => emit_py_mock_prop_setup(mock_prop: mp, depth: depth + 1, source_indices: projection.source_indices))
    |> join(separator: "\n")
  concat(
    v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items.func_keyword, " ", test_name, "() -> None:\n",
    indent, python_test_signature_comment(projection: projection), "\n",
    indent, mock_setup, "\n",
    indent, "# TODO: add dry-run support to Python service emission for full invocation tests\n",
    indent, "assert True  # mock data setup verified\n")
}

fn emit_py_mock_prop_setup(mock_prop: v1.std.core.Node, depth: Int, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  concat(
    v1.compiler.emit.emit_ident(name: v1.std.core.field_init_node_name_at(n: mock_prop, source_indices: source_indices), target: v1.compiler.artifact.Python),
    " = ",
    v1.compiler.emit.emit_simple_expr(expr: v1.std.core.field_init_node_value(n: mock_prop), target: v1.compiler.artifact.Python, source_indices: source_indices))
}

fn emit_py_module(typed_module: v1.compiler.infer_items.TypedModule, registry: Map<String, v1.compiler.infer_items.ItemInfo>) -> v1.std.core.TextFile {
  let m = typed_module.module
  let scope = v1.compiler.emit.module_emit_scope(typed_module: typed_module)
  let si = scope.type_env.source_indices
  let mod_name_str = v1.std.core.authored_name_at(source_indices: si, node: m)
  let prelude = emit_py_prelude(typed_module: typed_module)
  let imports_str = emit_py_imports(imports: v1.std.core.module_imports(n: m), source_indices: si)
  let imports_section = if imports_str == "" { "" } else { concat("\n", imports_str) }
  let items_str = typed_module.items
    |> map(item => emit_py_typed_item(item: item, registry: registry, scope: scope))
    |> join(separator: "\n\n\n")
  let filename = v1.compiler.emit_core_support.module_to_filename(name: mod_name_str)
  let content = concat("# Generated by v1 compiler -- do not edit.\n",
    "# Source module: ", mod_name_str, "\n\n",
    prelude, imports_section, "\n\n\n",
    items_str, "\n")
  v1.std.core.TextFile { path: concat(filename, v1.compiler.languages.scaffold_for_target(target: v1.compiler.artifact.Python).source_file_extension), content: content }
}

fn emit_py_imports(imports: List<v1.std.core.Node>, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  if imports |> count == 0 {
    ""
  } else {
    let import_lines = imports |> map(imp =>
      let mod_name = v1.compiler.emit_core_support.module_to_filename(name: v1.std.core.authored_name_at(source_indices: source_indices, node: imp))
      let items = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items
      if v1.std.core.import_is_all(n: imp) {
        concat(items.import_from_keyword, " ", mod_name, " ", items.import_keyword, " *")
      } else {
          let specific_names = v1.std.core.import_specific_names_at(n: imp, source_indices: source_indices)
          if specific_names |> count == 0 {
            ""
          } else {
            let names_str = specific_names |> join(separator: ", ")
            concat(items.import_from_keyword, " ", mod_name, " ", items.import_keyword, " ", names_str)
          }
      }
    )
    import_lines |> filter(line => line != "") |> join(separator: "\n")
  }
}

fn emit_py_prelude(typed_module: v1.compiler.infer_items.TypedModule) -> String {
  let items = typed_module.items
  let has_structs = items |> any(item => v1.compiler.emit_core_support.is_type_def_item(item: item) && item.connective == v1.std.core.Conj)
  let has_enums = items |> any(item => v1.compiler.emit_core_support.is_type_def_item(item: item) && item.connective == v1.std.core.Disj)
  let has_services = items |> any(item => v1.compiler.emit_core_support.is_service_item(item: item))

  let future_import = "from __future__ import annotations\n"
  let dc_import = if has_structs { "from dataclasses import dataclass, field\n" } else { "" }
  let enum_import = if has_enums { "from enum import Enum, auto\n" } else { "" }
  let typing_import = if has_structs || has_enums { "from typing import Optional, Union\n" } else { "" }
  let async_import = if has_services { "import aiohttp\n" } else { "" }

  concat(future_import, dc_import, enum_import, typing_import, async_import)
}

fn emit_py_typed_item(item: v1.std.core.Node, registry: Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope) -> String {
  let env = scope.type_env
  let item_text = v1.compiler.infer_env.authored_name(env: env, node: item)
  if v1.compiler.emit_core_support.is_type_def_item(item: item) {
    emit_py_type_def_from_connective(item: item, env: env)
  } else if v1.compiler.emit_core_support.is_type_alias_item(item: item, source_indices: env.source_indices) {
    concat(item_text, " = ", v1.compiler.emit.emit_node_type(n: v1.compiler.infer_types.resolved_type(n: item), target: v1.compiler.artifact.Python, source_indices: env.source_indices))
  } else if v1.compiler.emit_core_support.is_type_decl_item(item: item, source_indices: env.source_indices) {
    ""
  } else if v1.compiler.emit_core_support.is_function_item(item: item) {
    if item.uses |> count > 0 {
      emit_py_func_def(name: item_text, params: item.params, inferred: v1.compiler.infer_types.resolved_type(n: item), uses: item.uses, body: item.body.value, registry: registry, scope: scope)
    } else {
      emit_py_fn_def(name: item_text, params: item.params, inferred: v1.compiler.infer_types.resolved_type(n: item), body: item.body.value, registry: registry, scope: scope)
    }
  } else if v1.compiler.emit_core_support.is_data_def_item(item: item) {
    emit_py_data_def(name: item_text, type_node: item.type_annotation.value, value: item.body.value, registry: registry, scope: scope)
  } else if v1.compiler.emit_core_support.is_service_def_item(item: item) {
    emit_py_service_def(item: item, registry: registry, env: env)
  } else if v1.compiler.emit_core_support.is_resource_def_item(item: item) {
    emit_py_resource_def(item: item, env: env)
  } else {
    concat("# unhandled node: ", item_text)
  }
}

fn emit_py_type_def_from_connective(item: v1.std.core.Node, env: v1.compiler.infer_env.TypeEnv) -> String {
  let item_text = v1.compiler.infer_env.authored_name(env: env, node: item)
  let is_product = item.connective == v1.std.core.Conj
  if is_product {
    emit_py_dataclass_from_children(name: item_text, children: item.children, env: env)
  } else {
    emit_py_enum_from_children(name: item_text, children: item.children, env: env)
  }
}

fn emit_py_dataclass_from_children(name: String, children: List<v1.std.core.Node>, env: v1.compiler.infer_env.TypeEnv) -> String {
  if children |> count == 0 {
    concat(py_derive_attribute(), "\nclass ", name, ":\n    pass")
  } else {
    let field_lines = children |> map(child => emit_py_dataclass_field_from_child(child: child, env: env))
    let fields_str = field_lines |> join(separator: "\n")
    concat(py_derive_attribute(), "\nclass ", name, ":\n", fields_str)
  }
}

fn emit_py_dataclass_field_from_child(child: v1.std.core.Node, env: v1.compiler.infer_env.TypeEnv) -> String {
  let ty = v1.compiler.emit.emit_node_type(n: v1.compiler.infer_types.resolved_type(n: child), target: v1.compiler.artifact.Python, source_indices: env.source_indices)
  let is_optional = v1.compiler.infer_types.resolved_type(n: child).return_cardinality == v1.std.core.CardOptional
  let default_str = if is_optional {
    concat(" = ", py_default_value())
  } else {
    ""
  }
  concat("    ", v1.compiler.emit.emit_ident(name: v1.compiler.infer_env.authored_name(env: env, node: child), target: v1.compiler.artifact.Python), ": ", ty, default_str)
}

fn emit_py_enum_from_children(name: String, children: List<v1.std.core.Node>, env: v1.compiler.infer_env.TypeEnv) -> String {
  let has_data = children |> any(child => child.children |> count > 0)
  if has_data {
    let variant_classes = children |> map(child => emit_py_variant_class_from_child(parent_name: name, child: child, env: env))
    let variant_names = children |> map(child => concat(name, v1.compiler.infer_env.authored_name(env: env, node: child)))
    let union_str = variant_names |> join(separator: ", ")
    let classes_str = variant_classes |> join(separator: "\n\n\n")
    concat(classes_str, "\n\n\n", name, " = Union[", union_str, "]")
  } else {
    let variant_lines = children |> map(child =>
      concat("    ", v1.compiler.infer_env.authored_name(env: env, node: child), " = auto()")
    )
    let variants_str = variant_lines |> join(separator: "\n")
    concat(v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items.enum_keyword, " ", name, "(Enum):\n", variants_str)
  }
}

fn emit_py_variant_class_from_child(parent_name: String, child: v1.std.core.Node, env: v1.compiler.infer_env.TypeEnv) -> String {
  let class_name = concat(parent_name, v1.compiler.infer_env.authored_name(env: env, node: child))
  if child.children |> count == 0 {
    concat(py_derive_attribute(), "\nclass ", class_name, ":\n    pass")
  } else {
    let field_lines = child.children |> map(f => emit_py_dataclass_field_from_child(child: f, env: env))
    let fields_str = field_lines |> join(separator: "\n")
    concat(py_derive_attribute(), "\nclass ", class_name, ":\n", fields_str)
  }
}

fn emit_py_fn_def(name: String, params: List<v1.std.core.Node>, inferred: v1.std.core.Node, body: v1.std.core.Node, registry: Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope) -> String {
  let depth = 0
  let si = scope.type_env.source_indices
  let params_str = v1.compiler.emit.emit_params_shared(params: params, target: v1.compiler.artifact.Python, source_indices: si)
  let ret_str = v1.compiler.emit.emit_inferred_shared(inferred: inferred, target: v1.compiler.artifact.Python, source_indices: si)
  let body_scope = v1.compiler.infer.build_params_scope(scope: scope, params: params)
  let use_tco = v1.compiler.emit.is_tco_eligible(name: name, body: body, registry: registry, source_indices: si)
  if use_tco {
    let body_str = v1.compiler.emit.emit_tco_unified(texpr: body, fn_name: name, params: params,
      target: v1.compiler.artifact.Python, registry: registry, scope: body_scope, depth: depth + 1,
      render_pattern: pat => v1.compiler.emit.emit_unified_pattern(pattern: pat, target: v1.compiler.artifact.Python, source_indices: si))
    let kw = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items.func_keyword
    concat(kw, " ", v1.compiler.emit.emit_ident(name: name, target: v1.compiler.artifact.Python), "(", params_str, ")", ret_str, ":\n",
      v1.compiler.emit_core_support.make_indent(level: depth + 1), body_str)
  } else {
    let body_str = emit_py_typed_expr(texpr: body, registry: registry, scope: body_scope, depth: depth + 1, fuel: 1024)
    let kw = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items.func_keyword
    concat(kw, " ", v1.compiler.emit.emit_ident(name: name, target: v1.compiler.artifact.Python), "(", params_str, ")", ret_str, ":\n",
      v1.compiler.emit_core_support.make_indent(level: depth + 1), "return ", body_str)
  }
}

fn emit_py_func_def(
  name: String,
  params: List<v1.std.core.Node>,
  inferred: v1.std.core.Node,
  uses: List<v1.std.core.Node>,
  body: v1.std.core.Node,
  registry: Map<String, v1.compiler.infer_items.ItemInfo>,
  scope: v1.compiler.infer.InferScope
) -> String {
  let depth = 0
  let service_names = match v1.compiler.emit.lookup_item(registry: registry, name: name) {
    Present { value: info } => info.service_names
    Absent => []
  }
  let params_str = emit_py_func_params(params: params, uses: uses, service_names: service_names, source_indices: scope.type_env.source_indices)
  let ret_str = v1.compiler.emit.emit_inferred_shared(inferred: inferred, target: v1.compiler.artifact.Python, source_indices: scope.type_env.source_indices)
  let body_scope = v1.compiler.infer.build_params_scope(scope: scope, params: params)
  let si = scope.type_env.source_indices
  let body_scope = fold(uses, init: body_scope, f: (s, u) =>
    v1.compiler.infer.extend_scope(scope: s, name: v1.std.core.resource_use_name_at(n: u, source_indices: si), resolved: v1.std.core.resource_use_resource(n: u), provenance: std.induction.SubValueUnknown)
  )
  let body_str = v1.compiler.emit.emit_unified_typed_func_body(body: body, target: v1.compiler.artifact.Python, registry: registry, scope: body_scope, depth: depth + 1)
  let items = v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items
  concat(items.async_prefix, items.func_keyword, " ", v1.compiler.emit.emit_ident(name: name, target: v1.compiler.artifact.Python), "(", params_str, ")", ret_str, ":\n",
    v1.compiler.emit_core_support.make_indent(level: depth + 1), body_str)
}

fn emit_py_func_params(params: List<v1.std.core.Node>, uses: List<v1.std.core.Node>, service_names: List<String>, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  let param_strs = params |> map(p => v1.compiler.emit.emit_param_shared(param: p, target: v1.compiler.artifact.Python, source_indices: source_indices))
  let resource_strs = uses |> map(u =>
    concat(v1.compiler.emit.emit_ident(name: v1.std.core.resource_use_name_at(n: u, source_indices: source_indices), target: v1.compiler.artifact.Python), ": ", v1.compiler.emit.emit_node_type(n: v1.std.core.resource_use_resource(n: u), target: v1.compiler.artifact.Python, source_indices: source_indices))
  )
  let service_strs = service_names |> map(sn =>
    concat(v1.compiler.emit_core_support.service_var_name(service_name: sn), ": ", v1.compiler.emit_core_support.sanitize_service_name(name: sn))
  )
  let all_params = concat(param_strs, resource_strs, service_strs)
  all_params |> join(separator: ", ")
}

fn emit_py_typed_expr(texpr: v1.std.core.Node, registry: Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope, depth: Int, fuel: Int) -> String {
  v1.compiler.emit.emit_unified_typed_expr(texpr: texpr, target: v1.compiler.artifact.Python, registry: registry, scope: scope, depth: depth, fuel: fuel,
    render_pattern: pat => v1.compiler.emit.emit_unified_pattern(pattern: pat, target: v1.compiler.artifact.Python, source_indices: scope.type_env.source_indices))
}

fn emit_py_transport_body(transport: v1.std.core.Node, op_name: String, source_indices: Map<String, v1.std.core.NewlineIndex>, depth: Int) -> String {
  v1.compiler.emit.emit_unified_transport_dispatch(
    transport: transport, op_name: op_name, source_indices: source_indices, depth: depth, target: v1.compiler.artifact.Python,
    render_rest: (n, t, d, si) => emit_py_rest_call(op_name: n, transport: t, source_indices: si),
    render_shell: (n, t, d, si) => emit_py_shell_call(op_name: n, transport: t, source_indices: si),
    render_local: (n, d) => emit_py_local_call(op_name: n))
}

fn emit_py_service_def(item: v1.std.core.Node, registry: Map<String, v1.compiler.infer_items.ItemInfo>, env: v1.compiler.infer_env.TypeEnv) -> String {
  v1.compiler.emit.emit_unified_service_def(
    item: item, target: v1.compiler.artifact.Python, registry: registry, env: env,
    render_service_fields: (name, transport, ops, si) =>
      emit_py_service_init(fallback_transport: transport, op_children: ops, source_indices: si),
    render_transport_body: (transport, op_name, si, depth) =>
      emit_py_transport_body(transport: transport, op_name: op_name, source_indices: si, depth: depth))
}

fn emit_py_service_init(fallback_transport: v1.std.core.Node, op_children: List<v1.std.core.Node>, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  let fs = v1.compiler.emit.compute_service_fields(fallback_transport: fallback_transport, op_children: op_children, source_indices: source_indices)
  let params = v1.compiler.emit.service_field_decls(fs: fs, t: v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).service_fields)
  let assigns = v1.compiler.emit.service_field_ctors(fs: fs, t: v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).service_fields)
  if params |> count == 0 {
    "def __init__(self):\n    pass"
  } else {
    let params_str = concat("self, ", params |> join(separator: ", "))
    let assigns_str = assigns |> map(a => concat("    ", a)) |> join(separator: "\n")
    concat("def __init__(", params_str, "):\n", assigns_str)
  }
}

fn emit_py_rest_call(op_name: String, transport: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  let self_base_url = concat("{", "self.base_url", "}")
  let url_line = concat("url = f\"", self_base_url, "/", v1.compiler.emit.emit_ident(name: op_name, target: v1.compiler.artifact.Python), "\"")
  let headers_dict = emit_py_headers_dict(transport: transport, source_indices: source_indices)
  let session_lines = concat(
    "async with aiohttp.ClientSession() as session:\n",
    "    async with session.post(url, headers=headers) as response:\n",
    "        return await response.json()"
  )
  concat(url_line, "\n", headers_dict, "\n", session_lines)
}

fn emit_py_headers_dict(transport: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  let auth_entry = if v1.std.core.transport_has_auth(t: transport, source_indices: source_indices) {
    let header_name = match v1.std.core.transport_auth_header_name(t: transport, source_indices: source_indices) {
      Present { value: h } => h
      Absent => "Authorization"
    }
    concat("\"", header_name, "\": self.auth_token, ")
  } else { "" }
  let hdrs = v1.std.core.transport_headers(t: transport, source_indices: source_indices)
  let header_entries = hdrs |> map(h =>
    concat("\"", v1.std.core.field_init_node_name_at(n: h, source_indices: source_indices), "\": ", v1.compiler.emit.emit_simple_expr(expr: v1.std.core.field_init_node_value(n: h), target: v1.compiler.artifact.Python, source_indices: source_indices))
  )
  let all_entries = if auth_entry == "" {
    header_entries |> join(separator: ", ")
  } else {
    concat(auth_entry, header_entries |> join(separator: ", "))
  }
  concat("headers = {", all_entries, "}")
}

fn emit_py_shell_call(op_name: String, transport: v1.std.core.Node, source_indices: Map<String, v1.std.core.NewlineIndex>) -> String {
  let envs = v1.std.core.transport_env(t: transport, source_indices: source_indices)
  let env_dict_entries = envs |> map(e =>
    concat("\"", v1.std.core.field_init_node_name_at(n: e, source_indices: source_indices), "\": ", v1.compiler.emit.emit_simple_expr(expr: v1.std.core.field_init_node_value(n: e), target: v1.compiler.artifact.Python, source_indices: source_indices))
  )
  let env_str = concat("{", env_dict_entries |> join(separator: ", "), "}")
  concat(
    "import subprocess\n",
    "result = subprocess.run(\n",
    "    [\"", v1.compiler.emit.emit_ident(name: op_name, target: v1.compiler.artifact.Python), "\"],\n",
    "    cwd=self.working_dir or \".\",\n",
    "    env=", env_str, ",\n",
    "    capture_output=True, text=True,\n",
    ")\n",
    "return result.stdout"
  )
}

fn emit_py_local_call(op_name: String) -> String {
  concat("# Local binding -- direct function call\n",
    "return ", v1.compiler.emit.emit_ident(name: op_name, target: v1.compiler.artifact.Python), "()")
}

fn emit_py_resource_def(item: v1.std.core.Node, env: v1.compiler.infer_env.TypeEnv) -> String {
  let item_text = v1.compiler.infer_env.authored_name(env: env, node: item)
  let depth = 0
  let cap_children = item.children
  let methods = cap_children |> map(c => emit_py_capability_method(cap_node: c, env: env))
  let methods_str = methods |> join(separator: "\n\n")
  concat("from abc import ABC, abstractmethod\n\n",
    v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items.struct_keyword, " ", item_text, "(ABC):\n",
    v1.compiler.emit_core_support.make_indent(level: depth + 1), methods_str)
}

fn emit_py_capability_method(cap_node: v1.std.core.Node, env: v1.compiler.infer_env.TypeEnv) -> String {
  let input_params = cap_node.params |> map(p =>
    concat(v1.compiler.emit.emit_ident(name: v1.std.core.param_node_name_at(n: p, source_indices: env.source_indices), target: v1.compiler.artifact.Python), ": ", v1.compiler.emit.emit_node_type(n: v1.std.core.param_node_type_expr(n: p), target: v1.compiler.artifact.Python, source_indices: env.source_indices))
  )
  let params_str = input_params |> join(separator: ", ")
  let all_params = if params_str == "" {
    "self"
  } else {
    concat("self, ", params_str)
  }
  let ret = v1.compiler.emit.emit_node_type(n: v1.compiler.infer_types.resolved_type(n: cap_node), target: v1.compiler.artifact.Python, source_indices: env.source_indices)
  concat("@abstractmethod\n",
    v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items.async_prefix, v1.compiler.emit_core_support.language_spec(target: v1.compiler.artifact.Python).items.func_keyword, " ", v1.compiler.emit.emit_ident(name: v1.compiler.infer_env.authored_name(env: env, node: cap_node), target: v1.compiler.artifact.Python), "(", all_params, ") -> ", ret, ":\n",
    "    ...")
}

fn emit_py_data_def(name: String, type_node: v1.std.core.Node, value: v1.std.core.Node, registry: Map<String, v1.compiler.infer_items.ItemInfo>, scope: v1.compiler.infer.InferScope) -> String {
  let ty_str = v1.compiler.emit.emit_node_type(n: type_node, target: v1.compiler.artifact.Python, source_indices: scope.type_env.source_indices)
  let upper_name = v1.compiler.emit_core_support.to_screaming_snake(name: name)
  let val_str = emit_py_typed_expr(texpr: value, registry: registry, scope: scope, depth: 0, fuel: 1024)
  concat(upper_name, ": ", ty_str, " = ", val_str)
}

fn emit_requirements_txt(has_services: Bool) -> v1.std.core.TextFile {
  let base_deps = ""
  let async_deps = if has_services {
    "aiohttp>=3.9\n"
  } else {
    ""
  }
  v1.std.core.TextFile { path: "requirements.txt", content: concat(base_deps, async_deps) }
}
