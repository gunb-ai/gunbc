module v1.compiler.infer_emit_info

import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }

import v1.std.core {
  Node,
  authored_name_at, NewlineIndex, find_child_named, has_child_named,
  InferredNode, Resolved, TypeVariable,
  FieldAccessStyle, StoredField, EnumAccessor, TupleFirst, TupleSecond,
  FieldValueShape, PlainValue, OptionalValue,
  FieldSummary,
  with_required_cardinality,
  Connective, Conj, NoConnective, Arrow,
  CardOptional,
  param_node_name_at,
  ParsedModuleItemKind, ModuleItemTypeDeclaration, ModuleItemFunction, ModuleItemDataValue,
  ModuleItemService, ModuleItemResource, ModuleItemUnrecognized, NotAModuleItem,
}
import v1.compiler.infer_env { TypeEnv, empty_symbol_index, empty_type_env }
import v1.compiler.infer_types {
  normalize_access_type_node, resolved_type,
  child_type_node, emit_map_has, node_type_equals
}
import v1.compiler.artifact { Rust }
import v1.compiler.coercion { realized_checkpoint, declaration_realization }
fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

type TypeRepr = StructRepr | EnumRepr { unit_only: Bool }

type TypeSummary {
  name: String
  repr: TypeRepr
  field_summaries: Map<String, FieldSummary>
  field_type_map: Map<String, String>
  field_import_surface_names: List<String>
  variant_name_set: Map<String, Bool>
  generic_param_names: List<String>
  has_fn_fields: Bool
}

type FieldTypeMapBuild {
  field_types: Map<String, String>
  import_surface_names: List<String>
}

type UniqueStringAccum {
  seen: Map<String, Bool>
  result: List<String>
}

fn dedupe_nonempty_strings(items: List<String>) -> List<String> {
  let acc = items |> fold(init: UniqueStringAccum { seen: empty_map(), result: [] }, f: (inner, item) =>
    if item == "" || emit_map_has(m: inner.seen, key: item) { inner }
    else { UniqueStringAccum { seen: map_insert(inner.seen, item, true), result: concat(inner.result, [item]) } }
  )
  acc.result
}

// One walk owns both the import-surface name and the position in which that
// occurrence was found.  Consumers that only need names project `name`; the
// Rust use-line classifier additionally consumes `applied_argument` rather
// than rebuilding a second walk over the same type tree.
type TypeSurfaceOccurrence {
  name: String
  applied_argument: Bool
}

fn collect_type_node_import_surface_occurrences(n: Node, applied_argument: Bool, source_indices: Map<String, NewlineIndex>) -> List<TypeSurfaceOccurrence> {
  let peeled = normalize_access_type_node(n: n)
  let name = authored_name_at(source_indices: source_indices, node: peeled)
  let is_tv = if peeled.inferred != none { is_type_variable(inferred: peeled.inferred.value) } else { false }
  let own = if name != "" && name != "Dynamic" && !is_tv { [TypeSurfaceOccurrence { name: name, applied_argument: applied_argument }] } else { [] }
  let children_are_applied_arguments = name != "" && peeled.connective == NoConnective && peeled.children |> count > 0
  let child_names = peeled.children |> flat_map(ch =>
    collect_type_node_import_surface_occurrences(n: child_type_node(ch: ch), applied_argument: children_are_applied_arguments, source_indices: source_indices)
  )
  let inferred_names = match peeled.inferred {
    Present { value: Resolved { node: rt } } => collect_type_node_import_surface_occurrences(n: rt, applied_argument: applied_argument, source_indices: source_indices)
    _ => []
  }
  concat(own, concat(child_names, inferred_names))
}

fn collect_type_node_import_surface_names(n: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  dedupe_nonempty_strings(items: collect_type_node_import_surface_occurrences(n: n, applied_argument: false, source_indices: source_indices) |> map(o => o.name))
}

// fn_decl_items mirrors type_decl_items (dashboard node adhoc-574e999b-39c): a fn-name-keyed lookup
// into the SAME typed (post-04_infer, .inferred-populated) module items build_emit_graph_info
// already folds over, so a caller-side Clone-bound derivation (v1.compiler.trait_bound_witness) can
// resolve a callee-by-name and re-run emit_fn_def's own derivation on the callee's real declaration
// Node — never a second, parallel re-parse or re-inference of the callee.

// item_leaf_owner_modules IS THE REVERSE DIRECTION OF THE REGISTRY KEY, BUILT ONCE.
// The item registry is keyed on a declaration's identity, so it answers "what is THIS declaration"
// and cannot answer "which module declares this leaf". Emission asks the reverse wherever it holds
// only a spelling -- an unqualified reference to an imported value above all. It used to come back
// for free because the registry was itself leaf-keyed, and it came back wrong whenever two modules
// declared the leaf. This index carries the OWNER MODULE PATH rather than the ItemInfo, for two
// reasons: the row still has exactly one authority, the registry, and this module sits upstream of
// v1.compiler.infer_items, so naming ItemInfo here would close an import cycle -- the one structural
// law the graph has. A leaf claimed by more than one module maps to the empty string, which is not
// a legal module path, so the identity lookup built from it misses and the consumer refuses: the
// ambiguous case fails closed by construction rather than by a check.
type EmitGraphInfo {
  type_summaries: Map<String, TypeSummary>
  type_decl_items: Map<String, Node>
  fn_decl_items: Map<String, Node>
  recursive_type_set: Set<String>
  fielded_variants: Set<String>
  positional_payload_variants: Set<String>

  shared_types: Set<String>
  ownership_index: Map<String, Set<String>>
  movable: Set<String>
  variant_to_enum: Map<String, String>
  owned_bindings: Set<String>

  read_only_params_index: Map<String, Set<String>>
  read_only_params: Set<String>

  clone_bounded_type_params: Map<String, Set<String>>
  map_key_required_type_names: Set<String>
  clone_impl_required_type_params: Map<String, Set<String>>

  fn_generic_param_names: List<String>
  fn_type_env: TypeEnv
  fn_return_type: Node?
  expected_type: Node?

  item_leaf_owner_modules: Map<String, String>
}

type EmitInfoBuildState {
  type_summaries: Map<String, TypeSummary>
  type_decl_items: Map<String, Node>
  fn_decl_items: Map<String, Node>
  structural_alias_fn_surface_names: Map<String, List<String>>
  structural_alias_direct_fn_names: Set<String>
}

fn empty_emit_graph_info() -> EmitGraphInfo {
  EmitGraphInfo {
    item_leaf_owner_modules: empty_map(),
    type_summaries: empty_map(),
    type_decl_items: empty_map(),
    fn_decl_items: empty_map(),
    recursive_type_set: empty_set(),
    fielded_variants: empty_set(),
    positional_payload_variants: empty_set(),
    shared_types: empty_set(),
    ownership_index: empty_map(),
    movable: empty_set(),
    variant_to_enum: empty_map(),
    owned_bindings: empty_set(),
    read_only_params_index: empty_map(),
    read_only_params: empty_set(),
    clone_bounded_type_params: empty_map(),
    map_key_required_type_names: empty_set(),
    clone_impl_required_type_params: empty_map(),

    fn_generic_param_names: [],
    fn_type_env: empty_type_env(),
    fn_return_type: none,
    expected_type: none
  }
}

fn emit_info_with_fn_type_context(emit_info: EmitGraphInfo, generic_param_names: List<String>, env: TypeEnv) -> EmitGraphInfo {
  EmitGraphInfo {
    item_leaf_owner_modules: emit_info.item_leaf_owner_modules,
    type_summaries: emit_info.type_summaries,
    type_decl_items: emit_info.type_decl_items,
    fn_decl_items: emit_info.fn_decl_items,
    recursive_type_set: emit_info.recursive_type_set,
    fielded_variants: emit_info.fielded_variants,
    positional_payload_variants: emit_info.positional_payload_variants,
    shared_types: emit_info.shared_types,
    ownership_index: emit_info.ownership_index,
    movable: emit_info.movable,
    variant_to_enum: emit_info.variant_to_enum,
    owned_bindings: emit_info.owned_bindings,
    read_only_params_index: emit_info.read_only_params_index,
    read_only_params: emit_info.read_only_params,
    clone_bounded_type_params: emit_info.clone_bounded_type_params,
    map_key_required_type_names: emit_info.map_key_required_type_names,
    clone_impl_required_type_params: emit_info.clone_impl_required_type_params,
    fn_generic_param_names: generic_param_names,
    fn_type_env: env,
    fn_return_type: emit_info.fn_return_type,
    expected_type: emit_info.expected_type
  }
}

fn emit_info_with_fn_return(emit_info: EmitGraphInfo, fn_return_type: Node?) -> EmitGraphInfo {
  EmitGraphInfo {
    item_leaf_owner_modules: emit_info.item_leaf_owner_modules,
    type_summaries: emit_info.type_summaries,
    type_decl_items: emit_info.type_decl_items,
    fn_decl_items: emit_info.fn_decl_items,
    recursive_type_set: emit_info.recursive_type_set,
    fielded_variants: emit_info.fielded_variants,
    positional_payload_variants: emit_info.positional_payload_variants,
    shared_types: emit_info.shared_types,
    ownership_index: emit_info.ownership_index,
    movable: emit_info.movable,
    variant_to_enum: emit_info.variant_to_enum,
    owned_bindings: emit_info.owned_bindings,
    read_only_params_index: emit_info.read_only_params_index,
    read_only_params: emit_info.read_only_params,
    clone_bounded_type_params: emit_info.clone_bounded_type_params,
    map_key_required_type_names: emit_info.map_key_required_type_names,
    clone_impl_required_type_params: emit_info.clone_impl_required_type_params,
    fn_generic_param_names: emit_info.fn_generic_param_names,
    fn_type_env: emit_info.fn_type_env,
    fn_return_type: fn_return_type,
    expected_type: fn_return_type
  }
}

// The type the expression being emitted must inhabit, at EXPRESSION grain. A fn body's tail
// inhabits the declared return (emit_info_with_fn_return seeds it); a record-literal field value
// inhabits the field's declared type, a narrower fact the return type cannot stand in for -- a
// `Violates` literal at a `Witness<Node>` field took its type argument from the fn return
// (`Witness<Rc<RuntimeValueAcceptanceWitness>>`, E0308 x5 at v2.compiler.eval / v2.compiler.compile).
fn emit_info_with_expected_type(emit_info: EmitGraphInfo, expected_type: Node?) -> EmitGraphInfo {
  EmitGraphInfo {
    item_leaf_owner_modules: emit_info.item_leaf_owner_modules,
    type_summaries: emit_info.type_summaries,
    type_decl_items: emit_info.type_decl_items,
    fn_decl_items: emit_info.fn_decl_items,
    recursive_type_set: emit_info.recursive_type_set,
    fielded_variants: emit_info.fielded_variants,
    positional_payload_variants: emit_info.positional_payload_variants,
    shared_types: emit_info.shared_types,
    ownership_index: emit_info.ownership_index,
    movable: emit_info.movable,
    variant_to_enum: emit_info.variant_to_enum,
    owned_bindings: emit_info.owned_bindings,
    read_only_params_index: emit_info.read_only_params_index,
    read_only_params: emit_info.read_only_params,
    clone_bounded_type_params: emit_info.clone_bounded_type_params,
    map_key_required_type_names: emit_info.map_key_required_type_names,
    clone_impl_required_type_params: emit_info.clone_impl_required_type_params,
    fn_generic_param_names: emit_info.fn_generic_param_names,
    fn_type_env: emit_info.fn_type_env,
    fn_return_type: emit_info.fn_return_type,
    expected_type: expected_type
  }
}

fn variant_has_fields(emit_info: EmitGraphInfo, enum_name: String, variant_name: String) -> Bool {
  let key = concat(enum_name, "::", variant_name)
  set_contains(emit_info.fielded_variants, key)
}

fn variant_summary_key(enum_name: String, variant_name: String) -> String {
  concat(enum_name, "::", variant_name)
}

fn lookup_emit_type_summary(emit_info: EmitGraphInfo, type_name: String) -> TypeSummary? {
  map_get(emit_info.type_summaries, type_name)
}

fn lookup_emit_type_decl(emit_info: EmitGraphInfo, type_name: String) -> Node? {
  map_get(emit_info.type_decl_items, type_name)
}

fn emit_graph_records_type_decl(item: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match build_type_summary(item: item, source_indices: source_indices) {
    Present { value: _ } => true
    Absent =>
      item.module_item_kind == ModuleItemTypeDeclaration
        && item.connective == NoConnective
        && (item.children |> count) == 0
        && (item.params |> count) == 0
  }
}

// THE DUPLICATE PREDICATE IS GONE. What stood here duplicated v1.compiler.emit_core_support's
// is_function_item -- `body != none && type_annotation == none` -- and argued the duplication was
// layering: this module is upstream of emit_core_support in the DAG, and both predicates answered
// "what item shape reaches this stage's fold". The argument was sound and the fact it forked was
// the wrong fact. An item's kind is not a per-stage question at all: v1.std.core Node now carries
// module_item_kind, stamped by the parse constructor, so both stages read ONE authority that is
// upstream of both and neither re-derives a shape.
fn emit_graph_records_fn_decl(item: Node) -> Bool {
  item.module_item_kind == ModuleItemFunction
}

fn derive_variant_to_enum(type_summaries: Map<String, TypeSummary>) -> Map<String, String> {
  map_values(type_summaries) |> fold(init: empty_map(), f: (acc, summary) =>
    match summary.repr {
      EnumRepr { unit_only: _ } =>
        fold(map_keys(summary.variant_name_set), init: acc, f: (inner, vn) =>
          match map_get(inner, vn) {
            Present { value: _ } => map_insert(inner, vn, "")
            Absent => map_insert(inner, vn, summary.name)
          }
        )
      _ => acc
    }
  )
}

fn is_known_variant(type_summaries: Map<String, TypeSummary>, name: String) -> Bool {
  map_values(type_summaries) |> any(summary =>
    match summary.repr {
      EnumRepr { unit_only: _ } => emit_map_has(m: summary.variant_name_set, key: name)
      _ => false
    }
  )
}

fn variant_belongs_to_enum(type_summaries: Map<String, TypeSummary>, variant_name: String, enum_name: String) -> Bool {
  match map_get(type_summaries, enum_name) {
    Present { value: summary } =>
      match summary.repr {
        EnumRepr { unit_only: _ } =>
          emit_map_has(m: summary.variant_name_set, key: variant_name)
        _ => false
      }
    Absent => false
  }
}

fn is_enum_in_summaries(type_summaries: Map<String, TypeSummary>, type_name: String) -> Bool {
  match map_get(type_summaries, type_name) {
    Present { value: summary } => match summary.repr {
      EnumRepr { unit_only: _ } => true
      _ => false
    }
    Absent => false
  }
}

fn find_variant_parent(type_summaries: Map<String, TypeSummary>, variant_name: String, scope_enums: List<String>) -> String? {
  scope_enums |> filter(en =>
    variant_belongs_to_enum(type_summaries: type_summaries, variant_name: variant_name, enum_name: en)
  ) |> first
}

fn field_value_shape_from_type_node(type_node: Node) -> FieldValueShape {
  let normed = normalize_access_type_node(n: type_node)
  let is_optional = normed.return_cardinality == CardOptional
  if is_optional { OptionalValue }
  else { PlainValue }
}

fn is_tuple_type(n: Node) -> Bool {
  n.connective == Conj && n.ident_span == none && n.children |> count == 2
}

fn build_struct_field_summaries(parent: Node, source_indices: Map<String, NewlineIndex>) -> Map<String, FieldSummary> {
  let is_pair = is_tuple_type(n: parent)
  fold(parent.children |> enumerate, init: empty_map(), f: (acc, pair) =>
    let idx = pair.first
    let child = pair.second
    if child.inferred == none {
      acc
    } else {
      let style = if is_pair { if idx == 0 { TupleFirst } else { TupleSecond } } else { StoredField }
      let key = authored_name_at(source_indices: source_indices, node: child)
      map_insert(acc, key, FieldSummary {
        access_style: style,
        value_shape: field_value_shape_from_type_node(type_node: child_type_node(ch: child))
      })
    }
  )
}

fn find_first_enum_field_node(variants: List<Node>, field_name: String, source_indices: Map<String, NewlineIndex>) -> Node? {
  match variants |> first {
    Present { value: variant } =>
      match find_child_named(n: variant, name: field_name, source_indices: source_indices) {
        Present { value: field_child } => Present { value: field_child }
        Absent => none
      }
    Absent => none
  }
}

fn enum_field_present_in_all_variants(variants: List<Node>, field_name: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  variants |> all(variant =>
    has_child_named(n: variant, name: field_name, source_indices: source_indices)
  )
}

fn enum_field_type_consistent(variants: List<Node>, field_name: String, expected: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  variants |> all(variant =>
    match find_child_named(n: variant, name: field_name, source_indices: source_indices) {
      Present { value: field_child } => node_type_equals(left: child_type_node(ch:field_child), right: expected, source_indices: source_indices)
      Absent => false
    }
  )
}

fn build_enum_field_summaries(variants: List<Node>, source_indices: Map<String, NewlineIndex>) -> Map<String, FieldSummary> {
  let first_field_names = match variants |> first {
    Present { value: first_variant } => first_variant.children |> map(f => authored_name_at(source_indices: source_indices, node: f))
    Absent => []
  }
  let shared = first_field_names |> filter(field_name =>
    enum_field_present_in_all_variants(variants: variants, field_name: field_name, source_indices: source_indices)
  )
  let consistent = shared |> filter(field_name =>
    match find_first_enum_field_node(variants: variants, field_name: field_name, source_indices: source_indices) {
      Present { value: first_field } =>
        enum_field_type_consistent(variants: variants, field_name: field_name, expected: child_type_node(ch:first_field), source_indices: source_indices)
      Absent => false
    }
  )
  fold(consistent, init: empty_map(), f: (acc, field_name) =>
    match find_first_enum_field_node(variants: variants, field_name: field_name, source_indices: source_indices) {
      Present { value: first_field } =>
        map_insert(acc, field_name, FieldSummary {
          access_style: EnumAccessor,
          value_shape: field_value_shape_from_type_node(type_node: child_type_node(ch:first_field))
        })
      Absent => acc
    }
  )
}

fn build_field_type_map(children: List<Node>, source_indices: Map<String, NewlineIndex>) -> FieldTypeMapBuild {
  fold(children, init: FieldTypeMapBuild { field_types: empty_map(), import_surface_names: [] }, f: (acc, child) =>
    match child.inferred {
      Present { value: Resolved { node: ft } } =>
        let resolved_name = authored_name_at(source_indices: source_indices, node: normalize_access_type_node(n: ft))
        let ft_is_type_var = if ft.inferred != none { is_type_variable(inferred: ft.inferred.value) } else { false }
        let key = authored_name_at(source_indices: source_indices, node: child)
        let surface_names = collect_type_node_import_surface_names(n: ft, source_indices: source_indices)
        let next_field_types = if resolved_name != "" && !ft_is_type_var && resolved_name != "Dynamic" {
          map_insert(acc.field_types, key, resolved_name)
        } else { acc.field_types }
        FieldTypeMapBuild {
          field_types: next_field_types,
          import_surface_names: dedupe_nonempty_strings(items: concat(acc.import_surface_names, surface_names))
        }
      _ => acc
    }
  )
}

fn build_type_summary(item: Node, source_indices: Map<String, NewlineIndex>) -> TypeSummary? {
  if item.connective == NoConnective || item.connective == Arrow || item.transport != none {
    return none
  }
  let gpn = item.params |> map(p => param_node_name_at(n: p, source_indices: source_indices))
  let is_product = item.connective == Conj
  let has_fn = item.children |> any(child =>
    match child.inferred {
      Present { value: Resolved { node: rt } } => rt.connective == Arrow
      _ => false
    }
  )
  if is_product {
    let field_types = build_field_type_map(children: item.children, source_indices: source_indices)
    Present { value: TypeSummary {
      name: authored_name_at(source_indices: source_indices, node: item),
      repr: StructRepr,
      field_summaries: build_struct_field_summaries(parent: item, source_indices: source_indices),
      field_type_map: field_types.field_types,
      field_import_surface_names: field_types.import_surface_names,
      variant_name_set: empty_map(),
      generic_param_names: gpn,
      has_fn_fields: has_fn
    } }
  } else {
    let unit_only = item.children |> all(child => child.children |> count == 0)
    Present { value: TypeSummary {
      name: authored_name_at(source_indices: source_indices, node: item),
      repr: EnumRepr { unit_only: unit_only },
      field_summaries: build_enum_field_summaries(variants: item.children, source_indices: source_indices),
      field_type_map: empty_map(),
      field_import_surface_names: enum_variant_payload_surface_names(variants: item.children, source_indices: source_indices),
      variant_name_set: fold(item.children, init: empty_map(), f: (acc, child) => map_insert(acc, authored_name_at(source_indices: source_indices, node: child), true)),
      generic_param_names: gpn,
      has_fn_fields: has_fn || enum_variant_payload_has_fn(variants: item.children)
    } }
  }
}

// A coproduct's payload fields are reachable values exactly as a product's fields are, so the
// fn-reachability walk needs the same edges from an enum that it gets from a struct. Before this,
// build_type_summary gave every non-product an empty field_type_map AND an empty
// field_import_surface_names, which made an enum a dead end in both directions: an enum whose
// variant payload reached a function value derived serde itself, and it blocked propagation to
// anything holding it. Measured on a specimen: `ViaEnum = HasInner { held: Inner } | Empty` with
// `Inner { apply: fn(Int) -> Int }` emitted Serialize/Deserialize on ViaEnum and on its holder,
// while the direct-field control `NestedDirect { inner: Inner }` correctly emitted Clone alone.
fn enum_variant_payload_surface_names(variants: List<Node>, source_indices: Map<String, NewlineIndex>) -> List<String> {
  dedupe_nonempty_strings(items: variants |> flat_map(v =>
    let built = build_field_type_map(children: v.children, source_indices: source_indices)
    built.import_surface_names
  ))
}

// The direct arm of the same gap: a variant payload whose own resolved type IS an arrow. A
// function type has no authored name, so the surface-name walk above cannot see it and this is a
// separate question rather than a special case of it.
fn enum_variant_payload_has_fn(variants: List<Node>) -> Bool {
  variants |> any(v => v.children |> any(child =>
    match child.inferred {
      Present { value: Resolved { node: rt } } => rt.connective == Arrow
      _ => false
    }
  ))
}

fn type_summary_or_structural_alias_reaches_fn(name: String, summaries: Map<String, TypeSummary>, structural_alias_fn_surface_names: Map<String, List<String>>, structural_alias_direct_fn_names: Set<String>, visited: Set<String>) -> Bool {
  if set_contains(visited, name) { false } else {
    let v2 = set_insert(visited, name)
    match map_get(summaries, name) {
      Present { value: s } =>
        s.has_fn_fields || concat(map_values(s.field_type_map), s.field_import_surface_names)
          |> any(target => type_summary_or_structural_alias_reaches_fn(name: target, summaries: summaries, structural_alias_fn_surface_names: structural_alias_fn_surface_names, structural_alias_direct_fn_names: structural_alias_direct_fn_names, visited: v2))
      Absent =>
        set_contains(structural_alias_direct_fn_names, name) || match map_get(structural_alias_fn_surface_names, name) {
          Present { value: targets } => targets |> any(target => type_summary_or_structural_alias_reaches_fn(name: target, summaries: summaries, structural_alias_fn_surface_names: structural_alias_fn_surface_names, structural_alias_direct_fn_names: structural_alias_direct_fn_names, visited: v2))
          Absent => false
        }
    }
  }
}

fn close_fn_fields(summaries: Map<String, TypeSummary>, structural_alias_fn_surface_names: Map<String, List<String>>, structural_alias_direct_fn_names: Set<String>) -> Map<String, TypeSummary> {
  fold(map_keys(summaries), init: summaries, f: (acc, name) =>
    match map_get(summaries, name) {
      Present { value: s } =>
        if !s.has_fn_fields && type_summary_or_structural_alias_reaches_fn(name: name, summaries: summaries, structural_alias_fn_surface_names: structural_alias_fn_surface_names, structural_alias_direct_fn_names: structural_alias_direct_fn_names, visited: empty_set()) {
          map_insert(acc, name, TypeSummary {
            name: s.name,
            repr: s.repr,
            field_summaries: s.field_summaries,
            field_type_map: s.field_type_map,
            field_import_surface_names: s.field_import_surface_names,
            variant_name_set: s.variant_name_set,
            generic_param_names: s.generic_param_names,
            has_fn_fields: true
          })
        } else { acc }
      Absent => acc
    }
  )
}

fn structural_alias_direct_fn_names_with(names: Set<String>, name: String, include: Bool) -> Set<String> {
  if include { set_insert(names, name) } else { names }
}

fn add_emit_item_summary(state: EmitInfoBuildState, item: Node, source_indices: Map<String, NewlineIndex>) -> EmitInfoBuildState {
  let decl_name = authored_name_at(source_indices: source_indices, node: item)
  let alias_rhs = resolved_type(n: item)
  let alias_rhs_name = authored_name_at(source_indices: source_indices, node: alias_rhs)
  let is_type_alias = decl_name != "" && item.connective == NoConnective && item.body == none && (item.params |> count) == 0 && item.transport == none && (item.children |> count) == 0 && alias_rhs_name != "Unit"
  let is_structural_alias = if is_type_alias {
    match realized_checkpoint(decision: declaration_realization(item: item, dag_name: decl_name, target: Rust)) {
      Present { value: _ } => false
      Absent => true
    }
  } else { false }
  let structural_alias_fn_surface_names = if is_structural_alias {
    map_insert(state.structural_alias_fn_surface_names, decl_name, collect_type_node_import_surface_names(n: alias_rhs, source_indices: source_indices))
  } else { state.structural_alias_fn_surface_names }
  let prior_direct_fn_names = state.structural_alias_direct_fn_names
  let structural_alias_direct_fn_names = structural_alias_direct_fn_names_with(names: prior_direct_fn_names, name: decl_name, include: is_structural_alias && alias_rhs.connective == Arrow)
  let state = if decl_name != "" && emit_graph_records_type_decl(item: item, source_indices: source_indices) {
    EmitInfoBuildState {
      type_summaries: state.type_summaries,
      type_decl_items: map_insert(state.type_decl_items, decl_name, item),
      fn_decl_items: state.fn_decl_items,
      structural_alias_fn_surface_names: structural_alias_fn_surface_names,
      structural_alias_direct_fn_names: structural_alias_direct_fn_names
    }
  } else {
    state
  }
  let state = if decl_name != "" && emit_graph_records_fn_decl(item: item) {
    EmitInfoBuildState {
      type_summaries: state.type_summaries,
      type_decl_items: state.type_decl_items,
      fn_decl_items: map_insert(state.fn_decl_items, decl_name, item),
      structural_alias_fn_surface_names: state.structural_alias_fn_surface_names,
      structural_alias_direct_fn_names: state.structural_alias_direct_fn_names
    }
  } else {
    state
  }
  match build_type_summary(item: item, source_indices: source_indices) {
    Present { value: summary } =>
      let with_variants = match summary.repr {
        EnumRepr { unit_only: _ } =>
          fold(item.children, init: state.type_summaries, f: (acc, variant) =>
            if variant.children |> count > 0 {
              let v_has_fn = variant.children |> any(vc =>
                match vc.inferred {
                  Present { value: Resolved { node: rt } } => rt.connective == Arrow
                  _ => false
                }
              )
              let vname = authored_name_at(source_indices: source_indices, node: variant)
              let qualified_vname = variant_summary_key(enum_name: summary.name, variant_name: vname)
              let variant_field_types = build_field_type_map(children: variant.children, source_indices: source_indices)
              map_insert(acc, qualified_vname, TypeSummary {
                name: qualified_vname,
                repr: StructRepr,
                field_summaries: build_struct_field_summaries(parent: variant, source_indices: source_indices),
                field_type_map: variant_field_types.field_types,
                field_import_surface_names: variant_field_types.import_surface_names,
                variant_name_set: empty_map(),
                generic_param_names: [],
                has_fn_fields: v_has_fn
              })
            } else { acc }
          )
        _ => state.type_summaries
      }
      let next_summaries = map_insert(with_variants, summary.name, summary)
      EmitInfoBuildState {
        type_summaries: next_summaries,
        type_decl_items: state.type_decl_items,
        fn_decl_items: state.fn_decl_items,
        structural_alias_fn_surface_names: state.structural_alias_fn_surface_names,
        structural_alias_direct_fn_names: state.structural_alias_direct_fn_names
      }
    Absent => state
  }
}

data emit_dependency_registration_dissolve_on_note: DissolutionCondition = unbound_dissolution(description: "dissolve-on (FreeMonoid pass 2026-07-20): collect emitted cross-module type/path refs during emit into one authority; derive (a) use-lines via build_shared_types + emit_faithful_text_carrier_import_lines and (b) closure pub-mod membership via emit_lib_rs_from_paths from that set. Instance-patch interim: faithful corpus emits carrier import lines per module unless locally defined (FreeMonoid/Char/NonEmptyStr/Int); closure projections (v1.compiler.closure_stub_v2_std_text_rust and closure_stub_v2_std_integer_rust) when refs exist but the real v2.std.text or v2.std.integer module is absent from narrow typed.modules — projections are NOT parallel modeling authorities (see each stub module dissolve_on_note); they dissolve when the ref set includes the real module in the closure.")
