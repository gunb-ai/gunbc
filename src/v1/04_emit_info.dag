import v1.compiler.artifact { Rust }
import v1.compiler.coercion { realized_checkpoint, declaration_realization }
fn is_type_variable(inferred: InferredNode) -> Bool {
  match inferred {
    TypeVariable { id: _ } => true
    _ => false
  }
}

type TypeRepr = StructRepr | EnumRepr { unit_only: Bool }

type TypeSummary {
  name: String
  key: String
  repr: TypeRepr
  field_summaries: Map<String, FieldSummary>
  field_type_map: Map<String, String>
  field_import_surface_names: List<String>
  variant_name_set: Map<String, Bool>
  generic_param_names: List<String>
  has_fn_fields: Bool
}

// THE TYPE SUMMARIES, KEYED BY DECLARATION. A summary is stored under its declaration's identity
// (type_decl_identity: owner module and declared name, the key TypeDeclIndex uses), and a
// variant-payload summary under `<identity>::<Variant>`. The leaf-keyed map this replaces kept ONE
// summary per leaf -- whichever module was folded last -- so a second `Optional` anywhere in a
// closure replaced v2.std.optional's summary for every reader in every module
// (gunbc.recurring_failure_mode emitter_index_keyed_on_a_type_leaf_takes_the_last_declarer).
type TypeSummaryIndex {
  by_key: Map<String, TypeSummary>
  keys_by_leaf: Map<String, List<String>>
}

// A NAME HOLDER'S ANSWER HAS THREE ARMS, as TypeDeclResolution's does: a key (an identity, or an
// identity-qualified variant key) is exact; a bare leaf one declaration owns resolves to it; a bare
// leaf two declarations own is TypeSummaryLeafAmbiguous and names neither.
type TypeSummaryLookup
  = TypeSummaryFound { summary: TypeSummary }
  | TypeSummaryLeafAmbiguous { leaf: String }
  | TypeSummaryNotDeclared

fn empty_type_summary_index() -> TypeSummaryIndex {
  TypeSummaryIndex { by_key: empty_map(), keys_by_leaf: empty_map() }
}

fn type_summary_index_insert(index: TypeSummaryIndex, key: String, leaf: String, summary: TypeSummary) -> TypeSummaryIndex {
  TypeSummaryIndex {
    by_key: map_insert(index.by_key, key, summary),
    keys_by_leaf: map_insert(index.keys_by_leaf, leaf, type_decl_leaf_identities_with(prior: map_get(index.keys_by_leaf, leaf), identity: key))
  }
}

fn type_summary_keys_of_leaf(index: TypeSummaryIndex, leaf: String) -> List<String> {
  match map_get(index.keys_by_leaf, leaf) {
    Present { value: keys } => keys
    Absent => []
  }
}

fn type_summary_at_key(index: TypeSummaryIndex, key: String) -> TypeSummaryLookup {
  match map_get(index.by_key, key) {
    Present { value: summary } => TypeSummaryFound { summary: summary }
    Absent => TypeSummaryNotDeclared
  }
}

fn type_summary_by_leaf(index: TypeSummaryIndex, leaf: String) -> TypeSummaryLookup {
  let keys = type_summary_keys_of_leaf(index: index, leaf: leaf)
  if (keys |> count) == 1 {
    keys |> fold(init: TypeSummaryNotDeclared, f: (_acc, key) => type_summary_at_key(index: index, key: key))
  } else if (keys |> count) > 1 {
    TypeSummaryLeafAmbiguous { leaf: leaf }
  } else {
    TypeSummaryNotDeclared
  }
}

// A string key, as the readers that hold only a name hand it over: an exact key first (an identity,
// or `<identity>::<Variant>`), then a leaf-qualified variant key (`Enum::Variant`, whose enum part
// resolves by its leaf), then a bare leaf. A dotted name that is no key is not resolved by spelling.
fn type_summary_lookup(index: TypeSummaryIndex, key: String) -> TypeSummaryLookup {
  match map_get(index.by_key, key) {
    Present { value: summary } => TypeSummaryFound { summary: summary }
    Absent =>
      if contains(key, "::") {
        let parts = key |> split(delimiter: "::")
        let enum_part = parts |> take((parts |> count) - 1) |> join(separator: "::")
        let variant_part = match parts |> last {
          Present { value: v } => v
          Absent => ""
        }
        match type_summary_lookup(index: index, key: enum_part) {
          TypeSummaryFound { summary: owner } => type_summary_at_key(index: index, key: variant_summary_key(enum_name: owner.key, variant_name: variant_part))
          TypeSummaryLeafAmbiguous { leaf: l } => TypeSummaryLeafAmbiguous { leaf: l }
          TypeSummaryNotDeclared => TypeSummaryNotDeclared
        }
      } else if contains(key, ".") {
        TypeSummaryNotDeclared
      } else {
        type_summary_by_leaf(index: index, leaf: key)
      }
  }
}

// A reader holding a type REFERENCE resolves it the way every emitter reader of a declaration does
// (resolve_type_decl_reference: carried identity, declaring span, the counted interim arms, then the
// spelling), and reads the summary stored under that identity.
fn type_summary_of_reference(index: TypeSummaryIndex, decls: TypeDeclIndex, type_expr: Node, source_indices: Map<String, NewlineIndex>) -> TypeSummaryLookup {
  match resolve_type_decl_reference(index: decls, type_expr: type_expr, source_indices: source_indices) {
    TypeDeclResolved { identity: identity, decl: _ } => type_summary_at_key(index: index, key: identity)
    TypeDeclLeafAmbiguous { leaf: l } => TypeSummaryLeafAmbiguous { leaf: l }
    TypeDeclKernelSpellingUndecided { leaf: l } => TypeSummaryLeafAmbiguous { leaf: l }
    TypeDeclNotDeclared => TypeSummaryNotDeclared
  }
}

// THE OPTIONAL PROJECTION, for readers that hold only a NAME and ask which summary it denotes in order
// to collect use-surfaces or read a field map. It answers a summary only when the name decides one
// (an exact key, or a leaf one declaration owns); a leaf two declarations own answers Absent and no
// summary is picked for it -- the leaf-keyed map this replaces answered with the LAST declarer here.
// The readers that consume it collect names for import lines or check a repr, so an undecided name
// contributes nothing and the item it would have served refuses at rustc, located at its use.
// RESIDUE, declared: these name-holding readers dissolve when the names they hold are keys -- a
// TypeSummary's field_type_map and field_import_surface_names store the field type's declaration
// identity rather than its spelling -- on gunbc.recurring_failure_mode
// emitter_index_keyed_on_a_type_leaf_takes_the_last_declarer's trigger.
fn type_summary_decided(index: TypeSummaryIndex, key: String) -> TypeSummary? {
  match type_summary_lookup(index: index, key: key) {
    TypeSummaryFound { summary: summary } => Present { value: summary }
    TypeSummaryLeafAmbiguous { leaf: _ } => none
    TypeSummaryNotDeclared => none
  }
}

fn type_summary_values(index: TypeSummaryIndex) -> List<TypeSummary> {
  map_values(index.by_key)
}

type FieldTypeMapBuild {
  field_types: Map<String, String>
  import_surface_names: List<String>
}

type UniqueStringAccum {
  seen: Map<String, Bool>
  result: List<String>
}

fn dedupe_nonempty_strings(items: List<String>) -> List<String> {
  let acc = items |> fold(init: UniqueStringAccum { seen: empty_map(), result: [] }, f: (inner, item) =>
    if item == "" || emit_map_has(m: inner.seen, key: item) { inner }
    else { UniqueStringAccum { seen: map_insert(inner.seen, item, true), result: concat(inner.result, [item]) } }
  )
  acc.result
}

// One walk owns both the import-surface name and the position in which that
// occurrence was found.  Consumers that only need names project `name`; the
// Rust use-line classifier additionally consumes `applied_argument` rather
// than rebuilding a second walk over the same type tree.
type TypeSurfaceOccurrence {
  name: String
  applied_argument: Bool
}

// An applied type argument is walked as its AUTHORED node; every other child through child_type_node.
// The resolved form of a nested application (MachineWidth<PointerWidth> inside Compose<Int, MachineWidth<PointerWidth>>)
// keeps the head and drops the authored argument, so walking only that form never made PointerWidth an applied
// occurrence, the use-line planner did not classify it as a marker, and the import bound the unit variant while the
// body rendered the marker type (E0573). The authored node still reaches its resolved form through inferred_names,
// so one walk covers both, with no second descent. Non-argument children (a product's fields) keep child_type_node,
// so a field key is never read as a type name.
fn collect_type_node_import_surface_occurrences(n: Node, applied_argument: Bool, source_indices: Map<String, NewlineIndex>) -> List<TypeSurfaceOccurrence> {
  let peeled = normalize_access_type_node(n: n)
  let name = authored_name_at(source_indices: source_indices, node: peeled)
  let is_tv = if peeled.inferred != none { is_type_variable(inferred: peeled.inferred.value) } else { false }
  let own = if name != "" && name != "Dynamic" && !is_tv { [TypeSurfaceOccurrence { name: name, applied_argument: applied_argument }] } else { [] }
  let children_are_applied_arguments = name != "" && peeled.connective == NoConnective && peeled.children |> count > 0
  let child_names = peeled.children |> flat_map(ch =>
    let walked = if children_are_applied_arguments { ch } else { child_type_node(ch: ch) }
    collect_type_node_import_surface_occurrences(n: walked, applied_argument: children_are_applied_arguments, source_indices: source_indices)
  )
  let inferred_names = match peeled.inferred {
    Present { value: Resolved { node: rt } } => collect_type_node_import_surface_occurrences(n: rt, applied_argument: applied_argument, source_indices: source_indices)
    _ => []
  }
  concat(own, concat(child_names, inferred_names))
}

fn collect_type_node_import_surface_names(n: Node, source_indices: Map<String, NewlineIndex>) -> List<String> {
  dedupe_nonempty_strings(items: collect_type_node_import_surface_occurrences(n: n, applied_argument: false, source_indices: source_indices) |> map(o => o.name))
}

// fn_decl_items mirrors type_decl_items (dashboard node adhoc-574e999b-39c): a fn-name-keyed lookup
// into the SAME typed (post-04_infer, .inferred-populated) module items build_emit_graph_info
// already folds over, so a caller-side Clone-bound derivation (v1.compiler.trait_bound_witness) can
// resolve a callee-by-name and re-run emit_fn_def's own derivation on the callee's real declaration
// Node — never a second, parallel re-parse or re-inference of the callee.

// item_leaf_owner_modules IS THE REVERSE DIRECTION OF THE REGISTRY KEY, BUILT ONCE.
// The item registry is keyed on a declaration's identity, so it answers "what is THIS declaration"
// and cannot answer "which module declares this leaf". Emission asks the reverse wherever it holds
// only a spelling -- an unqualified reference to an imported value above all. It used to come back
// for free because the registry was itself leaf-keyed, and it came back wrong whenever two modules
// declared the leaf. This index carries a v1.std.core LeafOwner rather than the ItemInfo, for two
// reasons: the row still has exactly one authority, the registry, and this module sits upstream of
// v1.compiler.infer_items, so naming ItemInfo here would close an import cycle -- the one structural
// law the graph has. A leaf claimed by more than one module answers the LeafAmbiguous arm, which is
// not a module path at all rather than an empty one, so the ambiguous case fails closed by
// CONSTRUCTION: a reader cannot reach an owner without writing the arm that says there is none.
// THE DATA-PATH PROJECTION OF A COPRODUCT'S WIRE POLICY, one row per (coproduct, variant) pair.
// The authority for the policy is the CoproductWireContract row (or the internal-tag default),
// resolved where the coproduct is emitted as a TYPE; this carrier is what the serde_json DATA path
// can read -- the policy stripped to the one question a variant record literal asks: what JSON
// shape do I take. It lives here rather than in v1.compiler.emit_rust because the value fold that
// consumes it (v1.compiler.emit emit_data_value_json) sits upstream of the Rust policy machinery
// (RustEnumWireSerde) that derives it, and the index on EmitGraphInfo is the hand-off between them.
// DataVariantSpellingRefused is a STORED refusal: the index build poisons a key whose answer the
// closure does not determine (two declarers of one coproduct name whose resolved policies differ,
// or a policy carrying its own error_message), so the value path fails closed with the cause
// rather than spelling a guess.
type DataVariantWireSpelling
  = DataVariantInternalTagged { tag_field: String, tag: String }
  | DataVariantBareString { tag: String }
  | DataVariantUntagged
  | DataVariantSpellingRefused { reason: String }

// THE TYPE-DECLARATION INDEX IS KEYED ON THE DECLARATION, NOT ON ITS LEAF SPELLING. It was a
// Map<leaf, Node> with last write wins, so a closure declaring one leaf in two modules (std.access
// AccessRequest, five parameters, beside gunbc.auth.access_request AccessRequest, one) handed every
// reader of either the declaration folded last, and the Clone-bound fixpoint printed one type's
// header from the other's parameter list. The key is the item registry's own identity
// (v1.std.core callable_identity over DeclaredCallableIdentity), so there is one key space for a
// declaration across the registry and this index. A reader holds a type REFERENCE, which carries no
// module in its spelling; resolve_type_decl_reference below is the one route from a reference to a
// row, and its ambiguous arm is a value the reader must write an arm for: there is deliberately no
// Optional projection of the resolution, because one that answers `none` for an ambiguous leaf hands
// its readers the same `no declaration` they read for a type the corpus does not declare, and they
// proceed on a default.
type TypeDeclIndex {
  by_identity: Map<String, Node>
  identity_by_declaring_span: Map<String, String>
  leaf_owners: Map<String, LeafOwner>
  identities_by_leaf: Map<String, List<String>>
  qualified_names: SymbolIndex
}

// TypeDeclKernelSpellingUndecided IS ITS OWN ARM BECAUSE IT IS A DIFFERENT FACT FROM AMBIGUITY.
// `String` and `Int` are kernel spellings (std.types is_kernel_type), and resolve leaves a
// kernel-spelled reference unstamped on purpose (v1.compiler.infer_resolve
// reference_with_declaration: it names no corpus declaration). The corpus ALSO declares those
// leaves, in more than one module (v2.std.text and v2.std.node String, std.integer and
// v2.std.integer Int), so the spelling arm cannot say which, and
// refusing would refuse every record with a String field. Which representation a kernel-spelled
// position denotes is the text-boundary question (DESIGN section 4, gunbc.rung_drop
// text_boundary_identity_wall), not one this index can answer; it reports the state and its readers
// take no bound from it.
// THIS ARM IS A DECLARED INTERIM STATE WITH ITS OWN TRIGGER, separate from the spelling arm's: it
// has no producer once resolve identifies a kernel-spelled reference -- as the kernel type, or as
// the corpus declaration the position's scope binds -- at every type position the emitter reads.
// That capability belongs to the text-boundary identity work, not to the emitter. Until then every
// occurrence is one census row (emitter_decl_route ...:KernelSpellingUndecided:<leaf>), and the one
// thing a reader does with it is the map-key marking of every declarer of the leaf, which is what
// the leaf-keyed set did.
type TypeDeclResolution
  = TypeDeclResolved { identity: String, decl: Node }
  | TypeDeclLeafAmbiguous { leaf: String }
  | TypeDeclKernelSpellingUndecided { leaf: String }
  | TypeDeclNotDeclared

fn empty_type_decl_index() -> TypeDeclIndex {
  TypeDeclIndex { by_identity: empty_map(), identity_by_declaring_span: empty_map(), leaf_owners: empty_map(), identities_by_leaf: empty_map(), qualified_names: empty_symbol_index() }
}

fn type_decl_identity(owner_module: String, decl_name: String) -> String {
  callable_identity(id: DeclaredCallableIdentity { owner_module_path: owner_module, decl_name: decl_name })
}

fn declaring_span_key(sp: SourceSpan) -> String {
  concat(sp.file, "@", to_string(sp.start))
}

fn type_decl_leaf_owner_after(prior: LeafOwner?, owner_module: String) -> LeafOwner {
  match prior {
    Present { value: SingleOwner { module: m } } => if m == owner_module { SingleOwner { module: m } } else { LeafAmbiguous }
    Present { value: LeafAmbiguous } => LeafAmbiguous
    Absent => SingleOwner { module: owner_module }
  }
}

fn type_decl_leaf_identities_with(prior: List<String>?, identity: String) -> List<String> {
  match prior {
    Present { value: identities } => if identities |> any(i => i == identity) { identities } else { list_push(identities, identity) }
    Absent => [identity]
  }
}

fn type_decl_identities_of_leaf(index: TypeDeclIndex, leaf: String) -> List<String> {
  match map_get(index.identities_by_leaf, leaf) {
    Present { value: identities } => identities
    Absent => []
  }
}

fn type_decl_index_insert(index: TypeDeclIndex, owner_module: String, decl_name: String, item: Node) -> TypeDeclIndex {
  let identity = type_decl_identity(owner_module: owner_module, decl_name: decl_name)
  TypeDeclIndex {
    by_identity: map_insert(index.by_identity, identity, item),
    identity_by_declaring_span: match item.ident_span {
      Present { value: sp } => map_insert(index.identity_by_declaring_span, declaring_span_key(sp: sp), identity)
      Absent => index.identity_by_declaring_span
    },
    leaf_owners: map_insert(index.leaf_owners, decl_name, type_decl_leaf_owner_after(prior: map_get(index.leaf_owners, decl_name), owner_module: owner_module)),
    identities_by_leaf: map_insert(index.identities_by_leaf, decl_name, type_decl_leaf_identities_with(prior: map_get(index.identities_by_leaf, decl_name), identity: identity)),
    qualified_names: index.qualified_names
  }
}

fn type_decl_resolution_at_identity(index: TypeDeclIndex, identity: String) -> TypeDeclResolution {
  match map_get(index.by_identity, identity) {
    Present { value: decl } => TypeDeclResolved { identity: identity, decl: decl }
    Absent => TypeDeclNotDeclared
  }
}

// THE SPELLING ARM, for a holder of a name and nothing else. One declarer resolves; two do not, and
// the answer says so rather than naming either.
fn resolve_type_decl_leaf(index: TypeDeclIndex, leaf: String) -> TypeDeclResolution {
  match map_get(index.leaf_owners, leaf) {
    Present { value: SingleOwner { module: m } } => type_decl_resolution_at_identity(index: index, identity: type_decl_identity(owner_module: m, decl_name: leaf))
    Present { value: LeafAmbiguous } => if is_kernel_type(name: leaf) { TypeDeclKernelSpellingUndecided { leaf: leaf } } else { TypeDeclLeafAmbiguous { leaf: leaf } }
    Absent => TypeDeclNotDeclared
  }
}

// REFERENCE -> DECLARATION, IN THE ORDER OF HOW MUCH THE NODE ITSELF SAYS. The identity resolve
// recorded on the reference (Node.declaration, written by v1.compiler.infer_resolve
// reference_with_declaration from the binding in the scope the reference was authored in) is the
// authority. The other two arms are INTERIM and exist because resolve does not yet stamp every type
// reference the emitter reads: the node being a declaration node itself, joined on its declaring
// span (the join v1.compiler.infer_env binding_declares_span makes), and then the spelling, which
// answers for a leaf one module declares and REFUSES for a leaf two declare. A reference to one of
// an item's own type parameters names a binder, not a declaration.
// THE INTERIM ARMS ARE COUNTED, NOT ASSUMED RARE: the route is a value, and
// v1.tests.claim.carrier_realization_census writes it per reference position (emitter_decl_route),
// so each resolution that falls past the carried identity is one located row.
type TypeDeclReferenceRoute
  = RouteCarriedDeclaration
  | RouteCarriedBinder
  | RouteDeclaringSpan
  | RouteReferencingModuleDeclarer
  | RouteQualifiedSpelling
  | RouteLeafSpelling

type TypeDeclRoutedResolution {
  route: TypeDeclReferenceRoute
  resolution: TypeDeclResolution
}

data type_decl_reference_interim_arms_dissolve_on: DissolutionCondition = unbound_dissolution(description: "RouteDeclaringSpan and RouteLeafSpelling dissolve when EVERY type reference the Rust emitter reads carries a declaration stamp: v1.tests.claim.carrier_realization_census reports emitter_decl_route carried_declaration or carried_binder at every position whose resolution is Resolved, over the self-host and dag closures, at identity grain. One stamped position, or one closure, is not that capability. Then resolve_type_decl_routed keeps its first arm, TypeDeclIndex drops identity_by_declaring_span and leaf_owners, and TypeDeclLeafAmbiguous has no producer.")

fn resolve_type_decl_routed(index: TypeDeclIndex, type_expr: Node, source_indices: Map<String, NewlineIndex>) -> TypeDeclRoutedResolution {
  match type_expr.declaration {
    Present { value: d } =>
      match d.field {
        WholeDeclaration => TypeDeclRoutedResolution { route: RouteCarriedDeclaration, resolution: type_decl_resolution_at_identity(index: index, identity: type_decl_identity(owner_module: d.module_path as String, decl_name: d.decl_name as String)) }
        NamedField { field_name: _ } => TypeDeclRoutedResolution { route: RouteCarriedBinder, resolution: TypeDeclNotDeclared }
        TypeParameter { name: _ } => TypeDeclRoutedResolution { route: RouteCarriedBinder, resolution: TypeDeclNotDeclared }
      }
    Absent =>
      let by_span = match type_expr.ident_span {
        Present { value: sp } => map_get(index.identity_by_declaring_span, declaring_span_key(sp: sp))
        Absent => none
      }
      match by_span {
        Present { value: identity } => TypeDeclRoutedResolution { route: RouteDeclaringSpan, resolution: type_decl_resolution_at_identity(index: index, identity: identity) }
        Absent =>
          let authored = authored_name_at(source_indices: source_indices, node: type_expr)
          let leaf = qualified_last_segment(name: authored)
          let by_spelling = resolve_type_decl_leaf(index: index, leaf: leaf)
          let referencing_module_identity = match by_spelling {
            TypeDeclLeafAmbiguous { leaf: l } => if authored == l { type_decl_referencing_module_declarer(index: index, leaf: l, reference: type_expr) } else { type_decl_qualifier_declarer(index: index, authored: authored) }
            TypeDeclResolved { identity: _, decl: _ } => none
            TypeDeclKernelSpellingUndecided { leaf: _ } => none
            TypeDeclNotDeclared => none
          }
          match referencing_module_identity {
            Present { value: identity } => TypeDeclRoutedResolution { route: if authored == leaf { RouteReferencingModuleDeclarer } else { RouteQualifiedSpelling }, resolution: type_decl_resolution_at_identity(index: index, identity: identity) }
            Absent => TypeDeclRoutedResolution { route: RouteLeafSpelling, resolution: by_spelling }
          }
      }
  }
}

// THE REFERENCING MODULE'S OWN DECLARATION. A leaf two modules declare is still decided when the
// reference is authored in a module that declares it: a module's own declaration is the binding its
// scope gives that name, since a module cannot also import a second declaration of a leaf it
// declares. That holds only for a BARE spelling: a qualified reference (other.module.Slot) names
// another module's declaration, so when it arrives unstamped it is never decided by the local one
// (resolve_type_decl_routed admits this arm only when the authored name equals its leaf); a
// qualified spelling is decided by type_decl_qualifier_declarer or refuses. The arm answers only when exactly one declarer of the leaf sits in the reference's file;
// otherwise the reference stays LeafAmbiguous and refuses. Counted under its own route label
// (referencing_module_declarer) in v1.tests.claim.carrier_realization_census emitter_decl_route.
// WHY THE STAMP DOES NOT REACH THESE. A bare reference resolves (v1.compiler.infer_resolve
// resolve_node, lookup_type_for) to the declaration's structure as the type environment holds it, and
// the environment's copy is built before resolve_item_types stamps the item's members, so the member
// references of a union body (v2.std.integer StandardIntegerType = Int128 | ...) arrive with no
// Node.declaration. Stamping them at the use site would bind them in the REFERENCING scope, the wrong
// one; they are owed a stamp in the DECLARING module's scope. Its trigger is
// referencing_module_declarer_route_dissolves_on.
// THE QUALIFIER'S DECLARER. A qualified spelling (std.materialization_ladder.Frame) names its declaring
// module in the reference itself, so an unstamped qualified reference is decided by the language's
// qualified-name authority and by nothing else: the corpus symbol index
// (v1.compiler.infer_env symbol_index_lookup, the lookup lookup_qualified_module_projection performs
// for every dotted reference resolve reads), joined to the declaration's identity on its declaring
// span exactly as RouteDeclaringSpan joins it. No module path is parsed here, so this arm cannot
// disagree with resolve about which declaration a qualified name denotes. A name the index does not
// hold (no.such.module.Slot) stays LeafAmbiguous and refuses. Counted as qualified_spelling; interim
// under referencing_module_declarer_route_dissolves_on.
fn type_decl_qualifier_declarer(index: TypeDeclIndex, authored: String) -> String? {
  match symbol_index_lookup(index: index.qualified_names, qualified_name: authored) {
    Present { value: decl } =>
      match decl.ident_span {
        Present { value: sp } => map_get(index.identity_by_declaring_span, declaring_span_key(sp: sp))
        Absent => none
      }
    Absent => none
  }
}

fn type_decl_index_with_qualified_names(index: TypeDeclIndex, qualified_names: SymbolIndex) -> TypeDeclIndex {
  TypeDeclIndex { by_identity: index.by_identity, identity_by_declaring_span: index.identity_by_declaring_span, leaf_owners: index.leaf_owners, identities_by_leaf: index.identities_by_leaf, qualified_names: qualified_names }
}

data referencing_module_declarer_route_dissolves_on: DissolutionCondition = unbound_dissolution(description: "RouteReferencingModuleDeclarer and RouteQualifiedSpelling dissolve when the type environment's declaration bodies carry Node.declaration on every member type reference, stamped by v1.compiler.infer_resolve reference_with_declaration in the DECLARING module's scope, so a bare reference resolved through lookup_type_for hands the emitter stamped members: v1.tests.claim.carrier_realization_census reports zero emitter_decl_route referencing_module_declarer or qualified_spelling rows over the self-host and dag closures. Stamping one declaration, or one closure, is not that capability. Then both arms, type_decl_referencing_module_declarer and type_decl_qualifier_declarer are deleted and such a reference refuses unless carried.")

fn type_decl_referencing_module_declarer(index: TypeDeclIndex, leaf: String, reference: Node) -> String? {
  let local = type_decl_identities_of_leaf(index: index, leaf: leaf) |> filter(identity =>
    match map_get(index.by_identity, identity) {
      Present { value: decl } => decl.span.file == reference.span.file
      Absent => false
    }
  )
  if (local |> fold(init: 0, f: (n, _identity) => n + 1)) == 1 { local |> fold(init: none, f: (acc, identity) => Present { value: identity }) } else { none }
}

fn resolve_type_decl_reference(index: TypeDeclIndex, type_expr: Node, source_indices: Map<String, NewlineIndex>) -> TypeDeclResolution {
  resolve_type_decl_routed(index: index, type_expr: type_expr, source_indices: source_indices).resolution
}

fn type_decl_routed_resolution_label(routed: TypeDeclRoutedResolution) -> String {
  let route = match routed.route {
    RouteCarriedDeclaration => "carried_declaration"
    RouteCarriedBinder => "carried_binder"
    RouteDeclaringSpan => "declaring_span"
    RouteReferencingModuleDeclarer => "referencing_module_declarer"
    RouteQualifiedSpelling => "qualified_spelling"
    RouteLeafSpelling => "leaf_spelling"
  }
  match routed.resolution {
    TypeDeclResolved { identity: identity, decl: _ } => concat(route, ":Resolved:", identity)
    TypeDeclLeafAmbiguous { leaf: leaf } => concat(route, ":LeafAmbiguous:", leaf)
    TypeDeclKernelSpellingUndecided { leaf: leaf } => concat(route, ":KernelSpellingUndecided:", leaf)
    TypeDeclNotDeclared => concat(route, ":NotDeclared")
  }
}

type EmitGraphInfo {
  type_summaries: TypeSummaryIndex
  type_decl_items: TypeDeclIndex
  data_variant_wire_spellings: Map<String, DataVariantWireSpelling>
  fn_decl_items: Map<String, Node>
  recursive_type_set: Set<String>
  fielded_variants: Set<String>
  positional_payload_variants: Set<String>

  shared_types: Set<String>
  ownership_index: Map<String, Set<String>>
  movable: Set<String>
  variant_to_enum: Map<String, String>
  owned_bindings: Set<String>

  read_only_params_index: Map<String, Set<String>>
  read_only_params: Set<String>

  clone_bounded_type_params: Map<String, Set<String>>
  map_key_required_type_names: Set<String>
  clone_impl_required_type_params: Map<String, Set<String>>

  fn_generic_param_names: List<String>
  fn_type_env: TypeEnv
  fn_return_type: Node?
  expected_type: Node?

  item_leaf_owner_modules: Map<String, LeafOwner>
}

type EmitInfoBuildState {
  type_summaries: TypeSummaryIndex
  type_decl_items: TypeDeclIndex
  fn_decl_items: Map<String, Node>
  structural_alias_fn_surface_names: Map<String, List<String>>
  structural_alias_direct_fn_names: Set<String>
}

fn empty_emit_graph_info() -> EmitGraphInfo {
  EmitGraphInfo {
    item_leaf_owner_modules: empty_map(),
    type_summaries: empty_type_summary_index(),
    type_decl_items: empty_type_decl_index(),
    data_variant_wire_spellings: empty_map(),
    fn_decl_items: empty_map(),
    recursive_type_set: empty_set(),
    fielded_variants: empty_set(),
    positional_payload_variants: empty_set(),
    shared_types: empty_set(),
    ownership_index: empty_map(),
    movable: empty_set(),
    variant_to_enum: empty_map(),
    owned_bindings: empty_set(),
    read_only_params_index: empty_map(),
    read_only_params: empty_set(),
    clone_bounded_type_params: empty_map(),
    map_key_required_type_names: empty_set(),
    clone_impl_required_type_params: empty_map(),

    fn_generic_param_names: [],
    fn_type_env: empty_type_env(),
    fn_return_type: none,
    expected_type: none
  }
}

fn emit_info_with_fn_type_context(emit_info: EmitGraphInfo, generic_param_names: List<String>, env: TypeEnv) -> EmitGraphInfo {
  EmitGraphInfo {
    item_leaf_owner_modules: emit_info.item_leaf_owner_modules,
    type_summaries: emit_info.type_summaries,
    type_decl_items: emit_info.type_decl_items,
    data_variant_wire_spellings: emit_info.data_variant_wire_spellings,
    fn_decl_items: emit_info.fn_decl_items,
    recursive_type_set: emit_info.recursive_type_set,
    fielded_variants: emit_info.fielded_variants,
    positional_payload_variants: emit_info.positional_payload_variants,
    shared_types: emit_info.shared_types,
    ownership_index: emit_info.ownership_index,
    movable: emit_info.movable,
    variant_to_enum: emit_info.variant_to_enum,
    owned_bindings: emit_info.owned_bindings,
    read_only_params_index: emit_info.read_only_params_index,
    read_only_params: emit_info.read_only_params,
    clone_bounded_type_params: emit_info.clone_bounded_type_params,
    map_key_required_type_names: emit_info.map_key_required_type_names,
    clone_impl_required_type_params: emit_info.clone_impl_required_type_params,
    fn_generic_param_names: generic_param_names,
    fn_type_env: env,
    fn_return_type: emit_info.fn_return_type,
    expected_type: emit_info.expected_type
  }
}

fn emit_info_with_fn_return(emit_info: EmitGraphInfo, fn_return_type: Node?) -> EmitGraphInfo {
  EmitGraphInfo {
    item_leaf_owner_modules: emit_info.item_leaf_owner_modules,
    type_summaries: emit_info.type_summaries,
    type_decl_items: emit_info.type_decl_items,
    data_variant_wire_spellings: emit_info.data_variant_wire_spellings,
    fn_decl_items: emit_info.fn_decl_items,
    recursive_type_set: emit_info.recursive_type_set,
    fielded_variants: emit_info.fielded_variants,
    positional_payload_variants: emit_info.positional_payload_variants,
    shared_types: emit_info.shared_types,
    ownership_index: emit_info.ownership_index,
    movable: emit_info.movable,
    variant_to_enum: emit_info.variant_to_enum,
    owned_bindings: emit_info.owned_bindings,
    read_only_params_index: emit_info.read_only_params_index,
    read_only_params: emit_info.read_only_params,
    clone_bounded_type_params: emit_info.clone_bounded_type_params,
    map_key_required_type_names: emit_info.map_key_required_type_names,
    clone_impl_required_type_params: emit_info.clone_impl_required_type_params,
    fn_generic_param_names: emit_info.fn_generic_param_names,
    fn_type_env: emit_info.fn_type_env,
    fn_return_type: fn_return_type,
    expected_type: fn_return_type
  }
}

// The type the expression being emitted must inhabit, at EXPRESSION grain. A fn body's tail
// inhabits the declared return (emit_info_with_fn_return seeds it); a record-literal field value
// inhabits the field's declared type, a narrower fact the return type cannot stand in for -- a
// `Violates` literal at a `Witness<Node>` field took its type argument from the fn return
// (`Witness<Rc<RuntimeValueAcceptanceWitness>>`, E0308 x5 at v2.compiler.eval / v2.compiler.compile).
fn emit_info_with_expected_type(emit_info: EmitGraphInfo, expected_type: Node?) -> EmitGraphInfo {
  EmitGraphInfo {
    item_leaf_owner_modules: emit_info.item_leaf_owner_modules,
    type_summaries: emit_info.type_summaries,
    type_decl_items: emit_info.type_decl_items,
    data_variant_wire_spellings: emit_info.data_variant_wire_spellings,
    fn_decl_items: emit_info.fn_decl_items,
    recursive_type_set: emit_info.recursive_type_set,
    fielded_variants: emit_info.fielded_variants,
    positional_payload_variants: emit_info.positional_payload_variants,
    shared_types: emit_info.shared_types,
    ownership_index: emit_info.ownership_index,
    movable: emit_info.movable,
    variant_to_enum: emit_info.variant_to_enum,
    owned_bindings: emit_info.owned_bindings,
    read_only_params_index: emit_info.read_only_params_index,
    read_only_params: emit_info.read_only_params,
    clone_bounded_type_params: emit_info.clone_bounded_type_params,
    map_key_required_type_names: emit_info.map_key_required_type_names,
    clone_impl_required_type_params: emit_info.clone_impl_required_type_params,
    fn_generic_param_names: emit_info.fn_generic_param_names,
    fn_type_env: emit_info.fn_type_env,
    fn_return_type: emit_info.fn_return_type,
    expected_type: expected_type
  }
}

fn variant_has_fields(emit_info: EmitGraphInfo, enum_name: String, variant_name: String) -> Bool {
  let key = concat(enum_name, "::", variant_name)
  set_contains(emit_info.fielded_variants, key)
}

fn variant_summary_key(enum_name: String, variant_name: String) -> String {
  concat(enum_name, "::", variant_name)
}

fn lookup_emit_type_summary(emit_info: EmitGraphInfo, type_name: String) -> TypeSummaryLookup {
  type_summary_lookup(index: emit_info.type_summaries, key: type_name)
}

// A YES/NO QUESTION ABOUT A NAME TWO DECLARATIONS OWN is still decided when every declaration gives
// the same answer: nothing is chosen, so nothing is guessed. Only disagreement is undecided, and it
// answers Absent; the Bool readers below then answer false, which emits nothing from the name (the
// variant-parent readers refuse an unresolved parent, v1.compiler.emit_rust
// refuse_unresolved_bare_variant_pattern).
fn type_summary_answer(index: TypeSummaryIndex, key: String, question: (TypeSummary) -> Bool) -> Bool? {
  match type_summary_lookup(index: index, key: key) {
    TypeSummaryFound { summary: summary } => Present { value: question(summary) }
    TypeSummaryNotDeclared => none
    TypeSummaryLeafAmbiguous { leaf: leaf } =>
      let answers = type_summary_keys_of_leaf(index: index, leaf: leaf) |> fold(init: [], f: (acc, k) =>
        match map_get(index.by_key, k) {
          Present { value: summary } => list_push(acc, question(summary))
          Absent => acc
        }
      )
      if answers |> all(a => a) { Present { value: true } }
      else if answers |> all(a => !a) { Present { value: false } }
      else { none }
  }
}

fn type_summary_answer_or_false(index: TypeSummaryIndex, key: String, question: (TypeSummary) -> Bool) -> Bool {
  match type_summary_answer(index: index, key: key, question: question) {
    Present { value: v } => v
    Absent => false
  }
}

fn emit_graph_records_type_decl(item: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  match build_type_summary(item: item, source_indices: source_indices) {
    Present { value: _ } => true
    Absent =>
      item.module_item_kind == ModuleItemTypeDeclaration
        && item.connective == NoConnective
        && (item.children |> count) == 0
        && (item.params |> count) == 0
  }
}

// THE DUPLICATE PREDICATE IS GONE. What stood here duplicated v1.compiler.emit_core_support's
// is_function_item -- `body != none && type_annotation == none` -- and argued the duplication was
// layering: this module is upstream of emit_core_support in the DAG, and both predicates answered
// "what item shape reaches this stage's fold". The argument was sound and the fact it forked was
// the wrong fact. An item's kind is not a per-stage question at all: v1.std.core Node now carries
// module_item_kind, stamped by the parse constructor, so both stages read ONE authority that is
// upstream of both and neither re-derives a shape.
fn emit_graph_records_fn_decl(item: Node) -> Bool {
  item.module_item_kind == ModuleItemFunction
}

// variant leaf -> the KEY of the enum that declares it, or "" when two enums declare that variant.
// The value is the owner's identity, not its leaf: two same-leaf enums own different variants, and a
// leaf value would send every reader back through the ambiguous spelling.
fn derive_variant_to_enum(type_summaries: TypeSummaryIndex) -> Map<String, String> {
  type_summary_values(index: type_summaries) |> fold(init: empty_map(), f: (acc, summary) =>
    match summary.repr {
      EnumRepr { unit_only: _ } =>
        fold(map_keys(summary.variant_name_set), init: acc, f: (inner, vn) =>
          match map_get(inner, vn) {
            Present { value: _ } => map_insert(inner, vn, "")
            Absent => map_insert(inner, vn, summary.key)
          }
        )
      _ => acc
    }
  )
}

fn is_known_variant(type_summaries: TypeSummaryIndex, name: String) -> Bool {
  type_summary_values(index: type_summaries) |> any(summary =>
    match summary.repr {
      EnumRepr { unit_only: _ } => emit_map_has(m: summary.variant_name_set, key: name)
      _ => false
    }
  )
}

fn summary_is_enum_with_variant(summary: TypeSummary, variant_name: String) -> Bool {
  match summary.repr {
    EnumRepr { unit_only: _ } => emit_map_has(m: summary.variant_name_set, key: variant_name)
    _ => false
  }
}

fn summary_is_enum(summary: TypeSummary) -> Bool {
  match summary.repr {
    EnumRepr { unit_only: _ } => true
    _ => false
  }
}

fn variant_belongs_to_enum(type_summaries: TypeSummaryIndex, variant_name: String, enum_name: String) -> Bool {
  type_summary_answer_or_false(index: type_summaries, key: enum_name, question: (summary) => summary_is_enum_with_variant(summary: summary, variant_name: variant_name))
}

fn is_enum_in_summaries(type_summaries: TypeSummaryIndex, type_name: String) -> Bool {
  type_summary_answer_or_false(index: type_summaries, key: type_name, question: (summary) => summary_is_enum(summary: summary))
}

fn find_variant_parent(type_summaries: TypeSummaryIndex, variant_name: String, scope_enums: List<String>) -> String? {
  scope_enums |> filter(en =>
    variant_belongs_to_enum(type_summaries: type_summaries, variant_name: variant_name, enum_name: en)
  ) |> first
}

fn field_value_shape_from_type_node(type_node: Node) -> FieldValueShape {
  let normed = normalize_access_type_node(n: type_node)
  let is_optional = normed.return_cardinality == CardOptional
  if is_optional { OptionalValue }
  else { PlainValue }
}

fn is_tuple_type(n: Node) -> Bool {
  n.connective == Conj && n.ident_span == none && n.children |> count == 2
}

fn build_struct_field_summaries(parent: Node, source_indices: Map<String, NewlineIndex>) -> Map<String, FieldSummary> {
  let is_pair = is_tuple_type(n: parent)
  fold(parent.children |> enumerate, init: empty_map(), f: (acc, pair) =>
    let idx = pair.first
    let child = pair.second
    if child.inferred == none {
      acc
    } else {
      let style = if is_pair { if idx == 0 { TupleFirst } else { TupleSecond } } else { StoredField }
      let key = authored_name_at(source_indices: source_indices, node: child)
      map_insert(acc, key, FieldSummary {
        access_style: style,
        value_shape: field_value_shape_from_type_node(type_node: child_type_node(ch: child))
      })
    }
  )
}

fn find_first_enum_field_node(variants: List<Node>, field_name: String, source_indices: Map<String, NewlineIndex>) -> Node? {
  match variants |> first {
    Present { value: variant } =>
      match find_child_named(n: variant, name: field_name, source_indices: source_indices) {
        Present { value: field_child } => Present { value: field_child }
        Absent => none
      }
    Absent => none
  }
}

fn enum_field_present_in_all_variants(variants: List<Node>, field_name: String, source_indices: Map<String, NewlineIndex>) -> Bool {
  variants |> all(variant =>
    has_child_named(n: variant, name: field_name, source_indices: source_indices)
  )
}

fn enum_field_type_consistent(variants: List<Node>, field_name: String, expected: Node, source_indices: Map<String, NewlineIndex>) -> Bool {
  variants |> all(variant =>
    match find_child_named(n: variant, name: field_name, source_indices: source_indices) {
      Present { value: field_child } => node_type_equals(left: child_type_node(ch:field_child), right: expected, source_indices: source_indices, text: TextNotAsked { reason: TextNotAskedInVariantFieldSummary })
      Absent => false
    }
  )
}

fn build_enum_field_summaries(variants: List<Node>, source_indices: Map<String, NewlineIndex>) -> Map<String, FieldSummary> {
  let first_field_names = match variants |> first {
    Present { value: first_variant } => first_variant.children |> map(f => authored_name_at(source_indices: source_indices, node: f))
    Absent => []
  }
  let shared = first_field_names |> filter(field_name =>
    enum_field_present_in_all_variants(variants: variants, field_name: field_name, source_indices: source_indices)
  )
  let consistent = shared |> filter(field_name =>
    match find_first_enum_field_node(variants: variants, field_name: field_name, source_indices: source_indices) {
      Present { value: first_field } =>
        enum_field_type_consistent(variants: variants, field_name: field_name, expected: child_type_node(ch:first_field), source_indices: source_indices)
      Absent => false
    }
  )
  fold(consistent, init: empty_map(), f: (acc, field_name) =>
    match find_first_enum_field_node(variants: variants, field_name: field_name, source_indices: source_indices) {
      Present { value: first_field } =>
        map_insert(acc, field_name, FieldSummary {
          access_style: EnumAccessor,
          value_shape: field_value_shape_from_type_node(type_node: child_type_node(ch:first_field))
        })
      Absent => acc
    }
  )
}

fn build_field_type_map(children: List<Node>, source_indices: Map<String, NewlineIndex>) -> FieldTypeMapBuild {
  fold(children, init: FieldTypeMapBuild { field_types: empty_map(), import_surface_names: [] }, f: (acc, child) =>
    match child.inferred {
      Present { value: Resolved { node: ft } } =>
        let resolved_name = authored_name_at(source_indices: source_indices, node: normalize_access_type_node(n: ft))
        let ft_is_type_var = if ft.inferred != none { is_type_variable(inferred: ft.inferred.value) } else { false }
        let key = authored_name_at(source_indices: source_indices, node: child)
        let surface_names = collect_type_node_import_surface_names(n: ft, source_indices: source_indices)
        let next_field_types = if resolved_name != "" && !ft_is_type_var && resolved_name != "Dynamic" {
          map_insert(acc.field_types, key, resolved_name)
        } else { acc.field_types }
        FieldTypeMapBuild {
          field_types: next_field_types,
          import_surface_names: dedupe_nonempty_strings(items: concat(acc.import_surface_names, surface_names))
        }
      _ => acc
    }
  )
}

fn build_type_summary(item: Node, source_indices: Map<String, NewlineIndex>) -> TypeSummary? {
  if item.connective == NoConnective || item.connective == Arrow || item.transport != none {
    return none
  }
  let gpn = item.params |> map(p => param_node_name_at(n: p, source_indices: source_indices))
  let is_product = item.connective == Conj
  let has_fn = item.children |> any(child =>
    match child.inferred {
      Present { value: Resolved { node: rt } } => rt.connective == Arrow
      _ => false
    }
  )
  if is_product {
    let field_types = build_field_type_map(children: item.children, source_indices: source_indices)
    Present { value: TypeSummary {
      name: authored_name_at(source_indices: source_indices, node: item),
      key: "",
      repr: StructRepr,
      field_summaries: build_struct_field_summaries(parent: item, source_indices: source_indices),
      field_type_map: field_types.field_types,
      field_import_surface_names: field_types.import_surface_names,
      variant_name_set: empty_map(),
      generic_param_names: gpn,
      has_fn_fields: has_fn
    } }
  } else {
    let unit_only = item.children |> all(child => child.children |> count == 0)
    Present { value: TypeSummary {
      name: authored_name_at(source_indices: source_indices, node: item),
      key: "",
      repr: EnumRepr { unit_only: unit_only },
      field_summaries: build_enum_field_summaries(variants: item.children, source_indices: source_indices),
      field_type_map: empty_map(),
      field_import_surface_names: enum_variant_payload_surface_names(variants: item.children, source_indices: source_indices),
      variant_name_set: fold(item.children, init: empty_map(), f: (acc, child) => map_insert(acc, authored_name_at(source_indices: source_indices, node: child), true)),
      generic_param_names: gpn,
      has_fn_fields: has_fn || enum_variant_payload_has_fn(variants: item.children)
    } }
  }
}

// A coproduct's payload fields are reachable values exactly as a product's fields are, so the
// fn-reachability walk needs the same edges from an enum that it gets from a struct. Before this,
// build_type_summary gave every non-product an empty field_type_map AND an empty
// field_import_surface_names, which made an enum a dead end in both directions: an enum whose
// variant payload reached a function value derived serde itself, and it blocked propagation to
// anything holding it. Measured on a specimen: `ViaEnum = HasInner { held: Inner } | Empty` with
// `Inner { apply: fn(Int) -> Int }` emitted Serialize/Deserialize on ViaEnum and on its holder,
// while the direct-field control `NestedDirect { inner: Inner }` correctly emitted Clone alone.
fn enum_variant_payload_surface_names(variants: List<Node>, source_indices: Map<String, NewlineIndex>) -> List<String> {
  dedupe_nonempty_strings(items: variants |> flat_map(v =>
    let built = build_field_type_map(children: v.children, source_indices: source_indices)
    built.import_surface_names
  ))
}

// The direct arm of the same gap: a variant payload whose own resolved type IS an arrow. A
// function type has no authored name, so the surface-name walk above cannot see it and this is a
// separate question rather than a special case of it.
fn enum_variant_payload_has_fn(variants: List<Node>) -> Bool {
  variants |> any(v => v.children |> any(child =>
    match child.inferred {
      Present { value: Resolved { node: rt } } => rt.connective == Arrow
      _ => false
    }
  ))
}

// WHICH NAMES REACH A FUNCTION-TYPED FIELD, ANSWERED ONCE FOR THE WHOLE SUMMARY MAP.
//
// A name holds DIRECTLY when it is a summary with its own fn field, or, when it is no summary at
// all, a structural alias the builder recorded as naming an arrow. It REACHES when it holds
// directly or one of its targets reaches: a summary's targets are its field types and import
// surface names, an alias's are its recorded surface names. That is plain reachability to a
// direct holder, so it is a least fixpoint over one set, and each round is a fold over the
// candidates that adds every name with a target already in the set.
//
// THE PREVIOUS ANSWER WAS ONE DEPTH-FIRST SEARCH PER SUMMARY, FROM A FRESH `visited`, and the set
// was PATH-LOCAL: sibling branches never saw what the other had already explored. A summary that
// reaches no fn -- the common case -- therefore walked its whole reachable type graph, once per
// path to each node, and that walk ran once per summary. build_emit_graph_info calls this on every
// resolve and every emit, so the cost landed in every reconcile the floor prepares. The rounds
// here are bounded by how deep type nesting goes, not by how many types exist.
type FnReachRound {
  reached: Set<String>
  grew: Bool
}

// The walk is over summary KEYS. A field names its type by spelling, so a target resolves to the
// key it names exactly, or to EVERY declarer of that leaf: reachability is then an over-approximation
// computed as the answer (a type reaching a function value through either same-leaf declaration is
// marked), and the spelling itself is kept for the structural aliases, which this index does not hold.
fn fn_reach_target_keys(index: TypeSummaryIndex, target: String) -> List<String> {
  match map_get(index.by_key, target) {
    Present { value: _ } => [target]
    Absent => concat(type_summary_keys_of_leaf(index: index, leaf: target), [target])
  }
}

fn fn_reach_holds_directly(name: String, summaries: TypeSummaryIndex, structural_alias_direct_fn_names: Set<String>) -> Bool {
  match map_get(summaries.by_key, name) {
    Present { value: s } => s.has_fn_fields
    Absent => set_contains(structural_alias_direct_fn_names, name)
  }
}

fn fn_reach_targets(name: String, summaries: TypeSummaryIndex, structural_alias_fn_surface_names: Map<String, List<String>>) -> List<String> {
  let spelled = match map_get(summaries.by_key, name) {
    Present { value: s } => concat(map_values(s.field_type_map), s.field_import_surface_names)
    Absent =>
      match map_get(structural_alias_fn_surface_names, name) {
        Present { value: targets } => targets
        Absent => []
      }
  }
  spelled |> fold(init: [], f: (acc, t) => concat(acc, fn_reach_target_keys(index: summaries, target: t)))
}

fn fn_reaching_names_fixpoint(candidates: List<String>, summaries: TypeSummaryIndex, structural_alias_fn_surface_names: Map<String, List<String>>, structural_alias_direct_fn_names: Set<String>, reached: Set<String>) -> Set<String> {
  let round = fold(candidates, init: FnReachRound { reached: reached, grew: false }, f: (acc, name) =>
    if set_contains(acc.reached, name) { acc }
    else if fn_reach_holds_directly(name: name, summaries: summaries, structural_alias_direct_fn_names: structural_alias_direct_fn_names)
      || (fn_reach_targets(name: name, summaries: summaries, structural_alias_fn_surface_names: structural_alias_fn_surface_names)
        |> any(target => set_contains(acc.reached, target) || fn_reach_holds_directly(name: target, summaries: summaries, structural_alias_direct_fn_names: structural_alias_direct_fn_names))) {
      FnReachRound { reached: set_insert(acc.reached, name), grew: true }
    } else { acc }
  )
  if round.grew {
    fn_reaching_names_fixpoint(candidates: candidates, summaries: summaries, structural_alias_fn_surface_names: structural_alias_fn_surface_names, structural_alias_direct_fn_names: structural_alias_direct_fn_names, reached: round.reached)
  } else { round.reached }
}

fn fn_reaching_names(summaries: TypeSummaryIndex, structural_alias_fn_surface_names: Map<String, List<String>>, structural_alias_direct_fn_names: Set<String>) -> Set<String> {
  fn_reaching_names_fixpoint(
    candidates: concat(map_keys(summaries.by_key), map_keys(structural_alias_fn_surface_names)),
    summaries: summaries,
    structural_alias_fn_surface_names: structural_alias_fn_surface_names,
    structural_alias_direct_fn_names: structural_alias_direct_fn_names,
    reached: empty_set()
  )
}

fn close_fn_fields(summaries: TypeSummaryIndex, structural_alias_fn_surface_names: Map<String, List<String>>, structural_alias_direct_fn_names: Set<String>) -> TypeSummaryIndex {
  let reaching = fn_reaching_names(summaries: summaries, structural_alias_fn_surface_names: structural_alias_fn_surface_names, structural_alias_direct_fn_names: structural_alias_direct_fn_names)
  TypeSummaryIndex {
    by_key: fold(map_keys(summaries.by_key), init: summaries.by_key, f: (acc, key) =>
      match map_get(summaries.by_key, key) {
        Present { value: s } =>
          if !s.has_fn_fields && set_contains(reaching, key) {
            map_insert(acc, key, TypeSummary {
              name: s.name,
              key: s.key,
              repr: s.repr,
              field_summaries: s.field_summaries,
              field_type_map: s.field_type_map,
              field_import_surface_names: s.field_import_surface_names,
              variant_name_set: s.variant_name_set,
              generic_param_names: s.generic_param_names,
              has_fn_fields: true
            })
          } else { acc }
        Absent => acc
      }
    ),
    keys_by_leaf: summaries.keys_by_leaf
  }
}

fn structural_alias_direct_fn_names_with(names: Set<String>, name: String, include: Bool) -> Set<String> {
  if include { set_insert(names, name) } else { names }
}

fn add_emit_item_summary(state: EmitInfoBuildState, module_name: String, item: Node, source_indices: Map<String, NewlineIndex>) -> EmitInfoBuildState {
  let decl_name = authored_name_at(source_indices: source_indices, node: item)
  let alias_rhs = resolved_type(n: item)
  let alias_rhs_name = authored_name_at(source_indices: source_indices, node: alias_rhs)
  let is_type_alias = decl_name != "" && item.connective == NoConnective && item.body == none && (item.params |> count) == 0 && item.transport == none && (item.children |> count) == 0 && alias_rhs_name != "Unit"
  let is_structural_alias = if is_type_alias {
    match realized_checkpoint(decision: declaration_realization(item: item, dag_name: decl_name, target: Rust)) {
      Present { value: _ } => false
      Absent => true
    }
  } else { false }
  let structural_alias_fn_surface_names = if is_structural_alias {
    map_insert(state.structural_alias_fn_surface_names, decl_name, collect_type_node_import_surface_names(n: alias_rhs, source_indices: source_indices))
  } else { state.structural_alias_fn_surface_names }
  let prior_direct_fn_names = state.structural_alias_direct_fn_names
  let structural_alias_direct_fn_names = structural_alias_direct_fn_names_with(names: prior_direct_fn_names, name: decl_name, include: is_structural_alias && alias_rhs.connective == Arrow)
  let state = if decl_name != "" && emit_graph_records_type_decl(item: item, source_indices: source_indices) {
    EmitInfoBuildState {
      type_summaries: state.type_summaries,
      type_decl_items: type_decl_index_insert(index: state.type_decl_items, owner_module: module_name, decl_name: decl_name, item: item),
      fn_decl_items: state.fn_decl_items,
      structural_alias_fn_surface_names: structural_alias_fn_surface_names,
      structural_alias_direct_fn_names: structural_alias_direct_fn_names
    }
  } else {
    state
  }
  let state = if decl_name != "" && emit_graph_records_fn_decl(item: item) {
    EmitInfoBuildState {
      type_summaries: state.type_summaries,
      type_decl_items: state.type_decl_items,
      fn_decl_items: map_insert(state.fn_decl_items, decl_name, item),
      structural_alias_fn_surface_names: state.structural_alias_fn_surface_names,
      structural_alias_direct_fn_names: state.structural_alias_direct_fn_names
    }
  } else {
    state
  }
  match build_type_summary(item: item, source_indices: source_indices) {
    Present { value: built } =>
      let key = type_decl_identity(owner_module: module_name, decl_name: built.name)
      let summary = type_summary_with_key(summary: built, key: key)
      let with_variants = match summary.repr {
        EnumRepr { unit_only: _ } =>
          fold(item.children, init: state.type_summaries, f: (acc, variant) =>
            if variant.children |> count > 0 {
              let v_has_fn = variant.children |> any(vc =>
                match vc.inferred {
                  Present { value: Resolved { node: rt } } => rt.connective == Arrow
                  _ => false
                }
              )
              let vname = authored_name_at(source_indices: source_indices, node: variant)
              let qualified_vname = variant_summary_key(enum_name: summary.name, variant_name: vname)
              let variant_key = variant_summary_key(enum_name: key, variant_name: vname)
              let variant_field_types = build_field_type_map(children: variant.children, source_indices: source_indices)
              type_summary_index_insert(index: acc, key: variant_key, leaf: qualified_vname, summary: TypeSummary {
                name: qualified_vname,
                key: variant_key,
                repr: StructRepr,
                field_summaries: build_struct_field_summaries(parent: variant, source_indices: source_indices),
                field_type_map: variant_field_types.field_types,
                field_import_surface_names: variant_field_types.import_surface_names,
                variant_name_set: empty_map(),
                generic_param_names: [],
                has_fn_fields: v_has_fn
              })
            } else { acc }
          )
        _ => state.type_summaries
      }
      let next_summaries = type_summary_index_insert(index: with_variants, key: key, leaf: summary.name, summary: summary)
      EmitInfoBuildState {
        type_summaries: next_summaries,
        type_decl_items: state.type_decl_items,
        fn_decl_items: state.fn_decl_items,
        structural_alias_fn_surface_names: state.structural_alias_fn_surface_names,
        structural_alias_direct_fn_names: state.structural_alias_direct_fn_names
      }
    Absent => state
  }
}

fn type_summary_with_key(summary: TypeSummary, key: String) -> TypeSummary {
  TypeSummary {
    name: summary.name,
    key: key,
    repr: summary.repr,
    field_summaries: summary.field_summaries,
    field_type_map: summary.field_type_map,
    field_import_surface_names: summary.field_import_surface_names,
    variant_name_set: summary.variant_name_set,
    generic_param_names: summary.generic_param_names,
    has_fn_fields: summary.has_fn_fields
  }
}

data emit_dependency_registration_dissolve_on_note: DissolutionCondition = unbound_dissolution(description: "dissolve-on (FreeMonoid pass 2026-07-20): collect emitted cross-module type/path refs during emit into one authority; derive (a) use-lines via build_shared_types + reference_derived_use_line_plan and (b) closure pub-mod membership via emit_lib_rs_from_paths from that set. Instance-patch interim: closure projections (v1.compiler.closure_stub_v2_std_text_rust and closure_stub_v2_std_integer_rust) when refs exist but the real v2.std.text or v2.std.integer module is absent from narrow typed.modules — projections are NOT parallel modeling authorities (see each stub module dissolve_on_note); they dissolve when the ref set includes the real module in the closure.")
