module v1.compiler.type_head_exposure

// This vocabulary belongs to the compiler judgment, not std: it describes how far this
// compiler exposed an expected type before selecting an introduction or compatibility rule.
// ApplicationHead is only the early structural category, before SymbolIndex
// construction. Identity-sensitive judgments later consume declaration-bound
// TypeApplication. All exposure consumers ask only the category; neither the
// former identity Strings nor an authored-Node payload is needed here.
type TypeHeadView
  = KernelScalarHead { type_identity: String }
  | ApplicationHead
  | ProductHead { type_identity: String }
  | CoproductHead { type_identity: String }
  | CallableHead { type_identity: String }

type TypeHeadExposure
  = ExposedTypeHead { view: TypeHeadView }
  | OpaqueTypeHead { type_identity: String }
  | StuckTypeHead { cause: String }
  | MalformedApplicationHead { cause: String }

fn type_declaration_identity_key(decl_file: String, declared_name: String) -> String {
  concat(decl_file, "::", declared_name)
}

fn type_head_exposure_is_kernel_scalar(exposure: TypeHeadExposure) -> Bool {
  match exposure {
    ExposedTypeHead { view: KernelScalarHead { type_identity: _ } } => true
    _ => false
  }
}

fn type_head_exposure_is_product(exposure: TypeHeadExposure) -> Bool {
  match exposure {
    ExposedTypeHead { view: ProductHead { type_identity: _ } } => true
    _ => false
  }
}

fn type_head_exposure_is_coproduct(exposure: TypeHeadExposure) -> Bool {
  match exposure {
    ExposedTypeHead { view: CoproductHead { type_identity: _ } } => true
    _ => false
  }
}
