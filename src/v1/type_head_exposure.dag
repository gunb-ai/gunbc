module v1.compiler.type_head_exposure

// This vocabulary belongs to the compiler judgment, not std: it describes how far this
// compiler exposed an expected type before selecting an introduction or compatibility rule.
// Exposure never means "choose an application argument". The outer constructor and every
// argument identity remain present in ApplicationHead.
type TypeHeadView
  = KernelScalarHead { type_identity: String }
  | ApplicationHead {
      constructor_identity: String,
      argument_identities: List<String>
    }
  | ProductHead { type_identity: String }
  | CoproductHead { type_identity: String }
  | CallableHead { type_identity: String }

type TypeHeadExposure
  = ExposedTypeHead { view: TypeHeadView }
  | OpaqueTypeHead { type_identity: String }
  | StuckTypeHead { cause: String }
  | MalformedApplicationHead { cause: String }

fn type_declaration_identity_key(decl_file: String, declared_name: String) -> String {
  concat(decl_file, "::", declared_name)
}
