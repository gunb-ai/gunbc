module v1.compiler.type_head_exposure

// This vocabulary belongs to the compiler judgment, not std: it describes how far this
// compiler exposed an expected type before selecting an introduction or compatibility rule.
// Exposure never means "choose an application argument".  The outer constructor and the
// constructor-owned relations remain present in ApplicationHead.
type TypeParameterRelation
  = NominalParameterRelation
  | RepresentationalParameterRelation

type TypeHeadView
  = KernelScalarHead { type_identity: String }
  | ApplicationHead {
      constructor_identity: String,
      argument_identities: List<String>,
      parameter_relations: List<TypeParameterRelation>
    }
  | ProductHead { type_identity: String }
  | CoproductHead { type_identity: String }
  | CallableHead { type_identity: String }

type TypeHeadExposure
  = ExposedTypeHead { view: TypeHeadView }
  | OpaqueTypeHead { type_identity: String }
  | StuckTypeHead { cause: String }
  | CyclicTypeHead { path: List<String> }
  | MalformedApplicationHead { cause: String }

type IntegerNumeralIntroductionRow {
  type_identity: String
}

data type_head_exposure_model_note: String = "Type-head exposure is a bounded, declaration-identity-keyed compiler judgment. It exposes only through TransparentAlias, stops at opaque/abstract/refinement/brand/sole-constructor boundaries, and preserves an application as its outer constructor plus arguments under relations owned by that constructor. Stuck is strategy-not-applicable (including lookup Absent); MalformedApplication is an invalid input. Consumers must never collapse those arms or map either one to compatible. Integer numeral introduction is separate from coercion and target realization: zero/one/add fields on CommutativeSemiring are deliberately NOT read as an OfNat capability, because that would fabricate syntax permission for every semiring from coincidental structure."

fn type_declaration_identity_key(decl_file: String, declared_name: String) -> String {
  concat(decl_file, "::", declared_name)
}

fn integer_numeral_introduction_rows() -> List<IntegerNumeralIntroductionRow> {
  [
    IntegerNumeralIntroductionRow {
      type_identity: type_declaration_identity_key(decl_file: "<kernel:Int>", declared_name: "Int")
    },
    IntegerNumeralIntroductionRow {
      type_identity: type_declaration_identity_key(decl_file: "dag/std/nat.dag", declared_name: "Nat")
    },
    IntegerNumeralIntroductionRow {
      type_identity: type_declaration_identity_key(decl_file: "dag/std/integer.dag", declared_name: "Int")
    }
  ]
}

fn admits_integer_numeral(type_identity: String) -> Bool {
  integer_numeral_introduction_rows()
    |> any(row => row.type_identity == type_identity)
}
