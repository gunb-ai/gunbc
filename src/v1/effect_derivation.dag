module v1.compiler.effect_derivation








fn re_export_derive_op_effect(
  operation_name: String,
  method: std.types.HttpMethod,
  path: std.http_path.PathTemplate
) -> std.effects.DeriveOpEffectResult {
  std.effects.derive_op_effect(
    operation_name: operation_name,
    method: method,
    path: path
  )
}

fn re_export_check_modifier(
  op: std.effects.DerivedOpEffect,
  declared_idempotent: Bool,
  declared_readonly: Bool
) -> std.effects.ModifierCheck {
  std.effects.check_modifier_vs_derivation(
    op: op,
    declared_idempotent: declared_idempotent,
    declared_readonly: declared_readonly
  )
}

fn re_export_parse_path_template(raw: String) -> extdeps.uri_path.PathTemplateParseResult {
  extdeps.uri_path.parse_path_template(raw: raw)
}

fn re_export_has_path_params(template: std.http_path.PathTemplate) -> Bool {
  std.http_path.has_path_params(template: template)
}
