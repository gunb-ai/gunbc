module v1.compiler.tokenize







fn is_keyword_text(text: String) -> Bool {
  match lookup(extdeps.languages.dag.syntax.dag_keyword_set, key: text) {
    Present { value: _ } => true
    Absent => false
  }
}

data single_punct: Map<String, v1.std.core.TokenShape> = {
  "(": ShLParen, ")": ShRParen,
  "[": ShLBracket, "]": ShRBracket,
  ":": ShColon, ",": ShComma, ".": ShDot,
  "+": ShPlus, "*": ShStar, "%": ShPercent, "/": ShSlash,
  "^": ShCaret
}

type TokenizerState {
  pos: Int
  tokens: List<v1.std.core.Token>
  annotations: List<std.source_annotation.UnboundAnnotationCapture>
  interp_depth: List<Int>
}

data v1_scan_step_note: String = "scan_next_token used to return exactly one Token, which encoded the assumption that every lexeme becomes one. An annotation breaks that: it consumes source and produces NO semantic token. Rather than smuggle it through as a token the parser must filter — the TokenRule mistake DESIGN 4c names — the scan result becomes a sum, and the caller decides which accumulator it lands in."

type ScanStep
  = ScannedToken { result: ScanResult }
  | ScannedAnnotation { pos: Int, capture: std.source_annotation.UnboundAnnotationCapture, interp_depth: List<Int> }

data v1_tokenize_artifact_note: String = "tokenize keeps returning List<v1.std.core.Token> and is the SEMANTIC PROJECTION, so every existing caller (compile.dag, the parser, the Rust seed tests) is untouched by construction. tokenize_artifact is the authored result. The projection direction is one-way on purpose: a semantic consumer cannot reach annotation text."

type V1LexArtifact {
  tokens: List<v1.std.core.Token>
  annotations: List<std.source_annotation.UnboundAnnotationCapture>
}

type TokPos {
  pos: Int
  interp_depth: List<Int>
}

type ScanResult {
  pos: Int
  token: v1.std.core.Token
  interp_depth: List<Int>
}

type SourceRef {
  file: String
  text: String
  source_chars: List<Int>
}

fn make_token(text: String, span: std.types.SourceSpan, shape: v1.std.core.TokenShape) -> v1.std.core.Token {
  Token { text: text, span: span, shape: shape }
}

fn source_char(source: SourceRef, pos: Int) -> String {
  from_code_point(cp: source.source_chars[pos])
}

fn source_code_point(source: SourceRef, pos: Int) -> Int {
  let _ = record_source_chars_index_lookup()
  source.source_chars[pos]
}

fn source_len(source: SourceRef) -> Int {
  count(source.source_chars)
}

fn source_substring(source: SourceRef, start: Int, end: Int) -> String {
  chars_to_string(chars: source.source_chars, start: start, end: end)
}

fn source_scan_while(source: SourceRef, start: Int, pred: fn(Int) -> Bool) -> Int {
  if start >= source_len(source: source) { source_len(source: source) }
  else if pred(source.source_chars[start]) {
    source_scan_while(source: source, start: start + 1, pred: pred)
  } else { start }
}

fn source_skip_ws(source: SourceRef, start: Int) -> Int {
  if start >= source_len(source: source) { start }
  else {
    let ch = source.source_chars[start]
    if ch == 32 || ch == 9 { source_skip_ws(source: source, start: start + 1) }
    else { start }
  }
}

fn source_scan_to_eol(source: SourceRef, start: Int) -> Int {
  if start >= source_len(source: source) { source_len(source: source) }
  else if source.source_chars[start] == 10 { start }
  else { source_scan_to_eol(source: source, start: start + 1) }
}

fn tokenize_artifact(source: String, file: String) -> V1LexArtifact {
  let c = chars(source)
  let src = SourceRef { file: file, text: source, source_chars: c }
  let initial = TokPos { pos: 0, interp_depth: [] }
  let final_state = tokenize_loop(source: src, tokens: [], annotations: [], pos: initial, fuel: source_len(source: src) + 1)
  let eof_span = make_file_span(file: src.file, start: final_state.pos, end: final_state.pos)
  V1LexArtifact {
    tokens: list_push(final_state.tokens, make_token(text: "", span: eof_span, shape: ShEof)),
    annotations: final_state.annotations
  }
}

fn tokenize(source: String, file: String) -> List<v1.std.core.Token> {
  tokenize_artifact(source: source, file: file).tokens
}

data v1_line_prefix_note: String = "The seed reads the PHYSICAL LINE PREFIX directly instead of threading a `have I seen a semantic token` flag. It can, because it holds the whole source and an index: source_line_start walks back to just after the previous line feed, and the shared std.source_annotation fold then judges the slice between there and the annotation.

This is the same rule the modeled lexer applies, not a second one — that lexer walks lexemes and so must thread the state forward, while this one can look back. Only the way each obtains the code points differs. Removing the flag also removes the failure it invited: the flag was set by token CATEGORY, which is wrong for any grammar whose tokens may themselves contain line feeds.

The backward walk stops at the previous line feed, so it costs one line, not one file."

fn source_line_start(source: SourceRef, pos: Int) -> Int {
  if pos <= 0 {
    0
  } else if source_code_point(source: source, pos: pos - 1) == 10 {
    pos
  } else {
    source_line_start(source: source, pos: pos - 1)
  }
}

data v1_blank_line_lookback_note: String = "Whether a blank line precedes the annotation, observed here because it cannot be observed later — the whitespace between two captures is consumed before the parser sees anything, so by attachment time two adjacent comment lines and two blocks separated by a blank line are indistinguishable.

The previous line is the text between the line start before this one and this line's start. It is blank exactly when that text is indentation only, which is the SAME predicate placement uses, so a blank line and an indent-only prefix are one concept read at two positions rather than two spellings of whitespace. An annotation on the first line of a file has no previous line and is not preceded by one. The walk is bounded by one line."

fn preceded_by_blank_line(source: SourceRef, pos: Int) -> Bool {
  let line_start = source_line_start(source: source, pos: pos)
  if line_start <= 0 {
    false
  } else {
    advance_line_prefix_indent_only_text(
      previous: true,
      lexeme: source_substring(
        source: source,
        start: source_line_start(source: source, pos: line_start - 1),
        end: line_start - 1
      )
    )
  }
}

data v1_annotation_line_lookback_note: String = "Whether the previous line is a STANDALONE annotation line — indentation then the `//` delimiter — observed here beside preceded_by_blank_line for the same reason it is: the physical lines are consumed before attachment runs, so block continuation cannot be re-derived later. A trailing comment on a code line deliberately does not count. The rule this bit feeds treats an annotation-preceded capture as a continuation of the block the previous line belongs to; a capture under a code line continues nothing, whatever that code line happens to carry after its code. The walk is bounded by one line."

fn tokenize_line_first_content_pos(source: SourceRef, pos: Int, end: Int) -> Int {
  if pos >= end {
    end
  } else {
    let ch = source_code_point(source: source, pos: pos)
    if ch == 32 || ch == 9 {
      tokenize_line_first_content_pos(source: source, pos: pos + 1, end: end)
    } else {
      pos
    }
  }
}

fn preceded_by_annotation_line(source: SourceRef, pos: Int) -> Bool {
  let line_start = source_line_start(source: source, pos: pos)
  if line_start <= 0 {
    false
  } else {
    let prev_start = source_line_start(source: source, pos: line_start - 1)
    let prev_end = line_start - 1
    let content = tokenize_line_first_content_pos(source: source, pos: prev_start, end: prev_end)
    content + 1 < prev_end
      && source_code_point(source: source, pos: content) == 47
      && source_code_point(source: source, pos: content + 1) == 47
  }
}

fn line_prefix_is_indent_only(source: SourceRef, pos: Int) -> Bool {
  advance_line_prefix_indent_only_text(
    previous: true,
    lexeme: source_substring(source: source, start: source_line_start(source: source, pos: pos), end: pos)
  )
}

fn scan_next_token(source: SourceRef, pos: TokPos) -> ScanStep {
  let ch = source_code_point(source: source, pos: pos.pos)

  if ch == 10 {
    return ScannedToken { result: ScanResult {
      pos: pos.pos + 1,
      token: make_token(text: "\n", span: make_file_span(file: source.file, start: pos.pos, end: pos.pos + 1), shape: ShNewline),
      interp_depth: pos.interp_depth
    } }
  }

  let next_ch_for_comment = if pos.pos + 1 < source_len(source: source) {
    source_code_point(source: source, pos: pos.pos + 1)
  } else { 0 }
  if ch == 47 && next_ch_for_comment == 47 {
    let eol = source_scan_to_eol(source: source, start: pos.pos)
    return ScannedAnnotation {
      pos: eol,
      capture: std.source_annotation.UnboundAnnotationCapture {
        lexeme: source_substring(source: source, start: pos.pos, end: eol),
        origin: make_file_span(file: source.file, start: pos.pos, end: eol),
        placement: placement_from_line_prefix(indent_only: line_prefix_is_indent_only(source: source, pos: pos.pos)),
        preceded_by_blank_line: preceded_by_blank_line(source: source, pos: pos.pos),
        preceded_by_annotation_line: preceded_by_annotation_line(source: source, pos: pos.pos)
      },
      interp_depth: pos.interp_depth
    }
  }

  if ch == 125 && count(pos.interp_depth) > 0 {
    let top = last(pos.interp_depth).value
    if top == 0 {
      let popped = drop_last(stack: pos.interp_depth)
      let cont_pos = TokPos { pos: pos.pos + 1, interp_depth: popped }
      return ScannedToken { result: scan_str_cont(source: source, pos: cont_pos, span_start: pos.pos) }
    } else {
      return ScannedToken { result: ScanResult {
        pos: pos.pos + 1,
        token: make_token(text: "}", span: make_file_span(file: source.file, start: pos.pos, end: pos.pos + 1), shape: ShRBrace),
        interp_depth: replace_last(stack: pos.interp_depth, value: top - 1)
      } }
    }
  }

  ScannedToken { result: scan_token(source: source, pos: pos, ch: ch) }
}

fn tokenize_loop(source: SourceRef, tokens: List<v1.std.core.Token>, annotations: List<std.source_annotation.UnboundAnnotationCapture>, pos: TokPos, fuel: Int) -> TokenizerState {
  let s = skip_spaces(source: source, pos: pos)
  if s.pos >= source_len(source: source) {
    return TokenizerState { pos: s.pos, tokens: tokens, annotations: annotations, interp_depth: s.interp_depth }
  }
  match scan_next_token(source: source, pos: s) {
    ScannedAnnotation { pos: next_pos, capture: capture, interp_depth: depth } =>
      tokenize_loop(source: source, tokens: tokens, annotations: list_push(annotations, capture), pos: TokPos { pos: next_pos, interp_depth: depth }, fuel: fuel - 1)
    ScannedToken { result: result } =>
      tokenize_loop(source: source, tokens: list_push(tokens, result.token), annotations: annotations, pos: TokPos { pos: result.pos, interp_depth: result.interp_depth }, fuel: fuel - 1)
  }
}

fn scan_token(source: SourceRef, pos: TokPos, ch: Int) -> ScanResult {
  if ch == 34 { return scan_string(source: source, pos: pos) }
  if is_digit(ch: ch) { return scan_number(source: source, pos: pos) }
  if is_ident_start(ch: ch) { return scan_ident(source: source, pos: pos) }

  let next_ch = if pos.pos + 1 < source_len(source: source) {
    source_code_point(source: source, pos: pos.pos + 1)
  } else { 0 }

  if ch == 61 && next_ch == 62 { return emit(pos: pos, shape: ShFatArrow, text: "=>", len: 2, file: source.file) }
  if ch == 45 && next_ch == 62 { return emit(pos: pos, shape: ShArrow, text: "->", len: 2, file: source.file) }
  if ch == 61 && next_ch == 61 { return emit(pos: pos, shape: ShEqEq, text: "==", len: 2, file: source.file) }
  if ch == 33 && next_ch == 61 { return emit(pos: pos, shape: ShNe, text: "!=", len: 2, file: source.file) }
  if ch == 60 && next_ch == 61 { return emit(pos: pos, shape: ShLe, text: "<=", len: 2, file: source.file) }
  if ch == 62 && next_ch == 61 { return emit(pos: pos, shape: ShGe, text: ">=", len: 2, file: source.file) }
  if ch == 38 && next_ch == 38 { return emit(pos: pos, shape: ShAnd, text: "&&", len: 2, file: source.file) }
  if ch == 124 && next_ch == 124 { return emit(pos: pos, shape: ShOr, text: "||", len: 2, file: source.file) }
  if ch == 124 && next_ch == 62 { return emit(pos: pos, shape: ShPipeArrow, text: "|>", len: 2, file: source.file) }
  if ch == 124 { return emit(pos: pos, shape: ShPipe, text: "|", len: 1, file: source.file) }
  if ch == 63 && next_ch == 63 { return emit(pos: pos, shape: ShNullCoalesce, text: "??", len: 2, file: source.file) }
  if ch == 46 && next_ch == 46 { return emit(pos: pos, shape: ShDotDot, text: "..", len: 2, file: source.file) }

  if ch == 61 { return emit(pos: pos, shape: ShEq, text: "=", len: 1, file: source.file) }
  if ch == 60 { return emit(pos: pos, shape: ShLt, text: "<", len: 1, file: source.file) }
  if ch == 62 { return emit(pos: pos, shape: ShGt, text: ">", len: 1, file: source.file) }
  if ch == 45 { return emit(pos: pos, shape: ShMinus, text: "-", len: 1, file: source.file) }
  if ch == 33 { return emit(pos: pos, shape: ShBang, text: "!", len: 1, file: source.file) }
  if ch == 63 { return emit(pos: pos, shape: ShQuestion, text: "?", len: 1, file: source.file) }

  if ch == 123 {
    let new_depth = if count(pos.interp_depth) > 0 {
      replace_last(stack: pos.interp_depth, value: last(pos.interp_depth).value + 1)
    } else {
      pos.interp_depth
    }
    let tok = make_token(text: "{", span: make_file_span(file: source.file, start: pos.pos, end: pos.pos + 1), shape: ShLBrace)
    return ScanResult {
      pos: pos.pos + 1, token: tok, interp_depth: new_depth
    }
  }

  if ch == 125 {
    let tok = make_token(text: "}", span: make_file_span(file: source.file, start: pos.pos, end: pos.pos + 1), shape: ShRBrace)
    return ScanResult {
      pos: pos.pos + 1, token: tok, interp_depth: pos.interp_depth
    }
  }

  let ch_text = source_char(source: source, pos: pos.pos)
  match lookup(single_punct, key: ch_text) {
    Present { value: sh } => emit(pos: pos, shape: sh, text: ch_text, len: 1, file: source.file)
    Absent => emit(pos: pos, shape: ShUnknown, text: ch_text, len: 1, file: source.file)
  }
}

fn emit(pos: TokPos, shape: v1.std.core.TokenShape, text: String, len: Int, file: String) -> ScanResult {
  let token = make_token(text: text, span: make_file_span(file: file, start: pos.pos, end: pos.pos + len), shape: shape)
  ScanResult {
    pos: pos.pos + len,
    token: token,
    interp_depth: pos.interp_depth
  }
}

fn scan_ident(source: SourceRef, pos: TokPos) -> ScanResult {
  let end = source_scan_while(source: source, start: pos.pos, pred: is_ident_char)
  let text = source_substring(source: source, start: pos.pos, end: end)
  let shape = if is_reserved_emit_sentinel(text: text) { ShUnknown }
    else if is_keyword_text(text: text) { ShKeyword }
    else { ShIdent }
  let token = make_token(text: text, span: make_file_span(file: source.file, start: pos.pos, end: end), shape: shape)
  ScanResult { pos: end, token: token, interp_depth: pos.interp_depth }
}

fn scan_number(source: SourceRef, pos: TokPos) -> ScanResult {
  let int_end = source_scan_while(source: source, start: pos.pos, pred: is_digit)
  if int_end + 1 < source_len(source: source) && source_code_point(source: source, pos: int_end) == 46 && is_digit(ch: source_code_point(source: source, pos: int_end + 1)) {
    let frac_end = source_scan_while(source: source, start: int_end + 1, pred: is_digit)
    let text = source_substring(source: source, start: pos.pos, end: frac_end)
    let token = make_token(text: text, span: make_file_span(file: source.file, start: pos.pos, end: frac_end), shape: ShLitFloat)
    return ScanResult { pos: frac_end, token: token, interp_depth: pos.interp_depth }
  }
  let text = source_substring(source: source, start: pos.pos, end: int_end)
  let parsed = parse_int(s: text)
  let shape = match parsed {
    Present { value: _ } => ShLitInt
    Absent => ShUnknown
  }
  let token = make_token(text: text, span: make_file_span(file: source.file, start: pos.pos, end: int_end), shape: shape)
  ScanResult { pos: int_end, token: token, interp_depth: pos.interp_depth }
}

type StringScanResult
  = ClosedString { content: List<Int>, end_pos: Int }
  | InterpolationStart { content: List<Int>, end_pos: Int }
  | UnterminatedString { content: List<Int>, end_pos: Int }

type EscapeProcessResult
  = EscapesProcessed { text: String }
  | EscapeProcessingRefused {}

fn make_processed_string_token(
  content: List<Int>,
  span: std.types.SourceSpan,
  accepted_shape: v1.std.core.TokenShape
) -> v1.std.core.Token {
  match process_escapes(chars: content) {
    EscapesProcessed { text: processed } =>
      make_token(text: processed, span: span, shape: accepted_shape)
    EscapeProcessingRefused {} =>
      make_token(
        text: chars_to_string(chars: content, start: 0, end: count(content)),
        span: span,
        shape: ShUnknown
      )
  }
}

fn scan_string(source: SourceRef, pos: TokPos) -> ScanResult {
  let span_start = pos.pos
  let body_start = pos.pos + 1
  let result = scan_string_body(source: source, pos: body_start, acc: [])
  match result {
    ClosedString { content, end_pos } => {
      let token = make_processed_string_token(
        content: content,
        span: make_file_span(file: source.file, start: span_start, end: end_pos + 1),
        accepted_shape: ShLitStr
      )
      ScanResult {
        pos: end_pos + 1, token: token,
        interp_depth: pos.interp_depth
      }
    }
    InterpolationStart { content, end_pos } => {
      let token = make_processed_string_token(
        content: content,
        span: make_file_span(file: source.file, start: span_start, end: end_pos + 1),
        accepted_shape: ShStrBegin
      )
      ScanResult {
        pos: end_pos + 1,
        token: token,
        interp_depth: pos.interp_depth |> append(items: 0)
      }
    }
    UnterminatedString { content, end_pos } => {
      let token = make_processed_string_token(
        content: content,
        span: make_file_span(file: source.file, start: span_start, end: end_pos),
        accepted_shape: ShUnknown
      )
      ScanResult {
        pos: end_pos, token: token,
        interp_depth: pos.interp_depth
      }
    }
  }
}

fn scan_str_cont(source: SourceRef, pos: TokPos, span_start: Int) -> ScanResult {
  let result = scan_string_body(source: source, pos: pos.pos, acc: [])
  match result {
    ClosedString { content, end_pos } => {
      let token = make_processed_string_token(
        content: content,
        span: make_file_span(file: source.file, start: span_start, end: end_pos + 1),
        accepted_shape: ShStrEnd
      )
      ScanResult {
        pos: end_pos + 1, token: token,
        interp_depth: pos.interp_depth
      }
    }
    InterpolationStart { content, end_pos } => {
      let token = make_processed_string_token(
        content: content,
        span: make_file_span(file: source.file, start: span_start, end: end_pos + 1),
        accepted_shape: ShStrMid
      )
      ScanResult {
        pos: end_pos + 1,
        token: token,
        interp_depth: pos.interp_depth |> append(items: 0)
      }
    }
    UnterminatedString { content, end_pos } => {
      let token = make_processed_string_token(
        content: content,
        span: make_file_span(file: source.file, start: span_start, end: end_pos),
        accepted_shape: ShUnknown
      )
      ScanResult {
        pos: end_pos, token: token,
        interp_depth: pos.interp_depth
      }
    }
  }
}

fn scan_string_body(source: SourceRef, pos: Int, acc: List<Int>) -> StringScanResult {
  if pos >= source_len(source: source) {
    UnterminatedString { content: acc, end_pos: pos }
  } else {
    let ch = source.source_chars[pos]
    if ch == 34 {
      ClosedString { content: acc, end_pos: pos }
    } else if ch == 92 {
      if pos + 1 < source_len(source: source) {
        let escaped = source.source_chars[pos + 1]
        if escaped == 117 && pos + 2 < source_len(source: source) && source.source_chars[pos + 2] == 123 {
          scan_string_body(
            source: source,
            pos: pos + 3,
            acc: list_push(list_push(list_push(acc, 92), 117), 123)
          )
        } else {
          scan_string_body(source: source, pos: pos + 2, acc: list_push(list_push(acc, 92), escaped))
        }
      } else {
        UnterminatedString { content: list_push(acc, 92), end_pos: pos + 1 }
      }
    } else if ch == 123 {
      if should_start_interpolation(source: source, pos: pos) {
        InterpolationStart { content: acc, end_pos: pos }
      } else {
        scan_string_body(source: source, pos: pos + 1, acc: list_push(acc, 123))
      }
    } else {
      scan_string_body(source: source, pos: pos + 1, acc: list_push(acc, ch))
    }
  }
}

fn should_start_interpolation(source: SourceRef, pos: Int) -> Bool {
  if pos + 1 >= source_len(source: source) {
    false
  } else {
    let next = source_code_point(source: source, pos: pos + 1)
    is_ident_start(ch: next) || next == 40 || next == 33 || next == 45
  }
}

fn process_escapes(chars: List<Int>) -> EscapeProcessResult {
  process_escapes_loop(source: chars, pos: 0, acc: [])
}

data code_point_at_accessor_note: String = "Why this accessor exists rather than indexing inline. `04_access.check_index_access_node` types a list index as OPTIONAL (`with_optional_cardinality`) — an out-of-range index has no value — but the Rust realization of an index is a bare element that panics out of range. The two disagree, so wherever the emitter acts on the declared type it emits a coercion the realization cannot satisfy: passing `chars[i]` straight to a declared fn parameter emits `.expect(...)` on an `i64` (E0599). Untouched positions — a let binding, a comparison, arithmetic, a builtin call — happen to line up, which is why the corpus has exactly one prior index-as-argument site and it calls the BUILTIN `from_code_point`. This accessor is the same shape as `source_code_point` and `source_char` above: a declared `-> Int` return is what carries the value across a fn boundary. It works because return position is not checked against the body (recorded on the finalization carrier, #7481), so it is borrowed load-bearing behavior, not a guarantee. Dissolves together with those two when the index model and its realization are reconciled — either the index realizes as an Option or it types as the element — at which point return-position typechecking would red all three at once."

fn code_point_at(chars: List<Int>, pos: Int) -> Int {
  chars[pos]
}

data escape_code_point_table_note: String = "The escape table below is written in code points because the whole tokenizer is: scan_token compares `ch == 61 && next_ch == 62` for `=>`, source_scan_to_eol compares `== 10`. The decimal literals here are the same alphabet: 34 double-quote, 48 `0`, 92 backslash, 110 `n`, 114 `r`, 116 `t`, 117 `u`, 120 `x`, 123 open-brace, 125 close-brace; the values they resolve TO include 0 NUL, 10 line-feed, 13 carriage-return, and 9 tab. This function used to compare one-character Strings instead, which is what forced it to re-index a raw String and made it the last quadratic scan in the file."

data escape_receipt_seed_growth_mark: String = "🟡 Seed-growth mark (v1-test class): src/v1/stage0/tests/tokenize_escape_receipt.rs is hand-written Rust added to the v1 seed tree, counted here rather than left silent. The discovery-enrolled .dag wall in test.claim.string_brace_escape_witness_test constructs malformed source at runtime and executes the production v1 compile path, so malformed and unknown escape refusal is enforced in CI. The Rust receipt retains finer token identity, spelling, file and full-span assertions plus the decode table. Its wall-clock cost separation stays #[ignore]d because contention can fail correct code and the available work counter does not instrument char_at/string_length. This file does not enter the hand-maintained stage0 module ratchet because tests/ is not a crate module. DISSOLVES ON the v1 terminal deletion path, when the coverage moves under the v1-test-migration bar and this hand-written receipt deletes with src/v1. The benchmark half can dissolve earlier when a structural lens rejects per-character raw-String index walks."

data hex_escape_note: String = "\\xNN decodes to the byte NN names. Before this arm every \\x fell through to the unknown-escape branch below, which preserves the backslash literally — so every ANSI code authored in .dag (extdeps.render.ansi.csi_esc, extdeps.render.terminal's reset, gunbc.ci_render's red/reset) emitted the six characters backslash-x-1-b instead of ESC, and no colour this repo authored had ever rendered. The witness that was supposed to catch it compared one undecoded literal against another, so it agreed with itself and could not fail (DESIGN §5 — a check satisfied by editing the declaration while the realization lies)."

data unicode_escape_note: String = "\\u\{H...\} decodes one to six hexadecimal digits to one Unicode scalar value. The shared std.unicode.types.unicode_scalar authority denoted by the Char refinement is checked before chars_to_string, so values above 0x10FFFF and the UTF-16 surrogate interval refuse instead of disappearing in runtime conversion. Before this arm every \\u escape fell through to unknown-escape passthrough as eight or more literal characters. That made extdeps.render.ansi's 32 ECMA-48 C1 rows inert and, more severely, made effect_plan_bash_materialize's NUL guard look for printable escape text instead of NUL. The scanner consumes the opening brace with the escape prefix so a valid hex digit A-F cannot be misread as an interpolation start; digit accumulation remains owned by this decoder rather than duplicated into the span scan."

data unknown_escape_refusal_note: String = "An escape marker has already entered a closed grammar production, so an unrecognized or malformed escape refuses as one located ShUnknown string token; it never returns a successfully decoded prefix and never copies unsupported syntax into an accepted value. A literal backslash is spelled \\\\. The former passthrough arm made unsupported syntax indistinguishable from supported syntax and was the root class behind the inert Unicode escapes. Its 142-site regex-heavy corpus frontier migrated with this close, and the whole corpus is the receipt because every source passes through this tokenizer."

fn hex_digit_value(cp: Int) -> Int? {
  if cp >= 48 && cp <= 57 {
    Present { value: cp - 48 }
  } else {
    if cp >= 97 && cp <= 102 {
      Present { value: cp - 87 }
    } else {
      if cp >= 65 && cp <= 70 {
        Present { value: cp - 55 }
      } else {
        none
      }
    }
  }
}

fn hex_escape_char(hi: Int, lo: Int) -> Int? {
  match hex_digit_value(cp: hi) {
    Present { value: h } => match hex_digit_value(cp: lo) {
      Present { value: l } => Present { value: h * 16 + l }
      Absent => none
    }
    Absent => none
  }
}

type UnicodeEscape {
  code_point: Int
  next_pos: Int
}

fn unicode_escape_at(
  source: List<Int>,
  pos: Int,
  digit_count: Int,
  value: Int
) -> UnicodeEscape? {
  if pos >= count(source) {
    none
  } else {
    let ch = code_point_at(chars: source, pos: pos)
    if ch == 125 {
      if digit_count > 0 && std.unicode.types.unicode_scalar(code_point: value) {
        Present { value: UnicodeEscape { code_point: value, next_pos: pos + 1 } }
      } else {
        none
      }
    } else if digit_count >= 6 {
      none
    } else {
      match hex_digit_value(cp: ch) {
        Present { value: digit } => unicode_escape_at(
          source: source,
          pos: pos + 1,
          digit_count: digit_count + 1,
          value: value * 16 + digit
        )
        Absent => none
      }
    }
  }
}

fn process_escapes_loop(source: List<Int>, pos: Int, acc: List<Int>) -> EscapeProcessResult {
  if pos >= count(source) {
    EscapesProcessed { text: chars_to_string(chars: acc, start: 0, end: count(acc)) }
  } else {
    let ch = code_point_at(chars: source, pos: pos)
    if ch == 92 {
      if pos + 1 >= count(source) {
        EscapeProcessingRefused {}
      } else {
        let next = code_point_at(chars: source, pos: pos + 1)
        if next == 120 && pos + 3 < count(source) {
          let hi = code_point_at(chars: source, pos: pos + 2)
          let lo = code_point_at(chars: source, pos: pos + 3)
          match hex_escape_char(hi: hi, lo: lo) {
            Present { value: decoded } =>
              process_escapes_loop(source: source, pos: pos + 4, acc: list_push(acc, decoded))
            Absent => EscapeProcessingRefused {}
          }
        } else if next == 117 && pos + 2 < count(source) && code_point_at(chars: source, pos: pos + 2) == 123 {
          match unicode_escape_at(source: source, pos: pos + 3, digit_count: 0, value: 0) {
            Present { value: decoded } => process_escapes_loop(
              source: source,
              pos: decoded.next_pos,
              acc: list_push(acc, decoded.code_point)
            )
            Absent => EscapeProcessingRefused {}
          }
        } else {
          let decoded = if next == 34 { Present { value: 34 } }
            else if next == 48 { Present { value: 0 } }
            else if next == 92 { Present { value: 92 } }
            else if next == 110 { Present { value: 10 } }
            else if next == 114 { Present { value: 13 } }
            else if next == 116 { Present { value: 9 } }
            else if next == 123 { Present { value: 123 } }
            else if next == 125 { Present { value: 125 } }
            else { none }
          match decoded {
            Present { value: code_point } => process_escapes_loop(
              source: source,
              pos: pos + 2,
              acc: list_push(acc, code_point)
            )
            Absent => EscapeProcessingRefused {}
          }
        }
      }
    } else {
      process_escapes_loop(source: source, pos: pos + 1, acc: list_push(acc, ch))
    }
  }
}

fn drop_last(stack: List<Int>) -> List<Int> {
  let len = count(stack)
  fold(enumerate(stack), init: [], f: fn(result, pair) {
    if pair.first < len - 1 {
      result |> append(items: pair.second)
    } else {
      result
    }
  })
}

fn replace_last(stack: List<Int>, value: Int) -> List<Int> {
  let prefix = drop_last(stack: stack)
  prefix |> append(items: value)
}

fn skip_spaces(source: SourceRef, pos: TokPos) -> TokPos {
  let p = source_skip_ws(source: source, start: pos.pos)
  TokPos { pos: p, interp_depth: pos.interp_depth }
}

fn is_digit(ch: Int) -> Bool {
  ch >= 48 && ch <= 57
}

fn is_ident_start(ch: Int) -> Bool {
  ch == 95 || is_xid_start(ch: ch) || is_emoji_ident(ch: ch)
}

fn is_ident_char(ch: Int) -> Bool {
  is_xid_continue(ch: ch) || is_emoji_ident(ch: ch)
}

fn is_hex_upper_digit(ch: Int) -> Bool {
  (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 70)
}

fn all_hex_upper_in_range(text: String, pos: Int, end: Int) -> Bool {
  if pos >= end { true }
  else {
    let ch = code_point(c: char_at(s: text, pos: pos))
    if is_hex_upper_digit(ch: ch) { all_hex_upper_in_range(text: text, pos: pos + 1, end: end) }
    else { false }
  }
}

fn sentinel_prefix_matches(text: String, prefix: String, pos: Int, len: Int) -> Bool {
  if pos >= len { true }
  else if code_point(c: char_at(s: text, pos: pos)) != code_point(c: char_at(s: prefix, pos: pos)) { false }
  else { sentinel_prefix_matches(text: text, prefix: prefix, pos: pos + 1, len: len) }
}

fn sentinel_suffix_matches(text: String, suffix: String, pos: Int, sfx_len: Int, text_start: Int) -> Bool {
  if pos >= sfx_len { true }
  else if code_point(c: char_at(s: text, pos: text_start + pos)) != code_point(c: char_at(s: suffix, pos: pos)) { false }
  else { sentinel_suffix_matches(text: text, suffix: suffix, pos: pos + 1, sfx_len: sfx_len, text_start: text_start) }
}

fn is_reserved_emit_sentinel(text: String) -> Bool {
  let rule = canonical_emoji_char_escape()
  let pfx = rule.prefix
  let sfx = rule.suffix
  let pfx_len = string_length(s: pfx)
  let sfx_len = string_length(s: sfx)
  let n = string_length(s: text)
  if n < pfx_len + sfx_len + 1 { false }
  else if !sentinel_prefix_matches(text: text, prefix: pfx, pos: 0, len: pfx_len) { false }
  else if !sentinel_suffix_matches(text: text, suffix: sfx, pos: 0, sfx_len: sfx_len, text_start: n - sfx_len) { false }
  else { all_hex_upper_in_range(text: text, pos: pfx_len, end: n - sfx_len) }
}
