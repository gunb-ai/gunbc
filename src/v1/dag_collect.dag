module v1.compiler.dag_collect

import v1.std.core {
  Node,
  InferredNode, Resolved,
  ExprData,
  Connective, NoConnective,
  MatchPattern,
  import_is_all
}
import v1.compiler.dag_collect_support {
  DagCollectAcc, DagCollectSlot,
  dag_collect_fp_memo_reset, dag_collect_pack_slots, dag_collect_slot_seq,
  dag_node_surface_fingerprint, dag_node_surface_fingerprint_memo
}
import v1.compiler.infer_items { ResolvedGraph, TypedModule }

fn is_import_slot_node(n: Node) -> Bool {
  import_is_all(n: n) || (
    n.params |> count == 0 && n.ident_span != none && n.body == none && n.expr_data == NoExprData)
}

fn is_module_shell_node(n: Node) -> Bool {
  n.inferred == none && n.expr_data == NoExprData && n.connective == NoConnective && n.body == none
    && n.transport == none && n.uses |> count == 0
    && n.params |> all(p => is_import_slot_node(p: p))
}

fn dag_node_is_resolved_identity_shell(node: Node) -> Bool {
  match node.expr_data {
    NoExprData =>
      match node.inferred {
        Present { value: Resolved { node: _ } } =>
          node.body == none && node.transport == none
            && (node.children |> count) == 0 && (node.params |> count) == 0
        _ => false
      }
    _ => false
  }
}

fn dag_node_collection_anchor(node: Node) -> Node {
  if dag_node_is_resolved_identity_shell(node: node) {
    match node.inferred {
      Present { value: Resolved { node: target } } => dag_node_collection_anchor(node: target)
      _ => node
    }
  } else {
    node
  }
}

fn dag_node_key(node: Node) -> String {
  let anchor = dag_node_collection_anchor(node: node)
  if anchor.span.start == 0 && anchor.span.end == 0 {
    concat(":0..0:", dag_node_surface_fingerprint_memo(node: anchor))
  } else {
    concat(
      anchor.span.file, ":", to_string(i: anchor.span.start), "..", to_string(i: anchor.span.end),
      match anchor.ident {
        Present { value: id } => concat(":", to_string(i: id))
        Absent => ""
      })
  }
}

fn dag_node_fingerprint(node: Node) -> String {
  dag_node_surface_fingerprint_memo(node: dag_node_collection_anchor(node: node))
}

fn dag_collect_nodes_list(nodes: List<Node>, slots: Map<String, DagCollectSlot>, collision_errors: List<ErrorNode>) -> Map<String, DagCollectSlot> {
  nodes |> fold(init: slots, f: (s, n) => dag_collect_insert_slots(node: n, slots: s, collision_errors: collision_errors))
}

fn dag_collect_optional_node(value: Node?, slots: Map<String, DagCollectSlot>, collision_errors: List<ErrorNode>) -> Map<String, DagCollectSlot> {
  match value {
    Present { value: inner } => dag_collect_insert_slots(node: inner, slots: slots, collision_errors: collision_errors)
    Absent => slots
  }
}

fn dag_collect_inferred(value: InferredNode?, slots: Map<String, DagCollectSlot>, collision_errors: List<ErrorNode>) -> Map<String, DagCollectSlot> {
  match value {
    Present { value: Resolved { node: n } } => dag_collect_insert_slots(node: n, slots: slots, collision_errors: collision_errors)
    _ => slots
  }
}

fn dag_collect_match_pattern(pattern: MatchPattern, slots: Map<String, DagCollectSlot>, collision_errors: List<ErrorNode>) -> Map<String, DagCollectSlot> {
  match pattern {
    Bind { name: _ } => slots
    LitPattern { value: _ } => slots
    VariantPattern { name: _, parent_enum: _, field_bindings: field_bindings } =>
      field_bindings |> fold(init: slots, f: (s, fb) => dag_collect_insert_slots(node: fb, slots: s, collision_errors: collision_errors))
    Wildcard => slots
  }
}

fn dag_collect_node_tree(node: Node, slots: Map<String, DagCollectSlot>, collision_errors: List<ErrorNode>) -> Map<String, DagCollectSlot> {
  let slots = dag_collect_nodes_list(nodes: node.children, slots: slots, collision_errors: collision_errors)
  let slots = if is_module_shell_node(n: node) {
    slots
  } else {
    dag_collect_nodes_list(nodes: node.params, slots: slots, collision_errors: collision_errors)
  }
  let slots = dag_collect_nodes_list(nodes: node.uses, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_optional_node(value: node.body, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_optional_node(value: node.transport, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_nodes_list(nodes: node.properties, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_optional_node(value: node.type_annotation, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_inferred(value: node.inferred, slots: slots, collision_errors: collision_errors)
  match node.match_pattern {
    Present { value: p } => dag_collect_match_pattern(pattern: p, slots: slots, collision_errors: collision_errors)
    Absent => slots
  }
}

data dag_collect_synthetic_key_note: String = "Synthetic span-0 keys embed the fingerprint; the Absent branch recovers it by substring and must not re-hash."

fn dag_collect_insert_slots(node: Node, slots: Map<String, DagCollectSlot>, collision_errors: List<ErrorNode>) -> Map<String, DagCollectSlot> {
  let anchor = dag_node_collection_anchor(node: node)
  let key = dag_node_key(node: anchor)
  match map_get(slots, key) {
    Present { value: _ } => slots
    Absent => {
      let fp = if anchor.span.start == 0 && anchor.span.end == 0 {
        substring(s: key, start: 6, end: string_length(s: key))
      } else {
        dag_node_fingerprint(node: anchor)
      }
      let seq = dag_collect_slot_seq(slots: slots)
      dag_collect_node_tree(
        node: anchor,
        slots: map_insert(slots, key, DagCollectSlot { key: key, fp: fp, node: anchor, seq: seq }),
        collision_errors: collision_errors
      )
    }
  }
}

fn dag_collect_from_module(module: TypedModule, slots: Map<String, DagCollectSlot>, collision_errors: List<ErrorNode>) -> Map<String, DagCollectSlot> {
  let slots = dag_collect_insert_slots(node: module.module, slots: slots, collision_errors: collision_errors)
  module.items |> fold(init: slots, f: (s, item) => dag_collect_insert_slots(node: item, slots: s, collision_errors: collision_errors))
}

data dag_collect_collision_threading_dissolve_on: String = "Dissolve-on: drop collision_errors threading once synthetic-key construction proof is a typed wall (key embeds fp ⇒ key-equal ⇒ fp-equal); kept for emit_dag gate shape."

fn collect_dag_nodes(typed: ResolvedGraph) -> DagCollectAcc {
  let _memo_reset = dag_collect_fp_memo_reset()
  let collision_errors = []
  let slots = typed.modules
    |> fold(init: empty_map(), f: (s, m) => dag_collect_from_module(module: m, slots: s, collision_errors: collision_errors))
  dag_collect_pack_slots(slots: slots, collision_errors: collision_errors)
}
