module v1.compiler.dag_collect





fn is_import_slot_node(n: v1.std.core.Node) -> Bool {
  import_is_all(n: n) || (
    n.params |> count == 0 && n.ident_span != none && n.body == none && n.expr_data == NoExprData)
}

fn is_module_shell_node(n: v1.std.core.Node) -> Bool {
  n.inferred == none && n.expr_data == NoExprData && n.connective == NoConnective && n.body == none
    && n.transport == none && n.uses |> count == 0
    && n.params |> all(p => is_import_slot_node(n: p))
}

fn dag_node_is_resolved_identity_shell(node: v1.std.core.Node) -> Bool {
  match node.expr_data {
    NoExprData =>
      match node.inferred {
        Present { value: v1.std.core.Resolved { node: _ } } =>
          node.body == none && node.transport == none
            && (node.children |> count) == 0 && (node.params |> count) == 0
        _ => false
      }
    _ => false
  }
}

fn dag_node_collection_anchor(node: v1.std.core.Node) -> v1.std.core.Node {
  if dag_node_is_resolved_identity_shell(node: node) {
    match node.inferred {
      Present { value: v1.std.core.Resolved { node: target } } => dag_node_collection_anchor(node: target)
      _ => node
    }
  } else {
    node
  }
}

fn dag_node_key(node: v1.std.core.Node) -> String {
  let anchor = dag_node_collection_anchor(node: node)
  if anchor.span.start == 0 && anchor.span.end == 0 {
    concat(":0..0:", dag_node_surface_fingerprint_memo(node: anchor))
  } else {
    concat(
      anchor.span.file, ":", to_string(value: anchor.span.start), "..", to_string(value: anchor.span.end),
      match anchor.ident {
        Present { value: id } => concat(":", to_string(value: id))
        Absent => ""
      })
  }
}

fn dag_node_fingerprint(node: v1.std.core.Node) -> String {
  dag_node_surface_fingerprint_memo(node: dag_node_collection_anchor(node: node))
}

fn dag_collect_nodes_list(nodes: List<v1.std.core.Node>, slots: Map<String, v1.compiler.dag_collect_support.DagCollectSlot>, collision_errors: List<v1.std.core.ErrorNode>) -> Map<String, v1.compiler.dag_collect_support.DagCollectSlot> {
  nodes |> fold(init: slots, f: (s, n) => dag_collect_insert_slots(node: n, slots: s, collision_errors: collision_errors))
}

fn dag_collect_optional_node(value: v1.std.core.Node?, slots: Map<String, v1.compiler.dag_collect_support.DagCollectSlot>, collision_errors: List<v1.std.core.ErrorNode>) -> Map<String, v1.compiler.dag_collect_support.DagCollectSlot> {
  match value {
    Present { value: inner } => dag_collect_insert_slots(node: inner, slots: slots, collision_errors: collision_errors)
    Absent => slots
  }
}

fn dag_collect_inferred(value: InferredNode?, slots: Map<String, v1.compiler.dag_collect_support.DagCollectSlot>, collision_errors: List<v1.std.core.ErrorNode>) -> Map<String, v1.compiler.dag_collect_support.DagCollectSlot> {
  match value {
    Present { value: v1.std.core.Resolved { node: n } } => dag_collect_insert_slots(node: n, slots: slots, collision_errors: collision_errors)
    _ => slots
  }
}

// match_pattern is a SubValueField (v1.std.core node_field_roles), same as body
// and expr_data; its embedded v1.std.core.Node subtrees (Bind.declaration,
// VariantPattern.field_bindings) are real DAG artifacts and must be registered
// or they never enter the collection accumulator at all.
fn dag_collect_match_pattern(pattern: MatchPattern?, slots: Map<String, v1.compiler.dag_collect_support.DagCollectSlot>, collision_errors: List<v1.std.core.ErrorNode>) -> Map<String, v1.compiler.dag_collect_support.DagCollectSlot> {
  match pattern {
    Present { value: v1.std.core.Bind { declaration: d } } => dag_collect_insert_slots(node: d, slots: slots, collision_errors: collision_errors)
    Present { value: VariantPattern { name: _, parent_enum: _, field_bindings: fbs } } =>
      dag_collect_nodes_list(nodes: fbs, slots: slots, collision_errors: collision_errors)
    Present { value: LitPattern { value: _ } } => slots
    Present { value: v1.std.core.Wildcard } => slots
    Absent => slots
  }
}

fn dag_collect_node_tree(node: v1.std.core.Node, slots: Map<String, v1.compiler.dag_collect_support.DagCollectSlot>, collision_errors: List<v1.std.core.ErrorNode>) -> Map<String, v1.compiler.dag_collect_support.DagCollectSlot> {
  let slots = dag_collect_nodes_list(nodes: node.children, slots: slots, collision_errors: collision_errors)
  let slots = if is_module_shell_node(n: node) {
    slots
  } else {
    dag_collect_nodes_list(nodes: node.params, slots: slots, collision_errors: collision_errors)
  }
  let slots = dag_collect_nodes_list(nodes: node.uses, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_optional_node(value: node.body, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_optional_node(value: node.transport, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_nodes_list(nodes: node.properties, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_optional_node(value: node.type_annotation, slots: slots, collision_errors: collision_errors)
  let slots = dag_collect_match_pattern(pattern: node.match_pattern, slots: slots, collision_errors: collision_errors)
  dag_collect_inferred(value: node.inferred, slots: slots, collision_errors: collision_errors)
}

fn dag_collect_insert_slots(node: v1.std.core.Node, slots: Map<String, v1.compiler.dag_collect_support.DagCollectSlot>, collision_errors: List<v1.std.core.ErrorNode>) -> Map<String, v1.compiler.dag_collect_support.DagCollectSlot> {
  let anchor = dag_node_collection_anchor(node: node)
  let key = dag_node_key(node: anchor)
  match map_get(slots, key) {
    Present { value: _ } => slots
    Absent => {
      let fp = if anchor.span.start == 0 && anchor.span.end == 0 {
        substring(s: key, start: 6, end: string_length(s: key))
      } else {
        dag_node_fingerprint(node: anchor)
      }
      let seq = dag_collect_slot_seq(slots: slots)
      dag_collect_node_tree(
        node: anchor,
        slots: map_insert(slots, key, v1.compiler.dag_collect_support.DagCollectSlot { key: key, fp: fp, node: anchor, seq: seq }),
        collision_errors: collision_errors
      )
    }
  }
}

fn dag_collect_from_module(module: v1.compiler.infer_items.TypedModule, slots: Map<String, v1.compiler.dag_collect_support.DagCollectSlot>, collision_errors: List<v1.std.core.ErrorNode>) -> Map<String, v1.compiler.dag_collect_support.DagCollectSlot> {
  let slots = dag_collect_insert_slots(node: module.module, slots: slots, collision_errors: collision_errors)
  module.items |> fold(init: slots, f: (s, item) => dag_collect_insert_slots(node: item, slots: s, collision_errors: collision_errors))
}

fn collect_dag_nodes(typed: v1.compiler.infer_items.ResolvedGraph) -> v1.compiler.dag_collect_support.DagCollectAcc {
  let _memo_reset = dag_collect_fp_memo_reset()
  let collision_errors = []
  let slots = typed.modules
    |> fold(init: empty_map(), f: (s, m) => dag_collect_from_module(module: m, slots: s, collision_errors: collision_errors))
  dag_collect_pack_slots(slots: slots, collision_errors: collision_errors)
}
