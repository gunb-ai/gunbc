module v1.probe.emit_interp




fn probe_source() -> SourceFile {
  SourceFile {
    path: "src/v1/probe_add.dag",
    content: "module v1.probe.add\nfn add(x: Int, y: Int) -> Int {\n  x + y\n}\n"
  }
}

fn probe_emitted() -> String {
  let result = compile_sources(sources: [probe_source()], target: Rust)
  result.files |> map(f => f.content) |> join(separator: "\n")
}

fn probe_emit_fold_runs() -> Bool {
  (probe_emitted() |> length) > 0
}

fn probe_emits_fn_add() -> Bool {
  contains(probe_emitted(), "fn add")
}

fn probe_clean_source_has_no_diagnostics() -> Bool {
  let result = compile_sources(sources: [probe_source()], target: Rust)
  (result.diagnostics |> count) == 0
}
