// TEMPORARY PROBE (not floor-enrolled): answers parent's ONE FACT —
// can the v2 interpreter RUN 05_emit_rust.dag's emit fold so a .dag emitter
// fix verifies BY INTERPRETATION (no seed-mirror regen)?
//
// Run: gunbc run --source-root src/v1 --source-root dsl \
//   --entry src/v1/probe_emit_interp.dag --function probe_list_alias_peels_to_vec --claim-run
//
// The inline source path carries "src/v1" so rust_corpus_includes_v1_compiler
// fires, exercising my branch's `type List<element> = FreeMonoid<element>` ->
// `pub type List<element> = Vec<element>` emitter change. If the interpreter
// produces "Vec<element>", emitter fixes ARE interpretation-verifiable.
module v1.probe.emit_interp

import v1.compiler.compile { compile_sources, SourceFile }
import v1.compiler.artifact { RenderTarget, Rust }

fn probe_source() -> SourceFile {
  SourceFile {
    path: "src/v1/probe_list.dag",
    content: "module v1.probe.list\ntype FreeMonoid<T> {\n  empty: FreeMonoid<T>\n}\ntype List<element> = FreeMonoid<element>\n"
  }
}

fn probe_list_alias_peels_to_vec() -> Bool {
  let result = compile_sources(sources: [probe_source()], target: Rust)
  let emitted = result.files |> map(f => f.content) |> join(separator: "\n")
  contains(emitted, "Vec<element>")
}
