module v1.compiler.infer_items










type ItemKind = FnItem | FuncItem | TypeItem | DataItem | ServiceItem | OtherItem

type ItemInfo {
  name: String
  module_name: String
  kind: ItemKind
  service_names: List<String>
  resource_names: List<String>
  params: List<v1.std.core.Node>
  is_self_recursive: Bool
  has_non_tail_self_call: Bool
}

type ModuleInterface {
  summary: std.interface_summary.InterfaceSummary
  env: v1.compiler.infer_env.TypeEnv
  cache: v1.compiler.infer_env.TypeEnvCache
}

data typed_module_interface_body_dual_field_dissolution_trigger: std.dissolution.DissolutionCondition = unbound_dissolution(description: "🟡 dissolve-on (S2a move 2 increment B transitional shape, resolver-graph-major-design.md §7): TypedModule carries both body grain (type_env, type_env_cache) and interface grain (interface.env, interface.cache) as projections from one typecheck completion — interface is built only via build_module_interface at typecheck exit, never independently mutated. Consumption at the parent-import boundary reads interface grain; interpretation and cache-decode rewire keep type_env as canonical Rc-identity authority (rewire_type_env_parent_links :6986). DISSOLVES WHEN ModuleBody is the sole body carrier and TypedModule.interface becomes the only cross-module export surface (interface/body split complete — type_env on TypedModule becomes interpretation-local only or is deleted). Receipt: transitive_interface_binding_test.")

type TypedModule {
  module: v1.std.core.Node
  items: List<v1.std.core.Node>
  type_env: v1.compiler.infer_env.TypeEnv
  type_env_cache: v1.compiler.infer_env.TypeEnvCache
  interface: ModuleInterface
  func_env: v1.compiler.infer_sigs.ResolvedFuncEnv
  item_registry: Map<String, ItemInfo>
  occurrence_transport: std.occurrence_identity.OccurrenceTransport?
}

type TypedGraph {
  modules: List<TypedModule>
  item_registry: Map<String, ItemInfo>
  diagnostics: List<v1.std.core.ErrorNode>
}

type ResolvedGraph {
  modules: List<TypedModule>
  item_registry: Map<String, ItemInfo>
  diagnostics: List<v1.std.core.ErrorNode>
  emit_graph_info: v1.compiler.infer_emit_info.EmitGraphInfo
}

fn inferred_to_outputs(inferred: InferredNode?, span: std.types.SourceSpan, source_indices: Map<String, v1.std.core.NewlineIndex>) -> List<v1.std.core.Node> {
  if inferred == none { [] }
  else { match inferred.value {
    CompilerError { message: _, span: _ } => []
    TypeVariable { id: _ } => []
    Resolved { node: rt } =>
        let has_structure = rt.connective != NoConnective
        if has_structure {
          let is_product = rt.connective == Conj
          if is_product {
            if rt.ident_span == none {
              map(rt.children, child =>
                let child_type = child_type_node(ch: child)
                make_field_node(name: authored_name_at(source_indices: source_indices, node: child), type_expr: child_type, cardinality: v1.std.core.Required, default_value: none, from_key: none, span: span, name_span: node_name_span(n: child))
              )
            } else {
              [make_field_node(name: "value", type_expr: rt, cardinality: v1.std.core.Required, default_value: none, from_key: none, span: span, name_span: no_span())]
            }
          } else {
            [make_field_node(name: "value", type_expr: rt, cardinality: v1.std.core.Required, default_value: none, from_key: none, span: span, name_span: no_span())]
          }
        } else if rt.connective == Conj && rt.children |> count == 0 {
          []
        } else {
          [make_field_node(name: "value", type_expr: rt, cardinality: v1.std.core.Required, default_value: none, from_key: none, span: span, name_span: no_span())]
        }
    }
  }
}

fn item_kind(item: v1.std.core.Node) -> ItemKind {
  let kind = if item.connective != NoConnective && item.transport == none {
    TypeItem
  } else if item.transport != none {
    ServiceItem
  } else if item.body != none && item.uses |> count > 0 {
    FuncItem
  } else if item.body != none && item.params |> count > 0 {
    FnItem
  } else if item.body != none && item.type_annotation != none {
    DataItem
  } else if item.body != none {
    FnItem
  } else {
    OtherItem
  }
  kind
}
