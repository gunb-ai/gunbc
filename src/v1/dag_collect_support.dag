module v1.compiler.dag_collect_support





type DagCollectSlot {
  key: String
  fp: String
  node: v1.std.core.Node
  seq: Int
}

type DagCollectAcc {
  seen: Map<String, String>
  order: List<v1.std.core.Node>
  collision_errors: List<v1.std.core.ErrorNode>
}

fn dag_collect_slot_seq(slots: Map<String, DagCollectSlot>) -> Int {
  slots |> count
}

fn dag_collect_pack_slots(slots: Map<String, DagCollectSlot>, collision_errors: List<v1.std.core.ErrorNode>) -> DagCollectAcc {
  let ordered_slots = slots |> map_values |> sort_by(s => s.seq)
  let order = ordered_slots |> map(s => s.node)
  let seen = ordered_slots |> fold(init: empty_map(), f: (acc, s) => map_insert(acc, s.key, s.fp))
  DagCollectAcc { seen: seen, order: order, collision_errors: collision_errors }
}

fn json_quote(s: String) -> String {
  concat("\"", v1.compiler.emit_core_support.escape_json_string(s: s), "\"")
}

fn inferred_fingerprint(value: v1.std.core.InferredNode?) -> String {
  match value {
    Absent => "none"
    Present { value: v1.std.core.Resolved { node: _ } } => "Resolved"
    Present { value: v1.std.core.TypeVariable { id } } => concat("TypeVariable:", id)
    Present { value: v1.std.core.CompilerError { message: m } } => concat("CompilerError:", m)
  }
}

fn expr_data_variant(data: v1.std.core.ExprData) -> String {
  match data {
    NoExprData => "NoExprData"
    ExprLiteral { value: _ } => "ExprLiteral"
    ExprError { kind: _, message: _ } => "ExprError"
    ExprVar { binding_kind: _ } => "ExprVar"
    ExprFieldAccess { summary: _ } => "ExprFieldAccess"
    ExprCall { call_semantics: _, descent_evidence: _ } => "ExprCall"
    ExprMethodCall { method_semantics: _ } => "ExprMethodCall"
    ExprMatch => "ExprMatch"
    ExprIf => "ExprIf"
    ExprLet => "ExprLet"
    ExprRecordLit { parent_enum: _ } => "ExprRecordLit"
    ExprListLit => "ExprListLit"
    ExprBinOp { op: _, algebra_field: _ } => "ExprBinOp"
    ExprUnaryOp { op: _ } => "ExprUnaryOp"
    ExprLambda => "ExprLambda"
    ExprStringInterp => "ExprStringInterp"
    ExprBlock => "ExprBlock"
    ExprCast => "ExprCast"
    ExprForEach => "ExprForEach"
    ExprIndex => "ExprIndex"
    ExprSlice => "ExprSlice"
    ExprReturn => "ExprReturn"
  }
}

fn connective_name(value: v1.std.core.Connective) -> String {
  match value {
    Conj => "Conj"
    Disj => "Disj"
    NoConnective => "NoConnective"
    Arrow => "Arrow"
  }
}

fn dag_node_bag_hash(digests: List<String>) -> String {
  digests |> sort_by(d => d) |> fold(init: atom_identity_hash("^dag_collect_bag_empty"), f: (acc, d) => hash_combine(acc, d))
}

fn dag_node_seq_hash(digests: List<String>) -> String {
  digests |> fold(init: atom_identity_hash("^dag_collect_seq_empty"), f: (acc, d) => hash_combine(acc, d))
}

fn child_subtree_hash(connective: v1.std.core.Connective, digests: List<String>) -> String {
  match connective {
    Conj => dag_node_bag_hash(digests: digests)
    Disj => dag_node_bag_hash(digests: digests)
    Arrow => dag_node_seq_hash(digests: digests)
    NoConnective => dag_node_seq_hash(digests: digests)
  }
}

fn dag_node_surface_leaf_mix(node: v1.std.core.Node) -> String {
  atom_identity_hash(concat(
    node.name, "|",
    connective_name(value: node.connective), "|",
    inferred_fingerprint(value: node.inferred), "|",
    expr_data_variant(data: node.expr_data)))
}

fn literal_value_fingerprint(value: std.syntax.LiteralValue) -> String {
  match value {
    std.syntax.LitStr { value: v } => concat("LitStr:", v)
    std.syntax.LitInt { value: v } => concat("LitInt:", to_string(value: v))
    std.syntax.LitFloat { value: v } => concat("LitFloat:", v)
    std.syntax.LitBool { value: v } => concat("LitBool:", to_string(value: v))
    LitNull => "LitNull"
    std.syntax.LitSymbol { value: v } => concat("LitSymbol:", v)
  }
}

// match_pattern is a SubValueField (v1.std.core node_field_roles) carrying the
// match-arm/field-binding semantics; the pattern's own Node subtrees
// (Bind.declaration, VariantPattern.field_bindings) must be folded in
// recursively or two arms/bindings differing only by pattern collapse to the
// same fingerprint.
fn match_pattern_fingerprint_rec(pattern: v1.std.core.MatchPattern?) -> String {
  match pattern {
    Absent => atom_identity_hash("^dag_collect_match_pattern_absent")
    Present { value: v1.std.core.Bind { declaration: d } } =>
      hash_combine(atom_identity_hash("Bind"), dag_node_surface_fingerprint_rec(node: d))
    Present { value: v1.std.core.LitPattern { value: v } } =>
      atom_identity_hash(concat("LitPattern:", literal_value_fingerprint(value: v)))
    Present { value: v1.std.core.VariantPattern { name: n, parent_enum: pe, field_bindings: fbs } } =>
      let base = atom_identity_hash(concat(
        "VariantPattern:", n, "|",
        match pe { Present { value: p } => p  Absent => "" }))
      let field_hashes = fbs |> map(f => dag_node_surface_fingerprint_rec(node: f))
      hash_combine(base, dag_node_seq_hash(digests: field_hashes))
    Present { value: v1.std.core.Wildcard } => atom_identity_hash("Wildcard")
  }
}

fn dag_node_surface_fingerprint_rec(node: v1.std.core.Node) -> String {
  let child_hashes = node.children |> map(c => dag_node_surface_fingerprint_rec(node: c))
  let param_hashes = node.params |> map(p => dag_node_surface_fingerprint_rec(node: p))
  let with_children = hash_combine(dag_node_surface_leaf_mix(node: node), child_subtree_hash(connective: node.connective, digests: child_hashes))
  let with_params = hash_combine(with_children, dag_node_seq_hash(digests: param_hashes))
  hash_combine(with_params, match_pattern_fingerprint_rec(pattern: node.match_pattern))
}

fn dag_node_surface_fingerprint(node: v1.std.core.Node) -> String {
  dag_node_surface_fingerprint_rec(node: node)
}

fn dag_collect_fp_memo_reset() -> Bool {
  true
}

fn dag_node_surface_fingerprint_memo(node: v1.std.core.Node) -> String {
  dag_node_surface_fingerprint(node: node)
}

fn dag_node_key_collision_error(key: String, span: v1.std.core.SourceSpan) -> v1.std.core.ErrorNode {
  let synthetic = span.start == 0 && span.end == 0
  let detail = if synthetic {
    " (synthetic 0..0 span; provisional key cannot alias distinct scaffold nodes)"
  } else {
    ""
  }
  v1.std.core.make_error_node(
    diagnostic: v1.std.core.InternalError {
      message: concat("dag artifact: distinct nodes share identity key ", json_quote(s: key), detail),
      span: span
    },
    module_name: ""
  )
}
