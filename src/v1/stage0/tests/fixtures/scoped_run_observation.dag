module test.fixtures.scoped_run_observation

fn claim_true() -> Bool {
  true
}

fn claim_false() -> Bool {
  false
}

fn claim_non_bool() -> String {
  "not a claim verdict"
}

type ProcessExit
  = ExitSuccess
  | ExitFailure { code: Int, reason: String }

fn exit_failure() -> ProcessExit {
  ExitFailure { code: 7, reason: "legacy failure reason" }
}
