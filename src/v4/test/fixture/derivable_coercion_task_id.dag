// src/v4/test/fixture/derivable_coercion_task_id.dag
// Scope: DERIVABLE-COERCION demo — one concept (opaque Symbol-backed TaskId) as API+DB+wire
//   nickname triple; shared semantic core, layer-specific inhabitant constructors only.
// Anchor: task_manager_demo.dag TaskId { identity: Symbol }; thesis nickname-tax payoff.
// Status: fixture authority for find_witness/coercion_fold consumers — zero hand translators.

module v4.test.fixture.derivable_coercion_task_id

import v4.std.model_core {
  ModelCoreFactAxisEncoding,
  ModelCoreFactAxisSurfaceSpelling
}
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.witness { StructuralPropertyWitness }

// Layer nicknames (human-facing names differ; semantic core is shared).
data task_id_nickname_api: Symbol = task_id_nickname_api
data task_id_nickname_db: Symbol = task_id_nickname_db
data task_id_nickname_wire: Symbol = task_id_nickname_wire

// Shared semantic facts — opaque Symbol identity carrier (API TaskId, SQL TEXT/CLOB, OAS string).
data task_id_encoding_opaque_symbol: Symbol = task_id_encoding_opaque_symbol
data task_id_carrier_symbol_identity: Symbol = task_id_carrier_symbol_identity

// Wrong-concept discriminator — numeric encoding (AccountId-style hollow int alias).
data account_id_encoding_numeric: Symbol = account_id_encoding_numeric
data account_id_carrier_machine_int: Symbol = account_id_carrier_machine_int

data derivable_coercion_closed_candidates: Symbol = derivable_coercion_closed_candidates

fn task_id_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn task_id_semantic_core_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisEncoding {}) },
        target: task_id_inhabitant_atom(id: task_id_encoding_opaque_symbol)
      },
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) },
        target: task_id_inhabitant_atom(id: task_id_carrier_symbol_identity)
      }
    ]
  }
}

// API layer — domain `TaskId { identity: Symbol }` grounding as Node inhabitant.
fn task_id_api_inhabitant_node() -> Node {
  task_id_semantic_core_node()
}

// DB layer — SQL TEXT/CLOB column type for `tasks.id` grounding as Node inhabitant.
fn task_id_db_inhabitant_node() -> Node {
  task_id_semantic_core_node()
}

// Wire layer — OpenAPI `type: string` task-id field grounding as Node inhabitant.
fn task_id_wire_inhabitant_node() -> Node {
  task_id_semantic_core_node()
}

fn account_id_wrong_semantic_core_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisEncoding {}) },
        target: task_id_inhabitant_atom(id: account_id_encoding_numeric)
      },
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) },
        target: task_id_inhabitant_atom(id: account_id_carrier_machine_int)
      }
    ]
  }
}

fn derivable_coercion_candidate_closedness(evidence: Node) -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: derivable_coercion_closed_candidates,
    evidence: evidence
  }
}
