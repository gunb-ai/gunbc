// src/v4/test/fixture/task_manager_demo.dag
// Scope: T-16 TaskManager omni-emission demo — data-model-only declaration.
// Status: T-16-A domain + DeploymentUnit; T-16-C Shape-B route projection re-eval —
// `OpenApiOperationWireContractFacts` carries HTTP method/path; coordination
// `WireContract` derived via `openapi_operation_wire_contract`; canonical
// `RestRoute` receipts for OpenAPI / Markdown / SQL drift-lock.

module v4.test.fixture.task_manager_demo

import v4.std.algebra { FreeMonoid, Empty }
import v4.std.collection { Absent, List }
import v4.std.network { NetworkAddress, UriAuthority, UriHost, rfc3986_host_abnf }
import v4.std.text { String }
import v4.std.node { Symbol }
import v4.extdeps.coordination {
  Endpoint, EndpointRef, LanguageRef, FrameworkRef, HostedByFramework, NoFramework,
  WireContract, CoordinationBind, BindRef,
  DeploymentUnit
}
import v4.extdeps.formats.openapi {
  OpenApiOperationWireContractFacts,
  OpenApiHttpWireContractFacts,
  OpenApiHttpRequestReplyWitness,
  OpenApiHttpImmediateSettlementWitness,
  OpenApiHttpNoReplicaConvergenceWitness,
  OpenApiPathTemplateKey,
  OpenApiPost,
  OpenApiPatch,
  OpenApiGet,
  RestRoute,
  openapi_operation_wire_contract,
  rest_route_from_openapi_operation_wire_contract_facts
}

// --- Domain ---------------------------------------------------------------

// Symbol-backed opaque identifier (not a numeric alias) per operator
// 2026-05-27 modeling decision — avoids the hollow-alias trap at the
// domain level.
type TaskId {
  identity: Symbol
}

// 🟢 coproduct dissolution — TaskManager workflow lifecycle.
type TaskStatus
  = Open
  | InProgress
  | Done

type Task {
  id: TaskId,
  title: String,
  status: TaskStatus
}

// --- Operation arrows -----------------------------------------------------
// The three canonical TaskManager operations. The function's Arrow
// (argument types + return type) is the single authority for the wire
// type; the WireContracts below reference these function identities
// directly via `BindRef.identity` per coordination.dag's `BindRef`
// coincidence with `std/node.dag` A1/K-1 (operator-ratified 2026-05-15).
// No standalone `Symbol` row alias, no parallel `response_type` field.
// Bodies are minimal stand-ins; real handler bodies + persistence land in
// subsequent T-16 slices.

fn create_task(title: String) -> Task {
  Task {
    id: TaskId { identity: task_id_seed },
    title: title,
    status: Open
  }
}

fn update_status(id: TaskId, status: TaskStatus) -> Task {
  Task {
    id: id,
    title: "",
    status: status
  }
}

fn list_tasks() -> FreeMonoid<Task> {
  Empty
}

// Stand-in Symbol seed for `create_task`'s constructed `TaskId`; real id
// minting lands with the persistence slice.
data task_id_seed: Symbol = task_id_seed

// --- Endpoint identities --------------------------------------------------

data rust_backend_endpoint: Symbol = rust_backend_endpoint
data react_frontend_endpoint: Symbol = react_frontend_endpoint

data rust_language: Symbol = rust_language
data typescript_language: Symbol = typescript_language

data react_framework: Symbol = react_framework

// --- Endpoint addresses ---------------------------------------------------
// Minimal `NetworkAddress` instances — host spellings are placeholders; the
// data-model demo cares about authority shape, not reachability. `port:
// Absent` avoids requiring Succ-chain Nat literals for a value the demo
// does not exercise.

data backend_host: UriHost = UriHost {
  spelling: "backend.local",
  grammar: rfc3986_host_abnf
}

data backend_address: NetworkAddress = NetworkAddress {
  authority: UriAuthority {
    userinfo: Absent,
    host: backend_host,
    port: Absent
  }
}

data frontend_host: UriHost = UriHost {
  spelling: "frontend.local",
  grammar: rfc3986_host_abnf
}

data frontend_address: NetworkAddress = NetworkAddress {
  authority: UriAuthority {
    userinfo: Absent,
    host: frontend_host,
    port: Absent
  }
}

// --- DeploymentUnit fragments --------------------------------------------

data backend_endpoint: Endpoint = Endpoint {
  identity: EndpointRef { identity: rust_backend_endpoint },
  address: backend_address,
  language: LanguageRef { identity: rust_language },
  framework: NoFramework
}

data frontend_endpoint: Endpoint = Endpoint {
  identity: EndpointRef { identity: react_frontend_endpoint },
  address: frontend_address,
  language: LanguageRef { identity: typescript_language },
  framework: HostedByFramework { framework: FrameworkRef { identity: react_framework } }
}

// --- Wire contracts (OpenAPI operation facts → coordination WireContract) -
// Operator-ratified routes (TASKS.md T-16): POST /tasks, PATCH /tasks/{id},
// GET /tasks. Method + path_template authority is `OpenApiOperationWireContractFacts`;
// coordination exchange/settlement/consistency derived via openapi morphisms.

data task_manager_http_coordination: OpenApiHttpWireContractFacts = OpenApiHttpWireContractFacts {
  from: EndpointRef { identity: react_frontend_endpoint },
  to: EndpointRef { identity: rust_backend_endpoint },
  http_exchange: OpenApiHttpRequestReplyWitness {},
  http_settlement: OpenApiHttpImmediateSettlementWitness {},
  http_consistency: OpenApiHttpNoReplicaConvergenceWitness {}
}

data create_task_path_template: OpenApiPathTemplateKey = OpenApiPathTemplateKey {
  after_slash: "/tasks"
}

data update_status_path_template: OpenApiPathTemplateKey = OpenApiPathTemplateKey {
  after_slash: "/tasks/{id}"
}

data list_tasks_path_template: OpenApiPathTemplateKey = OpenApiPathTemplateKey {
  after_slash: "/tasks"
}

data create_task_openapi_facts: OpenApiOperationWireContractFacts = OpenApiOperationWireContractFacts {
  coordination: task_manager_http_coordination,
  admitted_method: OpenApiPost,
  path_template: create_task_path_template
}

data update_status_openapi_facts: OpenApiOperationWireContractFacts = OpenApiOperationWireContractFacts {
  coordination: task_manager_http_coordination,
  admitted_method: OpenApiPatch,
  path_template: update_status_path_template
}

data list_tasks_openapi_facts: OpenApiOperationWireContractFacts = OpenApiOperationWireContractFacts {
  coordination: task_manager_http_coordination,
  admitted_method: OpenApiGet,
  path_template: list_tasks_path_template
}

data create_task_contract: WireContract = openapi_operation_wire_contract(
  facts: create_task_openapi_facts,
  bind: BindRef { identity: create_task }
)

data update_status_contract: WireContract = openapi_operation_wire_contract(
  facts: update_status_openapi_facts,
  bind: BindRef { identity: update_status }
)

data list_tasks_contract: WireContract = openapi_operation_wire_contract(
  facts: list_tasks_openapi_facts,
  bind: BindRef { identity: list_tasks }
)

// --- Shape-B canonical route projection -----------------------------------

data create_task_rest_route: RestRoute = rest_route_from_openapi_operation_wire_contract_facts(
  facts: create_task_openapi_facts,
  path_parameters: []
)

data update_status_rest_route: RestRoute = rest_route_from_openapi_operation_wire_contract_facts(
  facts: update_status_openapi_facts,
  path_parameters: ["id"]
)

data list_tasks_rest_route: RestRoute = rest_route_from_openapi_operation_wire_contract_facts(
  facts: list_tasks_openapi_facts,
  path_parameters: []
)

data task_manager_shape_b_routes: List<RestRoute> = [
  create_task_rest_route,
  update_status_rest_route,
  list_tasks_rest_route
]

// --- DeploymentUnit -------------------------------------------------------

data task_manager_deployment: DeploymentUnit = DeploymentUnit {
  endpoints: [backend_endpoint, frontend_endpoint],
  wire_contracts: [create_task_contract, update_status_contract, list_tasks_contract]
}
