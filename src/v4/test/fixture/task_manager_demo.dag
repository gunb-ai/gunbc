// src/v4/test/fixture/task_manager_demo.dag
// Scope: T-16 TaskManager omni-emission demo — data-model-only declaration.
// Status: T-16-A modeled; no emit code; the shared Node tree consumed by
// Shape A (rust backend + react frontend `DeploymentUnit` fragments) and
// Shape B (OpenAPI / SQL / Markdown projections derived from `WireContract`
// + `Task` carriers) lands in subsequent T-16 slices.

module v4.test.fixture.task_manager_demo

import v4.std.algebra { FreeMonoid, Empty }
import v4.std.collection { Absent }
import v4.std.network { NetworkAddress, UriAuthority, UriHost, rfc3986_host_abnf }
import v4.std.text { String }
import v4.std.node { Symbol }
import v4.extdeps.coordination {
  Endpoint, EndpointRef, LanguageRef, FrameworkRef, HostedByFramework, NoFramework,
  WireContract, WireContractFacts, CoordinationBind, BindRef,
  Http, RequestReply, ImmediateSettlement, NoReplicaConvergence,
  DeploymentUnit
}

// --- Domain ---------------------------------------------------------------

// Symbol-backed opaque identifier (not a numeric alias) per operator
// 2026-05-27 modeling decision — avoids the hollow-alias trap at the
// domain level.
type TaskId {
  identity: Symbol
}

// 🟢 coproduct dissolution — TaskManager workflow lifecycle.
type TaskStatus
  = Open
  | InProgress
  | Done

type Task {
  id: TaskId,
  title: String,
  status: TaskStatus
}

// --- Operation arrows -----------------------------------------------------
// The three canonical TaskManager operations. The function's Arrow
// (argument types + return type) is the single authority for the wire
// type; the WireContracts below reference these function identities
// directly via `BindRef.identity` per coordination.dag's `BindRef`
// coincidence with `std/node.dag` A1/K-1 (operator-ratified 2026-05-15).
// No standalone `Symbol` row alias, no parallel `response_type` field.
// Bodies are minimal stand-ins; real handler bodies + persistence land in
// subsequent T-16 slices.

fn create_task(title: String) -> Task {
  Task {
    id: TaskId { identity: task_id_seed },
    title: title,
    status: Open
  }
}

fn update_status(id: TaskId, status: TaskStatus) -> Task {
  Task {
    id: id,
    title: "",
    status: status
  }
}

fn list_tasks() -> FreeMonoid<Task> {
  Empty
}

// Stand-in Symbol seed for `create_task`'s constructed `TaskId`; real id
// minting lands with the persistence slice.
data task_id_seed: Symbol = task_id_seed

// --- Endpoint identities --------------------------------------------------

data rust_backend_endpoint: Symbol = rust_backend_endpoint
data react_frontend_endpoint: Symbol = react_frontend_endpoint

data rust_language: Symbol = rust_language
data typescript_language: Symbol = typescript_language

data react_framework: Symbol = react_framework

// --- Endpoint addresses ---------------------------------------------------
// Minimal `NetworkAddress` instances — host spellings are placeholders; the
// data-model demo cares about authority shape, not reachability. `port:
// Absent` avoids requiring Succ-chain Nat literals for a value the demo
// does not exercise.

data backend_host: UriHost = UriHost {
  spelling: "backend.local",
  grammar: rfc3986_host_abnf
}

data backend_address: NetworkAddress = NetworkAddress {
  authority: UriAuthority {
    userinfo: Absent,
    host: backend_host,
    port: Absent
  }
}

data frontend_host: UriHost = UriHost {
  spelling: "frontend.local",
  grammar: rfc3986_host_abnf
}

data frontend_address: NetworkAddress = NetworkAddress {
  authority: UriAuthority {
    userinfo: Absent,
    host: frontend_host,
    port: Absent
  }
}

// --- DeploymentUnit fragments --------------------------------------------

data backend_endpoint: Endpoint = Endpoint {
  identity: EndpointRef { identity: rust_backend_endpoint },
  address: backend_address,
  language: LanguageRef { identity: rust_language },
  framework: NoFramework
}

data frontend_endpoint: Endpoint = Endpoint {
  identity: EndpointRef { identity: react_frontend_endpoint },
  address: frontend_address,
  language: LanguageRef { identity: typescript_language },
  framework: HostedByFramework { framework: FrameworkRef { identity: react_framework } }
}

// --- Wire contracts -------------------------------------------------------
// One `WireContract` per TaskManager operation. `BindRef.identity` is the
// function name itself — the Arrow declared above is the single authority
// for argument and response types. `Http` effect facts match
// `coordination_effect_obligation(effect: Http)` — RequestReply /
// ImmediateSettlement / NoReplicaConvergence.

data create_task_facts: WireContractFacts = WireContractFacts {
  from: EndpointRef { identity: react_frontend_endpoint },
  to: EndpointRef { identity: rust_backend_endpoint },
  exchange: RequestReply,
  settlement: ImmediateSettlement,
  consistency: NoReplicaConvergence
}

data create_task_contract: WireContract = WireContract {
  facts: create_task_facts,
  bind: CoordinationBind {
    bind: BindRef { identity: create_task },
    effect: Http
  }
}

data update_status_facts: WireContractFacts = WireContractFacts {
  from: EndpointRef { identity: react_frontend_endpoint },
  to: EndpointRef { identity: rust_backend_endpoint },
  exchange: RequestReply,
  settlement: ImmediateSettlement,
  consistency: NoReplicaConvergence
}

data update_status_contract: WireContract = WireContract {
  facts: update_status_facts,
  bind: CoordinationBind {
    bind: BindRef { identity: update_status },
    effect: Http
  }
}

data list_tasks_facts: WireContractFacts = WireContractFacts {
  from: EndpointRef { identity: react_frontend_endpoint },
  to: EndpointRef { identity: rust_backend_endpoint },
  exchange: RequestReply,
  settlement: ImmediateSettlement,
  consistency: NoReplicaConvergence
}

data list_tasks_contract: WireContract = WireContract {
  facts: list_tasks_facts,
  bind: CoordinationBind {
    bind: BindRef { identity: list_tasks },
    effect: Http
  }
}

// --- DeploymentUnit -------------------------------------------------------

data task_manager_deployment: DeploymentUnit = DeploymentUnit {
  endpoints: [backend_endpoint, frontend_endpoint],
  wire_contracts: [create_task_contract, update_status_contract, list_tasks_contract]
}
