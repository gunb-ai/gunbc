  Unit,
  manual_claim_anchor
}


data dag_ingest_round_trip_fixture_atom: Symbol = dag_ingest_round_trip_fixture_atom
data dag_ingest_round_trip_fixture_field: Symbol = dag_ingest_round_trip_fixture_field


fn dag_ingest_round_trip_fixture_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: dag_ingest_round_trip_fixture_field },
        target: Node {
          kind: TypeNode { connective: Atom { identity: dag_ingest_round_trip_fixture_atom } },
          children: []
        }
      }
    ]
  }
}


data dag_ingest_round_trip_fixture_claim: TestClaim = EqualsClaim {
  label: "fixture: self-contained TestClaim source for T-36",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: dag_ingest_round_trip_fixture_node(),
  rhs: dag_ingest_round_trip_fixture_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
