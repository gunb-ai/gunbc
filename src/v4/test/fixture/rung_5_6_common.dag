// Scope: shared rung 5–6 post-emit algebra-law TestClaim subject + emit-host target wiring.

module v4.test.rung_5_6_common


import v4.compiler.emit_host {
  run_test_claim_emit_vs_eval
}
import v4.extdeps.languages.go { go_mvp1_source_text }
import v4.extdeps.languages.python { python_mvp1_source_text }
import v4.compiler.eval {
  TestClaimRun
}
import v4.std.collection { empty_map }
import v4.std.compilers.lexing { VoidLexRules }
import v4.std.node { Node }
import v4.std.runtime { RuntimeValue }
import v4.std.compilers.target_model { TargetModel }
import v4.std.verification { TestClaim }
import v4.test.rung_3_4_common {
  rung34_emit_host_rust_target_model,
  rung34_emit_host_target_bundle,
  rung34_test_claim_subject
}


data rung56_emit_host_python_target_model: TargetModel = TargetModel {
  bundle: rung34_emit_host_target_bundle,
  lex: VoidLexRules,
  binding_spellings: empty_map(),
  authority_source_text: python_mvp1_source_text
}


data rung56_emit_host_go_target_model: TargetModel = TargetModel {
  bundle: rung34_emit_host_target_bundle,
  lex: VoidLexRules,
  binding_spellings: empty_map(),
  authority_source_text: go_mvp1_source_text
}


fn rung56_emit_vs_eval_run(
  claim: TestClaim,
  fixture_subject: Node,
  target: TargetModel
) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim_emit_vs_eval(
    subject: rung34_test_claim_subject(claim: claim, evaluator_input: fixture_subject),
    target: target
  )
}
