// Scope: end-to-end cross-language matrix claim — the executable form of the N+M-not-N×M thesis.
//   Walks the add slice from Python source through the canonical Node core toward TypeScript. The
// Chain (Python source IN -> TypeScript source OUT):
//   1. Python source text -> ParseTree            (PROVEN: python_mvp1_grammar_parse_fixture, ~627s)
//   4. core -> TS source (cross-language emit)      REALIZED: neutralize_core_for_target rewrites
//                                                    python `int` -> TS `number` via std_projection_additive_numeric
//                                                    before infer -> emit; proven hermetically and on real tree (~627s).
// Links 2-3 are the forward interpreter bridge: it selects the source-model row whose production
// token-spine matches the parse FRONTIER (never trusting the stamped emitted), and grounds it through
// infer/coerce to the canonical core. TWO DISTINCT by-execution proofs, neither over-claimed: the
// per-merge HERMETIC witness `ingest_bridge_realized` (the real bridge fn applied to a discriminating
// fixture — frontier recovery + perturbed-frontier RED + ambiguity/unstamped fail-closed), and the
// HEAVY `…chain_status_holds`, which APPLIES `cross_language_compile` to the REAL live-parsed nested
// python tree (~627s; a documented receipt, NOT per-merge) so it goes RED if bridge or neutralization
// regresses on real python trees.

module v4.test.manual.cross_language_add_python_to_typescript

// Link 1 (Python source -> ParseTree), proven by execution in this module's twin claim. The heavy
// chain_status_holds parses the REAL fixture and flows the tree INTO the bridge (not a disconnected
// conjunct), so it imports the parse fixture itself, not just the accepted-bool.
import v4.test.manual.python_mvp1_grammar_claim {
  python_mvp1_grammar_parse_fixture
}
import v4.test.manual.typescript_effect_io_emit {
  ts_effect_io_emit_holds
}
import v4.test.manual.ingest_bridge {
  ingest_bridge_realized
}
// The bridge fns themselves (v4.compiler.ingest) — applied to the REAL parsed python tree in the
// heavy chain_status_holds (forward selection on the real frontier) and the real-tree discrimination.
import v4.std.algebra { Cons, Empty }
import v4.compiler.ingest {
  cross_language_compile,
  parse_tree_to_emitted_node,
  parse_tree_to_target_model_bridge
}
// Link 4 cross-language neutralization probe (emit the python core to TS).
import v4.compiler.infer { infer }
import v4.std.inhabitant_neutralization { neutralize_core_for_target }
import v4.compiler.emit { emit }
import v4.extdeps.languages.python {
  python_mvp1_emitted_add_fn_node,
  python_mvp1_target_model
}
import v4.extdeps.languages.typescript { ts_mvp1_target_model }

import v4.std.grammar { ParseTree }
import v4.std.logic { Bool }
import v4.std.node { Symbol }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Rejected,
  Unavailable,
  port_locus
}
import v4.std.witness { Holds, Violates, Witness }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  Unit,
  UnifiedTestClaim,
  manual_claim_anchor
}

// ─────────────────────────────────────────────────────────────────────────────
// `ParseTreeToTargetModelBridge` is the structural fact: "the ParseTree produced by parsing
// <source> can be carried to the emit-side core node that <target>'s TargetModel serializes."
// v4.compiler.ingest.parse_tree_to_target_model_bridge realizes it by FRONTIER-keyed forward
// selection (the parse token-spine selects the source-model row; the stamped emitted is never
// trusted). The witness Holds when the bridge fn is realized — proven hermetically (real bridge
// applied, sub-second) by `ingest_bridge_realized` (recovery + canonical IR + perturbed-frontier
// RED + ambiguity/unstamped fail-closed). When the bridge is NOT realized it falls back to
// fail-closed at the named reason `parse_tree_to_target_model_bridge_not_realized`, so a regression
// is named, not hidden. The REAL nested python->ts instance is the documented 627s by-execution
// receipt `cross_language_add_python_to_typescript_chain_status_holds`.
// ─────────────────────────────────────────────────────────────────────────────

type ParseTreeToTargetModelBridge {
  source_parse_tree: Symbol
  intended_target_language: Symbol
}

type ParseTreeToTargetModelBridgeCheck = Witness<ParseTreeToTargetModelBridge>

data parse_tree_to_target_model_bridge_not_realized: Symbol = parse_tree_to_target_model_bridge_not_realized
data cross_language_bridge_port: Symbol = cross_language_bridge_port

// Honest, BOUND label for what the per-merge typed check actually covers: the bridge fn is realized,
// proven on the hermetic DISCRIMINATING fixture in ingest_bridge.dag (frontier recovery + perturbed-
// frontier RED + fail-closed) — NOT the real nested python tree, which the heavy `…chain_status_holds`
// applies the bridge to by execution (~627s). Replaces the prior unbound `^cross_language_python_add_
// parse_tree` decorative atom that misleadingly named a real python parse tree never fed to the bridge.
data ingest_bridge_hermetic_fixture_parse_tree: Symbol = ingest_bridge_hermetic_fixture_parse_tree

// Named regression guard: un-neutralized cross-language emit still fails closed — the python add
// core carries python `int` while TS rows key on `number`, so infer→emit(target: ts) rejects without
// neutralize_core_for_target. The generic combinator exists (std/inhabitant_neutralization.dag;
// hermetic receipt: inhabitant_neutralization_emit_after_neutralize_holds) and is wired into
// cross_language_compile. Verified: emit(python add core, target: ts) -> Rejected;
// neutralize→emit -> Accepted (hermetic); cross_language_compile -> Accepted (heavy e2e).
data cross_language_emit_inhabitant_neutralization_not_realized: Symbol = cross_language_emit_inhabitant_neutralization_not_realized

// Named break point for the go cell: go's grammar validates but its add-fn parse
// production currently rejects (go_mvp1_grammar_validates_fixture=true,
// go_mvp1_grammar_parse_accepted=false, both by execution). This is a distinct,
// upstream-of-the-bridge gap — reported, not hidden.
data go_add_parse_production_currently_rejects: Symbol = go_add_parse_production_currently_rejects

// Holds iff the forward interpreter is realized — proven HERMETICALLY (real bridge applied,
// sub-second) by `ingest_bridge_realized`: frontier recovery + canonical IR + perturbed-frontier
// RED + ambiguity/unstamped fail-closed. If the bridge regresses, this falls back to fail-closed at
// the named reason `parse_tree_to_target_model_bridge_not_realized`, so a break is named, not hidden.
// Returns the concrete Witness so call sites can destructure it. (The v2 interpreter resolves
// Holds/Violates on the applied `Witness<T>`, not through a type alias of it — hence the concrete
// return type; the ParseTreeToTargetModelBridgeCheck alias names the same shape at construction-only
// sites, mirroring self_host.dag's *Check aliases.)
// No parameters: the per-merge check is the hermetic-fixture REALIZATION of the bridge fn (the real
// nested python->ts instance is the heavy `…chain_status_holds`). The value records the honest,
// bound fixture label and the matrix target language — they describe the check's identity, they are
// not a real parse tree fed to the bridge.
fn parse_tree_to_target_model_bridge_scaffold() -> Witness<ParseTreeToTargetModelBridge> {
  if ingest_bridge_realized() {
    Holds {
      value: ParseTreeToTargetModelBridge {
        source_parse_tree: ingest_bridge_hermetic_fixture_parse_tree,
        intended_target_language: ^typescript
      }
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: parse_tree_to_target_model_bridge_not_realized,
        at: port_locus(port: cross_language_bridge_port),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

// Construction-only named check object (the alias is the documented public name).
data cross_language_python_to_typescript_bridge_check: ParseTreeToTargetModelBridgeCheck = parse_tree_to_target_model_bridge_scaffold()

test fn parse_tree_to_target_model_bridge_realized() -> Bool {
  match parse_tree_to_target_model_bridge_scaffold() {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}

// The fail-closed gap is now CLOSED: realized bridge => no Violates => false. Kept (flipped from
// true) so any regression that un-realizes the bridge re-trips this to true — the named-gap guard.
fn parse_tree_to_target_model_bridge_fails_closed() -> Bool {
  match parse_tree_to_target_model_bridge_scaffold() {
    Violates { diagnostic: d } => d.reason == parse_tree_to_target_model_bridge_not_realized
    Holds { value: _ } => false
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Un-neutralized cross-language emit fails closed — HERMETIC (no parse). Regression guard: the
// python add core emits to PYTHON (same-language) but NOT to TypeScript without
// neutralize_core_for_target. Does NOT contradict inhabitant_neutralization_emit_after_neutralize_holds.
// ─────────────────────────────────────────────────────────────────────────────
fn cross_language_emit_inhabitant_neutralization_fails_closed() -> Bool {
  match infer(tree: python_mvp1_emitted_add_fn_node()) {
    Accepted { value: inferred, diagnostics: _ } =>
      match emit(tree: inferred, target: ts_mvp1_target_model()) {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Hermetic witness: neutralize + infer + emit accepts python add core to TS target.
fn cross_language_emit_inhabitant_neutralization_holds() -> Bool {
  match neutralize_core_for_target(
    core: python_mvp1_emitted_add_fn_node(),
    target: ts_mvp1_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: ts_mvp1_target_model()) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// Composed end-to-end status witness — HEAVY (real parse), slow-lane only, NOT BoolWitnessed.
// This is the genuine end-to-end DISCRIMINATING receipt: the REAL python source parses (link 1, ~627s)
// and the resulting ParseTree FLOWS INTO cross_language_compile (links 2-4): bridge forward-selects on
// the REAL frontier, neutralize rewrites inhabitants, infer + emit produce TS source. The bridge
// recovery is also checked independently (recovered core == expected python add core). Link 5 is the
// TS real-IO receipt path. ChainProven for python→ts matrix cell. Per-merge FAST protection is the
// HERMETIC `ingest_bridge_realized` (+ `parse_tree_to_target_model_bridge_realized` +
// `cross_language_emit_inhabitant_neutralization_holds`), NOT this heavy chain.
// ─────────────────────────────────────────────────────────────────────────────
fn cross_language_add_python_to_typescript_chain_status_holds() -> Bool {
  // Link 1: Python source -> ParseTree (REAL live parse, ~627s).
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: python_parse_tree, diagnostics: _ } =>
      // Links 2-3: bridge recovers correct core on real tree (discrimination).
      match parse_tree_to_target_model_bridge(
        parse_tree: python_parse_tree,
        source_model: python_mvp1_target_model()
      ) {
        Accepted { value: python_core, diagnostics: _ } =>
          python_core == python_mvp1_emitted_add_fn_node()
            // Link 4: full cross_language_compile on real tree (bridge + neutralize + infer + emit).
            && cross_language_compile_on_real_tree_holds(parse_tree: python_parse_tree)
            && ts_effect_io_emit_holds()
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn cross_language_compile_on_real_tree_holds(parse_tree: ParseTree) -> Bool {
  match cross_language_compile(
    parse_tree: parse_tree,
    source_model: python_mvp1_target_model(),
    target_model: ts_mvp1_target_model()
  ) {
    Accepted { value: ts_source, diagnostics: _ } =>
      match ts_source {
        Cons { head: _, tail: _ } => true
        Empty => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Discrimination on the REAL tree (heavy, slow-lane): the SAME real parsed python tree, forward-
// selected against a source model whose rows do NOT carry the python token-spine (ts_mvp1_target_model),
// matches no row -> fail closed. Proves the recovery is FRONTIER-DRIVEN on the real nested tree (not
// fixture-only, not a constant): holding the tree fixed and perturbing the row table away from its
// frontier flips the selection red. Mirrors ingest_bridge.dag's off-frontier discrimination, here on
// the real parsed tree.
fn cross_language_chain_discriminates_on_real_tree() -> Bool {
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: python_parse_tree, diagnostics: _ } =>
      match parse_tree_to_emitted_node(
        parse_tree: python_parse_tree,
        source_model: ts_mvp1_target_model()
      ) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// The matrix shape — (source_language, target_language) cells as claim data.
//   ChainProven                 — full source->core->target chain proven by execution.
//   ChainFailsClosedAtCheck     — chain breaks at one named typed check (no shim).
//   ChainSourceNotModeled       — the source-language parse direction is not modeled yet.
// This is data, not a doc: a List<CrossLanguageEmitMatrixRow> the corpus can iterate.
// Per-cell status reflects what is proven by execution in this repo today.
// ─────────────────────────────────────────────────────────────────────────────

type CrossLanguageEmitCellStatus
  = ChainProven
  | ChainFailsClosedAtCheck { check: Symbol }
  | ChainSourceNotModeled

type CrossLanguageEmitMatrixRow {
  source_language: Symbol
  target_language: Symbol
  status: CrossLanguageEmitCellStatus
}

data cross_language_emit_matrix: List<CrossLanguageEmitMatrixRow> = [
  // dag -> ts: PROVEN. The source is already the language-neutral core node, so there is
  //   no parse->TargetModel gap; emit serializes it directly. Cert:
  //   mvp1_ts_emit_add_fn_accepts_holds (mvp1_typescript_add_translate.dag, true by execution).
  CrossLanguageEmitMatrixRow {
    source_language: ^dag,
    target_language: ^typescript,
    status: ChainProven {}
  },
  //   Neutralization combinator (std/inhabitant_neutralization.dag) rewrites python `int` -> TS
  //   `number` via std_projection_additive_numeric; cross_language_compile exercises the full
  //   composition on the real parse tree (~627s by-execution receipt in chain_status_holds).
  CrossLanguageEmitMatrixRow {
    source_language: ^python,
    target_language: ^typescript,
    status: ChainProven {}
  },
  // go -> ts: FAILS CLOSED earlier than python — at go's own add-fn parse production,
  //   which currently rejects (validate=true, parse_accepted=false by execution). The
  //   ParseTree->TargetModel bridge is moot for go until link 1 holds. FINDING reported.
  CrossLanguageEmitMatrixRow {
    source_language: ^go,
    target_language: ^typescript,
    status: ChainFailsClosedAtCheck { check: go_add_parse_production_currently_rejects }
  }
]

// ─────────────────────────────────────────────────────────────────────────────
// Claim markers — discoverable by the manual claim corpus.
// ─────────────────────────────────────────────────────────────────────────────

// The realized bridge is itself a verifiable fact: the typed check Holds (was Violates at the named
// reason). This is a Unit claim over the hermetic structural proof (no heavy closure).
fn cross_language_bridge_realized_input(ok: Bool) -> Symbol {
  if ok {
    ^cross_language_bridge_realized
  } else {
    ^cross_language_bridge_not_realized
  }
}

data claim_cross_language_add_python_to_typescript_module_compiles: TestClaim = CompilesClaim {
  label: "manual/cross_language: python->ts add-slice end-to-end matrix claim compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ^ingest_bridge_hermetic_fixture_parse_tree,
  expected_value: ^ingest_bridge_hermetic_fixture_parse_tree,
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_cross_language_parse_tree_bridge_realized: TestClaim = CompilesClaim {
  label: "manual/cross_language: ParseTree->TargetModel bridge realized (#4801) — typed check Holds (was fail-closed)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: cross_language_bridge_realized_input(ok: parse_tree_to_target_model_bridge_realized()),
  expected_value: ^cross_language_bridge_realized,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

// The registered executable witness is the FAST, hermetic assertion this file uniquely composes —
// `parse_tree_to_target_model_bridge_realized` (sub-second): the typed bridge check now Holds,
// driven by `ingest_bridge_realized` (the real bridge fn applied to a hermetic parse tree:
// frontier recovery + canonical IR + perturbed-frontier RED + ambiguity/unstamped fail-closed).
// It is NOT the composed `…chain_status_holds`, which parses the Python source end-to-end
// (`parse_production_tree`, ~627s wall) AND FLOWS that parsed tree INTO cross_language_compile
// (bridge + neutralize + infer + emit), so it would be perturbed-and-re-run by the affected-set
// lens gate (~2x), blowing the per-PR lens-gate time budget. This matches the convention for heavy
// parse fixtures: `python_mvp1_grammar_claim` / `go_mvp1_grammar_claim` likewise do NOT BoolWitness
// their heavy parse fns. The heavy chain proves, BY EXECUTION on the real tree, that the bridge
// recovers the real nested python tree to the correct core AND cross_language_compile produces TS
// source (ChainProven for python→ts matrix cell); the companion
// `cross_language_chain_discriminates_on_real_tree` shows the recovery is frontier-driven
// (off-frontier -> fail closed) on the real tree, not fixture-only. Its executed result is captured