// Scope: complexity-gate S2 — roster-row subject acquisition + canonical body extraction (design §2 steps 1–2).
//        Body extraction uses node_query authority (wraps std.node arrow_body_target_lookup).
// Design: docs/design-lens-subject-supply.md §2.

module v4.test.complexity_gate.lens_subject_body_supply

import v4.std.diagnostic {
  ExternalContractUnknown,
  Outcome,
  Textual,
  Unavailable,
  WholeFile,
  bind_outcome,
  diagnostics_singleton,
  outcome_rejected
}
import v4.std.node { Node, Symbol }
import v4.std.node_query { find_arrow_body_child }
import v4.test.complexity_gate.comprep_wave1_add_subject_producer {
  comprep_source_bridged_add_arrow_with_body
}
import v4.test.complexity_gate.subject_complexity_budget_roster {
  LensSubjectComplexityBudgetRow
}

data lens_subject_producer_unsupported: Symbol = lens_subject_producer_unsupported

data lens_subject_body_supply_virtual_file: Symbol = lens_subject_body_supply_virtual_file

fn lens_subject_arrow_body_for_budget_row(
  row: LensSubjectComplexityBudgetRow
) -> Outcome<Node> {
  if row.subject_producer == comprep_source_bridged_add_arrow_with_body {
    bind_outcome(
      o: comprep_source_bridged_add_arrow_with_body(),
      f: fn(arrow) {
        find_arrow_body_child(root: arrow)
      }
    )
  } else {
    outcome_rejected(
      d: diagnostics_singleton(
        reason: lens_subject_producer_unsupported,
        at: Textual { file: lens_subject_body_supply_virtual_file, extent: WholeFile },
        correction: Unavailable { reason: ExternalContractUnknown }
      )
    )
  }
}
