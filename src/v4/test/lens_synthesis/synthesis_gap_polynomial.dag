
module v4.test.lens_synthesis.synthesis_gap_polynomial

import v4.lens.complexity { ComplexityBound, complexity_lens }
import v4.lens.synthesis {
  DecisionTree,
  SynthesisGap,
  SynthesisNoTechnique,
  SynthesisOptimal,
  assess_decision_tree,
  synthesis_lens
}
import v4.std.algebra { non_empty }
import v4.std.logic { Bool }
import v4.std.witness { Holds, Violates }
import v4.std.node {
  Atom,
  Cardinality,
  ComputationNode,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  SyntheticOccurrence
}
import v4.std.report { SynthesisGapDecisionTree, SynthesisGapInformationTheoretic }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
data synthesis_gap_poly_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_gap_poly_atom_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_poly_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: synthesis_gap_poly_leaf }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_poly_inner: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: synthesis_gap_poly_body }
  ],
  occurrence_id: SyntheticOccurrence
}

// Nested Cardinality → polynomial (O(n^2)) complexity; strictly dominates Θ(n log n) lower bound.
data synthesis_gap_poly_input: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: synthesis_gap_poly_inner }
  ],
  occurrence_id: SyntheticOccurrence
}

data synthesis_gap_poly_sentinel: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_gap_poly_sentinel_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn synthesis_gap_poly_lens_non_empty() -> Bool {
  non_empty(synthesis_lens(n: synthesis_gap_poly_input, declared_technique: DecisionTree))
}

fn synthesis_gap_poly_rhs() -> Node {
  if synthesis_gap_poly_lens_non_empty() {
    synthesis_gap_poly_input
  } else {
    synthesis_gap_poly_sentinel
  }
}

data claim_synthesis_gap_polynomial: TestClaim = EqualsClaim {
  label: "lens_synthesis/synthesis_gap_polynomial: polynomial cost emits non-empty synthesis advisory",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_gap_poly_input,
  rhs: synthesis_gap_poly_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

// Pins the published ReportReason to SynthesisGapDecisionTree.
// Bypasses List<T> to avoid bootstrap generic-T field-access limitation: r.reason fails when r
// is a generic lambda param T even after T=Report is established. Calls assess_decision_tree
// directly so r is bound from a concrete coproduct field (report: Report), not generic T.
fn synthesis_gap_poly_first_reason_node() -> Node {
  match complexity_lens(n: synthesis_gap_poly_input) {
    Violates { diagnostic: _ } => synthesis_gap_poly_sentinel
    Holds { value: realization } =>
      match assess_decision_tree(n: synthesis_gap_poly_input, realization: realization) {
        SynthesisGap { realization_cost: _, lower_bound: _, report: r } =>
          match r.reason {
            SynthesisGapDecisionTree => synthesis_gap_poly_input
            SynthesisGapInformationTheoretic => synthesis_gap_poly_sentinel
          }
        SynthesisOptimal { realization_cost: _, lower_bound: _ } => synthesis_gap_poly_sentinel
        SynthesisNoTechnique { diagnostic: _ } => synthesis_gap_poly_sentinel
      }
  }
}

data claim_synthesis_gap_poly_decision_tree_reason: TestClaim = EqualsClaim {
  label: "lens_synthesis/synthesis_gap_polynomial: report reason is SynthesisGapDecisionTree",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_gap_poly_input,
  rhs: synthesis_gap_poly_first_reason_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
