// src/v4/test/claim/qualified_name/from_node.dag
// Scope: TestClaim rows for qualified_name_from_node structural walking over fold_list_node inputs.
// Owns: claims for empty-list, single-segment, multi-segment, and non-list-node paths.
// Consumes: v4.std.qualified_name v4.std.algebra v4.std.node v4.std.diagnostic v4.std.verification
// Status: T-QN-1 follow-on behavior receipts; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.qualified_name.from_node


import v4.std.algebra { Cons, Empty, fold_list_node, fold_list_node_head, fold_list_node_tail }
import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.qualified_name { QualifiedName, qualified_name_eq, qualified_name_from_node }
import v4.std.logic { Bool }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data qn_sym_a: Symbol = qn_sym_a
data qn_sym_b: Symbol = qn_sym_b
data qn_sym_c: Symbol = qn_sym_c
data qn_bool_true_sym: Symbol = qn_bool_true_sym
data qn_bool_false_sym: Symbol = qn_bool_false_sym


fn qn_sym_node(sym: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: sym } }, children: [] }
}

fn qn_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: qn_bool_true_sym } }, children: [] }
    false => Node { kind: TypeNode { connective: Atom { identity: qn_bool_false_sym } }, children: [] }
  }
}

// TODO(T-22): qn_outcome_accepted is test-local scaffolding — Outcome<T> cannot be compared
// directly in EqualsClaim today. A canonical accepted/rejected claim form for Outcome should
// live in std/verification.dag (or a dedicated test helper) so this pattern doesn't proliferate.
fn qn_outcome_accepted(out: Outcome<QualifiedName>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// TODO(T-22): test-local scaffolding — see qn_outcome_accepted TODO above.
fn qn_value_eq(out: Outcome<QualifiedName>, expected: QualifiedName) -> Bool {
  match out {
    Rejected { diagnostics: _ } => false
    Accepted { value: actual, diagnostics: _ } => qualified_name_eq(a: actual, b: expected)
  }
}


// Non-list node: plain Atom (not a Conj) → Rejected
data qn_atom_node: Node = Node { kind: TypeNode { connective: Atom { identity: qn_sym_a } }, children: [] }

// Empty fold_list_node: Conj with no children → Accepted { value: Empty }
data qn_empty_conj_node: Node = Node { kind: TypeNode { connective: Conj }, children: [] }

// Single-element: fold_list_node([qn_sym_a])
data qn_single_list_node: Node = fold_list_node(
  xs: Cons { head: qn_sym_a, tail: Empty },
  item_node: fn(sym) { qn_sym_node(sym: sym) }
)

// Three-element: fold_list_node([qn_sym_a, qn_sym_b, qn_sym_c])
data qn_three_list_node: Node = fold_list_node(
  xs: Cons { head: qn_sym_a, tail: Cons { head: qn_sym_b, tail: Cons { head: qn_sym_c, tail: Empty } } },
  item_node: fn(sym) { qn_sym_node(sym: sym) }
)

// Malformed Conj: has a tail edge but no head edge → Rejected (non-empty but structurally invalid)
data qn_tail_only_node: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [Edge { label: Named { name: fold_list_node_tail }, target: qn_empty_conj_node }]
}

// Malformed atom segment: Atom node with a spurious child → not a valid leaf segment
data qn_atom_with_children: Node = Node {
  kind: TypeNode { connective: Atom { identity: qn_sym_a } },
  children: [Edge { label: Named { name: qn_sym_b }, target: qn_empty_conj_node }]
}

// fold_list_node with a malformed (non-leaf) head atom → Rejected at segment extraction
data qn_single_malformed_head_node: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: fold_list_node_head }, target: qn_atom_with_children },
    Edge { label: Named { name: fold_list_node_tail }, target: qn_empty_conj_node }
  ]
}


data claim_from_node_non_list_rejected: TestClaim = EqualsClaim {
  label: "qualified_name_from_node returns Rejected for a plain Atom node (not a Conj)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_atom_node))),
  rhs: qn_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_from_node_empty_list_accepted: TestClaim = EqualsClaim {
  label: "qualified_name_from_node returns Accepted { value: Empty } for empty Conj (fold_list_node base case)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_empty_conj_node))),
  rhs: qn_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_from_node_single_accepted: TestClaim = EqualsClaim {
  label: "qualified_name_from_node returns Accepted with [qn_sym_a] for single-element fold_list_node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_value_eq(
    out: qualified_name_from_node(root: qn_single_list_node),
    expected: Cons { head: qn_sym_a, tail: Empty }
  )),
  rhs: qn_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_from_node_multi_accepted: TestClaim = EqualsClaim {
  label: "qualified_name_from_node returns Accepted with [qn_sym_a, qn_sym_b, qn_sym_c] for three-element fold_list_node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_value_eq(
    out: qualified_name_from_node(root: qn_three_list_node),
    expected: Cons { head: qn_sym_a, tail: Cons { head: qn_sym_b, tail: Cons { head: qn_sym_c, tail: Empty } } }
  )),
  rhs: qn_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_from_node_malformed_conj_rejected: TestClaim = EqualsClaim {
  label: "qualified_name_from_node returns Rejected for Conj with tail-only edge (no head — malformed fold_list_node)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_tail_only_node))),
  rhs: qn_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_from_node_malformed_atom_segment_rejected: TestClaim = EqualsClaim {
  label: "qualified_name_from_node returns Rejected when head segment Atom has non-empty children (malformed segment)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: qn_bool_atom(b: qn_outcome_accepted(out: qualified_name_from_node(root: qn_single_malformed_head_node))),
  rhs: qn_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
