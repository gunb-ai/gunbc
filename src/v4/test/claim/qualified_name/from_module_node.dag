// src/v4/test/claim/qualified_name/from_module_node.dag
// Scope: TestClaim rows for qualified_name_from_module_node — the extdeps/ entry point
//        that resolves dag_surface_module_header_qualified_name before delegating to
//        qualified_name_from_node in std/.
// Owns: claims for module-header node with QN edge → Accepted, missing QN edge → Rejected.
// Consumes: v4.extdeps.languages.dag v4.std.qualified_name v4.std.diagnostic
//           v4.std.node v4.std.verification
// Status: T-QN-1 follow-on behavior receipts; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.qualified_name.from_module_node


import v4.extdeps.languages.dag {
  dag_surface_module_header,
  dag_surface_module_header_qualified_name,
  emit_module_header_emitted_node,
  qualified_name_from_module_node
}
import v4.std.algebra { Cons, Empty, fold_list_node }
import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.qualified_name { QualifiedName }
import v4.std.logic { Bool }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data fmn_sym_a: Symbol = fmn_sym_a
data fmn_sym_b: Symbol = fmn_sym_b
data fmn_bool_true_sym: Symbol = fmn_bool_true_sym
data fmn_bool_false_sym: Symbol = fmn_bool_false_sym


fn fmn_sym_node(sym: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: sym } }, children: [] }
}

fn fmn_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: fmn_bool_true_sym } }, children: [] }
    false => Node { kind: TypeNode { connective: Atom { identity: fmn_bool_false_sym } }, children: [] }
  }
}

// TODO(T-22): test-local scaffolding — see from_node.dag qn_outcome_accepted for the canonical TODO.
fn fmn_outcome_accepted(out: Outcome<QualifiedName>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


// Module header node built via emit_module_header_emitted_node with a two-element QN fold_list_node.
data fmn_qn_node: Node = fold_list_node(
  xs: Cons { head: fmn_sym_a, tail: Cons { head: fmn_sym_b, tail: Empty } },
  item_node: fn(sym) { fmn_sym_node(sym: sym) }
)

data fmn_module_header_node: Node = emit_module_header_emitted_node(qualified_name: fmn_qn_node)

// Node without dag_surface_module_header_qualified_name edge → Rejected.
data fmn_bare_conj_node: Node = Node { kind: TypeNode { connective: Conj }, children: [] }


data claim_from_module_node_accepted: TestClaim = EqualsClaim {
  label: "qualified_name_from_module_node returns Accepted for a well-formed module header emitted node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_outcome_accepted(out: qualified_name_from_module_node(root: fmn_module_header_node))),
  rhs: fmn_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_from_module_node_missing_edge_rejected: TestClaim = EqualsClaim {
  label: "qualified_name_from_module_node returns Rejected when dag_surface_module_header_qualified_name edge is absent",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: fmn_bool_atom(b: fmn_outcome_accepted(out: qualified_name_from_module_node(root: fmn_bare_conj_node))),
  rhs: fmn_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
