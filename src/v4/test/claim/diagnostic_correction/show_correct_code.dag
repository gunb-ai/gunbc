// src/v4/test/claim/diagnostic_correction/show_correct_code.dag
// Scope: End-to-end TestClaim rows proving diagnostics carry suggested correction data.
// Owns: complexity, transport, and ambiguous-boundary diagnostic correction rows.
// Consumes: v4.std.verification v4.std.diagnostic v4.std.node
// Status: T-14 corpus rows; execution deferred to T-22 runner bridge.


module v4.test.claim.diagnostic_correction.show_correct_code


import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  ExternalContractUnknown,
  NodeLocus,
  Outcome,
  Rejected,
  Suggested,
  Unavailable,
  UserInputBoundary,
  diagnostics_singleton
}
import v4.std.node { Edge, Named, Node, Symbol, TypeNode, Atom, Conj }
import v4.std.verification {
  Equals,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  Integration
}


data correction_bad_complexity_symbol: Symbol = correction_bad_complexity_symbol
data correction_good_complexity_symbol: Symbol = correction_good_complexity_symbol
data correction_drift_client_symbol: Symbol = correction_drift_client_symbol
data correction_drift_server_symbol: Symbol = correction_drift_server_symbol
data correction_shared_contract_symbol: Symbol = correction_shared_contract_symbol
data correction_english_boundary_symbol: Symbol = correction_english_boundary_symbol
data correction_complexity_reason: Symbol = correction_complexity_reason
data correction_transport_reason: Symbol = correction_transport_reason
data correction_ambiguous_boundary_reason: Symbol = correction_ambiguous_boundary_reason
data correction_left: Symbol = correction_left
data correction_right: Symbol = correction_right


fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [] }
}


fn pair_node(left: Symbol, right: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: correction_left }, target: atom_node(s: left) },
      Edge { label: Named { name: correction_right }, target: atom_node(s: right) },
    ]
  }
}


data complexity_correction_input: Node = pair_node(left: correction_bad_complexity_symbol, right: correction_good_complexity_symbol)


data complexity_correction_expected_node: Node = atom_node(s: correction_good_complexity_symbol)


data falsification_complexity_diagnostic_without_correct_code: Node = complexity_correction_input


data transport_correction_input: Node = pair_node(left: correction_drift_client_symbol, right: correction_drift_server_symbol)


data transport_correction_expected_node: Node = atom_node(s: correction_shared_contract_symbol)


data falsification_transport_diagnostic_without_correct_code: Node = transport_correction_input


data falsification_ambiguous_boundary_without_unavailable_reason: Node = atom_node(s: correction_english_boundary_symbol)


data claim_complexity_diagnostic_suggests_correct_code: TestClaim = TestClaim {
  kind: Equals,
  label: "complexity diagnostic suggests structurally correct replacement",
  t19_anchor: T19ManualAnchorAbsent,
  input: falsification_complexity_diagnostic_without_correct_code,
  expected: Rejected {
    diagnostics: diagnostics_singleton(
      d: Diagnostic {
        reason: correction_complexity_reason,
        at: NodeLocus { node: falsification_complexity_diagnostic_without_correct_code },
        correction: Suggested { node: complexity_correction_expected_node }
      }
    )
  },
  classification: TestClassification { tier: Tier3, layer: Integration }
}


data claim_transport_diagnostic_suggests_shared_contract: TestClaim = TestClaim {
  kind: Equals,
  label: "transport diagnostic suggests shared declaration replacement",
  t19_anchor: T19ManualAnchorAbsent,
  input: falsification_transport_diagnostic_without_correct_code,
  expected: Rejected {
    diagnostics: diagnostics_singleton(
      d: Diagnostic {
        reason: correction_transport_reason,
        at: NodeLocus { node: falsification_transport_diagnostic_without_correct_code },
        correction: Suggested { node: transport_correction_expected_node }
      }
    )
  },
  classification: TestClassification { tier: Tier3, layer: Integration }
}


data claim_ambiguous_boundary_diagnostic_names_no_correction_reason: TestClaim = TestClaim {
  kind: Equals,
  label: "ambiguous boundary diagnostic carries explicit unavailable correction reason",
  t19_anchor: T19ManualAnchorAbsent,
  input: falsification_ambiguous_boundary_without_unavailable_reason,
  expected: Rejected {
    diagnostics: diagnostics_singleton(
      d: Diagnostic {
        reason: correction_ambiguous_boundary_reason,
        at: NodeLocus { node: falsification_ambiguous_boundary_without_unavailable_reason },
        correction: Unavailable { reason: AmbiguousIntent }
      }
    )
  },
  classification: TestClassification { tier: Tier3, layer: Integration }
}
