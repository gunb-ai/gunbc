// src/v4/test/claim/lens_testgen/generator_provenance.dag
// Scope: F.2-P1 testgen provenance — every scheduled Generator carries consistent
// provenance (generator_id keys its emitted TestClaimArtifact) and profile metadata.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.
// Status: activated — structural EqualsClaim + green witness over the provenance integrity fn.

module v4.test.claim.lens_testgen.generator_provenance

import v4.lens.testgen { scheduled_generators_carry_provenance }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClassification,
  TestClaim,
  Tier1,
  Unit,
  manual_claim_anchor,
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
fn lens_testgen_generator_provenance_marker_node(marker: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: marker } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}


fn lens_testgen_generator_provenance_rhs() -> Node {
  if scheduled_generators_carry_provenance() {
    lens_testgen_generator_provenance_marker_node(marker: ^lens_testgen_generator_provenance_ok)
  } else {
    lens_testgen_generator_provenance_marker_node(marker: ^lens_testgen_generator_provenance_failed)
  }
}


data claim_lens_testgen_scheduled_generators_carry_provenance: TestClaim = EqualsClaim {
  label: "lens_testgen/generator_provenance: scheduled generators carry consistent provenance + profile metadata",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: lens_testgen_generator_provenance_marker_node(marker: ^lens_testgen_generator_provenance_ok),
  rhs: lens_testgen_generator_provenance_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


test data witness_lens_testgen_scheduled_generators_carry_provenance_green: Bool = scheduled_generators_carry_provenance()

// Consolidation #4553 Phase 2 distributed BoolWitnessClaim marker.
// Co-located with `witness_lens_testgen_scheduled_generators_carry_provenance_green` so glob discovery finds the witness without the central roster.