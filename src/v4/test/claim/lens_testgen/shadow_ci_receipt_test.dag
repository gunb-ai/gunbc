// src/v4/test/claim/lens_testgen/shadow_ci_receipt.dag
// Scope: F.2-P2 / F.2.6 — T-38 witness pins for scheduled-generator roster + TestgenRunReceipt.
// W4 fold-delete: witness_lens_testgen_shadow_ci_run_receipt_green promoted to v4_roster_pilot
// (mutation-proven claim-run; retires the smoke string-ratchet slice).

module v4.test.claim.lens_testgen.shadow_ci_receipt

import v4.lens.testgen {
  testgen_run_receipt_outcome,
  testgen_run_receipt_carries_profile_roster
}
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClassification,
  TestClaim,
  Tier1,
  Unit,
  manual_claim_anchor,
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
fn lens_testgen_shadow_ci_marker_node(marker: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: marker } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn lens_testgen_shadow_ci_run_receipt_holds() -> Bool {
  match testgen_run_receipt_outcome(profile_ref: ^testgen_default_profile_ref) {
    Accepted { value: receipt, diagnostics: _ } =>
      testgen_run_receipt_carries_profile_roster(receipt: receipt)
    Rejected { diagnostics: _ } => false
  }
}

fn lens_testgen_shadow_ci_rhs() -> Node {
  if lens_testgen_shadow_ci_run_receipt_holds() {
    lens_testgen_shadow_ci_marker_node(marker: ^lens_testgen_shadow_ci_ok)
  } else {
    lens_testgen_shadow_ci_marker_node(marker: ^lens_testgen_shadow_ci_failed)
  }
}

data claim_lens_testgen_shadow_ci_run_receipt: TestClaim = EqualsClaim {
  label: "lens_testgen/shadow_ci_receipt: TestgenRunReceipt carries profile-selected scheduled generators",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: lens_testgen_shadow_ci_marker_node(marker: ^lens_testgen_shadow_ci_ok),
  rhs: lens_testgen_shadow_ci_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

test data witness_lens_testgen_shadow_ci_run_receipt_green: Bool = lens_testgen_shadow_ci_run_receipt_holds()

// Consolidation #4553 Phase 2 distributed BoolWitnessClaim marker.
// Co-located with `witness_lens_testgen_shadow_ci_run_receipt_green` so glob discovery finds the witness without the central roster.