// src/v4/test/claim/boundary/english_ingest_fail_closed.dag
//
// Scope: TestClaim — the English boundary-honesty probe (T-4.11). English
//        is NOT a language model (natural language has no formal grammar
//        — ratified fork). It is a boundary-honesty probe with
//        two demonstrable wins:
//          (a) Shape B emit: a `.dag` program walking typed values →
//              English prose (this is the existing T-16 Markdown/docs
//              artifact; no new substrate).
//          (b) the honest win: pointing `ingest` at arbitrary English
//              prose produces a PRECISE Diagnostic — never a fabricated
//              parse. This is the no-engine / no-fallback thesis made
//              visible: the architecture refusing to lie IS the result.
// Anchor: THESIS no-fallback + C5 (ingest = emit⁻¹ on the lossless core;
//         outside it ⇒ fail-closed Diagnostic) + feedback_no_engine
// Prerequisites (sequencing — NOT parallel to an unfilled verification
//   scaffold): concrete TestClaim payloads in this file bind
//   to the closed schema in std/verification.dag. That file is T-3
//   Wave-A2 work (needs algebra + diagnostic per TASKS.md T-3 ordering).
//   English (T-4.11) is intentionally sequenced *behind* verification.dag
//   fill — cite verification.dag as schema authority only after T-3 lands
//   it; do not list it as peer "Consumes" substrate while the scaffold is
//   empty.
//
// Status: T-4.11 corpus rows; execution deferred to T-22 runner bridge.
// Brief: see BRIEF_TEMPLATE.md.

module v4.test.claim.boundary.english_ingest_fail_closed


import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v4.std.node { Edge, Named, Node, Symbol, TypeNode, Atom, Conj, substrate_synthetic_occurrence_id }
import v4.std.verification {
  CompilesClaim,
  DiagnosticClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier3,
  Boundary,
  manual_claim_anchor
}
fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [],
 occurrence_id: substrate_synthetic_occurrence_id
}
}


data arbitrary_english_prose_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^english_boundary_field },
      target: atom_node(s: ^english_ingest_boundary_symbol)
    },
    Edge {
      label: Named { name: ^english_payload_field },
      target: atom_node(s: ^english_arbitrary_prose_symbol)
    },
  ],
  occurrence_id: substrate_synthetic_occurrence_id
}


data english_shape_b_docs_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^english_typed_value_field },
      target: atom_node(s: ^english_typed_value_symbol)
    },
    Edge {
      label: Named { name: ^english_walker_field },
      target: atom_node(s: ^english_doc_walker_symbol)
    },
  ],
  occurrence_id: substrate_synthetic_occurrence_id
}


data english_shape_b_docs_output: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^english_typed_value_field },
      target: atom_node(s: ^english_typed_value_symbol)
    },
    Edge {
      label: Named { name: ^english_output_field },
      target: atom_node(s: ^english_prose_output_symbol)
    },
  ],
  occurrence_id: substrate_synthetic_occurrence_id
}


data test_english_prose_ingest_is_diagnostic: TestClaim = DiagnosticClaim {
  label: "english prose ingest rejects outside the lossless core",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: arbitrary_english_prose_input,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: ^english_ingest_not_in_lossless_core_reason,
        at: node_locus(node: arbitrary_english_prose_input),
        correction: Unavailable { reason: AmbiguousIntent }
      }
    ),
  classification: TestClassification { tier: Tier3, layer: Boundary }
}


data test_english_emit_is_shapeB_docs: TestClaim = CompilesClaim {
  label: "english prose output is shape-b docs over typed values",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: english_shape_b_docs_input,
  expected_value: english_shape_b_docs_output,
  classification: TestClassification { tier: Tier3, layer: Boundary }
}
