// src/v4/test/claim/lens_fact_density/hollow_alias_no_fact.dag
// Scope: T-30 worked claim — hollow type alias records NoFact.
// Owns: hollow_alias_no_fact_claim.
// Consumes: lens fact_density, std node.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_fact_density.hollow_alias_no_fact

import v4.lens.fact_density { NoFact, SourceSpecReadFact, carrier_spec_fact }
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }

data hollow_alias_no_fact_file: Symbol = hollow_alias_no_fact_file
data hollow_alias_no_fact_reason: Symbol = hollow_alias_no_fact_reason
data hollow_alias_int32_symbol: Symbol = hollow_alias_int32_symbol

type LensFactDensityClaim {
  input: Node
  expected: SourceSpecReadFact
  falsification: Diagnostic
}

data hollow_alias_input: Node = Node {
  kind: TypeNode { connective: Atom { identity: hollow_alias_int32_symbol } },
  children: []
}

data hollow_alias_no_fact_claim: LensFactDensityClaim = LensFactDensityClaim {
  input: hollow_alias_input,
  expected: NoFact,
  falsification: Diagnostic {
    reason: hollow_alias_no_fact_reason,
    at: Textual { file: hollow_alias_no_fact_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn hollow_alias_no_fact_claim_holds() -> Bool {
  carrier_spec_fact(carrier: hollow_alias_no_fact_claim.input) == hollow_alias_no_fact_claim.expected
}

data hollow_alias_no_fact_claim_passes: Bool = hollow_alias_no_fact_claim_holds()
