// src/v4/test/claim/lens_fact_density/hollow_alias_blocked_via_always_required_lenses.dag
// Scope: T-30 enforcement gate claim — always_required_lenses() (the list validate_then_compile prepends) blocks a hollow alias carrier.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_fact_density.hollow_alias_blocked_via_always_required_lenses

import v4.compiler.compile {
  always_required_lenses,
  run_required_lens_gates
}
import v4.compiler.infer { InferredTree }

import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode, Unanchored }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}
data hollow_alias_ar_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^hollow_alias_ar_subject } },
  children: [],
  span: Unanchored
}

data hollow_alias_ar_authority: Node = claim_atom_node(s: ^hollow_alias_ar_symbol)

fn hollow_alias_ar_tree() -> InferredTree {
  claim_inferred_tree(
    root: hollow_alias_ar_root,
    facts: claim_inferred_facts(
      type_symbol: ^hollow_alias_ar_type_sym,
      algebra_symbol: ^hollow_alias_ar_algebra_sym,
      descent_symbol: ^hollow_alias_ar_descent_sym
    )
  )
}

fn hollow_alias_blocked_via_always_required_lenses_holds() -> Bool {
  match run_required_lens_gates(
    inferred: hollow_alias_ar_tree(),
    lenses: always_required_lenses()
  ) {
    Rejected { diagnostics: r } => r.head.reason == ^fact_density_hollow_alias_locus
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn hollow_alias_blocked_via_always_required_lenses_rhs() -> Node {
  if hollow_alias_blocked_via_always_required_lenses_holds() {
    hollow_alias_ar_authority
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      span: Unanchored
}
  }
}

data claim_hollow_alias_blocked_via_always_required_lenses: TestClaim = EqualsClaim {
  label: "lens_fact_density/hollow_alias_blocked_via_always_required_lenses: always_required_lenses() (wired into validate_then_compile) blocks hollow alias",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: hollow_alias_ar_authority,
  rhs: hollow_alias_blocked_via_always_required_lenses_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
