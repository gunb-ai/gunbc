// src/v4/test/claim/lens_fact_density/fact_bundle_named.dag
// Scope: T-30 worked claim — conj with named fields records NamedFieldFacts density.
// Owns: fact_bundle_named_claim.
// Consumes: lens fact_density, std cardinality, std nat, std node.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_fact_density.fact_bundle_named

import v4.lens.fact_density { NamedFieldFacts, SourceSpecReadFact, carrier_spec_fact }
import v4.std.cardinality { NonZeroNat }
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v4.std.logic { Bool }
import v4.std.nat { Succ, Zero }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode
}

data fact_bundle_named_file: Symbol = fact_bundle_named_file
data fact_bundle_named_reason: Symbol = fact_bundle_named_reason
data fact_bundle_alias_symbol: Symbol = fact_bundle_alias_symbol
data fact_bundle_width_field: Symbol = fact_bundle_width_field
data fact_bundle_signedness_field: Symbol = fact_bundle_signedness_field

type LensFactDensityClaim {
  input: Node
  expected: SourceSpecReadFact
  falsification: Diagnostic
}

data fact_bundle_alias: Node = Node {
  kind: TypeNode { connective: Atom { identity: fact_bundle_alias_symbol } },
  children: []
}

data fact_bundle_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: fact_bundle_width_field },
      target: fact_bundle_alias
    },
    Edge {
      label: Named { name: fact_bundle_signedness_field },
      target: fact_bundle_alias
    }
  ]
}

data fact_bundle_named_claim: LensFactDensityClaim = LensFactDensityClaim {
  input: fact_bundle_input,
  expected: NamedFieldFacts { density: NonZeroNat { prev: Succ { prev: Zero } } },
  falsification: Diagnostic {
    reason: fact_bundle_named_reason,
    at: Textual { file: fact_bundle_named_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn fact_bundle_named_claim_holds() -> Bool {
  carrier_spec_fact(carrier: fact_bundle_named_claim.input) == fact_bundle_named_claim.expected
}

data fact_bundle_named_claim_passes: Bool = fact_bundle_named_claim_holds()
