// SG-COLLECTION-PROJECTION receipt: FreeMonoid<T> projects through the
// TargetCollectionRealization row, with SG-RC binding ownership applied to
// element storage.

module v4.test.claim.manual.sg_collection_projection

import v4.compiler.translate {
  project_type_expression_node,
  target_serialize_source_from_model
}
import v4.extdeps.languages.rust {
  rust_sg2_type_expr_target_model,
  rust_type_expression_projection
}
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Edge, Instantiation, Node, Positional, Symbol, TypeNode }
import v4.std.target_model {
  target_carrier_node_node,
  target_collection_free_monoid_carrier_node
}
import v4.std.text { String }
import v4.std.verification {
  Boundary,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  manual_claim_anchor
}

data sg_collection_pass_sym: Symbol = sg_collection_pass_sym
data sg_collection_fail_sym: Symbol = sg_collection_fail_sym
data sg_collection_fail_text: String = ""
data sg_collection_expected_vec_rc_node: String = "Vec<Rc<Node>>"

fn sg_collection_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sg_collection_pass_sym } },
    children: []
  }
}

fn sg_collection_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sg_collection_fail_sym } },
    children: []
  }
}

fn sg_collection_claim_input(ok: Bool) -> Node {
  if ok {
    sg_collection_pass_node()
  } else {
    sg_collection_fail_node()
  }
}

fn sg_collection_free_monoid_node_source_type() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge { label: Positional, target: target_collection_free_monoid_carrier_node() },
      Edge { label: Positional, target: target_carrier_node_node() }
    ]
  }
}

fn sg_collection_projected_type() -> Node {
  match project_type_expression_node(
    node: sg_collection_free_monoid_node_source_type(),
    target: rust_sg2_type_expr_target_model(),
    projection: rust_type_expression_projection()
  ) {
    Accepted { value: projected, diagnostics: _ } => projected
    Rejected { diagnostics: _ } => sg_collection_fail_node()
  }
}

fn sg_collection_serialized_type_text(emitted: Node) -> String {
  match target_serialize_source_from_model(
    target: rust_sg2_type_expr_target_model(),
    emitted: emitted
  ) {
    Accepted { value: source, diagnostics: _ } => source
    Rejected { diagnostics: _ } => sg_collection_fail_text
  }
}

fn sg_collection_free_monoid_vec_rc_projection_holds() -> Bool {
  sg_collection_serialized_type_text(emitted: sg_collection_projected_type()) ==
    sg_collection_expected_vec_rc_node
}

data claim_sg_collection_free_monoid_vec_rc_projection: TestClaim = EqualsClaim {
  label: "manual/sg-collection: FreeMonoid<Node> projects to Vec<Rc<Node>>",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: sg_collection_claim_input(ok: sg_collection_free_monoid_vec_rc_projection_holds()),
  rhs: sg_collection_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
