// src/v4/test/claim/manual/python_mvp1_grammar_claim.dag
// Scope: T-4.17 wave-2a behavior receipt — python MVP-1 grammar validates and parse_production accepts the declared token sequence.
// Owns: claim_python_mvp1_grammar_validates, claim_python_mvp1_grammar_parses_mvp_tokens.
// Consumes: v4.compiler.parse, v4.compiler.tokenize, v4.extdeps.languages.python, v4.std.*.
// Status: T-22 runner deferred — execution pending T-22 complexity fix.

module v4.test.claim.manual.python_mvp1_grammar_claim

import v4.compiler.parse {
  grammar_validate_for_parse,
  parse_production,
  parse_stage_locus_port
}
import v4.compiler.tokenize { tokenize }
import v4.extdeps.languages.python {
  python_mvp1_parse_fixture_file,
  python_mvp1_source_text,
  python_production_mvp1_fn_add,
  python_wave1_grammar_root,
  python_wave1_lex
}
import v4.std.diagnostic { Accepted, Outcome, Rejected, port_locus }
import v4.std.grammar { ParseTree }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.logic { Bool }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data python_claim_bool_true: Symbol = python_claim_bool_true
data python_claim_bool_false: Symbol = python_claim_bool_false
fn python_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: python_claim_bool_true } }, children: [] }
    false => Node { kind: TypeNode { connective: Atom { identity: python_claim_bool_false } }, children: [] }
  }
}

fn python_mvp1_grammar_validates_fixture() -> Bool {
  let at = port_locus(port: parse_stage_locus_port)
  match grammar_validate_for_parse(root: python_wave1_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn python_mvp1_grammar_parse_accepted() -> Bool {
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn python_mvp1_grammar_parse_fixture() -> Outcome<ParseTree> {
  let at = port_locus(port: parse_stage_locus_port)
  match tokenize(
    text: python_mvp1_source_text,
    file: python_mvp1_parse_fixture_file,
    rules: python_wave1_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: stream, diagnostics: _ } =>
      match grammar_validate_for_parse(root: python_wave1_grammar_root(), at: at) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: validated, diagnostics: _ } =>
          parse_production(
            tokens: stream.tokens,
            validated: validated,
            production_name: python_production_mvp1_fn_add
          )
      }
  }
}

data claim_python_mvp1_grammar_validates: TestClaim = EqualsClaim {
  label: "python_wave1_grammar_root passes grammar_validate_for_parse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_claim_bool_atom(b: python_mvp1_grammar_validates_fixture()),
  rhs: python_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_python_mvp1_grammar_parses_mvp_tokens: TestClaim = EqualsClaim {
  label: "python MVP-1 production parse_production accepts lexer output for def-add source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_claim_bool_atom(b: python_mvp1_grammar_parse_accepted()),
  rhs: python_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
