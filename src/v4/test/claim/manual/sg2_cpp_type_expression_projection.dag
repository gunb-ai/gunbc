}

data claim_cpp_sg2_disj_projection_structural: TestClaim = EqualsClaim {
  label: "manual/sg2_cpp: Disj sum projects to golden variant emitted node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: cpp_sg2_project_disj_emitted(),
  rhs: cpp_sg2_sum_xy_emitted(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_cpp_sg2_disj_serialize: TestClaim = CompilesClaim {
  label: "manual/sg2_cpp: serialized disj sum is X | Y",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
