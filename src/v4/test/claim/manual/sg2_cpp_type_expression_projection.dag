  label: "manual/sg2_cpp: Conj product projects to golden record emitted node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: cpp_sg2_project_conj_emitted(),
  rhs: cpp_sg2_conj_xy_emitted(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_cpp_sg2_conj_serialize: TestClaim = CompilesClaim {
  label: "manual/sg2_cpp: serialized conj record is { X: X, Y: Y }",
