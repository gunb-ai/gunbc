// src/v4/test/claim/manual/structured_body_subsumption_set.dag
// Scope: completes the byte-identical SUBSUMPTION LICENSING SET for the normalize-to-dispatch
// dissolution (node://adhoc-87678e9b-420). The add witness lives in structured_body_dispatch.dag;
// this file adds pick/loop/bind so all FOUR flat-index body tables
// (produce_mvp1_{add,pick_if,loop,bind}_*_from_resolved) have a proof that the dormant dispatch
// surface produce_arrow_with_structured_body(signature, structured_body) reconstructs the table's
// EXACT target Arrow, byte-identical. That complete set is the durable hand-off: it LICENSES the
// future deletion of all four tables as a safe mechanical step (subsume-before-delete) for whoever
// resumes the dissolution. NOTE: the pipeline is NOT rewired and the tables are NOT deleted here —
// the surface stays additive + dormant; this is the licensing receipt only.
// Status: unit-tier by-execution TestClaim (no pipeline; reuses dag.dag MVP1 fixtures).

module v4.test.claim.manual.structured_body_subsumption_set

import v4.std.node {
  Arrow,
  Atom,
  Edge,
  Node,
  Positional,
  TypeNode,
  node_synthetic
}
import v4.compiler.body_producer { produce_arrow_with_structured_body }
import v4.extdeps.languages.dag {
  dag_mvp1_bind_arrow_with_body_node,
  dag_mvp1_bind_let_body_node,
  dag_mvp1_loop_arrow_with_body_node,
  dag_mvp1_loop_body_node,
  dag_mvp1_pick_arrow_domain_conj_node,
  dag_mvp1_pick_arrow_with_body_node,
  dag_mvp1_pick_if_body_node,
  dag_mvp1_type_atom_node
}
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn subsumption_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^subsumption_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^subsumption_fail } },
      children: []
    )
  }
}

// The Int×Int → Int signature shared by the pick/loop/bind fixtures (their with_body Arrows all use
// dag_mvp1_pick_arrow_domain_conj_node + two Int positional codomain slots). Built via node_synthetic
// so occurrence_id == SyntheticOccurrence, matching the fixtures byte-for-byte; the surface's attach
// appends the body edge, reconstructing the fixture's full child list.
fn mvp1_int_pair_arrow_signature() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: dag_mvp1_pick_arrow_domain_conj_node() },
      Edge { label: Positional, target: dag_mvp1_type_atom_node(identity: ^dag_binding_type_int) },
      Edge { label: Positional, target: dag_mvp1_type_atom_node(identity: ^dag_binding_type_int) }
    ]
  )
}

fn subsumes(structured_body: Node, table_target: Node) -> Bool {
  match produce_arrow_with_structured_body(
    signature: mvp1_int_pair_arrow_signature(),
    structured_body: structured_body
  ) {
    Accepted { value: arrow_with_body, diagnostics: _ } => arrow_with_body == table_target
    Rejected { diagnostics: _ } => false
  }
}

// pick (if c then t else e → Branch[c,t,e]): surface reconstructs the pick table's target Arrow.
fn subsumption_pick() -> Bool {
  subsumes(structured_body: dag_mvp1_pick_if_body_node(), table_target: dag_mvp1_pick_arrow_with_body_node())
}

// loop → Loop: surface reconstructs the loop table's target Arrow.
fn subsumption_loop() -> Bool {
  subsumes(structured_body: dag_mvp1_loop_body_node(), table_target: dag_mvp1_loop_arrow_with_body_node())
}

// bind (let) → Bind: surface reconstructs the bind table's target Arrow.
fn subsumption_bind() -> Bool {
  subsumes(structured_body: dag_mvp1_bind_let_body_node(), table_target: dag_mvp1_bind_arrow_with_body_node())
}

data claim_subsumption_pick: TestClaim = EqualsClaim {
  label: "manual/subsumption-set: dispatch surface subsumes the pick_if flat-index table (byte-identical Arrow)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: subsumption_bool_node(pass: subsumption_pick()),
  rhs: subsumption_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_subsumption_loop: TestClaim = EqualsClaim {
  label: "manual/subsumption-set: dispatch surface subsumes the loop flat-index table (byte-identical Arrow)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: subsumption_bool_node(pass: subsumption_loop()),
  rhs: subsumption_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_subsumption_bind: TestClaim = EqualsClaim {
  label: "manual/subsumption-set: dispatch surface subsumes the bind flat-index table (byte-identical Arrow)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: subsumption_bool_node(pass: subsumption_bind()),
  rhs: subsumption_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
