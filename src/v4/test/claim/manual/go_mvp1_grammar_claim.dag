// src/v4/test/claim/manual/go_mvp1_grammar_claim.dag
// Scope: T-4.17 wave-2a behavior receipt — Go MVP-1 grammar validates and parse_production accepts the declared token sequence.
// Owns: claim_go_mvp1_grammar_validates, claim_go_mvp1_grammar_parses_mvp_tokens.
// Consumes: v4.compiler.parse, v4.extdeps.languages.go, v4.std.*.
// Status: T-22 runner deferred — execution pending T-22 complexity fix.

module v4.test.claim.manual.go_mvp1_grammar_claim

import v4.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree,
  parse_stage_locus_port
}
import v4.compiler.tokenize { tokenize }
import v4.extdeps.languages.go {
  go_mvp1_source_text,
  go_wave1_grammar_root,
  go_wave1_lex
}
import v4.std.diagnostic { Accepted, Outcome, Rejected, port_locus }
import v4.std.grammar { ParseTree }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
fn go_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^go_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^go_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

// 🟡 predicate dissolution — feature:T-22-outcome-to-bool-claim-bridge — bind gunbc#4757 (re-anchor of deleted TASKS.md T-22) —
// dissolve-on: T-22 claim runner evaluates Outcome fixtures directly without Bool projection.
fn go_mvp1_grammar_validates_fixture() -> Bool {
  let at = port_locus(port: parse_stage_locus_port)
  match grammar_validate_for_parse(root: go_wave1_grammar_root(), at: at) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// 🟡 predicate dissolution — feature:T-22-outcome-to-bool-claim-bridge — bind gunbc#4757 (re-anchor of deleted TASKS.md T-22) —
// dissolve-on: T-22 claim runner evaluates Outcome<ParseTree> directly without Bool projection.
fn go_mvp1_grammar_parse_accepted() -> Bool {
  match go_mvp1_grammar_parse_fixture() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn go_mvp1_grammar_parse_fixture() -> Outcome<ParseTree> {
  let at = port_locus(port: parse_stage_locus_port)
  match tokenize(
    text: go_mvp1_source_text,
    file: ^go_mvp1_parse_fixture_file,
    rules: go_wave1_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: stream, diagnostics: _ } =>
      match grammar_validate_for_parse(root: go_wave1_grammar_root(), at: at) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: validated, diagnostics: _ } =>
          parse_production_tree(
            tokens: stream.tokens,
            validated: validated,
            production_name: ^go_production_mvp1_fn_add
          )
      }
  }
}

data claim_go_mvp1_grammar_validates: TestClaim = EqualsClaim {
  label: "go_wave1_grammar_root passes grammar_validate_for_parse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_claim_bool_atom(b: go_mvp1_grammar_validates_fixture()),
  rhs: go_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_go_mvp1_grammar_parses_mvp_tokens: TestClaim = EqualsClaim {
  label: "go MVP-1 production parse_production accepts lexer output for func-add source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: go_claim_bool_atom(b: go_mvp1_grammar_parse_accepted()),
  rhs: go_claim_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
