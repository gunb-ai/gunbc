// Scope: by-execution receipt for the structured-Behavior dispatch surface in
// compiler/03_body_producer.dag (body_producer_dispatch_structured_body /
// produce_arrow_with_structured_body) — slice (ii) of the normalize-to-dispatch dissolution
// (node://adhoc-87678e9b-420). Proves the ONE surface validates an already-structured Behavior
// body keyed on the Behavior coproduct (Transform call AND Branch control-flow, not add-special-
// cased), refuses a non-Behavior residual parse node, and — the subsumption witness — produces
// output byte-identical to the existing add flat-index table's target Arrow.
// Status: unit-tier by-execution TestClaim (no pipeline; reuses dag.dag MVP1 fixtures).

module v4.test.claim.manual.structured_body_dispatch

import v4.std.node {
  Atom,
  Node,
  TypeNode,
  node_synthetic,
  well_formed
}
import v4.compiler.body_producer {
  body_producer_dispatch_structured_body,
  produce_arrow_with_structured_body
}
import v4.std.node_query { find_arrow_body_child }
import v4.extdeps.languages.dag {
  dag_mvp1_add_arrow_signature_node,
  dag_mvp1_add_arrow_with_body_node,
  dag_mvp1_add_binary_body_node,
  dag_mvp1_pick_arrow_with_body_fixture
}
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn structured_body_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^structured_body_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^structured_body_fail } },
      children: []
    )
  }
}

// A residual (non-Behavior) parse node — the malformed-normalize case the surface must refuse.
fn structured_body_non_behavior_node() -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: ^structured_body_residual } },
    children: []
  )
}

// The pick (if) body is a Branch Behavior; extract it from the fully-attached pick fixture so the
// surface is exercised on a control-flow variant, not just the add Transform call.
fn structured_body_pick_branch_body() -> Node {
  match find_arrow_body_child(root: dag_mvp1_pick_arrow_with_body_fixture) {
    Accepted { value: body, diagnostics: _ } => body
    Rejected { diagnostics: _ } => structured_body_non_behavior_node()
  }
}

// The add (x+y) body is a Transform call: Transform[+, x, y] — callee-ref child[0].
fn structured_body_dispatch_accepts_transform_call() -> Bool {
  match body_producer_dispatch_structured_body(body: dag_mvp1_add_binary_body_node()) {
    Accepted { value: validated, diagnostics: _ } => validated == dag_mvp1_add_binary_body_node()
    Rejected { diagnostics: _ } => false
  }
}

fn structured_body_dispatch_accepts_branch() -> Bool {
  let branch = structured_body_pick_branch_body()
  match body_producer_dispatch_structured_body(body: branch) {
    Accepted { value: validated, diagnostics: _ } => validated == branch
    Rejected { diagnostics: _ } => false
  }
}

fn structured_body_dispatch_rejects_non_behavior() -> Bool {
  match body_producer_dispatch_structured_body(body: structured_body_non_behavior_node()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

// Subsumption witness: producing add from the signature + structured body yields exactly the
// Arrow the existing add flat-index table targets (dag_mvp1_add_arrow_with_body_node).
fn structured_body_produce_subsumes_add_table() -> Bool {
  match produce_arrow_with_structured_body(
    signature: dag_mvp1_add_arrow_signature_node(),
    structured_body: dag_mvp1_add_binary_body_node()
  ) {
    Accepted { value: arrow_with_body, diagnostics: _ } =>
      arrow_with_body == dag_mvp1_add_arrow_with_body_node()
        && well_formed(n: arrow_with_body)
    Rejected { diagnostics: _ } => false
  }
}

data claim_structured_body_dispatch_accepts_transform_call: TestClaim = EqualsClaim {
  label: "manual/structured-body: dispatch accepts an add Transform call body, returns it",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: structured_body_bool_node(pass: structured_body_dispatch_accepts_transform_call()),
  rhs: structured_body_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_structured_body_dispatch_accepts_branch: TestClaim = EqualsClaim {
  label: "manual/structured-body: dispatch accepts a pick Branch control-flow body (variant-general)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: structured_body_bool_node(pass: structured_body_dispatch_accepts_branch()),
  rhs: structured_body_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_structured_body_dispatch_rejects_non_behavior: TestClaim = EqualsClaim {
  label: "manual/structured-body: dispatch refuses a non-Behavior residual parse node",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: structured_body_bool_node(pass: structured_body_dispatch_rejects_non_behavior()),
  rhs: structured_body_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_structured_body_produce_subsumes_add_table: TestClaim = EqualsClaim {
  label: "manual/structured-body: produce_arrow_with_structured_body subsumes the add flat-index table (byte-identical Arrow)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: structured_body_bool_node(pass: structured_body_produce_subsumes_add_table()),
  rhs: structured_body_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
