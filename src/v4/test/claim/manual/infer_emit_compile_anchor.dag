// src/v4/test/claim/manual/infer_emit_compile_anchor.dag
// Scope: Tier-1 v2-compile anchor for T-9/T-10 interface freeze — `infer`/`emit`/`compile` Wave-1 boundary.
// Owns: anchor_stub_empty_conj, anchor_stub_target_model, anchor_stub_source, anchor_stub_ranking_symbol, anchor_stub_algebra_ref, anchor_stub_ranking_dim, anchor_stub_termination_proof, anchor_stub_inferred_facts, anchor_stub_empty_facts_map, anchor_stub_inferred_tree, anchor_facts_map_lookup_not_realized, anchor_infer_rejects, anchor_emit_rejects, anchor_compile_rejects.
// Consumes: compiler/04_infer.dag, compiler/05_emit.dag, compiler/00_compile.dag, std/algebra.dag, std/cardinality.dag, std/collection.dag, std/diagnostic.dag, std/node.dag, std/witness.dag.
// Status: scaffold — compile-only until T-22.
// Anchor: https://en.wikipedia.org/wiki/Compiler


module v4.test.claim.manual.infer_emit_compile_anchor


import v4.compiler.compile { Source, TargetModel, TargetSource, compile }
import v4.compiler.emit { emit }
import v4.compiler.infer {
  AlgebraRef,
  InferredFacts,
  InferredTree,
  infer
}
import v4.std.algebra { Empty }
import v4.std.cardinality { RankingDimension, TerminationProof }
import v4.std.collection { Map }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  PortLocus,
  Unavailable
}
import v4.std.node { Conj, Node, Symbol, TypeNode }
import v4.std.witness { Violates, Witness }


data anchor_stub_empty_conj: Node = Node {
  kind: TypeNode { connective: Conj },
  children: []
}


data anchor_stub_target_model: TargetModel = anchor_stub_empty_conj


data anchor_stub_source: Source = Empty


data anchor_stub_ranking_symbol: Symbol = anchor_stub_ranking_symbol


data anchor_stub_algebra_ref: AlgebraRef = AlgebraRef {
  algebra: anchor_stub_empty_conj,
  witness: anchor_stub_empty_conj
}


data anchor_stub_ranking_dim: RankingDimension = RankingDimension {
  measured: anchor_stub_ranking_symbol
}


data anchor_stub_termination_proof: TerminationProof = TerminationProof {
  non_increasing: [],
  strict: anchor_stub_ranking_dim
}


data anchor_facts_map_lookup_not_realized: Symbol = anchor_facts_map_lookup_not_realized


data anchor_stub_inferred_facts: InferredFacts = InferredFacts {
  resolved_type: anchor_stub_empty_conj,
  inhabits: anchor_stub_algebra_ref,
  descent: anchor_stub_termination_proof
}


data anchor_stub_empty_facts_map: Map<Node, InferredFacts> = Map {
  lookup: fn(_) {
    Violates {
      diagnostic: Diagnostic {
        reason: anchor_facts_map_lookup_not_realized,
        at: PortLocus { port: anchor_facts_map_lookup_not_realized },
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}


data anchor_stub_inferred_tree: InferredTree = InferredTree {
  root: anchor_stub_empty_conj,
  facts: anchor_stub_empty_facts_map
}


fn anchor_infer_rejects() -> Outcome<InferredTree> {
  infer(tree: anchor_stub_empty_conj)
}


fn anchor_emit_rejects() -> Outcome<TargetSource> {
  emit(tree: anchor_stub_inferred_tree, target: anchor_stub_target_model)
}


fn anchor_compile_rejects() -> Outcome<TargetSource> {
  compile(source: anchor_stub_source, target: anchor_stub_target_model)
}
