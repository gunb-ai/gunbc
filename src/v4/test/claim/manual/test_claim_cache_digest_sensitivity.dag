// src/v4/test/claim/manual/test_claim_cache_digest_sensitivity.dag
// Scope: T-22 cache receipt — interpretation_hash distinguishes facts diagnostics and Node evaluator_input.
// Status: CompilesClaim receipts; execution deferred until T-22 runner subsumes manual rows.

module v4.test.claim.manual.test_claim_cache_digest_sensitivity

import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  test_claim_cache_interpretation_hash_node,
  test_claim_claim_hash_digest,
  test_claim_typed_input_node
}
import v4.compiler.infer { InferredTree }
import v4.extdeps.runtimes.v4_evaluator { v4_evaluator_interpretation_wave1 }
import v4.test.claim.lens_common.infer_fixture { claim_atom_node }
import v4.std.collection { Map }
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v4.std.node { Atom, Hash, Node, Symbol, TypeNode }
import v4.std.verification {
  CompilesClaim,
  DiagnosticClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Violates }

data tcc_cache_root_sym: Symbol = tcc_cache_root_sym
data tcc_cache_eval_a_sym: Symbol = tcc_cache_eval_a_sym
data tcc_cache_eval_b_sym: Symbol = tcc_cache_eval_b_sym
data tcc_cache_facts_diag_a: Symbol = tcc_cache_facts_diag_a
data tcc_cache_facts_diag_b: Symbol = tcc_cache_facts_diag_b
data tcc_cache_expected_diag_a: Symbol = tcc_cache_expected_diag_a
data tcc_cache_expected_diag_b: Symbol = tcc_cache_expected_diag_b
data tcc_cache_interpretation_pin: Symbol = tcc_cache_interpretation_pin
data tcc_cache_evaluator_pin: Symbol = tcc_cache_evaluator_pin
data tcc_cache_pass_sym: Symbol = tcc_cache_pass_sym
data tcc_cache_fail_sym: Symbol = tcc_cache_fail_sym

fn tcc_cache_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: tcc_cache_pass_sym } },
    children: []
  }
}

fn tcc_cache_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: tcc_cache_fail_sym } },
    children: []
  }
}

fn tcc_cache_root() -> Node {
  claim_atom_node(s: tcc_cache_root_sym)
}

fn tcc_cache_eval_node_a() -> Node {
  claim_atom_node(s: tcc_cache_eval_a_sym)
}

fn tcc_cache_eval_node_b() -> Node {
  claim_atom_node(s: tcc_cache_eval_b_sym)
}

fn tcc_cache_facts_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: tcc_cache_root()),
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn tcc_cache_tree_facts_violates(reason: Symbol) -> InferredTree {
  InferredTree {
    root: tcc_cache_root(),
    facts: Map {
      lookup: fn(_) {
        Violates { diagnostic: tcc_cache_facts_diagnostic(reason: reason) }
      }
    }
  }
}

fn tcc_cache_eval_context() -> EvalContext {
  EvalContext {
    interpretation: v4_evaluator_interpretation_wave1(),
    interpretation_pin: tcc_cache_interpretation_pin
  }
}

fn tcc_cache_stub_claim() -> TestClaim {
  CompilesClaim {
    label: "manual/test_claim_cache: digest sensitivity scaffold",
    anchor: ManualAnchorAbsent,
    classification: TestClassification { tier: Tier1, unit: Unit },
    input: tcc_cache_pass_node(),
    expected_value: tcc_cache_pass_node()
  }
}

fn tcc_cache_subject(
  tree: InferredTree,
  evaluator_input: Node
) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: tcc_cache_stub_claim(),
    context: tcc_cache_eval_context(),
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: evaluator_input,
      evaluator_pin: tcc_cache_evaluator_pin
    )
  }
}

fn tcc_cache_facts_diagnostic_digest_differs() -> Bool {
  let tree_a = tcc_cache_tree_facts_violates(reason: tcc_cache_facts_diag_a)
  let tree_b = tcc_cache_tree_facts_violates(reason: tcc_cache_facts_diag_b)
  let hash_a = test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree_a, evaluator_input: tcc_cache_eval_node_a())
  )
  let hash_b = test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree_b, evaluator_input: tcc_cache_eval_node_a())
  )
  hash_a != hash_b
}

fn tcc_cache_diagnostic_claim(expected_reason: Symbol) -> TestClaim {
  DiagnosticClaim {
    label: "manual/test_claim_cache: diagnostic claim hash scaffold",
    anchor: ManualAnchorAbsent,
    classification: TestClassification { tier: Tier1, unit: Unit },
    input: tcc_cache_root(),
    expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: expected_reason,
        at: node_locus(node: tcc_cache_root()),
        correction: Unavailable { reason: AmbiguousIntent }
      }
    )
  }
}

fn tcc_cache_diagnostic_reason_claim_hash_differs() -> Bool {
  test_claim_claim_hash_digest(c: tcc_cache_diagnostic_claim(expected_reason: tcc_cache_expected_diag_a)) !=
    test_claim_claim_hash_digest(c: tcc_cache_diagnostic_claim(expected_reason: tcc_cache_expected_diag_b))
}

fn tcc_cache_evaluator_input_digest_differs() -> Bool {
  let tree = tcc_cache_tree_facts_violates(reason: tcc_cache_facts_diag_a)
  let hash_a = test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree, evaluator_input: tcc_cache_eval_node_a())
  )
  let hash_b = test_claim_cache_interpretation_hash_node(
    subject: tcc_cache_subject(tree: tree, evaluator_input: tcc_cache_eval_node_b())
  )
  hash_a != hash_b
}

fn tcc_cache_sensitivity_claim_input(ok: Bool) -> Node {
  if ok {
    tcc_cache_pass_node()
  } else {
    tcc_cache_fail_node()
  }
}

data claim_test_claim_cache_facts_diagnostic_digest_differs: TestClaim = CompilesClaim {
  label: "manual/test_claim_cache: same root, distinct facts diagnostics yield distinct interpretation_hash",
  anchor: ManualAnchorAbsent,
  classification: TestClassification { tier: Tier1, unit: Unit },
  input: tcc_cache_sensitivity_claim_input(ok: tcc_cache_facts_diagnostic_digest_differs()),
  expected_value: tcc_cache_pass_node()
}

data claim_test_claim_cache_evaluator_input_digest_differs: TestClaim = CompilesClaim {
  label: "manual/test_claim_cache: Node evaluator_input content_hash participates in interpretation_hash",
  anchor: ManualAnchorAbsent,
  classification: TestClassification { tier: Tier1, unit: Unit },
  input: tcc_cache_sensitivity_claim_input(ok: tcc_cache_evaluator_input_digest_differs()),
  expected_value: tcc_cache_pass_node()
}

data claim_test_claim_cache_diagnostic_reason_claim_hash_differs: TestClaim = CompilesClaim {
  label: "manual/test_claim_cache: DiagnosticClaim expected reason participates in claim_hash",
  anchor: ManualAnchorAbsent,
  classification: TestClassification { tier: Tier1, unit: Unit },
  input: tcc_cache_sensitivity_claim_input(ok: tcc_cache_diagnostic_reason_claim_hash_differs()),
  expected_value: tcc_cache_pass_node()
}
