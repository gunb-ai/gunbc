// src/v4/test/claim/manual/infer_bounded_lattice_completeness_anchor.dag
// Scope: SG-6 falsification probe — BoundedLattice instance completeness gate in 04_infer.
// Status: compile-only anchor; execution deferred to T-22 runner bridge.


module v4.test.claim.manual.infer_bounded_lattice_completeness_anchor


import v4.compiler.infer {
  InferredTree,
  infer,
  infer_bounded_lattice_consumer_gate,
  infer_bounded_lattice_instance_gate,
  partial_bounded_lattice_instances_in_tree
}
import v4.std.algebra {
  BoundedLatticeComplete,
  BoundedLatticePartial,
  MissingMeet,
  NotBoundedLatticeInstance,
  bounded_lattice_field_bottom,
  bounded_lattice_field_lattice,
  bounded_lattice_field_top,
  bounded_lattice_instance_completeness,
  lattice_field_join,
  lattice_field_meet,
  length
}
import v4.std.diagnostic { Outcome, Rejected }
import v4.std.node { Atom, Arrow, Conj, Edge, Named, Node, Symbol, TypeNode }


data anchor_meet_sym: Symbol = anchor_meet_sym
data anchor_join_sym: Symbol = anchor_join_sym
data anchor_top_sym: Symbol = anchor_top_sym
data anchor_bottom_sym: Symbol = anchor_bottom_sym
data anchor_partial_decl_sym: Symbol = anchor_partial_decl_sym
data anchor_consumer_decl_sym: Symbol = anchor_consumer_decl_sym


fn anchor_atom_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


fn anchor_fn_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: []
  }
}


fn anchor_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}


fn anchor_complete_lattice_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      anchor_named_edge(name: lattice_field_meet, target: anchor_fn_node()),
      anchor_named_edge(name: lattice_field_join, target: anchor_fn_node())
    ]
  }
}


fn anchor_lattice_missing_meet_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      anchor_named_edge(name: lattice_field_join, target: anchor_fn_node())
    ]
  }
}


data anchor_complete_bounded_lattice_instance: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(name: bounded_lattice_field_lattice, target: anchor_complete_lattice_node()),
    anchor_named_edge(name: bounded_lattice_field_top, target: anchor_atom_node(s: anchor_top_sym)),
    anchor_named_edge(name: bounded_lattice_field_bottom, target: anchor_atom_node(s: anchor_bottom_sym))
  ]
}


data anchor_partial_bounded_lattice_instance: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(name: bounded_lattice_field_lattice, target: anchor_lattice_missing_meet_node()),
    anchor_named_edge(name: bounded_lattice_field_top, target: anchor_atom_node(s: anchor_top_sym)),
    anchor_named_edge(name: bounded_lattice_field_bottom, target: anchor_atom_node(s: anchor_bottom_sym))
  ]
}


data anchor_consumer_of_partial: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(
      name: anchor_meet_sym,
      target: anchor_partial_bounded_lattice_instance
    )
  ]
}


data anchor_module_with_partial_and_consumer: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    anchor_named_edge(
      name: anchor_partial_decl_sym,
      target: anchor_partial_bounded_lattice_instance
    ),
    anchor_named_edge(
      name: anchor_consumer_decl_sym,
      target: anchor_consumer_of_partial
    )
  ]
}


data anchor_bounded_lattice_completeness_classifies_instances: Bool =
  match bounded_lattice_instance_completeness(instance: anchor_complete_bounded_lattice_instance) {
    BoundedLatticeComplete => true
    _ => false
  }
    && match bounded_lattice_instance_completeness(instance: anchor_partial_bounded_lattice_instance) {
      BoundedLatticePartial { missing: MissingMeet } => true
      _ => false
    }


data anchor_non_bl_node_is_not_complete_variant: Bool =
  match bounded_lattice_instance_completeness(instance: anchor_atom_node(s: anchor_top_sym)) {
    NotBoundedLatticeInstance => true
    BoundedLatticeComplete => false
    BoundedLatticePartial { missing: _ } => false
  }


data anchor_complete_bounded_lattice_completeness_ok: Bool =
  match bounded_lattice_instance_completeness(instance: anchor_complete_bounded_lattice_instance) {
    BoundedLatticeComplete => true
    _ => false
  }


data anchor_partial_bounded_lattice_missing_meet: Bool =
  match bounded_lattice_instance_completeness(instance: anchor_partial_bounded_lattice_instance) {
    BoundedLatticePartial { missing: MissingMeet } => true
    _ => false
  }


data anchor_partials_collected_from_module: Bool =
  length(
    xs: partial_bounded_lattice_instances_in_tree(tree: anchor_module_with_partial_and_consumer)
  ) == 1


data anchor_instance_gate_rejects_partial: Outcome<Node> =
  infer_bounded_lattice_instance_gate(instance: anchor_partial_bounded_lattice_instance)


data anchor_instance_gate_accepts_complete: Outcome<Node> =
  infer_bounded_lattice_instance_gate(instance: anchor_complete_bounded_lattice_instance)


data anchor_consumer_gate_rejects_partial_reference: Outcome<Node> =
  infer_bounded_lattice_consumer_gate(
    consumer: anchor_consumer_of_partial,
    partials: [anchor_partial_bounded_lattice_instance]
  )


data anchor_infer_rejects_consumer_tree: Outcome<InferredTree> =
  infer(tree: anchor_module_with_partial_and_consumer)


fn anchor_infer_consumer_tree_is_rejected() -> Bool {
  match anchor_infer_rejects_consumer_tree {
    Rejected { diagnostics: _ } => true
    _ => false
  }
}


data anchor_infer_consumer_tree_rejects: Bool = anchor_infer_consumer_tree_is_rejected()
