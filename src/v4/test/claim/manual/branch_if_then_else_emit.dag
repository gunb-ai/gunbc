// src/v4/test/claim/manual/branch_if_then_else_emit.dag
// Scope: Bool if-then-else Branch body emit through value-expression tier (.dag target).

module v4.test.claim.manual.branch_if_then_else_emit

import v4.compiler.body_producer {
  produce_mvp1_pick_if_arrow_with_body,
  produce_mvp1_pick_if_arrow_with_body_swapped_arms
}
import v4.compiler.emit { emit }
import v4.compiler.infer { InferredFacts, InferredTree }
import v4.compiler.target_carriers { TargetSource }
import v4.extdeps.languages.dag {
  dag_mvp1_pick_source_text,
  dag_mvp1_pick_target_model
}
import v4.test.claim.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import v4.std.cardinality { termination_proof_witness_for_node }
import v4.std.collection { Map }
import v4.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  bind_outcome
}
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Node,
  TypeNode,
  SyntheticOccurrence
}
import v4.std.compilers.target_model { TargetModel }
import v4.std.witness { Holds, Witness }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

fn branch_if_then_else_emit_i64_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^branch_if_then_else_emit_i64 } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn branch_if_then_else_emit_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Holds {
    value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: branch_if_then_else_emit_i64_node(),
      descent: termination_proof_witness_for_node(n: key)
    )
  }
}

fn branch_if_then_else_emit_inferred_tree_for(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map { lookup: branch_if_then_else_emit_facts_lookup }
  }
}

fn branch_if_then_else_emit_producer_tree() -> Outcome<InferredTree> {
  match produce_mvp1_pick_if_arrow_with_body() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: branch_if_then_else_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn branch_if_then_else_emit_swapped_producer_tree() -> Outcome<InferredTree> {
  match produce_mvp1_pick_if_arrow_with_body_swapped_arms() {
    Accepted { value: root, diagnostics: d } =>
      Accepted {
        value: branch_if_then_else_emit_inferred_tree_for(root: root),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn branch_if_then_else_emit_from_producer(target: TargetModel) -> Outcome<TargetSource> {
  bind_outcome(
    o: branch_if_then_else_emit_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn branch_if_then_else_emit_swapped_from_producer(target: TargetModel) -> Outcome<TargetSource> {
  bind_outcome(
    o: branch_if_then_else_emit_swapped_producer_tree(),
    f: fn(tree) {
      emit(tree: tree, target: target)
    }
  )
}

fn branch_if_then_else_emit_holds() -> Bool {
  match branch_if_then_else_emit_from_producer(target: dag_mvp1_pick_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source == dag_mvp1_pick_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn branch_if_then_else_emit_swapped_arms_discriminates() -> Bool {
  match branch_if_then_else_emit_swapped_from_producer(target: dag_mvp1_pick_target_model()) {
    Accepted { value: source, diagnostics: d } =>
      (source != dag_mvp1_pick_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn branch_if_then_else_emit_keystone_holds() -> Bool {
  branch_if_then_else_emit_holds() && branch_if_then_else_emit_swapped_arms_discriminates()
}

data unified_claim_branch_if_then_else_emit: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/manual/branch_if_then_else_emit.dag",
    function: branch_if_then_else_emit_keystone_holds
  }
}
