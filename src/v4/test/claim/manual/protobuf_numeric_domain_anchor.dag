// src/v4/test/claim/manual/protobuf_numeric_domain_anchor.dag
// Scope: Compile anchors for ProtoFieldNumber vs ProtoEnumValueNumber domains.
// Status: compile-only groundedness testcase.

module v4.test.claim.manual.protobuf_numeric_domain_anchor

import v4.extdeps.formats.protobuf {
  ProtoEnumValueNumber,
  ProtoEnumValueNonZero,
  ProtoEnumValueZero,
  ProtoFieldNumber,
}
import v4.std.cardinality { NonZeroNat }
import v4.std.nat { Succ, Zero }


data protobuf_anchor_field_number_one: ProtoFieldNumber = ProtoFieldNumber {
  value: NonZeroNat { prev: Succ { prev: Zero } },
}


data protobuf_anchor_enum_value_zero: ProtoEnumValueNumber = ProtoEnumValueZero


data protobuf_anchor_enum_value_nonzero: ProtoEnumValueNumber = ProtoEnumValueNonZero {
  value: NonZeroNat { prev: Succ { prev: Zero } },
}
