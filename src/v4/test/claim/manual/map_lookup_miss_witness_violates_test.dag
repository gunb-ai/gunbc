// src/v4/test/claim/manual/map_lookup_miss_witness_violates.dag
// Scope: runtime-completeness regression for the `Map.lookup: fn(K) -> Witness<V>`
//        contract. A native `Value::Map` lookup bottoms out at the Null sentinel on a
//        missing key; the v2 interpreter must present that absent key as `Violates`
//        rather than fall through a `Holds`/`Violates` match non-exhaustively
//        ("non-exhaustive pattern match on: null"). Mirrors the ParseTable miss path
//        (02_parse.dag parse_table_lookup) that surfaced the crash.
// Anchor: composite key forces the std record-form `map_insert` to wrap a native base
//        map, so the miss delegates to the native key-probe (raw_map_lookup -> Null).

module v4.test.claim.manual.map_lookup_miss_witness_violates

import v4.std.collection { Map, empty_map, map_insert }
import v4.std.witness { Holds, Violates, Witness }


import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
type LookupKey {
  id: Int
}

type LookupTable = Map<LookupKey, Int>

// Mirror 02_parse.dag parse_table_lookup: a `-> Witness` annotated wrapper so the
// match sees the Witness contract (the bootstrap typechecker otherwise projects the
// raw `.lookup` result as Option).
fn lookup_table(table: LookupTable, key: LookupKey) -> Witness<Int> {
  table.lookup(key)
}

fn one_entry_table() -> LookupTable {
  map_insert(m: empty_map(), key: LookupKey { id: 1 }, value: 100)
}

// Discriminating: with no Null->Violates bridge the interpreter raises
// `non-exhaustive pattern match on: null` here instead of returning true.
fn map_miss_is_violates() -> Bool {
  match lookup_table(table: one_entry_table(), key: LookupKey { id: 2 }) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

// Control: a present composite key takes the `Holds` arm (record-form wrap), proving
// the witness is not vacuously green.
fn map_hit_is_holds() -> Bool {
  match lookup_table(table: one_entry_table(), key: LookupKey { id: 1 }) {
    Holds { value: v } => v == 100
    Violates { diagnostic: _ } => false
  }
}

// Rostered entry (v4_roster_pilot): one Bool combining the discriminating miss->Violates
// arm with the present-key Holds control, so the v4-testclaim-smoke-roster transport runs
// the regression by EXECUTION (claim-run), not by typecheck. Removing the Null->Violates
// bridge turns the miss arm into a `non-exhaustive pattern match on: null` crash → red.
test fn map_lookup_miss_violates_and_hit_holds() -> Bool {
  map_miss_is_violates() && map_hit_is_holds()
}

// Consolidation #4553 Phase 2 distributed BoolWitnessClaim marker.
// Co-located with `map_lookup_miss_violates_and_hit_holds` so glob discovery finds the witness without the central roster.