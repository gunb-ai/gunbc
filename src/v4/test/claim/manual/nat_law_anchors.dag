// Consumes: v4.std.verification v4.std.diagnostic v4.test.claim.manual.connective_anchors
// Status: v2 compile; classification discipline indexed DECISIONS V-HDR.

module v4.test.claim.manual.nat_law_anchors

import v4.std.verification {
  TestClaim,
  Compiles,
  Equals,
  TestClassification,
  Tier1,
  Unit,
  T19ManualNatAddLeftIdentity,
  T19ManualNatAddRightIdentity,
  T19ManualNatAddAssociativity,
  T19ManualNatMulLeftIdentity,
  T19ManualNatMulAnnihilator,
  T19ManualNatMulAssociativity
}
import v4.std.diagnostic { Produced }
import v4.test.claim.manual.connective_anchors { stub_empty_conj }


data claim_nat_add_left_identity: TestClaim = TestClaim {
  kind: Compiles,
  label: "manual/nat: monoid left identity nat_add(Zero,a)=a (law; eval T-22)",
  t19_anchor: T19ManualNatAddLeftIdentity,
  input: stub_empty_conj,
  expected: Produced { value: stub_empty_conj },
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_nat_add_right_identity: TestClaim = TestClaim {
