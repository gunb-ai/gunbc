  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_nat_add_associativity: TestClaim = TestClaim {
  kind: Compiles,
  label: "manual/nat: monoid associativity nat_add(nat_add(a,b),c)=nat_add(a,nat_add(b,c)) (law; eval T-22)",
