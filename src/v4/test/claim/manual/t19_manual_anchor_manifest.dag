// src/v4/test/claim/manual/t19_manual_anchor_manifest.dag
//
// Scope: T-19 Int-coded projection of the **live** manual `TestClaim` corpus only
//        (`connective_anchors.dag` ∪ `nat_law_anchors.dag`) — one `data` row per
//        claim, no forward-only slots. Integer fields mirror declaration order in
//        `src/v4/std/verification.dag` (`TestgenTier`, `TestgenLayer`, `AssertKind`)
//        and the five testgen arms in `lens/testgen.dag` (`testgen_category` 0…4).
// Anchor: src/v4/TASKS.md §T-19 Phase-1.5
//
// Owns:
//   - `ManualTestgenAnchor` + exactly twelve `data` rows (bijection to the twelve
//     live manual claims). Slugs are stable keys; drift vs claim `kind` /
//     `classification` in the two anchor modules = STOP (same change set).
//
// Consumes:
//   - (none — self-contained; authority for claim shape remains the anchor modules.)
//
// Status: landed 2026-05-16; reconciled 2026-05-17 (P2 single projection vs live corpus).
// Brief: see BRIEF_TEMPLATE.md.

module v4.test.claim.manual.t19_manual_anchor_manifest


type ManualTestgenAnchor {
  slug: String
  tier: Int
  layer: Int
  testgen_category: Int
  assert_kind: Int
}


