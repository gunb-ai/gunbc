// src/v4/test/claim/manual/t19_manual_anchor_manifest.dag
// Scope: Twelve-row membership over `std/verification.dag` `T19ManualAnchorKey` (connective_anchors ∪ nat_law_anchors).
// Owns: twelve `T19ManualAnchorKey` data rows + manifest list (no parallel string table)
// Consumes: v4.std.verification
// Status: P2 join — each row's value equals `TestClaim.t19_anchor` on the paired claim (structural discriminant equality).

module v4.test.claim.manual.t19_manual_anchor_manifest


import v4.std.verification {
  T19ManualAnchorKey,
  T19ManualTcConjEmpty,
  T19ManualTcDisjEmpty,
  T19ManualTcArrowTwoConj,
  T19ManualTcCardinalityEmpty,
  T19ManualTcInstantiationEmpty,
  T19ManualTcConjEqualsRefl,
  T19ManualNatAddLeftIdentity,
  T19ManualNatAddRightIdentity,
  T19ManualNatAddAssociativity,
  T19ManualNatMulLeftIdentity,
  T19ManualNatMulAnnihilator,
  T19ManualNatMulAssociativity
}


data manual_anchor_tc_conj: T19ManualAnchorKey = T19ManualTcConjEmpty


data manual_anchor_tc_disj: T19ManualAnchorKey = T19ManualTcDisjEmpty


data manual_anchor_tc_arrow: T19ManualAnchorKey = T19ManualTcArrowTwoConj


data manual_anchor_tc_cardinality: T19ManualAnchorKey = T19ManualTcCardinalityEmpty


data manual_anchor_tc_instantiation: T19ManualAnchorKey = T19ManualTcInstantiationEmpty


data manual_anchor_tc_conj_equals_refl: T19ManualAnchorKey = T19ManualTcConjEqualsRefl


data manual_anchor_nat_add_left_identity: T19ManualAnchorKey = T19ManualNatAddLeftIdentity


data manual_anchor_nat_add_right_identity: T19ManualAnchorKey = T19ManualNatAddRightIdentity


data manual_anchor_nat_add_associativity: T19ManualAnchorKey = T19ManualNatAddAssociativity


data manual_anchor_nat_mul_left_identity: T19ManualAnchorKey = T19ManualNatMulLeftIdentity


data manual_anchor_nat_mul_annihilator: T19ManualAnchorKey = T19ManualNatMulAnnihilator


data manual_anchor_nat_mul_associativity: T19ManualAnchorKey = T19ManualNatMulAssociativity


data manual_anchor_manifest: List<T19ManualAnchorKey> = [
  manual_anchor_tc_conj,
  manual_anchor_tc_disj,
  manual_anchor_tc_arrow,
  manual_anchor_tc_cardinality,
  manual_anchor_tc_instantiation,
  manual_anchor_tc_conj_equals_refl,
  manual_anchor_nat_add_left_identity,
  manual_anchor_nat_add_right_identity,
  manual_anchor_nat_add_associativity,
  manual_anchor_nat_mul_left_identity,
  manual_anchor_nat_mul_annihilator,
  manual_anchor_nat_mul_associativity
]
