// src/v4/test/claim/manual/fact_density_anchor.dag
// Scope: T-30 v2-bootstrap compile anchor — exercises the fact-density lens read on a hollow alias, a fact-bundle carrier, and a kernel-ambient atom.
// Status: scaffold — compile-only until T-22; lens read pinned in lens/fact_density.dag.
// Anchor: https://github.com/gunb-ai/gunbc/blob/main/src/v4/TASKS.md

module v4.test.claim.manual.fact_density_anchor

import v4.lens.fact_density {
  carrier_spec_fact,
  SourceSpecReadFact
}
import v4.std.node {
  Node,
  TypeNode,
  Atom,
  Conj,
  Edge,
  Named,
  Symbol,
  SyntheticOccurrence
}
data fact_density_anchor_hollow_alias: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^fact_density_anchor_int32_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}
data fact_density_anchor_fact_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^fact_density_anchor_width_field },
      target: fact_density_anchor_hollow_alias
    },
    Edge {
      label: Named { name: ^fact_density_anchor_signedness_field },
      target: fact_density_anchor_hollow_alias
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data fact_density_anchor_kernel_ambient_bool: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^fact_density_kernel_ambient_bool } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn anchor_hollow_alias_read() -> SourceSpecReadFact {
  carrier_spec_fact(carrier: fact_density_anchor_hollow_alias)
}

fn anchor_fact_bundle_read() -> SourceSpecReadFact {
  carrier_spec_fact(carrier: fact_density_anchor_fact_bundle)
}

fn anchor_kernel_ambient_bool_read() -> SourceSpecReadFact {
  carrier_spec_fact(carrier: fact_density_anchor_kernel_ambient_bool)
}
