// src/v4/test/claim/manual/mvp1_dag_pick_round_trip.dag
// Scope: COMPREP wave-2 M0-B1 fan-in (iii) — emit→ingest round-trip on pick if-then-else keystone (.dag target).

module v4.test.claim.manual.mvp1_dag_pick_round_trip

import v4.compiler.emit { emit }
import v4.compiler.infer { InferredFacts, InferredTree }
import v4.compiler.target_carriers { TargetSource }
import v4.compiler.translate {
  coerce_grounded_node,
  grammar_inverse_source_validated,
  target_serialize_source_from_model
}
import v4.extdeps.languages.dag {
  dag_mvp1_fixture_emitted_pick_fn,
  dag_mvp1_pick_target_model
}
import v4.test.claim.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import v4.std.cardinality { termination_proof_witness_for_node }
import v4.std.collection { Map }
import v4.std.coercion { CoercionQuality, Exact, Identity, Widened }
import v4.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected
}
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Node,
  TypeNode,
  SyntheticOccurrence
}
import v4.std.compilers.target_model { TargetModel }
import v4.std.witness { Holds, Witness }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

data mvp1_dag_pick_emitted_root: Node = dag_mvp1_fixture_emitted_pick_fn
data mvp1_dag_pick_target_model: TargetModel = dag_mvp1_pick_target_model()

fn mvp1_dag_pick_i64_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^mvp1_dag_pick_i64 } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn mvp1_dag_pick_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Holds {
    value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: mvp1_dag_pick_i64_node(),
      descent: termination_proof_witness_for_node(n: key)
    )
  }
}

data mvp1_dag_pick_inferred_tree: InferredTree = InferredTree {
  root: mvp1_dag_pick_emitted_root,
  facts: Map {
    lookup: mvp1_dag_pick_facts_lookup
  }
}

fn mvp1_dag_pick_emit_accepts() -> Outcome<TargetSource> {
  emit(tree: mvp1_dag_pick_inferred_tree, target: mvp1_dag_pick_target_model)
}

data mvp1_dag_pick_emit_receipt: Outcome<TargetSource> = mvp1_dag_pick_emit_accepts()

fn mvp1_dag_pick_coercion_quality_is_faithful(q: CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => true
    Widened => false
  }
}

fn mvp1_dag_pick_emit_matches_serialize_holds() -> Bool {
  match target_serialize_source_from_model(
    target: mvp1_dag_pick_target_model,
    emitted: mvp1_dag_pick_emitted_root
  ) {
    Accepted { value: authority, diagnostics: ad } =>
      match mvp1_dag_pick_emit_receipt {
        Accepted { value: source, diagnostics: d } =>
          (source == authority) && (d == None) && (ad == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn mvp1_dag_pick_grammar_inverse_holds() -> Bool {
  match grammar_inverse_source_validated(
    target: mvp1_dag_pick_target_model,
    emitted: mvp1_dag_pick_emitted_root
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn mvp1_dag_pick_ingest_via_coerce_matches_canonical() -> Bool {
  match coerce_grounded_node(
    source: mvp1_dag_pick_emitted_root,
    tree: mvp1_dag_pick_inferred_tree,
    target: mvp1_dag_pick_target_model
  ) {
    Accepted { value: result, diagnostics: d } =>
      (result.target == dag_mvp1_fixture_emitted_pick_fn)
        && mvp1_dag_pick_coercion_quality_is_faithful(q: result.quality)
        && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn mvp1_dag_pick_emit_ingest_round_trip_holds() -> Bool {
  mvp1_dag_pick_emit_matches_serialize_holds()
    && mvp1_dag_pick_grammar_inverse_holds()
    && mvp1_dag_pick_ingest_via_coerce_matches_canonical()
}

data unified_claim_mvp1_dag_pick_round_trip: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/manual/mvp1_dag_pick_round_trip.dag",
    function: mvp1_dag_pick_emit_ingest_round_trip_holds
  }
}
