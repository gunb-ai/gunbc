  ResourceEffectBoundary,
  ValueRepresentationModel
}
import v4.std.verification {
  CompilesClaim,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  t19_manual_claim_anchor
}

type v4_evaluator_anchor_runtime_type = V4EvaluatorRuntime

data v4_evaluator_anchor_runtime: v4_evaluator_anchor_runtime_type = v4_evaluator_runtime_wave1()

data v4_evaluator_anchor_core: ModelCore = v4_evaluator_anchor_runtime.core

data v4_evaluator_anchor_core_standalone: ModelCore = v4_evaluator_model_core_wave1()

data v4_evaluator_anchor_values: ValueRepresentationModel = v4_evaluator_anchor_runtime.values

data v4_evaluator_anchor_values_standalone: ValueRepresentationModel = v4_evaluator_value_representation_wave1()

data v4_evaluator_anchor_interpretation: InterpretationAlgebra = v4_evaluator_anchor_runtime.interpretation

data v4_evaluator_anchor_interpretation_standalone: InterpretationAlgebra = v4_evaluator_interpretation_wave1()

data v4_evaluator_anchor_execution: ExecutionSemantics = v4_evaluator_anchor_runtime.execution

data v4_evaluator_anchor_execution_standalone: ExecutionSemantics = v4_evaluator_execution_wave1()

data v4_evaluator_anchor_boundary: ResourceEffectBoundary = v4_evaluator_anchor_runtime.boundary

data v4_evaluator_anchor_boundary_standalone: ResourceEffectBoundary = v4_evaluator_boundary_wave1()

data witness_v4_evaluator_runtime_identity: Bool =
  v4_evaluator_anchor_runtime.runtime_identity == v4_evaluator_runtime_id

data claim_v4_evaluator_runtime_bundle: TestClaim = CompilesClaim {
  label: "T-34 v4 evaluator concrete runtime bundle constructs and carriers wire",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  input: v4_eval_wave1_unit_type_node(),
  expected_value: v4_eval_wave1_unit_type_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
