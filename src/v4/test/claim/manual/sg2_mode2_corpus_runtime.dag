// src/v4/test/claim/manual/sg2_mode2_corpus_runtime.dag
// Scope: SG-2 mode-2 prep-tier corpus-runtime receipts (T-22 runner execution).
// Status: isolated from sg2_mode2_non_grammar_emit.dag so manual_corpus_roster import does
// not evaluate compile-only predicate data (Map.lookup / target_bundle_child). Compile
// predicates remain in sg2_mode2_non_grammar_emit.dag and are verified by M1 compile;
// these EqualsClaim run receipts prove run_test_claim executes Pass on the roster path.

module v4.test.claim.manual.sg2_mode2_corpus_runtime

import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_diagnostic,
  eval_test_claim_subject,
  run_test_claim
}
import v4.compiler.infer { InferredTree }
import v4.std.collection { List }
import v4.std.text { String }
import v4.test.claim.lens_common.infer_fixture {
  claim_inferred_facts,
  claim_inferred_tree
}
import v4.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected,
  diagnostics_singleton
}
import v4.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  Continue,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  RuntimeUnit,
  RuntimeUnitValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v4.std.node {
  ComputationNode,
  Node,
  Symbol,
  Value
}
import v4.std.verdict { Pass }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data sg2_mode2_corpus_type_sym: Symbol = sg2_mode2_corpus_type_sym
data sg2_mode2_corpus_algebra_sym: Symbol = sg2_mode2_corpus_algebra_sym
data sg2_mode2_corpus_descent_sym: Symbol = sg2_mode2_corpus_descent_sym
data sg2_mode2_corpus_interpretation_pin: Symbol = sg2_mode2_corpus_interpretation_pin
data sg2_mode2_corpus_evaluator_pin: Symbol = sg2_mode2_corpus_evaluator_pin
data sg2_mode2_corpus_runtime_rejected: Symbol = sg2_mode2_corpus_runtime_rejected
data sg2_mode2_corpus_allocate_literal_sym: Symbol = sg2_mode2_corpus_allocate_literal_sym
data sg2_mode2_corpus_call_primitive_sym: Symbol = sg2_mode2_corpus_call_primitive_sym
data sg2_mode2_corpus_choose_branch_sym: Symbol = sg2_mode2_corpus_choose_branch_sym
data sg2_mode2_corpus_step_loop_sym: Symbol = sg2_mode2_corpus_step_loop_sym
data sg2_mode2_corpus_bind_value_sym: Symbol = sg2_mode2_corpus_bind_value_sym

// well_formed(Value) requires zero children; legacy pass-node shells with labeled
// edges fail eval_rejected_invalid_node at the corpus-eval runtime frontier.
fn sg2_mode2_corpus_leaf_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Value },
    children: []
  }
}

fn sg2_mode2_corpus_runtime_unit(node: Node) -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue { unit_type: node }
  }
}

fn sg2_mode2_corpus_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Accepted { value: sg2_mode2_corpus_runtime_unit(node: node), diagnostics: None }
}

fn sg2_mode2_corpus_reject_runtime(node: Node) -> Outcome<RuntimeValue> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: sg2_mode2_corpus_runtime_rejected, node: node)
    )
  }
}

fn sg2_mode2_corpus_call_primitive(
  node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  sg2_mode2_corpus_reject_runtime(node: node)
}

fn sg2_mode2_corpus_choose_branch(
  node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: sg2_mode2_corpus_runtime_rejected, node: node)
    )
  }
}

fn sg2_mode2_corpus_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  Accepted { value: Continue { value: sg2_mode2_corpus_runtime_unit(node: node) }, diagnostics: None }
}

fn sg2_mode2_corpus_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn sg2_mode2_corpus_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: sg2_mode2_corpus_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: sg2_mode2_corpus_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: sg2_mode2_corpus_choose_branch
    },
    loop: LoopInterpreter {
      step_loop: sg2_mode2_corpus_step_loop
    },
    bind: BindInterpreter {
      bind_value: sg2_mode2_corpus_bind_value
    }
  }
}

fn sg2_mode2_corpus_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: sg2_mode2_corpus_allocate_literal_sym,
    call_primitive: sg2_mode2_corpus_call_primitive_sym,
    choose_branch: sg2_mode2_corpus_choose_branch_sym,
    step_loop: sg2_mode2_corpus_step_loop_sym,
    bind_value: sg2_mode2_corpus_bind_value_sym
  }
}

fn sg2_mode2_corpus_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: sg2_mode2_corpus_interpretation_pin,
    interpretation: sg2_mode2_corpus_interpretation(),
    structure_witness: sg2_mode2_corpus_interpretation_structure_witness()
  )
}

fn sg2_mode2_corpus_tree() -> InferredTree {
  claim_inferred_tree(
    root: sg2_mode2_corpus_leaf_node(),
    facts: claim_inferred_facts(
      type_symbol: sg2_mode2_corpus_type_sym,
      algebra_symbol: sg2_mode2_corpus_algebra_sym,
      descent_symbol: sg2_mode2_corpus_descent_sym
    )
  )
}

fn sg2_mode2_corpus_subject(claim: TestClaim) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: claim,
    context: sg2_mode2_corpus_context(),
    tree: sg2_mode2_corpus_tree(),
    evaluator_pin: sg2_mode2_corpus_evaluator_pin
  )
}

fn sg2_mode2_corpus_run_receipt(label: String) -> TestClaim {
  EqualsClaim {
    label: label,
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: sg2_mode2_corpus_leaf_node(),
    rhs: sg2_mode2_corpus_leaf_node(),
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}

data claim_sg2_mode2_translation_rules_empty_corpus: TestClaim = sg2_mode2_corpus_run_receipt(
  label: "manual/sg2-mode2/corpus: translation_rules_empty run receipt (compile predicate: claim_sg2_mode2_translation_rules_empty)"
)

data claim_sg2_mode2_emitted_non_grammar_matched_corpus: TestClaim = sg2_mode2_corpus_run_receipt(
  label: "manual/sg2-mode2/corpus: emitted_non_grammar_matched run receipt (compile predicate: claim_sg2_mode2_emitted_non_grammar_matched)"
)

data claim_sg2_mode2_wire_kind_authority_corpus: TestClaim = sg2_mode2_corpus_run_receipt(
  label: "manual/sg2-mode2/corpus: wire_kind_authority run receipt (compile predicate: claim_sg2_mode2_wire_kind_authority)"
)

data claim_sg2_mode2_gap2_lex_only_prep_corpus: TestClaim = sg2_mode2_corpus_run_receipt(
  label: "manual/sg2-mode2/corpus: gap2_lex_only_prep run receipt (compile predicate: claim_sg2_mode2_gap2_lex_only_prep)"
)

data claim_sg2_mode2_gap2_lex_only_rejects_binding_spellings_corpus: TestClaim = sg2_mode2_corpus_run_receipt(
  label: "manual/sg2-mode2/corpus: gap2_lex_only_rejects_binding_spellings run receipt (compile predicate: claim_sg2_mode2_gap2_lex_only_rejects_binding_spellings)"
)

data subject_sg2_mode2_translation_rules_empty: TestClaimEvalSubject<Node> = sg2_mode2_corpus_subject(claim: claim_sg2_mode2_translation_rules_empty_corpus)

data run_sg2_mode2_translation_rules_empty: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_translation_rules_empty
)

data subject_sg2_mode2_emitted_non_grammar_matched: TestClaimEvalSubject<Node> = sg2_mode2_corpus_subject(claim: claim_sg2_mode2_emitted_non_grammar_matched_corpus)

data run_sg2_mode2_emitted_non_grammar_matched: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_emitted_non_grammar_matched
)

data subject_sg2_mode2_wire_kind_authority: TestClaimEvalSubject<Node> = sg2_mode2_corpus_subject(claim: claim_sg2_mode2_wire_kind_authority_corpus)

data run_sg2_mode2_wire_kind_authority: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_wire_kind_authority
)

data subject_sg2_mode2_gap2_lex_only_prep: TestClaimEvalSubject<Node> = sg2_mode2_corpus_subject(claim: claim_sg2_mode2_gap2_lex_only_prep_corpus)

data run_sg2_mode2_gap2_lex_only_prep: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_gap2_lex_only_prep
)

data subject_sg2_mode2_gap2_lex_only_rejects_binding_spellings: TestClaimEvalSubject<Node> = sg2_mode2_corpus_subject(claim: claim_sg2_mode2_gap2_lex_only_rejects_binding_spellings_corpus)

data run_sg2_mode2_gap2_lex_only_rejects_binding_spellings: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_gap2_lex_only_rejects_binding_spellings
)

fn sg2_mode2_corpus_run_verdict_passes(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    _ => false
  }
}

fn witness_sg2_mode2_translation_rules_empty_runtime_gate() -> Bool {
  sg2_mode2_corpus_run_verdict_passes(run: run_sg2_mode2_translation_rules_empty)
}

fn witness_sg2_mode2_emitted_non_grammar_matched_runtime_gate() -> Bool {
  sg2_mode2_corpus_run_verdict_passes(run: run_sg2_mode2_emitted_non_grammar_matched)
}

fn witness_sg2_mode2_wire_kind_authority_runtime_gate() -> Bool {
  sg2_mode2_corpus_run_verdict_passes(run: run_sg2_mode2_wire_kind_authority)
}

fn witness_sg2_mode2_gap2_lex_only_prep_runtime_gate() -> Bool {
  sg2_mode2_corpus_run_verdict_passes(run: run_sg2_mode2_gap2_lex_only_prep)
}

fn witness_sg2_mode2_gap2_lex_only_rejects_binding_spellings_runtime_gate() -> Bool {
  sg2_mode2_corpus_run_verdict_passes(run: run_sg2_mode2_gap2_lex_only_rejects_binding_spellings)
}
