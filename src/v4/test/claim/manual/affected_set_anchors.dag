// src/v4/test/claim/manual/affected_set_anchors.dag
// Scope: Manual TestClaim anchors for T-21 affected_set Wave-0 gate cases.
// Owns: affected-set expected frontier rows + claim_affected_set_* TestClaim data
// Consumes: v4.std.verification v4.std.diagnostic v4.std.node v4.lens.affected_set
// Status: v2 compile; claim execution deferred (T-22).

module v4.test.claim.manual.affected_set_anchors

import v4.std.verification {
  TestClaim,
  Equals,
  TestClassification,
  Tier1,
  Unit,
  Boundary,
  T19ManualAnchorAbsent
}
import v4.std.diagnostic {
  Produced,
  Diagnostic,
  NodeLocus,
  Unavailable,
  ExternalContractUnknown
}
import v4.std.node { Path, Edit, Hash, Symbol }
import v4.test.claim.manual.connective_anchors { stub_empty_conj }
import v4.lens.affected_set {
  ReExecFrontier,
  ChangedSubgraphFrontier,
  BoundaryExclusion,
  UnchangedPureBoundary,
  ExclusionKey,
  Rerun,
  Excluded,
  EmptyDimensionDelta,
  WholeDagFailClosed,
  WholeDagReason,
  WholeDagDiagnostic
}


data affected_set_claim_path_symbol: Symbol = affected_set_claim_path_symbol
data affected_set_claim_dimension: Symbol = affected_set_claim_dimension
data affected_set_claim_reason: Symbol = affected_set_claim_reason
data affected_set_claim_hash: Hash = affected_set_claim_hash


data affected_set_claim_path: Path = Path { steps: [affected_set_claim_path_symbol] }


data affected_set_claim_edit: Edit = Edit {
  at: affected_set_claim_path,
  replacement: stub_empty_conj
}


data affected_set_claim_invalid_edit_diagnostic: Diagnostic = Diagnostic {
  reason: affected_set_claim_reason,
  at: NodeLocus { node: stub_empty_conj },
  correction: Unavailable { reason: ExternalContractUnknown }
}


data expected_affected_set_boundary_prune: ReExecFrontier = ChangedSubgraphFrontier {
  boundary_exclusions: [
    BoundaryExclusion {
      edit: affected_set_claim_edit,
      proof: UnchangedPureBoundary {
        subject: affected_set_claim_path,
        content_hash: affected_set_claim_hash
      }
    }
  ],
  decisions: empty_map()
}


data expected_affected_set_dimension_seed: ReExecFrontier = ChangedSubgraphFrontier {
  boundary_exclusions: [],
  decisions: map_insert(
    empty_map(),
    ExclusionKey { at: affected_set_claim_path, dimension: affected_set_claim_dimension },
    Rerun
  )
}


data expected_affected_set_excluded_proofs: ReExecFrontier = ChangedSubgraphFrontier {
  boundary_exclusions: [],
  decisions: map_insert(
    empty_map(),
    ExclusionKey { at: affected_set_claim_path, dimension: affected_set_claim_dimension },
    Excluded {
      proofs: [
        EmptyDimensionDelta { subject: affected_set_claim_path },
        EmptyDimensionDelta { subject: affected_set_claim_path }
      ]
    }
  )
}


data expected_affected_set_unknown_fail_closed: ReExecFrontier = WholeDagFailClosed {
  evidence: WholeDagReason { reason: affected_set_claim_reason }
}


data expected_affected_set_rejected_edit_fail_closed: ReExecFrontier = WholeDagFailClosed {
  evidence: WholeDagDiagnostic { diagnostic: affected_set_claim_invalid_edit_diagnostic }
}


data claim_affected_set_boundary_prune_explicit: TestClaim = TestClaim {
  kind: Equals,
  label: "affected_set: unchanged/pure boundary pruning surfaces explicit edit-scoped BoundaryExclusionProof",
  t19_anchor: T19ManualAnchorAbsent,
  input: stub_empty_conj,
  expected: Produced { value: stub_empty_conj },
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_affected_set_changed_dimension_seeds_rerun: TestClaim = TestClaim {
  kind: Equals,
  label: "affected_set: non-empty changed dimensions seed one Rerun per real AffectedDimension",
  t19_anchor: T19ManualAnchorAbsent,
  input: stub_empty_conj,
  expected: Produced { value: stub_empty_conj },
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_affected_set_unknowns_fail_closed: TestClaim = TestClaim {
  kind: Equals,
  label: "affected_set: ChangedDimensionsUnknown and PropagationUnknown collapse to WholeDagFailClosed",
  t19_anchor: T19ManualAnchorAbsent,
  input: stub_empty_conj,
  expected: Produced { value: stub_empty_conj },
  classification: TestClassification { tier: Tier1, layer: Boundary }
}


data claim_affected_set_post_edit_rejected_preserves_diagnostic: TestClaim = TestClaim {
  kind: Equals,
  label: "affected_set: PostEditDagRejected preserves Diagnostic in WholeDagFailClosedEvidence",
  t19_anchor: T19ManualAnchorAbsent,
  input: stub_empty_conj,
  expected: Produced { value: stub_empty_conj },
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
