// src/v4/test/claim/manual/resolve_compile_anchor.dag
//
// Scope: Tier-1 v2-bootstrap compile anchor for `resolve` + LM `canonical_symbols` (TASKS T-8).
// Owns: anchor_resolve_wave1_service_atom_via_canonical_symbols; anchor_resolve_wave1_empty_prelude_service_atom; anchor_resolve_wave1_multi_edge_conj_via_canonical_symbols; anchor_resolve_wave1_bind_binder_use; claim_resolve_with_graph_imported_binding_accepts.
// Consumes: compiler/03_resolve.dag, extdeps/languages/dag.dag, std/module_graph.dag, std/diagnostic.dag, std/node.dag.
// Status: scaffold — compile-only until T-22; `v2 run` TestClaims per MOVE1_COVERAGE.txt.
// Anchor: https://en.wikipedia.org/wiki/Name_resolution_(programming_languages)

module v4.test.claim.manual.resolve_compile_anchor


import v4.compiler.resolve { resolve, resolve_with_graph, ResolvedTree }
import v4.extdeps.languages.dag {
  dag_c3_surface_sugar_fn,
  dag_c3_surface_sugar_service,
  dag_c3_surface_sugar_type,
  dag_language_model_surface_empty_prelude,
  dag_language_model_wave1_void
}
import v4.std.algebra { Cons, Empty }
import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.logic { Bool }
import v4.std.module_graph { ModuleEntry, ModuleGraph, ModulePath, ModulePathSegment }
import v4.std.node {
  Atom,
  Bind,
  ComputationNode,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data anchor_decl_first: Symbol = anchor_decl_first
data anchor_decl_second: Symbol = anchor_decl_second
data anchor_imported_decl: Symbol = anchor_imported_decl
data anchor_imported_path_segment: Symbol = anchor_imported_path_segment
data anchor_resolve_graph_pass: Symbol = anchor_resolve_graph_pass
data anchor_resolve_graph_fail: Symbol = anchor_resolve_graph_fail


fn service_atom_conj_tree() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode {
            connective: Atom { identity: dag_c3_surface_sugar_service }
          },
          children: []
        }
      }
    ]
  }
}


fn anchor_resolve_wave1_service_atom_via_canonical_symbols() -> Outcome<ResolvedTree> {
  resolve(
    tree: service_atom_conj_tree(),
    lm: dag_language_model_wave1_void()
  )
}


fn anchor_resolve_wave1_empty_prelude_service_atom() -> Outcome<ResolvedTree> {
  resolve(
    tree: service_atom_conj_tree(),
    lm: dag_language_model_surface_empty_prelude()
  )
}


fn anchor_resolve_wave1_multi_edge_conj_via_canonical_symbols() -> Outcome<ResolvedTree> {
  resolve(
    tree: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge {
          label: Named { name: anchor_decl_first },
          target: Node {
            kind: TypeNode {
              connective: Atom { identity: dag_c3_surface_sugar_service }
            },
            children: []
          }
        },
        Edge {
          label: Named { name: anchor_decl_second },
          target: Node {
            kind: TypeNode {
              connective: Atom { identity: dag_c3_surface_sugar_type }
            },
            children: []
          }
        }
      ]
    },
    lm: dag_language_model_wave1_void()
  )
}


fn anchor_resolve_wave1_bind_binder_use() -> Outcome<ResolvedTree> {
  resolve(
    tree: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge {
          label: Named { name: anchor_decl_first },
          target: Node {
            kind: ComputationNode { behavior: Bind },
            children: [
              Edge {
                label: Positional,
                target: Node {
                  kind: TypeNode {
                    connective: Atom { identity: dag_c3_surface_sugar_fn }
                  },
                  children: []
                }
              },
              Edge {
                label: Positional,
                target: Node {
                  kind: TypeNode {
                    connective: Atom { identity: dag_c3_surface_sugar_service }
                  },
                  children: []
                }
              },
              Edge {
                label: Positional,
                target: Node {
                  kind: TypeNode {
                    connective: Atom { identity: dag_c3_surface_sugar_fn }
                  },
                  children: []
                }
              }
            ]
          }
        }
      ]
    },
    lm: dag_language_model_wave1_void()
  )
}


fn resolve_graph_claim_node(ok: Bool) -> Node {
  if ok {
    Node {
      kind: TypeNode { connective: Atom { identity: anchor_resolve_graph_pass } },
      children: []
    }
  } else {
    Node {
      kind: TypeNode { connective: Atom { identity: anchor_resolve_graph_fail } },
      children: []
    }
  }
}


fn resolve_graph_imported_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: anchor_imported_decl },
        target: Node {
          kind: TypeNode {
            connective: Atom { identity: dag_c3_surface_sugar_service }
          },
          children: []
        }
      }
    ]
  }
}


fn resolve_graph_imported_entry() -> ModuleEntry {
  ModuleEntry {
    path: ModulePath {
      segments: Cons {
        head: ModulePathSegment { name: anchor_imported_path_segment },
        tail: Empty
      }
    },
    root: resolve_graph_imported_root()
  }
}


fn resolve_graph_single_import() -> ModuleGraph {
  ModuleGraph {
    entries: Cons {
      head: resolve_graph_imported_entry(),
      tail: Empty
    }
  }
}


fn resolve_graph_imported_use_tree() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: anchor_imported_decl } },
    children: []
  }
}


fn resolve_with_graph_imported_binding_accepts() -> Bool {
  match resolve_with_graph(
    tree: resolve_graph_imported_use_tree(),
    lm: dag_language_model_surface_empty_prelude(),
    graph: resolve_graph_single_import()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


data claim_resolve_with_graph_imported_binding_accepts: TestClaim = CompilesClaim {
  label: "resolve/with_graph: imported module named export resolves",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: resolve_graph_claim_node(ok: resolve_with_graph_imported_binding_accepts()),
  expected_value: resolve_graph_claim_node(ok: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
