// src/v4/test/claim/manual/resolve_compile_anchor.dag
//
// Scope: Tier-1 (compile-time) anchor for `compiler/03_resolve.dag` +
//   `extdeps/languages/dag.dag` wave-1 `DagLanguageModel` + canonical `Set`
//   wiring consumed by `resolve` / `resolve_atom` (DECISIONS §CP-1b items 1–2).
//   Ratchets codex #13724 “no test/claim coverage” gap without pretending
//   `v2-compiler run` executes these probes yet — see
//   `test/v2_run_preflight/MOVE1_COVERAGE.txt` (deferred until T-22).
//
// Behavior pinned (when a claim runner exists): wave-1 void LM lists the
// four `dag_c3_surface_sugar_*` identities in `canonical_symbols`; a lone
// `Atom` carrying `dag_c3_surface_sugar_service` resolves via that set even
// when no module binding row exists.
//
// Consumes:
//   - compiler/03_resolve.dag
//   - extdeps/languages/dag.dag
//
// Status: manual compile anchor — extend with `TestClaim` execution when T-22 lands.

module v4.test.claim.manual.resolve_compile_anchor


import v4.compiler.resolve { resolve, ResolvedTree }
import v4.extdeps.languages.dag {
  dag_c3_surface_sugar_service,
  dag_language_model_wave1_void
}
import v4.std.diagnostic { Outcome }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Node,
  Positional,
  TypeNode
}


fn anchor_resolve_wave1_service_atom_via_canonical_symbols() -> Outcome<ResolvedTree> {
  resolve(
    tree: Node {
      kind: TypeNode { connective: Conj },
      children: [
        Edge {
          label: Positional,
          target: Node {
            kind: TypeNode {
              connective: Atom { identity: dag_c3_surface_sugar_service }
            },
            children: []
          }
        }
      ]
    },
    lm: dag_language_model_wave1_void()
  )
}
