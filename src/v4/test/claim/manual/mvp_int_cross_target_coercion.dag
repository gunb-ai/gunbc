// src/v4/test/claim/manual/mvp_int_cross_target_coercion.dag
// Scope: W3 — cross-target coercion_fold safety + refinement-widening realization receipts.
// Status: python unbounded int → rust i32 still rejects; rust i32 → python int accepts as Widened.


module v4.test.claim.manual.mvp_int_cross_target_coercion


import v4.compiler.eval { run_test_claim_assert }
import v4.extdeps.languages.python {
  python_declared_inhabitants_root,
  python_int_inhabitant_node
}
import v4.extdeps.languages.rust {
  rust_declared_inhabitants_root,
  rust_inhabitant_i32_node
}
import v4.std.coercion {
  CoercionResult,
  Exact,
  Identity,
  NoTargetCandidate,
  Widened,
  coercion_candidate_set_from_declared_inhabitants,
  coercion_fold,
  coercion_fold_with_refinement_widening,
  coercion_not_realized_diagnostic
}
import v4.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness,
  constraint_property_being_canonical,
  constraint_property_candidate_set_closedness
}
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus
}
import v4.std.find_witness {
  TargetDeclaredPriority,
  find_witness_reason_no_candidate
}
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.refinement_widening_predicate {
  refinement_widening_relation_field_evidence,
  refinement_widening_relation_field_source,
  refinement_widening_relation_field_target
}
import v4.std.target_model { target_model_edge_declared_inhabitants }
import v4.std.verdict { Fail, Pass, Deferred }
import v4.std.verification {
  CompilesClaim,
  DiagnosticClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { StructuralPropertyWitness }


data rust_i32_python_int_widening_evidence: Symbol = rust_i32_python_int_widening_evidence


fn rust_i32_python_int_widening_evidence_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: rust_i32_python_int_widening_evidence } },
    children: []
  }
}


fn rust_i32_to_python_int_declared_widening_relation() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: refinement_widening_relation_field_source },
        target: rust_inhabitant_i32_node()
      },
      Edge {
        label: Named { name: refinement_widening_relation_field_target },
        target: python_int_inhabitant_node()
      },
      Edge {
        label: Named { name: refinement_widening_relation_field_evidence },
        target: rust_i32_python_int_widening_evidence_node()
      }
    ]
  }
}


fn python_unbounded_int_grounding() -> CanonicalGrounding {
  let source = python_int_inhabitant_node()
  CanonicalGrounding {
    node: source,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: constraint_property_being_canonical,
        evidence: source
      },
      closedness: StructuralPropertyWitness {
        property: constraint_property_candidate_set_closedness,
        evidence: source
      }
    }
  }
}


fn rust_i32_grounding() -> CanonicalGrounding {
  let source = rust_inhabitant_i32_node()
  CanonicalGrounding {
    node: source,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: constraint_property_being_canonical,
        evidence: source
      },
      closedness: StructuralPropertyWitness {
        property: constraint_property_candidate_set_closedness,
        evidence: source
      }
    }
  }
}


fn cross_target_python_to_rust_i32_coercion_fold() -> Outcome<CoercionResult> {
  bind_outcome(
    o: coercion_candidate_set_from_declared_inhabitants(
      inhabitants_root: rust_declared_inhabitants_root(),
      closedness_property: target_model_edge_declared_inhabitants
    ),
    f: fn(candidates) {
      coercion_fold(
        source: python_unbounded_int_grounding(),
        candidates: candidates,
        policy: TargetDeclaredPriority { priority: rust_inhabitant_i32_node() }
      )
    }
  )
}


fn cross_target_rust_i32_to_python_int_widening_fold() -> Outcome<CoercionResult> {
  bind_outcome(
    o: coercion_candidate_set_from_declared_inhabitants(
      inhabitants_root: python_declared_inhabitants_root(),
      closedness_property: target_model_edge_declared_inhabitants
    ),
    f: fn(candidates) {
      coercion_fold_with_refinement_widening(
        source: rust_i32_grounding(),
        candidates: candidates,
        policy: TargetDeclaredPriority { priority: python_int_inhabitant_node() },
        widening_relation: rust_i32_to_python_int_declared_widening_relation()
      )
    }
  )
}


fn coercion_outcome_node_projection(actual: Outcome<CoercionResult>) -> Outcome<Node> {
  match actual {
    Accepted { value: r, diagnostics: ad } =>
      Accepted { value: r.target, diagnostics: ad }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}


data cross_target_upstream_find_witness_rejection: Diagnostic = Diagnostic {
  reason: find_witness_reason_no_candidate,
  at: node_locus(node: python_int_inhabitant_node()),
  correction: Unavailable { reason: ExternalContractUnknown }
}


data cross_target_coercion_expected_rejection: NonEmptyDiagnostics = NonEmptyDiagnostics {
  head: coercion_not_realized_diagnostic(
    source: python_unbounded_int_grounding(),
    kind: NoTargetCandidate
  ),
  tail: [cross_target_upstream_find_witness_rejection]
}


data claim_cross_target_python_to_rust_i32_rejects: TestClaim = DiagnosticClaim {
  label: "manual/mvp_int_cross_target: python unbounded int -> rust declared inhabitants rejects (no exact witness)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: python_int_inhabitant_node(),
  expected_rejection: cross_target_coercion_expected_rejection,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data witness_cross_target_python_to_rust_i32_rejects: Bool = match run_test_claim_assert(
  claim: claim_cross_target_python_to_rust_i32_rejects,
  actual: coercion_outcome_node_projection(
    actual: cross_target_python_to_rust_i32_coercion_fold()
  ),
  at: python_int_inhabitant_node()
) {
  Pass => true
  Fail { actual: _, falsification: _ } => false
  Deferred { actual: _, diagnostic: _ } => false
}


fn rust_i32_to_python_int_widened_accepts(actual: Outcome<CoercionResult>) -> Bool {
  match actual {
    Accepted { value: r, diagnostics: _ } =>
      (r.target == python_int_inhabitant_node()) && match r.quality {
        Widened => true
        Identity => false
        Exact => false
      }
    Rejected { diagnostics: _ } => false
  }
}


data witness_cross_target_rust_i32_to_python_int_widened_accepts: Bool =
  rust_i32_to_python_int_widened_accepts(
    actual: cross_target_rust_i32_to_python_int_widening_fold()
  )


fn cross_target_witness_claim_input(ok: Bool) -> Node {
  if ok {
    python_int_inhabitant_node()
  } else {
    rust_inhabitant_i32_node()
  }
}


data claim_mvp_int_cross_target_coercion_module_compiles: TestClaim = CompilesClaim {
  label: "manual/mvp_int_cross_target: cross-target coercion safety anchors compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: python_int_inhabitant_node(),
  expected_value: python_int_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_cross_target_python_to_rust_i32_rejects_compiles: TestClaim = CompilesClaim {
  label: "manual/mvp_int_cross_target: python int -> rust i32 coercion_fold rejects coercion_mismatch_no_target",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: cross_target_witness_claim_input(ok: witness_cross_target_python_to_rust_i32_rejects),
  expected_value: python_int_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_cross_target_rust_i32_to_python_int_widened_accepts_compiles: TestClaim = CompilesClaim {
  label: "manual/mvp_int_cross_target: rust i32 -> python int coercion_fold accepts Widened",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: cross_target_witness_claim_input(ok: witness_cross_target_rust_i32_to_python_int_widened_accepts),
  expected_value: python_int_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
