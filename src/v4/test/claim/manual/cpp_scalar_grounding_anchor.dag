// src/v4/test/claim/manual/cpp_scalar_grounding_anchor.dag
// Scope: Compile anchors for C++ scalar groundedness marks.
// Owns: cpp_anchor_* type aliases that instantiate representative ABI/profile/scalar paths.
// Consumes: extdeps/cpp_abi.dag, extdeps/languages/cpp.dag.
// Status: compile-only groundedness testcase.

module v4.test.claim.manual.cpp_scalar_grounding_anchor

import v4.extdeps.cpp_abi {
  CppAbiModelItaniumCxxAbi186,
  CppDataModelFamilyILP32,
  CppDataModelFamilyLP64,
  CppFundamentalWidthRoleLong,
  CppILP32IntegerWidths,
  CppILP32WidthSelectionWitnesses,
  CppIntegerWidthSelectionWitness,
  CppLP64IntegerWidths,
  CppLP64WidthSelectionWitnesses,
  CppPlainCharSignedness,
  CppTargetDataModel,
  CppTargetProfile,
  CppWcharTSignedness,
  cpp_select_width_witness
}
import v4.extdeps.languages.cpp {
  CppRepresentableResultRequired,
  CppScalar,
  CppSignedIntegerSurfaceSpelling,
  CppSignedIntegerWidthSelection,
  CppTwosComplement,
  CppWcharTSurfaceSpelling,
  CppWcharTWidthSelection
}

type cpp_anchor_data_model = CppTargetDataModel<CppDataModelFamilyILP32, CppILP32IntegerWidths, CppPlainCharSignedness, CppWcharTSignedness>
type cpp_anchor_target_profile = CppTargetProfile<CppAbiModelItaniumCxxAbi186, cpp_anchor_data_model>
type cpp_anchor_lp64_data_model = CppTargetDataModel<CppDataModelFamilyLP64, CppLP64IntegerWidths, CppPlainCharSignedness, CppWcharTSignedness>
type cpp_anchor_lp64_target_profile = CppTargetProfile<CppAbiModelItaniumCxxAbi186, cpp_anchor_lp64_data_model>
type cpp_anchor_ilp32_width_witnesses = CppILP32WidthSelectionWitnesses
type cpp_anchor_lp64_width_witnesses = CppLP64WidthSelectionWitnesses
data cpp_anchor_ilp32_long_width_witness: CppIntegerWidthSelectionWitness = cpp_select_width_witness(
  witnesses: CppILP32WidthSelectionWitnesses,
  role: LongFundamentalWidth { tag: CppFundamentalWidthRoleLong }
)
data cpp_anchor_lp64_long_width_witness: CppIntegerWidthSelectionWitness = cpp_select_width_witness(
  witnesses: CppLP64WidthSelectionWitnesses,
  role: LongFundamentalWidth { tag: CppFundamentalWidthRoleLong }
)
type cpp_anchor_signed_width_selection = CppSignedIntegerWidthSelection { spelling: CppSignedIntegerSurfaceSpelling, target_profile: cpp_anchor_target_profile }
type cpp_anchor_wchar_t_width_selection = CppWcharTWidthSelection { spelling: CppWcharTSurfaceSpelling, target_profile: cpp_anchor_target_profile }
type cpp_anchor_signed_scalar = SignedIntegerScalar { width_selection: cpp_anchor_signed_width_selection, signed_representation: CppTwosComplement, overflow_disposition: CppRepresentableResultRequired }
