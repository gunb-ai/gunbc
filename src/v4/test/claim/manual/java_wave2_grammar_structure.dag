// src/v4/test/claim/manual/java_wave2_grammar_structure.dag
// Scope: Wave-2 Java grammar structural receipt — key JLS productions are registered and reachable.
// Owns: java_wave2_grammar_structure_ready (data), java_wave2_grammar_structure_satisfied (fn).
// Consumes: extdeps/languages/java.dag, v4.compiler.parse.
// Status: manual structural TestClaim input for wave-2 grammar contracts.

module v4.test.claim.manual.java_wave2_grammar_structure

import v4.extdeps.languages.java {
  JavaLanguageModel,
  java_language_model_wave2,
  java_production_block_statement,
  java_production_class_body,
  java_production_formal_parameter_list,
  java_production_method_declarator,
  java_production_result,
  java_production_return_statement,
  java_production_local_variable_declaration_statement,
  java_production_statement,
  java_token_kw_void,
  java_wave2_lex_rules
}
import v4.compiler.parse { grammar_carries_symbol }
import v4.compiler.tokenize { lex_rule_set_token_class_member }
import v4.std.logic { Bool }

fn java_wave2_grammar_structure_satisfied(lm: JavaLanguageModel) -> Bool {
  lex_rule_set_token_class_member(rules: java_wave2_lex_rules(), token_class: java_token_kw_void) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: java_production_result) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: java_production_method_declarator) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: java_production_formal_parameter_list) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: java_production_class_body) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: java_production_block_statement) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: java_production_statement) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: java_production_return_statement) &&
    grammar_carries_symbol(
      grammar: lm.grammar,
      sym: java_production_local_variable_declaration_statement
    )
}

data java_wave2_grammar_structure_ready: Bool = java_wave2_grammar_structure_satisfied(lm: java_language_model_wave2())
