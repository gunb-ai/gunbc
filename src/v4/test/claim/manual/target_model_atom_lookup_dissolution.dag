// src/v4/test/claim/manual/target_model_atom_lookup_dissolution.dag
// Scope: E-10 execution receipts for the PassingCandidateFold dissolution of
// TargetAtomRealizationLookup and TargetAtomRealizationCatalogLookup in std/target_model.dag.
// Status: T-6 M-C precondition — three behaviors exercised: acceptance, miss, ambiguity.

module v4.test.claim.manual.target_model_atom_lookup_dissolution

import v4.extdeps.languages.typescript {
  ts_sg2_type_expr_target_model,
  ts_target_atom_realization_catalog
}
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.find_witness {
  ManyPassingCandidates,
  NoPassingCandidate,
  OnePassingCandidate,
  PassingCandidateFold
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode, Unanchored }
import v4.std.target_model {
  symbol_kernel_type_node,
  target_atom_realization_catalog_row_decode_invalid,
  target_atom_realization_lookup_in_catalog,
  target_atom_realization_lookup_in_catalog_node,
  target_atom_realization_lookup_miss
}
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
fn atom_lookup_dissolution_probe_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^atom_lookup_dissolution_probe } },
    children: [],
    span: Unanchored
}
}

fn atom_lookup_dissolution_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^atom_lookup_dissolution_pass } },
    children: [],
    span: Unanchored
}
}

fn atom_lookup_dissolution_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^atom_lookup_dissolution_fail } },
    children: [],
    span: Unanchored
}
}

fn atom_lookup_dissolution_claim_input(ok: Bool) -> Node {
  if ok {
    atom_lookup_dissolution_pass_node()
  } else {
    atom_lookup_dissolution_fail_node()
  }
}

// PassingCandidateFold: two identical candidates produce ManyPassingCandidates — proves the
// ambiguity arm of the dissolved fold is reachable and structurally correct.
fn passing_candidate_fold_duplicate_produces_many() -> Bool {
  match fold_list(
    xs: [atom_lookup_dissolution_probe_node(), atom_lookup_dissolution_probe_node()],
    empty: NoPassingCandidate,
    cons: fn(acc, n) {
      match acc {
        NoPassingCandidate => OnePassingCandidate { candidate: n }
        OnePassingCandidate { candidate: _ } => ManyPassingCandidates
        ManyPassingCandidates => ManyPassingCandidates
      }
    }
  ) {
    NoPassingCandidate => false
    OnePassingCandidate { candidate: _ } => false
    ManyPassingCandidates => true
  }
}

// target_atom_realization_lookup_in_catalog (typed-list path): known carrier accepts.
// Exercises the OnePassingCandidate → second-pass extraction arm.
fn atom_lookup_in_catalog_known_carrier_accepts() -> Bool {
  match target_atom_realization_lookup_in_catalog(
    catalog: ts_target_atom_realization_catalog,
    source_carrier: symbol_kernel_type_node()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// target_atom_realization_lookup_in_catalog (typed-list path): unknown carrier rejects with miss.
// Exercises the NoPassingCandidate → lookup-miss arm.
fn atom_lookup_in_catalog_unknown_carrier_rejects_miss() -> Bool {
  match target_atom_realization_lookup_in_catalog(
    catalog: ts_target_atom_realization_catalog,
    source_carrier: atom_lookup_dissolution_probe_node()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == target_atom_realization_lookup_miss
  }
}

// target_atom_realization_lookup_in_catalog_node (Node path): non-Conj catalog rejects decode-invalid.
// Exercises the outer catalog-shape guard (unchanged by dissolution).
fn atom_lookup_in_catalog_node_non_conj_rejects_decode_invalid() -> Bool {
  match target_atom_realization_lookup_in_catalog_node(
    catalog: atom_lookup_dissolution_probe_node(),
    source_carrier: atom_lookup_dissolution_probe_node(),
    host_target_model: ts_sg2_type_expr_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: d } => d.head.reason == target_atom_realization_catalog_row_decode_invalid
  }
}

data claim_passing_candidate_fold_ambiguity: TestClaim = CompilesClaim {
  label: "manual/atom_lookup_dissolution: PassingCandidateFold duplicate nodes yield ManyPassingCandidates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_lookup_dissolution_claim_input(ok: passing_candidate_fold_duplicate_produces_many()),
  expected_value: atom_lookup_dissolution_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_atom_lookup_in_catalog_accepts: TestClaim = CompilesClaim {
  label: "manual/atom_lookup_dissolution: target_atom_realization_lookup_in_catalog accepts known carrier",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_lookup_dissolution_claim_input(ok: atom_lookup_in_catalog_known_carrier_accepts()),
  expected_value: atom_lookup_dissolution_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_atom_lookup_in_catalog_miss: TestClaim = CompilesClaim {
  label: "manual/atom_lookup_dissolution: target_atom_realization_lookup_in_catalog unknown carrier rejects miss",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_lookup_dissolution_claim_input(ok: atom_lookup_in_catalog_unknown_carrier_rejects_miss()),
  expected_value: atom_lookup_dissolution_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_atom_lookup_in_catalog_node_non_conj: TestClaim = CompilesClaim {
  label: "manual/atom_lookup_dissolution: target_atom_realization_lookup_in_catalog_node non-Conj rejects decode-invalid",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: atom_lookup_dissolution_claim_input(ok: atom_lookup_in_catalog_node_non_conj_rejects_decode_invalid()),
  expected_value: atom_lookup_dissolution_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
