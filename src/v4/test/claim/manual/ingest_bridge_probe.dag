// SCRATCH PROBE — feasibility check for the generic InferredTree path (delete before PR).
// Verifies: infer(emitted) produces a tree admissible to coerce_grounded_node, generically,
// reproducing RTADD's hand-built-tree result. If green, the bridge needs no per-language
// InferredTree hand-coding.
module v4.test.claim.manual.ingest_bridge_probe

import v4.compiler.infer { infer }
import v4.compiler.translate { coerce_grounded_node }
import v4.extdeps.languages.dag { dag_mvp1_fixture_emitted_add_fn, dag_mvp1_target_model }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }

fn probe_infer_coerce_holds() -> Bool {
  match infer(tree: dag_mvp1_fixture_emitted_add_fn) {
    Accepted { value: tree, diagnostics: _ } =>
      match coerce_grounded_node(
        source: dag_mvp1_fixture_emitted_add_fn,
        tree: tree,
        target: dag_mvp1_target_model()
      ) {
        Accepted { value: result, diagnostics: _ } =>
          result.target == dag_mvp1_fixture_emitted_add_fn
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
