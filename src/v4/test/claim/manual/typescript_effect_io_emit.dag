// Scope: PR2 executable-receipt source — emit applied ReadResource/WriteResource effects to
//   concrete TypeScript call-expression text through the value-expression effect-apply projection
//   arm (target_value_expression_effect_apply → target_value_expression_to_concrete_tokens →
//   serialize_concrete_syntax_tokens_to_source). The emitted text is consumed by the Rust
//   executable receipt (src/v2/tests), which binds __gunbc_effect_read / __gunbc_effect_write to
//   fs-backed shims and runs the program under node to prove a real write→read file round-trip.
// Status: model-first day-goal proof — emitted TypeScript that performs real IO.
// The effect-kind discriminant is supplied as the bare Symbol literal (^WriteResource /
// ^ReadResource), which equals discriminant(v: WriteResource {}) by identity, so this witness
// reuses the v4.std.runtime EffectRequestKind vocabulary WITHOUT importing runtime (M9; no
// parallel vocabulary, no closure-widening import).

module v4.test.claim.manual.typescript_effect_io_emit

import v4.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome
}
import v4.std.collection {
  Map,
  empty_map,
  map_insert
}
import v4.std.node { Symbol }
import v4.std.compilers.target_model {
  ConcreteSyntaxToken,
  TargetModel,
  TargetValueExpression,
  target_value_expression_binding_ref,
  target_value_expression_effect_apply,
  target_value_expression_to_concrete_tokens
}
import v4.compiler.target_carriers { TargetSource }
import v4.compiler.translate { serialize_concrete_syntax_tokens_to_source }
import v4.extdeps.languages.typescript {
  ts_mvp1_target_model_node,
  ts_operator_realizations_catalog_node,
  ts_value_expression_projection,
  ts_wave1_lex
}

// Operand binding sites for the emitted host-shim calls. The Rust receipt defines these as
// `const ioPath = <tmpfile>` / `const ioContent = <marker>` before the emitted expressions run.
data effect_io_binding_path: Symbol = effect_io_binding_path
data effect_io_binding_content: Symbol = effect_io_binding_content

// Binding spellings for the two operand sites; lex authority is the shared ts wave-1 lex set
// (which spells ^ts_token_effect_read_callee / ^ts_token_effect_write_callee and the call
// punctuation). bundle/authority_source_text are inert for token serialization.
fn effect_io_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(empty_map(), effect_io_binding_path, "ioPath"),
    effect_io_binding_content,
    "ioContent"
  )
}

fn effect_io_target_model() -> TargetModel {
  TargetModel {
    bundle: ts_mvp1_target_model_node(),
    lex: ts_wave1_lex(),
    binding_spellings: effect_io_binding_spellings(),
    authority_source_text: ""
  }
}

// Applied WriteResource: write_callee(ioPath, ioContent).
fn ts_effect_write_call_expr() -> TargetValueExpression {
  target_value_expression_effect_apply(
    effect_kind_discriminant: ^WriteResource,
    operands: [
      target_value_expression_binding_ref(binding: effect_io_binding_path),
      target_value_expression_binding_ref(binding: effect_io_binding_content)
    ]
  )
}

// Applied ReadResource: read_callee(ioPath).
fn ts_effect_read_call_expr() -> TargetValueExpression {
  target_value_expression_effect_apply(
    effect_kind_discriminant: ^ReadResource,
    operands: [
      target_value_expression_binding_ref(binding: effect_io_binding_path)
    ]
  )
}

fn emit_effect_call_source(expr: TargetValueExpression) -> Outcome<TargetSource> {
  bind_outcome(
    o: target_value_expression_to_concrete_tokens(
      expr: expr,
      projection: ts_value_expression_projection(),
      catalog: ts_operator_realizations_catalog_node()
    ),
    f: fn(tokens) {
      serialize_concrete_syntax_tokens_to_source(
        target: effect_io_target_model(),
        tokens: tokens
      )
    }
  )
}

// String surface read by the Rust executable receipt (interpreter Value::Str). On Rejected the
// sentinel makes the receipt fail loudly rather than emit a silently-degraded program.
fn ts_effect_write_call_source() -> String {
  match emit_effect_call_source(expr: ts_effect_write_call_expr()) {
    Accepted { value: source, diagnostics: _ } => source
    Rejected { diagnostics: _ } => "EFFECT_EMIT_REJECTED"
  }
}

fn ts_effect_read_call_source() -> String {
  match emit_effect_call_source(expr: ts_effect_read_call_expr()) {
    Accepted { value: source, diagnostics: _ } => source
    Rejected { diagnostics: _ } => "EFFECT_EMIT_REJECTED"
  }
}

// --claim-run sanity witness: both effect applications emit the expected TypeScript call text.
fn ts_effect_io_emit_holds() -> Bool {
  (ts_effect_write_call_source() == "__gunbc_effect_write(ioPath, ioContent)")
    && (ts_effect_read_call_source() == "__gunbc_effect_read(ioPath)")
}
