// src/v4/test/claim/manual/sg2_mode2_non_grammar_emit.dag
// Scope: SG-2 mode-2 own cert — emit greens non-grammar-matched type-expression subtrees.
// Status: prep/cert-harness (#4465) + T-22 runner substrate (PR #4468). TestClaimRun
// subjects/runs declared here; manual_corpus_roster wiring deferred until gunbc-run
// interpreter supports Map.lookup / target_bundle_child (prep predicates re-evaluate
// at run time today). Gate/dissolve claims stay compile-only until A (#4462) lands.

module v4.test.claim.manual.sg2_mode2_non_grammar_emit

import v4.compiler.emit { emit }
import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_diagnostic,
  eval_test_claim_subject,
  run_test_claim
}
import v4.compiler.infer { InferredFacts, InferredTree }
import v4.compiler.target_carriers { TargetModel }
import v4.compiler.translate {
  grammar_relation_row_for_emitted,
  project_type_expression_node,
  target_bundle_child,
  target_serialize_source_from_model,
  translate,
  translate_apply_use_site_ownership_to_projected_type
}
import v4.extdeps.languages.rust {
  rust_binding_sg2_lex_only_atom,
  rust_sg2_arrow_xy_emitted,
  rust_sg2_binding_spellings,
  rust_sg2_conj_xy_emitted,
  rust_sg2_foobar_xy_no_rc_source_type_node,
  rust_sg2_instantiation_source_type_node,
  rust_sg2_lex_only_atom_emitted,
  rust_sg2_lex_only_atom_spelling,
  rust_sg2_rc_foobar_xy_emitted,
  rust_sg2_sum_xy_emitted,
  rust_sg2_type_expr_target_model,
  rust_type_expression_projection
}
import v4.std.algebra { is_empty }
import v4.std.collection { List, Map }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v4.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  Continue,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  RuntimeUnit,
  RuntimeUnitValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v4.std.witness { Violates, Witness }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Instantiation,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  Value,
  content_hash
}
import v4.std.target_model {
  OwnershipAtFunctionReturn,
  TypeExprKindAuthority,
  TypeExprKindNotEmitted,
  target_carrier_node,
  target_carrier_outcome,
  target_model_edge_translation_rules,
  target_type_expr_emitted_kind
}
import v4.std.text { String }
import v4.std.verdict { Pass }
import v4.std.verification {
  CompilesClaim,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data sg2_mode2_pass_sym: Symbol = sg2_mode2_pass_sym
data sg2_mode2_fail_sym: Symbol = sg2_mode2_fail_sym
data sg2_mode2_facts_unavailable: Symbol = sg2_mode2_facts_unavailable
data sg2_mode2_fail_text: String = ""
data sg2_mode2_expected_instantiation_text: String = "Rc<FooBar<X, Y>>"
data sg2_mode2_expected_perturbed_text: String = "FooBar<X, Y>"
data sg2_mode2_expected_arrow_text: String = "(X) -> Y"
data sg2_mode2_expected_conj_text: String = " { X, Y }"
data sg2_mode2_expected_sum_text: String = "X | Y"
data sg2_mode2_expected_rc_outcome_node: String = "Rc<Outcome<Node>>"

fn sg2_mode2_symbol_node(sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sym } },
    children: []
  }
}

fn sg2_mode2_pass_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Value },
    children: [
      Edge {
        label: Named { name: sg2_mode2_pass_sym },
        target: sg2_mode2_symbol_node(sym: sg2_mode2_pass_sym)
      }
    ]
  }
}

fn sg2_mode2_fail_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Value },
    children: [
      Edge {
        label: Named { name: sg2_mode2_fail_sym },
        target: sg2_mode2_symbol_node(sym: sg2_mode2_fail_sym)
      }
    ]
  }
}

fn sg2_mode2_claim_input(ok: Bool) -> Node {
  if ok {
    sg2_mode2_pass_node()
  } else {
    sg2_mode2_fail_node()
  }
}

fn sg2_mode2_target() -> TargetModel {
  rust_sg2_type_expr_target_model()
}

fn sg2_mode2_facts_lookup(_key: Node) -> Witness<InferredFacts> {
  Violates {
    diagnostic: Diagnostic {
      reason: sg2_mode2_facts_unavailable,
      at: node_locus(node: sg2_mode2_fail_node()),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}

data sg2_mode2_inferred_tree: InferredTree = InferredTree {
  root: rust_sg2_instantiation_source_type_node(),
  facts: Map {
    lookup: sg2_mode2_facts_lookup
  }
}

data sg2_mode2_perturbed_inferred_tree: InferredTree = InferredTree {
  root: rust_sg2_foobar_xy_no_rc_source_type_node(),
  facts: Map {
    lookup: sg2_mode2_facts_lookup
  }
}

fn sg2_mode2_translation_rules_empty() -> Bool {
  match target_bundle_child(
    target: sg2_mode2_target(),
    edge_name: target_model_edge_translation_rules
  ) {
    Accepted { value: rules, diagnostics: _ } =>
      match rules.kind {
        TypeNode { connective: Conj } => is_empty(xs: rules.children)
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn sg2_mode2_emitted_has_no_grammar_row(emitted: Node) -> Bool {
  match target_bundle_child(
    target: sg2_mode2_target(),
    edge_name: target_model_edge_translation_rules
  ) {
    Accepted { value: rules, diagnostics: _ } =>
      match grammar_relation_row_for_emitted(rules: rules, emitted: emitted) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

fn sg2_mode2_wire_has_kind_authority(emitted: Node) -> Bool {
  match target_type_expr_emitted_kind(node: emitted) {
    TypeExprKindAuthority { value: _ } => true
    TypeExprKindNotEmitted => false
    _ => false
  }
}

fn sg2_mode2_serialize_accepts(emitted: Node) -> Bool {
  match target_serialize_source_from_model(target: sg2_mode2_target(), emitted: emitted) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn sg2_mode2_serialized_text(emitted: Node) -> String {
  match target_serialize_source_from_model(target: sg2_mode2_target(), emitted: emitted) {
    Accepted { value: source, diagnostics: _ } => source
    Rejected { diagnostics: _ } => sg2_mode2_fail_text
  }
}

fn sg2_mode2_translate_emitted() -> Node {
  match translate(tree: sg2_mode2_inferred_tree, target: sg2_mode2_target()) {
    Accepted { value: emitted, diagnostics: _ } => emitted
    Rejected { diagnostics: _ } => sg2_mode2_fail_node()
  }
}

fn sg2_mode2_translate_matches_golden() -> Bool {
  content_hash(n: sg2_mode2_translate_emitted()) ==
    content_hash(n: rust_sg2_rc_foobar_xy_emitted())
}

fn sg2_mode2_emit_accepts() -> Bool {
  match emit(tree: sg2_mode2_inferred_tree, target: sg2_mode2_target()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn sg2_mode2_emit_text() -> String {
  match emit(tree: sg2_mode2_inferred_tree, target: sg2_mode2_target()) {
    Accepted { value: source, diagnostics: _ } => source
    Rejected { diagnostics: _ } => sg2_mode2_fail_text
  }
}

fn sg2_mode2_perturbed_emit_text() -> String {
  match emit(tree: sg2_mode2_perturbed_inferred_tree, target: sg2_mode2_target()) {
    Accepted { value: source, diagnostics: _ } => source
    Rejected { diagnostics: _ } => sg2_mode2_fail_text
  }
}

fn sg2_mode2_emit_discriminates_perturbed_twin() -> Bool {
  sg2_mode2_emit_text() == sg2_mode2_expected_instantiation_text
    && sg2_mode2_perturbed_emit_text() == sg2_mode2_expected_perturbed_text
    && sg2_mode2_emit_text() != sg2_mode2_perturbed_emit_text()
}

fn sg2_mode2_outcome_node_source_type() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: target_carrier_outcome } },
          children: []
        }
      },
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: target_carrier_node } },
          children: []
        }
      }
    ]
  }
}

fn sg2_mode2_lex_only_absent_from_binding_spellings() -> Bool {
  match rust_sg2_binding_spellings().lookup(rust_binding_sg2_lex_only_atom) {
    None => true
    Some { value: _ } => false
  }
}

fn sg2_mode2_outcome_return_shell() -> Node {
  match project_type_expression_node(
    node: sg2_mode2_outcome_node_source_type(),
    target: sg2_mode2_target(),
    projection: rust_type_expression_projection()
  ) {
    Accepted { value: projected, diagnostics: _ } =>
      match translate_apply_use_site_ownership_to_projected_type(
        projected: projected,
        source_carrier: sg2_mode2_outcome_node_source_type(),
        target: sg2_mode2_target(),
        use_site: OwnershipAtFunctionReturn
      ) {
        Accepted { value: wrapped, diagnostics: _ } => wrapped
        Rejected { diagnostics: _ } => sg2_mode2_fail_node()
      }
    Rejected { diagnostics: _ } => sg2_mode2_fail_node()
  }
}

data claim_sg2_mode2_translation_rules_empty: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2: rust_sg2_type_expr_target_model carries empty translation_rules (mode-2-only host)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(ok: sg2_mode2_translation_rules_empty()),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_emitted_non_grammar_matched: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2: golden SG-2 wire has no grammar_relation_row match (mode-2 path)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(ok: sg2_mode2_emitted_has_no_grammar_row(emitted: rust_sg2_rc_foobar_xy_emitted())),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_wire_kind_authority: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2: golden emitted node carries TypeExprKindAuthority (mode-2 serialize dispatch)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(ok: sg2_mode2_wire_has_kind_authority(emitted: rust_sg2_rc_foobar_xy_emitted())),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_translate_structural: TestClaim = EqualsClaim {
  label: "manual/sg2-mode2: translate projects instantiation source to golden SG-2 wire",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: sg2_mode2_translate_emitted(),
  rhs: rust_sg2_rc_foobar_xy_emitted(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_emit_accepts: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2: emit accepts non-grammar-matched type-expression subtree (own cert)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(ok: sg2_mode2_emit_accepts()),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_emit_instantiation_text: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2: emit text is Rc<FooBar<X, Y>> for instantiation probe",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(ok: sg2_mode2_emit_text() == sg2_mode2_expected_instantiation_text),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_emit_discriminates_perturbed_twin: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2: perturbed twin (no Rc) emits FooBar<X,Y> distinct from golden Rc<FooBar<X,Y>>",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(ok: sg2_mode2_emit_discriminates_perturbed_twin()),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_emit_arrow_text: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2: serialized arrow wire is (X) -> Y",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(
    ok: sg2_mode2_serialized_text(emitted: rust_sg2_arrow_xy_emitted()) == sg2_mode2_expected_arrow_text
  ),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_emit_conj_text: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2: serialized record wire is { X, Y }",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(
    ok: sg2_mode2_serialized_text(emitted: rust_sg2_conj_xy_emitted()) == sg2_mode2_expected_conj_text
  ),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_emit_sum_text: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2: serialized sum wire is X | Y",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(
    ok: sg2_mode2_serialized_text(emitted: rust_sg2_sum_xy_emitted()) == sg2_mode2_expected_sum_text
  ),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_gap1_outcome_return_rc_serialize: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2 GAP-1: Outcome<Node> return applies SG-RC row during mode-2 serialize",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(
    ok: sg2_mode2_serialized_text(emitted: sg2_mode2_outcome_return_shell()) ==
      sg2_mode2_expected_rc_outcome_node
  ),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_gap2_lex_only_prep: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2 GAP-2 prep: rust_binding_sg2_lex_only_atom absent from binding_spellings",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(ok: sg2_mode2_lex_only_absent_from_binding_spellings()),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_gap2_lex_only_rejects_binding_spellings: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2 GAP-2 prep: lex-only atom rejects serialize (no binding_spellings fail-open)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(
    ok: !sg2_mode2_serialize_accepts(emitted: rust_sg2_lex_only_atom_emitted())
  ),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_sg2_mode2_gap2_lex_only_atom_serialize: TestClaim = CompilesClaim {
  label: "manual/sg2-mode2 GAP-2 post-A: type atom spells via ident_token only (not binding_spellings)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: sg2_mode2_claim_input(
    ok: sg2_mode2_serialized_text(emitted: rust_sg2_lex_only_atom_emitted()) ==
      rust_sg2_lex_only_atom_spelling
  ),
  expected_value: sg2_mode2_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

// T-22 TestClaimRun — minimal unit interpreter for CompilesClaim pass/fail sentinel nodes.
data sg2_mode2_interpretation_pin: Symbol = sg2_mode2_interpretation_pin
data sg2_mode2_evaluator_pin: Symbol = sg2_mode2_evaluator_pin
data sg2_mode2_runtime_rejected: Symbol = sg2_mode2_runtime_rejected
data sg2_mode2_allocate_literal_sym: Symbol = sg2_mode2_allocate_literal_sym
data sg2_mode2_call_primitive_sym: Symbol = sg2_mode2_call_primitive_sym
data sg2_mode2_choose_branch_sym: Symbol = sg2_mode2_choose_branch_sym
data sg2_mode2_step_loop_sym: Symbol = sg2_mode2_step_loop_sym
data sg2_mode2_bind_value_sym: Symbol = sg2_mode2_bind_value_sym

fn sg2_mode2_runtime_unit(node: Node) -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue { unit_type: node }
  }
}

fn sg2_mode2_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Accepted { value: sg2_mode2_runtime_unit(node: node), diagnostics: None }
}

fn sg2_mode2_reject_runtime(node: Node) -> Outcome<RuntimeValue> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: sg2_mode2_runtime_rejected, node: node)
    )
  }
}

fn sg2_mode2_call_primitive(
  node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  sg2_mode2_reject_runtime(node: node)
}

fn sg2_mode2_choose_branch(
  node: Node,
  _value: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: sg2_mode2_runtime_rejected, node: node)
    )
  }
}

fn sg2_mode2_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  Accepted { value: Continue { value: sg2_mode2_runtime_unit(node: node) }, diagnostics: None }
}

fn sg2_mode2_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn sg2_mode2_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: sg2_mode2_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: sg2_mode2_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: sg2_mode2_choose_branch
    },
    loop: LoopInterpreter {
      step_loop: sg2_mode2_step_loop
    },
    bind: BindInterpreter {
      bind_value: sg2_mode2_bind_value
    }
  }
}

fn sg2_mode2_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: sg2_mode2_allocate_literal_sym,
    call_primitive: sg2_mode2_call_primitive_sym,
    choose_branch: sg2_mode2_choose_branch_sym,
    step_loop: sg2_mode2_step_loop_sym,
    bind_value: sg2_mode2_bind_value_sym
  }
}

fn sg2_mode2_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: sg2_mode2_interpretation_pin,
    interpretation: sg2_mode2_interpretation(),
    structure_witness: sg2_mode2_interpretation_structure_witness()
  )
}

fn sg2_mode2_test_claim_subject(claim: TestClaim) -> TestClaimEvalSubject<Node> {
  eval_test_claim_subject(
    claim: claim,
    context: sg2_mode2_context(),
    tree: sg2_mode2_inferred_tree,
    evaluator_pin: sg2_mode2_evaluator_pin
  )
}

data subject_sg2_mode2_translation_rules_empty: TestClaimEvalSubject<Node> = sg2_mode2_test_claim_subject(claim: claim_sg2_mode2_translation_rules_empty)

data run_sg2_mode2_translation_rules_empty: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_translation_rules_empty
)

data subject_sg2_mode2_emitted_non_grammar_matched: TestClaimEvalSubject<Node> = sg2_mode2_test_claim_subject(claim: claim_sg2_mode2_emitted_non_grammar_matched)

data run_sg2_mode2_emitted_non_grammar_matched: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_emitted_non_grammar_matched
)

data subject_sg2_mode2_wire_kind_authority: TestClaimEvalSubject<Node> = sg2_mode2_test_claim_subject(claim: claim_sg2_mode2_wire_kind_authority)

data run_sg2_mode2_wire_kind_authority: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_wire_kind_authority
)

data subject_sg2_mode2_gap2_lex_only_prep: TestClaimEvalSubject<Node> = sg2_mode2_test_claim_subject(claim: claim_sg2_mode2_gap2_lex_only_prep)

data run_sg2_mode2_gap2_lex_only_prep: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_gap2_lex_only_prep
)

data subject_sg2_mode2_gap2_lex_only_rejects_binding_spellings: TestClaimEvalSubject<Node> = sg2_mode2_test_claim_subject(claim: claim_sg2_mode2_gap2_lex_only_rejects_binding_spellings)

data run_sg2_mode2_gap2_lex_only_rejects_binding_spellings: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_sg2_mode2_gap2_lex_only_rejects_binding_spellings
)

fn sg2_mode2_run_verdict_passes(run: TestClaimRun<Node, RuntimeValue>) -> Bool {
  match run.verdict {
    Pass => true
    _ => false
  }
}

fn witness_sg2_mode2_translation_rules_empty_runtime_gate() -> Bool {
  sg2_mode2_run_verdict_passes(run: run_sg2_mode2_translation_rules_empty)
}

fn witness_sg2_mode2_emitted_non_grammar_matched_runtime_gate() -> Bool {
  sg2_mode2_run_verdict_passes(run: run_sg2_mode2_emitted_non_grammar_matched)
}

fn witness_sg2_mode2_wire_kind_authority_runtime_gate() -> Bool {
  sg2_mode2_run_verdict_passes(run: run_sg2_mode2_wire_kind_authority)
}

fn witness_sg2_mode2_gap2_lex_only_prep_runtime_gate() -> Bool {
  sg2_mode2_run_verdict_passes(run: run_sg2_mode2_gap2_lex_only_prep)
}

fn witness_sg2_mode2_gap2_lex_only_rejects_binding_spellings_runtime_gate() -> Bool {
  sg2_mode2_run_verdict_passes(run: run_sg2_mode2_gap2_lex_only_rejects_binding_spellings)
}
