// src/v4/test/claim/manual/comprep_branch_infer_fail_open_audit.dag
// Scope: C3 fail-open audit — divergent-arm Branch through infer @ main (no arm-unification row).
// Status: execution witness for design-sign gate; mismatch body = kw_true + pick_lit_one + ident.

module v4.test.claim.manual.comprep_branch_infer_fail_open_audit

import v4.compiler.infer { infer }
import v4.extdeps.languages.dag {
  dag_mvp1_pick_if_body_fixture,
  dag_mvp1_pick_if_body_from_arms,
  dag_mvp1_type_atom_node
}
import v4.std.diagnostic { Accepted, None, Outcome, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Node }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

fn comprep_branch_infer_fail_open_audit_body() -> Node {
  dag_mvp1_pick_if_body_from_arms(
    condition: dag_mvp1_type_atom_node(identity: ^dag_token_kw_true),
    then_arm: dag_mvp1_type_atom_node(identity: ^dag_mvp1_pick_lit_one),
    else_arm: dag_mvp1_type_atom_node(identity: ^dag_token_ident)
  )
}

// GREEN when infer REJECTS divergent arms (fail-closed @ main).
test fn comprep_branch_infer_fail_open_audit_rejects_holds() -> Bool {
  match infer(tree: comprep_branch_infer_fail_open_audit_body()) {
    Accepted { value: _, diagnostics: d } => false
    Rejected { diagnostics: _ } => true
  }
}

// RED-on-main detector: GREEN when infer silently accepts divergent arms (fail-open).
fn comprep_branch_infer_fail_open_audit_silent_accept_holds() -> Bool {
  match infer(tree: comprep_branch_infer_fail_open_audit_body()) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

// Main-line control: literal-arm pick body should still infer-accept (not over-reject).
fn comprep_branch_infer_fail_open_audit_literal_arm_accepts_holds() -> Bool {
  match infer(tree: dag_mvp1_pick_if_body_fixture) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}
