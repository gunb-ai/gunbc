// TEMPORARY receipt probe — full python source -> ts source ChainProven by execution.
// Delete after the acceptance flip lands.
module v4.test.claim.manual.ingest_python_ts_receipt

import v4.compiler.ingest { cross_language_compile }
import v4.test.claim.manual.python_mvp1_grammar_claim { python_mvp1_grammar_parse_fixture }
import v4.extdeps.languages.python { python_mvp1_target_model }
import v4.extdeps.languages.typescript { ts_mvp1_target_model }
import v4.std.algebra { Cons, Empty }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }

fn python_to_ts_chain_proven() -> Bool {
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: tree,
        source_model: python_mvp1_target_model(),
        target_model: ts_mvp1_target_model()
      ) {
        Accepted { value: source, diagnostics: _ } =>
          match source {
            Cons { head: _, tail: _ } => true
            Empty => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}
