// src/v4/test/claim/manual/circuit_passive_map_fold_anchor.dag
// Scope: S1 compile anchor — TimeSeriesSignal + R/L/C map/fold step operators.
// Status: compile-only IN-B anchor; validates std.circuit carriers wire through v4.

module v4.test.claim.manual.circuit_passive_map_fold_anchor

import v4.std.algebra { Cons, Empty }
import v4.std.collection { List }
import v4.std.circuit {
  BranchCurrent,
  BranchVoltage,
  CapacitorFold,
  CapacitorRating,
  CapacitorState,
  FoldStep,
  InductorFold,
  InductorRating,
  InductorState,
  MapStep,
  PotentialDifference,
  ResistorMap,
  ResistorRating,
  TimeSeriesSample,
  TimeSeriesSignal,
  TimeStep,
  capacitor_fold_step,
  fold_capacitor_transient,
  inductor_fold_step,
  resistor_map_voltage,
}
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.nat { Zero }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor,
}

data circuit_anchor_resistor: ResistorMap = ResistorMap {
  kind: MapStep
  rating: ResistorRating { microohms: 1000 }
}

data circuit_anchor_current: BranchCurrent = BranchCurrent { microamperes: 2 }

data circuit_anchor_capacitor: CapacitorFold = CapacitorFold {
  kind: FoldStep
  rating: CapacitorRating { microfarads: 2 }
}

data circuit_anchor_cap_initial: CapacitorState = CapacitorState {
  voltage: PotentialDifference { microvolts: 0 }
  charge_microcoulombs: 0
}

data circuit_anchor_inductor: InductorFold = InductorFold {
  kind: FoldStep
  rating: InductorRating { microhenries: 2 }
}

data circuit_anchor_ind_initial: InductorState = InductorState {
  current: BranchCurrent { microamperes: 0 }
  flux_microwebers: 0
}

data circuit_anchor_voltage: BranchVoltage = BranchVoltage {
  difference: PotentialDifference { microvolts: 4 }
}

data circuit_anchor_dt: TimeStep = TimeStep { dt_microseconds: 1000 }

data circuit_anchor_tick0: TimeSeriesSample = TimeSeriesSample {
  tick: Zero
  microvolts: 0
}

data circuit_anchor_signal: TimeSeriesSignal = Cons { head: circuit_anchor_tick0, tail: Empty }

fn circuit_anchor_resistor_map_holds() -> Bool {
  let mapped = resistor_map_voltage(element: circuit_anchor_resistor, current: circuit_anchor_current)
  mapped.difference.microvolts == 2000
}

fn circuit_anchor_capacitor_fold_holds() -> Bool {
  match capacitor_fold_step(
    element: circuit_anchor_capacitor,
    state: circuit_anchor_cap_initial,
    current: circuit_anchor_current,
    dt: circuit_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      stepped.charge_microcoulombs == 2000
        && stepped.voltage.microvolts == 1000
    Rejected { diagnostics: _ } => false
  }
}

data circuit_anchor_current_low: BranchCurrent = BranchCurrent { microamperes: 2 }

data circuit_anchor_current_high: BranchCurrent = BranchCurrent { microamperes: 4 }

data circuit_anchor_current_pair: List<BranchCurrent> = Cons {
  head: circuit_anchor_current_low,
  tail: Cons { head: circuit_anchor_current_high, tail: Empty }
}

fn circuit_anchor_capacitor_fold_chronological_holds() -> Bool {
  match fold_capacitor_transient(
    element: circuit_anchor_capacitor,
    initial: circuit_anchor_cap_initial,
    currents: circuit_anchor_current_pair,
    dt: circuit_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      stepped.voltage.microvolts == 3000
    Rejected { diagnostics: _ } => false
  }
}

data circuit_anchor_cap_zero_rating: CapacitorFold = CapacitorFold {
  kind: FoldStep
  rating: CapacitorRating { microfarads: 0 }
}

fn circuit_anchor_capacitor_zero_rating_rejects() -> Bool {
  match capacitor_fold_step(
    element: circuit_anchor_cap_zero_rating,
    state: circuit_anchor_cap_initial,
    current: circuit_anchor_current,
    dt: circuit_anchor_dt,
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn circuit_anchor_inductor_fold_holds() -> Bool {
  match inductor_fold_step(
    element: circuit_anchor_inductor,
    state: circuit_anchor_ind_initial,
    voltage: circuit_anchor_voltage,
    dt: circuit_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      stepped.flux_microwebers == 4000
        && stepped.current.microamperes == 2000
    Rejected { diagnostics: _ } => false
  }
}

data claim_circuit_passive_map_fold_compiles: TestClaim = CompilesClaim {
  label: "manual/circuit_passive_map_fold_anchor: S1 map/fold passives compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: circuit_anchor_resistor,
  expected_value: circuit_anchor_resistor,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
