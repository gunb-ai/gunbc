// src/v4/test/claim/manual/refinement_formatter_literals_accept.dag
// Scope: one accepted catalog discharge witness per hoisted int refinement type.
// Status: T-25-core substrate witness; per-formatter literal tables are §A1 follow-on (T-22 gate: avoid 240s compile timeout).


module v4.test.claim.manual.refinement_formatter_literals_accept


import v4.std.refinement {
  PositiveInt,
  NonNegativeInt,
  AtLeastMinusOneInt,
  AtLeastMinusTwoInt,
  ExactOneInt,
  make_at_least_minus_one_int_at_authoritative,
  make_at_least_minus_two_int_at_authoritative,
  make_exact_one_int_at_authoritative,
  make_non_negative_int_at_authoritative,
  make_positive_int_at_authoritative,
  at_least_minus_one_int_authoritative_literal,
  at_least_minus_two_int_authoritative_literal,
  exact_one_int_authoritative_literal,
  non_negative_int_authoritative_literal,
  positive_int_authoritative_literal,
  positive_int_value,
  non_negative_int_value,
  at_least_minus_one_int_value,
  at_least_minus_two_int_value,
  exact_one_int_value,
}
import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.node { Node }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor,
}
import v4.test.claim.manual.connective_anchors {
  stub_empty_conj,
  stub_empty_disj,
}

fn positive_int_authoritative_literal_matches_accepted(
  literal: Outcome<PositiveInt>,
  accepted: PositiveInt,
) -> Bool {
  match literal {
    Accepted { value: literal_value, diagnostics: _ } =>
      positive_int_value(p: literal_value) == positive_int_value(p: accepted)
    Rejected { diagnostics: _ } => false
  }
}

fn non_negative_int_authoritative_literal_matches_accepted(
  literal: Outcome<NonNegativeInt>,
  accepted: NonNegativeInt,
) -> Bool {
  match literal {
    Accepted { value: literal_value, diagnostics: _ } =>
      non_negative_int_value(p: literal_value) == non_negative_int_value(p: accepted)
    Rejected { diagnostics: _ } => false
  }
}

fn at_least_minus_one_int_authoritative_literal_matches_accepted(
  literal: Outcome<AtLeastMinusOneInt>,
  accepted: AtLeastMinusOneInt,
) -> Bool {
  match literal {
    Accepted { value: literal_value, diagnostics: _ } =>
      at_least_minus_one_int_value(p: literal_value) == at_least_minus_one_int_value(p: accepted)
    Rejected { diagnostics: _ } => false
  }
}

fn at_least_minus_two_int_authoritative_literal_matches_accepted(
  literal: Outcome<AtLeastMinusTwoInt>,
  accepted: AtLeastMinusTwoInt,
) -> Bool {
  match literal {
    Accepted { value: literal_value, diagnostics: _ } =>
      at_least_minus_two_int_value(p: literal_value) == at_least_minus_two_int_value(p: accepted)
    Rejected { diagnostics: _ } => false
  }
}

fn exact_one_int_authoritative_literal_matches_accepted(
  literal: Outcome<ExactOneInt>,
  accepted: ExactOneInt,
) -> Bool {
  match literal {
    Accepted { value: literal_value, diagnostics: _ } =>
      exact_one_int_value(p: literal_value) == exact_one_int_value(p: accepted)
    Rejected { diagnostics: _ } => false
  }
}

fn refinement_formatter_literal_claim_input(ok: Bool) -> Node {
  if ok { stub_empty_conj } else { stub_empty_disj }
}

fn witness_positive_int_catalog_discharge() -> Bool {
  match make_positive_int_at_authoritative(value: 2) {
    Accepted { value: accepted, diagnostics: _ } =>
      positive_int_authoritative_literal_matches_accepted(
        literal: positive_int_authoritative_literal(value: 2),
        accepted: accepted
      )
    Rejected { diagnostics: _ } => false
  }
}

data claim_positive_int_catalog_discharge: TestClaim = EqualsClaim {
  label: "manual/refinement: positive_int_authoritative_literal catalog discharge matches make_positive_int_at_authoritative",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: refinement_formatter_literal_claim_input(ok: witness_positive_int_catalog_discharge()),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit },
}

fn witness_non_negative_int_catalog_discharge() -> Bool {
  match make_non_negative_int_at_authoritative(value: 80) {
    Accepted { value: accepted, diagnostics: _ } =>
      non_negative_int_authoritative_literal_matches_accepted(
        literal: non_negative_int_authoritative_literal(value: 80),
        accepted: accepted
      )
    Rejected { diagnostics: _ } => false
  }
}

data claim_non_negative_int_catalog_discharge: TestClaim = EqualsClaim {
