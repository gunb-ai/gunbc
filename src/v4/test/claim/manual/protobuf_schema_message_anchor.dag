// src/v4/test/claim/manual/protobuf_schema_message_anchor.dag
// Scope: Compile anchor for a minimal proto3 schema document (SearchRequest message).
// Status: compile-only groundedness testcase.

module v4.test.claim.manual.protobuf_schema_message_anchor

import v4.extdeps.formats.protobuf {
  ProtoFieldDefinition,
  ProtoFileDefinition,
  ProtoLabelOptional,
  ProtoMessageDefinition,
  ProtoPackage,
  ProtoSingularField,
  ProtoSyntaxProto3,
  ProtoTypeReference,
  ProtoTypeScalar,
  ProtoString,
  ProtoInt32,
}
import v4.std.cardinality { NonZeroNat }
import v4.std.collection { List, Optional, Present }
import v4.std.nat { Succ, Zero }


data protobuf_anchor_field_number_query: NonZeroNat = NonZeroNat { prev: Succ { prev: Zero } }


data protobuf_anchor_field_number_page_number: NonZeroNat = NonZeroNat { prev: Succ { prev: Succ { prev: Zero } } }


data protobuf_anchor_field_number_result_per_page: NonZeroNat = NonZeroNat {
  prev: Succ { prev: Succ { prev: Succ { prev: Zero } } }
}


data protobuf_anchor_search_request_message: ProtoMessageDefinition = ProtoMessageDefinition {
  name: "SearchRequest",
  fields: [
    ProtoSingularField {
      number: protobuf_anchor_field_number_query,
      name: "query",
      type_ref: ProtoTypeScalar { scalar: ProtoString },
      label: ProtoLabelOptional,
    },
    ProtoSingularField {
      number: protobuf_anchor_field_number_page_number,
      name: "page_number",
      type_ref: ProtoTypeScalar { scalar: ProtoInt32 },
      label: ProtoLabelOptional,
    },
    ProtoSingularField {
      number: protobuf_anchor_field_number_result_per_page,
      name: "result_per_page",
      type_ref: ProtoTypeScalar { scalar: ProtoInt32 },
      label: ProtoLabelOptional,
    },
  ],
  nested_enums: [],
  nested_messages: [],
  oneofs: [],
  reserved_ranges: [],
  reserved_names: [],
}


data protobuf_anchor_minimal_proto3_file: ProtoFileDefinition = ProtoFileDefinition {
  syntax: ProtoSyntaxProto3,
  package: Present { value: ProtoPackage { name: "example" } },
  imports: [],
  enums: [],
  messages: [protobuf_anchor_search_request_message],
}
