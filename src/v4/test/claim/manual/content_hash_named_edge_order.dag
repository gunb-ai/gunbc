// src/v4/test/claim/manual/content_hash_named_edge_order.dag
// Scope: B1-CANON receipt — content_hash is invariant under LabeledEdges child list order.
// Owns: claim_content_hash_named_edge_order_invariant.
// Consumes: v4.std.node v4.std.verification.
// Status: v2 compile; claim execution deferred (T-22).

module v4.test.claim.manual.content_hash_named_edge_order

import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  content_hash
}
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

data content_hash_order_leaf_sym: Symbol = content_hash_order_leaf_sym
data content_hash_order_field_a: Symbol = content_hash_order_field_a
data content_hash_order_field_b: Symbol = content_hash_order_field_b
data content_hash_order_pass_sym: Symbol = content_hash_order_pass_sym
data content_hash_order_fail_sym: Symbol = content_hash_order_fail_sym

fn content_hash_order_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: content_hash_order_leaf_sym } },
    children: []
  }
}

fn content_hash_order_conj_ab() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: content_hash_order_field_a },
        target: content_hash_order_leaf()
      },
      Edge {
        label: Named { name: content_hash_order_field_b },
        target: content_hash_order_leaf()
      }
    ]
  }
}

fn content_hash_order_conj_ba() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: content_hash_order_field_b },
        target: content_hash_order_leaf()
      },
      Edge {
        label: Named { name: content_hash_order_field_a },
        target: content_hash_order_leaf()
      }
    ]
  }
}

fn content_hash_order_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: content_hash_order_pass_sym } },
    children: []
  }
}

fn content_hash_order_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: content_hash_order_fail_sym } },
    children: []
  }
}

fn content_hash_named_edge_order_holds() -> Bool {
  content_hash(n: content_hash_order_conj_ab()) ==
    content_hash(n: content_hash_order_conj_ba())
}

fn content_hash_order_claim_input(ok: Bool) -> Node {
  if ok { content_hash_order_pass_node() } else { content_hash_order_fail_node() }
}

data claim_content_hash_named_edge_order_invariant: TestClaim = CompilesClaim {
  label: "manual/content_hash: Conj named-edge digest is order-independent",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: content_hash_order_claim_input(ok: content_hash_named_edge_order_holds()),
  expected_value: content_hash_order_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
