// src/v4/test/claim/manual/emit_ingest_same_language_row_fold.dag
// Scope: §3 STEP 2 — row-agnostic fold over TargetModel.translation_rules (CoC=1).
//   Asserts emit↔ingest selector bijectivity for every grammar-relation row the fold visits,
//   over the TWO REAL productions that exist today (N=2: dag add, python add). Breadth grows
//   as real productions land in extdeps — NOT "proven general for all productions."
// Status: EXECUTED Bool witness (fast fold + per-row A2 discriminating perturb).
// Anchor: signed fold design A1/A2/B1; composes #4829 ingest + translate fns only.

module v4.test.claim.manual.emit_ingest_same_language_row_fold

import v4.compiler.ingest { grammar_relation_row_forward_selection }
import v4.compiler.translate { grammar_relation_row_for_emitted }
import v4.extdeps.languages.dag {
  dag_mvp1_grammar_relation_row_node,
  dag_mvp1_translation_rules_node
}
import v4.extdeps.languages.python {
  python_grammar_relation_row_node,
  python_mvp1_grammar_relation_row,
  python_mvp1_translation_rules_node
}
import v4.std.algebra { Empty, list_append }
import v4.std.collection { List }
import v4.std.compilers.target_model {
  concrete_syntax_token_class,
  concrete_syntax_token_list_from_node,
  grammar_relation_field_emitted,
  grammar_relation_field_tokens
}
import v4.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  outcome_accepted
}
import v4.std.logic { Bool }
import v4.std.node { Conj, Named, Node, Positional, Symbol, TypeNode }
import v4.std.node_query { find_named_child }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

data emit_ingest_fold_perturb_bogus_tok: Symbol = emit_ingest_fold_perturb_bogus_tok

fn emit_ingest_fold_row_token_spine_classes(row: Node) -> Outcome<List<Symbol>> {
  bind_outcome(
    o: find_named_child(root: row, name: grammar_relation_field_tokens),
    f: fn(tokens_root) {
      bind_outcome(
        o: concrete_syntax_token_list_from_node(list_node: tokens_root),
        f: fn(tokens) {
          let classes = fold(
            tokens,
            init: Empty,
            f: fn(acc, t) {
              list_append(left: acc, right: [concrete_syntax_token_class(token: t)])
            }
          )
          outcome_accepted(value: classes)
        }
      )
    }
  )
}

fn emit_ingest_fold_row_emitted(row: Node) -> Outcome<Node> {
  find_named_child(root: row, name: grammar_relation_field_emitted)
}

// Generic per-row selector bijectivity — NO per-production / per-language arm.
fn emit_ingest_fold_row_selector_bijectivity_holds(row: Node, rules: Node) -> Bool {
  match emit_ingest_fold_row_emitted(row: row) {
    Accepted { value: emitted, diagnostics: _ } =>
      match grammar_relation_row_for_emitted(rules: rules, emitted: emitted) {
        Accepted { value: selected_row, diagnostics: _ } =>
          selected_row == row
            && match emit_ingest_fold_row_token_spine_classes(row: row) {
              Accepted { value: frontier, diagnostics: _ } =>
                match grammar_relation_row_forward_selection(frontier: frontier, rules: rules) {
                  Accepted { value: recovered, diagnostics: _ } =>
                    recovered == emitted
                      && match grammar_relation_row_for_emitted(rules: rules, emitted: recovered) {
                        Accepted { value: roundtrip_row, diagnostics: _ } =>
                          roundtrip_row == row
                        Rejected { diagnostics: _ } => false
                      }
                  Rejected { diagnostics: _ } => false
                }
              Rejected { diagnostics: _ } => false
            }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Fold over translation_rules Conj children (Named edges = rows). CoC=1 — new row = data only.
fn emit_ingest_fold_rules_all_rows_bijectivity_holds(rules: Node) -> Bool {
  match rules.kind {
    TypeNode { connective: Conj } =>
      fold(
        rules.children,
        init: true,
        f: fn(acc, edge) {
          match edge.label {
            Named { name: _ } =>
              acc
                && emit_ingest_fold_row_selector_bijectivity_holds(
                  row: edge.target,
                  rules: rules
                )
            Positional => acc
          }
        }
      )
    _ => false
  }
}

fn emit_ingest_fold_dag_add_rules() -> Node {
  dag_mvp1_translation_rules_node()
}

fn emit_ingest_fold_python_add_rules() -> Node {
  python_mvp1_translation_rules_node()
}

fn emit_ingest_fold_dag_add_row() -> Node {
  dag_mvp1_grammar_relation_row_node()
}

fn emit_ingest_fold_python_add_row() -> Node {
  python_grammar_relation_row_node(row: python_mvp1_grammar_relation_row())
}

// Hermetic per-row perturb-RED: canonical spine + appended bogus token class → fail closed.
fn emit_ingest_fold_row_perturbed_frontier_fails_closed(row: Node, rules: Node) -> Bool {
  match emit_ingest_fold_row_token_spine_classes(row: row) {
    Accepted { value: frontier, diagnostics: _ } =>
      match grammar_relation_row_forward_selection(
        frontier: list_append(left: frontier, right: [emit_ingest_fold_perturb_bogus_tok]),
        rules: rules
      ) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

// Positive control: unperturbed canonical frontier selects (subset of bijectivity).
fn emit_ingest_fold_row_unperturbed_frontier_accepts(row: Node, rules: Node) -> Bool {
  match emit_ingest_fold_row_emitted(row: row) {
    Accepted { value: emitted, diagnostics: _ } =>
      match emit_ingest_fold_row_token_spine_classes(row: row) {
        Accepted { value: frontier, diagnostics: _ } =>
          match grammar_relation_row_forward_selection(frontier: frontier, rules: rules) {
            Accepted { value: recovered, diagnostics: _ } => recovered == emitted
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// A2 — perturb dag row: THAT row's perturbed frontier fails closed; python fold stays GREEN.
fn emit_ingest_fold_a2_dag_row_perturb_isolated_holds() -> Bool {
  emit_ingest_fold_row_perturbed_frontier_fails_closed(
    row: emit_ingest_fold_dag_add_row(),
    rules: emit_ingest_fold_dag_add_rules()
  )
    && emit_ingest_fold_rules_all_rows_bijectivity_holds(rules: emit_ingest_fold_python_add_rules())
}

// A2 — perturb python row: THAT row's perturbed frontier fails closed; dag fold stays GREEN.
fn emit_ingest_fold_a2_python_row_perturb_isolated_holds() -> Bool {
  emit_ingest_fold_row_perturbed_frontier_fails_closed(
    row: emit_ingest_fold_python_add_row(),
    rules: emit_ingest_fold_python_add_rules()
  )
    && emit_ingest_fold_rules_all_rows_bijectivity_holds(rules: emit_ingest_fold_dag_add_rules())
}

// Row-agnostic over the real productions that exist (N=2: dag add, python add).
fn emit_ingest_same_language_row_fold_holds() -> Bool {
  emit_ingest_fold_rules_all_rows_bijectivity_holds(rules: emit_ingest_fold_dag_add_rules())
    && emit_ingest_fold_rules_all_rows_bijectivity_holds(rules: emit_ingest_fold_python_add_rules())
    && emit_ingest_fold_a2_dag_row_perturb_isolated_holds()
    && emit_ingest_fold_a2_python_row_perturb_isolated_holds()
    && emit_ingest_fold_row_unperturbed_frontier_accepts(
      row: emit_ingest_fold_dag_add_row(),
      rules: emit_ingest_fold_dag_add_rules()
    )
    && emit_ingest_fold_row_unperturbed_frontier_accepts(
      row: emit_ingest_fold_python_add_row(),
      rules: emit_ingest_fold_python_add_rules()
    )
}

data unified_claim_emit_ingest_same_language_row_fold: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/manual/emit_ingest_same_language_row_fold.dag",
    function: emit_ingest_same_language_row_fold_holds
  }
}
