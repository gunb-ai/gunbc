// src/v4/test/claim/manual/fold_source_mvp.dag
// Scope: fold_source behavior anchors — init/is_done/step algebra contract.
// Status: §1.8 standalone non-resolve fixture.

module v4.test.claim.manual.fold_source_mvp

import v4.std.algebra { Cons, Empty }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, SyntheticOccurrence, TypeNode }
import v4.std.text { SourceFold, String, fold_source }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

type CountAcc {
  count: Int
  done: Bool
}

fn count_three_algebra() -> SourceFold<CountAcc> {
  SourceFold {
    init: fn(_source) { CountAcc { count: 0, done: false } },
    is_done: fn(acc) { acc.done },
    step: fn(acc) {
      let next = acc.count + 1
      CountAcc { count: next, done: next >= 3 }
    }
  }
}

data src_abc: String = Cons { head: 97, tail: Cons { head: 98, tail: Cons { head: 99, tail: Empty } } }

data witness_fold_source_stops_at_is_done: Bool =
  fold_source(src: src_abc, algebra: count_three_algebra()) == CountAcc { count: 3, done: true }

fn fold_source_ok_node(ok: Bool) -> Node {
  if ok {
    Node {
      kind: TypeNode { connective: Atom { identity: ^fold_source_ok_atom } },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  } else {
    Node {
      kind: TypeNode { connective: Atom { identity: ^fold_source_fail_atom } },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

fn fold_source_expected() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^fold_source_ok_atom } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

data claim_fold_source_mvp_compiles: TestClaim = CompilesClaim {
  label: "manual/fold_source_mvp: module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fold_source_ok_node(ok: true),
  expected_value: fold_source_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_fold_source_is_done_short_circuits: TestClaim = CompilesClaim {
  label: "manual/fold_source_mvp: is_done short-circuits before |src| bound",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: fold_source_ok_node(ok: witness_fold_source_stops_at_is_done),
  expected_value: fold_source_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
