// src/v4/test/claim/manual/parse_hang_finer_bisect.dag
// Scope: finer bisect of interpreted v4-parse hang (diagnostic only; not load-bearing).

module v4.test.claim.manual.parse_hang_finer_bisect

import v4.compiler.compile { Source, compile_ingest_staging_source_file }
import v4.compiler.parse {
  build_parse_table,
  grammar_has_left_recursion,
  grammar_lookup_production,
  grammar_validate_for_parse,
  parse_current_position,
  parse_expr,
  parse_prov_initial,
  parse_stage_locus_port,
  parse_table_empty,
  parse_table_fill_position,
  parse_table_fill_position_pass,
  parse_table_fill_production_step,
  ParseTableBuildAcc,
  tokens_at_position,
  token_position_indices
}
import v4.compiler.tokenize { tokenize }
import v4.extdeps.languages.dag { dag_language_model_wave1 }
import v4.std.diagnostic { Accepted, Rejected, port_locus }
import v4.std.grammar {
  GrammarProduction,
  GrammarRoot,
  ModeledGrammar,
  VoidGrammar,
  grammar_empty_sync_tokens
}
import v4.std.witness { Holds, Violates }
import v4.std.algebra { Cons, Empty, fold_list, length }
import v4.std.collection { List }
import v4.std.logic { Bool }

data finer_empty_source: Source = "module stage0.bisect.empty\n"

fn finer_dag_grammar_root() -> GrammarRoot {
  match dag_language_model_wave1().grammar {
    ModeledGrammar { root: root } => root
    VoidGrammar =>
      GrammarRoot {
        start: ^finer_void_grammar_start,
        productions: Empty,
        sync_tokens: grammar_empty_sync_tokens()
      }
  }
}

fn finer_left_recursion_terminates() -> Bool {
  let _ = grammar_has_left_recursion(root: finer_dag_grammar_root())
  true
}

fn finer_grammar_validate_terminates() -> Bool {
  match grammar_validate_for_parse(
    root: finer_dag_grammar_root(),
    at: port_locus(port: parse_stage_locus_port)
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn finer_token_position_indices_terminates() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: token_stream, diagnostics: _ } =>
      let indices = token_position_indices(tokens: token_stream.tokens)
      length(xs: indices) > 0
  }
}

fn finer_parse_expr_on_start_production_terminates() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: token_stream, diagnostics: _ } =>
      let root = finer_dag_grammar_root()
      match grammar_lookup_production(root: root, name: root.start) {
        Violates { diagnostic: _ } => true
        Holds { value: production } =>
          let _ = parse_expr(
            expr: production.expression,
            tokens: token_stream.tokens,
            all_tokens: token_stream.tokens,
            root: root,
            table: parse_table_empty(),
            prov: parse_prov_initial()
          )
          true
      }
  }
}

fn finer_one_position_fill_terminates() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: token_stream, diagnostics: _ } =>
      match lm.grammar {
        ModeledGrammar { root: root } =>
          let init = ParseTableBuildAcc {
            table: parse_table_empty(),
            prov: parse_prov_initial()
          }
          let _ = parse_table_fill_position(
            acc: init,
            position: 0,
            all_tokens: token_stream.tokens,
            root: root
          )
          true
        VoidGrammar => true
      }
  }
}

fn finer_parse_expr_named_production_at_pos1(name: Symbol) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: token_stream, diagnostics: _ } =>
      let root = finer_dag_grammar_root()
      let suffix = tokens_at_position(all_tokens: token_stream.tokens, position: 1)
      match grammar_lookup_production(root: root, name: name) {
        Violates { diagnostic: _ } => true
        Holds { value: production } =>
          let _ = parse_expr(
            expr: production.expression,
            tokens: suffix,
            all_tokens: token_stream.tokens,
            root: root,
            table: parse_table_empty(),
            prov: parse_prov_initial()
          )
          true
      }
  }
}

fn finer_parse_expr_expr_production_pos1_terminates() -> Bool {
  finer_parse_expr_named_production_at_pos1(name: ^dag_production_expr)
}

fn finer_parse_expr_stmt_production_pos1_terminates() -> Bool {
  finer_parse_expr_named_production_at_pos1(name: ^dag_production_stmt)
}

