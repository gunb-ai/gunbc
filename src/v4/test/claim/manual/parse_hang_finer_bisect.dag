fn finer_one_prod_step_after_n_warmup(name: Symbol, n: Int) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: token_stream, diagnostics: _ } =>
      match lm.grammar {
        ModeledGrammar { root: root } =>
          let warmed = finer_warmup_passes_pos1(n: n)
          match grammar_lookup_production(root: root, name: name) {
            Violates { diagnostic: _ } => true
            Holds { value: production } =>
              let _ = parse_table_fill_production_step(
                acc: warmed,
                production: production,
                position: 1,
                all_tokens: token_stream.tokens,
                root: root
              )
              true
          }
        VoidGrammar => true
      }
  }
}

fn finer_module_prod_step_after_13_warmup_terminates() -> Bool {
  finer_one_prod_step_after_n_warmup(name: ^dag_production_module, n: 13)
}

fn finer_module_prod_step_after_19_warmup_terminates() -> Bool {
  finer_one_prod_step_after_n_warmup(name: ^dag_production_module, n: 19)
}

fn finer_expr_prod_step_after_19_warmup_terminates() -> Bool {
  finer_one_prod_step_after_n_warmup(name: ^dag_production_expr, n: 19)
}

fn finer_production_count_at_least_30() -> Bool {
  length(xs: finer_dag_grammar_root().productions) >= 30
}

fn finer_production_count_is_34() -> Bool {
  length(xs: finer_dag_grammar_root().productions) == 34
}

fn finer_production_count_report() -> Bool {
  length(xs: finer_dag_grammar_root().productions) > 0
}

fn finer_current_position_at_suffix_one_is_one() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: token_stream, diagnostics: _ } =>
      let suffix = tokens_at_position(all_tokens: token_stream.tokens, position: 1)
      parse_current_position(all_tokens: token_stream.tokens, tokens: suffix) == 1
  }
}

fn finer_n_passes_at_position_one(n: Int) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: token_stream, diagnostics: _ } =>
      match lm.grammar {
        ModeledGrammar { root: root } =>
          let init = ParseTableBuildAcc {
            table: parse_table_empty(),
            prov: parse_prov_initial()
          }
          let acc = fold_list(
            xs: list_repeat_n(n: n),
            empty: init,
            cons: fn(acc2, _) {
              parse_table_fill_position_pass(
                acc: acc2,
                position: 1,
                all_tokens: token_stream.tokens,
                root: root
              )
            }
          )
          let _ = acc
          true
        VoidGrammar => true
      }
  }
}

fn list_repeat_n(n: Int) -> List<Int> {
  if n <= 0 {
    Empty
  } else {
    Cons { head: n, tail: list_repeat_n(n: n - 1) }
  }
}

fn finer_fourteen_passes_at_position_one_terminates() -> Bool {
  finer_n_passes_at_position_one(n: 14)
}

