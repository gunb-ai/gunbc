fn finer_two_position_fill_terminates() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: token_stream, diagnostics: _ } =>
      match lm.grammar {
        ModeledGrammar { root: root } =>
          let init = ParseTableBuildAcc {
            table: parse_table_empty(),
            prov: parse_prov_initial()
          }
          let after_high = parse_table_fill_position(
            acc: init,
            position: 1,
            all_tokens: token_stream.tokens,
            root: root
          )
          let _ = parse_table_fill_position(
            acc: after_high,
            position: 0,
            all_tokens: token_stream.tokens,
            root: root
          )
          true
        VoidGrammar => true
      }
  }
}

fn finer_build_parse_table_terminates() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: token_stream, diagnostics: _ } =>
      match lm.grammar {
        ModeledGrammar { root: root } =>
          let _ = build_parse_table(all_tokens: token_stream.tokens, root: root)
          true
        VoidGrammar => true
      }
  }
}
