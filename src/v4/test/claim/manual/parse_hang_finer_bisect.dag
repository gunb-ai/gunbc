fn finer_position_count_report() -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: token_stream, diagnostics: _ } =>
      length(xs: token_position_indices(tokens: token_stream.tokens)) > 1
  }
}

