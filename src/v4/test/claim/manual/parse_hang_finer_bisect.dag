fn finer_warmup_passes_pos1(n: Int) -> ParseTableBuildAcc {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } =>
      ParseTableBuildAcc { table: parse_table_empty(), prov: parse_prov_initial() }
    Accepted { value: token_stream, diagnostics: _ } =>
      match lm.grammar {
        ModeledGrammar { root: root } =>
          fold_list(
            xs: list_repeat_n(n: n),
            empty: ParseTableBuildAcc {
              table: parse_table_empty(),
              prov: parse_prov_initial()
            },
            cons: fn(acc2, _) {
              parse_table_fill_position_pass(
                acc: acc2,
                position: 1,
                all_tokens: token_stream.tokens,
                root: root
              )
            }
          )
        VoidGrammar =>
          ParseTableBuildAcc { table: parse_table_empty(), prov: parse_prov_initial() }
      }
  }
}

type FinerPrefixFillState {
  acc: ParseTableBuildAcc
  remaining: Int
  done: Bool
}

fn finer_pass14_fill_first_n_productions(n: Int) -> Bool {
  let lm = dag_language_model_wave1()
  match tokenize(
    text: finer_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: token_stream, diagnostics: _ } =>
      match lm.grammar {
        ModeledGrammar { root: root } =>
          let warmed = finer_warmup_passes_pos1(n: 13)
          let _ = fold_list(
            xs: root.productions,
            empty: FinerPrefixFillState { acc: warmed, remaining: n, done: false },
            cons: fn(state, production) {
              match state.done {
                true => state
                false =>
                  match state.remaining > 0 {
                    true =>
                      FinerPrefixFillState {
                        acc: parse_table_fill_production_step(
                          acc: state.acc,
                          production: production,
                          position: 1,
                          all_tokens: token_stream.tokens,
                          root: root
                        ),
                        remaining: state.remaining - 1,
                        done: false
                      }
                    false => FinerPrefixFillState {
                      acc: state.acc,
                      remaining: 0,
                      done: true
                    }
                  }
              }
            }
          )
          true
        VoidGrammar => true
      }
  }
}

fn finer_pass14_fill_first_25_productions_terminates() -> Bool {
  finer_pass14_fill_first_n_productions(n: 25)
}

