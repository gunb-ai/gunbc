//       claim_mvp1_translate_module_compiles, claim_mvp1_emit_module_compiles,
//       claim_mvp1_emit_add_fn_accepts, mvp1_emit_receipt, mvp1_emit_accepted_source,
//       run_mvp1_emit_add_fn_accepts, witness_mvp1_emit_accepts.
// Consumes: compiler/05_emit.dag, compiler/05_eval.dag, compiler/06_translate.dag,
//           extdeps/languages/rust.dag, test/claim/lens_common/infer_fixture.dag,
//           test/claim/manual/infer_ground_add_mvp.dag, std/cardinality.dag,
//           std/verification.dag, std/diagnostic.dag, std/node.dag, std/constraints.dag,
