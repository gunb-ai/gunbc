// src/v4/test/claim/manual/mvp1_rust_add_translate.dag
// Scope: MVP-1 T-10 receipt — translate/emit substrate + rust_mvp1 add-fn Accepted emit.
// Owns: mvp_add_arrow_node, mvp1_rust_emitted_root, mvp1_rust_inferred_tree, mvp1_rust_target_model,
//       mvp1_rust_canonical_grounding, mvp1_rust_inferred_facts_for, mvp1_rust_facts_lookup,
//       anchor_mvp1_translate_accepts, anchor_mvp1_emit_accepts,
//       claim_mvp1_translate_module_compiles, claim_mvp1_emit_module_compiles,
//       claim_mvp1_emit_add_fn_accepts, witness_mvp1_emit_accepts.
// Consumes: compiler/05_emit.dag, compiler/06_translate.dag, extdeps/languages/rust.dag,
//           test/claim/lens_common/infer_fixture.dag, std/cardinality.dag, std/verification.dag,
//           std/diagnostic.dag, std/node.dag, std/constraints.dag.
// Status: T-10 — grammar-inverse emit accepts for rust_mvp1_target_model + emitted add-fn tree.
// Anchor: docs/design-v4-compiler-homomorphism.md MVP-1 worked example.


module v4.test.claim.manual.mvp1_rust_add_translate


import v4.compiler.emit { emit }
import v4.compiler.translate { translate }
import v4.extdeps.languages.rust {
  rust_inhabitant_i32_node,
  rust_inhabitant_atom,
  rust_integer_facts_node,
  rust_int_kind_node,
  rust_int_width_node,
  rust_overflow_node,
  rust_mvp1_fixture_emitted_add_fn,
  rust_mvp1_fixture_i32_inhabitant,
  rust_mvp1_i32_overflow_disposition_node,
  rust_mvp1_i32_scalar_node,
  rust_mvp1_source_text,
  rust_mvp1_target_model,
  rust_facts_i32,
  Signed,
  Bits32,
  PanicOnOverflow,
  TwoComplementWrap,
  rust_inhabitant_i32,
  rust_surface_spelling_i32,
  rust_std_projection_int32,
  rust_tag_scalar_int,
  rust_tag_signed,
  rust_tag_bits32,
  rust_tag_panic_on_overflow,
  rust_tag_two_complement_wrap
}
import v4.compiler.infer { InferredFacts, InferredTree }
import v4.compiler.target_carriers { TargetModel, TargetSource }
import v4.test.claim.lens_common.infer_fixture { claim_inferred_facts_witness }
import v4.std.cardinality { TerminationProof, termination_proof_witness_for_node }
import v4.std.collection { Map }
import v4.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness,
  constraint_property_being_canonical,
  constraint_property_candidate_set_closedness
}
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  node_locus
}
import v4.std.node {
  Atom,
  Arrow,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v4.std.verification {
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  CompilesClaim,
  manual_claim_anchor
}
import v4.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }


data mvp_add_int_atom: Symbol = mvp_add_int_atom
data mvp1_rust_grounding_miss: Symbol = mvp1_rust_grounding_miss


fn mvp_int_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: mvp_add_int_atom } },
    children: []
  }
}


data mvp_add_arrow_node: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: mvp_int_node() },
    Edge { label: Positional, target: mvp_int_node() },
    Edge { label: Positional, target: mvp_int_node() }
  ]
}


data mvp1_rust_emitted_root: Node = rust_mvp1_fixture_emitted_add_fn


data mvp1_rust_target_model: TargetModel = rust_mvp1_target_model()


fn mvp1_rust_i32_facts_node() -> Node {
  rust_integer_facts_node(facts: rust_facts_i32)
}


fn mvp1_rust_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}


// Per-node canonical grounding derived from rust_facts_i32 / inhabitant constructors (no Atom→i32 fabrication).
// 🟡 gated — feature:W-T-10-mvp1-inferred-tree-grounding — bind TASKS.md W-T-10 — dissolve-on: infer-authored facts replace hand-enumerated MVP fixture grounding; forbidden: generic algebra-evidence assignment across unrelated Atoms.
fn mvp1_rust_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == rust_mvp1_fixture_emitted_add_fn {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_mvp1_fixture_i32_inhabitant {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: mvp1_rust_i32_facts_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: rust_inhabitant_i32) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: rust_mvp1_fixture_i32_inhabitant
      )
    }
  } else if node == mvp1_rust_i32_facts_node() {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_inhabitant_atom(id: rust_surface_spelling_i32) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: mvp1_rust_i32_facts_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: rust_std_projection_int32) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: mvp1_rust_i32_facts_node()
      )
    }
  } else if node == rust_int_kind_node(kind: Signed) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: mvp1_rust_i32_facts_node()
      )
    }
  } else if node == rust_int_width_node(width: Bits32) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: mvp1_rust_i32_facts_node()
      )
    }
  } else if node == rust_mvp1_i32_overflow_disposition_node() {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == rust_mvp1_i32_scalar_node() {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: mvp1_rust_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: rust_tag_scalar_int) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: rust_mvp1_i32_scalar_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: rust_tag_signed) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: rust_mvp1_i32_scalar_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: rust_tag_bits32) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: rust_mvp1_i32_scalar_node()
      )
    }
  } else if node == rust_overflow_node(overflow: PanicOnOverflow) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: rust_mvp1_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_overflow_node(overflow: TwoComplementWrap) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: rust_mvp1_i32_overflow_disposition_node()
      )
    }
  } else if node == rust_inhabitant_atom(id: rust_tag_panic_on_overflow) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: rust_overflow_node(overflow: PanicOnOverflow)
      )
    }
  } else if node == rust_inhabitant_atom(id: rust_tag_two_complement_wrap) {
    Holds {
      value: mvp1_rust_canonical_grounding(
        node: node,
        algebra: rust_overflow_node(overflow: TwoComplementWrap)
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: mvp1_rust_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}


fn mvp1_rust_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match mvp1_rust_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}


fn mvp1_rust_facts_lookup(key: Node) -> Witness<InferredFacts> {
  mvp1_rust_inferred_facts_for(node: key)
}


data mvp1_rust_inferred_tree: InferredTree = InferredTree {
  root: mvp1_rust_emitted_root,
  facts: Map {
    lookup: fn(key) {
      mvp1_rust_facts_lookup(key: key)
    }
  }
}


fn anchor_mvp1_translate_accepts() -> Outcome<Node> {
  translate(tree: mvp1_rust_inferred_tree, target: mvp1_rust_target_model)
}


fn anchor_mvp1_emit_accepts() -> Outcome<TargetSource> {
  emit(tree: mvp1_rust_inferred_tree, target: mvp1_rust_target_model)
}


// Compile-time witness: anchor_mvp1_emit_accepts must return Accepted with canonical MVP-1 source.
// T-22 eval receipt is needed for runtime TestClaimRun execution over Outcome<TargetSource> carriers.
data witness_mvp1_emit_accepts: Bool = match anchor_mvp1_emit_accepts() {
  Accepted { value: source, diagnostics: d } =>
    (source == rust_mvp1_source_text) && (d == None)
  Rejected { diagnostics: _ } => false
}


data mvp1_emit_witness_fail_atom: Symbol = mvp1_emit_witness_fail_atom


fn mvp1_emit_witness_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: mvp1_emit_witness_fail_atom } },
    children: []
  }
}


fn mvp1_emit_accepts_claim_input(ok: Bool) -> Node {
  if ok {
    mvp1_rust_emitted_root
  } else {
    mvp1_emit_witness_fail_node()
  }
}


data claim_mvp1_translate_module_compiles: TestClaim = CompilesClaim {
  label: "manual/mvp1: translate stage module + coercion_fold call-site compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: mvp_add_arrow_node,
  expected_value: mvp_add_arrow_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_mvp1_emit_module_compiles: TestClaim = CompilesClaim {
  label: "manual/mvp1: emit stage module (serialize_target o translate) compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: mvp_add_arrow_node,
  expected_value: mvp_add_arrow_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_mvp1_emit_add_fn_accepts: TestClaim = CompilesClaim {
  label: "manual/mvp1: anchor_mvp1_emit_accepts Accepted on rust_mvp1 add-fn fixture (compile witness; T-22 for eval receipt)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: mvp1_emit_accepts_claim_input(ok: witness_mvp1_emit_accepts),
  expected_value: mvp1_rust_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
