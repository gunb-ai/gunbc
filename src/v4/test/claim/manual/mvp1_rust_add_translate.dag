// src/v4/test/claim/manual/mvp1_rust_add_translate.dag
// Scope: MVP-1 T-10 receipt — InferredTree(add) + modeled rust target bundle -> emit (coercion fold path).
// Owns: mvp_add_* fixtures, mvp_rust_target_bundle, claim_mvp1_translate_add_compiles, claim_mvp1_emit_add_rejects_until_find_witness.
// Consumes: compiler/05_emit.dag, compiler/06_translate.dag, compiler/04_infer.dag, std/verification.dag, std/diagnostic.dag, std/node.dag, std/cardinality.dag, std/collection.dag, std/find_witness.dag, std/text.dag.
// Status: structural receipt — Accepted path blocked on std/find_witness body + extdeps rust LanguageModel bundle.
// Anchor: docs/design-v4-compiler-homomorphism.md MVP-1 worked example.


module v4.test.claim.manual.mvp1_rust_add_translate


import v4.compiler.emit { emit }
import v4.compiler.infer {
  AlgebraRef,
  InferredFacts,
  InferredTree
}
import v4.compiler.translate {
  mvp1_rust_add_source_key,
  target_model_edge_declared_inhabitants,
  target_model_edge_selection_policy,
  target_model_edge_serialize_emitted,
  target_model_edge_serialize_source,
  translate
}
import v4.std.cardinality { RankingDimension, TerminationProof }
import v4.std.collection { Map }
import v4.std.diagnostic {
  Accepted,
  Correction,
  Diagnostic,
  ExternalContractUnknown,
  NodeLocus,
  None,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  Unavailable
}
import v4.std.find_witness { find_witness_reason_not_realized }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v4.std.text { String }
import v4.std.verification {
  Compiles,
  Equals,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit
}
import v4.std.witness { Holds }
data mvp_add_int_atom: Symbol = mvp_add_int_atom
data mvp_rust_i32_atom: Symbol = mvp_rust_i32_atom
fn mvp_int_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: mvp_add_int_atom } },
    children: []
  }
}
fn mvp_rust_i32_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: mvp_rust_i32_atom } },
    children: []
  }
}
fn mvp_add_arrow_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: mvp_int_node() },
      Edge { label: Positional, target: mvp_int_node() },
      Edge { label: Positional, target: mvp_int_node() }
    ]
  }
}
data mvp_stub_ranking_symbol: Symbol = mvp_stub_ranking_symbol
data mvp_stub_algebra_ref: AlgebraRef = AlgebraRef {
  algebra: mvp_add_arrow_node(),
  witness: mvp_add_arrow_node()
}
data mvp_stub_ranking_dim: RankingDimension = RankingDimension {
  measured: mvp_stub_ranking_symbol
}
data mvp_stub_termination_proof: TerminationProof = TerminationProof {
  non_increasing: [],
  strict: mvp_stub_ranking_dim
}
data mvp_stub_inferred_facts: InferredFacts = InferredFacts {
  resolved_type: mvp_int_node(),
  inhabits: mvp_stub_algebra_ref,
  descent: mvp_stub_termination_proof
}
fn mvp_rust_target_bundle() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: target_model_edge_selection_policy },
        target: mvp_rust_i32_node()
      },
      Edge {
        label: Named { name: target_model_edge_declared_inhabitants },
        target: mvp_rust_i32_node()
      },
      Edge {
        label: Named { name: target_model_edge_serialize_emitted },
        target: mvp_rust_i32_node()
      },
      Edge {
        label: Named { name: target_model_edge_serialize_source },
        target: Node {
          kind: TypeNode { connective: Atom { identity: mvp1_rust_add_source_key } },
          children: []
        }
      }
    ]
  }
}
data mvp_add_inferred_tree: InferredTree = InferredTree {
  root: mvp_add_arrow_node(),
  facts: Map<Node, InferredFacts> {
    lookup: fn(_key: Node) {
      Holds { value: mvp_stub_inferred_facts }
    }
  }
}
fn mvp1_translate_add() -> Outcome<Node> {
  translate(tree: mvp_add_inferred_tree, target: mvp_rust_target_bundle())
}
fn mvp1_emit_add() -> Outcome<String> {
  emit(tree: mvp_add_inferred_tree, target: mvp_rust_target_bundle())
}
data claim_mvp1_translate_add_compiles: TestClaim = TestClaim {
  kind: Compiles,
  label: "manual/mvp1: translate(add) coercion-fold body is structurally inhabitable",
  t19_anchor: T19ManualAnchorAbsent,
  input: mvp_add_arrow_node(),
  expected: Accepted { value: mvp_add_arrow_node(), diagnostics: None },
  classification: TestClassification { tier: Tier1, layer: Unit }
}
data claim_mvp1_emit_add_rejects_until_find_witness: TestClaim = TestClaim {
  kind: Equals,
  label: "manual/mvp1: emit(add) fail-closed until std/find_witness exact-zip-fold body lands",
  t19_anchor: T19ManualAnchorAbsent,
  input: mvp_add_arrow_node(),
  expected: Rejected {
    diagnostics: NonEmptyDiagnostics {
      head: Diagnostic {
        reason: find_witness_reason_not_realized,
        at: NodeLocus { node: mvp_add_arrow_node() },
        correction: Unavailable { reason: ExternalContractUnknown }
      },
      tail: []
    }
  },
  classification: TestClassification { tier: Tier1, layer: Unit }
}
