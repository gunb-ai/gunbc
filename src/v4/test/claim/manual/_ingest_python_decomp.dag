// TEMPORARY decomposition probe — pinpoints where python->ts breaks. Delete after.
module v4.test.claim.manual.ingest_python_decomp

import v4.compiler.ingest { cross_language_compile, parse_tree_to_target_model_bridge }
import v4.compiler.infer { infer }
import v4.compiler.emit { emit }
import v4.test.claim.manual.python_mvp1_grammar_claim { python_mvp1_grammar_parse_fixture }
import v4.extdeps.languages.python { python_mvp1_target_model }
import v4.extdeps.languages.typescript { ts_mvp1_target_model }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.node { Symbol }

fn python_decomp() -> Symbol {
  match python_mvp1_grammar_parse_fixture() {
    Rejected { diagnostics: _ } => ^break_parse
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_target_model_bridge(parse_tree: tree, source_model: python_mvp1_target_model()) {
        Rejected { diagnostics: _ } => ^break_bridge
        Accepted { value: core, diagnostics: _ } =>
          match infer(tree: core) {
            Rejected { diagnostics: _ } => ^break_infer
            Accepted { value: inferred, diagnostics: _ } =>
              match emit(tree: inferred, target: python_mvp1_target_model()) {
                Rejected { diagnostics: _ } =>
                  match emit(tree: inferred, target: ts_mvp1_target_model()) {
                    Rejected { diagnostics: _ } => ^break_emit_both
                    Accepted { value: _, diagnostics: _ } => ^break_emit_python_only
                  }
                Accepted { value: _, diagnostics: _ } =>
                  match emit(tree: inferred, target: ts_mvp1_target_model()) {
                    Rejected { diagnostics: _ } => ^break_emit_ts_only
                    Accepted { value: _, diagnostics: _ } => ^all_ok
                  }
              }
          }
      }
  }
}
