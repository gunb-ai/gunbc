data claim_mvp1_python_serialize_rejects_missing_translation_rules: TestClaim = DiagnosticClaim {
  label: "manual/mvp1: target_serialize_source_from_model rejects python bundle missing translation_rules",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: mvp1_python_emitted_root,
  expected_rejection: diagnostics_singleton(
    d: Diagnostic {
      reason: translate_target_bundle_malformed,
      at: node_locus(node: mvp1_python_empty_translation_rules_bundle),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  ),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data subject_mvp1_python_serialize_rejects_missing_translation_rules: TestClaimEvalSubject<Node> = TestClaimEvalSubject {
  claim: claim_mvp1_python_serialize_rejects_missing_translation_rules,
  context: infer_receipt_context(),
  tree: mvp1_python_inferred_tree,
  input: test_claim_typed_input_node(
    evaluator_input: mvp1_python_emitted_root,
    evaluator_pin: ^infer_receipt_input_infer_add_mvp
  )
}

