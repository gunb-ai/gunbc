import v4.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }
data mvp1_python_forbidden_authority_source_text: TargetSource = "authority_source_text_fallback_forbidden"

data mvp1_python_int_inhabitant: Node = python_int_inhabitant_node()

data mvp1_python_emitted_root: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: mvp1_python_int_inhabitant },
    Edge { label: Positional, target: mvp1_python_int_inhabitant },
    Edge { label: Positional, target: mvp1_python_int_inhabitant }
  ],
  occurrence_id: SyntheticOccurrence
}

data mvp1_python_int_facts_node: Node = python_integer_facts_node(facts: python_facts_int)

data mvp1_python_target_model: TargetModel = python_mvp1_target_model()

data mvp1_python_poisoned_authority_target_model: TargetModel = TargetModel {
  bundle: python_mvp1_target_model_node(),
  lex: python_wave1_lex(),
  binding_spellings: python_mvp1_binding_spellings(),
  authority_source_text: mvp1_python_forbidden_authority_source_text
}

data mvp1_python_empty_translation_rules_bundle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data mvp1_python_missing_translation_rules_target: TargetModel = TargetModel {
  bundle: mvp1_python_empty_translation_rules_bundle,
  lex: python_wave1_lex(),
  binding_spellings: empty_map(),
  authority_source_text: ""
}

fn anchor_mvp1_python_serialize_rejects_missing_translation_rules() -> Outcome<TargetSource> {
  target_serialize_source_from_model(
    target: mvp1_python_missing_translation_rules_target,
    emitted: mvp1_python_emitted_root
  )
}

data mvp1_python_serialize_reject_receipt: Outcome<TargetSource> = anchor_mvp1_python_serialize_rejects_missing_translation_rules()

fn mvp1_python_serialize_reject_claim_outcome() -> Outcome<Node> {
  match mvp1_python_serialize_reject_receipt {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: ^mvp1_python_serialize_unexpected_accept,
            at: node_locus(node: mvp1_python_emitted_root),
            correction: Unavailable { reason: ExternalContractUnknown }
          }
        )
      }
  }
}

fn mvp1_python_canonical_grounding(
  node: Node,
  algebra: Node
) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

// 🟡 gated — feature:W-T-10-mvp1-inferred-tree-grounding — bind gunbc#4760 — dissolve-on: infer-authored facts replace hand-enumerated MVP fixture grounding.
fn mvp1_python_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == mvp1_python_emitted_root {
    Holds {
      value: mvp1_python_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == mvp1_python_int_inhabitant {
    Holds {
      value: mvp1_python_canonical_grounding(
        node: node,
        algebra: mvp1_python_int_facts_node
      )
    }
  } else if node == python_inhabitant_atom(id: ^python_inhabitant_int) {
    Holds {
      value: mvp1_python_canonical_grounding(
        node: node,
        algebra: mvp1_python_int_inhabitant
      )
    }
  } else if node == mvp1_python_int_facts_node {
    Holds {
      value: mvp1_python_canonical_grounding(
        node: node,
        algebra: node
      )
    }
  } else if node == python_inhabitant_atom(id: ^python_surface_spelling_int) {
    Holds {
      value: mvp1_python_canonical_grounding(
        node: node,
        algebra: mvp1_python_int_facts_node
      )
    }
  } else if node == python_inhabitant_atom(id: ^python_repr_int_arbitrary_precision) {
    Holds {
      value: mvp1_python_canonical_grounding(
        node: node,
        algebra: mvp1_python_int_facts_node
      )
    }
  } else if node == python_inhabitant_atom(id: std_projection_additive_numeric) {
    Holds {
      value: mvp1_python_canonical_grounding(
        node: node,
        algebra: mvp1_python_int_facts_node
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^mvp1_python_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn mvp1_python_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match mvp1_python_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn mvp1_python_facts_lookup(key: Node) -> Witness<InferredFacts> {
  mvp1_python_inferred_facts_for(node: key)
}

data mvp1_python_inferred_tree: InferredTree = InferredTree {
  root: mvp1_python_emitted_root,
  facts: Map {
    lookup: mvp1_python_facts_lookup
  }
}

fn anchor_mvp1_python_emit_accepts() -> Outcome<TargetSource> {
  emit(tree: mvp1_python_inferred_tree, target: mvp1_python_target_model)
}

fn anchor_mvp1_python_compile_inferred_accepts() -> Outcome<CompileOutput> {
  compile_inferred(
    inferred: mvp1_python_inferred_tree,
    mode: TranslateTo { target: mvp1_python_poisoned_authority_target_model }
  )
}

data mvp1_python_emit_receipt: Outcome<TargetSource> = anchor_mvp1_python_emit_accepts()

// R2 keystone execution witness — emit(add) must produce the canonical python_mvp1 add-fn source.
test fn mvp1_python_emit_add_fn_accepts_holds() -> Bool {
  match mvp1_python_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source == python_mvp1_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

data mvp1_python_compile_inferred_receipt: Outcome<CompileOutput> = anchor_mvp1_python_compile_inferred_accepts()

// 🟡 gated — feature:W-T-10-mvp1-emit-outcome-testclaim — bind gunbc#4757 — dissolve-on: Outcome<TargetSource> eval runner replaces structural projection; forbidden: CompilesClaim sentinel-node bridge that drops Rejected diagnostics.
// Project emit Outcome<TargetSource> to Outcome<Node> for TestClaim assert; Rejected diagnostics preserved.
fn mvp1_python_emit_claim_outcome() -> Outcome<Node> {
  match mvp1_python_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      if (source == python_mvp1_source_text) && (d == None) {
        Accepted { value: mvp1_python_emitted_root, diagnostics: None }
      } else {
        Rejected {
          diagnostics: diagnostics_singleton(
            d: Diagnostic {
              reason: ^mvp1_python_emit_source_mismatch,
              at: node_locus(node: mvp1_python_emitted_root),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

// 🟡 gated — feature:W-T-11-mvp1-compile-output-testclaim — bind gunbc#4757 — dissolve-on: Outcome<CompileOutput> eval runner replaces structural projection; forbidden: CompilesClaim sentinel-node bridge that drops Rejected diagnostics.
// Project compile Output to Outcome<Node> for TestClaim assert; Rejected diagnostics preserved.
fn mvp1_python_compile_inferred_claim_outcome() -> Outcome<Node> {
  match mvp1_python_compile_inferred_receipt {
    Accepted { value: compile_result, diagnostics: d } =>
      match compile_result {
        TranslateResult { source } =>
          if (source == python_mvp1_source_text) && (d == None) {
            Accepted { value: mvp1_python_emitted_root, diagnostics: None }
          } else {
            Rejected {
              diagnostics: diagnostics_singleton(
                d: Diagnostic {
                  reason: ^mvp1_python_compile_source_mismatch,
                  at: node_locus(node: mvp1_python_emitted_root),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }
              )
            }
          }
        _ =>
          Rejected {
            diagnostics: diagnostics_singleton(
              d: Diagnostic {
                reason: ^mvp1_python_compile_source_mismatch,
                at: node_locus(node: mvp1_python_emitted_root),
                correction: Unavailable { reason: ExternalContractUnknown }
              }
            )
          }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

data claim_mvp1_python_emit_add_fn_accepts: TestClaim = CompilesClaim {
  label: "manual/mvp1: anchor_mvp1_python_emit_accepts with canonical python_mvp1 add-fn source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: mvp1_python_emitted_root,
  expected_value: mvp1_python_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_mvp1_python_compile_inferred_add_fn_accepts: TestClaim = CompilesClaim {
  label: "manual/mvp1: compile_inferred emits canonical python_mvp1 add-fn source through grammar inverse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: mvp1_python_emitted_root,
  expected_value: mvp1_python_emitted_root,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

// T-22 TestClaimRun receipt — structural assert over projected emit Outcome<Node> via run_test_claim_assert (Verdict<Node>).
// 🟡 gated — feature:W-T-10-mvp1-emit-outcome-testclaim — bind gunbc#4757 — dissolve-on: Outcome<TargetSource> eval runner replaces structural projection; forbidden: CompilesClaim sentinel-node bridge that drops Rejected diagnostics.
data subject_mvp1_python_emit_add_fn_accepts: TestClaimEvalSubject<Node> = TestClaimEvalSubject {
  claim: claim_mvp1_python_emit_add_fn_accepts,
  context: infer_receipt_context(),
  tree: mvp1_python_inferred_tree,
  input: test_claim_typed_input_node(
    evaluator_input: mvp1_python_emitted_root,
    evaluator_pin: ^infer_receipt_input_infer_add_mvp
  )
}

data run_mvp1_python_emit_add_fn_accepts: TestClaimRun<Node, Node> = TestClaimRun {
  cache: test_claim_cache_receipt(subject: subject_mvp1_python_emit_add_fn_accepts),
  verdict: run_test_claim_assert(
    claim: claim_mvp1_python_emit_add_fn_accepts,
    actual: mvp1_python_emit_claim_outcome(),
    at: mvp1_python_emitted_root
  )
}

