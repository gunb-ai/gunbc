// src/v4/test/claim/manual/timeseries_passive_map_fold_anchor.dag
// Scope: S1 compile + behavior anchor — TimeSeriesSignal + R/L/C map/fold step operators.
// Status: compile-only IN-B anchor; validates std.timeseries_signal step operators wire through v4.

module v4.test.claim.manual.timeseries_passive_map_fold_anchor

import v4.std.algebra { Cons, Empty }
import v4.std.collection { List }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.nat { Zero }
import v4.std.timeseries_signal {
  CapacitorFold,
  CapacitorRating,
  CapacitorState,
  FoldStep,
  InductorFold,
  InductorRating,
  InductorState,
  MapStep,
  ResistorMap,
  ResistorRating,
  StepBranchVoltage,
  StepCurrent,
  StepPotentialDifference,
  TimeSeriesSample,
  TimeSeriesSignal,
  TimeStep,
  capacitor_fold_step,
  fold_capacitor_transient,
  inductor_fold_step,
  resistor_map_voltage,
}
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor,
}

data timeseries_anchor_resistor: ResistorMap = ResistorMap {
  kind: MapStep
  rating: ResistorRating { microohms: 1000 }
}

data timeseries_anchor_current: StepCurrent = StepCurrent { microamperes: 2 }

data timeseries_anchor_capacitor: CapacitorFold = CapacitorFold {
  kind: FoldStep
  rating: CapacitorRating { microfarads: 2 }
}

data timeseries_anchor_cap_initial: CapacitorState = CapacitorState {
  voltage: StepPotentialDifference { microvolts: 0 }
  charge_microcoulombs: 0
}

data timeseries_anchor_inductor: InductorFold = InductorFold {
  kind: FoldStep
  rating: InductorRating { microhenries: 2 }
}

data timeseries_anchor_ind_initial: InductorState = InductorState {
  current: StepCurrent { microamperes: 0 }
  flux_microwebers: 0
}

data timeseries_anchor_voltage: StepBranchVoltage = StepBranchVoltage {
  difference: StepPotentialDifference { microvolts: 4 }
}

data timeseries_anchor_dt: TimeStep = TimeStep { dt_microseconds: 1000 }

data timeseries_anchor_tick0: TimeSeriesSample = TimeSeriesSample {
  tick: Zero
  microvolts: 0
}

data timeseries_anchor_signal: TimeSeriesSignal = Cons {
  head: timeseries_anchor_tick0,
  tail: Empty
}

fn timeseries_anchor_resistor_map_holds() -> Bool {
  let mapped = resistor_map_voltage(
    element: timeseries_anchor_resistor,
    current: timeseries_anchor_current,
  )
  mapped.difference.microvolts == 2000
}

fn timeseries_anchor_capacitor_fold_holds() -> Bool {
  match capacitor_fold_step(
    element: timeseries_anchor_capacitor,
    state: timeseries_anchor_cap_initial,
    current: timeseries_anchor_current,
    dt: timeseries_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      stepped.charge_microcoulombs == 2000
        && stepped.voltage.microvolts == 1000
    Rejected { diagnostics: _ } => false
  }
}

data timeseries_anchor_current_low: StepCurrent = StepCurrent { microamperes: 2 }

data timeseries_anchor_current_high: StepCurrent = StepCurrent { microamperes: 4 }

data timeseries_anchor_current_pair: List<StepCurrent> = Cons {
  head: timeseries_anchor_current_low,
  tail: Cons { head: timeseries_anchor_current_high, tail: Empty }
}

fn timeseries_anchor_capacitor_fold_chronological_holds() -> Bool {
  match fold_capacitor_transient(
    element: timeseries_anchor_capacitor,
    initial: timeseries_anchor_cap_initial,
    currents: timeseries_anchor_current_pair,
    dt: timeseries_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      stepped.voltage.microvolts == 3000
    Rejected { diagnostics: _ } => false
  }
}

data timeseries_anchor_cap_zero_rating: CapacitorFold = CapacitorFold {
  kind: FoldStep
  rating: CapacitorRating { microfarads: 0 }
}

fn timeseries_anchor_capacitor_zero_rating_rejects() -> Bool {
  match capacitor_fold_step(
    element: timeseries_anchor_cap_zero_rating,
    state: timeseries_anchor_cap_initial,
    current: timeseries_anchor_current,
    dt: timeseries_anchor_dt,
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn timeseries_anchor_inductor_fold_holds() -> Bool {
  match inductor_fold_step(
    element: timeseries_anchor_inductor,
    state: timeseries_anchor_ind_initial,
    voltage: timeseries_anchor_voltage,
    dt: timeseries_anchor_dt,
  ) {
    Accepted { value: stepped, diagnostics: _ } =>
      stepped.flux_microwebers == 4000
        && stepped.current.microamperes == 2000
    Rejected { diagnostics: _ } => false
  }
}

data claim_timeseries_resistor_map: TestClaim = BoolWitnessClaim {
  label: "manual/timeseries_passive_map_fold_anchor: resistor map v=R·i",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: timeseries_anchor_resistor_map_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_timeseries_capacitor_fold: TestClaim = BoolWitnessClaim {
  label: "manual/timeseries_passive_map_fold_anchor: capacitor fold step",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: timeseries_anchor_capacitor_fold_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_timeseries_capacitor_fold_chronological: TestClaim = BoolWitnessClaim {
  label: "manual/timeseries_passive_map_fold_anchor: capacitor fold chronological",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: timeseries_anchor_capacitor_fold_chronological_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_timeseries_capacitor_zero_rejects: TestClaim = BoolWitnessClaim {
  label: "manual/timeseries_passive_map_fold_anchor: capacitor zero rating rejects",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: timeseries_anchor_capacitor_zero_rating_rejects() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_timeseries_inductor_fold: TestClaim = BoolWitnessClaim {
  label: "manual/timeseries_passive_map_fold_anchor: inductor fold step",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: timeseries_anchor_inductor_fold_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_timeseries_passive_map_fold_compiles: TestClaim = CompilesClaim {
  label: "manual/timeseries_passive_map_fold_anchor: S1 map/fold passives compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: timeseries_anchor_resistor,
  expected_value: timeseries_anchor_resistor,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
