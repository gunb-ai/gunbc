// Scope: witness for the `discriminant(v) -> Symbol` intrinsic — a coproduct value
//        reifies its own constructor name as a Symbol, dissolving the hand-written
//        `fn ..._discriminant(v) { match v { Ctor{..} => ctor_tag ... } }` bridges that
//        shadow a coproduct's arm-set with a parallel `data ctor_tag: Symbol` vocabulary.
// Status: claim-run witness (fn () -> Bool); discriminates (payload-blind, arm-sharp).

module v4.test.claim.manual.discriminant_intrinsic


import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
// A local coproduct — two arms, each with a payload, so the witness proves the
// discriminant is keyed on the CONSTRUCTOR, not the payload.
type DiscriminantProbeShape
  = ProbeAlpha { x: Int }
  | ProbeBeta { y: Int }

// The intrinsic: derives the constructor's own name as a Symbol with zero per-type code.
// (Two ProbeAlpha values with different payloads share a discriminant; a ProbeAlpha and a
//  ProbeBeta do not.) This is the property every hand-written `_discriminant` bridge encodes
//  arm-by-arm — here it falls out of the constructor name for free.
test fn discriminant_intrinsic_is_payload_blind_and_arm_sharp() -> Bool {
  let alpha_one = ProbeAlpha { x: 1 }
  let alpha_two = ProbeAlpha { x: 99 }
  let beta_one = ProbeBeta { y: 1 }

  let same_arm_equal = discriminant(v: alpha_one) == discriminant(v: alpha_two)
  let cross_arm_distinct = (discriminant(v: alpha_one) == discriminant(v: beta_one)) == false

  same_arm_equal && cross_arm_distinct
}
