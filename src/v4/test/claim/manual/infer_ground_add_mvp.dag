// src/v4/test/claim/manual/infer_ground_add_mvp.dag
// Scope: T-9 worked fixture — ResolvedTree for MVP add-shaped Arrow; executable infer/descent receipts.
// Owns: fixture_add_resolved_tree, anchor_infer_add_mvp, infer_descent_witness_contract_node, claim rows, TestClaimRun receipts.
// Consumes: compiler/04_infer.dag, compiler/05_eval.dag, std/diagnostic.dag, std/node.dag, std/verification.dag.
// Status: infer rejects infer_descent_not_derived before solve_constraints until TerminationProof is derived.
// Anchor: design-v4-compiler-homomorphism.md MVP add(x,y)=x+y


module v4.test.claim.manual.infer_ground_add_mvp


import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  TestClaimTypedInput,
  Verdict,
  Fail,
  Pass,
  test_claim_cache_receipt
}
import v4.compiler.infer {
  infer,
  infer_descent_not_derived_diagnostic,
  infer_descent_witness_for_node,
  InferredTree
}
import v4.compiler.resolve { ResolvedTree }
import v4.std.collection { Map }
import v4.std.diagnostic {
  Accepted,
  NonEmptyDiagnostics,
  None,
  Outcome,
  Rejected,
  diagnostics_singleton,
  outcome_node_eq
}
import v4.std.host { HostModel }
import v4.std.node {
  Arrow,
  Atom,
  Conj,
  Edge,
  Hash,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v4.std.verification {
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  CompilesClaim,
  DiagnosticClaim,
  test_claim_expected_outcome,
  test_claim_input
}
import v4.std.witness { Holds, Violates }


data fixture_add_name: Symbol = fixture_add_name
data fixture_add_int_atom: Symbol = fixture_add_int_atom
data fixture_add_body_int_atom: Symbol = fixture_add_body_int_atom
data infer_receipt_host: HostModel = infer_receipt_host
data infer_receipt_input_infer_add_mvp: Symbol = infer_receipt_input_infer_add_mvp
data infer_receipt_input_descent_witness: Symbol = infer_receipt_input_descent_witness
// 🟡 cache-hash scaffold — T22-EVAL-CACHE-HASHES
data claim_hash_placeholder: Hash = claim_hash_placeholder
data host_hash_placeholder: Hash = host_hash_placeholder


// Receipt bridge: polarity-specific carriers (no broad Outcome<Node> after TestClaim split).
// 🟡 coproduct dissolution — LB-P4-3212 — feature: infer-receipt-testclaim-bridge — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: direct TestClaim constructors per receipt row (forbidden: Outcome<Node> bridge that drops diagnostics).
type InferReceiptCase
// 🟡 coproduct dissolution — LB-P4-3212
  = InferDiagnosticReceiptCase {
      label: String
      input_symbol: Symbol
      input: Node
      expected_rejection: NonEmptyDiagnostics
    }
  | InferCompilesReceiptCase {
      label: String
      input_symbol: Symbol
      input: Node
      expected_value: Node
    }


fn fixture_int_type_node(atom: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: atom } },
    children: []
  }
}


fn infer_receipt_symbol_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


fn infer_receipt_case_input(case: InferReceiptCase) -> Node {
  match case {
    InferDiagnosticReceiptCase { input: input, label: _, input_symbol: _, expected_rejection: _ } => input
    InferCompilesReceiptCase { input: input, label: _, input_symbol: _, expected_value: _ } => input
  }
}


fn infer_receipt_claim(case: InferReceiptCase) -> TestClaim {
  match case {
    InferDiagnosticReceiptCase {
      label: label,
      input_symbol: _,
      input: input,
      expected_rejection: r
    } =>
      DiagnosticClaim {
        label: label,
        t19_anchor: T19ManualAnchorAbsent,
        input: input,
        expected_rejection: r,
        classification: TestClassification { tier: Tier1, layer: Unit }
      }
    InferCompilesReceiptCase {
      label: label,
      input_symbol: _,
      input: input,
      expected_value: v
    } =>
      CompilesClaim {
        label: label,
        t19_anchor: T19ManualAnchorAbsent,
        input: input,
        expected_value: v,
        classification: TestClassification { tier: Tier1, layer: Unit }
      }
  }
}


fn infer_receipt_context() -> EvalContext {
  EvalContext {
    host: infer_receipt_host
  }
}


fn infer_receipt_empty_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: fn(_) {
        Violates {
          diagnostic: infer_descent_not_derived_diagnostic(n: root)
        }
      }
    }
  }
}


fn infer_receipt_subject(case: InferReceiptCase) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: infer_receipt_claim(case: case),
    context: infer_receipt_context(),
    tree: infer_receipt_empty_tree(root: infer_receipt_case_input(case: case)),
    input: TestClaimTypedInput { evaluator_input: infer_receipt_case_input(case: case) }
  }
}


// Project infer's Outcome<InferredTree> to Outcome<Node> for DiagnosticClaim rejection compare only.
fn infer_outcome_node_projection(actual: Outcome<InferredTree>) -> Outcome<Node> {
  match actual {
    Accepted { value: tree, diagnostics: ad } =>
      Accepted { value: tree.root, diagnostics: ad }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}


fn infer_add_mvp_receipt_run(
  subject: TestClaimEvalSubject<Node>,
) -> TestClaimRun<InferredTree> {
  let actual = anchor_infer_add_mvp()
  TestClaimRun {
    cache: test_claim_cache_receipt(
      subject: subject,
      claim_hash: claim_hash_placeholder,
      host_hash: host_hash_placeholder
    ),
    verdict: match test_claim_expected_outcome(c: subject.claim) {
      Accepted { value: expected, diagnostics: _ } =>
        match actual {
          Rejected { diagnostics: _ } =>
            if outcome_node_eq(
              a: infer_outcome_node_projection(actual: actual),
              b: expected
            ) {
              Pass
            } else {
              Fail { actual: actual }
            }
          Accepted { value: _, diagnostics: _ } => Fail { actual: actual }
        }
      Rejected { diagnostics: _ } => Fail { actual: actual }
    }
  }
}


fn infer_descent_witness_receipt_run(
  subject: TestClaimEvalSubject<Node>,
) -> TestClaimRun<Node> {
  let actual = infer_descent_witness_contract_node(n: subject.input.evaluator_input)
  TestClaimRun {
    cache: test_claim_cache_receipt(
      subject: subject,
      claim_hash: claim_hash_placeholder,
      host_hash: host_hash_placeholder
    ),
    verdict: match test_claim_expected_outcome(c: subject.claim) {
      Accepted { value: expected, diagnostics: _ } =>
        match actual {
          Accepted { value: v, diagnostics: d } =>
            if outcome_node_eq(a: Accepted { value: v, diagnostics: d }, b: expected) {
              Pass
            } else {
              Fail { actual: actual }
            }
          Rejected { diagnostics: r } => Fail { actual: Rejected { diagnostics: r } }
        }
      Rejected { diagnostics: r } => Fail { actual: Rejected { diagnostics: r } }
    }
  }
}


// MVP add(x: Int, y: Int) -> Int = x + y as a resolved CoreNode-shaped Arrow (domain, codomain, body).
fn fixture_add_resolved_tree() -> ResolvedTree {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: fixture_add_name },
        target: Node {
          kind: TypeNode { connective: Arrow },
          children: [
            Edge {
              label: Positional,
              target: fixture_int_type_node(atom: fixture_add_int_atom)
            },
            Edge {
              label: Positional,
              target: fixture_int_type_node(atom: fixture_add_int_atom)
            },
            Edge {
              label: Positional,
              target: fixture_int_type_node(atom: fixture_add_body_int_atom)
            }
          ]
        }
      }
    ]
  }
}


fn anchor_infer_add_mvp() -> Outcome<InferredTree> {
  infer(tree: fixture_add_resolved_tree())
}


// Behavior receipt: descent must Violates (not Holds with a fabricated proof) until cardinality propagation lands.
fn infer_descent_witness_contract_node(n: Node) -> Outcome<Node> {
  match infer_descent_witness_for_node(n: n) {
    Violates { diagnostic: _ } => Accepted { value: n, diagnostics: None }
    Holds { value: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: infer_descent_not_derived_diagnostic(n: n)
        )
      }
  }
}


data case_infer_add_mvp_fail_closed: InferReceiptCase = InferDiagnosticReceiptCase {
  label: "manual/infer: infer(fixture_add_resolved_tree) rejects infer_descent_not_derived before solve_constraints",
  input_symbol: infer_receipt_input_infer_add_mvp,
  input: fixture_add_resolved_tree(),
  expected_rejection: diagnostics_singleton(
    d: infer_descent_not_derived_diagnostic(n: fixture_add_resolved_tree())
  )
}


data subject_infer_add_mvp_fail_closed: TestClaimEvalSubject<Node> = infer_receipt_subject(case: case_infer_add_mvp_fail_closed)


data run_infer_add_mvp_fail_closed: TestClaimRun<InferredTree> = infer_add_mvp_receipt_run(subject: subject_infer_add_mvp_fail_closed)


data case_infer_descent_witness_fail_closed: InferReceiptCase = InferCompilesReceiptCase {
  label: "manual/infer: infer_descent_witness_contract_node accepts only Violates descent (no fabricated TerminationProof)",
  input_symbol: infer_receipt_input_descent_witness,
  input: fixture_int_type_node(atom: fixture_add_int_atom),
  expected_value: fixture_int_type_node(atom: fixture_add_int_atom)
}


data subject_infer_descent_witness_fail_closed: TestClaimEvalSubject<Node> = infer_receipt_subject(case: case_infer_descent_witness_fail_closed)


data run_infer_descent_witness_fail_closed: TestClaimRun<Node> = infer_descent_witness_receipt_run(subject: subject_infer_descent_witness_fail_closed)


data claim_infer_add_mvp_compiles: TestClaim = infer_receipt_claim(case: case_infer_add_mvp_fail_closed)


data claim_infer_descent_witness_fail_closed: TestClaim = infer_receipt_claim(case: case_infer_descent_witness_fail_closed)
