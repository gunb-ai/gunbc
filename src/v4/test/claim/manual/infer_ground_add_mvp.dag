// src/v4/test/claim/manual/infer_ground_add_mvp.dag
// Scope: T-9 worked fixture — ResolvedTree for MVP add-shaped Arrow; executable infer/descent receipts.
// Owns: fixture_add_resolved_tree, anchor_infer_add_mvp, infer_descent_witness_contract_node, claim rows, TestClaimRun receipts.
// Consumes: compiler/04_infer.dag, compiler/05_eval.dag, std/diagnostic.dag, std/node.dag, std/verification.dag.
// Status: SPI-3 receipts — infer derives descent via PR #3559 substrate; add MVP compiles when solve_constraints succeeds.
// Anchor: design-v4-compiler-homomorphism.md MVP add(x,y)=x+y


module v4.test.claim.manual.infer_ground_add_mvp


import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  TestClaimTypedInput,
  test_claim_cache_receipt
}
import v4.std.verdict { Verdict, Fail, Pass }
import v4.compiler.infer {
  infer,
  infer_descent_not_derived_diagnostic,
  infer_descent_witness_for_node,
  InferredTree
}
import v4.compiler.resolve { ResolvedTree }
import v4.std.collection { List, Map }
import v4.std.diagnostic {
  Accepted,
  AmbiguousIntent,
  Diagnostic,
  NonEmptyDiagnostics,
  NodeLocus,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus,
  outcome_node_eq
}
import v4.std.node {
  Arrow,
  Atom,
  Conj,
  Edge,
  Hash,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v4.std.verification {
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  CompilesClaim,
  DiagnosticClaim,
  test_claim_expected_outcome,
  test_claim_input,
  manual_claim_anchor
}
import v4.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  LoopInterpreter,
  RuntimePrimitive,
  RuntimePrimitiveValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v4.std.witness { Holds, Violates }


data fixture_add_name: Symbol = fixture_add_name
data fixture_add_int_atom: Symbol = fixture_add_int_atom
data fixture_add_body_int_atom: Symbol = fixture_add_body_int_atom
data infer_receipt_evaluator: Symbol = infer_receipt_evaluator
data infer_receipt_resources: Symbol = infer_receipt_resources
data infer_receipt_extdeps: Symbol = infer_receipt_extdeps
data infer_receipt_runtime_value_symbol: Symbol = infer_receipt_runtime_value_symbol
data infer_receipt_input_infer_add_mvp: Symbol = infer_receipt_input_infer_add_mvp
data infer_receipt_input_descent_witness: Symbol = infer_receipt_input_descent_witness
// 🟡 cache-hash scaffold — T22-EVAL-CACHE-HASHES
data claim_hash_placeholder: Hash = claim_hash_placeholder
data interpretation_hash_placeholder: Hash = interpretation_hash_placeholder


// Receipt bridge: polarity-specific carriers (no broad Outcome<Node> after TestClaim split).
// 🟡 coproduct dissolution — LB-P4-3212 — feature: infer-receipt-testclaim-bridge — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: direct TestClaim constructors per receipt row (forbidden: Outcome<Node> bridge that drops diagnostics).
type InferReceiptCase
// 🟡 coproduct dissolution — LB-P4-3212
  = InferDiagnosticReceiptCase {
      label: String
      input_symbol: Symbol
      input: Node
      expected_rejection: NonEmptyDiagnostics
    }
  | InferCompilesReceiptCase {
      label: String
      input_symbol: Symbol
      input: Node
      expected_value: Node
    }


fn fixture_int_type_node(atom: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: atom } },
    children: []
  }
}


fn infer_receipt_symbol_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


fn infer_receipt_runtime_value() -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: infer_receipt_symbol_node(s: infer_receipt_runtime_value_symbol),
      bytes: []
    }
  }
}


fn infer_receipt_runtime_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_receipt_extdeps,
    at: NodeLocus { node: n },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}


fn infer_receipt_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Rejected { diagnostics: diagnostics_singleton(d: infer_receipt_runtime_diagnostic(n: node)) }
}


fn infer_receipt_call_primitive(
  node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  Rejected { diagnostics: diagnostics_singleton(d: infer_receipt_runtime_diagnostic(n: node)) }
}


fn infer_receipt_choose_branch(node: Node, _value: RuntimeValue, _env: EvaluationEnvironment) -> Outcome<Node> {
  Rejected { diagnostics: diagnostics_singleton(d: infer_receipt_runtime_diagnostic(n: node)) }
}


fn infer_receipt_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  Rejected { diagnostics: diagnostics_singleton(d: infer_receipt_runtime_diagnostic(n: node)) }
}


fn infer_receipt_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}


fn infer_receipt_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: infer_receipt_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: infer_receipt_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: infer_receipt_choose_branch
    },
    loop: LoopInterpreter {
      step_loop: infer_receipt_step_loop
    },
    bind: BindInterpreter {
      bind_value: infer_receipt_bind_value
    }
  }
}


fn infer_receipt_case_input(case: InferReceiptCase) -> Node {
  match case {
    InferDiagnosticReceiptCase { input: input, label: _, input_symbol: _, expected_rejection: _ } => input
    InferCompilesReceiptCase { input: input, label: _, input_symbol: _, expected_value: _ } => input
  }
}


fn infer_receipt_claim(case: InferReceiptCase) -> TestClaim {
  match case {
    InferDiagnosticReceiptCase {
      label: label,
      input_symbol: _,
      input: input,
      expected_rejection: r
    } =>
      DiagnosticClaim {
        label: label,
        anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
        input: input,
        expected_rejection: r,
        classification: TestClassification { tier: Tier1, layer: Unit }
      }
    InferCompilesReceiptCase {
      label: label,
      input_symbol: _,
      input: input,
      expected_value: v
    } =>
      CompilesClaim {
        label: label,
        anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
        input: input,
        expected_value: v,
        classification: TestClassification { tier: Tier1, layer: Unit }
      }
  }
}


fn infer_receipt_context() -> EvalContext {
  EvalContext {
    interpretation: infer_receipt_interpretation()
  }
}


fn infer_receipt_empty_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: fn(_) {
        Violates {
          diagnostic: infer_descent_not_derived_diagnostic(at: node_locus(node: root))
        }
      }
    }
  }
}


fn infer_receipt_subject(case: InferReceiptCase) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: infer_receipt_claim(case: case),
    context: infer_receipt_context(),
    tree: infer_receipt_empty_tree(root: infer_receipt_case_input(case: case)),
    input: TestClaimTypedInput { evaluator_input: infer_receipt_case_input(case: case) }
  }
}


// Project infer's Outcome<InferredTree> to Outcome<Node> for DiagnosticClaim rejection compare only.
fn infer_outcome_node_projection(actual: Outcome<InferredTree>) -> Outcome<Node> {
  match actual {
    Accepted { value: tree, diagnostics: ad } =>
      Accepted { value: tree.root, diagnostics: ad }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}


fn infer_add_mvp_receipt_run(
  subject: TestClaimEvalSubject<Node>,
) -> TestClaimRun<Node, InferredTree> {
  let actual = anchor_infer_add_mvp()
  TestClaimRun {
    cache: test_claim_cache_receipt(
      subject: subject,
      claim_hash: claim_hash_placeholder,
      interpretation_hash: interpretation_hash_placeholder
    ),
    verdict: match test_claim_expected_outcome(c: subject.claim) {
      Accepted { value: expected, diagnostics: _ } =>
        match actual {
          Accepted { value: tree, diagnostics: ad } =>
            if outcome_node_eq(
              a: Accepted { value: tree.root, diagnostics: ad },
              b: expected
            ) {
              Pass
            } else {
              Fail { actual: actual }
            }
          Rejected { diagnostics: _ } =>
            if outcome_node_eq(
              a: infer_outcome_node_projection(actual: actual),
              b: expected
            ) {
              Pass
            } else {
              Fail { actual: actual }
            }
        }
      Rejected { diagnostics: _ } => Fail { actual: actual }
    }
  }
}


fn infer_descent_witness_receipt_run(
  subject: TestClaimEvalSubject<Node>,
) -> TestClaimRun<Node, Node> {
  let actual = infer_descent_witness_contract_node(n: subject.input.evaluator_input)
  TestClaimRun {
    cache: test_claim_cache_receipt(
      subject: subject,
      claim_hash: claim_hash_placeholder,
      interpretation_hash: interpretation_hash_placeholder
    ),
    verdict: match test_claim_expected_outcome(c: subject.claim) {
      Accepted { value: expected, diagnostics: _ } =>
        if outcome_node_eq(a: actual, b: expected) {
          Pass
        } else {
          Fail { actual: actual }
        }
      Rejected { diagnostics: _ } => Fail { actual: actual }
    }
  }
}


// MVP add(x: Int, y: Int) -> Int = x + y as a resolved CoreNode-shaped Arrow (domain, codomain, body).
fn fixture_add_resolved_node() -> Node {
  fixture_add_resolved_tree()
}
fn fixture_add_resolved_tree() -> ResolvedTree {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: fixture_add_name },
        target: Node {
          kind: TypeNode { connective: Arrow },
          children: [
            Edge {
              label: Positional,
              target: fixture_int_type_node(atom: fixture_add_int_atom)
            },
            Edge {
              label: Positional,
              target: fixture_int_type_node(atom: fixture_add_int_atom)
            },
            Edge {
              label: Positional,
              target: fixture_int_type_node(atom: fixture_add_body_int_atom)
            }
          ]
        }
      }
    ]
  }
}


fn anchor_infer_add_mvp() -> Outcome<InferredTree> {
  infer(tree: fixture_add_resolved_tree())
}


// Behavior receipt: bounded TypeNode substrate derives Holds descent witness.
fn infer_descent_witness_contract_node(n: Node) -> Outcome<Node> {
  match infer_descent_witness_for_node(n: n) {
    Holds { value: _ } => Accepted { value: n, diagnostics: None }
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


data case_infer_add_mvp_compiles: InferReceiptCase = InferCompilesReceiptCase {
  label: "manual/infer: infer(fixture_add_resolved_tree) derives descent and accepts",
  input_symbol: infer_receipt_input_infer_add_mvp,
  input: fixture_add_resolved_tree(),
  expected_value: fixture_add_resolved_tree()
}


data subject_infer_add_mvp_compiles: TestClaimEvalSubject<Node> = infer_receipt_subject(case: case_infer_add_mvp_compiles)


data run_infer_add_mvp_compiles: TestClaimRun<Node, InferredTree> = infer_add_mvp_receipt_run(subject: subject_infer_add_mvp_compiles)


data case_infer_descent_witness_holds_atom: InferReceiptCase = InferCompilesReceiptCase {
  label: "manual/infer: infer_descent_witness_contract_node Holds on bounded Atom TypeNode",
  input_symbol: infer_receipt_input_descent_witness,
  input: fixture_int_type_node(atom: fixture_add_int_atom),
  expected_value: fixture_int_type_node(atom: fixture_add_int_atom)
}


data subject_infer_descent_witness_holds_atom: TestClaimEvalSubject<Node> = infer_receipt_subject(case: case_infer_descent_witness_holds_atom)


data run_infer_descent_witness_holds_atom: TestClaimRun<Node, Node> = infer_descent_witness_receipt_run(subject: subject_infer_descent_witness_holds_atom)


data claim_infer_add_mvp_compiles: TestClaim = infer_receipt_claim(case: case_infer_add_mvp_compiles)


data claim_infer_descent_witness_holds_atom: TestClaim = infer_receipt_claim(case: case_infer_descent_witness_holds_atom)
