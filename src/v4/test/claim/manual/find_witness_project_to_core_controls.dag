// src/v4/test/claim/manual/find_witness_project_to_core_controls.dag
// Scope: anti-laundering controls for project_to_core dispatch and integer value-set containment.
// Status: executable Bool witnesses.

module v4.test.claim.manual.find_witness_project_to_core_controls


import v4.test.fixture.derivable_coercion_task_id {
  account_id_wrong_inhabitant_node,
  derivable_coercion_candidate_closedness,
  task_id_api_inhabitant_node,
  task_id_db_inhabitant_node,
  task_id_wire_inhabitant_node
}
import v4.std.collection { List }
import v4.std.find_witness {
  CandidateSet,
  PreservationPredicate,
  UniqueOnly,
  find_witness,
  find_witness_derives,
  find_witness_reason_ambiguous_candidate,
  preservation_rule_constraint_satisfaction,
  preservation_rule_exact_structural_equality_zip_fold,
  preservation_rule_refinement_widening
}
import v4.std.integer {
  int16_interval_spec,
  int32_interval_spec,
  uint8_interval_spec,
  integer_interval_spec_node
}
import v4.std.integer_value_set {
  integer_interval_value_set_node,
  integer_unbounded_value_set_node,
  integer_value_set_contains,
  integer_value_set_strictly_contains
}
import v4.std.model_core { ModelCoreFactAxisSurfaceSpelling }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.diagnostic { Accepted, Rejected }

fn control_candidate_set(candidates: List<Node>, closedness_evidence: Node) -> CandidateSet {
  CandidateSet {
    candidates: candidates,
    closedness: derivable_coercion_candidate_closedness(evidence: closedness_evidence)
  }
}

fn control_predicate(source: Node, rule: Symbol) -> PreservationPredicate {
  PreservationPredicate {
    algebra: source,
    preservation_rule: rule
  }
}

fn control_rule_accepts(source: Node, target: Node, rule: Symbol) -> Bool {
  match find_witness(
    source_facts: source,
    candidates: control_candidate_set(candidates: [target], closedness_evidence: target),
    predicate: control_predicate(source: source, rule: rule),
    multiplicity_policy: UniqueOnly
  ) {
    Accepted { value: fw, diagnostics: _ } => fw.candidate == target
    Rejected { diagnostics: _ } => false
  }
}

fn control_stub_project_to_core_returns_false(source: Node, target: Node) -> Bool {
  false
}

fn control_old_rules_faithful_for_siblings() -> Bool {
  let exact = control_rule_accepts(source: task_id_api_inhabitant_node(), target: task_id_db_inhabitant_node(), rule: preservation_rule_exact_structural_equality_zip_fold)
  let widening = control_rule_accepts(source: task_id_api_inhabitant_node(), target: task_id_db_inhabitant_node(), rule: preservation_rule_refinement_widening)
  let constraint = control_rule_accepts(source: task_id_api_inhabitant_node(), target: task_id_db_inhabitant_node(), rule: preservation_rule_constraint_satisfaction)
  exact || widening || constraint
}

fn project_to_core_stub_gap_stays_true() -> Bool {
  let old_rules = control_old_rules_faithful_for_siblings()
  let stub = control_stub_project_to_core_returns_false(source: task_id_api_inhabitant_node(), target: task_id_db_inhabitant_node())
  !old_rules && !stub
}

data witness_project_to_core_stub_gap_stays_true: Bool = project_to_core_stub_gap_stays_true()

data witness_project_to_core_real_dispatch_accepts_sibling: Bool = match find_witness_derives(
  source_facts: task_id_api_inhabitant_node(),
  candidates: control_candidate_set(candidates: [task_id_db_inhabitant_node()], closedness_evidence: task_id_db_inhabitant_node()),
  derivation_algebra: task_id_api_inhabitant_node(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: fw, diagnostics: _ } => fw.candidate == task_id_db_inhabitant_node()
  Rejected { diagnostics: _ } => false
}

data witness_project_to_core_real_dispatch_rejects_wrong_core: Bool = match find_witness_derives(
  source_facts: task_id_api_inhabitant_node(),
  candidates: control_candidate_set(candidates: [account_id_wrong_inhabitant_node()], closedness_evidence: account_id_wrong_inhabitant_node()),
  derivation_algebra: task_id_api_inhabitant_node(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: _, diagnostics: _ } => false
  Rejected { diagnostics: _ } => true
}

data witness_project_to_core_derives_preserves_ambiguity: Bool = match find_witness_derives(
  source_facts: task_id_api_inhabitant_node(),
  candidates: control_candidate_set(candidates: [task_id_db_inhabitant_node(), task_id_wire_inhabitant_node()], closedness_evidence: task_id_wire_inhabitant_node()),
  derivation_algebra: task_id_api_inhabitant_node(),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: _, diagnostics: _ } => false
  Rejected { diagnostics: r } => r.head.reason == find_witness_reason_ambiguous_candidate
}

fn surface_only_node(surface: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) },
        target: Node { kind: TypeNode { connective: Atom { identity: surface } }, children: [] }
      }
    ]
  }
}

data witness_project_to_core_rejects_surface_only_empty_core: Bool = match find_witness_derives(
  source_facts: surface_only_node(surface: ^surface_only_source),
  candidates: control_candidate_set(candidates: [surface_only_node(surface: ^surface_only_candidate)], closedness_evidence: surface_only_node(surface: ^surface_only_candidate)),
  derivation_algebra: surface_only_node(surface: ^surface_only_source),
  multiplicity_policy: UniqueOnly
) {
  Accepted { value: _, diagnostics: _ } => false
  Rejected { diagnostics: _ } => true
}

fn i32_value_set() -> Node {
  integer_interval_value_set_node(interval: integer_interval_spec_node(spec: int32_interval_spec()))
}

fn i16_value_set() -> Node {
  integer_interval_value_set_node(interval: integer_interval_spec_node(spec: int16_interval_spec()))
}

fn u8_value_set() -> Node {
  integer_interval_value_set_node(interval: integer_interval_spec_node(spec: uint8_interval_spec()))
}

fn python_int_value_set() -> Node {
  integer_unbounded_value_set_node()
}

data witness_integer_value_set_accepts_i32_subset_python_int: Bool = integer_value_set_contains(container: python_int_value_set(), contained: i32_value_set())

data witness_integer_value_set_accepts_i16_subset_i32: Bool = integer_value_set_contains(container: i32_value_set(), contained: i16_value_set())

data witness_integer_value_set_accepts_u8_subset_i16: Bool = integer_value_set_contains(container: i16_value_set(), contained: u8_value_set())

fn integer_value_set_reverse_is_strict_coarsening_control() -> Bool {
  let strict = integer_value_set_strictly_contains(container: python_int_value_set(), contained: i32_value_set())
  let reverse_contains = integer_value_set_contains(container: i32_value_set(), contained: python_int_value_set())
  strict && !reverse_contains
}

data witness_integer_value_set_reverse_is_strict_coarsening: Bool = integer_value_set_reverse_is_strict_coarsening_control()

data witness_integer_value_set_refuses_incompatible_unknown: Bool = !integer_value_set_contains(container: task_id_api_inhabitant_node(), contained: i32_value_set())
