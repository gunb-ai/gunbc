// src/v4/test/claim/manual/find_witness_distinct_node_blocked_mvp.dag
// Scope: fail-closed receipts for same-shape distinct-node exact preservation before W-T-10 canonical grounding.
// Owns: distinct leaf / nested distinct-node rejection anchors for find_witness and coercion_fold.
// Consumes: std/find_witness.dag, std/coercion.dag, std/constraints.dag, std/verification.dag.
// Status: manual behavior receipt for exact-structural-preservation-identity-mvp scaffold; distinct-node acceptance is W-T-10-gated.


module v4.test.claim.manual.find_witness_distinct_node_blocked_mvp


import v4.std.coercion {
  CoercionCandidateSet,
  coercion_fold
}
import v4.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v4.std.diagnostic {
  Accepted,
  Outcome,
  Rejected
}
import v4.std.find_witness {
  CandidateSet,
  FindWitnessResult,
  PreservationPredicate,
  TargetDeclaredPriority,
  UniqueOnly,
  find_witness,
  find_witness_reason_no_candidate,
  preservation_rule_exact_structural_equality_zip_fold,
  verify_witness
}
import v4.std.node {
  Atom,
  Arrow,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v4.std.verification {
  CompilesClaim,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit
}
import v4.std.witness { StructuralPropertyWitness }
data distinct_block_source_atom: Symbol = distinct_block_source_atom
data distinct_block_target_atom: Symbol = distinct_block_target_atom
data distinct_block_closed_candidates: Symbol = distinct_block_closed_candidates
fn distinct_block_source_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: distinct_block_source_atom } },
    children: []
  }
}
fn distinct_block_target_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: distinct_block_target_atom } },
    children: []
  }
}
fn distinct_block_source_arrow() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_block_source_leaf() },
      Edge { label: Positional, target: distinct_block_source_leaf() }
    ]
  }
}
fn distinct_block_target_arrow() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_block_target_leaf() },
      Edge { label: Positional, target: distinct_block_target_leaf() }
    ]
  }
}
fn distinct_block_source_nested() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_block_source_arrow() },
      Edge { label: Positional, target: distinct_block_source_leaf() }
    ]
  }
}
fn distinct_block_target_nested() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_block_target_arrow() },
      Edge { label: Positional, target: distinct_block_target_leaf() }
    ]
  }
}
fn distinct_block_closedness() -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: distinct_block_closed_candidates,
    evidence: distinct_block_target_arrow()
  }
}
fn distinct_block_exact_predicate() -> PreservationPredicate {
  PreservationPredicate {
    algebra: distinct_block_source_arrow(),
    preservation_rule: preservation_rule_exact_structural_equality_zip_fold
  }
}
fn distinct_block_nested_predicate() -> PreservationPredicate {
  PreservationPredicate {
    algebra: distinct_block_source_nested(),
    preservation_rule: preservation_rule_exact_structural_equality_zip_fold
  }
}
fn distinct_block_candidate_set() -> CandidateSet {
  CandidateSet {
    candidates: [distinct_block_target_arrow()],
    closedness: distinct_block_closedness()
  }
}
fn distinct_block_nested_candidate_set() -> CandidateSet {
  CandidateSet {
    candidates: [distinct_block_target_nested()],
    closedness: distinct_block_closedness()
  }
}
fn distinct_block_rejected_for_no_candidate(o: Outcome<FindWitnessResult>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => r.head.reason == find_witness_reason_no_candidate
  }
}
data witness_find_witness_same_shape_distinct_leaf_rejects: Bool = distinct_block_rejected_for_no_candidate(
  o: find_witness(
    source_facts: distinct_block_source_arrow(),
    candidates: distinct_block_candidate_set(),
    predicate: distinct_block_exact_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
data witness_find_witness_nested_distinct_node_rejects: Bool = distinct_block_rejected_for_no_candidate(
  o: find_witness(
    source_facts: distinct_block_source_nested(),
    candidates: distinct_block_nested_candidate_set(),
    predicate: distinct_block_nested_predicate(),
    multiplicity_policy: UniqueOnly
  )
)
data witness_verify_witness_same_shape_distinct_leaf_rejects: Bool = match verify_witness(
  source_facts: distinct_block_source_arrow(),
  candidate: distinct_block_target_arrow(),
  predicate: distinct_block_exact_predicate(),
  witness: StructuralPropertyWitness {
    property: preservation_rule_exact_structural_equality_zip_fold,
    evidence: distinct_block_target_arrow()
  }
) {
  Accepted { value: _, diagnostics: _ } => false
  Rejected { diagnostics: _ } => true
}
fn distinct_block_grounding() -> CanonicalGrounding {
  CanonicalGrounding {
    node: distinct_block_source_arrow(),
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: preservation_rule_exact_structural_equality_zip_fold,
        evidence: distinct_block_source_arrow()
      },
      closedness: distinct_block_closedness()
    }
  }
}
fn distinct_block_coercion_candidates() -> CoercionCandidateSet {
  CoercionCandidateSet { set: distinct_block_candidate_set() }
}
data witness_coercion_fold_same_shape_distinct_leaf_rejects: Bool = match coercion_fold(
  source: distinct_block_grounding(),
  candidates: distinct_block_coercion_candidates(),
  policy: TargetDeclaredPriority { priority: distinct_block_target_arrow() }
) {
  Accepted { value: _, diagnostics: _ } => false
  Rejected { diagnostics: _ } => true
}
fn distinct_block_claim_input(ok: Bool) -> Node {
  if ok {
    distinct_block_source_arrow()
  } else {
    distinct_block_target_arrow()
  }
}
fn distinct_block_expected() -> Node {
  distinct_block_source_arrow()
}
data claim_find_witness_distinct_node_blocked_mvp_compiles: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_blocked_mvp: fail-closed anchors compile",
  t19_anchor: T19ManualAnchorAbsent,
  input: distinct_block_source_arrow(),
  expected_value: distinct_block_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_same_shape_distinct_leaf_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_blocked_mvp: same-shape distinct leaf rejects",
  t19_anchor: T19ManualAnchorAbsent,
  input: distinct_block_claim_input(ok: witness_find_witness_same_shape_distinct_leaf_rejects),
  expected_value: distinct_block_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_find_witness_nested_distinct_node_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_blocked_mvp: nested distinct node rejects",
  t19_anchor: T19ManualAnchorAbsent,
  input: distinct_block_claim_input(ok: witness_find_witness_nested_distinct_node_rejects),
  expected_value: distinct_block_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_verify_witness_same_shape_distinct_leaf_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_blocked_mvp: verify same-shape distinct leaf rejects",
  t19_anchor: T19ManualAnchorAbsent,
  input: distinct_block_claim_input(ok: witness_verify_witness_same_shape_distinct_leaf_rejects),
  expected_value: distinct_block_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_coercion_fold_same_shape_distinct_leaf_rejects: TestClaim = CompilesClaim {
  label: "manual/find_witness_distinct_node_blocked_mvp: coercion same-shape distinct leaf rejects",
  t19_anchor: T19ManualAnchorAbsent,
  input: distinct_block_claim_input(ok: witness_coercion_fold_same_shape_distinct_leaf_rejects),
  expected_value: distinct_block_expected(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
