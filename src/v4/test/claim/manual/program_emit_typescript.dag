// src/v4/test/claim/manual/program_emit_typescript.dag
// Scope: M1 §4 — locked program.dag pick_if Branch (effect_io then-arm, literal-2 else-arm) emits
//   to runnable TypeScript; emit-only keystone + discriminating perturbation reds.
// Status: producer-composed Arrow.body → emit() → authority source; execution receipt in
//   src/v2/tests/src/program_emit_typescript_receipt_test.rs (Node host run + file round-trip).

module v4.test.claim.manual.program_emit_typescript

import v4.compiler.emit { emit }
import v4.compiler.translate {
  serialize_concrete_syntax_tokens_to_source,
  translate_project_transform_in_arrow_scope
}
import v4.compiler.infer { InferredFacts, InferredTree }
import v4.compiler.target_carriers { TargetSource }
import v4.extdeps.languages.dag {
  dag_mvp1_pick_arrow_domain_conj_node,
  dag_mvp1_pick_if_body_from_arms,
  dag_mvp1_type_atom_node
}
import v4.extdeps.languages.typescript {
  ts_program_source_text,
  ts_program_target_model
}
import v4.std.compilers.target_model {
  TargetModel,
  target_project_arrow_body_to_value_expression,
  target_value_expression_projection_from_target,
  target_value_expression_tokens_from_target
}
import v4.compiler.translate { serialize_concrete_syntax_tokens_to_source }
import v4.program {
  program_effect_io_roundtrip,
  program_kw_true,
  program_literal_two
}
import v4.std.cardinality { RankingDimension, TerminationProof }
import v4.std.collection { Map }
import v4.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected
}
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  SyntheticOccurrence,
  arrow_body_edge
}
import v4.std.text { String }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v4.std.witness { Holds, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_inferred_facts_from_nodes
}

data program_emit_arrow_body: Node = dag_mvp1_pick_if_body_from_arms(
  condition: program_kw_true(),
  then_arm: program_effect_io_roundtrip,
  else_arm: program_literal_two()
)

fn program_emit_arrow_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge {
        label: Positional,
        target: dag_mvp1_pick_arrow_domain_conj_node()
      },
      Edge {
        label: Positional,
        target: dag_mvp1_type_atom_node(identity: ^program_emit_return_type)
      },
      Edge {
        label: Positional,
        target: dag_mvp1_type_atom_node(identity: ^program_emit_return_type)
      },
      Edge {
        label: Named { name: arrow_body_edge },
        target: program_emit_arrow_body
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn program_emit_termination_proof() -> TerminationProof {
  TerminationProof {
    non_increasing: [],
    strict: RankingDimension { measured: ^program_emit_descent_dimension }
  }
}

fn program_emit_return_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^program_emit_return_type } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn program_emit_facts_for(node: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: program_emit_return_type_node(),
    descent: Holds { value: program_emit_termination_proof() }
  )
}

fn program_emit_facts_lookup(node: Node) -> Witness<InferredFacts> {
  if node == program_emit_arrow_node() {
    Holds { value: program_emit_facts_for(node: program_emit_arrow_node()) }
  } else if node == program_emit_arrow_body {
    Holds { value: program_emit_facts_for(node: program_emit_arrow_body) }
  } else if node == program_effect_io_roundtrip {
    Holds { value: program_emit_facts_for(node: program_effect_io_roundtrip) }
  } else if node == program_kw_true() {
    Holds { value: program_emit_facts_for(node: program_kw_true()) }
  } else if node == program_literal_two() {
    Holds { value: program_emit_facts_for(node: program_literal_two()) }
  } else {
    Holds { value: program_emit_facts_for(node: node) }
  }
}

fn program_emit_inferred_tree() -> InferredTree {
  InferredTree {
    root: program_emit_arrow_node(),
    facts: Map { lookup: program_emit_facts_lookup }
  }
}

fn program_emit_swapped_else_body() -> Node {
  dag_mvp1_pick_if_body_from_arms(
    condition: program_kw_true(),
    then_arm: program_effect_io_roundtrip,
    else_arm: dag_mvp1_type_atom_node(identity: ^dag_mvp1_pick_lit_one)
  )
}

fn program_emit_swapped_else_arrow_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge {
        label: Positional,
        target: dag_mvp1_pick_arrow_domain_conj_node()
      },
      Edge {
        label: Positional,
        target: dag_mvp1_type_atom_node(identity: ^program_emit_return_type)
      },
      Edge {
        label: Positional,
        target: dag_mvp1_type_atom_node(identity: ^program_emit_return_type)
      },
      Edge {
        label: Named { name: arrow_body_edge },
        target: program_emit_swapped_else_body()
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn program_emit_swapped_else_tree() -> InferredTree {
  InferredTree {
    root: program_emit_swapped_else_arrow_node(),
    facts: Map { lookup: program_emit_facts_lookup }
  }
}

fn program_emit_false_condition_body() -> Node {
  dag_mvp1_pick_if_body_from_arms(
    condition: dag_mvp1_type_atom_node(identity: ^dag_token_kw_false),
    then_arm: program_effect_io_roundtrip,
    else_arm: program_literal_two()
  )
}

fn program_emit_false_condition_arrow_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge {
        label: Positional,
        target: dag_mvp1_pick_arrow_domain_conj_node()
      },
      Edge {
        label: Positional,
        target: dag_mvp1_type_atom_node(identity: ^program_emit_return_type)
      },
      Edge {
        label: Positional,
        target: dag_mvp1_type_atom_node(identity: ^program_emit_return_type)
      },
      Edge {
        label: Named { name: arrow_body_edge },
        target: program_emit_false_condition_body()
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn program_emit_false_condition_tree() -> InferredTree {
  InferredTree {
    root: program_emit_false_condition_arrow_node(),
    facts: Map { lookup: program_emit_facts_lookup }
  }
}

fn program_emit_from_tree(tree: InferredTree, target: TargetModel) -> Outcome<TargetSource> {
  emit(tree: tree, target: target)
}

fn program_emit_typescript_projection_accepts() -> Bool {
  match target_project_arrow_body_to_value_expression(
    arrow: program_emit_arrow_node(),
    target: ts_program_target_model(),
    handle_transform: fn(a, b, t) {
      translate_project_transform_in_arrow_scope(arrow: a, body: b, target: t)
    }
  ) {
    Accepted { value: _, diagnostics: d } => d == None
    Rejected { diagnostics: _ } => false
  }
}

fn program_emit_typescript_keystone_holds() -> Bool {
  match program_emit_from_tree(
    tree: program_emit_inferred_tree(),
    target: ts_program_target_model()
  ) {
    Accepted { value: source, diagnostics: d } =>
      (source == ts_program_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn program_emit_typescript_emitted_source() -> String {
  match program_emit_from_tree(
    tree: program_emit_inferred_tree(),
    target: ts_program_target_model()
  ) {
    Accepted { value: source, diagnostics: _ } => source
    Rejected { diagnostics: _ } => "PROGRAM_EMIT_REJECTED"
  }
}

fn program_emit_typescript_swapped_else_discriminates() -> Bool {
  match program_emit_from_tree(
    tree: program_emit_inferred_tree(),
    target: ts_program_target_model()
  ) {
    Accepted { value: canonical, diagnostics: dc } =>
      match program_emit_from_tree(
        tree: program_emit_swapped_else_tree(),
        target: ts_program_target_model()
      ) {
        Accepted { value: perturbed, diagnostics: dp } =>
          (canonical != perturbed) && (dc == None) && (dp == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn program_emit_typescript_false_condition_discriminates() -> Bool {
  match program_emit_from_tree(
    tree: program_emit_inferred_tree(),
    target: ts_program_target_model()
  ) {
    Accepted { value: canonical, diagnostics: dc } =>
      match program_emit_from_tree(
        tree: program_emit_false_condition_tree(),
        target: ts_program_target_model()
      ) {
        Accepted { value: perturbed, diagnostics: dp } =>
          (canonical != perturbed) && (dc == None) && (dp == None)
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data unified_claim_program_emit_typescript_keystone: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/manual/program_emit_typescript.dag",
    function: program_emit_typescript_keystone_holds
  }
}

data unified_claim_program_emit_typescript_swapped_else: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/manual/program_emit_typescript.dag",
    function: program_emit_typescript_swapped_else_discriminates
  }
}

data unified_claim_program_emit_typescript_false_condition: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/manual/program_emit_typescript.dag",
    function: program_emit_typescript_false_condition_discriminates
  }
}
