// src/v4/test/claim/manual/find_witness_distinct_node_zip_fold.dag
// Scope: distinct-node exact-structural zip-fold anchors for find_witness and coercion_fold.
// Owns: anchor functions for distinct-node shape-equivalent witness acceptance and coercion Exact quality.
// Consumes: std/find_witness.dag, std/coercion.dag, std/constraints.dag, std/verification.dag.
// Status: manual compile receipt for preservation_rule_exact_structural_equality_zip_fold.


module v4.test.claim.manual.find_witness_distinct_node_zip_fold


import v4.std.coercion {
  CoercionCandidateSet,
  Exact,
  coercion_fold
}
import v4.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v4.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected
}
import v4.std.find_witness {
  CandidateSet,
  PreservationPredicate,
  TargetDeclaredPriority,
  UniqueOnly,
  find_witness,
  preservation_rule_exact_structural_equality_zip_fold,
  verify_witness
}
import v4.std.node {
  Atom,
  Arrow,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v4.std.verification {
  Compiles,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit
}
import v4.std.witness { StructuralPropertyWitness }
data distinct_zip_source_atom: Symbol = distinct_zip_source_atom
data distinct_zip_target_atom: Symbol = distinct_zip_target_atom
data distinct_zip_closed_candidates: Symbol = distinct_zip_closed_candidates
fn distinct_source_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: distinct_zip_source_atom } },
    children: []
  }
}
fn distinct_target_leaf() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: distinct_zip_target_atom } },
    children: []
  }
}
fn distinct_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: []
  }
}
fn distinct_source_add_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_source_leaf() },
      Edge { label: Positional, target: distinct_source_leaf() },
      Edge { label: Positional, target: distinct_source_leaf() }
    ]
  }
}
fn distinct_target_add_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: distinct_target_leaf() },
      Edge { label: Positional, target: distinct_target_leaf() },
      Edge { label: Positional, target: distinct_target_leaf() }
    ]
  }
}
fn distinct_closedness() -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: distinct_zip_closed_candidates,
    evidence: distinct_target_add_node()
  }
}
fn distinct_exact_predicate() -> PreservationPredicate {
  PreservationPredicate {
    algebra: distinct_source_add_node(),
    preservation_rule: preservation_rule_exact_structural_equality_zip_fold
  }
}
fn distinct_candidate_set() -> CandidateSet {
  CandidateSet {
    candidates: [distinct_target_add_node()],
    closedness: distinct_closedness()
  }
}
fn distinct_valid_witness() -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: preservation_rule_exact_structural_equality_zip_fold,
    evidence: distinct_target_add_node()
  }
}
fn anchor_find_witness_distinct_node_accepts() -> Outcome<Node> {
  match find_witness(
    source_facts: distinct_source_add_node(),
    candidates: distinct_candidate_set(),
    predicate: distinct_exact_predicate(),
    multiplicity_policy: UniqueOnly
  ) {
    Accepted { value: fw, diagnostics: d } =>
      Accepted { value: fw.candidate, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
fn anchor_verify_witness_distinct_node_accepts() -> Outcome<Node> {
  match verify_witness(
    source_facts: distinct_source_add_node(),
    candidate: distinct_target_add_node(),
    predicate: distinct_exact_predicate(),
    witness: distinct_valid_witness()
  ) {
    Accepted { value: _, diagnostics: d } =>
      Accepted { value: distinct_target_add_node(), diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
fn distinct_grounding() -> CanonicalGrounding {
  CanonicalGrounding {
    node: distinct_source_add_node(),
    witness: CanonicalGroundingWitness {
      structural: distinct_valid_witness(),
      closedness: distinct_closedness()
    }
  }
}
fn distinct_coercion_candidates() -> CoercionCandidateSet {
  CoercionCandidateSet { set: distinct_candidate_set() }
}
fn anchor_coercion_fold_distinct_node_accepts() -> Outcome<Node> {
  match coercion_fold(
    source: distinct_grounding(),
    candidates: distinct_coercion_candidates(),
    policy: TargetDeclaredPriority { priority: distinct_target_add_node() }
  ) {
    Accepted { value: r, diagnostics: d } => match r.quality {
      Exact => Accepted { value: r.target, diagnostics: d }
      _ => Accepted { value: distinct_fail_node(), diagnostics: d }
    }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
data claim_find_witness_distinct_node_zip_fold_compiles: TestClaim = TestClaim {
  kind: Compiles,
  label: "manual/find_witness_distinct_node_zip_fold: distinct-node zip-fold anchors compile",
  t19_anchor: T19ManualAnchorAbsent,
  input: distinct_source_add_node(),
  expected: Accepted { value: distinct_source_add_node(), diagnostics: None },
  classification: TestClassification { tier: Tier1, layer: Unit }
}
