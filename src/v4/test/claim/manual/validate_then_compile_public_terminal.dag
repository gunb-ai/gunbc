// src/v4/test/claim/manual/validate_then_compile_public_terminal.dag
// Scope: Wave-5-A — P3 commitment 6 public terminal; empty required-lens list + reject-before-compile gate.
// Owns: claim_validate_then_compile_module_compiles, claim_empty_lenses_skips_gate,
//       claim_rejecting_lens_blocks_before_compile, anchor_validate_then_compile_empty_lenses,
//       anchor_validate_then_compile_rejecting_lens.
// Consumes: compiler/00_compile.dag, test/claim/manual/infer_ground_add_mvp.dag, std/diagnostic.dag,
//           std/node.dag, std/verification.dag, std/witness.dag.
// Status: scaffold — full Accepted TargetSource blocked on infer descent + rust LanguageModel (Wave-4).
// Anchor: docs/design-v4-compiler-homomorphism.md P3 commitment 6


module v4.test.claim.manual.validate_then_compile_public_terminal


import v4.compiler.compile {
  CompileMode,
  CompileOutput,
  Lens,
  TranslateResult,
  TranslateTo,
  Validated,
  compile_lens_gate_rejected,
  compile_lens_gate_rejected_diagnostic,
  validate_then_compile
}
import v4.compiler.infer { InferredTree }
import v4.test.claim.manual.infer_ground_add_mvp { fixture_add_resolved_tree }
import v4.std.diagnostic {
  Accepted,
  None,
  Outcome,
  PortLocus,
  Rejected,
  outcome_rejected
}
import v4.std.node { Conj, Node, Symbol, TypeNode }
import v4.std.verification {
  Compiles,
  Equals,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit
}
import v4.std.witness { Witness }


data claim_validate_then_compile_module: Symbol = claim_validate_then_compile_module
data rust_language_model_stub: Node = Node {
  kind: TypeNode { connective: Conj },
  children: []
}
data rejecting_lens_gate_at: Symbol = rejecting_lens_gate_at


fn always_reject_lens_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(
      at: PortLocus { port: rejecting_lens_gate_at }
    )
  )
}


data rejecting_lens: Lens = Lens {
  gate: always_reject_lens_gate
}


fn anchor_validate_then_compile_empty_lenses() -> Outcome<Validated<CompileOutput>> {
  validate_then_compile(
    source: fixture_add_resolved_tree(),
    input_lang: rust_language_model_stub,
    lenses: [],
    mode: TranslateTo { target_lang: rust_language_model_stub }
  )
}


fn anchor_validate_then_compile_rejecting_lens() -> Outcome<Validated<CompileOutput>> {
  validate_then_compile(
    source: fixture_add_resolved_tree(),
    input_lang: rust_language_model_stub,
    lenses: [rejecting_lens],
    mode: TranslateTo { target_lang: rust_language_model_stub }
  )
}


fn claim_empty_lenses_matches_compile_core_outcome(
  actual: Outcome<Validated<CompileOutput>>
) -> Bool {
  match actual {
    Rejected { diagnostics: _ } => true
    Accepted { value: v, diagnostics: _ } => match v.value {
      TranslateResult { source: _ } => true
      _ => false
    }
  }
}


fn claim_rejecting_lens_is_compile_lens_gate_rejected(
  actual: Outcome<Validated<CompileOutput>>
) -> Bool {
  match actual {
    Rejected { diagnostics: r } =>
      r.head.reason == compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}


data claim_validate_then_compile_module_compiles: TestClaim = TestClaim {
  kind: Compiles,
  label: "manual/wave-5-a: validate_then_compile public terminal module compiles",
  t19_anchor: T19ManualAnchorAbsent,
  input: claim_validate_then_compile_module,
  expected: Accepted { value: claim_validate_then_compile_module, diagnostics: None },
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_empty_lenses_skips_gate: TestClaim = TestClaim {
  kind: Equals,
  label: "manual/wave-5-a: empty required-lens list reaches compile-core (staging: infer may reject)",
  t19_anchor: T19ManualAnchorAbsent,
  input: claim_validate_then_compile_module,
  expected: Accepted {
    value: claim_validate_then_compile_skips_gate_passes(),
    diagnostics: None
  },
  classification: TestClassification { tier: Tier1, layer: Unit }
}


fn claim_validate_then_compile_skips_gate_passes() -> Node {
  if claim_empty_lenses_matches_compile_core_outcome(
    actual: anchor_validate_then_compile_empty_lenses()
  ) {
    claim_validate_then_compile_module
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}


data claim_rejecting_lens_blocks_before_compile: TestClaim = TestClaim {
  kind: Equals,
  label: "manual/wave-5-a: required lens Rejected blocks before compile-core",
  t19_anchor: T19ManualAnchorAbsent,
  input: claim_validate_then_compile_module,
  expected: Accepted {
    value: claim_rejecting_lens_blocks_passes(),
    diagnostics: None
  },
  classification: TestClassification { tier: Tier1, layer: Unit }
}


fn claim_rejecting_lens_blocks_passes() -> Node {
  if claim_rejecting_lens_is_compile_lens_gate_rejected(
    actual: anchor_validate_then_compile_rejecting_lens()
  ) {
    claim_validate_then_compile_module
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

