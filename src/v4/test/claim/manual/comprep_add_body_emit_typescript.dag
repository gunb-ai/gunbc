// src/v4/test/claim/manual/comprep_add_body_emit_typescript.dag
// Scope: T6 skeleton — real Arrow.body → translated TS → add(2,3)=5 vetting consumer (#4623).
// Status: bodied add-fn emit via value-expression projection (not fixture body tokens).

module v4.test.claim.manual.comprep_add_body_emit_typescript

import v4.compiler.body_producer {
  produce_mvp1_add_arrow_with_body,
  produce_mvp1_add_binary_body
}
import v4.compiler.emit { emit }
import v4.compiler.translate { translate }
import v4.compiler.infer { InferredFacts, InferredTree }
import v4.test.claim.lens_common.infer_fixture { claim_inferred_facts_witness }
import v4.extdeps.languages.typescript {
  ts_facts_number,
  ts_inhabitant_atom,
  ts_inhabitant_number_node,
  ts_mvp1_source_text,
  ts_mvp1_target_model,
  ts_number_arithmetic_semantics_node,
  ts_number_bitwise_semantics_node,
  ts_number_facts_node
}
import v4.compiler.target_carriers { TargetSource }
import v4.std.cardinality { TerminationProof, termination_proof_witness_for_node }
import v4.std.collection { Map, empty_map }
import v4.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v4.std.logic { Bool }
import v4.std.node { Node, TypeNode, Atom }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  ManualAnchorAbsent,
  UnifiedTestClaim,
  manual_claim_anchor
}
import v4.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }

data comprep_ts_body_emit_pass: Symbol = comprep_ts_body_emit_pass
data comprep_ts_body_emit_fail: Symbol = comprep_ts_body_emit_fail

fn comprep_ts_bodied_arrow_root() -> Node {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } => arrow
    Rejected { diagnostics: _ } =>
      Node {
        kind: TypeNode { connective: Atom { identity: comprep_ts_body_emit_fail } },
        children: []
      }
  }
}

fn comprep_ts_canonical_grounding(node: Node, algebra: Node) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: ^constraint_property_being_canonical,
        evidence: algebra
      },
      closedness: StructuralPropertyWitness {
        property: ^constraint_property_candidate_set_closedness,
        evidence: node
      }
    }
  }
}

data comprep_ts_number_inhabitant: Node = ts_inhabitant_number_node()
data comprep_ts_number_facts_node: Node = ts_number_facts_node(facts: ts_facts_number)
data comprep_ts_arithmetic_semantics_node: Node = ts_number_arithmetic_semantics_node()
data comprep_ts_bitwise_semantics_node: Node = ts_number_bitwise_semantics_node()

fn comprep_ts_canonical_grounding_for(node: Node) -> Witness<CanonicalGrounding> {
  if node == comprep_ts_bodied_arrow_root() {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == produce_mvp1_add_binary_body() {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == comprep_ts_number_inhabitant {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_inhabitant_number) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_inhabitant
      )
    }
  } else if node == comprep_ts_number_facts_node {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^ts_surface_spelling_number) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == comprep_ts_arithmetic_semantics_node {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_number_ieee754_binary64) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_arithmetic_semantics_node
      )
    }
  } else if node == comprep_ts_bitwise_semantics_node {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_number_bitwise_int32_uint32) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_bitwise_semantics_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_tag_bits64) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_ieee754_binary64) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^ts_std_projection_float64) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_facts_node
      )
    }
  } else if node == ts_inhabitant_atom(id: ^dag_token_plus) {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^dag_binding_param_x) {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^dag_binding_param_y) {
    Holds {
      value: comprep_ts_canonical_grounding(node: node, algebra: node)
    }
  } else if node == ts_inhabitant_atom(id: ^dag_binding_type_int) {
    Holds {
      value: comprep_ts_canonical_grounding(
        node: node,
        algebra: comprep_ts_number_inhabitant
      )
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^comprep_ts_body_grounding_miss,
        at: node_locus(node: node),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn comprep_ts_inferred_facts_for(node: Node) -> Witness<InferredFacts> {
  match comprep_ts_canonical_grounding_for(node: node) {
    Violates { diagnostic: d } => Violates { diagnostic: d }
    Holds { value: grounding } =>
      match termination_proof_witness_for_node(n: node) {
        Violates { diagnostic: d } => Violates { diagnostic: d }
        Holds { value: proof } =>
          Holds {
            value: claim_inferred_facts_witness(
              grounding: grounding,
              descent: Holds { value: proof }
            )
          }
      }
  }
}

fn comprep_ts_facts_lookup(key: Node) -> Witness<InferredFacts> {
  comprep_ts_inferred_facts_for(node: key)
}

data comprep_ts_bodied_inferred_tree: InferredTree = InferredTree {
  root: comprep_ts_bodied_arrow_root(),
  facts: Map { lookup: comprep_ts_facts_lookup }
}

fn anchor_comprep_ts_bodied_emit_accepts() -> Outcome<TargetSource> {
  emit(tree: comprep_ts_bodied_inferred_tree, target: ts_mvp1_target_model())
}

data comprep_ts_bodied_emit_receipt: Outcome<TargetSource> = anchor_comprep_ts_bodied_emit_accepts()

fn comprep_ts_debug_translate_accepts() -> Bool {
  match translate(tree: comprep_ts_bodied_inferred_tree, target: ts_mvp1_target_model()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_ts_bodied_emit_add_fn_accepts_holds() -> Bool {
  match comprep_ts_bodied_emit_receipt {
    Accepted { value: source, diagnostics: d } =>
      (source == ts_mvp1_source_text) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

data unified_claim_comprep_ts_bodied_emit_add_fn: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/manual/comprep_add_body_emit_typescript.dag",
    function: comprep_ts_bodied_emit_add_fn_accepts_holds
  }
}
