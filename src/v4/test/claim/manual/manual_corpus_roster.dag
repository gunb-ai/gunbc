// src/v4/test/claim/manual/manual_corpus_roster.dag
// Scope: T-38 — explicit roster of manual TestClaimRun rows for corpus evaluation.
// Status: wedge — three TestClaimRun<Node, RuntimeValue> rows (eval_runtime_mvp +
//   rust_language_model dissolution receipts); expand as additional rows ship with
//   the same evaluator-actual type parameter. Heterogeneous-A rows (Node,
//   InferredTree) land via separate per-A rosters folded into the same
//   CorpusEvalReport in testclaim_corpus_runner.dag.
//
// Roster join is explicit import/concat (Practice 10: single authority — no
// reflection over the .dag item registry until T-19 testclaim-coproduct-reflection
// lands; same posture as manual_anchor_manifest.dag). The roster carries the
// TestClaimRun rows directly; per-row label/claim are reached through the
// run's cache.key.eval_subject.claim path so the TestClaim definition stays
// the single authority for label/anchor/classification (P2).
//
// 🟡 gated — feature:t38-testclaim-corpus-eval — bind src/v4/TASKS.md T-38 —
// dissolve-on-arrival: roster reflection replaces explicit import list when T-19
// testclaim-coproduct-reflection ships; until then, every new TestClaimRun<Node, A>
// row added under manual/ must register here (or in the per-A roster).
module v4.test.claim.manual.manual_corpus_roster


import v4.compiler.eval { TestClaimRun }
import v4.std.collection { List }
import v4.std.node { Node }
import v4.std.runtime { RuntimeValue }
import v4.test.claim.manual.dissolution_subsumption_reverification {
  run_rust_language_model_emit_mechanical_reverification_claim,
  run_rust_language_model_emit_subsumption_reverifies
}
import v4.test.claim.manual.eval_runtime_mvp { run_eval_mvp2_test_claim_route }


// Wedge roster: TestClaimRun rows whose actual-type parameter is RuntimeValue.
// All three rows route through v4.compiler.eval.eval (T-22) on Node-typed
// inputs. Per-row label/claim live on the TestClaim reachable via
// run.cache.key.eval_subject.claim (single authority — no roster-side mirror).
data manual_corpus_node_runtime_value_runs: List<TestClaimRun<Node, RuntimeValue>> = [
  run_eval_mvp2_test_claim_route,
  run_rust_language_model_emit_mechanical_reverification_claim,
  run_rust_language_model_emit_subsumption_reverifies
]
