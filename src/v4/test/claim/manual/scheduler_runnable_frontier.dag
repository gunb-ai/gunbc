// src/v4/test/claim/manual/scheduler_runnable_frontier.dag
// Scope: scheduler runnable-frontier fixture.
// Status: manual fixture until generated TestClaim execution lands.

module v4.test.claim.manual.scheduler_runnable_frontier

import v4.std.collection { List }
import v4.std.dependency {
  DataDependsOn,
  DependencyView,
  ReadinessLayer
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.workflow.scheduler {
  SchedulerPlan,
  scheduler_plan_from_dependencies
}

data scheduler_root_symbol: Symbol = scheduler_root_symbol
data scheduler_build_symbol: Symbol = scheduler_build_symbol
data scheduler_test_symbol: Symbol = scheduler_test_symbol
data scheduler_emit_symbol: Symbol = scheduler_emit_symbol

data scheduler_build_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: scheduler_build_symbol } },
  children: []
}

data scheduler_test_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: scheduler_test_symbol } },
  children: []
}

data scheduler_emit_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: scheduler_emit_symbol } },
  children: []
}

data scheduler_fixture_graph: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: scheduler_build_symbol }, target: scheduler_build_node },
    Edge { label: Named { name: scheduler_test_symbol }, target: scheduler_test_node },
    Edge { label: Named { name: scheduler_emit_symbol }, target: scheduler_emit_node }
  ]
}

data scheduler_build_to_emit_dependency: DependencyView = DependencyView {
  source: scheduler_build_node,
  dependent: scheduler_emit_node,
  kind: DataDependsOn,
  usage_site: scheduler_emit_node
}

data scheduler_test_to_emit_dependency: DependencyView = DependencyView {
  source: scheduler_test_node,
  dependent: scheduler_emit_node,
  kind: DataDependsOn,
  usage_site: scheduler_emit_node
}

data scheduler_fixture_nodes: List<Node> = [
  scheduler_build_node,
  scheduler_test_node,
  scheduler_emit_node
]

data scheduler_fixture_dependencies: List<DependencyView> = [
  scheduler_build_to_emit_dependency,
  scheduler_test_to_emit_dependency
]

data scheduler_fixture_reversed_dependencies: List<DependencyView> = [
  DependencyView {
    source: scheduler_emit_node,
    dependent: scheduler_build_node,
    kind: DataDependsOn,
    usage_site: scheduler_build_node
  },
  DependencyView {
    source: scheduler_emit_node,
    dependent: scheduler_test_node,
    kind: DataDependsOn,
    usage_site: scheduler_test_node
  }
]

data scheduler_expected_layers: List<ReadinessLayer> = [
  ReadinessLayer { ready: [scheduler_build_node, scheduler_test_node] },
  ReadinessLayer { ready: [scheduler_emit_node] }
]

fn scheduler_fixture_plan() -> SchedulerPlan {
  scheduler_plan_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies
  )
}

fn scheduler_reversed_fixture_plan() -> SchedulerPlan {
  scheduler_plan_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_reversed_dependencies
  )
}

fn scheduler_layers_compute_independent_frontier() -> Bool {
  scheduler_fixture_plan().layers == scheduler_expected_layers
}

fn scheduler_plan_carries_runnable_frontier() -> Bool {
  scheduler_fixture_plan().runnable.ready == [scheduler_build_node, scheduler_test_node]
}

fn scheduler_reversed_dependencies_change_frontier() -> Bool {
  scheduler_reversed_fixture_plan().runnable.ready != scheduler_fixture_plan().runnable.ready
}

data scheduler_runnable_frontier_independent_layer_receipt: Bool = scheduler_layers_compute_independent_frontier()

data scheduler_runnable_frontier_plan_carries_ready_set: Bool = scheduler_plan_carries_runnable_frontier()

data scheduler_runnable_frontier_discriminates_dependency_order: Bool = scheduler_reversed_dependencies_change_frontier()

fn scheduler_runnable_frontier_claims_hold() -> Bool {
  scheduler_runnable_frontier_independent_layer_receipt && scheduler_runnable_frontier_plan_carries_ready_set && scheduler_runnable_frontier_discriminates_dependency_order
}
