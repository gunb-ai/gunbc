// src/v4/test/claim/manual/scheduler_runnable_frontier.dag
// Scope: scheduler runnable-frontier fixture.
// Status: manual fixture until generated TestClaim execution lands.

module v4.test.claim.manual.scheduler_runnable_frontier

import v4.std.collection { List }
import v4.std.dependency {
  Contains,
  DataDependsOn,
  DependencyView,
  topological_layers
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.workflow.scheduler {
  RunnableFrontier,
  SchedulerNoRunnableFrontier,
  SchedulerPlanBlocked,
  SchedulerPlanProduced,
  runnable_frontier,
  runnable_frontier_from_dependencies,
  scheduler_plan,
  scheduler_plan_from_dependencies
}

data scheduler_root_symbol: Symbol = scheduler_root_symbol
data scheduler_build_symbol: Symbol = scheduler_build_symbol
data scheduler_test_symbol: Symbol = scheduler_test_symbol
data scheduler_emit_symbol: Symbol = scheduler_emit_symbol

data scheduler_build_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: scheduler_build_symbol } },
  children: []
}

data scheduler_test_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: scheduler_test_symbol } },
  children: []
}

data scheduler_emit_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: scheduler_emit_symbol } },
  children: []
}

data scheduler_fixture_graph: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: scheduler_build_symbol }, target: scheduler_build_node },
    Edge { label: Named { name: scheduler_test_symbol }, target: scheduler_test_node },
    Edge { label: Named { name: scheduler_emit_symbol }, target: scheduler_emit_node }
  ]
}

data scheduler_build_to_emit_dependency: DependencyView = DependencyView {
  source: scheduler_build_node,
  dependent: scheduler_emit_node,
  kind: DataDependsOn,
  usage_site: scheduler_emit_node
}

data scheduler_test_to_emit_dependency: DependencyView = DependencyView {
  source: scheduler_test_node,
  dependent: scheduler_emit_node,
  kind: DataDependsOn,
  usage_site: scheduler_emit_node
}

data scheduler_fixture_nodes: List<Node> = [
  scheduler_build_node,
  scheduler_test_node,
  scheduler_emit_node
]

data scheduler_fixture_dependencies: List<DependencyView> = [
  scheduler_build_to_emit_dependency,
  scheduler_test_to_emit_dependency
]

data scheduler_fixture_reversed_dependencies: List<DependencyView> = [
  DependencyView {
    source: scheduler_emit_node,
    dependent: scheduler_build_node,
    kind: DataDependsOn,
    usage_site: scheduler_build_node
  },
  DependencyView {
    source: scheduler_emit_node,
    dependent: scheduler_test_node,
    kind: DataDependsOn,
    usage_site: scheduler_test_node
  }
]

data scheduler_contains_noise_dependency: DependencyView = DependencyView {
  source: scheduler_emit_node,
  dependent: scheduler_build_node,
  kind: Contains,
  usage_site: scheduler_build_node
}

data scheduler_fixture_dependencies_with_contains_noise: List<DependencyView> = [
  scheduler_build_to_emit_dependency,
  scheduler_test_to_emit_dependency,
  scheduler_contains_noise_dependency
]

data scheduler_missing_prerequisite_dependencies: List<DependencyView> = [
  DependencyView {
    source: scheduler_emit_node,
    dependent: scheduler_build_node,
    kind: DataDependsOn,
    usage_site: scheduler_build_node
  }
]

fn scheduler_initial_frontier() -> RunnableFrontier {
  runnable_frontier_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies,
    scheduled: []
  )
}

fn scheduler_after_independent_frontier() -> RunnableFrontier {
  runnable_frontier_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies,
    scheduled: [scheduler_build_node, scheduler_test_node]
  )
}

fn scheduler_reversed_initial_frontier() -> RunnableFrontier {
  runnable_frontier_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_reversed_dependencies,
    scheduled: []
  )
}

fn scheduler_contains_noise_frontier() -> RunnableFrontier {
  runnable_frontier_from_dependencies(
    nodes: scheduler_fixture_nodes,
    dependencies: scheduler_fixture_dependencies_with_contains_noise,
    scheduled: []
  )
}

fn scheduler_layers_reuse_dependency_fold() -> Bool {
  match scheduler_plan(graph_node: scheduler_fixture_graph) {
    SchedulerPlanProduced { layers: layers } => layers == topological_layers(graph_node: scheduler_fixture_graph)
    SchedulerPlanBlocked { evidence: _ } => false
  }
}

fn scheduler_graph_frontier_projects_first_layer() -> Bool {
  runnable_frontier(graph_node: scheduler_fixture_graph).ready == [scheduler_fixture_graph]
}

fn scheduler_dependency_frontier_carries_runnable_work() -> Bool {
  scheduler_initial_frontier().ready == [scheduler_build_node, scheduler_test_node]
}

fn scheduler_next_frontier_after_independent_work() -> Bool {
  scheduler_after_independent_frontier().ready == [scheduler_emit_node]
}

fn scheduler_reversed_dependencies_change_frontier() -> Bool {
  scheduler_reversed_initial_frontier().ready != scheduler_initial_frontier().ready
}

fn scheduler_contains_edges_do_not_block_execution() -> Bool {
  scheduler_contains_noise_frontier().ready == [scheduler_build_node, scheduler_test_node]
}

fn scheduler_missing_prerequisite_blocks_with_evidence() -> Bool {
  match scheduler_plan_from_dependencies(
    nodes: [scheduler_build_node],
    dependencies: scheduler_missing_prerequisite_dependencies,
    scheduled: []
  ) {
    SchedulerPlanProduced { layers: _ } => false
    SchedulerPlanBlocked { evidence: SchedulerNoRunnableFrontier { unscheduled: unscheduled } } => unscheduled == [scheduler_build_node]
  }
}

data scheduler_runnable_frontier_reuses_dependency_fold: Bool = scheduler_layers_reuse_dependency_fold()

data scheduler_runnable_frontier_projects_canonical_first_layer: Bool = scheduler_graph_frontier_projects_first_layer()

data scheduler_runnable_frontier_dependency_ready_set: Bool = scheduler_dependency_frontier_carries_runnable_work()

data scheduler_runnable_frontier_next_layer_receipt: Bool = scheduler_next_frontier_after_independent_work()

data scheduler_runnable_frontier_discriminates_dependency_order: Bool = scheduler_reversed_dependencies_change_frontier()

data scheduler_runnable_frontier_ignores_contains_edges: Bool = scheduler_contains_edges_do_not_block_execution()

data scheduler_runnable_frontier_blocks_missing_prerequisite: Bool = scheduler_missing_prerequisite_blocks_with_evidence()

fn scheduler_runnable_frontier_claims_hold() -> Bool {
  scheduler_runnable_frontier_reuses_dependency_fold && scheduler_runnable_frontier_projects_canonical_first_layer && scheduler_runnable_frontier_dependency_ready_set && scheduler_runnable_frontier_next_layer_receipt && scheduler_runnable_frontier_discriminates_dependency_order && scheduler_runnable_frontier_ignores_contains_edges && scheduler_runnable_frontier_blocks_missing_prerequisite
}
