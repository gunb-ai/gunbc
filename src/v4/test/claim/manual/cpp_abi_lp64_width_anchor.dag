type cpp_lp64_anchor_data_model = CppTargetDataModel<CppDataModelFamilyLP64, CppLP64IntegerWidths, CppPlainCharSignedness, CppWcharTSignedness>
type cpp_lp64_anchor_target_profile = CppTargetProfile<CppAbiModelItaniumCxxAbi186, cpp_lp64_anchor_data_model>
