// src/v4/test/claim/manual/comprep_branch_eval_by_execution.dag
// Scope: COMPREP wave-2 M0-B1 runtime keystone — source-gated if-then-else Branch body executes through eval.
// Status: executable --claim-run witness; swapped then/else arms are the discriminating red.

module v4.test.claim.manual.comprep_branch_eval_by_execution

import v4.compiler.body_producer {
  produce_mvp1_pick_if_arrow_with_body,
  produce_mvp1_pick_if_arrow_with_body_swapped_arms
}
import v4.test.claim.complexity_gate.comprep_wave1_branch_subject_producer {
  comprep_source_bridged_pick_if_arrow_with_body,
  comprep_wave1_branch_parse_tokens
}
import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval,
  inputs_root_only,
  run_test_claim,
  test_claim_run_verdict,
  test_claim_typed_input_node
}
import v4.compiler.infer { InferredFacts, InferredTree }
import v4.compiler.normalize { normalize }
import v4.compiler.resolve { resolve }
import v4.compiler.tokenize { tokenize }
import v4.extdeps.languages.dag {
  dag_language_model_wave1,
  dag_mvp1_pick_source_text
}
import v4.std.collection {
  Absent,
  List,
  Map,
  Present,
  list_at_optional,
  map_insert
}
import v4.std.cardinality { termination_proof_witness_for_node }
import v4.test.claim.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
