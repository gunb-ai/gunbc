  TestClaim,
  TestClassification,
  Tier1,
  UnifiedTestClaim,
  Unit,
  manual_claim_anchor
}

fn comprep_branch_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    occurrence_id: SyntheticOccurrence,
    children: []
  }
}

fn comprep_branch_byte() -> Byte {
  Byte { bits: [true] }
}

fn comprep_branch_bool_type_node() -> Node {
  comprep_branch_atom(s: ^comprep_branch_bool_type)
}

fn comprep_branch_i64_node() -> Node {
  comprep_branch_atom(s: ^comprep_branch_i64)
}

fn comprep_branch_int_value(bytes: List<Byte>) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: comprep_branch_i64_node(),
      bytes: bytes
    }
  }
}

fn comprep_branch_bool_value(is_true: Bool) -> RuntimeValue {
  if is_true {
    RuntimePrimitive {
      value: RuntimePrimitiveValue {
        primitive_type: comprep_branch_bool_type_node(),
        bytes: [comprep_branch_byte()]
      }
    }
  } else {
    RuntimePrimitive {
      value: RuntimePrimitiveValue {
        primitive_type: comprep_branch_bool_type_node(),
        bytes: Empty
      }
    }
  }
}

fn comprep_branch_one_value() -> RuntimeValue {
  comprep_branch_int_value(bytes: [comprep_branch_byte()])
}

fn comprep_branch_two_value() -> RuntimeValue {
  comprep_branch_int_value(bytes: [comprep_branch_byte(), comprep_branch_byte()])
}

fn comprep_branch_literal_one_node() -> Node {
  comprep_branch_atom(s: ^dag_mvp1_pick_lit_one)
}

fn comprep_branch_literal_two_node() -> Node {
  comprep_branch_atom(s: ^dag_mvp1_pick_lit_two)
}

fn comprep_branch_runtime_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^comprep_branch_runtime_rejected,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn comprep_branch_runtime_bool_true(value: RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == comprep_branch_bool_type_node()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn comprep_branch_runtime_bool_false(value: RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == comprep_branch_bool_type_node()) && (count(p.bytes) == 0)
    _ => false
  }
}

fn comprep_branch_runtime_int_is_one(value: RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == comprep_branch_i64_node()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn comprep_branch_bool_true_arg_node() -> Node {
  comprep_branch_atom(s: ^comprep_branch_bool_true_arg)
}

fn comprep_branch_bool_false_arg_node() -> Node {
  comprep_branch_atom(s: ^comprep_branch_bool_false_arg)
}

fn comprep_branch_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  if node == comprep_branch_literal_one_node() {
    outcome_accepted(value: comprep_branch_one_value())
  } else if node == comprep_branch_literal_two_node() {
    outcome_accepted(value: comprep_branch_two_value())
  } else if node == comprep_branch_bool_true_arg_node() {
    outcome_accepted(value: comprep_branch_bool_value(is_true: true))
  } else if node == comprep_branch_bool_false_arg_node() {
    outcome_accepted(value: comprep_branch_bool_value(is_true: false))
  } else {
    outcome_rejected(d: comprep_branch_runtime_diagnostic(n: node))
  }
}

fn comprep_branch_call_primitive(
  _node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  outcome_rejected(d: comprep_branch_runtime_diagnostic(n: _node))
}

fn comprep_branch_nth_child_target(node: Node, wanted: Int) -> Outcome<Node> {
  match list_at_optional(xs: node.children, index: wanted) {
    Present { value: edge } => outcome_accepted(value: edge.target)
    Absent =>
      outcome_rejected(d: comprep_branch_runtime_diagnostic(n: node))
  }
}

fn comprep_branch_choose_branch_bool_if_else(
  node: Node,
  condition: RuntimeValue,
  _env: EvaluationEnvironment
) -> Outcome<Node> {
  if count(node.children) == 3 {
    if comprep_branch_runtime_bool_true(value: condition) {
      comprep_branch_nth_child_target(node: node, wanted: 1)
    } else if comprep_branch_runtime_bool_false(value: condition) {
      comprep_branch_nth_child_target(node: node, wanted: 2)
    } else {
      outcome_rejected(d: comprep_branch_runtime_diagnostic(n: node))
    }
  } else {
    outcome_rejected(d: comprep_branch_runtime_diagnostic(n: node))
  }
}

fn comprep_branch_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  outcome_rejected(d: comprep_branch_runtime_diagnostic(n: node))
}

fn comprep_branch_bind_value(
  key: EnvironmentBindingKey,
  value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted {
    value: EvaluationEnvironment {
      bindings: map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: None
  }
}

fn comprep_branch_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: comprep_branch_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: comprep_branch_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: comprep_branch_choose_branch_bool_if_else
    },
    loop: LoopInterpreter {
      step_loop: comprep_branch_step_loop
    },
    bind: BindInterpreter {
      bind_value: comprep_branch_bind_value
    }
  }
}

fn comprep_branch_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^comprep_branch_allocate_literal_sym,
    call_primitive: ^comprep_branch_call_primitive_sym,
    choose_branch: ^comprep_branch_choose_branch_bool_if_else_sym,
    step_loop: ^comprep_branch_step_loop_sym,
    bind_value: ^comprep_branch_bind_value_sym
  }
}

fn comprep_branch_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^comprep_branch_runtime_id,
    interpretation: comprep_branch_interpretation(),
    structure_witness: comprep_branch_interpretation_structure_witness()
  )
}

fn comprep_branch_pick_call(callee: Node, condition: Bool) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Positional, target: callee },
      Edge {
        label: Positional,
        target:
          if condition {
            comprep_branch_bool_true_arg_node()
          } else {
            comprep_branch_bool_false_arg_node()
          }
      }
    ]
  }
}

fn comprep_branch_tree_root(call: Node, expected: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    occurrence_id: SyntheticOccurrence,
    children: [
      Edge { label: Named { name: ^comprep_branch_actual }, target: call },
      Edge { label: Named { name: ^comprep_branch_expected }, target: expected }
    ]
  }
}

fn comprep_branch_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Holds {
    value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: comprep_branch_i64_node(),
      descent: termination_proof_witness_for_node(n: key)
    )
  }
}

fn comprep_branch_admitted_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: comprep_branch_facts_lookup
    }
  }
}

fn comprep_branch_inferred_run_tree(callee: Node, expected: Node, condition: Bool) -> Outcome<InferredTree> {
  let call = comprep_branch_pick_call(callee: callee, condition: condition)
  let root = comprep_branch_tree_root(call: call, expected: expected)
  outcome_accepted(value: comprep_branch_admitted_tree(root: root))
}

fn comprep_branch_claim(input: Node, expected: Node) -> TestClaim {
  CompilesClaim {
    label: "manual/comprep_branch: source-bridged if-then-else Branch.body executes through eval",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}

fn comprep_branch_subject(
  tree: InferredTree,
  input: Node,
  expected: Node
) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: comprep_branch_claim(input: input, expected: expected),
    context: comprep_branch_context(),
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^comprep_branch_pick_call_pin
    )
  }
}

fn comprep_branch_run(
  callee: Node,
  expected: Node,
  condition: Bool
) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  let input = comprep_branch_pick_call(callee: callee, condition: condition)
  bind_outcome(
    o: comprep_branch_inferred_run_tree(
      callee: callee,
      expected: expected,
      condition: condition
    ),
    f: fn(tree) {
      outcome_accepted(
        value: run_test_claim(
          subject: comprep_branch_subject(tree: tree, input: input, expected: expected)
        )
      )
    }
  )
}

fn comprep_branch_run_passes(run: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_branch_source_pipeline_admits_holds() -> Bool {
  match comprep_source_bridged_pick_if_arrow_with_body() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_branch_source_driven_pick_true_executes_holds() -> Bool {
  match comprep_source_bridged_pick_if_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      comprep_branch_run_passes(
        run: comprep_branch_run(
          callee: arrow,
          expected: comprep_branch_literal_one_node(),
          condition: true
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_branch_source_driven_pick_false_executes_holds() -> Bool {
  match comprep_source_bridged_pick_if_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      comprep_branch_run_passes(
        run: comprep_branch_run(
          callee: arrow,
          expected: comprep_branch_literal_two_node(),
          condition: false
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_branch_direct_runtime_true_holds() -> Bool {
  match comprep_source_bridged_pick_if_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } => {
      let input = comprep_branch_pick_call(callee: arrow, condition: true)
      match comprep_branch_inferred_run_tree(
        callee: arrow,
        expected: comprep_branch_literal_one_node(),
        condition: true
      ) {
        Accepted { value: tree, diagnostics: _ } =>
          match eval(
            tree: tree,
            interpretation: comprep_branch_interpretation(),
            inputs: inputs_root_only(root: input)
          ) {
            Accepted { value: actual, diagnostics: None } =>
              comprep_branch_runtime_int_is_one(value: actual)
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    }
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_branch_swapped_arms_red_holds() -> Bool {
  match produce_mvp1_pick_if_arrow_with_body_swapped_arms() {
    Accepted { value: arrow, diagnostics: _ } =>
      comprep_branch_run_passes(
        run: comprep_branch_run(
          callee: arrow,
          expected: comprep_branch_literal_one_node(),
          condition: true
        )
      ) == false
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_branch_fixture_producer_holds() -> Bool {
  match produce_mvp1_pick_if_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      comprep_branch_run_passes(
        run: comprep_branch_run(
          callee: arrow,
          expected: comprep_branch_literal_one_node(),
          condition: true
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

// COMPREP wave-2 M0-B1 runtime keystone:
//   1. source-driven-true — bridged pick(b) if b then 1 else 2 executes to 1 when b=true;
//   2. source-driven-false — same body executes to 2 when b=false;
//   3. source-pipeline-admits — source pick fn tokenizes→parses→normalizes→resolves→body_producer;
//   4. swapped-arms-red — then/else swap fails when b=true expects 1;
//   5. fixture-producer — direct fixture path also executes (sanity).
fn comprep_branch_eval_by_execution_keystone_holds() -> Bool {
  comprep_branch_source_driven_pick_true_executes_holds()
    && comprep_branch_source_driven_pick_false_executes_holds()
    && comprep_branch_direct_runtime_true_holds()
    && comprep_branch_source_pipeline_admits_holds()
    && comprep_branch_swapped_arms_red_holds()
    && comprep_branch_fixture_producer_holds()
}

data unified_claim_comprep_branch_eval_by_execution: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/manual/comprep_branch_eval_by_execution.dag",
    function: comprep_branch_eval_by_execution_keystone_holds
  }
}
