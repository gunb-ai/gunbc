// Both platform-int and int64 share std_projection_additive_numeric; tiebreak must select
// platform int via go_mvp1_selection_policy (go_int_inhabitant_node fact-alignment).
fn inhabitant_neutralization_go_additive_numeric_lookup_tiebreak_selects_platform_int_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: std_projection_additive_numeric,
    target: go_mvp1_target_model()
  ) {
    Accepted { value: selected, diagnostics: _ } =>
      selected == go_int_additive_numeric_inhabitant_node()
    Rejected { diagnostics: _ } => false
  }
}

// (B) fail-closed discrimination: tiebreak winner is a function of selection_policy, not hardcoded.
test fn inhabitant_neutralization_go_additive_numeric_lookup_policy_flip_selects_int64_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: std_projection_additive_numeric,
    target: go_mvp1_target_model_int64_selection_policy()
  ) {
    Accepted { value: selected, diagnostics: _ } =>
      selected == go_int64_additive_numeric_inhabitant_node()
    Rejected { diagnostics: _ } => false
  }
}

// Single-candidate platform path: canonical go_std_projection_int resolves without tiebreak.
test fn inhabitant_neutralization_go_platform_std_projection_lookup_baseline_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: go_facts_int.std_projection,
    target: go_mvp1_target_model()
  ) {
    Accepted { value: selected, diagnostics: _ } =>
      selected == go_int_inhabitant_node()
    Rejected { diagnostics: _ } => false
  }
}

// Fail-closed: std_projection with no declared inhabitant must Reject.
test fn inhabitant_neutralization_go_unqualified_std_projection_lookup_rejects_holds() -> Bool {
  match target_inhabitant_for_std_projection(
    std_projection: go_facts_float64.std_projection,
    target: go_mvp1_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn inhabitant_neutralization_go_int64_to_ts_emit_holds() -> Bool {
  match neutralize_core_for_target(
    core: go_int64_falsifier_emitted_add_fn_node(),
    target: ts_mvp1_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: ts_mvp1_target_model()) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Hermetic: python fixture core neutralizes to go platform int (not int64) via std_projection lookup.
fn inhabitant_neutralization_neutralize_python_to_go_holds() -> Bool {
  match neutralize_core_for_target(
    core: python_mvp1_emitted_add_fn_node(),
    target: go_mvp1_target_model()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_third_inhabitant_falsifier_holds() -> Bool {
  inhabitant_neutralization_go_int64_std_projection_holds()
    && inhabitant_neutralization_go_int_additive_numeric_std_projection_holds()
    && inhabitant_neutralization_go_int_additive_numeric_target_lookup_holds()
    && inhabitant_neutralization_go_additive_numeric_lookup_tiebreak_selects_platform_int_holds()
    && inhabitant_neutralization_neutralize_python_to_go_holds()
    && inhabitant_neutralization_go_int64_to_ts_emit_holds()
}

test fn inhabitant_neutralization_emit_after_neutralize_holds() -> Bool {
  match neutralize_core_for_target(
    core: python_mvp1_emitted_add_fn_node(),
    target: ts_mvp1_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: ts_mvp1_target_model()) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_raw_emit_still_fails_closed() -> Bool {
  match infer(tree: python_mvp1_emitted_add_fn_node()) {
    Accepted { value: inferred, diagnostics: _ } =>
      match emit(tree: inferred, target: ts_mvp1_target_model()) {
        Rejected { diagnostics: _ } => true
        Accepted { value: _, diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Regression guard for surgical 03_ingest.dag edit: same-flavor cross_language_compile path
// (dag fixture → dag target via bridge + neutralize + infer + emit) unchanged after neutralize insert.
fn inhabitant_neutralization_same_language_cross_language_compile_unchanged_holds() -> Bool {
  ingest_cross_language_compile_holds()
}

// Same-flavor python→python: neutralize is std_projection-keyed lookup identity; emit still accepts.
fn inhabitant_neutralization_same_flavor_python_emit_holds() -> Bool {
  match neutralize_core_for_target(
    core: python_mvp1_emitted_add_fn_node(),
    target: python_mvp1_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: python_mvp1_target_model()) {
            Accepted { value: _, diagnostics: _ } => true
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

test fn inhabitant_neutralization_03_ingest_regression_guard_holds() -> Bool {
  inhabitant_neutralization_same_language_cross_language_compile_unchanged_holds()
    && inhabitant_neutralization_same_flavor_python_emit_holds()
    && inhabitant_neutralization_raw_emit_still_fails_closed()
}

// HEAVY (~627s): real python source -> parse -> cross_language_compile (bridge -> neutralize -> infer -> emit)
// on the live parse tree. Each stage feeds the next — NOT independent conjuncts / NOT fixture-fed core.
// The python→ts matrix cell is already ChainProven (cross_language_add_python_to_typescript.dag,
// proven via chain_status_holds); this e2e is an independent, stronger correct-TS receipt
// (source == ts_mvp1_source_text, not non-empty), NOT a matrix flip (matrix file 0-diff).
fn inhabitant_neutralization_python_to_ts_cross_language_compile_e2e_holds() -> Bool {
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: python_parse_tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: python_parse_tree,
        source_model: python_mvp1_target_model(),
        target_model: ts_mvp1_target_model()
      ) {
        Accepted { value: source, diagnostics: _ } => source == ts_mvp1_source_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// HEAVY (~627s): python->go cross-language cell — mirrors python->ts e2e above.
// CONNECTED: live parse_tree is the literal cross_language_compile input (no fixture-fed core).
// CORRECT-SOURCE: source == pinned go_mvp1_source_text (NOT non-empty / Cons overclaim).
// GENERIC: routes through cross_language_compile + neutralize_core_for_target — NO go-specific arm.
// Inhabitant routing (python int -> go platform int) is hermetic-green above; full e2e still RED
// until go emit breadth accepts infer(neutralized) trees (separate §3 emit lane).
fn inhabitant_neutralization_python_to_go_cross_language_compile_e2e_holds() -> Bool {
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: python_parse_tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: python_parse_tree,
        source_model: python_mvp1_target_model(),
        target_model: go_mvp1_target_model()
      ) {
        Accepted { value: source, diagnostics: _ } => source == go_mvp1_source_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// DISCRIMINATION: same REAL parsed tree against ts target must yield pinned ts source (positive control).
fn inhabitant_neutralization_python_to_go_discriminates_on_real_tree() -> Bool {
  match python_mvp1_grammar_parse_fixture() {
    Accepted { value: python_parse_tree, diagnostics: _ } =>
      match cross_language_compile(
        parse_tree: python_parse_tree,
        source_model: python_mvp1_target_model(),
        target_model: ts_mvp1_target_model()
      ) {
        Accepted { value: source, diagnostics: _ } => source == ts_mvp1_source_text
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Composite heavy receipt (NOT BoolWitnessed — slow-lane / draft-until-sign).
fn inhabitant_neutralization_python_to_go_holds() -> Bool {
  inhabitant_neutralization_python_to_go_cross_language_compile_e2e_holds()
    && inhabitant_neutralization_python_to_go_discriminates_on_real_tree()
}

// Emit-RED localization (draft-until-sign; NOT BoolWitnessed):
// Stage chain for python_mvp1_emitted_add_fn_node -> go_mvp1_target_model:
//   neutralize PASS | infer PASS | translate REJECT | emit REJECT (emit = translate ∘ serialize).
// Reject site: v4.compiler.emit::emit -> translate::translate -> translate_node_mvp1
//   (grammar row miss on python Arrow skeleton) -> translate_mvp1_fold_init Arrow arm
//   -> coerce_grounded_node -> coercion_fold_exact_structural / find_witness
//   (preservation_rule_exact_structural_equality_zip_fold) -> CoercionMismatchKind diagnostic
//   (discriminant; NOT inhabitant_neutralization_*). Python Arrow lacks go_surface_fn_item edge
//   present on native go_mvp1_emitted_add_fn_node — structural emit-breadth gap, independent of
//   int64 vs platform-int inhabitant routing (tiebreak selects platform int; same translate failure).
// Native go emit ACCEPTS with grounded InferredTree (mvp1_go_add_translate.dag::
// python->go RED is translate coercion on neutralized python Arrow skeleton, not native go emit-breadth.
fn inhabitant_neutralization_python_to_go_translate_rejects() -> Bool {
  match neutralize_core_for_target(
    core: python_mvp1_emitted_add_fn_node(),
    target: go_mvp1_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match translate(tree: inferred, target: go_mvp1_target_model()) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn inhabitant_neutralization_python_to_go_emit_rejects() -> Bool {
  match neutralize_core_for_target(
    core: python_mvp1_emitted_add_fn_node(),
    target: go_mvp1_target_model()
  ) {
    Accepted { value: neutralized, diagnostics: _ } =>
      match infer(tree: neutralized) {
        Accepted { value: inferred, diagnostics: _ } =>
          match emit(tree: inferred, target: go_mvp1_target_model()) {
            Rejected { diagnostics: _ } => true
            Accepted { value: _, diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

data claim_inhabitant_neutralization_module_compiles: TestClaim = CompilesClaim {
  label: "manual/inhabitant_neutralization: module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: python_mvp1_emitted_add_fn_node(),
  expected_value: python_mvp1_emitted_add_fn_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
