// src/v4/test/claim/manual/infer_algebra_ref_grounding_anchor.dag
// Scope: Option B behavior receipts — algebra_ref_is_grounded guard in canonical_grounding_from_inferred_facts.
// Owns: algebra_ref_bare_atom_is_ungrounded, algebra_ref_conj_is_grounded, anchor_canonical_grounding_rejects_bare_atom.
// Consumes: compiler/04_infer.dag, std/cardinality.dag, std/constraints.dag, std/node.dag, std/witness.dag.
// Status: compile-only anchor; execution deferred to T-22 runner bridge.
// Anchor: TASKS.md T-4 Wave 2b — dissolves when constraint solver reads ModelCore.inhabitance.


module v4.test.claim.manual.infer_algebra_ref_grounding_anchor


import v4.compiler.infer {
  AlgebraRef,
  InferredFacts,
  algebra_ref_is_grounded,
  canonical_grounding_from_inferred_facts,
  infer_algebra_ref_ungrounded
}
import v4.std.cardinality { RankingDimension, TerminationProof }
import v4.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness,
  constraint_property_being_canonical,
  constraint_property_candidate_set_closedness
}
import v4.std.diagnostic { Outcome, Rejected }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode }
import v4.std.witness { Holds, StructuralPropertyWitness, Witness }


data anchor_algebra_ungrounded_sym: Symbol = anchor_algebra_ungrounded_sym
data anchor_algebra_grounded_sym: Symbol = anchor_algebra_grounded_sym
data anchor_resolved_type_sym: Symbol = anchor_resolved_type_sym
data anchor_witness_sym: Symbol = anchor_witness_sym
data anchor_canonical_sym: Symbol = anchor_canonical_sym
data anchor_descent_dim_sym: Symbol = anchor_descent_dim_sym


fn anchor_atom_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


fn anchor_conj_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: []
  }
}


// Unit receipts: algebra_ref_is_grounded returns false for bare Atom, true for Conj.
data algebra_ref_bare_atom_is_ungrounded: Bool =
  !algebra_ref_is_grounded(algebra: anchor_atom_node(s: anchor_algebra_ungrounded_sym))

data algebra_ref_conj_is_grounded: Bool =
  algebra_ref_is_grounded(algebra: anchor_conj_node())


fn anchor_inferred_facts_bare_atom_algebra() -> InferredFacts {
  InferredFacts {
    resolved_type: anchor_atom_node(s: anchor_resolved_type_sym),
    inhabits: AlgebraRef {
      algebra: anchor_atom_node(s: anchor_algebra_ungrounded_sym),
      witness: anchor_atom_node(s: anchor_witness_sym)
    },
    descent: Holds {
      value: TerminationProof {
        non_increasing: [],
        strict: RankingDimension { measured: anchor_descent_dim_sym }
      }
    },
    canonical: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: constraint_property_being_canonical,
        evidence: anchor_atom_node(s: anchor_algebra_ungrounded_sym)
      },
      closedness: StructuralPropertyWitness {
        property: constraint_property_candidate_set_closedness,
        evidence: anchor_atom_node(s: anchor_resolved_type_sym)
      }
    }
  }
}


// Behavior receipt: canonical_grounding_from_inferred_facts rejects when algebra is a bare Atom.
// T-22 runner verifies this is Rejected { reason: infer_algebra_ref_ungrounded }.
data anchor_canonical_grounding_rejects_bare_atom: Outcome<CanonicalGrounding> =
  canonical_grounding_from_inferred_facts(
    node: anchor_atom_node(s: anchor_resolved_type_sym),
    facts: anchor_inferred_facts_bare_atom_algebra()
  )
