fn eval_mvp2_literal_node(name: Symbol) -> Node {
  Node {
    kind: ComputationNode { behavior: Value },
    children: [
      Edge {
        label: Named { name: name },
        target: eval_mvp2_i64_node()
      }
    ]
  }
}


fn eval_mvp2_add_subgraph() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: eval_mvp2_literal_node(name: eval_mvp2_left_symbol)
      },
      Edge {
        label: Positional,
        target: eval_mvp2_literal_node(name: eval_mvp2_right_symbol)
      }
    ]
  }
}


fn eval_mvp2_host_value(bytes: List<Byte>) -> HostValue {
  HostPrimitive {
    value: HostPrimitiveValue {
      primitive_type: eval_mvp2_i64_node(),
      bytes: bytes
    }
  }
}


fn eval_mvp2_two_value() -> HostValue {
  eval_mvp2_host_value(bytes: [eval_mvp2_byte(), eval_mvp2_byte()])
}


fn eval_mvp2_five_value() -> HostValue {
  eval_mvp2_host_value(
    bytes: [
      eval_mvp2_byte(),
      eval_mvp2_byte(),
      eval_mvp2_byte(),
      eval_mvp2_byte(),
      eval_mvp2_byte()
    ]
  )
}


fn eval_mvp2_allocate_literal(_node: Node, _env: HostEnvironment) -> Outcome<HostValue> {
  Accepted { value: eval_mvp2_two_value(), diagnostics: None }
}


fn eval_mvp2_arg_is_two_literal(value: HostValue) -> Bool {
  match value {
    HostPrimitive { value: p } =>
      (p.primitive_type == eval_mvp2_i64_node()) && (count(p.bytes) == 2)
    _ => false
  }
}


fn eval_mvp2_args_are_two_literals(args: List<HostValue>) -> Bool {
  if count(args) == 2 {
    match first(args) {
      Some { value: left } =>
        match first(skip(args, 1)) {
          Some { value: right } =>
            eval_mvp2_arg_is_two_literal(value: left)
              && eval_mvp2_arg_is_two_literal(value: right)
          None => false
        }
      None => false
    }
  } else {
    false
  }
}


fn eval_mvp2_call_primitive(
  _node: Node,
  args: List<HostValue>,
  _env: HostEnvironment
) -> Outcome<HostValue> {
  if eval_mvp2_args_are_two_literals(args: args) {
    Accepted { value: eval_mvp2_five_value(), diagnostics: None }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: eval_diagnostic(reason: eval_mvp2_args_not_two_literals, node: _node)
      )
    }
  }
}


fn eval_mvp2_choose_branch(_node: Node, _value: HostValue, _env: HostEnvironment) -> Outcome<Node> {
  Accepted { value: eval_mvp2_add_subgraph(), diagnostics: None }
}


fn eval_mvp2_step_loop(_node: Node, _env: HostEnvironment) -> Outcome<HostControlTransfer> {
  Accepted { value: HostContinue { value: eval_mvp2_five_value() }, diagnostics: None }
}


fn eval_mvp2_bind_value(
  _key: HostBindingKey,
  _value: HostValue,
  env: HostEnvironment
) -> Outcome<HostEnvironment> {
  Accepted { value: env, diagnostics: None }
}


fn eval_mvp2_represent_result(value: HostValue) -> Outcome<HostValue> {
  Accepted { value: value, diagnostics: None }
}


fn eval_mvp2_allocate(value: HostValue) -> Outcome<HostValue> {
  Accepted { value: value, diagnostics: None }
}


fn eval_mvp2_call(_call: HostCall, _frame: HostFrame) -> Outcome<HostControlTransfer> {
  Accepted { value: HostReturn { value: eval_mvp2_five_value() }, diagnostics: None }
}


fn eval_mvp2_return_value(value: HostValue, _frame: HostFrame) -> Outcome<HostControlTransfer> {
  Accepted { value: HostReturn { value: value }, diagnostics: None }
}


fn eval_mvp2_transfer(_control: HostControlTransfer, frame: HostFrame) -> Outcome<HostFrame> {
  Accepted { value: frame, diagnostics: None }
}


fn eval_mvp2_boundary_allowance() -> HostBoundaryAllowance {
  HostBoundaryAllowance {
    effect: eval_mvp2_effect_signature,
    resource: eval_mvp2_resource_access,
    allowed: true
  }
}


fn eval_mvp2_host_model() -> HostModel {
  HostModel {
    core: eval_mvp2_model_core,
    values: HostValueRepresentationModel {
      represent_literal: eval_mvp2_allocate_literal,
      represent_result: eval_mvp2_represent_result
    },
    interpretation: HostInterpretationAlgebra {
      value: HostValueInterpreter {
        allocate_literal: eval_mvp2_allocate_literal
      },
      transform: HostTransformInterpreter {
        call_primitive: eval_mvp2_call_primitive
      },
      branch: HostBranchInterpreter {
        choose_branch: eval_mvp2_choose_branch
      },
      loop: HostLoopInterpreter {
        step_loop: eval_mvp2_step_loop
      },
      bind: HostBindInterpreter {
        bind_value: eval_mvp2_bind_value
      }
    },
    execution: HostExecutionSemantics {
      allocation: HostAllocationSemantics {
        allocate: eval_mvp2_allocate
      },
      calls: HostCallSemantics {
        call: eval_mvp2_call,
        return_value: eval_mvp2_return_value
      },
      control: HostControlSemantics {
        transfer: eval_mvp2_transfer
      }
    },
    boundary: HostResourceEffectBoundary {
      ffi: eval_mvp2_boundary_allowance(),
      exceptions: eval_mvp2_boundary_allowance(),
      async: eval_mvp2_boundary_allowance(),
      concurrency: eval_mvp2_boundary_allowance(),
      identity_reference: eval_mvp2_boundary_allowance()
    }
  }
}


fn eval_mvp2_diagnostic(n: Node) -> Diagnostic {
  eval_diagnostic(reason: eval_mvp2_descent_not_derived, node: n)
}


fn eval_mvp2_algebra_ref() -> AlgebraRef {
  AlgebraRef {
    algebra: eval_mvp2_algebra_node(),
    witness: eval_mvp2_i64_node()
  }
}


fn eval_mvp2_termination_proof() -> TerminationProof {
  TerminationProof {
    non_increasing: [],
    strict: RankingDimension { measured: eval_mvp2_descent_dimension }
  }
}


fn eval_mvp2_facts() -> InferredFacts {
  InferredFacts {
    resolved_type: eval_mvp2_i64_node(),
    inhabits: eval_mvp2_algebra_ref(),
    descent: Holds { value: eval_mvp2_termination_proof() },
    canonical: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: constraint_property_being_canonical,
        evidence: eval_mvp2_algebra_node()
      },
      closedness: StructuralPropertyWitness {
        property: constraint_property_candidate_set_closedness,
        evidence: eval_mvp2_i64_node()
      }
    }
  }
}


fn eval_mvp2_fact_lookup(_node: Node) -> Witness<InferredFacts> {
  Holds { value: eval_mvp2_facts() }
}


fn eval_mvp2_inferred_tree() -> InferredTree {
  InferredTree {
    root: eval_mvp2_add_subgraph(),
    facts: Map {
      lookup: eval_mvp2_fact_lookup
    }
  }
}


fn eval_mvp2_actual() -> Outcome<HostValue> {
  eval(
    tree: eval_mvp2_inferred_tree(),
    host: eval_mvp2_host_model(),
    inputs: Inputs { root: eval_mvp2_add_subgraph() }
  )
}


data witness_eval_mvp2_add_accepts_five: Bool = match eval_mvp2_actual() {
  Accepted { value: HostPrimitive { value: p }, diagnostics: None } =>
    (p.primitive_type == eval_mvp2_i64_node()) && (count(p.bytes) == 5)
  _ => false
}


fn eval_mvp2_context() -> EvalContext {
  EvalContext {
    host: eval_mvp2_host_model()
  }
}


data claim_eval_mvp2_test_claim_route: TestClaim = EqualsClaim {
  label: "eval routes TestClaim through HostModel",
  t19_anchor: T19ManualAnchorAbsent,
  lhs: eval_mvp2_add_subgraph(),
  rhs: eval_mvp2_i64_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data run_eval_mvp2_test_claim_route: TestClaimRun<Node> = run_test_claim(
  subject: eval_test_claim_subject(
    claim: claim_eval_mvp2_test_claim_route,
    context: eval_mvp2_context(),
    tree: eval_mvp2_inferred_tree()
  ),
  claim_hash: eval_mvp2_claim_hash,
  host_hash: eval_mvp2_host_hash
)
