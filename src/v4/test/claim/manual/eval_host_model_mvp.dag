data eval_mvp2_add_symbol: Symbol = eval_mvp2_add_symbol
data eval_mvp2_left_symbol: Symbol = eval_mvp2_left_symbol
data eval_mvp2_right_symbol: Symbol = eval_mvp2_right_symbol
data eval_mvp2_i64_symbol: Symbol = eval_mvp2_i64_symbol
data eval_mvp2_algebra_symbol: Symbol = eval_mvp2_algebra_symbol
data eval_mvp2_witness_symbol: Symbol = eval_mvp2_witness_symbol
