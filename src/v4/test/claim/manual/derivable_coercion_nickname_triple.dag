// src/v4/test/claim/manual/derivable_coercion_nickname_triple.dag
// Scope: DERIVABLE-COERCION thesis payoff — TaskId nickname triple (API+DB+wire);
//   structure-preserving maps derived BY EXECUTION via find_witness/coercion_fold only.
// Status: EXECUTED Bool witnesses — positive zip-fold pairs + discriminating wrong-concept rejection.

module v4.test.claim.manual.derivable_coercion_nickname_triple

import v4.test.fixture.derivable_coercion_task_id {
  account_id_wrong_semantic_core_node,
  derivable_coercion_candidate_closedness,
  task_id_api_inhabitant_node,
  task_id_db_inhabitant_node,
  task_id_nickname_api,
  task_id_nickname_db,
  task_id_nickname_wire,
  task_id_wire_inhabitant_node
}
import v4.std.coercion {
  CoercionCandidateSet,
  CoercionQuality,
  Exact,
  Identity,
  Widened,
  coercion_fold
}
import v4.std.collection { List }
import v4.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness
}
import v4.std.diagnostic {
  Accepted,
  Outcome,
  Rejected
}
import v4.std.find_witness {
  CandidateSet,
  FindWitnessResult,
  PreservationPredicate,
  TargetDeclaredPriority,
  UniqueOnly,
  find_witness,
  find_witness_reason_no_candidate,
  preservation_rule_exact_structural_equality_zip_fold,
  verify_witness
}
import v4.std.node { Node }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { StructuralPropertyWitness }

fn task_id_exact_predicate(source: Node) -> PreservationPredicate {
  PreservationPredicate {
    algebra: source,
    preservation_rule: preservation_rule_exact_structural_equality_zip_fold
  }
}

fn task_id_candidate_set(candidates: List<Node>, closedness_evidence: Node) -> CandidateSet {
  CandidateSet {
    candidates: candidates,
    closedness: derivable_coercion_candidate_closedness(evidence: closedness_evidence)
  }
}

fn task_id_grounding(node: Node) -> CanonicalGrounding {
  CanonicalGrounding {
    node: node,
    witness: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: preservation_rule_exact_structural_equality_zip_fold,
        evidence: node
      },
      closedness: derivable_coercion_candidate_closedness(evidence: node)
    }
  }
}

fn task_id_coercion_candidates(
  candidates: List<Node>,
  closedness_evidence: Node
) -> CoercionCandidateSet {
  CoercionCandidateSet {
    set: task_id_candidate_set(
      candidates: candidates,
      closedness_evidence: closedness_evidence
    )
  }
}

fn quality_is_exact(q: CoercionQuality) -> Bool {
  match q {
    Exact => true
    Identity => false
    Widened => false
  }
}

fn rejected_for_no_candidate(o: Outcome<FindWitnessResult>) -> Bool {
  match o {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: r } => r.head.reason == find_witness_reason_no_candidate
  }
}

fn find_witness_accepts(source: Node, target: Node) -> Bool {
  match find_witness(
    source_facts: source,
    candidates: task_id_candidate_set(
      candidates: [target],
      closedness_evidence: target
    ),
    predicate: task_id_exact_predicate(source: source),
    multiplicity_policy: UniqueOnly
  ) {
    Accepted { value: fw, diagnostics: _ } => fw.candidate == target
    Rejected { diagnostics: _ } => false
  }
}

fn coercion_fold_accepts(source: Node, target: Node) -> Bool {
  match coercion_fold(
    source: task_id_grounding(node: source),
    candidates: task_id_coercion_candidates(
      candidates: [target],
      closedness_evidence: target
    ),
    policy: TargetDeclaredPriority { priority: target }
  ) {
    Accepted { value: r, diagnostics: _ } =>
      (r.target == target) && quality_is_exact(q: r.quality)
    Rejected { diagnostics: _ } => false
  }
}

// Positive: API → DB (nickname triple leg — no hand translator).
data witness_task_id_api_to_db_find_witness: Bool =
  find_witness_accepts(
    source: task_id_api_inhabitant_node(),
    target: task_id_db_inhabitant_node()
  )

data witness_task_id_api_to_wire_find_witness: Bool =
  find_witness_accepts(
    source: task_id_api_inhabitant_node(),
    target: task_id_wire_inhabitant_node()
  )

data witness_task_id_db_to_wire_find_witness: Bool =
  find_witness_accepts(
    source: task_id_db_inhabitant_node(),
    target: task_id_wire_inhabitant_node()
  )

// Positive: coercion_fold derives the same maps (N-hand-translations → 0).
data witness_task_id_api_to_db_coercion_fold: Bool =
  coercion_fold_accepts(
    source: task_id_api_inhabitant_node(),
    target: task_id_db_inhabitant_node()
  )

data witness_task_id_api_to_wire_coercion_fold: Bool =
  coercion_fold_accepts(
    source: task_id_api_inhabitant_node(),
    target: task_id_wire_inhabitant_node()
  )

// Discriminating: wrong concept (AccountId numeric encoding) rejects.
data witness_task_id_api_to_account_id_rejects: Bool = rejected_for_no_candidate(
  o: find_witness(
    source_facts: task_id_api_inhabitant_node(),
    candidates: task_id_candidate_set(
      candidates: [account_id_wrong_semantic_core_node()],
      closedness_evidence: account_id_wrong_semantic_core_node()
    ),
    predicate: task_id_exact_predicate(source: task_id_api_inhabitant_node()),
    multiplicity_policy: UniqueOnly
  )
)

// verify_witness round-trip on API→DB derived witness.
data witness_task_id_verify_witness_api_to_db: Bool = match verify_witness(
  source_facts: task_id_api_inhabitant_node(),
  candidate: task_id_db_inhabitant_node(),
  predicate: task_id_exact_predicate(source: task_id_api_inhabitant_node()),
  witness: StructuralPropertyWitness {
    property: preservation_rule_exact_structural_equality_zip_fold,
    evidence: task_id_db_inhabitant_node()
  }
) {
  Accepted { value: _, diagnostics: _ } => true
  Rejected { diagnostics: _ } => false
}

fn nickname_triple_claim_input(ok: Bool) -> Node {
  if ok {
    task_id_api_inhabitant_node()
  } else {
    account_id_wrong_semantic_core_node()
  }
}

data claim_derivable_coercion_nickname_triple_compiles: TestClaim = CompilesClaim {
  label: "manual/derivable_coercion: nickname triple module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: task_id_api_inhabitant_node(),
  expected_value: task_id_db_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_task_id_api_to_db_find_witness: TestClaim = CompilesClaim {
  label: "manual/derivable_coercion: API TaskId -> DB TEXT derives via find_witness (no hand translator)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nickname_triple_claim_input(ok: witness_task_id_api_to_db_find_witness),
  expected_value: task_id_db_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_task_id_api_to_wire_find_witness: TestClaim = CompilesClaim {
  label: "manual/derivable_coercion: API TaskId -> wire string derives via find_witness",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nickname_triple_claim_input(ok: witness_task_id_api_to_wire_find_witness),
  expected_value: task_id_wire_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_task_id_db_to_wire_find_witness: TestClaim = CompilesClaim {
  label: "manual/derivable_coercion: DB TEXT -> wire string derives via find_witness",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nickname_triple_claim_input(ok: witness_task_id_db_to_wire_find_witness),
  expected_value: task_id_wire_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_task_id_api_to_db_coercion_fold: TestClaim = CompilesClaim {
  label: "manual/derivable_coercion: API TaskId -> DB TEXT coercion_fold accepts Exact",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nickname_triple_claim_input(ok: witness_task_id_api_to_db_coercion_fold),
  expected_value: task_id_db_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_task_id_api_to_wire_coercion_fold: TestClaim = CompilesClaim {
  label: "manual/derivable_coercion: API TaskId -> wire string coercion_fold accepts Exact",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nickname_triple_claim_input(ok: witness_task_id_api_to_wire_coercion_fold),
  expected_value: task_id_wire_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_task_id_api_to_account_id_rejects: TestClaim = CompilesClaim {
  label: "manual/derivable_coercion: API TaskId -> AccountId numeric encoding rejects (discriminating)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nickname_triple_claim_input(ok: witness_task_id_api_to_account_id_rejects),
  expected_value: task_id_api_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_task_id_verify_witness_api_to_db: TestClaim = CompilesClaim {
  label: "manual/derivable_coercion: verify_witness accepts API->DB derived witness",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: nickname_triple_claim_input(ok: witness_task_id_verify_witness_api_to_db),
  expected_value: task_id_db_inhabitant_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
