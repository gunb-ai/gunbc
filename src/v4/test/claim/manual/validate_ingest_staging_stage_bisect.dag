// src/v4/test/claim/manual/validate_ingest_staging_stage_bisect.dag
// Scope: bisect validate_ingest_staging hang — stop after resolve / infer / lens.
// Status: diagnostic only for node://adhoc-99eb67ab-480.

module v4.test.claim.manual.validate_ingest_staging_stage_bisect

import v4.compiler.compile {
  LensGateWitness,
  Source,
  always_required_lenses,
  compile_ingest_staging_source_file,
  run_required_lens_gates_on_subtree
}
import v4.compiler.infer { infer, InferredTree }
import v4.compiler.normalize { normalize }
import v4.compiler.parse { parse, ParseTree }
import v4.compiler.resolve { resolve }
import v4.compiler.tokenize { tokenize, TokenStream }
import v4.extdeps.languages.dag { dag_language_model_wave1 }
import v4.std.collection { List }
import v4.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome
}
import v4.std.logic { Bool }
import v4.std.node { Node }

data bisect_empty_source: Source = "module stage0.bisect.empty\n"

fn bisect_through_tokenize() -> Outcome<TokenStream> {
  let lm = dag_language_model_wave1()
  tokenize(
    text: bisect_empty_source,
    file: compile_ingest_staging_source_file,
    rules: lm.lex
  )
}

fn bisect_through_parse() -> Outcome<ParseTree> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source,
      file: compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      parse(tokens: token_stream, grammar: lm.grammar)
    }
  )
}

fn bisect_through_normalize() -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source,
      file: compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          normalize(parse_tree: parse_tree)
        }
      )
    }
  )
}

fn bisect_tokenize_terminates() -> Bool {
  match bisect_through_tokenize() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_parse_terminates() -> Bool {
  match bisect_through_parse() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_normalize_terminates() -> Bool {
  match bisect_through_normalize() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_through_resolve() -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(
      text: bisect_empty_source,
      file: compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          bind_outcome(
            o: normalize(parse_tree: parse_tree),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn bisect_through_infer() -> Outcome<InferredTree> {
  bind_outcome(
    o: bisect_through_resolve(),
    f: fn(resolved) {
      infer(tree: resolved)
    }
  )
}

fn bisect_through_lens_subtree() -> Outcome<List<LensGateWitness>> {
  bind_outcome(
    o: bisect_through_infer(),
    f: fn(inferred) {
      run_required_lens_gates_on_subtree(
        inferred: inferred,
        lenses: always_required_lenses()
      )
    }
  )
}

fn bisect_resolve_terminates() -> Bool {
  match bisect_through_resolve() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_infer_terminates() -> Bool {
  match bisect_through_infer() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}

fn bisect_lens_subtree_terminates() -> Bool {
  match bisect_through_lens_subtree() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => true
  }
}
