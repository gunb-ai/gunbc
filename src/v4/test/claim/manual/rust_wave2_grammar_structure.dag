// src/v4/test/claim/manual/rust_wave2_grammar_structure.dag
// Scope: Wave-2a Rust grammar structural receipt — key Rust Reference productions are registered.
// Status: manual structural TestClaim input for wave-2a grammar contracts.

module v4.test.claim.manual.rust_wave2_grammar_structure

import v4.extdeps.languages.rust {
  RustLanguageModel,
  rust_language_model_wave2,
  rust_production_block,
  rust_production_fn_item,
  rust_production_if_expr,
  rust_production_let_stmt,
  rust_production_param_list,
  rust_production_return_expr,
  rust_production_stmt,
  rust_production_typed_param,
  rust_production_type,
  rust_token_kw_let,
  rust_wave2_lex_rules
}
import v4.compiler.parse { grammar_carries_symbol }
import v4.compiler.tokenize { lex_rule_set_token_class_member }
import v4.std.logic { Bool }

fn rust_wave2_grammar_structure_satisfied(lm: RustLanguageModel) -> Bool {
  lex_rule_set_token_class_member(rules: rust_wave2_lex_rules(), token_class: rust_token_kw_let) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: rust_production_fn_item) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: rust_production_typed_param) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: rust_production_param_list) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: rust_production_type) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: rust_production_block) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: rust_production_stmt) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: rust_production_let_stmt) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: rust_production_if_expr) &&
    grammar_carries_symbol(grammar: lm.grammar, sym: rust_production_return_expr)
}

data rust_wave2_grammar_structure_ready: Bool = rust_wave2_grammar_structure_satisfied(lm: rust_language_model_wave2())
