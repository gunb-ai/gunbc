// src/v4/test/claim/manual/refinement_brand_disjointness_is_sugar.dag
// Scope: Claim #1 — refinement-is-sugar realism gate (§11 / §9.6).
// Status: kept lock — brand where-sugar vs hand-desugared nominal wrappers must
//         accept/reject identical programs; divergence = fork/shelve.
//         Expected RED until brand enforces nominal disjointness.
// Companion evidence: v3-compiler integration test
//   refinement_brand_disjointness_is_sugar_claim_test.rs (compile facts + #[ignore] lock reruns).
// Corpus eval: v4.test.claim.workflow.refinement_brand_disjointness_is_sugar_eval

module v4.test.claim.manual.refinement_brand_disjointness_is_sugar


import v4.compiler.eval { TestClaimEvalSubject, run_test_claim_assert }
import v4.std.diagnostic {
  Accepted,
  Locus,
  None,
  Outcome,
  Rejected,
  Textual,
  WholeFile
}
import v4.std.integer { Int }
import v4.std.logic { Bool }
import v4.std.node { Node, Symbol }
import v4.std.refinement {
  Refined,
  VacuousValidation,
  refined_base,
  refined_vacuous_oracle_terminal,
  vacuous_admits_marker
}
import v4.std.verdict { Fail, Pass, Verdict }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.test.claim.manual.connective_anchors {
  stub_empty_conj,
  stub_empty_disj
}


data claim1_test_file: Symbol = claim1_test_file
data claim1_brand_a_reason: Symbol = claim1_brand_a_reason
data claim1_brand_b_reason: Symbol = claim1_brand_b_reason


fn claim1_locus() -> Locus {
  Textual { file: claim1_test_file, extent: WholeFile }
}


// Hand-desugared: genuinely distinct nominal wrappers (no brand).
type DesugaredWrapA {
  value: Int
}


type DesugaredWrapB {
  value: Int
}


// Refinement sugar: vacuous brand — models lower.rs:1130 reflexive-eq lowering.
type VacuousBrandA = VacuousValidation<Int>
type VacuousBrandB = VacuousValidation<Int>


fn vacuous_brand_a() -> VacuousBrandA {
  VacuousValidation { reason: claim1_brand_a_reason, vacuous: vacuous_admits_marker }
}


fn vacuous_brand_b() -> VacuousBrandB {
  VacuousValidation { reason: claim1_brand_b_reason, vacuous: vacuous_admits_marker }
}


fn sugar_refined_int(base: Int, brand: VacuousValidation<Int>) -> Outcome<Refined<Int>> {
  refined_vacuous_oracle_terminal(base: base, by: brand, at: claim1_locus())
}


// Program: cross-brand — use BrandB base at BrandA site.
// Sugar: vacuous validation admits any Int base under any brand tag.
fn refinement_accepts_cross_brand() -> Bool {
  match sugar_refined_int(base: 1, brand: vacuous_brand_b()) {
    Accepted { value: from_b, diagnostics: _ } =>
      match sugar_refined_int(
        base: refined_base(r: from_b),
        brand: vacuous_brand_a()
      ) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


// Hand-desugared: WrapA and WrapB are distinct types — cross-brand is unrepresentable
// at the type level; modeled as reject (cannot pass WrapB where WrapA expected).
fn desugared_accepts_cross_brand() -> Bool {
  false
}


// Program: same-brand call — both should accept.
fn refinement_accepts_same_brand() -> Bool {
  match sugar_refined_int(base: 1, brand: vacuous_brand_a()) {
    Accepted { value: a, diagnostics: _ } =>
      match sugar_refined_int(
        base: refined_base(r: a),
        brand: vacuous_brand_a()
      ) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


fn desugared_accepts_same_brand() -> Bool {
  true
}


// Program: raw literal to branded parameter without constructor.
fn refinement_accepts_raw_literal() -> Bool {
  match sugar_refined_int(base: 1, brand: vacuous_brand_a()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


fn desugared_accepts_raw_literal() -> Bool {
  false
}


fn claim1_programs_agree(refinement_accepts: Bool, desugared_accepts: Bool) -> Bool {
  refinement_accepts == desugared_accepts
}


fn claim1_input(ok: Bool) -> Node {
  if ok {
    stub_empty_conj
  } else {
    stub_empty_disj
  }
}


data claim_refinement_brand_disjointness_cross_brand_is_sugar: TestClaim = EqualsClaim {
  label: "manual/refinement-is-sugar: brand where-sugar and hand-desugared agree on cross-brand call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim1_input(
    ok: claim1_programs_agree(
      refinement_accepts: refinement_accepts_cross_brand(),
      desugared_accepts: desugared_accepts_cross_brand()
    )
  ),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_refinement_brand_disjointness_same_brand_is_sugar: TestClaim = EqualsClaim {
  label: "manual/refinement-is-sugar: brand where-sugar and hand-desugared agree on same-brand call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim1_input(
    ok: claim1_programs_agree(
      refinement_accepts: refinement_accepts_same_brand(),
      desugared_accepts: desugared_accepts_same_brand()
    )
  ),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_refinement_brand_disjointness_raw_literal_is_sugar: TestClaim = EqualsClaim {
  label: "manual/refinement-is-sugar: brand where-sugar and hand-desugared agree on raw-literal call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: claim1_input(
    ok: claim1_programs_agree(
      refinement_accepts: refinement_accepts_raw_literal(),
      desugared_accepts: desugared_accepts_raw_literal()
    )
  ),
  rhs: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


fn claim1_actual_for_agreement(
  refinement_accepts: Bool,
  desugared_accepts: Bool
) -> Outcome<Node> {
  Accepted {
    value: claim1_input(
      ok: claim1_programs_agree(
        refinement_accepts: refinement_accepts,
        desugared_accepts: desugared_accepts
      )
    ),
    diagnostics: None
  }
}


fn claim1_verdict_for_agreement(
  claim: TestClaim,
  refinement_accepts: Bool,
  desugared_accepts: Bool
) -> Verdict<TestClaimEvalSubject<Node>, Node> {
  run_test_claim_assert(
    claim: claim,
    actual: claim1_actual_for_agreement(
      refinement_accepts: refinement_accepts,
      desugared_accepts: desugared_accepts
    ),
    at: stub_empty_conj
  )
}


data verdict_refinement_brand_disjointness_cross_brand_is_sugar: Verdict<TestClaimEvalSubject<Node>, Node> =
  claim1_verdict_for_agreement(
    claim: claim_refinement_brand_disjointness_cross_brand_is_sugar,
    refinement_accepts: refinement_accepts_cross_brand(),
    desugared_accepts: desugared_accepts_cross_brand()
  )


data verdict_refinement_brand_disjointness_same_brand_is_sugar: Verdict<TestClaimEvalSubject<Node>, Node> =
  claim1_verdict_for_agreement(
    claim: claim_refinement_brand_disjointness_same_brand_is_sugar,
    refinement_accepts: refinement_accepts_same_brand(),
    desugared_accepts: desugared_accepts_same_brand()
  )


data verdict_refinement_brand_disjointness_raw_literal_is_sugar: Verdict<TestClaimEvalSubject<Node>, Node> =
  claim1_verdict_for_agreement(
    claim: claim_refinement_brand_disjointness_raw_literal_is_sugar,
    refinement_accepts: refinement_accepts_raw_literal(),
    desugared_accepts: desugared_accepts_raw_literal()
  )
