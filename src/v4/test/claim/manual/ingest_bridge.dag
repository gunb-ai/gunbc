// src/v4/test/claim/manual/ingest_bridge.dag
// Scope: #g-ingest-bridge (#4801) — executable proof of the forward interpreter
//   `parse_tree_to_target_model_bridge` (v4.compiler.ingest). Parses a token through a local
//   grammar whose production emits the add type node, runs the bridge (fold -> infer -> coerce),
//   and asserts the recovered canonical IR matches the add keystone — composing the new syntactic
//   half with the LANDED semantic dual. Hermetic + sub-second (a 1-token local grammar, NOT the
//   ~627s real-language parse fixtures); the python->ts matrix flip lands in the cross-language
//   consumer claim.

module v4.test.claim.manual.ingest_bridge

import v4.std.algebra { Cons, Empty }
import v4.compiler.ingest {
  parse_tree_to_emitted_node,
  parse_tree_to_target_model_bridge
}
import v4.compiler.parse {
  grammar_validate_for_parse,
  parse_production,
  parse_stage_locus_port
}
import v4.std.grammar {
  GrammarProduction,
  GrammarRoot,
  Terminal,
  grammar_empty_sync_tokens
}
import v4.extdeps.languages.dag {
  dag_mvp1_fixture_emitted_add_fn,
  dag_mvp1_fixture_int_inhabitant,
  dag_mvp1_target_model
}
import v4.std.compilers.lexing { Token }
import v4.std.diagnostic { Accepted, None, Outcome, Rejected, port_locus }
import v4.std.logic { Bool }
import v4.std.node {
  Conj,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  UnifiedTestClaim,
  manual_claim_anchor
}

data ingest_fixture_file: Symbol = ^ingest_fixture_file
data ingest_fixture_tok: Symbol = ^ingest_fixture_tok
data ingest_fixture_start: Symbol = ^ingest_fixture_start

fn ingest_fixture_token() -> Token {
  Token {
    class: ingest_fixture_tok,
    lexeme: Empty,
    file: ingest_fixture_file,
    start: 0,
    end: 1
  }
}

// Local single-terminal grammar whose production `emitted` IS the supplied core node — exactly
// what the real dag/python add productions do with `<lang>_mvp1_emitted_add_fn_node()`.
fn ingest_fixture_root(emitted: Node) -> GrammarRoot {
  GrammarRoot {
    start: ingest_fixture_start,
    productions: Cons {
      head: GrammarProduction {
        name: ingest_fixture_start,
        expression: Terminal { token_class: ingest_fixture_tok },
        emitted: emitted
      },
      tail: Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

// Parse one token through the local grammar carrying `emitted`, returning the parse tree.
fn ingest_parse(emitted: Node) -> Outcome<Node> {
  let at = port_locus(port: parse_stage_locus_port)
  match grammar_validate_for_parse(root: ingest_fixture_root(emitted: emitted), at: at) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: validated, diagnostics: _ } =>
      match parse_production(
        tokens: Cons { head: ingest_fixture_token(), tail: Empty },
        validated: validated,
        production_name: ingest_fixture_start
      ) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: artifact, diagnostics: _ } =>
          Accepted { value: artifact.tree, diagnostics: None }
      }
  }
}

// (1) The forward fold recovers the emit-side core node, row-confirmed against the source model.
fn ingest_recovers_emitted_holds() -> Bool {
  match ingest_parse(emitted: dag_mvp1_fixture_emitted_add_fn) {
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_emitted_node(parse_tree: tree, source_model: dag_mvp1_target_model()) {
        Accepted { value: recovered, diagnostics: _ } =>
          recovered == dag_mvp1_fixture_emitted_add_fn
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// (2) End-to-end: parsed token -> bridge (fold -> infer -> coerce) -> canonical add IR.
fn ingest_bridge_to_canonical_holds() -> Bool {
  match ingest_parse(emitted: dag_mvp1_fixture_emitted_add_fn) {
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_target_model_bridge(parse_tree: tree, source_model: dag_mvp1_target_model()) {
        Accepted { value: core, diagnostics: _ } =>
          core == dag_mvp1_fixture_emitted_add_fn
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// (3) Row-driven fail-closed: a parse tree whose emitted is NOT a declared row of source_model
//     (here the int inhabitant, which the add target model does not emit as a top row) is Rejected
//     — the gate reflects the source model's declared rows, not a constant.
fn ingest_fails_closed_off_row_holds() -> Bool {
  match ingest_parse(emitted: dag_mvp1_fixture_int_inhabitant) {
    Accepted { value: tree, diagnostics: _ } =>
      match parse_tree_to_emitted_node(parse_tree: tree, source_model: dag_mvp1_target_model()) {
        Accepted { value: _, diagnostics: _ } => false
        Rejected { diagnostics: _ } => true
      }
    Rejected { diagnostics: _ } => false
  }
}

// (4) Fail-closed: a bare node that is not a stamped production tree is Rejected.
fn ingest_unstamped_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn ingest_fails_closed_on_unstamped_holds() -> Bool {
  match parse_tree_to_emitted_node(parse_tree: ingest_unstamped_node(), source_model: dag_mvp1_target_model()) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

fn ingest_bridge_realized() -> Bool {
  ingest_recovers_emitted_holds()
    && ingest_bridge_to_canonical_holds()
    && ingest_fails_closed_off_row_holds()
    && ingest_fails_closed_on_unstamped_holds()
}

// ─────────────────────────────────────────────────────────────────────────────
// Claim markers.
// ─────────────────────────────────────────────────────────────────────────────

fn ingest_bridge_realized_input(ok: Bool) -> Symbol {
  if ok { ^ingest_bridge_realized } else { ^ingest_bridge_not_realized }
}

data claim_ingest_bridge_module_compiles: TestClaim = CompilesClaim {
  label: "manual/ingest_bridge: forward interpreter bridge claim compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ^ingest_fixture_start,
  expected_value: ^ingest_fixture_start,
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_ingest_bridge_realized: TestClaim = CompilesClaim {
  label: "manual/ingest_bridge: ParseTree -> emit-side core node -> canonical IR by execution (forward interpreter; row-driven, fail-closed)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ingest_bridge_realized_input(ok: ingest_bridge_realized()),
  expected_value: ^ingest_bridge_realized,
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data unified_claim_ingest_bridge_realized: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/manual/ingest_bridge.dag",
    function: ingest_bridge_realized
  }
}
