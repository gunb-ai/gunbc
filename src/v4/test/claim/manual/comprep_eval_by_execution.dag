// src/v4/test/claim/manual/comprep_eval_by_execution.dag
// Scope: COMPREP wave-1 runtime keystone — source-gated add body executes through eval callee dispatch.
// Status: executable --claim-run witness; swapped operand bindings are the discriminating red.

module v4.test.claim.manual.comprep_eval_by_execution

import v4.compiler.body_producer {
  produce_mvp1_add_arrow_with_body
}
import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval,
  inputs_root_only,
  run_test_claim,
  test_claim_run_verdict,
  test_claim_typed_input_node
}
import v4.compiler.infer { InferredFacts, InferredTree, infer }
import v4.compiler.normalize { normalize }
import v4.compiler.parse { parse }
import v4.compiler.resolve { resolve }
import v4.compiler.tokenize { tokenize }
import v4.extdeps.languages.dag {
  dag_language_model_wave1,
  dag_mvp1_source_text
}
import v4.std.collection { List, Map, map_insert }
import v4.std.cardinality { termination_proof_witness_for_node }
import v4.test.claim.lens_common.infer_fixture { claim_inferred_facts_from_nodes }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v4.std.machine { Byte }
import v4.std.node {
  Arrow,
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  arrow_body_edge
}
import v4.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  RuntimePrimitive,
  RuntimePrimitiveValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v4.std.witness { Holds, Witness }
import v4.std.verdict { Pass }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn comprep_eval_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}

fn comprep_eval_byte() -> Byte {
  Byte { bits: [true] }
}

fn comprep_eval_i64_node() -> Node {
  comprep_eval_atom(s: ^comprep_eval_i64)
}

fn comprep_eval_int_value(bytes: List<Byte>) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: comprep_eval_i64_node(),
      bytes: bytes
    }
  }
}

fn comprep_eval_two_value() -> RuntimeValue {
  comprep_eval_int_value(bytes: [comprep_eval_byte(), comprep_eval_byte()])
}

fn comprep_eval_three_value() -> RuntimeValue {
  comprep_eval_int_value(bytes: [comprep_eval_byte(), comprep_eval_byte(), comprep_eval_byte()])
}

fn comprep_eval_five_value() -> RuntimeValue {
  comprep_eval_int_value(bytes: [
    comprep_eval_byte(),
    comprep_eval_byte(),
    comprep_eval_byte(),
    comprep_eval_byte(),
    comprep_eval_byte()
  ])
}

fn comprep_eval_literal_two_node() -> Node {
  comprep_eval_atom(s: ^comprep_eval_literal_two)
}

fn comprep_eval_literal_three_node() -> Node {
  comprep_eval_atom(s: ^comprep_eval_literal_three)
}

fn comprep_eval_literal_five_node() -> Node {
  comprep_eval_atom(s: ^comprep_eval_literal_five)
}

fn comprep_eval_runtime_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: ^comprep_eval_runtime_rejected,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn comprep_eval_allocate_literal(node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  if node == comprep_eval_literal_two_node() {
    outcome_accepted(value: comprep_eval_two_value())
  } else if node == comprep_eval_literal_three_node() {
    outcome_accepted(value: comprep_eval_three_value())
  } else if node == comprep_eval_literal_five_node() {
    outcome_accepted(value: comprep_eval_five_value())
  } else {
    outcome_rejected(d: comprep_eval_runtime_diagnostic(n: node))
  }
}

fn comprep_eval_arg_is_count(value: RuntimeValue, n: Int) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == comprep_eval_i64_node()) && (count(p.bytes) == n)
    _ => false
  }
}

fn comprep_eval_ordered_add_args(args: List<RuntimeValue>) -> Bool {
  if count(args) == 2 {
    match first(args) {
      Some { value: left } =>
        match last(args) {
          Some { value: right } =>
            comprep_eval_arg_is_count(value: left, n: 2)
              && comprep_eval_arg_is_count(value: right, n: 3)
          None => false
        }
      None => false
    }
  } else {
    false
  }
}

fn comprep_eval_call_primitive(
  node: Node,
  args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  if comprep_eval_ordered_add_args(args: args) {
    outcome_accepted(value: comprep_eval_five_value())
  } else {
    outcome_rejected(d: comprep_eval_runtime_diagnostic(n: node))
  }
}

fn comprep_eval_choose_branch(node: Node, _value: RuntimeValue, _env: EvaluationEnvironment) -> Outcome<Node> {
  outcome_rejected(d: comprep_eval_runtime_diagnostic(n: node))
}

fn comprep_eval_step_loop(node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  outcome_rejected(d: comprep_eval_runtime_diagnostic(n: node))
}

fn comprep_eval_bind_value(
  key: EnvironmentBindingKey,
  value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted {
    value: EvaluationEnvironment {
      bindings: map_insert(m: env.bindings, key: key, value: value)
    },
    diagnostics: None
  }
}

fn comprep_eval_interpretation() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: comprep_eval_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: comprep_eval_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: comprep_eval_choose_branch
    },
    loop: LoopInterpreter {
      step_loop: comprep_eval_step_loop
    },
    bind: BindInterpreter {
      bind_value: comprep_eval_bind_value
    }
  }
}

fn comprep_eval_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: ^comprep_eval_allocate_literal_sym,
    call_primitive: ^comprep_eval_call_primitive_sym,
    choose_branch: ^comprep_eval_choose_branch_sym,
    step_loop: ^comprep_eval_step_loop_sym,
    bind_value: ^comprep_eval_bind_value_sym
  }
}

fn comprep_eval_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: ^comprep_eval_runtime_id,
    interpretation: comprep_eval_interpretation(),
    structure_witness: comprep_eval_interpretation_structure_witness()
  )
}

fn comprep_source_ingested_add_infers() -> Outcome<InferredTree> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(text: dag_mvp1_source_text, file: ^comprep_eval_source_file, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: parse(tokens: tokens, grammar: lm.grammar),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              bind_outcome(
                o: resolve(tree: normalized, lm: lm),
                f: fn(resolved) {
                  infer(tree: resolved)
                }
              )
            }
          )
        }
      )
    }
  )
}

fn comprep_eval_add_call(callee: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: callee },
      Edge { label: Positional, target: comprep_eval_literal_two_node() },
      Edge { label: Positional, target: comprep_eval_literal_three_node() }
    ]
  }
}

fn comprep_eval_tree_root(call: Node, expected: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: ^comprep_eval_actual }, target: call },
      Edge { label: Named { name: ^comprep_eval_expected }, target: expected }
    ]
  }
}

fn comprep_eval_facts_lookup(key: Node) -> Witness<InferredFacts> {
  Holds {
    value: claim_inferred_facts_from_nodes(
      resolved: key,
      algebra: comprep_eval_i64_node(),
      descent: termination_proof_witness_for_node(n: key)
    )
  }
}

fn comprep_eval_admitted_tree(root: Node) -> InferredTree {
  InferredTree {
    root: root,
    facts: Map {
      lookup: comprep_eval_facts_lookup
    }
  }
}

fn comprep_eval_inferred_run_tree(callee: Node, expected: Node) -> Outcome<InferredTree> {
  bind_outcome(
    o: comprep_source_ingested_add_infers(),
    f: fn(_source_ingested) {
      let call = comprep_eval_add_call(callee: callee)
      let root = comprep_eval_tree_root(call: call, expected: expected)
      bind_outcome(
        o: infer(tree: root),
        f: fn(_admitted) {
          outcome_accepted(value: comprep_eval_admitted_tree(root: root))
        }
      )
    }
  )
}

fn comprep_eval_claim(input: Node, expected: Node) -> TestClaim {
  CompilesClaim {
    label: "manual/comprep: source-ingested add executes Arrow.body through callee dispatch",
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: input,
    expected_value: expected,
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}

fn comprep_eval_subject(tree: InferredTree, input: Node, expected: Node) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: comprep_eval_claim(input: input, expected: expected),
    context: comprep_eval_context(),
    tree: tree,
    input: test_claim_typed_input_node(
      evaluator_input: input,
      evaluator_pin: ^comprep_eval_add_call_pin
    )
  }
}

fn comprep_eval_run(callee: Node, expected: Node) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  let input = comprep_eval_add_call(callee: callee)
  bind_outcome(
    o: comprep_eval_inferred_run_tree(callee: callee, expected: expected),
    f: fn(tree) {
      outcome_accepted(
        value: run_test_claim(
          subject: comprep_eval_subject(tree: tree, input: input, expected: expected)
        )
      )
    }
  )
}

fn comprep_swapped_operand_body() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: comprep_eval_atom(s: ^dag_token_plus) },
      Edge { label: Positional, target: comprep_eval_atom(s: ^dag_binding_param_y) },
      Edge { label: Positional, target: comprep_eval_atom(s: ^dag_binding_param_x) }
    ]
  }
}

fn comprep_swapped_add_arrow() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: comprep_eval_atom(s: ^dag_binding_type_int) },
      Edge { label: Positional, target: comprep_eval_atom(s: ^dag_binding_type_int) },
      Edge { label: Positional, target: comprep_eval_atom(s: ^dag_binding_type_int) },
      Edge { label: Named { name: arrow_body_edge }, target: comprep_swapped_operand_body() }
    ]
  }
}

fn comprep_eval_run_passes(run: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match run {
    Accepted { value: r, diagnostics: _ } =>
      match test_claim_run_verdict(run: r) {
        Pass => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_eval_source_pipeline_holds() -> Bool {
  match comprep_source_ingested_add_infers() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_eval_canonical_tree_infers_holds() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      match comprep_eval_inferred_run_tree(callee: arrow, expected: comprep_eval_literal_five_node()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_eval_runtime_value_is_five(value: RuntimeValue) -> Bool {
  comprep_eval_arg_is_count(value: value, n: 5)
}

fn comprep_eval_direct_runtime_holds() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } => {
      let input = comprep_eval_add_call(callee: arrow)
      match comprep_eval_inferred_run_tree(callee: arrow, expected: comprep_eval_literal_five_node()) {
        Accepted { value: tree, diagnostics: _ } =>
          match eval(
            tree: tree,
            interpretation: comprep_eval_interpretation(),
            inputs: inputs_root_only(root: input)
          ) {
            Accepted { value: actual, diagnostics: None } =>
              comprep_eval_runtime_value_is_five(value: actual)
            _ => false
          }
        Rejected { diagnostics: _ } => false
      }
    }
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_eval_source_ingested_add_executes_holds() -> Bool {
  match produce_mvp1_add_arrow_with_body() {
    Accepted { value: arrow, diagnostics: _ } =>
      comprep_eval_run_passes(
        run: comprep_eval_run(
          callee: arrow,
          expected: comprep_eval_literal_five_node()
        )
      )
    Rejected { diagnostics: _ } => false
  }
}

fn comprep_eval_swapped_operands_red_holds() -> Bool {
  comprep_eval_run_passes(
    run: comprep_eval_run(
      callee: comprep_swapped_add_arrow(),
      expected: comprep_eval_literal_five_node()
    )
  ) == false
}
