// src/v4/test/claim/lens_determinism/effect_leak_undecorated_callee.dag
// Scope: PR-2 claim — Deterministic caller invoking callee absent from registry -> effect_leak.


module v4.test.claim.lens_determinism.effect_leak_undecorated_callee

import v4.compiler.infer { InferredTree }
import v4.lens.determinism {
  determinism_effect_leak,
  determinism_invoke_edge,
  determinism_witness_from_facts
}
import v4.std.determinism { DeterminismFact, Deterministic }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  ComputationNode,
  Edge,
  Named,
  Node,
  Symbol,
  Transform,
  TypeNode
}
import v4.std.witness { Violates, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data det_leak_caller_symbol: Symbol = det_leak_caller_symbol
data det_leak_callee_symbol: Symbol = det_leak_callee_symbol
data det_leak_type_symbol: Symbol = det_leak_type_symbol
data det_leak_algebra_symbol: Symbol = det_leak_algebra_symbol
data det_leak_descent_symbol: Symbol = det_leak_descent_symbol

data det_leak_callee_target: Node = claim_atom_node(s: det_leak_callee_symbol)

data det_leak_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge {
      label: Named { name: determinism_invoke_edge },
      target: det_leak_callee_target
    }
  ]
}

data det_leak_subject: DeterminismFact = DeterminismFact {
  signature: det_leak_caller_symbol,
  classification: Deterministic
}

fn det_leak_tree() -> InferredTree {
  claim_inferred_tree(
    root: det_leak_body,
    facts: claim_inferred_facts(
      type_symbol: det_leak_type_symbol,
      algebra_symbol: det_leak_algebra_symbol,
      descent_symbol: det_leak_descent_symbol,
    ),
  )
}

type LensDeterminismEffectLeakClaim {
  actual: Witness<DeterminismFact>
}

data det_effect_leak_claim: LensDeterminismEffectLeakClaim = LensDeterminismEffectLeakClaim {
  actual: determinism_witness_from_facts(
    tree: det_leak_tree(),
    facts: [det_leak_subject],
    subject: det_leak_subject,
    body: det_leak_body,
  )
}

fn det_effect_leak_claim_violates() -> Bool {
  match det_effect_leak_claim.actual {
    Violates { diagnostic: d } => d.reason == determinism_effect_leak
    _ => false
  }
}

data det_effect_leak_claim_passes: Bool = det_effect_leak_claim_violates()
