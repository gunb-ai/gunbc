// src/v4/test/claim/generated/refinement_preservation.dag
// Scope: T-19 RefinementPreservation — testgen-emitted claim plus concrete refine/refined_base witness.
// Owns: refinement_preservation_generated_nonempty_list_claim, witness_refinement_preserves_nonempty_list_base.
// Consumes: v4.lens.testgen, v4.std.refinement, v4.std.verification, v4.test.claim.manual.connective_anchors.
// Status: generated corpus — claim is testgen_emit output (not a parallel literal); true codegen dissolves this module.

module v4.test.claim.generated.refinement_preservation


import v4.lens.testgen {
  RefinementPreservationSubject,
  refinement_preservation_list_node,
  refinement_preservation_subject_nonempty_list_base,
  t19_refinement_label_nonempty_list_base,
  testgen_emit_refinement_preservation_claim
}
import v4.std.diagnostic {
  Accepted,
  AmbiguousIntent,
  Diagnostic,
  NodeLocus,
  NonEmptyDiagnostics,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton
}
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.refinement { refined_base }
import v4.std.verification {
  DiagnosticClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  T19ManualRefinementNonEmptyListBase,
  Tier1,
  Unit
}
import v4.test.claim.manual.connective_anchors {
  stub_empty_conj,
  stub_empty_disj
}


data refinement_preservation_emit_rejected: Symbol = refinement_preservation_emit_rejected
data refinement_preservation_rejection_input: Symbol = refinement_preservation_rejection_input
fn refinement_preservation_rejection_input_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: refinement_preservation_rejection_input } },
    children: []
  }
}


fn refinement_preservation_emit_rejection_diagnostic(input: Node) -> Diagnostic {
  Diagnostic {
    reason: refinement_preservation_emit_rejected,
    at: NodeLocus { node: input },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}


fn refinement_preservation_emit_rejection_sentinel_claim(
  expected: NonEmptyDiagnostics
) -> TestClaim {
  let input = refinement_preservation_rejection_input_node()
  DiagnosticClaim {
    label: t19_refinement_label_nonempty_list_base,
    t19_anchor: T19ManualAnchorAbsent,
    input: input,
    expected_rejection: expected,
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}


fn refinement_preservation_claim_from_testgen_emit(
  subject: RefinementPreservationSubject
) -> Outcome<TestClaim> {
  testgen_emit_refinement_preservation_claim(
    anchor: T19ManualRefinementNonEmptyListBase,
    label: t19_refinement_label_nonempty_list_base,
    subject: subject
  )
}


fn refinement_preservation_generated_nonempty_list_claim() -> TestClaim {
  match refinement_preservation_subject_nonempty_list_base() {
    Accepted { value: subject, diagnostics: None } =>
      match refinement_preservation_claim_from_testgen_emit(subject: subject) {
        Accepted { value: claim, diagnostics: None } => claim
        Rejected { diagnostics: _ } =>
          refinement_preservation_emit_rejection_sentinel_claim(
            expected: diagnostics_singleton(
              d: refinement_preservation_emit_rejection_diagnostic(
                input: refinement_preservation_rejection_input_node()
              )
            )
          )
      }
    Rejected { diagnostics: _ } =>
      refinement_preservation_emit_rejection_sentinel_claim(
        expected: diagnostics_singleton(
          d: refinement_preservation_emit_rejection_diagnostic(
            input: refinement_preservation_rejection_input_node()
          )
        )
      )
  }
}


data claim_refinement_nonempty_list_base_preserved: TestClaim = refinement_preservation_generated_nonempty_list_claim()


data witness_refinement_preserves_nonempty_list_base: Bool = match refinement_preservation_subject_nonempty_list_base() {
  Accepted { value: subject, diagnostics: None } => refined_base(r: subject.refined) == subject.original
  Rejected { diagnostics: _ } => false
}


fn refinement_preservation_subject_base_value() -> Node {
  match refinement_preservation_subject_nonempty_list_base() {
    Accepted { value: subject, diagnostics: None } =>
      refinement_preservation_list_node(xs: subject.original)
    Rejected { diagnostics: _ } => refinement_preservation_list_node(xs: [])
  }
}


data witness_refinement_preservation_subject_anchor: Bool =
  refinement_preservation_subject_base_value() == refinement_preservation_list_node(xs: [stub_empty_conj])
