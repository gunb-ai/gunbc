// src/v4/test/claim/generated/witness_validity.dag
// Scope: T-19 witness-validity generator category — testgen-emitted TestClaim rows that
//   discharge "evidence node actually satisfies the property the witness claims it satisfies",
//   using v4.std.find_witness::verify_witness as the independent oracle (a module distinct
//   from the v4.std.witness constructors that build StructuralPropertyWitness values).
// Owns: row_witness_validity_* data rows; witness_validity_unrealized_rule symbol.
// Consumes: v4.lens.testgen v4.std.witness v4.std.find_witness v4.std.verification
//           v4.std.node v4.std.diagnostic v4.test.claim.manual.connective_anchors.
// Status: generated corpus — every row routes through testgen_emit_witness_validity_claim
//   (no TestClaim literal authoring here). The helper emits a RoundTripClaim whose
//   `input` Node encodes the full subject (source_facts/candidate/predicate/witness)
//   plus an `oracle_outcome` sub-tree carrying the emit-time verify_witness verdict
//   (Holds-witness sub-tree on Accepted; Violates-reason atom on Rejected). Verdict
//   is honestly Deferred under today's fail-closed eval_node; rows mechanically
//   discharge once the eval interpretation-algebra for verify_witness lands
//   (lane (b) per PM ruling 2026-05-22, routed to cool-cat-24).

module v4.test.claim.generated.witness_validity


import v4.std.diagnostic { Outcome }
import v4.std.node { Symbol }
import v4.std.witness { StructuralPropertyWitness }
import v4.std.find_witness {
  PreservationPredicate,
  preservation_rule_constraint_satisfaction
}
import v4.std.verification { TestClaim }
import v4.lens.testgen { testgen_emit_witness_validity_claim }
import v4.test.claim.manual.connective_anchors { stub_empty_conj, stub_empty_disj }


// Symbol used to drive verify_witness into branches where the rule is not one of the
// two realized preservation_rule_* arms in v4.std.find_witness — i.e. a name distinct
// from preservation_rule_constraint_satisfaction and preservation_rule_exact_structural_equality_zip_fold.
data witness_validity_unrealized_rule: Symbol = witness_validity_unrealized_rule


// Positive row: source_facts == candidate == algebra (well-formed empty Conj);
// witness names the realized constraint-satisfaction rule and evidence == candidate.
// verify_witness → Accepted → helper emits RoundTripClaim whose subject carries the
// Holds sub-tree wrapping the witness Node under oracle_outcome.
data row_witness_validity_constraint_satisfaction_holds: Outcome<TestClaim> = testgen_emit_witness_validity_claim(
    label: "witness-validity: constraint-satisfaction holds (positive)",
    source_facts: stub_empty_conj,
    candidate: stub_empty_conj,
    predicate: PreservationPredicate {
      algebra: stub_empty_conj,
      preservation_rule: preservation_rule_constraint_satisfaction,
    },
    witness: StructuralPropertyWitness {
      property: preservation_rule_constraint_satisfaction,
      evidence: stub_empty_conj,
    }
  )


// Negative row: witness.property does not match predicate.preservation_rule.
// verify_witness → Rejected(find_witness_invalid_witness) → helper emits RoundTripClaim
// whose subject carries the Violates sub-tree wrapping the diagnostic-reason atom under
// oracle_outcome.
data row_witness_validity_property_symbol_mismatch: Outcome<TestClaim> = testgen_emit_witness_validity_claim(
    label: "witness-validity: property symbol mismatch (invalid witness)",
    source_facts: stub_empty_conj,
    candidate: stub_empty_conj,
    predicate: PreservationPredicate {
      algebra: stub_empty_conj,
      preservation_rule: preservation_rule_constraint_satisfaction,
    },
    witness: StructuralPropertyWitness {
      property: witness_validity_unrealized_rule,
      evidence: stub_empty_conj,
    }
  )


// Negative row: witness.evidence is not the candidate it claims to certify.
// verify_witness → Rejected(find_witness_invalid_witness) → helper emits RoundTripClaim
// whose subject carries the Violates sub-tree wrapping the diagnostic-reason atom under
// oracle_outcome.
data row_witness_validity_evidence_node_mismatch: Outcome<TestClaim> = testgen_emit_witness_validity_claim(
    label: "witness-validity: evidence node mismatch (invalid witness)",
    source_facts: stub_empty_conj,
    candidate: stub_empty_conj,
    predicate: PreservationPredicate {
      algebra: stub_empty_conj,
      preservation_rule: preservation_rule_constraint_satisfaction,
    },
    witness: StructuralPropertyWitness {
      property: preservation_rule_constraint_satisfaction,
      evidence: stub_empty_disj,
    }
  )


// Negative row: predicate.preservation_rule is neither of the realized arms.
// verify_witness rejects at the entry match with find_witness_not_realized → helper emits
// RoundTripClaim whose subject carries the Violates sub-tree wrapping the diagnostic-reason
// atom under oracle_outcome.
data row_witness_validity_rule_not_realized: Outcome<TestClaim> = testgen_emit_witness_validity_claim(
    label: "witness-validity: preservation rule not realized",
    source_facts: stub_empty_conj,
    candidate: stub_empty_conj,
    predicate: PreservationPredicate {
      algebra: stub_empty_conj,
      preservation_rule: witness_validity_unrealized_rule,
    },
    witness: StructuralPropertyWitness {
      property: witness_validity_unrealized_rule,
      evidence: stub_empty_conj,
    }
  )
