  T19ManualAnchorKey,
  T19ManualLbeConjDagSurface,
  T19ManualLbeDisjDagSurface,
  T19ManualLbeTransformDagSurface
}


data manual_anchor_lbe_conj_dag_surface: T19ManualAnchorKey = T19ManualLbeConjDagSurface


data manual_anchor_lbe_disj_dag_surface: T19ManualAnchorKey = T19ManualLbeDisjDagSurface


data manual_anchor_lbe_transform_dag_surface: T19ManualAnchorKey = T19ManualLbeTransformDagSurface
