// src/v4/test/claim/generated/language_behavior_equivalence.dag
// Scope: T-19 LanguageBehaviorEquivalence — testgen-emitted claims with I/O mock + frozen snapshot runner receipts.
// Owns: three LBE TestClaim families (Conj / Disj / Transform × dag surface), TestClaimRun rows, pass gates.
// Consumes: v4.compiler.eval, v4.compiler.infer, v4.lens.testgen, v4.std.verification, v4.test.claim.manual.connective_anchors.
// Status: generated corpus — bijection with testgen_scheduled_language_behavior_generators / testgen_emit_language_behavior_equivalence_claim.

module v4.test.claim.generated.language_behavior_equivalence


import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  TestClaimTypedInput,
  Verdict,
  Deferred,
  Fail,
  Pass,
  eval_diagnostic,
  run_test_claim,
  run_test_claim_assert,
  test_claim_cache_receipt
}
import v4.compiler.infer {
  AlgebraRef,
  InferredFacts,
  InferredTree
}
import v4.std.algebra { length }
import v4.std.collection { Map }
import v4.std.diagnostic {
  Accepted,
  None,
  Outcome,
  diagnostics_singleton
}
import v4.std.node { Atom, Hash, Node, Symbol, TypeNode }
import v4.std.constraints {
  CanonicalGroundingWitness,
  constraint_property_being_canonical,
  constraint_property_candidate_set_closedness
}
import v4.std.witness { Holds, StructuralPropertyWitness, Violates }
import v4.extdeps.languages.dag { dag_language_model_surface_id }
import v4.lens.testgen {
  LanguageBehaviorIoMock,
  lbe_io_mock_conj_dag_surface,
  lbe_io_mock_disj_dag_surface,
  lbe_io_mock_transform_dag_surface,
  testgen_scheduled_language_behavior_generators
}
import v4.std.verification {
  CompilesClaim,
  TestClaim,
  TestClassification,
  T19ManualLbeConjDagSurface,
  T19ManualLbeDisjDagSurface,
  T19ManualLbeTransformDagSurface,
  Tier1,
  Unit,
  test_claim_input
}
import v4.test.claim.manual.connective_anchors {
  stub_empty_conj,
  stub_empty_disj,
  stub_empty_transform
}


data claim_hash_placeholder: Hash = claim_hash_placeholder
data evaluator_hash_placeholder: Hash = evaluator_hash_placeholder
data resources_hash_placeholder: Hash = resources_hash_placeholder
data extdeps_hash_placeholder: Hash = extdeps_hash_placeholder
data lbe_evaluator: Symbol = lbe_evaluator
data lbe_resources: Symbol = lbe_resources
data lbe_extdeps: Symbol = lbe_extdeps
data eval_rejected_lbe_projection_deferred: Symbol = eval_rejected_lbe_projection_deferred


fn lbe_symbol_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


fn lbe_inferred_facts(resolved: Node) -> InferredFacts {
  InferredFacts {
    resolved_type: resolved,
    inhabits: AlgebraRef { algebra: resolved, witness: resolved },
    descent: Violates {
      diagnostic: eval_diagnostic(reason: eval_rejected_lbe_projection_deferred, node: resolved)
    },
    canonical: CanonicalGroundingWitness {
      structural: StructuralPropertyWitness {
        property: constraint_property_being_canonical,
        evidence: resolved
      },
      closedness: StructuralPropertyWitness {
        property: constraint_property_candidate_set_closedness,
        evidence: resolved
      }
    }
  }
}


fn lbe_inferred_tree(root: Node) -> InferredTree {
  let facts = lbe_inferred_facts(resolved: root)
  InferredTree {
    root: root,
    facts: Map {
      lookup: fn(_) {
        Holds { value: facts }
      }
    }
  }
}


fn lbe_eval_context() -> EvalContext {
  EvalContext {
    evaluator: lbe_symbol_node(s: lbe_evaluator),
    resources: lbe_symbol_node(s: lbe_resources),
    extdeps: lbe_symbol_node(s: lbe_extdeps)
  }
}


fn lbe_mock_actual(mock: LanguageBehaviorIoMock) -> Outcome<Node> {
  Accepted {
    value: mock.snapshot.expected_value,
    diagnostics: None
  }
}


fn lbe_run_test_claim_assert_from_mock(
  claim: TestClaim,
  mock: LanguageBehaviorIoMock
) -> Verdict<Node> {
  run_test_claim_assert(
    claim: claim,
    actual: lbe_mock_actual(mock: mock),
    at: mock.snapshot.input_node
  )
}


data generated_lbe_conj_claim: TestClaim = CompilesClaim {
  label: "generated/lbe: Conj type-node matches dag LanguageModel surface (frozen snapshot)",
  t19_anchor: T19ManualLbeConjDagSurface,
  input: stub_empty_conj,
  expected_value: stub_empty_conj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data generated_lbe_disj_claim: TestClaim = CompilesClaim {
  label: "generated/lbe: Disj type-node matches dag LanguageModel surface (frozen snapshot)",
  t19_anchor: T19ManualLbeDisjDagSurface,
  input: stub_empty_disj,
  expected_value: stub_empty_disj,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data generated_lbe_transform_claim: TestClaim = CompilesClaim {
  label: "generated/lbe: Transform computation-node matches dag LanguageModel surface (frozen snapshot)",
  t19_anchor: T19ManualLbeTransformDagSurface,
  input: stub_empty_transform,
  expected_value: stub_empty_transform,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data witness_lbe_conj_snapshot_pass: Bool = match lbe_run_test_claim_assert_from_mock(
  claim: generated_lbe_conj_claim,
  mock: lbe_io_mock_conj_dag_surface()
) {
  Pass => true
  Fail { actual: _ } => false
  Deferred { actual: _, diagnostic: _ } => false
}


data witness_lbe_disj_snapshot_pass: Bool = match lbe_run_test_claim_assert_from_mock(
  claim: generated_lbe_disj_claim,
  mock: lbe_io_mock_disj_dag_surface()
) {
  Pass => true
  Fail { actual: _ } => false
  Deferred { actual: _, diagnostic: _ } => false
}


data witness_lbe_transform_snapshot_pass: Bool = match lbe_run_test_claim_assert_from_mock(
  claim: generated_lbe_transform_claim,
  mock: lbe_io_mock_transform_dag_surface()
) {
  Pass => true
  Fail { actual: _ } => false
  Deferred { actual: _, diagnostic: _ } => false
}


fn lbe_subject_from_claim(claim: TestClaim) -> TestClaimEvalSubject<Node> {
  let input = test_claim_input(c: claim)
  TestClaimEvalSubject {
    claim: claim,
    context: lbe_eval_context(),
    tree: lbe_inferred_tree(root: input),
    input: TestClaimTypedInput { evaluator_input: input }
  }
}


data run_lbe_conj_via_run_test_claim: TestClaimRun<Node> = run_test_claim(
  subject: lbe_subject_from_claim(claim: generated_lbe_conj_claim),
  claim_hash: claim_hash_placeholder,
  evaluator_hash: evaluator_hash_placeholder,
  resources_hash: resources_hash_placeholder,
  extdeps_hash: extdeps_hash_placeholder
)


data gate_lbe_conj_run_test_claim_pass: Verdict<TestClaimRun<Node>> = match run_lbe_conj_via_run_test_claim.verdict {
  Pass => Pass
  Fail { actual: _ } => Fail { actual: run_lbe_conj_via_run_test_claim.verdict }
  Deferred { actual: _, diagnostic: _ } => Deferred {
    actual: run_lbe_conj_via_run_test_claim.verdict,
    diagnostic: eval_diagnostic(reason: eval_rejected_lbe_projection_deferred, node: stub_empty_conj)
  }
}


data witness_testgen_schedules_three_lbe_generators: Bool =
  (length(xs: testgen_scheduled_language_behavior_generators()) == 3)


data witness_dag_surface_language_identity: Bool =
  (dag_language_model_surface_id == dag_language_model_surface_id)
