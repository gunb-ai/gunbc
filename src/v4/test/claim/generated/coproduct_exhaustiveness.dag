// src/v4/test/claim/generated/coproduct_exhaustiveness.dag
// Scope: T-19 DiagnosticExhaustiveness — coproduct-exhaustiveness TestClaim emitted from testgen.
// Owns: generated_coproduct_exhaustiveness_claim, scheduling witness.
// Consumes: v4.lens.testgen, v4.std.verification.
// Status: generated corpus scaffold — dissolves when T-19 codegen emits this module from `testgen_scheduled_coproduct_exhaustiveness_generators()` and the generated-output receipt replaces this checked-in witness file.

module v4.test.claim.generated.coproduct_exhaustiveness


import v4.lens.testgen {
  DiagnosticExhaustivenessSubject,
  coproduct_exhaustiveness_subject_testclaim_compiles,
  coproduct_exhaustiveness_subject_testclaim_diagnostic,
  coproduct_exhaustiveness_subject_testclaim_equals,
  coproduct_exhaustiveness_subject_testclaim_roundtrip,
  testgen_emit_coproduct_exhaustiveness_claim,
  testgen_scheduled_coproduct_exhaustiveness_generators
}
import v4.std.algebra { length }
import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Node }
import v4.std.verification {
  DiagnosticClaim,
  TestClaim,
  T19GeneratedClaimAnchor,
  T19GeneratedAnchorKey,
  T19GeneratedCoproductExhaustiveness,
  t19_generated_claim_anchor,
  test_claim_input,
  test_claim_t19_anchor
}


fn generated_coproduct_exhaustiveness_claim() -> Outcome<TestClaim> {
  testgen_emit_coproduct_exhaustiveness_claim(
    subject: coproduct_exhaustiveness_subject_testclaim_diagnostic()
  )
}


fn generated_coproduct_exhaustiveness_input() -> Outcome<Node> {
  match generated_coproduct_exhaustiveness_claim() {
    Accepted { value: claim, diagnostics: _ } =>
      Accepted { value: test_claim_input(c: claim), diagnostics: None }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}


fn witness_coproduct_exhaustiveness_claim_is_diagnostic() -> Bool {
  match generated_coproduct_exhaustiveness_claim() {
    Accepted { value: DiagnosticClaim { label: _, t19_anchor: T19GeneratedClaimAnchor { generated_anchor: T19GeneratedCoproductExhaustiveness { omitted_variant: _ } }, input: _, expected_rejection: _, classification: _ }, diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}


fn witness_coproduct_exhaustiveness_generated_anchor() -> Bool {
  match generated_coproduct_exhaustiveness_claim() {
    Accepted { value: claim, diagnostics: _ } =>
      match test_claim_t19_anchor(c: claim) {
        T19GeneratedClaimAnchor { generated_anchor: T19GeneratedCoproductExhaustiveness { omitted_variant: _ } } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}


fn witness_coproduct_exhaustiveness_all_testclaim_variants_emit() -> Bool {
  witness_coproduct_exhaustiveness_variant_emits(
    subject: coproduct_exhaustiveness_subject_testclaim_compiles()
  ) &&
    witness_coproduct_exhaustiveness_variant_emits(
      subject: coproduct_exhaustiveness_subject_testclaim_diagnostic()
    ) &&
    witness_coproduct_exhaustiveness_variant_emits(
      subject: coproduct_exhaustiveness_subject_testclaim_equals()
    ) &&
    witness_coproduct_exhaustiveness_variant_emits(
      subject: coproduct_exhaustiveness_subject_testclaim_roundtrip()
    )
}


fn witness_coproduct_exhaustiveness_variant_emits(subject: DiagnosticExhaustivenessSubject) -> Bool {
  match testgen_emit_coproduct_exhaustiveness_claim(subject: subject) {
    Accepted { value: DiagnosticClaim { label: _, t19_anchor: T19GeneratedClaimAnchor { generated_anchor: T19GeneratedCoproductExhaustiveness { omitted_variant: _ } }, input: _, expected_rejection: _, classification: _ }, diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}


fn witness_testgen_schedules_all_coproduct_exhaustiveness_generators() -> Bool {
  length(xs: testgen_scheduled_coproduct_exhaustiveness_generators()) == 4
}


data witness_coproduct_exhaustiveness_diagnostic_claim: Bool = witness_coproduct_exhaustiveness_claim_is_diagnostic()


data witness_coproduct_exhaustiveness_uses_generated_anchor: Bool = witness_coproduct_exhaustiveness_generated_anchor()


data witness_coproduct_exhaustiveness_all_variants_emit: Bool = witness_coproduct_exhaustiveness_all_testclaim_variants_emit()


data witness_coproduct_exhaustiveness_generator_count: Bool = witness_testgen_schedules_all_coproduct_exhaustiveness_generators()
