module v4.test.claim.generated.coproduct_exhaustiveness


import v4.lens.testgen {
  coproduct_exhaustiveness_subject_testclaim_compiles,
  coproduct_exhaustiveness_subject_testclaim_diagnostic,
  coproduct_exhaustiveness_subject_testclaim_equals,
  coproduct_exhaustiveness_subject_testclaim_roundtrip,
  testgen_emit_coproduct_exhaustiveness_claim,
  testgen_scheduled_coproduct_exhaustiveness_generators
}
import v4.std.algebra { length }
import v4.std.diagnostic { Accepted, None, Outcome, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Node }
import v4.std.verification {
  DiagnosticClaim,
  TestClaim,
  GeneratedClaimAnchor,
  GeneratedAnchorKey,
  GeneratedCoproductExhaustiveness,
  TestClaimCompilesClaimVariant,
  TestClaimDiagnosticClaimVariant,
  TestClaimEqualsClaimVariant,
  TestClaimStructuralEqualsClaimVariant,
  TestClaimRoundTripClaimVariant,
  generated_claim_anchor,
  test_claim_input,
  test_claim_anchor
}


fn generated_coproduct_exhaustiveness_claim() -> Outcome<TestClaim> {
  testgen_emit_coproduct_exhaustiveness_claim(
    anchor: coproduct_exhaustiveness_subject_testclaim_diagnostic()
  )
}


fn generated_coproduct_exhaustiveness_input() -> Outcome<Node> {
  match generated_coproduct_exhaustiveness_claim() {
    Accepted { value: claim, diagnostics: _ } =>
      Accepted { value: test_claim_input(c: claim), diagnostics: None }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: t19-coproduct-exhaustiveness-codegen — bound task: src/v4/TASKS.md#t-19-lenstestgendag--producer-of-testclaim-corpus-from-substrate — dissolve-on-arrival: generated corpus replaces this hand-rolled DiagnosticClaim arm check with canonical TestClaim variant reflection; forbidden: permanent hand-enumerated TestClaim arm discriminant in generated corpus.
fn witness_coproduct_exhaustiveness_claim_is_diagnostic() -> Bool {
  match generated_coproduct_exhaustiveness_claim() {
    Accepted { value: DiagnosticClaim { label: _, anchor: GeneratedClaimAnchor { generated_anchor: GeneratedCoproductExhaustiveness { omitted_variant: _ } }, input: _, expected_rejection: _, classification: _ }, diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: t19-coproduct-exhaustiveness-codegen — bound task: src/v4/TASKS.md#t-19-lenstestgendag--producer-of-testclaim-corpus-from-substrate — dissolve-on-arrival: generated corpus replaces this hand-matched GeneratedClaimAnchor arm check with canonical anchor-type projection; forbidden: permanent hand-rolled anchor-variant discriminant in generated corpus.
fn witness_coproduct_exhaustiveness_generated_anchor() -> Bool {
  match generated_coproduct_exhaustiveness_claim() {
    Accepted { value: claim, diagnostics: _ } =>
      match test_claim_anchor(c: claim) {
        GeneratedClaimAnchor { generated_anchor: GeneratedCoproductExhaustiveness { omitted_variant: _ } } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}


fn witness_coproduct_exhaustiveness_all_testclaim_variants_emit() -> Bool {
  witness_coproduct_exhaustiveness_variant_emits(
    anchor: coproduct_exhaustiveness_subject_testclaim_compiles()
  ) &&
    witness_coproduct_exhaustiveness_variant_emits(
      anchor: coproduct_exhaustiveness_subject_testclaim_diagnostic()
    ) &&
    witness_coproduct_exhaustiveness_variant_emits(
      anchor: coproduct_exhaustiveness_subject_testclaim_equals()
    ) &&
    witness_coproduct_exhaustiveness_variant_emits(
      anchor: coproduct_exhaustiveness_subject_testclaim_roundtrip()
    )
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: t19-coproduct-exhaustiveness-codegen — bound task: src/v4/TASKS.md#t-19-lenstestgendag--producer-of-testclaim-corpus-from-substrate — dissolve-on-arrival: generated corpus replaces this four-arm hand-enumerated TestClaimCoproductVariant equality check with canonical variant-key reflection; forbidden: permanent hand-rolled arm-identity match over TestClaimCoproductVariant in generated corpus.
fn witness_coproduct_exhaustiveness_variant_emits(anchor: GeneratedAnchorKey) -> Bool {
  match testgen_emit_coproduct_exhaustiveness_claim(anchor: anchor) {
    Accepted { value: DiagnosticClaim { label: _, anchor: GeneratedClaimAnchor { generated_anchor: GeneratedCoproductExhaustiveness { omitted_variant } }, input: _, expected_rejection: _, classification: _ }, diagnostics: _ } =>
      match anchor {
        GeneratedCoproductExhaustiveness { omitted_variant: requested_variant } =>
          match requested_variant {
            TestClaimCompilesClaimVariant =>
              match omitted_variant {
                TestClaimCompilesClaimVariant => true
                _ => false
              }
            TestClaimDiagnosticClaimVariant =>
              match omitted_variant {
                TestClaimDiagnosticClaimVariant => true
                _ => false
              }
            TestClaimEqualsClaimVariant =>
              match omitted_variant {
                TestClaimEqualsClaimVariant => true
                _ => false
              }
            TestClaimStructuralEqualsClaimVariant =>
              match omitted_variant {
                TestClaimStructuralEqualsClaimVariant => true
                _ => false
              }
            TestClaimRoundTripClaimVariant =>
              match omitted_variant {
                TestClaimRoundTripClaimVariant => true
                _ => false
              }
          }
      }
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => false
  }
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: t19-coproduct-exhaustiveness-codegen — bound task: src/v4/TASKS.md#t-19-lenstestgendag--producer-of-testclaim-corpus-from-substrate — dissolve-on-arrival: replace count+emit conjunction with structural variant-set membership check over scheduled generators once M2 fold reflection is available; forbidden: permanent count-only scheduling proof in generated corpus.
fn witness_testgen_schedules_all_coproduct_exhaustiveness_generators() -> Bool {
  length(xs: testgen_scheduled_coproduct_exhaustiveness_generators()) == 4 &&
    witness_coproduct_exhaustiveness_all_testclaim_variants_emit()
}


data witness_coproduct_exhaustiveness_diagnostic_claim: Bool = witness_coproduct_exhaustiveness_claim_is_diagnostic()


data witness_coproduct_exhaustiveness_uses_generated_anchor: Bool = witness_coproduct_exhaustiveness_generated_anchor()


data witness_coproduct_exhaustiveness_all_variants_emit: Bool = witness_coproduct_exhaustiveness_all_testclaim_variants_emit()


data witness_coproduct_exhaustiveness_generator_count: Bool = witness_testgen_schedules_all_coproduct_exhaustiveness_generators()
