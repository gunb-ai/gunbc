// src/v4/test/claim/generated/algebra_law_conformance.dag
// Scope: T-19 generated algebra-law TestClaim rows from Nat algebra subjects.
// Owns: algebra-law generated sample rows via testgen_emit_algebra_law_claim.
// Consumes: v4.lens.testgen, v4.std.nat, v4.std.verification, v4.test.claim.algebra_laws.nat_semiring.
// Status: generated corpus — first non-LBE generator slice; execution deferred to T-22 runner bridge.

module v4.test.claim.generated.algebra_law_conformance


import v4.lens.testgen {
  testgen_emit_algebra_law_claim
}
import v4.std.algebra { length }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.verification {
  TestClaim,
  TestClassification,
  T19ManualNatAddAssociativity,
  T19ManualNatAddLeftIdentity,
  T19ManualNatMulAnnihilator,
  Tier1,
  Unit
}
import v4.std.diagnostic { Outcome }


data algebra_law_generated_operation_field: Symbol = algebra_law_generated_operation_field
data algebra_law_generated_left_field: Symbol = algebra_law_generated_left_field
data algebra_law_generated_right_field: Symbol = algebra_law_generated_right_field
data t19_generated_nat_add_op: Symbol = t19_generated_nat_add_op
data t19_generated_nat_mul_op: Symbol = t19_generated_nat_mul_op
data t19_generated_nat_zero_value: Symbol = t19_generated_nat_zero_value
data t19_generated_nat_one_value: Symbol = t19_generated_nat_one_value
data t19_generated_nat_two_value: Symbol = t19_generated_nat_two_value
data t19_generated_nat_three_value: Symbol = t19_generated_nat_three_value


fn algebra_law_generated_atom(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [] }
}


fn algebra_law_generated_value(value: Symbol) -> Node {
  algebra_law_generated_atom(s: value)
}


fn algebra_law_generated_binary(operation: Symbol, left: Node, right: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: algebra_law_generated_operation_field }, target: algebra_law_generated_atom(s: operation) },
      Edge { label: Named { name: algebra_law_generated_left_field }, target: left },
      Edge { label: Named { name: algebra_law_generated_right_field }, target: right },
    ]
  }
}


fn t19_generated_nat_zero() -> Node {
  algebra_law_generated_value(value: t19_generated_nat_zero_value)
}


fn t19_generated_nat_one() -> Node {
  algebra_law_generated_value(value: t19_generated_nat_one_value)
}


fn t19_generated_nat_two() -> Node {
  algebra_law_generated_value(value: t19_generated_nat_two_value)
}


fn t19_generated_nat_three() -> Node {
  algebra_law_generated_value(value: t19_generated_nat_three_value)
}


fn t19_generated_nat_add(left: Node, right: Node) -> Node {
  algebra_law_generated_binary(operation: t19_generated_nat_add_op, left: left, right: right)
}


fn t19_generated_nat_mul(left: Node, right: Node) -> Node {
  algebra_law_generated_binary(operation: t19_generated_nat_mul_op, left: left, right: right)
}


data generated_nat_add_left_identity_claim: Outcome<TestClaim> = testgen_emit_algebra_law_claim(
  anchor: T19ManualNatAddLeftIdentity,
  label: "generated/algebra_law: Nat addition left identity",
  lhs: t19_generated_nat_add(left: t19_generated_nat_zero(), right: t19_generated_nat_one()),
  rhs: t19_generated_nat_one(),
  classification: TestClassification { tier: Tier1, layer: Unit }
)


data generated_nat_add_associativity_claim: Outcome<TestClaim> = testgen_emit_algebra_law_claim(
  anchor: T19ManualNatAddAssociativity,
  label: "generated/algebra_law: Nat addition associativity",
  lhs: t19_generated_nat_add(
    left: t19_generated_nat_add(left: t19_generated_nat_one(), right: t19_generated_nat_two()),
    right: t19_generated_nat_three()
  ),
  rhs: t19_generated_nat_add(
    left: t19_generated_nat_one(),
    right: t19_generated_nat_add(left: t19_generated_nat_two(), right: t19_generated_nat_three())
  ),
  classification: TestClassification { tier: Tier1, layer: Unit }
)


data generated_nat_mul_annihilator_claim: Outcome<TestClaim> = testgen_emit_algebra_law_claim(
  anchor: T19ManualNatMulAnnihilator,
  label: "generated/algebra_law: Nat multiplication annihilator",
  lhs: t19_generated_nat_mul(left: t19_generated_nat_zero(), right: t19_generated_nat_three()),
  rhs: t19_generated_nat_zero(),
  classification: TestClassification { tier: Tier1, layer: Unit }
)


fn generated_algebra_law_claim_rows() -> List<Outcome<TestClaim>> {
  [
    generated_nat_add_left_identity_claim,
    generated_nat_add_associativity_claim,
    generated_nat_mul_annihilator_claim,
  ]
}


fn generated_algebra_law_sample_count_is_three() -> Bool {
  length(xs: generated_algebra_law_claim_rows()) == 3
}
