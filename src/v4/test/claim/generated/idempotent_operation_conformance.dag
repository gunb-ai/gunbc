// src/v4/test/claim/generated/idempotent_operation_conformance.dag
// Scope: T-19 idempotent-operation generator — f(f(x)) == f(x) rows with double-application witness.
// Status: generated corpus — rows are wired through the T-22 run_test_claim surface.

module v4.test.claim.generated.idempotent_operation_conformance


import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  eval_context_with_semantics,
  eval_test_claim_subject,
  run_test_claim
}
import v4.compiler.infer {
  InferredFacts,
  InferredTree
}
import v4.lens.testgen {
  testgen_emit_idempotent_operation_claim,
  testgen_scheduled_idempotent_operation_subjects,
  idempotent_label_delete,
  idempotent_label_read,
  idempotent_label_upsert,
  idempotent_operation_tautology_skip
}
import v4.std.algebra { length }
import v4.std.cardinality { RankingDimension, TerminationProof }
import v4.std.collection { List, Map }
import v4.std.diagnostic {
  Accepted,
  None,
  Outcome,
  Rejected
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.runtime {
  BindInterpreter,
  BranchInterpreter,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationEnvironment,
  InterpretationAlgebra,
  InterpretationStructureWitness,
  LoopInterpreter,
  RuntimePrimitiveValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter
}
import v4.std.verdict { Pass, Deferred, Fail }
import v4.std.verification {
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  test_claim_input
}
import v4.std.witness { Holds }
import v4.std.effects {
  sample_delete_subject,
  sample_label_only_subject,
  sample_read_subject,
  sample_upsert_subject,
  sample_state
}
import v4.test.claim.lens_common.infer_fixture { claim_inferred_facts_from_nodes }


data idempotent_operation_eval_runtime: Symbol = idempotent_operation_eval_runtime
data idempotent_operation_eval_value: Symbol = idempotent_operation_eval_value
data idempotent_operation_eval_allocate_literal: Symbol = idempotent_operation_eval_allocate_literal
data idempotent_operation_eval_call_primitive: Symbol = idempotent_operation_eval_call_primitive
data idempotent_operation_eval_choose_branch: Symbol = idempotent_operation_eval_choose_branch
data idempotent_operation_eval_step_loop: Symbol = idempotent_operation_eval_step_loop
data idempotent_operation_eval_bind_value: Symbol = idempotent_operation_eval_bind_value
data idempotent_operation_evaluator_pin: Symbol = idempotent_operation_evaluator_pin
data idempotent_operation_descent_dimension: Symbol = idempotent_operation_descent_dimension


fn idempotent_operation_symbol_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


fn idempotent_operation_runtime_value() -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: idempotent_operation_symbol_node(s: idempotent_operation_eval_value),
      bytes: []
    }
  }
}


fn idempotent_operation_allocate_literal(_node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Accepted { value: idempotent_operation_runtime_value(), diagnostics: None }
}


fn idempotent_operation_call_primitive(_node: Node, _args: List<RuntimeValue>, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Accepted { value: idempotent_operation_runtime_value(), diagnostics: None }
}


fn idempotent_operation_choose_branch(node: Node, _value: RuntimeValue, _env: EvaluationEnvironment) -> Outcome<Node> {
  Accepted { value: node, diagnostics: None }
}


fn idempotent_operation_step_loop(_node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  Accepted {
    value: Continue { value: idempotent_operation_runtime_value() },
    diagnostics: None
  }
}


fn idempotent_operation_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}


fn idempotent_operation_interpretation_structure_witness() -> InterpretationStructureWitness {
  InterpretationStructureWitness {
    allocate_literal: idempotent_operation_eval_allocate_literal,
    call_primitive: idempotent_operation_eval_call_primitive,
    choose_branch: idempotent_operation_eval_choose_branch,
    step_loop: idempotent_operation_eval_step_loop,
    bind_value: idempotent_operation_eval_bind_value
  }
}


fn idempotent_operation_eval_context() -> EvalContext {
  eval_context_with_semantics(
    runtime_identity: idempotent_operation_eval_runtime,
    interpretation: InterpretationAlgebra {
      value: ValueInterpreter {
        allocate_literal: idempotent_operation_allocate_literal
      },
      transform: TransformInterpreter {
        call_primitive: idempotent_operation_call_primitive
      },
      branch: BranchInterpreter {
        choose_branch: idempotent_operation_choose_branch
      },
      loop: LoopInterpreter {
        step_loop: idempotent_operation_step_loop
      },
      bind: BindInterpreter {
        bind_value: idempotent_operation_bind_value
      }
    },
    structure_witness: idempotent_operation_interpretation_structure_witness()
  )
}


fn idempotent_operation_inferred_facts(root: Node) -> InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: root,
    algebra: root,
    descent: Holds {
      value: TerminationProof {
        non_increasing: [],
        strict: RankingDimension { measured: idempotent_operation_descent_dimension }
      }
    }
  )
}


fn idempotent_operation_inferred_tree(root: Node) -> InferredTree {
  let facts = idempotent_operation_inferred_facts(root: root)
  InferredTree {
    root: root,
    facts: Map {
      lookup: fn(_) {
        Holds { value: facts }
      }
    }
  }
}


fn idempotent_operation_subject_from_claim(claim: TestClaim) -> TestClaimEvalSubject<Node> {
  let input = test_claim_input(c: claim)
  eval_test_claim_subject(
    claim: claim,
    context: idempotent_operation_eval_context(),
    tree: idempotent_operation_inferred_tree(root: input),
    evaluator_pin: idempotent_operation_evaluator_pin
  )
}


fn idempotent_operation_run_via_test_claim(claim: TestClaim) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim(subject: idempotent_operation_subject_from_claim(claim: claim))
}


fn idempotent_operation_generated_run(row: Outcome<TestClaim>) -> Outcome<TestClaimRun<Node, RuntimeValue>> {
  match row {
    Accepted { value: claim, diagnostics: None } =>
      Accepted {
        value: idempotent_operation_run_via_test_claim(claim: claim),
        diagnostics: None
      }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}


fn idempotent_operation_run_passed(row: Outcome<TestClaimRun<Node, RuntimeValue>>) -> Bool {
  match row {
    Accepted { value: run, diagnostics: None } =>
      match run.verdict {
        Pass => true
        Fail { actual: _, falsification: _ } => false
        Deferred { actual: _, diagnostic: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


data generated_read_idempotent_operation_claim: Outcome<TestClaim> = testgen_emit_idempotent_operation_claim(
  label: idempotent_label_read,
  subject: sample_read_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
)


data generated_upsert_idempotent_operation_claim: Outcome<TestClaim> = testgen_emit_idempotent_operation_claim(
  label: idempotent_label_upsert,
  subject: sample_upsert_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
)


data generated_delete_idempotent_operation_claim: Outcome<TestClaim> = testgen_emit_idempotent_operation_claim(
  label: idempotent_label_delete,
  subject: sample_delete_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
)


data generated_label_only_idempotent_skip: Outcome<TestClaim> = testgen_emit_idempotent_operation_claim(
  label: "generated/idempotent_operation: skip label-only inhabitance without composable body",
  subject: sample_label_only_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
)


fn generated_label_only_skip_is_rejected() -> Bool {
  match generated_label_only_idempotent_skip {
    Rejected { diagnostics: d } => d.head.reason == idempotent_operation_tautology_skip
    Accepted { value: _, diagnostics: _ } => false
  }
}


data generated_label_only_skip_pins_rejection: Bool = generated_label_only_skip_is_rejected()


data run_read_idempotent_operation_via_run_test_claim: Outcome<TestClaimRun<Node, RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_read_idempotent_operation_claim
)


data run_upsert_idempotent_operation_via_run_test_claim: Outcome<TestClaimRun<Node, RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_upsert_idempotent_operation_claim
)


data run_delete_idempotent_operation_via_run_test_claim: Outcome<TestClaimRun<Node, RuntimeValue>> = idempotent_operation_generated_run(
  row: generated_delete_idempotent_operation_claim
)


data witness_read_idempotent_operation_run_passes: Bool = idempotent_operation_run_passed(
  row: run_read_idempotent_operation_via_run_test_claim
)


data witness_upsert_idempotent_operation_run_passes: Bool = idempotent_operation_run_passed(
  row: run_upsert_idempotent_operation_via_run_test_claim
)


data witness_delete_idempotent_operation_run_passes: Bool = idempotent_operation_run_passed(
  row: run_delete_idempotent_operation_via_run_test_claim
)


fn generated_idempotent_operation_claim_rows() -> List<Outcome<TestClaim>> {
  [
    generated_read_idempotent_operation_claim,
    generated_upsert_idempotent_operation_claim,
    generated_delete_idempotent_operation_claim,
  ]
}


fn generated_idempotent_operation_sample_count_is_three() -> Bool {
  length(xs: generated_idempotent_operation_claim_rows()) == 3
}


fn generated_idempotent_operation_scheduled_subject_count_is_three() -> Bool {
  length(xs: testgen_scheduled_idempotent_operation_subjects()) == 3
}


fn generated_idempotent_operation_run_rows() -> List<Outcome<TestClaimRun<Node, RuntimeValue>>> {
  [
    run_read_idempotent_operation_via_run_test_claim,
    run_upsert_idempotent_operation_via_run_test_claim,
    run_delete_idempotent_operation_via_run_test_claim,
  ]
}


fn generated_idempotent_operation_run_count_is_three() -> Bool {
  length(xs: generated_idempotent_operation_run_rows()) == 3
}
