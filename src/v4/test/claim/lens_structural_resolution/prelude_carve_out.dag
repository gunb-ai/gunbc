// src/v4/test/claim/lens_structural_resolution/prelude_carve_out.dag
// Scope: T-13 worked claim — ModuleDependsOn projects PreludeCarveOut (prelude reservation).
// Owns: prelude_carve_out_claim.
// Consumes: lens structural_resolution, compiler infer, std dependency, std node.
// Status: scaffold — compile-only until generated claim execution.

module v4.test.claim.lens_structural_resolution.prelude_carve_out

import v4.compiler.infer { AlgebraRef, InferredFacts, InferredTree }
import v4.lens.structural_resolution {
  StructuralResolutionDependencyFact,
  StructuralResolutionFact,
  at,
  fact_eq
}
import v4.std.cardinality { RankingDimension, TerminationProof }
import v4.std.collection { Map }
import v4.std.constraints {
  CanonicalGroundingWitness,
  constraint_property_being_canonical,
  constraint_property_candidate_set_closedness
}
import v4.std.dependency {
  DependencyView,
  ModuleDependsOn,
  dependency_module_import_edge
}
import v4.std.node { Atom, Edge, Hash, Named, Node, Symbol, TypeNode }
import v4.std.witness { Holds, StructuralPropertyWitness, Witness }

data sr_mod_root_symbol: Symbol = sr_mod_root_symbol
data sr_mod_child_symbol: Symbol = sr_mod_child_symbol
data sr_mod_edge_symbol: Symbol = sr_mod_edge_symbol
data sr_mod_type_symbol: Symbol = sr_mod_type_symbol
data sr_mod_algebra_symbol: Symbol = sr_mod_algebra_symbol
data sr_mod_algebra_witness_symbol: Symbol = sr_mod_algebra_witness_symbol
data sr_mod_descent_symbol: Symbol = sr_mod_descent_symbol
data sr_mod_claim_hash: Hash = sr_mod_claim_hash

fn sr_mod_claim_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}

data sr_mod_child: Node = sr_mod_claim_node(s: sr_mod_child_symbol)

data sr_mod_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: sr_mod_root_symbol } },
  children: [
    Edge { label: Named { name: dependency_module_import_edge }, target: sr_mod_child }
  ]
}

data sr_mod_dependency: DependencyView = DependencyView {
  source: sr_mod_root,
  dependent: sr_mod_child,
  kind: ModuleDependsOn,
  usage_site: sr_mod_child
}

fn sr_mod_canonical_witness(resolved: Node) -> CanonicalGroundingWitness {
  CanonicalGroundingWitness {
    structural: StructuralPropertyWitness {
      property: constraint_property_being_canonical,
      evidence: resolved
    },
    closedness: StructuralPropertyWitness {
      property: constraint_property_candidate_set_closedness,
      evidence: resolved
    }
  }
}

fn sr_mod_claim_facts() -> InferredFacts {
  let resolved = sr_mod_claim_node(s: sr_mod_type_symbol)
  InferredFacts {
    resolved_type: resolved,
    inhabits: AlgebraRef {
      algebra: sr_mod_claim_node(s: sr_mod_algebra_symbol),
      witness: sr_mod_claim_node(s: sr_mod_algebra_witness_symbol)
    },
    descent: TerminationProof {
      non_increasing: [],
      strict: RankingDimension { measured: sr_mod_descent_symbol }
    },
    canonical: sr_mod_canonical_witness(resolved: resolved)
  }
}

fn sr_mod_claim_fact_map(facts: InferredFacts) -> Map<Node, InferredFacts> {
  Map {
    lookup: fn(_) {
      Holds { value: facts }
    }
  }
}

fn sr_mod_claim_tree() -> InferredTree {
  let facts = sr_mod_claim_facts()
  InferredTree {
    root: sr_mod_root,
    facts: sr_mod_claim_fact_map(facts: facts)
  }
}

type LensStructuralResolutionClaim {
  input: InferredTree
  expected: StructuralResolutionFact
  actual: Witness<StructuralResolutionFact>
}

data prelude_carve_out_claim: LensStructuralResolutionClaim = LensStructuralResolutionClaim {
  input: sr_mod_claim_tree(),
  expected: StructuralResolutionFact {
    dependencies: [
      StructuralResolutionDependencyFact {
        at: sr_mod_child,
        dependency: sr_mod_dependency,
        source_facts: Holds { value: sr_mod_claim_facts() },
        dependent_facts: Holds { value: sr_mod_claim_facts() }
      }
    ]
  },
  actual: at(tree: sr_mod_claim_tree())
}

fn prelude_carve_out_claim_holds() -> Bool {
  match prelude_carve_out_claim.actual {
    Holds { value: actual } =>
      fact_eq(a: actual, b: prelude_carve_out_claim.expected)
    _ => false
  }
}

data prelude_carve_out_claim_passes: Bool = prelude_carve_out_claim_holds()
