// src/v4/test/claim/lens_structural_resolution/binds_to_resolved.dag
// Scope: T-13 worked claim — BindsTo with held infer facts projects BindingResolved.
// Owns: binds_to_resolved_claim.
// Consumes: lens structural_resolution, compiler infer, std dependency, std node.
// Status: 🟡 scaffold — dissolve-on: T-13 lens driver executes TestClaim rows (r4-lane-a §3 B2); owner: lens family batch.

module v4.test.claim.lens_structural_resolution.binds_to_resolved

import v4.compiler.infer { AlgebraRef, InferredFacts, InferredTree }
import v4.lens.structural_resolution {
  BindingResolved,
  StructuralResolutionFact,
  fact_eq,
  fact_single_dependency_projects_status
}
import v4.std.dependency { ClassifiedDependencyView }
import v4.test.claim.lens_structural_resolution.claim_carrier {
  LensStructuralResolutionClaim,
  lens_structural_resolution_actual
}
import v4.std.cardinality { RankingDimension, TerminationProof }
import v4.std.collection { Map }
import v4.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness,
  constraint_property_being_canonical,
  constraint_property_candidate_set_closedness
}
import v4.std.dependency {
  BindsTo,
  DependencyView,
  dependency_binds_to_edge
}
import v4.std.node { Atom, Conj, Edge, Hash, Named, Node, Symbol, TypeNode }
import v4.std.witness { Holds, StructuralPropertyWitness, Witness }

data sr_use_symbol: Symbol = sr_use_symbol
data sr_decl_symbol: Symbol = sr_decl_symbol
data sr_type_symbol: Symbol = sr_type_symbol
data sr_algebra_symbol: Symbol = sr_algebra_symbol
data sr_algebra_witness_symbol: Symbol = sr_algebra_witness_symbol
data sr_descent_symbol: Symbol = sr_descent_symbol
data sr_claim_hash: Hash = sr_claim_hash

fn sr_claim_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}

// Atom reference (NoEdges); declaration container carries the BindsTo edge (P6 / node discipline).
data sr_use: Node = sr_claim_atom(s: sr_use_symbol)

data sr_decl: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: dependency_binds_to_edge }, target: sr_use }
  ]
}

data sr_dependency: DependencyView = DependencyView {
  source: sr_decl,
  dependent: sr_use,
  kind: BindsTo,
  usage_site: sr_use
}

fn sr_claim_canonical_witness(resolved: Node) -> CanonicalGroundingWitness {
  CanonicalGroundingWitness {
    structural: StructuralPropertyWitness {
      property: constraint_property_being_canonical,
      evidence: resolved
    },
    closedness: StructuralPropertyWitness {
      property: constraint_property_candidate_set_closedness,
      evidence: resolved
    }
  }
}

fn sr_claim_facts() -> InferredFacts {
  let resolved = sr_claim_atom(s: sr_type_symbol)
  InferredFacts {
    grounding: CanonicalGrounding {
      node: resolved,
      witness: sr_claim_canonical_witness(resolved: resolved)
    },
    descent: Holds {
      value: TerminationProof {
        non_increasing: [],
        strict: RankingDimension { measured: sr_descent_symbol }
      }
    }
  }
}

fn sr_claim_fact_map(facts: InferredFacts) -> Map<Node, InferredFacts> {
  Map {
    lookup: fn(_) {
      Holds { value: facts }
    }
  }
}

fn sr_claim_tree() -> InferredTree {
  let facts = sr_claim_facts()
  InferredTree {
    root: sr_decl,
    facts: sr_claim_fact_map(facts: facts)
  }
}

data binds_to_resolved_claim: LensStructuralResolutionClaim = LensStructuralResolutionClaim {
  input: sr_claim_tree(),
  expected: StructuralResolutionFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: sr_dependency,
        classification: BindingResolved
      }
    ]
  }
}

fn binds_to_resolved_claim_holds() -> Bool {
  match lens_structural_resolution_actual(claim: binds_to_resolved_claim) {
    Holds { value: actual } =>
      fact_eq(a: actual, b: binds_to_resolved_claim.expected)
        && fact_single_dependency_projects_status(fact: actual, expected: BindingResolved)
    _ => false
  }
}

data binds_to_resolved_claim_passes: Bool = binds_to_resolved_claim_holds()
