// Scope: shared TestClaim row carrier for structural_resolution lens claims.

module v4.test.claim.lens_structural_resolution.claim_carrier

import v4.compiler.infer { InferredTree }
import v4.lens.structural_resolution { StructuralResolutionFact, at }
import v4.std.witness { Witness }

type LensStructuralResolutionClaim {
  input: InferredTree
  expected: StructuralResolutionFact
}

fn lens_structural_resolution_actual(
  claim: LensStructuralResolutionClaim
) -> Witness<StructuralResolutionFact> {
  at(tree: claim.input)
}
