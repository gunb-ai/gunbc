// src/v4/test/claim/lens_cost/loop_linear.dag
// Scope: T-12 worked claim — Loop with loop_bound_edge projects to linear symbolic cost.
// Owns: claim_loop_linear.
// Consumes: lens cost, loop_cost_fixture, std verification.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.loop_linear

import v4.lens.cost { LinearCost, SizeVariable, cost_lens }
import v4.std.logic { Bool }
import v4.std.node { Conj, Node, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  Tier1,
  Unit,
  t19_manual_claim_anchor
}
import v4.std.witness { Holds }
import v4.test.claim.lens_cost.loop_cost_fixture {
  loop_linear_input,
  loop_linear_measure_leaf
}

fn loop_linear_claim_holds() -> Bool {
  match cost_lens(n: loop_linear_input) {
    Holds { value: actual } =>
      actual == LinearCost { variable: SizeVariable { source: loop_linear_measure_leaf } }
    _ => false
  }
}

fn loop_linear_claim_rhs() -> Node {
  if loop_linear_claim_holds() {
    loop_linear_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_loop_linear: TestClaim = EqualsClaim {
  label: "lens_cost/loop_linear: loop with loop_bound_edge projects iterative linear cost",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  lhs: loop_linear_input,
  rhs: loop_linear_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
