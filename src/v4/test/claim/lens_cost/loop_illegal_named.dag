// src/v4/test/claim/lens_cost/loop_illegal_named.dag
// Scope: T-12 worked claim — Loop with illegal Named edge fails closed.
// Owns: claim_loop_illegal_named.
// Consumes: lens cost, loop_cost_fixture, std verification.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.loop_illegal_named

import v4.lens.cost { cost_lens }
import v4.std.logic { Bool }
import v4.std.node { Conj, Node, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  Tier1,
  Unit,
  t19_manual_claim_anchor
}
import v4.std.witness { Violates }
import v4.test.claim.lens_cost.loop_cost_fixture { loop_illegal_named_input }

fn loop_illegal_named_claim_holds() -> Bool {
  match cost_lens(n: loop_illegal_named_input) {
    Violates { diagnostic: _ } => true
    _ => false
  }
}

fn loop_illegal_named_claim_rhs() -> Node {
  if loop_illegal_named_claim_holds() {
    loop_illegal_named_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_loop_illegal_named: TestClaim = EqualsClaim {
  label: "lens_cost/loop_illegal_named: illegal Loop Named edge fails closed with edge-discipline reason",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  lhs: loop_illegal_named_input,
  rhs: loop_illegal_named_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
