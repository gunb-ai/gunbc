// src/v4/test/claim/lens_cost/loop_illegal_named.dag
// Scope: T-12 worked claim — Loop with illegal Named edge fails closed.
// Owns: claim_loop_illegal_named.
// Consumes: lens cost, std node, std verification.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.loop_illegal_named

import v4.lens.cost { UnknownCost, symbolic_cost_of_node }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Loop,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data loop_illegal_named_body_atom: Symbol = loop_illegal_named_body_atom
data loop_illegal_named_measure_atom: Symbol = loop_illegal_named_measure_atom
data loop_illegal_named_extra_atom: Symbol = loop_illegal_named_extra_atom
data loop_illegal_named_bound_edge: Symbol = loop_bound_edge

data loop_illegal_named_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: loop_illegal_named_body_atom } },
  children: []
}

data loop_illegal_named_measure_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: loop_illegal_named_measure_atom } },
  children: []
}

data loop_illegal_named_extra_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: loop_illegal_named_extra_atom } },
  children: []
}

data loop_illegal_named_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: loop_illegal_named_body_leaf },
    Edge { label: Named { name: loop_illegal_named_bound_edge }, target: loop_illegal_named_measure_leaf },
    Edge { label: Named { name: loop_illegal_named_extra_atom }, target: loop_illegal_named_extra_leaf }
  ]
}

fn loop_illegal_named_claim_holds() -> Bool {
  match symbolic_cost_of_node(n: loop_illegal_named_input) {
    UnknownCost { reason: r } =>
      r == "loop-bound-malformed: Loop node violates Loop edge discipline"
    _ => false
  }
}

fn loop_illegal_named_claim_rhs() -> Node {
  if loop_illegal_named_claim_holds() {
    loop_illegal_named_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_loop_illegal_named: TestClaim = EqualsClaim {
  label: "lens_cost/loop_illegal_named: illegal Loop Named edge fails closed with edge-discipline reason",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: loop_illegal_named_input,
  rhs: loop_illegal_named_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
