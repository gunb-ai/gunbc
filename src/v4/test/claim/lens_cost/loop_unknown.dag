// src/v4/test/claim/lens_cost/loop_unknown.dag
// Scope: T-12 worked claim — non-structural loop bounds fail closed on cost_lens.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.loop_unknown

import v4.lens.cost { cost_lens }
import v4.std.logic { Bool }
import v4.std.node { ComputationNode, Conj, Loop, Node, TypeNode, Unanchored }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Violates }

data loop_unknown_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [],
  span: Unanchored
}

fn loop_unknown_claim_holds() -> Bool {
  match cost_lens(n: loop_unknown_input) {
    Violates { diagnostic: _ } => true
    _ => false
  }
}

fn loop_unknown_claim_rhs() -> Node {
  if loop_unknown_claim_holds() {
    loop_unknown_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      span: Unanchored
}
  }
}

data claim_loop_unknown: TestClaim = EqualsClaim {
  label: "lens_cost/loop_unknown: loop without bound fails closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: loop_unknown_input,
  rhs: loop_unknown_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
