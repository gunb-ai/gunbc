// src/v4/test/claim/lens_cost/nested_product.dag
// Scope: T-12 worked claim — nested cardinalities compose by iterative product.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.nested_product

import v4.lens.cost { LinearCost, ProductCost, SizeVariable, cost_lens }
import v4.std.logic { Bool }
import v4.std.node {
  Cardinality,
  ComputationNode,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds }

data nested_product_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [],
  span: Unanchored
}

data nested_product_inner: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: nested_product_body }
  ],
  span: Unanchored
}

data nested_product_input: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: nested_product_inner }
  ],
  span: Unanchored
}

fn nested_product_claim_holds() -> Bool {
  match cost_lens(n: nested_product_input) {
    Holds { value: actual } =>
      actual == ProductCost {
        lhs: LinearCost { variable: SizeVariable { source: nested_product_input } },
        rhs: LinearCost { variable: SizeVariable { source: nested_product_inner } }
      }
    _ => false
  }
}

fn nested_product_claim_rhs() -> Node {
  if nested_product_claim_holds() {
    nested_product_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      span: Unanchored
}
  }
}

data claim_nested_product: TestClaim = EqualsClaim {
  label: "lens_cost/nested_product: nested cardinality composes as product cost",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: nested_product_input,
  rhs: nested_product_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
