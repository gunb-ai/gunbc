// src/v4/test/claim/lens_cost/disj_max.dag
// Scope: T-12 worked claim — disjunctive composition takes the dominant branch cost.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.disj_max

import v4.lens.cost { LinearCost, SizeVariable, cost_lens }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Cardinality,
  ComputationNode,
  Conj,
  Disj,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds }
data disj_max_cheap_body: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^disj_max_cheap_body_atom } },
  children: [],
  span: Unanchored
}

data disj_max_expensive_body: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge {
      label: Positional,
      target: Node {
        kind: ComputationNode { behavior: Transform },
        children: [
          Edge {
            label: Positional,
            target: Node {
              kind: TypeNode { connective: Atom { identity: ^disj_max_expensive_body_atom } },
              children: []
            }
          }
        ]
      }
    }
  ],
  span: Unanchored
}

data disj_max_input: Node = Node {
  kind: TypeNode { connective: Disj },
  children: [
    Edge { label: Positional, target: disj_max_cheap_body },
    Edge { label: Positional, target: disj_max_expensive_body }
  ],
  span: Unanchored
}

fn disj_max_claim_holds() -> Bool {
  match cost_lens(n: disj_max_input) {
    Holds { value: actual } =>
      actual == LinearCost { variable: SizeVariable { source: disj_max_expensive_body } }
    _ => false
  }
}

fn disj_max_claim_rhs() -> Node {
  if disj_max_claim_holds() {
    disj_max_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      span: Unanchored
}
  }
}

data claim_disj_max: TestClaim = EqualsClaim {
  label: "lens_cost/disj_max: disjunct takes max branch cost",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: disj_max_input,
  rhs: disj_max_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
