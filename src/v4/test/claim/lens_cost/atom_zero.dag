// src/v4/test/claim/lens_cost/atom_zero.dag
// Scope: T-12 negative claim — bare atom carrier stays constant zero cost (no iterative charge).
// Owns: atom_zero_claim.
// Consumes: lens cost, std diagnostic, std node.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.atom_zero

import v4.lens.cost { ConstantCost, SymbolicCost, cost_lens, zero_cost }
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.witness { Holds, Witness }

data atom_zero_claim_file: Symbol = atom_zero_claim_file
data atom_zero_claim_reason: Symbol = atom_zero_claim_reason
data atom_zero_symbol: Symbol = atom_zero_symbol

type LensCostClaim {
  input: Node
  expected: SymbolicCost
  falsification: Diagnostic
}

data atom_zero_input: Node = Node {
  kind: TypeNode { connective: Atom { identity: atom_zero_symbol } },
  children: []
}

data atom_zero_claim: LensCostClaim = LensCostClaim {
  input: atom_zero_input,
  expected: zero_cost(),
  falsification: Diagnostic {
    reason: atom_zero_claim_reason,
    at: Textual { file: atom_zero_claim_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn atom_zero_claim_holds() -> Bool {
  match cost_lens(n: atom_zero_claim.input) {
    Holds { value: actual } => actual == atom_zero_claim.expected
    _ => false
  }
}

data atom_zero_claim_passes: Bool = atom_zero_claim_holds()
