// src/v4/test/claim/lens_cost/atom_zero.dag
// Scope: T-12 negative claim — bare atom carrier stays constant zero cost.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.atom_zero

import v4.lens.cost { cost_lens, zero_cost }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode, substrate_synthetic_occurrence_id }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds }
data atom_zero_input: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^atom_zero_symbol } },
  children: [],
  occurrence_id: substrate_synthetic_occurrence_id
}

fn atom_zero_claim_holds() -> Bool {
  match cost_lens(n: atom_zero_input) {
    Holds { value: actual } => actual == zero_cost()
    _ => false
  }
}

fn atom_zero_claim_rhs() -> Node {
  if atom_zero_claim_holds() {
    atom_zero_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: substrate_synthetic_occurrence_id
}
  }
}

data claim_atom_zero: TestClaim = EqualsClaim {
  label: "lens_cost/atom_zero: bare atom has zero symbolic cost",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: atom_zero_input,
  rhs: atom_zero_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
