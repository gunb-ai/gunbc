// src/v4/test/claim/lens_cost/map_linear.dag
// Scope: T-12 worked claim — structural cardinality projects to linear symbolic cost.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.map_linear

import v4.lens.cost { LinearCost, SizeVariable, cost_lens }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Cardinality,
  ComputationNode,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  substrate_synthetic_occurrence_id
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds }
data map_linear_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^map_linear_body_atom } },
  children: [],
  occurrence_id: substrate_synthetic_occurrence_id
}

data map_linear_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: map_linear_body_leaf }
  ],
  occurrence_id: substrate_synthetic_occurrence_id
}

data map_linear_input: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: map_linear_body }
  ],
  occurrence_id: substrate_synthetic_occurrence_id
}

fn map_linear_claim_holds() -> Bool {
  match cost_lens(n: map_linear_input) {
    Holds { value: actual } =>
      actual == LinearCost { variable: SizeVariable { source: map_linear_input } }
    _ => false
  }
}

fn map_linear_claim_rhs() -> Node {
  if map_linear_claim_holds() {
    map_linear_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: substrate_synthetic_occurrence_id
}
  }
}

data claim_map_linear: TestClaim = EqualsClaim {
  label: "lens_cost/map_linear: cardinality projects to linear symbolic cost",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: map_linear_input,
  rhs: map_linear_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
