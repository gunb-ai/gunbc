// src/v4/test/claim/lens_cost/loop_bound_malformed.dag
// Scope: T-12 worked claim — Loop with illegal Named edge fails closed with edge-discipline reason.
// Owns: claim_loop_bound_malformed.
// Consumes: lens cost, std node, std verification.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.loop_bound_malformed

import v4.lens.cost { cost_lens }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Loop,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  loop_bound_edge
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  Tier1,
  Unit,
  t19_manual_claim_anchor
}
import v4.std.witness { Violates }

data loop_bound_malformed_body_atom: Symbol = loop_bound_malformed_body_atom
data loop_bound_malformed_measure_atom: Symbol = loop_bound_malformed_measure_atom
data loop_bound_malformed_extra_atom: Symbol = loop_bound_malformed_extra_atom

data loop_bound_malformed_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: loop_bound_malformed_body_atom } },
  children: []
}

data loop_bound_malformed_measure_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: loop_bound_malformed_measure_atom } },
  children: []
}

data loop_bound_malformed_extra_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: loop_bound_malformed_extra_atom } },
  children: []
}

data loop_bound_malformed_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: loop_bound_malformed_body_leaf },
    Edge { label: Named { name: loop_bound_edge }, target: loop_bound_malformed_measure_leaf },
    Edge { label: Named { name: loop_bound_malformed_extra_atom }, target: loop_bound_malformed_extra_leaf }
  ]
}

fn loop_bound_malformed_claim_holds() -> Bool {
  match cost_lens(n: loop_bound_malformed_input) {
    Violates { diagnostic: _ } => true
    _ => false
  }
}

fn loop_bound_malformed_claim_rhs() -> Node {
  if loop_bound_malformed_claim_holds() {
    loop_bound_malformed_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_loop_bound_malformed: TestClaim = EqualsClaim {
  label: "lens_cost/loop_bound_malformed: illegal Loop Named edge fails closed with edge-discipline reason",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  lhs: loop_bound_malformed_input,
  rhs: loop_bound_malformed_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
