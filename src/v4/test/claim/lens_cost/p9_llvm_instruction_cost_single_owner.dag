// src/v4/test/claim/lens_cost/p9_llvm_instruction_cost_single_owner.dag
// Scope: B1 structural receipt — P9 llvm_instruction_cost single-owner pinned in lens registry.
// Owns: claim_p9_llvm_instruction_cost_registry_owner
// Consumes: v4.lens.registry, v4.std.verification, v4.std.node
// Status: compile-only registry receipt until T-22 corpus execution.

module v4.test.claim.lens_cost.p9_llvm_instruction_cost_single_owner

import v4.lens.registry {
  lens_owned_fn_llvm_instruction_cost,
  symbol_llvm_instruction_cost
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  Tier1,
  Unit
}
import v4.std.node { Atom, Conj, Node, TypeNode }


data p9_expected_owner_module_path: String = "v4.lens.cost"
data p9_owner_module_path: String = lens_owned_fn_llvm_instruction_cost.owner_module_path


data p9_registry_owner_authority_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: symbol_llvm_instruction_cost } },
  children: []
}


fn p9_owner_module_paths_equal() -> Bool {
  p9_owner_module_path == p9_expected_owner_module_path
}


fn p9_registry_owner_receipt_rhs() -> Node {
  if p9_owner_module_paths_equal() {
    p9_registry_owner_authority_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}


data claim_p9_llvm_instruction_cost_registry_owner: TestClaim = EqualsClaim {
  label: "P9: llvm_instruction_cost owner_module_path equals v4.lens.cost (registry authority)",
  t19_anchor: T19ManualAnchorAbsent,
  lhs: p9_registry_owner_authority_node,
  rhs: p9_registry_owner_receipt_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
