// src/v4/test/claim/lens_cost/loop_cost_fixture.dag
// Scope: shared Loop + loop_bound_edge claim fixtures (isolated from verification imports).
// Owns: loop_linear_input, loop_illegal_named_input, measure leaves.
// Consumes: std node.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_cost.loop_cost_fixture

import v4.std.node {
  Atom,
  ComputationNode,
  Edge,
  Loop,
  Named,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  loop_bound_edge
}

data loop_linear_body_atom: Symbol = loop_linear_body_atom
data loop_linear_measure_atom: Symbol = loop_linear_measure_atom
data loop_illegal_named_extra_atom: Symbol = loop_illegal_named_extra_atom

data loop_linear_body_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: loop_linear_body_atom } },
  children: []
}

data loop_linear_measure_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: loop_linear_measure_atom } },
  children: []
}

data loop_illegal_named_extra_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: loop_illegal_named_extra_atom } },
  children: []
}

data loop_linear_body: Node = Node {
  kind: ComputationNode { behavior: Transform },
  children: [
    Edge { label: Positional, target: loop_linear_body_leaf }
  ]
}

data loop_linear_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: loop_linear_body },
    Edge { label: Named { name: loop_bound_edge }, target: loop_linear_measure_leaf }
  ]
}

data loop_illegal_named_input: Node = Node {
  kind: ComputationNode { behavior: Loop },
  children: [
    Edge { label: Positional, target: loop_linear_body_leaf },
    Edge { label: Named { name: loop_bound_edge }, target: loop_linear_measure_leaf },
    Edge { label: Named { name: loop_illegal_named_extra_atom }, target: loop_illegal_named_extra_leaf }
  ]
}
