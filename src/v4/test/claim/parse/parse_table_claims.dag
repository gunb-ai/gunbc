// src/v4/test/claim/parse/parse_table_claims.dag
// Scope: Wave-A W1 — v4.compiler.parse `token_position_indices` as a discriminating
// claim-run witness, routed through v2 (`dag run --claim-run`).
//
// Migrates the EXECUTABLE behavioral content of the `token_position_indices` no-extra-append
// receipt in src/v3/compiler/tests/integration/v4_compiler_parse_table_dag_smoke_test.rs
// (formerly the host source-grep `!PARSE_DAG.contains("item: length(xs: tokens)")`) into a
// `fn -> Bool` witness that EXECUTES token_position_indices over a fixed token list and
// DISCRIMINATES the produced 0..N index sequence: a duplicate final append (the regressed
// shape) yields an extra index, turning the witness red. Mutating the fold turns it red.
//
// NOTE: the parse_table grammar core (parse_production / grammar_has_* / parse_skip_to_sync)
// is NOT migrated here — it CRASHES through v2 with `contains expects a string argument, got
// Variant` (the 'contains-Variant-gap' v2-interpreter builtin gap). Those receipts stay
// host-AST in the smoke until that substrate lands.

module v4.test.claim.parse.parse_table_claims


import v4.std.logic { Bool }
import v4.std.collection { List, Set }
import v4.std.algebra { Cons, Empty, length }
import v4.std.lexing { Token }
import v4.std.node { Symbol }
import v4.std.grammar {
  Choice,
  GrammarExpr,
  Nonterminal,
  Optional,
  Repeat,
  Sequence,
  Terminal
}
import v4.compiler.parse { expr_is_nullable_given_set, token_position_indices }

import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
fn parse_table_token(class: Symbol) -> Token {
  Token { class: class, lexeme: Empty, file: class, start: 0, end: 0 }
}


// Two-token input. token_position_indices threads positions 0..N as a structurally bounded
// fold seeded with [0], snoc-ing length(acc) per token: [0] → [0,1] → [0,1,2]. The fix
// produces exactly N+1 = 3 entries with NO duplicate final append (which would give 4).
data parse_table_two_tokens: List<Token> = Cons {
  head: parse_table_token(class: ^parse_table_probe_class),
  tail: Cons { head: parse_table_token(class: ^parse_table_probe_class), tail: Empty }
}

data parse_table_empty_tokens: List<Token> = Empty


// Receipt A (token_position_indices is 0..N with no extra final append): a 2-token input
// yields exactly 3 indices, and the empty input yields exactly 1 ([0]). The negative arm
// (== 4 is false) pins the no-duplicate-append property; a regressed extra snoc → red.
fn parse_table_token_position_indices_no_extra_append_holds() -> Bool {
  (length(xs: token_position_indices(tokens: parse_table_two_tokens)) == 3)
    && (length(xs: token_position_indices(tokens: parse_table_empty_tokens)) == 1)
    && ((length(xs: token_position_indices(tokens: parse_table_two_tokens)) == 4) == false)
}

// Singleton nullable set: only `name` is nullable.
fn nullable_set_singleton(name: Symbol) -> Set<Symbol> {
  Set { member: fn(sym) { sym == name } }
}


// Receipt B (expr_is_nullable_given_set is a correct GrammarExprFold catamorphism consumer):
// EXECUTES the rewritten nullable query over a fixed nullable set across every GrammarExpr
// variant and BOTH branch directions, discriminating each result:
//   - Terminal: never nullable (false)
//   - Nonterminal: nullable iff in the set (probe → true, other → false)
//   - Optional / Repeat: always nullable (true)
//   - Sequence: nullable iff BOTH sides nullable (Optional;probe → true; Terminal;Optional → false)
//   - Choice: nullable iff EITHER side nullable (Terminal|Optional → true; Terminal|other → false)
// Mutating any combine arm of expr_is_nullable_given_set (or fold_grammar_expr's recursion) flips
// at least one conjunct → red.
fn parse_table_nullable_morphism_holds() -> Bool {
  let ns = nullable_set_singleton(name: ^parse_table_nullable_probe_nt)
  (expr_is_nullable_given_set(
    expr: Terminal { token_class: ^parse_table_nullable_tok },
    nullable_set: ns
  ) == false)
    && (expr_is_nullable_given_set(
      expr: Optional { element: Terminal { token_class: ^parse_table_nullable_tok } },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Repeat { element: Terminal { token_class: ^parse_table_nullable_tok } },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Nonterminal { production: ^parse_table_nullable_probe_nt },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Nonterminal { production: ^parse_table_nullable_other_nt },
      nullable_set: ns
    ) == false)
    && (expr_is_nullable_given_set(
      expr: Sequence {
        left: Optional { element: Terminal { token_class: ^parse_table_nullable_tok } },
        right: Nonterminal { production: ^parse_table_nullable_probe_nt }
      },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Sequence {
        left: Terminal { token_class: ^parse_table_nullable_tok },
        right: Optional { element: Terminal { token_class: ^parse_table_nullable_tok } }
      },
      nullable_set: ns
    ) == false)
    && (expr_is_nullable_given_set(
      expr: Choice {
        left: Terminal { token_class: ^parse_table_nullable_tok },
        right: Optional { element: Terminal { token_class: ^parse_table_nullable_tok } }
      },
      nullable_set: ns
    ) == true)
    && (expr_is_nullable_given_set(
      expr: Choice {
        left: Terminal { token_class: ^parse_table_nullable_tok },
        right: Nonterminal { production: ^parse_table_nullable_other_nt }
      },
      nullable_set: ns
    ) == false)
}


// Consolidation #4553 Phase 2 distributed BoolWitnessClaim marker.
// Co-located with `parse_table_token_position_indices_no_extra_append_holds` so glob discovery finds the witness without the central roster.
data unified_claim_parse_table_token_position_indices: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/parse/parse_table_claims.dag",
    function: parse_table_token_position_indices_no_extra_append_holds
  }
}


// Co-located BoolWitnessClaim for the GrammarExprFold catamorphism consumer (node://adhoc-b696538c-710),
// so glob discovery finds the witness without the central roster.
data unified_claim_parse_table_nullable_morphism: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/parse/parse_table_claims.dag",
    function: parse_table_nullable_morphism_holds
  }
}
