// src/v4/test/claim/parse/parse_table_claims.dag
// Scope: Wave-A W1 — v4.compiler.parse `token_position_indices` as a discriminating
// claim-run witness, routed through v2 (`dag run --claim-run`).
//
// Migrates the behavioral content of the retired
// v4_compiler_parse_table_dag_smoke_test.rs (formerly the host source-grep `!PARSE_DAG.contains("item: length(xs: tokens)")`) into a
// `fn -> Bool` witness that EXECUTES token_position_indices over a fixed token list and
// DISCRIMINATES the produced 0..N index sequence: a duplicate final append (the regressed
// shape) yields an extra index, turning the witness red. Mutating the fold turns it red.
//
// Status: Wave-A W1 fold-delete. The retired v4_compiler_parse_table_dag_smoke_test.rs
// and its SG-0 EXPECTED_HAND_AUTHORED_TEST row land in the same PR.

module v4.test.claim.parse.parse_table_claims


import v4.std.logic { Bool }
import v4.std.collection { List }
import v4.std.algebra { Cons, Empty, length }
import v4.std.lexing { Token }
import v4.std.node { Symbol }
import v4.compiler.parse { token_position_indices }


data parse_table_probe_class: Symbol = parse_table_probe_class


fn parse_table_token(class: Symbol) -> Token {
  Token { class: class, lexeme: Empty, file: class, start: 0, end: 0 }
}


// Two-token input. token_position_indices threads positions 0..N as a structurally bounded
// fold seeded with [0], snoc-ing length(acc) per token: [0] → [0,1] → [0,1,2]. The fix
// produces exactly N+1 = 3 entries with NO duplicate final append (which would give 4).
data parse_table_two_tokens: List<Token> = Cons {
  head: parse_table_token(class: parse_table_probe_class),
  tail: Cons { head: parse_table_token(class: parse_table_probe_class), tail: Empty }
}

data parse_table_empty_tokens: List<Token> = Empty


// Receipt A (token_position_indices is 0..N with no extra final append): a 2-token input
// yields exactly 3 indices, and the empty input yields exactly 1 ([0]). The negative arm
// (== 4 is false) pins the no-duplicate-append property; a regressed extra snoc → red.
fn parse_table_token_position_indices_no_extra_append_holds() -> Bool {
  (length(xs: token_position_indices(tokens: parse_table_two_tokens)) == 3)
    && (length(xs: token_position_indices(tokens: parse_table_empty_tokens)) == 1)
    && ((length(xs: token_position_indices(tokens: parse_table_two_tokens)) == 4) == false)
}
