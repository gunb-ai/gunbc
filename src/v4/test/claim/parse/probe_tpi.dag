module v4.test.claim.parse.probe_tpi
import v4.std.logic { Bool }
import v4.std.nat { Nat }
import v4.std.collection { List }
import v4.std.algebra { length }
import v4.std.lexing { Token }
import v4.std.algebra { Cons, Empty }
import v4.compiler.parse { token_position_indices }
data probe_sym: Symbol = probe_sym
import v4.std.node { Symbol }
data probe_two: List<Token> = Cons {
  head: Token { class: probe_sym, lexeme: Empty, file: probe_sym, start: 0, end: 0 },
  tail: Cons { head: Token { class: probe_sym, lexeme: Empty, file: probe_sym, start: 0, end: 0 }, tail: Empty }
}
fn probe_tpi_len_three() -> Bool {
  length(xs: token_position_indices(tokens: probe_two)) == 3
}
