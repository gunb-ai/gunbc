// src/v4/test/claim/parse/lean_wave2a.dag
// Scope: TestClaim rows for Lean Wave 2a lex/grammar behavior (GrammarSchemaProbeBinding migration).
// Status: T-22 runner deferred — execution pending T-22 complexity fix.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.

module v4.test.claim.parse.lean_wave2a

import v4.std.grammar { ParseTree }
import v4.compiler.tokenize { tokenize }
import v4.compiler.parse { parse }
import v4.extdeps.languages.lean { lean_wave1_lex, lean_wave1_grammar }
import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.logic { Bool }
import v4.std.text { String }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}

data lean_wave2a_file: Symbol = lean_wave2a_file
data lean_wave2a_bool_true: Symbol = lean_wave2a_bool_true
data lean_wave2a_bool_false: Symbol = lean_wave2a_bool_false

data lean_wave2a_mvp1_source: String = "def dec (n : Int32) : Int32 := n - 1\n  termination_by n"

fn lean_wave2a_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: lean_wave2a_bool_true } }, children: [] }
    false => Node { kind: TypeNode { connective: Atom { identity: lean_wave2a_bool_false } }, children: [] }
  }
}

// 🟡 predicate dissolution — feature:T-22-outcome-to-bool-claim-bridge — bind TASKS.md T-22 —
// dissolve-on: T-22 claim runner evaluates Outcome<ParseTree> directly without Bool projection.
fn lean_wave2a_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn lean_wave2a_tokenize_and_parse() -> Outcome<ParseTree> {
  match tokenize(
    text: lean_wave2a_mvp1_source,
    file: lean_wave2a_file,
    rules: lean_wave1_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: lean_wave1_grammar())
  }
}

data claim_lean_wave2a_mvp1_parses: TestClaim = EqualsClaim {
  label: "Lean Wave 2a lex/grammar accepts the PROOF-1 MVP def+termination_by fixture via tokenize+parse",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: lean_wave2a_bool_atom(
    b: lean_wave2a_parse_accepted(out: lean_wave2a_tokenize_and_parse())
  ),
  rhs: lean_wave2a_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
