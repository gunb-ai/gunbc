// src/v4/test/claim/parse/grammar_validation.dag
// Scope: TestClaim rows asserting grammar validation boundaries and sync-recovery fail-closed behavior.
// Owns: claims for duplicate-name rejection, undefined-nonterminal rejection, and
//       parse_skip_to_sync with empty sync set returning found_sync: false (no token drain).
// Consumes: v4.compiler.tokenize v4.compiler.parse v4.std.algebra v4.std.collection
//           v4.std.nat v4.std.node v4.std.logic v4.std.verification
// Status: T-22 runner deferred — execution pending T-22 complexity fix
//         (nat_monus/trusted_termination for expr_is_nullable/expr_reaches_nonterminal_left/parse).
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.parse.grammar_validation


import v4.compiler.tokenize { Token }
import v4.compiler.parse {
  GrammarProduction,
  GrammarRoot,
  Terminal,
  grammar_atom,
  grammar_empty_sync_tokens,
  grammar_has_duplicate_productions,
  grammar_has_undefined_nonterminals,
  parse_skip_to_sync
}
import v4.std.algebra { Cons, Empty }
import v4.std.collection { List }
import v4.std.nat { Nat, Zero }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.logic { Bool }
import v4.std.verification {
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  EqualsClaim,
  manual_claim_anchor
}


data validation_tok_class: Symbol = validation_tok_class
data validation_start: Symbol = validation_start
data validation_other: Symbol = validation_other
data validation_file: Symbol = validation_file
data validation_bool_true: Symbol = validation_bool_true
data validation_bool_false: Symbol = validation_bool_false


fn validation_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: validation_bool_true } }, children: [] }
    false => Node { kind: TypeNode { connective: Atom { identity: validation_bool_false } }, children: [] }
  }
}


fn validation_terminal_production(name: Symbol) -> GrammarProduction {
  GrammarProduction {
    name: name,
    expression: Terminal { token_class: validation_tok_class },
    emitted: grammar_atom(identity: name)
  }
}


fn validation_token(class: Symbol) -> Token {
  Token { class: class, lexeme: Empty, file: validation_file, start: Zero, end: Zero }
}


// GrammarRoot with two productions that share the same name.
data validation_dup_root: GrammarRoot = GrammarRoot {
  start: validation_start,
  productions: Cons {
    head: validation_terminal_production(name: validation_start),
    tail: Cons { head: validation_terminal_production(name: validation_start), tail: Empty }
  },
  sync_tokens: grammar_empty_sync_tokens()
}


// GrammarRoot whose start production is absent from the productions list.
data validation_missing_start_root: GrammarRoot = GrammarRoot {
  start: validation_start,
  productions: Cons { head: validation_terminal_production(name: validation_other), tail: Empty },
  sync_tokens: grammar_empty_sync_tokens()
}


// Non-empty token list for the sync-recovery claim.
data validation_one_token_list: List<Token> =
  Cons { head: validation_token(class: validation_tok_class), tail: Empty }


data claim_duplicate_productions_detected: TestClaim = EqualsClaim {
  label: "grammar_has_duplicate_productions returns true for duplicate production names",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_duplicate_productions(root: validation_dup_root)),
  rhs: validation_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_undefined_nonterminal_detected: TestClaim = EqualsClaim {
  label: "grammar_has_undefined_nonterminals returns true for missing start production",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: grammar_has_undefined_nonterminals(root: validation_missing_start_root)),
  rhs: validation_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_empty_sync_set_no_token_drain: TestClaim = EqualsClaim {
  label: "parse_skip_to_sync with empty sync set returns found_sync: false for non-empty input",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: validation_bool_atom(b: parse_skip_to_sync(
    tokens: validation_one_token_list,
    sync_tokens: grammar_empty_sync_tokens()
  ).found_sync),
  rhs: validation_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
