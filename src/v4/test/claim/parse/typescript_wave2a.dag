// src/v4/test/claim/parse/typescript_wave2a.dag
// Scope: TestClaim rows for TypeScript Wave 2a lex/grammar behavior, including the
// type-alias / record-type production added in T-11 typescript ext PR-1 (#3900).
// Status: T-22 runner deferred — execution pending T-22 complexity fix.

module v4.test.claim.parse.typescript_wave2a

import v4.compiler.tokenize { TokenStream, tokenize }
import v4.compiler.parse { ParseTree, parse }
import v4.extdeps.languages.typescript { ts_wave2a_lex, ts_wave2a_grammar }
import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.logic { Bool }
import v4.std.text { String }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}

data ts_wave2a_file: Symbol = ts_wave2a_file
data ts_wave2a_bool_true: Symbol = ts_wave2a_bool_true
data ts_wave2a_bool_false: Symbol = ts_wave2a_bool_false

// Round-trip target from task_manager_demo.dag Task — exercises type_alias_decl
// (kw_type, ident, eq, type_annotation→record_type, semicolon), record_fields
// comma-list (3 fields), type_name (TaskId, TaskStatus), and built-in type_string.
//
// 🟡 lex-encoding-convention scaffold — feature:ts-wave2a-whitespace-trivia —
// the double space between `=` and `{` is required by the current ts_wave2a_lex
// encoding (ts_token_eq is `" = "` AND ts_token_lbrace is `" { "` — both carry
// leading/trailing spaces baked into the literal). The TypeScript spec allows
// single space; bridging the gap requires moving punctuation lex rules to a
// trivia-consuming model (per codex BLOCKING #3900 root cause: "introduce or
// consume whitespace trivia, or otherwise make the token model compose").
// Dissolve-on-arrival: when the substrate lex model gains whitespace-trivia
// handling, this fixture's double-space artifact collapses to single-space.
// Until then, every TS wave2a parse-claim fixture must follow the lex-rule
// concatenation convention used here.
data ts_wave2a_type_alias_task_source: String = "type Task =  { id: TaskId, title: string, status: TaskStatus };"

// Minimal single-field alias — positive form (spec-correct surface, lex-encoded
// double space between `=` and `{` per the disposition above).
data ts_wave2a_type_alias_minimal_source: String = "type Box =  { value: number };"

// Negative regression — the previously-shipped invalid `type Foo { ... }` form
// (omitting the required `=`) MUST be rejected. Lex tokenizes this without
// issue (lbrace's leading space matches the source space after the ident),
// but the parser rejects against type_alias_decl's required EQ position.
// Without this, a future grammar edit could silently re-accept the bad form
// and the positive test alone would stay green.
data ts_wave2a_type_alias_missing_eq_source: String = "type Box { value: number };"

fn ts_wave2a_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ts_wave2a_bool_true } }, children: [] }
    false => Node { kind: TypeNode { connective: Atom { identity: ts_wave2a_bool_false } }, children: [] }
  }
}

// 🟡 predicate-dissolution scaffold — feature:std-outcome-accepted-predicate —
// matches the same shape already present in rust/kotlin/python/swift/lean wave2a
// parse-claim files; promote-and-replace once std/diagnostic.dag exports a
// canonical `outcome_accepted_predicate` (or equivalent). Dissolve-on-arrival:
// when std grows the helper, every wave2a parse-claim file replaces its local
// copy with the canonical import in one pass; until then this file follows the
// established sibling shape rather than authoring a new local-authority idiom.
fn ts_wave2a_parse_accepted(out: Outcome<ParseTree>) -> Bool {
  match out {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn ts_wave2a_tokenize_and_parse_source(text: String) -> Outcome<ParseTree> {
  match tokenize(
    text: text,
    file: ts_wave2a_file,
    rules: ts_wave2a_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: ts_wave2a_grammar())
  }
}

data claim_ts_wave2a_type_alias_task_parses: TestClaim = EqualsClaim {
  label: "TS Wave 2a accepts the Task record-type alias: type Task = { id: TaskId, title: string, status: TaskStatus };",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_wave2a_bool_atom(
    b: ts_wave2a_parse_accepted(
      out: ts_wave2a_tokenize_and_parse_source(text: ts_wave2a_type_alias_task_source)
    )
  ),
  rhs: ts_wave2a_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_ts_wave2a_type_alias_minimal_parses: TestClaim = EqualsClaim {
  label: "TS Wave 2a accepts a minimal single-field record-type alias with the spec-required `=` token",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_wave2a_bool_atom(
    b: ts_wave2a_parse_accepted(
      out: ts_wave2a_tokenize_and_parse_source(text: ts_wave2a_type_alias_minimal_source)
    )
  ),
  rhs: ts_wave2a_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data claim_ts_wave2a_type_alias_missing_eq_rejected: TestClaim = EqualsClaim {
  label: "TS Wave 2a REJECTS the no-`=` form `type Box { value: number };` — negative regression against the prior bug",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ts_wave2a_bool_atom(
    b: ts_wave2a_parse_accepted(
      out: ts_wave2a_tokenize_and_parse_source(text: ts_wave2a_type_alias_missing_eq_source)
    )
  ),
  rhs: ts_wave2a_bool_atom(b: false),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
