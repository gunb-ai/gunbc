// src/v4/test/claim/std_model_core/bool_fact_lookup.dag
// W3 A-fold-delete: behavioral claim-run witness for model_core_wave1_bool_fact_lookup.
// Replaces the v4_std_model_core_dag_smoke_test.rs declaration-shape ratchet AND the hand-Rust
// MIRROR helper (bool_fact_axis_dispatch) — a tautology that re-stated the fold in Rust rather than
// folding the REAL node. This witness folds the real fn by execution and DISCRIMINATES:
//   arm-1 (Width) holds the width fact; arm-2 (Encoding) holds the DIFFERENT encoding fact;
//   the unbound axis (Signedness) fails closed (Violates).
// Mutation-proven: flipping the encoding arm to return the width fact collapses encoding_ok -> RED.

module v4.test.claim.std_model_core.bool_fact_lookup


import v4.std.logic {
  Bool,
  bool_encoding_fact_node,
  bool_primitive_facts,
  bool_width_fact_node
}
import v4.std.node { Node, content_hash }
import v4.std.witness { Holds, Violates, Witness }
import v4.std.model_core {
  ModelCoreFactAxisEncoding,
  ModelCoreFactAxisSignedness,
  ModelCoreFactAxisWidth,
  model_core_wave1_bool_fact_lookup
}



import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
fn bool_lookup_width_ok(vw: Node) -> Bool {
  content_hash(n: vw) == content_hash(n: bool_width_fact_node(width: bool_primitive_facts.width))
}


fn bool_lookup_encoding_ok(ve: Node) -> Bool {
  content_hash(n: ve) == content_hash(n: bool_encoding_fact_node(encoding: bool_primitive_facts.encoding))
}


fn bool_lookup_facts_ok(vw: Node, ve: Node) -> Bool {
  bool_lookup_width_ok(vw: vw) && bool_lookup_encoding_ok(ve: ve)
}


fn bool_lookup_signed_fails_closed(w: Witness<Node>) -> Bool {
  match w {
    Violates { diagnostic: _ } => true
    Holds { value: _ } => false
  }
}


test fn witness_model_core_bool_fact_lookup_discriminates() -> Bool {
  let w_width = model_core_wave1_bool_fact_lookup(
    facts: bool_primitive_facts,
    axis: discriminant(v: ModelCoreFactAxisWidth {})
  )
  let w_enc = model_core_wave1_bool_fact_lookup(
    facts: bool_primitive_facts,
    axis: discriminant(v: ModelCoreFactAxisEncoding {})
  )
  let w_signed = model_core_wave1_bool_fact_lookup(
    facts: bool_primitive_facts,
    axis: discriminant(v: ModelCoreFactAxisSignedness {})
  )
  match w_width {
    Holds { value: vw } => match w_enc {
      Holds { value: ve } => bool_lookup_facts_ok(vw: vw, ve: ve) && bool_lookup_signed_fails_closed(w: w_signed)
      Violates { diagnostic: _ } => false
    }
    Violates { diagnostic: _ } => false
  }
}

// Consolidation #4553 Phase 2 distributed BoolWitnessClaim marker.
// Co-located with `witness_model_core_bool_fact_lookup_discriminates` so glob discovery finds the witness without the central roster.