module v4.test.claim.layering_imports.scanner.dsl_extdeps_v4_exact

import v4.lens.layering_imports {
  LayerExtdeps,
  LayeringImportViolation,
  layering_imports_exact_violation_holds
}
import v4.std.logic { Bool }
import v4.test.claim.workflow.host_layering_import_manifest { host_layer_import_facts }

fn scanner_dsl_extdeps_v4_exact_detects_holds() -> Bool {
  layering_imports_exact_violation_holds(
    facts: host_layer_import_facts,
    expected: LayeringImportViolation {
      layer: LayerExtdeps,
      path: "dsl/extdeps/_perturb_scanner_dsl_extdeps_v4_exact.dag",
      import_module: "v4.compiler"
    }
  )
}
