// Scope: scanner-execution receipt — host manifest from layering_imports_scan must
//        flag src/v4/std planted v4.compiler.* prefix import.
// Status: 🟡 DRAFT-until-signed — zesty signs load-bearing witness receipts.

module v4.test.claim.layering_imports.scanner.std_v4_prefix

import v4.lens.layering_imports {
  LayerStd,
  LayeringImportViolation,
  layering_imports_exact_violation_holds
}
import v4.std.logic { Bool }
import v4.test.claim.workflow.host_layering_import_manifest { host_layer_import_facts }

fn scanner_std_v4_prefix_detects_holds() -> Bool {
  layering_imports_exact_violation_holds(
    facts: host_layer_import_facts,
    expected: LayeringImportViolation {
      layer: LayerStd,
      path: "src/v4/std/_perturb_scanner_std_v4_prefix.dag",
      import_module: "v4.compiler.tokenize"
    }
  )
}
