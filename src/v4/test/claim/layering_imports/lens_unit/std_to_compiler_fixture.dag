module v4.test.claim.layering_imports.lens_unit.std_to_compiler_fixture

import v4.lens.layering_imports {
  LayerImportFact,
  LayerStd,
  LayeringImportViolation,
  layering_imports_exact_violation_holds
}
import v4.std.collection { List }
import v4.std.logic { Bool }

data std_to_compiler_fixture_facts: List<LayerImportFact> = [
  LayerImportFact {
    layer: LayerStd,
    path: "src/v4/std/_perturb_layering_std_to_compiler.dag",
    import_module: "v4.compiler.tokenize"
  }
]

fn detects_std_to_compiler_import_holds() -> Bool {
  layering_imports_exact_violation_holds(
    facts: std_to_compiler_fixture_facts,
    expected: LayeringImportViolation {
      layer: LayerStd,
      path: "src/v4/std/_perturb_layering_std_to_compiler.dag",
      import_module: "v4.compiler.tokenize"
    }
  )
}
