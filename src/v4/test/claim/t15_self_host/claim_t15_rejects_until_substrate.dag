// src/v4/test/claim/t15_self_host/claim_t15_rejects_until_substrate.dag
// Scope: T-15 scaffold claim — runner fails closed until T-22/T-34 and candidate generation land.
// Owns: claim_t15_rejects_until_substrate.
// Consumes: v4.compiler.t15_self_host, v4.std.verification, v4.std.diagnostic, v4.std.node.
// Status: scaffold-against-contract; execution deferred to T-22/T-34.

module v4.test.claim.t15_self_host.claim_t15_rejects_until_substrate

import v4.compiler.t15_self_host {
  PromotionWitness,
  SourceModels,
  self_host_fixed_point_validate,
  t15_runner_not_realized_diagnostic
}
import v4.compiler.eval {
  Verdict,
  run_node_assert
}
import v4.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  diagnostics_singleton
}
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.verification {
  DiagnosticAssert,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration
}


data t15_rejects_until_substrate_subject_symbol: Symbol = t15_rejects_until_substrate_subject_symbol


data t15_rejects_until_substrate_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: t15_rejects_until_substrate_subject_symbol } },
  children: []
}


data t15_rejects_until_substrate_source_models: SourceModels = SourceModels {
  model_corpus: []
}


data t15_runner_scaffold_result: Outcome<PromotionWitness> = self_host_fixed_point_validate(
  stage1_candidate: t15_rejects_until_substrate_subject,
  source_models: t15_rejects_until_substrate_source_models,
  reference_stage1: t15_rejects_until_substrate_subject
)


fn t15_runner_scaffold_actual() -> Outcome<Node> {
  match t15_runner_scaffold_result {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: _, diagnostics: d } =>
      Accepted { value: t15_rejects_until_substrate_subject, diagnostics: d }
  }
}


data claim_t15_rejects_until_substrate: TestClaim = TestClaim {
  kind: DiagnosticAssert,
  label: "t15 self-host fixed-point runner rejects until execution substrate lands",
  t19_anchor: T19ManualAnchorAbsent,
  input: t15_rejects_until_substrate_subject,
  expected: Rejected {
    diagnostics: diagnostics_singleton(d: t15_runner_not_realized_diagnostic())
  },
  classification: TestClassification { tier: Tier1, layer: Integration }
}


data verdict_t15_rejects_until_substrate: Verdict<Node> = run_node_assert(
  kind: claim_t15_rejects_until_substrate.kind,
  actual: t15_runner_scaffold_actual(),
  expected: claim_t15_rejects_until_substrate.expected,
  input: claim_t15_rejects_until_substrate.input
)
