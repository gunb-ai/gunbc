module v4.test.claim.t15_self_host.claim_t15_runner_compiles

import v4.compiler.t15_self_host {
  SourceModels,
  self_host_fixed_point_validate
}
import v4.std.diagnostic { Accepted, None, Outcome }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.verification {
  Compiles,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration
}
import v4.std.witness { PromotionWitness }


data t15_runner_compiles_subject_symbol: Symbol = t15_runner_compiles_subject_symbol


data t15_runner_compiles_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: t15_runner_compiles_subject_symbol } },
  children: []
}


data t15_runner_empty_source_models: SourceModels = SourceModels {
  model_corpus: []
}

data t15_runner_shape_result: Outcome<PromotionWitness> = self_host_fixed_point_validate(
  stage1_candidate: t15_runner_compiles_subject,
  source_models: t15_runner_empty_source_models,
  reference_stage1: t15_runner_compiles_subject
)


data claim_t15_runner_compiles: TestClaim = TestClaim {
  kind: Compiles,
  label: "t15 self-host fixed-point runner shape compiles",
  t19_anchor: T19ManualAnchorAbsent,
  input: t15_runner_compiles_subject,
  expected: Accepted { value: t15_runner_compiles_subject, diagnostics: None },
  classification: TestClassification { tier: Tier1, layer: Integration }
}
