// src/v4/test/claim/lens_synthesis/factorial_dominates_exponential.dag
// Scope: T-17 worked claim — factorial symbolic cost dominates exponential lower bound.
// Owns: claim_factorial_dominates_exponential.
// Consumes: lens cost, std node, std verification.
// Status: scaffold — compile-only until T-17 synthesis lens lands.

module v4.test.claim.lens_synthesis.factorial_dominates_exponential

import v4.lens.cost {
  ExponentialBase,
  ExponentialCost,
  FactorialCost,
  SizeVariable,
  symbolic_cost_dominates
}
import v4.std.cardinality { NonZeroNat }
import v4.std.logic { Bool }
import v4.std.nat { Zero }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  Tier1,
  Unit,
  t19_manual_claim_anchor
}

data synthesis_fact_x_symbol: Symbol = synthesis_fact_x_symbol

data synthesis_fact_x: Node = Node {
  kind: TypeNode { connective: Atom { identity: synthesis_fact_x_symbol } },
  children: []
}

fn factorial_dominates_exponential_claim_holds() -> Bool {
  symbolic_cost_dominates(
    a: FactorialCost { variable: SizeVariable { source: synthesis_fact_x } },
    b: ExponentialCost {
      variable: SizeVariable { source: synthesis_fact_x },
      base: ExponentialBase { predecessor_after_one: NonZeroNat { prev: Zero } }
    }
  )
}

fn factorial_dominates_exponential_claim_rhs() -> Node {
  if factorial_dominates_exponential_claim_holds() {
    synthesis_fact_x
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_factorial_dominates_exponential: TestClaim = EqualsClaim {
  label: "lens_synthesis/factorial_dominates_exponential: factorial dominates exponential",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  lhs: synthesis_fact_x,
  rhs: factorial_dominates_exponential_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
