// src/v4/test/claim/lens_synthesis/factorial_dominates_exponential.dag
// Scope: T-17 worked claim — factorial symbolic cost dominates exponential lower bound.
// Owns: factorial_dominates_exponential_claim.
// Consumes: lens cost (synthesis compare substrate until synthesis.dag fills).
// Status: scaffold — compile-only until T-17 synthesis lens lands.

module v4.test.claim.lens_synthesis.factorial_dominates_exponential

import v4.lens.cost {
  ExponentialBase,
  ExponentialCost,
  FactorialCost,
  SizeVariable,
  SymbolicCost,
  symbolic_cost_dominates
}
import v4.std.cardinality { NonZeroNat }
import v4.std.logic { Bool }
import v4.std.nat { Zero }
import v4.std.node { Atom, Node, Symbol, TypeNode }

data synthesis_fact_x_symbol: Symbol = synthesis_fact_x_symbol

type LensSynthesisDominanceClaim {
  realization: SymbolicCost
  lower_bound: SymbolicCost
  expected_dominates: Bool
}

data synthesis_fact_x: Node = Node {
  kind: TypeNode { connective: Atom { identity: synthesis_fact_x_symbol } },
  children: []
}

data factorial_dominates_exponential_claim: LensSynthesisDominanceClaim = LensSynthesisDominanceClaim {
  realization: FactorialCost { variable: SizeVariable { source: synthesis_fact_x } },
  lower_bound: ExponentialCost {
    variable: SizeVariable { source: synthesis_fact_x },
    base: ExponentialBase { predecessor_after_one: NonZeroNat { prev: Zero } }
  },
  expected_dominates: true
}

fn factorial_dominates_exponential_claim_holds() -> Bool {
  symbolic_cost_dominates(
    a: factorial_dominates_exponential_claim.realization,
    b: factorial_dominates_exponential_claim.lower_bound
  ) == factorial_dominates_exponential_claim.expected_dominates
}

data factorial_dominates_exponential_claim_passes: Bool = factorial_dominates_exponential_claim_holds()
