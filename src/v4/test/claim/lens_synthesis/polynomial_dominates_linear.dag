// src/v4/test/claim/lens_synthesis/polynomial_dominates_linear.dag
// Scope: T-17 worked claim — quadratic symbolic cost dominates linear lower bound.
// Status: T-17 filled — cost-lattice prerequisite (symbolic_cost_dominates).

module v4.test.claim.lens_synthesis.polynomial_dominates_linear

import v4.lens.cost {
  LinearCost,
  PolynomialCost,
  PolynomialDegree,
  SizeVariable,
  symbolic_cost_dominates
}
import v4.std.cardinality { NonZeroNat }
import v4.std.logic { Bool }
import v4.std.nat { Zero }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode, substrate_synthetic_occurrence_id }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
data synthesis_poly_x: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_poly_x_symbol } },
  children: [],
  occurrence_id: substrate_synthetic_occurrence_id
}

data synthesis_poly_y: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^synthesis_poly_y_symbol } },
  children: [],
  occurrence_id: substrate_synthetic_occurrence_id
}

fn polynomial_dominates_linear_claim_holds() -> Bool {
  symbolic_cost_dominates(
    a: PolynomialCost {
      variable: SizeVariable { source: synthesis_poly_x },
      degree: PolynomialDegree { predecessor_after_linear: NonZeroNat { prev: Zero } }
    },
    b: LinearCost { variable: SizeVariable { source: synthesis_poly_y } }
  )
}

fn polynomial_dominates_linear_claim_rhs() -> Node {
  if polynomial_dominates_linear_claim_holds() {
    synthesis_poly_x
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: substrate_synthetic_occurrence_id
}
  }
}

data claim_polynomial_dominates_linear: TestClaim = EqualsClaim {
  label: "lens_synthesis/polynomial_dominates_linear: quadratic dominates linear",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: synthesis_poly_x,
  rhs: polynomial_dominates_linear_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
