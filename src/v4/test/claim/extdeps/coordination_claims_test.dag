// src/v4/test/claim/extdeps/coordination_claims.dag
// Scope: v4.extdeps.coordination WIRECONTRACT-OBLIGATION-TABLE-T4.8 as
// discriminating claim-run witnesses, routed through v2 (`dag run --claim-run`).
//
// These witnesses migrate the EXECUTABLE behavioral content of
// src/v3/compiler/tests/integration/v4_extdeps_coordination_dag_smoke_test.rs's
// `wire_contract_uses_decomposed_facts` obligation-table assertions from frozen-v3
// host source-greps (which only matched the function body spelling) into `fn -> Bool`
// witnesses that EXECUTE `coordination_effect_obligation` and DISCRIMINATE on the
// per-effect mapping: each effect maps to its own exchange/settlement obligation and
// is arm-sharp (a different effect's obligation does NOT match). Mutating any obligation
// arm in coordination.dag turns a witness red, so the green is not vacuous.
//
// Status: Wave-A (iii) A-fold-delete. The obligation-table behavioral assertions in the
// .rs smoke are deleted in the same PR (their content is proven here by execution). The
// remaining B-class receipts (WireContractFacts/WireContract record-field shapes,
// SettlementGuarantee/ConsistencyGuarantee shared-discriminant) were deleted with the smoke
// file per the white-box sweep. Reflection stays banned outside the scoped lift
// ratified in gunbc#4861 (compile-time closed-coproduct projection + gate-covered fail-closed
// only; inline scope bound here is authoritative); decl-shape mirrors remain 2FA-for-code elsewhere.
// Importing v4.extdeps.coordination forces v2 to tokenize/parse/infer it, so the
// parse-surface fact rides every witness below.

module v4.test.claim.extdeps.coordination_claims


import v4.std.logic { Bool }
import v4.extdeps.coordination {
  ExchangePattern,
  FireAndForget,
  Http,
  ImmediateSettlement,
  PubSub,
  PublishSubscribe,
  Queue,
  RequiredSettleBound,
  RequestReply,
  SettlementGuarantee,
  SettlesWithin,
  Stream,
  StreamExchange,
  coordination_effect_obligation
}



import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
fn coord_not(b: Bool) -> Bool {
  b == false
}


// ExchangePattern arm probes (one per variant; a wrong stored variant fails its probe).
fn exchange_is_request_reply(e: ExchangePattern) -> Bool {
  match e {
    RequestReply => true
    _ => false
  }
}

fn exchange_is_fire_and_forget(e: ExchangePattern) -> Bool {
  match e {
    FireAndForget => true
    _ => false
  }
}

fn exchange_is_stream(e: ExchangePattern) -> Bool {
  match e {
    StreamExchange => true
    _ => false
  }
}

fn exchange_is_publish_subscribe(e: ExchangePattern) -> Bool {
  match e {
    PublishSubscribe => true
    _ => false
  }
}


// SettlementGuarantee<RequiredSettleBound> arm probes.
fn settlement_is_immediate(s: SettlementGuarantee<RequiredSettleBound>) -> Bool {
  match s {
    ImmediateSettlement => true
    _ => false
  }
}

fn settlement_is_within(s: SettlementGuarantee<RequiredSettleBound>) -> Bool {
  match s {
    SettlesWithin { bound: _ } => true
    _ => false
  }
}


// Receipt A1 (obligation exchange table is arm-sharp): every CoordinationEffectKind maps to
// its own ExchangePattern AND the table is not a constant — Http's exchange is NOT Queue's.
// Discriminates: mutate any arm's required_exchange in coordination.dag → this goes red.
test fn coordination_obligation_exchange_arm_sharp_holds() -> Bool {
  exchange_is_request_reply(e: coordination_effect_obligation(effect: Http).required_exchange)
    && exchange_is_fire_and_forget(e: coordination_effect_obligation(effect: Queue).required_exchange)
    && exchange_is_stream(e: coordination_effect_obligation(effect: Stream).required_exchange)
    && exchange_is_publish_subscribe(e: coordination_effect_obligation(effect: PubSub).required_exchange)
    && coord_not(b: exchange_is_fire_and_forget(e: coordination_effect_obligation(effect: Http).required_exchange))
}


// Receipt A2 (obligation settlement discriminant is arm-sharp): Http settles immediately,
// the async effects (Queue/Stream/PubSub) settle-within; the negative arms pin that the
// discriminant tracks the effect, not a constant.
test fn coordination_obligation_settlement_arm_sharp_holds() -> Bool {
  settlement_is_immediate(s: coordination_effect_obligation(effect: Http).required_settlement)
    && settlement_is_within(s: coordination_effect_obligation(effect: Queue).required_settlement)
    && settlement_is_within(s: coordination_effect_obligation(effect: Stream).required_settlement)
    && settlement_is_within(s: coordination_effect_obligation(effect: PubSub).required_settlement)
    && coord_not(b: settlement_is_within(s: coordination_effect_obligation(effect: Http).required_settlement))
    && coord_not(b: settlement_is_immediate(s: coordination_effect_obligation(effect: Queue).required_settlement))
}

