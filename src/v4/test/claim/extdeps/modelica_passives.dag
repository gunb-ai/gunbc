// src/v4/test/claim/extdeps/modelica_passives.dag
// Scope: wave-1 Modelica acausal passive substrate compile + structural witnesses.

module v4.test.claim.extdeps.modelica_passives

import v4.std.logic { Bool }
import v4.extdeps.formats.modelica {
  CapacitorInstance,
  ConnectEquation,
  InductorInstance,
  ModelicaEquationSection,
  ModelicaModel,
  ModelicaValue,
  PassiveComponent,
  PinEndpoint,
  ResistorInstance,
  TwoPinConnectorDecl,
  modelica_emit_resistor_line,
  modelica_format_grammar_probe,
  modelica_two_pin_connector_default,
  modelica_wave1_emit_matches_fixture_holds,
  modelica_wave1_string_eq,
  modelica_wave1_witness_resistor
}
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn modelica_resistor_instance_carries_two_pin_connectors_holds() -> Bool {
  let component = ResistorInstance {
    name: ^r1,
    R: ModelicaValue { lexeme: "1000" },
    connectors: modelica_two_pin_connector_default
  }
  match component {
    ResistorInstance { name: _, R: _, connectors: ports } =>
      ports.p == ^p && ports.n == ^n
    _ => false
  }
}

fn modelica_connect_equation_binds_pin_endpoints_holds() -> Bool {
  let equation = ConnectEquation {
    left: PinEndpoint { instance: ^r1, pin: ^p },
    right: PinEndpoint { instance: ^c1, pin: ^n }
  }
  match equation {
    ConnectEquation { left: left, right: right } =>
      left.instance == ^r1 && right.instance == ^c1
    _ => false
  }
}

fn modelica_passive_model_carries_equation_section_holds() -> Bool {
  let model = ModelicaModel {
    name: ^rc,
    components: [
      ResistorInstance {
        name: ^r1,
        R: ModelicaValue { lexeme: "1000" },
        connectors: modelica_two_pin_connector_default
      },
      CapacitorInstance {
        name: ^c1,
        C: ModelicaValue { lexeme: "1e-6" },
        connectors: modelica_two_pin_connector_default
      }
    ],
    equations: ModelicaEquationSection {
      connects: [
        ConnectEquation {
          left: PinEndpoint { instance: ^r1, pin: ^p },
          right: PinEndpoint { instance: ^c1, pin: ^p }
        }
      ]
    }
  }
  match model {
    ModelicaModel { name: _, components: comps, equations: eqs } =>
      comps == [
        ResistorInstance {
          name: ^r1,
          R: ModelicaValue { lexeme: "1000" },
          connectors: modelica_two_pin_connector_default
        },
        CapacitorInstance {
          name: ^c1,
          C: ModelicaValue { lexeme: "1e-6" },
          connectors: modelica_two_pin_connector_default
        }
      ] && eqs.connects == [
        ConnectEquation {
          left: PinEndpoint { instance: ^r1, pin: ^p },
          right: PinEndpoint { instance: ^c1, pin: ^p }
        }
      ]
    _ => false
  }
}

data claim_modelica_resistor_two_pin_connectors: TestClaim = BoolWitnessClaim {
  label: "extdeps/modelica: ResistorInstance carries default p/n connectors",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: modelica_resistor_instance_carries_two_pin_connectors_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_modelica_connect_equation_endpoints: TestClaim = BoolWitnessClaim {
  label: "extdeps/modelica: ConnectEquation binds PinEndpoint instances",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: modelica_connect_equation_binds_pin_endpoints_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_modelica_passive_model_equation_section: TestClaim = BoolWitnessClaim {
  label: "extdeps/modelica: ModelicaModel carries passive components + connect section",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: modelica_passive_model_carries_equation_section_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_modelica_module_compiles: TestClaim = CompilesClaim {
  label: "extdeps/modelica: acausal passive substrate + wave-1 grammar probe compile",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: modelica_format_grammar_probe(),
  expected_value: modelica_format_grammar_probe(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_modelica_wave1_emit_matches_fixture: TestClaim = BoolWitnessClaim {
  label: "extdeps/modelica: wave-1 resistor emit matches grammar fixture",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: modelica_wave1_emit_matches_fixture_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}
