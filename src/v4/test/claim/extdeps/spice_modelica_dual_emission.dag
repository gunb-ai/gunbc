// src/v4/test/claim/extdeps/spice_modelica_dual_emission.dag
// Scope: B2-OMNI paradigm falsifier — the SAME R1 resistor data drives BOTH
//        `spice_emit_resistor_line` (ngspice causal netlist) AND
//        `modelica_emit_resistor_line` (Modelica acausal declaration).
//        Both emit functions are called on the same R1 identity; outputs
//        compared against expected strings. T-4.10.
//
// Gap note: the full paradigm probe (shared circuit carrier → both emitters)
//   requires a `std/analog` circuit substrate layer that does not exist yet.
//   This witness is the minimal honest slice: both emit functions produce
//   confirmed output for the same R1 identity. A shared `Circuit` type
//   bridging SPICE `NodeRef` topology and Modelica `ConnectEquation` algebra
//   is the next dissolution step.

module v4.test.claim.extdeps.spice_modelica_dual_emission

import v4.std.logic { Bool }
import v4.std.node { Symbol }
import v4.extdeps.formats.spice {
  Component,
  NamedNode,
  NodeRef,
  SpiceValue,
  spice_emit_resistor_line,
  spice_wave1_string_eq
}
import v4.extdeps.formats.modelica {
  ModelicaValue,
  PassiveComponent,
  modelica_emit_resistor_line,
  modelica_wave1_string_eq,
  modelica_two_pin_connector_default
}
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


// Shared resistor identity — the same component modeled in both paradigms.
data dual_emission_resistor_name: Symbol = ^r1
data dual_emission_resistor_value_lexeme: String = "1000"

// Expected outputs for each paradigm (different surface languages, same circuit).
data dual_emission_spice_expected_line: String = "R1 n1 n2 1000"
data dual_emission_modelica_expected_line: String = "Resistor R1 ( R = 1000 ) ;"


// SPICE side: causal node graph — topology via shared NodeRef names.
data dual_emission_spice_resistor: Component = Resistor {
  name: dual_emission_resistor_name,
  n_plus: Named { node: NamedNode { name: ^n1 } },
  n_minus: Named { node: NamedNode { name: ^n2 } },
  value: SpiceValue { lexeme: dual_emission_resistor_value_lexeme }
}

// Modelica side: acausal connector algebra — topology via ConnectEquation.
data dual_emission_modelica_resistor: PassiveComponent = ResistorInstance {
  name: dual_emission_resistor_name,
  R: ModelicaValue { lexeme: dual_emission_resistor_value_lexeme },
  connectors: modelica_two_pin_connector_default
}


// Dual-emission probe 1: SPICE causal emit produces expected ngspice netlist line.
fn dual_emission_spice_emit_holds() -> Bool {
  spice_wave1_string_eq(
    a: spice_emit_resistor_line(component: dual_emission_spice_resistor),
    b: dual_emission_spice_expected_line
  )
}

// Dual-emission probe 2: Modelica acausal emit produces expected declaration line.
fn dual_emission_modelica_emit_holds() -> Bool {
  modelica_wave1_string_eq(
    a: modelica_emit_resistor_line(component: dual_emission_modelica_resistor),
    b: dual_emission_modelica_expected_line
  )
}

// Dual-emission keystone: both emit functions produce confirmed output for the
// same R1 identity. This exercises the actual emit paths, not just construction.
fn dual_emission_spice_and_modelica_both_hold() -> Bool {
  dual_emission_spice_emit_holds() && dual_emission_modelica_emit_holds()
}


data claim_dual_emission_spice_emit: TestClaim = BoolWitnessClaim {
  label: "extdeps/dual-emission: R1 SPICE emit → ngspice netlist line",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: dual_emission_spice_emit_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_dual_emission_modelica_emit: TestClaim = BoolWitnessClaim {
  label: "extdeps/dual-emission: R1 Modelica emit → acausal declaration line",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: dual_emission_modelica_emit_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_dual_emission_keystone: TestClaim = BoolWitnessClaim {
  label: "extdeps/dual-emission: same R1 identity drives both SPICE emit + Modelica emit",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: dual_emission_spice_and_modelica_both_hold() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}
