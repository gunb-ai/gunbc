// src/v4/test/claim/lens_ownership/borrowed_dependency.dag
// Scope: T-13 worked claim — BindsTo classifies as BorrowedDependency over `ClassifiedDependencyView<OwnershipMode>`.
// Owns: ownership_borrowed_dependency_claim.
// Consumes: lens ownership, std dependency, lens_common fixture.
// Status: T-13 family-ratchet claim shape (Phase-1 substrate migration).


module v4.test.claim.lens_ownership.borrowed_dependency

import v4.compiler.infer { InferredFacts, InferredTree }
import v4.lens.ownership {
  BorrowedDependency,
  OwnershipFact,
  ownership_fact_eq,
  ownership_witness
}
import v4.std.dependency {
  BindsTo,
  ClassifiedDependencyView,
  DependencyView
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Edge, Named, Node, Symbol, TypeNode }
import v4.std.witness { Holds, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data ownership_bd_root_symbol: Symbol = ownership_bd_root_symbol
data ownership_bd_child_symbol: Symbol = ownership_bd_child_symbol
data ownership_bd_edge_symbol: Symbol = ownership_bd_edge_symbol
data ownership_bd_type_symbol: Symbol = ownership_bd_type_symbol
data ownership_bd_algebra_symbol: Symbol = ownership_bd_algebra_symbol
data ownership_bd_algebra_witness_symbol: Symbol = ownership_bd_algebra_witness_symbol
data ownership_bd_descent_symbol: Symbol = ownership_bd_descent_symbol
data ownership_bd_canonical_structural_symbol: Symbol = ownership_bd_canonical_structural_symbol
data ownership_bd_canonical_closedness_symbol: Symbol = ownership_bd_canonical_closedness_symbol
data ownership_bd_canonical_evidence_symbol: Symbol = ownership_bd_canonical_evidence_symbol

data ownership_bd_child: Node = claim_atom_node(s: ownership_bd_child_symbol)

data ownership_bd_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ownership_bd_root_symbol } },
  children: [
    Edge { label: Named { name: ownership_bd_edge_symbol }, target: ownership_bd_child }
  ]
}

data ownership_bd_dependency: DependencyView = DependencyView {
  source: ownership_bd_root,
  dependent: ownership_bd_child,
  kind: BindsTo,
  usage_site: ownership_bd_child
}

fn ownership_bd_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ownership_bd_type_symbol,
    algebra_symbol: ownership_bd_algebra_symbol,
    algebra_witness_symbol: ownership_bd_algebra_witness_symbol,
    descent_symbol: ownership_bd_descent_symbol,
    canonical_structural_symbol: ownership_bd_canonical_structural_symbol,
    canonical_closedness_symbol: ownership_bd_canonical_closedness_symbol,
    canonical_evidence_symbol: ownership_bd_canonical_evidence_symbol
  )
}

fn ownership_bd_claim_tree() -> InferredTree {
  claim_inferred_tree(root: ownership_bd_root, facts: ownership_bd_claim_facts())
}

type LensOwnershipBorrowedDependencyClaim {
  input: InferredTree
  expected: OwnershipFact
  actual: Witness<OwnershipFact>
}

data ownership_borrowed_dependency_claim: LensOwnershipBorrowedDependencyClaim = LensOwnershipBorrowedDependencyClaim {
  input: ownership_bd_claim_tree(),
  expected: OwnershipFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: ownership_bd_dependency,
        classification: BorrowedDependency
      }
    ]
  },
  actual: ownership_witness(tree: ownership_bd_claim_tree(), dependencies: [ownership_bd_dependency])
}

fn ownership_borrowed_dependency_claim_holds() -> Bool {
  match ownership_borrowed_dependency_claim.actual {
    Holds { value: actual } =>
      ownership_fact_eq(a: actual, b: ownership_borrowed_dependency_claim.expected)
    _ => false
  }
}

data ownership_borrowed_dependency_claim_passes: Bool = ownership_borrowed_dependency_claim_holds()
