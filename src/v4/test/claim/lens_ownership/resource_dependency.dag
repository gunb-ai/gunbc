// src/v4/test/claim/lens_ownership/resource_dependency.dag
// Scope: T-13 worked claim — ResourceDependsOn classifies as RequiresAccessWitness; witness envelope is Violates (fail-closed slot) while projection fact matches expected.
// Status: T-38B — subject roster + run_test_claim + family receipt over eval_mvp2 runtime wedge.


module v4.test.claim.lens_ownership.resource_dependency

import v4.compiler.infer { InferredFacts, InferredTree }
import v4.compiler.eval {
  TestClaimEvalSubject,
  TestClaimRun,
  eval_test_claim_subject,
  run_test_claim_assert,
  run_test_claim
}
import v4.lens.ownership {
  OwnershipFact,
  RequiresAccessWitness,
  ownership_fact,
  ownership_fact_eq,
  ownership_witness
}
import v4.std.dependency {
  ClassifiedDependencyView,
  DependencyView,
  ResourceDependsOn
}
import v4.std.diagnostic { Accepted, None }
import v4.std.logic { Bool }
import v4.std.node { Atom, Edge, Named, Node, Symbol, TypeNode }
import v4.std.runtime { RuntimeValue }
import v4.std.verification {
  ManualAnchorAbsent,
  TestClassification,
  TestClaim,
  Tier1,
  Integration,
  EqualsClaim,
  manual_claim_anchor
}
import v4.std.verdict { Verdict }
import v4.std.witness { Violates, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}
import v4.test.claim.manual.eval_runtime_mvp {
  eval_mvp2_add_subgraph,
  eval_mvp2_context,
  eval_mvp2_evaluator_pin,
  eval_mvp2_five_literal_node,
  eval_mvp2_inferred_tree
}

data ownership_root_symbol: Symbol = ownership_root_symbol
data ownership_child_symbol: Symbol = ownership_child_symbol
data ownership_edge_symbol: Symbol = ownership_edge_symbol
data ownership_type_symbol: Symbol = ownership_type_symbol
data ownership_algebra_symbol: Symbol = ownership_algebra_symbol
data ownership_descent_symbol: Symbol = ownership_descent_symbol
data ownership_claim_pass_symbol: Symbol = ownership_claim_pass_symbol
data ownership_claim_fail_symbol: Symbol = ownership_claim_fail_symbol
data ownership_child: Node = claim_atom_node(s: ownership_child_symbol)

data ownership_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ownership_root_symbol } },
  children: [
    Edge { label: Named { name: ownership_edge_symbol }, target: ownership_child }
  ]
}

data ownership_dependency: DependencyView = DependencyView {
  source: ownership_root,
  dependent: ownership_child,
  kind: ResourceDependsOn,
  usage_site: ownership_child
}

fn ownership_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: ownership_type_symbol,
    algebra_symbol: ownership_algebra_symbol,
    descent_symbol: ownership_descent_symbol,
  )
}

fn ownership_claim_tree() -> InferredTree {
  claim_inferred_tree(root: ownership_root, facts: ownership_claim_facts())
}

type LensOwnershipClaim {
  input: InferredTree
  expected: OwnershipFact
  actual: Witness<OwnershipFact>
}

data ownership_resource_dependency_claim: LensOwnershipClaim = LensOwnershipClaim {
  input: ownership_claim_tree(),
  expected: OwnershipFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: ownership_dependency,
        classification: RequiresAccessWitness
      }
    ]
  },
  actual: ownership_witness(tree: ownership_claim_tree(), dependencies: [ownership_dependency])
}

fn ownership_resource_dependency_claim_holds() -> Bool {
  match ownership_resource_dependency_claim.actual {
    Violates { diagnostic: _ } =>
      ownership_fact_eq(
        a: ownership_fact(
          tree: ownership_resource_dependency_claim.input,
          dependencies: [ownership_dependency]
        ),
        b: ownership_resource_dependency_claim.expected
      )
    _ => false
  }
}

data ownership_resource_dependency_claim_passes: Bool = ownership_resource_dependency_claim_holds()

fn ownership_claim_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ownership_claim_pass_symbol } },
    children: []
  }
}

fn ownership_claim_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ownership_claim_fail_symbol } },
    children: []
  }
}

fn ownership_claim_input(ok: Bool) -> Node {
  if ok {
    ownership_claim_pass_node()
  } else {
    ownership_claim_fail_node()
  }
}

data claim_ownership_resource_dependency_receipt: TestClaim = EqualsClaim {
  label: "lens_ownership resource dependency witness classifies ResourceDependsOn as RequiresAccessWitness",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ownership_claim_input(ok: ownership_resource_dependency_claim_passes),
  rhs: ownership_claim_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data verdict_ownership_resource_dependency_node_assert: Verdict<TestClaimEvalSubject<Node>, Node> = run_test_claim_assert(
  claim: claim_ownership_resource_dependency_receipt,
  actual: Accepted {
    value: ownership_claim_input(ok: ownership_resource_dependency_claim_passes),
    diagnostics: None
  },
  at: ownership_claim_pass_node()
)

fn ownership_executable_claim_input(ok: Bool) -> Node {
  if ok {
    eval_mvp2_add_subgraph()
  } else {
    ownership_claim_fail_node()
  }
}

data claim_ownership_resource_dependency_run_test_claim_receipt: TestClaim = EqualsClaim {
  label: "lens_ownership resource dependency witness gates run_test_claim executable receipt",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ownership_executable_claim_input(ok: ownership_resource_dependency_claim_passes),
  rhs: eval_mvp2_five_literal_node(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}

data subject_ownership_resource_dependency_receipt: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_ownership_resource_dependency_run_test_claim_receipt,
  context: eval_mvp2_context(),
  tree: eval_mvp2_inferred_tree(),
  evaluator_pin: eval_mvp2_evaluator_pin
)

data run_ownership_resource_dependency_receipt: TestClaimRun<Node, RuntimeValue> = run_test_claim(
  subject: subject_ownership_resource_dependency_receipt
)
