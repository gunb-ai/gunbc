// src/v4/test/claim/lens_ownership/resource_dependency.dag
// Scope: T-13 worked claim — ResourceDependsOn projects to exclusive mutation.
// Owns: ownership_resource_dependency_claim.
// Consumes: lens ownership, compiler infer, std dependency, std node.
// Status: scaffold — compile-only until generated claim execution.

module v4.test.claim.lens_ownership.resource_dependency

import v4.compiler.infer { AlgebraRef, InferredFacts, InferredTree }
import v4.lens.ownership {
  OwnershipFact,
  ownership_fact_eq,
  ownership_fact_from_dependencies,
  ownership_witness
}
import v4.std.cardinality { RankingDimension, TerminationProof }
import v4.std.collection { Map }
import v4.std.dependency { DependencyView, ResourceDependsOn }
import v4.std.node { Atom, Edge, Hash, Named, Node, Symbol, TypeNode }
import v4.std.witness { Holds, Witness }

data ownership_root_symbol: Symbol = ownership_root_symbol
data ownership_child_symbol: Symbol = ownership_child_symbol
data ownership_edge_symbol: Symbol = ownership_edge_symbol
data ownership_type_symbol: Symbol = ownership_type_symbol
data ownership_algebra_symbol: Symbol = ownership_algebra_symbol
data ownership_algebra_witness_symbol: Symbol = ownership_algebra_witness_symbol
data ownership_descent_symbol: Symbol = ownership_descent_symbol
data ownership_claim_hash: Hash = ownership_claim_hash

fn ownership_claim_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}

data ownership_child: Node = ownership_claim_node(s: ownership_child_symbol)

data ownership_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ownership_root_symbol } },
  children: [
    Edge { label: Named { name: ownership_edge_symbol }, target: ownership_child }
  ]
}

data ownership_dependency: DependencyView = DependencyView {
  source: ownership_root,
  dependent: ownership_child,
  kind: ResourceDependsOn,
  usage_site: ownership_child
}

fn ownership_claim_facts() -> InferredFacts {
  InferredFacts {
    resolved_type: ownership_claim_node(s: ownership_type_symbol),
    inhabits: AlgebraRef {
      algebra: ownership_claim_node(s: ownership_algebra_symbol),
      witness: ownership_claim_node(s: ownership_algebra_witness_symbol)
    },
    descent: TerminationProof {
      non_increasing: [],
      strict: RankingDimension { measured: ownership_descent_symbol }
    }
  }
}

fn ownership_claim_fact_map(facts: InferredFacts) -> Map<Node, InferredFacts> {
  Map {
    lookup: fn(_) {
      Holds { value: facts }
    }
  }
}

fn ownership_claim_tree() -> InferredTree {
  let facts = ownership_claim_facts()
  InferredTree {
    root: ownership_root,
    facts: ownership_claim_fact_map(facts: facts)
  }
}

type LensOwnershipClaim {
  input: InferredTree
  expected: OwnershipFact
  actual: Witness<OwnershipFact>
}

data ownership_resource_dependency_claim: LensOwnershipClaim = LensOwnershipClaim {
  input: ownership_claim_tree(),
  expected: ownership_fact_from_dependencies(dependencies: [ownership_dependency]),
  actual: ownership_witness(tree: ownership_claim_tree(), dependencies: [ownership_dependency])
}

fn ownership_resource_dependency_claim_holds() -> Bool {
  match ownership_resource_dependency_claim.actual {
    Holds { value: actual } =>
      ownership_fact_eq(a: actual, b: ownership_resource_dependency_claim.expected)
    _ => false
  }
}

data ownership_resource_dependency_claim_passes: Bool = ownership_resource_dependency_claim_holds()
