// src/v4/test/claim/lens_ownership/subject_roster.dag
// Scope: T-38B lens_ownership family roster — names the ownership subject family and wires a TestClaimEvalSubject row for corpus execution.
// Status: family receipt — one resource-dependency subject, routed through run_test_claim by workflow/lens_ownership_family_eval.dag.

module v4.test.claim.lens_ownership.subject_roster


import v4.compiler.eval {
  TestClaimEvalSubject,
  eval_context_v4_evaluator_wave1,
  eval_test_claim_subject
}
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.test.claim.lens_ownership.resource_dependency {
  ownership_claim_tree,
  ownership_resource_dependency_claim_passes
}


data lens_ownership_resource_dependency_pin: Symbol = lens_ownership_resource_dependency_pin
data claim_lens_ownership_resource_dependency_id: Symbol = claim_lens_ownership_resource_dependency
data lens_ownership_claim_pass_symbol: Symbol = lens_ownership_claim_pass_symbol
data lens_ownership_claim_fail_symbol: Symbol = lens_ownership_claim_fail_symbol


fn ownership_claim_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: lens_ownership_claim_pass_symbol } },
    children: []
  }
}


fn ownership_claim_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: lens_ownership_claim_fail_symbol } },
    children: []
  }
}


fn ownership_claim_input(ok: Bool) -> Node {
  if ok {
    ownership_claim_pass_node()
  } else {
    ownership_claim_fail_node()
  }
}


type LensOwnershipSubject {
  claim_id: Symbol
  structural_witness: Bool
  eval_subject: TestClaimEvalSubject<Node>
}


data claim_lens_ownership_resource_dependency: TestClaim = EqualsClaim {
  label: "lens_ownership resource dependency witness passes through run_test_claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ownership_claim_input(ok: ownership_resource_dependency_claim_passes),
  rhs: ownership_claim_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data subject_lens_ownership_resource_dependency: TestClaimEvalSubject<Node> = eval_test_claim_subject(
  claim: claim_lens_ownership_resource_dependency,
  context: eval_context_v4_evaluator_wave1(),
  tree: ownership_claim_tree(),
  evaluator_pin: lens_ownership_resource_dependency_pin
)


data lens_ownership_subject_roster: List<LensOwnershipSubject> = [
  LensOwnershipSubject {
    claim_id: claim_lens_ownership_resource_dependency_id,
    structural_witness: ownership_resource_dependency_claim_passes,
    eval_subject: subject_lens_ownership_resource_dependency
  }
]


data lens_ownership_node_subject_rows: List<TestClaimEvalSubject<Node>> = map(
  lens_ownership_subject_roster,
  fn(subject) { subject.eval_subject }
)
