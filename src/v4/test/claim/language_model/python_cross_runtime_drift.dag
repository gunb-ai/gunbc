// src/v4/test/claim/language_model/python_cross_runtime_drift.dag
// Scope: PY-L2-CROSS-RUNTIME-DRIFT — positive cross-runtime divergence receipt (complement of
//   the L2 cross-target parity lane). The same modeled program (exact integer add at the
//   fixed-width boundary) diverges: Python arbitrary precision vs Rust i64 / Go int64 wraparound.
// Status: modeled claim + drift probe row; host runner
//   scripts/v4-leaf-model-python-cross-runtime-drift-verify.sh.

module v4.test.claim.language_model.python_cross_runtime_drift

import v4.lens.leaf_model_verification {
  python_cross_runtime_drift_probe,
  python_cross_runtime_drift_python_source,
  python_cross_runtime_drift_rust_source,
  python_cross_runtime_drift_arbitrary_precision_value,
  python_cross_runtime_drift_fixed_width_value
}
import v4.std.leaf_model_verification {
  leaf_model_claim_python_cross_runtime_drift_arbitrary_precision
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Boundary,
  manual_claim_anchor
}

data python_cross_runtime_drift_claim_bool_true: Symbol = python_cross_runtime_drift_claim_bool_true
data python_cross_runtime_drift_claim_bool_false: Symbol = python_cross_runtime_drift_claim_bool_false

fn python_cross_runtime_drift_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: python_cross_runtime_drift_claim_bool_true } }, children: [] }
    false => Node { kind: TypeNode { connective: Atom { identity: python_cross_runtime_drift_claim_bool_false } }, children: [] }
  }
}

// The drift probe wires the modeled claim id to the three target sources, and anchors the expected
// divergence to ValueDiff<String> (expected = arbitrary-precision value, actual = fixed-width value).
data claim_python_cross_runtime_drift_probe_wired: TestClaim = EqualsClaim {
  label: "language_model/python_cross_runtime_drift: probe wires drift claim id + per-target sources + ValueDiff divergence anchor",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_cross_runtime_drift_claim_bool_atom(b: true),
  rhs: python_cross_runtime_drift_claim_bool_atom(
    b: python_cross_runtime_drift_probe().claim_id == leaf_model_claim_python_cross_runtime_drift_arbitrary_precision
      && python_cross_runtime_drift_probe().arbitrary_precision_source == python_cross_runtime_drift_python_source
      && python_cross_runtime_drift_probe().fixed_width_rust_source == python_cross_runtime_drift_rust_source
      && python_cross_runtime_drift_probe().expected_divergence.expected == python_cross_runtime_drift_arbitrary_precision_value
      && python_cross_runtime_drift_probe().expected_divergence.actual == python_cross_runtime_drift_fixed_width_value
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

// The divergence is POSITIVE: the arbitrary-precision value and the fixed-width value differ. A
// receipt that found them equal would mean the verifier failed to detect drift (false parity).
data claim_python_cross_runtime_drift_is_positive_divergence: TestClaim = EqualsClaim {
  label: "language_model/python_cross_runtime_drift: arbitrary-precision value diverges from fixed-width value (drift is real)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_cross_runtime_drift_claim_bool_atom(b: true),
  rhs: python_cross_runtime_drift_claim_bool_atom(
    b: python_cross_runtime_drift_probe().expected_divergence.expected
      != python_cross_runtime_drift_probe().expected_divergence.actual
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
