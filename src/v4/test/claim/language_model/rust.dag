// src/v4/test/claim/language_model/rust.dag
// Scope: C(rust.dag) — verification OBLIGA per PR #3971 / design-rust-dag-leafmodel-instantiation.md.
// Status: Phase-1 rows (R1, R2a, R2b, R3-external, R3-internal); runner deferred (Deferred expectations).

module v4.test.claim.language_model.rust

import v4.extdeps.languages.rust {
  RustLanguageModel,
  rust_atom_realization_symbol,
  rust_facts_i32_fact_id,
  rust_integer_algebra_inhabitance_rust_facts_i32_fact_id,
  rust_language_model_wave2,
  rust_symbol_connective_atom_node
}
import v4.std.collection { List }
import v4.std.leaf_model_verification {
  FalsificationCase,
  LeafModelClaim,
  TargetInvocation
}
import v4.std.logic { Bool }
import v4.std.node { Symbol }
import v4.std.runtime { Panic, RuntimeOutcome, Wrap }
import v4.std.rust_leaf_model_claim {
  AlgebraCarrierOrderedRing,
  E0308,
  E0423,
  E0599,
  Rustc_ErrorCode_Phase1,
  RustAlgebraInhabitanceSubject,
  RustAtomRealizationSubject,
  RustClaimExpectation,
  RustClaimSubject,
  RustEmitProjectionEqualityExpectation,
  RustPrimitiveI32,
  RustPrimitiveTypeSubject,
  RustRuntimeBehaviorExpectation,
  RustcAcceptsExpectation,
  RustcRejectsExpectation
}

data rust_leaf_rustc_toolchain: Symbol = rust_leaf_rustc_toolchain
data rust_leaf_rustc_edition_2024: Symbol = rust_leaf_rustc_edition_2024
data rust_leaf_arithmetic_overflow_panic: Symbol = rust_leaf_arithmetic_overflow_panic

type RustLeafModelClaim = LeafModelClaim<RustLanguageModel, RustClaimSubject, RustClaimExpectation>

fn rust_leaf_rustc_invocation() -> TargetInvocation {
  TargetInvocation {
    toolchain: rust_leaf_rustc_toolchain,
    edition_or_profile: rust_leaf_rustc_edition_2024
  }
}

fn rust_leaf_rustc_accepts() -> RustClaimExpectation {
  RustcAcceptsExpectation { invocation_form: rust_leaf_rustc_invocation() }
}

fn rust_leaf_rustc_rejects(code: Rustc_ErrorCode_Phase1) -> RustClaimExpectation {
  RustcRejectsExpectation {
    invocation_form: rust_leaf_rustc_invocation(),
    expected_error_code: code
  }
}

// R1 — rust_facts_i32 primitive bundle (PR #3971 §5).
data claim_rust_leaf_r1_i32_type: RustLeafModelClaim = LeafModelClaim {
  model: rust_language_model_wave2(),
  fact_id: rust_facts_i32_fact_id,
  subject: RustPrimitiveTypeSubject { primitive: RustPrimitiveI32 },
  expectation: rust_leaf_rustc_accepts(),
  falsification_case: FalsificationCase {
    subject_variant: RustPrimitiveTypeSubject { primitive: RustPrimitiveI32 },
    expected_failure_mode: rust_leaf_rustc_rejects(code: E0308)
  }
}

// R2a — algebra operations angle on derived inhabitance for rust_facts_i32.
data claim_rust_leaf_r2a_i32_algebra_operations: RustLeafModelClaim = LeafModelClaim {
  model: rust_language_model_wave2(),
  fact_id: rust_integer_algebra_inhabitance_rust_facts_i32_fact_id,
  subject: RustAlgebraInhabitanceSubject {
    algebra: AlgebraCarrierOrderedRing,
    on: RustPrimitiveI32
  },
  expectation: rust_leaf_rustc_accepts(),
  falsification_case: FalsificationCase {
    subject_variant: RustAlgebraInhabitanceSubject {
      algebra: AlgebraCarrierOrderedRing,
      on: RustPrimitiveI32
    },
    expected_failure_mode: rust_leaf_rustc_rejects(code: E0599)
  }
}

// R2b — overflow-semantics angle on same derived inhabitance (distinct row per §3).
data claim_rust_leaf_r2b_i32_overflow_semantics: RustLeafModelClaim = LeafModelClaim {
  model: rust_language_model_wave2(),
  fact_id: rust_integer_algebra_inhabitance_rust_facts_i32_fact_id,
  subject: RustAlgebraInhabitanceSubject {
    algebra: AlgebraCarrierOrderedRing,
    on: RustPrimitiveI32
  },
  expectation: RustRuntimeBehaviorExpectation {
    invocation_form: rust_leaf_rustc_invocation(),
    expected_outcome: Panic { panic_classification: rust_leaf_arithmetic_overflow_panic }
  },
  falsification_case: FalsificationCase {
    subject_variant: RustAlgebraInhabitanceSubject {
      algebra: AlgebraCarrierOrderedRing,
      on: RustPrimitiveI32
    },
    expected_failure_mode: RustRuntimeBehaviorExpectation {
      invocation_form: rust_leaf_rustc_invocation(),
      expected_outcome: Wrap
    }
  }
}

// R3-external — PLANNED until SG-1 lands TargetAtomRealization row (§4).
data claim_rust_leaf_r3_external_symbol_projection: RustLeafModelClaim = LeafModelClaim {
  model: rust_language_model_wave2(),
  fact_id: rust_atom_realization_symbol,
  subject: RustAtomRealizationSubject { atom: rust_symbol_connective_atom_node },
  expectation: rust_leaf_rustc_accepts(),
  falsification_case: FalsificationCase {
    subject_variant: RustAtomRealizationSubject { atom: rust_symbol_connective_atom_node },
    expected_failure_mode: rust_leaf_rustc_rejects(code: E0423)
  }
}

// R3-internal — emit coupling receipt; exercisable post-SG-1 (§4).
data claim_rust_leaf_r3_internal_symbol_coupling: RustLeafModelClaim = LeafModelClaim {
  model: rust_language_model_wave2(),
  fact_id: rust_atom_realization_symbol,
  subject: RustAtomRealizationSubject { atom: rust_symbol_connective_atom_node },
  expectation: RustEmitProjectionEqualityExpectation {
    atom_realization_row: rust_symbol_connective_atom_node,
    type_emit_must_change: true,
    value_emit_must_change: true
  },
  falsification_case: FalsificationCase {
    subject_variant: RustAtomRealizationSubject { atom: rust_symbol_connective_atom_node },
    expected_failure_mode: RustEmitProjectionEqualityExpectation {
      atom_realization_row: rust_symbol_connective_atom_node,
      type_emit_must_change: false,
      value_emit_must_change: false
    }
  }
}

data rust_leaf_model_claim_corpus_phase1: List<RustLeafModelClaim> = [
  claim_rust_leaf_r1_i32_type,
  claim_rust_leaf_r2a_i32_algebra_operations,
  claim_rust_leaf_r2b_i32_overflow_semantics,
  claim_rust_leaf_r3_external_symbol_projection,
  claim_rust_leaf_r3_internal_symbol_coupling
]
