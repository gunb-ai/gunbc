// src/v4/test/claim/catalog/graph_construction.dag
// Scope: TestClaim corpus for catalog_from_entries validated constructor.
// Status: T-28 behavior receipts; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.catalog.graph_construction


import v4.std.algebra { Cons, Empty, FreeMonoid }
import v4.std.catalog {
  Catalog,
  Entry,
  catalog_from_entries
}
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.qualified_name { QualifiedName }
import v4.std.witness { Holds, Violates, Witness }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data build_seg_x: Symbol = build_seg_x
data build_seg_y: Symbol = build_seg_y
data build_root_sym: Symbol = build_root_sym
data build_pass_sym: Symbol = build_pass_sym
data build_fail_sym: Symbol = build_fail_sym


fn build_root_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: build_root_sym } }, children: [] }
}
fn build_pass_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: build_pass_sym } }, children: [] }
}
fn build_fail_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: build_fail_sym } }, children: [] }
}
fn build_claim_input(ok: Bool) -> Node {
  if ok { build_pass_node() } else { build_fail_node() }
}


fn build_name_x() -> QualifiedName {
  Cons { head: build_seg_x, tail: Empty }
}
fn build_name_y() -> QualifiedName {
  Cons { head: build_seg_y, tail: Empty }
}
fn build_entry_x() -> Entry { Entry { name: build_name_x(), root: build_root_node() } }
fn build_entry_y() -> Entry { Entry { name: build_name_y(), root: build_root_node() } }


fn build_entries_unique() -> FreeMonoid<Entry> {
  Cons { head: build_entry_x(), tail: Cons { head: build_entry_y(), tail: Empty } }
}
fn build_entries_duplicate() -> FreeMonoid<Entry> {
  Cons { head: build_entry_x(), tail: Cons { head: build_entry_x(), tail: Empty } }
}


fn catalog_holds(w: Witness<Catalog>) -> Bool {
  match w {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}
fn catalog_violates(w: Witness<Catalog>) -> Bool {
  match w {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}


data witness_catalog_from_unique_holds: Bool = catalog_holds(w: catalog_from_entries(entries: build_entries_unique()))


data witness_catalog_from_duplicate_violates: Bool = catalog_violates(w: catalog_from_entries(entries: build_entries_duplicate()))


data claim_catalog_from_unique_holds: TestClaim = CompilesClaim {
  label: "catalog/from_entries: unique-name entries return Holds",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: build_claim_input(ok: witness_catalog_from_unique_holds),
  expected_value: build_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_catalog_from_duplicate_violates: TestClaim = CompilesClaim {
  label: "catalog/from_entries: duplicate-name entries return Violates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: build_claim_input(ok: witness_catalog_from_duplicate_violates),
  expected_value: build_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
