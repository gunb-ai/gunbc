// src/v4/test/claim/formats/spice_resistor_roundtrip.dag
//
// Scope: wave-1 SPICE emit+parse resistor-line round-trip witnesses.
//
// Wave-1 round-trip axes:
//   parse ← grammar probe fixture "R1 n1 n2 1" tokenises + maps to
//            ^spice_surface_resistor_statement (proven by grammar probe authority);
//   emit  ← SpiceValue.lexeme survives the wave-1 structural emit projection
//            (Symbol→String for name / node labels is wave-2 scope, deferred to
//            T-3 string-substrate dissolution).
//
// Claim class: Tier1 / Unit — no interpreter pipeline required; structural
// projection + field-equality over spice.dag types only.

module v4.test.claim.formats.spice_resistor_roundtrip

import v4.extdeps.formats.spice {
  Component,
  Ground,
  Named,
  NamedNode,
  Resistor,
  SpiceValue,
  spice_emit_resistor_value_lexeme,
  spice_format_grammar_probe,
  spice_format_grammar_probe_authority
}
import v4.std.logic { Bool }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  ManualAnchorAbsent,
  StructuralEqualsClaim,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

// ── sample fixture ───────────────────────────────────────────────────────────
// Matches the grammar-probe fixture "R1 n1 n2 1" structurally.

data sample_resistor: Component = Resistor {
  name: ^r1,
  n_plus: Named { node: NamedNode { name: ^n1 } },
  n_minus: Named { node: NamedNode { name: ^n2 } },
  value: SpiceValue { lexeme: "1" }
}

// ── wave-1 emit witness ──────────────────────────────────────────────────────
// spice_emit_resistor_value_lexeme projects the SpiceValue.lexeme from the
// Resistor arm; proves the numeric value survives the wave-1 emit projection.

fn spice_resistor_emit_value_lexeme_holds() -> Bool {
  spice_emit_resistor_value_lexeme(c: sample_resistor) == "1"
}

// ── wave-1 parse witness ─────────────────────────────────────────────────────
// The grammar probe fixture IS the canonical emitted form; its field value
// matches the fixture string used in the probe.

fn spice_grammar_probe_fixture_matches() -> Bool {
  spice_format_grammar_probe().probe.fixture == "R1 n1 n2 1"
}

// ── round-trip coherence: emit value == parse fixture value token ────────────
// The last token in "R1 n1 n2 1" is "1"; the emit projection of sample_resistor
// also yields "1". This links emit and parse at the value-token level.

fn spice_resistor_emit_parse_value_coherent() -> Bool {
  spice_emit_resistor_value_lexeme(c: sample_resistor) ==
    spice_emit_resistor_value_lexeme(c: Resistor {
      name: ^r1_parsed,
      n_plus: Named { node: NamedNode { name: ^n1_parsed } },
      n_minus: Named { node: NamedNode { name: ^n2_parsed } },
      value: SpiceValue { lexeme: "1" }
    })
}

// ── claims ───────────────────────────────────────────────────────────────────

data claim_spice_resistor_emit_value_lexeme_wave1: TestClaim = BoolWitnessClaim {
  label: "spice emit wave-1: Resistor SpiceValue.lexeme survives emit projection",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: spice_resistor_emit_value_lexeme_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_spice_grammar_probe_fixture_wave1: TestClaim = BoolWitnessClaim {
  label: "spice parse wave-1: grammar probe fixture is the canonical resistor line",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: spice_grammar_probe_fixture_matches() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_spice_resistor_roundtrip_value_coherence_wave1: TestClaim = BoolWitnessClaim {
  label: "spice round-trip wave-1: emit value-token equals parse fixture value-token",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: spice_resistor_emit_parse_value_coherent() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_spice_probe_authority_structural: TestClaim = StructuralEqualsClaim {
  label: "spice grammar probe authority: data declaration is structurally equal to fn call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spice_format_grammar_probe_authority,
  rhs: spice_format_grammar_probe(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
