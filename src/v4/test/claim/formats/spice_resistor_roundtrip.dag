// src/v4/test/claim/formats/spice_resistor_roundtrip.dag
//
// Scope: wave-1 SPICE emit+parse resistor-line round-trip witnesses.
//
// Wave-1 round-trip axes:
//   parse ← grammar probe fixture "R1 n1 n2 1" tokenises and parses via
//            spice_wave1_lex() + spice_wave1_grammar() (proven by fn witness below);
//   emit  ← SpiceValue.lexeme survives the wave-1 structural emit projection
//            (Symbol→String for name / node labels is wave-2 scope, deferred to
//            T-3 string-substrate dissolution).
//
// Execution: both fn witnesses are registered in claim_witness_corpus_ci_runner.dag.

module v4.test.claim.formats.spice_resistor_roundtrip

import v4.extdeps.formats.spice {
  Component,
  Resistor,
  SpiceValue,
  Named,
  NamedNode,
  spice_emit_resistor_value_lexeme,
  spice_format_grammar_probe,
  spice_format_grammar_probe_authority,
  spice_wave1_lex,
  spice_wave1_grammar
}
import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.grammar { ParseTree }
import v4.compiler.tokenize { tokenize }
import v4.compiler.parse { parse }
import v4.std.logic { Bool }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  ManualAnchorAbsent,
  StructuralEqualsClaim,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  UnifiedTestClaim,
  manual_claim_anchor
}

// ── sample fixture ───────────────────────────────────────────────────────────
// Matches the grammar-probe fixture "R1 n1 n2 1" structurally.

data sample_resistor: Component = Resistor {
  name: ^r1,
  n_plus: Named { node: NamedNode { name: ^n1 } },
  n_minus: Named { node: NamedNode { name: ^n2 } },
  value: SpiceValue { lexeme: "1" }
}

// ── wave-1 emit witness ──────────────────────────────────────────────────────

fn spice_resistor_emit_value_lexeme_holds() -> Bool {
  match spice_emit_resistor_value_lexeme(c: sample_resistor) {
    Accepted { value: lex, diagnostics: _ } => lex == "1"
    Rejected { diagnostics: _ } => false
  }
}

// ── wave-1 parse witness ─────────────────────────────────────────────────────
// Tokenises and parses the canonical fixture "R1 n1 n2 1" using the wave-1
// lex rules and grammar. Accepted iff the grammar accepts the fixture.

fn spice_wave1_tokenize_and_parse() -> Outcome<ParseTree> {
  match tokenize(
    text: "R1 n1 n2 1",
    file: ^spice_wave1_fixture_file,
    rules: spice_wave1_lex()
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: tokens, diagnostics: _ } =>
      parse(tokens: tokens, grammar: spice_wave1_grammar())
  }
}

fn spice_grammar_fixture_parses() -> Bool {
  match spice_wave1_tokenize_and_parse() {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

// ── claims ───────────────────────────────────────────────────────────────────

data claim_spice_resistor_emit_value_lexeme_wave1: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/formats/spice_resistor_roundtrip.dag",
    function: spice_resistor_emit_value_lexeme_holds
  }
}

data claim_spice_grammar_fixture_parses_wave1: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/formats/spice_resistor_roundtrip.dag",
    function: spice_grammar_fixture_parses
  }
}

data claim_spice_probe_authority_structural: TestClaim = StructuralEqualsClaim {
  label: "spice grammar probe authority: data declaration is structurally equal to fn call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spice_format_grammar_probe_authority,
  rhs: spice_format_grammar_probe(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
