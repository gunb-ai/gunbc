// src/v4/test/claim/formats/spice_rc_ngspice_oracle.dag
// Scope: ngspice oracle structural witness — spice_emit_ngspice(rc_tran_deck) produces the
//        exact netlist string that ngspice -b accepts and simulates to exit 0.
// Anchor: ngspice User's Manual §3 batch mode; scripts/v4-spice-ngspice-rc-oracle.sh
//         is the execution oracle that runs the emitted string through ngspice when available.
// Consumer chain: BoolWitnessClaim (evaluate by execution) → shell oracle (ngspice execution).
// Clear win receipt: T-4.10 — ONE .dag circuit declaration → simulating ngspice netlist.

module v4.test.claim.formats.spice_rc_ngspice_oracle

import v4.extdeps.formats.spice { spice_emit_ngspice }
import v4.test.fixture.spice_rc_tran_deck { spice_rc_tran_deck }
import v4.std.logic { Bool }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

// Expected ngspice-ready netlist string for the RC transient circuit.
// Line order: title, V1, R1, C1, .tran, .end (matches spice_emit_ngspice fold order).
data spice_rc_tran_ngspice_expected: String =
  "* rc tran witness\nV1 n1 0 DC 5\nR1 n1 n2 1000\nC1 n2 0 1e-6\n.tran 1us 10ms\n.end"

fn spice_rc_tran_emit_ngspice_matches_expected_holds() -> Bool {
  spice_emit_ngspice(netlist: spice_rc_tran_deck) == spice_rc_tran_ngspice_expected
}

fn spice_rc_tran_emit_ngspice_nonempty_holds() -> Bool {
  let text = spice_emit_ngspice(netlist: spice_rc_tran_deck)
  (text != "") && (text != "* rc tran witness")
}

fn spice_rc_tran_emit_ngspice_ends_with_end_holds() -> Bool {
  let text = spice_emit_ngspice(netlist: spice_rc_tran_deck)
  // Structural: the emitted string must contain the .end terminator required by ngspice.
  // Wave-1 check: exact equality with expected is the full claim; this verifies the suffix.
  text == spice_rc_tran_ngspice_expected
}

data unified_claim_spice_rc_tran_emit_ngspice_matches: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/formats/spice_rc_ngspice_oracle.dag",
    function: spice_rc_tran_emit_ngspice_matches_expected_holds
  }
}

data unified_claim_spice_rc_tran_emit_ngspice_nonempty: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/formats/spice_rc_ngspice_oracle.dag",
    function: spice_rc_tran_emit_ngspice_nonempty_holds
  }
}
