// src/v4/test/claim/formats/spice_resistor_round_trip.dag
// Scope: wave-1 spice Shape B emit+parse round-trip + grammar tokenize/parse consumer.
// Anchor: spice_format_grammar_probe fixture "R1 n1 n2 1".

module v4.test.claim.formats.spice_resistor_round_trip

import v4.compiler.parse { parse }
import v4.compiler.tokenize { tokenize }
import v4.extdeps.formats.spice {
  spice_emit,
  spice_format_grammar_schema,
  spice_parse,
  spice_wave1_fixture_file,
  spice_wave1_probe_resistor_line,
  spice_wave1_probe_resistor_netlist
}
import v4.std.diagnostic { Accepted, None, Rejected }
import v4.std.logic { Bool }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}

fn spice_resistor_emit_matches_probe_holds() -> Bool {
  spice_emit(netlist: spice_wave1_probe_resistor_netlist) == spice_wave1_probe_resistor_line
}

fn spice_resistor_parse_accepts_probe_holds() -> Bool {
  match spice_parse(text: spice_wave1_probe_resistor_line) {
    Accepted { value: netlist, diagnostics: d } =>
      (netlist == spice_wave1_probe_resistor_netlist) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn spice_resistor_emit_parse_round_trip_holds() -> Bool {
  match spice_parse(text: spice_emit(netlist: spice_wave1_probe_resistor_netlist)) {
    Accepted { value: netlist, diagnostics: d } =>
      (netlist == spice_wave1_probe_resistor_netlist) && (d == None)
    Rejected { diagnostics: _ } => false
  }
}

fn spice_resistor_tokenize_parse_accepts_holds() -> Bool {
  let schema = spice_format_grammar_schema()
  match tokenize(
    text: spice_wave1_probe_resistor_line,
    file: spice_wave1_fixture_file,
    rules: schema.lex
  ) {
    Rejected { diagnostics: _ } => false
    Accepted { value: tokens, diagnostics: _ } =>
      match parse(tokens: tokens, grammar: schema.grammar) {
        Accepted { value: tree, diagnostics: d } => d == None
        Rejected { diagnostics: _ } => false
      }
  }
}

data unified_claim_spice_resistor_emit_probe: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/formats/spice_resistor_round_trip.dag",
    function: spice_resistor_emit_matches_probe_holds
  }
}

data unified_claim_spice_resistor_emit_parse_round_trip: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/formats/spice_resistor_round_trip.dag",
    function: spice_resistor_emit_parse_round_trip_holds
  }
}

data unified_claim_spice_resistor_tokenize_parse: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/formats/spice_resistor_round_trip.dag",
    function: spice_resistor_tokenize_parse_accepts_holds
  }
}
