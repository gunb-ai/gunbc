// src/v4/test/claim/formats/spice_rc_ngspice_op.dag
// Scope: ngspice oracle witness — spice_rc_passive_deck (#4967) emits runnable .cir with .op.
// Anchor: spice_emit + scripts/v4-spice-ngspice-op-gate.sh (ngspice -b consumer).

module v4.test.claim.formats.spice_rc_ngspice_op

import v4.extdeps.formats.spice { spice_emit }
import v4.std.logic { Bool }
import v4.std.text { string_contains }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v4.test.fixture.spice_rc_passive_deck {
  spice_rc_passive_deck,
  spice_rc_passive_deck_emitted
}

fn spice_rc_passive_deck_emit_has_op_directive_holds() -> Bool {
  let text = spice_emit(netlist: spice_rc_passive_deck)
  string_contains(haystack: text, needle: ".op")
}

fn spice_rc_passive_deck_emit_has_rc_passives_holds() -> Bool {
  let text = spice_emit(netlist: spice_rc_passive_deck)
  string_contains(haystack: text, needle: "R1 vin mid 1k")
    && string_contains(haystack: text, needle: "C1 mid 0 1u")
}

fn spice_rc_passive_deck_emit_matches_data_holds() -> Bool {
  spice_emit(netlist: spice_rc_passive_deck) == spice_rc_passive_deck_emitted
}

// Structural emit authority for claim-run; ngspice -b execution is the host gate consumer.
fn spice_rc_ngspice_op_holds() -> Bool {
  spice_rc_passive_deck_emit_matches_data_holds()
    && spice_rc_passive_deck_emit_has_rc_passives_holds()
    && spice_rc_passive_deck_emit_has_op_directive_holds()
}

data unified_claim_spice_rc_ngspice_op: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/formats/spice_rc_ngspice_op.dag",
    function: spice_rc_ngspice_op_holds
  }
}
