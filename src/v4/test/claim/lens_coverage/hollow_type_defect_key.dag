// src/v4/test/claim/lens_coverage/hollow_type_defect_key.dag
// Scope: T-18 worked claim — HollowType defect acceptance pins the canonical key.
// Owns: claim_hollow_type_defect_key.
// Consumes: lens coverage, std node, std verification.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_coverage.hollow_type_defect_key

import v4.lens.coverage {
  CoverageDefectAcceptance,
  CoverageDefectAcceptanceKey,
  HollowType,
  coverage_defect_hollow_type
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  Tier1,
  Unit,
  t19_manual_claim_anchor
}

data hollow_type_authority_symbol: Symbol = hollow_type_authority_symbol

data hollow_type_authority_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: hollow_type_authority_symbol } },
  children: []
}

data expected_hollow_type_acceptance: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: HollowType }
}

fn hollow_type_defect_key_claim_holds() -> Bool {
  coverage_defect_hollow_type == expected_hollow_type_acceptance
}

fn hollow_type_defect_key_claim_rhs() -> Node {
  if hollow_type_defect_key_claim_holds() {
    hollow_type_authority_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_hollow_type_defect_key: TestClaim = EqualsClaim {
  label: "lens_coverage/hollow_type_defect_key: HollowType acceptance key",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  lhs: hollow_type_authority_node,
  rhs: hollow_type_defect_key_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
