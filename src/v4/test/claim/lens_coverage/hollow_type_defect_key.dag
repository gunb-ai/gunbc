// src/v4/test/claim/lens_coverage/hollow_type_defect_key.dag
// Scope: T-18 worked claim — HollowType defect acceptance pins the canonical key.
// Owns: hollow_type_defect_key_claim.
// Consumes: lens coverage.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_coverage.hollow_type_defect_key

import v4.lens.coverage {
  CoverageDefectAcceptance,
  CoverageDefectAcceptanceKey,
  HollowType,
  coverage_defect_hollow_type
}
import v4.std.logic { Bool }

type LensCoverageDefectClaim {
  acceptance: CoverageDefectAcceptance
  expected_key: CoverageDefectAcceptanceKey
}

data hollow_type_defect_key_claim: LensCoverageDefectClaim = LensCoverageDefectClaim {
  acceptance: coverage_defect_hollow_type,
  expected_key: CoverageDefectAcceptanceKey { lens: HollowType }
}

fn hollow_type_defect_key_claim_holds() -> Bool {
  hollow_type_defect_key_claim.acceptance.concern.lens == hollow_type_defect_key_claim.expected_key.lens
}

data hollow_type_defect_key_claim_passes: Bool = hollow_type_defect_key_claim_holds()
