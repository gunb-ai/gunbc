// src/v4/test/claim/lens_coverage/discriminant_predicate_defect_key.dag
// Scope: T-18 worked claim — DiscriminantPredicate defect acceptance pins the canonical key.
// Owns: discriminant_predicate_defect_key_claim.
// Consumes: lens coverage.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_coverage.discriminant_predicate_defect_key

import v4.lens.coverage {
  CoverageDefectAcceptance,
  CoverageDefectAcceptanceKey,
  DiscriminantPredicate,
  coverage_defect_discriminant_predicate
}
import v4.std.logic { Bool }

type LensCoverageDefectClaim {
  acceptance: CoverageDefectAcceptance
  expected_key: CoverageDefectAcceptanceKey
}

data discriminant_predicate_defect_key_claim: LensCoverageDefectClaim = LensCoverageDefectClaim {
  acceptance: coverage_defect_discriminant_predicate,
  expected_key: CoverageDefectAcceptanceKey { lens: DiscriminantPredicate }
}

fn discriminant_predicate_defect_key_claim_holds() -> Bool {
  discriminant_predicate_defect_key_claim.acceptance.concern.lens ==
    discriminant_predicate_defect_key_claim.expected_key.lens
}

data discriminant_predicate_defect_key_claim_passes: Bool = discriminant_predicate_defect_key_claim_holds()
