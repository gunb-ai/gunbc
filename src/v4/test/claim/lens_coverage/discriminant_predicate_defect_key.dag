// src/v4/test/claim/lens_coverage/discriminant_predicate_defect_key.dag
// Scope: T-18 worked claim — DiscriminantPredicate defect acceptance pins the canonical key.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_coverage.discriminant_predicate_defect_key

import v4.lens.coverage {
  CoverageDefectAcceptance,
  CoverageDefectAcceptanceKey,
  DiscriminantPredicate,
  coverage_defect_discriminant_predicate
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
data discriminant_predicate_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^discriminant_predicate_symbol } },
  children: [],
  span: Unanchored
}

data expected_discriminant_predicate_acceptance: CoverageDefectAcceptance = {
  concern: CoverageDefectAcceptanceKey { lens: DiscriminantPredicate }
}

fn discriminant_predicate_defect_key_claim_holds() -> Bool {
  coverage_defect_discriminant_predicate == expected_discriminant_predicate_acceptance
}

fn discriminant_predicate_defect_key_claim_rhs() -> Node {
  if discriminant_predicate_defect_key_claim_holds() {
    discriminant_predicate_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      span: Unanchored
}
  }
}

data claim_discriminant_predicate_defect_key: TestClaim = EqualsClaim {
  label: "lens_coverage/discriminant_predicate_defect_key: DiscriminantPredicate acceptance key",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: discriminant_predicate_node,
  rhs: discriminant_predicate_defect_key_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
