// src/v4/test/claim/lens_coverage/parallel_authority_defect_key.dag
// Scope: T-18 worked claim — ParallelAuthority defect acceptance pins the canonical key.
// Owns: parallel_authority_defect_key_claim.
// Consumes: lens coverage.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_coverage.parallel_authority_defect_key

import v4.lens.coverage {
  CoverageDefectAcceptance,
  CoverageDefectAcceptanceKey,
  ParallelAuthority,
  coverage_defect_parallel_authority
}
import v4.std.logic { Bool }

type LensCoverageDefectClaim {
  acceptance: CoverageDefectAcceptance
  expected_key: CoverageDefectAcceptanceKey
}

data parallel_authority_defect_key_claim: LensCoverageDefectClaim = LensCoverageDefectClaim {
  acceptance: coverage_defect_parallel_authority,
  expected_key: CoverageDefectAcceptanceKey { lens: ParallelAuthority }
}

fn parallel_authority_defect_key_claim_holds() -> Bool {
  parallel_authority_defect_key_claim.acceptance.concern.lens ==
    parallel_authority_defect_key_claim.expected_key.lens
}

data parallel_authority_defect_key_claim_passes: Bool = parallel_authority_defect_key_claim_holds()
