// src/v4/test/claim/nat_semiring/rung_l1_go_compiler_slice.dag
// Scope: L1 Go compiler-slice compile receipt for fixture=phase1/nat_semiring (release-minimum).
// Status: substrate claim labels (correctness-ladder L1 vocabulary; slice_id
//   ^go_l1_nat_semiring_rung2 per docs/planning/v4-go-l1-compiler-slice-compile-worksheet-2026-06-01.md).
//   Executable host transport is scripts/v4-phase1-nat-semiring-go-compiler-slice-gate.sh
//   (chained from v4-phase1-nat-semiring-rung-gate.sh after R2-go-compile) until T-22 eval
//   dispatches TestClaimRun host evidence on emitted artifacts.
//   Authority: Go RCA — bounded emit subset → go build PASS/FAIL JSON receipt (not L2/L3/L4).

module v4.test.claim.nat_semiring.rung_l1_go_compiler_slice


import v4.std.collection { List }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.text { String }
import v4.std.verification {
  ManualAnchorAbsent,
  CompilesClaim,
  TestClaim,
  TestClassification,
  Tier3,
  Integration,
  manual_claim_anchor
}


// Single authority for slice_id (worksheet + host JSON + structural subject must agree).
// Host transport + JSON receipt schema (worksheet §10 item 3); not the rung-gate R2 cell.
data go_l1_nat_semiring_rung2_l1_host_gate: String = "scripts/v4-phase1-nat-semiring-go-compiler-slice-gate.sh"

data go_l1_nat_semiring_rung2_l1_receipt_schema: String = "scripts/v4-phase1-nat-semiring-go-compiler-slice-gate.sh::go_l1_compiler_slice_receipt_v1"

// Receipt coordinate edge label on the Conj subject carrier.
// Ladder predicate id R-L1-go-compiler-slice-compile is label/host-only (hyphenated §2.4
// matrix spelling; not a Symbol — mirrors rung_l1_python_runtime.dag predicate-in-label).

fn l1_go_receipt_atom(sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sym } },
    children: []
  }
}

data phase1_l1_go_compiler_slice_subject_slice_binding: Node = l1_go_receipt_atom(sym: ^go_l1_nat_semiring_rung2)

// CompilesClaim input/expected carry slice_id structurally (FACTS FLOW FORWARD).
data phase1_nat_semiring_l1_go_compiler_slice_subject: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^l1_go_receipt_slice_edge },
      target: phase1_l1_go_compiler_slice_subject_slice_binding
    }
  ]
}

fn phase1_l1_go_compiler_slice_claim(label: String) -> TestClaim {
  CompilesClaim {
    label: label,
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: phase1_nat_semiring_l1_go_compiler_slice_subject,
    expected_value: phase1_nat_semiring_l1_go_compiler_slice_subject,
    classification: TestClassification { tier: Tier3, layer: Integration }
  }
}

data claim_phase1_nat_semiring_l1_go_compiler_slice_compile: TestClaim = phase1_l1_go_compiler_slice_claim(
  label: "fixture=phase1/nat_semiring rung=l1 target=go slice=^go_l1_nat_semiring_rung2 predicate=R-L1-go-compiler-slice-compile"
)

data phase1_nat_semiring_l1_go_compiler_slice_claim_rows: List<TestClaim> = [
  claim_phase1_nat_semiring_l1_go_compiler_slice_compile
]
