// src/v4/test/claim/nat_semiring/rung_8.dag
// Scope: phase1/nat_semiring rung-8 TestClaimRun roster — full fixture law corpus (§7).
// Status: W3.6 — T-22 eval via structural assert (tier-1 EqualsClaim + DiagnosticClaim).

module v4.test.claim.nat_semiring.rung_8


import v4.compiler.eval {
  TestClaimRun,
  run_test_claim_assert,
  test_claim_cache_receipt,
  test_claim_input
}
import v4.std.collection { List }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.node { Node }
import v4.std.runtime { RuntimeValue }
import v4.std.verdict { Fail, Absent }
import v4.std.verification { TestClaim, test_claim_expected_outcome }
import v4.test.claim.algebra_laws.nat_semiring {
  claim_nat_add_associativity,
  claim_nat_add_left_identity,
  claim_nat_add_right_identity,
  claim_nat_add_wrong_identity_falsifies_law,
  claim_nat_mul_annihilator,
  claim_nat_mul_associativity,
  claim_nat_mul_left_identity
}
import v4.test.claim.rung_3_4_common { rung34_test_claim_subject }


// Tier-1 structural eval: project declared expected Outcome<Node> through run_test_claim_assert
// (T-22 substrate). Reflexive EqualsClaim rows and the DiagnosticClaim falsifier carry no
// runtime interpretation over algebra-law subjects — Pass/Fail is decided at assert time, never Deferred.
fn rung8_tier1_eval_run(claim: TestClaim) -> TestClaimRun<Node, RuntimeValue> {
  let input = test_claim_input(c: claim)
  let subject = rung34_test_claim_subject(claim: claim, evaluator_input: input)
  match test_claim_expected_outcome(c: claim) {
    Accepted { value: actual, diagnostics: _ } =>
      TestClaimRun {
        cache: test_claim_cache_receipt(subject: subject),
        verdict: run_test_claim_assert(claim: claim, actual: actual, at: input)
      }
    Rejected { diagnostics: d } =>
      TestClaimRun {
        cache: test_claim_cache_receipt(subject: subject),
        verdict: Fail { actual: Rejected { diagnostics: d }, falsification: Absent }
      }
  }
}


data run_claim_nat_add_left_identity: TestClaimRun<Node, RuntimeValue> =
  rung8_tier1_eval_run(claim: claim_nat_add_left_identity)


data run_claim_nat_add_right_identity: TestClaimRun<Node, RuntimeValue> =
  rung8_tier1_eval_run(claim: claim_nat_add_right_identity)


data run_claim_nat_add_associativity: TestClaimRun<Node, RuntimeValue> =
  rung8_tier1_eval_run(claim: claim_nat_add_associativity)


data run_claim_nat_mul_left_identity: TestClaimRun<Node, RuntimeValue> =
  rung8_tier1_eval_run(claim: claim_nat_mul_left_identity)


data run_claim_nat_mul_annihilator: TestClaimRun<Node, RuntimeValue> =
  rung8_tier1_eval_run(claim: claim_nat_mul_annihilator)


data run_claim_nat_mul_associativity: TestClaimRun<Node, RuntimeValue> =
  rung8_tier1_eval_run(claim: claim_nat_mul_associativity)


data run_claim_nat_add_wrong_identity_falsifies_law: TestClaimRun<Node, RuntimeValue> =
  rung8_tier1_eval_run(claim: claim_nat_add_wrong_identity_falsifies_law)


data phase1_nat_semiring_rung8_runtime_value_rows: List<TestClaimRun<Node, RuntimeValue>> = [
  run_claim_nat_add_left_identity,
  run_claim_nat_add_right_identity,
  run_claim_nat_add_associativity,
  run_claim_nat_mul_left_identity,
  run_claim_nat_mul_annihilator,
  run_claim_nat_mul_associativity,
  run_claim_nat_add_wrong_identity_falsifies_law
]
