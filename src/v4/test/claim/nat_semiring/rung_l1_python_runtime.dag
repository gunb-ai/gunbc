  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  CompilesClaim,
  manual_claim_anchor
}


data phase1_nat_semiring_l1_python_runtime_subject_symbol: Symbol =
  phase1_nat_semiring_l1_python_runtime_subject_symbol

data phase1_nat_semiring_l1_python_runtime_subject: Node = Node {
  kind: TypeNode {
    connective: Atom { identity: phase1_nat_semiring_l1_python_runtime_subject_symbol }
  },
  children: []
}

fn phase1_l1_python_runtime_claim(label: String) -> TestClaim {
  CompilesClaim {
    label: label,
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    input: phase1_nat_semiring_l1_python_runtime_subject,
    expected_value: phase1_nat_semiring_l1_python_runtime_subject,
    classification: TestClassification { tier: Tier1, layer: Integration }
  }
}

data claim_phase1_nat_semiring_l1_python_runtime_exec: TestClaim = phase1_l1_python_runtime_claim(
  label: "fixture=phase1/nat_semiring rung=l1 target=python predicate=R-L1-python-runtime-exec"
)

data phase1_nat_semiring_l1_python_runtime_claim_rows: List<TestClaim> = [
