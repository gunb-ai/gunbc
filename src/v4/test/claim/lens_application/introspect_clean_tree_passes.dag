// src/v4/test/claim/lens_application/introspect_clean_tree_passes.dag
// Scope: T-23 worked claim — Introspect apply_lens admits a clean inferred tree.
// Owns: claim_introspect_clean_tree_passes.
// Consumes: compiler compile, lens_common fixture, std verification.
// Status: scaffold — compile-only until application.dag fills introspect demotion.

module v4.test.claim.lens_application.introspect_clean_tree_passes

import v4.compiler.compile { CompileLens, CompileLensIntrospect, apply_compile_lens }
import v4.compiler.infer { InferredTree }
import v4.std.diagnostic { Accepted, None, Outcome, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  Tier1,
  Unit,
  t19_manual_claim_anchor
}
import v4.std.witness { Holds, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data introspect_claim_symbol: Symbol = introspect_claim_symbol
data introspect_type_symbol: Symbol = introspect_type_symbol
data introspect_algebra_symbol: Symbol = introspect_algebra_symbol
data introspect_descent_symbol: Symbol = introspect_descent_symbol
data introspect_canonical_structural_symbol: Symbol = introspect_canonical_structural_symbol
data introspect_canonical_closedness_symbol: Symbol = introspect_canonical_closedness_symbol

data introspect_root: Node = claim_atom_node(s: introspect_claim_symbol)

fn introspect_tree() -> InferredTree {
  claim_inferred_tree(
    root: introspect_root,
    facts: claim_inferred_facts(
    type_symbol: introspect_type_symbol,
    algebra_symbol: introspect_algebra_symbol,
    descent_symbol: introspect_descent_symbol,
    canonical_structural_symbol: introspect_canonical_structural_symbol,
    canonical_closedness_symbol: introspect_canonical_closedness_symbol
  )
  )
}

fn introspect_passing_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  Accepted { value: Holds { value: introspect_root }, diagnostics: None }
}

data introspect_passing_lens: CompileLens = CompileLens {
  gate: introspect_passing_gate
}

fn introspect_clean_tree_passes_claim_holds() -> Bool {
  match apply_compile_lens(lens: introspect_passing_lens, inferred: introspect_tree(), mode: CompileLensIntrospect) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn introspect_clean_tree_passes_claim_rhs() -> Node {
  if introspect_clean_tree_passes_claim_holds() {
    introspect_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_introspect_clean_tree_passes: TestClaim = EqualsClaim {
  label: "lens_application/introspect_clean_tree_passes: Introspect apply_lens accepts clean tree",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  lhs: introspect_root,
  rhs: introspect_clean_tree_passes_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
