// src/v4/test/claim/lens_application/introspect_clean_tree_passes.dag
// Scope: T-23 worked claim — Introspect apply_lens admits a clean inferred tree (advisory path).
// Owns: introspect_clean_tree_passes_claim.
// Consumes: compiler compile (apply_lens stub until application.dag fills), lens_common fixture.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_application.introspect_clean_tree_passes

import v4.compiler.compile {
  Lens,
  LensApplicationMode,
  LensIntrospect,
  apply_lens
}
import v4.compiler.infer { InferredFacts, InferredTree }
import v4.std.diagnostic { Accepted, Outcome }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.witness { Holds, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data introspect_root_symbol: Symbol = introspect_root_symbol
data introspect_type_symbol: Symbol = introspect_type_symbol
data introspect_algebra_symbol: Symbol = introspect_algebra_symbol
data introspect_algebra_witness_symbol: Symbol = introspect_algebra_witness_symbol
data introspect_descent_symbol: Symbol = introspect_descent_symbol
data introspect_canonical_structural_symbol: Symbol = introspect_canonical_structural_symbol
data introspect_canonical_closedness_symbol: Symbol = introspect_canonical_closedness_symbol
data introspect_canonical_evidence_symbol: Symbol = introspect_canonical_evidence_symbol

data introspect_root: Node = claim_atom_node(s: introspect_root_symbol)

fn introspect_tree() -> InferredTree {
  claim_inferred_tree(
    root: introspect_root,
    facts: claim_inferred_facts(
      type_symbol: introspect_type_symbol,
      algebra_symbol: introspect_algebra_symbol,
      algebra_witness_symbol: introspect_algebra_witness_symbol,
      descent_symbol: introspect_descent_symbol,
      canonical_structural_symbol: introspect_canonical_structural_symbol,
      canonical_closedness_symbol: introspect_canonical_closedness_symbol,
      canonical_evidence_symbol: introspect_canonical_evidence_symbol
    )
  )
}

fn introspect_passing_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  Accepted { value: Holds { value: introspect_root }, diagnostics: None }
}

data introspect_passing_lens: Lens = Lens {
  gate: introspect_passing_gate
}

type LensApplicationClaim {
  mode: LensApplicationMode
  expected_accepts: Bool
}

data introspect_clean_tree_passes_claim: LensApplicationClaim = LensApplicationClaim {
  mode: LensIntrospect,
  expected_accepts: true
}

fn introspect_clean_tree_passes_claim_holds() -> Bool {
  match apply_lens(
    lens: introspect_passing_lens,
    inferred: introspect_tree(),
    mode: introspect_clean_tree_passes_claim.mode
  ) {
    Accepted { value: _, diagnostics: _ } => introspect_clean_tree_passes_claim.expected_accepts
    Rejected { diagnostics: _ } => false
  }
}

data introspect_clean_tree_passes_claim_passes: Bool = introspect_clean_tree_passes_claim_holds()
