// src/v4/test/claim/lens_application/substitute_at_depth_two.dag
// Scope: T-23 worked claim — substitute_at preserves ancestors for path depth 2.
// Status: compile-only ratchet for D1 t[s]p ancestor rebuild.

module v4.test.claim.lens_application.substitute_at_depth_two

import v4.lens.application { substitute_at }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Path, Symbol, TypeNode, substrate_synthetic_occurrence_id }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
data substitute_original_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^substitute_original_leaf_symbol } },
  children: [],
  occurrence_id: substrate_synthetic_occurrence_id
}

data substitute_replacement_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^substitute_replacement_leaf_symbol } },
  children: [],
  occurrence_id: substrate_synthetic_occurrence_id
}

data substitute_middle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^substitute_step_b },
      target: substitute_original_leaf
    }
  ],
  occurrence_id: substrate_synthetic_occurrence_id
}

data substitute_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^substitute_step_a },
      target: substitute_middle
    }
  ],
  occurrence_id: substrate_synthetic_occurrence_id
}

data substitute_expected_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^substitute_step_a },
      target: Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: ^substitute_step_b },
            target: substitute_replacement_leaf
          }
        ],
        occurrence_id: substrate_synthetic_occurrence_id
}
    }
  ],
  occurrence_id: substrate_synthetic_occurrence_id
}

fn substitute_at_depth_two_claim_holds() -> Bool {
  match substitute_at(
    root: substitute_root,
    path: Path { steps: [^substitute_step_a, ^substitute_step_b] },
    replacement: substitute_replacement_leaf
  ) {
    Accepted { value: n, diagnostics: _ } => n == substitute_expected_root
    Rejected { diagnostics: _ } => false
  }
}

fn substitute_at_depth_two_claim_rhs() -> Node {
  if substitute_at_depth_two_claim_holds() {
    substitute_expected_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: substrate_synthetic_occurrence_id
}
  }
}

data claim_substitute_at_depth_two: TestClaim = EqualsClaim {
  label: "lens_application/substitute_at_depth_two: path depth 2 preserves root ancestry",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: substitute_expected_root,
  rhs: substitute_at_depth_two_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
