// src/v4/test/claim/lens_application/application_subterm_at_empty_path.dag
// Scope: T-23 worked claim — v4.lens.application authority is imported (D1 subterm_at on empty path).
// Status: compile-only ratchet for application.dag consumer edge.

module v4.test.claim.lens_application.application_subterm_at_empty_path

import v4.lens.application { subterm_at }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Node, Path, Symbol, TypeNode, Unanchored }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
data application_subterm_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^application_subterm_symbol } },
  children: [],
  span: Unanchored
}

fn application_subterm_at_empty_path_claim_holds() -> Bool {
  match subterm_at(root: application_subterm_root, p: Path { steps: [] }) {
    Accepted { value: n, diagnostics: _ } => n == application_subterm_root
    Rejected { diagnostics: _ } => false
  }
}

fn application_subterm_at_empty_path_claim_rhs() -> Node {
  if application_subterm_at_empty_path_claim_holds() {
    application_subterm_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      span: Unanchored
}
  }
}

data claim_application_subterm_at_empty_path: TestClaim = EqualsClaim {
  label: "lens_application/application_subterm_at_empty_path: empty Path resolves to root",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: application_subterm_root,
  rhs: application_subterm_at_empty_path_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
