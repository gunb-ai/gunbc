// src/v4/test/claim/lens_application/substitute_at_depth_three.dag
// Scope: T-23 worked claim — substitute_at preserves ancestors for path depth 3.
// Owns: claim_substitute_at_depth_three.
// Consumes: v4.lens.application (substitute_at), v4.std.node (Path), std verification.
// Status: compile-only ratchet for D1 ancestor threading order (depth > 2).

module v4.test.claim.lens_application.substitute_at_depth_three

import v4.lens.application { substitute_at }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Path, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  Tier1,
  Unit,
  t19_manual_claim_anchor
}

data depth_three_step_a: Symbol = depth_three_step_a
data depth_three_step_b: Symbol = depth_three_step_b
data depth_three_step_c: Symbol = depth_three_step_c
data depth_three_original_leaf_symbol: Symbol = depth_three_original_leaf_symbol
data depth_three_replacement_leaf_symbol: Symbol = depth_three_replacement_leaf_symbol

data depth_three_original_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: depth_three_original_leaf_symbol } },
  children: []
}

data depth_three_replacement_leaf: Node = Node {
  kind: TypeNode { connective: Atom { identity: depth_three_replacement_leaf_symbol } },
  children: []
}

data depth_three_inner: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: depth_three_step_c },
      target: depth_three_original_leaf
    }
  ]
}

data depth_three_middle: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: depth_three_step_b },
      target: depth_three_inner
    }
  ]
}

data depth_three_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: depth_three_step_a },
      target: depth_three_middle
    }
  ]
}

data depth_three_expected_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: depth_three_step_a },
      target: Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: depth_three_step_b },
            target: Node {
              kind: TypeNode { connective: Conj },
              children: [
                Edge {
                  label: Named { name: depth_three_step_c },
                  target: depth_three_replacement_leaf
                }
              ]
            }
          }
        ]
      }
    }
  ]
}

fn substitute_at_depth_three_claim_holds() -> Bool {
  match substitute_at(
    root: depth_three_root,
    path: Path {
      steps: [depth_three_step_a, depth_three_step_b, depth_three_step_c]
    },
    replacement: depth_three_replacement_leaf
  ) {
    Accepted { value: n, diagnostics: _ } => n == depth_three_expected_root
    Rejected { diagnostics: _ } => false
  }
}

fn substitute_at_depth_three_claim_rhs() -> Node {
  if substitute_at_depth_three_claim_holds() {
    depth_three_expected_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_substitute_at_depth_three: TestClaim = EqualsClaim {
  label: "lens_application/substitute_at_depth_three: path depth 3 preserves root ancestry",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  lhs: depth_three_expected_root,
  rhs: substitute_at_depth_three_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
