// src/v4/test/claim/lens_application/apply_lens_introspect_rejection_is_advisory.dag
// Scope: T-23 worked claim — Introspect demotes gate rejection to an advisory Violates witness.
// Status: scaffold — compile-only until application.dag fills.

module v4.test.claim.lens_application.apply_lens_introspect_rejection_is_advisory

import v4.compiler.compile {
  CompileLens,
  CompileLensEnforce,
  CompileLensIntrospect,
  apply_compile_lens,
  compile_lens_gate_rejected,
  compile_lens_gate_rejected_diagnostic
}
import v4.compiler.infer { InferredTree }
import v4.std.diagnostic { Accepted, None, Outcome, PortLocus, Rejected, Some, outcome_rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds, Violates, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data apply_lens_mode_symbol: Symbol = apply_lens_mode_symbol
data apply_lens_mode_gate_at: Symbol = apply_lens_mode_gate_at
data apply_lens_mode_type_symbol: Symbol = apply_lens_mode_type_symbol
data apply_lens_mode_algebra_symbol: Symbol = apply_lens_mode_algebra_symbol
data apply_lens_mode_descent_symbol: Symbol = apply_lens_mode_descent_symbol
data apply_lens_mode_root: Node = claim_atom_node(s: apply_lens_mode_symbol)

fn apply_lens_mode_tree() -> InferredTree {
  claim_inferred_tree(
    root: apply_lens_mode_root,
    facts: claim_inferred_facts(
      type_symbol: apply_lens_mode_type_symbol,
      algebra_symbol: apply_lens_mode_algebra_symbol,
      descent_symbol: apply_lens_mode_descent_symbol,
    )
  )
}

fn apply_lens_mode_rejecting_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(at: PortLocus { port: apply_lens_mode_gate_at })
  )
}

data apply_lens_mode_rejecting_lens: CompileLens = CompileLens { gate: apply_lens_mode_rejecting_gate }

fn apply_lens_mode_gate_rejects_enforce() -> Bool {
  match apply_compile_lens(
    lens: apply_lens_mode_rejecting_lens,
    inferred: apply_lens_mode_tree(),
    mode: CompileLensEnforce
  ) {
    Rejected { diagnostics: r } => r.head.reason == compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn apply_lens_mode_gate_is_advisory_in_introspect() -> Bool {
  match apply_compile_lens(
    lens: apply_lens_mode_rejecting_lens,
    inferred: apply_lens_mode_tree(),
    mode: CompileLensIntrospect
  ) {
    Accepted { value: w, diagnostics: ds } =>
      match w {
        Violates { diagnostic: d } =>
          match ds {
            Some { diagnostics: r } =>
              (d.reason == compile_lens_gate_rejected)
                && (r.head.reason == compile_lens_gate_rejected)
            None => false
          }
        Holds { value: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn apply_lens_introspect_rejection_is_advisory_claim_holds() -> Bool {
  apply_lens_mode_gate_rejects_enforce() && apply_lens_mode_gate_is_advisory_in_introspect()
}

fn apply_lens_introspect_rejection_is_advisory_claim_rhs() -> Node {
  if apply_lens_introspect_rejection_is_advisory_claim_holds() {
    apply_lens_mode_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_apply_lens_introspect_rejection_is_advisory: TestClaim = EqualsClaim {
  label: "lens_application/apply_lens_introspect_rejection_is_advisory: Introspect accepts gate rejection as advisory",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: apply_lens_mode_root,
  rhs: apply_lens_introspect_rejection_is_advisory_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
