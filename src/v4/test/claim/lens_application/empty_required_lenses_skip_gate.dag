
module v4.test.claim.lens_application.empty_required_lenses_skip_gate

import v4.compiler.compile {
  CompileOutput,
  TranslateResult,
  TranslateTo,
  Validated,
  compile_lens_gate_rejected,
  validate_then_compile
}
import v4.std.compilers.target_model { TargetModel }
import v4.std.compilers.lexing { VoidLexRules }
import v4.std.diagnostic { Accepted, NonEmptyDiagnostics, Outcome, Rejected }
import v4.std.logic { Bool }
import v4.std.algebra { Empty }
import v4.std.collection { empty_map }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.test.claim.manual.infer_ground_add_mvp { fixture_add_resolved_tree }
data empty_lenses_target_model_stub: TargetModel = TargetModel {
  bundle: Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
},
  lex: VoidLexRules,
  binding_spellings: empty_map(),
  authority_source_text: Empty
}

data empty_lenses_authority_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^empty_lenses_claim_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn non_empty_diagnostics_contain_reason(d: NonEmptyDiagnostics, reason: Symbol) -> Bool {
  if d.head.reason == reason {
    true
  } else {
    fold(d.tail, init: false, f: fn(acc, diag) {
      acc || (diag.reason == reason)
    })
  }
}

fn empty_required_lenses_skip_gate_claim_holds() -> Bool {
  match validate_then_compile(
    source: fixture_add_resolved_tree(),
    lenses: [],
    mode: TranslateTo { target: empty_lenses_target_model_stub }
  ) {
    Rejected { diagnostics: r } =>
      !non_empty_diagnostics_contain_reason(d: r, reason: compile_lens_gate_rejected)
    Accepted { value: v, diagnostics: _ } =>
      match v.value {
        TranslateResult { source: _ } => true
        _ => false
      }
  }
}

fn empty_required_lenses_skip_gate_claim_rhs() -> Node {
  if empty_required_lenses_skip_gate_claim_holds() {
    empty_lenses_authority_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_empty_required_lenses_skip_gate: TestClaim = EqualsClaim {
  label: "lens_application/empty_required_lenses_skip_gate: empty lens list skips gate reject",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: empty_lenses_authority_node,
  rhs: empty_required_lenses_skip_gate_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
