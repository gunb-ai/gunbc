// src/v4/test/claim/lens_application/apply_lens_enforce_introspect_same_gate_today.dag
// Scope: T-23 worked claim — Enforce rejects a failing gate; Introspect admits a failing gate as Accepted(Violates)
//        with the full rejected NonEmptyDiagnostics preserved as advisory Accepted.diagnostics.
// Owns: claim_apply_lens_enforce_introspect_same_gate_today.
// Consumes: compiler compile, lens_common fixture, std verification.
// Status: scaffold — compile-only until application.dag fills full T-23 adapter wiring.

module v4.test.claim.lens_application.apply_lens_enforce_introspect_same_gate_today

import v4.compiler.compile {
  CompileLens,
  CompileLensEnforce,
  CompileLensIntrospect,
  apply_compile_lens,
  compile_lens_gate_rejected,
  compile_lens_gate_rejected_diagnostic
}
import v4.compiler.infer { InferredTree }
import v4.std.diagnostic { Accepted, Diagnostics, None, Outcome, PortLocus, Rejected, Some, outcome_rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds, Violates, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data apply_lens_mode_symbol: Symbol = apply_lens_mode_symbol
data apply_lens_mode_gate_at: Symbol = apply_lens_mode_gate_at
data apply_lens_mode_type_symbol: Symbol = apply_lens_mode_type_symbol
data apply_lens_mode_algebra_symbol: Symbol = apply_lens_mode_algebra_symbol
data apply_lens_mode_descent_symbol: Symbol = apply_lens_mode_descent_symbol
data apply_lens_mode_root: Node = claim_atom_node(s: apply_lens_mode_symbol)

fn apply_lens_mode_tree() -> InferredTree {
  claim_inferred_tree(
    root: apply_lens_mode_root,
    facts: claim_inferred_facts(
      type_symbol: apply_lens_mode_type_symbol,
      algebra_symbol: apply_lens_mode_algebra_symbol,
      descent_symbol: apply_lens_mode_descent_symbol,
    )
  )
}

fn apply_lens_mode_rejecting_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(at: PortLocus { port: apply_lens_mode_gate_at })
  )
}

data apply_lens_mode_rejecting_lens: CompileLens = CompileLens {
  gate: apply_lens_mode_rejecting_gate
}

fn apply_lens_mode_enforce_rejects() -> Bool {
  match apply_compile_lens(
    lens: apply_lens_mode_rejecting_lens,
    inferred: apply_lens_mode_tree(),
    mode: CompileLensEnforce
  ) {
    Rejected { diagnostics: r } => r.head.reason == compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}

// 🟡 gated — feature:v2-nested-match — dissolve-on: v2-compiler supports nested match in arm OR
// T-23 migration deletes apply_compile_lens; forbidden: treating as permanent API surface.
// Extracted only to satisfy the v2-compiler nested-match constraint (Practice 10 derived-operation:
// behavior is fully determined by the Witness variant discriminator).
fn introspect_result_witness_is_violates(w: Witness<Node>) -> Bool {
  match w {
    Violates { diagnostic: _ } => true
    Holds { value: _ } => false
  }
}

// 🟡 gated — feature:v2-nested-match — same constraint as introspect_result_witness_is_violates.
// Pins that introspect demotion threads the full rejected NonEmptyDiagnostics as advisory
// Accepted.diagnostics (Some), not None. Dissolve together with the witness helper above.
fn introspect_result_diagnostics_is_some(od: Diagnostics) -> Bool {
  match od {
    Some { diagnostics: _ } => true
    None => false
  }
}

fn apply_lens_mode_introspect_admits_violates() -> Bool {
  match apply_compile_lens(
    lens: apply_lens_mode_rejecting_lens,
    inferred: apply_lens_mode_tree(),
    mode: CompileLensIntrospect
  ) {
    Accepted { value: w, diagnostics: od } =>
      introspect_result_witness_is_violates(w: w) &&
      introspect_result_diagnostics_is_some(od: od)
    Rejected { diagnostics: _ } => false
  }
}

fn apply_lens_enforce_introspect_same_gate_today_claim_holds() -> Bool {
  apply_lens_mode_enforce_rejects() && apply_lens_mode_introspect_admits_violates()
}

fn apply_lens_enforce_introspect_same_gate_today_claim_rhs() -> Node {
  if apply_lens_enforce_introspect_same_gate_today_claim_holds() {
    apply_lens_mode_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_apply_lens_enforce_introspect_same_gate_today: TestClaim = EqualsClaim {
  label: "lens_application/apply_lens_enforce_introspect_same_gate_today: Enforce rejects; Introspect admits Violates with Some advisory diagnostics",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: apply_lens_mode_root,
  rhs: apply_lens_enforce_introspect_same_gate_today_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
