// src/v4/test/claim/lens_application/apply_lens_enforce_introspect_same_gate_today.dag
// Scope: T-23 worked claim — apply_lens stub routes both modes through gate until application.dag demotes introspect.
// Owns: apply_lens_enforce_introspect_same_gate_today_claim.
// Consumes: compiler compile, lens_common fixture.
// Status: scaffold — compile-only until application.dag fills introspect demotion.

module v4.test.claim.lens_application.apply_lens_enforce_introspect_same_gate_today

import v4.compiler.compile {
  Lens,
  LensApplicationMode,
  LensEnforce,
  LensIntrospect,
  apply_lens
}
import v4.compiler.infer { InferredTree }
import v4.std.diagnostic { Accepted, Outcome }
import v4.std.logic { Bool }
import v4.std.node { Node, Symbol }
import v4.std.witness { Holds, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data apply_lens_mode_root_symbol: Symbol = apply_lens_mode_root_symbol
data apply_lens_mode_type_symbol: Symbol = apply_lens_mode_type_symbol
data apply_lens_mode_algebra_symbol: Symbol = apply_lens_mode_algebra_symbol
data apply_lens_mode_algebra_witness_symbol: Symbol = apply_lens_mode_algebra_witness_symbol
data apply_lens_mode_descent_symbol: Symbol = apply_lens_mode_descent_symbol
data apply_lens_mode_canonical_structural_symbol: Symbol = apply_lens_mode_canonical_structural_symbol
data apply_lens_mode_canonical_closedness_symbol: Symbol = apply_lens_mode_canonical_closedness_symbol
data apply_lens_mode_canonical_evidence_symbol: Symbol = apply_lens_mode_canonical_evidence_symbol

data apply_lens_mode_root: Node = claim_atom_node(s: apply_lens_mode_root_symbol)

fn apply_lens_mode_tree() -> InferredTree {
  claim_inferred_tree(
    root: apply_lens_mode_root,
    facts: claim_inferred_facts(
      type_symbol: apply_lens_mode_type_symbol,
      algebra_symbol: apply_lens_mode_algebra_symbol,
      algebra_witness_symbol: apply_lens_mode_algebra_witness_symbol,
      descent_symbol: apply_lens_mode_descent_symbol,
      canonical_structural_symbol: apply_lens_mode_canonical_structural_symbol,
      canonical_closedness_symbol: apply_lens_mode_canonical_closedness_symbol,
      canonical_evidence_symbol: apply_lens_mode_canonical_evidence_symbol
    )
  )
}

fn apply_lens_mode_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  Accepted { value: Holds { value: apply_lens_mode_root }, diagnostics: None }
}

data apply_lens_mode_lens: Lens = Lens {
  gate: apply_lens_mode_gate
}

type LensApplicationModeParityClaim {
  enforce_accepts: Bool
  introspect_accepts: Bool
}

data apply_lens_enforce_introspect_same_gate_today_claim: LensApplicationModeParityClaim =
  LensApplicationModeParityClaim {
    enforce_accepts: true,
    introspect_accepts: true
  }

fn apply_lens_mode_accepts(mode: LensApplicationMode) -> Bool {
  match apply_lens(lens: apply_lens_mode_lens, inferred: apply_lens_mode_tree(), mode: mode) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn apply_lens_enforce_introspect_same_gate_today_claim_holds() -> Bool {
  apply_lens_mode_accepts(mode: LensEnforce) ==
    apply_lens_enforce_introspect_same_gate_today_claim.enforce_accepts &&
    apply_lens_mode_accepts(mode: LensIntrospect) ==
      apply_lens_enforce_introspect_same_gate_today_claim.introspect_accepts
}

data apply_lens_enforce_introspect_same_gate_today_claim_passes: Bool =
  apply_lens_enforce_introspect_same_gate_today_claim_holds()
