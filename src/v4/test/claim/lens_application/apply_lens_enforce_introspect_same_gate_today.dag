// src/v4/test/claim/lens_application/apply_lens_enforce_introspect_same_gate_today.dag
// Scope: T-23 worked claim — CompileLensEnforce propagates rejection; CompileLensIntrospect demotes rejection to Accepted(Violates).
// Owns: claim_apply_lens_enforce_introspect_same_gate_today.
// Consumes: compiler compile, lens_common fixture, std verification.
// Status: Wave-5-A — scaffold dissolved; introspect demotion implemented in apply_compile_lens_introspect.

module v4.test.claim.lens_application.apply_lens_enforce_introspect_same_gate_today

import v4.compiler.compile {
  CompileLens,
  CompileLensEnforce,
  CompileLensIntrospect,
  apply_compile_lens,
  compile_lens_gate_rejected,
  compile_lens_gate_rejected_diagnostic
}
import v4.compiler.infer { InferredTree }
import v4.std.diagnostic { Accepted, Outcome, PortLocus, Rejected, outcome_rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds, Violates, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data apply_lens_mode_symbol: Symbol = apply_lens_mode_symbol
data apply_lens_mode_gate_at: Symbol = apply_lens_mode_gate_at
data apply_lens_mode_type_symbol: Symbol = apply_lens_mode_type_symbol
data apply_lens_mode_algebra_symbol: Symbol = apply_lens_mode_algebra_symbol
data apply_lens_mode_descent_symbol: Symbol = apply_lens_mode_descent_symbol
data apply_lens_mode_root: Node = claim_atom_node(s: apply_lens_mode_symbol)

fn apply_lens_mode_tree() -> InferredTree {
  claim_inferred_tree(
    root: apply_lens_mode_root,
    facts: claim_inferred_facts(
      type_symbol: apply_lens_mode_type_symbol,
      algebra_symbol: apply_lens_mode_algebra_symbol,
      descent_symbol: apply_lens_mode_descent_symbol,
    )
  )
}

fn apply_lens_mode_rejecting_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(at: PortLocus { port: apply_lens_mode_gate_at })
  )
}

data apply_lens_mode_rejecting_lens: CompileLens = CompileLens {
  gate: apply_lens_mode_rejecting_gate
}

fn apply_lens_mode_gate_rejects_enforce() -> Bool {
  match apply_compile_lens(
    lens: apply_lens_mode_rejecting_lens,
    inferred: apply_lens_mode_tree(),
    mode: CompileLensEnforce
  ) {
    Rejected { diagnostics: r } => r.head.reason == compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn witness_violates_with_gate_reason(w: Witness<Node>) -> Bool {
  match w {
    Violates { diagnostic: d } => d.reason == compile_lens_gate_rejected
    Holds { value: _ } => false
  }
}

fn apply_lens_mode_gate_demotes_introspect() -> Bool {
  match apply_compile_lens(
    lens: apply_lens_mode_rejecting_lens,
    inferred: apply_lens_mode_tree(),
    mode: CompileLensIntrospect
  ) {
    Accepted { value: w, diagnostics: _ } => witness_violates_with_gate_reason(w: w)
    Rejected { diagnostics: _ } => false
  }
}

fn apply_lens_enforce_introspect_same_gate_today_claim_holds() -> Bool {
  apply_lens_mode_gate_rejects_enforce() && apply_lens_mode_gate_demotes_introspect()
}

fn apply_lens_enforce_introspect_same_gate_today_claim_rhs() -> Node {
  if apply_lens_enforce_introspect_same_gate_today_claim_holds() {
    apply_lens_mode_root
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_apply_lens_enforce_introspect_same_gate_today: TestClaim = EqualsClaim {
  label: "lens_application/apply_lens_enforce_introspect_same_gate_today: enforce propagates rejection, introspect demotes to Accepted(Violates)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: apply_lens_mode_root,
  rhs: apply_lens_enforce_introspect_same_gate_today_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
