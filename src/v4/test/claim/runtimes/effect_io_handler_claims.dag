// src/v4/test/claim/runtimes/effect_io_handler_claims.dag
// Scope: Wave-2 M-E2 gate — ReadResource→WriteResource round-trip via real EffectHandlerBinding
//   inhabitants (pure/test + host bundle wiring). Executable Bool witnesses for --claim-run.
// Status: E-10 consumer for v4.extdeps.runtimes.v4_effect_io_{pure,host}.dag.

module v4.test.claim.runtimes.effect_io_handler_claims

import v4.extdeps.runtimes.v4_effect_io_host {
  V4EffectIoHostRuntime,
  effect_io_host_read_handler,
  effect_io_host_runtime_wave2
}
import v4.extdeps.runtimes.v4_effect_io_pure {
  EffectIoResourceBackend,
  EffectIoResourceLocator,
  FileResourceBackend,
  HttpResourceBackend,
  StorageResourceBackend,
  effect_io_pure_read_request,
  effect_io_pure_read_write_roundtrip,
  effect_io_pure_unit_type_node
}
import v4.std.algebra { Cons, Empty }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.runtime {
  EffectHandler,
  RuntimeUnit,
  RuntimeUnitValue,
  RuntimeValue
}
import v4.std.verification { BoolWitness, BoolWitnessClaim, UnifiedTestClaim }

fn effect_io_claim_locator(backend: EffectIoResourceBackend) -> EffectIoResourceLocator {
  EffectIoResourceLocator {
    backend: backend,
    identity: ^effect_io_pure_default_locator
  }
}

fn effect_io_claim_locator_arg() -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue {
      unit_type: effect_io_pure_unit_type_node()
    }
  }
}

fn effect_io_claim_payload() -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue {
      unit_type: effect_io_pure_unit_type_node()
    }
  }
}

fn effect_io_pure_file_roundtrip_holds() -> Bool {
  effect_io_pure_read_write_roundtrip(
    backend: FileResourceBackend,
    locator: effect_io_claim_locator(backend: FileResourceBackend),
    payload: effect_io_claim_payload(),
    locator_arg: effect_io_claim_locator_arg()
  )
}

fn effect_io_pure_http_roundtrip_holds() -> Bool {
  effect_io_pure_read_write_roundtrip(
    backend: HttpResourceBackend,
    locator: effect_io_claim_locator(backend: HttpResourceBackend),
    payload: effect_io_claim_payload(),
    locator_arg: effect_io_claim_locator_arg()
  )
}

fn effect_io_pure_storage_roundtrip_holds() -> Bool {
  effect_io_pure_read_write_roundtrip(
    backend: StorageResourceBackend,
    locator: effect_io_claim_locator(backend: StorageResourceBackend),
    payload: effect_io_claim_payload(),
    locator_arg: effect_io_claim_locator_arg()
  )
}

fn effect_io_host_binding_inhabited(runtime: V4EffectIoHostRuntime) -> Bool {
  match runtime.handlers.read_resource {
    EffectHandler { handle: effect_io_host_read_handler } => true
    _ => false
  }
}

// Host bundle: handlers inhabit EffectHandlerBinding and fail-closed until host_run lands.
fn effect_io_host_read_fail_closed_holds() -> Bool {
  let runtime = effect_io_host_runtime_wave2(backend: FileResourceBackend)
  let read_args = Cons {
    head: effect_io_claim_locator_arg(),
    tail: Empty
  }
  if effect_io_host_binding_inhabited(runtime: runtime) {
    match effect_io_host_read_handler(request: effect_io_pure_read_request(args: read_args)) {
      Rejected { diagnostics: _ } => true
      Accepted { value: _, diagnostics: _ } => false
    }
  } else {
    false
  }
}

data unified_claim_effect_io_pure_file_roundtrip: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/runtimes/effect_io_handler_claims.dag",
    function: effect_io_pure_file_roundtrip_holds
  }
}

data unified_claim_effect_io_pure_http_roundtrip: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/runtimes/effect_io_handler_claims.dag",
    function: effect_io_pure_http_roundtrip_holds
  }
}

data unified_claim_effect_io_pure_storage_roundtrip: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/runtimes/effect_io_handler_claims.dag",
    function: effect_io_pure_storage_roundtrip_holds
  }
}

data unified_claim_effect_io_host_read_fail_closed: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/runtimes/effect_io_handler_claims.dag",
    function: effect_io_host_read_fail_closed_holds
  }
}

