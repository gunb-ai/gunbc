// src/v4/test/claim/lens_unit_modeling/modeled_unit_field_admitted_via_always_required_lenses.dag
// Scope: REGISTRATION witness (PASS arm) — proves unit_modeling_lens, now in
//        always_required_lenses(), does NOT false-positive a correctly-modeled field.
//        The SAME `ram_bytes` field attached to a `ByteSize` carrier (not a bare Int leaf)
//        is ADMITTED by the full roster (both fact_density and unit_modeling Accept).
//        Pairs with unit_modeling_blocked_via_always_required_lenses.dag (FAIL arm) — the
//        two differ ONLY in the field's resolved leaf type, so together they prove the
//        registered lens discriminates on the modeled type, not the field name alone.
// Status: scaffold — compile-only until the v4 claim harness executes it.

module v4.test.claim.lens_unit_modeling.modeled_unit_field_admitted_via_always_required_lenses

import v4.compiler.compile {
  always_required_lenses,
  run_required_lens_gates
}
import v4.compiler.infer { InferredTree }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

// Field target resolved to the `ByteSize` carrier — a correctly-modeled unit field,
// NOT the bare kernel `Int` binding.
data unit_ar_pass_carrier_target: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^ByteSize } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

// Same `ram_bytes` field as the FAIL arm, attached to the ByteSize carrier — both
// fact_density (fact-bundle) and unit_modeling (modeled leaf) Accept.
data unit_ar_pass_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^ram_bytes },
      target: unit_ar_pass_carrier_target
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data unit_ar_pass_authority: Node = claim_atom_node(s: ^unit_ar_pass_symbol)

fn unit_ar_pass_tree() -> InferredTree {
  claim_inferred_tree(
    root: unit_ar_pass_root,
    facts: claim_inferred_facts(
      type_symbol: ^unit_ar_pass_type_sym,
      algebra_symbol: ^unit_ar_pass_algebra_sym,
      descent_symbol: ^unit_ar_pass_descent_sym
    )
  )
}

fn modeled_unit_field_admitted_via_always_required_lenses_holds() -> Bool {
  match run_required_lens_gates(
    inferred: unit_ar_pass_tree(),
    lenses: always_required_lenses()
  ) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn modeled_unit_field_admitted_via_always_required_lenses_rhs() -> Node {
  if modeled_unit_field_admitted_via_always_required_lenses_holds() {
    unit_ar_pass_authority
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_modeled_unit_field_admitted_via_always_required_lenses: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/modeled_unit_field_admitted_via_always_required_lenses: always_required_lenses() admits a ram_bytes field attached to a ByteSize carrier",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: unit_ar_pass_authority,
  rhs: modeled_unit_field_admitted_via_always_required_lenses_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
