// src/v4/test/claim/lens_unit_modeling/structural_int_not_flagged.dag
// Scope: B1 unit-modeling lens — DISCRIMINATOR (d). A structural/spec `Int` that
//        is a COORDINATE (here `matrix_index`, an array index) MUST NOT be
//        flagged: addition on a coordinate is meaningless (index 4 + index 4 is
//        not position 8), so it is not a unit-bearing count and is exempt per
//        the additive-cardinality test. Bonus discipline: `matrix_index`
//        contains the substring "index" yet is correctly exempt because the
//        token table is EXACT-Symbol-keyed, never substring — proving the lens
//        neither over-flags a legit bare Int nor misfires on substrings.
//        (Counts like `thread_count` ARE in scope and ARE flagged — covered by
//        flat_scalar_unit_leaf_flagged.dag; this is the opposite, exempt side.)
// Status: scaffold — compile-only until the build-infra greens and the v4 claim
//         harness executes it.

module v4.test.claim.lens_unit_modeling.structural_int_not_flagged

import v4.lens.unit_modeling { unit_modeling_gate }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data int_leaf_target_struct: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

// `matrix_index` is a coordinate (array index) — a structural Int. Not a unit
// token, so it must pass; and it contains "index" as a substring, so passing
// also proves exact-Symbol-keyed (non-substring) exemption.
data structural_int_field_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^matrix_index },
      target: int_leaf_target_struct
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn structural_int_not_flagged_holds() -> Bool {
  match unit_modeling_gate(node: structural_int_field_input) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn structural_int_not_flagged_rhs() -> Node {
  if structural_int_not_flagged_holds() {
    structural_int_field_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_structural_int_not_flagged: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/structural: matrix_index coordinate (bare Int) is not flagged",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: structural_int_field_input,
  rhs: structural_int_not_flagged_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
