// src/v4/test/claim/lens_unit_modeling/electrical_pending_not_flagged.dag
// Scope: B1 unit-modeling lens — DISCRIMINATOR (c). A GATE-2-pending electrical
//        unit field (`tdp_watts`) typed as a bare kernel `Int` MUST NOT be
//        flagged: electrical quantities (volts/amps/ohms/watts) have no carrier
//        yet (Power/etc. are not in the Quantity catalog), so they are
//        deliberately EXCLUDED from the token table. The lens must not demand a
//        fix it cannot point at — it classifies electrical as pending (passes),
//        not as flag-as-fixable-now. Proves the GATE-2 deferral.
// Status: scaffold — compile-only until the build-infra greens and the v4 claim
//         harness executes it.

module v4.test.claim.lens_unit_modeling.electrical_pending_not_flagged

import v4.lens.unit_modeling { unit_modeling_gate }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data int_leaf_target_elec: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

// `tdp_watts` is a genuine unit field (Power), but Power is GATE-2-pending with
// no carrier — so it is NOT in the token table and must pass, not flag.
data electrical_field_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^tdp_watts },
      target: int_leaf_target_elec
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn electrical_pending_not_flagged_holds() -> Bool {
  match unit_modeling_gate(node: electrical_field_input) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn electrical_pending_not_flagged_rhs() -> Node {
  if electrical_pending_not_flagged_holds() {
    electrical_field_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_electrical_pending_not_flagged: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/electrical: GATE-2-pending tdp_watts (bare Int) is not flagged",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: electrical_field_input,
  rhs: electrical_pending_not_flagged_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
