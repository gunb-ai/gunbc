// src/v4/test/claim/lens_unit_modeling/flat_scalar_unit_leaf_flagged.dag
// Scope: B1 unit-modeling lens — FAIL/flag witness. A Named unit-token field
//        (`ram_bytes`) typed as a bare kernel `Int` leaf MUST be flagged
//        (gate Rejected). Pairs with modeled_unit_field_passes.dag (same field
//        name, attached to a carrier → Accepted) — the two differ ONLY in the
//        leaf type, so together they prove the lens discriminates on the type,
//        not the name alone.
// Status: scaffold — compile-only until the build-infra greens and the v4 claim
//         harness executes it (then this is the lens's by-execution FAIL sign).

module v4.test.claim.lens_unit_modeling.flat_scalar_unit_leaf_flagged

import v4.lens.unit_modeling { unit_modeling_gate }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

// A field target whose resolved type is the bare kernel `Int` binding.
data int_leaf_target: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

// A carrier with one Named unit-token field (`ram_bytes`) typed as bare `Int` —
// the exact flat-scalar unit leaf the lens exists to catch.
data flat_scalar_unit_leaf_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^ram_bytes },
      target: int_leaf_target
    }
  ],
  occurrence_id: SyntheticOccurrence
}

// ram_bytes has a KNOWN carrier (ByteSize) in the hint map, so the flag is the
// FIXABLE-NOW class — assert both the flag AND the class.
fn flat_scalar_unit_leaf_flagged_holds() -> Bool {
  match unit_modeling_gate(node: flat_scalar_unit_leaf_input) {
    Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_unit_leaf_fixable
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn flat_scalar_unit_leaf_flagged_rhs() -> Node {
  if flat_scalar_unit_leaf_flagged_holds() {
    flat_scalar_unit_leaf_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_flat_scalar_unit_leaf_flagged: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/flag: ram_bytes typed bare Int is rejected (flat-scalar unit leaf)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: flat_scalar_unit_leaf_input,
  rhs: flat_scalar_unit_leaf_flagged_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
