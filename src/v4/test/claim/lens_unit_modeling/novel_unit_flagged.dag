// src/v4/test/claim/lens_unit_modeling/novel_unit_flagged.dag
// Scope: B1 unit-modeling lens — THE inversion witness. A NOVEL unit field with
//        an UNRECOGNIZED name (`throughput`) typed as a bare kernel `Int` is NOW
//        FLAGGED — the token-keyed predecessor would have silently MISSED it (the
//        false-negative the flag-by-default inversion exists to kill). Since
//        `throughput` has no known carrier in the hint map, the flag is the
//        BLOCKED-PENDING-CARRIER class (escalate the upstream carrier gate; no
//        fix-suggestion) — proving the two-class diagnostic for novel quantities.
// Status: scaffold — compile-only until the build-infra greens and the v4 claim
//         harness executes it.

module v4.test.claim.lens_unit_modeling.novel_unit_flagged

import v4.lens.unit_modeling { unit_modeling_gate }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data int_leaf_target_novel: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

// `throughput` is a genuine quantity but NOT in the carrier-hint map and NOT a
// label/coordinate — so default-flag fires, in the blocked-pending class.
data novel_unit_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^throughput },
      target: int_leaf_target_novel
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn novel_unit_flagged_holds() -> Bool {
  match unit_modeling_gate(node: novel_unit_input) {
    Rejected { diagnostics: r } => r.head.reason == ^unit_modeling_flat_scalar_blocked_pending_carrier
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn novel_unit_flagged_rhs() -> Node {
  if novel_unit_flagged_holds() {
    novel_unit_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_novel_unit_flagged: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/novel: unrecognized unit throughput:Int is flagged (blocked-pending class)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: novel_unit_input,
  rhs: novel_unit_flagged_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
