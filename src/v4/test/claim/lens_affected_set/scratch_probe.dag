module v4.test.claim.lens_affected_set.scratch_probe

import v4.lens.affected_set { ChangedSubgraphFrontier, DimensionNotRead, ExclusionKey, FailClosed, FrontierDecision, Excluded, PropagationExclusionProof, ReExecFrontier, empty_frontier, mark_excluded }
import v4.lens.affected_set_examples { affected_set_example_dimension, affected_set_example_node }
import v4.std.logic { Bool }
import v4.std.collection { Absent, Present, map_get }
import v4.std.diagnostic { Accepted, Rejected }

fn key() -> ExclusionKey { ExclusionKey { at: affected_set_example_node, dimension: affected_set_example_dimension } }
fn proof() -> PropagationExclusionProof { DimensionNotRead { usage_site: affected_set_example_node, changed_dimension: affected_set_example_dimension } }
fn dbl() -> ReExecFrontier { mark_excluded(frontier: mark_excluded(frontier: empty_frontier(), key: key(), proof: proof()), key: key(), proof: proof()) }
fn expected_excluded() -> FrontierDecision { Excluded { first: proof(), rest: [proof()] } }

fn p11_semantic() -> Bool {
  match dbl() {
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: d } =>
      match map_get(d, key()) {
        Accepted { value: opt, diagnostics: _ } =>
          match opt {
            Present { value: dec } => dec == expected_excluded()
            Absent => false
          }
        Rejected { diagnostics: _ } => false
      }
    FailClosed { reason: _ } => false
  }
}

fn single() -> ReExecFrontier { mark_excluded(frontier: empty_frontier(), key: key(), proof: proof()) }
fn p12_single_control() -> Bool {
  match single() {
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: d } =>
      match map_get(d, key()) {
        Accepted { value: opt, diagnostics: _ } =>
          match opt {
            Present { value: dec } => dec == expected_excluded()
            Absent => false
          }
        Rejected { diagnostics: _ } => false
      }
    FailClosed { reason: _ } => false
  }
}
