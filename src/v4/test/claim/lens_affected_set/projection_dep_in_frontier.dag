// src/v4/test/claim/lens_affected_set/projection_dep_in_frontier.dag
// Scope: T-21 worked claim — ProjectionDependsOn is in the lens frontier kind set.
// Owns: projection_dep_in_frontier_claim.
// Consumes: lens affected_set, std dependency, std node.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_affected_set.projection_dep_in_frontier

import v4.lens.affected_set { dependency_in_lens_frontier }
import v4.std.dependency { DependencyView, ProjectionDependsOn }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }

data projection_dep_root_symbol: Symbol = projection_dep_root_symbol
data projection_dep_child_symbol: Symbol = projection_dep_child_symbol

type LensAffectedSetFrontierClaim {
  dependency: DependencyView
  expected_in_frontier: Bool
}

fn projection_dep_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}

data projection_dep_dependency: DependencyView = DependencyView {
  source: projection_dep_node(s: projection_dep_root_symbol),
  dependent: projection_dep_node(s: projection_dep_child_symbol),
  kind: ProjectionDependsOn,
  usage_site: projection_dep_node(s: projection_dep_child_symbol)
}

data projection_dep_in_frontier_claim: LensAffectedSetFrontierClaim = LensAffectedSetFrontierClaim {
  dependency: projection_dep_dependency,
  expected_in_frontier: true
}

fn projection_dep_in_frontier_claim_holds() -> Bool {
  dependency_in_lens_frontier(dependency: projection_dep_in_frontier_claim.dependency) ==
    projection_dep_in_frontier_claim.expected_in_frontier
}

data projection_dep_in_frontier_claim_passes: Bool = projection_dep_in_frontier_claim_holds()
