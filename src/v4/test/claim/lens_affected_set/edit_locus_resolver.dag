// src/v4/test/claim/lens_affected_set/edit_locus_resolver.dag
// Scope: git diff → edit_locus Node resolver receipts (path-regex bindings).
// Status: T-21 wire claim; host git projection lands with BinaryShim runner.

module v4.test.claim.lens_affected_set.edit_locus_resolver

import v4.lens.edit_locus {
  EditLocusBinding,
  EditLocusRead,
  GitDiffNameOnly,
  PathRegex,
  RepoPath,
  affected_set_reading_from_git_diff,
  resolve_edit_locus
}
import v4.std.logic { Bool }
import v4.std.algebra { Empty, length }
import v4.std.node { Symbol }
import v4.std.text { String }
import v4.std.witness { Holds, Violates, Witness }
import v4.test.claim.lens_affected_set.node_precision {
  affected_set_claim_tree,
  affected_set_mid,
  affected_set_mid_to_leaf_frontier_dependency,
  affected_set_root_to_mid_frontier_dependency
}

data edit_locus_path_src_v4_affected_set: RepoPath = "src/v4/lens/affected_set.dag"
data edit_locus_path_unknown: RepoPath = "src/v4/lens/unknown_path.dag"
data edit_locus_pattern_v4_lens: PathRegex = edit_locus_pattern_v4_lens

fn edit_locus_fixture_path_regex_matches(changed: RepoPath, pattern: PathRegex) -> Bool {
  match pattern {
    edit_locus_pattern_v4_lens => changed == edit_locus_path_src_v4_affected_set
    _ => false
  }
}

data edit_locus_fixture_read: EditLocusRead = EditLocusRead {
  path_regex_matches: edit_locus_fixture_path_regex_matches
}

data edit_locus_v4_binding: EditLocusBinding = EditLocusBinding {
  pattern: edit_locus_pattern_v4_lens,
  locus: affected_set_mid
}

data edit_locus_narrow_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [edit_locus_path_src_v4_affected_set]
}

data edit_locus_unknown_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [edit_locus_path_unknown]
}

fn edit_locus_narrow_resolution_holds() -> Bool {
  match resolve_edit_locus(
    read: edit_locus_fixture_read,
    git_diff: edit_locus_narrow_git_diff,
    bindings: [edit_locus_v4_binding]
  ) {
    Holds { value: locus } => locus == affected_set_mid
    Violates { diagnostic: _ } => false
  }
}

fn edit_locus_fail_closed_holds() -> Bool {
  match resolve_edit_locus(
    read: edit_locus_fixture_read,
    git_diff: edit_locus_unknown_git_diff,
    bindings: [edit_locus_v4_binding]
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

fn edit_locus_affected_set_wire_holds() -> Bool {
  match affected_set_reading_from_git_diff(
    edit_read: edit_locus_fixture_read,
    graph: affected_set_claim_tree(),
    git_diff: edit_locus_narrow_git_diff,
    bindings: [edit_locus_v4_binding]
  ) {
    Holds { value: reading } =>
      (reading.edit_locus == affected_set_mid)
        && (length(xs: reading.affected) == 3)
        && (reading.dependencies == [affected_set_root_to_mid_frontier_dependency, affected_set_mid_to_leaf_frontier_dependency])
    Violates { diagnostic: _ } => false
  }
}

fn edit_locus_affected_set_wire_fail_closed_holds() -> Bool {
  match affected_set_reading_from_git_diff(
    edit_read: edit_locus_fixture_read,
    graph: affected_set_claim_tree(),
    git_diff: edit_locus_unknown_git_diff,
    bindings: [edit_locus_v4_binding]
  ) {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}

data edit_locus_narrow_resolution_claim_passes: Bool = edit_locus_narrow_resolution_holds()
data edit_locus_fail_closed_claim_passes: Bool = edit_locus_fail_closed_holds()
data edit_locus_affected_set_wire_claim_passes: Bool = edit_locus_affected_set_wire_holds()
data edit_locus_affected_set_wire_fail_closed_claim_passes: Bool = edit_locus_affected_set_wire_fail_closed_holds()
