// src/v4/test/claim/lens_affected_set/boundary_prune_receipt.dag
// Scope: T-21 worked claim — unchanged-pure boundary edit records BoundaryExclusion.
// Owns: boundary_prune_receipt_claim.
// Consumes: lens affected_set, lens affected_set_examples, std node.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_affected_set.boundary_prune_receipt

import v4.lens.affected_set {
  ReExecFrontier,
  empty_frontier,
  mark_boundary_excluded
}
import v4.lens.affected_set_examples {
  affected_set_example_edit,
  affected_set_example_hash,
  expected_affected_set_boundary_prune
}
import v4.lens.affected_set { UnchangedPureBoundary }
import v4.std.logic { Bool }

type LensAffectedSetFrontierReceiptClaim {
  actual: ReExecFrontier
  expected: ReExecFrontier
}

fn boundary_prune_receipt_actual() -> ReExecFrontier {
  mark_boundary_excluded(
    frontier: empty_frontier(),
    edit: affected_set_example_edit,
    proof: UnchangedPureBoundary { content_hash: affected_set_example_hash }
  )
}

data boundary_prune_receipt_claim: LensAffectedSetFrontierReceiptClaim = LensAffectedSetFrontierReceiptClaim {
  actual: boundary_prune_receipt_actual(),
  expected: expected_affected_set_boundary_prune
}

fn boundary_prune_receipt_claim_holds() -> Bool {
  boundary_prune_receipt_claim.actual == boundary_prune_receipt_claim.expected
}

data boundary_prune_receipt_claim_passes: Bool = boundary_prune_receipt_claim_holds()
