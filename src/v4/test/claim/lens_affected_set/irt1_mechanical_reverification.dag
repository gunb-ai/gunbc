// src/v4/test/claim/lens_affected_set/irt1_mechanical_reverification.dag
// Scope: MechanicalReverification receipt for affected_set_irt1_subsumption (DissolutionSubsumption row).
// Owns: claim_affected_set_irt1_mechanical_reverification.
// Consumes: lens affected_set, lens affected_set_examples, std diagnostic, std node, std verification, std witness.
// Status: structural receipt — subsumption.dag TestClaimId handle affected_set_irt1_mechanical_reverification_claim.

module v4.test.claim.lens_affected_set.irt1_mechanical_reverification

import v4.lens.affected_set {
  AffectedFoldAcc,
  DimensionNotRead,
  ExclusionKey,
  UnchangedPureBoundary,
  empty_affected_fold_acc,
  empty_frontier,
  frontier_from_fold_acc,
  mark_boundary_excluded,
  mark_excluded,
  mark_rerun,
  re_exec_frontier_from_diff,
  seed_edit_fold_acc
}
import v4.lens.affected_set_examples {
  affected_set_claim_failure_node,
  affected_set_example_dimension,
  affected_set_example_edit,
  affected_set_example_hash,
  affected_set_example_invalid_edit_diagnostic,
  affected_set_example_node,
  affected_set_example_post_edit_accepts,
  affected_set_example_post_edit_rejects,
  affected_set_example_read,
  affected_set_example_two_edit_diff,
  expected_affected_set_boundary_prune,
  expected_affected_set_dimension_seed,
  expected_affected_set_excluded_proofs,
  expected_affected_set_rejected_edit_fail_closed
}
import v4.std.diagnostic { None, Some, diagnostics_singleton }
import v4.std.logic { Bool }
import v4.std.node { Conj, Node, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds }

fn irt1_boundary_prune_receipt_holds() -> Bool {
  mark_boundary_excluded(
    frontier: empty_frontier(),
    edit: affected_set_example_edit,
    proof: UnchangedPureBoundary { content_hash: affected_set_example_hash }
  ) == expected_affected_set_boundary_prune
}

fn irt1_dimension_seed_receipt_holds() -> Bool {
  mark_rerun(
    frontier: empty_frontier(),
    key: ExclusionKey {
      at: affected_set_example_node,
      dimension: affected_set_example_dimension
    }
  ) == expected_affected_set_dimension_seed
}

fn irt1_excluded_propagation_receipt_holds() -> Bool {
  mark_excluded(
    frontier: mark_excluded(
      frontier: empty_frontier(),
      key: ExclusionKey {
        at: affected_set_example_node,
        dimension: affected_set_example_dimension
      },
      proof: DimensionNotRead {
        usage_site: affected_set_example_node,
        changed_dimension: affected_set_example_dimension
      }
    ),
    key: ExclusionKey {
      at: affected_set_example_node,
      dimension: affected_set_example_dimension
    },
    proof: DimensionNotRead {
      usage_site: affected_set_example_node,
      changed_dimension: affected_set_example_dimension
    }
  ) == expected_affected_set_excluded_proofs
}

fn irt1_pending_escalation_receipt_holds() -> Bool {
  frontier_from_fold_acc(
    acc: AffectedFoldAcc {
      dag: affected_set_example_node,
      frontier: empty_frontier(),
      pending: Some {
        diagnostics: diagnostics_singleton(d: affected_set_example_invalid_edit_diagnostic)
      }
    }
  ) == expected_affected_set_rejected_edit_fail_closed
}

fn irt1_seed_edit_fold_acc_absorbs_fail_closed() -> Bool {
  let fail_closed = AffectedFoldAcc {
    dag: affected_set_example_node,
    frontier: expected_affected_set_rejected_edit_fail_closed,
    pending: None
  }
  seed_edit_fold_acc(
    read_model: affected_set_example_read,
    post_edit_dag: affected_set_example_post_edit_accepts,
    acc: fail_closed,
    edit: affected_set_example_edit
  ) == fail_closed
}

fn irt1_re_exec_frontier_from_diff_absorbs_after_fail_closed() -> Bool {
  match re_exec_frontier_from_diff(
    read_model: affected_set_example_read,
    post_edit_dag: affected_set_example_post_edit_rejects,
    dag: affected_set_example_node,
    diff: affected_set_example_two_edit_diff
  ) {
    Holds { value: frontier } => frontier == expected_affected_set_rejected_edit_fail_closed
    _ => false
  }
}

fn irt1_fail_closed_absorbs_later_edits() -> Bool {
  irt1_seed_edit_fold_acc_absorbs_fail_closed()
    && irt1_re_exec_frontier_from_diff_absorbs_after_fail_closed()
}

fn irt1_empty_diff_fold_is_empty_frontier() -> Bool {
  frontier_from_fold_acc(
    acc: empty_affected_fold_acc(dag: affected_set_example_node)
  ) == empty_frontier()
}

fn irt1_mechanical_reverification_claim_holds() -> Bool {
  irt1_boundary_prune_receipt_holds()
    && irt1_dimension_seed_receipt_holds()
    && irt1_excluded_propagation_receipt_holds()
    && irt1_pending_escalation_receipt_holds()
    && irt1_fail_closed_absorbs_later_edits()
    && irt1_empty_diff_fold_is_empty_frontier()
}

fn irt1_mechanical_reverification_claim_rhs() -> Node {
  if irt1_mechanical_reverification_claim_holds() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

data claim_affected_set_irt1_mechanical_reverification: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_mechanical_reverification: frontier fold subsumes leaf receipt behaviors",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_mechanical_reverification_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
