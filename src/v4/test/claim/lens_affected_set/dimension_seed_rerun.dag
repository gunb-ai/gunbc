// src/v4/test/claim/lens_affected_set/dimension_seed_rerun.dag
// Scope: T-21 worked claim — changed dimension seeds a Rerun decision at the replacement node.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_affected_set.dimension_seed_rerun

import v4.lens.affected_set {
  ExclusionKey,
  empty_frontier,
  mark_rerun
}
import v4.lens.affected_set_examples {
  affected_set_example_node,
  expected_affected_set_dimension_seed
}
import v4.std.logic { Bool }
import v4.std.node { Conj, Node, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn dimension_seed_rerun_claim_holds() -> Bool {
  mark_rerun(
    frontier: empty_frontier(),
    key: ExclusionKey {
      at: affected_set_example_node,
      dimension: ^affected_set_example_dimension
    }
  ) == expected_affected_set_dimension_seed
}

fn dimension_seed_rerun_claim_rhs() -> Node {
  if dimension_seed_rerun_claim_holds() {
    affected_set_example_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_dimension_seed_rerun: TestClaim = EqualsClaim {
  label: "lens_affected_set/dimension_seed_rerun: dimension change seeds Rerun",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: dimension_seed_rerun_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
