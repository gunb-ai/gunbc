// src/v4/test/claim/lens_affected_set/dimension_seed_rerun.dag
// Scope: T-21 worked claim — changed dimension seeds a Rerun decision at the replacement node.
// Owns: dimension_seed_rerun_claim.
// Consumes: lens affected_set, lens affected_set_examples, std node.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_affected_set.dimension_seed_rerun

import v4.lens.affected_set {
  ExclusionKey,
  ReExecFrontier,
  empty_frontier,
  mark_rerun
}
import v4.lens.affected_set_examples {
  affected_set_example_dimension,
  affected_set_example_node,
  expected_affected_set_dimension_seed
}
import v4.std.logic { Bool }

type LensAffectedSetFrontierReceiptClaim {
  actual: ReExecFrontier
  expected: ReExecFrontier
}

fn dimension_seed_rerun_actual() -> ReExecFrontier {
  mark_rerun(
    frontier: empty_frontier(),
    key: ExclusionKey {
      at: affected_set_example_node,
      dimension: affected_set_example_dimension
    }
  )
}

data dimension_seed_rerun_claim: LensAffectedSetFrontierReceiptClaim = LensAffectedSetFrontierReceiptClaim {
  actual: dimension_seed_rerun_actual(),
  expected: expected_affected_set_dimension_seed
}

fn dimension_seed_rerun_claim_holds() -> Bool {
  dimension_seed_rerun_claim.actual == dimension_seed_rerun_claim.expected
}

data dimension_seed_rerun_claim_passes: Bool = dimension_seed_rerun_claim_holds()
