// src/v4/test/claim/lens_affected_set/node_precision.dag
// Scope: affected-set reading claim for Node-level edit/rebuild precision.
// Status: T-21 claim data; runner execution lands with generated TestClaim harness.


module v4.test.claim.lens_affected_set.node_precision

import v4.compiler.infer { InferredFacts, InferredTree }
import v4.lens.affected_set { AffectedSetReading, affected_set }
import v4.std.dependency { Contains, DependencyView }
import v4.std.logic { Bool }
import v4.std.node { Atom, Edge, Named, Node, Symbol, TypeNode }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data affected_set_root_symbol: Symbol = affected_set_root_symbol
data affected_set_mid_symbol: Symbol = affected_set_mid_symbol
data affected_set_leaf_symbol: Symbol = affected_set_leaf_symbol
data affected_set_root_edge_symbol: Symbol = affected_set_root_edge_symbol
data affected_set_mid_edge_symbol: Symbol = affected_set_mid_edge_symbol
data affected_set_type_symbol: Symbol = affected_set_type_symbol
data affected_set_algebra_symbol: Symbol = affected_set_algebra_symbol
data affected_set_descent_symbol: Symbol = affected_set_descent_symbol
data affected_set_leaf: Node = claim_atom_node(s: affected_set_leaf_symbol)

data affected_set_mid: Node = Node {
  kind: TypeNode { connective: Atom { identity: affected_set_mid_symbol } },
  children: [
    Edge { label: Named { name: affected_set_mid_edge_symbol }, target: affected_set_leaf }
  ]
}

data affected_set_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: affected_set_root_symbol } },
  children: [
    Edge { label: Named { name: affected_set_root_edge_symbol }, target: affected_set_mid }
  ]
}

fn affected_set_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: affected_set_type_symbol,
    algebra_symbol: affected_set_algebra_symbol,
    descent_symbol: affected_set_descent_symbol,
  )
}

fn affected_set_claim_tree() -> InferredTree {
  claim_inferred_tree(root: affected_set_root, facts: affected_set_claim_facts())
}

data affected_set_mid_to_leaf_dependency: DependencyView = DependencyView {
  source: affected_set_mid,
  dependent: affected_set_leaf,
  kind: Contains,
  usage_site: affected_set_leaf
}

type LensAffectedSetClaim {
  input: InferredTree
  edit_locus: Node
  expected: AffectedSetReading
  actual: AffectedSetReading
}

data affected_set_node_precision_claim: LensAffectedSetClaim = LensAffectedSetClaim {
  input: affected_set_claim_tree(),
  edit_locus: affected_set_mid,
  expected: AffectedSetReading {
    edit_locus: affected_set_mid,
    affected: [affected_set_mid, affected_set_leaf],
    dependencies: [affected_set_mid_to_leaf_dependency]
  },
  actual: affected_set(graph: affected_set_claim_tree(), edit_locus: affected_set_mid)
}

fn affected_set_node_precision_claim_holds() -> Bool {
  affected_set_node_precision_claim.actual.edit_locus == affected_set_node_precision_claim.expected.edit_locus
    && affected_set_node_precision_claim.actual.affected == affected_set_node_precision_claim.expected.affected
    && affected_set_node_precision_claim.actual.dependencies == affected_set_node_precision_claim.expected.dependencies
}

data affected_set_node_precision_claim_passes: Bool = affected_set_node_precision_claim_holds()
