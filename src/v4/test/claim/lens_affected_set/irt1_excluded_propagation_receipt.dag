// src/v4/test/claim/lens_affected_set/irt1_excluded_propagation_receipt.dag
// Scope: IRT-1 leaf — excluded-dimension propagation receipt.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_affected_set.irt1_excluded_propagation_receipt

import v4.lens.affected_set { DimensionNotRead, ExclusionKey, empty_frontier, mark_excluded }
import v4.lens.affected_set_examples {
  affected_set_claim_failure_node,
  affected_set_example_node,
  expected_affected_set_excluded_proofs
}
import v4.std.logic { Bool }
import v4.std.node { Node }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn irt1_excluded_propagation_receipt_claim_holds() -> Bool {
  mark_excluded(
    frontier: mark_excluded(
      frontier: empty_frontier(),
      key: ExclusionKey {
        at: affected_set_example_node,
        dimension: ^affected_set_example_dimension
      },
      proof: DimensionNotRead {
        usage_site: affected_set_example_node,
        changed_dimension: ^affected_set_example_dimension
      }
    ),
    key: ExclusionKey {
      at: affected_set_example_node,
      dimension: ^affected_set_example_dimension
    },
    proof: DimensionNotRead {
      usage_site: affected_set_example_node,
      changed_dimension: ^affected_set_example_dimension
    }
  ) == expected_affected_set_excluded_proofs
}

fn irt1_excluded_propagation_receipt_claim_rhs() -> Node {
  if irt1_excluded_propagation_receipt_claim_holds() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

data claim_irt1_excluded_propagation_receipt: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_excluded_propagation_receipt: excluded dimensions propagate proof",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_excluded_propagation_receipt_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
