// src/v4/test/claim/lens_affected_set/irt1_empty_diff_frontier_receipt.dag
// Scope: IRT-1 leaf — empty accumulator yields empty frontier.
// Owns: claim_irt1_empty_diff_frontier_receipt.
// Consumes: lens affected_set, lens affected_set_examples, std logic, std node, std verification.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_affected_set.irt1_empty_diff_frontier_receipt

import v4.lens.affected_set {
  ChangedSubgraphFrontier,
  FailClosed,
  UnchangedPureBoundary,
  affected_set,
  empty_affected_fold_acc,
  empty_frontier,
  frontier_from_fold_acc,
  mark_boundary_excluded
}
import v4.lens.affected_set_examples {
  affected_set_claim_failure_node,
  affected_set_example_node
}
import v4.std.algebra { length }
import v4.std.logic { Bool }
import v4.std.node { Diff, Edit, Node, Path, content_hash }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds }

data irt1_public_unchanged_edit: Edit = Edit {
  at: Path { steps: [] },
  replacement: affected_set_example_node
}

data irt1_public_changed_edit: Edit = Edit {
  at: Path { steps: [] },
  replacement: affected_set_claim_failure_node
}

fn irt1_empty_diff_frontier_receipt_claim_holds() -> Bool {
  frontier_from_fold_acc(
    acc: empty_affected_fold_acc(dag: affected_set_example_node)
  ) == empty_frontier()
}

fn irt1_public_affected_set_empty_diff_claim_holds() -> Bool {
  match affected_set(
    dag: affected_set_example_node,
    diff: Diff { edits: [] }
  ) {
    Holds { value: frontier } => frontier == empty_frontier()
    _ => false
  }
}

fn irt1_public_affected_set_prunes_unchanged_boundary() -> Bool {
  match affected_set(
    dag: affected_set_example_node,
    diff: Diff { edits: [irt1_public_unchanged_edit] }
  ) {
    Holds { value: frontier } =>
      frontier == mark_boundary_excluded(
        frontier: empty_frontier(),
        edit: irt1_public_unchanged_edit,
        proof: UnchangedPureBoundary {
          content_hash: content_hash(n: affected_set_example_node)
        }
      )
    _ => false
  }
}

fn irt1_public_affected_set_changed_edit_stays_narrow() -> Bool {
  match affected_set(
    dag: affected_set_example_node,
    diff: Diff { edits: [irt1_public_changed_edit] }
  ) {
    Holds { value: ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: _ } } =>
      length(xs: boundary_exclusions) == 0
    Holds { value: FailClosed { reason: _ } } => false
    _ => false
  }
}

fn irt1_empty_diff_frontier_receipt_claim_rhs() -> Node {
  if irt1_empty_diff_frontier_receipt_claim_holds()
    && irt1_public_affected_set_empty_diff_claim_holds()
    && irt1_public_affected_set_prunes_unchanged_boundary()
    && irt1_public_affected_set_changed_edit_stays_narrow() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

data claim_irt1_empty_diff_frontier_receipt: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_empty_diff_frontier_receipt: empty fold acc yields empty frontier",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_empty_diff_frontier_receipt_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
