// src/v4/test/claim/lens_affected_set/irt1_empty_diff_frontier_receipt.dag
// Scope: IRT-1 leaf — empty accumulator yields empty frontier.
// Owns: claim_irt1_empty_diff_frontier_receipt and public affected_set IRT-1 behavior claims.
// Consumes: lens affected_set, lens affected_set_examples, std logic, std node, std verification.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_affected_set.irt1_empty_diff_frontier_receipt

import v4.lens.affected_set {
  ChangedSubgraphFrontier,
  DoesNotPropagate,
  EditDimension,
  ExclusionKey,
  FailClosed,
  Propagates,
  Rerun,
  affected_set_boundary_pure_receipt_edge,
  affected_set_default_dimension,
  affected_set_dimension_not_read_receipt_edge,
  affected_set,
  canonical_propagation_receipt,
  empty_affected_fold_acc,
  empty_frontier,
  frontier_from_fold_acc
}
import v4.lens.affected_set_examples {
  affected_set_claim_failure_node,
  affected_set_example_node
}
import v4.std.algebra { length }
import v4.std.collection { empty_map, map_insert }
import v4.std.dependency { Contains, DependencyView }
import v4.std.logic { Bool }
import v4.std.node { Conj, Diff, Edge, Edit, Named, Node, Path, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds }
import v4.test.claim.lens_affected_set.node_precision {
  affected_set_root,
  affected_set_root_edge_symbol
}

data irt1_public_unchanged_edit: Edit = Edit {
  at: Path { steps: [] },
  replacement: irt1_public_pure_boundary_node
}

data irt1_public_pure_boundary_receipt: Node = Node {
  kind: TypeNode { connective: Conj },
  children: []
}

data irt1_public_pure_boundary_node: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: affected_set_boundary_pure_receipt_edge },
      target: irt1_public_pure_boundary_receipt
    }
  ]
}

data irt1_public_changed_edit: Edit = Edit {
  at: Path { steps: [] },
  replacement: affected_set_claim_failure_node
}

data irt1_public_unreceipted_unchanged_edit: Edit = Edit {
  at: Path { steps: [] },
  replacement: affected_set_example_node
}

data irt1_public_nonroot_changed_edit: Edit = Edit {
  at: Path { steps: [affected_set_root_edge_symbol] },
  replacement: affected_set_claim_failure_node
}

data irt1_public_missing_path_symbol: Symbol = irt1_public_missing_path_symbol

data irt1_public_missing_path_edit: Edit = Edit {
  at: Path { steps: [irt1_public_missing_path_symbol] },
  replacement: affected_set_claim_failure_node
}

data irt1_public_dimension_not_read_receipt_node: Node = Node {
  kind: TypeNode { connective: Conj },
  children: []
}

data irt1_public_receipted_usage_site: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: affected_set_dimension_not_read_receipt_edge },
      target: irt1_public_dimension_not_read_receipt_node
    }
  ]
}

data irt1_public_nonfrontier_dependency_without_receipt: DependencyView = DependencyView {
  source: affected_set_example_node,
  dependent: affected_set_claim_failure_node,
  kind: Contains,
  usage_site: affected_set_claim_failure_node
}

data irt1_public_nonfrontier_dependency_with_receipt: DependencyView = DependencyView {
  source: affected_set_example_node,
  dependent: affected_set_claim_failure_node,
  kind: Contains,
  usage_site: irt1_public_receipted_usage_site
}

data irt1_public_propagation_edit_dimension: EditDimension = EditDimension {
  edit: irt1_public_changed_edit,
  dimension: affected_set_default_dimension
}

fn irt1_empty_diff_frontier_receipt_claim_holds() -> Bool {
  frontier_from_fold_acc(
    acc: empty_affected_fold_acc(dag: affected_set_example_node)
  ) == empty_frontier()
}

fn irt1_public_affected_set_empty_diff_claim_holds() -> Bool {
  match affected_set(
    dag: affected_set_example_node,
    diff: Diff { edits: [] }
  ) {
    Holds { value: frontier } => frontier == empty_frontier()
    _ => false
  }
}

fn irt1_public_affected_set_prunes_receipted_pure_unchanged_boundary() -> Bool {
  match affected_set(
    dag: irt1_public_pure_boundary_node,
    diff: Diff { edits: [irt1_public_unchanged_edit] }
  ) {
    Holds { value: ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: _ } } =>
      length(xs: boundary_exclusions) == 1
    _ => false
  }
}

fn irt1_public_affected_set_fails_closed_without_purity_receipt() -> Bool {
  match affected_set(
    dag: affected_set_example_node,
    diff: Diff { edits: [irt1_public_unreceipted_unchanged_edit] }
  ) {
    Holds { value: FailClosed { reason: _ } } => true
    _ => false
  }
}

fn irt1_public_affected_set_changed_edit_stays_narrow() -> Bool {
  match affected_set(
    dag: affected_set_example_node,
    diff: Diff { edits: [irt1_public_changed_edit] }
  ) {
    Holds { value: ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: _ } } =>
      length(xs: boundary_exclusions) == 0
    Holds { value: FailClosed { reason: _ } } => false
    _ => false
  }
}

fn irt1_public_affected_set_nonroot_keeps_context_dependency() -> Bool {
  match affected_set(
    dag: affected_set_root,
    diff: Diff { edits: [irt1_public_nonroot_changed_edit] }
  ) {
    Holds { value: frontier } =>
      frontier == ChangedSubgraphFrontier {
        boundary_exclusions: [],
        decisions: map_insert(
          empty_map(),
          ExclusionKey {
            at: affected_set_claim_failure_node,
            dimension: affected_set_default_dimension
          },
          Rerun
        )
      }
    _ => false
  }
}

fn irt1_public_affected_set_missing_path_fails_closed() -> Bool {
  match affected_set(
    dag: affected_set_root,
    diff: Diff { edits: [irt1_public_missing_path_edit] }
  ) {
    Holds { value: FailClosed { reason: _ } } => true
    _ => false
  }
}

fn irt1_public_nonfrontier_dependency_without_read_receipt_reruns() -> Bool {
  match canonical_propagation_receipt(
    dag: affected_set_example_node,
    edit_dimension: irt1_public_propagation_edit_dimension,
    dependency: irt1_public_nonfrontier_dependency_without_receipt
  ) {
    Propagates => true
    _ => false
  }
}

fn irt1_public_nonfrontier_dependency_with_read_receipt_excludes() -> Bool {
  match canonical_propagation_receipt(
    dag: affected_set_example_node,
    edit_dimension: irt1_public_propagation_edit_dimension,
    dependency: irt1_public_nonfrontier_dependency_with_receipt
  ) {
    DoesNotPropagate { proof: _ } => true
    _ => false
  }
}

fn irt1_empty_diff_frontier_receipt_claim_rhs() -> Node {
  if irt1_empty_diff_frontier_receipt_claim_holds() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

fn irt1_public_affected_set_empty_diff_claim_rhs() -> Node {
  if irt1_public_affected_set_empty_diff_claim_holds() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

fn irt1_public_affected_set_receipted_boundary_prune_claim_rhs() -> Node {
  if irt1_public_affected_set_prunes_receipted_pure_unchanged_boundary() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

fn irt1_public_affected_set_unreceipted_boundary_fail_closed_claim_rhs() -> Node {
  if irt1_public_affected_set_fails_closed_without_purity_receipt() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

fn irt1_public_affected_set_changed_edit_stays_narrow_claim_rhs() -> Node {
  if irt1_public_affected_set_changed_edit_stays_narrow() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

fn irt1_public_affected_set_nonroot_context_dependency_claim_rhs() -> Node {
  if irt1_public_affected_set_nonroot_keeps_context_dependency() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

fn irt1_public_affected_set_missing_path_fail_closed_claim_rhs() -> Node {
  if irt1_public_affected_set_missing_path_fails_closed() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

fn irt1_public_nonfrontier_dependency_without_read_receipt_claim_rhs() -> Node {
  if irt1_public_nonfrontier_dependency_without_read_receipt_reruns() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

fn irt1_public_nonfrontier_dependency_with_read_receipt_claim_rhs() -> Node {
  if irt1_public_nonfrontier_dependency_with_read_receipt_excludes() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

data claim_irt1_empty_diff_frontier_receipt: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_empty_diff_frontier_receipt: empty fold acc yields empty frontier",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_empty_diff_frontier_receipt_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_irt1_public_affected_set_empty_diff: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_public_empty_diff: public affected_set returns empty frontier",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_public_affected_set_empty_diff_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_irt1_public_affected_set_receipted_boundary_prune: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_public_receipted_boundary_prune: public affected_set prunes only with purity receipt",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_public_affected_set_receipted_boundary_prune_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_irt1_public_affected_set_unreceipted_boundary_fail_closed: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_public_unreceipted_boundary_fail_closed: unchanged boundary without purity receipt fails closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_public_affected_set_unreceipted_boundary_fail_closed_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_irt1_public_affected_set_changed_edit_stays_narrow: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_public_changed_edit_stays_narrow: changed root edit avoids boundary exclusion",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_public_affected_set_changed_edit_stays_narrow_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_irt1_public_affected_set_nonroot_context_dependency: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_public_nonroot_context_dependency: non-root edit retains context dependency",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_public_affected_set_nonroot_context_dependency_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_irt1_public_affected_set_missing_path_fail_closed: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_public_missing_path_fail_closed: unresolved edit path fails closed",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_public_affected_set_missing_path_fail_closed_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_irt1_public_nonfrontier_dependency_without_read_receipt: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_public_nonfrontier_without_read_receipt: non-frontier dependency reruns without exclusion receipt",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_public_nonfrontier_dependency_without_read_receipt_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_irt1_public_nonfrontier_dependency_with_read_receipt: TestClaim = EqualsClaim {
  label: "lens_affected_set/irt1_public_nonfrontier_with_read_receipt: non-frontier dependency excludes only with receipt",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: irt1_public_nonfrontier_dependency_with_read_receipt_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
