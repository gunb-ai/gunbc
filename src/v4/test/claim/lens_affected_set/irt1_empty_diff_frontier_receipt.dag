// src/v4/test/claim/lens_affected_set/irt1_empty_diff_frontier_receipt.dag
// Scope: IRT-1 leaf — empty accumulator yields empty frontier.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_affected_set.irt1_empty_diff_frontier_receipt

import v4.lens.affected_set {
  ChangedSubgraphFrontier,
  DoesNotPropagate,
  EditDimension,
  FailClosed,
  Propagates,
  FrontierDependency,
  FrontierProduced,
  affected_set_boundary_pure_receipt_node,
  affected_set,
  canonical_transitive_frontier,
  canonical_propagation_receipt,
  empty_affected_fold_acc,
  empty_frontier,
  frontier_from_fold_acc
}
import v4.lens.affected_set_examples {
  affected_set_claim_failure_node,
  affected_set_example_node
}
import v4.std.algebra { length }
import v4.std.change { DependencyDependent, DependencySource }
import v4.std.dependency { Contains, DataDependsOn, DependencyView }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Diff, Edge, Edit, Named, Node, Path, Symbol, TypeNode, Unanchored }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds }
import v4.test.claim.lens_affected_set.node_precision {
  affected_set_leaf,
  affected_set_mid,
  affected_set_mid_to_leaf_dependency,
  affected_set_root,
  affected_set_root_to_mid_dependency
}

data irt1_public_unchanged_edit: Edit = Edit {
  at: Path { steps: [] },
  replacement: irt1_public_pure_boundary_node
}

data irt1_public_pure_boundary_receipt: Node = affected_set_boundary_pure_receipt_node()

data irt1_public_malformed_pure_boundary_receipt: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  span: Unanchored
}

data irt1_public_pure_boundary_node: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^affected_set_boundary_pure_receipt_edge },
      target: irt1_public_pure_boundary_receipt
    }
  ],
  span: Unanchored
}

data irt1_public_malformed_pure_boundary_node: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^affected_set_boundary_pure_receipt_edge },
      target: irt1_public_malformed_pure_boundary_receipt
    }
  ],
  span: Unanchored
}

data irt1_public_changed_edit: Edit = Edit {
  at: Path { steps: [] },
  replacement: affected_set_claim_failure_node
}

data irt1_public_unreceipted_unchanged_edit: Edit = Edit {
  at: Path { steps: [] },
  replacement: affected_set_example_node
}

data irt1_public_malformed_receipted_unchanged_edit: Edit = Edit {
  at: Path { steps: [] },
  replacement: irt1_public_malformed_pure_boundary_node
}

data irt1_public_nonroot_changed_edit: Edit = Edit {
  at: Path { steps: [^affected_set_root_edge_symbol] },
  replacement: affected_set_claim_failure_node
}
data irt1_public_missing_path_edit: Edit = Edit {
  at: Path { steps: [^irt1_public_missing_path_symbol] },
  replacement: affected_set_claim_failure_node
}
data irt1_public_dimension_not_read_receipt_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^affected_set_default_dimension } },
  children: [],
  span: Unanchored
}

data irt1_public_mismatched_dimension_not_read_receipt_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^irt1_public_other_dimension } },
  children: [],
  span: Unanchored
}

data irt1_public_receipted_usage_site: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^affected_set_dimension_not_read_receipt_edge },
      target: irt1_public_dimension_not_read_receipt_node
    }
  ],
  span: Unanchored
}

data irt1_public_mismatched_receipted_usage_site: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^affected_set_dimension_not_read_receipt_edge },
      target: irt1_public_mismatched_dimension_not_read_receipt_node
    }
  ],
  span: Unanchored
}

data irt1_public_nonfrontier_dependency_without_receipt: DependencyView = DependencyView {
  source: affected_set_example_node,
  dependent: affected_set_claim_failure_node,
  kind: DataDependsOn,
  usage_site: affected_set_claim_failure_node
}

data irt1_public_nonfrontier_dependency_with_receipt: DependencyView = DependencyView {
  source: affected_set_example_node,
  dependent: affected_set_claim_failure_node,
  kind: DataDependsOn,
  usage_site: irt1_public_receipted_usage_site
}

data irt1_public_nonfrontier_dependency_with_mismatched_receipt: DependencyView = DependencyView {
  source: affected_set_example_node,
  dependent: affected_set_claim_failure_node,
  kind: DataDependsOn,
  usage_site: irt1_public_mismatched_receipted_usage_site
}

data irt1_public_contains_dependency_with_read_receipt: DependencyView = DependencyView {
  source: affected_set_example_node,
  dependent: affected_set_claim_failure_node,
  kind: Contains,
  usage_site: irt1_public_receipted_usage_site
}

data irt1_public_mid_to_root_ancestor_frontier_dependency: FrontierDependency = FrontierDependency {
  dependency: affected_set_root_to_mid_dependency,
  target: DependencySource
}

data irt1_public_mid_to_leaf_frontier_dependency: FrontierDependency = FrontierDependency {
  dependency: affected_set_mid_to_leaf_dependency,
  target: DependencyDependent
}

data irt1_public_propagation_edit_dimension: EditDimension = EditDimension {
  edit: irt1_public_changed_edit,
  dimension: ^affected_set_default_dimension
}

fn irt1_empty_diff_frontier_receipt_claim_holds() -> Bool {
  frontier_from_fold_acc(
    acc: empty_affected_fold_acc(dag: affected_set_example_node)
  ) == empty_frontier()
}

fn irt1_public_affected_set_empty_diff_claim_holds() -> Bool {
  match affected_set(
    dag: affected_set_example_node,
    diff: Diff { edits: [] }
  ) {
    Holds { value: frontier } => frontier == empty_frontier()
    _ => false
  }
}

fn irt1_public_affected_set_prunes_receipted_pure_unchanged_boundary() -> Bool {
  match affected_set(
    dag: irt1_public_pure_boundary_node,
    diff: Diff { edits: [irt1_public_unchanged_edit] }
  ) {
    Holds { value: ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: _ } } =>
      length(xs: boundary_exclusions) == 1
    _ => false
  }
}

fn irt1_public_affected_set_fails_closed_without_purity_receipt() -> Bool {
  match affected_set(
    dag: affected_set_example_node,
    diff: Diff { edits: [irt1_public_unreceipted_unchanged_edit] }
  ) {
    Holds { value: FailClosed { reason: _ } } => true
    _ => false
  }
}

fn irt1_public_affected_set_fails_closed_with_malformed_purity_receipt() -> Bool {
  match affected_set(
    dag: irt1_public_malformed_pure_boundary_node,
    diff: Diff { edits: [irt1_public_malformed_receipted_unchanged_edit] }
  ) {
    Holds { value: FailClosed { reason: _ } } => true
    _ => false
  }
}

fn irt1_public_affected_set_changed_edit_fails_closed_without_dimension_receipt() -> Bool {
  match affected_set(
    dag: affected_set_example_node,
    diff: Diff { edits: [irt1_public_changed_edit] }
  ) {
    Holds { value: FailClosed { reason: _ } } => true
    _ => false
  }
}

fn irt1_public_affected_set_nonroot_changed_edit_fails_closed_without_dimension_receipt() -> Bool {
  match affected_set(
    dag: affected_set_root,
    diff: Diff { edits: [irt1_public_nonroot_changed_edit] }
  ) {
    Holds { value: FailClosed { reason: _ } } => true
    _ => false
  }
}

fn irt1_public_nonroot_frontier_points_to_ancestor() -> Bool {
  match canonical_transitive_frontier(
    dag: affected_set_root,
    edit_dimension: EditDimension {
      edit: irt1_public_nonroot_changed_edit,
      dimension: ^affected_set_default_dimension
    }
  ) {
    FrontierProduced { dependencies: dependencies } =>
      dependencies == [
        irt1_public_mid_to_root_ancestor_frontier_dependency,
        irt1_public_mid_to_leaf_frontier_dependency
      ]
    _ => false
  }
}

fn irt1_public_affected_set_missing_path_fails_closed() -> Bool {
  match affected_set(
    dag: affected_set_root,
    diff: Diff { edits: [irt1_public_missing_path_edit] }
  ) {
    Holds { value: FailClosed { reason: _ } } => true
    _ => false
  }
}

fn irt1_public_nonfrontier_dependency_without_read_receipt_reruns() -> Bool {
  match canonical_propagation_receipt(
    dag: affected_set_example_node,
    edit_dimension: irt1_public_propagation_edit_dimension,
    dependency: irt1_public_nonfrontier_dependency_without_receipt
  ) {
    Propagates => true
    _ => false
  }
}

fn irt1_public_nonfrontier_dependency_with_read_receipt_excludes() -> Bool {
  match canonical_propagation_receipt(
    dag: affected_set_example_node,
    edit_dimension: irt1_public_propagation_edit_dimension,
    dependency: irt1_public_nonfrontier_dependency_with_receipt
  ) {
    DoesNotPropagate { proof: _ } => true
    _ => false
  }
}

fn irt1_public_nonfrontier_dependency_with_mismatched_read_receipt_reruns() -> Bool {
  match canonical_propagation_receipt(
    dag: affected_set_example_node,
    edit_dimension: irt1_public_propagation_edit_dimension,
    dependency: irt1_public_nonfrontier_dependency_with_mismatched_receipt
  ) {
    Propagates => true
    _ => false
  }
}

fn irt1_public_contains_dependency_with_read_receipt_reruns() -> Bool {
  match canonical_propagation_receipt(
    dag: affected_set_example_node,
    edit_dimension: irt1_public_propagation_edit_dimension,
    dependency: irt1_public_contains_dependency_with_read_receipt
  ) {
    Propagates => true
    _ => false
  }
}

fn irt1_empty_diff_frontier_receipt_claim_rhs() -> Node {
  if irt1_empty_diff_frontier_receipt_claim_holds() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

fn irt1_public_affected_set_empty_diff_claim_rhs() -> Node {
  if irt1_public_affected_set_empty_diff_claim_holds() {
    affected_set_example_node
  } else {
    affected_set_claim_failure_node
  }
}

