// src/v4/test/claim/lens_affected_set/excluded_propagation_proof.dag
// Scope: T-21 worked claim — DimensionNotRead exclusion proof accumulates under Excluded.
// Owns: claim_excluded_propagation_proof.
// Consumes: lens affected_set, lens affected_set_examples, std node, std verification.
// Status: scaffold — compile-only until T-22 generated claim execution.

module v4.test.claim.lens_affected_set.excluded_propagation_proof

import v4.lens.affected_set {
  DimensionNotRead,
  ExclusionKey,
  empty_frontier,
  mark_excluded
}
import v4.lens.affected_set_examples {
  affected_set_example_dimension,
  affected_set_example_node,
  expected_affected_set_excluded_proofs
}
import v4.std.logic { Bool }
import v4.std.node { Conj, Node, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  Tier1,
  Unit
}

fn excluded_propagation_proof_claim_holds() -> Bool {
  mark_excluded(
    frontier: empty_frontier(),
    key: ExclusionKey {
      at: affected_set_example_node,
      dimension: affected_set_example_dimension
    },
    proof: DimensionNotRead {
      usage_site: affected_set_example_node,
      changed_dimension: affected_set_example_dimension
    }
  ) == expected_affected_set_excluded_proofs
}

fn excluded_propagation_proof_claim_rhs() -> Node {
  if excluded_propagation_proof_claim_holds() {
    affected_set_example_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data claim_excluded_propagation_proof: TestClaim = EqualsClaim {
  label: "lens_affected_set/excluded_propagation_proof: DimensionNotRead exclusion receipts",
  t19_anchor: T19ManualAnchorAbsent,
  lhs: affected_set_example_node,
  rhs: excluded_propagation_proof_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
