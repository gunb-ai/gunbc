// src/v4/test/claim/provenance/parse_stamp_span_index.dag
// Wave-1 local parse-stamping witness — successor to #4651 parse_table_captured_tree_span_morphism.
// Exercises parse_production-produced SpanIndex inside a single memo cell: terminal FromSource
// ByteRange + sequence DerivedBy{from:[child ids]} (not composed-coherence / wave-2).

module v4.test.claim.provenance.parse_stamp_span_index

import v4.compiler.parse {
  ParseArtifact,
  grammar_validate_for_parse,
  parse_production,
  parse_stage_locus_port,
  parse_stage_producer
}
import v4.std.algebra { Cons, Empty }
import v4.std.collection { List }
import v4.std.diagnostic {
  Accepted,
  ByteRange,
  Outcome,
  Rejected,
  Textual,
  WholeFile,
  port_locus
}
import v4.std.grammar {
  GrammarProduction,
  GrammarRoot,
  Sequence,
  Terminal,
  grammar_atom,
  grammar_empty_sync_tokens
}
import v4.std.lexing { Token }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  MintedOccurrence,
  Node,
  OccurrenceId,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v4.std.node_query { find_named_child }
import v4.std.provenance {
  DerivedBy,
  FromSource,
  GeneratedBy,
  SpanIndex,
  span_index_lookup
}
import v4.std.occurrence_id { occurrence_id_eq }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v4.std.witness { Holds, Violates }

data parse_stamp_file: Symbol = ^parse_stamp_file
data parse_stamp_tok: Symbol = ^parse_stamp_tok
data parse_stamp_start: Symbol = ^parse_stamp_start

fn parse_stamp_token(start: Int, end: Int) -> Token {
  Token {
    class: parse_stamp_tok,
    lexeme: Empty,
    file: parse_stamp_file,
    start: start,
    end: end
  }
}

fn parse_stamp_terminal_root() -> GrammarRoot {
  GrammarRoot {
    start: parse_stamp_start,
    productions: Cons {
      head: GrammarProduction {
        name: parse_stamp_start,
        expression: Terminal { token_class: parse_stamp_tok },
        emitted: grammar_atom(identity: parse_stamp_start)
      },
      tail: Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn parse_stamp_sequence_root() -> GrammarRoot {
  GrammarRoot {
    start: parse_stamp_start,
    productions: Cons {
      head: GrammarProduction {
        name: parse_stamp_start,
        expression: Sequence {
          left: Terminal { token_class: parse_stamp_tok },
          right: Terminal { token_class: parse_stamp_tok }
        },
        emitted: grammar_atom(identity: parse_stamp_start)
      },
      tail: Empty
    },
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn parse_stamp_from_source_extent_holds(
  index: SpanIndex,
  id: OccurrenceId,
  start: Int,
  end: Int
) -> Bool {
  match span_index_lookup(index: index, id: id) {
    Holds { value: got } =>
      match got {
        FromSource { locus: got_locus } =>
          match got_locus {
            Textual { file: f, extent: ext } =>
              (f == parse_stamp_file)
                && match ext {
                  ByteRange { start: s, end: e } => (s == start) && (e == end)
                  WholeFile => false
                }
            _ => false
          }
        DerivedBy { producer: _, from: _ } => false
        GeneratedBy { generator: _, from: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn parse_stamp_derived_by_pair_holds(
  index: SpanIndex,
  id: OccurrenceId,
  left: OccurrenceId,
  right: OccurrenceId
) -> Bool {
  match span_index_lookup(index: index, id: id) {
    Holds { value: got } =>
      match got {
        DerivedBy { producer: p, from: from } =>
          (p == parse_stage_producer)
            && match from {
              Cons { head: h, tail: Cons { head: t, tail: Empty } } =>
                occurrence_id_eq(left: h, right: left)
                  && occurrence_id_eq(left: t, right: right)
              _ => false
            }
        FromSource { locus: _ } => false
        GeneratedBy { generator: _, from: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn parse_stamp_minted_id(n: Node) -> OccurrenceId {
  match n.occurrence_id {
    MintedOccurrence { id: id } => id
    SyntheticOccurrence => OccurrenceId { value: -999999 }
  }
}

fn parse_stamp_terminal_from_source_holds() -> Bool {
  let at = port_locus(port: parse_stage_locus_port)
  match grammar_validate_for_parse(root: parse_stamp_terminal_root(), at: at) {
    Rejected { diagnostics: _ } => false
    Accepted { value: validated, diagnostics: _ } =>
      match parse_production(
        tokens: Cons {
          head: parse_stamp_token(start: 3, end: 8),
          tail: Empty
        },
        validated: validated,
        production_name: parse_stamp_start
      ) {
        Accepted { value: artifact, diagnostics: _ } =>
          match find_named_child(
            root: artifact.tree,
            name: ^grammar_production_captured_node_projection
          ) {
            Accepted { value: captured, diagnostics: _ } =>
              parse_stamp_from_source_extent_holds(
                index: artifact.span_index,
                id: parse_stamp_minted_id(n: captured),
                start: 3,
                end: 8
              )
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
  }
}

fn parse_stamp_sequence_derived_by_holds() -> Bool {
  let at = port_locus(port: parse_stage_locus_port)
  match grammar_validate_for_parse(root: parse_stamp_sequence_root(), at: at) {
    Rejected { diagnostics: _ } => false
    Accepted { value: validated, diagnostics: _ } =>
      match parse_production(
        tokens: Cons {
          head: parse_stamp_token(start: 0, end: 5),
          tail: Cons { head: parse_stamp_token(start: 5, end: 10), tail: Empty }
        },
        validated: validated,
        production_name: parse_stamp_start
      ) {
        Accepted { value: artifact, diagnostics: _ } =>
          match find_named_child(
            root: artifact.tree,
            name: ^grammar_production_captured_node_projection
          ) {
            Accepted { value: sequence_conj, diagnostics: _ } =>
              match find_named_child(
                root: sequence_conj,
                name: ^grammar_sequence_left_node_projection
              ) {
                Accepted { value: left_term, diagnostics: _ } =>
                  match find_named_child(
                    root: sequence_conj,
                    name: ^grammar_sequence_right_node_projection
                  ) {
                    Accepted { value: right_term, diagnostics: _ } =>
                      let left_id = parse_stamp_minted_id(n: left_term)
                      let right_id = parse_stamp_minted_id(n: right_term)
                      parse_stamp_from_source_extent_holds(
                        index: artifact.span_index,
                        id: left_id,
                        start: 0,
                        end: 5
                      )
                        && parse_stamp_from_source_extent_holds(
                          index: artifact.span_index,
                          id: right_id,
                          start: 5,
                          end: 10
                        )
                        && parse_stamp_derived_by_pair_holds(
                          index: artifact.span_index,
                          id: parse_stamp_minted_id(n: sequence_conj),
                          left: left_id,
                          right: right_id
                        )
                    Rejected { diagnostics: _ } => false
                  }
                Rejected { diagnostics: _ } => false
              }
            Rejected { diagnostics: _ } => false
          }
        Rejected { diagnostics: _ } => false
      }
  }
}

fn witness_parse_stamp_span_index_holds() -> Bool {
  parse_stamp_terminal_from_source_holds()
    && parse_stamp_sequence_derived_by_holds()
}

data unified_claim_parse_stamp_span_index: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/provenance/parse_stamp_span_index.dag",
    function: witness_parse_stamp_span_index_holds
  }
}
