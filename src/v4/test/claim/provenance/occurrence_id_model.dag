// src/v4/test/claim/provenance/occurrence_id_model.dag
// Phase 0 model smoke — OccurrenceId allocator + SpanIndex id→OriginEvent substrate.
// Anchor: design-provenance-span.md §4.5; design-node-identity-channels.md.

module v4.test.claim.provenance.occurrence_id_model

import v4.std.diagnostic { ByteRange, NodeLocus, PortLocus, Textual, WholeFile }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode,
  node_for_structural_equality,
  node_occurrence_minted,
  node_synthetic,
  node_with_occurrence_id
}
import v4.std.exact_structural_equality_zip_fold_predicate {
  exact_structural_equality_zip_fold
}
import v4.std.occurrence_id {
  alloc_occurrence_id,
  occurrence_id_allocator_initial,
  occurrence_id_eq
}
import v4.std.provenance {
  FromSource,
  origin_event_from_source,
  span_index_empty,
  span_index_lookup,
  span_index_record
}
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
import v4.std.witness { Holds, Violates }

data occurrence_model_file: Symbol = ^occurrence_model_file
data occurrence_eq_child: Symbol = ^occurrence_eq_child

// #4643: structurally-identical trees differing only in minted OccurrenceIds (root or nested)
// must compare EQUAL via exact_structural_equality_zip_fold (deep canonical; sole live-consumer
// authority for source_authority / edit_locus node_eq). Shallow node_for_structural_equality
// only clears the root — nested minted ids still break bare ==; the nested RED guard witnesses that.
fn occurrence_id_root_mint_excluded_from_structural_equality() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let m0 = alloc_occurrence_id(alloc: alloc0)
  let m1 = alloc_occurrence_id(alloc: m0.alloc)
  let child = node_synthetic(
    kind: TypeNode { connective: Atom { identity: occurrence_eq_child } },
    children: []
  )
  let left = node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Positional, target: child }],
    occurrence_id: node_occurrence_minted(id: m0.id)
  )
  let right = node_with_occurrence_id(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Positional, target: child }],
    occurrence_id: node_occurrence_minted(id: m1.id)
  )
  !occurrence_id_eq(left: m0.id, right: m1.id)
    && !(left == right)
    && exact_structural_equality_zip_fold(source_facts: left, candidate: right)
}

fn occurrence_id_nested_mint_excluded_from_structural_equality() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let m0 = alloc_occurrence_id(alloc: alloc0)
  let m1 = alloc_occurrence_id(alloc: m0.alloc)
  let child_left = node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: occurrence_eq_child } },
    children: [],
    occurrence_id: node_occurrence_minted(id: m0.id)
  )
  let child_right = node_with_occurrence_id(
    kind: TypeNode { connective: Atom { identity: occurrence_eq_child } },
    children: [],
    occurrence_id: node_occurrence_minted(id: m1.id)
  )
  let left = node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Positional, target: child_left }]
  )
  let right = node_synthetic(
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Positional, target: child_right }]
  )
  !occurrence_id_eq(left: m0.id, right: m1.id)
    && !(left == right)
    && exact_structural_equality_zip_fold(source_facts: left, candidate: right)
    && !(node_for_structural_equality(n: left) == node_for_structural_equality(n: right))
}

fn occurrence_id_excluded_from_structural_equality() -> Bool {
  occurrence_id_root_mint_excluded_from_structural_equality()
    && occurrence_id_nested_mint_excluded_from_structural_equality()
}

fn occurrence_id_allocator_mints_sequential_distinct_ids() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let r0 = alloc_occurrence_id(alloc: alloc0)
  let r1 = alloc_occurrence_id(alloc: r0.alloc)
  let r2 = alloc_occurrence_id(alloc: r1.alloc)
  !occurrence_id_eq(left: r0.id, right: r1.id)
    && !occurrence_id_eq(left: r1.id, right: r2.id)
    && !occurrence_id_eq(left: r0.id, right: r2.id)
}

fn span_index_from_source_round_trip_holds() -> Bool {
  let alloc0 = occurrence_id_allocator_initial()
  let minted = alloc_occurrence_id(alloc: alloc0)
  let id = minted.id
  let locus = Textual {
    file: occurrence_model_file,
    extent: ByteRange { start: 0, end: 12 }
  }
  let event = origin_event_from_source(locus: locus)
  let index = span_index_record(
    index: span_index_empty(),
    id: id,
    event: event
  )
  match span_index_lookup(index: index, id: id) {
    Holds { value: got } =>
      match got {
        FromSource { locus: got_locus } =>
          match got_locus {
            Textual { file: f, extent: ext } =>
              (f == occurrence_model_file)
                && match ext {
                  ByteRange { start: s, end: e } => (s == 0) && (e == 12)
                  WholeFile => false
                }
            NodeLocus { anchor: _ } => false
            PortLocus { anchor: _ } => false
          }
        DerivedBy { producer: _, from: _ } => false
        GeneratedBy { generator: _, from: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

fn witness_occurrence_id_model_substrate_holds() -> Bool {
  occurrence_id_allocator_mints_sequential_distinct_ids()
    && span_index_from_source_round_trip_holds()
    && occurrence_id_excluded_from_structural_equality()
}

data unified_claim_occurrence_id_model: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/provenance/occurrence_id_model.dag",
    function: witness_occurrence_id_model_substrate_holds
  }
}
