// src/v4/test/claim/complexity_gate/source_bridged_add_budget.dag
// Scope: complexity-gate S1a exemplar — source-bridged COMPREP wave-1 `add` body as lens subject.
// Status: executable --claim-run witness (lens_ci_gate row).
// Design: docs/design-lens-subject-supply.md §2–§6 (PR #4670).

module v4.test.claim.complexity_gate.source_bridged_add_budget

import v4.compiler.body_producer { produce_mvp1_add_arrow_with_body_from_resolved }
import v4.compiler.normalize { normalize }
import v4.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree,
  parse_stage_locus_port
}
import v4.compiler.resolve { resolve }
import v4.compiler.tokenize { tokenize }
import v4.extdeps.languages.dag {
  dag_grammar_production_mvp1_fn_add,
  dag_language_model_wave1,
  dag_mvp1_source_text
}
import v4.lens.complexity {
  ComplexityBound,
  ConstantComplexity,
  complexity_bound_dominates,
  complexity_lens,
  linear_complexity
}
import v4.lens.cost { SizeVariable, cost_lens }
import v4.std.collection { List, Set }
import v4.std.diagnostic {
  Accepted,
  Outcome,
  Rejected,
  bind_outcome,
  port_locus
}
import v4.std.grammar { GrammarRoot, ParseTree }
import v4.std.lexing { Token }
import v4.std.logic { Bool }
import v4.std.node { Node }
import v4.std.node_query { find_arrow_body_child }
import v4.std.witness { Holds }

data complexity_gate_add_source_file: Symbol = complexity_gate_add_source_file

fn complexity_gate_mvp1_add_parse_root() -> GrammarRoot {
  GrammarRoot {
    start: ^dag_production_mvp1_fn_add,
    productions: [dag_grammar_production_mvp1_fn_add()],
    sync_tokens: Set {
      member: fn(_) {
        false
      }
    }
  }
}

fn complexity_gate_parse_mvp1_add_tokens(tokens: List<Token>) -> Outcome<ParseTree> {
  let root = complexity_gate_mvp1_add_parse_root()
  match grammar_validate_for_parse(root: root, at: port_locus(port: parse_stage_locus_port)) {
    Accepted { value: validated, diagnostics: _ } =>
      parse_production_tree(
        tokens: tokens,
        validated: validated,
        production_name: ^dag_production_mvp1_fn_add
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn complexity_gate_source_resolved_add_arrow() -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(
      text: dag_mvp1_source_text,
      file: complexity_gate_add_source_file,
      rules: lm.lex
    ),
    f: fn(tokens) {
      bind_outcome(
        o: complexity_gate_parse_mvp1_add_tokens(tokens: tokens.tokens),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn complexity_gate_source_bridged_add_arrow_with_body() -> Outcome<Node> {
  bind_outcome(
    o: complexity_gate_source_resolved_add_arrow(),
    f: fn(resolved) {
      produce_mvp1_add_arrow_with_body_from_resolved(resolved_root: resolved)
    }
  )
}

fn complexity_gate_source_bridged_add_body() -> Outcome<Node> {
  bind_outcome(
    o: complexity_gate_source_bridged_add_arrow_with_body(),
    f: fn(arrow) {
      find_arrow_body_child(root: arrow)
    }
  )
}

fn source_bridged_add_declared_budget(_body: Node) -> ComplexityBound {
  ConstantComplexity
}

fn source_bridged_add_budget_dominates_computed(body: Node) -> Bool {
  match complexity_lens(n: body) {
    Holds { value: computed } =>
      complexity_bound_dominates(
        a: source_bridged_add_declared_budget(body: body),
        b: computed
      )
    _ => false
  }
}

fn source_bridged_add_cost_lens_holds(body: Node) -> Bool {
  match cost_lens(n: body) {
    Holds { value: _ } => true
    _ => false
  }
}

// Design §6: a deliberately too-tight declared class must fail dominance (lattice red).
fn source_bridged_add_tightened_budget_fails_dominance(body: Node) -> Bool {
  match complexity_lens(n: body) {
    Holds { value: computed } =>
      !complexity_bound_dominates(
        a: ConstantComplexity,
        b: linear_complexity(size_var: SizeVariable { source: body })
      )
      && complexity_bound_dominates(
        a: source_bridged_add_declared_budget(body: body),
        b: computed
      )
    _ => false
  }
}

fn source_bridged_add_budget_claim_holds() -> Bool {
  match complexity_gate_source_bridged_add_body() {
    Accepted { value: body, diagnostics: _ } =>
      source_bridged_add_cost_lens_holds(body: body)
        && source_bridged_add_budget_dominates_computed(body: body)
        && source_bridged_add_tightened_budget_fails_dominance(body: body)
    Rejected { diagnostics: _ } => false
  }
}
