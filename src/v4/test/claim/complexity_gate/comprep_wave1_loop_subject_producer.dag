// Scope: COMPREP wave-2 M0-Loop — single authority for loop subject-producer composition.
//        tokenize(dag_mvp1_loop_source_text) → parse → normalize → resolve → body_producer.
// Consumers: comprep_loop_eval_by_execution keystone.

module v4.test.claim.complexity_gate.comprep_wave1_loop_subject_producer

import v4.compiler.body_producer { produce_mvp1_loop_arrow_with_body_from_resolved }
import v4.compiler.normalize { normalize }
import v4.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree,
  parse_stage_locus_port
}
import v4.compiler.resolve { resolve }
import v4.compiler.tokenize { tokenize }
import v4.extdeps.languages.dag {
  dag_formal_production_mvp1_fn_loop,
  dag_grammar_production_mvp1_fn_loop,
  dag_language_model_wave1,
  dag_mvp1_loop_source_text,
  dag_mvp1_loop_wrong_value_source_text
}
import v4.std.collection { List, Set }
import v4.std.diagnostic { Accepted, Outcome, Rejected, bind_outcome, port_locus }
import v4.std.grammar { GrammarRoot, ParseTree }
import v4.std.compilers.lexing { Token }
import v4.std.node { Node, Symbol }

data comprep_wave1_loop_subject_source_file: Symbol = comprep_wave1_loop_subject_source_file

fn comprep_wave1_loop_parse_root() -> GrammarRoot {
  GrammarRoot {
    start: ^dag_production_mvp1_fn_loop,
    productions: [dag_grammar_production_mvp1_fn_loop()],
    sync_tokens: Set {
      member: fn(_) {
        false
      }
    }
  }
}

fn comprep_wave1_loop_parse_tokens(tokens: List<Token>) -> Outcome<ParseTree> {
  let root = comprep_wave1_loop_parse_root()
  match grammar_validate_for_parse(root: root, at: port_locus(port: parse_stage_locus_port)) {
    Accepted { value: validated, diagnostics: _ } =>
      parse_production_tree(
        tokens: tokens,
        validated: validated,
        production_name: ^dag_production_mvp1_fn_loop
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn comprep_source_resolved_loop_arrow_from_text(source_text: String) -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(
      text: source_text,
      file: comprep_wave1_loop_subject_source_file,
      rules: lm.lex
    ),
    f: fn(tokens) {
      bind_outcome(
        o: comprep_wave1_loop_parse_tokens(tokens: tokens.tokens),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn comprep_source_resolved_loop_arrow() -> Outcome<Node> {
  comprep_source_resolved_loop_arrow_from_text(source_text: dag_mvp1_loop_source_text)
}

fn comprep_source_resolved_loop_wrong_value_arrow() -> Outcome<Node> {
  comprep_source_resolved_loop_arrow_from_text(source_text: dag_mvp1_loop_wrong_value_source_text)
}

fn comprep_source_bridged_loop_arrow_with_body_from_resolved(
  resolved: Node
) -> Outcome<Node> {
  produce_mvp1_loop_arrow_with_body_from_resolved(resolved_root: resolved)
}

fn comprep_source_bridged_loop_arrow_with_body() -> Outcome<Node> {
  bind_outcome(
    o: comprep_source_resolved_loop_arrow(),
    f: fn(resolved) {
      comprep_source_bridged_loop_arrow_with_body_from_resolved(resolved: resolved)
    }
  )
}

fn comprep_source_bridged_loop_wrong_value_arrow_with_body() -> Outcome<Node> {
  bind_outcome(
    o: comprep_source_resolved_loop_wrong_value_arrow(),
    f: fn(resolved) {
      comprep_source_bridged_loop_arrow_with_body_from_resolved(resolved: resolved)
    }
  )
}
