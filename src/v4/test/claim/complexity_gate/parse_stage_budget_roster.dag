// src/v4/test/claim/complexity_gate/parse_stage_budget_roster.dag
// Scope: complexity-gate S1b — declared ComplexityBound budget rows (should-be side)
//        for v4.compiler.parse stage functions. One additive substrate data row per fn in
//        02_parse.dag; enforcement consumer lands in a follow-on lane (model-before-implement).
// Status: roster authority only — compile-time substrate; no lens enforcement wired yet.
// Anchor: v4.lens.complexity ComplexityBound + v4.lens.application LensEnforcement contract.

module v4.test.claim.complexity_gate.parse_stage_budget_roster

import v4.lens.complexity {
  ComplexityBound,
  ConstantComplexity,
  composite_complexity_variables,
  linear_complexity,
  multidimensional_polynomial_complexity,
  polynomial_complexity,
  single_complexity_variable
}
import v4.lens.cost { PolynomialDegree, SizeVariable }
import v4.std.cardinality { NonZeroNat }
import v4.std.collection { List, length }
import v4.std.logic { Bool }
import v4.std.nat { Succ, Zero }
import v4.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }

// Size anchors for declared stage-function budgets (token stream length n, grammar size g).
data parse_budget_token_stream_anchor: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^parse_budget_token_stream_anchor } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data parse_budget_grammar_anchor: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^parse_budget_grammar_anchor } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data parse_budget_polynomial_degree_two: PolynomialDegree = PolynomialDegree {
  predecessor_after_linear: NonZeroNat { prev: Zero }
}

data parse_budget_polynomial_degree_three: PolynomialDegree = PolynomialDegree {
  predecessor_after_linear: NonZeroNat { prev: Succ { prev: Zero } }
}

data parse_stage_budget_stage_module: Symbol = ^v4_compiler_parse

type ParseStageFunctionComplexityBudgetRow {
  stage_module: Symbol
  function_name: Symbol
  budget: ComplexityBound
}

fn parse_stage_budget_constant() -> ComplexityBound {
  ConstantComplexity
}

fn parse_stage_budget_linear_tokens() -> ComplexityBound {
  linear_complexity(
    size_var: SizeVariable { source: parse_budget_token_stream_anchor }
  )
}

fn parse_stage_budget_linear_grammar() -> ComplexityBound {
  linear_complexity(size_var: SizeVariable { source: parse_budget_grammar_anchor })
}

fn parse_stage_budget_quadratic_grammar() -> ComplexityBound {
  polynomial_complexity(
    size_var: SizeVariable { source: parse_budget_grammar_anchor },
    degree: parse_budget_polynomial_degree_two
  )
}

fn parse_stage_budget_cubic_grammar() -> ComplexityBound {
  polynomial_complexity(
    size_var: SizeVariable { source: parse_budget_grammar_anchor },
    degree: parse_budget_polynomial_degree_three
  )
}

fn parse_stage_budget_bilinear_tokens_grammar() -> ComplexityBound {
  multidimensional_polynomial_complexity(
    variables: composite_complexity_variables(
      lhs: single_complexity_variable(
        size_var: SizeVariable { source: parse_budget_token_stream_anchor }
      ),
      rhs: single_complexity_variable(
        size_var: SizeVariable { source: parse_budget_grammar_anchor }
      )
    ),
    degree: parse_budget_polynomial_degree_two
  )
}

data parse_stage_budget_row_build_parse_table: ParseStageFunctionComplexityBudgetRow =
  ParseStageFunctionComplexityBudgetRow {
    stage_module: parse_stage_budget_stage_module,
    function_name: ^build_parse_table,
    budget: parse_stage_budget_bilinear_tokens_grammar()
  }

