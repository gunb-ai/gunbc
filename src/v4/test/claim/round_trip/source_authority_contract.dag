// src/v4/test/claim/round_trip/source_authority_contract.dag
// Scope: Branch H.7.2 contract visibility claim.
// Status: shape claim; executable source-law receipts require substrate ParseTree/ResolvedTree
// equality plus a canonical `.dag` TargetModel row.

module v4.test.claim.round_trip.source_authority_contract


import v4.compiler.source_authority {
  DagSource,
  SourceAuthorityRoundTripLaw,
  source_authority_round_trip
}
import v4.std.collection { empty_map }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.lexing { VoidLexRules }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.target_model { TargetModel }
import v4.std.witness { Holds, Violates }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}


data source_authority_contract_subject_symbol: Symbol = source_authority_contract_subject_symbol
data source_authority_contract_pass_symbol: Symbol = source_authority_contract_pass_symbol
data source_authority_contract_fail_symbol: Symbol = source_authority_contract_fail_symbol
data source_authority_contract_source: DagSource = ""


data source_authority_contract_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: source_authority_contract_subject_symbol } },
  children: []
}

data source_authority_contract_target_model: TargetModel = TargetModel {
  bundle: source_authority_contract_subject,
  lex: VoidLexRules,
  binding_spellings: empty_map(),
  authority_source_text: source_authority_contract_source
}

fn source_authority_contract_pass_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: source_authority_contract_pass_symbol } },
    children: []
  }
}

fn source_authority_contract_fail_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: source_authority_contract_fail_symbol } },
    children: []
  }
}

fn source_authority_contract_claim_input(ok: Bool) -> Node {
  if ok {
    source_authority_contract_pass_node()
  } else {
    source_authority_contract_fail_node()
  }
}

fn source_authority_round_trip_boundary_holds() -> Bool {
  match source_authority_round_trip(
    source: source_authority_contract_source,
    canonical_source_target: source_authority_contract_target_model
  ) {
    Accepted { value: witness, diagnostics: _ } =>
      match witness {
        Holds { value: _: SourceAuthorityRoundTripLaw } => true
        Violates { diagnostic: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


data claim_source_authority_contract_compiles: TestClaim = CompilesClaim {
  label: "Branch H.7.2 source-authority round-trip shape contract compiles without JSON IR authority",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: source_authority_contract_claim_input(ok: source_authority_round_trip_boundary_holds()),
  expected_value: source_authority_contract_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
