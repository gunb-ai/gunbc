// src/v4/test/claim/round_trip/dag_ingest_round_trip.dag
// Scope: T-36 — executable .dag ingest→emit round-trip fidelity claim.
// Status: T-36 wired claim receipt; eval path for RoundTripClaim is Deferred pending T-38.
// Fixture: src/v4/test/fixture/dag_round_trip_mvp1.dag (committed wave-1 surface program).
// Normalization budget: C5 trivia normalization from dag.dag only — whitespace and comments are
//   DeclaredNormalized (TriviaRule-stripped); all other surface features are Modeled (lossless).
// Anchor: src/v4/TASKS.md §T-36; THESIS §B2-OMNI ingest=emit⁻¹ (C5).


module v4.test.claim.round_trip.dag_ingest_round_trip


import v4.extdeps.languages.dag {
  DagLanguageModel,
  DagBlockCommentDeclaredNormalized,
  DagLineCommentDeclaredNormalized,
  DagTriviaNormalization,
  DagWhitespaceDeclaredNormalized,
  dag_block_comment_fidelity,
  dag_language_model_surface_id,
  dag_language_model_wave1_modeled,
  dag_line_comment_fidelity,
  dag_production_data_decl,
  dag_production_fn_decl,
  dag_production_import_decl,
  dag_production_module,
  dag_production_module_header,
  dag_token_arrow,
  dag_token_colon,
  dag_token_dot,
  dag_token_eq,
  dag_token_ident,
  dag_token_kw_data,
  dag_token_kw_fn,
  dag_token_kw_import,
  dag_token_kw_module,
  dag_token_lbrace,
  dag_token_lparen,
  dag_token_rbrace,
  dag_token_rparen,
  dag_wave1_lex_token_symbol,
  dag_whitespace_fidelity
}
import v4.extdeps.languages.fidelity { DeclaredNormalized, FidelityDisposition }
import v4.std.grammar { grammar_carries_symbol }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.verification {
  ManualAnchorAbsent,
  RoundTripClaim,
  TestClaim,
  TestClassification,
  Tier3,
  Integration,
  manual_claim_anchor
}
// Structural import: ties this claim to the fixture module identity.
// If fixture/dag_round_trip_mvp1.dag is renamed or its exports change, this import breaks,
// preventing silent drift.  Full source-text binding is deferred: String = FreeMonoid<Char>
// where Char = Nat (Peano), making multi-line fixture embedding infeasible in the current
// substrate. T-38's module-loader will resolve the fixture by module path at eval time.
import v4.test.fixture.dag_round_trip_mvp1 { dag_round_trip_mvp1_subject }
data dag_round_trip_lang_axis: Symbol = dag_round_trip_lang_axis
data dag_round_trip_fixture_axis: Symbol = dag_round_trip_fixture_axis
data dag_round_trip_lex_axis: Symbol = dag_round_trip_lex_axis
data dag_round_trip_grammar_axis: Symbol = dag_round_trip_grammar_axis
data dag_round_trip_normalization_axis: Symbol = dag_round_trip_normalization_axis
data dag_round_trip_axis_ready: Symbol = dag_round_trip_axis_ready
data dag_round_trip_axis_not_ready: Symbol = dag_round_trip_axis_not_ready


fn dag_round_trip_atom(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [] }
}


fn dag_round_trip_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}


fn dag_round_trip_bool_node(pass: Bool) -> Node {
  if pass {
    dag_round_trip_atom(s: dag_round_trip_axis_ready)
  } else {
    dag_round_trip_atom(s: dag_round_trip_axis_not_ready)
  }
}


fn dag_round_trip_lex_ready() -> Bool {
  dag_wave1_lex_token_symbol(sym: dag_token_kw_module) &&
  dag_wave1_lex_token_symbol(sym: dag_token_kw_import) &&
  dag_wave1_lex_token_symbol(sym: dag_token_kw_data) &&
  dag_wave1_lex_token_symbol(sym: dag_token_kw_fn) &&
  dag_wave1_lex_token_symbol(sym: dag_token_ident) &&
  dag_wave1_lex_token_symbol(sym: dag_token_dot) &&
  dag_wave1_lex_token_symbol(sym: dag_token_lbrace) &&
  dag_wave1_lex_token_symbol(sym: dag_token_rbrace) &&
  dag_wave1_lex_token_symbol(sym: dag_token_colon) &&
  dag_wave1_lex_token_symbol(sym: dag_token_eq) &&
  dag_wave1_lex_token_symbol(sym: dag_token_lparen) &&
  dag_wave1_lex_token_symbol(sym: dag_token_rparen) &&
  dag_wave1_lex_token_symbol(sym: dag_token_arrow)
}


fn dag_round_trip_grammar_ready(lm: DagLanguageModel) -> Bool {
  grammar_carries_symbol(grammar: lm.grammar, sym: dag_production_module) &&
  grammar_carries_symbol(grammar: lm.grammar, sym: dag_production_module_header) &&
  grammar_carries_symbol(grammar: lm.grammar, sym: dag_production_import_decl) &&
  grammar_carries_symbol(grammar: lm.grammar, sym: dag_production_data_decl) &&
  grammar_carries_symbol(grammar: lm.grammar, sym: dag_production_fn_decl)
}


fn dag_round_trip_normalization_declared() -> Bool {
  dag_whitespace_fidelity() == DeclaredNormalized { feature: DagWhitespaceDeclaredNormalized } &&
  dag_line_comment_fidelity() == DeclaredNormalized { feature: DagLineCommentDeclaredNormalized } &&
  dag_block_comment_fidelity() == DeclaredNormalized { feature: DagBlockCommentDeclaredNormalized }
}


fn dag_round_trip_input_node() -> Node {
  let lm = dag_language_model_wave1_modeled()
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_round_trip_edge(
        name: dag_round_trip_lang_axis,
        target: dag_round_trip_atom(s: dag_language_model_surface_id)
      ),
      dag_round_trip_edge(
        name: dag_round_trip_fixture_axis,
        target: dag_round_trip_atom(s: dag_round_trip_fixture_symbol)
      ),
      dag_round_trip_edge(
        name: dag_round_trip_lex_axis,
        target: dag_round_trip_bool_node(pass: dag_round_trip_lex_ready())
      ),
      dag_round_trip_edge(
        name: dag_round_trip_grammar_axis,
        target: dag_round_trip_bool_node(pass: dag_round_trip_grammar_ready(lm: lm))
      ),
      dag_round_trip_edge(
        name: dag_round_trip_normalization_axis,
        target: dag_round_trip_bool_node(pass: dag_round_trip_normalization_declared())
      )
    ]
  }
}


data claim_dag_ingest_round_trip: TestClaim = RoundTripClaim {
  label: "T-36 .dag ingest→emit round-trip fidelity: fixture dag_round_trip_mvp1 bit-identical up to declared normalization",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: dag_round_trip_input_node(),
  classification: TestClassification { tier: Tier3, layer: Integration }
}
