// src/v4/test/claim/round_trip/dag_ingest_round_trip.dag
// Scope: T-36 self-contained .dag ingest round-trip fidelity claim.
// Owns: claim_dag_ingest_round_trip_fidelity.
// Consumes: v4.extdeps.languages.dag, v4.extdeps.languages.fidelity, v4.std.verification, v4.std.node.
// Status: EqualsClaim receipt over a modeled `.dag` surface program node.

module v4.test.claim.round_trip.dag_ingest_round_trip


import v4.extdeps.languages.dag {
  dag_surface_module,
  dag_surface_module_header,
  dag_surface_qualified_name,
  dag_surface_top_level_item,
  dag_surface_type_expr,
  emit_data_decl_emitted_node,
  emit_module_header_emitted_node
}
import v4.extdeps.languages.fidelity {
  DeclaredNormalized,
  FailClosed,
  FidelityDisposition,
  Modeled
}
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}


data dag_ingest_round_trip_claim_name: Symbol = claim_dag_ingest_round_trip_fidelity
data dag_ingest_round_trip_testclaim_type: Symbol = dag_ingest_round_trip_testclaim_type
data dag_ingest_round_trip_fixture_module: Symbol = dag_ingest_round_trip_fixture_module


fn dag_ingest_round_trip_atom(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [] }
}


fn dag_ingest_round_trip_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}


fn dag_ingest_round_trip_qualified_name(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_ingest_round_trip_edge(
        name: dag_surface_qualified_name,
        target: dag_ingest_round_trip_atom(s: s)
      )
    ]
  }
}


fn dag_ingest_round_trip_type_expr(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_ingest_round_trip_edge(
        name: dag_surface_type_expr,
        target: dag_ingest_round_trip_atom(s: s)
      )
    ]
  }
}


fn dag_ingest_round_trip_source_program_node() -> Node {
  let module_header = emit_module_header_emitted_node(
    qualified_name: dag_ingest_round_trip_qualified_name(s: dag_ingest_round_trip_fixture_module)
  )
  let claim_decl = emit_data_decl_emitted_node(
    name_binding: dag_ingest_round_trip_claim_name,
    type_expr: dag_ingest_round_trip_type_expr(s: dag_ingest_round_trip_testclaim_type),
    expr: dag_ingest_round_trip_atom(s: dag_ingest_round_trip_claim_name)
  )
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_ingest_round_trip_edge(
        name: dag_surface_module,
        target: dag_ingest_round_trip_atom(s: dag_surface_module)
      ),
      dag_ingest_round_trip_edge(
        name: dag_surface_module_header,
        target: module_header
      ),
      dag_ingest_round_trip_edge(
        name: dag_surface_top_level_item,
        target: claim_decl
      )
    ]
  }
}


data dag_ingest_round_trip_fidelity: FidelityDisposition<Node> = Modeled


fn dag_ingest_round_trip_re_emitted_node(
  disposition: FidelityDisposition<Node>
) -> Node {
  match disposition {
    Modeled => dag_ingest_round_trip_source_program_node()
    DeclaredNormalized { feature: normalized } => normalized
    FailClosed { feature: diagnostic_node } => diagnostic_node
  }
}


// 🟡 bootstrap-limitation:T-36-executable-round-trip — EqualsClaim lhs == rhs (source_node == source_node) because ingest()/emit() are not callable as .dag functions until T-10 lands; this claim is a prep fixture that models the round-trip structure and declares the C5 fidelity disposition — dissolve-on: T-10 (05_emit.dag + 00_compile.dag) merges with callable ingest(source, dag_language_model()) -> Node and emit(node, dag_language_model()) -> String; at that point replace lhs with ingest(fixture_source) and rhs with ingest(emit(ingest(fixture_source))).
data claim_dag_ingest_round_trip_fidelity: TestClaim = EqualsClaim {
  label: "T-36 .dag ingest round-trip source program re-emits according to C5 fidelity disposition",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: dag_ingest_round_trip_source_program_node(),
  rhs: dag_ingest_round_trip_re_emitted_node(disposition: dag_ingest_round_trip_fidelity),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
