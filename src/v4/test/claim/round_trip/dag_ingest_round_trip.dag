// src/v4/test/claim/round_trip/dag_ingest_round_trip.dag
// Scope: T-36 self-referential .dag ingest round-trip fidelity claim.
// Owns: claim_dag_ingest_round_trip_fidelity.
// Consumes: v4.extdeps.languages.dag, v4.test.fixture.dag_ingest_round_trip_fixture, v4.std.verification, v4.std.node.
// Status: EqualsClaim over committed source fixture + canonical C5 fidelity disposition.

module v4.test.claim.round_trip.dag_ingest_round_trip


import v4.extdeps.languages.dag {
  dag_fidelity_disposition,
  dag_fidelity_disposition_node,
  dag_round_trip_source_text_feature
}
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}
import v4.test.fixture.dag_ingest_round_trip_fixture {
  dag_ingest_round_trip_fixture_source_node
}


data dag_ingest_round_trip_claim_axis: Symbol = dag_ingest_round_trip_claim_axis
data dag_ingest_round_trip_source_fixture_axis: Symbol = dag_ingest_round_trip_source_fixture_axis
data dag_ingest_round_trip_fidelity_axis: Symbol = dag_ingest_round_trip_fidelity_axis
data dag_ingest_round_trip_claim_name: Symbol = claim_dag_ingest_round_trip_fidelity


fn dag_ingest_round_trip_atom(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [] }
}


fn dag_ingest_round_trip_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}


fn dag_ingest_round_trip_expected_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_ingest_round_trip_edge(
        name: dag_ingest_round_trip_claim_axis,
        target: dag_ingest_round_trip_atom(s: dag_ingest_round_trip_claim_name)
      ),
      dag_ingest_round_trip_edge(
        name: dag_ingest_round_trip_source_fixture_axis,
        target: dag_ingest_round_trip_fixture_source_node()
      ),
      dag_ingest_round_trip_edge(
        name: dag_ingest_round_trip_fidelity_axis,
        target: dag_fidelity_disposition_node(
          disposition: dag_fidelity_disposition(feature: dag_round_trip_source_text_feature)
        )
      )
    ]
  }
}


data claim_dag_ingest_round_trip_fidelity: TestClaim = EqualsClaim {
  label: "T-36 .dag ingest round-trip fixture follows dag language C5 fidelity model",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: dag_ingest_round_trip_expected_node(),
  rhs: dag_ingest_round_trip_expected_node(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
