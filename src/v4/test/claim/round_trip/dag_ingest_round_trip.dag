// src/v4/test/claim/round_trip/dag_ingest_round_trip.dag
// Scope: T-36 omni ingest round-trip claim: `.dag` source fixture -> Node -> emitted source.
// Owns: test_dag_ingest_round_trip_bit_identical.
// Consumes: compiler/00_compile.dag, extdeps/languages/dag.dag, test/fixture/dag_ingest_round_trip_fixture.dag, std/verification.dag.
// Status: T-36 EqualsClaim over bit-identical source; Outcome<TargetSource> is projected to Node only at the TestClaim boundary.

module v4.test.claim.round_trip.dag_ingest_round_trip


import v4.compiler.compile { compile_ingest_staging }
import v4.compiler.target_carriers { TargetModel, TargetSource }
import v4.extdeps.languages.dag { dag_language_model_wave1 }
import v4.std.collection { empty_map }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus
}
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}
import v4.test.fixture.dag_ingest_round_trip_fixture {
  dag_ingest_round_trip_fixture_expected_source,
  dag_ingest_round_trip_fixture_source
}


data dag_ingest_round_trip_source_identity: Symbol = dag_ingest_round_trip_source_identity
data dag_ingest_round_trip_output_identity: Symbol = dag_ingest_round_trip_output_identity
data dag_ingest_round_trip_target_bundle: Symbol = dag_ingest_round_trip_target_bundle
data dag_ingest_round_trip_poison_authority: TargetSource = "dag_ingest_round_trip_authority_source_text_fallback_forbidden"
data dag_ingest_round_trip_source_mismatch: Symbol = dag_ingest_round_trip_source_mismatch


fn dag_ingest_round_trip_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


data dag_ingest_round_trip_source_node: Node = dag_ingest_round_trip_atom(s: dag_ingest_round_trip_source_identity)


data dag_ingest_round_trip_mismatch_node: Node = dag_ingest_round_trip_atom(s: dag_ingest_round_trip_output_identity)


fn dag_ingest_round_trip_target_model() -> TargetModel {
  let lm = dag_language_model_wave1()
  TargetModel {
    bundle: dag_ingest_round_trip_atom(s: dag_ingest_round_trip_target_bundle),
    lex: lm.lex,
    binding_spellings: empty_map(),
    authority_source_text: dag_ingest_round_trip_poison_authority
  }
}


data dag_ingest_round_trip_receipt: Outcome<TargetSource> = compile_ingest_staging(
  source: dag_ingest_round_trip_fixture_source,
  target: dag_ingest_round_trip_target_model()
)


fn dag_ingest_round_trip_output_node() -> Node {
  match dag_ingest_round_trip_receipt {
    Accepted { value: emitted, diagnostics: d } =>
      if (emitted == dag_ingest_round_trip_fixture_expected_source) && (d == None) {
        dag_ingest_round_trip_source_node
      } else {
        dag_ingest_round_trip_mismatch_node
      }
    Rejected { diagnostics: _ } =>
      dag_ingest_round_trip_mismatch_node
  }
}


fn dag_ingest_round_trip_projection_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: dag_ingest_round_trip_source_mismatch,
    at: node_locus(node: dag_ingest_round_trip_source_node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn dag_ingest_round_trip_projected_outcome() -> Outcome<Node> {
  match dag_ingest_round_trip_receipt {
    Accepted { value: emitted, diagnostics: d } =>
      if (emitted == dag_ingest_round_trip_fixture_expected_source) && (d == None) {
        Accepted { value: dag_ingest_round_trip_source_node, diagnostics: None }
      } else {
        Rejected {
          diagnostics: diagnostics_singleton(d: dag_ingest_round_trip_projection_diagnostic())
        }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}


data test_dag_ingest_round_trip_bit_identical: TestClaim = EqualsClaim {
  label: "round_trip/dag_ingest: TestClaim fixture ingests to Node and emits bit-identical source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: dag_ingest_round_trip_source_node,
  rhs: dag_ingest_round_trip_output_node(),
  classification: TestClassification { tier: Tier1, layer: Integration }
}
