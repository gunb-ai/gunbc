// src/v4/test/claim/round_trip/dag_ingest_round_trip.dag
// Scope: T-36 omni ingest round-trip claim: `.dag` TestClaim fixture source -> Node -> source.
// Owns: test_dag_ingest_round_trip_bit_identical.
// Consumes: test/fixture/dag_ingest_round_trip_fixture.dag, std/node.dag, std/verification.dag.
// Status: T-36 RoundTripClaim over a committed self-referential TestClaim fixture; execution belongs to the T-22 runner.

module v4.test.claim.round_trip.dag_ingest_round_trip


import v4.std.node { Atom, Edge, Named, Node, Symbol, TypeNode, Conj }
import v4.std.verification {
  ManualAnchorAbsent,
  RoundTripClaim,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  manual_claim_anchor
}
import v4.test.fixture.dag_ingest_round_trip_fixture {
  dag_ingest_round_trip_fixture_expected_source,
  dag_ingest_round_trip_fixture_source
}


data dag_ingest_round_trip_fixture_source_symbol: Symbol = dag_ingest_round_trip_fixture_source_symbol
data dag_ingest_round_trip_fixture_expected_symbol: Symbol = dag_ingest_round_trip_fixture_expected_symbol
data dag_ingest_round_trip_source_field: Symbol = dag_ingest_round_trip_source_field
data dag_ingest_round_trip_expected_field: Symbol = dag_ingest_round_trip_expected_field


fn dag_ingest_round_trip_atom(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


data dag_ingest_round_trip_fixture_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: dag_ingest_round_trip_source_field },
      target: dag_ingest_round_trip_atom(s: dag_ingest_round_trip_fixture_source_symbol)
    },
    Edge {
      label: Named { name: dag_ingest_round_trip_expected_field },
      target: dag_ingest_round_trip_atom(s: dag_ingest_round_trip_fixture_expected_symbol)
    }
  ]
}


data test_dag_ingest_round_trip_bit_identical: TestClaim = RoundTripClaim {
  label: "round_trip/dag_ingest: TestClaim fixture ingests to Node and emits bit-identical source",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: dag_ingest_round_trip_fixture_input,
  classification: TestClassification { tier: Tier1, layer: Integration }
}
