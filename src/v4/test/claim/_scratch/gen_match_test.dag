module v4.test.claim.scratch.gen_match

import v4.lens.testgen {
  Generator,
  TestgenConcept,
  TypeConstruction,
  default_generator_profile,
  generator_provenance,
  generator_id_for_manual_anchor
}
import v4.std.verification {
  ManualTcConjEmpty,
  TestClaimCompilesClaimVariant,
  ClaimAnchorKey,
  ManualClaimAnchor,
  TestClassification
}
import v4.std.logic { Bool }

fn test_generator() -> Generator<TestgenConcept> {
  Generator {
    kind: TestClaimCompilesClaimVariant,
    classification: TestClassification { },
    anchor: ManualClaimAnchor { manual_anchor: ManualTcConjEmpty },
    slot: TypeConstruction { subject: { } },
    provenance: generator_provenance(id: generator_id_for_manual_anchor(key: ManualTcConjEmpty)),
    profile_metadata: default_generator_profile()
  }
}

fn match_generator_arm(g: Generator<TestgenConcept>) -> Bool {
  match g {
    Generator { kind: k, classification: _, anchor: _, slot: _, provenance: _, profile_metadata: _ } =>
      k == TestClaimCompilesClaimVariant
  }
}

fn witness_generator_match() -> Bool {
  match_generator_arm(g: test_generator())
}
