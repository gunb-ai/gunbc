// src/v4/test/claim/std/circuit_spice_passive.dag
// Scope: spice.dag passive projection witness for v4.std.circuit.

module v4.test.claim.std.circuit_spice_passive

import v4.std.collection { Absent, Present }
import v4.std.circuit { passive_spec_from_component }
import v4.std.logic { Bool }
import v4.extdeps.formats.spice {
  Ground,
  Named,
  NamedNode,
  Resistor,
  SpiceValue
}
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor,
}

fn spice_resistor_projects_passive_spec_holds() -> Bool {
  let component = Resistor {
    name: ^r1,
    n_plus: Named { node: NamedNode { name: ^n1 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "1000" }
  }
  match passive_spec_from_component(component: component) {
    Present { value: _ } => true
    Absent => false
  }
}

data claim_spice_resistor_passive_spec: TestClaim = BoolWitnessClaim {
  label: "std/circuit: spice Resistor projects PassiveComponentSpec",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: spice_resistor_projects_passive_spec_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_circuit_spice_module_compiles: TestClaim = CompilesClaim {
  label: "std/circuit: spice passive projection compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: Resistor {
    name: ^r1,
    n_plus: Ground,
    n_minus: Ground,
    value: SpiceValue { lexeme: "1" }
  },
  expected_value: Resistor {
    name: ^r1,
    n_plus: Ground,
    n_minus: Ground,
    value: SpiceValue { lexeme: "1" }
  },
  classification: TestClassification { tier: Tier1, layer: Unit }
}
