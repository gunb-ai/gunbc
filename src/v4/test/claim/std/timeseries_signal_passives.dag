// src/v4/test/claim/std/timeseries_signal_passives.dag
// Scope: spice passive projection witness (compile-safe slice; map/fold in #4894).

module v4.test.claim.std.timeseries_signal_passives

import v4.std.collection { Absent, Present }
import v4.std.logic { Bool }
import v4.std.timeseries_signal {
  GroundReference,
  passive_spec_from_component
}
import v4.extdeps.formats.spice {
  Ground,
  Named,
  NamedNode,
  Resistor,
  SpiceValue
}
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn spice_resistor_projects_passive_spec_holds() -> Bool {
  let component = Resistor {
    name: ^r1,
    n_plus: Named { node: NamedNode { name: ^n1 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "1000" }
  }
  match passive_spec_from_component(component: component) {
    Present { value: _ } => true
    Absent => false
  }
}

data claim_spice_resistor_passive_spec: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: spice Resistor projects PassiveComponentSpec",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: spice_resistor_projects_passive_spec_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_timeseries_signal_module_compiles: TestClaim = CompilesClaim {
  label: "std/timeseries_signal: affine voltage + spice projection compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: GroundReference,
  expected_value: GroundReference,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
