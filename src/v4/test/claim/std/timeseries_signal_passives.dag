// src/v4/test/claim/std/timeseries_signal_passives.dag
// Scope: S1 behavioral witnesses for map/fold passive step operators.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.

module v4.test.claim.std.timeseries_signal_passives

import v4.std.algebra { Cons, Empty, length }
import v4.std.collection { Absent, Present }
import v4.std.logic { Bool }
import v4.std.node { Symbol }
import v4.std.timeseries_signal {
  TimeSeriesMapStep,
  TimeSeriesSample,
  TimeSeriesSignal,
  fold_running_sum_int,
  map_time_series_int,
  passive_spec_from_component,
  timeseries_unit_dt
}
import v4.extdeps.formats.spice {
  Component,
  Ground,
  Named,
  NamedNode,
  Resistor,
  SpiceValue
}
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn double_int_sample(sample: TimeSeriesSample<Int>) -> TimeSeriesSample<Int> {
  TimeSeriesSample { value: sample.value * 2 }
}

fn map_preserves_dt_and_length_holds() -> Bool {
  let input = TimeSeriesSignal {
    dt: timeseries_unit_dt,
    samples: [
      TimeSeriesSample { value: 1 },
      TimeSeriesSample { value: 2 },
      TimeSeriesSample { value: 3 }
    ]
  }
  let output = map_time_series_int(
    signal: input,
    step: TimeSeriesMapStep { apply: double_int_sample }
  )
  length(xs: input.samples) == length(xs: output.samples)
}

fn fold_running_sum_holds() -> Bool {
  let input = TimeSeriesSignal {
    dt: timeseries_unit_dt,
    samples: [
      TimeSeriesSample { value: 1 },
      TimeSeriesSample { value: 2 },
      TimeSeriesSample { value: 3 }
    ]
  }
  let output = fold_running_sum_int(signal: input)
  match output.samples {
    Cons { head: h1, tail: Cons { head: h2, tail: Cons { head: h3, tail: Empty } } } =>
      h1.value == 1 && h2.value == 3 && h3.value == 6
    _ => false
  }
}

fn spice_resistor_projects_passive_spec_holds() -> Bool {
  let component = Resistor {
    name: ^r1,
    n_plus: Named { node: NamedNode { name: ^n1 } },
    n_minus: Ground,
    value: SpiceValue { lexeme: "1000" }
  }
  match passive_spec_from_component(component: component) {
    Present { value: _ } => true
    Absent => false
  }
}

data claim_map_preserves_dt_and_length: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: map step preserves sample length",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: map_preserves_dt_and_length_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_fold_running_sum: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: fold step integrates running sum",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: fold_running_sum_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_spice_resistor_passive_spec: TestClaim = BoolWitnessClaim {
  label: "std/timeseries_signal: spice Resistor projects PassiveComponentSpec",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  witness: BoolWitness { holds: spice_resistor_projects_passive_spec_holds() },
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_timeseries_signal_module_compiles: TestClaim = CompilesClaim {
  label: "std/timeseries_signal: passive map/fold module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: TimeSeriesSample { value: 0 },
  expected_value: TimeSeriesSample { value: 0 },
  classification: TestClassification { tier: Tier1, layer: Unit }
}
