// src/v4/test/claim/claim_pipeline/resolve.dag
// Scope: G3.2 — compiler spine stage `03_resolve` substrate + T-38 claim row.
// Status: W2.5 second spine claim — normalize→resolve chain on void DAG language model.

module v4.test.claim.claim_pipeline.resolve

import v4.compiler.normalize { normalize }
import v4.compiler.resolve { resolve }
import v4.extdeps.languages.dag {
  dag_language_model_wave1_void
}
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.verification {
  CompilesClaim,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
data spine_resolve_module_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^spine_resolve_module } },
  children: [],
  span: Unanchored
}
fn spine_resolve_service_parse_tree() -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: ^dag_c3_surface_sugar_service }
    },
    children: [
      Edge {
        label: Named { name: ^spine_resolve_service_decl },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: []
        }
      }
    ],
    span: Unanchored
}
}

// 🟡 predicate dissolution — feature:T-22-outcome-to-bool-claim-bridge — bind TASKS.md T-22 / G.3.5 spine harness —
// dissolve-on: T-22 claim runner evaluates normalize→resolve Outcome chain directly without Bool projection.
fn spine_resolve_accepts_normalized_tree() -> Bool {
  match normalize(parse_tree: spine_resolve_service_parse_tree()) {
    Accepted { value: normalized, diagnostics: _ } =>
      match resolve(tree: normalized, lm: dag_language_model_wave1_void()) {
        Accepted { value: _, diagnostics: _ } => true
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn spine_resolve_bool_atom(b: Bool) -> Node {
  match b {
    true =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_resolve_pass } },
        children: [],
        span: Unanchored
}
    false =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_resolve_fail } },
        children: [],
        span: Unanchored
}
  }
}

data claim_pipeline_resolve_module_compiles: TestClaim = CompilesClaim {
  label: "claim_pipeline/resolve: v4.compiler.resolve stage module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: spine_resolve_module_subject,
  expected_value: spine_resolve_module_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_pipeline_resolve_accepts_normalize_chain: TestClaim = EqualsClaim {
  label: "claim_pipeline/resolve: resolve accepts normalize output on wave1 void language model",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spine_resolve_bool_atom(b: spine_resolve_accepts_normalized_tree()),
  rhs: spine_resolve_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
