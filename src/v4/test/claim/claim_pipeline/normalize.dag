// src/v4/test/claim/claim_pipeline/normalize.dag
// Scope: G3.1 — compiler spine stage `03_normalize` substrate + T-38 claim row.
// Status: W2.5 first spine claim — compile anchor + minimal normalize acceptance on void sugar tree.

module v4.test.claim.claim_pipeline.normalize


import v4.compiler.normalize { normalize }
import v4.extdeps.languages.dag { dag_c3_surface_sugar_service }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.verification {
  CompilesClaim,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data spine_normalize_module_sym: Symbol = spine_normalize_module_sym
data spine_normalize_pass: Symbol = spine_normalize_pass
data spine_normalize_fail: Symbol = spine_normalize_fail
data spine_normalize_service_decl: Symbol = spine_normalize_service_decl


fn spine_normalize_module_subject() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: spine_normalize_module_sym } },
    children: []
  }
}


fn spine_normalize_service_parse_tree() -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: dag_c3_surface_sugar_service }
    },
    children: [
      Edge {
        label: Named { name: spine_normalize_service_decl },
        target: Node {
          kind: TypeNode { connective: Conj },
          children: []
        }
      }
    ]
  }
}


fn spine_normalize_accepts_well_formed_sugar() -> Bool {
  match normalize(parse_tree: spine_normalize_service_parse_tree()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


fn spine_normalize_bool_atom(b: Bool) -> Node {
  match b {
    true =>
      Node {
        kind: TypeNode { connective: Atom { identity: spine_normalize_pass } },
        children: []
      }
    false =>
      Node {
        kind: TypeNode { connective: Atom { identity: spine_normalize_fail } },
        children: []
      }
  }
}


data claim_pipeline_normalize_module_compiles: TestClaim = CompilesClaim {
  label: "claim_pipeline/normalize: v4.compiler.normalize stage module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: spine_normalize_module_subject(),
  expected_value: spine_normalize_module_subject(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_pipeline_normalize_accepts_sugar_tree: TestClaim = EqualsClaim {
  label: "claim_pipeline/normalize: normalize accepts well-formed C3 service sugar ParseTree",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spine_normalize_bool_atom(b: spine_normalize_accepts_well_formed_sugar()),
  rhs: spine_normalize_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
