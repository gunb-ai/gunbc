// src/v4/test/claim/claim_pipeline/translate.dag
// Scope: G3.4 — compiler spine stage `06_translate` substrate + T-38 claim row.
// Status: W2.5 fourth spine claim — compile anchor + translate accepts MVP-1 rust InferredTree.
// Note: full normalize→resolve→infer→translate on void sugar is deferred until wave-1 inferred facts
//   align with TargetModel translation_rules (manual/mvp1_rust_add_translate.dag owns that receipt).

module v4.test.claim.claim_pipeline.translate


import v4.compiler.translate { translate }
import v4.extdeps.languages.rust { rust_mvp1_target_model }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.verification {
  CompilesClaim,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.test.claim.manual.mvp1_rust_add_translate { mvp1_rust_inferred_tree }
data spine_translate_module_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^spine_translate_module } },
  children: []
}
// 🟡 predicate dissolution — feature:T-22-outcome-to-bool-claim-bridge — bind TASKS.md T-22 / G.3.5 spine harness —
// dissolve-on: T-22 claim runner evaluates translate Outcome<TargetNodeTree> directly without Bool projection.
fn spine_translate_accepts_mvp1_inferred_tree() -> Bool {
  match translate(tree: mvp1_rust_inferred_tree, target: rust_mvp1_target_model()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


fn spine_translate_bool_atom(b: Bool) -> Node {
  match b {
    true =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_translate_pass } },
        children: []
      }
    false =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_translate_fail } },
        children: []
      }
  }
}


data claim_pipeline_translate_module_compiles: TestClaim = CompilesClaim {
  label: "claim_pipeline/translate: v4.compiler.translate stage module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: spine_translate_module_subject,
  expected_value: spine_translate_module_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_pipeline_translate_accepts_mvp1_inferred_tree: TestClaim = EqualsClaim {
  label: "claim_pipeline/translate: translate accepts MVP-1 rust add-fn InferredTree on rust_mvp1_target_model",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spine_translate_bool_atom(b: spine_translate_accepts_mvp1_inferred_tree()),
  rhs: spine_translate_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
