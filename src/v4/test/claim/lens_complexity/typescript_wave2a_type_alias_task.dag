// Scope: T-11 PR-1.5b — complexity_lens receipt on wave2a Task type_alias Conj-positional emitted tree.
// Status: scaffold — compile-only until T-19/T-22 generated claim execution.

module v4.test.claim.lens_complexity.typescript_wave2a_type_alias_task

import v4.extdeps.languages.typescript { ts_wave2a_task_type_alias_emitted }
import v4.lens.complexity { ComplexityBound, complexity_lens, linear_complexity }
import v4.lens.cost { LinearCost, SizeVariable, SymbolicCost, cost_lens }
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v4.std.node { Cardinality, Edge, Node, Positional, Symbol, TypeNode, SyntheticOccurrence }
import v4.std.witness { Witness }
type LensComplexityClaim {
  input: Node
  expected_cost: SymbolicCost
  expected_complexity: ComplexityBound
  falsification: Diagnostic
}

data ts_wave2a_task_complexity_input: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: ts_wave2a_task_type_alias_emitted() }
  ],
  occurrence_id: SyntheticOccurrence
}

data ts_wave2a_task_complexity_claim: LensComplexityClaim = LensComplexityClaim {
  input: ts_wave2a_task_complexity_input,
  expected_cost: LinearCost { variable: SizeVariable { source: ts_wave2a_task_complexity_input } },
  expected_complexity: linear_complexity(
    size_var: SizeVariable { source: ts_wave2a_task_complexity_input }
  ),
  falsification: Diagnostic {
    reason: ^ts_wave2a_task_complexity_reason,
    at: Textual { file: ^ts_wave2a_task_complexity_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn ts_wave2a_task_actual_cost() -> Witness<SymbolicCost> {
  cost_lens(n: ts_wave2a_task_complexity_input)
}

fn ts_wave2a_task_actual_complexity() -> Witness<ComplexityBound> {
  complexity_lens(n: ts_wave2a_task_complexity_input)
}
