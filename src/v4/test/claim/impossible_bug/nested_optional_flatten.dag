// src/v4/test/claim/impossible_bug/nested_optional_flatten.dag
//
// Scope: TestClaim — nested-optional flatten impossible-bug class (R2+). Option<Option<T>> accessor patterns that require hand-unwrapping in normal languages are impossible by construction in v4 via cardinality refinement.
// Anchor: THESIS.md "Enumerable impossible-bug classes" §381-383 R2+ + std/cardinality.dag
//
// Owns:
//   - test_nested_optional_collapses: TestClaim
//     - input: try to declare Option<Option<T>>
//     - expected: substrate collapses or refuses (cardinality refinement makes nesting redundant)
//   - test_optional_chaining_no_double_unwrap: TestClaim
//     - input: chain accessors through optional fields
//     - expected: emitted code has no double-unwrap pattern
//
// Consumes:
//   - std/verification.dag, std/diagnostic.dag, std/cardinality.dag
//
// Status: T-14 corpus rows; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.impossible_bug.nested_optional_flatten


import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  node_locus,
  None,
  Outcome,
  Rejected,
  Suggested,
  diagnostics_singleton
}
import v4.std.node { Edge, Named, Node, Positional, Symbol, TypeNode, Atom, Cardinality }
import v4.std.verification {
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier2,
  Unit,
  CompilesClaim,
  DiagnosticClaim,
  EqualsClaim,
  RoundTripClaim,
  t19_manual_claim_anchor
}


data optional_value_symbol: Symbol = optional_value_symbol
data flattened_optional_symbol: Symbol = flattened_optional_symbol
data double_unwrap_symbol: Symbol = double_unwrap_symbol
data nested_optional_reason: Symbol = nested_optional_reason
data double_unwrap_reason: Symbol = double_unwrap_reason
data optional_inner: Symbol = optional_inner
data optional_outer: Symbol = optional_outer


fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [] }
}


data flattened_optional_input: Node = atom_node(s: flattened_optional_symbol)


data falsification_nested_optional: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Cardinality },
        children: [
          Edge { label: Positional, target: atom_node(s: optional_value_symbol) },
        ]
      }
    },
  ]
}


data falsification_optional_double_unwrap: Node = Node {
  kind: TypeNode { connective: Cardinality },
  children: [
    Edge { label: Positional, target: atom_node(s: double_unwrap_symbol) },
  ]
}


data claim_optional_chaining_no_double_unwrap: TestClaim = CompilesClaim {
  label: "optional cardinality refinement keeps accessor surface single-layer",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  input: flattened_optional_input,
  expected_value: flattened_optional_input,
  classification: TestClassification { tier: Tier2, layer: Unit }
}


data claim_optional_double_unwrap_rejected: TestClaim = DiagnosticClaim {
  label: "optional accessor surface rejects double unwrap shape",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  input: falsification_optional_double_unwrap,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: double_unwrap_reason,
        at: node_locus(node: falsification_optional_double_unwrap),
        correction: Suggested { node: flattened_optional_input }
      }
    ),
  classification: TestClassification { tier: Tier2, layer: Unit }
}


data claim_nested_optional_collapses: TestClaim = DiagnosticClaim {
  label: "nested optional cardinality collapses to one refinement",
  t19_anchor: t19_manual_claim_anchor(anchor: T19ManualAnchorAbsent),
  input: falsification_nested_optional,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: nested_optional_reason,
        at: node_locus(node: falsification_nested_optional),
        correction: Suggested { node: flattened_optional_input }
      }
    ),
  classification: TestClassification { tier: Tier2, layer: Unit }
}
