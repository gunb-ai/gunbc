// src/v4/test/claim/impossible_bug/transport_type_drift.dag
//
// Scope: TestClaim — transport/type drift impossible-bug class (R1). Client and server cannot hold different types for the same field — both derive from the same declaration. Drift is impossible by construction.
// Anchor: THESIS.md "Enumerable impossible-bug classes" §379-380 R1 + gate #29 wire-serde-alignment + extdeps/coordination.dag
//
// Status: T-14 corpus rows; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.impossible_bug.transport_type_drift


import v4.lens.wire_contract_alignment {
  wire_contract_parallel_authority_drift_detected
}
import v4.std.diagnostic {
  Diagnostic,
  node_locus,
  Suggested,
  diagnostics_singleton
}
import v4.std.logic { Bool }
import v4.std.node { Edge, Named, Node, Symbol, TypeNode, Atom, Conj }
import v4.std.verification {
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Integration,
  CompilesClaim,
  DiagnosticClaim,
  EqualsClaim,
  RoundTripClaim,
  impossible_bug_reason_target_transport_drift,
  impossible_bug_reason_transport_drift,
  manual_claim_anchor
}
fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [] }
}


data shared_wire_contract_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^client_field }, target: atom_node(s: ^shared_wire_contract_symbol) },
    Edge { label: Named { name: ^server_field }, target: atom_node(s: ^shared_wire_contract_symbol) },
  ]
}


data falsification_wire_contract_drift: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^client_field }, target: atom_node(s: ^client_field_int_symbol) },
    Edge { label: Named { name: ^server_field }, target: atom_node(s: ^server_field_string_symbol) },
  ]
}


data falsification_target_contract_drift: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge { label: Named { name: ^client_field }, target: atom_node(s: ^client_field_int_symbol) },
    Edge { label: Named { name: ^target_field }, target: atom_node(s: ^target_field_bool_symbol) },
  ]
}


data claim_shared_declaration_compiles_both_sides: TestClaim = CompilesClaim {
  label: "shared transport declaration compiles client and server sides",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: shared_wire_contract_input,
  expected_value: shared_wire_contract_input,
  classification: TestClassification { tier: Tier1, layer: Integration }
}


data claim_target_contract_drift_impossible: TestClaim = DiagnosticClaim {
  label: "transport field drift rejects target-side parallel authority",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_target_contract_drift,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: impossible_bug_reason_target_transport_drift,
        at: node_locus(node: falsification_target_contract_drift),
        correction: Suggested { node: shared_wire_contract_input }
      }
    ),
  classification: TestClassification { tier: Tier1, layer: Integration }
}


data claim_wire_contract_drift_impossible: TestClaim = DiagnosticClaim {
  label: "transport field drift rejects parallel client server authority",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: falsification_wire_contract_drift,
  expected_rejection: diagnostics_singleton(
      d: Diagnostic {
        reason: impossible_bug_reason_transport_drift,
        at: node_locus(node: falsification_wire_contract_drift),
        correction: Suggested { node: shared_wire_contract_input }
      }
    ),
  classification: TestClassification { tier: Tier1, layer: Integration }
}


fn transport_wire_contract_drift_claim_holds() -> Bool {
  wire_contract_parallel_authority_drift_detected(
    contract: falsification_wire_contract_drift,
    left_field: ^client_field,
    right_field: ^server_field
  )
}


fn transport_target_contract_drift_claim_holds() -> Bool {
  wire_contract_parallel_authority_drift_detected(
    contract: falsification_target_contract_drift,
    left_field: ^client_field,
    right_field: ^target_field
  )
}


fn transport_type_drift_impossible_bug_claims_hold() -> Bool {
  transport_wire_contract_drift_claim_holds() && transport_target_contract_drift_claim_holds()
}
