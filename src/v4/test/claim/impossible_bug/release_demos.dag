// src/v4/test/claim/impossible_bug/release_demos.dag
// Scope: release impossible-bug demos over v4 lens/probe surfaces.
// The witnesses below capture the release-drift evidence and the transport-drift
// metadata projections; the distributed marker is the durable registration form.

module v4.test.claim.impossible_bug.release_demos


import v4.std.logic { Bool }
import v4.std.diagnostic { Accepted, Diagnostic, Rejected }
import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim,
  TransportTypeDrift,
  impossible_bug_class_from_diagnostic_reason,
  test_claim_input,
  test_claim_expected_outcome
}
import v4.test.claim.impossible_bug.transport_type_drift {
  claim_target_contract_drift_impossible,
  claim_wire_contract_drift_impossible,
  falsification_target_contract_drift,
  falsification_wire_contract_drift
}
import v4.test.claim.lens_idempotency.write_effect { idempotency_write_effect_claim_holds }
import v4.test.claim.lens_synthesis.synthesis_gap_polynomial { synthesis_gap_poly_lens_non_empty }


fn release_complexity_lens_catches() -> Bool {
  synthesis_gap_poly_lens_non_empty()
}


fn release_idempotency_lens_catches() -> Bool {
  idempotency_write_effect_claim_holds()
}


fn release_transport_target_contract_drift_catches() -> Bool {
  match test_claim_expected_outcome(c: claim_target_contract_drift_impossible) {
    Accepted { value: Rejected { diagnostics: expected }, diagnostics: None } =>
      match expected.head {
        Diagnostic { reason: reason, at: _, correction: _ } =>
          (falsification_target_contract_drift == test_claim_input(c: claim_target_contract_drift_impossible))
            && match impossible_bug_class_from_diagnostic_reason(reason: reason) {
              Accepted { value: TransportTypeDrift, diagnostics: None } => true
              _ => false
            }
      }
    _ => false
  }
}


fn release_transport_wire_contract_drift_catches() -> Bool {
  match test_claim_expected_outcome(c: claim_wire_contract_drift_impossible) {
    Accepted { value: Rejected { diagnostics: expected }, diagnostics: None } =>
      match expected.head {
        Diagnostic { reason: reason, at: _, correction: _ } =>
          (falsification_wire_contract_drift == test_claim_input(c: claim_wire_contract_drift_impossible))
            && match impossible_bug_class_from_diagnostic_reason(reason: reason) {
              Accepted { value: TransportTypeDrift, diagnostics: None } => true
              _ => false
            }
      }
    _ => false
  }
}


fn release_transport_drift_probe_catches() -> Bool {
  release_transport_target_contract_drift_catches() &&
    release_transport_wire_contract_drift_catches()
}


fn release_complexity_claims_are_lens_rejections() -> Bool {
  release_complexity_lens_catches()
}


fn release_idempotency_claims_are_lens_rejections() -> Bool {
  release_idempotency_lens_catches()
}


fn release_transport_claims_are_lens_rejections() -> Bool {
  release_transport_drift_probe_catches()
}


fn witness_impossible_bug_release_demos_are_v4_lens_caught() -> Bool {
  release_complexity_claims_are_lens_rejections() &&
    release_idempotency_claims_are_lens_rejections() &&
    release_transport_claims_are_lens_rejections()
}

// Consolidation #4553 Phase 2 distributed BoolWitnessClaim marker.
// Co-located with `witness_impossible_bug_release_demos_are_v4_lens_caught` so glob discovery finds the witness without the central roster.
data unified_claim_impossible_bug_release_demos: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "src/v4/test/claim/impossible_bug/release_demos.dag",
    function: witness_impossible_bug_release_demos_are_v4_lens_caught
  }
}
