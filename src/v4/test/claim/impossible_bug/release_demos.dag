// src/v4/test/claim/impossible_bug/release_demos.dag
// Scope: release impossible-bug demos over executable v4 lens/probe surfaces.
// The witnesses below do not inspect authored DiagnosticClaim metadata. Each
// class is backed by the v4 program that the named lens/probe actually reads.

module v4.test.claim.impossible_bug.release_demos


import v4.lens.coverage {
  ImpossibleBugCoverageKey,
  collect_impossible_bug_coverage_keys,
  impossible_bug_coverage_key_eq
}
import v4.std.algebra { contains }
import v4.std.diagnostic { Accepted }
import v4.std.logic { Bool }
import v4.std.verification {
  TransportTypeDrift
}
import v4.test.claim.impossible_bug.transport_type_drift {
  claim_target_contract_drift_impossible,
  claim_wire_contract_drift_impossible
}
import v4.test.claim.lens_idempotency.write_effect { idempotency_write_effect_claim_holds }
import v4.test.claim.lens_synthesis.synthesis_gap_polynomial { synthesis_gap_poly_lens_non_empty }


fn release_complexity_lens_catches() -> Bool {
  synthesis_gap_poly_lens_non_empty()
}


fn release_idempotency_lens_catches() -> Bool {
  idempotency_write_effect_claim_holds()
}


fn release_transport_drift_probe_catches() -> Bool {
  match collect_impossible_bug_coverage_keys(
    corpus: [
      claim_target_contract_drift_impossible,
      claim_wire_contract_drift_impossible,
    ]
  ) {
    Accepted { value: keys, diagnostics: None } =>
      contains(
        xs: keys,
        item: ImpossibleBugCoverageKey { bug_class: TransportTypeDrift },
        eq: impossible_bug_coverage_key_eq
      )
    _ => false
  }
}


fn release_complexity_claims_are_lens_rejections() -> Bool {
  release_complexity_lens_catches()
}


fn release_idempotency_claims_are_lens_rejections() -> Bool {
  release_idempotency_lens_catches()
}


fn release_transport_claims_are_lens_rejections() -> Bool {
  release_transport_drift_probe_catches()
}


fn witness_impossible_bug_release_demos_are_v4_lens_caught() -> Bool {
  release_complexity_claims_are_lens_rejections() &&
    release_idempotency_claims_are_lens_rejections() &&
    release_transport_claims_are_lens_rejections()
}
