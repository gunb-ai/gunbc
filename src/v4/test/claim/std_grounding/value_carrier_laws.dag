// src/v4/test/claim/std_grounding/value_carrier_laws.dag
// Scope: executable witnesses for the value-carrier laws (ctrl#1533 M-A
//   sharing law, M-C identity laws; authority: v4.std.value_carrier and
//   v4.std.runtime.IdentityEvidence). These are the behavior-preservation
//   gate for the ctrl#1533 phase-2 host carrier swap: every witness here must
//   hold under the current host AND under any replacement carrier.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.

module v4.test.claim.std_grounding.value_carrier_laws

import v4.std.value_carrier { CarrierDeclaration, PersistenceKind, Persistent, list_carrier, map_carrier }

// ── Sharing law (M-A): sharing is unobservable ────────────────────────────
// An aliased value (one allocation reachable twice) and a freshly built
// structural twin are indistinguishable by language-level observation.

fn sharing_unobservable_list_holds() -> Bool {
  let shared = [1, 2, 3]
  let aliased = shared.concat(shared)
  let fresh = [1, 2, 3, 1, 2, 3]
  aliased == fresh
}

fn sharing_unobservable_map_holds() -> Bool {
  let base = empty_map() |> map_insert("k", 1)
  let alias = base
  alias == (empty_map() |> map_insert("k", 1))
}

// ── Identity law 2 (M-C): keyed-aggregate equality is order-independent ──
// The same entries yield equal maps regardless of insertion order.

fn map_equality_insert_order_independent_holds() -> Bool {
  let ab = empty_map() |> map_insert("a", 1) |> map_insert("b", 2)
  let ba = empty_map() |> map_insert("b", 2) |> map_insert("a", 1)
  ab == ba
}

// Upsert is last-write-wins independent of the path taken to the same final
// entry set (the lattice-meet grounding from std.effects).
fn map_equality_overwrite_path_independent_holds() -> Bool {
  let direct = empty_map() |> map_insert("a", 2)
  let overwritten = empty_map() |> map_insert("a", 1) |> map_insert("a", 2)
  direct == overwritten
}

// ── FreeMonoid representation law: association shape is unobservable ─────
// List<T> = FreeMonoid<T>: differently associated concatenations of the same
// element sequence are EQUAL values. This is the law that lets a carrier keep
// concatenation as structure (no per-site flattening through the
// free_monoid_to_vec chokepoint — the actual copy path phase-0 measured).
fn freemonoid_association_unobservable_holds() -> Bool {
  let left_assoc = [1].concat([2]).concat([3])
  let right_assoc = [1].concat([2].concat([3]))
  let flat = [1, 2, 3]
  (left_assoc == flat) && (right_assoc == flat)
}

// ── Carrier declarations are persistent (M-A data values resolve) ────────
fn declared_carriers_are_persistent_holds() -> Bool {
  let map_persistent = match map_carrier.persistence {
    Persistent => true
    Ephemeral => false
  }
  let list_persistent = match list_carrier.persistence {
    Persistent => true
    Ephemeral => false
  }
  map_persistent && list_persistent
}
