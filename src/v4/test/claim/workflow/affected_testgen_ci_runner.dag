// src/v4/test/claim/workflow/affected_testgen_ci_runner.dag
// Scope: affected-set → generated TestClaim → run_test_claim CI receipt.
// Status: first executable fusion slice; host gate is scripts/v4-affected-testgen-gate.sh.

module v4.test.claim.workflow.affected_testgen_ci_runner

import v4.compiler.eval {
  TestClaimRun,
  run_test_claim,
  test_claim_run_verdict
}
import v4.compiler.infer { InferredTree }
import v4.lens.affected_set { AffectedSetReading }
import v4.lens.edit_locus {
  EditLocusBinding,
  EditLocusRead,
  GitDiffNameOnly,
  PathRegex,
  RepoPath,
  affected_set_reading_from_git_diff
}
import v4.std.algebra { Cons, Empty, length }
import v4.std.collection { List }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.runtime { RuntimeValue }
import v4.std.text { String }
import v4.std.verdict { Deferred, Fail, Pass }
import v4.std.verification {
  TestClaim,
  test_claim_evaluation_touches_rerun_frontier,
  test_claim_input
}
import v4.std.witness { Holds, Violates, Witness }
import v4.test.claim.generated.witness_validity {
  row_witness_validity_constraint_satisfaction_holds
}
import v4.test.claim.manual.connective_anchors { stub_empty_conj }
import v4.test.claim.rung_3_4_common { rung34_test_claim_subject }
import v4.test.claim.lens_common.infer_fixture {
  claim_inferred_facts,
  claim_inferred_tree
}


data affected_testgen_graph_root_symbol: Symbol = affected_testgen_graph_root_symbol
data affected_testgen_graph_edge_symbol: Symbol = affected_testgen_graph_edge_symbol
data affected_testgen_type_symbol: Symbol = affected_testgen_type_symbol
data affected_testgen_algebra_symbol: Symbol = affected_testgen_algebra_symbol
data affected_testgen_descent_symbol: Symbol = affected_testgen_descent_symbol
data affected_testgen_path_witness_validity: RepoPath = "src/v4/test/claim/generated/witness_validity.dag"
data affected_testgen_path_unrelated: RepoPath = "src/v4/test/claim/generated/unrelated.dag"
data affected_testgen_pattern_generated_witness_validity: PathRegex = affected_testgen_pattern_generated_witness_validity


data affected_testgen_graph_root: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: affected_testgen_graph_edge_symbol },
      target: stub_empty_conj
    }
  ]
}


fn affected_testgen_path_regex_matches(changed: RepoPath, pattern: PathRegex) -> Bool {
  match pattern {
    affected_testgen_pattern_generated_witness_validity =>
      changed == affected_testgen_path_witness_validity
    _ => false
  }
}


data affected_testgen_edit_read: EditLocusRead = EditLocusRead {
  path_regex_matches: affected_testgen_path_regex_matches
}


data affected_testgen_binding: EditLocusBinding = EditLocusBinding {
  pattern: affected_testgen_pattern_generated_witness_validity,
  locus: stub_empty_conj
}


data affected_testgen_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [affected_testgen_path_witness_validity]
}


data affected_testgen_unrelated_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [affected_testgen_path_unrelated]
}


fn affected_testgen_claim_tree() -> InferredTree {
  claim_inferred_tree(
    root: affected_testgen_graph_root,
    facts: claim_inferred_facts(
      type_symbol: affected_testgen_type_symbol,
      algebra_symbol: affected_testgen_algebra_symbol,
      descent_symbol: affected_testgen_descent_symbol
    )
  )
}


fn affected_testgen_reading_from_fixture_diff(
  git_diff: GitDiffNameOnly
) -> Witness<AffectedSetReading> {
  affected_set_reading_from_git_diff(
    edit_read: affected_testgen_edit_read,
    graph: affected_testgen_claim_tree(),
    git_diff: git_diff,
    bindings: [affected_testgen_binding]
  )
}


fn affected_testgen_generated_claims_for_reading(
  reading: AffectedSetReading
) -> List<TestClaim> {
  match row_witness_validity_constraint_satisfaction_holds {
    Accepted { value: claim, diagnostics: _ } =>
      if test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: reading.affected) {
        [claim]
      } else {
        []
      }
    Rejected { diagnostics: _ } => []
  }
}


fn affected_testgen_selected_claims() -> List<TestClaim> {
  match affected_testgen_reading_from_fixture_diff(git_diff: affected_testgen_git_diff) {
    Holds { value: reading } =>
      affected_testgen_generated_claims_for_reading(reading: reading)
    Violates { diagnostic: _ } => []
  }
}


fn affected_testgen_run_claim(claim: TestClaim) -> TestClaimRun<Node, RuntimeValue> {
  run_test_claim(
    subject: rung34_test_claim_subject(
      claim: claim,
      evaluator_input: test_claim_input(c: claim)
    )
  )
}


fn affected_testgen_selected_claim_runs_pass(claim: TestClaim) -> Bool {
  match test_claim_run_verdict(run: affected_testgen_run_claim(claim: claim)) {
    Pass => true
    Fail { actual: _, falsification: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}


fn affected_testgen_selects_one_generated_claim_holds() -> Bool {
  length(xs: affected_testgen_selected_claims()) == 1
}


fn affected_testgen_generated_claim_run_passes_holds() -> Bool {
  match affected_testgen_selected_claims() {
    Cons { head: claim, tail: Empty } =>
      affected_testgen_selected_claim_runs_pass(claim: claim)
    _ => false
  }
}


fn affected_testgen_unrelated_diff_selects_no_claims_holds() -> Bool {
  match affected_testgen_reading_from_fixture_diff(git_diff: affected_testgen_unrelated_git_diff) {
    Holds { value: reading } =>
      length(xs: affected_testgen_generated_claims_for_reading(reading: reading)) == 0
    Violates { diagnostic: _ } => true
  }
}


fn affected_testgen_fusion_holds() -> Bool {
  affected_testgen_selects_one_generated_claim_holds()
    && affected_testgen_generated_claim_run_passes_holds()
    && affected_testgen_unrelated_diff_selects_no_claims_holds()
}


type AffectedTestgenClaimRunRow {
  label: String
  entry: String
  function: String
}


data affected_testgen_gate_entry: String = "src/v4/test/claim/workflow/affected_testgen_ci_runner.dag"


data affected_testgen_gate_row_selects_generated_claim: AffectedTestgenClaimRunRow = AffectedTestgenClaimRunRow {
  label: "affected-testgen selects one generated witness-validity claim",
  entry: affected_testgen_gate_entry,
  function: "affected_testgen_selects_one_generated_claim_holds"
}


data affected_testgen_gate_row_generated_claim_runs: AffectedTestgenClaimRunRow = AffectedTestgenClaimRunRow {
  label: "affected-testgen generated claim runs through run_test_claim",
  entry: affected_testgen_gate_entry,
  function: "affected_testgen_generated_claim_run_passes_holds"
}


data affected_testgen_gate_row_fusion: AffectedTestgenClaimRunRow = AffectedTestgenClaimRunRow {
  label: "affected-testgen fusion diff to generated run",
  entry: affected_testgen_gate_entry,
  function: "affected_testgen_fusion_holds"
}


data affected_testgen_claim_run_rows: List<AffectedTestgenClaimRunRow> = [
  affected_testgen_gate_row_selects_generated_claim,
  affected_testgen_gate_row_generated_claim_runs,
  affected_testgen_gate_row_fusion
]


data affected_testgen_claim_run_row_count: String = "3"
