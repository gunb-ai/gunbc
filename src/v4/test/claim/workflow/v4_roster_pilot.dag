type V4RosterPilotClaimRunRow {
  label: String
  entry: String
  // 🟡 gated — feature:v4-roster-pilot-symbol-transport-bridge — shell `function` String is transport projection of `function_symbol` via `v4_roster_pilot_witness_function_spellings`; dissolve-on: Phase 4 CI transport consumes Symbol authority; forbidden: independent `function` edits diverging from spellings map.
  function: String
  function_symbol: Symbol
}


// Mechanical registry projection — consolidation #4553 Phase 1 (not a hand-maintained parallel list).
fn bool_witness_from_roster_row(row: V4RosterPilotClaimRunRow) -> BoolWitness {
  BoolWitness { entry: row.entry, function: row.function_symbol }
}


// 🟡 gated — bootstrap-limitation interim — feature:B-LOOKUP-1 — map_get(Outcome<Optional<V>>);
// dissolve-on: bootstrap Witness<V> dispatch at Map.lookup (substrate Witness at v4.std.collection:70);
// site: v4_roster_pilot_row_function_transport_matches_symbol spellings bridge.
fn v4_roster_pilot_row_function_transport_matches_symbol(row: V4RosterPilotClaimRunRow) -> Bool {
  match map_get(m: v4_roster_pilot_witness_function_spellings(), key: row.function_symbol) {
    Accepted { value: opt, diagnostics: _ } => match opt {
      Present { value: spelling } => row.function == spelling
      Absent => false
    }
    Rejected { diagnostics: _ } => false
  }
}


