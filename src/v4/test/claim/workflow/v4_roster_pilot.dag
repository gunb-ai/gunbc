  function: "map_lookup_miss_violates_and_hit_holds"
}

// Structural-key Map== is extensional set equality (decidable): a non-String-key map
// equals itself and equals an independently-built map with the same key→latest-value
// mapping, while distinct keys / values stay unequal. Carries the closure-form
// Map==-always-false bug fix (native maps keyed by the Value-equality authority);
// reverting it turns the struct_key_self_eq arm red.
data v4_roster_pilot_row_map_structural_key_equality: V4RosterPilotClaimRunRow = V4RosterPilotClaimRunRow {
  label: "structural-key Map== is extensional set equality",
  entry: "src/v4/test/claim/manual/map_structural_key_equality.dag",
  function: "map_structural_key_equality_holds"
}

