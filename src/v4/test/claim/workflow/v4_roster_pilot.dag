// Host transport projection: shell reads this count and list member names only (not free awk scan).
data v4_roster_pilot_claim_run_row_count: String = "27"


fn v4_roster_pilot_row_matches(
  row: V4RosterPilotClaimRunRow,
  entry: String,
  function: String
) -> Bool {
  row.entry == entry && row.function == function
}


fn v4_roster_pilot_claim_run_list_contains_once(
  row: V4RosterPilotClaimRunRow
) -> Bool {
  count_equal(
    xs: v4_roster_pilot_claim_run_rows,
    item: row,
    eq: fn(left, right) { left == right }
  ) == 1
}


fn v4_roster_pilot_claim_run_list_composition_holds() -> Bool {
  v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_edit_locus_narrow)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_edit_locus_fail_closed)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_generator_provenance)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_testgen_shadow_ci)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_testgen_dag_input_scheduled)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_testgen_dag_input_bootstrap)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_model_core_bool_fact_lookup)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_grounding_terminal_gate)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_grounding_ts_symbol_carrier)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_grounding_ts_absence_fail_closed)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_discriminant_intrinsic)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_sg_rc_f6_owned)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_std_text_freemonoid_carrier)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_std_text_roundtrip)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_std_text_empty_roundtrip)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_std_text_field_text)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_mvp1_rust_emit_add_fn)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_application_introspect_advisory)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_application_synthesis_gap)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_idempotency_write_effect)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_identical_variant_unrealized)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_affected_set_irt1_boundary_prune)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_affected_set_irt1_fail_closed_pending)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_affected_set_irt1_fail_closed_absorption)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_affected_set_irt1_empty_diff)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_registry_required_ids_resolve)
    && v4_roster_pilot_claim_run_list_contains_once(row: v4_roster_pilot_row_lens_registry_singleton_row_counts)
}


