  pipeline: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [alternate_job] },
      CiJob { id: alternate_job, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [v2_compile_src_v4] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 },
      CiGate { id: alternate_gate, job: alternate_job }
    ]
  }
}


