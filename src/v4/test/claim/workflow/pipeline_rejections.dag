// src/v4/test/claim/workflow/pipeline_rejections.dag
// Scope: workflow pipeline rejection TestClaim data.
// Owns: PipelineRejectionCase and pipeline rejection TestClaimRun rows.
// Consumes: v4.compiler.eval, v4.compiler.infer, v4.std.verification, v4.workflow.ci, v4.workflow.bootstrap.
// Status: workflow-owned rejection coverage for the Wave-0 TestClaim runner.


module v4.test.claim.workflow.pipeline_rejections


import v4.compiler.eval {
  EvalContext,
  TestClaimEvalSubject,
  TestClaimRun,
  TestClaimTypedInput,
  Verdict,
  Deferred,
  Fail,
  Pass,
  eval_diagnostic,
  eval_rejected_assert_kind_deferred,
  eval_rejected_roundtrip_deferred,
  outcome_node_eq,
  test_claim_cache_receipt
}
import v4.compiler.infer {
  AlgebraRef,
  InferredFacts,
  InferredTree
}
import v4.lens.cost { UnknownCost }
import v4.std.cardinality {
  RankingDimension,
  TerminationProof
}
import v4.std.collection { Map }
import v4.std.node {
  Atom,
  Hash,
  Node,
  Symbol,
  TypeNode
}
import v4.std.diagnostic {
  Outcome,
  Produced,
  Rejected
}
import v4.std.verification {
  AssertKind,
  Compiles,
  DiagnosticAssert,
  Equals,
  RoundTrips,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit
}
import v4.std.witness { Holds }
import v4.workflow.bootstrap { v4_stage0_binary }
import v4.workflow.ci {
  BootstrapStageCompile,
  CiGate,
  CiJob,
  CiPipeline,
  ci_bootstrap_authority_violation,
  ci_dangling_reference,
  ci_dependency_cycle,
  ci_diagnostic,
  ci_duplicate_gate_id,
  ci_duplicate_job_id,
  ci_pipeline_well_formed,
  structural_v2_compile,
  v2_compile_src_v4
}


// RULING-1: needs-more-work — workflow cases are gated by the gate_* receipt rows below.
type PipelineRejectionCase {
  label: String
  input_symbol: Symbol
  expected_reason: Symbol
  pipeline: CiPipeline
}


data eval_rejected_pipeline_projection_deferred: Symbol = eval_rejected_pipeline_projection_deferred


fn run_pipeline_assert(
  kind: AssertKind,
  actual: Outcome<CiPipeline>,
  expected: Outcome<Node>,
  input: Node
) -> Verdict<CiPipeline> {
  match kind {
    Equals => match actual {
      Produced { value: _ } => match expected {
        Produced { value: _ } => Deferred {
          actual: actual,
          diagnostic: eval_diagnostic(reason: eval_rejected_pipeline_projection_deferred, node: input)
        }
        Rejected { diagnostic: _ } => Fail { actual: actual }
      }
      Rejected { diagnostic: d } => {
        let comparable = Rejected { diagnostic: d }
        if outcome_node_eq(a: comparable, b: expected) { Pass } else { Fail { actual: actual } }
      }
    }
    Compiles => match actual {
      Produced { value: _ } => Pass
      Rejected { diagnostic: _ } => Fail { actual: actual }
    }
    RoundTrips => Deferred {
      actual: actual,
      diagnostic: eval_diagnostic(reason: eval_rejected_roundtrip_deferred, node: input)
    }
    DiagnosticAssert => Deferred {
      actual: actual,
      diagnostic: eval_diagnostic(reason: eval_rejected_assert_kind_deferred, node: input)
    }
  }
}


fn workflow_pipeline_pass_gate(run: TestClaimRun<CiPipeline>) -> Verdict<TestClaimRun<CiPipeline>> {
  match run.verdict {
    Pass => Pass
    Fail { actual: _ } => Fail { actual: Produced { value: run } }
    Deferred { actual: _, diagnostic: d } => Deferred { actual: Produced { value: run }, diagnostic: d }
  }
}


data dangling_bootstrap_output: Symbol = dangling_bootstrap_output
data duplicate_job_id: Symbol = duplicate_job_id
data duplicate_gate_id: Symbol = duplicate_gate_id
data dangling_need: Symbol = dangling_need
data dangling_gate_job: Symbol = dangling_gate_job
data dependency_cycle: Symbol = dependency_cycle
data missing_stage_binary: Symbol = missing_stage_binary
data alternate_job: Symbol = alternate_job
data alternate_gate: Symbol = alternate_gate
data pipeline_evaluator: Symbol = pipeline_evaluator
data pipeline_resources: Symbol = pipeline_resources
data pipeline_extdeps: Symbol = pipeline_extdeps
data inferred_type_symbol: Symbol = inferred_type_symbol
data inferred_algebra_symbol: Symbol = inferred_algebra_symbol
data inferred_algebra_witness_symbol: Symbol = inferred_algebra_witness_symbol
data inferred_descent_symbol: Symbol = inferred_descent_symbol
// 🟡 typed-input bridge scaffold — T22-EVAL-TYPED-INPUT-BRIDGE
// 🟡 cache-hash scaffold — T22-EVAL-CACHE-HASHES
data claim_hash_placeholder: Hash = claim_hash_placeholder
data evaluator_hash_placeholder: Hash = evaluator_hash_placeholder
data resources_hash_placeholder: Hash = resources_hash_placeholder
data extdeps_hash_placeholder: Hash = extdeps_hash_placeholder


fn pipeline_symbol_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


fn workflow_inferred_algebra_ref() -> AlgebraRef {
  AlgebraRef {
    algebra: pipeline_symbol_node(s: inferred_algebra_symbol),
    witness: pipeline_symbol_node(s: inferred_algebra_witness_symbol)
  }
}


fn workflow_inferred_facts() -> InferredFacts {
  InferredFacts {
    resolved_type: pipeline_symbol_node(s: inferred_type_symbol),
    inhabits: workflow_inferred_algebra_ref(),
    cost: UnknownCost { reason: "workflow pipeline inferred cost scaffold" },
    descent: TerminationProof {
      non_increasing: [],
      strict: RankingDimension { measured: inferred_descent_symbol }
    }
  }
}


fn workflow_inferred_fact_map(facts: InferredFacts) -> Map<Node, InferredFacts> {
  Map {
    lookup: fn(_) {
      Holds { value: facts }
    }
  }
}


fn workflow_inferred_tree(root: Node) -> InferredTree {
  let facts = workflow_inferred_facts()
  InferredTree {
    root: root,
    facts: workflow_inferred_fact_map(facts: facts)
  }
}


fn pipeline_rejection_claim(label: String, input: Node, expected_reason: Symbol) -> TestClaim {
  TestClaim {
    kind: Equals,
    label: label,
    t19_anchor: T19ManualAnchorAbsent,
    input: input,
    expected: Rejected { diagnostic: ci_diagnostic(reason: expected_reason) },
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}


fn pipeline_claim_context() -> EvalContext {
  EvalContext {
    evaluator: pipeline_symbol_node(s: pipeline_evaluator),
    resources: pipeline_symbol_node(s: pipeline_resources),
    extdeps: pipeline_symbol_node(s: pipeline_extdeps)
  }
}


fn pipeline_rejection_subject(
  case: PipelineRejectionCase
) -> TestClaimEvalSubject<CiPipeline> {
  let input = pipeline_symbol_node(s: case.input_symbol)
  let claim = pipeline_rejection_claim(label: case.label, input: input, expected_reason: case.expected_reason)
  TestClaimEvalSubject {
    claim: claim,
    context: pipeline_claim_context(),
    tree: workflow_inferred_tree(root: claim.input),
    input: TestClaimTypedInput { evaluator_input: case.pipeline }
  }
}


fn workflow_pipeline_run(subject: TestClaimEvalSubject<CiPipeline>) -> TestClaimRun<CiPipeline> {
  let actual = ci_pipeline_well_formed(p: subject.input.evaluator_input)
  TestClaimRun {
    cache: test_claim_cache_receipt(
      subject: subject,
      claim_hash: claim_hash_placeholder,
      evaluator_hash: evaluator_hash_placeholder,
      resources_hash: resources_hash_placeholder,
      extdeps_hash: extdeps_hash_placeholder
    ),
    verdict: run_pipeline_assert(
      kind: subject.claim.kind,
      actual: actual,
      expected: subject.claim.expected,
      input: subject.claim.input
    )
  }
}


data case_dangling_bootstrap_output: PipelineRejectionCase = PipelineRejectionCase {
  label: "workflow_pipeline_dangling_bootstrap_output",
  input_symbol: dangling_bootstrap_output,
  expected_reason: ci_bootstrap_authority_violation,
  pipeline: CiPipeline {
    jobs: [
      CiJob {
        id: v2_compile_src_v4,
        command: BootstrapStageCompile { produces: missing_stage_binary },
        needs: []
      }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  }
}


data subject_dangling_bootstrap_output: TestClaimEvalSubject<CiPipeline> = pipeline_rejection_subject(case: case_dangling_bootstrap_output)


data run_dangling_bootstrap_output: TestClaimRun<CiPipeline> = workflow_pipeline_run(subject: subject_dangling_bootstrap_output)


data gate_dangling_bootstrap_output: Verdict<TestClaimRun<CiPipeline>> = workflow_pipeline_pass_gate(run: run_dangling_bootstrap_output)


