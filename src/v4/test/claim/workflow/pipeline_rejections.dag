  label: "workflow_pipeline_dangling_need",
  input_symbol: dangling_need,
  expected_reason: ci_dangling_reference,
  pipeline: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [alternate_job] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  }
}


