// src/v4/test/claim/workflow/manual_corpus_eval.dag
// Scope: T-38-PR2 verdict-surface migration — authoring-time corpus tally over the manual
// TestClaimRun roster (run_manual_testclaim_corpus_eval). Mirrors the rung-8 *_eval.dag pattern
// (branch_dispatch_rung8_eval.dag) so the CI host transport surfaces a modeled per-row verdict
// tally instead of an opaque blocked_m1_subset string.
// Status: T-22 eval → TestClaimRun → CorpusEvalReport → VerdictTally (authoring-time witness).
// 🟡 gated — feature:t38-testclaim-corpus-eval — bind src/v4/TASKS.md T-38 +
// docs/planning/v4-p5-structural-bridge-replacement-worksheet-2026-05-30.md §1.4. This is the
// authoring-time verdict SURFACE (const witness); per-row RUNTIME execution (cargo-clean M1
// emitted subset OR bootstrap-evaluator corpus path) remains the residual blocked_m1_subset gate
// escalated as upward debt — do NOT claim runtime verdict execution from this witness.

module v4.test.claim.workflow.manual_corpus_eval


import v4.std.algebra { is_empty }
import v4.std.logic { Bool }
import v4.std.nat { Zero }
import v4.test.claim.workflow.testclaim_corpus_runner {
  CorpusEvalReport,
  corpus_report_tally,
  run_manual_testclaim_corpus_eval
}


// F5 acceptance: non-empty roster AND every row Pass (zero Fail, zero Deferred).
// Requiring fail == Zero (not deferred-only) keeps a Verdict::Fail from silently closing the
// witness — a Fail row holds the gate open, so the Fail fact flows forward to the surface.
fn manual_corpus_gate(report: CorpusEvalReport) -> Bool {
  if is_empty(xs: report.entries) {
    false
  } else {
    manual_corpus_all_pass(report: report)
  }
}


fn manual_corpus_all_pass(report: CorpusEvalReport) -> Bool {
  let tally = corpus_report_tally(r: report)
  (tally.fail == Zero) && (tally.deferred == Zero)
}


data witness_manual_corpus_gate_closed: Bool = manual_corpus_gate(report: run_manual_testclaim_corpus_eval())
