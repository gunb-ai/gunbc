// src/v4/test/claim/workflow/affected_set_ci_runner.dag
// Scope: T-21/T-24 receipt — CI runner narrows TestClaim roster via RerunNodeSet node frontier.
// Status: node-frontier selection claim-run witnesses (affected-set-3a); host gate
// scripts/v4-affected-set-node-frontier-gate.sh with --perturb-check.

module v4.test.claim.workflow.affected_set_ci_runner

import v4.lens.affected_set {
  RerunNodeSet,
  RerunNodeSetProduced
}
import v4.std.change {
  AffectedSet,
  AffectedSetFailClosed,
  AffectedSetEvidence,
  AffectedSetReason,
  ChangeSet
}
import v4.std.algebra { count_equal, filter, length }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Node, Positional, Symbol, TypeNode }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.workflow.ci {
  ci_select_from_affected_set,
  ci_select_from_rerun_nodes,
  test_claim_in_rerun_frontier
}

data ci_runner_untouched_symbol: Symbol = ci_runner_untouched_symbol
data ci_runner_touched_symbol: Symbol = ci_runner_touched_symbol
data ci_runner_other_symbol: Symbol = ci_runner_other_symbol
data ci_runner_shape_a_symbol: Symbol = ci_runner_shape_a_symbol
data ci_runner_shape_b_symbol: Symbol = ci_runner_shape_b_symbol
data ci_runner_fail_closed_reason: Symbol = ci_runner_fail_closed_reason

data ci_runner_untouched_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ci_runner_untouched_symbol } },
  children: []
}

data ci_runner_touched_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ci_runner_touched_symbol } },
  children: []
}

data ci_runner_other_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ci_runner_other_symbol } },
  children: []
}

data ci_runner_shape_a_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ci_runner_shape_a_symbol } },
  children: []
}

data ci_runner_shape_b_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ci_runner_shape_b_symbol } },
  children: []
}

data ci_runner_conj_wrapped_touched_node: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: ci_runner_touched_node
    }
  ]
}

data ci_runner_claim_untouched: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: untouched claim input",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_untouched_node,
  rhs: ci_runner_untouched_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data ci_runner_claim_touched: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: touched claim input",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_touched_node,
  rhs: ci_runner_touched_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data ci_runner_claim_other: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: other claim input",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_other_node,
  rhs: ci_runner_other_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data ci_runner_fixture_roster: List<TestClaim> = [
  ci_runner_claim_untouched,
  ci_runner_claim_touched,
  ci_runner_claim_other
]

data ci_runner_narrow_rerun_nodes: RerunNodeSet = RerunNodeSetProduced {
  nodes: [ci_runner_touched_node]
}

data ci_runner_fail_closed_evidence: AffectedSetEvidence = AffectedSetReason {
  reason: ci_runner_fail_closed_reason
}

data ci_runner_fail_closed_affected: AffectedSet = AffectedSetFailClosed {
  changes: ChangeSet { changes: [] },
  evidence: ci_runner_fail_closed_evidence
}

fn ci_runner_narrow_selection_holds() -> Bool {
  let rerun = ci_select_from_rerun_nodes(
    roster: ci_runner_fixture_roster,
    rerun: ci_runner_narrow_rerun_nodes
  )
  (length(xs: rerun) == 1)
    && count_equal(
      xs: rerun,
      item: ci_runner_claim_touched,
      eq: fn(left, right) { left == right }
    ) != 0
}

fn ci_runner_fail_closed_superset_holds() -> Bool {
  let roster = ci_select_from_affected_set(
    roster: ci_runner_fixture_roster,
    affected: ci_runner_fail_closed_affected
  )
  (length(xs: roster) == 3)
    && count_equal(
      xs: roster,
      item: ci_runner_claim_untouched,
      eq: fn(left, right) { left == right }
    ) != 0
    && count_equal(
      xs: roster,
      item: ci_runner_claim_touched,
      eq: fn(left, right) { left == right }
    ) != 0
    && count_equal(
      xs: roster,
      item: ci_runner_claim_other,
      eq: fn(left, right) { left == right }
    ) != 0
}

fn ci_runner_narrow_selection_rhs() -> Node {
  if ci_runner_narrow_selection_holds() {
    ci_runner_touched_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

fn ci_runner_fail_closed_superset_rhs() -> Node {
  if ci_runner_fail_closed_superset_holds() {
    ci_runner_untouched_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data ci_runner_narrow_selection_claim: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: RerunNodeSet narrows TestClaim roster to touched input",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_touched_node,
  rhs: ci_runner_narrow_selection_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data ci_runner_fail_closed_superset_claim: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: fail-closed affected-set selects full roster",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_untouched_node,
  rhs: ci_runner_fail_closed_superset_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data ci_runner_claim_shape_a: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: shape-a atom claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_shape_a_node,
  rhs: ci_runner_shape_a_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data ci_runner_claim_shape_b: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: shape-b atom claim (same shape, different Symbol)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_shape_b_node,
  rhs: ci_runner_shape_b_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data ci_runner_shape_collision_roster: List<TestClaim> = [
  ci_runner_claim_shape_a,
  ci_runner_claim_shape_b
]

data ci_runner_shape_collision_rerun_nodes: RerunNodeSet = RerunNodeSetProduced {
  nodes: [ci_runner_shape_a_node]
}

fn ci_runner_shape_collision_holds() -> Bool {
  let rerun = ci_select_from_rerun_nodes(
    roster: ci_runner_shape_collision_roster,
    rerun: ci_runner_shape_collision_rerun_nodes
  )
  (length(xs: rerun) == 1)
    && count_equal(
      xs: rerun,
      item: ci_runner_claim_shape_a,
      eq: fn(left, right) { left == right }
    ) != 0
}

fn ci_runner_shape_collision_rhs() -> Node {
  if ci_runner_shape_collision_holds() {
    ci_runner_shape_a_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data ci_runner_shape_collision_claim: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: shared Atom shape does not false-positive second claim",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_shape_a_node,
  rhs: ci_runner_shape_collision_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data ci_runner_claim_conj_wrapped: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: inner frontier atom inside Conj lhs",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_conj_wrapped_touched_node,
  rhs: ci_runner_conj_wrapped_touched_node,
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data ci_runner_inner_frontier_roster: List<TestClaim> = [
  ci_runner_claim_untouched,
  ci_runner_claim_conj_wrapped
]

data ci_runner_inner_frontier_rerun_nodes: RerunNodeSet = RerunNodeSetProduced {
  nodes: [ci_runner_touched_node]
}

fn ci_runner_inner_frontier_holds() -> Bool {
  let rerun = ci_select_from_rerun_nodes(
    roster: ci_runner_inner_frontier_roster,
    rerun: ci_runner_inner_frontier_rerun_nodes
  )
  (length(xs: rerun) == 1)
    && count_equal(
      xs: rerun,
      item: ci_runner_claim_conj_wrapped,
      eq: fn(left, right) { left == right }
    ) != 0
}

fn ci_runner_inner_frontier_rhs() -> Node {
  if ci_runner_inner_frontier_holds() {
    ci_runner_touched_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: []
    }
  }
}

data ci_runner_inner_frontier_claim: TestClaim = EqualsClaim {
  label: "workflow/affected_set_ci_runner: dependent inner atom matches Conj-wrapped lhs",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ci_runner_touched_node,
  rhs: ci_runner_inner_frontier_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
