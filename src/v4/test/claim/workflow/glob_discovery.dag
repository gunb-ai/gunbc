data glob_discovered_claim_run_row_count: String = "80"


fn glob_discovered_smoke_bool_witness_unified_claims() -> List<UnifiedTestClaim> {
  glob_discovered_smoke_bool_witness_unified_claims
}


fn glob_discovery_claim_is_bool_witness_modality(c: UnifiedTestClaim) -> Bool {
  unified_test_claim_modality(c: c) == UnifiedBoolWitnessModality
}


fn glob_discovery_smoke_claim_list_contains_once(c: UnifiedTestClaim) -> Bool {
  count_equal(
    xs: glob_discovered_smoke_bool_witness_unified_claims,
    item: c,
    eq: fn(left, right) { left == right }
  ) == 1
}


fn glob_discovery_all_smoke_claims_are_bool_witness_modality() -> Bool {
  fold(
    glob_discovered_smoke_bool_witness_unified_claims,
    init: true,
    f: fn(acc, c) { acc && glob_discovery_claim_is_bool_witness_modality(c: c) }
  )
}


