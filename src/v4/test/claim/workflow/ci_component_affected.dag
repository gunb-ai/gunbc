// src/v4/test/claim/workflow/ci_component_affected.dag
// Scope: T-24 receipt — git diff path buckets → CiComponentAffected flags (dissolves detect-affected-components.sh).
// Status: structural claims; host transport is `detect-ci-affected-components` (`tools/ci_affected_components` bin).

module v4.test.claim.workflow.ci_component_affected

import v4.lens.edit_locus { GitDiffNameOnly, RepoPath }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.workflow.ci {
  CiComponentAffected,
  ci_component_affected_from_git_diff
}

data ci_comp_path_src_v2: RepoPath = "src/v2/stage0/Cargo.toml"
data ci_comp_path_cargo_lock: RepoPath = "Cargo.lock"
data ci_comp_path_src_v3: RepoPath = "src/v3/compiler/src/lib.rs"
data ci_comp_path_dsl_v3_only: RepoPath = "dsl/gunbc/ci.dag"
data ci_comp_path_dsl_std: RepoPath = "dsl/std/node.dag"
data ci_comp_path_src_v4: RepoPath = "src/v4/workflow/ci.dag"
data ci_comp_path_src_v4_leaf_claim: RepoPath = "src/v4/test/claim/lens_affected_set/irt1_leaf_claim_suite.dag"
data ci_comp_path_src_v4_workflow_claim: RepoPath = "src/v4/test/claim/workflow/affected_set_ci_runner.dag"
data ci_comp_path_corpus_eval_transport: RepoPath = "scripts/v4-testclaim-corpus-eval.sh"
data ci_comp_path_v4_m1_script: RepoPath = ".github/ci-floor/v4-m1-rust-emit-probe.sh"
data ci_comp_path_workflow_yml: RepoPath = ".github/workflows/ci.yml"
data ci_comp_path_install_dag: RepoPath = "src/v4/install/install.dag"
data ci_comp_path_unrelated: RepoPath = "docs/README.md"

fn ci_comp_flags_for(paths: List<RepoPath>) -> CiComponentAffected {
  ci_component_affected_from_git_diff(git_diff: GitDiffNameOnly { changed_paths: paths })
}

fn ci_comp_v2_from_src_v2_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_src_v2])
  f.v2 && !f.v3 && !f.v4
}

fn ci_comp_v3_from_dsl_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_dsl_v3_only])
  !f.v2 && f.v3 && !f.v4
}

fn ci_comp_v3_and_v4_from_dsl_std_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_dsl_std])
  !f.v2 && f.v3 && f.v4
}

fn ci_comp_v4_from_m1_script_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_v4_m1_script])
  !f.v2 && !f.v3 && f.v4
}

fn ci_comp_v4_and_policy_from_ci_dag_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_src_v4])
  f.v4 && f.workflow_policy
}

fn ci_comp_testclaim_corpus_from_workflow_claim_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_src_v4_workflow_claim])
  !f.v2 && !f.v3 && !f.v4 && f.testclaim_corpus && !f.workflow_policy
}

fn ci_comp_testclaim_corpus_from_transport_script_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_corpus_eval_transport])
  !f.v2 && !f.v3 && !f.v4 && f.testclaim_corpus && !f.workflow_policy
}

fn ci_comp_cargo_lock_v2_v4_not_v3_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_cargo_lock])
  f.v2 && !f.v3 && f.v4
}

fn ci_comp_unrelated_all_false_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_unrelated])
  !f.v2 && !f.v3 && !f.v4 && !f.testclaim_corpus && !f.workflow_policy
}

fn ci_comp_v4_leaf_claim_does_not_trip_full_v4_bucket_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_src_v4_leaf_claim])
  !f.v2 && !f.v3 && !f.v4 && f.testclaim_corpus && !f.workflow_policy
}

fn ci_comp_install_dag_release_only_not_v4_holds() -> Bool {
  let f = ci_comp_flags_for(paths: [ci_comp_path_install_dag])
  !f.v2 && !f.v3 && !f.v4 && !f.testclaim_corpus && !f.workflow_policy && f.release_distribution
}

data ci_comp_v2_claim_passes: Bool = ci_comp_v2_from_src_v2_holds()
data ci_comp_v3_claim_passes: Bool = ci_comp_v3_from_dsl_holds()
data ci_comp_v3_v4_dsl_std_claim_passes: Bool = ci_comp_v3_and_v4_from_dsl_std_holds()
data ci_comp_v4_m1_script_claim_passes: Bool = ci_comp_v4_from_m1_script_holds()
data ci_comp_v4_policy_claim_passes: Bool = ci_comp_v4_and_policy_from_ci_dag_holds()
data ci_comp_testclaim_corpus_claim_passes: Bool = ci_comp_testclaim_corpus_from_workflow_claim_holds()
data ci_comp_corpus_eval_transport_claim_passes: Bool = ci_comp_testclaim_corpus_from_transport_script_holds()
data ci_comp_cargo_lock_claim_passes: Bool = ci_comp_cargo_lock_v2_v4_not_v3_holds()
data ci_comp_unrelated_claim_passes: Bool = ci_comp_unrelated_all_false_holds()
data ci_comp_v4_leaf_claim_passes: Bool = ci_comp_v4_leaf_claim_does_not_trip_full_v4_bucket_holds()
data ci_comp_install_dag_release_only_passes: Bool = ci_comp_install_dag_release_only_not_v4_holds()
