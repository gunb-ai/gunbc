// src/v4/test/claim/workflow/ci_consumer_node_precise.dag
// Scope: W3.9 F.3 receipt — the CI consumer is node-precise. A git-diff reading
//   (v4.lens.edit_locus affected_set_reading_from_git_diff -> Witness<AffectedSetReading>)
//   narrows the TestClaim roster to exactly the closure frontier Nodes, NOT coarse
//   component buckets. Fail-closed (no/ambiguous edit-locus) preserves the whole roster.
// Status: structural claims; host execution lands with generated TestClaim harness.
// Dissolution: when the generated workflow/TestClaim runner executes these facts, this
//   hand-authored Bool receipt is replaced by the generated runner receipt in the same lane.

module v4.test.claim.workflow.ci_consumer_node_precise

import v4.lens.affected_set { AffectedSetReading, affected_set_reading }
import v4.lens.edit_locus {
  EditLocusBinding,
  EditLocusRead,
  GitDiffNameOnly,
  PathRegex,
  RepoPath,
  affected_set_reading_from_git_diff
}
import v4.std.algebra { count_equal, length }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.text { String }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.std.witness { Holds, Violates }
import v4.test.claim.lens_affected_set.node_precision {
  affected_set_claim_tree,
  affected_set_leaf,
  affected_set_mid
}
import v4.workflow.ci {
  ci_select_from_affected_set_reading,
  ci_select_from_affected_set_reading_witness
}

// Unrelated node: not the edit-locus, not in the dependency-closure frontier. A
// node-precise consumer must NOT rerun a claim anchored here.
data ci_np_unrelated_symbol: Symbol = ci_np_unrelated_symbol

data ci_np_unrelated_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: ci_np_unrelated_symbol } },
  children: []
}

fn ci_np_equals_claim(label: String, node: Node) -> TestClaim {
  EqualsClaim {
    label: label,
    anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
    lhs: node,
    rhs: node,
    classification: TestClassification { tier: Tier1, layer: Unit }
  }
}

data ci_np_claim_mid: TestClaim = ci_np_equals_claim(
  label: "workflow/ci_consumer_node_precise: claim anchored at edit-locus (mid)",
  node: affected_set_mid
)

data ci_np_claim_leaf: TestClaim = ci_np_equals_claim(
  label: "workflow/ci_consumer_node_precise: claim anchored at frontier dependent (leaf)",
  node: affected_set_leaf
)

data ci_np_claim_unrelated: TestClaim = ci_np_equals_claim(
  label: "workflow/ci_consumer_node_precise: claim anchored off-frontier (unrelated)",
  node: ci_np_unrelated_node
)

data ci_np_roster: List<TestClaim> = [
  ci_np_claim_mid,
  ci_np_claim_leaf,
  ci_np_claim_unrelated
]

// Edit-locus fixture: the one bound path resolves to `affected_set_mid`; any other path
// fails to match (no binding) -> fail-closed Witness.
data ci_np_path_edit_locus: RepoPath = "src/v4/lens/affected_set.dag"
data ci_np_path_unknown: RepoPath = "src/v4/lens/unknown_path.dag"
data ci_np_pattern_mid: PathRegex = ci_np_pattern_mid

fn ci_np_path_regex_matches(changed: RepoPath, pattern: PathRegex) -> Bool {
  match pattern {
    ci_np_pattern_mid => changed == ci_np_path_edit_locus
    _ => false
  }
}

data ci_np_edit_read: EditLocusRead = EditLocusRead {
  path_regex_matches: ci_np_path_regex_matches
}

data ci_np_binding: EditLocusBinding = EditLocusBinding {
  pattern: ci_np_pattern_mid,
  locus: affected_set_mid
}

data ci_np_narrow_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [ci_np_path_edit_locus]
}

data ci_np_unknown_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: [ci_np_path_unknown]
}

fn ci_np_contains(roster: List<TestClaim>, claim: TestClaim) -> Bool {
  count_equal(xs: roster, item: claim, eq: fn(left, right) { left == right }) != 0
}

// CI consumer over an explicit node-precise reading narrows to exactly the frontier-anchored
// claims (mid + leaf), excluding the off-frontier claim. This is node-precision: the roster is
// cut to the closure Nodes, not to a component bucket.
fn ci_np_reading_narrows_holds() -> Bool {
  let reading = affected_set_reading(graph: affected_set_claim_tree(), edit_locus: affected_set_mid)
  let selected = ci_select_from_affected_set_reading(roster: ci_np_roster, reading: reading)
  (length(xs: selected) == 2)
    && ci_np_contains(roster: selected, claim: ci_np_claim_mid)
    && ci_np_contains(roster: selected, claim: ci_np_claim_leaf)
    && !ci_np_contains(roster: selected, claim: ci_np_claim_unrelated)
}

// Same narrowing through the git-diff Witness path: edit-locus resolves -> Holds -> node-precise.
fn ci_np_git_diff_narrows_holds() -> Bool {
  let witness = affected_set_reading_from_git_diff(
    edit_read: ci_np_edit_read,
    graph: affected_set_claim_tree(),
    git_diff: ci_np_narrow_git_diff,
    bindings: [ci_np_binding]
  )
  let selected = ci_select_from_affected_set_reading_witness(
    roster: ci_np_roster,
    reading_witness: witness
  )
  (length(xs: selected) == 2)
    && ci_np_contains(roster: selected, claim: ci_np_claim_mid)
    && ci_np_contains(roster: selected, claim: ci_np_claim_leaf)
    && !ci_np_contains(roster: selected, claim: ci_np_claim_unrelated)
}

// Fail-closed: no edit-locus match -> Violates -> the whole roster reruns (superset),
// mirroring ci_select_from_rerun_nodes' RerunNodeSetFailClosed arm.
fn ci_np_git_diff_fail_closed_holds() -> Bool {
  let witness = affected_set_reading_from_git_diff(
    edit_read: ci_np_edit_read,
    graph: affected_set_claim_tree(),
    git_diff: ci_np_unknown_git_diff,
    bindings: [ci_np_binding]
  )
  let selected = ci_select_from_affected_set_reading_witness(
    roster: ci_np_roster,
    reading_witness: witness
  )
  (length(xs: selected) == 3)
    && ci_np_contains(roster: selected, claim: ci_np_claim_mid)
    && ci_np_contains(roster: selected, claim: ci_np_claim_leaf)
    && ci_np_contains(roster: selected, claim: ci_np_claim_unrelated)
}

// Falsification: the Witness arm must agree with the resolved reading. If the git-diff Holds,
// its narrowed selection equals the explicit-reading selection (both exclude the off-frontier
// claim). A consumer that ignored the reading and returned the full roster would fail here.
fn ci_np_witness_matches_reading_holds() -> Bool {
  match affected_set_reading_from_git_diff(
    edit_read: ci_np_edit_read,
    graph: affected_set_claim_tree(),
    git_diff: ci_np_narrow_git_diff,
    bindings: [ci_np_binding]
  ) {
    Holds { value: _ } => ci_np_git_diff_narrows_holds() && ci_np_reading_narrows_holds()
    Violates { diagnostic: _ } => false
  }
}

data ci_np_reading_narrows_passes: Bool = ci_np_reading_narrows_holds()
data ci_np_git_diff_narrows_passes: Bool = ci_np_git_diff_narrows_holds()
data ci_np_git_diff_fail_closed_passes: Bool = ci_np_git_diff_fail_closed_holds()
data ci_np_witness_matches_reading_passes: Bool = ci_np_witness_matches_reading_holds()
