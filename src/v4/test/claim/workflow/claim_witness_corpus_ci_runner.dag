// src/v4/test/claim/workflow/claim_witness_corpus_ci_runner.dag
// Scope: compiler-semantics claim-witness corpus CI enrollment (baseline-pinned expectations).
// Status: host gate scripts/v4-claim-witness-corpus-gate.sh (v4_claim_witness_corpus_{a,b}
//   parallel shards). CI: --shard a|b --spot-perturb-check (1–2 rows/run, GITHUB_RUN_NUMBER
//   rotation); full --perturb-check local-only. Sign runner (2026-06-13): monolith 20-row
//   spot-perturb measured 1108s (~18.5m) — exceeds 13m gate; two ~10-row shards target
//   <10m uncontended/shard (×2 ≈ 20m ≤ 20m ceiling per shard; documented-tail clause).
//
// Design-sign notes (alternatives rejected):
// - TSV/YAML sidecar manifest: rejected — substrate rows are the authority (MODELING.md); one-row
//   enrollment must stay a single .dag data binding.
// - Reuse LensCiClaimRunRow (must-pass only): rejected — no field for ExpectFail + bind_anchor;
//   extending lens_ci_gate.dag would mix lens-analysis receipts with compiler-semantics keystones.
// - Reuse AffectedSetNodeFrontierClaimRunRow: rejected — same must-pass-only shape; this roster is
//   a distinct enrollment family with pinned ExpectFail baselines.
// - ExpectPass | ExpectFail { bind_anchor } coproduct: chosen — fail-closed bind anchor is required
//   on every expected-red row at authoring time (shell gate also enforces non-empty bind_anchor).

module v4.test.claim.workflow.claim_witness_corpus_ci_runner

import v4.std.collection { List }
import v4.std.text { String }

type ClaimWitnessCorpusExpectation
  = ExpectPass
  | ExpectFail { bind_anchor: String }

type ClaimWitnessCorpusClaimRunRow {
  label: String
  entry: String
  function: String
  expected: ClaimWitnessCorpusExpectation
}

data corpus_ci_gate_row_mvp1_emit_matches_serialize: ClaimWitnessCorpusClaimRunRow = ClaimWitnessCorpusClaimRunRow {
