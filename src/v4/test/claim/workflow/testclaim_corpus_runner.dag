// src/v4/test/claim/workflow/testclaim_corpus_runner.dag
// Scope: T-38 modeled corpus-level TestClaim runner over manual roster.
// Status: wedge — evaluate manual_corpus_node_subject_rows into CorpusEvalReport.
// 🟡 gated — feature:t38-testclaim-corpus-eval — bind src/v4/TASKS.md T-38 + docs/planning/v4-p5-structural-bridge-replacement-worksheet-2026-05-30.md §1.4 — CI host transport is scripts/v4-testclaim-corpus-eval.sh under positive-Y `ci_upsert_testclaim_corpus_eval_*`. T-38-PR2: the runner maps each manual subject row through `run_test_claim`; manual_corpus_eval_expected.dag pins per-row verdict+reason for the drift gate.

module v4.test.claim.workflow.testclaim_corpus_runner


import v4.compiler.eval {
  TestClaimEvalSubject,
  TestClaimRun,
  run_test_claim,
  test_claim_run_claim,
  test_claim_run_verdict
}
import v4.std.algebra { length }
import v4.std.collection { Absent, List, Optional }
import v4.std.logic { Bool }
import v4.std.nat { Nat }
import v4.std.node { Node, Symbol }
import v4.std.runtime { RuntimeValue }
import v4.std.verdict {
  VerdictTally,
  verdict_tally_add,
  verdict_tally_empty,
  verdict_tally_total
}
import v4.std.verification {
  BoolWitness,
  EvalOnly,
  NodeCorpus,
  UnifiedTestClaim,
  bool_witness_descriptor,
  test_claim_label,
  unified_test_claim_modality,
  UnifiedBoolWitnessModality,
  UnifiedNodeCorpusModality
}
import v4.test.claim.manual.manual_corpus_roster {
  manual_corpus_node_subject_rows
}
import v4.test.claim.workflow.v4_roster_pilot {
  V4RosterPilotClaimRunRow,
  bool_witness_from_roster_row,
  v4_roster_pilot_claim_run_rows,
  v4_roster_pilot_claim_run_row_transport_symbol_consistency_holds
}


// Consolidation #4553 Phase 2: execution receipts are unified here at the workflow layer.
// `UnifiedTestClaim` remains a descriptor-only registration row in `std.verification`.
type BoolWitnessExecutionStatus
  = BoolWitnessRuntimeVerdict
  | BoolWitnessQueuedForHostTransport


type BoolWitnessRun {
  witness: BoolWitness
  result: Optional<Bool>
  execution_status: BoolWitnessExecutionStatus
}


type UnifiedClaimRun
  = NodeCorpusRun { run: TestClaimRun<Node, RuntimeValue> }
  | BoolWitnessRunReceipt { run: BoolWitnessRun }


type CorpusEvalEntry {
  run: UnifiedClaimRun
}


type CorpusEvalReport {
  entries: List<CorpusEvalEntry>
}


type TestClaimSubjectRosterUnsupportedRow {
  subject_family: Symbol
  reason: Symbol
}


type TestClaimSubjectRosterFamilyReceipt {
  subject_family: Symbol
  run_family: Symbol
  subjects: List<TestClaimEvalSubject<Node>>
  runs: List<TestClaimRun<Node, RuntimeValue>>
  unsupported_rows: List<TestClaimSubjectRosterUnsupportedRow>
  report: CorpusEvalReport
}
data testclaim_subject_roster_unsupported_rows: List<TestClaimSubjectRosterUnsupportedRow> = [
  TestClaimSubjectRosterUnsupportedRow {
    subject_family: ^testclaim_subject_roster_family_ci_pipeline,
    reason: ^testclaim_subject_roster_unsupported_until_runner_projection_lands
  },
  TestClaimSubjectRosterUnsupportedRow {
    subject_family: ^testclaim_subject_roster_family_non_runtime_value,
    reason: ^testclaim_subject_roster_unsupported_until_runner_projection_lands
  }
]


fn corpus_entry_label(e: CorpusEvalEntry) -> String {
  match e.run {
    NodeCorpusRun { run: node_run } =>
      test_claim_label(c: test_claim_run_claim(run: node_run))
    BoolWitnessRunReceipt { run: bool_run } =>
      bool_run.witness.entry
  }
}


fn corpus_report_tally(r: CorpusEvalReport) -> VerdictTally {
  fold(r.entries, init: verdict_tally_empty, f: fn(acc, e) {
    match e.run {
      NodeCorpusRun { run: node_run } =>
        verdict_tally_add(t: acc, v: test_claim_run_verdict(run: node_run))
      BoolWitnessRunReceipt { run: _ } =>
        acc
    }
  })
}


fn corpus_report_pass_count(r: CorpusEvalReport) -> Nat {
  corpus_report_tally(r: r).pass
}


fn corpus_report_fail_count(r: CorpusEvalReport) -> Nat {
  corpus_report_tally(r: r).fail
}


fn corpus_report_deferred_count(r: CorpusEvalReport) -> Nat {
  corpus_report_tally(r: r).deferred
}


fn corpus_report_total(r: CorpusEvalReport) -> Nat {
  verdict_tally_total(t: corpus_report_tally(r: r))
}


fn corpus_entry_from_node_runtime_value_run(
  run: TestClaimRun<Node, RuntimeValue>
) -> CorpusEvalEntry {
  CorpusEvalEntry { run: NodeCorpusRun { run: run } }
}


fn corpus_entries_from_node_runtime_value_runs(
  runs: List<TestClaimRun<Node, RuntimeValue>>
) -> List<CorpusEvalEntry> {
  map(runs, fn(run) { corpus_entry_from_node_runtime_value_run(run: run) })
}


fn run_node_runtime_value_subjects(
  subjects: List<TestClaimEvalSubject<Node>>
) -> List<TestClaimRun<Node, RuntimeValue>> {
  map(subjects, fn(subject) { run_test_claim(subject: subject) })
}


fn node_corpus_claim_from_subject(subject: TestClaimEvalSubject<Node>) -> UnifiedTestClaim {
  NodeCorpus {
    claim: subject.claim,
    transport: EvalOnly
  }
}


fn manual_node_corpus_unified_claims() -> List<UnifiedTestClaim> {
  map(manual_corpus_node_subject_rows, fn(subject) { node_corpus_claim_from_subject(subject: subject) })
}


fn bool_witness_unified_claim_from_roster_row(row: V4RosterPilotClaimRunRow) -> UnifiedTestClaim {
  bool_witness_descriptor(w: bool_witness_from_roster_row(row: row))
}


fn v4_roster_pilot_bool_witness_unified_claims() -> List<UnifiedTestClaim> {
  map(v4_roster_pilot_claim_run_rows, fn(row) { bool_witness_unified_claim_from_roster_row(row: row) })
}


fn queued_bool_witness_run(witness: BoolWitness) -> BoolWitnessRun {
  BoolWitnessRun {
    witness: witness,
    result: Absent,
    execution_status: BoolWitnessQueuedForHostTransport
  }
}


fn corpus_entry_from_queued_bool_witness(witness: BoolWitness) -> CorpusEvalEntry {
  CorpusEvalEntry {
    run: BoolWitnessRunReceipt { run: queued_bool_witness_run(witness: witness) }
  }
}


fn v4_roster_pilot_queued_bool_witness_entries() -> List<CorpusEvalEntry> {
  map(
    v4_roster_pilot_claim_run_rows,
    fn(row) { corpus_entry_from_queued_bool_witness(witness: bool_witness_from_roster_row(row: row)) }
  )
}


fn unified_claim_is_node_corpus(c: UnifiedTestClaim) -> Bool {
  match unified_test_claim_modality(c: c) {
    UnifiedNodeCorpusModality => true
    UnifiedBoolWitnessModality => false
  }
}


fn unified_claim_is_bool_witness(c: UnifiedTestClaim) -> Bool {
  match unified_test_claim_modality(c: c) {
    UnifiedBoolWitnessModality => true
    UnifiedNodeCorpusModality => false
  }
}


fn manual_node_corpus_unified_claim_projection_holds() -> Bool {
  fold(
    manual_node_corpus_unified_claims(),
    init: true,
    f: fn(acc, c) { acc && unified_claim_is_node_corpus(c: c) }
  )
}


fn v4_roster_pilot_bool_witness_unified_claim_projection_holds() -> Bool {
  v4_roster_pilot_claim_run_row_transport_symbol_consistency_holds()
    && (length(xs: v4_roster_pilot_bool_witness_unified_claims()) == length(xs: v4_roster_pilot_claim_run_rows))
    && fold(
      v4_roster_pilot_bool_witness_unified_claims(),
      init: true,
      f: fn(acc, c) { acc && unified_claim_is_bool_witness(c: c) }
    )
}


fn run_manual_testclaim_corpus_eval() -> CorpusEvalReport {
  CorpusEvalReport {
    entries: corpus_entries_from_node_runtime_value_runs(
      runs: run_node_runtime_value_subjects(subjects: manual_corpus_node_subject_rows)
    )
  }
}


fn manual_testclaim_subject_roster_family_receipt() -> TestClaimSubjectRosterFamilyReceipt {
  let runs = run_node_runtime_value_subjects(subjects: manual_corpus_node_subject_rows)
  TestClaimSubjectRosterFamilyReceipt {
    subject_family: ^testclaim_subject_roster_family_node_runtime_value,
    run_family: ^run_test_claim,
    subjects: manual_corpus_node_subject_rows,
    runs: runs,
    unsupported_rows: testclaim_subject_roster_unsupported_rows,
    report: CorpusEvalReport {
      entries: corpus_entries_from_node_runtime_value_runs(runs: runs)
    }
  }
}


fn manual_testclaim_subject_roster_family_receipt_holds() -> Bool {
  let receipt = manual_testclaim_subject_roster_family_receipt()
  receipt.report.entries == corpus_entries_from_node_runtime_value_runs(runs: receipt.runs)
}


data witness_manual_testclaim_subject_roster_family_receipt: Bool = manual_testclaim_subject_roster_family_receipt_holds()
data witness_manual_node_corpus_unified_claim_projection: Bool = manual_node_corpus_unified_claim_projection_holds()
data witness_v4_roster_pilot_bool_witness_unified_claim_projection: Bool = v4_roster_pilot_bool_witness_unified_claim_projection_holds()
