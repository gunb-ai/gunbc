// src/v4/test/claim/workflow/testclaim_corpus_runner.dag
// Scope: T-38 — modeled corpus-level TestClaim runner over the manual roster.
// Status: wedge — folds the TestClaimRun<Node, RuntimeValue> roster into a
//   CorpusEvalReport. Per-row verdicts are produced at .dag eval time by the
//   underlying TestClaimRun rows (see v4.compiler.eval.run_test_claim) and
//   propagate faithfully through the report — Verdict<RuntimeValue> is the
//   closed entry payload, so Fail/Deferred diagnostics survive to the host
//   boundary instead of being erased to a Symbol tag.
//
// Counts (pass/fail/deferred/total) are derived projections (fns), not
// fields, so inconsistent (entries, counts) pairs are unrepresentable —
// entries are the single authority and counts cannot diverge from them.
//
// The host harness scripts/v4-testclaim-corpus-eval.sh compiles src/v4
// --target rust and executes the emitted Rust mirror of the entry
// `run_manual_testclaim_corpus_eval` over a minimal subset crate (M1 subset
// strategy — not full-tree cargo-clean), then serializes the returned
// CorpusEvalReport to JSON (stdout) + a markdown table
// (GITHUB_STEP_SUMMARY). Selection narrowing
// (`ci_select_from_affected_set`) runs in v4.workflow.ci before the host
// harness folds the surviving roster. Non-zero exit if any entry's verdict
// is Fail.
//
// 🟡 gated — feature:t38-testclaim-corpus-eval — bind src/v4/TASKS.md T-38 —
// dissolve-on-arrival: same trigger as the structural bridge
// (scripts/v4-testclaim-corpus-gate.sh) — when this modeled runner replaces
// shell-owned artifact inspection in CI and the dissolution PR deletes the
// bridge script + ci.yml step + ci_github_actions_workflow.dag paired step.
module v4.test.claim.workflow.testclaim_corpus_runner


import v4.compiler.eval { TestClaimRun }
import v4.std.algebra { count_where, length }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.node { Node }
import v4.std.runtime { RuntimeValue }
import v4.std.verdict {
  Verdict,
  verdict_is_deferred,
  verdict_is_fail,
  verdict_is_pass
}
import v4.std.verification {
  CompilesClaim,
  DiagnosticClaim,
  EqualsClaim,
  RoundTripClaim,
  TestClaim
}
import v4.test.claim.manual.manual_corpus_roster {
  ManualCorpusRow,
  manual_corpus_node_runtime_value_rows
}


// One row of the corpus report — closed authority: holds the TestClaim
// (single authority for label/anchor/classification) and the faithful
// Verdict<RuntimeValue> the underlying run produced. No verdict erasure to
// Symbol tags; Fail and Deferred payloads (Outcome<RuntimeValue>,
// Diagnostic) survive to the host boundary.
type CorpusEvalEntry {
  claim: TestClaim
  verdict: Verdict<RuntimeValue>
}


// The corpus report is its entries — counts are derived projections, not
// independent fields, so an inconsistent (entries, counts) pair cannot be
// constructed (M4 illegal-states-unrepresentable / P2 single authority).
type CorpusEvalReport {
  entries: List<CorpusEvalEntry>
}


fn test_claim_label_of(c: TestClaim) -> String {
  match c {
    CompilesClaim { label: l, anchor: _, input: _, expected_value: _, classification: _ } => l
    DiagnosticClaim { label: l, anchor: _, input: _, expected_rejection: _, classification: _ } => l
    EqualsClaim { label: l, anchor: _, lhs: _, rhs: _, classification: _ } => l
    RoundTripClaim { label: l, anchor: _, input: _, classification: _ } => l
  }
}


fn corpus_entry_label(e: CorpusEvalEntry) -> String {
  test_claim_label_of(c: e.claim)
}


// Per-entry verdict predicates delegate to the canonical Verdict<T>
// predicates in v4.std.verdict — no per-variant match in workflow code
// (docs/modeling-discipline.md predicate-dissolution: the closed Verdict
// coproduct stays single authority for Pass / Fail / Deferred classification).
fn corpus_entry_is_pass(e: CorpusEvalEntry) -> Bool {
  verdict_is_pass(v: e.verdict)
}


fn corpus_entry_is_fail(e: CorpusEvalEntry) -> Bool {
  verdict_is_fail(v: e.verdict)
}


fn corpus_entry_is_deferred(e: CorpusEvalEntry) -> Bool {
  verdict_is_deferred(v: e.verdict)
}


fn corpus_report_pass_count(r: CorpusEvalReport) -> Int {
  count_where(xs: r.entries, predicate: corpus_entry_is_pass)
}


fn corpus_report_fail_count(r: CorpusEvalReport) -> Int {
  count_where(xs: r.entries, predicate: corpus_entry_is_fail)
}


fn corpus_report_deferred_count(r: CorpusEvalReport) -> Int {
  count_where(xs: r.entries, predicate: corpus_entry_is_deferred)
}


fn corpus_report_total(r: CorpusEvalReport) -> Int {
  length(xs: r.entries)
}


fn corpus_entry_from_node_runtime_value_row(
  row: ManualCorpusRow<RuntimeValue>
) -> CorpusEvalEntry {
  CorpusEvalEntry {
    claim: row.claim,
    verdict: row.run.verdict
  }
}


fn corpus_entries_from_node_runtime_value_rows(
  rows: List<ManualCorpusRow<RuntimeValue>>
) -> List<CorpusEvalEntry> {
  fold(rows, init: [], f: fn(acc, row) {
    concat([corpus_entry_from_node_runtime_value_row(row: row)], acc)
  })
}


// Modeled corpus-eval entry point. Host harness invokes the emitted Rust
// mirror of this symbol, then serializes the returned CorpusEvalReport
// (entries list) — counts are reconstructed host-side via the same
// corpus_report_*_count projections (or emitted accessor fns) so the
// authority stays in the model.
fn run_manual_testclaim_corpus_eval() -> CorpusEvalReport {
  CorpusEvalReport {
    entries: corpus_entries_from_node_runtime_value_rows(
      rows: manual_corpus_node_runtime_value_rows
    )
  }
}
