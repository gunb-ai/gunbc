// src/v4/test/claim/workflow/runner_pool_m1_probe.dag
// Scope: T-24 self-hosted runner pool (srv1/srv2 spec).

module v4.test.claim.workflow.runner_pool_m1_probe

import v4.std.logic { Bool }
import v4.workflow.ci {
  ci_runner_arch_arm64,
  ci_runner_pool_fleet_capacities_valid,
  ci_srv1_pool,
  ci_srv2_pool
}

fn runner_pool_fleet_arch_holds() -> Bool {
  ci_srv1_pool.arch == ci_runner_arch_arm64 && ci_srv2_pool.arch == ci_runner_arch_arm64
}

fn runner_pool_fleet_capacities_valid_holds() -> Bool {
  ci_runner_pool_fleet_capacities_valid()
}

fn runner_pool_srv1_runner_count_holds() -> Bool {
  ci_srv1_pool.runner_count == 20
}

fn runner_pool_srv2_jobserver_cap_holds() -> Bool {
  ci_srv2_pool.jobserver_token_cap == 36
}

data runner_pool_arch_claim_passes: Bool = runner_pool_fleet_arch_holds()
data runner_pool_capacities_claim_passes: Bool = runner_pool_fleet_capacities_valid_holds()
data runner_pool_srv1_claim_passes: Bool = runner_pool_srv1_runner_count_holds()
data runner_pool_srv2_claim_passes: Bool = runner_pool_srv2_jobserver_cap_holds()
