// Modeled roster projection (label\tentry\tfunction TSV) consumed by the
// `ci-claim-gate` host — the gate model owns the row list; the host no longer
// awk/grep-scrapes this file. `row.entry` resolves `ci_runner_gate_entry` natively
// (the bash scraper had to special-case that constant). Mirror of
// `probe_selector_ci_runner_rows_tsv`.
fn affected_set_node_frontier_rows_tsv() -> String {
  fold_list_right(
    xs: ci_runner_node_frontier_claim_run_rows,
    empty: "",
    snoc: fn(acc, row) {
      concat(acc,
        concat(row.label,
          concat("\t",
            concat(row.entry,
              concat("\t",
                concat(row.function, "\n"))))))
    }
  )
}
