// src/v4/test/claim/workflow/batch_runner.dag
// Scope: near-term CI dogfood — the v4.workflow.executor .dag is the batching
// AUTHORITY for running the v4 claim suite in parallel batches. The host
// transport (src/v2/stage0/src/bin/claim_executor.rs) consumes the batches this
// module projects; it does NOT re-derive grouping/ordering. Adding a dependency
// here (or a node) re-batches the suite with zero host change.
//
// Each suite node maps to one real (entry, function) claim witness. The executor
// orders them by dependency frontier: `bre_core_node` gates the two derived
// claims, so batch 1 = [core] runs before batch 2 = [a, b].

module v4.test.claim.workflow.batch_runner

import v4.std.algebra { fold_list_right, length, list_snoc_item }
import v4.std.collection { List }
import v4.std.dependency { DataDependsOn, DependencyView }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.text { String }
import v4.workflow.executor {
  ExecutorBatch,
  ExecutorRunBlocked,
  ExecutorRunComplete,
  ExecutorRunRunnable,
  parallel_executor_plan_from_dependencies
}

// Host-readable leaf: a single claim witness the host transport runs.
type ClaimRef {
  entry: String
  function: String
}

data bre_suite_entry: String = "src/v4/test/claim/workflow/affected_set_ci_runner.dag"

data bre_core_symbol: Symbol = bre_core_symbol
data bre_a_symbol: Symbol = bre_a_symbol
data bre_b_symbol: Symbol = bre_b_symbol

data bre_core_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: bre_core_symbol } },
  children: []
}

data bre_a_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: bre_a_symbol } },
  children: []
}

data bre_b_node: Node = Node {
  kind: TypeNode { connective: Atom { identity: bre_b_symbol } },
  children: []
}

// The two derived claims data-depend on the core claim, so the executor places
// them in a later readiness layer (a second batch).
data bre_core_to_a_dependency: DependencyView = DependencyView {
  source: bre_core_node,
  dependent: bre_a_node,
  kind: DataDependsOn,
  usage_site: bre_a_node
}

data bre_core_to_b_dependency: DependencyView = DependencyView {
  source: bre_core_node,
  dependent: bre_b_node,
  kind: DataDependsOn,
  usage_site: bre_b_node
}

data bre_suite_nodes: List<Node> = [
  bre_core_node,
  bre_a_node,
  bre_b_node
]

data bre_suite_dependencies: List<DependencyView> = [
  bre_core_to_a_dependency,
  bre_core_to_b_dependency
]

// node -> real (entry, function) witness. This is the only place the suite's
// A ClaimRef with an empty `entry` is the unrunnable sentinel: it carries no
// resolvable witness, so the host transport (claim_executor) rejects it and
// fails closed. Used for any suite node without a binding and for non-complete
// plan states — making "missing mapping" and "not complete" loud, never silent.
data bre_unmapped_function: String = "__batch_runner_unmapped_or_incomplete__"

fn bre_unrunnable_sentinel() -> ClaimRef {
  ClaimRef { entry: "", function: bre_unmapped_function }
}

// Closed node->witness binding. The mapping is TOTAL over the suite's three
// nodes; any other node is structurally unmapped and projects to the unrunnable
// sentinel (host fails closed) rather than silently aliasing to a real claim.
fn bre_claim_ref_for_node(node: Node) -> ClaimRef {
  if node == bre_core_node {
    ClaimRef { entry: bre_suite_entry, function: "ci_runner_narrow_selection_holds" }
  } else {
    if node == bre_a_node {
      ClaimRef { entry: bre_suite_entry, function: "ci_runner_fail_closed_superset_holds" }
    } else {
      if node == bre_b_node {
        ClaimRef { entry: bre_suite_entry, function: "ci_runner_shape_collision_holds" }
      } else {
        bre_unrunnable_sentinel()
      }
    }
  }
}

fn bre_refs_for_batch(batch: ExecutorBatch) -> List<ClaimRef> {
  fold(batch.jobs, init: [], f: fn(acc, job) {
    list_snoc_item(xs: acc, item: bre_claim_ref_for_node(node: job.node))
  })
}

// Top-level host entry: the executor-decided batches projected to runnable
// (entry, function) refs. Outer list = batches in execution order; inner list =
// claims runnable in parallel within that batch.
fn bre_claim_batches() -> List<List<ClaimRef>> {
  match parallel_executor_plan_from_dependencies(
    nodes: bre_suite_nodes,
    dependencies: bre_suite_dependencies,
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } =>
      fold(batches, init: [], f: fn(acc, batch) {
        list_snoc_item(xs: acc, item: bre_refs_for_batch(batch: batch))
      })
    // A non-complete plan is NOT an empty (vacuously-passing) run. Project a
    // single unrunnable-sentinel batch so the host fails closed instead of
    // exiting 0 on zero claims. The suite is statically satisfiable, so these
    // arms are unreachable today — but they must never silently mean success.
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => [[bre_unrunnable_sentinel()]]
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => [[bre_unrunnable_sentinel()]]
  }
}

// ── batching-AUTHORITY witnesses (MODEL semantics; host: ci-claim-gate, uniform perturb) ──
// The `.dag` IS the batching authority: `parallel_executor_plan_from_dependencies` (in
// `v4.workflow.executor`) decides grouping/ordering, and claim_executor merely runs the plan
// it returns (no Rust mirror — claim_executor.rs only parses List<List<ClaimRef>>). So "the
// dependency input drives the batch count" is a MODEL property, provable as a pure `.dag`
// witness with no host re-resolve: empty deps collapse the suite to one batch, the suite's
// real deps yield two, an empty suite yields none. These replace the former inline-python
// "empty the dep list and re-run the host" perturb in scripts/v4-batch-executor-gate.sh —
// absorbing a model property into Rust would undermodel the dogfood. ci-claim-gate's uniform
// witness-body->`false` perturb keeps each one red-under-mutation (a hardcoded `true` fails).
fn bre_empty_deps_yields_one_batch() -> Bool {
  match parallel_executor_plan_from_dependencies(
    nodes: bre_suite_nodes,
    dependencies: [],
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } => length(xs: batches) == 1
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

fn bre_full_deps_yields_two_batches() -> Bool {
  match parallel_executor_plan_from_dependencies(
    nodes: bre_suite_nodes,
    dependencies: bre_suite_dependencies,
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } => length(xs: batches) == 2
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

// Degenerate (model side of the fail-closed pair): an empty suite projects zero batches.
// The HOST side is already covered both ends — claim_executor exits 1 on a 0-batch plan
// (claim_executor.rs) and ci-claim-gate exits 2 on an empty row set — so a degenerate plan
// can never become a vacuous exit-0. This witness pins the model half: empty in, zero out.
fn bre_empty_suite_yields_no_batches() -> Bool {
  match parallel_executor_plan_from_dependencies(
    nodes: [],
    dependencies: [],
    scheduled: []
  ) {
    ExecutorRunComplete { batches: batches, scheduled: _ } => length(xs: batches) == 0
    ExecutorRunRunnable { batch: _, scheduled: _, remaining: _ } => false
    ExecutorRunBlocked { evidence: _, batches: _, scheduled: _, remaining: _ } => false
  }
}

// ── ci-claim-gate roster transport for the authority witnesses ──
// One TSV line per row, `label\tentry\tfunction`, consumed by `ci-claim-gate` exactly as the
// probe-selector keystone gate does. Authority lives here in the `.dag`, not in shell.
type BatchExecutorAuthorityRow {
  label: String
  entry: String
  function: String
}

data bre_authority_gate_entry: String = "src/v4/test/claim/workflow/batch_runner.dag"

data bre_authority_row_empty_deps: BatchExecutorAuthorityRow = BatchExecutorAuthorityRow {
  label: "batch-executor authority: empty deps -> one batch",
  entry: bre_authority_gate_entry,
  function: "bre_empty_deps_yields_one_batch"
}

data bre_authority_row_full_deps: BatchExecutorAuthorityRow = BatchExecutorAuthorityRow {
  label: "batch-executor authority: full deps -> two batches",
  entry: bre_authority_gate_entry,
  function: "bre_full_deps_yields_two_batches"
}

data bre_authority_row_empty_suite: BatchExecutorAuthorityRow = BatchExecutorAuthorityRow {
  label: "batch-executor degenerate: empty suite -> zero batches",
  entry: bre_authority_gate_entry,
  function: "bre_empty_suite_yields_no_batches"
}

data bre_authority_rows: List<BatchExecutorAuthorityRow> = [
  bre_authority_row_empty_deps,
  bre_authority_row_full_deps,
  bre_authority_row_empty_suite
]

data bre_authority_row_count: String = "3"

fn bre_authority_rows_tsv() -> String {
  fold_list_right(
    xs: bre_authority_rows,
    empty: "",
    snoc: fn(acc, row) {
      concat(acc,
        concat(row.label,
          concat("\t",
            concat(row.entry,
              concat("\t",
                concat(row.function, "\n"))))))
    }
  )
}
