// src/v4/test/claim/workflow/nat_semiring_rung34_eval.dag
// Scope: W2 rung 3–4 corpus eval + rung-split gates (§4.4) for phase1/nat_semiring.
// Status: roster wedge empty until W3 lands rung_3_4 claims; compiler/emit_host stub until W3 wiring.

module v4.test.claim.workflow.nat_semiring_rung34_eval


import v4.compiler.eval { TestClaimRun }
import v4.std.algebra { is_empty }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.nat { Nat, Zero }
import v4.std.node { Node }
import v4.std.runtime { RuntimeValue }
import v4.test.claim.workflow.testclaim_corpus_runner {
  CorpusEvalReport,
  corpus_entries_from_node_runtime_value_runs,
  corpus_report_tally
}


// W3 populates via imports from src/v4/test/claim/nat_semiring/rung_3_4_*.dag.
data nat_semiring_rung34_runtime_value_rows: List<TestClaimRun<Node, RuntimeValue>> = []


fn run_nat_semiring_rung34_eval() -> CorpusEvalReport {
  CorpusEvalReport {
    entries: corpus_entries_from_node_runtime_value_runs(
      runs: nat_semiring_rung34_runtime_value_rows
    )
  }
}


// W2: empty roster must not read as closed (fail-closed until W3 populates rows).
fn nat_semiring_rung34_report_has_evidence(report: CorpusEvalReport) -> Bool {
  match is_empty(xs: report.entries) {
    true => false
    false => true
  }
}

// W3 backlog (§4.4): bodies are intentionally identical while the roster is empty.
// Once nat_semiring_rung34_runtime_value_rows is populated, each gate must discriminate
// disjoint claim subsets — filter by claim-kind here (RoundTrip vs emit-vs-eval) or accept
// pre-filtered CorpusEvalReport slices from W3.
fn nat_semiring_rung3_gate(report: CorpusEvalReport) -> Bool {
  if nat_semiring_rung34_report_has_evidence(report: report) {
    let tally = corpus_report_tally(r: report)
    tally.fail == Zero && tally.deferred == Zero
  } else {
    false
  }
}

fn nat_semiring_rung4_gate(report: CorpusEvalReport) -> Bool {
  if nat_semiring_rung34_report_has_evidence(report: report) {
    let tally = corpus_report_tally(r: report)
    tally.fail == Zero && tally.deferred == Zero
  } else {
    false
  }
}

fn nat_semiring_rungs_34_closed(report: CorpusEvalReport) -> Bool {
  nat_semiring_rung3_gate(report: report) && nat_semiring_rung4_gate(report: report)
}
