// src/v4/test/claim/lens_parallelism/data_dependency.dag
// Scope: T-13 worked claim — DataDependsOn blocks structural independence.
// Owns: parallelism_data_dependency_claim.
// Consumes: lens parallelism, compiler infer, std dependency, std node.
// Status: scaffold — compile-only until generated claim execution.

module v4.test.claim.lens_parallelism.data_dependency

import v4.compiler.infer { AlgebraRef, InferredFacts, InferredTree }
import v4.lens.parallelism { ParallelismFact, parallelism_fact_from_dependencies, parallelism_witness }
import v4.std.cardinality { RankingDimension, TerminationProof }
import v4.std.collection { Map }
import v4.std.dependency { DataDependsOn, DependencyView }
import v4.std.node { Atom, Edge, Hash, Named, Node, Symbol, TypeNode }
import v4.std.witness { Holds, Witness }

data parallelism_root_symbol: Symbol = parallelism_root_symbol
data parallelism_child_symbol: Symbol = parallelism_child_symbol
data parallelism_edge_symbol: Symbol = parallelism_edge_symbol
data parallelism_type_symbol: Symbol = parallelism_type_symbol
data parallelism_algebra_symbol: Symbol = parallelism_algebra_symbol
data parallelism_algebra_witness_symbol: Symbol = parallelism_algebra_witness_symbol
data parallelism_descent_symbol: Symbol = parallelism_descent_symbol
data parallelism_claim_hash: Hash = parallelism_claim_hash

fn parallelism_claim_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}

data parallelism_child: Node = parallelism_claim_node(s: parallelism_child_symbol)

data parallelism_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: parallelism_root_symbol } },
  children: [
    Edge { label: Named { name: parallelism_edge_symbol }, target: parallelism_child }
  ]
}

data parallelism_dependency: DependencyView = DependencyView {
  source: parallelism_root,
  dependent: parallelism_child,
  kind: DataDependsOn,
  usage_site: parallelism_child
}

fn parallelism_claim_facts() -> InferredFacts {
  InferredFacts {
    resolved_type: parallelism_claim_node(s: parallelism_type_symbol),
    inhabits: AlgebraRef {
      algebra: parallelism_claim_node(s: parallelism_algebra_symbol),
      witness: parallelism_claim_node(s: parallelism_algebra_witness_symbol)
    },
    descent: TerminationProof {
      non_increasing: [],
      strict: RankingDimension { measured: parallelism_descent_symbol }
    }
  }
}

fn parallelism_claim_fact_map(facts: InferredFacts) -> Map<Node, InferredFacts> {
  Map {
    lookup: fn(_) {
      Holds { value: facts }
    }
  }
}

fn parallelism_claim_tree() -> InferredTree {
  let facts = parallelism_claim_facts()
  InferredTree {
    root: parallelism_root,
    facts: parallelism_claim_fact_map(facts: facts)
  }
}

type LensParallelismClaim {
  input: InferredTree
  expected: ParallelismFact
  actual: Witness<ParallelismFact>
}

data parallelism_data_dependency_claim: LensParallelismClaim = LensParallelismClaim {
  input: parallelism_claim_tree(),
  expected: parallelism_fact_from_dependencies(dependencies: [parallelism_dependency]),
  actual: parallelism_witness(tree: parallelism_claim_tree())
}
