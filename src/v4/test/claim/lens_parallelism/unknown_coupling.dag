// src/v4/test/claim/lens_parallelism/unknown_coupling.dag
// Scope: T-13 worked claim — TypeDependsOn classifies as UnknownCoupling over `ClassifiedDependencyView<ParallelismRelation>` (structural/module/placement/model/projection/generated/verified/promoted/bootstrap edges all fall into UnknownCoupling — the fail-closed variant for non-behavioral dependency kinds).
// Owns: parallelism_unknown_coupling_claim.
// Consumes: lens parallelism, std dependency, lens_common fixture.
// Status: T-13 family-ratchet claim shape (Phase-1 substrate migration).


module v4.test.claim.lens_parallelism.unknown_coupling

import v4.compiler.infer { InferredFacts, InferredTree }
import v4.lens.parallelism {
  ParallelismFact,
  UnknownCoupling,
  parallelism_fact_eq,
  parallelism_witness
}
import v4.std.dependency {
  ClassifiedDependencyView,
  DependencyView,
  TypeDependsOn
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Edge, Named, Node, Symbol, TypeNode }
import v4.std.witness { Holds, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data parallelism_uc_root_symbol: Symbol = parallelism_uc_root_symbol
data parallelism_uc_child_symbol: Symbol = parallelism_uc_child_symbol
data parallelism_uc_edge_symbol: Symbol = parallelism_uc_edge_symbol
data parallelism_uc_type_symbol: Symbol = parallelism_uc_type_symbol
data parallelism_uc_algebra_symbol: Symbol = parallelism_uc_algebra_symbol
data parallelism_uc_algebra_witness_symbol: Symbol = parallelism_uc_algebra_witness_symbol
data parallelism_uc_descent_symbol: Symbol = parallelism_uc_descent_symbol
data parallelism_uc_canonical_structural_symbol: Symbol = parallelism_uc_canonical_structural_symbol
data parallelism_uc_canonical_closedness_symbol: Symbol = parallelism_uc_canonical_closedness_symbol
data parallelism_uc_canonical_evidence_symbol: Symbol = parallelism_uc_canonical_evidence_symbol

data parallelism_uc_child: Node = claim_atom_node(s: parallelism_uc_child_symbol)

data parallelism_uc_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: parallelism_uc_root_symbol } },
  children: [
    Edge { label: Named { name: parallelism_uc_edge_symbol }, target: parallelism_uc_child }
  ]
}

data parallelism_uc_dependency: DependencyView = DependencyView {
  source: parallelism_uc_root,
  dependent: parallelism_uc_child,
  kind: TypeDependsOn,
  usage_site: parallelism_uc_child
}

fn parallelism_uc_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: parallelism_uc_type_symbol,
    algebra_symbol: parallelism_uc_algebra_symbol,
    algebra_witness_symbol: parallelism_uc_algebra_witness_symbol,
    descent_symbol: parallelism_uc_descent_symbol,
    canonical_structural_symbol: parallelism_uc_canonical_structural_symbol,
    canonical_closedness_symbol: parallelism_uc_canonical_closedness_symbol,
    canonical_evidence_symbol: parallelism_uc_canonical_evidence_symbol
  )
}

fn parallelism_uc_claim_tree() -> InferredTree {
  claim_inferred_tree(root: parallelism_uc_root, facts: parallelism_uc_claim_facts())
}

type LensParallelismUnknownCouplingClaim {
  input: InferredTree
  expected: ParallelismFact
  actual: Witness<ParallelismFact>
}

data parallelism_unknown_coupling_claim: LensParallelismUnknownCouplingClaim = LensParallelismUnknownCouplingClaim {
  input: parallelism_uc_claim_tree(),
  expected: ParallelismFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: parallelism_uc_dependency,
        classification: UnknownCoupling
      }
    ]
  },
  actual: parallelism_witness(tree: parallelism_uc_claim_tree(), dependencies: [parallelism_uc_dependency])
}

fn parallelism_unknown_coupling_claim_holds() -> Bool {
  match parallelism_unknown_coupling_claim.actual {
    Holds { value: actual } =>
      parallelism_fact_eq(a: actual, b: parallelism_unknown_coupling_claim.expected)
    _ => false
  }
}

data parallelism_unknown_coupling_claim_passes: Bool = parallelism_unknown_coupling_claim_holds()
