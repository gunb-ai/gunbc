// src/v4/test/claim/std_text/carrier_claims.dag
// Scope: Exemplar E1 — v4.std.text host-string/text-carrier facts as discriminating
// claim-run witnesses, routed through v2 (`dag run --claim-run`).
//
// These witnesses migrate the behavioral content of
// src/v3/compiler/tests/integration/v4_std_text_dag_smoke_test.rs from a frozen-v3
// parse-surface grep into executable `fn -> Bool` witnesses that EXECUTE the
// text.dag carriers (String = FreeMonoid<Char>, the HostStringText constructor and
// projection) and DISCRIMINATE on the stored value — a wrong projection or wrong
// carrier shape turns a witness red, so the green is not vacuous (no compile-only
// false green; cf. witness-sweep discipline).
//
// Status: Wave-A fold-delete (W1). These witnesses are the .dag coverage that
// satisfies the smoke test's own P5/T-PB-B dissolution gate, so the same PR retires
// the frozen v4_std_text_dag_smoke_test.rs and its SG-0 EXPECTED_HAND_AUTHORED_TEST
// row. Importing v4.std.text forces v2 to tokenize/parse/infer text.dag, so the
// parse-surface "tokenizes_and_parses" fact rides every witness below.

module v4.test.claim.std_text.carrier_claims


import v4.std.algebra { Cons, Empty, Equal, FreeMonoid, Ordering }
import v4.std.logic { Bool }
import v4.std.nat { Nat, Succ, Zero, nat_compare }
import v4.std.text {
  Char,
  CharAbsent,
  CharFound,
  HostStringText,
  String,
  host_string_text,
  host_string_text_value,
  string_head,
  string_is_empty
}



import v4.std.verification {
  BoolWitness,
  BoolWitnessClaim,
  UnifiedTestClaim
}
// Two distinct Char (= Nat) witnesses; small Peano values so the carriers stay shallow.
data text_witness_char_a: Char = Succ { prev: Zero }
data text_witness_char_b: Char = Succ { prev: Succ { prev: Zero } }


fn text_not(b: Bool) -> Bool {
  b == false
}


// Char equality via the substrate total-order compare (no reliance on `==` over Nat).
fn text_char_eq(a: Char, b: Char) -> Bool {
  match nat_compare(a: a, b: b) {
    Equal => true
    _ => false
  }
}


// Build a single-char String directly through the FreeMonoid<Char> carrier.
fn text_single(c: Char) -> String {
  Cons { head: c, tail: Empty }
}


// Fact 1 (String remains the Unicode FreeMonoid<Char> carrier): the empty carrier is
// empty, a single-char carrier is non-empty, and its head projects back to the stored
// char. Discriminates: a non-FreeMonoid carrier or a broken head would not behave.
test fn text_string_freemonoid_carrier_holds() -> Bool {
  string_is_empty(s: Empty)
    && text_not(b: string_is_empty(s: text_single(c: text_witness_char_a)))
    && match string_head(s: text_single(c: text_witness_char_a)) {
      CharFound { value } => text_char_eq(a: value, b: text_witness_char_a)
      CharAbsent => false
    }
}


// Fact 2 (HostStringText constructor + projection consumers preserve text): round-trip a
// single-char carrier through host_string_text → host_string_text_value; the projected
// head must equal char_a AND must NOT equal char_b. The negative arm makes the witness
// discriminate stored-value identity, not just presence.
test fn text_host_string_roundtrip_holds() -> Bool {
  match string_head(
    s: host_string_text_value(
      value: host_string_text(text: text_single(c: text_witness_char_a))
    )
  ) {
    CharFound { value } =>
      text_char_eq(a: value, b: text_witness_char_a)
        && text_not(b: text_char_eq(a: value, b: text_witness_char_b))
    CharAbsent => false
  }
}


// Fact 2b (projection returns the actually-stored text, not a constant): round-trip the
// EMPTY carrier; it must come back empty. Pairs with the positive round-trip to pin the
// projection to its argument.
test fn text_host_string_empty_roundtrip_holds() -> Bool {
  string_is_empty(s: host_string_text_value(value: host_string_text(text: Empty)))
}


// Fact 3 (HostStringText record field is `text: String`): construct the record literal
// directly via the `text` field and project it back. A different field name would not
// compile/run; the projected head discriminates the stored char.
test fn text_host_string_field_text_holds() -> Bool {
  match string_head(
    s: host_string_text_value(value: HostStringText { text: text_single(c: text_witness_char_b) })
  ) {
    CharFound { value } => text_char_eq(a: value, b: text_witness_char_b)
    CharAbsent => false
  }
}

