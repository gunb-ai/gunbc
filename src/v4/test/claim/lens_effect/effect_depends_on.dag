// src/v4/test/claim/lens_effect/effect_depends_on.dag
// Scope: T-13 worked claim — every dependency kind classifies as the signature-deferred marker `EffectClassification` (B3 — dependency kind is not the effect authority; the per-edge slot routes to the signature via `tree.facts.lookup`).
// Owns: effect_depends_on_claim.
// Consumes: lens effect, std dependency, lens_common fixture.
// Status: T-13 family-ratchet claim shape (Phase-1 substrate migration).


module v4.test.claim.lens_effect.effect_depends_on

import v4.compiler.infer { InferredFacts, InferredTree }
import v4.lens.effect {
  EffectClassification,
  EffectFact,
  effect_fact_eq,
  effect_witness
}
import v4.std.dependency {
  ClassifiedDependencyView,
  DependencyView,
  EffectDependsOn
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Edge, Named, Node, Symbol, TypeNode }
import v4.std.witness { Holds, Witness }
import v4.test.claim.lens_common.infer_fixture {
  claim_atom_node,
  claim_inferred_facts,
  claim_inferred_tree
}

data effect_root_symbol: Symbol = effect_root_symbol
data effect_child_symbol: Symbol = effect_child_symbol
data effect_edge_symbol: Symbol = effect_edge_symbol
data effect_type_symbol: Symbol = effect_type_symbol
data effect_algebra_symbol: Symbol = effect_algebra_symbol
data effect_descent_symbol: Symbol = effect_descent_symbol
data effect_canonical_structural_symbol: Symbol = effect_canonical_structural_symbol
data effect_canonical_closedness_symbol: Symbol = effect_canonical_closedness_symbol

data effect_child: Node = claim_atom_node(s: effect_child_symbol)

data effect_root: Node = Node {
  kind: TypeNode { connective: Atom { identity: effect_root_symbol } },
  children: [
    Edge { label: Named { name: effect_edge_symbol }, target: effect_child }
  ]
}

data effect_dependency: DependencyView = DependencyView {
  source: effect_root,
  dependent: effect_child,
  kind: EffectDependsOn,
  usage_site: effect_child
}

fn effect_claim_facts() -> InferredFacts {
  claim_inferred_facts(
    type_symbol: effect_type_symbol,
    algebra_symbol: effect_algebra_symbol,
    descent_symbol: effect_descent_symbol,
    canonical_structural_symbol: effect_canonical_structural_symbol,
    canonical_closedness_symbol: effect_canonical_closedness_symbol
  )
}

fn effect_claim_tree() -> InferredTree {
  claim_inferred_tree(root: effect_root, facts: effect_claim_facts())
}

type LensEffectClaim {
  input: InferredTree
  expected: EffectFact
  actual: Witness<EffectFact>
}

data effect_depends_on_claim: LensEffectClaim = LensEffectClaim {
  input: effect_claim_tree(),
  expected: EffectFact {
    dependencies: [
      ClassifiedDependencyView {
        dependency: effect_dependency,
        classification: EffectClassification {}
      }
    ]
  },
  actual: effect_witness(tree: effect_claim_tree(), dependencies: [effect_dependency])
}

fn effect_depends_on_claim_holds() -> Bool {
  match effect_depends_on_claim.actual {
    Holds { value: actual } =>
      effect_fact_eq(a: actual, b: effect_depends_on_claim.expected)
    _ => false
  }
}

data effect_depends_on_claim_passes: Bool = effect_depends_on_claim_holds()
