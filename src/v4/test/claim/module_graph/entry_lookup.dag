// src/v4/test/claim/module_graph/entry_lookup.dag
// Scope: TestClaim corpus for module_graph_root_for_name lookup semantics.
// Owns: claim rows for root lookup success and missing-name rejection.
// Consumes: v4.std.module_graph v4.std.collection v4.std.node v4.std.qualified_name v4.std.witness v4.std.verification.
// Status: T-28 behavior receipts; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.module_graph.entry_lookup


import v4.std.algebra { Cons, Empty }
import v4.std.module_graph {
  ModuleGraph,
  QualifiedRoot,
  module_graph_from_roots,
  module_graph_root_for_name
}
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.qualified_name { QualifiedName }
import v4.std.witness { Holds, Violates, Witness }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data entry_seg_x: Symbol = entry_seg_x
data entry_seg_y: Symbol = entry_seg_y
data entry_root_sym: Symbol = entry_root_sym
data entry_pass_sym: Symbol = entry_pass_sym
data entry_fail_sym: Symbol = entry_fail_sym


fn entry_root_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: entry_root_sym } }, children: [] }
}
fn entry_pass_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: entry_pass_sym } }, children: [] }
}
fn entry_fail_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: entry_fail_sym } }, children: [] }
}
fn entry_claim_input(ok: Bool) -> Node {
  if ok { entry_pass_node() } else { entry_fail_node() }
}


fn path_x() -> QualifiedName {
  Cons { head: entry_seg_x, tail: Empty }
}
fn path_y() -> QualifiedName {
  Cons { head: entry_seg_y, tail: Empty }
}
fn graph_unique_x() -> Witness<ModuleGraph> {
  module_graph_from_roots(
    roots: Cons {
      head: QualifiedRoot { name: path_x(), root: entry_root_node() },
      tail: Empty
    }
  )
}


fn root_holds(w: Witness<Node>) -> Bool {
  match w {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}
fn root_violates(w: Witness<Node>) -> Bool {
  match w {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}


data witness_root_lookup_holds: Bool = match graph_unique_x() {
  Holds { value: graph } =>
    root_holds(w: module_graph_root_for_name(graph: graph, name: path_x()))
  Violates { diagnostic: _ } => false
}


data witness_root_lookup_missing_violates: Bool = match graph_unique_x() {
  Holds { value: graph } =>
    root_violates(w: module_graph_root_for_name(graph: graph, name: path_y()))
  Violates { diagnostic: _ } => false
}


data claim_root_lookup_holds: TestClaim = CompilesClaim {
  label: "module_graph/root_for_name: present root lookup returns Holds",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: entry_claim_input(ok: witness_root_lookup_holds),
  expected_value: entry_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_root_lookup_missing_violates: TestClaim = CompilesClaim {
  label: "module_graph/root_for_name: missing name returns Violates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: entry_claim_input(ok: witness_root_lookup_missing_violates),
  expected_value: entry_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
