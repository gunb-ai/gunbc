// src/v4/test/claim/module_graph/entry_lookup.dag
// Scope: TestClaim corpus for catalog_entry_for_name lookup semantics.
// Owns: claim rows for unique-entry success, missing-path rejection, duplicate-path rejection.
// Consumes: v4.std.module_graph v4.std.algebra v4.std.node v4.std.qualified_name v4.std.witness v4.std.verification.
// Status: T-28 behavior receipts; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.module_graph.entry_lookup


import v4.std.algebra { Cons, Empty, FreeMonoid }
import v4.std.module_graph {
  Catalog,
  Entry,
  catalog_entry_for_name
}
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.qualified_name { QualifiedName }
import v4.std.witness { Holds, Violates, Witness }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data entry_seg_x: Symbol = entry_seg_x
data entry_seg_y: Symbol = entry_seg_y
data entry_root_sym: Symbol = entry_root_sym
data entry_pass_sym: Symbol = entry_pass_sym
data entry_fail_sym: Symbol = entry_fail_sym


fn entry_root_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: entry_root_sym } }, children: [] }
}
fn entry_pass_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: entry_pass_sym } }, children: [] }
}
fn entry_fail_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: entry_fail_sym } }, children: [] }
}
fn entry_claim_input(ok: Bool) -> Node {
  if ok { entry_pass_node() } else { entry_fail_node() }
}


fn name_x() -> QualifiedName {
  Cons { head: entry_seg_x, tail: Empty }
}
fn name_y() -> QualifiedName {
  Cons { head: entry_seg_y, tail: Empty }
}
fn entry_x() -> Entry { Entry { name: name_x(), root: entry_root_node() } }


fn catalog_unique_x() -> Catalog {
  Catalog { entries: Cons { head: entry_x(), tail: Empty } }
}
fn catalog_duplicate_x() -> Catalog {
  Catalog { entries: Cons { head: entry_x(), tail: Cons { head: entry_x(), tail: Empty } } }
}


fn entry_holds(w: Witness<Entry>) -> Bool {
  match w {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}
fn entry_violates(w: Witness<Entry>) -> Bool {
  match w {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}


data witness_entry_lookup_unique_holds: Bool = entry_holds(w: catalog_entry_for_name(catalog: catalog_unique_x(), name: name_x()))


data witness_entry_lookup_missing_violates: Bool = entry_violates(w: catalog_entry_for_name(catalog: catalog_unique_x(), name: name_y()))


data witness_entry_lookup_duplicate_violates: Bool = entry_violates(w: catalog_entry_for_name(catalog: catalog_duplicate_x(), name: name_x()))


data claim_entry_lookup_unique_holds: TestClaim = CompilesClaim {
  label: "catalog/entry_for_name: unique entry lookup returns Holds",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: entry_claim_input(ok: witness_entry_lookup_unique_holds),
  expected_value: entry_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_entry_lookup_missing_violates: TestClaim = CompilesClaim {
  label: "catalog/entry_for_name: missing name returns Violates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: entry_claim_input(ok: witness_entry_lookup_missing_violates),
  expected_value: entry_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_entry_lookup_duplicate_violates: TestClaim = CompilesClaim {
  label: "catalog/entry_for_name: duplicate name returns Violates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: entry_claim_input(ok: witness_entry_lookup_duplicate_violates),
  expected_value: entry_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
