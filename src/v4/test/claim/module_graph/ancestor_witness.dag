// src/v4/test/claim/module_graph/ancestor_witness.dag
// Scope: TestClaim corpus for module_ancestor_witness prefix-based ancestor relation.
// Owns: claim rows for prefix-holds, equal-path-holds, and non-prefix-violates cases.
// Consumes: v4.std.module_graph v4.std.algebra v4.std.node v4.std.witness v4.std.verification.
// Status: T-28 behavior receipts; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.module_graph.ancestor_witness


import v4.std.algebra { Cons, Empty }
import v4.std.module_graph {
  AncestorRelation,
  module_ancestor_witness
}
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.qualified_name { QualifiedName }
import v4.std.witness { Holds, Violates, Witness }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data anc_seg_x: Symbol = anc_seg_x
data anc_seg_y: Symbol = anc_seg_y
data anc_pass_sym: Symbol = anc_pass_sym
data anc_fail_sym: Symbol = anc_fail_sym


fn anc_pass_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: anc_pass_sym } }, children: [] }
}
fn anc_fail_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: anc_fail_sym } }, children: [] }
}
fn anc_claim_input(ok: Bool) -> Node {
  if ok { anc_pass_node() } else { anc_fail_node() }
}


fn anc_path_x() -> QualifiedName {
  Cons { head: anc_seg_x, tail: Empty }
}
fn anc_path_xy() -> QualifiedName {
  Cons { head: anc_seg_x, tail: Cons { head: anc_seg_y, tail: Empty } }
}
fn anc_path_y() -> QualifiedName {
  Cons { head: anc_seg_y, tail: Empty }
}


fn ancestor_holds(w: Witness<AncestorRelation>) -> Bool {
  match w {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}
fn ancestor_violates(w: Witness<AncestorRelation>) -> Bool {
  match w {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}


data witness_ancestor_prefix_holds: Bool = ancestor_holds(w: module_ancestor_witness(ancestor: anc_path_x(), descendant: anc_path_xy()))


data witness_ancestor_equal_holds: Bool = ancestor_holds(w: module_ancestor_witness(ancestor: anc_path_x(), descendant: anc_path_x()))


data witness_ancestor_non_prefix_violates: Bool = ancestor_violates(w: module_ancestor_witness(ancestor: anc_path_y(), descendant: anc_path_xy()))


data claim_ancestor_prefix_holds: TestClaim = CompilesClaim {
  label: "module_graph/ancestor_witness: prefix path returns Holds",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: anc_claim_input(ok: witness_ancestor_prefix_holds),
  expected_value: anc_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_ancestor_equal_holds: TestClaim = CompilesClaim {
  label: "module_graph/ancestor_witness: equal path is its own ancestor (Holds)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: anc_claim_input(ok: witness_ancestor_equal_holds),
  expected_value: anc_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_ancestor_non_prefix_violates: TestClaim = CompilesClaim {
  label: "module_graph/ancestor_witness: non-prefix path returns Violates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: anc_claim_input(ok: witness_ancestor_non_prefix_violates),
  expected_value: anc_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
