// src/v4/test/claim/module_graph/graph_construction.dag
// Scope: TestClaim corpus for module_graph_from_entries validated constructor.
// Owns: claim rows for unique-path construction success and duplicate-path rejection.
// Consumes: v4.std.module_graph v4.std.algebra v4.std.node v4.std.witness v4.std.verification.
// Status: T-28 behavior receipts; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.module_graph.graph_construction


import v4.std.algebra { Cons, Empty, FreeMonoid }
import v4.std.module_graph {
  ModuleEntry,
  ModuleGraph,
  ModulePath,
  ModulePathSegment,
  module_graph_from_entries
}
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.witness { Holds, Violates, Witness }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data build_seg_x: Symbol = build_seg_x
data build_seg_y: Symbol = build_seg_y
data build_root_sym: Symbol = build_root_sym
data build_pass_sym: Symbol = build_pass_sym
data build_fail_sym: Symbol = build_fail_sym


fn build_root_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: build_root_sym } }, children: [] }
}
fn build_pass_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: build_pass_sym } }, children: [] }
}
fn build_fail_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: build_fail_sym } }, children: [] }
}
fn build_claim_input(ok: Bool) -> Node {
  if ok { build_pass_node() } else { build_fail_node() }
}


fn build_path_x() -> ModulePath {
  ModulePath { segments: Cons { head: ModulePathSegment { name: build_seg_x }, tail: Empty } }
}
fn build_path_y() -> ModulePath {
  ModulePath { segments: Cons { head: ModulePathSegment { name: build_seg_y }, tail: Empty } }
}
fn build_entry_x() -> ModuleEntry { ModuleEntry { path: build_path_x(), root: build_root_node() } }
fn build_entry_y() -> ModuleEntry { ModuleEntry { path: build_path_y(), root: build_root_node() } }


fn build_entries_unique() -> FreeMonoid<ModuleEntry> {
  Cons { head: build_entry_x(), tail: Cons { head: build_entry_y(), tail: Empty } }
}
fn build_entries_duplicate() -> FreeMonoid<ModuleEntry> {
  Cons { head: build_entry_x(), tail: Cons { head: build_entry_x(), tail: Empty } }
}


fn graph_holds(w: Witness<ModuleGraph>) -> Bool {
  match w {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}
fn graph_violates(w: Witness<ModuleGraph>) -> Bool {
  match w {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}


data witness_graph_from_unique_holds: Bool =
  graph_holds(w: module_graph_from_entries(entries: build_entries_unique()))


data witness_graph_from_duplicate_violates: Bool =
  graph_violates(w: module_graph_from_entries(entries: build_entries_duplicate()))


data claim_graph_from_unique_holds: TestClaim = CompilesClaim {
  label: "module_graph/from_entries: unique-path entries return Holds",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: build_claim_input(ok: witness_graph_from_unique_holds),
  expected_value: build_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_graph_from_duplicate_violates: TestClaim = CompilesClaim {
  label: "module_graph/from_entries: duplicate-path entries return Violates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: build_claim_input(ok: witness_graph_from_duplicate_violates),
  expected_value: build_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
