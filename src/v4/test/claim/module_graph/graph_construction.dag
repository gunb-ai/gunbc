// src/v4/test/claim/module_graph/graph_construction.dag
// Scope: TestClaim corpus for module_graph_from_roots validated constructor.
// Owns: claim rows for unique-root construction success and duplicate-root rejection.
// Consumes: v4.std.module_graph v4.std.algebra v4.std.node v4.std.qualified_name v4.std.witness v4.std.verification.
// Status: T-28 behavior receipts; execution deferred to T-22 runner bridge.
// Discovery: T-22 runner enumerates src/v4/test/claim/** recursively.


module v4.test.claim.module_graph.graph_construction


import v4.std.algebra { Cons, Empty, FreeMonoid }
import v4.std.module_graph {
  ModuleGraph,
  QualifiedRoot,
  module_graph_from_roots
}
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.qualified_name { QualifiedName }
import v4.std.witness { Holds, Violates, Witness }
import v4.std.verification {
  CompilesClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}


data build_seg_x: Symbol = build_seg_x
data build_seg_y: Symbol = build_seg_y
data build_root_sym: Symbol = build_root_sym
data build_pass_sym: Symbol = build_pass_sym
data build_fail_sym: Symbol = build_fail_sym


fn build_root_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: build_root_sym } }, children: [] }
}
fn build_pass_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: build_pass_sym } }, children: [] }
}
fn build_fail_node() -> Node {
  Node { kind: TypeNode { connective: Atom { identity: build_fail_sym } }, children: [] }
}
fn build_claim_input(ok: Bool) -> Node {
  if ok { build_pass_node() } else { build_fail_node() }
}


fn build_name_x() -> QualifiedName {
  Cons { head: build_seg_x, tail: Empty }
}
fn build_name_y() -> QualifiedName {
  Cons { head: build_seg_y, tail: Empty }
}
fn build_root_x() -> QualifiedRoot {
  QualifiedRoot { name: build_name_x(), root: build_root_node() }
}
fn build_root_y() -> QualifiedRoot {
  QualifiedRoot { name: build_name_y(), root: build_root_node() }
}


fn build_roots_unique() -> FreeMonoid<QualifiedRoot> {
  Cons { head: build_root_x(), tail: Cons { head: build_root_y(), tail: Empty } }
}
fn build_roots_duplicate() -> FreeMonoid<QualifiedRoot> {
  Cons { head: build_root_x(), tail: Cons { head: build_root_x(), tail: Empty } }
}


fn graph_holds(w: Witness<ModuleGraph>) -> Bool {
  match w {
    Holds { value: _ } => true
    Violates { diagnostic: _ } => false
  }
}
fn graph_violates(w: Witness<ModuleGraph>) -> Bool {
  match w {
    Holds { value: _ } => false
    Violates { diagnostic: _ } => true
  }
}


data witness_graph_from_unique_holds: Bool = graph_holds(w: module_graph_from_roots(roots: build_roots_unique()))


data witness_graph_from_duplicate_violates: Bool = graph_violates(w: module_graph_from_roots(roots: build_roots_duplicate()))


data claim_graph_from_unique_holds: TestClaim = CompilesClaim {
  label: "module_graph/from_roots: unique roots return Holds",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: build_claim_input(ok: witness_graph_from_unique_holds),
  expected_value: build_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_graph_from_duplicate_violates: TestClaim = CompilesClaim {
  label: "module_graph/from_roots: duplicate roots return Violates",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: build_claim_input(ok: witness_graph_from_duplicate_violates),
  expected_value: build_pass_node(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
