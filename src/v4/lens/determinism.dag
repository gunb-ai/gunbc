// src/v4/lens/determinism.dag
// Scope: structural verifier for Deterministic fns — forbids NonDetSource carriers + effect leak on callees.
// Status: PR-2; consumes v4.std.determinism; orthogonal to v4.lens.effect.


module v4.lens.determinism

import v4.compiler.infer { InferredTree }
import v4.std.collection {
  List,
  Map,
  Optional,
  optional_absent,
  optional_prefer_first_present,
  optional_present
}
import v4.std.determinism {
  DeterminismClass,
  DeterminismFact,
  NonDetSource,
  determinism_registry_from_facts,
  determinism_registry_lookup
}
import v4.std.dependency {
  BindsTo,
  DependencyView,
  dependency_lens
}
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Unavailable,
  node_locus
}
import v4.std.node {
  Atom,
  Edge,
  Node,
  NodeFold,
  Symbol,
  TypeNode,
  fold_node
}
import v4.std.witness { Holds, Violates, Witness }

data determinism_forbidden_hash_iteration: Symbol = determinism_forbidden_hash_iteration
data determinism_forbidden_time_read: Symbol = determinism_forbidden_time_read
data determinism_forbidden_random_read: Symbol = determinism_forbidden_random_read
data determinism_forbidden_env_read: Symbol = determinism_forbidden_env_read
data determinism_effect_leak: Symbol = determinism_effect_leak

data forbidden_symbol_hash_map: Symbol = forbidden_symbol_hash_map
data forbidden_symbol_hash_set: Symbol = forbidden_symbol_hash_set
data deterministic_carrier_btree_map: Symbol = deterministic_carrier_btree_map
data deterministic_carrier_btree_set: Symbol = deterministic_carrier_btree_set
data forbidden_symbol_now: Symbol = forbidden_symbol_now
data forbidden_symbol_instant_now: Symbol = forbidden_symbol_instant_now
data forbidden_symbol_system_time_now: Symbol = forbidden_symbol_system_time_now
data forbidden_symbol_random: Symbol = forbidden_symbol_random
data forbidden_symbol_thread_rng: Symbol = forbidden_symbol_thread_rng
data forbidden_symbol_gen_range: Symbol = forbidden_symbol_gen_range
data forbidden_symbol_std_env: Symbol = forbidden_symbol_std_env
data forbidden_symbol_getenv: Symbol = forbidden_symbol_getenv
data forbidden_symbol_var_os: Symbol = forbidden_symbol_var_os

// 🟢 coproduct dissolution — CP-DETERMINISM-LENS-VIOLATION.
type DeterminismViolation
  = ForbiddenSource { source: NonDetSource, at: Node }
  | EffectLeak { callee: Symbol, at: Node }

type ForbiddenScanState {
  violation: Optional<DeterminismViolation>
}

fn non_det_source_for_symbol(sym: Symbol) -> Optional<NonDetSource> {
  if sym == forbidden_symbol_hash_map || sym == forbidden_symbol_hash_set {
    optional_present(value: HashIteration)
  } else if sym == forbidden_symbol_now ||
      sym == forbidden_symbol_instant_now ||
      sym == forbidden_symbol_system_time_now {
    optional_present(value: TimeRead)
  } else if sym == forbidden_symbol_random ||
      sym == forbidden_symbol_thread_rng ||
      sym == forbidden_symbol_gen_range {
    optional_present(value: RandomRead)
  } else if sym == forbidden_symbol_std_env ||
      sym == forbidden_symbol_getenv ||
      sym == forbidden_symbol_var_os {
    optional_present(value: EnvRead)
  } else {
    optional_absent()
  }
}

fn forbidden_source_at_node(node: Node) -> Optional<DeterminismViolation> {
  match node.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      match non_det_source_for_symbol(sym: sym) {
        Present { value: source } =>
          optional_present(
            value: ForbiddenSource { source: source, at: node }
          )
        Absent => optional_absent()
      }
    _ => optional_absent()
  }
}

fn forbidden_scan_init(n: Node) -> ForbiddenScanState {
  ForbiddenScanState {
    violation: forbidden_source_at_node(node: n)
  }
}

fn forbidden_scan_step(
  acc: ForbiddenScanState,
  edge: Edge,
  child: ForbiddenScanState
) -> ForbiddenScanState {
  ForbiddenScanState {
    violation: optional_prefer_first_present(
      left: acc.violation,
      right: optional_prefer_first_present(
        left: forbidden_source_at_node(node: edge.target),
        right: child.violation
      )
    )
  }
}

fn first_forbidden_in_body(body: Node) -> Optional<DeterminismViolation> {
  fold_node(
    n: body,
    algebra: NodeFold {
      init: forbidden_scan_init,
      step: forbidden_scan_step
    }
  ).violation
}

fn reason_for_non_det_source(source: NonDetSource) -> Symbol {
  match source {
    HashIteration => determinism_forbidden_hash_iteration
    TimeRead => determinism_forbidden_time_read
    RandomRead => determinism_forbidden_random_read
    EnvRead => determinism_forbidden_env_read
  }
}

fn diagnostic_for_violation(v: DeterminismViolation) -> Diagnostic {
  match v {
    ForbiddenSource { source: source, at: node } =>
      Diagnostic {
        reason: reason_for_non_det_source(source: source),
        at: node_locus(node: node),
        correction: Unavailable { reason: AmbiguousIntent }
      }
    EffectLeak { callee: callee, at: node } =>
      Diagnostic {
        reason: determinism_effect_leak,
        at: node_locus(node: node),
        correction: Unavailable { reason: AmbiguousIntent }
      }
  }
}

fn callee_symbol_from_atom_node(target: Node) -> Optional<Symbol> {
  match target.kind {
    TypeNode { connective: Atom { identity: callee_sym } } =>
      optional_present(value: callee_sym)
    _ => optional_absent()
  }
}

// 🟡 gated — feature:determinism-effect-leak-binds-to — bind v4.std.dependency BindsTo; dissolve-on: T-9 resolve stamps Transform call-site callee as BindsTo (PR-4); forbidden: callee inference from generic Transform positional children.
fn callee_binds_to_violation(
  registry: Map<Symbol, DeterminismClass>,
  view: DependencyView
) -> Optional<DeterminismViolation> {
  match view.kind {
    BindsTo =>
      match callee_symbol_from_atom_node(target: view.dependent) {
        Present { value: callee_sym } =>
          match determinism_registry_lookup(registry: registry, signature: callee_sym) {
            Holds { value: classification } =>
              match classification {
                Deterministic => optional_absent()
                NonDeterministic { source: _ } =>
                  optional_present(
                    value: EffectLeak { callee: callee_sym, at: view.usage_site }
                  )
              }
            Violates { diagnostic: _ } =>
              optional_present(
                value: EffectLeak { callee: callee_sym, at: view.usage_site }
              )
          }
        Absent => optional_absent()
      }
    _ => optional_absent()
  }
}

fn first_effect_leak_in_body(
  body: Node,
  registry: Map<Symbol, DeterminismClass>
) -> Optional<DeterminismViolation> {
  fold(
    dependency_lens(root: body),
    init: optional_absent(),
    f: fn(acc, view) {
      optional_prefer_first_present(
        left: acc,
        right: callee_binds_to_violation(registry: registry, view: view)
      )
    }
  )
}

fn first_violation_in_body(
  body: Node,
  registry: Map<Symbol, DeterminismClass>
) -> Optional<DeterminismViolation> {
  optional_prefer_first_present(
    left: first_forbidden_in_body(body: body),
    right: first_effect_leak_in_body(body: body, registry: registry)
  )
}

fn determinism_witness(
  _tree: InferredTree,
  registry: Map<Symbol, DeterminismClass>,
  subject: DeterminismFact,
  body: Node
) -> Witness<DeterminismFact> {
  match subject.classification {
    Deterministic =>
      match first_violation_in_body(body: body, registry: registry) {
        Present { value: v } =>
          Violates { diagnostic: diagnostic_for_violation(v: v) }
        Absent => Holds { value: subject }
      }
    NonDeterministic { source: _ } => Holds { value: subject }
  }
}

fn determinism_witness_from_facts(
  tree: InferredTree,
  facts: List<DeterminismFact>,
  subject: DeterminismFact,
  body: Node
) -> Witness<DeterminismFact> {
  determinism_witness(
    tree: tree,
    registry: determinism_registry_from_facts(facts: facts),
    subject: subject,
    body: body
  )
}
