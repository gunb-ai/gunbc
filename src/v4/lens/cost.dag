// src/v4/lens/cost.dag
//
// Scope: cost lens — symbolic cost composition with target-realization.
// Anchor: THESIS Cost dimension §1.2 + per-target realization in extdeps/languages/*
//
// U2 (operator-ratified 2026-05-15) — cost is TOTAL over the closed
// kernel. SymbolicCost is defined at the kernel level (the 6 connectives
// × 5 behaviors), NOT per surface-feature. There is NO per-feature cost
// opt-in: anything expressible is kernel-composed, so it has a cost by
// construction; new surface dissolves to already-costed kernel nodes
// (C3); a new connective/behavior is a C1 STOP. A future language
// addition therefore CANNOT bypass cost/complexity — that is the
// no-eternal-maintenance property. This is the single U1 cost carrier;
// `lens/complexity.dag` CONSUMES this and projects it asymptotically —
// it never re-derives cost (one mechanism, two projections). Verify the
// SymbolicCost lattice axioms at fill (`UnknownCost`-as-top must satisfy
// the lattice laws — the AbelianGroup<Nat> precedent).
//
// Owns:
//   - SymbolicCost lattice (Constant + Linear + Polynomial + PolyLog + Exponential + Factorial + Log + Sum/Product + UnknownCost)
//   - lens read: Node -> Witness<SymbolicCost>   (total over the closed kernel)
//   - composes algebra+realization end-to-end
//
// Consumes:
//   - std/node.dag, std/witness.dag, std/algebra.dag
//   - extdeps/languages/*.dag: per-target realization cost
//
// Status: scaffold — fill per TASKS.md T-12
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.lens.cost

import v4.extdeps.languages.llvm_ir { LlvmInstruction }


type SymbolicCost
// 🟡 coproduct dissolution — DECISIONS.md T22-INFER-SYMBOLIC-COST-BRIDGE
  = ConstantCost { value: Int }
  | UnknownCost { reason: String }


fn llvm_instruction_cost(i: LlvmInstruction) -> Int {
  match i {
    Binary { result: _, result_type: _, op: _, lhs: _, rhs: _ } => 1
    Conversion { result: _, result_type: _, op: OpBitCast, value: _ } => 0
    Conversion { result: _, result_type: _, op: _, value: _ } => 1
    IntCompare { result: _, predicate: _, lhs: _, rhs: _ } => 1
    FloatCompare { result: _, predicate: _, lhs: _, rhs: _ } => 1
    Alloca { result: _, allocated_type: _, element_count: _ } => 1
    Load { result: _, result_type: _, pointer: _, ordering: _ } => 4
    Store { value: _, pointer: _, ordering: _ } => 4
    GetElementPtr { result: _, source_type: _, base: _, indices: _ } => 1
    AtomicRmw { result: _, op: _, pointer: _, operand: _, ordering: _ } => 8
    CmpXchg { result: _, pointer: _, compare_value: _, new_value: _, success_ordering: _, failure_ordering: _ } => 8
    Fence { ordering: _ } => 4
    ExtractValue { result: _, aggregate: _, indices: _ } => 0
    InsertValue { result: _, aggregate: _, element: _, indices: _ } => 1
    ExtractElement { result: _, vector: _, index: _ } => 1
    InsertElement { result: _, vector: _, element: _, index: _ } => 1
    ShuffleVector { result: _, first: _, second: _, mask: _ } => 1
    Select { result: _, condition: _, if_true: _, if_false: _ } => 1
    Call { callee: _, arguments: _, result: _ } => 5
    Freeze { result: _, value: _ } => 0
    FNeg { result: _, result_type: _, operand: _ } => 1
    VaArg { result: _, result_type: _, va_list: _, arg_type: _ } => 2
    LandingPad { result: _, result_type: _, is_cleanup: _, clauses: _ } => 1
    CatchPad { result: _, catch_switch: _, args: _ } => 1
    CleanupPad { result: _, parent_pad: _, args: _ } => 1
  }
}
