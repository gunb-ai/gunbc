// src/v4/lens/affected_set_examples.dag
// Scope: Expected affected-frontier example values for the affected-set lens.
// Owns: affected-set expected frontier rows
// Consumes: v4.std.diagnostic v4.std.node v4.lens.affected_set
// Status: example data for the affected-set frontier model.

module v4.lens.affected_set_examples

import v4.std.diagnostic {
  Diagnostic,
  node_locus,
  Unavailable,
  ExternalContractUnknown,
  diagnostics_singleton
}
import v4.std.node { Conj, Edit, Hash, Node, Path, Symbol, TypeNode }
import v4.lens.affected_set {
  ReExecFrontier,
  ChangedSubgraphFrontier,
  BoundaryExclusion,
  UnchangedPureBoundary,
  ExclusionKey,
  Rerun,
  Excluded,
  DimensionNotRead,
  FailClosed,
  ReasonSymbol,
  ReasonDiagnostics
}


data affected_set_example_path_symbol: Symbol = affected_set_example_path_symbol
data affected_set_example_dimension: Symbol = affected_set_example_dimension
data affected_set_example_reason: Symbol = affected_set_example_reason
data affected_set_example_hash: Hash = affected_set_example_hash


data affected_set_example_node: Node = Node {
  kind: TypeNode { connective: Conj },
  children: []
}


data affected_set_example_path: Path = Path { steps: [affected_set_example_path_symbol] }


data affected_set_example_edit: Edit = Edit {
  at: affected_set_example_path,
  replacement: affected_set_example_node
}


data affected_set_example_invalid_edit_diagnostic: Diagnostic = Diagnostic {
  reason: affected_set_example_reason,
  at: node_locus(node: affected_set_example_node),
  correction: Unavailable { reason: ExternalContractUnknown }
}


data expected_affected_set_boundary_prune: ReExecFrontier = ChangedSubgraphFrontier {
  boundary_exclusions: [
    BoundaryExclusion {
      edit: affected_set_example_edit,
      proof: UnchangedPureBoundary {
        content_hash: affected_set_example_hash
      }
    }
  ],
  decisions: empty_map()
}


data expected_affected_set_dimension_seed: ReExecFrontier = ChangedSubgraphFrontier {
  boundary_exclusions: [],
  decisions: map_insert(
    empty_map(),
    ExclusionKey { at: affected_set_example_node, dimension: affected_set_example_dimension },
    Rerun
  )
}


data expected_affected_set_excluded_proofs: ReExecFrontier = ChangedSubgraphFrontier {
  boundary_exclusions: [],
  decisions: map_insert(
    empty_map(),
    ExclusionKey { at: affected_set_example_node, dimension: affected_set_example_dimension },
    Excluded {
      first: DimensionNotRead {
        usage_site: affected_set_example_node,
        changed_dimension: affected_set_example_dimension
      },
      rest: [
        DimensionNotRead {
          usage_site: affected_set_example_node,
          changed_dimension: affected_set_example_dimension
        }
      ]
    }
  )
}


data expected_affected_set_unknown_fail_closed: ReExecFrontier = FailClosed {
  reason: ReasonSymbol { reason: affected_set_example_reason }
}


data expected_affected_set_rejected_edit_fail_closed: ReExecFrontier = FailClosed {
  reason: ReasonDiagnostics {
    diagnostics: diagnostics_singleton(d: affected_set_example_invalid_edit_diagnostic)
  }
}


data expected_affected_set_whole_dag_absorbs_later_unknown: ReExecFrontier = FailClosed {
  reason: ReasonDiagnostics {
    diagnostics: diagnostics_singleton(d: affected_set_example_invalid_edit_diagnostic)
  }
}
