// src/v4/lens/affected_set.dag
// Scope: canonical affected-set authority for CI/incremental re-execution; fail-closed B-4/B-5 node frontier.
// Owns: Dag, ReExecNode, ReExecFrontier, AffectedSetRead.
// Consumes: List, Diff, Node, Path, Witness; B-4 resolve/infer facts; B-5 effect facts.
// Status: scaffold, T-21.

module v4.lens.affected_set


import v4.std.collection { List }
import v4.std.node { Diff, Node, Path }
import v4.std.witness { Witness }


type Dag = Node


type ReExecNode {
  at: Path
  node: Node
}


type ReExecFrontier {
  rerun: List<ReExecNode>
}


type AffectedSetRead {
  read: fn(Dag, Diff) -> Witness<ReExecFrontier>
}
