// src/v4/lens/affected_set.dag
// Scope: canonical affected-set authority for CI/incremental re-execution; fail-closed B-4/B-5 node frontier.
// Owns: Dag, AffectedDimension, ExclusionKey, ExclusionProof, FrontierDecision, ReExecFrontier, AffectedSetRead, BoundaryReceipt, ChangedDimensionReceipt, affected_set.
// Consumes: Map, Diff, Edit, Hash, Node, Path, Symbol, Witness; B1 content_hash receipts; B-4 resolved Symbol equality; B-5 per-Arrow signature effects.
// Status: Wave-0 front: bounded changed-subgraph frontier fold landed; dissolves when CI use and .dag TestClaims land.

module v4.lens.affected_set


import v4.std.collection { Map }
import v4.std.node { Diff, Edit, Hash, Node, Path, Symbol }
import v4.std.witness { Witness }


type Dag = Node


type AffectedDimension = Symbol

data affected_dimension_value: Symbol = affected_dimension_value


type ExclusionKey {
  at: Path
  dimension: AffectedDimension
}


type FrontierEdge {
  producer: Path
  consumer: Path
  dimension: AffectedDimension
}


type EditDimension {
  edit: Edit
  dimension: AffectedDimension
}


type EditFrontierEdge {
  edit: Edit
  edge: FrontierEdge
}


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed
type ExclusionProof
  = EmptyDimensionDelta { subject: Path }
  | DimensionNotRead { producer: Path }
  | UnchangedPureBoundary { subject: Path, content_hash: Hash }


// 🟢 coproduct dissolution — DECISIONS.md #3153-subsumed
type FrontierDecision
  = Rerun
  | Excluded { proof: ExclusionProof }


// 🟢 coproduct dissolution — DECISIONS.md #3153-subsumed; IRT-1 whole/changed-subgraph gate.
type ReExecFrontier
  = ChangedSubgraphFrontier {
      decisions: Map<ExclusionKey, FrontierDecision>
    }
  | WholeDagFailClosed { reason: Symbol }


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed; dissolves when T-21 .dag TestClaims prove boundary cases.
type BoundaryReceipt
  = BoundaryPruned { proof: ExclusionProof, dag: Dag }
  | BoundaryExpands { dag: Dag }
  | BoundaryUnknown { reason: Symbol }


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed; dissolves when per-edit dimension deltas are generated.
type ChangedDimensionReceipt
  = ChangedDimensions { dimensions: List<AffectedDimension> }
  | ChangedDimensionsUnknown { reason: Symbol }


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed; dissolves when B-4/B-5 edge receipts are generated.
type PropagationReceipt
  = Propagates
  | DoesNotPropagate { proof: ExclusionProof }
  | PropagationUnknown { reason: Symbol }


type AffectedSetRead {
  boundary_receipt: fn(Dag, Edit) -> BoundaryReceipt
  changed_dimension_receipt: fn(Dag, Edit) -> ChangedDimensionReceipt
  proven_transitive_changed_subgraph_frontier: fn(Dag, EditDimension) -> List<FrontierEdge>
  propagation_receipt: fn(Dag, EditFrontierEdge) -> PropagationReceipt
}


// 🟢 coproduct dissolution — DECISIONS.md #3153-subsumed; accumulator mirrors ReExecFrontier authority.
type FrontierAcc
  = ChangedSubgraphAcc {
      decisions: Map<ExclusionKey, FrontierDecision>
    }
  | WholeDagAcc { reason: Symbol }


type AffectedFoldAcc {
  dag: Dag
  frontier: FrontierAcc
}


fn empty_frontier_acc() -> FrontierAcc {
  ChangedSubgraphAcc {
    decisions: empty_map()
  }
}


fn empty_affected_fold_acc(dag: Dag) -> AffectedFoldAcc {
  AffectedFoldAcc {
    dag: dag,
    frontier: empty_frontier_acc()
  }
}


fn frontier_from_fold_acc(acc: AffectedFoldAcc) -> ReExecFrontier {
  frontier_from_acc(acc: acc.frontier)
}


fn frontier_from_acc(acc: FrontierAcc) -> ReExecFrontier {
  match acc {
    ChangedSubgraphAcc { decisions: decisions } =>
      ChangedSubgraphFrontier {
        decisions: decisions
      }
    WholeDagAcc { reason: r } => WholeDagFailClosed { reason: r }
  }
}


fn root_key(path: Path, dimension: AffectedDimension) -> ExclusionKey {
  ExclusionKey {
    at: path,
    dimension: dimension
  }
}


fn edge_key(edge: FrontierEdge) -> ExclusionKey {
  ExclusionKey {
    at: edge.consumer,
    dimension: edge.dimension
  }
}


fn mark_rerun(acc: FrontierAcc, key: ExclusionKey) -> FrontierAcc {
  match acc {
    WholeDagAcc { reason: r } => WholeDagAcc { reason: r }
    ChangedSubgraphAcc { decisions: decisions } =>
      ChangedSubgraphAcc {
        decisions: map_insert(decisions, key, Rerun)
      }
  }
}


fn mark_excluded(acc: FrontierAcc, key: ExclusionKey, proof: ExclusionProof) -> FrontierAcc {
  match acc {
    WholeDagAcc { reason: r } => WholeDagAcc { reason: r }
    ChangedSubgraphAcc { decisions: decisions } =>
      match map_get(decisions, key) {
        Some { value: Rerun } =>
          ChangedSubgraphAcc {
            decisions: decisions
          }
        Some { value: Excluded { proof: _ } } =>
          ChangedSubgraphAcc {
            decisions: map_insert(decisions, key, Excluded { proof: proof })
          }
        None =>
          ChangedSubgraphAcc {
            decisions: map_insert(decisions, key, Excluded { proof: proof })
          }
      }
  }
}


fn mark_whole_dag(acc: FrontierAcc, reason: Symbol) -> FrontierAcc {
  WholeDagAcc { reason: reason }
}


fn read_boundary_receipt(read_model: AffectedSetRead, dag: Dag, edit: Edit) -> BoundaryReceipt {
  read_model.boundary_receipt(dag, edit)
}


fn expand_dimension(
  read_model: AffectedSetRead,
  dag: Dag,
  acc: FrontierAcc,
  edit: Edit,
  dimension: AffectedDimension
) -> FrontierAcc {
  fold(
    read_model.proven_transitive_changed_subgraph_frontier(
      dag,
      EditDimension { edit: edit, dimension: dimension }
    ),
    init: acc,
    f: fn(acc2, edge) {
    match read_model.propagation_receipt(dag, EditFrontierEdge { edit: edit, edge: edge }) {
      Propagates =>
        mark_rerun(acc: acc2, key: edge_key(edge: edge))
      DoesNotPropagate { proof: p } =>
        mark_excluded(acc: acc2, key: edge_key(edge: edge), proof: p)
      PropagationUnknown { reason: r } =>
        mark_whole_dag(
          acc: mark_rerun(acc: acc2, key: edge_key(edge: edge)),
          reason: r
        )
    }
  })
}


fn expand_changed_dimensions(
  read_model: AffectedSetRead,
  boundary_dag: Dag,
  frontier_dag: Dag,
  acc: FrontierAcc,
  edit: Edit
) -> FrontierAcc {
  match read_model.changed_dimension_receipt(boundary_dag, edit) {
    ChangedDimensions { dimensions: dimensions } =>
      fold(dimensions, init: acc, f: fn(acc2, dimension) {
        expand_dimension(
          read_model: read_model,
          dag: frontier_dag,
          acc: mark_rerun(acc: acc2, key: root_key(path: edit.at, dimension: dimension)),
          edit: edit,
          dimension: dimension
        )
      })
    ChangedDimensionsUnknown { reason: r } =>
      mark_whole_dag(acc: acc, reason: r)
  }
}


fn seed_edit_fold_acc(
  read_model: AffectedSetRead,
  acc: AffectedFoldAcc,
  edit: Edit
) -> AffectedFoldAcc {
  match read_boundary_receipt(
    read_model: read_model,
    dag: acc.dag,
    edit: edit
  ) {
    BoundaryPruned { proof: p, dag: next_dag } =>
      AffectedFoldAcc {
        dag: next_dag,
        frontier: mark_excluded(acc: acc.frontier, key: root_key(path: edit.at, dimension: affected_dimension_value), proof: p)
      }
    BoundaryExpands { dag: next_dag } =>
      AffectedFoldAcc {
        dag: next_dag,
        frontier: expand_changed_dimensions(
          read_model: read_model,
          boundary_dag: acc.dag,
          frontier_dag: next_dag,
          acc: acc.frontier,
          edit: edit
        )
      }
    BoundaryUnknown { reason: r } =>
      AffectedFoldAcc {
        dag: acc.dag,
        frontier: mark_whole_dag(
          acc: acc.frontier,
          reason: r
        )
      }
  }
}


fn affected_set(read_model: AffectedSetRead, dag: Dag, diff: Diff) -> Witness<ReExecFrontier> {
  Holds {
    value: frontier_from_fold_acc(
      acc: fold(diff.edits, init: empty_affected_fold_acc(dag: dag), f: fn(acc, edit) {
        seed_edit_fold_acc(
          read_model: read_model,
          acc: acc,
          edit: edit
        )
      })
    )
  }
}
