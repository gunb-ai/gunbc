// src/v4/lens/affected_set.dag
// Scope: canonical affected-set authority for CI/incremental re-execution; fail-closed B-4/B-5 node frontier.
// Owns: Dag, AffectedDimension, ReExecNode, ExclusionKey, ExclusionProof, ExclusionReceipt, ReExecFrontier, AffectedSetRead.
// Consumes: Map, Diff, Node, Path, Symbol, Witness; B-4 resolve/infer facts; B-5 effect facts.
// Status: scaffold; dissolves when T-21 read body, CI use, and .dag TestClaims land.

module v4.lens.affected_set


import v4.std.collection { Map }
import v4.std.node { Diff, Node, Path, Symbol }
import v4.std.witness { Witness }


type Dag = Node


type AffectedDimension = Symbol


type ReExecNode {
  node: Node
}


type ExclusionKey {
  at: Path
  dimension: AffectedDimension
}


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed
type ExclusionProof
  = EmptyDimensionDelta { subject: Path }
  | DimensionNotRead { producer: Path }


type ExclusionReceipt {
  node: Node
  proof: ExclusionProof
}


type ReExecFrontier {
  rerun: Map<Path, ReExecNode>
  excluded: Map<ExclusionKey, ExclusionReceipt>
}


type AffectedSetRead {
  read: fn(Dag, Diff) -> Witness<ReExecFrontier>
}
