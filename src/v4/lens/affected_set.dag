// src/v4/lens/affected_set.dag
// Scope: canonical affected-set authority for CI/incremental re-execution; fail-closed B-4/B-5 node frontier.
// Owns: Dag, AffectedDimension, ExclusionKey, ExclusionProof, PropagationExclusionProof, BoundaryExclusionProof, BoundaryExclusion, FailClosedReason, FrontierDecision, ReExecFrontier, RerunNodeSet, AffectedSetReading, AffectedSetRead, HashReceipt, ChangedDimensionReceipt, FrontierReceipt, affected_set, affected_set_reading, re_exec_frontier_from_diff, affected_set_from_diff.
// Consumes: List, Map, Diagnostic, Diff, Edit, Hash, Node, Path, Symbol, Witness, DependencyView, InferredTree; B1 content_hash receipts; B-4 resolved Symbol equality; B-5 per-Arrow signature effects.
// Status: T-21 IRT-1 filled — re_exec_frontier_from_diff changed-subgraph fold; inline FailClosed absorption in seed_edit_fold_acc; CI/T-24 node-precision closure via affected_set_from_diff.

module v4.lens.affected_set


import v4.std.collection { List, Map }
import v4.std.algebra { contains }
import v4.compiler.infer { InferredTree }
import v4.std.change {
  AffectedDependency,
  AffectedExclusion,
  AffectedSet,
  AffectedSetDiagnostics,
  AffectedSetEvidence,
  AffectedSetFailClosed,
  AffectedSetProduced,
  AffectedSetReason,
  Change,
  ChangeSet,
  NodeChanged
}
import v4.std.dependency { DependencyKind, DependencyView, ProjectionDependsOn, VerifiedBy, dependency_lens }
import v4.std.diagnostic {
  Diagnostic,
  Diagnostics,
  NonEmptyDiagnostics,
  Outcome,
  Accepted,
  None,
  diagnostics_merge,
  diagnostics_singleton
}
import v4.std.node { Diff, Edit, Hash, Node, Path, Symbol }
import v4.std.witness { Holds, Witness }


// RULING-1: 🟢 pretty-much-done — node alias.
type Dag = Node


// RULING-1: 🟢 pretty-much-done — dimension identity.
type AffectedDimension = Symbol

// RULING-1: 🟢 pretty-much-done — frontier carrier.
type ExclusionKey {
  at: Node
  dimension: AffectedDimension
}


// RULING-1: 🟢 pretty-much-done — frontier carrier.
type EditDimension {
  edit: Edit
  dimension: AffectedDimension
}


// 🟡 needs-more-work — feature:affected-set-exclusion-proof-carrier — bind T-21 — dissolve-on: affected_set gains additional proof arms beyond EmptyDimensionDelta
type ExclusionProof
  = EmptyDimensionDelta { subject: Path }


// 🟡 needs-more-work — feature:affected-set-propagation-exclusion-proof-carrier — bind T-21 — dissolve-on: B-4/B-5 per-arrow effect receipts populate DimensionNotRead evidence
type PropagationExclusionProof
  = DimensionNotRead { usage_site: Node, changed_dimension: AffectedDimension }


// 🟡 needs-more-work — feature:affected-set-boundary-exclusion-proof-carrier — bind T-21 — dissolve-on: B1 content_hash plus B-5 purity/effect receipts replace scaffold
type BoundaryExclusionProof
  = UnchangedPureBoundary { content_hash: Hash }


// RULING-1: 🟢 pretty-much-done — frontier carrier.
type BoundaryExclusion {
  edit: Edit
  proof: BoundaryExclusionProof
}


// 🟡 needs-more-work — feature:affected-set-fail-closed-reason-carrier — bind T-21 — dissolve-on: structured FailClosedReason coproduct arms derived from B-4/B-5 failure signal taxonomy
type FailClosedReason
  = ReasonSymbol { reason: Symbol }
  | ReasonDiagnostics { diagnostics: NonEmptyDiagnostics }


// 🟡 needs-more-work — feature:affected-set-frontier-decision-carrier — bind T-21 — dissolve-on: Excluded proof witnesses populated by propagation exclusion receipts
type FrontierDecision
  = Rerun
  | Excluded { first: PropagationExclusionProof, rest: List<PropagationExclusionProof> }


// 🟢 coproduct dissolution — #3153-subsumed; IRT-1 whole/changed-subgraph gate.
// RULING-1: 🟢 pretty-much-done — frontier carrier.
// 🟢 coproduct dissolution — #3153-subsumed; IRT-1 whole/changed-subgraph gate.
type ReExecFrontier
  = ChangedSubgraphFrontier {
      boundary_exclusions: List<BoundaryExclusion>,
      decisions: Map<ExclusionKey, FrontierDecision>
    }
  | FailClosed { reason: FailClosedReason }


// 🟡 needs-more-work — feature:affected-set-hash-receipt-carrier — bind T-21 — dissolve-on: B1/B-5 receipt primitives replace scaffold
type HashReceipt
  = HashUnchangedPure { content_hash: Hash }
  | HashChanged
  | HashUnknown { reason: Symbol }


// 🟡 needs-more-work — feature:affected-set-boundary-receipt-carrier — bind T-21 — dissolve-on: T-21 TestClaims boundary coverage
type BoundaryReceipt
  = BoundaryPruned { proof: BoundaryExclusionProof }
  | BoundaryExpands
  | BoundaryUnknown { reason: Symbol }


// 🟡 needs-more-work — feature:affected-set-dimension-delta-receipt-carrier — bind T-21 — dissolve-on: per-edit dimension delta generation produces ChangedDimensions
type ChangedDimensionReceipt
  = ChangedDimensions { first: AffectedDimension, rest: List<AffectedDimension> }
  | ChangedDimensionsUnknown { reason: Symbol }


// 🟡 needs-more-work — feature:B4-B5-propagation-receipt-carrier — bind T-21 — dissolve-on: B-4/B-5 edge receipts replace scaffold
type PropagationReceipt
  = Propagates
  | DoesNotPropagate { proof: PropagationExclusionProof }
  | PropagationUnknown { reason: Symbol }


// 🟡 needs-more-work — feature:affected-set-frontier-receipt-carrier — bind T-21 — dissolve-on: transitive dependency frontier from DependencyView replaces scaffold
type FrontierReceipt
  = FrontierProduced { dependencies: List<DependencyView> }
  | FrontierUnknown { reason: Symbol }
  | FrontierRejected { diagnostic: Diagnostic }


// RULING-1: 🟡 needs-more-work — frontier read.
type AffectedFrontierRead {
  proven_transitive_dependency_frontier: fn(Dag, EditDimension) -> FrontierReceipt
}


// RULING-1: 🟡 needs-more-work — boundary read.
type AffectedBoundaryRead {
  boundary_hash_receipt: fn(Dag, Path, Node) -> HashReceipt,
  changed_dimension_receipt: fn(Dag, Edit) -> ChangedDimensionReceipt
}


// RULING-1: 🟡 needs-more-work — read model.
type AffectedSetRead {
  boundary: AffectedBoundaryRead
  frontier: AffectedFrontierRead,
  propagation_receipt: fn(Dag, EditDimension, DependencyView) -> PropagationReceipt
}


// RULING-1: 🟡 needs-more-work — post-edit read.
type AffectedPostEditDagRead {
  outcome: Outcome<Node>
}


// RULING-1: 🟢 pretty-much-done — fold state.
type AffectedFoldAcc {
  dag: Dag
  frontier: ReExecFrontier
  pending: Diagnostics
}


// 🟢 coproduct dissolution — Wave-2-A affected-set fold state.
type AffectedSetFoldAcc
  = AffectedSetActive {
      dag: Dag,
      changes: ChangeSet,
      affected: List<AffectedDependency>,
      exclusions: List<AffectedExclusion>
    }
  | AffectedSetFailed {
      changes: ChangeSet,
      evidence: AffectedSetEvidence
    }


// 🟢 coproduct dissolution — T-21 edit/rebuild projection; preserves fail-closed evidence.
type RerunNodeSet
  = RerunNodeSetProduced {
      nodes: List<Node>
    }
  | RerunNodeSetFailClosed {
      evidence: AffectedSetEvidence
    }


type AffectedSetReading {
  edit_locus: Node
  affected: List<Node>
  dependencies: List<DependencyView>
}


type AffectedSetClosureAcc {
  frontier: List<Node>
  dependencies: List<DependencyView>
}


fn empty_frontier() -> ReExecFrontier {
  ChangedSubgraphFrontier {
    boundary_exclusions: [],
    decisions: empty_map()
  }
}


fn empty_affected_fold_acc(dag: Dag) -> AffectedFoldAcc {
  AffectedFoldAcc {
    dag: dag,
    frontier: empty_frontier(),
    pending: None
  }
}


fn empty_affected_set_fold_acc(dag: Dag) -> AffectedSetFoldAcc {
  AffectedSetActive {
    dag: dag,
    changes: ChangeSet { changes: [] },
    affected: [],
    exclusions: []
  }
}


fn fold_pending(acc: AffectedFoldAcc, next: Diagnostics) -> Diagnostics {
  diagnostics_merge(outer: acc.pending, inner: next)
}


// Pending accepted diagnostics escalate to whole-DAG fail-closed (conservative Q11 policy).
// When both a reason and pending diagnostics exist, diagnostics evidence wins.
fn frontier_from_fold_acc(acc: AffectedFoldAcc) -> ReExecFrontier {
  match acc.pending {
    Some { diagnostics: nds } => FailClosed {
      reason: ReasonDiagnostics { diagnostics: nds }
    }
    None => acc.frontier
  }
}


// 🟡 modeled-policy interim — feature:ai-16-r1-7-affected-set-frontier-kind-policy — consumer:v4.workflow.ci ci_select_from_affected_set — bind TASKS.md T-21 — dissolve-on-arrival: replace closed list with substrate dependency-policy carrier (dimension-parameterized frontier kinds); forbidden: permanent hardcoded match arms on DependencyKind outside this policy data.
fn lens_frontier_dependency_kinds() -> List<DependencyKind> {
  [ProjectionDependsOn, VerifiedBy]
}


data affected_set_reason_boundary_hash_unavailable: Symbol = affected_set_reason_boundary_hash_unavailable
data affected_set_reason_changed_dimensions_unavailable: Symbol = affected_set_reason_changed_dimensions_unavailable
data affected_set_reason_frontier_unavailable: Symbol = affected_set_reason_frontier_unavailable
data affected_set_reason_propagation_unavailable: Symbol = affected_set_reason_propagation_unavailable


fn dependency_kind_in_lens_frontier_policy(kind: DependencyKind) -> Bool {
  contains(
    xs: lens_frontier_dependency_kinds(),
    item: kind,
    eq: fn(left, right) { left == right }
  )
}


fn change_for_edit(edit: Edit) -> Change {
  Change {
    kind: NodeChanged,
    subject: edit.replacement,
    at: edit.at
  }
}


fn affected_set_from_fold_acc(acc: AffectedSetFoldAcc) -> AffectedSet {
  match acc {
    AffectedSetActive { dag: _, changes: changes, affected: affected, exclusions: exclusions } =>
      AffectedSetProduced {
        changes: changes,
        affected: affected,
        exclusions: exclusions,
        restricted_to: lens_frontier_dependency_kinds()
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailClosed {
        changes: changes,
        evidence: evidence
      }
  }
}


fn append_change(changes: ChangeSet, change: Change) -> ChangeSet {
  ChangeSet {
    changes: list_push(changes.changes, change)
  }
}


fn add_change_to_affected_acc(acc: AffectedSetFoldAcc, change: Change) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: dag, changes: changes, affected: affected, exclusions: exclusions } =>
      AffectedSetActive {
        dag: dag,
        changes: append_change(changes: changes, change: change),
        affected: affected,
        exclusions: exclusions
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: append_change(changes: changes, change: change),
        evidence: evidence
      }
  }
}


fn record_affected_dependency(
  acc: AffectedSetFoldAcc,
  change: Change,
  dependency: DependencyView
) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: dag, changes: changes, affected: affected, exclusions: exclusions } =>
      if dependency_in_lens_frontier(dependency: dependency) {
        AffectedSetActive {
          dag: dag,
          changes: changes,
          affected: list_push(
            affected,
            AffectedDependency {
              change: change,
              dependency: dependency
            }
          ),
          exclusions: exclusions
        }
      } else {
        AffectedSetActive {
          dag: dag,
          changes: changes,
          affected: affected,
          exclusions: exclusions
        }
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: changes,
        evidence: evidence
      }
  }
}


fn dependency_in_lens_frontier(dependency: DependencyView) -> Bool {
  dependency_kind_in_lens_frontier_policy(kind: dependency.kind)
}


fn node_in_list(nodes: List<Node>, needle: Node) -> Bool {
  fold(nodes, init: false, f: fn(found, node) {
    found || (node == needle)
  })
}


fn affected_set_closure_step(acc: AffectedSetClosureAcc, dependency: DependencyView) -> AffectedSetClosureAcc {
  if node_in_list(nodes: acc.frontier, needle: dependency.source) && (node_in_list(nodes: acc.frontier, needle: dependency.dependent) == false) {
    AffectedSetClosureAcc {
      frontier: list_push(acc.frontier, dependency.dependent),
      dependencies: list_push(acc.dependencies, dependency)
    }
  } else {
    acc
  }
}


fn affected_set_closure_pass(dependencies: List<DependencyView>, acc: AffectedSetClosureAcc) -> AffectedSetClosureAcc {
  fold(
    dependencies,
    init: acc,
    f: fn(acc, dependency) {
      affected_set_closure_step(acc: acc, dependency: dependency)
    }
  )
}


// 🟡 whole-graph scan — feature:ai-16-r1-7-affected-set-o-affected-region — consumer:v4.workflow.ci ci_select_from_affected_set — bind TASKS.md T-21 — dissolve-on-arrival: content-hash + pure-boundary pruning + edit-locus scoping replace O(whole-program) transitive closure here; forbidden: permanent full-graph dependency walk without dimension/content-hash pruning (IRT requires O(affected-region) not O(whole-program)).
fn affected_set_closure(dependencies: List<DependencyView>, edit_locus: Node) -> AffectedSetClosureAcc {
  fold(
    dependencies,
    init: AffectedSetClosureAcc {
      frontier: [edit_locus],
      dependencies: []
    },
    f: fn(acc, _) {
      affected_set_closure_pass(dependencies: dependencies, acc: acc)
    }
  )
}


fn affected_set_reading(graph: InferredTree, edit_locus: Node) -> AffectedSetReading {
  let dependency_reading = dependency_lens(root: graph.root)
  let closure = affected_set_closure(dependencies: dependency_reading, edit_locus: edit_locus)
  AffectedSetReading {
    edit_locus: edit_locus,
    affected: closure.frontier,
    dependencies: closure.dependencies
  }
}


fn append_changed_node_subjects(nodes: List<Node>, changes: ChangeSet) -> List<Node> {
  fold(changes.changes, init: nodes, f: fn(acc, change) {
    list_push(acc, change.subject)
  })
}


fn append_affected_dependency_nodes(nodes: List<Node>, affected: List<AffectedDependency>) -> List<Node> {
  fold(affected, init: nodes, f: fn(acc, row) {
    list_push(acc, row.dependency.dependent)
  })
}


fn affected_set_rerun_nodes(affected_set_value: AffectedSet) -> RerunNodeSet {
  match affected_set_value {
    AffectedSetProduced { changes: changes, affected: affected, exclusions: _, restricted_to: _ } =>
      RerunNodeSetProduced {
        nodes: append_affected_dependency_nodes(
          nodes: append_changed_node_subjects(nodes: [], changes: changes),
          affected: affected
        )
      }
    AffectedSetFailClosed { changes: _, evidence: evidence } =>
      RerunNodeSetFailClosed {
        evidence: evidence
      }
  }
}


fn record_affected_exclusion(
  acc: AffectedSetFoldAcc,
  change: Change,
  dependency: DependencyView,
  proof: PropagationExclusionProof
) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: dag, changes: changes, affected: affected, exclusions: exclusions } =>
      match proof {
        DimensionNotRead { usage_site: usage_site, changed_dimension: changed_dimension } =>
          AffectedSetActive {
            dag: dag,
            changes: changes,
            affected: affected,
            exclusions: list_push(
              exclusions,
              AffectedExclusion {
                change: change,
                dependency: dependency,
                usage_site: usage_site,
                changed_dimension: changed_dimension
              }
            )
          }
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: changes,
        evidence: evidence
      }
  }
}


fn fail_affected_set_with_reason(acc: AffectedSetFoldAcc, reason: Symbol) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: _, changes: changes, affected: _, exclusions: _ } =>
      AffectedSetFailed {
        changes: changes,
        evidence: AffectedSetReason { reason: reason }
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: changes,
        evidence: evidence
      }
  }
}


fn fail_affected_set_with_diagnostics(acc: AffectedSetFoldAcc, diagnostics: NonEmptyDiagnostics) -> AffectedSetFoldAcc {
  match acc {
    AffectedSetActive { dag: _, changes: changes, affected: _, exclusions: _ } =>
      AffectedSetFailed {
        changes: changes,
        evidence: AffectedSetDiagnostics { diagnostics: diagnostics }
      }
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed {
        changes: changes,
        evidence: evidence
      }
  }
}


fn root_key(subject: Node, dimension: AffectedDimension) -> ExclusionKey {
  ExclusionKey {
    at: subject,
    dimension: dimension
  }
}


fn dependency_key(dependency: DependencyView, dimension: AffectedDimension) -> ExclusionKey {
  ExclusionKey {
    at: dependency.dependent,
    dimension: dimension
  }
}


fn mark_rerun(frontier: ReExecFrontier, key: ExclusionKey) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: e } => FailClosed { reason: e }
    ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: decisions } =>
      ChangedSubgraphFrontier {
        boundary_exclusions: boundary_exclusions,
        decisions: map_insert(decisions, key, Rerun)
      }
  }
}


fn mark_boundary_excluded(frontier: ReExecFrontier, edit: Edit, proof: BoundaryExclusionProof) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: e } => FailClosed { reason: e }
    ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: decisions } =>
      ChangedSubgraphFrontier {
        boundary_exclusions: list_push(boundary_exclusions, BoundaryExclusion { edit: edit, proof: proof }),
        decisions: decisions
      }
  }
}


fn mark_excluded(frontier: ReExecFrontier, key: ExclusionKey, proof: PropagationExclusionProof) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: e } => FailClosed { reason: e }
    ChangedSubgraphFrontier { boundary_exclusions: boundary_exclusions, decisions: decisions } =>
      match map_get(decisions, key) {
        Some { value: Rerun } =>
          ChangedSubgraphFrontier {
            boundary_exclusions: boundary_exclusions,
            decisions: decisions
          }
        Some { value: Excluded { first: first, rest: rest } } =>
          ChangedSubgraphFrontier {
            boundary_exclusions: boundary_exclusions,
            decisions: map_insert(decisions, key, Excluded { first: first, rest: list_push(rest, proof) })
          }
        None =>
          ChangedSubgraphFrontier {
            boundary_exclusions: boundary_exclusions,
            decisions: map_insert(decisions, key, Excluded { first: proof, rest: [] })
          }
      }
  }
}


fn mark_whole_dag(reason: Symbol) -> ReExecFrontier {
  FailClosed { reason: ReasonSymbol { reason: reason } }
}


fn mark_whole_dag_diagnostics(diagnostics: NonEmptyDiagnostics) -> ReExecFrontier {
  FailClosed { reason: ReasonDiagnostics { diagnostics: diagnostics } }
}
fn mark_whole_dag_diagnostic(diagnostic: Diagnostic) -> ReExecFrontier {
  mark_whole_dag_diagnostics(
    diagnostics: diagnostics_singleton(d: diagnostic)
  )
}


fn boundary_receipt(read_model: AffectedSetRead, dag: Dag, path: Path, replacement: Node) -> BoundaryReceipt {
  match read_model.boundary.boundary_hash_receipt(dag, path, replacement) {
    HashUnchangedPure { content_hash: h } =>
      BoundaryPruned {
        proof: UnchangedPureBoundary {
          content_hash: h
        }
      }
    HashChanged => BoundaryExpands
    HashUnknown { reason: r } => BoundaryUnknown { reason: r }
  }
}


fn frontier_receipt(
  read_model: AffectedSetRead,
  dag: Dag,
  edit: Edit,
  dimension: AffectedDimension
) -> FrontierReceipt {
  read_model.frontier.proven_transitive_dependency_frontier(
    dag,
    EditDimension { edit: edit, dimension: dimension }
  )
}


fn propagation_receipt(
  read_model: AffectedSetRead,
  dag: Dag,
  edit: Edit,
  dimension: AffectedDimension,
  dependency: DependencyView
) -> PropagationReceipt {
  read_model.propagation_receipt(
    dag,
    EditDimension { edit: edit, dimension: dimension },
    dependency
  )
}


fn expand_dimension(
  read_model: AffectedSetRead,
  dag: Dag,
  frontier: ReExecFrontier,
  edit: Edit,
  dimension: AffectedDimension
) -> ReExecFrontier {
  match frontier {
    FailClosed { reason: e } => FailClosed { reason: e }
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: _ } =>
      match frontier_receipt(read_model: read_model, dag: dag, edit: edit, dimension: dimension) {
        FrontierProduced { dependencies: dependencies } =>
          fold(dependencies, init: frontier, f: fn(acc2, dependency) {
            match acc2 {
              FailClosed { reason: e } => FailClosed { reason: e }
              ChangedSubgraphFrontier { boundary_exclusions: _, decisions: _ } =>
                match propagation_receipt(
                  read_model: read_model,
                  dag: dag,
                  edit: edit,
                  dimension: dimension,
                  dependency: dependency
                ) {
                  Propagates =>
                    mark_rerun(frontier: acc2, key: dependency_key(dependency: dependency, dimension: dimension))
                  DoesNotPropagate { proof: p } =>
                    mark_excluded(frontier: acc2, key: dependency_key(dependency: dependency, dimension: dimension), proof: p)
                  PropagationUnknown { reason: r } =>
                    mark_whole_dag(reason: r)
                }
            }
          })
        FrontierUnknown { reason: r } =>
          mark_whole_dag(reason: r)
        FrontierRejected { diagnostic: d } =>
          mark_whole_dag_diagnostic(diagnostic: d)
      }
  }
}


fn seed_edit_fold_acc_live(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  acc: AffectedFoldAcc,
  edit: Edit
) -> AffectedFoldAcc {
  match boundary_receipt(
    read_model: read_model,
    dag: acc.dag,
    path: edit.at,
    replacement: edit.replacement
  ) {
    BoundaryPruned { proof: p } =>
      AffectedFoldAcc {
        dag: acc.dag,
        frontier: mark_boundary_excluded(frontier: acc.frontier, edit: edit, proof: p),
        pending: acc.pending
      }
    BoundaryExpands =>
      match post_edit_dag(acc.dag, edit).outcome {
        Accepted { value: next_dag, diagnostics: ad } =>
          AffectedFoldAcc {
            dag: next_dag,
            frontier: expand_changed_dimensions(
              read_model: read_model,
              boundary_dag: acc.dag,
              frontier_dag: next_dag,
              frontier: acc.frontier,
              edit: edit
            ),
            pending: fold_pending(acc: acc, next: ad)
          }
        Rejected { diagnostics: nds } =>
          AffectedFoldAcc {
            dag: acc.dag,
            frontier: mark_whole_dag_diagnostics(diagnostics: nds),
            pending: acc.pending
          }
      }
    BoundaryUnknown { reason: boundary_reason } =>
      match post_edit_dag(acc.dag, edit).outcome {
        Accepted { value: next_dag, diagnostics: ad } =>
          AffectedFoldAcc {
            dag: next_dag,
            frontier: mark_whole_dag(reason: boundary_reason),
            pending: fold_pending(acc: acc, next: ad)
          }
        Rejected { diagnostics: nds } =>
          AffectedFoldAcc {
            dag: acc.dag,
            frontier: mark_whole_dag_diagnostics(diagnostics: nds),
            pending: acc.pending
          }
      }
  }
}


fn expand_changed_dimensions(
  read_model: AffectedSetRead,
  boundary_dag: Dag,
  frontier_dag: Dag,
  frontier: ReExecFrontier,
  edit: Edit
) -> ReExecFrontier {
  match read_model.boundary.changed_dimension_receipt(boundary_dag, edit) {
    ChangedDimensions { first: first_dimension, rest: rest_dimensions } =>
      fold(rest_dimensions, init: expand_dimension(
        read_model: read_model,
        dag: frontier_dag,
        frontier: mark_rerun(frontier: frontier, key: root_key(subject: edit.replacement, dimension: first_dimension)),
        edit: edit,
        dimension: first_dimension
      ), f: fn(acc2, dimension) {
        expand_dimension(
          read_model: read_model,
          dag: frontier_dag,
          frontier: mark_rerun(frontier: acc2, key: root_key(subject: edit.replacement, dimension: dimension)),
          edit: edit,
          dimension: dimension
        )
      })
    ChangedDimensionsUnknown { reason: r } =>
      mark_whole_dag(reason: r)
  }
}


fn seed_edit_fold_acc(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  acc: AffectedFoldAcc,
  edit: Edit
) -> AffectedFoldAcc {
  match acc.frontier {
    FailClosed { reason: _ } => acc
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: _ } =>
      seed_edit_fold_acc_live(
        read_model: read_model,
        post_edit_dag: post_edit_dag,
        acc: acc,
        edit: edit
      )
  }
}


fn expand_affected_dimension(
  read_model: AffectedSetRead,
  dag: Dag,
  acc: AffectedSetFoldAcc,
  edit: Edit,
  dimension: AffectedDimension
) -> AffectedSetFoldAcc {
  match frontier_receipt(read_model: read_model, dag: dag, edit: edit, dimension: dimension) {
    FrontierProduced { dependencies: dependencies } =>
      fold(dependencies, init: acc, f: fn(acc2, dependency) {
        match propagation_receipt(
          read_model: read_model,
          dag: dag,
          edit: edit,
          dimension: dimension,
          dependency: dependency
        ) {
          Propagates =>
            record_affected_dependency(
              acc: acc2,
              change: change_for_edit(edit: edit),
              dependency: dependency
            )
          DoesNotPropagate { proof: p } =>
            record_affected_exclusion(
              acc: acc2,
              change: change_for_edit(edit: edit),
              dependency: dependency,
              proof: p
            )
          PropagationUnknown { reason: r } =>
            fail_affected_set_with_reason(acc: acc2, reason: r)
        }
      })
    FrontierUnknown { reason: r } =>
      fail_affected_set_with_reason(acc: acc, reason: r)
    FrontierRejected { diagnostic: d } =>
      fail_affected_set_with_diagnostics(
        acc: acc,
        diagnostics: diagnostics_singleton(d: d)
      )
  }
}


fn expand_affected_dimensions(
  read_model: AffectedSetRead,
  boundary_dag: Dag,
  frontier_dag: Dag,
  acc: AffectedSetFoldAcc,
  edit: Edit
) -> AffectedSetFoldAcc {
  match read_model.boundary.changed_dimension_receipt(boundary_dag, edit) {
    ChangedDimensions { first: first_dimension, rest: rest_dimensions } =>
      fold(rest_dimensions, init: expand_affected_dimension(
        read_model: read_model,
        dag: frontier_dag,
        acc: acc,
        edit: edit,
        dimension: first_dimension
      ), f: fn(acc2, dimension) {
        expand_affected_dimension(
          read_model: read_model,
          dag: frontier_dag,
          acc: acc2,
          edit: edit,
          dimension: dimension
        )
      })
    ChangedDimensionsUnknown { reason: r } =>
      fail_affected_set_with_reason(acc: acc, reason: r)
  }
}


fn seed_affected_set_fold_acc_live(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  acc: AffectedSetFoldAcc,
  edit: Edit
) -> AffectedSetFoldAcc {
  let change = change_for_edit(edit: edit)
  match add_change_to_affected_acc(acc: acc, change: change) {
    AffectedSetFailed { changes: changes, evidence: evidence } =>
      AffectedSetFailed { changes: changes, evidence: evidence }
    AffectedSetActive {
      dag: active_dag,
      changes: active_changes,
      affected: active_affected,
      exclusions: active_exclusions
    } =>
      match boundary_receipt(
        read_model: read_model,
        dag: active_dag,
        path: edit.at,
        replacement: edit.replacement
      ) {
        BoundaryPruned { proof: _ } =>
          AffectedSetActive {
            dag: active_dag,
            changes: active_changes,
            affected: active_affected,
            exclusions: active_exclusions
        }
        BoundaryExpands =>
          match post_edit_dag(active_dag, edit).outcome {
            Accepted { value: next_dag, diagnostics: ad } =>
              match ad {
                Some { diagnostics: nds } =>
                  fail_affected_set_with_diagnostics(
                    acc: AffectedSetActive {
                      dag: next_dag,
                      changes: active_changes,
                      affected: active_affected,
                      exclusions: active_exclusions
                    },
                    diagnostics: nds
                  )
                None =>
                  expand_affected_dimensions(
                    read_model: read_model,
                    boundary_dag: active_dag,
                    frontier_dag: next_dag,
                    acc: AffectedSetActive {
                      dag: next_dag,
                      changes: active_changes,
                      affected: active_affected,
                      exclusions: active_exclusions
                    },
                    edit: edit
                  )
              }
            Rejected { diagnostics: nds } =>
              fail_affected_set_with_diagnostics(
                acc: AffectedSetActive {
                  dag: active_dag,
                  changes: active_changes,
                  affected: active_affected,
                  exclusions: active_exclusions
                },
                diagnostics: nds
              )
          }
        BoundaryUnknown { reason: r } =>
          fail_affected_set_with_reason(
            acc: AffectedSetActive {
              dag: active_dag,
              changes: active_changes,
              affected: active_affected,
              exclusions: active_exclusions
            },
            reason: r
          )
      }
  }
}


fn affected_set_from_diff(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  dag: Dag,
  diff: Diff
) -> Witness<AffectedSet> {
  Holds {
    value: affected_set_from_fold_acc(
      acc: fold(diff.edits, init: empty_affected_set_fold_acc(dag: dag), f: fn(acc, edit) {
        seed_affected_set_fold_acc_live(
          read_model: read_model,
          post_edit_dag: post_edit_dag,
          acc: acc,
          edit: edit
        )
      })
    )
  }
}


// IRT-1 canonical entry: pure fold over diff.edits — O(changed-region), fail-closed on unknown receipts.
fn re_exec_frontier_from_diff(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  dag: Dag,
  diff: Diff
) -> Witness<ReExecFrontier> {
  Holds {
    value: frontier_from_fold_acc(
      acc: fold(diff.edits, init: empty_affected_fold_acc(dag: dag), f: fn(acc, edit) {
        seed_edit_fold_acc(
          read_model: read_model,
          post_edit_dag: post_edit_dag,
          acc: acc,
          edit: edit
        )
      })
    )
  }
}


fn affected_set(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagRead,
  dag: Dag,
  diff: Diff
) -> Witness<ReExecFrontier> {
  re_exec_frontier_from_diff(
    read_model: read_model,
    post_edit_dag: post_edit_dag,
    dag: dag,
    diff: diff
  )
}
