// src/v4/lens/affected_set.dag
// Scope: canonical affected-set authority for CI/incremental re-execution; fail-closed B-4/B-5 node frontier.
// Owns: Dag, AffectedDimension, ExclusionKey, ExclusionProof, BoundaryExclusionProof, WholeDagFailClosedEvidence, FrontierDecision, ReExecFrontier, AffectedSetRead, AffectedPostEditDagReceipt, HashReceipt, ChangedDimensionReceipt, affected_set.
// Consumes: Map, Diagnostic, Diff, Edit, Hash, Node, Path, Symbol, Witness; B1 content_hash receipts; B-4 resolved Symbol equality; B-5 per-Arrow signature effects.
// Status: Wave-0 front: bounded changed-subgraph frontier fold landed; dissolves when CI use and .dag TestClaims land.

module v4.lens.affected_set


import v4.std.collection { Map }
import v4.std.diagnostic { Diagnostic }
import v4.std.node { Diff, Edit, Hash, Node, Path, Symbol }
import v4.std.witness { Witness }


type Dag = Node


type AffectedDimension = Symbol

type ExclusionKey {
  at: Path
  dimension: AffectedDimension
}


type FrontierEdge {
  producer: Path
  consumer: Path
  dimension: AffectedDimension
}


type EditDimension {
  edit: Edit
  dimension: AffectedDimension
}


type EditFrontierEdge {
  edit: Edit
  edge: FrontierEdge
}


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed
type ExclusionProof
  = EmptyDimensionDelta { subject: Path }
  | DimensionNotRead { producer: Path }


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed
type BoundaryExclusionProof
  = UnchangedPureBoundary { subject: Path, content_hash: Hash }


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed
type WholeDagFailClosedEvidence
  = WholeDagReason { reason: Symbol }
  | WholeDagDiagnostic { diagnostic: Diagnostic }


// 🟢 coproduct dissolution — DECISIONS.md #3153-subsumed
type FrontierDecision
  = Rerun
  | Excluded { proofs: List<ExclusionProof> }


// 🟢 coproduct dissolution — DECISIONS.md #3153-subsumed; IRT-1 whole/changed-subgraph gate.
type ReExecFrontier
  = ChangedSubgraphFrontier {
      boundary_exclusions: Map<Edit, BoundaryExclusionProof>,
      decisions: Map<ExclusionKey, FrontierDecision>
    }
  | WholeDagFailClosed { evidence: WholeDagFailClosedEvidence }


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed; dissolves into B1 content_hash plus B-5 purity/effect receipts.
type HashReceipt
  = HashUnchangedPure { content_hash: Hash }
  | HashChanged
  | HashUnknown { reason: Symbol }


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed; dissolves when T-21 .dag TestClaims prove boundary cases.
type BoundaryReceipt
  = BoundaryPruned { proof: BoundaryExclusionProof }
  | BoundaryExpands
  | BoundaryUnknown { reason: Symbol }


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed; dissolves when per-edit dimension deltas are generated.
type ChangedDimensionReceipt
  = ChangedDimensions { first: AffectedDimension, rest: List<AffectedDimension> }
  | ChangedDimensionsUnknown { reason: Symbol }


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed; dissolves when B-4/B-5 edge receipts are generated.
type PropagationReceipt
  = Propagates
  | DoesNotPropagate { proof: ExclusionProof }
  | PropagationUnknown { reason: Symbol }


type AffectedBoundaryRead {
  boundary_hash_receipt: fn(Dag, Path, Node) -> HashReceipt,
  changed_dimension_receipt: fn(Dag, Edit) -> ChangedDimensionReceipt
}


type AffectedFrontierRead {
  proven_transitive_changed_subgraph_frontier: fn(Dag, EditDimension) -> List<FrontierEdge>
}


// 🟡 coproduct dissolution — DECISIONS.md #3153-subsumed; dissolves into D1 apply_diff Outcome<Dag>.
type AffectedPostEditDagReceipt
  = PostEditDagProduced { dag: Dag }
  | PostEditDagRejected { diagnostic: Diagnostic }


type AffectedSetRead {
  boundary: AffectedBoundaryRead
  frontier: AffectedFrontierRead
  propagation_receipt: fn(Dag, EditFrontierEdge) -> PropagationReceipt
}


// 🟢 coproduct dissolution — DECISIONS.md #3153-subsumed; accumulator mirrors ReExecFrontier authority.
type FrontierAcc
  = ChangedSubgraphAcc {
      boundary_exclusions: Map<Edit, BoundaryExclusionProof>,
      decisions: Map<ExclusionKey, FrontierDecision>
    }
  | WholeDagAcc { evidence: WholeDagFailClosedEvidence }


type AffectedFoldAcc {
  dag: Dag
  frontier: FrontierAcc
}


fn empty_frontier_acc() -> FrontierAcc {
  ChangedSubgraphAcc {
    boundary_exclusions: empty_map(),
    decisions: empty_map()
  }
}


fn empty_affected_fold_acc(dag: Dag) -> AffectedFoldAcc {
  AffectedFoldAcc {
    dag: dag,
    frontier: empty_frontier_acc()
  }
}


fn frontier_from_fold_acc(acc: AffectedFoldAcc) -> ReExecFrontier {
  frontier_from_acc(acc: acc.frontier)
}


fn frontier_from_acc(acc: FrontierAcc) -> ReExecFrontier {
  match acc {
    ChangedSubgraphAcc { boundary_exclusions: boundary_exclusions, decisions: decisions } =>
      ChangedSubgraphFrontier {
        boundary_exclusions: boundary_exclusions,
        decisions: decisions
      }
    WholeDagAcc { evidence: e } => WholeDagFailClosed { evidence: e }
  }
}


fn root_key(path: Path, dimension: AffectedDimension) -> ExclusionKey {
  ExclusionKey {
    at: path,
    dimension: dimension
  }
}


fn edge_key(edge: FrontierEdge) -> ExclusionKey {
  ExclusionKey {
    at: edge.consumer,
    dimension: edge.dimension
  }
}


fn mark_rerun(acc: FrontierAcc, key: ExclusionKey) -> FrontierAcc {
  match acc {
    WholeDagAcc { evidence: e } => WholeDagAcc { evidence: e }
    ChangedSubgraphAcc { boundary_exclusions: boundary_exclusions, decisions: decisions } =>
      ChangedSubgraphAcc {
        boundary_exclusions: boundary_exclusions,
        decisions: map_insert(decisions, key, Rerun)
      }
  }
}


fn mark_boundary_excluded(acc: FrontierAcc, edit: Edit, proof: BoundaryExclusionProof) -> FrontierAcc {
  match acc {
    WholeDagAcc { evidence: e } => WholeDagAcc { evidence: e }
    ChangedSubgraphAcc { boundary_exclusions: boundary_exclusions, decisions: decisions } =>
      ChangedSubgraphAcc {
        boundary_exclusions: map_insert(boundary_exclusions, edit, proof),
        decisions: decisions
      }
  }
}


fn mark_excluded(acc: FrontierAcc, key: ExclusionKey, proof: ExclusionProof) -> FrontierAcc {
  match acc {
    WholeDagAcc { evidence: e } => WholeDagAcc { evidence: e }
    ChangedSubgraphAcc { boundary_exclusions: boundary_exclusions, decisions: decisions } =>
      match map_get(decisions, key) {
        Some { value: Rerun } =>
          ChangedSubgraphAcc {
            boundary_exclusions: boundary_exclusions,
            decisions: decisions
          }
        Some { value: Excluded { proofs: proofs } } =>
          ChangedSubgraphAcc {
            boundary_exclusions: boundary_exclusions,
            decisions: map_insert(decisions, key, Excluded { proofs: list_push(proofs, proof) })
          }
        None =>
          ChangedSubgraphAcc {
            boundary_exclusions: boundary_exclusions,
            decisions: map_insert(decisions, key, Excluded { proofs: [proof] })
          }
      }
  }
}


fn mark_whole_dag(acc: FrontierAcc, reason: Symbol) -> FrontierAcc {
  WholeDagAcc { evidence: WholeDagReason { reason: reason } }
}


fn mark_whole_dag_diagnostic(acc: FrontierAcc, diagnostic: Diagnostic) -> FrontierAcc {
  WholeDagAcc { evidence: WholeDagDiagnostic { diagnostic: diagnostic } }
}


fn boundary_receipt(read_model: AffectedSetRead, dag: Dag, path: Path, replacement: Node) -> BoundaryReceipt {
  match read_model.boundary.boundary_hash_receipt(dag, path, replacement) {
    HashUnchangedPure { content_hash: h } =>
      BoundaryPruned {
        proof: UnchangedPureBoundary {
          subject: path,
          content_hash: h
        }
      }
    HashChanged => BoundaryExpands
    HashUnknown { reason: r } => BoundaryUnknown { reason: r }
  }
}


fn expand_dimension(
  read_model: AffectedSetRead,
  dag: Dag,
  acc: FrontierAcc,
  edit: Edit,
  dimension: AffectedDimension
) -> FrontierAcc {
  fold(
    read_model.frontier.proven_transitive_changed_subgraph_frontier(
      dag,
      EditDimension { edit: edit, dimension: dimension }
    ),
    init: acc,
    f: fn(acc2, edge) {
    match read_model.propagation_receipt(dag, EditFrontierEdge { edit: edit, edge: edge }) {
      Propagates =>
        mark_rerun(acc: acc2, key: edge_key(edge: edge))
      DoesNotPropagate { proof: p } =>
        mark_excluded(acc: acc2, key: edge_key(edge: edge), proof: p)
      PropagationUnknown { reason: r } =>
        mark_whole_dag(
          acc: mark_rerun(acc: acc2, key: edge_key(edge: edge)),
          reason: r
        )
    }
  })
}


fn expand_changed_dimensions(
  read_model: AffectedSetRead,
  boundary_dag: Dag,
  frontier_dag: Dag,
  acc: FrontierAcc,
  edit: Edit
) -> FrontierAcc {
  match read_model.boundary.changed_dimension_receipt(boundary_dag, edit) {
    ChangedDimensions { first: first_dimension, rest: rest_dimensions } =>
      fold(rest_dimensions, init: expand_dimension(
        read_model: read_model,
        dag: frontier_dag,
        acc: mark_rerun(acc: acc, key: root_key(path: edit.at, dimension: first_dimension)),
        edit: edit,
        dimension: first_dimension
      ), f: fn(acc2, dimension) {
        expand_dimension(
          read_model: read_model,
          dag: frontier_dag,
          acc: mark_rerun(acc: acc2, key: root_key(path: edit.at, dimension: dimension)),
          edit: edit,
          dimension: dimension
        )
      })
    ChangedDimensionsUnknown { reason: r } =>
      mark_whole_dag(acc: acc, reason: r)
  }
}


fn seed_edit_fold_acc(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagReceipt,
  acc: AffectedFoldAcc,
  edit: Edit
) -> AffectedFoldAcc {
  match post_edit_dag(acc.dag, edit) {
    PostEditDagProduced { dag: next_dag } =>
      match boundary_receipt(
        read_model: read_model,
        dag: acc.dag,
        path: edit.at,
        replacement: edit.replacement
      ) {
        BoundaryPruned { proof: p } =>
          AffectedFoldAcc {
            dag: next_dag,
            frontier: mark_boundary_excluded(acc: acc.frontier, edit: edit, proof: p)
          }
        BoundaryExpands =>
          AffectedFoldAcc {
            dag: next_dag,
            frontier: expand_changed_dimensions(
              read_model: read_model,
              boundary_dag: acc.dag,
              frontier_dag: next_dag,
              acc: acc.frontier,
              edit: edit
            )
          }
        BoundaryUnknown { reason: r } =>
          AffectedFoldAcc {
            dag: next_dag,
            frontier: mark_whole_dag(
              acc: acc.frontier,
              reason: r
            )
          }
      }
    PostEditDagRejected { diagnostic: d } =>
      AffectedFoldAcc {
        dag: acc.dag,
        frontier: mark_whole_dag_diagnostic(
          acc: acc.frontier,
          diagnostic: d
        )
      }
  }
}


fn affected_set(
  read_model: AffectedSetRead,
  post_edit_dag: fn(Dag, Edit) -> AffectedPostEditDagReceipt,
  dag: Dag,
  diff: Diff
) -> Witness<ReExecFrontier> {
  Holds {
    value: frontier_from_fold_acc(
      acc: fold(diff.edits, init: empty_affected_fold_acc(dag: dag), f: fn(acc, edit) {
        seed_edit_fold_acc(
          read_model: read_model,
          post_edit_dag: post_edit_dag,
          acc: acc,
          edit: edit
        )
      })
    )
  }
}
