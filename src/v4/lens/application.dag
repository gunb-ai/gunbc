// src/v4/lens/application.dag
//
// Scope: lens-application surface — how a user attaches a lens to a program section (declaration / module / expression scope) with configurable enforcement. THE opt-in-depth mechanism + user-defined-dimensions surface + the ONLY advisory→fail-closed bridge. Referenced by report.dag/synthesis.dag's apply_lens(Enforce) — this file is its substrate home.
// Anchor: THESIS:95-101 (user-defined dimensions) + THESIS:307-321 (audience duality / opt-in depth) + r3-structure.md:40 (v3 T-Lens-Application-Surface precedent)
//
// Owns:
//   - SectionRef = DeclarationScope | NodeScope (disjoint sum; where the lens attaches)
//   - EnforceableLens + LensApplicationConfig (single enforce/introspect mode authority)
//   - apply_lens / apply_lens_enforce — introspect (Lens only) vs enforce entry points
//   - THE single advisory→fail-closed bridge: Enforce { } converts a lens's
//     Set<Report> into fail-closed Diagnostics (per std/report.dag discipline);
//     no other path from advisory to blocking exists
//   - D1 OPERATIONS over the std/node.dag structural-delta types
//     (Path/Edit/Diff — the DATA lives in std/node.dag):
//       - subterm_at(root: Node, p: Path) -> Result<Node, Diagnostic>
//       - apply_diff(root: Node, d: Diff) -> Result<Node, Diagnostic>
//
// Status: T-23 filled — carriers + apply_lens + D1 ops (see header for immutable I/O contract).
// P2 boundary: THIS module is the single authority for section-scoped `Lens<Output>.read`,
// `LensApplicationConfig`, and `apply_lens` / `apply_lens_enforce` / `apply_advisory_lens`.
// `v4.compiler.compile` owns the orthogonal compile-pipeline gate (`CompileLens`,
// `CompileLensMode`, `apply_compile_lens` over `InferredTree`); adapter wiring is follow-on.
// See (T-23-PIN).

module v4.lens.application

import v4.std.algebra { Cons, is_empty, fold_list }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  node_locus,
  non_empty_diagnostics_append,
  outcome_accepted,
  outcome_rejected
}
import v4.std.node {
  Conj,
  Diff,
  Edge,
  Edit,
  Named,
  Node,
  NodeKind,
  Path,
  Positional,
  Symbol,
  TypeNode,
  name_occurrences
}
import v4.std.report { Report, report_reason_to_diagnostic_reason }

// Mechanical port (interface-freeze pin §4): opaque until shared substrate graduates.
type DeclarationId
type NodeId
type SourceSpan

// 🟢 TERMINAL — disjoint sum over section shapes (design-lens-application-surface §1.2).
type SectionRef
  = DeclarationScope { declaration: DeclarationId }
  | NodeScope { declaration: DeclarationId, node: NodeId }

// 🟢 TERMINAL — C-8 fail-closed: only Error is admitted steady state (design §3 nominal).
// v4 substrate: unit variant (v3 `Error` tag is not a v4 type name).
type DiagnosticSeverity
  = SeverityError {}

// 🟢 TERMINAL — per-lens enforcement projection + violation relation.
type LensEnforcement<Output, Budget, Projected> {
  project: fn(Output) -> Projected
  violates: fn(Projected, Budget) -> Bool
}

// 🟢 TERMINAL — bundled lens + canonical enforcement (P2 single authority).
type EnforceableLens<Output, Budget, Projected> {
  lens: Lens<Output>
  enforcement: LensEnforcement<Output, Budget, Projected>
}

// 🟢 grounded — application-surface lens read (fail-closed at read boundary).
type Lens<Output> {
  read: fn(Node) -> Outcome<Output>
}

// 🟢 grounded — advisory lens read (Report carrier; never Witness).
// Materialized as List<Report> (v4 Set<T> = PointwisePower membership predicate).
type AdvisoryLens {
  read: fn(Node) -> List<Report>
}

// 🟢 coproduct dissolution — enforce vs introspect application mode (single authority).
type LensApplicationConfig<Output, Budget, Projected>
  = LensIntrospect
  | LensEnforce {
      budget: Budget
      diagnostic_severity: DiagnosticSeverity
    }

// 🟢 TERMINAL — enforce-mode application carrier (design-lens-application-surface §2).
type EnforcedApplication<Output, Budget, Projected> {
  enforceable_lens: EnforceableLens<Output, Budget, Projected>
  section: SectionRef
  budget: Budget
  diagnostic_severity: DiagnosticSeverity
  span: SourceSpan
}

// 🟢 TERMINAL — introspect-mode application carrier (design-lens-application-surface §2).
type IntrospectApplication<Output> {
  lens: Lens<Output>
  section: SectionRef
  span: SourceSpan
}

data path_unresolvable_reason: Symbol = path_unresolvable_reason
data path_ambiguous_reason: Symbol = path_ambiguous_reason
data lens_enforcement_violation_reason: Symbol = lens_enforcement_violation_reason
data advisory_reports_empty_reason: Symbol = advisory_reports_empty_reason

fn path_unresolvable_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: path_unresolvable_reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn path_ambiguous_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: path_ambiguous_reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn lens_enforcement_violation_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: lens_enforcement_violation_reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn advisory_report_diagnostic(report: Report) -> Diagnostic {
  Diagnostic {
    reason: report_reason_to_diagnostic_reason(reason: report.reason),
    at: report.at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// 🟢 grounded — D1 path step via std.node `name_occurrences` uniqueness gate (Practice 10:
// canonical substrate accessor; no parallel EdgeLabel walker).
fn find_child_by_name(root: Node, name: Symbol) -> Outcome<Node> {
  if name_occurrences(name: name, children: root.children) == 0 {
    outcome_rejected(d: path_unresolvable_diagnostic(at: root))
  } else if name_occurrences(name: name, children: root.children) == 1 {
    fold(
      root.children,
      init: outcome_rejected(d: path_unresolvable_diagnostic(at: root)),
      f: fn(acc, e) {
        match acc {
          Rejected { diagnostics: _ } =>
            match e.label {
              Named { name: edge_name } =>
                if edge_name == name {
                  outcome_accepted(value: e.target)
                } else {
                  acc
                }
              Positional => acc
            }
          Accepted { value: _, diagnostics: _ } => acc
        }
      }
    )
  } else {
    outcome_rejected(d: path_ambiguous_diagnostic(at: root))
  }
}

fn subterm_at_steps(root: Node, steps: List<Symbol>) -> Outcome<Node> {
  fold_list(
    xs: steps,
    empty: outcome_accepted(value: root),
    cons: fn(acc, step) {
      bind_outcome(
        o: acc,
        f: fn(current) {
          find_child_by_name(root: current, name: step)
        }
      )
    }
  )
}

// Result<Node, Diagnostic> ≡ Outcome<Node> per DECISIONS item I / std/diagnostic.dag.
fn subterm_at(root: Node, p: Path) -> Outcome<Node> {
  subterm_at_steps(root: root, steps: p.steps)
}

fn replace_edge_target(e: Edge, replacement: Node) -> Edge {
  Edge { label: e.label, target: replacement }
}

type PathSplit {
  init: List<Symbol>
  last: Symbol
  first: Bool
}

fn split_path_steps(root: Node, steps: List<Symbol>) -> Outcome<PathSplit> {
  if is_empty(xs: steps) {
    outcome_rejected(d: path_unresolvable_diagnostic(at: root))
  } else {
    outcome_accepted(value: fold_list(
      xs: steps,
      empty: PathSplit { init: [], last: path_unresolvable_reason, first: true },
      cons: fn(split, step) {
        match split.first {
          true => PathSplit { init: [], last: step, first: false }
          false => PathSplit {
            init: list_push(split.init, split.last),
            last: step,
            first: false
          }
        }
      }
    ))
  }
}

// 🟢 grounded — D1 child replacement when `name_occurrences` proves exactly one named edge.
fn rebuild_node_with_child(root: Node, name: Symbol, child: Node) -> Outcome<Node> {
  if name_occurrences(name: name, children: root.children) == 0 {
    outcome_rejected(d: path_unresolvable_diagnostic(at: root))
  } else if name_occurrences(name: name, children: root.children) == 1 {
    bind_outcome(
      o: fold(
        root.children,
        init: outcome_accepted(value: []),
        f: fn(acc_outcome, edge) {
          bind_outcome(
            o: acc_outcome,
            f: fn(current_acc) {
              match edge.label {
                Named { name: edge_name } =>
                  let next_edge = match edge_name == name {
                    true => replace_edge_target(e: edge, replacement: child)
                    false => edge
                  }
                  outcome_accepted(value: list_push(current_acc, next_edge))
                Positional => outcome_accepted(value: list_push(current_acc, edge))
              }
            }
          )
        }
      ),
      f: fn(new_children) {
        outcome_accepted(value: Node { kind: root.kind, children: new_children })
      }
    )
  } else {
    outcome_rejected(d: path_ambiguous_diagnostic(at: root))
  }
}

type AncestorFrame {
  ancestor: Node
  step: Symbol
}

type AncestorWalk {
  current: Node
  frames: List<AncestorFrame>
}

fn collect_ancestor_frames(root: Node, steps: List<Symbol>) -> Outcome<AncestorWalk> {
  fold_list(
    xs: steps,
    empty: outcome_accepted(value: AncestorWalk { current: root, frames: [] }),
    cons: fn(walk_outcome, step) {
      bind_outcome(
        o: walk_outcome,
        f: fn(walk) {
          bind_outcome(
            o: find_child_by_name(root: walk.current, name: step),
            f: fn(child) {
              outcome_accepted(value: AncestorWalk {
                current: child,
                frames: Cons {
                  head: AncestorFrame { ancestor: walk.current, step: step },
                  tail: walk.frames
                }
              })
            }
          )
        }
      )
    }
  )
}

fn thread_up_with_ancestor_frame(acc_outcome: Outcome<Node>, frame: AncestorFrame) -> Outcome<Node> {
  bind_outcome(
    o: acc_outcome,
    f: fn(child) {
      rebuild_node_with_child(
        root: frame.ancestor,
        name: frame.step,
        child: child
      )
    }
  )
}

fn thread_substitution_up(frames: List<AncestorFrame>, rebuilt_child: Node) -> Outcome<Node> {
  fold_list(
    xs: frames,
    empty: outcome_accepted(value: rebuilt_child),
    cons: thread_up_with_ancestor_frame
  )
}

fn substitute_at(root: Node, path: Path, replacement: Node) -> Outcome<Node> {
  if is_empty(xs: path.steps) {
    outcome_accepted(value: replacement)
  } else {
    bind_outcome(
      o: split_path_steps(root: root, steps: path.steps),
      f: fn(split) {
        bind_outcome(
          o: collect_ancestor_frames(root: root, steps: split.init),
          f: fn(walk) {
            bind_outcome(
              o: rebuild_node_with_child(
                root: walk.current,
                name: split.last,
                child: replacement
              ),
              f: fn(rebuilt_leaf) {
                thread_substitution_up(frames: walk.frames, rebuilt_child: rebuilt_leaf)
              }
            )
          }
        )
      }
    )
  }
}

fn apply_edit(root: Node, edit: Edit) -> Outcome<Node> {
  substitute_at(root: root, path: edit.at, replacement: edit.replacement)
}

fn apply_diff_edits(root: Node, edits: List<Edit>) -> Outcome<Node> {
  fold_list(
    xs: edits,
    empty: outcome_accepted(value: root),
    cons: fn(acc, edit) {
      bind_outcome(
        o: acc,
        f: fn(candidate) {
          apply_edit(root: candidate, edit: edit)
        }
      )
    }
  )
}

// All-or-nothing sequential rewrite program (P2 finding 2 / PR #3162).
fn apply_diff(root: Node, d: Diff) -> Outcome<Node> {
  apply_diff_edits(root: root, edits: d.edits)
}

// 🟡 gated — feature:section-ref-to-subject-projection — bind: TASKS.md T-23 follow-on wire —
// dissolve-on-arrival: resolve `DeclarationScope` / `NodeScope` to the bounded sub-`Node` the
// lens reads (declaration body sub-DAG or expression subtree); forbidden: decorative `SectionRef`
// parameters with whole-graph `read(root)` while claiming section-scoped application.
fn section_subject(root: Node, section: SectionRef) -> Outcome<Node> {
  match section {
    DeclarationScope { declaration: _ } => outcome_accepted(value: root)
    NodeScope { declaration: _, node: _ } => outcome_accepted(value: root)
  }
}

// Introspect substrate entry — Lens<Output> only (design-lens-application-surface §2).
fn apply_lens<Output>(
  lens: Lens<Output>,
  section: SectionRef,
  root: Node
) -> Outcome<Output> {
  bind_outcome(
    o: section_subject(root: root, section: section),
    f: fn(subject) {
      lens.read(root: subject)
    }
  )
}

// Enforce substrate entry — EnforceableLens + declared budget (design §2 EnforcedApplication).
fn apply_lens_enforce<Output, Budget, Projected>(
  enforceable: EnforceableLens<Output, Budget, Projected>,
  section: SectionRef,
  root: Node,
  budget: Budget,
  diagnostic_severity: DiagnosticSeverity
) -> Outcome<Output> {
  bind_outcome(
    o: section_subject(root: root, section: section),
    f: fn(subject) {
      bind_outcome(
        o: enforceable.lens.read(root: subject),
        f: fn(lens_output) {
          let projected = enforceable.enforcement.project(output: lens_output)
          if enforceable.enforcement.violates(projected: projected, declared: budget) {
            outcome_rejected(d: lens_enforcement_violation_diagnostic(at: subject))
          } else {
            outcome_accepted(value: lens_output)
          }
        }
      )
    }
  )
}

type ReportDiagnosticsFold {
  started: Bool
  acc: NonEmptyDiagnostics
}

fn advisory_reports_empty_diagnostic(at: Node) -> Diagnostic {
  Diagnostic {
    reason: advisory_reports_empty_reason,
    at: node_locus(node: at),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn reports_to_non_empty_diagnostics(
  reports: List<Report>,
  at: Node
) -> Outcome<NonEmptyDiagnostics> {
  if is_empty(xs: reports) {
    outcome_rejected(d: advisory_reports_empty_diagnostic(at: at))
  } else {
    outcome_accepted(value: fold_list(
      xs: reports,
      empty: ReportDiagnosticsFold {
        started: false,
        acc: diagnostics_singleton(d: advisory_reports_empty_diagnostic(at: at))
      },
      cons: fn(state, report) {
        match state.started {
          false => ReportDiagnosticsFold {
            started: true,
            acc: diagnostics_singleton(d: advisory_report_diagnostic(report: report))
          }
          true => ReportDiagnosticsFold {
            started: true,
            acc: non_empty_diagnostics_append(
              a: state.acc,
              b: diagnostics_singleton(d: advisory_report_diagnostic(report: report))
            )
          }
        }
      }
    ).acc)
  }
}

// THE single advisory→fail-closed bridge: non-empty advisory reports ⇒ Rejected diagnostics.
fn apply_advisory_lens(
  lens: AdvisoryLens,
  section: SectionRef,
  root: Node,
  config: LensApplicationConfig<Report, Report, Report>
) -> Outcome<List<Report>> {
  bind_outcome(
    o: section_subject(root: root, section: section),
    f: fn(subject) {
      let reports = lens.read(root: subject)
      match config {
        LensIntrospect => outcome_accepted(value: reports)
        LensEnforce { budget: _, diagnostic_severity: _ } =>
          if is_empty(xs: reports) {
            outcome_accepted(value: reports)
          } else {
            bind_outcome(
              o: reports_to_non_empty_diagnostics(reports: reports, at: subject),
              f: fn(diagnostics) {
                Rejected { diagnostics: diagnostics }
              }
            )
          }
      }
    }
  )
}
