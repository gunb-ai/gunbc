// src/v4/lens/subsumption.dag
// Scope: dissolution-lens subsumption ordering carrier for root fixes that mechanically close leaf fixes.
// Owns: DiffId, TestClaimId, ProducerStageId, SubsumptionVerification, DissolutionSubsumption, concept_home_rewrite_subsumption.
// Consumes: v4.std.collection, v4.std.node.
// Status: scaffold — producer-stage row lands first; MechanicalReverification rows wait for lens-CI runtime.

module v4.lens.subsumption


import v4.std.collection { List, Set }
import v4.std.node { Symbol }


data concept_home_rewrite_root_fix: Symbol = concept_home_rewrite_root_fix
data wrong_home_alias_leaf_fix: Symbol = wrong_home_alias_leaf_fix
data duplicate_home_leaf_fix: Symbol = duplicate_home_leaf_fix
data concept_home_producer_stage: Symbol = concept_home_producer_stage


type DiffId {
  id: Symbol
}


type TestClaimId {
  id: Symbol
}


type ProducerStageId {
  id: Symbol
}


// 🟡 coproduct dissolution — feature:lens-subsumption-mechanical-runtime.
type SubsumptionVerification
  = MechanicalReverification { test_claim: TestClaimId }
  | ProducerStageDerivation { derivation_path: List<ProducerStageId> }


type DissolutionSubsumption {
  root_fix: DiffId
  subsumed_fixes: Set<DiffId>
  verification: SubsumptionVerification
}


fn concept_home_subsumed_fixes() -> Set<DiffId> {
  Set {
    member: fn(fix) {
      (fix.id == wrong_home_alias_leaf_fix) || (fix.id == duplicate_home_leaf_fix)
    }
  }
}


data concept_home_rewrite_subsumption: DissolutionSubsumption = {
  root_fix: DiffId { id: concept_home_rewrite_root_fix },
  subsumed_fixes: concept_home_subsumed_fixes(),
  verification: ProducerStageDerivation {
    derivation_path: [
      ProducerStageId { id: concept_home_producer_stage }
    ]
  }
}
