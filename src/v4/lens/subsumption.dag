// src/v4/lens/subsumption.dag
// Scope: dissolution-lens subsumption ordering rows for root fixes that mechanically close leaf fixes.
// Owns: DiffId, TestClaimId, ProducerStageId, SubsumptionVerification, DissolutionSubsumption, affected_set_irt1_subsumption.
// Consumes: v4.std.collection, v4.std.node.
// Status: scaffold; Lens-CI host runtime accepts structural row mirrors until TestClaim execution owns these rows.

module v4.lens.subsumption


import v4.std.collection { List }
import v4.std.node { Symbol }


data affected_set_irt1_frontier_root_fix: Symbol = affected_set_irt1_frontier_root_fix
data affected_set_hash_receipt_leaf_fix: Symbol = affected_set_hash_receipt_leaf_fix
data affected_set_boundary_receipt_leaf_fix: Symbol = affected_set_boundary_receipt_leaf_fix
data affected_set_dimension_receipt_leaf_fix: Symbol = affected_set_dimension_receipt_leaf_fix
data affected_set_propagation_receipt_leaf_fix: Symbol = affected_set_propagation_receipt_leaf_fix
data affected_set_frontier_receipt_leaf_fix: Symbol = affected_set_frontier_receipt_leaf_fix
data affected_set_irt1_mechanical_reverification_claim: Symbol = affected_set_irt1_mechanical_reverification_claim


type DiffId {
  id: Symbol
}


type TestClaimId {
  id: Symbol
}


type ProducerStageId {
  id: Symbol
}


type SubsumedFixes {
  first: DiffId
  rest: List<DiffId>
}


// 🟡 coproduct dissolution — feature:lens-subsumption-mechanical-runtime; task:node://adhoc-0a13e0b0-dff; dissolve-on:.dag TestClaim runner consumes MechanicalReverification rows.
type SubsumptionVerification
  = MechanicalReverification { test_claim: TestClaimId }
  | ProducerStageDerivation { derivation_path: List<ProducerStageId> }


type DissolutionSubsumption {
  root_fix: DiffId
  subsumed_fixes: SubsumedFixes
  verification: SubsumptionVerification
}


data affected_set_irt1_subsumed_fixes: SubsumedFixes = SubsumedFixes {
  first: DiffId { id: affected_set_hash_receipt_leaf_fix },
  rest: [
    DiffId { id: affected_set_boundary_receipt_leaf_fix },
    DiffId { id: affected_set_dimension_receipt_leaf_fix },
    DiffId { id: affected_set_propagation_receipt_leaf_fix },
    DiffId { id: affected_set_frontier_receipt_leaf_fix }
  ]
}


data affected_set_irt1_subsumption: DissolutionSubsumption = {
  root_fix: DiffId { id: affected_set_irt1_frontier_root_fix },
  subsumed_fixes: affected_set_irt1_subsumed_fixes,
  verification: MechanicalReverification {
    test_claim: TestClaimId { id: affected_set_irt1_mechanical_reverification_claim }
  }
}
