// src/v4/lens/idempotency.dag
//
// Scope: idempotency lens — algebraic-law-derived; redundant ops collapse structurally.
// Anchor: https://en.wikipedia.org/wiki/Idempotence
// Unifies: (per THESIS:188) idempotency + cancellation + redundancy = algebraic simplification. Three named runtime concerns are ONE mechanism. A worker hitting "I need cancellation" or "I need redundancy detection" extends THIS lens, not new lens/cancellation.dag or lens/redundancy.dag.
//
// Owns:
//   - lens read: Node -> Witness<IdempotencyClaim>
//   - composes with std/algebra.dag for law-derived simplification
//
// Consumes:
//   - std/node.dag, std/algebra.dag, std/witness.dag
//
// Status: scaffold — fill per TASKS.md T-13
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.lens.idempotency

import v4.compiler.infer { InferredTree }
import v4.lens.effect {
  EffectDependencyFact,
  effect_dependency_fact_eq,
  effect_fact_from_dependencies
}
import v4.std.dependency {
  BarrierBefore,
  DataDependsOn,
  DependencyView,
  EffectDependsOn,
  ResourceDependsOn
}
import v4.std.node { Node }
import v4.std.witness { Holds, Witness }

// 🟢 projection carrier — idempotency/cancellation/redundancy read the
// effect projection and algebraic laws; this slice preserves one lens
// mechanism and avoids a parallel cancellation taxonomy.
type IdempotencyVerdict
  = Idempotent
  | NonIdempotent
  | RequiresAlgebraWitness

type IdempotencyEffectFact {
  at: Node
  effect: EffectDependencyFact
  verdict: IdempotencyVerdict
}

type IdempotencyFact {
  effects: List<IdempotencyEffectFact>
}

fn idempotency_verdict_for_effect(effect: EffectDependencyFact) -> IdempotencyVerdict {
  match effect.dependency.kind {
    DataDependsOn => Idempotent
    BarrierBefore => Idempotent
    EffectDependsOn => RequiresAlgebraWitness
    ResourceDependsOn => RequiresAlgebraWitness
    _ => Idempotent
  }
}

fn idempotency_effect_fact(effect: EffectDependencyFact) -> IdempotencyEffectFact {
  IdempotencyEffectFact {
    at: effect.at,
    effect: effect,
    verdict: idempotency_verdict_for_effect(effect: effect)
  }
}

fn idempotency_fact(tree: InferredTree, dependencies: List<DependencyView>) -> IdempotencyFact {
  let effects = effect_fact_from_dependencies(tree: tree, dependencies: dependencies)
  IdempotencyFact {
    effects: fold(effects.dependencies, init: [], f: fn(acc, effect) {
      list_push(acc, idempotency_effect_fact(effect: effect))
    })
  }
}

fn idempotency_witness(tree: InferredTree, dependencies: List<DependencyView>) -> Witness<IdempotencyFact> {
  Holds {
    value: idempotency_fact(tree: tree, dependencies: dependencies)
  }
}

fn idempotency_verdict_eq(a: IdempotencyVerdict, b: IdempotencyVerdict) -> Bool {
  match a {
    Idempotent => match b {
      Idempotent => true
      _ => false
    }
    NonIdempotent => match b {
      NonIdempotent => true
      _ => false
    }
    RequiresAlgebraWitness => match b {
      RequiresAlgebraWitness => true
      _ => false
    }
  }
}

fn idempotency_effect_fact_eq(a: IdempotencyEffectFact, b: IdempotencyEffectFact) -> Bool {
  (a.at == b.at)
    && effect_dependency_fact_eq(a: a.effect, b: b.effect)
    && idempotency_verdict_eq(a: a.verdict, b: b.verdict)
}

fn idempotency_effect_count(xs: List<IdempotencyEffectFact>, item: IdempotencyEffectFact) -> Int {
  fold(xs, init: 0, f: fn(acc, candidate) {
    if idempotency_effect_fact_eq(a: candidate, b: item) {
      acc + 1
    } else {
      acc
    }
  })
}

fn idempotency_effect_facts_eq(
  left: List<IdempotencyEffectFact>,
  right: List<IdempotencyEffectFact>
) -> Bool {
  if count(left) != count(right) {
    false
  } else {
    fold(left, init: true, f: fn(acc, item) {
      acc && (idempotency_effect_count(xs: left, item: item) == idempotency_effect_count(xs: right, item: item))
    })
  }
}

fn idempotency_fact_eq(a: IdempotencyFact, b: IdempotencyFact) -> Bool {
  idempotency_effect_facts_eq(left: a.effects, right: b.effects)
}
