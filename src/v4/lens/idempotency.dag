// src/v4/lens/idempotency.dag
// Scope: idempotency lens — algebraic-law-derived; redundant ops collapse structurally (THESIS:188 — idempotency + cancellation + redundancy = algebraic simplification).
// Owns: IdempotencyVerdict, IdempotencyFact, idempotency_witness, idempotency_classify.
// Consumes: v4.std.algebra (bag_eq), v4.std.dependency (ClassifiedDependencyView<C>), v4.std.witness, v4.compiler.infer.
// Status: T-13 family ratchet — projection-only over `List<DependencyView>` via parametric `ClassifiedDependencyView<IdempotencyVerdict>`; no copied endpoints, no nested per-row EffectDependencyFact (Practice 11 sub-rule: parallel-payload vs typed-reference). The algebra-law witness is the verdict payload itself; the dependency-edge identity authority is `ClassifiedDependencyView.dependency`.


module v4.lens.idempotency

import v4.compiler.infer { InferredFacts, InferredTree }
import v4.std.algebra { bag_eq, list_snoc_item }
import v4.std.collection {
  List,
  Optional,
  optional_diagnostic_absent,
  optional_diagnostic_present
}
import v4.std.dependency {
  BarrierBefore,
  BindsTo,
  BootstrapDependsOn,
  ClassifiedDependencyView,
  Contains,
  DataDependsOn,
  DependencyView,
  EffectDependsOn,
  GeneratedFrom,
  ModelDependsOn,
  ModuleDependsOn,
  PlacementDependsOn,
  ProjectionDependsOn,
  PromotedBy,
  ResourceDependsOn,
  TypeDependsOn,
  VerifiedBy,
  classified_dependency_view_eq
}
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v4.std.logic { Bool }
import v4.std.node { Symbol }
import v4.std.witness { Holds, Violates, Witness }

data idempotency_reason_unresolved_projection: Symbol = idempotency_reason_unresolved_projection
data idempotency_projection_virtual_file: Symbol = idempotency_projection_virtual_file

// 🟢 lens classification — dependency-edge alone never proves the positive
// algebraic law, so `RequiresAlgebraWitness` is the fail-closed default;
// `AlgebraicIdempotenceProven` carries the typed law witness on the row.
type IdempotencyVerdict
  = AlgebraicIdempotenceProven { law: Witness<InferredFacts> }
  | RequiresAlgebraWitness

type IdempotencyFact {
  dependencies: List<ClassifiedDependencyView<IdempotencyVerdict>>
}

fn idempotency_verdict_for_dependency(view: DependencyView) -> IdempotencyVerdict {
  match view.kind {
    Contains => RequiresAlgebraWitness
    BindsTo => RequiresAlgebraWitness
    TypeDependsOn => RequiresAlgebraWitness
    DataDependsOn => RequiresAlgebraWitness
    BarrierBefore => RequiresAlgebraWitness
    EffectDependsOn => RequiresAlgebraWitness
    ResourceDependsOn => RequiresAlgebraWitness
    ModuleDependsOn => RequiresAlgebraWitness
    PlacementDependsOn => RequiresAlgebraWitness
    ModelDependsOn => RequiresAlgebraWitness
    ProjectionDependsOn => RequiresAlgebraWitness
    GeneratedFrom => RequiresAlgebraWitness
    VerifiedBy => RequiresAlgebraWitness
    PromotedBy => RequiresAlgebraWitness
    BootstrapDependsOn => RequiresAlgebraWitness
  }
}

fn idempotency_classify(view: DependencyView) -> ClassifiedDependencyView<IdempotencyVerdict> {
  ClassifiedDependencyView {
    dependency: view,
    classification: idempotency_verdict_for_dependency(view: view)
  }
}

fn idempotency_fact(tree: InferredTree, dependencies: List<DependencyView>) -> IdempotencyFact {
  IdempotencyFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_snoc_item(xs: acc, item: idempotency_classify(view: view))
    })
  }
}

// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature:T-13-idempotency-verdict-unresolved — dissolve-on-arrival: substrate projects IdempotencyVerdict resolved/unresolved from coproduct; forbidden: parallel ad-hoc IdempotencyVerdict Bool predicates outside idempotency_witness.
fn idempotency_verdict_unresolved(verdict: IdempotencyVerdict) -> Bool {
  match verdict {
    RequiresAlgebraWitness => true
    AlgebraicIdempotenceProven { law: law } =>
      match law {
        Holds { value: _ } => false
        Violates { diagnostic: _ } => true
      }
  }
}

fn idempotency_first_law_violation_diagnostic(fact: IdempotencyFact) -> Optional<Diagnostic> {
  fold(fact.dependencies, init: optional_diagnostic_absent(), f: fn(acc, dep) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match dep.classification {
          AlgebraicIdempotenceProven { law: Violates { diagnostic: d } } =>
            optional_diagnostic_present(diagnostic: d)
          _ => optional_diagnostic_absent()
        }
    }
  })
}

fn idempotency_fact_unresolved(fact: IdempotencyFact) -> Bool {
  fold(fact.dependencies, init: false, f: fn(acc, dep) {
    acc || idempotency_verdict_unresolved(verdict: dep.classification)
  })
}

fn idempotency_witness_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: idempotency_reason_unresolved_projection,
    at: Textual { file: idempotency_projection_virtual_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn idempotency_witness(tree: InferredTree, dependencies: List<DependencyView>) -> Witness<IdempotencyFact> {
  let fact = idempotency_fact(tree: tree, dependencies: dependencies)
  match idempotency_first_law_violation_diagnostic(fact: fact) {
    Present { value: d } =>
      Violates { diagnostic: d }
    Absent =>
      if idempotency_fact_unresolved(fact: fact) {
        Violates { diagnostic: idempotency_witness_diagnostic() }
      } else {
        Holds { value: fact }
      }
  }
}

fn idempotency_verdict_eq(a: IdempotencyVerdict, b: IdempotencyVerdict) -> Bool {
  match a {
    AlgebraicIdempotenceProven { law: a_law } => match b {
      AlgebraicIdempotenceProven { law: b_law } => a_law == b_law
      _ => false
    }
    RequiresAlgebraWitness => match b {
      RequiresAlgebraWitness => true
      _ => false
    }
  }
}

fn idempotency_classified_eq(
  a: ClassifiedDependencyView<IdempotencyVerdict>,
  b: ClassifiedDependencyView<IdempotencyVerdict>
) -> Bool {
  classified_dependency_view_eq(a: a, b: b, classification_eq: idempotency_verdict_eq)
}

fn idempotency_fact_eq(a: IdempotencyFact, b: IdempotencyFact) -> Bool {
  bag_eq(xs: a.dependencies, ys: b.dependencies, eq: idempotency_classified_eq)
}
