// Scope: shared observation helper for affected_set frontier receipts.
// A ReExecFrontier carries `decisions: Map<ExclusionKey, FrontierDecision>`, and
// std Map IS a PartialFunction (v4.std.collection: `lookup: fn(K) -> Witness<V>`).
// Over structural (non-String) keys the v2 runtime represents that Map in its
// closure/record form, which has NO decidable structural `==` — two structurally
// identical maps compare false (even a value vs. itself). So a frontier receipt
// must OBSERVE the map by application (look the key up and compare the resolved
// FrontierDecision), never assert whole-frontier `==`. FrontierDecision is a
// coproduct over lists/records, which DO compare structurally, so the resolved
// decision is a sound equality target.

module v4.test.lens_affected_set.frontier_observation

import v4.lens.affected_set { ChangedSubgraphFrontier, ExclusionKey, FailClosed, FrontierDecision, ReExecFrontier }
import v4.std.collection { Absent, Present, map_get }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }

fn frontier_decision_matches(frontier: ReExecFrontier, key: ExclusionKey, expected: FrontierDecision) -> Bool {
  match frontier {
    ChangedSubgraphFrontier { boundary_exclusions: _, decisions: decisions } =>
      match map_get(decisions, key) {
        Accepted { value: opt, diagnostics: _ } =>
          match opt {
            Present { value: decision } => decision == expected
            Absent => false
          }
        Rejected { diagnostics: _ } => false
      }
    FailClosed { reason: _ } => false
  }
}
