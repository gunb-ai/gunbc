// src/v4/lens/edit_locus.dag
// Scope: git diff name-only paths → substrate Node edit_locus for affected_set (T-21 wire).
// Owns: RepoPath, GitDiffNameOnly, PathRegex, EditLocusBinding, EditLocusRead,
//       resolve_edit_locus, affected_set_reading_from_git_diff.
// Consumes: v4.compiler.infer, v4.lens.affected_set, v4.std.artifact, v4.std.algebra,
//           v4.std.collection, v4.std.diagnostic, v4.std.node, v4.std.text, v4.std.witness.
// Status: Wave-0 — path-regex match authority injected via EditLocusRead until
//   Q-Regex-Primitive; dissolves scripts/detect-affected-components.sh path buckets.

module v4.lens.edit_locus

import v4.compiler.infer { InferredTree }
import v4.lens.affected_set { AffectedSetReading, affected_set }
import v4.std.artifact { Artifact, NodeArtifactProvenance }
import v4.std.algebra { count_equal, length }
import v4.std.collection { List }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Unavailable,
  node_locus
}
import v4.std.node { Conj, Node, Symbol, TypeNode }
import v4.std.text { String }
import v4.std.witness { Holds, Violates, Witness }


// Wave-0: git name-only paths are Symbols at the substrate boundary; host projection
// from `git diff --name-only` String output supplies the symbol table.
type RepoPath = Symbol

// Structural mirror of `git diff --name-only` (single authority for changed paths).
type GitDiffNameOnly {
  changed_paths: List<RepoPath>
}

// Path-regex pattern id — match semantics live in EditLocusRead until regex substrate lands.
type PathRegex = Symbol

type EditLocusBinding {
  pattern: PathRegex
  locus: Node
}

// Injected match authority: no hand-maintained path-regex in workflow YAML (Gate #103).
type EditLocusRead {
  path_regex_matches: fn(RepoPath, PathRegex) -> Bool,
  artifact_path_matches_changed: fn(RepoPath, String) -> Bool
}

data edit_locus_reason_no_match: Symbol = edit_locus_reason_no_match
data edit_locus_reason_ambiguous: Symbol = edit_locus_reason_ambiguous


fn edit_locus_no_match_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: edit_locus_reason_no_match,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Conj },
      children: []
    }),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn edit_locus_ambiguous_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: edit_locus_reason_ambiguous,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Conj },
      children: []
    }),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn node_eq(left: Node, right: Node) -> Bool {
  left == right
}


fn push_locus_if_absent(acc: List<Node>, locus: Node) -> List<Node> {
  if count_equal(xs: acc, item: locus, eq: node_eq) == 0 {
    list_push(acc, locus)
  } else {
    acc
  }
}


fn loci_from_bindings_for_path(
  read: EditLocusRead,
  changed: RepoPath,
  bindings: List<EditLocusBinding>,
  acc: List<Node>
) -> List<Node> {
  fold(bindings, init: acc, f: fn(acc2, binding) {
    if read.path_regex_matches(changed: changed, pattern: binding.pattern) {
      push_locus_if_absent(acc: acc2, locus: binding.locus)
    } else {
      acc2
    }
  })
}


fn loci_from_provenance_for_path(
  read: EditLocusRead,
  changed: RepoPath,
  provenance: List<NodeArtifactProvenance>,
  acc: List<Node>
) -> List<Node> {
  fold(provenance, init: acc, f: fn(acc2, row) {
    if read.artifact_path_matches_changed(changed: changed, file_path: row.artifact.file_path) {
      push_locus_if_absent(acc: acc2, locus: row.node)
    } else {
      acc2
    }
  })
}


fn collect_edit_loci(
  read: EditLocusRead,
  git_diff: GitDiffNameOnly,
  bindings: List<EditLocusBinding>,
  provenance: List<NodeArtifactProvenance>
) -> List<Node> {
  fold(git_diff.changed_paths, init: [], f: fn(acc, changed) {
    let with_bindings = loci_from_bindings_for_path(
      read: read,
      changed: changed,
      bindings: bindings,
      acc: acc
    )
    loci_from_provenance_for_path(
      read: read,
      changed: changed,
      provenance: provenance,
      acc: with_bindings
    )
  })
}


fn list_head_node(nodes: List<Node>) -> Node {
  match nodes {
    Empty =>
      Node {
        kind: TypeNode { connective: Conj },
        children: []
      }
    Cons { head: head, tail: _ } => head
  }
}


fn resolve_edit_locus(
  read: EditLocusRead,
  git_diff: GitDiffNameOnly,
  bindings: List<EditLocusBinding>,
  provenance: List<NodeArtifactProvenance>
) -> Witness<Node> {
  let loci = collect_edit_loci(
    read: read,
    git_diff: git_diff,
    bindings: bindings,
    provenance: provenance
  )
  match length(xs: loci) {
    0 =>
      Violates { diagnostic: edit_locus_no_match_diagnostic() }
    1 =>
      Holds { value: list_head_node(nodes: loci) }
    _ =>
      Violates { diagnostic: edit_locus_ambiguous_diagnostic() }
  }
}


fn affected_set_reading_from_git_diff(
  edit_read: EditLocusRead,
  graph: InferredTree,
  git_diff: GitDiffNameOnly,
  bindings: List<EditLocusBinding>,
  provenance: List<NodeArtifactProvenance>
) -> AffectedSetReading {
  match resolve_edit_locus(
    read: edit_read,
    git_diff: git_diff,
    bindings: bindings,
    provenance: provenance
  ) {
    Holds { value: locus } =>
      affected_set(graph: graph, edit_locus: locus)
    Violates { diagnostic: _ } =>
      AffectedSetReading {
        edit_locus: Node {
          kind: TypeNode { connective: Conj },
          children: []
        },
        affected: [],
        dependencies: []
      }
  }
}
