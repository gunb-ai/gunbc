// Fact anchor: rust.dag declares surface spelling + coercion edge for i32.
data rust_r1_claim_surface_spelling_fact: Symbol = rust_surface_spelling_i32
data rust_r1_claim_coercion_spelling_edge: Symbol = rust_coercion_field_i32_spelling

// Fixture embeds the spelled type + literal suffix so rustc is the external authority.
data rust_r1_happy_fixture_source: String = "pub fn r1_test() -> i32 { 0i32 }\n"

data rust_r1_falsification_fixture_source: String = "pub fn r1_test() -> i32 { \"string\" }\n"


fn rust_r1_happy_fixture() -> LeafModelRustFixture {
  LeafModelRustFixture {
    source: rust_r1_happy_fixture_source,
    crate_type: leaf_model_rust_crate_type_lib
  }
}


fn rust_r1_falsification_fixture() -> LeafModelRustFixture {
  LeafModelRustFixture {
    source: rust_r1_falsification_fixture_source,
    crate_type: leaf_model_rust_crate_type_lib
  }
}


fn rust_r1_fixture_pair() -> LeafModelFixturePair {
  LeafModelFixturePair {
    claim_id: leaf_model_claim_rust_r1_i32_surface_spelling,
    surface_spelling_fact: rust_r1_claim_surface_spelling_fact,
    coercion_spelling_fact: rust_r1_claim_coercion_spelling_edge,
    happy: rust_r1_happy_fixture(),
    expected_happy_verdict: TargetCompileAccepted,
    falsification: LeafModelFalsificationCase {
      fixture: rust_r1_falsification_fixture(),
      expected_verdict: TargetCompileRejected {
        diagnostic_code: target_diagnostic_e0308_type_mismatch
      }
    }
  }
}


// Testgen port: `rust_r1_fixture` (docs/planning/v4-leaf-model-verification-2026-05-30.md §8).
fn rust_r1_fixture() -> LeafModelFixturePair {
  rust_r1_fixture_pair()
}

