    claim_id: leaf_model_claim_ts_r2b_bigint_beyond_safe_integer,
    surface_spelling_fact: typescript_r2b_claim_algebra_inhabitance_fact,
    encoding_spelling_fact: typescript_r2b_claim_algebra_inhabitance_fact,
    happy: typescript_r2b_runtime_happy_fixture(),
    expected_happy_verdict: TargetTypeScriptRuntimeAccepted,
    falsification: typescript_r2b_runtime_falsification_fixture(),
    // Divergence probe succeeds at runtime (exit 0) when bigint exact ≠ number-lane false positive.
    expected_falsification_verdict: TargetTypeScriptRuntimeAccepted
  }
}

