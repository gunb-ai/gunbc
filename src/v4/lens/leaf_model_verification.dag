// R3-internal — Symbol TargetAtomRealization row mutation must move type + value projections together (PR #3971 §4).
data rust_r3_internal_claim_atom_realization_fact: Symbol = rust_atom_realization_symbol

data rust_r3_internal_probe_symbol_identity: Symbol = rust_r3_internal_probe_symbol_identity

data rust_r3_internal_mutated_type_spelling: Symbol = rust_r3_internal_mutated_type_spelling

data rust_r3_internal_emit_kind_symbol_to_owned_string: Symbol = rust_r3_internal_emit_kind_symbol_to_owned_string

data rust_r3_internal_emit_kind_symbol_identity: Symbol = rust_r3_internal_emit_kind_symbol_identity

data rust_r3_internal_emit_kind_rejected: Symbol = rust_r3_internal_emit_kind_rejected

data rust_r3_internal_mutated_row: TargetAtomRealization = TargetAtomRealization {
  source_carrier: symbol_kernel_type_node(),
  target_model: rust_mvp1_target_model_staging(),
  type_form: rust_target_atom_type_form(spelling: rust_r3_internal_mutated_type_spelling),
  value_form: target_value_template_for_kind(kind: ValueSymbolIdentityPassthrough),
  constructor_form: optional_absent(),
  display_name: symbol_kernel_type_atom
}

fn rust_r3_internal_value_emit_kind_label(row: TargetAtomRealization) -> Symbol {
  let probe = source_atom_symbol(identity: rust_r3_internal_probe_symbol_identity)
  match target_atom_value_expression(row: row, value: probe) {
    Accepted { value: expr } =>
      match expr.kind {
        TargetValueExprSymbolToOwnedString => rust_r3_internal_emit_kind_symbol_to_owned_string
        TargetValueExprSymbolIdentity => rust_r3_internal_emit_kind_symbol_identity
        _ => rust_r3_internal_emit_kind_rejected
      }
    Rejected { diagnostics: _ } => rust_r3_internal_emit_kind_rejected
  }
}

data rust_r3_internal_baseline_type_emit: Symbol = target_atom_type_spelling(row: rust_target_atom_realization_symbol)

data rust_r3_internal_mutated_type_emit: Symbol = target_atom_type_spelling(row: rust_r3_internal_mutated_row)

data rust_r3_internal_baseline_value_emit_kind: Symbol = rust_r3_internal_value_emit_kind_label(row: rust_target_atom_realization_symbol)

data rust_r3_internal_mutated_value_emit_kind: Symbol = rust_r3_internal_value_emit_kind_label(row: rust_r3_internal_mutated_row)

fn rust_r3_internal_emit_coupling_both_projections_changed(receipt: LeafModelEmitCouplingReceipt) -> Bool {
  receipt.baseline_type_emit != receipt.mutated_type_emit
  && receipt.baseline_value_emit_kind != receipt.mutated_value_emit_kind
}

fn rust_r3_internal_emit_coupling_receipt() -> LeafModelEmitCouplingReceipt {
  LeafModelEmitCouplingReceipt {
    claim_id: leaf_model_claim_rust_r3_internal_symbol_coupling,
    atom_realization_fact: rust_r3_internal_claim_atom_realization_fact,
    baseline_type_emit: rust_r3_internal_baseline_type_emit,
    mutated_type_emit: rust_r3_internal_mutated_type_emit,
    baseline_value_emit_kind: rust_r3_internal_baseline_value_emit_kind,
    mutated_value_emit_kind: rust_r3_internal_mutated_value_emit_kind
  }
}

fn rust_r3_internal_fixture() -> LeafModelEmitCouplingReceipt {
  rust_r3_internal_emit_coupling_receipt()
}

// --- PY-L1-STATIC-STRUCTURAL fixtures (Arbiter ruling proud-fox-405, msg_41813c03) ---
// F1 demonstration: the falsification fixture returns a `str` from a function annotated
// `-> int`. CPython `py_compile` ACCEPTS it and `python3` runs it with NO error
// (the value is never used), so neither the compile nor the runtime authority catches
// the defect — only static analysis (pyright `reportReturnType`) does. This is exactly
// why static structural analysis is a third, distinct authority.
data python_l1_static_happy_fixture_source: String = "def l1_test() -> int:\n    return 0\n"
data python_l1_static_falsification_fixture_source: String = "def l1_test() -> int:\n    return \"not an int\"\n"

fn python_l1_static_fixture_pair() -> LeafModelPythonStaticFixturePair {
  LeafModelPythonStaticFixturePair {
    claim_id: leaf_model_claim_python_l1_static_return_type,
    surface_spelling_fact: python_surface_spelling_int,
    happy: LeafModelPythonStaticHappyCase {
      artifact: TargetArtifact { source_text: python_l1_static_happy_fixture_source },
      tool_profile_ref: pyright_profile_l1_id
    },
    falsification: LeafModelPythonStaticFalsificationCase {
      artifact: TargetArtifact { source_text: python_l1_static_falsification_fixture_source },
      tool_profile_ref: pyright_profile_l1_id,
      tool_id: pyright_tool_id,
      diagnostic_code: pyright_diag_report_return_type
    }
  }
}

fn python_l1_static_fixture() -> LeafModelPythonStaticFixturePair {
  python_l1_static_fixture_pair()
}
