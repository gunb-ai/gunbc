// R2b — typed int64 overflow wraps at runtime (non-constant expression).
data go_r2b_claim_algebra_inhabitance_fact: Symbol = go_integer_algebra_inhabitance_go_facts_int64

data go_r2b_runtime_fixture_source: String = "package main\n\nfunc r2b_test(a int64, b int64) int64 { return a + b }\n\nfunc main() {\n\tvar max int64 = 1<<63 - 1\n\tvar min int64 = -1 << 63\n\tif r2b_test(max, 1) != min {\n\t\tpanic(\"go int64 overflow did not wrap to min int64\")\n\t}\n}\n"

fn go_r2b_runtime_fixture() -> LeafModelGoRuntimeFixture {
  LeafModelGoRuntimeFixture { source: go_r2b_runtime_fixture_source }
}

fn go_r2b_runtime_fixture_pair() -> LeafModelGoRuntimeFixturePair {
  LeafModelGoRuntimeFixturePair {
    claim_id: leaf_model_claim_go_r2b_int64_overflow_wrap,
    surface_spelling_fact: go_r2b_claim_algebra_inhabitance_fact,
    encoding_spelling_fact: go_r2b_claim_algebra_inhabitance_fact,
    happy: go_r2b_runtime_fixture(),
    expected_happy_verdict: TargetGoRuntimeAccepted,
    // Runtime observation succeeds when Go's non-constant int64 addition wraps to min int64.
    falsification: go_r2b_runtime_fixture(),
    expected_falsification_verdict: TargetGoRuntimeAccepted
  }
}

fn go_r2b_fixture() -> LeafModelGoRuntimeFixturePair {
  go_r2b_runtime_fixture_pair()
}

