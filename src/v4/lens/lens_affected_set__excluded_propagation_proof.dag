// Observation: ReExecFrontier.decisions is a std Map = PartialFunction with no decidable
// structural `==`; the receipt observes the frontier by application (frontier_decision_matches)
// and compares the resolved FrontierDecision, never whole-frontier `==`.

module v4.test.lens_affected_set.excluded_propagation_proof

import v4.lens.affected_set {
  DimensionNotRead,
  Excluded,
  ExclusionKey,
  FrontierDecision,
  PropagationExclusionProof,
  ReExecFrontier,
  empty_frontier,
  mark_excluded
}
import v4.lens.affected_set_examples {
  affected_set_example_node
}
import v4.test.lens_affected_set.frontier_observation { frontier_decision_matches }
import v4.std.logic { Bool }
import v4.std.node { Conj, Node, TypeNode, SyntheticOccurrence }
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data excluded_propagation_key: ExclusionKey = ExclusionKey {
  at: affected_set_example_node,
  dimension: ^affected_set_example_dimension
}

data excluded_propagation_proof: PropagationExclusionProof = DimensionNotRead {
  usage_site: affected_set_example_node,
  changed_dimension: ^affected_set_example_dimension
}

fn excluded_propagation_accumulated_frontier() -> ReExecFrontier {
  mark_excluded(
    frontier: mark_excluded(
      frontier: empty_frontier(),
      key: excluded_propagation_key,
      proof: excluded_propagation_proof
    ),
    key: excluded_propagation_key,
    proof: excluded_propagation_proof
  )
}

data expected_excluded_propagation_decision: FrontierDecision = Excluded {
  first: excluded_propagation_proof,
  rest: [excluded_propagation_proof]
}

fn excluded_propagation_proof_claim_holds() -> Bool {
  frontier_decision_matches(
    frontier: excluded_propagation_accumulated_frontier(),
    key: excluded_propagation_key,
    expected: expected_excluded_propagation_decision
  )
}

// Discrimination receipt (perturb-red, committed): one mark_excluded yields rest:[]
// (single proof), which must NOT match the accumulated expected decision rest:[proof].
// Holds == true proves frontier_decision_matches discriminates on Excluded.rest contents
// — i.e. it is a real structural comparison, not a tautology that ignores accumulation.
fn excluded_propagation_proof_discriminates() -> Bool {
  frontier_decision_matches(
    frontier: mark_excluded(
      frontier: empty_frontier(),
      key: excluded_propagation_key,
      proof: excluded_propagation_proof
    ),
    key: excluded_propagation_key,
    expected: expected_excluded_propagation_decision
  ) == false
}

fn excluded_propagation_proof_claim_rhs() -> Node {
  if excluded_propagation_proof_claim_holds() {
    affected_set_example_node
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}

data claim_excluded_propagation_proof: TestClaim = EqualsClaim {
  label: "lens_affected_set/excluded_propagation_proof: mark_excluded accumulates proofs in Excluded.rest",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: affected_set_example_node,
  rhs: excluded_propagation_proof_claim_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
