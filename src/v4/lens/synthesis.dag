// src/v4/lens/synthesis.dag
//
// Scope: cross-algorithm complexity lens — surface that the user's
//        realization's lens-DERIVED cost EXCEEDS the declared I/O
//        relation's structurally-derived complexity LOWER BOUND (a
//        provable GAP to the optimum). It does NOT construct, name, or
//        prove the existence of a specific faster program — the optimal
//        realization can be unknown (e.g. matmul ω) and fabricating one
//        would violate feedback_no_engine. Distinct from
//        lens/complexity.dag (same-algorithm tightness); synthesis
//        compares derived cost against the relation's lower bound via the
//        closed LowerBoundTechnique set (see Owns; C2 reframe 2026-05-15).
// Anchor: https://en.wikipedia.org/wiki/Program_synthesis +
//         docs/r4-carve-out-routing.md C7 (advisory carrier, NOT fail-closed
//         Diagnostic; algorithm choice is design-tier — programmer decides)
//
// Owns:
//   - lens read: Node -> Set<Report>  (advisory carrier, NEVER Witness —
//     Witness is strictly fail-closed per INVARIANTS P3/C-8; advisory
//     Report must not overload it. Empty set = no advice; non-empty =
//     advisory observations, never blocking unless user opts in via
//     apply_lens(synthesis, Enforce { ... }))
//   - the user's DECLARED I/O relation (the function's contract/type —
//     DECLARED, never inferred). There is NO program-to-program
//     equivalence: general I/O equivalence is Rice-undecidable, and
//     feedback_decidability_invariant forbids it. The collision is
//     dissolved by reading the declared relation, not proving equivalence.
//   - LowerBoundTechnique = CLOSED set (operator-ratified 2026-05-15, C2):
//       DecisionTree | AlgebraicRank | AdversaryCommunication
//       | InformationTheoretic | ReductionConditional
//     Each is a GENERAL algebraic property over a relation CLASS, encoded
//     ONCE. This is NOT a (naive→better) rule library — that is
//     engine-shaped and unbounded (feedback_no_engine). Adding the Nth
//     algorithm adds ZERO entries; the decision-tree theorem already
//     covers every comparison-decided relation, etc.
//   - compare(cost-lens-derived cost of the user's realization, the
//     declared relation's lower bound derived via the technique set)
//   - NO applicable technique for a relation class ⇒ a helpful Diagnostic
//     (feedback_no_engine — surfaced honestly with what is unmodeled;
//     NEVER a fabricated suggestion, NEVER a silent empty set)
//
// Discipline (per INVARIANTS C-8 + r4-carve-out-routing.md C7):
//   - The LENS itself is advisory (emits Report, not Diagnostic) — algorithm
//     choice is design-tier; programmer informed, programmer chooses
//   - A user's apply_lens(synthesis, Enforce { ... }) declaration converts
//     advisory Report into fail-closed Diagnostic per their policy choice
//   - Default policy: Introspect (advisory) per opt-in-depth discipline
//
// Consumes:
//   - std/node.dag, std/witness.dag, std/algebra.dag
//   - std/report.dag (advisory carrier)
//   - lens/complexity.dag (current-complexity input for cross-algorithm comparison)
//
// Status: T-17 filled.

module v4.lens.synthesis


import v4.lens.complexity {
  ComplexityBound,
  SizedLinearClass,
  SizedLinearithmicClass,
  complexity_lens,
  complexity_bound_class,
  single_complexity_variable,
  sized_complexity
}
import v4.lens.cost {
  ClassLinear,
  ClassLinearithmic,
  SizeVariable,
  asymptotic_class_dominates
}
import v4.std.algebra { Cons, Empty }
import v4.std.collection { List, list_append }
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Locus,
  Unavailable,
  node_locus
}
import v4.std.node { Node, Symbol }
import v4.std.report { Report, SynthesisGapDecisionTree, SynthesisGapInformationTheoretic }
import v4.std.witness { Holds, Violates }


data synthesis_no_technique_reason_symbol: Symbol = synthesis_no_technique_reason_symbol


// 🟢 coproduct — closed set. STOP-and-escalate if a 6th variant is needed.
type LowerBoundTechnique
  = DecisionTree
  | AlgebraicRank
  | AdversaryCommunication
  | InformationTheoretic
  | ReductionConditional

// 🟢 product — declared relation class + applicable technique.
type DeclaredRelationBound {
  technique: LowerBoundTechnique
  lower_bound: ComplexityBound
  relation_locus: Locus
}

// 🟢 coproduct — outcome of one synthesis probe.
type SynthesisOutcome
  = SynthesisGap {
      realization_cost: ComplexityBound
      lower_bound: DeclaredRelationBound
      report: Report
    }
  | SynthesisOptimal {
      realization_cost: ComplexityBound
      lower_bound: DeclaredRelationBound
    }
  | SynthesisNoTechnique {
      diagnostic: Diagnostic
    }


fn synthesis_no_technique_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: synthesis_no_technique_reason_symbol,
    at: node_locus(node: n),
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn decision_tree_declared_bound(n: Node) -> DeclaredRelationBound {
  DeclaredRelationBound {
    technique: DecisionTree,
    lower_bound: sized_complexity(
      class: SizedLinearithmicClass,
      variables: single_complexity_variable(size_var: SizeVariable { source: n })
    ),
    relation_locus: node_locus(node: n)
  }
}

fn information_theoretic_declared_bound(n: Node) -> DeclaredRelationBound {
  DeclaredRelationBound {
    technique: InformationTheoretic,
    lower_bound: sized_complexity(
      class: SizedLinearClass,
      variables: single_complexity_variable(size_var: SizeVariable { source: n })
    ),
    relation_locus: node_locus(node: n)
  }
}

// DecisionTree: realization > Θ(n log n) → gap (asymptotic_class_dominates is strict for ClassLinearithmic).
fn assess_decision_tree(n: Node, realization: ComplexityBound) -> SynthesisOutcome {
  if asymptotic_class_dominates(
    a: complexity_bound_class(b: realization),
    b: ClassLinearithmic
  ) {
    SynthesisGap {
      realization_cost: realization,
      lower_bound: decision_tree_declared_bound(n: n),
      report: Report {
        reason: SynthesisGapDecisionTree,
        at: node_locus(node: n)
      }
    }
  } else {
    SynthesisOptimal {
      realization_cost: realization,
      lower_bound: decision_tree_declared_bound(n: n)
    }
  }
}

// InformationTheoretic: realization strictly > Ω(n) → gap.
// Double-dominance: outer gate tests dominates(realization, ClassLinear) — true iff ≥ linear
// (reflexive for ClassLinear); inner tests dominates(ClassLinear, realization) — true iff equal,
// false iff strictly greater → gap. Avoids == in if-conditions: parser greedily parses
// ClassLinear{...} as a struct literal when == appears, eating the if-body and leaving else dangling.
// complexity_bound_class called twice (pure function; let-binding before if-else is also
// rejected by the resolve-posture gate strict mode).
fn assess_information_theoretic(n: Node, realization: ComplexityBound) -> SynthesisOutcome {
  if asymptotic_class_dominates(
    a: complexity_bound_class(b: realization),
    b: ClassLinear
  ) {
    if asymptotic_class_dominates(
      a: ClassLinear,
      b: complexity_bound_class(b: realization)
    ) {
      SynthesisOptimal {
        realization_cost: realization,
        lower_bound: information_theoretic_declared_bound(n: n)
      }
    } else {
      SynthesisGap {
        realization_cost: realization,
        lower_bound: information_theoretic_declared_bound(n: n),
        report: Report {
          reason: SynthesisGapInformationTheoretic,
          at: node_locus(node: n)
        }
      }
    }
  } else {
    // Realization is sub-linear: InformationTheoretic has no lower-bound comparison for this class.
    SynthesisNoTechnique {
      diagnostic: synthesis_no_technique_diagnostic(n: n)
    }
  }
}

fn outcome_to_reports(outcome: SynthesisOutcome) -> List<Report> {
  match outcome {
    SynthesisGap { realization_cost: _, lower_bound: _, report: r } =>
      Cons { head: r, tail: Empty }
    SynthesisOptimal { realization_cost: _, lower_bound: _ } => Empty
    SynthesisNoTechnique { diagnostic: _ } => Empty
  }
}

fn synthesis_lens(n: Node) -> List<Report> {
  match complexity_lens(n: n) {
    Violates { diagnostic: _ } => Empty
    Holds { value: realization } =>
      list_append(
        left: outcome_to_reports(outcome: assess_decision_tree(n: n, realization: realization)),
        right: outcome_to_reports(outcome: assess_information_theoretic(n: n, realization: realization))
      )
  }
}

