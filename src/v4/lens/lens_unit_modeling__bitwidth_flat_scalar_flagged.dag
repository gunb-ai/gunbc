// Scope: B1 unit-modeling lens — FAIL/flag witness for the Information/BitWidth
//        token. A pointer/word-width field (`pointer_width`) typed as a bare
//        kernel `Int` MUST be flagged: width is an Information quantity carried
//        by BitWidth = Measure<Information,One> (measure.dag:192), and the

module v4.test.lens_unit_modeling.bitwidth_flat_scalar_flagged

import v4.lens.unit_modeling { unit_modeling_gate }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}
import v4.std.verification {
  EqualsClaim,
  TestClaim,
  TestClassification,
  ManualAnchorAbsent,
  Tier1,
  Unit,
  manual_claim_anchor
}

data int_leaf_target_bitwidth: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^dag_binding_type_int } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data bitwidth_flat_scalar_input: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Named { name: ^pointer_width },
      target: int_leaf_target_bitwidth
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn bitwidth_flat_scalar_flagged_holds() -> Bool {
  match unit_modeling_gate(node: bitwidth_flat_scalar_input) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

fn bitwidth_flat_scalar_flagged_rhs() -> Node {
  if bitwidth_flat_scalar_flagged_holds() {
    bitwidth_flat_scalar_input
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
    }
  }
}

data claim_bitwidth_flat_scalar_flagged: TestClaim = EqualsClaim {
  label: "lens_unit_modeling/bitwidth_flag: pointer_width typed bare Int is rejected",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: bitwidth_flat_scalar_input,
  rhs: bitwidth_flat_scalar_flagged_rhs(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
