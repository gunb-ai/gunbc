  Outcome,
  Produced,
  Rejected,
  Diagnostic,
  Unavailable,
  UserInputBoundary,
  Textual,
  WholeFile
}
import v4.std.node {
  Node,
  Connective,
  Conj,
  Disj,
  Arrow,
  Cardinality,
  Instantiation,
  Behavior,
  Symbol
}


type TypeConstructionSubject
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = ConnectiveKernel { connective: Connective }
  | BehaviorValueSubject { behavior: Behavior }


type AlgebraLawSubject { algebra: Symbol, inhabitant: Symbol, law: Symbol }


type DiagnosticExhaustivenessSubject { reason: Symbol }


type LensApplicabilitySubject { lens: Symbol, program: Node }


type BidirectionalRoundtripSubject { language: Symbol, production: Symbol }


type TestgenConcept
// 🟡 coproduct dissolution — DECISIONS.md LB-P4-3212
  = TypeConstruction { subject: TypeConstructionSubject }
  | AlgebraLaw { subject: AlgebraLawSubject }
  | DiagnosticExhaustiveness { subject: DiagnosticExhaustivenessSubject }
  | LensApplicability { subject: LensApplicabilitySubject }
  | BidirectionalRoundtrip { subject: BidirectionalRoundtripSubject }


type Generator<C> {
  classification: TestClassification
  kind: AssertKind
  t19_anchor: T19PresentManualAnchorKey
  slot: C
}


data t19_law_nat_add_left_identity: Symbol = t19_law_nat_add_left_identity


data t19_law_nat_add_right_identity: Symbol = t19_law_nat_add_right_identity


data t19_law_nat_add_associativity: Symbol = t19_law_nat_add_associativity


data t19_law_nat_mul_left_identity: Symbol = t19_law_nat_mul_left_identity


data t19_law_nat_mul_annihilator: Symbol = t19_law_nat_mul_annihilator


data t19_law_nat_mul_associativity: Symbol = t19_law_nat_mul_associativity


data t19_testgen_lens_file: Symbol = t19_testgen_lens_file


data t19_manual_anchor_absent_bootstrap: Symbol = t19_manual_anchor_absent_bootstrap


fn t19_manual_anchor_absent_bootstrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: t19_manual_anchor_absent_bootstrap,
    at: Textual { file: t19_testgen_lens_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


// 🟡 gated — INVARIANTS P2 / `src/v4/TASKS.md` § T-19 Phase-1.5 (`t19_manual_anchor_manifest.dag` bullets, lines 780–783):
// `manual_test_claim_for_manual_anchor` is a closed Wave-0 **key→claim** join (twelve `Produced` arms + `T19ManualAnchorAbsent` fail-closed),
// not a canonical indexed query materialized over `TestClaim.t19_anchor`. Dissolve-on-arrival: fold this table into manifest-backed lookup /
// reflection once **T-19 — `lens/testgen.dag` — M2 materialization band** + **M2 cross-file loading + literal validation** land (TASKS §T-19
// `Retirement` paragraph, same subsection), per the P2 bijection rule (no parallel slug tables vs fields already on `TestClaim`).

fn manual_test_claim_for_manual_anchor(key: T19ManualAnchorKey) -> Outcome<TestClaim> {
  match key {
    T19ManualAnchorAbsent =>
      Rejected { diagnostic: t19_manual_anchor_absent_bootstrap_diagnostic() }
    T19ManualTcConjEmpty => Produced { value: claim_conj_empty_compiles }
    T19ManualTcDisjEmpty => Produced { value: claim_disj_empty_compiles }
    T19ManualTcArrowTwoConj => Produced { value: claim_arrow_two_conj_compiles }
    T19ManualTcCardinalityEmpty => Produced { value: claim_cardinality_empty_compiles }
    T19ManualTcInstantiationEmpty => Produced { value: claim_instantiation_empty_compiles }
    T19ManualTcConjEqualsRefl => Produced { value: claim_conj_equals_refl }
    T19ManualNatAddLeftIdentity => Produced { value: claim_nat_add_left_identity }
    T19ManualNatAddRightIdentity => Produced { value: claim_nat_add_right_identity }
    T19ManualNatAddAssociativity => Produced { value: claim_nat_add_associativity }
    T19ManualNatMulLeftIdentity => Produced { value: claim_nat_mul_left_identity }
    T19ManualNatMulAnnihilator => Produced { value: claim_nat_mul_annihilator }
    T19ManualNatMulAssociativity => Produced { value: claim_nat_mul_associativity }
  }
}


fn testgen_concept_for_manual_claim(claim: TestClaim) -> Outcome<TestgenConcept> {
  match claim.t19_anchor {
    T19ManualAnchorAbsent =>
      Rejected { diagnostic: t19_manual_anchor_absent_bootstrap_diagnostic() }
    T19ManualTcConjEmpty =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        },
      }
    T19ManualTcDisjEmpty =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Disj },
        },
      }
    T19ManualTcArrowTwoConj =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Arrow },
        },
      }
    T19ManualTcCardinalityEmpty =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Cardinality },
        },
      }
    T19ManualTcInstantiationEmpty =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Instantiation },
        },
      }
    T19ManualTcConjEqualsRefl =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        },
      }
    T19ManualNatAddLeftIdentity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_law_subject_algebra_nat_add_left_identity,
            inhabitant: nat_law_subject_inhabitant_nat_add_left_identity,
            law: t19_law_nat_add_left_identity,
          },
        },
      }
    T19ManualNatAddRightIdentity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_law_subject_algebra_nat_add_right_identity,
            inhabitant: nat_law_subject_inhabitant_nat_add_right_identity,
            law: t19_law_nat_add_right_identity,
          },
        },
      }
    T19ManualNatAddAssociativity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_law_subject_algebra_nat_add_associativity,
            inhabitant: nat_law_subject_inhabitant_nat_add_associativity,
            law: t19_law_nat_add_associativity,
          },
        },
      }
    T19ManualNatMulLeftIdentity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_law_subject_algebra_nat_mul_left_identity,
            inhabitant: nat_law_subject_inhabitant_nat_mul_left_identity,
            law: t19_law_nat_mul_left_identity,
          },
        },
      }
    T19ManualNatMulAnnihilator =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_law_subject_algebra_nat_mul_annihilator,
            inhabitant: nat_law_subject_inhabitant_nat_mul_annihilator,
            law: t19_law_nat_mul_annihilator,
          },
        },
      }
    T19ManualNatMulAssociativity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_law_subject_algebra_nat_mul_associativity,
            inhabitant: nat_law_subject_inhabitant_nat_mul_associativity,
            law: t19_law_nat_mul_associativity,
          },
        },
      }
  }
}


fn t19_present_manual_anchor_key_for_claim(claim: TestClaim) -> Outcome<T19PresentManualAnchorKey> {
  match claim.t19_anchor {
    T19ManualAnchorAbsent =>
      Rejected { diagnostic: t19_manual_anchor_absent_bootstrap_diagnostic() }
    T19ManualTcConjEmpty => Produced { value: T19PresentManualTcConjEmpty }
    T19ManualTcDisjEmpty => Produced { value: T19PresentManualTcDisjEmpty }
    T19ManualTcArrowTwoConj => Produced { value: T19PresentManualTcArrowTwoConj }
    T19ManualTcCardinalityEmpty => Produced { value: T19PresentManualTcCardinalityEmpty }
    T19ManualTcInstantiationEmpty => Produced { value: T19PresentManualTcInstantiationEmpty }
    T19ManualTcConjEqualsRefl => Produced { value: T19PresentManualTcConjEqualsRefl }
    T19ManualNatAddLeftIdentity => Produced { value: T19PresentManualNatAddLeftIdentity }
    T19ManualNatAddRightIdentity => Produced { value: T19PresentManualNatAddRightIdentity }
    T19ManualNatAddAssociativity => Produced { value: T19PresentManualNatAddAssociativity }
    T19ManualNatMulLeftIdentity => Produced { value: T19PresentManualNatMulLeftIdentity }
    T19ManualNatMulAnnihilator => Produced { value: T19PresentManualNatMulAnnihilator }
    T19ManualNatMulAssociativity => Produced { value: T19PresentManualNatMulAssociativity }
  }
}


fn bootstrap_claim_generator_for_manual_anchor(
  key: T19ManualAnchorKey
) -> Outcome<Generator<TestgenConcept>> {
  match manual_test_claim_for_manual_anchor(key: key) {
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
    Produced { value: claim } =>
      match testgen_concept_for_manual_claim(claim: claim) {
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
        Produced { value: slot } =>
          match t19_present_manual_anchor_key_for_claim(claim: claim) {
            Rejected { diagnostic: d } => Rejected { diagnostic: d }
            Produced { value: present_anchor } =>
              Produced {
                value: Generator {
                  classification: claim.classification,
                  kind: claim.kind,
                  t19_anchor: present_anchor,
                  slot: slot,
                }
              }
          }
      }
  }
}
