// src/v4/lens/testgen.dag
// Scope: Manual-anchor testgen plus filesystem-backed whole-corpus lens driver primitive.
// Owns: Generator TestgenConcept manual_test_claim_for_manual_anchor testgen_concept_for_manual_claim TypeConstructionSubject AlgebraLawSubject DiagnosticExhaustivenessSubject LensApplicabilitySubject BidirectionalRoundtripSubject CorpusEntry CorpusTraversalScope CorpusTraversalOrder CorpusDuplicatePolicy CorpusTraversalPolicy CorpusEnumerationRequest CorpusEnumerationResult CorpusEnumerator CorpusEntryIngestResult CorpusEntryIngestor CorpusLensReadResult<C> CorpusLensReader<C> CorpusLensObservation<C> CorpusLensDriveResult<C> CorpusLensDriver<C>
// Consumes: v4.std.diagnostic v4.std.nat v4.std.node v4.std.verification v4.extdeps.file_system v4.test.claim.manual.connective_anchors v4.test.claim.manual.nat_law_anchors
// Status: Modeled Generator join for manual-anchor claims; substrate extension = operator STOP.

module v4.lens.testgen


import v4.std.diagnostic {Outcome, Diagnostic, Unavailable, UserInputBoundary, Textual, WholeFile, Accepted, None, diagnostics_singleton}
import v4.std.nat {
  nat_algebra_law_subject_symbol_additive_monoid,
  nat_algebra_law_subject_symbol_commutative_semiring,
  nat_algebra_law_subject_symbol_inhabitant_nat
}
import v4.std.node {
  Node,
  Connective,
  Conj,
  Disj,
  Arrow,
  Cardinality,
  Instantiation,
  Behavior,
  Symbol
}
import v4.extdeps.file_system {
  AbsolutePath,
  FileBody,
  FileKindResolutionPolicy,
  FileSystemOperations,
  Filesystem
}
import v4.std.verification {
  AssertKind,
  TestClaim,
  TestClassification,
  T19ManualAnchorAbsent,
  T19ManualAnchorKey,
  T19ManualNatAddAssociativity,
  T19ManualNatAddLeftIdentity,
  T19ManualNatAddRightIdentity,
  T19ManualNatMulAnnihilator,
  T19ManualNatMulAssociativity,
  T19ManualNatMulLeftIdentity,
  T19ManualTcArrowTwoConj,
  T19ManualTcCardinalityEmpty,
  T19ManualTcConjEmpty,
  T19ManualTcConjEqualsRefl,
  T19ManualTcDisjEmpty,
  T19ManualTcInstantiationEmpty
}
import v4.test.claim.manual.connective_anchors {
  claim_arrow_two_conj_compiles,
  claim_cardinality_empty_compiles,
  claim_conj_empty_compiles,
  claim_conj_equals_refl,
  claim_disj_empty_compiles,
  claim_instantiation_empty_compiles
}
import v4.test.claim.manual.nat_law_anchors {
  claim_nat_add_associativity,
  claim_nat_add_left_identity,
  claim_nat_add_right_identity,
  claim_nat_mul_annihilator,
  claim_nat_mul_associativity,
  claim_nat_mul_left_identity
}


// 🟢 coproduct dissolution — LB-P4-3212.
type TypeConstructionSubject
// 🟢 coproduct dissolution — LB-P4-3212
  = ConnectiveKernel { connective: Connective }
  | BehaviorValueSubject { behavior: Behavior }


type AlgebraLawSubject { algebra: Symbol, inhabitant: Symbol, law: Symbol }


type DiagnosticExhaustivenessSubject { reason: Symbol }


type LensApplicabilitySubject {
  lens: Symbol
  program: Node
}


type BidirectionalRoundtripSubject { language: Symbol, production: Symbol }


// 🟡 coproduct dissolution — LB-P4-3212.
type TestgenConcept
// 🟡 coproduct dissolution — LB-P4-3212
// RULING-1: 🟡 needs-more-work — multi-arm scheduling coproduct
  = TypeConstruction { subject: TypeConstructionSubject }
  | AlgebraLaw { subject: AlgebraLawSubject }
  | DiagnosticExhaustiveness { subject: DiagnosticExhaustivenessSubject }
  | LensApplicability { subject: LensApplicabilitySubject }
  | BidirectionalRoundtrip { subject: BidirectionalRoundtripSubject }


type Generator<C> {
  classification: TestClassification
  kind: AssertKind
  t19_anchor: T19ManualAnchorKey
  slot: C
}


// RULING-1: 🟡 needs-more-work
type CorpusEntry {
  path: AbsolutePath
  body: FileBody
}


// RULING-1: 🟡 needs-more-work
// 🟢 coproduct dissolution — LB-P4-3212.
type CorpusTraversalScope
// 🟢 coproduct dissolution — LB-P4-3212
  = RecursiveCorpusWalk
  | SingleDirectoryCorpusWalk


// RULING-1: 🟡 needs-more-work
// 🟢 coproduct dissolution — LB-P4-3212.
type CorpusTraversalOrder
// 🟢 coproduct dissolution — LB-P4-3212
  = LexicalPathOrder
  | FilesystemNativeOrder


// RULING-1: 🟡 needs-more-work
// 🟢 coproduct dissolution — LB-P4-3212.
type CorpusDuplicatePolicy
// 🟢 coproduct dissolution — LB-P4-3212
  = PreserveDuplicateEntries
  | RejectDuplicatePaths


// RULING-1: 🟡 needs-more-work
type CorpusTraversalPolicy {
  scope: CorpusTraversalScope
  order: CorpusTraversalOrder
  duplicates: CorpusDuplicatePolicy
}


// RULING-1: 🟡 needs-more-work
type CorpusEnumerationRequest {
  filesystem: Filesystem
  root: AbsolutePath
  operations: FileSystemOperations
  resolution: FileKindResolutionPolicy
  traversal: CorpusTraversalPolicy
}


// RULING-1: 🟡 needs-more-work
type CorpusEnumerationResult = Outcome<List<CorpusEntry>>


// RULING-1: 🟡 needs-more-work
type CorpusEnumerator = fn(CorpusEnumerationRequest) -> CorpusEnumerationResult


// RULING-1: 🟡 needs-more-work
type CorpusEntryIngestResult = Outcome<Node>


// RULING-1: 🟡 needs-more-work
type CorpusEntryIngestor = fn(CorpusEntry) -> CorpusEntryIngestResult


// RULING-1: 🟡 needs-more-work
type CorpusLensReadResult<C> = Outcome<C>


// RULING-1: 🟡 needs-more-work
type CorpusLensReader<C> {
  lens: Symbol
  read: fn(Node) -> CorpusLensReadResult<C>
}


// RULING-1: 🟡 needs-more-work
type CorpusLensObservation<C> {
  entry: CorpusEntry
  program: Node
  output: C
}


// RULING-1: 🟡 needs-more-work
type CorpusLensDriveResult<C> = Outcome<List<CorpusLensObservation<C>>>


// RULING-1: 🟡 needs-more-work
type CorpusLensDriver<C> = fn(
  CorpusEnumerationRequest,
  CorpusEnumerator,
  CorpusEntryIngestor,
  CorpusLensReader<C>
) -> CorpusLensDriveResult<C>


// RULING-1: 🟢 pretty-much-done — repeats manual claim anchor after lookup Outcome


data t19_law_nat_add_left_identity: Symbol = t19_law_nat_add_left_identity


data t19_law_nat_add_right_identity: Symbol = t19_law_nat_add_right_identity


data t19_law_nat_add_associativity: Symbol = t19_law_nat_add_associativity


data t19_law_nat_mul_left_identity: Symbol = t19_law_nat_mul_left_identity


data t19_law_nat_mul_annihilator: Symbol = t19_law_nat_mul_annihilator


data t19_law_nat_mul_associativity: Symbol = t19_law_nat_mul_associativity


data t19_testgen_lens_file: Symbol = t19_testgen_lens_file


data t19_manual_anchor_absent_bootstrap: Symbol = t19_manual_anchor_absent_bootstrap


fn t19_manual_anchor_absent_bootstrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: t19_manual_anchor_absent_bootstrap,
    at: Textual { file: t19_testgen_lens_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn manual_test_claim_for_manual_anchor(key: T19ManualAnchorKey) -> Outcome<TestClaim> {
  match key {
    T19ManualAnchorAbsent =>
      Rejected { diagnostics: diagnostics_singleton(d: t19_manual_anchor_absent_bootstrap_diagnostic() }
    T19ManualTcConjEmpty => Accepted { value: claim_conj_empty_compiles, diagnostics: None }
    T19ManualTcDisjEmpty => Accepted { value: claim_disj_empty_compiles, diagnostics: None }
    T19ManualTcArrowTwoConj => Accepted { value: claim_arrow_two_conj_compiles, diagnostics: None }
    T19ManualTcCardinalityEmpty => Accepted { value: claim_cardinality_empty_compiles, diagnostics: None }
    T19ManualTcInstantiationEmpty => Accepted { value: claim_instantiation_empty_compiles, diagnostics: None }
    T19ManualTcConjEqualsRefl => Accepted { value: claim_conj_equals_refl, diagnostics: None }
    T19ManualNatAddLeftIdentity => Accepted { value: claim_nat_add_left_identity, diagnostics: None }
    T19ManualNatAddRightIdentity => Accepted { value: claim_nat_add_right_identity, diagnostics: None }
    T19ManualNatAddAssociativity => Accepted { value: claim_nat_add_associativity, diagnostics: None }
    T19ManualNatMulLeftIdentity => Accepted { value: claim_nat_mul_left_identity, diagnostics: None }
    T19ManualNatMulAnnihilator => Accepted { value: claim_nat_mul_annihilator, diagnostics: None }
    T19ManualNatMulAssociativity => Accepted { value: claim_nat_mul_associativity, diagnostics: None }
  }
}


fn testgen_concept_for_manual_claim(claim: TestClaim) -> Outcome<TestgenConcept> {
  match claim.t19_anchor {
    T19ManualAnchorAbsent =>
      Rejected { diagnostics: diagnostics_singleton(d: t19_manual_anchor_absent_bootstrap_diagnostic() }
    T19ManualTcConjEmpty =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        },, diagnostics: None }
    T19ManualTcDisjEmpty =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Disj },
        },, diagnostics: None }
    T19ManualTcArrowTwoConj =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Arrow },
        },, diagnostics: None }
    T19ManualTcCardinalityEmpty =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Cardinality },
        },, diagnostics: None }
    T19ManualTcInstantiationEmpty =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Instantiation },
        },, diagnostics: None }
    T19ManualTcConjEqualsRefl =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        },, diagnostics: None }
    T19ManualNatAddLeftIdentity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_additive_monoid,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_add_left_identity,
          },
        },, diagnostics: None }
    T19ManualNatAddRightIdentity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_additive_monoid,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_add_right_identity,
          },
        },, diagnostics: None }
    T19ManualNatAddAssociativity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_additive_monoid,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_add_associativity,
          },
        },, diagnostics: None }
    T19ManualNatMulLeftIdentity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_commutative_semiring,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_mul_left_identity,
          },
        },, diagnostics: None }
    T19ManualNatMulAnnihilator =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_commutative_semiring,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_mul_annihilator,
          },
        },, diagnostics: None }
    T19ManualNatMulAssociativity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_commutative_semiring,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_mul_associativity,
          },
        },, diagnostics: None }
  }
}


fn bootstrap_claim_generator_for_manual_anchor(
  key: T19ManualAnchorKey
) -> Outcome<Generator<TestgenConcept>> {
  match manual_test_claim_for_manual_anchor(key: key) {
    Rejected { diagnostics: diagnostics_singleton(d: d } => Rejected { diagnostics: diagnostics_singleton(d: d }
    Accepted { value: claim, diagnostics: None } =>
      match testgen_concept_for_manual_claim(claim: claim) {
        Rejected { diagnostics: diagnostics_singleton(d: d } => Rejected { diagnostics: diagnostics_singleton(d: d }
        Accepted { value: slot, diagnostics: None } =>
          Accepted { value: Generator {
              classification: claim.classification,
              kind: claim.kind,
              t19_anchor: claim.t19_anchor,
              slot: slot,
            }, diagnostics: None }
    }
  }
}
