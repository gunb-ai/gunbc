data t19_law_nat_mul_associativity: Symbol = t19_law_nat_mul_associativity


data t19_lbe_label_conj_dag_surface: String = "generated/lbe: Conj type-node matches dag LanguageModel surface (frozen snapshot)"


data t19_lbe_label_disj_dag_surface: String = "generated/lbe: Disj type-node matches dag LanguageModel surface (frozen snapshot)"


data t19_lbe_label_transform_dag_surface: String = "generated/lbe: Transform computation-node matches dag LanguageModel surface (frozen snapshot)"


data t19_idempotent_operation_tautology_skip: Symbol = t19_idempotent_operation_tautology_skip
data t19_idempotent_label_read: String = "generated/idempotent_operation: ReadEffect f(f(x)) == f(x)"
data t19_idempotent_label_upsert: String = "generated/idempotent_operation: UpsertEffect f(f(x)) == f(x)"
data t19_idempotent_label_delete: String = "generated/idempotent_operation: DeleteEffect f(f(x)) == f(x)"


data t19_testgen_lens_file: Symbol = t19_testgen_lens_file


data t19_manual_anchor_absent_bootstrap: Symbol = t19_manual_anchor_absent_bootstrap


data t19_coproduct_exhaustiveness_missing_variant: Symbol = t19_coproduct_exhaustiveness_missing_variant


data t19_coproduct_exhaustiveness_testclaim_variant: Symbol = t19_coproduct_exhaustiveness_testclaim_variant


data t19_coproduct_exhaustiveness_diagnostic_claim_variant: Symbol = t19_coproduct_exhaustiveness_diagnostic_claim_variant


data t19_coproduct_exhaustiveness_compiles_claim_variant: Symbol = t19_coproduct_exhaustiveness_compiles_claim_variant


data t19_coproduct_exhaustiveness_equals_claim_variant: Symbol = t19_coproduct_exhaustiveness_equals_claim_variant


data t19_coproduct_exhaustiveness_roundtrip_claim_variant: Symbol = t19_coproduct_exhaustiveness_roundtrip_claim_variant


data t19_coproduct_exhaustiveness_label: String = "generated/diagnostic-exhaustiveness: TestClaim coproduct missing arm rejects"


data t19_coproduct_exhaustiveness_omitted_variant_edge: Symbol = t19_coproduct_exhaustiveness_omitted_variant_edge


fn lbe_frozen_snapshot_conj_dag_surface() -> FrozenLanguageBehaviorSnapshot {
  FrozenLanguageBehaviorSnapshot {
    language: dag_language_model_surface_id,
    input_node: stub_empty_conj,
    expected_value: stub_empty_conj,
  }
}


fn lbe_frozen_snapshot_disj_dag_surface() -> FrozenLanguageBehaviorSnapshot {
  FrozenLanguageBehaviorSnapshot {
    language: dag_language_model_surface_id,
    input_node: stub_empty_disj,
    expected_value: stub_empty_disj,
  }
}


fn lbe_frozen_snapshot_transform_dag_surface() -> FrozenLanguageBehaviorSnapshot {
  FrozenLanguageBehaviorSnapshot {
    language: dag_language_model_surface_id,
    input_node: stub_empty_transform,
    expected_value: stub_empty_transform,
  }
}


fn lbe_io_mock_conj_dag_surface() -> LanguageBehaviorIoMock {
  LanguageBehaviorIoMock { snapshot: lbe_frozen_snapshot_conj_dag_surface() }
}


fn lbe_io_mock_disj_dag_surface() -> LanguageBehaviorIoMock {
  LanguageBehaviorIoMock { snapshot: lbe_frozen_snapshot_disj_dag_surface() }
}


fn lbe_io_mock_transform_dag_surface() -> LanguageBehaviorIoMock {
  LanguageBehaviorIoMock { snapshot: lbe_frozen_snapshot_transform_dag_surface() }
}


fn lbe_subject_conj_dag_surface() -> LanguageBehaviorEquivalenceSubject {
  LanguageBehaviorEquivalenceSubject {
    subject: ConnectiveKernel { connective: Conj },
    language: dag_language_model_surface_id,
  }
}


fn lbe_subject_disj_dag_surface() -> LanguageBehaviorEquivalenceSubject {
  LanguageBehaviorEquivalenceSubject {
    subject: ConnectiveKernel { connective: Disj },
    language: dag_language_model_surface_id,
  }
}


fn lbe_subject_transform_dag_surface() -> LanguageBehaviorEquivalenceSubject {
  LanguageBehaviorEquivalenceSubject {
    subject: BehaviorValueSubject { behavior: Transform },
    language: dag_language_model_surface_id,
  }
}


fn testgen_emit_idempotent_operation_equals_claim(
  label: String,
  subject: ComposableIdempotentOperationSubject,
  classification: TestClassification
) -> Outcome<TestClaim> {
  Accepted {
    value: EqualsClaim {
      label: label,
      t19_anchor: T19ManualAnchorAbsent,
      lhs: idempotent_operation_apply_twice(state: t19_sample_state, subject: subject),
      rhs: idempotent_operation_apply_once(state: t19_sample_state, subject: subject),
      classification: classification,
    },
    diagnostics: None,
  }
}


fn testgen_emit_idempotent_operation_claim(
  label: String,
  subject: IdempotentOperationSubject,
  classification: TestClassification
) -> Outcome<TestClaim> {
  match subject {
    LabelOnlyIdempotentInhabitance { shape: _, label: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: t19_idempotent_operation_tautology_skip,
            at: Textual { file: t19_testgen_lens_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
    Composable(inner) =>
      testgen_emit_idempotent_operation_equals_claim(
        label: label,
        subject: inner,
        classification: classification
      )
  }
}


fn testgen_scheduled_idempotent_operation_subjects() -> List<ComposableIdempotentOperationSubject> {
  [
    t19_sample_read_composable,
    t19_sample_upsert_composable,
    t19_sample_delete_composable,
  ]
}


fn testgen_emit_language_behavior_equivalence_claim(
  anchor: T19ManualAnchorKey,
  label: String,
  mock: LanguageBehaviorIoMock
) -> Outcome<TestClaim> {
  let snap = mock.snapshot
  match anchor {
    T19ManualLbeConjDagSurface =>
      Accepted {
        value: CompilesClaim {
          label: label,
          t19_anchor: t19_manual_claim_anchor(anchor: anchor),
          input: snap.input_node,
          expected_value: snap.expected_value,
          classification: TestClassification { tier: Tier1, layer: Unit },
        },
        diagnostics: None,
      }
    T19ManualLbeDisjDagSurface =>
      Accepted {
        value: CompilesClaim {
          label: label,
          t19_anchor: t19_manual_claim_anchor(anchor: anchor),
          input: snap.input_node,
          expected_value: snap.expected_value,
          classification: TestClassification { tier: Tier1, layer: Unit },
        },
        diagnostics: None,
      }
    T19ManualLbeTransformDagSurface =>
      Accepted {
        value: CompilesClaim {
          label: label,
          t19_anchor: t19_manual_claim_anchor(anchor: anchor),
          input: snap.input_node,
          expected_value: snap.expected_value,
          classification: TestClassification { tier: Tier1, layer: Unit },
        },
        diagnostics: None,
      }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(d: t19_manual_anchor_absent_bootstrap_diagnostic()),
      }
  }
}


fn testgen_scheduled_language_behavior_generators() -> List<Generator<TestgenConcept>> {
  [
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: t19_manual_claim_anchor(anchor: T19ManualLbeConjDagSurface),
      slot: LanguageBehaviorEquivalence {
        subject: lbe_subject_conj_dag_surface(),
        mock: lbe_io_mock_conj_dag_surface(),
      },
    },
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: t19_manual_claim_anchor(anchor: T19ManualLbeDisjDagSurface),
      slot: LanguageBehaviorEquivalence {
        subject: lbe_subject_disj_dag_surface(),
        mock: lbe_io_mock_disj_dag_surface(),
      },
    },
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: t19_manual_claim_anchor(anchor: T19ManualLbeTransformDagSurface),
      slot: LanguageBehaviorEquivalence {
        subject: lbe_subject_transform_dag_surface(),
        mock: lbe_io_mock_transform_dag_surface(),
      },
    },
  ]
}


fn coproduct_exhaustiveness_subject_testclaim_diagnostic() -> T19GeneratedAnchorKey {
  T19GeneratedCoproductExhaustiveness { omitted_variant: TestClaimDiagnosticClaimVariant }
}

fn coproduct_exhaustiveness_subject_testclaim_compiles() -> T19GeneratedAnchorKey {
  T19GeneratedCoproductExhaustiveness { omitted_variant: TestClaimCompilesClaimVariant }
}

fn coproduct_exhaustiveness_subject_testclaim_equals() -> T19GeneratedAnchorKey {
  T19GeneratedCoproductExhaustiveness { omitted_variant: TestClaimEqualsClaimVariant }
}

fn coproduct_exhaustiveness_subject_testclaim_roundtrip() -> T19GeneratedAnchorKey {
  T19GeneratedCoproductExhaustiveness { omitted_variant: TestClaimRoundTripClaimVariant }
}


fn test_claim_coproduct_variant_symbol(variant: TestClaimCoproductVariant) -> Symbol {
  match variant {
    TestClaimCompilesClaimVariant => t19_coproduct_exhaustiveness_compiles_claim_variant
    TestClaimDiagnosticClaimVariant => t19_coproduct_exhaustiveness_diagnostic_claim_variant
    TestClaimEqualsClaimVariant => t19_coproduct_exhaustiveness_equals_claim_variant
    TestClaimRoundTripClaimVariant => t19_coproduct_exhaustiveness_roundtrip_claim_variant
  }
}


fn coproduct_exhaustiveness_anchor_omitted_variant(anchor: T19GeneratedAnchorKey) -> TestClaimCoproductVariant {
  match anchor {
    T19GeneratedCoproductExhaustiveness { omitted_variant } => omitted_variant
  }
}


fn coproduct_exhaustiveness_variant_node(variant: TestClaimCoproductVariant) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: test_claim_coproduct_variant_symbol(variant: variant) }
    },
    children: []
  }
}


fn coproduct_exhaustiveness_input(anchor: T19GeneratedAnchorKey) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: t19_coproduct_exhaustiveness_testclaim_variant }
    },
    children: [
      Edge {
        label: Named { name: t19_coproduct_exhaustiveness_omitted_variant_edge },
        target: coproduct_exhaustiveness_variant_node(
          variant: coproduct_exhaustiveness_anchor_omitted_variant(anchor: anchor)
        )
      }
    ]
  }
}


fn coproduct_exhaustiveness_diagnostic(
  input: Node
) -> Diagnostic {
  Diagnostic {
    reason: t19_coproduct_exhaustiveness_missing_variant,
    at: node_locus(node: input),
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn testgen_emit_coproduct_exhaustiveness_claim(
  anchor: T19GeneratedAnchorKey
) -> Outcome<TestClaim> {
  let input = coproduct_exhaustiveness_input(anchor: anchor)
  Accepted {
    value: DiagnosticClaim {
      label: t19_coproduct_exhaustiveness_label,
      t19_anchor: t19_generated_claim_anchor(anchor: anchor),
      input: input,
      expected_rejection: diagnostics_singleton(
        d: coproduct_exhaustiveness_diagnostic(input: input)
      ),
      classification: TestClassification { tier: Tier1, layer: Unit },
    },
    diagnostics: None,
  }
}


fn testgen_scheduled_coproduct_exhaustiveness_generators() -> List<Generator<TestgenConcept>> {
  [
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: t19_generated_claim_anchor(
        anchor: coproduct_exhaustiveness_subject_testclaim_compiles()
      ),
      slot: DiagnosticExhaustiveness,
    },
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: t19_generated_claim_anchor(
        anchor: coproduct_exhaustiveness_subject_testclaim_diagnostic()
      ),
      slot: DiagnosticExhaustiveness,
    },
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: t19_generated_claim_anchor(
        anchor: coproduct_exhaustiveness_subject_testclaim_equals()
      ),
      slot: DiagnosticExhaustiveness,
    },
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: t19_generated_claim_anchor(
        anchor: coproduct_exhaustiveness_subject_testclaim_roundtrip()
      ),
      slot: DiagnosticExhaustiveness,
    },
  ]
}


fn t19_manual_anchor_absent_bootstrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: t19_manual_anchor_absent_bootstrap,
    at: Textual { file: t19_testgen_lens_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn manual_test_claim_for_manual_anchor(key: T19ManualAnchorKey) -> Outcome<TestClaim> {
  match key {
    T19ManualAnchorAbsent =>
      Rejected { diagnostics: diagnostics_singleton(d: t19_manual_anchor_absent_bootstrap_diagnostic()) }
    T19ManualTcConjEmpty => Accepted { value: claim_conj_empty_compiles, diagnostics: None }
    T19ManualTcDisjEmpty => Accepted { value: claim_disj_empty_compiles, diagnostics: None }
    T19ManualTcArrowTwoConj => Accepted { value: claim_arrow_two_conj_compiles, diagnostics: None }
    T19ManualTcCardinalityEmpty => Accepted { value: claim_cardinality_empty_rejected, diagnostics: None }
    T19ManualTcInstantiationEmpty => Accepted { value: claim_instantiation_empty_rejected, diagnostics: None }
    T19ManualTcArrowEmpty => Accepted { value: claim_arrow_empty_rejected, diagnostics: None }
    T19ManualTcTransformEmpty => Accepted { value: claim_transform_empty_rejected, diagnostics: None }
    T19ManualTcBranchEmpty => Accepted { value: claim_branch_empty_rejected, diagnostics: None }
    T19ManualTcLoopEmpty => Accepted { value: claim_loop_empty_rejected, diagnostics: None }
    T19ManualTcBindZeroChildren => Accepted { value: claim_bind_zero_children_rejected, diagnostics: None }
    T19ManualTcConjEqualsRefl => Accepted { value: claim_conj_equals_refl, diagnostics: None }
    T19ManualNatAddLeftIdentity => Accepted { value: claim_nat_add_left_identity, diagnostics: None }
    T19ManualNatAddRightIdentity => Accepted { value: claim_nat_add_right_identity, diagnostics: None }
    T19ManualNatAddAssociativity => Accepted { value: claim_nat_add_associativity, diagnostics: None }
    T19ManualNatMulLeftIdentity => Accepted { value: claim_nat_mul_left_identity, diagnostics: None }
    T19ManualNatMulAnnihilator => Accepted { value: claim_nat_mul_annihilator, diagnostics: None }
    T19ManualNatMulAssociativity => Accepted { value: claim_nat_mul_associativity, diagnostics: None }
    T19ManualLbeConjDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: T19ManualLbeConjDagSurface,
        label: t19_lbe_label_conj_dag_surface,
        mock: lbe_io_mock_conj_dag_surface()
      )
    T19ManualLbeDisjDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: T19ManualLbeDisjDagSurface,
        label: t19_lbe_label_disj_dag_surface,
        mock: lbe_io_mock_disj_dag_surface()
      )
    T19ManualLbeTransformDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: T19ManualLbeTransformDagSurface,
        label: t19_lbe_label_transform_dag_surface,
        mock: lbe_io_mock_transform_dag_surface()
      )
  }
}


fn testgen_concept_for_manual_claim(claim: TestClaim) -> Outcome<TestgenConcept> {
  match test_claim_t19_anchor(c: claim) {
    T19ManualClaimAnchor { manual_anchor: T19ManualAnchorAbsent } =>
      Rejected { diagnostics: diagnostics_singleton(d: t19_manual_anchor_absent_bootstrap_diagnostic()) }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcConjEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcDisjEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Disj },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcArrowTwoConj } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Arrow },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcCardinalityEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Cardinality },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcInstantiationEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Instantiation },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcArrowEmpty } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Arrow },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcTransformEmpty } =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Transform },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcBranchEmpty } =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Branch },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcLoopEmpty } =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Loop },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcBindZeroChildren } =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Bind },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualTcConjEqualsRefl } =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualNatAddLeftIdentity } =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_additive_monoid,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_add_left_identity,
          },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualNatAddRightIdentity } =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_additive_monoid,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_add_right_identity,
          },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualNatAddAssociativity } =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_additive_monoid,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_add_associativity,
          },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualNatMulLeftIdentity } =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_commutative_semiring,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_mul_left_identity,
          },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualNatMulAnnihilator } =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_commutative_semiring,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_mul_annihilator,
          },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualNatMulAssociativity } =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_commutative_semiring,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_mul_associativity,
          },
        }, diagnostics: None }
    T19ManualClaimAnchor { manual_anchor: T19ManualLbeConjDagSurface } =>
      Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_conj_dag_surface(),
          mock: lbe_io_mock_conj_dag_surface(),
        },
        diagnostics: None,
      }
    T19ManualClaimAnchor { manual_anchor: T19ManualLbeDisjDagSurface } =>
      Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_disj_dag_surface(),
          mock: lbe_io_mock_disj_dag_surface(),
        },
        diagnostics: None,
      }
    T19ManualClaimAnchor { manual_anchor: T19ManualLbeTransformDagSurface } =>
      Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_transform_dag_surface(),
          mock: lbe_io_mock_transform_dag_surface(),
        },
        diagnostics: None,
      }
    T19GeneratedClaimAnchor { generated_anchor: T19GeneratedCoproductExhaustiveness { omitted_variant: _ } } =>
      Accepted {
        value: DiagnosticExhaustiveness,
        diagnostics: None,
      }
  }
}


fn bootstrap_claim_generator_for_manual_anchor(
  key: T19ManualAnchorKey
) -> Outcome<Generator<TestgenConcept>> {
  match manual_test_claim_for_manual_anchor(key: key) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: claim, diagnostics: d0 } =>
      match testgen_concept_for_manual_claim(claim: claim) {
        Rejected { diagnostics: r } =>
          Rejected { diagnostics: rejected_with_pending(pending: d0, rejected: r) }
        Accepted { value: slot, diagnostics: d1 } =>
          Accepted {
            value: Generator {
              classification: test_claim_classification(c: claim),
              t19_anchor: test_claim_t19_anchor(c: claim),
              slot: slot
            },
            diagnostics: diagnostics_merge(outer: d0, inner: d1)
          }
    }
  }
}
