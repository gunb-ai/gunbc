data witness_validity_locus_tag_port: Symbol = witness_validity_locus_tag_port
data witness_validity_locus_textual_file: Symbol = witness_validity_locus_textual_file
data witness_validity_locus_textual_extent: Symbol = witness_validity_locus_textual_extent
data witness_validity_extent_tag_whole_file: Symbol = witness_validity_extent_tag_whole_file
data witness_validity_extent_tag_byte_range: Symbol = witness_validity_extent_tag_byte_range
data witness_validity_correction_tag_suggested: Symbol = witness_validity_correction_tag_suggested
data witness_validity_correction_tag_unavailable: Symbol = witness_validity_correction_tag_unavailable
data witness_validity_no_correction_tag_user: Symbol = witness_validity_no_correction_tag_user
data witness_validity_no_correction_tag_ambiguous: Symbol = witness_validity_no_correction_tag_ambiguous
data witness_validity_no_correction_tag_external: Symbol = witness_validity_no_correction_tag_external
data witness_validity_list_tag_empty: Symbol = witness_validity_list_tag_empty
data witness_validity_list_cons_head: Symbol = witness_validity_list_cons_head
data witness_validity_list_cons_tail: Symbol = witness_validity_list_cons_tail
data witness_validity_diags_field_head: Symbol = witness_validity_diags_field_head
data witness_validity_diags_field_tail: Symbol = witness_validity_diags_field_tail
data witness_validity_diagnostics_tag_none: Symbol = witness_validity_diagnostics_tag_none
data witness_validity_diagnostics_tag_some: Symbol = witness_validity_diagnostics_tag_some
data witness_validity_outcome_accepted_value: Symbol = witness_validity_outcome_accepted_value
data witness_validity_outcome_accepted_diagnostics: Symbol = witness_validity_outcome_accepted_diagnostics
data witness_validity_byte_range_unencodable: Symbol = witness_validity_byte_range_unencodable


fn witness_validity_symbol_atom_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


fn witness_validity_predicate_node(p: PreservationPredicate) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: witness_validity_field_algebra }, target: p.algebra },
      Edge {
        label: Named { name: witness_validity_field_preservation_rule },
        target: witness_validity_symbol_atom_node(s: p.preservation_rule)
      }
    ]
  }
}


fn witness_validity_witness_node(w: StructuralPropertyWitness) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: witness_validity_field_property },
        target: witness_validity_symbol_atom_node(s: w.property)
      },
      Edge { label: Named { name: witness_validity_field_evidence }, target: w.evidence }
    ]
  }
}


fn witness_validity_byte_range_unencodable_diagnostic(at_node: Node) -> Diagnostic {
  Diagnostic {
    reason: witness_validity_byte_range_unencodable,
    at: node_locus(node: at_node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn witness_validity_subject_node(
  source_facts: Node,
  candidate: Node,
  predicate: PreservationPredicate,
  witness: StructuralPropertyWitness
) -> Outcome<Node> {
  bind_outcome(
    o: witness_validity_outcome_node(
      o: verify_witness(
        source_facts: source_facts,
        candidate: candidate,
        predicate: predicate,
        witness: witness
      )
    ),
    f: fn(oracle_outcome) {
      Accepted {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge { label: Named { name: witness_validity_field_source_facts }, target: source_facts },
            Edge { label: Named { name: witness_validity_field_candidate }, target: candidate },
            Edge {
              label: Named { name: witness_validity_field_predicate },
              target: witness_validity_predicate_node(p: predicate)
            },
            Edge {
              label: Named { name: witness_validity_field_witness },
              target: witness_validity_witness_node(w: witness)
            },
            Edge {
              label: Named { name: witness_validity_field_oracle_outcome },
              target: oracle_outcome
            }
          ]
        },
        diagnostics: None
      }
    }
  )
}


// Encoders return Outcome<Node>: fail-closed on Textual{ByteRange} (Int positions are not
// Node-encodable in v4 today — gated under witness_validity_byte_range_unencodable).
// find_witness diagnostics use NodeLocus exclusively (find_witness.dag:79-92), so
// witness-validity rows always succeed; the fail-closed path is structural correctness.
fn witness_validity_no_correction_reason_node(r: NoCorrectionReason) -> Node {
  match r {
    UserInputBoundary =>
      witness_validity_symbol_atom_node(s: witness_validity_no_correction_tag_user)
    AmbiguousIntent =>
      witness_validity_symbol_atom_node(s: witness_validity_no_correction_tag_ambiguous)
    ExternalContractUnknown =>
      witness_validity_symbol_atom_node(s: witness_validity_no_correction_tag_external)
  }
}


fn witness_validity_correction_node(c: Correction) -> Node {
  match c {
    Suggested { node: n } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge { label: Named { name: witness_validity_correction_tag_suggested }, target: n }
        ]
      }
    Unavailable { reason: r } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: witness_validity_correction_tag_unavailable },
            target: witness_validity_no_correction_reason_node(r: r)
          }
        ]
      }
  }
}


fn witness_validity_extent_node(e: Extent) -> Outcome<Node> {
  match e {
    WholeFile =>
      Accepted {
        value: witness_validity_symbol_atom_node(s: witness_validity_extent_tag_whole_file),
        diagnostics: None
      }
    ByteRange { start: _, end: _ } =>
      outcome_rejected(
        d: witness_validity_byte_range_unencodable_diagnostic(
          at_node: witness_validity_symbol_atom_node(s: witness_validity_extent_tag_byte_range)
        )
      )
  }
}


fn witness_validity_locus_node(l: Locus) -> Outcome<Node> {
  match l {
    Textual { file: f, extent: e } =>
      bind_outcome(o: witness_validity_extent_node(e: e), f: fn(en) {
        Accepted {
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [
              Edge {
                label: Named { name: witness_validity_locus_tag_textual },
                target: Node {
                  kind: TypeNode { connective: Conj },
                  children: [
                    Edge {
                      label: Named { name: witness_validity_locus_textual_file },
                      target: witness_validity_symbol_atom_node(s: f)
                    },
                    Edge {
                      label: Named { name: witness_validity_locus_textual_extent },
                      target: en
                    }
                  ]
                }
              }
            ]
          },
          diagnostics: None
        }
      })
    NodeLocus { anchor: a } =>
      Accepted {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge { label: Named { name: witness_validity_locus_tag_node }, target: a.at }
          ]
        },
        diagnostics: None
      }
    PortLocus { anchor: a } =>
      Accepted {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Named { name: witness_validity_locus_tag_port },
              target: witness_validity_symbol_atom_node(s: a.at)
            }
          ]
        },
        diagnostics: None
      }
  }
}


fn witness_validity_diagnostic_node(d: Diagnostic) -> Outcome<Node> {
  bind_outcome(o: witness_validity_locus_node(l: d.at), f: fn(at_node) {
    Accepted {
      value: Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: witness_validity_diag_field_reason },
            target: witness_validity_symbol_atom_node(s: d.reason)
          },
          Edge {
            label: Named { name: witness_validity_diag_field_at },
            target: at_node
          },
          Edge {
            label: Named { name: witness_validity_diag_field_correction },
            target: witness_validity_correction_node(c: d.correction)
          }
        ]
      },
      diagnostics: None
    }
  })
}


// Consumes canonical fold_list; no parallel walker authority.
fn witness_validity_diagnostic_list_node(xs: FreeMonoid<Diagnostic>) -> Outcome<Node> {
  fold_list(
    xs: xs,
    empty: Accepted {
      value: witness_validity_symbol_atom_node(s: witness_validity_list_tag_empty),
      diagnostics: None
    },
    cons: fn(acc, h) {
      bind_outcome(o: acc, f: fn(prev_node) {
        bind_outcome(o: witness_validity_diagnostic_node(d: h), f: fn(hn) {
          Accepted {
            value: Node {
              kind: TypeNode { connective: Conj },
              children: [
                Edge { label: Named { name: witness_validity_list_cons_head }, target: hn },
                Edge { label: Named { name: witness_validity_list_cons_tail }, target: prev_node }
              ]
            },
            diagnostics: None
          }
        })
      })
    }
  )
}


fn witness_validity_non_empty_diagnostics_node(d: NonEmptyDiagnostics) -> Outcome<Node> {
  bind_outcome(o: witness_validity_diagnostic_node(d: d.head), f: fn(hn) {
    bind_outcome(o: witness_validity_diagnostic_list_node(xs: d.tail), f: fn(tn) {
      Accepted {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Named { name: witness_validity_diags_field_head },
              target: hn
            },
            Edge {
              label: Named { name: witness_validity_diags_field_tail },
              target: tn
            }
          ]
        },
        diagnostics: None
      }
    })
  })
}


fn witness_validity_diagnostics_node(ds: Diagnostics) -> Outcome<Node> {
  match ds {
    None =>
      Accepted {
        value: witness_validity_symbol_atom_node(s: witness_validity_diagnostics_tag_none),
        diagnostics: None
      }
    Some { diagnostics: nd } =>
      bind_outcome(o: witness_validity_non_empty_diagnostics_node(d: nd), f: fn(ndn) {
        Accepted {
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [
              Edge {
                label: Named { name: witness_validity_diagnostics_tag_some },
                target: ndn
              }
            ]
          },
          diagnostics: None
        }
      })
  }
}


fn witness_validity_outcome_node(o: Outcome<StructuralPropertyWitness>) -> Outcome<Node> {
  match o {
    Accepted { value: w, diagnostics: ds } =>
      bind_outcome(o: witness_validity_diagnostics_node(ds: ds), f: fn(dsn) {
        Accepted {
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [
              Edge {
                label: Named { name: witness_validity_outcome_holds },
                target: Node {
                  kind: TypeNode { connective: Conj },
                  children: [
                    Edge {
                      label: Named { name: witness_validity_outcome_accepted_value },
                      target: witness_validity_witness_node(w: w)
                    },
                    Edge {
                      label: Named { name: witness_validity_outcome_accepted_diagnostics },
                      target: dsn
                    }
                  ]
                }
              }
            ]
          },
          diagnostics: None
        }
      })
    Rejected { diagnostics: d } =>
      bind_outcome(o: witness_validity_non_empty_diagnostics_node(d: d), f: fn(dn) {
        Accepted {
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [
              Edge {
                label: Named { name: witness_validity_outcome_violates },
                target: dn
              }
            ]
          },
          diagnostics: None
        }
      })
  }
}


// T-19 witness-validity emit helper: oracle = v4.std.find_witness::verify_witness; emits
// RoundTripClaim whose input bundles subject + oracle outcome. Rejected only when the
// subject encoding fails closed (e.g. unencodable Textual{ByteRange} locus).
fn testgen_emit_witness_validity_claim(
  label: String,
  source_facts: Node,
  candidate: Node,
  predicate: PreservationPredicate,
  witness: StructuralPropertyWitness
) -> Outcome<TestClaim> {
  bind_outcome(
    o: witness_validity_subject_node(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate,
      witness: witness
    ),
    f: fn(input_node) {
      Accepted {
        value: RoundTripClaim {
          label: label,
          t19_anchor: T19ManualAnchorAbsent,
          input: input_node,
          classification: TestClassification { tier: Tier1, layer: Unit }
        },
        diagnostics: None
      }
    }
  )
}


fn testgen_scheduled_language_behavior_generators() -> List<Generator<TestgenConcept>> {
  [
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: T19ManualLbeConjDagSurface,
      slot: LanguageBehaviorEquivalence {
        subject: lbe_subject_conj_dag_surface(),
        mock: lbe_io_mock_conj_dag_surface(),
      },
    },
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: T19ManualLbeDisjDagSurface,
      slot: LanguageBehaviorEquivalence {
        subject: lbe_subject_disj_dag_surface(),
        mock: lbe_io_mock_disj_dag_surface(),
      },
    },
    Generator {
      classification: TestClassification { tier: Tier1, layer: Unit },
      t19_anchor: T19ManualLbeTransformDagSurface,
      slot: LanguageBehaviorEquivalence {
        subject: lbe_subject_transform_dag_surface(),
        mock: lbe_io_mock_transform_dag_surface(),
      },
    },
  ]
}


fn t19_manual_anchor_absent_bootstrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: t19_manual_anchor_absent_bootstrap,
    at: Textual { file: t19_testgen_lens_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}

fn manual_test_claim_for_manual_anchor(key: T19ManualAnchorKey) -> Outcome<TestClaim> {
  match key {
    T19ManualAnchorAbsent =>
      Rejected { diagnostics: diagnostics_singleton(d: t19_manual_anchor_absent_bootstrap_diagnostic()) }
    T19ManualTcConjEmpty => Accepted { value: claim_conj_empty_compiles, diagnostics: None }
    T19ManualTcDisjEmpty => Accepted { value: claim_disj_empty_compiles, diagnostics: None }
    T19ManualTcArrowTwoConj => Accepted { value: claim_arrow_two_conj_compiles, diagnostics: None }
    T19ManualTcCardinalityEmpty => Accepted { value: claim_cardinality_empty_rejected, diagnostics: None }
    T19ManualTcInstantiationEmpty => Accepted { value: claim_instantiation_empty_rejected, diagnostics: None }
    T19ManualTcArrowEmpty => Accepted { value: claim_arrow_empty_rejected, diagnostics: None }
    T19ManualTcTransformEmpty => Accepted { value: claim_transform_empty_rejected, diagnostics: None }
    T19ManualTcBranchEmpty => Accepted { value: claim_branch_empty_rejected, diagnostics: None }
    T19ManualTcLoopEmpty => Accepted { value: claim_loop_empty_rejected, diagnostics: None }
    T19ManualTcBindZeroChildren => Accepted { value: claim_bind_zero_children_rejected, diagnostics: None }
    T19ManualTcConjEqualsRefl => Accepted { value: claim_conj_equals_refl, diagnostics: None }
    T19ManualNatAddLeftIdentity => Accepted { value: claim_nat_add_left_identity, diagnostics: None }
    T19ManualNatAddRightIdentity => Accepted { value: claim_nat_add_right_identity, diagnostics: None }
    T19ManualNatAddAssociativity => Accepted { value: claim_nat_add_associativity, diagnostics: None }
    T19ManualNatMulLeftIdentity => Accepted { value: claim_nat_mul_left_identity, diagnostics: None }
    T19ManualNatMulAnnihilator => Accepted { value: claim_nat_mul_annihilator, diagnostics: None }
    T19ManualNatMulAssociativity => Accepted { value: claim_nat_mul_associativity, diagnostics: None }
    T19ManualLbeConjDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: T19ManualLbeConjDagSurface,
        label: t19_lbe_label_conj_dag_surface,
        mock: lbe_io_mock_conj_dag_surface()
      )
    T19ManualLbeDisjDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: T19ManualLbeDisjDagSurface,
        label: t19_lbe_label_disj_dag_surface,
        mock: lbe_io_mock_disj_dag_surface()
      )
    T19ManualLbeTransformDagSurface =>
      testgen_emit_language_behavior_equivalence_claim(
        anchor: T19ManualLbeTransformDagSurface,
        label: t19_lbe_label_transform_dag_surface,
        mock: lbe_io_mock_transform_dag_surface()
      )
    T19ManualRefinementNonEmptyListBase =>
      match refinement_preservation_subject_nonempty_list_base() {
        Accepted { value: subject, diagnostics: None } =>
          testgen_emit_refinement_preservation_claim(
            anchor: T19ManualRefinementNonEmptyListBase,
            label: t19_refinement_label_nonempty_list_base,
            subject: subject
          )
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
  }
}


fn testgen_concept_for_manual_claim(claim: TestClaim) -> Outcome<TestgenConcept> {
  match test_claim_t19_anchor(c: claim) {
    T19ManualAnchorAbsent =>
      Rejected { diagnostics: diagnostics_singleton(d: t19_manual_anchor_absent_bootstrap_diagnostic()) }
    T19ManualTcConjEmpty =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        }, diagnostics: None }
    T19ManualTcDisjEmpty =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Disj },
        }, diagnostics: None }
    T19ManualTcArrowTwoConj =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Arrow },
        }, diagnostics: None }
    T19ManualTcCardinalityEmpty =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Cardinality },
        }, diagnostics: None }
    T19ManualTcInstantiationEmpty =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Instantiation },
        }, diagnostics: None }
    T19ManualTcArrowEmpty =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Arrow },
        }, diagnostics: None }
    T19ManualTcTransformEmpty =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Transform },
        }, diagnostics: None }
    T19ManualTcBranchEmpty =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Branch },
        }, diagnostics: None }
    T19ManualTcLoopEmpty =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Loop },
        }, diagnostics: None }
    T19ManualTcBindZeroChildren =>
      Accepted { value: TypeConstruction {
          subject: BehaviorValueSubject { behavior: Bind },
        }, diagnostics: None }
    T19ManualTcConjEqualsRefl =>
      Accepted { value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        }, diagnostics: None }
    T19ManualNatAddLeftIdentity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_additive_monoid,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_add_left_identity,
          },
        }, diagnostics: None }
    T19ManualNatAddRightIdentity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_additive_monoid,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_add_right_identity,
          },
        }, diagnostics: None }
    T19ManualNatAddAssociativity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_additive_monoid,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_add_associativity,
          },
        }, diagnostics: None }
    T19ManualNatMulLeftIdentity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_commutative_semiring,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_mul_left_identity,
          },
        }, diagnostics: None }
    T19ManualNatMulAnnihilator =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_commutative_semiring,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_mul_annihilator,
          },
        }, diagnostics: None }
    T19ManualNatMulAssociativity =>
      Accepted { value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: nat_algebra_law_subject_symbol_commutative_semiring,
            inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
            law: t19_law_nat_mul_associativity,
          },
        }, diagnostics: None }
    T19ManualLbeConjDagSurface =>
      Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_conj_dag_surface(),
          mock: lbe_io_mock_conj_dag_surface(),
        },
        diagnostics: None,
      }
    T19ManualLbeDisjDagSurface =>
      Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_disj_dag_surface(),
          mock: lbe_io_mock_disj_dag_surface(),
        },
        diagnostics: None,
      }
    T19ManualLbeTransformDagSurface =>
      Accepted {
        value: LanguageBehaviorEquivalence {
          subject: lbe_subject_transform_dag_surface(),
          mock: lbe_io_mock_transform_dag_surface(),
        },
        diagnostics: None,
      }
    T19ManualRefinementNonEmptyListBase =>
      match refinement_preservation_subject_nonempty_list_base() {
        Accepted { value: subject, diagnostics: None } =>
          Accepted {
            value: RefinementPreservation {
              subject: subject,
            },
            diagnostics: None,
          }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
  }
}


fn bootstrap_claim_generator_for_manual_anchor(
  key: T19ManualAnchorKey
) -> Outcome<Generator<TestgenConcept>> {
  match manual_test_claim_for_manual_anchor(key: key) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: claim, diagnostics: d0 } =>
      match testgen_concept_for_manual_claim(claim: claim) {
        Rejected { diagnostics: r } =>
          Rejected { diagnostics: rejected_with_pending(pending: d0, rejected: r) }
        Accepted { value: slot, diagnostics: d1 } =>
          Accepted {
            value: Generator {
              classification: test_claim_classification(c: claim),
              t19_anchor: test_claim_t19_anchor(c: claim),
              slot: slot
            },
            diagnostics: diagnostics_merge(outer: d0, inner: d1)
          }
    }
  }
}
