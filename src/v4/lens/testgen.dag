  T19ManualTcConjEqualsRefl,
  T19ManualTcDisjEmpty,
  T19ManualTcInstantiationEmpty,
  T19PresentManualAnchorKey,
  T19PresentManualNatAddAssociativity,
  T19PresentManualNatAddLeftIdentity,
  T19PresentManualNatAddRightIdentity,
  T19PresentManualNatMulAnnihilator,
  T19PresentManualNatMulAssociativity,
  T19PresentManualNatMulLeftIdentity,
  T19PresentManualTcArrowTwoConj,
  T19PresentManualTcCardinalityEmpty,
  T19PresentManualTcConjEmpty,
  T19PresentManualTcConjEqualsRefl,
  T19PresentManualTcDisjEmpty,
  T19PresentManualTcInstantiationEmpty
}
import v4.test.claim.manual.connective_anchors {
  claim_arrow_two_conj_compiles,
  claim_cardinality_empty_compiles,
  claim_conj_empty_compiles,
  claim_conj_equals_refl,
  claim_disj_empty_compiles,
  claim_instantiation_empty_compiles
}
