// src/v4/lens/testgen.dag
// Scope: T-19 testgen — P2 manual-anchor join; Generator carries kind + anchor + classification + subject slot.
// Owns: Generator TestgenConcept bootstrap_assert_kind_for_manual_anchor TypeConstructionSubject AlgebraLawSubject DiagnosticExhaustivenessSubject LensApplicabilitySubject BidirectionalRoundtripSubject
// Consumes: v4.std.node v4.std.verification
// Status: Wave-0 modeled; M2 merge compile + eval T-22.

module v4.lens.testgen


import v4.std.verification {
  TestClassification,
  Tier1,
  Unit,
  AssertKind,
  Compiles,
  Equals,
  t19_present_manual_anchor_key,
  T19ManualAnchorKey,
  T19ManualAnchorAbsent,
  T19ManualTcConjEmpty,
  T19ManualTcDisjEmpty,
  T19ManualTcArrowTwoConj,
  T19ManualTcCardinalityEmpty,
  T19ManualTcInstantiationEmpty,
  T19ManualTcConjEqualsRefl,
  T19ManualNatAddLeftIdentity,
  T19ManualNatAddRightIdentity,
  T19ManualNatAddAssociativity,
  T19ManualNatMulLeftIdentity,
  T19ManualNatMulAnnihilator,
  T19ManualNatMulAssociativity
}
import v4.std.diagnostic {
  Outcome,
  Produced,
  Rejected,
  Diagnostic,
  Unavailable,
  UserInputBoundary,
  Textual,
  WholeFile
}
import v4.std.node {
  Node,
  Connective,
  Conj,
  Disj,
  Arrow,
  Cardinality,
  Instantiation,
  Behavior,
  Symbol
}


type TypeConstructionSubject
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = ConnectiveKernel { connective: Connective }
  | BehaviorValueSubject { behavior: Behavior }


type AlgebraLawSubject { algebra: Symbol, inhabitant: Symbol, law: Symbol }


type DiagnosticExhaustivenessSubject { reason: Symbol }


type LensApplicabilitySubject { lens: Symbol, program: Node }


type BidirectionalRoundtripSubject { language: Symbol, production: Symbol }


type TestgenConcept
// 🟡 coproduct dissolution — DECISIONS.md LB-P4-3212
  = TypeConstruction { subject: TypeConstructionSubject }
  | AlgebraLaw { subject: AlgebraLawSubject }
  | DiagnosticExhaustiveness { subject: DiagnosticExhaustivenessSubject }
  | LensApplicability { subject: LensApplicabilitySubject }
  | BidirectionalRoundtrip { subject: BidirectionalRoundtripSubject }


type Generator<C> {
  classification: TestClassification
  kind: AssertKind
  t19_anchor: T19ManualAnchorKey
  slot: C
}


data t19_bootstrap_algebra: Symbol = t19_bootstrap_algebra


data t19_bootstrap_inhabitant: Symbol = t19_bootstrap_inhabitant


data t19_law_nat_add_left_identity: Symbol = t19_law_nat_add_left_identity


data t19_law_nat_add_right_identity: Symbol = t19_law_nat_add_right_identity


data t19_law_nat_add_associativity: Symbol = t19_law_nat_add_associativity


data t19_law_nat_mul_left_identity: Symbol = t19_law_nat_mul_left_identity


data t19_law_nat_mul_annihilator: Symbol = t19_law_nat_mul_annihilator


data t19_law_nat_mul_associativity: Symbol = t19_law_nat_mul_associativity


data t19_testgen_lens_file: Symbol = t19_testgen_lens_file


data t19_manual_anchor_absent_bootstrap: Symbol = t19_manual_anchor_absent_bootstrap


fn t19_manual_anchor_absent_bootstrap_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: t19_manual_anchor_absent_bootstrap,
    at: Textual { file: t19_testgen_lens_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn bootstrap_tier1_unit_classification() -> TestClassification {
  TestClassification { tier: Tier1, layer: Unit, }
}


fn bootstrap_assert_kind_for_manual_anchor(key: T19ManualAnchorKey) -> Outcome<AssertKind> =
  match key {
    T19ManualAnchorAbsent =>
      Rejected { diagnostic: t19_manual_anchor_absent_bootstrap_diagnostic() }
    T19ManualTcConjEmpty => Produced { value: Compiles }
    T19ManualTcDisjEmpty => Produced { value: Compiles }
    T19ManualTcArrowTwoConj => Produced { value: Compiles }
    T19ManualTcCardinalityEmpty => Produced { value: Compiles }
    T19ManualTcInstantiationEmpty => Produced { value: Compiles }
    T19ManualTcConjEqualsRefl => Produced { value: Equals }
    T19ManualNatAddLeftIdentity => Produced { value: Equals }
    T19ManualNatAddRightIdentity => Produced { value: Equals }
    T19ManualNatAddAssociativity => Produced { value: Equals }
    T19ManualNatMulLeftIdentity => Produced { value: Equals }
    T19ManualNatMulAnnihilator => Produced { value: Equals }
    T19ManualNatMulAssociativity => Produced { value: Equals }
  }


fn testgen_concept_for_manual_anchor(key: T19ManualAnchorKey) -> Outcome<TestgenConcept> =
  match key {
    T19ManualAnchorAbsent =>
      Rejected { diagnostic: t19_manual_anchor_absent_bootstrap_diagnostic() }
    T19ManualTcConjEmpty =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        },
      }
    T19ManualTcDisjEmpty =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Disj },
        },
      }
    T19ManualTcArrowTwoConj =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Arrow },
        },
      }
    T19ManualTcCardinalityEmpty =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Cardinality },
        },
      }
    T19ManualTcInstantiationEmpty =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Instantiation },
        },
      }
    T19ManualTcConjEqualsRefl =>
      Produced {
        value: TypeConstruction {
          subject: ConnectiveKernel { connective: Conj },
        },
      }
    T19ManualNatAddLeftIdentity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: t19_bootstrap_algebra,
            inhabitant: t19_bootstrap_inhabitant,
            law: t19_law_nat_add_left_identity,
          },
        },
      }
    T19ManualNatAddRightIdentity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: t19_bootstrap_algebra,
            inhabitant: t19_bootstrap_inhabitant,
            law: t19_law_nat_add_right_identity,
          },
        },
      }
    T19ManualNatAddAssociativity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: t19_bootstrap_algebra,
            inhabitant: t19_bootstrap_inhabitant,
            law: t19_law_nat_add_associativity,
          },
        },
      }
    T19ManualNatMulLeftIdentity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: t19_bootstrap_algebra,
            inhabitant: t19_bootstrap_inhabitant,
            law: t19_law_nat_mul_left_identity,
          },
        },
      }
    T19ManualNatMulAnnihilator =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: t19_bootstrap_algebra,
            inhabitant: t19_bootstrap_inhabitant,
            law: t19_law_nat_mul_annihilator,
          },
        },
      }
    T19ManualNatMulAssociativity =>
      Produced {
        value: AlgebraLaw {
          subject: AlgebraLawSubject {
            algebra: t19_bootstrap_algebra,
            inhabitant: t19_bootstrap_inhabitant,
            law: t19_law_nat_mul_associativity,
          },
        },
      }
  }


fn bootstrap_claim_generator_for_manual_anchor(
  key: T19ManualAnchorKey
) -> Outcome<Generator<TestgenConcept>> {
  match t19_present_manual_anchor_key(key: key) {
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
    Produced { value: present } =>
      match bootstrap_assert_kind_for_manual_anchor(key: present) {
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
        Produced { value: kind } =>
          match testgen_concept_for_manual_anchor(key: present) {
            Rejected { diagnostic: d } => Rejected { diagnostic: d }
            Produced { value: slot } =>
              Produced {
                value: Generator {
                  classification: bootstrap_tier1_unit_classification(),
                  kind: kind,
                  t19_anchor: present,
                  slot: slot,
                }
              }
          }
      }
  }
}
