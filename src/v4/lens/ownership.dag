// src/v4/lens/ownership.dag
// Scope: ownership lens — proves no aliased mutation in emitted code.
// Owns: OwnershipMode, OwnershipFact, ownership_witness, ownership_classify.
// Consumes: v4.std.algebra (bag_eq), v4.std.dependency (ClassifiedDependencyView<C>), v4.std.witness, v4.compiler.infer.
// Status: T-13 family ratchet — projection-only over `List<DependencyView>` via parametric `ClassifiedDependencyView<OwnershipMode>`; no copied endpoints (Practice 11 sub-rule: parallel-payload vs typed-reference). Resource access/alias-mode evidence is routed via `RequiresAccessWitness`; deriving the closed access carrier is a tracked follow-up to the #3468 codex BLOCKING reviews.


module v4.lens.ownership

import v4.compiler.infer { InferredTree }
import v4.std.algebra { bag_eq, list_snoc_item }
import v4.std.collection { List }
import v4.std.dependency {
  ClassifiedDependencyView,
  DependencyKindClassifier,
  DependencyView,
  classify_dependency_view,
  classified_dependency_view_eq
}
import v4.std.logic { Bool }
import v4.std.witness { Holds, Witness }

// 🟢 projection-only classification. `RequiresAccessWitness` is the
// fail-closed slot for resource/effect edges that need access evidence.
type OwnershipMode
  = OwnedContainment
  | SharedRead
  | RequiresAccessWitness
  | BorrowedDependency
  | UnknownOwnership

type OwnershipFact {
  dependencies: List<ClassifiedDependencyView<OwnershipMode>>
}

fn ownership_dependency_kind_classifier() -> DependencyKindClassifier<OwnershipMode> {
  DependencyKindClassifier {
    contains: OwnedContainment,
    binds_to: BorrowedDependency,
    type_depends_on: UnknownOwnership,
    data_depends_on: SharedRead,
    effect_depends_on: RequiresAccessWitness,
    resource_depends_on: RequiresAccessWitness,
    module_depends_on: UnknownOwnership,
    barrier_before: UnknownOwnership,
    placement_depends_on: UnknownOwnership,
    model_depends_on: UnknownOwnership,
    projection_depends_on: UnknownOwnership,
    generated_from: UnknownOwnership,
    verified_by: UnknownOwnership,
    promoted_by: UnknownOwnership,
    bootstrap_depends_on: UnknownOwnership
  }
}

fn ownership_classify(view: DependencyView) -> ClassifiedDependencyView<OwnershipMode> {
  classify_dependency_view(classifier: ownership_dependency_kind_classifier(), view: view)
}

fn ownership_fact(tree: InferredTree, dependencies: List<DependencyView>) -> OwnershipFact {
  OwnershipFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_snoc_item(xs: acc, item: ownership_classify(view: view))
    })
  }
}

fn ownership_witness(tree: InferredTree, dependencies: List<DependencyView>) -> Witness<OwnershipFact> {
  Holds {
    value: ownership_fact(tree: tree, dependencies: dependencies)
  }
}

fn ownership_mode_eq(a: OwnershipMode, b: OwnershipMode) -> Bool {
  match a {
    OwnedContainment => match b {
      OwnedContainment => true
      _ => false
    }
    SharedRead => match b {
      SharedRead => true
      _ => false
    }
    RequiresAccessWitness => match b {
      RequiresAccessWitness => true
      _ => false
    }
    BorrowedDependency => match b {
      BorrowedDependency => true
      _ => false
    }
    UnknownOwnership => match b {
      UnknownOwnership => true
      _ => false
    }
  }
}

fn ownership_classified_eq(
  a: ClassifiedDependencyView<OwnershipMode>,
  b: ClassifiedDependencyView<OwnershipMode>
) -> Bool {
  classified_dependency_view_eq(a: a, b: b, classification_eq: ownership_mode_eq)
}

fn ownership_fact_eq(a: OwnershipFact, b: OwnershipFact) -> Bool {
  bag_eq(xs: a.dependencies, ys: b.dependencies, eq: ownership_classified_eq)
}
