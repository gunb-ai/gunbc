// src/v4/lens/ownership.dag
// Scope: ownership lens — proves no aliased mutation in emitted code.
// Owns: OwnershipMode, OwnershipFact, ownership_witness, ownership_classify.
// Consumes: v4.std.algebra (bag_eq), v4.std.dependency (ClassifiedDependencyView<C>), v4.std.witness, v4.compiler.infer.
// Status: T-13 family ratchet — projection-only over `List<DependencyView>` via parametric `ClassifiedDependencyView<OwnershipMode>`; no copied endpoints (Practice 11 sub-rule: parallel-payload vs typed-reference). Resource access/alias-mode evidence is routed via `RequiresAccessWitness`; deriving the closed access carrier is a tracked follow-up to the #3468 codex BLOCKING reviews.


module v4.lens.ownership

import v4.compiler.infer { InferredTree }
import v4.std.algebra { bag_eq }
import v4.std.collection { List }
import v4.std.dependency {
  BarrierBefore,
  BindsTo,
  BootstrapDependsOn,
  ClassifiedDependencyView,
  Contains,
  DataDependsOn,
  DependencyView,
  EffectDependsOn,
  GeneratedFrom,
  ModelDependsOn,
  ModuleDependsOn,
  PlacementDependsOn,
  ProjectionDependsOn,
  PromotedBy,
  ResourceDependsOn,
  TypeDependsOn,
  VerifiedBy,
  classified_dependency_view_eq
}
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  Textual,
  Unavailable,
  WholeFile
}
import v4.std.logic { Bool }
import v4.std.witness { Holds, Violates, Witness }

data ownership_reason_unresolved_projection: Symbol = ownership_reason_unresolved_projection
data ownership_projection_virtual_file: Symbol = ownership_projection_virtual_file

// 🟢 projection-only classification. `RequiresAccessWitness` is the
// fail-closed slot for resource/effect edges that need access evidence.
type OwnershipMode
  = OwnedContainment
  | SharedRead
  | RequiresAccessWitness
  | BorrowedDependency
  | UnknownOwnership

type OwnershipFact {
  dependencies: List<ClassifiedDependencyView<OwnershipMode>>
}

fn ownership_mode_for_dependency(view: DependencyView) -> OwnershipMode {
  match view.kind {
    Contains => OwnedContainment
    BindsTo => BorrowedDependency
    DataDependsOn => SharedRead
    EffectDependsOn => RequiresAccessWitness
    ResourceDependsOn => RequiresAccessWitness
    BarrierBefore => UnknownOwnership
    TypeDependsOn => UnknownOwnership
    ModuleDependsOn => UnknownOwnership
    PlacementDependsOn => UnknownOwnership
    ModelDependsOn => UnknownOwnership
    ProjectionDependsOn => UnknownOwnership
    GeneratedFrom => UnknownOwnership
    VerifiedBy => UnknownOwnership
    PromotedBy => UnknownOwnership
    BootstrapDependsOn => UnknownOwnership
  }
}

fn ownership_classify(view: DependencyView) -> ClassifiedDependencyView<OwnershipMode> {
  ClassifiedDependencyView {
    dependency: view,
    classification: ownership_mode_for_dependency(view: view)
  }
}

fn ownership_fact(tree: InferredTree, dependencies: List<DependencyView>) -> OwnershipFact {
  OwnershipFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_push(acc, ownership_classify(view: view))
    })
  }
}

fn ownership_mode_unresolved(mode: OwnershipMode) -> Bool {
  match mode {
    RequiresAccessWitness => true
    UnknownOwnership => true
    OwnedContainment => false
    SharedRead => false
    BorrowedDependency => false
  }
}

fn ownership_fact_unresolved(fact: OwnershipFact) -> Bool {
  fold(fact.dependencies, init: false, f: fn(acc, dep) {
    acc || ownership_mode_unresolved(mode: dep.classification)
  })
}

fn ownership_witness_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ownership_reason_unresolved_projection,
    at: Textual { file: ownership_projection_virtual_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn ownership_witness(tree: InferredTree, dependencies: List<DependencyView>) -> Witness<OwnershipFact> {
  let fact = ownership_fact(tree: tree, dependencies: dependencies)
  if ownership_fact_unresolved(fact: fact) {
    Violates { diagnostic: ownership_witness_diagnostic() }
  } else {
    Holds { value: fact }
  }
}

fn ownership_mode_eq(a: OwnershipMode, b: OwnershipMode) -> Bool {
  match a {
    OwnedContainment => match b {
      OwnedContainment => true
      _ => false
    }
    SharedRead => match b {
      SharedRead => true
      _ => false
    }
    RequiresAccessWitness => match b {
      RequiresAccessWitness => true
      _ => false
    }
    BorrowedDependency => match b {
      BorrowedDependency => true
      _ => false
    }
    UnknownOwnership => match b {
      UnknownOwnership => true
      _ => false
    }
  }
}

fn ownership_classified_eq(
  a: ClassifiedDependencyView<OwnershipMode>,
  b: ClassifiedDependencyView<OwnershipMode>
) -> Bool {
  classified_dependency_view_eq(a: a, b: b, classification_eq: ownership_mode_eq)
}

fn ownership_fact_eq(a: OwnershipFact, b: OwnershipFact) -> Bool {
  bag_eq(xs: a.dependencies, ys: b.dependencies, eq: ownership_classified_eq)
}
