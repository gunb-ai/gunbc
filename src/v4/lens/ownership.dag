// src/v4/lens/ownership.dag
//
// Scope: ownership lens — proves no aliased mutation in emitted code.
// Anchor: https://doc.rust-lang.org/book/ch04-00-understanding-ownership.html + https://en.wikipedia.org/wiki/Linear_type_system
//
// Owns:
//   - lens read: Node -> Witness<OwnershipMap>
//   - aliasing modeled in substrate (cardinality + behavior)
//
// Consumes:
//   - std/node.dag, std/cardinality.dag, std/witness.dag
//
// Status: scaffold — fill per TASKS.md T-13
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.lens.ownership

import v4.compiler.infer { InferredTree }
import v4.std.dependency {
  BindsTo,
  Contains,
  DataDependsOn,
  DependencyView,
  EffectDependsOn,
  ResourceDependsOn,
  dependency_lens
}
import v4.std.node { Node }
import v4.std.witness { Holds, Witness }

// 🟢 projection carrier — ownership is read from dependency/resource shape.
// This lens does not model a target-specific borrow checker; emit/eval
// consume this map when they realize the target memory model.
type OwnershipMode
  = OwnedContainment
  | SharedRead
  | ExclusiveMutation
  | BorrowedDependency

type OwnershipDependencyFact {
  owner: Node
  subject: Node
  dependency: DependencyView
  mode: OwnershipMode
}

type OwnershipFact {
  dependencies: List<OwnershipDependencyFact>
}

fn ownership_mode_for_dependency(view: DependencyView) -> OwnershipMode {
  match view.kind {
    Contains => OwnedContainment
    BindsTo => BorrowedDependency
    DataDependsOn => SharedRead
    EffectDependsOn => ExclusiveMutation
    ResourceDependsOn => ExclusiveMutation
    _ => BorrowedDependency
  }
}

fn ownership_dependency_fact(view: DependencyView) -> OwnershipDependencyFact {
  OwnershipDependencyFact {
    owner: view.source,
    subject: view.dependent,
    dependency: view,
    mode: ownership_mode_for_dependency(view: view)
  }
}

fn ownership_fact_from_dependencies(dependencies: List<DependencyView>) -> OwnershipFact {
  OwnershipFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_push(acc, ownership_dependency_fact(view: view))
    })
  }
}

fn ownership_fact(tree: InferredTree) -> OwnershipFact {
  ownership_fact_from_dependencies(dependencies: dependency_lens(root: tree.root))
}

fn ownership_witness(tree: InferredTree) -> Witness<OwnershipFact> {
  Holds {
    value: ownership_fact(tree: tree)
  }
}
