// src/v4/lens/parallelism.dag
// Scope: parallelism lens — independence visible in dependency-graph structure (THESIS:208).
// Owns: ParallelismRelation, ParallelismFact, parallelism_witness.
// Consumes: v4.std.algebra (bag_eq), v4.std.dependency (ClassifiedDependencyView<C>), v4.std.witness, v4.compiler.infer.
// Status: T-13 family ratchet — projection-only over `List<DependencyView>` via parametric `ClassifiedDependencyView<ParallelismRelation>`; no copied endpoints, no parallel substrate (Practice 11 sub-rule: parallel-payload vs typed-reference).


module v4.lens.parallelism

import v4.compiler.infer { InferredTree }
import v4.std.algebra { bag_eq, list_snoc_item }
import v4.std.collection { List }
import v4.std.dependency {
  ClassifiedDependencyView,
  DependencyKindClassifier,
  DependencyView,
  classify_dependency_view,
  classified_dependency_view_eq
}
import v4.std.logic { Bool }
import v4.std.witness { Holds, Witness }

// 🟢 lens-specific classification; endpoints live on the inner DependencyView.
type ParallelismRelation
  = DataDependent
  | EffectCoupled
  | BarrierCoupled
  | UnknownCoupling

type ParallelismFact {
  dependencies: List<ClassifiedDependencyView<ParallelismRelation>>
}

fn parallelism_dependency_kind_classifier() -> DependencyKindClassifier<ParallelismRelation> {
  DependencyKindClassifier {
    contains: DataDependent,
    binds_to: DataDependent,
    type_depends_on: UnknownCoupling,
    data_depends_on: DataDependent,
    effect_depends_on: EffectCoupled,
    resource_depends_on: EffectCoupled,
    module_depends_on: UnknownCoupling,
    barrier_before: BarrierCoupled,
    placement_depends_on: UnknownCoupling,
    model_depends_on: UnknownCoupling,
    projection_depends_on: UnknownCoupling,
    generated_from: UnknownCoupling,
    verified_by: UnknownCoupling,
    promoted_by: UnknownCoupling,
    bootstrap_depends_on: UnknownCoupling
  }
}

fn parallelism_classify(view: DependencyView) -> ClassifiedDependencyView<ParallelismRelation> {
  classify_dependency_view(classifier: parallelism_dependency_kind_classifier(), view: view)
}

fn parallelism_fact(tree: InferredTree, dependencies: List<DependencyView>) -> ParallelismFact {
  ParallelismFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_snoc_item(xs: acc, item: parallelism_classify(view: view))
    })
  }
}

fn parallelism_witness(tree: InferredTree, dependencies: List<DependencyView>) -> Witness<ParallelismFact> {
  Holds {
    value: parallelism_fact(tree: tree, dependencies: dependencies)
  }
}

fn parallelism_relation_eq(a: ParallelismRelation, b: ParallelismRelation) -> Bool {
  match a {
    DataDependent => match b {
      DataDependent => true
      _ => false
    }
    EffectCoupled => match b {
      EffectCoupled => true
      _ => false
    }
    BarrierCoupled => match b {
      BarrierCoupled => true
      _ => false
    }
    UnknownCoupling => match b {
      UnknownCoupling => true
      _ => false
    }
  }
}

fn parallelism_classified_eq(
  a: ClassifiedDependencyView<ParallelismRelation>,
  b: ClassifiedDependencyView<ParallelismRelation>
) -> Bool {
  classified_dependency_view_eq(a: a, b: b, classification_eq: parallelism_relation_eq)
}

fn parallelism_fact_eq(a: ParallelismFact, b: ParallelismFact) -> Bool {
  bag_eq(xs: a.dependencies, ys: b.dependencies, eq: parallelism_classified_eq)
}
