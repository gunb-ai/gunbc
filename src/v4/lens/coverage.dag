// 🟡 coproduct dissolution — SL-COVERAGE-DEFECT-KEY.
type CoverageDefectKey
  = DiscriminantPredicate
  | DegenerateType
  | HollowType
  | CarrierClone
  | Catamorphism
  | TemplateHole
  | OffSubstrateFact
  | WrongHome
  | VacuousArm
  | CanonicalCarrier
  | PlausibleFallback
  | ParallelAuthority
