// 🟡 gated — feature:testgen-concept-reflection — bind task: src/v4/TASKS.md#t-19-lenstestgendag
// dissolve-on-arrival: project expected TestgenConcept rows from manual-anchor manifest + scheduled generators.
fn expected_testgen_coverage_keys() -> List<TestgenCoverageKey> {
  fold_list_right(
    xs: expected_type_construction_testgen_keys(),
    empty: fold_list_right(
      xs: expected_algebra_law_testgen_keys(),
      empty: fold_list_right(
        xs: expected_language_behavior_equivalence_testgen_keys(),
        empty: [DiagnosticExhaustiveness],
        snoc: fn(acc, item) {
          dedupe_snoc(acc: acc, item: item, eq: testgen_coverage_key_eq)
        }
      ),
      snoc: fn(acc, item) {
        dedupe_snoc(acc: acc, item: item, eq: testgen_coverage_key_eq)
      }
    ),
    snoc: fn(acc, item) {
      dedupe_snoc(acc: acc, item: item, eq: testgen_coverage_key_eq)
    }
  )
}


fn testgen_coverage_key_from_claim(c: TestClaim) -> Outcome<TestgenCoverageKey> {
  match testgen_concept_for_manual_claim(claim: c) {
    Accepted { value: concept, diagnostics: None } =>
      Accepted { value: concept, diagnostics: None }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}


fn l7_coverage_key_from_manual_anchor(anchor: T19ManualAnchorKey) -> Outcome<L7CoverageKey> {
  match anchor {
    T19ManualNatAddLeftIdentity =>
      Accepted {
        value: nat_add_law_subject(law: t19_law_nat_add_left_identity),
        diagnostics: None,
      }
    T19ManualNatAddRightIdentity =>
      Accepted {
        value: nat_add_law_subject(law: t19_law_nat_add_right_identity),
        diagnostics: None,
      }
    T19ManualNatAddAssociativity =>
      Accepted {
        value: nat_add_law_subject(law: t19_law_nat_add_associativity),
        diagnostics: None,
      }
    T19ManualNatMulLeftIdentity =>
      Accepted {
        value: nat_mul_law_subject(law: t19_law_nat_mul_left_identity),
        diagnostics: None,
      }
    T19ManualNatMulAnnihilator =>
      Accepted {
        value: nat_mul_law_subject(law: t19_law_nat_mul_annihilator),
        diagnostics: None,
      }
    T19ManualNatMulAssociativity =>
      Accepted {
        value: nat_mul_law_subject(law: t19_law_nat_mul_associativity),
        diagnostics: None,
      }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_l7_anchor_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}


fn l7_coverage_key_from_claim(c: TestClaim) -> Outcome<L7CoverageKey> {
  match test_claim_t19_anchor(c: c) {
    T19ManualClaimAnchor { manual_anchor: anchor } =>
      l7_coverage_key_from_manual_anchor(anchor: anchor)
    T19GeneratedClaimAnchor { generated_anchor: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_l7_anchor_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}


fn l6_coverage_key_from_testgen_concept(concept: TestgenConcept) -> Outcome<L6CoverageKey> {
  match concept {
    TypeConstruction { subject: subject } =>
      Accepted {
        value: l6_coverage_key(
          subject: subject,
          language: dag_language_model_surface_id
        ),
        diagnostics: None,
      }
    LanguageBehaviorEquivalence { subject: subject, mock: _ } =>
      Accepted {
        value: l6_coverage_key(subject: subject.subject, language: subject.language),
        diagnostics: None,
      }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_l6_concept_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}


fn l6_coverage_key_from_claim(c: TestClaim) -> Outcome<L6CoverageKey> {
  bind_outcome(
    o: testgen_coverage_key_from_claim(c: c),
    f: fn(concept) {
      l6_coverage_key_from_testgen_concept(concept: concept)
    }
  )
}


// 🟡 gated — feature:impossible-bug-claim-projection — bind task: src/v4/TASKS.md#t-18-lenscoveragedag
// dissolve-on-arrival: TestClaim carries ImpossibleBugClass or canonical witness anchor; forbidden: reason-symbol shadow tables outside verification.
fn impossible_bug_coverage_key_from_diagnostic_reason(reason: Symbol) -> Outcome<ImpossibleBugCoverageKey> {
  if reason == coverage_impossible_bug_reason_suboptimal_complexity ||
    reason == coverage_impossible_bug_reason_suboptimal_inhabitance {
    Accepted {
      value: ImpossibleBugCoverageKey { bug_class: SuboptimalComplexity },
      diagnostics: None,
    }
  } else if reason == coverage_impossible_bug_reason_idempotency_violation ||
    reason == coverage_impossible_bug_reason_idempotency_repetition {
    Accepted {
      value: ImpossibleBugCoverageKey { bug_class: IdempotencyContract },
      diagnostics: None,
    }
  } else if reason == coverage_impossible_bug_reason_transport_drift ||
    reason == coverage_impossible_bug_reason_target_transport_drift {
    Accepted {
      value: ImpossibleBugCoverageKey { bug_class: TransportTypeDrift },
      diagnostics: None,
    }
  } else if reason == coverage_impossible_bug_reason_nested_optional ||
    reason == coverage_impossible_bug_reason_double_unwrap {
    Accepted {
      value: ImpossibleBugCoverageKey { bug_class: NestedOptionalFlatten },
      diagnostics: None,
    }
  } else if reason == coverage_impossible_bug_reason_redundant_read {
    Accepted {
      value: ImpossibleBugCoverageKey { bug_class: UnenumeratedEffects },
      diagnostics: None,
    }
  } else if reason == coverage_impossible_bug_reason_unhandled_division ||
    reason == coverage_impossible_bug_reason_unhandled_index ||
    reason == coverage_impossible_bug_reason_force_unwrap {
    Accepted {
      value: ImpossibleBugCoverageKey { bug_class: UnhandledDiagnosticPaths },
      diagnostics: None,
    }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: Diagnostic {
          reason: coverage_reason_impossible_bug_diagnostic_unmapped,
          at: Textual { file: coverage_virtual_file, extent: WholeFile },
          correction: Unavailable { reason: UserInputBoundary }
        }
      )
    }
  }
}


data coverage_impossible_bug_reason_suboptimal_complexity: Symbol = coverage_impossible_bug_reason_suboptimal_complexity
data coverage_impossible_bug_reason_suboptimal_inhabitance: Symbol = coverage_impossible_bug_reason_suboptimal_inhabitance
data coverage_impossible_bug_reason_idempotency_violation: Symbol = coverage_impossible_bug_reason_idempotency_violation
data coverage_impossible_bug_reason_idempotency_repetition: Symbol = coverage_impossible_bug_reason_idempotency_repetition
data coverage_impossible_bug_reason_transport_drift: Symbol = coverage_impossible_bug_reason_transport_drift
data coverage_impossible_bug_reason_target_transport_drift: Symbol = coverage_impossible_bug_reason_target_transport_drift
data coverage_impossible_bug_reason_nested_optional: Symbol = coverage_impossible_bug_reason_nested_optional
data coverage_impossible_bug_reason_double_unwrap: Symbol = coverage_impossible_bug_reason_double_unwrap
data coverage_impossible_bug_reason_redundant_read: Symbol = coverage_impossible_bug_reason_redundant_read
data coverage_impossible_bug_reason_unhandled_division: Symbol = coverage_impossible_bug_reason_unhandled_division
data coverage_impossible_bug_reason_unhandled_index: Symbol = coverage_impossible_bug_reason_unhandled_index
data coverage_impossible_bug_reason_force_unwrap: Symbol = coverage_impossible_bug_reason_force_unwrap


fn impossible_bug_coverage_key_from_claim(c: TestClaim) -> Outcome<ImpossibleBugCoverageKey> {
  match c {
    DiagnosticClaim { expected_rejection: d, label: _, t19_anchor: _, input: _, classification: _ } =>
      impossible_bug_coverage_key_from_diagnostic_reason(reason: d.head.reason)
    CompilesClaim { label: _, t19_anchor: _, input: _, expected_value: _, classification: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
    EqualsClaim { label: _, t19_anchor: _, lhs: _, rhs: _, classification: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
    RoundTripClaim { label: _, t19_anchor: _, input: _, classification: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}


fn collect_testgen_coverage_keys(corpus: List<TestClaim>) -> List<TestgenCoverageKey> {
  fold_list(
    xs: corpus,
    empty: Empty,
    cons: fn(acc, claim) {
      match testgen_coverage_key_from_claim(c: claim) {
        Accepted { value: key, diagnostics: None } =>
          dedupe_snoc(acc: acc, item: key, eq: testgen_coverage_key_eq)
        Rejected { diagnostics: _ } => acc
      }
    }
  )
}


fn collect_l7_coverage_keys(corpus: List<TestClaim>) -> List<L7CoverageKey> {
  fold_list(
    xs: corpus,
    empty: Empty,
    cons: fn(acc, claim) {
      match l7_coverage_key_from_claim(c: claim) {
        Accepted { value: key, diagnostics: None } =>
          dedupe_snoc(acc: acc, item: key, eq: l7_coverage_key_eq)
        Rejected { diagnostics: _ } => acc
      }
    }
  )
}


fn collect_l6_coverage_keys(corpus: List<TestClaim>) -> List<L6CoverageKey> {
  fold_list(
    xs: corpus,
    empty: Empty,
    cons: fn(acc, claim) {
      match l6_coverage_key_from_claim(c: claim) {
        Accepted { value: key, diagnostics: None } =>
          dedupe_snoc(acc: acc, item: key, eq: l6_coverage_key_eq)
        Rejected { diagnostics: _ } => acc
      }
    }
