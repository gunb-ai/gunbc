// src/v4/lens/coverage.dag
// Scope: T-18 meta-lens — expected vs actual TestClaim coverage over substrate slices.
// Owns: Coverage<C> L6CoverageKey L7CoverageKey ImpossibleBugCoverageKey TestgenCoverageKey DissolutionLensKey DissolutionLensAcceptanceKey
// Consumes: std/node std/witness std/diagnostic std/verification std/algebra extdeps/languages lens/testgen
// Status: scaffold — fill per TASKS T-18.

module v4.lens.coverage


import v4.std.node { Symbol }
import v4.std.verification { ImpossibleBugClass }
import v4.lens.testgen { TestgenConcept, AlgebraLawSubject, TypeConstructionSubject }


type Coverage<C> {
  concern: C
}


type L6CoverageKey {
  subject: TypeConstructionSubject
  language: Symbol
}


type L7CoverageKey = AlgebraLawSubject


type ImpossibleBugCoverageKey {
  bug_class: ImpossibleBugClass
}


type TestgenCoverageKey = TestgenConcept


// Acceptance surface for docs/design-dissolution-lens.md Layer 1. The
// meta-lens keys are data, not a script: downstream coverage can ask whether
// each required dissolution lens has a structural acceptance witness.
// 🟢 coproduct dissolution — closed checklist for the current L1.1–L1.12 batch.
type DissolutionLensKey
  = L1_1DiscriminantPredicate
  | L1_2DegenerateType
  | L1_3HollowType
  | L1_4CarrierClone
  | L1_5Catamorphism
  | L1_6EmitTemplate
  | L1_7OffSubstrateFact
  | L1_8WrongHome
  | L1_9VacuousArm
  | L1_10StringEscapeHatch
  | L1_11PlausibleFallback
  | L1_12ParallelAuthority


type DissolutionLensAcceptanceKey {
  lens: DissolutionLensKey
}


type DissolutionLensAcceptance = Coverage<DissolutionLensAcceptanceKey>


data dissolution_l1_1_discriminant_predicate: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_1DiscriminantPredicate }
}
data dissolution_l1_2_degenerate_type: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_2DegenerateType }
}
data dissolution_l1_3_hollow_type: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_3HollowType }
}
data dissolution_l1_4_carrier_clone: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_4CarrierClone }
}
data dissolution_l1_5_catamorphism: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_5Catamorphism }
}
data dissolution_l1_6_emit_template: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_6EmitTemplate }
}
data dissolution_l1_7_off_substrate_fact: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_7OffSubstrateFact }
}
data dissolution_l1_8_wrong_home: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_8WrongHome }
}
data dissolution_l1_9_vacuous_arm: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_9VacuousArm }
}
data dissolution_l1_10_string_escape_hatch: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_10StringEscapeHatch }
}
data dissolution_l1_11_plausible_fallback: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_11PlausibleFallback }
}
data dissolution_l1_12_parallel_authority: DissolutionLensAcceptance = {
  concern: DissolutionLensAcceptanceKey { lens: L1_12ParallelAuthority }
}
