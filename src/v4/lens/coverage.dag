fn testgen_coverage_key_from_claim(c: TestClaim) -> Outcome<TestgenCoverageKey> {
  match testgen_concept_for_manual_claim(claim: c) {
    Accepted { value: concept, diagnostics: None } =>
      Accepted { value: concept, diagnostics: None }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}


fn l7_coverage_key_from_testgen_concept(concept: TestgenConcept) -> Outcome<L7CoverageKey> {
  match concept {
    AlgebraLaw { subject: subject } =>
      Accepted { value: subject, diagnostics: None }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_l7_anchor_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}


fn l7_coverage_key_from_claim(c: TestClaim) -> Outcome<L7CoverageKey> {
  bind_outcome(
    o: testgen_coverage_key_from_claim(c: c),
    f: fn(concept) {
      l7_coverage_key_from_testgen_concept(concept: concept)
    }
  )
}


fn l6_coverage_key_from_testgen_concept(concept: TestgenConcept) -> Outcome<L6CoverageKey> {
  match concept {
    TypeConstruction { subject: subject } =>
      Accepted {
        value: l6_coverage_key(
          subject: subject,
          language: dag_language_model_surface_id
        ),
        diagnostics: None,
      }
    LanguageBehaviorEquivalence { subject: subject, mock: _ } =>
      Accepted {
        value: l6_coverage_key(subject: subject.subject, language: subject.language),
        diagnostics: None,
      }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_l6_concept_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}


fn l6_coverage_key_from_claim(c: TestClaim) -> Outcome<L6CoverageKey> {
  bind_outcome(
    o: testgen_coverage_key_from_claim(c: c),
    f: fn(concept) {
      l6_coverage_key_from_testgen_concept(concept: concept)
    }
  )
}


fn impossible_bug_coverage_key_from_diagnostic_reason(reason: Symbol) -> Outcome<ImpossibleBugCoverageKey> {
  bind_outcome(
    o: impossible_bug_class_from_diagnostic_reason(reason: reason),
    f: fn(bug_class) {
      Accepted {
        value: ImpossibleBugCoverageKey { bug_class: bug_class },
        diagnostics: None,
      }
    }
  )
}


fn append_impossible_bug_key_from_diagnostic(
  acc: List<ImpossibleBugCoverageKey>,
  diagnostic: Diagnostic
) -> Outcome<List<ImpossibleBugCoverageKey>> {
  match impossible_bug_coverage_key_from_diagnostic_reason(reason: diagnostic.reason) {
    Accepted { value: key, diagnostics: None } =>
      Accepted {
        value: dedupe_snoc(acc: acc, item: key, eq: impossible_bug_coverage_key_eq),
        diagnostics: None,
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}


fn append_impossible_bug_keys(
  acc: List<ImpossibleBugCoverageKey>,
  keys: List<ImpossibleBugCoverageKey>
) -> List<ImpossibleBugCoverageKey> {
  fold_list_right(
    xs: keys,
    empty: acc,
    snoc: fn(a, key) {
      dedupe_snoc(acc: a, item: key, eq: impossible_bug_coverage_key_eq)
    }
  )
}


fn fold_diagnostic_tail_into_impossible_bug_keys(
  acc: List<ImpossibleBugCoverageKey>,
  tail: List<Diagnostic>
) -> Outcome<List<ImpossibleBugCoverageKey>> {
  fold_list(
    xs: tail,
    empty: outcome_accepted(value: acc),
    cons: fn(o, diagnostic) {
      bind_outcome(
        o: o,
        f: fn(keys) {
          append_impossible_bug_key_from_diagnostic(acc: keys, diagnostic: diagnostic)
        }
      )
    }
  )
}


type SoleImpossibleBugKeyFold {
  count: Int
  key: ImpossibleBugCoverageKey
}


fn sole_impossible_bug_coverage_key_fold(
  state: SoleImpossibleBugKeyFold,
  key: ImpossibleBugCoverageKey
) -> SoleImpossibleBugKeyFold {
  SoleImpossibleBugKeyFold {
    count: state.count + 1,
    key: key,
  }
}


fn sole_impossible_bug_coverage_key(
  keys: List<ImpossibleBugCoverageKey>
) -> Outcome<ImpossibleBugCoverageKey> {
  let state = fold_list_right(
    xs: keys,
    empty: SoleImpossibleBugKeyFold {
      count: 0,
      key: ImpossibleBugCoverageKey { bug_class: IdempotencyContract },
    },
    snoc: fn(s, key) {
      sole_impossible_bug_coverage_key_fold(state: s, key: key)
    }
  )
  match state.count {
    0 =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
    1 =>
      Accepted { value: state.key, diagnostics: None }
    _ =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}


fn impossible_bug_coverage_keys_from_diagnostics(d: NonEmptyDiagnostics) -> Outcome<List<ImpossibleBugCoverageKey>> {
  match append_impossible_bug_key_from_diagnostic(acc: Empty, diagnostic: d.head) {
    Accepted { value: acc, diagnostics: None } =>
      fold_diagnostic_tail_into_impossible_bug_keys(acc: acc, tail: d.tail)
    Rejected { diagnostics: rd } => Rejected { diagnostics: rd }
  }
}


fn impossible_bug_coverage_key_from_claim(c: TestClaim) -> Outcome<ImpossibleBugCoverageKey> {
  match c {
    DiagnosticClaim { expected_rejection: d, label: _, anchor: _, input: _, classification: _ } =>
      bind_outcome(
        o: impossible_bug_coverage_keys_from_diagnostics(d: d),
        f: fn(keys) {
          sole_impossible_bug_coverage_key(keys: keys)
        }
      )
    CompilesClaim { label: _, anchor: _, input: _, expected_value: _, classification: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
    EqualsClaim { label: _, anchor: _, lhs: _, rhs: _, classification: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
    RoundTripClaim { label: _, anchor: _, input: _, classification: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: coverage_reason_impossible_bug_diagnostic_unmapped,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}


fn testgen_coverage_keys_from_claim(c: TestClaim) -> List<TestgenCoverageKey> {
  match testgen_coverage_key_from_claim(c: c) {
    Accepted { value: key, diagnostics: None } =>
      list_snoc_item(xs: Empty, item: key)
    Rejected { diagnostics: _ } => Empty
  }
}


fn append_testgen_keys_from_claim(
  acc: List<TestgenCoverageKey>,
  claim: TestClaim
) -> List<TestgenCoverageKey> {
  fold_list_right(
    xs: testgen_coverage_keys_from_claim(c: claim),
    empty: acc,
    snoc: fn(a, key) {
      dedupe_snoc(acc: a, item: key, eq: testgen_coverage_key_eq)
    }
  )
}


fn collect_testgen_coverage_keys(corpus: List<TestClaim>) -> List<TestgenCoverageKey> {
  fold_list(
    xs: corpus,
    empty: Empty,
    cons: fn(acc, claim) {
      append_testgen_keys_from_claim(acc: acc, claim: claim)
    }
  )
}


fn l7_coverage_keys_from_claim(c: TestClaim) -> List<L7CoverageKey> {
  match l7_coverage_key_from_claim(c: c) {
    Accepted { value: key, diagnostics: None } =>
      list_snoc_item(xs: Empty, item: key)
    Rejected { diagnostics: _ } => Empty
  }
}


fn append_l7_keys_from_claim(
  acc: List<L7CoverageKey>,
  claim: TestClaim
) -> List<L7CoverageKey> {
  fold_list_right(
    xs: l7_coverage_keys_from_claim(c: claim),
    empty: acc,
    snoc: fn(a, key) {
      dedupe_snoc(acc: a, item: key, eq: l7_coverage_key_eq)
    }
  )
}


fn collect_l7_coverage_keys(corpus: List<TestClaim>) -> List<L7CoverageKey> {
  fold_list(
    xs: corpus,
    empty: Empty,
    cons: fn(acc, claim) {
      append_l7_keys_from_claim(acc: acc, claim: claim)
    }
  )
}


fn l6_coverage_keys_from_claim(c: TestClaim) -> List<L6CoverageKey> {
  match l6_coverage_key_from_claim(c: c) {
    Accepted { value: key, diagnostics: None } =>
      list_snoc_item(xs: Empty, item: key)
    Rejected { diagnostics: _ } => Empty
  }
}


fn append_l6_keys_from_claim(
  acc: List<L6CoverageKey>,
  claim: TestClaim
) -> List<L6CoverageKey> {
  fold_list_right(
    xs: l6_coverage_keys_from_claim(c: claim),
    empty: acc,
    snoc: fn(a, key) {
      dedupe_snoc(acc: a, item: key, eq: l6_coverage_key_eq)
    }
  )
}


fn collect_l6_coverage_keys(corpus: List<TestClaim>) -> List<L6CoverageKey> {
  fold_list(
    xs: corpus,
    empty: Empty,
    cons: fn(acc, claim) {
      append_l6_keys_from_claim(acc: acc, claim: claim)
    }
  )
}


fn impossible_bug_coverage_keys_from_claim(c: TestClaim) -> List<ImpossibleBugCoverageKey> {
  match c {
    DiagnosticClaim { expected_rejection: d, label: _, anchor: _, input: _, classification: _ } =>
      match impossible_bug_coverage_keys_from_diagnostics(d: d) {
        Accepted { value: keys, diagnostics: None } => keys
        Rejected { diagnostics: _ } => Empty
      }
    _ => Empty
  }
}


fn collect_impossible_bug_coverage_keys(corpus: List<TestClaim>) -> List<ImpossibleBugCoverageKey> {
  fold_list(
    xs: corpus,
    empty: Empty,
    cons: fn(acc, claim) {
      append_impossible_bug_keys(
        acc: acc,
        keys: impossible_bug_coverage_keys_from_claim(c: claim)
      )
    }
  )
}


fn coverage_reading(corpus: List<TestClaim>) -> CoverageReading {
  CoverageReading {
    l6_missing: missing_coverage(
      expected: expected_l6_coverage_keys(),
      actual: collect_l6_coverage_keys(corpus: corpus),
      eq: l6_coverage_key_eq
    ),
    l7_missing: missing_coverage(
      expected: expected_l7_coverage_keys(),
      actual: collect_l7_coverage_keys(corpus: corpus),
      eq: l7_coverage_key_eq
    ),
    impossible_bug_missing: missing_coverage(
      expected: expected_impossible_bug_coverage_keys(),
      actual: collect_impossible_bug_coverage_keys(corpus: corpus),
      eq: impossible_bug_coverage_key_eq
    ),
    testgen_missing: missing_coverage(
      expected: expected_testgen_coverage_keys(),
      actual: collect_testgen_coverage_keys(corpus: corpus),
      eq: testgen_coverage_key_eq
    ),
  }
}


fn coverage_reading_complete(r: CoverageReading) -> Bool {
  is_empty(xs: r.l6_missing) &&
    is_empty(xs: r.l7_missing) &&
    is_empty(xs: r.impossible_bug_missing) &&
    is_empty(xs: r.testgen_missing)
}


fn coverage_incomplete_diagnostic(r: CoverageReading) -> Diagnostic {
  match is_empty(xs: r.l6_missing) {
    false =>
      Diagnostic {
        reason: coverage_reason_l6_missing,
        at: Textual { file: coverage_virtual_file, extent: WholeFile },
        correction: Unavailable { reason: UserInputBoundary }
      }
    true =>
      match is_empty(xs: r.l7_missing) {
        false =>
          Diagnostic {
            reason: coverage_reason_l7_missing,
            at: Textual { file: coverage_virtual_file, extent: WholeFile },
            correction: Unavailable { reason: UserInputBoundary }
          }
        true =>
          match is_empty(xs: r.impossible_bug_missing) {
            false =>
              Diagnostic {
                reason: coverage_reason_impossible_bug_missing,
                at: Textual { file: coverage_virtual_file, extent: WholeFile },
                correction: Unavailable { reason: UserInputBoundary }
              }
            true =>
              match is_empty(xs: r.testgen_missing) {
                false =>
                  Diagnostic {
                    reason: coverage_reason_testgen_missing,
                    at: Textual { file: coverage_virtual_file, extent: WholeFile },
                    correction: Unavailable { reason: UserInputBoundary }
                  }
                true =>
                  Diagnostic {
                    reason: coverage_reason_incomplete,
                    at: Textual { file: coverage_virtual_file, extent: WholeFile },
                    correction: Unavailable { reason: UserInputBoundary }
                  }
              }
          }
      }
  }
}


fn coverage_lens(corpus: List<TestClaim>) -> Witness<CoverageReading> {
  let reading = coverage_reading(corpus: corpus)
  if coverage_reading_complete(r: reading) {
    Holds { value: reading }
  } else {
    Violates { diagnostic: coverage_incomplete_diagnostic(r: reading) }
  }
}
