}


fn collect_impossible_bug_coverage_keys(corpus: List<TestClaim>) -> List<ImpossibleBugCoverageKey> {
  fold_list(
    xs: corpus,
    empty: Empty,
    cons: fn(acc, claim) {
      match impossible_bug_coverage_key_from_claim(c: claim) {
        Accepted { value: key, diagnostics: None } =>
          dedupe_snoc(acc: acc, item: key, eq: impossible_bug_coverage_key_eq)
        Rejected { diagnostics: _ } => acc
      }
    }
  )
}


fn coverage_reading(corpus: List<TestClaim>) -> CoverageReading {
  CoverageReading {
    l6_missing: missing_coverage(
      expected: expected_l6_coverage_keys(),
      actual: collect_l6_coverage_keys(corpus: corpus),
      eq: l6_coverage_key_eq
    ),
    l7_missing: missing_coverage(
      expected: expected_l7_coverage_keys(),
      actual: collect_l7_coverage_keys(corpus: corpus),
      eq: l7_coverage_key_eq
    ),
    impossible_bug_missing: missing_coverage(
      expected: expected_impossible_bug_coverage_keys(),
      actual: collect_impossible_bug_coverage_keys(corpus: corpus),
      eq: impossible_bug_coverage_key_eq
    ),
    testgen_missing: missing_coverage(
      expected: expected_testgen_coverage_keys(),
      actual: collect_testgen_coverage_keys(corpus: corpus),
      eq: testgen_coverage_key_eq
    ),
  }
}


fn coverage_reading_complete(r: CoverageReading) -> Bool {
  is_empty(xs: r.l6_missing) &&
    is_empty(xs: r.l7_missing) &&
    is_empty(xs: r.impossible_bug_missing) &&
    is_empty(xs: r.testgen_missing)
}


fn coverage_incomplete_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: coverage_reason_incomplete,
    at: Textual { file: coverage_virtual_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn coverage_lens(corpus: List<TestClaim>) -> Witness<CoverageReading> {
  let reading = coverage_reading(corpus: corpus)
  if coverage_reading_complete(r: reading) {
    Holds { value: reading }
  } else {
    Violates { diagnostic: coverage_incomplete_diagnostic() }
  }
}
