    TransportTypeDrift =>
      match b.bug_class {
        TransportTypeDrift => true
        _ => false
      }
    NestedOptionalFlatten =>
      match b.bug_class {
        NestedOptionalFlatten => true
        _ => false
      }
    UnenumeratedEffects =>
      match b.bug_class {
        UnenumeratedEffects => true
        _ => false
      }
    UnhandledDiagnosticPaths =>
      match b.bug_class {
        UnhandledDiagnosticPaths => true
        _ => false
      }
  }
}


// 🟡 gated — derived-equality interim (docs/modeling-discipline.md Practice 10) — bound target: W-T-10 exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace frozen_language_behavior_snapshot_eq / language_behavior_io_mock_eq call sites with the substrate equality primitive and delete these helpers in that same PR; forbidden: permanent per-field LBE mock equality table drift from lens/testgen.dag.
fn frozen_language_behavior_snapshot_eq(
  a: FrozenLanguageBehaviorSnapshot,
  b: FrozenLanguageBehaviorSnapshot
) -> Bool {
  a.language == b.language &&
    a.input_node == b.input_node &&
    a.expected_value == b.expected_value
}


fn language_behavior_io_mock_eq(a: LanguageBehaviorIoMock, b: LanguageBehaviorIoMock) -> Bool {
  frozen_language_behavior_snapshot_eq(a: a.snapshot, b: b.snapshot)
}


// 🟡 gated — derived-equality interim (docs/modeling-discipline.md Practice 10) — bound target: W-T-10 exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace lens_applicability_subject_eq / bidirectional_roundtrip_subject_eq / node_list_eq / refinement_preservation_subject_eq call sites with the substrate equality primitive and delete these helpers in that same PR; forbidden: permanent per-field TestgenConcept subject equality table drift from lens/testgen.dag.
fn lens_applicability_subject_eq(a: LensApplicabilitySubject, b: LensApplicabilitySubject) -> Bool {
  a.lens == b.lens && a.program == b.program
}


fn bidirectional_roundtrip_subject_eq(
  a: BidirectionalRoundtripSubject,
  b: BidirectionalRoundtripSubject
) -> Bool {
  a.language == b.language && a.production == b.production
}


fn node_list_eq(a: List<Node>, b: List<Node>) -> Bool {
  a == b
}


fn refinement_preservation_subject_eq(
  a: RefinementPreservationSubject,
  b: RefinementPreservationSubject
) -> Bool {
  a.refined.base == b.refined.base && node_list_eq(a: a.original, b: b.original)
}


