// 🟡 gated — derived-equality interim (docs/modeling-discipline.md Practice 10) — bound target: W-T-10 exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace connective_eq / behavior_eq / type_construction_subject_eq call sites with the substrate equality primitive and delete these helpers in that same PR; forbidden: permanent per-variant Connective/Behavior equality table drift from std/node.dag.
fn connective_eq(a: Connective, b: Connective) -> Bool {
  match a {
    Atom { identity: ai } =>
      match b {
        Atom { identity: bi } => ai == bi
        _ => false
      }
    Conj =>
      match b {
        Conj => true
        _ => false
      }
    Disj =>
      match b {
        Disj => true
        _ => false
      }
    Arrow =>
      match b {
        Arrow => true
        _ => false
      }
    Cardinality =>
      match b {
        Cardinality => true
        _ => false
      }
    Instantiation =>
      match b {
        Instantiation => true
        _ => false
      }
  }
}


fn behavior_eq(a: Behavior, b: Behavior) -> Bool {
  match a {
    Value =>
      match b {
        Value => true
        _ => false
      }
    Transform =>
      match b {
        Transform => true
        _ => false
      }
    Branch =>
      match b {
        Branch => true
        _ => false
      }
    Loop =>
      match b {
        Loop => true
        _ => false
      }
    Bind =>
      match b {
        Bind => true
        _ => false
      }
  }
}


fn type_construction_subject_eq(a: TypeConstructionSubject, b: TypeConstructionSubject) -> Bool {
  match a {
    ConnectiveKernel { connective: ac } =>
      match b {
        ConnectiveKernel { connective: bc } => connective_eq(a: ac, b: bc)
        _ => false
      }
    BehaviorValueSubject { behavior: ab } =>
      match b {
        BehaviorValueSubject { behavior: bb } => behavior_eq(a: ab, b: bb)
        _ => false
      }
  }
}


fn algebra_law_subject_eq(a: AlgebraLawSubject, b: AlgebraLawSubject) -> Bool {
  a.algebra == b.algebra && a.inhabitant == b.inhabitant && a.law == b.law
}


fn l6_coverage_key_eq(a: L6CoverageKey, b: L6CoverageKey) -> Bool {
  a.language == b.language &&
    type_construction_subject_eq(a: a.subject, b: b.subject)
}


fn l7_coverage_key_eq(a: L7CoverageKey, b: L7CoverageKey) -> Bool {
  algebra_law_subject_eq(a: a, b: b)
}


// 🟡 gated — derived-equality interim (docs/modeling-discipline.md Practice 10) — bound target: W-T-10 exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace impossible_bug_coverage_key_eq call sites with the substrate ImpossibleBugClass equality primitive and delete this helper in that same PR; forbidden: permanent per-variant ImpossibleBugClass equality table drift from std/verification.dag.
fn impossible_bug_coverage_key_eq(a: ImpossibleBugCoverageKey, b: ImpossibleBugCoverageKey) -> Bool {
  match a.bug_class {
    SuboptimalComplexity =>
      match b.bug_class {
        SuboptimalComplexity => true
        _ => false
      }
    IdempotencyContract =>
      match b.bug_class {
        IdempotencyContract => true
        _ => false
      }
    TransportTypeDrift =>
      match b.bug_class {
        TransportTypeDrift => true
        _ => false
      }
    NestedOptionalFlatten =>
      match b.bug_class {
        NestedOptionalFlatten => true
        _ => false
      }
    UnenumeratedEffects =>
      match b.bug_class {
        UnenumeratedEffects => true
        _ => false
      }
    UnhandledDiagnosticPaths =>
      match b.bug_class {
        UnhandledDiagnosticPaths => true
        _ => false
      }
  }
}


// 🟡 gated — derived-equality interim (docs/modeling-discipline.md Practice 10) — bound target: W-T-10 exact structural equality / compiler-provided closed-sum equality — bind node://adhoc-35324347-e8a — dissolve-on-arrival: replace testgen_coverage_key_eq call sites with the substrate TestgenConcept equality primitive and delete this helper in that same PR; forbidden: permanent per-variant TestgenConcept equality table drift from lens/testgen.dag.
fn testgen_coverage_key_eq(a: TestgenCoverageKey, b: TestgenCoverageKey) -> Bool {
  match a {
    TypeConstruction { subject: as } =>
      match b {
        TypeConstruction { subject: bs } =>
          type_construction_subject_eq(a: as, b: bs)
        _ => false
      }
    AlgebraLaw { subject: as } =>
      match b {
        AlgebraLaw { subject: bs } => algebra_law_subject_eq(a: as, b: bs)
        _ => false
      }
    DiagnosticExhaustiveness =>
      match b {
        DiagnosticExhaustiveness => true
        _ => false
      }
    LensApplicability { subject: _ } =>
      match b {
        LensApplicability { subject: _ } => true
        _ => false
      }
    BidirectionalRoundtrip { subject: _ } =>
      match b {
        BidirectionalRoundtrip { subject: _ } => true
        _ => false
      }
    LanguageBehaviorEquivalence { subject: as, mock: _ } =>
      match b {
        LanguageBehaviorEquivalence { subject: bs, mock: _ } =>
          type_construction_subject_eq(a: as.subject, b: bs.subject) &&
            as.language == bs.language
        _ => false
      }
    RefinementPreservation { subject: _ } =>
      match b {
        RefinementPreservation { subject: _ } => true
        _ => false
      }
  }
}


fn l6_coverage_key(subject: TypeConstructionSubject, language: Symbol) -> L6CoverageKey {
  L6CoverageKey { subject: subject, language: language }
}


fn coverage_of<C>(key: C) -> Coverage<C> {
  Coverage { concern: key }
}


fn dedupe_snoc<C>(acc: List<C>, item: C, eq: fn(C, C) -> Bool) -> List<C> {
  if contains(xs: acc, item: item, eq: eq) {
    acc
  } else {
    Cons { head: item, tail: acc }
  }
}


fn missing_keys<C>(
  expected: List<C>,
  actual: List<C>,
  eq: fn(C, C) -> Bool
) -> List<C> {
  filter(xs: expected, predicate: fn(key) {
    match contains(xs: actual, item: key, eq: eq) {
      true => false
      false => true
    }
  })
}


fn missing_coverage<C>(
  expected: List<C>,
  actual: List<C>,
  eq: fn(C, C) -> Bool
) -> List<Coverage<C>> {
  fold_list_right(
    xs: missing_keys(expected: expected, actual: actual, eq: eq),
    empty: Empty,
    snoc: fn(acc, key) {
      Cons { head: coverage_of(key: key), tail: acc }
    }
  )
}


fn bootstrap_l6_language_surfaces() -> List<Symbol> {
  [dag_language_model_surface_id]
}


fn bootstrap_type_construction_subjects() -> List<TypeConstructionSubject> {
  [
    ConnectiveKernel { connective: Conj },
    ConnectiveKernel { connective: Disj },
    ConnectiveKernel { connective: Arrow },
    ConnectiveKernel { connective: Cardinality },
    ConnectiveKernel { connective: Instantiation },
    BehaviorValueSubject { behavior: Value },
    BehaviorValueSubject { behavior: Transform },
    BehaviorValueSubject { behavior: Branch },
    BehaviorValueSubject { behavior: Loop },
    BehaviorValueSubject { behavior: Bind },
  ]
}


fn append_l6_keys_for_language(
  subjects: List<TypeConstructionSubject>,
  language: Symbol,
  acc: List<L6CoverageKey>
) -> List<L6CoverageKey> {
  fold_list_right(
    xs: subjects,
    empty: acc,
    snoc: fn(tail, subject) {
      Cons {
        head: l6_coverage_key(subject: subject, language: language),
        tail: tail
      }
    }
  )
}


fn expected_l6_coverage_keys() -> List<L6CoverageKey> {
  fold_list_right(
    xs: bootstrap_l6_language_surfaces(),
    empty: Empty,
    snoc: fn(acc, language) {
      append_l6_keys_for_language(
        subjects: bootstrap_type_construction_subjects(),
        language: language,
        acc: acc
      )
    }
  )
}


fn nat_add_law_subject(law: Symbol) -> AlgebraLawSubject {
  AlgebraLawSubject {
    algebra: nat_algebra_law_subject_symbol_additive_monoid,
    inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
    law: law,
  }
}


fn nat_mul_law_subject(law: Symbol) -> AlgebraLawSubject {
  AlgebraLawSubject {
    algebra: nat_algebra_law_subject_symbol_commutative_semiring,
    inhabitant: nat_algebra_law_subject_symbol_inhabitant_nat,
    law: law,
  }
}


fn expected_l7_coverage_keys() -> List<L7CoverageKey> {
  [
    nat_add_law_subject(law: t19_law_nat_add_left_identity),
    nat_add_law_subject(law: t19_law_nat_add_right_identity),
    nat_add_law_subject(law: t19_law_nat_add_associativity),
    nat_mul_law_subject(law: t19_law_nat_mul_left_identity),
    nat_mul_law_subject(law: t19_law_nat_mul_annihilator),
    nat_mul_law_subject(law: t19_law_nat_mul_associativity),
  ]
}


