// src/v4/lens/complexity.dag
//
// Scope: complexity lens — structural fact carried by data model, not behavioral test.
// Anchor: https://en.wikipedia.org/wiki/Computational_complexity_theory + https://en.wikipedia.org/wiki/Big_O_notation
// Unifies: (per THESIS:187) coercion cost = complexity. The cost of converting between representations IS a complexity-lens read; no parallel CoercionCost carrier. A worker computing coercion cost reads via this lens.
//
// U2 (operator-ratified 2026-05-15): this lens is the asymptotic
// PROJECTION of `lens/cost.dag`'s SymbolicCost — it CONSUMES that
// carrier and never independently re-derives cost. One mechanism, two
// projections (SymbolicCost = the realization-cost expression;
// ComplexityBound = its asymptotic class). Re-deriving here would create
// a second cost authority — forbidden (the parallel-authority bug U1/U2
// foreclose).
//
// Owns:
//   - Complexity dimension type
//   - lens read: Node -> Witness<ComplexityBound>
//     (the asymptotic projection of cost.dag's SymbolicCost — consumed,
//     not re-derived)
//   - reads program structure; no heuristic, no escape
//
// Consumes:
//   - std/node.dag, std/witness.dag, std/diagnostic.dag
//
// Status: scaffold — fill per TASKS.md T-12
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.lens.complexity


import v4.lens.cost {
  AsymptoticClass,
  ClassExponential,
  ClassFactorial,
  ClassLinear,
  ClassLinearithmic,
  ClassLog,
  ClassPolynomial,
  ClassPolyLog,
  SymbolicCost,
  SizeVariable,
  asymptotic_class_dominates,
  asymptotic_class_of_cost,
  cost_lens
}
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  NodeLocus,
  Textual,
  WholeFile,
  Unavailable
}
import v4.std.node { Node, Symbol }
import v4.std.witness { Holds, Violates, Witness }


data complexity_reason_unmodeled_cost_projection: Symbol = complexity_reason_unmodeled_cost_projection
data complexity_projection_virtual_file: Symbol = complexity_projection_virtual_file

// ComplexityBound is the asymptotic projection of `SymbolicCost`. The
// `class` relation remains owned by `cost.dag`; this carrier packages the
// projected user-facing bound without adding another cost mechanism.
// 🟢 coproduct dissolution — T-12-COMPLEXITY-PROJECTION.
type ComplexityBound
  = Constant
  | Logarithmic { size_var: SizeVariable }
  | Linear { size_var: SizeVariable }
  | Polynomial { size_var: SizeVariable, degree: Int }
  | Exponential { size_var: SizeVariable }
  | Factorial { size_var: SizeVariable }
  | Unknown { diagnostic: Diagnostic }

fn unknown_complexity() -> ComplexityBound {
  Unknown { diagnostic: complexity_projection_diagnostic() }
}

fn complexity_bound_from_cost(cost: SymbolicCost) -> ComplexityBound {
  match cost {
    ConstantCost { value: _ } => Constant
    LogCost { variable: v } => Logarithmic { size_var: v }
    LinearCost { variable: v } => Linear { size_var: v }
    PolynomialCost { variable: v, degree: d } => Polynomial { size_var: v, degree: d }
    PolyLogCost { variable: _, exponent: _ } => unknown_complexity()
    ExponentialCost { variable: v, base: _ } => Exponential { size_var: v }
    FactorialCost { variable: v } => Factorial { size_var: v }
    SumCost { lhs: lhs, rhs: rhs } =>
      dominant_complexity_bound(
        a: complexity_bound_from_cost(cost: lhs),
        b: complexity_bound_from_cost(cost: rhs)
      )
    ProductCost { lhs: lhs, rhs: rhs } =>
      multiply_complexity_bounds(
        a: complexity_bound_from_cost(cost: lhs),
        b: complexity_bound_from_cost(cost: rhs)
      )
    UnknownCost { reason: _ } => unknown_complexity()
  }
}

fn dominant_complexity_bound(a: ComplexityBound, b: ComplexityBound) -> ComplexityBound {
  if complexity_bound_dominates(a: a, b: b) {
    a
  } else {
    b
  }
}

fn complexity_projection_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: complexity_reason_unmodeled_cost_projection,
    at: Textual { file: complexity_projection_virtual_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn asymptotic_projection(cost_witness: Witness<SymbolicCost>) -> Witness<ComplexityBound> {
  match cost_witness {
    Holds { value: cost } =>
      Holds { value: complexity_bound_from_cost(cost: cost) }
    Violates { diagnostic: d } =>
      Violates { diagnostic: d }
  }
}

fn complexity_lens(n: Node) -> Witness<ComplexityBound> {
  asymptotic_projection(cost_witness: cost_lens(n: n))
}

fn complexity_bound_class(b: ComplexityBound) -> AsymptoticClass {
  match b {
    Constant => ClassConstant
    Logarithmic { size_var: _ } => ClassLog
    Linear { size_var: _ } => ClassLinear
    Polynomial { size_var: _, degree: d } => ClassPolynomial { degree: d }
    Exponential { size_var: _ } => ClassExponential
    Factorial { size_var: _ } => ClassFactorial
    Unknown { diagnostic: _ } => ClassUnknown
  }
}

fn complexity_bound_dominates(a: ComplexityBound, b: ComplexityBound) -> Bool {
  asymptotic_class_dominates(
    a: complexity_bound_class(b: a),
    b: complexity_bound_class(b: b)
  )
}

fn multiply_complexity_bounds(a: ComplexityBound, b: ComplexityBound) -> ComplexityBound {
  match a {
    Constant => b
    Unknown { diagnostic: _ } => a
    Factorial { size_var: _ } => a
    Exponential { size_var: _ } =>
      match b {
        Factorial { size_var: _ } => b
        Unknown { diagnostic: _ } => b
        _ => a
      }
    Polynomial { size_var: v, degree: ad } =>
      match b {
        Constant => a
        Logarithmic { size_var: _ } => a
        Linear { size_var: _ } => Polynomial { size_var: v, degree: ad + 1 }
        Polynomial { size_var: _, degree: bd } => Polynomial { size_var: v, degree: ad + bd }
        Exponential { size_var: _ } => b
        Factorial { size_var: _ } => b
        Unknown { diagnostic: _ } => b
      }
    Linear { size_var: v } =>
      match b {
        Constant => a
        Logarithmic { size_var: _ } => Polynomial { size_var: v, degree: 2 }
        Linear { size_var: _ } => Polynomial { size_var: v, degree: 2 }
        Polynomial { size_var: _, degree: bd } => Polynomial { size_var: v, degree: bd + 1 }
        Exponential { size_var: _ } => b
        Factorial { size_var: _ } => b
        Unknown { diagnostic: _ } => b
      }
    Logarithmic { size_var: v } =>
      match b {
        Constant => a
        Logarithmic { size_var: _ } => Polynomial { size_var: v, degree: 1 }
        Linear { size_var: bv } => Polynomial { size_var: bv, degree: 2 }
        Polynomial { size_var: _, degree: _ } => b
        Exponential { size_var: _ } => b
        Factorial { size_var: _ } => b
        Unknown { diagnostic: _ } => b
      }
  }
}
