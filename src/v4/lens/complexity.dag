// src/v4/lens/complexity.dag
//
// Scope: complexity lens — structural fact carried by data model, not behavioral test.
// Anchor: https://en.wikipedia.org/wiki/Computational_complexity_theory + https://en.wikipedia.org/wiki/Big_O_notation
// Unifies: (per THESIS:187) coercion cost = complexity. The cost of converting between representations IS a complexity-lens read; no parallel CoercionCost carrier. A worker computing coercion cost reads via this lens.
//
// U2 (operator-ratified 2026-05-15): this lens is the asymptotic
// PROJECTION of `lens/cost.dag`'s SymbolicCost — it CONSUMES that
// carrier and never independently re-derives cost. One mechanism, two
// projections (SymbolicCost = the realization-cost expression;
// ComplexityBound = its asymptotic class). Re-deriving here would create
// a second cost authority — forbidden (the parallel-authority bug U1/U2
// foreclose).
//
// Owns:
//   - Complexity dimension type
//   - lens read: Node -> Witness<ComplexityBound>
//     (the asymptotic projection of cost.dag's SymbolicCost — consumed,
//     not re-derived)
//   - reads program structure; no heuristic, no escape
//
// Consumes:
//   - std/node.dag, std/witness.dag, std/diagnostic.dag
//
// Status: scaffold — fill per TASKS.md T-12
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.lens.complexity


import v4.lens.cost {
  AsymptoticClass,
  ClassConstant,
  ClassUnknown,
  SymbolicCost,
  asymptotic_class_dominates,
  asymptotic_class_of_cost,
  symbolic_cost_of
}
import v4.std.diagnostic {
  AmbiguousIntent,
  Diagnostic,
  NodeLocus,
  Unavailable
}
import v4.std.node { Node, Symbol }
import v4.std.witness { Holds, Violates, Witness }


data complexity_reason_unmodeled_cost_projection: Symbol = complexity_reason_unmodeled_cost_projection

type ComplexityBound {
  class: AsymptoticClass
}

fn complexity_bound_from_cost(cost: SymbolicCost) -> ComplexityBound {
  ComplexityBound {
    class: asymptotic_class_of_cost(cost: cost)
  }
}

fn complexity_projection_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: complexity_reason_unmodeled_cost_projection,
    at: NodeLocus { node: n },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn complexity_of(n: Node) -> Witness<ComplexityBound> {
  match symbolic_cost_of(n: n) {
    Holds { value: cost } =>
      Holds { value: complexity_bound_from_cost(cost: cost) }
    Violates { diagnostic: d } =>
      Violates { diagnostic: d }
  }
}

fn complexity_bound_dominates(a: ComplexityBound, b: ComplexityBound) -> Bool {
  asymptotic_class_dominates(a: a.class, b: b.class)
}
