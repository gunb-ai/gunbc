module v4.lens.registry

import v4.std.node { Symbol }
import v4.std.text { String }

// 🟢 closed set — MODELING.md M4 / PREFIX-T-23-registry (`LensIdV0`).
// 🟢 coproduct dissolution — PREFIX-T-23-registry (`LensModulePathV0`).
type LensIdV0 = Complexity | Cost | Parallelism | EffectEnumeration | Idempotency | Provenance | UnusedParameters | StructuralResolution

// 🟢 coproduct dissolution — PREFIX-T-23-registry (`LensModulePathV0`).
type LensModulePathV0 = Bound { path: String } | Unbound

type LensRegistryEntryV0 {
  lens_id: LensIdV0
  module_path: LensModulePathV0
}

// P9 registry-owned-fn authority: closed v0 enumeration (feature:p9-llvm-instruction-cost-registry-owner).
type LensOwnedFnV0 {
  fn_name: Symbol
  owner_module_path: String
}

data symbol_llvm_instruction_cost: Symbol = symbol_llvm_instruction_cost

data lens_owned_fn_llvm_instruction_cost: LensOwnedFnV0 = {
  fn_name: symbol_llvm_instruction_cost,
  owner_module_path: "v4.lens.cost"
}

// Closed registry surface for P9 receipts — exclusivity is over this list until M2 fn-def scan lands.
data lens_owned_fn_registry_v0: List<LensOwnedFnV0> = [
  lens_owned_fn_llvm_instruction_cost
]

data lens_registry_v0_complexity: LensRegistryEntryV0 = {
  lens_id: Complexity
  module_path: Bound { path: "v4.lens.complexity" }
}

data lens_registry_v0_cost: LensRegistryEntryV0 = {
  lens_id: Cost
  module_path: Bound { path: "v4.lens.cost" }
}

data lens_registry_v0_parallelism: LensRegistryEntryV0 = {
  lens_id: Parallelism
  module_path: Bound { path: "v4.lens.parallelism" }
}

data lens_registry_v0_effect_enumeration: LensRegistryEntryV0 = {
  lens_id: EffectEnumeration
  module_path: Bound { path: "v4.lens.effect" }
}

data lens_registry_v0_idempotency: LensRegistryEntryV0 = {
  lens_id: Idempotency
  module_path: Bound { path: "v4.lens.idempotency" }
}

data lens_registry_v0_provenance: LensRegistryEntryV0 = {
  lens_id: Provenance
  module_path: Bound { path: "v4.lens.ownership" }
}

data lens_registry_v0_unused_parameters: LensRegistryEntryV0 = {
  lens_id: UnusedParameters
  module_path: Bound { path: "v4.lens.unused_parameters" }
}

data lens_registry_v0_structural_resolution: LensRegistryEntryV0 = {
  lens_id: StructuralResolution
  module_path: Bound { path: "v4.lens.structural_resolution" }
