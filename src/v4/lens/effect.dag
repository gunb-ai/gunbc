// src/v4/lens/effect.dag
//
// Scope: effect lens — effects derived from type-signature shape, no parallel taxonomy.
// Anchor: https://en.wikipedia.org/wiki/Effect_system
//
// B3 (operator-ratified 2026-05-15): the TYPE SIGNATURE is the single
// effect authority. This lens READS effects from the signature shape; it
// does not own a taxonomy. `coordination.dag` may carry only one tracked
// yellow effect-kind scaffold until this lens derives that fact from the
// signature; empty marker carriers or wrapper-selected effect families
// are a second authority = STOP (same single-authority class as the
// AssertKind/testgen reconciliation). One authority: the signature.
//
// B-5 (side-session 2026-05-15) — effect GRANULARITY is the
// affected_set R1 usefulness contract (= #3153 Ex.R1, now encoded):
//   - Effect is a per-`Arrow`-Node fact, derived from THAT node's
//     signature shape (the B3 authority). It MUST NOT be aggregated to
//     a coarser unit (one ambient `IO`, a per-module/file effect set).
//     A coarse aggregate is exactly the parallel taxonomy B3 forbids
//     (P2, second authority) AND it degrades affected_set R1: a coarse
//     model ⇒ every effectful edit's re-exec cone = every effectful
//     node ⇒ purity-skip becomes "re-run ~everything" (still CORRECT /
//     fail-closed, but useless).
//   - This is a GRANULARITY invariant, not effect-lens strength: per B3
//     effects are READ off the signature (strong by construction); the
//     only open risk is coarse modeling. So the contract is: keep the
//     effect distinguishable per effect KIND on the signature (Stderr ≠
//     Net ≠ FileWrite …), so affected_set R1's cone is "observers of
//     THIS effect", not "all effectful code". Not a new field; the
//     distinction already lives in the signature (B3) — this forbids
//     collapsing it. Reciprocal contract: lens/affected_set.dag R1.
//   - B-5 COROLLARY — effects-as-parameters (DI-by-construction;
//     side-session 2026-05-16, an interesting case worth recording for
//     later readers). An effectful function takes its effect carrier as
//     an EXPLICIT parameter (THESIS World-threading: "effects are
//     explicit parameters, mocking is dependency-injection-by-
//     construction"); it never reaches an ambient/global effect. Why
//     this matters to affected_set: a test that injects a MOCK carrier
//     passes a *different `Node`* as that argument, so its B-4
//     node-precise dependency edge points at the mock, NOT the real
//     effectful function. Editing the real function's body changes its
//     content_hash but the traversal never reaches the mock-injected
//     unit test ⇒ it SKIPS automatically; the integration test that
//     passed the REAL carrier has the edge ⇒ it RE-RUNS. "Affected" is
//     thus consumer-relative WITHOUT any unit-vs-integration mode in
//     the lens — it falls out of each test's DI-resolved graph. This
//     ONLY holds if effects are threaded parameters; AMBIENT/global
//     effects re-couple the cone and are the anti-pattern this corollary
//     forbids (T-13/T-21 must not model effects ambiently). (Honest
//     boundary: a re-run integration test whose observed behavior
//     changed may now have a STALE expected value — affected_set
//     surfaces "re-run", it never rewrites the expectation; updating
//     the TestClaim is a deliberate human act, no-engine. That failure
//     is the intended signal, not a lens defect.)
//
// Owns:
//   - lens read: Node -> Witness<EffectMap>   (READS the type signature;
//     the signature is the authority, this lens is the reader)
//   - returned-modified-resource = write; returned-derived-value = read
//   - 5-behavior compositional fold; no OperationEffect taxonomy
//
// Consumes:
//   - std/node.dag, std/witness.dag
//
// Status: scaffold — fill per TASKS.md T-13
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.lens.effect

import v4.compiler.infer { InferredFacts, InferredTree }
import v4.std.dependency {
  BarrierBefore,
  DataDependsOn,
  DependencyView,
  EffectDependsOn,
  ResourceDependsOn
}
import v4.std.node { Node }
import v4.std.witness { Holds, Witness }

// 🟢 projection carrier — Practice 11: effect facts are read from the
// dependency projection and the inferred root, not authored as a second
// OperationEffect taxonomy.
type EffectKind
  = PureEffect
  | ReadEffect
  | WriteEffect
  | BarrierEffect

type EffectDependencyFact {
  at: Node
  dependency: DependencyView
  source_facts: Witness<InferredFacts>
  dependent_facts: Witness<InferredFacts>
  effect: EffectKind
}

type EffectFact {
  dependencies: List<EffectDependencyFact>
}

fn effect_kind_for_dependency(view: DependencyView) -> EffectKind {
  match view.kind {
    DataDependsOn => ReadEffect
    EffectDependsOn => WriteEffect
    ResourceDependsOn => WriteEffect
    BarrierBefore => BarrierEffect
    _ => PureEffect
  }
}

fn inferred_facts_for_node(tree: InferredTree, node: Node) -> Witness<InferredFacts> {
  tree.facts.lookup(node)
}

fn effect_dependency_fact(tree: InferredTree, view: DependencyView) -> EffectDependencyFact {
  EffectDependencyFact {
    at: view.source,
    dependency: view,
    source_facts: inferred_facts_for_node(tree: tree, node: view.source),
    dependent_facts: inferred_facts_for_node(tree: tree, node: view.dependent),
    effect: effect_kind_for_dependency(view: view)
  }
}

fn effect_fact_from_dependencies(tree: InferredTree, dependencies: List<DependencyView>) -> EffectFact {
  EffectFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_push(acc, effect_dependency_fact(tree: tree, view: view))
    })
  }
}

fn effect_fact(tree: InferredTree, dependencies: List<DependencyView>) -> EffectFact {
  effect_fact_from_dependencies(tree: tree, dependencies: dependencies)
}

fn effect_witness(tree: InferredTree, dependencies: List<DependencyView>) -> Witness<EffectFact> {
  Holds {
    value: effect_fact(tree: tree, dependencies: dependencies)
  }
}

fn effect_kind_eq(a: EffectKind, b: EffectKind) -> Bool {
  match a {
    PureEffect => match b {
      PureEffect => true
      _ => false
    }
    ReadEffect => match b {
      ReadEffect => true
      _ => false
    }
    WriteEffect => match b {
      WriteEffect => true
      _ => false
    }
    BarrierEffect => match b {
      BarrierEffect => true
      _ => false
    }
  }
}

fn effect_dependency_fact_eq(a: EffectDependencyFact, b: EffectDependencyFact) -> Bool {
  (a.at == b.at)
    && (a.dependency == b.dependency)
    && (a.source_facts == b.source_facts)
    && (a.dependent_facts == b.dependent_facts)
    && effect_kind_eq(a: a.effect, b: b.effect)
}

fn effect_dependency_count(xs: List<EffectDependencyFact>, item: EffectDependencyFact) -> Int {
  fold(xs, init: 0, f: fn(acc, candidate) {
    if effect_dependency_fact_eq(a: candidate, b: item) {
      acc + 1
    } else {
      acc
    }
  })
}

fn effect_dependency_facts_eq(
  left: List<EffectDependencyFact>,
  right: List<EffectDependencyFact>
) -> Bool {
  if count(left) != count(right) {
    false
  } else {
    fold(left, init: true, f: fn(acc, item) {
      acc && (effect_dependency_count(xs: left, item: item) == effect_dependency_count(xs: right, item: item))
    })
  }
}

fn effect_fact_eq(a: EffectFact, b: EffectFact) -> Bool {
  effect_dependency_facts_eq(left: a.dependencies, right: b.dependencies)
}
