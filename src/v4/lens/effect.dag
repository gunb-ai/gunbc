// src/v4/lens/effect.dag
// Scope: effect lens — effects derived from type-signature shape (B3 single-authority); no parallel taxonomy.
// Owns: EffectClassification, EffectFact, effect_witness, effect_classify.
// Consumes: v4.std.dependency (ClassifiedDependencyView<C>), v4.std.witness, v4.compiler.infer.
// Status: T-13 family ratchet — projection-only over `List<DependencyView>` via parametric `ClassifiedDependencyView<EffectClassification>`; no copied endpoints. `EffectClassification` is the minimal per-edge slot per Practice 11 — refining it to the full signature-derived effect kind set is a separate downstream lane (B3 / #3468 BLOCKING follow-up).


module v4.lens.effect

import v4.compiler.infer { InferredTree }
import v4.std.collection { List }
import v4.std.dependency {
  BarrierBefore,
  BindsTo,
  BootstrapDependsOn,
  ClassifiedDependencyView,
  Contains,
  DataDependsOn,
  DependencyView,
  EffectDependsOn,
  GeneratedFrom,
  ModelDependsOn,
  ModuleDependsOn,
  PlacementDependsOn,
  ProjectionDependsOn,
  PromotedBy,
  ResourceDependsOn,
  TypeDependsOn,
  VerifiedBy,
  classified_dependency_view_eq
}
import v4.std.integer { Int }
import v4.std.logic { Bool }
import v4.std.witness { Holds, Witness }

// 🟡 minimal projection — fail-closed slot for the per-edge effect kind.
// `RequiresSignatureWitness` is the open variant routing to InferredFacts
// per B3 (the type signature is the effect authority); refining to the
// closed signature-derived set is a tracked follow-up to the #3468
// codex BLOCKING reviews. The point of this row today is endpoint
// single-authority via ClassifiedDependencyView (Practice 11 sub-rule).
type EffectClassification
  = WriteEffect
  | ReadEffect
  | BarrierEffect
  | RequiresSignatureWitness

type EffectFact {
  dependencies: List<ClassifiedDependencyView<EffectClassification>>
}

fn effect_classification_for_dependency(view: DependencyView) -> EffectClassification {
  match view.kind {
    EffectDependsOn => WriteEffect
    ResourceDependsOn => WriteEffect
    DataDependsOn => ReadEffect
    BarrierBefore => BarrierEffect
    Contains => RequiresSignatureWitness
    BindsTo => RequiresSignatureWitness
    TypeDependsOn => RequiresSignatureWitness
    ModuleDependsOn => RequiresSignatureWitness
    PlacementDependsOn => RequiresSignatureWitness
    ModelDependsOn => RequiresSignatureWitness
    ProjectionDependsOn => RequiresSignatureWitness
    GeneratedFrom => RequiresSignatureWitness
    VerifiedBy => RequiresSignatureWitness
    PromotedBy => RequiresSignatureWitness
    BootstrapDependsOn => RequiresSignatureWitness
  }
}

fn effect_classify(view: DependencyView) -> ClassifiedDependencyView<EffectClassification> {
  ClassifiedDependencyView {
    dependency: view,
    classification: effect_classification_for_dependency(view: view)
  }
}

fn effect_fact(tree: InferredTree, dependencies: List<DependencyView>) -> EffectFact {
  EffectFact {
    dependencies: fold(dependencies, init: [], f: fn(acc, view) {
      list_push(acc, effect_classify(view: view))
    })
  }
}

fn effect_witness(tree: InferredTree, dependencies: List<DependencyView>) -> Witness<EffectFact> {
  Holds {
    value: effect_fact(tree: tree, dependencies: dependencies)
  }
}

fn effect_classification_eq(a: EffectClassification, b: EffectClassification) -> Bool {
  match a {
    WriteEffect => match b {
      WriteEffect => true
      _ => false
    }
    ReadEffect => match b {
      ReadEffect => true
      _ => false
    }
    BarrierEffect => match b {
      BarrierEffect => true
      _ => false
    }
    RequiresSignatureWitness => match b {
      RequiresSignatureWitness => true
      _ => false
    }
  }
}

fn effect_classified_eq(
  a: ClassifiedDependencyView<EffectClassification>,
  b: ClassifiedDependencyView<EffectClassification>
) -> Bool {
  classified_dependency_view_eq(a: a, b: b, classification_eq: effect_classification_eq)
}

fn effect_dependency_count(
  xs: List<ClassifiedDependencyView<EffectClassification>>,
  item: ClassifiedDependencyView<EffectClassification>
) -> Int {
  fold(xs, init: 0, f: fn(acc, candidate) {
    if effect_classified_eq(a: candidate, b: item) {
      acc + 1
    } else {
      acc
    }
  })
}

fn effect_dependency_facts_eq(
  left: List<ClassifiedDependencyView<EffectClassification>>,
  right: List<ClassifiedDependencyView<EffectClassification>>
) -> Bool {
  if count(left) != count(right) {
    false
  } else {
    fold(left, init: true, f: fn(acc, item) {
      acc && (effect_dependency_count(xs: left, item: item) == effect_dependency_count(xs: right, item: item))
    })
  }
}

fn effect_fact_eq(a: EffectFact, b: EffectFact) -> Bool {
  effect_dependency_facts_eq(left: a.dependencies, right: b.dependencies)
}
