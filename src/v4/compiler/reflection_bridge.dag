// src/v4/compiler/reflection_bridge.dag
// Scope: COMPREP resolve→body bridge for compiler-stage fn bodies (complexity-gate S1a).
// Status: source-ingestion lane — tokenize/parse/normalize/resolve then project Arrow.body;
//         NOT runtime module-table lookup (operator ban 2026-06-07).
// Anchor: comprep_eval_by_execution / body_producer resolve-bridge (#4608/#4624/#4660).

module v4.compiler.reflection_bridge

import v4.compiler.normalize { normalize }
import v4.compiler.parse {
  grammar_validate_for_parse,
  parse_production_tree,
  parse_stage_locus_port
}
import v4.compiler.resolve { resolve }
import v4.compiler.tokenize { tokenize }
import v4.extdeps.languages.dag {
  dag_language_model_wave1,
  dag_wave1_grammar_root
}
import v4.std.collection { Absent, List, Present, Set, list_at_optional }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected,
  port_locus
}
import v4.std.grammar { GrammarRoot, ParseTree }
import v4.std.lexing { Token }
import v4.std.node {
  Arrow,
  Cardinality,
  Edge,
  Node,
  Positional,
  Symbol,
  TypeNode,
  well_formed
}
import v4.std.node_query {
  find_arrow_body_child,
  node_positional_child_targets
}

// Authoritative source mirror of v4.compiler.parse:parse_current_position (02_parse.dag:284).
data reflection_parse_current_position_source_text: String = "fn parse_current_position(all_tokens: List<Token>, tokens: List<Token>) -> Int { length(xs: all_tokens) - length(xs: tokens) }"

data reflection_bridge_reason_not_arrow: Symbol = reflection_bridge_reason_not_arrow
data reflection_bridge_reason_body_missing: Symbol = reflection_bridge_reason_body_missing
data reflection_bridge_reason_resolved_shape: Symbol = reflection_bridge_reason_resolved_shape

fn reflection_bridge_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn reflection_fn_decl_parse_root() -> GrammarRoot {
  let wave1 = dag_wave1_grammar_root()
  GrammarRoot {
    start: ^dag_production_fn_decl,
    productions: wave1.productions,
    sync_tokens: wave1.sync_tokens
  }
}

fn reflection_parse_fn_decl_tokens(tokens: List<Token>) -> Outcome<ParseTree> {
  let root = reflection_fn_decl_parse_root()
  match grammar_validate_for_parse(root: root, at: port_locus(port: parse_stage_locus_port)) {
    Accepted { value: validated, diagnostics: _ } =>
      parse_production_tree(
        tokens: tokens,
        validated: validated,
        production_name: ^dag_production_fn_decl
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn reflection_source_resolved_fn_decl(source_text: String, file: Symbol) -> Outcome<Node> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(text: source_text, file: file, rules: lm.lex),
    f: fn(tokens) {
      bind_outcome(
        o: reflection_parse_fn_decl_tokens(tokens: tokens.tokens),
        f: fn(parsed) {
          bind_outcome(
            o: normalize(parse_tree: parsed),
            f: fn(normalized) {
              resolve(tree: normalized, lm: lm)
            }
          )
        }
      )
    }
  )
}

fn reflection_arrow_last_positional_child(arrow: Node) -> Outcome<Node> {
  let positional = node_positional_child_targets(node: arrow)
  let last_index = count(positional) - 1
  if last_index < 0 {
    outcome_rejected(
      d: reflection_bridge_diagnostic(
        reason: reflection_bridge_reason_body_missing,
        n: arrow
      )
    )
  } else {
    match list_at_optional(xs: positional, index: last_index) {
      Present { value: body } => outcome_accepted(value: body)
      Absent =>
        outcome_rejected(
          d: reflection_bridge_diagnostic(
            reason: reflection_bridge_reason_body_missing,
            n: arrow
          )
        )
    }
  }
}

fn reflection_arrow_body_from_resolved(resolved_root: Node) -> Outcome<Node> {
  match resolved_root.kind {
    TypeNode { connective: Arrow } =>
      match find_arrow_body_child(root: resolved_root) {
        Accepted { value: body, diagnostics: _ } => outcome_accepted(value: body)
        Rejected { diagnostics: _ } =>
          reflection_arrow_last_positional_child(arrow: resolved_root)
      }
    _ =>
      outcome_rejected(
        d: reflection_bridge_diagnostic(
          reason: reflection_bridge_reason_not_arrow,
          n: resolved_root
        )
      )
  }
}

fn reflection_parse_current_position_resolved() -> Outcome<Node> {
  reflection_source_resolved_fn_decl(
    source_text: reflection_parse_current_position_source_text,
    file: ^reflection_bridge_parse_current_position_source_file
  )
}

fn reflection_parse_current_position_body() -> Outcome<Node> {
  bind_outcome(
    o: reflection_parse_current_position_resolved(),
    f: fn(resolved) {
      reflection_arrow_body_from_resolved(resolved_root: resolved)
    }
  )
}

fn reflection_parse_current_position_lens_subject() -> Outcome<Node> {
  bind_outcome(
    o: reflection_parse_current_position_body(),
    f: fn(body) {
      if well_formed(n: body) {
        outcome_accepted(
          value: Node {
            kind: TypeNode { connective: Cardinality },
            children: [
              Edge { label: Positional, target: body }
            ],
            occurrence_id: body.occurrence_id
          }
        )
      } else {
        outcome_rejected(
          d: reflection_bridge_diagnostic(
            reason: reflection_bridge_reason_resolved_shape,
            n: body
          )
        )
      }
    }
  )
}
