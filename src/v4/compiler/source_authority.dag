// src/v4/compiler/source_authority.dag
// Scope: Branch H.7.2 source-authority contract for `.dag` source round trips.
// Status: modeled shape contract over canonical source text; equality witnesses become executable
// once ParseTree/ResolvedTree equality and a canonical `.dag` TargetModel row are substrate-backed.
// JSON IR/debug artifacts are excluded.
// Anchor: Branch H source-authority worksheet H.1-H.3/H.7.2; Branch B-min Bmin.4-Bmin.5.

module v4.compiler.source_authority


import v4.compiler.normalize { normalize, NormalizedTree }
import v4.compiler.parse { parse }
import v4.compiler.resolve { resolve, ResolvedTree }
import v4.compiler.tokenize { tokenize }
import v4.extdeps.languages.dag {
  DagLanguageModel,
  dag_language_model_wave1_modeled
}
import v4.std.artifact { Artifact, NodeArtifactProvenance }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  outcome_accepted,
  port_locus
}
import v4.std.grammar { ParseTree }
import v4.std.node { Node, Symbol }
import v4.std.target_model { TargetModel }
import v4.compiler.target_carriers { TargetSource }
import v4.compiler.translate { target_serialize_source_from_model }
import v4.std.text { String }
import v4.std.witness { Holds, Violates, Witness }


type DagSource = String

type DagSourceAst {
  tree: ParseTree
}

type NormalizedDagSourceAst {
  tree: NormalizedTree
}

type DagSemanticIr {
  tree: ResolvedTree
}

type DagSourceArtifact {
  source: DagSource
  artifact: Artifact
}

type SourceAstEqual {
  original: DagSourceAst
  reparsed: DagSourceAst
}

type SemanticIrEqual {
  original: DagSemanticIr
  reparsed: DagSemanticIr
}

type NormalizedSourceAstEqual {
  original: NormalizedDagSourceAst
  reparsed: NormalizedDagSourceAst
}

type DeterministicDagSourceSerializerLaw {}

type NormalizedDagSourceParsePrintLaw {
  normalized_source_law: NormalizedSourceAstEqual
}

type CanonicalDagSourceEmissionLaw {
  canonical_source: DagSource
  serializer_law: DeterministicDagSourceSerializerLaw
  parse_print_law: NormalizedDagSourceParsePrintLaw
}

type SourceAuthorityRoundTripLaw {
  canonical_source: DagSource
  source_law: SourceAstEqual
  semantic_law: SemanticIrEqual
  canonical_source_law: CanonicalDagSourceEmissionLaw
}


data source_authority_port: Symbol = source_authority_port
data source_authority_ast_mismatch: Symbol = source_authority_ast_mismatch
data source_authority_ir_mismatch: Symbol = source_authority_ir_mismatch
data source_authority_normalized_ast_mismatch: Symbol = source_authority_normalized_ast_mismatch
data source_authority_serializer_nondeterministic: Symbol = source_authority_serializer_nondeterministic


fn source_authority_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: port_locus(port: source_authority_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_dag_source_ast_with_model(source: DagSource, lm: DagLanguageModel) -> Outcome<DagSourceAst> {
  bind_outcome(
    o: tokenize(text: source, file: source_authority_port, rules: lm.lex),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          outcome_accepted(value: DagSourceAst { tree: parse_tree })
        }
      )
    }
  )
}


fn parse_dag_source_ast(source: DagSource) -> Outcome<DagSourceAst> {
  parse_dag_source_ast_with_model(source: source, lm: dag_language_model_wave1_modeled())
}


fn normalize_dag_source_ast(ast: DagSourceAst) -> Outcome<NormalizedDagSourceAst> {
  bind_outcome(
    o: normalize(parse_tree: ast.tree),
    f: fn(normalized) {
      outcome_accepted(value: NormalizedDagSourceAst { tree: normalized })
    }
  )
}


fn semantic_ir_from_ast_with_model(ast: DagSourceAst, lm: DagLanguageModel) -> Outcome<DagSemanticIr> {
  bind_outcome(
    o: normalize(parse_tree: ast.tree),
    f: fn(normalized) {
      bind_outcome(
        o: resolve(tree: normalized, lm: lm),
        f: fn(resolved) {
          outcome_accepted(value: DagSemanticIr { tree: resolved })
        }
      )
    }
  )
}


fn semantic_ir_from_source_with_model(source: DagSource, lm: DagLanguageModel) -> Outcome<DagSemanticIr> {
  bind_outcome(
    o: parse_dag_source_ast_with_model(source: source, lm: lm),
    f: fn(ast) {
      semantic_ir_from_ast_with_model(ast: ast, lm: lm)
    }
  )
}


fn semantic_ir_from_source(source: DagSource) -> Outcome<DagSemanticIr> {
  semantic_ir_from_source_with_model(source: source, lm: dag_language_model_wave1_modeled())
}


fn source_ir_node_artifact_provenance_from_model(
  source_artifact: DagSourceArtifact,
  lm: DagLanguageModel
) -> Outcome<NodeArtifactProvenance> {
  bind_outcome(
    o: semantic_ir_from_source_with_model(source: source_artifact.source, lm: lm),
    f: fn(ir) {
      outcome_accepted(
        value: NodeArtifactProvenance {
          node: ir.tree,
          artifact: source_artifact.artifact
        }
      )
    }
  )
}


fn source_ir_node_artifact_provenance(
  source_artifact: DagSourceArtifact
) -> Outcome<NodeArtifactProvenance> {
  source_ir_node_artifact_provenance_from_model(
    source_artifact: source_artifact,
    lm: dag_language_model_wave1_modeled()
  )
}


fn source_ast_equal_witness(
  original: DagSourceAst,
  reparsed: DagSourceAst
) -> Witness<SourceAstEqual> {
  if original.tree == reparsed.tree {
    Holds { value: SourceAstEqual { original: original, reparsed: reparsed } }
  } else {
    Violates {
      diagnostic: source_authority_diagnostic(reason: source_authority_ast_mismatch)
    }
  }
}


fn normalized_source_ast_equal_witness(
  original: NormalizedDagSourceAst,
  reparsed: NormalizedDagSourceAst
) -> Witness<NormalizedSourceAstEqual> {
  if original.tree == reparsed.tree {
    Holds { value: NormalizedSourceAstEqual { original: original, reparsed: reparsed } }
  } else {
    Violates {
      diagnostic: source_authority_diagnostic(reason: source_authority_normalized_ast_mismatch)
    }
  }
}


fn semantic_ir_equal_witness(
  original: DagSemanticIr,
  reparsed: DagSemanticIr
) -> Witness<SemanticIrEqual> {
  if original.tree == reparsed.tree {
    Holds { value: SemanticIrEqual { original: original, reparsed: reparsed } }
  } else {
    Violates {
      diagnostic: source_authority_diagnostic(reason: source_authority_ir_mismatch)
    }
  }
}


fn deterministic_dag_source_serializer_witness(
  first: DagSource,
  second: DagSource
) -> Witness<DeterministicDagSourceSerializerLaw> {
  if first == second {
    Holds { value: DeterministicDagSourceSerializerLaw {} }
  } else {
    Violates {
      diagnostic: source_authority_diagnostic(reason: source_authority_serializer_nondeterministic)
    }
  }
}


fn canonical_dag_source_emission_law_from_parts(
  original_ast: DagSourceAst,
  canonical_source_first: DagSource,
  canonical_source_second: DagSource,
  reparsed_ast: DagSourceAst
) -> Outcome<Witness<CanonicalDagSourceEmissionLaw>> {
  bind_outcome(
    o: normalize_dag_source_ast(ast: original_ast),
    f: fn(original_normalized_ast) {
      bind_outcome(
        o: normalize_dag_source_ast(ast: reparsed_ast),
        f: fn(reparsed_normalized_ast) {
          let serializer_law = deterministic_dag_source_serializer_witness(
            first: canonical_source_first,
            second: canonical_source_second
          )
          let parse_print_law = normalized_source_ast_equal_witness(
            original: original_normalized_ast,
            reparsed: reparsed_normalized_ast
          )
          match serializer_law {
            Violates { diagnostic: d } =>
              Rejected { diagnostics: diagnostics_singleton(d: d) }
            Holds { value: serializer_law_value } =>
              match parse_print_law {
                Violates { diagnostic: d } =>
                  Rejected { diagnostics: diagnostics_singleton(d: d) }
                Holds { value: parse_print_law_value } =>
                  outcome_accepted(
                    value: Holds {
                      value: CanonicalDagSourceEmissionLaw {
                        canonical_source: canonical_source_first,
                        serializer_law: serializer_law_value,
                        parse_print_law: NormalizedDagSourceParsePrintLaw {
                          normalized_source_law: parse_print_law_value
                        }
                      }
                    }
                  )
              }
          }
        }
      )
    }
  )
}


fn source_authority_law_from_parts(
  original_ast: DagSourceAst,
  canonical_source: DagSource,
  reparsed_ast: DagSourceAst,
  original_ir: DagSemanticIr,
  reparsed_ir: DagSemanticIr,
  canonical_source_law: CanonicalDagSourceEmissionLaw
) -> Outcome<Witness<SourceAuthorityRoundTripLaw>> {
  let source_law = source_ast_equal_witness(original: original_ast, reparsed: reparsed_ast)
  let semantic_law = semantic_ir_equal_witness(original: original_ir, reparsed: reparsed_ir)
  match source_law {
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
    Holds { value: source_law_value } =>
      match semantic_law {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: semantic_law_value } =>
          outcome_accepted(
            value: Holds {
              value: SourceAuthorityRoundTripLaw {
                canonical_source: canonical_source,
                source_law: source_law_value,
                semantic_law: semantic_law_value,
                canonical_source_law: canonical_source_law
              }
            }
          )
      }
  }
}


fn source_authority_round_trip_with_model(
  source: DagSource,
  canonical_source_target: TargetModel,
  lm: DagLanguageModel
) -> Outcome<Witness<SourceAuthorityRoundTripLaw>> {
  bind_outcome(
    o: parse_dag_source_ast_with_model(source: source, lm: lm),
    f: fn(original_ast) {
      bind_outcome(
        o: semantic_ir_from_ast_with_model(ast: original_ast, lm: lm),
        f: fn(original_ir) {
          bind_outcome(
            o: target_serialize_source_from_model(
              target: canonical_source_target,
              emitted: original_ir.tree
            ),
            f: fn(canonical_source) {
              bind_outcome(
                o: target_serialize_source_from_model(
                  target: canonical_source_target,
                  emitted: original_ir.tree
                ),
                f: fn(canonical_source_again) {
                  bind_outcome(
                    o: parse_dag_source_ast_with_model(source: canonical_source, lm: lm),
                    f: fn(reparsed_ast) {
                      bind_outcome(
                        o: semantic_ir_from_ast_with_model(ast: reparsed_ast, lm: lm),
                        f: fn(reparsed_ir) {
                          bind_outcome(
                            o: canonical_dag_source_emission_law_from_parts(
                              original_ast: original_ast,
                              canonical_source_first: canonical_source,
                              canonical_source_second: canonical_source_again,
                              reparsed_ast: reparsed_ast
                            ),
                            f: fn(canonical_source_law_witness) {
                              match canonical_source_law_witness {
                                Violates { diagnostic: d } =>
                                  Rejected { diagnostics: diagnostics_singleton(d: d) }
                                Holds { value: canonical_source_law } =>
                                  source_authority_law_from_parts(
                                    original_ast: original_ast,
                                    canonical_source: canonical_source,
                                    reparsed_ast: reparsed_ast,
                                    original_ir: original_ir,
                                    reparsed_ir: reparsed_ir,
                                    canonical_source_law: canonical_source_law
                                  )
                              }
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}


fn canonical_dag_source_parse_print_law(
  source: DagSource,
  canonical_source_target: TargetModel
) -> Outcome<Witness<CanonicalDagSourceEmissionLaw>> {
  bind_outcome(
    o: parse_dag_source_ast(source: source),
    f: fn(original_ast) {
      bind_outcome(
        o: semantic_ir_from_ast_with_model(
          ast: original_ast,
          lm: dag_language_model_wave1_modeled()
        ),
        f: fn(original_ir) {
          bind_outcome(
            o: target_serialize_source_from_model(
              target: canonical_source_target,
              emitted: original_ir.tree
            ),
            f: fn(canonical_source) {
              bind_outcome(
                o: target_serialize_source_from_model(
                  target: canonical_source_target,
                  emitted: original_ir.tree
                ),
                f: fn(canonical_source_again) {
                  bind_outcome(
                    o: parse_dag_source_ast(source: canonical_source),
                    f: fn(reparsed_ast) {
                      canonical_dag_source_emission_law_from_parts(
                        original_ast: original_ast,
                        canonical_source_first: canonical_source,
                        canonical_source_second: canonical_source_again,
                        reparsed_ast: reparsed_ast
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}


fn source_authority_round_trip(
  source: DagSource,
  canonical_source_target: TargetModel
) -> Outcome<Witness<SourceAuthorityRoundTripLaw>> {
  source_authority_round_trip_with_model(
    source: source,
    canonical_source_target: canonical_source_target,
    lm: dag_language_model_wave1_modeled()
  )
}
