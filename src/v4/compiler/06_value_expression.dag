// src/v4/compiler/06_value_expression.dag
// Scope: T6 value-expression tier — Behavior sub-DAG → TargetValueExpression → ConcreteSyntaxToken.
// Status: skeleton — Transform-for-add arm only (COMPREP wave-3 / #4623 vetting consumer).
// Anchor: docs/design-value-emit-schema.md §4.1–§4.4.

module v4.compiler.value_expression

import v4.std.algebra { Cons, Empty, FreeMonoid, fold_list, length, list_snoc_item }
import v4.std.collection {
  Absent,
  List,
  Optional,
  Present,
  optional_absent,
  optional_present,
  list_at_optional,
  map_get
}
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v4.std.node {
  all_edges_positional,
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Transform,
  TypeNode,
  Symbol
}
import v4.std.node_query {
  arrow_domain_named_param_bindings,
  find_arrow_body_child,
  find_named_child,
  node_positional_child_targets
}
import v4.std.target_model {
  CanonicalOperation,
  ConcreteSyntaxToken,
  canonical_operation_op_add,
  TargetModel,
  TargetValueExpression,
  TargetValueExpressionProjection,
  TargetValueExprPrimitiveApply,
  decode_value_expression_projection_bundle,
  target_model_edge_declared_inhabitants,
  target_model_edge_operator_realizations,
  target_model_edge_value_expression_projection,
  target_value_expression_binding_ref,
  target_value_expression_primitive_apply,
  target_value_expression_to_concrete_tokens,
  target_wave1_add_signature_matches
}

data value_expr_reason_surface_op_unmapped: Symbol = value_expr_reason_surface_op_unmapped
data value_expr_reason_operator_catalog_miss: Symbol = value_expr_reason_operator_catalog_miss
data value_expr_reason_operator_catalog_ambiguous: Symbol = value_expr_reason_operator_catalog_ambiguous
data value_expr_reason_transform_shape_invalid: Symbol = value_expr_reason_transform_shape_invalid
data value_expr_reason_body_scope_binding_invalid: Symbol = value_expr_reason_body_scope_binding_invalid
data value_expr_reason_projection_bundle_missing: Symbol = value_expr_reason_projection_bundle_missing

fn value_expr_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// 🟡 gated — predicate-dissolution interim (INVARIANTS P1 / modeling-discipline Practice 4) —
// feature:canonical-op-from-surface-atom — consumer:06_value_expression
// project_transform_primitive_apply — bind: resolve-stage surface-op → CanonicalOperation mapping —
// owner: T6 value-expression (lively-badger-242) — lane: compiler 06_value_expression —
// dissolve-on-arrival: resolve maps surface op token → CanonicalOperation at resolve stage;
// forbidden: literal ^dag_token_plus match in compiler value-expression projection.
fn surface_op_atom_to_canonical(op_atom: Symbol) -> Optional<CanonicalOperation> {
  if op_atom == ^dag_token_plus {
    optional_present(canonical_operation_op_add())
  } else {
    optional_absent()
  }
}

fn transform_positional_operand_binding_at(
  source: Node,
  targets: FreeMonoid<Node>,
  wanted: Int,
  cursor: Int
) -> Outcome<Symbol> {
  match targets {
    Empty =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: source
        )
      )
    Cons { head: child, tail: rest } =>
      if cursor == wanted {
        match child.kind {
          TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
          _ =>
            outcome_rejected(
              value_expr_diagnostic(
                reason: value_expr_reason_transform_shape_invalid,
                node: child
              )
            )
        }
      } else {
        transform_positional_operand_binding_at(
          source: source,
          targets: rest,
          wanted: wanted,
          cursor: cursor + 1
        )
      }
  }
}

fn transform_positional_operand_binding(node: Node, index: Int) -> Outcome<Symbol> {
  transform_positional_operand_binding_at(
    source: node,
    targets: node_positional_child_targets(node: node),
    wanted: index,
    cursor: 0
  )
}

fn transform_surface_op_atom(node: Node) -> Outcome<Symbol> {
  transform_positional_operand_binding(node: node, index: 0)
}

fn value_expr_positional_child_atom_is_at(
  targets: FreeMonoid<Node>,
  wanted: Int,
  sym: Symbol,
  cursor: Int
) -> Bool {
  match targets {
    Empty => false
    Cons { head: child, tail: rest } =>
      if cursor == wanted {
        match child.kind {
          TypeNode { connective: Atom { identity: id } } => id == sym
          _ => false
        }
      } else {
        value_expr_positional_child_atom_is_at(
          targets: rest,
          wanted: wanted,
          sym: sym,
          cursor: cursor + 1
        )
      }
  }
}

fn value_expr_positional_child_atom_is(node: Node, index: Int, sym: Symbol) -> Bool {
  value_expr_positional_child_atom_is_at(
    targets: node_positional_child_targets(node: node),
    wanted: index,
    sym: sym,
    cursor: 0
  )
}

fn value_expr_declared_inhabitants_from_target(target: TargetModel) -> Outcome<Node> {
  target_bundle_named_child(
    target: target,
    edge_name: target_model_edge_declared_inhabitants
  )
}

fn value_expr_wave1_add_signature_matches_for_target(
  arrow: Node,
  target: TargetModel
) -> Bool {
  match value_expr_declared_inhabitants_from_target(target: target) {
    Accepted { value: inhabitants_root, diagnostics: _ } =>
      target_wave1_add_signature_matches(
        arrow: arrow,
        inhabitants_root: inhabitants_root
      )
    Rejected { diagnostics: _ } => false
  }
}

fn value_expr_arrow_has_transform_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn value_expr_binding_in_arrow_domain(arrow: Node, binding: Symbol) -> Bool {
  match arrow_domain_named_param_bindings(arrow: arrow) {
    Accepted { value: bindings, diagnostics: _ } =>
      fold_list(xs: bindings, empty: false, cons: fn(acc, sym) {
        if acc {
          true
        } else if sym == binding {
          true
        } else {
          false
        }
      })
    Rejected { diagnostics: _ } => false
  }
}

fn value_expr_arrow_body_scope_binding_valid(
  arrow: Node,
  binding: Symbol,
  target: TargetModel
) -> Bool {
  value_expr_binding_in_arrow_domain(arrow: arrow, binding: binding)
    && (
      value_expr_wave1_add_signature_matches_for_target(arrow: arrow, target: target)
      || value_expr_arrow_has_transform_body(arrow: arrow)
    )
}

fn value_expr_arrow_body_scope_binding(
  arrow: Node,
  body: Node,
  binding: Symbol,
  target: TargetModel
) -> Outcome<Symbol> {
  if value_expr_arrow_body_scope_binding_valid(
    arrow: arrow,
    binding: binding,
    target: target
  ) {
    outcome_accepted(binding)
  } else {
    outcome_rejected(
      value_expr_diagnostic(
        reason: value_expr_reason_body_scope_binding_invalid,
        node: body
      )
    )
  }
}

fn project_transform_primitive_apply_in_arrow_scope(
  arrow: Node,
  body: Node,
  target: TargetModel
) -> Outcome<TargetValueExpression> {
  match body.kind {
    ComputationNode { behavior: Transform } =>
      if !all_edges_positional(children: body.children)
        || length(xs: node_positional_child_targets(node: body)) != 3 {
        outcome_rejected(
          value_expr_diagnostic(
            reason: value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      } else {
      bind_outcome(
        o: transform_surface_op_atom(node: body),
        f: fn(op_atom) {
          match surface_op_atom_to_canonical(op_atom: op_atom) {
            Absent =>
              outcome_rejected(
                value_expr_diagnostic(
                  reason: value_expr_reason_surface_op_unmapped,
                  node: body
                )
              )
            Present { value: canonical_op } =>
              bind_outcome(
                o: transform_positional_operand_binding(node: body, index: 1),
                f: fn(left_binding) {
                  bind_outcome(
                    o: value_expr_arrow_body_scope_binding(
                      arrow: arrow,
                      body: body,
                      binding: left_binding,
                      target: target
                    ),
                    f: fn(scoped_left_binding) {
                      bind_outcome(
                        o: transform_positional_operand_binding(node: body, index: 2),
                        f: fn(right_binding) {
                          bind_outcome(
                            o: value_expr_arrow_body_scope_binding(
                              arrow: arrow,
                              body: body,
                              binding: right_binding,
                              target: target
                            ),
                            f: fn(scoped_right_binding) {
                              outcome_accepted(
                                target_value_expression_primitive_apply(
                                  operation: canonical_op,
                                  operands: [
                                    target_value_expression_binding_ref(
                                      binding: scoped_left_binding
                                    ),
                                    target_value_expression_binding_ref(
                                      binding: scoped_right_binding
                                    )
                                  ]
                                )
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
          }
        }
      )
      }
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: body
        )
      )
  }
}

fn target_bundle_named_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match find_named_child(root: target.bundle, name: edge_name) {
        Accepted { value: child, diagnostics: d } =>
          Accepted { value: child, diagnostics: d }
        Rejected { diagnostics: _ } =>
          outcome_rejected(
            value_expr_diagnostic(
              reason: value_expr_reason_projection_bundle_missing,
              node: target.bundle
            )
          )
      }
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_projection_bundle_missing,
          node: target.bundle
        )
      )
  }
}

fn value_expression_projection_from_target(
  target: TargetModel
) -> Outcome<TargetValueExpressionProjection> {
  bind_outcome(
    o: target_bundle_named_child(
      target: target,
      edge_name: target_model_edge_value_expression_projection
    ),
    f: fn(bundle) {
      decode_value_expression_projection_bundle(bundle: bundle)
    }
  )
}

fn value_expression_to_concrete_tokens(
  expr: TargetValueExpression,
  target: TargetModel,
  projection: TargetValueExpressionProjection
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_bundle_named_child(
      target: target,
      edge_name: target_model_edge_operator_realizations
    ),
    f: fn(catalog) {
      target_value_expression_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    }
  )
}

// 🟡 gated — predicate-dissolution interim (INVARIANTS.md P3 / modeling-discipline Practice 10) —
// feature:t6-value-expr-bodied-arrow-serialize — consumer:06_translate bodied-arrow translate/serialize
// dispatch — bind: PR #4627 / docs/design-value-emit-schema.md §4.5 (#4623 vetting consumer) —
// owner: T6 value-expression skeleton (lively-badger-242) — lane: compiler 06_value_expression +
// 06_translate — dissolve-on-arrival: bodied Arrow serialize routes through grammar relation-row /
// connective dispatch (TargetBodiedArrowStatementScaffold absorbed into translation_rules); delete
// arrow_has_transform_body, translate_node bodied bypass, and serialize bodied branches — forbidden:
// steady-state Bool predicates over ComputationNode behavior Transform for emit dispatch.
fn arrow_has_transform_body(arrow: Node) -> Bool {
  value_expr_arrow_has_transform_body(arrow: arrow)
}

fn project_arrow_body_to_value_expression(
  arrow: Node,
  target: TargetModel
) -> Outcome<TargetValueExpression> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      project_transform_primitive_apply_in_arrow_scope(
        arrow: arrow,
        body: body,
        target: target
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
