data value_expr_reason_surface_op_unmapped: Symbol = value_expr_reason_surface_op_unmapped
data value_expr_reason_operator_catalog_miss: Symbol = value_expr_reason_operator_catalog_miss
data value_expr_reason_operator_catalog_ambiguous: Symbol = value_expr_reason_operator_catalog_ambiguous
data value_expr_reason_transform_shape_invalid: Symbol = value_expr_reason_transform_shape_invalid
data value_expr_reason_body_scope_binding_invalid: Symbol = value_expr_reason_body_scope_binding_invalid
data value_expr_reason_projection_bundle_missing: Symbol = value_expr_reason_projection_bundle_missing

fn value_expr_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// 🟡 gated — STRUCTURAL dissolve-on (INVARIANTS P1 / modeling-discipline Practice 4) —
// feature:value_expression-projection-dissolution —
// consumer: project_transform_primitive_apply_in_arrow_scope @ :225 (call @ :244) —
// bind: PR-T-FINISH / translate_algebra §1.5 fold —
// owner: valiant-heron-163 (translate) — lane: compiler 06_value_expression + 06_translate —
// dissolve-on: translate_algebra §1.5 fold deletes surface_op_atom_to_canonical @ :93 (last consumer:
// project_transform_primitive_apply_in_arrow_scope); authority: canonical_operation_from_wire_node @ std/compilers/target_model:439;
// forbidden: deleting this shell before PR-T-FINISH lands (cross-lane coupling, not follow-up graft).
fn surface_op_atom_to_canonical(op_atom: Symbol) -> Optional<CanonicalOperation> {
  match dag_surface_operator_canonicalization_member(surface_token: op_atom) {
    Accepted { value: canonical_op, diagnostics: _ } =>
      optional_present(value: canonical_op)
    Rejected { diagnostics: _ } => optional_absent()
  }
}

fn transform_positional_operand_binding_atom(child: Node) -> Outcome<Symbol> {
  match child.kind {
    TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: child
        )
      )
  }
}

fn transform_positional_operand_binding(node: Node, index: Int) -> Outcome<Symbol> {
  match list_at_optional(xs: node_positional_child_targets(node: node), index: index) {
    Present { value: child } => transform_positional_operand_binding_atom(child: child)
    Absent =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

fn transform_surface_op_atom(node: Node) -> Outcome<Symbol> {
  transform_positional_operand_binding(node: node, index: 0)
}

fn value_expr_declared_inhabitants_from_target(target: TargetModel) -> Outcome<Node> {
  target_bundle_named_child(
    target: target,
    edge_name: target_model_edge_declared_inhabitants
  )
}

// 🟡 gated — predicate-dissolution interim (INVARIANTS P3 / modeling-discipline Practice 10) —
// feature:target-wave1-signature-declared-inhabitants — consumer:06_value_expression
// value_expr_arrow_body_scope_binding — bind: COMPREP wave-1 Arrow signature vs
// TargetModel.declared_inhabitants — owner: T6 value-expression (lively-badger-242) —
// lane: compiler 06_value_expression — dissolve-on-arrival: substrate Outcome-bearing
// signature query replaces Bool fold + silent Rejected swallow; forbidden: parallel
// compiler-stage wave-1 signature matchers.
fn value_expr_wave1_add_signature_matches_for_target(
  arrow: Node,
  target: TargetModel
) -> Bool {
  match value_expr_declared_inhabitants_from_target(target: target) {
    Accepted { value: inhabitants_root, diagnostics: _ } =>
      target_wave1_add_signature_matches(
        arrow: arrow,
        inhabitants_root: inhabitants_root
      )
    Rejected { diagnostics: _ } => false
  }
}

// 🟡 gated — predicate-dissolution interim (INVARIANTS P3 / modeling-discipline Practice 10) —
// feature:t6-value-expr-bodied-arrow-serialize — consumer:06_value_expression
// value_expr_arrow_body_scope_binding — bind: PR #4627 / docs/design-value-emit-schema.md §4.5 —
// owner: T6 value-expression (lively-badger-242) — lane: compiler 06_value_expression +
// 06_translate — dissolve-on-arrival: bodied Arrow serialize routes through grammar
// relation-row / connective dispatch; delete transform-body Bool predicate steady-state;
// forbidden: ComputationNode behavior Transform match for binding-validation dispatch.
fn value_expr_arrow_has_transform_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn value_expr_arrow_has_branch_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Branch } =>
          length(xs: node_positional_child_targets(node: body)) == 3
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn value_expr_arrow_has_value_expression_body(arrow: Node) -> Bool {
  value_expr_arrow_has_transform_body(arrow: arrow)
    || value_expr_arrow_has_branch_body(arrow: arrow)
}

fn value_expr_atom_to_symbol_identity_token(atom: Symbol) -> Outcome<Symbol> {
  if atom == ^dag_mvp1_pick_lit_one {
    outcome_accepted(^dag_token_int_literal)
  } else if atom == ^dag_mvp1_pick_lit_two {
    outcome_accepted(^dag_token_int_literal)
  } else {
    outcome_accepted(atom)
  }
}

fn value_expr_project_atom_literal(node: Node) -> Outcome<TargetValueExpression> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      bind_outcome(
        o: value_expr_atom_to_symbol_identity_token(atom: id),
        f: fn(token_class) {
          outcome_accepted(
            target_value_expression_symbol_identity(identity: token_class)
          )
        }
      )
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

fn value_expr_branch_bool_gate(node: Node) -> Bool {
  if length(xs: node_positional_child_targets(node: node)) != 3 {
    false
  } else {
    match list_at_optional(xs: node_positional_child_targets(node: node), index: 0) {
      Present { value: cond } =>
        dag_mvp1_node_is_kw_true_atom(node: cond)
          || dag_mvp1_node_is_kw_false_atom(node: cond)
      Absent => false
    }
  }
}

// 🟡 gated — feature:value-expression-branch-positional-m0 — consumer:project_branch_bool_if_else —
// bind: design-comprep-m0-branch-mapping.md §12.9(A) — dissolve-on: Q-B1 named pattern edges for
// match (M0-B5); forbidden: silent ordinal coupling past M0 Bool-if-else.
fn project_branch_bool_if_else(
  arrow: Node,
  body: Node,
  target: TargetModel
) -> Outcome<TargetValueExpression> {
  if !value_expr_branch_bool_gate(node: body) {
    outcome_rejected(
      value_expr_diagnostic(
        reason: value_expr_reason_transform_shape_invalid,
        node: body
      )
    )
  } else {
    bind_outcome(
      o: list_at_optional(xs: node_positional_child_targets(node: body), index: 0),
      f: fn(cond) {
        bind_outcome(
          o: list_at_optional(xs: node_positional_child_targets(node: body), index: 1),
          f: fn(then_arm) {
            bind_outcome(
              o: list_at_optional(xs: node_positional_child_targets(node: body), index: 2),
              f: fn(else_arm) {
                bind_outcome(
                  o: value_expr_project_body_subexpression(
                    arrow: arrow,
                    node: cond,
                    target: target
                  ),
                  f: fn(projected_cond) {
                    bind_outcome(
                      o: value_expr_project_body_subexpression(
                        arrow: arrow,
                        node: then_arm,
                        target: target
                      ),
                      f: fn(projected_then) {
                        bind_outcome(
                          o: value_expr_project_body_subexpression(
                            arrow: arrow,
                            node: else_arm,
                            target: target
                          ),
                          f: fn(projected_else) {
                            outcome_accepted(
                              target_value_expression_conditional(
                                condition: projected_cond,
                                then_arm: projected_then,
                                else_arm: projected_else
                              )
                            )
                          }
                        )
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}

fn value_expr_project_body_subexpression(
  arrow: Node,
  node: Node,
  target: TargetModel
) -> Outcome<TargetValueExpression> {
  match node.kind {
    ComputationNode { behavior: Transform } =>
      project_transform_primitive_apply_in_arrow_scope(
        arrow: arrow,
        body: node,
        target: target
      )
    ComputationNode { behavior: Branch } =>
      project_branch_bool_if_else(arrow: arrow, body: node, target: target)
    TypeNode { connective: Atom { identity: _ } } =>
      value_expr_project_atom_literal(node: node)
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

// 🟡 gated — predicate-dissolution interim (INVARIANTS P3 / modeling-discipline Practice 10) —
// feature:arrow-domain-binding-list-membership — consumer:06_value_expression
// value_expr_arrow_body_scope_binding — bind: membership in
// arrow_domain_named_param_bindings ordered list — owner: T6 value-expression (lively-badger-242) —
// lane: compiler 06_value_expression — dissolve-on-arrival: std.collection symbol-list
// contains accessor; forbidden: local Bool fold membership predicates in compiler stages.
fn value_expr_binding_in_declared_param_list(
  binding: Symbol,
  bindings: List<Symbol>
) -> Bool {
  fold_list(xs: bindings, empty: false, cons: fn(acc, sym) {
    if acc {
      true
    } else if sym == binding {
      true
    } else {
      false
    }
  })
}

fn value_expr_arrow_body_scope_binding(
  arrow: Node,
  body: Node,
  binding: Symbol,
  target: TargetModel
) -> Outcome<Symbol> {
  bind_outcome(
    o: arrow_domain_named_param_bindings(arrow: arrow),
    f: fn(bindings) {
      if value_expr_binding_in_declared_param_list(binding: binding, bindings: bindings)
        && (
          value_expr_wave1_add_signature_matches_for_target(arrow: arrow, target: target)
          || value_expr_arrow_has_transform_body(arrow: arrow)
        ) {
        outcome_accepted(binding)
      } else {
        outcome_rejected(
          value_expr_diagnostic(
            reason: value_expr_reason_body_scope_binding_invalid,
            node: body
          )
        )
      }
    }
  )
}

fn project_transform_primitive_apply_in_arrow_scope(
  arrow: Node,
  body: Node,
  target: TargetModel
) -> Outcome<TargetValueExpression> {
  match body.kind {
    ComputationNode { behavior: Transform } =>
      if !all_edges_positional(children: body.children)
        || length(xs: node_positional_child_targets(node: body)) != 3 {
        outcome_rejected(
          value_expr_diagnostic(
            reason: value_expr_reason_transform_shape_invalid,
            node: body
          )
        )
      } else {
      bind_outcome(
        o: transform_surface_op_atom(node: body),
        f: fn(op_atom) {
          match surface_op_atom_to_canonical(op_atom: op_atom) {
            Absent =>
              outcome_rejected(
                value_expr_diagnostic(
                  reason: value_expr_reason_surface_op_unmapped,
                  node: body
                )
              )
            Present { value: canonical_op } =>
              bind_outcome(
                o: transform_positional_operand_binding(node: body, index: 1),
                f: fn(left_binding) {
                  bind_outcome(
                    o: value_expr_arrow_body_scope_binding(
                      arrow: arrow,
                      body: body,
                      binding: left_binding,
                      target: target
                    ),
                    f: fn(scoped_left_binding) {
                      bind_outcome(
                        o: transform_positional_operand_binding(node: body, index: 2),
                        f: fn(right_binding) {
                          bind_outcome(
                            o: value_expr_arrow_body_scope_binding(
                              arrow: arrow,
                              body: body,
                              binding: right_binding,
                              target: target
                            ),
                            f: fn(scoped_right_binding) {
                              outcome_accepted(
                                target_value_expression_primitive_apply(
                                  operation: canonical_op,
                                  operands: [
                                    target_value_expression_binding_ref(
                                      binding: scoped_left_binding
                                    ),
                                    target_value_expression_binding_ref(
                                      binding: scoped_right_binding
                                    )
                                  ]
                                )
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
          }
        }
      )
      }
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: body
        )
      )
  }
}

fn target_bundle_named_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match find_named_child(root: target.bundle, name: edge_name) {
        Accepted { value: child, diagnostics: d } =>
          Accepted { value: child, diagnostics: d }
        Rejected { diagnostics: _ } =>
          outcome_rejected(
            value_expr_diagnostic(
              reason: value_expr_reason_projection_bundle_missing,
              node: target.bundle
            )
          )
      }
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_projection_bundle_missing,
          node: target.bundle
        )
      )
  }
}

fn value_expression_projection_from_target(
  target: TargetModel
) -> Outcome<TargetValueExpressionProjection> {
  bind_outcome(
    o: target_bundle_named_child(
      target: target,
      edge_name: target_model_edge_value_expression_projection
    ),
    f: fn(bundle) {
      decode_value_expression_projection_bundle(bundle: bundle)
    }
  )
}

fn value_expression_to_concrete_tokens(
  expr: TargetValueExpression,
  target: TargetModel,
  projection: TargetValueExpressionProjection
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: target_bundle_named_child(
      target: target,
      edge_name: target_model_edge_operator_realizations
    ),
    f: fn(catalog) {
      target_value_expression_to_concrete_tokens(
        expr: expr,
        projection: projection,
        catalog: catalog
      )
    }
  )
}

// Export wrapper — disposition on value_expr_arrow_has_value_expression_body (Practice 10 consumer site).
fn arrow_has_transform_body(arrow: Node) -> Bool {
  value_expr_arrow_has_value_expression_body(arrow: arrow)
}

fn project_arrow_body_to_value_expression(
  arrow: Node,
  target: TargetModel
) -> Outcome<TargetValueExpression> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } =>
          project_transform_primitive_apply_in_arrow_scope(
            arrow: arrow,
            body: body,
            target: target
          )
        ComputationNode { behavior: Branch } =>
          project_branch_bool_if_else(arrow: arrow, body: body, target: target)
        _ =>
          outcome_rejected(
            value_expr_diagnostic(
              reason: value_expr_reason_transform_shape_invalid,
              node: body
            )
          )
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
