  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
