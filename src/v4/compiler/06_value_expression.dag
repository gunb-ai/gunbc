  target_value_expr_primitive_apply_operand_bindings,
  target_value_expression_binding_ref,
  target_value_expression_primitive_apply
}

data value_expr_reason_surface_op_unmapped: Symbol = value_expr_reason_surface_op_unmapped
data value_expr_reason_operator_catalog_miss: Symbol = value_expr_reason_operator_catalog_miss
data value_expr_reason_operator_catalog_ambiguous: Symbol = value_expr_reason_operator_catalog_ambiguous
data value_expr_reason_transform_shape_invalid: Symbol = value_expr_reason_transform_shape_invalid
data value_expr_reason_projection_bundle_missing: Symbol = value_expr_reason_projection_bundle_missing

fn value_expr_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// 🟡 gated — feature:canonical-op-from-surface-atom — dissolve-on: resolve maps surface op token → CanonicalOperation at resolve stage.
fn surface_op_atom_to_canonical(op_atom: Symbol) -> Optional<CanonicalOperation> {
  if op_atom == ^dag_token_plus {
    optional_present(canonical_operation_op_add())
  } else {
    optional_absent()
  }
}

fn transform_positional_operand_binding_at(
  source: Node,
  targets: FreeMonoid<Node>,
  wanted: Int,
  cursor: Int
) -> Outcome<Symbol> {
  match targets {
    Empty =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: source
        )
      )
    Cons { head: child, tail: rest } =>
      if cursor == wanted {
        match child.kind {
          TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
          _ =>
            outcome_rejected(
              value_expr_diagnostic(
                reason: value_expr_reason_transform_shape_invalid,
                node: child
              )
            )
        }
      } else {
        transform_positional_operand_binding_at(
          source: source,
          targets: rest,
          wanted: wanted,
          cursor: cursor + 1
        )
      }
  }
}

fn transform_positional_operand_binding(node: Node, index: Int) -> Outcome<Symbol> {
  transform_positional_operand_binding_at(
    source: node,
    targets: node_positional_child_targets(node: node),
    wanted: index,
    cursor: 0
  )
}

fn transform_surface_op_atom(node: Node) -> Outcome<Symbol> {
  transform_positional_operand_binding(node: node, index: 0)
}

fn transform_positional_child_count(node: Node) -> Int {
  length(xs: node_positional_child_targets(node: node))
}

fn project_transform_primitive_apply(node: Node) -> Outcome<TargetValueExpression> {
  match node.kind {
    ComputationNode { behavior: Transform } =>
      if transform_positional_child_count(node: node) != 3 {
        outcome_rejected(
          value_expr_diagnostic(
            reason: value_expr_reason_transform_shape_invalid,
            node: node
          )
        )
      } else {
      bind_outcome(
        o: transform_surface_op_atom(node: node),
        f: fn(op_atom) {
          match surface_op_atom_to_canonical(op_atom: op_atom) {
            Absent =>
              outcome_rejected(
                value_expr_diagnostic(
                  reason: value_expr_reason_surface_op_unmapped,
                  node: node
                )
              )
            Present { value: canonical_op } =>
              bind_outcome(
                o: transform_positional_operand_binding(node: node, index: 1),
                f: fn(left_binding) {
                  bind_outcome(
                    o: transform_positional_operand_binding(node: node, index: 2),
                    f: fn(right_binding) {
                      outcome_accepted(
                        target_value_expression_primitive_apply(
                          operation: canonical_op,
                          operands: [
                            target_value_expression_binding_ref(binding: left_binding),
                            target_value_expression_binding_ref(binding: right_binding)
                          ]
                        )
                      )
                    }
                  )
                }
              )
          }
        }
      )
      }
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

fn project_computation_to_value_expression(node: Node) -> Outcome<TargetValueExpression> {
  match node.kind {
    ComputationNode { behavior: Transform } =>
      project_transform_primitive_apply(node: node)
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: node
        )
      )
  }
}

fn target_bundle_named_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match find_named_child(root: target.bundle, name: edge_name) {
        Accepted { value: child, diagnostics: d } =>
          Accepted { value: child, diagnostics: d }
        Rejected { diagnostics: _ } =>
          outcome_rejected(
            value_expr_diagnostic(
              reason: value_expr_reason_projection_bundle_missing,
              node: target.bundle
            )
          )
      }
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_projection_bundle_missing,
          node: target.bundle
        )
      )
  }
}

fn value_expression_projection_from_target(
  target: TargetModel
) -> Outcome<TargetValueExpressionProjection> {
  bind_outcome(
    o: target_bundle_named_child(
      target: target,
      edge_name: target_model_edge_value_expression_projection
    ),
    f: fn(bundle) {
      decode_value_expression_projection_bundle(bundle: bundle)
    }
  )
}

fn operator_realization_shape_from_row(row: Node) -> Outcome<TargetOperatorShape> {
  match row.kind {
    TypeNode { connective: Conj } =>
      match fold(
        row.children,
        init: Rejected {
          diagnostics: diagnostics_singleton(
            d: value_expr_diagnostic(
              reason: value_expr_reason_operator_catalog_miss,
              node: row
            )
          )
        },
        f: fn(acc, e) {
          match acc {
            Accepted { value: _, diagnostics: _ } => acc
            Rejected { diagnostics: _ } =>
              match e.label {
                Named { name: n } =>
                  if n == target_operator_realization_field_shape {
                    match e.target.kind {
                      TypeNode { connective: Atom { identity: id } } =>
                        if id == discriminant(v: InfixToken {}) {
                          match fold(
                            e.target.children,
                            init: Rejected {
                              diagnostics: diagnostics_singleton(
                                d: value_expr_diagnostic(
                                  reason: value_expr_reason_operator_catalog_miss,
                                  node: row
                                )
                              )
                            },
                            f: fn(tok_acc, tok_e) {
                              match tok_acc {
                                Accepted { value: _, diagnostics: _ } => tok_acc
                                Rejected { diagnostics: _ } =>
                                  match tok_e.label {
                                    Named { name: tn } =>
                                      if tn == target_operator_shape_field_token {
                                        match tok_e.target.kind {
                                          TypeNode {
                                            connective: Atom { identity: token }
                                          } =>
                                            Accepted {
                                              value: InfixToken { token: token },
                                              diagnostics: None
                                            }
                                          _ => tok_acc
                                        }
                                      } else {
                                        tok_acc
                                      }
                                    Positional => tok_acc
                                  }
                              }
                            }
                          ) {
                            Accepted { value: shape, diagnostics: d } =>
                              Accepted { value: shape, diagnostics: d }
                            Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          }
                        } else {
                          acc
                        }
                      _ => acc
                    }
                  } else {
                    acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        Accepted { value: shape, diagnostics: d } =>
          Accepted { value: shape, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_operator_catalog_miss,
          node: row
        )
      )
  }
}

fn operator_realization_row_matches_operation(
  row: Node,
  operation: CanonicalOperation
) -> Bool {
  match row.kind {
    TypeNode { connective: Conj } =>
      fold(
        row.children,
        init: false,
        f: fn(acc, e) {
          match e.label {
            Named { name: n } =>
              if n == target_operator_realization_field_operation {
                match e.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    acc || (id == discriminant(v: operation))
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
        }
      )
    _ => false
  }
}

type TargetOperatorRealizationLookup
  = TargetOperatorRealizationMissing
  | TargetOperatorRealizationUnique { realization: TargetOperatorRealization }
  | TargetOperatorRealizationAmbiguous

fn target_operator_realization_lookup_step(
  acc: TargetOperatorRealizationLookup,
  row: Node,
  operation: CanonicalOperation
) -> TargetOperatorRealizationLookup {
  if operator_realization_row_matches_operation(row: row, operation: operation) {
    match acc {
      TargetOperatorRealizationUnique { realization: _ } => TargetOperatorRealizationAmbiguous
      TargetOperatorRealizationAmbiguous => TargetOperatorRealizationAmbiguous
      TargetOperatorRealizationMissing =>
        match operator_realization_shape_from_row(row: row) {
          Accepted { value: shape, diagnostics: _ } =>
            TargetOperatorRealizationUnique {
              realization: TargetOperatorRealization {
                operation: operation,
                shape: shape
              }
            }
          Rejected { diagnostics: _ } => TargetOperatorRealizationMissing
        }
    }
  } else {
    acc
  }
}

fn operator_realization_lookup(
  catalog: Node,
  operation: CanonicalOperation
) -> Outcome<TargetOperatorRealization> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: TargetOperatorRealizationMissing,
        f: fn(acc, e) {
          match e.label {
            Named { name: _ } =>
              target_operator_realization_lookup_step(
                acc: acc,
                row: e.target,
                operation: operation
              )
            Positional => acc
          }
        }
      ) {
        TargetOperatorRealizationMissing =>
          outcome_rejected(
            value_expr_diagnostic(
              reason: value_expr_reason_operator_catalog_miss,
              node: catalog
            )
          )
        TargetOperatorRealizationUnique { realization: row } =>
          outcome_accepted(row)
        TargetOperatorRealizationAmbiguous =>
          outcome_rejected(
            value_expr_diagnostic(
              reason: value_expr_reason_operator_catalog_ambiguous,
              node: catalog
            )
          )
      }
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_operator_catalog_miss,
          node: catalog
        )
      )
  }
}

fn operator_realization_catalog_from_target(target: TargetModel) -> Outcome<Node> {
  target_bundle_named_child(
    target: target,
    edge_name: target_model_edge_operator_realizations
  )
}

fn primitive_apply_operand_binding_from_operand_node(operand_node: Node) -> Optional<Symbol> {
  match fold(
    operand_node.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == target_value_expr_field_binding {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } => optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: binding } => optional_present(value: binding)
    Absent => optional_absent()
  }
}

fn primitive_apply_operation_from_expr(expr: TargetValueExpression) -> Outcome<CanonicalOperation> {
  match expr.kind {
    TargetValueExprPrimitiveApply =>
      match fold(
        expr.node.children,
        init: Rejected {
          diagnostics: diagnostics_singleton(
            d: value_expr_diagnostic(
              reason: value_expr_reason_transform_shape_invalid,
              node: expr.node
            )
          )
        },
        f: fn(acc, e) {
          match acc {
            Accepted { value: _, diagnostics: _ } => acc
            Rejected { diagnostics: _ } =>
              match e.label {
                Named { name: n } =>
                  if n == target_value_expr_field_operation {
                    match e.target.kind {
                      TypeNode { connective: Atom { identity: id } } =>
                        if id == discriminant(v: canonical_operation_op_add()) {
                          outcome_accepted(canonical_operation_op_add())
                        } else {
                          outcome_rejected(
                            value_expr_diagnostic(
                              reason: value_expr_reason_surface_op_unmapped,
                              node: expr.node
                            )
                          )
                        }
                      _ =>
                        outcome_rejected(
                          value_expr_diagnostic(
                            reason: value_expr_reason_transform_shape_invalid,
                            node: expr.node
                          )
                        )
                    }
                  } else {
                    acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        Accepted { value: canonical_op, diagnostics: d } =>
          Accepted { value: canonical_op, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: expr.node
        )
      )
  }
}

fn primitive_apply_operand_bindings(expr: TargetValueExpression) -> Outcome<List<Symbol>> {
  match expr.kind {
    TargetValueExprPrimitiveApply =>
      target_value_expr_primitive_apply_operand_bindings(wire: expr.node)
    _ =>
      outcome_rejected(
        value_expr_diagnostic(
          reason: value_expr_reason_transform_shape_invalid,
          node: expr.node
        )
      )
  }
}

fn value_expression_to_concrete_tokens(
  expr: TargetValueExpression,
  target: TargetModel,
  projection: TargetValueExpressionProjection
) -> Outcome<List<ConcreteSyntaxToken>> {
  bind_outcome(
    o: operator_realization_catalog_from_target(target: target),
    f: fn(catalog) {
      match expr.kind {
        TargetValueExprPrimitiveApply =>
          bind_outcome(
            o: primitive_apply_operation_from_expr(expr: expr),
            f: fn(canonical_op) {
              bind_outcome(
                o: primitive_apply_operand_bindings(expr: expr),
                f: fn(bindings) {
                  if length(xs: bindings) != 2 {
                    outcome_rejected(
                      value_expr_diagnostic(
                        reason: value_expr_reason_transform_shape_invalid,
                        node: expr.node
                      )
                    )
                  } else {
                    match list_at_optional(xs: bindings, index: 0) {
                      Absent =>
                        outcome_rejected(
                          value_expr_diagnostic(
                            reason: value_expr_reason_transform_shape_invalid,
                            node: expr.node
                          )
                        )
                      Present { value: left_binding } =>
                        match list_at_optional(xs: bindings, index: 1) {
                          Absent =>
                            outcome_rejected(
                              value_expr_diagnostic(
                                reason: value_expr_reason_transform_shape_invalid,
                                node: expr.node
                              )
                            )
                          Present { value: right_binding } =>
                            bind_outcome(
                              o: operator_realization_lookup(
                                catalog: catalog,
                                operation: canonical_op
                              ),
                              f: fn(realization) {
                                match realization.shape {
                                  InfixToken { token: op_token } =>
                                    outcome_accepted(
                                      [
                                        BoundToken {
                                          token_class: projection.binding_ref_form.ident_token,
                                          binding: left_binding
                                        },
                                        FixedToken { token_class: op_token },
                                        BoundToken {
                                          token_class: projection.binding_ref_form.ident_token,
                                          binding: right_binding
                                        }
                                      ]
                                    )
                                  _ =>
                                    outcome_rejected(
                                      value_expr_diagnostic(
                                        reason: value_expr_reason_operator_catalog_miss,
                                        node: expr.node
                                      )
                                    )
                                }
                              }
                            )
                        }
                    }
                  }
                }
              )
            }
          )
        _ =>
          outcome_rejected(
            value_expr_diagnostic(
              reason: value_expr_reason_transform_shape_invalid,
              node: expr.node
            )
          )
      }
    }
  )
}

// 🟡 gated — predicate-dissolution interim (INVARIANTS.md P3 / modeling-discipline Practice 10) —
// feature:t6-value-expr-bodied-arrow-serialize — consumer:06_translate bodied-arrow translate/serialize
// dispatch — bind: PR #4627 / docs/design-value-emit-schema.md §4.5 (#4623 vetting consumer) —
// owner: T6 value-expression skeleton (lively-badger-242) — lane: compiler 06_value_expression +
// 06_translate — dissolve-on-arrival: bodied Arrow serialize routes through grammar relation-row /
// connective dispatch (TargetBodiedArrowStatementScaffold absorbed into translation_rules); delete
// arrow_has_transform_body, translate_node bodied bypass, and serialize bodied branches — forbidden:
// steady-state Bool predicates over ComputationNode behavior Transform for emit dispatch.
fn arrow_has_transform_body(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: Transform } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn project_arrow_body_to_value_expression(arrow: Node) -> Outcome<TargetValueExpression> {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      project_computation_to_value_expression(node: body)
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
