// src/v4/compiler/03_normalize.dag
//
// Scope: Stage 3a — ParseTree→NormalizedTree; C3 sugar to Node.
// Owns: NormalizedTree; SurfaceSugarKind; normalize; stage Symbol reasons.
// Consumes: std/node.dag, std/diagnostic.dag, compiler/02_parse.dag, extdeps/languages/dag.dag.
// Status: scaffold — TASKS T-8.
// Anchor: https://en.wikipedia.org/wiki/Abstract_syntax_tree

module v4.compiler.normalize


import v4.compiler.parse { ParseTree }
import v4.extdeps.languages.dag {
  dag_c3_surface_sugar_fn,
  dag_c3_surface_sugar_operation,
  dag_c3_surface_sugar_service,
  dag_c3_surface_sugar_type
}
import v4.std.diagnostic {Diagnostic, NodeLocus, Outcome, UserInputBoundary, Accepted, None, diagnostics_singleton}
import v4.std.node {
  Connective,
  Edge,
  Node,
  Symbol,
  edge_is_named,
  edge_is_positional,
  node_well_formed
}


type NormalizedTree = Node


data normalize_reason_malformed_sugar: Symbol = normalize_reason_malformed_sugar
data normalize_reason_post_normalize_not_well_formed: Symbol = normalize_reason_post_normalize_not_well_formed


// 🟡 coproduct dissolution — CP-1b item 4 (SurfaceSugarKind).
type SurfaceSugarKind
  = ServiceSugar
  | FnSugar
  | TypeSugar
  | OperationSugar


fn some_surface_sugar_kind(kind: SurfaceSugarKind) -> SurfaceSugarKind? {
  Some { value: kind }
}


fn no_surface_sugar_kind() -> SurfaceSugarKind? {
  None
}


fn classify_sugar(n: Node) -> SurfaceSugarKind? {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == dag_c3_surface_sugar_service {
        some_surface_sugar_kind(kind: ServiceSugar)
      } else {
        if id == dag_c3_surface_sugar_fn {
          some_surface_sugar_kind(kind: FnSugar)
        } else {
          if id == dag_c3_surface_sugar_type {
            some_surface_sugar_kind(kind: TypeSugar)
          } else {
            if id == dag_c3_surface_sugar_operation {
              some_surface_sugar_kind(kind: OperationSugar)
            } else {
              no_surface_sugar_kind()
            }
          }
        }
      }
    TypeNode { connective: _ } => no_surface_sugar_kind()
    ComputationNode { behavior: _ } => no_surface_sugar_kind()
  }
}


fn malformed_sugar_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: normalize_reason_malformed_sugar,
    at: NodeLocus { node: n },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn post_normalize_not_well_formed_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: normalize_reason_post_normalize_not_well_formed,
    at: NodeLocus { node: n },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn exactly_one_child(children: List<Edge>) -> Bool {
  count(children) == 1
}


fn normalize_edge(e: Edge) -> Outcome<Edge> {
  match normalize_node(n: e.target) {
    Accepted { value: normalized_target, diagnostics: None } =>
      Accepted { value: Edge {
          label: e.label,
          target: normalized_target
        }, diagnostics: None }
    Rejected { diagnostics: diagnostics_singleton(d: d) } => Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


fn empty_normalized_children() -> Outcome<List<Edge>> {
  Accepted { value: Empty, diagnostics: None }
}


fn normalize_children(children: List<Edge>) -> Outcome<List<Edge>> {
  fold(children, init: empty_normalized_children(), f: fn(acc, e) {
    match acc {
      Rejected { diagnostics: diagnostics_singleton(d: d) } =>
        Rejected { diagnostics: diagnostics_singleton(d: d) }
      Accepted { value: done, diagnostics: None } =>
        match normalize_edge(e: e) {
          Accepted { value: normalized_edge, diagnostics: None } =>
            Accepted { value: list_push(done, normalized_edge), diagnostics: None }
          Rejected { diagnostics: diagnostics_singleton(d: d) } =>
            Rejected { diagnostics: diagnostics_singleton(d: d) }
        }
    }
  })
}


fn type_node(connective: Connective, children: List<Edge>) -> Node {
  Node {
    kind: TypeNode { connective: connective },
    children: children
  }
}


fn all_children_named(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && edge_is_named(e: e)
  })
}


fn all_children_positional(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && edge_is_positional(e: e)
  })
}


fn normalize_sugar(kind: SurfaceSugarKind, n: Node, children: List<Edge>) -> Outcome<Node> {
  match kind {
    ServiceSugar =>
      if all_children_named(children: children) {
        Accepted { value: type_node(connective: Conj, children: children), diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: malformed_sugar_diagnostic(n: n)) }
      }
    FnSugar =>
      if all_children_positional(children: children) {
        Accepted { value: type_node(connective: Arrow, children: children), diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: malformed_sugar_diagnostic(n: n)) }
      }
    TypeSugar =>
      if exactly_one_child(children: children) {
        match children |> first {
          Some { value: e0 } =>
            if edge_is_positional(e: e0) {
              Accepted { value: e0.target, diagnostics: None }
            } else {
              Rejected { diagnostics: diagnostics_singleton(d: malformed_sugar_diagnostic(n: n)) }
            }
          None =>
            Rejected { diagnostics: diagnostics_singleton(d: malformed_sugar_diagnostic(n: n)) }
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: malformed_sugar_diagnostic(n: n)) }
      }
    OperationSugar =>
      if all_children_positional(children: children) {
        Accepted { value: type_node(connective: Arrow, children: children), diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: malformed_sugar_diagnostic(n: n)) }
      }
  }
}


fn normalize_node(n: Node) -> Outcome<Node> {
  match normalize_children(children: n.children) {
    Rejected { diagnostics: diagnostics_singleton(d: d) } => Rejected { diagnostics: diagnostics_singleton(d: d) }
    Accepted { value: normalized_children, diagnostics: None } =>
      match classify_sugar(n: n) {
        Some { value: kind } =>
          normalize_sugar(kind: kind, n: n, children: normalized_children)
        None =>
          Accepted { value: Node {
              kind: n.kind,
              children: normalized_children
            }, diagnostics: None }
      }
  }
}


fn normalize(parse_tree: ParseTree) -> Outcome<NormalizedTree> {
  match normalize_node(n: parse_tree) {
    Rejected { diagnostics: diagnostics_singleton(d: d) } => Rejected { diagnostics: diagnostics_singleton(d: d) }
    Accepted { value: normalized, diagnostics: None } =>
      if node_well_formed(n: normalized) {
        Accepted { value: normalized, diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: post_normalize_not_well_formed_diagnostic(n: normalized)) }
      }
  }
}
