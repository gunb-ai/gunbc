data layering_imports_scanner_perturb_receipt_rows: List<LayeringImportsScannerPerturbReceiptRow> = [
  perturb_row_std_v4_prefix,
  perturb_row_extdeps_v4_prefix,
  perturb_row_v3_std_exact,
  perturb_row_dsl_std_v3_prefix,
  perturb_row_dsl_extdeps_v4_exact,
  perturb_row_parse_level_pre_resolve
]

// Coverage-domain equivalence argument (zesty sign=CUTOVER). This file proves the COVERING half
// by-execution; the DETECTION half is the executable (i) gate-perturb (plant → REAL scan → RED).
// These 4 target-forms ARE exactly FORBIDDEN_EXACT ∪ FORBIDDEN_PREFIXES; these 5 roots ARE
// exactly LAYER_ROOTS; *.dag is the only scanned type; the leading-import is the only matched
// form. The (root × form) cross-product is therefore the complete domain. The lens covers it
// because: (a) a host-execution plant under EACH of the 5 roots, scanned by the REAL binary,
// proves scan_repo WALKS each root (scope); (b) a plant of EACH of the 4 forms, scanned, proves
// is_forbidden_compiler_import catches each form; (c) the form-check is ROOT-INDEPENDENT by
// lens structure (is_layering_violation applies is_forbidden_compiler_import on the module
// string unconditionally — src/v4/lens/layering_imports.dag), so per-root × per-form coverage
// ⇒ all 5×4 classes; (d) the parse_level row plants a forbidden import alongside an unrelated
// resolve error and is still flagged (python pre-resolve TEXT scan; IMPORT_RE over raw lines).

// Some perturb receipt row carries `root` as its layer_root (covering, not counting).
fn rows_cover_root(root: String) -> Bool {
  any(
    xs: layering_imports_scanner_perturb_receipt_rows,
    predicate: fn(row) { row.layer_root == root }
  )
}

// Some perturb receipt row carries `form` as its forbidden_form (covering, not counting).
fn rows_cover_form(form: String) -> Bool {
  any(
    xs: layering_imports_scanner_perturb_receipt_rows,
    predicate: fn(row) { row.forbidden_form == form }
  )
}

// COVERING: for EACH python layer-root some row carries it, and for EACH forbidden form some row
// carries it. A coverage-breaking roster edit (drop/duplicate-away a root or form) leaves a cell
// uncovered → this goes RED. The cardinality conjuncts are a belt-and-suspenders roster-pin.
fn coverage_domain_equivalence_argument_holds() -> Bool {
  rows_cover_root(root: python_layer_root_src_v4_std)
    && rows_cover_root(root: python_layer_root_src_v3_std)
    && rows_cover_root(root: python_layer_root_dsl_std)
    && rows_cover_root(root: python_layer_root_src_v4_extdeps)
    && rows_cover_root(root: python_layer_root_dsl_extdeps)
    && rows_cover_form(form: python_form_v3_compiler_exact)
    && rows_cover_form(form: python_form_v3_compiler_prefix)
    && rows_cover_form(form: python_form_v4_compiler_exact)
    && rows_cover_form(form: python_form_v4_compiler_prefix)
    && length(xs: python_layer_roots) == 5
    && length(xs: python_forbidden_forms) == 4
    && length(xs: layering_imports_scanner_perturb_receipt_rows) == 6
}
