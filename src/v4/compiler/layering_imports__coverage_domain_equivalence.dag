module v4.test.layering_imports.coverage_domain_equivalence

import v4.std.algebra { any, length }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.text { String }

// --- Python source rule enumeration (check_v4_layering_imports.py @ daf95e49; DELETED in this PR;
//     line numbers below are at daf95e49, git-recoverable) ---
// LAYER_ROOTS (:31) = 5 roots: src/v4/std, src/v3/std, dsl/std, src/v4/extdeps, dsl/extdeps
// file type = *.dag only (rglob :87)
// import form = leading `import <dotted.path>` (IMPORT_RE ^\s*import\s+([\w.]+) :26)
// target = FORBIDDEN_EXACT {v3.compiler, v4.compiler} (:28)
//       ∪ FORBIDDEN_PREFIXES {v3.compiler., v4.compiler.} (:27), tested :75-78
// => COMPLETE violation domain = {5 roots} × {4 target-forms} over leading-import, *.dag only.

data python_rule_source: String = "scripts/check_v4_layering_imports.py @ daf95e49 (deleted in this PR)"

data python_layer_root_src_v4_std: String = "src/v4/std"
data python_layer_root_src_v3_std: String = "src/v3/std"
data python_layer_root_dsl_std: String = "dsl/std"
data python_layer_root_src_v4_extdeps: String = "src/v4/extdeps"
data python_layer_root_dsl_extdeps: String = "dsl/extdeps"

data python_layer_roots: List<String> = [
  python_layer_root_src_v4_std,
  python_layer_root_src_v3_std,
  python_layer_root_dsl_std,
  python_layer_root_src_v4_extdeps,
  python_layer_root_dsl_extdeps
]

data python_form_v3_compiler_exact: String = "v3.compiler exact"
data python_form_v3_compiler_prefix: String = "v3.compiler.* prefix"
data python_form_v4_compiler_exact: String = "v4.compiler exact"
data python_form_v4_compiler_prefix: String = "v4.compiler.* prefix"

data python_forbidden_forms: List<String> = [
  python_form_v3_compiler_exact,
  python_form_v3_compiler_prefix,
  python_form_v4_compiler_exact,
  python_form_v4_compiler_prefix
]

type LayeringImportsScannerPerturbReceiptRow {
  label: String
  layer_root: String
  forbidden_form: String
  scanner_entry: String
  scanner_function: String
}

// Scanner-execution perturb roster (host plant → REAL scan → witness; NOT hardcoded facts).
data perturb_row_std_v4_prefix: LayeringImportsScannerPerturbReceiptRow = LayeringImportsScannerPerturbReceiptRow {
  label: "src/v4/std × v4.compiler.* prefix",
  layer_root: python_layer_root_src_v4_std,
  forbidden_form: python_form_v4_compiler_prefix,
  scanner_entry: "src/v4/test/claim/layering_imports/scanner/std_v4_prefix.dag",
  scanner_function: "scanner_std_v4_prefix_detects_holds"
}

data perturb_row_extdeps_v4_prefix: LayeringImportsScannerPerturbReceiptRow = LayeringImportsScannerPerturbReceiptRow {
  label: "src/v4/extdeps × v4.compiler.* prefix",
  layer_root: python_layer_root_src_v4_extdeps,
