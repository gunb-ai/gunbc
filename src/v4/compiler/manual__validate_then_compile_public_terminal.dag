// Scope: Wave-5-A — P3 commitment 6 public terminal; empty required-lens list + reject-before-compile gate.
// Anchor: docs/design-v4-compiler-homomorphism.md P3 commitment 6


module v4.test.manual.validate_then_compile_public_terminal


import v4.compiler.compile {
  CompileMode,
  CompileLens,
  CompileOutput,
  TranslateResult,
  TranslateTo,
  Validated,
  compile_lens_gate_rejected,
  compile_lens_gate_rejected_diagnostic,
  validate_then_compile
}
import v4.compiler.infer { InferredTree }
import v4.std.compilers.target_model { TargetModel }
import v4.std.compilers.lexing { VoidLexRules }
import v4.test.manual.infer_ground_add_mvp { fixture_add_resolved_tree }
import v4.std.diagnostic {
  Accepted,
  None,
  Outcome,
  port_locus,
  Rejected,
  outcome_accepted,
  outcome_rejected
}
import v4.std.algebra { Empty }
import v4.std.collection { empty_map }
import v4.std.node { Atom, Conj, Node, Symbol, TypeNode, SyntheticOccurrence }
import v4.std.verification {
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  CompilesClaim,
  DiagnosticClaim,
  EqualsClaim,
  manual_claim_anchor
}
import v4.std.witness { Holds, Witness }
data rust_target_model_stub: TargetModel = TargetModel {
  bundle: Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
},
  lex: VoidLexRules,
  binding_spellings: empty_map(),
  authority_source_text: Empty
}
fn claim_symbol_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}


fn always_reject_lens_gate(_tree: InferredTree) -> Outcome<Witness<Node>> {
  outcome_rejected(
    compile_lens_gate_rejected_diagnostic(
      at: port_locus(port: ^rejecting_lens_gate_at)
    )
  )
}


data rejecting_lens: CompileLens = CompileLens { gate: always_reject_lens_gate }


fn grounding_sanity_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  outcome_accepted(Holds { value: tree.root })
}


data grounding_sanity_lens: CompileLens = CompileLens { gate: grounding_sanity_gate }


fn anchor_validate_then_compile_empty_lenses() -> Outcome<Validated<CompileOutput>> {
  validate_then_compile(
    source: fixture_add_resolved_tree(),
    lenses: [],
    mode: TranslateTo { target: rust_target_model_stub }
  )
}


fn anchor_validate_then_compile_rejecting_lens() -> Outcome<Validated<CompileOutput>> {
  validate_then_compile(
    source: fixture_add_resolved_tree(),
    lenses: [rejecting_lens],
    mode: TranslateTo { target: rust_target_model_stub }
  )
}


fn claim_empty_lenses_matches_compile_core_outcome(
  actual: Outcome<Validated<CompileOutput>>
) -> Bool {
  match actual {
    Rejected { diagnostics: r } =>
      r.head.reason != compile_lens_gate_rejected
    Accepted { value: v, diagnostics: _ } => match v.value {
      TranslateResult { source: _ } => true
      _ => false
    }
  }
}


fn claim_rejecting_lens_is_compile_lens_gate_rejected(
  actual: Outcome<Validated<CompileOutput>>
) -> Bool {
  match actual {
    Rejected { diagnostics: r } =>
      r.head.reason == compile_lens_gate_rejected
    Accepted { value: _, diagnostics: _ } => false
  }
}


data claim_validate_then_compile_module_compiles: TestClaim = CompilesClaim {
  label: "manual/wave-5-a: validate_then_compile public terminal module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: ^claim_validate_then_compile_module,
  expected_value: ^claim_validate_then_compile_module,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_empty_lenses_skips_gate: TestClaim = EqualsClaim {
  label: "manual/wave-5-a: empty lens list does not compile_lens_gate_reject (infer/compile-core Rejected OK)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ^claim_validate_then_compile_module,
  rhs: claim_validate_then_compile_skips_gate_passes(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


fn claim_validate_then_compile_skips_gate_passes() -> Node {
  if claim_empty_lenses_matches_compile_core_outcome(
    actual: anchor_validate_then_compile_empty_lenses()
  ) {
    claim_symbol_node(s: ^claim_validate_then_compile_module)
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}


data claim_rejecting_lens_blocks_before_compile: TestClaim = EqualsClaim {
  label: "manual/wave-5-a: required lens Rejected blocks before compile-core",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: ^claim_validate_then_compile_module,
  rhs: claim_rejecting_lens_blocks_passes(),
  classification: TestClassification { tier: Tier1, layer: Unit }
}


fn claim_rejecting_lens_blocks_passes() -> Node {
  if claim_rejecting_lens_is_compile_lens_gate_rejected(
    actual: anchor_validate_then_compile_rejecting_lens()
  ) {
    claim_symbol_node(s: ^claim_validate_then_compile_module)
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [],
      occurrence_id: SyntheticOccurrence
}
  }
}
