// Scope: by-execution receipt for the structured-normalize emit in std/compilers/body_lowering.dag
// (lower_block_body_atoms / lower_binary_infix) — slice (i) of the normalize-to-dispatch
// dissolution (node://adhoc-87678e9b-420). Proves the binary-infix body `[a, op, b]` lowers to a
// Transform call AND — the coherence witness — that the emitted node IS recognized by the slice-(i)
// call-carrier (node_is_call / call_callee_target / call_argument_targets): the emit and the
// body_producer dispatch agree on the carrier shape by construction, not by coincidence.
// Status: unit-tier by-execution TestClaim (no pipeline; synthetic body atoms).

module v4.test.manual.body_lowering_infix

import v4.std.node {
  Atom,
  Node,
  TypeNode,
  node_synthetic
}
import v4.std.compilers.body_lowering { lower_block_body_atoms }
import v4.std.node_query {
  call_argument_targets,
  call_callee_target,
  node_is_call
}
import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.collection { Absent, List, Present, list_at_optional }
import v4.std.logic { Bool }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}

fn body_lowering_bool_node(pass: Bool) -> Node {
  if pass {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_pass } },
      children: []
    )
  } else {
    node_synthetic(
      kind: TypeNode { connective: Atom { identity: ^body_lowering_fail } },
      children: []
    )
  }
}

// Surface body atoms of `{ x + y }` (pre-resolve): operand `x`, operator `+`, operand `y`.
fn body_lowering_atom_x() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^body_lowering_x } }, children: [])
}
fn body_lowering_atom_plus() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^dag_token_plus } }, children: [])
}
fn body_lowering_atom_y() -> Node {
  node_synthetic(kind: TypeNode { connective: Atom { identity: ^body_lowering_y } }, children: [])
}

fn body_lowering_infix_atoms() -> List<Node> {
  [body_lowering_atom_x(), body_lowering_atom_plus(), body_lowering_atom_y()]
}

fn body_lowering_emitted() -> Outcome<Node> {
  lower_block_body_atoms(
    atoms: body_lowering_infix_atoms(),
    witness: body_lowering_atom_plus()
  )
}

// The emitted body is recognized by the carrier as a call.
fn body_lowering_emit_is_call() -> Bool {
  match body_lowering_emitted() {
    Accepted { value: body, diagnostics: _ } => node_is_call(node: body)
    Rejected { diagnostics: _ } => false
  }
}

// Callee carrier == the operator `+`; the emit puts the operator at child[0] (the callee slot).
fn body_lowering_emit_callee_is_operator() -> Bool {
  match body_lowering_emitted() {
    Accepted { value: body, diagnostics: _ } =>
      match call_callee_target(node: body) {
        Accepted { value: callee, diagnostics: _ } => callee == body_lowering_atom_plus()
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}

// Argument carrier == the two operands in surface order [x, y].
fn body_lowering_emit_args_are_operands() -> Bool {
  match body_lowering_emitted() {
    Accepted { value: body, diagnostics: _ } =>
      let args = call_argument_targets(node: body)
      let arity_two = count(args) == 2
      let first_is_x = match list_at_optional(xs: args, index: 0) {
        Present { value: a0 } => a0 == body_lowering_atom_x()
        Absent => false
      }
      let second_is_y = match list_at_optional(xs: args, index: 1) {
        Present { value: a1 } => a1 == body_lowering_atom_y()
        Absent => false
      }
      arity_two && first_is_x && second_is_y
    Rejected { diagnostics: _ } => false
  }
}

// A non-binary (here single-atom) body is the unsupported-form reject.
fn body_lowering_rejects_non_binary() -> Bool {
  match lower_block_body_atoms(
    atoms: [body_lowering_atom_plus()],
    witness: body_lowering_atom_plus()
  ) {
    Accepted { value: _, diagnostics: _ } => false
    Rejected { diagnostics: _ } => true
  }
}

data claim_body_lowering_emit_is_call: TestClaim = EqualsClaim {
  label: "manual/body-lowering: binary-infix body lowers to a carrier-recognized Transform call",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_bool_node(pass: body_lowering_emit_is_call()),
  rhs: body_lowering_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_emit_callee_is_operator: TestClaim = EqualsClaim {
  label: "manual/body-lowering: emitted callee child[0] is the infix operator (call_callee_target)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_bool_node(pass: body_lowering_emit_callee_is_operator()),
  rhs: body_lowering_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_emit_args_are_operands: TestClaim = EqualsClaim {
  label: "manual/body-lowering: emitted args are the operands [x, y] in surface order (call_argument_targets)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_bool_node(pass: body_lowering_emit_args_are_operands()),
  rhs: body_lowering_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}

data claim_body_lowering_rejects_non_binary: TestClaim = EqualsClaim {
  label: "manual/body-lowering: a non-binary body atom sequence is the unsupported-form reject",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: body_lowering_bool_node(pass: body_lowering_rejects_non_binary()),
  rhs: body_lowering_bool_node(pass: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
