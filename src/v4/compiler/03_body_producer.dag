// src/v4/compiler/03_body_producer.dag
// Scope: COMPREP wave-1 — parse-tree / surface expression → Behavior sub-DAG; Arrow.body attachment.
// Status: keystone producer slice — MVP add(x,y)=x+y body construction + E-9 edge attach.
// Anchor: docs/design-computation-representation.md wave 1; INVARIANTS E-9.

module v4.compiler.body_producer

import v4.std.algebra { list_append, list_snoc_item }
import v4.std.collection { Absent, List, Present, list_at_optional }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v4.std.node {
  Arrow,
  Atom,
  Branch,
  ComputationNode,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode,
  Value,
  arrow_body_edge,
  node_rebuild,
  node_synthetic,
  well_formed
}
import v4.extdeps.languages.dag {
  dag_mvp1_add_arrow_signature_node,
  dag_mvp1_add_arrow_with_body_swapped_operands_fixture,
  dag_mvp1_add_operator_node,
  dag_mvp1_captured_flat_atom_binding_for_ident,
  dag_mvp1_int_type_binding,
  dag_mvp1_node_is_int_literal_atom,
  dag_mvp1_node_is_kw_false_atom,
  dag_mvp1_node_is_kw_true_atom,
  dag_mvp1_pick_arrow_with_body_fixture,
  dag_mvp1_pick_arrow_with_body_swapped_arms_fixture,
  dag_mvp1_pick_captured_flat_atom_binding_for_ident
}
import v4.std.node_query {
  arrow_domain_named_param_bindings,
  find_arrow_body_child,
  find_named_child
}

data body_producer_reason_malformed_attachment: Symbol = body_producer_reason_malformed_attachment
data body_producer_reason_post_produce_not_well_formed: Symbol = body_producer_reason_post_produce_not_well_formed
data body_producer_reason_mvp1_resolved_not_arrow: Symbol = body_producer_reason_mvp1_resolved_not_arrow
data body_producer_reason_mvp1_resolved_shape: Symbol = body_producer_reason_mvp1_resolved_shape

// COMPREP wave-2 M0-B1 — bridge maps parse atoms to eval-recognizable literal/condition symbols.
data body_producer_pick_lit_one: Symbol = ^dag_mvp1_pick_lit_one
data body_producer_pick_lit_two: Symbol = ^dag_mvp1_pick_lit_two
data body_producer_pick_kw_true: Symbol = ^dag_token_kw_true
data body_producer_pick_kw_false: Symbol = ^dag_token_kw_false

fn body_producer_diagnostic(reason: Symbol, n: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: n),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn type_atom_node(identity: Symbol) -> Node {
  node_synthetic(
    kind: TypeNode { connective: Atom { identity: identity } },
    children: []
  )
}

fn computation_param_ref_node(identity: Symbol) -> Node {
  type_atom_node(identity: identity)
}

fn attach_arrow_body(arrow: Node, body: Node) -> Outcome<Node> {
  match arrow.kind {
    TypeNode { connective: Arrow } =>
      outcome_accepted(
        value: node_rebuild(
          n: arrow,
          children: list_snoc_item(
            xs: arrow.children,
            item: Edge {
              label: Named { name: arrow_body_edge },
              target: body
            }
          )
        )
      )
    _ =>
      outcome_rejected(
        d: body_producer_diagnostic(
          reason: body_producer_reason_malformed_attachment,
          n: arrow
        )
      )
  }
}

fn body_producer_arrow_domain_conj_from_binding_ids(bindings: List<Symbol>) -> Outcome<Node> {
  match list_at_optional(xs: bindings, index: 0) {
    Absent =>
      outcome_rejected(
        d: body_producer_diagnostic(
          reason: body_producer_reason_mvp1_resolved_shape,
          n: node_synthetic(kind: TypeNode { connective: Conj }, children: [])
        )
      )
    Present { value: left_binding } =>
      match list_at_optional(xs: bindings, index: 1) {
        Absent =>
          outcome_rejected(
            d: body_producer_diagnostic(
              reason: body_producer_reason_mvp1_resolved_shape,
              n: node_synthetic(kind: TypeNode { connective: Conj }, children: [])
            )
          )
        Present { value: right_binding } =>
          outcome_accepted(
            value: node_synthetic(
              kind: TypeNode { connective: Conj },
              children: [
                Edge {
                  label: Named { name: left_binding },
                  target: type_atom_node(identity: dag_mvp1_int_type_binding())
                },
                Edge {
                  label: Named { name: right_binding },
                  target: type_atom_node(identity: dag_mvp1_int_type_binding())
                }
              ]
            )
          )
      }
  }
}

fn body_producer_transform_body_from_bindings(
  operator: Node,
  param_bindings: List<Symbol>
) -> Outcome<Node> {
  match list_at_optional(xs: param_bindings, index: 0) {
    Absent =>
      outcome_rejected(
        d: body_producer_diagnostic(
          reason: body_producer_reason_mvp1_resolved_shape,
          n: operator
        )
      )
    Present { value: left_binding } =>
      match list_at_optional(xs: param_bindings, index: 1) {
        Absent =>
          outcome_rejected(
            d: body_producer_diagnostic(
              reason: body_producer_reason_mvp1_resolved_shape,
              n: operator
            )
          )
        Present { value: right_binding } =>
          outcome_accepted(
            value: node_synthetic(
              kind: ComputationNode { behavior: Transform },
              children: [
                Edge { label: Positional, target: operator },
                Edge {
                  label: Positional,
                  target: computation_param_ref_node(identity: left_binding)
                },
                Edge {
                  label: Positional,
                  target: computation_param_ref_node(identity: right_binding)
                }
              ]
            )
          )
      }
  }
}

// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10 /
// INVARIANTS P5) — feature:COMPREP-WAVE1-BODY-BRIDGE — consumer:produce_mvp1_add_arrow_with_body_from_resolved
// (executed by comprep_eval_by_execution keystone) — bind:node://adhoc-9a72d4fb-8c2 —
// dissolve-on: body_producer reads structured normalize/resolve Behavior carriers instead of
// flat MVP1 token-index extraction into a flattened atom list; owner/lane: Mgr-RUNTIME
// (neat-bat-593) — trigger: structured fn-body normalize output lands; forbidden: permanent
// untagged index-walk bridge helpers in body_producer.
fn mvp1_flat_atom_at(
  atoms: List<Node>,
  wanted: Int,
  reason: Symbol,
  witness: Node
) -> Outcome<Node> {
  match list_at_optional(xs: atoms, index: wanted) {
    Present { value: child } => outcome_accepted(value: child)
    Absent =>
      outcome_rejected(
        d: body_producer_diagnostic(reason: reason, n: witness)
      )
  }
}

fn mvp1_sequence_flatten_atoms(root: Node) -> Outcome<List<Node>> {
  match root.kind {
    TypeNode { connective: Atom { identity: _ } } =>
      outcome_accepted(value: [root])
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: find_named_child(root: root, name: ^grammar_sequence_left_node_projection),
        f: fn(left) {
          bind_outcome(
            o: find_named_child(root: root, name: ^grammar_sequence_right_node_projection),
            f: fn(right) {
              bind_outcome(
                o: mvp1_sequence_flatten_atoms(root: left),
                f: fn(left_atoms) {
                  bind_outcome(
                    o: mvp1_sequence_flatten_atoms(root: right),
                    f: fn(right_atoms) {
                      outcome_accepted(
                        value: list_append(left: left_atoms, right: right_atoms)
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(
        d: body_producer_diagnostic(
          reason: body_producer_reason_mvp1_resolved_shape,
          n: root
        )
      )
  }
}

fn mvp1_resolved_captured_atoms(resolved_root: Node) -> Outcome<List<Node>> {
  bind_outcome(
    o: find_named_child(
      root: resolved_root,
      name: ^grammar_production_captured_node_projection
    ),
    f: fn(captured) {
      mvp1_sequence_flatten_atoms(root: captured)
    }
  )
}

// 🟡 gated — COMPREP wave-1 hard-coded bridge scaffold (docs/modeling-discipline.md
// Practice 10 / INVARIANTS P5) — feature:COMPREP-WAVE1-BODY-BRIDGE —
// consumer:produce_mvp1_add_arrow_with_body_from_resolved (executed by comprep_eval_by_execution
// keystone) — bind:node://adhoc-9a72d4fb-8c2 — dissolve-on: signature+body production derives
// from the resolved Arrow's declared signature+body carriers (real body_producer dispatch)
// rather than recognizing the fixed MVP1 flat-token indices 5/9/12/14/15/16; owner/lane:
// Mgr-RUNTIME (neat-bat-593) — trigger: structured fn-body normalize output lands; forbidden:
// adding a third hard-coded flat-index shape here (wave-2 M0-B1 pick indices 8/10/12 is the
// reviewed second shape — see COMPREP-WAVE2-BODY-BRIDGE marks below; a third would mean
// building the dispatch surface, not another literal index table).
fn produce_mvp1_add_arrow_signature_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
    f: fn(atoms) {
      bind_outcome(
        o: mvp1_flat_atom_at(
          atoms: atoms,
          wanted: 5,
          reason: body_producer_reason_mvp1_resolved_shape,
          witness: resolved_root
        ),
        f: fn(domain_x) {
          bind_outcome(
            o: mvp1_flat_atom_at(
              atoms: atoms,
              wanted: 9,
              reason: body_producer_reason_mvp1_resolved_shape,
              witness: resolved_root
            ),
            f: fn(domain_y) {
              bind_outcome(
                o: mvp1_flat_atom_at(
                  atoms: atoms,
                  wanted: 12,
                  reason: body_producer_reason_mvp1_resolved_shape,
                  witness: resolved_root
                ),
                f: fn(codomain) {
                  bind_outcome(
                    o: dag_mvp1_captured_flat_atom_binding_for_ident(
                      flat_index: 5,
                      ident_atom: domain_x
                    ),
                    f: fn(left_binding) {
                      bind_outcome(
                        o: dag_mvp1_captured_flat_atom_binding_for_ident(
                          flat_index: 9,
                          ident_atom: domain_y
                        ),
                        f: fn(right_binding) {
                          bind_outcome(
                            o: dag_mvp1_captured_flat_atom_binding_for_ident(
                              flat_index: 12,
                              ident_atom: codomain
                            ),
                            f: fn(codomain_binding) {
                              bind_outcome(
                                o: body_producer_arrow_domain_conj_from_binding_ids(
                                  bindings: [left_binding, right_binding]
                                ),
                                f: fn(domain) {
                                  outcome_accepted(
                                    value: node_synthetic(
                                      kind: TypeNode { connective: Arrow },
                                      children: [
                                        Edge {
                                          label: Positional,
                                          target: domain
                                        },
                                        Edge {
                                          label: Positional,
                                          target: type_atom_node(identity: codomain_binding)
                                        },
                                        Edge {
                                          label: Positional,
                                          target: type_atom_node(identity: codomain_binding)
                                        }
                                      ]
                                    )
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_add_arrow_with_body_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: produce_mvp1_add_arrow_signature_from_resolved(resolved_root: resolved_root),
    f: fn(signature) {
      bind_outcome(
        o: arrow_domain_named_param_bindings(arrow: signature),
        f: fn(param_bindings) {
          bind_outcome(
            o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
            f: fn(atoms) {
              bind_outcome(
                o: mvp1_flat_atom_at(
                  atoms: atoms,
                  wanted: 15,
                  reason: body_producer_reason_mvp1_resolved_shape,
                  witness: resolved_root
                ),
                f: fn(operator) {
                  bind_outcome(
                    o: body_producer_transform_body_from_bindings(
                      operator: operator,
                      param_bindings: param_bindings
                    ),
                    f: fn(body) {
                      bind_outcome(
                        o: attach_arrow_body(arrow: signature, body: body),
                        f: fn(arrow_with_body) {
                          if well_formed(n: arrow_with_body) {
                            outcome_accepted(value: arrow_with_body)
                          } else {
                            outcome_rejected(
                              d: body_producer_diagnostic(
                                reason: body_producer_reason_post_produce_not_well_formed,
                                n: arrow_with_body
                              )
                            )
                          }
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_add_arrow_with_body() -> Outcome<Node> {
  let signature = dag_mvp1_add_arrow_signature_node()
  bind_outcome(
    o: arrow_domain_named_param_bindings(arrow: signature),
    f: fn(param_bindings) {
      bind_outcome(
        o: body_producer_transform_body_from_bindings(
          operator: dag_mvp1_add_operator_node(),
          param_bindings: param_bindings
        ),
        f: fn(body) {
          bind_outcome(
            o: attach_arrow_body(arrow: signature, body: body),
            f: fn(arrow_with_body) {
              if well_formed(n: arrow_with_body) {
                outcome_accepted(value: arrow_with_body)
              } else {
                outcome_rejected(
                  d: body_producer_diagnostic(
                    reason: body_producer_reason_post_produce_not_well_formed,
                    n: arrow_with_body
                  )
                )
              }
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_add_arrow_with_body_swapped_operands() -> Outcome<Node> {
  if well_formed(n: dag_mvp1_add_arrow_with_body_swapped_operands_fixture) {
    outcome_accepted(value: dag_mvp1_add_arrow_with_body_swapped_operands_fixture)
  } else {
    outcome_rejected(
      d: body_producer_diagnostic(
        reason: body_producer_reason_post_produce_not_well_formed,
        n: dag_mvp1_add_arrow_with_body_swapped_operands_fixture
      )
    )
  }
}

fn produce_mvp1_add_decl_node(fn_name: Symbol) -> Outcome<Node> {
  bind_outcome(
    o: produce_mvp1_add_arrow_with_body(),
    f: fn(arrow_with_body) {
      outcome_accepted(
        value: node_synthetic(
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Named { name: fn_name },
              target: arrow_with_body
            }
          ]
        )
      )
    }
  )
}

fn arrow_has_body_edge(arrow: Node) -> Bool {
  match find_arrow_body_child(root: arrow) {
    Accepted { value: body, diagnostics: _ } =>
      match body.kind {
        ComputationNode { behavior: _ } => true
        _ => false
      }
    Rejected { diagnostics: _ } => false
  }
}

fn body_producer_branch_if_body(
  condition: Node,
  then_arm: Node,
  else_arm: Node
) -> Outcome<Node> {
  outcome_accepted(
    value: node_synthetic(
      kind: ComputationNode { behavior: Branch },
      children: [
        Edge { label: Positional, target: condition },
        Edge { label: Positional, target: then_arm },
        Edge { label: Positional, target: else_arm }
      ]
    )
  )
}

fn body_producer_pick_condition_from_atom(cond: Node) -> Outcome<Node> {
  if dag_mvp1_node_is_kw_true_atom(node: cond) {
    outcome_accepted(value: type_atom_node(identity: body_producer_pick_kw_true))
  } else if dag_mvp1_node_is_kw_false_atom(node: cond) {
    outcome_accepted(value: type_atom_node(identity: body_producer_pick_kw_false))
  } else {
    outcome_rejected(
      d: body_producer_diagnostic(
        reason: body_producer_reason_mvp1_resolved_shape,
        n: cond
      )
    )
  }
}

// 🟡 gated — COMPREP wave-2 hard-coded bridge scaffold (docs/modeling-discipline.md
// Practice 10 / INVARIANTS P5) — feature:COMPREP-WAVE2-BODY-BRIDGE —
// consumer:body_producer_pick_if_body_from_atoms (via produce_mvp1_pick_if_arrow_with_body_from_resolved;
// executed by comprep_branch_eval_by_execution keystone) — bind:node://adhoc-9a72d4fb-8c2 —
// dissolve-on: if-then-else body production derives from structured normalize/resolve Behavior
// carriers (Branch child projection) rather than fixed MVP1 flat-token indices 8/10/12;
// owner/lane: Mgr-§2 (sharp-ibex-851) — trigger: structured fn-body normalize output lands;
// forbidden: permanent untagged pick flat-index bridge helpers in body_producer.
fn body_producer_pick_if_body_from_atoms(
  atoms: List<Node>,
  witness: Node
) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_flat_atom_at(
      atoms: atoms,
      wanted: 8,
      reason: body_producer_reason_mvp1_resolved_shape,
      witness: witness
    ),
    f: fn(cond) {
      bind_outcome(
        o: mvp1_flat_atom_at(
          atoms: atoms,
          wanted: 10,
          reason: body_producer_reason_mvp1_resolved_shape,
          witness: witness
        ),
        f: fn(then_arm) {
          bind_outcome(
            o: mvp1_flat_atom_at(
              atoms: atoms,
              wanted: 12,
              reason: body_producer_reason_mvp1_resolved_shape,
              witness: witness
            ),
            f: fn(else_arm) {
              if dag_mvp1_node_is_int_literal_atom(node: then_arm)
                && dag_mvp1_node_is_int_literal_atom(node: else_arm) {
                bind_outcome(
                  o: body_producer_pick_condition_from_atom(cond: cond),
                  f: fn(condition) {
                    body_producer_branch_if_body(
                      condition: condition,
                      then_arm: type_atom_node(identity: body_producer_pick_lit_one),
                      else_arm: type_atom_node(identity: body_producer_pick_lit_two)
                    )
                  }
                )
              } else {
                outcome_rejected(
                  d: body_producer_diagnostic(
                    reason: body_producer_reason_mvp1_resolved_shape,
                    n: witness
                  )
                )
              }
            }
          )
        }
      )
    }
  )
}

// 🟡 gated — COMPREP wave-2 hard-coded bridge scaffold (docs/modeling-discipline.md
// Practice 10 / INVARIANTS P5) — feature:COMPREP-WAVE2-BODY-BRIDGE —
// consumer:produce_mvp1_pick_if_arrow_signature_from_resolved (via
// produce_mvp1_pick_if_arrow_with_body_from_resolved; executed by comprep_branch_eval_by_execution
// keystone) — bind:node://adhoc-9a72d4fb-8c2 — dissolve-on: zero-param arrow signature derives
// from resolved Arrow carriers rather than flat-token index 5 + pick binding table;
// owner/lane: Mgr-§2 (sharp-ibex-851) — trigger: structured fn-body normalize output lands;
// forbidden: permanent untagged pick signature flat-index bridge in body_producer.
fn produce_mvp1_pick_if_arrow_signature_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
    f: fn(atoms) {
      bind_outcome(
        o: mvp1_flat_atom_at(
          atoms: atoms,
          wanted: 5,
          reason: body_producer_reason_mvp1_resolved_shape,
          witness: resolved_root
        ),
        f: fn(codomain) {
          bind_outcome(
            o: dag_mvp1_pick_captured_flat_atom_binding_for_ident(
              flat_index: 5,
              ident_atom: codomain
            ),
            f: fn(codomain_binding) {
              outcome_accepted(
                value: node_synthetic(
                  kind: TypeNode { connective: Arrow },
                  children: [
                    Edge {
                      label: Positional,
                      target: node_synthetic(
                        kind: TypeNode { connective: Conj },
                        children: []
                      )
                    },
                    Edge {
                      label: Positional,
                      target: type_atom_node(identity: codomain_binding)
                    },
                    Edge {
                      label: Positional,
                      target: type_atom_node(identity: codomain_binding)
                    }
                  ]
                )
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_pick_if_arrow_with_body_from_resolved(resolved_root: Node) -> Outcome<Node> {
  bind_outcome(
    o: produce_mvp1_pick_if_arrow_signature_from_resolved(resolved_root: resolved_root),
    f: fn(signature) {
      bind_outcome(
        o: mvp1_resolved_captured_atoms(resolved_root: resolved_root),
        f: fn(atoms) {
          bind_outcome(
            o: body_producer_pick_if_body_from_atoms(atoms: atoms, witness: resolved_root),
            f: fn(body) {
              bind_outcome(
                o: attach_arrow_body(arrow: signature, body: body),
                f: fn(arrow_with_body) {
                  if well_formed(n: arrow_with_body) {
                    outcome_accepted(value: arrow_with_body)
                  } else {
                    outcome_rejected(
                      d: body_producer_diagnostic(
                        reason: body_producer_reason_post_produce_not_well_formed,
                        n: arrow_with_body
                      )
                    )
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}

fn produce_mvp1_pick_if_arrow_with_body() -> Outcome<Node> {
  if well_formed(n: dag_mvp1_pick_arrow_with_body_fixture) {
    outcome_accepted(value: dag_mvp1_pick_arrow_with_body_fixture)
  } else {
    outcome_rejected(
      d: body_producer_diagnostic(
        reason: body_producer_reason_post_produce_not_well_formed,
        n: dag_mvp1_pick_arrow_with_body_fixture
      )
    )
  }
}

fn produce_mvp1_pick_if_arrow_with_body_swapped_arms() -> Outcome<Node> {
  if well_formed(n: dag_mvp1_pick_arrow_with_body_swapped_arms_fixture) {
    outcome_accepted(value: dag_mvp1_pick_arrow_with_body_swapped_arms_fixture)
  } else {
    outcome_rejected(
      d: body_producer_diagnostic(
        reason: body_producer_reason_post_produce_not_well_formed,
        n: dag_mvp1_pick_arrow_with_body_swapped_arms_fixture
      )
    )
  }
}
