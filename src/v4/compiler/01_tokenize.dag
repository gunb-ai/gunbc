// src/v4/compiler/01_tokenize.dag
// Scope: generic tokenization over language lex rules.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis
// Owns: LexCharClass, LexPattern, LexRule, LexRuleSet, LexRules, Token, TokenStream,
//       tokenize_lex_e0_source_not_exhausted, tokenize_lex_e0_source_not_exhausted_diagnostic,
//       tokenize_lex_e1_unrecognized_char, tokenize_lex_e1_unrecognized_char_diagnostic,
//       char_in_class, LexMatchResult, LexRuleApply,
//       lex_string_fuel, lex_match_prefix, lex_match_pattern, lex_repeat_pattern,
//       lex_rule_pattern, lex_try_rule, lex_try_rules, lex_walk,
//       lex_rule_token_class_member, lex_rule_set_token_class_member, tokenize.
// Consumes: std collection, std diagnostic, std node, std text, std nat, std algebra.
// Status: T-6 lexer walk realized.


module v4.compiler.tokenize


import v4.std.collection { List }
import v4.std.diagnostic { Accepted, ByteRange, Diagnostic, ExternalContractUnknown, Locus, None, Outcome, Textual, Unavailable, UserInputBoundary, WholeFile, diagnostics_singleton }
import v4.std.node { Symbol }
import v4.std.algebra { Cons, Empty, fold_list, is_empty, is_prefix_of, length, list_append, list_skip, list_snoc_item }
import v4.std.text { Char, CharAbsent, CharFound, String, string_head, string_is_empty, string_tail }
import v4.std.nat { Nat, Zero, Succ, nat_lte, nat_gte }
import v4.std.logic { Bool }

// 🟡 coproduct dissolution — CP-1b item 13a; lexical data is modeled, per-arm lexer morphism witness remains gated.
type LexCharClass
  = WhitespaceChar
  | DigitChar
  | HexDigitChar
  | IdentStartChar
  | IdentContinueChar
  | StringTextChar
  | LineCommentTextChar
  | BlockCommentTextChar


// 🟡 coproduct dissolution — CP-1b item 13b; declarative parse/emit pattern data is modeled, bidirectional grammar carrier convergence remains gated.
type LexPattern
  = EmptyPattern
  | LiteralPattern { text: String }
  | KeywordPattern { text: String }
  | CharPattern { char: Char }
  | CharClassPattern { class: LexCharClass }
  | SequencePattern { left: LexPattern, right: LexPattern }
  | ChoicePattern { left: LexPattern, right: LexPattern }
  | OptionalPattern { element: LexPattern }
  | RepeatPattern { element: LexPattern }
  | OneOrMorePattern { element: LexPattern }
  | DelimitedPattern { open: LexPattern, body: LexPattern, close: LexPattern }


// 🟡 coproduct dissolution — CP-1b item 13c; token/trivia rule data is modeled, per-arm lexer morphism witness remains gated.
type LexRule
  = TokenRule { token_class: Symbol, pattern: LexPattern }
  | TriviaRule { pattern: LexPattern }


type LexRuleSet {
  rules: List<LexRule>
}


// 🟡 coproduct dissolution — CP-1b item 13d; modeled rule data is present, generic lexical walk realized.
type LexRules
  = VoidLexRules
  | ModeledLexRules { root: LexRuleSet }


type Token {
  class: Symbol
  lexeme: String
  file: Symbol
  start: Int
  end: Int
}
type TokenStream {
  tokens: List<Token>
}

// 🟡 coproduct dissolution — CP-1b item 13e; per-pattern match result; dissolves when LexPattern converges with GrammarExpr on single bidirectional grammar carrier.
type LexMatchResult
  = LexMatchAccepted { remaining: String, lexeme: String }
  | LexMatchRejected

// 🟡 coproduct dissolution — CP-1b item 13f; per-rule application result; dissolves with LexPattern carrier convergence.
type LexRuleApply
  = LexRuleNoMatch
  | LexRuleToken { class: Symbol, lexeme: String, remaining: String }
  | LexRuleTrivia { lexeme: String, remaining: String }

data tokenize_lex_e0_source_not_exhausted: Symbol = tokenize_lex_e0_source_not_exhausted
data tokenize_lex_e1_unrecognized_char: Symbol = tokenize_lex_e1_unrecognized_char


fn lex_rule_token_class_member(rule: LexRule, token_class: Symbol) -> Bool {
  match rule {
    TokenRule { token_class: c, pattern: _ } => c == token_class
    TriviaRule { pattern: _ } => false
  }
}


fn lex_rule_set_token_class_member(rules: LexRuleSet, token_class: Symbol) -> Bool {
  fold_list(
    xs: rules.rules,
    empty: false,
    cons: fn(acc, rule) {
      acc || lex_rule_token_class_member(rule: rule, token_class: token_class)
    }
  )
}


fn tokenize_lex_e0_source_not_exhausted_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_e0_source_not_exhausted,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn tokenize_lex_e1_unrecognized_char_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_e1_unrecognized_char,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived LexCharClass membership predicate (per-variant character range projection dissolves per-arm nat-range inline); forbidden: per-arm expansion laundering.
fn char_in_class(c: Char, class: LexCharClass) -> Bool {
  match class {
    WhitespaceChar =>
      c == 32 || c == 9 || c == 10 || c == 13
    DigitChar =>
      nat_gte(a: c, b: 48) && nat_lte(a: c, b: 57)
    HexDigitChar =>
      (nat_gte(a: c, b: 48) && nat_lte(a: c, b: 57)) ||
      (nat_gte(a: c, b: 65) && nat_lte(a: c, b: 70)) ||
      (nat_gte(a: c, b: 97) && nat_lte(a: c, b: 102))
    IdentStartChar =>
      (nat_gte(a: c, b: 65) && nat_lte(a: c, b: 90)) ||
      (nat_gte(a: c, b: 97) && nat_lte(a: c, b: 122)) ||
      c == 95
    IdentContinueChar =>
      (nat_gte(a: c, b: 65) && nat_lte(a: c, b: 90)) ||
      (nat_gte(a: c, b: 97) && nat_lte(a: c, b: 122)) ||
      c == 95 ||
      (nat_gte(a: c, b: 48) && nat_lte(a: c, b: 57))
    StringTextChar =>
      c != 34 && c != 10
    LineCommentTextChar =>
      c != 10
    BlockCommentTextChar =>
      c != 42
  }
}


// lex_match_prefix: match a literal string prefix against source.
// Uses is_prefix_of (stdlib terminal) to avoid direct structural recursion on FreeMonoid.
fn lex_match_prefix(prefix: String, source: String) -> LexMatchResult {
  if is_prefix_of(prefix: prefix, xs: source, eq: fn(a, b) { a == b }) {
    LexMatchAccepted { remaining: list_skip(xs: source, n: length(xs: prefix)), lexeme: prefix }
  } else {
    LexMatchRejected
  }
}


// Fuel for pattern-matching recursion: converts source length to Nat so the
// complexity analyzer can witness structural descent in lex_repeat_pattern.
fn lex_string_fuel(source: String) -> Nat {
  fold_list(xs: source, empty: Zero, cons: fn(acc, _) { Succ { prev: acc } })
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: LexPattern repeat combinator substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived greedy-repeat morphism over LexPattern's RepeatPattern variant, eliminating the hand-rolled zero-width halt guard; forbidden: inlining repeat semantics into the pattern match arms of lex_match_pattern.
// lex_repeat_pattern: greedy zero-or-more match of element against source.
// Termination: zero-width matches (empty consumed) halt immediately; otherwise
// each iteration strictly reduces source length (fuel: Succ { prev: rest } → rest descent).
fn lex_repeat_pattern(pattern: LexPattern, source: String, fuel: Nat, acc_lexeme: String) -> LexMatchResult {
  match fuel {
    Zero => LexMatchAccepted { remaining: source, lexeme: acc_lexeme }
    Succ { prev: rest_fuel } =>
      match lex_match_pattern(pattern: pattern, source: source, fuel: rest_fuel) {
        LexMatchRejected =>
          LexMatchAccepted { remaining: source, lexeme: acc_lexeme }
        LexMatchAccepted { remaining: rest, lexeme: consumed } =>
          match string_is_empty(s: consumed) {
            true => LexMatchAccepted { remaining: source, lexeme: acc_lexeme }
            false =>
              lex_repeat_pattern(
                pattern: pattern,
                source: rest,
                fuel: rest_fuel,
                acc_lexeme: list_append(left: acc_lexeme, right: consumed)
              )
          }
      }
  }
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: LexPattern structural morphism substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived pattern-matching morphism over LexPattern coproduct (per-variant fold eliminating hand-written match arms); forbidden: adding new match arms outside the substrate derivation path.
fn lex_match_pattern(pattern: LexPattern, source: String, fuel: Nat) -> LexMatchResult {
  match pattern {
    EmptyPattern =>
      LexMatchAccepted { remaining: source, lexeme: Empty }
    LiteralPattern { text: text } =>
      lex_match_prefix(prefix: text, source: source)
    KeywordPattern { text: text } =>
      match lex_match_prefix(prefix: text, source: source) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: rest, lexeme: lex } =>
          match string_is_empty(s: rest) {
            true => LexMatchAccepted { remaining: rest, lexeme: lex }
            false =>
              match string_head(s: rest) {
                CharAbsent => LexMatchAccepted { remaining: rest, lexeme: lex }
                CharFound { value: c } =>
                  match char_in_class(c: c, class: IdentContinueChar) {
                    true => LexMatchRejected
                    false => LexMatchAccepted { remaining: rest, lexeme: lex }
                  }
              }
          }
      }
    CharPattern { char: expected } =>
      match string_is_empty(s: source) {
        true => LexMatchRejected
        false =>
          match string_head(s: source) {
            CharAbsent => LexMatchRejected
            CharFound { value: c } =>
              match c == expected {
                true =>
                  LexMatchAccepted {
                    remaining: string_tail(s: source),
                    lexeme: Cons { head: c, tail: Empty }
                  }
                false => LexMatchRejected
              }
          }
      }
    CharClassPattern { class: class } =>
      match string_is_empty(s: source) {
        true => LexMatchRejected
        false =>
          match string_head(s: source) {
            CharAbsent => LexMatchRejected
            CharFound { value: c } =>
              match char_in_class(c: c, class: class) {
                true =>
                  LexMatchAccepted {
                    remaining: string_tail(s: source),
                    lexeme: Cons { head: c, tail: Empty }
                  }
                false => LexMatchRejected
              }
          }
      }
    SequencePattern { left: left, right: right } =>
      match lex_match_pattern(pattern: left, source: source, fuel: fuel) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: rest1, lexeme: lex1 } =>
          match lex_match_pattern(pattern: right, source: rest1, fuel: fuel) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest2, lexeme: lex2 } =>
              LexMatchAccepted { remaining: rest2, lexeme: list_append(left: lex1, right: lex2) }
          }
      }
    ChoicePattern { left: left, right: right } =>
      match lex_match_pattern(pattern: left, source: source, fuel: fuel) {
        LexMatchAccepted { remaining: rest, lexeme: lex } =>
          LexMatchAccepted { remaining: rest, lexeme: lex }
        LexMatchRejected =>
          lex_match_pattern(pattern: right, source: source, fuel: fuel)
      }
    OptionalPattern { element: element } =>
      match lex_match_pattern(pattern: element, source: source, fuel: fuel) {
        LexMatchAccepted { remaining: rest, lexeme: lex } =>
          LexMatchAccepted { remaining: rest, lexeme: lex }
        LexMatchRejected =>
          LexMatchAccepted { remaining: source, lexeme: Empty }
      }
    RepeatPattern { element: element } =>
      match fuel {
        Zero => LexMatchAccepted { remaining: source, lexeme: Empty }
        Succ { prev: rest_fuel } =>
          lex_repeat_pattern(pattern: element, source: source, fuel: rest_fuel, acc_lexeme: Empty)
      }
    OneOrMorePattern { element: element } =>
      match fuel {
        Zero => LexMatchRejected
        Succ { prev: rest_fuel } =>
          match lex_match_pattern(pattern: element, source: source, fuel: rest_fuel) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest, lexeme: lex } =>
              lex_repeat_pattern(pattern: element, source: rest, fuel: rest_fuel, acc_lexeme: lex)
          }
      }
    DelimitedPattern { open: open, body: body, close: close } =>
      match fuel {
        Zero => LexMatchRejected
        Succ { prev: rest_fuel } =>
          match lex_match_pattern(pattern: open, source: source, fuel: rest_fuel) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: after_open, lexeme: open_lex } =>
              match lex_match_pattern(pattern: body, source: after_open, fuel: rest_fuel) {
                LexMatchRejected => LexMatchRejected
                LexMatchAccepted { remaining: after_body, lexeme: body_lex } =>
                  match lex_match_pattern(pattern: close, source: after_body, fuel: rest_fuel) {
                    LexMatchRejected => LexMatchRejected
                    LexMatchAccepted { remaining: after_close, lexeme: close_lex } =>
                      LexMatchAccepted {
                        remaining: after_close,
                        lexeme: list_append(left: open_lex, right: list_append(left: body_lex, right: close_lex))
                      }
                  }
              }
          }
      }
  }
}


fn lex_rule_pattern(rule: LexRule) -> LexPattern {
  match rule {
    TokenRule { token_class: _, pattern: p } => p
    TriviaRule { pattern: p } => p
  }
}


fn lex_try_rule(rule: LexRule, source: String, fuel: Nat) -> LexRuleApply {
  match lex_match_pattern(pattern: lex_rule_pattern(rule: rule), source: source, fuel: fuel) {
    LexMatchRejected => LexRuleNoMatch
    LexMatchAccepted { remaining: remaining, lexeme: lexeme } =>
      match rule {
        TokenRule { token_class: class, pattern: _ } =>
          LexRuleToken { class: class, lexeme: lexeme, remaining: remaining }
        TriviaRule { pattern: _ } =>
          LexRuleTrivia { lexeme: lexeme, remaining: remaining }
      }
  }
}


fn lex_try_rules(rules: List<LexRule>, source: String, fuel: Nat) -> LexRuleApply {
  fold_list(
    xs: rules,
    empty: LexRuleNoMatch,
    cons: fn(acc, rule) {
      match acc {
        LexRuleNoMatch => lex_try_rule(rule: rule, source: source, fuel: fuel)
        LexRuleToken { class: class, lexeme: lexeme, remaining: remaining } =>
          LexRuleToken { class: class, lexeme: lexeme, remaining: remaining }
        LexRuleTrivia { lexeme: lexeme, remaining: remaining } =>
          LexRuleTrivia { lexeme: lexeme, remaining: remaining }
      }
    }
  )
}


// lex_walk: scan source left-to-right; emit tokens, discard trivia, error on E1.
// Termination: walk_fuel is initialized to source length; each non-error iteration
// consumes at least one character, so walk_fuel descends (Succ { prev: rest } → rest).
fn lex_walk(
  source: String,
  tokens: List<Token>,
  file: Symbol,
  pos: Int,
  rules: LexRuleSet,
  walk_fuel: Nat
) -> Outcome<TokenStream> {
  match string_is_empty(s: source) {
    true =>
      Accepted { value: TokenStream { tokens: tokens }, diagnostics: None }
    false =>
      match walk_fuel {
        Zero =>
          let at = Textual { file: file, extent: ByteRange { start: pos, end: pos } }
          Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e1_unrecognized_char_diagnostic(at: at)) }
        Succ { prev: rest_walk } =>
          let at = Textual { file: file, extent: ByteRange { start: pos, end: pos } }
          match lex_try_rules(rules: rules.rules, source: source, fuel: lex_string_fuel(source: source)) {
            LexRuleNoMatch =>
              Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e1_unrecognized_char_diagnostic(at: at)) }
            LexRuleTrivia { lexeme: lexeme, remaining: remaining } =>
              match string_is_empty(s: lexeme) {
                true =>
                  Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e1_unrecognized_char_diagnostic(at: at)) }
                false =>
                  lex_walk(source: remaining, tokens: tokens, file: file, pos: pos + length(xs: lexeme), rules: rules, walk_fuel: rest_walk)
              }
            LexRuleToken { class: class, lexeme: lexeme, remaining: remaining } =>
              match string_is_empty(s: lexeme) {
                true =>
                  Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e1_unrecognized_char_diagnostic(at: at)) }
                false =>
                  lex_walk(
                    source: remaining,
                    tokens: list_snoc_item(
                      xs: tokens,
                      item: Token { class: class, lexeme: lexeme, file: file, start: pos, end: pos + length(xs: lexeme) }
                    ),
                    file: file,
                    pos: pos + length(xs: lexeme),
                    rules: rules,
                    walk_fuel: rest_walk
                  )
              }
          }
      }
  }
}


fn tokenize(text: String, file: Symbol, rules: LexRules) -> Outcome<TokenStream> {
  let at = Textual {
    file: file,
    extent: WholeFile
  }
  match rules {
    VoidLexRules =>
      if is_empty(xs: text) {
        Accepted { value: TokenStream { tokens: [] }, diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e0_source_not_exhausted_diagnostic(at: at)) }
      }
    ModeledLexRules { root: rule_set } =>
      lex_walk(source: text, tokens: [], file: file, pos: 0, rules: rule_set, walk_fuel: lex_string_fuel(source: text))
  }
}
