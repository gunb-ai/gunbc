// src/v4/compiler/01_tokenize.dag
//
// Scope: pipeline stage 1 — Source string to TokenStream. Pure function.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis
//
// B2-OMNI (operator-ratified 2026-05-15): tokenize is the first half of
// the GENERIC ingest walker (with 02_parse), driven by a `LanguageModel`'s
// declarative lexical rules — NOT .dag-specific. `.dag` is language #1.
// A .dag-only character class hardcoded here reintroduces the N×M trap =
// STOP. See 00_compile.dag B2-OMNI for the pivot.
//
// Wave-1 **encoding contract** (grammar-as-data over `Node`, not prose):
//   **E0 — void lexical fragment**: `LexRules` root is a **type** `Node`
//   whose connective is **`Conj` with zero children** — exactly zero
//   lexical productions. The walker recognizes this shape **structurally**
//   (discriminant + `count(children)==0`), never by `Symbol` spelling.
//   E0 + empty `String` (`FreeMonoid` spine `Empty`) ⇒ `Produced` empty
//   `TokenStream`. E0 + non-empty source ⇒ `Rejected` (source not exhausted
//   — fail-closed; no fabricated tokens).
//   Further encodings (E1+, keywords, …) land as additional **data**
//   shapes ratified with the LanguageModel carrier; the walker grows by
//   `match` on those shapes, not by hardcoding `.dag` surface spellings.
//
// Owns:
//   - Token, TokenStream carriers
//   - LexRules — declarative lexical authority as a finite `Node` tree
//   - tokenize: (String, file: Symbol, LexRules) -> Outcome<TokenStream>
//
// Consumes:
//   - std/text.dag: String (= FreeMonoid<Char>)
//   - std/node.dag: Node, NodeKind, TypeNode, ComputationNode, Conj,
//     Symbol, node_well_formed
//   - std/collection.dag: List<T>
//   - std/diagnostic.dag: Diagnostic, Outcome, Locus, Textual, WholeFile,
//     Correction, NoCorrectionReason
//   - extdeps/languages/dag.dag: language-#1 model binds E0 instances (see
//     `dag_wave1_e0_void_lex`); this file stays encoding-generic.
//
// Status: Wave-1 — E0 void-lex path is **realized** (`Produced`); richer
// encodings ⇒ honest `Rejected { … walk_not_realized }` until ratified.
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.compiler.tokenize


import v4.std.collection { List }
import v4.std.diagnostic {
  Correction,
  Diagnostic,
  Locus,
  NoCorrectionReason,
  Outcome,
  Textual,
  WholeFile,
}
import v4.std.algebra { FreeMonoid }
import v4.std.node {
  ComputationNode,
  Conj,
  Node,
  NodeKind,
  Symbol,
  TypeNode,
  node_well_formed,
}
import v4.std.text { Char, String }


// ─────────────────────────────────────────────────────────────────────
// LexRules — declarative lexical specification as a finite `Node` tree
// (B2-OMNI grammar-as-data).
type LexRules = Node


// ─────────────────────────────────────────────────────────────────────
// Token — one classified lexeme in source order.
type Token {
  class: Symbol
  lexeme: String
  file: Symbol
  start: Int
  end: Int
}


// ─────────────────────────────────────────────────────────────────────
// TokenStream — ordered output of stage 1.
type TokenStream {
  tokens: List<Token>
}


// ─────────────────────────────────────────────────────────────────────
// Reason symbols — owned by this dimension (diagnostic.dag owns schema).
data tokenize_lexical_walk_not_realized: Symbol = tokenize_lexical_walk_not_realized

data tokenize_lex_rules_not_well_formed: Symbol = tokenize_lex_rules_not_well_formed

data tokenize_lex_e0_source_not_exhausted: Symbol = tokenize_lex_e0_source_not_exhausted


fn tokenize_lexical_walk_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lexical_walk_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn tokenize_lex_rules_not_well_formed_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_rules_not_well_formed,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn tokenize_lex_e0_source_not_exhausted_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_e0_source_not_exhausted,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// ─────────────────────────────────────────────────────────────────────
// free_monoid_char_len — walk the `FreeMonoid<Char>` spine (`String` alias).
fn free_monoid_char_len(xs: FreeMonoid<Char>) -> Int {
  match xs {
    Empty => 0
    Cons { head: _, tail: t } => 1 + free_monoid_char_len(xs: t)
  }
}


// ─────────────────────────────────────────────────────────────────────
// string_is_empty — `String` = `FreeMonoid<Char>` (std/text.dag).
fn string_is_empty(s: String) -> Bool {
  free_monoid_char_len(xs: s) == 0
}


// ─────────────────────────────────────────────────────────────────────
// lex_rules_node_is_conj_empty_root — structural E0 predicate (Wave-1).
fn lex_rules_node_is_conj_empty_root(rules: Node) -> Bool {
  match rules.kind {
    TypeNode { connective: Conj } => count(rules.children) == 0
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}


// ─────────────────────────────────────────────────────────────────────
// tokenize — GENERIC lexical ingest (B2-OMNI).
//
// Discriminates on **declared** `LexRules` shape; only E0 is realized in
// Wave-1. No `file` or `text` content branches on language identity.
fn tokenize(text: String, file: Symbol, rules: LexRules) -> Outcome<TokenStream> {
  let at = Textual {
    file: file,
    extent: WholeFile
  }
  if !node_well_formed(n: rules) {
    Rejected {
      diagnostic: tokenize_lex_rules_not_well_formed_diagnostic(at: at)
    }
  } else if lex_rules_node_is_conj_empty_root(rules: rules) {
    if string_is_empty(s: text) {
      Produced {
        value: TokenStream {
          tokens: []
        }
      }
    } else {
      Rejected {
        diagnostic: tokenize_lex_e0_source_not_exhausted_diagnostic(at: at)
      }
    }
  } else {
    Rejected {
      diagnostic: tokenize_lexical_walk_not_realized_diagnostic(at: at)
    }
  }
}
