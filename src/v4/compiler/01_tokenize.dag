module v4.compiler.tokenize


import v4.std.collection { List }
import v4.std.diagnostic { Accepted, ByteRange, Diagnostic, ExternalContractUnknown, Locus, None, Outcome, Textual, Unavailable, UserInputBoundary, WholeFile, diagnostics_singleton }
import v4.std.node { Symbol }
import v4.std.algebra { Cons, Empty, ListTailResult, TailAbsent, TailFound, fold_list, is_empty, is_prefix_of, length, list_append, list_snoc_item, list_tail }
import v4.std.text { CharAbsent, CharFound, String, string_head, string_is_empty, string_tail }
import v4.std.nat { Nat, nat_lte, nat_gte }
import v4.std.logic { Bool }
import v4.std.lexing {
  BlockCommentTextChar,
  CharClassPattern,
  CharPattern,
  ChoicePattern,
  DelimitedPattern,
  DigitChar,
  EmptyPattern,
  HexDigitChar,
  IdentContinueChar,
  IdentStartChar,
  KeywordPattern,
  LexCharClass,
  LexPattern,
  LexRule,
  LexRuleSet,
  LexRules,
  LineCommentTextChar,
  LiteralPattern,
  ModeledLexRules,
  OneOrMorePattern,
  OptionalPattern,
  RepeatPattern,
  SequencePattern,
  StringTextChar,
  Token,
  TokenRule,
  TokenStream,
  TriviaRule,
  VoidLexRules,
  WhitespaceChar
}

// 🟡 coproduct dissolution — CP-1b item 13e; per-pattern match result; dissolves when LexPattern converges with GrammarExpr on single bidirectional grammar carrier.
type LexMatchResult
  = LexMatchAccepted { remaining: String, lexeme: String }
  | LexMatchRejected

// 🟡 coproduct dissolution — CP-1b item 13f; per-rule application result; dissolves with LexPattern carrier convergence.
type LexRuleApply
  = LexRuleNoMatch
  | LexRuleToken { class: Symbol, lexeme: String, remaining: String }
  | LexRuleTrivia { lexeme: String, remaining: String }

data tokenize_lex_e0_source_not_exhausted: Symbol = tokenize_lex_e0_source_not_exhausted
data tokenize_lex_e1_unrecognized_char: Symbol = tokenize_lex_e1_unrecognized_char


fn tokenize_lex_e0_source_not_exhausted_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_e0_source_not_exhausted,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn tokenize_lex_e1_unrecognized_char_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_e1_unrecognized_char,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived LexCharClass membership predicate (per-variant character range projection dissolves per-arm nat-range inline); forbidden: per-arm expansion laundering.
fn char_in_class(c: Nat, class: LexCharClass) -> Bool {
  match class {
    WhitespaceChar =>
      c == 32 || c == 9 || c == 10 || c == 13
    DigitChar =>
      nat_gte(a: c, b: 48) && nat_lte(a: c, b: 57)
    HexDigitChar =>
      (nat_gte(a: c, b: 48) && nat_lte(a: c, b: 57)) ||
      (nat_gte(a: c, b: 65) && nat_lte(a: c, b: 70)) ||
      (nat_gte(a: c, b: 97) && nat_lte(a: c, b: 102))
    IdentStartChar =>
      (nat_gte(a: c, b: 65) && nat_lte(a: c, b: 90)) ||
      (nat_gte(a: c, b: 97) && nat_lte(a: c, b: 122)) ||
      c == 95
    IdentContinueChar =>
      (nat_gte(a: c, b: 65) && nat_lte(a: c, b: 90)) ||
      (nat_gte(a: c, b: 97) && nat_lte(a: c, b: 122)) ||
      c == 95 ||
      (nat_gte(a: c, b: 48) && nat_lte(a: c, b: 57))
    StringTextChar =>
      c != 34 && c != 10
    LineCommentTextChar =>
      c != 10
    BlockCommentTextChar =>
      c != 42
  }
}


// lex_match_prefix: match a literal string prefix against source.
// Uses is_prefix_of (stdlib terminal) to avoid direct structural recursion on FreeMonoid.
// Advances source by folding over prefix — each step pops the head via list_tail (fail-closed).
// Safe because is_prefix_of guarantees source has at least length(prefix) elements.
fn lex_strip_prefix(prefix: String, source: String) -> ListTailResult<Char> {
  fold_list(
    xs: prefix,
    empty: TailFound { tail: source },
    cons: fn(acc, _) {
      match acc {
        TailAbsent => TailAbsent
        TailFound { tail: r } => list_tail(xs: r)
      }
    }
  )
}

fn lex_match_prefix(prefix: String, source: String) -> LexMatchResult {
  if is_prefix_of(prefix: prefix, xs: source, eq: fn(a, b) { a == b }) {
    match lex_strip_prefix(prefix: prefix, source: source) {
      TailFound { tail: rem } => LexMatchAccepted { remaining: rem, lexeme: prefix }
      TailAbsent => LexMatchRejected
    }
  } else {
    LexMatchRejected
  }
}


// Accumulator for fold-based greedy repeat matching inside lex_match_pattern.
type RepeatState {
  remaining: String
  lexeme: String
  done: Bool
}

// Accumulator for fold-based delimited matching (try-close-first) inside lex_match_pattern.
type DelimitedState {
  remaining: String
  lexeme: String
  done: Bool
  failed: Bool
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: LexPattern structural morphism substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived pattern-matching morphism over LexPattern coproduct (per-variant fold eliminating hand-written match arms); forbidden: adding new match arms outside the substrate derivation path.
// lex_match_pattern: structurally recursive on LexPattern (finite tree) — no fuel parameter needed.
// RepeatPattern/OneOrMorePattern arms use fold_list(xs: source, ...) with RepeatState accumulator;
// the closure calls lex_match_pattern(element, ...) where element is a StrictSubValue of pattern.
fn lex_match_pattern(pattern: LexPattern, source: String) -> LexMatchResult {
  match pattern {
    EmptyPattern =>
      LexMatchAccepted { remaining: source, lexeme: Empty }
    LiteralPattern { text: text } =>
      lex_match_prefix(prefix: text, source: source)
    KeywordPattern { text: text } =>
      match lex_match_prefix(prefix: text, source: source) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: rest, lexeme: lex } =>
          match string_is_empty(s: rest) {
            true => LexMatchAccepted { remaining: rest, lexeme: lex }
            false =>
              match string_head(s: rest) {
                CharAbsent => LexMatchAccepted { remaining: rest, lexeme: lex }
                CharFound { value: c } =>
                  match char_in_class(c: c, class: IdentContinueChar) {
                    true => LexMatchRejected
                    false => LexMatchAccepted { remaining: rest, lexeme: lex }
                  }
              }
          }
      }
    CharPattern { char: expected } =>
      match string_is_empty(s: source) {
        true => LexMatchRejected
        false =>
          match string_head(s: source) {
            CharAbsent => LexMatchRejected
            CharFound { value: c } =>
              match c == expected {
                true =>
                  match string_tail(s: source) {
                    TailFound { tail: rest } =>
                      LexMatchAccepted {
                        remaining: rest,
                        lexeme: Cons { head: c, tail: Empty }
                      }
                    TailAbsent => LexMatchRejected
                  }
                false => LexMatchRejected
              }
          }
      }
    CharClassPattern { class: class } =>
      match string_is_empty(s: source) {
        true => LexMatchRejected
        false =>
          match string_head(s: source) {
            CharAbsent => LexMatchRejected
            CharFound { value: c } =>
              match char_in_class(c: c, class: class) {
                true =>
                  match string_tail(s: source) {
                    TailFound { tail: rest } =>
                      LexMatchAccepted {
                        remaining: rest,
                        lexeme: Cons { head: c, tail: Empty }
                      }
                    TailAbsent => LexMatchRejected
                  }
                false => LexMatchRejected
              }
          }
      }
    SequencePattern { left: left, right: right } =>
      match lex_match_pattern(pattern: left, source: source) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: rest1, lexeme: lex1 } =>
          match lex_match_pattern(pattern: right, source: rest1) {
            LexMatchRejected => LexMatchRejected
            LexMatchAccepted { remaining: rest2, lexeme: lex2 } =>
              LexMatchAccepted { remaining: rest2, lexeme: list_append(left: lex1, right: lex2) }
          }
      }
    ChoicePattern { left: left, right: right } =>
      match lex_match_pattern(pattern: left, source: source) {
        LexMatchAccepted { remaining: rest, lexeme: lex } =>
          LexMatchAccepted { remaining: rest, lexeme: lex }
        LexMatchRejected =>
          lex_match_pattern(pattern: right, source: source)
      }
    OptionalPattern { element: element } =>
      match lex_match_pattern(pattern: element, source: source) {
        LexMatchAccepted { remaining: rest, lexeme: lex } =>
          LexMatchAccepted { remaining: rest, lexeme: lex }
        LexMatchRejected =>
          LexMatchAccepted { remaining: source, lexeme: Empty }
      }
    RepeatPattern { element: element } =>
      // fold_list(xs: source) bounds iterations to length(source); done: true short-circuits.
      // Each successful step consumes ≥1 chars (zero-width guard) or sets done: true.
      let init = RepeatState { remaining: source, lexeme: Empty, done: false }
      let result = fold_list(
        xs: source,
        empty: init,
        cons: fn(state, _) {
          match state.done {
            true => state
            false =>
              match lex_match_pattern(pattern: element, source: state.remaining) {
                LexMatchRejected =>
                  RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
                LexMatchAccepted { remaining: rest, lexeme: consumed } =>
                  match string_is_empty(s: consumed) {
                    true =>
                      RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
                    false =>
                      RepeatState {
                        remaining: rest,
                        lexeme: list_append(left: state.lexeme, right: consumed),
                        done: false
                      }
                  }
              }
          }
        }
      )
      LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
    OneOrMorePattern { element: element } =>
      match lex_match_pattern(pattern: element, source: source) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: rest, lexeme: lex } =>
          let init = RepeatState { remaining: rest, lexeme: lex, done: false }
          let result = fold_list(
            xs: rest,
            empty: init,
            cons: fn(state, _) {
              match state.done {
                true => state
                false =>
                  match lex_match_pattern(pattern: element, source: state.remaining) {
                    LexMatchRejected =>
                      RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
                    LexMatchAccepted { remaining: r, lexeme: c } =>
                      match string_is_empty(s: c) {
                        true =>
                          RepeatState { remaining: state.remaining, lexeme: state.lexeme, done: true }
                        false =>
                          RepeatState {
                            remaining: r,
                            lexeme: list_append(left: state.lexeme, right: c),
                            done: false
                          }
                      }
                  }
              }
            }
          )
          LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
      }
    DelimitedPattern { open: open, body: body, close: close } =>
      // Try-close-first semantics: at each position, attempt close before consuming a body element.
      // fold_list(xs: after_open) bounds iterations to length(after_open); body consumes ≥1 char
      // per step (zero-width guard) or sets done:true. Fixes greedy over-consumption for comments
      // like /**/ and /***/ where close shares chars with body (e.g. the star in `*/`).
      match lex_match_pattern(pattern: open, source: source) {
        LexMatchRejected => LexMatchRejected
        LexMatchAccepted { remaining: after_open, lexeme: open_lex } =>
          let init = DelimitedState { remaining: after_open, lexeme: open_lex, done: false, failed: false }
          let result = fold_list(
            xs: after_open,
            empty: init,
            cons: fn(state, _) {
              match state.done {
                true => state
                false =>
                  match lex_match_pattern(pattern: close, source: state.remaining) {
                    LexMatchAccepted { remaining: after_close, lexeme: close_lex } =>
                      DelimitedState {
                        remaining: after_close,
                        lexeme: list_append(left: state.lexeme, right: close_lex),
                        done: true,
                        failed: false
                      }
                    LexMatchRejected =>
                      match lex_match_pattern(pattern: body, source: state.remaining) {
                        LexMatchRejected =>
                          DelimitedState { remaining: state.remaining, lexeme: state.lexeme, done: true, failed: true }
                        LexMatchAccepted { remaining: after_body, lexeme: body_lex } =>
                          match string_is_empty(s: body_lex) {
                            true =>
                              DelimitedState { remaining: state.remaining, lexeme: state.lexeme, done: true, failed: true }
                            false =>
                              DelimitedState {
                                remaining: after_body,
                                lexeme: list_append(left: state.lexeme, right: body_lex),
                                done: false,
                                failed: false
                              }
                          }
                      }
                  }
              }
            }
          )
          match result.done {
            false => LexMatchRejected
            true =>
              match result.failed {
                true => LexMatchRejected
                false => LexMatchAccepted { remaining: result.remaining, lexeme: result.lexeme }
              }
          }
      }
  }
}


fn lex_rule_pattern(rule: LexRule) -> LexPattern {
  match rule {
    TokenRule { token_class: _, pattern: p } => p
    TriviaRule { pattern: p } => p
  }
}


fn lex_try_rule(rule: LexRule, source: String) -> LexRuleApply {
  match lex_match_pattern(pattern: lex_rule_pattern(rule: rule), source: source) {
    LexMatchRejected => LexRuleNoMatch
    LexMatchAccepted { remaining: remaining, lexeme: lexeme } =>
      match rule {
        TokenRule { token_class: class, pattern: _ } =>
          LexRuleToken { class: class, lexeme: lexeme, remaining: remaining }
        TriviaRule { pattern: _ } =>
          LexRuleTrivia { lexeme: lexeme, remaining: remaining }
      }
  }
}


fn lex_rule_apply_lexeme_length(apply: LexRuleApply) -> Int {
  match apply {
    LexRuleNoMatch => 0
    LexRuleToken { lexeme: lexeme, remaining: _, class: _ } => length(xs: lexeme)
    LexRuleTrivia { lexeme: lexeme, remaining: _ } => length(xs: lexeme)
  }
}


// Maximal munch: prefer the longest accepting lexeme; equal-length ties prefer the later rule
// so specific literal/keyword rules listed after ident win (i32, Int32, number, …).
fn lex_try_rules_prefer_longer(acc: LexRuleApply, candidate: LexRuleApply) -> LexRuleApply {
  match acc {
    LexRuleNoMatch => candidate
    _ =>
      match candidate {
        LexRuleNoMatch => acc
        _ =>
          if lex_rule_apply_lexeme_length(apply: candidate) >= lex_rule_apply_lexeme_length(apply: acc) {
            candidate
          } else {
            acc
          }
      }
  }
}


fn lex_try_rules(rules: List<LexRule>, source: String) -> LexRuleApply {
  fold_list(
    xs: rules,
    empty: LexRuleNoMatch,
    cons: fn(acc, rule) {
      lex_try_rules_prefer_longer(
        acc: acc,
        candidate: lex_try_rule(rule: rule, source: source)
      )
    }
  )
}


// Accumulator for fold-based lex_walk.
// fold_list(xs: source) bounds iterations to length(source); done: true short-circuits.
// Each successful step consumes ≥1 chars (zero-width guard sets error: true).
type LexWalkAcc {
  remaining: String
  tokens: List<Token>
  pos: Int
  done: Bool
  error: Bool
}


// lex_walk: scan source left-to-right; emit tokens, discard trivia, error on E1.
// fold_list(xs: source) provides the termination bound (length(source) iterations).
// Each non-error step consumes ≥1 characters; done: true short-circuits remaining steps.
fn lex_walk(source: String, file: Symbol, rules: LexRuleSet) -> Outcome<TokenStream> {
  let init = LexWalkAcc { remaining: source, tokens: Empty, pos: 0, done: false, error: false }
  let result = fold_list(
    xs: source,
    empty: init,
    cons: fn(acc, _) {
      match acc.done {
        true => acc
        false =>
          match string_is_empty(s: acc.remaining) {
            true =>
              LexWalkAcc { remaining: acc.remaining, tokens: acc.tokens, pos: acc.pos, done: true, error: false }
            false =>
              match lex_try_rules(rules: rules.rules, source: acc.remaining) {
                LexRuleNoMatch =>
                  LexWalkAcc { remaining: acc.remaining, tokens: acc.tokens, pos: acc.pos, done: true, error: true }
                LexRuleTrivia { lexeme: lexeme, remaining: remaining } =>
                  match string_is_empty(s: lexeme) {
                    true =>
                      LexWalkAcc { remaining: acc.remaining, tokens: acc.tokens, pos: acc.pos, done: true, error: true }
                    false =>
                      LexWalkAcc {
                        remaining: remaining,
                        tokens: acc.tokens,
                        pos: acc.pos + length(xs: lexeme),
                        done: false,
                        error: false
                      }
                  }
                LexRuleToken { class: class, lexeme: lexeme, remaining: remaining } =>
                  match string_is_empty(s: lexeme) {
                    true =>
                      LexWalkAcc { remaining: acc.remaining, tokens: acc.tokens, pos: acc.pos, done: true, error: true }
                    false =>
                      LexWalkAcc {
                        remaining: remaining,
                        tokens: list_snoc_item(
                          xs: acc.tokens,
                          item: Token { class: class, lexeme: lexeme, file: file, start: acc.pos, end: acc.pos + length(xs: lexeme) }
                        ),
                        pos: acc.pos + length(xs: lexeme),
                        done: false,
                        error: false
                      }
                  }
              }
          }
      }
    }
  )
  let at = Textual { file: file, extent: ByteRange { start: result.pos, end: result.pos } }
  if result.error {
    Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e1_unrecognized_char_diagnostic(at: at)) }
  } else {
    Accepted { value: TokenStream { tokens: result.tokens }, diagnostics: None }
  }
}


fn tokenize(text: String, file: Symbol, rules: LexRules) -> Outcome<TokenStream> {
  let at = Textual {
    file: file,
    extent: WholeFile
  }
  match rules {
    VoidLexRules =>
      if is_empty(xs: text) {
        Accepted { value: TokenStream { tokens: [] }, diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e0_source_not_exhausted_diagnostic(at: at)) }
      }
    ModeledLexRules { root: rule_set } =>
      lex_walk(source: text, file: file, rules: rule_set)
  }
}
