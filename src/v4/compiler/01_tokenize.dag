// src/v4/compiler/01_tokenize.dag
// Scope: generic tokenization over language lex rules.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis
// Owns: LexCharClass, LexPattern, LexRule, LexRuleSet, LexRules, Token, TokenStream, tokenize_lexical_walk_not_realized, tokenize_lex_e0_source_not_exhausted, tokenize_lexical_walk_not_realized_diagnostic, tokenize_lex_e0_source_not_exhausted_diagnostic, tokenize.
// Consumes: std collection, std diagnostic, std node, std text.
// Status: Wave-1 void-lex path realized.


module v4.compiler.tokenize


import v4.std.collection { List }
import v4.std.diagnostic {Correction, Diagnostic, ExternalContractUnknown, Locus, Outcome, Textual, UserInputBoundary, WholeFile, Accepted, None, diagnostics_singleton}
import v4.std.node { Symbol }
import v4.std.algebra { is_empty }
import v4.std.text { Char, String }

// 🟡 coproduct dissolution — CP-1b item 13a (LexCharClass).
type LexCharClass
  = WhitespaceChar
  | DigitChar
  | IdentStartChar
  | IdentContinueChar


// 🟡 coproduct dissolution — CP-1b item 13b (LexPattern).
type LexPattern
  = EmptyPattern
  | LiteralPattern { text: String }
  | CharPattern { char: Char }
  | CharClassPattern { class: LexCharClass }
  | SequencePattern { left: LexPattern, right: LexPattern }
  | ChoicePattern { left: LexPattern, right: LexPattern }
  | OptionalPattern { element: LexPattern }
  | RepeatPattern { element: LexPattern }


// 🟡 coproduct dissolution — CP-1b item 13c (LexRule).
type LexRule
  = TokenRule { token_class: Symbol, pattern: LexPattern }


type LexRuleSet {
  rules: List<LexRule>
}


// 🟡 coproduct dissolution — CP-1b item 13d (LexRules).
type LexRules
  = VoidLexRules
  | ModeledLexRules { root: LexRuleSet }


type Token {
  class: Symbol
  lexeme: String
  file: Symbol
  start: Int
  end: Int
}
type TokenStream {
  tokens: List<Token>
}
data tokenize_lexical_walk_not_realized: Symbol = tokenize_lexical_walk_not_realized

data tokenize_lex_e0_source_not_exhausted: Symbol = tokenize_lex_e0_source_not_exhausted


fn tokenize_lexical_walk_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lexical_walk_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn tokenize_lex_e0_source_not_exhausted_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_e0_source_not_exhausted,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn tokenize(text: String, file: Symbol, rules: LexRules) -> Outcome<TokenStream> {
  let at = Textual {
    file: file,
    extent: WholeFile
  }
  match rules {
    VoidLexRules =>
      if is_empty(xs: text) {
        Accepted { value: TokenStream {
            tokens: []
          }, diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: tokenize_lex_e0_source_not_exhausted_diagnostic(at: at)) }
      }
    ModeledLexRules { root: _ } =>
      Rejected { diagnostics: diagnostics_singleton(d: tokenize_lexical_walk_not_realized_diagnostic(at: at)) }
  }
}
