// src/v4/compiler/01_tokenize.dag
// Scope: generic tokenization over language lex rules.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis
// Owns: LexCharClass, LexPattern, LexRule, LexRuleSet, LexRules, Token, TokenStream, tokenize_lexical_walk_not_realized, tokenize_lex_rules_not_well_formed, tokenize_lex_e0_source_not_exhausted, tokenize_lexical_walk_not_realized_diagnostic, tokenize_lex_rules_not_well_formed_diagnostic, tokenize_lex_e0_source_not_exhausted_diagnostic, lex_rules_well_formed, tokenize.
// Consumes: std collection, std diagnostic, std node, std text.
// Status: Wave-1 void-lex path realized.


module v4.compiler.tokenize


import v4.std.collection { List }
import v4.std.diagnostic {
  Correction,
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  Outcome,
  Textual,
  UserInputBoundary,
  WholeFile
}
import v4.std.node { Symbol }
import v4.std.text { Char, String, string_is_empty }

// 🟡 coproduct dissolution — DECISIONS.md CP-1b item 13 (LexRules).
type LexCharClass
  = WhitespaceChar
  | DigitChar
  | IdentStartChar
  | IdentContinueChar


type LexPattern
  = EmptyPattern
  | LiteralPattern { text: String }
  | CharPattern { char: Char }
  | CharClassPattern { class: LexCharClass }
  | SequencePattern { left: LexPattern, right: LexPattern }
  | ChoicePattern { left: LexPattern, right: LexPattern }
  | OptionalPattern { element: LexPattern }
  | RepeatPattern { element: LexPattern }


type LexRule
  = TokenRule { token_class: Symbol, pattern: LexPattern }


type LexRuleSet {
  rules: List<LexRule>
}


type LexRules
  = VoidLexRules
  | ModeledLexRules { root: LexRuleSet }


type Token {
  class: Symbol
  lexeme: String
  file: Symbol
  start: Int
  end: Int
}
type TokenStream {
  tokens: List<Token>
}
data tokenize_lexical_walk_not_realized: Symbol = tokenize_lexical_walk_not_realized

data tokenize_lex_rules_not_well_formed: Symbol = tokenize_lex_rules_not_well_formed

data tokenize_lex_e0_source_not_exhausted: Symbol = tokenize_lex_e0_source_not_exhausted


fn tokenize_lexical_walk_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lexical_walk_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn tokenize_lex_rules_not_well_formed_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_rules_not_well_formed,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn tokenize_lex_e0_source_not_exhausted_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_e0_source_not_exhausted,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn lex_pattern_well_formed(pattern: LexPattern) -> Bool {
  match pattern {
    EmptyPattern => true
    LiteralPattern { text: _ } => true
    CharPattern { char: _ } => true
    CharClassPattern { class: _ } => true
    SequencePattern { left: left, right: right } =>
      lex_pattern_well_formed(pattern: left) &&
        lex_pattern_well_formed(pattern: right)
    ChoicePattern { left: left, right: right } =>
      lex_pattern_well_formed(pattern: left) &&
        lex_pattern_well_formed(pattern: right)
    OptionalPattern { element: element } =>
      lex_pattern_well_formed(pattern: element)
    RepeatPattern { element: element } =>
      lex_pattern_well_formed(pattern: element)
  }
}


fn lex_rule_well_formed(rule: LexRule) -> Bool {
  match rule {
    TokenRule { token_class: _, pattern: pattern } =>
      lex_pattern_well_formed(pattern: pattern)
  }
}


fn lex_rule_set_well_formed(root: LexRuleSet) -> Bool {
  fold(root.rules, init: true, f: fn(acc, rule) {
    acc && lex_rule_well_formed(rule: rule)
  })
}


fn lex_rules_well_formed(rules: LexRules) -> Bool {
  match rules {
    VoidLexRules => true
    ModeledLexRules { root: root } =>
      lex_rule_set_well_formed(root: root)
  }
}


fn tokenize(text: String, file: Symbol, rules: LexRules) -> Outcome<TokenStream> {
  let at = Textual {
    file: file,
    extent: WholeFile
  }
  if lex_rules_well_formed(rules: rules) {
    match rules {
      VoidLexRules =>
        if string_is_empty(s: text) {
          Produced {
            value: TokenStream {
              tokens: []
            }
          }
        } else {
          Rejected {
            diagnostic: tokenize_lex_e0_source_not_exhausted_diagnostic(at: at)
          }
        }
      ModeledLexRules { root: _ } =>
        Rejected {
          diagnostic: tokenize_lexical_walk_not_realized_diagnostic(at: at)
        }
    }
  } else {
    Rejected {
      diagnostic: tokenize_lex_rules_not_well_formed_diagnostic(at: at)
    }
  }
}
