// src/v4/compiler/01_tokenize.dag
// Scope: generic tokenization over language lex rules.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis
// Owns: LexRules, Token, TokenStream, tokenize_lexical_walk_not_realized, tokenize_lex_rules_not_well_formed, tokenize_lex_e0_source_not_exhausted, tokenize_lexical_walk_not_realized_diagnostic, tokenize_lex_rules_not_well_formed_diagnostic, tokenize_lex_e0_source_not_exhausted_diagnostic, tokenize.
// Consumes: std collection, std diagnostic, std node, std text.
// Status: Wave-1 void-lex path realized.


module v4.compiler.tokenize


import v4.std.collection { List }
import v4.std.diagnostic {
  Correction,
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  Outcome,
  Textual,
  UserInputBoundary,
  WholeFile,
}
import v4.std.node {
  Node,
  Symbol,
  node_is_empty_conj_root,
  node_well_formed,
}
import v4.std.text { Char, String, string_is_empty }
type LexRules = Node
type Token {
  class: Symbol
  lexeme: String
  file: Symbol
  start: Int
  end: Int
}
type TokenStream {
  tokens: List<Token>
}
data tokenize_lexical_walk_not_realized: Symbol = tokenize_lexical_walk_not_realized

data tokenize_lex_rules_not_well_formed: Symbol = tokenize_lex_rules_not_well_formed

data tokenize_lex_e0_source_not_exhausted: Symbol = tokenize_lex_e0_source_not_exhausted


fn tokenize_lexical_walk_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lexical_walk_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn tokenize_lex_rules_not_well_formed_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_rules_not_well_formed,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn tokenize_lex_e0_source_not_exhausted_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: tokenize_lex_e0_source_not_exhausted,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}
fn tokenize(text: String, file: Symbol, rules: LexRules) -> Outcome<TokenStream> {
  let at = Textual {
    file: file,
    extent: WholeFile
  }
  if !node_well_formed(n: rules) {
    Rejected {
      diagnostic: tokenize_lex_rules_not_well_formed_diagnostic(at: at)
    }
  } else if node_is_empty_conj_root(n: rules) {
    if string_is_empty(s: text) {
      Produced {
        value: TokenStream {
          tokens: []
        }
      }
    } else {
      Rejected {
        diagnostic: tokenize_lex_e0_source_not_exhausted_diagnostic(at: at)
      }
    }
  } else {
    Rejected {
      diagnostic: tokenize_lexical_walk_not_realized_diagnostic(at: at)
    }
  }
}
