// src/v4/compiler/t15_self_host.dag
// Scope: T-15 self-host fixed-point validation runner shape; body is scaffolded fail-closed until T-22/T-34 and Stage1Candidate generation land.
// Owns: CoreNode, SourceModels, StructurallyEqual, StageEmissionEquality, self_host_fixed_point_validate.
// Consumes: v4.std.coercion, v4.std.diagnostic, v4.std.node, v4.std.witness.
// Status: scaffold-against-contract; runner body returns T15RunnerNotRealized.

module v4.compiler.t15_self_host

import v4.std.coercion { homomorphism_rule_exact_structural_equality }
import v4.std.collection { List }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  NodeLocus,
  Outcome,
  PortLocus,
  Rejected,
  Unavailable,
  diagnostics_singleton
}
import v4.std.node { Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.witness {
  StructuralPropertyWitness,
  Witness
}


type CoreNode = Node


type SourceModels {
  model_corpus: List<CoreNode>
}


type StructurallyEqual {
  left: CoreNode
  right: CoreNode
}


// 🟡 coproduct dissolution — scaffold:t15-stage-emission-equality · dissolve-on: T-22 runner consumes find_witness/coercion exact structural-equality witness.
type StageEmissionEquality
// 🟡 coproduct dissolution — scaffold:t15-stage-emission-equality
  = StructuralEqual { witness: Witness<StructurallyEqual> }
  | Diverged { divergence_locus: Locus, diagnostic: Diagnostic }


type PromotionWitness {
  candidate_bootstrap_roundtrip_sub_check: StructuralPropertyWitness
  candidate_fixed_point_sub_check: StructuralPropertyWitness
}


data t15_runner_not_realized: Symbol = t15_runner_not_realized
data t15_runner_port: Symbol = t15_runner_port
data candidate_bootstrap_roundtrip_sub_check: Symbol = candidate_bootstrap_roundtrip_sub_check
data candidate_fixed_point_sub_check: Symbol = candidate_fixed_point_sub_check
data t15_stage1_candidate_field: Symbol = t15_stage1_candidate_field
data t15_reference_stage1_field: Symbol = t15_reference_stage1_field


fn t15_runner_not_realized_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: t15_runner_not_realized,
    at: PortLocus { port: t15_runner_port },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn t15_stage_pair_evidence(
  stage1_candidate: CoreNode,
  reference_stage1: CoreNode
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Named { name: t15_stage1_candidate_field }, target: stage1_candidate },
      Edge { label: Named { name: t15_reference_stage1_field }, target: reference_stage1 }
    ]
  }
}


fn candidate_bootstrap_roundtrip_witness(
  stage1_candidate: CoreNode,
  reference_stage1: CoreNode
) -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: candidate_bootstrap_roundtrip_sub_check,
    evidence: t15_stage_pair_evidence(
      stage1_candidate: stage1_candidate,
      reference_stage1: reference_stage1
    )
  }
}


fn candidate_fixed_point_witness(
  stage1_candidate: CoreNode,
  reference_stage1: CoreNode
) -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: candidate_fixed_point_sub_check,
    evidence: t15_stage_pair_evidence(
      stage1_candidate: stage1_candidate,
      reference_stage1: reference_stage1
    )
  }
}


fn candidate_promotion_witness(
  stage1_candidate: CoreNode,
  reference_stage1: CoreNode
) -> PromotionWitness {
  PromotionWitness {
    candidate_bootstrap_roundtrip_sub_check: candidate_bootstrap_roundtrip_witness(
      stage1_candidate: stage1_candidate,
      reference_stage1: reference_stage1
    ),
    candidate_fixed_point_sub_check: candidate_fixed_point_witness(
      stage1_candidate: stage1_candidate,
      reference_stage1: reference_stage1
    )
  }
}


fn stage_emission_equality_scaffold(
  emitted_candidate: CoreNode,
  reference_stage1: CoreNode
) -> StageEmissionEquality {
  Diverged {
    divergence_locus: NodeLocus { node: emitted_candidate },
    diagnostic: Diagnostic {
      reason: homomorphism_rule_exact_structural_equality,
      at: NodeLocus { node: reference_stage1 },
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}


fn self_host_fixed_point_validate(
  stage1_candidate: CoreNode,
  source_models: SourceModels,
  reference_stage1: CoreNode
) -> Outcome<PromotionWitness> {
  Rejected {
    diagnostics: diagnostics_singleton(d: t15_runner_not_realized_diagnostic())
  }
}
