// src/v4/compiler/05_emit.dag
// Scope: Stage 5b — TargetNodeTree + TargetModel -> TargetSource; grammar-as-bidir serialize (DECISIONS C5).
// Owns: emit_stage_locus_port, target_model_edge_serialize_emitted, target_model_edge_serialize_source,
//       serialize_source_for_emitted, serialize_target, emit.
// Consumes: compiler/00_compile.dag, compiler/04_infer.dag, compiler/06_translate.dag, std/diagnostic.dag,
//           std/node.dag, std/text.dag.
// Status: W-T-10-impl — emit = serialize_target ∘ translate; no string-templated emitter.
// Anchor: docs/design-v4-compiler-homomorphism.md Stage 5b + Ratified Q11.


module v4.compiler.emit


import v4.compiler.compile { TargetModel, TargetSource }
import v4.compiler.infer { InferredTree }
import v4.compiler.translate {
  TargetNodeTree,
  target_model_edge_serialize_emitted,
  target_bundle_child,
  target_serialize_source_from_model,
  translate
}
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NodeLocus,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  outcome_rejected
}
import v4.std.node { Node, Symbol }
import v4.std.text { String }
data emit_stage_locus_port: Symbol = emit_stage_locus_port
data emit_serialize_emitted_mismatch: Symbol = emit_serialize_emitted_mismatch
data emit_serialize_source_missing: Symbol = emit_serialize_source_missing
fn emit_serialize_emitted_mismatch_diagnostic(emitted: Node, target: TargetModel) -> Diagnostic {
  Diagnostic {
    reason: emit_serialize_emitted_mismatch,
    at: NodeLocus { node: emitted },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn emit_serialize_source_missing_diagnostic(target: TargetModel) -> Diagnostic {
  Diagnostic {
    reason: emit_serialize_source_missing,
    at: NodeLocus { node: target },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn serialize_source_for_emitted(
  emitted: TargetNodeTree,
  target: TargetModel,
) -> Outcome<TargetSource> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_serialize_emitted),
    f: fn(expected_emitted) {
      if emitted == expected_emitted {
        target_serialize_source_from_model(target: target)
      } else {
        outcome_rejected(emit_serialize_emitted_mismatch_diagnostic(
          emitted: emitted,
          target: target
        ))
      }
    }
  )
}
fn serialize_target(tree: TargetNodeTree, target: TargetModel) -> Outcome<TargetSource> {
  match serialize_source_for_emitted(emitted: tree, target: target) {
    Accepted { value: source, diagnostics: d } =>
      Accepted { value: source, diagnostics: d }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
fn emit(tree: InferredTree, target: TargetModel) -> Outcome<TargetSource> {
  bind_outcome(
    o: translate(tree: tree, target: target),
    f: fn(target_tree) {
      serialize_target(tree: target_tree, target: target)
    }
  )
}
