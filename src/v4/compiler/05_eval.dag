// src/v4/compiler/05_eval.dag
// Scope: primary evaluation path over inferred tree/input subgraphs and TestClaim runner substrate.
// Anchor: https://en.wikipedia.org/wiki/Interpreter_(computing)
// Owns: InferredTree, Inputs, EvalContext, TestClaimEvalSubject, TestClaimRun, eval_node, run_test_claim.
// Consumes: v4.std.node, v4.std.diagnostic, v4.std.verification, v4.workflow.ci.
// Status: Wave-0 substrate; evaluator bodies remain structural until T-9 inferred-tree semantics.

module v4.compiler.eval


import v4.std.node {
  Hash,
  Node,
  Symbol,
  node_well_formed
}
import v4.std.diagnostic {
  Correction,
  Diagnostic,
  Extent,
  Locus,
  NoCorrectionReason,
  Outcome,
  Produced,
  Rejected
}
import v4.std.verification {
  AssertKind,
  Compiles,
  Equals,
  RoundTrips,
  TestClaim
}
import v4.workflow.ci {
  BootstrapStageCompile,
  CiGate,
  CiJob,
  CiPipeline,
  ci_bootstrap_authority_violation,
  ci_dangling_reference,
  ci_dependency_cycle,
  ci_duplicate_gate_id,
  ci_duplicate_job_id,
  ci_pipeline_well_formed,
  structural_v2_compile,
  v2_compile_src_v4
}
import v4.workflow.bootstrap { v4_stage0_binary }


type InferredTree = Node


type Inputs {
  root: Node
}


type EvalContext {
  evaluator: Node
  resources: Node
  extdeps: Node
}


type TestClaimEvalSubject {
  claim_node: Node
  claim: TestClaim
  context: EvalContext
}


type TestClaimCacheKey {
  whole_claim_hash: Hash
}


type TestClaimCacheReceipt {
  source: Node
  key: TestClaimCacheKey
  reused: Bool
}


type Verdict<T>
// 🟢 coproduct dissolution — execution result is exactly pass or fail.
  = Pass
  | Fail { actual: Outcome<T> }


type TestClaimVerdict = Verdict<Node>


type TestClaimRun {
  subject: TestClaimEvalSubject
  cache: TestClaimCacheReceipt
  verdict: TestClaimVerdict
}


fn test_claim_cache_receipt(subject: TestClaimEvalSubject, whole_claim_hash: Hash, reused: Bool) -> TestClaimCacheReceipt {
  TestClaimCacheReceipt {
    source: subject.claim_node,
    key: TestClaimCacheKey { whole_claim_hash: whole_claim_hash },
    reused: reused
  }
}


data eval_rejected_invalid_node: Symbol = eval_rejected_invalid_node
data eval_rejected_diagnostic_mismatch: Symbol = eval_rejected_diagnostic_mismatch
data eval_rejected_roundtrip_deferred: Symbol = eval_rejected_roundtrip_deferred
data eval_file: Symbol = eval_file


fn eval_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: NodeLocus { node: node },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}


fn eval_node(tree: InferredTree, inputs: Inputs) -> Outcome<Node> {
  if node_well_formed(n: inputs.root) {
    Produced { value: inputs.root }
  } else {
    Rejected { diagnostic: eval_diagnostic(reason: eval_rejected_invalid_node, node: tree) }
  }
}


fn outcome_node_eq(a: Outcome<Node>, b: Outcome<Node>) -> Bool {
  match a {
    Produced { value: av } => match b {
      Produced { value: bv } => av == bv
      Rejected { diagnostic: _ } => false
    }
    // Rejection equality is reason-level for TestClaim assertions; locus and
    // correction are diagnostic presentation facts, not the oracle identity.
    Rejected { diagnostic: ad } => match b {
      Produced { value: _ } => false
      Rejected { diagnostic: bd } => ad.reason == bd.reason
    }
  }
}


fn run_assert(kind: AssertKind, actual: Outcome<Node>, expected: Outcome<Node>, input: Node) -> TestClaimVerdict {
  match kind {
    Equals => if outcome_node_eq(a: actual, b: expected) { Pass } else { Fail { actual: actual } }
    Compiles => match actual {
      Produced { value: _ } => Pass
      Rejected { diagnostic: _ } => Fail { actual: actual }
    }
    Diagnostic => match actual {
      Produced { value: _ } => Fail { actual: actual }
      Rejected { diagnostic: _ } =>
        if outcome_node_eq(a: actual, b: expected) { Pass } else { Fail { actual: actual } }
    }
    RoundTrips => Fail {
      actual: Rejected {
        diagnostic: eval_diagnostic(reason: eval_rejected_roundtrip_deferred, node: input)
      }
    }
  }
}


fn run_test_claim(subject: TestClaimEvalSubject, cache: TestClaimCacheReceipt) -> TestClaimRun {
  let actual = eval_node(
    tree: subject.claim.input,
    inputs: Inputs { root: subject.claim.input }
  )
  TestClaimRun {
    subject: subject,
    cache: cache,
    verdict: run_assert(
      kind: subject.claim.kind,
      actual: actual,
      expected: subject.claim.expected,
      input: subject.claim.input
    )
  }
}


type StructuralOutcomeClaim<T> {
  label: Symbol
  actual: Outcome<T>
  expected: Outcome<T>
}


fn ci_outcome_reason_eq(actual: Outcome<CiPipeline>, reason: Symbol) -> Bool {
  match actual {
    Produced { value: _ } => false
    Rejected { diagnostic: d } => d.reason == reason
  }
}


fn run_ci_negative_claim(claim: StructuralOutcomeClaim<CiPipeline>) -> Verdict<CiPipeline> {
  match claim.expected {
    Produced { value: _ } => Fail { actual: claim.actual }
    Rejected { diagnostic: d } =>
      if ci_outcome_reason_eq(actual: claim.actual, reason: d.reason) {
        Pass
      } else {
        Fail { actual: claim.actual }
      }
  }
}


data t22_ci_dangling_bootstrap_output: Symbol = t22_ci_dangling_bootstrap_output
data t22_ci_duplicate_job_id: Symbol = t22_ci_duplicate_job_id
data t22_ci_duplicate_gate_id: Symbol = t22_ci_duplicate_gate_id
data t22_ci_dangling_need: Symbol = t22_ci_dangling_need
data t22_ci_dangling_gate_job: Symbol = t22_ci_dangling_gate_job
data t22_ci_dependency_cycle: Symbol = t22_ci_dependency_cycle
data t22_missing_stage_binary: Symbol = t22_missing_stage_binary
data t22_other_job: Symbol = t22_other_job
data t22_other_gate: Symbol = t22_other_gate


fn t22_ci_expected(reason: Symbol) -> Outcome<CiPipeline> {
  Rejected {
    diagnostic: Diagnostic {
      reason: reason,
      at: Textual { file: eval_file, extent: WholeFile },
      correction: Unavailable { reason: AmbiguousIntent }
    }
  }
}


data claim_ci_dangling_bootstrap_output: StructuralOutcomeClaim<CiPipeline> = StructuralOutcomeClaim {
  label: t22_ci_dangling_bootstrap_output,
  actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob {
        id: v2_compile_src_v4,
        command: BootstrapStageCompile { produces: t22_missing_stage_binary },
        needs: []
      }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  }),
  expected: t22_ci_expected(reason: ci_bootstrap_authority_violation)
}


data claim_ci_duplicate_job_id: StructuralOutcomeClaim<CiPipeline> = StructuralOutcomeClaim {
  label: t22_ci_duplicate_job_id,
  actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [] },
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  }),
  expected: t22_ci_expected(reason: ci_duplicate_job_id)
}


data claim_ci_duplicate_gate_id: StructuralOutcomeClaim<CiPipeline> = StructuralOutcomeClaim {
  label: t22_ci_duplicate_gate_id,
  actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 },
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  }),
  expected: t22_ci_expected(reason: ci_duplicate_gate_id)
}


data claim_ci_dangling_need: StructuralOutcomeClaim<CiPipeline> = StructuralOutcomeClaim {
  label: t22_ci_dangling_need,
  actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [t22_other_job] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  }),
  expected: t22_ci_expected(reason: ci_dangling_reference)
}


data claim_ci_dangling_gate_job: StructuralOutcomeClaim<CiPipeline> = StructuralOutcomeClaim {
  label: t22_ci_dangling_gate_job,
  actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: t22_other_job }
    ]
  }),
  expected: t22_ci_expected(reason: ci_dangling_reference)
}


data claim_ci_dependency_cycle: StructuralOutcomeClaim<CiPipeline> = StructuralOutcomeClaim {
  label: t22_ci_dependency_cycle,
  actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [t22_other_job] },
      CiJob { id: t22_other_job, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [v2_compile_src_v4] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 },
      CiGate { id: t22_other_gate, job: t22_other_job }
    ]
  }),
  expected: t22_ci_expected(reason: ci_dependency_cycle)
}


data t22_ci_negative_claims_pass: Bool = (run_ci_negative_claim(claim: claim_ci_dangling_bootstrap_output) == Pass)
  && (run_ci_negative_claim(claim: claim_ci_duplicate_job_id) == Pass)
  && (run_ci_negative_claim(claim: claim_ci_duplicate_gate_id) == Pass)
  && (run_ci_negative_claim(claim: claim_ci_dangling_need) == Pass)
  && (run_ci_negative_claim(claim: claim_ci_dangling_gate_job) == Pass)
  && (run_ci_negative_claim(claim: claim_ci_dependency_cycle) == Pass)
