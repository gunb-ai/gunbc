// src/v4/compiler/05_eval.dag
// Scope: primary evaluation path over inferred tree/input subgraphs and TestClaim runner substrate.
// Owns: InferredTree, Inputs, EvalContext, TestClaimEvalSubject, TestClaimCacheKey, TestClaimCacheReceipt, Verdict, TestClaimRun, eval_node, run_test_claim.
// Consumes: v4.std.node, v4.std.diagnostic, v4.std.verification, v4.workflow.ci.
// Status: Wave-0 substrate; evaluator bodies remain structural until T-9 inferred-tree semantics.
// Anchor: https://en.wikipedia.org/wiki/Interpreter_(computing)

module v4.compiler.eval


import v4.std.node {
  Atom,
  Hash,
  Node,
  Symbol,
  TypeNode,
  node_well_formed
}
import v4.std.diagnostic {
  Correction,
  Diagnostic,
  NoCorrectionReason,
  NodeLocus,
  Outcome,
  Produced,
  Rejected
}
import v4.std.verification {
  AssertKind,
  Compiles,
  Equals,
  Integration,
  RoundTrips,
  T19ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1
}
import v4.workflow.ci {
  BootstrapStageCompile,
  CiGate,
  CiJob,
  CiPipeline,
  ci_bootstrap_authority_violation,
  ci_dangling_reference,
  ci_dependency_cycle,
  ci_duplicate_gate_id,
  ci_duplicate_job_id,
  ci_pipeline_well_formed,
  structural_v2_compile,
  v2_compile_src_v4
}
import v4.workflow.bootstrap { v4_stage0_binary }


type InferredTree = Node


type Inputs {
  root: Node
}


type EvalContext {
  evaluator: Node
  resources: Node
  extdeps: Node
}


type TestClaimEvalSubject {
  claim_node: Node
  claim: TestClaim
  context: EvalContext
}


type TestClaimCacheKey {
  claim_node: Node
  evaluator: Node
  resources: Node
  extdeps: Node
  claim_hash: Hash
  evaluator_hash: Hash
  resources_hash: Hash
  extdeps_hash: Hash
}


type TestClaimCacheReceipt {
  key: TestClaimCacheKey
}


type Verdict<T>
// 🟢 coproduct dissolution — DECISIONS.md T22-EVAL-VERDICT
  = Pass
  | Fail { actual: Outcome<T> }


type TestClaimVerdict = Verdict<Node>


type TestClaimRun {
  subject: TestClaimEvalSubject
  cache: TestClaimCacheReceipt
  verdict: TestClaimVerdict
}


fn test_claim_cache_receipt(
  subject: TestClaimEvalSubject,
  claim_hash: Hash,
  evaluator_hash: Hash,
  resources_hash: Hash,
  extdeps_hash: Hash
) -> TestClaimCacheReceipt {
  TestClaimCacheReceipt {
    key: TestClaimCacheKey {
      claim_node: subject.claim_node,
      evaluator: subject.context.evaluator,
      resources: subject.context.resources,
      extdeps: subject.context.extdeps,
      claim_hash: claim_hash,
      evaluator_hash: evaluator_hash,
      resources_hash: resources_hash,
      extdeps_hash: extdeps_hash
    }
  }
}


data eval_rejected_invalid_node: Symbol = eval_rejected_invalid_node
data eval_rejected_diagnostic_mismatch: Symbol = eval_rejected_diagnostic_mismatch
data eval_rejected_assert_kind_deferred: Symbol = eval_rejected_assert_kind_deferred
data eval_rejected_roundtrip_deferred: Symbol = eval_rejected_roundtrip_deferred


fn eval_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: NodeLocus { node: node },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}


fn eval_node(tree: InferredTree, inputs: Inputs) -> Outcome<Node> {
  if node_well_formed(n: inputs.root) {
    Produced { value: inputs.root }
  } else {
    Rejected { diagnostic: eval_diagnostic(reason: eval_rejected_invalid_node, node: tree) }
  }
}


fn outcome_node_eq(a: Outcome<Node>, b: Outcome<Node>) -> Bool {
  match a {
    Produced { value: av } => match b {
      Produced { value: bv } => av == bv
      Rejected { diagnostic: _ } => false
    }
    Rejected { diagnostic: ad } => match b {
      Produced { value: _ } => false
      Rejected { diagnostic: bd } => ad == bd
    }
  }
}


fn run_assert(kind: AssertKind, actual: Outcome<Node>, expected: Outcome<Node>, input: Node) -> TestClaimVerdict {
  match kind {
    Equals => if outcome_node_eq(a: actual, b: expected) { Pass } else { Fail { actual: actual } }
    Compiles => match actual {
      Produced { value: _ } => Pass
      Rejected { diagnostic: _ } => Fail { actual: actual }
    }
    RoundTrips => Fail {
      actual: Rejected {
        diagnostic: eval_diagnostic(reason: eval_rejected_roundtrip_deferred, node: input)
      }
    }
    _ => Fail {
      actual: Rejected {
        diagnostic: eval_diagnostic(reason: eval_rejected_assert_kind_deferred, node: input)
      }
    }
  }
}


fn run_test_claim(subject: TestClaimEvalSubject, cache: TestClaimCacheReceipt) -> TestClaimRun {
  let actual = eval_node(
    tree: subject.claim.input,
    inputs: Inputs { root: subject.claim.input }
  )
  TestClaimRun {
    subject: subject,
    cache: cache,
    verdict: run_assert(
      kind: subject.claim.kind,
      actual: actual,
      expected: subject.claim.expected,
      input: subject.claim.input
    )
  }
}


data t22_missing_stage_binary: Symbol = t22_missing_stage_binary
data t22_other_job: Symbol = t22_other_job
data t22_other_gate: Symbol = t22_other_gate
data t22_ci_unexpected_produced: Symbol = t22_ci_unexpected_produced


fn t22_symbol_node(s: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: s } },
    children: []
  }
}


fn t22_ci_rejection_reason_node(actual: Outcome<CiPipeline>) -> Node {
  match actual {
    Produced { value: _ } => t22_symbol_node(s: t22_ci_unexpected_produced)
    Rejected { diagnostic: d } => t22_symbol_node(s: d.reason)
  }
}


fn t22_ci_claim(label: String, input: Node, expected_reason: Symbol) -> TestClaim {
  TestClaim {
    kind: Equals,
    label: label,
    t19_anchor: T19ManualAnchorAbsent,
    input: input,
    expected: Produced { value: t22_symbol_node(s: expected_reason) },
    classification: TestClassification { tier: Tier1, layer: Integration }
  }
}


data claim_ci_dangling_bootstrap_output: TestClaim = t22_ci_claim(
  label: "t22_ci_dangling_bootstrap_output",
  input: t22_ci_rejection_reason_node(actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob {
        id: v2_compile_src_v4,
        command: BootstrapStageCompile { produces: t22_missing_stage_binary },
        needs: []
      }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  })),
  expected_reason: ci_bootstrap_authority_violation
)


data claim_ci_duplicate_job_id: TestClaim = t22_ci_claim(
  label: "t22_ci_duplicate_job_id",
  input: t22_ci_rejection_reason_node(actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [] },
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  })),
  expected_reason: ci_duplicate_job_id
)


data claim_ci_duplicate_gate_id: TestClaim = t22_ci_claim(
  label: "t22_ci_duplicate_gate_id",
  input: t22_ci_rejection_reason_node(actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 },
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  })),
  expected_reason: ci_duplicate_gate_id
)


data claim_ci_dangling_need: TestClaim = t22_ci_claim(
  label: "t22_ci_dangling_need",
  input: t22_ci_rejection_reason_node(actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [t22_other_job] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
    ]
  })),
  expected_reason: ci_dangling_reference
)


data claim_ci_dangling_gate_job: TestClaim = t22_ci_claim(
  label: "t22_ci_dangling_gate_job",
  input: t22_ci_rejection_reason_node(actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: t22_other_job }
    ]
  })),
  expected_reason: ci_dangling_reference
)


data claim_ci_dependency_cycle: TestClaim = t22_ci_claim(
  label: "t22_ci_dependency_cycle",
  input: t22_ci_rejection_reason_node(actual: ci_pipeline_well_formed(p: CiPipeline {
    jobs: [
      CiJob { id: v2_compile_src_v4, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [t22_other_job] },
      CiJob { id: t22_other_job, command: BootstrapStageCompile { produces: v4_stage0_binary }, needs: [v2_compile_src_v4] }
    ],
    gates: [
      CiGate { id: structural_v2_compile, job: v2_compile_src_v4 },
      CiGate { id: t22_other_gate, job: t22_other_job }
    ]
  })),
  expected_reason: ci_dependency_cycle
)
