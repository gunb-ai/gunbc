// RULING-1: pretty-much-done — eval input root remains arbitrary-node shaped for IRT-3; runtime interpretation lives in eval.
type Inputs {
  root: Node
}


// RULING-1: pretty-much-done — explicit runtime interpretation authority.
type EvalContext {
  interpretation: InterpretationAlgebra
}


// RULING-1: needs-more-work — typed-input bridge until TestClaim input projection lands.
type TestClaimTypedInput<T> {
  evaluator_input: T
}


// RULING-1: needs-more-work — bridge subject for current TestClaim execution rows.
type TestClaimEvalSubject<T> {
  claim: TestClaim
  context: EvalContext
  tree: InferredTree
  input: TestClaimTypedInput<T>
}


// 🟡 gated — feature:T22-EVAL-CACHE-HASHES — bind IRT-4 / TASKS.md T-22 — dissolve-on: B1 content_hash of the whole TestClaim evaluation subgraph replaces staging placeholders; forbidden: caller-supplied hash parameters acting as cache-validating authority before B1 content_hash lands.
type TestClaimCacheKeyStagingPlaceholder {
  claim_hash: Hash
  interpretation_hash: Hash
}


// 🟡 gated — feature:T22-EVAL-CACHE-HASHES — bind IRT-4 / TASKS.md T-22 — dissolve-on: cache key derived from content_hash(eval_subject); hash_staging is NOT cache-validating authority until B1 lands.
type TestClaimCacheKey<T> {
  eval_subject: TestClaimEvalSubject<T>
  hash_staging: TestClaimCacheKeyStagingPlaceholder
}


// 🟡 gated — feature:T22-EVAL-CACHE-HASHES — bind IRT-4 / TASKS.md T-22 — dissolve-on: receipt keyed by derived content_hash; forbidden: treating hash_staging as authoritative cache boundary.
type TestClaimCacheReceipt<T> {
  key: TestClaimCacheKey<T>
}


// RULING-1: needs-more-work — executable corpus runner will replace Wave-0 run rows.
type TestClaimRun<S, A> {
  cache: TestClaimCacheReceipt<S>
  verdict: Verdict<A>
}


type EvalFoldState {
  node: Node
  progress: EvalProgress
  structural: Outcome<Node>
  child_values: Outcome<List<RuntimeValue>>
  value: Outcome<RuntimeValue>
}


// 🟢 coproduct dissolution — EvalFoldState carries one explicit progress authority for child-fold completion.
type EvalProgress
  = AwaitingChildren { processed: Int }
  | ReadyToInterpret
  | Interpreted


fn test_claim_cache_receipt<T>(
  subject: TestClaimEvalSubject<T>,
  claim_hash: Hash,
  interpretation_hash: Hash
) -> TestClaimCacheReceipt<T> {
  TestClaimCacheReceipt {
    key: TestClaimCacheKey {
      eval_subject: subject,
      hash_staging: TestClaimCacheKeyStagingPlaceholder {
        claim_hash: claim_hash,
        interpretation_hash: interpretation_hash
      }
    }
  }
}


data eval_rejected_invalid_node: Symbol = eval_rejected_invalid_node
data eval_rejected_roundtrip_deferred: Symbol = eval_rejected_roundtrip_deferred
data eval_empty_verdict_list: Symbol = eval_empty_verdict_list
data eval_rejected_type_node: Symbol = eval_rejected_type_node
data eval_rejected_pending_children: Symbol = eval_rejected_pending_children
data eval_rejected_suspended_not_terminal: Symbol = eval_rejected_suspended_not_terminal
data eval_rejected_runtime_binding_lookup_miss: Symbol = eval_rejected_runtime_binding_lookup_miss
data eval_rejected_resolved_type_mismatch: Symbol = eval_rejected_resolved_type_mismatch
data eval_rejected_inhabitance_mismatch: Symbol = eval_rejected_inhabitance_mismatch
data eval_rejected_canonical_mismatch: Symbol = eval_rejected_canonical_mismatch
data eval_rejected_grounding_node_mismatch: Symbol = eval_rejected_grounding_node_mismatch
data eval_rejected_runtime_value_node_unrepresentable: Symbol = eval_rejected_runtime_value_node_unrepresentable
data eval_rejected_branch_argument_absent: Symbol = eval_rejected_branch_argument_absent
data eval_rejected_bind_key_absent: Symbol = eval_rejected_bind_key_absent
data eval_rejected_bind_value_absent: Symbol = eval_rejected_bind_value_absent
data eval_rejected_bind_body_absent: Symbol = eval_rejected_bind_body_absent
fn eval_diagnostic(reason: Symbol, node: Node) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: node),
    correction: Unavailable { reason: AmbiguousIntent }
  }
}


fn runtime_binding_lookup_miss(key: EnvironmentBindingKey) -> Witness<RuntimeValue> {
  Violates {
    diagnostic: eval_diagnostic(
      reason: eval_rejected_runtime_binding_lookup_miss,
      node: key.declaration
    )
  }
}


fn empty_runtime_bindings() -> Map<EnvironmentBindingKey, RuntimeValue> {
  Map {
    lookup: runtime_binding_lookup_miss
  }
}


fn empty_evaluation_environment() -> EvaluationEnvironment {
  EvaluationEnvironment {
    bindings: empty_runtime_bindings()
  }
}


fn eval_runtime() -> V4EvaluatorRuntime {
  v4_evaluator_runtime_wave1()
}


fn eval_default_interpretation() -> InterpretationAlgebra {
  v4_evaluator_interpretation_wave1()
}


fn inferred_facts_witness_for_eval(tree: InferredTree, node: Node) -> Witness<InferredFacts> {
  tree.facts.lookup(node)
}


fn inferred_facts_for_eval(tree: InferredTree, node: Node) -> Outcome<InferredFacts> {
  match inferred_facts_witness_for_eval(tree: tree, node: node) {
    Holds { value: facts } =>
      if inferred_facts_resolved_type(facts: facts) != node {
        Rejected {
          diagnostics: diagnostics_singleton(
            d: eval_diagnostic(reason: eval_rejected_grounding_node_mismatch, node: node)
          )
        }
      } else if !canonical_grounding_admits_infer_facts(grounding: facts.grounding) {
        Rejected {
          diagnostics: diagnostics_singleton(
            d: eval_diagnostic(reason: eval_rejected_canonical_mismatch, node: node)
          )
        }
      } else {
        match inferred_facts_descent(facts: facts) {
          Holds { value: _ } =>
            Accepted { value: facts, diagnostics: None }
          Violates { diagnostic: d } =>
            Rejected { diagnostics: diagnostics_singleton(d: d) }
        }
      }
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


fn eval_structural_node_for_eval(tree: InferredTree, node: Node) -> Outcome<Node> {
  bind_outcome(
    o: inferred_facts_for_eval(tree: tree, node: node),
    f: fn(_facts) {
      Accepted { value: node, diagnostics: None }
    }
  )
}


fn eval_short_circuit_policy() -> StageDiagnosticPolicy {
  StageDiagnosticPolicy { accumulation: ShortCircuit }
}



fn eval_absorb_structural_child(
  acc: Outcome<Node>,
  child: Outcome<Node>
) -> Outcome<Node> {
  absorb_outcome_diagnostics(
    acc: acc,
    child: child,
    policy: eval_short_circuit_policy()
  )
}


fn control_transfer_value(
  control: ControlTransfer,
  node: Node,
  runtime: V4EvaluatorRuntime,
  environment: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  runtime.execution.control.terminal_value(
    control,
    EvaluationFrame { current: node, environment: environment }
  )
}


type RuntimeValueAcceptanceWitness {
  resolved_type: Witness<Node>
  inhabitance: Witness<InferredFacts>
  canonical: Witness<InferredFacts>
}


fn eval_runtime_value_acceptance_witness(
  node: Node,
  facts: InferredFacts,
  value: RuntimeValue
) -> RuntimeValueAcceptanceWitness {
  RuntimeValueAcceptanceWitness {
    resolved_type: if inferred_facts_resolved_type(facts: facts) == runtime_value_resolved_type(value: value) {
      Holds { value: runtime_value_resolved_type(value: value) }
    } else {
      Violates {
        diagnostic: eval_diagnostic(reason: eval_rejected_resolved_type_mismatch, node: node)
      }
    },
    inhabitance: if canonical_grounding_admits_infer_facts(grounding: facts.grounding) {
      Holds { value: facts }
    } else {
      Violates {
        diagnostic: eval_diagnostic(reason: eval_rejected_inhabitance_mismatch, node: node)
      }
    },
    canonical: if canonical_grounding_admits_infer_facts(grounding: facts.grounding) {
      Holds { value: facts }
    } else {
      Violates {
        diagnostic: eval_diagnostic(reason: eval_rejected_canonical_mismatch, node: node)
      }
    }
  }
}


fn eval_accept_runtime_value_with_facts(
  node: Node,
  facts: InferredFacts,
  value: RuntimeValue
) -> Outcome<RuntimeValue> {
  let witness = eval_runtime_value_acceptance_witness(node: node, facts: facts, value: value)
  match witness.resolved_type {
    Violates { diagnostic: d } => outcome_rejected(d: d)
    Holds { value: _ } => match witness.inhabitance {
      Violates { diagnostic: d } => outcome_rejected(d: d)
      Holds { value: _ } => match witness.canonical {
        Violates { diagnostic: d } => outcome_rejected(d: d)
        Holds { value: _ } => Accepted { value: value, diagnostics: None }
      }
    }
  }
}


fn eval_witness_outcome<T>(witness: Witness<T>) -> Outcome<T> {
  match witness {
    Holds { value: v } => Accepted { value: v, diagnostics: None }
    Violates { diagnostic: d } => outcome_rejected(d: d)
  }
}


fn eval_first_runtime_argument(args: List<RuntimeValue>, node: Node) -> Outcome<RuntimeValue> {
  eval_witness_outcome(
    witness: list_nth(
      xs: args,
      wanted: 0,
      absent: eval_diagnostic(reason: eval_rejected_branch_argument_absent, node: node)
    )
  )
}


fn eval_bind_value_argument(args: List<RuntimeValue>, node: Node) -> Outcome<RuntimeValue> {
  eval_witness_outcome(
    witness: list_nth(
      xs: args,
      wanted: 1,
      absent: eval_diagnostic(reason: eval_rejected_bind_value_absent, node: node)
    )
  )
}


fn eval_nth_child(node: Node, wanted: Int, absent_reason: Symbol) -> Outcome<Edge> {
  eval_witness_outcome(
    witness: list_nth(
      xs: node.children,
      wanted: wanted,
      absent: eval_diagnostic(reason: absent_reason, node: node)
    )
  )
}


fn eval_branch_condition_edge(node: Node) -> Outcome<Edge> {
  eval_nth_child(
    node: node,
    wanted: 0,
    absent_reason: eval_rejected_branch_argument_absent
  )
}


fn eval_bind_key(node: Node) -> Outcome<EnvironmentBindingKey> {
  bind_outcome(
    o: eval_nth_child(
      node: node,
      wanted: 0,
      absent_reason: eval_rejected_bind_key_absent
    ),
    f: fn(e) {
      Accepted {
        value: EnvironmentBindingKey { declaration: e.target },
        diagnostics: None
      }
    }
  )
}


fn eval_bind_value_edge(node: Node) -> Outcome<Edge> {
  eval_nth_child(
    node: node,
    wanted: 1,
    absent_reason: eval_rejected_bind_value_absent
  )
}


fn eval_bind_body(node: Node) -> Outcome<Node> {
  bind_outcome(
    o: eval_nth_child(
      node: node,
      wanted: 2,
      absent_reason: eval_rejected_bind_body_absent
    ),
    f: fn(e) {
      Accepted { value: e.target, diagnostics: None }
    }
  )
}


fn eval_value_node(
  node: Node,
  _args: List<RuntimeValue>,
  _facts: InferredFacts,
  _tree: InferredTree,
  interpreter: RuntimeBehaviorInterpreter,
  environment: EvaluationEnvironment,
  _runtime: V4EvaluatorRuntime
) -> Outcome<RuntimeValue> {
  match interpreter {
    ValueRuntimeInterpreter { interpreter: value } =>
      value.allocate_literal(node, environment)
    _ => outcome_rejected(d: eval_diagnostic(reason: eval_rejected_type_node, node: node))
  }
}


fn eval_transform_node(
  node: Node,
  args: List<RuntimeValue>,
  _facts: InferredFacts,
  _tree: InferredTree,
  interpreter: RuntimeBehaviorInterpreter,
  environment: EvaluationEnvironment,
  _runtime: V4EvaluatorRuntime
) -> Outcome<RuntimeValue> {
  match interpreter {
    TransformRuntimeInterpreter { interpreter: transform } =>
      transform.call_primitive(node, args, environment)
    _ => outcome_rejected(d: eval_diagnostic(reason: eval_rejected_type_node, node: node))
  }
}


fn eval_branch_node(
  node: Node,
  args: List<RuntimeValue>,
  _facts: InferredFacts,
  tree: InferredTree,
  interpretation: InterpretationAlgebra,
  interpreter: RuntimeBehaviorInterpreter,
  environment: EvaluationEnvironment,
  runtime: V4EvaluatorRuntime
) -> Outcome<RuntimeValue> {
  match interpreter {
    BranchRuntimeInterpreter { interpreter: branch } =>
      bind_outcome(
        o: eval_first_runtime_argument(args: args, node: node),
        f: fn(condition) {
          bind_outcome(
            o: branch.choose_branch(node, condition, environment),
            f: fn(chosen) {
              eval_runtime_node(
                node: chosen,
                tree: tree,
                interpretation: interpretation,
                environment: environment,
                runtime: runtime
              )
            }
          )
        }
      )
    _ => outcome_rejected(d: eval_diagnostic(reason: eval_rejected_type_node, node: node))
  }
}


fn eval_loop_node(
  node: Node,
  _args: List<RuntimeValue>,
  _facts: InferredFacts,
  _tree: InferredTree,
  interpreter: RuntimeBehaviorInterpreter,
  environment: EvaluationEnvironment,
  runtime: V4EvaluatorRuntime
) -> Outcome<RuntimeValue> {
  match interpreter {
    LoopRuntimeInterpreter { interpreter: loop_interpreter } =>
      bind_outcome(
        o: loop_interpreter.step_loop(node, environment),
        f: fn(control) {
          control_transfer_value(
            control: control,
            node: node,
            runtime: runtime,
            environment: environment
          )
        }
      )
    _ => outcome_rejected(d: eval_diagnostic(reason: eval_rejected_type_node, node: node))
  }
}


fn eval_bind_node(
  node: Node,
  args: List<RuntimeValue>,
  _facts: InferredFacts,
  tree: InferredTree,
  interpretation: InterpretationAlgebra,
  interpreter: RuntimeBehaviorInterpreter,
  environment: EvaluationEnvironment,
  runtime: V4EvaluatorRuntime
) -> Outcome<RuntimeValue> {
  match interpreter {
    BindRuntimeInterpreter { interpreter: bind } =>
      bind_outcome(
        o: eval_bind_key(node: node),
        f: fn(key) {
          bind_outcome(
            o: eval_bind_value_argument(args: args, node: node),
            f: fn(bound_value) {
              bind_outcome(
                o: bind.bind_value(key, bound_value, environment),
                f: fn(bound_environment) {
                  bind_outcome(
                    o: eval_bind_body(node: node),
                    f: fn(body) {
                      eval_runtime_node(
                        node: body,
                        tree: tree,
                        interpretation: interpretation,
                        environment: bound_environment,
                        runtime: runtime
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    _ => outcome_rejected(d: eval_diagnostic(reason: eval_rejected_type_node, node: node))
  }
}


fn eval_computation_node(
  behavior: Behavior,
  node: Node,
  args: List<RuntimeValue>,
  facts: InferredFacts,
  tree: InferredTree,
  interpretation: InterpretationAlgebra,
  environment: EvaluationEnvironment,
  runtime: V4EvaluatorRuntime
) -> Outcome<RuntimeValue> {
  let dispatch = interpretation_behavior_dispatch(
    interpretation: interpretation,
    behavior: behavior
  )
  bind_outcome(
    o: match dispatch {
      ValueRuntimeInterpreter { interpreter: _ } =>
        eval_value_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime
        )
      TransformRuntimeInterpreter { interpreter: _ } =>
        eval_transform_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime
        )
      BranchRuntimeInterpreter { interpreter: _ } =>
        eval_branch_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpretation: interpretation,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime
        )
      LoopRuntimeInterpreter { interpreter: _ } =>
        eval_loop_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime
        )
      BindRuntimeInterpreter { interpreter: _ } =>
        eval_bind_node(
          node: node,
          args: args,
          facts: facts,
          tree: tree,
          interpretation: interpretation,
          interpreter: dispatch,
          environment: environment,
          runtime: runtime
        )
    },
    f: fn(value) {
      eval_accept_runtime_value_with_facts(node: node, facts: facts, value: value)
    }
  )
}


fn eval_interpret_node(
  node: Node,
  args: List<RuntimeValue>,
  tree: InferredTree,
  interpretation: InterpretationAlgebra,
  environment: EvaluationEnvironment,
  runtime: V4EvaluatorRuntime
) -> Outcome<RuntimeValue> {
  bind_outcome(
    o: inferred_facts_for_eval(tree: tree, node: node),
    f: fn(facts) {
      match node.kind {
        ComputationNode { behavior: b } =>
          eval_computation_node(
            behavior: b,
            node: node,
            args: args,
            facts: facts,
            tree: tree,
            interpretation: interpretation,
            environment: environment,
            runtime: runtime
          )
        TypeNode { connective: _ } =>
          outcome_rejected(
            d: eval_diagnostic(reason: eval_rejected_type_node, node: node)
          )
      }
    }
  )
}


fn empty_runtime_values() -> List<RuntimeValue> {
  []
}


fn eval_edge_is_runtime_argument(edge: Edge) -> Bool {
  is_positional(e: edge)
}


fn eval_fold_state_value(state: EvalFoldState) -> Outcome<RuntimeValue> {
  state.value
}


fn eval_absorb_child_diagnostics(
  acc: Outcome<List<RuntimeValue>>,
  child: Outcome<Node>
) -> Outcome<List<RuntimeValue>> {
  absorb_outcome_diagnostics(
    acc: acc,
    child: child,
    policy: eval_short_circuit_policy()
  )
}


fn eval_append_child_value(
  acc: Outcome<List<RuntimeValue>>,
  child: Outcome<RuntimeValue>
) -> Outcome<List<RuntimeValue>> {
  append_outcome_value(
    acc: acc,
    child: child,
    policy: eval_short_circuit_policy()
  )
}


fn eval_fold_init(
  node: Node,
  tree: InferredTree,
  interpretation: InterpretationAlgebra,
  environment: EvaluationEnvironment,
  runtime: V4EvaluatorRuntime
) -> EvalFoldState {
  let progress = if count(node.children) == 0 { ReadyToInterpret } else { AwaitingChildren { processed: 0 } }
  EvalFoldState {
    node: node,
    progress: progress,
    structural: eval_structural_node_for_eval(tree: tree, node: node),
    child_values: Accepted { value: empty_runtime_values(), diagnostics: None },
    value: if count(node.children) == 0 {
      eval_interpret_node(
        node: node,
        args: empty_runtime_values(),
        tree: tree,
        interpretation: interpretation,
        environment: environment,
        runtime: runtime
      )
    } else {
      outcome_rejected(
        d: eval_diagnostic(reason: eval_rejected_pending_children, node: node)
      )
    }
  }
}


fn eval_maybe_complete_node(
  node: Node,
  progress: EvalProgress,
  args: List<RuntimeValue>,
  tree: InferredTree,
  interpretation: InterpretationAlgebra,
  environment: EvaluationEnvironment,
  runtime: V4EvaluatorRuntime,
  pending: Outcome<RuntimeValue>
) -> Outcome<RuntimeValue> {
  match progress {
    ReadyToInterpret =>
      eval_interpret_node(
        node: node,
        args: args,
        tree: tree,
        interpretation: interpretation,
        environment: environment,
        runtime: runtime
      )
    Interpreted => pending
    AwaitingChildren { processed: _ } => pending
  }
}


fn eval_advance_progress(progress: EvalProgress, node: Node) -> EvalProgress {
  match progress {
    AwaitingChildren { processed: p } => {
      let processed = p + 1
      if processed == count(node.children) { ReadyToInterpret } else { AwaitingChildren { processed: processed } }
    }
    ReadyToInterpret => Interpreted
    Interpreted => Interpreted
  }
}


fn eval_fold_step(
  acc: EvalFoldState,
  edge: Edge,
  child: EvalFoldState,
  tree: InferredTree,
  interpretation: InterpretationAlgebra,
  environment: EvaluationEnvironment,
  runtime: V4EvaluatorRuntime
) -> EvalFoldState {
  let structural = eval_absorb_structural_child(acc: acc.structural, child: child.structural)
  let next_args = if eval_edge_is_runtime_argument(edge: edge) {
    eval_append_child_value(acc: acc.child_values, child: child.value)
  } else {
    eval_absorb_child_diagnostics(acc: acc.child_values, child: child.structural)
  }
  let progress = eval_advance_progress(progress: acc.progress, node: acc.node)
  EvalFoldState {
    node: acc.node,
    progress: progress,
    structural: structural,
    child_values: next_args,
    value: bind_outcome(
      o: structural,
      f: fn(_) {
        bind_outcome(
          o: next_args,
          f: fn(args) {
            eval_maybe_complete_node(
              node: acc.node,
              progress: progress,
              args: args,
              tree: tree,
              interpretation: interpretation,
              environment: environment,
              runtime: runtime,
              pending: acc.value
            )
          }
        )
      }
    )
  }
}


fn eval_runtime_node(
  node: Node,
  tree: InferredTree,
  interpretation: InterpretationAlgebra,
  environment: EvaluationEnvironment,
  runtime: V4EvaluatorRuntime
) -> Outcome<RuntimeValue> {
  let folded = fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) {
        eval_fold_init(
          node: n0,
          tree: tree,
          interpretation: interpretation,
          environment: environment,
          runtime: runtime
        )
      },
      step: fn(acc, e, child) {
        eval_fold_step(
          acc: acc,
          edge: e,
          child: child,
          tree: tree,
          interpretation: interpretation,
          environment: environment,
          runtime: runtime
        )
      }
    }
  )
  eval_fold_state_value(state: folded)
}


fn eval(tree: InferredTree, interpretation: InterpretationAlgebra, inputs: Inputs) -> Outcome<RuntimeValue> {
  if well_formed(n: tree.root) {
    if well_formed(n: inputs.root) {
      eval_runtime_node(
        node: inputs.root,
        tree: tree,
        interpretation: interpretation,
        environment: empty_evaluation_environment(),
        runtime: eval_runtime()
      )
    } else {
      Rejected { diagnostics: diagnostics_singleton(d: eval_diagnostic(reason: eval_rejected_invalid_node, node: inputs.root)) }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: eval_diagnostic(reason: eval_rejected_invalid_node, node: tree.root)) }
  }
}


fn eval_node(tree: InferredTree, inputs: Inputs) -> Outcome<Node> {
  bind_outcome(
    o: eval(tree: tree, interpretation: eval_default_interpretation(), inputs: inputs),
    f: fn(value) {
      match runtime_value_node_projection(value: value) {
        RuntimeValueNodeProjected { node: n } =>
          Accepted { value: n, diagnostics: None }
        RuntimeValueNodeUnrepresentable =>
          outcome_rejected(
            d: eval_diagnostic(
              reason: eval_rejected_runtime_value_node_unrepresentable,
              node: inputs.root
            )
          )
      }
    }
  )
}


fn run_test_claim_assert(
  claim: TestClaim,
  actual: Outcome<Node>,
  at: Node
) -> Verdict<Node> {
  run_test_claim_assert_decided(claim: claim, actual: actual, at: at)
}


fn run_test_claim_assert_decided(
  claim: TestClaim,
  actual: Outcome<Node>,
  at: Node
) -> Verdict<Node> {
  match claim {
    EqualsClaim { rhs: rhs, label: _, anchor: _, lhs: _, classification: _ } =>
      if outcome_node_eq(a: actual, b: Accepted { value: rhs, diagnostics: None }) {
        Pass
      } else {
        Fail { actual: actual }
      }
    CompilesClaim { expected_value: expected, label: _, anchor: _, input: _, classification: _ } =>
      if outcome_node_eq(
        a: actual,
        b: Accepted { value: expected, diagnostics: None }
      ) {
        Pass
      } else {
        Fail { actual: actual }
      }
    RoundTripClaim { input: input, label: _, anchor: _, classification: _ } =>
      Deferred {
        actual: actual,
        diagnostic: eval_diagnostic(reason: eval_rejected_roundtrip_deferred, node: input)
      }
    DiagnosticClaim { expected_rejection: expected, input: input, label: _, anchor: _, classification: _ } =>
      match actual {
        Rejected { diagnostics: _ } =>
          if outcome_node_eq(a: actual, b: Rejected { diagnostics: expected }) {
            Pass
          } else {
            Fail { actual: actual }
          }
        _ => Fail { actual: actual }
      }
  }
}


fn runtime_value_eq(a: RuntimeValue, b: RuntimeValue) -> Bool {
  a == b
}


fn outcome_runtime_value_eq(a: Outcome<RuntimeValue>, b: Outcome<RuntimeValue>) -> Bool {
  outcome_eq(a: a, b: b, payload_eq: runtime_value_eq)
}


fn accepted_runtime_value_outcome_eq(a: Outcome<RuntimeValue>, b: Outcome<RuntimeValue>) -> Bool {
  match b {
    Accepted { value: _, diagnostics: _ } => outcome_runtime_value_eq(a: a, b: b)
    Rejected { diagnostics: _ } => false
  }
}


fn run_test_claim_runtime_assert(
  claim: TestClaim,
  tree: InferredTree,
  interpretation: InterpretationAlgebra,
  actual: Outcome<RuntimeValue>,
  at: Node
) -> Verdict<RuntimeValue> {
  match claim {
    EqualsClaim { rhs: rhs, label: _, anchor: _, lhs: _, classification: _ } => {
      let expected = eval(tree: tree, interpretation: interpretation, inputs: Inputs { root: rhs })
      if accepted_runtime_value_outcome_eq(a: actual, b: expected) {
        Pass
      } else {
        Fail { actual: actual }
      }
    }
    CompilesClaim { expected_value: expected, label: _, anchor: _, input: _, classification: _ } => {
      let expected_outcome = eval(tree: tree, interpretation: interpretation, inputs: Inputs { root: expected })
      if accepted_runtime_value_outcome_eq(a: actual, b: expected_outcome) {
        Pass
      } else {
        Fail { actual: actual }
      }
    }
    RoundTripClaim { input: input, label: _, anchor: _, classification: _ } =>
      Deferred {
        actual: actual,
        diagnostic: eval_diagnostic(reason: eval_rejected_roundtrip_deferred, node: input)
      }
    DiagnosticClaim { expected_rejection: expected, input: _, label: _, anchor: _, classification: _ } =>
      match actual {
        Rejected { diagnostics: _ } =>
          if outcome_runtime_value_eq(a: actual, b: Rejected { diagnostics: expected }) {
            Pass
          } else {
            Fail { actual: actual }
          }
        _ => Fail { actual: actual }
      }
  }
}


// Fail-closed: any Deferred or Fail in the list blocks Pass; [] is Fail (no fabricated Pass).
// Empty-case policy: Fail with eval_empty_verdict_list diagnostic (context-specific at-node).
fn aggregate_verdicts<T>(rs: List<Verdict<T>>, at: Node) -> Verdict<T> {
  verdict_fold(
    rs: rs,
    empty_verdict: Fail {
      actual: outcome_rejected(
        d: eval_diagnostic(reason: eval_empty_verdict_list, node: at)
      )
    }
  )
}


// 🟡 gated — feature:T22-EVAL-CACHE-HASHES — bind IRT-4 — claim_hash/interpretation_hash are staging placeholders, NOT cache-validating authority; dissolve-on: B1 content_hash derivation replaces caller-supplied hashes.
fn run_test_claim(
  subject: TestClaimEvalSubject<Node>,
  claim_hash: Hash,
  interpretation_hash: Hash
) -> TestClaimRun<Node, RuntimeValue> {
  let actual = eval(
    tree: subject.tree,
    interpretation: subject.context.interpretation,
    inputs: Inputs { root: subject.input.evaluator_input }
  )
  let at = test_claim_input(c: subject.claim)
  TestClaimRun {
    cache: test_claim_cache_receipt(
      subject: subject,
      claim_hash: claim_hash,
      interpretation_hash: interpretation_hash
    ),
    verdict: aggregate_verdicts(
      rs: [
        run_test_claim_runtime_assert(
          claim: subject.claim,
          tree: subject.tree,
          interpretation: subject.context.interpretation,
          actual: actual,
          at: at
        )
      ],
      at: at
    )
  }
}


fn eval_test_claim_subject(
  claim: TestClaim,
  context: EvalContext,
  tree: InferredTree
) -> TestClaimEvalSubject<Node> {
  TestClaimEvalSubject {
    claim: claim,
    context: context,
    tree: tree,
    input: TestClaimTypedInput { evaluator_input: test_claim_input(c: claim) }
  }
}
