// src/v4/compiler/04_infer.dag
// Scope: Stage 4 — ResolvedTree -> InferredTree; bounded Find phase (DECISIONS C1 / IR-1).
// Status: T-9 modeled — coercion substrate in std/coercion.dag. Option B: canonical_grounding_from_inferred_facts fails-closed on bare-Atom algebra references (bridge-symbol guard).
// Anchor: https://en.wikipedia.org/wiki/Type_inference

module v4.compiler.infer

import v4.std.algebra { list_snoc_item }
import v4.std.bounded_lattice_completeness {
  infer_bounded_lattice_consumer_gate,
  partial_bounded_lattice_instances_in_tree
}
import v4.compiler.resolve { ResolvedTree }
import v4.std.cardinality { TerminationProof, termination_proof_witness_for_node }
import v4.std.collection { List, Map }
import v4.std.constraints {
  CanonicalGrounding,
  CanonicalGroundingWitness,
  ConstraintGraph,
  ConstraintSolvePolicy,
  solve_constraints
}
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  node_locus,
  Outcome,
  Unavailable,
  Accepted,
  None,
  Rejected,
  Suggested,
  bind_outcome,
  diagnostics_merge,
  diagnostics_singleton,
  non_empty_diagnostics_append,
  outcome_rejected,
  outcome_accepted,
  rejected_with_pending
}
import v4.std.logic { Bool }
import v4.std.node {
  Atom,
  ComputationNode,
  Edge,
  Named,
  Node,
  NodeFold,
  Positional,
  Symbol,
  TypeNode,
  fold_node,
  well_formed
}
import v4.std.witness { Holds, Violates, Witness }

// AlgebraRef is the typed IR-1 bridge for algebra inhabitance coordinates.
type AlgebraRef {
  algebra: Node
  witness: Node
}

// Practice 2: InferredFacts bundles CanonicalGrounding + descent. std/constraints.dag
// CanonicalGrounding is not yet proof-by-construction (scaffold:T-9-ground) — infer
// enforces admission at construction and re-export via canonical_grounding_admits_infer_facts
// until std/constraints lands a structural carrier for node/witness/closedness alignment.
type InferredFacts {
  grounding: CanonicalGrounding
  descent: Witness<TerminationProof>
}

// Subject node (map key / grounding.node) vs resolved value type (structural algebra witness).
fn inferred_facts_resolved_type(facts: InferredFacts) -> Node {
  facts.grounding.witness.structural.evidence
}

fn inferred_facts_algebra_ref(facts: InferredFacts) -> AlgebraRef {
  algebra_ref_from_grounding(grounding: facts.grounding)
}

fn inferred_facts_canonical_witness(facts: InferredFacts) -> CanonicalGroundingWitness {
  facts.grounding.witness
}

fn inferred_facts_descent(facts: InferredFacts) -> Witness<TerminationProof> {
  facts.descent
}

type InferredTree {
  root: Node
  facts: Map<Node, InferredFacts>
}

type InferredFactsEntry {
  node: Node
  facts: InferredFacts
}

data infer_descent_not_derived: Symbol = infer_descent_not_derived
data infer_facts_lookup_miss: Symbol = infer_facts_lookup_miss
data infer_canonical_grounding_incoherent: Symbol = infer_canonical_grounding_incoherent
// 🟢 SM5-satisfied: v2 bootstrap on src/v4 emits 0 infer_algebra_ref_ungrounded diagnostics (2026-05-26); guard dissolves when T-4 Wave 2b/T-2 populate AlgebraRef from grounded algebra Node constructors.
data infer_algebra_ref_ungrounded: Symbol = infer_algebra_ref_ungrounded

// §1-tail A4 disposition (post-#4692): Practice-12 `_bounded` fuel residue = 0 in this stage.
// SG-6 BoundedLattice gather/gate → fuel-delete: rows in v4.std.bounded_lattice_completeness
// (fold_node owns traversal; fold_init/fold_step are algebra rows, not fuel).
// Constraint solve → kernel-mark: solve_constraints in v4.std.constraints (fixpoint; call-graph ≠ data-graph).

fn infer_facts_lookup_miss_diagnostic(key: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_facts_lookup_miss,
    at: node_locus(node: key),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn infer_canonical_grounding_incoherent_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_canonical_grounding_incoherent,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn infer_algebra_ref_ungrounded_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_algebra_ref_ungrounded,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// 🟡 gated — feature:infer-algebra-ref-grounding-fold — bind v4.compiler.infer://algebra-ref-grounded — dissolve-on-arrival: std/node.dag or std/model_core.dag exports the canonical grounded-algebra query.
fn algebra_ref_is_grounded(algebra: Node) -> Bool {
  match algebra.kind {
    TypeNode { connective: c } =>
      match c {
        Atom { identity: _ } => false
        _ => true
      }
    ComputationNode { behavior: _ } => false
  }
}

fn infer_descent_not_derived_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: infer_descent_not_derived,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

// SPI-3: infer owns the reason symbol; substrate/cardinality owns the failing locus (fold preserves child Violates).
fn infer_descent_witness_for_node(n: Node) -> Witness<TerminationProof> {
  match termination_proof_witness_for_node(n: n) {
    Holds { value: proof } => Holds { value: proof }
    Violates { diagnostic: upstream } =>
      Violates {
        diagnostic: infer_descent_not_derived_diagnostic(at: upstream.at)
      }
  }
}

fn algebra_ref_from_grounding(grounding: CanonicalGrounding) -> AlgebraRef {
  AlgebraRef {
    algebra: grounding.witness.structural.evidence,
    witness: grounding.node
  }
}

// Infer admission gate — not a post-hoc InferredFacts field patch. Validates the
// algebra_ref_from_grounding / closedness alignment CanonicalGrounding must satisfy
// before infer accepts or re-exports grounding as authoritative.
fn canonical_grounding_admits_infer_facts(grounding: CanonicalGrounding) -> Bool {
  well_formed(n: grounding.node)
    && well_formed(n: grounding.witness.structural.evidence)
    && (grounding.witness.structural.property == ^constraint_property_being_canonical)
    && (grounding.witness.closedness.property == ^constraint_property_candidate_set_closedness)
    && (grounding.witness.closedness.evidence == grounding.node)
}

fn inferred_facts_construction(
  grounding: CanonicalGrounding,
  descent: Witness<TerminationProof>,
) -> Outcome<InferredFacts> {
  if canonical_grounding_admits_infer_facts(grounding: grounding) {
    Accepted {
      value: InferredFacts {
        grounding: grounding,
        descent: descent
      },
      diagnostics: None
    }
  } else {
    outcome_rejected(
      infer_canonical_grounding_incoherent_diagnostic(node: grounding.node)
    )
  }
}

fn inferred_facts_from_grounding(
  grounding: CanonicalGrounding,
  descent: Witness<TerminationProof>,
) -> Outcome<InferredFacts> {
  inferred_facts_construction(grounding: grounding, descent: descent)
}

fn empty_inferred_facts_entry_list() -> List<InferredFactsEntry> {
  []
}

fn concat_inferred_facts_entries(
  a: List<InferredFactsEntry>,
  b: List<InferredFactsEntry>,
) -> List<InferredFactsEntry> {
  fold(b, init: a, f: fn(acc, entry) {
    list_snoc_item(xs: acc, item: entry)
  })
}

fn infer_constraint_graph(n: Node) -> ConstraintGraph {
  ConstraintGraph { root: n }
}

fn infer_node_facts(n: Node, partials: List<Node>) -> Outcome<InferredFacts> {
  match infer_bounded_lattice_consumer_gate(consumer: n, partials: partials) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: _, diagnostics: cd } =>
      match infer_descent_witness_for_node(n: n) {
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
        Holds { value: descent_proof } =>
          bind_outcome(
            o: solve_constraints(
              policy: ConstraintSolvePolicy {
                graph: infer_constraint_graph(n: n)
              }
            ),
            f: fn(grounding) {
              inferred_facts_from_grounding(
                grounding: grounding,
                descent: Holds { value: descent_proof }
              )
            }
          )
      }
  }
}

fn lookup_inferred_facts_in_entries(
  entries: List<InferredFactsEntry>,
  key: Node,
) -> Witness<InferredFacts> {
  fold(
    entries,
    init: Violates {
      diagnostic: infer_facts_lookup_miss_diagnostic(key: key)
    },
    f: fn(acc, entry) {
      match acc {
        Holds { value: _ } => acc
        Violates { diagnostic: _ } =>
          if entry.node == key {
            Holds { value: entry.facts }
          } else {
            acc
          }
      }
    }
  )
}

// Fail-closed map construction: rejects (with diagnostic) any entry where node != facts.grounding.node.
// admitted_inferred_facts_entry is the primary enforcement point; this function is the secondary
// fail-closed gate — it makes invariant violations visible as Rejected rather than silently dropping them.
fn facts_map_from_entries(entries: List<InferredFactsEntry>) -> Outcome<Map<Node, InferredFacts>> {
  match fold(entries, init: Accepted { value: empty_inferred_facts_entry_list(), diagnostics: None }, f: fn(acc, entry) {
    match acc {
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
      Accepted { value: ok_entries, diagnostics: d } =>
        if entry.node == entry.facts.grounding.node {
          Accepted { value: list_snoc_item(xs: ok_entries, item: entry), diagnostics: d }
        } else {
          Rejected {
            diagnostics: diagnostics_singleton(
              d: infer_canonical_grounding_incoherent_diagnostic(node: entry.node)
            )
          }
        }
    }
  }) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: admitted, diagnostics: d } =>
      Accepted {
        value: Map {
          lookup: fn(key) {
            lookup_inferred_facts_in_entries(entries: admitted, key: key)
          }
        },
        diagnostics: d
      }
  }
}

fn inferred_facts_witness_for_node(tree: InferredTree, node: Node) -> Witness<InferredFacts> {
  tree.facts.lookup(node)
}

fn canonical_grounding_from_inferred_facts(
  node: Node,
  facts: InferredFacts,
) -> Outcome<CanonicalGrounding> {
  if node != facts.grounding.node {
    outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
  } else if !algebra_ref_is_grounded(algebra: inferred_facts_algebra_ref(facts: facts).algebra) {
    outcome_rejected(infer_algebra_ref_ungrounded_diagnostic(node: node))
  } else if canonical_grounding_admits_infer_facts(grounding: facts.grounding) {
    Accepted {
      value: facts.grounding,
      diagnostics: None
    }
  } else {
    outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
  }
}

// RULING-1: infer-authored canonical witness only — no compiler-side fabrication (INVARIANTS P3).
fn canonical_grounding_for_node(tree: InferredTree, node: Node) -> Outcome<CanonicalGrounding> {
  match inferred_facts_witness_for_node(tree: tree, node: node) {
    Holds { value: facts } =>
      canonical_grounding_from_inferred_facts(node: node, facts: facts)
    Violates { diagnostic: d } =>
      outcome_rejected(d)
  }
}

// Construction guard: enforces node == facts.grounding.node before admitting an entry.
// Prevents an InferredFactsEntry where the map key diverges from the grounding subject.
fn admitted_inferred_facts_entry(node: Node, facts: InferredFacts) -> Outcome<InferredFactsEntry> {
  if node == facts.grounding.node {
    Accepted {
      value: InferredFactsEntry { node: node, facts: facts },
      diagnostics: None
    }
  } else {
    outcome_rejected(infer_canonical_grounding_incoherent_diagnostic(node: node))
  }
}

// Outcome threading over fold_node until Ratified Q4 traverse_node lands (std/diagnostic.dag).
fn infer_entries_for_tree(tree: ResolvedTree) -> Outcome<List<InferredFactsEntry>> {
  let partials = partial_bounded_lattice_instances_in_tree(tree: tree)
  fold_node(
    n: tree,
    algebra: NodeFold {
      init: fn(n0) {
        match infer_node_facts(n: n0, partials: partials) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: facts, diagnostics: d } =>
            match admitted_inferred_facts_entry(node: n0, facts: facts) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: entry, diagnostics: ed } =>
                Accepted {
                  value: [entry],
                  diagnostics: diagnostics_merge(outer: d, inner: ed)
                }
            }
        }
      },
      step: fn(acc, e, child) {
        match acc {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: acc_entries, diagnostics: ad } =>
            match child {
              Rejected { diagnostics: cr } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: ad, rejected: cr)
                }
              Accepted { value: child_entries, diagnostics: cd } =>
                Accepted {
                  value: concat_inferred_facts_entries(a: acc_entries, b: child_entries),
                  diagnostics: diagnostics_merge(outer: ad, inner: cd)
                }
            }
        }
      }
    }
  )
}

fn infer(tree: ResolvedTree) -> Outcome<InferredTree> {
  match infer_entries_for_tree(tree: tree) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: entries, diagnostics: d } =>
      match facts_map_from_entries(entries: entries) {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: facts_map, diagnostics: md } =>
          Accepted {
            value: InferredTree {
              root: tree,
              facts: facts_map
            },
            diagnostics: diagnostics_merge(outer: d, inner: md)
          }
      }
  }
}
