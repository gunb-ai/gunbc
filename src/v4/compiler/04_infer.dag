// src/v4/compiler/04_infer.dag
// Scope: Stage 4 — ResolvedTree -> InferredTree; bounded Find phase (DECISIONS C1 / IR-1).
// Owns: AlgebraRef, InferredFacts, InferredTree, infer.
// Consumes: v4.compiler.resolve, v4.std.cardinality, v4.std.collection, v4.std.constraints, v4.std.diagnostic, v4.std.node, v4.std.witness.
// Status: Wave-3-A T-9 — staged fail-closed: descent Violates per node before solve_constraints; Holds path wires solve_constraints → find_witness(UniqueOnly) + AlgebraRef bridge (live once cardinality propagation lands).
// Anchor: https://en.wikipedia.org/wiki/Type_inference


module v4.compiler.infer


import v4.compiler.resolve { ResolvedTree }
import v4.std.cardinality { TerminationProof }
import v4.std.collection { List, Map }
import v4.std.constraints {
  CanonicalGrounding,
  ConstraintGraph,
  ConstraintSolvePolicy,
  solve_constraints
}
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  NodeLocus,
  Outcome,
  Unavailable,
  Accepted,
  None,
  Rejected,
  bind_outcome,
  diagnostics_merge,
  diagnostics_singleton,
  rejected_with_pending
}
import v4.std.node {
  Edge,
  Node,
  NodeFold,
  Symbol,
  fold_node
}
import v4.std.witness { Holds, StructuralPropertyWitness, Violates, Witness }


// RULING-1: needs-more-work — typed bridge until algebra inhabitance authority lands.
type AlgebraRef {
  algebra: Node
  witness: Node
}


// RULING-1: needs-more-work — inhabitance coordinates remain T-9 bridged.
type InferredFacts {
  resolved_type: Node
  inhabits: AlgebraRef
  descent: Witness<TerminationProof>
  canonical: StructuralPropertyWitness
}


// RULING-1: needs-more-work — per-node fact table shape is present; producer semantics are T-9.
type InferredTree {
  root: Node
  facts: Map<Node, InferredFacts>
}


type InferredFactsEntry {
  node: Node
  facts: InferredFacts
}


data infer_descent_not_derived: Symbol = infer_descent_not_derived
data infer_facts_lookup_miss: Symbol = infer_facts_lookup_miss


fn infer_facts_lookup_miss_diagnostic(key: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_facts_lookup_miss,
    at: NodeLocus { node: key },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn infer_descent_not_derived_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: infer_descent_not_derived,
    at: NodeLocus { node: n },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// 🟡 coproduct dissolution — scaffold:T-9-descent-bridge · dissolve-on: cardinality propagation derives TerminationProof per node.
fn infer_descent_witness_for_node(n: Node) -> Witness<TerminationProof> {
  Violates {
    diagnostic: infer_descent_not_derived_diagnostic(n: n)
  }
}


fn algebra_ref_from_grounding(grounding: CanonicalGrounding) -> AlgebraRef {
  AlgebraRef {
    algebra: grounding.witness.structural.evidence,
    witness: grounding.node
  }
}


fn infer_constraint_graph(n: Node) -> ConstraintGraph {
  ConstraintGraph { root: n }
}


fn inferred_facts_from_grounding(
  n: Node,
  grounding: CanonicalGrounding,
  descent: Witness<TerminationProof>,
) -> InferredFacts {
  InferredFacts {
    resolved_type: grounding.node,
    inhabits: algebra_ref_from_grounding(grounding: grounding),
    descent: descent,
    canonical: grounding.witness.structural
  }
}


fn concat_inferred_facts_entries(
  a: List<InferredFactsEntry>,
  b: List<InferredFactsEntry>,
) -> List<InferredFactsEntry> {
  fold(b, init: a, f: fn(acc, entry) {
    list_push(acc, entry)
  })
}


fn infer_node_facts(n: Node) -> Outcome<InferredFacts> {
  match infer_descent_witness_for_node(n: n) {
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
    Holds { value: descent_proof } =>
      bind_outcome(
        o: solve_constraints(
          policy: ConstraintSolvePolicy {
            graph: infer_constraint_graph(n: n)
          }
        ),
        f: fn(grounding) {
          Accepted {
            value: inferred_facts_from_grounding(
              n: n,
              grounding: grounding,
              descent: Holds { value: descent_proof }
            ),
            diagnostics: None
          }
        }
      )
  }
}


fn lookup_inferred_facts_in_entries(
  entries: List<InferredFactsEntry>,
  key: Node,
) -> Witness<InferredFacts> {
  fold(
    entries,
    init: Violates {
      diagnostic: infer_facts_lookup_miss_diagnostic(key: key)
    },
    f: fn(acc, entry) {
      match acc {
        Holds { value: _ } => acc
        Violates { diagnostic: _ } =>
          if entry.node == key {
            Holds { value: entry.facts }
          } else {
            acc
          }
      }
    }
  )
}


fn facts_map_from_entries(entries: List<InferredFactsEntry>) -> Map<Node, InferredFacts> {
  Map {
    lookup: fn(key) {
      lookup_inferred_facts_in_entries(entries: entries, key: key)
    }
  }
}


fn infer_entries_fold_init(n: Node) -> Outcome<List<InferredFactsEntry>> {
  match infer_node_facts(n: n) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: facts, diagnostics: d } =>
      Accepted {
        value: [InferredFactsEntry { node: n, facts: facts }],
        diagnostics: d
      }
  }
}


// Outcome threading over fold_node until Ratified Q4 traverse_node lands (std/diagnostic.dag).
fn infer_entries_fold_step(
  acc: Outcome<List<InferredFactsEntry>>,
  e: Edge,
  child: Outcome<List<InferredFactsEntry>>,
) -> Outcome<List<InferredFactsEntry>> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: acc_entries, diagnostics: ad } =>
      match child {
        Rejected { diagnostics: cr } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: ad, rejected: cr)
          }
        Accepted { value: child_entries, diagnostics: cd } =>
          Accepted {
            value: concat_inferred_facts_entries(a: acc_entries, b: child_entries),
            diagnostics: diagnostics_merge(outer: ad, inner: cd)
          }
      }
  }
}


fn infer_entries_for_tree(tree: ResolvedTree) -> Outcome<List<InferredFactsEntry>> {
  fold_node(
    n: tree,
    algebra: NodeFold {
      init: fn(n0) {
        infer_entries_fold_init(n: n0)
      },
      step: fn(acc, e, child) {
        infer_entries_fold_step(acc: acc, e: e, child: child)
      }
    }
  )
}


fn infer(tree: ResolvedTree) -> Outcome<InferredTree> {
  match infer_entries_for_tree(tree: tree) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: entries, diagnostics: d } =>
      Accepted {
        value: InferredTree {
          root: tree,
          facts: facts_map_from_entries(entries: entries)
        },
        diagnostics: d
      }
  }
}
