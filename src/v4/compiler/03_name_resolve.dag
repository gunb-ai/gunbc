// src/v4/compiler/03_name_resolve.dag
//
// Scope: Stage 3c — module-root admission for cross-file resolution.
// Status: T-28-B modeled — graph admission is outside K-1 single-tree resolver.
// Anchor: https://en.wikipedia.org/wiki/Name_resolution_(programming_languages)

module v4.compiler.name_resolve


import v4.compiler.normalize { NormalizedTree }
import v4.compiler.resolve {
  DeclaredBinding,
  Namespace,
  ResolvedTree,
  resolve_with_namespace,
  try_edge_declared_binding
}
import v4.extdeps.languages.dag {
  DagLanguageModel,
  dag_language_model_canonical_symbols,
  dag_surface_module_header_metadata_edge,
  qualified_name_from_module_node
}
import v4.std.algebra { Cons, Empty, FreeMonoid }
import v4.std.collection { Absent, Map, Present, empty_map, map_get, map_insert }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  Diagnostics,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_merge,
  diagnostics_singleton,
  port_locus,
  rejected_with_pending
}
import v4.std.node {
  Conj,
  Edge,
  Node,
  Symbol,
  TypeNode,
  well_formed
}
import v4.std.qualified_name {
  QualifiedName,
  qualified_name_eq
}


// 🟢 coproduct dissolution — T-28-B admission visibility is a closed alternative: a declared import is either admitted into the subject namespace or rejected as hidden; no third visibility state is modeled.
type ImportVisibility
  = ImportVisible
  | ImportHidden


type Import {
  target: QualifiedName
  visibility: ImportVisibility
}


type ResolutionSubject {
  name: QualifiedName
}


type Admission {
  subject: ResolutionSubject
  imports: FreeMonoid<Import>
}


// 🟢 coproduct dissolution — T-28-B admitted subject pairs authoritative module root with its namespace.
type AdmittedSubject {
  namespace: Namespace
  subject_root: NormalizedTree
}


// 🟡 gated — feature:T-28-B-admission-state-outcome — internal fold state mirrors Outcome while carrying accepted namespace bindings plus origin facts for ambiguity checks; dissolve-on: generic Outcome fold/traverse can carry the accepted admission accumulator directly without losing the origin map.
type AdmissionState
  = AdmissionAccepted {
      bindings: Map<Symbol, Symbol>,
      origins: Map<Symbol, QualifiedName>
    }
  | AdmissionRejected { diagnostics: NonEmptyDiagnostics }


// 🟢 bridge dissolution — T-QN-1 Change 2: lookup is over module roots directly; no Entry/Catalog denormalized pair remains.
type ModuleRootFindState
  = ModuleRootNotFound
  | ModuleRootFoundOnce { root: Node }
  | ModuleRootFoundDuplicate
  | ModuleRootProjectionRejected { diagnostics: NonEmptyDiagnostics }


// 🟢 coproduct dissolution — T-QN-1 Change 2 module-root validate accumulator.
type ModuleRootValidateState
  = ModuleRootsValid { seen: FreeMonoid<QualifiedName>, diagnostics: Diagnostics }
  | ModuleRootsDuplicate { diagnostics: Diagnostics }
  | ModuleRootsProjectionRejected { diagnostics: NonEmptyDiagnostics }


// 🟢 coproduct dissolution — T-QN-1 Change 2 module-root name-find accumulator.
type ModuleRootNameFindState
  = ModuleRootNameNotFound
  | ModuleRootNameFoundOnce
  | ModuleRootNameFoundDuplicate


data resolve_import_not_visible: Symbol = resolve_import_not_visible
data resolve_ambiguous_export: Symbol = resolve_ambiguous_export
data resolve_module_not_found: Symbol = resolve_module_not_found
data resolve_duplicate_module_name: Symbol = resolve_duplicate_module_name
data resolve_reason_malformed_imported_root: Symbol = resolve_reason_malformed_imported_root


fn resolve_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: port_locus(port: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn resolve_diagnostics(reason: Symbol) -> NonEmptyDiagnostics {
  diagnostics_singleton(d: resolve_diagnostic(reason: reason))
}


fn admission_initial(base: Namespace) -> AdmissionState {
  AdmissionAccepted {
    bindings: base.bindings,
    origins: empty_map()
  }
}


fn admit_export_symbol(
  sym: Symbol,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: b, origins: os } =>
      // 🟡 gated — bootstrap-limitation interim — feature:B-LOOKUP-1 — map_get(Option<V>); dissolve-on: bootstrap Witness<V> generic dispatch for Map.lookup (substrate already Witness at v4.std.collection:27); site: admit_export_symbol origins
      match map_get(os, sym) {
        Accepted { value: opt, diagnostics: _ } => match opt {
          Present { value: _ } =>
            AdmissionRejected {
              diagnostics: resolve_diagnostics(reason: resolve_ambiguous_export)
            }
          Absent =>
            AdmissionAccepted {
              bindings: map_insert(m: b, key: sym, value: sym),
              origins: map_insert(m: os, key: sym, value: origin)
            }
        }
        Rejected { diagnostics: d } => AdmissionRejected { diagnostics: d }
      }
  }
}


// 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-qualified-name — hand-rolls Empty/Cons accumulation over FreeMonoid<QualifiedName>; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T.
fn module_root_name_find_fold(
  names: FreeMonoid<QualifiedName>,
  name: QualifiedName,
  acc: ModuleRootNameFindState
) -> ModuleRootNameFindState {
  match names {
    Empty => acc
    Cons { head: candidate, tail: rest } =>
      module_root_name_find_fold(
        names: rest,
        name: name,
        acc: if qualified_name_eq(a: candidate, b: name) {
          match acc {
            ModuleRootNameNotFound => ModuleRootNameFoundOnce
            ModuleRootNameFoundOnce => ModuleRootNameFoundDuplicate
            ModuleRootNameFoundDuplicate => ModuleRootNameFoundDuplicate
          }
        } else {
          acc
        }
      )
  }
}


// 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-node — hand-rolls Empty/Cons accumulation over FreeMonoid<Node>; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T.
fn module_root_validate_fold(
  roots: FreeMonoid<Node>,
  acc: ModuleRootValidateState
) -> ModuleRootValidateState {
  match roots {
    Empty => acc
    Cons { head: root, tail: rest } =>
      match acc {
        ModuleRootsDuplicate { diagnostics: d } =>
          module_root_validate_fold(
            roots: rest,
            acc: ModuleRootsDuplicate { diagnostics: d }
          )
        ModuleRootsProjectionRejected { diagnostics: d } =>
          module_root_validate_fold(
            roots: rest,
            acc: ModuleRootsProjectionRejected { diagnostics: d }
          )
        ModuleRootsValid { seen: prior, diagnostics: acc_diag } =>
          if well_formed(n: root) {
            match qualified_name_from_module_node(root: root) {
              Rejected { diagnostics: d } =>
                module_root_validate_fold(
                  roots: rest,
                  acc: ModuleRootsProjectionRejected {
                    diagnostics: rejected_with_pending(pending: acc_diag, rejected: d)
                  }
                )
              Accepted { value: name, diagnostics: proj_diag } =>
                let merged_diag = diagnostics_merge(outer: acc_diag, inner: proj_diag)
                module_root_validate_fold(
                  roots: rest,
                  acc: match module_root_name_find_fold(
                    names: prior,
                    name: name,
                    acc: ModuleRootNameNotFound
                  ) {
                    ModuleRootNameNotFound =>
                      ModuleRootsValid {
                        seen: Cons { head: name, tail: prior },
                        diagnostics: merged_diag
                      }
                    ModuleRootNameFoundOnce =>
                      ModuleRootsDuplicate { diagnostics: merged_diag }
                    ModuleRootNameFoundDuplicate =>
                      ModuleRootsDuplicate { diagnostics: merged_diag }
                  }
                )
            }
          } else {
            module_root_validate_fold(
              roots: rest,
              acc: ModuleRootsProjectionRejected {
                diagnostics: rejected_with_pending(
                  pending: acc_diag,
                  rejected: resolve_diagnostics(reason: resolve_reason_malformed_imported_root)
                )
              }
            )
          }
      }
  }
}


fn validate_module_roots(roots: FreeMonoid<Node>) -> Outcome<FreeMonoid<Node>> {
  match module_root_validate_fold(
    roots: roots,
    acc: ModuleRootsValid { seen: Empty, diagnostics: None }
  ) {
    ModuleRootsValid { seen: _, diagnostics: d } =>
      Accepted { value: roots, diagnostics: d }
    ModuleRootsDuplicate { diagnostics: d } =>
      Rejected {
        diagnostics: rejected_with_pending(
          pending: d,
          rejected: resolve_diagnostics(reason: resolve_duplicate_module_name)
        )
      }
    ModuleRootsProjectionRejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}


// 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-node — hand-rolls Empty/Cons accumulation over FreeMonoid<Node>; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T.
fn module_root_for_name_fold(
  roots: FreeMonoid<Node>,
  name: QualifiedName,
  acc: ModuleRootFindState
) -> ModuleRootFindState {
  match roots {
    Empty => acc
    Cons { head: root, tail: rest } =>
      match acc {
        ModuleRootProjectionRejected { diagnostics: d } =>
          ModuleRootProjectionRejected { diagnostics: d }
        ModuleRootFoundDuplicate =>
          ModuleRootFoundDuplicate
        ModuleRootNotFound =>
          match qualified_name_from_module_node(root: root) {
            Accepted { value: candidate, diagnostics: _ } =>
              module_root_for_name_fold(
                roots: rest,
                name: name,
                acc: if qualified_name_eq(a: candidate, b: name) {
                  ModuleRootFoundOnce { root: root }
                } else {
                  ModuleRootNotFound
                }
              )
            Rejected { diagnostics: d } =>
              ModuleRootProjectionRejected { diagnostics: d }
          }
        ModuleRootFoundOnce { root: found } =>
          match qualified_name_from_module_node(root: root) {
            Accepted { value: candidate, diagnostics: _ } =>
              module_root_for_name_fold(
                roots: rest,
                name: name,
                acc: if qualified_name_eq(a: candidate, b: name) {
                  ModuleRootFoundDuplicate
                } else {
                  ModuleRootFoundOnce { root: found }
                }
              )
            Rejected { diagnostics: d } =>
              ModuleRootProjectionRejected { diagnostics: d }
          }
      }
  }
}


fn try_admitted_export_binding(e: Edge) -> DeclaredBinding? {
  match try_edge_declared_binding(e: e) {
    Some { value: b } =>
      if dag_surface_module_header_metadata_edge(name: b.name) {
        None
      } else {
        Some { value: b }
      }
    None => None
  }
}


fn admit_named_export_edge(
  edge: Edge,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match try_admitted_export_binding(e: edge) {
    Some { value: b } =>
      admit_export_symbol(sym: b.name, origin: origin, state: state)
    None => state
  }
}


fn admit_named_exports(
  root: Node,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: state, f: fn(acc, e) {
        admit_named_export_edge(edge: e, origin: origin, state: acc)
      })
    _ => state
  }
}


fn admit_import_root_find(
  found: ModuleRootFindState,
  origin: QualifiedName,
  state: AdmissionState
) -> AdmissionState {
  match found {
    ModuleRootFoundOnce { root: imported_root } =>
      if well_formed(n: imported_root) {
        admit_named_exports(
          root: imported_root,
          origin: origin,
          state: state
        )
      } else {
        AdmissionRejected {
          diagnostics: resolve_diagnostics(reason: resolve_reason_malformed_imported_root)
        }
      }
    ModuleRootNotFound =>
      AdmissionRejected {
        diagnostics: resolve_diagnostics(reason: resolve_module_not_found)
      }
    ModuleRootFoundDuplicate =>
      AdmissionRejected {
        diagnostics: resolve_diagnostics(reason: resolve_duplicate_module_name)
      }
    ModuleRootProjectionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
  }
}


fn admit_import_entry(
  roots: FreeMonoid<Node>,
  import_edge: Import,
  state: AdmissionState
) -> AdmissionState {
  match state {
    AdmissionRejected { diagnostics: d } =>
      AdmissionRejected { diagnostics: d }
    AdmissionAccepted { bindings: _, origins: _ } =>
      match import_edge.visibility {
        ImportHidden =>
          AdmissionRejected {
            diagnostics: resolve_diagnostics(reason: resolve_import_not_visible)
          }
        ImportVisible =>
          admit_import_root_find(
            found: module_root_for_name_fold(
              roots: roots,
              name: import_edge.target,
              acc: ModuleRootNotFound
            ),
            origin: import_edge.target,
            state: state
          )
      }
  }
}


fn admit_imports(
  roots: FreeMonoid<Node>,
  imports: FreeMonoid<Import>,
  state: AdmissionState
) -> AdmissionState {
  // 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-import — hand-rolls Empty/Cons accumulation over FreeMonoid<Import>; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T.
  match imports {
    Empty => state
    Cons { head: import_edge, tail: rest } =>
      admit_imports(
        roots: roots,
        imports: rest,
        state: admit_import_entry(
          roots: roots,
          import_edge: import_edge,
          state: state
        )
      )
  }
}


fn admission_namespace_base(lm: DagLanguageModel) -> Namespace {
  Namespace {
    bindings: empty_map(),
    canonical_symbols: dag_language_model_canonical_symbols(lm: lm)
  }
}


fn subject_module_root_for_name(
  roots: FreeMonoid<Node>,
  name: QualifiedName
) -> Outcome<Node> {
  match module_root_for_name_fold(
    roots: roots,
    name: name,
    acc: ModuleRootNotFound
  ) {
    ModuleRootFoundOnce { root: subject_root } =>
      Accepted { value: subject_root, diagnostics: None }
    ModuleRootNotFound =>
      Rejected {
        diagnostics: resolve_diagnostics(reason: resolve_module_not_found)
      }
    ModuleRootFoundDuplicate =>
      Rejected {
        diagnostics: resolve_diagnostics(reason: resolve_duplicate_module_name)
      }
    ModuleRootProjectionRejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}


fn namespace_for_subject(
  lm: DagLanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission
) -> Outcome<AdmittedSubject> {
  match validate_module_roots(roots: roots) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: validated_roots, diagnostics: validate_diag } =>
      match subject_module_root_for_name(
        roots: validated_roots,
        name: admission.subject.name
      ) {
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: validate_diag, rejected: r)
          }
        Accepted { value: subject_module_root, diagnostics: _ } =>
          if well_formed(n: subject_module_root) {
            let base = admission_namespace_base(lm: lm)
            match admit_imports(
              roots: validated_roots,
              imports: admission.imports,
              state: admit_named_exports(
                root: subject_module_root,
                origin: admission.subject.name,
                state: admission_initial(base: base)
              )
            ) {
              AdmissionAccepted { bindings: b, origins: _ } =>
                Accepted {
                  value: AdmittedSubject {
                    namespace: Namespace {
                      bindings: b,
                      canonical_symbols: base.canonical_symbols
                    },
                    subject_root: subject_module_root
                  },
                  diagnostics: validate_diag
                }
              AdmissionRejected { diagnostics: d } =>
                Rejected {
                  diagnostics: rejected_with_pending(pending: validate_diag, rejected: d)
                }
            }
          } else {
            Rejected {
              diagnostics: rejected_with_pending(
                pending: validate_diag,
                rejected: resolve_diagnostics(reason: resolve_reason_malformed_imported_root)
              )
            }
          }
      }
  }
}


fn resolve_with_admission(
  lm: DagLanguageModel,
  roots: FreeMonoid<Node>,
  admission: Admission
) -> Outcome<ResolvedTree> {
  match namespace_for_subject(
    lm: lm,
    roots: roots,
    admission: admission
  ) {
    Accepted { value: admitted, diagnostics: namespace_diag } =>
      match resolve_with_namespace(
        tree: admitted.subject_root,
        namespace: admitted.namespace
      ) {
        Accepted { value: resolved, diagnostics: resolve_diag } =>
          Accepted {
            value: resolved,
            diagnostics: diagnostics_merge(outer: namespace_diag, inner: resolve_diag)
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: namespace_diag, rejected: r)
          }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
