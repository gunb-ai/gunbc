// src/v4/compiler/03_name_resolve.dag
//
// Scope: Stage 3c — name admission for cross-file resolution.
// Owns: NameSubject; NameAdmission; name_namespace_for_subject; resolve_name_with_admission.
// Consumes: compiler/03_normalize.dag, compiler/03_resolve.dag,
//           extdeps/languages/dag.dag, std/algebra.dag, std/collection.dag,
//           std/diagnostic.dag, std/module_graph.dag, std/node.dag,
//           std/qualified_name.dag, std/witness.dag.
// Status: T-28-B modeled — graph admission is outside K-1 single-tree resolver.
// Anchor: https://en.wikipedia.org/wiki/Name_resolution_(programming_languages)

module v4.compiler.name_resolve


import v4.compiler.normalize { NormalizedTree }
import v4.compiler.resolve {
  Namespace,
  ResolvedTree,
  build_program_namespace,
  resolve_with_namespace,
  try_edge_declared_binding
}
import v4.extdeps.languages.dag { DagLanguageModel }
import v4.std.algebra { Cons, Empty, FreeMonoid }
import v4.std.collection { Map, empty_map, map_insert }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  port_locus
}
import v4.std.module_graph {
  ModuleGraph,
  module_graph_root_for_name
}
import v4.std.node {
  Conj,
  Edge,
  Node,
  Symbol,
  TypeNode
}
import v4.std.qualified_name { QualifiedName }
import v4.std.witness { Holds, Violates }


// 🟢 coproduct dissolution — T-28-B admission visibility is a closed alternative: a declared import is either admitted into the subject namespace or rejected as hidden; no third visibility state is modeled.
type NameImportVisibility
  = NameImportVisible
  | NameImportHidden


type NameImport {
  target: QualifiedName
  visibility: NameImportVisibility
}


type NameSubject {
  qualified_name: QualifiedName
  tree: NormalizedTree
}


type NameAdmission {
  subject: NameSubject
  imports: FreeMonoid<NameImport>
}


// 🟡 gated — feature:T-28-B-name-admission-state-outcome — internal fold state mirrors Outcome while carrying accepted namespace bindings plus origin facts for ambiguity checks; dissolve-on: generic Outcome fold/traverse can carry the accepted admission accumulator directly without losing the origin map.
type NameAdmissionState
  = NameAdmissionAccepted {
      bindings: Map<Symbol, Symbol>,
      origins: Map<Symbol, QualifiedName>
    }
  | NameAdmissionRejected { diagnostic: Diagnostic }


data name_resolve_import_not_visible: Symbol = name_resolve_import_not_visible
data name_resolve_ambiguous_export: Symbol = name_resolve_ambiguous_export


fn name_resolve_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: port_locus(port: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn name_admission_initial(base: Namespace) -> NameAdmissionState {
  NameAdmissionAccepted {
    bindings: base.bindings,
    origins: empty_map()
  }
}


fn admit_export_symbol(
  sym: Symbol,
  origin: QualifiedName,
  state: NameAdmissionState
) -> NameAdmissionState {
  match state {
    NameAdmissionRejected { diagnostic: d } =>
      NameAdmissionRejected { diagnostic: d }
    NameAdmissionAccepted { bindings: b, origins: os } =>
      match map_get(os, sym) {
        Some { value: _ } =>
          NameAdmissionRejected {
            diagnostic: name_resolve_diagnostic(reason: name_resolve_ambiguous_export)
          }
        None =>
          NameAdmissionAccepted {
            bindings: map_insert(m: b, key: sym, value: sym),
            origins: map_insert(m: os, key: sym, value: origin)
          }
      }
  }
}


fn admit_named_export_edge(
  edge: Edge,
  origin: QualifiedName,
  state: NameAdmissionState
) -> NameAdmissionState {
  match try_edge_declared_binding(e: edge) {
    Some { value: b } =>
      admit_export_symbol(sym: b.name, origin: origin, state: state)
    None => state
  }
}


fn admit_module_named_exports(
  root: Node,
  origin: QualifiedName,
  state: NameAdmissionState
) -> NameAdmissionState {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: state, f: fn(acc, e) {
        admit_named_export_edge(edge: e, origin: origin, state: acc)
      })
    _ => state
  }
}


fn admit_import_entry(
  graph: ModuleGraph,
  import_edge: NameImport,
  state: NameAdmissionState
) -> NameAdmissionState {
  match state {
    NameAdmissionRejected { diagnostic: d } =>
      NameAdmissionRejected { diagnostic: d }
    NameAdmissionAccepted { bindings: _, origins: _ } =>
      match import_edge.visibility {
        NameImportHidden =>
          NameAdmissionRejected {
            diagnostic: name_resolve_diagnostic(reason: name_resolve_import_not_visible)
          }
        NameImportVisible =>
          match module_graph_root_for_name(graph: graph, name: import_edge.target) {
            Holds { value: root } =>
              admit_module_named_exports(
                root: root,
                origin: import_edge.target,
                state: state
              )
            Violates { diagnostic: d } =>
              NameAdmissionRejected { diagnostic: d }
          }
      }
  }
}


fn admit_imports(
  graph: ModuleGraph,
  imports: FreeMonoid<NameImport>,
  state: NameAdmissionState
) -> NameAdmissionState {
  // 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-nameimport — hand-rolls Empty/Cons accumulation over FreeMonoid<NameImport>; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T.
  match imports {
    Empty => state
    Cons { head: import_edge, tail: rest } =>
      admit_imports(
        graph: graph,
        imports: rest,
        state: admit_import_entry(
          graph: graph,
          import_edge: import_edge,
          state: state
        )
      )
  }
}


fn name_namespace_for_subject(
  lm: DagLanguageModel,
  graph: ModuleGraph,
  admission: NameAdmission
) -> Outcome<Namespace> {
  let base = build_program_namespace(tree: admission.subject.tree, lm: lm)
  match admit_imports(
    graph: graph,
    imports: admission.imports,
    state: admit_module_named_exports(
      root: admission.subject.tree,
      origin: admission.subject.qualified_name,
      state: name_admission_initial(base: base)
    )
  ) {
    NameAdmissionAccepted { bindings: b, origins: _ } =>
      Accepted {
        value: Namespace {
          bindings: b,
          canonical_symbols: base.canonical_symbols
        },
        diagnostics: None
      }
    NameAdmissionRejected { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


fn resolve_name_with_admission(
  lm: DagLanguageModel,
  graph: ModuleGraph,
  admission: NameAdmission
) -> Outcome<ResolvedTree> {
  match name_namespace_for_subject(
    lm: lm,
    graph: graph,
    admission: admission
  ) {
    Accepted { value: namespace, diagnostics: _ } =>
      resolve_with_namespace(tree: admission.subject.tree, namespace: namespace)
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
