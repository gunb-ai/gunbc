data translate_concrete_token_kind_invalid: Symbol = translate_concrete_token_kind_invalid
data translate_serialize_recursion_limit_exhausted: Symbol = translate_serialize_recursion_limit_exhausted
data translate_target_atom_realization_not_found: Symbol = translate_target_atom_realization_not_found
