// src/v4/compiler/06_translate.dag
// Scope: Stage 5a — InferredTree + TargetModel -> TargetNodeTree via coercion fold (T-10 / W-T-10-impl).
// Owns: TargetNodeTree, TargetBundleChildLookup, target_model_edge_selection_policy,
//       target_model_edge_declared_inhabitants, target_model_edge_serialize_emitted,
//       target_model_edge_serialize_source, target_bundle_child, target_bundle_child_lookup_step,
//       target_selection_policy_from_model, coercion_candidates_from_target_model,
//       target_serialize_source_from_model, translate_target_source_not_realized,
//       translate_canonical_grounding_not_realized, canonical_grounding_for_node,
//       coerce_grounded_node, translate_fold_init, translate_fold_step,
//       translate_node, translate.
// Consumes: compiler/04_infer.dag, compiler/00_compile.dag, std/coercion.dag, std/constraints.dag,
//           std/find_witness.dag, std/diagnostic.dag, std/node.dag, std/witness.dag, std/collection.dag.
// Status: W-T-10-impl — fold_node translate + coercion_fold wrapper; serialize in 05_emit.dag.
// Anchor: docs/design-v4-compiler-homomorphism.md Stage 5a; Ratified Q14.


module v4.compiler.translate


import v4.compiler.compile { TargetModel, TargetSource }
import v4.compiler.infer { InferredTree }
import v4.std.coercion {
  CoercionCandidateSet,
  CoercionResult,
  coercion_fold
}
import v4.std.constraints { CanonicalGrounding }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NodeLocus,
  Outcome,
  PortLocus,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_merge,
  diagnostics_singleton,
  outcome_rejected,
  rejected_with_pending
}
import v4.std.find_witness {
  CandidateSet,
  TargetDeclaredPriority,
  TargetSelectionPolicy
}
import v4.std.node {
  Conj,
  Edge,
  Named,
  Node,
  NodeFold,
  Positional,
  Symbol,
  TypeNode,
  fold_node
}
import v4.std.witness { StructuralPropertyWitness }
type TargetNodeTree = Node
// Single-authority lookup state for TargetModel Conj bundles (P2/P3 fail-closed).
type TargetBundleChildLookup
  = BundleChildMissing
  | BundleChildFound { value: Node }
  | BundleChildDuplicate
data target_model_edge_selection_policy: Symbol = target_model_edge_selection_policy
data target_model_edge_declared_inhabitants: Symbol = target_model_edge_declared_inhabitants
data target_model_edge_serialize_emitted: Symbol = target_model_edge_serialize_emitted
data target_model_edge_serialize_source: Symbol = target_model_edge_serialize_source
data translate_target_bundle_malformed: Symbol = translate_target_bundle_malformed
data translate_target_bundle_duplicate_edge: Symbol = translate_target_bundle_duplicate_edge
data translate_stage_locus_port: Symbol = translate_stage_locus_port
data translate_target_source_not_realized: Symbol = translate_target_source_not_realized
data translate_canonical_grounding_not_realized: Symbol = translate_canonical_grounding_not_realized
fn translate_target_bundle_malformed_diagnostic(target: TargetModel) -> Diagnostic {
  Diagnostic {
    reason: translate_target_bundle_malformed,
    at: NodeLocus { node: target },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_target_bundle_duplicate_edge_diagnostic(
  target: TargetModel,
  edge_name: Symbol
) -> Diagnostic {
  Diagnostic {
    reason: translate_target_bundle_duplicate_edge,
    at: NodeLocus { node: target },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn target_bundle_child_lookup_step(
  acc: TargetBundleChildLookup,
  e: Edge,
  edge_name: Symbol
) -> TargetBundleChildLookup {
  match e.label {
    Named { name: n } =>
      if n == edge_name {
        match acc {
          BundleChildMissing =>
            BundleChildFound { value: e.target }
          BundleChildFound { value: _ } => BundleChildDuplicate
          BundleChildDuplicate => BundleChildDuplicate
        }
      } else {
        acc
      }
    Positional => acc
  }
}
fn translate_target_source_not_realized_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: translate_target_source_not_realized,
    at: PortLocus { port: translate_stage_locus_port },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_canonical_grounding_not_realized_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: translate_canonical_grounding_not_realized,
    at: NodeLocus { node: node },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn target_serialize_source_from_model(target: TargetModel) -> Outcome<TargetSource> {
  outcome_rejected(translate_target_source_not_realized_diagnostic())
}
fn target_bundle_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node> {
  match target.kind {
    TypeNode { connective: Conj } =>
      match fold(
        target.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: child, diagnostics: None }
        BundleChildMissing =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
        BundleChildDuplicate =>
          outcome_rejected(
            translate_target_bundle_duplicate_edge_diagnostic(
              target: target,
              edge_name: edge_name
            )
          )
      }
    _ =>
      outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
  }
}
fn target_selection_policy_from_model(target: TargetModel) -> Outcome<TargetSelectionPolicy> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_selection_policy),
    f: fn(priority_node) {
      Accepted {
        value: TargetDeclaredPriority { priority: priority_node },
        diagnostics: None
      }
    }
  )
}
fn coercion_candidates_from_target_model(
  target: TargetModel,
  closedness_evidence: Node
) -> Outcome<CoercionCandidateSet> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_declared_inhabitants),
    f: fn(inhabitants_root) {
      Accepted {
        value: CoercionCandidateSet {
          set: CandidateSet {
            candidates: [inhabitants_root],
            closedness: StructuralPropertyWitness {
              property: target_model_edge_declared_inhabitants,
              evidence: closedness_evidence
            }
          }
        },
        diagnostics: None
      }
    }
  )
}
// RULING-1: needs-more-work — T-9 `infer` must author grounding via solve_constraints / enriched
// InferredFacts; no Map-presence or compiler-side witness fabrication (INVARIANTS P3).
fn canonical_grounding_for_node(tree: InferredTree, node: Node) -> Outcome<CanonicalGrounding> {
  outcome_rejected(translate_canonical_grounding_not_realized_diagnostic(node: node))
}
fn coerce_grounded_node(
  source: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<CoercionResult> {
  bind_outcome(
    o: canonical_grounding_for_node(tree: tree, node: source),
    f: fn(grounding) {
      bind_outcome(
        o: target_selection_policy_from_model(target: target),
        f: fn(policy) {
          bind_outcome(
            o: coercion_candidates_from_target_model(
              target: target,
              closedness_evidence: grounding.node
            ),
            f: fn(candidates) {
              coercion_fold(
                source: grounding,
                candidates: candidates,
                policy: policy
              )
            }
          )
        }
      )
    }
  )
}
fn translate_fold_init(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match coerce_grounded_node(source: node, tree: tree, target: target) {
    Accepted { value: coerced, diagnostics: d } =>
      Accepted {
        value: Node {
          kind: coerced.target.kind,
          children: []
        },
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
fn translate_fold_step(
  acc: Outcome<Node>,
  edge: Edge,
  child: Outcome<Node>
) -> Outcome<Node> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: parent, diagnostics: ad } =>
      match child {
        Accepted { value: child_node, diagnostics: cd } =>
          Accepted {
            value: Node {
              kind: parent.kind,
              children: list_push(parent.children, Edge {
                label: edge.label,
                target: child_node
              })
            },
            diagnostics: diagnostics_merge(outer: ad, inner: cd)
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: ad, rejected: r)
          }
      }
  }
}
fn translate_node(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) {
        translate_fold_init(node: n0, tree: tree, target: target)
      },
      step: fn(acc, e, child) {
        translate_fold_step(acc: acc, edge: e, child: child)
      }
    }
  )
}
fn translate(tree: InferredTree, target: TargetModel) -> Outcome<TargetNodeTree> {
  translate_node(node: tree.root, tree: tree, target: target)
}
