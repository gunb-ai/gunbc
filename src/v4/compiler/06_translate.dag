fn translate_serialize_recursion_limit_exhausted_diagnostic(emitted: Node) -> Diagnostic {
  Diagnostic {
    reason: translate_serialize_recursion_limit_exhausted,
    at: node_locus(node: emitted),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn grammar_relation_row_emitted(row: Node) -> Outcome<Node> {
  conj_named_child(parent: row, edge_name: grammar_relation_field_emitted)
}
fn grammar_relation_row_tokens_root(row: Node) -> Outcome<Node> {
  conj_named_child(parent: row, edge_name: grammar_relation_field_tokens)
}
fn grammar_relation_row_for_emitted(rules: Node, emitted: Node) -> Outcome<Node> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      match fold(
        rules.children,
        init: Rejected {
          diagnostics: diagnostics_singleton(
            d: translate_grammar_relation_row_not_found_diagnostic(emitted: emitted)
          )
        },
        f: fn(acc, e) {
          match acc {
            Accepted { value: _, diagnostics: _ } => acc
            Rejected { diagnostics: _ } =>
              match e.label {
                Named { name: _ } =>
                  match grammar_relation_row_emitted(row: e.target) {
                    Accepted { value: row_emitted, diagnostics: rd } =>
                      if row_emitted == emitted {
                        Accepted { value: e.target, diagnostics: rd }
                      } else {
                        acc
                      }
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  }
                Positional => acc
              }
          }
        }
      ) {
        Accepted { value: row, diagnostics: d } =>
          Accepted { value: row, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    _ =>
      outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: emitted))
  }
}
fn conj_positional_targets(parent: Node) -> Outcome<List<Node>> {
  match parent.kind {
    TypeNode { connective: Conj } =>
      Accepted {
        value: fold(parent.children, init: Empty, f: fn(acc, e) {
          match e.label {
            Positional => list_snoc_item(xs: acc, item: e.target)
            Named { name: _ } => acc
          }
        }),
        diagnostics: None
      }
    _ =>
      outcome_rejected(
      translate_grammar_inverse_not_realized_diagnostic(emitted: parent)
      )
  }
}
fn optional_named_child_ignoring_positional(parent: Node, edge_name: Symbol) -> Outcome<Node?> {
  // Token-sequence dispatch items may be inner-production nodes with positional edges.
  match parent.kind {
    TypeNode { connective: Conj } =>
      match fold(
        parent.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          match acc {
            BundleChildInvalidEdge => acc
            BundleChildDuplicate => acc
            BundleChildMissing =>
              match e.label {
                Named { name: n } =>
                  if n == edge_name {
                    BundleChildFound { value: e.target }
                  } else {
                    acc
                  }
                Positional => acc
              }
            BundleChildFound { value: _ } =>
              match e.label {
                Named { name: n } =>
                  if n == edge_name {
                    BundleChildDuplicate
                  } else {
                    acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: Some { value: child }, diagnostics: None }
        BundleChildMissing =>
          Accepted { value: None, diagnostics: None }
        BundleChildDuplicate =>
          outcome_rejected(
            Diagnostic {
              reason: translate_target_bundle_duplicate_edge,
              at: node_locus(node: parent),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_conj_invalid_edge_diagnostic(parent: parent))
      }
    _ =>
      Accepted { value: None, diagnostics: None }
  }
}
fn concrete_token_class_child(parent: Node) -> Outcome<Node?> {
  optional_named_child_ignoring_positional(
    parent: parent,
    edge_name: concrete_syntax_token_field_class
  )
}
fn concrete_token_kind_child(parent: Node) -> Outcome<Node?> {
  optional_named_child_ignoring_positional(
    parent: parent,
    edge_name: concrete_syntax_token_field_kind
  )
}
// 🟡 gated — feature:T-11-typed-concrete-syntax-token-variants — dissolve-on:
// ConcreteSyntaxToken coproduct lands in target_model.dag; replace symbol-equality
// with structural pattern matching on the typed carrier.
fn concrete_token_kind_is_declared(kind: Symbol) -> Bool {
  kind == concrete_syntax_token_kind_fixed || kind == concrete_syntax_token_kind_bound
}
fn token_sequence_item_kind(item: Node) -> Outcome<TokenSequenceItemKind> {
  bind_outcome(
    o: concrete_token_class_child(parent: item),
    f: fn(class_node) {
      bind_outcome(
        o: concrete_token_kind_child(parent: item),
        f: fn(kind_node) {
          match class_node {
            Some { value: _ } =>
              match kind_node {
                Some { value: kind_node } =>
                  bind_outcome(
                    o: node_atom_identity(node: kind_node),
                    f: fn(kind) {
                      if concrete_token_kind_is_declared(kind: kind) {
                        Accepted { value: TokenSequenceConcreteToken, diagnostics: None }
                      } else {
                        outcome_rejected(
                          translate_concrete_token_kind_invalid_diagnostic(token: item)
                        )
                      }
                    }
                  )
                None =>
                  outcome_rejected(
                    translate_concrete_token_kind_invalid_diagnostic(token: item)
                  )
              }
            None =>
              match kind_node {
                Some { value: _ } =>
                  outcome_rejected(
                    translate_concrete_token_class_missing_diagnostic(token: item)
                  )
                None =>
                  Accepted { value: TokenSequenceNonterminal, diagnostics: None }
              }
          }
        }
      )
    }
  )
}
fn grammar_serialize_source_matches_row(
  serialize_source: Node,
  row: Node
) -> Outcome<Node> {
  if well_formed(n: serialize_source) {
    bind_outcome(
      o: grammar_relation_row_tokens_root(row: row),
      f: fn(tokens_root) {
        bind_outcome(
          o: conj_positional_targets(parent: serialize_source),
          f: fn(source_targets) {
            bind_outcome(
              o: conj_positional_targets(parent: tokens_root),
              f: fn(row_targets) {
                if zip_eq(a: source_targets, b: row_targets, eq: fn(x, y) { x == y }) {
                  Accepted { value: serialize_source, diagnostics: None }
                } else {
                  outcome_rejected(
                    translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
                  )
                }
              }
            )
          }
        )
      }
    )
  } else {
    outcome_rejected(
      translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
    )
  }
}
fn grammar_inverse_source_validated(
  target: TargetModel,
  emitted: Node
) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
    f: fn(rules) {
      bind_outcome(
        o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
        f: fn(row) {
          bind_outcome(
            o: target_bundle_child(target: target, edge_name: target_model_edge_serialize_source),
            f: fn(serialize_source) {
              grammar_serialize_source_matches_row(
                serialize_source: serialize_source,
                row: row
              )
            }
          )
        }
      )
    }
  )
}
fn target_serialize_relation_row_from_model_bounded(
  remaining: Int,
  target: TargetModel,
  emitted: Node
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else {
    bind_outcome(
      o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
      f: fn(rules) {
        bind_outcome(
          o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
          f: fn(row) {
            bind_outcome(
              o: grammar_relation_row_tokens_root(row: row),
              f: fn(tokens_root) {
                bind_outcome(
                  o: conj_positional_targets(parent: tokens_root),
                  f: fn(tokens) {
                    fold_list(
                      xs: tokens,
                      empty: Accepted { value: Empty, diagnostics: None },
                      cons: fn(acc, token_node) {
                        match acc {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: partial, diagnostics: ad } =>
                            match token_sequence_item_kind(item: token_node) {
                              Accepted { value: TokenSequenceConcreteToken, diagnostics: kd } =>
                                match token_spelling_from_model(target: target, token: token_node) {
                                  Accepted { value: source, diagnostics: td } =>
                                    Accepted {
                                      value: list_append(left: partial, right: source),
                                      diagnostics: diagnostics_merge(
                                        outer: diagnostics_merge(outer: ad, inner: kd),
                                        inner: td
                                      )
                                    }
                                  Rejected { diagnostics: r } =>
                                    Rejected {
                                      diagnostics: rejected_with_pending(
                                        pending: diagnostics_merge(outer: ad, inner: kd),
                                        rejected: r
                                      )
                                    }
                                }
                              Accepted { value: TokenSequenceNonterminal, diagnostics: kd } =>
                                match target_serialize_relation_row_from_model_bounded(
                                  remaining - 1,
                                  target,
                                  token_node
                                ) {
                                  Accepted { value: source, diagnostics: td } =>
                                    Accepted {
                                      value: list_append(left: partial, right: source),
                                      diagnostics: diagnostics_merge(
                                        outer: diagnostics_merge(outer: ad, inner: kd),
                                        inner: td
                                      )
                                    }
                                  Rejected { diagnostics: r } =>
                                    Rejected {
                                      diagnostics: rejected_with_pending(
                                        pending: diagnostics_merge(outer: ad, inner: kd),
                                        rejected: r
                                      )
                                    }
                                }
                              Rejected { diagnostics: r } =>
                                Rejected {
                                  diagnostics: rejected_with_pending(pending: ad, rejected: r)
                                }
                            }
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}
fn translate_lex_rule_literal_not_found_diagnostic(token_class: Symbol) -> Diagnostic {
  Diagnostic {
    reason: translate_lex_rule_literal_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: token_class } },
      children: []
    }),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_binding_spelling_not_found_diagnostic(binding: Symbol) -> Diagnostic {
  Diagnostic {
    reason: translate_binding_spelling_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: binding } },
      children: []
    }),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn node_atom_identity(node: Node) -> Outcome<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      Accepted { value: id, diagnostics: None }
    _ =>
      outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
  }
}
fn lex_rule_literal_step(
  acc: Outcome<String>,
  rule: LexRule,
  token_class: Symbol
) -> Outcome<String> {
  match acc {
    Accepted { value: _, diagnostics: _ } => acc
    Rejected { diagnostics: _ } =>
      match rule {
        TokenRule { token_class: c, pattern: pattern } =>
          if c == token_class {
            match pattern {
              LiteralPattern { text: text } =>
                Accepted { value: text, diagnostics: None }
              KeywordPattern { text: text } =>
                Accepted { value: text, diagnostics: None }
              _ =>
                Rejected {
                  diagnostics: diagnostics_singleton(
                    d: translate_lex_rule_literal_not_found_diagnostic(
                      token_class: token_class
                    )
                  )
                }
            }
          } else {
            acc
          }
        TriviaRule { pattern: _ } => acc
      }
  }
}
fn lex_rules_literal_for_class(rules: LexRules, token_class: Symbol) -> Outcome<String> {
  match rules {
    VoidLexRules =>
      outcome_rejected(
        translate_lex_rule_literal_not_found_diagnostic(token_class: token_class)
      )
    ModeledLexRules { root: set } =>
      fold_list(
        xs: set.rules,
        empty: Rejected {
          diagnostics: diagnostics_singleton(
            d: translate_lex_rule_literal_not_found_diagnostic(token_class: token_class)
          )
        },
        cons: fn(acc, rule) {
          lex_rule_literal_step(acc: acc, rule: rule, token_class: token_class)
        }
      )
  }
}
fn token_spelling_from_model(target: TargetModel, token: Node) -> Outcome<String> {
  bind_outcome(
    o: conj_named_child(parent: token, edge_name: concrete_syntax_token_field_kind),
    f: fn(kind_node) {
      bind_outcome(
        o: node_atom_identity(node: kind_node),
        f: fn(kind) {
          bind_outcome(
            o: conj_named_child(parent: token, edge_name: concrete_syntax_token_field_class),
            f: fn(class_node) {
              bind_outcome(
                o: node_atom_identity(node: class_node),
                f: fn(token_class) {
                  bind_outcome(
                    o: conj_optional_named_child(
                      parent: token,
                      edge_name: concrete_syntax_token_field_binding
                    ),
                    f: fn(binding_node) {
                      if kind == concrete_syntax_token_kind_fixed {
                        match binding_node {
                          Some { value: _ } =>
                            outcome_rejected(
                              translate_concrete_token_kind_invalid_diagnostic(token: token)
                            )
                          None =>
                            lex_rules_literal_for_class(
                              rules: target.lex,
                              token_class: token_class
                            )
                        }
                      } else {
                        if kind == concrete_syntax_token_kind_bound {
                          match binding_node {
                            Some { value: binding_node } =>
                              bind_outcome(
                                o: node_atom_identity(node: binding_node),
                                f: fn(binding) {
                                  // 🟡 gated — bootstrap-limitation interim — feature:B-LOOKUP-1 — map_get(Option<V>); dissolve-on: bootstrap Witness<V> generic dispatch for Map.lookup (substrate already Witness at v4.std.collection:27); site: binding_spellings
                                  match map_get(target.binding_spellings, binding) {
                                    Some { value: spelling } =>
                                      Accepted { value: spelling, diagnostics: None }
                                    None =>
                                      Rejected {
                                        diagnostics: diagnostics_singleton(
                                          d: translate_binding_spelling_not_found_diagnostic(
                                            binding: binding
                                          )
                                        )
                                      }
                                  }
                                }
                              )
                            None =>
                              outcome_rejected(
                                translate_concrete_token_kind_invalid_diagnostic(token: token)
                              )
                          }
                        } else {
                          outcome_rejected(
                            translate_concrete_token_kind_invalid_diagnostic(token: token)
                          )
                        }
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}
fn token_item_to_source_bounded(
  remaining: Int,
  item: Node,
  target: TargetModel
) -> Outcome<TargetSource> {
  bind_outcome(
    o: token_sequence_item_kind(item: item),
    f: fn(item_kind) {
      match item_kind {
        TokenSequenceConcreteToken =>
          token_spelling_from_model(target: target, token: item)
        TokenSequenceNonterminal =>
          target_serialize_relation_row_from_model_bounded(remaining - 1, target, item)
      }
    }
  )
}
fn token_item_to_source(item: Node, target: TargetModel) -> Outcome<TargetSource> {
  bind_outcome(
    o: token_item_serialize_measure(item: item, target: target),
    f: fn(measure) {
      token_item_to_source_bounded(measure, item, target)
    }
  )
}
fn token_sequence_to_source_bounded(
  remaining: Int,
  tokens: List<Node>,
  target: TargetModel
) -> Outcome<TargetSource> {
  fold_list(
    xs: tokens,
    empty: Accepted { value: Empty, diagnostics: None },
    cons: fn(acc, token_node) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: partial, diagnostics: ad } =>
          match token_item_to_source_bounded(remaining - 1, token_node, target) {
            Accepted { value: source, diagnostics: td } =>
              Accepted {
                value: list_append(left: partial, right: source),
                diagnostics: diagnostics_merge(outer: ad, inner: td)
              }
            Rejected { diagnostics: r } =>
              Rejected {
                diagnostics: rejected_with_pending(pending: ad, rejected: r)
              }
          }
      }
    }
  )
}
fn token_sequence_to_source(tokens: List<Node>, target: TargetModel) -> Outcome<TargetSource> {
  bind_outcome(
    o: token_sequence_serialize_measure(tokens: tokens, target: target),
    f: fn(measure) {
      token_sequence_to_source_bounded(measure, tokens, target)
    }
  )
}
// Rust MVP-1 is live through grammar-inverse token_sequence_to_source; remaining targets stay gated by feature:T-11-grammar-inverse-serializer-remaining-targets above. TargetModel.authority_source_text must not substitute for validated emitted Node serialization.
fn target_serialize_source_from_model_bounded(
  remaining: Int,
  target: TargetModel,
  emitted: Node
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else {
    bind_outcome(
      o: grammar_inverse_source_validated(target: target, emitted: emitted),
      f: fn(_) {
          target_serialize_relation_row_from_model_bounded(remaining - 1, target, emitted)
      }
    )
  }
}
fn target_serialize_source_from_model(
  target: TargetModel,
  emitted: Node
) -> Outcome<TargetSource> {
  bind_outcome(
    o: translate_serialize_measure(target: target, emitted: emitted),
    f: fn(measure) {
      target_serialize_source_from_model_bounded(measure, target, emitted)
    }
  )
}
fn target_bundle_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match fold(
        target.bundle.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: child, diagnostics: None }
        BundleChildMissing =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
        BundleChildDuplicate =>
          outcome_rejected(
            translate_target_bundle_duplicate_edge_diagnostic(
              target: target,
              edge_name: edge_name
            )
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
      }
    _ =>
      outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
  }
}
fn target_selection_priority_from_model(target: TargetModel) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_selection_policy),
    f: fn(priority_node) {
      Accepted {
        value: priority_node,
        diagnostics: None
      }
    }
  )
}
fn coercion_candidates_from_target_model(
  target: TargetModel
) -> Outcome<CoercionCandidateSet> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_declared_inhabitants),
    f: fn(inhabitants_root) {
      coercion_candidate_set_from_declared_inhabitants(
        inhabitants_root: inhabitants_root,
        closedness_property: target_model_edge_declared_inhabitants
      )
    }
  )
}
fn coerce_grounded_node(
  source: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<CoercionResult> {
  bind_outcome(
    o: canonical_grounding_for_node(tree: tree, node: source),
    f: fn(grounding) {
      bind_outcome(
        o: target_selection_priority_from_model(target: target),
        f: fn(priority) {
          bind_outcome(
            o: coercion_candidates_from_target_model(
              target: target
            ),
            f: fn(candidates) {
              coercion_fold_with_declared_priority(
                source: grounding,
                candidates: candidates,
                priority: priority
              )
            }
          )
        }
      )
    }
  )
}
fn translate_coerced_shell(coerced: Node) -> Node {
  Node {
    kind: coerced.kind,
    children: []
  }
}
fn translate_fold_init(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match coerce_grounded_node(source: node, tree: tree, target: target) {
    Accepted { value: coerced, diagnostics: d } =>
      Accepted {
        value: translate_coerced_shell(coerced: coerced.target),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
fn translate_fold_step(
  acc: Outcome<Node>,
  edge: Edge,
  child: Outcome<Node>
) -> Outcome<Node> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: parent, diagnostics: ad } =>
      match child {
        Accepted { value: translated_child, diagnostics: cd } =>
          Accepted {
            value: Node {
              kind: parent.kind,
              children: list_snoc_item(xs: parent.children, item: Edge { label: edge.label, target: translated_child })
            },
            diagnostics: diagnostics_merge(outer: ad, inner: cd)
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: ad, rejected: r)
          }
      }
  }
}
fn translate_node(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) {
        translate_fold_init(node: n0, tree: tree, target: target)
      },
      step: fn(acc, e, child) {
        translate_fold_step(acc: acc, edge: e, child: child)
      }
    }
  )
}
fn translate(
  tree: InferredTree,
  target: TargetModel
) -> Outcome<TargetNodeTree> {
  translate_node(node: tree.root, tree: tree, target: target)
}
