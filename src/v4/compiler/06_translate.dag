import v4.std.text { String }
import v4.std.witness { Holds, Violates }
type TargetNodeTree = Node
// 🟢 coproduct dissolution — T-10 target-bundle named-edge lookup fold state (P3 fail-closed terminal).
type TargetBundleChildLookup
  = BundleChildMissing
  | BundleChildFound { value: Node }
  | BundleChildDuplicate
  | BundleChildInvalidEdge
data translate_target_bundle_malformed: Symbol = translate_target_bundle_malformed
data translate_target_bundle_duplicate_edge: Symbol = translate_target_bundle_duplicate_edge
data translate_grammar_inverse_not_realized: Symbol = translate_grammar_inverse_not_realized
data translate_grammar_relation_row_not_found: Symbol = translate_grammar_relation_row_not_found
data translate_conj_invalid_edge: Symbol = translate_conj_invalid_edge
data translate_conj_named_child_missing: Symbol = translate_conj_named_child_missing
data translate_lex_rule_literal_not_found: Symbol = translate_lex_rule_literal_not_found
data translate_binding_spelling_not_found: Symbol = translate_binding_spelling_not_found
fn translate_target_bundle_malformed_diagnostic(target: TargetModel) -> Diagnostic {
  Diagnostic {
    reason: translate_target_bundle_malformed,
    at: node_locus(node: target.bundle),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_target_bundle_duplicate_edge_diagnostic(
  target: TargetModel,
  edge_name: Symbol
) -> Diagnostic {
  Diagnostic {
    reason: translate_target_bundle_duplicate_edge,
    at: node_locus(node: target.bundle),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn target_bundle_child_lookup_step(
  acc: TargetBundleChildLookup,
  e: Edge,
  edge_name: Symbol
) -> TargetBundleChildLookup {
  match acc {
    BundleChildInvalidEdge => acc
    BundleChildDuplicate => acc
    BundleChildMissing =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            BundleChildFound { value: e.target }
          } else {
            acc
          }
        Positional => BundleChildInvalidEdge
      }
    BundleChildFound { value: _ } =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            BundleChildDuplicate
          } else {
            acc
          }
        Positional => BundleChildInvalidEdge
      }
  }
}
fn conj_named_child(parent: Node, edge_name: Symbol) -> Outcome<Node> {
  match parent.kind {
    TypeNode { connective: Conj } =>
      match fold(
        parent.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: child, diagnostics: None }
        BundleChildMissing =>
          outcome_rejected(translate_conj_named_child_missing_diagnostic(parent: parent))
        BundleChildDuplicate =>
          outcome_rejected(
            Diagnostic {
              reason: translate_target_bundle_duplicate_edge,
              at: node_locus(node: parent),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_conj_invalid_edge_diagnostic(parent: parent))
      }
    _ =>
      outcome_rejected(
        Diagnostic {
          reason: translate_grammar_inverse_not_realized,
          at: node_locus(node: parent),
          correction: Unavailable { reason: ExternalContractUnknown }
        }
      )
  }
}
fn translate_grammar_inverse_not_realized_diagnostic(emitted: Node) -> Diagnostic {
  Diagnostic {
    reason: translate_grammar_inverse_not_realized,
    at: node_locus(node: emitted),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_grammar_relation_row_not_found_diagnostic(emitted: Node) -> Diagnostic {
  Diagnostic {
    reason: translate_grammar_relation_row_not_found,
    at: node_locus(node: emitted),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_conj_invalid_edge_diagnostic(parent: Node) -> Diagnostic {
  Diagnostic {
    reason: translate_conj_invalid_edge,
    at: node_locus(node: parent),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_conj_named_child_missing_diagnostic(parent: Node) -> Diagnostic {
  Diagnostic {
    reason: translate_conj_named_child_missing,
    at: node_locus(node: parent),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn grammar_relation_row_emitted(row: Node) -> Outcome<Node> {
  conj_named_child(parent: row, edge_name: grammar_relation_field_emitted)
}
fn grammar_relation_row_tokens_root(row: Node) -> Outcome<Node> {
  conj_named_child(parent: row, edge_name: grammar_relation_field_tokens)
}
fn grammar_relation_row_for_emitted(rules: Node, emitted: Node) -> Outcome<Node> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      match fold(
        rules.children,
        init: Rejected {
          diagnostics: diagnostics_singleton(
            d: translate_grammar_relation_row_not_found_diagnostic(emitted: emitted)
          )
        },
        f: fn(acc, e) {
          match acc {
            Accepted { value: _, diagnostics: _ } => acc
            Rejected { diagnostics: _ } =>
              match e.label {
                Named { name: _ } =>
                  match grammar_relation_row_emitted(row: e.target) {
                    Accepted { value: row_emitted, diagnostics: rd } =>
                      if row_emitted == emitted {
                        Accepted { value: e.target, diagnostics: rd }
                      } else {
                        acc
                      }
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  }
                Positional => acc
              }
          }
        }
      ) {
        Accepted { value: row, diagnostics: d } =>
          Accepted { value: row, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    _ =>
      outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: emitted))
  }
}
fn conj_positional_targets(parent: Node) -> List<Node> {
  match parent.kind {
    TypeNode { connective: Conj } =>
      fold(parent.children, init: Empty, f: fn(acc, e) {
        match e.label {
          Positional => list_snoc_item(xs: acc, item: e.target)
          Named { name: _ } => acc
        }
      })
    _ => Empty
  }
}
fn conj_positional_target_lists_equal(a: FreeMonoid<Node>, b: FreeMonoid<Node>) -> Bool {
  match a {
    Empty =>
      match b {
        Empty => true
        Cons { head: _, tail: _ } => false
      }
    Cons { head: ha, tail: ta } =>
      match b {
        Empty => false
        Cons { head: hb, tail: tb } =>
          (ha == hb) && conj_positional_target_lists_equal(a: ta, b: tb)
      }
  }
}
fn grammar_serialize_source_matches_row(
  serialize_source: Node,
  row: Node
) -> Outcome<Node> {
  if well_formed(n: serialize_source) {
    bind_outcome(
      o: grammar_relation_row_tokens_root(row: row),
      f: fn(tokens_root) {
        if conj_positional_target_lists_equal(
          a: conj_positional_targets(parent: serialize_source),
          b: conj_positional_targets(parent: tokens_root)
        ) {
          Accepted { value: serialize_source, diagnostics: None }
        } else {
          outcome_rejected(
            translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
          )
        }
      }
    )
  } else {
    outcome_rejected(
      translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
    )
  }
}
fn grammar_inverse_source_validated(
  target: TargetModel,
  emitted: Node
) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
    f: fn(rules) {
      bind_outcome(
        o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
        f: fn(row) {
          bind_outcome(
            o: target_bundle_child(target: target, edge_name: target_model_edge_serialize_source),
            f: fn(serialize_source) {
              grammar_serialize_source_matches_row(
                serialize_source: serialize_source,
                row: row
              )
            }
          )
        }
      )
    }
  )
}
fn translate_lex_rule_literal_not_found_diagnostic(token_class: Symbol) -> Diagnostic {
  Diagnostic {
    reason: translate_lex_rule_literal_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: token_class } },
      children: []
    }),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_binding_spelling_not_found_diagnostic(binding: Symbol) -> Diagnostic {
  Diagnostic {
    reason: translate_binding_spelling_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: binding } },
      children: []
    }),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn node_atom_identity(node: Node) -> Outcome<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      Accepted { value: id, diagnostics: None }
    _ =>
      outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
  }
}
fn string_append(left: String, right: String) -> String {
  match left {
    Empty => right
    Cons { head: h, tail: t } =>
      Cons { head: h, tail: string_append(left: t, right: right) }
  }
}
fn conj_has_named_child(parent: Node, edge_name: Symbol) -> Bool {
  match parent.kind {
    TypeNode { connective: Conj } =>
      fold(parent.children, init: false, f: fn(acc, e) {
        match acc {
          true => true
          false =>
            match e.label {
              Named { name: n } => n == edge_name
              Positional => false
            }
        }
      })
    _ => false
  }
}
fn lex_rules_literal_for_class(rules: LexRules, token_class: Symbol) -> Outcome<String> {
  match rules {
    VoidLexRules =>
      outcome_rejected(
        translate_lex_rule_literal_not_found_diagnostic(token_class: token_class)
      )
    ModeledLexRules { root: set } =>
      fold_list(
        xs: set.rules,
        empty: Rejected {
          diagnostics: diagnostics_singleton(
            d: translate_lex_rule_literal_not_found_diagnostic(token_class: token_class)
          )
        },
        cons: fn(acc, rule) {
          match acc {
            Accepted { value: _, diagnostics: _ } => acc
            Rejected { diagnostics: _ } =>
              match rule {
                TokenRule { token_class: c, pattern: pattern } =>
                  if c == token_class {
                    match pattern {
                      LiteralPattern { text: text } =>
                        Accepted { value: text, diagnostics: None }
                      _ =>
                        Rejected {
                          diagnostics: diagnostics_singleton(
                            d: translate_lex_rule_literal_not_found_diagnostic(
                              token_class: token_class
                            )
                          )
                        }
                    }
                  } else {
                    acc
                  }
              }
          }
        }
      )
  }
}
fn token_spelling_from_model(target: TargetModel, token: Node) -> Outcome<String> {
  bind_outcome(
    o: conj_named_child(parent: token, edge_name: concrete_syntax_token_field_class),
    f: fn(class_node) {
      bind_outcome(
        o: node_atom_identity(node: class_node),
        f: fn(token_class) {
          if conj_has_named_child(parent: token, edge_name: concrete_syntax_token_field_binding) {
            bind_outcome(
              o: conj_named_child(parent: token, edge_name: concrete_syntax_token_field_binding),
              f: fn(binding_node) {
                bind_outcome(
                  o: node_atom_identity(node: binding_node),
                  f: fn(binding) {
                    match target.binding_spellings.lookup(binding) {
                      Holds { value: spelling } =>
                        Accepted { value: spelling, diagnostics: None }
                      Violates { diagnostic: d } =>
                        Rejected {
                          diagnostics: diagnostics_singleton(
                            d: translate_binding_spelling_not_found_diagnostic(binding: binding)
                          )
                        }
                    }
                  }
                )
              }
            )
          } else {
            lex_rules_literal_for_class(rules: target.lex, token_class: token_class)
          }
        }
      )
    }
  )
}
fn token_sequence_to_source(tokens: List<Node>, target: TargetModel) -> Outcome<TargetSource> {
  fold_list(
    xs: tokens,
    empty: Accepted { value: Empty, diagnostics: None },
    cons: fn(acc, token_node) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: partial, diagnostics: ad } =>
          match token_spelling_from_model(target: target, token: token_node) {
            Accepted { value: spelling, diagnostics: td } =>
              Accepted {
                value: string_append(left: partial, right: spelling),
                diagnostics: diagnostics_merge(outer: ad, inner: td)
              }
            Rejected { diagnostics: r } =>
              Rejected {
                diagnostics: rejected_with_pending(pending: ad, rejected: r)
              }
          }
      }
    }
  )
}
fn target_serialize_source_from_model(
  target: TargetModel,
  emitted: Node
) -> Outcome<TargetSource> {
  bind_outcome(
    o: grammar_inverse_source_validated(target: target, emitted: emitted),
    f: fn(_) {
      bind_outcome(
        o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
        f: fn(rules) {
          bind_outcome(
            o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
            f: fn(row) {
              bind_outcome(
                o: grammar_relation_row_tokens_root(row: row),
                f: fn(tokens_root) {
                  token_sequence_to_source(
                    tokens: conj_positional_targets(parent: tokens_root),
                    target: target
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}
fn target_bundle_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match fold(
        target.bundle.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: child, diagnostics: None }
        BundleChildMissing =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
        BundleChildDuplicate =>
          outcome_rejected(
            translate_target_bundle_duplicate_edge_diagnostic(
              target: target,
              edge_name: edge_name
            )
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
      }
    _ =>
      outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
  }
}
fn target_selection_priority_from_model(target: TargetModel) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_selection_policy),
    f: fn(priority_node) {
      Accepted {
        value: priority_node,
        diagnostics: None
      }
    }
  )
}
// `declared_inhabitants` edge names one Conj root on the target bundle; std/coercion flattens it
// via declared_inhabitant_candidates; find_witness enumerates that closed list as-is (no Conj walk).
fn coercion_candidates_from_target_model(
  target: TargetModel
) -> Outcome<CoercionCandidateSet> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_declared_inhabitants),
    f: fn(inhabitants_root) {
      coercion_candidate_set_from_declared_inhabitants(
        inhabitants_root: inhabitants_root,
        closedness_property: target_model_edge_declared_inhabitants
      )
    }
  )
}
fn coerce_grounded_node(
  source: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<CoercionResult> {
  bind_outcome(
    o: canonical_grounding_for_node(tree: tree, node: source),
    f: fn(grounding) {
      bind_outcome(
        o: target_selection_priority_from_model(target: target),
        f: fn(priority) {
          bind_outcome(
            o: coercion_candidates_from_target_model(
              target: target
            ),
            f: fn(candidates) {
              coercion_fold_with_declared_priority(
                source: grounding,
                candidates: candidates,
                priority: priority
              )
            }
          )
        }
      )
    }
  )
}
fn translate_coerced_shell(coerced: Node) -> Node {
  Node {
    kind: coerced.kind,
    children: []
  }
}
fn translate_fold_init(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match coerce_grounded_node(source: node, tree: tree, target: target) {
    Accepted { value: coerced, diagnostics: d } =>
      Accepted {
        value: translate_coerced_shell(coerced: coerced.target),
        diagnostics: d
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
// Zip-fold child reattachment — mirrors exact_structural_equality_zip_fold_predicate step.
fn translate_fold_step(
  acc: Outcome<Node>,
  edge: Edge,
  child: Outcome<Node>
) -> Outcome<Node> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: parent, diagnostics: ad } =>
      match child {
        Accepted { value: translated_child, diagnostics: cd } =>
          Accepted {
            value: Node {
              kind: parent.kind,
              children: list_push(
                parent.children,
                Edge { label: edge.label, target: translated_child }
              )
            },
            diagnostics: diagnostics_merge(outer: ad, inner: cd)
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: ad, rejected: r)
          }
      }
  }
}
fn translate_node(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) {
        translate_fold_init(node: n0, tree: tree, target: target)
      },
      step: fn(acc, e, child) {
        translate_fold_step(acc: acc, edge: e, child: child)
      }
    }
  )
}
// input_lang threaded at stage boundary (LanguageModel carrier); coercion uses TargetModel only.
fn translate(
  tree: InferredTree,
  target: TargetModel,
  input_lang: LanguageModel
) -> Outcome<TargetNodeTree> {
  bind_outcome(
    o: outcome_accepted(value: input_lang),
    f: fn(lang) {
      translate_node(node: tree.root, tree: tree, target: target)
    }
  )
}
