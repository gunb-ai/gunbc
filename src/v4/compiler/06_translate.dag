fn grammar_relation_row_emitted(row: Node) -> Outcome<Node> {
  conj_named_child(parent: row, edge_name: grammar_relation_field_emitted)
}
fn grammar_relation_row_tokens_root(row: Node) -> Outcome<Node> {
  conj_named_child(parent: row, edge_name: grammar_relation_field_tokens)
}
fn grammar_relation_row_for_emitted(rules: Node, emitted: Node) -> Outcome<Node> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      match fold(
        rules.children,
        init: Rejected {
          diagnostics: diagnostics_singleton(
            d: translate_grammar_relation_row_not_found_diagnostic(emitted: emitted)
          )
        },
        f: fn(acc, e) {
          match acc {
            Accepted { value: _, diagnostics: _ } => acc
            Rejected { diagnostics: _ } =>
              match e.label {
                Named { name: _ } =>
                  match grammar_relation_row_emitted(row: e.target) {
                    Accepted { value: row_emitted, diagnostics: rd } =>
                      if row_emitted == emitted {
                        Accepted { value: e.target, diagnostics: rd }
                      } else {
                        acc
                      }
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  }
                Positional => acc
              }
          }
        }
      ) {
        Accepted { value: row, diagnostics: d } =>
          Accepted { value: row, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    _ =>
      outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: emitted))
  }
}
// Bodied-arrow serialize: resolve scaffold from the translation-rules row that carries
// grammar_relation_field_bodied_scaffold — NOT grammar_inverse exact emitted-node match
// (producer-coerced signature slots differ from the fixture row's emitted field).
fn grammar_relation_row_with_bodied_scaffold(rules: Node) -> Outcome<Node> {
  match rules.kind {
    TypeNode { connective: Conj } =>
      match fold(
        rules.children,
        init: Rejected {
          diagnostics: diagnostics_singleton(
            d: translate_grammar_relation_row_not_found_diagnostic(
              emitted: rules
            )
          )
        },
        f: fn(acc, e) {
          match acc {
            Accepted { value: _, diagnostics: _ } => acc
            Rejected { diagnostics: _ } =>
              match e.label {
                Named { name: _ } =>
                  match find_named_child(
                    root: e.target,
                    name: grammar_relation_field_bodied_scaffold
                  ) {
                    Accepted { value: _, diagnostics: d } =>
                      Accepted { value: e.target, diagnostics: d }
                    Rejected { diagnostics: _ } => acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        Accepted { value: row, diagnostics: d } =>
          Accepted { value: row, diagnostics: d }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    _ =>
      outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: rules))
  }
}

fn grammar_relation_row_for_bodied_arrow_serialize(
  rules: Node,
  emitted: Node
) -> Outcome<TargetBodiedArrowStatementScaffold> {
  bind_outcome(
    o: grammar_relation_row_with_bodied_scaffold(rules: rules),
    f: fn(row) {
      bodied_arrow_scaffold_from_grammar_relation_row(row: row)
    }
  )
}

fn grammar_inverse_bodied_arrow_validated(
  target: TargetModel,
  emitted: Node
) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
    f: fn(rules) {
      bind_outcome(
        o: grammar_relation_row_for_bodied_arrow_serialize(rules: rules, emitted: emitted),
        f: fn(_) {
          outcome_accepted(emitted)
        }
      )
    }
  )
}
// E-9 bodied Arrow: signature slots coerce to raw target inhabitant carriers so
// grammar_inverse exact emitted-node match succeeds; shell wrapping is for binding
// projection sites, not grammar-row signature equality.
fn translate_bodied_arrow_coerce_signature_slot_raw(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match coerce_grounded_node(source: node, tree: tree, target: target) {
    Accepted { value: coerced, diagnostics: d } =>
      Accepted { value: coerced.target, diagnostics: d }
    Rejected { diagnostics: r } =>
      match canonical_grounding_for_node(tree: tree, node: node) {
        Accepted { value: grounding } =>
          if algebra_ref_is_grounded(algebra: grounding.witness.structural.evidence) {
            outcome_accepted(value: grounding.witness.structural.evidence)
          } else {
            Rejected { diagnostics: r }
          }
        Rejected { diagnostics: _ } => Rejected { diagnostics: r }
      }
  }
}

fn translate_bodied_arrow_coerce_signature_slots(
  arrow: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match arrow.kind {
    TypeNode { connective: Arrow } =>
      match fold(
        arrow.children,
        init: Accepted { value: Empty, diagnostics: None },
        f: fn(acc, edge) {
          match acc {
            Rejected { diagnostics: r } => acc
            Accepted { value: edges, diagnostics: d } =>
              match edge.label {
                Positional =>
                  bind_outcome(
                    o: translate_bodied_arrow_coerce_signature_slot_raw(
                      node: edge.target,
                      tree: tree,
                      target: target
                    ),
                    f: fn(coerced_slot) {
                      outcome_accepted(
                        list_snoc_item(
                          xs: edges,
                          item: Edge {
                            label: Positional,
                            target: coerced_slot
                          }
                        )
                      )
                    }
                  )
                Named { name: n } =>
                  if n == arrow_body_edge {
                    outcome_accepted(
                      list_snoc_item(xs: edges, item: edge)
                    )
                  } else {
                    outcome_rejected(
                      translate_grammar_relation_row_not_found_diagnostic(emitted: arrow)
                    )
                  }
              }
          }
        }
      ) {
        Accepted { value: children, diagnostics: d } =>
          outcome_accepted(
            value: node_rebuild(n: arrow, children: children)
          )
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    _ =>
      outcome_rejected(translate_grammar_relation_row_not_found_diagnostic(emitted: arrow))
  }
}
fn conj_positional_targets(parent: Node) -> Outcome<List<Node>> {
  match parent.kind {
    TypeNode { connective: Conj } =>
      Accepted {
        value: node_positional_child_targets(node: parent),
        diagnostics: None
      }
    _ =>
      outcome_rejected(
      translate_grammar_inverse_not_realized_diagnostic(emitted: parent)
      )
  }
}
fn optional_named_child_ignoring_positional(parent: Node, edge_name: Symbol) -> Outcome<Node?> {
  // Token-sequence dispatch items may be inner-production nodes with positional edges.
  match parent.kind {
    TypeNode { connective: Conj } =>
      match fold(
        parent.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          match acc {
            BundleChildInvalidEdge => acc
            BundleChildDuplicate => acc
            BundleChildMissing =>
              match e.label {
                Named { name: n } =>
                  if n == edge_name {
                    BundleChildFound { value: e.target }
                  } else {
                    acc
                  }
                Positional => acc
              }
            BundleChildFound { value: _ } =>
              match e.label {
                Named { name: n } =>
                  if n == edge_name {
                    BundleChildDuplicate
                  } else {
                    acc
                  }
                Positional => acc
              }
          }
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: Some { value: child }, diagnostics: None }
        BundleChildMissing =>
          Accepted { value: None, diagnostics: None }
        BundleChildDuplicate =>
          outcome_rejected(
            Diagnostic {
              reason: translate_target_bundle_duplicate_edge,
              at: node_locus(node: parent),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_conj_invalid_edge_diagnostic(parent: parent))
      }
    _ =>
      Accepted { value: None, diagnostics: None }
  }
}
fn concrete_token_class_child(parent: Node) -> Outcome<Node?> {
  optional_named_child_ignoring_positional(
    parent: parent,
    edge_name: concrete_syntax_token_field_class
  )
}
fn concrete_token_kind_child(parent: Node) -> Outcome<Node?> {
  optional_named_child_ignoring_positional(
    parent: parent,
    edge_name: concrete_syntax_token_field_kind
  )
}
// Single Symbol -> typed-variant decode boundary for concrete syntax tokens (T-11). The
// `concrete_syntax_token_kind_{fixed,bound}` wire tags are read exactly here; every downstream
// consumer (token_spelling_from_model, token_sequence_item_kind) dispatches structurally on the
// resulting ConcreteSyntaxToken carrier rather than re-comparing Symbols. Fail-closed: a kind that
// is neither fixed nor bound, a fixed token carrying a binding, or a bound token missing one is
// Rejected.
fn concrete_syntax_token_from_node(token: Node) -> Outcome<ConcreteSyntaxToken> {
  bind_outcome(
    o: conj_named_child(parent: token, edge_name: concrete_syntax_token_field_kind),
    f: fn(kind_node) {
      bind_outcome(
        o: node_atom_identity(node: kind_node),
        f: fn(kind) {
          bind_outcome(
            o: conj_named_child(parent: token, edge_name: concrete_syntax_token_field_class),
            f: fn(class_node) {
              bind_outcome(
                o: node_atom_identity(node: class_node),
                f: fn(token_class) {
                  bind_outcome(
                    o: conj_optional_named_child(
                      parent: token,
                      edge_name: concrete_syntax_token_field_binding
                    ),
                    f: fn(binding_node) {
                      if kind == concrete_syntax_token_kind_fixed {
                        match binding_node {
                          Some { value: _ } =>
                            outcome_rejected(
                              translate_concrete_token_kind_invalid_diagnostic(token: token)
                            )
                          None =>
                            Accepted {
                              value: FixedToken { token_class: token_class },
                              diagnostics: None
                            }
                        }
                      } else {
                        if kind == concrete_syntax_token_kind_bound {
                          match binding_node {
                            Some { value: binding_node } =>
                              bind_outcome(
                                o: node_atom_identity(node: binding_node),
                                f: fn(binding) {
                                  Accepted {
                                    value: BoundToken {
                                      token_class: token_class,
                                      binding: binding
                                    },
                                    diagnostics: None
                                  }
                                }
                              )
                            None =>
                              outcome_rejected(
                                translate_concrete_token_kind_invalid_diagnostic(token: token)
                              )
                          }
                        } else {
                          outcome_rejected(
                            translate_concrete_token_kind_invalid_diagnostic(token: token)
                          )
                        }
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}
fn token_sequence_item_kind(item: Node) -> Outcome<TokenSequenceItemKind> {
  bind_outcome(
    o: concrete_token_class_child(parent: item),
    f: fn(class_node) {
      bind_outcome(
        o: concrete_token_kind_child(parent: item),
        f: fn(kind_node) {
          match class_node {
            Some { value: _ } =>
              match kind_node {
                Some { value: _ } =>
                  // Class + kind both present: this is a concrete token iff it decodes into a
                  // FixedToken/BoundToken variant. Structural decode replaces the former
                  // Symbol-equality kind check (and additionally rejects malformed payloads).
                  bind_outcome(
                    o: concrete_syntax_token_from_node(token: item),
                    f: fn(_) {
                      Accepted { value: TokenSequenceConcreteToken, diagnostics: None }
                    }
                  )
                None =>
                  outcome_rejected(
                    translate_concrete_token_kind_invalid_diagnostic(token: item)
                  )
              }
            None =>
              match kind_node {
                Some { value: _ } =>
                  outcome_rejected(
                    translate_concrete_token_class_missing_diagnostic(token: item)
                  )
                None =>
                  Accepted { value: TokenSequenceNonterminal, diagnostics: None }
              }
          }
        }
      )
    }
  )
}
// Find a serialize_source's canonical `tokens` edge (the fold_list_node named-cons token
// sequence), if present. Folds the children directly so it is safe on either encoding —
// a node carrying the named tokens edge (lowered) or one with legacy positional token
// edges (returns Absent, the caller falls back to positional extraction).
fn serialize_source_tokens_fold_child(serialize_source: Node) -> Optional<Node> {
  fold(
    serialize_source.children,
    init: Absent,
    f: fn(acc, e) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match e.label {
            Named { name: n } =>
              if n == grammar_relation_field_tokens { Present { value: e.target } } else { acc }
            Positional => acc
          }
      }
    }
  )
}
// Walk a fold_list_node named-cons chain (Conj{Named head, Named tail} cells terminating
// in an empty Conj) to the List of head targets. Self-contained (no decode_item convention).
fn serialize_source_fold_list_targets(remaining: Int, node: Node) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
  } else {
    match node.kind {
      TypeNode { connective: Conj } =>
        if is_empty(xs: node.children) {
          Accepted { value: Empty, diagnostics: None }
        } else {
          bind_outcome(
            o: conj_named_child(parent: node, edge_name: fold_list_node_head),
            f: fn(head) {
              bind_outcome(
                o: conj_named_child(parent: node, edge_name: fold_list_node_tail),
                f: fn(tail) {
                  bind_outcome(
                    o: serialize_source_fold_list_targets(remaining: remaining - 1, node: tail),
                    f: fn(rest) {
                      Accepted { value: Cons { head: head, tail: rest }, diagnostics: None }
                    }
                  )
                }
              )
            }
          )
        }
      _ => outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
    }
  }
}
// Token-target sequence of a serialize_source, transparent over the token encoding: a
// canonical fold_list_node named-cons tokens edge is walked as a fold_list; a legacy
// serialize_source with positional token edges falls back to its positional targets.
fn serialize_source_token_targets(serialize_source: Node) -> Outcome<List<Node>> {
  match serialize_source_tokens_fold_child(serialize_source: serialize_source) {
    Present { value: tokens_fold } =>
      serialize_source_fold_list_targets(
        remaining: node_subtree_count(n: tokens_fold),
        node: tokens_fold
      )
    Absent =>
      conj_positional_targets(parent: serialize_source)
  }
}
// Token-target sequence of a grammar-relation `tokens` node (the fold_list_node spine from
// grammar_relation_tokens_node after B5, or legacy positional-Conj token edges).
fn grammar_tokens_node_targets(tokens_node: Node) -> Outcome<List<Node>> {
  bind_outcome(
    o: optional_named_child_ignoring_positional(
      parent: tokens_node,
      edge_name: fold_list_node_head
    ),
    f: fn(maybe_head) {
      match maybe_head {
        Some { value: _ } =>
          serialize_source_fold_list_targets(
            remaining: node_subtree_count(n: tokens_node),
            node: tokens_node
          )
        None =>
          conj_positional_targets(parent: tokens_node)
      }
    }
  )
}
fn grammar_serialize_source_matches_row(
  serialize_source: Node,
  row: Node
) -> Outcome<Node> {
  if well_formed(n: serialize_source) {
    bind_outcome(
      o: grammar_relation_row_tokens_root(row: row),
      f: fn(tokens_root) {
        bind_outcome(
          o: serialize_source_token_targets(serialize_source: serialize_source),
          f: fn(source_targets) {
            bind_outcome(
              o: grammar_tokens_node_targets(tokens_node: tokens_root),
              f: fn(row_targets) {
                if zip_eq(a: source_targets, b: row_targets, eq: fn(x, y) { x == y }) {
                  Accepted { value: serialize_source, diagnostics: None }
                } else {
                  outcome_rejected(
                    translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
                  )
                }
              }
            )
          }
        )
      }
    )
  } else {
    outcome_rejected(
      translate_grammar_inverse_not_realized_diagnostic(emitted: serialize_source)
    )
  }
}
fn grammar_inverse_source_validated(
  target: TargetModel,
  emitted: Node
) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
    f: fn(rules) {
      bind_outcome(
        o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
        f: fn(row) {
          bind_outcome(
            o: target_bundle_child(target: target, edge_name: target_model_edge_serialize_source),
            f: fn(serialize_source) {
              grammar_serialize_source_matches_row(
                serialize_source: serialize_source,
                row: row
              )
            }
          )
        }
      )
    }
  )
}
fn serialize_concrete_syntax_tokens_to_source(
  target: TargetModel,
  tokens: List<ConcreteSyntaxToken>
) -> Outcome<TargetSource> {
  fold_list(
    xs: tokens,
    empty: Accepted { value: Empty, diagnostics: None },
    cons: fn(acc, token) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: partial, diagnostics: ad } =>
          match token {
            FixedToken { token_class: token_class } =>
              bind_outcome(
                o: lex_rules_literal_for_class(rules: target.lex, token_class: token_class),
                f: fn(spelling) {
                  Accepted {
                    value: list_append(left: partial, right: spelling),
                    diagnostics: ad
                  }
                }
              )
            BoundToken { token_class: _, binding: binding } =>
              match map_get(target.binding_spellings, binding) {
                Accepted { value: opt, diagnostics: pending } =>
                  match opt {
                    Present { value: spelling } =>
                      Accepted {
                        value: list_append(left: partial, right: spelling),
                        diagnostics: diagnostics_merge(outer: ad, inner: pending)
                      }
                    Absent =>
                      Rejected {
                        diagnostics: rejected_with_pending(
                          pending: ad,
                          rejected: diagnostics_singleton(
                            d: translate_binding_spelling_not_found_diagnostic(binding: binding)
                          )
                        )
                      }
                  }
                Rejected { diagnostics: r } =>
                  Rejected {
                    diagnostics: rejected_with_pending(pending: ad, rejected: r)
                  }
              }
          }
      }
    }
  )
}

fn target_serialize_bodied_arrow_from_model(
  target: TargetModel,
  emitted: Node
) -> Outcome<TargetSource> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
    f: fn(rules) {
      bind_outcome(
        o: grammar_relation_row_for_bodied_arrow_serialize(rules: rules, emitted: emitted),
        f: fn(scaffold) {
          bind_outcome(
            o: value_expression_projection_from_target(target: target),
            f: fn(projection) {
              bind_outcome(
                o: project_arrow_body_to_value_expression(arrow: emitted),
                f: fn(expr) {
                  bind_outcome(
                    o: value_expression_to_concrete_tokens(
                      expr: expr,
                      target: target,
                      projection: projection
                    ),
                    f: fn(body_tokens) {
                      serialize_concrete_syntax_tokens_to_source(
                        target: target,
                        tokens: target_bodied_arrow_compose_statement_tokens(
                          scaffold: scaffold,
                          body: body_tokens
                        )
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_serialize_relation_row_from_model_bounded(
  remaining: Int,
  target: TargetModel,
  emitted: Node
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else if arrow_has_transform_body(arrow: emitted) {
    target_serialize_bodied_arrow_from_model(target: target, emitted: emitted)
  } else {
    bind_outcome(
      o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
      f: fn(rules) {
        bind_outcome(
          o: grammar_relation_row_for_emitted(rules: rules, emitted: emitted),
          f: fn(row) {
            bind_outcome(
              o: grammar_relation_row_tokens_root(row: row),
              f: fn(tokens_root) {
                bind_outcome(
                  o: grammar_tokens_node_targets(tokens_node: tokens_root),
                  f: fn(tokens) {
                    fold_list(
                      xs: tokens,
                      empty: Accepted { value: Empty, diagnostics: None },
                      cons: fn(acc, token_node) {
                        match acc {
                          Rejected { diagnostics: r } => Rejected { diagnostics: r }
                          Accepted { value: partial, diagnostics: ad } =>
                            match token_sequence_item_kind(item: token_node) {
                              Accepted { value: TokenSequenceConcreteToken, diagnostics: kd } =>
                                match token_spelling_from_model(target: target, token: token_node) {
                                  Accepted { value: source, diagnostics: td } =>
                                    Accepted {
                                      value: list_append(left: partial, right: source),
                                      diagnostics: diagnostics_merge(
                                        outer: diagnostics_merge(outer: ad, inner: kd),
                                        inner: td
                                      )
                                    }
                                  Rejected { diagnostics: r } =>
                                    Rejected {
                                      diagnostics: rejected_with_pending(
                                        pending: diagnostics_merge(outer: ad, inner: kd),
                                        rejected: r
                                      )
                                    }
                                }
                              Accepted { value: TokenSequenceNonterminal, diagnostics: kd } =>
                                match target_serialize_relation_row_from_model_bounded(
                                  remaining - 1,
                                  target,
                                  token_node
                                ) {
                                  Accepted { value: source, diagnostics: td } =>
                                    Accepted {
                                      value: list_append(left: partial, right: source),
                                      diagnostics: diagnostics_merge(
                                        outer: diagnostics_merge(outer: ad, inner: kd),
                                        inner: td
                                      )
                                    }
                                  Rejected { diagnostics: r } =>
                                    Rejected {
                                      diagnostics: rejected_with_pending(
                                        pending: diagnostics_merge(outer: ad, inner: kd),
                                        rejected: r
                                      )
                                    }
                                }
                              Rejected { diagnostics: r } =>
                                Rejected {
                                  diagnostics: rejected_with_pending(pending: ad, rejected: r)
                                }
                            }
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}
fn translate_lex_rule_literal_not_found_diagnostic(token_class: Symbol) -> Diagnostic {
  Diagnostic {
    reason: translate_lex_rule_literal_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: token_class } },
      children: [],
      span: Unanchored
}),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_binding_spelling_not_found_diagnostic(binding: Symbol) -> Diagnostic {
  Diagnostic {
    reason: translate_binding_spelling_not_found,
    at: node_locus(node: Node {
      kind: TypeNode { connective: Atom { identity: binding } },
      children: [],
      span: Unanchored
}),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn node_atom_identity(node: Node) -> Outcome<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      Accepted { value: id, diagnostics: None }
    _ =>
      outcome_rejected(translate_grammar_inverse_not_realized_diagnostic(emitted: node))
  }
}
fn lex_rule_literal_step(
  acc: Outcome<String>,
  rule: LexRule,
  token_class: Symbol
) -> Outcome<String> {
  match acc {
    Accepted { value: _, diagnostics: _ } => acc
    Rejected { diagnostics: _ } =>
      match rule {
        TokenRule { token_class: c, pattern: pattern } =>
          if c == token_class {
            match pattern {
              LiteralPattern { text: text } =>
                Accepted { value: text, diagnostics: None }
              KeywordPattern { text: text } =>
                Accepted { value: text, diagnostics: None }
              _ =>
                Rejected {
                  diagnostics: diagnostics_singleton(
                    d: translate_lex_rule_literal_not_found_diagnostic(
                      token_class: token_class
                    )
                  )
                }
            }
          } else {
            acc
          }
        TriviaRule { pattern: _ } => acc
      }
  }
}
fn lex_rules_literal_for_class(rules: LexRules, token_class: Symbol) -> Outcome<String> {
  match rules {
    VoidLexRules =>
      outcome_rejected(
        translate_lex_rule_literal_not_found_diagnostic(token_class: token_class)
      )
    ModeledLexRules { root: set } =>
      fold_list(
        xs: set.rules,
        empty: Rejected {
          diagnostics: diagnostics_singleton(
            d: translate_lex_rule_literal_not_found_diagnostic(token_class: token_class)
          )
        },
        cons: fn(acc, rule) {
          lex_rule_literal_step(acc: acc, rule: rule, token_class: token_class)
        }
      )
  }
}
fn token_spelling_from_model(target: TargetModel, token: Node) -> Outcome<String> {
  bind_outcome(
    o: concrete_syntax_token_from_node(token: token),
    f: fn(decoded) {
      match decoded {
        FixedToken { token_class: token_class } =>
          lex_rules_literal_for_class(rules: target.lex, token_class: token_class)
        BoundToken { token_class: _, binding: binding } =>
          // 🟡 gated — bootstrap-limitation interim — feature:B-LOOKUP-1 — map_get(Option<V>); dissolve-on: bootstrap Witness<V> generic dispatch for Map.lookup (substrate already Witness at v4.std.collection:27); site: binding_spellings
          match map_get(target.binding_spellings, binding) {
            Accepted { value: opt, diagnostics: pending } => match opt {
              Present { value: spelling } =>
                Accepted { value: spelling, diagnostics: pending }
              Absent =>
                Rejected {
                  diagnostics: rejected_with_pending(
                    pending: pending,
                    rejected: diagnostics_singleton(
                      d: translate_binding_spelling_not_found_diagnostic(binding: binding)
                    )
                  )
                }
            }
            Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
          }
      }
    }
  )
}
fn token_item_to_source_bounded(
  remaining: Int,
  item: Node,
  target: TargetModel
) -> Outcome<TargetSource> {
  bind_outcome(
    o: token_sequence_item_kind(item: item),
    f: fn(item_kind) {
      match item_kind {
        TokenSequenceConcreteToken =>
          token_spelling_from_model(target: target, token: item)
        TokenSequenceNonterminal =>
          target_serialize_relation_row_from_model_bounded(remaining - 1, target, item)
      }
    }
  )
}
fn token_item_to_source(item: Node, target: TargetModel) -> Outcome<TargetSource> {
  bind_outcome(
    o: token_item_serialize_measure(item: item, target: target),
    f: fn(measure) {
      token_item_to_source_bounded(measure, item, target)
    }
  )
}
fn token_sequence_to_source_bounded(
  remaining: Int,
  tokens: List<Node>,
  target: TargetModel
) -> Outcome<TargetSource> {
  fold_list(
    xs: tokens,
    empty: Accepted { value: Empty, diagnostics: None },
    cons: fn(acc, token_node) {
      match acc {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: partial, diagnostics: ad } =>
          match token_item_to_source_bounded(remaining - 1, token_node, target) {
            Accepted { value: source, diagnostics: td } =>
              Accepted {
                value: list_append(left: partial, right: source),
                diagnostics: diagnostics_merge(outer: ad, inner: td)
              }
            Rejected { diagnostics: r } =>
              Rejected {
                diagnostics: rejected_with_pending(pending: ad, rejected: r)
              }
          }
      }
    }
  )
}
fn token_sequence_to_source(tokens: List<Node>, target: TargetModel) -> Outcome<TargetSource> {
  bind_outcome(
    o: token_sequence_serialize_measure(tokens: tokens, target: target),
    f: fn(measure) {
      token_sequence_to_source_bounded(measure, tokens, target)
    }
  )
}
// Shape-A MVP-1 grammar-inverse serialize via token_sequence_to_source for all five
// Shape-A targets (rust/python/go/cpp/typescript TestClaims). TargetModel.authority_source_text
// must not substitute for validated emitted Node serialization.
fn target_serialize_source_from_model_bounded(
  remaining: Int,
  target: TargetModel,
  emitted: Node
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else if arrow_has_transform_body(arrow: emitted) {
    target_serialize_bodied_arrow_from_model(target: target, emitted: emitted)
  } else {
    match target_type_expr_emitted_kind(node: emitted) {
      TypeExprKindAuthority { value: _ } =>
        bind_outcome(
          o: type_expression_projection_from_target(target: target),
          f: fn(projection) {
            serialize_type_expr_emitted_bounded(
              remaining: remaining - 1,
              target: target,
              projection: projection,
              emitted: emitted
            )
          }
        )
      TypeExprKindNotEmitted =>
        bind_outcome(
          o: grammar_inverse_source_validated(target: target, emitted: emitted),
          f: fn(_) {
            target_serialize_relation_row_from_model_bounded(remaining - 1, target, emitted)
          }
        )
      TypeExprKindAuthorityInvalid =>
        outcome_rejected(
          translate_type_expr_kind_authority_invalid_diagnostic(node: emitted)
        )
    }
  }
}
fn target_serialize_source_from_model(
  target: TargetModel,
  emitted: Node
) -> Outcome<TargetSource> {
  bind_outcome(
    o: translate_serialize_measure(target: target, emitted: emitted),
    f: fn(measure) {
      target_serialize_source_from_model_bounded(measure, target, emitted)
    }
  )
}
fn target_bundle_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match fold(
        target.bundle.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: child, diagnostics: None }
        BundleChildMissing =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
        BundleChildDuplicate =>
          outcome_rejected(
            translate_target_bundle_duplicate_edge_diagnostic(
              target: target,
              edge_name: edge_name
            )
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
      }
    _ =>
      outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
  }
}
fn target_bundle_optional_child(target: TargetModel, edge_name: Symbol) -> Outcome<Node?> {
  match target.bundle.kind {
    TypeNode { connective: Conj } =>
      match fold(
        target.bundle.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: Some { value: child }, diagnostics: None }
        BundleChildMissing =>
          Accepted { value: None, diagnostics: None }
        BundleChildDuplicate =>
          outcome_rejected(
            translate_target_bundle_duplicate_edge_diagnostic(
              target: target,
              edge_name: edge_name
            )
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
      }
    _ =>
      outcome_rejected(translate_target_bundle_malformed_diagnostic(target: target))
  }
}
fn target_selection_priority_from_model(target: TargetModel) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_selection_policy),
    f: fn(priority_node) {
      Accepted {
        value: priority_node,
        diagnostics: None
      }
    }
  )
}
fn coercion_candidates_from_target_model(
  target: TargetModel
) -> Outcome<CoercionCandidateSet> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_declared_inhabitants),
    f: fn(inhabitants_root) {
      coercion_candidate_set_from_declared_inhabitants(
        inhabitants_root: inhabitants_root,
        closedness_property: target_model_edge_declared_inhabitants
      )
    }
  )
}
fn coerce_grounded_node(
  source: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<CoercionResult> {
  bind_outcome(
    o: canonical_grounding_for_node(tree: tree, node: source),
    f: fn(grounding) {
      bind_outcome(
        o: target_selection_priority_from_model(target: target),
        f: fn(priority) {
          bind_outcome(
            o: coercion_candidates_from_target_model(
              target: target
            ),
            f: fn(candidates) {
              coercion_fold_with_declared_priority(
                source: grounding,
                candidates: candidates,
                priority: priority
              )
            }
          )
        }
      )
    }
  )
}
fn translate_type_expression_shape_missing_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: translate_type_expression_shape_missing,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_type_expr_kind_authority_invalid_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: translate_type_expr_kind_authority_invalid,
    at: node_locus(node: node),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn type_expr_shape_symbol(parent: Node, field: Symbol) -> Outcome<Symbol> {
  bind_outcome(
    o: conj_named_child(parent: parent, edge_name: field),
    f: fn(child) { node_atom_identity(node: child) }
  )
}

fn type_expr_optional_shape_symbol(parent: Node, field: Symbol) -> Outcome<Optional<Symbol>> {
  bind_outcome(
    o: conj_optional_named_child(parent: parent, edge_name: field),
    f: fn(child) {
      match child {
        Some { value: n } =>
          bind_outcome(
            o: node_atom_identity(node: n),
            f: fn(sym) { outcome_accepted(optional_present(value: sym)) }
          )
        None => outcome_accepted(optional_absent())
      }
    }
  )
}

fn type_expr_atom_shape_from_node(node: Node) -> Outcome<TargetAtomTypeShape> {
  bind_outcome(
    o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_ident_token),
        f: fn(ident_token) {
          Accepted {
            value: TargetAtomTypeShape { surface: surface, ident_token: ident_token },
            diagnostics: None
          }
        }
      )
    }
  )
}
fn type_expr_generic_apply_shape_from_node(node: Node) -> Outcome<TargetGenericApply> {
  bind_outcome(
    o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_separator),
            f: fn(separator) {
              bind_outcome(
                o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_close),
                f: fn(close) {
                  bind_outcome(
                    o: type_expr_optional_shape_symbol(parent: node, field: target_type_expr_field_field_label_separator),
                    f: fn(field_label_separator) {
                      Accepted {
                        value: TargetGenericApply {
                          surface: surface,
                          open: open,
                          separator: separator,
                          field_label_separator: field_label_separator,
                          close: close
                        },
                        diagnostics: None
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}
fn type_expr_sum_shape_from_node(node: Node) -> Outcome<TargetSumTypeShape> {
  bind_outcome(
    o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_variant_separator),
        f: fn(variant_separator) {
          Accepted {
            value: TargetSumTypeShape {
              surface: surface,
              variant_separator: variant_separator
            },
            diagnostics: None
          }
        }
      )
    }
  )
}
fn type_expr_arrow_shape_from_node(node: Node) -> Outcome<TargetFunctionTypeShape> {
  bind_outcome(
    o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_surface),
    f: fn(surface) {
      bind_outcome(
        o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_close),
            f: fn(close) {
              bind_outcome(
                o: type_expr_shape_symbol(parent: node, field: target_type_expr_field_arrow),
                f: fn(arrow) {
                  bind_outcome(
                    o: type_expr_shape_symbol(
                      parent: node,
                      field: target_type_expr_field_param_ident_token
                    ),
                    f: fn(param_ident_token) {
                      bind_outcome(
                        o: type_expr_shape_symbol(
                          parent: node,
                          field: target_type_expr_field_param_type_separator
                        ),
                        f: fn(param_type_separator) {
                          bind_outcome(
                            o: type_expr_shape_symbol(
                              parent: node,
                              field: target_type_expr_field_param_list_separator
                            ),
                            f: fn(param_list_separator) {
                              Accepted {
                                value: TargetFunctionTypeShape {
                                  surface: surface,
                                  open: open,
                                  close: close,
                                  arrow: arrow,
                                  param_ident_token: param_ident_token,
                                  param_type_separator: param_type_separator,
                                  param_list_separator: param_list_separator
                                },
                                diagnostics: None
                              }
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}
fn type_expression_projection_from_bundle(bundle: Node) -> Outcome<TargetTypeExpressionProjection> {
  bind_outcome(
    o: conj_named_child(parent: bundle, edge_name: target_type_expr_field_atom),
    f: fn(atom_node) {
      bind_outcome(
        o: type_expr_atom_shape_from_node(node: atom_node),
        f: fn(atom_form) {
          bind_outcome(
            o: conj_named_child(parent: bundle, edge_name: target_type_expr_field_conj),
            f: fn(conj_node) {
              bind_outcome(
                o: type_expr_generic_apply_shape_from_node(node: conj_node),
                f: fn(conj_form) {
                  bind_outcome(
                    o: conj_named_child(parent: bundle, edge_name: target_type_expr_field_disj),
                    f: fn(disj_node) {
                      bind_outcome(
                        o: type_expr_sum_shape_from_node(node: disj_node),
                        f: fn(disj_form) {
                          bind_outcome(
                            o: conj_named_child(parent: bundle, edge_name: target_type_expr_field_arrow),
                            f: fn(arrow_node) {
                              bind_outcome(
                                o: type_expr_arrow_shape_from_node(node: arrow_node),
                                f: fn(arrow_form) {
                                  bind_outcome(
                                    o: conj_named_child(parent: bundle, edge_name: target_type_expr_field_cardinality),
                                    f: fn(card_node) {
                                      bind_outcome(
                                        o: type_expr_generic_apply_shape_from_node(node: card_node),
                                        f: fn(cardinality_form) {
                                          bind_outcome(
                                            o: conj_named_child(parent: bundle, edge_name: target_type_expr_field_instantiation),
                                            f: fn(inst_node) {
                                              bind_outcome(
                                                o: type_expr_generic_apply_shape_from_node(node: inst_node),
                                                f: fn(instantiation_form) {
                                                  Accepted {
                                                    value: TargetTypeExpressionProjection {
                                                      atom_form: atom_form,
                                                      conj_form: conj_form,
                                                      disj_form: disj_form,
                                                      arrow_form: arrow_form,
                                                      cardinality_form: cardinality_form,
                                                      instantiation_form: instantiation_form
                                                    },
                                                    diagnostics: None
                                                  }
                                                }
                                              )
                                            }
                                          )
                                        }
                                      )
                                    }
                                  )
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}
fn type_expression_projection_from_target(target: TargetModel) -> Outcome<TargetTypeExpressionProjection> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_type_expression_projection),
    f: fn(bundle) { type_expression_projection_from_bundle(bundle: bundle) }
  )
}

fn target_collection_repr_from_node(node: Node) -> Outcome<TargetRepresentation> {
  bind_outcome(
    o: conj_named_child(parent: node, edge_name: target_collection_repr_field_kind),
    f: fn(kind_node) {
      bind_outcome(
        o: node_atom_identity(node: kind_node),
        f: fn(kind_sym) {
          match target_collection_repr_kind_from_atom(id: kind_sym) {
            Present { value: kind } =>
              bind_outcome(
                o: conj_named_child(parent: node, edge_name: target_collection_repr_field_apply),
                f: fn(apply_node) {
                  bind_outcome(
                    o: type_expr_generic_apply_shape_from_node(node: apply_node),
                    f: fn(apply) {
                      Accepted {
                        value: TargetRepresentation { kind: kind, apply: apply },
                        diagnostics: None
                      }
                    }
                  )
                }
              )
            Absent =>
              outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
          }
        }
      )
    }
  )
}

fn target_collection_witness_from_node(node: Node) -> Outcome<RequiredTraitWitness> {
  bind_outcome(
    o: conj_named_child(parent: node, edge_name: target_collection_witness_field_trait_name),
    f: fn(trait_node) {
      bind_outcome(
        o: node_atom_identity(node: trait_node),
        f: fn(trait_name) {
          bind_outcome(
            o: conj_named_child(parent: node, edge_name: target_collection_witness_field_type_param),
            f: fn(param_node) {
              bind_outcome(
                o: node_atom_identity(node: param_node),
                f: fn(type_param) {
                  if trait_name == target_collection_trait_ord {
                    Accepted {
                      value: TargetCollectionWitnessOrd { type_param: type_param },
                      diagnostics: None
                    }
                  } else {
                    if trait_name == target_collection_trait_hash {
                      Accepted {
                        value: TargetCollectionWitnessHash { type_param: type_param },
                        diagnostics: None
                      }
                    } else {
                      if trait_name == target_collection_trait_eq {
                        Accepted {
                          value: TargetCollectionWitnessEq { type_param: type_param },
                          diagnostics: None
                        }
                      } else {
                        outcome_rejected(
                          translate_type_expression_shape_missing_diagnostic(node: node)
                        )
                      }
                    }
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_collection_fold_list_from_node<T>(
  remaining: Int,
  node: Node,
  decode_item: fn(Node) -> Outcome<T>
) -> Outcome<List<T>> {
  if remaining <= 0 {
    outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  } else {
  match node.kind {
    TypeNode { connective: Conj } =>
      if is_empty(xs: node.children) {
        Accepted { value: Empty, diagnostics: None }
      } else {
        bind_outcome(
          o: conj_named_child(parent: node, edge_name: fold_list_node_head),
          f: fn(head_node) {
            bind_outcome(
              o: decode_item(node: head_node),
              f: fn(head_item) {
                bind_outcome(
                  o: conj_named_child(parent: node, edge_name: fold_list_node_tail),
                  f: fn(tail_node) {
                    bind_outcome(
                      o: target_collection_fold_list_from_node(
                        remaining: remaining - 1,
                        node: tail_node,
                        decode_item: decode_item
                      ),
                      f: fn(tail_items) {
                        Accepted {
                          value: Cons { head: head_item, tail: tail_items },
                          diagnostics: None
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    _ => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
  }
}

fn target_collection_choice_from_node(node: Node) -> Outcome<TargetRepresentationChoice> {
  bind_outcome(
    o: conj_named_child(parent: node, edge_name: target_collection_choice_field_form),
    f: fn(form_node) {
      bind_outcome(
        o: target_collection_repr_from_node(node: form_node),
        f: fn(form) {
          bind_outcome(
            o: conj_named_child(parent: node, edge_name: target_collection_choice_field_constraints),
            f: fn(constraints_node) {
              bind_outcome(
                o: target_collection_fold_list_from_node(
                  remaining: node_subtree_count(n: constraints_node),
                  node: constraints_node,
                  decode_item: target_collection_witness_from_node
                ),
                f: fn(constraints) {
                  Accepted {
                    value: TargetRepresentationChoice {
                      form: form,
                      constraints: constraints
                    },
                    diagnostics: None
                  }
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_collection_fallback_from_node(node: Node) -> Outcome<Diagnostic> {
  bind_outcome(
    o: node_atom_identity(node: node),
    f: fn(reason) {
      if reason == target_collection_set_no_representation {
        Accepted {
          value: target_collection_set_no_representation_diagnostic(),
          diagnostics: None
        }
      } else {
        if reason == target_collection_free_monoid_no_representation {
          Accepted {
            value: target_collection_free_monoid_no_representation_diagnostic(),
            diagnostics: None
          }
        } else {
          outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        }
      }
    }
  )
}

fn target_collection_realization_from_bundle(
  bundle: Node
) -> Outcome<TargetCollectionRealization> {
  bind_outcome(
    o: conj_named_child(parent: bundle, edge_name: target_collection_row_field_source_carrier),
    f: fn(source_carrier) {
      bind_outcome(
        o: conj_named_child(parent: bundle, edge_name: target_collection_row_field_primary),
        f: fn(primary_node) {
          bind_outcome(
            o: target_collection_choice_from_node(node: primary_node),
            f: fn(primary) {
              bind_outcome(
                o: conj_named_child(parent: bundle, edge_name: target_collection_row_field_alternatives),
                f: fn(alternatives_node) {
                  bind_outcome(
                    o: target_collection_fold_list_from_node(
                      remaining: node_subtree_count(n: alternatives_node),
                      node: alternatives_node,
                      decode_item: target_collection_choice_from_node
                    ),
                    f: fn(alternatives) {
                      bind_outcome(
                        o: conj_named_child(parent: bundle, edge_name: target_collection_row_field_fallback),
                        f: fn(fallback_node) {
                          bind_outcome(
                            o: target_collection_fallback_from_node(node: fallback_node),
                            f: fn(fallback_diagnostic) {
                              Accepted {
                                value: TargetCollectionRealization {
                                  source_carrier: source_carrier,
                                  primary: primary,
                                  alternatives: alternatives,
                                  fallback_diagnostic: fallback_diagnostic
                                },
                                diagnostics: None
                              }
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn collection_realization_from_target(target: TargetModel) -> Outcome<TargetCollectionRealization> {
  collection_realization_from_target_carrier(
    target: target,
    expected_source_carrier: target_collection_set_carrier_node()
  )
}

fn free_monoid_collection_realization_from_target(
  target: TargetModel
) -> Outcome<TargetCollectionRealization> {
  collection_realization_from_target_carrier(
    target: target,
    expected_source_carrier: target_carrier_free_monoid_node()
  )
}

fn collection_realization_from_target_carrier(
  target: TargetModel,
  expected_source_carrier: Node
) -> Outcome<TargetCollectionRealization> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_collection_realization),
    f: fn(catalog_node) {
      bind_outcome(
        o: target_collection_fold_list_from_node(
          remaining: node_subtree_count(n: catalog_node),
          node: catalog_node,
          decode_item: fn(row_node) {
            target_collection_realization_from_bundle(bundle: row_node)
          }
        ),
        f: fn(rows) {
          target_collection_realization_lookup_in_catalog(
            catalog: rows,
            source_carrier: expected_source_carrier
          )
        }
      )
    }
  )
}

fn project_set_collection_type_node_impl(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  match target_collection_set_element_type_node(set_node: node) {
    Present { value: elem } =>
      bind_outcome(
        o: collection_realization_from_target(target: target),
        f: fn(row) {
          match target_collection_select_choice(
            primary: row.primary,
            alternatives: row.alternatives,
            elem: elem
          ) {
            Present { value: choice } =>
              bind_outcome(
                o: project_type_expression_node_bounded(
                  remaining: node_subtree_count(n: elem),
                  node: elem,
                  target: target,
                  projection: projection
                ),
                f: fn(elem_projected) {
                  Accepted {
                    value: target_type_expr_instantiation_emitted(
                      form: choice.form.apply,
                      head: target_type_expr_atom_emitted(
                        form: projection.atom_form,
                        identity: choice.form.apply.surface
                      ),
                      args: Cons { head: elem_projected, tail: Empty }
                    ),
                    diagnostics: None
                  }
                }
              )
            Absent => outcome_rejected(row.fallback_diagnostic)
          }
        }
      )
    Absent =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}

fn project_set_collection_type_node(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  project_set_collection_type_node_impl(
    node: node,
    target: target,
    projection: projection
  )
}

fn project_free_monoid_collection_type_node(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  match target_collection_free_monoid_element_type_node(free_monoid_node: node) {
    Present { value: elem } =>
      bind_outcome(
        o: free_monoid_collection_realization_from_target(target: target),
        f: fn(row) {
          match target_collection_select_choice(
            primary: row.primary,
            alternatives: row.alternatives,
            elem: elem
          ) {
            Present { value: choice } =>
              bind_outcome(
                o: project_type_expression_node_bounded(
                  remaining: node_subtree_count(n: elem),
                  node: elem,
                  target: target,
                  projection: projection
                ),
                f: fn(elem_projected) {
                  bind_outcome(
                    o: translate_apply_use_site_ownership_to_projected_type(
                      projected: elem_projected,
                      source_carrier: elem,
                      target: target,
                      use_site: OwnershipAtBindingProjection
                    ),
                    f: fn(elem_storage) {
                      Accepted {
                        value: target_type_expr_instantiation_emitted(
                          form: choice.form.apply,
                          head: target_type_expr_atom_emitted(
                            form: projection.atom_form,
                            identity: choice.form.apply.surface
                          ),
                          args: Cons { head: elem_storage, tail: Empty }
                        ),
                        diagnostics: None
                      }
                    }
                  )
                }
              )
            Absent => outcome_rejected(row.fallback_diagnostic)
          }
        }
      )
    Absent =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}
type TypeExprHeadTail {
  head: Node
  tail: List<Node>
}
type EdgeHeadTail {
  head: Edge
  tail: List<Edge>
}
fn edge_list_head_and_tail(edges: List<Edge>, node: Node) -> Outcome<EdgeHeadTail> {
  match list_at_optional(xs: edges, index: 0) {
    Present { value: head } =>
      match list_tail(xs: edges) {
        TailAbsent =>
          outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        TailFound { tail: t } =>
          Accepted { value: EdgeHeadTail { head: head, tail: t }, diagnostics: None }
      }
    Absent =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}
type TypeExprArrowSplit {
  inputs: List<Node>
  output: Node
}
fn type_expr_arrow_split_from_types_bounded(
  remaining: Int,
  types: List<Node>,
  node: Node
) -> Outcome<TypeExprArrowSplit> {
  if remaining <= 0 {
    outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  } else {
    bind_outcome(
      o: list_head_and_tail(xs: types, node: node),
      f: fn(split) {
        if is_empty(xs: split.tail) {
          outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        } else {
          bind_outcome(
            o: list_head_and_tail(xs: split.tail, node: node),
            f: fn(rest) {
              if is_empty(xs: rest.tail) {
                Accepted {
                  value: TypeExprArrowSplit {
                    inputs: Cons { head: split.head, tail: Empty },
                    output: rest.head
                  },
                  diagnostics: None
                }
              } else {
                bind_outcome(
                  o: type_expr_arrow_split_from_types_bounded(
                    remaining: remaining - 1,
                    types: split.tail,
                    node: node
                  ),
                  f: fn(inner) {
                    Accepted {
                      value: TypeExprArrowSplit {
                        inputs: Cons { head: split.head, tail: inner.inputs },
                        output: inner.output
                      },
                      diagnostics: None
                    }
                  }
                )
              }
            }
          )
        }
      }
    )
  }
}
fn type_expr_arrow_split_from_types(
  types: List<Node>,
  node: Node
) -> Outcome<TypeExprArrowSplit> {
  type_expr_arrow_split_from_types_bounded(
    remaining: length(xs: types),
    types: types,
    node: node
  )
}
fn list_head_and_tail(xs: List<Node>, node: Node) -> Outcome<TypeExprHeadTail> {
  match list_at_optional(xs: xs, index: 0) {
    Absent =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
    Present { value: head } =>
      match list_tail(xs: xs) {
        TailAbsent =>
          outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        TailFound { tail: t } =>
          Accepted { value: TypeExprHeadTail { head: head, tail: t }, diagnostics: None }
      }
  }
}
fn project_type_expression_children_go(
  remaining: Int,
  anchor: Node,
  children: List<Node>,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  acc: List<Node>
) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
  } else if is_empty(xs: children) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: list_head_and_tail(xs: children, node: anchor),
      f: fn(split) {
        match project_type_expression_node_bounded(
          remaining: node_subtree_count(n: split.head),
          node: split.head,
          target: target,
          projection: projection
        ) {
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
          Accepted { value: projected, diagnostics: cd } =>
            match project_type_expression_children_go(
              remaining: remaining - 1,
              anchor: anchor,
              children: split.tail,
              target: target,
              projection: projection,
              acc: list_snoc_item(xs: acc, item: projected)
            ) {
              Rejected { diagnostics: r } => Rejected { diagnostics: r }
              Accepted { value: done, diagnostics: rd } =>
                Accepted {
                  value: done,
                  diagnostics: diagnostics_merge(outer: cd, inner: rd)
                }
            }
        }
      }
    )
  }
}
fn project_type_expression_children(
  remaining: Int,
  anchor: Node,
  children: List<Node>,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<List<Node>> {
  project_type_expression_children_go(
    remaining: remaining,
    anchor: anchor,
    children: children,
    target: target,
    projection: projection,
    acc: Empty
  )
}
fn project_type_expression_field_slots_go(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  edges: List<Edge>,
  acc: List<TargetTypeExprFieldSlot>
) -> Outcome<List<TargetTypeExprFieldSlot>> {
  if remaining <= 0 {
    outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  } else if is_empty(xs: edges) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: edge_list_head_and_tail(edges: edges, node: node),
      f: fn(split) {
        match split.head.label {
          Named { name: label } =>
            bind_outcome(
              o: project_type_expression_node_bounded(
                remaining: node_subtree_count(n: split.head.target),
                node: split.head.target,
                target: target,
                projection: projection
              ),
              f: fn(projected) {
                bind_outcome(
                  // Ownership attaches to CARRIERS, asked once each — not to a
                  // carrier's structural fact sub-atoms. Route field-slot
                  // ownership through the same boundary discipline as function
                  // params/return: decode the projected wire, apply ownership ONLY
                  // when it is an atom carrier (keyed by its canonical atom
                  // binding), and pass non-carrier shapes through. This stops the
                  // per-edge recursion from decorating a scalar carrier's fact
                  // sub-atoms (surface_spelling / inhabitant / signedness tag).
                  o: translate_apply_use_site_ownership_to_projected_boundary(
                    projected: projected,
                    source_for_binding: split.head.target,
                    target: target,
                    projection: projection,
                    use_site: OwnershipAtStructField
                  ),
                  f: fn(wrapped) {
                    project_type_expression_field_slots_go(
                      remaining: remaining - 1,
                      node: node,
                      target: target,
                      projection: projection,
                      edges: split.tail,
                      acc: list_snoc_item(
                        xs: acc,
                        item: TargetTypeExprFieldSlot { label: label, type_expr: wrapped }
                      )
                    )
                  }
                )
              }
            )
          Positional =>
            outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        }
      }
    )
  }
}
fn project_type_expression_field_slots(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<List<TargetTypeExprFieldSlot>> {
  project_type_expression_field_slots_go(
    remaining: remaining,
    node: node,
    target: target,
    projection: projection,
    edges: node.children,
    acc: Empty
  )
}

fn project_type_expression_variant_slots_go(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  edges: List<Edge>,
  acc: List<TargetTypeExprVariantSlot>
) -> Outcome<List<TargetTypeExprVariantSlot>> {
  if remaining <= 0 {
    outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  } else if is_empty(xs: edges) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: edge_list_head_and_tail(edges: edges, node: node),
      f: fn(split) {
        match split.head.label {
          Named { name: label } =>
            bind_outcome(
              o: project_type_expression_node_bounded(
                remaining: node_subtree_count(n: split.head.target),
                node: split.head.target,
                target: target,
                projection: projection
              ),
              f: fn(projected) {
                project_type_expression_variant_slots_go(
                  remaining: remaining - 1,
                  node: node,
                  target: target,
                  projection: projection,
                  edges: split.tail,
                  acc: list_snoc_item(
                    xs: acc,
                    item: TargetTypeExprVariantSlot { label: label, type_expr: projected }
                  )
                )
              }
            )
          Positional =>
            outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        }
      }
    )
  }
}
fn project_type_expression_variant_slots(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<List<TargetTypeExprVariantSlot>> {
  project_type_expression_variant_slots_go(
    remaining: remaining,
    node: node,
    target: target,
    projection: projection,
    edges: node.children,
    acc: Empty
  )
}
fn project_type_expression_conj_fields(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<List<TargetTypeExprFieldSlot>> {
  bind_outcome(
    o: project_type_expression_field_slots(
      remaining: remaining - 1,
      node: node,
      target: target,
      projection: projection
    ),
    f: fn(fields) {
      if is_empty(xs: fields) {
        if is_empty(xs: node.children) {
          Accepted { value: fields, diagnostics: None }
        } else {
          outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        }
      } else {
        Accepted { value: fields, diagnostics: None }
      }
    }
  )
}
fn project_type_expression_disj_variants(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<List<TargetTypeExprVariantSlot>> {
  bind_outcome(
    o: project_type_expression_variant_slots(
      remaining: remaining - 1,
      node: node,
      target: target,
      projection: projection
    ),
    f: fn(variants) {
      if is_empty(xs: variants) {
        if is_empty(xs: node.children) {
          Accepted { value: variants, diagnostics: None }
        } else {
          outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        }
      } else {
        Accepted { value: variants, diagnostics: None }
      }
    }
  )
}
fn project_type_expression_connective_bounded(
  remaining: Int,
  node: Node,
  connective: Connective,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  bind_outcome(
    o: type_expr_projection_row_closedness_from_target(
      target: target,
      projection: projection,
      connective: connective
    ),
    f: fn(_) {
      match connective {
        Atom { identity: id } =>
          Accepted {
            value: target_type_expr_atom_emitted(form: projection.atom_form, identity: id),
            diagnostics: None
          }
        Instantiation =>
          if target_collection_type_node_is_free_monoid_carrier(node: node) {
            project_free_monoid_collection_type_node(node: node, target: target, projection: projection)
          } else {
            bind_outcome(
              o: project_type_expression_children(
                remaining: remaining - 1,
                anchor: node,
                children: node_positional_child_targets(node: node),
                target: target,
                projection: projection
              ),
              f: fn(projected) {
                bind_outcome(
                  o: list_head_and_tail(xs: projected, node: node),
                  f: fn(split) {
                    Accepted {
                      value: target_type_expr_instantiation_emitted(
                        form: projection.instantiation_form,
                        head: split.head,
                        args: split.tail
                      ),
                      diagnostics: None
                    }
                  }
                )
              }
            )
          }
        Cardinality =>
          if target_collection_type_node_is_set_carrier(node: node) {
            project_set_collection_type_node(node: node, target: target, projection: projection)
          } else {
            bind_outcome(
              o: project_type_expression_children(
                remaining: remaining - 1,
                anchor: node,
                children: node_positional_child_targets(node: node),
                target: target,
                projection: projection
              ),
              f: fn(projected) {
                bind_outcome(
                  o: list_head_and_tail(xs: projected, node: node),
                  f: fn(split) {
                    Accepted {
                      value: target_type_expr_cardinality_emitted(
                        form: projection.cardinality_form,
                        head: split.head,
                        args: split.tail
                      ),
                      diagnostics: None
                    }
                  }
                )
              }
            )
          }
        Conj =>
          bind_outcome(
            o: project_type_expression_conj_fields(
              remaining: remaining - 1,
              node: node,
              target: target,
              projection: projection
            ),
            f: fn(fields) {
              Accepted {
                value: target_type_expr_record_emitted(form: projection.conj_form, fields: fields),
                diagnostics: None
              }
            }
          )
        Disj =>
          bind_outcome(
            o: project_type_expression_disj_variants(
              remaining: remaining - 1,
              node: node,
              target: target,
              projection: projection
            ),
            f: fn(variants) {
              Accepted {
                value: target_type_expr_sum_emitted(form: projection.disj_form, variants: variants),
                diagnostics: None
              }
            }
          )
        Arrow =>
          bind_outcome(
            o: type_expr_arrow_split_from_types(
              types: node_positional_child_targets(node: node),
              node: node
            ),
            f: fn(original_split) {
              bind_outcome(
                o: project_type_expression_arrow_emitted_from_original_split(
                  original_split: original_split,
                  anchor: node,
                  target: target,
                  projection: projection
                ),
                f: fn(emitted) {
                  Accepted { value: emitted, diagnostics: None }
                }
              )
            }
          )
      }
    }
  )
}
fn project_type_expression_node(
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  project_type_expression_node_bounded(
    remaining: node_subtree_count(n: node),
    node: node,
    target: target,
    projection: projection
  )
}
fn project_type_expression_node_bounded(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  } else {
  match node.kind {
    TypeNode { connective: c } =>
      project_type_expression_connective_bounded(
        remaining: remaining,
        node: node,
        connective: c,
        target: target,
        projection: projection
      )
    ComputationNode { behavior: _ } =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
  }
}
fn lex_rules_literal(target: TargetModel, token_class: Symbol) -> Outcome<String> {
  lex_rules_literal_for_class(rules: target.lex, token_class: token_class)
}
fn type_expr_atom_binding_from_positional(
  targets: List<Node>,
  node: Node
) -> Outcome<Symbol> {
  bind_outcome(
    o: list_head_and_tail(xs: targets, node: node),
    f: fn(split) {
      if is_empty(xs: split.tail) {
        match split.head.kind {
          TypeNode { connective: Atom { identity: id } } =>
            Accepted { value: id, diagnostics: None }
          _ => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
        }
      } else {
        outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
      }
    }
  )
}
fn type_expr_atom_binding(node: Node) -> Outcome<Symbol> {
  type_expr_atom_binding_from_positional(
    targets: node_positional_child_targets(node: node),
    node: node
  )
}
// A use-site carrier's identity. Ownership attaches to CARRIERS, each asked ONCE by
// its OWN identity: a bare-atom carrier (e.g. a scalar inhabitant `rust_inhabitant_i32`)
// IS its own identity, so take it directly via node_atom_identity. A composite/wrapper
// carrier presents the identity as its single positional sub-atom, so fall through to
// type_expr_atom_binding. The wrapper-only decoder must not be asked of a bare atom —
// it would read for a positional sub-child the carrier lacks and fail shape-closed.
fn type_expr_carrier_identity(node: Node) -> Outcome<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: _ } } => node_atom_identity(node: node)
    _ => type_expr_atom_binding(node: node)
  }
}
fn type_expr_spelling_for_atom(target: TargetModel, node: Node) -> Outcome<TargetSource> {
  bind_outcome(
    o: type_expr_atom_binding(node: node),
    f: fn(binding) {
      match map_get(target.binding_spellings, binding) {
        Accepted { value: opt, diagnostics: pending } => match opt {
          Present { value: spelling } => Accepted { value: spelling, diagnostics: pending }
          Absent =>
            Rejected {
              diagnostics: rejected_with_pending(
                pending: pending,
                rejected: diagnostics_singleton(
                  d: translate_binding_spelling_not_found_diagnostic(binding: binding)
                )
              )
            }
        }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    }
  )
}
fn serialize_type_expr_emitted_positional_head_tail(node: Node) -> Outcome<TypeExprHeadTail> {
  list_head_and_tail(
    xs: node_positional_child_targets(node: node),
    node: node
  )
}
fn serialize_type_expr_generic_apply_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetGenericApply,
  node: Node
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: node)
    )
  } else {
    bind_outcome(
      o: serialize_type_expr_emitted_positional_head_tail(node: node),
      f: fn(split) {
        bind_outcome(
          o: serialize_type_expr_emitted_bounded(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            emitted: split.head
          ),
          f: fn(head_source) {
            bind_outcome(
              o: lex_rules_literal(target: target, token_class: form.open),
              f: fn(open_source) {
                bind_outcome(
                  o: serialize_type_expr_args_bounded(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    form: form,
                    args: split.tail,
                    anchor: node
                  ),
                  f: fn(args_source) {
                    bind_outcome(
                      o: lex_rules_literal(target: target, token_class: form.close),
                      f: fn(close_source) {
                        Accepted {
                          value: list_append(
                            left: list_append(
                              left: list_append(left: head_source, right: open_source),
                              right: args_source
                            ),
                            right: close_source
                          ),
                          diagnostics: None
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}
fn serialize_type_expr_args_go(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetGenericApply,
  args: List<Node>,
  anchor: Node,
  acc: TargetSource
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else if is_empty(xs: args) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: list_head_and_tail(xs: args, node: anchor),
      f: fn(split) {
        bind_outcome(
          o: serialize_type_expr_emitted_bounded(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            emitted: split.head
          ),
          f: fn(arg_source) {
            if is_empty(xs: acc) {
              serialize_type_expr_args_go(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                args: split.tail,
                anchor: anchor,
                acc: arg_source
              )
            } else {
              bind_outcome(
                o: lex_rules_literal(target: target, token_class: form.separator),
                f: fn(sep_source) {
                  serialize_type_expr_args_go(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    form: form,
                    args: split.tail,
                    anchor: anchor,
                    acc: list_append(
                      left: list_append(left: acc, right: sep_source),
                      right: arg_source
                    )
                  )
                }
              )
            }
          }
        )
      }
    )
  }
}
fn serialize_type_expr_args_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetGenericApply,
  args: List<Node>,
  anchor: Node
) -> Outcome<TargetSource> {
  serialize_type_expr_args_go(
    remaining: remaining,
    target: target,
    projection: projection,
    form: form,
    args: args,
    anchor: anchor,
    acc: Empty
  )
}
fn serialize_type_expr_separated_go(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  separator: Symbol,
  items: List<Node>,
  anchor: Node,
  acc: TargetSource
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else if is_empty(xs: items) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: list_head_and_tail(xs: items, node: anchor),
      f: fn(split) {
        bind_outcome(
          o: serialize_type_expr_emitted_bounded(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            emitted: split.head
          ),
          f: fn(item_source) {
            if is_empty(xs: acc) {
              serialize_type_expr_separated_go(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                separator: separator,
                items: split.tail,
                anchor: anchor,
                acc: item_source
              )
            } else {
              bind_outcome(
                o: lex_rules_literal(target: target, token_class: separator),
                f: fn(sep_source) {
                  serialize_type_expr_separated_go(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    separator: separator,
                    items: split.tail,
                    anchor: anchor,
                    acc: list_append(
                      left: list_append(left: acc, right: sep_source),
                      right: item_source
                    )
                  )
                }
              )
            }
          }
        )
      }
    )
  }
}
fn serialize_type_expr_separated_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  separator: Symbol,
  items: List<Node>,
  anchor: Node
) -> Outcome<TargetSource> {
  serialize_type_expr_separated_go(
    remaining: remaining,
    target: target,
    projection: projection,
    separator: separator,
    items: items,
    anchor: anchor,
    acc: Empty
  )
}

fn serialize_type_expr_record_field_label(target: TargetModel, edge: Edge) -> Outcome<TargetSource> {
  match edge.label {
    Named { name: label } =>
      match map_get(target.binding_spellings, label) {
        Accepted { value: opt, diagnostics: pending } => match opt {
          Present { value: spelling } => Accepted { value: spelling, diagnostics: pending }
          Absent =>
            Rejected {
              diagnostics: rejected_with_pending(
                pending: pending,
                rejected: diagnostics_singleton(
                  d: translate_binding_spelling_not_found_diagnostic(binding: label)
                )
              )
            }
        }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    Positional =>
      outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: edge.target))
  }
}

fn serialize_type_expr_record_fields_go(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  separator: Symbol,
  field_label_separator: Symbol,
  fields: List<Edge>,
  anchor: Node,
  acc: TargetSource
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else if is_empty(xs: fields) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: edge_list_head_and_tail(edges: fields, node: anchor),
      f: fn(split) {
        bind_outcome(
          o: serialize_type_expr_record_field_label(target: target, edge: split.head),
          f: fn(label_source) {
            bind_outcome(
              o: lex_rules_literal(target: target, token_class: field_label_separator),
              f: fn(label_sep_source) {
                bind_outcome(
                  o: serialize_type_expr_emitted_bounded(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    emitted: split.head.target
                  ),
                  f: fn(field_type_source) {
                    let field_source = list_append(
                      left: list_append(left: label_source, right: label_sep_source),
                      right: field_type_source
                    )
                    if is_empty(xs: acc) {
                      serialize_type_expr_record_fields_go(
                        remaining: remaining - 1,
                        target: target,
                        projection: projection,
                        separator: separator,
                        field_label_separator: field_label_separator,
                        fields: split.tail,
                        anchor: anchor,
                        acc: field_source
                      )
                    } else {
                      bind_outcome(
                        o: lex_rules_literal(target: target, token_class: separator),
                        f: fn(sep_source) {
                          serialize_type_expr_record_fields_go(
                            remaining: remaining - 1,
                            target: target,
                            projection: projection,
                            separator: separator,
                            field_label_separator: field_label_separator,
                            fields: split.tail,
                            anchor: anchor,
                            acc: list_append(
                              left: list_append(left: acc, right: sep_source),
                              right: field_source
                            )
                          )
                        }
                      )
                    }
                  }
                )
              }
            )
          }
        )
      }
    )
  }
}

fn serialize_type_expr_record_fields_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  separator: Symbol,
  field_label_separator: Symbol,
  fields: List<Edge>,
  anchor: Node
) -> Outcome<TargetSource> {
  serialize_type_expr_record_fields_go(
    remaining: remaining,
    target: target,
    projection: projection,
    separator: separator,
    field_label_separator: field_label_separator,
    fields: fields,
    anchor: anchor,
    acc: Empty
  )
}

fn serialize_type_expr_record_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetGenericApply,
  node: Node
) -> Outcome<TargetSource> {
  match form.field_label_separator {
    Present { value: field_label_separator } =>
      bind_outcome(
        o: target_type_expr_emitted_labeled_slot_edges(node: node),
        f: fn(fields) {
          bind_outcome(
            o: lex_rules_literal(target: target, token_class: form.open),
            f: fn(open_source) {
              bind_outcome(
                o: serialize_type_expr_record_fields_bounded(
                  remaining: remaining - 1,
                  target: target,
                  projection: projection,
                  separator: form.separator,
                  field_label_separator: field_label_separator,
                  fields: fields,
                  anchor: node
                ),
                f: fn(fields_source) {
                  bind_outcome(
                    o: lex_rules_literal(target: target, token_class: form.close),
                    f: fn(close_source) {
                      Accepted {
                        value: list_append(
                          left: list_append(left: open_source, right: fields_source),
                          right: close_source
                        ),
                        diagnostics: None
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    Absent => outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  }
}
fn serialize_type_expr_sum_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetSumTypeShape,
  node: Node
) -> Outcome<TargetSource> {
  bind_outcome(
    o: target_type_expr_emitted_labeled_slot_nodes(node: node),
    f: fn(variants) {
      serialize_type_expr_separated_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        separator: form.variant_separator,
        items: variants,
        anchor: node
      )
    }
  )
}
fn serialize_type_expr_arrow_param_spelling(
  target: TargetModel,
  label: Symbol
) -> Outcome<TargetSource> {
  match map_get(target.binding_spellings, label) {
    Accepted { value: opt, diagnostics: pending } => match opt {
      Present { value: spelling } => Accepted { value: spelling, diagnostics: pending }
      Absent =>
        Rejected {
          diagnostics: rejected_with_pending(
            pending: pending,
            rejected: diagnostics_singleton(
              d: translate_binding_spelling_not_found_diagnostic(binding: label)
            )
          )
        }
    }
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}

fn serialize_type_expr_arrow_param_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  slot: TargetTypeExprArrowParamSlot
) -> Outcome<TargetSource> {
  bind_outcome(
    o: serialize_type_expr_arrow_param_spelling(
      target: target,
      label: slot.label
    ),
    f: fn(name_source) {
      bind_outcome(
        o: serialize_type_expr_boundary_bounded(
          remaining: remaining - 1,
          target: target,
          projection: projection,
          boundary_site: FunctionBoundaryParam,
          emitted: slot.type_expr
        ),
        f: fn(type_source) {
          bind_outcome(
            o: lex_rules_literal(target: target, token_class: form.param_type_separator),
            f: fn(separator_source) {
              Accepted {
                value: list_append(
                  left: list_append(left: name_source, right: separator_source),
                  right: type_source
                ),
                diagnostics: None
              }
            }
          )
        }
      )
    }
  )
}

fn serialize_type_expr_arrow_params_go(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  params: List<TargetTypeExprArrowParamSlot>,
  anchor: Node,
  acc: TargetSource
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else if is_empty(xs: params) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: list_head_and_tail(xs: params, node: anchor),
      f: fn(split) {
        bind_outcome(
          o: serialize_type_expr_arrow_param_bounded(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            form: form,
            slot: split.head
          ),
          f: fn(param_source) {
            if is_empty(xs: acc) {
              serialize_type_expr_arrow_params_go(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                params: split.tail,
                anchor: anchor,
                acc: param_source
              )
            } else {
              bind_outcome(
                o: lex_rules_literal(target: target, token_class: form.param_list_separator),
                f: fn(separator_source) {
                  serialize_type_expr_arrow_params_go(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    form: form,
                    params: split.tail,
                    anchor: anchor,
                    acc: list_append(
                      left: list_append(left: acc, right: separator_source),
                      right: param_source
                    )
                  )
                }
              )
            }
          }
        )
      }
    )
  }
}

fn serialize_type_expr_arrow_named_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  node: Node
) -> Outcome<TargetSource> {
  bind_outcome(
    o: target_type_expr_arrow_labeled_param_slots(node: node),
    f: fn(params) {
      bind_outcome(
        o: target_type_expr_arrow_labeled_codomain(node: node),
        f: fn(codomain) {
          bind_outcome(
            o: lex_rules_literal(target: target, token_class: form.open),
            f: fn(open_source) {
              bind_outcome(
                o: serialize_type_expr_arrow_params_go(
                  remaining: remaining - 1,
                  target: target,
                  projection: projection,
                  form: form,
                  params: params,
                  anchor: node,
                  acc: Empty
                ),
                f: fn(params_source) {
                  bind_outcome(
                    o: lex_rules_literal(target: target, token_class: form.close),
                    f: fn(close_source) {
                      bind_outcome(
                        o: lex_rules_literal(target: target, token_class: form.arrow),
                        f: fn(arrow_source) {
                          bind_outcome(
                            o: serialize_type_expr_boundary_bounded(
                              remaining: remaining - 1,
                              target: target,
                              projection: projection,
                              boundary_site: FunctionBoundaryReturn,
                              emitted: codomain
                            ),
                            f: fn(codomain_source) {
                              Accepted {
                                value: list_append(
                                  left: list_append(
                                    left: list_append(
                                      left: list_append(left: open_source, right: params_source),
                                      right: close_source
                                    ),
                                    right: arrow_source
                                  ),
                                  right: codomain_source
                                ),
                                diagnostics: None
                              }
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn serialize_type_expr_arrow_input_wrapped(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  input_node: Node
) -> Outcome<TargetSource> {
  bind_outcome(
    o: lex_rules_literal(target: target, token_class: form.open),
    f: fn(open_source) {
      bind_outcome(
        o: serialize_type_expr_boundary_bounded(
          remaining: remaining - 1,
          target: target,
          projection: projection,
          boundary_site: FunctionBoundaryParam,
          emitted: input_node
        ),
        f: fn(input_source) {
          bind_outcome(
            o: lex_rules_literal(target: target, token_class: form.close),
            f: fn(close_source) {
              Accepted {
                value: list_append(
                  left: list_append(left: open_source, right: input_source),
                  right: close_source
                ),
                diagnostics: None
              }
            }
          )
        }
      )
    }
  )
}
fn serialize_type_expr_arrow_inputs_go(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  inputs: List<Node>,
  anchor: Node,
  acc: TargetSource
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: anchor)
    )
  } else if is_empty(xs: inputs) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: list_head_and_tail(xs: inputs, node: anchor),
      f: fn(split) {
        bind_outcome(
          o: serialize_type_expr_arrow_input_wrapped(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            form: form,
            input_node: split.head
          ),
          f: fn(input_source) {
            if is_empty(xs: acc) {
              serialize_type_expr_arrow_inputs_go(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                inputs: split.tail,
                anchor: anchor,
                acc: input_source
              )
            } else {
              bind_outcome(
                o: lex_rules_literal(target: target, token_class: form.arrow),
                f: fn(arrow_source) {
                  serialize_type_expr_arrow_inputs_go(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    form: form,
                    inputs: split.tail,
                    anchor: anchor,
                    acc: list_append(
                      left: list_append(left: acc, right: arrow_source),
                      right: input_source
                    )
                  )
                }
              )
            }
          }
        )
      }
    )
  }
}
fn serialize_type_expr_arrow_inputs_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  inputs: List<Node>,
  anchor: Node
) -> Outcome<TargetSource> {
  serialize_type_expr_arrow_inputs_go(
    remaining: remaining,
    target: target,
    projection: projection,
    form: form,
    inputs: inputs,
    anchor: anchor,
    acc: Empty
  )
}
fn serialize_type_expr_arrow_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  form: TargetFunctionTypeShape,
  node: Node
) -> Outcome<TargetSource> {
  match target_type_expr_arrow_wire_shape(node: node) {
    Accepted { value: TargetTypeExprArrowLabeledWire, diagnostics: d } =>
      bind_outcome_accepted(
        od: d,
        inner: serialize_type_expr_arrow_named_bounded(
          remaining: remaining,
          target: target,
          projection: projection,
          form: form,
          node: node
        )
      )
    Accepted { value: TargetTypeExprArrowPositionalWire, diagnostics: d } =>
      bind_outcome_accepted(
        od: d,
        inner: bind_outcome(
          o: type_expr_arrow_split_from_types(
            types: node_positional_child_targets(node: node),
            node: node
          ),
          f: fn(split) {
            bind_outcome(
              o: serialize_type_expr_arrow_inputs_bounded(
                remaining: remaining - 1,
                target: target,
                projection: projection,
                form: form,
                inputs: split.inputs,
                anchor: node
              ),
              f: fn(inputs_source) {
                bind_outcome(
                  o: lex_rules_literal(target: target, token_class: form.arrow),
                  f: fn(arrow_source) {
                    bind_outcome(
                      o: serialize_type_expr_boundary_bounded(
                        remaining: remaining - 1,
                        target: target,
                        projection: projection,
                        boundary_site: FunctionBoundaryReturn,
                        emitted: split.output
                      ),
                      f: fn(output_source) {
                        Accepted {
                          value: list_append(
                            left: list_append(left: inputs_source, right: arrow_source),
                            right: output_source
                          ),
                          diagnostics: None
                        }
                      }
                    )
                  }
                )
              }
            )
          }
        )
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
fn serialize_type_expr_emitted_wire_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  wire: TargetTypeExpression
) -> Outcome<TargetSource> {
  match wire.kind {
    TargetTypeExprAtom =>
      type_expr_spelling_for_atom(target: target, node: wire.node)
    TargetTypeExprInstantiation =>
      serialize_type_expr_generic_apply_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.instantiation_form,
        node: wire.node
      )
    TargetTypeExprCardinality =>
      serialize_type_expr_generic_apply_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.cardinality_form,
        node: wire.node
      )
    TargetTypeExprRecord =>
      serialize_type_expr_record_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.conj_form,
        node: wire.node
      )
    TargetTypeExprSum =>
      serialize_type_expr_sum_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.disj_form,
        node: wire.node
      )
    TargetTypeExprArrow =>
      serialize_type_expr_arrow_bounded(
        remaining: remaining - 1,
        target: target,
        projection: projection,
        form: projection.arrow_form,
        node: wire.node
      )
  }
}
fn serialize_type_expr_emitted_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  emitted: Node
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else {
    bind_outcome(
      o: target_type_expr_emitted_wire_decode(node: emitted, projection: projection),
      f: fn(wire) {
        serialize_type_expr_emitted_wire_bounded(
          remaining: remaining,
          target: target,
          projection: projection,
          wire: wire
        )
      }
    )
  }
}
fn translate_outcome_is_catalog_lookup_miss(
  diagnostics: NonEmptyDiagnostics
) -> Bool {
  diagnostics.head.reason == target_atom_realization_lookup_miss
}

fn translate_sg_rc_bundle_edge_present(target: TargetModel, edge_name: Symbol) -> Outcome<Bool> {
  match target_bundle_optional_child(target: target, edge_name: edge_name) {
    Accepted { value: optional_child, diagnostics: d } =>
      match optional_child {
        None => outcome_accepted(false)
        Some { value: _ } => outcome_accepted(true)
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

// Accepted false => no SG-RC edges (skip consumer); true => apply catalog; Rejected => malformed/partial bundle.
fn translate_sg_rc_bundle_apply_disposition(
  target: TargetModel,
  source_carrier: Node
) -> Outcome<Bool> {
  bind_outcome(
    o: translate_sg_rc_bundle_edge_present(
      target: target,
      edge_name: target_model_edge_use_site_ownership_realizations
    ),
    f: fn(has_catalog) {
      bind_outcome(
        o: translate_sg_rc_bundle_edge_present(
          target: target,
          edge_name: target_model_edge_reference_layer_tokens
        ),
        f: fn(has_tokens) {
          if has_catalog == false && has_tokens == false {
            outcome_accepted(false)
          } else {
            if has_catalog && has_tokens {
              outcome_accepted(true)
            } else {
              outcome_rejected(translate_sg_rc_bundle_partial_diagnostic(source_carrier: source_carrier))
            }
          }
        }
      )
    }
  )
}

fn translate_reference_layer_tokens_from_target(
  target: TargetModel
) -> Outcome<TargetReferenceLayerTokens> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_reference_layer_tokens),
    f: fn(bundle) { target_reference_layer_tokens_from_node(node: bundle) }
  )
}

fn translate_use_site_ownership_catalog_from_model(
  target: TargetModel,
  source_carrier: Node
) -> Outcome<Node> {
  match target_bundle_optional_child(
    target: target,
    edge_name: target_model_edge_use_site_ownership_realizations
  ) {
    Accepted { value: optional_catalog, diagnostics: d } =>
      match optional_catalog {
        None =>
          outcome_rejected(
            target_use_site_ownership_lookup_miss_diagnostic(source_carrier: source_carrier)
          )
        Some { value: catalog } => Accepted { value: catalog, diagnostics: d }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

// Value-semantics (Copy) carrier set from the target bundle. Edge absent ⇒ empty
// (a target without value-semantics modeling behaves exactly as before: every
// carrier flows to the reference catalog). Decoded to the Atom-identity list the
// authority lookup matches on.
fn translate_value_semantics_carriers_from_model(target: TargetModel) -> Outcome<List<Symbol>> {
  match target_bundle_optional_child(
    target: target,
    edge_name: target_model_edge_value_semantics_carriers
  ) {
    Accepted { value: optional_node, diagnostics: d } =>
      match optional_node {
        None => Accepted { value: Empty, diagnostics: d }
        Some { value: node } =>
          Accepted { value: target_value_semantics_carriers_from_node(node: node), diagnostics: d }
      }
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_apply_use_site_ownership_to_projected_type(
  projected: Node,
  source_carrier: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  translate_apply_use_site_ownership_to_type_shell(
    shell: projected,
    source_carrier: source_carrier,
    target: target,
    use_site: use_site
  )
}

// Arrow boundary ownership matches serialize_type_expr_boundary_bounded discipline:
// SG-RC applies only when the projected wire is an atom; composite boundaries pass through.
fn translate_apply_use_site_ownership_to_projected_boundary(
  projected: Node,
  source_for_binding: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  bind_outcome(
    o: target_type_expr_emitted_wire_decode(node: projected, projection: projection),
    f: fn(wire) {
      match wire.kind {
        TargetTypeExprAtom =>
          bind_outcome(
            o: type_expr_carrier_identity(node: source_for_binding),
            f: fn(binding) {
              translate_apply_use_site_ownership_to_projected_type(
                projected: projected,
                source_carrier: translate_boundary_source_carrier_node(binding: binding),
                target: target,
                use_site: use_site
              )
            }
          )
        _ => outcome_accepted(projected)
      }
    }
  )
}

fn project_type_expression_arrow_emitted_from_original_split(
  original_split: TypeExprArrowSplit,
  anchor: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  bind_outcome(
    o: translate_project_arrow_split_types(
      original_split: original_split,
      target: target,
      projection: projection,
      anchor: anchor
    ),
    f: fn(split) {
      outcome_accepted(
        target_type_expr_arrow_emitted(
          form: projection.arrow_form,
          inputs: split.inputs,
          output: split.output
        )
      )
    }
  )
}

fn translate_project_arrow_input_types_go(
  remaining: Int,
  anchor: Node,
  original_inputs: List<Node>,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  acc: List<Node>
) -> Outcome<List<Node>> {
  if remaining <= 0 {
    outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: anchor))
  } else if is_empty(xs: original_inputs) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: list_head_and_tail(xs: original_inputs, node: anchor),
      f: fn(split) {
        bind_outcome(
          o: project_type_expression_node_bounded(
            remaining: node_subtree_count(n: split.head),
            node: split.head,
            target: target,
            projection: projection
          ),
          f: fn(projected) {
            bind_outcome(
              o: translate_apply_use_site_ownership_to_projected_boundary(
                projected: projected,
                source_for_binding: split.head,
                target: target,
                projection: projection,
                use_site: OwnershipAtFunctionParameter
              ),
              f: fn(wrapped) {
                translate_project_arrow_input_types_go(
                  remaining: remaining - 1,
                  anchor: anchor,
                  original_inputs: split.tail,
                  target: target,
                  projection: projection,
                  acc: list_snoc_item(xs: acc, item: wrapped)
                )
              }
            )
          }
        )
      }
    )
  }
}

fn translate_project_arrow_split_types(
  original_split: TypeExprArrowSplit,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  anchor: Node
) -> Outcome<TypeExprArrowSplit> {
  bind_outcome(
    o: translate_project_arrow_input_types_go(
      remaining: node_subtree_count(n: anchor),
      anchor: anchor,
      original_inputs: original_split.inputs,
      target: target,
      projection: projection,
      acc: Empty
    ),
    f: fn(wrapped_inputs) {
      bind_outcome(
        o: project_type_expression_node_bounded(
          remaining: node_subtree_count(n: original_split.output),
          node: original_split.output,
          target: target,
          projection: projection
        ),
        f: fn(projected_output) {
          bind_outcome(
            o: translate_apply_use_site_ownership_to_projected_boundary(
              projected: projected_output,
              source_for_binding: original_split.output,
              target: target,
              projection: projection,
              use_site: OwnershipAtFunctionReturn
            ),
            f: fn(wrapped_output) {
              outcome_accepted(
                TypeExprArrowSplit {
                  inputs: wrapped_inputs,
                  output: wrapped_output
                }
              )
            }
          )
        }
      )
    }
  )
}

fn translate_apply_use_site_ownership_to_type_shell(
  shell: Node,
  source_carrier: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  match translate_sg_rc_bundle_apply_disposition(
    target: target,
    source_carrier: source_carrier
  ) {
    Accepted { value: false, diagnostics: _ } => outcome_accepted(shell)
    Accepted { value: true, diagnostics: _ } =>
  bind_outcome(
    o: type_expression_projection_from_target(target: target),
    f: fn(projection) {
      bind_outcome(
        o: translate_reference_layer_tokens_from_target(target: target),
        f: fn(tokens) {
          bind_outcome(
            o: translate_use_site_ownership_catalog_from_model(
              target: target,
              source_carrier: source_carrier
            ),
            f: fn(catalog) {
              bind_outcome(
                o: translate_value_semantics_carriers_from_model(target: target),
                f: fn(value_semantics_carriers) {
                  match target_use_site_ownership_lookup_in_catalog_node(
                    catalog: catalog,
                    value_semantics_carriers: value_semantics_carriers,
                    source_carrier: source_carrier,
                    use_site: use_site
                  ) {
                    Accepted { value: ownership, diagnostics: d } =>
                      match ownership {
                        CarrierOwnershipByValue => outcome_accepted(shell)
                        CarrierOwnershipByReference { realization: row } =>
                          outcome_accepted(
                            target_reference_layer_apply_type_emitted(
                              inner: shell,
                              layer: row.reference_layer,
                              projection: projection,
                              tokens: tokens
                            )
                          )
                      }
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  }
                }
              )
            }
          )
        }
      )
    }
  )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_outcome_is_signature_realization_miss(
  diagnostics: NonEmptyDiagnostics
) -> Bool {
  diagnostics.head.reason == target_function_signature_realization_lookup_miss
}

// Reconstruct the SG-1 source_carrier Node from a boundary atom's binding identity. Arrow
// domain/codomain atoms are projected (06_translate project_type_expression_node_bounded) with
// the SOURCE atom identity passed through, so for the kernel Symbol return type the binding ==
// symbol_kernel_type_atom and this Node == symbol_kernel_type_node() — the SG-1 row key.
fn translate_boundary_source_carrier_node(binding: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: binding } },
    children: [],
    span: Unanchored
}
}

fn function_boundary_site_to_ownership_use_site(
  boundary_site: FunctionBoundarySite
) -> TargetOwnershipUseSite {
  match boundary_site {
    FunctionBoundaryParam => OwnershipAtFunctionParameter
    FunctionBoundaryReturn => OwnershipAtFunctionReturn
  }
}

// Consult the per-language signature realization catalog for the fn-boundary atom at `emitted`.
// Returns Present(row) on a (source_carrier, boundary_site) hit; Absent when the model carries no
// signature catalog OR no row matches (both fall back to the SG-2/binding_spellings path); Rejected
// only on a genuine decode/ambiguity error.
fn translate_target_function_signature_realization_for_boundary(
  target: TargetModel,
  emitted: Node,
  boundary_site: FunctionBoundarySite
) -> Outcome<Optional<TargetFunctionSignatureRealization>> {
  match target_bundle_optional_child(
    target: target,
    edge_name: target_model_edge_signature_realizations
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: optional_catalog, diagnostics: _ } =>
      match optional_catalog {
        None => outcome_accepted(optional_absent())
        Some { value: catalog } =>
          bind_outcome(
            o: type_expr_atom_binding(node: emitted),
            f: fn(binding) {
              match target_function_signature_realization_lookup_in_catalog_node(
                catalog: catalog,
                source_carrier: translate_boundary_source_carrier_node(binding: binding),
                boundary_site: boundary_site,
                host_target_model: target
              ) {
                Accepted { value: row, diagnostics: _ } =>
                  outcome_accepted(optional_present(row))
                Rejected { diagnostics: r } =>
                  if translate_outcome_is_signature_realization_miss(diagnostics: r) {
                    outcome_accepted(optional_absent())
                  } else {
                    Rejected { diagnostics: r }
                  }
              }
            }
          )
      }
  }
}

// Serialize a fn-boundary atom: emit the signature realization's signature_type_form when a row
// matches (SG-1b authority); otherwise consult TargetUseSiteOwnershipRealization for this
// boundary role, then serialize the emitted wire (SG-RC + SG-2; no spelling-only bypass).
fn serialize_type_expr_boundary_atom_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  boundary_site: FunctionBoundarySite,
  emitted: Node
) -> Outcome<TargetSource> {
  match translate_target_function_signature_realization_for_boundary(
    target: target,
    emitted: emitted,
    boundary_site: boundary_site
  ) {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: optional_row, diagnostics: _ } =>
      match optional_row {
        Present { value: row } =>
          serialize_type_expr_emitted_bounded(
            remaining: remaining - 1,
            target: target,
            projection: projection,
            emitted: row.signature_type_form.node
          )
        Absent =>
          bind_outcome(
            o: type_expr_atom_binding(node: emitted),
            f: fn(binding) {
              bind_outcome(
                o: translate_apply_use_site_ownership_to_projected_type(
                  projected: emitted,
                  source_carrier: translate_boundary_source_carrier_node(binding: binding),
                  target: target,
                  use_site: function_boundary_site_to_ownership_use_site(
                    boundary_site: boundary_site
                  )
                ),
                f: fn(wrapped) {
                  serialize_type_expr_emitted_bounded(
                    remaining: remaining - 1,
                    target: target,
                    projection: projection,
                    emitted: wrapped
                  )
                }
              )
            }
          )
      }
  }
}

// Boundary-aware type serializer used ONLY from Arrow domain (Param) and codomain (Return) sites.
// Atom boundaries consult signature realization; composite boundary types serialize normally.
fn serialize_type_expr_boundary_bounded(
  remaining: Int,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  boundary_site: FunctionBoundarySite,
  emitted: Node
) -> Outcome<TargetSource> {
  if remaining <= 0 {
    outcome_rejected(
      translate_serialize_recursion_limit_exhausted_diagnostic(emitted: emitted)
    )
  } else {
    bind_outcome(
      o: target_type_expr_emitted_wire_decode(node: emitted, projection: projection),
      f: fn(wire) {
        match wire.kind {
          TargetTypeExprAtom =>
            serialize_type_expr_boundary_atom_bounded(
              remaining: remaining,
              target: target,
              projection: projection,
              boundary_site: boundary_site,
              emitted: emitted
            )
          _ =>
            serialize_type_expr_emitted_wire_bounded(
              remaining: remaining,
              target: target,
              projection: projection,
              wire: wire
            )
        }
      }
    )
  }
}

fn translate_coerced_shell_base(coerced: Node, target: TargetModel) -> Outcome<Node> {
  match translate_target_atom_realization_for_carrier(
    target: target,
    source_carrier: coerced
  ) {
    Accepted { value: row, diagnostics: d } =>
      Accepted {
        value: row.type_form.node,
        diagnostics: d
      }
    Rejected { diagnostics: r } =>
      if translate_outcome_is_catalog_lookup_miss(diagnostics: r) {
        outcome_accepted(node_rebuild(n: coerced, children: []))
      } else {
        Rejected { diagnostics: r }
      }
  }
}

fn translate_coerced_shell_at_use_site(
  coerced: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  translate_coerced_shell_at_use_site_from_source(
    coerced: coerced,
    ownership_source_carrier: coerced,
    target: target,
    use_site: use_site
  )
}

fn translate_coerced_shell_at_use_site_from_source(
  coerced: Node,
  ownership_source_carrier: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Node> {
  match translate_coerced_type_shell_from_source(
    source_carrier: ownership_source_carrier,
    coerced: coerced,
    target: target
  ) {
    Accepted { value: shell, diagnostics: d } =>
      bind_outcome(
        o: translate_apply_use_site_ownership_to_type_shell(
          shell: shell,
          source_carrier: ownership_source_carrier,
          target: target,
          use_site: use_site
        ),
        f: fn(wrapped) { Accepted { value: wrapped, diagnostics: d } }
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_coerced_type_shell_from_source(
  source_carrier: Node,
  coerced: Node,
  target: TargetModel
) -> Outcome<Node> {
  match source_carrier.kind {
    TypeNode { connective: Instantiation } =>
      bind_outcome(
        o: type_expression_projection_from_target(target: target),
        f: fn(projection) {
          project_type_expression_node(
            node: source_carrier,
            target: target,
            projection: projection
          )
        }
      )
    _ => translate_coerced_shell_base(coerced: coerced, target: target)
  }
}

fn translate_coerced_shell(coerced: Node, target: TargetModel) -> Outcome<Node> {
  translate_coerced_shell_at_use_site(
    coerced: coerced,
    target: target,
    use_site: OwnershipAtBindingProjection
  )
}

fn translate_use_site_ownership_source_carrier(source: Node, coerced: Node) -> Node {
  match source.kind {
    TypeNode { connective: _ } => source
    ComputationNode { behavior: _ } => coerced
  }
}
fn target_atom_realizations_catalog_from_model(
  target: TargetModel,
  source_carrier: Node
) -> Outcome<Node> {
  match target_bundle_optional_child(
    target: target,
    edge_name: target_model_edge_atom_realizations
  ) {
    Accepted { value: optional_catalog, diagnostics: d } =>
      match optional_catalog {
        None =>
          outcome_rejected(
            target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier)
          )
        Some { value: catalog } =>
          Accepted { value: catalog, diagnostics: d }
      }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
fn translate_target_atom_realization_for_carrier(
  target: TargetModel,
  source_carrier: Node
) -> Outcome<TargetAtomRealization> {
  bind_outcome(
    o: target_atom_realizations_catalog_from_model(
      target: target,
      source_carrier: source_carrier
    ),
    f: fn(catalog) {
      target_atom_realization_lookup_in_catalog_node(
        catalog: catalog,
        source_carrier: source_carrier,
        host_target_model: target
      )
    }
  )
}
fn translate_shell_attach_value_expression(shell: Node, value: Node) -> Node {
  match shell.kind {
    TypeNode { connective: Conj } =>
      node_rebuild(
        n: shell,
        children: list_snoc_item(
          xs: shell.children,
          item: target_model_named_edge(
            name: target_model_edge_value_expression,
            target: value
          )
        )
      )
    _ => shell
  }
}
fn translate_apply_use_site_ownership_to_value_expression(
  expr: TargetValueExpression,
  source_carrier: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<TargetValueExpression> {
  match translate_sg_rc_bundle_apply_disposition(
    target: target,
    source_carrier: source_carrier
  ) {
    Accepted { value: false, diagnostics: _ } => outcome_accepted(expr)
    Accepted { value: true, diagnostics: _ } =>
      bind_outcome(
        o: translate_reference_layer_tokens_from_target(target: target),
        f: fn(tokens) {
          bind_outcome(
            o: translate_use_site_ownership_catalog_from_model(
              target: target,
              source_carrier: source_carrier
            ),
            f: fn(catalog) {
              bind_outcome(
                o: translate_value_semantics_carriers_from_model(target: target),
                f: fn(value_semantics_carriers) {
                  match target_use_site_ownership_lookup_in_catalog_node(
                    catalog: catalog,
                    value_semantics_carriers: value_semantics_carriers,
                    source_carrier: source_carrier,
                    use_site: use_site
                  ) {
                    Accepted { value: ownership, diagnostics: d } =>
                      match ownership {
                        CarrierOwnershipByValue => outcome_accepted(expr)
                        CarrierOwnershipByReference { realization: row } =>
                          outcome_accepted(
                            target_reference_layer_apply_value_expression(
                              inner: expr,
                              layer: row.reference_layer,
                              tokens: tokens
                            )
                          )
                      }
                    Rejected { diagnostics: r } => Rejected { diagnostics: r }
                  }
                }
              )
            }
          )
        }
      )
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}

fn translate_atom_realization_value_from_source_at_use_site(
  source: Node,
  coerced: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite
) -> Outcome<Optional<Node>> {
  match translate_target_atom_realization_for_carrier(
    target: target,
    source_carrier: coerced
  ) {
    Accepted { value: row, diagnostics: d } =>
      match source_atom_value_for_realization_row(source: source, row: row) {
        Absent =>
          Accepted {
            value: optional_absent(),
            diagnostics: d
          }
        Present { value: atom_value } =>
          bind_outcome(
            o: target_atom_value_expression(row: row, value: atom_value),
            f: fn(expr) {
              bind_outcome(
                o: translate_apply_use_site_ownership_to_value_expression(
                  expr: expr,
                  source_carrier: coerced,
                  target: target,
                  use_site: use_site
                ),
                f: fn(wrapped) {
                  outcome_accepted(
                    optional_present(target_value_expression_node(expr: wrapped))
                  )
                }
              )
            }
          )
      }
    Rejected { diagnostics: r } =>
      if translate_outcome_is_catalog_lookup_miss(diagnostics: r) {
        outcome_accepted(optional_absent())
      } else {
        Rejected { diagnostics: r }
      }
  }
}

fn translate_coerced_with_atom_realization_at_use_site(
  source: Node,
  coerced: Node,
  target: TargetModel,
  use_site: TargetOwnershipUseSite,
  pending: Diagnostics
) -> Outcome<Node> {
  let ownership_source_carrier = translate_use_site_ownership_source_carrier(
    source: source,
    coerced: coerced
  )
  match translate_coerced_shell_at_use_site_from_source(
    coerced: coerced,
    ownership_source_carrier: ownership_source_carrier,
    target: target,
    use_site: use_site
  ) {
    Accepted { value: shell, diagnostics: sd } =>
      match translate_atom_realization_value_from_source_at_use_site(
        source: source,
        coerced: coerced,
        target: target,
        use_site: use_site
      ) {
        Accepted { value: value_projection, diagnostics: vd } =>
          Accepted {
            value: match value_projection {
              Absent => shell
              Present { value: value_node } =>
                translate_shell_attach_value_expression(
                  shell: shell,
                  value: value_node
                )
            },
            diagnostics: diagnostics_merge(
              outer: diagnostics_merge(outer: pending, inner: sd),
              inner: vd
            )
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(
              pending: diagnostics_merge(outer: pending, inner: sd),
              rejected: r
            )
          }
      }
    Rejected { diagnostics: r } =>
      Rejected {
        diagnostics: rejected_with_pending(pending: pending, rejected: r)
      }
  }
}

// Fold/MVP1 default coerce: binding-projection rows govern both type shell and value expr (P-RC-CONSUMER).
// Boundary sites (return/param/struct-field) must call translate_coerced_with_atom_realization_at_use_site
// with the matching TargetOwnershipUseSite, or use translate_apply_use_site_ownership_to_projected_type
// for emitted type wires (value expr uses translate_apply_use_site_ownership_to_value_expression).
fn translate_coerced_with_atom_realization(
  source: Node,
  coerced: Node,
  target: TargetModel,
  pending: Diagnostics
) -> Outcome<Node> {
  translate_coerced_with_atom_realization_at_use_site(
    source: source,
    coerced: coerced,
    target: target,
    use_site: OwnershipAtBindingProjection,
    pending: pending
  )
}

fn translate_type_fold_init(node: Node) -> Outcome<Node> {
  Accepted {
    value: node_rebuild(n: node, children: []),
    diagnostics: None
  }
}
fn translate_computation_fold_init(node: Node) -> Outcome<Node> {
  // T6 / E-9: Behavior sub-DAG (Arrow.body) is internal — fold structurally, not coerce.
  translate_type_fold_init(node: node)
}
fn translate_fold_init(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match node.kind {
    TypeNode { connective: _ } => translate_type_fold_init(node: node)
    ComputationNode { behavior: _ } => translate_computation_fold_init(node: node)
  }
}
fn translate_mvp1_coerce_from_grounding_or_evidence(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match coerce_grounded_node(source: node, tree: tree, target: target) {
    Accepted { value: coerced, diagnostics: d } =>
      translate_coerced_with_atom_realization(
        source: node,
        coerced: coerced.target,
        target: target,
        pending: d
      )
    Rejected { diagnostics: r } =>
      match canonical_grounding_for_node(tree: tree, node: node) {
        Accepted { value: grounding } =>
          if algebra_ref_is_grounded(algebra: grounding.witness.structural.evidence) {
            translate_coerced_with_atom_realization(
              source: node,
              coerced: grounding.witness.structural.evidence,
              target: target,
              pending: None
            )
          } else {
            // E-9: body-scope operator/param atoms — structural carrier, not target type coercion.
            translate_type_fold_init(node: node)
          }
        Rejected { diagnostics: _ } =>
          // 🟡 gated — feature:translate-mvp1-e9-structural-carry-no-grounding — consumer:
          // translate_mvp1_coerce_from_grounding_or_evidence — bind: PR #4627 T6 bodied-arrow
          // skeleton — owner: T6 value-expression skeleton — lane: compiler 06_translate —
          // dissolve-on-arrival: body-scope operator/param refs ground via infer witness or
          // bounded E-9 carrier with explicit dissolution trigger; forbidden: unconditional
          // translate_type_fold_init when coerce_grounded_node and canonical_grounding_for_node
          // both reject outside Arrow.body internal fold.
          translate_type_fold_init(node: node)
      }
  }
}
fn translate_mvp1_fold_init(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match node.kind {
    TypeNode { connective: Arrow } =>
      // Bodied Arrow: fold signature children through coercion; body folds structurally (E-9).
      if arrow_has_transform_body(arrow: node) {
        translate_type_fold_init(node: node)
      } else {
        match coerce_grounded_node(source: node, tree: tree, target: target) {
          Accepted { value: coerced, diagnostics: d } =>
            translate_coerced_with_atom_realization(
              source: node,
              coerced: coerced.target,
              target: target,
              pending: d
            )
          Rejected { diagnostics: r } => Rejected { diagnostics: r }
        }
      }
    TypeNode { connective: Atom { identity: _ } } =>
      translate_mvp1_coerce_from_grounding_or_evidence(
        node: node,
        tree: tree,
        target: target
      )
    TypeNode { connective: _ } =>
      match coerce_grounded_node(source: node, tree: tree, target: target) {
        Accepted { value: coerced, diagnostics: d } =>
          translate_coerced_with_atom_realization(
            source: node,
            coerced: coerced.target,
            target: target,
            pending: d
          )
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    ComputationNode { behavior: _ } => translate_computation_fold_init(node: node)
  }
}
// Grammar-first match: does the (raw, structure-preserving) emitted node match a row in
// the target's grammar relation? Accepted(row) => the node is grammar-fixtured and must
// serialize via the mode-1 whole-node match (grammar_relation_row_for_emitted :536 ->
// pre-baked tokens); Rejected => no row, fall through to the projection / mode-2 path.
fn translate_grammar_relation_row_match(target: TargetModel, emitted: Node) -> Outcome<Node> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
    f: fn(rules) { grammar_relation_row_for_emitted(rules: rules, emitted: emitted) }
  )
}
fn translate_type_expression_tree(
  node: Node,
  tree: InferredTree,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  if arrow_has_transform_body(arrow: node) {
    // E-9 bodied Arrow: skip structure-preserving fold (it rewrites body-scope atoms through
    // binding projection shells). Coerce signature slots only; preserve producer body IR.
    translate_bodied_arrow_coerce_signature_slots(
      arrow: node,
      tree: tree,
      target: target
    )
  } else {
    bind_outcome(
      o: fold_node(
        n: node,
        algebra: NodeFold {
          init: fn(n0) { translate_type_fold_init(node: n0) },
          step: fn(acc, e, child) { translate_fold_step(acc: acc, edge: e, child: child) }
        }
      ),
      f: fn(n) {
        // Grammar-first short-circuit: if the structure-preserving (raw) folded node matches
        // a grammar relation row, return it RAW so serialize routes through the mode-1 whole-
        // node grammar match -> pre-baked concrete tokens (the full source, e.g. the mvp1
        // add fn). Nodes WITHOUT a grammar row fall through to the existing projection /
        // mode-2 (SG-2) path, UNTOUCHED — they carry the type-expression projection wrapping.
        match translate_grammar_relation_row_match(target: target, emitted: n) {
          Accepted { value: _, diagnostics: _ } => outcome_accepted(n)
          Rejected { diagnostics: _ } =>
            project_type_expression_node(node: n, target: target, projection: projection)
        }
      }
    )
  }
}
fn translate_node_with_projection(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  bind_outcome(
    o: type_expression_projection_from_target(target: target),
    f: fn(projection) {
      match node.kind {
        TypeNode { connective: _ } =>
          translate_type_expression_tree(
            node: node,
            tree: tree,
            target: target,
            projection: projection
          )
        ComputationNode { behavior: _ } =>
          bind_outcome(
            o: translate_node_computation(node: node, tree: tree, target: target),
            f: fn(translated) {
              bind_outcome(
                o: project_type_expression_subtree(
                  remaining: node_subtree_count(n: translated),
                  node: translated,
                  target: target,
                  projection: projection
                ),
                f: fn(projected) { Accepted { value: projected, diagnostics: None } }
              )
            }
          )
      }
    }
  )
}
fn project_type_expression_subtree(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<Node> {
  if remaining <= 0 {
    outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  } else {
    match node.kind {
      TypeNode { connective: _ } =>
        project_type_expression_node_bounded(
          remaining: remaining - 1,
          node: node,
          target: target,
          projection: projection
        )
      ComputationNode { behavior: b } =>
        bind_outcome(
          o: project_type_expression_children_in_node(
            remaining: remaining - 1,
            node: node,
            target: target,
            projection: projection
          ),
          f: fn(children) {
            Accepted {
              value: node_rebuild(n: node, children: children),
              diagnostics: None
            }
          }
        )
    }
  }
}
fn project_type_expression_children_in_node_go(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection,
  edges: List<Edge>,
  acc: List<Edge>
) -> Outcome<List<Edge>> {
  if remaining <= 0 {
    outcome_rejected(translate_type_expression_shape_missing_diagnostic(node: node))
  } else if is_empty(xs: edges) {
    Accepted { value: acc, diagnostics: None }
  } else {
    bind_outcome(
      o: edge_list_head_and_tail(edges: edges, node: node),
      f: fn(split) {
        bind_outcome(
          o: project_type_expression_subtree(
            remaining: node_subtree_count(n: split.head.target),
            node: split.head.target,
            target: target,
            projection: projection
          ),
          f: fn(projected) {
            project_type_expression_children_in_node_go(
              remaining: remaining - 1,
              node: node,
              target: target,
              projection: projection,
              edges: split.tail,
              acc: list_snoc_item(
                xs: acc,
                item: Edge { label: split.head.label, target: projected }
              )
            )
          }
        )
      }
    )
  }
}
fn project_type_expression_children_in_node(
  remaining: Int,
  node: Node,
  target: TargetModel,
  projection: TargetTypeExpressionProjection
) -> Outcome<List<Edge>> {
  project_type_expression_children_in_node_go(
    remaining: remaining,
    node: node,
    target: target,
    projection: projection,
    edges: node.children,
    acc: Empty
  )
}
fn translate_node_computation(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) { translate_fold_init(node: n0, tree: tree, target: target) },
      step: fn(acc, e, child) { translate_fold_step(acc: acc, edge: e, child: child) }
    }
  )
}
fn translate_node_mvp1(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  fold_node(
    n: node,
    algebra: NodeFold {
      init: fn(n0) { translate_mvp1_fold_init(node: n0, tree: tree, target: target) },
      step: fn(acc, e, child) { translate_fold_step(acc: acc, edge: e, child: child) }
    }
  )
}
fn translate_node(
  node: Node,
  tree: InferredTree,
  target: TargetModel
) -> Outcome<Node> {
  match target_bundle_child_optional_type_expr_projection(target: target) {
    Accepted { value: ProjectionPresent, diagnostics: _ } =>
      translate_node_with_projection(node: node, tree: tree, target: target)
    Accepted { value: ProjectionAbsent, diagnostics: _ } =>
      translate_node_mvp1(node: node, tree: tree, target: target)
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
// 🟡 gated — coproduct-dissolution interim (docs/modeling-discipline.md Practice 4/9) — feature:sg-2-mvp1-projection-absent-shim — consumer:translate_node — bind PR #3962 / docs/planning/v4-sg2-type-expression-projection-worksheet-2026-05-30.md — owner:Target Realization (SG-2) — lane:extdeps TargetModel row rollout — dissolve-on-arrival: every v4.extdeps.languages.* TargetModel bundle carries target_model_edge_type_expression_projection; delete ProjectionAbsent arm, translate_node_mvp1, and TypeExprProjectionPresence from translate_node — forbidden: steady-state dual translate paths or new ProjectionAbsent match arms outside this gate.
type TypeExprProjectionPresence
  = ProjectionPresent
  | ProjectionAbsent
fn target_bundle_child_optional_type_expr_projection(
  target: TargetModel
) -> Outcome<TypeExprProjectionPresence> {
  match target_bundle_optional_child(
    target: target,
    edge_name: target_model_edge_type_expression_projection
  ) {
    Accepted { value: Some { value: _ }, diagnostics: d } =>
      Accepted { value: ProjectionPresent, diagnostics: d }
    Accepted { value: None, diagnostics: d } =>
      Accepted { value: ProjectionAbsent, diagnostics: d }
    Rejected { diagnostics: r } =>
      Rejected { diagnostics: r }
  }
}
fn translate_fold_step(
  acc: Outcome<Node>,
  edge: Edge,
  child: Outcome<Node>
) -> Outcome<Node> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: parent, diagnostics: ad } =>
      match child {
        Accepted { value: translated_child, diagnostics: cd } =>
          Accepted {
            value: node_rebuild(
              n: parent,
              children: list_snoc_item(
                xs: parent.children,
                item: Edge { label: edge.label, target: translated_child }
              )
            ),
            diagnostics: diagnostics_merge(outer: ad, inner: cd)
          }
        Rejected { diagnostics: r } =>
          Rejected {
            diagnostics: rejected_with_pending(pending: ad, rejected: r)
          }
      }
  }
}
fn translate(
  tree: InferredTree,
  target: TargetModel
) -> Outcome<TargetNodeTree> {
  translate_node(node: tree.root, tree: tree, target: target)
}
