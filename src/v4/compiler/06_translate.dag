type TargetNodeTree = Node
// 🟢 coproduct dissolution
type TargetBundleChildLookup
  = BundleChildMissing
  | BundleChildFound { value: Node }
  | BundleChildDuplicate
  | BundleChildInvalidEdge
data translate_target_bundle_malformed: Symbol = translate_target_bundle_malformed
data translate_target_bundle_duplicate_edge: Symbol = translate_target_bundle_duplicate_edge
data translate_grammar_inverse_not_realized: Symbol = translate_grammar_inverse_not_realized
data translate_grammar_relation_row_not_found: Symbol = translate_grammar_relation_row_not_found
data translate_conj_invalid_edge: Symbol = translate_conj_invalid_edge
data translate_conj_named_child_missing: Symbol = translate_conj_named_child_missing
data translate_lex_rule_literal_not_found: Symbol = translate_lex_rule_literal_not_found
data translate_binding_spelling_not_found: Symbol = translate_binding_spelling_not_found
data translate_concrete_token_class_missing: Symbol = translate_concrete_token_class_missing
data translate_concrete_token_kind_invalid: Symbol = translate_concrete_token_kind_invalid
data translate_serialize_recursion_limit_exhausted: Symbol = translate_serialize_recursion_limit_exhausted
data translate_type_expression_shape_missing: Symbol = translate_type_expression_shape_missing
data translate_type_expr_kind_authority_invalid: Symbol = translate_type_expr_kind_authority_invalid
// node_subtree_count + translation_rules subtree — initial measure for grammar-inverse serialize.
fn node_subtree_count(n: Node) -> Int {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(_) { 1 },
      step: fn(acc, _edge, child_count) { acc + child_count }
    }
  )
}
fn target_translation_rules_budget(target: TargetModel) -> Outcome<Int> {
  bind_outcome(
    o: target_bundle_child(target: target, edge_name: target_model_edge_translation_rules),
    f: fn(rules) {
      Accepted {
        value: node_subtree_count(n: rules),
        diagnostics: None
      }
    }
  )
}
fn translate_serialize_measure(target: TargetModel, emitted: Node) -> Outcome<Int> {
  bind_outcome(
    o: target_translation_rules_budget(target: target),
    f: fn(rules_budget) {
      Accepted {
        value: node_subtree_count(n: emitted) + rules_budget + 1,
        diagnostics: None
      }
    }
  )
}
fn token_item_serialize_measure(item: Node, target: TargetModel) -> Outcome<Int> {
  bind_outcome(
    o: target_translation_rules_budget(target: target),
    f: fn(rules_budget) {
      Accepted {
        value: node_subtree_count(n: item) + rules_budget + 1,
        diagnostics: None
      }
    }
  )
}
fn token_list_node_budget(tokens: List<Node>) -> Int {
  fold_list(
    xs: tokens,
    empty: 0,
    cons: fn(acc, item) { acc + node_subtree_count(n: item) }
  )
}
fn token_sequence_serialize_measure(tokens: List<Node>, target: TargetModel) -> Outcome<Int> {
  bind_outcome(
    o: target_translation_rules_budget(target: target),
    f: fn(rules_budget) {
      Accepted {
        value: length(xs: tokens) + token_list_node_budget(tokens: tokens) + rules_budget + 1,
        diagnostics: None
      }
    }
  )
}
// 🟡 gated — feature:T-11-typed-grammar-relation-row-items — bind TASKS.md T-11 —
// dissolve-on: GrammarRelationRow.tokens carries a typed row-item carrier that separates
// concrete tokens from emitted nonterminal nodes before serialization; forbidden:
// dispatching raw List<Node> row items without this fail-closed classifier.
type TokenSequenceItemKind
  = TokenSequenceConcreteToken
  | TokenSequenceNonterminal
fn translate_target_bundle_malformed_diagnostic(target: TargetModel) -> Diagnostic {
  Diagnostic {
    reason: translate_target_bundle_malformed,
    at: node_locus(node: target.bundle),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn translate_target_bundle_duplicate_edge_diagnostic(
  target: TargetModel,
  edge_name: Symbol
) -> Diagnostic {
  Diagnostic {
    reason: translate_target_bundle_duplicate_edge,
    at: node_locus(node: target.bundle),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn target_bundle_child_lookup_step(
  acc: TargetBundleChildLookup,
  e: Edge,
  edge_name: Symbol
) -> TargetBundleChildLookup {
  match acc {
    BundleChildInvalidEdge => acc
    BundleChildDuplicate => acc
    BundleChildMissing =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            BundleChildFound { value: e.target }
          } else {
            acc
          }
        Positional => BundleChildInvalidEdge
      }
    BundleChildFound { value: _ } =>
      match e.label {
        Named { name: n } =>
          if n == edge_name {
            BundleChildDuplicate
          } else {
            acc
          }
        Positional => BundleChildInvalidEdge
      }
  }
}
fn conj_named_child(parent: Node, edge_name: Symbol) -> Outcome<Node> {
  match parent.kind {
    TypeNode { connective: Conj } =>
      match fold(
        parent.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: child, diagnostics: None }
        BundleChildMissing =>
          outcome_rejected(translate_conj_named_child_missing_diagnostic(parent: parent))
        BundleChildDuplicate =>
          outcome_rejected(
            Diagnostic {
              reason: translate_target_bundle_duplicate_edge,
              at: node_locus(node: parent),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_conj_invalid_edge_diagnostic(parent: parent))
      }
    _ =>
      outcome_rejected(
        Diagnostic {
          reason: translate_grammar_inverse_not_realized,
          at: node_locus(node: parent),
          correction: Unavailable { reason: ExternalContractUnknown }
        }
      )
  }
}
fn conj_optional_named_child(parent: Node, edge_name: Symbol) -> Outcome<Node?> {
  match parent.kind {
    TypeNode { connective: Conj } =>
      match fold(
        parent.children,
        init: BundleChildMissing,
        f: fn(acc, e) {
          target_bundle_child_lookup_step(acc: acc, e: e, edge_name: edge_name)
        }
      ) {
        BundleChildFound { value: child } =>
          Accepted { value: Some { value: child }, diagnostics: None }
        BundleChildMissing =>
          Accepted { value: None, diagnostics: None }
        BundleChildDuplicate =>
          outcome_rejected(
            Diagnostic {
              reason: translate_target_bundle_duplicate_edge,
              at: node_locus(node: parent),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          )
        BundleChildInvalidEdge =>
          outcome_rejected(translate_conj_invalid_edge_diagnostic(parent: parent))
      }
    _ =>
      outcome_rejected(
        Diagnostic {
          reason: translate_grammar_inverse_not_realized,
          at: node_locus(node: parent),
          correction: Unavailable { reason: ExternalContractUnknown }
        }
      )
  }
}
fn translate_grammar_inverse_not_realized_diagnostic(emitted: Node) -> Diagnostic {
  Diagnostic {
    reason: translate_grammar_inverse_not_realized,
    at: node_locus(node: emitted),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
