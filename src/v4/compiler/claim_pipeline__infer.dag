// Note: normalize→resolve→infer on void C3 sugar is deferred until constraint solve aligns with
//   wave-1 void ResolvedTree shape (manual/infer_ground_add_mvp.dag owns the worked fixture).

module v4.test.claim_pipeline.infer


import v4.compiler.infer { infer }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v4.std.verification {
  CompilesClaim,
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Unit,
  manual_claim_anchor
}
import v4.test.manual.infer_ground_add_mvp { fixture_add_resolved_tree }
data spine_infer_module_subject: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^spine_infer_module } },
  children: [],
  occurrence_id: SyntheticOccurrence
}
fn spine_infer_accepts_mvp_resolved_tree() -> Bool {
  match infer(tree: fixture_add_resolved_tree()) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}


fn spine_infer_bool_atom(b: Bool) -> Node {
  match b {
    true =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_infer_pass } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
    false =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^spine_infer_fail } },
        children: [],
        occurrence_id: SyntheticOccurrence
}
  }
}


data claim_pipeline_infer_module_compiles: TestClaim = CompilesClaim {
  label: "claim_pipeline/infer: v4.compiler.infer stage module compiles",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  input: spine_infer_module_subject,
  expected_value: spine_infer_module_subject,
  classification: TestClassification { tier: Tier1, layer: Unit }
}


data claim_pipeline_infer_accepts_mvp_resolved_tree: TestClaim = EqualsClaim {
  label: "claim_pipeline/infer: infer accepts MVP add-shaped ResolvedTree (T-9 worked fixture)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: spine_infer_bool_atom(b: spine_infer_accepts_mvp_resolved_tree()),
  rhs: spine_infer_bool_atom(b: true),
  classification: TestClassification { tier: Tier1, layer: Unit }
}
