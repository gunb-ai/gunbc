// src/v4/compiler/02_parse.dag
// Scope: generic parsing over language grammar rules.
// Anchor: https://en.wikipedia.org/wiki/Parsing
// Owns: Grammar, ParseTree, grammar_* production-data symbols, parse_stage_locus_port, parse_walk_not_realized, parse_grammar_not_well_formed, parse_g0_tokens_remain, parse_walk_not_realized_diagnostic, parse_grammar_not_well_formed_diagnostic, parse_g0_tokens_remain_diagnostic, grammar_node_is_conj_empty_root, grammar_node_is_syntactic_data_root, parse.
// Consumes: std collection, std diagnostic, std node, compiler tokenize.
// Status: Wave-1 void-grammar path realized.


module v4.compiler.parse


import v4.compiler.tokenize { TokenStream }
import v4.std.diagnostic {
  Correction,
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  Outcome,
  PortLocus,
  UserInputBoundary,
}
import v4.std.node {
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Instantiation,
  Node,
  NodeKind,
  Positional,
  Symbol,
  TypeNode,
  node_well_formed,
}


type Grammar = Node


type ParseTree = Node


data grammar_root: Symbol = grammar_root
data grammar_production: Symbol = grammar_production
data grammar_terminal: Symbol = grammar_terminal
data grammar_nonterminal: Symbol = grammar_nonterminal
data grammar_sequence: Symbol = grammar_sequence
data grammar_choice: Symbol = grammar_choice
data grammar_optional: Symbol = grammar_optional
data grammar_repeat: Symbol = grammar_repeat
data grammar_emit_node: Symbol = grammar_emit_node

data parse_stage_locus_port: Symbol = parse_stage_locus_port

data parse_walk_not_realized: Symbol = parse_walk_not_realized

data parse_grammar_not_well_formed: Symbol = parse_grammar_not_well_formed

data parse_g0_tokens_remain: Symbol = parse_g0_tokens_remain


fn parse_walk_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_walk_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_grammar_not_well_formed_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_grammar_not_well_formed,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_g0_tokens_remain_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_g0_tokens_remain,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}
fn grammar_node_is_conj_empty_root(g: Node) -> Bool {
  match g.kind {
    TypeNode { connective: Conj } => count(g.children) == 0
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}
fn grammar_atom(identity: Symbol) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: identity }
    },
    children: []
  }
}
fn grammar_positional_edge(target: Node) -> Edge {
  Edge {
    label: Positional,
    target: target
  }
}
fn grammar_terminal_node(token_class: Symbol) -> Node {
  Node {
    kind: TypeNode {
      connective: Instantiation
    },
    children: [
      grammar_positional_edge(target: grammar_atom(identity: grammar_terminal)),
      grammar_positional_edge(target: grammar_atom(identity: token_class))
    ]
  }
}
fn grammar_nonterminal_node(name: Symbol) -> Node {
  Node {
    kind: TypeNode {
      connective: Instantiation
    },
    children: [
      grammar_positional_edge(target: grammar_atom(identity: grammar_nonterminal)),
      grammar_positional_edge(target: grammar_atom(identity: name))
    ]
  }
}
fn grammar_unary_node(kind: Symbol, element: Node) -> Node {
  Node {
    kind: TypeNode {
      connective: Instantiation
    },
    children: [
      grammar_positional_edge(target: grammar_atom(identity: kind)),
      grammar_positional_edge(target: element)
    ]
  }
}
fn grammar_binary_node(kind: Symbol, left: Node, right: Node) -> Node {
  Node {
    kind: TypeNode {
      connective: Instantiation
    },
    children: [
      grammar_positional_edge(target: grammar_atom(identity: kind)),
      grammar_positional_edge(target: left),
      grammar_positional_edge(target: right)
    ]
  }
}
fn grammar_sequence_node(left: Node, right: Node) -> Node {
  grammar_binary_node(kind: grammar_sequence, left: left, right: right)
}
fn grammar_choice_node(left: Node, right: Node) -> Node {
  grammar_binary_node(kind: grammar_choice, left: left, right: right)
}
fn grammar_optional_node(element: Node) -> Node {
  grammar_unary_node(kind: grammar_optional, element: element)
}
fn grammar_repeat_node(element: Node) -> Node {
  grammar_unary_node(kind: grammar_repeat, element: element)
}
fn grammar_production_node(name: Symbol, expression: Node, emitted: Node) -> Node {
  Node {
    kind: TypeNode {
      connective: Instantiation
    },
    children: [
      grammar_positional_edge(target: grammar_atom(identity: grammar_production)),
      grammar_positional_edge(target: grammar_atom(identity: name)),
      grammar_positional_edge(target: expression),
      grammar_positional_edge(target: grammar_unary_node(kind: grammar_emit_node, element: emitted))
    ]
  }
}
fn grammar_root_node(start: Symbol, production: Node) -> Node {
  Node {
    kind: TypeNode {
      connective: Instantiation
    },
    children: [
      grammar_positional_edge(target: grammar_atom(identity: grammar_root)),
      grammar_positional_edge(target: grammar_atom(identity: start)),
      grammar_positional_edge(target: production)
    ]
  }
}
fn grammar_node_is_syntactic_data_root(g: Node) -> Bool {
  match g.kind {
    TypeNode { connective: Instantiation } => count(g.children) > 0
    TypeNode { connective: Conj } => count(g.children) > 0
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}
fn parse(tokens: TokenStream, grammar: Grammar) -> Outcome<ParseTree> {
  let at = PortLocus {
    port: parse_stage_locus_port
  }
  let ntok = count(tokens.tokens)
  if !node_well_formed(n: grammar) {
    Rejected {
      diagnostic: parse_grammar_not_well_formed_diagnostic(at: at)
    }
  } else if grammar_node_is_conj_empty_root(g: grammar) {
    if ntok == 0 {
      Produced {
        value: grammar
      }
    } else {
      Rejected {
        diagnostic: parse_g0_tokens_remain_diagnostic(at: at)
      }
    }
  } else if grammar_node_is_syntactic_data_root(g: grammar) {
    Rejected {
      diagnostic: parse_walk_not_realized_diagnostic(at: at)
    }
  } else {
    Rejected {
      diagnostic: parse_walk_not_realized_diagnostic(at: at)
    }
  }
}
