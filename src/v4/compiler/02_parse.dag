// src/v4/compiler/02_parse.dag
// Scope: generic parsing over language grammar rules.
// Anchor: https://en.wikipedia.org/wiki/Parsing
// Owns: Grammar type hierarchy (GrammarExpr/GrammarProduction/GrammarRoot), ParseTree, parse walk,
//       Node projection functions, left-recursion check, error-recovery helpers,
//       ParseSyncState, TokenPeek, ParseRepeatAcc, parse_diag_cons, parse_token_first,
//       parse_e1_syntax_error, expr_is_nullable_given_set, compute_nullable_set,
//       expr_direct_left_corner_list, compute_left_corner_closure,
//       expr_has_undefined_nonterminal, grammar_has_undefined_nonterminals,
//       grammar_has_left_recursion_step, grammar_has_undefined_nonterminals_step,
//       parse_sync_step, grammar_fuel.
// Consumes: std diagnostic, std node, std algebra, std collection, std nat, compiler tokenize.
// Status: T-7 parse walk realized; sync_tokens field staged for T-8 error-recovery trigger.
//         Zero Annotation Mandate applied: fold-based fixpoint for nullable/left-corner sets;
//         parse_expr Nonterminal arm uses grammar_fuel measure + visited: List<Symbol>
//         (nat_monus semantics — measure = production_count − expansion_depth);
//         all fuel: Nat parameters removed. T-22 complexity analysis: 0 diagnostics.


module v4.compiler.parse


import v4.compiler.tokenize { Token, TokenStream }
import v4.std.diagnostic { Accepted, Diagnostic, Diagnostics, ExternalContractUnknown, Locus, NonEmptyDiagnostics, None, Outcome, Some, Unavailable, UserInputBoundary, diagnostics_singleton, port_locus }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, well_formed }
import v4.std.collection { List, Set }
import v4.std.algebra { Cons, Empty, contains, fold_list, fold_list_right, is_empty, length, list_append, list_skip, list_snoc_item }
import v4.std.logic { Bool }
import v4.std.nat { Nat, Zero, Succ }


// 🟡 gated — feature:CP-1b-bidirectional-grammar-carrier — bind TASKS.md T-6/T-7 — dissolve-on: GrammarExpr converges with LexPattern on single declarative bidirectional grammar model; forbidden: parallel production algebras without explicit structural justification.
type GrammarExpr
  = Terminal { token_class: Symbol }
  | Nonterminal { production: Symbol }
  | Sequence { left: GrammarExpr, right: GrammarExpr }
  | Choice { left: GrammarExpr, right: GrammarExpr }
  | Optional { element: GrammarExpr }
  | Repeat { element: GrammarExpr }


type GrammarProduction {
  name: Symbol
  expression: GrammarExpr
  emitted: Node
}


// 🟡 gated — feature: T-8 parse error-recovery trigger — sync_tokens present; parse_skip_to_sync
// is structurally correct but unreachable until parse_expr emits non-empty diagnostics on
// committed Terminal mismatches. Dissolve-on: T-8.
type GrammarRoot {
  start: Symbol
  productions: List<GrammarProduction>
  sync_tokens: Set<Symbol>
}


// 🟡 gated — feature:CP-1b-bidirectional-grammar-carrier — bind TASKS.md T-6/T-7 — dissolve-on: Grammar converges with LexPattern on single declarative bidirectional grammar model; forbidden: parallel production algebras without explicit structural justification.
type Grammar
  = VoidGrammar
  | ModeledGrammar { root: GrammarRoot }


type ParseTree = Node

// 🟡 coproduct dissolution — feature:grammar-production-index; T-7 arrived; dissolve when Map<Symbol, GrammarProduction> substrate lands and replaces the linear fold with O(1) lookup.
type GrammarProductionLookup
  = GrammarProductionFound { production: GrammarProduction }
  | GrammarProductionMissing

// 🟡 coproduct dissolution — feature:T-8-parse-result-projection; per-expression walk result; dissolves when parse-walk result carrier unifies with Outcome<ParseTree> via T-8 projection (remaining/captured consolidates; List<Diagnostic> accumulator lifts into standard Diagnostics).
type ParseExprResult
  = ParseExprAccepted { remaining: List<Token>, captured: Node, diagnostics: List<Diagnostic> }
  | ParseExprRejected { diagnostics: List<Diagnostic> }

type ParseSyncState {
  found_sync: Bool
  result: List<Token>
}

type GrammarDupCheckState {
  seen: Set<Symbol>
  has_duplicate: Bool
}

// 🟡 coproduct dissolution — feature: FreeMonoid substrate first<T> accessor; dissolves when stdlib provides a substrate-derived head projection that returns Option<T> directly, eliminating the per-use carrier type.
type TokenPeek
  = TokenPeekAbsent
  | TokenPeekFirst { value: Token }

// Accumulator for the fold-list based Repeat implementation in parse_expr.
// fold_list over the token stream bounds iterations to length(tokens);
// done: true short-circuits remaining steps.
type ParseRepeatAcc {
  remaining: List<Token>
  acc_nodes: List<Node>
  acc_diags: List<Diagnostic>
  done: Bool
}

data grammar_terminal_token_class_node_projection: Symbol = grammar_terminal_token_class_node_projection
data grammar_nonterminal_production_node_projection: Symbol = grammar_nonterminal_production_node_projection
data grammar_sequence_left_node_projection: Symbol = grammar_sequence_left_node_projection
data grammar_sequence_right_node_projection: Symbol = grammar_sequence_right_node_projection
data grammar_choice_left_node_projection: Symbol = grammar_choice_left_node_projection
data grammar_choice_right_node_projection: Symbol = grammar_choice_right_node_projection
data grammar_optional_element_node_projection: Symbol = grammar_optional_element_node_projection
data grammar_repeat_element_node_projection: Symbol = grammar_repeat_element_node_projection
data grammar_production_name_node_projection: Symbol = grammar_production_name_node_projection
data grammar_production_expression_node_projection: Symbol = grammar_production_expression_node_projection
data grammar_production_emitted_node_projection: Symbol = grammar_production_emitted_node_projection
data grammar_root_start_production_node_projection: Symbol = grammar_root_start_production_node_projection
data grammar_root_productions_node_projection: Symbol = grammar_root_productions_node_projection
data grammar_root_sync_tokens_node_projection: Symbol = grammar_root_sync_tokens_node_projection
data grammar_production_identity_node_projection: Symbol = grammar_production_identity_node_projection
data grammar_production_captured_node_projection: Symbol = grammar_production_captured_node_projection

data parse_stage_locus_port: Symbol = parse_stage_locus_port

data parse_walk_not_realized: Symbol = parse_walk_not_realized

data parse_grammar_not_well_formed: Symbol = parse_grammar_not_well_formed

data parse_g0_tokens_remain: Symbol = parse_g0_tokens_remain

data parse_grammar_left_recursive: Symbol = parse_grammar_left_recursive

data parse_grammar_undefined_nonterminal: Symbol = parse_grammar_undefined_nonterminal

data parse_grammar_duplicate_production: Symbol = parse_grammar_duplicate_production

data parse_e1_syntax_error: Symbol = parse_e1_syntax_error


fn parse_walk_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_walk_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_grammar_not_well_formed_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_grammar_not_well_formed,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_g0_tokens_remain_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_g0_tokens_remain,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


