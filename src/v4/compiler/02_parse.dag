fn grammar_atom(identity: Symbol) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: identity }
    },
    children: []
  }
}


fn grammar_named_edge(name: Symbol, target: Node) -> Edge {
  Edge {
    label: Named { name: name },
    target: target
  }
}


fn grammar_empty_sync_tokens() -> Set<Symbol> {
  Set { member: fn(_) { false } }
}


fn grammar_empty_node() -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: []
  }
}


fn grammar_expr_to_node(expr: GrammarExpr) -> Node {
  match expr {
    Terminal { token_class: token_class } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_terminal_token_class_node_projection, target: grammar_atom(identity: token_class))
        ]
      }
    Nonterminal { production: production } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_nonterminal_production_node_projection, target: grammar_atom(identity: production))
        ]
      }
    Sequence { left: left, right: right } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_sequence_left_node_projection, target: grammar_expr_to_node(expr: left)),
          grammar_named_edge(name: grammar_sequence_right_node_projection, target: grammar_expr_to_node(expr: right))
        ]
      }
    Choice { left: left, right: right } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_choice_left_node_projection, target: grammar_expr_to_node(expr: left)),
          grammar_named_edge(name: grammar_choice_right_node_projection, target: grammar_expr_to_node(expr: right))
        ]
      }
    Optional { element: element } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_optional_element_node_projection, target: grammar_expr_to_node(expr: element))
        ]
      }
    Repeat { element: element } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_repeat_element_node_projection, target: grammar_expr_to_node(expr: element))
        ]
      }
  }
}


fn grammar_production_to_node(production: GrammarProduction) -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: [
      grammar_named_edge(name: grammar_production_name_node_projection, target: grammar_atom(identity: production.name)),
      grammar_named_edge(name: grammar_production_expression_node_projection, target: grammar_expr_to_node(expr: production.expression)),
      grammar_named_edge(name: grammar_production_emitted_node_projection, target: production.emitted)
    ]
  }
}


fn grammar_production_to_list_step(acc: List<Edge>, production: GrammarProduction) -> List<Edge> {
  list_snoc_item(
    xs: acc,
    item: grammar_named_edge(
      name: production.name,
      target: grammar_production_to_node(production: production)
    )
  )
}


fn grammar_productions_to_node(productions: List<GrammarProduction>) -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: fold_list(
      xs: productions,
      empty: Empty,
      cons: fn(acc, production) {
        grammar_production_to_list_step(acc: acc, production: production)
      }
    )
  }
}


// 🟡 gated — P2-boundary-dissolution interim — feature: grammar-root-node-projection-completeness —
// GrammarRoot.sync_tokens: Set<Symbol> is a predicate closure { member: fn(Symbol) -> Bool };
// the Node substrate has no edge kind for function values, so sync_tokens cannot be materialized
// as a Node child. The projection constant grammar_root_sync_tokens_node_projection is declared
// above to name the intended edge. Dissolve-on: substrate literal-value edge support for
// predicate sets, or Set<Symbol> reified as an explicit membership list type.
fn grammar_root_to_node(root: GrammarRoot) -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: [
      grammar_named_edge(name: grammar_root_start_production_node_projection, target: grammar_atom(identity: root.start)),
      grammar_named_edge(name: grammar_root_productions_node_projection, target: grammar_productions_to_node(productions: root.productions))
    ]
  }
}


fn grammar_to_node(grammar: Grammar) -> Node {
  match grammar {
    VoidGrammar => grammar_empty_node()
    ModeledGrammar { root: root } => grammar_root_to_node(root: root)
  }
}


fn grammar_lookup_production_step(
  acc: GrammarProductionLookup,
  production: GrammarProduction,
  name: Symbol
) -> GrammarProductionLookup {
  match acc {
    GrammarProductionFound { production: _ } => acc
    GrammarProductionMissing =>
      if production.name == name {
        GrammarProductionFound { production: production }
      } else {
        acc
      }
  }
}


fn grammar_lookup_production(root: GrammarRoot, name: Symbol) -> GrammarProductionLookup {
  fold_list(
    xs: root.productions,
    empty: GrammarProductionMissing,
    cons: fn(acc, production) {
      grammar_lookup_production_step(acc: acc, production: production, name: name)
    }
  )
}


// --- Left-recursion detection ---

// set_symbol_insert: functional set extension — new set tests item first, then delegates.
fn set_symbol_insert(s: Set<Symbol>, item: Symbol) -> Set<Symbol> {
  Set {
    member: fn(sym) { sym == item || s.member(sym) }
  }
}


// grammar_fuel: production count as Nat — initial measure for parse_expr's Nonterminal arm.
// Semantics: nat_monus(production_count, length(visited)) — remaining expansion budget.
// With visited: List<Symbol> guarding re-entry of any production, expansion depth ≤
// production_count for well-formed non-left-recursive grammars. P4 concern from prior
// fuel-only scheme is resolved: visited cycle guard makes the bound tight.
fn grammar_fuel(root: GrammarRoot) -> Nat {
  fold_list(xs: root.productions, empty: Zero, cons: fn(acc, _) { Succ { prev: acc } })
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarExpr structural morphism substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived nullable query morphism over GrammarExpr coproduct (per-variant fold eliminating hand-written match arms); forbidden: duplicating nullable logic outside this function.
// expr_is_nullable_given_set: true iff expr can match empty input given a pre-computed nullable set.
// Structurally recursive on GrammarExpr (finite tree) — no fuel needed.
// Nonterminal arms consult nullable_set rather than following production references.
fn expr_is_nullable_given_set(expr: GrammarExpr, nullable_set: Set<Symbol>) -> Bool {
  match expr {
    Terminal { token_class: _ } => false
    Nonterminal { production: name } => nullable_set.member(name)
    Sequence { left: left, right: right } =>
      expr_is_nullable_given_set(expr: left, nullable_set: nullable_set) &&
      expr_is_nullable_given_set(expr: right, nullable_set: nullable_set)
    Choice { left: left, right: right } =>
      expr_is_nullable_given_set(expr: left, nullable_set: nullable_set) ||
      expr_is_nullable_given_set(expr: right, nullable_set: nullable_set)
    Optional { element: _ } => true
    Repeat { element: _ } => true
  }
}


// compute_nullable_set: fixpoint over productions.
// Outer fold iterates |productions| times (convergence bound); inner fold adds nullable productions.
fn compute_nullable_set(root: GrammarRoot) -> Set<Symbol> {
  fold_list(
    xs: root.productions,
    empty: Set { member: fn(_) { false } },
    cons: fn(acc, _) {
      fold_list(
        xs: root.productions,
        empty: acc,
        cons: fn(ns, p) {
          if expr_is_nullable_given_set(expr: p.expression, nullable_set: ns) {
            set_symbol_insert(s: ns, item: p.name)
          } else {
            ns
          }
        }
      )
    }
  )
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarExpr left-corner query substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived left-corner reachability morphism over GrammarExpr coproduct; forbidden: duplicating left-corner logic or inlining nullable check outside this function.
// expr_direct_left_corner_list: direct (non-transitive) left-corner nonterminals of expr.
// Structurally recursive on GrammarExpr (finite tree) — no fuel needed.
// Sequence: when left is nullable, both left and right contribute left corners.
fn expr_direct_left_corner_list(expr: GrammarExpr, nullable_set: Set<Symbol>) -> List<Symbol> {
  match expr {
    Terminal { token_class: _ } => Empty
    Nonterminal { production: name } => Cons { head: name, tail: Empty }
    Sequence { left: left, right: right } =>
      if expr_is_nullable_given_set(expr: left, nullable_set: nullable_set) {
        list_append(
          left: expr_direct_left_corner_list(expr: left, nullable_set: nullable_set),
          right: expr_direct_left_corner_list(expr: right, nullable_set: nullable_set)
        )
      } else {
        expr_direct_left_corner_list(expr: left, nullable_set: nullable_set)
      }
    Choice { left: left, right: right } =>
      list_append(
        left: expr_direct_left_corner_list(expr: left, nullable_set: nullable_set),
        right: expr_direct_left_corner_list(expr: right, nullable_set: nullable_set)
      )
    Optional { element: element } =>
      expr_direct_left_corner_list(expr: element, nullable_set: nullable_set)
    Repeat { element: element } =>
      expr_direct_left_corner_list(expr: element, nullable_set: nullable_set)
  }
}


// compute_left_corner_closure: transitive closure of left-corner reachability from start symbols.
// Outer fold iterates |productions| times (convergence bound).
// Inner fold expands each reachable symbol by its production's direct left corners.
fn compute_left_corner_closure(
  start: List<Symbol>,
  nullable_set: Set<Symbol>,
  root: GrammarRoot
) -> List<Symbol> {
  fold_list(
    xs: root.productions,
    empty: start,
    cons: fn(reachable, _) {
      fold_list(
        xs: reachable,
        empty: reachable,
        cons: fn(acc, sym) {
          match grammar_lookup_production(root: root, name: sym) {
            GrammarProductionMissing => acc
            GrammarProductionFound { production: prod } =>
              fold_list(
                xs: expr_direct_left_corner_list(expr: prod.expression, nullable_set: nullable_set),
                empty: acc,
                cons: fn(r, name) {
                  if contains(xs: r, item: name, eq: fn(a, b) { a == b }) {
                    r
                  } else {
                    list_snoc_item(xs: r, item: name)
                  }
                }
              )
          }
        }
      )
    }
  )
}


fn grammar_has_left_recursion_step(acc: Bool, p: GrammarProduction, root: GrammarRoot, nullable_set: Set<Symbol>) -> Bool {
  acc ||
  contains(
    xs: compute_left_corner_closure(
      start: expr_direct_left_corner_list(expr: p.expression, nullable_set: nullable_set),
      nullable_set: nullable_set,
      root: root
    ),
    item: p.name,
    eq: fn(a, b) { a == b }
  )
}


fn grammar_has_left_recursion(root: GrammarRoot) -> Bool {
  let nullable_set = compute_nullable_set(root: root)
  fold_list(
    xs: root.productions,
    empty: false,
    cons: fn(acc, p) { grammar_has_left_recursion_step(acc: acc, p: p, root: root, nullable_set: nullable_set) }
  )
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarExpr production-reference closure query substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived undefined-nonterminal query morphism over GrammarExpr coproduct; forbidden: duplicating reference-closure logic outside this function.
// Structural recursion on GrammarExpr (finite tree) — does NOT follow nonterminal
// references into their productions, so it always terminates without a visited set.
fn expr_has_undefined_nonterminal(expr: GrammarExpr, root: GrammarRoot) -> Bool {
  match expr {
    Terminal { token_class: _ } => false
    Nonterminal { production: p } =>
      match grammar_lookup_production(root: root, name: p) {
        GrammarProductionMissing => true
        GrammarProductionFound { production: _ } => false
      }
    Sequence { left: left, right: right } =>
      expr_has_undefined_nonterminal(expr: left, root: root) ||
      expr_has_undefined_nonterminal(expr: right, root: root)
    Choice { left: left, right: right } =>
      expr_has_undefined_nonterminal(expr: left, root: root) ||
      expr_has_undefined_nonterminal(expr: right, root: root)
    Optional { element: element } =>
      expr_has_undefined_nonterminal(expr: element, root: root)
    Repeat { element: element } =>
      expr_has_undefined_nonterminal(expr: element, root: root)
  }
}


fn grammar_has_undefined_nonterminals_step(acc: Bool, p: GrammarProduction, root: GrammarRoot) -> Bool {
  acc || expr_has_undefined_nonterminal(expr: p.expression, root: root)
}


fn grammar_has_undefined_nonterminals(root: GrammarRoot) -> Bool {
  match grammar_lookup_production(root: root, name: root.start) {
    GrammarProductionMissing => true
    GrammarProductionFound { production: _ } =>
      fold_list(
        xs: root.productions,
        empty: false,
        cons: fn(acc, p) { grammar_has_undefined_nonterminals_step(acc: acc, p: p, root: root) }
      )
  }
}


fn grammar_dup_check_step(acc: GrammarDupCheckState, p: GrammarProduction) -> GrammarDupCheckState {
  if acc.has_duplicate {
    acc
  } else {
    if acc.seen.member(p.name) {
      GrammarDupCheckState { seen: acc.seen, has_duplicate: true }
    } else {
      GrammarDupCheckState { seen: set_symbol_insert(s: acc.seen, item: p.name), has_duplicate: false }
    }
  }
}


fn grammar_has_duplicate_productions(root: GrammarRoot) -> Bool {
  fold_list(
    xs: root.productions,
    empty: GrammarDupCheckState { seen: Set { member: fn(_) { false } }, has_duplicate: false },
    cons: fn(acc, p) { grammar_dup_check_step(acc: acc, p: p) }
  ).has_duplicate
}


// --- Diagnostic list helpers ---

fn parse_diag_cons(d: Diagnostic, acc: Diagnostics) -> Diagnostics {
  match acc {
    None => Some { diagnostics: NonEmptyDiagnostics { head: d, tail: [] } }
    Some { diagnostics: ned } =>
      Some {
        diagnostics: NonEmptyDiagnostics {
          head: d,
          tail: list_append(left: [ned.head], right: ned.tail)
        }
      }
  }
}


fn parse_diags_to_diagnostics(diags: List<Diagnostic>) -> Diagnostics {
  fold_list_right(xs: diags, empty: None, snoc: fn(acc, d) { parse_diag_cons(d: d, acc: acc) })
}


fn parse_diags_to_non_empty(diags: List<Diagnostic>, default: Diagnostic) -> NonEmptyDiagnostics {
  match parse_diags_to_diagnostics(diags: diags) {
    None => NonEmptyDiagnostics { head: default, tail: [] }
    Some { diagnostics: ned } => ned
  }
}


// --- Parse walk helpers ---

fn parse_repeat_captured_node(acc_nodes: List<Node>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: acc_nodes,
      empty: Empty,
      cons: fn(acc, n) {
        list_snoc_item(
          xs: acc,
          item: Edge {
            label: Named { name: grammar_repeat_element_node_projection },
            target: n
          }
        )
      }
    )
  }
}


// Skip tokens until a sync token is found (inclusive — returns stream starting at sync token).
fn parse_sync_step(acc: ParseSyncState, tok: Token, sync_tokens: Set<Symbol>) -> ParseSyncState {
  match acc.found_sync {
    true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: acc.result, item: tok) }
    false =>
      match sync_tokens.member(tok.class) {
        true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: Empty, item: tok) }
        false => ParseSyncState { found_sync: false, result: Empty }
      }
  }
}


fn parse_skip_to_sync(tokens: List<Token>, sync_tokens: Set<Symbol>) -> ParseSyncState {
  fold_list(
    xs: tokens,
    empty: ParseSyncState { found_sync: false, result: Empty },
    cons: fn(acc, tok) { parse_sync_step(acc: acc, tok: tok, sync_tokens: sync_tokens) }
  )
}


fn parse_token_first(tokens: List<Token>) -> TokenPeek {
  fold_list_right(xs: tokens, empty: TokenPeekAbsent, snoc: fn(_acc, tok) { TokenPeekFirst { value: tok } })
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarExpr structural morphism substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived recursive-descent parse morphism over GrammarExpr coproduct (per-variant fold eliminating hand-written match arms); forbidden: duplicating parse walk logic or adding new GrammarExpr arms outside this function.
// parse_expr: recursive-descent parse walk.
// measure: Nat — initial value grammar_fuel(root); decrements once per Nonterminal expansion.
// visited: List<Symbol> — productions entered on this path; guards against cycles.
// Semantics: measure = nat_monus(production_count, length(visited)) — remaining expansion budget.
fn parse_expr(
  expr: GrammarExpr,
  tokens: List<Token>,
  root: GrammarRoot,
  measure: Nat,
  visited: List<Symbol>
) -> ParseExprResult {
  match expr {
    Terminal { token_class: class } =>
      match parse_token_first(tokens: tokens) {
        TokenPeekAbsent => ParseExprRejected { diagnostics: [] }
        TokenPeekFirst { value: tok } =>
          match tok.class == class {
            true =>
              // 🟡 gated T-8: terminal node carries tok.class only — tok.lexeme, tok.file, tok.start, tok.end
              // are staged for T-8 source-text anchoring. The node substrate has no String/Nat literal-value
              // edge kind; carrying those facts requires a substrate literal-carrier or String→Symbol projection.
              // Dissolve-on: T-8 source-text anchor feature or substrate literal-value edge support.
              ParseExprAccepted {
                remaining: list_skip(xs: tokens, n: 1),
                captured: Node {
                  kind: TypeNode { connective: Atom { identity: tok.class } },
                  children: []
                },
                diagnostics: []
              }
            false => ParseExprRejected { diagnostics: [] }
          }
      }
    Nonterminal { production: prod_name } =>
      if contains(xs: visited, item: prod_name, eq: fn(a, b) { a == b }) {
        ParseExprRejected { diagnostics: [] }
      } else {
        match measure {
          Zero => ParseExprRejected { diagnostics: [] }
          Succ { prev: rest_measure } =>
            let new_visited = list_snoc_item(xs: visited, item: prod_name)
            match grammar_lookup_production(root: root, name: prod_name) {
              GrammarProductionMissing =>
                ParseExprRejected { diagnostics: [] }
              GrammarProductionFound { production: production } =>
                match parse_expr(expr: production.expression, tokens: tokens, root: root, measure: rest_measure, visited: new_visited) {
                  ParseExprRejected { diagnostics: diags } =>
                    ParseExprRejected { diagnostics: diags }
                  ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags } =>
                    ParseExprAccepted {
                      remaining: remaining,
                      captured: Node {
                        kind: TypeNode { connective: Conj },
                        children: [
                          grammar_named_edge(name: grammar_production_identity_node_projection, target: production.emitted),
                          grammar_named_edge(name: grammar_production_captured_node_projection, target: captured)
                        ]
                      },
                      diagnostics: diags
                    }
                }
            }
        }
      }
    Sequence { left: left, right: right } =>
      match parse_expr(expr: left, tokens: tokens, root: root, measure: measure, visited: visited) {
        ParseExprRejected { diagnostics: diags } =>
          ParseExprRejected { diagnostics: diags }
        ParseExprAccepted { remaining: rest1, captured: cap1, diagnostics: diags1 } =>
          match parse_expr(expr: right, tokens: rest1, root: root, measure: measure, visited: visited) {
            ParseExprRejected { diagnostics: diags2 } =>
              ParseExprRejected { diagnostics: list_append(left: diags1, right: diags2) }
            ParseExprAccepted { remaining: rest2, captured: cap2, diagnostics: diags2 } =>
              ParseExprAccepted {
                remaining: rest2,
                captured: Node {
                  kind: TypeNode { connective: Conj },
                  children: [
                    grammar_named_edge(name: grammar_sequence_left_node_projection, target: cap1),
                    grammar_named_edge(name: grammar_sequence_right_node_projection, target: cap2)
                  ]
                },
                diagnostics: list_append(left: diags1, right: diags2)
              }
          }
      }
    Choice { left: left, right: right } =>
      match parse_expr(expr: left, tokens: tokens, root: root, measure: measure, visited: visited) {
        ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags } =>
          ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags }
        ParseExprRejected { diagnostics: _ } =>
          parse_expr(expr: right, tokens: tokens, root: root, measure: measure, visited: visited)
      }
    Optional { element: element } =>
      match parse_expr(expr: element, tokens: tokens, root: root, measure: measure, visited: visited) {
        ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags } =>
          ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags }
        ParseExprRejected { diagnostics: _ } =>
          ParseExprAccepted {
            remaining: tokens,
            captured: grammar_empty_node(),
            diagnostics: []
          }
      }
    Repeat { element: element } =>
      // fold_list bounds iterations to length(tokens); done: true short-circuits remaining steps.
      // Each consuming iteration reduces acc.remaining; zero-progress or rejection sets done: true.
      let init = ParseRepeatAcc { remaining: tokens, acc_nodes: [], acc_diags: [], done: false }
      let result = fold_list(
        xs: tokens,
        empty: init,
        cons: fn(acc, _) {
          match acc.done {
            true => acc
            false =>
              match parse_expr(expr: element, tokens: acc.remaining, root: root, measure: measure, visited: visited) {
                ParseExprRejected { diagnostics: _ } =>
                  ParseRepeatAcc {
                    remaining: acc.remaining,
                    acc_nodes: acc.acc_nodes,
                    acc_diags: acc.acc_diags,
                    done: true
                  }
                ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags } =>
                  match length(xs: rest) != length(xs: acc.remaining) {
                    true =>
                      ParseRepeatAcc {
                        remaining: rest,
                        acc_nodes: list_snoc_item(xs: acc.acc_nodes, item: cap),
                        acc_diags: list_append(left: acc.acc_diags, right: diags),
                        done: false
                      }
                    false =>
                      ParseRepeatAcc {
                        remaining: acc.remaining,
                        acc_nodes: acc.acc_nodes,
                        acc_diags: acc.acc_diags,
                        done: true
                      }
                  }
              }
          }
        }
      )
      ParseExprAccepted {
        remaining: result.remaining,
        captured: parse_repeat_captured_node(acc_nodes: result.acc_nodes),
        diagnostics: result.acc_diags
      }
  }
}


fn parse_production(tokens: List<Token>, root: GrammarRoot, production: GrammarProduction) -> Outcome<ParseTree> {
  let at = port_locus(port: parse_stage_locus_port)
  match parse_expr(expr: production.expression, tokens: tokens, root: root, measure: grammar_fuel(root: root), visited: []) {
    ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags } =>
      if is_empty(xs: remaining) {
        Accepted {
          value: Node {
            kind: TypeNode { connective: Conj },
            children: [
              grammar_named_edge(name: grammar_production_identity_node_projection, target: production.emitted),
              grammar_named_edge(name: grammar_production_captured_node_projection, target: captured)
            ]
          },
          diagnostics: parse_diags_to_diagnostics(diags: diags)
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
      }
    ParseExprRejected { diagnostics: diags } =>
      Rejected {
        diagnostics: parse_diags_to_non_empty(
          diags: diags,
          default: parse_e1_syntax_error_diagnostic(at: at)
        )
      }
  }
}


fn parse(tokens: TokenStream, grammar: Grammar) -> Outcome<ParseTree> {
  let at = port_locus(port: parse_stage_locus_port)
  let ntok = length(xs: tokens.tokens)
  let grammar_node = grammar_to_node(grammar: grammar)
  if !well_formed(n: grammar_node) {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_not_well_formed_diagnostic(at: at)) }
  } else {
    match grammar {
      VoidGrammar =>
        if ntok == 0 {
          Accepted { value: grammar_node, diagnostics: None }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
        }
      ModeledGrammar { root: root } =>
        if grammar_has_undefined_nonterminals(root: root) {
          Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_undefined_nonterminal_diagnostic(at: at)) }
        } else {
          if grammar_has_duplicate_productions(root: root) {
            Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_duplicate_production_diagnostic(at: at)) }
          } else {
            if grammar_has_left_recursion(root: root) {
              Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_left_recursive_diagnostic(at: at)) }
            } else {
              match grammar_lookup_production(root: root, name: root.start) {
                GrammarProductionFound { production: start } =>
                  parse_production(tokens: tokens.tokens, root: root, production: start)
                // 🟡 gated T-8: structurally unreachable — grammar_has_undefined_nonterminals above
                // validates root.start; GrammarProductionMissing here is dead by construction.
                // Kept for exhaustiveness; dissolve-on: T-8 or substrate-level totality proof.
                GrammarProductionMissing =>
                  Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_undefined_nonterminal_diagnostic(at: at)) }
              }
            }
          }
        }
    }
  }
}
