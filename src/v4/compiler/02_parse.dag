// src/v4/compiler/02_parse.dag
// Scope: generic parsing over language grammar rules.
// Anchor: https://en.wikipedia.org/wiki/Parsing
// Owns: Grammar type hierarchy (GrammarExpr/GrammarProduction/GrammarRoot), ParseTree, parse walk, Node projection functions, grammar_carries_symbol.
// Consumes: std diagnostic, std node, compiler tokenize.
// Status: Wave-1 void-grammar path realized; syntactic grammar data is typed, Node is projection only.


module v4.compiler.parse


import v4.compiler.tokenize { Token, TokenStream }
import v4.std.diagnostic {Correction, Diagnostic, ExternalContractUnknown, Locus, Outcome, port_locus, UserInputBoundary, Accepted, None, diagnostics_singleton}
import v4.std.node { Atom, Conj, Edge, Named, Node, NodeFold, Symbol, TypeNode, fold_node, well_formed }
import v4.std.collection { List }
import v4.std.algebra { Empty, fold_list, is_empty, length, list_snoc_item }


// 🟡 gated — feature:CP-1b-bidirectional-grammar-carrier — bind TASKS.md T-6/T-7 — dissolve-on: GrammarExpr converges with LexPattern on single declarative bidirectional grammar model; forbidden: parallel production algebras without explicit structural justification.
type GrammarExpr
  = Terminal { token_class: Symbol }
  | Nonterminal { production: Symbol }
  | Sequence { left: GrammarExpr, right: GrammarExpr }
  | Choice { left: GrammarExpr, right: GrammarExpr }
  | Optional { element: GrammarExpr }
  | Repeat { element: GrammarExpr }


type GrammarProduction {
  name: Symbol
  expression: GrammarExpr
  emitted: Node
}


type GrammarRoot {
  start: Symbol
  productions: List<GrammarProduction>
}


// 🟡 gated — feature:CP-1b-bidirectional-grammar-carrier — bind TASKS.md T-6/T-7 — dissolve-on: Grammar converges with LexPattern on single declarative bidirectional grammar model; forbidden: parallel production algebras without explicit structural justification.
type Grammar
  = VoidGrammar
  | ModeledGrammar { root: GrammarRoot }


type ParseTree = Node

// 🟡 coproduct dissolution — feature:T-7-parse-walk-realization; bound task: src/v4/TASKS.md#t-7-compiler02_parsedag; follow-up: dissolve when parse_expr recursive walk lands with termination/ambiguity certificate (see parse_expr gate at line 298).
type ParseExprResult
  = ParseExprAccepted { remaining: List<Token> }
  | ParseExprRejected


// 🟡 coproduct dissolution — feature:T-7-parse-walk-realization; bound task: src/v4/TASKS.md#t-7-compiler02_parsedag; follow-up: dissolve when production lookup is indexed at parse-walk realization instead of linear fold over GrammarRoot.productions.
type GrammarProductionLookup
  = GrammarProductionFound { production: GrammarProduction }
  | GrammarProductionMissing


type GrammarSymbolFoldState {
  found: Bool
}


data grammar_terminal_token_class_node_projection: Symbol = grammar_terminal_token_class_node_projection
data grammar_nonterminal_production_node_projection: Symbol = grammar_nonterminal_production_node_projection
data grammar_sequence_left_node_projection: Symbol = grammar_sequence_left_node_projection
data grammar_sequence_right_node_projection: Symbol = grammar_sequence_right_node_projection
data grammar_choice_left_node_projection: Symbol = grammar_choice_left_node_projection
data grammar_choice_right_node_projection: Symbol = grammar_choice_right_node_projection
data grammar_optional_element_node_projection: Symbol = grammar_optional_element_node_projection
data grammar_repeat_element_node_projection: Symbol = grammar_repeat_element_node_projection
data grammar_production_name_node_projection: Symbol = grammar_production_name_node_projection
data grammar_production_expression_node_projection: Symbol = grammar_production_expression_node_projection
data grammar_production_emitted_node_projection: Symbol = grammar_production_emitted_node_projection
data grammar_root_start_production_node_projection: Symbol = grammar_root_start_production_node_projection
data grammar_root_productions_node_projection: Symbol = grammar_root_productions_node_projection

data parse_stage_locus_port: Symbol = parse_stage_locus_port

data parse_walk_not_realized: Symbol = parse_walk_not_realized

data parse_grammar_not_well_formed: Symbol = parse_grammar_not_well_formed

data parse_g0_tokens_remain: Symbol = parse_g0_tokens_remain


fn parse_walk_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_walk_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_grammar_not_well_formed_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_grammar_not_well_formed,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_g0_tokens_remain_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_g0_tokens_remain,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn grammar_atom(identity: Symbol) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: identity }
    },
    children: []
  }
}


fn grammar_named_edge(name: Symbol, target: Node) -> Edge {
  Edge {
    label: Named { name: name },
    target: target
  }
}


fn grammar_empty_node() -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: []
  }
}


fn grammar_expr_to_node(expr: GrammarExpr) -> Node {
  match expr {
    Terminal { token_class: token_class } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_terminal_token_class_node_projection, target: grammar_atom(identity: token_class))
        ]
      }
    Nonterminal { production: production } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_nonterminal_production_node_projection, target: grammar_atom(identity: production))
        ]
      }
    Sequence { left: left, right: right } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_sequence_left_node_projection, target: grammar_expr_to_node(expr: left)),
          grammar_named_edge(name: grammar_sequence_right_node_projection, target: grammar_expr_to_node(expr: right))
        ]
      }
    Choice { left: left, right: right } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_choice_left_node_projection, target: grammar_expr_to_node(expr: left)),
          grammar_named_edge(name: grammar_choice_right_node_projection, target: grammar_expr_to_node(expr: right))
        ]
      }
    Optional { element: element } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_optional_element_node_projection, target: grammar_expr_to_node(expr: element))
        ]
      }
    Repeat { element: element } =>
      Node {
        kind: TypeNode {
          connective: Conj
        },
        children: [
          grammar_named_edge(name: grammar_repeat_element_node_projection, target: grammar_expr_to_node(expr: element))
        ]
      }
  }
}


fn grammar_production_to_node(production: GrammarProduction) -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: [
      grammar_named_edge(name: grammar_production_name_node_projection, target: grammar_atom(identity: production.name)),
      grammar_named_edge(name: grammar_production_expression_node_projection, target: grammar_expr_to_node(expr: production.expression)),
      grammar_named_edge(name: grammar_production_emitted_node_projection, target: production.emitted)
    ]
  }
}


fn grammar_production_to_list_step(acc: List<Edge>, production: GrammarProduction) -> List<Edge> {
  list_snoc_item(
    xs: acc,
    item: grammar_named_edge(
      name: production.name,
      target: grammar_production_to_node(production: production)
    )
  )
}


fn grammar_productions_to_node(productions: List<GrammarProduction>) -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: fold_list(
      xs: productions,
      empty: Empty,
      cons: fn(acc, production) {
        grammar_production_to_list_step(acc: acc, production: production)
      }
    )
  }
}


fn grammar_root_to_node(root: GrammarRoot) -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: [
      grammar_named_edge(name: grammar_root_start_production_node_projection, target: grammar_atom(identity: root.start)),
      grammar_named_edge(name: grammar_root_productions_node_projection, target: grammar_productions_to_node(productions: root.productions))
    ]
  }
}


fn grammar_to_node(grammar: Grammar) -> Node {
  match grammar {
    VoidGrammar => grammar_empty_node()
    ModeledGrammar { root: root } => grammar_root_to_node(root: root)
  }
}


fn grammar_carries_symbol(grammar: Grammar, sym: Symbol) -> Bool {
  let folded = fold_node(
    n: grammar_to_node(grammar: grammar),
    algebra: NodeFold {
      init: fn(n0) {
        match n0.kind {
          TypeNode { connective: Atom { identity: id } } =>
            GrammarSymbolFoldState { found: id == sym }
          _ =>
            GrammarSymbolFoldState { found: false }
        }
      },
      step: fn(acc, _, child_has_symbol) {
        GrammarSymbolFoldState { found: acc.found || child_has_symbol.found }
      }
    }
  )
  folded.found
}


fn grammar_lookup_production_step(
  acc: GrammarProductionLookup,
  production: GrammarProduction,
  name: Symbol
) -> GrammarProductionLookup {
  match acc {
    GrammarProductionFound { production: _ } => acc
    GrammarProductionMissing =>
      if production.name == name {
        GrammarProductionFound { production: production }
      } else {
        acc
      }
  }
}


fn grammar_lookup_production(root: GrammarRoot, name: Symbol) -> GrammarProductionLookup {
  fold_list(
    xs: root.productions,
    empty: GrammarProductionMissing,
    cons: fn(acc, production) {
      grammar_lookup_production_step(acc: acc, production: production, name: name)
    }
  )
}


fn parse_expr(expr: GrammarExpr, tokens: List<Token>, root: GrammarRoot) -> ParseExprResult {
  // 🟡 gated — feature:T-7-parse-walk-realization — bind TASKS.md T-7 — dissolve-on: T-8/T-9 normalize/resolve integrates parse_expr into pipeline fold; bootstrap lacks fold-on-demand token consumption and termination certificates for recursive descent
  ParseExprRejected
}


fn parse_production(tokens: List<Token>, root: GrammarRoot, production: GrammarProduction) -> Outcome<ParseTree> {
  let at = port_locus(port: parse_stage_locus_port)
  match parse_expr(expr: production.expression, tokens: tokens, root: root) {
    ParseExprAccepted { remaining: remaining } =>
      if is_empty(xs: remaining) {
        Accepted { value: production.emitted, diagnostics: None }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
      }
    ParseExprRejected =>
      Rejected { diagnostics: diagnostics_singleton(d: parse_walk_not_realized_diagnostic(at: at)) }
  }
}


fn parse(tokens: TokenStream, grammar: Grammar) -> Outcome<ParseTree> {
  let at = port_locus(port: parse_stage_locus_port)
  let ntok = length(xs: tokens.tokens)
  let grammar_node = grammar_to_node(grammar: grammar)
  if !well_formed(n: grammar_node) {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_not_well_formed_diagnostic(at: at)) }
  } else {
    match grammar {
      VoidGrammar =>
        if ntok == 0 {
          Accepted { value: grammar_node, diagnostics: None }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
        }
      ModeledGrammar { root: root } =>
        match grammar_lookup_production(root: root, name: root.start) {
          GrammarProductionFound { production: start } =>
            parse_production(tokens: tokens.tokens, root: root, production: start)
          GrammarProductionMissing =>
            Rejected { diagnostics: diagnostics_singleton(d: parse_walk_not_realized_diagnostic(at: at)) }
        }
    }
  }
}
