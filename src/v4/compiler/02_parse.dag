// 🟡 coproduct dissolution — feature:T-8-parse-result-projection; per-expression walk result; dissolves when parse-walk result carrier unifies with Outcome<ParseTree> via T-8 projection (remaining/captured consolidates; List<Diagnostic> accumulator lifts into standard Diagnostics).
type ParseExprResult
  = ParseExprAccepted { remaining: List<Token>, captured: Node, diagnostics: List<Diagnostic> }
  | ParseExprRejected { diagnostics: List<Diagnostic> }

type ParseSyncState {
  found_sync: Bool
  result: List<Token>
}

// 🟡 coproduct dissolution — feature: GrammarRoot duplicate-name scan accumulator — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived membership fold over production names eliminates the hand-written accumulator; invalid-state-representable Bool flag dissolved into coproduct branches.
type GrammarDupCheckResult
  = GrammarDupCheckUnique { seen: Set<Symbol> }
  | GrammarDupCheckDuplicate

// 🟡 coproduct dissolution — feature: FreeMonoid substrate first<T> accessor; dissolves when stdlib provides a substrate-derived head projection that returns Option<T> directly, eliminating the per-use carrier type.
type TokenPeek
  = TokenPeekAbsent
  | TokenPeekFirst { value: Token }

// Accumulator for the fold-list based Repeat implementation in parse_expr.
// fold_list over the token stream bounds iterations to length(tokens);
// done: true short-circuits remaining steps.
type ParseRepeatAcc {
  remaining: List<Token>
  acc_nodes: List<Node>
  acc_diags: List<Diagnostic>
  done: Bool
}

// Memo key for parse table: token offset × production name.
type ParsePositionKey {
  position: Int
  production: Symbol
}

// Memoized (position, production) → parse_expr result for production.expression at that offset.
type ParseTable = Map<ParsePositionKey, ParseExprResult>

type TokensAtPositionAcc {
  skipped: Int
  target: Int
  current: List<Token>
}


data grammar_production_identity_node_projection: Symbol = grammar_production_identity_node_projection
data grammar_production_captured_node_projection: Symbol = grammar_production_captured_node_projection

data parse_stage_locus_port: Symbol = parse_stage_locus_port

data parse_grammar_not_well_formed: Symbol = parse_grammar_not_well_formed

data parse_g0_tokens_remain: Symbol = parse_g0_tokens_remain

data parse_grammar_left_recursive: Symbol = parse_grammar_left_recursive

data parse_grammar_undefined_nonterminal: Symbol = parse_grammar_undefined_nonterminal

data parse_grammar_duplicate_production: Symbol = parse_grammar_duplicate_production

data parse_e1_syntax_error: Symbol = parse_e1_syntax_error


fn parse_grammar_not_well_formed_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_grammar_not_well_formed,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_g0_tokens_remain_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_g0_tokens_remain,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn parse_grammar_left_recursive_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_grammar_left_recursive,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_grammar_undefined_nonterminal_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_grammar_undefined_nonterminal,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_grammar_duplicate_production_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_grammar_duplicate_production,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_e1_syntax_error_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_e1_syntax_error,
    at: at,
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn grammar_lookup_production_step(
  acc: Witness<GrammarProduction>,
  production: GrammarProduction,
  name: Symbol
) -> Witness<GrammarProduction> {
  match acc {
    Holds { value: _ } => acc
    Violates { diagnostic: _ } =>
      if production.name == name {
        Holds { value: production }
      } else {
        acc
      }
  }
}


fn grammar_lookup_production(root: GrammarRoot, name: Symbol) -> Witness<GrammarProduction> {
  fold_list(
    xs: root.productions,
    empty: Violates {
      diagnostic: parse_grammar_undefined_nonterminal_diagnostic(
        at: port_locus(port: parse_stage_locus_port)
      )
    },
    cons: fn(acc, production) {
      grammar_lookup_production_step(acc: acc, production: production, name: name)
    }
  )
}


// --- Parse table (memoized position × production) ---

// Map<K,V> uses structural == on K; ParsePositionKey { position: Int, production: Symbol } is a valid composite key.
fn parse_table_lookup(table: ParseTable, key: ParsePositionKey) -> Witness<ParseExprResult> {
  table.lookup(key)
}

fn parse_table_insert(table: ParseTable, key: ParsePositionKey, value: ParseExprResult) -> ParseTable {
  map_insert(m: table, key: key, value: value)
}

fn parse_current_position(all_tokens: List<Token>, tokens: List<Token>) -> Int {
  length(xs: all_tokens) - length(xs: tokens)
}

fn tokens_at_position(all_tokens: List<Token>, position: Int) -> List<Token> {
  fold_list(
    xs: all_tokens,
    empty: TokensAtPositionAcc { skipped: 0, target: position, current: all_tokens },
    cons: fn(acc, _) {
      match acc.skipped < acc.target {
        true =>
          match list_tail(xs: acc.current) {
            TailFound { tail: t } => TokensAtPositionAcc {
              skipped: acc.skipped + 1,
              target: acc.target,
              current: t
            }
            TailAbsent => acc
          }
        false => acc
      }
    }
  ).current
}

// Positions 0..N inclusive for a token stream of length N (N+1 suffixes).
fn token_position_indices(tokens: List<Token>) -> List<Int> {
  match is_empty(xs: tokens) {
    true => Cons { head: 0, tail: Empty }
    false =>
      fold_list(
        xs: tokens,
        empty: Cons { head: 0, tail: Empty },
        cons: fn(acc, _) {
          list_snoc_item(xs: acc, item: length(xs: acc))
        }
      )
  }
}

fn parse_node_span_from_token(tok: Token) -> Outcome<NodeSpan> {
  make_node_span_anchored(file: tok.file, start: tok.start, end: tok.end)
}

fn parse_merge_captured_spans(left: Node, right: Node) -> Outcome<NodeSpan> {
  merge_node_spans(left: left.span, right: right.span)
}

fn parse_non_empty_diagnostics_to_list(ned: NonEmptyDiagnostics) -> List<Diagnostic> {
  list_append(left: [ned.head], right: ned.tail)
}

fn parse_fold_node_span_step(acc: Outcome<NodeSpan>, n: Node) -> Outcome<NodeSpan> {
  match acc {
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
    Accepted { value: current, diagnostics: pending } =>
      match merge_node_spans(left: current, right: n.span) {
        Rejected { diagnostics: r } =>
          Rejected { diagnostics: rejected_with_pending(pending: pending, rejected: r) }
        Accepted { value: merged, diagnostics: d } =>
          Accepted {
            value: merged,
            diagnostics: diagnostics_merge(outer: pending, inner: d)
          }
      }
  }
}

fn parse_fold_node_spans(nodes: List<Node>, acc: NodeSpan) -> Outcome<NodeSpan> {
  fold_list(xs: nodes, empty: outcome_accepted(value: acc), cons: parse_fold_node_span_step)
}

fn parse_wrap_production_captured(production: GrammarProduction, captured: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      grammar_named_edge(name: grammar_production_identity_node_projection, target: production.emitted),
      grammar_named_edge(name: grammar_production_captured_node_projection, target: captured)
    ],
    span: captured.span
  }
}

fn parse_nonterminal_from_table(
  table: ParseTable,
  all_tokens: List<Token>,
  tokens: List<Token>,
  root: GrammarRoot,
  prod_name: Symbol
) -> ParseExprResult {
  match grammar_lookup_production(root: root, name: prod_name) {
    Violates { diagnostic: d } =>
      ParseExprRejected { diagnostics: [d] }
    Holds { value: production } =>
      let key = ParsePositionKey {
        position: parse_current_position(all_tokens: all_tokens, tokens: tokens),
        production: prod_name
      }
      match parse_table_lookup(table: table, key: key) {
        Holds { value: inner } =>
          match inner {
            ParseExprRejected { diagnostics: diags } =>
              ParseExprRejected { diagnostics: diags }
            ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags } =>
              ParseExprAccepted {
                remaining: remaining,
                captured: parse_wrap_production_captured(production: production, captured: captured),
                diagnostics: diags
              }
          }
        Violates { diagnostic: d } =>
          ParseExprRejected { diagnostics: [d] }
      }
  }
}


// --- Left-recursion detection ---

// set_symbol_insert: functional set extension — new set tests item first, then delegates.
fn set_symbol_insert(s: Set<Symbol>, item: Symbol) -> Set<Symbol> {
  Set {
    member: fn(sym) { sym == item || s.member(sym) }
  }
}


// 🟢 substrate catamorphism consumer — feature: GrammarExpr structural morphism substrate —
// bind node://adhoc-b696538c-710 — first consumer of v4.std.grammar.fold_grammar_expr: the
// nullable query is now expressed as a GrammarExprFold algebra over Bool rather than a hand-written
// per-variant recursion. The structural recursion lives once in fold_grammar_expr; this function
// supplies only the per-variant combine.
// expr_is_nullable_given_set: true iff expr can match empty input given a pre-computed nullable set.
// Nonterminal arms consult nullable_set rather than following production references.
fn expr_is_nullable_given_set(expr: GrammarExpr, nullable_set: Set<Symbol>) -> Bool {
  fold_grammar_expr(
    expr: expr,
    algebra: GrammarExprFold {
      terminal: fn(_) { false },
      nonterminal: fn(name) { nullable_set.member(name) },
      sequence: fn(left_nullable, right_nullable) { left_nullable && right_nullable },
      choice: fn(left_nullable, right_nullable) { left_nullable || right_nullable },
      optional: fn(_) { true },
      repeat: fn(_) { true }
    }
  )
}


fn compute_nullable_step(ns: Set<Symbol>, p: GrammarProduction) -> Set<Symbol> {
  if expr_is_nullable_given_set(expr: p.expression, nullable_set: ns) {
    set_symbol_insert(s: ns, item: p.name)
  } else {
    ns
  }
}


// compute_nullable_set: fixpoint over productions.
// Outer fold iterates |productions| times (convergence bound); inner fold adds nullable productions.
fn compute_nullable_set(root: GrammarRoot) -> Set<Symbol> {
  fold_list(
    xs: root.productions,
    empty: Set { member: fn(_) { false } },
    cons: fn(acc, _) {
      fold_list(
        xs: root.productions,
        empty: acc,
        cons: fn(ns, p) {
          compute_nullable_step(ns: ns, p: p)
        }
      )
    }
  )
}


// v2 bootstrap compiler workaround: Empty literal has unknown element type in if/else context;
// a typed wrapper anchors the type to List<Symbol> so branch unification succeeds.
fn grammar_empty_corner_list() -> List<Symbol> {
  Empty
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarExpr left-corner query substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived left-corner reachability morphism over GrammarExpr coproduct; forbidden: duplicating left-corner logic or inlining nullable check outside this function.
// expr_direct_left_corner_list: direct (non-transitive) left-corner nonterminals of expr.
// Structurally recursive on GrammarExpr (finite tree) — no fuel needed.
// Sequence: when left is nullable, both left and right contribute left corners.
// Note: Sequence arm uses list_append with the nullable-conditional inside right: to avoid
// a top-level if/else type-unification failure in the v2 bootstrap compiler.
fn expr_direct_left_corner_list(expr: GrammarExpr, nullable_set: Set<Symbol>) -> List<Symbol> {
  match expr {
    Terminal { token_class: _ } => Empty
    Nonterminal { production: name } => Cons { head: name, tail: Empty }
    Sequence { left: left, right: right } =>
      list_append(
        left: expr_direct_left_corner_list(expr: left, nullable_set: nullable_set),
        right: if expr_is_nullable_given_set(expr: left, nullable_set: nullable_set) {
          expr_direct_left_corner_list(expr: right, nullable_set: nullable_set)
        } else {
          grammar_empty_corner_list()
        }
      )
    Choice { left: left, right: right } =>
      list_append(
        left: expr_direct_left_corner_list(expr: left, nullable_set: nullable_set),
        right: expr_direct_left_corner_list(expr: right, nullable_set: nullable_set)
      )
    Optional { element: element } =>
      expr_direct_left_corner_list(expr: element, nullable_set: nullable_set)
    Repeat { element: element } =>
      expr_direct_left_corner_list(expr: element, nullable_set: nullable_set)
  }
}


// compute_left_corner_closure: transitive closure of left-corner reachability from start symbols.
// Outer fold iterates |productions| times (convergence bound).
// Inner fold expands each reachable symbol by its production's direct left corners.
fn compute_left_corner_closure(
  start: List<Symbol>,
  nullable_set: Set<Symbol>,
  root: GrammarRoot
) -> List<Symbol> {
  fold_list(
    xs: root.productions,
    empty: start,
    cons: fn(reachable, _) {
      fold_list(
        xs: reachable,
        empty: reachable,
        cons: fn(acc, sym) {
          match grammar_lookup_production(root: root, name: sym) {
            Violates { diagnostic: _ } => acc
            Holds { value: prod } =>
              fold_list(
                xs: expr_direct_left_corner_list(expr: prod.expression, nullable_set: nullable_set),
                empty: acc,
                cons: fn(r, name) {
                  if contains(xs: r, item: name, eq: fn(a, b) { a == b }) {
                    r
                  } else {
                    list_snoc_item(xs: r, item: name)
                  }
                }
              )
          }
        }
      )
    }
  )
}


fn grammar_has_left_recursion_step(acc: Bool, p: GrammarProduction, root: GrammarRoot, nullable_set: Set<Symbol>) -> Bool {
  acc ||
  contains(
    xs: compute_left_corner_closure(
      start: expr_direct_left_corner_list(expr: p.expression, nullable_set: nullable_set),
      nullable_set: nullable_set,
      root: root
    ),
    item: p.name,
    eq: fn(a, b) { a == b }
  )
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarRoot left-recursion validator substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived left-recursion reachability morphism over GrammarRoot productions; forbidden: duplicating left-recursion check logic outside this function.
fn grammar_has_left_recursion(root: GrammarRoot) -> Bool {
  let nullable_set = compute_nullable_set(root: root)
  fold_list(
    xs: root.productions,
    empty: false,
    cons: fn(acc, p) { grammar_has_left_recursion_step(acc: acc, p: p, root: root, nullable_set: nullable_set) }
  )
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarExpr production-reference closure query substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived undefined-nonterminal query morphism over GrammarExpr coproduct; forbidden: duplicating reference-closure logic outside this function.
// Structural recursion on GrammarExpr (finite tree) — does NOT follow nonterminal
// references into their productions, so it always terminates without a visited set.
fn expr_has_undefined_nonterminal(expr: GrammarExpr, root: GrammarRoot) -> Bool {
  match expr {
    Terminal { token_class: _ } => false
    Nonterminal { production: p } =>
      match grammar_lookup_production(root: root, name: p) {
        Violates { diagnostic: _ } => true
        Holds { value: _ } => false
      }
    Sequence { left: left, right: right } =>
      expr_has_undefined_nonterminal(expr: left, root: root) ||
      expr_has_undefined_nonterminal(expr: right, root: root)
    Choice { left: left, right: right } =>
      expr_has_undefined_nonterminal(expr: left, root: root) ||
      expr_has_undefined_nonterminal(expr: right, root: root)
    Optional { element: element } =>
      expr_has_undefined_nonterminal(expr: element, root: root)
    Repeat { element: element } =>
      expr_has_undefined_nonterminal(expr: element, root: root)
  }
}


fn grammar_has_undefined_nonterminals_step(acc: Bool, p: GrammarProduction, root: GrammarRoot) -> Bool {
  acc || expr_has_undefined_nonterminal(expr: p.expression, root: root)
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarRoot structure validity query substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived undefined-reference scan morphism over GrammarRoot; forbidden: duplicating undefined-nonterminal check logic outside this function.
fn grammar_has_undefined_nonterminals(root: GrammarRoot) -> Bool {
  match grammar_lookup_production(root: root, name: root.start) {
    Violates { diagnostic: _ } => true
    Holds { value: _ } =>
      fold_list(
        xs: root.productions,
        empty: false,
        cons: fn(acc, p) { grammar_has_undefined_nonterminals_step(acc: acc, p: p, root: root) }
      )
  }
}


fn grammar_dup_check_step(acc: GrammarDupCheckResult, p: GrammarProduction) -> GrammarDupCheckResult {
  match acc {
    GrammarDupCheckDuplicate => GrammarDupCheckDuplicate
    GrammarDupCheckUnique { seen: seen } =>
      if seen.member(p.name) {
        GrammarDupCheckDuplicate
      } else {
        GrammarDupCheckUnique { seen: set_symbol_insert(s: seen, item: p.name) }
      }
  }
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarRoot structure validity query substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived duplicate-name scan morphism over GrammarRoot productions; forbidden: duplicating duplicate-check logic outside this function.
fn grammar_has_duplicate_productions(root: GrammarRoot) -> Bool {
  match fold_list(
    xs: root.productions,
    empty: GrammarDupCheckUnique { seen: Set { member: fn(_) { false } } },
    cons: fn(acc, p) { grammar_dup_check_step(acc: acc, p: p) }
  ) {
    GrammarDupCheckDuplicate => true
    GrammarDupCheckUnique { seen: _ } => false
  }
}


fn grammar_validate_for_parse(root: GrammarRoot, at: Locus) -> Outcome<ValidatedGrammarRoot> {
  if grammar_has_undefined_nonterminals(root: root) {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_undefined_nonterminal_diagnostic(at: at)) }
  } else {
    if grammar_has_duplicate_productions(root: root) {
      Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_duplicate_production_diagnostic(at: at)) }
    } else {
      if grammar_has_left_recursion(root: root) {
        Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_left_recursive_diagnostic(at: at)) }
      } else {
        Accepted { value: ValidatedGrammarRoot { root: root }, diagnostics: None }
      }
    }
  }
}


// --- Diagnostic list helpers ---

fn parse_diag_cons(d: Diagnostic, acc: Diagnostics) -> Diagnostics {
  match acc {
    None => Some { diagnostics: NonEmptyDiagnostics { head: d, tail: [] } }
    Some { diagnostics: ned } =>
      Some {
        diagnostics: NonEmptyDiagnostics {
          head: d,
          tail: list_append(left: [ned.head], right: ned.tail)
        }
      }
  }
}


fn parse_diags_to_diagnostics(diags: List<Diagnostic>) -> Diagnostics {
  fold_list_right(xs: diags, empty: None, snoc: fn(acc, d) { parse_diag_cons(d: d, acc: acc) })
}


fn parse_diags_to_non_empty(diags: List<Diagnostic>, default: Diagnostic) -> NonEmptyDiagnostics {
  match parse_diags_to_diagnostics(diags: diags) {
    None => NonEmptyDiagnostics { head: default, tail: [] }
    Some { diagnostics: ned } => ned
  }
}


// --- Parse walk helpers ---

fn parse_repeat_captured_node(acc_nodes: List<Node>, span: NodeSpan) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: acc_nodes,
      empty: Empty,
      cons: fn(acc, n) {
        list_snoc_item(
          xs: acc,
          item: Edge {
            label: Named { name: ^grammar_repeat_element_node_projection },
            target: n
          }
        )
      }
    ),
    span: span
  }
}


// Skip tokens until a sync token is found (inclusive — returns stream starting at sync token).
fn parse_sync_step(acc: ParseSyncState, tok: Token, sync_tokens: Set<Symbol>) -> ParseSyncState {
  match acc.found_sync {
    true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: acc.result, item: tok) }
    false =>
      match sync_tokens.member(tok.class) {
        true => ParseSyncState { found_sync: true, result: list_snoc_item(xs: Empty, item: tok) }
        false => ParseSyncState { found_sync: false, result: Empty }
      }
  }
}


fn parse_skip_to_sync(tokens: List<Token>, sync_tokens: Set<Symbol>) -> ParseSyncState {
  fold_list(
    xs: tokens,
    empty: ParseSyncState { found_sync: false, result: Empty },
    cons: fn(acc, tok) { parse_sync_step(acc: acc, tok: tok, sync_tokens: sync_tokens) }
  )
}


fn parse_token_first(tokens: List<Token>) -> TokenPeek {
  fold_list_right(xs: tokens, empty: TokenPeekAbsent, snoc: fn(_acc, tok) { TokenPeekFirst { value: tok } })
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: GrammarExpr structural morphism substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived recursive-descent parse morphism over GrammarExpr coproduct (per-variant fold eliminating hand-written match arms); forbidden: duplicating parse walk logic or adding new GrammarExpr arms outside this function.
// parse_expr: recursive-descent parse walk.
// Nonterminal arm: O(1) ParseTable lookup (built by build_parse_table) — no measure: Nat.
// Left-recursive grammars are rejected by grammar_has_left_recursion before parse runs.
fn parse_expr(
  expr: GrammarExpr,
  tokens: List<Token>,
  all_tokens: List<Token>,
  root: GrammarRoot,
  table: ParseTable
) -> ParseExprResult {
  match expr {
    Terminal { token_class: class } =>
      match parse_token_first(tokens: tokens) {
        TokenPeekAbsent => ParseExprRejected { diagnostics: [] }
        TokenPeekFirst { value: tok } =>
          match tok.class == class {
            true =>
              match list_tail(xs: tokens) {
                TailFound { tail: remaining } =>
                  match parse_node_span_from_token(tok: tok) {
                    Rejected { diagnostics: r } =>
                      ParseExprRejected {
                        diagnostics: parse_non_empty_diagnostics_to_list(ned: r)
                      }
                    Accepted { value: span, diagnostics: _ } =>
                      ParseExprAccepted {
                        remaining: remaining,
                        captured: Node {
                          kind: TypeNode { connective: Atom { identity: tok.class } },
                          children: [],
                          span: span
                        },
                        diagnostics: []
                      }
                  }
                TailAbsent => ParseExprRejected { diagnostics: [] }
              }
            false => ParseExprRejected { diagnostics: [] }
          }
      }
    Nonterminal { production: prod_name } =>
      parse_nonterminal_from_table(
        table: table,
        all_tokens: all_tokens,
        tokens: tokens,
        root: root,
        prod_name: prod_name
      )
    Sequence { left: left, right: right } =>
      match parse_expr(expr: left, tokens: tokens, all_tokens: all_tokens, root: root, table: table) {
        ParseExprRejected { diagnostics: diags } =>
          ParseExprRejected { diagnostics: diags }
        ParseExprAccepted { remaining: rest1, captured: cap1, diagnostics: diags1 } =>
          match parse_expr(expr: right, tokens: rest1, all_tokens: all_tokens, root: root, table: table) {
            ParseExprRejected { diagnostics: diags2 } =>
              ParseExprRejected { diagnostics: list_append(left: diags1, right: diags2) }
            ParseExprAccepted { remaining: rest2, captured: cap2, diagnostics: diags2 } =>
              match parse_merge_captured_spans(left: cap1, right: cap2) {
                Rejected { diagnostics: r } =>
                  ParseExprRejected {
                    diagnostics: list_append(
                      left: list_append(left: diags1, right: diags2),
                      right: parse_non_empty_diagnostics_to_list(ned: r)
                    )
                  }
                Accepted { value: span, diagnostics: _ } =>
                  ParseExprAccepted {
                    remaining: rest2,
                    captured: Node {
                      kind: TypeNode { connective: Conj },
                      children: [
                        grammar_named_edge(name: ^grammar_sequence_left_node_projection, target: cap1),
                        grammar_named_edge(name: ^grammar_sequence_right_node_projection, target: cap2)
                      ],
                      span: span
                    },
                    diagnostics: list_append(left: diags1, right: diags2)
                  }
              }
          }
      }
    Choice { left: left, right: right } =>
      match parse_expr(expr: left, tokens: tokens, all_tokens: all_tokens, root: root, table: table) {
        ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags } =>
          ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags }
        ParseExprRejected { diagnostics: _ } =>
          parse_expr(expr: right, tokens: tokens, all_tokens: all_tokens, root: root, table: table)
      }
    Optional { element: element } =>
      match parse_expr(expr: element, tokens: tokens, all_tokens: all_tokens, root: root, table: table) {
        ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags } =>
          ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags }
        ParseExprRejected { diagnostics: _ } =>
          ParseExprAccepted {
            remaining: tokens,
            captured: grammar_empty_node(),
            diagnostics: []
          }
      }
    Repeat { element: element } =>
      // fold_list bounds iterations to length(tokens); done: true short-circuits remaining steps.
      // Each consuming iteration reduces acc.remaining; zero-progress or rejection sets done: true.
      let init = ParseRepeatAcc { remaining: tokens, acc_nodes: [], acc_diags: [], done: false }
      let result = fold_list(
        xs: tokens,
        empty: init,
        cons: fn(acc, _) {
          match acc.done {
            true => acc
            false =>
              match parse_expr(expr: element, tokens: acc.remaining, all_tokens: all_tokens, root: root, table: table) {
                ParseExprRejected { diagnostics: _ } =>
                  ParseRepeatAcc {
                    remaining: acc.remaining,
                    acc_nodes: acc.acc_nodes,
                    acc_diags: acc.acc_diags,
                    done: true
                  }
                ParseExprAccepted { remaining: rest, captured: cap, diagnostics: diags } =>
                  match length(xs: rest) != length(xs: acc.remaining) {
                    true =>
                      ParseRepeatAcc {
                        remaining: rest,
                        acc_nodes: list_snoc_item(xs: acc.acc_nodes, item: cap),
                        acc_diags: list_append(left: acc.acc_diags, right: diags),
                        done: false
                      }
                    false =>
                      ParseRepeatAcc {
                        remaining: acc.remaining,
                        acc_nodes: acc.acc_nodes,
                        acc_diags: acc.acc_diags,
                        done: true
                      }
                  }
              }
          }
        }
      )
      match parse_fold_node_spans(nodes: result.acc_nodes, acc: Unanchored) {
        Rejected { diagnostics: r } =>
          ParseExprRejected {
            diagnostics: list_append(
              left: result.acc_diags,
              right: parse_non_empty_diagnostics_to_list(ned: r)
            )
          }
        Accepted { value: span, diagnostics: _ } =>
          ParseExprAccepted {
            remaining: result.remaining,
            captured: parse_repeat_captured_node(acc_nodes: result.acc_nodes, span: span),
            diagnostics: result.acc_diags
          }
      }
  }
}


fn parse_table_fill_production_step(
  table: ParseTable,
  production: GrammarProduction,
  position: Int,
  all_tokens: List<Token>,
  root: GrammarRoot
) -> ParseTable {
  let key = ParsePositionKey { position: position, production: production.name }
  let suffix = tokens_at_position(all_tokens: all_tokens, position: position)
  let result = parse_expr(
    expr: production.expression,
    tokens: suffix,
    all_tokens: all_tokens,
    root: root,
    table: table
  )
  parse_table_insert(table: table, key: key, value: result)
}


// One pass: update every production entry at a fixed position.
fn parse_table_fill_position_pass(
  table: ParseTable,
  position: Int,
  all_tokens: List<Token>,
  root: GrammarRoot
) -> ParseTable {
  fold_list(
    xs: root.productions,
    empty: table,
    cons: fn(acc, prod) {
      parse_table_fill_production_step(
        table: acc,
        production: prod,
        position: position,
        all_tokens: all_tokens,
        root: root
      )
    }
  )
}


// |productions| passes at one position — converges same-position wrapper chains (A = B; B = "x").
fn parse_table_fill_position(
  table: ParseTable,
  position: Int,
  all_tokens: List<Token>,
  root: GrammarRoot
) -> ParseTable {
  fold_list(
    xs: root.productions,
    empty: table,
    cons: fn(acc, _) {
      parse_table_fill_position_pass(
        table: acc,
        position: position,
        all_tokens: all_tokens,
        root: root
      )
    }
  )
}


fn parse_table_empty() -> ParseTable {
  empty_map()
}


// Outer fold over positions high→low; inner fold over productions × passes at each position.
// Termination: (N+1) positions × K productions × K passes — structurally bounded, no fuel.
fn build_parse_table(all_tokens: List<Token>, root: GrammarRoot) -> ParseTable {
  fold_list_right(
    xs: token_position_indices(tokens: all_tokens),
    empty: parse_table_empty(),
    snoc: fn(acc, position) {
      parse_table_fill_position(
        table: acc,
        position: position,
        all_tokens: all_tokens,
        root: root
      )
    }
  )
}


fn parse_production(tokens: List<Token>, validated: ValidatedGrammarRoot, production_name: Symbol) -> Outcome<ParseTree> {
  let root = validated.root
  let at = port_locus(port: parse_stage_locus_port)
  match grammar_lookup_production(root: root, name: production_name) {
    Holds { value: production } =>
      let table = build_parse_table(all_tokens: tokens, root: root)
      let key = ParsePositionKey { position: 0, production: production_name }
      match parse_table_lookup(table: table, key: key) {
        Holds { value: inner } =>
          match inner {
            ParseExprAccepted { remaining: remaining, captured: captured, diagnostics: diags } =>
              if is_empty(xs: remaining) {
                Accepted {
                  value: parse_wrap_production_captured(production: production, captured: captured),
                  diagnostics: parse_diags_to_diagnostics(diags: diags)
                }
              } else {
                Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
              }
            ParseExprRejected { diagnostics: diags } =>
              Rejected {
                diagnostics: parse_diags_to_non_empty(
                  diags: diags,
                  default: parse_e1_syntax_error_diagnostic(at: at)
                )
              }
          }
        Violates { diagnostic: d } =>
          Rejected { diagnostics: diagnostics_singleton(d: d) }
      }
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


fn parse(tokens: TokenStream, grammar: ParseGrammar) -> Outcome<ParseTree> {
  let at = port_locus(port: parse_stage_locus_port)
  let ntok = length(xs: tokens.tokens)
  let grammar_node = grammar_to_node(grammar: grammar)
  if well_formed(n: grammar_node) {
    match grammar {
      VoidGrammar =>
        if ntok == 0 {
          Accepted { value: grammar_node, diagnostics: None }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: parse_g0_tokens_remain_diagnostic(at: at)) }
        }
      ModeledGrammar { root: root } =>
        match grammar_validate_for_parse(root: root, at: at) {
          Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
          Accepted { value: validated, diagnostics: _ } =>
            parse_production(tokens: tokens.tokens, validated: validated, production_name: root.start)
        }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: parse_grammar_not_well_formed_diagnostic(at: at)) }
  }
}
