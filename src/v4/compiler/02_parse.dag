// src/v4/compiler/02_parse.dag
//
// Scope: pipeline stage 2 — TokenStream to ParseTree. Pure function, fail-closed.
// Anchor: https://en.wikipedia.org/wiki/Parsing
//
// B2-OMNI (operator-ratified 2026-05-15): parse is the GENERIC walker over a
// `LanguageModel`'s declarative grammar (`Grammar` as `Node`); `.dag` is
// language #1 at the **data** layer (`extdeps/languages/dag.dag`), never
// special-cased in-body here.
//
// Wave-1 **encoding contract** (mirrors `01_tokenize.dag` E0):
//   **G0 — void syntactic fragment**: `Grammar` root is **type** `Node` with
//   connective **`Conj` + zero children**. With an **empty** `TokenStream`,
//   the parse result is `Produced { value: grammar }` — the grammar root is
//   itself the (degenerate) `ParseTree` spine for the empty sentence (A1:
//   `ParseTree = Node`). Non-empty tokens against G0 ⇒ `Rejected`
//   (tokens unconsumed). Empty tokens against non-G0 grammar ⇒ not realized
//   until additional productions are ratified in data.
//
// PARSE-1 bodiless-`fn` remains a **grammar-data** obligation on the
// LanguageModel file, not a special case in this walker (see header in
// `extdeps/languages/dag.dag`).
//
// Owns:
//   - Grammar, ParseTree (= Node), parse: (TokenStream, Grammar) -> Outcome<ParseTree>
//
// Consumes:
//   - std/node.dag: Node, NodeKind, TypeNode, ComputationNode, Connective,
//     Conj, Symbol, node_well_formed
//   - std/diagnostic.dag: Diagnostic, Outcome, Locus, PortLocus, Correction,
//     NoCorrectionReason
//   - compiler/01_tokenize.dag: TokenStream
//
// Status: Wave-1 — G0 void-grammar + empty tokens path **realized**; else
// honest `Rejected` per encoding coverage.
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.compiler.parse


import v4.compiler.tokenize { TokenStream }
import v4.std.diagnostic {
  Correction,
  Diagnostic,
  Locus,
  NoCorrectionReason,
  Outcome,
  PortLocus,
}
import v4.std.node {
  ComputationNode,
  Conj,
  Connective,
  Node,
  NodeKind,
  Symbol,
  TypeNode,
  node_well_formed,
}


type Grammar = Node


type ParseTree = Node


data parse_stage_locus_port: Symbol = parse_stage_locus_port

data parse_walk_not_realized: Symbol = parse_walk_not_realized

data parse_grammar_not_well_formed: Symbol = parse_grammar_not_well_formed

data parse_g0_tokens_remain: Symbol = parse_g0_tokens_remain


fn parse_walk_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_walk_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_grammar_not_well_formed_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_grammar_not_well_formed,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn parse_g0_tokens_remain_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: parse_g0_tokens_remain,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// ─────────────────────────────────────────────────────────────────────
// grammar_node_is_conj_empty_root — structural G0 predicate (Wave-1).
fn grammar_node_is_conj_empty_root(g: Node) -> Bool {
  match g.kind {
    TypeNode { connective: Conj } => count(g.children) == 0
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}


// ─────────────────────────────────────────────────────────────────────
// parse — GENERIC syntactic ingest (B2-OMNI).
fn parse(tokens: TokenStream, grammar: Grammar) -> Outcome<ParseTree> {
  let at = PortLocus {
    port: parse_stage_locus_port
  }
  let ntok = count(tokens.tokens)
  if !node_well_formed(n: grammar) {
    Rejected {
      diagnostic: parse_grammar_not_well_formed_diagnostic(at: at)
    }
  } else if grammar_node_is_conj_empty_root(g: grammar) {
    if ntok == 0 {
      Produced {
        value: grammar
      }
    } else {
      Rejected {
        diagnostic: parse_g0_tokens_remain_diagnostic(at: at)
      }
    }
  } else if ntok == 0 {
    Rejected {
      diagnostic: parse_walk_not_realized_diagnostic(at: at)
    }
  } else {
    Rejected {
      diagnostic: parse_walk_not_realized_diagnostic(at: at)
    }
  }
}
