// src/v4/compiler/07_target_carriers.dag
// Scope: Shared compile-stage language/source aliases — breaks compile ↔ emit import cycle.
// Status: Wave-5-A — TargetModel authority lives in v4.std.target_model.
// Anchor: docs/design-v4-compiler-homomorphism.md


module v4.compiler.target_carriers


import v4.std.node { Node }
import v4.std.target_model { TargetModel }
import v4.std.text { String }

// 🟡 gated — feature:language-model-carrier — dissolve-on-arrival: replace with a typed
// fact-bundle (P1 no-bare-alias); forbidden: treating this alias as permanent or extending
// consumers before a typed carrier with explicit grounding lands in std/.
type LanguageModel = Node

// Hub route only — TargetModel authority is v4.std.target_model (P2); no local redeclare.

type TargetSource = String
