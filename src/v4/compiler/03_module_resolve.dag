// src/v4/compiler/03_module_resolve.dag
//
// Scope: Stage 3c — ModuleGraph admission for cross-file resolution.
// Owns: ModuleSubject; ModuleAdmission; module_namespace_for_subject; resolve_module_with_admission.
// Consumes: compiler/03_normalize.dag, compiler/03_resolve.dag,
//           extdeps/languages/dag.dag, std/algebra.dag, std/collection.dag,
//           std/diagnostic.dag, std/module_graph.dag, std/node.dag, std/witness.dag.
// Status: T-28-B modeled — graph admission is outside K-1 single-tree resolver.
// Anchor: https://en.wikipedia.org/wiki/Name_resolution_(programming_languages)

module v4.compiler.module_resolve


import v4.compiler.normalize { NormalizedTree }
import v4.compiler.resolve {
  Namespace,
  ResolvedTree,
  build_program_namespace,
  resolve_with_namespace,
  try_edge_declared_binding
}
import v4.extdeps.languages.dag { DagLanguageModel }
import v4.std.algebra { Cons, Empty, FreeMonoid }
import v4.std.collection { Map, empty_map, map_insert }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  port_locus
}
import v4.std.module_graph {
  ModuleGraph,
  module_graph_entry_for_path
}
import v4.std.node {
  Conj,
  Edge,
  Node,
  Symbol,
  TypeNode
}
import v4.std.qualified_name { QualifiedName }
import v4.std.witness { Holds, Violates }


// 🟢 coproduct dissolution — T-28-B admission visibility is a closed alternative: a declared import is either admitted into the subject namespace or rejected as hidden; no third visibility state is modeled.
type ModuleImportVisibility
  = ModuleImportVisible
  | ModuleImportHidden


type ModuleImport {
  target: QualifiedName
  visibility: ModuleImportVisibility
}


type ModuleSubject {
  path: QualifiedName
  tree: NormalizedTree
}


type ModuleAdmission {
  subject: ModuleSubject
  imports: FreeMonoid<ModuleImport>
}


// 🟡 gated — feature:T-28-B-module-admission-state-outcome — internal fold state mirrors Outcome while carrying accepted namespace bindings plus origin facts for ambiguity checks; dissolve-on: generic Outcome fold/traverse can carry the accepted admission accumulator directly without losing the origin map.
type ModuleAdmissionState
  = ModuleAdmissionAccepted {
      bindings: Map<Symbol, Symbol>,
      origins: Map<Symbol, QualifiedName>
    }
  | ModuleAdmissionRejected { diagnostic: Diagnostic }


data module_resolve_import_not_visible: Symbol = module_resolve_import_not_visible
data module_resolve_ambiguous_export: Symbol = module_resolve_ambiguous_export


fn module_resolve_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: port_locus(port: reason),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn module_admission_initial(base: Namespace) -> ModuleAdmissionState {
  ModuleAdmissionAccepted {
    bindings: base.bindings,
    origins: empty_map()
  }
}


fn admit_export_symbol(
  sym: Symbol,
  origin: QualifiedName,
  state: ModuleAdmissionState
) -> ModuleAdmissionState {
  match state {
    ModuleAdmissionRejected { diagnostic: d } =>
      ModuleAdmissionRejected { diagnostic: d }
    ModuleAdmissionAccepted { bindings: b, origins: os } =>
      match map_get(os, sym) {
        Some { value: _ } =>
          ModuleAdmissionRejected {
            diagnostic: module_resolve_diagnostic(reason: module_resolve_ambiguous_export)
          }
        None =>
          ModuleAdmissionAccepted {
            bindings: map_insert(m: b, key: sym, value: sym),
            origins: map_insert(m: os, key: sym, value: origin)
          }
      }
  }
}


fn admit_named_export_edge(
  edge: Edge,
  origin: QualifiedName,
  state: ModuleAdmissionState
) -> ModuleAdmissionState {
  match try_edge_declared_binding(e: edge) {
    Some { value: b } =>
      admit_export_symbol(sym: b.name, origin: origin, state: state)
    None => state
  }
}


fn admit_module_named_exports(
  root: Node,
  origin: QualifiedName,
  state: ModuleAdmissionState
) -> ModuleAdmissionState {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: state, f: fn(acc, e) {
        admit_named_export_edge(edge: e, origin: origin, state: acc)
      })
    _ => state
  }
}


fn admit_import_entry(
  graph: ModuleGraph,
  import_edge: ModuleImport,
  state: ModuleAdmissionState
) -> ModuleAdmissionState {
  match state {
    ModuleAdmissionRejected { diagnostic: d } =>
      ModuleAdmissionRejected { diagnostic: d }
    ModuleAdmissionAccepted { bindings: _, origins: _ } =>
      match import_edge.visibility {
        ModuleImportHidden =>
          ModuleAdmissionRejected {
            diagnostic: module_resolve_diagnostic(reason: module_resolve_import_not_visible)
          }
        ModuleImportVisible =>
          match module_graph_entry_for_path(graph: graph, path: import_edge.target) {
            Holds { value: entry } =>
              admit_module_named_exports(
                root: entry.root,
                origin: import_edge.target,
                state: state
              )
            Violates { diagnostic: d } =>
              ModuleAdmissionRejected { diagnostic: d }
          }
      }
  }
}


fn admit_imports(
  graph: ModuleGraph,
  imports: FreeMonoid<ModuleImport>,
  state: ModuleAdmissionState
) -> ModuleAdmissionState {
  // 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-moduleimport — same v2 bootstrap limitation as std/module_graph.dag's ModuleEntry folds; hand-rolls Empty/Cons accumulation over FreeMonoid<ModuleImport>; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T.
  match imports {
    Empty => state
    Cons { head: import_edge, tail: rest } =>
      admit_imports(
        graph: graph,
        imports: rest,
        state: admit_import_entry(
          graph: graph,
          import_edge: import_edge,
          state: state
        )
      )
  }
}


fn module_namespace_for_subject(
  lm: DagLanguageModel,
  graph: ModuleGraph,
  admission: ModuleAdmission
) -> Outcome<Namespace> {
  let base = build_program_namespace(tree: admission.subject.tree, lm: lm)
  match admit_imports(
    graph: graph,
    imports: admission.imports,
    state: admit_module_named_exports(
      root: admission.subject.tree,
      origin: admission.subject.path,
      state: module_admission_initial(base: base)
    )
  ) {
    ModuleAdmissionAccepted { bindings: b, origins: _ } =>
      Accepted {
        value: Namespace {
          bindings: b,
          canonical_symbols: base.canonical_symbols
        },
        diagnostics: None
      }
    ModuleAdmissionRejected { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


fn resolve_module_with_admission(
  lm: DagLanguageModel,
  graph: ModuleGraph,
  admission: ModuleAdmission
) -> Outcome<ResolvedTree> {
  match module_namespace_for_subject(
    lm: lm,
    graph: graph,
    admission: admission
  ) {
    Accepted { value: namespace, diagnostics: _ } =>
      resolve_with_namespace(tree: admission.subject.tree, namespace: namespace)
    Rejected { diagnostics: r } => Rejected { diagnostics: r }
  }
}
