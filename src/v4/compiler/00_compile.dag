// src/v4/compiler/00_compile.dag
// Scope: B2-OMNI orchestrator — public terminal `validate_then_compile` (P3 commitment 6);
//       internal `compile` over CoreNode + CompileMode; legacy Source staging until ingest lands.
// Owns: CoreNode, LanguageModel, RuntimeTarget, CompileMode, CompileOutput, CompileLens, CompileLensMode,
//       apply_compile_lens, LensGateWitness, Validated, compile_stage_locus_port, compile_pipeline_not_realized,
//       compile_lens_gate_rejected, compile_eval_not_realized, compile_ingest_staging,
//       compile_pipeline_not_realized_diagnostic, compile_lens_gate_rejected_diagnostic,
//       compile_eval_not_realized_diagnostic, apply_compile_lens, run_required_lens_gates,
//       compile_inferred, compile, validate_then_compile.
// Consumes: compiler/04_infer.dag, compiler/05_emit.dag, compiler/07_target_carriers.dag,
//           std/collection.dag, std/diagnostic.dag,
//           std/node.dag, std/text.dag, std/witness.dag.
// Status: Wave-5-A — validate_then_compile: infer once → lens gates on InferredTree → compile_inferred (TranslateTo: emit).
// Anchor: docs/design-v4-compiler-homomorphism.md P3 commitment 6 + Ratified Q11.


module v4.compiler.compile


import v4.compiler.emit { emit }
import v4.compiler.infer { infer, InferredTree }
import v4.compiler.target_carriers { LanguageModel, TargetModel, TargetSource }
import v4.std.collection { List }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  Outcome,
  port_locus,
  Rejected,
  Unavailable,
  bind_outcome,
  bind_outcome_accepted,
  diagnostics_singleton,
  outcome_accepted,
  outcome_rejected
}
import v4.std.node { Node, Symbol }
import v4.std.text { String }
import v4.std.witness { Witness }


// 🟢 grounded — post-normalize substrate graph; Theme-A #9 forward until named ModelCore bundle lands.
type CoreNode = Node


// 🟢 grounded — concrete runtime extdep target; Eval terminal only.
type RuntimeTarget = Node


// 🟢 grounded — pre-ingest text slot; legacy staging only (not compile-core).
type Source = String


// 🟢 coproduct dissolution — ratified compile-core terminal modes (P1/P2).
type CompileMode
  = TranslateTo { target: TargetModel }
  | Eval { runtime: RuntimeTarget }


// 🟢 coproduct dissolution — mode-dependent compile-core output (Output in design doc).
type CompileOutput
  = TranslateResult { source: TargetSource }
  | EvalResult { value: Node }


// 🟢 grounded — compile-pipeline lens gate (P3 side-channel on InferredTree).
// Orthogonal to v4.lens.application `Lens<Output>.read` + section-scoped `apply_lens` (T-23 substrate);
// adapter wiring is a follow-on — see application.dag header P2 boundary.
type CompileLens {
  gate: fn(InferredTree) -> Outcome<Witness<Node>>
}


// 🟢 coproduct dissolution — compile gate mode until introspect demotion lands in application.dag.
type CompileLensMode
  = CompileLensEnforce
  | CompileLensIntrospect


// 🟢 grounded — lens gate witness cites substrate Witness (Practice 3; not parallel fact payload).
type LensGateWitness {
  witness: Witness<Node>
}


// 🟢 grounded — public terminal carrier; discharged only by validate_then_compile (P3 commitment 6).
type Validated<T> {
  value: T
  lens_witnesses: List<LensGateWitness>
}


data compile_stage_locus_port: Symbol = compile_stage_locus_port
data compile_pipeline_not_realized: Symbol = compile_pipeline_not_realized
data compile_lens_gate_rejected: Symbol = compile_lens_gate_rejected
data compile_eval_not_realized: Symbol = compile_eval_not_realized


fn compile_pipeline_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: compile_pipeline_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn compile_lens_gate_rejected_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: compile_lens_gate_rejected,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn compile_eval_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: compile_eval_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// Compile-pipeline gate runner (NOT v4.lens.application::apply_lens — different root + carrier).
// CompileLensEnforce and CompileLensIntrospect both call gate today; introspect demotion is application-layer.
fn apply_compile_lens(
  lens: CompileLens,
  inferred: InferredTree,
  mode: CompileLensMode
) -> Outcome<Witness<Node>> {
  match mode {
    CompileLensEnforce => lens.gate(tree: inferred)
    CompileLensIntrospect => lens.gate(tree: inferred)
  }
}


// list_push is kernel/prelude (see std/diagnostic.dag); not exported from std/collection.
fn append_lens_gate_witness(
  witnesses: List<LensGateWitness>,
  witness: Witness<Node>
) -> List<LensGateWitness> {
  fold(
    [LensGateWitness { witness: witness }],
    init: witnesses,
    f: fn(acc, item) {
      list_push(acc, item)
    }
  )
}


fn empty_lens_gate_witnesses() -> List<LensGateWitness> {
  []
}


fn run_required_lens_gates(
  inferred: InferredTree,
  lenses: List<CompileLens>
) -> Outcome<List<LensGateWitness>> {
  fold(
    lenses,
    init: outcome_accepted(value: empty_lens_gate_witnesses()),
    f: fn(acc_outcome, lens) {
      match acc_outcome {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: witnesses, diagnostics: od } =>
          bind_outcome_accepted(
            od: od,
            inner: bind_outcome(
              o: apply_compile_lens(lens: lens, inferred: inferred, mode: CompileLensEnforce),
              f: fn(w) {
                outcome_accepted(
                  value: append_lens_gate_witness(
                    witnesses: witnesses,
                    witness: w
                  )
                )
              }
            )
          )
      }
    }
  )
}


fn compile_inferred_translate(
  inferred: InferredTree,
  input_lang: LanguageModel,
  target: TargetModel
) -> Outcome<TargetSource> {
  emit(tree: inferred, target: target, input_lang: input_lang)
}


fn compile_inferred(
  inferred: InferredTree,
  input_lang: LanguageModel,
  mode: CompileMode
) -> Outcome<CompileOutput> {
  match mode {
    TranslateTo { target } =>
      bind_outcome(
        o: compile_inferred_translate(
          inferred: inferred,
          input_lang: input_lang,
          target: target
        ),
        f: fn(target_source) {
          outcome_accepted(TranslateResult { source: target_source })
        }
      )
    Eval { runtime: _ } =>
      outcome_rejected(
        compile_eval_not_realized_diagnostic(
          at: port_locus(port: compile_stage_locus_port)
        )
      )
  }
}


// Internal/advanced compile-core (P3 commitment 6). Not the public terminal — use validate_then_compile.
fn compile(
  source: CoreNode,
  input_lang: LanguageModel,
  mode: CompileMode
) -> Outcome<CompileOutput> {
  bind_outcome(
    o: infer(tree: source),
    f: fn(inferred) {
      compile_inferred(inferred: inferred, input_lang: input_lang, mode: mode)
    }
  )
}


fn validated_from_compile_output(
  output: CompileOutput,
  lens_witnesses: List<LensGateWitness>
) -> Validated<CompileOutput> {
  Validated {
    value: output,
    lens_witnesses: lens_witnesses
  }
}


// Public terminal (P3 commitment 6): infer → required-lens gates on InferredTree → compile_inferred.
fn validate_then_compile(
  source: CoreNode,
  input_lang: LanguageModel,
  lenses: List<CompileLens>,
  mode: CompileMode
) -> Outcome<Validated<CompileOutput>> {
  bind_outcome(
    o: infer(tree: source),
    f: fn(inferred) {
      bind_outcome(
        o: run_required_lens_gates(inferred: inferred, lenses: lenses),
        f: fn(lens_witnesses) {
          bind_outcome(
            o: compile_inferred(
              inferred: inferred,
              input_lang: input_lang,
              mode: mode
            ),
            f: fn(compile_out) {
              outcome_accepted(
                value: validated_from_compile_output(
                  output: compile_out,
                  lens_witnesses: lens_witnesses
                )
              )
            }
          )
        }
      )
    }
  )
}


// Legacy Wave-1 ingest orchestrator (Source text path). Staging until ingest lands on compile-core.
fn compile_ingest_staging(source: Source, target: TargetModel) -> Outcome<TargetSource> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: compile_pipeline_not_realized_diagnostic(
        at: port_locus(port: compile_stage_locus_port)
      )
    )
  }
}
