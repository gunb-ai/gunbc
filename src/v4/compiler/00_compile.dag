// src/v4/compiler/00_compile.dag
// Scope: B2-OMNI orchestrator — public terminal `validate_then_compile` (P3 commitment 6);
//       internal `compile` over CoreNode + CompileMode; legacy Source staging until ingest lands;
//       compile_with_store filesystem-free ingest over agent-supplied module bundles.
// Owns: CoreNode, RuntimeTarget, CompileMode, CompileOutput, CompileLens, CompileLensMode,
//       apply_compile_lens, LensGateWitness, Validated, compile_stage_locus_port, compile_pipeline_not_realized,
//       compile_lens_gate_rejected, compile_eval_not_realized, compile_ingest_staging,
//       compile_with_store, agent_store_to_module_graph, agent_module_source_to_entry,
//       compile_pipeline_not_realized_diagnostic, compile_lens_gate_rejected_diagnostic,
//       compile_eval_not_realized_diagnostic, apply_compile_lens, run_required_lens_gates,
//       run_required_lens_gates_on_subtree, compile_inferred, compile, validate_then_compile,
//       fact_density_hollow_alias_compile_gate, fact_density_lens, always_required_lenses.
// Consumes: compiler/01_tokenize.dag, compiler/02_parse.dag, compiler/03_normalize.dag,
//           compiler/03_resolve.dag, compiler/04_infer.dag, compiler/05_emit.dag,
//           compiler/07_target_carriers.dag, extdeps/languages/dag.dag,
//           lens/fact_density.dag, std/algebra.dag, std/collection.dag, std/diagnostic.dag,
//           std/agent.dag, std/module_graph.dag, std/node.dag, std/text.dag, std/witness.dag.
// Status: Wave-5-A — validate_then_compile: lens gates wired; compile_ingest_staging: tokenize → parse → normalize → resolve → compile.
// Anchor: docs/design-v4-compiler-homomorphism.md P3 commitment 6 + Ratified Q11.


module v4.compiler.compile


import v4.compiler.emit { emit }
import v4.compiler.infer { infer, InferredTree }
import v4.compiler.module_resolve {
  ModuleAdmission,
  ModuleSubject,
  resolve_module_with_admission
}
import v4.compiler.normalize { normalize }
import v4.compiler.parse { parse }
import v4.compiler.resolve { resolve }
import v4.compiler.tokenize { tokenize }
import v4.compiler.target_carriers { TargetModel, TargetSource }
import v4.extdeps.languages.dag { DagLanguageModel, dag_language_model_wave1 }
import v4.lens.fact_density { fact_density_hollow_alias_gate }
import v4.std.agent { AgentModuleSource, AgentStore }
import v4.std.algebra { Cons, Empty, FreeMonoid, list_append }
import v4.std.collection { List }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  None,
  Outcome,
  port_locus,
  Rejected,
  Unavailable,
  bind_outcome,
  bind_outcome_accepted,
  diagnostics_singleton,
  outcome_accepted,
  outcome_rejected,
}
import v4.std.module_graph {
  ModuleEntry,
  ModuleGraph,
  module_graph_entry_for_path,
  module_graph_from_entries,
  module_path_eq
}
import v4.std.node { Edge, Node, NodeFold, Symbol, fold_node }
import v4.std.text { String }
import v4.std.witness { Holds, Violates, Witness }


type CoreNode = Node

type RuntimeTarget = Node

type Source = String

// 🟢 coproduct dissolution
type CompileMode
  = TranslateTo { target: TargetModel }
  | Eval { runtime: RuntimeTarget }


// 🟢 coproduct dissolution
type CompileOutput
  = TranslateResult { source: TargetSource }
  | EvalResult { value: Node }


type CompileLens {
  gate: fn(InferredTree) -> Outcome<Witness<Node>>
}


// 🟢 coproduct dissolution
type CompileLensMode
  = CompileLensEnforce
  | CompileLensIntrospect


type LensGateWitness {
  witness: Witness<Node>
}


type Validated<T> {
  value: T
  lens_witnesses: List<LensGateWitness>
}


data compile_stage_locus_port: Symbol = compile_stage_locus_port
data compile_ingest_staging_source_file: Symbol = compile_ingest_staging_source_file
data compile_pipeline_not_realized: Symbol = compile_pipeline_not_realized
data compile_lens_gate_rejected: Symbol = compile_lens_gate_rejected
data compile_eval_not_realized: Symbol = compile_eval_not_realized
data compile_agent_store_entry_missing: Symbol = compile_agent_store_entry_missing
data compile_agent_store_imports_not_modeled: Symbol = compile_agent_store_imports_not_modeled


fn compile_pipeline_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: compile_pipeline_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn compile_lens_gate_rejected_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: compile_lens_gate_rejected,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn compile_eval_not_realized_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: compile_eval_not_realized,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn compile_agent_store_entry_missing_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: compile_agent_store_entry_missing,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn compile_agent_store_imports_not_modeled_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: compile_agent_store_imports_not_modeled,
    at: at,
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


data fact_density_lens: CompileLens = CompileLens {
  gate: fact_density_hollow_alias_compile_gate
}


fn always_required_lenses() -> List<CompileLens> {
  [fact_density_lens]
}


fn fact_density_hollow_alias_compile_gate(tree: InferredTree) -> Outcome<Witness<Node>> {
  fact_density_hollow_alias_gate(node: tree.root)
}


// 🟡 gated — feature:T-23-lens-application-migration — bind src/v4/lens/application.dag TASKS.md T-23 — dissolve-on: delete local CompileLens type and apply_compile_lens stub when v4.lens.application.apply_lens is canonical; forbidden: callers treating compile.apply_compile_lens as permanent surface or diverging from application.dag contract.
// T-23 migration stub: identical contract to v4.lens.application apply_lens when that module fills.
// CompileLensEnforce and CompileLensIntrospect both call gate today; introspect demotion lands with application.dag.
fn apply_compile_lens(
  lens: CompileLens,
  inferred: InferredTree,
  mode: CompileLensMode
) -> Outcome<Witness<Node>> {
  match mode {
    CompileLensEnforce => lens.gate(tree: inferred)
    CompileLensIntrospect => lens.gate(tree: inferred)
  }
}


fn append_lens_gate_witness(
  witnesses: List<LensGateWitness>,
  witness: Witness<Node>
) -> List<LensGateWitness> {
  fold(
    [LensGateWitness { witness: witness }],
    init: witnesses,
    f: fn(acc, item) {
      list_push(acc, item)
    }
  )
}


fn empty_lens_gate_witnesses() -> List<LensGateWitness> {
  []
}


fn run_required_lens_gates(
  inferred: InferredTree,
  lenses: List<CompileLens>
) -> Outcome<List<LensGateWitness>> {
  fold(
    lenses,
    init: outcome_accepted(value: empty_lens_gate_witnesses()),
    f: fn(acc_outcome, lens) {
      match acc_outcome {
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
        Accepted { value: witnesses, diagnostics: od } =>
          bind_outcome_accepted(
            od: od,
            inner: bind_outcome(
              o: apply_compile_lens(lens: lens, inferred: inferred, mode: CompileLensEnforce),
              f: fn(w) {
                outcome_accepted(
                  value: append_lens_gate_witness(
                    witnesses: witnesses,
                    witness: w
                  )
                )
              }
            )
          )
      }
    }
  )
}


fn run_required_lens_gates_on_subtree(
  inferred: InferredTree,
  lenses: List<CompileLens>
) -> Outcome<List<LensGateWitness>> {
  fold_node(
    n: inferred.root,
    algebra: NodeFold {
      init: fn(n0) {
        run_required_lens_gates(
          inferred: InferredTree { root: n0, facts: inferred.facts },
          lenses: lenses
        )
      },
      step: fn(acc, _, child) {
        bind_outcome(o: acc, f: fn(ws) {
          bind_outcome(
            o: child,
            f: fn(child_ws) {
              outcome_accepted(value: list_append(left: ws, right: child_ws))
            }
          )
        })
      }
    }
  )
}


fn compile_inferred_translate(
  inferred: InferredTree,
  target: TargetModel
) -> Outcome<TargetSource> {
  emit(tree: inferred, target: target)
}


fn compile_inferred(
  inferred: InferredTree,
  mode: CompileMode
) -> Outcome<CompileOutput> {
  match mode {
    TranslateTo { target } =>
      bind_outcome(
        o: compile_inferred_translate(
          inferred: inferred,
          target: target
        ),
        f: fn(target_source) {
          outcome_accepted(TranslateResult { source: target_source })
        }
      )
    Eval { runtime: _ } =>
      outcome_rejected(
        compile_eval_not_realized_diagnostic(
          at: port_locus(port: compile_stage_locus_port)
        )
      )
  }
}


fn compile(
  source: CoreNode,
  mode: CompileMode
) -> Outcome<CompileOutput> {
  bind_outcome(
    o: infer(tree: source),
    f: fn(inferred) {
      compile_inferred(inferred: inferred, mode: mode)
    }
  )
}


fn validated_from_compile_output(
  output: CompileOutput,
  lens_witnesses: List<LensGateWitness>
) -> Validated<CompileOutput> {
  Validated {
    value: output,
    lens_witnesses: lens_witnesses
  }
}


fn validate_then_compile(
  source: CoreNode,
  lenses: List<CompileLens>,
  mode: CompileMode
) -> Outcome<Validated<CompileOutput>> {
  bind_outcome(
    o: infer(tree: source),
    f: fn(inferred) {
      bind_outcome(
        o: run_required_lens_gates_on_subtree(inferred: inferred, lenses: always_required_lenses()),
        f: fn(required_lens_witnesses) {
          bind_outcome(
            o: run_required_lens_gates(inferred: inferred, lenses: lenses),
            f: fn(caller_lens_witnesses) {
              bind_outcome(
                o: compile_inferred(
                  inferred: inferred,
                  mode: mode
                ),
                f: fn(compile_out) {
                  outcome_accepted(
                    value: validated_from_compile_output(
                      output: compile_out,
                      lens_witnesses: list_append(
                        left: required_lens_witnesses,
                        right: caller_lens_witnesses
                      )
                    )
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}


fn compile_ingest_staging(source: Source, target: TargetModel) -> Outcome<TargetSource> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: tokenize(
      text: source,
      file: compile_ingest_staging_source_file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          bind_outcome(
            o: normalize(parse_tree: parse_tree),
            f: fn(normalized) {
              // 🟡 gate: T-8 parse fidelity maps all identifiers to dag_token_ident — namespace lookup is vacuously satisfied. Dissolve-on: T-8 lands per-identifier hashing; at that point the static registry (Option A) or recursive loader (Option B) must call compiler/03_module_resolve.dag for cross-file admission.
              bind_outcome(
                o: resolve(tree: normalized, lm: lm),
                f: fn(resolved) {
                  bind_outcome(
                    o: compile(
                      source: resolved,
                      mode: TranslateTo { target: target }
                    ),
                    f: fn(compile_out) {
                      match compile_out {
                        TranslateResult { source: target_source } =>
                          outcome_accepted(target_source)
                        EvalResult { value: _ } =>
                          outcome_rejected(
                            compile_eval_not_realized_diagnostic(
                              at: port_locus(port: compile_stage_locus_port)
                            )
                          )
                      }
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}


fn agent_module_source_to_entry(
  module_source: AgentModuleSource,
  lm: DagLanguageModel
) -> Outcome<ModuleEntry> {
  bind_outcome(
    o: tokenize(
      text: module_source.source,
      file: module_source.file,
      rules: lm.lex
    ),
    f: fn(token_stream) {
      bind_outcome(
        o: parse(tokens: token_stream, grammar: lm.grammar),
        f: fn(parse_tree) {
          bind_outcome(
            o: normalize(parse_tree: parse_tree),
            f: fn(normalized) {
              outcome_accepted(
                value: ModuleEntry {
                  path: module_source.path,
                  root: normalized
                }
              )
            }
          )
        }
      )
    }
  )
}


fn agent_store_entries(
  store: AgentStore,
  lm: DagLanguageModel
) -> Outcome<List<ModuleEntry>> {
  agent_store_entries_fold(modules: store.modules, lm: lm)
}


// 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-agentmodulesource — same v2 bootstrap limitation as std/module_graph.dag's ModuleEntry folds; hand-rolls Empty/Cons accumulation over FreeMonoid<AgentModuleSource>; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T.
fn agent_store_entries_fold(
  modules: FreeMonoid<AgentModuleSource>,
  lm: DagLanguageModel
) -> Outcome<List<ModuleEntry>> {
  match modules {
    Empty => Accepted { value: Empty, diagnostics: None }
    Cons { head: module_source, tail: rest } =>
      bind_outcome(
        o: agent_module_source_to_entry(module_source: module_source, lm: lm),
        f: fn(entry) {
          bind_outcome(
            o: agent_store_entries_fold(modules: rest, lm: lm),
            f: fn(entries) {
              outcome_accepted(value: list_push(entries, entry))
            }
          )
        }
      )
  }
}


fn agent_store_single_module_diagnostic() -> Diagnostic {
  compile_agent_store_imports_not_modeled_diagnostic(
    at: port_locus(port: compile_agent_store_imports_not_modeled)
  )
}


fn agent_store_is_single_entry_module(store: AgentStore) -> Outcome<AgentModuleSource> {
  match store.modules {
    Empty =>
      outcome_rejected(
        d: compile_agent_store_entry_missing_diagnostic(
          at: port_locus(port: compile_agent_store_entry_missing)
        )
      )
    Cons { head: module_source, tail: rest } =>
      match rest {
        Empty =>
          if module_path_eq(a: module_source.path, b: store.entry) {
            outcome_accepted(value: module_source)
          } else {
            outcome_rejected(
              d: compile_agent_store_entry_missing_diagnostic(
                at: port_locus(port: compile_agent_store_entry_missing)
              )
            )
          }
        Cons { head: _, tail: _ } =>
          outcome_rejected(d: agent_store_single_module_diagnostic())
      }
  }
}


fn agent_store_to_module_graph(
  store: AgentStore,
  lm: DagLanguageModel
) -> Outcome<ModuleGraph> {
  bind_outcome(
    o: agent_store_entries(store: store, lm: lm),
    f: fn(entries) {
      match module_graph_from_entries(entries: entries) {
        Holds { value: graph } => outcome_accepted(value: graph)
        Violates { diagnostic: d } => outcome_rejected(d: d)
      }
    }
  )
}


fn compile_with_store(store: AgentStore, target: TargetModel) -> Outcome<TargetSource> {
  let lm = dag_language_model_wave1()
  bind_outcome(
    o: agent_store_is_single_entry_module(store: store),
    f: fn(_) {
      bind_outcome(
        o: agent_store_to_module_graph(store: store, lm: lm),
        f: fn(graph) {
          match module_graph_entry_for_path(graph: graph, path: store.entry) {
            Holds { value: entry } =>
              bind_outcome(
                o: resolve_module_with_admission(
                  lm: lm,
                  graph: graph,
                  admission: ModuleAdmission {
                    subject: ModuleSubject {
                      path: store.entry,
                      tree: entry.root
                    },
                    imports: Empty
                  }
                ),
                f: fn(resolved) {
                  bind_outcome(
                    o: compile(
                      source: resolved,
                      mode: TranslateTo { target: target }
                    ),
                    f: fn(compile_out) {
                      match compile_out {
                        TranslateResult { source: target_source } =>
                          outcome_accepted(target_source)
                        EvalResult { value: _ } =>
                          outcome_rejected(
                            compile_eval_not_realized_diagnostic(
                              at: port_locus(port: compile_stage_locus_port)
                            )
                          )
                      }
                    }
                  )
                }
              )
            Violates { diagnostic: _ } =>
              outcome_rejected(
                d: compile_agent_store_entry_missing_diagnostic(
                  at: port_locus(port: compile_agent_store_entry_missing)
                )
              )
          }
        }
      )
    }
  )
}
