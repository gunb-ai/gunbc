// src/v4/compiler/03_resolve.dag
//
// Scope: Stage 3b — NormalizedTree→ResolvedTree; K-1 Atom use→def.
// Owns: ResolvedTree; Namespace; Scope; EdgeResolveAcc; BindEdgeAcc; resolve; Symbol reasons.
// Consumes: std/node.dag, std/diagnostic.dag, std/collection.dag, compiler/03_normalize.dag, extdeps/languages/dag.dag (DagLanguageModel for canonical_symbols).
// Status: scaffold — TASKS T-8.
// Anchor: https://en.wikipedia.org/wiki/Name_resolution_(programming_languages)

module v4.compiler.resolve


import v4.compiler.normalize { NormalizedTree }
import v4.extdeps.languages.dag {
  DagLanguageModel,
  dag_language_model_canonical_symbols
}
import v4.std.collection { Set }
import v4.std.diagnostic {
  Diagnostic,
  NodeLocus,
  Outcome,
  Produced,
  Rejected,
  UserInputBoundary
}
import v4.std.node {
  Arrow,
  Atom,
  Bind,
  ComputationNode,
  Conj,
  Edge,
  Node,
  Symbol,
  TypeNode,
  node_well_formed
}


type ResolvedTree = Node


data resolve_reason_malformed_tree: Symbol = resolve_reason_malformed_tree
data resolve_reason_unbound_symbol: Symbol = resolve_reason_unbound_symbol


type Namespace {
  bindings: Map<Symbol, Symbol>
  canonical_symbols: Set<Symbol>
}


type Scope {
  module: Namespace
  frames: List<Map<Symbol, Symbol>>
}


type EdgeResolveAcc
  = EdgeResolveAccMk { have_seen_first: Bool, acc: Outcome<List<Edge>> }


type BindEdgeAcc
  = BindEdgeAccMk { idx: Int, acc: Outcome<List<Edge>> }


fn empty_namespace() -> Namespace {
  Namespace {
    bindings: empty_map(),
    canonical_symbols: empty_canonical_symbol_set()
  }
}


fn empty_canonical_symbol_set() -> Set<Symbol> {
  Set {
    member: fn(_) {
      false
    }
  }
}


fn empty_edge_list() -> List<Edge> {
  []
}


fn merge_binding_self(m: Map<Symbol, Symbol>, sym: Symbol) -> Map<Symbol, Symbol> {
  map_insert(m, sym, sym)
}


fn add_module_named_exports(root: Node, acc: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: acc, f: fn(acc2, e) {
        match e.label {
          Named { name: decl } => merge_binding_self(m: acc2, sym: decl)
          Positional => acc2
        }
      })
    _ => acc
  }
}


fn add_arrow_domain_named_params(n: Node, acc: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  match n.kind {
    TypeNode { connective: Arrow } =>
      if count(n.children) >= 1 {
        match first(n.children) {
          Some { value: e0 } =>
            match e0.target.kind {
              TypeNode { connective: Conj } =>
                fold(e0.target.children, init: acc, f: fn(acc2, pe) {
                  match pe.label {
                    Named { name: param } =>
                      merge_binding_self(m: acc2, sym: param)
                    Positional => acc2
                  }
                })
              _ => acc
            }
          None => acc
        }
      } else {
        acc
      }
    _ => acc
  }
}


fn add_bind_atom_binder(n: Node, acc: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  match n.kind {
    ComputationNode { behavior: Bind } =>
      if count(n.children) == 3 {
        match first(n.children) {
          Some { value: e0 } =>
            match e0.target.kind {
              TypeNode { connective: Atom { identity: b } } =>
                merge_binding_self(m: acc, sym: b)
              _ => acc
            }
          None => acc
        }
      } else {
        acc
      }
    _ => acc
  }
}


fn build_program_namespace(tree: NormalizedTree, lm: DagLanguageModel) -> Namespace {
  Namespace {
    bindings: add_module_named_exports(root: tree, acc: empty_map()),
    canonical_symbols: dag_language_model_canonical_symbols(lm: lm)
  }
}


fn scope_from_namespace(namespace: Namespace) -> Scope {
  Scope { module: namespace, frames: [] }
}


fn scope_root_module(s: Scope) -> Namespace {
  s.module
}


fn scope_push_frame(s: Scope, locals: Map<Symbol, Symbol>) -> Scope {
  Scope { module: s.module, frames: list_push(s.frames, locals) }
}


fn lookup_chain(s: Scope, name: Symbol) -> Symbol? {
  fold(s.frames, init: map_get(s.module.bindings, name), f: fn(acc, m) {
    match map_get(m, name) {
      Some { value: v } => Some { value: v }
      None => acc
    }
  })
}


fn malformed_tree_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: resolve_reason_malformed_tree,
    at: NodeLocus { node: n },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn unbound_symbol_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: resolve_reason_unbound_symbol,
    at: NodeLocus { node: n },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn namespace_has_canonical_symbol(namespace: Namespace, name: Symbol) -> Bool {
  namespace.canonical_symbols.member(name)
}


fn canonical_atom(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: []
  }
}


fn resolve_atom(n: Node, scope: Scope, identity: Symbol) -> Outcome<Node> {
  match lookup_chain(s: scope, name: identity) {
    Some { value: canonical } =>
      Produced {
        value: canonical_atom(identity: canonical)
      }
    None =>
      if namespace_has_canonical_symbol(
        namespace: scope_root_module(s: scope),
        name: identity
      ) {
        Produced { value: canonical_atom(identity: identity) }
      } else {
        Rejected { diagnostic: unbound_symbol_diagnostic(n: n) }
      }
  }
}


fn resolve_node(n: Node, scope: Scope) -> Outcome<Node> {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      resolve_atom(n: n, scope: scope, identity: id)
    TypeNode { connective: Arrow } =>
      match resolve_edges_first_outer_then_inner(
        edges: n.children,
        scope_outer: scope,
        scope_inner: scope_push_frame(
          s: scope,
          locals: add_arrow_domain_named_params(n: n, acc: empty_map())
        )
      ) {
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
        Produced { value: resolved_children } =>
          Produced {
            value: Node {
              kind: n.kind,
              children: resolved_children
            }
          }
      }
    ComputationNode { behavior: Bind } =>
      resolve_bind_node(n: n, scope: scope)
    TypeNode { connective: _ } =>
      resolve_children_homogeneous_scope(n: n, scope: scope)
    ComputationNode { behavior: _ } =>
      resolve_children_homogeneous_scope(n: n, scope: scope)
  }
}


fn resolve_children_homogeneous_scope(n: Node, scope: Scope) -> Outcome<Node> {
  match fold(n.children, init: Produced { value: empty_edge_list() }, f: fn(acc, e) {
    match acc {
      Rejected { diagnostic: d } =>
        Rejected { diagnostic: d }
      Produced { value: done } =>
        match resolve_node(n: e.target, scope: scope) {
          Rejected { diagnostic: d } =>
            Rejected { diagnostic: d }
          Produced { value: resolved_target } =>
            Produced {
              value: list_push(done, Edge {
                label: e.label,
                target: resolved_target
              })
            }
        }
    }
  }) {
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
    Produced { value: resolved_children } =>
      Produced {
        value: Node {
          kind: n.kind,
          children: resolved_children
        }
      }
  }
}


fn resolve_edges_first_outer_then_inner(
  edges: List<Edge>,
  scope_outer: Scope,
  scope_inner: Scope
) -> Outcome<List<Edge>> {
  match fold(
    edges,
    init: EdgeResolveAccMk {
      have_seen_first: false,
      acc: Produced { value: empty_edge_list() }
    },
    f: fn(state, e) {
      match state {
        EdgeResolveAccMk { have_seen_first: seen, acc: acc_state } =>
          match acc_state {
            Rejected { diagnostic: d } =>
              EdgeResolveAccMk {
                have_seen_first: true,
                acc: Rejected { diagnostic: d }
              }
            Produced { value: done } =>
              if seen {
                match resolve_node(n: e.target, scope: scope_inner) {
                  Rejected { diagnostic: d } =>
                    EdgeResolveAccMk {
                      have_seen_first: true,
                      acc: Rejected { diagnostic: d }
                    }
                  Produced { value: resolved_target } =>
                    EdgeResolveAccMk {
                      have_seen_first: true,
                      acc: Produced {
                        value: list_push(
                          done,
                          Edge {
                            label: e.label,
                            target: resolved_target
                          }
                        )
                      }
                    }
                }
              } else {
                match resolve_node(n: e.target, scope: scope_outer) {
                  Rejected { diagnostic: d } =>
                    EdgeResolveAccMk {
                      have_seen_first: true,
                      acc: Rejected { diagnostic: d }
                    }
                  Produced { value: resolved_target } =>
                    EdgeResolveAccMk {
                      have_seen_first: true,
                      acc: Produced {
                        value: list_push(
                          done,
                          Edge {
                            label: e.label,
                            target: resolved_target
                          }
                        )
                      }
                    }
                }
              }
          }
      }
    }
  ) {
    EdgeResolveAccMk { acc: acc_state, have_seen_first: _ } => acc_state
  }
}


// DECISIONS.md §CP-1b (item 3).
fn resolve_bind_binder_target(t: Node) -> Outcome<Node> {
  match t.kind {
    TypeNode { connective: Atom { identity: id } } =>
      Produced {
        value: canonical_atom(identity: id)
      }
    _ =>
      Rejected {
        diagnostic: malformed_tree_diagnostic(n: t)
      }
  }
}


fn resolve_bind_edges(
  edges: List<Edge>,
  scope_outer: Scope,
  scope_inner: Scope
) -> Outcome<List<Edge>> {
  match fold(
    edges,
    init: BindEdgeAccMk {
      idx: 0,
      acc: Produced { value: empty_edge_list() }
    },
    f: fn(state, e) {
      match state {
        BindEdgeAccMk { idx: i, acc: acc_state } =>
          match acc_state {
            Rejected { diagnostic: d } =>
              BindEdgeAccMk {
                idx: i + 1,
                acc: Rejected { diagnostic: d }
              }
            Produced { value: done } =>
              if i == 0 {
                match resolve_bind_binder_target(t: e.target) {
                  Rejected { diagnostic: d } =>
                    BindEdgeAccMk {
                      idx: i + 1,
                      acc: Rejected { diagnostic: d }
                    }
                  Produced { value: rt } =>
                    BindEdgeAccMk {
                      idx: i + 1,
                      acc: Produced {
                        value: list_push(
                          done,
                          Edge {
                            label: e.label,
                            target: rt
                          }
                        )
                      }
                    }
                }
              } else {
                if i == 1 {
                  match resolve_node(n: e.target, scope: scope_outer) {
                    Rejected { diagnostic: d } =>
                      BindEdgeAccMk {
                        idx: i + 1,
                        acc: Rejected { diagnostic: d }
                      }
                    Produced { value: rt } =>
                      BindEdgeAccMk {
                        idx: i + 1,
                        acc: Produced {
                          value: list_push(
                            done,
                            Edge {
                              label: e.label,
                              target: rt
                            }
                          )
                        }
                      }
                  }
                } else {
                  match resolve_node(n: e.target, scope: scope_inner) {
                    Rejected { diagnostic: d } =>
                      BindEdgeAccMk {
                        idx: i + 1,
                        acc: Rejected { diagnostic: d }
                      }
                    Produced { value: rt } =>
                      BindEdgeAccMk {
                        idx: i + 1,
                        acc: Produced {
                          value: list_push(
                            done,
                            Edge {
                              label: e.label,
                              target: rt
                            }
                          )
                        }
                      }
                  }
                }
              }
          }
      }
    }
  ) {
    BindEdgeAccMk { acc: acc_state, idx: _ } => acc_state
  }
}


fn resolve_bind_node(n: Node, scope: Scope) -> Outcome<Node> {
  if count(n.children) == 3 {
    match resolve_bind_edges(
      edges: n.children,
      scope_outer: scope,
      scope_inner: scope_push_frame(
        s: scope,
        locals: add_bind_atom_binder(n: n, acc: empty_map())
      )
    ) {
      Rejected { diagnostic: d } => Rejected { diagnostic: d }
      Produced { value: resolved_children } =>
        Produced {
          value: Node {
            kind: n.kind,
            children: resolved_children
          }
        }
    }
  } else {
    Rejected {
      diagnostic: malformed_tree_diagnostic(n: n)
    }
  }
}


fn resolve(tree: NormalizedTree, lm: DagLanguageModel) -> Outcome<ResolvedTree> {
  resolve_with_namespace(
    tree: tree,
    namespace: build_program_namespace(tree: tree, lm: lm)
  )
}


fn resolve_with_namespace(tree: NormalizedTree, namespace: Namespace) -> Outcome<ResolvedTree> {
  if node_well_formed(n: tree) {
    resolve_node(n: tree, scope: scope_from_namespace(namespace: namespace))
  } else {
    Rejected { diagnostic: malformed_tree_diagnostic(n: tree) }
  }
}
