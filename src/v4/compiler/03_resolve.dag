// src/v4/compiler/03_resolve.dag
//
// Scope: pipeline stage 3b — symbol resolution. Identifier to declaration binding.
// Anchor: https://en.wikipedia.org/wiki/Name_resolution_(programming_languages)
//
// Owns:
//   - ResolvedTree type
//   - resolve: NormalizedTree -> Result<ResolvedTree, Diagnostic>
//   - identifier binding to declarations
//
// B-4 (side-session 2026-05-16) — this stage is the AUTHORITY for the
//   use→def fact affected_set R2 traverses (T-21). The named forward
//   carrier is the opaque `Symbol` (K-1) on the name-reference `Atom`,
//   NOT 04_infer's `resolved_type` (that is the node's type — lossy
//   for binding identity; the P2/Practice-3 review point). Contract:
//   - resolve canonicalizes a use-site `Atom`'s `Symbol` to be
//     IDENTICAL to its binder declaration's `Symbol`, so binding =
//     `Symbol` equality (the one K-1-granted op; node.dag
//     `name_occurrences`; "resolved through the namespace", A1/K-1).
//   - binding is NODE-PRECISE: the canonical `Symbol` identifies the
//     EXACT declaration, never merely its module/scope. Coarse binding
//     ⇒ affected_set correct but maximally over-fires (the dominant R2
//     minimality gate). 04_infer must PRESERVE this `Symbol` unchanged
//     (preserve-only; no 5th InferredFacts field). See 04_infer.dag
//     B-4 + lens/affected_set.dag.
//
// Consumes:
//   - std/node.dag, std/diagnostic.dag
//   - compiler/03_normalize.dag: NormalizedTree
//
// Status: T-8 modeled 2026-05-16 (bright-seal-437). Resolution owns
// scope/env/lookup/name binding for the front-end, including method-name
// lookup through the same canonical Symbol boundary.
//
// Binding construction (CP-1b operator ruling, #3211): public `resolve`
// builds a `Namespace` by walking the `NormalizedTree` — no external
// namespace producer. Within-file rules (B-4 node precision, K-1-only):
//   (M) At the program root `TypeNode { Conj }`, each `EdgeLabel.Named`
//       child key is a module-level declaration Symbol (the module table
//       uses Named as the declaration address — distinct from using Named
//       inside arbitrary inner Conj record sugar as an implicit binder).
//   (P) Under any `TypeNode { Arrow }`, the domain (first positional child)
//       MAY be a `Conj` of formal parameters; each `Named` key there is a
//       parameter binder Symbol (fn / Pi domain discipline).
//   (B) `ComputationNode { Bind }` with arity 3: the first child's target
//       `TypeNode { Atom { identity: b } }` is the let-binder name (Atom
//       pattern only in this wave). **Wave-1 / CP-1b gather semantics:** (B)
//       binders are recorded in the **same** program-level `bindings` map as
//       (M) and (P) — `gather_bindings_walk` unions every discovered binder
//       into one flat `Map<Symbol, Symbol>` (identity entries today), and
//       `resolve_node` threads a **single** `Scope` for the entire tree. This
//       is **within-file flat resolution**, not subtree-scoped lexical extent
//       for the Bind's third child; true nested let/shadowing is an explicit
//       future wave — document in B-4 / affected_set receipts when it lands.
// Cross-file / import / module-loading edges are OUT OF SCOPE here — STOP
// escalate to operator with that exact dependency if a change needs them.
// Unbound Atoms (no `bindings` entry, not listed in `canonical_symbols`)
// fail closed. `canonical_symbols` remains for explicit extern/std/import
// producers that attach canonical identities without a use→def rewrite.
// 04_infer preserves resolved Symbols and owns type inference, Find, cost.
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.compiler.resolve


import v4.compiler.normalize { NormalizedTree }
import v4.std.collection { Set }
import v4.std.diagnostic {
  AmbiguousIntent,
  Correction,
  Diagnostic,
  Locus,
  NodeLocus,
  NoCorrectionReason,
  Outcome,
  UserInputBoundary
}
import v4.std.node {
  Arrow,
  Atom,
  Bind,
  ComputationNode,
  Conj,
  Edge,
  EdgeLabel,
  Node,
  Symbol,
  TypeNode,
  node_well_formed
}


// ResolvedTree is the same Node tree after the B-4 binding pass. The
// forward binding carrier is the canonical Symbol inside each Atom.
type ResolvedTree = Node


data resolve_reason_malformed_tree: Symbol = resolve_reason_malformed_tree
data resolve_reason_unbound_symbol: Symbol = resolve_reason_unbound_symbol


// Namespace is the explicit binding authority for this stage: use-site
// Symbol -> canonical declaration Symbol (B-4). `bindings` is the **wave-1
// flat union** built by `gather_bindings_walk` (module exports, Arrow-domain
// formals, Bind Atom patterns — one map, no lexical stack yet).
// `canonical_symbols` lists extern symbols that are already
// canonical without a map entry (imports / std — module-loading TBD).
type Namespace {
  bindings: Map<Symbol, Symbol>
  canonical_symbols: Set<Symbol>
}


type Scope {
  namespace: Namespace
}


type ResolveResult
  = ResolvedNode { node: Node }
  | ResolveRejected { diagnostic: Diagnostic }


type ResolveChildrenResult
  = ResolvedChildren { children: List<Edge> }
  | ResolveChildrenRejected { diagnostic: Diagnostic }


fn empty_scope() -> Scope {
  Scope {
    namespace: empty_namespace()
  }
}


fn empty_namespace() -> Namespace {
  Namespace {
    bindings: empty_map(),
    canonical_symbols: empty_canonical_symbol_set()
  }
}


fn empty_canonical_symbol_set() -> Set<Symbol> {
  Set {
    member: fn(_) {
      false
    }
  }
}


// Wave-1: each binder maps to itself (identity row). `map_insert` on duplicate
// keys is not separately diagnosed here — same (sym, sym) is idempotent;
// conflicting duplicate binders for one name remain STOP / a later wave.
fn merge_binding_self(m: Map<Symbol, Symbol>, sym: Symbol) -> Map<Symbol, Symbol> {
  map_insert(m, sym, sym)
}


// (M) Module root: Conj children carry declaration Symbols on Named edges.
fn add_module_named_exports(root: Node, acc: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  match root.kind {
    TypeNode { connective: Conj } =>
      fold(root.children, init: acc, f: fn(acc2, e) {
        match e.label {
          Named { name: decl } => merge_binding_self(m: acc2, sym: decl)
          Positional => acc2
        }
      })
    _ => acc
  }
}


// (P) fn / Pi domain: first Arrow child is a Conj of formal parameters.
fn add_arrow_domain_named_params(n: Node, acc: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  match n.kind {
    TypeNode { connective: Arrow } =>
      if count(n.children) >= 1 {
        match first(n.children) {
          Some { value: e0 } =>
            match e0.target.kind {
              TypeNode { connective: Conj } =>
                fold(e0.target.children, init: acc, f: fn(acc2, pe) {
                  match pe.label {
                    Named { name: param } =>
                      merge_binding_self(m: acc2, sym: param)
                    Positional => acc2
                  }
                })
              _ => acc
            }
          None => acc
        }
      } else {
        acc
      }
    _ => acc
  }
}


// (B) let-bind: Bind arity-3 with Atom pattern in slot 0.
fn add_bind_atom_binder(n: Node, acc: Map<Symbol, Symbol>) -> Map<Symbol, Symbol> {
  match n.kind {
    ComputationNode { behavior: Bind } =>
      if count(n.children) == 3 {
        match first(n.children) {
          Some { value: e0 } =>
            match e0.target.kind {
              TypeNode { connective: Atom { identity: b } } =>
                merge_binding_self(m: acc, sym: b)
              _ => acc
            }
          None => acc
        }
      } else {
        acc
      }
    _ => acc
  }
}


// Pre-order union of (M)/(P)/(B) binders into one flat table — matches the
// single `Scope` passed through `resolve_node` (no push/pop per subtree yet).
fn gather_bindings_walk(n: Node, acc: Map<Symbol, Symbol>, is_root: Bool) -> Map<Symbol, Symbol> {
  let acc = if is_root {
    add_module_named_exports(root: n, acc: acc)
  } else {
    acc
  }
  let acc = add_arrow_domain_named_params(n: n, acc: acc)
  let acc = add_bind_atom_binder(n: n, acc: acc)
  fold(n.children, init: acc, f: fn(acc2, e) {
    gather_bindings_walk(n: e.target, acc: acc2, is_root: false)
  })
}


fn build_program_namespace(tree: NormalizedTree) -> Namespace {
  Namespace {
    bindings: gather_bindings_walk(n: tree, acc: empty_map(), is_root: true),
    canonical_symbols: empty_canonical_symbol_set()
  }
}


fn scope_from_namespace(namespace: Namespace) -> Scope {
  Scope { namespace: namespace }
}


fn malformed_tree_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: resolve_reason_malformed_tree,
    at: NodeLocus { node: n },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}


fn unbound_symbol_diagnostic(n: Node) -> Diagnostic {
  Diagnostic {
    reason: resolve_reason_unbound_symbol,
    at: NodeLocus { node: n },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn lookup_binding(scope: Scope, name: Symbol) -> Symbol? {
  map_get(scope.namespace.bindings, name)
}


fn namespace_has_canonical_symbol(namespace: Namespace, name: Symbol) -> Bool {
  namespace.canonical_symbols.member(name)
}


fn canonical_atom(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: []
  }
}


fn resolve_atom(n: Node, scope: Scope, identity: Symbol) -> ResolveResult {
  match lookup_binding(scope: scope, name: identity) {
    Some { value: canonical } =>
      ResolvedNode {
        node: canonical_atom(identity: canonical)
      }
    None =>
      if namespace_has_canonical_symbol(namespace: scope.namespace, name: identity) {
        ResolvedNode { node: canonical_atom(identity: identity) }
      } else {
        ResolveRejected { diagnostic: unbound_symbol_diagnostic(n: n) }
      }
  }
}


fn resolve_node(n: Node, scope: Scope) -> ResolveResult {
  let resolved_children_result = match n.kind {
    TypeNode { connective: Atom { identity: _ } } =>
      ResolvedChildren { children: [] }
    TypeNode { connective: _ } =>
      fold(n.children, init: ResolvedChildren { children: [] }, f: fn(acc, e) {
        match acc {
          ResolveChildrenRejected { diagnostic: d } =>
            ResolveChildrenRejected { diagnostic: d }
          ResolvedChildren { children: done } =>
            match resolve_node(n: e.target, scope: scope) {
              ResolveRejected { diagnostic: d } =>
                ResolveChildrenRejected { diagnostic: d }
              ResolvedNode { node: resolved_target } =>
                ResolvedChildren {
                  children: list_push(done, Edge {
                    label: e.label,
                    target: resolved_target
                  })
                }
            }
        }
      })
    ComputationNode { behavior: _ } =>
      fold(n.children, init: ResolvedChildren { children: [] }, f: fn(acc, e) {
        match acc {
          ResolveChildrenRejected { diagnostic: d } =>
            ResolveChildrenRejected { diagnostic: d }
          ResolvedChildren { children: done } =>
            match resolve_node(n: e.target, scope: scope) {
              ResolveRejected { diagnostic: d } =>
                ResolveChildrenRejected { diagnostic: d }
              ResolvedNode { node: resolved_target } =>
                ResolvedChildren {
                  children: list_push(done, Edge {
                    label: e.label,
                    target: resolved_target
                  })
                }
            }
        }
      })
  }
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      resolve_atom(n: n, scope: scope, identity: id)
    TypeNode { connective: _ } =>
      match resolved_children_result {
        ResolveChildrenRejected { diagnostic: d } => ResolveRejected { diagnostic: d }
        ResolvedChildren { children: resolved_children } =>
          ResolvedNode {
            node: Node {
              kind: n.kind,
              children: resolved_children
            }
          }
      }
    ComputationNode { behavior: _ } =>
      match resolved_children_result {
        ResolveChildrenRejected { diagnostic: d } => ResolveRejected { diagnostic: d }
        ResolvedChildren { children: resolved_children } =>
          ResolvedNode {
            node: Node {
              kind: n.kind,
              children: resolved_children
            }
          }
      }
  }
}


fn resolve(tree: NormalizedTree) -> Outcome<ResolvedTree> {
  resolve_with_namespace(
    tree: tree,
    namespace: build_program_namespace(tree: tree)
  )
}


fn resolve_with_namespace(tree: NormalizedTree, namespace: Namespace) -> Outcome<ResolvedTree> {
  if node_well_formed(n: tree) {
    match resolve_node(n: tree, scope: scope_from_namespace(namespace: namespace)) {
      ResolveRejected { diagnostic: d } => Rejected { diagnostic: d }
      ResolvedNode { node: resolved } => Produced { value: resolved }
    }
  } else {
    Rejected { diagnostic: malformed_tree_diagnostic(n: tree) }
  }
}
