// src/v4/compiler/self_host.dag
// Scope: self-host fixed-point validation runner shape; body is scaffolded fail-closed until execution substrate and candidate generation land.
// Status: scaffold-against-contract; runner body returns SelfHostRunnerNotRealized.

module v4.compiler.self_host

import v4.std.collection { List }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  node_locus,
  Outcome,
  port_locus,
  Rejected,
  Unavailable,
  diagnostics_singleton
}
import v4.std.node { Node, Symbol }
import v4.std.witness {
  Violates,
  Witness
}


type CoreNode = Node


type SourceModels {
  model_corpus: List<Node>
}


type StructurallyEqual {
  left: Node
  right: Node
}


type BootstrapRoundtripEqual {
  produced_stage: Node
  expected_stage: Node
}


type FixedPointEqual {
  emitted_stage: Node
  reference_stage: Node
}


// 🟡 witness-body scaffold — feature:self-host-stage-emission-equality · consumer:self-host-runner · dissolve-on: future runner consumes find_witness/coercion exact structural-equality witness.
type StageEmissionEquality = Witness<StructurallyEqual>


type BootstrapRoundtripCheck = Witness<BootstrapRoundtripEqual>


type FixedPointCheck = Witness<FixedPointEqual>


type PromotionWitness {
  candidate_bootstrap_roundtrip_sub_check: BootstrapRoundtripCheck
  candidate_fixed_point_sub_check: FixedPointCheck
}


data self_host_runner_not_realized: Symbol = self_host_runner_not_realized
data self_host_runner_port: Symbol = self_host_runner_port
data stage_emission_equality_not_realized: Symbol = stage_emission_equality_not_realized
data bootstrap_roundtrip_not_realized: Symbol = bootstrap_roundtrip_not_realized
data fixed_point_not_realized: Symbol = fixed_point_not_realized


fn self_host_runner_not_realized_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: self_host_runner_not_realized,
    at: port_locus(port: self_host_runner_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// 🟡 scaffold shape — all sub-checks return Violates; not yet called from self_host_fixed_point_validate
// (the main entry point returns fail-closed directly until execution substrate lands).
fn candidate_promotion_witness(
  stage1_candidate: Node,
  reference_stage1: Node
) -> PromotionWitness {
  PromotionWitness {
    candidate_bootstrap_roundtrip_sub_check: bootstrap_roundtrip_scaffold(
      produced_stage: stage1_candidate,
      expected_stage: reference_stage1
    ),
    candidate_fixed_point_sub_check: fixed_point_scaffold(
      emitted_stage: stage1_candidate,
      reference_stage: reference_stage1
    )
  }
}


fn bootstrap_roundtrip_scaffold(
  produced_stage: Node,
  expected_stage: Node
) -> BootstrapRoundtripCheck {
  Violates {
    diagnostic: Diagnostic {
      reason: bootstrap_roundtrip_not_realized,
      at: node_locus(node: expected_stage),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}


fn fixed_point_scaffold(
  emitted_stage: Node,
  reference_stage: Node
) -> FixedPointCheck {
  Violates {
    diagnostic: Diagnostic {
      reason: fixed_point_not_realized,
      at: node_locus(node: reference_stage),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}


fn stage_emission_equality_scaffold(
  emitted_candidate: Node,
  reference_stage1: Node
) -> StageEmissionEquality {
  Violates {
    diagnostic: Diagnostic {
      reason: stage_emission_equality_not_realized,
      at: node_locus(node: reference_stage1),
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  }
}


fn self_host_fixed_point_validate(
  stage1_candidate: Node,
  source_models: SourceModels,
  reference_stage1: Node
) -> Outcome<PromotionWitness> {
  Rejected {
    diagnostics: diagnostics_singleton(d: self_host_runner_not_realized_diagnostic())
  }
}
