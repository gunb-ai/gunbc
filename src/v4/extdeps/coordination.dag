// src/v4/extdeps/coordination.dag
// Scope: Multi-program coordination as effect-typed Bind composition.
// Owns: NetworkAddress, LanguageRef, FrameworkRef, FrameworkBinding, EndpointRef, Endpoint, SettleBound, ConvergeBound, ExchangePattern, SettlementGuarantee, ConsistencyGuarantee, CoordinationEffectKind, BindRef, CoordinationBind, WireContractFacts, WireContract, DeploymentUnit.
// Consumes: std/node.dag, std/collection.dag, std/nat.dag.
// Status: Modeled with tracked scaffolds.

module v4.extdeps.coordination

import v4.std.collection { List }
import v4.std.nat { Nat }
import v4.std.node { Symbol }

// Anchor: RFC 3986, January 2005, https://www.rfc-editor.org/rfc/rfc3986
type NetworkAddress {
  identity: Symbol
}

type LanguageRef {
  identity: Symbol
}

type FrameworkRef {
  identity: Symbol
}

// 🟢 coproduct dissolution — DECISIONS.md#coordination-coproduct-ledgers
type FrameworkBinding
  = HostedByFramework { framework: FrameworkRef }
  | NoFramework

type EndpointRef {
  identity: Symbol
}

type Endpoint {
  identity: EndpointRef,
  address: NetworkAddress,
  language: LanguageRef,
  framework: FrameworkBinding
}

type SettleBound {
  steps: Nat
}

type ConvergeBound {
  steps: Nat
}

// Anchor: https://en.wikipedia.org/wiki/Messaging_pattern
// 🟢 coproduct dissolution — DECISIONS.md#coordination-coproduct-ledgers
type ExchangePattern
  = RequestReply
  | FireAndForget
  | StreamExchange
  | PublishSubscribe

// 🟢 coproduct dissolution — DECISIONS.md#coordination-coproduct-ledgers
type SettlementGuarantee
  = ImmediateSettlement
  | SettlesWithin { bound: SettleBound }

// Anchor: https://en.wikipedia.org/wiki/Eventual_consistency
// 🟢 coproduct dissolution — DECISIONS.md#coordination-coproduct-ledgers
type ConsistencyGuarantee
  = NoReplicaConvergence
  | EventuallyConsistent { bound: ConvergeBound }

// 🟡 coproduct dissolution — DECISIONS.md#coordination-coproduct-ledgers
type CoordinationEffectKind
  = Http
  | Queue
  | Stream
  | PubSub

// coincides: src/v4/std/node.dag A1/K-1, operator-ratified 2026-05-15.
type BindRef {
  identity: Symbol
}

type CoordinationBind {
  bind: BindRef,
  effect: CoordinationEffectKind
}

type WireContractFacts {
  from: EndpointRef,
  to: EndpointRef,
  exchange: ExchangePattern,
  settlement: SettlementGuarantee,
  consistency: ConsistencyGuarantee
}

// Anchor: https://en.wikipedia.org/wiki/Inter-process_communication
type WireContract {
  facts: WireContractFacts,
  bind: CoordinationBind
}

// Anchor: https://en.wikipedia.org/wiki/Distributed_computing
type DeploymentUnit {
  endpoints: List<Endpoint>,
  wire_contracts: List<WireContract>
}
