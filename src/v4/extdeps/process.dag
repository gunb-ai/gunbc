// src/v4/extdeps/process.dag
// Scope: process substrate — command invocation, lifecycle, wait/capture.
// Owns: ProcessId, ExitCode, SignalNum, PosixArgument, PosixEnvironmentName, PosixEnvironmentValue, Command, Termination, TerminatedProcessState, ProcessIdentity, RunningProcess, TerminatedProcess, WaitedTerminatedProcess, CaptureSource, ProcessTable, CapturedByteStream, CapturedOutputPipes, process request/result/operation carriers.
// Consumes: AbsolutePath, Filesystem, PosixByteString, Diagnostic, Outcome, Byte, FreeMonoid, Int, List, Map.
// Status: T-4.5 modeled 2026-05-16.

module v4.extdeps.process


import v4.extdeps.file_system { AbsolutePath, Filesystem, PosixByteString }
import v4.std.algebra { FreeMonoid }
import v4.std.diagnostic { Outcome }
import v4.std.machine { Byte }


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/sys_types.h.html + https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/signal.h.html
// scaffold: POSIX numeric refinements; trigger T-25-core/T-30.
type ProcessId = Int
type ExitCode = Int
type SignalNum = Int


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/exec.html
// tag: POSIX exec byte strings.
// scaffold: POSIX exec byte refinements; trigger T-25-core/T-30.
type PosixArgument {
  bytes: PosixByteString
}

type PosixEnvironmentName {
  bytes: PosixByteString
}

type PosixEnvironmentValue {
  bytes: PosixByteString
}

type Command {
  program: AbsolutePath
  argv0: PosixArgument
  args: List<PosixArgument>
  env: Map<PosixEnvironmentName, PosixEnvironmentValue>
}


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/waitpid.html + https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/sys_wait.h.html
type Termination
  = Exited { code: ExitCode }
  | Signaled { signal: SignalNum }

type TerminatedProcessState {
  termination: Termination
}


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/fork.html
type ProcessIdentity {
  id: ProcessId
  command: Command
  parent: ProcessId
}

type RunningProcess {
  identity: ProcessIdentity
  output: CapturedOutputPipes
}

type TerminatedProcess {
  identity: ProcessIdentity
  state: TerminatedProcessState
}

type WaitedTerminatedProcess {
  identity: ProcessIdentity
  state: TerminatedProcessState
  output: CapturedOutputPipes
}

type CaptureSource
  = Live { spawned: SpawnedProcess }
  | Waited { waited: WaitedProcess }


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/fork.html + https://pubs.opengroup.org/onlinepubs/9799919799/functions/exec.html + https://pubs.opengroup.org/onlinepubs/9799919799/functions/waitpid.html
type ProcessTable

// coincides: finite POSIX pipe byte sequence.
type CapturedByteStream = FreeMonoid<Byte>

type CapturedOutputPipes

type SpawnProcessRequest {
  table: ProcessTable
  filesystem: Filesystem
  command: Command
}

type SpawnedProcess {
  table: ProcessTable
  process: RunningProcess
}

type SpawnProcessResult = Outcome<SpawnedProcess>

type WaitProcessRequest {
  spawned: SpawnedProcess
}

type WaitedProcess {
  table: ProcessTable
  process: WaitedTerminatedProcess
}

type WaitProcessResult = Outcome<WaitedProcess>

type CapturedProcessOutput {
  stdout: CapturedByteStream
  stderr: CapturedByteStream
  table: ProcessTable
  process: TerminatedProcess
}

type CaptureProcessRequest {
  source: CaptureSource
}

type CaptureProcessResult = Outcome<CapturedProcessOutput>

type ProcessOperations {
  spawn: fn(SpawnProcessRequest) -> SpawnProcessResult
  wait: fn(WaitProcessRequest) -> WaitProcessResult
  capture: fn(CaptureProcessRequest) -> CaptureProcessResult
}
