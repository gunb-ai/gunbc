// src/v4/extdeps/frameworks/react.dag
//
// Scope: React framework substrate — Component model, Hook semantics, Effect lifecycle.
// Anchor: https://react.dev/reference/react (React official docs) + https://react.dev/learn (mental model)
//
// Owns:
//   - Component { props, state, render: () -> Node }
//   - Hook { kind: HookKind, dependencies: List<Node> }
//   - HookKind = UseState | UseEffect | UseMemo | UseRef | UseContext | ... (closed enum)
//   - ComponentEffect { trigger: EffectTrigger, body: Behavior }
//   - EffectTrigger = Mount | Unmount | DependencyChange | EveryRender (closed enum)
//   - Rules-of-Hooks discipline (lens-checkable: no Hooks in conditionals)
//
// Consumes:
//   - std/node.dag, std/diagnostic.dag
//   - extdeps/languages/typescript.dag (React is hosted in TS)
//
// Status: scaffold — fill per TASKS.md T-4.6
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).

module v4.extdeps.frameworks.react

