// src/v4/extdeps/frameworks/react.dag
// Scope: React 19.2 framework extdeps — components, elements, props, hooks, context, cross-decl refs, optional refs, dependency-array and cleanup sites.
// Owns: ReactCrossDeclRef, ReactOptRef, ReactEffectCleanupSite, ReactHookInlineDependenciesArgument, ReactModuleSurface, ReactHookSite, ReactUseCallSite, ReactPropsSite, ReactFunctionComponent, ReactHostElement, ReactCompositeElement, ReactElement, ReactNode, ReactContextBinding
// Consumes: v4.std.collection.List, v4.std.diagnostic.Outcome
// Status: T-4.7

module v4.extdeps.frameworks.react

// Anchor: https://react.dev/learn/referencing-values-with-refs
// 🟡 authority fork — DECISIONS.md#react-p4-cross-decl-ref
type ReactCrossDeclRef

// Anchor: https://react.dev/reference/react/useEffect
// 🟢 coproduct dissolution — DECISIONS.md#react-p4-optref
type ReactOptRef
  = RefPresent { ref: ReactCrossDeclRef }
  | RefAbsent

// Anchor: https://react.dev/reference/react/useEffect
// 🟢 coproduct dissolution — DECISIONS.md#react-p4-effect-cleanup-site
type ReactEffectCleanupSite
  = NoCleanup
  | CleanupBody { cleanup_body_ref: ReactCrossDeclRef }

// Anchor: https://react.dev/reference/react/useEffect
// 🟢 coproduct dissolution — DECISIONS.md#react-p4-hook-inline-deps
type ReactHookInlineDependenciesArgument
  = DependenciesArgOmitted
  | DependenciesArgPresent { dependency_refs: List<ReactCrossDeclRef> }

// Anchor: https://react.dev/reference/rsc/server-components
// 🟢 coproduct dissolution — DECISIONS.md#react-p4-module-surface
type ReactModuleSurface
  = ReactClientModule
  | ReactServerComponentsModule

// Anchor: https://react.dev/reference/react/hooks
// 🟡 coproduct dissolution — DECISIONS.md#react-p4-hook-site
type ReactHookSite
  = UseState { initial_ref: ReactCrossDeclRef }
  | UseReducer {
      reducer_ref: ReactCrossDeclRef
      initial_arg_ref: ReactCrossDeclRef
      init: ReactOptRef
    }
  | UseContext { context_ref: ReactCrossDeclRef }
  | UseRef { initial_ref: ReactCrossDeclRef }
  | UseImperativeHandle {
      ref_target: ReactCrossDeclRef
      factory_ref: ReactCrossDeclRef
      dependencies: ReactHookInlineDependenciesArgument
    }
  | UseEffect {
      setup_ref: ReactCrossDeclRef
      dependencies: ReactHookInlineDependenciesArgument
      cleanup: ReactEffectCleanupSite
    }
  | UseLayoutEffect {
      setup_ref: ReactCrossDeclRef
      dependencies: ReactHookInlineDependenciesArgument
      cleanup: ReactEffectCleanupSite
    }
  | UseInsertionEffect {
      setup_ref: ReactCrossDeclRef
      dependencies: ReactHookInlineDependenciesArgument
      cleanup: ReactEffectCleanupSite
    }
  | UseEffectEvent { callback_ref: ReactCrossDeclRef }
  | UseMemo {
      factory_ref: ReactCrossDeclRef
      dependencies: List<ReactCrossDeclRef>
    }
  | UseCallback {
      callback_ref: ReactCrossDeclRef
      dependencies: List<ReactCrossDeclRef>
    }
  | UseTransition
  | UseDeferredValue {
      value_ref: ReactCrossDeclRef
      initial_value: ReactOptRef
    }
  | UseId
  | UseSyncExternalStore {
      subscribe_ref: ReactCrossDeclRef
      get_snapshot_ref: ReactCrossDeclRef
      get_server_snapshot: ReactOptRef
    }
  | UseDebugValue { value_ref: ReactCrossDeclRef, format: ReactOptRef }
  | UseActionState {
      action_ref: ReactCrossDeclRef
      initial_state_ref: ReactCrossDeclRef
      permalink: ReactOptRef
    }
  | UseOptimistic { value_ref: ReactCrossDeclRef, reducer: ReactOptRef }
  | CustomHook { implementation_ref: ReactCrossDeclRef }

// Anchor: https://react.dev/reference/react/use
type ReactUseCallSite
  = UseResource { resource_ref: ReactCrossDeclRef }

// Anchor: https://react.dev/reference/react/createElement
type ReactPropsSite {
  props_type_ref: ReactCrossDeclRef
  props_value_ref: ReactCrossDeclRef
}

// Anchor: https://react.dev/reference/react/components
type ReactFunctionComponent {
  surface: ReactModuleSurface
  props: ReactPropsSite
  render_root_ref: ReactCrossDeclRef
}

// Anchor: https://react.dev/reference/react-dom/components
type ReactHostElement {
  tag_ref: ReactCrossDeclRef
  key: ReactOptRef
  ref: ReactOptRef
  props: ReactPropsSite
  child_refs: List<ReactCrossDeclRef>
}

// Anchor: https://react.dev/reference/react/createElement
type ReactCompositeElement {
  component_ref: ReactCrossDeclRef
  key: ReactOptRef
  ref: ReactOptRef
  props: ReactPropsSite
  child_refs: List<ReactCrossDeclRef>
}

// Anchor: https://react.dev/reference/react/createElement
// 🟢 coproduct dissolution — DECISIONS.md#react-p4-element
type ReactElement
  = Host { host: ReactHostElement }
  | Composite { composite: ReactCompositeElement }
  | Fragment { key: ReactOptRef, child_refs: List<ReactCrossDeclRef> }

// Anchor: https://react.dev/reference/react/createElement
// 🟡 coproduct dissolution — DECISIONS.md#react-p4-node
type ReactNode
  = Element { element: ReactElement }
  | Text { text_value_ref: ReactCrossDeclRef }

// Anchor: https://react.dev/reference/react/createContext
type ReactContextBinding {
  context_pair_ref: ReactCrossDeclRef
  default_value_ref: ReactCrossDeclRef
}
