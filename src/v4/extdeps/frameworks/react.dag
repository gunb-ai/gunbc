// src/v4/extdeps/frameworks/react.dag
//
// Scope: React framework substrate — module surface, function components,
//         elements (host + composite), props sites, ordered child refs,
//         context bindings, hook call sites — all declarative.
// Anchor: React **19.2.0** (npm `react@19.2.0`) — release authority
//   https://github.com/facebook/react/releases/tag/v19.2.0 . Rolling API index
//   https://react.dev/reference/react (partition + hook list C1-tracked against
//   the semver pin; site-only drift without a matching pin edit = STOP).
// Anchor: composition mental model — https://react.dev/learn
// Unifies: (per THESIS:188) framework spec = transport spec = interpreter
//         runtime where applicable. ONE substrate carrier set per React slice;
//         emit / ingest / eval read distinct facts from the same declarations —
//         extend THIS file, not parallel "emit-only" mirrors.
//
// R4 alignment (design-r4-full-stack-omni-emission-canvas.md §4 Q2):
//   - Hook call sites are **per-arm** `ReactHookSite` variants — each arm carries
//     only the call-signature facts for that hook (deps / cleanup / refs live on
//     the arms that admit them per react.dev), NOT a flat built-in tag + uniform
//     `dependency_refs` on every hook (codex canvas:76 — avoids UseState carrying
//     dependency slots it does not have).
//   - **No** standalone lifecycle / “effect trigger” coproduct: mount / update /
//     unmount / cleanup-only obligations are read from `UseEffect` /
//     `UseLayoutEffect` / `UseInsertionEffect` arm payloads (`dependency_refs`,
//     `NoEffectBody` vs `EffectBody`, `NoCleanup` vs `CleanupBody`) per §4
//     dissolution receipt — INVARIANTS P1/P2 (anti-pattern §11 #12).
//   - `CustomHook` + R4‑Phase‑1.5 Practice‑4 canvas:
//     docs/design-r4-phase-1-5-hookkind-custom-react-substrate-canvas.md
//
// Owns:
//   - ReactModuleSurface (client vs React Server Components module capability)
//   - ReactFunctionComponent (surface + props + `render_root_ref` declaration edge)
//   - ReactCrossDeclRef (opaque cross-declaration edge — v4-local; same epistemic
//     role as `std/node.dag::Symbol` / `v3.spec.v3_l1::DeclarationRef`, but defined
//     HERE so single-file `compile_to_dag` smoke and `v2-compiler`’s `src/v4`-only
//     stage1 closure both succeed without forbidden `v3.*` imports or unresolved
//     `v4.std.node` merge under M1(2.7) import no-op — bundle time aligns carriers.)
//   - ReactPropsSite (props type + value sites — `ReactCrossDeclRef` edges)
//   - ReactHostElement / ReactCompositeElement / ReactElement (host + composite +
//     fragment + text partition)
//   - ReactContextBinding (`createContext` site identity)
//   - ReactHookSite — closed hook **call-site** coproduct under the react@19.2.0 pin
//     + `CustomHook` (🟡 YELLOW Practice‑4 carrier per design-r4 §12 HookKind; canvas
//     in-repo — dissolution trigger = new built-in at pin bump; see block ledger)
//   - ReactHookInlineDependenciesArgument (omit vs present `dependencies` / deps
//     array — react.dev `useEffect` fidelity; empty `Present` list = explicit `[]`)
//
// Consumes (traceability):
//   - std/collection.dag: List<T> (kernel-ambient `List` needs no import for use;
//     listed for single-authority traceability to FreeMonoid modeling)
//   - std/diagnostic.dag: Outcome<T> (D1 / DECISIONS.md **I**) — commentary only
//
// Owned ELSEWHERE: JSX/TSX grammar, portals, Suspense, class components, Next.js
// directives, per-hook algebra inhabitance, GroundingMap home, parse→Outcome ops.
//
// Status: T-4.7 forward-modeled (mgr brief DOC-ANCHOR + A1 + Practice-4).
// Brief: BRIEF_TEMPLATE.md; splitting = operator ratification.


module v4.extdeps.frameworks.react


// ═════════════════════════════════════════════════════════════════════
// ReactCrossDeclRef
//
// Opaque cross-declaration identity for every `*_ref` / `*_refs` field in this
// module. Body-less like `std/node.dag::Symbol` (K-1); declared locally because
// `v2-compiler` indexes `src/v4` without `v3.*`, and isolated `compile_to_dag`
// does not yet merge `import v4.std.node { Symbol }` (M1(2.7) — see TASKS / M1
// substrate notes). Downstream bundling aligns `ReactCrossDeclRef` with the
// single-authority K-1 / L1 carrier at link time.
type ReactCrossDeclRef


// ═════════════════════════════════════════════════════════════════════
// ReactOptRef
//
// Optional operand at a hook call site (e.g. optional `getServerSnapshot`,
// optional `useDebugValue` formatter, optional `useActionState` permalink) —
// NOT a second program spine; encodes arity holes in the pinned API surface.
type ReactOptRef
  = RefPresent { ref: ReactCrossDeclRef }
  | RefAbsent


// ═════════════════════════════════════════════════════════════════════
// ReactOptionalEffectBody
//
// `useEffect` / `useLayoutEffect` / `useInsertionEffect` may be cleanup-only
// (design-r4 §4: body absent, cleanup present ⇒ unmount-style obligation reads
// off the arm — not a parallel `OnUnmount` sum).
type ReactOptionalEffectBody
  = EffectBody { effect_body_ref: ReactCrossDeclRef }
  | NoEffectBody


// ═════════════════════════════════════════════════════════════════════
// ReactEffectCleanupSite
//
// Cleanup function edge, or explicit absence (deps-only / mount-only body).
type ReactEffectCleanupSite
  = NoCleanup
  | CleanupBody { cleanup_body_ref: ReactCrossDeclRef }


// ─────────────────────────────────────────────────────────────────────
// Modeling notes
//
// A1 / ordered children + dependency lists. `List<ReactCrossDeclRef>` on each arm
// is the ordered **dependency-array** identity spine where that hook admits deps.
//
// Program-shaped sites use `ReactCrossDeclRef` for declarations whose bodies lower
// to the `Node` tree in the full bundle — not a second recursive program type here.
//
// D1. Future `parse_* -> Outcome<…>` seams reference `v4.std.diagnostic.Outcome<T>`;
// no operation rows here (DECLARATIVE-NOW).


// ═════════════════════════════════════════════════════════════════════
// ReactModuleSurface
// Anchor: https://react.dev/reference/rsc/server-components +
//         https://react.dev/reference/react/use-client
//
// Coproduct dissolution (Practice 4) — 🟢 GREEN (terminal). Ledger — five patterns:
//   1. Fact placement — FAILS: shared surface tag for coordination + emit.
//   2. Variant-is-data — FAILS: Bool proxy admits illegal merged server∧client.
//   3. Algebraic form — N/A: epistemic boundary, not algebra.
//   4. Dimensional — FAILS: exactly one module-surface tag per authority here.
//   5. Parameterized family — FAILS: not Practice-7 mechanical copy over a set.
// Terminal: closed binary React-19 module-capability partition.
type ReactModuleSurface
  = ReactClientModule
  | ReactServerComponentsModule


// ═════════════════════════════════════════════════════════════════════
// ReactHookSite
// Anchor: https://react.dev/reference/react/hooks — built-in Hooks index (pin
//         tracks https://github.com/facebook/react/releases/tag/v19.2.0 ).
// Anchor: https://react.dev/reference/react/use — `use(resource)` (`use` API).
// Anchor: https://react.dev/reference/rules/rules-of-hooks
// Canvas: docs/design-r4-phase-1-5-hookkind-custom-react-substrate-canvas.md
//
// Coproduct dissolution (Practice 4) — 🟡 YELLOW (R4-Phase‑1.5 carrier; **not** 🟢
// terminal). **Authority:** `docs/design-r4-full-stack-omni-emission-canvas.md` §12
// ratifies **Practice 4 HookKind** as **🟡 YELLOW** — pinned closed built-in roster
// + `CustomHook` boundary + mandatory Practice‑4‑promotion canvas (this file:
// `docs/design-r4-phase-1-5-hookkind-custom-react-substrate-canvas.md`); **dissolution
// trigger** = React **semver pin / hooks-index** edit when react.dev adds a new
// built-in (re‑ratify `ReactHookSite` arms on that PR). **Already dissolved here
// (structural facts, §4 Q2 / canvas:76):** per-arm call signatures (no uniform
// effect lifecycle only on `UseEffect` / `UseLayoutEffect` /
// `UseInsertionEffect` payloads — no parallel lifecycle sum. Ledger — five patterns:
//   1. Fact placement — FAILS: shared hook-site tag for resolver/emit.
//   2. Variant-is-data — FAILS: Int hook_id admits illegal values (P2).
//   3. Algebraic form — PARTIAL: per-hook algebras live std/ elsewhere.
//   4. Dimensional — FAILS: exactly one hook arm per call site.
//   5. Parameterized family — FAILS: not `F<X>` Practice-7 over a width set.
// Closed **under the pin**: twenty-way `react@19.2.0` **call-site** partition —
// nineteen stable exports from the hooks index + `use` API + `CustomHook` boundary
// arm (P1 names track react.dev; effect lifecycle is carried ONLY on the three
// effect arms).
type ReactHookSite
  = UseState { initial_ref: ReactCrossDeclRef }
  // Anchor: https://react.dev/reference/react/useReducer — `useReducer(reducer,
  //         initialArg, init?)`; optional third operand is the initializer fn.
  | UseReducer {
      reducer_ref: ReactCrossDeclRef
      initial_arg_ref: ReactCrossDeclRef
      init: ReactOptRef
    }
  | UseContext { context_ref: ReactCrossDeclRef }
  | UseRef { initial_ref: ReactCrossDeclRef }
  | UseImperativeHandle {
      ref_target: ReactCrossDeclRef
      factory_ref: ReactCrossDeclRef
      dependency_refs: List<ReactCrossDeclRef>
    }
  // Anchor: https://react.dev/reference/react/useEffect — deps + cleanup on-arm.
  | UseEffect {
      body: ReactOptionalEffectBody
      dependency_refs: List<ReactCrossDeclRef>
      cleanup: ReactEffectCleanupSite
    }
  // Anchor: https://react.dev/reference/react/useLayoutEffect
  | UseLayoutEffect {
      body: ReactOptionalEffectBody
      dependency_refs: List<ReactCrossDeclRef>
      cleanup: ReactEffectCleanupSite
    }
  // Anchor: https://react.dev/reference/react/useInsertionEffect
  | UseInsertionEffect {
      body: ReactOptionalEffectBody
      dependency_refs: List<ReactCrossDeclRef>
      cleanup: ReactEffectCleanupSite
    }
  // Anchor: https://react.dev/reference/react/useEffectEvent — ships **React 19.2**
  //         (https://react.dev/blog/2025/10/01/react-19-2); included because pin ≥19.2.
  | UseEffectEvent { callback_ref: ReactCrossDeclRef }
  | UseMemo { factory_ref: ReactCrossDeclRef, dependency_refs: List<ReactCrossDeclRef> }
  | UseCallback { callback_ref: ReactCrossDeclRef, dependency_refs: List<ReactCrossDeclRef> }
  | UseTransition
  | UseDeferredValue { value_ref: ReactCrossDeclRef }
  | UseId
  | UseSyncExternalStore {
      subscribe_ref: ReactCrossDeclRef
      get_snapshot_ref: ReactCrossDeclRef
      get_server_snapshot: ReactOptRef
    }
  | UseDebugValue { value_ref: ReactCrossDeclRef, format: ReactOptRef }
  | UseActionState {
      action_ref: ReactCrossDeclRef
      initial_state_ref: ReactCrossDeclRef
      permalink: ReactOptRef
    }
  | UseOptimistic { state_ref: ReactCrossDeclRef, update_fn_ref: ReactCrossDeclRef }
  // Anchor: https://react.dev/reference/react/use — `use(resource)`
  | UseResource { resource_ref: ReactCrossDeclRef }
  | CustomHook { implementation_ref: ReactCrossDeclRef }


// ═════════════════════════════════════════════════════════════════════
// ReactPropsSite
// Anchor: https://react.dev/learn/passing-props-to-a-component
type ReactPropsSite {
  props_type_ref: ReactCrossDeclRef
  props_value_ref: ReactCrossDeclRef
}


// ═════════════════════════════════════════════════════════════════════
// ReactFunctionComponent
// Anchor: https://react.dev/reference/react/function-components
type ReactFunctionComponent {
  surface: ReactModuleSurface
  props: ReactPropsSite
  render_root_ref: ReactCrossDeclRef
}


// ═════════════════════════════════════════════════════════════════════
// ReactHostElement
// Anchor: https://react.dev/reference/react-dom/components
type ReactHostElement {
  tag_ref: ReactCrossDeclRef
  props: ReactPropsSite
  child_refs: List<ReactCrossDeclRef>
}


// ═════════════════════════════════════════════════════════════════════
// ReactCompositeElement
// Anchor: https://react.dev/reference/react/createElement
type ReactCompositeElement {
  component_ref: ReactCrossDeclRef
  props: ReactPropsSite
  child_refs: List<ReactCrossDeclRef>
}


// ═════════════════════════════════════════════════════════════════════
// ReactElement
// Anchor: https://react.dev/reference/react/createElement +
//         https://react.dev/reference/react/Fragment +
//         https://react.dev/reference/react-dom/components
//
// Coproduct dissolution (Practice 4) — 🟢 GREEN (terminal). Ledger — five patterns:
//   1. Fact placement — FAILS: reconciler + emit share element-shape tag.
//   2. Variant-is-data — FAILS: flat Int-kind admits impossible unions.
//   3. Algebraic form — PARTIAL: host vs composite share props+children spine.
//   4. Dimensional — FAILS: exactly one element kind at this layer.
//   5. Parameterized family — FAILS: not `Element<Width>` Practice-7 copies.
// Terminal: React reconciler element partition (React 19.2.0 pin).
type ReactElement
  = Host { host: ReactHostElement }
  | Composite { composite: ReactCompositeElement }
  | Fragment { child_refs: List<ReactCrossDeclRef> }
  | Text { text_value_ref: ReactCrossDeclRef }


// ═════════════════════════════════════════════════════════════════════
// ReactContextBinding
// Anchor: https://react.dev/reference/react/createContext +
//         https://react.dev/learn/passing-data-deeply-with-context
type ReactContextBinding {
  context_pair_ref: ReactCrossDeclRef
}
