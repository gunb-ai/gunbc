// src/v4/extdeps/frameworks/react.dag
//
// Scope: React framework substrate — module surface, function components,
//         elements (host + composite), props sites, ordered child refs,
//         context bindings, hook sites, effect scheduling — all declarative.
// Anchor: React **19.1.0** (npm `react@19.1.0`) — release authority
//   https://github.com/facebook/react/releases/tag/v19.1.0 . Rolling API index
//   https://react.dev/reference/react (partition + hook list C1-tracked against
//   the semver pin; site-only drift without a matching pin edit = STOP).
// Anchor: composition mental model — https://react.dev/learn
// Unifies: (per THESIS:188) framework spec = transport spec = interpreter
//         runtime where applicable. ONE substrate carrier set per React slice;
//         emit / ingest / eval read distinct facts from the same declarations —
//         extend THIS file, not parallel "emit-only" mirrors.
//
// Owns:
//   - ReactModuleSurface (client vs React Server Components module capability)
//   - ReactFunctionComponent (surface + props + render root)
//   - ReactPropsSite (props type + value identities — K-1 `Symbol` per STRUCTURE)
//   - ReactHostElement / ReactCompositeElement / ReactElement (host + composite +
//     fragment + text partition)
//   - ReactContextBinding (`createContext` site identity)
//   - ReactHook, ReactHookKind, ReactBuiltinHook (closed hook API partition)
//   - ReactComponentEffect (trigger + effect body **as `Node`** — the kernel’s
//     sole recursive program carrier; grammar lowers TS/JS closures here)
//   - ReactEffectTrigger (closed scheduling-class partition)
//
// Consumes (traceability):
//   - std/node.dag: Node, Symbol, Path (`Path` = ordered `List<Symbol>` carrier
//     from node.dag for child / dependency **sequences** without authoring raw
//     `List<Symbol>` in this module — see modeling notes)
//   - std/diagnostic.dag: Outcome<T> (D1 / DECISIONS.md **I**) — commentary only
//   - extdeps/languages/typescript.dag: props typing (traceability; no import edge)
//
// Owned ELSEWHERE: JSX/TSX grammar, portals, Suspense, class components, Next.js
// directives, per-hook algebra inhabitance, GroundingMap home, parse→Outcome ops.
//
// Status: T-4.7 forward-modeled (mgr brief DOC-ANCHOR + A1 + Practice-4).
// Brief: BRIEF_TEMPLATE.md; splitting = operator ratification.


module v4.extdeps.frameworks.react


import v4.std.node { Node, Symbol, Path }


// ─────────────────────────────────────────────────────────────────────
// Modeling notes
//
// A1 / K-1. Opaque identities use `Symbol`. Ordered sequences of those identities
// reuse `Path` (`steps: List<Symbol>` in std/node.dag): one substrate carrier for
// “ordered list of opaque names”, read by React lenses as **child order** or
// **dependency-list order**, not necessarily as a diff-route through `Node` edges.
//
// `Node` for effect bodies / custom-hook implementation / render root: the
// substrate’s single recursive program carrier — TS/JS surface lowers into these
// trees; this avoids a second parallel recursion.
//
// D1. Future `parse_* -> Outcome<…>` seams reference `v4.std.diagnostic.Outcome<T>`;
// no operation rows here (DECLARATIVE-NOW).


// ═════════════════════════════════════════════════════════════════════
// ReactModuleSurface
// Anchor: https://react.dev/reference/rsc/server-components +
//         https://react.dev/reference/react/use-client
//
// Coproduct dissolution (Practice 4) — 🟢 GREEN (terminal). Ledger — five patterns:
//   1. Fact placement — FAILS: shared surface tag for coordination + emit.
//   2. Variant-is-data — FAILS: Bool proxy admits illegal merged server∧client.
//   3. Algebraic form — N/A: epistemic boundary, not algebra.
//   4. Dimensional — FAILS: exactly one module-surface tag per authority here.
//   5. Parameterized family — FAILS: not Practice-7 mechanical copy over a set.
// Terminal: closed binary React-19 module-capability partition.
type ReactModuleSurface
  = ReactClientModule
  | ReactServerComponentsModule


// ═════════════════════════════════════════════════════════════════════
// ReactBuiltinHook
// Anchor: https://react.dev/reference/react/hooks (index; pin tracks
//         https://github.com/facebook/react/releases/tag/v19.1.0 )
//
// Coproduct dissolution (Practice 4) — 🟢 GREEN (terminal). Ledger — five patterns:
//   1. Fact placement — FAILS: shared hook discriminator for resolver/emit.
//   2. Variant-is-data — FAILS: Int hook_id admits illegal values (P2).
//   3. Algebraic form — PARTIAL: per-hook algebras live std/ elsewhere.
//   4. Dimensional — FAILS: one built-in hook per call site.
//   5. Parameterized family — FAILS: not `F<X>` Practice-7 over a width set.
// Terminal: closed eighteen-way `react@19.1.0` stable hook classifier.
type ReactBuiltinHook
  = ReactUseState
  | ReactUseReducer
  | ReactUseContext
  | ReactUseRef
  | ReactUseImperativeHandle
  | ReactUseEffect
  | ReactUseLayoutEffect
  | ReactUseInsertionEffect
  | ReactUseMemo
  | ReactUseCallback
  | ReactUseTransition
  | ReactUseDeferredValue
  | ReactUseId
  | ReactUseSyncExternalStore
  | ReactUseDebugValue
  | ReactUseActionState
  | ReactUseOptimistic
  | ReactUseApi


// ═════════════════════════════════════════════════════════════════════
// ReactHookKind
// Anchor: https://react.dev/reference/rules/rules-of-hooks
//
// Coproduct dissolution (Practice 4) — 🟢 GREEN (terminal). Ledger — five patterns:
//   1. Fact placement — FAILS: shared built-in vs custom discriminant.
//   2. Variant-is-data — FAILS: Bool+ref admits built-in ∧ custom simultaneously.
//   3. Algebraic form — PARTIAL: custom body is `Node` composition of hooks.
//   4. Dimensional — FAILS: XOR at one site.
//   5. Parameterized family — FAILS: heterogeneous payloads, not uniform `F<X>`.
// Terminal: built-in vs custom-hook partition.
type ReactHookKind
  = BuiltIn { hook: ReactBuiltinHook }
  | Custom { implementation: Node }


// ═════════════════════════════════════════════════════════════════════
// ReactHook
// Anchor: https://react.dev/reference/react/hooks +
//         https://react.dev/reference/react/useEffect#parameters
type ReactHook {
  kind: ReactHookKind
  dependency_value_path: Path
}


// ═════════════════════════════════════════════════════════════════════
// ReactEffectTrigger
// Anchor: https://react.dev/learn/synchronizing-with-effects +
//         https://react.dev/reference/react/useEffect
//
// Coproduct dissolution (Practice 4) — 🟢 GREEN (terminal). Ledger — five patterns:
//   1. Fact placement — FAILS: scheduling consumers read trigger uniformly.
//   2. Variant-is-data — FAILS: Int bitfield admits illegal combinations.
//   3. Algebraic form — N/A: not std/ algebra.
//   4. Dimensional — FAILS: one trigger class per modeled obligation.
//   5. Parameterized family — FAILS: not indexed copy of another enum.
// Terminal: closed four-way trigger partition (TASKS.md T-4.7).
type ReactEffectTrigger
  = Mount
  | Unmount
  | DependencyChange
  | EveryRender


// ═════════════════════════════════════════════════════════════════════
// ReactComponentEffect
// Anchor: https://react.dev/reference/react/useEffect
type ReactComponentEffect {
  trigger: ReactEffectTrigger
  effect_body: Node
}


// ═════════════════════════════════════════════════════════════════════
// ReactPropsSite
// Anchor: https://react.dev/learn/passing-props-to-a-component
type ReactPropsSite {
  props_type_ref: Symbol
  props_value_ref: Symbol
}


// ═════════════════════════════════════════════════════════════════════
// ReactFunctionComponent
// Anchor: https://react.dev/reference/react/function-components
type ReactFunctionComponent {
  surface: ReactModuleSurface
  props: ReactPropsSite
  render_root: Node
}


// ═════════════════════════════════════════════════════════════════════
// ReactHostElement
// Anchor: https://react.dev/reference/react-dom/components
type ReactHostElement {
  tag_ref: Symbol
  props: ReactPropsSite
  children_path: Path
}


// ═════════════════════════════════════════════════════════════════════
// ReactCompositeElement
// Anchor: https://react.dev/reference/react/createElement
type ReactCompositeElement {
  component_ref: Symbol
  props: ReactPropsSite
  children_path: Path
}


// ═════════════════════════════════════════════════════════════════════
// ReactElement
// Anchor: https://react.dev/reference/react/createElement +
//         https://react.dev/reference/react/Fragment +
//         https://react.dev/reference/react-dom/components
//
// Coproduct dissolution (Practice 4) — 🟢 GREEN (terminal). Ledger — five patterns:
//   1. Fact placement — FAILS: reconciler + emit share element-shape tag.
//   2. Variant-is-data — FAILS: flat Int-kind admits impossible unions.
//   3. Algebraic form — PARTIAL: host vs composite share props+children spine.
//   4. Dimensional — FAILS: exactly one element kind at this layer.
//   5. Parameterized family — FAILS: not `Element<Width>` Practice-7 copies.
// Terminal: React reconciler element partition (React 19.1.0 pin).
type ReactElement
  = Host { host: ReactHostElement }
  | Composite { composite: ReactCompositeElement }
  | Fragment { children_path: Path }
  | Text { text_value_ref: Symbol }


// ═════════════════════════════════════════════════════════════════════
// ReactContextBinding
// Anchor: https://react.dev/reference/react/createContext +
//         https://react.dev/learn/passing-data-deeply-with-context
type ReactContextBinding {
  context_pair_ref: Symbol
}
