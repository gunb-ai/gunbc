// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustIntKind
  = Signed
  | Unsigned

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Bits128
  | Pointer

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustFloatWidth
  = Bits32
  | Bits64

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustScalar
  = IntScalar { kind: RustIntKind, width: RustIntWidth }
  | FloatScalar { width: RustFloatWidth }
  | BoolScalar
  | CharScalar
  | StrScalar
  | UnitScalar
  | NeverScalar

type RustIntegerPrimitiveFacts {
  surface_spelling: Symbol
  signedness: RustIntKind
  width: RustIntWidth
  overflow_release: OverflowAction
  std_projection: Symbol
  scalar_classifier: RustScalar
}

type RustFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: RustFloatWidth
  ieee754_binary: Symbol
  std_projection: Symbol
  scalar_classifier: RustScalar
}

type RustNonIntegerPrimitiveFacts {
  surface_spelling: Symbol
  scalar_classifier: RustScalar
  std_projection: Symbol
  representation: Symbol
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustReferenceKind
  = Shared
  | Exclusive

type NamedSegment {
  id: Symbol
}

type PubInPath {
  resolved_path: List<NamedSegment>
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustVisibility
  = Private
  | Pub
  | PubIn { path: PubInPath }

type RustReference {
  kind: RustReferenceKind
  lifetime: Symbol
  referent: Node
}

type RustCost {
  instruction_cost: Int
  allocation_cost: Int
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type OverflowAction
  = PanicOnOverflow
  | TwoComplementWrap

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type OverflowDisposition<IRCarrier>
  = MustPanicOnOverflow
  | MayPanicOrTwoComplementWrap

type RustLanguageModel {
  lex: LexRules
  grammar: Grammar
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
}

