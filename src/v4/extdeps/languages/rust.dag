fn rust_integer_overflow_disposition(kind: RustIntKind, width: RustIntWidth) -> OverflowDisposition<RustIntegerCarrier> {
  OverflowDisposition {
    ir_carrier: RustIntegerCarrier { kind: kind, width: width },
    checked_arithmetic_debug_default: PanicOnOverflow,
    checked_arithmetic_release_default: TwoComplementWrap,
    checked_arithmetic_overflow_checks_enabled: PanicOnOverflow,
    checked_arithmetic_overflow_checks_disabled: TwoComplementWrap
  }
}

// Sole MVP-1 concrete-syntax authority — grammar and serialize_source project from this relation.
fn rust_mvp1_concrete_tokens() -> List<RustConcreteSyntaxToken> {
  [
    RustFixedToken { token_class: rust_token_kw_fn },
    RustBoundToken { token_class: rust_token_ident, binding: rust_binding_fn_add },
    RustFixedToken { token_class: rust_token_lparen },
    RustBoundToken { token_class: rust_token_ident, binding: rust_binding_param_x },
    RustFixedToken { token_class: rust_token_colon },
    RustFixedToken { token_class: rust_token_ty_i32 },
    RustFixedToken { token_class: rust_token_comma },
    RustBoundToken { token_class: rust_token_ident, binding: rust_binding_param_y },
    RustFixedToken { token_class: rust_token_colon },
    RustFixedToken { token_class: rust_token_ty_i32 },
    RustFixedToken { token_class: rust_token_rparen },
    RustFixedToken { token_class: rust_token_arrow },
    RustFixedToken { token_class: rust_token_ty_i32 },
    RustFixedToken { token_class: rust_token_lbrace },
    RustBoundToken { token_class: rust_token_ident, binding: rust_binding_param_x },
    RustFixedToken { token_class: rust_token_plus },
    RustBoundToken { token_class: rust_token_ident, binding: rust_binding_param_y },
    RustFixedToken { token_class: rust_token_rbrace }
  ]
}
data rust_mvp1_source_text: String = "fn add(x: i32, y: i32) -> i32 { x + y }"

