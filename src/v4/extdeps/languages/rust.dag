// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustIntKind
  = Signed
  | Unsigned

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Bits128
  | Pointer

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustFloatWidth
  = Bits32
  | Bits64

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustScalar
  = IntScalar { kind: RustIntKind, width: RustIntWidth }
  | FloatScalar { width: RustFloatWidth }
  | BoolScalar
  | CharScalar
  | StrScalar
  | UnitScalar
  | NeverScalar

type RustIntegerCarrier {
  kind: RustIntKind
  width: RustIntWidth
}

type RustIntegerPrimitiveFacts {
  surface_spelling: Symbol
  overflow_disposition: OverflowDisposition<RustIntegerCarrier>
  std_projection: Symbol
}

type RustFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: RustFloatWidth
  ieee754_binary: Symbol
  std_projection: Symbol
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustNonIntegerScalar
  = BoolScalar
  | CharScalar
  | StrScalar
  | UnitScalar
  | NeverScalar

type RustNonIntegerPrimitiveFacts {
  surface_spelling: Symbol
  scalar: RustNonIntegerScalar
  std_projection: Symbol
  representation: Symbol
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustReferenceKind
  = Shared
  | Exclusive

type NamedSegment {
  id: Symbol
}

type PubInPath {
  resolved_path: List<NamedSegment>
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustVisibility
  = Private
  | Pub
  | PubIn { path: PubInPath }

type RustReference {
  kind: RustReferenceKind
  lifetime: Symbol
  referent: Node
}

type RustCost {
  instruction_cost: Int
  allocation_cost: Int
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type OverflowAction
  = PanicOnOverflow
  | TwoComplementWrap

// Anchor: Rust Reference §Operator expressions / Overflow.
// 🟢 pretty-much-done — checked arithmetic overflow facts include debug defaults and explicit `-C overflow-checks`.
type OverflowDisposition<IRCarrier> {
  ir_carrier: IRCarrier
  checked_arithmetic_debug_default: OverflowAction
  checked_arithmetic_release_default: OverflowAction
  checked_arithmetic_overflow_checks_enabled: OverflowAction
  checked_arithmetic_overflow_checks_disabled: OverflowAction
}

type RustLanguageModel {
  lex: LexRules
  grammar: Grammar
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

// T-11 rust-first grammar relation row: fixed terminals and bound terminals share
// the Rust grammar production instead of an operator string template.
type RustConcreteSyntaxToken
  = RustFixedToken { token_class: Symbol }
  | RustBoundToken { token_class: Symbol, binding: Symbol }

type RustGrammarRelationRow {
  production: GrammarProduction
  emitted: Node
  tokens: List<RustConcreteSyntaxToken>
}

