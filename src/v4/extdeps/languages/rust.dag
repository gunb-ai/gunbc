  rust_noninteger_inhabitant_node(id: rust_inhabitant_unit, facts: rust_facts_unit)
}

fn rust_inhabitant_never_node() -> Node {
  rust_noninteger_inhabitant_node(id: rust_inhabitant_never, facts: rust_facts_never)
}

fn rust_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

// Declared-inhabitant Conj root for `target_model_edge_declared_inhabitants`. T-10 staging
// (`coercion_candidates_from_target_model`) passes this whole Conj as one aggregate
// `CandidateSet.candidates` entry — not a flat List of per-primitive nodes. find_witness
// enumeration inside the root is forward work (W-T-10). Coercion fixture pins i32 via
// `TargetDeclaredPriority` on `rust_inhabitant_i32_node`, not via inhabitants-root walk.
fn rust_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: rust_inhabitant_field_i8, target: rust_inhabitant_i8_node()),
      rust_named_edge(name: rust_inhabitant_field_i16, target: rust_inhabitant_i16_node()),
      rust_named_edge(name: rust_inhabitant_field_i32, target: rust_inhabitant_i32_node()),
      rust_named_edge(name: rust_inhabitant_field_i64, target: rust_inhabitant_i64_node()),
      rust_named_edge(name: rust_inhabitant_field_i128, target: rust_inhabitant_i128_node()),
      rust_named_edge(name: rust_inhabitant_field_u8, target: rust_inhabitant_u8_node()),
      rust_named_edge(name: rust_inhabitant_field_u16, target: rust_inhabitant_u16_node()),
      rust_named_edge(name: rust_inhabitant_field_u32, target: rust_inhabitant_u32_node()),
      rust_named_edge(name: rust_inhabitant_field_u64, target: rust_inhabitant_u64_node()),
      rust_named_edge(name: rust_inhabitant_field_u128, target: rust_inhabitant_u128_node()),
      rust_named_edge(name: rust_inhabitant_field_isize, target: rust_inhabitant_isize_node()),
      rust_named_edge(name: rust_inhabitant_field_usize, target: rust_inhabitant_usize_node()),
      rust_named_edge(name: rust_inhabitant_field_f32, target: rust_inhabitant_f32_node()),
      rust_named_edge(name: rust_inhabitant_field_f64, target: rust_inhabitant_f64_node()),
      rust_named_edge(name: rust_inhabitant_field_bool, target: rust_inhabitant_bool_node()),
      rust_named_edge(name: rust_inhabitant_field_char, target: rust_inhabitant_char_node()),
      rust_named_edge(name: rust_inhabitant_field_str, target: rust_inhabitant_str_node()),
      rust_named_edge(name: rust_inhabitant_field_unit, target: rust_inhabitant_unit_node()),
      rust_named_edge(name: rust_inhabitant_field_never, target: rust_inhabitant_never_node())
    ]
  }
}

fn rust_mvp1_selection_policy_node() -> Node {
  rust_inhabitant_i32_node()
}

fn rust_mvp1_emitted_add_fn_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: rust_inhabitant_i32_node() },
      Edge { label: Positional, target: rust_inhabitant_i32_node() },
      Edge { label: Positional, target: rust_inhabitant_i32_node() }
    ]
  }
}

fn rust_mvp1_source_text_authority() -> String {
  rust_mvp1_source_text
}

// MVP serialize_source — literal symbol + grammar production + token relation (aligned with source text).
// dissolve-on: T-10 literal Node + bidirectional grammar-as-bidir emit/ingest round-trip.
fn rust_concrete_token_class(token: RustConcreteSyntaxToken) -> Symbol {
  match token {
    RustFixedToken { token_class: c } => c
    RustBoundToken { token_class: c, binding: _ } => c
  }
}

fn rust_concrete_token_node(token: RustConcreteSyntaxToken) -> Node {
  match token {
    RustFixedToken { token_class: c } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(
            name: concrete_syntax_token_field_kind,
            target: rust_inhabitant_atom(id: rust_relation_token_fixed)
          ),
          rust_named_edge(
            name: concrete_syntax_token_field_class,
            target: rust_inhabitant_atom(id: c)
          )
        ]
      }
    RustBoundToken { token_class: c, binding: b } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(
            name: concrete_syntax_token_field_kind,
            target: rust_inhabitant_atom(id: rust_relation_token_bound)
          ),
          rust_named_edge(
            name: concrete_syntax_token_field_class,
            target: rust_inhabitant_atom(id: c)
          ),
          rust_named_edge(
            name: concrete_syntax_token_field_binding,
            target: rust_inhabitant_atom(id: b)
          )
        ]
      }
  }
}

fn rust_mvp1_positional_token_edge(token: RustConcreteSyntaxToken) -> Edge {
  Edge {
    label: Positional,
    target: rust_concrete_token_node(token: token)
  }
}

// Order-preserving local wrappers for the Rust slice; std.collection owns the list recursion.
// Compile-time list helpers for fixed MVP-1 length; dissolve-on: T-10 grammar-emitted edge list.
fn rust_list_snoc_item<T>(xs: List<T>, item: T) -> List<T> {
  list_snoc_item(xs: xs, item: item)
}

fn rust_list_append<T>(left: List<T>, right: List<T>) -> List<T> {
  list_append(left: left, right: right)
}

fn rust_mvp1_positional_edges_from_token_classes() -> List<Edge> {
  fold_list(
    xs: rust_mvp1_concrete_tokens(),
    empty: Empty,
    cons: fn(acc, token) {
      rust_list_snoc_item(
        xs: acc,
        item: rust_mvp1_positional_token_edge(token: token)
      )
    }
  )
}

fn rust_mvp1_serialize_source_prefix_edges() -> List<Edge> {
  Cons {
    head: rust_named_edge(
      name: rust_mvp1_source_text_field,
      target: rust_inhabitant_atom(id: rust_mvp1_source_literal)
    ),
    tail: Cons {
      head: rust_named_edge(
        name: rust_mvp1_source_grammar_field,
        target: rust_inhabitant_atom(id: rust_production_mvp1_fn_add)
      ),
      tail: Empty
    }
  }
}

fn rust_mvp1_serialize_source_children() -> List<Edge> {
  rust_list_append(
    left: rust_mvp1_serialize_source_prefix_edges(),
    right: rust_mvp1_positional_edges_from_token_classes()
  )
}

fn rust_mvp1_serialize_source_node() -> Node {
  // liveness anchor — `rust_mvp1_source_literal` pairs with `rust_mvp1_source_text` until literal Node lands
  let _authority = rust_mvp1_source_text_authority()
  Node {
    kind: TypeNode { connective: Conj },
    children: rust_mvp1_serialize_source_children()
  }
}

fn rust_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}

fn rust_grammar_sequence_fold_step(acc: GrammarExpr, token: RustConcreteSyntaxToken) -> GrammarExpr {
  let token_class = rust_concrete_token_class(token: token)
  if token_class == rust_token_kw_fn {
    acc
  } else {
    Sequence {
      left: rust_grammar_terminal(token_class: token_class),
      right: acc
    }
  }
}

fn rust_grammar_sequence_from_token_classes() -> GrammarExpr {
  fold_list(
    xs: rust_mvp1_concrete_tokens(),
    empty: rust_grammar_terminal(token_class: rust_token_kw_fn),
    cons: fn(acc, token) {
      rust_grammar_sequence_fold_step(acc: acc, token: token)
    }
  )
}

fn rust_mvp1_grammar_relation_row() -> RustGrammarRelationRow {
  RustGrammarRelationRow {
    production: rust_grammar_production_mvp1_fn_add(),
    emitted: rust_mvp1_emitted_add_fn_node(),
    tokens: rust_mvp1_concrete_tokens()
  }
}

fn rust_relation_token_edges(tokens: List<RustConcreteSyntaxToken>) -> List<Edge> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      rust_list_snoc_item(
        xs: acc,
        item: rust_mvp1_positional_token_edge(token: token)
      )
    }
  )
}

fn rust_grammar_relation_row_node(row: RustGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: grammar_relation_field_production,
        target: grammar_production_to_node(production: row.production)
      ),
      rust_named_edge(name: grammar_relation_field_emitted, target: row.emitted),
      rust_named_edge(
        name: grammar_relation_field_tokens,
        target: Node {
          kind: TypeNode { connective: Conj },
          children: rust_relation_token_edges(tokens: row.tokens)
        }
      )
    ]
  }
}

fn rust_mvp1_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: rust_relation_rule_mvp1_fn_add,
        target: rust_grammar_relation_row_node(row: rust_mvp1_grammar_relation_row())
      )
    ]
  }
}

fn rust_mvp1_target_model_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: target_model_edge_selection_policy,
        target: rust_mvp1_selection_policy_node()
      ),
      rust_named_edge(
        name: target_model_edge_declared_inhabitants,
        target: rust_declared_inhabitants_root()
      ),
      rust_named_edge(
        name: target_model_edge_translation_rules,
        target: rust_mvp1_translation_rules_node()
      ),
      rust_named_edge(
        name: target_model_edge_serialize_source,
        target: rust_mvp1_serialize_source_node()
      )
    ]
  }
}

fn rust_mvp1_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), rust_binding_fn_add, "add"),
      rust_binding_param_x,
      "x"
    ),
    rust_binding_param_y,
    "y"
  )
}

fn rust_mvp1_target_model() -> TargetModel {
  TargetModel {
    bundle: rust_mvp1_target_model_node(),
    lex: rust_wave1_lex(),
    binding_spellings: rust_mvp1_binding_spellings(),
    authority_source_text: rust_mvp1_source_text_authority()
  }
}

fn rust_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn rust_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn rust_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: rust_token_ident,
    pattern: rust_ident_lex_pattern()
  }
}

// NOTE: layout whitespace is baked into LiteralPattern.text below (e.g. "fn " not "fn").
// token_sequence_to_source concatenates spellings directly; the spaces here ARE the inter-token
// spacing. This must be split into a separate layout field before forward-lex is wired for
// these token classes (see Claude review 16906 secondary finding).
fn rust_wave1_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      rust_lex_rule(token_class: rust_token_kw_fn, text: "fn "),
      rust_ident_lex_rule(),
      rust_lex_rule(token_class: rust_token_ty_i32, text: "i32"),
      rust_lex_rule(token_class: rust_token_plus, text: " + "),
      rust_lex_rule(token_class: rust_token_arrow, text: " -> "),
      rust_lex_rule(token_class: rust_token_lbrace, text: " { "),
      rust_lex_rule(token_class: rust_token_rbrace, text: " }"),
      rust_lex_rule(token_class: rust_token_lparen, text: "("),
      rust_lex_rule(token_class: rust_token_rparen, text: ") "),
      rust_lex_rule(token_class: rust_token_comma, text: ", "),
      rust_lex_rule(token_class: rust_token_colon, text: ": ")
    ]
  }
}

fn rust_wave1_lex() -> LexRules {
  ModeledLexRules { root: rust_wave1_lex_rules() }
}

fn rust_grammar_atom(id: Symbol) -> Node {
  rust_inhabitant_atom(id: id)
}

fn rust_grammar_production_mvp1_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: rust_production_mvp1_fn_add,
    expression: rust_grammar_sequence_from_token_classes(),
    emitted: rust_grammar_atom(id: rust_surface_fn_item)
  }
}

fn rust_wave1_grammar_root() -> GrammarRoot {
  GrammarRoot { start: rust_grammar_production_mvp1_fn_add() }
}

fn rust_wave1_grammar() -> Grammar {
  ModeledGrammar { root: rust_wave1_grammar_root() }
}

fn rust_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: RustIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn rust_float_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: RustFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn rust_noninteger_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: RustNonIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn rust_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      rust_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn rust_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      rust_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn rust_noninteger_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: rust_noninteger_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      rust_noninteger_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn rust_catalog_surface_symbol(sym: Symbol) -> Bool {
  rust_integer_catalog_surface_symbol(sym: sym) ||
    rust_float_catalog_surface_symbol(sym: sym) ||
    rust_noninteger_catalog_surface_symbol(sym: sym)
}

fn rust_wave1_lex_token_symbol(sym: Symbol) -> Bool {
  sym == rust_token_kw_fn ||
    sym == rust_token_ident ||
    sym == rust_token_ty_i32 ||
    sym == rust_token_plus ||
    sym == rust_token_arrow ||
    sym == rust_token_lbrace ||
    sym == rust_token_rbrace ||
    sym == rust_token_lparen ||
    sym == rust_token_rparen ||
    sym == rust_token_comma ||
    sym == rust_token_colon
}

// Single symbol authority: fact-catalog surface spellings + wave-1 lex/grammar/MVP symbols.
fn rust_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      rust_catalog_surface_symbol(sym: sym) ||
        rust_wave1_lex_token_symbol(sym: sym) ||
        sym == rust_surface_fn_item ||
        sym == rust_production_mvp1_fn_add ||
        sym == rust_mvp1_source_literal
    }
  }
}

fn rust_integer_spec_facts(facts: RustIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: rust_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_width =>
          Holds { value: rust_int_width_node(width: facts.overflow_disposition.ir_carrier.width) }
        primitive_fact_axis_signedness =>
          Holds { value: rust_int_kind_node(kind: facts.overflow_disposition.ir_carrier.kind) }
        primitive_fact_axis_encoding =>
          Holds { value: rust_inhabitant_atom(id: rust_repr_integer_twos_complement) }
        primitive_fact_axis_overflow_disposition =>
          Holds { value: rust_overflow_disposition_node(disposition: facts.overflow_disposition) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn rust_float_spec_facts(facts: RustFloatPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: rust_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_width =>
          Holds { value: rust_float_width_node(width: facts.width) }
        primitive_fact_axis_encoding =>
          Holds { value: rust_inhabitant_atom(id: facts.ieee754_binary) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn rust_noninteger_spec_facts(facts: RustNonIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: rust_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_encoding =>
          Holds { value: rust_inhabitant_atom(id: facts.representation) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn rust_primitive_bundle_from_integer_facts(facts: RustIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: rust_integer_facts_node(facts: facts),
    spec_facts: rust_integer_spec_facts(facts: facts)
  }
}

fn rust_primitive_bundle_from_float_facts(facts: RustFloatPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: rust_float_facts_node(facts: facts),
    spec_facts: rust_float_spec_facts(facts: facts)
  }
}

fn rust_primitive_bundle_from_noninteger_facts(
  facts: RustNonIntegerPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: rust_noninteger_facts_node(facts: facts),
    spec_facts: rust_noninteger_spec_facts(facts: facts)
  }
}

fn rust_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      rust_list_snoc_item(
        xs: acc,
        item: rust_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn rust_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      rust_list_snoc_item(
        xs: acc,
        item: rust_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn rust_primitive_bundles_from_noninteger_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: rust_noninteger_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      rust_list_snoc_item(
        xs: acc,
        item: rust_primitive_bundle_from_noninteger_facts(facts: facts)
      )
    }
  )
}

fn rust_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  rust_list_append(
    left: rust_list_append(
      left: rust_primitive_bundles_from_integer_catalog(),
      right: rust_primitive_bundles_from_float_catalog()
    ),
    right: rust_primitive_bundles_from_noninteger_catalog()
  )
}

fn rust_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: rust_wave1_primitive_fact_bundles(),
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn rust_language_model_wave1() -> RustLanguageModel {
  RustLanguageModel {
    lex: rust_wave1_lex(),
    grammar: rust_wave1_grammar(),
    language_identity: rust_language_model_surface_id,
    canonical_symbols: rust_language_model_canonical_symbols(),
    core: rust_model_core_wave1()
  }
}
