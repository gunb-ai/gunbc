// src/v4/extdeps/languages/rust.dag
// Scope: Rust Reference surface (scalar/reference/visibility/cost carriers) plus ratified D2 resolver types homed here pending resolver.dag migration.
// Owns: RustIntKind, RustIntWidth, RustFloatWidth, RustScalar, RustReferenceKind, NamedSegment, PubInPath, RustVisibility, RustReference, RustCost, GroundingMap, OverflowAction, OverflowDisposition, RustBool, rust_bool_grounding.
// Consumes: v4.std.node.Node, Symbol; kernel-ambient Bool, Int, List, String.
// Status: extdeps rust slice; PubInPath path semantics producer-obligation per DECISIONS.md Part 6 + D2-REV; D2b Arrow bodies deferred to bundled LanguageModel work.
// Anchor: https://doc.rust-lang.org/reference/
// Ledger: DECISIONS.md Part 6 (PR #3229): CP-3229-GREEN-TERMINAL.

module v4.extdeps.languages.rust

import v4.std.node { Node, Symbol }

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type RustIntKind
  = Signed
  | Unsigned

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type RustIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Bits128
  | Pointer

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type RustFloatWidth
  = Bits32
  | Bits64

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type RustScalar
  = IntScalar { kind: RustIntKind, width: RustIntWidth }
  | FloatScalar { width: RustFloatWidth }
  | BoolScalar
  | CharScalar
  | StrScalar
  | NeverScalar

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type RustReferenceKind
  = Shared
  | Exclusive

type NamedSegment {
  id: Symbol
}

type PubInPath {
  resolved_path: List<NamedSegment>
}

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type RustVisibility
  = Private
  | Pub
  | PubIn { path: PubInPath }

type RustReference {
  kind: RustReferenceKind
  lifetime: Symbol
  referent: Node
}

type RustCost {
  instruction_cost: Int
  allocation_cost: Int
}

type GroundingMap<IRCarrier> {
  spelling: String
}

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type OverflowAction
  = PanicOnOverflow
  | TwoComplementWrap

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type OverflowDisposition<IRCarrier>
  = MustPanicOnOverflow
  | MayPanicOrTwoComplementWrap

type RustBool = Bool

data rust_bool_grounding: GroundingMap<RustBool> = GroundingMap {
  spelling: "bool"
}
