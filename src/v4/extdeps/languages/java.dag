// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// JLS has no unsigned integral primitives; `Unsigned` arm mirrors rust.dag carrier shape for v2 compile (never cataloged).
type JavaIntKind
  = Signed
  | Unsigned

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type JavaIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type JavaFloatWidth
  = Bits32
  | Bits64

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type JavaScalar
  = IntScalar { kind: JavaIntKind, width: JavaIntWidth }
  | FloatScalar { width: JavaFloatWidth }
  | BoolScalar
  | VoidScalar

type JavaIntegerPrimitiveFacts {
  surface_spelling: Symbol
  signedness: JavaIntKind
  width: JavaIntWidth
  overflow_release: OverflowAction
  std_projection: Symbol
}

type JavaFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: JavaFloatWidth
  ieee754_binary: Symbol
  std_projection: Symbol
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// Single-class non-integer primitive today; reserved arm mirrors rust.dag two-arm shape for v2 compile.
type JavaNonIntegerScalar
  = BoolScalar
  | JavaNonIntegerScalarReserved

type JavaNonIntegerPrimitiveFacts {
  surface_spelling: Symbol
  scalar: JavaNonIntegerScalar
  std_projection: Symbol
  representation: Symbol
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// Java integral ops wrap (JLS); `PanicOnOverflow` arm mirrors rust.dag for v2 compile (never cataloged).
type OverflowAction
  = PanicOnOverflow
  | TwoComplementWrap

type JavaLanguageModel {
  lex: LexRules
  grammar: Grammar
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

// T-11 java grammar relation row: fixed terminals and bound terminals share
// the Java grammar production instead of an operator string template.
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type JavaConcreteSyntaxToken
  = JavaFixedToken { token_class: Symbol }
  | JavaBoundToken { token_class: Symbol, binding: Symbol }

type JavaGrammarRelationRow {
  production: GrammarProduction
  emitted: Node
  tokens: List<JavaConcreteSyntaxToken>
}

