  width: Bits32,
  value_format: Ieee754Binary32Precision,
  representation: kotlin_platform_specific_runtime_representation,
}

data kotlin_facts_double: KotlinFloatPrimitiveFacts = KotlinFloatPrimitiveFacts {
  surface_spelling: kotlin_surface_spelling_double,
  width: Bits64,
  value_format: Ieee754Binary64Precision,
  representation: kotlin_platform_specific_runtime_representation,
}

data kotlin_facts_boolean: KotlinNonNumericPrimitiveFacts = KotlinNonNumericPrimitiveFacts {
