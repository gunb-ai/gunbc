// src/v4/extdeps/languages/kotlin.dag
// Scope: Kotlin language specification LanguageModel — built-in scalar fact-bundles, catalog-derived canonical symbols, ModelCore primitive bundles.
// Owns: KotlinIntWidth, KotlinScalar, KotlinIntegerPrimitiveFacts, KotlinFloatPrimitiveFacts, KotlinNonNumericPrimitiveFacts, KotlinLanguageModel, kotlin_*_facts, kotlin_model_core_wave1, kotlin_language_model_wave1.
// Consumes: v4.compiler.parse, v4.compiler.tokenize, v4.std.collection, v4.std.model_core, v4.std.node, v4.std.logic, v4.std.algebra.
// Status: T-4 Kotlin wave-1; built-in classifier types from Kotlin language specification Version 1.9-rfc+0.1; runtime representation remains platform-specific where the spec says so; bool canonical-B decl-ref — E-6(b) staging.
// Anchor: https://kotlinlang.org/spec/built-in-types-and-their-semantics.html

module v4.extdeps.languages.kotlin

import v4.compiler.parse { Grammar, VoidGrammar }
import v4.compiler.tokenize { LexRules, VoidLexRules }
import v4.std.collection { List, Map, Set }
import v4.std.model_core {
  EffectSemanticsDecl,
  ModelCore,
  PartialitySemanticsDecl,
  PrimitiveFactBundle,
  primitive_fact_axis_overflow_disposition,
  primitive_fact_axis_signedness,
  primitive_fact_axis_surface_spelling,
  primitive_fact_axis_unbound_diagnostic,
  primitive_fact_axis_width
}
import v4.std.witness { Holds, Violates }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.logic { Bool, bool_boolean_algebra }
import v4.std.algebra { BooleanAlgebra, Empty, fold_list, list_append, list_snoc_item }

// Kotlin's specification defines only signed built-in integer types; unsigned
// integers are not built-in classifier types in this spec section.
// 🟢 coproduct dissolution — alternatives are one-at-a-time scalar widths.
type KotlinIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64

// 🟢 coproduct dissolution — alternatives are one-at-a-time floating widths.
type KotlinFloatWidth
  = Bits32
  | Bits64

// Kotlin spec leaves these runtime representations platform-specific.
type KotlinRuntimeRepresentation {}

// 🟢 coproduct dissolution — character/code-unit facts are separate from runtime representation.
type KotlinCharacterEncoding
  = Ucs2CodeUnit
  | Ucs2CodeUnitSequence

type KotlinSingletonInhabitance {}

type KotlinControlFlowInhabitance {}

// 🟢 coproduct dissolution — IEEE precision/value semantics, not runtime representation.
type KotlinFloatValueFormat
  = Ieee754Binary32Precision
  | Ieee754Binary64Precision

type KotlinIntegerOverflowUnspecified {}

// 🟢 coproduct dissolution — one scalar classifier at a time.
type KotlinScalar
  = IntScalar { width: KotlinIntWidth }
  | FloatScalar { width: KotlinFloatWidth }
  | BoolScalar
  | CharScalar
  | StringScalar
  | UnitScalar
  | NothingScalar

type KotlinIntegerPrimitiveFacts {
  surface_spelling: Symbol
  width: KotlinIntWidth
  overflow: KotlinIntegerOverflowUnspecified
  representation: KotlinRuntimeRepresentation
}

type KotlinFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: KotlinFloatWidth
  value_format: KotlinFloatValueFormat
  representation: KotlinRuntimeRepresentation
}

// 🟢 coproduct dissolution — nonnumeric value facts bind to their own axes.
type KotlinNonNumericValueFact
  = RuntimeRepresentationFact { representation: KotlinRuntimeRepresentation }
  | CharacterEncodingFact { encoding: KotlinCharacterEncoding }
  | SingletonInhabitanceFact { inhabitance: KotlinSingletonInhabitance }
  | ControlFlowInhabitanceFact { inhabitance: KotlinControlFlowInhabitance }

type KotlinNonNumericPrimitiveFacts {
  surface_spelling: Symbol
  scalar: KotlinScalar
  value_fact: KotlinNonNumericValueFact
}

type KotlinLanguageModel {
  lex: LexRules
  grammar: Grammar
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

data kotlin_language_model_surface_id: Symbol = kotlin_language_model_surface_id

data kotlin_surface_spelling_byte: Symbol = kotlin_surface_spelling_byte
data kotlin_surface_spelling_short: Symbol = kotlin_surface_spelling_short
data kotlin_surface_spelling_int: Symbol = kotlin_surface_spelling_int
data kotlin_surface_spelling_long: Symbol = kotlin_surface_spelling_long
data kotlin_surface_spelling_float: Symbol = kotlin_surface_spelling_float
data kotlin_surface_spelling_double: Symbol = kotlin_surface_spelling_double
data kotlin_surface_spelling_boolean: Symbol = kotlin_surface_spelling_boolean
data kotlin_surface_spelling_char: Symbol = kotlin_surface_spelling_char
data kotlin_surface_spelling_string: Symbol = kotlin_surface_spelling_string
data kotlin_surface_spelling_unit: Symbol = kotlin_surface_spelling_unit
data kotlin_surface_spelling_nothing: Symbol = kotlin_surface_spelling_nothing

data kotlin_facts_field_surface_spelling: Symbol = kotlin_facts_field_surface_spelling
data kotlin_facts_field_width: Symbol = kotlin_facts_field_width
data kotlin_facts_field_signedness: Symbol = kotlin_facts_field_signedness
data kotlin_facts_field_overflow: Symbol = kotlin_facts_field_overflow
data kotlin_facts_field_value_format: Symbol = kotlin_facts_field_value_format
data kotlin_facts_field_representation: Symbol = kotlin_facts_field_representation
data kotlin_facts_field_character_encoding: Symbol = kotlin_facts_field_character_encoding
data kotlin_facts_field_singleton_inhabitance: Symbol = kotlin_facts_field_singleton_inhabitance
data kotlin_facts_field_control_flow_inhabitance: Symbol = kotlin_facts_field_control_flow_inhabitance
data kotlin_facts_field_scalar_classifier: Symbol = kotlin_facts_field_scalar_classifier
data kotlin_primitive_fact_axis_value_format: Symbol = kotlin_primitive_fact_axis_value_format
data kotlin_primitive_fact_axis_runtime_representation: Symbol = kotlin_primitive_fact_axis_runtime_representation
data kotlin_primitive_fact_axis_character_encoding: Symbol = kotlin_primitive_fact_axis_character_encoding
data kotlin_primitive_fact_axis_singleton_inhabitance: Symbol = kotlin_primitive_fact_axis_singleton_inhabitance
data kotlin_primitive_fact_axis_control_flow_inhabitance: Symbol = kotlin_primitive_fact_axis_control_flow_inhabitance
data kotlin_primitive_fact_axis_scalar_classifier: Symbol = kotlin_primitive_fact_axis_scalar_classifier

data kotlin_tag_signed: Symbol = kotlin_tag_signed
data kotlin_tag_bits8: Symbol = kotlin_tag_bits8
data kotlin_tag_bits16: Symbol = kotlin_tag_bits16
data kotlin_tag_bits32: Symbol = kotlin_tag_bits32
data kotlin_tag_bits64: Symbol = kotlin_tag_bits64
data kotlin_tag_overflow_unspecified: Symbol = kotlin_tag_overflow_unspecified
data kotlin_tag_platform_specific_runtime_representation: Symbol = kotlin_tag_platform_specific_runtime_representation
data kotlin_tag_ieee754_binary32_precision: Symbol = kotlin_tag_ieee754_binary32_precision
data kotlin_tag_ieee754_binary64_precision: Symbol = kotlin_tag_ieee754_binary64_precision
data kotlin_tag_ucs2_code_unit: Symbol = kotlin_tag_ucs2_code_unit
data kotlin_tag_ucs2_code_unit_sequence: Symbol = kotlin_tag_ucs2_code_unit_sequence
data kotlin_tag_singleton_object: Symbol = kotlin_tag_singleton_object
data kotlin_tag_uninhabited_control_flow: Symbol = kotlin_tag_uninhabited_control_flow
data kotlin_tag_scalar_int: Symbol = kotlin_tag_scalar_int
data kotlin_tag_scalar_float: Symbol = kotlin_tag_scalar_float
data kotlin_tag_scalar_bool: Symbol = kotlin_tag_scalar_bool
data kotlin_tag_scalar_char: Symbol = kotlin_tag_scalar_char
data kotlin_tag_scalar_string: Symbol = kotlin_tag_scalar_string
data kotlin_tag_scalar_unit: Symbol = kotlin_tag_scalar_unit
data kotlin_tag_scalar_nothing: Symbol = kotlin_tag_scalar_nothing
data kotlin_integer_overflow_unspecified: KotlinIntegerOverflowUnspecified = KotlinIntegerOverflowUnspecified {}
data kotlin_platform_specific_runtime_representation: KotlinRuntimeRepresentation = KotlinRuntimeRepresentation {}
data kotlin_singleton_object: KotlinSingletonInhabitance = KotlinSingletonInhabitance {}
data kotlin_uninhabited_control_flow: KotlinControlFlowInhabitance = KotlinControlFlowInhabitance {}

data kotlin_facts_byte: KotlinIntegerPrimitiveFacts = KotlinIntegerPrimitiveFacts {
  surface_spelling: kotlin_surface_spelling_byte,
  width: Bits8,
  overflow: kotlin_integer_overflow_unspecified,
  representation: kotlin_platform_specific_runtime_representation,
}

data kotlin_facts_short: KotlinIntegerPrimitiveFacts = KotlinIntegerPrimitiveFacts {
  surface_spelling: kotlin_surface_spelling_short,
