fn ts_mvp1_selection_policy_node() -> Node {
  ts_inhabitant_number_node()
}

fn ts_mvp1_emitted_add_fn_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: ts_inhabitant_number_node() },
      Edge { label: Positional, target: ts_inhabitant_number_node() },
      Edge { label: Positional, target: ts_inhabitant_number_node() }
    ]
  }
}

fn ts_mvp1_source_text_authority() -> String {
  ts_mvp1_source_text
}

fn ts_concrete_token_class(token: TsConcreteSyntaxToken) -> Symbol {
  match token {
    TsFixedToken { token_class: c } => c
    TsBoundToken { token_class: c, binding: _ } => c
  }
}

fn ts_concrete_token_node(token: TsConcreteSyntaxToken) -> Node {
  match token {
    TsFixedToken { token_class: c } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ts_named_edge(
            name: concrete_syntax_token_field_kind,
            target: ts_inhabitant_atom(id: concrete_syntax_token_kind_fixed)
          ),
          ts_named_edge(
            name: concrete_syntax_token_field_class,
            target: ts_inhabitant_atom(id: c)
          )
        ]
      }
    TsBoundToken { token_class: c, binding: b } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ts_named_edge(
            name: concrete_syntax_token_field_kind,
            target: ts_inhabitant_atom(id: concrete_syntax_token_kind_bound)
          ),
          ts_named_edge(
            name: concrete_syntax_token_field_class,
            target: ts_inhabitant_atom(id: c)
          ),
          ts_named_edge(
            name: concrete_syntax_token_field_binding,
            target: ts_inhabitant_atom(id: b)
          )
        ]
      }
  }
}

fn ts_mvp1_positional_token_edge(token: TsConcreteSyntaxToken) -> Edge {
  Edge {
    label: Positional,
    target: ts_concrete_token_node(token: token)
  }
}

fn ts_mvp1_positional_edges_from_token_classes() -> List<Edge> {
  fold_list(
    xs: ts_mvp1_concrete_tokens(),
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: ts_mvp1_positional_token_edge(token: token)
      )
    }
  )
}

fn ts_mvp1_serialize_source_prefix_edges() -> List<Edge> {
  [
    ts_named_edge(
      name: ts_mvp1_source_text_field,
      target: ts_inhabitant_atom(id: ts_mvp1_source_literal)
    ),
    ts_named_edge(
      name: ts_mvp1_source_grammar_field,
      target: ts_inhabitant_atom(id: ts_production_mvp1_fn_add)
    )
  ]
}

fn ts_mvp1_serialize_source_children() -> List<Edge> {
  list_append(
    left: ts_mvp1_serialize_source_prefix_edges(),
    right: ts_mvp1_positional_edges_from_token_classes()
  )
}

fn ts_mvp1_serialize_source_node() -> Node {
  let _authority = ts_mvp1_source_text_authority()
  Node {
    kind: TypeNode { connective: Conj },
    children: ts_mvp1_serialize_source_children()
  }
}

fn ts_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}

// 🟡 coproduct dissolution — SL-T11-GRAMMAR-FROM-TOKEN-ROW — feature:t11-grammar-from-token-row — bind task: src/v4/TASKS.md#t-11-emit-per-target-specialization — owner:T-11 target-model grammar rows — dissolve-on-arrival: replace the fold1 accumulator with a std fold_non_empty/list-to-sequence helper once that helper lands and T-11 grammar rows consume it; forbidden: hand-authoring token-class sequence trees beside the *_mvp1_concrete_tokens source.
type TsGramBuild1State
  = TsGramBuild1StateInit
  | TsGramBuild1StateReady { expr: GrammarExpr }

fn ts_grammar_sequence_from_token_classes() -> GrammarExpr {
  match fold_list(
    xs: ts_mvp1_concrete_tokens(),
    empty: TsGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        TsGramBuild1StateInit =>
          TsGramBuild1StateReady {
            expr: ts_grammar_terminal(token_class: ts_concrete_token_class(token: token))
          }
        TsGramBuild1StateReady { expr: acc } =>
          TsGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: ts_grammar_terminal(token_class: ts_concrete_token_class(token: token))
            }
          }
      }
    }
  ) {
    TsGramBuild1StateInit =>
      ts_grammar_terminal(token_class: ts_token_kw_function)
    TsGramBuild1StateReady { expr: result } => result
  }
}

fn ts_mvp1_grammar_relation_row() -> TsGrammarRelationRow {
  TsGrammarRelationRow {
    production: ts_formal_production_mvp1_fn_add(),
    emitted: ts_mvp1_emitted_add_fn_node(),
    tokens: ts_mvp1_concrete_tokens()
  }
}

fn ts_relation_token_edges(tokens: List<TsConcreteSyntaxToken>) -> List<Edge> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: ts_mvp1_positional_token_edge(token: token)
      )
    }
  )
}

