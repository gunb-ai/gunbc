fn ts_mvp1_concrete_tokens() -> List<TsConcreteSyntaxToken> {
  [
    TsFixedToken { token_class: ts_token_kw_function },
    TsBoundToken { token_class: ts_token_ident, binding: ts_binding_fn_add },
    TsFixedToken { token_class: ts_token_lparen },
    TsBoundToken { token_class: ts_token_ident, binding: ts_binding_param_x },
    TsFixedToken { token_class: ts_token_colon },
    TsFixedToken { token_class: ts_token_ty_number },
    TsFixedToken { token_class: ts_token_comma },
    TsBoundToken { token_class: ts_token_ident, binding: ts_binding_param_y },
    TsFixedToken { token_class: ts_token_colon },
    TsFixedToken { token_class: ts_token_ty_number },
    TsFixedToken { token_class: ts_token_rparen },
    TsFixedToken { token_class: ts_token_colon },
    TsFixedToken { token_class: ts_token_ty_number },
    TsFixedToken { token_class: ts_token_lbrace },
    TsFixedToken { token_class: ts_token_kw_return },
    TsBoundToken { token_class: ts_token_ident, binding: ts_binding_param_x },
    TsFixedToken { token_class: ts_token_plus },
    TsBoundToken { token_class: ts_token_ident, binding: ts_binding_param_y },
    TsFixedToken { token_class: ts_token_semicolon },
    TsFixedToken { token_class: ts_token_rbrace }
  ]
}
data ts_mvp1_source_text: String = "function add(x: number, y: number): number { return x + y; }"

data ts_facts_number: TsNumberPrimitiveFacts = TsNumberPrimitiveFacts {
  surface_spelling: ts_surface_spelling_number,
  ieee754_binary: ts_ieee754_binary64,
  std_projection: ts_std_projection_float64,
}

data ts_facts_bigint: TsBigIntPrimitiveFacts = TsBigIntPrimitiveFacts {
  surface_spelling: ts_surface_spelling_bigint,
  std_projection: ts_std_projection_bigint,
  encoding: ts_repr_bigint_exact_unbounded,
}

data ts_facts_boolean: TsBooleanPrimitiveFacts = TsBooleanPrimitiveFacts {
  surface_spelling: ts_surface_spelling_boolean,
  std_projection: ts_std_projection_bool,
  encoding: ts_repr_boolean_ecma_boolean,
}

data ts_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

data ts_numeric_facts_catalog: List<TsEcma262NumericPrimitiveFactsUnion> = [
  TsNumericFactsNumber { facts: ts_facts_number },
  TsNumericFactsBigInt { facts: ts_facts_bigint }
]

fn ts_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn ts_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn ts_number_arithmetic_semantics_node() -> Node {
  ts_inhabitant_atom(id: ts_tag_number_ieee754_binary64)
}

fn ts_number_bitwise_semantics_node() -> Node {
  ts_inhabitant_atom(id: ts_tag_number_bitwise_int32_uint32)
}

fn ts_bigint_operation_semantics_node() -> Node {
  ts_inhabitant_atom(id: ts_tag_bigint_exact_unbounded)
}

fn ts_bool_operation_semantics_node(facts: TsBooleanPrimitiveFacts) -> Node {
  ts_inhabitant_atom(id: facts.encoding)
}

fn ts_number_facts_node(facts: TsNumberPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ts_facts_field_arithmetic_semantics,
        target: ts_number_arithmetic_semantics_node()
      ),
      ts_named_edge(
        name: ts_facts_field_bitwise_semantics,
        target: ts_number_bitwise_semantics_node()
      ),
      ts_named_edge(
        name: ts_facts_field_width,
        target: ts_inhabitant_atom(id: ts_tag_bits64)
      ),
      ts_named_edge(
        name: ts_facts_field_ieee754_binary,
        target: ts_inhabitant_atom(id: facts.ieee754_binary)
      ),
      ts_named_edge(
        name: ts_facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn ts_bigint_facts_node(facts: TsBigIntPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ts_facts_field_operation_semantics,
        target: ts_bigint_operation_semantics_node()
      ),
      ts_named_edge(
        name: ts_facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      ),
      ts_named_edge(
        name: ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: facts.encoding)
      )
    ]
  }
}

fn ts_bool_facts_node(facts: TsBooleanPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ts_facts_field_operation_semantics,
        target: ts_bool_operation_semantics_node(facts: facts)
      ),
      ts_named_edge(
        name: ts_facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      ),
      ts_named_edge(
        name: ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: facts.encoding)
      )
    ]
  }
}

fn ts_number_inhabitant_node(id: Symbol, facts: TsNumberPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ts_inhabitant_field_facts,
        target: ts_number_facts_node(facts: facts)
      )
    ]
  }
}

fn ts_bigint_inhabitant_node(id: Symbol, facts: TsBigIntPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ts_inhabitant_field_facts,
        target: ts_bigint_facts_node(facts: facts)
      )
    ]
  }
}

fn ts_bool_inhabitant_node(id: Symbol, facts: TsBooleanPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ts_inhabitant_field_facts,
        target: ts_bool_facts_node(facts: facts)
      )
    ]
  }
}

fn ts_inhabitant_number_node() -> Node {
  ts_number_inhabitant_node(id: ts_inhabitant_number, facts: ts_facts_number)
}

fn ts_inhabitant_bigint_node() -> Node {
  ts_bigint_inhabitant_node(id: ts_inhabitant_bigint, facts: ts_facts_bigint)
}

fn ts_inhabitant_boolean_node() -> Node {
  ts_bool_inhabitant_node(id: ts_inhabitant_boolean, facts: ts_facts_boolean)
}

fn ts_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ts_inhabitant_field_number, target: ts_inhabitant_number_node()),
      ts_named_edge(name: ts_inhabitant_field_bigint, target: ts_inhabitant_bigint_node()),
      ts_named_edge(name: ts_inhabitant_field_boolean, target: ts_inhabitant_boolean_node())
    ]
  }
}

fn ts_mvp1_selection_policy_node() -> Node {
  ts_inhabitant_number_node()
}

fn ts_mvp1_emitted_add_fn_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: ts_inhabitant_number_node() },
      Edge { label: Positional, target: ts_inhabitant_number_node() },
      Edge { label: Positional, target: ts_inhabitant_number_node() }
    ]
  }
}

fn ts_mvp1_source_text_authority() -> String {
  ts_mvp1_source_text
}

fn ts_concrete_token_class(token: TsConcreteSyntaxToken) -> Symbol {
  match token {
    TsFixedToken { token_class: c } => c
    TsBoundToken { token_class: c, binding: _ } => c
  }
}

fn ts_concrete_token_node(token: TsConcreteSyntaxToken) -> Node {
  match token {
    TsFixedToken { token_class: c } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ts_named_edge(
            name: concrete_syntax_token_field_kind,
            target: ts_inhabitant_atom(id: concrete_syntax_token_kind_fixed)
          ),
          ts_named_edge(
            name: concrete_syntax_token_field_class,
            target: ts_inhabitant_atom(id: c)
          )
        ]
      }
    TsBoundToken { token_class: c, binding: b } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ts_named_edge(
            name: concrete_syntax_token_field_kind,
            target: ts_inhabitant_atom(id: concrete_syntax_token_kind_bound)
          ),
          ts_named_edge(
            name: concrete_syntax_token_field_class,
            target: ts_inhabitant_atom(id: c)
          ),
          ts_named_edge(
            name: concrete_syntax_token_field_binding,
            target: ts_inhabitant_atom(id: b)
          )
        ]
      }
  }
}

fn ts_mvp1_positional_token_edge(token: TsConcreteSyntaxToken) -> Edge {
  Edge {
    label: Positional,
    target: ts_concrete_token_node(token: token)
  }
}

fn ts_mvp1_positional_edges_from_token_classes() -> List<Edge> {
  fold_list(
    xs: ts_mvp1_concrete_tokens(),
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: ts_mvp1_positional_token_edge(token: token)
      )
    }
  )
}

fn ts_mvp1_serialize_source_prefix_edges() -> List<Edge> {
  [
    ts_named_edge(
      name: ts_mvp1_source_text_field,
      target: ts_inhabitant_atom(id: ts_mvp1_source_literal)
    ),
    ts_named_edge(
      name: ts_mvp1_source_grammar_field,
      target: ts_inhabitant_atom(id: ts_production_mvp1_fn_add)
    )
  ]
}

fn ts_mvp1_serialize_source_children() -> List<Edge> {
  list_append(
    left: ts_mvp1_serialize_source_prefix_edges(),
    right: ts_mvp1_positional_edges_from_token_classes()
  )
}

fn ts_mvp1_serialize_source_node() -> Node {
  let _authority = ts_mvp1_source_text_authority()
  Node {
    kind: TypeNode { connective: Conj },
    children: ts_mvp1_serialize_source_children()
  }
}

fn ts_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}

// 🟡 coproduct dissolution — SL-T11-GRAMMAR-FROM-TOKEN-ROW — feature:t11-grammar-from-token-row — bind task: src/v4/TASKS.md#t-11-emit-per-target-specialization — owner:T-11 target-model grammar rows — dissolve-on-arrival: replace the fold1 accumulator with a std fold_non_empty/list-to-sequence helper once that helper lands and T-11 grammar rows consume it; forbidden: hand-authoring token-class sequence trees beside the *_mvp1_concrete_tokens source.
type TsGramBuild1State
  = TsGramBuild1StateInit
  | TsGramBuild1StateReady { expr: GrammarExpr }

fn ts_grammar_sequence_from_token_classes() -> GrammarExpr {
  match fold_list(
    xs: ts_mvp1_concrete_tokens(),
    empty: TsGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        TsGramBuild1StateInit =>
          TsGramBuild1StateReady {
            expr: ts_grammar_terminal(token_class: ts_concrete_token_class(token: token))
          }
        TsGramBuild1StateReady { expr: acc } =>
          TsGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: ts_grammar_terminal(token_class: ts_concrete_token_class(token: token))
            }
          }
      }
    }
  ) {
    TsGramBuild1StateInit =>
      ts_grammar_terminal(token_class: ts_token_kw_function)
    TsGramBuild1StateReady { expr: result } => result
  }
}

fn ts_mvp1_grammar_relation_row() -> TsGrammarRelationRow {
  TsGrammarRelationRow {
    production: ts_grammar_production_mvp1_fn_add(),
    emitted: ts_mvp1_emitted_add_fn_node(),
    tokens: ts_mvp1_concrete_tokens()
  }
}

fn ts_relation_token_edges(tokens: List<TsConcreteSyntaxToken>) -> List<Edge> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: ts_mvp1_positional_token_edge(token: token)
      )
    }
  )
}

fn ts_grammar_relation_row_node(row: TsGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: grammar_relation_field_production,
        target: grammar_production_to_node(production: row.production)
      ),
      ts_named_edge(name: grammar_relation_field_emitted, target: row.emitted),
      ts_named_edge(
        name: grammar_relation_field_tokens,
        target: Node {
          kind: TypeNode { connective: Conj },
          children: ts_relation_token_edges(tokens: row.tokens)
        }
      )
    ]
  }
}

fn ts_mvp1_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_relation_rule_mvp1_fn_add,
        target: ts_grammar_relation_row_node(row: ts_mvp1_grammar_relation_row())
      )
    ]
  }
}

fn ts_mvp1_target_model_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: target_model_edge_selection_policy,
        target: ts_mvp1_selection_policy_node()
      ),
      ts_named_edge(
        name: target_model_edge_declared_inhabitants,
        target: ts_declared_inhabitants_root()
      ),
      ts_named_edge(
        name: target_model_edge_translation_rules,
        target: ts_mvp1_translation_rules_node()
      ),
      ts_named_edge(
        name: target_model_edge_serialize_source,
        target: ts_mvp1_serialize_source_node()
      )
    ]
  }
}

fn ts_mvp1_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ts_binding_fn_add, "add"),
      ts_binding_param_x,
      "x"
    ),
    ts_binding_param_y,
    "y"
  )
}

fn ts_mvp1_target_model() -> TargetModel {
  TargetModel {
    bundle: ts_mvp1_target_model_node(),
    lex: ts_wave1_lex(),
    binding_spellings: ts_mvp1_binding_spellings(),
    authority_source_text: ts_mvp1_source_text_authority()
  }
}

fn ts_wave1_target_model() -> Node {
  ts_mvp1_target_model_node()
}

fn ts_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn ts_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn ts_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: ts_token_ident,
    pattern: ts_ident_lex_pattern()
  }
}

fn ts_wave1_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      ts_lex_rule(token_class: ts_token_kw_function, text: "function "),
      ts_lex_rule(token_class: ts_token_kw_return, text: "return "),
      ts_ident_lex_rule(),
      ts_lex_rule(token_class: ts_token_ty_number, text: "number"),
      ts_lex_rule(token_class: ts_token_plus, text: " + "),
      ts_lex_rule(token_class: ts_token_lbrace, text: " { "),
      ts_lex_rule(token_class: ts_token_rbrace, text: " }"),
      ts_lex_rule(token_class: ts_token_lparen, text: "("),
      ts_lex_rule(token_class: ts_token_rparen, text: ")"),
      ts_lex_rule(token_class: ts_token_comma, text: ", "),
      ts_lex_rule(token_class: ts_token_colon, text: ": "),
      ts_lex_rule(token_class: ts_token_semicolon, text: ";")
    ]
  }
}

fn ts_wave1_lex() -> LexRules {
  ModeledLexRules { root: ts_wave1_lex_rules() }
}

fn ts_grammar_atom(id: Symbol) -> Node {
  ts_inhabitant_atom(id: id)
}

fn ts_grammar_production_mvp1_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_mvp1_fn_add,
    expression: ts_grammar_sequence_from_token_classes(),
    emitted: ts_grammar_atom(id: ts_surface_fn_item)
  }
}

fn ts_wave1_grammar_root() -> GrammarRoot {
  let start = ts_grammar_production_mvp1_fn_add()
  GrammarRoot { start: ts_production_mvp1_fn_add, productions: [start], sync_tokens: grammar_empty_sync_tokens() }
}

fn ts_wave1_grammar() -> ParseGrammar {
  ModeledGrammar { root: ts_wave1_grammar_root() }
}

fn ts_wave1_lex_token_symbol(sym: Symbol) -> Bool {
  sym == ts_token_kw_function ||
    sym == ts_token_kw_return ||
    sym == ts_token_ident ||
    sym == ts_token_ty_number ||
    sym == ts_token_plus ||
    sym == ts_token_lbrace ||
    sym == ts_token_rbrace ||
    sym == ts_token_lparen ||
    sym == ts_token_rparen ||
    sym == ts_token_comma ||
    sym == ts_token_colon ||
    sym == ts_token_semicolon
}

fn ts_catalog_surface_symbol_step(sym: Symbol, acc: Bool, row: TsEcma262NumericPrimitiveFactsUnion) -> Bool {
  match row {
    TsNumericFactsNumber { facts: f } => acc || sym == f.surface_spelling
    TsNumericFactsBigInt { facts: f } => acc || sym == f.surface_spelling
  }
}

fn ts_catalog_surface_symbol(sym: Symbol) -> Bool {
  sym == ts_facts_boolean.surface_spelling ||
  fold_list(
    xs: ts_numeric_facts_catalog,
    empty: false,
    cons: fn(acc, row) {
      ts_catalog_surface_symbol_step(sym: sym, acc: acc, row: row)
    }
  )
}

fn ts_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      ts_catalog_surface_symbol(sym: sym) ||
        ts_wave1_lex_token_symbol(sym: sym) ||
        sym == ts_surface_fn_item ||
        sym == ts_production_mvp1_fn_add ||
        sym == ts_mvp1_source_literal
    }
  }
}

fn ts_number_spec_facts(facts: TsNumberPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: ts_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_width =>
          Holds { value: ts_inhabitant_atom(id: ts_tag_bits64) }
        primitive_fact_axis_encoding =>
          Holds { value: ts_inhabitant_atom(id: facts.ieee754_binary) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn ts_bigint_spec_facts(facts: TsBigIntPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: ts_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_encoding =>
          Holds { value: ts_inhabitant_atom(id: facts.encoding) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn ts_bool_spec_facts(facts: TsBooleanPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: ts_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_encoding =>
          Holds { value: ts_inhabitant_atom(id: facts.encoding) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn ts_primitive_bundle_from_number_facts(facts: TsNumberPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: ts_number_facts_node(facts: facts),
    spec_facts: ts_number_spec_facts(facts: facts)
  }
}

fn ts_primitive_bundle_from_bigint_facts(facts: TsBigIntPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: ts_bigint_facts_node(facts: facts),
    spec_facts: ts_bigint_spec_facts(facts: facts)
  }
}

fn ts_primitive_bundle_from_bool_facts(facts: TsBooleanPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: ts_bool_facts_node(facts: facts),
    spec_facts: ts_bool_spec_facts(facts: facts)
  }
}

fn ts_primitive_bundles_from_catalog_step(
  acc: List<PrimitiveFactBundle>,
  row: TsEcma262NumericPrimitiveFactsUnion
) -> List<PrimitiveFactBundle> {
  match row {
    TsNumericFactsNumber { facts: f } =>
      list_snoc_item(
        xs: acc,
        item: ts_primitive_bundle_from_number_facts(facts: f)
      )
    TsNumericFactsBigInt { facts: f } =>
      list_snoc_item(
        xs: acc,
        item: ts_primitive_bundle_from_bigint_facts(facts: f)
      )
  }
}

fn ts_numeric_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: ts_numeric_facts_catalog,
    empty: Empty,
    cons: fn(acc, row) {
      ts_primitive_bundles_from_catalog_step(acc: acc, row: row)
    }
  )
}

fn ts_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  list_snoc_item(
    xs: ts_numeric_primitive_fact_bundles(),
    item: ts_primitive_bundle_from_bool_facts(facts: ts_facts_boolean)
  )
}

fn ts_number_algebra_witness_node(facts: TsNumberPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_witness_number_approximate_field,
        target: ts_inhabitant_atom(id: ts_witness_number_approximate_field)
      ),
      ts_named_edge(
        name: ts_facts_field_ieee754_binary,
        target: ts_inhabitant_atom(id: facts.ieee754_binary)
      ),
      ts_named_edge(
        name: ts_facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn ts_bigint_algebra_witness_node(facts: TsBigIntPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_witness_bigint_ordered_ring,
        target: ts_inhabitant_atom(id: ts_witness_bigint_ordered_ring)
      ),
      ts_named_edge(
        name: ts_facts_field_operation_semantics,
        target: ts_bigint_operation_semantics_node()
      ),
      ts_named_edge(
        name: ts_facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn ts_bool_algebra_witness_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_witness_bool_boolean_algebra,
        target: ts_inhabitant_atom(id: ts_witness_bool_boolean_algebra)
      ),
      ts_named_edge(
        name: ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: ts_facts_boolean.encoding)
      ),
      ts_named_edge(
        name: ts_facts_field_std_projection,
        target: ts_inhabitant_atom(id: ts_facts_boolean.std_projection)
      )
    ]
  }
}

fn ts_number_algebra_inhabitance(facts: TsNumberPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = ts_number_inhabitant_node(id: ts_inhabitant_number, facts: facts)
  AlgebraInhabitanceDecl {
    algebra: approximate_field_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: ts_number_algebra_witness_node(facts: facts)
  }
}

fn ts_bigint_algebra_inhabitance(facts: TsBigIntPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = ts_bigint_inhabitant_node(id: ts_inhabitant_bigint, facts: facts)
  AlgebraInhabitanceDecl {
    algebra: ordered_ring_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: ts_bigint_algebra_witness_node(facts: facts)
  }
}

fn ts_bool_algebra_inhabitance() -> AlgebraInhabitanceDecl {
  let inhabitant = ts_inhabitant_boolean_node()
  AlgebraInhabitanceDecl {
    algebra: boolean_algebra_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: ts_bool_algebra_witness_node()
  }
}

fn ts_numeric_algebra_inhabitance_step(
  acc: List<AlgebraInhabitanceDecl>,
  row: TsEcma262NumericPrimitiveFactsUnion
) -> List<AlgebraInhabitanceDecl> {
  match row {
    TsNumericFactsNumber { facts: f } =>
      list_snoc_item(
        xs: acc,
        item: ts_number_algebra_inhabitance(facts: f)
      )
    TsNumericFactsBigInt { facts: f } =>
      list_snoc_item(
        xs: acc,
        item: ts_bigint_algebra_inhabitance(facts: f)
      )
  }
}

fn ts_numeric_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: ts_numeric_facts_catalog,
    empty: Empty,
    cons: fn(acc, row) {
      ts_numeric_algebra_inhabitance_step(acc: acc, row: row)
    }
  )
}

fn ts_bool_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  [
    ts_bool_algebra_inhabitance()
  ]
}

fn ts_model_core_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  list_append(
    left: ts_numeric_algebra_inhabitance_decls(),
    right: ts_bool_algebra_inhabitance_decls()
  )
}

fn ts_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: ts_wave1_primitive_fact_bundles(),
    inhabitance: ts_model_core_inhabitance_decls(),
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn ts_language_model_wave1() -> TsLanguageModel {
  TsLanguageModel {
    language_identity: ts_language_model_surface_id,
    canonical_symbols: ts_language_model_canonical_symbols(),
    core: ts_model_core_wave1(),
    lex: ts_wave1_lex(),
    grammar: ts_wave1_grammar()
  }
}


fn ts_num_lit_lex_pattern() -> LexPattern {
  OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
}

fn ts_num_lit_lex_rule() -> LexRule {
  TokenRule { token_class: ts_token_num_lit, pattern: ts_num_lit_lex_pattern() }
}

fn ts_wave2a_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      ts_lex_rule(token_class: ts_token_kw_function, text: "function "),
      ts_lex_rule(token_class: ts_token_kw_return, text: "return "),
      ts_lex_rule(token_class: ts_token_kw_let, text: "let "),
      ts_lex_rule(token_class: ts_token_kw_const, text: "const "),
      ts_ident_lex_rule(),
      ts_lex_rule(token_class: ts_token_ty_number, text: "number"),
      ts_lex_rule(token_class: ts_token_ty_string, text: "string"),
      ts_lex_rule(token_class: ts_token_ty_boolean, text: "boolean"),
      ts_lex_rule(token_class: ts_token_ty_void, text: "void"),
      ts_num_lit_lex_rule(),
      ts_lex_rule(token_class: ts_token_plus, text: " + "),
      ts_lex_rule(token_class: ts_token_minus, text: " - "),
      ts_lex_rule(token_class: ts_token_star, text: " * "),
      ts_lex_rule(token_class: ts_token_eq, text: " = "),
      ts_lex_rule(token_class: ts_token_lbrace, text: " { "),
      ts_lex_rule(token_class: ts_token_rbrace, text: " }"),
      ts_lex_rule(token_class: ts_token_lparen, text: "("),
      ts_lex_rule(token_class: ts_token_rparen, text: ")"),
      ts_lex_rule(token_class: ts_token_comma, text: ", "),
      ts_lex_rule(token_class: ts_token_colon, text: ": "),
      ts_lex_rule(token_class: ts_token_semicolon, text: ";")
    ]
  }
}

fn ts_wave2a_lex() -> LexRules {
  ModeledLexRules { root: ts_wave2a_lex_rules() }
}

fn ts_wave2a_lex_token_symbol(sym: Symbol) -> Bool {
  lex_rule_set_token_class_member(rules: ts_wave2a_lex_rules(), token_class: sym)
}

fn ts_grammar_production_wave2a_type_number() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_wave2a_type_number,
    expression: Terminal { token_class: ts_token_ty_number },
    emitted: ts_grammar_atom(id: ts_surface_type_number)
  }
}

fn ts_grammar_production_wave2a_type_string() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_wave2a_type_string,
    expression: Terminal { token_class: ts_token_ty_string },
    emitted: ts_grammar_atom(id: ts_surface_type_string)
  }
}

fn ts_grammar_production_wave2a_type_boolean() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_wave2a_type_boolean,
    expression: Terminal { token_class: ts_token_ty_boolean },
    emitted: ts_grammar_atom(id: ts_surface_type_boolean)
  }
}

fn ts_grammar_production_wave2a_type_void() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_wave2a_type_void,
    expression: Terminal { token_class: ts_token_ty_void },
    emitted: ts_grammar_atom(id: ts_surface_type_void)
  }
}

fn ts_grammar_production_wave2a_type_annotation() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_wave2a_type_annotation,
    expression: Choice {
      left: Nonterminal { production: ts_production_wave2a_type_number },
      right: Choice {
        left: Nonterminal { production: ts_production_wave2a_type_string },
        right: Choice {
          left: Nonterminal { production: ts_production_wave2a_type_boolean },
          right: Nonterminal { production: ts_production_wave2a_type_void }
        }
      }
    },
    emitted: ts_grammar_atom(id: ts_surface_type_annotation)
  }
}

fn ts_grammar_production_wave2a_let_decl() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_wave2a_let_decl,
    expression: Sequence {
      left: Terminal { token_class: ts_token_kw_let },
      right: Sequence {
        left: Terminal { token_class: ts_token_ident },
        right: Sequence {
          left: Terminal { token_class: ts_token_colon },
          right: Sequence {
            left: Nonterminal { production: ts_production_wave2a_type_annotation },
            right: Sequence {
              left: Terminal { token_class: ts_token_eq },
              right: Sequence {
                left: Terminal { token_class: ts_token_ident },
                right: Terminal { token_class: ts_token_semicolon }
              }
            }
          }
        }
      }
    },
    emitted: ts_grammar_atom(id: ts_surface_let_decl)
  }
}

fn ts_grammar_production_wave2a_const_decl() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_wave2a_const_decl,
    expression: Sequence {
      left: Terminal { token_class: ts_token_kw_const },
      right: Sequence {
        left: Terminal { token_class: ts_token_ident },
        right: Sequence {
          left: Terminal { token_class: ts_token_colon },
          right: Sequence {
            left: Nonterminal { production: ts_production_wave2a_type_annotation },
            right: Sequence {
              left: Terminal { token_class: ts_token_eq },
              right: Sequence {
                left: Terminal { token_class: ts_token_ident },
                right: Terminal { token_class: ts_token_semicolon }
              }
            }
          }
        }
      }
    },
    emitted: ts_grammar_atom(id: ts_surface_const_decl)
  }
}

fn ts_grammar_production_wave2a_item() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_wave2a_item,
    expression: Choice {
      left: Nonterminal { production: ts_production_mvp1_fn_add },
      right: Choice {
        left: Nonterminal { production: ts_production_wave2a_let_decl },
        right: Nonterminal { production: ts_production_wave2a_const_decl }
      }
    },
    emitted: ts_grammar_atom(id: ts_surface_item)
  }
}

fn ts_wave2a_grammar_root() -> GrammarRoot {
  let mvp1 = ts_grammar_production_mvp1_fn_add()
  let ty_num = ts_grammar_production_wave2a_type_number()
  let ty_str = ts_grammar_production_wave2a_type_string()
  let ty_bool = ts_grammar_production_wave2a_type_boolean()
  let ty_void = ts_grammar_production_wave2a_type_void()
  let type_annot = ts_grammar_production_wave2a_type_annotation()
  let let_decl = ts_grammar_production_wave2a_let_decl()
  let const_decl = ts_grammar_production_wave2a_const_decl()
  let item = ts_grammar_production_wave2a_item()
  GrammarRoot {
    start: ts_production_wave2a_item,
    productions: [mvp1, ty_num, ty_str, ty_bool, ty_void, type_annot, let_decl, const_decl, item],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn ts_wave2a_grammar() -> ParseGrammar {
  ModeledGrammar { root: ts_wave2a_grammar_root() }
}

fn ts_language_model_canonical_symbols_wave2a() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      ts_catalog_surface_symbol(sym: sym) ||
        ts_wave2a_lex_token_symbol(sym: sym) ||
        grammar_carries_symbol(grammar: ts_wave2a_grammar(), sym: sym) ||
        sym == ts_mvp1_source_literal
    }
  }
}

fn ts_language_model_wave2a() -> TsLanguageModel {
  TsLanguageModel {
    language_identity: ts_language_model_surface_id,
    canonical_symbols: ts_language_model_canonical_symbols_wave2a(),
    core: ts_model_core_wave1(),
    lex: ts_wave2a_lex(),
    grammar: ts_wave2a_grammar()
  }
}
