import v4.std.target_model { target_model_edge_declared_inhabitants }

// 🟢 grounded.
type TsNumberPrimitiveFacts {
  surface_spelling: Symbol
  ieee754_binary: Symbol
  std_projection: Symbol
}

// 🟢 grounded.
type TsBigIntPrimitiveFacts {
  surface_spelling: Symbol
  std_projection: Symbol
  encoding: Symbol
}

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type TsEcma262NumericPrimitiveFactsUnion
  = TsNumericFactsNumber { facts: TsNumberPrimitiveFacts }
  | TsNumericFactsBigInt { facts: TsBigIntPrimitiveFacts }

// 🟢 grounded.
type TsLanguageModel {
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

data ts_language_model_surface_id: Symbol = ts_language_model_surface_id

data ts_std_projection_float64: Symbol = ts_std_projection_float64
data ts_std_projection_bigint: Symbol = ts_std_projection_bigint

data ts_surface_spelling_number: Symbol = ts_surface_spelling_number
data ts_surface_spelling_bigint: Symbol = ts_surface_spelling_bigint

data ts_ieee754_binary64: Symbol = ts_ieee754_binary64
data ts_repr_bigint_exact_unbounded: Symbol = ts_repr_bigint_exact_unbounded

data ts_inhabitant_number: Symbol = ts_inhabitant_number
data ts_inhabitant_bigint: Symbol = ts_inhabitant_bigint

data ts_inhabitant_field_number: Symbol = ts_inhabitant_field_number
data ts_inhabitant_field_bigint: Symbol = ts_inhabitant_field_bigint

data ts_inhabitant_field_atom: Symbol = ts_inhabitant_field_atom
data ts_inhabitant_field_facts: Symbol = ts_inhabitant_field_facts

data ts_facts_field_surface_spelling: Symbol = ts_facts_field_surface_spelling
data ts_facts_field_arithmetic_semantics: Symbol = ts_facts_field_arithmetic_semantics
data ts_facts_field_bitwise_semantics: Symbol = ts_facts_field_bitwise_semantics
data ts_facts_field_operation_semantics: Symbol = ts_facts_field_operation_semantics
data ts_facts_field_width: Symbol = ts_facts_field_width
data ts_facts_field_ieee754_binary: Symbol = ts_facts_field_ieee754_binary
data ts_facts_field_std_projection: Symbol = ts_facts_field_std_projection
data ts_facts_field_encoding: Symbol = ts_facts_field_encoding

data ts_tag_bits64: Symbol = ts_tag_bits64
data ts_tag_number_ieee754_binary64: Symbol = ts_tag_number_ieee754_binary64
data ts_tag_number_bitwise_int32_uint32: Symbol = ts_tag_number_bitwise_int32_uint32
data ts_tag_bigint_exact_unbounded: Symbol = ts_tag_bigint_exact_unbounded

data ts_facts_number: TsNumberPrimitiveFacts = TsNumberPrimitiveFacts {
  surface_spelling: ts_surface_spelling_number,
  ieee754_binary: ts_ieee754_binary64,
  std_projection: ts_std_projection_float64,
}

data ts_facts_bigint: TsBigIntPrimitiveFacts = TsBigIntPrimitiveFacts {
  surface_spelling: ts_surface_spelling_bigint,
  std_projection: ts_std_projection_bigint,
  encoding: ts_repr_bigint_exact_unbounded,
}

data ts_numeric_facts_catalog: List<TsEcma262NumericPrimitiveFactsUnion> = [
  TsNumericFactsNumber { facts: ts_facts_number },
  TsNumericFactsBigInt { facts: ts_facts_bigint }
]

data ts_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn ts_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn ts_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn ts_number_arithmetic_semantics_node() -> Node {
  ts_inhabitant_atom(id: ts_tag_number_ieee754_binary64)
}

fn ts_number_bitwise_semantics_node() -> Node {
  ts_inhabitant_atom(id: ts_tag_number_bitwise_int32_uint32)
}

fn ts_bigint_operation_semantics_node() -> Node {
  ts_inhabitant_atom(id: ts_tag_bigint_exact_unbounded)
}

fn ts_number_facts_node(facts: TsNumberPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ts_facts_field_arithmetic_semantics,
        target: ts_number_arithmetic_semantics_node()
      ),
      ts_named_edge(
        name: ts_facts_field_bitwise_semantics,
        target: ts_number_bitwise_semantics_node()
      ),
      ts_named_edge(
        name: ts_facts_field_width,
        target: ts_inhabitant_atom(id: ts_tag_bits64)
      ),
      ts_named_edge(
        name: ts_facts_field_ieee754_binary,
        target: ts_inhabitant_atom(id: facts.ieee754_binary)
      ),
      ts_named_edge(
        name: ts_facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn ts_bigint_facts_node(facts: TsBigIntPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ts_facts_field_operation_semantics,
        target: ts_bigint_operation_semantics_node()
      ),
      ts_named_edge(
        name: ts_facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      ),
      ts_named_edge(
        name: ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: facts.encoding)
      )
    ]
  }
}

fn ts_number_inhabitant_node(id: Symbol, facts: TsNumberPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ts_inhabitant_field_facts,
        target: ts_number_facts_node(facts: facts)
      )
    ]
  }
}

fn ts_bigint_inhabitant_node(id: Symbol, facts: TsBigIntPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ts_inhabitant_field_facts,
        target: ts_bigint_facts_node(facts: facts)
      )
    ]
  }
}

fn ts_inhabitant_number_node() -> Node {
  ts_number_inhabitant_node(id: ts_inhabitant_number, facts: ts_facts_number)
}

fn ts_inhabitant_bigint_node() -> Node {
  ts_bigint_inhabitant_node(id: ts_inhabitant_bigint, facts: ts_facts_bigint)
}

fn ts_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ts_inhabitant_field_number, target: ts_inhabitant_number_node()),
      ts_named_edge(name: ts_inhabitant_field_bigint, target: ts_inhabitant_bigint_node())
    ]
  }
}

fn ts_wave1_target_model() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: target_model_edge_declared_inhabitants,
        target: ts_declared_inhabitants_root()
      )
    ]
  }
}

fn ts_list_snoc_item<T>(xs: List<T>, item: T) -> List<T> {
  fold_list(
    xs: xs,
    empty: Cons { head: item, tail: Empty },
    cons: fn(rest, existing) {
      Cons { head: existing, tail: rest }
    }
  )
}

fn ts_catalog_surface_symbol_step(sym: Symbol, acc: Bool, row: TsEcma262NumericPrimitiveFactsUnion) -> Bool {
  match row {
    TsNumericFactsNumber { facts: f } => acc || sym == f.surface_spelling
    TsNumericFactsBigInt { facts: f } => acc || sym == f.surface_spelling
  }
}

fn ts_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: ts_numeric_facts_catalog,
    empty: false,
    cons: fn(acc, row) {
      ts_catalog_surface_symbol_step(sym: sym, acc: acc, row: row)
    }
  )
}

fn ts_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      ts_catalog_surface_symbol(sym: sym)
    }
  }
}

fn ts_primitive_fact_map_3(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node,
  axis2: Symbol,
  fact2: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(
      map_insert(empty_map(), axis0, fact0),
      axis1,
      fact1
    ),
    axis2,
    fact2
  )
}

fn ts_primitive_fact_map_2(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(empty_map(), axis0, fact0),
    axis1,
    fact1
  )
}

fn ts_primitive_bundle_from_number_facts(facts: TsNumberPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: ts_number_facts_node(facts: facts),
    spec_facts: ts_primitive_fact_map_3(
      axis0: primitive_fact_axis_surface_spelling,
      fact0: ts_inhabitant_atom(id: facts.surface_spelling),
      axis1: primitive_fact_axis_width,
      fact1: ts_inhabitant_atom(id: ts_tag_bits64),
      axis2: primitive_fact_axis_encoding,
      fact2: ts_inhabitant_atom(id: facts.ieee754_binary)
    )
  }
}

fn ts_primitive_bundle_from_bigint_facts(facts: TsBigIntPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: ts_bigint_facts_node(facts: facts),
    spec_facts: ts_primitive_fact_map_2(
      axis0: primitive_fact_axis_surface_spelling,
      fact0: ts_inhabitant_atom(id: facts.surface_spelling),
      axis1: primitive_fact_axis_encoding,
      fact1: ts_inhabitant_atom(id: facts.encoding)
    )
  }
}

fn ts_primitive_bundles_from_catalog_step(
  acc: List<PrimitiveFactBundle>,
  row: TsEcma262NumericPrimitiveFactsUnion
) -> List<PrimitiveFactBundle> {
  match row {
    TsNumericFactsNumber { facts: f } =>
      ts_list_snoc_item(
        xs: acc,
        item: ts_primitive_bundle_from_number_facts(facts: f)
      )
    TsNumericFactsBigInt { facts: f } =>
      ts_list_snoc_item(
        xs: acc,
        item: ts_primitive_bundle_from_bigint_facts(facts: f)
      )
  }
}

fn ts_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: ts_numeric_facts_catalog,
    empty: Empty,
    cons: fn(acc, row) {
      ts_primitive_bundles_from_catalog_step(acc: acc, row: row)
    }
  )
}

fn ts_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: ts_wave1_primitive_fact_bundles(),
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn ts_language_model_wave1() -> TsLanguageModel {
  TsLanguageModel {
    language_identity: ts_language_model_surface_id,
    canonical_symbols: ts_language_model_canonical_symbols(),
    core: ts_model_core_wave1()
  }
}
