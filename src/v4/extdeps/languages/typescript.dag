module v4.extdeps.languages.typescript

type TsEcma262SectionRef {
  url: String
  section: String
}

type TsScalarTowerSectionRefs {
  number_kind: TsEcma262SectionRef
  bigint_kind: TsEcma262SectionRef
  boolean_kind: TsEcma262SectionRef
  string_kind: TsEcma262SectionRef
  symbol_kind: TsEcma262SectionRef
  null_kind: TsEcma262SectionRef
  undefined_kind: TsEcma262SectionRef
  numeric_semantics: TsEcma262SectionRef
}

type TsNumberKind {}

type TsBigIntKind {}

// 🟢 coproduct dissolution — DECISIONS.md TS-SCALAR-PHASE3.
type TsNumberWidth
  = Ieee754Binary64
  | ToInt32
  | ToUint32

type TsBigIntWidth {}

// 🟢 coproduct dissolution — DECISIONS.md TS-SCALAR-PHASE3.
type TsScalar
  = NumberScalar { kind: TsNumberKind, width: TsNumberWidth }
  | BigIntScalar { kind: TsBigIntKind, width: TsBigIntWidth }
  | BooleanScalar
  | StringScalar
  | SymbolScalar
  | NullScalar
  | UndefinedScalar

// 🟢 coproduct dissolution — DECISIONS.md TS-SCALAR-PHASE3.
type TsEcma262PrimitiveOperationSemantics
  = TsNumberIeee754Binary64Semantics
  | TsNumberBitwiseInt32Semantics
  | TsNumberBitwiseUint32Semantics
  | TsBigIntExactUnboundedSemantics

