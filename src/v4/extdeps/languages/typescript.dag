// SG-2 — canonical per-connective TargetTypeExpressionProjection row for TypeScript.
// Single authority: carrier lives in v4.std.target_model; this is the per-language row only
// (no name-keyed Outcome/Witness/Refined special cases — INVARIANTS P3 / SG-2 worksheet).
// Connective → TS surface (ECMA / TS Handbook):
//   atom          ident / keyword primitive (number, string, boolean, ...)
//   conj          { ... }  structural surface only   (object type — see 🟡 record gap below)
//   disj          union A | B                        (primary sum-type surface)
//   arrow         (T) => U positional wire from source projection today; arrow_form param slots +
//                 TargetTypeExprArrowWireShape labeled serialize/decode staged on carrier — live
//                 (a: T) => U emission awaits target-arrow-domain-param-list-carrier (see 🟡 below)
// 🟡 gated — feature:target-arrow-domain-param-list-carrier — owner:Modeling DFS Arbiter — dissolve-on-arrival: substrate declares arrow-domain parameter-list vs record/product boundary and translate_project_type_expression_arrow calls target_type_expr_arrow_emitted_named (not target_type_expr_arrow_emitted) from source; until then forbidden: TS row claim or comment asserting live labeled-arrow emission from ordinary projected arrows.
//   cardinality   Head<args>  generic collection     (e.g. Set<T> — postfix head + angle brackets,
//                                                      mirrors Rust; the Cardinality source carries a
//                                                      head carrier, so a head-less tuple does not fit)
//   instantiation generic apply Foo<Bar, Baz>        (angle brackets — no Rust ::<>)
// 🟡 gated — feature:target-record-field-label-binding — carrier:TargetGenericApply conj_form (open/separator/close, no field-label `:` token) + serializer:serialize_type_expr_record_bounded (06_translate) drops slot labels; Rust conj_form identical — owner:Modeling DFS Arbiter — dissolve-on-arrival: carrier gains field-label-separator token AND the shared record serializer emits each slot's Named label + `:`, then TS records serialize as `{ id: T, ... }` — forbidden: redefining the shared carrier or the load-bearing 06_translate serializer in this row, or claiming faithful labeled `{ id: T }`. L0 SG-2 probe (Instantiation `Rc<FooBar<X,Y>>`) does not exercise record field-name fidelity. (rationale in PR #4176)
fn ts_type_expression_projection() -> TargetTypeExpressionProjection {
  TargetTypeExpressionProjection {
    atom_form: TargetAtomTypeShape {
      surface: ts_surface_type_atom,
      ident_token: ts_token_ident
    },
    conj_form: TargetGenericApply {
      surface: ts_surface_type_record,
      open: ts_token_lbrace,
      separator: ts_token_comma,
      close: ts_token_rbrace
    },
    disj_form: TargetSumTypeShape {
      surface: ts_surface_type_sum,
      variant_separator: ts_token_pipe
    },
    arrow_form: TargetFunctionTypeShape {
      surface: ts_surface_type_arrow,
      open: ts_token_lparen,
      close: ts_token_rparen,
      arrow: ts_token_fat_arrow,
      param_ident_token: ts_token_ident,
      param_type_separator: ts_token_colon,
      param_list_separator: ts_token_comma
    },
    cardinality_form: TargetGenericApply {
      surface: ts_surface_type_cardinality,
      open: ts_token_lt,
      separator: ts_token_comma,
      close: ts_token_gt
    },
    instantiation_form: TargetGenericApply {
      surface: ts_surface_type_generic_apply,
      open: ts_token_lt,
      separator: ts_token_comma,
      close: ts_token_gt
    }
  }
}

fn ts_type_expr_atom_shape_node(form: TargetAtomTypeShape) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: target_type_expr_field_surface, target: ts_inhabitant_atom(id: form.surface)),
      ts_named_edge(name: target_type_expr_field_ident_token, target: ts_inhabitant_atom(id: form.ident_token))
    ]
  }
}

fn ts_type_expr_generic_apply_shape_node(form: TargetGenericApply) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: target_type_expr_field_surface, target: ts_inhabitant_atom(id: form.surface)),
      ts_named_edge(name: target_type_expr_field_open, target: ts_inhabitant_atom(id: form.open)),
      ts_named_edge(name: target_type_expr_field_separator, target: ts_inhabitant_atom(id: form.separator)),
      ts_named_edge(name: target_type_expr_field_close, target: ts_inhabitant_atom(id: form.close))
    ]
  }
}

fn ts_type_expr_sum_shape_node(form: TargetSumTypeShape) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: target_type_expr_field_surface, target: ts_inhabitant_atom(id: form.surface)),
      ts_named_edge(name: target_type_expr_field_variant_separator, target: ts_inhabitant_atom(id: form.variant_separator))
    ]
  }
}

fn ts_type_expr_arrow_shape_node(form: TargetFunctionTypeShape) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: target_type_expr_field_surface, target: ts_inhabitant_atom(id: form.surface)),
      ts_named_edge(name: target_type_expr_field_open, target: ts_inhabitant_atom(id: form.open)),
      ts_named_edge(name: target_type_expr_field_close, target: ts_inhabitant_atom(id: form.close)),
      ts_named_edge(name: target_type_expr_field_arrow, target: ts_inhabitant_atom(id: form.arrow)),
      ts_named_edge(
        name: target_type_expr_field_param_ident_token,
        target: ts_inhabitant_atom(id: form.param_ident_token)
      ),
      ts_named_edge(
        name: target_type_expr_field_param_type_separator,
        target: ts_inhabitant_atom(id: form.param_type_separator)
      ),
      ts_named_edge(
        name: target_type_expr_field_param_list_separator,
        target: ts_inhabitant_atom(id: form.param_list_separator)
      )
    ]
  }
}

// TargetTypeExpressionProjection bundle node — one named edge per connective form, mirroring
// rust_type_expression_projection_bundle_node(). Decoded by std target_type_expr_* readers.
fn ts_type_expression_projection_bundle_node() -> Node {
  let row = ts_type_expression_projection()
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: target_type_expr_field_atom, target: ts_type_expr_atom_shape_node(form: row.atom_form)),
      ts_named_edge(name: target_type_expr_field_conj, target: ts_type_expr_generic_apply_shape_node(form: row.conj_form)),
      ts_named_edge(name: target_type_expr_field_disj, target: ts_type_expr_sum_shape_node(form: row.disj_form)),
      ts_named_edge(name: target_type_expr_field_arrow, target: ts_type_expr_arrow_shape_node(form: row.arrow_form)),
      ts_named_edge(name: target_type_expr_field_cardinality, target: ts_type_expr_generic_apply_shape_node(form: row.cardinality_form)),
      ts_named_edge(name: target_type_expr_field_instantiation, target: ts_type_expr_generic_apply_shape_node(form: row.instantiation_form))
    ]
  }
}

fn ts_target_atom_realization_target_model_staging() -> TargetModel {
  ts_sg2_type_expr_target_model()
}

data ts_target_atom_realization_bool: TargetAtomRealization = TargetAtomRealization {
  source_carrier: bool_node(),
  target_model: ts_target_atom_realization_target_model_staging(),
  type_form: ts_target_atom_type_form(spelling: ts_surface_spelling_boolean),
  value_form: target_value_template_for_kind(kind: ValueBoolLiteral),
  constructor_form: optional_absent(),
  display_name: bool_node_symbol
}

fn ts_std_text_string_type_node() -> Node {
  free_monoid_type_node(inhabitant: char_kernel_type_node())
}

data ts_target_atom_realization_string: TargetAtomRealization = TargetAtomRealization {
  source_carrier: ts_std_text_string_type_node(),
  target_model: ts_target_atom_realization_target_model_staging(),
  type_form: ts_target_atom_type_form(spelling: ts_surface_spelling_string),
  value_form: target_value_template_for_kind(kind: ValueStringLiteral),
  constructor_form: optional_absent(),
  display_name: ts_surface_spelling_string
}

data ts_target_atom_realization_catalog: List<TargetAtomRealization> = [
  ts_target_atom_realization_symbol,
  ts_target_atom_realization_bool,
  ts_target_atom_realization_string
]

// SG-2 lex: MVP-1 wave-1 rules plus the type-expression delimiter tokens this row references
// (angle brackets for instantiation + cardinality generic collections, union pipe, fat arrow).
// Additive — MVP-1 lex is untouched.
fn ts_sg2_type_expr_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: list_append(
      xs: ts_wave1_lex_rules().rules,
      ys: [
        ts_lex_rule(token_class: ts_token_lt, text: "<"),
        ts_lex_rule(token_class: ts_token_gt, text: ">"),
        ts_lex_rule(token_class: ts_token_pipe, text: " | "),
        ts_lex_rule(token_class: ts_token_fat_arrow, text: " => ")
      ]
    )
  }
}

fn ts_sg2_type_expr_lex() -> LexRules {
  ModeledLexRules { root: ts_sg2_type_expr_lex_rules() }
}

// SG-2 TargetModel bundle node — MVP-1 bundle plus the per-language type-expression projection
// edge. MVP-1 bundle stays on the ProjectionAbsent shim path until its own row lands, so this
// dedicated bundle drives the projection translate path. The MVP-1 bundle kind is the statically
// declared Conj of ts_mvp1_target_model_node(); we snoc the projection edge onto its children
// directly — no kind-match fallback arm, which would silently re-emit the projection-absent bundle
// (P3 plausible substitute) rather than fail closed on a malformed host.
fn ts_sg2_type_expr_target_model_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_snoc_item(
      xs: ts_mvp1_target_model_node().children,
      item: ts_named_edge(
        name: target_model_edge_type_expression_projection,
        target: ts_type_expression_projection_bundle_node()
      )
    )
  }
}

fn ts_target_atom_realization_target_model_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_snoc_item(
      xs: ts_sg2_type_expr_target_model_node().children,
      item: ts_named_edge(
        name: target_model_edge_atom_realizations,
        target: target_atom_realization_catalog_node(
          rows: ts_target_atom_realization_catalog,
          host_bundle: ts_sg2_type_expr_target_model_node()
        )
      )
    )
  }
}

