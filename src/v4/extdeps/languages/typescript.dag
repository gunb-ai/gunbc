      ts_binding_pr3_identity,
      "identity"
    ),
    ts_binding_sg2_foobar,
    "FooBar"
  )
}

fn ts_pr3_identity_target_model_witness() -> Witness<TargetModel> {
  match ts_pr3_identity_target_model_bundle_witness() {
    Holds { value: bundle } =>
      Holds {
        value: TargetModel {
          bundle: bundle,
          lex: ts_wave2a_lex(),
          binding_spellings: ts_pr3_identity_binding_spellings(),
          authority_source_text: ts_pr3_identity_source_text
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn ts_grammar_relation_row_node(row: TsGrammarRelationRow) -> Node {
  grammar_relation_row_to_node(
    row: derive_grammar_relation_row(production: row.production, emitted: row.emitted),
    tokens: Node {
      kind: TypeNode { connective: Conj },
      children: ts_relation_token_edges(tokens: row.tokens)
    }
  )
}

// MVP-1 add-fn target model: hand-built grammar-relation row (no derive witness on this path).
fn ts_mvp1_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ts_relation_rule_mvp1_fn_add,
        target: ts_grammar_relation_row_node(row: ts_mvp1_grammar_relation_row())
      )
    ]
  }
}

fn ts_mvp1_translation_rules_witness() -> Witness<Node> {
  match ts_wave2a_task_type_alias_relation_row_witness() {
