// SG-2 falsification probes — TypeScript surfaces beyond L0 row-2 (Conj): Instantiation, Arrow, Disj.
fn ts_sg2_foobar_xy_emitted() -> Node {
  target_type_expr_instantiation_emitted(
    form: ts_type_expression_projection().instantiation_form,
    head: target_type_expr_atom_emitted(
      form: ts_type_expression_projection().atom_form,
      identity: ts_binding_sg2_foobar
    ),
    args: [
      target_type_expr_atom_emitted(
        form: ts_type_expression_projection().atom_form,
        identity: ts_binding_sg2_x
      ),
      target_type_expr_atom_emitted(
        form: ts_type_expression_projection().atom_form,
        identity: ts_binding_sg2_y
      )
    ]
  )
}

fn ts_sg2_instantiation_source_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Instantiation },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ts_binding_sg2_foobar } },
          children: []
        }
      },
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Instantiation },
          children: [
            Edge {
              label: Positional,
              target: Node {
                kind: TypeNode { connective: Atom { identity: ts_binding_sg2_x } },
                children: []
              }
            },
            Edge {
              label: Positional,
              target: Node {
                kind: TypeNode { connective: Atom { identity: ts_binding_sg2_y } },
                children: []
              }
            }
          ]
        }
      }
    ]
  }
}

fn ts_sg2_atom_node(binding: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: binding } },
    children: []
  }
}

fn ts_sg2_arrow_xy_emitted() -> Node {
  target_type_expr_arrow_emitted(
    form: ts_type_expression_projection().arrow_form,
    inputs: Cons {
      head: target_type_expr_atom_emitted(
        form: ts_type_expression_projection().atom_form,
        identity: ts_binding_sg2_x
      ),
      tail: Empty
    },
    output: target_type_expr_atom_emitted(
      form: ts_type_expression_projection().atom_form,
      identity: ts_binding_sg2_y
    )
  )
}

fn ts_sg2_arrow_source_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: ts_sg2_atom_node(binding: ts_binding_sg2_x) },
      Edge { label: Positional, target: ts_sg2_atom_node(binding: ts_binding_sg2_y) }
    ]
  }
}

fn ts_sg2_binary_fn_source_type_node() -> Node {
  algebra_binary_fn_node(
    domain: ts_sg2_atom_node(binding: ts_binding_sg2_x),
    codomain: ts_sg2_atom_node(binding: ts_binding_sg2_y)
  )
}

fn ts_sg2_arrow_malformed_source_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: ts_sg2_atom_node(binding: ts_binding_sg2_x) }
    ]
  }
}

fn ts_sg2_conj_xy_emitted() -> Node {
  target_type_expr_record_emitted(
    form: ts_type_expression_projection().conj_form,
    fields: [
      TargetTypeExprFieldSlot {
