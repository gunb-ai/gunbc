      rhs: [grammar_formal_nonterminal_occurrence(identity: ts_production_pr3_array_type)]
    ),
    grammar_formal_production(
      lhs: ts_production_pr3_typed_param,
      rhs: [
        grammar_formal_terminal(identity: ts_token_ident),
        grammar_formal_terminal(identity: ts_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ts_production_wave2a_type_annotation)
      ]
    ),
    grammar_formal_production(
      lhs: ts_production_pr3_typed_params_opt,
      rhs: []
    ),
    grammar_formal_production(
      lhs: ts_production_pr3_typed_params_opt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ts_production_pr3_typed_params)]
    ),
    grammar_formal_production(
      lhs: ts_production_pr3_typed_params,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ts_production_pr3_typed_param)]
    ),
    grammar_formal_production(
      lhs: ts_production_pr3_typed_params,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ts_production_pr3_typed_param),
        grammar_formal_terminal(identity: ts_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ts_production_pr3_typed_params)
      ]
    ),
    grammar_formal_production(
      lhs: ts_production_pr3_typed_fn_decl,
      rhs: [
        grammar_formal_terminal(identity: ts_token_kw_function),
        grammar_formal_terminal(identity: ts_token_ident),
        grammar_formal_terminal(identity: ts_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ts_production_pr3_typed_params_opt),
        grammar_formal_terminal(identity: ts_token_rparen),
        grammar_formal_terminal(identity: ts_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ts_production_wave2a_type_annotation),
        grammar_formal_terminal(identity: ts_token_lbrace),
        grammar_formal_terminal(identity: ts_token_kw_return),
        grammar_formal_terminal(identity: ts_token_ident),
        grammar_formal_terminal(identity: ts_token_semicolon),
        grammar_formal_terminal(identity: ts_token_rbrace)
