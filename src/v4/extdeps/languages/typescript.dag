// TS string-literal discriminated union per TS handbook §Literal Types:
// `type T = 'A' | 'B' | 'C';`. Payload-free coproducts (e.g. TaskStatus from
// src/v4/test/fixture/task_manager_demo.dag) map cleanly to this surface; tagged
// object unions land in a later wave once arm payloads enter scope.
fn ts_grammar_production_wave2a_union_type() -> GrammarProduction {
  GrammarProduction {
    name: ts_production_wave2a_union_type,
    expression: Sequence {
      left: Terminal { token_class: ts_token_string_lit },
      right: Sequence {
        left: Sequence {
          left: Terminal { token_class: ts_token_pipe },
          right: Terminal { token_class: ts_token_string_lit }
        },
        right: Repeat {
          element: Sequence {
            left: Terminal { token_class: ts_token_pipe },
            right: Terminal { token_class: ts_token_string_lit }
          }
        }
      }
    },
    emitted: ts_grammar_atom(id: ts_surface_union_type)
  }
}

