fn ts_grammar_relation_row_token_edges_witness(row: Node) -> Witness<List<Edge>> {
  match find_named_child(root: row, name: grammar_relation_field_tokens) {
    Accepted { value: tokens_root, diagnostics: _ } =>
      match tokens_root.kind {
        TypeNode { connective: Conj } => Holds { value: tokens_root.children }
        _ =>
          Violates {
            diagnostic: Diagnostic {
              reason: grammar_relation_row_tokens_not_conj,
              at: node_locus(node: tokens_root),
              correction: Unavailable { reason: ExternalContractUnknown }
            }
          }
      }
    Rejected { diagnostics: nd } => Violates { diagnostic: nd.head }
  }
}

