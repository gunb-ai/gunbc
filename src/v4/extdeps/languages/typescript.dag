    ),
    grammar_formal_production(
      lhs: ts_production_wave2a_item,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ts_production_pr3_typed_fn_decl)]
    ),
    ts_formal_production_mvp1_fn_add()
  ]
}

