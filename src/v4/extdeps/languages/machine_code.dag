// src/v4/extdeps/languages/machine_code.dag
//
// Scope: machine-code language model parameterized by `Isa`. One file
//        models the common boundary; per-ISA files are out of scope.
// Anchor: Intel 64 & IA-32 Architectures Software Developer's Manual
//         2025 edition; Arm ARM 2025-03; RISC-V Unprivileged ISA 20240411.
//
// Owns:
//   - ISA-family, instruction, register, operand, and C5 boundary carriers.
//   - machine-code-specific operation-semantics carriers.
//
// Consumes:
//   - std/machine.dag `Byte`.
//   - std/integer.dag fixed-width integer carriers.
//
// Scope-negative: assembler macros, object files, relocation/linking, ABI
// calling conventions, and source-language type systems are out of scope.

module v4.extdeps.languages.machine_code


import v4.std.integer {
  Int8,
  Int16,
  Int32,
  Int64,
  Int128,
  UInt8,
  UInt16,
  UInt32,
  UInt64,
  UInt128
}
import v4.std.collection { List }
import v4.std.machine { Byte }
import v4.std.node { Symbol }


// ─────────────────────────────────────────────────────────────────────
// IsaFamily — the closed family discriminator for the first machine-code
// probe set. A future family is a visible L-2 revision edit here; it is
// never an opaque string escape hatch.
// Anchor: Intel 64 and IA-32 Architectures Software Developer's Manual
// 2025 edition; Arm Architecture Reference Manual for A-profile
// architecture 2025-03 edition; RISC-V Unprivileged ISA Specification
// version 20240411.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: encoding, register classes, and operand
//      rules all dispatch on ISA family.
//   2. Variant-is-data — FAILS: reducing to a Symbol would make the
//      closed spec family set stringly and uncheckable.
//   3. Algebraic form — N/A: this is an external spec family partition.
//   4. Dimensional — FAILS: an ISA revision belongs to exactly one
//      family in this model.
//   5. Parameterized family — FAILS: the families are not one uniform
//      width-indexed carrier; they have incompatible encoding schemes.
type IsaFamily
  = X86_64Isa
  | Aarch64Isa
  | RiscV64Isa


// Isa — parameter object for the one machine-code LanguageModel.
// `revision` is an opaque Symbol naming the pinned upstream spec edition
// (for example an Intel SDM revision, Arm ARM issue, or RISC-V unprivileged
// ISA release). The Symbol is a name-reference, not a readable string.
// Anchor: same version-pinned ISA manuals named on `IsaFamily`.
type Isa {
  family: IsaFamily
  revision: Symbol
}


// ─────────────────────────────────────────────────────────────────────
// ByteOrder — ISA byte order for multi-byte instruction fields.
// Anchor: Intel SDM 2025 instruction encoding; Arm ARM 2025-03 memory
// model / instruction encoding; RISC-V Unprivileged ISA 20240411 base
// instruction formats.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: decode/emit reads this uniformly for
//      immediate and displacement fields.
//   2. Variant-is-data — FAILS: Bool would erase which bit means which
//      order; Symbol would be stringly.
//   3. Algebraic form — N/A: external machine representation fact.
//   4. Dimensional — FAILS: one field has one byte order.
//   5. Parameterized family — FAILS: two nullary alternatives, not F<X>.
type ByteOrder
  = LittleEndian
  | BigEndian


// ─────────────────────────────────────────────────────────────────────
// InstructionLength — fixed-width vs variable-width instruction streams.
// Anchor: Intel SDM 2025 instruction format; Arm ARM 2025-03 instruction
// encoding; RISC-V Unprivileged ISA 20240411 instruction-length encoding.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: tokenization/decoding consumes this at
//      the instruction boundary.
//   2. Variant-is-data — FAILS: `Fixed` carries a word width while
//      `Variable` carries an ISA-scoped byte-limit reference; flattening
//      makes illegal combinations representable.
//   3. Algebraic form — N/A: encoding-shape fact from the ISA spec.
//   4. Dimensional — FAILS: an instruction stream uses exactly one
//      length discipline at a decode point.
//   5. Parameterized family — FAILS: heterogeneous payloads.
type InstructionLength
  = FixedLength { width: InstructionWord }
  | VariableLength { max_bytes: InstructionByteLimitRef }


// InstructionByteLimitRef — opaque reference to an ISA-declared maximum
// encoded-instruction byte length. This covers non-word-sized limits such
// as x86's 15-byte maximum without inventing a local Nat authority.
// Anchor: Intel SDM 2025 instruction format; RISC-V Unprivileged ISA
// 20240411 instruction-length encoding.
type InstructionByteLimitRef {
  isa: Isa,
  limit: Symbol
}


// OperandFieldWidthRef — opaque reference to an ISA-declared operand or
// displacement field width. This is separate from InstructionByteLimitRef:
// whole-instruction byte maxima and operand-field widths are different
// ISA facts with different authorities.
// Anchor: RISC-V Unprivileged ISA Specification 20240411, Chapter 1
// instruction formats; Intel SDM Vol. 2A §3.1 instruction format.
type OperandFieldWidthRef {
  isa: Isa,
  width: Symbol
}


// InstructionWord — admissible instruction-word / maximum-length width
// tokens. This carrier records the width category selected by the ISA
// production; raw bytes are owned by encoding/decoding operation results.
// Anchor: Intel SDM 2025 instruction format; Arm ARM 2025-03 instruction
// encoding; RISC-V Unprivileged ISA 20240411 instruction-length encoding.
//
// Coproduct dissolution — 🟡 TRACKED-SCAFFOLD. Ledger:
//   1. Fact placement — FAILS: encoded-width decisions are shared by
//      grammar, cost, and disassembly.
//   2. Variant-is-data — PARTIAL: a Nat byte-count would be tempting,
//      but fixed-cardinality list refinement is not landed; the std/
//      machine word names supply the current width vocabulary without
//      carrying arbitrary word values.
//   3. Algebraic form — N/A: representation width, not algebra.
//   4. Dimensional — FAILS: exactly one width token is selected.
//   5. Parameterized family — DEFERRED: dissolves when bounded Nat-indexed
//      width carriers land; until then the std/machine word aliases are
//      the grounded width vocabulary. Named trigger: fixed-cardinality /
//      Nat-indexed width carrier lands in std/machine.dag or
//      std/cardinality.dag.
type InstructionWord
  = Instr16
  | Instr32
  | Instr64
  | Instr128


// ─────────────────────────────────────────────────────────────────────
// RegisterClass — ISA register-file classifier.
// Anchor: Intel SDM 2025 registers chapter; Arm ARM 2025-03 register
// descriptions; RISC-V Unprivileged ISA 20240411 programmer's model.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: operand legality, calling convention
//      consumers, and cost all read register class.
//   2. Variant-is-data — FAILS: width alone cannot distinguish vector,
//      predicate/flags, floating, and control registers.
//   3. Algebraic form — PARTIAL: integer/float aliases ground through
//      std/ carriers; the register file classifier itself is ISA surface.
//   4. Dimensional — FAILS: a concrete register occurrence has exactly
//      one class.
//   5. Parameterized family — FAILS: heterogeneous register semantics.
type RegisterClass
  = GeneralPurposeRegister
  | FloatingPointRegister
  | VectorRegister
  | PredicateRegister
  | FlagsRegister
  | ControlRegister


type RegisterRef {
  register: Symbol
}


// IndexScale — legal scale factors for scaled indexed addressing in the
// first ISA probe set. The production table decides where a scaled index is
// legal; this carrier prevents arbitrary byte values from masquerading as
// scale factors.
// Anchor: Intel SDM 2025 addressing modes; Arm ARM 2025-03 load/store
// addressing modes.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: decode, emit, and address calculation all
//      share scale-factor legality.
//   2. Variant-is-data — FAILS: `MachineU8` admits impossible factors.
//   3. Algebraic form — N/A: addressing-mode syntax, not algebra.
//   4. Dimensional — FAILS: a scaled index has exactly one factor.
//   5. Parameterized family — FAILS: closed nullary factors, not F<X>.
type IndexScale
  = Scale1
  | Scale2
  | Scale4
  | Scale8


// ─────────────────────────────────────────────────────────────────────
// AddressingMode — core machine addressing forms shared by the first
// ISA probe set. ISA-specific sub-modes remain grammar productions over
// these fields, not a second addressing taxonomy.
// Anchor: Intel SDM 2025 addressing modes; Arm ARM 2025-03 load/store
// addressing modes; RISC-V Unprivileged ISA 20240411 load/store formats.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: operand decode and memory-effect lenses
//      share this classifier.
//   2. Variant-is-data — FAILS: variants have different required fields;
//      a single record would admit immediate+base+pc-relative mixtures.
//   3. Algebraic form — N/A: machine addressing surface fact.
//   4. Dimensional — FAILS: one operand occurrence has one address form.
//   5. Parameterized family — FAILS: heterogeneous payloads.
type AddressingMode
  = AbsoluteAddress { displacement: MachineI64 }
  | RegisterIndirect { base: RegisterRef }
  | BaseDisplacement { base: RegisterRef, displacement: MachineI32 }
  | BaseIndexScale { base: RegisterRef, index: RegisterRef, scale: IndexScale, displacement: MachineI32 }
  | PcRelative { displacement: MachineI32 }


// Operand — instruction operand shape. `RegisterRef` names are resolved
// relative to the enclosing `InstructionProductionRef`/operand slot, so
// the production remains the single ISA authority. `Immediate` is
// byte-carried here: interpreting those bytes as signed/unsigned/float is
// selected by the instruction production plus D2 alias target, not by
// duplicating an algebra row on the operand itself.
// Anchor: version-pinned ISA instruction-format sections named above.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: decode, emit, and operand legality all
//      branch on the same operand shape.
//   2. Variant-is-data — FAILS: variants carry heterogeneous payloads;
//      a flat record would admit register+immediate+memory mixtures.
//   3. Algebraic form — N/A: instruction operand syntax is ISA surface.
//   4. Dimensional — FAILS: one operand occurrence is register OR
//      immediate OR memory.
//   5. Parameterized family — FAILS: not one F<X>; payloads differ by
//      operand category.
type Operand
  = RegisterOperand { register: RegisterRef }
  | ImmediateOperand { bytes: ByteSequence, order: ByteOrder }
  | MemoryOperand { mode: AddressingMode }


type ByteSequence {
  bytes: List<Byte>
}


// InstructionProductionRef — opaque reference to a declared ISA grammar
// production. `opcode` is not a free spelling authority; it is resolved
// in the namespace of the pinned `isa` production table.
type InstructionProductionRef {
  isa: Isa
  opcode: Symbol
}


type RegisterOperandSlotRef {
  slot: Symbol
}


type ImmediateOperandSlotRef {
  slot: Symbol
}


type MemoryOperandSlotRef {
  slot: Symbol
}


// ImmediateOperandTarget — semantic target class for an immediate field.
// Anchor: RISC-V Unprivileged ISA Specification 20240411, Chapter 1
// instruction formats; Intel SDM Vol. 2A §3.1 instruction format.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: decode, branch-target analysis, and emit
//      all distinguish literal immediates from relative targets.
//   2. Variant-is-data — FAILS: Bool/Symbol would erase the target role.
//   3. Algebraic form — N/A: ISA operand-field role.
//   4. Dimensional — FAILS: one immediate slot has one target class.
//   5. Parameterized family — FAILS: closed nullary alternatives.
type ImmediateOperandTarget
  = LiteralImmediate
  | PcRelativeImmediate
  | AbsoluteAddressImmediate


type ImmediateOperandConstraint {
  width: OperandFieldWidthRef
  order: ByteOrder
  target: ImmediateOperandTarget
}


// MemoryOperandConstraint — ISA grammar constraint for a memory operand
// slot. This is the slot schema; `AddressingMode` remains the decoded
// operand value that instantiates one compatible schema.
// Anchor: Intel SDM 2025 addressing modes; Arm ARM 2025-03 load/store
// addressing modes; RISC-V Unprivileged ISA 20240411 load/store formats.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: decode, emit, and memory-effect analysis
//      read the same addressing-form constraint.
//   2. Variant-is-data — FAILS: each form carries different register and
//      displacement constraints; a flat record would admit impossible
//      mixtures.
//   3. Algebraic form — N/A: ISA addressing grammar fact.
//   4. Dimensional — FAILS: one memory slot constrains one addressing
//      form.
//   5. Parameterized family — FAILS: heterogeneous payloads.
type MemoryOperandConstraint
  = AbsoluteAddressSlot { displacement_width: OperandFieldWidthRef }
  | RegisterIndirectSlot { allowed_bases: List<RegisterRef> }
  | BaseDisplacementSlot {
      allowed_bases: List<RegisterRef>,
      displacement_width: OperandFieldWidthRef
    }
  | BaseIndexScaleSlot {
      allowed_bases: List<RegisterRef>,
      allowed_indexes: List<RegisterRef>,
      scale: IndexScale,
      displacement_width: OperandFieldWidthRef
    }
  | PcRelativeSlot { displacement_width: OperandFieldWidthRef }


// InstructionOperandSlot — operand-category authority for a declared
// production slot. This is not an operand value; it is the ISA grammar
// row's slot and constraint classifier consumed by decoded operand
// bindings. Category-specific slot refs keep decoded operands tied to a
// compatible production slot instead of a free Symbol.
// Anchor: RISC-V Unprivileged ISA Specification 20240411, Chapter 1
// instruction formats; Intel SDM Vol. 2A §3.1 instruction format.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: decode, emit, and operand legality all
//      read the same production-slot classifier.
//   2. Variant-is-data — FAILS: slots carry category-specific
//      constraints; a flat record would admit register+immediate+memory
//      mixtures or optional holes.
//   3. Algebraic form — N/A: ISA grammar production fact.
//   4. Dimensional — FAILS: one production slot accepts one operand
//      category in this L-2 model.
//   5. Parameterized family — FAILS: heterogeneous payloads.
type InstructionOperandSlot
  = RegisterInstructionSlot {
      name: RegisterOperandSlotRef,
      allowed_registers: List<RegisterRef>
    }
  | ImmediateInstructionSlot {
      name: ImmediateOperandSlotRef,
      constraint: ImmediateOperandConstraint
    }
  | MemoryInstructionSlot {
      name: MemoryOperandSlotRef,
      constraint: MemoryOperandConstraint
    }


type InstructionProduction {
  reference: InstructionProductionRef
  slots: List<InstructionOperandSlot>
}


// OperandBinding — decoded operand value tied to a category-specific slot
// in the instruction production. Slot refs are resolved through
// `production`, not independent readable labels; the variant keeps the
// operand value category aligned with the declared slot category.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: decode, emit, and operand legality all
//      consume the same category-specific binding.
//   2. Variant-is-data — FAILS: variants carry different slot refs and
//      payloads; a flat record would admit category mismatches.
//   3. Algebraic form — N/A: ISA grammar operand binding fact.
//   4. Dimensional — FAILS: one decoded operand is register OR immediate
//      OR memory.
//   5. Parameterized family — FAILS: heterogeneous payloads.
type OperandBinding
  = RegisterOperandBinding {
      slot: RegisterOperandSlotRef,
      register: RegisterRef
    }
  | ImmediateOperandBinding {
      slot: ImmediateOperandSlotRef,
      bytes: ByteSequence
    }
  | MemoryOperandBinding {
      slot: MemoryOperandSlotRef,
      mode: AddressingMode
    }


// DecodedInstruction — one decoded instruction in structural form.
// The production reference is the authority for opcode and operand-slot
// legality; operand bindings instantiate that production rather than
// forming a free opcode/list pair. Raw bytes are realized by the
// encoding/decoding operations, not stored here as a second peer
// representation that can drift from the structural instruction.
type DecodedInstruction {
  production: InstructionProductionRef
  operands: List<OperandBinding>
}


// ─────────────────────────────────────────────────────────────────────
// MachineFidelityFeature / MachineFidelityDisposition — the machine-code
// C5 boundary as data. Disassembly failures are first-class feature
// classes; the generic walker emits diagnostics from these, never a
// guessed instruction.
// Anchor: version-pinned ISA instruction decoding / reserved-encoding
// rules named above.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: disassembly, emit, and C5 diagnostics read
//      the same feature classifier.
//   2. Variant-is-data — FAILS: Symbol/string would make the boundary open
//      and uncheckable.
//   3. Algebraic form — N/A: C5 fidelity-boundary taxonomy.
//   4. Dimensional — FAILS: one boundary decision names one feature class.
//   5. Parameterized family — FAILS: heterogeneous feature classes.
type MachineFidelityFeature
  = ValidInstructionEncoding
  | InstructionAliasSpelling
  | PaddingByteRun
  | UndecodableByteRun
  | PrivilegedOrUndefinedEncoding
  | IsaRevisionMismatch
  | AmbiguousDecode


// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: modeled / normalized / fail-closed is the
//      shared machine-code C5 disposition.
//   2. Variant-is-data — FAILS: the non-modeled variants carry a feature
//      payload; a flat record would admit modeled-with-failure-feature.
//   3. Algebraic form — N/A: C5 boundary partition.
//   4. Dimensional — FAILS: one feature has exactly one disposition.
//   5. Parameterized family — FAILS: heterogeneous payloads.
type MachineFidelityDisposition
  = MachineModeled
  | MachineDeclaredNormalized { feature: MachineFidelityFeature }
  | MachineFailClosed { feature: MachineFidelityFeature }


fn machine_feature_disposition(f: MachineFidelityFeature) -> MachineFidelityDisposition {
  match f {
    ValidInstructionEncoding => MachineModeled
    InstructionAliasSpelling => MachineDeclaredNormalized { feature: InstructionAliasSpelling }
    PaddingByteRun => MachineDeclaredNormalized { feature: PaddingByteRun }
    UndecodableByteRun => MachineFailClosed { feature: UndecodableByteRun }
    PrivilegedOrUndefinedEncoding => MachineFailClosed { feature: PrivilegedOrUndefinedEncoding }
    IsaRevisionMismatch => MachineFailClosed { feature: IsaRevisionMismatch }
    AmbiguousDecode => MachineFailClosed { feature: AmbiguousDecode }
  }
}


// ─────────────────────────────────────────────────────────────────────
// Machine integer instruction operation semantics.
// Anchor: Intel SDM 2025 arithmetic instruction semantics; Arm ARM
// 2025-03 integer instruction pseudocode; RISC-V Unprivileged ISA
// 20240411 integer computational instructions.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: integer operation semantics and lowering
//      read this overflow classifier uniformly.
//   2. Variant-is-data — FAILS: Bool cannot distinguish wrap, trap, and
//      undefined ISA behavior.
//   3. Algebraic form — PARTIAL: wrapping maps to std/integer fixed-width
//      carrier behavior through D2 aliases; trap/undefined are target
//      operation semantics, not algebra inhabitance.
//   4. Dimensional — FAILS: one arithmetic operation has one overflow
//      behavior; flag writes are a separate coordinate below.
//   5. Parameterized family — FAILS: closed semantic alternatives, not a
//      width-indexed family.
type MachineIntegerOverflowBehavior
  = WrapModuloWidth
  | TrapOnOverflow
  | UndefinedByIsa


type MachineIntegerOperationSemantics<IRCarrier> {
  overflow: MachineIntegerOverflowBehavior
  writes_flags: FlagWriteDisposition
}


// FlagWriteDisposition — separate coordinate for architectural flags /
// predicate writes. It is intentionally not an overflow alternative:
// instructions can wrap/trap/leave overflow undefined and independently
// write or not write flags.
//
// Coproduct dissolution — 🟢 GREEN (terminal). Ledger:
//   1. Fact placement — FAILS: consumers checking condition-code
//      dependencies read this shared coordinate.
//   2. Variant-is-data — FAILS: Bool cannot distinguish flags vs
//      predicate-register writes.
//   3. Algebraic form — N/A: target operation side-effect surface.
//   4. Dimensional — FAILS: one instruction has one flag-write
//      disposition.
//   5. Parameterized family — FAILS: closed side-effect alternatives.
type FlagWriteDisposition
  = DoesNotWriteFlags
  | WritesArchitecturalFlags
  | WritesPredicateRegister


// ─────────────────────────────────────────────────────────────────────
// Machine integer primitive aliases.
// Anchor: version-pinned ISA integer operand width definitions named
// above.
type MachineI8 = Int8
type MachineI16 = Int16
type MachineI32 = Int32
type MachineI64 = Int64
type MachineI128 = Int128

type MachineU8 = UInt8
type MachineU16 = UInt16
type MachineU32 = UInt32
type MachineU64 = UInt64
type MachineU128 = UInt128


