// src/v4/extdeps/languages/machine_code.dag
// Scope: machine-code language model parameterized by Isa.
// Owns: Isa, ByteOrder, InstructionLength, InstructionByteLimitRef, OperandFieldWidthRef, GroundingMap, MachineIntKind, MachineIntWidth, MachineScalar, MachineI8, machine_i8_grounding, MachineI16, machine_i16_grounding, MachineI32, machine_i32_grounding, MachineI64, machine_i64_grounding, MachineI128, machine_i128_grounding, MachineU8, machine_u8_grounding, MachineU16, machine_u16_grounding, MachineU32, machine_u32_grounding, MachineU64, machine_u64_grounding, MachineU128, machine_u128_grounding, InstructionWord, RegisterClass, RegisterDeclaration, RegisterRef, IndexScale, AddressingMode, Operand, ByteSequence, InstructionProductionRef, RegisterOperandSlotRef, ImmediateOperandSlotRef, MemoryOperandSlotRef, ImmediateOperandTarget, ImmediateOperandConstraint, MemoryOperandConstraint, InstructionOperandSlot, InstructionProduction, OperandBinding, DecodedInstruction, MachineFidelityFeature, MachineFidelityDisposition, MachineIntegerOverflowBehavior, MachineIntegerOperationSemantics, FlagWriteDisposition.
// Consumes: Int8, Int16, Int32, Int64, Int128, UInt8, UInt16, UInt32, UInt64, UInt128, List, Byte, Symbol, String.
// Status: D2-REV / Practice 8 — `MachineScalar` kind×width bundle + std coincidence via `GroundingMap` (rust.dag template; P4-3208 / #3208).

module v4.extdeps.languages.machine_code


import v4.extdeps.languages.rust { GroundingMap }
import v4.std.integer {
  Int8,
  Int16,
  Int32,
  Int64,
  Int128,
  UInt8,
  UInt16,
  UInt32,
  UInt64,
  UInt128
}
import v4.std.collection { List }
import v4.std.machine { Byte }
import v4.std.node { Symbol }
import v4.std.text { String }


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type Isa
  = X86_64Isa { revision: Symbol }
  | Aarch64Isa { revision: Symbol }
  | RiscV64Isa { revision: Symbol }


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type ByteOrder
  = LittleEndian
  | BigEndian


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type InstructionLength
  = FixedLength { width: InstructionWord }
  | VariableLength { max_bytes: InstructionByteLimitRef }


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
type InstructionByteLimitRef {
  isa: Isa,
  limit: Symbol
}


// Anchor: https://github.com/riscv/riscv-isa-manual/releases/tag/20240411
type OperandFieldWidthRef {
  isa: Isa,
  width: Symbol
}


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type MachineIntKind
  = Signed
  | Unsigned


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type MachineIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Bits128


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type MachineScalar
  = IntScalar { kind: MachineIntKind, width: MachineIntWidth }


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
type MachineI8 = Int8

data machine_i8_grounding: GroundingMap<MachineI8> = GroundingMap {
  spelling: "i8"
}


type MachineI16 = Int16

data machine_i16_grounding: GroundingMap<MachineI16> = GroundingMap {
  spelling: "i16"
}


type MachineI32 = Int32

data machine_i32_grounding: GroundingMap<MachineI32> = GroundingMap {
  spelling: "i32"
}


type MachineI64 = Int64

data machine_i64_grounding: GroundingMap<MachineI64> = GroundingMap {
  spelling: "i64"
}


type MachineI128 = Int128

data machine_i128_grounding: GroundingMap<MachineI128> = GroundingMap {
  spelling: "i128"
}


type MachineU8 = UInt8

data machine_u8_grounding: GroundingMap<MachineU8> = GroundingMap {
  spelling: "u8"
}


type MachineU16 = UInt16

data machine_u16_grounding: GroundingMap<MachineU16> = GroundingMap {
  spelling: "u16"
}


type MachineU32 = UInt32

data machine_u32_grounding: GroundingMap<MachineU32> = GroundingMap {
  spelling: "u32"
}


type MachineU64 = UInt64

data machine_u64_grounding: GroundingMap<MachineU64> = GroundingMap {
  spelling: "u64"
}


type MachineU128 = UInt128

data machine_u128_grounding: GroundingMap<MachineU128> = GroundingMap {
  spelling: "u128"
}


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟡 feature:fixed-cardinality-width-carrier — DECISIONS.md P4-3208
type InstructionWord
  = Instr16
  | Instr32
  | Instr64
  | Instr128


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type RegisterClass
  = GeneralPurposeRegister
  | FloatingPointRegister
  | VectorRegister
  | PredicateRegister
  | FlagsRegister
  | ControlRegister


type RegisterDeclaration {
  isa: Isa
  name: Symbol
  class: RegisterClass
}


type RegisterRef {
  declaration: RegisterDeclaration
}


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type IndexScale
  = Scale1
  | Scale2
  | Scale4
  | Scale8


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type AddressingMode
  = AbsoluteAddress { displacement: MachineI64 }
  | RegisterIndirect { base: RegisterRef }
  | BaseDisplacement { base: RegisterRef, displacement: MachineI32 }
  | BaseIndexScale { base: RegisterRef, index: RegisterRef, scale: IndexScale, displacement: MachineI32 }
  | PcRelative { displacement: MachineI32 }


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type Operand
  = RegisterOperand { register: RegisterRef }
  | ImmediateOperand { bytes: ByteSequence, order: ByteOrder }
  | MemoryOperand { mode: AddressingMode }


type ByteSequence {
  bytes: List<Byte>
}


type InstructionProductionRef {
  isa: Isa
  opcode: Symbol
}


type RegisterOperandSlotRef {
  slot: Symbol
}


type ImmediateOperandSlotRef {
  slot: Symbol
}


type MemoryOperandSlotRef {
  slot: Symbol
}


// Anchor: https://github.com/riscv/riscv-isa-manual/releases/tag/20240411
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type ImmediateOperandTarget
  = LiteralImmediate
  | PcRelativeImmediate
  | AbsoluteAddressImmediate


type ImmediateOperandConstraint {
  width: OperandFieldWidthRef
  order: ByteOrder
  target: ImmediateOperandTarget
}


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type MemoryOperandConstraint
  = AbsoluteAddressSlot { displacement_width: OperandFieldWidthRef }
  | RegisterIndirectSlot { allowed_bases: List<RegisterRef> }
  | BaseDisplacementSlot {
      allowed_bases: List<RegisterRef>,
      displacement_width: OperandFieldWidthRef
    }
  | BaseIndexScaleSlot {
      allowed_bases: List<RegisterRef>,
      allowed_indexes: List<RegisterRef>,
      scale: IndexScale,
      displacement_width: OperandFieldWidthRef
    }
  | PcRelativeSlot { displacement_width: OperandFieldWidthRef }


// Anchor: https://github.com/riscv/riscv-isa-manual/releases/tag/20240411
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type InstructionOperandSlot
  = RegisterInstructionSlot {
      name: RegisterOperandSlotRef,
      allowed_registers: List<RegisterRef>
    }
  | ImmediateInstructionSlot {
      name: ImmediateOperandSlotRef,
      constraint: ImmediateOperandConstraint
    }
  | MemoryInstructionSlot {
      name: MemoryOperandSlotRef,
      constraint: MemoryOperandConstraint
    }


type InstructionProduction {
  reference: InstructionProductionRef
  slots: List<InstructionOperandSlot>
}


// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type OperandBinding
  = RegisterOperandBinding {
      slot: RegisterOperandSlotRef,
      register: RegisterRef
    }
  | ImmediateOperandBinding {
      slot: ImmediateOperandSlotRef,
      bytes: ByteSequence
    }
  | MemoryOperandBinding {
      slot: MemoryOperandSlotRef,
      mode: AddressingMode
    }


type DecodedInstruction {
  production: InstructionProductionRef
  operands: List<OperandBinding>
}


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type MachineFidelityFeature
  = ValidInstructionEncoding
  | InstructionAliasSpelling
  | PaddingByteRun
  | UndecodableByteRun
  | PrivilegedOrUndefinedEncoding
  | IsaRevisionMismatch
  | AmbiguousDecode


// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type MachineFidelityDisposition
  = MachineModeled
  | MachineDeclaredNormalized { feature: MachineFidelityFeature }
  | MachineFailClosed { feature: MachineFidelityFeature }


fn machine_feature_disposition(f: MachineFidelityFeature) -> MachineFidelityDisposition {
  match f {
    ValidInstructionEncoding => MachineModeled
    InstructionAliasSpelling => MachineDeclaredNormalized { feature: InstructionAliasSpelling }
    PaddingByteRun => MachineDeclaredNormalized { feature: PaddingByteRun }
    UndecodableByteRun => MachineFailClosed { feature: UndecodableByteRun }
    PrivilegedOrUndefinedEncoding => MachineFailClosed { feature: PrivilegedOrUndefinedEncoding }
    IsaRevisionMismatch => MachineFailClosed { feature: IsaRevisionMismatch }
    AmbiguousDecode => MachineFailClosed { feature: AmbiguousDecode }
  }
}


// Anchor: https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type MachineIntegerOverflowBehavior
  = WrapModuloWidth
  | TrapOnOverflow
  | UndefinedByIsa


type MachineIntegerOperationSemantics<IRCarrier> {
  overflow: MachineIntegerOverflowBehavior
  writes_flags: FlagWriteDisposition
}


// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type FlagWriteDisposition
  = DoesNotWriteFlags
  | WritesArchitecturalFlags
  | WritesPredicateRegister

