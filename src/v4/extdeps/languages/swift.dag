// src/v4/extdeps/languages/swift.dag
// Scope: Swift language/standard-library scalar fact-bundles and ModelCore wave-1.
// Owns: SwiftIntWidth, SwiftScalar, SwiftIntegerPrimitiveFacts, SwiftFloatPrimitiveFacts, SwiftNonNumericPrimitiveFacts, SwiftLanguageModel, swift_*_facts, swift_model_core_wave1, swift_language_model_wave1.
// Consumes: v4.std.collection, v4.std.model_core, v4.std.node, v4.std.logic, v4.std.algebra.
// Status: T-4 Swift wave-1; fixed-width integer spellings are explicit, Int/UInt stay platform-word-width facts, Float/Double carry IEEE-754 precision, bool canonical-B decl-ref is E-6(b) staging.
// Anchor: https://docs.swift.org/swift-book/documentation/the-swift-programming-language/thebasics/

module v4.extdeps.languages.swift

import v4.std.collection { List, Map, Set, list_append, list_snoc_item }
import v4.std.model_core {
  EffectSemanticsDecl,
  ModelCore,
  PartialitySemanticsDecl,
  PrimitiveFactBundle,
  primitive_fact_axis_encoding,
  primitive_fact_axis_overflow_disposition,
  primitive_fact_axis_signedness,
  primitive_fact_axis_surface_spelling,
  primitive_fact_axis_width
}
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.logic { Bool, bool_boolean_algebra }
import v4.std.algebra { BooleanAlgebra, fold_list }

// 🟢 coproduct dissolution — alternatives are one-at-a-time scalar widths.
type SwiftIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | PointerWord

// 🟢 coproduct dissolution — alternatives are signedness facts.
type SwiftIntSignedness
  = Signed
  | Unsigned

// 🟢 coproduct dissolution — alternatives are one-at-a-time floating widths.
type SwiftFloatWidth
  = Bits32
  | Bits64

type SwiftStringRepresentation {}

type SwiftCharacterRepresentation {}

type SwiftUnitRepresentation {}

type SwiftBoolRepresentation {}

type SwiftIntegerOverflowSemantics {}

// 🟢 coproduct dissolution — one scalar classifier at a time.
type SwiftScalar
  = IntScalar { signedness: SwiftIntSignedness, width: SwiftIntWidth }
  | FloatScalar { width: SwiftFloatWidth }
  | BoolScalar
  | CharacterScalar
  | StringScalar
  | VoidScalar

type SwiftIntegerPrimitiveFacts {
  surface_spelling: Symbol
  signedness: SwiftIntSignedness
  width: SwiftIntWidth
  overflow: SwiftIntegerOverflowSemantics
}

type SwiftFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: SwiftFloatWidth
  ieee754_binary: Symbol
}

// Nonnumeric primitive rows — each arm carries its matching representation (P2).
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SwiftNonNumericPrimitiveFacts
  = SwiftBoolPrimitiveFacts {
      surface_spelling: Symbol
      representation: SwiftBoolRepresentation
    }
  | SwiftCharacterPrimitiveFacts {
      surface_spelling: Symbol
      representation: SwiftCharacterRepresentation
    }
  | SwiftStringPrimitiveFacts {
      surface_spelling: Symbol
      representation: SwiftStringRepresentation
    }
  | SwiftVoidPrimitiveFacts {
      surface_spelling: Symbol
      representation: SwiftUnitRepresentation
    }

type SwiftLanguageModel {
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

data swift_language_model_surface_id: Symbol = swift_language_model_surface_id

data swift_surface_spelling_int: Symbol = swift_surface_spelling_int
data swift_surface_spelling_int8: Symbol = swift_surface_spelling_int8
data swift_surface_spelling_int16: Symbol = swift_surface_spelling_int16
data swift_surface_spelling_int32: Symbol = swift_surface_spelling_int32
data swift_surface_spelling_int64: Symbol = swift_surface_spelling_int64
data swift_surface_spelling_uint: Symbol = swift_surface_spelling_uint
data swift_surface_spelling_uint8: Symbol = swift_surface_spelling_uint8
data swift_surface_spelling_uint16: Symbol = swift_surface_spelling_uint16
data swift_surface_spelling_uint32: Symbol = swift_surface_spelling_uint32
data swift_surface_spelling_uint64: Symbol = swift_surface_spelling_uint64
data swift_surface_spelling_float: Symbol = swift_surface_spelling_float
data swift_surface_spelling_double: Symbol = swift_surface_spelling_double
data swift_surface_spelling_bool: Symbol = swift_surface_spelling_bool
data swift_surface_spelling_character: Symbol = swift_surface_spelling_character
data swift_surface_spelling_string: Symbol = swift_surface_spelling_string
data swift_surface_spelling_void: Symbol = swift_surface_spelling_void

data swift_facts_field_surface_spelling: Symbol = swift_facts_field_surface_spelling
data swift_facts_field_signedness: Symbol = swift_facts_field_signedness
data swift_facts_field_width: Symbol = swift_facts_field_width
data swift_facts_field_overflow: Symbol = swift_facts_field_overflow
data swift_facts_field_ieee754_binary: Symbol = swift_facts_field_ieee754_binary
data swift_facts_field_scalar: Symbol = swift_facts_field_scalar
data swift_facts_field_value_fact: Symbol = swift_facts_field_value_fact

data swift_primitive_fact_axis_scalar_classifier: Symbol = swift_primitive_fact_axis_scalar_classifier

data swift_tag_signed: Symbol = swift_tag_signed
data swift_tag_unsigned: Symbol = swift_tag_unsigned
data swift_tag_bits8: Symbol = swift_tag_bits8
data swift_tag_bits16: Symbol = swift_tag_bits16
data swift_tag_bits32: Symbol = swift_tag_bits32
data swift_tag_bits64: Symbol = swift_tag_bits64
data swift_tag_pointer_word: Symbol = swift_tag_pointer_word
data swift_tag_trap_on_overflow: Symbol = swift_tag_trap_on_overflow
data swift_tag_ieee754_binary32: Symbol = swift_tag_ieee754_binary32
data swift_tag_ieee754_binary64: Symbol = swift_tag_ieee754_binary64
data swift_tag_bool_representation: Symbol = swift_tag_bool_representation
data swift_tag_character_extended_grapheme_cluster: Symbol = swift_tag_character_extended_grapheme_cluster
data swift_tag_string_unicode_text: Symbol = swift_tag_string_unicode_text
data swift_tag_void_empty_tuple: Symbol = swift_tag_void_empty_tuple
data swift_tag_scalar_int: Symbol = swift_tag_scalar_int
data swift_tag_scalar_float: Symbol = swift_tag_scalar_float
data swift_tag_scalar_bool: Symbol = swift_tag_scalar_bool
data swift_tag_scalar_character: Symbol = swift_tag_scalar_character
data swift_tag_scalar_string: Symbol = swift_tag_scalar_string
data swift_tag_scalar_void: Symbol = swift_tag_scalar_void

data swift_integer_overflow_trap: SwiftIntegerOverflowSemantics = SwiftIntegerOverflowSemantics {}
data swift_bool_representation: SwiftBoolRepresentation = SwiftBoolRepresentation {}
data swift_character_representation: SwiftCharacterRepresentation = SwiftCharacterRepresentation {}
data swift_string_representation: SwiftStringRepresentation = SwiftStringRepresentation {}
data swift_unit_representation: SwiftUnitRepresentation = SwiftUnitRepresentation {}

data swift_facts_int: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_int,
  signedness: Signed,
  width: PointerWord,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_int8: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_int8,
  signedness: Signed,
  width: Bits8,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_int16: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_int16,
  signedness: Signed,
  width: Bits16,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_int32: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_int32,
  signedness: Signed,
  width: Bits32,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_int64: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_int64,
  signedness: Signed,
  width: Bits64,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_uint,
  signedness: Unsigned,
  width: PointerWord,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint8: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_uint8,
  signedness: Unsigned,
  width: Bits8,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint16: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_uint16,
  signedness: Unsigned,
  width: Bits16,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint32: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_uint32,
  signedness: Unsigned,
  width: Bits32,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_uint64: SwiftIntegerPrimitiveFacts = SwiftIntegerPrimitiveFacts {
  surface_spelling: swift_surface_spelling_uint64,
  signedness: Unsigned,
  width: Bits64,
  overflow: swift_integer_overflow_trap,
}

data swift_facts_float: SwiftFloatPrimitiveFacts = SwiftFloatPrimitiveFacts {
  surface_spelling: swift_surface_spelling_float,
  width: Bits32,
  ieee754_binary: swift_tag_ieee754_binary32,
}

data swift_facts_double: SwiftFloatPrimitiveFacts = SwiftFloatPrimitiveFacts {
  surface_spelling: swift_surface_spelling_double,
  width: Bits64,
  ieee754_binary: swift_tag_ieee754_binary64,
}

data swift_facts_bool: SwiftNonNumericPrimitiveFacts = SwiftBoolPrimitiveFacts {
  surface_spelling: swift_surface_spelling_bool,
  representation: swift_bool_representation,
}

data swift_facts_character: SwiftNonNumericPrimitiveFacts = SwiftCharacterPrimitiveFacts {
  surface_spelling: swift_surface_spelling_character,
  representation: swift_character_representation,
}

