  surface_spelling: swift_surface_spelling_void,
  representation: swift_unit_representation,
}

data swift_integer_facts_catalog: List<SwiftIntegerPrimitiveFacts> = [
  swift_facts_int,
  swift_facts_int8,
  swift_facts_int16,
  swift_facts_int32,
  swift_facts_int64,
  swift_facts_uint,
  swift_facts_uint8,
  swift_facts_uint16,
  swift_facts_uint32,
  swift_facts_uint64
]

data swift_float_facts_catalog: List<SwiftFloatPrimitiveFacts> = [
  swift_facts_float,
  swift_facts_double
]

data swift_nonnumeric_facts_catalog: List<SwiftNonNumericPrimitiveFacts> = [
  swift_facts_bool,
  swift_facts_character,
  swift_facts_string,
  swift_facts_void
]

// 🟡 canonical-B decl-ref · E-6(b) bounded-exception · scaffold feature:canonical-b-grounding-consumer · dissolve-on: B1-CANON+zip-fold consume the Swift bool row for coincidence-checking.
data swift_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn swift_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn swift_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn swift_signedness_node(signedness: SwiftIntSignedness) -> Node {
  match signedness {
    Signed => swift_atom(id: swift_tag_signed)
    Unsigned => swift_atom(id: swift_tag_unsigned)
  }
}

fn swift_width_node(width: SwiftIntWidth) -> Node {
  match width {
    Bits8 => swift_atom(id: swift_tag_bits8)
    Bits16 => swift_atom(id: swift_tag_bits16)
    Bits32 => swift_atom(id: swift_tag_bits32)
    Bits64 => swift_atom(id: swift_tag_bits64)
    PointerWord => swift_atom(id: swift_tag_pointer_word)
  }
}

fn swift_float_width_node(width: SwiftFloatWidth) -> Node {
  match width {
    Bits32 => swift_atom(id: swift_tag_bits32)
    Bits64 => swift_atom(id: swift_tag_bits64)
  }
}

fn swift_overflow_node(overflow: SwiftIntegerOverflowSemantics) -> Node {
  let _witness = overflow
  swift_atom(id: swift_tag_trap_on_overflow)
}

fn swift_scalar_node(scalar: SwiftScalar) -> Node {
  match scalar {
    IntScalar { signedness: _, width: _ } => swift_atom(id: swift_tag_scalar_int)
    FloatScalar { width: _ } => swift_atom(id: swift_tag_scalar_float)
    BoolScalar => swift_atom(id: swift_tag_scalar_bool)
    CharacterScalar => swift_atom(id: swift_tag_scalar_character)
    StringScalar => swift_atom(id: swift_tag_scalar_string)
    VoidScalar => swift_atom(id: swift_tag_scalar_void)
  }
}

fn swift_nonnumeric_representation_node(facts: SwiftNonNumericPrimitiveFacts) -> Node {
  match facts {
    SwiftBoolPrimitiveFacts { representation: _ } =>
      swift_atom(id: swift_tag_bool_representation)
    SwiftCharacterPrimitiveFacts { representation: _ } =>
      swift_atom(id: swift_tag_character_extended_grapheme_cluster)
    SwiftStringPrimitiveFacts { representation: _ } =>
      swift_atom(id: swift_tag_string_unicode_text)
    SwiftVoidPrimitiveFacts { representation: _ } =>
      swift_atom(id: swift_tag_void_empty_tuple)
  }
}

fn swift_nonnumeric_scalar_classifier_node(facts: SwiftNonNumericPrimitiveFacts) -> Node {
  match facts {
    SwiftBoolPrimitiveFacts { representation: _ } => swift_atom(id: swift_tag_scalar_bool)
    SwiftCharacterPrimitiveFacts { representation: _ } => swift_atom(id: swift_tag_scalar_character)
    SwiftStringPrimitiveFacts { representation: _ } => swift_atom(id: swift_tag_scalar_string)
    SwiftVoidPrimitiveFacts { representation: _ } => swift_atom(id: swift_tag_scalar_void)
  }
}

fn swift_integer_facts_node(facts: SwiftIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: swift_facts_field_surface_spelling,
        target: swift_atom(id: facts.surface_spelling)
      ),
      swift_named_edge(
        name: swift_facts_field_signedness,
        target: swift_signedness_node(signedness: facts.signedness)
      ),
      swift_named_edge(
        name: swift_facts_field_width,
        target: swift_width_node(width: facts.width)
      ),
      swift_named_edge(
        name: swift_facts_field_overflow,
        target: swift_overflow_node(overflow: facts.overflow)
      )
    ]
  }
}

fn swift_float_facts_node(facts: SwiftFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: swift_facts_field_surface_spelling,
        target: swift_atom(id: facts.surface_spelling)
      ),
      swift_named_edge(
        name: swift_facts_field_width,
        target: swift_float_width_node(width: facts.width)
      ),
      swift_named_edge(
        name: swift_facts_field_ieee754_binary,
        target: swift_atom(id: facts.ieee754_binary)
      )
    ]
  }
}

fn swift_nonnumeric_surface_spelling(facts: SwiftNonNumericPrimitiveFacts) -> Symbol {
  match facts {
    SwiftBoolPrimitiveFacts { surface_spelling, representation: _ } => surface_spelling
    SwiftCharacterPrimitiveFacts { surface_spelling, representation: _ } => surface_spelling
    SwiftStringPrimitiveFacts { surface_spelling, representation: _ } => surface_spelling
    SwiftVoidPrimitiveFacts { surface_spelling, representation: _ } => surface_spelling
  }
}

fn swift_nonnumeric_facts_node(facts: SwiftNonNumericPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      swift_named_edge(
        name: swift_facts_field_surface_spelling,
        target: swift_atom(id: swift_nonnumeric_surface_spelling(facts: facts))
      ),
      swift_named_edge(
        name: swift_facts_field_scalar,
        target: swift_nonnumeric_scalar_classifier_node(facts: facts)
      ),
      swift_named_edge(
        name: swift_facts_field_value_fact,
        target: swift_nonnumeric_representation_node(facts: facts)
      )
    ]
  }
}

fn swift_primitive_fact_map_4(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node,
  axis2: Symbol,
  fact2: Node,
  axis3: Symbol,
  fact3: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(empty_map(), axis0, fact0),
        axis1,
        fact1
      ),
      axis2,
      fact2
    ),
    axis3,
    fact3
  )
}

fn swift_primitive_fact_map_3(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node,
  axis2: Symbol,
  fact2: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(
      map_insert(empty_map(), axis0, fact0),
      axis1,
      fact1
    ),
    axis2,
    fact2
  )
}

fn swift_primitive_fact_map_2(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(empty_map(), axis0, fact0),
    axis1,
    fact1
  )
}

fn swift_primitive_bundle_from_integer_facts(facts: SwiftIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: swift_integer_facts_node(facts: facts),
    spec_facts: swift_primitive_fact_map_4(
      axis0: primitive_fact_axis_surface_spelling,
      fact0: swift_atom(id: facts.surface_spelling),
      axis1: primitive_fact_axis_signedness,
      fact1: swift_signedness_node(signedness: facts.signedness),
      axis2: primitive_fact_axis_width,
      fact2: swift_width_node(width: facts.width),
      axis3: primitive_fact_axis_overflow_disposition,
      fact3: swift_overflow_node(overflow: facts.overflow)
    )
  }
}

fn swift_primitive_bundle_from_float_facts(facts: SwiftFloatPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: swift_float_facts_node(facts: facts),
    spec_facts: swift_primitive_fact_map_3(
      axis0: primitive_fact_axis_surface_spelling,
      fact0: swift_atom(id: facts.surface_spelling),
      axis1: primitive_fact_axis_width,
      fact1: swift_float_width_node(width: facts.width),
      axis2: primitive_fact_axis_encoding,
      fact2: swift_atom(id: facts.ieee754_binary)
    )
  }
}

fn swift_primitive_bundle_from_nonnumeric_facts(
  facts: SwiftNonNumericPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: swift_nonnumeric_facts_node(facts: facts),
    spec_facts: swift_primitive_fact_map_2(
      axis0: primitive_fact_axis_surface_spelling,
      fact0: swift_atom(id: swift_nonnumeric_surface_spelling(facts: facts)),
      axis1: swift_primitive_fact_axis_scalar_classifier,
      fact1: swift_nonnumeric_scalar_classifier_node(facts: facts)
    )
  }
}

fn swift_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: swift_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: swift_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn swift_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: swift_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: swift_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn swift_primitive_bundles_from_nonnumeric_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: swift_nonnumeric_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: swift_primitive_bundle_from_nonnumeric_facts(facts: facts)
      )
    }
  )
}

fn swift_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  list_append(
    left: list_append(
      left: swift_primitive_bundles_from_integer_catalog(),
      right: swift_primitive_bundles_from_float_catalog()
    ),
    right: swift_primitive_bundles_from_nonnumeric_catalog()
  )
}

fn swift_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: SwiftIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn swift_float_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: SwiftFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn swift_nonnumeric_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: SwiftNonNumericPrimitiveFacts
) -> Bool {
  acc || sym == swift_nonnumeric_surface_spelling(facts: facts)
}

fn swift_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: swift_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      swift_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn swift_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: swift_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      swift_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn swift_nonnumeric_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: swift_nonnumeric_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      swift_nonnumeric_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn swift_catalog_surface_symbol(sym: Symbol) -> Bool {
  swift_integer_catalog_surface_symbol(sym: sym) ||
    swift_float_catalog_surface_symbol(sym: sym) ||
    swift_nonnumeric_catalog_surface_symbol(sym: sym)
}

fn swift_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      swift_catalog_surface_symbol(sym: sym)
    }
  }
}

fn swift_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: swift_wave1_primitive_fact_bundles(),
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn swift_language_model_wave1() -> SwiftLanguageModel {
  SwiftLanguageModel {
    language_identity: swift_language_model_surface_id,
    canonical_symbols: swift_language_model_canonical_symbols(),
    core: swift_model_core_wave1()
  }
}
