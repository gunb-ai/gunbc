type DagLanguageModel {
  lex: LexRules
  grammar: ParseGrammar
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
}


fn dag_keyword_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: KeywordPattern { text: text }
  }
}


fn dag_literal_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}


fn dag_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}


fn dag_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: dag_token_ident,
    pattern: dag_ident_lex_pattern()
  }
}


fn dag_int_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: dag_token_int_literal,
    pattern: OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
  }
}


fn dag_string_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: dag_token_string_literal,
    pattern: DelimitedPattern {
      open: LiteralPattern { text: "\"" },
      body: RepeatPattern { element: CharClassPattern { class: StringTextChar } },
      close: LiteralPattern { text: "\"" }
    }
  }
}


fn dag_whitespace_trivia_rule() -> LexRule {
  TriviaRule {
    pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } }
  }
}


fn dag_line_comment_trivia_rule() -> LexRule {
  TriviaRule {
    pattern: SequencePattern {
      left: LiteralPattern { text: "//" },
      right: RepeatPattern { element: CharClassPattern { class: LineCommentTextChar } }
    }
  }
}


fn dag_block_comment_trivia_rule() -> LexRule {
  TriviaRule {
    pattern: DelimitedPattern {
      open: LiteralPattern { text: "/*" },
      body: ChoicePattern {
        left: CharClassPattern { class: BlockCommentTextChar },
        right: CharPattern { char: 42 }
      },
      close: LiteralPattern { text: "*/" }
    }
  }
}


fn dag_wave1_lex_rules() -> LexRuleSet {
  // Rule order is load-bearing: lex_try_rules prefers the later rule on equal-length
  // matches, so ident must precede keywords and specific literals that must win ties.
  LexRuleSet {
    rules: [
      dag_whitespace_trivia_rule(),
      dag_line_comment_trivia_rule(),
      dag_block_comment_trivia_rule(),
      dag_string_literal_lex_rule(),
      dag_int_literal_lex_rule(),
      dag_ident_lex_rule(),
      dag_keyword_lex_rule(token_class: dag_token_kw_module, text: "module"),
      dag_keyword_lex_rule(token_class: dag_token_kw_import, text: "import"),
      dag_keyword_lex_rule(token_class: dag_token_kw_type, text: "type"),
      dag_keyword_lex_rule(token_class: dag_token_kw_data, text: "data"),
      dag_keyword_lex_rule(token_class: dag_token_kw_fn, text: "fn"),
      dag_keyword_lex_rule(token_class: dag_token_kw_let, text: "let"),
      dag_keyword_lex_rule(token_class: dag_token_kw_match, text: "match"),
      dag_keyword_lex_rule(token_class: dag_token_kw_if, text: "if"),
      dag_keyword_lex_rule(token_class: dag_token_kw_then, text: "then"),
      dag_keyword_lex_rule(token_class: dag_token_kw_else, text: "else"),
      dag_keyword_lex_rule(token_class: dag_token_kw_true, text: "true"),
      dag_keyword_lex_rule(token_class: dag_token_kw_false, text: "false"),
      dag_literal_lex_rule(token_class: dag_token_arrow, text: "->"),
      dag_literal_lex_rule(token_class: dag_token_fat_arrow, text: "=>"),
      dag_literal_lex_rule(token_class: dag_token_eq_eq, text: "=="),
      dag_literal_lex_rule(token_class: dag_token_neq, text: "!="),
      dag_literal_lex_rule(token_class: dag_token_gte, text: ">="),
      dag_literal_lex_rule(token_class: dag_token_lte, text: "<="),
      dag_literal_lex_rule(token_class: dag_token_or_or, text: "||"),
      dag_literal_lex_rule(token_class: dag_token_and_and, text: "&&"),
      dag_literal_lex_rule(token_class: dag_token_pipe_gt, text: "|>"),
      dag_literal_lex_rule(token_class: dag_token_plus, text: "+"),
      dag_literal_lex_rule(token_class: dag_token_minus, text: "-"),
      dag_literal_lex_rule(token_class: dag_token_star, text: "*"),
      dag_literal_lex_rule(token_class: dag_token_slash, text: "/"),
      dag_literal_lex_rule(token_class: dag_token_percent, text: "%"),
      dag_literal_lex_rule(token_class: dag_token_bang, text: "!"),
      dag_literal_lex_rule(token_class: dag_token_eq, text: "="),
      dag_literal_lex_rule(token_class: dag_token_colon, text: ":"),
      dag_literal_lex_rule(token_class: dag_token_comma, text: ","),
      dag_literal_lex_rule(token_class: dag_token_dot, text: "."),
      dag_literal_lex_rule(token_class: dag_token_pipe, text: "|"),
      dag_literal_lex_rule(token_class: dag_token_lbrace, text: "{"),
      dag_literal_lex_rule(token_class: dag_token_rbrace, text: "}"),
      dag_literal_lex_rule(token_class: dag_token_lparen, text: "("),
      dag_literal_lex_rule(token_class: dag_token_rparen, text: ")"),
      dag_literal_lex_rule(token_class: dag_token_lbracket, text: "["),
      dag_literal_lex_rule(token_class: dag_token_rbracket, text: "]"),
      dag_literal_lex_rule(token_class: dag_token_lt, text: "<"),
      dag_literal_lex_rule(token_class: dag_token_gt, text: ">")
    ]
  }
}


fn dag_wave1_lex() -> LexRules {
  ModeledLexRules { root: dag_wave1_lex_rules() }
}


fn dag_grammar_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: id }
    },
    children: []
  }
}


fn dag_named_edge(name: Symbol, target: Node) -> Edge {
  Edge {
    label: Named { name: name },
    target: target
  }
}


fn dag_positional_edge(target: Node) -> Edge {
  Edge {
    label: Positional,
    target: target
  }
}


fn emit_fixed_token(token_class: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: concrete_syntax_token_field_kind,
        target: dag_grammar_atom(id: concrete_syntax_token_kind_fixed)
      ),
      dag_named_edge(
        name: concrete_syntax_token_field_class,
        target: dag_grammar_atom(id: token_class)
      )
    ]
  }
}


fn emit_bound_token(token_class: Symbol, binding: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: concrete_syntax_token_field_kind,
        target: dag_grammar_atom(id: concrete_syntax_token_kind_bound)
      ),
      dag_named_edge(
        name: concrete_syntax_token_field_class,
        target: dag_grammar_atom(id: token_class)
      ),
      dag_named_edge(
        name: concrete_syntax_token_field_binding,
        target: dag_grammar_atom(id: binding)
      )
    ]
  }
}


fn emit_relation_token_edges(tokens: List<Node>) -> List<Edge> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(xs: acc, item: dag_positional_edge(target: token))
    }
  )
}


fn emit_grammar_relation_row(
  production: GrammarProduction,
  emitted: Node,
  tokens: List<Node>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: grammar_relation_field_production,
        target: dag_grammar_atom(id: production.name)
      ),
      dag_named_edge(
        name: grammar_relation_field_emitted,
        target: emitted
      ),
      dag_named_edge(
        name: grammar_relation_field_tokens,
        target: Node {
          kind: TypeNode { connective: Conj },
          children: emit_relation_token_edges(tokens: tokens)
        }
      )
    ]
  }
}


fn dag_formal_terminal(token_class: Symbol) -> FormalGrammarSymbol {
  FormalTerminalOccurrence { terminal: FormalTerminal { identity: token_class } }
}

fn dag_formal_nonterminal(production: Symbol) -> FormalGrammarSymbol {
  FormalNonterminalOccurrence { nonterminal: FormalNonterminal { identity: production } }
}

fn dag_formal_production(lhs: Symbol, rhs: List<FormalGrammarSymbol>) -> FormalProduction {
  FormalProduction {
    lhs: FormalNonterminal { identity: lhs },
    rhs: rhs
  }
}

// Canonical CFG: flat FormalProduction rhs (choice/optional/repeat as multi-rule expansions).
fn dag_wave1_formal_productions() -> List<FormalProduction> {
  [
    dag_formal_production(
      lhs: dag_production_qualified_name,
      rhs: [dag_formal_terminal(token_class: dag_token_ident)]
    ),
    dag_formal_production(
      lhs: dag_production_qualified_name,
      rhs: [
        dag_formal_nonterminal(production: dag_production_qualified_name),
        dag_formal_terminal(token_class: dag_token_dot),
        dag_formal_terminal(token_class: dag_token_ident)
      ]
    ),
    dag_formal_production(lhs: dag_production_import_block_items, rhs: [dag_formal_terminal(token_class: dag_token_ident)]),
    dag_formal_production(
      lhs: dag_production_import_block_items,
      rhs: [
        dag_formal_terminal(token_class: dag_token_ident),
        dag_formal_terminal(token_class: dag_token_comma),
        dag_formal_terminal(token_class: dag_token_ident),
        dag_formal_nonterminal(production: dag_production_import_block_items_suffix)
      ]
    ),
    dag_formal_production(lhs: dag_production_import_block_items_suffix, rhs: []),
    dag_formal_production(
      lhs: dag_production_import_block_items_suffix,
      rhs: [
        dag_formal_terminal(token_class: dag_token_comma),
        dag_formal_terminal(token_class: dag_token_ident),
        dag_formal_nonterminal(production: dag_production_import_block_items_suffix)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_import_block,
      rhs: [
        dag_formal_terminal(token_class: dag_token_lbrace),
        dag_formal_nonterminal(production: dag_production_import_block_items),
        dag_formal_terminal(token_class: dag_token_rbrace)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_import_decl,
      rhs: [
        dag_formal_terminal(token_class: dag_token_kw_import),
        dag_formal_nonterminal(production: dag_production_qualified_name)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_import_decl,
      rhs: [
        dag_formal_terminal(token_class: dag_token_kw_import),
        dag_formal_nonterminal(production: dag_production_qualified_name),
        dag_formal_nonterminal(production: dag_production_import_block)
      ]
    ),
    dag_formal_production(lhs: dag_production_generic_params_items, rhs: [dag_formal_terminal(token_class: dag_token_ident)]),
    dag_formal_production(
      lhs: dag_production_generic_params_items,
      rhs: [
        dag_formal_terminal(token_class: dag_token_ident),
        dag_formal_terminal(token_class: dag_token_comma),
        dag_formal_terminal(token_class: dag_token_ident),
        dag_formal_nonterminal(production: dag_production_generic_params_items_suffix)
      ]
    ),
    dag_formal_production(lhs: dag_production_generic_params_items_suffix, rhs: []),
    dag_formal_production(
      lhs: dag_production_generic_params_items_suffix,
      rhs: [
        dag_formal_terminal(token_class: dag_token_comma),
        dag_formal_terminal(token_class: dag_token_ident),
        dag_formal_nonterminal(production: dag_production_generic_params_items_suffix)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_generic_params,
