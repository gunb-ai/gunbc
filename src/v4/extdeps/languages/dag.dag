        dag_formal_terminal(token_class: dag_token_lparen),
        dag_formal_terminal(token_class: dag_token_rparen),
        dag_formal_terminal(token_class: dag_token_arrow),
        dag_formal_nonterminal(production: dag_production_type_expr),
        dag_formal_nonterminal(production: dag_production_fn_body)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_fn_literal,
      rhs: [
        dag_formal_terminal(token_class: dag_token_kw_fn),
        dag_formal_terminal(token_class: dag_token_lparen),
        dag_formal_nonterminal(production: dag_production_untyped_params),
        dag_formal_terminal(token_class: dag_token_rparen),
        dag_formal_terminal(token_class: dag_token_arrow),
        dag_formal_nonterminal(production: dag_production_type_expr),
        dag_formal_nonterminal(production: dag_production_fn_body)
      ]
    ),
    dag_formal_production(lhs: dag_production_primary_expr, rhs: [dag_formal_terminal(token_class: dag_token_ident)]),
    dag_formal_production(
      lhs: dag_production_primary_expr,
      rhs: [
        dag_formal_terminal(token_class: dag_token_ident),
        dag_formal_terminal(token_class: dag_token_lparen),
        dag_formal_nonterminal(production: dag_production_arg_list),
        dag_formal_terminal(token_class: dag_token_rparen)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_primary_expr,
      rhs: [
        dag_formal_terminal(token_class: dag_token_ident),
        dag_formal_terminal(token_class: dag_token_lbrace),
        dag_formal_nonterminal(production: dag_production_field_init_list),
        dag_formal_terminal(token_class: dag_token_rbrace)
      ]
    ),
    dag_formal_production(lhs: dag_production_primary_expr, rhs: [dag_formal_terminal(token_class: dag_token_int_literal)]),
    dag_formal_production(lhs: dag_production_primary_expr, rhs: [dag_formal_terminal(token_class: dag_token_string_literal)]),
    dag_formal_production(lhs: dag_production_primary_expr, rhs: [dag_formal_terminal(token_class: dag_token_kw_true)]),
    dag_formal_production(lhs: dag_production_primary_expr, rhs: [dag_formal_terminal(token_class: dag_token_kw_false)]),
    dag_formal_production(
      lhs: dag_production_primary_expr,
      rhs: [
        dag_formal_terminal(token_class: dag_token_lbracket),
        dag_formal_nonterminal(production: dag_production_field_init_list),
        dag_formal_terminal(token_class: dag_token_rbracket)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_primary_expr,
      rhs: [
        dag_formal_terminal(token_class: dag_token_lbrace),
        dag_formal_nonterminal(production: dag_production_field_init_list),
        dag_formal_terminal(token_class: dag_token_rbrace)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_primary_expr,
      rhs: [
        dag_formal_terminal(token_class: dag_token_lparen),
        dag_formal_nonterminal(production: dag_production_expr),
        dag_formal_terminal(token_class: dag_token_rparen)
      ]
    ),
    dag_formal_production(lhs: dag_production_postfix_suffix, rhs: []),
    dag_formal_production(
      lhs: dag_production_postfix_suffix,
      rhs: [
        dag_formal_nonterminal(production: dag_production_postfix_suffix),
        dag_formal_terminal(token_class: dag_token_dot),
        dag_formal_terminal(token_class: dag_token_ident)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_postfix_suffix,
      rhs: [
        dag_formal_nonterminal(production: dag_production_postfix_suffix),
        dag_formal_terminal(token_class: dag_token_dot),
        dag_formal_terminal(token_class: dag_token_ident),
        dag_formal_terminal(token_class: dag_token_lparen),
        dag_formal_nonterminal(production: dag_production_arg_list),
        dag_formal_terminal(token_class: dag_token_rparen)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_postfix_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_primary_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_postfix_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_primary_expr),
        dag_formal_nonterminal(production: dag_production_postfix_suffix)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_unary_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_postfix_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_unary_expr,
      rhs: [
        dag_formal_terminal(token_class: dag_token_bang),
        dag_formal_nonterminal(production: dag_production_unary_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_multiplicative_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_unary_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_multiplicative_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_multiplicative_expr),
        dag_formal_terminal(token_class: dag_token_star),
        dag_formal_nonterminal(production: dag_production_unary_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_multiplicative_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_multiplicative_expr),
        dag_formal_terminal(token_class: dag_token_slash),
        dag_formal_nonterminal(production: dag_production_unary_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_multiplicative_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_multiplicative_expr),
        dag_formal_terminal(token_class: dag_token_percent),
        dag_formal_nonterminal(production: dag_production_unary_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_additive_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_multiplicative_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_additive_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_additive_expr),
        dag_formal_terminal(token_class: dag_token_plus),
        dag_formal_nonterminal(production: dag_production_multiplicative_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_additive_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_additive_expr),
        dag_formal_terminal(token_class: dag_token_minus),
        dag_formal_nonterminal(production: dag_production_multiplicative_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_comparison_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_additive_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_comparison_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_additive_expr),
        dag_formal_terminal(token_class: dag_token_gte),
        dag_formal_nonterminal(production: dag_production_additive_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_comparison_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_additive_expr),
        dag_formal_terminal(token_class: dag_token_lte),
        dag_formal_nonterminal(production: dag_production_additive_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_comparison_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_additive_expr),
        dag_formal_terminal(token_class: dag_token_lt),
        dag_formal_nonterminal(production: dag_production_additive_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_comparison_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_additive_expr),
        dag_formal_terminal(token_class: dag_token_gt),
        dag_formal_nonterminal(production: dag_production_additive_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_equality_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_comparison_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_equality_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_comparison_expr),
        dag_formal_terminal(token_class: dag_token_eq_eq),
        dag_formal_nonterminal(production: dag_production_comparison_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_equality_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_comparison_expr),
        dag_formal_terminal(token_class: dag_token_neq),
        dag_formal_nonterminal(production: dag_production_comparison_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_and_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_equality_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_and_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_and_expr),
        dag_formal_terminal(token_class: dag_token_and_and),
        dag_formal_nonterminal(production: dag_production_equality_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_or_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_and_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_or_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_or_expr),
        dag_formal_terminal(token_class: dag_token_or_or),
        dag_formal_nonterminal(production: dag_production_and_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_binary_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_or_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_binary_expr,
      rhs: [
        dag_formal_nonterminal(production: dag_production_binary_expr),
        dag_formal_terminal(token_class: dag_token_pipe_gt),
        dag_formal_nonterminal(production: dag_production_or_expr)
      ]
    ),
    dag_formal_production(
      lhs: dag_production_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_match_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_if_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_fn_literal)]
    ),
    dag_formal_production(
      lhs: dag_production_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_block_expr)]
    ),
    dag_formal_production(
      lhs: dag_production_expr,
      rhs: [dag_formal_nonterminal(production: dag_production_binary_expr)]
    )
  ]
}

fn dag_formal_production_matches_lhs(production: FormalProduction, lhs: Symbol) -> Bool {
  production.lhs.identity == lhs
}

fn dag_formal_production_list_has_lhs(productions: List<FormalProduction>, lhs: Symbol) -> Bool {
  fold_list(
    xs: productions,
    empty: false,
    cons: fn(found, production) {
      found || dag_formal_production_matches_lhs(production: production, lhs: lhs)
    }
  )
}

fn dag_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}


fn dag_grammar_nonterminal(production: Symbol) -> GrammarExpr {
  Nonterminal { production: production }
}


fn dag_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}


fn dag_grammar_choice(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Choice { left: left, right: right }
}


fn dag_grammar_optional(element: GrammarExpr) -> GrammarExpr {
  Optional { element: element }
}


fn dag_grammar_repeat(element: GrammarExpr) -> GrammarExpr {
  Repeat { element: element }
}


fn dag_grammar_comma_list_expr(item: GrammarExpr) -> GrammarExpr {
  dag_grammar_sequence(
    left: item,
    right: dag_grammar_sequence(
      left: dag_grammar_repeat(
        element: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: dag_token_comma),
          right: item
        )
      ),
      right: dag_grammar_optional(element: dag_grammar_terminal(token_class: dag_token_comma))
    )
  )
}


fn dag_grammar_module_header_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_module),
    right: dag_grammar_nonterminal(production: dag_production_qualified_name)
  )
}


fn dag_grammar_qualified_name_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_ident),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_dot),
        right: dag_grammar_terminal(token_class: dag_token_ident)
      )
    )
  )
}


fn dag_grammar_generic_params_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_lt),
    right: dag_grammar_sequence(
      left: dag_grammar_comma_list_expr(item: dag_grammar_terminal(token_class: dag_token_ident)),
      right: dag_grammar_terminal(token_class: dag_token_gt)
    )
  )
}


fn dag_grammar_typed_param_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_ident),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_colon),
      right: dag_grammar_nonterminal(production: dag_production_type_expr)
    )
  )
}


fn dag_grammar_param_list_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_lparen),
    right: dag_grammar_sequence(
      left: dag_grammar_optional(
        element: dag_grammar_comma_list_expr(item: dag_grammar_typed_param_expr())
      ),
      right: dag_grammar_terminal(token_class: dag_token_rparen)
    )
  )
}


fn dag_grammar_qualified_type_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: dag_production_qualified_name),
    right: dag_grammar_optional(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_lt),
        right: dag_grammar_sequence(
          left: dag_grammar_optional(
            element: dag_grammar_comma_list_expr(
              item: dag_grammar_nonterminal(production: dag_production_type_expr)
            )
          ),
          right: dag_grammar_terminal(token_class: dag_token_gt)
        )
      )
    )
  )
}


fn dag_grammar_type_list_expr() -> GrammarExpr {
  dag_grammar_comma_list_expr(
    item: dag_grammar_nonterminal(production: dag_production_type_expr)
  )
}


fn dag_grammar_fn_type_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_fn),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_lparen),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_type_list_expr()),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: dag_token_rparen),
          right: dag_grammar_sequence(
            left: dag_grammar_terminal(token_class: dag_token_arrow),
            right: dag_grammar_nonterminal(production: dag_production_type_expr)
          )
        )
      )
    )
  )
}


fn dag_grammar_type_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_qualified_type_expr(),
    right: dag_grammar_nonterminal(production: dag_production_fn_type)
  )
}


fn dag_grammar_import_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_lbrace),
    right: dag_grammar_sequence(
      left: dag_grammar_comma_list_expr(item: dag_grammar_terminal(token_class: dag_token_ident)),
      right: dag_grammar_terminal(token_class: dag_token_rbrace)
    )
  )
}


fn dag_grammar_field_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_ident),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_colon),
      right: dag_grammar_nonterminal(production: dag_production_type_expr)
    )
  )
}


fn dag_grammar_field_decl_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(item: dag_grammar_field_decl_expr())
  )
}


fn dag_grammar_field_decl_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_lbrace),
    right: dag_grammar_sequence(
      left: dag_grammar_field_decl_list_helper(),
      right: dag_grammar_terminal(token_class: dag_token_rbrace)
    )
  )
}


fn dag_grammar_fn_body_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_lbrace),
    right: dag_grammar_sequence(
      left: dag_grammar_repeat(element: dag_grammar_nonterminal(production: dag_production_stmt)),
      right: dag_grammar_terminal(token_class: dag_token_rbrace)
    )
  )
}


fn dag_grammar_stmt_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: dag_production_let_expr),
    right: dag_grammar_nonterminal(production: dag_production_expr)
  )
}


fn dag_grammar_let_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_let),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_eq),
        right: dag_grammar_nonterminal(production: dag_production_expr)
      )
    )
  )
}


fn dag_grammar_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: dag_production_match_expr),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: dag_production_if_expr),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: dag_production_fn_literal),
        right: dag_grammar_choice(
          left: dag_grammar_nonterminal(production: dag_production_block_expr),
          right: dag_grammar_nonterminal(production: dag_production_binary_expr)
        )
      )
    )
  )
}


// Binary operator set matches the lex token declarations above; both live in
// this file, so enumeration is the current canonical authority. Gate on a
// future operator-precedence table substrate when/if that lands.
fn dag_grammar_multiplicative_op_choice() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: dag_token_star),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: dag_token_slash),
      right: dag_grammar_terminal(token_class: dag_token_percent)
    )
  )
}


fn dag_grammar_additive_op_choice() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: dag_token_plus),
    right: dag_grammar_terminal(token_class: dag_token_minus)
  )
}


fn dag_grammar_comparison_op_choice() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: dag_token_gte),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: dag_token_lte),
      right: dag_grammar_choice(
        left: dag_grammar_terminal(token_class: dag_token_lt),
        right: dag_grammar_terminal(token_class: dag_token_gt)
      )
    )
  )
}


fn dag_grammar_equality_op_choice() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: dag_token_eq_eq),
    right: dag_grammar_terminal(token_class: dag_token_neq)
  )
}


fn dag_grammar_multiplicative_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: dag_production_unary_expr),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_multiplicative_op_choice(),
        right: dag_grammar_nonterminal(production: dag_production_unary_expr)
      )
    )
  )
}


fn dag_grammar_additive_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_multiplicative_expr_helper(),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_additive_op_choice(),
        right: dag_grammar_multiplicative_expr_helper()
      )
    )
  )
}


fn dag_grammar_comparison_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_additive_expr_helper(),
    right: dag_grammar_optional(
      element: dag_grammar_sequence(
        left: dag_grammar_comparison_op_choice(),
        right: dag_grammar_additive_expr_helper()
      )
    )
  )
}


fn dag_grammar_equality_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_comparison_expr_helper(),
    right: dag_grammar_optional(
      element: dag_grammar_sequence(
        left: dag_grammar_equality_op_choice(),
        right: dag_grammar_comparison_expr_helper()
      )
    )
  )
}


fn dag_grammar_and_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_equality_expr_helper(),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_and_and),
        right: dag_grammar_equality_expr_helper()
      )
    )
  )
}


fn dag_grammar_or_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_and_expr_helper(),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_or_or),
        right: dag_grammar_and_expr_helper()
      )
    )
  )
}


fn dag_grammar_pipe_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_or_expr_helper(),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_pipe_gt),
        right: dag_grammar_or_expr_helper()
      )
    )
  )
}


fn dag_grammar_binary_expr_expr() -> GrammarExpr {
  dag_grammar_pipe_expr_helper()
}


fn dag_grammar_unary_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_bang),
      right: dag_grammar_nonterminal(production: dag_production_unary_expr)
    ),
    right: dag_grammar_nonterminal(production: dag_production_postfix_expr)
  )
}


fn dag_grammar_arg_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(item: dag_grammar_nonterminal(production: dag_production_arg))
  )
}


fn dag_grammar_field_init_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(
      item: dag_grammar_nonterminal(production: dag_production_field_init)
    )
  )
}


fn dag_grammar_pattern_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(
      item: dag_grammar_nonterminal(production: dag_production_pattern)
    )
  )
}


fn dag_grammar_field_pattern_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(
      item: dag_grammar_nonterminal(production: dag_production_field_pattern)
    )
  )
}


fn dag_grammar_expr_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(item: dag_grammar_nonterminal(production: dag_production_expr))
  )
}


fn dag_grammar_untyped_params_helper() -> GrammarExpr {
  dag_grammar_comma_list_expr(item: dag_grammar_terminal(token_class: dag_token_ident))
}


fn dag_grammar_postfix_call_suffix_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_lparen),
    right: dag_grammar_sequence(
      left: dag_grammar_arg_list_helper(),
      right: dag_grammar_terminal(token_class: dag_token_rparen)
    )
  )
}


fn dag_grammar_postfix_expr_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: dag_production_primary_expr),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_dot),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: dag_token_ident),
          right: dag_grammar_optional(element: dag_grammar_postfix_call_suffix_expr())
        )
      )
    )
  )
}


fn dag_grammar_primary_ident_suffix_expr() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_choice(
      left: dag_grammar_postfix_call_suffix_expr(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_field_init_list_helper(),
          right: dag_grammar_terminal(token_class: dag_token_rbrace)
        )
      )
    )
  )
}


fn dag_grammar_primary_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_ident),
      right: dag_grammar_primary_ident_suffix_expr()
    ),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: dag_token_int_literal),
      right: dag_grammar_choice(
        left: dag_grammar_terminal(token_class: dag_token_string_literal),
        right: dag_grammar_choice(
          left: dag_grammar_terminal(token_class: dag_token_kw_true),
          right: dag_grammar_choice(
            left: dag_grammar_terminal(token_class: dag_token_kw_false),
            right: dag_grammar_choice(
              left: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: dag_token_lbracket),
                right: dag_grammar_sequence(
                  left: dag_grammar_expr_list_helper(),
                  right: dag_grammar_terminal(token_class: dag_token_rbracket)
                )
              ),
              right: dag_grammar_choice(
                left: dag_grammar_sequence(
                  left: dag_grammar_terminal(token_class: dag_token_lbrace),
                  right: dag_grammar_sequence(
                    left: dag_grammar_field_init_list_helper(),
                    right: dag_grammar_terminal(token_class: dag_token_rbrace)
                  )
                ),
                right: dag_grammar_sequence(
                  left: dag_grammar_terminal(token_class: dag_token_lparen),
                  right: dag_grammar_sequence(
                    left: dag_grammar_nonterminal(production: dag_production_expr),
                    right: dag_grammar_terminal(token_class: dag_token_rparen)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}


fn dag_grammar_block_expr_expr() -> GrammarExpr {
  dag_grammar_nonterminal(production: dag_production_fn_body)
}


fn dag_grammar_arg_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_colon),
        right: dag_grammar_nonterminal(production: dag_production_expr)
      )
    ),
    right: dag_grammar_nonterminal(production: dag_production_expr)
  )
}


fn dag_grammar_field_init_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_ident),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_colon),
      right: dag_grammar_nonterminal(production: dag_production_expr)
    )
  )
}


fn dag_grammar_match_expr_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_match),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: dag_production_binary_expr),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_repeat(element: dag_grammar_nonterminal(production: dag_production_match_arm)),
          right: dag_grammar_terminal(token_class: dag_token_rbrace)
        )
      )
    )
  )
}


fn dag_grammar_match_arm_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: dag_production_pattern),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_fat_arrow),
      right: dag_grammar_nonterminal(production: dag_production_expr)
    )
  )
}


fn dag_grammar_constructor_pattern_suffix_expr() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_choice(
      left: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_field_pattern_list_helper(),
          right: dag_grammar_terminal(token_class: dag_token_rbrace)
        )
      ),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_lparen),
        right: dag_grammar_sequence(
          left: dag_grammar_pattern_list_helper(),
          right: dag_grammar_terminal(token_class: dag_token_rparen)
        )
      )
    )
  )
}


fn dag_grammar_constructor_pattern_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_ident),
    right: dag_grammar_constructor_pattern_suffix_expr()
  )
}


// Pattern forms cover observed src/v4 branches: nullary constructors,
// record-field patterns, keyword/literal patterns, and positional constructor
// payloads such as Composable(inner).
fn dag_grammar_pattern_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_constructor_pattern_expr(),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: dag_token_kw_true),
      right: dag_grammar_choice(
        left: dag_grammar_terminal(token_class: dag_token_kw_false),
        right: dag_grammar_choice(
          left: dag_grammar_terminal(token_class: dag_token_int_literal),
          right: dag_grammar_terminal(token_class: dag_token_string_literal)
        )
      )
    )
  )
}


fn dag_grammar_field_pattern_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_colon),
        right: dag_grammar_nonterminal(production: dag_production_pattern)
      )
    ),
    right: dag_grammar_terminal(token_class: dag_token_ident)
  )
}


fn dag_grammar_if_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_if),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: dag_production_expr),
      right: dag_grammar_sequence(
        left: dag_grammar_nonterminal(production: dag_production_fn_body),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: dag_token_kw_else),
          right: dag_grammar_choice(
            left: dag_grammar_nonterminal(production: dag_production_if_expr),
            right: dag_grammar_nonterminal(production: dag_production_fn_body)
          )
        )
      )
    )
  )
}


fn dag_grammar_if_then_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_if),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: dag_production_expr),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_kw_then),
        right: dag_grammar_sequence(
          left: dag_grammar_nonterminal(production: dag_production_expr),
          right: dag_grammar_sequence(
            left: dag_grammar_terminal(token_class: dag_token_kw_else),
            right: dag_grammar_nonterminal(production: dag_production_expr)
          )
        )
      )
    )
  )
}


fn dag_grammar_if_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_if_then_expr(),
    right: dag_grammar_if_block_expr()
  )
}


fn dag_grammar_fn_literal_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_fn),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_lparen),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_untyped_params_helper()),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: dag_token_rparen),
          right: dag_grammar_sequence(
            left: dag_grammar_optional(
              element: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: dag_token_arrow),
                right: dag_grammar_nonterminal(production: dag_production_type_expr)
              )
            ),
            right: dag_grammar_nonterminal(production: dag_production_fn_body)
          )
        )
      )
    )
  )
}


fn dag_grammar_import_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_import),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: dag_production_qualified_name),
      right: dag_grammar_optional(element: dag_grammar_nonterminal(production: dag_production_import_block))
    )
  )
}


fn dag_grammar_type_variant_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: dag_production_type_expr),
    right: dag_grammar_optional(element: dag_grammar_nonterminal(production: dag_production_field_decl_block))
  )
}


fn dag_grammar_type_alias_rhs_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: dag_production_type_variant),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_pipe),
        right: dag_grammar_nonterminal(production: dag_production_type_variant)
      )
    )
  )
}


fn dag_grammar_type_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_type),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_nonterminal(production: dag_production_generic_params)),
        right: dag_grammar_optional(
          element: dag_grammar_choice(
            left: dag_grammar_nonterminal(production: dag_production_field_decl_block),
            right: dag_grammar_sequence(
              left: dag_grammar_terminal(token_class: dag_token_eq),
              right: dag_grammar_nonterminal(production: dag_production_type_alias_rhs)
            )
          )
        )
      )
    )
  )
}


fn dag_grammar_data_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_data),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: dag_token_colon),
        right: dag_grammar_sequence(
          left: dag_grammar_nonterminal(production: dag_production_type_expr),
          right: dag_grammar_sequence(
            left: dag_grammar_terminal(token_class: dag_token_eq),
            right: dag_grammar_nonterminal(production: dag_production_expr)
          )
        )
      )
    )
  )
}


fn dag_grammar_fn_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: dag_token_kw_fn),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_nonterminal(production: dag_production_generic_params)),
        right: dag_grammar_sequence(
          left: dag_grammar_nonterminal(production: dag_production_param_list),
          right: dag_grammar_sequence(
            left: dag_grammar_optional(
              element: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: dag_token_arrow),
                right: dag_grammar_nonterminal(production: dag_production_type_expr)
              )
            ),
            right: dag_grammar_nonterminal(production: dag_production_fn_body)
          )
        )
      )
    )
  )
}


fn dag_grammar_top_level_item_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: dag_production_import_decl),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: dag_production_type_decl),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: dag_production_data_decl),
        right: dag_grammar_nonterminal(production: dag_production_fn_decl)
      )
    )
  )
}


fn dag_grammar_module_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: dag_production_module_header),
    right: dag_grammar_repeat(element: dag_grammar_nonterminal(production: dag_production_top_level_item))
  )
}


fn dag_grammar_production(name: Symbol, expression: GrammarExpr, emitted: Symbol) -> GrammarProduction {
  GrammarProduction {
    name: name,
    expression: expression,
    emitted: dag_grammar_atom(id: emitted)
  }
}


fn dag_grammar_module_production() -> GrammarProduction {
  dag_grammar_production(
    name: dag_production_module,
    expression: dag_grammar_module_expr(),
    emitted: dag_surface_module
  )
}


fn emit_module_header_emitted_node(qualified_name: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: dag_surface_module_header,
        target: dag_grammar_atom(id: dag_surface_module_header)
      ),
      dag_named_edge(
        name: dag_surface_module_header_qualified_name,
        target: qualified_name
      )
    ]
  }
}


fn emit_row_module_header(qualified_name: Node) -> Node {
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: dag_production_module_header,
      expression: dag_grammar_module_header_expr(),
      emitted: dag_surface_module_header
    ),
    emitted: emit_module_header_emitted_node(qualified_name: qualified_name),
    tokens: [
      emit_fixed_token(token_class: dag_token_kw_module),
      qualified_name
    ]
  )
}


fn emit_import_decl_emitted_node(
  qualified_name: Node,
  import_block: Node?
) -> Node {
  let prefix = [
    dag_named_edge(
      name: dag_surface_import_decl,
      target: dag_grammar_atom(id: dag_surface_import_decl)
    ),
    dag_named_edge(
      name: dag_surface_import_decl_qualified_name,
      target: qualified_name
    )
  ]
  Node {
    kind: TypeNode { connective: Conj },
    children: match import_block {
      Some { value: block } =>
        list_append(
          left: prefix,
          right: [
            dag_named_edge(name: dag_surface_import_decl_block, target: block)
          ]
        )
      None => prefix
    }
  }
}


fn emit_row_import_decl(
  qualified_name: Node,
  import_block: Node?
) -> Node {
  let prefix = [
    emit_fixed_token(token_class: dag_token_kw_import),
    qualified_name
  ]
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: dag_production_import_decl,
      expression: dag_grammar_import_decl_expr(),
      emitted: dag_surface_import_decl
    ),
    emitted: emit_import_decl_emitted_node(
      qualified_name: qualified_name,
      import_block: import_block
    ),
    tokens: match import_block {
      Some { value: block } => list_append(left: prefix, right: [block])
      None => prefix
    }
  )
}


fn emit_data_decl_emitted_node(
  name_binding: Symbol,
  type_expr: Node,
  expr: Node
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: dag_surface_data_decl,
        target: dag_grammar_atom(id: dag_surface_data_decl)
      ),
      dag_named_edge(
        name: dag_surface_data_decl_name,
        target: dag_grammar_atom(id: name_binding)
      ),
      dag_named_edge(
        name: dag_surface_data_decl_type,
        target: type_expr
      ),
      dag_named_edge(
        name: dag_surface_data_decl_expr,
        target: expr
      )
    ]
  }
}


fn emit_row_data_decl(
  name_binding: Symbol,
  type_expr: Node,
  expr: Node
) -> Node {
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: dag_production_data_decl,
      expression: dag_grammar_data_decl_expr(),
      emitted: dag_surface_data_decl
    ),
    emitted: emit_data_decl_emitted_node(
      name_binding: name_binding,
      type_expr: type_expr,
      expr: expr
    ),
    tokens: [
      emit_fixed_token(token_class: dag_token_kw_data),
      emit_bound_token(token_class: dag_token_ident, binding: name_binding),
      emit_fixed_token(token_class: dag_token_colon),
      type_expr,
      emit_fixed_token(token_class: dag_token_eq),
      expr
    ]
  )
}


fn dag_wave1_grammar_root() -> GrammarRoot {
  let module = dag_grammar_module_production()
  let module_header = dag_grammar_production(
    name: dag_production_module_header,
    expression: dag_grammar_module_header_expr(),
    emitted: dag_surface_module_header
  )
  let top_level_item = dag_grammar_production(
    name: dag_production_top_level_item,
    expression: dag_grammar_top_level_item_expr(),
    emitted: dag_surface_top_level_item
  )
  let import_decl = dag_grammar_production(
    name: dag_production_import_decl,
    expression: dag_grammar_import_decl_expr(),
    emitted: dag_surface_import_decl
  )
  let type_decl = dag_grammar_production(
    name: dag_production_type_decl,
    expression: dag_grammar_type_decl_expr(),
    emitted: dag_surface_type_decl
  )
  let data_decl = dag_grammar_production(
    name: dag_production_data_decl,
    expression: dag_grammar_data_decl_expr(),
    emitted: dag_surface_data_decl
  )
  let fn_decl = dag_grammar_production(
    name: dag_production_fn_decl,
    expression: dag_grammar_fn_decl_expr(),
    emitted: dag_surface_fn_decl
  )
  let qualified_name = dag_grammar_production(
    name: dag_production_qualified_name,
    expression: dag_grammar_qualified_name_expr(),
    emitted: dag_surface_qualified_name
  )
  let generic_params = dag_grammar_production(
    name: dag_production_generic_params,
    expression: dag_grammar_generic_params_expr(),
    emitted: dag_surface_generic_params
  )
  let param_list = dag_grammar_production(
    name: dag_production_param_list,
    expression: dag_grammar_param_list_expr(),
    emitted: dag_surface_param_list
  )
  let type_expr = dag_grammar_production(
    name: dag_production_type_expr,
    expression: dag_grammar_type_expr(),
    emitted: dag_surface_type_expr
  )
  let fn_type = dag_grammar_production(
    name: dag_production_fn_type,
    expression: dag_grammar_fn_type_expr(),
    emitted: dag_surface_fn_type
  )
  let type_variant = dag_grammar_production(
    name: dag_production_type_variant,
    expression: dag_grammar_type_variant_expr(),
    emitted: dag_surface_type_variant
  )
  let type_alias_rhs = dag_grammar_production(
    name: dag_production_type_alias_rhs,
    expression: dag_grammar_type_alias_rhs_expr(),
    emitted: dag_surface_type_alias_rhs
  )
  let import_block = dag_grammar_production(
    name: dag_production_import_block,
    expression: dag_grammar_import_block_expr(),
    emitted: dag_surface_import_block
  )
  let field_decl_block = dag_grammar_production(
    name: dag_production_field_decl_block,
    expression: dag_grammar_field_decl_block_expr(),
    emitted: dag_surface_field_decl_block
  )
  let fn_body = dag_grammar_production(
    name: dag_production_fn_body,
    expression: dag_grammar_fn_body_expr(),
    emitted: dag_surface_fn_body
  )
  let stmt = dag_grammar_production(
    name: dag_production_stmt,
    expression: dag_grammar_stmt_expr(),
    emitted: dag_surface_stmt
  )
  let let_expr = dag_grammar_production(
    name: dag_production_let_expr,
    expression: dag_grammar_let_expr(),
    emitted: dag_surface_let_expr
  )
  let expr = dag_grammar_production(
    name: dag_production_expr,
    expression: dag_grammar_expr_expr(),
    emitted: dag_surface_expr
  )
  let binary_expr = dag_grammar_production(
    name: dag_production_binary_expr,
    expression: dag_grammar_binary_expr_expr(),
    emitted: dag_surface_binary_expr
  )
  let unary_expr = dag_grammar_production(
    name: dag_production_unary_expr,
    expression: dag_grammar_unary_expr_expr(),
    emitted: dag_surface_unary_expr
  )
  let postfix_expr = dag_grammar_production(
    name: dag_production_postfix_expr,
    expression: dag_grammar_postfix_expr_expr(),
    emitted: dag_surface_postfix_expr
  )
  let primary_expr = dag_grammar_production(
    name: dag_production_primary_expr,
    expression: dag_grammar_primary_expr_expr(),
    emitted: dag_surface_primary_expr
  )
  let block_expr = dag_grammar_production(
    name: dag_production_block_expr,
    expression: dag_grammar_block_expr_expr(),
    emitted: dag_surface_block_expr
  )
  let arg = dag_grammar_production(
    name: dag_production_arg,
    expression: dag_grammar_arg_expr(),
    emitted: dag_surface_arg
  )
  let field_init = dag_grammar_production(
    name: dag_production_field_init,
    expression: dag_grammar_field_init_expr(),
    emitted: dag_surface_field_init
  )
  let match_expr = dag_grammar_production(
    name: dag_production_match_expr,
    expression: dag_grammar_match_expr_expr(),
    emitted: dag_surface_match_expr
  )
  let match_arm = dag_grammar_production(
    name: dag_production_match_arm,
    expression: dag_grammar_match_arm_expr(),
    emitted: dag_surface_match_arm
  )
  let pattern = dag_grammar_production(
    name: dag_production_pattern,
    expression: dag_grammar_pattern_expr(),
    emitted: dag_surface_pattern
  )
  let field_pattern = dag_grammar_production(
    name: dag_production_field_pattern,
    expression: dag_grammar_field_pattern_expr(),
    emitted: dag_surface_field_pattern
  )
  let if_expr = dag_grammar_production(
    name: dag_production_if_expr,
    expression: dag_grammar_if_expr_expr(),
    emitted: dag_surface_if_expr
  )
  let fn_literal = dag_grammar_production(
    name: dag_production_fn_literal,
    expression: dag_grammar_fn_literal_expr(),
    emitted: dag_surface_fn_literal
  )
  GrammarRoot {
    start: dag_production_module,
    productions: [
      module,
      module_header,
      top_level_item,
      import_decl,
      type_decl,
      data_decl,
      fn_decl,
      qualified_name,
      generic_params,
      param_list,
      type_expr,
      fn_type,
      type_variant,
      type_alias_rhs,
      import_block,
      field_decl_block,
      fn_body,
      stmt,
      let_expr,
      expr,
      binary_expr,
      unary_expr,
      postfix_expr,
      primary_expr,
      block_expr,
      arg,
      field_init,
      match_expr,
      match_arm,
      pattern,
      field_pattern,
      if_expr,
      fn_literal
    ],
    sync_tokens: dag_wave1_sync_tokens()
  }
}


fn dag_wave1_g0_void_grammar() -> ParseGrammar {
  VoidGrammar
}


fn dag_wave1_grammar() -> ParseGrammar {
  ModeledGrammar { root: dag_wave1_grammar_root() }
}


// wave-1 void LM canonical prelude atoms (TASKS T-8 / CP-1b bucket C).
fn dag_language_model_surface_prelude_atoms() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      sym == dag_c3_surface_sugar_service ||
        sym == dag_c3_surface_sugar_fn ||
        sym == dag_c3_surface_sugar_type ||
        sym == dag_c3_surface_sugar_operation ||
        dag_wave1_lex_token_symbol(sym: sym)
    }
  }
}


fn dag_language_model_empty_canonical_symbol_set() -> Set<Symbol> {
  Set {
    member: fn(_) {
      false
    }
  }
}


fn dag_language_model_wave1_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      dag_language_model_surface_prelude_atoms().member(sym) ||
        grammar_carries_symbol(grammar: dag_wave1_grammar(), sym: sym)
    }
  }
}


fn dag_language_model_wave1_void() -> DagLanguageModel {
  DagLanguageModel {
    lex: dag_wave1_lex(),
    grammar: dag_wave1_g0_void_grammar(),
    language_identity: dag_language_model_surface_id,
    canonical_symbols: dag_language_model_surface_prelude_atoms()
  }
}


fn dag_language_model_wave1() -> DagLanguageModel {
  DagLanguageModel {
    lex: dag_wave1_lex(),
    grammar: dag_wave1_grammar(),
    language_identity: dag_language_model_surface_id,
    canonical_symbols: dag_language_model_wave1_canonical_symbols()
  }
}


// compile-anchor empty prelude; same language_identity as wave1_void (TASKS T-8 / CP-1b bucket C).
fn dag_language_model_surface_empty_prelude() -> DagLanguageModel {
  DagLanguageModel {
    lex: dag_wave1_lex(),
    grammar: dag_wave1_g0_void_grammar(),
    language_identity: dag_language_model_surface_id,
    canonical_symbols: dag_language_model_empty_canonical_symbol_set()
  }
}


fn dag_language_model_canonical_symbols(lm: DagLanguageModel) -> Set<Symbol> {
  lm.canonical_symbols
}


fn dag_wave1_lex_token_symbol(sym: Symbol) -> Bool {
  lex_rule_set_token_class_member(
    rules: dag_wave1_lex_rules(),
    token_class: sym
  )
}


// sync_tokens: declaration-start keywords used for error recovery in Repeat walks.
fn dag_wave1_sync_tokens() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      sym == dag_token_kw_module ||
      sym == dag_token_kw_import ||
      sym == dag_token_kw_type ||
      sym == dag_token_kw_data ||
      sym == dag_token_kw_fn
    }
  }
}


// Pipeline-facing LM that wires the full modeled grammar — use this for T-7/T-8+ pipeline calls.
fn dag_language_model_wave1_modeled() -> DagLanguageModel {
  dag_language_model_wave1()
}


// Caller-facing entry point for holders of a module header Node (emit or parse output): extracts
// the declared QualifiedName by walking dag_surface_module_header_qualified_name to the fold_list_node
// sub-node, then delegating to qualified_name_from_node in std/.
// std/qualified_name.dag cannot import dag_surface_module_header_qualified_name (extdeps/ → std/ only),
// so this wrapper lives in extdeps/. compiler/00_compile.dag admission calls this function on each
// batch entry (post-normalize module Node). std/module_batch.dag batch_delete/batch_lookup cannot
// use this wrapper (std/ layering barrier); they call qualified_name_from_node as best-effort and
// always receive Rejected for post-normalize module Nodes — kept as non-match per delete policy.
// 🟡 gated — T-8 parse fidelity — dissolve-on: T-8 lands per-identifier hashing. Until then every
// segment extracted from a real parse tree carries dag_token_ident (identifier identity unavailable);
// this function rejects at the extdeps/ boundary rather than returning a fabricated QualifiedName (P3).
// 🟡 traverse-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: traverse-node-outcome-algebra — bind diagnostic.dag Ratified-Q4 — dissolve-on: same Q4 gate as qualified_name_from_node; the nested Rejected/Accepted propagation inherits the same carrier threading constraint; forbidden: re-inlining the ladder after Q4 resolves.
fn qualified_name_from_module_node(root: Node) -> Outcome<QualifiedName> {
  match find_named_child(root: root, name: dag_surface_module_header) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: _, diagnostics: _ } =>
      match find_named_child(root: root, name: dag_surface_module_header_qualified_name) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: qn_node, diagnostics: _ } =>
          match qualified_name_from_node(root: qn_node) {
            Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
            Accepted { value: qn, diagnostics: _ } =>
              match qn {
                QnEmpty => outcome_rejected(Diagnostic {
                  reason: qualified_name_structure_invalid,
                  at: node_locus(node: root),
                  correction: Unavailable { reason: ExternalContractUnknown }
                })
                QnCons { head: _, tail: _ } =>
                  if qualified_name_for_all(qn: qn, predicate: fn(sym) { sym != dag_token_ident }) {
                    outcome_accepted(value: qn)
                  } else {
                    outcome_rejected(Diagnostic {
                      reason: qualified_name_projection_gated,
                      at: node_locus(node: root),
                      correction: Unavailable { reason: ExternalContractUnknown }
                    })
                  }
              }
          }
      }
  }
}
