    left: dag_grammar_terminal(token_class: dag_token_kw_fn),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_nonterminal(production: dag_production_generic_params)),
        right: dag_grammar_sequence(
          left: dag_grammar_nonterminal(production: dag_production_param_list),
          right: dag_grammar_sequence(
            left: dag_grammar_optional(
              element: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: dag_token_arrow),
                right: dag_grammar_nonterminal(production: dag_production_type_expr)
              )
            ),
            right: dag_grammar_nonterminal(production: dag_production_fn_body)
          )
        )
      )
    )
  )
}


fn dag_grammar_top_level_item_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: dag_production_import_decl),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: dag_production_type_decl),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: dag_production_data_decl),
        right: dag_grammar_nonterminal(production: dag_production_fn_decl)
      )
    )
  )
}


fn dag_grammar_module_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: dag_production_module_header),
    right: dag_grammar_repeat(element: dag_grammar_nonterminal(production: dag_production_top_level_item))
  )
}


fn dag_grammar_production(name: Symbol, expression: GrammarExpr, emitted: Symbol) -> GrammarProduction {
  GrammarProduction {
    name: name,
    expression: expression,
    emitted: dag_grammar_atom(id: emitted)
  }
}


fn dag_grammar_module_production() -> GrammarProduction {
  dag_grammar_production(
    name: dag_production_module,
    expression: dag_grammar_module_expr(),
    emitted: dag_surface_module
  )
}


fn emit_module_header_emitted_node(qualified_name: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: dag_surface_module_header,
        target: dag_grammar_atom(id: dag_surface_module_header)
      ),
      dag_named_edge(
        name: dag_surface_module_header_qualified_name,
        target: qualified_name
      )
    ]
  }
}


fn emit_row_module_header(qualified_name: Node) -> Node {
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: dag_production_module_header,
      expression: dag_grammar_module_header_expr(),
      emitted: dag_surface_module_header
    ),
    emitted: emit_module_header_emitted_node(qualified_name: qualified_name),
    tokens: [
      emit_fixed_token(token_class: dag_token_kw_module),
      qualified_name
    ]
  )
}


fn emit_import_decl_emitted_node(
  qualified_name: Node,
  import_block: Node?
) -> Node {
  let prefix = [
    dag_named_edge(
      name: dag_surface_import_decl,
      target: dag_grammar_atom(id: dag_surface_import_decl)
    ),
    dag_named_edge(
      name: dag_surface_import_decl_qualified_name,
      target: qualified_name
    )
  ]
  Node {
    kind: TypeNode { connective: Conj },
    children: match import_block {
      Some { value: block } =>
        list_append(
          left: prefix,
          right: [
            dag_named_edge(name: dag_surface_import_decl_block, target: block)
          ]
        )
      None => prefix
    }
  }
}


fn emit_row_import_decl(
  qualified_name: Node,
  import_block: Node?
) -> Node {
  let prefix = [
    emit_fixed_token(token_class: dag_token_kw_import),
    qualified_name
  ]
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: dag_production_import_decl,
      expression: dag_grammar_import_decl_expr(),
      emitted: dag_surface_import_decl
    ),
    emitted: emit_import_decl_emitted_node(
      qualified_name: qualified_name,
      import_block: import_block
    ),
    tokens: match import_block {
      Some { value: block } => list_append(left: prefix, right: [block])
      None => prefix
    }
  )
}


fn emit_data_decl_emitted_node(
  name_binding: Symbol,
  type_expr: Node,
  expr: Node
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: dag_surface_data_decl,
        target: dag_grammar_atom(id: dag_surface_data_decl)
      ),
      dag_named_edge(
        name: dag_surface_data_decl_name,
        target: dag_grammar_atom(id: name_binding)
      ),
      dag_named_edge(
        name: dag_surface_data_decl_type,
        target: type_expr
      ),
      dag_named_edge(
        name: dag_surface_data_decl_expr,
        target: expr
      )
    ]
  }
}


fn emit_row_data_decl(
  name_binding: Symbol,
  type_expr: Node,
  expr: Node
) -> Node {
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: dag_production_data_decl,
      expression: dag_grammar_data_decl_expr(),
      emitted: dag_surface_data_decl
    ),
    emitted: emit_data_decl_emitted_node(
      name_binding: name_binding,
      type_expr: type_expr,
      expr: expr
    ),
    tokens: [
      emit_fixed_token(token_class: dag_token_kw_data),
      emit_bound_token(token_class: dag_token_ident, binding: name_binding),
      emit_fixed_token(token_class: dag_token_colon),
      type_expr,
      emit_fixed_token(token_class: dag_token_eq),
      expr
    ]
  )
}


fn dag_wave1_grammar_root() -> GrammarRoot {
  let module = dag_grammar_module_production()
  let module_header = dag_grammar_production(
    name: dag_production_module_header,
    expression: dag_grammar_module_header_expr(),
    emitted: dag_surface_module_header
  )
  let top_level_item = dag_grammar_production(
    name: dag_production_top_level_item,
    expression: dag_grammar_top_level_item_expr(),
    emitted: dag_surface_top_level_item
  )
  let import_decl = dag_grammar_production(
    name: dag_production_import_decl,
    expression: dag_grammar_import_decl_expr(),
    emitted: dag_surface_import_decl
  )
  let type_decl = dag_grammar_production(
    name: dag_production_type_decl,
    expression: dag_grammar_type_decl_expr(),
    emitted: dag_surface_type_decl
  )
  let data_decl = dag_grammar_production(
    name: dag_production_data_decl,
    expression: dag_grammar_data_decl_expr(),
    emitted: dag_surface_data_decl
  )
  let fn_decl = dag_grammar_production(
    name: dag_production_fn_decl,
    expression: dag_grammar_fn_decl_expr(),
    emitted: dag_surface_fn_decl
  )
  let qualified_name = dag_grammar_production(
    name: dag_production_qualified_name,
    expression: dag_grammar_qualified_name_expr(),
    emitted: dag_surface_qualified_name
  )
  let generic_params = dag_grammar_production(
    name: dag_production_generic_params,
    expression: dag_grammar_generic_params_expr(),
    emitted: dag_surface_generic_params
  )
  let param_list = dag_grammar_production(
    name: dag_production_param_list,
    expression: dag_grammar_param_list_expr(),
    emitted: dag_surface_param_list
  )
  let type_expr = dag_grammar_production(
    name: dag_production_type_expr,
    expression: dag_grammar_type_expr(),
    emitted: dag_surface_type_expr
  )
  let fn_type = dag_grammar_production(
    name: dag_production_fn_type,
    expression: dag_grammar_fn_type_expr(),
    emitted: dag_surface_fn_type
  )
  let type_variant = dag_grammar_production(
    name: dag_production_type_variant,
    expression: dag_grammar_type_variant_expr(),
    emitted: dag_surface_type_variant
  )
  let type_alias_rhs = dag_grammar_production(
    name: dag_production_type_alias_rhs,
    expression: dag_grammar_type_alias_rhs_expr(),
    emitted: dag_surface_type_alias_rhs
  )
  let import_block = dag_grammar_production(
    name: dag_production_import_block,
    expression: dag_grammar_import_block_expr(),
    emitted: dag_surface_import_block
  )
  let field_decl_block = dag_grammar_production(
    name: dag_production_field_decl_block,
    expression: dag_grammar_field_decl_block_expr(),
    emitted: dag_surface_field_decl_block
  )
  let fn_body = dag_grammar_production(
    name: dag_production_fn_body,
    expression: dag_grammar_fn_body_expr(),
    emitted: dag_surface_fn_body
  )
  let stmt = dag_grammar_production(
    name: dag_production_stmt,
    expression: dag_grammar_stmt_expr(),
    emitted: dag_surface_stmt
  )
  let let_expr = dag_grammar_production(
    name: dag_production_let_expr,
    expression: dag_grammar_let_expr(),
    emitted: dag_surface_let_expr
  )
  let expr = dag_grammar_production(
    name: dag_production_expr,
    expression: dag_grammar_expr_expr(),
    emitted: dag_surface_expr
  )
  let binary_expr = dag_grammar_production(
    name: dag_production_binary_expr,
    expression: dag_grammar_binary_expr_expr(),
    emitted: dag_surface_binary_expr
  )
  let unary_expr = dag_grammar_production(
    name: dag_production_unary_expr,
    expression: dag_grammar_unary_expr_expr(),
    emitted: dag_surface_unary_expr
  )
  let postfix_expr = dag_grammar_production(
    name: dag_production_postfix_expr,
    expression: dag_grammar_postfix_expr_expr(),
    emitted: dag_surface_postfix_expr
  )
  let primary_expr = dag_grammar_production(
    name: dag_production_primary_expr,
    expression: dag_grammar_primary_expr_expr(),
    emitted: dag_surface_primary_expr
  )
  let block_expr = dag_grammar_production(
    name: dag_production_block_expr,
    expression: dag_grammar_block_expr_expr(),
    emitted: dag_surface_block_expr
  )
  let arg = dag_grammar_production(
    name: dag_production_arg,
    expression: dag_grammar_arg_expr(),
    emitted: dag_surface_arg
  )
  let field_init = dag_grammar_production(
    name: dag_production_field_init,
    expression: dag_grammar_field_init_expr(),
    emitted: dag_surface_field_init
  )
  let match_expr = dag_grammar_production(
    name: dag_production_match_expr,
    expression: dag_grammar_match_expr_expr(),
    emitted: dag_surface_match_expr
  )
  let match_arm = dag_grammar_production(
    name: dag_production_match_arm,
    expression: dag_grammar_match_arm_expr(),
    emitted: dag_surface_match_arm
  )
  let pattern = dag_grammar_production(
    name: dag_production_pattern,
    expression: dag_grammar_pattern_expr(),
    emitted: dag_surface_pattern
  )
  let field_pattern = dag_grammar_production(
    name: dag_production_field_pattern,
    expression: dag_grammar_field_pattern_expr(),
    emitted: dag_surface_field_pattern
  )
  let if_expr = dag_grammar_production(
    name: dag_production_if_expr,
    expression: dag_grammar_if_expr_expr(),
    emitted: dag_surface_if_expr
  )
  let fn_literal = dag_grammar_production(
    name: dag_production_fn_literal,
    expression: dag_grammar_fn_literal_expr(),
    emitted: dag_surface_fn_literal
  )
  GrammarRoot {
    start: dag_production_module,
    productions: [
      module,
      module_header,
      top_level_item,
      import_decl,
      type_decl,
      data_decl,
      fn_decl,
      qualified_name,
      generic_params,
      param_list,
      type_expr,
      fn_type,
      type_variant,
      type_alias_rhs,
      import_block,
      field_decl_block,
      fn_body,
      stmt,
      let_expr,
      expr,
      binary_expr,
      unary_expr,
      postfix_expr,
      primary_expr,
      block_expr,
      arg,
      field_init,
      match_expr,
      match_arm,
      pattern,
      field_pattern,
      if_expr,
      fn_literal
    ],
    sync_tokens: dag_wave1_sync_tokens()
  }
}


fn dag_wave1_g0_void_grammar() -> ParseGrammar {
  VoidGrammar
}


fn dag_wave1_grammar() -> ParseGrammar {
  ModeledGrammar { root: dag_wave1_grammar_root() }
}


// wave-1 void LM canonical prelude atoms (TASKS T-8 / CP-1b bucket C).
fn dag_language_model_surface_prelude_atoms() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      sym == dag_c3_surface_sugar_service ||
        sym == dag_c3_surface_sugar_fn ||
        sym == dag_c3_surface_sugar_type ||
        sym == dag_c3_surface_sugar_operation ||
        dag_wave1_lex_token_symbol(sym: sym)
    }
  }
}


fn dag_language_model_empty_canonical_symbol_set() -> Set<Symbol> {
  Set {
    member: fn(_) {
      false
    }
  }
}


fn dag_language_model_wave1_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      dag_language_model_surface_prelude_atoms().member(sym) ||
        grammar_carries_symbol(grammar: dag_wave1_grammar(), sym: sym)
    }
  }
}


fn dag_language_model_wave1_void() -> DagLanguageModel {
  DagLanguageModel {
    lex: dag_wave1_lex(),
    grammar: dag_wave1_g0_void_grammar(),
    language_identity: dag_language_model_surface_id,
    canonical_symbols: dag_language_model_surface_prelude_atoms()
  }
}


fn dag_language_model_wave1() -> DagLanguageModel {
  DagLanguageModel {
    lex: dag_wave1_lex(),
    grammar: dag_wave1_grammar(),
    language_identity: dag_language_model_surface_id,
    canonical_symbols: dag_language_model_wave1_canonical_symbols()
  }
}


// compile-anchor empty prelude; same language_identity as wave1_void (TASKS T-8 / CP-1b bucket C).
fn dag_language_model_surface_empty_prelude() -> DagLanguageModel {
  DagLanguageModel {
    lex: dag_wave1_lex(),
    grammar: dag_wave1_g0_void_grammar(),
    language_identity: dag_language_model_surface_id,
    canonical_symbols: dag_language_model_empty_canonical_symbol_set()
  }
}


fn dag_language_model_canonical_symbols(lm: DagLanguageModel) -> Set<Symbol> {
  lm.canonical_symbols
}


fn dag_wave1_lex_token_symbol(sym: Symbol) -> Bool {
  lex_rule_set_token_class_member(
    rules: dag_wave1_lex_rules(),
    token_class: sym
  )
}


// sync_tokens: declaration-start keywords used for error recovery in Repeat walks.
fn dag_wave1_sync_tokens() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      sym == dag_token_kw_module ||
      sym == dag_token_kw_import ||
      sym == dag_token_kw_type ||
      sym == dag_token_kw_data ||
      sym == dag_token_kw_fn
    }
  }
}


// Pipeline-facing LM that wires the full modeled grammar — use this for T-7/T-8+ pipeline calls.
fn dag_language_model_wave1_modeled() -> DagLanguageModel {
  dag_language_model_wave1()
}


// C5 ingest/emit fidelity disposition for the .dag surface trivia.
// Trivia rules (whitespace, line comments, block comments) are stripped by the lexer;
// a round-trip over trivia-bearing source produces trivia-free canonical output.
// These are DeclaredNormalized, not silent losses — reviewable, not hidden.
// 🟢 coproduct dissolution · all three trivia variants are terminal: each is exactly one LexRule
//    mapped to DeclaredNormalized; no additional variants possible under the wave-1 trivia model.
type DagTriviaNormalization
  = DagWhitespaceDeclaredNormalized
  | DagLineCommentDeclaredNormalized
  | DagBlockCommentDeclaredNormalized

fn dag_whitespace_fidelity() -> FidelityDisposition<DagTriviaNormalization> {
  DeclaredNormalized { feature: DagWhitespaceDeclaredNormalized }
}

fn dag_line_comment_fidelity() -> FidelityDisposition<DagTriviaNormalization> {
  DeclaredNormalized { feature: DagLineCommentDeclaredNormalized }
}

fn dag_block_comment_fidelity() -> FidelityDisposition<DagTriviaNormalization> {
  DeclaredNormalized { feature: DagBlockCommentDeclaredNormalized }
}


// 🟢 coproduct dissolution — module-header metadata edge names are fixed facts declared
// alongside dag_surface_module_header / dag_surface_module_header_qualified_name; Named
// edges bearing these symbols are structural header metadata, not declared exports.
fn dag_surface_module_header_metadata_edge(name: Symbol) -> Bool {
  (name == dag_surface_module_header)
    || (name == dag_surface_module_header_qualified_name)
}


// Caller-facing entry point for holders of a module header Node (emit or parse output): extracts
// the declared QualifiedName by walking dag_surface_module_header_qualified_name to the fold_list_node
// sub-node, then delegating to qualified_name_from_node in std/.
// std/qualified_name.dag cannot import dag_surface_module_header_qualified_name (extdeps/ → std/ only),
// so this wrapper lives in extdeps/. compiler/00_compile.dag admission calls this function on each
// batch entry (post-normalize module Node). std/module_batch.dag batch_delete/batch_lookup cannot
// use this wrapper (std/ layering barrier); they call qualified_name_from_node as best-effort and
// always receive Rejected for post-normalize module Nodes — kept as non-match per delete policy.
// 🟡 gated — T-8 parse fidelity — dissolve-on: T-8 lands per-identifier hashing. Until then every
// segment extracted from a real parse tree carries dag_token_ident (identifier identity unavailable);
// this function rejects at the extdeps/ boundary rather than returning a fabricated QualifiedName (P3).
// 🟡 traverse-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: traverse-node-outcome-algebra — bind diagnostic.dag Ratified-Q4 — dissolve-on: same Q4 gate as qualified_name_from_node; the nested Rejected/Accepted propagation inherits the same carrier threading constraint; forbidden: re-inlining the ladder after Q4 resolves.
// --- dag_mvp1_target_model (RTADD / ctrl#1489; mirror rust_mvp1_target_model) ---

fn dag_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn dag_int_inhabitant_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(name: dag_inhabitant_field_atom, target: dag_inhabitant_atom(id: dag_inhabitant_int)),
      dag_named_edge(
        name: dag_inhabitant_field_int,
        target: dag_inhabitant_atom(id: dag_surface_spelling_int)
      )
    ]
  }
}

fn dag_declared_inhabitants_core() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(name: dag_inhabitant_field_int, target: dag_int_inhabitant_node())
    ]
  }
}

data dag_mvp1_fixture_int_inhabitant: Node = dag_int_inhabitant_node()

data dag_mvp1_fixture_emitted_add_fn: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: dag_mvp1_fixture_int_inhabitant },
    Edge { label: Positional, target: dag_mvp1_fixture_int_inhabitant },
    Edge { label: Positional, target: dag_mvp1_fixture_int_inhabitant }
  ]
}

fn dag_mvp1_zip_fold_closure_edges() -> List<Edge> {
  [
    dag_named_edge(
      name: dag_inhabitant_field_mvp1_add_fn,
      target: dag_mvp1_fixture_emitted_add_fn
    ),
    dag_named_edge(
      name: dag_coercion_field_int_inhabitant_atom,
      target: dag_inhabitant_atom(id: dag_inhabitant_int)
    ),
    dag_named_edge(
      name: dag_coercion_field_int_surface_spelling,
      target: dag_inhabitant_atom(id: dag_surface_spelling_int)
    )
  ]
}

fn dag_mvp1_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_append(
      left: dag_declared_inhabitants_core().children,
      right: dag_mvp1_zip_fold_closure_edges()
    )
  }
}

fn dag_mvp1_selection_policy_node() -> Node {
  dag_int_inhabitant_node()
}

fn dag_mvp1_emitted_add_fn_node() -> Node {
  dag_mvp1_fixture_emitted_add_fn
}

fn dag_concrete_token_node(token: ConcreteSyntaxToken) -> Node {
  concrete_syntax_token_to_node(token: token)
}

fn dag_mvp1_serialize_source_prefix_edges() -> List<Edge> {
  [
    dag_named_edge(
      name: dag_mvp1_source_text_field,
      target: dag_inhabitant_atom(id: dag_mvp1_source_literal)
    ),
    dag_named_edge(
      name: dag_mvp1_source_grammar_field,
      target: dag_inhabitant_atom(id: dag_production_mvp1_fn_add)
    )
  ]
}

fn dag_mvp1_serialize_source_children() -> List<Edge> {
  list_append(
    left: dag_mvp1_serialize_source_prefix_edges(),
    right: [
      dag_named_edge(
        name: grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: dag_mvp1_concrete_tokens(),
          token_to_node: dag_concrete_token_node
        )
      )
    ]
  )
}

fn dag_mvp1_serialize_source_node() -> Node {
  let _authority = dag_mvp1_source_text
  Node {
    kind: TypeNode { connective: Conj },
    children: dag_mvp1_serialize_source_children()
  }
}

fn dag_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}

type DagGramBuild1State
  = DagGramBuild1StateInit
  | DagGramBuild1StateReady { expr: GrammarExpr }

fn dag_grammar_sequence_from_token_classes() -> GrammarExpr {
  match fold_list(
    xs: dag_mvp1_concrete_tokens(),
    empty: DagGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        DagGramBuild1StateInit =>
          DagGramBuild1StateReady {
            expr: dag_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
          }
        DagGramBuild1StateReady { expr: acc } =>
          DagGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: dag_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    DagGramBuild1StateInit =>
      dag_grammar_terminal(token_class: dag_token_kw_fn)
    DagGramBuild1StateReady { expr: result } => result
  }
}

fn dag_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn dag_formal_production_mvp1_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: dag_production_mvp1_fn_add,
    rhs: dag_formal_rhs_from_tokens(tokens: dag_mvp1_concrete_tokens())
  )
}

fn dag_grammar_production_mvp1_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: dag_production_mvp1_fn_add,
    expression: dag_grammar_sequence_from_token_classes(),
    emitted: dag_grammar_atom(id: dag_surface_fn_decl)
  }
}

fn dag_mvp1_grammar_relation_row_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: grammar_relation_field_production,
        target: formal_production_to_node(production: dag_formal_production_mvp1_fn_add())
      ),
      dag_named_edge(
        name: grammar_relation_field_emitted,
        target: dag_mvp1_emitted_add_fn_node()
      ),
      dag_named_edge(
        name: grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: dag_mvp1_concrete_tokens(),
          token_to_node: dag_concrete_token_node
        )
      )
    ]
  }
}

fn dag_mvp1_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: dag_relation_rule_mvp1_fn_add,
        target: dag_mvp1_grammar_relation_row_node()
      )
    ]
  }
}

fn dag_mvp1_target_model_bundle_core() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: target_model_edge_selection_policy,
        target: dag_mvp1_selection_policy_node()
      ),
      dag_named_edge(
        name: target_model_edge_declared_inhabitants,
        target: dag_mvp1_declared_inhabitants_root()
      ),
      dag_named_edge(
        name: target_model_edge_translation_rules,
        target: dag_mvp1_translation_rules_node()
      ),
      dag_named_edge(
        name: target_model_edge_serialize_source,
        target: dag_mvp1_serialize_source_node()
      )
    ]
  }
}

fn dag_mvp1_target_model_node() -> Node {
  dag_mvp1_target_model_bundle_core()
}

fn dag_mvp1_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), dag_binding_fn_add, "add")
  let m1 = map_insert(m0, dag_binding_param_x, "x")
  let m2 = map_insert(m1, dag_binding_param_y, "y")
  map_insert(m2, dag_binding_type_int, "Int")
}

fn dag_mvp1_target_model() -> TargetModel {
  TargetModel {
    bundle: dag_mvp1_target_model_node(),
    lex: dag_wave1_lex(),
    binding_spellings: dag_mvp1_binding_spellings(),
    authority_source_text: dag_mvp1_source_text
  }
}


