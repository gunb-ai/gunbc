import v4.std.collection { Set }
import v4.std.node { Conj, Node, Symbol, TypeNode }


data dag_c3_surface_sugar_service: Symbol = dag_c3_surface_sugar_service
data dag_c3_surface_sugar_fn: Symbol = dag_c3_surface_sugar_fn
data dag_c3_surface_sugar_type: Symbol = dag_c3_surface_sugar_type
data dag_c3_surface_sugar_operation: Symbol = dag_c3_surface_sugar_operation


data dag_lm_identity_native_dag: Symbol = dag_lm_identity_native_dag
>>>>>>> origin/main


type DagLanguageModel {
  lex: Node
  grammar: Node
  language_identity: Symbol
}


fn dag_wave1_e0_void_lex() -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: []
  }
}


fn dag_wave1_g0_void_grammar() -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: []
  }
}


fn dag_language_model_wave1_void() -> DagLanguageModel {
  DagLanguageModel {
    lex: dag_wave1_e0_void_lex(),
    grammar: dag_wave1_g0_void_grammar(),
    language_identity: dag_lm_identity_native_dag
  }
}


// DECISIONS.md §CP-1b (item 1).
fn dag_language_model_wave1_void_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      sym == dag_c3_surface_sugar_service ||
        sym == dag_c3_surface_sugar_fn ||
        sym == dag_c3_surface_sugar_type ||
        sym == dag_c3_surface_sugar_operation
    }
  }
}


fn dag_node_is_empty_conj_root(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Conj } => count(n.children) == 0
    _ => false
  }
}


// DECISIONS.md §CP-1b (item 2).
fn dag_language_model_is_wave1_void_shape(lm: DagLanguageModel) -> Bool {
  dag_node_is_empty_conj_root(n: lm.lex) &&
    dag_node_is_empty_conj_root(n: lm.grammar)
}


fn dag_language_model_empty_canonical_symbol_set() -> Set<Symbol> {
  Set {
    member: fn(_) {
      false
    }
  }
}


fn dag_language_model_canonical_symbols(lm: DagLanguageModel) -> Set<Symbol> {
  if dag_language_model_is_wave1_void_shape(lm: lm) &&
    lm.language_identity == dag_lm_identity_native_dag {
    dag_language_model_wave1_void_canonical_symbols()
  } else {
    dag_language_model_empty_canonical_symbol_set()
  }
}
