// src/v4/extdeps/languages/dag.dag
//
// Scope: Language #1 `LanguageModel` (B2-OMNI); same `Node` data for ingest + emit.
// Anchor: L-2 — `docs/v3-spec.md` + v4 `STRUCTURE.md`, `TASKS.md` T-6/T-7,
//         `compiler/01_tokenize.dag` / `02_parse.dag`, `DECISIONS.md` (B2-OMNI, PARSE-1, L-5).
//
// B2-OMNI: `.dag` never hardcoded in generic tokenizer/parser — `lex`/`grammar` `Node`
// trees are sole lexical/syntactic authority. PARSE-1: bodiless `fn` = grammar data
// (see `02_parse.dag`).
//
// Owns:
//   - `DagLanguageModel` — `lex: Node` + `grammar: Node` (LexRules/Grammar roles)
//   - Wave follow-on: production tables, C5 dispositions, resolver facts (Owns/ELSEWHERE)
//
// Consumes:
//   - std/node.dag: Node
//   - cross-ref: `docs/v3-spec.md`, `STRUCTURE.md`, `TASKS.md` T-4/T-6/T-7,
//     `DECISIONS.md` L-5 + B2-OMNI + PARSE-1 + L-2
//
// Status: C1 admitted; scaffold per T-4 + T-6/T-7.
// GATED: full TASKS bidirectional narrative with merged #3232 (operator HOLD).
// Brief: see BRIEF_TEMPLATE.md; splitting = operator ratification.


module v4.extdeps.languages.dag


import v4.std.node { Conj, Node, NodeKind, Symbol, TypeNode }


// C3 sugar Atom identities (THESIS:198-203, DECISIONS C3). Single mint for
// parse/normalize; no parallel `Symbol` authorities (K-1).
data dag_c3_surface_sugar_service: Symbol = dag_c3_surface_sugar_service
data dag_c3_surface_sugar_fn: Symbol = dag_c3_surface_sugar_fn
data dag_c3_surface_sugar_type: Symbol = dag_c3_surface_sugar_type
data dag_c3_surface_sugar_operation: Symbol = dag_c3_surface_sugar_operation


// ─────────────────────────────────────────────────────────────────────
// DagLanguageModel — gunbc `.dag` as a first-class Shape-A LanguageModel
// (B2-OMNI language #1). `lex` / `grammar` are the lexical and syntactic rule
// forests consumed by the generic pipeline stages; both are finite `Node`
// trees (A1), never procedural recognizers in `compiler/*`.
type DagLanguageModel {
  lex: Node
  grammar: Node
}


// ─────────────────────────────────────────────────────────────────────
// Wave-1 **E0 / G0** canonical roots — zero-production `Conj` leaves.
//
// These are the **data** instances `compiler/01_tokenize.dag` and
// `compiler/02_parse.dag` recognize structurally (empty `TypeNode{Conj}`
// child list). They are not special-cased in the walkers beyond that
// shared shape; any LanguageModel may reuse E0/G0 for empty fragments.
fn dag_wave1_e0_void_lex() -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: []
  }
}


fn dag_wave1_g0_void_grammar() -> Node {
  Node {
    kind: TypeNode {
      connective: Conj
    },
    children: []
  }
}


fn dag_language_model_wave1_void() -> DagLanguageModel {
  DagLanguageModel {
    lex: dag_wave1_e0_void_lex(),
    grammar: dag_wave1_g0_void_grammar()
  }
}
