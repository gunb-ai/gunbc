// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// JsScalar enumerates the ECMA-262 ES2025 primitive Types
// (https://tc39.es/ecma262/2025/multipage/ecmascript-data-types-and-values.html). Object is not a
// primitive and is intentionally absent.
type JsScalar
  = BigIntScalar
  | NumberScalar
  | StringScalar
  | BooleanScalar
  | UndefinedScalar
  | NullScalar
  | SymbolScalar

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// Non-numeric primitive arms (excludes BigInt + Number); paired with JsNonIntegerPrimitiveFacts.
type JsNonIntegerScalar
  = StringScalar
  | BooleanScalar
  | UndefinedScalar
  | NullScalar
  | SymbolScalar

// BigInt is the only ECMA-262 integer primitive — arbitrary precision, no width axis, no overflow.
type JsIntegerPrimitiveFacts {
  surface_spelling: Symbol
  range: Symbol
  representation: Symbol
  std_projection: Symbol
}

// Number is the only ECMA-262 floating-point primitive — IEEE 754 binary64.
type JsFloatPrimitiveFacts {
  surface_spelling: Symbol
  ieee754_binary: Symbol
  std_projection: Symbol
}

type JsNonIntegerPrimitiveFacts {
  surface_spelling: Symbol
  scalar: JsNonIntegerScalar
  std_projection: Symbol
  representation: Symbol
}

type JsLanguageModel {
  lex: LexRules
  grammar: Grammar
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

// Grammar relation row: fixed terminals and bound terminals share the JS grammar production
// instead of an operator string template. Mirrors RustConcreteSyntaxToken / RustGrammarRelationRow.
type JsConcreteSyntaxToken
  = JsFixedToken { token_class: Symbol }
  | JsBoundToken { token_class: Symbol, binding: Symbol }

type JsGrammarRelationRow {
  production: GrammarProduction
  emitted: Node
  tokens: List<JsConcreteSyntaxToken>
}

data js_language_model_surface_id: Symbol = js_language_model_surface_id

