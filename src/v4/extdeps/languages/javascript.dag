// Sole primitive-fact list authorities — ModelCore.primitives and catalog surface_symbol membership derive via fold.
data js_integer_facts_catalog: List<JsIntegerPrimitiveFacts> = [
  js_facts_bigint
]

data js_float_facts_catalog: List<JsFloatPrimitiveFacts> = [
  js_facts_number
]

data js_noninteger_facts_catalog: List<JsNonIntegerPrimitiveFacts> = [
  js_facts_string,
  js_facts_boolean,
  js_facts_undefined,
  js_facts_null,
