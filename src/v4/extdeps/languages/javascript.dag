data js_facts_symbol: JsNonIntegerPrimitiveFacts = JsNonIntegerPrimitiveFacts {
  surface_spelling: js_surface_spelling_symbol,
  scalar: SymbolScalar,
  std_projection: js_std_projection_symbol,
