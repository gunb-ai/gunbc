// Sole MVP-1 concrete-syntax authority — grammar and serialize_source project from this relation.
fn js_mvp1_concrete_tokens() -> List<JsConcreteSyntaxToken> {
  [
    JsFixedToken { token_class: js_token_kw_function },
    JsBoundToken { token_class: js_token_ident, binding: js_binding_fn_add },
    JsFixedToken { token_class: js_token_lparen },
    JsBoundToken { token_class: js_token_ident, binding: js_binding_param_x },
    JsFixedToken { token_class: js_token_comma },
    JsBoundToken { token_class: js_token_ident, binding: js_binding_param_y },
    JsFixedToken { token_class: js_token_rparen },
    JsFixedToken { token_class: js_token_lbrace },
    JsFixedToken { token_class: js_token_kw_return },
    JsBoundToken { token_class: js_token_ident, binding: js_binding_param_x },
    JsFixedToken { token_class: js_token_plus },
    JsBoundToken { token_class: js_token_ident, binding: js_binding_param_y },
    JsFixedToken { token_class: js_token_semicolon },
    JsFixedToken { token_class: js_token_rbrace }
  ]
}
data js_mvp1_source_text: String = "function add(x, y) { return x + y; }"

data js_facts_bigint: JsIntegerPrimitiveFacts = JsIntegerPrimitiveFacts {
  surface_spelling: js_surface_spelling_bigint,
  range: js_range_bigint_unbounded,
  representation: js_repr_bigint_arbitrary_precision,
  std_projection: js_std_projection_bigint
}

data js_facts_number: JsFloatPrimitiveFacts = JsFloatPrimitiveFacts {
  surface_spelling: js_surface_spelling_number,
  ieee754_binary: js_ieee754_binary64,
  std_projection: js_std_projection_number
}

data js_facts_string: JsNonIntegerPrimitiveFacts = JsNonIntegerPrimitiveFacts {
  surface_spelling: js_surface_spelling_string,
  scalar: StringScalar,
  std_projection: js_std_projection_string,
  representation: js_repr_string_utf16_code_units
}

data js_facts_boolean: JsNonIntegerPrimitiveFacts = JsNonIntegerPrimitiveFacts {
  surface_spelling: js_surface_spelling_boolean,
  scalar: BooleanScalar,
  std_projection: js_std_projection_boolean,
  representation: js_repr_boolean
}

data js_facts_undefined: JsNonIntegerPrimitiveFacts = JsNonIntegerPrimitiveFacts {
  surface_spelling: js_surface_spelling_undefined,
  scalar: UndefinedScalar,
  std_projection: js_std_projection_undefined,
  representation: js_repr_undefined_singleton
}

data js_facts_null: JsNonIntegerPrimitiveFacts = JsNonIntegerPrimitiveFacts {
  surface_spelling: js_surface_spelling_null,
  scalar: NullScalar,
  std_projection: js_std_projection_null,
  representation: js_repr_null_singleton
