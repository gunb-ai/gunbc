// src/v4/extdeps/languages/python.dag
// Scope: Python 3.14 Reference surface (numeric tower, singleton kinds, scalar sum, cost shape, partial D2 resolver).
// Owns: PythonNumericTower, PythonSingletonKind, PythonScalar, PythonCost, PyBool.
// Consumes: Kernel-ambient Bool, Int; std/integer, std/float, std/cardinality when T-3 alias rows land (DECISIONS.md D2-REV).
// Status: extdeps python slice; D2a(3) omits overflow carriers (principal int unbounded); D2a(2) defers with shared GroundingMap home. Part 6 ledger: DECISIONS.md (PR #3229) · CP-3229-GREEN-TERMINAL.
// Anchor: https://docs.python.org/3.14/reference/

module v4.extdeps.languages.python


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type PythonNumericTower
  =
  BoolLevel
  |
  IntegralLevel
  |
  RealLevel
  |
  ComplexLevel

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type PythonSingletonKind
  =
  NoneT
  |
  NotImplementedT
  |
  EllipsisT

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type PythonScalar
  = Numeric
    {
      tower: PythonNumericTower
    }
  |
  Singleton
    {
      kind: PythonSingletonKind
    }

type PythonCost
{
  operation_cost: Int
  allocation_cost: Int
}

type PyBool = Bool
