}

fn python_primitive_bundle_from_integer_facts(
  facts: PythonIntegerPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_integer_facts_node(facts: facts),
    spec_facts: python_integer_spec_facts(facts: facts)
  }
}

