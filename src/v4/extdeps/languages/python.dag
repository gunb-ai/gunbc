// 🟡 canonical-B decl-ref · E-6(b) bounded-exception · scaffold feature:canonical-b-grounding-consumer · dissolve-on: B1-CANON+zip-fold consume (ledger: B1·T-9/C1 · grounding-worked-examples.md §0)
data py_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn python_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn python_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn python_singleton_kind_tag(kind: PythonSingletonKind) -> Symbol {
  match kind {
    NoneT => python_tag_singleton_none
    NotImplementedT => python_tag_singleton_notimplemented
    EllipsisT => python_tag_singleton_ellipsis
  }
}

fn python_integer_facts_node(facts: PythonIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_encoding,
        target: python_inhabitant_atom(id: facts.encoding)
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

