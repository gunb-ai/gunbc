fn python_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_complex_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_complex_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_complex_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_bool_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_bool_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_bool_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_singleton_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_singleton_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_singleton_facts(facts: facts)
      )
    }
