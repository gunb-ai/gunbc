// src/v4/extdeps/languages/python.dag
// Scope: Python 3.14 Reference LanguageModel wave-1 — scalar fact-bundles + ModelCore (no lex/grammar/MVP yet — that lives behind T-11 rust-first specialization).
// Owns: PythonSingletonKind, PythonScalar, PythonCost, PythonIntegerPrimitiveFacts, PythonFloatPrimitiveFacts, PythonComplexPrimitiveFacts, PythonBoolPrimitiveFacts, PythonSingletonPrimitiveFacts, python_*_facts, python_*_facts_catalog, python_facts_node, python_*_primitive_bundle, python_model_core_wave1, py_bool_grounding.
// Consumes: v4.std.model_core (ModelCore + axis symbols), v4.std.collection, v4.std.node, v4.std.logic, v4.std.algebra.
// Status: T-4 python slice — Python Reference primitives (not CPython library types); int is honestly width-axis-omitted (unbounded — see C-PYINT below); ModelCore.primitives filled via fold; inhabitance/laws/effects/partiality empty (wave-2+). canonical-B bool decl-ref is 🟡 E-6(b) staging (mirrors rust slice).
// Anchor: https://docs.python.org/3.14/reference/datamodel.html
//
// C-PYINT — Python `int` carries no `width` / `signedness` / `overflow_disposition` axis.
// The reference defines `int` as an unbounded, signed integer with arbitrary precision; there
// is no overflow event. We honestly omit the axis bindings rather than fabricate a width tag
// (per fact-bundle reseed: "model the facts read from the spec, never a hollow alias").

module v4.extdeps.languages.python

import v4.std.collection { List }
import v4.std.model_core {
  EffectSemanticsDecl,
  ModelCore,
  PartialitySemanticsDecl,
  PrimitiveFactAxisBinding,
  PrimitiveFactBundle,
  primitive_fact_axis_encoding,
  primitive_fact_axis_surface_spelling
}
import v4.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode
}
import v4.std.logic { Bool, bool_boolean_algebra }
import v4.std.algebra { BooleanAlgebra, free_monoid_fold }

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PythonSingletonKind
  = NoneT | NotImplementedT | EllipsisT

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PythonScalar
  = IntScalar | FloatScalar | ComplexScalar | BoolScalar | Singleton { kind: PythonSingletonKind }

type PythonCost {
  operation_cost: Int
  allocation_cost: Int
}

// Spec-grounded fact rows. Field set per primitive reflects the axes the Python Reference
// actually pins; absent axes are absent in spec_facts (see C-PYINT for int).
type PythonIntegerPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type PythonFloatPrimitiveFacts {
  surface_spelling: Symbol
  ieee754_binary: Symbol
  std_projection: Symbol
}

type PythonComplexPrimitiveFacts {
  surface_spelling: Symbol
  component_ieee754_binary: Symbol
  std_projection: Symbol
}

type PythonBoolPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type PythonSingletonPrimitiveFacts {
  surface_spelling: Symbol
  kind: PythonSingletonKind
  std_projection: Symbol
}

data python_surface_spelling_int: Symbol = python_surface_spelling_int
data python_surface_spelling_float: Symbol = python_surface_spelling_float
data python_surface_spelling_complex: Symbol = python_surface_spelling_complex
data python_surface_spelling_bool: Symbol = python_surface_spelling_bool
data python_surface_spelling_none: Symbol = python_surface_spelling_none
data python_surface_spelling_notimplemented: Symbol = python_surface_spelling_notimplemented
data python_surface_spelling_ellipsis: Symbol = python_surface_spelling_ellipsis

data python_std_projection_int: Symbol = python_std_projection_int
data python_std_projection_float: Symbol = python_std_projection_float
data python_std_projection_complex: Symbol = python_std_projection_complex
data python_std_projection_bool: Symbol = python_std_projection_bool
data python_std_projection_none: Symbol = python_std_projection_none
data python_std_projection_notimplemented: Symbol = python_std_projection_notimplemented
data python_std_projection_ellipsis: Symbol = python_std_projection_ellipsis

// Encoding-axis values, each grounded in the Python Language Reference §3 (datamodel).
data python_repr_int_arbitrary_precision: Symbol = python_repr_int_arbitrary_precision
data python_ieee754_binary64: Symbol = python_ieee754_binary64
data python_repr_bool_int_subtype: Symbol = python_repr_bool_int_subtype
data python_repr_singleton_sole_inhabitant: Symbol = python_repr_singleton_sole_inhabitant

data python_facts_field_surface_spelling: Symbol = python_facts_field_surface_spelling
data python_facts_field_encoding: Symbol = python_facts_field_encoding
data python_facts_field_ieee754_binary: Symbol = python_facts_field_ieee754_binary
data python_facts_field_component_ieee754_binary: Symbol = python_facts_field_component_ieee754_binary
data python_facts_field_std_projection: Symbol = python_facts_field_std_projection
data python_facts_field_singleton_kind: Symbol = python_facts_field_singleton_kind

data python_tag_singleton_none: Symbol = python_tag_singleton_none
data python_tag_singleton_notimplemented: Symbol = python_tag_singleton_notimplemented
data python_tag_singleton_ellipsis: Symbol = python_tag_singleton_ellipsis

data python_facts_int: PythonIntegerPrimitiveFacts = PythonIntegerPrimitiveFacts {
  surface_spelling: python_surface_spelling_int,
  encoding: python_repr_int_arbitrary_precision,
  std_projection: python_std_projection_int
}

data python_facts_float: PythonFloatPrimitiveFacts = PythonFloatPrimitiveFacts {
  surface_spelling: python_surface_spelling_float,
  ieee754_binary: python_ieee754_binary64,
  std_projection: python_std_projection_float
}

data python_facts_complex: PythonComplexPrimitiveFacts = PythonComplexPrimitiveFacts {
  surface_spelling: python_surface_spelling_complex,
  component_ieee754_binary: python_ieee754_binary64,
  std_projection: python_std_projection_complex
}

data python_facts_bool: PythonBoolPrimitiveFacts = PythonBoolPrimitiveFacts {
  surface_spelling: python_surface_spelling_bool,
  encoding: python_repr_bool_int_subtype,
  std_projection: python_std_projection_bool
}

data python_facts_none: PythonSingletonPrimitiveFacts = PythonSingletonPrimitiveFacts {
  surface_spelling: python_surface_spelling_none,
  kind: NoneT,
  std_projection: python_std_projection_none
}

data python_facts_notimplemented: PythonSingletonPrimitiveFacts = PythonSingletonPrimitiveFacts {
  surface_spelling: python_surface_spelling_notimplemented,
  kind: NotImplementedT,
  std_projection: python_std_projection_notimplemented
}

data python_facts_ellipsis: PythonSingletonPrimitiveFacts = PythonSingletonPrimitiveFacts {
  surface_spelling: python_surface_spelling_ellipsis,
  kind: EllipsisT,
  std_projection: python_std_projection_ellipsis
}

// Sole primitive-fact list authorities — ModelCore.primitives derives via fold; per-primitive
// add a row here, not a separate enumerate-by-hand list elsewhere.
data python_integer_facts_catalog: List<PythonIntegerPrimitiveFacts> = [
  python_facts_int
]

data python_float_facts_catalog: List<PythonFloatPrimitiveFacts> = [
  python_facts_float
]

data python_complex_facts_catalog: List<PythonComplexPrimitiveFacts> = [
  python_facts_complex
]

data python_bool_facts_catalog: List<PythonBoolPrimitiveFacts> = [
  python_facts_bool
]

data python_singleton_facts_catalog: List<PythonSingletonPrimitiveFacts> = [
  python_facts_none,
  python_facts_notimplemented,
  python_facts_ellipsis
]

// 🟡 canonical-B decl-ref (truth facet; bool is the int-subtype build-up = BoolScalar) · E-6(b) bounded-exception · scaffold feature:canonical-b-grounding-consumer · dissolve-on: B1-CANON+zip-fold consume (ledger: B1·T-9/C1 · grounding-worked-examples.md §0)
data py_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn python_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn python_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn python_singleton_kind_tag(kind: PythonSingletonKind) -> Symbol {
  match kind {
    NoneT => python_tag_singleton_none
    NotImplementedT => python_tag_singleton_notimplemented
    EllipsisT => python_tag_singleton_ellipsis
  }
}

fn python_integer_facts_node(facts: PythonIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_encoding,
        target: python_inhabitant_atom(id: facts.encoding)
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn python_float_facts_node(facts: PythonFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_ieee754_binary,
        target: python_inhabitant_atom(id: facts.ieee754_binary)
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn python_complex_facts_node(facts: PythonComplexPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_component_ieee754_binary,
        target: python_inhabitant_atom(id: facts.component_ieee754_binary)
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn python_bool_facts_node(facts: PythonBoolPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_encoding,
        target: python_inhabitant_atom(id: facts.encoding)
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn python_singleton_facts_node(facts: PythonSingletonPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_singleton_kind,
        target: python_inhabitant_atom(id: python_singleton_kind_tag(kind: facts.kind))
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn python_primitive_axis_binding(axis: Symbol, fact: Node) -> PrimitiveFactAxisBinding {
  PrimitiveFactAxisBinding { axis: axis, fact: fact }
}

// C-PYINT: only surface_spelling + encoding axes bind — width/signedness/overflow are
// absent from the Python int spec and are honestly absent from spec_facts.
fn python_primitive_bundle_from_integer_facts(
  facts: PythonIntegerPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_integer_facts_node(facts: facts),
    spec_facts: [
      python_primitive_axis_binding(
        axis: primitive_fact_axis_surface_spelling,
        fact: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: python_inhabitant_atom(id: facts.encoding)
      )
    ]
  }
}

fn python_primitive_bundle_from_float_facts(
  facts: PythonFloatPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_float_facts_node(facts: facts),
    spec_facts: [
      python_primitive_axis_binding(
        axis: primitive_fact_axis_surface_spelling,
        fact: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: python_inhabitant_atom(id: facts.ieee754_binary)
      )
    ]
  }
}

fn python_primitive_bundle_from_complex_facts(
  facts: PythonComplexPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_complex_facts_node(facts: facts),
    spec_facts: [
      python_primitive_axis_binding(
        axis: primitive_fact_axis_surface_spelling,
        fact: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: python_inhabitant_atom(id: facts.component_ieee754_binary)
      )
    ]
  }
}

// Python bool is `int`-subtype per the reference; the int-subtype encoding witnesses the
// inheritance. No signedness binding — bool is not its own signed-integer fact, and binding
// `primitive_fact_axis_signedness` here would re-assert the parent int's axes inside bool.
fn python_primitive_bundle_from_bool_facts(
  facts: PythonBoolPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_bool_facts_node(facts: facts),
    spec_facts: [
      python_primitive_axis_binding(
        axis: primitive_fact_axis_surface_spelling,
        fact: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: python_inhabitant_atom(id: facts.encoding)
      )
    ]
  }
}

fn python_primitive_bundle_from_singleton_facts(
  facts: PythonSingletonPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_singleton_facts_node(facts: facts),
    spec_facts: [
      python_primitive_axis_binding(
        axis: primitive_fact_axis_surface_spelling,
        fact: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: python_inhabitant_atom(id: python_repr_singleton_sole_inhabitant)
      )
    ]
  }
}

// Order-preserving snoc + append, mirroring the rust slice — kept local to this file so the
// fold authority isn't pulled in from a peer language extdep (substrate cohesion).
fn python_list_snoc_item<T>(xs: List<T>, item: T) -> List<T> {
  free_monoid_fold(
    xs: xs,
    empty: Cons { head: item, tail: Empty },
    cons: fn(rest, existing) {
      Cons { head: existing, tail: rest }
    }
  )
}

fn python_list_append<T>(left: List<T>, right: List<T>) -> List<T> {
  free_monoid_fold(
    xs: right,
    empty: left,
    cons: fn(acc, item) {
      python_list_snoc_item(xs: acc, item: item)
    }
  )
}

fn python_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  free_monoid_fold(
    xs: python_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      python_list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  free_monoid_fold(
    xs: python_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      python_list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_complex_catalog() -> List<PrimitiveFactBundle> {
  free_monoid_fold(
    xs: python_complex_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      python_list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_complex_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_bool_catalog() -> List<PrimitiveFactBundle> {
  free_monoid_fold(
    xs: python_bool_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      python_list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_bool_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_singleton_catalog() -> List<PrimitiveFactBundle> {
  free_monoid_fold(
    xs: python_singleton_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      python_list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_singleton_facts(facts: facts)
      )
    }
  )
}

fn python_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  python_list_append(
    left: python_list_append(
      left: python_list_append(
        left: python_list_append(
          left: python_primitive_bundles_from_integer_catalog(),
          right: python_primitive_bundles_from_float_catalog()
        ),
        right: python_primitive_bundles_from_complex_catalog()
      ),
      right: python_primitive_bundles_from_bool_catalog()
    ),
    right: python_primitive_bundles_from_singleton_catalog()
  )
}

// 🟡 wave-1 ModelCore — inhabitance / laws / effects / partiality empty (dissolve-on: T-9
// infer + per-operator partiality discharge bind under T-33 effect/partiality substrate;
// pattern mirrors `rust_model_core_wave1`).
fn python_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: python_wave1_primitive_fact_bundles(),
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}
