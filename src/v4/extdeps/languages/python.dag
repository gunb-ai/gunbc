import v4.std.text { String }

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PythonSingletonKind
  = NoneT | NotImplementedT | EllipsisT

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PythonScalar
  = IntScalar | FloatScalar | ComplexScalar | BoolScalar | Singleton { kind: PythonSingletonKind }

type PythonCost {
  operation_cost: Int
  allocation_cost: Int
}

// PythonConcreteSyntaxToken: 🟢 coproduct dissolution — token rows are fixed-or-bound alternatives in the grammar relation.
type PythonConcreteSyntaxToken
  = PythonFixedToken { token_class: Symbol }
  | PythonBoundToken { token_class: Symbol, binding: Symbol }

type PythonGrammarRelationRow {
  production: GrammarProduction
  emitted: Node
  tokens: List<PythonConcreteSyntaxToken>
}

// Spec-grounded fact rows. Field set per primitive reflects the axes the Python Reference
// actually pins; absent axes are absent in spec_facts (see C-PYINT for int).
type PythonIntegerPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

// Python Reference §3.2: "These represent machine-level double precision floating point
// numbers. You are at the mercy of the underlying machine architecture (and C or Java
// implementation) for the accepted range and handling of overflow." — so the reference
// pins "machine-level double precision", not IEEE 754 binary64 specifically. We track the
// reference wording; tightening to a specific binary standard is a CPython/ABI implementation
// fact for a separate carrier (future work).
type PythonFloatPrimitiveFacts {
  surface_spelling: Symbol
  machine_representation: Symbol
  std_projection: Symbol
}

// Python Reference §3.2: "These represent complex numbers as a pair of machine-level double
// precision floating point numbers." Component representation likewise tracks reference wording.
type PythonComplexPrimitiveFacts {
  surface_spelling: Symbol
  component_machine_representation: Symbol
  std_projection: Symbol
}

type PythonBoolPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type PythonSingletonPrimitiveFacts {
  surface_spelling: Symbol
  kind: PythonSingletonKind
  std_projection: Symbol
}

data python_surface_spelling_int: Symbol = python_surface_spelling_int
data python_surface_spelling_float: Symbol = python_surface_spelling_float
data python_surface_spelling_complex: Symbol = python_surface_spelling_complex
data python_surface_spelling_bool: Symbol = python_surface_spelling_bool
data python_surface_spelling_none: Symbol = python_surface_spelling_none
data python_surface_spelling_notimplemented: Symbol = python_surface_spelling_notimplemented
data python_surface_spelling_ellipsis: Symbol = python_surface_spelling_ellipsis

data python_std_projection_int: Symbol = python_std_projection_int
data python_std_projection_float: Symbol = python_std_projection_float
data python_std_projection_complex: Symbol = python_std_projection_complex
data python_std_projection_bool: Symbol = python_std_projection_bool
data python_std_projection_none: Symbol = python_std_projection_none
data python_std_projection_notimplemented: Symbol = python_std_projection_notimplemented
data python_std_projection_ellipsis: Symbol = python_std_projection_ellipsis

// Encoding-axis values, each grounded in the Python Language Reference §3 (datamodel).
data python_repr_int_arbitrary_precision: Symbol = python_repr_int_arbitrary_precision
data python_repr_float_machine_double_precision: Symbol = python_repr_float_machine_double_precision
data python_repr_complex_pair_machine_double_precision: Symbol = python_repr_complex_pair_machine_double_precision
data python_repr_bool_int_subtype: Symbol = python_repr_bool_int_subtype
data python_repr_singleton_sole_inhabitant: Symbol = python_repr_singleton_sole_inhabitant

data python_facts_field_surface_spelling: Symbol = python_facts_field_surface_spelling
data python_facts_field_encoding: Symbol = python_facts_field_encoding
data python_facts_field_machine_representation: Symbol = python_facts_field_machine_representation
data python_facts_field_component_machine_representation: Symbol = python_facts_field_component_machine_representation
data python_facts_field_std_projection: Symbol = python_facts_field_std_projection
data python_facts_field_singleton_kind: Symbol = python_facts_field_singleton_kind

data python_inhabitant_int: Symbol = python_inhabitant_int
data python_inhabitant_float: Symbol = python_inhabitant_float
data python_inhabitant_field_atom: Symbol = python_inhabitant_field_atom
data python_inhabitant_field_facts: Symbol = python_inhabitant_field_facts
data python_inhabitant_field_int: Symbol = python_inhabitant_field_int
data python_inhabitant_field_float: Symbol = python_inhabitant_field_float

data python_tag_singleton_none: Symbol = python_tag_singleton_none
data python_tag_singleton_notimplemented: Symbol = python_tag_singleton_notimplemented
data python_tag_singleton_ellipsis: Symbol = python_tag_singleton_ellipsis

data python_token_kw_def: Symbol = python_token_kw_def
data python_token_kw_return: Symbol = python_token_kw_return
data python_token_ident: Symbol = python_token_ident
data python_token_colon: Symbol = python_token_colon
data python_token_lparen: Symbol = python_token_lparen
data python_token_rparen: Symbol = python_token_rparen
data python_token_comma: Symbol = python_token_comma
data python_token_plus: Symbol = python_token_plus
data python_production_mvp1_fn_add: Symbol = python_production_mvp1_fn_add
data python_binding_fn_add: Symbol = python_binding_fn_add
data python_binding_param_x: Symbol = python_binding_param_x
data python_binding_param_y: Symbol = python_binding_param_y
data python_relation_rule_mvp1_fn_add: Symbol = python_relation_rule_mvp1_fn_add
data python_mvp1_source_literal: Symbol = python_mvp1_source_literal
data python_mvp1_source_text_field: Symbol = serialize_source_field_source_text
data python_mvp1_source_grammar_field: Symbol = serialize_source_field_source_grammar
data python_mvp1_source_text: String = "def add(x, y): return x + y"

fn python_mvp1_concrete_tokens() -> List<PythonConcreteSyntaxToken> {
  [
    PythonFixedToken { token_class: python_token_kw_def },
    PythonBoundToken { token_class: python_token_ident, binding: python_binding_fn_add },
    PythonFixedToken { token_class: python_token_lparen },
    PythonBoundToken { token_class: python_token_ident, binding: python_binding_param_x },
    PythonFixedToken { token_class: python_token_comma },
    PythonBoundToken { token_class: python_token_ident, binding: python_binding_param_y },
    PythonFixedToken { token_class: python_token_rparen },
    PythonFixedToken { token_class: python_token_colon },
    PythonFixedToken { token_class: python_token_kw_return },
    PythonBoundToken { token_class: python_token_ident, binding: python_binding_param_x },
    PythonFixedToken { token_class: python_token_plus },
    PythonBoundToken { token_class: python_token_ident, binding: python_binding_param_y }
  ]
}

data python_facts_int: PythonIntegerPrimitiveFacts = PythonIntegerPrimitiveFacts {
  surface_spelling: python_surface_spelling_int,
  encoding: python_repr_int_arbitrary_precision,
  std_projection: python_std_projection_int
}

data python_facts_float: PythonFloatPrimitiveFacts = PythonFloatPrimitiveFacts {
  surface_spelling: python_surface_spelling_float,
  machine_representation: python_repr_float_machine_double_precision,
  std_projection: python_std_projection_float
}

data python_facts_complex: PythonComplexPrimitiveFacts = PythonComplexPrimitiveFacts {
  surface_spelling: python_surface_spelling_complex,
  component_machine_representation: python_repr_complex_pair_machine_double_precision,
  std_projection: python_std_projection_complex
}

data python_facts_bool: PythonBoolPrimitiveFacts = PythonBoolPrimitiveFacts {
  surface_spelling: python_surface_spelling_bool,
  encoding: python_repr_bool_int_subtype,
  std_projection: python_std_projection_bool
}

data python_facts_none: PythonSingletonPrimitiveFacts = PythonSingletonPrimitiveFacts {
  surface_spelling: python_surface_spelling_none,
  kind: NoneT,
  std_projection: python_std_projection_none
}

data python_facts_notimplemented: PythonSingletonPrimitiveFacts = PythonSingletonPrimitiveFacts {
  surface_spelling: python_surface_spelling_notimplemented,
  kind: NotImplementedT,
  std_projection: python_std_projection_notimplemented
}

data python_facts_ellipsis: PythonSingletonPrimitiveFacts = PythonSingletonPrimitiveFacts {
  surface_spelling: python_surface_spelling_ellipsis,
  kind: EllipsisT,
  std_projection: python_std_projection_ellipsis
}

// Sole primitive-fact list authorities — ModelCore.primitives derives via fold; per-primitive
// add a row here, not a separate enumerate-by-hand list elsewhere.
data python_integer_facts_catalog: List<PythonIntegerPrimitiveFacts> = [
  python_facts_int
]

data python_float_facts_catalog: List<PythonFloatPrimitiveFacts> = [
  python_facts_float
]

data python_complex_facts_catalog: List<PythonComplexPrimitiveFacts> = [
  python_facts_complex
]

data python_bool_facts_catalog: List<PythonBoolPrimitiveFacts> = [
  python_facts_bool
]

data python_singleton_facts_catalog: List<PythonSingletonPrimitiveFacts> = [
  python_facts_none,
  python_facts_notimplemented,
  python_facts_ellipsis
]

// 🟡 canonical-B decl-ref (truth facet; bool is the int-subtype build-up = BoolScalar) · E-6(b) bounded-exception · scaffold feature:canonical-b-grounding-consumer · dissolve-on: B1-CANON+zip-fold consume (ledger: B1·T-9/C1 · grounding-worked-examples.md §0)
data py_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn python_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn python_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn python_singleton_kind_tag(kind: PythonSingletonKind) -> Symbol {
  match kind {
    NoneT => python_tag_singleton_none
    NotImplementedT => python_tag_singleton_notimplemented
    EllipsisT => python_tag_singleton_ellipsis
  }
}

fn python_integer_facts_node(facts: PythonIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_encoding,
        target: python_inhabitant_atom(id: facts.encoding)
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn python_float_facts_node(facts: PythonFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_machine_representation,
        target: python_inhabitant_atom(id: facts.machine_representation)
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

