module v4.extdeps.languages.python

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type PythonSingletonKind
  = NoneT
  | NotImplementedT
  | EllipsisT

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · SL-3309-PYTHON-SCALAR-RESEED.
type PythonScalar
  = IntScalar
  | FloatScalar
  | ComplexScalar
  | BoolScalar
  | Singleton { kind: PythonSingletonKind }

type PythonCost {
  operation_cost: Int
  allocation_cost: Int
}

type PyBool = Bool
