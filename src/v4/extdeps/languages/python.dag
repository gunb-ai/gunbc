fn python_singleton_facts_node(facts: PythonSingletonPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_singleton_kind,
        target: python_inhabitant_atom(id: python_singleton_kind_tag(kind: facts.kind))
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn python_integer_spec_facts(facts: PythonIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: python_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_encoding =>
          Holds { value: python_inhabitant_atom(id: facts.encoding) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn python_float_spec_facts(facts: PythonFloatPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: python_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_encoding =>
          Holds { value: python_inhabitant_atom(id: facts.machine_representation) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn python_complex_spec_facts(facts: PythonComplexPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: python_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_encoding =>
          Holds { value: python_inhabitant_atom(id: facts.component_machine_representation) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn python_bool_spec_facts(facts: PythonBoolPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: python_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_encoding =>
          Holds { value: python_inhabitant_atom(id: facts.encoding) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn python_singleton_spec_facts(facts: PythonSingletonPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: python_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_encoding =>
          Holds { value: python_inhabitant_atom(id: python_repr_singleton_sole_inhabitant) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

// C-PYINT: only surface_spelling + encoding axes bind — width/signedness/overflow are
// absent from the Python int spec and are honestly absent from spec_facts.
fn python_primitive_bundle_from_integer_facts(
  facts: PythonIntegerPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_integer_facts_node(facts: facts),
    spec_facts: python_integer_spec_facts(facts: facts)
  }
}

fn python_primitive_bundle_from_float_facts(
  facts: PythonFloatPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_float_facts_node(facts: facts),
    spec_facts: python_float_spec_facts(facts: facts)
  }
}

fn python_primitive_bundle_from_complex_facts(
  facts: PythonComplexPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_complex_facts_node(facts: facts),
    spec_facts: python_complex_spec_facts(facts: facts)
  }
}

// Python bool is `int`-subtype per the reference; the int-subtype encoding witnesses the
// inheritance. No signedness binding — bool is not its own signed-integer fact, and binding
// `primitive_fact_axis_signedness` here would re-assert the parent int's axes inside bool.
fn python_primitive_bundle_from_bool_facts(
  facts: PythonBoolPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_bool_facts_node(facts: facts),
    spec_facts: python_bool_spec_facts(facts: facts)
  }
}

fn python_primitive_bundle_from_singleton_facts(
  facts: PythonSingletonPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: python_singleton_facts_node(facts: facts),
    spec_facts: python_singleton_spec_facts(facts: facts)
  }
}

fn python_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_complex_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_complex_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_complex_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_bool_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_bool_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_bool_facts(facts: facts)
      )
    }
  )
}

fn python_primitive_bundles_from_singleton_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: python_singleton_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: python_primitive_bundle_from_singleton_facts(facts: facts)
      )
    }
  )
}

fn python_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  list_append(
    left: list_append(
      left: list_append(
        left: list_append(
          left: python_primitive_bundles_from_integer_catalog(),
          right: python_primitive_bundles_from_float_catalog()
        ),
        right: python_primitive_bundles_from_complex_catalog()
      ),
      right: python_primitive_bundles_from_bool_catalog()
    ),
    right: python_primitive_bundles_from_singleton_catalog()
  )
}

// 🟡 needs-more-work — feature:python-language-model-wave1-consumer — E-6(b) bounded
// exception — scaffold: T-4 python slice has no PythonLanguageModel carrier yet (lex /
// grammar / MVP / canonical_symbols / language_identity are T-11 rust-first specialization
// follow-on work), so this ModelCore is consumer-less in-tree. Dissolve-on: PythonLanguageModel
// (mirroring RustLanguageModel) lands and binds `core: python_model_core_wave1()`.
// Inhabitance / laws / effects / partiality stay empty until T-9 infer + T-33
// effect/partiality substrate bind per-operator (separate, additive dissolution).
fn python_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: python_wave1_primitive_fact_bundles(),
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn python_inhabitant_node(id: Symbol, facts: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(name: python_inhabitant_field_atom, target: python_inhabitant_atom(id: id)),
      python_named_edge(name: python_inhabitant_field_facts, target: facts)
    ]
  }
}

fn python_int_inhabitant_node() -> Node {
  python_inhabitant_node(
    id: python_inhabitant_int,
    facts: python_integer_facts_node(facts: python_facts_int)
  )
}

fn python_float_inhabitant_node() -> Node {
  python_inhabitant_node(
    id: python_inhabitant_float,
    facts: python_float_facts_node(facts: python_facts_float)
  )
}

fn python_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(name: python_inhabitant_field_int, target: python_int_inhabitant_node()),
      python_named_edge(name: python_inhabitant_field_float, target: python_float_inhabitant_node())
    ]
  }
}

fn python_mvp1_selection_policy_node() -> Node {
  python_int_inhabitant_node()
}

fn python_mvp1_emitted_add_fn_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: python_int_inhabitant_node() },
      Edge { label: Positional, target: python_int_inhabitant_node() },
      Edge { label: Positional, target: python_int_inhabitant_node() }
    ]
  }
}

fn python_concrete_token_class(token: PythonConcreteSyntaxToken) -> Symbol {
  match token {
    PythonFixedToken { token_class: c } => c
    PythonBoundToken { token_class: c, binding: _ } => c
  }
}

fn python_concrete_token_node(token: PythonConcreteSyntaxToken) -> Node {
  match token {
    PythonFixedToken { token_class: c } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          python_named_edge(name: concrete_syntax_token_field_kind, target: python_inhabitant_atom(id: concrete_syntax_token_kind_fixed)),
          python_named_edge(name: concrete_syntax_token_field_class, target: python_inhabitant_atom(id: c))
        ]
      }
    PythonBoundToken { token_class: c, binding: b } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          python_named_edge(name: concrete_syntax_token_field_kind, target: python_inhabitant_atom(id: concrete_syntax_token_kind_bound)),
          python_named_edge(name: concrete_syntax_token_field_class, target: python_inhabitant_atom(id: c)),
          python_named_edge(name: concrete_syntax_token_field_binding, target: python_inhabitant_atom(id: b))
        ]
      }
  }
}

fn python_positional_token_edge(token: PythonConcreteSyntaxToken) -> Edge {
  Edge { label: Positional, target: python_concrete_token_node(token: token) }
}

fn python_positional_edges_from_token_classes() -> List<Edge> {
  fold_list(
    xs: python_mvp1_concrete_tokens(),
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(xs: acc, item: python_positional_token_edge(token: token))
    }
  )
}

fn python_mvp1_serialize_source_children() -> List<Edge> {
  list_append(
    left: [
      python_named_edge(name: python_mvp1_source_text_field, target: python_inhabitant_atom(id: python_mvp1_source_literal)),
      python_named_edge(name: python_mvp1_source_grammar_field, target: python_inhabitant_atom(id: python_production_mvp1_fn_add))
    ],
    right: python_positional_edges_from_token_classes()
  )
}

fn python_mvp1_serialize_source_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: python_mvp1_serialize_source_children()
  }
}

fn python_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}

// 🟡 coproduct dissolution — SL-T11-GRAMMAR-FROM-TOKEN-ROW — feature:t11-grammar-from-token-row — bind task: src/v4/TASKS.md#t-11-emit-per-target-specialization — owner:T-11 target-model grammar rows — dissolve-on-arrival: replace the fold1 accumulator with a std fold_non_empty/list-to-sequence helper once that helper lands and T-11 grammar rows consume it; forbidden: hand-authoring token-class sequence trees beside python_mvp1_concrete_tokens.
type PythonGrammarSequenceBuild {
  head: PythonConcreteSyntaxToken
  tail: List<PythonConcreteSyntaxToken>
}

fn python_grammar_sequence_from_tokens(tokens: PythonGrammarSequenceBuild) -> GrammarExpr {
  let terminal = python_grammar_terminal(token_class: python_concrete_token_class(token: tokens.head))
  fold_list(
    xs: tokens.tail,
    empty: terminal,
    cons: fn(acc, token) {
      Sequence {
        left: acc,
        right: python_grammar_terminal(token_class: python_concrete_token_class(token: token))
      }
    }
  )
}

fn python_mvp1_grammar_tokens() -> PythonGrammarSequenceBuild {
  PythonGrammarSequenceBuild {
    head: PythonFixedToken { token_class: python_token_kw_def },
    tail: [
      PythonBoundToken { token_class: python_token_ident, binding: python_binding_fn_add },
      PythonFixedToken { token_class: python_token_lparen },
      PythonBoundToken { token_class: python_token_ident, binding: python_binding_param_x },
      PythonFixedToken { token_class: python_token_comma },
      PythonBoundToken { token_class: python_token_ident, binding: python_binding_param_y },
      PythonFixedToken { token_class: python_token_rparen },
      PythonFixedToken { token_class: python_token_colon },
      PythonFixedToken { token_class: python_token_kw_return },
      PythonBoundToken { token_class: python_token_ident, binding: python_binding_param_x },
      PythonFixedToken { token_class: python_token_plus },
      PythonBoundToken { token_class: python_token_ident, binding: python_binding_param_y }
    ]
  }
}

fn python_grammar_sequence_from_token_classes() -> GrammarExpr {
  python_grammar_sequence_from_tokens(tokens: python_mvp1_grammar_tokens())
}

fn python_grammar_production_mvp1_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: python_production_mvp1_fn_add,
    expression: python_grammar_sequence_from_token_classes(),
    emitted: python_mvp1_emitted_add_fn_node()
  }
}

fn python_mvp1_grammar_relation_row() -> PythonGrammarRelationRow {
  PythonGrammarRelationRow {
    production: python_grammar_production_mvp1_fn_add(),
    emitted: python_mvp1_emitted_add_fn_node(),
    tokens: python_mvp1_concrete_tokens()
  }
}

fn python_relation_token_edges(tokens: List<PythonConcreteSyntaxToken>) -> List<Edge> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(xs: acc, item: python_positional_token_edge(token: token))
    }
  )
}

fn python_grammar_relation_row_node(row: PythonGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(name: grammar_relation_field_production, target: grammar_production_to_node(production: row.production)),
      python_named_edge(name: grammar_relation_field_emitted, target: row.emitted),
      python_named_edge(
        name: grammar_relation_field_tokens,
        target: Node {
          kind: TypeNode { connective: Conj },
          children: python_relation_token_edges(tokens: row.tokens)
        }
      )
    ]
  }
}

fn python_mvp1_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_relation_rule_mvp1_fn_add,
        target: python_grammar_relation_row_node(row: python_mvp1_grammar_relation_row())
      )
    ]
  }
}

fn python_mvp1_target_model_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(name: target_model_edge_selection_policy, target: python_mvp1_selection_policy_node()),
      python_named_edge(name: target_model_edge_declared_inhabitants, target: python_declared_inhabitants_root()),
      python_named_edge(name: target_model_edge_translation_rules, target: python_mvp1_translation_rules_node()),
      python_named_edge(name: target_model_edge_serialize_source, target: python_mvp1_serialize_source_node())
    ]
  }
}

fn python_mvp1_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), python_binding_fn_add, "add"),
      python_binding_param_x,
      "x"
    ),
    python_binding_param_y,
    "y"
  )
}

fn python_mvp1_target_model() -> TargetModel {
  TargetModel {
    bundle: python_mvp1_target_model_node(),
    lex: python_wave1_lex(),
    binding_spellings: python_mvp1_binding_spellings(),
    authority_source_text: python_mvp1_source_text
  }
}

fn python_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule { token_class: token_class, pattern: LiteralPattern { text: text } }
}

fn python_wave1_lex_rules() -> List<LexRule> {
  [
    python_lex_rule(token_class: python_token_kw_def, text: "def "),
    python_lex_rule(token_class: python_token_lparen, text: "("),
    python_lex_rule(token_class: python_token_comma, text: ", "),
    python_lex_rule(token_class: python_token_rparen, text: ")"),
    python_lex_rule(token_class: python_token_colon, text: ": "),
    python_lex_rule(token_class: python_token_kw_return, text: "return "),
    python_lex_rule(token_class: python_token_plus, text: " + ")
  ]
}

fn python_wave1_lex() -> LexRules {
  ModeledLexRules { root: LexRuleSet { rules: python_wave1_lex_rules() } }
}
