module v4.extdeps.languages.python

import v4.std.logic { Bool, bool_boolean_algebra }
import v4.std.algebra { BooleanAlgebra }

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type PythonNumericTower
  = BoolLevel
  | IntegralLevel
  | RealLevel
  | ComplexLevel

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type PythonSingletonKind
  = NoneT
  | NotImplementedT
  | EllipsisT

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type PythonScalar
  = Numeric { tower: PythonNumericTower }
  | Singleton { kind: PythonSingletonKind }

type PythonCost {
  operation_cost: Int
  allocation_cost: Int
}

// 🟢 Singleton / `Unit` D2a slice — DECISIONS.md §PR-3252-extdeps-deferrals + §PR-3252-cardinality-std (Practice 9).

// Anchor: https://docs.python.org/3.14/library/stdtypes.html#boolean-type-bool
// Python data model: `bool` has exactly `True`/`False` with the standard
// boolean operations — the shared 2-element BooleanAlgebra (truth facet,
// grounded by referencing the single std authority). DISTINCT spec fact:
// `bool` is a subtype of `int` (True==1, False==0) — that build-up above
// the primitive is the PythonNumericTower.BoolLevel classifier, NOT this
// truth grounding. Object/singleton identity is a runtime-layer fact,
// out of this type model (placement axis). First iteration — see §0.
data py_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra
