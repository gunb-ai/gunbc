  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_component_machine_representation,
        target: python_inhabitant_atom(id: facts.component_machine_representation)
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
        target: python_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn python_bool_facts_node(facts: PythonBoolPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: facts.surface_spelling)
      ),
      python_named_edge(
        name: python_facts_field_encoding,
        target: python_inhabitant_atom(id: facts.encoding)
      ),
      python_named_edge(
        name: python_facts_field_std_projection,
