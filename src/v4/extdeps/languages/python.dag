fn python_integer_spec_facts(facts: PythonIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: python_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_encoding =>
          Holds { value: python_inhabitant_atom(id: facts.encoding) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn python_float_spec_facts(facts: PythonFloatPrimitiveFacts) -> Map<Symbol, Node> {
