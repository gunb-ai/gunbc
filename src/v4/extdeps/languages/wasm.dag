fn wasm_wave2_grammar() -> ParseGrammar {
  ModeledGrammar { root: wasm_wave2_grammar_root() }
}


fn wasm_language_model_canonical_symbols_wave2() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      wasm_catalog_surface_symbol(sym: sym) ||
        lex_rule_set_token_class_member(rules: wasm_wave2_lex_rules(), token_class: sym) ||
        grammar_carries_symbol(grammar: wasm_wave2_grammar(), sym: sym) ||
        wasm_language_model_canonical_symbols().member(sym) ||
        sym == wasm_mvp1_source_literal ||
        sym == wasm_wave2_source_literal
    }
  }
}


fn wasm_wave2_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(empty_map(), wasm_binding_fn_add, "$add"),
    wasm_binding_export_name,
    "\"add\""
  )
}


fn wasm_language_model_wave2() -> WasmLanguageModel {
  WasmLanguageModel {
    lex: wasm_wave2_lex(),
    grammar: wasm_wave2_grammar(),
    language_identity: wasm_language_model_surface_id,
    canonical_symbols: wasm_language_model_canonical_symbols_wave2(),
    core: wasm_model_core_wave1()
  }
}

fn wasm_language_model_wave1() -> WasmLanguageModel {
  wasm_language_model_wave2b()
}
