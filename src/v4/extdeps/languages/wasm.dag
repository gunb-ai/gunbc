// src/v4/extdeps/languages/wasm.dag
// Scope: WebAssembly Core numeric value types — LanguageModel fact-bundles (Shape A).
// Owns: WasmScalar, WasmIntegerPrimitiveFacts, WasmFloatPrimitiveFacts, WasmLanguageModel, wasm_*_facts, wasm_*_inhabitant_node, wasm_declared_inhabitants_root, wasm_wave1_*.
// Consumes: v4.compiler.parse, v4.compiler.tokenize, v4.std.collection, v4.std.model_core, v4.std.node, v4.std.logic, v4.std.algebra.
// Status: T-4 wasm slice — Core §2.3.1 number types (i32/i64/f32/f64 wave-1); `core: ModelCore` (#3474); lex/grammar void wave-1 (WAT bidirectional substrate deferred T-6/T-7); v128/funcref/externref 🟡 wave-2; integer sign-agnostic per spec (width + modular wrap, not signed/unsigned partition).
// Anchor: https://webassembly.github.io/spec/core/types.html#number-types

module v4.extdeps.languages.wasm

import v4.compiler.parse { Grammar, ModeledGrammar, VoidGrammar }
import v4.compiler.tokenize { LexRules, ModeledLexRules, VoidLexRules }
import v4.std.collection { List, Map, Set, empty_map, map_insert }
import v4.std.model_core {
  EffectSemanticsDecl,
  ModelCore,
  PartialitySemanticsDecl,
  PrimitiveFactBundle,
  primitive_fact_axis_encoding,
  primitive_fact_axis_overflow_disposition,
  primitive_fact_axis_signedness,
  primitive_fact_axis_surface_spelling,
  primitive_fact_axis_unbound_diagnostic,
  primitive_fact_axis_width
}
import v4.std.witness { Holds, Violates }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.logic { Bool }
import v4.std.algebra { fold_list }

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type WasmIntWidth
  = WasmIntBits32
  | WasmIntBits64

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type WasmFloatWidth
  = WasmFloatBits32
  | WasmFloatBits64

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type WasmScalar
  = IntScalar { width: WasmIntWidth }
  | FloatScalar { width: WasmFloatWidth }

type WasmIntegerPrimitiveFacts {
  surface_spelling: Symbol
  width: WasmIntWidth
  std_projection: Symbol
}

type WasmFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: WasmFloatWidth
  ieee754_binary: Symbol
  std_projection: Symbol
}

type WasmLanguageModel {
  lex: LexRules
  grammar: Grammar
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

data wasm_language_model_surface_id: Symbol = wasm_language_model_surface_id

data wasm_std_projection_i32: Symbol = wasm_std_projection_i32
data wasm_std_projection_i64: Symbol = wasm_std_projection_i64
data wasm_std_projection_f32: Symbol = wasm_std_projection_f32
data wasm_std_projection_f64: Symbol = wasm_std_projection_f64

data wasm_surface_spelling_i32: Symbol = wasm_surface_spelling_i32
data wasm_surface_spelling_i64: Symbol = wasm_surface_spelling_i64
data wasm_surface_spelling_f32: Symbol = wasm_surface_spelling_f32
data wasm_surface_spelling_f64: Symbol = wasm_surface_spelling_f64

data wasm_ieee754_binary32: Symbol = wasm_ieee754_binary32
data wasm_ieee754_binary64: Symbol = wasm_ieee754_binary64
data wasm_repr_sign_agnostic_modular: Symbol = wasm_repr_sign_agnostic_modular
data wasm_repr_modular_wrap: Symbol = wasm_repr_modular_wrap

data wasm_inhabitant_i32: Symbol = wasm_inhabitant_i32
data wasm_inhabitant_i64: Symbol = wasm_inhabitant_i64
data wasm_inhabitant_f32: Symbol = wasm_inhabitant_f32
data wasm_inhabitant_f64: Symbol = wasm_inhabitant_f64

data wasm_inhabitant_field_i32: Symbol = wasm_inhabitant_field_i32
data wasm_inhabitant_field_i64: Symbol = wasm_inhabitant_field_i64
data wasm_inhabitant_field_f32: Symbol = wasm_inhabitant_field_f32
data wasm_inhabitant_field_f64: Symbol = wasm_inhabitant_field_f64

data wasm_facts_field_surface_spelling: Symbol = wasm_facts_field_surface_spelling
data wasm_facts_field_width: Symbol = wasm_facts_field_width
data wasm_facts_field_std_projection: Symbol = wasm_facts_field_std_projection
data wasm_facts_field_scalar_classifier: Symbol = wasm_facts_field_scalar_classifier
data wasm_facts_field_ieee754_binary: Symbol = wasm_facts_field_ieee754_binary

data wasm_scalar_field_classifier: Symbol = wasm_scalar_field_classifier
data wasm_scalar_field_width: Symbol = wasm_scalar_field_width

data wasm_tag_sign_agnostic_modular: Symbol = wasm_tag_sign_agnostic_modular
data wasm_tag_bits32: Symbol = wasm_tag_bits32
data wasm_tag_bits64: Symbol = wasm_tag_bits64
data wasm_tag_modular_wrap: Symbol = wasm_tag_modular_wrap
data wasm_tag_scalar_int: Symbol = wasm_tag_scalar_int
data wasm_tag_scalar_float: Symbol = wasm_tag_scalar_float

data wasm_inhabitant_field_atom: Symbol = wasm_inhabitant_field_atom
data wasm_inhabitant_field_facts: Symbol = wasm_inhabitant_field_facts

data wasm_facts_i32: WasmIntegerPrimitiveFacts = WasmIntegerPrimitiveFacts {
  surface_spelling: wasm_surface_spelling_i32,
  width: WasmIntBits32,
  std_projection: wasm_std_projection_i32,
}

data wasm_facts_i64: WasmIntegerPrimitiveFacts = WasmIntegerPrimitiveFacts {
  surface_spelling: wasm_surface_spelling_i64,
  width: WasmIntBits64,
  std_projection: wasm_std_projection_i64,
}

data wasm_facts_f32: WasmFloatPrimitiveFacts = WasmFloatPrimitiveFacts {
  surface_spelling: wasm_surface_spelling_f32,
  width: WasmFloatBits32,
  ieee754_binary: wasm_ieee754_binary32,
  std_projection: wasm_std_projection_f32,
}

data wasm_facts_f64: WasmFloatPrimitiveFacts = WasmFloatPrimitiveFacts {
  surface_spelling: wasm_surface_spelling_f64,
  width: WasmFloatBits64,
  ieee754_binary: wasm_ieee754_binary64,
  std_projection: wasm_std_projection_f64,
}

data wasm_integer_facts_catalog: List<WasmIntegerPrimitiveFacts> = [
  wasm_facts_i32,
  wasm_facts_i64,
]

data wasm_float_facts_catalog: List<WasmFloatPrimitiveFacts> = [
  wasm_facts_f32,
  wasm_facts_f64,
]

fn wasm_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn wasm_int_width_node(width: WasmIntWidth) -> Node {
  match width {
    WasmIntBits32 => wasm_inhabitant_atom(id: wasm_tag_bits32)
    WasmIntBits64 => wasm_inhabitant_atom(id: wasm_tag_bits64)
  }
}

fn wasm_float_width_node(width: WasmFloatWidth) -> Node {
  match width {
    WasmFloatBits32 => wasm_inhabitant_atom(id: wasm_tag_bits32)
    WasmFloatBits64 => wasm_inhabitant_atom(id: wasm_tag_bits64)
  }
}

fn wasm_scalar_node(scalar: WasmScalar) -> Node {
  match scalar {
    IntScalar { width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        wasm_named_edge(
          name: wasm_scalar_field_classifier,
          target: wasm_inhabitant_atom(id: wasm_tag_scalar_int)
        ),
        wasm_named_edge(name: wasm_scalar_field_width, target: wasm_int_width_node(width: width))
      ]
    }
    FloatScalar { width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        wasm_named_edge(
          name: wasm_scalar_field_classifier,
          target: wasm_inhabitant_atom(id: wasm_tag_scalar_float)
        ),
        wasm_named_edge(name: wasm_scalar_field_width, target: wasm_float_width_node(width: width))
      ]
    }
  }
}

fn wasm_integer_facts_node(facts: WasmIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(
        name: wasm_facts_field_surface_spelling,
        target: wasm_inhabitant_atom(id: facts.surface_spelling)
      ),
      wasm_named_edge(
        name: wasm_facts_field_width,
        target: wasm_int_width_node(width: facts.width)
      ),
      wasm_named_edge(
        name: wasm_facts_field_std_projection,
        target: wasm_inhabitant_atom(id: facts.std_projection)
      ),
      wasm_named_edge(
        name: wasm_facts_field_scalar_classifier,
        target: wasm_scalar_node(scalar: IntScalar { width: facts.width })
      )
    ]
  }
}

fn wasm_float_facts_node(facts: WasmFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(
        name: wasm_facts_field_surface_spelling,
        target: wasm_inhabitant_atom(id: facts.surface_spelling)
      ),
      wasm_named_edge(name: wasm_facts_field_width, target: wasm_float_width_node(width: facts.width)),
      wasm_named_edge(
        name: wasm_facts_field_ieee754_binary,
        target: wasm_inhabitant_atom(id: facts.ieee754_binary)
      ),
      wasm_named_edge(
        name: wasm_facts_field_std_projection,
        target: wasm_inhabitant_atom(id: facts.std_projection)
      ),
      wasm_named_edge(
        name: wasm_facts_field_scalar_classifier,
        target: wasm_scalar_node(scalar: FloatScalar { width: facts.width })
      )
    ]
  }
}

fn wasm_integer_inhabitant_node(id: Symbol, facts: WasmIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(name: wasm_inhabitant_field_atom, target: wasm_inhabitant_atom(id: id)),
      wasm_named_edge(
        name: wasm_inhabitant_field_facts,
        target: wasm_integer_facts_node(facts: facts)
      )
    ]
  }
}

fn wasm_float_inhabitant_node(id: Symbol, facts: WasmFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(name: wasm_inhabitant_field_atom, target: wasm_inhabitant_atom(id: id)),
      wasm_named_edge(
        name: wasm_inhabitant_field_facts,
        target: wasm_float_facts_node(facts: facts)
      )
    ]
  }
}

fn wasm_inhabitant_i32_node() -> Node {
  wasm_integer_inhabitant_node(id: wasm_inhabitant_i32, facts: wasm_facts_i32)
}

fn wasm_inhabitant_i64_node() -> Node {
  wasm_integer_inhabitant_node(id: wasm_inhabitant_i64, facts: wasm_facts_i64)
}

fn wasm_inhabitant_f32_node() -> Node {
  wasm_float_inhabitant_node(id: wasm_inhabitant_f32, facts: wasm_facts_f32)
}

fn wasm_inhabitant_f64_node() -> Node {
  wasm_float_inhabitant_node(id: wasm_inhabitant_f64, facts: wasm_facts_f64)
}

fn wasm_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn wasm_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(name: wasm_inhabitant_field_i32, target: wasm_inhabitant_i32_node()),
      wasm_named_edge(name: wasm_inhabitant_field_i64, target: wasm_inhabitant_i64_node()),
      wasm_named_edge(name: wasm_inhabitant_field_f32, target: wasm_inhabitant_f32_node()),
      wasm_named_edge(name: wasm_inhabitant_field_f64, target: wasm_inhabitant_f64_node()),
    ]
  }
}

fn wasm_wave1_void_lex() -> LexRules {
  VoidLexRules
}

fn wasm_wave1_void_grammar() -> Grammar {
  VoidGrammar
}

fn wasm_list_snoc_item<T>(xs: List<T>, item: T) -> List<T> {
  fold_list(
    xs: xs,
    empty: Cons { head: item, tail: Empty },
    cons: fn(rest, existing) {
      Cons { head: existing, tail: rest }
    }
  )
}

fn wasm_list_append<T>(left: List<T>, right: List<T>) -> List<T> {
  fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, item) {
      wasm_list_snoc_item(xs: acc, item: item)
    }
  )
}

fn wasm_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: WasmIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn wasm_float_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: WasmFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn wasm_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: wasm_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      wasm_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn wasm_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: wasm_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      wasm_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn wasm_catalog_surface_symbol(sym: Symbol) -> Bool {
  wasm_integer_catalog_surface_symbol(sym: sym) ||
    wasm_float_catalog_surface_symbol(sym: sym)
}

fn wasm_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      wasm_catalog_surface_symbol(sym: sym)
    }
  }
}

fn wasm_integer_spec_facts(facts: WasmIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: wasm_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_width =>
          Holds { value: wasm_int_width_node(width: facts.width) }
        primitive_fact_axis_signedness =>
          Holds { value: wasm_inhabitant_atom(id: wasm_tag_sign_agnostic_modular) }
        primitive_fact_axis_encoding =>
          Holds { value: wasm_inhabitant_atom(id: wasm_repr_sign_agnostic_modular) }
        primitive_fact_axis_overflow_disposition =>
          Holds { value: wasm_inhabitant_atom(id: wasm_tag_modular_wrap) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn wasm_float_spec_facts(facts: WasmFloatPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_surface_spelling =>
          Holds { value: wasm_inhabitant_atom(id: facts.surface_spelling) }
        primitive_fact_axis_width =>
          Holds { value: wasm_float_width_node(width: facts.width) }
        primitive_fact_axis_encoding =>
          Holds { value: wasm_inhabitant_atom(id: facts.ieee754_binary) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn wasm_primitive_bundle_from_integer_facts(facts: WasmIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: wasm_integer_facts_node(facts: facts),
    spec_facts: wasm_integer_spec_facts(facts: facts)
  }
}

fn wasm_primitive_bundle_from_float_facts(facts: WasmFloatPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: wasm_float_facts_node(facts: facts),
    spec_facts: wasm_float_spec_facts(facts: facts)
  }
}

fn wasm_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: wasm_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      wasm_list_snoc_item(
        xs: acc,
        item: wasm_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn wasm_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: wasm_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      wasm_list_snoc_item(
        xs: acc,
        item: wasm_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn wasm_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  wasm_list_append(
    left: wasm_primitive_bundles_from_integer_catalog(),
    right: wasm_primitive_bundles_from_float_catalog()
  )
}

fn wasm_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: wasm_wave1_primitive_fact_bundles(),
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn wasm_language_model_wave1() -> WasmLanguageModel {
  WasmLanguageModel {
    lex: wasm_wave1_void_lex(),
    grammar: wasm_wave1_void_grammar(),
    language_identity: wasm_language_model_surface_id,
    canonical_symbols: wasm_language_model_canonical_symbols(),
    core: wasm_model_core_wave1()
  }
}
