// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type WasmIntWidth
  = WasmIntBits32
  | WasmIntBits64

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type WasmFloatWidth
  = WasmFloatBits32
  | WasmFloatBits64

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type WasmScalar
  = IntScalar { width: WasmIntWidth }
  | FloatScalar { width: WasmFloatWidth }

// 🟢 grounded.
type WasmIntegerPrimitiveFacts {
  surface_spelling: Symbol
  width: WasmIntWidth
  std_projection: Symbol
}

// 🟢 grounded.
type WasmFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: WasmFloatWidth
  ieee754_binary: Symbol
  std_projection: Symbol
}

// 🟢 grounded.
type WasmLanguageModel {
  lex: LexRules
  grammar: ParseGrammar
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type WasmConcreteSyntaxToken
  = WasmFixedToken { token_class: Symbol }
  | WasmBoundToken { token_class: Symbol, binding: Symbol }

// 🟢 grounded.
type WasmGrammarRelationRow {
  production: FormalProduction
  emitted: Node
  tokens: List<WasmConcreteSyntaxToken>
}

