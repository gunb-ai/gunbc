fn wasm_wave1_lex() -> LexRules {
  ModeledLexRules { root: wasm_wave1_lex_rules() }
}

fn wasm_formal_rhs_from_tokens(tokens: List<WasmConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: wasm_concrete_token_class(token: token))
      )
    }
  )
}

fn wasm_formal_production_mvp1_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: wasm_production_mvp1_fn_add,
    rhs: wasm_formal_rhs_from_tokens(tokens: wasm_mvp1_concrete_tokens())
  )
}

