fn wasm_grammar_numeric_const_instr_expr() -> GrammarExpr {
  wasm_grammar_choice(
    left: wasm_grammar_sequence(
      left: wasm_grammar_terminal(token_class: wasm_token_i32_const),
      right: Nonterminal { production: wasm_production_i32_numeric_literal }
    ),
    right: wasm_grammar_choice(
      left: wasm_grammar_sequence(
        left: wasm_grammar_terminal(token_class: wasm_token_i64_const),
        right: Nonterminal { production: wasm_production_i64_numeric_literal }
      ),
      right: wasm_grammar_choice(
        left: wasm_grammar_sequence(
          left: wasm_grammar_terminal(token_class: wasm_token_f32_const),
          right: Nonterminal { production: wasm_production_f32_numeric_literal }
        ),
        right: wasm_grammar_sequence(
          left: wasm_grammar_terminal(token_class: wasm_token_f64_const),
          right: Nonterminal { production: wasm_production_f64_numeric_literal }
        )
      )
    )
  )
}

