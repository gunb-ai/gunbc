fn wasm_wat_string_escape_lex_pattern() -> LexPattern {
  wasm_lex_choice(
    left: wasm_lex_sequence(
      left: LiteralPattern { text: "\\" },
      right: LiteralPattern { text: "t" }
    ),
    right: wasm_lex_choice(
      left: wasm_lex_sequence(
        left: LiteralPattern { text: "\\" },
        right: LiteralPattern { text: "n" }
      ),
      right: wasm_lex_choice(
        left: wasm_lex_sequence(
          left: LiteralPattern { text: "\\" },
          right: LiteralPattern { text: "r" }
        ),
        right: wasm_lex_choice(
          left: wasm_lex_sequence(
            left: LiteralPattern { text: "\\" },
            right: LiteralPattern { text: "\"" }
          ),
          right: wasm_lex_choice(
            left: wasm_lex_sequence(
              left: LiteralPattern { text: "\\" },
              right: LiteralPattern { text: "'" }
            ),
            right: wasm_lex_choice(
              left: wasm_lex_sequence(
                left: LiteralPattern { text: "\\" },
                right: LiteralPattern { text: "\\" }
              ),
              right: wasm_lex_sequence(
                left: LiteralPattern { text: "\\" },
                right: wasm_lex_sequence(
                  left: CharClassPattern { class: HexDigitChar },
                  right: CharClassPattern { class: HexDigitChar }
                )
              )
            )
          )
        )
      )
    )
  )
}

fn wasm_wat_string_punctuation_plain_char_lex_pattern() -> LexPattern {
  wasm_lex_choice(
    left: LiteralPattern { text: "!" },
    right: wasm_lex_choice(
      left: LiteralPattern { text: "#" },
      right: wasm_lex_choice(
        left: LiteralPattern { text: "$" },
        right: wasm_lex_choice(
          left: LiteralPattern { text: "%" },
          right: wasm_lex_choice(
            left: LiteralPattern { text: "&" },
            right: wasm_lex_choice(
              left: LiteralPattern { text: "(" },
              right: wasm_lex_choice(
                left: LiteralPattern { text: ")" },
                right: wasm_lex_choice(
                  left: LiteralPattern { text: "*" },
                  right: wasm_lex_choice(
                    left: LiteralPattern { text: "+" },
                    right: wasm_lex_choice(
                      left: LiteralPattern { text: "," },
                      right: wasm_lex_choice(
                        left: LiteralPattern { text: "-" },
                        right: wasm_lex_choice(
                          left: LiteralPattern { text: "." },
                          right: wasm_lex_choice(
                            left: LiteralPattern { text: "/" },
                            right: wasm_lex_choice(
                              left: LiteralPattern { text: ":" },
                              right: wasm_lex_choice(
                                left: LiteralPattern { text: ";" },
                                right: wasm_lex_choice(
                                  left: LiteralPattern { text: "<" },
                                  right: wasm_lex_choice(
                                    left: LiteralPattern { text: "=" },
                                    right: wasm_lex_choice(
                                      left: LiteralPattern { text: ">" },
                                      right: wasm_lex_choice(
                                        left: LiteralPattern { text: "?" },
                                        right: wasm_lex_choice(
                                          left: LiteralPattern { text: "@" },
                                          right: wasm_lex_choice(
                                            left: LiteralPattern { text: "[" },
                                            right: wasm_lex_choice(
                                              left: LiteralPattern { text: "]" },
                                              right: wasm_lex_choice(
                                                left: LiteralPattern { text: "^" },
                                                right: wasm_lex_choice(
                                                  left: LiteralPattern { text: "`" },
                                                  right: wasm_lex_choice(
                                                    left: LiteralPattern { text: "{" },
                                                    right: wasm_lex_choice(
                                                      left: LiteralPattern { text: "|" },
                                                      right: wasm_lex_choice(
                                                        left: LiteralPattern { text: "}" },
                                                        right: LiteralPattern { text: "~" }
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn wasm_wat_string_plain_char_lex_pattern() -> LexPattern {
  wasm_lex_choice(
    left: LiteralPattern { text: " " },
    right: wasm_lex_choice(
      left: CharClassPattern { class: IdentStartChar },
      right: wasm_lex_choice(
        left: CharClassPattern { class: IdentContinueChar },
        right: wasm_wat_string_punctuation_plain_char_lex_pattern()
      )
    )
  )
}

fn wasm_wat_stringelem_lex_pattern() -> LexPattern {
  wasm_lex_choice(
    left: wasm_wat_string_escape_lex_pattern(),
    right: wasm_wat_string_plain_char_lex_pattern()
  )
}

fn wasm_wave2_string_lit_lex_rule() -> LexRule {
  TokenRule {
    token_class: wasm_token_string_lit,
    pattern: DelimitedPattern {
      open: LiteralPattern { text: "\"" },
      body: RepeatPattern { element: wasm_wat_stringelem_lex_pattern() },
      close: LiteralPattern { text: "\"" }
    }
  }
}

fn wasm_wave2_extra_lex_rules() -> List<LexRule> {
  [
    wasm_lex_rule(token_class: wasm_token_kw_export, text: "export"),
    wasm_lex_rule(token_class: wasm_token_kw_table, text: "table"),
    wasm_lex_rule(token_class: wasm_token_kw_memory, text: "memory"),
    wasm_lex_rule(token_class: wasm_token_kw_global, text: "global"),
    wasm_lex_rule(token_class: wasm_token_kw_tag, text: "tag"),
    wasm_lex_rule(token_class: wasm_token_kw_call, text: "call"),
    wasm_lex_rule(token_class: wasm_token_kw_block, text: "block"),
    wasm_lex_rule(token_class: wasm_token_kw_loop, text: "loop"),
    wasm_lex_rule(token_class: wasm_token_kw_if, text: "if"),
    wasm_lex_rule(token_class: wasm_token_kw_end, text: "end"),
    wasm_lex_rule(token_class: wasm_token_kw_br, text: "br"),
    wasm_lex_rule(token_class: wasm_token_kw_br_if, text: "br_if"),
    wasm_lex_rule(token_class: wasm_token_kw_return, text: "return"),
    wasm_lex_rule(token_class: wasm_token_kw_local_set, text: "local.set"),
    wasm_lex_rule(token_class: wasm_token_kw_local_tee, text: "local.tee"),
    wasm_lex_rule(token_class: wasm_token_i32_load, text: "i32.load"),
    wasm_lex_rule(token_class: wasm_token_i32_store, text: "i32.store"),
    wasm_lex_rule(token_class: wasm_token_i64_load, text: "i64.load"),
    wasm_lex_rule(token_class: wasm_token_i64_store, text: "i64.store"),
    wasm_lex_rule(token_class: wasm_token_f32_load, text: "f32.load"),
    wasm_lex_rule(token_class: wasm_token_f32_store, text: "f32.store"),
    wasm_lex_rule(token_class: wasm_token_f64_load, text: "f64.load"),
    wasm_lex_rule(token_class: wasm_token_f64_store, text: "f64.store"),
    wasm_lex_rule(token_class: wasm_token_kw_offset, text: "offset="),
    wasm_lex_rule(token_class: wasm_token_kw_align, text: "align="),
    wasm_wave2_string_lit_lex_rule()
  ]
}

fn wasm_wave2_lex_rules() -> LexRuleSet {
  let base = wasm_wave1_lex_rules()
  LexRuleSet {
    rules: list_append(left: base.rules, right: wasm_wave2_extra_lex_rules())
  }
}

fn wasm_wave2_lex() -> LexRules {
  ModeledLexRules { root: wasm_wave2_lex_rules() }
}


fn wasm_grammar_wave2_idx_ref_expr(kw: Symbol, idx: GrammarExpr) -> GrammarExpr {
  wasm_grammar_sequence(
    left: wasm_grammar_terminal(token_class: wasm_token_lparen),
    right: wasm_grammar_sequence(
      left: wasm_grammar_terminal(token_class: kw),
      right: wasm_grammar_sequence(
        left: idx,
        right: wasm_grammar_terminal(token_class: wasm_token_rparen)
      )
    )
  )
}

