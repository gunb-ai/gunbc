fn wasm_grammar_atom(id: Symbol) -> Node {
  wasm_inhabitant_atom(id: id)
}

fn wasm_grammar_mvp1_fn_add_expr() -> GrammarExpr {
  wasm_grammar_sequence(
    left: wasm_grammar_terminal(token_class: wasm_token_lparen),
    right: wasm_grammar_sequence(
      left: wasm_grammar_terminal(token_class: wasm_token_kw_func),
      right: wasm_grammar_sequence(
        left: wasm_grammar_terminal(token_class: wasm_token_ident),
        right: wasm_grammar_sequence(
          left: wasm_grammar_terminal(token_class: wasm_token_lparen),
          right: wasm_grammar_sequence(
            left: wasm_grammar_terminal(token_class: wasm_token_kw_param),
            right: wasm_grammar_sequence(
              left: wasm_grammar_terminal(token_class: wasm_token_type_i32),
              right: wasm_grammar_sequence(
                left: wasm_grammar_terminal(token_class: wasm_token_type_i32),
                right: wasm_grammar_sequence(
                  left: wasm_grammar_terminal(token_class: wasm_token_rparen),
                  right: wasm_grammar_sequence(
                    left: wasm_grammar_terminal(token_class: wasm_token_lparen),
                    right: wasm_grammar_sequence(
                      left: wasm_grammar_terminal(token_class: wasm_token_kw_result),
                      right: wasm_grammar_sequence(
                        left: wasm_grammar_terminal(token_class: wasm_token_type_i32),
                        right: wasm_grammar_sequence(
                          left: wasm_grammar_terminal(token_class: wasm_token_rparen),
                          right: wasm_grammar_sequence(
                            left: wasm_grammar_terminal(token_class: wasm_token_local_get),
                            right: wasm_grammar_sequence(
                              left: wasm_grammar_localidx_expr(),
                              right: wasm_grammar_sequence(
                                left: wasm_grammar_terminal(token_class: wasm_token_local_get),
                                right: wasm_grammar_sequence(
                                  left: wasm_grammar_localidx_expr(),
                                  right: wasm_grammar_sequence(
                                    left: wasm_grammar_terminal(token_class: wasm_token_i32_add),
                                    right: wasm_grammar_terminal(token_class: wasm_token_rparen)
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn wasm_grammar_production_mvp1_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: wasm_production_mvp1_fn_add,
    expression: wasm_grammar_mvp1_fn_add_expr(),
    emitted: wasm_grammar_atom(id: wasm_surface_fn_item)
  }
}

fn wasm_grammar_value_type_expr() -> GrammarExpr {
  wasm_grammar_choice(
    left: wasm_grammar_terminal(token_class: wasm_token_type_i32),
    right: wasm_grammar_choice(
      left: wasm_grammar_terminal(token_class: wasm_token_type_i64),
      right: wasm_grammar_choice(
        left: wasm_grammar_terminal(token_class: wasm_token_type_f32),
        right: wasm_grammar_terminal(token_class: wasm_token_type_f64)
      )
    )
  )
}

fn wasm_grammar_idx_expr() -> GrammarExpr {
  wasm_grammar_choice(
    left: Nonterminal { production: wasm_production_idx_numeric },
    right: Nonterminal { production: wasm_production_idx_named }
  )
}

fn wasm_grammar_localidx_expr() -> GrammarExpr {
  wasm_grammar_choice(
    left: Nonterminal { production: wasm_production_localidx_numeric },
