fn wasm_grammar_mvp1_module_expr() -> GrammarExpr {
  wasm_grammar_sequence(
    left: wasm_grammar_terminal(token_class: wasm_token_lparen),
    right: wasm_grammar_sequence(
      left: wasm_grammar_terminal(token_class: wasm_token_kw_module),
      right: wasm_grammar_sequence(
        left: wasm_grammar_optional(
          element: wasm_grammar_terminal(token_class: wasm_token_ident)
        ),
        right: wasm_grammar_sequence(
          left: wasm_grammar_repeat(
            element: Nonterminal { production: wasm_production_mvp1_fn_add }
          ),
          right: wasm_grammar_terminal(token_class: wasm_token_rparen)
        )
      )
    )
  )
}

fn wasm_grammar_text_fragment_expr() -> GrammarExpr {
  wasm_grammar_choice(
    left: Nonterminal { production: wasm_production_mvp1_fn_add },
    right: wasm_grammar_choice(
      left: Nonterminal { production: wasm_production_mvp1_module },
      right: wasm_grammar_choice(
        left: Nonterminal { production: wasm_production_value_type },
        right: wasm_grammar_choice(
          left: wasm_grammar_localidx_expr(),
          right: wasm_grammar_choice(
            left: Nonterminal { production: wasm_production_numeric_const_instr },
            right: Nonterminal { production: wasm_production_numeric_binop_instr }
          )
        )
      )
    )
  )
}

