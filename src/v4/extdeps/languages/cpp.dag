module v4.extdeps.languages.cpp

import v4.std.logic { Bool }
import v4.std.algebra { BooleanAlgebra, BoundedLattice, Lattice }


// 🟢 coproduct dissolution — DECISIONS.md T29-ABI + D2-REV.
type CppIntegerOverflowDisposition
  = RepresentableResultRequired
  | UnsignedModuloArithmetic


// Anchor: https://eel.is/c++draft/basic.fundamental
// 🟡 canonical-B decl-ref · E-6(b) bounded-exception · scaffold feature:canonical-b-grounding-consumer · dissolve-on: B1-CANON+zip-fold consume (ledger: DECISIONS.md B1·T-9/C1 · grounding-worked-examples.md §0)
// M1(2.8): structural duplicate of `v4.std.logic::bool_boolean_algebra` (user-range `data` cannot
// RHS-reference std `data` by identifier — stays `ValueBody::Unparsed` until class-5 gap #3 lifts).
data cpp_bool_grounding: BooleanAlgebra<Bool> = BooleanAlgebra {
  bounded_lattice: BoundedLattice {
    lattice: Lattice {
      meet: fn(a, b) {
        match a {
          True => b
          False => False
        }
      },
      join: fn(a, b) {
        match a {
          True => True
          False => b
        }
      }
    },
    top: True,
    bottom: False
  },
  complement: fn(a) {
    match a {
      True => False
      False => True
    }
  }
}
