// Status: D2-REV/T29 forward reconcile; C++ integer facts are ABI-width-parametric, bool canonical-B decl-ref grounding stays 🟡 E-6(b) staging.

module v4.extdeps.languages.cpp

import v4.std.logic { Bool, bool_boolean_algebra }
import v4.std.algebra { BooleanAlgebra }
import v4.extdeps.cpp_abi {
  CppIntegerWidth,
  CppPlainCharSignedness,
  CppTargetProfile
}


// 🟢 coproduct dissolution — DECISIONS.md T29-CPP-SCALAR-FORWARD.
type CppSignedIntegerSurfaceSpelling
  = SignedChar
  | ShortInt
  | Int
  | LongInt
  | LongLongInt

// 🟢 coproduct dissolution — DECISIONS.md T29-CPP-SCALAR-FORWARD.
type CppUnsignedIntegerSurfaceSpelling
  = UnsignedChar
  | UnsignedShortInt
  | UnsignedInt
  | UnsignedLongInt
  | UnsignedLongLongInt

type CppPlainCharSurfaceSpelling

// 🟢 coproduct dissolution — DECISIONS.md T29-CPP-SCALAR-FORWARD.
type CppCodeUnitIntegerSurfaceSpelling
  = WCharT
  | Char8T
  | Char16T
  | Char32T

type CppTwosComplement

type CppSignedIntegerWidthSelection {
  spelling: CppSignedIntegerSurfaceSpelling
  target_profile: CppTargetProfile
  width: CppIntegerWidth
}

type CppUnsignedIntegerWidthSelection {
  spelling: CppUnsignedIntegerSurfaceSpelling
  target_profile: CppTargetProfile
  width: CppIntegerWidth
}

type CppPlainCharWidthSelection {
  spelling: CppPlainCharSurfaceSpelling
  target_profile: CppTargetProfile
  width: CppIntegerWidth
  plain_char_signedness: CppPlainCharSignedness
}

type CppCodeUnitIntegerWidthSelection {
  spelling: CppCodeUnitIntegerSurfaceSpelling
  target_profile: CppTargetProfile
  width: CppIntegerWidth
}

// 🟢 coproduct dissolution — DECISIONS.md T29-ABI + D2-REV.
type CppIntegerOverflowDisposition
  = RepresentableResultRequired
  | UnsignedModuloArithmetic

// 🟢 coproduct dissolution — DECISIONS.md T29-CPP-SCALAR-FORWARD.
type CppScalar
  = SignedIntegerScalar {
      width_selection: CppSignedIntegerWidthSelection,
      signed_representation: CppTwosComplement,
      overflow_disposition: CppIntegerOverflowDisposition
    }
  | UnsignedIntegerScalar {
      width_selection: CppUnsignedIntegerWidthSelection,
      overflow_disposition: CppIntegerOverflowDisposition
    }
  | PlainCharScalar {
      width_selection: CppPlainCharWidthSelection
    }
  | CodeUnitIntegerScalar {
      width_selection: CppCodeUnitIntegerWidthSelection
    }
  | BoolScalar

// Anchor: https://eel.is/c++draft/basic.fundamental
// 🟡 canonical-B decl-ref · E-6(b) bounded-exception · scaffold feature:canonical-b-grounding-consumer · dissolve-on: B1-CANON+zip-fold consume (ledger: DECISIONS.md B1·T-9/C1 · grounding-worked-examples.md §0)
data cpp_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra
