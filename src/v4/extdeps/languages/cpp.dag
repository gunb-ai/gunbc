// src/v4/extdeps/languages/cpp.dag
// Scope: C++ language primitive fact bundles.
// Owns: CppSignedIntegerSurfaceSpelling, CppUnsignedIntegerSurfaceSpelling, CppPlainCharSurfaceSpelling, CppCodeUnitIntegerSurfaceSpelling, CppSignedIntegerWidthSelection, CppUnsignedIntegerWidthSelection, CppPlainCharWidthSelection, CppCodeUnitIntegerWidthSelection, CppTwosComplement, CppIntegerOverflowDisposition, CppScalar, cpp_bool_grounding.
