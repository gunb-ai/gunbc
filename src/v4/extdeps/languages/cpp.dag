// src/v4/extdeps/languages/cpp.dag
// Scope: C++ language primitive fact bundles.
// Owns: Cpp*SurfaceSpelling, Cpp*PrimitiveFacts, CppScalar, CppLanguageModel, cpp_*_facts_catalog, cpp_model_core_wave1, cpp_bool_grounding.
// Consumes: v4.std.logic.Bool, bool_boolean_algebra; v4.std.algebra.BooleanAlgebra/free_monoid_fold; v4.std.model_core; v4.extdeps.cpp_abi.CppTargetProfile.
// Status: T-4 C++ slice — fact-bundle completion + ModelCore wave-1 in the rust.dag pattern; C++ integer widths stay ABI-width-parametric through CppTargetProfile width-selection witnesses; bool canonical-B decl-ref grounding stays 🟡 E-6(b) staging; scaffold:T-4-cpp-slice / 🟡 feature:t4-cpp-scalar-ladder bounds generated per-spelling concrete CppTargetProfile selection rows (INVARIANTS P5).
// Anchor: ISO/IEC 14882:2020 (C++20) [basic.fundamental], [expr.pre]; upstream mirror https://eel.is/c++draft/basic.fundamental.

module v4.extdeps.languages.cpp

import v4.std.logic { Bool, bool_boolean_algebra }
import v4.std.algebra { BooleanAlgebra, free_monoid_fold }
import v4.std.collection { List, Set }
import v4.std.model_core {
  EffectSemanticsDecl,
  ModelCore,
  PartialitySemanticsDecl,
  PrimitiveFactAxisBinding,
  PrimitiveFactBundle,
  primitive_fact_axis_encoding,
  primitive_fact_axis_overflow_disposition,
  primitive_fact_axis_signedness,
  primitive_fact_axis_surface_spelling,
  primitive_fact_axis_width
}
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.extdeps.cpp_abi { CppTargetProfile }

// 🟢 pretty-much-done — closed signed integer spelling family; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution · T29-CPP-SCALAR-FORWARD.
type CppSignedIntegerSurfaceSpelling
  = SignedChar
  | ShortInt
  | Int
  | LongInt
  | LongLongInt

// 🟢 pretty-much-done — closed unsigned integer spelling family; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution · T29-CPP-SCALAR-FORWARD.
type CppUnsignedIntegerSurfaceSpelling
  = UnsignedChar
  | UnsignedShortInt
  | UnsignedInt
  | UnsignedLongInt
  | UnsignedLongLongInt

// 🟢 pretty-much-done — singleton plain-char spelling; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppPlainCharSurfaceSpelling
  = CppPlainCharSpelling

// 🟢 pretty-much-done — singleton wchar_t spelling; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppWcharTSurfaceSpelling
  = CppWcharTSpelling

// 🟢 pretty-much-done — closed fixed unsigned code-unit spelling family; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution · T29-CPP-SCALAR-FORWARD.
type CppFixedUnsignedCodeUnitIntegerSurfaceSpelling
  = Char8T
  | Char16T
  | Char32T

// 🟢 pretty-much-done — C++20 signed integer representation fact; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppTwosComplement
  = CppTwosComplementWitness

// 🟡 needs-more-work — generated per-spelling target-profile selection rows still produce these witnesses; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟡 feature:t4-cpp-scalar-ladder — scaffold:T-4-cpp-slice; dissolve-on: generated per-spelling target-profile selection rows consume CppTargetProfile and select these widths.
type CppSignedIntegerWidthSelection {
  spelling: CppSignedIntegerSurfaceSpelling
  target_profile: CppTargetProfile
}

type CppUnsignedIntegerWidthSelection {
  spelling: CppUnsignedIntegerSurfaceSpelling
  target_profile: CppTargetProfile
}

type CppPlainCharWidthSelection {
  spelling: CppPlainCharSurfaceSpelling
  target_profile: CppTargetProfile
}

type CppWcharTWidthSelection {
  spelling: CppWcharTSurfaceSpelling
  target_profile: CppTargetProfile
}

type CppFixedUnsignedCodeUnitIntegerWidthSelection {
  spelling: CppFixedUnsignedCodeUnitIntegerSurfaceSpelling
  target_profile: CppTargetProfile
}

// Anchor: ISO/IEC 14882:2020 (C++20) [expr.pre]; upstream mirror https://eel.is/c++draft/expr.pre.
// 🟢 pretty-much-done — arm-specific overflow witnesses; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppRepresentableResultRequired
  = CppRepresentableResultRequiredWitness
type CppUnsignedModuloArithmetic
  = CppUnsignedModuloArithmeticWitness

// 🟢 pretty-much-done — scalar fact-bundle arms prevent spelling/signedness/overflow cross-pairings; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution · T29-CPP-SCALAR-FORWARD.
type CppScalar
  = SignedIntegerScalar {
      width_selection: CppSignedIntegerWidthSelection,
      signed_representation: CppTwosComplement,
      overflow_disposition: CppRepresentableResultRequired
    }
  | UnsignedIntegerScalar {
      width_selection: CppUnsignedIntegerWidthSelection,
      overflow_disposition: CppUnsignedModuloArithmetic
    }
  | PlainCharScalar {
      width_selection: CppPlainCharWidthSelection
    }
  | WcharTScalar {
      width_selection: CppWcharTWidthSelection
    }
  | FixedUnsignedCodeUnitIntegerScalar {
      width_selection: CppFixedUnsignedCodeUnitIntegerWidthSelection,
      unsigned_modulo_arithmetic: CppUnsignedModuloArithmetic
    }
  | BoolScalar

type CppIntegerPrimitiveFacts {
  surface_spelling: Symbol
  scalar: CppScalar
}

type CppCharacterPrimitiveFacts {
  surface_spelling: Symbol
  scalar: CppScalar
}

type CppBoolPrimitiveFacts {
  surface_spelling: Symbol
  scalar: CppScalar
}

type CppLanguageModel {
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

data cpp_language_model_surface_id: Symbol = cpp_language_model_surface_id

data cpp_surface_spelling_signed_char: Symbol = cpp_surface_spelling_signed_char
data cpp_surface_spelling_short_int: Symbol = cpp_surface_spelling_short_int
data cpp_surface_spelling_int: Symbol = cpp_surface_spelling_int
data cpp_surface_spelling_long_int: Symbol = cpp_surface_spelling_long_int
data cpp_surface_spelling_long_long_int: Symbol = cpp_surface_spelling_long_long_int
data cpp_surface_spelling_unsigned_char: Symbol = cpp_surface_spelling_unsigned_char
data cpp_surface_spelling_unsigned_short_int: Symbol = cpp_surface_spelling_unsigned_short_int
data cpp_surface_spelling_unsigned_int: Symbol = cpp_surface_spelling_unsigned_int
data cpp_surface_spelling_unsigned_long_int: Symbol = cpp_surface_spelling_unsigned_long_int
data cpp_surface_spelling_unsigned_long_long_int: Symbol = cpp_surface_spelling_unsigned_long_long_int
data cpp_surface_spelling_char: Symbol = cpp_surface_spelling_char
data cpp_surface_spelling_wchar_t: Symbol = cpp_surface_spelling_wchar_t
data cpp_surface_spelling_char8_t: Symbol = cpp_surface_spelling_char8_t
data cpp_surface_spelling_char16_t: Symbol = cpp_surface_spelling_char16_t
data cpp_surface_spelling_char32_t: Symbol = cpp_surface_spelling_char32_t
data cpp_surface_spelling_bool: Symbol = cpp_surface_spelling_bool

data cpp_tag_signed_integer: Symbol = cpp_tag_signed_integer
data cpp_tag_unsigned_integer: Symbol = cpp_tag_unsigned_integer
data cpp_tag_plain_char: Symbol = cpp_tag_plain_char
data cpp_tag_wchar_t: Symbol = cpp_tag_wchar_t
data cpp_tag_fixed_unsigned_code_unit_integer: Symbol = cpp_tag_fixed_unsigned_code_unit_integer
data cpp_tag_bool: Symbol = cpp_tag_bool
data cpp_tag_twos_complement: Symbol = cpp_tag_twos_complement
data cpp_tag_representable_result_required: Symbol = cpp_tag_representable_result_required
data cpp_tag_unsigned_modulo_arithmetic: Symbol = cpp_tag_unsigned_modulo_arithmetic
data cpp_tag_width_selection: Symbol = cpp_tag_width_selection
data cpp_tag_target_profile_parametric: Symbol = cpp_tag_target_profile_parametric

data cpp_field_surface_spelling: Symbol = cpp_field_surface_spelling
data cpp_field_scalar: Symbol = cpp_field_scalar
data cpp_field_width_selection: Symbol = cpp_field_width_selection
data cpp_field_signed_representation: Symbol = cpp_field_signed_representation
data cpp_field_overflow_disposition: Symbol = cpp_field_overflow_disposition
data cpp_field_unsigned_modulo_arithmetic: Symbol = cpp_field_unsigned_modulo_arithmetic
data cpp_field_spelling: Symbol = cpp_field_spelling
data cpp_field_target_profile: Symbol = cpp_field_target_profile

fn cpp_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn cpp_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn cpp_signed_integer_spelling_node(spelling: CppSignedIntegerSurfaceSpelling) -> Node {
  match spelling {
    SignedChar => cpp_atom(id: cpp_surface_spelling_signed_char)
    ShortInt => cpp_atom(id: cpp_surface_spelling_short_int)
    Int => cpp_atom(id: cpp_surface_spelling_int)
    LongInt => cpp_atom(id: cpp_surface_spelling_long_int)
    LongLongInt => cpp_atom(id: cpp_surface_spelling_long_long_int)
  }
}

fn cpp_unsigned_integer_spelling_node(spelling: CppUnsignedIntegerSurfaceSpelling) -> Node {
  match spelling {
    UnsignedChar => cpp_atom(id: cpp_surface_spelling_unsigned_char)
    UnsignedShortInt => cpp_atom(id: cpp_surface_spelling_unsigned_short_int)
    UnsignedInt => cpp_atom(id: cpp_surface_spelling_unsigned_int)
    UnsignedLongInt => cpp_atom(id: cpp_surface_spelling_unsigned_long_int)
    UnsignedLongLongInt => cpp_atom(id: cpp_surface_spelling_unsigned_long_long_int)
  }
}

fn cpp_fixed_code_unit_spelling_node(
  spelling: CppFixedUnsignedCodeUnitIntegerSurfaceSpelling
) -> Node {
  match spelling {
    Char8T => cpp_atom(id: cpp_surface_spelling_char8_t)
    Char16T => cpp_atom(id: cpp_surface_spelling_char16_t)
    Char32T => cpp_atom(id: cpp_surface_spelling_char32_t)
  }
}

fn cpp_width_selection_node(spelling: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: cpp_field_width_selection, target: cpp_atom(id: cpp_tag_width_selection)),
      cpp_named_edge(name: cpp_field_spelling, target: spelling),
      cpp_named_edge(
        name: cpp_field_target_profile,
        target: cpp_atom(id: cpp_tag_target_profile_parametric)
      )
    ]
  }
}

fn cpp_overflow_node(overflow: CppRepresentableResultRequired) -> Node {
  cpp_atom(id: cpp_tag_representable_result_required)
}

fn cpp_unsigned_modulo_node(overflow: CppUnsignedModuloArithmetic) -> Node {
  cpp_atom(id: cpp_tag_unsigned_modulo_arithmetic)
}

fn cpp_twos_complement_node(representation: CppTwosComplement) -> Node {
  cpp_atom(id: cpp_tag_twos_complement)
}

fn cpp_scalar_node(scalar: CppScalar) -> Node {
  match scalar {
    SignedIntegerScalar { width_selection, signed_representation, overflow_disposition } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          cpp_named_edge(name: cpp_field_scalar, target: cpp_atom(id: cpp_tag_signed_integer)),
          cpp_named_edge(
            name: cpp_field_width_selection,
            target: cpp_width_selection_node(
              spelling: cpp_signed_integer_spelling_node(spelling: width_selection.spelling)
            )
          ),
          cpp_named_edge(
            name: cpp_field_signed_representation,
            target: cpp_twos_complement_node(representation: signed_representation)
          ),
          cpp_named_edge(
            name: cpp_field_overflow_disposition,
            target: cpp_overflow_node(overflow: overflow_disposition)
          )
        ]
      }
    UnsignedIntegerScalar { width_selection, overflow_disposition } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          cpp_named_edge(name: cpp_field_scalar, target: cpp_atom(id: cpp_tag_unsigned_integer)),
          cpp_named_edge(
            name: cpp_field_width_selection,
            target: cpp_width_selection_node(
              spelling: cpp_unsigned_integer_spelling_node(spelling: width_selection.spelling)
            )
          ),
          cpp_named_edge(
            name: cpp_field_overflow_disposition,
            target: cpp_unsigned_modulo_node(overflow: overflow_disposition)
          )
        ]
      }
    PlainCharScalar { width_selection } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          cpp_named_edge(name: cpp_field_scalar, target: cpp_atom(id: cpp_tag_plain_char)),
          cpp_named_edge(
            name: cpp_field_width_selection,
            target: cpp_width_selection_node(spelling: cpp_atom(id: cpp_surface_spelling_char))
          )
        ]
      }
    WcharTScalar { width_selection } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          cpp_named_edge(name: cpp_field_scalar, target: cpp_atom(id: cpp_tag_wchar_t)),
          cpp_named_edge(
            name: cpp_field_width_selection,
            target: cpp_width_selection_node(spelling: cpp_atom(id: cpp_surface_spelling_wchar_t))
          )
        ]
      }
    FixedUnsignedCodeUnitIntegerScalar { width_selection, unsigned_modulo_arithmetic } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          cpp_named_edge(
            name: cpp_field_scalar,
            target: cpp_atom(id: cpp_tag_fixed_unsigned_code_unit_integer)
          ),
          cpp_named_edge(
            name: cpp_field_width_selection,
            target: cpp_width_selection_node(
              spelling: cpp_fixed_code_unit_spelling_node(spelling: width_selection.spelling)
            )
          ),
          cpp_named_edge(
            name: cpp_field_unsigned_modulo_arithmetic,
            target: cpp_unsigned_modulo_node(overflow: unsigned_modulo_arithmetic)
          )
        ]
      }
    BoolScalar => cpp_atom(id: cpp_tag_bool)
  }
}

fn cpp_integer_facts_node(facts: CppIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: cpp_field_surface_spelling, target: cpp_atom(id: facts.surface_spelling)),
      cpp_named_edge(name: cpp_field_scalar, target: cpp_scalar_node(scalar: facts.scalar))
    ]
  }
}

fn cpp_character_facts_node(facts: CppCharacterPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: cpp_field_surface_spelling, target: cpp_atom(id: facts.surface_spelling)),
      cpp_named_edge(name: cpp_field_scalar, target: cpp_scalar_node(scalar: facts.scalar))
    ]
  }
}

fn cpp_bool_facts_node(facts: CppBoolPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      cpp_named_edge(name: cpp_field_surface_spelling, target: cpp_atom(id: facts.surface_spelling)),
      cpp_named_edge(name: cpp_field_scalar, target: cpp_scalar_node(scalar: facts.scalar))
    ]
  }
}

fn cpp_signed_integer_facts(
  spelling: CppSignedIntegerSurfaceSpelling,
  surface_spelling: Symbol,
  target_profile: CppTargetProfile
) -> CppIntegerPrimitiveFacts {
  CppIntegerPrimitiveFacts {
    surface_spelling: surface_spelling,
    scalar: SignedIntegerScalar {
      width_selection: CppSignedIntegerWidthSelection {
        spelling: spelling,
        target_profile: target_profile
      },
      signed_representation: CppTwosComplementWitness,
      overflow_disposition: CppRepresentableResultRequiredWitness
    }
  }
}

fn cpp_unsigned_integer_facts(
  spelling: CppUnsignedIntegerSurfaceSpelling,
  surface_spelling: Symbol,
  target_profile: CppTargetProfile
) -> CppIntegerPrimitiveFacts {
  CppIntegerPrimitiveFacts {
    surface_spelling: surface_spelling,
    scalar: UnsignedIntegerScalar {
      width_selection: CppUnsignedIntegerWidthSelection {
        spelling: spelling,
        target_profile: target_profile
      },
      overflow_disposition: CppUnsignedModuloArithmeticWitness
    }
  }
}

fn cpp_integer_facts_catalog(target_profile: CppTargetProfile) -> List<CppIntegerPrimitiveFacts> {
  [
    cpp_signed_integer_facts(
      spelling: SignedChar,
      surface_spelling: cpp_surface_spelling_signed_char,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: ShortInt,
      surface_spelling: cpp_surface_spelling_short_int,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: Int,
      surface_spelling: cpp_surface_spelling_int,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: LongInt,
      surface_spelling: cpp_surface_spelling_long_int,
      target_profile: target_profile
    ),
    cpp_signed_integer_facts(
      spelling: LongLongInt,
      surface_spelling: cpp_surface_spelling_long_long_int,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedChar,
      surface_spelling: cpp_surface_spelling_unsigned_char,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedShortInt,
      surface_spelling: cpp_surface_spelling_unsigned_short_int,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedInt,
      surface_spelling: cpp_surface_spelling_unsigned_int,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedLongInt,
      surface_spelling: cpp_surface_spelling_unsigned_long_int,
      target_profile: target_profile
    ),
    cpp_unsigned_integer_facts(
      spelling: UnsignedLongLongInt,
      surface_spelling: cpp_surface_spelling_unsigned_long_long_int,
      target_profile: target_profile
    )
  ]
}

fn cpp_character_facts_catalog(target_profile: CppTargetProfile) -> List<CppCharacterPrimitiveFacts> {
  [
    CppCharacterPrimitiveFacts {
      surface_spelling: cpp_surface_spelling_char,
      scalar: PlainCharScalar {
        width_selection: CppPlainCharWidthSelection {
          spelling: CppPlainCharSpelling,
          target_profile: target_profile
        }
      }
    },
    CppCharacterPrimitiveFacts {
      surface_spelling: cpp_surface_spelling_wchar_t,
      scalar: WcharTScalar {
        width_selection: CppWcharTWidthSelection {
          spelling: CppWcharTSpelling,
          target_profile: target_profile
        }
      }
    },
    CppCharacterPrimitiveFacts {
      surface_spelling: cpp_surface_spelling_char8_t,
      scalar: FixedUnsignedCodeUnitIntegerScalar {
        width_selection: CppFixedUnsignedCodeUnitIntegerWidthSelection {
          spelling: Char8T,
          target_profile: target_profile
        },
        unsigned_modulo_arithmetic: CppUnsignedModuloArithmeticWitness
      }
    },
    CppCharacterPrimitiveFacts {
      surface_spelling: cpp_surface_spelling_char16_t,
      scalar: FixedUnsignedCodeUnitIntegerScalar {
        width_selection: CppFixedUnsignedCodeUnitIntegerWidthSelection {
          spelling: Char16T,
          target_profile: target_profile
        },
        unsigned_modulo_arithmetic: CppUnsignedModuloArithmeticWitness
      }
    },
    CppCharacterPrimitiveFacts {
      surface_spelling: cpp_surface_spelling_char32_t,
      scalar: FixedUnsignedCodeUnitIntegerScalar {
        width_selection: CppFixedUnsignedCodeUnitIntegerWidthSelection {
          spelling: Char32T,
          target_profile: target_profile
        },
        unsigned_modulo_arithmetic: CppUnsignedModuloArithmeticWitness
      }
    }
  ]
}

fn cpp_bool_facts_catalog() -> List<CppBoolPrimitiveFacts> {
  [
    CppBoolPrimitiveFacts {
      surface_spelling: cpp_surface_spelling_bool,
      scalar: BoolScalar
    }
  ]
}

fn cpp_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: CppIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn cpp_character_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: CppCharacterPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn cpp_bool_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: CppBoolPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn cpp_integer_catalog_surface_symbol(sym: Symbol, target_profile: CppTargetProfile) -> Bool {
  free_monoid_fold(
    xs: cpp_integer_facts_catalog(target_profile: target_profile),
    empty: false,
    cons: fn(acc, facts) {
      cpp_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn cpp_character_catalog_surface_symbol(sym: Symbol, target_profile: CppTargetProfile) -> Bool {
  free_monoid_fold(
    xs: cpp_character_facts_catalog(target_profile: target_profile),
    empty: false,
    cons: fn(acc, facts) {
      cpp_character_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn cpp_bool_catalog_surface_symbol(sym: Symbol) -> Bool {
  free_monoid_fold(
    xs: cpp_bool_facts_catalog(),
    empty: false,
    cons: fn(acc, facts) {
      cpp_bool_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn cpp_catalog_surface_symbol(sym: Symbol, target_profile: CppTargetProfile) -> Bool {
  cpp_integer_catalog_surface_symbol(sym: sym, target_profile: target_profile) ||
    cpp_character_catalog_surface_symbol(sym: sym, target_profile: target_profile) ||
    cpp_bool_catalog_surface_symbol(sym: sym)
}

fn cpp_language_model_canonical_symbols(target_profile: CppTargetProfile) -> Set<Symbol> {
  Set {
    member: fn(sym) {
      cpp_catalog_surface_symbol(sym: sym, target_profile: target_profile)
    }
  }
}

fn cpp_list_snoc_item<T>(xs: List<T>, item: T) -> List<T> {
  free_monoid_fold(
    xs: xs,
    empty: Cons { head: item, tail: Empty },
    cons: fn(rest, existing) {
      Cons { head: existing, tail: rest }
    }
  )
}

fn cpp_list_append<T>(left: List<T>, right: List<T>) -> List<T> {
  free_monoid_fold(
    xs: right,
    empty: left,
    cons: fn(acc, item) {
      cpp_list_snoc_item(xs: acc, item: item)
    }
  )
}

fn cpp_primitive_axis_binding(axis: Symbol, fact: Node) -> PrimitiveFactAxisBinding {
  PrimitiveFactAxisBinding { axis: axis, fact: fact }
}

fn cpp_primitive_bundle_from_integer_facts(facts: CppIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: cpp_integer_facts_node(facts: facts),
    spec_facts: [
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_surface_spelling,
        fact: cpp_atom(id: facts.surface_spelling)
      ),
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_width,
        fact: cpp_scalar_node(scalar: facts.scalar)
      ),
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_signedness,
        fact: cpp_scalar_node(scalar: facts.scalar)
      ),
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: cpp_scalar_node(scalar: facts.scalar)
      ),
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_overflow_disposition,
        fact: cpp_scalar_node(scalar: facts.scalar)
      )
    ]
  }
}

fn cpp_primitive_bundle_from_character_facts(
  facts: CppCharacterPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: cpp_character_facts_node(facts: facts),
    spec_facts: [
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_surface_spelling,
        fact: cpp_atom(id: facts.surface_spelling)
      ),
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_width,
        fact: cpp_scalar_node(scalar: facts.scalar)
      ),
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: cpp_scalar_node(scalar: facts.scalar)
      )
    ]
  }
}

fn cpp_primitive_bundle_from_bool_facts(facts: CppBoolPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: cpp_bool_facts_node(facts: facts),
    spec_facts: [
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_surface_spelling,
        fact: cpp_atom(id: facts.surface_spelling)
      ),
      cpp_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: cpp_scalar_node(scalar: facts.scalar)
      )
    ]
  }
}

fn cpp_primitive_bundles_from_integer_catalog(
  target_profile: CppTargetProfile
) -> List<PrimitiveFactBundle> {
  free_monoid_fold(
    xs: cpp_integer_facts_catalog(target_profile: target_profile),
    empty: Empty,
    cons: fn(acc, facts) {
      cpp_list_snoc_item(
        xs: acc,
        item: cpp_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn cpp_primitive_bundles_from_character_catalog(
  target_profile: CppTargetProfile
) -> List<PrimitiveFactBundle> {
  free_monoid_fold(
    xs: cpp_character_facts_catalog(target_profile: target_profile),
    empty: Empty,
    cons: fn(acc, facts) {
      cpp_list_snoc_item(
        xs: acc,
        item: cpp_primitive_bundle_from_character_facts(facts: facts)
      )
    }
  )
}

fn cpp_primitive_bundles_from_bool_catalog() -> List<PrimitiveFactBundle> {
  free_monoid_fold(
    xs: cpp_bool_facts_catalog(),
    empty: Empty,
    cons: fn(acc, facts) {
      cpp_list_snoc_item(
        xs: acc,
        item: cpp_primitive_bundle_from_bool_facts(facts: facts)
      )
    }
  )
}

fn cpp_wave1_primitive_fact_bundles(
  target_profile: CppTargetProfile
) -> List<PrimitiveFactBundle> {
  cpp_list_append(
    left: cpp_list_append(
      left: cpp_primitive_bundles_from_integer_catalog(target_profile: target_profile),
      right: cpp_primitive_bundles_from_character_catalog(target_profile: target_profile)
    ),
    right: cpp_primitive_bundles_from_bool_catalog()
  )
}

fn cpp_model_core_wave1(target_profile: CppTargetProfile) -> ModelCore {
  ModelCore {
    primitives: cpp_wave1_primitive_fact_bundles(target_profile: target_profile),
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn cpp_language_model_wave1(target_profile: CppTargetProfile) -> CppLanguageModel {
  CppLanguageModel {
    language_identity: cpp_language_model_surface_id,
    canonical_symbols: cpp_language_model_canonical_symbols(target_profile: target_profile),
    core: cpp_model_core_wave1(target_profile: target_profile)
  }
}

