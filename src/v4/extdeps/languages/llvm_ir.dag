module v4.extdeps.languages.llvm_ir

import v4.std.node { Node }
import v4.std.algebra { CommutativeRing, Ring, AbelianGroup, Group, Monoid, Semigroup, Magma, Ordering, Less, Equal, Greater }

type LlvmType
  = VoidType
  | IntegerType { bits: Int }
  | VectorType { element: LlvmType, count: Int }
  | StructType { fields: List<LlvmType> }

type LlvmValue
  = ConstInt { ty: LlvmType, n: Int }
  | Reg { name: Symbol }

data llvm_int_commutative_ring: CommutativeRing<LlvmValue> = CommutativeRing {
  ring: Ring {
    add: AbelianGroup { group: Group {
      monoid: Monoid {
        semigroup: Semigroup { magma: Magma { op: fn(a, b) { a } } },
        identity: ConstInt { ty: IntegerType { bits: 32 }, n: 0 }
      },
      inverse: fn(x) { x }
    } },
    mul: Monoid {
      semigroup: Semigroup { magma: Magma { op: fn(a, b) { a } } },
      identity: ConstInt { ty: IntegerType { bits: 32 }, n: 1 }
    }
  }
}
