// src/v4/extdeps/languages/llvm_ir.dag
// Scope: LLVM 18 LangRef IR structural vocabulary (T-4.12).
// Anchor: https://releases.llvm.org/18.1.8/docs/LangRef.html
// Owns:
//   FloatKind
//   LlvmType
//   VectorScaling
//   StructPacking
//   VarArg
//   LlvmConstant
//   LlvmValue
//   BinaryOpcode
//   ConversionOpcode
//   IntPredicate
//   FloatPredicate
//   ConstExprOpcode
//   PhiIncoming
//   PhiNode
//   SwitchCase
//   CallArgument
//   CallResult
//   LandingPadCleanup
//   LandingClause
//   AtomicOrdering
//   CmpXchgSuccessOrdering
//   CmpXchgFailureOrdering
//   FenceOrdering
//   AtomicRmwOrdering
//   AtomicRmwOp
//   LlvmInstruction
//   LoadOrdering
//   StoreOrdering
//   LoadAtomicity
//   StoreAtomicity
//   Terminator
//   UnwindDest
//   BasicBlock
//   Linkage
//   FunctionBody
//   FunctionParameter
//   LlvmFunction
//   GlobalMutability
//   GlobalInitializer
//   LlvmGlobal
//   NamedStructDef
//   LlvmModule
//   FidelityDisposition
//   FidelityFeature
// Consumes: std/node.dag
// Status: T-4.12 PASS (B2-OMNI); import v4.std.node Symbol only.

module v4.extdeps.languages.llvm_ir


import v4.std.node { Symbol }




type FloatKind
  = HalfFloat
  | BFloatFloat
  | SingleFloat
  | DoubleFloat
  | Fp128Float
  | X86Fp80Float
  | PpcFp128Float


type LlvmType
  = VoidType
  | LabelType
  | TokenType
  | MetadataType
  | IntegerType { bits: Int }
  | FloatingType { kind: FloatKind }
  | PointerType { address_space: Int }
  | VectorType { element: LlvmType, count: Int, scalable: VectorScaling }
  | ArrayType { element: LlvmType, count: Int }
  | StructType { fields: List<LlvmType>, packed: StructPacking }
  | FunctionType { result: LlvmType, params: List<LlvmType>, var_arg: VarArg }
  | NamedType { name: Symbol }


type VectorScaling
  = FixedVector
  | ScalableVector


type StructPacking
  = NaturalAligned
  | Packed


type VarArg
  = FixedArity
  | Variadic


type LlvmConstant
  = IntConstant { ty: LlvmType, value: Int }
  | FloatConstant { ty: LlvmType, bits: Int }
  | NullPointer { ty: LlvmType }
  | NoneToken
  | AggregateConstant { ty: LlvmType, elements: List<LlvmConstant> }
  | ZeroInitializer { ty: LlvmType }
  | UndefValue { ty: LlvmType }
  | PoisonValue { ty: LlvmType }
  | BlockAddress { function: Symbol, block: Symbol }
  | GlobalAddress { name: Symbol }
  | ConstantExpr { op: ConstExprOpcode, operands: List<LlvmConstant>, result_type: LlvmType }


type LlvmValue
  = LocalRef { name: Symbol }
  | ConstantOperand { constant: LlvmConstant }
  | GlobalRef { name: Symbol }



type BinaryOpcode
  = OpAdd | OpSub | OpMul | OpUDiv | OpSDiv | OpURem | OpSRem
  | OpShl | OpLShr | OpAShr | OpAnd | OpOr | OpXor
  | OpFAdd | OpFSub | OpFMul | OpFDiv | OpFRem


type ConversionOpcode
  = OpTrunc | OpZExt | OpSExt
  | OpFPTrunc | OpFPExt
  | OpFPToUI | OpFPToSI | OpUIToFP | OpSIToFP
  | OpPtrToInt | OpIntToPtr | OpBitCast | OpAddrSpaceCast


type IntPredicate
  = IcmpEq | IcmpNe
  | IcmpUgt | IcmpUge | IcmpUlt | IcmpUle
  | IcmpSgt | IcmpSge | IcmpSlt | IcmpSle


type FloatPredicate
  = FcmpFalse
  | FcmpOeq | FcmpOgt | FcmpOge | FcmpOlt | FcmpOle | FcmpOne | FcmpOrd
  | FcmpUeq | FcmpUgt | FcmpUge | FcmpUlt | FcmpUle | FcmpUne | FcmpUno
  | FcmpTrue


type ConstExprOpcode
  = CeTrunc | CePtrToInt | CeIntToPtr | CeBitCast
  | CeAddrSpaceCast | CeGetElementPtr
  | CeAdd | CeSub | CeMul | CeShl | CeXor
  | CeICmp | CeFCmp
  | CeExtractElement | CeInsertElement | CeShuffleVector


type PhiIncoming {
  value: LlvmValue
  block: Symbol
}


type PhiNode {
  result: Symbol
  result_type: LlvmType
  incomings: List<PhiIncoming>
}


type SwitchCase {
  match_value: LlvmConstant
  target: Symbol
}


type CallArgument {
  ty: LlvmType
  value: LlvmValue
}


type CallResult
  = VoidCall
  | ValueCall { name: Symbol, result_type: LlvmType }


type LandingPadCleanup
  = IsCleanup
  | NotCleanup


type LandingClause
  = CatchClause { type_info: LlvmValue }
  | FilterClause { type_infos: List<LlvmValue> }


type AtomicOrdering
  = OrderingUnordered
  | OrderingMonotonic
  | OrderingAcquire
  | OrderingRelease
  | OrderingAcqRel
  | OrderingSeqCst


type CmpXchgSuccessOrdering
  = SuccessMonotonic
  | SuccessAcquire
  | SuccessRelease
  | SuccessAcqRel
  | SuccessSeqCst

type CmpXchgFailureOrdering
  = FailureMonotonic
  | FailureAcquire
  | FailureSeqCst

type FenceOrdering
  = FenceAcquire
  | FenceRelease
  | FenceAcqRel
  | FenceSeqCst

type AtomicRmwOrdering
  = RmwOrdMonotonic
  | RmwOrdAcquire
  | RmwOrdRelease
  | RmwOrdAcqRel
  | RmwOrdSeqCst


type AtomicRmwOp
  = RmwXchg | RmwAdd | RmwSub | RmwAnd | RmwNand | RmwOr | RmwXor
  | RmwMax | RmwMin | RmwUMax | RmwUMin | RmwFAdd | RmwFSub
  | RmwFMax | RmwFMin | RmwUIncWrap | RmwUDecWrap


type LlvmInstruction
  = Binary {
      result: Symbol
      result_type: LlvmType
      op: BinaryOpcode
      lhs: LlvmValue
      rhs: LlvmValue
    }
  | Conversion {
      result: Symbol
      result_type: LlvmType
      op: ConversionOpcode
      value: LlvmValue
    }
  | IntCompare {
      result: Symbol
      predicate: IntPredicate
      lhs: LlvmValue
      rhs: LlvmValue
    }
  | FloatCompare {
      result: Symbol
      predicate: FloatPredicate
      lhs: LlvmValue
      rhs: LlvmValue
    }
  | Alloca {
      result: Symbol
      allocated_type: LlvmType
      element_count: LlvmValue
    }
  | Load {
      result: Symbol
      result_type: LlvmType
      pointer: LlvmValue
      ordering: LoadAtomicity
    }
  | Store {
      value: LlvmValue
      pointer: LlvmValue
      ordering: StoreAtomicity
    }
  | GetElementPtr {
      result: Symbol
      source_type: LlvmType
      base: LlvmValue
      indices: List<LlvmValue>
    }
  | AtomicRmw {
      result: Symbol
      op: AtomicRmwOp
      pointer: LlvmValue
      operand: LlvmValue
      ordering: AtomicRmwOrdering
    }
  | CmpXchg {
      result: Symbol
      pointer: LlvmValue
      compare_value: LlvmValue
      new_value: LlvmValue
      success_ordering: CmpXchgSuccessOrdering
      failure_ordering: CmpXchgFailureOrdering
    }
  | Fence {
      ordering: FenceOrdering
    }
  | ExtractValue {
      result: Symbol
      aggregate: LlvmValue
      indices: List<Int>
    }
  | InsertValue {
      result: Symbol
      aggregate: LlvmValue
      element: LlvmValue
      indices: List<Int>
    }
  | ExtractElement {
      result: Symbol
      vector: LlvmValue
      index: LlvmValue
    }
  | InsertElement {
      result: Symbol
      vector: LlvmValue
      element: LlvmValue
      index: LlvmValue
    }
  | ShuffleVector {
      result: Symbol
      first: LlvmValue
      second: LlvmValue
      mask: LlvmValue
    }
  | Select {
      result: Symbol
      condition: LlvmValue
      if_true: LlvmValue
      if_false: LlvmValue
    }
  | Call {
      callee: LlvmValue
      arguments: List<CallArgument>
      result: CallResult
    }
  | Freeze {
      result: Symbol
      value: LlvmValue
    }
  | FNeg {
      result: Symbol
      result_type: LlvmType
      operand: LlvmValue
    }
  | VaArg {
      result: Symbol
      result_type: LlvmType
      va_list: LlvmValue
      arg_type: LlvmType
    }
  | LandingPad {
      result: Symbol
      result_type: LlvmType
      is_cleanup: LandingPadCleanup
      clauses: List<LandingClause>
    }
  | CatchPad {
      result: Symbol
      catch_switch: LlvmValue
      args: List<LlvmValue>
    }
  | CleanupPad {
      result: Symbol
      parent_pad: LlvmValue
      args: List<LlvmValue>
    }




type LoadOrdering
  = LoadUnordered
  | LoadMonotonic
  | LoadAcquire
  | LoadSeqCst

type StoreOrdering
  = StoreUnordered
  | StoreMonotonic
  | StoreRelease
  | StoreSeqCst


type LoadAtomicity
  = PlainLoad
  | AtomicLoad { ordering: LoadOrdering }

type StoreAtomicity
  = PlainStore
  | AtomicStore { ordering: StoreOrdering }


type Terminator
  = RetVoid
  | RetValue { value: LlvmValue }
  | UnconditionalBr { target: Symbol }
  | ConditionalBr { condition: LlvmValue, if_true: Symbol, if_false: Symbol }
  | Switch { value: LlvmValue, default_target: Symbol, cases: List<SwitchCase> }
  | IndirectBr { address: LlvmValue, possible_targets: List<Symbol> }
  | Unreachable
  | Invoke {
      callee: LlvmValue
      arguments: List<CallArgument>
      result: CallResult
      normal_target: Symbol
      unwind_target: Symbol
    }
  | CallBr {
      callee: LlvmValue
      arguments: List<CallArgument>
      result: CallResult
      fallthrough: Symbol
      indirect_targets: List<Symbol>
    }
  | Resume { value: LlvmValue }
  | CatchSwitch { result: Symbol, parent_pad: LlvmValue, handlers: List<Symbol>, unwind: UnwindDest }
  | CleanupRet { cleanup_pad: LlvmValue, unwind: UnwindDest }
  | CatchRet { catch_pad: LlvmValue, successor: Symbol }


type UnwindDest
  = UnwindToCaller
  | UnwindToLabel { target: Symbol }


type BasicBlock {
  label: Symbol
  phis: List<PhiNode>
  body: List<LlvmInstruction>
  terminator: Terminator
}


type Linkage
  = LinkagePrivate
  | LinkageInternal
  | LinkageAvailableExternally
  | LinkageLinkOnce
  | LinkageLinkOnceOdr
  | LinkageWeak
  | LinkageWeakOdr
  | LinkageCommon
  | LinkageAppending
  | LinkageExternal
  | LinkageExternalWeak


type FunctionBody
  = Declared
  | Defined { entry: BasicBlock, rest: List<BasicBlock> }


type FunctionParameter {
  ty: LlvmType
  name: Symbol
}


type LlvmFunction {
  name: Symbol
  result_type: LlvmType
  parameters: List<FunctionParameter>
  var_arg: VarArg
  linkage: Linkage
  body: FunctionBody
}


type GlobalMutability
  = MutableGlobal
  | ConstantGlobal


type GlobalInitializer
  = ExternalInit
  | InitializedWith { constant: LlvmConstant }


type LlvmGlobal {
  name: Symbol
  value_type: LlvmType
  mutability: GlobalMutability
  linkage: Linkage
  initializer: GlobalInitializer
  address_space: Int
}


type NamedStructDef {
  name: Symbol
  definition: LlvmType
}


type LlvmModule {
  data_layout: Symbol
  target_triple: Symbol
  named_structs: List<NamedStructDef>
  globals: List<LlvmGlobal>
  functions: List<LlvmFunction>
}


fn unwind_successors(d: UnwindDest) -> List<Symbol> {
  match d {
    UnwindToCaller => []
    UnwindToLabel { target: t } => [t]
  }
}

fn block_successors(t: Terminator) -> List<Symbol> {
  match t {
    RetVoid => []
    RetValue { value: _ } => []
    UnconditionalBr { target: tgt } => [tgt]
    ConditionalBr { condition: _, if_true: a, if_false: b } => [a, b]
    Switch { value: _, default_target: d, cases: cs } =>
      concat([d], map(cs, fn(c) { c.target }))
    IndirectBr { address: _, possible_targets: ts } => ts
    Unreachable => []
    Invoke { callee: _, arguments: _, result: _, normal_target: n, unwind_target: u } => [n, u]
    CallBr { callee: _, arguments: _, result: _, fallthrough: f, indirect_targets: it } =>
      concat([f], it)
    Resume { value: _ } => []
    CatchSwitch { result: _, parent_pad: _, handlers: hs, unwind: u } => concat(hs, unwind_successors(d: u))
    CleanupRet { cleanup_pad: _, unwind: u } => unwind_successors(d: u)
    CatchRet { catch_pad: _, successor: s } => [s]
  }
}


fn terminator_is_catchswitch(t: Terminator) -> Bool {
  match t {
    CatchSwitch { result: _, parent_pad: _, handlers: _, unwind: _ } => true
    _ => false
  }
}

fn block_well_formed(b: BasicBlock) -> Bool {
  if terminator_is_catchswitch(t: b.terminator) {
    count(b.body) == 0
  } else {
    true
  }
}


type FidelityDisposition
  = Modeled
  | DeclaredNormalized { feature: FidelityFeature }
  | FailClosed { feature: FidelityFeature }


type FidelityFeature
  = StructuralCore
  | SsaValueSpelling
  | BlockTextualOrder
  | LexicalTrivia
  | TargetConfigToken
  | AdvisoryMetadata
  | UnmodeledInlineAsm
  | UnmodeledSemanticAttribute
  | UnmodeledType
  | UnmodeledInstruction
  | UnmodeledConstExpr
  | MalformedStructure


fn feature_disposition(f: FidelityFeature) -> FidelityDisposition {
  match f {
    StructuralCore => Modeled
    SsaValueSpelling => DeclaredNormalized { feature: SsaValueSpelling }
    BlockTextualOrder => DeclaredNormalized { feature: BlockTextualOrder }
    LexicalTrivia => DeclaredNormalized { feature: LexicalTrivia }
    TargetConfigToken => DeclaredNormalized { feature: TargetConfigToken }
    AdvisoryMetadata => DeclaredNormalized { feature: AdvisoryMetadata }
    UnmodeledInlineAsm => FailClosed { feature: UnmodeledInlineAsm }
    UnmodeledSemanticAttribute => FailClosed { feature: UnmodeledSemanticAttribute }
    UnmodeledType => FailClosed { feature: UnmodeledType }
    UnmodeledInstruction => FailClosed { feature: UnmodeledInstruction }
    UnmodeledConstExpr => FailClosed { feature: UnmodeledConstExpr }
    MalformedStructure => FailClosed { feature: MalformedStructure }
  }
}



fn llvm_instruction_cost(i: LlvmInstruction) -> Int {
  match i {
    Binary { result: _, result_type: _, op: _, lhs: _, rhs: _ } => 1
    Conversion { result: _, result_type: _, op: OpBitCast, value: _ } => 0
    Conversion { result: _, result_type: _, op: _, value: _ } => 1
    IntCompare { result: _, predicate: _, lhs: _, rhs: _ } => 1
    FloatCompare { result: _, predicate: _, lhs: _, rhs: _ } => 1
    Alloca { result: _, allocated_type: _, element_count: _ } => 1
    Load { result: _, result_type: _, pointer: _, ordering: _ } => 4
    Store { value: _, pointer: _, ordering: _ } => 4
    GetElementPtr { result: _, source_type: _, base: _, indices: _ } => 1
    AtomicRmw { result: _, op: _, pointer: _, operand: _, ordering: _ } => 8
    CmpXchg { result: _, pointer: _, compare_value: _, new_value: _, success_ordering: _, failure_ordering: _ } => 8
    Fence { ordering: _ } => 4
    ExtractValue { result: _, aggregate: _, indices: _ } => 0
    InsertValue { result: _, aggregate: _, element: _, indices: _ } => 1
    ExtractElement { result: _, vector: _, index: _ } => 1
    InsertElement { result: _, vector: _, element: _, index: _ } => 1
    ShuffleVector { result: _, first: _, second: _, mask: _ } => 1
    Select { result: _, condition: _, if_true: _, if_false: _ } => 1
    Call { callee: _, arguments: _, result: _ } => 5
    Freeze { result: _, value: _ } => 0
    FNeg { result: _, result_type: _, operand: _ } => 1
    VaArg { result: _, result_type: _, va_list: _, arg_type: _ } => 2
    LandingPad { result: _, result_type: _, is_cleanup: _, clauses: _ } => 1
    CatchPad { result: _, catch_switch: _, args: _ } => 1
    CleanupPad { result: _, parent_pad: _, args: _ } => 1
  }
}
