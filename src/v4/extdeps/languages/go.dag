// Sole primitive-fact list authorities — ModelCore.primitives and canonical_symbols derive
// from these catalogs. Add a primitive row here, not in a parallel hand-authored list.
data go_integer_facts_catalog: List<GoIntegerPrimitiveFacts> = [
  go_facts_int,
  go_facts_int8,
  go_facts_int16,
  go_facts_int32,
  go_facts_int64,
  go_facts_uint,
  go_facts_uint8,
  go_facts_uint16,
  go_facts_uint32,
  go_facts_uint64,
  go_facts_uintptr
]

data go_float_facts_catalog: List<GoFloatPrimitiveFacts> = [
  go_facts_float32,
  go_facts_float64
]

data go_complex_facts_catalog: List<GoComplexPrimitiveFacts> = [
  go_facts_complex64,
  go_facts_complex128
]

data go_nonnumeric_facts_catalog: List<GoNonNumericPrimitiveFacts> = [
  go_facts_bool,
  go_facts_string
]

// 🟡 canonical-B decl-ref · E-6(b) bounded-exception · scaffold feature:canonical-b-grounding-consumer · dissolve-on: B1-CANON+zip-fold consume (ledger: B1·T-9/C1 · grounding-worked-examples.md §0)
data go_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn go_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn go_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn go_signedness_node(signedness: GoIntegerSignedness) -> Node {
  match signedness {
    SignedInteger => go_inhabitant_atom(id: go_tag_signed)
    UnsignedInteger => go_inhabitant_atom(id: go_tag_unsigned)
  }
}

fn go_signed_width_node(width: SignedIntWidth) -> Node {
  match width {
    SignedBits8 => go_inhabitant_atom(id: go_tag_bits8)
    SignedBits16 => go_inhabitant_atom(id: go_tag_bits16)
    SignedBits32 => go_inhabitant_atom(id: go_tag_bits32)
    SignedBits64 => go_inhabitant_atom(id: go_tag_bits64)
    SignedPlatformInt => go_inhabitant_atom(id: go_tag_platform_int)
  }
}

fn go_unsigned_width_node(width: UnsignedIntWidth) -> Node {
  match width {
    UnsignedBits8 => go_inhabitant_atom(id: go_tag_bits8)
    UnsignedBits16 => go_inhabitant_atom(id: go_tag_bits16)
    UnsignedBits32 => go_inhabitant_atom(id: go_tag_bits32)
    UnsignedBits64 => go_inhabitant_atom(id: go_tag_bits64)
    UnsignedPlatformInt => go_inhabitant_atom(id: go_tag_platform_int)
    UnsignedPointerSized => go_inhabitant_atom(id: go_tag_uintptr)
  }
}

fn go_float_width_node(width: GoFloatWidth) -> Node {
  match width {
    Bits32 => go_inhabitant_atom(id: go_tag_bits32)
    Bits64 => go_inhabitant_atom(id: go_tag_bits64)
  }
}

fn go_complex_width_node(width: GoComplexWidth) -> Node {
  match width {
    Bits64 => go_inhabitant_atom(id: go_tag_complex_bits64)
    Bits128 => go_inhabitant_atom(id: go_tag_complex_bits128)
  }
}

fn go_overflow_node(overflow: GoBuiltinIntegerArithmeticOverflow) -> Node {
  match overflow {
    SignedTypedIntegerTruncatesSilentlyOnOverflow =>
      go_inhabitant_atom(id: go_tag_integer_overflow_signed_truncates)
    UnsignedTypedIntegerTruncatesSilentlyOnOverflow =>
      go_inhabitant_atom(id: go_tag_integer_overflow_unsigned_truncates)
  }
}

fn go_scalar_node(scalar: GoScalar) -> Node {
  match scalar {
    SignedIntScalar { width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: go_facts_field_scalar_classifier,
          target: go_inhabitant_atom(id: go_tag_scalar_int)
        ),
        go_named_edge(name: go_facts_field_signedness, target: go_inhabitant_atom(id: go_tag_signed)),
        go_named_edge(name: go_facts_field_width, target: go_signed_width_node(width: width))
      ]
    }
    UnsignedIntScalar { width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: go_facts_field_scalar_classifier,
          target: go_inhabitant_atom(id: go_tag_scalar_int)
        ),
        go_named_edge(name: go_facts_field_signedness, target: go_inhabitant_atom(id: go_tag_unsigned)),
        go_named_edge(name: go_facts_field_width, target: go_unsigned_width_node(width: width))
      ]
    }
    FloatScalar { width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: go_facts_field_scalar_classifier,
          target: go_inhabitant_atom(id: go_tag_scalar_float)
        ),
        go_named_edge(name: go_facts_field_width, target: go_float_width_node(width: width))
      ]
    }
    ComplexScalar { width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: go_facts_field_scalar_classifier,
          target: go_inhabitant_atom(id: go_tag_scalar_complex)
        ),
        go_named_edge(name: go_facts_field_width, target: go_complex_width_node(width: width))
      ]
    }
    BoolScalar => go_inhabitant_atom(id: go_tag_scalar_bool)
    StringScalar => go_inhabitant_atom(id: go_tag_scalar_string)
  }
}

fn go_integer_facts_node(facts: GoIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(
        name: go_facts_field_surface_spelling,
        target: go_inhabitant_atom(id: facts.surface_spelling)
      ),
      go_named_edge(
        name: go_facts_field_signedness,
        target: go_signedness_node(signedness: facts.signedness)
      ),
      go_named_edge(
        name: go_facts_field_width,
        target: go_scalar_node(scalar: facts.width)
      ),
      go_named_edge(
        name: go_facts_field_overflow,
        target: go_overflow_node(overflow: facts.overflow)
      ),
      go_named_edge(
        name: go_facts_field_encoding,
        target: go_inhabitant_atom(id: facts.encoding)
      ),
      go_named_edge(
        name: go_facts_field_std_projection,
        target: go_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn go_float_facts_node(facts: GoFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(
        name: go_facts_field_surface_spelling,
        target: go_inhabitant_atom(id: facts.surface_spelling)
      ),
      go_named_edge(name: go_facts_field_width, target: go_float_width_node(width: facts.width)),
      go_named_edge(
        name: go_facts_field_encoding,
        target: go_inhabitant_atom(id: facts.encoding)
      ),
      go_named_edge(
        name: go_facts_field_std_projection,
        target: go_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn go_complex_facts_node(facts: GoComplexPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(
        name: go_facts_field_surface_spelling,
        target: go_inhabitant_atom(id: facts.surface_spelling)
      ),
      go_named_edge(name: go_facts_field_width, target: go_complex_width_node(width: facts.width)),
      go_named_edge(
        name: go_facts_field_encoding,
        target: go_inhabitant_atom(id: facts.component_encoding)
      ),
      go_named_edge(
        name: go_facts_field_std_projection,
        target: go_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn go_nonnumeric_facts_node(facts: GoNonNumericPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(
        name: go_facts_field_surface_spelling,
        target: go_inhabitant_atom(id: facts.surface_spelling)
      ),
      go_named_edge(
        name: go_facts_field_scalar_classifier,
        target: go_scalar_node(scalar: facts.scalar)
      ),
      go_named_edge(
        name: go_facts_field_encoding,
        target: go_inhabitant_atom(id: facts.encoding)
      ),
      go_named_edge(
        name: go_facts_field_std_projection,
        target: go_inhabitant_atom(id: facts.std_projection)
      )
    ]
  }
}

fn go_primitive_fact_map_5(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node,
  axis2: Symbol,
  fact2: Node,
  axis3: Symbol,
  fact3: Node,
  axis4: Symbol,
  fact4: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(
          map_insert(empty_map(), axis0, fact0),
          axis1,
          fact1
        ),
        axis2,
        fact2
      ),
      axis3,
      fact3
    ),
    axis4,
    fact4
  )
}

fn go_primitive_fact_map_3(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node,
  axis2: Symbol,
  fact2: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(
      map_insert(empty_map(), axis0, fact0),
      axis1,
      fact1
    ),
    axis2,
    fact2
  )
}

fn go_primitive_fact_map_2(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(empty_map(), axis0, fact0),
    axis1,
    fact1
  )
}

fn go_primitive_bundle_from_integer_facts(facts: GoIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: go_integer_facts_node(facts: facts),
    spec_facts: go_primitive_fact_map_5(
      axis0: primitive_fact_axis_surface_spelling,
      fact0: go_inhabitant_atom(id: facts.surface_spelling),
      axis1: primitive_fact_axis_width,
      fact1: go_scalar_node(scalar: facts.width),
      axis2: primitive_fact_axis_signedness,
      fact2: go_signedness_node(signedness: facts.signedness),
      axis3: primitive_fact_axis_overflow_disposition,
      fact3: go_overflow_node(overflow: facts.overflow),
      axis4: primitive_fact_axis_encoding,
      fact4: go_inhabitant_atom(id: facts.encoding)
    )
  }
}

fn go_primitive_bundle_from_float_facts(facts: GoFloatPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: go_float_facts_node(facts: facts),
    spec_facts: go_primitive_fact_map_3(
      axis0: primitive_fact_axis_surface_spelling,
      fact0: go_inhabitant_atom(id: facts.surface_spelling),
      axis1: primitive_fact_axis_width,
      fact1: go_float_width_node(width: facts.width),
      axis2: primitive_fact_axis_encoding,
      fact2: go_inhabitant_atom(id: facts.encoding)
    )
  }
}

fn go_primitive_bundle_from_complex_facts(facts: GoComplexPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
