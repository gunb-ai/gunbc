  primitive_fact_axis_width
}
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.logic { Bool, bool_boolean_algebra }
import v4.std.algebra { BooleanAlgebra, Empty, fold_list }

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SignedIntWidth
  = SignedBits8
  | SignedBits16
  | SignedBits32
  | SignedBits64
  | SignedPlatformInt

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type UnsignedIntWidth
  = UnsignedBits8
  | UnsignedBits16
  | UnsignedBits32
  | UnsignedBits64
  | UnsignedPlatformInt
  | UnsignedPointerSized

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoFloatWidth
  = Bits32
  | Bits64

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoComplexWidth
  = Bits64
  | Bits128

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoScalarKind
  = Int
  | Float
  | Complex
  | Bool
  | String

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoScalar
  = SignedIntScalar { width: SignedIntWidth }
  | UnsignedIntScalar { width: UnsignedIntWidth }
  | FloatScalar { width: GoFloatWidth }
  | ComplexScalar { width: GoComplexWidth }
  | BoolScalar
  | StringScalar

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoChannelDirection
  = SendRecv
  | SendOnly
  | RecvOnly

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoExportLocus
  = PackageBlock
  | StructField
  | MethodName

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoExportStatus
  = Exported { locus: GoExportLocus }
  | Unexported { locus: GoExportLocus }

type GoChannel {
  direction: GoChannelDirection
  element_type_ref: Symbol
}

type GoCost {
  instruction_cost: Int
  allocation_cost: Int
}

// Go spec: typed integer arithmetic truncates silently on overflow (not panic).
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoBuiltinIntegerArithmeticOverflow
  = SignedTypedIntegerTruncatesSilentlyOnOverflow
  | UnsignedTypedIntegerTruncatesSilentlyOnOverflow

type GoIntegerOverflowDisposition<IRCarrier> {
  debug_default: GoBuiltinIntegerArithmeticOverflow
  release_default: GoBuiltinIntegerArithmeticOverflow
}

// Signedness axis for ModelCore primitive bundles (mirrors java/rust carrier shape).
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoIntKind
  = Signed
  | Unsigned

type GoIntegerPrimitiveFacts {
  surface_spelling: Symbol
  scalar: GoScalar
  signedness: GoIntKind
  overflow: GoBuiltinIntegerArithmeticOverflow
  encoding: Symbol
  std_projection: Symbol
}

type GoFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: GoFloatWidth
  ieee754_binary: Symbol
  std_projection: Symbol
}

// Go spec: complex is a pair of floating-point values (complex64 = two float32, etc.).
type GoComplexPrimitiveFacts {
  surface_spelling: Symbol
  width: GoComplexWidth
  component_ieee754_binary: Symbol
  std_projection: Symbol
}

type GoBoolPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type GoStringPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type GoLanguageModel {
  lex: LexRules
  grammar: Grammar
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

