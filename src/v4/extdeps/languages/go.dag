// 🟡 canonical-B decl-ref · E-6(b) bounded-exception · scaffold feature:canonical-b-grounding-consumer · dissolve-on: B1-CANON+zip-fold consume (ledger: B1·T-9/C1 · grounding-worked-examples.md §0)
data go_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn go_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn go_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn go_int_kind_node(kind: GoIntKind) -> Node {
  match kind {
    Signed => go_inhabitant_atom(id: go_tag_signed)
    Unsigned => go_inhabitant_atom(id: go_tag_unsigned)
  }
}

fn go_signed_int_width_node(width: SignedIntWidth) -> Node {
  match width {
    SignedBits8 => go_inhabitant_atom(id: go_tag_signed_bits8)
    SignedBits16 => go_inhabitant_atom(id: go_tag_signed_bits16)
    SignedBits32 => go_inhabitant_atom(id: go_tag_signed_bits32)
    SignedBits64 => go_inhabitant_atom(id: go_tag_signed_bits64)
    SignedPlatformInt => go_inhabitant_atom(id: go_tag_signed_platform_int)
  }
}

fn go_unsigned_int_width_node(width: UnsignedIntWidth) -> Node {
  match width {
    UnsignedBits8 => go_inhabitant_atom(id: go_tag_unsigned_bits8)
    UnsignedBits16 => go_inhabitant_atom(id: go_tag_unsigned_bits16)
    UnsignedBits32 => go_inhabitant_atom(id: go_tag_unsigned_bits32)
    UnsignedBits64 => go_inhabitant_atom(id: go_tag_unsigned_bits64)
    UnsignedPlatformInt => go_inhabitant_atom(id: go_tag_unsigned_platform_int)
    UnsignedPointerSized => go_inhabitant_atom(id: go_tag_unsigned_pointer_sized)
  }
}

fn go_float_width_node(width: GoFloatWidth) -> Node {
  match width {
    Bits32 => go_inhabitant_atom(id: go_tag_float_bits32)
    Bits64 => go_inhabitant_atom(id: go_tag_float_bits64)
  }
}

fn go_complex_width_node(width: GoComplexWidth) -> Node {
  match width {
    Bits64 => go_inhabitant_atom(id: go_tag_complex_bits64)
    Bits128 => go_inhabitant_atom(id: go_tag_complex_bits128)
  }
}

fn go_overflow_node(overflow: GoBuiltinIntegerArithmeticOverflow) -> Node {
  match overflow {
    SignedTypedIntegerTruncatesSilentlyOnOverflow =>
      go_inhabitant_atom(id: go_tag_overflow_signed_truncates)
    UnsignedTypedIntegerTruncatesSilentlyOnOverflow =>
      go_inhabitant_atom(id: go_tag_overflow_unsigned_truncates)
  }
}

fn go_integer_facts_node(facts: GoIntegerPrimitiveFacts) -> Node {
  match facts {
    GoSignedIntegerPrimitiveFacts {
      surface_spelling,
      width,
      encoding,
      std_projection
    } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: go_facts_field_surface_spelling,
          target: go_inhabitant_atom(id: surface_spelling)
        ),
        go_named_edge(
          name: go_facts_field_width,
          target: go_signed_int_width_node(width: width)
        ),
        go_named_edge(
          name: go_facts_field_signedness,
          target: go_int_kind_node(kind: Signed)
        ),
        go_named_edge(
          name: go_facts_field_overflow,
          target: go_overflow_node(
            overflow: SignedTypedIntegerTruncatesSilentlyOnOverflow
          )
        ),
        go_named_edge(
          name: go_facts_field_encoding,
          target: go_inhabitant_atom(id: encoding)
        ),
        go_named_edge(
          name: go_facts_field_std_projection,
          target: go_inhabitant_atom(id: std_projection)
        )
      ]
    }
    GoUnsignedIntegerPrimitiveFacts {
      surface_spelling,
      width,
      encoding,
      std_projection
    } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: go_facts_field_surface_spelling,
          target: go_inhabitant_atom(id: surface_spelling)
        ),
        go_named_edge(
          name: go_facts_field_width,
          target: go_unsigned_int_width_node(width: width)
        ),
        go_named_edge(
          name: go_facts_field_signedness,
          target: go_int_kind_node(kind: Unsigned)
        ),
        go_named_edge(
          name: go_facts_field_overflow,
          target: go_overflow_node(
            overflow: UnsignedTypedIntegerTruncatesSilentlyOnOverflow
          )
        ),
        go_named_edge(
          name: go_facts_field_encoding,
          target: go_inhabitant_atom(id: encoding)
        ),
        go_named_edge(
          name: go_facts_field_std_projection,
          target: go_inhabitant_atom(id: std_projection)
        )
      ]
    }
  }
}

