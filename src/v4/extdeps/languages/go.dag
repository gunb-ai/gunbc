      axis0: primitive_fact_axis_surface_spelling,
      fact0: go_inhabitant_atom(id: facts.surface_spelling),
      axis1: primitive_fact_axis_width,
      fact1: go_complex_width_node(width: facts.width),
      axis2: primitive_fact_axis_encoding,
      fact2: go_inhabitant_atom(id: facts.component_encoding)
    )
  }
}

fn go_primitive_bundle_from_nonnumeric_facts(
  facts: GoNonNumericPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: go_nonnumeric_facts_node(facts: facts),
    spec_facts: go_primitive_fact_map_2(
      axis0: primitive_fact_axis_surface_spelling,
      fact0: go_inhabitant_atom(id: facts.surface_spelling),
      axis1: primitive_fact_axis_encoding,
      fact1: go_inhabitant_atom(id: facts.encoding)
    )
  }
}

fn go_list_snoc_item<T>(xs: List<T>, item: T) -> List<T> {
  fold_list(
    xs: xs,
    empty: Cons { head: item, tail: Empty },
    cons: fn(rest, existing) {
      Cons { head: existing, tail: rest }
    }
  )
}

fn go_list_append<T>(left: List<T>, right: List<T>) -> List<T> {
  fold_list(
    xs: right,
    empty: left,
    cons: fn(acc, item) {
      go_list_snoc_item(xs: acc, item: item)
    }
  )
}

fn go_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: go_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      go_list_snoc_item(
        xs: acc,
        item: go_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn go_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: go_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      go_list_snoc_item(
        xs: acc,
        item: go_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn go_primitive_bundles_from_complex_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: go_complex_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      go_list_snoc_item(
        xs: acc,
        item: go_primitive_bundle_from_complex_facts(facts: facts)
      )
    }
  )
}

fn go_primitive_bundles_from_nonnumeric_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: go_nonnumeric_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      go_list_snoc_item(
        xs: acc,
        item: go_primitive_bundle_from_nonnumeric_facts(facts: facts)
      )
    }
  )
}

fn go_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  go_list_append(
    left: go_list_append(
      left: go_list_append(
        left: go_primitive_bundles_from_integer_catalog(),
        right: go_primitive_bundles_from_float_catalog()
      ),
      right: go_primitive_bundles_from_complex_catalog()
    ),
    right: go_primitive_bundles_from_nonnumeric_catalog()
  )
}

fn go_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: GoIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn go_float_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: GoFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn go_complex_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: GoComplexPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn go_nonnumeric_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: GoNonNumericPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn go_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: go_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      go_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn go_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: go_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      go_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn go_complex_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: go_complex_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      go_complex_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn go_nonnumeric_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: go_nonnumeric_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      go_nonnumeric_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn go_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      go_integer_catalog_surface_symbol(sym: sym) ||
        go_float_catalog_surface_symbol(sym: sym) ||
        go_complex_catalog_surface_symbol(sym: sym) ||
        go_nonnumeric_catalog_surface_symbol(sym: sym)
    }
  }
}

fn go_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: go_wave1_primitive_fact_bundles(),
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn go_language_model_wave1() -> GoLanguageModel {
  GoLanguageModel {
    language_identity: go_language_model_surface_id,
    canonical_symbols: go_language_model_canonical_symbols(),
    core: go_model_core_wave1()
  }
}
