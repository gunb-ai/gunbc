    GoSignedIntegerPrimitiveFacts {
      surface_spelling: _,
      width: _,
      encoding: _,
      std_projection
    } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: go_witness_integer_ordered_ring,
          target: go_inhabitant_atom(id: go_witness_integer_ordered_ring)
        ),
        go_named_edge(
          name: go_facts_field_std_projection,
          target: go_inhabitant_atom(id: std_projection)
        )
      ]
    }
    GoUnsignedIntegerPrimitiveFacts {
      surface_spelling: _,
      width: _,
      encoding: _,
      std_projection
    } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: go_witness_integer_ordered_ring,
          target: go_inhabitant_atom(id: go_witness_integer_ordered_ring)
        ),
        go_named_edge(
          name: go_facts_field_std_projection,
          target: go_inhabitant_atom(id: std_projection)
        )
      ]
    }
  }
}

