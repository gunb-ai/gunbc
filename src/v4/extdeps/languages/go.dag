      go_primitive_axis_binding(
        axis: primitive_fact_axis_width,
        fact: go_float_width_node(width: facts.width)
      ),
      go_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: go_inhabitant_atom(id: facts.ieee754_binary)
