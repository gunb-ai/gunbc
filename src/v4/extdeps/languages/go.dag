import v4.std.algebra { BooleanAlgebra, fold_list }

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SignedIntWidth
  = SignedBits8
  | SignedBits16
  | SignedBits32
  | SignedBits64
  | SignedPlatformInt

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type UnsignedIntWidth
  = UnsignedBits8
  | UnsignedBits16
  | UnsignedBits32
  | UnsignedBits64
  | UnsignedPlatformInt
  | UnsignedPointerSized

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoFloatWidth
  = Bits32
  | Bits64

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoComplexWidth
  = Bits64
  | Bits128

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoScalarKind
  = Int
  | Float
  | Complex
  | Bool
  | String

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoScalar
  = SignedIntScalar { width: SignedIntWidth }
  | UnsignedIntScalar { width: UnsignedIntWidth }
  | FloatScalar { width: GoFloatWidth }
  | ComplexScalar { width: GoComplexWidth }
  | BoolScalar
  | StringScalar

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoIntegerSignedness
  = SignedInteger
  | UnsignedInteger

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoChannelDirection
  = SendRecv
  | SendOnly
  | RecvOnly

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoExportLocus
  = PackageBlock
  | StructField
  | MethodName

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoExportStatus
  = Exported { locus: GoExportLocus }
  | Unexported { locus: GoExportLocus }

type GoChannel {
  direction: GoChannelDirection
  element_type_ref: Symbol
}

type GoCost {
  instruction_cost: Int
  allocation_cost: Int
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoBuiltinIntegerArithmeticOverflow
  = SignedTypedIntegerTruncatesSilentlyOnOverflow
  | UnsignedTypedIntegerTruncatesSilentlyOnOverflow

type GoIntegerOverflowDisposition<IRCarrier> {
  debug_default: GoBuiltinIntegerArithmeticOverflow
  release_default: GoBuiltinIntegerArithmeticOverflow
}

type GoIntegerPrimitiveFacts {
  surface_spelling: Symbol
  signedness: GoIntegerSignedness
  width: GoScalar
  overflow: GoBuiltinIntegerArithmeticOverflow
  encoding: Symbol
  std_projection: Symbol
}

type GoFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: GoFloatWidth
  encoding: Symbol
  std_projection: Symbol
}

type GoComplexPrimitiveFacts {
  surface_spelling: Symbol
  width: GoComplexWidth
  component_encoding: Symbol
  std_projection: Symbol
}

type GoNonNumericPrimitiveFacts {
  surface_spelling: Symbol
  scalar: GoScalar
  encoding: Symbol
  std_projection: Symbol
}

type GoLanguageModel {
  language_identity: Symbol
  canonical_symbols: Set<Symbol>
  core: ModelCore
}

