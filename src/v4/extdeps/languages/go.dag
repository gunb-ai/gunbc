// Scope: Go language spec surface — scalar fact-bundles, ModelCore wave-1, channel/export vocabulary.
// Owns: SignedIntWidth, UnsignedIntWidth, GoFloatWidth, GoComplexWidth, GoScalarKind, GoScalar, GoChannelDirection, GoExportLocus, GoExportStatus, GoChannel, GoCost, GoBuiltinIntegerArithmeticOverflow, GoIntegerOverflowDisposition, GoIntegerPrimitiveFacts, GoFloatPrimitiveFacts, GoComplexPrimitiveFacts, GoBoolPrimitiveFacts, GoStringPrimitiveFacts, GoLanguageModel, go_*_facts_catalog, go_*_primitive_bundle, go_model_core_wave1, go_language_model_wave1, go_bool_grounding.
// Consumes: v4.compiler.parse, v4.compiler.tokenize, v4.std.collection, v4.std.model_core, v4.std.node, v4.std.logic, v4.std.algebra.
// Status: T-4 go slice — Go spec §Types (https://go.dev/ref/spec#Types) predeclared numeric/bool/string primitives as fact-bundles; `core: ModelCore` (#3474) primitives + catalog-derived canonical_symbols; lex/grammar void wave-1 (T-11 MVP deferred); byte/rune aliases omitted (canonical uint8/int32 rows only); bool canonical-B decl-ref — 🟡 E-6(b) staging.
// Anchor: https://go.dev/ref/spec

module v4.extdeps.languages.go

import v4.compiler.parse { Grammar, VoidGrammar }
import v4.compiler.tokenize { LexRules, VoidLexRules }
import v4.std.collection { List, Set, list_append, list_snoc_item }
import v4.std.model_core {
  EffectSemanticsDecl,
  ModelCore,
  PartialitySemanticsDecl,
  PrimitiveFactAxisBinding,
  PrimitiveFactBundle,
  primitive_fact_axis_encoding,
  primitive_fact_axis_overflow_disposition,
  primitive_fact_axis_signedness,
