// src/v4/extdeps/languages/go.dag
// Scope: Go language spec surface (scalar width/kind sums, channel direction, export, cost shape, partial D2 resolver); L-2 pin go1.26 via Anchor.
// Owns: SignedIntWidth, UnsignedIntWidth, GoFloatWidth, GoComplexWidth, GoScalarKind, GoScalar, GoChannelDirection, GoExportLocus, GoExportStatus, GoChannel, GoCost, GoBuiltinIntegerArithmeticOverflow, GoIntegerOverflowDisposition.
// Consumes: v4.std.node.Symbol; kernel-ambient Int (STRUCTURE.md traceability).
// Status: extdeps go slice; bool D2a bare-alias retired (ruled-B); classifier fact = GoScalar.BoolScalar; machine-readable grounding edge open per canonical-B (grounding-worked-examples.md §0); numeric D2a rows deferred per DECISIONS.md D2-REV and resolver.dag; no D1 ops in-file.
// Anchor: https://go.dev/ref/spec
// Ledger: DECISIONS.md Part 6 (PR #3229): CP-3229-GREEN-TERMINAL.

module v4.extdeps.languages.go

import v4.std.node { Symbol }

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type SignedIntWidth
  = SignedBits8
  | SignedBits16
  | SignedBits32
  | SignedBits64
  | SignedPlatformInt

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type UnsignedIntWidth
  = UnsignedBits8
  | UnsignedBits16
  | UnsignedBits32
  | UnsignedBits64
  | UnsignedPlatformInt
  | UnsignedPointerSized

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type GoFloatWidth
  = Bits32
  | Bits64

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type GoComplexWidth
  = Bits64
  | Bits128

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type GoScalarKind
  = Int
  | Float
  | Complex
  | Bool
  | String

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type GoScalar
  = SignedIntScalar { width: SignedIntWidth }
  | UnsignedIntScalar { width: UnsignedIntWidth }
  | FloatScalar { width: GoFloatWidth }
  | ComplexScalar { width: GoComplexWidth }
  | BoolScalar
  | StringScalar

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type GoChannelDirection
  = SendRecv
  | SendOnly
  | RecvOnly

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type GoExportLocus
  = PackageBlock
  | StructField
  | MethodName

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type GoExportStatus
  = Exported { locus: GoExportLocus }
  | Unexported { locus: GoExportLocus }

type GoChannel {
  direction: GoChannelDirection
  element_type_ref: Symbol
}

type GoCost {
  instruction_cost: Int
  allocation_cost: Int
}

// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type GoBuiltinIntegerArithmeticOverflow
  = SignedTypedIntegerTruncatesSilentlyOnOverflow
  | UnsignedTypedIntegerTruncatesSilentlyOnOverflow

type GoIntegerOverflowDisposition<IRCarrier> {
  debug_default: GoBuiltinIntegerArithmeticOverflow
  release_default: GoBuiltinIntegerArithmeticOverflow
}

// 🟢 GoNever / no GoScalar bottom — DECISIONS.md §PR-3252-extdeps-deferrals (Practice 9).
