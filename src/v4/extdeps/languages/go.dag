}

fn go_primitive_axis_binding(axis: Symbol, fact: Node) -> PrimitiveFactAxisBinding {
  PrimitiveFactAxisBinding { axis: axis, fact: fact }
}

fn go_primitive_bundle_from_integer_facts(facts: GoIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: go_integer_facts_node(facts: facts),
    spec_facts: [
      go_primitive_axis_binding(
        axis: primitive_fact_axis_surface_spelling,
        fact: go_inhabitant_atom(id: facts.surface_spelling)
      ),
      go_primitive_axis_binding(
        axis: primitive_fact_axis_width,
        fact: go_integer_width_node(scalar: facts.scalar)
      ),
      go_primitive_axis_binding(
        axis: primitive_fact_axis_signedness,
        fact: go_int_kind_node(kind: go_int_kind_from_scalar(scalar: facts.scalar))
      ),
      go_primitive_axis_binding(
        axis: primitive_fact_axis_overflow_disposition,
        fact: go_overflow_node(overflow: facts.overflow)
      ),
      go_primitive_axis_binding(
        axis: primitive_fact_axis_encoding,
        fact: go_inhabitant_atom(id: facts.encoding)
      )
    ]
  }
}

