module v4.extdeps.languages.ptx




import v4.std.cardinality { NonZeroNat }
import v4.std.nat { Nat }




// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type ParamScope
  = ParamEntry
  | ParamFunc


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type SharedScope
  = SharedCta
  | SharedCluster


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type StateSpace
  = Reg
  | SReg
  | Const
  | Global
  | Local
  | Param { scope: ParamScope }
  | Shared { scope: SharedScope }
  | Tex


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type BarrierScope
  = Cta
  | Cluster
  | Gpu
  | System


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type ThreadAxis
  = X
  | Y
  | Z


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type ThreadCoordSource
  = ThreadInCta
  | CtaInCluster
  | ClusterInGrid
  | CtaInGrid


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type BitsWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Bits128


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type IntegerWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type FloatWidth
  = Bits16
  | Bits32
  | Bits64


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type RegisterScalarKind
  = Bits
  | Unsigned
  | Signed
  | Float
  | Predicate


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type RegisterStateSpace
  = ResReg
  | ResConst
  | ResGlobal
  | ResLocal
  | ResParam { scope: ParamScope }
  | ResShared { scope: SharedScope }


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type RegisterScalar
  = BitsScalar { width: BitsWidth, state_space: RegisterStateSpace }
  | UnsignedScalar { width: IntegerWidth, state_space: RegisterStateSpace }
  | SignedScalar { width: IntegerWidth, state_space: RegisterStateSpace }
  | FloatScalar { width: FloatWidth, state_space: RegisterStateSpace }
  | PredicateScalar


type Dim3 {
  x: NonZeroNat
  y: NonZeroNat
  z: NonZeroNat
}


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type ThreadHierarchyShape
  = FlatLaunch { grid_dim: Dim3, block_dim: Dim3 }
  | ImplicitClusterLaunch { grid_dim: Dim3, block_dim: Dim3 }
  | ExplicitClusterLaunch { cluster_grid_dim: Dim3, cluster_dim: Dim3, block_dim: Dim3 }


type ThreadCoord {
  source: ThreadCoordSource
  axis: ThreadAxis
}


type PtxCost {
  instruction_cost: Nat
  occupancy_cost: Nat
}
