// src/v4/extdeps/languages/ptx.dag
// Scope: NVIDIA PTX ISA 8.5 SIMT structural classifiers (T-4.14).
// Anchor: https://docs.nvidia.com/cuda/parallel-thread-execution/index.html
// Owns:
//   ParamScope
//   SharedScope
//   StateSpace
//   BarrierScope
//   ThreadAxis
//   ThreadCoordSource
//   BitsWidth
//   IntegerWidth
//   FloatWidth
//   RegisterScalarKind
//   RegisterStateSpace
//   RegisterScalar
//   Dim3
//   ThreadHierarchyShape
//   ThreadCoord
//   PtxCost
// Consumes: (none; Int kernel-ambient).
// Status: T-4.14 PASS (IN-B).

module v4.extdeps.languages.ptx




type ParamScope
  = ParamEntry
  | ParamFunc


type SharedScope
  = SharedCta
  | SharedCluster


type StateSpace
  = Reg
  | SReg
  | Const
  | Global
  | Local
  | Param { scope: ParamScope }
  | Shared { scope: SharedScope }
  | Tex


type BarrierScope
  = Cta
  | Cluster
  | Gpu
  | System


type ThreadAxis
  = X
  | Y
  | Z


type ThreadCoordSource
  = ThreadInCta
  | CtaInCluster
  | ClusterInGrid
  | CtaInGrid


type BitsWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Bits128


type IntegerWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64


type FloatWidth
  = Bits16
  | Bits32
  | Bits64


type RegisterScalarKind
  = Bits
  | Unsigned
  | Signed
  | Float
  | Predicate


type RegisterStateSpace
  = ResReg
  | ResConst
  | ResGlobal
  | ResLocal
  | ResParam { scope: ParamScope }
  | ResShared { scope: SharedScope }


type RegisterScalar
  = BitsScalar { width: BitsWidth, state_space: RegisterStateSpace }
  | UnsignedScalar { width: IntegerWidth, state_space: RegisterStateSpace }
  | SignedScalar { width: IntegerWidth, state_space: RegisterStateSpace }
  | FloatScalar { width: FloatWidth, state_space: RegisterStateSpace }
  | PredicateScalar


type Dim3 {
  x: Int
  y: Int
  z: Int
}


type ThreadHierarchyShape
  = FlatLaunch { grid_dim: Dim3, block_dim: Dim3 }
  | ImplicitClusterLaunch { grid_dim: Dim3, block_dim: Dim3 }
  | ExplicitClusterLaunch { cluster_grid_dim: Dim3, cluster_dim: Dim3, block_dim: Dim3 }


type ThreadCoord {
  source: ThreadCoordSource
  axis: ThreadAxis
}


type PtxCost {
  instruction_cost: Int
  occupancy_cost: Int
}
