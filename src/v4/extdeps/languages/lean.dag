// src/v4/extdeps/languages/lean.dag
// Scope: Lean 4 language model for PROOF-1 termination export.
// Owns: LeanDeclarationKind, LeanName, LeanLevel, LeanLevelRef, LeanLevelNode, LeanBinderInfo, LeanBinder, LeanTermRef, LeanTermNode, LeanTermForm, LeanMatchAlternative, LeanTerminationMeasure, LeanTerminationBy, LeanDecreasingProof, LeanTerminationClause, LeanDefinitionTermination, LeanProofArtifact, LeanFidelityFeature, LeanFidelityDisposition, LeanProofCheckSemantics, LeanKernelInductiveBoolWitness, LeanNatMathematicalUnboundedWitness, LeanIntMathematicalUnboundedWitness, LeanPointerSizedNaturalPerTargetWitness, LeanUnsignedFixedWidthModularWitness, LeanUInt8Width8Witness, LeanUInt16Width16Witness, LeanUInt32Width32Witness, LeanUInt64Width64Witness, LeanBool, LeanNat, LeanInt, LeanUSize, LeanUInt8, LeanUInt16, LeanUInt32, LeanUInt64.
// Consumes: Int, UInt8, UInt16, UInt32, UInt64, UIntPlatform, List, Bool, Nat, Symbol.
// Status: D2-REV — Lean 4 kernel / fixed-precision primitives as fact-bundles (DECISIONS.md P4-3208 / #3208).

module v4.extdeps.languages.lean


import v4.std.integer {
  Int,
  UInt8,
  UInt16,
  UInt32,
  UInt64,
  UIntPlatform
}
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.nat { Nat }
import v4.std.node { Symbol }


// Anchor: https://lean-lang.org/doc/reference/4.20.0/
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanDeclarationKind
  = LeanDef
  | LeanTheorem
  | LeanInductive
  | LeanStructure
  | LeanAxiom


// Anchor: https://lean-lang.org/doc/reference/4.20.0/Basic-Types/Identifiers/
type LeanName {
  namespace: List<Symbol>
  local: Symbol
}


// Anchor: https://lean-lang.org/doc/reference/4.20.0/The-Type-System/Universes/
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanLevel
  = LeanLevelZero
  | LeanLevelSucc { predecessor: LeanLevelRef }
  | LeanLevelMax { left: LeanLevelRef, right: LeanLevelRef }
  | LeanLevelIMax { left: LeanLevelRef, right: LeanLevelRef }
  | LeanLevelParam { name: Symbol }


type LeanLevelRef {
  name: LeanName
}


type LeanLevelNode {
  name: LeanName
  level: LeanLevel
}


// Anchor: https://lean-lang.org/doc/reference/4.20.0/Terms/Functions/
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanBinderInfo
  = ExplicitBinder
  | ImplicitBinder
  | StrictImplicitBinder
  | InstanceImplicitBinder


type LeanBinder {
  name: LeanName
  type: LeanTermRef
  info: LeanBinderInfo
}


// Anchor: https://lean-lang.org/doc/reference/4.20.0/
type LeanTermRef {
  name: LeanName
}


type LeanTermNode {
  name: LeanName
  form: LeanTermForm
}


// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanTermForm
  = LeanSort { level: LeanLevelRef }
  | LeanConst { name: LeanName, levels: List<LeanLevelRef> }
  | LeanVar { name: LeanName }
  | LeanApp { function: LeanTermRef, argument: LeanTermRef }
  | LeanLambda { binder: LeanBinder, body: LeanTermRef }
  | LeanForall { binder: LeanBinder, body: LeanTermRef }
  | LeanLet { binder: LeanBinder, value: LeanTermRef, body: LeanTermRef }
  | LeanMatch { scrutinee: LeanTermRef, alternatives: List<LeanMatchAlternative> }


type LeanMatchAlternative {
  constructor: LeanName
  binders: List<LeanBinder>
  body: LeanTermRef
}


// Anchor: https://lean-lang.org/doc/reference/4.20.0/Definitions/Recursive-Definitions/
type LeanTerminationMeasure {
  subject: LeanName
  measure: LeanTermRef
}


// Anchor: https://lean-lang.org/doc/reference/4.20.0/Definitions/Recursive-Definitions/
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanTerminationBy
  = LeanStructuralTermination { decreasing_parameter: LeanName }
  | LeanWellFoundedTermination { measure: LeanTerminationMeasure }


type LeanDecreasingProof {
  proof: LeanTermRef
}


// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanTerminationClause
  = LeanTerminationByClause { termination: LeanTerminationBy }
  | LeanDecreasingBy { proof: LeanDecreasingProof }


// Anchor: https://lean-lang.org/doc/reference/4.20.0/Definitions/Recursive-Definitions/
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanDefinitionTermination
  = LeanNoExplicitTermination
  | LeanTerminationByOnly { termination: LeanTerminationBy }
  | LeanDecreasingByOnly { proof: LeanDecreasingProof }
  | LeanTerminationByWithDecreasingBy {
      termination: LeanTerminationBy,
      proof: LeanDecreasingProof
    }


// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanProofArtifact
  = LeanTheoremProofArtifact {
      name: LeanName,
      type: LeanTermRef,
      proof: LeanTermRef
    }
  | LeanDefinitionTerminationArtifact {
      name: LeanName,
      type: LeanTermRef,
      body: LeanTermRef,
      termination: LeanDefinitionTermination
    }


// Anchor: https://lean-lang.org/doc/reference/4.20.0/
// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanFidelityFeature
  = LeanKernelTerm
  | LeanPrettyNameSpelling
  | LeanWhitespaceAndLayout
  | LeanTacticScript
  | LeanElaboratorOnlySyntax
  | LeanUnresolvedUniverseLevel
  | LeanUnsupportedTheoremClass


// 🟢 coproduct dissolution — DECISIONS.md P4-3208
type LeanFidelityDisposition
  = LeanModeled
  | LeanDeclaredNormalized { feature: LeanFidelityFeature }
  | LeanFailClosed { feature: LeanFidelityFeature }


fn lean_feature_disposition(f: LeanFidelityFeature) -> LeanFidelityDisposition {
  match f {
    LeanKernelTerm => LeanModeled
    LeanPrettyNameSpelling => LeanDeclaredNormalized { feature: LeanPrettyNameSpelling }
    LeanWhitespaceAndLayout => LeanDeclaredNormalized { feature: LeanWhitespaceAndLayout }
    LeanTacticScript => LeanFailClosed { feature: LeanTacticScript }
    LeanElaboratorOnlySyntax => LeanFailClosed { feature: LeanElaboratorOnlySyntax }
    LeanUnresolvedUniverseLevel => LeanFailClosed { feature: LeanUnresolvedUniverseLevel }
    LeanUnsupportedTheoremClass => LeanFailClosed { feature: LeanUnsupportedTheoremClass }
  }
}


// Anchor: https://lean-lang.org/doc/reference/4.20.0/
type LeanProofCheckSemantics<IRCarrier> {
  kernel_definitional_reduction: Bool
  opaque_axiom_boundary: Bool
  proof_irrelevance_for_propositions: Bool
}


// Ledger: DECISIONS.md D2-REV + P4-3208 — Lean 4 kernel / fixed-precision
// numeric carriers as fact-bundles (spec witnesses + std `canon`), not bare aliases.
// Anchor: https://lean-lang.org/doc/reference/4.20.0/Basic-Types/Fixed-Precision-Integers/
type LeanKernelInductiveBoolWitness {}

type LeanBool {
  canon: Bool
  kernel_form: LeanKernelInductiveBoolWitness
}

type LeanNatMathematicalUnboundedWitness {}

type LeanNat {
  canon: Nat
  specification: LeanNatMathematicalUnboundedWitness
}

type LeanIntMathematicalUnboundedWitness {}

type LeanInt {
  canon: Int
  specification: LeanIntMathematicalUnboundedWitness
}

type LeanPointerSizedNaturalPerTargetWitness {}

type LeanUSize {
  canon: UIntPlatform
  specification: LeanPointerSizedNaturalPerTargetWitness
}

type LeanUnsignedFixedWidthModularWitness {}

type LeanUInt8Width8Witness {}

type LeanUInt8 {
  modular_semantics: LeanUnsignedFixedWidthModularWitness
  width: LeanUInt8Width8Witness
  canon: UInt8
}

type LeanUInt16Width16Witness {}

type LeanUInt16 {
  modular_semantics: LeanUnsignedFixedWidthModularWitness
  width: LeanUInt16Width16Witness
  canon: UInt16
}

type LeanUInt32Width32Witness {}

type LeanUInt32 {
  modular_semantics: LeanUnsignedFixedWidthModularWitness
  width: LeanUInt32Width32Witness
  canon: UInt32
}

type LeanUInt64Width64Witness {}

type LeanUInt64 {
  modular_semantics: LeanUnsignedFixedWidthModularWitness
  width: LeanUInt64Width64Witness
  canon: UInt64
}
