// ─────────────────────────────────────────────────────────────────────
// ParameterAssignment — one (name, default-value) pair in a
// parameter_declaration's list_of_param_assignments (IEEE 1364-2005
// §A.2.4 / §3.10). A single declaration like `parameter WIDTH = 8,
// DEPTH = 16;` carries TWO ParameterAssignments. Conj record (no
// Practice-4 ledger).
//
//   - name              the parameter identifier (K-1-opaque Symbol)
//   - default_lexeme    the default value as a verbatim expression
//                       lexeme; per spec every parameter declaration
//                       requires a default value (unlike net/variable
//                       decls), so this field is non-empty in a
//                       well-formed declaration. Sub-grammar deferred
//                       to T-4 LanguageModel.
type ParameterAssignment {
  name: Symbol
  default_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// ParameterDeclaration — a Verilog compile-time constant declaration
// (`parameter WIDTH = 8;`, `parameter signed [3:0] X = 4'sb1100;`,
// `parameter integer N = 4;`, `parameter WIDTH = 8, DEPTH = 16;`).
// IEEE 1364-2005 §3.10 / §A.2.1.1. Conj record (no Practice-4
// ledger).
//
//   - type_kind        which parameter-type form (ParameterTypeKind
//                      Disj — UntypedParameter carries packing +
//                      signedness; the typed forms IntegerParameter
//                      / RealParameter / TimeParameter /
//                      RealTimeParameter carry neither per spec
//                      §A.2.1.1).
//   - assignments      the list_of_param_assignments — each
//                      ParameterAssignment carries name +
//                      default_lexeme. Per spec a parameter
//                      declaration must have at least one assignment.
//
// Multi-assignment + type_kind added per codex BLOCKING on PR #3176
// 2026-05-16 — the prior {name, default_lexeme} shape collapsed the
// spec's type/range/signedness facts that govern §12.1.3 override
// conversion (when an instantiation #(...) overrides a parameter,
// the spec defines conversion semantics based on the declared type;
// without these facts the conversion is unspecified).
type ParameterDeclaration {
  type_kind: ParameterTypeKind
  // 🟡 spec-non-empty (§A.2.1.1) — deferred to std/collection.dag
  // Wave-A2 refinement; see shared TRACKED-SCAFFOLD note above.
  assignments: List<ParameterAssignment>
}


// ─────────────────────────────────────────────────────────────────────
// SensitivityItem — one entry in an always-block's event-control list
// (`posedge clk`, `negedge rst`, `posedge (a & b)`, bare expression).
// IEEE 1364-2005 §9.7.2. Conj record (no Practice-4 ledger).
//
//   - trigger                   which edge / level-sensitivity
//   - event_expression_lexeme   the expression the trigger watches
//                               as a verbatim lexeme. Per spec
//                               §9.7.2 the event_expression can be
//                               ANY expression (identifier, bit-
//                               select, arithmetic combination), not
//                               just a bare identifier — corrected
//                               2026-05-16 per codex BLOCKING on
//                               PR #3176 (the prior `signal: Symbol`
//                               narrowed event expressions to
//                               identifier references, excluding
//                               valid syntax). Sub-grammar deferred
//                               to the T-4 LanguageModel via the
//                               established body_lexeme precedent.
type SensitivityItem {
  trigger: EdgeTrigger
  event_expression_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// NetAssignment — one (net_lvalue, expression) pair in a
// continuous_assign's list_of_net_assignments (IEEE 1364-2005 §6.1 +
// §A.6.1). A single `assign net1 = expr1, net2 = expr2;` carries TWO
// NetAssignments. Conj record (no Practice-4 ledger).
//
//   - lhs_lexeme       the destination net_lvalue as a verbatim
//                      lexeme (identifier ref, bit/part-select, or
//                      concatenation/replication of net_lvalues per
//                      §6.1). Sub-grammar deferred to T-4
//                      LanguageModel.
//   - rhs_lexeme       the right-hand-side expression as a verbatim
//                      lexeme.
type NetAssignment {
  lhs_lexeme: String
  rhs_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// ContinuousAssign — a Verilog continuous-assignment statement
// (`assign net = expr;`, `assign (strong0, weak1) #5 a = e1, b = e2;`).
// IEEE 1364-2005 §6.1 + §A.6.1. Conj record (no Practice-4 ledger).
//
// Per spec §6.1 a continuous_assign carries an optional drive_strength,
// an optional delay3, and a non-empty list_of_net_assignments —
// declaration-boundary facts the prior single-(lhs,rhs)-pair shape
// collapsed (codex BLOCKING on PR #3176 2026-05-16).
//
//   - drive_strength   optional drive_strength clause (`(strong0,
//                      weak1)`); reuses the DriveStrengthClause Disj
//                      shared with NetDeclaration.
//   - delay            optional delay3 clause (`#5`, `#(2:3:4)`);
//                      reuses the DelayClause Disj shared with
//                      NetDeclaration.
//   - assignments      the list_of_net_assignments per spec §A.6.1
//                      — each NetAssignment carries a net_lvalue
//                      lexeme + expression lexeme.
type ContinuousAssign {
  drive_strength: DriveStrengthClause
  delay: DelayClause
  // ContinuousAssign.assignments: 🟡 spec-non-empty (§6.1) —
  // deferred to std/collection.dag Wave-A2 `List<T> where non_empty`
  // refinement; see shared TRACKED-SCAFFOLD note above.
  assignments: List<NetAssignment>
}


// ─────────────────────────────────────────────────────────────────────
// AlwaysBlock — a Verilog `always @(...)` block (IEEE 1364-2005 §9.9).
// Conj record (no Practice-4 ledger).
//
//   - sensitivity    the event-control specification (closed Disj
//                    over the three IEEE 1364-2005 §9.7.2 forms:
//                    no event control / implicit `@*` / explicit
//                    event list)
//   - body_lexeme    the procedural body (begin…end or single
//                    statement) as a verbatim lexeme (sub-grammar
//                    deferred to the T-4 LanguageModel expression /
//                    statement productions; `parse ∘ emit` is
//                    identity on the textual surface)
//
// Per the IN-B PROBE FINDING above, this carrier IS the Loop-step +
// Bind-chain unit: the always-block's ONE TRIGGER is a bounded step
// (A2 footnote); the iteration across triggers is the simulator/
// synthesizer's coordination boundary; the sequential composition of
// statements inside the body is the Bind chain.
type AlwaysBlock {
  sensitivity: AlwaysBlockSensitivity
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// AlwaysBlockSensitivity — the closed Verilog event-control
// classifier for an `always` block (IEEE 1364-2005 §9.7.2). The spec
// admits exactly THREE event-control forms; modeling sensitivity as
// `List<SensitivityItem>` collapsed the implicit `@*` form with both
// "no event control" (empty list) and "explicit event list" (non-
// empty) — the codex BLOCKING review on PR #3176 surfaced the gap.
// This Disj-with-named-payloads makes each form structurally distinct
// per INVARIANTS P1 modeling-faithfulness + P2 single-authority.
//
//   - NoEventControl         — bare `always begin ... end` with no
//                              `@(...)` — the body uses internal
//                              delay control (`#10 ...`) for timing.
//                              Rare in practice; legal per spec.
//   - ImplicitAtStar         — `always @*` or `always @(*)` —
//                              implicit sensitivity list covering
//                              ALL signals read in the body (the
//                              §9.7.2 implicit-event-control form;
//                              recommended for combinational logic
//                              to avoid manual list errors). The
//                              implicit set is COMPUTED FROM THE
//                              BODY at synthesis / simulation time;
//                              this variant carries no payload —
//                              the body itself is the authority for
//                              which signals trigger the always.
//   - ExplicitEventList      — `always @(event_expression)` —
//                              explicit list of edge-triggered or
//                              level-sensitive entries (`posedge
//                              clk, negedge rst, data`). The
//                              `items` payload is the list of
//                              `SensitivityItem` entries.
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §9.7.2 admits exactly
// these three event-control forms; a fourth would be a future
// language-version change requiring edit under the L-2 pin
// discipline.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every always-block consumer (the
//      synthesis dispatch for flip-flop vs latch vs combinational
//      inference, the implicit-set-from-body extraction, the
//      explicit-list emission) branches on the form uniformly;
//      shared classifier, not scattered.
//   2. Variant-is-data — FAILS: collapsing to
//      `{ items: List<SensitivityItem> }` (the prior model)
//      conflates NoEventControl (empty list) with ExplicitEventList
//      (empty list is technically possible) AND has NO
//      representation for ImplicitAtStar — exactly the codex
//      BLOCKING finding. The Disj-with-heterogeneous-payloads is
//      the dissolution: each variant carries exactly the structural
//      data its form admits.
//   3. Algebraic form — N/A by construction: the three forms are
//      the IEEE 1364-2005 spec's primitive event-control partition;
//      they do not trace to a richer std/ algebraic structure.
//   4. Dimensional — FAILS: a single `always` block has EXACTLY
//      ONE event-control form; mutually-exclusive alternatives
//      (per spec: a single `always` cannot have both an implicit
//      and explicit list).
//   5. Parameterized family — FAILS: the three variants carry
//      structurally heterogeneous payloads (NoEventControl is
//      nullary; ImplicitAtStar is a nullary marker — the implicit
//      set is computed from the body, not stored; ExplicitEventList
//      carries a `List<SensitivityItem>`) — NOT one generic `F<X>`
//      / projection over a separately-declared source set
//      (Practice 7).
// Terminal: the closed three-way Verilog always-block event-control
// classifier of the IEEE 1364-2005 spec.
type AlwaysBlockSensitivity
  = NoEventControl
  | ImplicitAtStar
  // ExplicitEventList.items: 🟡 spec-non-empty (§9.7.2) — deferred to
  // std/collection.dag Wave-A2 refinement; see shared TRACKED-SCAFFOLD
  // note above. (NoEventControl already covers the no-`@(...)` form.)
  | ExplicitEventList { items: List<SensitivityItem> }


// ─────────────────────────────────────────────────────────────────────
// InitialBlock — a Verilog `initial` block (IEEE 1364-2005 §9.9).
// Executes its body ONCE at simulation time 0. Conj record (no
// Practice-4 ledger).
//
//   - body_lexeme    the procedural body as a verbatim lexeme (sub-
//                    grammar deferred — same shape as `AlwaysBlock.
//                    body_lexeme`)
//
// `initial` is admitted here for the simulation-time-zero
// initialization case (the synthesizable-subset uses register-reset
// in `always @(posedge clk)` blocks instead); per the PROBE LIMITS
// header note the testbench-only `$display` / `$finish` system tasks
// inside `initial` are out of scope.
type InitialBlock {
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// PortConnectionActual — the closed Verilog port-connection-actual
// classifier (IEEE 1364-2005 §12.1.2). The spec admits a port-
// connection's actual to be any of three forms: a full expression
// (including identifier references, literals, bit-selects, arithmetic
// — `.en(1'b1)`, `.data(bus[3:0])`, `.sum(a + b)`), or BLANK (an
// explicitly unconnected port — `.unused()`). Modeling the actual as
// a bare `Symbol` (the prior form) narrowed it to identifier
// references only, excluding valid IEEE 1364-2005 syntax — openai-pro
// REQUEST_CHANGES on PR #3176 surfaced this gap. INVARIANTS P1
// modeling-faithfulness violation (the spec's port-connection-actual
// partition is wider than just identifiers).
//
//   - ExpressionConnection { expression_lexeme: String }
//       — the connection-actual is a Verilog expression carried as
//       a verbatim lexeme (sub-grammar deferred to the T-4
//       LanguageModel grammar productions; the spice.dag
//       `SpiceValue.lexeme` precedent — `parse ∘ emit` is identity
//       on the textual surface; the expression-typed-fact lands
//       when the bundled expression productions land). Covers
//       identifier references (`.en(clk)`), literals (`.en(1'b1)`),
//       bit-selects (`.data(bus[3:0])`), and arithmetic
//       (`.sum(a + b)`).
//   - BlankConnection
//       — `.port_name()` — an explicitly unconnected port (spec
//       §12.1.2 admits this form for documenting that a named port
//       is intentionally left unconnected); nullary marker.
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §12.1.2 admits these two
// actual-forms; a third would be an edit to THIS declaration under
// the L-2 pin discipline.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every port-connection emitter and
//      every dependency-graph walker reads the actual form
//      uniformly (a blank connection contributes no dependency; a
//      non-blank actual contributes the expression's signal
//      references); shared classifier, not scattered.
//   2. Variant-is-data — FAILS: collapsing to `{ expression_lexeme:
//      String }` where blank = empty-string conflates "intentionally
//      blank" with "expression is empty string" (the lexeme `""` is
//      not a valid Verilog expression); the Disj-with-named-payloads
//      makes blank vs expression structurally distinct.
//   3. Algebraic form — N/A by construction: the two actual-forms
//      are the IEEE 1364-2005 spec's port-connection-actual partition;
//      they do not trace to a richer std/ algebraic structure.
//   4. Dimensional — FAILS: a single port-connection actual is
//      EXACTLY ONE form; mutually-exclusive alternatives.
//   5. Parameterized family — FAILS: ExpressionConnection carries a
//      lexeme payload; BlankConnection is nullary — structurally
//      heterogeneous, NOT one generic `F<X>` / projection over a
//      separately-declared source set (Practice 7). The expression
//      sub-grammar is owned by the bundled T-4 LanguageModel; this
//      vocabulary slice declares the actual-form partition only.
// Terminal: the closed two-way Verilog port-connection-actual
// classifier; the expression sub-grammar is deferred to T-4
// LanguageModel.
type PortConnectionActual
  = ExpressionConnection { expression_lexeme: String }
  | BlankConnection


// ─────────────────────────────────────────────────────────────────────
// OrderedPortConnection — one element of a positional port-binding
// list (IEEE 1364-2005 §A.4.1.1):
//
//   ordered_port_connection ::= { attribute_instance } [ expression ]
//
// The §A.4.1.1 grammar places the attribute_instance prefix at the
// ordered_port_connection element level — the same level where
// named_port_connection carries its attribute prefix. The earlier
// shape (sha cba903a3e) put attributes ON each PortConnectionActual
// variant, which then double-authoritied named connections
// (NamedPortConnection.attributes + actual.attributes both present
// for one syntactic binding) — openai-pro REQUEST_CHANGES on
// PR #3176 sha 4ccc6267 flagged the double-authority. Resolution:
// strip attributes from PortConnectionActual (the inner blank-vs-
// expression Disj is shared between ordered and named forms;
// attributes live at the OUTER wrapping level) and wrap the
// positional case in this OrderedPortConnection Conj that mirrors
// NamedPortConnection's outer-attribute placement.
// Conj record (no Practice-4 ledger).
//
//   - attributes   the optional attribute_instance prefix per
//                  §A.4.1.1 (reuses AttributeInstanceClause).
//   - actual       the connection's expression-or-blank inner form
//                  (PortConnectionActual).
type OrderedPortConnection {
  attributes: AttributeInstanceClause
  actual: PortConnectionActual
}


// ─────────────────────────────────────────────────────────────────────
// NamedPortConnection — one named connection in a module-instance's
// port-binding list (IEEE 1364-2005 §12.1.2, named form). Conj record
// (no Practice-4 ledger).
//
//   - port      the formal port name on the instantiated module
//               (K-1-opaque Symbol; resolved through the namespace
//               to the matching `PortDeclaration` on the target
//               module)
//   - actual    the connection's actual value — an expression
//               (carried as a verbatim lexeme per the closed
//               PortConnectionActual classifier above) or a blank
//               `.port_name()` marker. The prior `signal: Symbol`
//               narrowed this to identifier references only —
//               corrected per openai-pro REQUEST_CHANGES on
//               PR #3176 to admit the full spec-mandated set of
//               expression actuals + blank.
type NamedPortConnection {
  attributes: AttributeInstanceClause
  port: Symbol
  actual: PortConnectionActual
}


// ─────────────────────────────────────────────────────────────────────
// PortConnections — the closed Verilog port-binding-list form
// classifier (IEEE 1364-2005 §12.1.2 / §A.4.1.1). The spec admits
// THREE forms per the §A.4.1.1 grammar:
//
//   module_instance ::= name_of_instance ( [list_of_port_connections] ) ;
//   list_of_port_connections ::=
//       ordered_port_connection { , ordered_port_connection }
//     | named_port_connection { , named_port_connection }
//
// where the `[list_of_port_connections]` brackets make the entire
// connection list OPTIONAL (`Adder a1 ();` — empty parens — is legal
// spec syntax), and when present the inner list is a NON-EMPTY list
// of ordered_port_connection OR a NON-EMPTY list of named_port_
// connection — mixing the two is forbidden (`Adder a1 (x, .b(y))`
// is a syntax error).
//
// The empty `()` form is modeled as a STRUCTURAL `NoPortConnections`
// variant rather than as an `[]` empty list inside either of the
// other two variants — otherwise the empty connection-list state is
// representable TWO ways (positional-empty vs named-empty) and
// violates INVARIANTS P2 representation-duality (openai-pro
// REQUEST_CHANGES on PR #3176 2026-05-16 at line 2156). Sibling
// non-empty lists ride the established RQ-3 / std/collection.dag
// Wave-A2 `List<T> where non_empty` deferral (see shared TRACKED-
// SCAFFOLD note above).
//
//   - NoPortConnections        — `Adder a1 ();` — empty parens; the
//                                spec's "[list_of_port_connections]"
//                                bracket-absent form.
//   - PositionalConnections    — `Adder a1 (sig1, sig2, sig3)` —
//                                actuals listed in declaration-order
//                                position; the i-th signal binds to
//                                the i-th port. Spec §12.1.2
//                                "Ordered port connections". The
//                                `actuals` list is spec-non-empty.
//   - NamedConnections         — `Adder a1 (.a(x), .b(y), .sum(z))`
//                                — actuals explicitly bound to
//                                formals by name. Spec §12.1.2
//                                "Named port connections". The
//                                `connections` list is spec-non-empty.
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §A.4.1.1 admits exactly
// these three forms; a fourth would be an edit to THIS declaration
// under the L-2 pin discipline (SystemVerilog adds `.port` shorthand
// for `.port(port)` and `.*` for "connect all matching names" — a
// future language-version model would EDIT this Disj explicitly).
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every instance-emission consumer and
//      every port-binding resolver reads the connection form
//      uniformly to know whether to emit `()`, align by position,
//      or align by name; shared classifier, not scattered.
//   2. Variant-is-data — FAILS: collapsing the variants to a uniform
//      `List<PortConnectionEntry>` where each entry has `kind: Form`
//      ratifies the illegal state "mixed positional+named within
//      one instance" — exactly the spec-forbidden form. Replacing
//      `NoPortConnections` with empty inner lists ratifies the
//      double-spelling of `()`. Disj-with-heterogeneous-payloads-
//      plus-nullary-empty-variant makes both partitions structural.
//   3. Algebraic form — N/A by construction: the three forms are
//      the IEEE 1364-2005 §A.4.1.1 spec's primitive port-connection
//      partition; they do not trace to a richer std/ algebraic
//      structure.
//   4. Dimensional — FAILS: a single module instance is EXACTLY
//      ONE form; mutually-exclusive alternatives. (Mixed-form and
//      multi-form-per-instance are syntax errors per spec.)
//   5. Parameterized family — FAILS: the three variants carry
//      structurally heterogeneous payloads (NoPortConnections is
//      nullary; PositionalConnections carries
//      `List<PortConnectionActual>`; NamedConnections carries
//      `List<NamedPortConnection>`) — NOT one generic `F<X>`
//      projection over a separately-declared source set
//      (Practice 7).
// Terminal: the closed three-way Verilog port-connection-form
// classifier of the IEEE 1364-2005 §A.4.1.1 spec.
type PortConnections
  = NoPortConnections
  | PositionalConnections {
      // 🟡 spec-non-empty (§A.4.1.1 ordered_port_connection list) —
      // deferred to std/collection.dag Wave-A2 `List<T> where
      // non_empty` refinement; see shared TRACKED-SCAFFOLD note above.
      actuals: List<OrderedPortConnection>
    }
  | NamedConnections {
      // 🟡 spec-non-empty (§A.4.1.1 named_port_connection list) —
      // deferred to std/collection.dag Wave-A2 `List<T> where
      // non_empty` refinement; see shared TRACKED-SCAFFOLD note above.
      connections: List<NamedPortConnection>
    }


// ─────────────────────────────────────────────────────────────────────
// ParameterOverrideActual — the closed Verilog named-parameter-
// override actual classifier (IEEE 1364-2005 §A.4.1 named_parameter_
// assignment). Per spec grammar:
//
//   named_parameter_assignment ::= . parameter_identifier
//                                  ( [ mintypmax_expression ] )
//
// the `[ mintypmax_expression ]` brackets make the actual OPTIONAL —
// `.PARAM()` (blank parens) is legal spec syntax that documents the
// override list while retaining the parameter's declared default
// value. Modeling the actual as a mandatory String collapsed the
// spec's blank-actual form, making `.WIDTH()` unrepresentable
// (openai-pro REQUEST_CHANGES on PR #3176 2026-05-16 at line 2161).
// Sibling Disj of PortConnectionActual.BlankConnection — same shape
// for the same "optional sub-expression in a named binding" axis.
//
//   - BlankParameterOverride
//       — `.PARAM()` form: blank parens; retains the declared
//       default.
//   - ParameterOverrideExpression { lexeme: String }
//       — `.PARAM(expr)` form: the override value as a verbatim
//       mintypmax_expression lexeme; sub-grammar deferred to the
//       bundled T-4 LanguageModel.
//
// CLOSED (C1 stop-signal). Two-way present/absent partition.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted: same shape
// as PortConnectionActual.BlankConnection; abbreviated for brevity
// (each pattern's argument is identical modulo "named-parameter"
// vs "ordered port-connection").
//   1. Fact placement — FAILS: shared across instance-emission +
//      parameter-resolution consumers.
//   2. Variant-is-data — FAILS: empty-string sentinel rejected
//      (same BlankConnection precedent argument).
//   3. Algebraic form — N/A by construction.
//   4. Dimensional — FAILS: one actual state per binding.
//   5. Parameterized family — FAILS: BlankParameterOverride is
//      nullary; ParameterOverrideExpression carries a `lexeme:
//      String` payload — structurally heterogeneous (Practice 7).
// Terminal: the closed two-way Verilog named-parameter-override-
// actual classifier.
type ParameterOverrideActual
  = BlankParameterOverride
  | ParameterOverrideExpression { lexeme: String }


// ─────────────────────────────────────────────────────────────────────
// NamedParameterOverride — one named parameter override on a module
// instantiation (`.WIDTH(8)`, `.PARAM()`). IEEE 1364-2005 §12.1.3 /
// §A.4.1. Conj record (no Practice-4 ledger).
//
//   - parameter    the formal parameter name on the instantiated
//                  module (K-1-opaque Symbol; resolves to a matching
//                  ParameterDeclaration on the target module).
//   - actual       the override value as a closed Disj over the
//                  blank-vs-lexeme spec choice (ParameterOverrideActual
//                  above). Replaces the prior mandatory-String shape
//                  that collapsed the `.PARAM()` blank-actual form
//                  per openai-pro REQUEST_CHANGES on PR #3176
//                  2026-05-16.
type NamedParameterOverride {
  parameter: Symbol
  actual: ParameterOverrideActual
}


// ─────────────────────────────────────────────────────────────────────
// ParameterOverrides — the closed Verilog module-instance parameter-
// override classifier (IEEE 1364-2005 §12.1.3). A module
// instantiation can override the instantiated module's parameter
// declarations via the `#(...)` syntax (`Adder #(.WIDTH(8)) a1
// (.a(x), .b(y))` named form, or `Adder #(8) a1 (x, y)` ordered
// form), or omit overrides entirely. The spec admits three mutually-
// exclusive forms; modeling parameter-overrides as omitted (the prior
// ModuleInstance shape) excluded valid Verilog syntax that
// parameterized instantiations depend on (codex BLOCKING review on
// PR #3176). INVARIANTS P1 modeling-faithfulness violation.
//
//   - NoParameterOverrides
//       — `Adder a1 (.a(x), .b(y))` — no `#(...)` clause; the
//       instantiated module uses its declared default-parameter
//       values.
//   - OrderedParameterOverrides { actuals: List<String> }
//       — `Adder #(8, 16) a1 (...)` — overrides listed in
//       declaration-order position; the i-th actual overrides the
//       i-th parameter of the instantiated module. Each actual is a
//       verbatim expression lexeme.
//   - NamedParameterOverrides { overrides: List<NamedParameterOverride> }
//       — `Adder #(.WIDTH(8), .DEPTH(16)) a1 (...)` — overrides
//       explicitly bound to formals by name.
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §12.1.3 admits exactly
// these three parameter-override forms; mixing ordered and named
// within one `#(...)` clause is a syntax error per spec — the Disj-
// with-named-payloads makes that uniform-form choice structural
// (same shape as PortConnections).
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every instance-emission consumer and
//      every parameter-resolution walker reads the override form
//      uniformly; shared classifier, not scattered.
//   2. Variant-is-data — FAILS: collapsing the three forms to a
//      uniform `{ named?: List<...>, ordered?: List<...> }` ratifies
//      "both named and ordered in one clause" — exactly the spec-
//      forbidden mixed form. The Disj makes per-instance uniformity
//      structural.
//   3. Algebraic form — N/A by construction: the three forms are
//      the IEEE 1364-2005 spec's parameter-override partition; they
//      do not trace to a richer std/ algebraic structure.
//   4. Dimensional — FAILS: a single module instance has EXACTLY
//      ONE parameter-override form; mutually-exclusive alternatives.
//   5. Parameterized family — FAILS: NoParameterOverrides is
//      nullary; OrderedParameterOverrides carries
//      `List<String>` (verbatim expression lexemes by position);
//      NamedParameterOverrides carries `List<NamedParameterOverride>`
//      (each with formal + actual) — structurally heterogeneous,
//      NOT one generic `F<X>` / projection over a single source set
//      (Practice 7).
// Terminal: the closed three-way Verilog module-instance parameter-
// override classifier of the IEEE 1364-2005 spec.
type ParameterOverrides
  = NoParameterOverrides
  // OrderedParameterOverrides.actuals: 🟡 spec-non-empty (§12.1.3) —
  // deferred to std/collection.dag Wave-A2 `List<T> where non_empty`
  // refinement; see shared TRACKED-SCAFFOLD note above.
  // (NoParameterOverrides covers the omitted-clause form, so an
  // empty present-clause is structurally redundant AND spec-illegal.)
  | OrderedParameterOverrides { actuals: List<String> }
  // NamedParameterOverrides.overrides: 🟡 spec-non-empty (§12.1.3) —
  // deferred to std/collection.dag Wave-A2 `List<T> where non_empty`
  // refinement; see shared TRACKED-SCAFFOLD note above.
  | NamedParameterOverrides { overrides: List<NamedParameterOverride> }


// ─────────────────────────────────────────────────────────────────────
// InstanceRangeClause — the closed Verilog instance-array range
// classifier on a module / UDP instance (IEEE 1364-2005 §A.4.1.1 /
// §A.5.2): a single instance identifier may optionally carry a
// `[msb:lsb]` range to declare an ARRAY of instances (`Adder a[7:0]
// (...)`), elaborated to multiple bit-replicated instances at compile
// time. Sibling Disj of DriveStrengthClause / DelayClause / etc. —
// optional-clause present/absent partition.
//
//   - NoInstanceRange
//       — `Adder a1 (...)` form: single-instance declaration.
//   - InstanceRange { range: VectorRange }
//       — `Adder a[7:0] (...)` form: instance-array; the range
//       drives elaboration-time instance replication. Reuses the
//       VectorRange carrier (constant_expression-pair via lexeme).
//
// CLOSED (C1 stop-signal). Two-way present/absent partition.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted: same shape
// as DriveStrengthClause / DelayClause; abbreviated for brevity.
//   1. Fact placement — FAILS: shared classifier across module-
//      instance / UDP-instance emitters + elaboration-time
//      replication consumers.
//   2. Variant-is-data — FAILS: empty-VectorRange sentinel
//      reintroduces the spec-illegal "zero-width array" state and
//      mixes the no-range form with a degenerate range form.
//   3. Algebraic form — N/A by construction.
//   4. Dimensional — FAILS: one instance-range state per instance
//      name; mutually exclusive.
//   5. Parameterized family — FAILS: NoInstanceRange is nullary;
//      InstanceRange carries a `range: VectorRange` payload —
//      structurally heterogeneous (Practice 7).
// Terminal: the closed two-way Verilog instance-array-range-presence
// classifier. Added 2026-05-16 per openai-pro REQUEST_CHANGES on
// PR #3176 — the prior shape dropped the optional range, making
// instance arrays unrepresentable.
type InstanceRangeClause
  = NoInstanceRange
  | InstanceRange { range: VectorRange }


// ─────────────────────────────────────────────────────────────────────
// ModuleInstance — one instance within a module_instantiation
// statement (`a1 (.a(x), .b(y), .sum(z))`, `a[7:0] (...)`). IEEE
// 1364-2005 §12.1 + §A.4.1.1. A single module_instantiation can
// declare MULTIPLE instances sharing a common (module_name,
// parameter_overrides); each instance carries its own (instance_name,
// optional instance-array range, port_connections). Per spec
// §A.4.1.1 `name_of_module_instance ::= module_instance_identifier
// [range]` — the prior shape dropped the optional range, making
// spec-legal `Adder a[7:0] (...)` instance arrays unrepresentable
// (openai-pro REQUEST_CHANGES on PR #3176 2026-05-16 at line 2247).
// Conj record (no Practice-4 ledger).
//
//   - instance_name   this instance's local name (K-1-opaque Symbol)
//   - instance_range  optional instance-array range
//                     (NoInstanceRange | InstanceRange{range})
//   - connections     the port-binding list per spec §12.1.2
//                     (PositionalConnections OR NamedConnections;
//                     uniform per instance).
type ModuleInstance {
  instance_name: Symbol
  instance_range: InstanceRangeClause
  connections: PortConnections
}


// ─────────────────────────────────────────────────────────────────────
// ModuleInstantiation — a Verilog module_instantiation statement
// (`Adder #(.WIDTH(8)) a1 (.a(x1), .b(y1)), a2 (.a(x2), .b(y2));`).
// IEEE 1364-2005 §12.1 + §A.4.1.1. Per spec grammar
// module_instantiation is ONE shared (module_identifier +
// parameter_value_assignment) clause followed by a NON-EMPTY LIST of
// module_instance entries — multi-instance declarations share the
// statement's module-name and parameter-override authority across
// all listed instances. The prior shape modeled ONE instance per
// ModuleInstance carrier and lost the §12.1 statement-boundary
// (shared module + shared overrides) for multi-instance forms
// (codex BLOCKING on PR #3176 2026-05-16). INVARIANTS P1/P2.
//
//   - module_name           the instantiated module's name (K-1-
//                           opaque Symbol; resolved through the
//                           namespace to the matching top-level
//                           `VerilogModule`). Shared across all
//                           instances in this statement.
//   - parameter_overrides   the `#(...)` parameter-override clause
//                           per spec §12.1.3. Shared across all
//                           instances; the same overrides bind to
//                           every instance in the multi-instance
//                           form.
//   - instances             the per-instance entries — each carries
//                           its own (instance_name, connections).
// Conj record (no Practice-4 ledger).
type ModuleInstantiation {
  module_name: Symbol
  parameter_overrides: ParameterOverrides
  // ModuleInstantiation.instances: 🟡 spec-non-empty (§A.4.1.1) —
  // deferred to std/collection.dag Wave-A2 `List<T> where non_empty`
  // refinement; see shared TRACKED-SCAFFOLD note above.
  instances: List<ModuleInstance>
}


// ─────────────────────────────────────────────────────────────────────
// DefparamAssignment — one (target_path, value) pair in a `defparam`
// statement's defparam_assignment list (IEEE 1364-2005 §A.2.5:
// `defparam_assignment ::= hierarchical_parameter_identifier =
// mintypmax_expression`). Conj record (no Practice-4 ledger).
//
//   - target_path     the hierarchical target-parameter path as a
//                     verbatim lexeme (sub-grammar deferred to the
//                     T-4 LanguageModel — hierarchical identifier
//                     resolution is its concern).
//   - value_lexeme    the override value as a verbatim expression
//                     lexeme.
type DefparamAssignment {
  target_path: String
  value_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// DefparamDeclaration — a Verilog `defparam` statement
// (`defparam top.sub.WIDTH = 8, top.sub.DEPTH = 16;`). IEEE 1364-2005
// §12.2 + §A.2.5 (deprecated per spec but admitted). Per spec a
// single `defparam` statement carries a NON-EMPTY list of
// defparam_assignment entries:
//
//   defparam_assignment_list ::= defparam_assignment
//                              { , defparam_assignment } ;
//
// The prior singular-entry shape lost the §12.2 statement-boundary
// (shared `defparam` keyword across multi-assignment forms) and made
// repeated DefparamDeclaration items in a module's ModuleItems
// ambiguous about whether two adjacent defparams came from one
// statement or two (openai-pro REQUEST_CHANGES on PR #3176
// 2026-05-16 at line 2315). Conj record (no Practice-4 ledger).
//
//   - assignments     the non-empty list of defparam assignments
//                     declared under this single `defparam`
//                     statement.
type DefparamDeclaration {
  // 🟡 spec-non-empty (§A.2.5 defparam_assignment list) —
  // deferred to std/collection.dag Wave-A2 `List<T> where
  // non_empty` refinement; see shared TRACKED-SCAFFOLD note above.
  assignments: List<DefparamAssignment>
}


// ─────────────────────────────────────────────────────────────────────
// GenerateRegion — a Verilog `generate ... endgenerate` block
// (IEEE 1364-2005 §12.4, §12.1.3.3). Generate regions admit
// `generate-for`, `generate-if`, and `generate-case` constructs that
// are ELABORATED at compile time to produce additional module items.
// Conj record (no Practice-4 ledger).
//
//   - body_lexeme    the entire `generate ... endgenerate` body as
//                    a verbatim lexeme (sub-grammar deferred to the
//                    T-4 LanguageModel — the elaboration rules for
//                    generate-for / generate-if / generate-case +
//                    the elaboration-time iteration are owned by
//                    the bundled LanguageModel productions when
//                    they land)
type GenerateRegion {
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// LoopGenerateConstruct — a Verilog `for ( genvar = init ; cond ;
// next ) generate_block` construct (IEEE 1364-2005 §12.4 +
// §A.1.4 / §A.4.2 loop_generate_construct). Per spec grammar
// loop_generate_construct is a module_or_generate_item DIRECTLY
// (not nested inside `generate ... endgenerate`); a bare
// `for (genvar i = 0; i < 8; i = i + 1) … endgenerate` is a legal
// module-body item per Annex A.1.4. Conj record (no Practice-4
// ledger).
//
//   - body_lexeme    the entire generate-for construct (genvar
//                    init/cond/iteration + generate_block body)
//                    as a verbatim lexeme; sub-grammar deferred to
//                    T-4 LanguageModel (the elaboration-time
//                    iteration semantics live there).
//
// Added per openai-pro REQUEST_CHANGES on PR #3176 2026-05-16 —
// the prior GenerateRegion variant only covered the `generate ...
// endgenerate` form, omitting the bare loop_generate_construct
// admitted directly at module-item level per spec Annex A.1.4.
type LoopGenerateConstruct {
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// ConditionalGenerateConstruct — a Verilog `if (cond) generate_block
// [else generate_block]` or `case (cond) ... endcase` conditional
// generate construct (IEEE 1364-2005 §A.1.4 / §A.4.2
// conditional_generate_construct = if_generate_construct |
// case_generate_construct). Like LoopGenerateConstruct, this is
// admitted directly at module-item level per spec Annex A.1.4
// (not nested inside `generate ... endgenerate`). Conj record (no
// Practice-4 ledger).
//
//   - body_lexeme    the entire conditional-generate construct
//                    (if/case head + generate_block body) as a
//                    verbatim lexeme; sub-grammar deferred to
//                    T-4 LanguageModel.
//
// Added per openai-pro REQUEST_CHANGES on PR #3176 2026-05-16.
type ConditionalGenerateConstruct {
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// SpecifyBlock — a Verilog `specify ... endspecify` block
// (IEEE 1364-2005 §14, §12.2). Specify blocks declare module path
// delays + timing checks (`$setup`, `$hold`, `$width`, etc.). Conj
// record (no Practice-4 ledger).
//
//   - body_lexeme    the entire `specify ... endspecify` body as a
//                    verbatim lexeme (sub-grammar deferred — the
//                    SDF-class timing-check vocabulary is owned by
//                    the bundled T-4 LanguageModel productions when
//                    they land; per the header PROBE LIMITS,
//                    timing-checks are a separate layer)
type SpecifyBlock {
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// TaskDeclaration — a Verilog `task ... endtask` declaration
// (IEEE 1364-2005 §10.2, §12.2). A task is a procedural sub-routine
// callable from procedural code; it can carry input/output/inout
// arguments and contain delay/event controls (unlike `function`).
// Conj record (no Practice-4 ledger).
//
//   - name           the task identifier (K-1-opaque Symbol)
//   - body_lexeme    the procedural body (port list + statements
//                    between `task name;` and `endtask`) as a
//                    verbatim lexeme (sub-grammar deferred to the
//                    T-4 LanguageModel)
type TaskDeclaration {
  name: Symbol
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// FunctionDeclaration — a Verilog `function ... endfunction`
// declaration (IEEE 1364-2005 §10.3, §12.2). A function is a pure
// (synthesizable) sub-routine that returns a value; the spec
// forbids delay/event controls inside the body (distinguishing
// functions from tasks). Conj record (no Practice-4 ledger).
//
//   - name           the function identifier (K-1-opaque Symbol)
//   - body_lexeme    the function body (return-type + arguments +
//                    statements between `function name;` and
//                    `endfunction`) as a verbatim lexeme (sub-
//                    grammar deferred to the T-4 LanguageModel —
//                    the return-type declaration + the pure-body
//                    constraint enforcement live there)
type FunctionDeclaration {
  name: Symbol
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// EventDeclarator — one (name, optional-unpacked-dimensions) entry
// in an event_declaration's list_of_event_identifiers (IEEE 1364-2005
// §A.2.1.4 / §A.2.3). Per spec:
//
//   list_of_event_identifiers ::= event_identifier [ dimension
//                                 { dimension } ]
//                               { , event_identifier [ dimension
//                                 { dimension } ] }
//
// each event identifier admits an OPTIONAL unpacked-array dimension
// suffix (openai-pro REQUEST_CHANGES on PR #3176 sha 4ccc6267 — the
// prior Symbol-only shape dropped the per-identifier dimensions
// fact). Conj record (no Practice-4 ledger).
//
//   - name                 the event identifier (K-1-opaque Symbol).
//   - unpacked_dimensions  optional unpacked-array dimensions per
//                          §A.2.3 (reuses UnpackedDimensionsClause).
type EventDeclarator {
  name: Symbol
  unpacked_dimensions: UnpackedDimensionsClause
}


// ─────────────────────────────────────────────────────────────────────
// EventDeclaration — a Verilog named-event declaration (`event ev1,
// ev2, ev3;` / `event log[0:255];`). IEEE 1364-2005 §9.7.3 / §10.3 /
// §A.2.1.4. Named events are explicitly-triggered control-flow
// primitives (`-> ev;` triggers, `@ev` waits). Per spec §A.2.1.4
// grammar:
//
//   event_declaration ::= event list_of_event_identifiers ;
//   list_of_event_identifiers ::= event_identifier [ dimension
//                                 { dimension } ]
//                               { , event_identifier [ dimension
//                                 { dimension } ] }
//
// a single `event` statement declares a NON-EMPTY list of
// (name, optional-dimensions) entries under a shared `event` keyword
// (sha 4ccc6267 openai-pro REQUEST_CHANGES — per-identifier
// dimensions added via EventDeclarator). The prior singular-name
// shape lost the §A.2.1.4 statement-boundary; the prior
// Symbol-only-list shape dropped the per-identifier dimensions.
// Conj record (no Practice-4 ledger).
//
//   - event_declarators   the non-empty list of EventDeclarator
//                         entries declared under this single
//                         `event` statement.
type EventDeclaration {
  // 🟡 spec-non-empty (§A.2.1.4 list_of_event_identifiers) —
  // deferred to std/collection.dag Wave-A2 `List<T> where
  // non_empty` refinement; see shared TRACKED-SCAFFOLD note above.
  event_declarators: List<EventDeclarator>
}


// ─────────────────────────────────────────────────────────────────────
// GenvarDeclaration — a Verilog `genvar` declaration (`genvar i, j,
// k;`). IEEE 1364-2005 §12.4.2 / §A.2.1.1. Generate variables drive
// elaboration-time loop iteration in `generate-for` constructs. Per
// spec §A.2.1.1 grammar:
//
//   genvar_declaration ::= genvar list_of_genvar_identifiers ;
//   list_of_genvar_identifiers ::= genvar_identifier
//                                { , genvar_identifier }
//
// a single `genvar` statement declares a NON-EMPTY list of genvar
// identifiers under a shared `genvar` keyword. The prior singular-
// name shape lost the §A.2.1.1 statement-boundary — openai-pro
// REQUEST_CHANGES on PR #3176 2026-05-16 at line 2315 (grouped with
// DefparamDeclaration / EventDeclaration). Conj record (no Practice-4
// ledger).
//
//   - genvar_names    the non-empty list of genvar identifiers (K-1-
//                     opaque Symbols) declared under this single
//                     `genvar` statement.
type GenvarDeclaration {
  // 🟡 spec-non-empty (§A.2.1.1 list_of_genvar_identifiers) —
  // deferred to std/collection.dag Wave-A2 `List<T> where
  // non_empty` refinement; see shared TRACKED-SCAFFOLD note above.
  genvar_names: List<Symbol>
}


// ─────────────────────────────────────────────────────────────────────
// LocalParameterDeclaration — a Verilog `localparam` declaration
// (`localparam W = 8;`). IEEE 1364-2005 §3.10, §12.2. Local parameters
// differ from ordinary parameters in that they CANNOT be overridden
// by `defparam` or by parameter overrides on a module instantiation
// (the spec's distinct binding rule). Conj record (no Practice-4
// ledger).
//
//   - type_kind     which parameter-type form (ParameterTypeKind
//                   Disj — same per-kind admissibility as
//                   ParameterDeclaration). Mirrors ParameterDeclaration's
//                   type-fact preservation per IEEE 1364-2005 §A.2.1.1.
//   - assignments   the list_of_param_assignments per spec — each
//                   ParameterAssignment carries name + default_lexeme.
type LocalParameterDeclaration {
  type_kind: ParameterTypeKind
  // 🟡 spec-non-empty (§A.2.1.1) — deferred to std/collection.dag
  // Wave-A2 refinement; see shared TRACKED-SCAFFOLD note above.
  assignments: List<ParameterAssignment>
}


// ─────────────────────────────────────────────────────────────────────
// PrimitiveGateKind — the closed Verilog built-in primitive-gate
// kind classifier (IEEE 1364-2005 §7.2). The spec admits exactly 26
// primitive gate types partitioned into six families per §7. Modeling
// the keyword as a free `String` admits spec-illegal keywords —
// corrected per codex BLOCKING on PR #3176 (M4 closed-sets-are-enums
// + INVARIANTS P2 illegal-states-unrepresentable). The keyword IS the
// closed kind discriminator and lives on this enum.
//
//   N-input gates (§7.2):
//   - GateAnd, GateNand, GateOr, GateNor, GateXor, GateXnor
//   N-output gates (§7.2):
//   - GateBuf, GateNot
//   Three-state gates (§7.2):
//   - GateBufif0, GateBufif1, GateNotif0, GateNotif1
//   MOS switches (§7.5):
//   - GateNmos, GatePmos, GateCmos, GateRnmos, GateRpmos, GateRcmos
//   Bidirectional pass switches (§7.6):
//   - GateTran, GateRtran, GateTranif0, GateTranif1, GateRtranif0,
//     GateRtranif1
//   Pull gates (§7.7):
//   - GatePulldown, GatePullup
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §7 admits this 26-way
// primitive-gate partition; SystemVerilog adds no new primitives.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every gate-emission consumer + every
//      per-gate terminal-arity check + every per-gate drive-strength
//      legality check reads the kind tag uniformly; shared
//      classifier, not scattered.
//   2. Variant-is-data — FAILS: a `{ keyword: String }` proxy admits
//      spec-illegal keywords (M4 closed-sets-are-enums-not-strings;
//      the K-1 readable-string heuristic surface this Disj forecloses).
//      A `{ id: Int }` proxy admits unbounded Int — same anti-pattern.
//      The enum IS the M4-faithful form.
//   3. Algebraic form — N/A by construction: the 26 gates are the
//      spec's primitive electrical-primitive taxonomy; the per-family
//      sub-partitions (n-input / n-output / three-state / MOS / pass /
//      pull) are observable derivations, not richer std/ algebra.
//   4. Dimensional — FAILS: a single gate instantiation has EXACTLY
//      ONE kind; mutually-exclusive alternatives.
//   5. Parameterized family — FAILS: the 26 are structurally
//      heterogeneous per family (varying terminal-arity admissibility
//      per gate, varying drive-strength admissibility, varying
//      bidirectionality) — NOT one generic `F<X>` / projection over
//      a separately-declared source set (Practice 7). The spec's
//      partition is irreducible.
// Terminal: the closed twenty-six-way Verilog primitive-gate-kind
// classifier of the IEEE 1364-2005 §7 spec.
type PrimitiveGateKind
  = GateAnd
  | GateNand
  | GateOr
  | GateNor
  | GateXor
  | GateXnor
  | GateBuf
  | GateNot
  | GateBufif0
  | GateBufif1
  | GateNotif0
  | GateNotif1
  | GateNmos
  | GatePmos
  | GateCmos
  | GateRnmos
  | GateRpmos
  | GateRcmos
  | GateTran
  | GateRtran
  | GateTranif0
  | GateTranif1
  | GateRtranif0
  | GateRtranif1
  | GatePulldown
  | GatePullup


// ─────────────────────────────────────────────────────────────────────
// GateInstantiation — a Verilog built-in primitive instantiation
// (`and g1(out, a, b);` / `not n1(o, i);` / `bufif1 b1(out, in, en);`,
// etc.). IEEE 1364-2005 §7 / §A.5.4. Conj record (no Practice-4 ledger).
//
//   - gate_kind        which built-in primitive gate (PrimitiveGateKind
//                      closed Disj; replaces the prior free-String
//                      gate_keyword that admitted spec-illegal
//                      keywords — M4 / INVARIANTS P2 fix per codex
//                      BLOCKING on PR #3176).
//   - body_lexeme      THE ENTIRE statement body after the gate-
//                      keyword (per-gate-class drive_strength /
//                      delay clauses + non-empty list of
//                      gate_instance entries, where each
//                      gate_instance carries an optional
//                      name_of_gate_instance (`identifier [range]`)
//                      plus its per-instance terminal list) as a
//                      verbatim lexeme. Sub-grammar deferred to the
//                      bundled T-4 LanguageModel — the per-gate-
//                      class admissibility table (cmos_switch_type
//                      forbids drive_strength but allows delay3;
//                      enable_gatetype allows both; pass_switchtype
//                      forbids both; n_input_gatetype admits delay2
//                      not delay3; etc., per §A.5.4) is exactly the
//                      class-specific grammar productions that owner
//                      models. The per-instance name_of_gate_
//                      instance + range structural extraction
//                      (codex non-blocking flag re: "name_of_instance
//                      carrier reuse at gate boundaries") rides this
//                      SAME sub-grammar deferral — the per-gate-
//                      class shape matrix forbids a uniform
//                      structural carrier at the GateInstantiation
//                      level (it would re-introduce admit-then-check
//                      on the gate-kind × clause admissibility
//                      product), so the per-instance facts live
//                      inside body_lexeme until the LanguageModel
//                      productions structurally encode each
//                      gate-class's instance shape. Same body_lexeme
//                      precedent as UdpDefinition.body_lexeme +
//                      AlwaysBlock.body_lexeme — sub-grammar
//                      defer-via-lexeme is the established pattern
//                      for spec sub-productions owned by the
//                      bundled LanguageModel.
type GateInstantiation {
  gate_kind: PrimitiveGateKind
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// UdpInstanceName — the closed Verilog UDP-instance name-of-instance
// classifier (IEEE 1364-2005 §A.5.2):
//
//   udp_instance ::= [ name_of_udp_instance ] ( output_terminal ,
//                                               input_terminal
//                                               { , input_terminal } )
//   name_of_udp_instance ::= udp_instance_identifier [ range ]
//
// the brackets around `name_of_udp_instance` make the entire name
// clause OPTIONAL — unnamed UDP instances are legal spec syntax
// (`xor ( o, a, b )` without an instance name). When present, the
// name itself may carry an optional instance-array range. The prior
// shape required `instance_name: Symbol` and dropped the range,
// making both spec-legal forms unrepresentable (openai-pro
// REQUEST_CHANGES on PR #3176 2026-05-16 at line 2648).
//
//   - NoUdpInstanceName
//       — `xor ( o, a, b )` form: no instance name; the spec's
//       bracket-absent form.
//   - NamedUdpInstance { name: Symbol, instance_range: InstanceRangeClause }
//       — `xor x1 ( o, a, b )` / `xor x[7:0] ( o, a, b )` form:
//       instance name present, optionally with an array range
//       (reuses the shared InstanceRangeClause Disj).
//
// CLOSED (C1 stop-signal). Two-way name-present/absent partition.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted: same shape
// as the optional-clause Disj family.
//   1. Fact placement — FAILS: shared across UDP-emitter +
//      elaboration consumers reading the optional name.
//   2. Variant-is-data — FAILS: empty-Symbol sentinel rejected
//      (same K-1 readable-string heuristic surface concern).
//   3. Algebraic form — N/A by construction.
//   4. Dimensional — FAILS: one name-of-udp-instance state per
//      udp_instance; mutually exclusive.
//   5. Parameterized family — FAILS: NoUdpInstanceName is nullary;
//      NamedUdpInstance carries `{ name, instance_range }` payload —
//      structurally heterogeneous (Practice 7).
// Terminal: the closed two-way Verilog UDP-instance name-of-instance
// classifier of the IEEE 1364-2005 §A.5.2 spec.
type UdpInstanceName
  = NoUdpInstanceName
  | NamedUdpInstance { name: Symbol, instance_range: InstanceRangeClause }


// ─────────────────────────────────────────────────────────────────────
// UdpInstance — one (optional-instance-name, port-list body) entry
// in a UDP instantiation's udp_instance list (IEEE 1364-2005 §A.5.2:
// `udp_instance ::= [name_of_udp_instance] ( output_terminal ,
// input_terminal { , input_terminal } )`). The optional name (with
// optional array range when present) is carried via the
// UdpInstanceName Disj above. Conj record (no Practice-4 ledger).
//
//   - instance_name    optional name-of-udp-instance per §A.5.2
//                      (NoUdpInstanceName | NamedUdpInstance{name,
//                      instance_range}).
//   - body_lexeme      the per-instance terminal list (`( out , in1,
//                      in2, ... )`) as a verbatim lexeme; sub-grammar
//                      (output_terminal + input_terminal_list per
//                      §A.5.4) deferred to the bundled T-4
//                      LanguageModel.
type UdpInstance {
  instance_name: UdpInstanceName
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// UdpInstantiation — a Verilog user-defined-primitive instantiation
// (a UDP defined via `primitive ... endprimitive` at the file level
// per IEEE 1364-2005 §8 is instantiated like a gate at the module-
// body level). Per spec §A.5.2 grammar:
//
//   udp_instantiation ::= udp_identifier [drive_strength] [delay2]
//                         udp_instance { , udp_instance } ;
//
// the spec form is ONE shared (udp_identifier + drive_strength +
// delay) clause followed by a NON-EMPTY list of udp_instance entries
// — multi-instance UDP statements share the statement's udp-name and
// strength/delay authority across all listed instances. The prior
// singular-instance shape lost the §A.5.2 statement-boundary (shared
// udp_identifier + shared strength/delay) for multi-instance forms
// (openai-pro REQUEST_CHANGES on PR #3176 2026-05-16 at line 2604;
// same shape as the ModuleInstantiation refactor above per
// §A.4.1.1). Conj record (no Practice-4 ledger).
//
//   - udp_name         the UDP identifier (K-1-opaque Symbol;
//                      resolves through the namespace to the
//                      matching file-level UdpDefinition — see
//                      below; the UDP and Module sibling design-
//                      elements share the same name-space). Shared
//                      across all instances in this statement.
//   - drive_strength   optional drive_strength clause; reuses the
//                      DriveStrengthClause Disj shared with
//                      NetDeclaration / ContinuousAssign. Shared
//                      across all instances.
//   - delay            optional delay clause; reuses the DelayClause
//                      Disj. Per spec §A.5.2 this is `delay2` (rise/
//                      fall) where net_declaration uses `delay3`
//                      (rise/fall/turn-off); the delay2-vs-delay3
//                      sub-grammar distinction lives in the bundled
//                      T-4 LanguageModel productions. Shared across
//                      all instances.
//   - instances        the per-instance entries — each carries its
//                      own (instance_name, body_lexeme).
type UdpInstantiation {
  udp_name: Symbol
  drive_strength: DriveStrengthClause
  delay: DelayClause
  // 🟡 spec-non-empty (§A.5.2 udp_instance list) — deferred to
  // std/collection.dag Wave-A2 `List<T> where non_empty` refinement;
  // see shared TRACKED-SCAFFOLD note above.
  instances: List<UdpInstance>
}


// ─────────────────────────────────────────────────────────────────────
// UdpDefinition — a Verilog user-defined-primitive definition
// (`primitive XorPrim (out, a, b); output out; input a, b; table … endtable
// endprimitive`). IEEE 1364-2005 §8 + §A.5. UDP definitions are
// FILE-LEVEL design elements (sibling of `module`/`macromodule`/
// `config`), NOT module-body items — codex BLOCKING on PR #3176
// 2026-05-16 surfaced the gap that the prior model referenced UDP
// definitions from UdpInstantiation but did not declare a carrier
// for them.
//
// Conj record (no Practice-4 ledger).
//
//   - name           the UDP identifier (K-1-opaque Symbol;
//                    cross-referenced by UdpInstantiation.udp_name)
//   - body_lexeme    the entire `primitive ... endprimitive` body
//                    (port list + port declarations + state table
//                    for sequential UDPs or output assignments for
//                    combinational UDPs) as a verbatim lexeme; sub-
//                    grammar deferred to the T-4 LanguageModel —
//                    the UDP state-table sub-grammar (§8.2) is its
//                    own recursive sub-language, owned by the
//                    bundled productions when they land.
//
// FILE-LEVEL DESIGN-ELEMENT NOTE. UdpDefinition is declared at the
// same scope as VerilogModule (top-level type, sibling of the
// module-style Disj). The IEEE 1364-2005 source_text grammar (§A.1.1)
// admits a list of file-level design elements
// `module_declaration | udp_declaration | config_declaration`.
//
// verilog.dag does NOT mint the design-element Disj LOCALLY. Per
// TASKS.md:504 (verbatim, dispositive): "A local Byte/Word copy or
// private language-model schema is invalid." The source_text
// design-element classifier IS the canonical T-4 LanguageModel
// contract spine (top-level compilation-unit composition) — owned
// by the bundled LanguageModel grammar-productions work per the
// canonical-LanguageModel-first directive (TASKS.md 457/473/504),
// + P2 single-authority. Per-language minting would be the v3
// cross-layer spine-drift the canonical-first directive exists to
// kill (5-language parallel-declaration precedent: every language
// file otherwise hits "source_text needs a design-element
// classifier" and would mint locally; codex top-level review will
// push each language file to do so, exactly what TASKS.md:504
// forbids).
//
// Dissolution trigger: when the canonical T-4 LanguageModel
// grammar-productions work lands, that owner aggregates
// VerilogModule + UdpDefinition (+ config_declaration when its
// sub-language lands) into the source_text design-element Disj.
// `config_declaration` is scope-negative here per the header
// PROBE LIMITS framing (configuration is a separate elaboration-
// time concern outside the IN-B probe).
//
// At this vocabulary-slice phase UdpDefinition exists as a
// sibling-typed carrier consumed by UdpInstantiation (the
// name-reference resolution target). This NOTE is the single
// source-of-truth deferral marker for the missing aggregator.
type UdpDefinition {
  name: Symbol
  body_lexeme: String
}


// ─────────────────────────────────────────────────────────────────────
// SpecparamAssignment — one element of a specparam declaration's
// list_of_specparam_assignments (IEEE 1364-2005 §A.2.4):
//
//   specparam_assignment ::=
//       specparam_identifier = constant_mintypmax_expression
//     | pulse_control_specparam
//   pulse_control_specparam ::=
//       PATHPULSE$ = ( reject_limit_value [ , error_limit_value ] ) ;
//     | PATHPULSE$specify_input_terminal_descriptor
//             $specify_output_terminal_descriptor
//             = ( reject_limit_value [ , error_limit_value ] ) ;
//
// The two alternatives have distinct spec syntax — pulse_control_
// specparam is NOT a `name = expr` form; it's the special
// `PATHPULSE$...` family. The prior shape reused ParameterAssignment
// `{ name: Symbol, default_lexeme: String }`, forcing every specparam
// to claim a name+value shape — which made pulse_control_specparam
// unrepresentable as a structural variant (openai-pro REQUEST_CHANGES
// on PR #3176 sha 4ccc6267). Split into a specparam-specific Disj
// over the two §A.2.4 spec alternatives.
//
//   - NamedSpecparamAssignment
//       — `specparam T_rise = 1.0;` form: identifier + constant
//       mintypmax-expression lexeme.
//   - PulseControlSpecparam
//       — `PATHPULSE$ = (1.5, 2.0);` / `PATHPULSE$in$out =
//       (1.5);` form: the entire PATHPULSE$... directive as a
//       verbatim lexeme (sub-grammar — terminal descriptors +
//       reject/error limit values — deferred to the bundled T-4
//       LanguageModel via the established body_lexeme precedent).
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §A.2.4 admits exactly the
// two specparam_assignment alternatives.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every specparam-emission consumer
//      branches on the form (named-value vs pulse-control); shared
//      classifier.
//   2. Variant-is-data — FAILS: reusing ParameterAssignment (prior
//      shape) forced pulse_control_specparam to claim a `name +
//      value_lexeme` shape it doesn't have, losing the PATHPULSE$
//      form as a structural variant.
//   3. Algebraic form — N/A by construction: the two alternatives
//      are the §A.2.4 spec's irreducible partition.
//   4. Dimensional — FAILS: a single specparam_assignment is
//      EXACTLY ONE form; mutually exclusive alternatives.
//   5. Parameterized family — FAILS: NamedSpecparamAssignment
//      carries `{ name: Symbol, value_lexeme: String }`;
//      PulseControlSpecparam carries `{ lexeme: String }` (no name
//      field — the PATHPULSE$... directive has its own internal
//      identifier structure) — structurally heterogeneous
//      (Practice 7).
// Terminal: the closed two-way Verilog specparam_assignment
// classifier of the IEEE 1364-2005 §A.2.4 spec.
type SpecparamAssignment
  = NamedSpecparamAssignment { name: Symbol, value_lexeme: String }
  | PulseControlSpecparam { lexeme: String }


// ─────────────────────────────────────────────────────────────────────
// SpecparamDeclaration — a Verilog `specparam` declaration. IEEE
// 1364-2005 §14.3.1 + §12.2 + §A.2.1.1. Specify parameters are
// distinct from ordinary parameters: they are intended for timing-
// check values (rise/fall/hi-Z transitions, pulse-control limits)
// and CANNOT be used as bit-vector widths or array indices per spec.
// Per spec grammar specparam admits an optional range and a list of
// specparam_assignments (sha 4ccc6267 openai-pro REQUEST_CHANGES —
// specparam_assignment carrier split via SpecparamAssignment Disj
// above to admit both NamedSpecparamAssignment + PulseControlSpecparam
// alternatives per §A.2.4). Conj record (no Practice-4 ledger).
//
//   - packing       optional range (`specparam [9:0]`); applies to
//                   all assignments in this declaration.
//   - assignments   the list_of_specparam_assignments per §A.2.4;
//                   each entry is one of the two SpecparamAssignment
//                   variants (named-value or pulse-control).
type SpecparamDeclaration {
  packing: PackingShape
  // 🟡 spec-non-empty (§A.2.1.1) — deferred to std/collection.dag
  // Wave-A2 refinement; see shared TRACKED-SCAFFOLD note above.
  assignments: List<SpecparamAssignment>
}


// ─────────────────────────────────────────────────────────────────────
// ModuleItem — the closed Verilog module-body item classifier. The
// items inside a `module ... endmodule` body are a flat list of
// concurrently-executing siblings (IEEE 1364-2005 §12.2); ModuleItem
// is the closed variant set of what each sibling can be.
//
// Per the IN-B PROBE FINDING above, this coproduct IS the parallel-
// composition surface: the module-body's `List<ModuleItem>` is the
// Conj children whose concurrent execution is the IN-B claim's
// structural representation — no 6th `Concurrent` behavior; the
// parallelism is the Conj-of-siblings shape, exactly as a Conj of
// submodule instantiations.
//
//   - ContinuousAssignItem        `assign net = expr;`
//   - AlwaysBlockItem             `always @(...) begin … end`
//   - InitialBlockItem            `initial begin … end`
//   - NetDeclarationItem          `wire`, `wand`, … declarations
//   - VariableDeclarationItem     `reg`, `integer`, … declarations
//   - ParameterDeclarationItem    `parameter NAME = expr;`
//   - LocalParameterDeclarationItem `localparam NAME = expr;` (§3.10)
//   - ModuleInstantiationItem     nested `ModuleName inst (...);` (or
//                                 multi-instance form `Name a1(...), a2(...)`)
//   - DefparamDeclarationItem     `defparam top.sub.PARAM = value;` (§4.10.2.1)
//   - GenerateRegionItem          `generate ... endgenerate` (§12.4)
//   - SpecifyBlockItem            `specify ... endspecify` (§14)
//   - TaskDeclarationItem         `task name; … endtask` (§10.2)
//   - FunctionDeclarationItem     `function name; … endfunction` (§10.3)
//   - EventDeclarationItem        `event ev;` (§9.7.3)
//   - GenvarDeclarationItem       `genvar i;` (§12.4.2)
//   - GateInstantiationItem       `and g1(out, a, b);` (§7)
//   - UdpInstantiationItem        UDP instantiation (§8)
//   - SpecparamDeclarationItem    `specparam ...;` (§14.3.1)
//
// CLOSED-SET COVERAGE — the variants enumerated below cover the full
// IEEE 1364-2005 §12.2 module_or_generate_item + specparam_declaration
// grammar partition per Annex A.1.4. The prior 12-variant cut missed
// `event_declaration`, `genvar_declaration`, `local_parameter_
// declaration`, `gate_instantiation`, `udp_instantiation`, and
// `specparam_declaration` (codex BLOCKING on PR #3176, codex/codex-
// default 2026-05-16 — the strict spec-fidelity bar surfaced these
// gaps). Each new variant is a Conj record + body_lexeme deferral
// per the established AlwaysBlock body_lexeme precedent — the sub-
// language structures (gate-primitive terminal lists, UDP definition
// tables, generate-for elaboration, specify timing checks) are owned
// by the bundled T-4 LanguageModel productions when they land, but
// the variant + payload-skeleton lives here so the closed-Disj
// honestly covers §12.2 + §14.3.1. A NEW item kind (one the spec
// does not list) is the C1 stop-signal edit.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every module-body consumer (emission,
//      port-binding resolution, sensitivity-list signal lookup,
//      synthesis dispatch, generate-elaboration, specify-timing-
//      check, task/function inlining, gate-primitive emission, UDP
//      resolution, genvar elaboration) branches on the item kind;
//      shared classifier, not scattered.
//   2. Variant-is-data — FAILS: each variant carries a payload of
//      a DIFFERENT type (the 18 distinct payload records). Collapsing
//      to a uniform `{ kind: ItemKind, … }` shape requires Option-
//      typed payload fields, which makes mismatched-kind+payload
//      combinations representable — the inverse of P2.
//   3. Algebraic form — N/A by construction: the module-body items
//      are the IEEE 1364-2005 spec's primitive item taxonomy; they
//      do not trace to a richer std/ algebraic structure.
//   4. Dimensional — FAILS: a single item is EXACTLY ONE kind;
//      mutually-exclusive alternatives. (The module body as a
//      WHOLE is `List<ModuleItem>` — multiple items co-exist as
//      siblings, but each item is one kind. The Conj-of-siblings
//      IS the dimensional model the IN-B finding consumes; that
//      lives on `VerilogModule.items`, not on this enum.)
//   5. Parameterized family — FAILS: the variants are structurally
//      heterogeneous (different payload types; the declaration
//      variants carry storage-shape facts while the action variants
//      carry computation-shape facts; gate / udp / specify / task /
//      function / generate each carry their own sub-language body)
//      — NOT one generic `F<X>` / projection over a separately-
//      declared source set (Practice 7). The IEEE 1364-2005 module-
//      body item set is the irreducible partition.
// Terminal: the closed twenty-way module-body-item classifier of
// the IEEE 1364-2005 §12.2 + §14.3.1 spec (corrected per codex
// BLOCKING on PR #3176 2026-05-16 — added PortDeclarationItem
// (direction-only body port_declaration) and BodyPortDeclarationItem
// (body port_declaration with inline type, reusing the
// AnsiPortDeclaration carrier; the body-form combined declaration
// is structurally equivalent to ANSI per §12.3.4). The body port_
// declaration is itself a §12.2 module_item the spec lists; the
// prior 18-way cut missed both body forms.
// AnsiModuleItem — the closed Verilog module-body item classifier
// for ANSI-style modules (IEEE 1364-2005 §12.2 — the 18 items spec-
// admitted in any module body, EXCLUDING body port_declarations).
// ANSI ports are "completely declared" per §12.3.3, so body port_
// declarations (`PortDeclarationItem` / `BodyPortDeclarationItem`)
// are a SYNTAX ERROR in ANSI-style modules — they are admitted only
// in the NonAnsiModuleItem set below.
//
// Per spec §A.1.4 / §A.6.1 most module_or_generate_items admit an
// `{ attribute_instance }` prefix (`(* keep *) assign net = expr;`,
// `(* synthesis_full_case *) always @(...) ...`, `(* dont_touch *)
// Adder a1 (...);`). The prior shape collapsed this fact —
// attribute_instances were unrepresentable except by leaking into
// unrelated lexeme payloads (openai-pro REQUEST_CHANGES on PR #3176
// 2026-05-16 at line 2884). The fix: each variant carries an
// `attributes: AttributeInstanceClause` first field (closed Disj
// over the §A.9.1 attribute_instance-list-present/absent partition).
// Carried per-variant (rather than as a wrapping Conj outside the
// Disj) keeps the structural per-variant payload-heterogeneity that
// the Practice-4 ledger relies on, and mirrors the established
// per-variant clause-field convention (drive_strength, delay,
// etc.).
type AnsiModuleItem
  = ContinuousAssignItem { attributes: AttributeInstanceClause, assign: ContinuousAssign }
  | AlwaysBlockItem { attributes: AttributeInstanceClause, always_block: AlwaysBlock }
  | InitialBlockItem { attributes: AttributeInstanceClause, initial_block: InitialBlock }
  | NetDeclarationItem { attributes: AttributeInstanceClause, net: NetDeclaration }
  | VariableDeclarationItem { attributes: AttributeInstanceClause, variable: VariableDeclaration }
  | ParameterDeclarationItem { attributes: AttributeInstanceClause, parameter: ParameterDeclaration }
  | LocalParameterDeclarationItem { attributes: AttributeInstanceClause, local_parameter: LocalParameterDeclaration }
  | ModuleInstantiationItem { attributes: AttributeInstanceClause, instantiation: ModuleInstantiation }
  | DefparamDeclarationItem { attributes: AttributeInstanceClause, defparam: DefparamDeclaration }
  | GenerateRegionItem { attributes: AttributeInstanceClause, generate_region: GenerateRegion }
  | LoopGenerateConstructItem { attributes: AttributeInstanceClause, loop_generate: LoopGenerateConstruct }
  | ConditionalGenerateConstructItem { attributes: AttributeInstanceClause, conditional_generate: ConditionalGenerateConstruct }
  | SpecifyBlockItem { attributes: AttributeInstanceClause, specify_block: SpecifyBlock }
  | TaskDeclarationItem { attributes: AttributeInstanceClause, task: TaskDeclaration }
  | FunctionDeclarationItem { attributes: AttributeInstanceClause, function_decl: FunctionDeclaration }
  | EventDeclarationItem { attributes: AttributeInstanceClause, event_decl: EventDeclaration }
  | GenvarDeclarationItem { attributes: AttributeInstanceClause, genvar_decl: GenvarDeclaration }
  | GateInstantiationItem { attributes: AttributeInstanceClause, gate: GateInstantiation }
  | UdpInstantiationItem { attributes: AttributeInstanceClause, udp_instance: UdpInstantiation }
  | SpecparamDeclarationItem { attributes: AttributeInstanceClause, specparam: SpecparamDeclaration }


// ─────────────────────────────────────────────────────────────────────
// NonAnsiModuleItem — the closed Verilog module-body item classifier
// for non-ANSI-style modules. Non-ANSI bodies admit ALL AnsiModuleItem
// variants PLUS body port_declarations (PortDeclarationItem +
// BodyPortDeclarationItem) per IEEE 1364-2005 §12.3.4 — port direction
// + (optional) type live in body items in the non-ANSI form. The
// Disj-with-named-payloads makes "ANSI port-list module with body
// PortDeclarationItem" structurally unrepresentable (codex BLOCKING
// fix on PR #3176 2026-05-16: items list was previously
// `List<ModuleItem>` regardless of port style, admitting the §12.3.3
// "ANSI ports are completely declared" violation).
//
//   - NonAnsiAnsiCompatItem        — wraps any AnsiModuleItem
//                                    variant (the 18-way common
//                                    item set admitted in any
//                                    module body).
//   - NonAnsiPortDeclarationItem   — body port_declaration in
//                                    direction-only form (`input
//                                    a;`); spec §12.3.4 non-ANSI
//                                    style only.
//   - NonAnsiBodyPortDeclarationItem
//                                  — body port_declaration in
//                                    direction-plus-type combined
//                                    form (`input wire [7:0] a;`);
//                                    reuses the AnsiPortDeclaration
//                                    carrier per the body-form-is-
//                                    shape-equivalent-to-ANSI
//                                    framing of §12.3.4.
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §12.3.4 admits this
// three-way non-ANSI module-item partition (the common-items
// wrapper + the two body port_declaration forms); SystemVerilog
// adds further forms — future language-version model EDITS this
// Disj explicitly.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every non-ANSI module-body consumer
//      branches on the variant to dispatch — common items go to
//      the AnsiModuleItem walker (via the wrapped item), body
//      port_declarations go to the §12.3.4 port-binding-resolution
//      walker. Shared classifier, not scattered.
//   2. Variant-is-data — FAILS: collapsing to a uniform `{ kind:
//      ItemKind, … }` shape reintroduces the §12.3.3 illegal state
//      this Disj-split exists to dissolve at the VerilogModule
//      level (NonAnsiModuleItem variants belong ONLY to non-ANSI
//      modules per VerilogModule's Disj; admitting them on ANSI
//      modules would re-open the §12.3.3 "ANSI ports are completely
//      declared" violation). The structural-membership constraint
//      lives at the VerilogModule-Disj level; this Disj enumerates
//      the per-style admissible items.
//   3. Algebraic form — N/A by construction: the three variants
//      are the §12.3.4 non-ANSI item-set partition (common-items
//      wrapper + two body-port forms); they do not trace to a
//      richer std/ algebraic structure.
//   4. Dimensional — FAILS: a single non-ANSI module-body item is
//      EXACTLY ONE variant; mutually-exclusive alternatives. (A
//      module body's `items` is `List<NonAnsiModuleItem>` —
//      multiple items co-exist as siblings, but each item is one
//      variant.)
//   5. Parameterized family — FAILS: the three variants carry
//      structurally heterogeneous payloads (NonAnsiAnsiCompatItem
//      wraps an AnsiModuleItem; NonAnsiPortDeclarationItem carries
//      a PortDeclaration direction-only record;
//      NonAnsiBodyPortDeclarationItem carries an
//      AnsiPortDeclaration per-direction Disj) — NOT one generic
//      `F<X>` / projection over a single source set (Practice 7).
// Terminal: the closed three-way Verilog non-ANSI module-body-item
// classifier of the IEEE 1364-2005 §12.3.4 spec; ledger added per
// codex BLOCKING on PR #3176 2026-05-16.
type NonAnsiModuleItem
  = NonAnsiAnsiCompatItem { item: AnsiModuleItem }
  | NonAnsiPortDeclarationItem { attributes: AttributeInstanceClause, port_decl: PortDeclaration }
  | NonAnsiBodyPortDeclarationItem { attributes: AttributeInstanceClause, body_port: AnsiPortDeclaration }


// ─────────────────────────────────────────────────────────────────────
// ModuleParameterPortList — the closed Verilog module-header
// parameter-port-list classifier (IEEE 1364-2005 §12.1). A module
// declaration may carry an OPTIONAL `#(parameter W = 8, parameter
// D = 16)` clause between the module name and the port list. Per
// spec grammar the clause is module_parameter_port_list and admits
// parameter_declarations only (not localparam — localparams must
// live in the body). The optional-presence is structural and
// modeled via a closed Disj rather than a nullable field.
//
//   - NoModuleParameterPortList
//       — `module M (a, b);` — no `#(...)` clause; the module's
//       OVERRIDEABLE-PARAMETER SURFACE is the ordered list of body
//       `ParameterDeclarationItem` declarations per spec §12.1
//       conditional rule (when no header parameter port list is
//       given, body `parameter` declarations are the overrideable
//       parameters). Instantiation `ParameterOverrides` actuals
//       bind to THAT body-derived list.
//   - ModuleParameters { parameters: List<ParameterDeclaration> }
//       — `module M #(parameter W = 8, parameter D = 16) (a, b);`
//       — the header carries an explicit `#(...)` parameter port
//       list. THESE header parameters are the overrideable surface;
//       any body `ParameterDeclarationItem` becomes LOCAL (not
//       overrideable) per the spec §12.1 conditional rule. Instantiation
//       `ParameterOverrides` actuals bind positionally or by name
//       to the header parameters only.
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §12.1 admits exactly the
// present-or-absent partition; SystemVerilog adds type parameters
// and parameterized class declarations — a future language-version
// model would EDIT this Disj explicitly.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every module-instantiation /
//      parameter-resolution consumer reads the header parameter
//      port list to know which parameters are externally
//      overridable; shared classifier, not scattered.
//   2. Variant-is-data — FAILS: collapsing to a uniform `{
//      parameters: List<ParameterDeclaration> }` where empty-list
//      = "no clause" conflates "explicitly `#()` empty" (a syntax
//      no Verilog admits) with "no `#(...)` clause at all" — the
//      Disj makes the present-vs-absent partition structural.
//   3. Algebraic form — N/A by construction: the two variants are
//      the spec's primitive clause-presence partition; not a
//      richer std/ algebraic structure.
//   4. Dimensional — FAILS: a single module declaration has
//      EXACTLY ONE parameter-port-list-presence state; mutually-
//      exclusive alternatives.
//   5. Parameterized family — FAILS: NoModuleParameterPortList is
//      nullary; ModuleParameters carries
//      `List<ParameterDeclaration>` — structurally heterogeneous,
//      NOT one generic `F<X>` / projection over a single source
//      set (Practice 7).
// Terminal: the closed two-way Verilog module-header parameter-
// port-list classifier of the IEEE 1364-2005 spec §12.1.
type ModuleParameterPortList
  = NoModuleParameterPortList
  // ModuleParameters.parameters: 🟡 spec-non-empty (§12.1) — deferred
  // to std/collection.dag Wave-A2 refinement; see shared TRACKED-
  // SCAFFOLD note above.
  | ModuleParameters { parameters: List<ParameterDeclaration> }


// ─────────────────────────────────────────────────────────────────────
// ModuleKeyword — the closed Verilog module-declaration-keyword
// classifier (IEEE 1364-2005 §A.1.2): a module declaration begins
// with either `module` or `macromodule`. The two keywords select
// distinct simulator-elaboration semantics — `macromodule` requests
// the implementation to "treat the module as a macromodule" (a
// hint that the simulator MAY flatten the module's hierarchy for
// performance) while `module` is the standard hierarchical form.
// The two are syntactically distinct on the spec surface and
// `parse ∘ emit` must preserve which keyword the writer used
// (otherwise a `macromodule` declaration emitted as `module`
// silently loses a simulator hint — openai-pro REQUEST_CHANGES on
// PR #3176 2026-05-16 at line 3046).
//
//   - ModuleKw         — `module` — the standard module-declaration
//                        keyword.
//   - MacromoduleKw    — `macromodule` — the macromodule-declaration
//                        keyword.
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §A.1.2 admits exactly the
// two keywords.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every module-emission consumer reads
//      the keyword tag to choose `module` vs `macromodule`; shared
//      classifier at the module-declaration boundary.
//   2. Variant-is-data — FAILS: a `{ is_macromodule: Bool }` proxy
//      ratifies the K-1-forbidden Bool-as-keyword anti-pattern; a
//      `{ keyword: Symbol }` proxy reopens the readable-string
//      heuristic surface K-1 forecloses. The 2-variant Disj IS the
//      dissolved form.
//   3. Algebraic form — N/A by construction: the two keywords are
//      the IEEE 1364-2005 spec's irreducible module-keyword
//      partition.
//   4. Dimensional — FAILS: a single module declaration uses
//      EXACTLY ONE keyword; mutually-exclusive alternatives.
//   5. Parameterized family — FAILS: both variants are nullary;
//      they are spec-distinct keyword identities, not a generic
//      `F<X>` projection over a richer source set (Practice 7).
// Terminal: the closed two-way Verilog module-declaration-keyword
// classifier of the IEEE 1364-2005 §A.1.2 spec.
type ModuleKeyword
  = ModuleKw
  | MacromoduleKw


// ─────────────────────────────────────────────────────────────────────
// VerilogModule — a top-level Verilog module (`module Name
// #(parameters) (ports); items endmodule`, or `macromodule Name …`,
// or `module Name; items endmodule` with no port list at all).
// IEEE 1364-2005 §12.1 / §12.3.4 / §A.1.2.
// Three-way Disj — the §12.3.4 module-style partition is the
// dimensional axis of VerilogModule, with a style-neutral
// NoPortsModule variant for the no-port-list form. Each style
// variant carries its own header-port-list type AND its own
// admissible body-items list type. Three illegal states are
// structurally unrepresentable:
//   (1) "ANSI port-list module with body PortDeclarationItem"
//       (the original 2-way split)
//   (2) "No-port-list module with body port_declarations"
//       (NoPortsModule items: List<AnsiModuleItem> — no body
//       port_declaration variants representable since body
//       port_declarations would reference non-existent header
//       port names per §12.3.4)
//   (3) "No-port-list represented two ways"
//       (P2 representation-duality between NonAnsi{header_ports=[]}
//       and Ansi{header_ports=[]} — the NoPortsModule variant is
//       the single representation of the no-ports state; the per-
//       style variants now have spec-non-empty header_ports)
//
//   - NoPortsModule
//       — `module M; ... endmodule` form: no header port list.
//       Style-neutral (the §12.3.4 ANSI-vs-non-ANSI distinction
//       loses meaning when there are no ports). Items use the
//       AnsiModuleItem set, which excludes body port_declarations.
//   - NonAnsiVerilogModule
//       — non-ANSI style: header carries port-EXPRESSIONS only
//       (List<NonAnsiPort>); body carries the full NonAnsiModuleItem
//       set including body PortDeclarationItem +
//       BodyPortDeclarationItem per §12.3.4.
//   - AnsiVerilogModule
//       — ANSI style: header carries fully-declared ports
//       (List<AnsiHeaderPort>, where AnsiHeaderPort wraps an
//       attribute-free AnsiPortDeclaration payload with the §A.1.3
//       outer attribute_instance prefix); body carries AnsiModuleItem
//       only (the 18 items spec-admitted in any module body
//       EXCLUDING port_declarations — per §12.3.3 ANSI ports are
//       "completely declared" and body redeclarations are a syntax
//       error).
//
// Both variants carry name + parameter_port_list. The module's
// OVERRIDEABLE-PARAMETER SURFACE is determined by IEEE 1364-2005
// §12.1's CONDITIONAL rule (clarified per openai-pro REQUEST_CHANGES
// on PR #3176 2026-05-16 — the prior framing was internally
// inconsistent on this rule):
//
//   - WHEN `parameter_port_list` is `ModuleParameters { ... }` (i.e.
//     the module has an explicit `#(...)` header clause), THOSE
//     header parameters ARE the overrideable parameter surface; any
//     body `ParameterDeclarationItem` is LOCAL (not overrideable —
//     even though it uses the `parameter` keyword).
//   - WHEN `parameter_port_list` is `NoModuleParameterPortList` (no
//     header `#(...)`), the OVERRIDEABLE parameter surface is the
//     ORDERED LIST of body `ParameterDeclarationItem` declarations
//     in source-appearance order.
//   - `LocalParameterDeclarationItem` is NEVER part of the
//     overrideable surface regardless of header presence (per §3.10
//     `localparam` is local-only by spec).
//
// Instantiation `#(parameter overrides)` clauses bind by position or
// by name to whichever set IS the overrideable surface per the
// conditional rule above. Downstream override-resolution consumers
// read the per-variant `parameter_port_list` to determine which set
// to walk.
//
// Per the IN-B PROBE FINDING: the `items` field IS the parallel-
// Conj surface; the structural concurrency of multiple always-blocks
// / continuous-assigns / instances is precisely "these are siblings
// in the items list". There is no `concurrent: Bool` flag; the
// parallelism is read FROM the list-of-siblings shape
// (feedback_no_annotations).
//
// CLOSED (C1 stop-signal). IEEE 1364-2005 §12.3.4 admits exactly the
// two module-style forms; SystemVerilog adds further declaration
// forms — future language-version model EDITS this Disj explicitly.
//
// Coproduct dissolution (Practice 4 / modeling-discipline.md §4) —
// 🟢 GREEN (terminal). Ledger — five patterns attempted:
//   1. Fact placement — FAILS: every module-level consumer
//      (emission, port-binding resolution, body item-set
//      admissibility check, synthesis dispatch) branches on the
//      style uniformly; shared classifier at the module-as-a-whole
//      level, not scattered.
//   2. Variant-is-data — FAILS: collapsing to a uniform Conj
//      record `{ name, parameter_port_list, ports: ModulePortsList,
//      items: List<UnifiedModuleItem> }` ratifies the §12.3.3
//      illegal state "ANSI ports + body port_declaration" — the
//      prior shape this VerilogModule Disj was introduced to
//      dissolve. The per-style payloads make admissibility
//      structural.
//   3. Algebraic form — N/A by construction: the two module styles
//      are the IEEE 1364-2005 spec's primitive module-style
//      partition; they do not trace to a richer std/ algebraic
//      structure.
//   4. Dimensional — FAILS: a single module declaration is EXACTLY
//      ONE style; mutually-exclusive alternatives per §12.3.4.
//   5. Parameterized family — FAILS: the variants carry
//      structurally heterogeneous payloads (NonAnsi.header_ports:
//      List<NonAnsiPort> + items: List<NonAnsiModuleItem> vs Ansi.
//      header_ports: List<AnsiHeaderPort> + items:
//      List<AnsiModuleItem>; NoPortsModule has no header_ports at
//      all + items: List<AnsiModuleItem>) — the header port-list
//      type AND the body item-set type both differ per variant.
//      NOT one generic `F<X>` / projection over a single source set
//      (Practice 7). The compound payload-type difference IS the
//      partition's defining structural fact.
// Terminal: the closed three-way Verilog module-declaration-style
// classifier of the IEEE 1364-2005 §12.3.4 spec (NoPortsModule +
// per-style variants); ledger added per codex BLOCKING on PR #3176
// 2026-05-16, NoPortsModule variant added at sha 7709c9968 per
// openai-pro REQUEST_CHANGES (line 3525 — no-port-list
// representation-duality + non-ANSI body port_declarations with
// empty header).
type VerilogModule
  = NoPortsModule {
      // `module M; ... endmodule` (no port list at all). Style-
      // neutral: with no header ports, the §12.3.4 ANSI-vs-non-ANSI
      // distinction loses meaning (the distinction is defined by
      // whether port direction lives in header or body — both
      // collapse to "no ports anywhere"). Items use the
      // AnsiModuleItem set (which excludes NonAnsiPortDeclarationItem
      // / NonAnsiBodyPortDeclarationItem) because there are no
      // header ports for body port_declarations to reference per
      // §12.3.4 — so admitting body port_declaration items here
      // would be a spec-illegal state.
      module_keyword: ModuleKeyword,
      name: Symbol,
      parameter_port_list: ModuleParameterPortList,
      items: List<AnsiModuleItem>
    }
  | NonAnsiVerilogModule {
      module_keyword: ModuleKeyword,
      name: Symbol,
      parameter_port_list: ModuleParameterPortList,
      // 🟡 spec-non-empty (§12.3.4 non-ANSI module-header port list) —
      // non-ANSI modules WITH a header port-list have at least one
      // port (the no-ports case routes to NoPortsModule above);
      // deferred to std/collection.dag Wave-A2 `List<T> where
      // non_empty` refinement; see shared TRACKED-SCAFFOLD note above.
      header_ports: List<NonAnsiPort>,
      items: List<NonAnsiModuleItem>
    }
  | AnsiVerilogModule {
      module_keyword: ModuleKeyword,
      name: Symbol,
      parameter_port_list: ModuleParameterPortList,
      // 🟡 spec-non-empty (§12.3.4 ANSI module-header port list) —
      // ANSI modules WITH a header port-list have at least one
      // port (the no-ports case routes to NoPortsModule above);
      // deferred to std/collection.dag Wave-A2 `List<T> where
      // non_empty` refinement; see shared TRACKED-SCAFFOLD note above.
      header_ports: List<AnsiHeaderPort>,
      items: List<AnsiModuleItem>
    }


// ─────────────────────────────────────────────────────────────────────
// (The file-level §A.1.1 source_text design-element Disj
// aggregating VerilogModule + UdpDefinition is DELIBERATELY NOT
// declared in this file — relayed disposition from T-4 mgr
// vivid-carp-207 msg_f2a511b6, 2026-05-16; same shape as the
// NonEmptyList → std/collection.dag Wave-A2 deferral.
//
// Three anchors:
//   1. TASKS.md:504 (verbatim, dispositive): "A local Byte/Word
//      copy or private language-model schema is invalid." The
//      source_text design-element classifier IS the canonical
//      LanguageModel contract spine (top-level compilation-unit
//      composition), not verilog-private grammar; minting it
//      locally is the v3 cross-layer spine-drift this directive
//      exists to prevent (every language file otherwise hits
//      "source_text needs a design-element classifier" → 5-language
//      parallel-declaration precedent).
//   2. P2 single-authority + canonical-LanguageModel-first
//      directive (TASKS.md 457/473/504): the design-element
//      aggregator is owned by the canonical T-4 LanguageModel
//      grammar-productions work — already the named owner in
//      UdpDefinition's FILE-LEVEL DESIGN-ELEMENT NOTE.
//   3. Codex's gap finding is spec-right (the §A.1.1 partition
//      should exist somewhere), but the FORM is the deferred
//      canonical-LanguageModel obligation, not a verilog-local
//      mint. Same pattern the NonEmptyList HOLD established.
//
// In-scope vocabulary carriers at file scope: VerilogModule (the
// per-style Disj declared above) + UdpDefinition (the Conj
// declared earlier alongside UdpInstantiation). The bundled
// T-4 LanguageModel grammar productions, when they land, aggregate
// these two file-level carriers into the canonical source_text
// design-element classifier — `config_declaration` is admitted by
// that canonical Disj when its sub-language lands (scope-negative
// here per the header PROBE LIMITS framing). The FILE-LEVEL
// DESIGN-ELEMENT NOTE in UdpDefinition's commentary is the single
// source-of-truth deferral marker; verilog.dag does NOT mint the
// design-element Disj locally.)


// ─────────────────────────────────────────────────────────────────────
// VerilogCost — the per-target cost-realization carrier shape for the
// Verilog `LanguageModel`. Conj record (no Practice-4 ledger).
//
// This declares the SHAPE the U1 spine reads when computing Verilog-
// target realization cost — the scaffold header's "Cost realization:
// per-construct cost on a Verilog target" claim:
//
//   - gate_cost     per-construct gate-count cost (an XOR, AND, OR
//                   primitive's gate equivalent; the U1 per-target-
//                   op cost projection — the `map` side of
//                   `Homomorphism<…, …, VerilogBits>` carries this;
//                   cost is read FROM the map's structure, never
//                   stored as a parallel field per algebra.dag's U1
//                   no-engine discipline)
//   - area_cost     per-construct area cost (in technology-dependent
//                   units — gate equivalents in a generic process,
//                   LUT count on FPGA, transistor count on ASIC;
//                   the technology-specific cost table sits in the
//                   inhabitance walk that the T-4 LanguageModel
//                   shape parameterizes when it lands, not in this
//                   carrier itself)
//
// Both Int carriers are 🟡 scaffold (same bridge as VectorRange and
// ptx Dim3): cost is a non-negative quantity, but without
// std/cardinality.dag refinement the negative-cost state is
// structurally representable. Producer-side invariant pending the
// cardinality substrate landing.
type VerilogCost {
  gate_cost: Int
  area_cost: Int
}
