// --- Digital map/fold step operators (SP-M3 shared substrate) ----------------
//
// Combinational continuous-assign semantics = MapStep (stateless per tick).
// Posedge sequential always-block semantics = FoldStep (register state over ticks).
// Structural body_lexeme carriers remain parse-scaffold; step operators model
// executable digital physics for mixed-signal composition with timeseries_signal.

// 🟡 gated — feature:verilog-4state-logic-level — bind SP-M3+ Verilog 4-state (0/1/X/Z);
// dissolve-on-arrival: extend beyond 2-state when X/Z witnesses enroll. Until then, 2-state
// only; do not alias to Bool without disposition (distinct carrier for future 4-state).
type LogicLevel
  = LogicLow
  | LogicHigh


type LogicInput {
  level: LogicLevel
}


type LogicOutput {
  level: LogicLevel
}


type RegisterState {
  q: LogicLevel
}


// --- MAP: two-input AND (combinational / continuous-assign class) ------------

type AndCombinationalMap {
  kind: MapStep
}


fn logic_and(left: LogicLevel, right: LogicLevel) -> LogicLevel {
  match left {
    LogicLow => LogicLow
    LogicHigh => match right {
      LogicLow => LogicLow
      LogicHigh => LogicHigh
    }
  }
}


fn and_combinational_map_step(
  element: AndCombinationalMap,
  left: LogicInput,
  right: LogicInput,
) -> LogicOutput {
  LogicOutput {
    level: logic_and(left: left.level, right: right.level)
  }
}


// --- FOLD: D flip-flop (posedge always-block class; q <= d) ------------------

type DFlipFlopFold {
  kind: FoldStep
}


fn d_flipflop_fold_step(
  element: DFlipFlopFold,
  state: RegisterState,
  d: LogicInput,
) -> RegisterState {
  RegisterState {
    q: d.level
  }
}


fn logic_level_eq(left: LogicLevel, right: LogicLevel) -> Bool {
  discriminant(v: left) == discriminant(v: right)
}


fn verilog_lex_token(token_class: Symbol, pattern: LexPattern) -> LexRule {
  TokenRule { token_class: token_class, pattern: pattern }
}


fn verilog_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}


fn verilog_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}


fn verilog_identifier_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}


fn verilog_wave1_lex() -> LexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: [
        TriviaRule { pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } } },
        verilog_lex_token(token_class: ^verilog_token_ident, pattern: verilog_identifier_pattern()),
        verilog_lex_token(token_class: ^verilog_token_kw_module, pattern: KeywordPattern { text: "module" }),
        verilog_lex_token(token_class: ^verilog_token_kw_endmodule, pattern: KeywordPattern { text: "endmodule" }),
        verilog_lex_token(token_class: ^verilog_token_semicolon, pattern: LiteralPattern { text: ";" })
      ]
    }
  }
}


fn verilog_source_text_module_expr() -> GrammarExpr {
  verilog_grammar_sequence(
    left: verilog_grammar_terminal(token_class: ^verilog_token_kw_module),
    right: verilog_grammar_sequence(
      left: verilog_grammar_terminal(token_class: ^verilog_token_ident),
      right: verilog_grammar_sequence(
        left: verilog_grammar_terminal(token_class: ^verilog_token_semicolon),
        right: verilog_grammar_terminal(token_class: ^verilog_token_kw_endmodule)
      )
    )
  )
}


fn verilog_wave1_grammar() -> ParseGrammar {
  let start = GrammarProduction {
    name: ^verilog_production_source_text_module,
    expression: verilog_source_text_module_expr(),
    emitted: grammar_atom(identity: ^verilog_surface_module_decl)
  }
  ModeledGrammar {
    root: GrammarRoot {
      start: ^verilog_production_source_text_module,
      productions: [start],
      sync_tokens: grammar_empty_sync_tokens()
    }
  }
}


fn verilog_source_text_module_formal_production() -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: ^verilog_production_source_text_module),
    rhs: [
      grammar_formal_terminal(identity: ^verilog_token_kw_module),
      grammar_formal_terminal(identity: ^verilog_token_ident),
      grammar_formal_terminal(identity: ^verilog_token_semicolon),
      grammar_formal_terminal(identity: ^verilog_token_kw_endmodule)
    ]
  }
}


fn verilog_ingest_grammar_schema() -> GrammarSchema {
  GrammarSchema {
    lex: verilog_wave1_lex(),
    grammar: verilog_wave1_grammar()
  }
}


fn verilog_ingest_grammar_probe() -> GrammarSchemaProbeBinding {
  GrammarSchemaProbeBinding {
    schema: verilog_ingest_grammar_schema(),
    probe: GrammarSchemaProbe {
      fixture: "module m; endmodule",
      production: verilog_source_text_module_formal_production(),
      expected_parse_surface: grammar_atom(identity: ^verilog_surface_module_decl)
    }
  }
}
