// src/v4/extdeps/file_system.dag
//
// Scope: file system model — paths, file kinds, read/write/list operations.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/ (POSIX.1-2024 / IEEE Std 1003.1-2024)
//
// Owns:
//   - Path = AbsolutePath | RelativePath
//   - AbsolutePath { components: List<PathComponent> }  // root is empty components; PathComponent refinement deferred
//   - RelativePath = CurrentDirectory | RelativeDescendant { first: RelativePathHead, rest: List<PathComponent> }
//   - NamedPathComponent { name: String }
//   - PathComponent = CurrentComponent | ParentComponent | NamedComponent(NamedPathComponent)
//   - FileKind = RegularFile | Directory | Symlink
//   - read_file(fs, p)        -> Result<FreeMonoid<Byte>, Diagnostic>
//   - write_file(fs, p, body) -> Result<Filesystem, Diagnostic>
//   - list_dir(fs, p)         -> Result<List<PathComponent>, Diagnostic>
//   - file_kind(fs, p)        -> Result<FileKind, Diagnostic>
//
// Scope NOT included in v4 (subset for compiler self-hosting needs):
//   - Permissions (mode bits) — out of scope; v4 compiler reads/writes own files
//   - Timestamps (atime/mtime/ctime) — out of scope; not needed for emission
//   - Memory mapping — out of scope; v4 reads files into memory wholesale
//   - File locking — out of scope; v4 is single-process
//
// Consumes:
//   - std/diagnostic.dag: Diagnostic
//   - std/text.dag: String (and its Tier-2 totalizations)
//   - std/machine.dag: Byte
//   - std/algebra.dag: FreeMonoid
//   - std/collection.dag: List
//
// Status: T-4.5 modeled 2026-05-16 (keen-wren-663). Operation bodies
//   are external realizations owned by the realization/pipeline layer;
//   this file owns the typed carriers and fail-closed operation
//   signatures only.
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).
//
// HEADER RECONCILE (2026-05-16, #3209, keen-wren-663 + operator ruling):
// filesystem operations take an explicit Filesystem resource parameter
// per ratified lens/effect.dag B3/B-5. `write_file` returns the
// modified Filesystem resource; read/list/kind return derived values.
// HEADER RECONCILE (2026-05-17, #3209, keen-wren-663 + merry-ibex-337
// ruling): the frozen header cited phantom std/collection.dag
// `NonEmptyList`; header Owns/Consumes now cite the real importable
// `List` carrier. Body already used List<PathComponent>; no body
// carrier change and no worker-minted NonEmptyList.
// HEADER RECONCILE (2026-05-17, #3209, keen-wren-663 + briansrls
// BLOCKING): FileKind::Symlink is a kind fact only. POSIX kind comes
// from stat/lstat mode bits; link target comes from readlink, which is
// outside this frozen file_system subset. Do not attach target Path to
// FileKind.
// HEADER RECONCILE (2026-05-17, #3209, keen-wren-663 + briansrls
// BLOCKING): Filesystem is an opaque resource carrier, not a readable
// String-labeled identity. The effect/resource authority is the threaded
// carrier position in operation signatures, not a label field.
// HEADER RECONCILE (2026-05-17, #3209, keen-wren-663 + codex BLOCKING):
// read/list/kind take the Filesystem resource as an explicit parameter
// and return only derived values. Only write_file returns Filesystem,
// preserving lens/effect.dag B3's returned-modified-resource = write vs
// returned-derived-value = read distinction.
// HEADER RECONCILE (2026-05-17, #3209, keen-wren-663 + codex BLOCKING):
// RelativePath separates current-directory from non-empty relative
// descendants, and PathComponent carries dot/dotdot/name cases
// structurally. This avoids mixing normalized path identity with raw
// POSIX pathname components.
// Follow-up reconcile: RelativeDescendant.first uses RelativePathHead,
// which excludes CurrentComponent, so `./` cannot be a second structural
// representation of CurrentDirectory.
// Follow-up reconcile: RelativePathHead reuses NamedPathComponent for
// named heads, so the named filename spelling/refinement target has one
// carrier instead of parallel raw String payloads.
// HEADER RECONCILE (2026-05-17, #3209, keen-wren-663 + codex BLOCKING):
// FileKindRequest carries a FileKindResolutionPolicy so callers choose
// stat-like symlink-following or lstat-like no-follow observation
// structurally.
// HEADER RECONCILE (2026-05-17, #3209, keen-wren-663 + briansrls
// BLOCKING): read_file/write_file carry raw byte streams
// (`FreeMonoid<Byte>`), not decoded text. POSIX read/write operate on
// byte buffers; text decoding/encoding is a separate fallible projection.
// HEADER RECONCILE (2026-05-17, #3209, keen-wren-663 + briansrls
// BLOCKING): file operations consume AbsolutePath, not the broader Path
// sum. RelativePath needs an explicit base-directory fact before POSIX
// resolution; this extdep does not read ambient current-working-directory
// state from outside the declared boundary.


module v4.extdeps.file_system


import v4.std.algebra { FreeMonoid }
import v4.std.diagnostic { Outcome }
import v4.std.machine { Byte }


// ─────────────────────────────────────────────────────────────────────
// Modeling notes (read before validating against the anchor)
//
// POSIX-FACING CARRIERS, NOT A PATH STRING. A path is structurally a
// sequence of filename components with an absolute/relative root fact.
// Modeling it as a readable `String` would force every consumer to
// rediscover root-ness, component boundaries, slash exclusion, and null
// exclusion by string inspection. The `Path` sum below is the single
// authority: consumers pattern-match the root fact and walk components.
//
// VALUE-REFINEMENT SCAFFOLDS. POSIX path name components exclude slash
// and null; portable filenames further restrict the character set. `.`
// and `..` are structural components below, not ordinary strings. v4's
// settled dependency path has `String`/`Char` but not a machine-readable
// predicate/refinement substrate for "non-empty string with no slash or
// null and not dot/dotdot". `NamedPathComponent` is therefore the honest
// named-spelling carrier with bridge properties:
//   (a) scaffold doc — THIS note; the current carrier is an unrefined
//       `String`, not the terminal POSIX filename refinement.
//   (b) bounds on use — producers must construct non-empty named
//       components that contain no slash, no null byte, and are not `.`
//       or `..`; use `CurrentComponent` / `ParentComponent` for those
//       POSIX components.
//   (c) dissolution trigger — when v4 lands value refinements over
//       `String` / `Char` predicates, replace `NamedPathComponent.name`
//       with the refined non-empty no-slash no-null non-dot carrier.
//
// OPERATION SEAM. The scaffold header's `Result<..., Diagnostic>` prose
// denotes std/diagnostic.dag's ratified `Outcome<T>` carrier
// (DECISIONS.md I). Per lens/effect.dag B3/B-5, type signatures are the
// single effect authority: effects are explicit parameters. Reads take
// the Filesystem as input and return derived values; writes return the
// modified Filesystem.
//
// FILE CONTENT IS BYTES AT THE POSIX BOUNDARY. `read_file` /
// `write_file` return and accept raw `FreeMonoid<Byte>` streams because
// POSIX read/write operate on byte buffers. Text decoding/encoding for
// `.dag`, generated source, and derived workflow artifacts belongs in a
// later fallible encoding-aware projection. Permissions, timestamps,
// memory mapping, and locks remain outside this v4 file's immutable
// scope.


// ─────────────────────────────────────────────────────────────────────
// PathComponent — one pathname component.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/V1_chap03.html#tag_03_241
//
// Terminal target for `NamedPathComponent.name`: a non-empty `String`
// excluding slash and null and not equal to `.` or `..`, with any
// portable-filename policy expressed as an explicit profile. Current
// carrier: `String` with the tracked refinement scaffold above.
//
// Coproduct dissolution (Practice 4 / INVARIANTS P1) — classification:
// 🟡 YELLOW, first-consumer-confirmed. POSIX gives `.` and `..`
// component semantics distinct from ordinary filename spellings; the
// first path-realization consumer must confirm it maps these variants
// without string sentinels or normalization side channels. Named trigger:
// T-4.5 filesystem realization seam lands path parsing/resolution.
// Ledger:
//   1. Fact placement — FAILS: dot/dotdot/name is consumed uniformly by
//      path resolution, not per-operation metadata.
//   2. Variant-is-data — FAILS: CurrentComponent and ParentComponent are
//      semantic component facts; NamedPathComponent carries the only
//      named spelling.
//   3. Algebraic form — N/A: component kind is not an algebra carrier.
//   4. Dimensional — FAILS: one pathname component is exactly one of
//      current, parent, or named.
//   5. Parameterized family — FAILS: the variants are not the same
//      payload shape projected over an enumerable set.
type NamedPathComponent {
  name: String
}

type PathComponent
  = CurrentComponent
  | ParentComponent
  | NamedComponent { component: NamedPathComponent }


// ─────────────────────────────────────────────────────────────────────
// AbsolutePath / RelativePath / Path.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/V1_chap03.html#tag_03_271
//
// `AbsolutePath` carries the root fact by variant, not by a leading
// slash in text. Empty absolute components denotes the POSIX root
// directory. Relative current-directory is a `CurrentDirectory` variant;
// non-empty relative descendants carry a first non-current component and
// rest list.
//
// 🟡 TRACKED-SCAFFOLD (project_v4_path_component_refinement):
// the frozen scaffold header previously named
// `NonEmptyList<PathComponent>`; reconciled 2026-05-17 (#3209 — see
// HEADER RECONCILE) to cite the importable `List<T>` carrier. Do not
// worker-mint `NonEmptyList<T>` here: POSIX root is represented by
// empty absolute components, so a NonEmptyList target for
// `AbsolutePath.components` would be unfaithful. The remaining
// refinement target is per-component validity: each PathComponent is
// non-empty and excludes slash/null once v4 lands string/char value
// refinements. Until then absolute paths use `List<PathComponent>` to
// preserve POSIX root-as-empty semantics; relative paths use the
// `CurrentDirectory | RelativeDescendant` sum and a non-current head so
// empty relative components or `./` are not second current-directory
// authorities.
type AbsolutePath {
  components: List<PathComponent>
}

type RelativePathHead
  = ParentHead
  | NamedHead { component: NamedPathComponent }

// Coproduct dissolution (Practice 4 / INVARIANTS P1) — classification:
// 🟡 YELLOW, first-consumer-confirmed. A relative descendant can begin
// with parent-directory traversal or a named component, but not current
// directory. NamedHead reuses NamedPathComponent, so first-component
// admissibility is not a second filename spelling authority. The first
// path-realization consumer must confirm `.`
// prefixes normalize to CurrentDirectory/descendant rules rather than
// constructing RelativePathHead. Named trigger: T-4.5 filesystem
// realization seam lands path parsing/resolution.
// Ledger:
//   1. Fact placement — FAILS: first-component admissibility is consumed
//      uniformly by relative path resolution.
//   2. Variant-is-data — FAILS: ParentHead is structural traversal;
//      NamedHead carries the shared named-component payload.
//   3. Algebraic form — N/A: head kind is not an algebra carrier.
//   4. Dimensional — FAILS: a relative descendant head is parent OR
//      named, not both.
//   5. Parameterized family — FAILS: the variants are not identical
//      payloads projected over an enumerable set.

type RelativePath
  = CurrentDirectory
  | RelativeDescendant { first: RelativePathHead, rest: List<PathComponent> }

// Coproduct dissolution (Practice 4 / INVARIANTS P1) — classification:
// 🟡 YELLOW, first-consumer-confirmed. Relative current directory and a
// non-empty relative descendant are distinct POSIX path facts.
// RelativeDescendant.first excludes CurrentComponent, so current
// directory has exactly one structural representation. The first
// path-realization consumer must confirm empty or `.` relative text is
// rejected or normalized into CurrentDirectory explicitly. Named trigger:
// T-4.5 filesystem realization seam lands path parsing/resolution.
// Ledger:
//   1. Fact placement — FAILS: current-directory vs descendant is
//      consumed uniformly by all path operations.
//   2. Variant-is-data — FAILS: RelativeDescendant carries a
//      non-current first/rest to make non-emptiness and non-currentness
//      structural; CurrentDirectory is nullary.
//   3. Algebraic form — N/A: relative path kind is not an algebra.
//   4. Dimensional — FAILS: a relative path is current directory OR a
//      descendant path, not both.
//   5. Parameterized family — FAILS: the variants are not the same
//      payload shape projected over an enumerable set.

// Coproduct dissolution (Practice 4 / INVARIANTS P1) — classification:
// 🟡 YELLOW, first-consumer-confirmed. The POSIX absolute-vs-relative split
// is grounded and bounded to this file's scaffold scope; the first
// filesystem realization consumer must confirm component normalization
// policy rather than smuggling it through strings. Ledger:
//   1. Fact placement — FAILS: root-ness is consumed uniformly by path
//      resolution and operation realization.
//   2. Variant-is-data — FAILS: a flat `{ absolute: Bool, components }`
//      admits policy drift around root encoding and duplicates the
//      POSIX partition as a flag.
//   3. Algebraic form — N/A: root-ness is not an algebra carrier.
//   4. Dimensional — FAILS: a path is absolute OR relative, not both.
//   5. Parameterized family — FAILS: the variants are not projected
//      over a separately-declared enumerable payload family.
type Path
  = Absolute { path: AbsolutePath }
  | Relative { path: RelativePath }


// ─────────────────────────────────────────────────────────────────────
// FileKind — the POSIX file-kind facts v4 needs.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/sys_stat.h.html
//
// This is a genuine closed sum for v4's filesystem subset: a path names
// exactly one of regular file, directory, or symlink at the operation
// boundary. Symlink target text is a separate `readlink` fact outside
// this frozen subset, not payload on the kind. A richer POSIX file-type
// set (FIFO, socket, block device, character device) would be a scope
// expansion to this extdep file, not a string label or `Other` variant.
//
// Coproduct dissolution (Practice 4 / INVARIANTS P1) — classification:
// 🟡 YELLOW, first-consumer-confirmed. The frozen scaffold intentionally
// models only the file-kind partition needed by read/write/list/kind in
// v4 self-hosting. Named trigger: the first realization consumer of
// `file_kind` must confirm that every successful result in this bounded
// scope maps to one of these variants, and otherwise fail closed through
// the D1 `Outcome<FileKind>` seam rather than inventing `Other` or a
// string label. Ledger:
//   1. Fact placement — FAILS: file kind is consumed uniformly by
//      readers deciding whether to read text, list entries, or handle
//      a link as a link; it is not per-consumer metadata.
//   2. Variant-is-data — FAILS: the variant itself is the file-kind
//      fact. Attaching readlink target payload here would conflate two
//      POSIX observations; flattening to a string/flag would lose the
//      bounded kind partition.
//   3. Algebraic form — N/A: file kind is not an algebra carrier.
//   4. Dimensional — FAILS: one directory entry has one kind in this
//      v4 subset, not simultaneous coordinates.
//   5. Parameterized family — FAILS: the variants are not mechanically
//      the same payload shape over an enumerable set.
type FileKind
  = RegularFile
  | Directory
  | Symlink

// `FileKindResolutionPolicy` is the POSIX stat-vs-lstat choice. Follow
// symlinks for resolved target kind (`stat`-like), or do not follow and
// observe the link itself (`lstat`-like).
//
// Coproduct dissolution (Practice 4 / INVARIANTS P1) — classification:
// 🟡 YELLOW, first-consumer-confirmed. POSIX exposes both stat-like
// symlink-following and lstat-like no-follow observations; the first
// file_kind realization consumer must confirm the resolver dispatches on
// this carrier and never hides the policy in prose or path spelling.
// Named trigger: T-4.5 filesystem realization seam lands file_kind.
// Ledger:
//   1. Fact placement — FAILS: resolution policy is a boundary fact of
//      the file_kind operation, not per-result metadata.
//   2. Variant-is-data — FAILS: each variant is a distinct observation
//      mode, with no shared payload.
//   3. Algebraic form — N/A: resolution policy is not an algebra.
//   4. Dimensional — FAILS: one request follows symlinks OR does not.
//   5. Parameterized family — FAILS: the variants are not a projection
//      over an independently modeled payload family.
type FileKindResolutionPolicy
  = FollowSymlinks
  | DoNotFollowSymlinks


// ─────────────────────────────────────────────────────────────────────
// Operation contract carriers.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/read.html
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/write.html
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/readdir.html
//
// `Filesystem` is the explicit opaque resource parameter for this
// extdep's file-system effects. It has no readable payload: resource
// identity is threaded structurally through operation signatures, and the
// effect fact is read from each signature.
type Filesystem

// Each `*Request` is a pure data description of the host operation. File
// operations consume AbsolutePath only; RelativePath is a structural path
// carrier for parsing/modeling, but resolution requires an explicit base
// directory before reaching this POSIX boundary. The result seam is the
// shared `Outcome<T>` carrier named in this file's header/prose. The
// `FileSystemOperations` record is the declared callable boundary a future
// host realization must inhabit; it is intentionally only a signature
// bundle here, not an effect resolver.
type FileBody = FreeMonoid<Byte>

type ReadFileRequest {
  filesystem: Filesystem
  path: AbsolutePath
}

type ReadFileResult = Outcome<FileBody>

type WriteFileRequest {
  filesystem: Filesystem
  path: AbsolutePath
  body: FileBody
}

type WriteFileResult = Outcome<Filesystem>

type ListDirRequest {
  filesystem: Filesystem
  path: AbsolutePath
}

type ListDirResult = Outcome<List<PathComponent>>

type FileKindRequest {
  filesystem: Filesystem
  path: AbsolutePath
  resolution: FileKindResolutionPolicy
}

type FileKindResult = Outcome<FileKind>

type FileSystemOperations {
  read_file: fn(ReadFileRequest) -> ReadFileResult
  write_file: fn(WriteFileRequest) -> WriteFileResult
  list_dir: fn(ListDirRequest) -> ListDirResult
  file_kind: fn(FileKindRequest) -> FileKindResult
}
