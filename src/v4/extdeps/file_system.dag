// src/v4/extdeps/file_system.dag
//
// Scope: file system model — paths, file kinds, read/write/list operations.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/ (POSIX.1-2024 / IEEE Std 1003.1-2024)
//
// Owns:
//   - Path = AbsolutePath | RelativePath
//   - AbsolutePath { components: List<PathComponent> }  // 🟡 non-empty intent deferred → std/collection Wave-A2 / T-25 NonEmptyList refinement
//   - RelativePath { components: List<PathComponent> }
//   - PathComponent (NonEmptyStr, no slashes, no nulls — per POSIX portable filename charset)
//   - FileKind = RegularFile | Directory | Symlink(target: Path)
//   - read_file(fs, p)        -> Result<FreeMonoid<Char>, Diagnostic>
//   - write_file(fs, p, body) -> Result<Filesystem, Diagnostic>
//   - list_dir(fs, p)         -> Result<List<PathComponent>, Diagnostic>
//   - file_kind(fs, p)        -> Result<FileKind, Diagnostic>
//
// Scope NOT included in v4 (subset for compiler self-hosting needs):
//   - Permissions (mode bits) — out of scope; v4 compiler reads/writes own files
//   - Timestamps (atime/mtime/ctime) — out of scope; not needed for emission
//   - Memory mapping — out of scope; v4 reads files into memory wholesale
//   - File locking — out of scope; v4 is single-process
//
// Consumes:
//   - std/diagnostic.dag: Diagnostic
//   - std/text.dag: Char, String (and their Tier-2 totalizations)
//   - std/algebra.dag: FreeMonoid<Char>
//   - std/collection.dag: List
//
// Status: T-4.5 modeled 2026-05-16 (keen-wren-663). Operation bodies
//   are external realizations owned by the realization/pipeline layer;
//   this file owns the typed carriers and fail-closed operation
//   signatures only.
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).
//
// HEADER RECONCILE (2026-05-16, #3209, keen-wren-663 + operator ruling):
// filesystem operations take an explicit Filesystem resource parameter
// per ratified lens/effect.dag B3/B-5. `write_file` returns the
// modified Filesystem resource; read/list/kind return derived values.
// HEADER RECONCILE (2026-05-17, #3209, keen-wren-663 + merry-ibex-337
// ruling): the frozen header cited phantom std/collection.dag
// `NonEmptyList`; header Owns/Consumes now cite the real importable
// `List` carrier and keep non-empty path intent as a 🟡 Wave-A2 / T-25
// refinement trigger. Body already used List<PathComponent>; no body
// carrier change and no worker-minted NonEmptyList.


module v4.extdeps.file_system


import v4.std.algebra { FreeMonoid }
import v4.std.diagnostic { Outcome }
import v4.std.text { Char }


// ─────────────────────────────────────────────────────────────────────
// Modeling notes (read before validating against the anchor)
//
// POSIX-FACING CARRIERS, NOT A PATH STRING. A path is structurally a
// sequence of filename components with an absolute/relative root fact.
// Modeling it as a readable `String` would force every consumer to
// rediscover root-ness, component boundaries, slash exclusion, and null
// exclusion by string inspection. The `Path` sum below is the single
// authority: consumers pattern-match the root fact and walk components.
//
// VALUE-REFINEMENT SCAFFOLDS. POSIX path components exclude slash and
// null; portable filenames further restrict the character set. v4's
// settled dependency path has `String`/`Char` but not a machine-readable
// predicate/refinement substrate for "non-empty string with no slash or
// null". `PathComponent` is therefore the honest carrier with bridge
// properties:
//   (a) scaffold doc — THIS note; the current carrier is an unrefined
//       `String`, not the terminal POSIX filename refinement.
//   (b) bounds on use — producers must construct non-empty components
//       that contain no slash and no null byte; "." / ".." are ordinary
//       relative-directory components only when the producer intends
//       POSIX resolution semantics.
//   (c) dissolution trigger — when v4 lands value refinements over
//       `String` / `Char` predicates, replace `PathComponent` with the
//       refined non-empty no-slash no-null carrier.
//
// OPERATION SEAM. The scaffold header's `Result<..., Diagnostic>` prose
// denotes std/diagnostic.dag's ratified `Outcome<T>` carrier
// (DECISIONS.md I). Per lens/effect.dag B3/B-5, type signatures are the
// single effect authority: effects are explicit parameters, and the
// effect lens reads returned-modified-resource as write and
// returned-derived-value as read.
//
// FILE CONTENT IS TEXT IN V4. `read_file` / `write_file` are scoped to
// the compiler self-hosting need: reading and writing text `.dag`,
// generated source, and derived workflow artifacts. Raw bytes,
// permissions, timestamps, memory mapping, and locks remain outside this
// v4 file's immutable scope.


// ─────────────────────────────────────────────────────────────────────
// PathComponent — one filename component.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/V1_chap03.html#tag_03_241
//
// Terminal target: a non-empty `String` excluding slash and null, with
// any portable-filename policy expressed as an explicit profile. Current
// carrier: `String` with the tracked refinement scaffold above.
type PathComponent = String


// ─────────────────────────────────────────────────────────────────────
// AbsolutePath / RelativePath / Path.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/V1_chap03.html#tag_03_271
//
// `AbsolutePath` carries the root fact by variant, not by a leading
// slash in text. Its component list is intentionally the same carrier
// shape as `RelativePath`; absolute-vs-relative is the only extra fact.
// Empty absolute components denotes the POSIX root directory. Empty
// relative components denotes the current directory.
//
// 🟡 TRACKED-SCAFFOLD (project_v4_nonemptylist_deferred_refinement):
// the frozen scaffold header names `NonEmptyList<PathComponent>`, but
// std/collection.dag currently exposes only `List<T>` as an importable
// sequence carrier. Do not worker-mint `NonEmptyList<T>` here. The
// intended non-empty refinement for absolute paths dissolves when
// std/collection.dag Wave-A2 lands the canonical NonEmptyList/FiniteSet
// refinement substrate; until then this body uses `List<PathComponent>`
// with the POSIX root/current-directory semantics above.
type AbsolutePath {
  components: List<PathComponent>
}

type RelativePath {
  components: List<PathComponent>
}

// Coproduct dissolution (Practice 4 / INVARIANTS P1) — classification:
// 🟡 YELLOW, first-consumer-confirmed. The POSIX absolute-vs-relative split
// is grounded and bounded to this file's scaffold scope; the first
// filesystem realization consumer must confirm component normalization
// policy rather than smuggling it through strings. Ledger:
//   1. Fact placement — FAILS: root-ness is consumed uniformly by path
//      resolution and operation realization.
//   2. Variant-is-data — FAILS: a flat `{ absolute: Bool, components }`
//      admits policy drift around root encoding and duplicates the
//      POSIX partition as a flag.
//   3. Algebraic form — N/A: root-ness is not an algebra carrier.
//   4. Dimensional — FAILS: a path is absolute OR relative, not both.
//   5. Parameterized family — FAILS: the variants are not projected
//      over a separately-declared enumerable payload family.
type Path
  = Absolute { path: AbsolutePath }
  | Relative { path: RelativePath }


// ─────────────────────────────────────────────────────────────────────
// FileKind — the POSIX file-kind facts v4 needs.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/sys_stat.h.html
//
// This is a genuine closed sum for v4's filesystem subset: a path names
// exactly one of regular file, directory, or symlink at the operation
// boundary. A richer POSIX file-type set (FIFO, socket, block device,
// character device) would be a scope expansion to this extdep file, not
// a string label or `Other` variant.
//
// Coproduct dissolution (Practice 4 / INVARIANTS P1) — classification:
// 🟡 YELLOW, first-consumer-confirmed. The frozen scaffold intentionally
// models only the file-kind partition needed by read/write/list/kind in
// v4 self-hosting. Named trigger: the first realization consumer of
// `file_kind` must confirm that every successful result in this bounded
// scope maps to one of these variants, and otherwise fail closed through
// the D1 `Outcome<FileKind>` seam rather than inventing `Other` or a
// string label. Ledger:
//   1. Fact placement — FAILS: file kind is consumed uniformly by
//      readers deciding whether to read text, list entries, or resolve
//      a link; it is not per-consumer metadata.
//   2. Variant-is-data — FAILS: `Symlink` alone carries a target path;
//      a flat `{ kind, target? }` admits illegal target-bearing regular
//      files or target-less symlinks.
//   3. Algebraic form — N/A: file kind is not an algebra carrier.
//   4. Dimensional — FAILS: one directory entry has one kind in this
//      v4 subset, not simultaneous coordinates.
//   5. Parameterized family — FAILS: the variants are not mechanically
//      the same payload shape over an enumerable set.
type FileKind
  = RegularFile
  | Directory
  | Symlink { target: Path }


// ─────────────────────────────────────────────────────────────────────
// Operation contract carriers.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/read.html
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/write.html
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/readdir.html
//
// `Filesystem` is the explicit resource parameter for this extdep's
// file-system effects. It is a nominal handle, not an effect taxonomy:
// the effect fact is read from each operation signature.
type Filesystem {
  label: String
}

// Each `*Request` is a pure data description of the host operation. The
// result seam is the shared `Outcome<T>` carrier named in this file's
// header/prose. The `FileSystemOperations` record is the declared
// callable boundary a future host realization must inhabit; it is
// intentionally only a signature bundle here, not an effect resolver.
type FileBody = FreeMonoid<Char>

type ReadFileRequest {
  filesystem: Filesystem
  path: Path
}

type ReadFileResult = Outcome<FileBody>

type WriteFileRequest {
  filesystem: Filesystem
  path: Path
  body: FileBody
}

type WriteFileResult = Outcome<Filesystem>

type ListDirRequest {
  filesystem: Filesystem
  path: Path
}

type ListDirResult = Outcome<List<PathComponent>>

type FileKindRequest {
  filesystem: Filesystem
  path: Path
}

type FileKindResult = Outcome<FileKind>

type FileSystemOperations {
  read_file: fn(ReadFileRequest) -> ReadFileResult
  write_file: fn(WriteFileRequest) -> WriteFileResult
  list_dir: fn(ListDirRequest) -> ListDirResult
  file_kind: fn(FileKindRequest) -> FileKindResult
}
