// src/v4/extdeps/file_system.dag
// Scope: file system substrate — paths, file kinds, modeled peripheral I/O effects.
// Owns: PosixByteString, NamedPathComponent, PathComponent, AbsolutePath, RelativePathHead, RelativePath, Path, FileKind, FileKindResolutionPolicy, Filesystem, FileBody, FileResource, FilePath, FileContent, FileRead, FileWrite, NodeFileBinding, FileEffectWitness, FileWriteWitness, file-system request/result/operation carriers, file_read, file_write.
// Consumes: std diagnostic, std outcome, std node, std algebra, std machine.
// Status: T-4.5 modeled; peripheral effect surface per design-v4-compiler-homomorphism (not compile-core).


module v4.extdeps.file_system


import v4.std.algebra { FreeMonoid }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  PortLocus,
  Rejected,
  Unavailable
}
import v4.std.machine { Byte }
import v4.std.node { Node, Symbol }


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/V1_chap03.html#tag_03_241
// coincides: finite POSIX byte sequence.
type PosixByteString = FreeMonoid<Byte>

// tag: named pathname component spelling.
// scaffold: POSIX byte refinements; trigger T-25-core/T-30.
type NamedPathComponent {
  bytes: PosixByteString
}

// 🟡 coproduct dissolution — OS-1.
type PathComponent
  = CurrentComponent
  | ParentComponent
  | NamedComponent { component: NamedPathComponent }


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/V1_chap03.html#tag_03_271
type AbsolutePath {
  components: List<PathComponent>
}

// 🟡 coproduct dissolution — OS-1.
type RelativePathHead
  = ParentHead
  | NamedHead { component: NamedPathComponent }

// 🟡 coproduct dissolution — OS-1.
type RelativePath
  = CurrentDirectory
  | CurrentDescendant { first: RelativePathHead, rest: List<PathComponent> }
  | RelativeDescendant { first: RelativePathHead, rest: List<PathComponent> }

// 🟡 coproduct dissolution — OS-1.
type Path
  = Absolute { path: AbsolutePath }
  | Relative { path: RelativePath }


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/sys_stat.h.html
// 🟡 coproduct dissolution — OS-1.
type FileKind
  = RegularFile
  | Directory
  | Symlink

// tag: stat/lstat symlink policy.
// 🟡 coproduct dissolution — OS-1.
type FileKindResolutionPolicy
  = FollowSymlinks
  | DoNotFollowSymlinks


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/functions/read.html + https://pubs.opengroup.org/onlinepubs/9799919799/functions/write.html + https://pubs.opengroup.org/onlinepubs/9799919799/functions/readdir.html
type Filesystem

// coincides: finite POSIX byte sequence.
type FileBody = FreeMonoid<Byte>

// Modeled resource — effects are explicit parameters against this carrier (B-5 DI).
type FileResource {
  filesystem: Filesystem
}

// Peripheral effect path coordinate (absolute path for MVP shims).
type FilePath {
  absolute: AbsolutePath
}

// Effect payload for read results.
type FileContent = FileBody

type FileWriteWitness {
  resource: FileResource
  path: FilePath
}

type NodeFileBinding {
  node: Node
  path: FilePath
}

// 🟡 coproduct dissolution — W-TRAVERSE-OUTCOME-FILE-EFFECT-WITNESS.
// Trigger: ResourceDependsOn/EffectDependsOn wiring when std/dependency.dag lands (Worker A A1).
type FileEffectWitness
  = ReadWitness { path: FilePath, content: FileContent }
  | WriteWitness { path: FilePath, witness: FileWriteWitness }

data file_effect_dependency_wiring_deferred: Symbol = file_effect_dependency_wiring_deferred

type ReadFileRequest {
  filesystem: Filesystem
  path: AbsolutePath
}

type ReadFileResult = Outcome<FileBody>

type WriteFileRequest {
  filesystem: Filesystem
  path: AbsolutePath
  body: FileBody
}

type WriteFileResult = Outcome<Filesystem>

type ListDirRequest {
  filesystem: Filesystem
  path: AbsolutePath
}

type ListDirResult = Outcome<List<PathComponent>>

type FileKindRequest {
  filesystem: Filesystem
  path: AbsolutePath
  resolution: FileKindResolutionPolicy
}

type FileKindResult = Outcome<FileKind>

type FileSystemOperations {
  read_file: fn(ReadFileRequest) -> ReadFileResult
  write_file: fn(WriteFileRequest) -> WriteFileResult
  list_dir: fn(ListDirRequest) -> ListDirResult
  file_kind: fn(FileKindRequest) -> FileKindResult
}

data file_read_effect_not_wired: Symbol = file_read_effect_not_wired

data file_write_effect_not_wired: Symbol = file_write_effect_not_wired

fn file_effect_not_wired_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: PortLocus { port: reason },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn file_read(
  resource: FileResource,
  path: FilePath,
  ops: FileSystemOperations
) -> Outcome<FileContent> {
  Rejected {
    diagnostic: file_effect_not_wired_diagnostic(reason: file_read_effect_not_wired)
  }
}

fn file_write(
  resource: FileResource,
  path: FilePath,
  content: FileContent,
  ops: FileSystemOperations
) -> Outcome<FileWriteWitness> {
  Rejected {
    diagnostic: file_effect_not_wired_diagnostic(reason: file_write_effect_not_wired)
  }
}
