// src/v4/extdeps/file_system.dag
// Scope: External file-system resource model + modeled file effects (read/write).
// Owns: FileResource, FilePath, FileContent, FileRead, FileWrite, FileReadWitness, FileWriteWitness, FileEffectWitness, FileReadResult, FileWriteResult, file_read, file_write.
// Consumes: v4.std.algebra, v4.std.diagnostic, v4.std.machine.
// Status: scaffold — Wave-2 fail-closed boundary.

module v4.extdeps.file_system

import v4.std.algebra { FreeMonoid }
import v4.std.machine { Byte }

type FileResource {}
type FilePath {}
type FileContent = FreeMonoid<Byte>
type FileRead { resource: FileResource, path: FilePath }
type FileWrite { resource: FileResource, path: FilePath, content: FileContent }
type FileReadWitness { request: FileRead, content: FileContent }
type FileWriteWitness { request: FileWrite }
type FileEffectWitness
  = ReadWitness { witness: FileReadWitness }
  | WriteWitness { witness: FileWriteWitness }
type FileReadResult {}
type FileWriteResult {}
fn file_read(req: FileRead) -> FileReadResult
fn file_write(req: FileWrite) -> FileWriteResult
