module v4.extdeps.runtimes.host_process

import v4.std.model_core { ModelCore }
import v4.std.node { Symbol }
import v4.std.runtime {
  RuntimeExecutionSemantics,
  RuntimeInterpretationAlgebra,
  RuntimeResourceEffectBoundary,
  RuntimeValueRepresentation
}

data host_process_runtime_id: Symbol = host_process_runtime_id

type HostProcessRuntime {
  runtime_identity: Symbol
  core: ModelCore
  values: RuntimeValueRepresentation
  interpretation: RuntimeInterpretationAlgebra
  execution: RuntimeExecutionSemantics
  boundary: RuntimeResourceEffectBoundary
}
