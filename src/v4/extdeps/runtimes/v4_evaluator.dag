// src/v4/extdeps/runtimes/v4_evaluator.dag
// Scope: Concrete v4 evaluator runtime fact-bundle.
// Owns: V4EvaluatorRuntime, v4_evaluator_runtime_id, v4_evaluator_runtime_wave1, v4_evaluator_*_wave1 slice accessors.
// Consumes: v4.std.model_core, v4.std.runtime, v4.std.node.
// Status: Option-C concrete runtime extdep; std/runtime.dag owns abstract carriers; RuntimeTarget wiring staged.

module v4.extdeps.runtimes.v4_evaluator

import v4.std.collection { List }
import v4.std.diagnostic { Accepted, None, Outcome }
import v4.std.logic { Bool }
import v4.std.model_core { ModelCore, PrimitiveOperationRef, wave1_void }
import v4.std.node { Atom, Node, Symbol, TypeNode }
import v4.std.runtime {
  AllocationSemantics,
  BindInterpreter,
  BoundaryAllowance,
  BranchInterpreter,
  CallSemantics,
  ControlSemantics,
  Continue,
  ControlTransfer,
  EnvironmentBindingKey,
  EvaluationCall,
  EvaluationEnvironment,
  EvaluationFrame,
  ExecutionSemantics,
  InterpretationAlgebra,
  LoopInterpreter,
  ResourceAccess,
  ResourceEffectBoundary,
  Return,
  RuntimeUnit,
  RuntimeUnitValue,
  RuntimeValue,
  TransformInterpreter,
  ValueInterpreter,
  ValueRepresentationModel
}

data v4_evaluator_runtime_id: Symbol = v4_evaluator_runtime_id
data v4_eval_wave1_unit_type_symbol: Symbol = v4_eval_wave1_unit_type_symbol
data v4_eval_wave1_boundary_operation_symbol: Symbol = v4_eval_wave1_boundary_operation_symbol
data v4_eval_wave1_boundary_effect_symbol: Symbol = v4_eval_wave1_boundary_effect_symbol

type V4EvaluatorRuntime {
  runtime_identity: Symbol
  core: ModelCore
  values: ValueRepresentationModel
  interpretation: InterpretationAlgebra
  execution: ExecutionSemantics
  boundary: ResourceEffectBoundary
}

fn v4_eval_wave1_unit_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: v4_eval_wave1_unit_type_symbol } },
    children: []
  }
}

fn v4_eval_wave1_boundary_operation_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: v4_eval_wave1_boundary_operation_symbol } },
    children: []
  }
}

fn v4_eval_wave1_effect_signature_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: v4_eval_wave1_boundary_effect_symbol } },
    children: []
  }
}

fn v4_eval_wave1_unit_value() -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue {
      unit_type: v4_eval_wave1_unit_type_node()
    }
  }
}

fn v4_eval_wave1_represent_literal(_node: Node, _env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  Accepted { value: v4_eval_wave1_unit_value(), diagnostics: None }
}

fn v4_eval_wave1_represent_result(value: RuntimeValue) -> Outcome<RuntimeValue> {
  Accepted { value: value, diagnostics: None }
}

fn v4_eval_wave1_allocate_literal(node: Node, env: EvaluationEnvironment) -> Outcome<RuntimeValue> {
  v4_eval_wave1_represent_literal(node: node, env: env)
}

fn v4_eval_wave1_call_primitive(
  _node: Node,
  _args: List<RuntimeValue>,
  _env: EvaluationEnvironment
) -> Outcome<RuntimeValue> {
  Accepted { value: v4_eval_wave1_unit_value(), diagnostics: None }
}

fn v4_eval_wave1_choose_branch(_node: Node, _value: RuntimeValue, _env: EvaluationEnvironment) -> Outcome<Node> {
  Accepted { value: v4_eval_wave1_unit_type_node(), diagnostics: None }
}

fn v4_eval_wave1_step_loop(_node: Node, _env: EvaluationEnvironment) -> Outcome<ControlTransfer> {
  Accepted { value: Continue { value: v4_eval_wave1_unit_value() }, diagnostics: None }
}

fn v4_eval_wave1_bind_value(
  _key: EnvironmentBindingKey,
  _value: RuntimeValue,
  env: EvaluationEnvironment
) -> Outcome<EvaluationEnvironment> {
  Accepted { value: env, diagnostics: None }
}

fn v4_eval_wave1_allocate(value: RuntimeValue) -> Outcome<RuntimeValue> {
  Accepted { value: value, diagnostics: None }
}

fn v4_eval_wave1_call(_call: EvaluationCall, _frame: EvaluationFrame) -> Outcome<ControlTransfer> {
  Accepted { value: Return { value: v4_eval_wave1_unit_value() }, diagnostics: None }
}

fn v4_eval_wave1_return_value(value: RuntimeValue, _frame: EvaluationFrame) -> Outcome<ControlTransfer> {
  Accepted { value: Return { value: value }, diagnostics: None }
}

fn v4_eval_wave1_transfer(_control: ControlTransfer, frame: EvaluationFrame) -> Outcome<EvaluationFrame> {
  Accepted { value: frame, diagnostics: None }
}

fn v4_eval_wave1_boundary_allowance(allowed: Bool) -> BoundaryAllowance {
  BoundaryAllowance {
    operation: PrimitiveOperationRef {
      operation: v4_eval_wave1_boundary_operation_node(),
      effect_signature: v4_eval_wave1_effect_signature_node()
    },
    resource: ResourceAccess {
      resource: v4_eval_wave1_boundary_operation_node()
    },
    allowed: allowed
  }
}

fn v4_eval_wave1_resource_boundary() -> ResourceEffectBoundary {
  ResourceEffectBoundary {
    ffi: v4_eval_wave1_boundary_allowance(allowed: False),
    exceptions: v4_eval_wave1_boundary_allowance(allowed: False),
    async: v4_eval_wave1_boundary_allowance(allowed: False),
    concurrency: v4_eval_wave1_boundary_allowance(allowed: False),
    identity_reference: v4_eval_wave1_boundary_allowance(allowed: False)
  }
}

fn v4_evaluator_model_core_wave1() -> ModelCore {
  wave1_void()
}

fn v4_evaluator_value_representation_wave1() -> ValueRepresentationModel {
  ValueRepresentationModel {
    represent_literal: v4_eval_wave1_represent_literal,
    represent_result: v4_eval_wave1_represent_result
  }
}

fn v4_evaluator_interpretation_wave1() -> InterpretationAlgebra {
  InterpretationAlgebra {
    value: ValueInterpreter {
      allocate_literal: v4_eval_wave1_allocate_literal
    },
    transform: TransformInterpreter {
      call_primitive: v4_eval_wave1_call_primitive
    },
    branch: BranchInterpreter {
      choose_branch: v4_eval_wave1_choose_branch
    },
    loop: LoopInterpreter {
      step_loop: v4_eval_wave1_step_loop
    },
    bind: BindInterpreter {
      bind_value: v4_eval_wave1_bind_value
    }
  }
}

fn v4_evaluator_execution_wave1() -> ExecutionSemantics {
  ExecutionSemantics {
    allocation: AllocationSemantics {
      allocate: v4_eval_wave1_allocate
    },
    calls: CallSemantics {
      call: v4_eval_wave1_call,
      return_value: v4_eval_wave1_return_value
    },
    control: ControlSemantics {
      transfer: v4_eval_wave1_transfer
    }
  }
}

fn v4_evaluator_boundary_wave1() -> ResourceEffectBoundary {
  v4_eval_wave1_resource_boundary()
}

fn v4_evaluator_runtime_wave1() -> V4EvaluatorRuntime {
  V4EvaluatorRuntime {
    runtime_identity: v4_evaluator_runtime_id,
    core: v4_evaluator_model_core_wave1(),
    values: v4_evaluator_value_representation_wave1(),
    interpretation: v4_evaluator_interpretation_wave1(),
    execution: v4_evaluator_execution_wave1(),
    boundary: v4_evaluator_boundary_wave1()
  }
}
