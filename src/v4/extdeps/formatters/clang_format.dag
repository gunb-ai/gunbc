// src/v4/extdeps/formatters/clang_format.dag
// Scope: clang-format configuration model — option space grounded in Clang 23.0.0git style options.
// Owns: ClangFormatStyle, ClangFormatValue, ClangFormatOption, ClangFormatConfig, clang_format_defaults, clang_format_layer.
// Consumes: none (String, Bool, Int, List are language-level primitives; no compiler dependency).
// Status: T-4.16 scaffold — full top-level option space grounded in current clang-format style reference.
// Anchor: https://clang.llvm.org/docs/ClangFormatStyleOptions.html

module v4.extdeps.formatters.clang_format


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type ClangFormatStyle
  = ClangFormatStyleLLVM
  | ClangFormatStyleGoogle
  | ClangFormatStyleChromium
  | ClangFormatStyleMozilla
  | ClangFormatStyleWebKit
  | ClangFormatStyleMicrosoft
  | ClangFormatStyleGNU
  | ClangFormatStyleInheritParentConfig
  | ClangFormatStyleInheritParentConfigPath { path: String }


type ClangFormatSignedInteger {
  value: Int
}


type ClangFormatUnsignedInteger {
  value: Int // 🟡 gated: formatter-int-refinement — must be ≥0
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type ClangFormatValue
  = ClangFormatBool { value: Bool }
  | ClangFormatString { value: String }
  | ClangFormatInteger { value: ClangFormatSignedInteger }
  | ClangFormatUnsigned { value: ClangFormatUnsignedInteger }
  | ClangFormatEnum { value: String }
  | ClangFormatNested { entries: List<ClangFormatOption> }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type ClangFormatOption
  = ClangFormatAccessModifierOffset { value: ClangFormatSignedInteger }
  | ClangFormatAlignAfterOpenBracket { value: Bool }
  | ClangFormatAlignArrayOfStructures { value: String }
  | ClangFormatAlignConsecutiveAssignments { value: ClangFormatValue }
  | ClangFormatAlignConsecutiveBitFields { value: ClangFormatValue }
  | ClangFormatAlignConsecutiveDeclarations { value: ClangFormatValue }
  | ClangFormatAlignConsecutiveMacros { value: ClangFormatValue }
  | ClangFormatAlignConsecutiveShortCaseStatements { value: ClangFormatValue }
  | ClangFormatAlignConsecutiveTableGenBreakingDAGArgColons { value: ClangFormatValue }
  | ClangFormatAlignConsecutiveTableGenCondOperatorColons { value: ClangFormatValue }
  | ClangFormatAlignConsecutiveTableGenDefinitionColons { value: ClangFormatValue }
  | ClangFormatAlignEscapedNewlines { value: String }
  | ClangFormatAlignOperands { value: String }
  | ClangFormatAlignTrailingComments { value: ClangFormatValue }
  | ClangFormatAllowAllArgumentsOnNextLine { value: Bool }
  | ClangFormatAllowAllConstructorInitializersOnNextLine { value: Bool }
  | ClangFormatAllowAllParametersOfDeclarationOnNextLine { value: Bool }
  | ClangFormatAllowBreakBeforeNoexceptSpecifier { value: String }
