// src/v4/extdeps/formatters/clang_format.dag
// Scope: clang-format configuration model — option space grounded in clang-format 23.0.0git.
// Status: T-4.16 scaffold — full top-level option space grounded in clang-format 23.0.0git style reference.
// Anchor: https://clang.llvm.org/docs/ClangFormatStyleOptions.html

module v4.extdeps.formatters.clang_format

import v4.std.patch { FieldPatch, apply_field_patch }
import v4.std.diagnostic { Locus, Outcome }
import v4.std.node { Symbol }
import v4.std.refinement { Refined, Validation, refine }


type ClangFormatNonNegativeInt = Refined<Int>
type ClangFormatAtLeastMinusOneInt = Refined<Int>


data clang_format_non_negative_int_out_of_range: Symbol = clang_format_non_negative_int_out_of_range
data clang_format_at_least_minus_one_int_out_of_range: Symbol = clang_format_at_least_minus_one_int_out_of_range


fn clang_format_non_negative_int_admits(value: Int) -> Bool {
  value >= 0
}

fn clang_format_at_least_minus_one_int_admits(value: Int) -> Bool {
  value >= -1
}


data clang_format_non_negative_int_validation: Validation<Int> = Validation {
  reason: clang_format_non_negative_int_out_of_range,
  admits: clang_format_non_negative_int_admits
}

data clang_format_at_least_minus_one_int_validation: Validation<Int> = Validation {
  reason: clang_format_at_least_minus_one_int_out_of_range,
  admits: clang_format_at_least_minus_one_int_admits
}


fn make_clang_format_non_negative_int(value: Int, at: Locus) -> Outcome<ClangFormatNonNegativeInt> {
  refine(base: value, by: clang_format_non_negative_int_validation, at: at)
}

fn make_clang_format_at_least_minus_one_int(value: Int, at: Locus) -> Outcome<ClangFormatAtLeastMinusOneInt> {
  refine(base: value, by: clang_format_at_least_minus_one_int_validation, at: at)
}


