type ClangFormatConfig {
  based_on_style: ClangFormatStyle,
  options: List<ClangFormatOption>,
}


data clang_format_defaults: ClangFormatConfig = ClangFormatConfig {
  based_on_style: ClangFormatStyleLLVM,
  options: [],
}


// 🟡 gated — feature: formatter-config-patch — bind T-4.16 follow-on — dissolve-on-arrival: ClangFormatConfigPatch type with per-field Override<T>/Inherit arms replaces full-config layering.
fn clang_format_layer(base: ClangFormatConfig, outer: ClangFormatConfig) -> ClangFormatConfig {
  outer
}
