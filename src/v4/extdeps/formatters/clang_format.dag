  | ClangFormatAllowShortLoopsOnASingleLine { value: Bool }
  | ClangFormatAllowShortNamespacesOnASingleLine { value: Bool }
  | ClangFormatAllowShortRecordOnASingleLine { value: String }
  | ClangFormatAlwaysBreakAfterDefinitionReturnType { value: String }
  | ClangFormatAlwaysBreakAfterReturnType { value: String }
  | ClangFormatAlwaysBreakBeforeMultilineStrings { value: Bool }
  | ClangFormatAlwaysBreakTemplateDeclarations { value: String }
  | ClangFormatBasedOnStyle { value: ClangFormatStyle }
  | ClangFormatBinPackArguments { value: Bool }
