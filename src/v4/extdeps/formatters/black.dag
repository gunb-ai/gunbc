// src/v4/extdeps/formatters/black.dag
// Scope: Black 26.5.1 pyproject [tool.black] configuration model.
// Status: T-4.16 scaffold — Black 26.5.1 pyproject schema.
// Anchor: https://github.com/psf/black/blob/26.5.1/src/black/resources/black.schema.json

module v4.extdeps.formatters.black

import v4.std.collection { List }
import v4.std.diagnostic { Outcome }
import v4.std.patch { FieldPatch, apply_field_patch }
import v4.std.refinement {
  PositiveInt,
  positive_int_authoritative_literal,
}



// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type BlackTargetVersion
  = BlackPy33
  | BlackPy34
  | BlackPy35
  | BlackPy36
  | BlackPy37
  | BlackPy38
  | BlackPy39
  | BlackPy310
  | BlackPy311
  | BlackPy312
  | BlackPy313
  | BlackPy314
  | BlackPy315


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type BlackTargetVersionPolicy
  = BlackTargetVersionAbsent
  | BlackTargetVersionExplicit { targets: List<BlackTargetVersion> }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type BlackRequiredVersionPolicy
  = BlackRequiredVersionAbsent
  | BlackRequiredVersionExplicit { version: String }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type BlackUnstableFeature
  = BlackUnstableStringProcessing
  | BlackUnstableHugParensWithBracesAndSquareBrackets
  | BlackUnstableWrapComprehensionIn
  | BlackUnstableSimplifyPowerOperatorHugging
  | BlackUnstableWrapLongDictValuesInParens
  | BlackUnstableFixIfGuardExplosionInCaseStatement
  | BlackUnstablePyiOverloadGroupBlankLines
  | BlackUnstablePyiBlankLineBeforeDecoratedClass


// 🟡 gated — feature: formatter-cross-field-constraints — bind T-4.16 follow-on — dissolve-on-arrival: witness checks enable_unstable_feature empty unless preview; unstable implies preview; forbidden: ad-hoc cross-field guards outside validation substrate.
type BlackConfig {
  line_length: Outcome<PositiveInt>
  target_version: BlackTargetVersionPolicy
  required_version: BlackRequiredVersionPolicy
  pyi: Bool
  ipynb: Bool
  python_cell_magics: List<String>
  skip_source_first_line: Bool
  skip_string_normalization: Bool
  skip_magic_trailing_comma: Bool
  preview: Bool
  unstable: Bool
  enable_unstable_feature: List<BlackUnstableFeature>
  include: String
  exclude: String
  extend_exclude: String
  force_exclude: String
}


data black_defaults: BlackConfig = BlackConfig {
  line_length: positive_int_authoritative_literal(value: 88),
  target_version: BlackTargetVersionAbsent,
  required_version: BlackRequiredVersionAbsent,
  pyi: false,
  ipynb: false,
  python_cell_magics: [],
  skip_source_first_line: false,
  skip_string_normalization: false,
  skip_magic_trailing_comma: false,
  preview: false,
  unstable: false,
  enable_unstable_feature: [],
  include: "(\\.pyi?|\\.ipynb)$",
  exclude: "/(\\.direnv|\\.eggs|\\.git|\\.hg|\\.ipynb_checkpoints|\\.mypy_cache|\\.nox|\\.pytest_cache|\\.ruff_cache|\\.tox|\\.svn|\\.venv|\\.vscode|__pypackages__|_build|buck-out|build|dist|venv)/",
  extend_exclude: "",
  force_exclude: "",
}


// 🟡 gated — consumer:config-patch-record-projection — bind v4.std.patch feature:config-patch-record-projection — dissolve-on-arrival: BlackConfigPatch projected from BlackConfig field set.
type BlackConfigPatch {
  line_length: FieldPatch<Outcome<PositiveInt>>
  target_version: FieldPatch<BlackTargetVersionPolicy>
  required_version: FieldPatch<BlackRequiredVersionPolicy>
  pyi: FieldPatch<Bool>
  ipynb: FieldPatch<Bool>
  python_cell_magics: FieldPatch<List<String>>
  skip_source_first_line: FieldPatch<Bool>
  skip_string_normalization: FieldPatch<Bool>
  skip_magic_trailing_comma: FieldPatch<Bool>
  preview: FieldPatch<Bool>
  unstable: FieldPatch<Bool>
  enable_unstable_feature: FieldPatch<List<BlackUnstableFeature>>
  include: FieldPatch<String>
  exclude: FieldPatch<String>
  extend_exclude: FieldPatch<String>
  force_exclude: FieldPatch<String>
}


fn black_layer(base: BlackConfig, patch: BlackConfigPatch) -> BlackConfig {
  BlackConfig {
    line_length: apply_field_patch(base: base.line_length, patch: patch.line_length),
    target_version: apply_field_patch(base: base.target_version, patch: patch.target_version),
    required_version: apply_field_patch(base: base.required_version, patch: patch.required_version),
    pyi: apply_field_patch(base: base.pyi, patch: patch.pyi),
    ipynb: apply_field_patch(base: base.ipynb, patch: patch.ipynb),
    python_cell_magics: apply_field_patch(base: base.python_cell_magics, patch: patch.python_cell_magics),
    skip_source_first_line: apply_field_patch(base: base.skip_source_first_line, patch: patch.skip_source_first_line),
    skip_string_normalization: apply_field_patch(base: base.skip_string_normalization, patch: patch.skip_string_normalization),
    skip_magic_trailing_comma: apply_field_patch(base: base.skip_magic_trailing_comma, patch: patch.skip_magic_trailing_comma),
    preview: apply_field_patch(base: base.preview, patch: patch.preview),
    unstable: apply_field_patch(base: base.unstable, patch: patch.unstable),
    enable_unstable_feature: apply_field_patch(base: base.enable_unstable_feature, patch: patch.enable_unstable_feature),
    include: apply_field_patch(base: base.include, patch: patch.include),
    exclude: apply_field_patch(base: base.exclude, patch: patch.exclude),
    extend_exclude: apply_field_patch(base: base.extend_exclude, patch: patch.extend_exclude),
    force_exclude: apply_field_patch(base: base.force_exclude, patch: patch.force_exclude),
  }
}

