// src/v4/extdeps/formatters/rustfmt.dag
// Scope: rustfmt configuration model — option space grounded in rustfmt v1.6.0 toml reference.
// Owns: RustfmtIndentStyle, RustfmtBraceStyle, RustfmtControlBraceStyle, RustfmtTrailingComma,
//       RustfmtMatchArmLeadingPipes, RustfmtImportsGranularity, RustfmtGroupImports,
//       RustfmtImportsLayout, RustfmtImportsIndent, RustfmtFnParamsLayout, RustfmtNewlineStyle,
//       RustfmtEdition, RustfmtSmallHeuristics, RustfmtHexLiteralCase, RustfmtVersion,
//       RustfmtBinopSeparator, RustfmtColor, RustfmtTypePunctuationDensity,
//       RustfmtMacroSelector, RustfmtRequiredVersion,
//       RustfmtConfig, rustfmt_defaults, rustfmt_layer.
// Consumes: none (String, Bool, Int, List are language-level primitives; no compiler dependency).
// Status: T-4.16 scaffold — full option space grounded in rustfmt v1.6.0 toml reference.
// Anchor: https://rust-lang.github.io/rustfmt/?version=v1.6.0

module v4.extdeps.formatters.rustfmt


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtIndentStyle
  = RustfmtIndentBlock
  | RustfmtIndentVisual


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtBraceStyle
  = RustfmtBraceAlwaysNextLine
  | RustfmtBracePreferSameLine
  | RustfmtBraceSameLineWhere


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtControlBraceStyle
  = RustfmtControlBraceAlwaysSameLine
  | RustfmtControlBraceAlwaysNextLine
  | RustfmtControlBraceClosingNextLine


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtTrailingComma
  = RustfmtTrailingCommaAlways
  | RustfmtTrailingCommaNever
  | RustfmtTrailingCommaVertical


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtMatchArmLeadingPipes
  = RustfmtMatchPipesAlways
  | RustfmtMatchPipesNever
  | RustfmtMatchPipesPreserve


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtImportsGranularity
  = RustfmtImportsGranularityPreserve
  | RustfmtImportsGranularityCrate
  | RustfmtImportsGranularityModule
  | RustfmtImportsGranularityItem
  | RustfmtImportsGranularityOne


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtGroupImports
  = RustfmtGroupImportsPreserve
  | RustfmtGroupImportsStdExternalCrate
  | RustfmtGroupImportsOne


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtImportsLayout
  = RustfmtImportsMixed
  | RustfmtImportsHorizontal
  | RustfmtImportsVertical
  | RustfmtImportsHorizontalVertical


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtFnParamsLayout
  = RustfmtFnParamsCompressed
  | RustfmtFnParamsTall
  | RustfmtFnParamsVertical


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtNewlineStyle
  = RustfmtNewlineAuto
  | RustfmtNewlineUnix
  | RustfmtNewlineWindows
  | RustfmtNewlineNative


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// v1.6.0 src/config/options.rs Edition enum: "2015", "2018", "2021", "2024" — four arms (Configurations.md omits "2024" but source is authoritative).
type RustfmtEdition
  = RustfmtEdition2015
  | RustfmtEdition2018
  | RustfmtEdition2021
  | RustfmtEdition2024


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtSmallHeuristics
  = RustfmtHeuristicsDefault
  | RustfmtHeuristicsOff
  | RustfmtHeuristicsMax


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtHexLiteralCase
  = RustfmtHexPreserve
  | RustfmtHexUpper
  | RustfmtHexLower


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// Which formatting rule set to apply (v1.6.0 documents One and Two).
type RustfmtVersion
  = RustfmtVersionOne
  | RustfmtVersionTwo


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtBinopSeparator
  = RustfmtBinopFront
  | RustfmtBinopBack


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtColor
  = RustfmtColorAuto
  | RustfmtColorAlways
  | RustfmtColorNever


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtImportsIndent
  = RustfmtImportsIndentBlock
  | RustfmtImportsIndentVisual


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustfmtTypePunctuationDensity
  = RustfmtTypePunctuationWide
  | RustfmtTypePunctuationCompressed


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// v1.6.0 documents skip_macro_invocations as macro name idents plus the special "*" selector (skip all).
// List<String> would lose this structural distinction; model the two arms explicitly.
// 🟡 gated — feature: rustfmt-macro-name-refinement — bind T-25-core — dissolve-on-arrival: replace name: String in RustfmtMacroNamed with Refined<String> whose predicate excludes "*" and non-identifier strings (name must be a valid Rust macro ident); forbidden: treating RustfmtMacroNamed.name as unconstrained — it must not admit the "*" sentinel representable by RustfmtMacroAll.
type RustfmtMacroSelector
  = RustfmtMacroAll
  | RustfmtMacroNamed { name: String }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// v1.6.0 default is the compiled-in CARGO_PKG_VERSION (installed version); possible configured values
// are published version strings like "0.3.8". Encoding the compile-time expression as a String sentinel
// would admit an invalid config value and lose set-vs-default semantics.
// 🟡 gated — feature: rustfmt-version-string-refinement — bind T-25-core — dissolve-on-arrival: replace version: String in RustfmtVersionPinned with Refined<String> whose predicate validates it as a published semver version string (e.g. "0.3.8"); forbidden: treating version as unconstrained — it must match the published-version format rustfmt v1.6.0 documents.
type RustfmtRequiredVersion
  = RustfmtVersionInstalled
  | RustfmtVersionPinned { version: String }


// 🟡 gated — feature: formatter-int-refinement — bind T-25-core — dissolve-on-arrival: replace annotated Int fields with Refined<Int> via T-25-core refine substrate; each field's ≥0/≥1 annotation becomes the validation predicate; forbidden: UInt/Nat for config literals (Peano representation makes integer data nodes impractical).
// 🟡 gated — feature: formatter-cross-field-constraints — bind T-4.16 follow-on — dissolve-on-arrival: RustfmtConfigValidation witness checks max_width ≥ {chain_width,array_width,fn_call_width,attr_fn_like_width,struct_lit_width,struct_variant_width,single_line_if_else_max_width,single_line_let_else_max_width,short_array_element_width_threshold,doc_comment_code_block_width}; comment_width excluded — v1.6.0 documents it as "any positive integer" with no max_width upper bound (0 causes wrap_comments to apply regardless of line width); forbidden: ad-hoc cross-field guards outside validation substrate.
// 🟡 gated — feature: rustfmt-deprecated-alias — bind T-4.16 follow-on — dissolve-on-arrival: merge_imports and fn_args_layout are deprecated v1.6.0 aliases retained for P1 faithfulness; both are subsumed by their canonical counterparts (imports_granularity and fn_params_layout respectively); precedence rule: canonical field wins when both are set; forbidden: treating either alias as an independent authoritative fact separate from its canonical field.
// 🟡 gated — feature: rustfmt-unstable-option-validity — bind T-4.16 follow-on — dissolve-on-arrival: RustfmtConfigValidation witness enforces that all fields marked "Stable: No" in the v1.6.0 reference (see anchor) carry their default value when unstable_features=false; the complete unstable-field list is enumerable from the anchor; forbidden: treating unstable fields as unconstrained regardless of the unstable_features flag value.
type RustfmtConfig {
  // Indentation
  indent_style: RustfmtIndentStyle
  tab_spaces: Int    // 🟡 gated: formatter-int-refinement — must be ≥1
  hard_tabs: Bool

  // Line width
  max_width: Int     // 🟡 gated: formatter-int-refinement — must be ≥1
  comment_width: Int // 🟡 gated: formatter-int-refinement — must be ≥0 (0 causes wrap_comments to apply regardless of line width; see anchor); no max_width upper-bound — v1.6.0 "any positive integer"
  chain_width: Int   // 🟡 gated: formatter-int-refinement — must be ≥1 and ≤ max_width
  single_line_if_else_max_width: Int // 🟡 gated: formatter-int-refinement — must be ≥0 and ≤ max_width
  single_line_let_else_max_width: Int // 🟡 gated: formatter-int-refinement — must be ≥0 and ≤ max_width
  fn_call_width: Int     // 🟡 gated: formatter-int-refinement — must be ≥1 and ≤ max_width
  attr_fn_like_width: Int  // 🟡 gated: formatter-int-refinement — must be ≥1 and ≤ max_width
  struct_lit_width: Int    // 🟡 gated: formatter-int-refinement — must be ≥0 and ≤ max_width
  struct_variant_width: Int  // 🟡 gated: formatter-int-refinement — must be ≥0 and ≤ max_width
  array_width: Int       // 🟡 gated: formatter-int-refinement — must be ≥1 and ≤ max_width
  short_array_element_width_threshold: Int // 🟡 gated: formatter-int-refinement — must be ≥1 and ≤ max_width

  // Braces
  brace_style: RustfmtBraceStyle
  control_brace_style: RustfmtControlBraceStyle
  where_single_line: Bool

  // Commas / semicolons
  trailing_comma: RustfmtTrailingComma
  trailing_semicolon: Bool
  match_arm_leading_pipes: RustfmtMatchArmLeadingPipes
  match_arm_blocks: Bool
  match_block_trailing_comma: Bool

  // Imports
  imports_granularity: RustfmtImportsGranularity
  group_imports: RustfmtGroupImports
  imports_layout: RustfmtImportsLayout
  imports_indent: RustfmtImportsIndent
  reorder_imports: Bool
  merge_imports: Bool // 🟡 gated: rustfmt-deprecated-alias — deprecated bool alias for imports_granularity=Crate; canonical field imports_granularity wins when both are set

  // Functions / params
  fn_params_layout: RustfmtFnParamsLayout
  fn_args_layout: RustfmtFnParamsLayout // 🟡 gated: rustfmt-deprecated-alias — deprecated former name for fn_params_layout; canonical field fn_params_layout wins when both are set
  fn_single_line: Bool
  inline_attribute_width: Int // 🟡 gated: formatter-int-refinement — must be ≥0

  // Modules
  reorder_modules: Bool
  reorder_impl_items: Bool

  // Newlines and blanks
  newline_style: RustfmtNewlineStyle
  blank_lines_upper_bound: Int  // 🟡 gated: formatter-int-refinement — must be ≥0
  blank_lines_lower_bound: Int  // 🟡 gated: formatter-int-refinement — must be ≥0

  // Comments and docs
  wrap_comments: Bool
  normalize_comments: Bool
  normalize_doc_attributes: Bool
  format_strings: Bool
  format_code_in_doc_comments: Bool
  doc_comment_code_block_width: Int // 🟡 gated: formatter-int-refinement — must be ≥1 and ≤ max_width
  format_generated_files: Bool
  hide_parse_errors: Bool

  // Derives / attributes / shorthand
  merge_derives: Bool
  use_field_init_shorthand: Bool
  use_try_shorthand: Bool
  force_explicit_abi: Bool

  // Macros
  format_macro_matchers: Bool
  format_macro_bodies: Bool

  // Binary operations
  binop_separator: RustfmtBinopSeparator

  // Misc
  use_small_heuristics: RustfmtSmallHeuristics
  overflow_delimited_expr: Bool
  remove_nested_parens: Bool
  combine_control_expr: Bool
  hex_literal_case: RustfmtHexLiteralCase
  enum_discrim_align_threshold: Int // 🟡 gated: formatter-int-refinement — must be ≥0
  struct_field_align_threshold: Int // 🟡 gated: formatter-int-refinement — must be ≥0
  spaces_around_ranges: Bool
  space_after_colon: Bool
  space_before_colon: Bool
  empty_item_single_line: Bool
  struct_lit_single_line: Bool
  condense_wildcard_suffixes: Bool
  force_multiline_blocks: Bool
  error_on_line_overflow: Bool
  error_on_unformatted: Bool
  skip_children: Bool
  skip_macro_invocations: List<RustfmtMacroSelector>
  type_punctuation_density: RustfmtTypePunctuationDensity
  disable_all_formatting: Bool
  color: RustfmtColor
  edition: RustfmtEdition
  version: RustfmtVersion
  unstable_features: Bool
  required_version: RustfmtRequiredVersion
  ignore: List<String> // 🟡 gated: rustfmt-ignore-path-refinement — bind T-4.16 follow-on — dissolve-on-arrival: replace List<String> with List<Refined<String>> whose predicate validates gitignore-format path patterns with Unix '/' separators (v1.6.0 explicitly excludes Windows backslash paths); forbidden: treating ignore elements as unconstrained strings.
}


// Official rustfmt 1.6 defaults. edition field defaults to 2015 per rustfmt spec regardless of project edition.
data rustfmt_defaults: RustfmtConfig = RustfmtConfig {
  indent_style: RustfmtIndentBlock,
  tab_spaces: 4,
  hard_tabs: false,

  max_width: 100,
  comment_width: 80,
  chain_width: 60,
  single_line_if_else_max_width: 50,
  single_line_let_else_max_width: 50,
  fn_call_width: 60,
  attr_fn_like_width: 70,
  struct_lit_width: 18,
  struct_variant_width: 35,
  array_width: 60,
  short_array_element_width_threshold: 10,

  brace_style: RustfmtBraceSameLineWhere,
  control_brace_style: RustfmtControlBraceAlwaysSameLine,
  where_single_line: false,

  trailing_comma: RustfmtTrailingCommaVertical,
  trailing_semicolon: true,
  match_arm_leading_pipes: RustfmtMatchPipesNever,
  match_arm_blocks: true,
  match_block_trailing_comma: false,

  imports_granularity: RustfmtImportsGranularityPreserve,
  group_imports: RustfmtGroupImportsPreserve,
  imports_layout: RustfmtImportsMixed,
  imports_indent: RustfmtImportsIndentBlock,
  reorder_imports: true,
  merge_imports: false,

  fn_params_layout: RustfmtFnParamsTall,
  fn_args_layout: RustfmtFnParamsTall,
  fn_single_line: false,
  inline_attribute_width: 0,

  reorder_modules: true,
  reorder_impl_items: false,

  newline_style: RustfmtNewlineAuto,
  blank_lines_upper_bound: 1,
  blank_lines_lower_bound: 0,

  wrap_comments: false,
  normalize_comments: false,
  normalize_doc_attributes: false,
  format_strings: false,
  format_code_in_doc_comments: false,
  doc_comment_code_block_width: 100,
  format_generated_files: true,
  hide_parse_errors: false,

  merge_derives: true,
  use_field_init_shorthand: false,
  use_try_shorthand: false,
  force_explicit_abi: true,

  format_macro_matchers: false,
  format_macro_bodies: true,

  binop_separator: RustfmtBinopFront,

  use_small_heuristics: RustfmtHeuristicsDefault,
  overflow_delimited_expr: false,
  remove_nested_parens: true,
  combine_control_expr: true,
  hex_literal_case: RustfmtHexPreserve,
  enum_discrim_align_threshold: 0,
  struct_field_align_threshold: 0,
  spaces_around_ranges: false,
  space_after_colon: true,
  space_before_colon: false,
  empty_item_single_line: true,
  struct_lit_single_line: true,
  condense_wildcard_suffixes: false,
  force_multiline_blocks: false,
  error_on_line_overflow: false,
  error_on_unformatted: false,
  skip_children: false,
  skip_macro_invocations: [],
  type_punctuation_density: RustfmtTypePunctuationWide,
  disable_all_formatting: false,
  color: RustfmtColorAuto,
  edition: RustfmtEdition2015,
  version: RustfmtVersionOne,
  unstable_features: false,
  required_version: RustfmtVersionInstalled,
  ignore: [],
}


// 🟡 gated — feature: formatter-config-patch — bind T-4.16 follow-on — dissolve-on-arrival: RustfmtConfigPatch type with per-field Override<T>/Inherit arms replaces full-config layering; forbidden: full-config replacement where partial field override is needed.
fn rustfmt_layer(base: RustfmtConfig, outer: RustfmtConfig) -> RustfmtConfig {
  outer
}
