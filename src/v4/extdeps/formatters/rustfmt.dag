fn rustfmt_layer(base: RustfmtConfig, patch: RustfmtConfigPatch) -> RustfmtConfig {
  RustfmtConfig {
    indent_style: apply_field_patch(base: base.indent_style, patch: patch.indent_style),
    tab_spaces: apply_field_patch(base: base.tab_spaces, patch: patch.tab_spaces),
    hard_tabs: apply_field_patch(base: base.hard_tabs, patch: patch.hard_tabs),
    max_width: apply_field_patch(base: base.max_width, patch: patch.max_width),
    comment_width: apply_field_patch(base: base.comment_width, patch: patch.comment_width),
    chain_width: apply_field_patch(base: base.chain_width, patch: patch.chain_width),
    single_line_if_else_max_width: apply_field_patch(base: base.single_line_if_else_max_width, patch: patch.single_line_if_else_max_width),
    single_line_let_else_max_width: apply_field_patch(base: base.single_line_let_else_max_width, patch: patch.single_line_let_else_max_width),
    fn_call_width: apply_field_patch(base: base.fn_call_width, patch: patch.fn_call_width),
    attr_fn_like_width: apply_field_patch(base: base.attr_fn_like_width, patch: patch.attr_fn_like_width),
    struct_lit_width: apply_field_patch(base: base.struct_lit_width, patch: patch.struct_lit_width),
    struct_variant_width: apply_field_patch(base: base.struct_variant_width, patch: patch.struct_variant_width),
    array_width: apply_field_patch(base: base.array_width, patch: patch.array_width),
    short_array_element_width_threshold: apply_field_patch(base: base.short_array_element_width_threshold, patch: patch.short_array_element_width_threshold),
    brace_style: apply_field_patch(base: base.brace_style, patch: patch.brace_style),
    control_brace_style: apply_field_patch(base: base.control_brace_style, patch: patch.control_brace_style),
    where_single_line: apply_field_patch(base: base.where_single_line, patch: patch.where_single_line),
    trailing_comma: apply_field_patch(base: base.trailing_comma, patch: patch.trailing_comma),
    trailing_semicolon: apply_field_patch(base: base.trailing_semicolon, patch: patch.trailing_semicolon),
    match_arm_leading_pipes: apply_field_patch(base: base.match_arm_leading_pipes, patch: patch.match_arm_leading_pipes),
    match_arm_blocks: apply_field_patch(base: base.match_arm_blocks, patch: patch.match_arm_blocks),
    match_block_trailing_comma: apply_field_patch(base: base.match_block_trailing_comma, patch: patch.match_block_trailing_comma),
    imports_granularity: apply_field_patch(base: base.imports_granularity, patch: patch.imports_granularity),
    group_imports: apply_field_patch(base: base.group_imports, patch: patch.group_imports),
    imports_layout: apply_field_patch(base: base.imports_layout, patch: patch.imports_layout),
    imports_indent: apply_field_patch(base: base.imports_indent, patch: patch.imports_indent),
    reorder_imports: apply_field_patch(base: base.reorder_imports, patch: patch.reorder_imports),
    merge_imports: apply_field_patch(base: base.merge_imports, patch: patch.merge_imports),
    fn_params_layout: apply_field_patch(base: base.fn_params_layout, patch: patch.fn_params_layout),
    fn_args_layout: apply_field_patch(base: base.fn_args_layout, patch: patch.fn_args_layout),
    fn_single_line: apply_field_patch(base: base.fn_single_line, patch: patch.fn_single_line),
    inline_attribute_width: apply_field_patch(base: base.inline_attribute_width, patch: patch.inline_attribute_width),
    reorder_modules: apply_field_patch(base: base.reorder_modules, patch: patch.reorder_modules),
    reorder_impl_items: apply_field_patch(base: base.reorder_impl_items, patch: patch.reorder_impl_items),
    newline_style: apply_field_patch(base: base.newline_style, patch: patch.newline_style),
    blank_lines_upper_bound: apply_field_patch(base: base.blank_lines_upper_bound, patch: patch.blank_lines_upper_bound),
    blank_lines_lower_bound: apply_field_patch(base: base.blank_lines_lower_bound, patch: patch.blank_lines_lower_bound),
    wrap_comments: apply_field_patch(base: base.wrap_comments, patch: patch.wrap_comments),
    normalize_comments: apply_field_patch(base: base.normalize_comments, patch: patch.normalize_comments),
    normalize_doc_attributes: apply_field_patch(base: base.normalize_doc_attributes, patch: patch.normalize_doc_attributes),
    format_strings: apply_field_patch(base: base.format_strings, patch: patch.format_strings),
    format_code_in_doc_comments: apply_field_patch(base: base.format_code_in_doc_comments, patch: patch.format_code_in_doc_comments),
    doc_comment_code_block_width: apply_field_patch(base: base.doc_comment_code_block_width, patch: patch.doc_comment_code_block_width),
    format_generated_files: apply_field_patch(base: base.format_generated_files, patch: patch.format_generated_files),
    hide_parse_errors: apply_field_patch(base: base.hide_parse_errors, patch: patch.hide_parse_errors),
    merge_derives: apply_field_patch(base: base.merge_derives, patch: patch.merge_derives),
    use_field_init_shorthand: apply_field_patch(base: base.use_field_init_shorthand, patch: patch.use_field_init_shorthand),
    use_try_shorthand: apply_field_patch(base: base.use_try_shorthand, patch: patch.use_try_shorthand),
    force_explicit_abi: apply_field_patch(base: base.force_explicit_abi, patch: patch.force_explicit_abi),
    format_macro_matchers: apply_field_patch(base: base.format_macro_matchers, patch: patch.format_macro_matchers),
    format_macro_bodies: apply_field_patch(base: base.format_macro_bodies, patch: patch.format_macro_bodies),
    binop_separator: apply_field_patch(base: base.binop_separator, patch: patch.binop_separator),
    use_small_heuristics: apply_field_patch(base: base.use_small_heuristics, patch: patch.use_small_heuristics),
    overflow_delimited_expr: apply_field_patch(base: base.overflow_delimited_expr, patch: patch.overflow_delimited_expr),
    remove_nested_parens: apply_field_patch(base: base.remove_nested_parens, patch: patch.remove_nested_parens),
    combine_control_expr: apply_field_patch(base: base.combine_control_expr, patch: patch.combine_control_expr),
    hex_literal_case: apply_field_patch(base: base.hex_literal_case, patch: patch.hex_literal_case),
    enum_discrim_align_threshold: apply_field_patch(base: base.enum_discrim_align_threshold, patch: patch.enum_discrim_align_threshold),
    struct_field_align_threshold: apply_field_patch(base: base.struct_field_align_threshold, patch: patch.struct_field_align_threshold),
    spaces_around_ranges: apply_field_patch(base: base.spaces_around_ranges, patch: patch.spaces_around_ranges),
