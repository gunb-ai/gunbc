// Status: T-4.16 scaffold — style toggle grounded in google-java-format README.
// Anchor: https://github.com/google/google-java-format

module v4.extdeps.formatters.google_java_format

import v4.std.patch { FieldPatch, apply_field_patch }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type GoogleJavaFormatStyle
  = GoogleJavaFormatGoogle
  | GoogleJavaFormatAosp


type GoogleJavaFormatConfig {
  style: GoogleJavaFormatStyle,
}


data google_java_format_defaults: GoogleJavaFormatConfig = GoogleJavaFormatConfig {
  style: GoogleJavaFormatGoogle,
}


// 🟡 gated — consumer:config-patch-record-projection — bind v4.std.patch feature:config-patch-record-projection — dissolve-on-arrival: GoogleJavaFormatConfigPatch projected from GoogleJavaFormatConfig field set.
type GoogleJavaFormatConfigPatch {
  style: FieldPatch<GoogleJavaFormatStyle>
}


fn google_java_format_layer(base: GoogleJavaFormatConfig, patch: GoogleJavaFormatConfigPatch) -> GoogleJavaFormatConfig {
  GoogleJavaFormatConfig {
    style: apply_field_patch(base: base.style, patch: patch.style),
  }
}
