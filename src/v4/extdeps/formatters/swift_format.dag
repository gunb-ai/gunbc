// src/v4/extdeps/formatters/swift_format.dag
// Scope: swift-format formatting configuration model — formatting knobs only; rules carrier excluded (see gate below).
// Status: T-4.16 scaffold — formatting-knob option space grounded in swift-format Configuration.md; rules field gated pending Map primitive availability.
// Anchor: https://github.com/apple/swift-format/blob/main/Documentation/Configuration.md

module v4.extdeps.formatters.swift_format

import v4.std.collection { List }
import v4.std.diagnostic { Outcome }
import v4.std.patch { FieldPatch, apply_field_patch }
import v4.std.refinement {
  ExactOneInt,
  NonNegativeInt,
  PositiveInt,
  exact_one_int_authoritative_literal,
  non_negative_int_authoritative_literal,
  positive_int_authoritative_literal,
}



// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SwiftFormatIndentation
  = SwiftFormatSpaces { count: Outcome<PositiveInt> }
  | SwiftFormatTabs { count: Outcome<PositiveInt> }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SwiftFormatFileScopedAccessLevel
  = SwiftFormatPrivate
  | SwiftFormatFileprivate


type SwiftFormatFileScopedDeclarationPrivacy {
  access_level: SwiftFormatFileScopedAccessLevel,
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SwiftFormatTrailingCommaBehavior
  = SwiftFormatTrailingCommaAlwaysUsed
  | SwiftFormatTrailingCommaNeverUsed
  | SwiftFormatTrailingCommaKeptAsWritten


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SwiftFormatMultilineStringReflow
  = SwiftFormatReflowNever
  | SwiftFormatReflowOnlyLinesOverLength
  | SwiftFormatReflowAlways


type SwiftFormatNoAssignmentInExpressions {
  allowed_functions: List<String>,
}


type SwiftFormatOrderedImports {
  include_conditional_imports: Bool,
  should_group_imports: Bool,
}


// 🟡 gated — feature: swift-format-rules-carrier — bind T-4.16 follow-on — dissolve-on-arrival: add rules: Map<String, Bool> field to SwiftFormatConfig once Map is available as a language-level primitive without requiring a std import; forbidden: List<SwiftFormatRuleOverride> workarounds that lose the Bool-keyed semantics of the rules dictionary.
type SwiftFormatConfig {
  version: Outcome<ExactOneInt>
  line_length: Outcome<PositiveInt>
  indentation: SwiftFormatIndentation,
  tab_width: Outcome<PositiveInt>
  maximum_blank_lines: Outcome<NonNegativeInt>
  spaces_before_end_of_line_comments: Outcome<NonNegativeInt>
  respects_existing_line_breaks: Bool,
  line_break_before_control_flow_keywords: Bool,
  line_break_before_each_argument: Bool,
  line_break_before_each_generic_requirement: Bool,
  line_break_between_declaration_attributes: Bool,
  prioritize_keeping_function_output_together: Bool,
  indent_conditional_compilation_blocks: Bool,
  line_break_around_multiline_expression_chain_components: Bool,
  file_scoped_declaration_privacy: SwiftFormatFileScopedDeclarationPrivacy,
  indent_switch_case_labels: Bool,
  spaces_around_range_formation_operators: Bool,
  no_assignment_in_expressions: SwiftFormatNoAssignmentInExpressions,
  multiline_trailing_comma_behavior: SwiftFormatTrailingCommaBehavior,
  multi_element_collection_trailing_commas: Bool,
  reflow_multiline_string_literals: SwiftFormatMultilineStringReflow,
  indent_blank_lines: Bool,
  ordered_imports: SwiftFormatOrderedImports,
}


data swift_format_defaults: SwiftFormatConfig = SwiftFormatConfig {
  version: exact_one_int_authoritative_literal(value: 1),
  line_length: positive_int_authoritative_literal(value: 100),
  indentation: SwiftFormatSpaces { count: positive_int_authoritative_literal(value: 2) },
  tab_width: positive_int_authoritative_literal(value: 8),
  maximum_blank_lines: non_negative_int_authoritative_literal(value: 1),
  spaces_before_end_of_line_comments: non_negative_int_authoritative_literal(value: 2),
  respects_existing_line_breaks: true,
  line_break_before_control_flow_keywords: false,
  line_break_before_each_argument: false,
  line_break_before_each_generic_requirement: false,
  line_break_between_declaration_attributes: false,
  prioritize_keeping_function_output_together: false,
  indent_conditional_compilation_blocks: true,
  line_break_around_multiline_expression_chain_components: false,
  file_scoped_declaration_privacy: SwiftFormatFileScopedDeclarationPrivacy {
    access_level: SwiftFormatPrivate,
  },
  indent_switch_case_labels: false,
  spaces_around_range_formation_operators: false,
  no_assignment_in_expressions: SwiftFormatNoAssignmentInExpressions {
    allowed_functions: ["XCTAssertNoThrow"],
  },
  multiline_trailing_comma_behavior: SwiftFormatTrailingCommaKeptAsWritten,
  multi_element_collection_trailing_commas: true,
  reflow_multiline_string_literals: SwiftFormatReflowNever,
  indent_blank_lines: false,
  ordered_imports: SwiftFormatOrderedImports {
    include_conditional_imports: false,
    should_group_imports: true,
  },
}


// 🟡 gated — consumer:config-patch-record-projection — bind v4.std.patch feature:config-patch-record-projection — dissolve-on-arrival: SwiftFormatConfigPatch projected from SwiftFormatConfig field set.
type SwiftFormatConfigPatch {
  version: FieldPatch<Outcome<ExactOneInt>>
  line_length: FieldPatch<Outcome<PositiveInt>>
  indentation: FieldPatch<SwiftFormatIndentation>
  tab_width: FieldPatch<Outcome<PositiveInt>>
  maximum_blank_lines: FieldPatch<Outcome<NonNegativeInt>>
  spaces_before_end_of_line_comments: FieldPatch<Outcome<NonNegativeInt>>
  respects_existing_line_breaks: FieldPatch<Bool>
  line_break_before_control_flow_keywords: FieldPatch<Bool>
  line_break_before_each_argument: FieldPatch<Bool>
  line_break_before_each_generic_requirement: FieldPatch<Bool>
  line_break_between_declaration_attributes: FieldPatch<Bool>
  prioritize_keeping_function_output_together: FieldPatch<Bool>
  indent_conditional_compilation_blocks: FieldPatch<Bool>
  line_break_around_multiline_expression_chain_components: FieldPatch<Bool>
  file_scoped_declaration_privacy: FieldPatch<SwiftFormatFileScopedDeclarationPrivacy>
  indent_switch_case_labels: FieldPatch<Bool>
  spaces_around_range_formation_operators: FieldPatch<Bool>
  no_assignment_in_expressions: FieldPatch<SwiftFormatNoAssignmentInExpressions>
  multiline_trailing_comma_behavior: FieldPatch<SwiftFormatTrailingCommaBehavior>
  multi_element_collection_trailing_commas: FieldPatch<Bool>
  reflow_multiline_string_literals: FieldPatch<SwiftFormatMultilineStringReflow>
  indent_blank_lines: FieldPatch<Bool>
  ordered_imports: FieldPatch<SwiftFormatOrderedImports>
}


fn swift_format_layer(base: SwiftFormatConfig, patch: SwiftFormatConfigPatch) -> SwiftFormatConfig {
  SwiftFormatConfig {
    version: apply_field_patch(base: base.version, patch: patch.version),
    line_length: apply_field_patch(base: base.line_length, patch: patch.line_length),
    indentation: apply_field_patch(base: base.indentation, patch: patch.indentation),
    tab_width: apply_field_patch(base: base.tab_width, patch: patch.tab_width),
    maximum_blank_lines: apply_field_patch(base: base.maximum_blank_lines, patch: patch.maximum_blank_lines),
    spaces_before_end_of_line_comments: apply_field_patch(base: base.spaces_before_end_of_line_comments, patch: patch.spaces_before_end_of_line_comments),
    respects_existing_line_breaks: apply_field_patch(base: base.respects_existing_line_breaks, patch: patch.respects_existing_line_breaks),
    line_break_before_control_flow_keywords: apply_field_patch(base: base.line_break_before_control_flow_keywords, patch: patch.line_break_before_control_flow_keywords),
    line_break_before_each_argument: apply_field_patch(base: base.line_break_before_each_argument, patch: patch.line_break_before_each_argument),
    line_break_before_each_generic_requirement: apply_field_patch(base: base.line_break_before_each_generic_requirement, patch: patch.line_break_before_each_generic_requirement),
    line_break_between_declaration_attributes: apply_field_patch(base: base.line_break_between_declaration_attributes, patch: patch.line_break_between_declaration_attributes),
    prioritize_keeping_function_output_together: apply_field_patch(base: base.prioritize_keeping_function_output_together, patch: patch.prioritize_keeping_function_output_together),
    indent_conditional_compilation_blocks: apply_field_patch(base: base.indent_conditional_compilation_blocks, patch: patch.indent_conditional_compilation_blocks),
    line_break_around_multiline_expression_chain_components: apply_field_patch(base: base.line_break_around_multiline_expression_chain_components, patch: patch.line_break_around_multiline_expression_chain_components),
    file_scoped_declaration_privacy: apply_field_patch(base: base.file_scoped_declaration_privacy, patch: patch.file_scoped_declaration_privacy),
    indent_switch_case_labels: apply_field_patch(base: base.indent_switch_case_labels, patch: patch.indent_switch_case_labels),
    spaces_around_range_formation_operators: apply_field_patch(base: base.spaces_around_range_formation_operators, patch: patch.spaces_around_range_formation_operators),
    no_assignment_in_expressions: apply_field_patch(base: base.no_assignment_in_expressions, patch: patch.no_assignment_in_expressions),
    multiline_trailing_comma_behavior: apply_field_patch(base: base.multiline_trailing_comma_behavior, patch: patch.multiline_trailing_comma_behavior),
    multi_element_collection_trailing_commas: apply_field_patch(base: base.multi_element_collection_trailing_commas, patch: patch.multi_element_collection_trailing_commas),
    reflow_multiline_string_literals: apply_field_patch(base: base.reflow_multiline_string_literals, patch: patch.reflow_multiline_string_literals),
    indent_blank_lines: apply_field_patch(base: base.indent_blank_lines, patch: patch.indent_blank_lines),
    ordered_imports: apply_field_patch(base: base.ordered_imports, patch: patch.ordered_imports),
  }
}
