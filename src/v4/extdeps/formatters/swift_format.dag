// src/v4/extdeps/formatters/swift_format.dag
// Scope: swift-format formatting configuration model — formatting knobs only; rules carrier excluded (see gate below).
// Status: T-4.16 scaffold — formatting-knob option space grounded in swift-format Configuration.md; rules field gated pending Map primitive availability.
// Anchor: https://github.com/apple/swift-format/blob/main/Documentation/Configuration.md

module v4.extdeps.formatters.swift_format

import v4.std.diagnostic { Locus, Outcome }
import v4.std.node { Symbol }
import v4.std.patch { ConfigPatchRecord, config_patch_layer }
import v4.std.refinement { Refined, Validation, refine }


type SwiftFormatPositiveInt = Refined<Int>


data swift_format_positive_int_out_of_range: Symbol = swift_format_positive_int_out_of_range


fn swift_format_positive_int_admits(value: Int) -> Bool {
  value >= 1
}


data swift_format_positive_int_validation: Validation<Int> = Validation {
  reason: swift_format_positive_int_out_of_range,
  admits: swift_format_positive_int_admits
}


fn make_swift_format_positive_int(value: Int, at: Locus) -> Outcome<SwiftFormatPositiveInt> {
  refine(base: value, by: swift_format_positive_int_validation, at: at)
}


type SwiftFormatNonNegInt = Refined<Int>


data swift_format_non_neg_int_out_of_range: Symbol = swift_format_non_neg_int_out_of_range


fn swift_format_non_neg_int_admits(value: Int) -> Bool {
  value >= 0
}


data swift_format_non_neg_int_validation: Validation<Int> = Validation {
  reason: swift_format_non_neg_int_out_of_range,
  admits: swift_format_non_neg_int_admits
}


fn make_swift_format_non_neg_int(value: Int, at: Locus) -> Outcome<SwiftFormatNonNegInt> {
  refine(base: value, by: swift_format_non_neg_int_validation, at: at)
}


type SwiftFormatVersion = Refined<Int>


data swift_format_version_out_of_range: Symbol = swift_format_version_out_of_range


fn swift_format_version_admits(value: Int) -> Bool {
  value == 1
}


data swift_format_version_validation: Validation<Int> = Validation {
  reason: swift_format_version_out_of_range,
  admits: swift_format_version_admits
}


fn make_swift_format_version(value: Int, at: Locus) -> Outcome<SwiftFormatVersion> {
  refine(base: value, by: swift_format_version_validation, at: at)
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SwiftFormatIndentation
  = SwiftFormatSpaces { count: SwiftFormatPositiveInt }
  | SwiftFormatTabs { count: SwiftFormatPositiveInt }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SwiftFormatFileScopedAccessLevel
  = SwiftFormatPrivate
  | SwiftFormatFileprivate


type SwiftFormatFileScopedDeclarationPrivacy {
  access_level: SwiftFormatFileScopedAccessLevel,
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SwiftFormatTrailingCommaBehavior
  = SwiftFormatTrailingCommaAlwaysUsed
  | SwiftFormatTrailingCommaNeverUsed
  | SwiftFormatTrailingCommaKeptAsWritten


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SwiftFormatMultilineStringReflow
  = SwiftFormatReflowNever
  | SwiftFormatReflowOnlyLinesOverLength
  | SwiftFormatReflowAlways


type SwiftFormatNoAssignmentInExpressions {
  allowed_functions: List<String>,
}


type SwiftFormatOrderedImports {
  include_conditional_imports: Bool,
  should_group_imports: Bool,
}


// 🟡 gated — feature: swift-format-rules-carrier — bind T-4.16 follow-on — dissolve-on-arrival: add rules: Map<String, Bool> field to SwiftFormatConfig once Map is available as a language-level primitive without requiring a std import; forbidden: List<SwiftFormatRuleOverride> workarounds that lose the Bool-keyed semantics of the rules dictionary.
type SwiftFormatConfig {
  version: SwiftFormatVersion
  line_length: SwiftFormatPositiveInt
  indentation: SwiftFormatIndentation,
  tab_width: SwiftFormatPositiveInt
  maximum_blank_lines: SwiftFormatNonNegInt
  spaces_before_end_of_line_comments: SwiftFormatNonNegInt
  respects_existing_line_breaks: Bool,
  line_break_before_control_flow_keywords: Bool,
  line_break_before_each_argument: Bool,
  line_break_before_each_generic_requirement: Bool,
  line_break_between_declaration_attributes: Bool,
  prioritize_keeping_function_output_together: Bool,
  indent_conditional_compilation_blocks: Bool,
  line_break_around_multiline_expression_chain_components: Bool,
  file_scoped_declaration_privacy: SwiftFormatFileScopedDeclarationPrivacy,
  indent_switch_case_labels: Bool,
  spaces_around_range_formation_operators: Bool,
  no_assignment_in_expressions: SwiftFormatNoAssignmentInExpressions,
  multiline_trailing_comma_behavior: SwiftFormatTrailingCommaBehavior,
  multi_element_collection_trailing_commas: Bool,
  reflow_multiline_string_literals: SwiftFormatMultilineStringReflow,
  indent_blank_lines: Bool,
  ordered_imports: SwiftFormatOrderedImports,
}


data swift_format_defaults: SwiftFormatConfig = SwiftFormatConfig {
  version: Refined { base: 1 },
  line_length: Refined { base: 100 },
  indentation: SwiftFormatSpaces { count: Refined { base: 2 } },
  tab_width: Refined { base: 8 },
  maximum_blank_lines: Refined { base: 1 },
  spaces_before_end_of_line_comments: Refined { base: 2 },
  respects_existing_line_breaks: true,
  line_break_before_control_flow_keywords: false,
  line_break_before_each_argument: false,
  line_break_before_each_generic_requirement: false,
  line_break_between_declaration_attributes: false,
  prioritize_keeping_function_output_together: false,
  indent_conditional_compilation_blocks: true,
  line_break_around_multiline_expression_chain_components: false,
  file_scoped_declaration_privacy: SwiftFormatFileScopedDeclarationPrivacy {
    access_level: SwiftFormatPrivate,
  },
  indent_switch_case_labels: false,
  spaces_around_range_formation_operators: false,
  no_assignment_in_expressions: SwiftFormatNoAssignmentInExpressions {
    allowed_functions: ["XCTAssertNoThrow"],
  },
  multiline_trailing_comma_behavior: SwiftFormatTrailingCommaKeptAsWritten,
  multi_element_collection_trailing_commas: true,
  reflow_multiline_string_literals: SwiftFormatReflowNever,
  indent_blank_lines: false,
  ordered_imports: SwiftFormatOrderedImports {
    include_conditional_imports: false,
    should_group_imports: true,
  },
}


type SwiftFormatConfigPatch = ConfigPatchRecord<SwiftFormatConfig>


fn swift_format_layer(base: SwiftFormatConfig, patch: SwiftFormatConfigPatch) -> SwiftFormatConfig {
  config_patch_layer(base: base, patch: patch)
}
