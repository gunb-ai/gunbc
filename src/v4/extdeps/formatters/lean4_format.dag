// src/v4/extdeps/formatters/lean4_format.dag
// Scope: Lean 4 formatter configuration model — option space grounded in Lean master formatter/Lake option surfaces.
// Owns: Lean4OptionValue, Lean4OptionAssignment, Lean4PositiveInt, Lean4NonNegativeInt, Lean4 numeric validations/constructors, Lean4FormatConfig, lean4_format_defaults, lean4_format_layer.
// Consumes: Locus, Outcome, Symbol, Refined, Validation.
// Status: T-4.16 scaffold — full documented Lean formatter-facing option surface.
// Anchor: https://github.com/leanprover/lean4/blob/master/src/Lean/Data/Format.lean

module v4.extdeps.formatters.lean4_format


import v4.std.diagnostic { Locus, Outcome }
import v4.std.node { Symbol }
import v4.std.refinement { Refined, Validation, refine }


type Lean4PositiveInt = Refined<Int>
type Lean4NonNegativeInt = Refined<Int>


data lean4_positive_int_out_of_range: Symbol = lean4_positive_int_out_of_range
data lean4_non_negative_int_out_of_range: Symbol = lean4_non_negative_int_out_of_range


fn lean4_positive_int_admits(value: Int) -> Bool {
  value >= 1
}


fn lean4_non_negative_int_admits(value: Int) -> Bool {
  value >= 0
}


data lean4_positive_int_validation: Validation<Int> = Validation {
  reason: lean4_positive_int_out_of_range,
  admits: lean4_positive_int_admits
}


data lean4_non_negative_int_validation: Validation<Int> = Validation {
  reason: lean4_non_negative_int_out_of_range,
  admits: lean4_non_negative_int_admits
}


fn make_lean4_positive_int(value: Int, at: Locus) -> Outcome<Lean4PositiveInt> {
  refine(base: value, by: lean4_positive_int_validation, at: at)
}


fn make_lean4_non_negative_int(value: Int, at: Locus) -> Outcome<Lean4NonNegativeInt> {
  refine(base: value, by: lean4_non_negative_int_validation, at: at)
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Lean4OptionValue
  = Lean4BoolOption { value: Bool }
  | Lean4IntOption { value: Lean4NonNegativeInt }
  | Lean4StringOption { value: String }


type Lean4OptionAssignment {
  name: String
  value: Lean4OptionValue
}


type Lean4FormatConfig {
  format_width: Lean4PositiveInt
  format_indent: Lean4NonNegativeInt
  format_unicode: Bool
  pp_oneline: Bool
  lake_lean_options: List<Lean4OptionAssignment> // 🟡 gated: lean4-option-closed-set — dissolves when Lean4 documents a fixed set of formatter-relevant set_option keys and each becomes a typed field
}


data lean4_format_defaults: Lean4FormatConfig = Lean4FormatConfig {
  format_width: Refined { base: 120 },
  format_indent: Refined { base: 2 },
  format_unicode: true,
  pp_oneline: false,
  lake_lean_options: [],
}


// 🟡 gated — feature: formatter-config-patch — bind T-4.16 follow-on — dissolve-on-arrival: Lean4FormatConfigPatch type with per-field Override<T>/Inherit arms replaces full-config layering; forbidden: full-config replacement where partial field override is needed.
fn lean4_format_layer(base: Lean4FormatConfig, outer: Lean4FormatConfig) -> Lean4FormatConfig {
  outer
}
