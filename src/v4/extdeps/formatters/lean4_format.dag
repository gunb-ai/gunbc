// src/v4/extdeps/formatters/lean4_format.dag
// Scope: Lean 4 formatter configuration model — option space grounded in Lean 4 formatter/Lake option surfaces.
// Status: T-4.16 scaffold — full documented Lean formatter-facing option surface.
// Anchor: https://github.com/leanprover/lean4/blob/master/src/Lean/Data/Format.lean
//         https://github.com/leanprover/lean4/blob/master/src/Lean/Data/Options.lean

module v4.extdeps.formatters.lean4_format


import v4.std.diagnostic { Locus, Outcome }
import v4.std.node { Symbol }
import v4.std.refinement { Refined, Validation, refine }
import v4.std.patch { FieldPatch, apply_field_patch }


type Lean4NameValue
type Lean4SyntaxValue
type Lean4NatValue = Refined<Int>


data lean4_nat_value_out_of_range: Symbol = lean4_nat_value_out_of_range


fn lean4_nat_value_admits(value: Int) -> Bool {
  value >= 0
}


data lean4_nat_value_validation: Validation<Int> = Validation {
  reason: lean4_nat_value_out_of_range,
  admits: lean4_nat_value_admits
}


fn make_lean4_nat_value(value: Int, at: Locus) -> Outcome<Lean4NatValue> {
  refine(base: value, by: lean4_nat_value_validation, at: at)
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// 🟡 gated — feature: lean4-option-closed-set — bind T-4.16 follow-on — dissolve-on-arrival: Lean4OptionValue and Lean4OptionAssignment dissolve when lake_lean_options is replaced by typed fields; the six arms faithfully mirror Lean.DataValue (ofString/ofBool/ofName/ofNat/ofInt/ofSyntax); forbidden: adding arms not present in upstream Lean.DataValue.
type Lean4OptionValue
  = Lean4StringOption { value: String }
  | Lean4BoolOption { value: Bool }
  | Lean4NameOption { value: Lean4NameValue }
  | Lean4NatOption { value: Lean4NatValue }
  | Lean4IntOption { value: Int }
  | Lean4SyntaxOption { value: Lean4SyntaxValue }


type Lean4OptionAssignment {
  name: String
  value: Lean4OptionValue
}


// 🟡 gated — feature: lean4-option-closed-set — bind T-4.16 follow-on — dissolve-on-arrival: replace lake_lean_options open list with typed fields once Lean4 documents a fixed set of formatter-relevant set_option keys; forbidden: parallel closed-list approximations outside this substrate.
type Lean4FormatConfig {
  format_width: Lean4NatValue
  format_indent: Lean4NatValue
  format_unicode: Bool
  pp_oneline: Bool
  lake_lean_options: List<Lean4OptionAssignment> // 🟡 gated: lean4-option-closed-set
}


data lean4_format_defaults: Lean4FormatConfig = Lean4FormatConfig {
  format_width: Refined { base: 120 },
  format_indent: Refined { base: 2 },
  format_unicode: true,
  pp_oneline: false,
  lake_lean_options: [],
}


// 🟡 gated — consumer:config-patch-record-projection — bind v4.std.patch feature:config-patch-record-projection — dissolve-on-arrival: Lean4FormatConfigPatch projected from Lean4FormatConfig field set.
type Lean4FormatConfigPatch {
  format_width: FieldPatch<Lean4NatValue>
  format_indent: FieldPatch<Lean4NatValue>
  format_unicode: FieldPatch<Bool>
  pp_oneline: FieldPatch<Bool>
  lake_lean_options: FieldPatch<List<Lean4OptionAssignment>>
}


fn lean4_format_layer(base: Lean4FormatConfig, patch: Lean4FormatConfigPatch) -> Lean4FormatConfig {
  Lean4FormatConfig {
    format_width: apply_field_patch(base: base.format_width, patch: patch.format_width),
    format_indent: apply_field_patch(base: base.format_indent, patch: patch.format_indent),
    format_unicode: apply_field_patch(base: base.format_unicode, patch: patch.format_unicode),
    pp_oneline: apply_field_patch(base: base.pp_oneline, patch: patch.pp_oneline),
    lake_lean_options: apply_field_patch(base: base.lake_lean_options, patch: patch.lake_lean_options),
  }
}
