// Scope: PY-L2-CROSS-TARGET-PARITY — positive cross-target behavioral PARITY receipt (Worksheet C).
//   The same modeled program runs across Python, Rust, and Go on the common domain (small integer
//   add; external Symbol nominal/value projection) and produces the IDENTICAL displayed payload.
//   This is the exact complement of language_model/python_cross_runtime_drift: drift proves the same
//   program DIVERGES at the fixed-width boundary; parity proves it AGREES on the common subdomain.
// Status: modeled claim + parity probe roster; host execution harness-blocked (same gate as the
//   drift probe), so the receipt asserts wiring + the positive equality property.

module v4.test.language_model.python_l2_cross_target_parity

import v4.lens.leaf_model_verification {
  python_l2_parity_r2a_probe,
  python_l2_parity_r3_probe,
  python_l2_parity_r2a_python_source,
  python_l2_parity_r2a_rust_source,
  python_l2_parity_r2a_go_source,
  python_l2_parity_r3_python_source,
  python_l2_parity_r3_rust_source,
  python_l2_parity_r3_go_source,
  python_l2_parity_r2a_value,
  python_l2_parity_r3_value
}
import v4.std.leaf_model_verification {
  LeafModelCrossTargetParityProbe,
  leaf_model_claim_python_l2_cross_target_parity_r2a_add,
  leaf_model_claim_python_l2_cross_target_parity_r3_symbol_projection
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode, SyntheticOccurrence }
import v4.std.verification {
  EqualsClaim,
  ManualAnchorAbsent,
  TestClaim,
  TestClassification,
  Tier1,
  Boundary,
  manual_claim_anchor
}
fn python_l2_parity_claim_bool_atom(b: Bool) -> Node {
  match b {
    true => Node { kind: TypeNode { connective: Atom { identity: ^python_l2_parity_claim_bool_true } }, children: [],
 occurrence_id: SyntheticOccurrence
}
    false => Node { kind: TypeNode { connective: Atom { identity: ^python_l2_parity_claim_bool_false } }, children: [],
 occurrence_id: SyntheticOccurrence
}
  }
}

// Field access is taken on a bound probe PARAMETER (the v4 surface parser supports `p.field` chains
// on an identifier, not postfix `.field` on a call result), so the wiring/parity predicates live in
// helper fns that receive the probe.
fn python_l2_parity_r2a_probe_is_wired(p: LeafModelCrossTargetParityProbe) -> Bool {
  p.claim_id == leaf_model_claim_python_l2_cross_target_parity_r2a_add
    && p.python_fact == ^python_repr_int_arbitrary_precision
    && p.rust_fact == ^rust_repr_integer_twos_complement
    && p.go_fact == ^go_repr_twos_complement_integer
    && p.python_source == python_l2_parity_r2a_python_source
    && p.rust_source == python_l2_parity_r2a_rust_source
    && p.go_source == python_l2_parity_r2a_go_source
    && p.expected_parity.expected == python_l2_parity_r2a_value
    && p.expected_parity.actual == python_l2_parity_r2a_value
}

fn python_l2_parity_r3_probe_is_wired(p: LeafModelCrossTargetParityProbe) -> Bool {
  p.claim_id == leaf_model_claim_python_l2_cross_target_parity_r3_symbol_projection
    && p.python_fact == ^python_atom_realization_symbol
    && p.rust_fact == ^rust_atom_realization_symbol
    && p.go_fact == ^go_atom_realization_symbol
    && p.python_source == python_l2_parity_r3_python_source
    && p.rust_source == python_l2_parity_r3_rust_source
    && p.go_source == python_l2_parity_r3_go_source
    && p.expected_parity.expected == python_l2_parity_r3_value
    && p.expected_parity.actual == python_l2_parity_r3_value
}

// PARITY is the positive equality property: the Python payload equals the Rust/Go payload. A receipt
// that found them unequal would mean the verifier mistook the common domain for drift (false drift).
fn python_l2_parity_probe_agrees(p: LeafModelCrossTargetParityProbe) -> Bool {
  p.expected_parity.expected == p.expected_parity.actual
}

// R2a row wires the parity claim id to the three target sources + the integer representation facts
// that justify agreement on the common subdomain, and anchors the shared payload in ValueDiff.
data claim_python_l2_parity_r2a_probe_wired: TestClaim = EqualsClaim {
  label: "language_model/python_l2_cross_target_parity: R2a probe wires parity claim id + per-target sources + repr facts + ValueDiff payload",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_l2_parity_claim_bool_atom(b: true),
  rhs: python_l2_parity_claim_bool_atom(
    b: python_l2_parity_r2a_probe_is_wired(p: python_l2_parity_r2a_probe())
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

// R3 row wires the parity claim id to the three target sources + the atom-realization facts.
data claim_python_l2_parity_r3_probe_wired: TestClaim = EqualsClaim {
  label: "language_model/python_l2_cross_target_parity: R3 probe wires parity claim id + per-target sources + atom-realization facts + ValueDiff payload",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_l2_parity_claim_bool_atom(b: true),
  rhs: python_l2_parity_claim_bool_atom(
    b: python_l2_parity_r3_probe_is_wired(p: python_l2_parity_r3_probe())
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

// R2a parity is POSITIVE: the cross-target payload agrees on the common domain.
data claim_python_l2_parity_r2a_is_positive_parity: TestClaim = EqualsClaim {
  label: "language_model/python_l2_cross_target_parity: R2a small-value add agrees across Python/Rust/Go (parity is real)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_l2_parity_claim_bool_atom(b: true),
  rhs: python_l2_parity_claim_bool_atom(
    b: python_l2_parity_probe_agrees(p: python_l2_parity_r2a_probe())
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}

// R3 parity is POSITIVE: the Symbol projection payload agrees across Python/Rust/Go.
data claim_python_l2_parity_r3_is_positive_parity: TestClaim = EqualsClaim {
  label: "language_model/python_l2_cross_target_parity: R3 Symbol projection agrees across Python/Rust/Go (parity is real)",
  anchor: manual_claim_anchor(anchor: ManualAnchorAbsent),
  lhs: python_l2_parity_claim_bool_atom(b: true),
  rhs: python_l2_parity_claim_bool_atom(
    b: python_l2_parity_probe_agrees(p: python_l2_parity_r3_probe())
  ),
  classification: TestClassification { tier: Tier1, layer: Boundary }
}
