// src/v4/extdeps/formats/modelica.dag
//
// Scope: Modelica 3.4 structural model — acausal paradigm-challenger for analog circuits.
// Anchor: Modelica Language Specification 3.4 (https://modelica.org/documents)
// Status: wave-1 passive RC emit — Shape B user-program projection (no compiler imports).
// Stress: same composed circuit as spice.dag emits here as acausal connect/equation model.

module v4.extdeps.formats.modelica

import v4.std.algebra { Cons, Empty, fold_list, list_append }
import v4.std.collection { List, Optional, Absent, Present }
import v4.std.diagnostic { Outcome }
import v4.std.node { Symbol }
import v4.extdeps.formats.spice {
  Capacitor,
  Component,
  DeckComponent,
  DeckStatement,
  Ground,
  Named,
  NamedNode,
  NodeRef,
  Resistor,
  SpiceNetlist,
  SpiceValue,
  spice_wave1_ident_spelling
}

type ModelicaIdent {
  spelling: String
}

type ModelicaPassiveInstance {
  model: String
  name: ModelicaIdent
  param_name: String
  parameter_lexeme: String
}

type ModelicaConnect {
  left: ModelicaIdent
  right: ModelicaIdent
}

type ModelicaEquation
  = EqConnect { connect: ModelicaConnect }

type ModelicaModel {
  name: String
  passives: List<ModelicaPassiveInstance>
  equations: List<ModelicaEquation>
}

type ModelicaEmit = fn(ModelicaModel) -> String

fn modelica_text_concat(left: String, right: String) -> String {
  list_append(left: left, right: right)
}

fn modelica_ident_from_node(node: NodeRef) -> Optional<ModelicaIdent> {
  match node {
    Ground => Present { value: ModelicaIdent { spelling: "gnd" } }
    Named { node: named } =>
      match spice_wave1_ident_spelling(ident: named.name) {
        Present { value: spelling } => Present { value: ModelicaIdent { spelling: spelling } }
        Absent => Absent
      }
  }
}

fn modelica_passive_from_resistor(component: Component) -> Optional<ModelicaPassiveInstance> {
  match component {
    Resistor { name, n_plus: _, n_minus: _, value } =>
      match spice_wave1_ident_spelling(ident: name) {
        Present { value: name_spelling } =>
          Present {
            value: ModelicaPassiveInstance {
              model: "Modelica.Electrical.Analog.Basic.Resistor",
              name: ModelicaIdent { spelling: name_spelling },
              param_name: "R",
              parameter_lexeme: value.lexeme
            }
          }
        Absent => Absent
      }
    _ => Absent
  }
}

fn modelica_passive_from_capacitor(component: Component) -> Optional<ModelicaPassiveInstance> {
  match component {
    Capacitor { name, n_plus: _, n_minus: _, value } =>
      match spice_wave1_ident_spelling(ident: name) {
        Present { value: name_spelling } =>
          Present {
            value: ModelicaPassiveInstance {
              model: "Modelica.Electrical.Analog.Basic.Capacitor",
              name: ModelicaIdent { spelling: name_spelling },
              param_name: "C",
              parameter_lexeme: value.lexeme
            }
          }
        Absent => Absent
      }
    _ => Absent
  }
}

fn modelica_passive_from_component(component: Component) -> Optional<ModelicaPassiveInstance> {
  match modelica_passive_from_resistor(component: component) {
    Present { value: p } => Present { value: p }
    Absent => modelica_passive_from_capacitor(component: component)
  }
}

fn modelica_passives_from_body(body: List<DeckStatement>) -> List<ModelicaPassiveInstance> {
  fold_list(
    xs: body,
    empty: Empty,
    cons: fn(acc, stmt) {
      match stmt {
        DeckComponent { component } =>
          match modelica_passive_from_component(component: component) {
            Present { value: passive } => Cons { head: passive, tail: acc }
            Absent => acc
          }
        _ => acc
      }
    }
  )
}

fn modelica_emit_passive_line(passive: ModelicaPassiveInstance) -> String {
  modelica_text_concat(
    left: modelica_text_concat(
      left: modelica_text_concat(
        left: modelica_text_concat(left: "  ", right: passive.model),
        right: " "
      ),
      right: passive.name.spelling
    ),
    right: modelica_text_concat(
      left: modelica_text_concat(
        left: modelica_text_concat(left: "(", right: passive.param_name),
        right: "="
      ),
      right: modelica_text_concat(left: passive.parameter_lexeme, right: ");")
    )
  )
}

fn modelica_emit_passives(passives: List<ModelicaPassiveInstance>) -> String {
  fold_list(
    xs: passives,
    empty: "",
    cons: fn(acc, passive) {
      if acc == "" {
        modelica_emit_passive_line(passive: passive)
      } else {
        modelica_text_concat(
          left: modelica_text_concat(left: acc, right: "\n"),
          right: modelica_emit_passive_line(passive: passive)
        )
      }
    }
  )
}

fn modelica_model_from_spice_netlist(netlist: SpiceNetlist) -> ModelicaModel {
  ModelicaModel {
    name: "RcPassiveWitness",
    passives: modelica_passives_from_body(body: netlist.body),
    equations: Cons {
      head: EqConnect {
        connect: ModelicaConnect {
          left: ModelicaIdent { spelling: "R1.p" },
          right: ModelicaIdent { spelling: "C1.p" }
        }
      },
      tail: Empty
    }
  }
}

fn modelica_emit_equation(eq: ModelicaEquation) -> String {
  match eq {
    EqConnect { connect } =>
      modelica_text_concat(
        left: modelica_text_concat(
          left: modelica_text_concat(left: "  connect(", right: connect.left.spelling),
          right: ", "
        ),
        right: modelica_text_concat(left: connect.right.spelling, right: ");")
      )
  }
}

fn modelica_emit_equations(eqs: List<ModelicaEquation>) -> String {
  fold_list(
    xs: eqs,
    empty: "",
    cons: fn(acc, eq) {
      if acc == "" {
        modelica_emit_equation(eq: eq)
      } else {
        modelica_text_concat(
          left: modelica_text_concat(left: acc, right: "\n"),
          right: modelica_emit_equation(eq: eq)
        )
      }
    }
  )
}

fn modelica_emit(model: ModelicaModel) -> String {
  modelica_text_concat(
    left: modelica_text_concat(
      left: modelica_text_concat(
        left: modelica_text_concat(left: "model ", right: model.name),
        right: "\n"
      ),
      right: modelica_emit_passives(passives: model.passives)
    ),
    right: modelica_text_concat(
      left: modelica_text_concat(left: "\nequation\n", right: modelica_emit_equations(eqs: model.equations)),
      right: modelica_text_concat(left: "\nend ", right: modelica_text_concat(left: model.name, right: ";"))
    )
  )
}

fn modelica_emit_from_spice_netlist(netlist: SpiceNetlist) -> String {
  modelica_emit(model: modelica_model_from_spice_netlist(netlist: netlist))
}
