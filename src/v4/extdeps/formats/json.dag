// src/v4/extdeps/formats/json.dag
// Scope: JSON value grammar (RFC 8259 / ECMA-404) with unique-name object profile — declarative model only.
// Owns: JsonValue.
// Consumes: std/node.dag; std/diagnostic.dag; std/collection.dag; std/algebra.dag (FreeMonoid).
// Status: T-4.6 scaffold — parse/emit, numeric lexeme, unique-name profile axes per DECISIONS.md Part 6.
// Anchor: https://datatracker.ietf.org/doc/html/rfc8259 + https://ecma-international.org/publications-and-standards/standards/ecma-404/

module v4.extdeps.formats.json


// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type JsonValue
  = JsonNull
  | JsonBool { value: Bool }
  | JsonNumber { lexeme: String }
  | JsonString { value: String }
  | JsonArray { elements: List<JsonValue> }
  | JsonObject { members: Map<String, JsonValue> }


