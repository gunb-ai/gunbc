// src/v4/extdeps/formats/yaml.dag
// Scope: YAML 1.2.2 structural value model — declarative only; parse/emit deferred.
// Owns: YamlValue, YamlIntLexemeFacts, YamlFloatLexemeFacts, YamlCanonicalKeyProfileFacts,
//       YamlAnchorAliasResolutionFacts, Yaml{Int,Float,CanonicalKey,AnchorAlias}* witness types.
// Consumes: std/node.dag; std/diagnostic.dag; std/collection.dag.
// Status: T-4.6 — parse/emit axes (gated T-6/T-7/T-10), numeric-lexeme profile (§10.3.2 core schema),
//         canonical-key profile (§3.2.1.3 tag+canonical-content), anchor/alias resolution (§6.1/§7.1).
// Anchor: https://yaml.org/spec/1.2.2/

module v4.extdeps.formats.yaml


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type YamlValue
  = YamlNull
  | YamlBool { value: Bool }
  | YamlInt { lexeme: String }
  | YamlFloat { lexeme: String }
  | YamlString { value: String }
  | YamlSequence { elements: List<YamlValue> }
  | YamlMapping { entries: Map<YamlValue, YamlValue> }


type YamlIntBase10DecimalFormWitness {}

type YamlIntBase8Octal0oPrefixWitness {}

type YamlIntBase16Hex0xPrefixWitness {}

type YamlIntOptionalSignPrefixWitness {}

type YamlIntLexemeFacts {
  base10_decimal_form: YamlIntBase10DecimalFormWitness,
  base8_octal_0o_prefix: YamlIntBase8Octal0oPrefixWitness,
  base16_hex_0x_prefix: YamlIntBase16Hex0xPrefixWitness,
  optional_sign_prefix: YamlIntOptionalSignPrefixWitness,
}

type YamlFloatDecimalOrExponentFormWitness {}

type YamlFloatSpecialInfNanLexemeWitness {}

type YamlFloatOptionalSignPrefixWitness {}

type YamlFloatLexemeFacts {
  decimal_or_exponent_form: YamlFloatDecimalOrExponentFormWitness,
  special_inf_nan_lexeme: YamlFloatSpecialInfNanLexemeWitness,
  optional_sign_prefix: YamlFloatOptionalSignPrefixWitness,
}

type YamlMappingKeyEqualityByTagAndCanonicalContentWitness {}

type YamlSameTagCanonicallyEqualDuplicateKeysRejectedWitness {}

type YamlLexemeIdenticalKeysMapStructuralDedupWitness {}

type YamlCanonicalKeyProfileFacts {
  key_equality_by_tag_and_canonical_content: YamlMappingKeyEqualityByTagAndCanonicalContentWitness,
  same_tag_canonically_equal_duplicates_rejected: YamlSameTagCanonicallyEqualDuplicateKeysRejectedWitness,
  lexeme_identical_keys_map_structural_dedup: YamlLexemeIdenticalKeysMapStructuralDedupWitness,
}

type YamlAnchorNodeMarkedWithAmpersandWitness {}

type YamlAliasNodeMarkedWithAsteriskWitness {}

type YamlAliasMustResolveToPriorAnchorWitness {}

type YamlUnresolvableAliasFailClosedWitness {}

type YamlAliasCycleFailClosedWitness {}

type YamlParsedValueAliasFreeByConstructionWitness {}

type YamlAnchorAliasResolutionFacts {
  anchor_node_marked_with_ampersand: YamlAnchorNodeMarkedWithAmpersandWitness,
  alias_node_marked_with_asterisk: YamlAliasNodeMarkedWithAsteriskWitness,
  alias_must_resolve_to_prior_anchor: YamlAliasMustResolveToPriorAnchorWitness,
  unresolvable_alias_fail_closed: YamlUnresolvableAliasFailClosedWitness,
  alias_cycle_fail_closed: YamlAliasCycleFailClosedWitness,
  parsed_value_alias_free_by_construction: YamlParsedValueAliasFreeByConstructionWitness,
}


