// src/v4/extdeps/formats/json_schema.dag
// Scope: JSON Schema Draft 2020-12 (https://json-schema.org/draft/2020-12/json-schema-core) core slice (validation/type derivation deferred).
// Owns: JsonSchemaCoreTypeName, JsonSchemaTypeSlot, JsonSchemaItemsSlot, JsonSchemaPropertiesSlot, JsonSchemaRequiredSlot, JsonSchema
// Consumes: std/node.dag, std/diagnostic.dag, std/witness.dag, std/collection.dag, extdeps/formats/json.dag
// Status: scaffold — TASKS.md T-4.6

module v4.extdeps.formats.json_schema


import v4.extdeps.formats.json { JsonValue }
import v4.std.collection { Set }


type JsonSchemaCoreTypeName
  = JsonSchemaCoreTypeNull
  | JsonSchemaCoreTypeBoolean
  | JsonSchemaCoreTypeObject
  | JsonSchemaCoreTypeArray
  | JsonSchemaCoreTypeNumber
  | JsonSchemaCoreTypeString
  | JsonSchemaCoreTypeInteger


type JsonSchemaTypeSlot
  = JsonSchemaTypeAbsent
  | JsonSchemaTypeSingle { core_type: JsonSchemaCoreTypeName }
  | JsonSchemaTypeUnion { types: Set<JsonSchemaCoreTypeName> }


type JsonSchemaItemsSlot
  = JsonSchemaItemsAbsent
  | JsonSchemaItemsSchema { item_schema: JsonSchema }


type JsonSchemaPropertiesSlot
  = JsonSchemaPropertiesAbsent
  | JsonSchemaPropertiesPresent { properties: Map<String, JsonSchema> }


type JsonSchemaRequiredSlot
  = JsonSchemaRequiredAbsent
  | JsonSchemaRequiredPresent { required: Set<String> }


type JsonSchema
  = JsonSchemaTrue
  | JsonSchemaFalse
  | JsonSchemaInstance {
      instance_type: JsonSchemaTypeSlot,
      properties: JsonSchemaPropertiesSlot,
      required: JsonSchemaRequiredSlot,
      items: JsonSchemaItemsSlot,
      additional_keywords: Map<String, JsonValue>,
    }
