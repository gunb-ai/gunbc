// Seams: C5 Draft 2020-12 pin; future ops `Outcome`-seamed (not parallel `Result`, not total emit); boolean schemas as `JsonSchemaTrue`/`JsonSchemaFalse` (Core §4.2.1); recursion via `JsonSchemaPropertiesPresent` + `JsonSchemaItemsSchema`; `"type"` is M4 closed sum not raw `String`; overflow keywords stay `JsonValue` (M5). No bodiless `fn` (DECISIONS PARSE-1).

module v4.extdeps.formats.json_schema


import v4.extdeps.formats.json { JsonValue }
import v4.std.collection { Set }


// JsonSchemaCoreTypeName — Validation §6.1.1 closed seven-name `"type"` vocabulary (M4).
// Anchor: https://json-schema.org/draft/2020-12/json-schema-validation#section-6.1.1
// Practice 4: GREEN (terminal).
type JsonSchemaCoreTypeName
  = JsonSchemaCoreTypeNull
  | JsonSchemaCoreTypeBoolean
  | JsonSchemaCoreTypeObject
  | JsonSchemaCoreTypeArray
  | JsonSchemaCoreTypeNumber
  | JsonSchemaCoreTypeString
  | JsonSchemaCoreTypeInteger


// JsonSchemaTypeSlot — `"type"` absent | single name | distinct-name union (`Set<…>` uniqueness; non-`[]` / finiteness still 🟡 on bare `Set` — Deferred (1) + collection Wave-A2).
// Anchor: https://json-schema.org/draft/2020-12/json-schema-validation#section-6.1.1
// Practice 4: GREEN (terminal).
type JsonSchemaTypeSlot
  = JsonSchemaTypeAbsent
  | JsonSchemaTypeSingle { core_type: JsonSchemaCoreTypeName }
  | JsonSchemaTypeUnion { types: Set<JsonSchemaCoreTypeName> }


// JsonSchemaItemsSlot — `"items"` applicator (2020-12 slice); tuple / `prefixItems` / `unevaluatedItems` stay in `additional_keywords` until pinned PR (Deferred (1)).
// Anchor: https://json-schema.org/draft/2020-12/json-schema-core#section-10.3.1
// Practice 4: GREEN (terminal).
type JsonSchemaItemsSlot
  = JsonSchemaItemsAbsent
  | JsonSchemaItemsSchema { item_schema: JsonSchema }


// JsonSchemaPropertiesSlot — `"properties"` P2 presence (absent vs present `{}`).
// Anchor: https://json-schema.org/draft/2020-12/json-schema-core#section-10.3.2.1
// Practice 4: GREEN (terminal).
type JsonSchemaPropertiesSlot
  = JsonSchemaPropertiesAbsent
  | JsonSchemaPropertiesPresent { properties: Map<String, JsonSchema> }


// JsonSchemaRequiredSlot — `"required"` P2 presence (absent vs present incl. `[]`; uniqueness structural via `Set<String>` in Present).
// Anchor: https://json-schema.org/draft/2020-12/json-schema-validation#section-6.5.3
// Practice 4: GREEN (terminal).
type JsonSchemaRequiredSlot
  = JsonSchemaRequiredAbsent
  | JsonSchemaRequiredPresent { required: Set<String> }


// JsonSchema — boolean schema OR object schema + `additional_keywords` overflow (open keyword set — M3/M5).
// Anchor: https://json-schema.org/draft/2020-12/json-schema-core#section-4.3
// Practice 4: GREEN (terminal) on the sum; `JsonSchemaInstance` is the typed object slice.
type JsonSchema
  = JsonSchemaTrue
  | JsonSchemaFalse
  | JsonSchemaInstance {
      instance_type: JsonSchemaTypeSlot,
      properties: JsonSchemaPropertiesSlot,
      required: JsonSchemaRequiredSlot,
      items: JsonSchemaItemsSlot,
      additional_keywords: Map<String, JsonValue>,
    }


// Deferred — TRACKED SCAFFOLD (🟡).
//
// (1) Operations — `json_schema_validate`, `schema_to_type`, `json_schema_emit_from_type_node`, full applicator vocabulary (`prefixItems`, `contains`, `unevaluated*`, `$ref`, annotations). std/text + std/node `TypeNode`; no bodiless `fn`. Fail-closed `Outcome<…>` (json.dag seam #3).
//   **Schema document vs instance:** reject illegal keyword **shapes/values** when validation lands (e.g. `"type": []` per §6.1.1 — non-emptiness still 🟡 on bare `Set`; duplicate `required` strings on wire structurally excluded here via `Set<String>`; other malformed payloads when modeled).
//   **`json_schema_validate`** MUST follow Draft **2020-12 applicability** (keywords evaluate per instance rules; union `type` + e.g. `maxLength` is ordinary composition — **not** automatic `Rejected` from “object-layer mismatch” without normative violation).
//   **`schema_to_type` / `json_schema_emit_from_type_node`** may `Rejected`/unsupported for **derivation-only** limits — **not** conflated with `json_schema_validate` invalidity (same split as §6.5.3 / `properties` below). Never fabricate success on true spec failure.
//   **§6.5.3 / P1:** `required` constrains **instances**, not a rule that each name appears under `properties`; closed-record carve-out from `properties` alone is **derivation**, not `json_schema_validate` invalidity from this carrier alone.
