// src/v4/extdeps/formats/sql.dag
// Scope: ISO/IEC 9075 SQL relational/DDL surface; Shape-B checked format — T-4.6 dsl extdeps port (migration.dag) + ISO spec.
// Owns: SqlDialect, SqlIdentifier, SqlDataType, SqlColumnConstraints, SqlColumnDefault, SqlColumnDefinition, SqlTableConstraint, SqlPrimaryKeySlot, SqlTableDefinition, SqlSchemaOperation, SqlMigrationStep, SqlMigrationScript, SqlMigrationEmissionTarget, SqlStatementKind, SqlParameterStyle, SqlTransactionMode, SqlResultFormat, SqlTransportConfig, SqlIntegerWidth, SqlFloatWidth, SqlIntegerPrimitiveFacts, SqlFloatPrimitiveFacts, SqlNonNumericPrimitiveFacts, sql_facts_*, sql_*_facts_catalog, sql_wave1_primitive_fact_bundles
// Consumes: std/node.dag, std/diagnostic.dag, std/collection.dag, std/nat.dag, std/cardinality.dag, std/model_core.dag
// Status: T-4.6 scaffold + SqlDataType primitive fact-bundle wave-1 (constant arms only; parametric NUMERIC/CHARACTER/CHARACTER_VARYING stay outside the catalog).
// Anchor: https://www.iso.org/standard/76583.html

module v4.extdeps.formats.sql


import v4.std.collection { List }
import v4.std.nat { Nat }
import v4.std.cardinality { NonZeroNat }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.model_core {
  PrimitiveFactAxisBinding,
  PrimitiveFactBundle,
  primitive_fact_axis_encoding,
  primitive_fact_axis_signedness,
  primitive_fact_axis_surface_spelling,
  primitive_fact_axis_width
}


// 🟡 coproduct dissolution — T-4.6-P4-SqlDialect.
type SqlDialect
  = SqlDialectIso9075
  | SqlDialectPostgreSql
  | SqlDialectSqlite
  | SqlDialectMySql


// 🟡 coproduct dissolution — T-4.6-P4-SqlIdentifier.
type SqlIdentifier
  = SqlRegularIdentifier { name: String }
  | SqlDelimitedIdentifier { name: String }


// 🟡 coproduct dissolution — T-4.6-P4-SqlDataType.
type SqlDataType
  = SqlTypeBoolean
  | SqlTypeSmallInt
  | SqlTypeInteger
  | SqlTypeBigInt
  | SqlTypeReal
  | SqlTypeDoublePrecision
  | SqlTypeNumeric { precision: NonZeroNat, scale: Nat }
  | SqlTypeCharacter { length: NonZeroNat }
  | SqlTypeCharacterVarying { length: NonZeroNat }
  | SqlTypeCharacterLargeObject
  | SqlTypeDate
  | SqlTypeTime
  | SqlTypeTimestamp
  | SqlTypeTimestampWithTimeZone


type SqlColumnConstraints {
  not_null: Bool,
}


// 🟡 coproduct dissolution — T-4.6-P4-SqlColumnDefault.
type SqlColumnDefault
  = SqlColumnDefaultAbsent
  | SqlColumnDefaultLiteral { literal: String }


type SqlColumnDefinition {
  name: SqlIdentifier,
  data_type: SqlDataType,
  constraints: SqlColumnConstraints,
  column_default: SqlColumnDefault,
}


// 🟡 coproduct dissolution — T-4.6-P4-SqlTableConstraint.
type SqlTableConstraint
  = SqlTableUnique { columns: List<SqlIdentifier> }
  | SqlTableForeignKey {
      columns: List<SqlIdentifier>,
      referenced_table: SqlIdentifier,
      referenced_columns: List<SqlIdentifier>,
    }


// 🟡 coproduct dissolution — T-4.6-P4-SqlPrimaryKeySlot.
type SqlPrimaryKeySlot
  = SqlPrimaryKeyAbsent
  | SqlPrimaryKeyPresent { columns: List<SqlIdentifier> }


type SqlTableDefinition {
  name: SqlIdentifier,
  columns: List<SqlColumnDefinition>,
  primary_key: SqlPrimaryKeySlot,
  table_constraints: List<SqlTableConstraint>,
}


// 🟡 coproduct dissolution — T-4.6-P4-SqlSchemaOperation.
type SqlSchemaOperation
  = SqlCreateTable { table: SqlTableDefinition }
  | SqlDropTable { table_name: SqlIdentifier }
  | SqlAddColumn { table_name: SqlIdentifier, column: SqlColumnDefinition }
  | SqlDropColumn { table_name: SqlIdentifier, column_name: SqlIdentifier }
  | SqlAlterTableConstraint { table_name: SqlIdentifier, constraint: SqlTableConstraint }
  | SqlCreateIndex {
      index_name: SqlIdentifier,
      table_name: SqlIdentifier,
      columns: List<SqlIdentifier>,
    }
  | SqlDropIndex { index_name: SqlIdentifier }
  | SqlAlterTableRaw { table_name: SqlIdentifier, alteration: String }
  | SqlRawStep { statement: String }


type SqlMigrationStep {
  name: String,
  operation: SqlSchemaOperation,
  dialect: SqlDialect,
  reversible: Bool,
}


type SqlMigrationScript {
  migration_id: String,
  wraps_transaction: Bool,
  steps: List<SqlMigrationStep>,
}


type SqlMigrationEmissionTarget {
  database_name: String,
  migrations: List<SqlMigrationScript>,
}


// 🟢 coproduct dissolution — T-4.6-P4-SqlStatementKind.
type SqlStatementKind
  = SqlSelect
  | SqlInsert
  | SqlUpdate
  | SqlDelete
  | SqlDdl
  | SqlTransactionControl


// 🟢 coproduct dissolution — T-4.6-P4-SqlParameterStyle.
type SqlParameterStyle
  = SqlParamQuestionMark
  | SqlParamNumberedDollar
  | SqlParamNamedColon
  | SqlParamNamedAt
  | SqlParamNamedDollar


// 🟢 coproduct dissolution — T-4.6-P4-SqlTransactionMode.
type SqlTransactionMode
  = SqlAutocommit
  | SqlExistingTransaction
  | SqlBeginCommit


// 🟡 coproduct dissolution — T-4.6-P4-SqlResultFormat.
type SqlResultFormat
  = SqlResultFormatJson
  | SqlResultFormatText


type SqlTransportConfig {
  connection_name: String,
  statement_kind: SqlStatementKind,
  parameter_style: SqlParameterStyle,
  transaction_mode: SqlTransactionMode,
  result_format: SqlResultFormat,
}
