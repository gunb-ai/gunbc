// src/v4/extdeps/formats/csv.dag
// Scope: RFC 4180 CSV; Lane C format slice (TASKS.md T-4.6).
// Anchor: https://datatracker.ietf.org/doc/html/rfc4180
// Owns: CsvDialect, CsvHeaderPresence, CsvRow, CsvDocument
// Consumes: std/node.dag, std/diagnostic.dag, std/collection.dag, std/text.dag
// Status: scaffold — TASKS.md T-4.6



module v4.extdeps.formats.csv



type CsvDialect
  = CsvDialectRfc4180 {}



// 🟡 coproduct dissolution — DECISIONS.md T-4.6-P4-CsvHeaderPresence
type CsvHeaderPresence
  = HeaderPresent {
      row: CsvRow,
    }
  | HeaderAbsent



// 🟡 coproduct dissolution — DECISIONS.md T-4.6-P4-CsvRow
type CsvRow
  = CsvRowZ
  | CsvRowS {
      field: String,
      tail: CsvRow,
    }



type CsvDocument {
  header: CsvHeaderPresence,
  records: List<CsvRow>,
}
