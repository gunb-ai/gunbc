// src/v4/extdeps/formats/openapi.dag
// Scope: OpenAPI 3.1.0 document model (OAS slice).
// Owns: OpenApiSchema, OpenApiHttpMethod, OpenApiOptionalString, OpenApiContact, OpenApiContactSlot, OpenApiLicenseUrlOrIdentifierSlot, OpenApiLicense, OpenApiLicenseSlot, OpenApiInfo, OpenApiMediaType, OpenApiMediaTypeSchemaSlot, OpenApiResponseContentSlot, OpenApiHeadersSlot, OpenApiLinksSlot, OpenApiResponse, OpenApiResponseOrReference, OpenApiResponses, OpenApiOperation, OpenApiPathItem, OpenApiPaths, OpenApiPathsSlot, OpenApiComponentsSchemasSlot, OpenApiComponents, OpenApiComponentsSlot, OpenApiDocument
// Consumes: std/node.dag, std/diagnostic.dag, std/collection.dag, extdeps/formats/json_schema.dag, extdeps/formats/json.dag, extdeps/formats/yaml.dag
// Status: scaffold — TASKS.md T-4.6

module v4.extdeps.formats.openapi


import v4.extdeps.formats.json { JsonValue }
import v4.extdeps.formats.json_schema { JsonSchema }


type OpenApiSchema {
  core: JsonSchema,
  openapi_schema_members: Map<String, JsonValue>,
  openapi_schema_specification_extensions: Map<String, JsonValue>,
}


type OpenApiHttpMethod
  = OpenApiGet
  | OpenApiPut
  | OpenApiPost
  | OpenApiDelete
  | OpenApiOptions
  | OpenApiHead
  | OpenApiPatch
  | OpenApiTrace


type OpenApiOptionalString
  = OpenApiStringPresent { value: String }
  | OpenApiStringAbsent


type OpenApiContact {
  name: OpenApiOptionalString,
  url: OpenApiOptionalString,
  email: OpenApiOptionalString,
  contact_extensions: Map<String, JsonValue>,
}


type OpenApiContactSlot
  = OpenApiContactPresent { contact: OpenApiContact }
  | OpenApiContactAbsent


type OpenApiLicenseUrlOrIdentifierSlot
  = OpenApiLicenseUrlPresent { url: String }
  | OpenApiLicenseIdentifierPresent { identifier: String }
  | OpenApiLicenseUrlOrIdentifierNeither


type OpenApiLicense {
  name: String,
  url_or_identifier: OpenApiLicenseUrlOrIdentifierSlot,
  license_extensions: Map<String, JsonValue>,
}


type OpenApiLicenseSlot
  = OpenApiLicensePresent { license: OpenApiLicense }
  | OpenApiLicenseAbsent


type OpenApiInfo {
  title: String,
  summary: OpenApiOptionalString,
  description: OpenApiOptionalString,
  terms_of_service: OpenApiOptionalString,
  contact: OpenApiContactSlot,
  license: OpenApiLicenseSlot,
  version: String,
  info_specification_extensions: Map<String, JsonValue>,
}


type OpenApiMediaType {
  schema_shape: OpenApiMediaTypeSchemaSlot,
  media_type_deferred_members: Map<String, JsonValue>,
  media_type_specification_extensions: Map<String, JsonValue>,
}


type OpenApiMediaTypeSchemaSlot
  = OpenApiMediaSchemaPresent { schema: OpenApiSchema }
  | OpenApiMediaSchemaAbsent


type OpenApiResponseContentSlot
  = OpenApiResponseContentAbsent
  | OpenApiResponseContentPresent { content: Map<String, OpenApiMediaType> }


type OpenApiHeadersSlot
  = OpenApiHeadersAbsent
  | OpenApiHeadersPresent { headers: Map<String, JsonValue> }


type OpenApiLinksSlot
  = OpenApiLinksAbsent
  | OpenApiLinksPresent { links: Map<String, JsonValue> }


type OpenApiResponse {
  description: String,
  content: OpenApiResponseContentSlot,
  headers: OpenApiHeadersSlot,
  links: OpenApiLinksSlot,
  extensions: Map<String, JsonValue>,
}


type OpenApiResponseOrReference
  = OpenApiResponseInline { response: OpenApiResponse }
  | OpenApiResponseReference { reference_wire: JsonValue }


type OpenApiResponses {
  by_status: Map<String, OpenApiResponseOrReference>,
  responses_object_extensions: Map<String, JsonValue>,
}


type OpenApiOperation {
  operation_id: OpenApiOptionalString,
  responses: OpenApiResponses,
  operation_deferred_members: Map<String, JsonValue>,
  operation_specification_extensions: Map<String, JsonValue>,
}


type OpenApiPathItem {
  routes: Map<OpenApiHttpMethod, OpenApiOperation>,
  path_deferred_members: Map<String, JsonValue>,
  path_specification_extensions: Map<String, JsonValue>,
}


type OpenApiPaths {
  routes: Map<String, OpenApiPathItem>,
  paths_extensions: Map<String, JsonValue>,
}


type OpenApiPathsSlot
  = OpenApiPathsPresent { paths: OpenApiPaths }
  | OpenApiPathsAbsent


type OpenApiComponentsSchemasSlot
  = OpenApiComponentsSchemasAbsent
  | OpenApiComponentsSchemasPresent { schemas: Map<String, OpenApiSchema> }


type OpenApiComponents {
  schemas: OpenApiComponentsSchemasSlot,
  components_deferred_members: Map<String, JsonValue>,
  components_specification_extensions: Map<String, JsonValue>,
}


type OpenApiComponentsSlot
  = OpenApiComponentsPresent { components: OpenApiComponents }
  | OpenApiComponentsAbsent


type OpenApiDocument {
  openapi_version_lexeme: String,
  json_schema_dialect: OpenApiOptionalString,
  info: OpenApiInfo,
  paths: OpenApiPathsSlot,
  components: OpenApiComponentsSlot,
  root_deferred_members: Map<String, JsonValue>,
  root_specification_extensions: Map<String, JsonValue>,
}
