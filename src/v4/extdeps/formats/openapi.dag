type OpenApiGrammarSchema {
  lex: LexRules,
  grammar: Grammar,
}


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiSpecificationExtensionKey.
type OpenApiSpecificationExtensionKey
  = OpenApiSpecExtensionOaiReserved { remainder: String }
  | OpenApiSpecExtensionOasReserved { remainder: String }
  | OpenApiSpecExtensionVendor { after_x_hyphen: String }


type OpenApiComponentsMapKey {
  name: String,
}


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiOpenapiObjectDeferredKey.
type OpenApiOpenapiObjectDeferredKey
  = OpenApiOpenapiDeferredServers
  | OpenApiOpenapiDeferredSecurity
  | OpenApiOpenapiDeferredTags
  | OpenApiOpenapiDeferredExternalDocs


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiOperationDeferredKey.
type OpenApiOperationDeferredKey
  = OpenApiOpDeferredTags
