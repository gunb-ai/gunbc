type OpenApiHttpStatusCodeBoundedRangeWitness {}

type OpenApiHttpStatusCodeFacts {
  hundreds: OpenApiStatusHundreds,
  tens: OpenApiStatusDigit,
  ones: OpenApiStatusDigit,
  bounded_100_to_599: OpenApiHttpStatusCodeBoundedRangeWitness,
}


fn openapi_status_digit_value(digit: OpenApiStatusDigit) -> Nat {
  match digit {
    OpenApiDigit0 => 0
    OpenApiDigit1 => 1
    OpenApiDigit2 => 2
    OpenApiDigit3 => 3
    OpenApiDigit4 => 4
    OpenApiDigit5 => 5
    OpenApiDigit6 => 6
    OpenApiDigit7 => 7
    OpenApiDigit8 => 8
    OpenApiDigit9 => 9
  }
}

fn openapi_status_hundreds_value(hundreds: OpenApiStatusHundreds) -> Nat {
  match hundreds {
    OpenApiHundreds1 => 100
    OpenApiHundreds2 => 200
    OpenApiHundreds3 => 300
    OpenApiHundreds4 => 400
    OpenApiHundreds5 => 500
  }
}

type OpenApiResponseKeyWildcardBridgeRow {
  kind: OpenApiResponseKeyWildcardKind,
  low: Nat,
  high: Nat,
}


data openapi_wildcard_bridge_1xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard1xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds1),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds1) + 99,
}

data openapi_wildcard_bridge_2xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard2xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds2),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds2) + 99,
}

data openapi_wildcard_bridge_3xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard3xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds3),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds3) + 99,
}

data openapi_wildcard_bridge_4xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard4xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds4),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds4) + 99,
}

data openapi_wildcard_bridge_5xx: OpenApiResponseKeyWildcardBridgeRow = {
  kind: OpenApiWildcard5xx,
  low: openapi_status_hundreds_value(hundreds: OpenApiHundreds5),
  high: openapi_status_hundreds_value(hundreds: OpenApiHundreds5) + 99,
}

data openapi_response_key_wildcard_bridge_catalog: List<OpenApiResponseKeyWildcardBridgeRow> = [
  openapi_wildcard_bridge_1xx,
  openapi_wildcard_bridge_2xx,
  openapi_wildcard_bridge_3xx,
  openapi_wildcard_bridge_4xx,
  openapi_wildcard_bridge_5xx,
]

fn openapi_http_status_code_value(
  hundreds: OpenApiStatusHundreds,
  tens: OpenApiStatusDigit,
  ones: OpenApiStatusDigit
) -> Nat {
  openapi_status_hundreds_value(hundreds: hundreds) + (openapi_status_digit_value(digit: tens) * 10) + openapi_status_digit_value(digit: ones)
}


data openapi_operation_exchange_request_reply: ExchangePattern = RequestReply

type OpenApiOperationWireContractFacts {
  http_method_bridge: OpenApiHttpMethodBridgeRow,
  path_template: OpenApiPathTemplateKey,
}

type OpenApiDocumentWireContractFacts {
  openapi_version: OpenApiOpenapiField3_1,
  paths: Optional<OpenApiPaths>,
  unique_names: OpenApiUniqueNameProfileFacts,
}


