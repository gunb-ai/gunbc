  oas_method: OpenApiHttpMethod,
  network_method: HttpMethod,
}


data openapi_http_method_bridge_get: OpenApiHttpMethodBridgeRow = {
  oas_method: OpenApiGet,
  network_method: GET,
}

data openapi_http_method_bridge_put: OpenApiHttpMethodBridgeRow = {
