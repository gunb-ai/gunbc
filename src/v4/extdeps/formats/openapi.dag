  | OpenApiSchemaOasExample


type OpenApiSchema {
  core: JsonSchema,
  openapi_schema_oas_members: Map<OpenApiSchemaOasMemberKey, JsonValue>,
  openapi_schema_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
  openapi_schema_deferred_keyword_members: Map<String, JsonValue>,
}


// 🟢 coproduct dissolution — T-4.6-P4-OpenApiHttpMethod.
type OpenApiHttpMethod
  = OpenApiGet
  | OpenApiPut
  | OpenApiPost
  | OpenApiDelete
  | OpenApiOptions
  | OpenApiHead
  | OpenApiPatch
  | OpenApiTrace


type OpenApiReferenceObject {
  dollar_ref: String,
  summary: Optional<String>,
  description: Optional<String>,
}




// 🟡 coproduct dissolution — T-4.6-P4-OpenApiLinkTarget.
type OpenApiLinkTarget
  = OpenApiLinkTargetOperationId { operation_id: String }
  | OpenApiLinkTargetOperationRef { operation_ref: String }


type OpenApiLinkObject {
  target: OpenApiLinkTarget,
  description: Optional<String>,
  link_deferred_members: Map<OpenApiLinkDeferredKey, JsonValue>,
  link_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiLinkOrReference.
type OpenApiLinkOrReference
  = OpenApiLinkInline { link: OpenApiLinkObject }
  | OpenApiLinkReference { reference: OpenApiReferenceObject }


type OpenApiContact {
  name: Optional<String>,
  url: Optional<String>,
  email: Optional<String>,
  contact_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiLicenseUrlOrIdentifierSlot.
type OpenApiLicenseUrlOrIdentifierSlot
  = OpenApiLicenseUrlPresent { url: UriReference }
  | OpenApiLicenseIdentifierPresent { identifier: String }
  | OpenApiLicenseUrlOrIdentifierNeither


type OpenApiLicense {
  name: String,
  url_or_identifier: OpenApiLicenseUrlOrIdentifierSlot,
  license_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


type OpenApiInfo {
  title: String,
  summary: Optional<String>,
  description: Optional<String>,
  terms_of_service: Optional<String>,
  contact: Optional<OpenApiContact>,
  license: Optional<OpenApiLicense>,
  version: String,
  info_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


type OpenApiMediaType {
  schema_shape: Optional<OpenApiSchema>,
  media_type_deferred_members: Map<OpenApiMediaTypeDeferredKey, JsonValue>,
  media_type_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


type OpenApiHeaderContentSingle {
  media_type: String,
  media: OpenApiMediaType,
}


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiHeaderPayloadSlot.
type OpenApiHeaderPayloadSlot
  = OpenApiHeaderPayloadSchema { schema: OpenApiSchema }
  | OpenApiHeaderPayloadContent { content: OpenApiHeaderContentSingle }


type OpenApiHeaderObject {
  description: Optional<String>,
  required: Optional<Bool>,
  deprecated: Optional<Bool>,
  payload: OpenApiHeaderPayloadSlot,
  header_deferred_members: Map<OpenApiHeaderDeferredKey, JsonValue>,
  header_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiHeaderOrReference.
type OpenApiHeaderOrReference
  = OpenApiHeaderInline { header: OpenApiHeaderObject }
  | OpenApiHeaderReference { reference: OpenApiReferenceObject }


type OpenApiResponse {
  description: String,
  content: Optional<Map<String, OpenApiMediaType>>,
  headers: Optional<Map<String, OpenApiHeaderOrReference>>,
  links: Optional<Map<String, OpenApiLinkOrReference>>,
  extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiResponseOrReference.
type OpenApiResponseOrReference
  = OpenApiResponseInline { response: OpenApiResponse }
  | OpenApiResponseReference { reference: OpenApiReferenceObject }


// 🟢 coproduct dissolution — T-4.6-P4-OpenApiStatusDigit.
type OpenApiStatusDigit
  = OpenApiDigit0
  | OpenApiDigit1
  | OpenApiDigit2
  | OpenApiDigit3
  | OpenApiDigit4
  | OpenApiDigit5
  | OpenApiDigit6
  | OpenApiDigit7
  | OpenApiDigit8
  | OpenApiDigit9


// 🟢 coproduct dissolution — T-4.6-P4-OpenApiStatusHundreds.
type OpenApiStatusHundreds
  = OpenApiHundreds1
  | OpenApiHundreds2
  | OpenApiHundreds3
  | OpenApiHundreds4
  | OpenApiHundreds5


// 🟢 coproduct dissolution — T-4.6-P4-OpenApiResponseKeyWildcardKind.
type OpenApiResponseKeyWildcardKind
  = OpenApiWildcard1xx
  | OpenApiWildcard2xx
  | OpenApiWildcard3xx
  | OpenApiWildcard4xx
  | OpenApiWildcard5xx


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiResponseKeyNonDefault.
type OpenApiResponseKeyNonDefault
  = OpenApiResponseKeyExplicitHttpStatus { hundreds: OpenApiStatusHundreds, tens: OpenApiStatusDigit, ones: OpenApiStatusDigit }
  | OpenApiResponseKeyWildcard { kind: OpenApiResponseKeyWildcardKind }


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiResponseKey.
type OpenApiResponseKey
  = OpenApiResponseKeyDefault
  | OpenApiResponseKeyOther { key: OpenApiResponseKeyNonDefault }


type OpenApiResponsesPrimaryEntry {
  status_key: OpenApiResponseKeyNonDefault,
  response: OpenApiResponseOrReference,
}


type OpenApiResponses {
  primary_response: OpenApiResponsesPrimaryEntry,
  default_response: Optional<OpenApiResponseOrReference>,
  additional_by_status: Map<OpenApiResponseKeyNonDefault, OpenApiResponseOrReference>,
  responses_object_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


type OpenApiOperation {
  operation_id: Optional<String>,
  responses: OpenApiResponses,
  operation_deferred_members: Map<OpenApiOperationDeferredKey, JsonValue>,
  operation_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


type OpenApiPathItem {
  routes: Map<OpenApiHttpMethod, OpenApiOperation>,
  path_deferred_members: Map<OpenApiPathItemDeferredKey, JsonValue>,
  path_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiPathItemOrReference.
type OpenApiPathItemOrReference
  = OpenApiPathItemInline { path_item: OpenApiPathItem }
  | OpenApiPathItemReference { reference: OpenApiReferenceObject }


type OpenApiPathTemplateKey {
  after_slash: String,
}


type OpenApiPaths {
  routes: Map<OpenApiPathTemplateKey, OpenApiPathItem>,
  paths_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


type OpenApiComponents {
  schemas: Optional<Map<OpenApiComponentsMapKey, OpenApiSchema>>,
  path_items: Optional<Map<OpenApiComponentsMapKey, OpenApiPathItemOrReference>>,
  components_deferred_members: Map<OpenApiComponentsDeferredKey, JsonValue>,
  components_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


type OpenApiWebhooks {
  routes: Map<String, OpenApiPathItemOrReference>,
  webhooks_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


// 🟡 coproduct dissolution — T-4.6-P4-OpenApiDocumentRoot.
type OpenApiDocumentRoot
  = OpenApiDocumentRootPathsPresent {
      paths: OpenApiPaths,
      components: Optional<OpenApiComponents>,
      webhooks: Optional<OpenApiWebhooks>,
    }
  | OpenApiDocumentRootComponentsWithoutPaths {
      components: OpenApiComponents,
      webhooks: Optional<OpenApiWebhooks>,
    }
  | OpenApiDocumentRootWebhooksOnly {
      webhooks: OpenApiWebhooks,
    }

// 🟡 coproduct dissolution — T-4.6-P4-OpenApiOpenapiField3_1
type OpenApiOpenapiField3_1
  = OpenApiOpenapi31Patch { patch: Nat }


type OpenApiDocument {
  grammar_schema: OpenApiGrammarSchema,
  openapi: OpenApiOpenapiField3_1,
  json_schema_dialect: Optional<String>,
  info: OpenApiInfo,
  root: OpenApiDocumentRoot,
  root_deferred_members: Map<OpenApiOpenapiObjectDeferredKey, JsonValue>,
  root_specification_extensions: Map<OpenApiSpecificationExtensionKey, JsonValue>,
}


