// src/v4/extdeps/formats/spice.dag
//
// Scope: SPICE netlist model — direction-agnostic. Analog circuit
//        description: components, nodes, .model cards, directives. A flat
//        component + connection graph — NO control flow.
// Anchor: "SPICE3 Version 3f5 User's Guide" (Quarles et al., UC Berkeley
//         ERL, 1993) — the canonical versioned netlist-format spec the
//         worker models against; the ngspice User's Manual (pin a
//         concrete release, e.g. ngspice-44) is the maintained versioned
//         reference. NOT Wikipedia — https://en.wikipedia.org/wiki/SPICE
//         is accessible context only.
// Stress (T-4.10 — a B2-OMNI falsification probe): SPICE is **Shape B**
//   (a data format, per L-1) — it is NOT a `LanguageModel` and never
//   touches the compiler-language (Shape A) ingest boundary. The probe
//   tests the **Shape B format data-model** abstraction only: is it
//   ACTUALLY general, or secretly programming-language-shaped? A netlist
//   has no control flow — it is components plus a connection graph. If
//   the format data-model cannot represent a netlist without contortion,
//   that is a substrate-design signal to surface NOW
//   (STOP-and-escalate), not after it is load-bearing.
// Clear win: ONE `.dag` circuit declaration → a SPICE netlist that
//   simulates (omni-emission reaches analog hardware).
// Status: T-4.10 modeled 2026-05-16 (smart-raven-655); physical-quantity axis wave-1 (quiet-otter-381) — approximate voltage + named exact-carrier gap (T-3 `Dimension`/`Volt` std/ dissolution deferred). The I/O contract
// lives in the module body for downstream workers. Splitting this
// file requires explicit operator ratification (substrate extension =
// stop signal).


module v4.extdeps.formats.spice


import v4.std.algebra { Cons, Empty, fold_list, list_append, list_snoc_item }
import v4.std.collection { List, Optional, Absent, Present, optional_present, optional_absent }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Textual,
  Unavailable,
  WholeFile,
  diagnostics_singleton,
  outcome_accepted,
  outcome_rejected
}
import v4.std.logic { Bool }
import v4.std.grammar { FormalProduction, ParseGrammar, GrammarExpr, GrammarProduction, GrammarRoot, GrammarSchema, GrammarSchemaProbe, GrammarSchemaProbeBinding, ModeledGrammar, grammar_atom, grammar_empty_sync_tokens, grammar_formal_nonterminal, grammar_formal_terminal }
import v4.std.compilers.lexing {
  CharClassPattern,
  DigitChar,
  IdentContinueChar,
  IdentStartChar,
  LexPattern,
  LexRule,
  LexRuleSet,
  LexRules,
  ModeledLexRules,
  OneOrMorePattern,
  RepeatPattern,
  SequencePattern,
  TokenRule,
  TriviaRule,
  WhitespaceChar
}
import v4.std.node { Symbol }


type NamedNode {
  name: Symbol
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type NodeRef
  = Ground
  | Named { node: NamedNode }


type SpiceValue {
  lexeme: String
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SpiceVoltUnit {}

// 🟡 needs-more-work — feature:spice-approx-voltage-consumer — dissolve-on: NodeVoltageBinding consumer projects through SpiceApproxVoltage (T-4 wave-2) · ledger: T-4
type SpiceApproxVoltage {
  magnitude_lexeme: String
  unit: SpiceVoltUnit
}

// 🟡 needs-more-work — feature:spice-exact-voltage-gap — dissolve-on: std/ exact-real / Dimension substrate (T-3) · ledger: T-4
type SpiceExactVoltageGap {}
type Parameter {
  name: Symbol
  value: SpiceValue
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Modifier
  = Flag { name: Symbol }
  | KeyValue { name: Symbol, value: SpiceValue }


type IncludeCard {
  path: String
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SweepSourceKind
  = Voltage
  | Current


type SweepSourceRef {
  kind: SweepSourceKind
  name: Symbol
}


type InductorRef {
  name: Symbol
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SubstrateSpec
  = SubstrateImplicit
  | SubstrateExplicit { node: NodeRef }


// 🟡 coproduct dissolution — feature:spice-component-spec-exhaustive-coverage — dissolve-on-arrival: all SPICE3F5 element kinds and per-variant statement grammar are modeled structurally.
type Component
  = Resistor { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | Capacitor { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | Inductor { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | VoltageSource { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | CurrentSource { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | Diode { name: Symbol, anode: NodeRef, cathode: NodeRef, model: Symbol }
  | Bjt { name: Symbol, collector: NodeRef, base: NodeRef, emitter: NodeRef, substrate: SubstrateSpec, model: Symbol, modifiers: List<Modifier> }
  | Mosfet { name: Symbol, drain: NodeRef, gate: NodeRef, source: NodeRef, body: NodeRef, model: Symbol, modifiers: List<Modifier> }
  | MutualInductance { name: Symbol, l1: InductorRef, l2: InductorRef, coupling: SpiceValue }
  | SubcircuitCall { name: Symbol, connections: SubcircuitConnections, subcircuit: Symbol, parameters: List<Parameter> }


// 🟡 coproduct dissolution — feature:spice-model-kind-spec-exhaustive-coverage — dissolve-on-arrival: all model-referencing SPICE3F5 component variants have matching ModelKind coverage.
type ModelKind
  = DiodeModel
  | BjtNpn
  | BjtPnp
  | MosfetNmos
  | MosfetPmos


type ModelCard {
  name: Symbol
  kind: ModelKind
  parameters: List<Parameter>
}


// 🟡 coproduct dissolution — consumer:spice-ac-sweep-point-generator — dissolve-on-arrival: first frequency-stepping consumer derives from spacing-law and ratio-base axes.
type AcSweepKind
  = Linear
  | Decade
  | Octave


type NodeVoltageBinding {
  node: NodeRef
  value: SpiceValue
}


type NodeVoltageBindings {
  first: NodeVoltageBinding
  rest: List<NodeVoltageBinding>
}


// 🟡 coproduct dissolution — feature:spice-directive-spec-exhaustive-coverage — dissolve-on-arrival: all SPICE3F5 analysis/control directives and per-variant grammar are modeled structurally.
type Directive
  = Op
  | Tran { tstep: SpiceValue, tstop: SpiceValue }
  | Dc { source: SweepSourceRef, vstart: SpiceValue, vstop: SpiceValue, vincr: SpiceValue }
  | Ac { sweep: AcSweepKind, n: SpiceValue, fstart: SpiceValue, fstop: SpiceValue }
  | InitialCondition { assignments: NodeVoltageBindings }
  | NodeSet { assignments: NodeVoltageBindings }
  | Options { modifiers: List<Modifier> }
  | Include { card: IncludeCard }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SubcircuitStatement
  = StmtComponent { component: Component }
  | StmtModel { model: ModelCard }
  | StmtInclude { card: IncludeCard }


type SubcircuitDefinition {
  name: Symbol
  parent_scope: List<Symbol>
  ports: SubcircuitPorts
  body: List<SubcircuitStatement>
}


type SubcircuitPorts {
  first: NamedNode
  rest: List<NamedNode>
}


type SubcircuitConnections {
  first: NodeRef
  rest: List<NodeRef>
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type DeckStatement
  = DeckComponent { component: Component }
  | DeckModelCard { model: ModelCard }
  | DeckSubcircuit { definition: SubcircuitDefinition }
  | DeckDirective { directive: Directive }


// 🟡 needs-more-work — feature:spice-nested-subckt-position-fidelity — consumer:byte-exact-nested-subckt-roundtrip — dissolve-on-arrival: prefer SubcircuitDefinition as SubcircuitStatement; fallback position_in_parent metadata while A1 holds.
type SpiceNetlist {
  title: String
  body: List<DeckStatement>
}

type SpiceParse = fn(String) -> Outcome<SpiceNetlist>

type SpiceEmit = fn(SpiceNetlist) -> String

type SpiceIoContract {
  parse: SpiceParse
  emit: SpiceEmit
}
fn spice_lex_token(token_class: Symbol, pattern: LexPattern) -> LexRule {
  TokenRule { token_class: token_class, pattern: pattern }
}


fn spice_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}


fn spice_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}


fn spice_identifier_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}


fn spice_value_pattern() -> LexPattern {
  OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
}


fn spice_wave1_lex() -> LexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: [
        TriviaRule { pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } } },
        spice_lex_token(token_class: ^spice_token_ident, pattern: spice_identifier_pattern()),
        spice_lex_token(token_class: ^spice_token_value, pattern: spice_value_pattern())
      ]
    }
  }
}


fn spice_resistor_statement_expr() -> GrammarExpr {
  spice_grammar_sequence(
    left: spice_grammar_terminal(token_class: ^spice_token_ident),
    right: spice_grammar_sequence(
      left: spice_grammar_terminal(token_class: ^spice_token_ident),
      right: spice_grammar_sequence(
        left: spice_grammar_terminal(token_class: ^spice_token_ident),
        right: spice_grammar_terminal(token_class: ^spice_token_value)
      )
    )
  )
}


fn spice_wave1_grammar() -> ParseGrammar {
  let start = GrammarProduction {
    name: ^spice_production_resistor_statement,
    expression: spice_resistor_statement_expr(),
    emitted: grammar_atom(identity: ^spice_surface_resistor_statement)
  }
  ModeledGrammar {
    root: GrammarRoot {
      start: ^spice_production_resistor_statement,
      productions: [start],
      sync_tokens: grammar_empty_sync_tokens()
    }
  }
}


fn spice_resistor_statement_formal_production() -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: ^spice_production_resistor_statement),
    rhs: [
      grammar_formal_terminal(identity: ^spice_token_ident),
      grammar_formal_terminal(identity: ^spice_token_ident),
      grammar_formal_terminal(identity: ^spice_token_ident),
      grammar_formal_terminal(identity: ^spice_token_value)
    ]
  }
}


fn spice_format_grammar_schema() -> GrammarSchema {
  GrammarSchema {
    lex: spice_wave1_lex(),
    grammar: spice_wave1_grammar()
  }
}


fn spice_format_grammar_probe() -> GrammarSchemaProbeBinding {
  GrammarSchemaProbeBinding {
    schema: spice_format_grammar_schema(),
    probe: GrammarSchemaProbe {
      fixture: "R1 n1 n2 1",
      production: spice_resistor_statement_formal_production(),
      expected_parse_surface: grammar_atom(identity: ^spice_surface_resistor_statement)
    }
  }
}


// --- wave-1 Shape B emit/parse (extdeps-local; no v4.compiler imports) --------

data spice_wave1_fixture_file: Symbol = ^spice_wave1_fixture_file

fn spice_text_concat(left: String, right: String) -> String {
  list_append(left: left, right: right)
}

fn spice_text_concat3(left: String, mid: String, right: String) -> String {
  spice_text_concat(left: spice_text_concat(left: left, right: mid), right: right)
}

fn spice_text_concat4(a: String, b: String, c: String, d: String) -> String {
  spice_text_concat(left: spice_text_concat3(left: a, mid: b, right: c), right: d)
}

// Wave-1 ident spellings: RC witness symbols (^r1 -> "R1", ^v1 -> "V1", etc.)
// plus node names and grammar-probe idents.
fn spice_wave1_ident_spelling(ident: Symbol) -> Optional<String> {
  if ident == ^r1 {
    optional_present(value: "R1")
  } else if ident == ^c1 {
    optional_present(value: "C1")
  } else if ident == ^v1 {
    optional_present(value: "V1")
  } else if ident == ^n1 {
    optional_present(value: "n1")
  } else if ident == ^n2 {
    optional_present(value: "n2")
  } else {
    optional_absent()
  }
}

fn spice_emit_node_ref(node: NodeRef) -> Optional<String> {
  match node {
    Ground => Present { value: "0" }
    Named { node: named } =>
      spice_wave1_ident_spelling(ident: named.name)
  }
}

fn spice_emit_passive_line(
  name: Symbol,
  n_plus: NodeRef,
  n_minus: NodeRef,
  value: SpiceValue
) -> Optional<String> {
  match spice_emit_node_ref(node: n_plus) {
    Present { value: plus_spelling } =>
      match spice_emit_node_ref(node: n_minus) {
        Present { value: minus_spelling } =>
          match spice_wave1_ident_spelling(ident: name) {
            Present { value: name_spelling } =>
              Present {
                value: spice_text_concat4(
                  a: spice_text_concat(left: name_spelling, right: " "),
                  b: spice_text_concat(left: plus_spelling, right: " "),
                  c: spice_text_concat(left: minus_spelling, right: " "),
                  d: value.lexeme
                )
              }
            Absent => Absent
          }
        Absent => Absent
      }
    Absent => Absent
  }
}

fn spice_emit_component(component: Component) -> Optional<String> {
  match component {
    Resistor { name, n_plus, n_minus, value } =>
      spice_emit_passive_line(name: name, n_plus: n_plus, n_minus: n_minus, value: value)
    Capacitor { name, n_plus, n_minus, value } =>
      spice_emit_passive_line(name: name, n_plus: n_plus, n_minus: n_minus, value: value)
    Inductor { name, n_plus, n_minus, value } =>
      spice_emit_passive_line(name: name, n_plus: n_plus, n_minus: n_minus, value: value)
    VoltageSource { name, n_plus, n_minus, value } =>
      spice_emit_passive_line(name: name, n_plus: n_plus, n_minus: n_minus, value: value)
    CurrentSource { name: _, n_plus: _, n_minus: _, value: _ } => Absent
    Diode { name: _, anode: _, cathode: _, model: _ } => Absent
    Bjt { name: _, collector: _, base: _, emitter: _, substrate: _, model: _, modifiers: _ } => Absent
    Mosfet { name: _, drain: _, gate: _, source: _, body: _, model: _, modifiers: _ } => Absent
    MutualInductance { name: _, l1: _, l2: _, coupling: _ } => Absent
    SubcircuitCall { name: _, connections: _, subcircuit: _, parameters: _ } => Absent
  }
}

fn spice_emit_node_voltage_binding(binding: NodeVoltageBinding) -> Optional<String> {
  match spice_emit_node_ref(node: binding.node) {
    Present { value: node_spelling } =>
      Present {
        value: spice_text_concat4(
          a: "v(",
          b: node_spelling,
          c: ")=",
          d: binding.value.lexeme
        )
      }
    Absent => Absent
  }
}

fn spice_emit_directive(directive: Directive) -> Optional<String> {
  match directive {
    Op => Present { value: ".op" }
    Tran { tstep, tstop } =>
      Present {
        value: spice_text_concat3(
          left: ".tran ",
          mid: spice_text_concat(left: tstep.lexeme, right: " "),
          right: tstop.lexeme
        )
      }
    InitialCondition { assignments } =>
      match spice_emit_node_voltage_binding(binding: assignments.first) {
        Present { value: binding_text } =>
          Present {
            value: spice_text_concat(left: ".ic ", right: binding_text)
          }
        Absent => Absent
      }
    Dc { source: _, vstart: _, vstop: _, vincr: _ } => Absent
    Ac { sweep: _, n: _, fstart: _, fstop: _ } => Absent
    NodeSet { assignments: _ } => Absent
    Options { modifiers: _ } => Absent
    Include { card: _ } => Absent
  }
}

fn spice_emit_deck_statement(stmt: DeckStatement) -> Optional<String> {
  match stmt {
    DeckComponent { component } => spice_emit_component(component: component)
    DeckDirective { directive } => spice_emit_directive(directive: directive)
    DeckModelCard { model: _ } => Absent
    DeckSubcircuit { definition: _ } => Absent
  }
}

fn spice_emit_body_lines(body: List<DeckStatement>) -> Optional<String> {
  fold_list(
    xs: body,
    empty: Present { value: "" },
    cons: fn(acc, stmt) {
      match acc {
        Absent => Absent
        Present { value: prefix } =>
          match spice_emit_deck_statement(stmt: stmt) {
            Present { value: line } =>
              if prefix == "" {
                Present { value: line }
              } else {
                Present {
                  value: spice_text_concat(
                    left: spice_text_concat(left: prefix, right: "\n"),
                    right: line
                  )
                }
              }
            Absent => Absent
          }
      }
    }
  )
}

fn spice_emit(netlist: SpiceNetlist) -> String {
  match spice_emit_body_lines(body: netlist.body) {
    Present { value: body_text } =>
      if netlist.title == "" {
        body_text
      } else {
        spice_text_concat(
          left: spice_text_concat(left: netlist.title, right: "\n"),
          right: body_text
        )
      }
    Absent => ""
  }
}

// ngspice-ready emit: appends mandatory `.end` terminator required by all SPICE3 parsers.
// Transient decks also carry the ngspice-39 batch `.control run` trailer so `ngspice -b`
// executes the analysis without a separate interactive wrapper.
// Tran detection is inlined as a direct coproduct branch (no detached *_is_* predicate).
fn spice_emit_ngspice(netlist: SpiceNetlist) -> String {
  let base = spice_emit(netlist: netlist)
  if base == "" {
    ""
  } else {
    let has_tran = fold_list(
      xs: netlist.body,
      empty: false,
      cons: fn(acc, stmt) {
        if acc {
          true
        } else {
          match stmt {
            DeckDirective { directive: Tran { tstep: _, tstop: _ } } => true
            _ => false
          }
        }
      }
    )
    if has_tran {
      spice_text_concat(
        left: spice_text_concat(left: base, right: "\n.control\nrun\nquit\n.endc"),
        right: "\n.end"
      )
    } else {
      spice_text_concat(left: base, right: "\n.end")
    }
  }
}

data spice_wave1_probe_resistor_netlist: SpiceNetlist = SpiceNetlist {
  title: "",
  body: Cons {
    head: DeckComponent {
      component: Resistor {
        name: ^r1,
        n_plus: Named { node: NamedNode { name: ^n1 } },
        n_minus: Named { node: NamedNode { name: ^n2 } },
        value: SpiceValue { lexeme: "1" }
      }
    },
    tail: Empty
  }
}

data spice_wave1_probe_resistor_line: String = "R1 n1 n2 1"

fn spice_parse_reject_unsupported() -> Outcome<SpiceNetlist> {
  outcome_rejected(
    d: Diagnostic {
      reason: ^spice_parse_wave1_unsupported,
      at: Textual { file: spice_wave1_fixture_file, extent: WholeFile },
      correction: Unavailable { reason: ExternalContractUnknown }
    }
  )
}

fn spice_parse_is_wave1_probe_line(text: String) -> Bool {
  (text == spice_wave1_probe_resistor_line)
    || (text == spice_emit(netlist: spice_wave1_probe_resistor_netlist))
}

fn spice_parse_accept_probe() -> Outcome<SpiceNetlist> {
  outcome_accepted(value: spice_wave1_probe_resistor_netlist)
}

// Wave-1 parse: structural inverse of spice_emit for enrolled witness netlists only.
fn spice_parse(text: String) -> Outcome<SpiceNetlist> {
  if spice_parse_is_wave1_probe_line(text: text) {
    spice_parse_accept_probe()
  } else {
    spice_parse_reject_unsupported()
  }
}

data spice_io_contract: SpiceIoContract = SpiceIoContract {
  parse: spice_parse,
  emit: spice_emit
}
