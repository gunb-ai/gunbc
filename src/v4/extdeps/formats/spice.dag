// src/v4/extdeps/formats/spice.dag
//
// Scope: SPICE netlist model — direction-agnostic. Analog circuit
//        description: components, nodes, .model cards, directives. A flat
//        component + connection graph — NO control flow.
// Anchor: "SPICE3 Version 3f5 User's Guide" (Quarles et al., UC Berkeley
//         ERL, 1993) — the canonical versioned netlist-format spec the
//         worker models against; the ngspice User's Manual (pin a
//         concrete release, e.g. ngspice-44) is the maintained versioned
//         reference. NOT Wikipedia — https://en.wikipedia.org/wiki/SPICE
//         is accessible context only.
// Stress (T-4.10 — a B2-OMNI falsification probe): SPICE is **Shape B**
//   (a data format, per L-1) — it is NOT a `LanguageModel` and never
//   touches the compiler-language (Shape A) ingest boundary. The probe
//   tests the **Shape B format data-model** abstraction only: is it
//   ACTUALLY general, or secretly programming-language-shaped? A netlist
//   has no control flow — it is components plus a connection graph. If
//   the format data-model cannot represent a netlist without contortion,
//   that is a substrate-design signal to surface NOW
//   (STOP-and-escalate), not after it is load-bearing.
// Clear win: ONE `.dag` circuit declaration → a SPICE netlist that
//   simulates (omni-emission reaches analog hardware).
// Status: T-4.10 modeled 2026-05-16 (smart-raven-655); physical-quantity axis wave-1 (quiet-otter-381) — approximate voltage + named exact-carrier gap (T-3 `Dimension`/`Volt` std/ dissolution deferred). The I/O contract
// lives in the module body for downstream workers. Splitting this
// file requires explicit operator ratification (substrate extension =
// stop signal).


module v4.extdeps.formats.spice


import v4.std.diagnostic { Outcome }
import v4.std.grammar { FormalProduction, ParseGrammar, GrammarExpr, GrammarProduction, GrammarRoot, GrammarSchema, GrammarSchemaProbe, GrammarSchemaProbeBinding, ModeledGrammar, grammar_atom, grammar_empty_sync_tokens, grammar_formal_nonterminal, grammar_formal_terminal }
import v4.std.compilers.lexing {
  CharClassPattern,
  DigitChar,
  IdentContinueChar,
  IdentStartChar,
  LexPattern,
  LexRule,
  LexRuleSet,
  LexRules,
  ModeledLexRules,
  OneOrMorePattern,
  RepeatPattern,
  SequencePattern,
  TokenRule,
  TriviaRule,
  WhitespaceChar
}
import v4.std.node { Symbol }


type NamedNode {
  name: Symbol
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type NodeRef
  = Ground
  | Named { node: NamedNode }


type SpiceValue {
  lexeme: String
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SpiceVoltUnit {}

// 🟡 needs-more-work — feature:spice-approx-voltage-consumer — dissolve-on: NodeVoltageBinding consumer projects through SpiceApproxVoltage (T-4 wave-2) · ledger: T-4
type SpiceApproxVoltage {
  magnitude_lexeme: String
  unit: SpiceVoltUnit
}

// 🟡 needs-more-work — feature:spice-exact-voltage-gap — dissolve-on: std/ exact-real / Dimension substrate (T-3) · ledger: T-4
type SpiceExactVoltageGap {}
type Parameter {
  name: Symbol
  value: SpiceValue
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Modifier
  = Flag { name: Symbol }
  | KeyValue { name: Symbol, value: SpiceValue }


type IncludeCard {
  path: String
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SweepSourceKind
  = Voltage
  | Current


type SweepSourceRef {
  kind: SweepSourceKind
  name: Symbol
}


type InductorRef {
  name: Symbol
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SubstrateSpec
  = SubstrateImplicit
  | SubstrateExplicit { node: NodeRef }


// 🟡 coproduct dissolution — feature:spice-component-spec-exhaustive-coverage — dissolve-on-arrival: all SPICE3F5 element kinds and per-variant statement grammar are modeled structurally.
type Component
  = Resistor { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | Capacitor { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | Inductor { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | VoltageSource { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | CurrentSource { name: Symbol, n_plus: NodeRef, n_minus: NodeRef, value: SpiceValue }
  | Diode { name: Symbol, anode: NodeRef, cathode: NodeRef, model: Symbol }
  | Bjt { name: Symbol, collector: NodeRef, base: NodeRef, emitter: NodeRef, substrate: SubstrateSpec, model: Symbol, modifiers: List<Modifier> }
  | Mosfet { name: Symbol, drain: NodeRef, gate: NodeRef, source: NodeRef, body: NodeRef, model: Symbol, modifiers: List<Modifier> }
  | MutualInductance { name: Symbol, l1: InductorRef, l2: InductorRef, coupling: SpiceValue }
  | SubcircuitCall { name: Symbol, connections: SubcircuitConnections, subcircuit: Symbol, parameters: List<Parameter> }


// 🟡 coproduct dissolution — feature:spice-model-kind-spec-exhaustive-coverage — dissolve-on-arrival: all model-referencing SPICE3F5 component variants have matching ModelKind coverage.
type ModelKind
  = DiodeModel
  | BjtNpn
  | BjtPnp
  | MosfetNmos
  | MosfetPmos


type ModelCard {
  name: Symbol
  kind: ModelKind
  parameters: List<Parameter>
}


// 🟡 coproduct dissolution — consumer:spice-ac-sweep-point-generator — dissolve-on-arrival: first frequency-stepping consumer derives from spacing-law and ratio-base axes.
type AcSweepKind
  = Linear
  | Decade
  | Octave


type NodeVoltageBinding {
  node: NodeRef
  value: SpiceValue
}


type NodeVoltageBindings {
  first: NodeVoltageBinding
  rest: List<NodeVoltageBinding>
}


// 🟡 coproduct dissolution — feature:spice-directive-spec-exhaustive-coverage — dissolve-on-arrival: all SPICE3F5 analysis/control directives and per-variant grammar are modeled structurally.
type Directive
  = Op
  | Tran { tstep: SpiceValue, tstop: SpiceValue }
  | Dc { source: SweepSourceRef, vstart: SpiceValue, vstop: SpiceValue, vincr: SpiceValue }
  | Ac { sweep: AcSweepKind, n: SpiceValue, fstart: SpiceValue, fstop: SpiceValue }
  | InitialCondition { assignments: NodeVoltageBindings }
  | NodeSet { assignments: NodeVoltageBindings }
  | Options { modifiers: List<Modifier> }
  | Include { card: IncludeCard }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type SubcircuitStatement
  = StmtComponent { component: Component }
  | StmtModel { model: ModelCard }
  | StmtInclude { card: IncludeCard }


type SubcircuitDefinition {
  name: Symbol
  parent_scope: List<Symbol>
  ports: SubcircuitPorts
  body: List<SubcircuitStatement>
}


type SubcircuitPorts {
  first: NamedNode
  rest: List<NamedNode>
}


type SubcircuitConnections {
  first: NodeRef
  rest: List<NodeRef>
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type DeckStatement
  = DeckComponent { component: Component }
  | DeckModelCard { model: ModelCard }
  | DeckSubcircuit { definition: SubcircuitDefinition }
  | DeckDirective { directive: Directive }


// 🟡 needs-more-work — feature:spice-nested-subckt-position-fidelity — consumer:byte-exact-nested-subckt-roundtrip — dissolve-on-arrival: prefer SubcircuitDefinition as SubcircuitStatement; fallback position_in_parent metadata while A1 holds.
type SpiceNetlist {
  title: String
  body: List<DeckStatement>
}

type SpiceParseResult = Outcome<SpiceNetlist>

type SpiceParse = fn(String) -> SpiceParseResult

type SpiceEmit = fn(SpiceNetlist) -> String

type SpiceIoContract {
  parse: SpiceParse
  emit: SpiceEmit
}
fn spice_lex_token(token_class: Symbol, pattern: LexPattern) -> LexRule {
  TokenRule { token_class: token_class, pattern: pattern }
}


fn spice_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class }
}


fn spice_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}


fn spice_identifier_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}


fn spice_value_pattern() -> LexPattern {
  OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
}


fn spice_wave1_lex() -> LexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: [
        TriviaRule { pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } } },
        spice_lex_token(token_class: ^spice_token_ident, pattern: spice_identifier_pattern()),
        spice_lex_token(token_class: ^spice_token_value, pattern: spice_value_pattern())
      ]
    }
  }
}


fn spice_resistor_statement_expr() -> GrammarExpr {
  spice_grammar_sequence(
    left: spice_grammar_terminal(token_class: ^spice_token_ident),
    right: spice_grammar_sequence(
      left: spice_grammar_terminal(token_class: ^spice_token_ident),
      right: spice_grammar_sequence(
        left: spice_grammar_terminal(token_class: ^spice_token_ident),
        right: spice_grammar_terminal(token_class: ^spice_token_value)
      )
    )
  )
}


fn spice_wave1_grammar() -> ParseGrammar {
  let start = GrammarProduction {
    name: ^spice_production_resistor_statement,
    expression: spice_resistor_statement_expr(),
    emitted: grammar_atom(identity: ^spice_surface_resistor_statement)
  }
  ModeledGrammar {
    root: GrammarRoot {
      start: ^spice_production_resistor_statement,
      productions: [start],
      sync_tokens: grammar_empty_sync_tokens()
    }
  }
}


fn spice_resistor_statement_formal_production() -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: ^spice_production_resistor_statement),
    rhs: [
      grammar_formal_terminal(identity: ^spice_token_ident),
      grammar_formal_terminal(identity: ^spice_token_ident),
      grammar_formal_terminal(identity: ^spice_token_ident),
      grammar_formal_terminal(identity: ^spice_token_value)
    ]
  }
}


fn spice_format_grammar_schema() -> GrammarSchema {
  GrammarSchema {
    lex: spice_wave1_lex(),
    grammar: spice_wave1_grammar()
  }
}


fn spice_format_grammar_probe() -> GrammarSchemaProbeBinding {
  GrammarSchemaProbeBinding {
    schema: spice_format_grammar_schema(),
    probe: GrammarSchemaProbe {
      fixture: "R1 n1 n2 1",
      production: spice_resistor_statement_formal_production(),
      expected_parse_surface: grammar_atom(identity: ^spice_surface_resistor_statement)
    }
  }
}
