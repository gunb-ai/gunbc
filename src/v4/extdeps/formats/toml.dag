// src/v4/extdeps/formats/toml.dag
// Scope: TOML v1.0.0 structural value model — declarative only; parse/emit deferred.
// Owns: TOML structural value, document, lexeme, table-syntax, and parse/emit axis model.
// Consumes: std/node.dag; std/diagnostic.dag; std/collection.dag.
// Status: T-4.6 scaffold — parse/emit, numeric/datetime, table-syntax axes per TASKS.md T-4.6.
// Anchor: https://toml.io/en/v1.0.0

module v4.extdeps.formats.toml


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type TomlSign
  = TomlSignAbsent
  | TomlSignPlus
  | TomlSignMinus


type TomlUnderscoreSeparatedDigitsProfile {}


// TOML integers carry sign only on decimal form; hex/octal/binary forms are
// unsigned lexical forms. Width and machine representation are deliberately
// absent because the TOML spec defines syntax, not a target width.
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type TomlIntegerLexemeProfile
  = TomlDecimalIntegerLexemeProfile {
      sign: TomlSign,
      underscores: TomlUnderscoreSeparatedDigitsProfile,
    }
  | TomlHexIntegerLexemeProfile {
      underscores: TomlUnderscoreSeparatedDigitsProfile,
    }
  | TomlOctalIntegerLexemeProfile {
      underscores: TomlUnderscoreSeparatedDigitsProfile,
    }
  | TomlBinaryIntegerLexemeProfile {
      underscores: TomlUnderscoreSeparatedDigitsProfile,
    }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type TomlFloatLexemeProfile
  = TomlFiniteFloatLexemeProfile {
      sign: TomlSign,
      underscores: TomlUnderscoreSeparatedDigitsProfile,
    }
  | TomlInfFloatLexemeProfile {
      sign: TomlSign,
    }
  | TomlNanFloatLexemeProfile {
      sign: TomlSign,
    }


type TomlIntegerLexeme {
  lexeme: String,
  profile: TomlIntegerLexemeProfile,
}


type TomlFloatLexeme {
  lexeme: String,
  profile: TomlFloatLexemeProfile,
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type TomlDatetimeLexeme
  = TomlOffsetDateTimeLexeme { lexeme: String }
  | TomlLocalDateTimeLexeme { lexeme: String }
  | TomlLocalDateLexeme { lexeme: String }
  | TomlLocalTimeLexeme { lexeme: String }


type TomlDottedKeysDefineTablesFact {}


type TomlDuplicateKeysRejectedFact {}


type TomlDuplicateTablesRejectedFact {}


type TomlUniqueNameProfile {
  dotted_keys_define_tables: TomlDottedKeysDefineTablesFact,
  duplicate_keys_rejected: TomlDuplicateKeysRejectedFact,
  duplicate_tables_rejected: TomlDuplicateTablesRejectedFact,
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type TomlTableHeaderSyntax
  = TomlStandardTable
  | TomlArrayOfTablesElement


type TomlTablePath {
  head: String,
  tail: List<String>,
}


type TomlTableHeaderSyntaxProfile {
  syntax: TomlTableHeaderSyntax,
  path: TomlTablePath,
}


type TomlInlineTableClosedFact {}


type TomlInlineTableSyntaxProfile {
  closed_inline_scope: TomlInlineTableClosedFact,
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type TomlTable {
  syntax: TomlTableHeaderSyntaxProfile,
  entries: Map<String, TomlValue>,
}


type TomlRootTable {
  entries: Map<String, TomlValue>,
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type TomlValue
  = TomlString { value: String }
  | TomlInt { numeric: TomlIntegerLexeme }
  | TomlFloat { numeric: TomlFloatLexeme }
  | TomlBool { value: Bool }
  | TomlDatetime { datetime: TomlDatetimeLexeme }
  | TomlArray { elements: List<TomlValue> }
  | TomlInlineTable {
      syntax: TomlInlineTableSyntaxProfile,
      entries: Map<String, TomlValue>,
    }
  | TomlTableValue { table: TomlTable }


type TomlDocument {
  root: TomlRootTable,
  unique_names: TomlUniqueNameProfile,
}


// 🟡 gated — feature: T-6 lexical-walk + T-7 parse-walk compiler pipeline-stage substrate (TASKS T-6/T-7) — SL-3229-T4-FORMAT-T6T7 (parse half).
type TomlParseAxis {
  source_text: String,
  unique_names: TomlUniqueNameProfile,
}


// 🟡 gated — feature: T-10 emit pipeline-stage substrate (TASKS T-10) — SL-3229-T4-FORMAT-T6T7 (emit half).
type TomlEmitAxis {
  document: TomlDocument,
}


// 🟡 gated — feature: T-6 lexical-walk + T-7 parse-walk compiler pipeline-stage substrate (TASKS T-6/T-7) — SL-3229-T4-FORMAT-T6T7 (parse half).
// 🟡 gated — feature: T-10 emit pipeline-stage substrate (TASKS T-10) — SL-3229-T4-FORMAT-T6T7 (emit half).
