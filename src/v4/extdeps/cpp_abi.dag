// src/v4/extdeps/cpp_abi.dag
// Scope: C++ ABI / target data-model facts for implementation-defined fundamental widths.
// Anchor: ISO/IEC 14882:2024 [basic.fundamental] + Itanium C++ ABI revision 1.86.
// Owns: CppMachineWidth8/16/32/64, CppIntegerWidth, CppCoreIntegerWidthModel, CppPlainCharSignedness, CppWcharTSignedness, CppDataModelFamily, CppAbiModel, CppTargetDataModel, CppTargetProfile, Cpp{ILP32,LP64,LLP64,ILP64}DataModel<plain_char_signedness,wchar_t_signedness>, CppFundamentalWidthRole, CppIntegerWidthSelectionWitness, CppDataModelWidthSelectionWitnesses, Cpp{ILP32,LP64}WidthSelectionWitnesses, cpp_select_width_witness.
// Consumes: std/machine.dag vocabulary by coincidence index only: MachineWidth<Word8/16/32/64>.
// Status: T-29 modeled 2026-05-18.

module v4.extdeps.cpp_abi

// tag: coincides with T-3 MachineWidth<WordN>.
// 🟢 pretty-much-done — ABI machine-width atoms; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppMachineWidth8
type CppMachineWidth16
type CppMachineWidth32
type CppMachineWidth64

// 🟢 coproduct dissolution — T29-ABI.
type CppIntegerWidth
  = CppWidth8 { width: CppMachineWidth8 }
  | CppWidth16 { width: CppMachineWidth16 }
  | CppWidth32 { width: CppMachineWidth32 }
  | CppWidth64 { width: CppMachineWidth64 }

// 🟢 pretty-much-done — core integer-width bundle includes wchar_t width; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppCoreIntegerWidthModel<char_width, short_width, int_width, long_width, long_long_width, pointer_width, wchar_t_width>

// 🟢 coproduct dissolution — T29-ABI.
type CppPlainCharSignedness
  = PlainCharSigned { tag: CppPlainCharSigned }
  | PlainCharUnsigned { tag: CppPlainCharUnsigned }

type CppPlainCharSigned
type CppPlainCharUnsigned

// 🟢 pretty-much-done — implementation-defined wchar_t signedness coordinate; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution — T29-ABI.
type CppWcharTSignedness
  = WcharTSigned { tag: CppWcharTSigned }
  | WcharTUnsigned { tag: CppWcharTUnsigned }

type CppWcharTSigned
type CppWcharTUnsigned

// 🟢 pretty-much-done — standard data-model family names; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution — T29-ABI.
type CppDataModelFamily
  = ILP32 { tag: CppDataModelFamilyILP32 }
  | LP64 { tag: CppDataModelFamilyLP64 }
  | LLP64 { tag: CppDataModelFamilyLLP64 }
  | ILP64 { tag: CppDataModelFamilyILP64 }

type CppDataModelFamilyILP32
type CppDataModelFamilyLP64
type CppDataModelFamilyLLP64
type CppDataModelFamilyILP64

// 🟢 pretty-much-done — ABI model selector; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
// 🟢 coproduct dissolution — T29-ABI.
type CppAbiModel
  = ItaniumCxxAbi186 { tag: CppAbiModelItaniumCxxAbi186 }
  | PlatformCxxAbi { tag: CppAbiModelPlatformCxxAbi }

type CppAbiModelItaniumCxxAbi186
type CppAbiModelPlatformCxxAbi

// 🟢 pretty-much-done — single target-profile authority for widths and character signedness; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppTargetDataModel<family, integer_widths, plain_char_signedness, wchar_t_signedness>
type CppTargetProfile<abi_model, data_model>

// 🟢 pretty-much-done — concrete ABI-width aliases; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppIntegerWidth8 = CppWidth8 { width: CppMachineWidth8 }
type CppIntegerWidth16 = CppWidth16 { width: CppMachineWidth16 }
type CppIntegerWidth32 = CppWidth32 { width: CppMachineWidth32 }
type CppIntegerWidth64 = CppWidth64 { width: CppMachineWidth64 }

// 🟢 pretty-much-done — concrete data-model aliases preserve both character signedness coordinates; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppILP32IntegerWidths = CppCoreIntegerWidthModel<CppIntegerWidth8, CppIntegerWidth16, CppIntegerWidth32, CppIntegerWidth32, CppIntegerWidth64, CppIntegerWidth32, CppIntegerWidth32>
type CppILP32DataModel<plain_char_signedness, wchar_t_signedness> = CppTargetDataModel<CppDataModelFamilyILP32, CppILP32IntegerWidths, plain_char_signedness, wchar_t_signedness>

type CppLP64IntegerWidths = CppCoreIntegerWidthModel<CppIntegerWidth8, CppIntegerWidth16, CppIntegerWidth32, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth32>
type CppLP64DataModel<plain_char_signedness, wchar_t_signedness> = CppTargetDataModel<CppDataModelFamilyLP64, CppLP64IntegerWidths, plain_char_signedness, wchar_t_signedness>

type CppLLP64IntegerWidths = CppCoreIntegerWidthModel<CppIntegerWidth8, CppIntegerWidth16, CppIntegerWidth32, CppIntegerWidth32, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth16>
type CppLLP64DataModel<plain_char_signedness, wchar_t_signedness> = CppTargetDataModel<CppDataModelFamilyLLP64, CppLLP64IntegerWidths, plain_char_signedness, wchar_t_signedness>

type CppILP64IntegerWidths = CppCoreIntegerWidthModel<CppIntegerWidth8, CppIntegerWidth16, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth32>
type CppILP64DataModel<plain_char_signedness, wchar_t_signedness> = CppTargetDataModel<CppDataModelFamilyILP64, CppILP64IntegerWidths, plain_char_signedness, wchar_t_signedness>

// 🟢 coproduct dissolution — T29-ABI.
type CppFundamentalWidthRole
  = CharFundamentalWidth { tag: CppFundamentalWidthRoleChar }
  | ShortFundamentalWidth { tag: CppFundamentalWidthRoleShort }
  | IntFundamentalWidth { tag: CppFundamentalWidthRoleInt }
  | LongFundamentalWidth { tag: CppFundamentalWidthRoleLong }
  | LongLongFundamentalWidth { tag: CppFundamentalWidthRoleLongLong }
  | PointerFundamentalWidth { tag: CppFundamentalWidthRolePointer }
  | WcharTFundamentalWidth { tag: CppFundamentalWidthRoleWcharT }

type CppFundamentalWidthRoleChar
type CppFundamentalWidthRoleShort
type CppFundamentalWidthRoleInt
type CppFundamentalWidthRoleLong
type CppFundamentalWidthRoleLongLong
type CppFundamentalWidthRolePointer
type CppFundamentalWidthRoleWcharT

// 🟢 pretty-much-done — per-fundamental width witness; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppIntegerWidthSelectionWitness {
  role: CppFundamentalWidthRole
  selected_width: CppIntegerWidth
}

// 🟢 pretty-much-done — closed witness bundle for one ABI data-model family; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppDataModelWidthSelectionWitnesses {
  char_width: CppIntegerWidthSelectionWitness
  short_width: CppIntegerWidthSelectionWitness
  int_width: CppIntegerWidthSelectionWitness
  long_width: CppIntegerWidthSelectionWitness
  long_long_width: CppIntegerWidthSelectionWitness
  pointer_width: CppIntegerWidthSelectionWitness
  wchar_t_width: CppIntegerWidthSelectionWitness
}

// 🟢 pretty-much-done — ILP32 width-selection witnesses aligned with CppILP32IntegerWidths; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppILP32WidthSelectionWitnesses = CppDataModelWidthSelectionWitnesses {
  char_width: CppIntegerWidthSelectionWitness {
    role: CharFundamentalWidth { tag: CppFundamentalWidthRoleChar },
    selected_width: CppIntegerWidth8
  },
  short_width: CppIntegerWidthSelectionWitness {
    role: ShortFundamentalWidth { tag: CppFundamentalWidthRoleShort },
    selected_width: CppIntegerWidth16
  },
  int_width: CppIntegerWidthSelectionWitness {
    role: IntFundamentalWidth { tag: CppFundamentalWidthRoleInt },
    selected_width: CppIntegerWidth32
  },
  long_width: CppIntegerWidthSelectionWitness {
    role: LongFundamentalWidth { tag: CppFundamentalWidthRoleLong },
    selected_width: CppIntegerWidth32
  },
  long_long_width: CppIntegerWidthSelectionWitness {
    role: LongLongFundamentalWidth { tag: CppFundamentalWidthRoleLongLong },
    selected_width: CppIntegerWidth64
  },
  pointer_width: CppIntegerWidthSelectionWitness {
    role: PointerFundamentalWidth { tag: CppFundamentalWidthRolePointer },
    selected_width: CppIntegerWidth32
  },
  wchar_t_width: CppIntegerWidthSelectionWitness {
    role: WcharTFundamentalWidth { tag: CppFundamentalWidthRoleWcharT },
    selected_width: CppIntegerWidth32
  }
}

// 🟢 pretty-much-done — LP64 width-selection witnesses aligned with CppLP64IntegerWidths; testcase: test/claim/manual/cpp_scalar_grounding_anchor.dag.
type CppLP64WidthSelectionWitnesses = CppDataModelWidthSelectionWitnesses {
  char_width: CppIntegerWidthSelectionWitness {
    role: CharFundamentalWidth { tag: CppFundamentalWidthRoleChar },
    selected_width: CppIntegerWidth8
  },
  short_width: CppIntegerWidthSelectionWitness {
    role: ShortFundamentalWidth { tag: CppFundamentalWidthRoleShort },
    selected_width: CppIntegerWidth16
  },
  int_width: CppIntegerWidthSelectionWitness {
    role: IntFundamentalWidth { tag: CppFundamentalWidthRoleInt },
    selected_width: CppIntegerWidth32
  },
  long_width: CppIntegerWidthSelectionWitness {
    role: LongFundamentalWidth { tag: CppFundamentalWidthRoleLong },
    selected_width: CppIntegerWidth64
  },
  long_long_width: CppIntegerWidthSelectionWitness {
    role: LongLongFundamentalWidth { tag: CppFundamentalWidthRoleLongLong },
    selected_width: CppIntegerWidth64
  },
  pointer_width: CppIntegerWidthSelectionWitness {
    role: PointerFundamentalWidth { tag: CppFundamentalWidthRolePointer },
    selected_width: CppIntegerWidth64
  },
  wchar_t_width: CppIntegerWidthSelectionWitness {
    role: WcharTFundamentalWidth { tag: CppFundamentalWidthRoleWcharT },
    selected_width: CppIntegerWidth32
  }
}

fn cpp_select_width_witness(
  witnesses: CppDataModelWidthSelectionWitnesses,
  role: CppFundamentalWidthRole
) -> CppIntegerWidthSelectionWitness {
  match role {
    CharFundamentalWidth { tag: _ } => witnesses.char_width
    ShortFundamentalWidth { tag: _ } => witnesses.short_width
    IntFundamentalWidth { tag: _ } => witnesses.int_width
    LongFundamentalWidth { tag: _ } => witnesses.long_width
    LongLongFundamentalWidth { tag: _ } => witnesses.long_long_width
    PointerFundamentalWidth { tag: _ } => witnesses.pointer_width
    WcharTFundamentalWidth { tag: _ } => witnesses.wchar_t_width
  }
}
