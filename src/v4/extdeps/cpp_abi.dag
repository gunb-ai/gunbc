// src/v4/extdeps/cpp_abi.dag
// Scope: C++ ABI / target data-model facts for implementation-defined fundamental widths.
// Anchor: ISO/IEC 14882:2024 [basic.fundamental] + Itanium C++ ABI revision 1.86.
// Owns: CppMachineWidth8/16/32/64, CppIntegerWidth, CppCoreIntegerWidthModel, CppPlainCharSignedness, CppWcharTSignedness, CppDataModelFamily, CppAbiModel, CppTargetDataModel, CppTargetProfile, Cpp{ILP32,LP64,LLP64,ILP64}DataModel<plain_char_signedness,wchar_t_signedness>.
// Consumes: std/machine.dag vocabulary by coincidence index only: MachineWidth<Word8/16/32/64>.
// Status: T-29 modeled 2026-05-18.

module v4.extdeps.cpp_abi

// tag: coincides with T-3 MachineWidth<WordN>.
type CppMachineWidth8
type CppMachineWidth16
type CppMachineWidth32
type CppMachineWidth64

// 🟢 coproduct dissolution — DECISIONS.md T29-ABI.
type CppIntegerWidth
  = CppWidth8 { width: CppMachineWidth8 }
  | CppWidth16 { width: CppMachineWidth16 }
  | CppWidth32 { width: CppMachineWidth32 }
  | CppWidth64 { width: CppMachineWidth64 }

type CppCoreIntegerWidthModel<char_width, short_width, int_width, long_width, long_long_width, pointer_width, wchar_t_width>

// 🟢 coproduct dissolution — DECISIONS.md T29-ABI.
type CppPlainCharSignedness
  = PlainCharSigned { tag: CppPlainCharSigned }
  | PlainCharUnsigned { tag: CppPlainCharUnsigned }

type CppPlainCharSigned
type CppPlainCharUnsigned

// 🟢 coproduct dissolution — DECISIONS.md T29-ABI.
type CppWcharTSignedness
  = WcharTSigned { tag: CppWcharTSigned }
  | WcharTUnsigned { tag: CppWcharTUnsigned }

type CppWcharTSigned
type CppWcharTUnsigned

// 🟢 coproduct dissolution — DECISIONS.md T29-ABI.
type CppDataModelFamily
  = ILP32 { tag: CppDataModelFamilyILP32 }
  | LP64 { tag: CppDataModelFamilyLP64 }
  | LLP64 { tag: CppDataModelFamilyLLP64 }
  | ILP64 { tag: CppDataModelFamilyILP64 }

type CppDataModelFamilyILP32
type CppDataModelFamilyLP64
type CppDataModelFamilyLLP64
type CppDataModelFamilyILP64

// 🟢 coproduct dissolution — DECISIONS.md T29-ABI.
type CppAbiModel
  = ItaniumCxxAbi186 { tag: CppAbiModelItaniumCxxAbi186 }
  | PlatformCxxAbi { tag: CppAbiModelPlatformCxxAbi }

type CppAbiModelItaniumCxxAbi186
type CppAbiModelPlatformCxxAbi

type CppTargetDataModel<family, integer_widths, plain_char_signedness, wchar_t_signedness>
type CppTargetProfile<abi_model, data_model>

type CppIntegerWidth8 = CppWidth8 { width: CppMachineWidth8 }
type CppIntegerWidth16 = CppWidth16 { width: CppMachineWidth16 }
type CppIntegerWidth32 = CppWidth32 { width: CppMachineWidth32 }
type CppIntegerWidth64 = CppWidth64 { width: CppMachineWidth64 }

type CppILP32IntegerWidths = CppCoreIntegerWidthModel<CppIntegerWidth8, CppIntegerWidth16, CppIntegerWidth32, CppIntegerWidth32, CppIntegerWidth64, CppIntegerWidth32, CppIntegerWidth32>
type CppILP32DataModel<plain_char_signedness, wchar_t_signedness> = CppTargetDataModel<CppDataModelFamilyILP32, CppILP32IntegerWidths, plain_char_signedness, wchar_t_signedness>

type CppLP64IntegerWidths = CppCoreIntegerWidthModel<CppIntegerWidth8, CppIntegerWidth16, CppIntegerWidth32, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth32>
type CppLP64DataModel<plain_char_signedness, wchar_t_signedness> = CppTargetDataModel<CppDataModelFamilyLP64, CppLP64IntegerWidths, plain_char_signedness, wchar_t_signedness>

type CppLLP64IntegerWidths = CppCoreIntegerWidthModel<CppIntegerWidth8, CppIntegerWidth16, CppIntegerWidth32, CppIntegerWidth32, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth16>
type CppLLP64DataModel<plain_char_signedness, wchar_t_signedness> = CppTargetDataModel<CppDataModelFamilyLLP64, CppLLP64IntegerWidths, plain_char_signedness, wchar_t_signedness>

type CppILP64IntegerWidths = CppCoreIntegerWidthModel<CppIntegerWidth8, CppIntegerWidth16, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth64, CppIntegerWidth32>
type CppILP64DataModel<plain_char_signedness, wchar_t_signedness> = CppTargetDataModel<CppDataModelFamilyILP64, CppILP64IntegerWidths, plain_char_signedness, wchar_t_signedness>
