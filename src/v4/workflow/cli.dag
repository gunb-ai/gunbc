// src/v4/workflow/cli.dag
// Scope: gunbc CLI route contract rows (Branch H §H.5 CLI surface).
// Status: Wave-2 row-shaped route contracts for the Runtime/TestClaim CLI surface
//   (`gunbc testgen`, `gunbc test`). Deliberately NOT a closed command coproduct so
//   Source-authority (Branch H) can compose its own `gunbc compile --target dag` row
//   without duplicate authority — coordinated with Source-authority Mgr (silent-koi-227).
// Authority split (§H.5): testgen/test are Runtime/TestClaim CLI rows; compile --target
//   dag is the source-authority row; JSON/IR output is boundary/debug, never source.

module v4.workflow.cli


import v4.std.node { Symbol }
import v4.std.artifact { GeneratorId, GeneratedArtifact, GeneratorProvenance }


// Semantic class of a gunbc CLI route, per §H.5 RR-H acceptance ("CLI routes named by
// source vs debug semantics"). A neutral shared classifier: each domain's route rows are
// classified by their *row type* (see the per-row `*_semantics` functions below), so
// Source-authority can add `SourceAuthorityRoute`-classed rows (compile --target dag)
// alongside these Runtime/TestClaim rows without contention.
// 🟢 coproduct dissolution
type GunbcCliRouteSemantics
  = SourceAuthorityRoute
  | RuntimeTestClaimRoute
  | BoundaryDebugRoute


// `gunbc testgen` — synthesize generated TestClaim artifacts. The row names the producing
// generator; its route class is fixed by the row type (RuntimeTestClaimRoute, via
// `gunbc_testgen_route_semantics`), not a caller-supplied field, so it cannot be authored
// as a source-authority route (§H.5 / M2 single authority).
type GunbcTestgenRoute {
  route_name: Symbol
  generator: GeneratorId
}


// `gunbc test` — execute the TestClaim corpus at runtime (T-38 harness). A runtime verdict
// surface keyed by a corpus selection function, not an authoring-time / source-authority
// route. `selection_fn` mirrors the authority on `ci.dag` `TestClaimCorpusEvalCommand`.
type GunbcTestRoute {
  route_name: Symbol
  selection_fn: Symbol
}


// Route class is *derived from the row type*, not stored as payload — a Runtime/TestClaim
// route cannot be misclassified as source-authority.
fn gunbc_testgen_route_semantics(_route: GunbcTestgenRoute) -> GunbcCliRouteSemantics {
  RuntimeTestClaimRoute
}

fn gunbc_test_route_semantics(_route: GunbcTestRoute) -> GunbcCliRouteSemantics {
  RuntimeTestClaimRoute
}


// Canonical row names — single authority for the two Runtime/TestClaim CLI route names
// (self-identifying Symbol idiom, cf. `dag_language_model_surface_id`).
data gunbc_testgen_route_name: Symbol = gunbc_testgen_route_name
data gunbc_test_route_name: Symbol = gunbc_test_route_name


// Canonical constructors pin each row's name so a consumer cannot mint an off-contract
// route name.
fn gunbc_testgen_route(generator: GeneratorId) -> GunbcTestgenRoute {
  GunbcTestgenRoute {
    route_name: gunbc_testgen_route_name,
    generator: generator
  }
}

fn gunbc_test_route(selection_fn: Symbol) -> GunbcTestRoute {
  GunbcTestRoute {
    route_name: gunbc_test_route_name,
    selection_fn: selection_fn
  }
}


// A `gunbc testgen` route attributes provenance to each generated artifact it emits,
// naming itself (its `generator`) as producer. This is the structural consumer of
// `GeneratorProvenance` / `GeneratedArtifact` on the CLI surface: the route + a generated
// artifact yield the provenance fact the testgen lens carries on `Generator<C>`.
fn gunbc_testgen_route_provenance(
  route: GunbcTestgenRoute,
  artifact: GeneratedArtifact
) -> GeneratorProvenance {
  GeneratorProvenance {
    generator_id: route.generator,
    artifact: artifact
  }
}
