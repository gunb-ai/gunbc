  entry: "src/v4/test/claim/lens_coverage/hollow_type_defect_key.dag",
  function: "hollow_type_defect_key_claim_holds"
}

data lens_ci_claim_run_row_structural_resolution_binds_to_resolved: LensCiClaimRunRow = LensCiClaimRunRow {
