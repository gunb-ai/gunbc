// src/v4/workflow/ci_runner.dag
// Scope: affected-set-driven TestClaim selection for incremental CI (Bazel-style node rerun frontier).
// Owns: test_claim_in_rerun_frontier, ci_select_from_rerun_nodes, ci_select_from_affected_set.
// Consumes: v4.lens.affected_set, v4.std.algebra, v4.std.change, v4.std.verification.
// Status: Wave-0 — structural selection over RerunNodeSet; host dispatch lands with T-22/T-24.

module v4.workflow.ci_runner

import v4.lens.affected_set {
  RerunNodeSet,
  RerunNodeSetFailClosed,
  RerunNodeSetProduced,
  affected_set_rerun_nodes
}
import v4.std.algebra { filter }
import v4.std.change { AffectedSet }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.node { Node }
import v4.std.verification { TestClaim, test_claim_evaluation_touches_rerun_frontier }


fn test_claim_in_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}


fn ci_select_from_rerun_nodes(roster: List<TestClaim>, rerun: RerunNodeSet) -> List<TestClaim> {
  match rerun {
    RerunNodeSetProduced { nodes: nodes } =>
      filter(
        xs: roster,
        predicate: fn(claim) {
          test_claim_in_rerun_frontier(claim: claim, frontier: nodes)
        }
      )
    RerunNodeSetFailClosed { evidence: _ } => roster
  }
}


fn ci_select_from_affected_set(roster: List<TestClaim>, affected: AffectedSet) -> List<TestClaim> {
  ci_select_from_rerun_nodes(
    roster: roster,
    rerun: affected_set_rerun_nodes(affected_set_value: affected)
  )
}
