// src/v4/workflow/ci_runner.dag
// Scope: affected-set-driven TestClaim selection for incremental CI (Bazel-style node rerun frontier).
// Owns: CiClaimRoster, CiRerunSelection, test_claim_in_rerun_frontier, select_test_claims_for_rerun,
//       ci_select_from_rerun_nodes, ci_select_from_affected_set.
// Consumes: v4.lens.affected_set, v4.std.change, v4.std.verification.
// Status: Wave-0 — structural selection over RerunNodeSet; host dispatch lands with T-22/T-24.

module v4.workflow.ci_runner

import v4.lens.affected_set {
  AffectedSet,
  RerunNodeSet,
  RerunNodeSetFailClosed,
  RerunNodeSetProduced,
  affected_set_rerun_nodes
}
import v4.std.change { AffectedSetEvidence }
import v4.std.collection { List }
import v4.std.node { Node }
import v4.std.verification { TestClaim, test_claim_input }


// Node-level rerun frontier consumed by CI: narrow roster when produced, superset when fail-closed.
type CiRerunSelection
  = CiRerunNarrow { rerun: List<TestClaim> }
  | CiRerunSuperset { roster: List<TestClaim>, evidence: AffectedSetEvidence }


type CiClaimRoster = List<TestClaim>


fn node_in_rerun_frontier(needle: Node, frontier: List<Node>) -> Bool {
  fold(frontier, init: false, f: fn(found, node) {
    found || (node == needle)
  })
}


fn test_claim_in_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  node_in_rerun_frontier(needle: test_claim_input(c: claim), frontier: frontier)
}


fn append_claim_if_in_frontier(
  acc: List<TestClaim>,
  claim: TestClaim,
  frontier: List<Node>
) -> List<TestClaim> {
  if test_claim_in_rerun_frontier(claim: claim, frontier: frontier) {
    list_push(acc, claim)
  } else {
    acc
  }
}


fn select_test_claims_for_rerun(roster: CiClaimRoster, rerun: RerunNodeSet) -> CiRerunSelection {
  match rerun {
    RerunNodeSetProduced { nodes: nodes } =>
      CiRerunNarrow {
        rerun: fold(roster, init: [], f: fn(acc, claim) {
          append_claim_if_in_frontier(acc: acc, claim: claim, frontier: nodes)
        })
      }
    RerunNodeSetFailClosed { evidence: evidence } =>
      CiRerunSuperset {
        roster: roster,
        evidence: evidence
      }
  }
}


fn ci_select_from_rerun_nodes(roster: CiClaimRoster, rerun: RerunNodeSet) -> CiRerunSelection {
  select_test_claims_for_rerun(roster: roster, rerun: rerun)
}


fn ci_select_from_affected_set(roster: CiClaimRoster, affected: AffectedSet) -> CiRerunSelection {
  select_test_claims_for_rerun(
    roster: roster,
    rerun: affected_set_rerun_nodes(affected_set_value: affected)
  )
}
