// src/v4/workflow/runtime_run.dag
// Scope: thin sequential runtime run loop — scheduler RunnableFrontier → single
// eval_with_context step per ready node → receipt append. Wave-1 sequential,
// bounded: fold(nodes, ...) caps iteration to length(nodes) steps (mirrors
// scheduler_run_to_fixed_point in v4.workflow.scheduler).

module v4.workflow.runtime_run

import v4.compiler.eval {
  EvalContext,
  eval_with_context,
  inputs_root_only
}
import v4.compiler.infer { InferredTree }
import v4.std.algebra {
  is_empty,
  list_snoc_item,
  non_empty
}
import v4.std.collection { List, list_nth }
import v4.std.witness { Holds, Violates }
import v4.std.dependency { DependencyView }
import v4.std.diagnostic { Outcome, Rejected, diagnostics_singleton }
import v4.compiler.eval { eval_diagnostic }
import v4.std.node {
  ComputationNode,
  Node,
  SyntheticOccurrence,
  Value
}
import v4.std.runtime { RuntimeValue }
import v4.workflow.scheduler {
  RunnableFrontier,
  SchedulerBlockedEvidence,
  runnable_frontier_from_dependencies,
  scheduler_append_node_once,
  scheduler_blocked_evidence,
  scheduler_remaining_nodes
}

// Execution receipt for a single evaluated node.
type RuntimeRunReceipt {
  node: Node
  result: Outcome<RuntimeValue>
}

// Ordered log of receipts from the run loop.
type RuntimeRunLog {
  entries: List<RuntimeRunReceipt>
}

// Internal fold accumulator: receipts so far and nodes marked evaluated.
type RuntimeRunState {
  log: RuntimeRunLog
  scheduled: List<Node>
}

// 🟡 coproduct dissolution — feature:runtime-run-result — consumer:runtime_run —
// dissolve-on-arrival: host transport returns per-node execution verdicts back into
// .dag types, replacing plan-only blocked evidence (mirrors executor-host-run-result gate).
type RuntimeRunResult
  = RuntimeRunComplete {
      log: RuntimeRunLog
      scheduled: List<Node>
    }
  | RuntimeRunBlocked {
      evidence: SchedulerBlockedEvidence
      log: RuntimeRunLog
      scheduled: List<Node>
      remaining: List<Node>
    }

fn runtime_run_log_empty() -> RuntimeRunLog {
  RuntimeRunLog { entries: [] }
}

fn runtime_run_append_receipt(
  log: RuntimeRunLog,
  node: Node,
  result: Outcome<RuntimeValue>
) -> RuntimeRunLog {
  RuntimeRunLog {
    entries: list_snoc_item(
      xs: log.entries,
      item: RuntimeRunReceipt { node: node, result: result }
    )
  }
}

fn runtime_run_eval_node(
  state: RuntimeRunState,
  node: Node,
  tree: InferredTree,
  context: EvalContext
) -> RuntimeRunState {
  let result = eval_with_context(
    tree: tree,
    context: context,
    inputs: inputs_root_only(root: node)
  )
  RuntimeRunState {
    log: runtime_run_append_receipt(log: state.log, node: node, result: result),
    scheduled: scheduler_append_node_once(nodes: state.scheduled, node: node)
  }
}

// Evaluate every ready node in frontier sequentially, appending a receipt per node.
// Single wave-1 step: no parallelism, fail-closed per node (receipt captures Rejected too).
fn runtime_run_step_from_frontier(
  frontier: RunnableFrontier,
  state: RuntimeRunState,
  tree: InferredTree,
  context: EvalContext
) -> RuntimeRunState {
  fold(frontier.ready, init: state, f: fn(acc, node) {
    runtime_run_eval_node(state: acc, node: node, tree: tree, context: context)
  })
}

// One scheduling step: derive the current runnable frontier and evaluate it.
fn runtime_run_step_state(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  tree: InferredTree,
  context: EvalContext,
  state: RuntimeRunState
) -> RuntimeRunState {
  let frontier = runnable_frontier_from_dependencies(
    nodes: nodes,
    dependencies: dependencies,
    scheduled: state.scheduled
  )
  if non_empty(xs: frontier.ready) {
    runtime_run_step_from_frontier(
      frontier: frontier,
      state: state,
      tree: tree,
      context: context
    )
  } else {
    state
  }
}

fn runtime_run_result_from_state(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  state: RuntimeRunState
) -> RuntimeRunResult {
  let remaining = scheduler_remaining_nodes(nodes: nodes, scheduled: state.scheduled)
  if is_empty(xs: remaining) {
    RuntimeRunComplete {
      log: state.log,
      scheduled: state.scheduled
    }
  } else {
    RuntimeRunBlocked {
      evidence: scheduler_blocked_evidence(),
      log: state.log,
      scheduled: state.scheduled,
      remaining: remaining
    }
  }
}

fn runtime_run_first_receipt_outcome(log: RuntimeRunLog) -> Outcome<RuntimeValue> {
  match list_nth(
    xs: log.entries,
    wanted: 0,
    absent: eval_diagnostic(reason: ^runtime_run_empty_log, node: receipt_placeholder_node())
  ) {
    Holds { value: receipt } => receipt.result
    Violates { diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

// Placeholder node for empty-log diagnostics only (no eval occurs).
fn receipt_placeholder_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Value },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

// Single-node convenience: runtime_run over one root, projecting the lone receipt outcome.
fn runtime_run_single_node(
  node: Node,
  dependencies: List<DependencyView>,
  tree: InferredTree,
  context: EvalContext
) -> Outcome<RuntimeValue> {
  match runtime_run(
    nodes: [node],
    dependencies: dependencies,
    tree: tree,
    context: context
  ) {
    RuntimeRunComplete { log: log, scheduled: _ } =>
      runtime_run_first_receipt_outcome(log: log)
    RuntimeRunBlocked { evidence: _, log: _, scheduled: _, remaining: _ } =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: eval_diagnostic(reason: ^runtime_run_blocked, node: node)
        )
      }
  }
}

// Bounded sequential run loop. Terminates in at most length(nodes) steps because
// each non-empty frontier schedules at least one remaining node (same bound as
// scheduler_run_to_fixed_point). Receipts capture Accepted or Rejected per node.
fn runtime_run(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  tree: InferredTree,
  context: EvalContext
) -> RuntimeRunResult {
  let state = fold(
    nodes,
    init: RuntimeRunState {
      log: runtime_run_log_empty(),
      scheduled: []
    },
    f: fn(acc, _) {
      runtime_run_step_state(
        nodes: nodes,
        dependencies: dependencies,
        tree: tree,
        context: context,
        state: acc
      )
    }
  )
  runtime_run_result_from_state(nodes: nodes, dependencies: dependencies, state: state)
}
