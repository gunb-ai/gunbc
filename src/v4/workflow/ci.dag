// ── Wave 2 — §11.7.5 temporary shell exception table (Class A safety floor) ──────────────────
// Authority: #4137 §11.7.5 "The temporary CI cut rule (codified)". A shell-owned check may remain
// REQUIRED on every PR only if it (1) protects a named §11.7.1 safety-floor item, (2) has no
// runtime-authoritative `CiUpsertStep` replacement yet, (3) is listed in THIS table, (4) names a
// structural dissolution path. Conditions (2)+(3) are definitional: a row exists here iff the step
// is still shell-owned and not yet emitted FROM its `CiUpsertStep` as ci.yml runtime authority.
// This is the first executable slice of Wave 2 (shell→`CiUpsertStep` migration, §11.7.7 lane 6):
// it models the exception registry the no-new-shell ratchet (§11.7.1 #5) consumes. INTENDED
// contract: the set of REQUIRED shell-owned ci-floor steps equals these rows' `step_id`s.
// ENFORCED today (`v4_workflow_ci_wave1_class_a_shell_exception_table_first_slice`): a bijection
// between the required `.github/ci-floor/*.sh` invocations in ci.yml and these rows, matched at the
// `shell_owner` FIELD (not bare path containment, which a row comment could satisfy fail-open),
// reading ci.yml invocations from a comment-safe, block-form-safe, count-exact live set (a
// commented-out `# bash …` is not counted; keyed on the ci-floor PATH not a `bash ` prefix, so
// `sh`/`./`/`source` spellings are caught too; quoted/punctuated paths are canonicalized and an
// unrecognizable ci-floor spelling trips the gate) — a new unlisted required shell fails CLOSED. RESIDUAL (tracked,
// openai-pro #4284): the gate keys on script path, not the modeled `(job, step)` `CiStepId`, since
// ci.yml's step→`CiStepId` mapping is not yet string-checkable; a *second* step reusing a listed
// script is not yet distinguished by `step_id`. Dissolves when the generated `.dag` CI step model
// lets the ratchet compare live `(job, step, script)` against `step_id + shell_owner` directly.
// Reuses `CiStepId` + `DissolutionTarget` (no parallel exception genus); sibling to
// `ci_always_run_carveouts` (run-policy carveout) — distinct concept (shell retirement vs
// always-run), shared leaf substrate.

// 🟡 coproduct dissolution — feature:wave2-class-a-shell-exception-table — bind #4137 §11.7.1 — dissolve-on-arrival: this closed enumeration mirrors the §11.7.1 bare-minimum floor; it is DELETED when the dynamic affected-set + testgen safety net (§11.7.7 end state) replaces the static floor list and `protects_floor` no longer needs a fixed-arm carrier; forbidden: an open `Symbol`/`String` floor key, or an arm with no §11.7.1 row.
type CiSafetyFloorItem
  = FmtCheck
  | BootstrapMinimalViability
  | OneRustEmitProbe
  | CiDagStructuralReceipt
  | NoNewShellRatchet

// 🟡 coproduct dissolution — feature:wave2-class-a-shell-exception-table — bind #4137 §11.7.5 — dissolve-on-arrival: a row is DELETED when ci.yml emits its `step_id` FROM `replacement_upsert` as runtime authority (T-24), not when the shadow `CiUpsertStep` row merely exists; forbidden: a row without a named `dissolution_target`, or a Class-B/C/D (non-floor) step carried as a shell exception.
type CiShellExceptionRow {
  step_id: CiStepId
  // Repo-relative path of the `.github/ci-floor/*.sh` script owning this Class-A floor step.
  // Canonical `RepoPath` carrier (v4.lens.edit_locus) — NOT a parallel path-as-String authority.
  shell_owner: RepoPath
  protects_floor: CiSafetyFloorItem
  // The existing shadow `CiUpsertStep` AUTHORITY that retires this row once it becomes ci.yml
  // runtime authority. Binds to the canonical `CiUpsertStepSymbol` data (single-authority, P2) —
  // NOT a parallel `Symbol` alias that could drift or name a non-existent upsert.
  replacement_upsert: CiUpsertStepSymbol
  dissolution_target: DissolutionTarget
}

// Dissolution `what` atoms — the runtime-authority emission substrate whose arrival deletes the
// row (does NOT yet exist; standard `ModelMissingSubstrate` naming, like `ci_gate_run_policy_*`).
data ci_bootstrap_step_emitted_from_upsert_runtime_authority: Symbol = ci_bootstrap_step_emitted_from_upsert_runtime_authority
data ci_m1_rust_emit_step_emitted_from_upsert_runtime_authority: Symbol = ci_m1_rust_emit_step_emitted_from_upsert_runtime_authority

data ci_class_a_shell_exceptions: List<CiShellExceptionRow> = [
  CiShellExceptionRow {
    // `.github/ci-floor/v4-bootstrap-viability.sh` is the v2→v4 FULL COMPILE over src/v4 (script
    // header: "v2-compiler full compile over src/v4"; ci.yml step "v2 -> v4 bootstrap compile"),
    // so the live step + its retiring authority are `v2_compile_src_v4` / `ci_upsert_v2_compile_src_v4`
    // (verify `BootstrapStageCompile { produces: v4_stage0_binary }`) — NOT the lighter
    // `v2_bootstrap_smoke_execution`. Bound by what the script DOES, not by name resemblance (P1/P2).
    step_id: JobStep { job: v2_compile_src_v4, step: v2_compile_src_v4 },
    shell_owner: ".github/ci-floor/v4-bootstrap-viability.sh",
    protects_floor: BootstrapMinimalViability,
    replacement_upsert: ci_upsert_v2_compile_src_v4,
    dissolution_target: ModelMissingSubstrate {
      what: ci_bootstrap_step_emitted_from_upsert_runtime_authority
    }
  },
  CiShellExceptionRow {
    step_id: JobStep {
      job: m1_rust_emit_probe_execution,
      step: m1_rust_emit_probe_execution
    },
    shell_owner: ".github/ci-floor/v4-m1-rust-emit-probe.sh",
    protects_floor: OneRustEmitProbe,
    replacement_upsert: ci_upsert_m1_rust_emit_probe_execution,
    dissolution_target: ModelMissingSubstrate {
      what: ci_m1_rust_emit_step_emitted_from_upsert_runtime_authority
    }
  }
]

// Wave 3 §11.7.4 — extend existing receipt (arbiter §8 2026-06-01); no parallel shadow receipt type.
// 🟡 coproduct dissolution — feature:wave3-shadow-selection-receipt — bind Wave 4 active-skip — dissolve-on-arrival: `CiActiveFloorSkipEvidence` is populated from cached TestClaimRun verdict partition; forbidden: bare `Active` tag without skip evidence (illegal floor-skip state).
type CiActiveFloorSkipEvidence {
  cached_verdict_digest: Hash
}

// 🟡 coproduct dissolution — feature:wave3-shadow-selection-receipt — bind docs/planning/v4-ci-selection-receipt-wave3-claim-projection-worksheet-2026-06-01.md §8 + #4137 §11.7.2 — dissolve-on-arrival: `Active { skip_evidence }` drives executable skip from receipt (Wave 4); forbidden: persisting independent `floor_skip` beside `mode` or constructing `Active` without evidence.
type CiSelectionMode
  = Shadow
  | Active { skip_evidence: CiActiveFloorSkipEvidence }

// 🟡 coproduct dissolution — feature:wave3-shadow-selection-receipt — consumer:ci_selection_receipt_shadow_from_git_diff — bind node://adhoc-331899f9-19a live emit — dissolve-on-arrival: `LivePrGitDiff` only on live population entry with populated claim/testgen rows; forbidden: caller-supplied provenance on step-only shadow (empty claim/testgen partition).
type CiSelectionReceiptProvenance
  = FixtureReceipt
  | LivePrGitDiff

// 🟡 coproduct dissolution — feature:wave3-shadow-selection-receipt — bind arbiter §3.2 — dissolve-on-arrival: claim-row `reason` projects per-claim ∩ rerun-frontier facts (not global frontier emptiness alone); forbidden: unbounded `Symbol` on `CiTestClaimSelection.reason`.
type CiClaimSelectionReason
  = FailClosedSuperset
  | AffectedFrontierEmpty
  | AffectedIntersectionNonempty
  | AffectedIntersectionEmpty
  | TestgenSlotMapped
  | ShadowObserveOnly
  | FloorStepCarveout

// 🟡 coproduct dissolution — feature:wave3-shadow-selection-receipt — bind T-21 IRT-4 `test_claim_claim_hash_digest` — dissolve-on-arrival: `claim_projection_hash` is whole-TestClaim authority; forbidden: input-only `Node` projection for receipt hashing.
type CiTestClaimSelection {
  anchor: ClaimAnchorKey
  label: String
  coproduct_variant: TestClaimCoproductVariant
  claim_projection_hash: Hash
  selected: Bool
  reason: CiClaimSelectionReason
}

// 🟡 coproduct dissolution — feature:wave3-shadow-selection-receipt — bind neat-hawk testgen roster population — dissolve-on-arrival: `testgen_slots` populated from eval harness via `Generator<TestgenConcept>` (not flattened Symbol labels); forbidden: empty `testgen_slots` standing in for live testgen selection.
type TestgenSlotSelection {
  generator: Generator<TestgenConcept>
  emits_claim_anchor: ClaimAnchorKey
  selected: Bool
  reason: CiClaimSelectionReason
}

// F.2.6 — shadow CI selection partition (profile-gated; NOT fail-closed on affected-set).
type SelectedTestgenReceipt {
  profile_ref: Symbol
  affected: AffectedSet
  slots: List<TestgenSlotSelection>
}

// 🟡 coproduct dissolution — feature:wave3-shadow-selection-receipt — amend W1.5 `CiSelectionReceipt` — dissolve-on-arrival: receipt partition drives GHA scheduling + TestClaimRun verdict surface (Wave 4); forbidden: parallel shadow receipt genus.
type CiSelectionReceipt {
  pr: ChangeSet
  affected: AffectedSet
  mode: CiSelectionMode
  provenance: CiSelectionReceiptProvenance
  decisions: List<CiStepSelection>
  testclaim_decisions: List<CiTestClaimSelection>
  testgen_slots: List<TestgenSlotSelection>
  component_affected_comparison: CiComponentAffected
}

// 🟡 bounded persistence — feature:f11c-ci-selection-receipt-persistence — bind node://adhoc-87c3a213-099 — dissolve-on-arrival: persisted CI selection receipts are stored by the runtime TestClaimRun/cache receipt substrate, and lookup keys are derived from canonical full receipt projection hashes; interim key below is still derived from modeled receipt partition hashes, never caller-authored names. Forbidden: treating transient fixture construction as persisted receipt evidence or accepting caller-chosen symbols as lookup authority.
type CiSelectionReceiptStoreRow {
  key: Hash
  receipt: CiSelectionReceipt
}

type CiSelectionReceiptLookup
  = CiSelectionReceiptFound { receipt: CiSelectionReceipt }
  | CiSelectionReceiptMissing { key: Hash }

// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature:wave3-shadow-selection-receipt — consumer:ci_floor_held / fixture witnesses — bind docs/planning/v4-ci-selection-receipt-wave3-claim-projection-worksheet-2026-06-01.md §8 — dissolve-on-arrival: `CiSelectionMode` drives floor policy at GHA projection sites (delete Bool projection when Active scheduling lands); forbidden: persisting independent `floor_skip` or untagged mode→Bool helpers beside `mode`.
fn ci_floor_held(receipt: CiSelectionReceipt) -> Bool {
  match receipt.mode {
    Shadow => true
    Active { skip_evidence: _ } => false
  }
}

type CiStepSelection {
  step_id: CiStepId
  inputs_consulted: List<UpsertInputRef>
  affected_intersection: List<AffectedDependency>
  decision: SelectionDecision
  cache_digest: Hash
  reason: Symbol
}

// 🟡 coproduct dissolution — feature:ci-selection-receipt-active-skip — bind v4-ci-schema-worksheet Phase 2.5 — dissolve-on-arrival: `CiSelectionReceipt.decisions` drives GHA `if:` from receipt partition; forbidden: heuristic run-mode enums.
type SelectionDecision
  = Run
  | Skip
  | CarvedOut { carveout_reason: Symbol }

// Receipt field alias — single authority with `v4.std.change` `AffectedDependency`.
type AffectedNode = AffectedDependency

// RULING-1: 🟢 pretty-much-done — GitHub Actions `affected` job outputs (v2/v3/v4/testclaim_corpus/workflow_policy/release_distribution/release_distribution_only).
// Structural replacement for scripts/detect-affected-components.sh (T-21/T-24); host transport:
