// 🟡 coproduct dissolution — LB-P4-3213
type CiCommand
  = LintCommand
  | TestCommand
  | IgnoredTestCommand { test_name: String }
  | LensCiCommand { required_lenses: List<LensIdV0> }
  | BootstrapStageCompile { produces: Symbol }
  | M1RustEmitProbeCommand

type CiJob {
  id: Symbol
  command: CiCommand
  needs: List<Symbol>
}

type CiGate {
  id: Symbol
  job: Symbol
  run_policy: CiGateRunPolicy
}

// 🟡 coproduct dissolution — feature:project-github-actions-run-policy (docs/r3-program-plan.md gates #98/#100) — dissolve-on-arrival: emitted/projected GitHub Actions workflow reads `CiGate.run_policy` directly and this interim live-projection policy carrier is deleted; forbidden: adding GitHub Actions-only gate conditions outside `CiGate.run_policy`.
type CiGateRunPolicy
  = Always
  | RequiresJobAttempt { job: Symbol }

type CiPipeline {
  jobs: List<CiJob>
  gates: List<CiGate>
}

// 🟡 gated — live-workflow projection interim (docs/r3-program-plan.md gates #98 `ci_yml_hand_authority_dissolved` and #100 `project_github_actions_landed`) — bind node://adhoc-35324347-e8a Lens-CI activation — dissolve-on-arrival: emitted/projected GitHub Actions workflow reads `ci_pipeline`/`LensCiCommand` directly and this step-name carrier is deleted; forbidden: adding signal/job/policy facts here instead of projecting them from `ci_pipeline`.
type LensCiLiveWorkflowSignal {
  smoke_step_name: String
  semantic_step_name: String
  semantic_target: String
}

// 🟡 gated — live-workflow projection interim (docs/r3-program-plan.md gates #98/#100; docs/modeling-discipline.md Practice 10) — feature:project-github-actions-landed — consumer:v4.workflow.ci m1_ci_live_workflow_signal — bind src/v4/TASKS.md T-24 — dissolve-on-arrival: emitted/projected GitHub Actions workflow reads `ci_pipeline`/`M1RustEmitProbeCommand` directly and `m1_ci_live_workflow_signal` is deleted; forbidden: adding M1 probe step facts outside `ci_pipeline` + this binding.
type M1CiLiveWorkflowSignal {
  binding_smoke_step_name: String
  step_name: String
  script_path: String
  non_blocking: Bool
  timeout_minutes: Int
}


data v2_compile_src_v4: Symbol = v2_compile_src_v4
data lens_ci_registry_execution: Symbol = lens_ci_registry_execution
data m1_rust_emit_probe_execution: Symbol = m1_rust_emit_probe_execution
data structural_v2_compile: Symbol = structural_v2_compile
data lens_ci_registry_signal: Symbol = lens_ci_registry_signal
data m1_rust_emit_probe_signal: Symbol = m1_rust_emit_probe_signal

data lens_ci_required_lenses: List<LensIdV0> = [
  Complexity,
  Cost,
  Parallelism,
  EffectEnumeration,
  Idempotency,
  UnusedParameters
]

data lens_ci_live_workflow_signal: LensCiLiveWorkflowSignal = {
  smoke_step_name: "Lens-CI registry activation smoke"
  semantic_step_name: "Lens-CI registry semantic v4 compile (rust target)"
  semantic_target: "rust"
}

data m1_ci_live_workflow_signal: M1CiLiveWorkflowSignal = {
  binding_smoke_step_name: "M1 v4 workflow CI model/YAML binding smoke"
  step_name: "M1 v4 full-tree rust emit probe (v2 emit + cargo check)"
  script_path: "scripts/v4-m1-rust-emit-probe.sh"
  non_blocking: true
  timeout_minutes: 20
}

data ci_pipeline: Outcome<CiPipeline> = ci_pipeline_well_formed(p: CiPipeline {
  jobs: [
    CiJob {
      id: v2_compile_src_v4,
      command: BootstrapStageCompile { produces: v4_stage0_binary },
      needs: []
    },
    CiJob {
      id: lens_ci_registry_execution,
      command: LensCiCommand { required_lenses: lens_ci_required_lenses },
      needs: [v2_compile_src_v4]
    },
    CiJob {
      id: m1_rust_emit_probe_execution,
      command: M1RustEmitProbeCommand,
      needs: [v2_compile_src_v4]
    }
  ],
  gates: [
    CiGate {
      id: structural_v2_compile,
      job: v2_compile_src_v4,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    },
    CiGate {
      id: lens_ci_registry_signal,
      job: lens_ci_registry_execution,
      run_policy: Always
    },
    CiGate {
      id: m1_rust_emit_probe_signal,
      job: m1_rust_emit_probe_execution,
      run_policy: Always
    }
  ]
})


data ci_duplicate_job_id: Symbol = ci_duplicate_job_id
data ci_duplicate_gate_id: Symbol = ci_duplicate_gate_id
data ci_dangling_reference: Symbol = ci_dangling_reference
data ci_dependency_cycle: Symbol = ci_dependency_cycle
data ci_bootstrap_authority_violation: Symbol = ci_bootstrap_authority_violation
data ci_workflow_file: Symbol = ci_workflow_file

fn ci_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: Textual { file: ci_workflow_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn ci_job_ids(jobs: List<CiJob>) -> List<Symbol> {
  fold(jobs, init: [], f: fn(acc, j) {
    concat([j.id], acc)
  })
}

fn ci_gate_ids(gates: List<CiGate>) -> List<Symbol> {
  fold(gates, init: [], f: fn(acc, g) {
    concat([g.id], acc)
  })
}

fn ci_gate_job_ids(gates: List<CiGate>) -> List<Symbol> {
  fold(gates, init: [], f: fn(acc, g) {
    concat([g.job], acc)
  })
}

fn ci_gate_run_policy_job_ids(gates: List<CiGate>) -> List<Symbol> {
  fold(gates, init: [], f: fn(acc, g) {
    match g.run_policy {
      Always => acc
      RequiresJobAttempt { job } => concat([job], acc)
    }
  })
}

fn ci_member(s: Symbol, ids: List<Symbol>) -> Bool {
  count_equal(xs: ids, item: s, eq: fn(left, right) { left == right }) != 0
}

fn ci_symbol_resolves(s: Symbol, jobs: List<CiJob>) -> Bool {
  ci_member(s: s, ids: ci_job_ids(jobs: jobs))
}

fn ci_all_job_ids_unique(jobs: List<CiJob>) -> Bool {
  unique(xs: ci_job_ids(jobs: jobs), eq: fn(left, right) { left == right })
}

fn ci_all_gate_ids_unique(gates: List<CiGate>) -> Bool {
  unique(xs: ci_gate_ids(gates: gates), eq: fn(left, right) { left == right })
}

fn ci_all_needs_resolve(jobs: List<CiJob>) -> Bool {
  fold(jobs, init: true, f: fn(acc, j) {
    acc && for_all(xs: j.needs, predicate: fn(n) {
      ci_symbol_resolves(s: n, jobs: jobs)
    })
  })
}

fn ci_all_gate_jobs_resolve(gates: List<CiGate>, jobs: List<CiJob>) -> Bool {
  for_all(xs: ci_gate_job_ids(gates: gates), predicate: fn(job_sym) {
    ci_symbol_resolves(s: job_sym, jobs: jobs)
  })
}

fn ci_all_gate_run_policies_resolve(gates: List<CiGate>, jobs: List<CiJob>) -> Bool {
  for_all(xs: ci_gate_run_policy_job_ids(gates: gates), predicate: fn(job_sym) {
    ci_symbol_resolves(s: job_sym, jobs: jobs)
  })
}

fn ci_job_needs(id: Symbol, jobs: List<CiJob>) -> List<Symbol> {
  fold(jobs, init: [], f: fn(acc, j) {
    if j.id == id { j.needs } else { acc }
  })
}

fn ci_blocked(id: Symbol, remaining: List<Symbol>, jobs: List<CiJob>) -> Bool {
  count_where(xs: ci_job_needs(id: id, jobs: jobs), predicate: fn(n) {
    ci_member(s: n, ids: remaining)
  }) != 0
}

fn ci_eliminate_pass(remaining: List<Symbol>, jobs: List<CiJob>) -> List<Symbol> {
  fold(remaining, init: [], f: fn(acc, id) {
    if ci_blocked(id: id, remaining: remaining, jobs: jobs) {
      concat([id], acc)
    } else {
      acc
    }
  })
}

fn ci_kahn_fixpoint(jobs: List<CiJob>) -> List<Symbol> {
  fold(jobs, init: map(jobs, fn(j) { j.id }), f: fn(remaining, job) {
    ci_eliminate_pass(remaining: remaining, jobs: jobs)
  })
}

fn ci_acyclic(jobs: List<CiJob>) -> Bool {
  length(xs: ci_kahn_fixpoint(jobs: jobs)) == 0
}

// 🟡 negative-coverage plan-bound (T-22) — LB-T22-3213
fn ci_command_authority_ok(c: CiCommand) -> Bool {
  match c {
    LintCommand => true
    TestCommand => true
    IgnoredTestCommand { test_name: _ } => true
    LensCiCommand { required_lenses } => lens_registry_ids_resolve(lens_ids: required_lenses)
    BootstrapStageCompile { produces: pr } => bootstrap_stage_output(plan: bootstrap_plan, s: pr)
    M1RustEmitProbeCommand => true
  }
}

fn ci_all_commands_authority_ok(jobs: List<CiJob>) -> Bool {
  fold(jobs, init: true, f: fn(acc, j) {
    acc && ci_command_authority_ok(c: j.command)
  })
}

data ci_cache_cmd_lint_tag: Symbol = ci_cache_cmd_lint_tag
data ci_cache_cmd_test_tag: Symbol = ci_cache_cmd_test_tag
data ci_cache_cmd_ignored_test_tag: Symbol = ci_cache_cmd_ignored_test_tag
data ci_cache_cmd_lens_ci_tag: Symbol = ci_cache_cmd_lens_ci_tag
data ci_cache_cmd_bootstrap_compile_tag: Symbol = ci_cache_cmd_bootstrap_compile_tag
data ci_cache_cmd_m1_probe_tag: Symbol = ci_cache_cmd_m1_probe_tag
data ci_cache_gate_policy_always_tag: Symbol = ci_cache_gate_policy_always_tag
data ci_cache_gate_policy_requires_job_tag: Symbol = ci_cache_gate_policy_requires_job_tag
data ci_cache_jobs_empty_tag: Symbol = ci_cache_jobs_empty_tag
data ci_cache_gates_empty_tag: Symbol = ci_cache_gates_empty_tag
data ci_cache_lens_complexity_tag: Symbol = ci_cache_lens_complexity_tag
data ci_cache_lens_cost_tag: Symbol = ci_cache_lens_cost_tag
data ci_cache_lens_parallelism_tag: Symbol = ci_cache_lens_parallelism_tag
data ci_cache_lens_effect_enum_tag: Symbol = ci_cache_lens_effect_enum_tag
data ci_cache_lens_idempotency_tag: Symbol = ci_cache_lens_idempotency_tag
data ci_cache_lens_provenance_tag: Symbol = ci_cache_lens_provenance_tag
data ci_cache_lens_unused_params_tag: Symbol = ci_cache_lens_unused_params_tag
data ci_cache_lens_structural_resolution_tag: Symbol = ci_cache_lens_structural_resolution_tag
data ci_cache_lens_table_decision_tree_tag: Symbol = ci_cache_lens_table_decision_tree_tag
data ci_cache_string_empty_tag: Symbol = ci_cache_string_empty_tag


fn ci_symbol_digest(sym: Symbol) -> Hash {
  content_hash(
    n: Node {
      kind: TypeNode { connective: Atom { identity: sym } },
      children: []
    }
  )
}


fn ci_gate_run_policy_cache_digest(policy: CiGateRunPolicy) -> Hash {
  match policy {
    Always => ci_symbol_digest(sym: ci_cache_gate_policy_always_tag)
    RequiresJobAttempt { job: job } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_cache_gate_policy_requires_job_tag),
        b: ci_symbol_digest(sym: job)
      )
  }
}


fn ci_char_cache_digest(c: Char) -> Hash {
  scalar_char_hash(c: c)
}


fn ci_string_cache_digest(s: String) -> Hash {
  fold_list(
    xs: s,
    empty: ci_symbol_digest(sym: ci_cache_string_empty_tag),
    cons: fn(acc, ch) {
      combine_hash(a: acc, b: ci_char_cache_digest(c: ch))
    }
  )
}


fn ci_lens_id_cache_digest(lens: LensIdV0) -> Hash {
  match lens {
    Complexity => ci_symbol_digest(sym: ci_cache_lens_complexity_tag)
    Cost => ci_symbol_digest(sym: ci_cache_lens_cost_tag)
    Parallelism => ci_symbol_digest(sym: ci_cache_lens_parallelism_tag)
    EffectEnumeration => ci_symbol_digest(sym: ci_cache_lens_effect_enum_tag)
    Idempotency => ci_symbol_digest(sym: ci_cache_lens_idempotency_tag)
    Provenance => ci_symbol_digest(sym: ci_cache_lens_provenance_tag)
    UnusedParameters => ci_symbol_digest(sym: ci_cache_lens_unused_params_tag)
    StructuralResolution => ci_symbol_digest(sym: ci_cache_lens_structural_resolution_tag)
    TableDecisionTree => ci_symbol_digest(sym: ci_cache_lens_table_decision_tree_tag)
  }
}


fn ci_command_cache_digest(c: CiCommand) -> Hash {
  match c {
    LintCommand => ci_symbol_digest(sym: ci_cache_cmd_lint_tag)
    TestCommand => ci_symbol_digest(sym: ci_cache_cmd_test_tag)
    IgnoredTestCommand { test_name: name } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_cache_cmd_ignored_test_tag),
        b: ci_string_cache_digest(s: name)
      )
    LensCiCommand { required_lenses: lenses } =>
      fold_list(
        xs: lenses,
        empty: ci_symbol_digest(sym: ci_cache_cmd_lens_ci_tag),
        cons: fn(acc, lens) {
          combine_hash(a: acc, b: ci_lens_id_cache_digest(lens: lens))
        }
      )
    BootstrapStageCompile { produces: produces } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_cache_cmd_bootstrap_compile_tag),
        b: ci_symbol_digest(sym: produces)
      )
    M1RustEmitProbeCommand => ci_symbol_digest(sym: ci_cache_cmd_m1_probe_tag)
  }
}


fn ci_job_cache_digest(j: CiJob) -> Hash {
  combine_hash(
    a: combine_hash(
      a: ci_symbol_digest(sym: j.id),
      b: ci_command_cache_digest(c: j.command)
    ),
    b: fold_list(
      xs: j.needs,
      empty: ci_symbol_digest(sym: ci_cache_jobs_empty_tag),
      cons: fn(acc, need) {
        combine_hash(a: acc, b: ci_symbol_digest(sym: need))
      }
    )
  )
}


fn ci_gate_cache_digest(g: CiGate) -> Hash {
  combine_hash(
    a: combine_hash(
      a: ci_symbol_digest(sym: g.id),
      b: ci_symbol_digest(sym: g.job)
    ),
    b: ci_gate_run_policy_cache_digest(policy: g.run_policy)
  )
}


// 🟡 gated — feature:T22-EVAL-CACHE-HASHES — bind IRT-4 / TASKS.md T-22 — dissolve-on: content_hash(Node projection of CiPipeline) replaces this hand-rolled coproduct digest fold; interim TestClaim pinned-evaluator cache authority only.
fn ci_pipeline_cache_digest(p: CiPipeline) -> Hash {
  combine_hash(
    a: fold_list(
      xs: p.jobs,
      empty: ci_symbol_digest(sym: ci_cache_jobs_empty_tag),
      cons: fn(acc, job) {
        combine_hash(a: acc, b: ci_job_cache_digest(j: job))
      }
    ),
    b: fold_list(
      xs: p.gates,
      empty: ci_symbol_digest(sym: ci_cache_gates_empty_tag),
      cons: fn(acc, gate) {
        combine_hash(a: acc, b: ci_gate_cache_digest(g: gate))
      }
    )
  )
}


fn ci_pipeline_well_formed(p: CiPipeline) -> Outcome<CiPipeline> {
  if ci_all_job_ids_unique(jobs: p.jobs) {
    if ci_all_gate_ids_unique(gates: p.gates) {
      if ci_all_needs_resolve(jobs: p.jobs) {
        if ci_all_gate_jobs_resolve(gates: p.gates, jobs: p.jobs) {
          if ci_all_gate_run_policies_resolve(gates: p.gates, jobs: p.jobs) {
            if ci_acyclic(jobs: p.jobs) {
              if ci_all_commands_authority_ok(jobs: p.jobs) {
                Accepted { value: p, diagnostics: None }
              } else {
                Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_bootstrap_authority_violation)) }
              }
            } else {
              Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dependency_cycle)) }
            }
          } else {
            Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
          }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
      }
    } else {
      Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_gate_id)) }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_job_id)) }
  }
}


fn test_claim_in_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}


fn ci_select_from_rerun_nodes(roster: List<TestClaim>, rerun: RerunNodeSet) -> List<TestClaim> {
  match rerun {
    RerunNodeSetProduced { nodes: nodes } =>
      filter(
        xs: roster,
        predicate: fn(claim) {
          test_claim_ci_selection_fail_closed(c: claim)
            || test_claim_in_rerun_frontier(claim: claim, frontier: nodes)
        }
      )
    RerunNodeSetFailClosed { evidence: _ } => roster
  }
}


fn ci_select_from_affected_set(roster: List<TestClaim>, affected: AffectedSet) -> List<TestClaim> {
  ci_select_from_rerun_nodes(
    roster: roster,
    rerun: affected_set_rerun_nodes(affected_set_value: affected)
  )
}
