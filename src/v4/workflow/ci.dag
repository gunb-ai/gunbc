data ci_projection_command_selection_fn_edge: Symbol = ci_projection_command_selection_fn_edge
data ci_projection_gate_policy_job_edge: Symbol = ci_projection_gate_policy_job_edge


fn ci_atom(sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sym } },
    children: []
  }
}


fn ci_named_edge(name: Symbol, target: Node) -> Edge {
  Edge {
    label: Named { name: name },
    target: target
  }
}


fn ci_symbol_digest(sym: Symbol) -> Hash {
  content_hash(n: ci_atom(sym: sym))
}


fn ci_symbol_list_projection_node(xs: List<Symbol>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: xs,
      empty: Empty,
      cons: fn(acc, sym) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: Positional, target: ci_atom(sym: sym) }
        )
      }
    )
  }
}


fn ci_compile_stage_projection_node(stage: CompileStage, produces_hash_node: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ci_named_edge(name: ci_projection_compile_stage_produces_edge, target: ci_atom(sym: stage.produces)),
      ci_named_edge(name: ci_projection_compile_stage_compiled_by_edge, target: ci_atom(sym: stage.compiled_by)),
      ci_named_edge(
        name: ci_projection_compile_stage_produces_hash_edge,
        target: produces_hash_node
      ),
      ci_named_edge(
        name: ci_projection_compile_stage_consumes_edge,
        target: ci_symbol_list_projection_node(xs: stage.consumes)
      )
    ]
  }
}


fn ci_compile_stage_projection_outcome(stage: CompileStage) -> Outcome<Node> {
  match bootstrap_hash_pin_projection_node(pin: stage.produces_hash) {
    Accepted { value: produces_hash_node, diagnostics: _ } =>
      Accepted {
        value: ci_compile_stage_projection_node(stage: stage, produces_hash_node: produces_hash_node),
        diagnostics: None
      }
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}


fn ci_fixpt_stage_projection_node(
  fixpt: FixptStage1Stage2,
  left_hash_node: Node,
  right_hash_node: Node,
  pinned_hash_node: Node
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ci_named_edge(name: ci_projection_fixpt_left_edge, target: ci_atom(sym: fixpt.left)),
      ci_named_edge(name: ci_projection_fixpt_right_edge, target: ci_atom(sym: fixpt.right)),
      ci_named_edge(
        name: ci_projection_fixpt_left_hash_edge,
        target: left_hash_node
      ),
      ci_named_edge(
        name: ci_projection_fixpt_right_hash_edge,
        target: right_hash_node
      ),
      ci_named_edge(
        name: ci_projection_fixpt_pinned_hash_edge,
        target: pinned_hash_node
      )
    ]
  }
}


fn ci_fixpt_stage_projection_outcome(fixpt: FixptStage1Stage2) -> Outcome<Node> {
  match bootstrap_hash_pin_projection_node(pin: fixpt.left_hash) {
    Accepted { value: left_hash_node, diagnostics: _ } =>
      match bootstrap_hash_pin_projection_node(pin: fixpt.right_hash) {
        Accepted { value: right_hash_node, diagnostics: _ } =>
          match bootstrap_hash_pin_projection_node(pin: fixpt.pinned_hash) {
            Accepted { value: pinned_hash_node, diagnostics: _ } =>
              Accepted {
                value: ci_fixpt_stage_projection_node(
                  fixpt: fixpt,
                  left_hash_node: left_hash_node,
                  right_hash_node: right_hash_node,
                  pinned_hash_node: pinned_hash_node
                ),
                diagnostics: None
              }
            Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
          }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}


fn ci_bootstrap_plan_accepted_projection_outcome(plan: BootstrapPlan) -> Outcome<Node> {
  match ci_compile_stage_projection_outcome(stage: plan.seed) {
    Accepted { value: seed_node, diagnostics: _ } =>
      match ci_compile_stage_projection_outcome(stage: plan.self0) {
        Accepted { value: self0_node, diagnostics: _ } =>
          match ci_compile_stage_projection_outcome(stage: plan.self1) {
            Accepted { value: self1_node, diagnostics: _ } =>
              match ci_fixpt_stage_projection_outcome(fixpt: plan.fixpt) {
                Accepted { value: fixpt_node, diagnostics: _ } =>
                  Accepted {
                    value: Node {
                      kind: TypeNode { connective: Conj },
                      children: [
                        ci_named_edge(name: ci_projection_bootstrap_plan_seed_edge, target: seed_node),
                        ci_named_edge(name: ci_projection_bootstrap_plan_self0_edge, target: self0_node),
                        ci_named_edge(name: ci_projection_bootstrap_plan_self1_edge, target: self1_node),
                        ci_named_edge(name: ci_projection_bootstrap_plan_fixpt_edge, target: fixpt_node)
                      ]
                    },
                    diagnostics: None
                  }
                Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
              }
            Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
          }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}


fn ci_bootstrap_plan_hash_pins_rejected_projection_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ci_named_edge(
        name: ci_projection_bootstrap_plan_outcome_edge,
        target: ci_atom(sym: ci_cache_bootstrap_plan_hash_pins_rejected_tag)
      )
    ]
  }
}


fn ci_bootstrap_plan_projection_node() -> Node {
  match bootstrap_plan {
    Accepted { value: plan, diagnostics: _ } =>
      match ci_bootstrap_plan_accepted_projection_outcome(plan: plan) {
        Accepted { value: node, diagnostics: _ } => node
        Rejected { diagnostics: _ } => ci_bootstrap_plan_hash_pins_rejected_projection_node()
      }
    Rejected { diagnostics: _ } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(
            name: ci_projection_bootstrap_plan_outcome_edge,
            target: ci_atom(sym: ci_cache_bootstrap_plan_rejected_tag)
          )
        ]
      }
  }
}


fn ci_lens_id_projection_node(lens: LensIdV0) -> Node {
  match lens {
    Complexity => ci_atom(sym: ci_cache_lens_complexity_tag)
    Cost => ci_atom(sym: ci_cache_lens_cost_tag)
    Parallelism => ci_atom(sym: ci_cache_lens_parallelism_tag)
    EffectEnumeration => ci_atom(sym: ci_cache_lens_effect_enum_tag)
    Idempotency => ci_atom(sym: ci_cache_lens_idempotency_tag)
    Provenance => ci_atom(sym: ci_cache_lens_provenance_tag)
    UnusedParameters => ci_atom(sym: ci_cache_lens_unused_params_tag)
    StructuralResolution => ci_atom(sym: ci_cache_lens_structural_resolution_tag)
    TableDecisionTree => ci_atom(sym: ci_cache_lens_table_decision_tree_tag)
  }
}


fn ci_gate_run_policy_projection_node(policy: CiGateRunPolicy) -> Node {
  match policy {
    Always => ci_atom(sym: ci_cache_gate_policy_always_tag)
    RequiresJobAttempt { job: job } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(name: ci_projection_gate_policy_job_edge, target: ci_atom(sym: job))
        ]
      }
  }
}


// 🟡 derived-operation — feature:T22-EVAL-CACHE-HASHES — dissolve-on: std/node canonical `byte_offset_cache_key` Node projection replaces this tree. Live consumer: `content_hash(ci_pipeline_evaluator_input_node)` (not `ci_char_cache_digest`).
fn ci_byte_limb_projection_node(limb: Int) -> Node {
  if limb == 0 {
    ci_atom(sym: canonical_tag_scalar_int_zero)
  } else if limb == 1 {
    ci_atom(sym: canonical_tag_scalar_int_one)
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [
        ci_named_edge(name: ci_projection_char_succ_edge, target: ci_atom(sym: canonical_tag_scalar_int_succ)),
        ci_named_edge(name: ci_projection_char_pred_edge, target: ci_byte_limb_projection_node(limb: limb - 1))
      ]
    }
  }
}


fn ci_int_offset_authority_projection_node(i: Int) -> Node {
  if i < 0 {
    Node {
      kind: TypeNode { connective: Conj },
      children: [
        ci_named_edge(name: ci_projection_char_offset_neg_edge, target: ci_atom(sym: canonical_tag_scalar_int_neg)),
        ci_named_edge(
          name: ci_projection_char_offset_authority_edge,
          target: ci_int_offset_authority_projection_node(i: int_negate(i: i))
        )
      ]
    }
  } else if i == 0 {
    ci_atom(sym: canonical_tag_scalar_int_zero)
  } else if i <= 255 {
    ci_byte_limb_projection_node(limb: i)
  } else {
    Node {
      kind: TypeNode { connective: Conj },
      children: [
        ci_named_edge(
          name: ci_projection_char_offset_quotient_edge,
          target: ci_atom(sym: canonical_tag_byte_offset_out_of_ceiling)
        ),
        ci_named_edge(
          name: ci_projection_char_offset_authority_edge,
          target: ci_int_offset_authority_projection_node(i: i / 256)
        ),
        ci_named_edge(
          name: ci_projection_char_offset_byte_edge,
          target: ci_byte_limb_projection_node(limb: i - (i / 256) * 256)
        )
      ]
    }
  }
}


fn ci_char_projection_node(c: Char) -> Node {
  if c < 0 || c > 255 {
    Node {
      kind: TypeNode { connective: Conj },
      children: [
        ci_named_edge(
          name: ci_projection_char_out_of_byte_limb_edge,
          target: ci_atom(sym: canonical_tag_byte_limb_out_of_range)
        ),
        ci_named_edge(
          name: ci_projection_char_offset_authority_edge,
          target: ci_int_offset_authority_projection_node(i: c)
        )
      ]
    }
  } else {
    ci_byte_limb_projection_node(limb: c)
  }
}


fn ci_string_projection_node(s: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: s,
      empty: Empty,
      cons: fn(acc, ch) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: Positional, target: ci_char_projection_node(c: ch) }
        )
      }
    )
  }
}


fn ci_command_projection_node(c: CiCommand) -> Node {
  match c {
    LintCommand => ci_atom(sym: ci_cache_cmd_lint_tag)
    TestCommand => ci_atom(sym: ci_cache_cmd_test_tag)
    IgnoredTestCommand { test_name: name } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(name: ci_projection_command_variant_edge, target: ci_atom(sym: ci_cache_cmd_ignored_test_tag)),
          ci_named_edge(name: ci_projection_command_test_name_edge, target: ci_string_projection_node(s: name))
        ]
      }
    LensCiCommand { required_lenses: lenses } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(
            name: ci_projection_command_lenses_edge,
            target: ci_lens_list_projection_node(lenses: lenses)
          )
        ]
      }
    BootstrapStageCompile { produces: produces } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(name: ci_projection_command_produces_edge, target: ci_atom(sym: produces)),
          ci_named_edge(
            name: ci_projection_bootstrap_plan_outcome_edge,
            target: ci_bootstrap_plan_projection_node()
          )
        ]
      }
    M1RustEmitProbeCommand => ci_atom(sym: ci_cache_cmd_m1_probe_tag)
    TestClaimCorpusEvalCommand { selection_fn: fn_name } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(name: ci_projection_command_selection_fn_edge, target: ci_atom(sym: fn_name))
        ]
      }
    Phase1NatSemiringRungGateCommand => ci_atom(sym: ci_cache_cmd_phase1_nat_semiring_rung_gate_tag)
  }
}


fn ci_lens_list_projection_node(lenses: List<LensIdV0>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: lenses,
      empty: Empty,
      cons: fn(acc, lens) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: Positional, target: ci_lens_id_projection_node(lens: lens) }
        )
      }
    )
  }
}


fn ci_job_projection_node(j: CiJob) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ci_named_edge(name: ci_projection_job_id_edge, target: ci_atom(sym: j.id)),
      ci_named_edge(name: ci_projection_job_command_edge, target: ci_command_projection_node(c: j.command)),
      ci_named_edge(name: ci_projection_job_needs_edge, target: ci_symbol_list_projection_node(xs: j.needs))
    ]
  }
}


fn ci_job_list_projection_node(jobs: List<CiJob>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: jobs,
      empty: Empty,
      cons: fn(acc, job) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: Positional, target: ci_job_projection_node(j: job) }
        )
      }
    )
  }
}


fn ci_gate_projection_node(g: CiGate) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ci_named_edge(name: ci_projection_gate_id_edge, target: ci_atom(sym: g.id)),
      ci_named_edge(name: ci_projection_gate_job_edge, target: ci_atom(sym: g.job)),
      ci_named_edge(
        name: ci_projection_gate_run_policy_edge,
        target: ci_gate_run_policy_projection_node(policy: g.run_policy)
      )
    ]
  }
}


fn ci_gate_list_projection_node(gates: List<CiGate>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: gates,
      empty: Empty,
      cons: fn(acc, gate) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: Positional, target: ci_gate_projection_node(g: gate) }
        )
      }
    )
  }
}


fn ci_pipeline_projection_node(p: CiPipeline) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ci_named_edge(name: ci_projection_pipeline_jobs_edge, target: ci_job_list_projection_node(jobs: p.jobs)),
      ci_named_edge(name: ci_projection_pipeline_gates_edge, target: ci_gate_list_projection_node(gates: p.gates))
    ]
  }
}


fn ci_pipeline_evaluator_input_node(pipeline: CiPipeline, evaluator_pin: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ci_named_edge(name: ci_projection_evaluator_pin_edge, target: ci_atom(sym: evaluator_pin)),
      ci_named_edge(
        name: ci_projection_evaluator_pipeline_edge,
        target: ci_pipeline_projection_node(p: pipeline)
      )
    ]
  }
}


fn ci_gate_run_policy_cache_digest(policy: CiGateRunPolicy) -> Hash {
  content_hash(n: ci_gate_run_policy_projection_node(policy: policy))
}


// v4.std.text Char = Nat (scalar); use O(log |c|) base-256 digest, not Peano scalar_int_hash.
fn ci_char_cache_digest(c: Char) -> Hash {
  match byte_offset_cache_key(i: c) {
    ByteOffsetCacheEligible { digest: digest } => digest
    ByteOffsetCacheIneligible {
      boundary_tag: boundary_tag,
      witness: witness
    } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_cache_char_byte_offset_ineligible_tag),
        b: combine_hash(
          a: ci_symbol_digest(sym: boundary_tag),
          b: witness
        )
      )
  }
}


fn ci_string_cache_digest(s: String) -> Hash {
  fold_list(
    xs: s,
    empty: ci_symbol_digest(sym: ci_cache_string_empty_tag),
    cons: fn(acc, ch) {
      combine_hash(a: acc, b: ci_char_cache_digest(c: ch))
    }
  )
}


fn ci_lens_id_cache_digest(lens: LensIdV0) -> Hash {
  content_hash(n: ci_lens_id_projection_node(lens: lens))
}


// IRT-4: bootstrap_plan is the authority ci_command_authority_ok uses for BootstrapStageCompile.
// 🟢 derived-operation — feature:T22-EVAL-PASS-RECEIPT — plan-bound: hashes only Accepted plan projections (no pin-level fabricated Node).
fn ci_bootstrap_plan_cache_hash() -> Outcome<Hash> {
  match bootstrap_plan {
    Accepted { value: plan, diagnostics: _ } =>
      match ci_bootstrap_plan_accepted_projection_outcome(plan: plan) {
        Accepted { value: node, diagnostics: _ } =>
          Accepted { value: content_hash(n: node), diagnostics: None }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
  }
}


fn ci_command_cache_digest(c: CiCommand) -> Hash {
  content_hash(n: ci_command_projection_node(c: c))
}


fn ci_job_cache_digest(j: CiJob) -> Hash {
  content_hash(n: ci_job_projection_node(j: j))
}


fn ci_gate_cache_digest(g: CiGate) -> Hash {
  content_hash(n: ci_gate_projection_node(g: g))
}


fn ci_pipeline_cache_digest(p: CiPipeline) -> Hash {
  content_hash(n: ci_pipeline_projection_node(p: p))
}


fn test_claim_typed_input_ci_pipeline(
  evaluator_input: CiPipeline,
  evaluator_pin: Symbol
) -> TestClaimTypedInput<CiPipeline> {
  TestClaimTypedInput {
    evaluator_input: evaluator_input,
    evaluator_pin: evaluator_pin
  }
}


fn ci_test_claim_evaluator_digest(input: TestClaimTypedInput<CiPipeline>) -> Hash {
  content_hash(
    n: ci_pipeline_evaluator_input_node(
      pipeline: input.evaluator_input,
      evaluator_pin: input.evaluator_pin
    )
  )
}


// 🟢 derived-operation — feature:T22-EVAL-PASS-RECEIPT — LB-T22-3213 negative-coverage plan-bound receipt.
type WorkflowPipelinePlanBoundPassReceipt {
  run: TestClaimRun<CiPipeline, CiPipeline>
  plan_hash: Hash
}


// Reads original `run.verdict` (not `workflow_pipeline_pass_gate` output): pass_gate rewraps `Fail.actual` as `Accepted { value: run }`.
fn workflow_pipeline_receipt_failure_diagnostics(
  run: TestClaimRun<CiPipeline, CiPipeline>
) -> List<Diagnostic> {
  match run.verdict {
    Fail { actual: Rejected { diagnostics: ds } } => ds
    // Unreachable from `workflow_pipeline_plan_bound_pass_receipt` Fail arm today; honest tag if call sites change.
    _ =>
      diagnostics_singleton(d: ci_diagnostic(reason: ci_workflow_receipt_unexpected_verdict))
  }
}


// Pass arm is intentionally lossy (`aggregate_verdicts` Pass carries no payload); `workflow_pipeline_plan_bound_pass_receipt` closes over the original `run` on Pass.
fn workflow_pipeline_pass_gate(
  run: TestClaimRun<CiPipeline, CiPipeline>,
  at: Node
) -> Verdict<TestClaimRun<CiPipeline, CiPipeline>> {
  aggregate_verdicts(
    rs: [
      match run.verdict {
        Pass => Pass
        Fail { actual: _ } => Fail { actual: Accepted { value: run, diagnostics: None } }
        Deferred { actual: _, diagnostic: d } =>
          Deferred { actual: Accepted { value: run, diagnostics: None }, diagnostic: d }
      }
    ],
    at: at
  )
}


fn workflow_pipeline_plan_bound_pass_receipt(
  run: TestClaimRun<CiPipeline, CiPipeline>,
  at: Node
) -> Outcome<WorkflowPipelinePlanBoundPassReceipt> {
  match workflow_pipeline_pass_gate(run: run, at: at) {
    Pass =>
      match ci_bootstrap_plan_cache_hash() {
        Accepted { value: plan_hash, diagnostics: _ } =>
          Accepted {
            value: WorkflowPipelinePlanBoundPassReceipt {
              run: run,
              plan_hash: plan_hash
            },
            diagnostics: None
          }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    Fail { actual: _ } =>
      Rejected { diagnostics: workflow_pipeline_receipt_failure_diagnostics(run: run) }
    Deferred { actual: _, diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


fn ci_test_claim_cache_interpretation_hash(subject: TestClaimEvalSubject<CiPipeline>) -> Hash {
  combine_hash(
    a: inferred_tree_digest(tree: subject.tree),
    b: combine_hash(
      a: test_claim_interpretation_cache_digest(context: subject.context),
      b: ci_test_claim_evaluator_digest(input: subject.input)
    )
  )
}


fn test_claim_cache_key_interpretation_hash_ci_pipeline(key: TestClaimCacheKey<CiPipeline>) -> Hash {
  ci_test_claim_cache_interpretation_hash(subject: key.eval_subject)
}


fn test_claim_cache_receipt_pinned(subject: TestClaimEvalSubject<CiPipeline>) -> TestClaimCacheReceipt<CiPipeline> {
  TestClaimCacheReceipt {
    key: TestClaimCacheKey {
      eval_subject: subject
    }
  }
}


fn ci_pipeline_well_formed(p: CiPipeline) -> Outcome<CiPipeline> {
  if ci_all_job_ids_unique(jobs: p.jobs) {
    if ci_all_gate_ids_unique(gates: p.gates) {
      if ci_all_needs_resolve(jobs: p.jobs) {
        if ci_all_gate_jobs_resolve(gates: p.gates, jobs: p.jobs) {
          if ci_all_gate_run_policies_resolve(gates: p.gates, jobs: p.jobs) {
            if ci_acyclic(jobs: p.jobs) {
              if ci_all_commands_authority_ok(jobs: p.jobs) {
                Accepted { value: p, diagnostics: None }
              } else {
                Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_bootstrap_authority_violation)) }
              }
            } else {
              Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dependency_cycle)) }
            }
          } else {
            Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
          }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
      }
    } else {
      Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_gate_id)) }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_job_id)) }
  }
}


fn test_claim_in_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}


fn ci_select_from_rerun_nodes(roster: List<TestClaim>, rerun: RerunNodeSet) -> List<TestClaim> {
  match rerun {
    RerunNodeSetProduced { nodes: nodes } =>
      filter(
        xs: roster,
        predicate: fn(claim) {
          test_claim_ci_selection_fail_closed(c: claim)
            || test_claim_in_rerun_frontier(claim: claim, frontier: nodes)
        }
      )
    RerunNodeSetFailClosed { evidence: _ } => roster
  }
}


fn ci_select_from_affected_set(roster: List<TestClaim>, affected: AffectedSet) -> List<TestClaim> {
  ci_select_from_rerun_nodes(
    roster: roster,
    rerun: affected_set_rerun_nodes(affected_set_value: affected)
  )
}


fn ci_repo_path_has_prefix(path: RepoPath, prefix: RepoPath) -> Bool {
  is_prefix_of(prefix: prefix, xs: path, eq: fn(left, right) { left == right })
}


fn ci_changed_path_affects_v2(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v2/")
    || changed == "Cargo.toml"
    || changed == "Cargo.lock"
}


fn ci_changed_path_affects_v3(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v3/")
    || ci_repo_path_has_prefix(path: changed, prefix: "dsl/")
}


fn ci_changed_path_affects_v4(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v4/")
    || ci_repo_path_has_prefix(path: changed, prefix: "fixtures/v4-mvp1/")
    || changed == "scripts/v4-mvp1-e2e-gate.sh"
    || changed == "scripts/v4-m1-rust-emit-probe.sh"
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-mvp1")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-m1")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-testclaim-")
    || ci_repo_path_has_prefix(path: changed, prefix: "dsl/std/")
    || changed == "Cargo.toml"
    || changed == "Cargo.lock"
}


fn ci_changed_path_affects_workflow_policy(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: ".github/workflows/")
    || changed == "src/v4/workflow/ci.dag"
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/workflow/ci/")
    || ci_repo_path_has_prefix(path: changed, prefix: "tools/ci_affected_components")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/check-workflow-path-regex-inventory")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/workflow-path-regex-forbidden-substrings")
}

// RELEASE_TODO §5 Phase 1a — release workflow / matrix authority (install.dag is Phase 1b).
fn ci_changed_path_affects_release_distribution(changed: RepoPath) -> Bool {
  changed == "src/v4/workflow/release.dag"
    || changed == ".github/workflows/release.yml"
}


fn ci_component_affected_fail_closed() -> CiComponentAffected {
  CiComponentAffected {
    v2: true
    v3: true
    v4: true
    workflow_policy: true
    release_distribution: true
  }
}


fn ci_component_affected_from_git_diff(git_diff: GitDiffNameOnly) -> CiComponentAffected {
  CiComponentAffected {
    v2: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v2),
    v3: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v3),
    v4: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v4),
    workflow_policy: any(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_affects_workflow_policy
    ),
    release_distribution: any(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_affects_release_distribution
    )
  }
}


fn ci_component_affected_from_git_diff_read(outcome: Outcome<GitDiffNameOnly>) -> CiComponentAffected {
  match outcome {
    Accepted { value: git_diff, diagnostics: _ } =>
      ci_component_affected_from_git_diff(git_diff: git_diff)
    Rejected { diagnostics: _ } => ci_component_affected_fail_closed()
  }
}


fn ci_int_positive(n: Int) -> Bool {
  n >= 1
}


fn ci_runner_pool_capacity_valid(pool: SelfHostedRunnerPool) -> Bool {
  ci_int_positive(n: pool.core_count)
    && ci_int_positive(n: pool.runner_count)
    && ci_int_positive(n: pool.jobserver_token_cap)
}


fn ci_runner_pool_fleet_capacities_valid() -> Bool {
  for_all(xs: ci_self_hosted_runner_pools, predicate: ci_runner_pool_capacity_valid)
}


// RULING-1: 🟢 operator fact — M1 rust-emit probe `cargo check --jobs` cap (operator 2026-05-28).
// Wave-0: explicit constant, not fleet-derived (jobserver÷runner allocation rule unpublished).
// ci_srv1_pool/ci_srv2_pool retain host capacity facts for YamlStatic projection follow-on (T-24/#98).
data m1_probe_cargo_check_jobs: Int = 4


fn ci_char_projection_out_of_range_injective_witness() -> Bool {
  content_hash(n: ci_char_projection_node(c: int_add(a: 255, b: 1))) !=
    content_hash(n: ci_char_projection_node(c: int_add(a: 255, b: 2)))
    && content_hash(n: ci_char_projection_node(c: int_negate(i: 1))) !=
      content_hash(n: ci_char_projection_node(c: int_negate(i: 2)))
}


// Receipt: out-of-byte-range Char projections stay distinguishable under evaluator-input content_hash.
data ci_char_projection_out_of_range_injective_ok: Bool = ci_char_projection_out_of_range_injective_witness()
