data ci_v3_determinism_profile: CiBuildProfile = Release
data ci_v3_self_host_fixed_point_profile: CiBuildProfile = Release

data ci_pipeline: Outcome<CiPipeline> = ci_pipeline_well_formed(p: CiPipeline {
  jobs: [
    CiJob {
      id: v2_bootstrap_smoke_execution,
      command: V2BootstrapCompileCommand,
      needs: []
    },
    CiJob {
      id: v2_compile_src_v4,
      command: BootstrapStageCompile { produces: v4_stage0_binary },
      needs: []
    },
    CiJob {
      id: v3_determinism_execution,
      command: V3DeterminismCommand { profile: ci_v3_determinism_profile },
      needs: []
    },
    CiJob {
      id: v3_self_host_fixed_point_execution,
      command: V3SelfHostFixedPointCommand {
        profile: ci_v3_self_host_fixed_point_profile
        schedule: MainPush
      },
      needs: [v3_determinism_execution]
    },
    CiJob {
      id: lens_ci_registry_execution,
      command: LensCiCommand { required_lenses: lens_ci_required_lenses },
      needs: [v2_compile_src_v4]
    },
    CiJob {
      id: v4_t15_self_host_fixed_point_execution,
      command: V4T15SelfHostFixedPointCommand,
      needs: [v2_compile_src_v4]
    },
    CiJob {
      id: m1_rust_emit_probe_execution,
      command: M1RustEmitProbeCommand,
      needs: [v2_compile_src_v4]
    },
    CiJob {
      id: testclaim_corpus_eval_execution,
      command: TestClaimCorpusEvalCommand { selection_fn: ci_testclaim_corpus_selection_fn },
      needs: [v2_compile_src_v4]
    }
  ],
  gates: [
    CiGate {
      id: structural_v2_compile,
      job: v2_compile_src_v4,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    },
    CiGate {
      id: lens_ci_registry_signal,
      job: lens_ci_registry_execution,
      run_policy: Always
    },
    CiGate {
      id: m1_rust_emit_probe_signal,
      job: m1_rust_emit_probe_execution,
      run_policy: Always
    },
    CiGate {
      id: testclaim_corpus_eval_signal,
      job: testclaim_corpus_eval_execution,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    }
  ]
})


data ci_duplicate_job_id: Symbol = ci_duplicate_job_id
data ci_duplicate_gate_id: Symbol = ci_duplicate_gate_id
data ci_dangling_reference: Symbol = ci_dangling_reference
data ci_dependency_cycle: Symbol = ci_dependency_cycle
data ci_bootstrap_authority_violation: Symbol = ci_bootstrap_authority_violation
data ci_workflow_file: Symbol = ci_workflow_file

fn ci_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: Textual { file: ci_workflow_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn ci_job_ids(jobs: List<CiJob>) -> List<Symbol> {
  fold(jobs, init: [], f: fn(acc, j) {
    concat([j.id], acc)
  })
}

fn ci_gate_ids(gates: List<CiGate>) -> List<Symbol> {
  fold(gates, init: [], f: fn(acc, g) {
    concat([g.id], acc)
  })
}

fn ci_gate_job_ids(gates: List<CiGate>) -> List<Symbol> {
  fold(gates, init: [], f: fn(acc, g) {
    concat([g.job], acc)
  })
}

fn ci_gate_run_policy_job_ids(gates: List<CiGate>) -> List<Symbol> {
  fold(gates, init: [], f: fn(acc, g) {
    match g.run_policy {
      Always => acc
      RequiresJobAttempt { job } => concat([job], acc)
    }
  })
}

fn ci_member(s: Symbol, ids: List<Symbol>) -> Bool {
  count_equal(xs: ids, item: s, eq: fn(left, right) { left == right }) != 0
}

fn ci_symbol_resolves(s: Symbol, jobs: List<CiJob>) -> Bool {
  ci_member(s: s, ids: ci_job_ids(jobs: jobs))
}

fn ci_all_job_ids_unique(jobs: List<CiJob>) -> Bool {
  unique(xs: ci_job_ids(jobs: jobs), eq: fn(left, right) { left == right })
}

fn ci_all_gate_ids_unique(gates: List<CiGate>) -> Bool {
  unique(xs: ci_gate_ids(gates: gates), eq: fn(left, right) { left == right })
}

fn ci_all_needs_resolve(jobs: List<CiJob>) -> Bool {
  fold(jobs, init: true, f: fn(acc, j) {
    acc && for_all(xs: j.needs, predicate: fn(n) {
      ci_symbol_resolves(s: n, jobs: jobs)
    })
  })
}

fn ci_all_gate_jobs_resolve(gates: List<CiGate>, jobs: List<CiJob>) -> Bool {
  for_all(xs: ci_gate_job_ids(gates: gates), predicate: fn(job_sym) {
    ci_symbol_resolves(s: job_sym, jobs: jobs)
  })
}

fn ci_all_gate_run_policies_resolve(gates: List<CiGate>, jobs: List<CiJob>) -> Bool {
  for_all(xs: ci_gate_run_policy_job_ids(gates: gates), predicate: fn(job_sym) {
    ci_symbol_resolves(s: job_sym, jobs: jobs)
  })
}

fn ci_job_needs(id: Symbol, jobs: List<CiJob>) -> List<Symbol> {
  fold(jobs, init: [], f: fn(acc, j) {
    if j.id == id { j.needs } else { acc }
  })
}

fn ci_blocked(id: Symbol, remaining: List<Symbol>, jobs: List<CiJob>) -> Bool {
  count_where(xs: ci_job_needs(id: id, jobs: jobs), predicate: fn(n) {
    ci_member(s: n, ids: remaining)
  }) != 0
}

fn ci_eliminate_pass(remaining: List<Symbol>, jobs: List<CiJob>) -> List<Symbol> {
  fold(remaining, init: [], f: fn(acc, id) {
    if ci_blocked(id: id, remaining: remaining, jobs: jobs) {
      concat([id], acc)
    } else {
      acc
    }
  })
}

fn ci_kahn_fixpoint(jobs: List<CiJob>) -> List<Symbol> {
  fold(jobs, init: map(jobs, fn(j) { j.id }), f: fn(remaining, job) {
    ci_eliminate_pass(remaining: remaining, jobs: jobs)
  })
}

fn ci_acyclic(jobs: List<CiJob>) -> Bool {
  length(xs: ci_kahn_fixpoint(jobs: jobs)) == 0
}

// 🟡 negative-coverage plan-bound (T-22) — LB-T22-3213
fn ci_command_authority_ok(c: CiCommand) -> Bool {
  match c {
    LintCommand => true
    TestCommand => true
    IgnoredTestCommand { test_name: _ } => true
    LensCiCommand { required_lenses } => lens_registry_ids_resolve(lens_ids: required_lenses)
    BootstrapStageCompile { produces: pr } => bootstrap_stage_output(plan: bootstrap_plan, s: pr)
    V2BootstrapCompileCommand => true
    V3DeterminismCommand { profile: _ } => true
    V3SelfHostFixedPointCommand { profile: _, schedule: _ } => true
    V4T15SelfHostFixedPointCommand => true
    M1RustEmitProbeCommand => true
    TestClaimCorpusEvalCommand { selection_fn: fn_name } =>
      fn_name == ci_testclaim_corpus_selection_fn
  }
}

fn ci_all_commands_authority_ok(jobs: List<CiJob>) -> Bool {
  fold(jobs, init: true, f: fn(acc, j) {
    acc && ci_command_authority_ok(c: j.command)
  })
}

