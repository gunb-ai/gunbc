  ci_upsert_file_set_input(segment: "src/v4/test/claim/workflow/manual_corpus_eval.dag")
]

// #4091 §1.2 — M1 rust emit is upstream compile authority (forbidden: host-owned `gunbc compile --target rust` in corpus eval transport).
// Bootstrap dag emit: workflow-local — see `ci_always_run_carveouts` row `workflow_local_bootstrap_dag_upstream` (composition-edge V4_BOOTSTRAP_* in ci.yml until `v4_bootstrap_dag_emit_ci_job` lands).
data ci_upsert_testclaim_corpus_eval_upstream_inputs: List<UpsertInputRef> = [
  ci_upsert_upstream_job_input(job: m1_rust_emit_probe_execution)
]

fn ci_upsert_testclaim_corpus_eval_claim_ref_inputs() -> List<UpsertInputRef> {
  fold(ci_testclaim_corpus_eval_claim_ids, init: ci_empty_upsert_input_refs(), f: fn(acc, claim_id) {
    list_snoc_item(xs: acc, item: ci_upsert_test_claim_ref_input(claim_id: claim_id))
  })
}

fn ci_upsert_testclaim_corpus_eval_file_and_claim_inputs_mk() -> List<UpsertInputRef> {
  fold(ci_upsert_testclaim_corpus_eval_claim_ref_inputs(), init: ci_upsert_testclaim_corpus_eval_file_set_inputs, f: fn(acc, item) {
    list_snoc_item(xs: acc, item: item)
  })
}

fn ci_upsert_testclaim_corpus_eval_execution_inputs_mk() -> List<UpsertInputRef> {
  fold(ci_upsert_testclaim_corpus_eval_file_and_claim_inputs_mk(), init: ci_upsert_testclaim_corpus_eval_upstream_inputs, f: fn(acc, item) {
    list_snoc_item(xs: acc, item: item)
  })
}

