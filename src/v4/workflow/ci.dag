// Demoted Class-C gates (phase1 nat-semiring rung shell, T-22 corpus eval shell) no longer
// carry CiLiveWorkflowStepSignal ledger rows — structural authority is ci_pipeline jobs +
// CiUpsertStep only. Historical P5 marks: feature:phase1-nat-semiring-rung-gate-binding-smoke,
// feature:t38-testclaim-corpus-eval (dissolve-on-arrival when emitted workflow reads commands).

data ci_pipeline: Outcome<CiPipeline> = ci_pipeline_well_formed(p: CiPipeline {
  jobs: [
    ci_job_v2_bootstrap_smoke_execution_row,
    CiJob {
      id: v2_compile_src_v4,
      command: BootstrapStageCompile { produces: v4_stage0_binary },
      needs: []
    },
    ci_job_v3_determinism_execution_row,
    ci_job_v3_self_host_fixed_point_execution_row,
    CiJob {
      id: lens_ci_registry_execution,
      command: LensCiCommand { required_lenses: lens_ci_required_lenses },
      needs: [v2_compile_src_v4]
    },
    ci_job_v4_t15_self_host_fixed_point_execution_row,
    CiJob {
      id: m1_rust_emit_probe_execution,
      command: M1RustEmitProbeCommand,
      needs: [v2_compile_src_v4]
    },
    ci_job_leaf_model_go_verify_execution_row,
    ci_job_testclaim_corpus_eval_execution_row,
    ci_job_lens_ownership_family_eval_execution_row,
    ci_job_source_authority_receipt_eval_execution_row,
    CiJob {
      id: phase1_nat_semiring_rung_gate_execution,
      command: Phase1NatSemiringRungGateCommand,
      needs: [v2_compile_src_v4]
    }
  ],
  gates: [
    CiGate {
      id: structural_v2_compile,
      job: v2_compile_src_v4,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    },
    CiGate {
      id: lens_ci_registry_signal,
      job: lens_ci_registry_execution,
      run_policy: Always
    },
    CiGate {
      id: m1_rust_emit_probe_signal,
      job: m1_rust_emit_probe_execution,
      run_policy: Always
    },
    CiGate {
      id: leaf_model_go_verify_signal,
      job: leaf_model_go_verify_execution,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    },
    CiGate {
      id: testclaim_corpus_eval_signal,
      job: testclaim_corpus_eval_execution,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    },
    CiGate {
      id: lens_ownership_family_eval_signal,
      job: lens_ownership_family_eval_execution,
      run_policy: RequiresJobAttempt { job: testclaim_corpus_eval_execution }
    },
    CiGate {
      id: source_authority_receipt_eval_signal,
      job: source_authority_receipt_eval_execution,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    },
    CiGate {
      id: phase1_nat_semiring_rung_gate_signal,
      job: phase1_nat_semiring_rung_gate_execution,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    }
  ]
})


