fn ci_connective_projection_node(c: Connective) -> Node {
  match c {
    Atom { identity: atom_id } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(name: ci_projection_node_query_connective_edge, target: ci_atom(sym: ci_cache_connective_atom_tag)),
          ci_named_edge(name: ci_projection_connective_atom_identity_edge, target: ci_atom(sym: atom_id))
        ]
      }
    Conj => ci_atom(sym: ci_cache_connective_conj_tag)
    Disj => ci_atom(sym: ci_cache_connective_disj_tag)
    Arrow => ci_atom(sym: ci_cache_connective_arrow_tag)
    Cardinality => ci_atom(sym: ci_cache_connective_cardinality_tag)
    Instantiation => ci_atom(sym: ci_cache_connective_instantiation_tag)
  }
}


fn ci_node_query_projection_node(query: NodeQuery) -> Node {
  match query {
    NodeQueryByConnective { connective: c } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(
            name: ci_projection_upsert_input_substrate_edge,
            target: ci_atom(sym: ci_cache_node_query_by_connective_tag)
          ),
          ci_named_edge(
            name: ci_projection_node_query_connective_edge,
            target: ci_connective_projection_node(c: c)
          )
        ]
      }
    NodeQueryByPath { at: path } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(
            name: ci_projection_upsert_input_substrate_edge,
            target: ci_atom(sym: ci_cache_node_query_by_path_tag)
          ),
          ci_named_edge(
            name: ci_projection_node_query_path_edge,
            target: ci_symbol_list_projection_node(xs: path.steps)
          )
        ]
      }
  }
}


