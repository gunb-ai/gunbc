fn test_claim_typed_input_ci_pipeline(
  evaluator_input: CiPipeline,
  evaluator_pin: Symbol
) -> TestClaimTypedInput<CiPipeline> {
  TestClaimTypedInput {
    evaluator_input: evaluator_input,
    evaluator_pin: evaluator_pin
  }
}


fn ci_test_claim_evaluator_digest(input: TestClaimTypedInput<CiPipeline>) -> Hash {
  content_hash(
    n: ci_pipeline_evaluator_input_node(
      pipeline: input.evaluator_input,
      evaluator_pin: input.evaluator_pin
    )
  )
}


// 🟢 derived-operation — feature:T22-EVAL-PASS-RECEIPT — LB-T22-3213 negative-coverage plan-bound receipt.
type WorkflowPipelinePlanBoundPassReceipt {
  run: TestClaimRun<CiPipeline, CiPipeline>
  plan_hash: Hash
}


// Reads original `run.verdict` (not `workflow_pipeline_pass_gate` output): pass_gate rewraps `Fail.actual` as `Accepted { value: run }`.
fn workflow_pipeline_receipt_failure_diagnostics(
  run: TestClaimRun<CiPipeline, CiPipeline>
) -> List<Diagnostic> {
  match run.verdict {
    Fail { actual: Rejected { diagnostics: ds }, falsification: _ } => ds
    // Unreachable from `workflow_pipeline_plan_bound_pass_receipt` Fail arm today; honest tag if call sites change.
    _ =>
      diagnostics_singleton(d: ci_diagnostic(reason: ci_workflow_receipt_unexpected_verdict))
  }
}


// Pass arm is intentionally lossy (`aggregate_verdicts` Pass carries no payload); `workflow_pipeline_plan_bound_pass_receipt` closes over the original `run` on Pass.
fn workflow_pipeline_pass_gate(
  run: TestClaimRun<CiPipeline, CiPipeline>,
  at: Node
) -> Verdict<TestClaimEvalSubject<CiPipeline>, TestClaimRun<CiPipeline, CiPipeline>> {
  aggregate_verdicts(
    rs: [
      match run.verdict {
        Pass => Pass
        Fail { actual: _, falsification: _ } =>
          Fail { actual: Accepted { value: run, diagnostics: ci_no_diagnostics() }, falsification: Absent }
        Deferred { actual: _, diagnostic: d } =>
          Deferred { actual: Accepted { value: run, diagnostics: ci_no_diagnostics() }, diagnostic: d }
      }
    ],
    at: at
  )
}


fn workflow_pipeline_plan_bound_pass_receipt(
  run: TestClaimRun<CiPipeline, CiPipeline>,
  at: Node
) -> Outcome<WorkflowPipelinePlanBoundPassReceipt> {
  match workflow_pipeline_pass_gate(run: run, at: at) {
    Pass =>
      match ci_bootstrap_plan_cache_hash() {
        Accepted { value: plan_hash, diagnostics: _ } =>
          Accepted {
            value: WorkflowPipelinePlanBoundPassReceipt {
              run: run,
              plan_hash: plan_hash
            },
            diagnostics: ci_no_diagnostics()
          }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    Fail { actual: _, falsification: _ } =>
      Rejected { diagnostics: workflow_pipeline_receipt_failure_diagnostics(run: run) }
    Deferred { actual: _, diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


fn ci_test_claim_cache_interpretation_hash(subject: TestClaimEvalSubject<CiPipeline>) -> Hash {
  combine_hash(
    a: inferred_tree_digest(tree: subject.tree),
    b: combine_hash(
      a: test_claim_interpretation_cache_digest(context: subject.context),
      b: ci_test_claim_evaluator_digest(input: subject.input)
    )
  )
}


fn test_claim_cache_key_interpretation_hash_ci_pipeline(key: TestClaimCacheKey<CiPipeline>) -> Hash {
  ci_test_claim_cache_interpretation_hash(subject: key.eval_subject)
}


fn test_claim_cache_receipt_pinned(subject: TestClaimEvalSubject<CiPipeline>) -> TestClaimCacheReceipt<CiPipeline> {
  TestClaimCacheReceipt {
    key: TestClaimCacheKey {
      eval_subject: subject
    }
  }
}


fn ci_pipeline_well_formed(p: CiPipeline) -> Outcome<CiPipeline> {
  if ci_all_job_ids_unique(jobs: p.jobs) {
    if ci_all_gate_ids_unique(gates: p.gates) {
      if ci_all_needs_resolve(jobs: p.jobs) {
        if ci_all_gate_jobs_resolve(gates: p.gates, jobs: p.jobs) {
          if ci_all_gate_run_policies_resolve(gates: p.gates, jobs: p.jobs) {
            if ci_acyclic(jobs: p.jobs) {
              if ci_all_commands_authority_ok(jobs: p.jobs) {
                Accepted { value: p, diagnostics: ci_no_diagnostics() }
              } else {
                Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_bootstrap_authority_violation)) }
              }
            } else {
              Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dependency_cycle)) }
            }
          } else {
            Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
          }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
      }
    } else {
      Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_gate_id)) }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_job_id)) }
  }
}


fn test_claim_in_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}


fn ci_select_from_rerun_nodes(roster: List<TestClaim>, rerun: RerunNodeSet) -> List<TestClaim> {
  match rerun {
    RerunNodeSetProduced { nodes: nodes } =>
      filter(
        xs: roster,
        predicate: fn(claim) {
          test_claim_ci_selection_fail_closed(c: claim)
            || test_claim_in_rerun_frontier(claim: claim, frontier: nodes)
        }
      )
    RerunNodeSetFailClosed { evidence: _ } => roster
  }
}


fn ci_select_from_affected_set(roster: List<TestClaim>, affected: AffectedSet) -> List<TestClaim> {
  ci_select_from_rerun_nodes(
    roster: roster,
    rerun: affected_set_rerun_nodes(affected_set_value: affected)
  )
}


// Node-precise CI consumer: narrows the TestClaim roster by a node-precise
// `AffectedSetReading` (edit-locus + dependency-closure frontier) rather than coarse
// component flags. Reuses the existing `ci_select_from_rerun_nodes` frontier filter via the
// `affected_set_reading_rerun_nodes` lens bridge — no parallel selector authority.
fn ci_select_from_affected_set_reading(roster: List<TestClaim>, reading: AffectedSetReading) -> List<TestClaim> {
  ci_select_from_rerun_nodes(
    roster: roster,
    rerun: affected_set_reading_rerun_nodes(reading: reading)
  )
}


// Node-precise CI consumer over the git-diff reading Witness produced by
// `affected_set_reading_from_git_diff` (v4.lens.edit_locus). `Holds` narrows node-precisely;
// `Violates` (no/ambiguous edit-locus) preserves the fail-closed superset contract — the
// whole roster reruns — exactly like `ci_select_from_rerun_nodes`' `RerunNodeSetFailClosed`
// arm. This keeps fail-closed in CI-consumer authority, not in a caller/test.
fn ci_select_from_affected_set_reading_witness(
  roster: List<TestClaim>,
  reading_witness: Witness<AffectedSetReading>
) -> List<TestClaim> {
  match reading_witness {
    Holds { value: reading } =>
      ci_select_from_affected_set_reading(roster: roster, reading: reading)
    Violates { diagnostic: _ } =>
      roster
  }
}


// ── Wave 3 TestClaim shadow selection (roster authority + frontier filter) ──────────────────────
// Shadow / NON-GATING API. Narrows the single Wave-3 roster authority
// (`ci_wave3_shadow_claim_roster` = manual corpus + accepted generated LBE claims, defined in
// v4.test.claim.workflow.wave3_shadow_roster) by the affected-set rerun frontier via the EXISTING
// `ci_select_*` lens. No host Rust lens reimplementation; no corpus execution — per-row
// `TestClaimRun` RUNTIME verdicts are the T-38 / P5 bootstrap-evaluator corpus runtime lane
// (docs/planning/v4-p5-bootstrap-evaluator-corpus-runtime-worksheet-2026-06-01.md), NOT this slice.
fn ci_wave3_shadow_testclaims_selected(affected: AffectedSet) -> List<TestClaim> {
  ci_select_from_affected_set(
    roster: ci_wave3_shadow_claim_roster(),
    affected: affected
  )
}


fn ci_wave3_shadow_testclaims_selected_from_rerun(rerun: RerunNodeSet) -> List<TestClaim> {
  ci_select_from_rerun_nodes(
    roster: ci_wave3_shadow_claim_roster(),
    rerun: rerun
  )
}


// eval/print ENTRY scoping — NAMED-ONLY future CI-facing entrypoint.
// 🟡 transport-blocked — feature:wave3-shadow-selection-receipt — consumer: future CI selection
// receipt — the live entrypoint `ci_selection_receipt_shadow_from_git_diff(git_diff)` would route
// GitDiffNameOnly → Diff → `affected_set_from_diff(read_model, post_edit_dag, dag, diff)`
// (v4.lens.affected_set) → `ci_wave3_shadow_testclaims_selected`. It is NOT implemented here because
// `affected_set_from_diff` requires the live whole-program `Dag` + `post_edit_dag` at CI time, which
// no harness yet provides — blocked on Compiler Spine harness debt node://adhoc-331899f9-19a.
// The honest model boundary that IS landed is `ci_wave3_shadow_testclaims_selected(affected)` above
// (AffectedSet-in) plus the fixture receipts below. Forbidden: fabricating a git-diff→AffectedSet
// shim that does not consult the live `Dag` (would falsely claim live PR selection).
data ci_wave3_shadow_selection_receipt_reason: Symbol = ci_wave3_shadow_selection_receipt_reason

// Fixture receipts (authoring-time witnesses) — fail-closed selects the FULL Wave-3 roster.
data ci_wave3_shadow_fail_closed_reason: Symbol = ci_wave3_shadow_fail_closed_reason

data ci_wave3_shadow_fail_closed_affected: AffectedSet = AffectedSetFailClosed {
  changes: ChangeSet { changes: [] },
  evidence: AffectedSetReason { reason: ci_wave3_shadow_fail_closed_reason }
}

// Fail-closed (no node frontier) returns the whole roster — roster authority preserved as superset.
// NB: `==` kept on one line — the v2 M1-emit parser ends the expression at a pre-`==` line break.
fn ci_wave3_shadow_fail_closed_selects_full_roster() -> Bool {
  let selected = ci_wave3_shadow_testclaims_selected(affected: ci_wave3_shadow_fail_closed_affected)
  length(xs: selected) == length(xs: ci_wave3_shadow_claim_roster())
}

// Empty produced frontier touches no roster claim's evaluation nodes — none of the Wave-3 rows are
// DiagnosticClaim (the only fail-closed-forced arm), so the selection narrows to the empty set.
fn ci_wave3_shadow_empty_frontier_selects_none() -> Bool {
  let selected = ci_wave3_shadow_testclaims_selected_from_rerun(rerun: RerunNodeSetProduced { nodes: [] })
  length(xs: selected) == 0
}

// Roster authority cardinality: manual subset + generated subset = full roster (disjoint append).
fn ci_wave3_shadow_roster_is_manual_plus_generated() -> Bool {
  let parts = int_add(a: length(xs: ci_wave3_shadow_manual_claim_roster()), b: length(xs: ci_wave3_shadow_generated_claim_roster()))
  parts == length(xs: ci_wave3_shadow_claim_roster())
}

data witness_ci_wave3_shadow_selection_holds: Bool = ci_wave3_shadow_fail_closed_selects_full_roster()
  && ci_wave3_shadow_empty_frontier_selects_none()
  && ci_wave3_shadow_roster_is_manual_plus_generated()


fn ci_repo_path_has_prefix(path: RepoPath, prefix: RepoPath) -> Bool {
  is_prefix_of(prefix: prefix, xs: path, eq: fn(left, right) { left == right })
}


fn ci_changed_path_affects_v2(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v2/")
    || changed == "Cargo.toml"
    || changed == "Cargo.lock"
}


fn ci_changed_path_affects_v3(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v3/")
    || ci_repo_path_has_prefix(path: changed, prefix: "dsl/")
    || changed == "Cargo.toml"
    || changed == "Cargo.lock"
}


fn ci_changed_path_affects_v4(changed: RepoPath) -> Bool {
  changed == "src/v4/bin/main.dag"
    || changed == "src/v4/workflow/bootstrap.dag"
    || changed == "src/v4/workflow/ci.dag"
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/compiler/")
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/std/")
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/extdeps/")
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/lens/")
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/test/claim/manual/")
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/test/claim/generated/")
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/test/fixture/")
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/test/v2_run_preflight/")
    || changed == "src/v4/test/coercion_fold_int_rust_fixture.dag"
    || ci_repo_path_has_prefix(path: changed, prefix: "fixtures/v4-mvp1/")
    || changed == ".github/ci-floor/v4-m1-rust-emit-probe.sh"
    || ci_repo_path_has_prefix(path: changed, prefix: ".github/ci-floor/")
    || ci_repo_path_has_prefix(path: changed, prefix: "dsl/std/")
    || changed == "Cargo.toml"
    || changed == "Cargo.lock"
}


fn ci_changed_path_affects_testclaim_corpus(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v4/test/claim/")
}


fn ci_changed_path_affects_workflow_policy(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: ".github/workflows/")
    || changed == "src/v4/workflow/ci.dag"
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/workflow/ci/")
    || ci_repo_path_has_prefix(path: changed, prefix: "tools/ci_affected_components")
    || ci_repo_path_has_prefix(path: changed, prefix: ".github/ci-floor/")
}

// RELEASE_TODO §5 Phase 1a–1b — release workflow + hand-synced install scripts.
fn ci_changed_path_affects_release_distribution(changed: RepoPath) -> Bool {
  changed == "src/v4/workflow/release.dag"
    || changed == ".github/workflows/release.yml"
    || changed == "install.sh"
    || changed == "install/release-target-triples.sh"
    || changed == "src/v4/install/install.dag"
}


fn ci_changed_path_triggers_ci_component(changed: RepoPath) -> Bool {
  ci_changed_path_affects_v2(changed: changed)
    || ci_changed_path_affects_v3(changed: changed)
    || ci_changed_path_affects_v4(changed: changed)
    || ci_changed_path_affects_testclaim_corpus(changed: changed)
    || ci_changed_path_affects_workflow_policy(changed: changed)
    || ci_changed_path_affects_release_distribution(changed: changed)
}


// Per-path: release lane, or no CI component bucket (avoid `!` in list predicates — tokenizer).
fn ci_changed_path_in_release_only_lane(changed: RepoPath) -> Bool {
  match ci_changed_path_affects_release_distribution(changed: changed) {
    true => true
    false =>
      match ci_changed_path_triggers_ci_component(changed: changed) {
        true => false
        false => true
      }
  }
}


// RELEASE §5 — skip orthogonal fixture gates only when the diff is exclusively
// release-distribution paths (mixed release + phase1 fixture paths must not skip).
fn ci_release_distribution_only_from_git_diff(git_diff: GitDiffNameOnly) -> Bool {
  any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_release_distribution)
    && all(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_in_release_only_lane
    )
}


fn ci_component_affected_fail_closed() -> CiComponentAffected {
  CiComponentAffected {
    v2: true
    v3: true
    v4: true
    testclaim_corpus: true
    workflow_policy: true
    release_distribution: true
    release_distribution_only: false
  }
}


fn ci_component_affected_from_git_diff(git_diff: GitDiffNameOnly) -> CiComponentAffected {
  CiComponentAffected {
    v2: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v2),
    v3: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v3),
    v4: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v4),
    testclaim_corpus: any(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_affects_testclaim_corpus
    ),
    workflow_policy: any(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_affects_workflow_policy
    ),
    release_distribution: any(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_affects_release_distribution
    ),
    release_distribution_only: ci_release_distribution_only_from_git_diff(git_diff: git_diff)
  }
}


fn ci_component_affected_from_git_diff_read(outcome: Outcome<GitDiffNameOnly>) -> CiComponentAffected {
  match outcome {
    Accepted { value: git_diff, diagnostics: _ } =>
      ci_component_affected_from_git_diff(git_diff: git_diff)
    Rejected { diagnostics: _ } => ci_component_affected_fail_closed()
  }
}


// 🟡 gated — predicate-dissolution interim (Practice 10) — feature:ci-bankruptcy-component-fail-closed — consumer: ci_job_selected_by_affected / ci_select_ci_jobs_from_affected_set — bind bankruptcy B0 §2.2 I1 fail-closed roster — dissolve-on: `CiComponentAffected` gains explicit fail-closed coproduct variant (delete this all-true Bool classifier); until then sentinel on git-diff reject only; forbidden: additional untagged `*_is_*` Bool classifiers on `CiComponentAffected` beside `feature:ci-bankruptcy-schedule-policy` cluster.
fn ci_component_affected_is_fail_closed(affected: CiComponentAffected) -> Bool {
  affected.v2
    && affected.v3
    && affected.v4
    && affected.testclaim_corpus
    && affected.workflow_policy
    && affected.release_distribution
}


fn ci_component_mask_intersects(mask: CiComponentAffected, affected: CiComponentAffected) -> Bool {
  (mask.v2 && affected.v2)
    || (mask.v3 && affected.v3)
    || (mask.v4 && affected.v4)
    || (mask.testclaim_corpus && affected.testclaim_corpus)
    || (mask.workflow_policy && affected.workflow_policy)
    || (mask.release_distribution && affected.release_distribution)
}


// Job-selection mask row — always sets release_distribution_only: false (orthogonal RELEASE §5 lane flag on affected outputs).
fn ci_job_component_mask_row(
  v2: Bool,
  v3: Bool,
  v4: Bool,
  testclaim_corpus: Bool,
  workflow_policy: Bool,
  release_distribution: Bool
) -> CiComponentAffected {
  CiComponentAffected {
    v2: v2
    v3: v3
    v4: v4
    testclaim_corpus: testclaim_corpus
    workflow_policy: workflow_policy
    release_distribution: release_distribution
    release_distribution_only: false
  }
}


fn ci_job_component_mask(j: CiJob) -> CiComponentAffected {
  match j.command {
    V2BootstrapCompileCommand =>
      ci_job_component_mask_row(
        v2: true,
        v3: false,
        v4: false,
        testclaim_corpus: false,
        workflow_policy: false,
        release_distribution: false
      )
    // v2-only I2 (stage0) is ci_integration + V2BootstrapCompileCommand; v2_compile_src_v4 YAML projection is ci_v4 gunbc build (v4|testclaim|workflow_policy|main-push for I7 T-15 needs closure).
    BootstrapStageCompile { produces: _ } =>
      ci_job_component_mask_row(
        v2: false,
        v3: false,
        v4: true,
        testclaim_corpus: false,
        workflow_policy: false,
        release_distribution: false
      )
    V3DeterminismCommand { profile: _ } =>
      ci_job_component_mask_row(
        v2: false,
        v3: true,
        v4: false,
        testclaim_corpus: false,
        workflow_policy: false,
        release_distribution: false
      )
    // I4: v3 frontier (D1) + MainPush via ci_v3_self_host_fixed_point_scheduled; not mask-only MainPush.
    V3SelfHostFixedPointCommand { profile: _, schedule: _ } =>
      ci_job_component_mask_row(
        v2: false,
        v3: true,
        v4: false,
        testclaim_corpus: false,
        workflow_policy: false,
        release_distribution: false
      )
    // Lens-CI YAML steps gate v4|workflow_policy only (ci.yml smoke + semantic); no v3 disjunct.
    LensCiCommand { required_lenses: _ } =>
      ci_job_component_mask_row(
        v2: false,
        v3: false,
        v4: true,
        testclaim_corpus: false,
        workflow_policy: true,
        release_distribution: false
      )
    // Mask axes: v4|workflow_policy (ci.yml T-15 step if); main-push via ci_v4_t15_scheduled. No v3 — I7 runs only when ci_v4 runs (parent job gates v4|testclaim_corpus|workflow_policy|main-push).
    V4T15SelfHostFixedPointCommand =>
      ci_job_component_mask_row(
        v2: false,
        v3: false,
        v4: true,
        testclaim_corpus: false,
        workflow_policy: true,
        release_distribution: false
      )
    // I8: testclaim_corpus + release_distribution — upstream for T-22 via Upsert; mask must match YAML step if.
    M1RustEmitProbeCommand =>
      ci_job_component_mask_row(
        v2: false,
        v3: false,
        v4: true,
        testclaim_corpus: true,
        workflow_policy: true,
        release_distribution: true
      )
    LeafModelGoVerifyCommand =>
      ci_job_component_mask_row(
        v2: false,
        v3: true,
        v4: true,
        testclaim_corpus: true,
        workflow_policy: true,
        release_distribution: true
      )
    Phase1NatSemiringRungGateCommand =>
      ci_job_component_mask_row(
        v2: false,
        v3: false,
        v4: true,
        testclaim_corpus: false,
        workflow_policy: true,
        release_distribution: false
      )
    TestClaimCorpusEvalCommand { selection_fn: _, verdict_surface: _ } =>
      ci_job_component_mask_row(
        v2: false,
        v3: false,
        v4: true,
        testclaim_corpus: true,
        workflow_policy: true,
        release_distribution: true
      )
    LensOwnershipFamilyEvalCommand { verdict_surface: _ } =>
      ci_job_component_mask_row(
        v2: false,
        v3: false,
        v4: true,
        testclaim_corpus: true,
        workflow_policy: true,
        release_distribution: false
      )
    SourceAuthorityReceiptEvalCommand { claims: _ } =>
      ci_job_component_mask_row(
        v2: false,
        v3: false,
        v4: true,
        testclaim_corpus: true,
        workflow_policy: true,
        release_distribution: false
      )
    LintCommand => ci_component_affected_fail_closed()
    TestCommand => ci_component_affected_fail_closed()
    IgnoredTestCommand { test_name: _ } => ci_component_affected_fail_closed()
  }
}


// 🟡 gated — predicate-dissolution interim (Practice 10) — feature:ci-bankruptcy-schedule-policy — consumers: ci_v3_tier0_scheduled, ci_v4_t15_scheduled, ci_v3_self_host_fixed_point_scheduled, ci_job_scheduled_by_policy / ci_select_ci_jobs_from_affected_set — bind bankruptcy B0 §2.2.6 / design-ci-bankruptcy-rebuild.md D1 — dissolve-on: CiJob carries modeled schedule facts and YAML projection reads them directly (delete this Bool dispatch layer); until then command/schedule match arms only; forbidden: additional untagged Bool schedule predicates beside ci_symbol_not_in_ids.
fn ci_v3_tier0_scheduled(affected: CiComponentAffected, schedule: CiSchedulePolicy) -> Bool {
  affected.v3 || schedule == MainPush
}


fn ci_v4_t15_scheduled(affected: CiComponentAffected, schedule: CiSchedulePolicy) -> Bool {
  schedule == MainPush
}


fn ci_v3_self_host_fixed_point_scheduled(
  affected: CiComponentAffected,
  cmd_schedule: CiSchedulePolicy,
  run_schedule: CiSchedulePolicy
) -> Bool {
  if run_schedule != cmd_schedule {
    false
  } else {
    match cmd_schedule {
      MainPush =>
        ci_v3_tier0_scheduled(affected: affected, schedule: run_schedule)
      PullRequest => false
      Nightly => false
    }
  }
}


fn ci_job_scheduled_by_policy(
  j: CiJob,
  affected: CiComponentAffected,
  schedule: CiSchedulePolicy
) -> Bool {
  match j.command {
    V3DeterminismCommand { profile: _ } =>
      ci_v3_tier0_scheduled(affected: affected, schedule: schedule)
    V3SelfHostFixedPointCommand { profile: _, schedule: cmd_schedule } =>
      ci_v3_self_host_fixed_point_scheduled(
        affected: affected,
        cmd_schedule: cmd_schedule,
        run_schedule: schedule
      )
    V4T15SelfHostFixedPointCommand =>
      ci_v4_t15_scheduled(affected: affected, schedule: schedule)
    _ => false
  }
}


fn ci_job_selected_by_affected(
  j: CiJob,
  affected: CiComponentAffected,
  schedule: CiSchedulePolicy
) -> Bool {
  if ci_component_affected_is_fail_closed(affected: affected) {
    true
  } else {
    ci_component_mask_intersects(mask: ci_job_component_mask(j: j), affected: affected)
      || ci_job_scheduled_by_policy(j: j, affected: affected, schedule: schedule)
  }
}


fn ci_jobs_matching_ids(jobs: List<CiJob>, ids: List<Symbol>) -> List<CiJob> {
  fold(jobs, init: [], f: fn(acc, j) {
    if ci_member(s: j.id, ids: ids) {
      concat([j], acc)
    } else {
      acc
    }
  })
}


fn ci_collect_needs_for_ids(ids: List<Symbol>, jobs: List<CiJob>) -> List<Symbol> {
  fold(ids, init: [], f: fn(acc, id) {
    concat(acc, ci_job_needs(id: id, jobs: jobs))
  })
}


fn ci_merge_jobs_unique(acc: List<CiJob>, more: List<CiJob>) -> List<CiJob> {
  fold(more, init: acc, f: fn(acc2, j) {
    if ci_member(s: j.id, ids: ci_job_ids(jobs: acc2)) {
      acc2
    } else {
      concat(acc2, [j])
    }
  })
}


fn ci_select_ci_jobs_needs_closure_pass(
  jobs: List<CiJob>,
  selected: List<CiJob>,
  passes_remaining: Int
) -> List<CiJob> {
  if passes_remaining <= 0 {
    selected
  } else {
    let selected_ids = ci_job_ids(jobs: selected)
    let need_ids = ci_collect_needs_for_ids(ids: selected_ids, jobs: jobs)
    let missing_ids = filter(
      xs: need_ids,
      predicate: fn(n) {
        ci_symbol_resolves(s: n, jobs: jobs) && ci_symbol_not_in_ids(s: n, ids: selected_ids)
      }
    )
    if length(xs: missing_ids) == 0 {
      selected
    } else {
      let added = ci_jobs_matching_ids(jobs: jobs, ids: missing_ids)
      let merged = ci_merge_jobs_unique(acc: selected, more: added)
      if length(xs: merged) == length(xs: selected) {
        selected
      } else {
        ci_select_ci_jobs_needs_closure_pass(
          jobs: jobs,
          selected: merged,
          passes_remaining: passes_remaining - 1
        )
      }
    }
  }
}


fn ci_select_ci_jobs_needs_closure(jobs: List<CiJob>, selected: List<CiJob>) -> List<CiJob> {
  ci_select_ci_jobs_needs_closure_pass(
    jobs: jobs,
    selected: selected,
    passes_remaining: length(xs: jobs)
  )
}


fn ci_select_ci_jobs_from_jobs(
  jobs: List<CiJob>,
  affected: CiComponentAffected,
  schedule: CiSchedulePolicy
) -> List<CiJob> {
  let initial = filter(
    xs: jobs,
    predicate: fn(j) {
      ci_job_selected_by_affected(j: j, affected: affected, schedule: schedule)
    }
  )
  ci_select_ci_jobs_needs_closure(jobs: jobs, selected: initial)
}


fn ci_select_ci_jobs_from_affected_set(
  pipeline: CiPipeline,
  affected: CiComponentAffected,
  schedule: CiSchedulePolicy
) -> List<CiJob> {
  if ci_acyclic(jobs: pipeline.jobs) {
    if ci_all_needs_resolve(jobs: pipeline.jobs) {
      ci_select_ci_jobs_from_jobs(
        jobs: pipeline.jobs,
        affected: affected,
        schedule: schedule
      )
    } else {
      pipeline.jobs
    }
  } else {
    pipeline.jobs
  }
}


fn ci_int_positive(n: Int) -> Bool {
  n >= 1
}


fn ci_runner_pool_capacity_valid(pool: SelfHostedRunnerPool) -> Bool {
  ci_int_positive(n: pool.core_count)
    && ci_int_positive(n: pool.runner_count)
    && ci_int_positive(n: pool.jobserver_token_cap)
}


fn ci_runner_pool_fleet_capacities_valid() -> Bool {
  for_all(xs: ci_self_hosted_runner_pools, predicate: ci_runner_pool_capacity_valid)
}

fn ci_runner_pool_resilience_step_fail_closed(step: RunnerPoolResilienceStep) -> Bool {
  step.fail_closed
}

fn ci_runner_pool_resilience_playbook_fail_closed(p: RunnerPoolResiliencePlaybook) -> Bool {
  ci_runner_pool_resilience_step_fail_closed(step: p.detection)
    && ci_runner_pool_resilience_step_fail_closed(step: p.fallback)
    && ci_runner_pool_resilience_step_fail_closed(step: p.comms)
    && ci_runner_pool_resilience_step_fail_closed(step: p.recovery)
}

fn ci_runner_pool_resilience_playbook_complete(p: RunnerPoolResiliencePlaybook) -> Bool {
  ci_runner_pool_resilience_playbook_fail_closed(p: p)
}

data ci_runner_pool_resilience_playbook_ok: Bool = ci_runner_pool_resilience_playbook_complete(p: ci_runner_pool_resilience_playbook)


// A faithful runner-isolation floor must (a) fail closed on a re-privileged runner — both the
// uid-0 and the passwordless-sudo regression shapes — (b) be a required-path gate, since an
// advisory-only guard would let a fork-PR exposure ride through on a green-with-warnings merge, and
// (c) carry ALL the modeled sentinel facts the comment above advertises as part of the guard: the
// privileged-group set the job greps, the App-private-key path it must not be able to read, and the
// docker.sock path it must not be able to access. Without (c) the receipt would pass for a policy
// that silently drops three of the five advertised de-priv checks (P3 fail-closed: the validator
// must be no weaker than the policy it certifies).
fn ci_runner_isolation_policy_valid(p: RunnerIsolationPolicy) -> Bool {
  p.forbid_root_uid
    && p.forbid_passwordless_sudo
    && p.blocks_required_path
    && ci_int_positive(n: p.timeout_minutes)
    && length(xs: p.privileged_groups) >= 1
    && p.app_private_key_path != ""
    && p.docker_socket_path != ""
}


// Receipt: the runner de-priv regression guard is modeled as a fail-closed, required-path floor.
data ci_runner_isolation_policy_ok: Bool = ci_runner_isolation_policy_valid(p: ci_runner_isolation_policy)


fn ci_char_projection_out_of_range_injective_witness() -> Bool {
  content_hash(n: ci_char_projection_node(c: int_add(a: 255, b: 1))) !=
    content_hash(n: ci_char_projection_node(c: int_add(a: 255, b: 2)))
    && content_hash(n: ci_char_projection_node(c: int_negate(i: 1))) !=
      content_hash(n: ci_char_projection_node(c: int_negate(i: 2)))
}


// SG-7 / T-22: in-range chars use std `byte_offset_cache_key_projection_node` — distinct content_hash (no aliasing).
fn ci_char_projection_in_range_injective_witness() -> Bool {
  content_hash(n: ci_char_projection_node(c: 0)) !=
    content_hash(n: ci_char_projection_node(c: 1))
    && content_hash(n: ci_char_projection_node(c: 97)) !=
      content_hash(n: ci_char_projection_node(c: 98))
    && content_hash(n: ci_char_projection_node(c: 254)) !=
      content_hash(n: ci_char_projection_node(c: 255))
}


fn ci_char_projection_matches_std_cache_key_projection_witness() -> Bool {
  content_hash(n: ci_char_projection_node(c: 0)) ==
    content_hash(n: byte_offset_cache_key_projection_node(i: 0))
    && content_hash(n: ci_char_projection_node(c: 97)) ==
      content_hash(n: byte_offset_cache_key_projection_node(i: 97))
    && content_hash(n: ci_char_projection_node(c: 255)) ==
      content_hash(n: byte_offset_cache_key_projection_node(i: 255))
}


fn ci_char_projection_byte_limb_boundary_witness() -> Bool {
  content_hash(n: ci_char_projection_node(c: 255)) !=
    content_hash(n: ci_char_projection_node(c: int_add(a: 255, b: 1)))
    && content_hash(n: ci_char_projection_node(c: int_negate(i: 1))) !=
      content_hash(n: ci_char_projection_node(c: 0))
}


fn ci_char_projection_cache_hash_surface_witness() -> Bool {
  ci_char_projection_in_range_injective_witness()
    && ci_char_projection_matches_std_cache_key_projection_witness()
    && ci_char_projection_byte_limb_boundary_witness()
    && ci_char_projection_out_of_range_injective_witness()
}


// Receipt: out-of-byte-range Char projections stay distinguishable under evaluator-input content_hash.
data ci_char_projection_out_of_range_injective_ok: Bool = ci_char_projection_out_of_range_injective_witness()

// Receipt: SG-7 cache-key projection surface pinned for evaluator-input content_hash (worksheet §3 probes 2–3).
data ci_char_projection_cache_hash_surface_ok: Bool = ci_char_projection_cache_hash_surface_witness()
