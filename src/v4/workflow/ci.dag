}

// 🟡 coproduct dissolution — feature:ci-always-run-carveouts — bind v4-ci-schema-worksheet §1.4 — dissolve-on-arrival: carveout rows cite structural `DissolutionTarget` only; forbidden: calendar `review_due_by` / bare `Symbol` owner.
type DissolutionTarget
  = ModelMissingSubstrate { what: Symbol }
  | UnknownYet {
      investigation_owner: ManagerSessionId
      required_dfs_receipt: DfsWorksheetRef
    }

data ci_always_run_carveouts: List<CiCarveout> = []

