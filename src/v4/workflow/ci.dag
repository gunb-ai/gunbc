data ci_cache_lens_structural_resolution_tag: Symbol = ci_cache_lens_structural_resolution_tag
data ci_cache_lens_table_decision_tree_tag: Symbol = ci_cache_lens_table_decision_tree_tag
data ci_cache_string_empty_tag: Symbol = ci_cache_string_empty_tag
data ci_cache_char_byte_offset_ineligible_tag: Symbol = ci_cache_char_byte_offset_ineligible_tag
data ci_cache_bootstrap_consumes_empty_tag: Symbol = ci_cache_bootstrap_consumes_empty_tag
data ci_cache_bootstrap_plan_rejected_tag: Symbol = ci_cache_bootstrap_plan_rejected_tag


fn ci_symbol_digest(sym: Symbol) -> Hash {
  content_hash(
    n: Node {
      kind: TypeNode { connective: Atom { identity: sym } },
      children: []
    }
  )
}


fn ci_gate_run_policy_cache_digest(policy: CiGateRunPolicy) -> Hash {
  match policy {
    Always => ci_symbol_digest(sym: ci_cache_gate_policy_always_tag)
    RequiresJobAttempt { job: job } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_cache_gate_policy_requires_job_tag),
        b: ci_symbol_digest(sym: job)
      )
  }
}


// v4.std.text Char = Nat (scalar); use O(log |c|) base-256 digest, not Peano scalar_int_hash.
fn ci_char_cache_digest(c: Char) -> Hash {
  match byte_offset_cache_key(i: c) {
    ByteOffsetCacheEligible { digest: digest } => digest
    ByteOffsetCacheIneligible {
      boundary_tag: boundary_tag,
      witness: witness
    } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_cache_char_byte_offset_ineligible_tag),
        b: combine_hash(
          a: ci_symbol_digest(sym: boundary_tag),
          b: witness
        )
      )
  }
}


fn ci_string_cache_digest(s: String) -> Hash {
  fold_list(
    xs: s,
    empty: ci_symbol_digest(sym: ci_cache_string_empty_tag),
    cons: fn(acc, ch) {
      combine_hash(a: acc, b: ci_char_cache_digest(c: ch))
    }
  )
}


// 🟡 derived-operation — feature:T22-EVAL-CACHE-HASHES — bind IRT-4 / TASKS.md T-22 — dissolve-on: content_hash(Node projection of LensIdV0) replaces ci_lens_id_cache_digest; interim hand-rolled coproduct fold for CiPipeline cache only.
fn ci_lens_id_cache_digest(lens: LensIdV0) -> Hash {
  match lens {
    Complexity => ci_symbol_digest(sym: ci_cache_lens_complexity_tag)
    Cost => ci_symbol_digest(sym: ci_cache_lens_cost_tag)
    Parallelism => ci_symbol_digest(sym: ci_cache_lens_parallelism_tag)
    EffectEnumeration => ci_symbol_digest(sym: ci_cache_lens_effect_enum_tag)
    Idempotency => ci_symbol_digest(sym: ci_cache_lens_idempotency_tag)
    Provenance => ci_symbol_digest(sym: ci_cache_lens_provenance_tag)
    UnusedParameters => ci_symbol_digest(sym: ci_cache_lens_unused_params_tag)
    StructuralResolution => ci_symbol_digest(sym: ci_cache_lens_structural_resolution_tag)
    TableDecisionTree => ci_symbol_digest(sym: ci_cache_lens_table_decision_tree_tag)
  }
}


fn ci_symbol_list_cache_digest(xs: List<Symbol>) -> Hash {
  fold_list(
    xs: xs,
    empty: ci_symbol_digest(sym: ci_cache_bootstrap_consumes_empty_tag),
    cons: fn(acc, sym) {
      combine_hash(a: acc, b: ci_symbol_digest(sym: sym))
    }
  )
}


fn ci_bootstrap_hash_pin_cache_digest(pin: BootstrapHashPin) -> Hash {
  combine_hash(
    a: ci_symbol_digest(sym: pin.pin),
    b: pin.digest
  )
}


fn ci_compile_stage_cache_digest(stage: CompileStage) -> Hash {
  combine_hash(
    a: combine_hash(
      a: ci_symbol_digest(sym: stage.produces),
      b: ci_symbol_digest(sym: stage.compiled_by)
    ),
    b: combine_hash(
      a: ci_bootstrap_hash_pin_cache_digest(pin: stage.produces_hash),
      b: ci_symbol_list_cache_digest(xs: stage.consumes)
    )
  )
}


fn ci_fixpt_stage_cache_digest(fixpt: FixptStage1Stage2) -> Hash {
  combine_hash(
    a: combine_hash(
      a: ci_symbol_digest(sym: fixpt.left),
      b: ci_symbol_digest(sym: fixpt.right)
    ),
    b: combine_hash(
      a: combine_hash(
        a: ci_bootstrap_hash_pin_cache_digest(pin: fixpt.left_hash),
        b: ci_bootstrap_hash_pin_cache_digest(pin: fixpt.right_hash)
      ),
      b: ci_bootstrap_hash_pin_cache_digest(pin: fixpt.pinned_hash)
    )
  )
}


// IRT-4: bootstrap_plan is the authority ci_command_authority_ok uses for BootstrapStageCompile.
// 🟡 derived-operation — feature:T22-EVAL-CACHE-HASHES — bind IRT-4 / TASKS.md T-22 — consumer:ci_command_cache_digest BootstrapStageCompile — dissolve-on: content_hash(Node projection of BootstrapPlan) replaces ci_bootstrap_plan_cache_digest manual field mirror below.
fn ci_bootstrap_plan_cache_digest() -> Hash {
  match bootstrap_plan {
    Accepted { value: plan, diagnostics: _ } =>
      combine_hash(
        a: combine_hash(
          a: ci_compile_stage_cache_digest(stage: plan.seed),
          b: ci_compile_stage_cache_digest(stage: plan.self0)
        ),
        b: combine_hash(
          a: ci_compile_stage_cache_digest(stage: plan.self1),
          b: ci_fixpt_stage_cache_digest(fixpt: plan.fixpt)
        )
      )
    Rejected { diagnostics: _ } =>
      ci_symbol_digest(sym: ci_cache_bootstrap_plan_rejected_tag)
  }
}


fn ci_build_profile_cache_digest(profile: CiBuildProfile) -> Hash {
  match profile {
    Smoke => ci_symbol_digest(sym: ci_cache_build_profile_smoke_tag)
    Release => ci_symbol_digest(sym: ci_cache_build_profile_release_tag)
    FixedPointMatrix => ci_symbol_digest(sym: ci_cache_build_profile_fixed_point_tag)
  }
}


fn ci_schedule_policy_cache_digest(policy: CiSchedulePolicy) -> Hash {
  match policy {
    PullRequest => ci_symbol_digest(sym: ci_cache_schedule_pull_request_tag)
    MainPush => ci_symbol_digest(sym: ci_cache_schedule_main_push_tag)
    Nightly => ci_symbol_digest(sym: ci_cache_schedule_nightly_tag)
  }
}


fn ci_command_cache_digest(c: CiCommand) -> Hash {
  match c {
    LintCommand => ci_symbol_digest(sym: ci_cache_cmd_lint_tag)
    TestCommand => ci_symbol_digest(sym: ci_cache_cmd_test_tag)
    IgnoredTestCommand { test_name: name } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_cache_cmd_ignored_test_tag),
        b: ci_string_cache_digest(s: name)
      )
    LensCiCommand { required_lenses: lenses } =>
      fold_list(
        xs: lenses,
        empty: ci_symbol_digest(sym: ci_cache_cmd_lens_ci_tag),
        cons: fn(acc, lens) {
          combine_hash(a: acc, b: ci_lens_id_cache_digest(lens: lens))
        }
      )
    BootstrapStageCompile { produces: produces } =>
      combine_hash(
        a: combine_hash(
          a: ci_symbol_digest(sym: ci_cache_cmd_bootstrap_compile_tag),
          b: ci_symbol_digest(sym: produces)
        ),
        b: ci_bootstrap_plan_cache_digest()
      )
    V2BootstrapCompileCommand => ci_symbol_digest(sym: ci_cache_cmd_v2_bootstrap_tag)
    V3DeterminismCommand { profile: profile } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_cache_cmd_v3_determinism_tag),
        b: ci_build_profile_cache_digest(profile: profile)
      )
    V3SelfHostFixedPointCommand { profile: profile, schedule: schedule } =>
      combine_hash(
        a: combine_hash(
          a: ci_symbol_digest(sym: ci_cache_cmd_v3_self_host_tag),
          b: ci_build_profile_cache_digest(profile: profile)
        ),
        b: ci_schedule_policy_cache_digest(policy: schedule)
      )
    V4T15SelfHostFixedPointCommand => ci_symbol_digest(sym: ci_cache_cmd_v4_t15_self_host_tag)
    M1RustEmitProbeCommand => ci_symbol_digest(sym: ci_cache_cmd_m1_probe_tag)
    TestClaimCorpusEvalCommand { selection_fn: fn_name } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_cache_cmd_testclaim_corpus_eval_tag),
        b: ci_symbol_digest(sym: fn_name)
      )
  }
}


fn ci_job_cache_digest(j: CiJob) -> Hash {
  combine_hash(
    a: combine_hash(
      a: ci_symbol_digest(sym: j.id),
      b: ci_command_cache_digest(c: j.command)
    ),
    b: fold_list(
      xs: j.needs,
      empty: ci_symbol_digest(sym: ci_cache_jobs_empty_tag),
      cons: fn(acc, need) {
        combine_hash(a: acc, b: ci_symbol_digest(sym: need))
      }
    )
  )
}


fn ci_gate_cache_digest(g: CiGate) -> Hash {
  combine_hash(
    a: combine_hash(
      a: ci_symbol_digest(sym: g.id),
      b: ci_symbol_digest(sym: g.job)
    ),
    b: ci_gate_run_policy_cache_digest(policy: g.run_policy)
  )
}


// 🟡 gated — feature:T22-EVAL-CACHE-HASHES — bind IRT-4 / TASKS.md T-22 — dissolve-on: content_hash(Node projection of CiPipeline) replaces this hand-rolled coproduct digest fold; interim TestClaim pinned-evaluator cache authority only.
fn ci_pipeline_cache_digest(p: CiPipeline) -> Hash {
  combine_hash(
    a: fold_list(
      xs: p.jobs,
      empty: ci_symbol_digest(sym: ci_cache_jobs_empty_tag),
      cons: fn(acc, job) {
        combine_hash(a: acc, b: ci_job_cache_digest(j: job))
      }
    ),
    b: fold_list(
      xs: p.gates,
      empty: ci_symbol_digest(sym: ci_cache_gates_empty_tag),
      cons: fn(acc, gate) {
        combine_hash(a: acc, b: ci_gate_cache_digest(g: gate))
      }
    )
  )
}


fn test_claim_typed_input_ci_pipeline(
  evaluator_input: CiPipeline,
  evaluator_pin: Symbol
) -> TestClaimTypedInput<CiPipeline> {
  TestClaimTypedInput {
    evaluator_input: evaluator_input,
    evaluator_pin: evaluator_pin
  }
}


fn ci_test_claim_evaluator_digest(input: TestClaimTypedInput<CiPipeline>) -> Hash {
  combine_hash(
    a: ci_symbol_digest(sym: input.evaluator_pin),
    b: ci_pipeline_cache_digest(p: input.evaluator_input)
  )
}


fn ci_test_claim_cache_interpretation_hash(subject: TestClaimEvalSubject<CiPipeline>) -> Hash {
  combine_hash(
    a: inferred_tree_digest(tree: subject.tree),
    b: combine_hash(
      a: test_claim_interpretation_cache_digest(context: subject.context),
      b: ci_test_claim_evaluator_digest(input: subject.input)
    )
  )
}


fn test_claim_cache_key_interpretation_hash_ci_pipeline(key: TestClaimCacheKey<CiPipeline>) -> Hash {
  ci_test_claim_cache_interpretation_hash(subject: key.eval_subject)
}


fn test_claim_cache_receipt_pinned(subject: TestClaimEvalSubject<CiPipeline>) -> TestClaimCacheReceipt<CiPipeline> {
  TestClaimCacheReceipt {
    key: TestClaimCacheKey {
      eval_subject: subject
    }
  }
}


fn ci_pipeline_well_formed(p: CiPipeline) -> Outcome<CiPipeline> {
  if ci_all_job_ids_unique(jobs: p.jobs) {
    if ci_all_gate_ids_unique(gates: p.gates) {
      if ci_all_needs_resolve(jobs: p.jobs) {
        if ci_all_gate_jobs_resolve(gates: p.gates, jobs: p.jobs) {
          if ci_all_gate_run_policies_resolve(gates: p.gates, jobs: p.jobs) {
            if ci_acyclic(jobs: p.jobs) {
              if ci_all_commands_authority_ok(jobs: p.jobs) {
                Accepted { value: p, diagnostics: None }
              } else {
                Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_bootstrap_authority_violation)) }
              }
            } else {
              Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dependency_cycle)) }
            }
          } else {
            Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
          }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
      }
    } else {
      Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_gate_id)) }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_job_id)) }
  }
}


fn test_claim_in_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}


fn ci_select_from_rerun_nodes(roster: List<TestClaim>, rerun: RerunNodeSet) -> List<TestClaim> {
  match rerun {
    RerunNodeSetProduced { nodes: nodes } =>
      filter(
        xs: roster,
        predicate: fn(claim) {
          test_claim_ci_selection_fail_closed(c: claim)
            || test_claim_in_rerun_frontier(claim: claim, frontier: nodes)
        }
      )
    RerunNodeSetFailClosed { evidence: _ } => roster
  }
}


fn ci_select_from_affected_set(roster: List<TestClaim>, affected: AffectedSet) -> List<TestClaim> {
  ci_select_from_rerun_nodes(
    roster: roster,
    rerun: affected_set_rerun_nodes(affected_set_value: affected)
  )
}


fn ci_repo_path_has_prefix(path: RepoPath, prefix: RepoPath) -> Bool {
  is_prefix_of(prefix: prefix, xs: path, eq: fn(left, right) { left == right })
}


fn ci_changed_path_affects_v2(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v2/")
    || changed == "Cargo.toml"
    || changed == "Cargo.lock"
}


fn ci_changed_path_affects_v3(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v3/")
    || ci_repo_path_has_prefix(path: changed, prefix: "dsl/")
}


fn ci_changed_path_affects_v4(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v4/")
    || ci_repo_path_has_prefix(path: changed, prefix: "fixtures/v4-mvp1/")
    || changed == "scripts/v4-mvp1-e2e-gate.sh"
    || changed == "scripts/v4-m1-rust-emit-probe.sh"
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-mvp1")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-m1")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-testclaim-")
    || ci_repo_path_has_prefix(path: changed, prefix: "dsl/std/")
    || changed == "Cargo.toml"
    || changed == "Cargo.lock"
}


fn ci_changed_path_affects_workflow_policy(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: ".github/workflows/")
    || changed == "src/v4/workflow/ci.dag"
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/workflow/ci/")
    || ci_repo_path_has_prefix(path: changed, prefix: "tools/ci_affected_components")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/check-workflow-path-regex-inventory")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/workflow-path-regex-forbidden-substrings")
}


fn ci_component_affected_fail_closed() -> CiComponentAffected {
  CiComponentAffected {
    v2: true
    v3: true
    v4: true
    workflow_policy: true
  }
}


fn ci_component_affected_from_git_diff(git_diff: GitDiffNameOnly) -> CiComponentAffected {
  CiComponentAffected {
    v2: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v2),
    v3: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v3),
    v4: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v4),
    workflow_policy: any(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_affects_workflow_policy
    )
  }
}


fn ci_component_affected_from_git_diff_read(outcome: Outcome<GitDiffNameOnly>) -> CiComponentAffected {
  match outcome {
    Accepted { value: git_diff, diagnostics: _ } =>
      ci_component_affected_from_git_diff(git_diff: git_diff)
    Rejected { diagnostics: _ } => ci_component_affected_fail_closed()
  }
}


fn ci_component_affected_is_fail_closed(affected: CiComponentAffected) -> Bool {
  affected.v2
    && affected.v3
    && affected.v4
    && affected.workflow_policy
}


fn ci_component_mask_intersects(mask: CiComponentAffected, affected: CiComponentAffected) -> Bool {
  (mask.v2 && affected.v2)
    || (mask.v3 && affected.v3)
    || (mask.v4 && affected.v4)
    || (mask.workflow_policy && affected.workflow_policy)
}


fn ci_job_component_mask(j: CiJob) -> CiComponentAffected {
  match j.command {
    V2BootstrapCompileCommand =>
      CiComponentAffected {
        v2: true
        v3: false
        v4: false
        workflow_policy: false
      }
    BootstrapStageCompile { produces: _ } =>
      CiComponentAffected {
        v2: true
        v3: false
        v4: true
        workflow_policy: false
      }
    V3DeterminismCommand { profile: _ } =>
      CiComponentAffected {
        v2: false
        v3: true
        v4: false
        workflow_policy: false
      }
    V3SelfHostFixedPointCommand { profile: _, schedule: _ } =>
      CiComponentAffected {
        v2: false
        v3: true
        v4: false
        workflow_policy: false
      }
    LensCiCommand { required_lenses: _ } =>
      CiComponentAffected {
        v2: false
        v3: true
        v4: true
        workflow_policy: true
      }
    V4T15SelfHostFixedPointCommand =>
      CiComponentAffected {
        v2: false
        v3: true
        v4: true
        workflow_policy: true
      }
    M1RustEmitProbeCommand =>
      CiComponentAffected {
        v2: false
        v3: false
        v4: true
        workflow_policy: false
      }
    TestClaimCorpusEvalCommand { selection_fn: _ } =>
      CiComponentAffected {
        v2: false
        v3: false
        v4: true
        workflow_policy: true
      }
    LintCommand => ci_component_affected_fail_closed()
    TestCommand => ci_component_affected_fail_closed()
    IgnoredTestCommand { test_name: _ } => ci_component_affected_fail_closed()
  }
}


fn ci_v3_tier0_scheduled(affected: CiComponentAffected, schedule: CiSchedulePolicy) -> Bool {
  affected.v3 || schedule == MainPush
}


fn ci_v3_self_host_fixed_point_scheduled(
  affected: CiComponentAffected,
  schedule: CiSchedulePolicy
) -> Bool {
  schedule == MainPush && ci_v3_tier0_scheduled(affected: affected, schedule: schedule)
}


fn ci_job_scheduled_by_policy(
  j: CiJob,
  affected: CiComponentAffected,
  schedule: CiSchedulePolicy
) -> Bool {
  match j.command {
    V3DeterminismCommand { profile: _ } =>
      ci_v3_tier0_scheduled(affected: affected, schedule: schedule)
    V3SelfHostFixedPointCommand { profile: _, schedule: cmd_schedule } =>
      ci_v3_self_host_fixed_point_scheduled(affected: affected, schedule: schedule)
        && schedule == cmd_schedule
    _ => false
  }
}


fn ci_job_selected_by_affected(
  j: CiJob,
  affected: CiComponentAffected,
  schedule: CiSchedulePolicy
) -> Bool {
  if ci_component_affected_is_fail_closed(affected: affected) {
    true
  } else {
    ci_component_mask_intersects(mask: ci_job_component_mask(j: j), affected: affected)
      || ci_job_scheduled_by_policy(j: j, affected: affected, schedule: schedule)
  }
}


fn ci_jobs_matching_ids(jobs: List[CiJob], ids: List[Symbol]) -> List[CiJob] {
  filter(xs: jobs, predicate: fn(j) { ci_member(s: j.id, ids: ids) })
}


fn ci_collect_needs_for_ids(ids: List[Symbol], jobs: List[CiJob]) -> List[Symbol] {
  fold(ids, init: [], f: fn(acc, id) {
    concat(acc, ci_job_needs(id: id, jobs: jobs))
  })
}


fn ci_merge_jobs_unique(acc: List[CiJob], more: List[CiJob]) -> List[CiJob] {
  fold(more, init: acc, f: fn(acc2, j) {
    if ci_member(s: j.id, ids: ci_job_ids(jobs: acc2)) {
      acc2
    } else {
      concat(acc2, [j])
    }
  })
}


fn ci_select_ci_jobs_needs_closure(jobs: List[CiJob], selected: List[CiJob]) -> List[CiJob] {
  let selected_ids = ci_job_ids(jobs: selected)
  let need_ids = ci_collect_needs_for_ids(ids: selected_ids, jobs: jobs)
  let missing_ids = filter(
    xs: need_ids,
    predicate: fn(n) { !ci_member(s: n, ids: selected_ids) }
  )
  if length(missing_ids) == 0 {
    selected
  } else {
    let added = ci_jobs_matching_ids(jobs: jobs, ids: missing_ids)
    ci_select_ci_jobs_needs_closure(
      jobs: jobs,
      selected: ci_merge_jobs_unique(acc: selected, more: added)
    )
  }
}


fn ci_select_ci_jobs_from_affected_set(
  jobs: List[CiJob],
  affected: CiComponentAffected,
  schedule: CiSchedulePolicy
) -> List[CiJob] {
  let initial = filter(
    xs: jobs,
    predicate: fn(j) {
      ci_job_selected_by_affected(j: j, affected: affected, schedule: schedule)
    }
  )
  ci_select_ci_jobs_needs_closure(jobs: jobs, selected: initial)
}


fn ci_int_positive(n: Int) -> Bool {
  n >= 1
}


fn ci_runner_pool_capacity_valid(pool: SelfHostedRunnerPool) -> Bool {
  ci_int_positive(n: pool.core_count)
    && ci_int_positive(n: pool.runner_count)
    && ci_int_positive(n: pool.jobserver_token_cap)
}


fn ci_runner_pool_fleet_capacities_valid() -> Bool {
  for_all(xs: ci_self_hosted_runner_pools, predicate: ci_runner_pool_capacity_valid)
}


// RULING-1: 🟢 operator fact — M1 rust-emit probe `cargo check --jobs` cap (operator 2026-05-28).
// Wave-0: explicit constant, not fleet-derived (jobserver÷runner allocation rule unpublished).
// ci_srv1_pool/ci_srv2_pool retain host capacity facts for YamlStatic projection follow-on (T-24/#98).
data m1_probe_cargo_check_jobs: Int = 4
