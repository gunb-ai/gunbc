}

// 🟡 gated — live-workflow projection interim (docs/modeling-discipline.md Practice 2/10) — feature:project-github-actions-landed — consumer:CiLiveWorkflowStepSignal strict env projection — bind src/v4/TASKS.md T-24 — dissolve-on-arrival: emitted/projected GitHub Actions workflow reads typed step env from `ci_pipeline`/command policy rows and this bridge carrier is deleted; forbidden: encoding absent env bindings as empty strings.
type StrictEnvBinding
  = NoStrictEnvBinding
  | StrictEnvBinding { var: String, value: String }

// 🟡 gated — live-workflow projection interim (docs/r3-program-plan.md gates #98/#100; docs/modeling-discipline.md Practice 10) — feature:project-github-actions-landed — consumer:v4.workflow.ci m1_ci_live_workflow_signal — bind src/v4/TASKS.md T-24 — dissolve-on-arrival: emitted/projected GitHub Actions workflow reads `ci_pipeline`/`M1RustEmitProbeCommand` directly and `m1_ci_live_workflow_signal` is deleted; forbidden: adding M1 probe step facts outside `ci_pipeline` + this binding.
type CiLiveWorkflowStepSignal {
  binding_smoke_step_name: String
  step_name: String
  script_path: String
  // GitHub Actions step transport policy. `false` means the script step itself
  // must execute successfully; it does not imply rustc residuals fail the gate.
  non_blocking: Bool
  timeout_minutes: Int
  strict_env_binding: StrictEnvBinding
}

type M1RustEmitProbePolicy {
  emit_preconditions_block_required_path: Bool
  rustc_residuals_block_required_path: Bool
}

type M1CiLiveWorkflowSignal {
