// SG-7 dissolved: offset projection authority is v4.std.node `byte_offset_cache_key_projection_node` only.
fn ci_char_projection_node(c: Char) -> Node {
  if c < 0 || c > 255 {
    Node {
      kind: TypeNode { connective: Conj },
      children: [
        ci_named_edge(
          name: ci_projection_char_out_of_byte_limb_edge,
          target: ci_atom(sym: canonical_tag_byte_limb_out_of_range)
        ),
        ci_named_edge(
          name: ci_projection_char_offset_authority_edge,
          target: byte_offset_cache_key_projection_node(i: c)
        )
      ]
    }
  } else {
    byte_offset_cache_key_projection_node(i: c)
  }
}


fn ci_string_projection_node(s: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: s,
      empty: ci_empty_edges(),
      cons: fn(acc, ch) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: Positional, target: ci_char_projection_node(c: ch) }
        )
      }
    )
  }
}


fn ci_command_projection_node(c: CiCommand) -> Node {
  match c {
    LintCommand => ci_atom(sym: ci_cache_cmd_lint_tag)
    TestCommand => ci_atom(sym: ci_cache_cmd_test_tag)
    IgnoredTestCommand { test_name: name } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(name: ci_projection_command_variant_edge, target: ci_atom(sym: ci_cache_cmd_ignored_test_tag)),
          ci_named_edge(name: ci_projection_command_test_name_edge, target: ci_string_projection_node(s: name))
        ]
      }
    LensCiCommand { required_lenses: lenses } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(
            name: ci_projection_command_lenses_edge,
            target: ci_lens_list_projection_node(lenses: lenses)
          )
        ]
      }
    BootstrapStageCompile { produces: produces } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(name: ci_projection_command_produces_edge, target: ci_atom(sym: produces)),
          ci_named_edge(
            name: ci_projection_bootstrap_plan_outcome_edge,
            target: ci_bootstrap_plan_projection_node()
          )
        ]
      }
    V2BootstrapCompileCommand => ci_atom(sym: ci_cache_cmd_v2_bootstrap_tag)
    V3DeterminismCommand { profile: profile } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(
            name: ci_projection_command_variant_edge,
            target: ci_atom(sym: ci_cache_cmd_v3_determinism_tag)
          ),
          ci_named_edge(
            name: ci_projection_command_profile_edge,
            target: ci_build_profile_projection_node(profile: profile)
          )
        ]
      }
    V3SelfHostFixedPointCommand { profile: profile, schedule: schedule } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(
            name: ci_projection_command_variant_edge,
            target: ci_atom(sym: ci_cache_cmd_v3_self_host_tag)
          ),
          ci_named_edge(
            name: ci_projection_command_profile_edge,
            target: ci_build_profile_projection_node(profile: profile)
          ),
          ci_named_edge(
            name: ci_projection_command_schedule_edge,
            target: ci_schedule_policy_projection_node(policy: schedule)
          )
        ]
      }
    V4T15SelfHostFixedPointCommand => ci_atom(sym: ci_cache_cmd_v4_t15_self_host_tag)
    M1RustEmitProbeCommand => ci_atom(sym: ci_cache_cmd_m1_probe_tag)
    LeafModelGoVerifyCommand => ci_atom(sym: ci_cache_cmd_leaf_model_go_verify_tag)
    LensOwnershipFamilyEvalCommand { verdict_surface: surface } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(
            name: ci_projection_command_variant_edge,
            target: ci_atom(sym: ci_cache_cmd_lens_ownership_family_eval_tag)
          ),
          ci_named_edge(
            name: ci_projection_command_verdict_surface_edge,
            target: ci_lens_ownership_family_verdict_surface_projection_node(surface: surface)
          )
        ]
      }
    TestClaimCorpusEvalCommand {
      selection_fn: fn_name,
      verdict_surface: surface
    } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(name: ci_projection_command_selection_fn_edge, target: ci_atom(sym: fn_name)),
          ci_named_edge(
            name: ci_projection_command_verdict_surface_edge,
            target: ci_testclaim_corpus_verdict_surface_projection_node(surface: surface)
          )
        ]
      }
    SourceAuthorityReceiptEvalCommand { claims } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          ci_named_edge(
            name: ci_projection_command_variant_edge,
            target: ci_atom(sym: ci_cache_cmd_source_authority_receipt_eval_tag)
          ),
          ci_named_edge(
            name: ci_projection_command_claim_ids_edge,
            target: ci_symbol_list_projection_node(xs: claims)
          )
        ]
      }
    Phase1NatSemiringRungGateCommand => ci_atom(sym: ci_cache_cmd_phase1_nat_semiring_rung_gate_tag)
  }
}


