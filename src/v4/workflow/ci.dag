// RULING-1: 🟢 pretty-much-done — Tier-0 CI build profile (bankruptcy I2–I4; docs/design-ci-bankruptcy-rebuild.md §2).
type CiBuildProfile = Smoke | Release | FixedPointMatrix

// RULING-1: 🟢 pretty-much-done — when a CiJob runs relative to host push policy (bankruptcy I3/I4 scheduling).
type CiSchedulePolicy = PullRequest | MainPush | Nightly

// 🟡 coproduct dissolution — LB-P4-3213
type CiCommand
  = LintCommand
  | TestCommand
  | IgnoredTestCommand { test_name: String }
  | LensCiCommand { required_lenses: List<LensIdV0> }
  | BootstrapStageCompile { produces: Symbol }
  | V2BootstrapCompileCommand
  | V3DeterminismCommand { profile: CiBuildProfile }
  | V3SelfHostFixedPointCommand { profile: CiBuildProfile, schedule: CiSchedulePolicy }
  | V4T15SelfHostFixedPointCommand
  | M1RustEmitProbeCommand
  | LeafModelGoVerifyCommand
  // 🟡 gated — feature:t38-testclaim-corpus-eval — bind src/v4/TASKS.md T-38 + docs/planning/v4-p5-structural-bridge-replacement-worksheet-2026-05-30.md §1.4 — structural-slice CLOSED: shell bridge deleted; positive-Y `ci_upsert_testclaim_corpus_eval_*` sole structural authority; selection_fn must equal ci_testclaim_corpus_selection_fn (ci_select_from_affected_set); ci_select_from_affected_set narrows roster to content_hash frontier (IRT-1) — forbidden: bypassing narrowing to run full corpus unconditionally. Forward (T-38-PR2): amend when modeled runner evaluates manual/*.dag via T-22 eval and emits structured TestClaimRun verdicts in CI.
  | TestClaimCorpusEvalCommand { selection_fn: Symbol }
  // 🟡 gated — feature:phase1-nat-semiring-rung-gate — bind https://github.com/gunb-ai/gunbc/pull/3946 §2.5 (Ladder/Fixture Manager spec, lands as docs/planning/v4-ladder-rung-specs-2026-05-30.md on merge) — dissolve-on-arrival: delete scripts/v4-phase1-nat-semiring-rung-gate.sh and the paired CI step when TestClaimRun verdicts evaluate phase1_nat_semiring_rung_0_to_2_roster (v4.test.claim.nat_semiring.rung_0_to_2_three_targets) and emit PROVEN rung0/rung1/rung2 receipts; until then the host transport carries the §2.4 verdict matrix. Authority: Ladder/Fixture Manager (PR #3938 §11.1 lane 2). Forbidden: repurposing M1RustEmitProbeCommand for fixture-scoped gates (corpus-wide diagnostic, not fixture×rung) or repurposing TestClaimCorpusEvalCommand (full-corpus T-38, narrows by affected-set not by fixture roster).
  | Phase1NatSemiringRungGateCommand

type CiJob {
  id: Symbol
  command: CiCommand
  needs: List<Symbol>
}

type CiGate {
  id: Symbol
  job: Symbol
  run_policy: CiGateRunPolicy
}

// 🟡 coproduct dissolution — feature:project-github-actions-run-policy (docs/r3-program-plan.md gates #98/#100) — dissolve-on-arrival: emitted/projected GitHub Actions workflow reads `CiGate.run_policy` directly and this interim live-projection policy carrier is deleted; forbidden: adding GitHub Actions-only gate conditions outside `CiGate.run_policy`.
type CiGateRunPolicy
  = Always
  | RequiresJobAttempt { job: Symbol }

type CiPipeline {
  jobs: List<CiJob>
  gates: List<CiGate>
}

// ── Phase 1.5 UPSERT step substrate (v4-ci-schema-worksheet-2026-05-30 §1.2–1.4) ─────────────
// Generic `Upsert<T>` lives in `dsl/std/patterns.dag` (#3981). CI specialization adds typed
// verify-first inputs; cache authority is `content_hash` of the full step projection — never a
// `cache_key` payload on the step type (Practice 10 row 5 / P2).

// Fields mirror §1.2 `CiUpsertStep<T> = Upsert<T> { inputs, verify, create, resolve }`.
// Parser does not yet accept generic base-type extension (`= Upsert<T> { … }`); consume via
// v4.std.patterns `Upsert<T>` field alignment until ROADMAP generic record extension lands (Phase 1.4 probe 4).
// `ResolveExpr<T>` matches Phase 1.4 `dsl/std/patterns.dag` (`type ResolveExpr<T> = Node`).
// `payload_type` mirrors `T` in cache projection until `ResolveExpr<T>` is load-bearing (P1.5-PARSER).
// Forbidden: parallel `Symbol` brand that can drift from the type parameter; must be canonical Node carrier.
type CiUpsertStep<T> {
  inputs: List<UpsertInputRef>
  verify: VerifyCheck
  create: CreateAction
  resolve: ResolveExpr<T>
  payload_type: Node
}

// Phase 1.5 parser bridge — v3/v4 surface parse rejects `CiUpsertStep<Symbol> { … }` record literals in `data`.
type CiUpsertStepSymbol = CiUpsertStep<Symbol>

// Structural consumer of `v4.std.patterns.Upsert<T>`: field-compatible with generic Upsert (verify/create/resolve).
// Record constructor `Upsert<T> { … }` is not yet supported by v4 `gunbc compile` (P1.5-PARSER).

// 🟡 coproduct dissolution — feature:ci-upsert-step-migration — bind v4-ci-schema-worksheet Phase 2 — dissolve-on-arrival: per-step `UpsertInputRef` rows replace coarse component gates; forbidden: `List<Symbol>` / `FileGlob` inputs.
type UpsertInputRef
  = FileSet { selector: FileSetSelector }
  | SubstrateNodeSet { selector: NodeQuery }
  // 🟡 staged — `ports: List<Symbol>` until canonical lens port carrier (`LensPortId` / `Port`) lands.
  | LensOutputRef { lens: LensIdV0, ports: List<Symbol> }
  | TestClaimRef { claim_id: Symbol }
  | UpstreamUpsert { step_id: CiStepId }

type FileSetSelector {
  root: RepositoryRoot
  pattern: GlobPattern
}

// W2.3 Bucket A — repo-relative `FileSet` inputs (authority: `ci_changed_path_affects_*` mirrors).
data ci_repository_root: RepositoryRoot = ""

fn ci_glob_pattern_one(segment: GlobSegment) -> GlobPattern {
  GlobPattern { segments: [segment] }
}

fn ci_upsert_file_set_input(segment: GlobSegment) -> UpsertInputRef {
  FileSet {
    selector: FileSetSelector {
      root: ci_repository_root
      pattern: ci_glob_pattern_one(segment: segment)
    }
  }
}

// W2.3 Bucket C — `LensOutputRef` per `LensCiCommand.required_lenses` (`ports` empty until port substrate).
fn ci_upsert_lens_output_ref_input(lens: LensIdV0) -> UpsertInputRef {
  LensOutputRef { lens: lens, ports: [] }
}

fn ci_upsert_lens_inputs_from_required_lenses(lenses: List<LensIdV0>) -> List<UpsertInputRef> {
  fold_list(
    xs: lenses,
    empty: ci_empty_upsert_input_refs(),
    cons: fn(acc, lens) {
      list_snoc_item(xs: acc, item: ci_upsert_lens_output_ref_input(lens: lens))
    }
  )
}

fn ci_step_id_list_append_items(base: List<CiStepId>, more: List<CiStepId>) -> List<CiStepId> {
  fold_list(
    xs: more,
    empty: base,
    cons: fn(acc, step_id) {
      list_snoc_item(xs: acc, item: step_id)
    }
  )
}

// W2.3 Bucket B — `TestClaimRef` per claim id (`ci_testclaim_corpus_eval_claim_ids` authority).
fn ci_upsert_test_claim_ref_input(claim_id: Symbol) -> UpsertInputRef {
  TestClaimRef { claim_id: claim_id }
}

// W2.3 Bucket E — `UpstreamUpsert` over landed job shadow `CiStepId`s (compiler-spine shadow registry §6).
fn ci_upsert_upstream_input(step_id: CiStepId) -> UpsertInputRef {
  UpstreamUpsert { step_id: step_id }
}

fn ci_upsert_upstream_job_input(job: CiJobId) -> UpsertInputRef {
  ci_upsert_upstream_input(step_id: JobStep { job: job, step: job })
}

type CiJobId = Symbol
type CiGateId = Symbol
type CiCommandId = Symbol

// 🟡 coproduct dissolution — feature:ci-upsert-step-migration — bind v4-ci-schema-worksheet Phase 2 — dissolve-on-arrival: closed `JobStep` | `GateStep` identity on every pipeline row; forbidden: optional gate by comment.
type CiStepId
  = JobStep { job: CiJobId, step: CiCommandId }
  | GateStep { job: CiJobId, gate: CiGateId }

// 🟡 branded nominal — dissolve-on: std.types brand substrate when v4 imports it.
