}


fn ci_upsert_steps_slice_step_ids(rows: List<CiUpsertStepRow>) -> List<CiStepId> {
  fold(rows, init: ci_empty_step_ids(), f: fn(acc, row) {
    list_snoc_item(xs: acc, item: row.step_id)
  })
}


fn ci_upsert_row_inputs_for_step_id(step_id: CiStepId, rows: List<CiUpsertStepRow>) -> List<UpsertInputRef> {
  fold(
    rows,
    init: CiUpsertRowInputsLookup { found: false, inputs: [] },
    f: fn(acc, row) {
      if acc.found {
        acc
      } else if ci_step_id_eq(left: step_id, right: row.step_id) {
        CiUpsertRowInputsLookup { found: true, inputs: row.inputs }
      } else {
        acc
      }
    }
  ).inputs
}


fn ci_upsert_row_cache_digest_for_step_id(step_id: CiStepId, rows: List<CiUpsertStepRow>) -> Hash {
  let fallback = content_hash(n: ci_step_id_projection_node(step_id: step_id))
  fold(
    rows,
    init: CiUpsertRowCacheDigestLookup { found: false, digest: fallback },
    f: fn(acc, row) {
      if acc.found {
        acc
      } else if ci_step_id_eq(left: step_id, right: row.step_id) {
        CiUpsertRowCacheDigestLookup {
          found: true,
          digest: ci_upsert_step_symbol_cache_digest(step: row.step)
        }
      } else {
        acc
      }
    }
  ).digest
}


fn ci_job_shadow_step_id(ci_job: CiJob) -> CiStepId {
  JobStep { job: ci_job.id, step: ci_job.id }
}


fn ci_gate_shadow_step_id(ci_gate: CiGate) -> CiStepId {
  GateStep { job: ci_gate.job, gate: ci_gate.id }
}


// 🟡 shadow-only — one `JobStep` per `CiJob` (`job.id` as step placeholder) until command-level `CiStepId` migration.
fn ci_job_step_ids_shadow(jobs: List<CiJob>) -> List<CiStepId> {
  fold_list(
    xs: jobs,
    empty: ci_empty_step_ids(),
    cons: fn(acc, ci_job) {
      list_snoc_item(xs: acc, item: ci_job_shadow_step_id(ci_job: ci_job))
    }
  )
}


fn ci_pipeline_step_ids_shadow(p: CiPipeline) -> List<CiStepId> {
  fold(
    p.gates,
    init: ci_job_step_ids_shadow(jobs: p.jobs),
    f: fn(acc, ci_gate) {
      list_snoc_item(xs: acc, item: ci_gate_shadow_step_id(ci_gate: ci_gate))
    }
  )
}


// 🟡 gated — predicate-dissolution interim (Practice 10) — feature:ci-selection-receipt-shadow — consumer:ci_selection_receipt_shadow_rows — bind docs/planning/compiler-spine-ci-selection-receipt-shadow-2026-05-30.md §4 fail-closed — dissolve-on-arrival: superset selection reads `AffectedSet` coproduct directly at call site (no Bool projection); forbidden: permanent `AffectedSet` → Bool classifier beside T-21 lens authority.
fn ci_affected_set_is_fail_closed(affected: AffectedSet) -> Bool {
  match affected {
    AffectedSetFailClosed { changes: _, evidence: _ } => true
    AffectedSetProduced { changes: _, affected: _, exclusions: _, restricted_to: _ } => false
  }
}


fn ci_carveout_reason_for_step(step_id: CiStepId, carveouts: List<CiCarveout>) -> Symbol {
  fold(
    carveouts,
    init: ci_selection_shadow_reason,
    f: fn(acc, carveout) {
      if ci_step_id_eq(left: step_id, right: carveout.step_id) {
        carveout.reason_code
      } else {
        acc
      }
    }
  )
}


fn ci_step_in_carveouts(step_id: CiStepId, carveouts: List<CiCarveout>) -> Bool {
  fold(
    carveouts,
    init: false,
    f: fn(found, entry) {
      if found {
        true
      } else {
        ci_step_id_eq(left: step_id, right: entry.step_id)
      }
    }
  )
}


// W1.5 shadow bridge — segment literal → `ci_changed_path_affects_*` (owner: compiler-spine-ci-selection-receipt-shadow §6; dissolve: Q-Regex-Primitive).
fn ci_glob_segment_matches_changed_path(segment: GlobSegment, path: RepoPath) -> Bool {
  if segment == "src/v2/**" {
    ci_changed_path_affects_v2(changed: path)
  } else if segment == "src/v3/**" {
    ci_changed_path_affects_v3(changed: path)
  } else if segment == "dsl/**" {
    ci_repo_path_has_prefix(path: path, prefix: "dsl/")
  } else if segment == "src/v4/**" {
    ci_changed_path_affects_v4(changed: path)
  } else if segment == "scripts/**" {
    ci_repo_path_has_prefix(path: path, prefix: "scripts/")
  } else if segment == "Cargo.toml" {
    path == "Cargo.toml"
  } else if segment == "Cargo.lock" {
    path == "Cargo.lock"
  } else if segment == "scripts/v4-m1*" {
    ci_repo_path_has_prefix(path: path, prefix: "scripts/v4-m1")
  } else if segment == "scripts/v4-leaf-model-go-*-verify.sh" {
    ci_repo_path_has_prefix(path: path, prefix: "scripts/v4-leaf-model-go-")
  } else if segment == "scripts/v4-phase1-nat-semiring*" {
    ci_repo_path_has_prefix(path: path, prefix: "scripts/v4-phase1-nat-semiring")
  } else if segment == "src/v4/extdeps/languages/go.dag" {
    path == "src/v4/extdeps/languages/go.dag"
  } else if segment == "src/v4/lens/leaf_model_verification.dag" {
    path == "src/v4/lens/leaf_model_verification.dag"
  } else if segment == "src/v4/std/leaf_model_verification.dag" {
    path == "src/v4/std/leaf_model_verification.dag"
  } else if segment == "src/v4/test/claim/language_model/go_*.dag" {
    ci_repo_path_has_prefix(path: path, prefix: "src/v4/test/claim/language_model/go_")
  } else if segment == "src/v3/compiler/tests/boundary/v4_leaf_model_go_r1_r2_r3_external_test.rs" {
    path == "src/v3/compiler/tests/boundary/v4_leaf_model_go_r1_r2_r3_external_test.rs"
  } else if segment == "src/v4/test/claim/manual/**" {
    ci_repo_path_has_prefix(path: path, prefix: "src/v4/test/claim/manual/")
  } else if segment == "src/v4/test/claim/workflow/testclaim_corpus_runner.dag" {
    path == "src/v4/test/claim/workflow/testclaim_corpus_runner.dag"
  } else if segment == "scripts/v4-testclaim-*" {
    ci_repo_path_has_prefix(path: path, prefix: "scripts/v4-testclaim-")
  } else {
    false
  }
}


fn ci_glob_segment_matches_any_changed_path(
  segment: GlobSegment,
  paths: List<RepoPath>
) -> Bool {
  any(xs: paths, predicate: fn(path) {
    ci_glob_segment_matches_changed_path(segment: segment, path: path)
  })
}


fn ci_file_set_selector_primary_segment(selector: FileSetSelector) -> GlobSegment {
  fold(selector.pattern.segments, init: "", f: fn(acc, segment) {
    if acc == "" {
      segment
    } else {
      acc
    }
  })
}


fn ci_upsert_file_set_input_touches_git_diff(
  selector: FileSetSelector,
  git_diff: GitDiffNameOnly
) -> Bool {
  ci_glob_segment_matches_any_changed_path(
    segment: ci_file_set_selector_primary_segment(selector: selector),
    paths: git_diff.changed_paths
  )
}


fn ci_upsert_input_ref_touches_git_diff(
  input_ref: UpsertInputRef,
  git_diff: GitDiffNameOnly,
  affected: AffectedSet
) -> Bool {
  match input_ref {
    FileSet { selector: selector } =>
      ci_upsert_file_set_input_touches_git_diff(selector: selector, git_diff: git_diff)
    TestClaimRef { claim_id: _ } =>
      ci_glob_segment_matches_any_changed_path(
        segment: "src/v4/test/claim/manual/**",
        paths: git_diff.changed_paths
      )
        || ci_glob_segment_matches_any_changed_path(
          segment: "scripts/v4-testclaim-*",
          paths: git_diff.changed_paths
        )
    LensOutputRef { lens: _, ports: _ } =>
      ci_glob_segment_matches_any_changed_path(segment: "src/v4/**", paths: git_diff.changed_paths)
        || ci_glob_segment_matches_any_changed_path(segment: "dsl/std/**", paths: git_diff.changed_paths)
    SubstrateNodeSet { selector: _ } => ci_affected_set_is_fail_closed(affected: affected)
    UpstreamUpsert { step_id: _ } => false
  }
}


fn ci_upsert_inputs_intersect_git_diff(
  inputs: List<UpsertInputRef>,
  git_diff: GitDiffNameOnly,
  affected: AffectedSet
) -> Bool {
  if ci_affected_set_is_fail_closed(affected: affected) {
    true
  } else {
    any(xs: inputs, predicate: fn(input_ref) {
      ci_upsert_input_ref_touches_git_diff(
        input_ref: input_ref,
        git_diff: git_diff,
        affected: affected
      )
    })
  }
}


fn ci_upsert_step_row_in_registry(step_id: CiStepId, rows: List<CiUpsertStepRow>) -> Bool {
  fold(
    rows,
    init: false,
    f: fn(found, row) {
      if found {
        true
      } else {
        ci_step_id_eq(left: step_id, right: row.step_id)
      }
    }
  )
}


// Phase 2.1 interim — `affected_intersection` stays [] until T-21 wires UpsertInputRef → `AffectedDependency` evidence.
fn ci_selection_decision_for_step(
  step_id: CiStepId,
  affected: AffectedSet,
  git_diff: GitDiffNameOnly,
  carveouts: List<CiCarveout>,
  registry: List<CiUpsertStepRow>,
  superset: Bool
) -> CiStepSelection {
  let inputs = ci_upsert_row_inputs_for_step_id(step_id: step_id, rows: registry)
  let digest = ci_upsert_row_cache_digest_for_step_id(step_id: step_id, rows: registry)
  if superset {
    CiStepSelection {
      step_id: step_id,
      inputs_consulted: inputs,
      affected_intersection: [],
      decision: Run,
      cache_digest: digest,
      reason: ci_receipt_inputs_fail_closed_reason
    }
  } else if ci_step_in_carveouts(step_id: step_id, carveouts: carveouts) {
    CiStepSelection {
      step_id: step_id,
      inputs_consulted: inputs,
      affected_intersection: [],
      decision: CarvedOut {
        carveout_reason: ci_carveout_reason_for_step(step_id: step_id, carveouts: carveouts)
      },
      cache_digest: digest,
      reason: ci_carveout_matched_reason
    }
  } else if ci_upsert_inputs_intersect_git_diff(
    inputs: inputs,
    git_diff: git_diff,
    affected: affected
  ) {
    CiStepSelection {
      step_id: step_id,
      inputs_consulted: inputs,
      affected_intersection: [],
      decision: Run,
      cache_digest: digest,
      reason: ci_shadow_git_diff_proxy_nonempty_reason
    }
  } else if ci_upsert_step_row_in_registry(step_id: step_id, rows: registry) {
    CiStepSelection {
      step_id: step_id,
      inputs_consulted: inputs,
      affected_intersection: [],
      decision: Skip,
      cache_digest: digest,
      reason: ci_shadow_git_diff_proxy_empty_skip_reason
    }
  } else {
    CiStepSelection {
      step_id: step_id,
      inputs_consulted: inputs,
      affected_intersection: [],
      decision: Run,
      cache_digest: digest,
      reason: ci_cache_digest_projection_fail_closed_reason
    }
  }
}


fn ci_selection_receipt_shadow_rows(
  pr: ChangeSet,
  affected: AffectedSet,
  git_diff: GitDiffNameOnly,
  pipeline: CiPipeline,
  carveouts: List<CiCarveout>,
  registry: List<CiUpsertStepRow>
) -> List<CiStepSelection> {
  let superset = ci_affected_set_is_fail_closed(affected: affected)
  fold_list(
    xs: ci_pipeline_step_ids_shadow(p: pipeline),
    empty: ci_empty_step_selections(),
    cons: fn(acc, step_id) {
      list_snoc_item(
        xs: acc,
        item: ci_selection_decision_for_step(
          step_id: step_id,
          affected: affected,
          git_diff: git_diff,
          carveouts: carveouts,
          registry: registry,
          superset: superset
        )
      )
    }
  )
}


fn ci_selection_receipt_mk(
  pr: ChangeSet,
  affected: AffectedSet,
  mode: CiSelectionMode,
  provenance: CiSelectionReceiptProvenance,
  decisions: List<CiStepSelection>,
  testclaim_decisions: List<CiTestClaimSelection>,
  testgen_slots: List<TestgenSlotSelection>,
  component_affected_comparison: CiComponentAffected
) -> CiSelectionReceipt {
  CiSelectionReceipt {
    pr: pr,
    affected: affected,
    mode: mode,
    provenance: provenance,
    decisions: decisions,
    testclaim_decisions: testclaim_decisions,
    testgen_slots: testgen_slots,
    component_affected_comparison: component_affected_comparison
  }
}


// ── Wave 3 §11.7.4 — CiSelectionReceipt claim projection (consumes #4178 runtime selection API) ──
fn ci_wave3_shadow_testclaim_selection_reason(
  claim: TestClaim,
  affected: AffectedSet,
  selected: Bool
) -> CiClaimSelectionReason {
  if ci_affected_set_is_fail_closed(affected: affected) {
    FailClosedSuperset
  } else {
    match affected_set_rerun_nodes(affected_set_value: affected) {
      RerunNodeSetFailClosed { evidence: _ } => FailClosedSuperset
      RerunNodeSetProduced { nodes: nodes } =>
        if length(xs: nodes) == 0 {
          if selected {
            FailClosedSuperset
          } else {
            AffectedFrontierEmpty
          }
        } else if selected {
          if test_claim_ci_selection_fail_closed(c: claim) {
            FailClosedSuperset
          } else {
            AffectedIntersectionNonempty
          }
        } else if test_claim_in_rerun_frontier(claim: claim, frontier: nodes) {
          ShadowObserveOnly
        } else {
          AffectedIntersectionEmpty
        }
    }
  }
}


fn ci_wave3_shadow_testclaim_selection_row(
  claim: TestClaim,
  affected: AffectedSet,
  selected_claims: List<TestClaim>
) -> CiTestClaimSelection {
  let selected = count_equal(xs: selected_claims, item: claim, eq: fn(left, right) { left == right }) != 0
  CiTestClaimSelection {
    anchor: test_claim_anchor(c: claim),
    label: test_claim_label(c: claim),
    coproduct_variant: test_claim_coproduct_variant(c: claim),
    claim_projection_hash: test_claim_claim_hash_digest(c: claim),
    selected: selected,
    reason: ci_wave3_shadow_testclaim_selection_reason(
      claim: claim,
      affected: affected,
      selected: selected
    )
  }
}


fn ci_wave3_shadow_testclaim_selection_rows(affected: AffectedSet) -> List<CiTestClaimSelection> {
  let selected = ci_wave3_shadow_testclaims_selected(affected: affected)
  fold(
    ci_wave3_shadow_claim_roster(),
    init: Empty,
    f: fn(acc, claim) {
      list_snoc_item(
        xs: acc,
        item: ci_wave3_shadow_testclaim_selection_row(
          claim: claim,
          affected: affected,
          selected_claims: selected
        )
      )
    }
  )
}


// W1.5 step-only shadow — `git_diff` is host transport for ChangeSet paths until T-21 wires RepoPath edits.
// Phase 1: provenance is always `FixtureReceipt` (empty claim/testgen rows). `LivePrGitDiff` is forbidden here;
// live PR receipts use `ci_selection_receipt_shadow_from_git_diff` (adhoc-331899f9-19a) with populated partitions.
fn ci_selection_receipt_shadow(
  pr: ChangeSet,
  affected: AffectedSet,
  git_diff: GitDiffNameOnly,
  pipeline: CiPipeline,
  carveouts: List<CiCarveout>,
  registry: List<CiUpsertStepRow>
) -> CiSelectionReceipt {
  ci_selection_receipt_mk(
    pr: pr,
    affected: affected,
    mode: Shadow,
    provenance: FixtureReceipt,
    decisions: ci_selection_receipt_shadow_rows(
      pr: pr,
      affected: affected,
      git_diff: git_diff,
      pipeline: pipeline,
      carveouts: carveouts,
      registry: registry
    ),
    testclaim_decisions: Empty,
    testgen_slots: Empty,
    component_affected_comparison: ci_component_affected_fail_closed()
  )
}


fn ci_step_selection_shadow_row(step_id: CiStepId) -> CiStepSelection {
  CiStepSelection {
    step_id: step_id,
    inputs_consulted: ci_upsert_row_inputs_for_step_id(step_id: step_id, rows: ci_upsert_steps),
    affected_intersection: [],
    decision: Run,
    cache_digest: ci_upsert_row_cache_digest_for_step_id(step_id: step_id, rows: ci_upsert_steps),
    reason: ci_selection_shadow_reason
  }
}


fn ci_step_selection_shadow_rows(step_ids: List<CiStepId>) -> List<CiStepSelection> {
  fold_list(
    xs: step_ids,
    empty: ci_empty_step_selections(),
    cons: fn(acc, sid) {
      list_snoc_item(xs: acc, item: ci_step_selection_shadow_row(step_id: sid))
    }
  )
}


// Shadow heartbeat only — proves receipt carrier shape; NOT dependency-selection evidence.
fn ci_selection_receipt_shadow_heartbeat(
  pr: ChangeSet,
  affected: AffectedSet,
  pipe: CiPipeline
) -> CiSelectionReceipt {
  ci_selection_receipt_mk(
    pr: pr,
    affected: affected,
    mode: Shadow,
    provenance: FixtureReceipt,
    decisions: ci_step_selection_shadow_rows(step_ids: ci_pipeline_step_ids_shadow(p: pipe)),
    testclaim_decisions: Empty,
    testgen_slots: Empty,
    component_affected_comparison: ci_component_affected_fail_closed()
  )
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature:ci-upsert-step-migration — bound target: W-T-10 exact structural equality / compiler-provided closed-sum equality — dissolve-on-arrival: replace `ci_step_id_eq` call sites with substrate closed-sum equality for `CiStepId` and delete this helper; forbidden: permanent per-variant equality table drift from `CiStepId`.
fn ci_step_id_eq(left: CiStepId, right: CiStepId) -> Bool {
  match left {
    JobStep { job: left_job, step: left_step } =>
      match right {
        JobStep { job: right_job, step: right_step } =>
          left_job == right_job && left_step == right_step
        GateStep { job: _, gate: _ } => false
      }
    GateStep { job: left_job, gate: left_gate } =>
      match right {
        GateStep { job: right_job, gate: right_gate } =>
          left_job == right_job && left_gate == right_gate
        JobStep { job: _, step: _ } => false
      }
  }
}


fn ci_step_selection_step_id(row: CiStepSelection) -> CiStepId {
  row.step_id
}


fn ci_step_selections_step_ids(decisions: List<CiStepSelection>) -> List<CiStepId> {
  fold_list(
    xs: decisions,
    empty: ci_empty_step_ids(),
    cons: fn(acc, row) {
      list_snoc_item(xs: acc, item: ci_step_selection_step_id(row: row))
    }
  )
}


fn ci_step_id_in_list(id: CiStepId, ids: List<CiStepId>) -> Bool {
  count_where(xs: ids, predicate: fn(candidate) {
    ci_step_id_eq(left: id, right: candidate)
  }) != 0
}


fn ci_step_ids_subset_of(xs: List<CiStepId>, universe: List<CiStepId>) -> Bool {
  for_all(xs: xs, predicate: fn(id) {
    ci_step_id_in_list(id: id, ids: universe)
  })
}


fn ci_step_id_list_ids_unique(xs: List<CiStepId>) -> Bool {
  length(xs: xs) == length(xs: unique(xs: xs, eq: ci_step_id_eq))
}


fn ci_step_id_lists_biject(left: List<CiStepId>, right: List<CiStepId>) -> Bool {
  length(xs: left) == length(xs: right)
    && ci_step_id_list_ids_unique(xs: left)
    && ci_step_id_list_ids_unique(xs: right)
    && ci_step_ids_subset_of(xs: left, universe: right)
    && ci_step_ids_subset_of(xs: right, universe: left)
}


fn ci_upsert_steps_registry_ids_unique(rows: List<CiUpsertStepRow>) -> Bool {
  let ids = ci_upsert_steps_slice_step_ids(rows: rows)
  length(xs: ids) == length(xs: rows)
    && length(xs: ids) == length(xs: unique(xs: ids, eq: ci_step_id_eq))
}


fn ci_upsert_steps_registry_matches_declared_slice(
  rows: List<CiUpsertStepRow>,
  slice: List<CiStepId>
) -> Bool {
  ci_step_id_lists_biject(
    left: ci_upsert_steps_slice_step_ids(rows: rows),
    right: slice
  )
}


fn ci_upsert_steps_slice_subset_of_pipeline_shadow(p: CiPipeline, slice: List<CiStepId>) -> Bool {
  ci_step_ids_subset_of(xs: slice, universe: ci_pipeline_step_ids_shadow(p: p))
}


// Out-of-scope steps remain in shadow universe but not in the Bucket A registry (§2.1 partial close).
fn ci_upsert_steps_slice_strict_subset_of_pipeline_shadow(p: CiPipeline, slice: List<CiStepId>) -> Bool {
  let shadow = ci_pipeline_step_ids_shadow(p: p)
  ci_step_ids_subset_of(xs: slice, universe: shadow)
    && length(xs: slice) != length(xs: shadow)
}


fn ci_step_id_lists_disjoint(left: List<CiStepId>, right: List<CiStepId>) -> Bool {
  for_all(xs: left, predicate: fn(id) {
    count_where(xs: right, predicate: fn(candidate) {
      ci_step_id_eq(left: id, right: candidate)
    }) == 0
  })
}


fn ci_upsert_steps_slice_partition_covers_pipeline_shadow(
  p: CiPipeline,
  slice: List<CiStepId>,
  out_of_scope: List<CiStepId>
) -> Bool {
  let shadow = ci_pipeline_step_ids_shadow(p: p)
  let partition = ci_step_id_list_append_items(base: slice, more: out_of_scope)
  ci_step_id_lists_biject(left: partition, right: shadow)
}


fn ci_upsert_steps_out_of_scope_disjoint_from_registry(
  rows: List<CiUpsertStepRow>,
  out_of_scope: List<CiStepId>
) -> Bool {
  let registry_ids = ci_upsert_steps_slice_step_ids(rows: rows)
  for_all(xs: out_of_scope, predicate: fn(id) {
    count_where(xs: registry_ids, predicate: fn(reg_id) {
      ci_step_id_eq(left: id, right: reg_id)
    }) == 0
  })
}


fn ci_upsert_step_row_job_shadow_step_id_ok_for_job(row: CiUpsertStepRow, ci_job: CiJob) -> Bool {
  ci_step_id_eq(left: row.step_id, right: ci_job_shadow_step_id(ci_job: ci_job))
}


fn ci_upsert_step_row_matches_some_job_shadow(row: CiUpsertStepRow, jobs: List<CiJob>) -> Bool {
  count_where(xs: jobs, predicate: fn(j) {
    ci_upsert_step_row_job_shadow_step_id_ok_for_job(row: row, ci_job: j)
  }) != 0
}


fn ci_upsert_rows_match_job_shadow_ids(rows: List<CiUpsertStepRow>, jobs: List<CiJob>) -> Bool {
  for_all(xs: rows, predicate: fn(row) {
    ci_upsert_step_row_matches_some_job_shadow(row: row, jobs: jobs)
  })
}


fn ci_upsert_step_row_gate_shadow_step_id_ok_for_gate(row: CiUpsertStepRow, ci_gate: CiGate) -> Bool {
  ci_step_id_eq(left: row.step_id, right: ci_gate_shadow_step_id(ci_gate: ci_gate))
}


fn ci_upsert_step_row_matches_some_gate_shadow(row: CiUpsertStepRow, gates: List<CiGate>) -> Bool {
  count_where(xs: gates, predicate: fn(g) {
    ci_upsert_step_row_gate_shadow_step_id_ok_for_gate(row: row, ci_gate: g)
  }) != 0
}


fn ci_upsert_step_row_matches_pipeline_shadow(row: CiUpsertStepRow, p: CiPipeline) -> Bool {
  ci_upsert_step_row_matches_some_job_shadow(row: row, jobs: p.jobs)
    || ci_upsert_step_row_matches_some_gate_shadow(row: row, gates: p.gates)
}


fn ci_upsert_rows_match_pipeline_shadow_ids(rows: List<CiUpsertStepRow>, p: CiPipeline) -> Bool {
  for_all(xs: rows, predicate: fn(row) {
    ci_upsert_step_row_matches_pipeline_shadow(row: row, p: p)
  })
}


fn ci_upsert_steps_slice_bijection_for_pipeline(p: CiPipeline, rows: List<CiUpsertStepRow>) -> Bool {
  let slice = ci_upsert_steps_full_in_scope_step_ids
  ci_upsert_steps_registry_ids_unique(rows: rows)
    && ci_upsert_steps_registry_matches_declared_slice(rows: rows, slice: slice)
    && ci_step_id_lists_biject(left: slice, right: ci_pipeline_step_ids_shadow(p: p))
    && ci_upsert_rows_match_pipeline_shadow_ids(rows: rows, p: p)
}


fn ci_selection_decision_step_ids_unique(decisions: List<CiStepSelection>) -> Bool {
  let ids = ci_step_selections_step_ids(decisions: decisions)
  length(xs: ids) == length(xs: unique(xs: ids, eq: ci_step_id_eq))
}


fn ci_pipeline_steps_covered(receipt: CiSelectionReceipt, pipeline: CiPipeline) -> Bool {
  for_all(xs: ci_pipeline_step_ids_shadow(p: pipeline), predicate: fn(step_id) {
    ci_step_id_in_list(id: step_id, ids: ci_step_selections_step_ids(decisions: receipt.decisions))
  })
}


fn ci_selection_receipt_well_formed(receipt: CiSelectionReceipt, pipeline: CiPipeline) -> Bool {
  let expected = ci_pipeline_step_ids_shadow(p: pipeline)
  let got = ci_step_selections_step_ids(decisions: receipt.decisions)
  length(xs: got) == length(xs: expected)
    && ci_selection_decision_step_ids_unique(decisions: receipt.decisions)
    && ci_pipeline_steps_covered(receipt: receipt, pipeline: pipeline)
}


data ci_selection_receipt_shadow_empty_pr: ChangeSet = ChangeSet { changes: [] }

data ci_selection_receipt_shadow_fail_closed_affected: AffectedSet = AffectedSetFailClosed {
  changes: ci_selection_receipt_shadow_empty_pr,
  evidence: AffectedSetReason { reason: ci_selection_shadow_reason }
}

// MW-D8 C4 fixture — v4 workflow touch selects m1 probe Run; v2 compile is carveout CarvedOut.
data ci_selection_receipt_shadow_fixture_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: ["src/v4/workflow/ci.dag"]
}

data ci_selection_receipt_shadow_fixture_affected: AffectedSet = AffectedSetProduced {
  changes: ci_selection_receipt_shadow_empty_pr,
  affected: [],
  exclusions: [],
  restricted_to: []
}

data ci_selection_receipt_shadow_fixture_receipt: CiSelectionReceipt = match ci_pipeline {
  Accepted { value: pl, diagnostics: _ } =>
    ci_selection_receipt_shadow(
      pr: ci_selection_receipt_shadow_empty_pr,
      affected: ci_selection_receipt_shadow_fixture_affected,
      git_diff: ci_selection_receipt_shadow_fixture_git_diff,
      pipeline: pl,
      carveouts: ci_always_run_carveouts,
      registry: ci_upsert_steps
    )
  Rejected { diagnostics: _ } =>
    ci_selection_receipt_shadow(
      pr: ci_selection_receipt_shadow_empty_pr,
      affected: ci_selection_receipt_shadow_fail_closed_affected,
      git_diff: ci_selection_receipt_shadow_fixture_git_diff,
      pipeline: CiPipeline { jobs: [], gates: [] },
      carveouts: ci_always_run_carveouts,
      registry: ci_upsert_steps
    )
}

fn ci_selection_receipt_shadow_fixture_v2_compile_carved_out_holds() -> Bool {
  let step_id = JobStep { job: v2_compile_src_v4, step: v2_compile_src_v4 }
  fold(
    ci_selection_receipt_shadow_fixture_receipt.decisions,
    init: false,
    f: fn(acc, selection) {
      if acc {
        true
      } else if ci_step_id_eq(left: selection.step_id, right: step_id) {
        match selection.decision {
          CarvedOut { carveout_reason: _ } => true
          Run => false
          Skip => false
        }
      } else {
        acc
      }
    }
  )
}

fn ci_selection_receipt_shadow_fixture_m1_probe_run_holds() -> Bool {
  let step_id = JobStep {
    job: m1_rust_emit_probe_execution,
    step: m1_rust_emit_probe_execution
  }
  fold(
    ci_selection_receipt_shadow_fixture_receipt.decisions,
    init: false,
    f: fn(acc, selection) {
      if acc {
        true
      } else if ci_step_id_eq(left: selection.step_id, right: step_id) {
        match selection.decision {
          Run => true
          Skip => false
          CarvedOut { carveout_reason: _ } => false
        }
      } else {
        acc
      }
    }
  )
}

data ci_selection_receipt_shadow_fixture_v2_compile_carved_out_ok: Bool = ci_selection_receipt_shadow_fixture_v2_compile_carved_out_holds()

data ci_selection_receipt_shadow_fixture_m1_probe_run_ok: Bool = ci_selection_receipt_shadow_fixture_m1_probe_run_holds()

data ci_selection_receipt_shadow_fixture_well_formed_ok: Bool = match ci_pipeline {
  Accepted { value: pl, diagnostics: _ } =>
    ci_selection_receipt_well_formed(
      receipt: ci_selection_receipt_shadow_fixture_receipt,
      pipeline: pl
    )
  Rejected { diagnostics: _ } => false
}

// C4 generatability — fixture receipt is well-formed and encodes carveout + affected Run evidence.
// ── Wave 3 §11.7.4 — fixture shadow receipt (modeled selection; NOT live PR / NOT component-flag frontier) ──
data ci_wave3_shadow_fixture_empty_pr: ChangeSet = ChangeSet { changes: [] }

data ci_wave3_shadow_fixture_fail_closed_receipt: CiSelectionReceipt = ci_selection_receipt_mk(
  pr: ci_wave3_shadow_fixture_empty_pr,
  affected: ci_wave3_shadow_fail_closed_affected,
  mode: Shadow,
  provenance: FixtureReceipt,
  decisions: Empty,
  testclaim_decisions: ci_wave3_shadow_testclaim_selection_rows(
    affected: ci_wave3_shadow_fail_closed_affected
  ),
  testgen_slots: Empty,
  component_affected_comparison: ci_component_affected_fail_closed()
)

fn ci_wave3_shadow_fixture_fail_closed_superset_holds() -> Bool {
  let selected = ci_wave3_shadow_testclaims_selected(affected: ci_wave3_shadow_fail_closed_affected)
  length(xs: selected) == length(xs: ci_wave3_shadow_claim_roster())
}

fn ci_wave3_shadow_fixture_floor_held_holds() -> Bool {
  ci_floor_held(receipt: ci_wave3_shadow_fixture_fail_closed_receipt)
}

// 🟡 gated — predicate-dissolution interim (Practice 10) — feature:wave3-shadow-selection-receipt — consumer:ci_wave3_shadow_fixture_provenance_is_fixture_holds — bind node://adhoc-331899f9-19a live emit — dissolve-on-arrival: fixture witnesses carry `FixtureReceipt` at construction site (delete provenance match helper when live path exists); forbidden: `LivePrGitDiff` on synthetic/heartbeat constructors before real PR git_diff routing.
fn ci_wave3_shadow_fixture_provenance_is_fixture_holds() -> Bool {
  match ci_wave3_shadow_fixture_fail_closed_receipt.provenance {
    FixtureReceipt => true
    LivePrGitDiff => false
  }
}

fn ci_wave3_shadow_fixture_manual_subset_selected_holds() -> Bool {
  let manual = ci_wave3_shadow_manual_claim_roster()
  let selected = ci_wave3_shadow_testclaims_selected(affected: ci_wave3_shadow_fail_closed_affected)
  for_all(
    xs: manual,
    predicate: fn(claim) {
      count_equal(xs: selected, item: claim, eq: fn(left, right) { left == right }) != 0
    }
  )
}

data ci_wave3_shadow_fixture_receipt_ok: Bool = ci_wave3_shadow_fixture_fail_closed_superset_holds() && ci_wave3_shadow_fixture_floor_held_holds() && ci_wave3_shadow_fixture_provenance_is_fixture_holds() && ci_wave3_shadow_fixture_manual_subset_selected_holds()

data ci_selection_receipt_shadow_generatable_ok: Bool = ci_selection_receipt_shadow_fixture_well_formed_ok && ci_selection_receipt_shadow_fixture_v2_compile_carved_out_ok && ci_selection_receipt_shadow_fixture_m1_probe_run_ok

