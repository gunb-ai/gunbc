data ci_manual_anchor_tc_arrow_empty_tag: Symbol = ci_manual_anchor_tc_arrow_empty_tag
data ci_manual_anchor_tc_transform_empty_tag: Symbol = ci_manual_anchor_tc_transform_empty_tag
data ci_manual_anchor_tc_branch_empty_tag: Symbol = ci_manual_anchor_tc_branch_empty_tag
data ci_manual_anchor_tc_loop_empty_tag: Symbol = ci_manual_anchor_tc_loop_empty_tag
data ci_manual_anchor_tc_bind_zero_children_tag: Symbol = ci_manual_anchor_tc_bind_zero_children_tag
data ci_manual_anchor_tc_conj_equals_refl_tag: Symbol = ci_manual_anchor_tc_conj_equals_refl_tag
data ci_manual_anchor_nat_add_left_identity_tag: Symbol = ci_manual_anchor_nat_add_left_identity_tag
data ci_manual_anchor_nat_add_right_identity_tag: Symbol = ci_manual_anchor_nat_add_right_identity_tag
data ci_manual_anchor_nat_add_associativity_tag: Symbol = ci_manual_anchor_nat_add_associativity_tag
data ci_manual_anchor_nat_mul_left_identity_tag: Symbol = ci_manual_anchor_nat_mul_left_identity_tag
data ci_manual_anchor_nat_mul_annihilator_tag: Symbol = ci_manual_anchor_nat_mul_annihilator_tag
data ci_manual_anchor_nat_mul_associativity_tag: Symbol = ci_manual_anchor_nat_mul_associativity_tag
data ci_manual_anchor_lbe_conj_dag_surface_tag: Symbol = ci_manual_anchor_lbe_conj_dag_surface_tag
data ci_manual_anchor_lbe_disj_dag_surface_tag: Symbol = ci_manual_anchor_lbe_disj_dag_surface_tag
data ci_manual_anchor_lbe_transform_dag_surface_tag: Symbol = ci_manual_anchor_lbe_transform_dag_surface_tag
data ci_manual_anchor_refinement_non_empty_list_base_tag: Symbol = ci_manual_anchor_refinement_non_empty_list_base_tag
data ci_manual_anchor_absent_tag: Symbol = ci_manual_anchor_absent_tag
data ci_generated_anchor_coproduct_exhaustiveness_tag: Symbol = ci_generated_anchor_coproduct_exhaustiveness_tag
data ci_testgen_tier1_tag: Symbol = ci_testgen_tier1_tag
data ci_testgen_tier2_tag: Symbol = ci_testgen_tier2_tag
data ci_testgen_tier3_tag: Symbol = ci_testgen_tier3_tag
data ci_testgen_layer_unit_tag: Symbol = ci_testgen_layer_unit_tag
data ci_testgen_layer_integration_tag: Symbol = ci_testgen_layer_integration_tag
data ci_testgen_layer_boundary_tag: Symbol = ci_testgen_layer_boundary_tag

fn ci_bool_digest(value: Bool) -> Hash {
  match value {
    true => ci_symbol_digest(sym: ci_digest_true_tag)
    false => ci_symbol_digest(sym: ci_digest_false_tag)
  }
}


fn ci_hash_list_digest(xs: List<Hash>) -> Hash {
  fold_list(
    xs: xs,
    empty: ci_symbol_digest(sym: ci_digest_empty_hash_list_tag),
    cons: fn(acc, item) {
      combine_hash(a: acc, b: item)
    }
  )
}


fn ci_string_digest(s: String) -> Hash {
  content_hash(n: ci_string_projection_node(s: s))
}


fn ci_path_digest(path: Path) -> Hash {
  content_hash(n: ci_symbol_list_projection_node(xs: path.steps))
}

fn ci_change_kind_digest(kind: ChangeKind) -> Hash {
  match kind {
    NodeChanged => ci_symbol_digest(sym: ci_change_kind_node_changed_tag)
    NodeAdded => ci_symbol_digest(sym: ci_change_kind_node_added_tag)
    NodeRemoved => ci_symbol_digest(sym: ci_change_kind_node_removed_tag)
    ProjectionChanged => ci_symbol_digest(sym: ci_change_kind_projection_changed_tag)
    ArtifactChanged => ci_symbol_digest(sym: ci_change_kind_artifact_changed_tag)
  }
}


fn ci_change_digest(change: Change) -> Hash {
  combine_hash(
    a: ci_change_kind_digest(kind: change.kind),
    b: combine_hash(
      a: content_hash(n: change.subject),
      b: ci_path_digest(path: change.at)
    )
  )
}


fn ci_change_set_digest(changes: ChangeSet) -> Hash {
  fold_list(
    xs: changes.changes,
    empty: ci_symbol_digest(sym: ci_digest_empty_change_set_tag),
    cons: fn(acc, change) {
      combine_hash(a: acc, b: ci_change_digest(change: change))
    }
  )
}


fn ci_dependency_kind_digest(kind: DependencyKind) -> Hash {
  match kind {
    Contains => ci_symbol_digest(sym: ci_dependency_kind_contains_tag)
    BindsTo => ci_symbol_digest(sym: ci_dependency_kind_binds_to_tag)
    TypeDependsOn => ci_symbol_digest(sym: ci_dependency_kind_type_depends_on_tag)
    DataDependsOn => ci_symbol_digest(sym: ci_dependency_kind_data_depends_on_tag)
    EffectDependsOn => ci_symbol_digest(sym: ci_dependency_kind_effect_depends_on_tag)
    ResourceDependsOn => ci_symbol_digest(sym: ci_dependency_kind_resource_depends_on_tag)
    ModuleDependsOn => ci_symbol_digest(sym: ci_dependency_kind_module_depends_on_tag)
    BarrierBefore => ci_symbol_digest(sym: ci_dependency_kind_barrier_before_tag)
    PlacementDependsOn => ci_symbol_digest(sym: ci_dependency_kind_placement_depends_on_tag)
    ModelDependsOn => ci_symbol_digest(sym: ci_dependency_kind_model_depends_on_tag)
    ProjectionDependsOn => ci_symbol_digest(sym: ci_dependency_kind_projection_depends_on_tag)
    GeneratedFrom => ci_symbol_digest(sym: ci_dependency_kind_generated_from_tag)
    VerifiedBy => ci_symbol_digest(sym: ci_dependency_kind_verified_by_tag)
    PromotedBy => ci_symbol_digest(sym: ci_dependency_kind_promoted_by_tag)
    BootstrapDependsOn => ci_symbol_digest(sym: ci_dependency_kind_bootstrap_depends_on_tag)
  }
}


fn ci_dependency_view_digest(view: DependencyView) -> Hash {
  combine_hash(
    a: content_hash(n: view.source),
    b: combine_hash(
      a: content_hash(n: view.dependent),
      b: combine_hash(
        a: ci_dependency_kind_digest(kind: view.kind),
        b: content_hash(n: view.usage_site)
      )
    )
  )
}


fn ci_dependency_endpoint_digest(target: DependencyEndpoint) -> Hash {
  match target {
    DependencySource => ci_symbol_digest(sym: ci_dependency_endpoint_source_tag)
    DependencyDependent => ci_symbol_digest(sym: ci_dependency_endpoint_dependent_tag)
  }
}


fn ci_affected_dependency_digest(dep: AffectedDependency) -> Hash {
  combine_hash(
    a: ci_change_digest(change: dep.change),
    b: combine_hash(
      a: ci_dependency_view_digest(view: dep.dependency),
      b: ci_dependency_endpoint_digest(target: dep.target)
    )
  )
}


fn ci_affected_dependency_list_digest(xs: List<AffectedDependency>) -> Hash {
  fold_list(
    xs: xs,
    empty: ci_symbol_digest(sym: ci_digest_empty_affected_dependency_list_tag),
    cons: fn(acc, dep) {
      combine_hash(a: acc, b: ci_affected_dependency_digest(dep: dep))
    }
  )
}


fn ci_extent_digest(extent: Extent) -> Hash {
  match extent {
    WholeFile => ci_symbol_digest(sym: ci_projection_char_offset_authority_edge)
    ByteRange { start, end } =>
      combine_hash(
        a: content_hash(n: ci_char_projection_node(c: start)),
        b: content_hash(n: ci_char_projection_node(c: end))
      )
  }
}


fn ci_locus_digest(locus: Locus) -> Hash {
  match locus {
    Textual { file, extent } =>
      combine_hash(a: ci_symbol_digest(sym: file), b: ci_extent_digest(extent: extent))
    NodeLocus { anchor } => content_hash(n: anchor.at)
    PortLocus { anchor } => ci_symbol_digest(sym: anchor.at)
  }
}


fn ci_no_correction_reason_digest(reason: NoCorrectionReason) -> Hash {
  match reason {
    UserInputBoundary => ci_symbol_digest(sym: ci_no_correction_user_input_boundary_tag)
    AmbiguousIntent => ci_symbol_digest(sym: ci_no_correction_ambiguous_intent_tag)
    ExternalContractUnknown => ci_symbol_digest(sym: ci_no_correction_external_contract_unknown_tag)
  }
}


fn ci_correction_digest(correction: Correction) -> Hash {
  match correction {
    Suggested { node } => content_hash(n: node)
    Unavailable { reason } => ci_no_correction_reason_digest(reason: reason)
  }
}


fn ci_diagnostic_digest(diagnostic: Diagnostic) -> Hash {
  combine_hash(
    a: ci_symbol_digest(sym: diagnostic.reason),
    b: combine_hash(
      a: ci_locus_digest(locus: diagnostic.at),
      b: ci_correction_digest(correction: diagnostic.correction)
    )
  )
}


fn ci_diagnostics_list_digest(xs: List<Diagnostic>) -> Hash {
  fold_list(
    xs: xs,
    empty: ci_symbol_digest(sym: ci_digest_empty_diagnostics_list_tag),
    cons: fn(acc, diagnostic) {
      combine_hash(a: acc, b: ci_diagnostic_digest(diagnostic: diagnostic))
    }
  )
}


fn ci_non_empty_diagnostics_digest(diagnostics: NonEmptyDiagnostics) -> Hash {
  combine_hash(
    a: ci_diagnostic_digest(diagnostic: diagnostics.head),
    b: ci_diagnostics_list_digest(xs: diagnostics.tail)
  )
}


fn ci_affected_exclusion_digest(exclusion: AffectedExclusion) -> Hash {
  combine_hash(
    a: ci_change_digest(change: exclusion.change),
    b: combine_hash(
      a: ci_dependency_view_digest(view: exclusion.dependency),
      b: combine_hash(
        a: content_hash(n: exclusion.usage_site),
        b: ci_symbol_digest(sym: exclusion.changed_dimension)
      )
    )
  )
}


fn ci_affected_exclusion_list_digest(xs: List<AffectedExclusion>) -> Hash {
  fold_list(
    xs: xs,
    empty: ci_symbol_digest(sym: ci_digest_empty_affected_exclusion_list_tag),
    cons: fn(acc, exclusion) {
      combine_hash(a: acc, b: ci_affected_exclusion_digest(exclusion: exclusion))
    }
  )
}


fn ci_dependency_kind_list_digest(xs: List<DependencyKind>) -> Hash {
  fold_list(
    xs: xs,
    empty: ci_symbol_digest(sym: ci_digest_empty_dependency_kind_list_tag),
    cons: fn(acc, kind) {
      combine_hash(a: acc, b: ci_dependency_kind_digest(kind: kind))
    }
  )
}


fn ci_affected_set_digest(affected: AffectedSet) -> Hash {
  match affected {
    AffectedSetProduced { changes, affected: deps, exclusions, restricted_to } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_affected_set_produced_tag),
        b: combine_hash(
          a: ci_change_set_digest(changes: changes),
          b: combine_hash(
            a: ci_affected_dependency_list_digest(xs: deps),
            b: combine_hash(
              a: ci_affected_exclusion_list_digest(xs: exclusions),
              b: ci_dependency_kind_list_digest(xs: restricted_to)
            )
          )
        )
      )
    AffectedSetFailClosed { changes, evidence } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_affected_set_fail_closed_tag),
        b: combine_hash(
          a: ci_change_set_digest(changes: changes),
          b: match evidence {
            AffectedSetReason { reason } => ci_symbol_digest(sym: reason)
            AffectedSetDiagnostics { diagnostics } =>
              ci_non_empty_diagnostics_digest(diagnostics: diagnostics)
          }
        )
      )
  }
}


fn ci_testclaim_variant_digest(variant: TestClaimCoproductVariant) -> Hash {
  match variant {
    TestClaimCompilesClaimVariant => ci_symbol_digest(sym: ci_testclaim_variant_compiles_tag)
    TestClaimDiagnosticClaimVariant => ci_symbol_digest(sym: ci_testclaim_variant_diagnostic_tag)
    TestClaimEqualsClaimVariant => ci_symbol_digest(sym: ci_testclaim_variant_equals_tag)
    TestClaimRoundTripClaimVariant => ci_symbol_digest(sym: ci_testclaim_variant_round_trip_tag)
  }
}


fn ci_manual_anchor_digest(anchor: ManualAnchorKey) -> Hash {
  match anchor {
    ManualTcConjEmpty => ci_symbol_digest(sym: ci_manual_anchor_tc_conj_empty_tag)
    ManualTcDisjEmpty => ci_symbol_digest(sym: ci_manual_anchor_tc_disj_empty_tag)
    ManualTcArrowTwoConj => ci_symbol_digest(sym: ci_manual_anchor_tc_arrow_two_conj_tag)
    ManualTcCardinalityEmpty => ci_symbol_digest(sym: ci_manual_anchor_tc_cardinality_empty_tag)
    ManualTcInstantiationEmpty => ci_symbol_digest(sym: ci_manual_anchor_tc_instantiation_empty_tag)
    ManualTcArrowEmpty => ci_symbol_digest(sym: ci_manual_anchor_tc_arrow_empty_tag)
    ManualTcTransformEmpty => ci_symbol_digest(sym: ci_manual_anchor_tc_transform_empty_tag)
    ManualTcBranchEmpty => ci_symbol_digest(sym: ci_manual_anchor_tc_branch_empty_tag)
    ManualTcLoopEmpty => ci_symbol_digest(sym: ci_manual_anchor_tc_loop_empty_tag)
    ManualTcBindZeroChildren => ci_symbol_digest(sym: ci_manual_anchor_tc_bind_zero_children_tag)
    ManualTcConjEqualsRefl => ci_symbol_digest(sym: ci_manual_anchor_tc_conj_equals_refl_tag)
    ManualNatAddLeftIdentity => ci_symbol_digest(sym: ci_manual_anchor_nat_add_left_identity_tag)
    ManualNatAddRightIdentity => ci_symbol_digest(sym: ci_manual_anchor_nat_add_right_identity_tag)
    ManualNatAddAssociativity => ci_symbol_digest(sym: ci_manual_anchor_nat_add_associativity_tag)
    ManualNatMulLeftIdentity => ci_symbol_digest(sym: ci_manual_anchor_nat_mul_left_identity_tag)
    ManualNatMulAnnihilator => ci_symbol_digest(sym: ci_manual_anchor_nat_mul_annihilator_tag)
    ManualNatMulAssociativity => ci_symbol_digest(sym: ci_manual_anchor_nat_mul_associativity_tag)
    ManualLbeConjDagSurface => ci_symbol_digest(sym: ci_manual_anchor_lbe_conj_dag_surface_tag)
    ManualLbeDisjDagSurface => ci_symbol_digest(sym: ci_manual_anchor_lbe_disj_dag_surface_tag)
    ManualLbeTransformDagSurface => ci_symbol_digest(sym: ci_manual_anchor_lbe_transform_dag_surface_tag)
    ManualRefinementNonEmptyListBase => ci_symbol_digest(sym: ci_manual_anchor_refinement_non_empty_list_base_tag)
    ManualAnchorAbsent => ci_symbol_digest(sym: ci_manual_anchor_absent_tag)
  }
}


fn ci_generated_anchor_digest(anchor: GeneratedAnchorKey) -> Hash {
  match anchor {
    GeneratedCoproductExhaustiveness { omitted_variant } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_generated_anchor_coproduct_exhaustiveness_tag),
        b: ci_testclaim_variant_digest(variant: omitted_variant)
      )
  }
}


fn ci_claim_anchor_digest(anchor: ClaimAnchorKey) -> Hash {
  match anchor {
    ManualClaimAnchor { manual_anchor } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_claim_anchor_manual_tag),
        b: ci_manual_anchor_digest(anchor: manual_anchor)
      )
    GeneratedClaimAnchor { generated_anchor } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_claim_anchor_generated_tag),
        b: ci_generated_anchor_digest(anchor: generated_anchor)
      )
  }
}


fn ci_testgen_tier_digest(tier: TestgenTier) -> Hash {
  match tier {
    Tier1 => ci_symbol_digest(sym: ci_testgen_tier1_tag)
    Tier2 => ci_symbol_digest(sym: ci_testgen_tier2_tag)
    Tier3 => ci_symbol_digest(sym: ci_testgen_tier3_tag)
  }
}


fn ci_testgen_layer_digest(layer: TestgenLayer) -> Hash {
  match layer {
    Unit => ci_symbol_digest(sym: ci_testgen_layer_unit_tag)
    Integration => ci_symbol_digest(sym: ci_testgen_layer_integration_tag)
    Boundary => ci_symbol_digest(sym: ci_testgen_layer_boundary_tag)
  }
}


fn ci_test_classification_digest(classification: TestClassification) -> Hash {
  combine_hash(
    a: ci_testgen_tier_digest(tier: classification.tier),
    b: ci_testgen_layer_digest(layer: classification.layer)
  )
}


fn ci_component_affected_digest(component: CiComponentAffected) -> Hash {
  ci_hash_list_digest(xs: [
    ci_bool_digest(value: component.v2),
    ci_bool_digest(value: component.v3),
    ci_bool_digest(value: component.v4),
    ci_bool_digest(value: component.testclaim_corpus),
    ci_bool_digest(value: component.workflow_policy),
    ci_bool_digest(value: component.release_distribution),
    ci_bool_digest(value: component.release_distribution_only)
  ])
}


fn ci_selection_mode_digest(mode: CiSelectionMode) -> Hash {
  match mode {
    Shadow => ci_symbol_digest(sym: ci_selection_mode_shadow_tag)
    Active { skip_evidence } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_selection_mode_active_tag),
        b: skip_evidence.cached_verdict_digest
      )
  }
}


fn ci_selection_provenance_digest(provenance: CiSelectionReceiptProvenance) -> Hash {
  match provenance {
    FixtureReceipt => ci_symbol_digest(sym: ci_selection_provenance_fixture_tag)
    LivePrGitDiff => ci_symbol_digest(sym: ci_selection_provenance_live_pr_git_diff_tag)
  }
}


fn ci_selection_decision_digest(decision: SelectionDecision) -> Hash {
  match decision {
    Run => ci_symbol_digest(sym: ci_selection_decision_run_tag)
    Skip => ci_symbol_digest(sym: ci_selection_decision_skip_tag)
    CarvedOut { carveout_reason } =>
      combine_hash(
        a: ci_symbol_digest(sym: ci_selection_decision_carved_out_tag),
        b: ci_symbol_digest(sym: carveout_reason)
      )
  }
}


fn ci_claim_selection_reason_digest(reason: CiClaimSelectionReason) -> Hash {
  match reason {
    FailClosedSuperset => ci_symbol_digest(sym: ci_claim_reason_fail_closed_superset_tag)
    AffectedFrontierEmpty => ci_symbol_digest(sym: ci_claim_reason_affected_frontier_empty_tag)
    AffectedIntersectionNonempty => ci_symbol_digest(sym: ci_claim_reason_affected_intersection_nonempty_tag)
    AffectedIntersectionEmpty => ci_symbol_digest(sym: ci_claim_reason_affected_intersection_empty_tag)
    TestgenSlotMapped => ci_symbol_digest(sym: ci_claim_reason_testgen_slot_mapped_tag)
    ShadowObserveOnly => ci_symbol_digest(sym: ci_claim_reason_shadow_observe_only_tag)
    FloorStepCarveout => ci_symbol_digest(sym: ci_claim_reason_floor_step_carveout_tag)
  }
}


fn ci_step_selection_digest(row: CiStepSelection) -> Hash {
  combine_hash(
    a: content_hash(n: ci_step_id_projection_node(step_id: row.step_id)),
    b: combine_hash(
      a: content_hash(n: ci_upsert_input_ref_list_projection_node(refs: row.inputs_consulted)),
      b: combine_hash(
        a: ci_affected_dependency_list_digest(xs: row.affected_intersection),
        b: combine_hash(
          a: ci_selection_decision_digest(decision: row.decision),
          b: combine_hash(
            a: row.cache_digest,
            b: ci_symbol_digest(sym: row.reason)
          )
        )
      )
    )
  )
}


fn ci_step_selection_list_digest(rows: List<CiStepSelection>) -> Hash {
  fold_list(
    xs: rows,
    empty: ci_symbol_digest(sym: ci_digest_empty_step_selection_list_tag),
    cons: fn(acc, row) {
      combine_hash(a: acc, b: ci_step_selection_digest(row: row))
    }
  )
}


fn ci_testclaim_selection_digest(row: CiTestClaimSelection) -> Hash {
  combine_hash(
    a: ci_claim_anchor_digest(anchor: row.anchor),
    b: combine_hash(
      a: ci_string_digest(s: row.label),
      b: combine_hash(
        a: ci_testclaim_variant_digest(variant: row.coproduct_variant),
        b: combine_hash(
          a: row.claim_projection_hash,
          b: combine_hash(
            a: ci_bool_digest(value: row.selected),
            b: ci_claim_selection_reason_digest(reason: row.reason)
          )
        )
      )
    )
  )
}


fn ci_testclaim_selection_list_digest(rows: List<CiTestClaimSelection>) -> Hash {
  fold_list(
    xs: rows,
    empty: ci_symbol_digest(sym: ci_digest_empty_testclaim_selection_list_tag),
    cons: fn(acc, row) {
      combine_hash(a: acc, b: ci_testclaim_selection_digest(row: row))
    }
  )
}


fn ci_testgen_slot_selection_digest(row: TestgenSlotSelection) -> Hash {
  combine_hash(
    a: ci_testclaim_variant_digest(variant: row.generator.kind),
    b: combine_hash(
      a: ci_test_classification_digest(classification: row.generator.classification),
      b: combine_hash(
        a: ci_claim_anchor_digest(anchor: row.generator.anchor),
        b: combine_hash(
          a: ci_symbol_digest(sym: row.generator.provenance.generator_id),
          b: combine_hash(
            a: ci_symbol_digest(sym: row.generator.profile_metadata.profile_ref),
            b: combine_hash(
              a: ci_claim_anchor_digest(anchor: row.emits_claim_anchor),
              b: combine_hash(
                a: ci_bool_digest(value: row.selected),
                b: ci_claim_selection_reason_digest(reason: row.reason)
              )
            )
          )
        )
      )
    )
  )
}


fn ci_testgen_slot_selection_list_digest(rows: List<TestgenSlotSelection>) -> Hash {
  fold_list(
    xs: rows,
    empty: ci_symbol_digest(sym: ci_digest_empty_testgen_slot_selection_list_tag),
    cons: fn(acc, row) {
      combine_hash(a: acc, b: ci_testgen_slot_selection_digest(row: row))
    }
  )
}


fn ci_selection_receipt_storage_key(receipt: CiSelectionReceipt) -> Hash {
  combine_hash(
    a: ci_symbol_digest(sym: ci_selection_receipt_persistence_key_tag),
    b: combine_hash(
      a: ci_change_set_digest(changes: receipt.pr),
      b: combine_hash(
        a: ci_affected_set_digest(affected: receipt.affected),
        b: combine_hash(
          a: ci_selection_mode_digest(mode: receipt.mode),
          b: combine_hash(
            a: ci_selection_provenance_digest(provenance: receipt.provenance),
            b: combine_hash(
              a: ci_step_selection_list_digest(rows: receipt.decisions),
              b: combine_hash(
                a: ci_testclaim_selection_list_digest(rows: receipt.testclaim_decisions),
                b: combine_hash(
                  a: ci_testgen_slot_selection_list_digest(rows: receipt.testgen_slots),
                  b: ci_component_affected_digest(component: receipt.component_affected_comparison)
                )
              )
            )
          )
        )
      )
    )
  )
}


fn ci_selection_receipt_persist(
  receipt: CiSelectionReceipt,
  store: List<CiSelectionReceiptStoreRow>
) -> List<CiSelectionReceiptStoreRow> {
  list_snoc_item(
    xs: store,
    item: CiSelectionReceiptStoreRow {
      key: ci_selection_receipt_storage_key(receipt: receipt),
      receipt: receipt
    }
  )
}


fn ci_selection_receipt_lookup(
  key: Hash,
  store: List<CiSelectionReceiptStoreRow>
) -> CiSelectionReceiptLookup {
  fold(
    store,
    init: CiSelectionReceiptMissing { key: key },
    f: fn(acc, row) {
      match acc {
        CiSelectionReceiptFound { receipt: _ } => acc
        CiSelectionReceiptMissing { key: missing_key } =>
          if ci_selection_receipt_storage_key(receipt: row.receipt) == missing_key {
            CiSelectionReceiptFound { receipt: row.receipt }
          } else {
            acc
          }
      }
    }
  )
}


// ── Wave 3 §11.7.4 — CiSelectionReceipt claim projection (consumes #4178 runtime selection API) ──
fn ci_wave3_shadow_testclaim_selection_reason(
  claim: TestClaim,
  affected: AffectedSet,
  selected: Bool
) -> CiClaimSelectionReason {
  if ci_affected_set_is_fail_closed(affected: affected) {
    FailClosedSuperset
  } else {
    match affected_set_rerun_nodes(affected_set_value: affected) {
      RerunNodeSetFailClosed { evidence: _ } => FailClosedSuperset
      RerunNodeSetProduced { nodes: nodes } =>
        if length(xs: nodes) == 0 {
          if selected {
            FailClosedSuperset
          } else {
            AffectedFrontierEmpty
          }
        } else if selected {
          if test_claim_ci_selection_fail_closed(c: claim) {
            FailClosedSuperset
          } else {
            AffectedIntersectionNonempty
          }
        } else if test_claim_in_rerun_frontier(claim: claim, frontier: nodes) {
          ShadowObserveOnly
        } else {
          AffectedIntersectionEmpty
        }
    }
  }
}


fn ci_wave3_shadow_testclaim_selection_row(
  claim: TestClaim,
  affected: AffectedSet,
  selected_claims: List<TestClaim>
) -> CiTestClaimSelection {
  let selected = count_equal(xs: selected_claims, item: claim, eq: fn(left, right) { left == right }) != 0
  CiTestClaimSelection {
    anchor: test_claim_anchor(c: claim),
    label: test_claim_label(c: claim),
    coproduct_variant: test_claim_coproduct_variant(c: claim),
    claim_projection_hash: test_claim_claim_hash_digest(c: claim),
    selected: selected,
    reason: ci_wave3_shadow_testclaim_selection_reason(
      claim: claim,
      affected: affected,
      selected: selected
    )
  }
}


fn ci_wave3_shadow_testclaim_selection_rows(affected: AffectedSet) -> List<CiTestClaimSelection> {
  let selected = ci_wave3_shadow_testclaims_selected(affected: affected)
  fold(
    ci_wave3_shadow_claim_roster(),
    init: Empty,
    f: fn(acc, claim) {
      list_snoc_item(
        xs: acc,
        item: ci_wave3_shadow_testclaim_selection_row(
          claim: claim,
          affected: affected,
          selected_claims: selected
        )
      )
    }
  )
}


// F.2-P2 / F.2.6 — testgen shadow selection (profile-gated; NOT fail-closed on affected-set).
// Scheduler `Rejected` must propagate as `Outcome::Rejected` (P3) — never `Empty` slots.
fn ci_test_claim_emits_generator(claim: TestClaim, generator: Generator<TestgenConcept>) -> Bool {
  generator_id_for_claim_anchor(anchor: test_claim_anchor(c: claim)) == generator.provenance.generator_id
}


fn ci_wave3_shadow_testgen_generator_matches_selected_claim(
  g: Generator<TestgenConcept>,
  selected_claims: List<TestClaim>
) -> Bool {
  count_where(
    xs: selected_claims,
    predicate: fn(claim) {
      ci_test_claim_emits_generator(claim: claim, generator: g)
    }
  ) != 0
}


fn ci_wave3_shadow_testgen_slots_selected_from_roster(
  affected: AffectedSet,
  profile_ref: Symbol,
  roster: List<Generator<TestgenConcept>>
) -> List<Generator<TestgenConcept>> {
  if ci_affected_set_is_fail_closed(affected: affected) {
    Empty
  } else {
    let selected_claims = ci_wave3_shadow_testclaims_selected(affected: affected)
    filter(
      xs: roster,
      predicate: fn(g) {
        generator_matches_profile(g: g, profile_ref: profile_ref)
          && ci_wave3_shadow_testgen_generator_matches_selected_claim(
            g: g,
            selected_claims: selected_claims
          )
      }
    )
  }
}


fn ci_wave3_shadow_testgen_selection_reason(
  g: Generator<TestgenConcept>,
  affected: AffectedSet,
  profile_ref: Symbol,
  selected: Bool
) -> CiClaimSelectionReason {
  if generator_matches_profile(g: g, profile_ref: profile_ref) {
    if ci_affected_set_is_fail_closed(affected: affected) {
      ShadowObserveOnly
    } else if selected {
      TestgenSlotMapped
    } else {
      ShadowObserveOnly
    }
  } else {
    ShadowObserveOnly
  }
}


fn ci_wave3_shadow_testgen_selection_row(
  g: Generator<TestgenConcept>,
  affected: AffectedSet,
  profile_ref: Symbol,
  selected_generators: List<Generator<TestgenConcept>>
) -> TestgenSlotSelection {
  let selected = count_where(
    xs: selected_generators,
    predicate: fn(candidate) {
      generator_id_eq(left: candidate, right: g)
    }
  ) != 0
  TestgenSlotSelection {
    generator: g,
    emits_claim_anchor: g.anchor,
    selected: selected,
    reason: ci_wave3_shadow_testgen_selection_reason(
      g: g,
      affected: affected,
      profile_ref: profile_ref,
      selected: selected
    )
  }
}


fn ci_wave3_shadow_testgen_selection_rows_for_roster(
  affected: AffectedSet,
  profile_ref: Symbol,
  roster: List<Generator<TestgenConcept>>
) -> List<TestgenSlotSelection> {
  let selected_generators = ci_wave3_shadow_testgen_slots_selected_from_roster(
    affected: affected,
    profile_ref: profile_ref,
    roster: roster
  )
  fold_list(
    xs: filter(
      xs: roster,
      predicate: fn(g) {
        generator_matches_profile(g: g, profile_ref: profile_ref)
      }
    ),
    empty: Empty,
    cons: fn(acc, g) {
      list_snoc_item(
        xs: acc,
        item: ci_wave3_shadow_testgen_selection_row(
          g: g,
          affected: affected,
          profile_ref: profile_ref,
          selected_generators: selected_generators
        )
      )
    }
  )
}


fn ci_wave3_shadow_testgen_selection_rows_outcome(
  affected: AffectedSet,
  profile_ref: Symbol
) -> Outcome<List<TestgenSlotSelection>> {
  match testgen_run_receipt_outcome(profile_ref: profile_ref) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: receipt, diagnostics: d } =>
      Accepted {
        value: ci_wave3_shadow_testgen_selection_rows_for_roster(
          affected: affected,
          profile_ref: profile_ref,
          roster: receipt.generators
        ),
        diagnostics: d
      }
  }
}


fn ci_testgen_selected_receipt_outcome(
  affected: AffectedSet,
  profile_ref: Symbol
) -> Outcome<SelectedTestgenReceipt> {
  match ci_wave3_shadow_testgen_selection_rows_outcome(
    affected: affected,
    profile_ref: profile_ref
  ) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: slots, diagnostics: d } =>
      Accepted {
        value: SelectedTestgenReceipt {
          profile_ref: profile_ref,
          affected: affected,
          slots: slots
        },
        diagnostics: d
      }
  }
}


// W1.5 step-only shadow — `git_diff` is host transport for ChangeSet paths until T-21 wires RepoPath edits.
// Phase 1: provenance is always `FixtureReceipt` (empty claim/testgen rows). `LivePrGitDiff` is forbidden here;
// live PR receipts use `ci_selection_receipt_shadow_from_git_diff` (adhoc-331899f9-19a) with populated partitions.
fn ci_selection_receipt_shadow(
  pr: ChangeSet,
  affected: AffectedSet,
  git_diff: GitDiffNameOnly,
  pipeline: CiPipeline,
  carveouts: List<CiCarveout>,
  registry: List<CiUpsertStepRow>
) -> CiSelectionReceipt {
  ci_selection_receipt_mk(
    pr: pr,
    affected: affected,
    mode: Shadow,
    provenance: FixtureReceipt,
    decisions: ci_selection_receipt_shadow_rows(
      pr: pr,
      affected: affected,
      git_diff: git_diff,
      pipeline: pipeline,
      carveouts: carveouts,
      registry: registry
    ),
    testclaim_decisions: Empty,
    testgen_slots: Empty,
    component_affected_comparison: ci_component_affected_fail_closed()
  )
}


fn ci_step_selection_shadow_row(step_id: CiStepId) -> CiStepSelection {
  CiStepSelection {
    step_id: step_id,
    inputs_consulted: ci_upsert_row_inputs_for_step_id(step_id: step_id, rows: ci_upsert_steps),
    affected_intersection: [],
    decision: Run,
    cache_digest: ci_upsert_row_cache_digest_for_step_id(step_id: step_id, rows: ci_upsert_steps),
    reason: ci_selection_shadow_reason
  }
}


fn ci_step_selection_shadow_rows(step_ids: List<CiStepId>) -> List<CiStepSelection> {
  fold_list(
    xs: step_ids,
    empty: ci_empty_step_selections(),
    cons: fn(acc, sid) {
      list_snoc_item(xs: acc, item: ci_step_selection_shadow_row(step_id: sid))
    }
  )
}


// Shadow heartbeat only — proves receipt carrier shape; NOT dependency-selection evidence.
fn ci_selection_receipt_shadow_heartbeat(
  pr: ChangeSet,
  affected: AffectedSet,
  pipe: CiPipeline
) -> CiSelectionReceipt {
  ci_selection_receipt_mk(
    pr: pr,
    affected: affected,
    mode: Shadow,
    provenance: FixtureReceipt,
    decisions: ci_step_selection_shadow_rows(step_ids: ci_pipeline_step_ids_shadow(p: pipe)),
    testclaim_decisions: Empty,
    testgen_slots: Empty,
    component_affected_comparison: ci_component_affected_fail_closed()
  )
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature:ci-upsert-step-migration — bound target: W-T-10 exact structural equality / compiler-provided closed-sum equality — dissolve-on-arrival: replace `ci_step_id_eq` call sites with substrate closed-sum equality for `CiStepId` and delete this helper; forbidden: permanent per-variant equality table drift from `CiStepId`.
fn ci_step_id_eq(left: CiStepId, right: CiStepId) -> Bool {
  match left {
    JobStep { job: left_job, step: left_step } =>
      match right {
        JobStep { job: right_job, step: right_step } =>
          left_job == right_job && left_step == right_step
        GateStep { job: _, gate: _ } => false
      }
    GateStep { job: left_job, gate: left_gate } =>
      match right {
        GateStep { job: right_job, gate: right_gate } =>
          left_job == right_job && left_gate == right_gate
        JobStep { job: _, step: _ } => false
      }
  }
}


fn ci_step_selection_step_id(row: CiStepSelection) -> CiStepId {
  row.step_id
}


fn ci_step_selections_step_ids(decisions: List<CiStepSelection>) -> List<CiStepId> {
  fold_list(
    xs: decisions,
    empty: ci_empty_step_ids(),
    cons: fn(acc, row) {
      list_snoc_item(xs: acc, item: ci_step_selection_step_id(row: row))
    }
  )
}


fn ci_step_id_in_list(id: CiStepId, ids: List<CiStepId>) -> Bool {
  count_where(xs: ids, predicate: fn(candidate) {
    ci_step_id_eq(left: id, right: candidate)
  }) != 0
}


fn ci_step_ids_subset_of(xs: List<CiStepId>, universe: List<CiStepId>) -> Bool {
  for_all(xs: xs, predicate: fn(id) {
    ci_step_id_in_list(id: id, ids: universe)
  })
}


fn ci_step_id_list_ids_unique(xs: List<CiStepId>) -> Bool {
  length(xs: xs) == length(xs: unique(xs: xs, eq: ci_step_id_eq))
}


fn ci_step_id_lists_biject(left: List<CiStepId>, right: List<CiStepId>) -> Bool {
  length(xs: left) == length(xs: right)
    && ci_step_id_list_ids_unique(xs: left)
    && ci_step_id_list_ids_unique(xs: right)
    && ci_step_ids_subset_of(xs: left, universe: right)
    && ci_step_ids_subset_of(xs: right, universe: left)
}


fn ci_upsert_steps_registry_ids_unique(rows: List<CiUpsertStepRow>) -> Bool {
  let ids = ci_upsert_steps_slice_step_ids(rows: rows)
  length(xs: ids) == length(xs: rows)
    && length(xs: ids) == length(xs: unique(xs: ids, eq: ci_step_id_eq))
}


fn ci_upsert_steps_registry_matches_declared_slice(
  rows: List<CiUpsertStepRow>,
  slice: List<CiStepId>
) -> Bool {
  ci_step_id_lists_biject(
    left: ci_upsert_steps_slice_step_ids(rows: rows),
    right: slice
  )
}


fn ci_upsert_steps_slice_subset_of_pipeline_shadow(p: CiPipeline, slice: List<CiStepId>) -> Bool {
  ci_step_ids_subset_of(xs: slice, universe: ci_pipeline_step_ids_shadow(p: p))
}


// Out-of-scope steps remain in shadow universe but not in the Bucket A registry (§2.1 partial close).
fn ci_upsert_steps_slice_strict_subset_of_pipeline_shadow(p: CiPipeline, slice: List<CiStepId>) -> Bool {
  let shadow = ci_pipeline_step_ids_shadow(p: p)
  ci_step_ids_subset_of(xs: slice, universe: shadow)
    && length(xs: slice) != length(xs: shadow)
}


fn ci_step_id_lists_disjoint(left: List<CiStepId>, right: List<CiStepId>) -> Bool {
  for_all(xs: left, predicate: fn(id) {
    count_where(xs: right, predicate: fn(candidate) {
      ci_step_id_eq(left: id, right: candidate)
    }) == 0
  })
}


fn ci_upsert_steps_slice_partition_covers_pipeline_shadow(
  p: CiPipeline,
  slice: List<CiStepId>,
  out_of_scope: List<CiStepId>
) -> Bool {
  let shadow = ci_pipeline_step_ids_shadow(p: p)
  let partition = ci_step_id_list_append_items(base: slice, more: out_of_scope)
  ci_step_id_lists_biject(left: partition, right: shadow)
}


fn ci_upsert_steps_out_of_scope_disjoint_from_registry(
  rows: List<CiUpsertStepRow>,
  out_of_scope: List<CiStepId>
) -> Bool {
  let registry_ids = ci_upsert_steps_slice_step_ids(rows: rows)
  for_all(xs: out_of_scope, predicate: fn(id) {
    count_where(xs: registry_ids, predicate: fn(reg_id) {
      ci_step_id_eq(left: id, right: reg_id)
    }) == 0
  })
}


fn ci_upsert_step_row_job_shadow_step_id_ok_for_job(row: CiUpsertStepRow, ci_job: CiJob) -> Bool {
  ci_step_id_eq(left: row.step_id, right: ci_job_shadow_step_id(ci_job: ci_job))
}


fn ci_upsert_step_row_matches_some_job_shadow(row: CiUpsertStepRow, jobs: List<CiJob>) -> Bool {
  count_where(xs: jobs, predicate: fn(j) {
    ci_upsert_step_row_job_shadow_step_id_ok_for_job(row: row, ci_job: j)
  }) != 0
}


fn ci_upsert_rows_match_job_shadow_ids(rows: List<CiUpsertStepRow>, jobs: List<CiJob>) -> Bool {
  for_all(xs: rows, predicate: fn(row) {
    ci_upsert_step_row_matches_some_job_shadow(row: row, jobs: jobs)
  })
}


fn ci_upsert_step_row_gate_shadow_step_id_ok_for_gate(row: CiUpsertStepRow, ci_gate: CiGate) -> Bool {
  ci_step_id_eq(left: row.step_id, right: ci_gate_shadow_step_id(ci_gate: ci_gate))
}


fn ci_upsert_step_row_matches_some_gate_shadow(row: CiUpsertStepRow, gates: List<CiGate>) -> Bool {
  count_where(xs: gates, predicate: fn(g) {
    ci_upsert_step_row_gate_shadow_step_id_ok_for_gate(row: row, ci_gate: g)
  }) != 0
}


fn ci_upsert_step_row_matches_pipeline_shadow(row: CiUpsertStepRow, p: CiPipeline) -> Bool {
  ci_upsert_step_row_matches_some_job_shadow(row: row, jobs: p.jobs)
    || ci_upsert_step_row_matches_some_gate_shadow(row: row, gates: p.gates)
}


fn ci_upsert_rows_match_pipeline_shadow_ids(rows: List<CiUpsertStepRow>, p: CiPipeline) -> Bool {
  for_all(xs: rows, predicate: fn(row) {
    ci_upsert_step_row_matches_pipeline_shadow(row: row, p: p)
  })
}


fn ci_upsert_steps_slice_bijection_for_pipeline(p: CiPipeline, rows: List<CiUpsertStepRow>) -> Bool {
  let slice = ci_upsert_steps_full_in_scope_step_ids
  ci_upsert_steps_registry_ids_unique(rows: rows)
    && ci_upsert_steps_registry_matches_declared_slice(rows: rows, slice: slice)
    && ci_step_id_lists_biject(left: slice, right: ci_pipeline_step_ids_shadow(p: p))
    && ci_upsert_rows_match_pipeline_shadow_ids(rows: rows, p: p)
}


fn ci_selection_decision_step_ids_unique(decisions: List<CiStepSelection>) -> Bool {
  let ids = ci_step_selections_step_ids(decisions: decisions)
  length(xs: ids) == length(xs: unique(xs: ids, eq: ci_step_id_eq))
}


fn ci_pipeline_steps_covered(receipt: CiSelectionReceipt, pipeline: CiPipeline) -> Bool {
  for_all(xs: ci_pipeline_step_ids_shadow(p: pipeline), predicate: fn(step_id) {
    ci_step_id_in_list(id: step_id, ids: ci_step_selections_step_ids(decisions: receipt.decisions))
  })
}


fn ci_selection_receipt_well_formed(receipt: CiSelectionReceipt, pipeline: CiPipeline) -> Bool {
  let expected = ci_pipeline_step_ids_shadow(p: pipeline)
  let got = ci_step_selections_step_ids(decisions: receipt.decisions)
  length(xs: got) == length(xs: expected)
    && ci_selection_decision_step_ids_unique(decisions: receipt.decisions)
    && ci_pipeline_steps_covered(receipt: receipt, pipeline: pipeline)
}


data ci_selection_receipt_shadow_empty_pr: ChangeSet = ChangeSet { changes: [] }

data ci_selection_receipt_shadow_fail_closed_affected: AffectedSet = AffectedSetFailClosed {
  changes: ci_selection_receipt_shadow_empty_pr,
  evidence: AffectedSetReason { reason: ci_selection_shadow_reason }
}

// MW-D8 C4 fixture — v4 workflow touch selects m1 probe Run; v2 compile is carveout CarvedOut.
data ci_selection_receipt_shadow_fixture_git_diff: GitDiffNameOnly = GitDiffNameOnly {
  changed_paths: ["src/v4/workflow/ci.dag"]
}

data ci_selection_receipt_shadow_fixture_affected: AffectedSet = AffectedSetProduced {
  changes: ci_selection_receipt_shadow_empty_pr,
  affected: [],
  exclusions: [],
  restricted_to: []
}

data ci_selection_receipt_shadow_fixture_receipt: CiSelectionReceipt = match ci_pipeline {
  Accepted { value: pl, diagnostics: _ } =>
    ci_selection_receipt_shadow(
      pr: ci_selection_receipt_shadow_empty_pr,
      affected: ci_selection_receipt_shadow_fixture_affected,
      git_diff: ci_selection_receipt_shadow_fixture_git_diff,
      pipeline: pl,
      carveouts: ci_always_run_carveouts,
      registry: ci_upsert_steps
    )
  Rejected { diagnostics: _ } =>
    ci_selection_receipt_shadow(
      pr: ci_selection_receipt_shadow_empty_pr,
      affected: ci_selection_receipt_shadow_fail_closed_affected,
      git_diff: ci_selection_receipt_shadow_fixture_git_diff,
      pipeline: CiPipeline { jobs: [], gates: [] },
      carveouts: ci_always_run_carveouts,
      registry: ci_upsert_steps
    )
}

fn ci_selection_receipt_shadow_fixture_v2_compile_carved_out_holds() -> Bool {
  let step_id = JobStep { job: v2_compile_src_v4, step: v2_compile_src_v4 }
  fold(
    ci_selection_receipt_shadow_fixture_receipt.decisions,
    init: false,
    f: fn(acc, selection) {
      if acc {
        true
      } else if ci_step_id_eq(left: selection.step_id, right: step_id) {
        match selection.decision {
          CarvedOut { carveout_reason: _ } => true
          Run => false
          Skip => false
        }
      } else {
        acc
      }
    }
  )
}

fn ci_selection_receipt_shadow_fixture_m1_probe_run_holds() -> Bool {
  let step_id = JobStep {
    job: m1_rust_emit_probe_execution,
    step: m1_rust_emit_probe_execution
  }
  fold(
    ci_selection_receipt_shadow_fixture_receipt.decisions,
    init: false,
    f: fn(acc, selection) {
      if acc {
        true
      } else if ci_step_id_eq(left: selection.step_id, right: step_id) {
        match selection.decision {
          Run => true
          Skip => false
          CarvedOut { carveout_reason: _ } => false
        }
      } else {
        acc
      }
    }
  )
}

data ci_selection_receipt_shadow_fixture_v2_compile_carved_out_ok: Bool = ci_selection_receipt_shadow_fixture_v2_compile_carved_out_holds()

data ci_selection_receipt_shadow_fixture_m1_probe_run_ok: Bool = ci_selection_receipt_shadow_fixture_m1_probe_run_holds()

data ci_selection_receipt_shadow_fixture_well_formed_ok: Bool = match ci_pipeline {
  Accepted { value: pl, diagnostics: _ } =>
    ci_selection_receipt_well_formed(
      receipt: ci_selection_receipt_shadow_fixture_receipt,
      pipeline: pl
    )
  Rejected { diagnostics: _ } => false
}

// C4 generatability — fixture receipt is well-formed and encodes carveout + affected Run evidence.
// ── Wave 3 §11.7.4 — fixture shadow receipt (modeled selection; NOT live PR / NOT component-flag frontier) ──
data ci_wave3_shadow_fixture_empty_pr: ChangeSet = ChangeSet { changes: [] }

fn ci_wave3_shadow_fixture_fail_closed_receipt_mk(
  testgen_slots: List<TestgenSlotSelection>
) -> CiSelectionReceipt {
  ci_selection_receipt_mk(
    pr: ci_wave3_shadow_fixture_empty_pr,
    affected: ci_wave3_shadow_fail_closed_affected,
    mode: Shadow,
    provenance: FixtureReceipt,
    decisions: Empty,
    testclaim_decisions: ci_wave3_shadow_testclaim_selection_rows(
      affected: ci_wave3_shadow_fail_closed_affected
    ),
    testgen_slots: testgen_slots,
    component_affected_comparison: ci_component_affected_fail_closed()
  )
}

data ci_wave3_shadow_fixture_fail_closed_receipt: Outcome<CiSelectionReceipt> = match ci_wave3_shadow_testgen_selection_rows_outcome(
  affected: ci_wave3_shadow_fail_closed_affected,
  profile_ref: testgen_default_profile_ref
) {
  Accepted { value: testgen_slots, diagnostics: d } =>
    Accepted {
      value: ci_wave3_shadow_fixture_fail_closed_receipt_mk(testgen_slots: testgen_slots),
      diagnostics: d
    }
  Rejected { diagnostics: d } => Rejected { diagnostics: d }
}

data ci_wave3_shadow_selected_testgen_receipt: Outcome<SelectedTestgenReceipt> = ci_testgen_selected_receipt_outcome(
  affected: ci_wave3_shadow_fail_closed_affected,
  profile_ref: testgen_default_profile_ref
)

data ci_wave3_shadow_testgen_run_receipt: Outcome<TestgenRunReceipt> = testgen_run_receipt_outcome(profile_ref: testgen_default_profile_ref)

fn ci_wave3_shadow_testgen_slot_unselected(slot: TestgenSlotSelection) -> Bool {
  if slot.selected {
    false
  } else {
    true
  }
}


fn ci_wave3_shadow_fixture_testgen_not_fail_closed_holds() -> Bool {
  match ci_wave3_shadow_fixture_fail_closed_receipt {
    Accepted { value: receipt, diagnostics: _ } =>
      for_all(
        xs: receipt.testgen_slots,
        predicate: ci_wave3_shadow_testgen_slot_unselected
      )
    Rejected { diagnostics: _ } => false
  }
}

fn ci_wave3_shadow_fixture_testgen_slots_populated_holds() -> Bool {
  match ci_wave3_shadow_fixture_fail_closed_receipt {
    Accepted { value: receipt, diagnostics: _ } =>
      testgen_scheduled_generators_roster_holds()
        && length(xs: receipt.testgen_slots) > 0
    Rejected { diagnostics: _ } => false
  }
}

fn ci_wave3_shadow_testgen_run_receipt_holds() -> Bool {
  match testgen_run_receipt_outcome(profile_ref: testgen_default_profile_ref) {
    Accepted { value: receipt, diagnostics: _ } =>
      testgen_run_receipt_carries_profile_roster(receipt: receipt)
    Rejected { diagnostics: _ } => false
  }
}

fn ci_testgen_selected_receipt_holds(
  affected: AffectedSet,
  profile_ref: Symbol
) -> Bool {
  match ci_testgen_selected_receipt_outcome(affected: affected, profile_ref: profile_ref) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn ci_wave3_shadow_fixture_fail_closed_superset_holds() -> Bool {
  let selected = ci_wave3_shadow_testclaims_selected(affected: ci_wave3_shadow_fail_closed_affected)
  length(xs: selected) == length(xs: ci_wave3_shadow_claim_roster())
}

fn ci_wave3_shadow_fixture_floor_held_holds() -> Bool {
  match ci_wave3_shadow_fixture_fail_closed_receipt {
    Accepted { value: receipt, diagnostics: _ } => ci_floor_held(receipt: receipt)
    Rejected { diagnostics: _ } => false
  }
}

