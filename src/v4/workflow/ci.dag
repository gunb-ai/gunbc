  fold(ci_testclaim_corpus_eval_claim_ids, init: ci_empty_upsert_input_refs(), f: fn(acc, claim_id) {
    list_snoc_item(xs: acc, item: ci_upsert_test_claim_ref_input(claim_id: claim_id))
  })
}

