fn ci_upsert_step_projection_node<T>(step: CiUpsertStep<T>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ci_named_edge(
        name: ci_projection_upsert_inputs_edge,
        target: ci_upsert_input_ref_list_projection_node(refs: step.inputs)
      ),
      ci_named_edge(name: ci_projection_upsert_verify_edge, target: step.verify),
      ci_named_edge(name: ci_projection_upsert_create_edge, target: step.create),
      ci_named_edge(name: ci_projection_upsert_resolve_edge, target: step.resolve),
      ci_named_edge(name: ci_projection_upsert_payload_type_edge, target: step.payload_type)
    ]
  }
}


fn ci_upsert_step_cache_digest<T>(step: CiUpsertStep<T>) -> Hash {
  content_hash(n: ci_upsert_step_projection_node(step: step))
}


fn ci_upsert_step_row_lookup(step_id: CiStepId, rows: List<CiUpsertStepRow>) -> Optional<CiUpsertStepRow> {
  fold(rows, init: Absent, f: fn(acc, row) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        if ci_step_id_eq(left: step_id, right: row.step_id) {
          Present { value: row }
        } else {
          Absent
        }
    }
  })
}


fn ci_upsert_steps_slice_step_ids(rows: List<CiUpsertStepRow>) -> List<CiStepId> {
  fold_list(
    xs: rows,
    empty: Empty,
    cons: fn(acc, row) {
      list_snoc_item(xs: acc, item: row.step_id)
    }
  )
}


fn ci_job_shadow_step_id(ci_job: CiJob) -> CiStepId {
  JobStep { job: ci_job.id, step: ci_job.id }
}


fn ci_gate_shadow_step_id(ci_gate: CiGate) -> CiStepId {
  GateStep { job: ci_gate.job, gate: ci_gate.id }
}


// 🟡 shadow-only — one `JobStep` per `CiJob` (`job.id` as step placeholder) until command-level `CiStepId` migration.
fn ci_job_step_ids_shadow(jobs: List<CiJob>) -> List<CiStepId> {
  fold_list(
    xs: jobs,
    empty: Empty,
    cons: fn(acc, ci_job) {
      list_snoc_item(xs: acc, item: ci_job_shadow_step_id(ci_job: ci_job))
    }
  )
}


fn ci_pipeline_step_ids_shadow(p: CiPipeline) -> List<CiStepId> {
  fold(
    p.gates,
    init: ci_job_step_ids_shadow(jobs: p.jobs),
    f: fn(acc, ci_gate) {
      list_snoc_item(xs: acc, item: ci_gate_shadow_step_id(ci_gate: ci_gate))
    }
  )
}


fn ci_step_selection_shadow_row(step_id: CiStepId) -> CiStepSelection {
  match ci_upsert_step_row_lookup(step_id: step_id, rows: ci_upsert_steps) {
    Present { value: row } =>
      CiStepSelection {
        step_id: step_id,
        inputs_consulted: row.step.inputs,
        affected_intersection: [],
        decision: Run,
        cache_digest: ci_upsert_step_cache_digest(step: row.step),
        reason: ci_selection_shadow_reason
      }
    Absent =>
      CiStepSelection {
        step_id: step_id,
        inputs_consulted: [],
        affected_intersection: [],
        decision: Run,
        cache_digest: content_hash(n: ci_step_id_projection_node(step_id: step_id)),
        reason: ci_selection_shadow_reason
      }
  }
}


fn ci_step_selection_shadow_rows(step_ids: List<CiStepId>) -> List<CiStepSelection> {
  fold_list(
    xs: step_ids,
    empty: Empty,
    cons: fn(acc, sid) {
      list_snoc_item(xs: acc, item: ci_step_selection_shadow_row(step_id: sid))
    }
  )
}


// Shadow heartbeat only — proves receipt carrier shape; NOT dependency-selection evidence.
fn ci_selection_receipt_shadow_heartbeat(
  pr: ChangeSet,
  affected: AffectedSet,
  pipe: CiPipeline
) -> CiSelectionReceipt {
  CiSelectionReceipt {
    pr: pr,
    affected: affected,
    decisions: ci_step_selection_shadow_rows(step_ids: ci_pipeline_step_ids_shadow(p: pipe))
  }
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature:ci-upsert-step-migration — bound target: W-T-10 exact structural equality / compiler-provided closed-sum equality — dissolve-on-arrival: replace `ci_step_id_eq` call sites with substrate closed-sum equality for `CiStepId` and delete this helper; forbidden: permanent per-variant equality table drift from `CiStepId`.
fn ci_step_id_eq(left: CiStepId, right: CiStepId) -> Bool {
  match left {
    JobStep { job: left_job, step: left_step } =>
      match right {
        JobStep { job: right_job, step: right_step } =>
          left_job == right_job && left_step == right_step
        GateStep { job: _, gate: _ } => false
      }
    GateStep { job: left_job, gate: left_gate } =>
      match right {
        GateStep { job: right_job, gate: right_gate } =>
          left_job == right_job && left_gate == right_gate
        JobStep { job: _, step: _ } => false
      }
  }
}


fn ci_step_selection_step_id(row: CiStepSelection) -> CiStepId {
  row.step_id
}


fn ci_step_selections_step_ids(decisions: List<CiStepSelection>) -> List<CiStepId> {
  fold_list(
    xs: decisions,
    empty: Empty,
    cons: fn(acc, row) {
      list_snoc_item(xs: acc, item: ci_step_selection_step_id(row: row))
    }
  )
}


fn ci_step_id_in_list(id: CiStepId, ids: List<CiStepId>) -> Bool {
  count_where(xs: ids, predicate: fn(candidate) {
    ci_step_id_eq(left: id, right: candidate)
  }) != 0
}


fn ci_step_ids_subset_of(xs: List<CiStepId>, universe: List<CiStepId>) -> Bool {
  for_all(xs: xs, predicate: fn(id) {
    ci_step_id_in_list(id: id, ids: universe)
  })
}


fn ci_step_id_lists_biject(left: List<CiStepId>, right: List<CiStepId>) -> Bool {
  length(xs: left) == length(xs: right)
    && ci_step_ids_subset_of(xs: left, universe: right)
    && ci_step_ids_subset_of(xs: right, universe: left)
}


fn ci_upsert_steps_registry_ids_unique(rows: List<CiUpsertStepRow>) -> Bool {
  let ids = ci_upsert_steps_slice_step_ids(rows: rows)
  length(xs: ids) == length(xs: rows)
    && length(xs: ids) == length(xs: unique(xs: ids, eq: ci_step_id_eq))
}


fn ci_upsert_steps_registry_matches_declared_slice(
  rows: List<CiUpsertStepRow>,
  slice: List<CiStepId>
) -> Bool {
  ci_step_id_lists_biject(
    left: ci_upsert_steps_slice_step_ids(rows: rows),
    right: slice
  )
}


fn ci_upsert_steps_slice_subset_of_pipeline_shadow(p: CiPipeline, slice: List<CiStepId>) -> Bool {
  ci_step_ids_subset_of(xs: slice, universe: ci_pipeline_step_ids_shadow(p: p))
}


// Out-of-scope steps remain in shadow universe but not in the Bucket A registry (§2.1 partial close).
fn ci_upsert_steps_slice_strict_subset_of_pipeline_shadow(p: CiPipeline, slice: List<CiStepId>) -> Bool {
  let shadow = ci_pipeline_step_ids_shadow(p: p)
  ci_step_ids_subset_of(xs: slice, universe: shadow)
    && length(xs: slice) != length(xs: shadow)
}


fn ci_upsert_step_row_job_shadow_step_id_ok_for_job(row: CiUpsertStepRow, ci_job: CiJob) -> Bool {
  ci_step_id_eq(left: row.step_id, right: ci_job_shadow_step_id(ci_job: ci_job))
}


fn ci_upsert_step_row_matches_some_job_shadow(row: CiUpsertStepRow, jobs: List<CiJob>) -> Bool {
  count_where(xs: jobs, predicate: fn(j) {
    ci_upsert_step_row_job_shadow_step_id_ok_for_job(row: row, ci_job: j)
  }) != 0
}


fn ci_upsert_rows_match_job_shadow_ids(rows: List<CiUpsertStepRow>, jobs: List<CiJob>) -> Bool {
  for_all(xs: rows, predicate: fn(row) {
    ci_upsert_step_row_matches_some_job_shadow(row: row, jobs: jobs)
  })
}


fn ci_upsert_steps_slice_bijection_for_pipeline(p: CiPipeline, rows: List<CiUpsertStepRow>) -> Bool {
  let slice = ci_upsert_steps_bucket_a_slice_step_ids
  ci_upsert_steps_registry_ids_unique(rows: rows)
    && ci_upsert_steps_registry_matches_declared_slice(rows: rows, slice: slice)
    && ci_upsert_steps_slice_subset_of_pipeline_shadow(p: p, slice: slice)
    && ci_upsert_steps_slice_strict_subset_of_pipeline_shadow(p: p, slice: slice)
    && ci_upsert_rows_match_job_shadow_ids(rows: rows, jobs: p.jobs)
}


fn ci_selection_decision_step_ids_unique(decisions: List<CiStepSelection>) -> Bool {
  let ids = ci_step_selections_step_ids(decisions: decisions)
  length(xs: ids) == length(xs: unique(xs: ids, eq: ci_step_id_eq))
}


fn ci_pipeline_steps_covered(receipt: CiSelectionReceipt, pipeline: CiPipeline) -> Bool {
  for_all(xs: ci_pipeline_step_ids_shadow(p: pipeline), predicate: fn(step_id) {
    ci_step_id_in_list(id: step_id, ids: ci_step_selections_step_ids(decisions: receipt.decisions))
  })
}


fn ci_selection_receipt_well_formed(receipt: CiSelectionReceipt, pipeline: CiPipeline) -> Bool {
  let expected = ci_pipeline_step_ids_shadow(p: pipeline)
  let got = ci_step_selections_step_ids(decisions: receipt.decisions)
  length(xs: got) == length(xs: expected)
    && ci_selection_decision_step_ids_unique(decisions: receipt.decisions)
    && ci_pipeline_steps_covered(receipt: receipt, pipeline: pipeline)
}


data ci_selection_receipt_shadow_empty_pr: ChangeSet = ChangeSet { changes: [] }

data ci_selection_receipt_shadow_fail_closed_affected: AffectedSet = AffectedSetFailClosed {
  changes: ci_selection_receipt_shadow_empty_pr,
  evidence: AffectedSetReason { reason: ci_selection_shadow_reason }
}

// Shadow heartbeat data — NOT evidence that affected-set dependency selection works.
data ci_selection_receipt_shadow_heartbeat_mode: CiSelectionReceipt = match ci_pipeline {
  Accepted { value: pl, diagnostics: _ } =>
    ci_selection_receipt_shadow_heartbeat(
      pr: ci_selection_receipt_shadow_empty_pr,
      affected: ci_selection_receipt_shadow_fail_closed_affected,
      pipe: pl
    )
  Rejected { diagnostics: _ } =>
    ci_selection_receipt_shadow_heartbeat(
      pr: ci_selection_receipt_shadow_empty_pr,
      affected: ci_selection_receipt_shadow_fail_closed_affected,
      pipe: CiPipeline { jobs: [], gates: [] }
    )
}


fn ci_selection_receipt_shadow_well_formed_for_pipeline(p: CiPipeline) -> Bool {
  ci_selection_receipt_well_formed(
    receipt: ci_selection_receipt_shadow_heartbeat(
      pr: ci_selection_receipt_shadow_empty_pr,
      affected: ci_selection_receipt_shadow_fail_closed_affected,
      pipe: p
    ),
    pipeline: p
  )
}


data ci_selection_receipt_shadow_well_formed_ok: Bool = match ci_pipeline {
  Accepted { value: pl, diagnostics: _ } =>
    ci_selection_receipt_shadow_well_formed_for_pipeline(p: pl)
  Rejected { diagnostics: _ } => false
}


data ci_upsert_steps_slice_bijection_ok: Bool = match ci_pipeline {
  Accepted { value: pl, diagnostics: _ } =>
    ci_upsert_steps_slice_bijection_for_pipeline(p: pl, rows: ci_upsert_steps)
  Rejected { diagnostics: _ } => false
}


// W2.3 falsification §10.0 #3 — identical inputs, different create → distinct cache digests.
data ci_upsert_cache_digest_create_sensitivity_inputs: List<UpsertInputRef> = [
  ci_upsert_file_set_input(segment: "src/v4/workflow/ci.dag")
]

data ci_upsert_cache_digest_create_sensitivity_a: CiUpsertStep<Symbol> = CiUpsertStep<Symbol> {
  inputs: ci_upsert_cache_digest_create_sensitivity_inputs
  verify: ci_atom(sym: ci_selection_shadow_reason)
  create: ci_atom(sym: ci_cache_cmd_m1_probe_tag)
  resolve: ci_atom(sym: ci_selection_shadow_reason)
  payload_type: ci_atom(sym: ci_cache_cmd_m1_probe_tag)
}

data ci_upsert_cache_digest_create_sensitivity_b: CiUpsertStep<Symbol> = CiUpsertStep<Symbol> {
  inputs: ci_upsert_cache_digest_create_sensitivity_inputs
  verify: ci_atom(sym: ci_selection_shadow_reason)
  create: ci_atom(sym: ci_cache_cmd_phase1_nat_semiring_rung_gate_tag)
  resolve: ci_atom(sym: ci_selection_shadow_reason)
  payload_type: ci_atom(sym: ci_cache_cmd_phase1_nat_semiring_rung_gate_tag)
}

fn ci_upsert_cache_digest_create_sensitivity_witness_holds() -> Bool {
  ci_upsert_step_cache_digest(step: ci_upsert_cache_digest_create_sensitivity_a)
    != ci_upsert_step_cache_digest(step: ci_upsert_cache_digest_create_sensitivity_b)
}

data ci_upsert_cache_digest_create_sensitivity_witness: Bool =
  ci_upsert_cache_digest_create_sensitivity_witness_holds()


fn test_claim_typed_input_ci_pipeline(
  evaluator_input: CiPipeline,
  evaluator_pin: Symbol
) -> TestClaimTypedInput<CiPipeline> {
  TestClaimTypedInput {
    evaluator_input: evaluator_input,
    evaluator_pin: evaluator_pin
  }
}


fn ci_test_claim_evaluator_digest(input: TestClaimTypedInput<CiPipeline>) -> Hash {
  content_hash(
    n: ci_pipeline_evaluator_input_node(
      pipeline: input.evaluator_input,
      evaluator_pin: input.evaluator_pin
    )
  )
}


// 🟢 derived-operation — feature:T22-EVAL-PASS-RECEIPT — LB-T22-3213 negative-coverage plan-bound receipt.
type WorkflowPipelinePlanBoundPassReceipt {
  run: TestClaimRun<CiPipeline, CiPipeline>
  plan_hash: Hash
}


// Reads original `run.verdict` (not `workflow_pipeline_pass_gate` output): pass_gate rewraps `Fail.actual` as `Accepted { value: run }`.
fn workflow_pipeline_receipt_failure_diagnostics(
  run: TestClaimRun<CiPipeline, CiPipeline>
) -> List<Diagnostic> {
  match run.verdict {
    Fail { actual: Rejected { diagnostics: ds }, falsification: _ } => ds
    // Unreachable from `workflow_pipeline_plan_bound_pass_receipt` Fail arm today; honest tag if call sites change.
    _ =>
      diagnostics_singleton(d: ci_diagnostic(reason: ci_workflow_receipt_unexpected_verdict))
  }
}


// Pass arm is intentionally lossy (`aggregate_verdicts` Pass carries no payload); `workflow_pipeline_plan_bound_pass_receipt` closes over the original `run` on Pass.
fn workflow_pipeline_pass_gate(
  run: TestClaimRun<CiPipeline, CiPipeline>,
  at: Node
) -> Verdict<TestClaimEvalSubject<CiPipeline>, TestClaimRun<CiPipeline, CiPipeline>> {
  aggregate_verdicts(
    rs: [
      match run.verdict {
        Pass => Pass
        Fail { actual: _, falsification: _ } =>
          Fail { actual: Accepted { value: run, diagnostics: None }, falsification: Absent }
        Deferred { actual: _, diagnostic: d } =>
          Deferred { actual: Accepted { value: run, diagnostics: None }, diagnostic: d }
      }
    ],
    at: at
  )
}


fn workflow_pipeline_plan_bound_pass_receipt(
  run: TestClaimRun<CiPipeline, CiPipeline>,
  at: Node
) -> Outcome<WorkflowPipelinePlanBoundPassReceipt> {
  match workflow_pipeline_pass_gate(run: run, at: at) {
    Pass =>
      match ci_bootstrap_plan_cache_hash() {
        Accepted { value: plan_hash, diagnostics: _ } =>
          Accepted {
            value: WorkflowPipelinePlanBoundPassReceipt {
              run: run,
              plan_hash: plan_hash
            },
            diagnostics: None
          }
        Rejected { diagnostics: ds } => Rejected { diagnostics: ds }
      }
    Fail { actual: _, falsification: _ } =>
      Rejected { diagnostics: workflow_pipeline_receipt_failure_diagnostics(run: run) }
    Deferred { actual: _, diagnostic: d } =>
      Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}


fn ci_test_claim_cache_interpretation_hash(subject: TestClaimEvalSubject<CiPipeline>) -> Hash {
  combine_hash(
    a: inferred_tree_digest(tree: subject.tree),
    b: combine_hash(
      a: test_claim_interpretation_cache_digest(context: subject.context),
      b: ci_test_claim_evaluator_digest(input: subject.input)
    )
  )
}


fn test_claim_cache_key_interpretation_hash_ci_pipeline(key: TestClaimCacheKey<CiPipeline>) -> Hash {
  ci_test_claim_cache_interpretation_hash(subject: key.eval_subject)
}


fn test_claim_cache_receipt_pinned(subject: TestClaimEvalSubject<CiPipeline>) -> TestClaimCacheReceipt<CiPipeline> {
  TestClaimCacheReceipt {
    key: TestClaimCacheKey {
      eval_subject: subject
    }
  }
}


fn ci_pipeline_well_formed(p: CiPipeline) -> Outcome<CiPipeline> {
  if ci_all_job_ids_unique(jobs: p.jobs) {
    if ci_all_gate_ids_unique(gates: p.gates) {
      if ci_all_needs_resolve(jobs: p.jobs) {
        if ci_all_gate_jobs_resolve(gates: p.gates, jobs: p.jobs) {
          if ci_all_gate_run_policies_resolve(gates: p.gates, jobs: p.jobs) {
            if ci_acyclic(jobs: p.jobs) {
              if ci_all_commands_authority_ok(jobs: p.jobs) {
                Accepted { value: p, diagnostics: None }
              } else {
                Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_bootstrap_authority_violation)) }
              }
            } else {
              Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dependency_cycle)) }
            }
          } else {
            Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
          }
        } else {
          Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
        }
      } else {
        Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_dangling_reference)) }
      }
    } else {
      Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_gate_id)) }
    }
  } else {
    Rejected { diagnostics: diagnostics_singleton(d: ci_diagnostic(reason: ci_duplicate_job_id)) }
  }
}


fn test_claim_in_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}


fn ci_select_from_rerun_nodes(roster: List<TestClaim>, rerun: RerunNodeSet) -> List<TestClaim> {
  match rerun {
    RerunNodeSetProduced { nodes: nodes } =>
      filter(
        xs: roster,
        predicate: fn(claim) {
          test_claim_ci_selection_fail_closed(c: claim)
            || test_claim_in_rerun_frontier(claim: claim, frontier: nodes)
        }
      )
    RerunNodeSetFailClosed { evidence: _ } => roster
  }
}


fn ci_select_from_affected_set(roster: List<TestClaim>, affected: AffectedSet) -> List<TestClaim> {
  ci_select_from_rerun_nodes(
    roster: roster,
    rerun: affected_set_rerun_nodes(affected_set_value: affected)
  )
}


fn ci_repo_path_has_prefix(path: RepoPath, prefix: RepoPath) -> Bool {
  is_prefix_of(prefix: prefix, xs: path, eq: fn(left, right) { left == right })
}


fn ci_changed_path_affects_v2(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v2/")
    || changed == "Cargo.toml"
    || changed == "Cargo.lock"
}


fn ci_changed_path_affects_v3(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v3/")
    || ci_repo_path_has_prefix(path: changed, prefix: "dsl/")
}


fn ci_changed_path_affects_v4(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: "src/v4/")
    || ci_repo_path_has_prefix(path: changed, prefix: "fixtures/v4-mvp1/")
    || changed == "scripts/v4-mvp1-e2e-gate.sh"
    || changed == "scripts/v4-m1-rust-emit-probe.sh"
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-mvp1")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-m1")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-phase1-nat-semiring")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/v4-testclaim-")
    || ci_repo_path_has_prefix(path: changed, prefix: "dsl/std/")
    || changed == "Cargo.toml"
    || changed == "Cargo.lock"
}


fn ci_changed_path_affects_workflow_policy(changed: RepoPath) -> Bool {
  ci_repo_path_has_prefix(path: changed, prefix: ".github/workflows/")
    || changed == "src/v4/workflow/ci.dag"
    || ci_repo_path_has_prefix(path: changed, prefix: "src/v4/workflow/ci/")
    || ci_repo_path_has_prefix(path: changed, prefix: "tools/ci_affected_components")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/check-workflow-path-regex-inventory")
    || ci_repo_path_has_prefix(path: changed, prefix: "scripts/workflow-path-regex-forbidden-substrings")
}

// RELEASE_TODO §5 Phase 1a–1b — release workflow + hand-synced install scripts.
fn ci_changed_path_affects_release_distribution(changed: RepoPath) -> Bool {
  changed == "src/v4/workflow/release.dag"
    || changed == ".github/workflows/release.yml"
    || changed == "install.sh"
    || changed == "scripts/release-target-triples.sh"
    || changed == "src/v4/install/install.dag"
}


fn ci_changed_path_triggers_ci_component(changed: RepoPath) -> Bool {
  ci_changed_path_affects_v2(changed: changed)
    || ci_changed_path_affects_v3(changed: changed)
    || ci_changed_path_affects_v4(changed: changed)
    || ci_changed_path_affects_workflow_policy(changed: changed)
    || ci_changed_path_affects_release_distribution(changed: changed)
}


// Per-path: release lane, or no CI component bucket (avoid `!` in list predicates — tokenizer).
fn ci_changed_path_in_release_only_lane(changed: RepoPath) -> Bool {
  match ci_changed_path_affects_release_distribution(changed: changed) {
    true => true
    false =>
      match ci_changed_path_triggers_ci_component(changed: changed) {
        true => false
        false => true
      }
  }
}


// RELEASE §5 — skip orthogonal fixture gates only when the diff is exclusively
// release-distribution paths (mixed release + phase1 fixture paths must not skip).
fn ci_release_distribution_only_from_git_diff(git_diff: GitDiffNameOnly) -> Bool {
  any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_release_distribution)
    && all(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_in_release_only_lane
    )
}


fn ci_component_affected_fail_closed() -> CiComponentAffected {
  CiComponentAffected {
    v2: true
    v3: true
    v4: true
    workflow_policy: true
    release_distribution: true
    release_distribution_only: false
  }
}


fn ci_component_affected_from_git_diff(git_diff: GitDiffNameOnly) -> CiComponentAffected {
  CiComponentAffected {
    v2: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v2),
    v3: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v3),
    v4: any(xs: git_diff.changed_paths, predicate: ci_changed_path_affects_v4),
    workflow_policy: any(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_affects_workflow_policy
    ),
    release_distribution: any(
      xs: git_diff.changed_paths,
      predicate: ci_changed_path_affects_release_distribution
    ),
    release_distribution_only: ci_release_distribution_only_from_git_diff(git_diff: git_diff)
  }
}


fn ci_component_affected_from_git_diff_read(outcome: Outcome<GitDiffNameOnly>) -> CiComponentAffected {
  match outcome {
    Accepted { value: git_diff, diagnostics: _ } =>
      ci_component_affected_from_git_diff(git_diff: git_diff)
    Rejected { diagnostics: _ } => ci_component_affected_fail_closed()
  }
}


fn ci_int_positive(n: Int) -> Bool {
  n >= 1
}


fn ci_runner_pool_capacity_valid(pool: SelfHostedRunnerPool) -> Bool {
  ci_int_positive(n: pool.core_count)
    && ci_int_positive(n: pool.runner_count)
    && ci_int_positive(n: pool.jobserver_token_cap)
}


fn ci_runner_pool_fleet_capacities_valid() -> Bool {
  for_all(xs: ci_self_hosted_runner_pools, predicate: ci_runner_pool_capacity_valid)
}


// RULING-1: 🟢 operator fact — M1 rust-emit probe `cargo check --jobs` cap (operator 2026-05-28).
// Wave-0: explicit constant, not fleet-derived (jobserver÷runner allocation rule unpublished).
// ci_srv1_pool/ci_srv2_pool retain host capacity facts for YamlStatic projection follow-on (T-24/#98).
data m1_probe_cargo_check_jobs: Int = 4


fn ci_char_projection_out_of_range_injective_witness() -> Bool {
  content_hash(n: ci_char_projection_node(c: int_add(a: 255, b: 1))) !=
    content_hash(n: ci_char_projection_node(c: int_add(a: 255, b: 2)))
    && content_hash(n: ci_char_projection_node(c: int_negate(i: 1))) !=
      content_hash(n: ci_char_projection_node(c: int_negate(i: 2)))
}


// SG-7 / T-22: in-range chars use std `byte_offset_cache_key_projection_node` — distinct content_hash (no aliasing).
fn ci_char_projection_in_range_injective_witness() -> Bool {
  content_hash(n: ci_char_projection_node(c: 0)) !=
    content_hash(n: ci_char_projection_node(c: 1))
    && content_hash(n: ci_char_projection_node(c: 97)) !=
      content_hash(n: ci_char_projection_node(c: 98))
    && content_hash(n: ci_char_projection_node(c: 254)) !=
      content_hash(n: ci_char_projection_node(c: 255))
}


fn ci_char_projection_matches_std_cache_key_projection_witness() -> Bool {
  content_hash(n: ci_char_projection_node(c: 0)) ==
    content_hash(n: byte_offset_cache_key_projection_node(i: 0))
    && content_hash(n: ci_char_projection_node(c: 97)) ==
      content_hash(n: byte_offset_cache_key_projection_node(i: 97))
    && content_hash(n: ci_char_projection_node(c: 255)) ==
      content_hash(n: byte_offset_cache_key_projection_node(i: 255))
}


fn ci_char_projection_byte_limb_boundary_witness() -> Bool {
  content_hash(n: ci_char_projection_node(c: 255)) !=
    content_hash(n: ci_char_projection_node(c: int_add(a: 255, b: 1)))
    && content_hash(n: ci_char_projection_node(c: int_negate(i: 1))) !=
      content_hash(n: ci_char_projection_node(c: 0))
}


fn ci_char_projection_cache_hash_surface_witness() -> Bool {
  ci_char_projection_in_range_injective_witness()
    && ci_char_projection_matches_std_cache_key_projection_witness()
    && ci_char_projection_byte_limb_boundary_witness()
    && ci_char_projection_out_of_range_injective_witness()
}


// Receipt: out-of-byte-range Char projections stay distinguishable under evaluator-input content_hash.
data ci_char_projection_out_of_range_injective_ok: Bool = ci_char_projection_out_of_range_injective_witness()

// Receipt: SG-7 cache-key projection surface pinned for evaluator-input content_hash (worksheet §3 probes 2–3).
data ci_char_projection_cache_hash_surface_ok: Bool = ci_char_projection_cache_hash_surface_witness()
