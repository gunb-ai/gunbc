data ci_pipeline: Outcome<CiPipeline> = ci_pipeline_well_formed(p: CiPipeline {
  jobs: [
    CiJob {
      id: v2_compile_src_v4,
      command: BootstrapStageCompile { produces: v4_stage0_binary },
      needs: []
    },
    CiJob {
      id: lens_ci_registry_execution,
      command: LensCiCommand { required_lenses: lens_ci_required_lenses },
      needs: [v2_compile_src_v4]
    },
    CiJob {
      id: m1_rust_emit_probe_execution,
      command: M1RustEmitProbeCommand,
      needs: [v2_compile_src_v4]
    },
    CiJob {
      id: testclaim_corpus_eval_execution,
      command: TestClaimCorpusEvalCommand { selection_fn: ci_testclaim_corpus_selection_fn },
      needs: [v2_compile_src_v4]
    },
    CiJob {
      id: phase1_nat_semiring_rung_gate_execution,
      command: Phase1NatSemiringRungGateCommand,
      needs: [v2_compile_src_v4]
    }
  ],
  gates: [
    CiGate {
      id: structural_v2_compile,
      job: v2_compile_src_v4,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    },
    CiGate {
      id: lens_ci_registry_signal,
      job: lens_ci_registry_execution,
      run_policy: Always
    },
    CiGate {
      id: m1_rust_emit_probe_signal,
      job: m1_rust_emit_probe_execution,
      run_policy: Always
    },
    CiGate {
      id: testclaim_corpus_eval_signal,
      job: testclaim_corpus_eval_execution,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    },
    CiGate {
      id: phase1_nat_semiring_rung_gate_signal,
      job: phase1_nat_semiring_rung_gate_execution,
      run_policy: RequiresJobAttempt { job: v2_compile_src_v4 }
    }
  ]
})


// ── W2.3 Phase 1.5 — CiUpsertStep rows (Bucket A FileSet slice) ─────────────────────────────
// In-scope: job steps expressible with `FileSet` inputs only (§2.1 bucket A).
// Out-of-scope (later buckets): lens_ci_registry_execution (LensOutputRef), testclaim_corpus_eval_execution
// (TestClaimRef), all five `GateStep` rows (UpstreamUpsert — bucket E).

type CiUpsertStepRow {
  step_id: CiStepId
  step: CiUpsertStep<Symbol>
}

data ci_upsert_v2_compile_src_v4: CiUpsertStep<Symbol> = CiUpsertStep<Symbol> {
  inputs: [
    ci_upsert_file_set_input(segment: "src/v2/**"),
    ci_upsert_file_set_input(segment: "Cargo.toml"),
    ci_upsert_file_set_input(segment: "Cargo.lock")
  ]
  verify: ci_command_projection_node(
    c: BootstrapStageCompile { produces: v4_stage0_binary }
  )
  create: ci_job_projection_node(
    j: CiJob {
      id: v2_compile_src_v4,
      command: BootstrapStageCompile { produces: v4_stage0_binary },
      needs: []
    }
  )
  resolve: ci_atom(sym: v4_stage0_binary)
  payload_type: ci_atom(sym: ci_cache_cmd_bootstrap_compile_tag)
}

data ci_upsert_m1_rust_emit_probe_execution: CiUpsertStep<Symbol> = CiUpsertStep<Symbol> {
  inputs: [
    ci_upsert_file_set_input(segment: "src/v4/**"),
    ci_upsert_file_set_input(segment: "scripts/v4-m1*"),
    ci_upsert_file_set_input(segment: "Cargo.toml"),
    ci_upsert_file_set_input(segment: "Cargo.lock")
  ]
  verify: ci_atom(sym: ci_cache_cmd_m1_probe_tag)
  create: ci_job_projection_node(
    j: CiJob {
      id: m1_rust_emit_probe_execution,
      command: M1RustEmitProbeCommand,
      needs: [v2_compile_src_v4]
    }
  )
  resolve: ci_atom(sym: m1_rust_emit_probe_execution)
  payload_type: ci_atom(sym: ci_cache_cmd_m1_probe_tag)
}

data ci_upsert_phase1_nat_semiring_rung_gate_execution: CiUpsertStep<Symbol> = CiUpsertStep<Symbol> {
  inputs: [
    ci_upsert_file_set_input(segment: "scripts/v4-phase1-nat-semiring*"),
    ci_upsert_file_set_input(segment: "src/v4/**")
  ]
  verify: ci_atom(sym: ci_cache_cmd_phase1_nat_semiring_rung_gate_tag)
  create: ci_job_projection_node(
    j: CiJob {
      id: phase1_nat_semiring_rung_gate_execution,
      command: Phase1NatSemiringRungGateCommand,
      needs: [v2_compile_src_v4]
    }
  )
  resolve: ci_atom(sym: phase1_nat_semiring_rung_gate_execution)
  payload_type: ci_atom(sym: ci_cache_cmd_phase1_nat_semiring_rung_gate_tag)
}

data ci_upsert_steps: List<CiUpsertStepRow> = [
  CiUpsertStepRow {
    step_id: JobStep { job: v2_compile_src_v4, step: v2_compile_src_v4 },
    step: ci_upsert_v2_compile_src_v4
  },
  CiUpsertStepRow {
    step_id: JobStep { job: m1_rust_emit_probe_execution, step: m1_rust_emit_probe_execution },
    step: ci_upsert_m1_rust_emit_probe_execution
  },
  CiUpsertStepRow {
    step_id: JobStep {
      job: phase1_nat_semiring_rung_gate_execution,
      step: phase1_nat_semiring_rung_gate_execution
    },
    step: ci_upsert_phase1_nat_semiring_rung_gate_execution
  }
]

