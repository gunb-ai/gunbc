type CiSchedulePolicy = PullRequest | MainPush | Nightly

// 🟡 coproduct dissolution — LB-P4-3213
type CiCommand
  = LintCommand
  | TestCommand
  | IgnoredTestCommand { test_name: String }
  | LensCiCommand { required_lenses: List<LensIdV0> }
  | BootstrapStageCompile { produces: Symbol }
  | V2BootstrapCompileCommand
  | V3DeterminismCommand { profile: CiBuildProfile }
  | V3SelfHostFixedPointCommand { profile: CiBuildProfile, schedule: CiSchedulePolicy }
  | V4T15SelfHostFixedPointCommand
  | M1RustEmitProbeCommand
  | LeafModelGoVerifyCommand
  // 🟡 gated — feature:t38-testclaim-corpus-eval — bind src/v4/TASKS.md T-38 + docs/planning/v4-p5-structural-bridge-replacement-worksheet-2026-05-30.md §1.4 — structural-slice CLOSED: shell bridge deleted; positive-Y `ci_upsert_testclaim_corpus_eval_*` sole structural authority; selection_fn must equal ci_testclaim_corpus_selection_fn (ci_select_from_affected_set); ci_select_from_affected_set narrows roster to content_hash frontier (IRT-1); verdict_surface must name the T-22 manual CorpusEvalReport surface (`manual_corpus_node_subject_rows` -> `run_manual_testclaim_corpus_eval` -> `corpus_report_tally` -> `witness_manual_corpus_gate_closed`) plus `manual_testclaim_subject_roster_family_receipt` using declaration-qualified authorities so per-row TestClaimEvalSubject -> run_test_claim -> TestClaimRun verdict facts are projected, not replaced by host-owned strings. Forbidden: bypassing narrowing to run full corpus unconditionally or reporting corpus status outside the modeled TestClaimRun roster.
  | TestClaimCorpusEvalCommand { selection_fn: Symbol, verdict_surface: TestClaimCorpusVerdictSurfaceAuthority }
  // T-38B family receipt — lens_ownership subjects are rostered in `src/v4/test/claim/lens_ownership/subject_roster.dag` and evaluated by `workflow/lens_ownership_family_eval.dag` through run_test_claim.
  | LensOwnershipFamilyEvalCommand { verdict_surface: LensOwnershipFamilyVerdictSurfaceAuthority }
  // F.11b/H.7.2 source-authority receipt consumption — CI consumes the Branch H.7.2 TestClaim
  // declarations directly. Forbidden: debug-artifact evidence or CI-local placeholder
  // claim symbols in place of `v4.test.claim.round_trip.source_authority_contract`.
  | SourceAuthorityReceiptEvalCommand { claims: List<Symbol> }
  // 🟡 gated — feature:phase1-nat-semiring-rung-gate — bind https://github.com/gunb-ai/gunbc/pull/3946 §2.5 (Ladder/Fixture Manager spec, lands as docs/planning/v4-ladder-rung-specs-2026-05-30.md on merge) — dissolve-on-arrival: delete scripts/v4-phase1-nat-semiring-rung-gate.sh and the paired CI step when TestClaimRun verdicts evaluate phase1_nat_semiring_rung_0_to_2_roster (v4.test.claim.nat_semiring.rung_0_to_2_three_targets) and emit PROVEN rung0/rung1/rung2 receipts; until then the host transport carries the §2.4 verdict matrix. Authority: Ladder/Fixture Manager (PR #3938 §11.1 lane 2). Forbidden: repurposing M1RustEmitProbeCommand for fixture-scoped gates (corpus-wide diagnostic, not fixture×rung) or repurposing TestClaimCorpusEvalCommand (full-corpus T-38, narrows by affected-set not by fixture roster).
  | Phase1NatSemiringRungGateCommand

