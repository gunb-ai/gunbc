  arch: Symbol
  core_count: Int // 🟡 gated: formatter-int-refinement — must be ≥1 (operator fleet spec)
  runner_count: Int // 🟡 gated: formatter-int-refinement — must be ≥1
  jobserver_token_cap: Int // 🟡 gated: formatter-int-refinement — must be ≥1
}

