// 🟡 gated — CI build-cache projection NOT YET MODELED HERE — feature:elastic-cache-interface
//   — authority: dsl/std/cache_interface.dag (Modeling DFS Worksheet B; landed PR #4095). The
//   internal planning worksheets (elastic-cache-interface / elastic-ci-redesign) were deleted in
//   #4192 for the public-repo flip, so the in-repo substrate file + that PR are the durable refs.
//   The backend substrate already landed in dsl/std/cache_interface.dag as first-authority
//   `CacheInterfaceFacts` rows: `sccache_local_facts` (PerHostFilesystem),
//   `cargo_target_dir_facts` (PerRunnerFilesystem), `gha_actions_cache_facts`,
//   `buildbuddy_cas_facts`, `rustup_toolchain_store_facts`. The MISSING piece is this file's
//   consumer (cache_interface.dag line 20: "consumer: ci harness cache projection"): nothing in
//   src/v4/workflow/*.dag imports cache_interface yet, so the ci_floor cache transport is still
//   hand-authored `actions/cache` blocks in .github/workflows/ci.yml.
//   dissolve-on-arrival: when this projection lands, the ci_floor `Cache Cargo` / `Cache gunbc
//   binary` steps in ci.yml are projected from cache_key_projection over these facts (identity =
//   content_hash(canonical Upsert<T> subject), NOT hashFiles), and the interim hand blocks below
//   are deleted. forbidden (per the cache_interface.dag identity discipline): hand-authored cache
//   keys at any layer (`hashFiles(...)`, `cache_key:` strings, sccache `--cache-mode-key`) as the
//   standing design, and stacking sccache/`RUSTC_WRAPPER` into ci.yml ahead of `CacheInterfaceFacts`
//   projection (the "immediate local patch" the worksheet named as a P2 violation).
//   INTERIM (operator 2026-06-01, "stop the bleeding"): the ci.yml `Cache Cargo` key was
//   de-churned (Cargo.lock+toolchain only) so restores actually hit and stop evicting the warm
//   v2 `gunbc-bin` cache. This is transport repair of an existing block, not new design surface,
//   and does NOT touch the two dominant ci_floor steps (M1 emit-probe cargo-check ~13m, v2→v4
//   bootstrap ~9m) — those compile freshly-emitted trees in $RUNNER_TEMP whose target/ is
//   discarded each run, so only content-addressed sccache (the modeled projection) can warm them.
//   INTERIM (operator 2026-06-01, "disregard the memo for now and implement this in ci.yml";
//   PR #4248, merged): the standing prohibition above notwithstanding, the operator explicitly
//   directed wiring `RUSTC_WRAPPER=sccache` + `CARGO_INCREMENTAL=0` into the three cargo jobs'
//   "Isolate toolchain dirs" step — gated fail-safe on the runner's inherited isolated sccache
//   socket dir (ghrunner-owned /var/lib/ctrl/sccache-ci, ctrl#1419) — to get a real cross-run
//   cargo-check speedup before the modeled projection lands. This is a sanctioned, bounded
//   deviation, NOT new standing design surface and NOT a second cache-key authority: the env wire
//   carries no hand-authored cache key (sccache derives its own content hash internally), so it
//   does not introduce the `hashFiles`/`cache_key:`/`--cache-mode-key` parallel authority the
//   prohibition targets. Same dissolve-on-arrival as the hand blocks above: when the
//   cache_interface projection consumer lands, the sccache env is projected from
//   `sccache_local_facts` and this interim wire (and its mirror in
//   dsl/gunbc/ci_github_actions_workflow.dag) is deleted.

data lens_ci_required_lenses: List<LensIdV0> = [
  Complexity,
  Cost,
  Parallelism,
  EffectEnumeration,
  Idempotency,
  UnusedParameters
]

data lens_ci_live_workflow_signal: LensCiLiveWorkflowSignal = {
  smoke_step_name: "Lens-CI registry activation smoke"
  semantic_step_name: "Lens-CI registry semantic v4 compile (rust target)"
  semantic_target: "rust"
}

data m1_ci_live_workflow_signal: M1CiLiveWorkflowSignal = {
  step: CiLiveWorkflowStepSignal {
    binding_smoke_step_name: "M1 v4 workflow CI model/YAML binding smoke"
    step_name: "M1 v4 full-tree rust emit probe (v2 emit + cargo check)"
    script_path: "scripts/v4-m1-rust-emit-probe.sh"
    non_blocking: false
    timeout_minutes: 20
    strict_env_binding: StrictEnvBinding { var: "V4_M1_RUST_EMIT_PROBE_STRICT", value: "0" }
  }
  rust_emit_probe_policy: M1RustEmitProbePolicy {
    emit_preconditions_block_required_path: true
    rustc_residuals_block_required_path: false
  }
}

data ci_v3_determinism_profile: CiBuildProfile = Release
data ci_v3_self_host_fixed_point_profile: CiBuildProfile = Release

// 🟡 gated — live-workflow projection interim (Practice 10) — feature:ci-bankruptcy-tier0-gha-step-if — consumers: ci_v3_self_host_fixed_point_ci_live_workflow_binding, ci_v4_bootstrap_gate_result_skip_guard_if, ci.yml Tier-0 step blocks — bind docs/design-ci-bankruptcy-rebuild.md §3.3 I4 D1 / B0 harness — dissolve-on-arrival: A15 Shape-B emits step `if` from `ci_job_scheduled_by_policy` + `CiComponentAffected` outputs (delete raw `if_condition` / guard String carriers); until then these two bindings are the sole Tier-0 GHA-if bridge; forbidden: additional untagged raw GitHub Actions `if:` string authorities for bankruptcy Tier-0 steps.
type CiGhaWorkflowStepBinding {
  step_name: String
  if_condition: String
}

data ci_v3_self_host_fixed_point_ci_live_workflow_binding: CiGhaWorkflowStepBinding = {
  step_name: "v3 self-host fixed point (Tier-0 I4)"
  if_condition: "needs.affected.outputs.v3 == 'true' || (github.event_name == 'push' && github.ref == 'refs/heads/main')"
}

data ci_v4_bootstrap_gate_result_skip_guard_if: String = "if: always() && (needs.affected.outputs.v4 == 'true' || needs.affected.outputs.testclaim_corpus == 'true' || needs.affected.outputs.workflow_policy == 'true' || needs.affected.outputs.release_distribution == 'true') && steps.v4_bootstrap_compile.outcome != 'skipped'"

fn ci_job_testclaim_corpus_eval_execution_mk() -> CiJob {
  CiJob {
    id: testclaim_corpus_eval_execution,
    command: TestClaimCorpusEvalCommand { selection_fn: ci_testclaim_corpus_selection_fn },
    needs: [v2_compile_src_v4, m1_rust_emit_probe_execution]
  }
}

data ci_job_testclaim_corpus_eval_execution_row: CiJob = ci_job_testclaim_corpus_eval_execution_mk()

