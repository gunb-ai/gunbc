// Tier-0 integrity scheduling (docs/design-ci-bankruptcy-rebuild.md §2–3).
type CiBuildProfile = Smoke | Release | FixedPointMatrix

type CiSchedulePolicy = PullRequest | MainPush | Nightly

// 🟡 coproduct dissolution — LB-P4-3213
type CiCommand
  = LintCommand
  | TestCommand
  | IgnoredTestCommand { test_name: String }
  | LensCiCommand { required_lenses: List<LensIdV0> }
  | BootstrapStageCompile { produces: Symbol }
  | V2BootstrapCompileCommand
  | V3DeterminismCommand { profile: CiBuildProfile }
  | V3SelfHostFixedPointCommand { profile: CiBuildProfile, schedule: CiSchedulePolicy }
  | V4T15SelfHostFixedPointCommand
  | M1RustEmitProbeCommand
  // 🟡 gated — feature:t38-testclaim-corpus-eval — bind src/v4/TASKS.md T-38 — dissolve-on-arrival: delete scripts/v4-testclaim-corpus-gate.sh and the paired CI step when the modeled runner evaluates src/v4/test/claim/manual/*.dag via T-22 eval and emits structured TestClaimRun verdicts; selection_fn must equal ci_testclaim_corpus_selection_fn (ci_select_from_affected_set) — forbidden: setting selection_fn to any other symbol or bypassing narrowing to run full corpus unconditionally.
  | TestClaimCorpusEvalCommand { selection_fn: Symbol }

type CiJob {
  id: Symbol
  command: CiCommand
  needs: List<Symbol>
}

type CiGate {
  id: Symbol
  job: Symbol
  run_policy: CiGateRunPolicy
}

// 🟡 coproduct dissolution — feature:project-github-actions-run-policy (docs/r3-program-plan.md gates #98/#100) — dissolve-on-arrival: emitted/projected GitHub Actions workflow reads `CiGate.run_policy` directly and this interim live-projection policy carrier is deleted; forbidden: adding GitHub Actions-only gate conditions outside `CiGate.run_policy`.
type CiGateRunPolicy
  = Always
  | RequiresJobAttempt { job: Symbol }

type CiPipeline {
  jobs: List<CiJob>
  gates: List<CiGate>
}

