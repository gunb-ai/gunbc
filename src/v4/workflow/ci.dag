// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).
//
// ─────────────────────────────────────────────────────────────────────
// Modeling notes
//
// DATA, not a runner: `CiPipeline` is the gunbc job/gate dependency DAG
// (the affected-set surface) as inert structure.
//
// NO FABRICATION / SINGLE AUTHORITY (P1/P2). A faithful ci.yml needs
// GHA transport facts (`on`/`runs-on`/`steps`/concurrency/permissions)
// that `{ jobs, gates }` deliberately omits; a `CiPipeline -> ci.yml`
// projection would fabricate them. No projection is authored: it must
// FEED the RATIFIED single authority — v3's `extdeps.github.actions`
// `Workflow` carrier pinned on `gunbc.ci CIWorkflowDag`, with
// `project_github_actions(CIWorkflowDag, WorkflowRuntime) -> Workflow`
// (`ci_emission.dag`); ci.yml is that carrier under
// `WorkflowRuntime = YamlStatic`, never a parallel `-> YamlValue`. That
// v4 substrate is MISSING (new extdeps file = operator-tier, not a
// worker add); until it lands the committed ci.yml is the explicit
// interim hand-authored bridge and C4 is a gated FUTURE state. The
// frozen Owns/C4 header was reconciled IN-PR per DECISIONS.md D5/#3216
// (operator-tier BLOCKING review actions) — see the HEADER RECONCILE
// block in the header above; C4 intent preserved, only mechanism
// corrected.
//
// `CiJob.needs` / `CiGate.job` are opaque `Symbol` name-references (a
// DAG by name, never producer-inlining). `command` is NON-EXECUTABLE
// documentation data (P1): no interpreter exists (process carrier is
// T-4.5 scaffold) and one `String` can't carry a GHA job; it stores
// the exact primary gate invocation VERBATIM (not a paraphrase). The
// full step + spawn are deferred (TRACKED SCAFFOLD (3)), not fabricated.
//
// TRACKED SCAFFOLD (🟡) — deferred operations, owner+trigger
// (declarative-now; not bodiless `fn`, DECISIONS PARSE-1):
//   (1) C4 projection = the ratified `project_github_actions(
//       CIWorkflowDag, WorkflowRuntime) -> Workflow` seam (NOT a
//       worker-minted `-> YamlValue`). OWNER/TRIGGER: BLOCKED on the
//       missing v4 counterpart of `extdeps.github.actions { Workflow }`
//       + `ci_emission.dag` (operator-tier), then yaml_emit (T-4.6) +
//       05_emit Shape-B (T-10).
//   (2) `select_jobs : (CiPipeline, Diff) -> Outcome<List<CiJob>>` —
//       affected-set selection only (well-formedness is eagerly
//       enforced now by `ci_pipeline_well_formed`, NOT deferred here).
//       OWNER/TRIGGER: lens/affected_set.dag (T-21) lands.
//   (3) executable per-job eval + structural cache rides
//       compiler/05_eval.dag + extdeps/process.dag.
//       OWNER/TRIGGER: T-22 + T-4.5. Today only the structural gate is
//       exercised (`v2_compile_gate_job` models the real day-1 gate).
//
// All declarations are Conj records — no coproduct, no Practice-4
// ledger applies.

module v4.workflow.ci


import v4.std.node { Symbol }
import v4.std.diagnostic {
  Correction,
  Diagnostic,
  Extent,
  Locus,
  NoCorrectionReason,
  Outcome
}


// ─────────────────────────────────────────────────────────────────────
// CiJob — one CI job. `id` is its opaque identity; `needs` are the job
// ids it depends on (DAG by `Symbol`); `command` is NON-EXECUTABLE
// documentation data (verbatim primary gate invocation; full step +
// spawn deferred — TRACKED SCAFFOLD (3)).
type CiJob {
  id: Symbol
  command: String
  needs: List<Symbol>
}


// ─────────────────────────────────────────────────────────────────────
// CiGate — a required check: the pipeline is GREEN only if the job
// named `job` succeeds. Gates are the affected-set/STOP surface (a
// failing gate is conspicuous and STOP-routed, A3 machine).
type CiGate {
  id: Symbol
  job: Symbol
}


// ─────────────────────────────────────────────────────────────────────
// CiPipeline — the gunbc job/gate dependency DAG AS DATA (the
// affected-set-selection surface). It is NOT, by itself, a present C4
// authority for `.github/workflows/ci.yml`: the faithful projection
// feeds the ratified single-authority `Workflow` carrier via
// `project_github_actions(CIWorkflowDag, WorkflowRuntime) -> Workflow`,
// whose v4 counterpart is missing substrate (TRACKED SCAFFOLD (1) +
// HONEST SCOPE OF THE C4 CLAIM above). Affected-set selection over
// `jobs` is TRACKED SCAFFOLD (2).
//
// WELL-FORMEDNESS — an EAGER fail-closed boundary, present NOW
// (INVARIANTS P2/P4; still-hawk-102 operator adjudication 2026-05-17).
// #3162 (`Diff`) does NOT govern `CiPipeline`: a job/gate DAG has
// INTRINSIC, statically-decidable well-formedness (unique ids, no
// `needs` cycle, resolving refs) — malformed independent of any
// consumer — so deferring to `select_jobs` is ruled out. The PREFERRED
// structural shape (`jobs: Map` for unique ids) is INFEASIBLE: v4
// `Map<K,V>` is `{ lookup: fn(K) -> Witness<V> }` — lookup-only, no key
// enumeration — so it can't be traversed for the required acyclicity /
// ref checks. So jobs/gates stay `List` and `ci_pipeline_well_formed :
// CiPipeline -> Outcome<CiPipeline>` (below) eagerly checks all three:
// unique ids (node.dag `all_names_distinct` CHECK-enforced precedent),
// reference resolution, and acyclicity (Kahn sink-elimination bounded
// by `count(jobs)` as a `fold` over the finite jobs list — A2 IMPLICIT,
// P4-decidable, never a non-terminating walk). NOT a #3162 exception
// (#3162 never governed this carrier). Single authority — like
// node.dag's `node_well_formed`, authored now, consumed by the still
// deferred `select_jobs`.
type CiPipeline {
  jobs: List<CiJob>
  gates: List<CiGate>
}


// ─────────────────────────────────────────────────────────────────────
// Job/gate identities. `Symbol` is opaque (K-1, no spelling accessor);
// a Symbol value is a declared name (std/integer.dag reason-symbol
// precedent: `data x: Symbol = x`).
data v2_compile_src_v4: Symbol = v2_compile_src_v4
data structural_v2_compile: Symbol = structural_v2_compile


// ─────────────────────────────────────────────────────────────────────
// The structural v2-compile gate — the existing day-1 CI gate modeled
// concretely: v2 indexes/compiles src/v4 (the parse-viability step that
// keeps the .dag corpus v2-bridge-clean). `command` is the EXACT
// primary gate invocation from .github/workflows/ci.yml, VERBATIM (not
// a paraphrase — codex BLOCKING 2026-05-17); it is NON-EXECUTABLE
// documentation data here. The faithful FULL step (`set -euo pipefail`
// / `rm -rf /tmp/v4-stage1` / `mkdir -p` / `echo` wrapper) and its
// prerequisite `cargo build -p v2-compiler --release` are carried by
// the deferred process carrier (extdeps/process.dag T-4.5 + T-22),
// TRACKED SCAFFOLD (3) — NOT fabricated into this String. This is the
// ONLY job modeled today; the executable lane is deferred.
data v2_compile_gate_job: CiJob = CiJob {
  id: v2_compile_src_v4,
  command: "target/release/v2-compiler compile --source-root src/v4 --output-dir /tmp/v4-stage1 --target dag",
  needs: []
}

data ci_pipeline: CiPipeline = CiPipeline {
  jobs: [v2_compile_gate_job],
  gates: [
    CiGate { id: structural_v2_compile, job: v2_compile_src_v4 }
  ]
}



// ─────────────────────────────────────────────────────────────────────
// Well-formedness reasons — Symbol name-references owned by this file
// (std/integer.dag reason-symbol precedent: `data x: Symbol = x`).
data ci_duplicate_job_id: Symbol = ci_duplicate_job_id
data ci_dangling_reference: Symbol = ci_dangling_reference
data ci_dependency_cycle: Symbol = ci_dependency_cycle
data ci_workflow_file: Symbol = ci_workflow_file


// One Diagnostic shape for every malformed-pipeline reason: a malformed
// pipeline has many valid repairs and the compiler will not pick one
// (`AmbiguousIntent` — the no-engine STOP; integer.dag precedent). The
// locus is the whole ci.dag authority file.
fn ci_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: Textual { file: ci_workflow_file, extent: WholeFile },
    correction: Unavailable { reason: AmbiguousIntent }
  }
}


// How many declared jobs carry `id` (the node.dag `name_occurrences`
// idiom; `Symbol` equality is the one K-1 operation).
fn ci_id_occurrences(id: Symbol, jobs: List<CiJob>) -> Int {
  fold(jobs, init: 0, f: fn(acc, j) {
    if j.id == id { acc + 1 } else { acc }
  })
}

fn ci_symbol_resolves(s: Symbol, jobs: List<CiJob>) -> Bool {
  fold(jobs, init: false, f: fn(acc, j) {
    acc || (j.id == s)
  })
}

fn ci_member(s: Symbol, ids: List<Symbol>) -> Bool {
  fold(ids, init: false, f: fn(acc, x) {
    acc || (x == s)
  })
}

// All job ids distinct — the node.dag `all_names_distinct` precedent
// (CHECK-enforced uniqueness, node.dag:513).
fn ci_all_job_ids_unique(jobs: List<CiJob>) -> Bool {
  fold(jobs, init: true, f: fn(acc, j) {
    acc && (ci_id_occurrences(id: j.id, jobs: jobs) == 1)
  })
}

// Every `needs` symbol resolves to a declared job id.
fn ci_all_needs_resolve(jobs: List<CiJob>) -> Bool {
  fold(jobs, init: true, f: fn(acc, j) {
    acc && fold(j.needs, init: true, f: fn(acc2, n) {
      acc2 && ci_symbol_resolves(s: n, jobs: jobs)
    })
  })
}

// Every gate's target job resolves to a declared job id.
fn ci_all_gate_jobs_resolve(gates: List<CiGate>, jobs: List<CiJob>) -> Bool {
  fold(gates, init: true, f: fn(acc, g) {
    acc && ci_symbol_resolves(s: g.job, jobs: jobs)
  })
}

// The `needs` list of the job named `id` (empty if absent — id
// uniqueness/resolution are separately checked).
fn ci_job_needs(id: Symbol, jobs: List<CiJob>) -> List<Symbol> {
  fold(jobs, init: [], f: fn(acc, j) {
    if j.id == id { j.needs } else { acc }
  })
}

// Does job `id` still have a `needs` edge into `remaining`?
fn ci_blocked(id: Symbol, remaining: List<Symbol>, jobs: List<CiJob>) -> Bool {
  fold(ci_job_needs(id: id, jobs: jobs), init: false, f: fn(acc, n) {
    acc || ci_member(s: n, ids: remaining)
  })
}

// One Kahn pass: keep only ids still blocked (pointing into
// `remaining`); sinks (no edge into remaining) are eliminated.
fn ci_eliminate_pass(remaining: List<Symbol>, jobs: List<CiJob>) -> List<Symbol> {
  fold(remaining, init: [], f: fn(acc, id) {
    if ci_blocked(id: id, remaining: remaining, jobs: jobs) {
      concat([id], acc)
    } else {
      acc
    }
  })
}

// Run `count(jobs)` elimination passes — the proven sufficient bound
// for Kahn termination. Expressed as a `fold` over the finite `jobs`
// list (A2 IMPLICIT — descent on a finite List; the element is an
// unused bounded counter), so the whole check terminates (INVARIANTS
// P4) and is never an unbounded walk.
fn ci_kahn_fixpoint(jobs: List<CiJob>) -> List<Symbol> {
  fold(jobs, init: map(jobs, fn(j) { j.id }), f: fn(remaining, counter) {
    ci_eliminate_pass(remaining: remaining, jobs: jobs)
  })
}

// Acyclic iff Kahn elimination empties the remaining set.
fn ci_acyclic(jobs: List<CiJob>) -> Bool {
  count(ci_kahn_fixpoint(jobs: jobs)) == 0
}


// ci_pipeline_well_formed — the EAGER fail-closed well-formedness
// boundary (see the WELL-FORMEDNESS header block). Authored NOW; the
// single authority a (deferred) `select_jobs` consumes. All three
// intrinsic, statically-decidable properties are checked here; any
// violation is one fail-closed `Diagnostic` (no fabrication, no
// repair-guess — `AmbiguousIntent`).
fn ci_pipeline_well_formed(p: CiPipeline) -> Outcome<CiPipeline> {
  if ci_all_job_ids_unique(jobs: p.jobs) {
    if ci_all_needs_resolve(jobs: p.jobs) {
      if ci_all_gate_jobs_resolve(gates: p.gates, jobs: p.jobs) {
        if ci_acyclic(jobs: p.jobs) {
          Produced { value: p }
        } else {
          Rejected { diagnostic: ci_diagnostic(reason: ci_dependency_cycle) }
        }
      } else {
        Rejected { diagnostic: ci_diagnostic(reason: ci_dangling_reference) }
      }
    } else {
      Rejected { diagnostic: ci_diagnostic(reason: ci_dangling_reference) }
    }
  } else {
    Rejected { diagnostic: ci_diagnostic(reason: ci_duplicate_job_id) }
  }
}
