// #4091 §1.2 four-compile collapse — lens-CI semantic v4 compile consumes v2_compile_src_v4's
// resolved closure via UpstreamUpsert (appended to the per-lens output refs) and re-emits its
// rust target, rather than re-running the front-end over the 332-source src/v4 closure.
data ci_upsert_lens_ci_registry_execution_inputs: List<UpsertInputRef> = list_snoc_item(
  xs: ci_upsert_lens_inputs_from_required_lenses(lenses: lens_ci_required_lenses),
  item: ci_upsert_upstream_job_input(job: v2_compile_src_v4)
)

fn ci_upsert_lens_ci_registry_execution_mk() -> CiUpsertStepSymbol {
  CiUpsertStepSymbol {
  inputs: ci_upsert_lens_ci_registry_execution_inputs
  verify: ci_command_projection_node(
    c: LensCiCommand { required_lenses: lens_ci_required_lenses }
  )
  create: ci_job_projection_node(
    j: CiJob {
      id: lens_ci_registry_execution,
      command: LensCiCommand { required_lenses: lens_ci_required_lenses },
      needs: [v2_compile_src_v4]
    }
  )
  resolve: ci_atom(sym: lens_ci_registry_execution)
  payload_type: ci_atom(sym: ci_cache_cmd_lens_ci_tag)
  }
}

data ci_upsert_lens_ci_registry_execution: CiUpsertStepSymbol = ci_upsert_lens_ci_registry_execution_mk()

