// src/v4/workflow/affected_set_selection.dag
//
// Minimal affected-set → TestClaim selection authority.
// Selection routes through v4.std.probe_selector ONE probe_select kernel.

module v4.workflow.affected_set_selection

import v4.std.logic { Bool }
import v4.std.collection { List }
import v4.std.change { AffectedSet }
import v4.std.node { Node }
import v4.std.verification {
  TestClaim,
  test_claim_evaluation_touches_rerun_frontier
}
import v4.lens.affected_set {
  RerunNodeSet,
  RerunNodeSetFailClosed,
  RerunNodeSetProduced
}
import v4.std.probe_selector {
  CiFailClosedPrior,
  diagnostic_capability_ci_in_repo,
  probe_ci_unbounded_budget,
  probe_select_affected_test_claims,
  probe_select_rerun_test_claims,
  probe_select_test_claims
}

fn test_claim_in_rerun_frontier(claim: TestClaim, frontier: List<Node>) -> Bool {
  test_claim_evaluation_touches_rerun_frontier(c: claim, frontier: frontier)
}

fn ci_select_from_rerun_nodes(roster: List<TestClaim>, rerun: RerunNodeSet) -> List<TestClaim> {
  match rerun {
    RerunNodeSetProduced { nodes: nodes } =>
      probe_select_rerun_test_claims(
        roster: roster,
        frontier: nodes,
        budget: probe_ci_unbounded_budget,
        available: diagnostic_capability_ci_in_repo()
      )
    RerunNodeSetFailClosed { evidence: _ } =>
      probe_select_test_claims(
        roster: roster,
        prior: CiFailClosedPrior {},
        budget: probe_ci_unbounded_budget,
        available: diagnostic_capability_ci_in_repo()
      )
  }
}

fn ci_select_from_affected_set(roster: List<TestClaim>, affected: AffectedSet) -> List<TestClaim> {
  probe_select_affected_test_claims(
    roster: roster,
    affected: affected,
    budget: probe_ci_unbounded_budget,
    available: diagnostic_capability_ci_in_repo()
  )
}
