// Status: runtime law — modality discrimination + sample-marker field preservation.
// C9 post-delete standing gates: nonempty-by-execution + perturb (no committed oracle).
// Host transport: scripts/v4-substrate-equivalence-gate.sh (--perturb-check).

module v4.test.workflow.unified_test_claim_substrate_equivalence


import v4.std.diagnostic { Accepted, Rejected }
import v4.std.logic { Bool }
import v4.std.verification {
  EvalOnly,
  NodeCorpus,
  UnifiedBoolWitnessModality,
  UnifiedNodeCorpusModality,
  UnifiedTestClaim,
  bool_witness_descriptor,
  bool_witness_matches_entry_function,
  unified_test_claim_bool_witness,
  unified_test_claim_modality
}
import v4.test.lens_affected_set.edit_locus_resolver {
  edit_locus_narrow_resolution_holds_symbol,
  unified_claim_edit_locus_narrow
}
import v4.std.text { String }
import v4.test.manual.eval_runtime_mvp { claim_eval_mvp2_test_claim_route }
import v4.test.workflow.host_discovered_owned_data_manifest {
  host_owned_data_discovery_receipt
}
// Sample-marker transport authority only — full discovered-set C9 equality is host-gated.
data substrate_equivalence_sample_bool_witness_entry: String = "src/v4/test/claim/lens_affected_set/edit_locus_resolver.dag"


fn substrate_equivalence_sample_bool_unified_claim() -> UnifiedTestClaim {
  unified_claim_edit_locus_narrow
}


fn substrate_equivalence_sample_node_corpus_claim() -> UnifiedTestClaim {
  NodeCorpus {
    claim: claim_eval_mvp2_test_claim_route,
    transport: EvalOnly
  }
}


fn substrate_equivalence_glob_discovery_marker_preserves_entry_function() -> Bool {
  match unified_test_claim_bool_witness(c: substrate_equivalence_sample_bool_unified_claim()) {
    Accepted { value: w, diagnostics: None } =>
      bool_witness_matches_entry_function(
        w: w,
        entry: substrate_equivalence_sample_bool_witness_entry,
        function: edit_locus_narrow_resolution_holds_symbol
      )
    Rejected { diagnostics: _ } => false
  }
}


fn substrate_equivalence_bool_modality_discriminates() -> Bool {
  match unified_test_claim_modality(c: substrate_equivalence_sample_bool_unified_claim()) {
    UnifiedBoolWitnessModality => true
    UnifiedNodeCorpusModality => false
  }
}


fn substrate_equivalence_node_corpus_modality_discriminates() -> Bool {
  match unified_test_claim_modality(c: substrate_equivalence_sample_node_corpus_claim()) {
    UnifiedNodeCorpusModality => true
    UnifiedBoolWitnessModality => false
  }
}


fn substrate_equivalence_unified_claim_preserves_bool_fields() -> Bool {
  match unified_test_claim_bool_witness(c: substrate_equivalence_sample_bool_unified_claim()) {
    Accepted { value: extracted, diagnostics: None } =>
      match unified_test_claim_bool_witness(c: bool_witness_descriptor(w: extracted)) {
        Accepted { value: w, diagnostics: None } =>
          bool_witness_matches_entry_function(
            w: w,
            entry: substrate_equivalence_sample_bool_witness_entry,
            function: edit_locus_narrow_resolution_holds_symbol
          )
        Rejected { diagnostics: _ } => false
      }
    Rejected { diagnostics: _ } => false
  }
}


fn substrate_equivalence_discovery_set_is_nonempty_by_execution() -> Bool {
  host_owned_data_discovery_receipt.unified_claim_arm_count > 0
}


fn substrate_equivalence_holds() -> Bool {
  substrate_equivalence_discovery_set_is_nonempty_by_execution()
    && substrate_equivalence_glob_discovery_marker_preserves_entry_function()
    && substrate_equivalence_bool_modality_discriminates()
    && substrate_equivalence_node_corpus_modality_discriminates()
    && substrate_equivalence_unified_claim_preserves_bool_fields()
}


data witness_substrate_equivalence: Bool = substrate_equivalence_holds()
