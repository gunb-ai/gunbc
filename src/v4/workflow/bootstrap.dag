// src/v4/workflow/bootstrap.dag
// Scope: v4-owned bootstrap orchestration AS DATA — four stages (seed→stage0→stage1→stage2, fixpt stage1==stage2); v2 pipeline is the initial executor, per-stage v4-executor migration deferred.
// Owns: SeedToStage0, Stage0ToStage1, Stage1ToStage2, FixptStage1Stage2, BootstrapPlan, bootstrap_plan
// Consumes: v4.std.node
// Status: filled — orchestration defined as data (v2-delegating bodies); structural v2 gate only.

module v4.workflow.bootstrap

import v4.std.node { Symbol }

data v4_dag_source: Symbol = v4_dag_source
data v4_stage0_binary: Symbol = v4_stage0_binary
data v4_stage1_binary: Symbol = v4_stage1_binary
data v4_stage2_binary: Symbol = v4_stage2_binary
data v2_pipeline: Symbol = v2_pipeline
data bit_identical_check: Symbol = bit_identical_check

type SeedToStage0 {
  consumes: Symbol
  produces: Symbol
  via: Symbol
}

type Stage0ToStage1 {
  consumes: Symbol
  produces: Symbol
  via: Symbol
}

type Stage1ToStage2 {
  consumes: Symbol
  produces: Symbol
  via: Symbol
}

type FixptStage1Stage2 {
  left: Symbol
  right: Symbol
  via: Symbol
}

type BootstrapPlan {
  seed: SeedToStage0
  self0: Stage0ToStage1
  self1: Stage1ToStage2
  fixpt: FixptStage1Stage2
}

data bootstrap_plan: BootstrapPlan = BootstrapPlan {
  seed: SeedToStage0 {
    consumes: v4_dag_source,
    produces: v4_stage0_binary,
    via: v2_pipeline
  },
  self0: Stage0ToStage1 {
    consumes: v4_dag_source,
    produces: v4_stage1_binary,
    via: v2_pipeline
  },
  self1: Stage1ToStage2 {
    consumes: v4_dag_source,
    produces: v4_stage2_binary,
    via: v2_pipeline
  },
  fixpt: FixptStage1Stage2 {
    left: v4_stage1_binary,
    right: v4_stage2_binary,
    via: bit_identical_check
  }
}
