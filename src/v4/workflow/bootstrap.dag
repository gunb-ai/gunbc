// src/v4/workflow/bootstrap.dag
// Scope: bootstrap chain (seed→stage0→stage1→stage2→fixpt) AS DATA; v2 `run` interprets it.
// Owns: SeedToStage0, Stage0ToStage1, Stage1ToStage2, FixptStage1Stage2, BootstrapPlan, bootstrap_plan
// Consumes: (none; interpret + fixed-point deferred)
// Status: filled — declarative core; structural v2 gate only.

module v4.workflow.bootstrap

type SeedToStage0 {}
type Stage0ToStage1 {}
type Stage1ToStage2 {}
type FixptStage1Stage2 {}

type BootstrapPlan {
  seed: SeedToStage0
  self0: Stage0ToStage1
  self1: Stage1ToStage2
  fixpt: FixptStage1Stage2
}

data bootstrap_plan: BootstrapPlan = BootstrapPlan {
  seed: SeedToStage0 {},
  self0: Stage0ToStage1 {},
  self1: Stage1ToStage2 {},
  fixpt: FixptStage1Stage2 {}
}
