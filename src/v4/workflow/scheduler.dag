// src/v4/workflow/scheduler.dag
// Scope: dependency-graph execution scheduler surface.
// Status: D2 scheduler-first slice — runnable frontier is the execution dual of affected-set
// frontier selection, projected through v4.std.dependency readiness folds.

module v4.workflow.scheduler

import v4.std.collection { List }
import v4.std.algebra {
  filter,
  for_all,
  list_append,
  list_snoc_item,
  non_empty
}
import v4.std.dependency {
  DependencyView,
  ReadinessLayer,
  dependency_lens,
  topological_layers
}
import v4.std.node { Node }

type RunnableFrontier {
  ready: List<Node>
}

type SchedulerPlan {
  runnable: RunnableFrontier
  layers: List<ReadinessLayer>
}

type SchedulerLayerFoldAcc {
  scheduled: List<Node>
  layers: List<ReadinessLayer>
}

fn scheduler_node_in_list(nodes: List<Node>, needle: Node) -> Bool {
  fold(nodes, init: false, f: fn(found, node) {
    found || (node == needle)
  })
}

fn scheduler_append_node_once(nodes: List<Node>, node: Node) -> List<Node> {
  if scheduler_node_in_list(nodes: nodes, needle: node) {
    nodes
  } else {
    list_snoc_item(xs: nodes, item: node)
  }
}

fn scheduler_dependency_nodes(dependencies: List<DependencyView>) -> List<Node> {
  fold(dependencies, init: [], f: fn(nodes, dependency) {
    scheduler_append_node_once(
      nodes: scheduler_append_node_once(nodes: nodes, node: dependency.source),
      node: dependency.dependent
    )
  })
}

fn scheduler_dependency_unblocked(
  dependency: DependencyView,
  scheduled: List<Node>,
  candidate: Node
) -> Bool {
  if dependency.dependent == candidate {
    scheduler_node_in_list(nodes: scheduled, needle: dependency.source)
  } else {
    true
  }
}

fn scheduler_node_unblocked(
  dependencies: List<DependencyView>,
  scheduled: List<Node>,
  candidate: Node
) -> Bool {
  for_all(
    xs: dependencies,
    predicate: fn(dependency) {
      scheduler_dependency_unblocked(
        dependency: dependency,
        scheduled: scheduled,
        candidate: candidate
      )
    }
  )
}

fn scheduler_node_unscheduled(scheduled: List<Node>, candidate: Node) -> Bool {
  scheduler_node_in_list(nodes: scheduled, needle: candidate) == false
}

fn runnable_frontier_from_dependencies(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  scheduled: List<Node>
) -> RunnableFrontier {
  RunnableFrontier {
    ready: filter(
      xs: nodes,
      predicate: fn(candidate) {
        scheduler_node_unscheduled(scheduled: scheduled, candidate: candidate)
          && scheduler_node_unblocked(
            dependencies: dependencies,
            scheduled: scheduled,
            candidate: candidate
          )
      }
    )
  }
}

fn scheduler_layer_fold_step(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  acc: SchedulerLayerFoldAcc
) -> SchedulerLayerFoldAcc {
  let runnable = runnable_frontier_from_dependencies(
    nodes: nodes,
    dependencies: dependencies,
    scheduled: acc.scheduled
  )
  if non_empty(xs: runnable.ready) {
    SchedulerLayerFoldAcc {
      scheduled: list_append(left: acc.scheduled, right: runnable.ready),
      layers: list_snoc_item(
        xs: acc.layers,
        item: ReadinessLayer { ready: runnable.ready }
      )
    }
  } else {
    acc
  }
}

fn scheduler_layers_from_dependencies(
  nodes: List<Node>,
  dependencies: List<DependencyView>
) -> List<ReadinessLayer> {
  fold(nodes, init: SchedulerLayerFoldAcc { scheduled: [], layers: [] }, f: fn(acc, _) {
    scheduler_layer_fold_step(nodes: nodes, dependencies: dependencies, acc: acc)
  }).layers
}

fn scheduler_plan_from_dependencies(
  nodes: List<Node>,
  dependencies: List<DependencyView>
) -> SchedulerPlan {
  SchedulerPlan {
    runnable: runnable_frontier_from_dependencies(
      nodes: nodes,
      dependencies: dependencies,
      scheduled: []
    ),
    layers: scheduler_layers_from_dependencies(nodes: nodes, dependencies: dependencies)
  }
}

fn runnable_frontier(graph_node: Node) -> RunnableFrontier {
  let dependencies = dependency_lens(root: graph_node)
  runnable_frontier_from_dependencies(
    nodes: scheduler_dependency_nodes(dependencies: dependencies),
    dependencies: dependencies,
    scheduled: []
  )
}

fn scheduler_layers(graph_node: Node) -> List<ReadinessLayer> {
  let dependencies = dependency_lens(root: graph_node)
  let nodes = scheduler_dependency_nodes(dependencies: dependencies)
  scheduler_layers_from_dependencies(nodes: nodes, dependencies: dependencies)
}

fn scheduler_plan(graph_node: Node) -> SchedulerPlan {
  let dependencies = dependency_lens(root: graph_node)
  let nodes = scheduler_dependency_nodes(dependencies: dependencies)
  scheduler_plan_from_dependencies(nodes: nodes, dependencies: dependencies)
}

fn dependency_fold_layers(graph_node: Node) -> List<ReadinessLayer> {
  topological_layers(graph_node: graph_node)
}
