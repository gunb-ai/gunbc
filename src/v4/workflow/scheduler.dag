// src/v4/workflow/scheduler.dag
// Scope: dependency-graph execution scheduler surface.
// Status: D2 scheduler-first slice — runnable frontier is the execution dual of affected-set
// frontier selection, projected through v4.std.dependency readiness folds.

module v4.workflow.scheduler

import v4.std.collection { List }
import v4.std.algebra {
  contains,
  filter,
  for_all,
  list_snoc_item,
  non_empty
}
import v4.std.dependency {
  BarrierBefore,
  BootstrapDependsOn,
  DataDependsOn,
  DependencyView,
  EffectDependsOn,
  ReadinessLayer,
  ResourceDependsOn,
  topological_layers
}
import v4.std.node { Node }

type RunnableFrontier {
  ready: List<Node>
}

type SchedulerBlockedEvidence
  = SchedulerNoRunnableFrontier { unscheduled: List<Node> }

type SchedulerPlan
  = SchedulerPlanProduced {
      layers: List<ReadinessLayer>
    }
  | SchedulerPlanBlocked {
      evidence: SchedulerBlockedEvidence
    }

type SchedulerFirstReadinessLayer
  = SchedulerFirstReadinessLayerMissing
  | SchedulerFirstReadinessLayerFound { layer: ReadinessLayer }

fn scheduler_dependency_orders_execution(dependency: DependencyView) -> Bool {
  match dependency.kind {
    DataDependsOn => true
    EffectDependsOn => true
    ResourceDependsOn => true
    BarrierBefore => true
    BootstrapDependsOn => true
    _ => false
  }
}

fn scheduler_execution_dependencies(dependencies: List<DependencyView>) -> List<DependencyView> {
  filter(xs: dependencies, predicate: scheduler_dependency_orders_execution)
}

fn scheduler_append_node_once(nodes: List<Node>, node: Node) -> List<Node> {
  if contains(xs: nodes, item: node, eq: fn(left, right) { left == right }) {
    nodes
  } else {
    list_snoc_item(xs: nodes, item: node)
  }
}

fn scheduler_dependency_nodes(dependencies: List<DependencyView>) -> List<Node> {
  fold(dependencies, init: [], f: fn(nodes, dependency) {
    scheduler_append_node_once(
      nodes: scheduler_append_node_once(nodes: nodes, node: dependency.source),
      node: dependency.dependent
    )
  })
}

fn scheduler_dependency_unblocked(
  dependency: DependencyView,
  scheduled: List<Node>,
  candidate: Node
) -> Bool {
  if dependency.dependent == candidate {
    contains(xs: scheduled, item: dependency.source, eq: fn(left, right) { left == right })
  } else {
    true
  }
}

fn scheduler_node_unblocked(
  dependencies: List<DependencyView>,
  scheduled: List<Node>,
  candidate: Node
) -> Bool {
  for_all(
    xs: dependencies,
    predicate: fn(dependency) {
      scheduler_dependency_unblocked(
        dependency: dependency,
        scheduled: scheduled,
        candidate: candidate
      )
    }
  )
}

fn scheduler_node_unscheduled(scheduled: List<Node>, candidate: Node) -> Bool {
  contains(xs: scheduled, item: candidate, eq: fn(left, right) { left == right }) == false
}

fn runnable_frontier_from_dependencies(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  scheduled: List<Node>
) -> RunnableFrontier {
  let execution_dependencies = scheduler_execution_dependencies(dependencies: dependencies)
  RunnableFrontier {
    ready: filter(
      xs: nodes,
      predicate: fn(candidate) {
        scheduler_node_unscheduled(scheduled: scheduled, candidate: candidate)
          && scheduler_node_unblocked(
            dependencies: execution_dependencies,
            scheduled: scheduled,
            candidate: candidate
          )
      }
    )
  }
}

fn scheduler_blocked_evidence(nodes: List<Node>, scheduled: List<Node>) -> SchedulerBlockedEvidence {
  SchedulerNoRunnableFrontier {
    unscheduled: filter(
      xs: nodes,
      predicate: fn(candidate) {
        scheduler_node_unscheduled(scheduled: scheduled, candidate: candidate)
      }
    )
  }
}

fn scheduler_plan_from_dependencies(
  nodes: List<Node>,
  dependencies: List<DependencyView>,
  scheduled: List<Node>
) -> SchedulerPlan {
  let runnable = runnable_frontier_from_dependencies(
    nodes: nodes,
    dependencies: dependencies,
    scheduled: scheduled
  )
  if non_empty(xs: runnable.ready) {
    SchedulerPlanProduced {
      layers: [
        ReadinessLayer {
          ready: runnable.ready
        }
      ]
    }
  } else {
    SchedulerPlanBlocked {
      evidence: scheduler_blocked_evidence(nodes: nodes, scheduled: scheduled)
    }
  }
}

fn scheduler_first_readiness_layer(layers: List<ReadinessLayer>) -> SchedulerFirstReadinessLayer {
  fold(layers, init: SchedulerFirstReadinessLayerMissing, f: fn(acc, layer) {
    match acc {
      SchedulerFirstReadinessLayerFound { layer: _ } => acc
      SchedulerFirstReadinessLayerMissing => SchedulerFirstReadinessLayerFound { layer: layer }
    }
  })
}

fn runnable_frontier_from_layers(layers: List<ReadinessLayer>) -> RunnableFrontier {
  match scheduler_first_readiness_layer(layers: layers) {
    SchedulerFirstReadinessLayerFound { layer: layer } => RunnableFrontier { ready: layer.ready }
    SchedulerFirstReadinessLayerMissing => RunnableFrontier { ready: [] }
  }
}

fn runnable_frontier(graph_node: Node) -> RunnableFrontier {
  runnable_frontier_from_layers(layers: scheduler_layers(graph_node: graph_node))
}

fn scheduler_layers(graph_node: Node) -> List<ReadinessLayer> {
  topological_layers(graph_node: graph_node)
}

fn scheduler_plan(graph_node: Node) -> SchedulerPlan {
  let layers = scheduler_layers(graph_node: graph_node)
  let runnable = runnable_frontier_from_layers(layers: layers)
  if non_empty(xs: runnable.ready) {
    SchedulerPlanProduced {
      layers: layers
    }
  } else {
    SchedulerPlanBlocked {
      evidence: SchedulerNoRunnableFrontier { unscheduled: [graph_node] }
    }
  }
}
