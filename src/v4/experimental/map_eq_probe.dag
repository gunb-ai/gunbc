module v4.experimental.map_eq_probe

import v4.std.logic { Bool }
import v4.std.collection { Map, empty_map, map_insert }

type SKey { a: Int, b: Int }

fn struct_key_self_eq() -> Bool {
  let m = map_insert(empty_map(), SKey { a: 1, b: 2 }, 7)
  m == m
}
fn string_key_self_eq() -> Bool {
  let m = map_insert(empty_map(), "k", 7)
  m == m
}
fn struct_key_equal_eq() -> Bool {
  let m1 = map_insert(empty_map(), SKey { a: 1, b: 2 }, 7)
  let m2 = map_insert(empty_map(), SKey { a: 1, b: 2 }, 7)
  m1 == m2
}
// distinct structural keys must NOT be equal (discriminating)
fn struct_key_distinct_neq() -> Bool {
  let m1 = map_insert(empty_map(), SKey { a: 1, b: 2 }, 7)
  let m2 = map_insert(empty_map(), SKey { a: 1, b: 9 }, 7)
  m1 == m2
}
// shadow/overwrite: re-inserting same key keeps latest -> extensional equality
fn shadow_latest_eq() -> Bool {
  let m1 = map_insert(map_insert(empty_map(), SKey { a: 1, b: 2 }, 7), SKey { a: 1, b: 2 }, 9)
  let m2 = map_insert(empty_map(), SKey { a: 1, b: 2 }, 9)
  m1 == m2
}
// reviewer P2: Int(1) and Str("1") keys must stay DISTINCT (no Display collapse)
fn int_str_keys_distinct() -> Bool {
  let mi = map_insert(empty_map(), 1, 100)
  let ms = map_insert(empty_map(), "1", 200)
  mi == ms
}
