// src/v4/std/artifact.dag
// Scope: artifact identity and Node-to-artifact provenance.
// Status: Wave-2-A substrate.

module v4.std.artifact

import v4.std.diagnostic { Accepted, Locus, Outcome, Rejected }
import v4.std.algebra { fold_list, list_append, list_snoc_item }
import v4.std.collection { Absent, List, Optional, Present }
import v4.std.node { Edge, Named, Node, NodeKind, Symbol }
import v4.std.refinement { Refined, Validation, refine }
import v4.std.text { String }

// 🟢 coproduct dissolution
type ArtifactKind
  = SourceFile
  | GeneratedSource
  | TestClaimArtifact
  | ProjectionArtifact
  | Stage0Candidate
  | CorePackage
  | WitnessBundle

type Artifact {
  kind: ArtifactKind
  id: Symbol
  file_path: String
}

// Stable identity of the generator that produced an artifact (F.2-P1 shared fact;
// coordinated with Source-authority Mgr per Branch H §H.5). Idiomatic Id-alias shape
// (cf. v4.std.leaf_model_verification LeafModelClaimId = Symbol, Artifact.id: Symbol).
// Referenced by testgen Generator provenance (v4.lens.testgen) so a generated
// `GeneratedSource` / `TestClaimArtifact` carries the producing generator's identity.
type GeneratorId = Symbol

// An Artifact constrained to generator-output kinds (`GeneratedSource` /
// `TestClaimArtifact`). A generator's provenance may name only artifacts it produced;
// the refinement makes non-generated kinds (`SourceFile`, `CorePackage`, …)
// unrepresentable in `GeneratorProvenance` (Source-authority guardrail per Branch H §H.5
// — generated output is not, and cannot be tagged as, canonical source). Single authority
// over `Artifact` via refinement, not a parallel kind enumeration. Pattern: posix.dag
// ProcessId/ExitCode over `Refined<Int>`.
type GeneratedArtifact {
  refined: Refined<Artifact>
}

// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature:artifact-generated-kind-query — owner/lane: F.2-P1 Runtime/TestClaim — bind node://adhoc-6c543d46-716 — dissolve-on-arrival: substrate projects a canonical generated/producer-output partition over ArtifactKind (query/fold), `generated_artifact_validation.admits` routes through it, and this hand-written arm match is deleted in the same PR; forbidden: parallel ad-hoc generated-kind Bool predicates outside this validation authority.
fn artifact_is_generated(a: Artifact) -> Bool {
  match a.kind {
    GeneratedSource => true
    TestClaimArtifact => true
    SourceFile => false
    ProjectionArtifact => false
    Stage0Candidate => false
    CorePackage => false
    WitnessBundle => false
  }
}

data generated_artifact_validation: Validation<Artifact> = Validation {
  reason: ^generator_provenance_artifact_not_generated,
  admits: artifact_is_generated
}

fn make_generated_artifact(base: Artifact, at: Locus) -> Outcome<GeneratedArtifact> {
  match refine(base: base, by: generated_artifact_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: GeneratedArtifact { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}

// Total constructor for the statically-admitted `TestClaimArtifact` kind. The kind is
// fixed here (not a parameter), so the result provably satisfies `artifact_is_generated`
// with no runtime check — this is the smart-constructor counterpart to
// `make_generated_artifact`, which stays the only path for a *dynamic* Artifact whose kind
// is not statically known. Keeps total (List-returning) testgen producers total (no
// `Outcome` cascade) while non-generated kinds remain unrepresentable in
// `GeneratorProvenance` (the field type is `GeneratedArtifact`, never a raw `Artifact`).
fn test_claim_generated_artifact(id: Symbol, file_path: String) -> GeneratedArtifact {
  GeneratedArtifact {
    refined: Refined {
      base: Artifact { kind: TestClaimArtifact, id: id, file_path: file_path }
    }
  }
}

// Provenance of a generated artifact: the generator identity plus the generated Artifact
// it emitted. Bundles the artifact-domain pair so testgen carriers (v4.lens.testgen
// Generator<C>) hold a single provenance field rather than parallel id/artifact fields
// (Cost-of-Change single authority; mirrors NodeArtifactProvenance below). The `artifact`
// is a `GeneratedArtifact`, so only generator-output kinds are representable.
type GeneratorProvenance {
  generator_id: GeneratorId
  artifact: GeneratedArtifact
}

type NodeArtifactProvenance {
  node: Node
  artifact: Artifact
}

type SourceTreeEdge {
  label: Symbol
  target: SourceTreeNode
}

type SourceTreeNode {
  kind: NodeKind
  artifact: Optional<Artifact>
  children: List<SourceTreeEdge>
}

fn source_tree_edge_to_node_edge(edge: SourceTreeEdge) -> Edge {
  Edge {
    label: Named { name: edge.label },
    target: source_tree_to_node_graph(tree: edge.target)
  }
}

fn source_tree_edges_to_node_edges(edges: List<SourceTreeEdge>) -> List<Edge> {
  fold_list(
    xs: edges,
    empty: [],
    cons: fn(acc, edge) {
      list_snoc_item(xs: acc, item: source_tree_edge_to_node_edge(edge: edge))
    }
  )
}

fn source_tree_to_node_graph(tree: SourceTreeNode) -> Node {
  Node {
    kind: tree.kind,
    children: source_tree_edges_to_node_edges(edges: tree.children)
  }
}

fn source_tree_own_artifact_provenance(tree: SourceTreeNode) -> List<NodeArtifactProvenance> {
  match tree.artifact {
    Present { value: artifact } =>
      [
        NodeArtifactProvenance {
          node: source_tree_to_node_graph(tree: tree),
          artifact: artifact
        }
      ]
    Absent => []
  }
}

fn source_tree_children_artifact_provenance(edges: List<SourceTreeEdge>) -> List<NodeArtifactProvenance> {
  fold_list(
    xs: edges,
    empty: [],
    cons: fn(acc, edge) {
      list_append(
        left: acc,
        right: source_tree_node_artifact_provenance(tree: edge.target)
      )
    }
  )
}

fn source_tree_node_artifact_provenance(tree: SourceTreeNode) -> List<NodeArtifactProvenance> {
  list_append(
    left: source_tree_own_artifact_provenance(tree: tree),
    right: source_tree_children_artifact_provenance(edges: tree.children)
  )
}
