// src/v4/std/text.dag
// Scope: Unicode text carriers.
// Owns: Char, CharResult, String, string_is_empty, string_head, string_tail.
// Consumes: std/algebra.dag (FreeMonoid, is_empty, fold_list_right, list_tail, ListTailResult, TailFound, TailAbsent); std/logic.dag (Bool); std/nat.dag (Nat).
// Status: T-3 modeled; string scanning primitives added for T-6 lexer walk.
// Anchor: https://en.wikipedia.org/wiki/Unicode


module v4.std.text


import v4.std.algebra { FreeMonoid, ListTailResult, TailAbsent, TailFound, fold_list_right, is_empty, list_tail }
import v4.std.logic { Bool }
import v4.std.nat { Nat }
type Char = Nat
type String = FreeMonoid<Char>
// 🟡 coproduct dissolution — feature: FreeMonoid substrate first<T> accessor; dissolves when stdlib provides a substrate-derived head projection that returns Option<T> directly, eliminating the per-use carrier type.
type CharResult
  = CharFound { value: Char }
  | CharAbsent

fn string_is_empty(s: String) -> Bool {
  is_empty(xs: s)
}
fn string_head(s: String) -> CharResult {
  fold_list_right(xs: s, empty: CharAbsent, snoc: fn(_acc, c) { CharFound { value: c } })
}
fn string_tail(s: String) -> ListTailResult<Char> {
  list_tail(xs: s)
}
