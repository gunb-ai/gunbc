// src/v4/std/text.dag
// Scope: Unicode text carriers.
// Owns: Char, String, string_is_empty.
// Consumes: std nat, std algebra.
// Status: T-3 modeled.


module v4.std.text


import v4.std.algebra { FreeMonoid, free_monoid_is_empty }
import v4.std.nat { Nat }
type Char = Nat
type String = FreeMonoid<Char>
fn string_is_empty(s: String) -> Bool {
  free_monoid_is_empty(xs: s)
}
