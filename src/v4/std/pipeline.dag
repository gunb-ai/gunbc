type CarrierKind
  = SurfaceNode
  | CoreNode
  | ResolvedCoreNode
  | InferredCoreNode
  | TargetSurfaceNode
  | TargetSource
  | RuntimeValue

type PipelineStage {
  id: Symbol
  input: CarrierKind
  output: CarrierKind
  body: Node
  diagnostic_policy: StageDiagnosticPolicy
}

type Pipeline {
  stages: List<PipelineStage>
}

data accumulate_stage_diagnostics: StageDiagnosticPolicy = StageDiagnosticPolicy { accumulation: Accumulate }
data reject_on_first_stage_diagnostic: StageDiagnosticPolicy = StageDiagnosticPolicy { accumulation: ShortCircuit }
