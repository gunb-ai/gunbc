// src/v4/std/pipeline.dag
// Scope: compiler pipeline as data — stage carriers, dependency contracts, diagnostic policy.
// Owns: StageCarrier, PipelineStageLink, PipelineStageEdge, PipelineDiagnostic, Pipeline, StageDiagnosticPolicy, StageRequirements, StageEffects, StageDependencyContract.
// Consumes: v4.std.collection, v4.std.dependency, v4.std.node.
// Status: Wave-1 Worker A strict substrate.


module v4.std.pipeline


import v4.std.collection { List }
import v4.std.dependency {
  ArtifactSchedulingKind,
  ArtifactSchedulingReason,
  ArtifactSchedulingWitness,
  ProgramSchedulingKind,
  ProgramSchedulingReason,
  ProgramSchedulingWitness,
  TargetPlanSchedulingKind,
  TargetPlanSchedulingReason,
  TargetPlanSchedulingWitness
}
import v4.std.node { Symbol }


// 🟢 coproduct dissolution — StageCarrier is per-stage I/O for semantic_compile_pipeline (Source→…→EvalResult).
// Stage Symbols use homomorphism names (ground/translate/serialize); ingest chain is tokenize→parse→normalize→resolve.
type StageCarrier
  = Source
  | TokenStream
  | ParseTree
  | NormalizedTree
  | ResolvedTree
  | InferredTree
  | TargetModel
  | TargetSource
  | EvalResult


// 🟢 coproduct dissolution
type DiagnosticAccumulationPolicy
  = Accumulate
  | ShortCircuit


type StageDiagnosticPolicy = DiagnosticAccumulationPolicy


type StageRequirements {
  program: List<ProgramSchedulingReason>
  target_plan: List<TargetPlanSchedulingReason>
  artifact: List<ArtifactSchedulingReason>
}


type StageEffects {
  adds_containment_spine: Bool
  program: List<ProgramSchedulingReason>
  target_plan: List<TargetPlanSchedulingReason>
  artifact: List<ArtifactSchedulingReason>
}


type StageDependencyContract {
  requirements: StageRequirements
  effects: StageEffects
}


type PipelineStage {
  name: Symbol
  input_carrier: StageCarrier
  output_carrier: StageCarrier
  dependency_contract: StageDependencyContract
  diagnostic_policy: StageDiagnosticPolicy
  algebra_ref: Symbol
}


// 🟢 coproduct dissolution — typed stage-pair links; carriers derive from Pipeline.stages sole authority.
type PipelineStageLink
  = TokenizeToParse {}
  | ParseToNormalize {}
  | NormalizeToResolve {}
  | ResolveToGround {}
  | GroundToTranslate {}
  | TranslateToSerialize {}
  | GroundToEval {}


type PipelineStageEdge {
  link: PipelineStageLink
}


// 🟢 coproduct dissolution — fail-closed pipeline edge resolution against Pipeline.stages.
type PipelineDiagnostic
  = UnknownPipelineStage { pipeline: Symbol, name: Symbol }
  | UnresolvedPipelineStageLink { pipeline: Symbol, link: PipelineStageLink }


type Pipeline {
  name: Symbol
  stages: List<PipelineStage>
  edges: List<PipelineStageEdge>
}


data pipeline_semantic_compile: Symbol = pipeline_semantic_compile

data stage_tokenize: Symbol = stage_tokenize
data stage_parse: Symbol = stage_parse
data stage_normalize: Symbol = stage_normalize
data stage_resolve: Symbol = stage_resolve
data stage_ground: Symbol = stage_ground
data stage_translate: Symbol = stage_translate
data stage_serialize: Symbol = stage_serialize
data stage_eval: Symbol = stage_eval

data algebra_tokenize: Symbol = algebra_tokenize
data algebra_parse: Symbol = algebra_parse
data algebra_normalize: Symbol = algebra_normalize
data algebra_resolve: Symbol = algebra_resolve
data algebra_ground: Symbol = algebra_ground
data algebra_translate: Symbol = algebra_translate
data algebra_serialize: Symbol = algebra_serialize
data algebra_eval: Symbol = algebra_eval

data stage_diagnostic_fail_closed_accumulate: StageDiagnosticPolicy = Accumulate


fn ingest_text_to_surface_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [],
      target_plan: [],
      artifact: []
    }
  }
}


fn ingest_surface_to_core_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: true,
      program: [],
      target_plan: [],
      artifact: []
    }
  }
}


fn resolve_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [
        ProgramSchedulingReason { kind: BindsTo, witness: ContractSummary },
        ProgramSchedulingReason { kind: ModuleDependsOn, witness: ContractSummary }
      ],
      target_plan: [],
      artifact: []
    }
  }
}


fn ground_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [
        ProgramSchedulingReason { kind: BindsTo, witness: ContractSummary },
        ProgramSchedulingReason { kind: ModuleDependsOn, witness: ContractSummary }
      ],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [
        ProgramSchedulingReason { kind: TypeDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: DataDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: EffectDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: ResourceDependsOn, witness: ContractSummary }
      ],
      target_plan: [],
      artifact: []
    }
  }
}


fn translate_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [
        ProgramSchedulingReason { kind: BindsTo, witness: ContractSummary },
        ProgramSchedulingReason { kind: TypeDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: DataDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: EffectDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: ResourceDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: ModuleDependsOn, witness: ContractSummary }
      ],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [],
      target_plan: [
        TargetPlanSchedulingReason { kind: PlacementConstraint, witness: ContractSummary },
        TargetPlanSchedulingReason { kind: TransferDependsOn, witness: ContractSummary },
        TargetPlanSchedulingReason { kind: BarrierBefore, witness: ContractSummary }
      ],
      artifact: []
    }
  }
}


fn serialize_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [],
      target_plan: [
        TargetPlanSchedulingReason { kind: PlacementConstraint, witness: ContractSummary },
        TargetPlanSchedulingReason { kind: TransferDependsOn, witness: ContractSummary },
        TargetPlanSchedulingReason { kind: BarrierBefore, witness: ContractSummary }
      ],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [],
      target_plan: [],
      artifact: []
    }
  }
}


fn eval_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [
        ProgramSchedulingReason { kind: BindsTo, witness: ContractSummary },
        ProgramSchedulingReason { kind: TypeDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: DataDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: EffectDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: ResourceDependsOn, witness: ContractSummary },
        ProgramSchedulingReason { kind: ModuleDependsOn, witness: ContractSummary }
      ],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [],
      target_plan: [],
      artifact: []
    }
  }
}


fn tokenize_to_parse_edge() -> PipelineStageEdge {
  PipelineStageEdge { link: TokenizeToParse {} }
}


fn parse_to_normalize_edge() -> PipelineStageEdge {
  PipelineStageEdge { link: ParseToNormalize {} }
}


fn normalize_to_resolve_edge() -> PipelineStageEdge {
  PipelineStageEdge { link: NormalizeToResolve {} }
}


fn resolve_to_ground_edge() -> PipelineStageEdge {
  PipelineStageEdge { link: ResolveToGround {} }
}


fn ground_to_translate_edge() -> PipelineStageEdge {
  PipelineStageEdge { link: GroundToTranslate {} }
}


fn translate_to_serialize_edge() -> PipelineStageEdge {
  PipelineStageEdge { link: TranslateToSerialize {} }
}


fn ground_to_eval_edge() -> PipelineStageEdge {
  PipelineStageEdge { link: GroundToEval {} }
}


data semantic_compile_pipeline: Pipeline = Pipeline {
  name: pipeline_semantic_compile,
  edges: [
    tokenize_to_parse_edge(),
    parse_to_normalize_edge(),
    normalize_to_resolve_edge(),
    resolve_to_ground_edge(),
    ground_to_translate_edge(),
    translate_to_serialize_edge(),
    ground_to_eval_edge()
  ],
  stages: [
    PipelineStage {
      name: stage_tokenize,
      input_carrier: Source,
      output_carrier: TokenStream,
      dependency_contract: ingest_text_to_surface_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_tokenize
    },
    PipelineStage {
      name: stage_parse,
      input_carrier: TokenStream,
      output_carrier: ParseTree,
      dependency_contract: ingest_surface_to_core_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_parse
    },
    PipelineStage {
      name: stage_normalize,
      input_carrier: ParseTree,
      output_carrier: NormalizedTree,
      dependency_contract: ingest_surface_to_core_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_normalize
    },
    PipelineStage {
      name: stage_resolve,
      input_carrier: NormalizedTree,
      output_carrier: ResolvedTree,
      dependency_contract: resolve_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_resolve
    },
    PipelineStage {
      name: stage_ground,
      input_carrier: ResolvedTree,
      output_carrier: InferredTree,
      dependency_contract: ground_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_ground
    },
    PipelineStage {
      name: stage_translate,
      input_carrier: InferredTree,
      output_carrier: TargetModel,
      dependency_contract: translate_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_translate
    },
    PipelineStage {
      name: stage_serialize,
      input_carrier: TargetModel,
      output_carrier: TargetSource,
      dependency_contract: serialize_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_serialize
    },
    PipelineStage {
      name: stage_eval,
      input_carrier: InferredTree,
      output_carrier: EvalResult,
      dependency_contract: eval_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_eval
    }
  ]
}
