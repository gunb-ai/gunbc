// src/v4/std/pipeline.dag
// Scope: compiler pipeline AS DATA — stage carriers, dependency contracts, diagnostic policy.
// Anchor: docs/design-v4-compiler-homomorphism.md "The pipeline — stages as named algebras".
// Owns: CarrierKind, PipelineStage, Pipeline, StageDiagnosticPolicy, StageRequirements, StageEffects, StageDependencyContract.
// Consumes: v4.std.collection, v4.std.dependency, v4.std.node.
// Status: Wave-1 Worker A — strict substrate (stages are data; algebra_ref is Symbol, not hidden control flow).


module v4.std.pipeline


import v4.std.collection { List }
import v4.std.dependency {
  ArtifactDependencyKind,
  ProgramDependencyKind,
  TargetPlanDependencyKind
}
import v4.std.node { Symbol }


// RULING-1: 🟢 pretty-much-done — compile-core carrier progression per homomorphism doc.
type CarrierKind
  = Text
  | SurfaceNode
  | CoreNode
  | ResolvedCoreNode
  | InferredTree
  | TargetSurfaceNode
  | TargetSource
  | HostValue


// RULING-1: 🟢 pretty-much-done — fail-closed is invariant; policy selects accumulation behavior only.
// RULING-1: 🟢 pretty-much-done — diagnostic collection behavior (fatality is always fail-closed).
type DiagnosticAccumulationPolicy
  = Accumulate
  | ShortCircuit


// RULING-1: 🟢 pretty-much-done — fail-closed is invariant; accumulation policy is the only stage knob.
type StageDiagnosticPolicy {
  accumulation: DiagnosticAccumulationPolicy
  fail_closed: Bool
}


// RULING-1: 🟢 pretty-much-done — no domain field (lists are authoritative; avoids domain/list contradiction).
type StageRequirements {
  program: List<ProgramDependencyKind>
  target_plan: List<TargetPlanDependencyKind>
  artifact: List<ArtifactDependencyKind>
}


// RULING-1: 🟢 pretty-much-done — containment spine is structural (ContainmentEdge), not a scheduling kind.
type StageEffects {
  adds_containment_spine: Bool
  program: List<ProgramDependencyKind>
  target_plan: List<TargetPlanDependencyKind>
  artifact: List<ArtifactDependencyKind>
}


type StageDependencyContract {
  requirements: StageRequirements
  effects: StageEffects
}


type PipelineStage {
  name: Symbol
  input_carrier: CarrierKind
  output_carrier: CarrierKind
  dependency_contract: StageDependencyContract
  diagnostic_policy: StageDiagnosticPolicy
  algebra_ref: Symbol
}


type Pipeline {
  name: Symbol
  stages: List<PipelineStage>
}


data pipeline_semantic_compile: Symbol = pipeline_semantic_compile

data stage_tokenize: Symbol = stage_tokenize
data stage_parse: Symbol = stage_parse
data stage_normalize: Symbol = stage_normalize
data stage_resolve: Symbol = stage_resolve
data stage_ground: Symbol = stage_ground
data stage_translate: Symbol = stage_translate
data stage_serialize: Symbol = stage_serialize
data stage_eval: Symbol = stage_eval

data algebra_tokenize: Symbol = algebra_tokenize
data algebra_parse: Symbol = algebra_parse
data algebra_normalize: Symbol = algebra_normalize
data algebra_resolve: Symbol = algebra_resolve
data algebra_ground: Symbol = algebra_ground
data algebra_translate: Symbol = algebra_translate
data algebra_serialize: Symbol = algebra_serialize
data algebra_eval: Symbol = algebra_eval

data stage_diagnostic_fail_closed_accumulate: StageDiagnosticPolicy = StageDiagnosticPolicy {
  accumulation: Accumulate,
  fail_closed: true
}


fn ingest_text_to_surface_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [],
      target_plan: [],
      artifact: []
    }
  }
}


fn ingest_surface_to_core_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: true,
      program: [],
      target_plan: [],
      artifact: []
    }
  }
}


fn resolve_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [BindsTo, ModuleDependsOn],
      target_plan: [],
      artifact: []
    }
  }
}


fn ground_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [BindsTo, ModuleDependsOn],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [
        TypeDependsOn,
        DataDependsOn,
        EffectDependsOn,
        ResourceDependsOn
      ],
      target_plan: [],
      artifact: []
    }
  }
}


fn translate_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [
        BindsTo,
        TypeDependsOn,
        DataDependsOn,
        EffectDependsOn,
        ResourceDependsOn,
        ModuleDependsOn
      ],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [],
      target_plan: [PlacementConstraint, TransferDependsOn, BarrierBefore],
      artifact: []
    }
  }
}


fn serialize_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [],
      target_plan: [PlacementConstraint, TransferDependsOn, BarrierBefore],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [],
      target_plan: [],
      artifact: []
    }
  }
}


fn eval_contract() -> StageDependencyContract {
  StageDependencyContract {
    requirements: StageRequirements {
      program: [
        BindsTo,
        TypeDependsOn,
        DataDependsOn,
        EffectDependsOn,
        ResourceDependsOn,
        ModuleDependsOn
      ],
      target_plan: [],
      artifact: []
    },
    effects: StageEffects {
      adds_containment_spine: false,
      program: [],
      target_plan: [],
      artifact: []
    }
  }
}


data semantic_compile_pipeline: Pipeline = Pipeline {
  name: pipeline_semantic_compile,
  stages: [
    PipelineStage {
      name: stage_tokenize,
      input_carrier: Text,
      output_carrier: Text,
      dependency_contract: ingest_text_to_surface_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_tokenize
    },
    PipelineStage {
      name: stage_parse,
      input_carrier: Text,
      output_carrier: SurfaceNode,
      dependency_contract: ingest_surface_to_core_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_parse
    },
    PipelineStage {
      name: stage_normalize,
      input_carrier: SurfaceNode,
      output_carrier: CoreNode,
      dependency_contract: ingest_surface_to_core_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_normalize
    },
    PipelineStage {
      name: stage_resolve,
      input_carrier: CoreNode,
      output_carrier: ResolvedCoreNode,
      dependency_contract: resolve_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_resolve
    },
    PipelineStage {
      name: stage_ground,
      input_carrier: ResolvedCoreNode,
      output_carrier: InferredTree,
      dependency_contract: ground_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_ground
    },
    PipelineStage {
      name: stage_translate,
      input_carrier: InferredTree,
      output_carrier: TargetSurfaceNode,
      dependency_contract: translate_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_translate
    },
    PipelineStage {
      name: stage_serialize,
      input_carrier: TargetSurfaceNode,
      output_carrier: TargetSource,
      dependency_contract: serialize_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_serialize
    },
    PipelineStage {
      name: stage_eval,
      input_carrier: InferredTree,
      output_carrier: HostValue,
      dependency_contract: eval_contract(),
      diagnostic_policy: stage_diagnostic_fail_closed_accumulate,
      algebra_ref: algebra_eval
    }
  ]
}
