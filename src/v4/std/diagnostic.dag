// src/v4/std/diagnostic.dag
// Scope: fail-closed diagnostic schema.
// Anchor: THESIS.md "show the correct code" + INVARIANTS P3.
// Owns: Diagnostic, Outcome, NonEmptyDiagnostics, PluralDiagnostics, RejectedAccumulating, Locus, Extent, Correction, NoCorrectionReason.
// Consumes: std node, std collection.
// Status: T-3 modeled; Outcome Accepted/Rejected reconciled with design-v4-compiler-homomorphism Q4.


module v4.std.diagnostic


import v4.std.collection { List }
import v4.std.node { Node }
// 🟡 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Extent
  = WholeFile
  | ByteRange { start: Int, end: Int }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Locus
  = Textual { file: Symbol, extent: Extent }
  | NodeLocus { node: Node }
  | PortLocus { port: Symbol }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type NoCorrectionReason
  = UserInputBoundary
  | AmbiguousIntent
  | ExternalContractUnknown
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Correction
  = Suggested { node: Node }
  | Unavailable { reason: NoCorrectionReason }
type Diagnostic {
  reason: Symbol
  at: Locus
  correction: Correction
}
// 🟡 coproduct dissolution — W-TRAVERSE-OUTCOME-NON-EMPTY-DIAGNOSTICS.
// Trigger: dissolve to substrate NonEmptyList refinement (T-25-core).
type NonEmptyDiagnostics
  = One { diagnostic: Diagnostic }
  | More { head: Diagnostic, tail: NonEmptyDiagnostics }
// Plural only — ≥2 diagnostics; singles use Rejected { diagnostic }.
type PluralDiagnostics {
  head: Diagnostic
  tail: NonEmptyDiagnostics
}
// 🟡 coproduct dissolution — W-TRAVERSE-OUTCOME-LEGACY-PRODUCED.
// Trigger: migrate consumers to Accepted/PluralDiagnostics; retire Produced/Rejected.
// Authority: Produced = clean success; Accepted = success + ≥1 diagnostic;
// Rejected = one failure; RejectedAccumulating = ≥2 failures only.
type Outcome<T>
  = Produced { value: T }
  | Rejected { diagnostic: Diagnostic }
  | Accepted { value: T, diagnostics: NonEmptyDiagnostics }
  | RejectedAccumulating { diagnostics: PluralDiagnostics }
