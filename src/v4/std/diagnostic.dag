// src/v4/std/diagnostic.dag
// Scope: fail-closed diagnostic schema.
// Anchor: THESIS.md "show the correct code" + INVARIANTS P3.
// Owns: Diagnostic, Outcome, NonEmptyDiagnostics, Locus, Extent, Correction, NoCorrectionReason.
// Consumes: std node, std collection.
// Status: T-3 modeled; Outcome Accepted/Rejected reconciled with design-v4-compiler-homomorphism Q4.


module v4.std.diagnostic


import v4.std.collection { List }
import v4.std.node { Node }
// 🟡 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Extent
  = WholeFile
  | ByteRange { start: Int, end: Int }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Locus
  = Textual { file: Symbol, extent: Extent }
  | NodeLocus { node: Node }
  | PortLocus { port: Symbol }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type NoCorrectionReason
  = UserInputBoundary
  | AmbiguousIntent
  | ExternalContractUnknown
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Correction
  = Suggested { node: Node }
  | Unavailable { reason: NoCorrectionReason }
type Diagnostic {
  reason: Symbol
  at: Locus
  correction: Correction
}
type NonEmptyDiagnostics
  = Singleton { diagnostic: Diagnostic }
  | Cons { head: Diagnostic, tail: List<Diagnostic> }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
// Reconciliation: Accepted{value, diagnostics} is canonical; Produced{value} ≡ Accepted with empty diagnostics.
// Rejected{diagnostics: NonEmptyDiagnostics} is canonical; RejectedSingular{diagnostic} is legacy single-diagnostic terminal.
type Outcome<T>
  = Accepted { value: T, diagnostics: List<Diagnostic> }
  | Rejected { diagnostics: NonEmptyDiagnostics }
  | Produced { value: T }
  | RejectedSingular { diagnostic: Diagnostic }
