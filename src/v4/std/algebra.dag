module v4.std.algebra


import v4.std.node { Conj, Edge, Named, Node, Symbol, TypeNode }
type Magma<T> {
  op: fn(T, T) -> T
}
type Semigroup<T> {
  magma: Magma<T>
}
type Monoid<T> {
  semigroup: Semigroup<T>
  identity: T
}
type CommutativeMonoid<T> {
  monoid: Monoid<T>
}
type Group<T> {
  monoid: Monoid<T>
  inverse: fn(T) -> T
}
type AbelianGroup<T> {
  group: Group<T>
}
type Semiring<T> {
  add: CommutativeMonoid<T>
  mul: Monoid<T>
}
type CommutativeSemiring<T> {
  semiring: Semiring<T>
}
type Ring<T> {
  add: AbelianGroup<T>
  mul: Monoid<T>
}
type CommutativeRing<T> {
  ring: Ring<T>
}
type OrderedRing<T> {
  ring: Ring<T>
  compare: fn(T, T) -> Ordering
}
type Field<T> {
  commutative_ring: CommutativeRing<T>
}
type ApproximateField<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  compare: fn(T, T) -> Ordering
}
type Lattice<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
}
type BoundedLattice<T> {
  lattice: Lattice<T>
  top: T
  bottom: T
}
type BooleanAlgebra<T> {
  bounded_lattice: BoundedLattice<T>
  complement: fn(T) -> T
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type FreeMonoid<T>
  = Empty
  | Cons { head: T, tail: FreeMonoid<T> }
type FreeMonoidUniqueState<T> {
  seen: FreeMonoid<T>
  unique: Bool
}
data fold_list_node_head: Symbol = fold_list_node_head
data fold_list_node_tail: Symbol = fold_list_node_tail
// Left fold: traverse head→tail, thread accumulator forward. Combinator order is `cons(acc, head)`.
// The naive list-rebuild combinator `fn(acc, h) { Cons { head: h, tail: acc } }` REVERSES input
// (head is prepended at each step but visited first). Use fold_list_right for order-preserving
// list-shaped output, or this fold with an explicit reverse pass for the same effect.
fn fold_list<T, A>(xs: FreeMonoid<T>, empty: A, cons: fn(A, T) -> A) -> A {
  match xs {
    Empty => empty
    Cons { head: h, tail: t } => fold_list(xs: t, empty: cons(empty, h), cons: cons)
  }
}
// Right fold: recurse to tail first, then combine. Combinator order is `snoc(tail_result, head)`.
// With `fn(acc, h) { Cons { head: h, tail: acc } }` the result PRESERVES input order — head is
// prepended last, after the tail has been rebuilt. Not tail-recursive; depth is O(|xs|).
fn fold_list_right<T, A>(xs: FreeMonoid<T>, empty: A, snoc: fn(A, T) -> A) -> A {
  match xs {
    Empty => empty
    Cons { head: h, tail: t } => snoc(fold_list_right(xs: t, empty: empty, snoc: snoc), h)
  }
}
fn fold_list_node<T>(
  xs: FreeMonoid<T>,
  item_node: fn(T) -> Node
) -> Node {
  fold_list_right(
    xs: xs,
    empty: Node { kind: TypeNode { connective: Conj }, children: [] },
    snoc: fn(tail_node, item) {
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge { label: Named { name: fold_list_node_head }, target: item_node(item) },
          Edge { label: Named { name: fold_list_node_tail }, target: tail_node },
        ]
      }
    }
  )
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived Empty-variant discriminant projection; forbidden: fold_list laundering.
fn is_empty<T>(xs: FreeMonoid<T>) -> Bool {
  match xs {
    Empty => true
    Cons { head: _, tail: _ } => false
  }
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived non-Empty-variant discriminant projection; forbidden: fold_list laundering.
fn non_empty<T>(xs: FreeMonoid<T>) -> Bool {
  match is_empty(xs: xs) {
    true => false
    false => true
  }
}


fn length<T>(xs: FreeMonoid<T>) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(count, _) { count + 1 })
}


fn for_all<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Bool {
  fold_list(xs: xs, empty: true, cons: fn(acc, item) {
    match acc {
      true => predicate(item)
      false => false
    }
  })
}


fn any<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, item) {
    match acc {
      true => true
      false => predicate(item)
    }
  })
}


fn filter<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> FreeMonoid<T> {
  fold_list_right(xs: xs, empty: Empty, snoc: fn(acc, item) {
    match predicate(item) {
      true => Cons { head: item, tail: acc }
      false => acc
    }
  })
}


fn contains<T>(xs: FreeMonoid<T>, item: T, eq: fn(T, T) -> Bool) -> Bool {
  any(xs: xs, predicate: fn(candidate) { eq(candidate, item) })
}


fn count_where<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(count, item) {
    match predicate(item) {
      true => count + 1
      false => count
    }
  })
}


fn count_equal<T>(xs: FreeMonoid<T>, item: T, eq: fn(T, T) -> Bool) -> Int {
  count_where(xs: xs, predicate: fn(candidate) { eq(candidate, item) })
}


fn unique<T>(xs: FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  let state = fold_list(xs: xs, empty: FreeMonoidUniqueState { seen: Empty, unique: true }, cons: fn(acc, item) {
    match acc.unique {
      true => match count_equal(xs: acc.seen, item: item, eq: eq) {
        0 => FreeMonoidUniqueState { seen: Cons { head: item, tail: acc.seen }, unique: true }
        _ => FreeMonoidUniqueState { seen: acc.seen, unique: false }
      }
      false => acc
    }
  })
  state.unique
}
// FreeMonoid concatenation: the canonical monoid operation on lists.
// Implemented via fold_list_right so head order is preserved.
fn list_append<T>(left: FreeMonoid<T>, right: FreeMonoid<T>) -> FreeMonoid<T> {
  fold_list_right(xs: left, empty: right, snoc: fn(acc, item) {
    Cons { head: item, tail: acc }
  })
}


// Append a single element at the tail (snoc).
fn list_snoc_item<T>(xs: FreeMonoid<T>, item: T) -> FreeMonoid<T> {
  list_append(left: xs, right: Cons { head: item, tail: Empty })
}


// Bag (multiset) equality: order-insensitive; equal lengths AND per-element
// occurrence counts match. O(n^2) in the length of xs.
fn bag_eq<T>(xs: FreeMonoid<T>, ys: FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  if length(xs: xs) != length(xs: ys) {
    false
  } else {
    for_all(xs: xs, predicate: fn(item) {
      count_equal(xs: xs, item: item, eq: eq) == count_equal(xs: ys, item: item, eq: eq)
    })
  }
}


// 🟢 terminal — no richer substrate to dissolve into; this IS the canonical two-list zip-equality.
fn zip_eq<T>(
  a: FreeMonoid<T>,
  b: FreeMonoid<T>,
  eq: fn(T, T) -> Bool
) -> Bool {
  match a {
    Empty =>
      match b {
        Empty => true
        Cons { head: _, tail: _ } => false
      }
    Cons { head: ha, tail: ta } =>
      match b {
        Empty => false
        Cons { head: hb, tail: tb } =>
          eq(ha, hb) && zip_eq(a: ta, b: tb, eq: eq)
      }
  }
}


// 🟢 terminal — no richer substrate to dissolve into; this IS the canonical prefix-fold primitive.
fn is_prefix_of<T>(
  prefix: FreeMonoid<T>,
  xs: FreeMonoid<T>,
  eq: fn(T, T) -> Bool
) -> Bool {
  match prefix {
    Empty => true
    Cons { head: h_prefix, tail: t_prefix } =>
      match xs {
        Empty => false
        Cons { head: h_xs, tail: t_xs } =>
          eq(h_prefix, h_xs) && is_prefix_of(prefix: t_prefix, xs: t_xs, eq: eq)
      }
  }
}


type PointwisePower<T> {
  member: fn(T) -> Bool
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Ordering
  = Less
  | Equal
  | Greater
type Homomorphism<C, Source, Target> {
  source: C<Source>
  target: C<Target>
  map: fn(Source) -> Target
}
