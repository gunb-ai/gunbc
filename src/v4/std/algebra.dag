// src/v4/std/algebra.dag
// Scope: algebraic structures and canonical carrier constructions.
// Anchor: https://en.wikipedia.org/wiki/Algebraic_structure
// Owns: Magma, Semigroup, Monoid, CommutativeMonoid, Group, AbelianGroup, Semiring, CommutativeSemiring, Ring, CommutativeRing, OrderedRing, Field, ApproximateField, Lattice, BoundedLattice, BooleanAlgebra, FreeMonoid, FreeMonoidUniqueState, free_monoid_fold, free_monoid_is_empty, free_monoid_non_empty, free_monoid_length, free_monoid_forall, free_monoid_count_where, free_monoid_count_equal, free_monoid_unique, PointwisePower, Ordering, Homomorphism.
// Consumes: none.
// Status: T-2 modeled.


module v4.std.algebra
type Magma<T> {
  op: fn(T, T) -> T
}
type Semigroup<T> {
  magma: Magma<T>
}
type Monoid<T> {
  semigroup: Semigroup<T>
  identity: T
}
type CommutativeMonoid<T> {
  monoid: Monoid<T>
}
type Group<T> {
  monoid: Monoid<T>
  inverse: fn(T) -> T
}
type AbelianGroup<T> {
  group: Group<T>
}
type Semiring<T> {
  add: CommutativeMonoid<T>
  mul: Monoid<T>
}
type CommutativeSemiring<T> {
  semiring: Semiring<T>
}
type Ring<T> {
  add: AbelianGroup<T>
  mul: Monoid<T>
}
type CommutativeRing<T> {
  ring: Ring<T>
}
type OrderedRing<T> {
  ring: Ring<T>
  compare: fn(T, T) -> Ordering
}
type Field<T> {
  commutative_ring: CommutativeRing<T>
}
type ApproximateField<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  compare: fn(T, T) -> Ordering
}
type Lattice<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
}
type BoundedLattice<T> {
  lattice: Lattice<T>
  top: T
  bottom: T
}
type BooleanAlgebra<T> {
  bounded_lattice: BoundedLattice<T>
  complement: fn(T) -> T
}
// 🟢 coproduct dissolution — DECISIONS.md classification ledger: FreeMonoid<T>.
type FreeMonoid<T>
  = Empty
  | Cons { head: T, tail: FreeMonoid<T> }
type FreeMonoidUniqueState<T> {
  seen: FreeMonoid<T>
  unique: Bool
}
fn free_monoid_fold<T, A>(xs: FreeMonoid<T>, init: A, step: fn(A, T) -> A) -> A {
  match xs {
    Empty => init
    Cons { head: h, tail: t } => free_monoid_fold(xs: t, init: step(init, h), step: step)
  }
}


fn free_monoid_is_empty<T>(xs: FreeMonoid<T>) -> Bool {
  free_monoid_fold(xs: xs, init: true, step: fn(_, _) { false })
}


fn free_monoid_non_empty<T>(xs: FreeMonoid<T>) -> Bool {
  free_monoid_fold(xs: xs, init: false, step: fn(_, _) { true })
}


fn free_monoid_length<T>(xs: FreeMonoid<T>) -> Int {
  free_monoid_fold(xs: xs, init: 0, step: fn(count, _) { count + 1 })
}


fn free_monoid_forall<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Bool {
  free_monoid_fold(xs: xs, init: true, step: fn(acc, item) {
    match acc {
      true => predicate(item)
      false => false
    }
  })
}


fn free_monoid_count_where<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Int {
  free_monoid_fold(xs: xs, init: 0, step: fn(count, item) {
    match predicate(item) {
      true => count + 1
      false => count
    }
  })
}


fn free_monoid_count_equal<T>(xs: FreeMonoid<T>, item: T, eq: fn(T, T) -> Bool) -> Int {
  free_monoid_count_where(xs: xs, predicate: fn(candidate) { eq(candidate, item) })
}


fn free_monoid_unique<T>(xs: FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  let state = free_monoid_fold(xs: xs, init: FreeMonoidUniqueState { seen: Empty, unique: true }, step: fn(acc, item) {
    match acc.unique {
      true => match free_monoid_count_equal(xs: acc.seen, item: item, eq: eq) {
        0 => FreeMonoidUniqueState { seen: Cons { head: item, tail: acc.seen }, unique: true }
        _ => FreeMonoidUniqueState { seen: acc.seen, unique: false }
      }
      false => acc
    }
  })
  state.unique
}
type PointwisePower<T> {
  member: fn(T) -> Bool
}
// 🟢 coproduct dissolution — DECISIONS.md classification ledger: Ordering.
type Ordering
  = Less
  | Equal
  | Greater
type Homomorphism<C, Source, Target> {
  source: C<Source>
  target: C<Target>
  map: fn(Source) -> Target
}
