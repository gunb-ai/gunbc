// src/v4/std/algebra.dag
// Scope: algebraic structures and canonical carrier constructions.
// Anchor: https://en.wikipedia.org/wiki/Algebraic_structure
// Owns: Magma, Semigroup, Monoid, CommutativeMonoid, Group, AbelianGroup, Semiring, CommutativeSemiring, Ring, CommutativeRing, OrderedRing, Field, ApproximateField, Lattice, BoundedLattice, BooleanAlgebra, FreeMonoid, free_monoid_is_empty, free_monoid_length, PointwisePower, Ordering, Homomorphism.
// Consumes: none.
// Status: T-2 modeled.


module v4.std.algebra
type Magma<T> {
  op: fn(T, T) -> T
}
type Semigroup<T> {
  magma: Magma<T>
}
type Monoid<T> {
  semigroup: Semigroup<T>
  identity: T
}
type CommutativeMonoid<T> {
  monoid: Monoid<T>
}
type Group<T> {
  monoid: Monoid<T>
  inverse: fn(T) -> T
}
type AbelianGroup<T> {
  group: Group<T>
}
type Semiring<T> {
  add: CommutativeMonoid<T>
  mul: Monoid<T>
}
type CommutativeSemiring<T> {
  semiring: Semiring<T>
}
type Ring<T> {
  add: AbelianGroup<T>
  mul: Monoid<T>
}
type CommutativeRing<T> {
  ring: Ring<T>
}
type OrderedRing<T> {
  ring: Ring<T>
  compare: fn(T, T) -> Ordering
}
type Field<T> {
  commutative_ring: CommutativeRing<T>
}
type ApproximateField<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  compare: fn(T, T) -> Ordering
}
type Lattice<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
}
type BoundedLattice<T> {
  lattice: Lattice<T>
  top: T
  bottom: T
}
type BooleanAlgebra<T> {
  bounded_lattice: BoundedLattice<T>
  complement: fn(T) -> T
}
type FreeMonoid<T>
  = Empty
  | Cons { head: T, tail: FreeMonoid<T> }
fn free_monoid_is_empty<T>(xs: FreeMonoid<T>) -> Bool {
  match xs {
    Empty => true
    Cons { head: _, tail: _ } => false
  }
}


fn free_monoid_length<T>(xs: FreeMonoid<T>) -> Int {
  match xs {
    Empty => 0
    Cons { head: _, tail: t } => 1 + free_monoid_length(xs: t)
  }
}
type PointwisePower<T> {
  member: fn(T) -> Bool
}
type Ordering
  = Less
  | Equal
  | Greater
type Homomorphism<C, Source, Target> {
  source: C<Source>
  target: C<Target>
  map: fn(Source) -> Target
}
