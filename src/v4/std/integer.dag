// src/v4/std/integer.dag
// Scope: Abstract Int/UInt, fixed-width projections, interval facts, divide/modulo carriers and diagnostics.
// Owns: GroupCompletion, Int, UInt, Compose, Signedness, Representation, OverflowDisposition, IntegerIntervalSpec, Int8, Int16, Int32, Int64, Int128, UInt8, UInt16, UInt32, UInt64, UInt128, IntPlatform, UIntPlatform, int_add, int_negate, int_mul, int_compare, int_is_zero, int_abelian_group, int_ordered_ring, integer_div_by_zero, integer_modulo_by_zero, integer_divide_by_zero_diagnostic, integer_modulo_by_zero_diagnostic, int_div, int_mod
// Consumes: std/node.dag (Instantiation, Symbol, Node); std/nat.dag (Nat); std/machine.dag (MachineWidth, PointerWidth, Word8, Word16, Word32, Word64, Word128); std/algebra.dag (Magma, Semigroup, Monoid, Group, AbelianGroup, Ring, OrderedRing, Ordering); std/diagnostic.dag (Diagnostic, Locus, Correction, NoCorrectionReason, Outcome<T> Tier-2 divide/modulo).
// Status: std integer vocabulary (widths, group completion, divide/modulo outcomes).
// Anchor: https://en.wikipedia.org/wiki/Integer
// Ledger: CP-3229-GREEN-TERMINAL, CP-3229-VERIFY, SL-3229-INTEGER-GROUP-COMPLETION, SL-3229-INTEGER-OVERFLOW-SEMANTICS, SL-3229-INTEGER-REPRESENTATION-STUBS.
// 🟢

module v4.std.integer


import v4.std.algebra {
  AbelianGroup,
  fold_list,
  Group,
  list_snoc_item,
  Magma,
  Monoid,
  OrderedRing,
  Ordering,
  Ring,
  Semigroup
}
import v4.std.collection { List }
import v4.std.diagnostic {Correction, Diagnostic, Locus, NoCorrectionReason, Outcome, Accepted, None, diagnostics_singleton}
import v4.std.node { Atom, Conj, Edge, Named, Node, Positional, Symbol, TypeNode }
import v4.std.machine {
  MachineWidth,
  PointerWidth,
  Word8,
  Word16,
  Word32,
  Word64,
  Word128
}
import v4.std.nat { Nat }
type GroupCompletion<M>
type Int = GroupCompletion<Nat>
type UInt = Nat
type Compose<carrier, dimension>

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type Signedness = Signed | Unsigned

// 🟡 coproduct dissolution — SL-3229-INTEGER-REPRESENTATION-STUBS — feature:integer-representation-stub-semantics — dissolve-on-arrival: OnesComplement and SignMagnitude gain target-backed representation semantics or are proven unused by the T-4 fact-bundle catalog.
type Representation
  = TwosComplement
  | OnesComplement // stub — no current target uses this representation
  | SignMagnitude  // stub — no current target uses this representation

// 🟡 coproduct dissolution — SL-3229-INTEGER-OVERFLOW-SEMANTICS — feature:integer-overflow-disposition-semantics — dissolve-on-arrival: wrapping/saturating/trapping/undefined overflow are backed by width, bounds, and Outcome semantics consumed by T-4 fact-bundles.
type OverflowDisposition = Wrapping | Saturating | UndefinedBehavior | Trapping

type Int8 = Compose<Int, MachineWidth<Word8>>
type Int16 = Compose<Int, MachineWidth<Word16>>
type Int32 = Compose<Int, MachineWidth<Word32>>
type Int64 = Compose<Int, MachineWidth<Word64>>
type Int128 = Compose<Int, MachineWidth<Word128>>

type UInt8 = Compose<UInt, MachineWidth<Word8>>
type UInt16 = Compose<UInt, MachineWidth<Word16>>
type UInt32 = Compose<UInt, MachineWidth<Word32>>
type UInt64 = Compose<UInt, MachineWidth<Word64>>
type UInt128 = Compose<UInt, MachineWidth<Word128>>

type IntPlatform = Compose<Int, MachineWidth<PointerWidth>>
type UIntPlatform = Compose<UInt, MachineWidth<PointerWidth>>

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type IntegerBoundSign
  = IntegerBoundNegative
  | IntegerBoundNonNegative

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type IntegerRangeEndpoint
  = IntegerRangeInclusiveMin
  | IntegerRangeInclusiveMax

// Fixed-width integer intervals carry concrete decimal Nat digits. Platform
// intervals carry the signedness/PointerWidth relation instead of pretending to
// know a target width before target selection.
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type IntegerIntervalBound
  = IntegerConcreteBound { sign: IntegerBoundSign, decimal_digits: List<Nat> }
  | IntegerPointerWidthBound { signedness: Signedness, endpoint: IntegerRangeEndpoint }

type IntegerIntervalSpec {
  inclusive_min: IntegerIntervalBound
  inclusive_max: IntegerIntervalBound
}

data integer_interval_field_inclusive_min: Symbol = integer_interval_field_inclusive_min
data integer_interval_field_inclusive_max: Symbol = integer_interval_field_inclusive_max
data integer_bound_field_kind: Symbol = integer_bound_field_kind
data integer_bound_field_sign: Symbol = integer_bound_field_sign
data integer_bound_field_decimal_digits: Symbol = integer_bound_field_decimal_digits
data integer_bound_field_signedness: Symbol = integer_bound_field_signedness
data integer_bound_field_endpoint: Symbol = integer_bound_field_endpoint
data integer_tag_bound_concrete: Symbol = integer_tag_bound_concrete
data integer_tag_bound_pointer_width: Symbol = integer_tag_bound_pointer_width
data integer_tag_bound_negative: Symbol = integer_tag_bound_negative
data integer_tag_bound_nonnegative: Symbol = integer_tag_bound_nonnegative
data integer_tag_signed: Symbol = integer_tag_signed
data integer_tag_unsigned: Symbol = integer_tag_unsigned
data integer_tag_range_inclusive_min: Symbol = integer_tag_range_inclusive_min
data integer_tag_range_inclusive_max: Symbol = integer_tag_range_inclusive_max
data integer_tag_digit_0: Symbol = integer_tag_digit_0
data integer_tag_digit_1: Symbol = integer_tag_digit_1
data integer_tag_digit_2: Symbol = integer_tag_digit_2
data integer_tag_digit_3: Symbol = integer_tag_digit_3
data integer_tag_digit_4: Symbol = integer_tag_digit_4
data integer_tag_digit_5: Symbol = integer_tag_digit_5
data integer_tag_digit_6: Symbol = integer_tag_digit_6
data integer_tag_digit_7: Symbol = integer_tag_digit_7
data integer_tag_digit_8: Symbol = integer_tag_digit_8
data integer_tag_digit_9: Symbol = integer_tag_digit_9

fn integer_interval(
  inclusive_min: IntegerIntervalBound,
  inclusive_max: IntegerIntervalBound
) -> IntegerIntervalSpec {
  IntegerIntervalSpec {
    inclusive_min: inclusive_min,
    inclusive_max: inclusive_max
  }
}

fn integer_concrete_bound(
  sign: IntegerBoundSign,
  decimal_digits: List<Nat>
) -> IntegerIntervalBound {
  IntegerConcreteBound { sign: sign, decimal_digits: decimal_digits }
}

fn integer_pointer_width_bound(
  signedness: Signedness,
  endpoint: IntegerRangeEndpoint
) -> IntegerIntervalBound {
  IntegerPointerWidthBound { signedness: signedness, endpoint: endpoint }
}

fn int8_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, decimal_digits: [1, 2, 8]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [1, 2, 7])
  )
}

fn int16_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, decimal_digits: [3, 2, 7, 6, 8]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [3, 2, 7, 6, 7])
  )
}

fn int32_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, decimal_digits: [2, 1, 4, 7, 4, 8, 3, 6, 4, 8]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [2, 1, 4, 7, 4, 8, 3, 6, 4, 7])
  )
}

fn int64_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, decimal_digits: [9, 2, 2, 3, 3, 7, 2, 0, 3, 6, 8, 5, 4, 7, 7, 5, 8, 0, 8]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [9, 2, 2, 3, 3, 7, 2, 0, 3, 6, 8, 5, 4, 7, 7, 5, 8, 0, 7])
  )
}

fn int128_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, decimal_digits: [1, 7, 0, 1, 4, 1, 1, 8, 3, 4, 6, 0, 4, 6, 9, 2, 3, 1, 7, 3, 1, 6, 8, 7, 3, 0, 3, 7, 1, 5, 8, 8, 4, 1, 0, 5, 7, 2, 8]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [1, 7, 0, 1, 4, 1, 1, 8, 3, 4, 6, 0, 4, 6, 9, 2, 3, 1, 7, 3, 1, 6, 8, 7, 3, 0, 3, 7, 1, 5, 8, 8, 4, 1, 0, 5, 7, 2, 7])
  )
}

fn uint8_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [0]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [2, 5, 5])
  )
}

fn uint16_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [0]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [6, 5, 5, 3, 5])
  )
}

fn uint32_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [0]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [4, 2, 9, 4, 9, 6, 7, 2, 9, 5])
  )
}

fn uint64_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [0]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [1, 8, 4, 4, 6, 7, 4, 4, 0, 7, 3, 7, 0, 9, 5, 5, 1, 6, 1, 5])
  )
}

fn uint128_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [0]),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, decimal_digits: [3, 4, 0, 2, 8, 2, 3, 6, 6, 9, 2, 0, 9, 3, 8, 4, 6, 3, 4, 6, 3, 3, 7, 4, 6, 0, 7, 4, 3, 1, 7, 6, 8, 2, 1, 1, 4, 5, 5])
  )
}

fn int_platform_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_pointer_width_bound(signedness: Signed, endpoint: IntegerRangeInclusiveMin),
    inclusive_max: integer_pointer_width_bound(signedness: Signed, endpoint: IntegerRangeInclusiveMax)
  )
}

fn uint_platform_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_pointer_width_bound(signedness: Unsigned, endpoint: IntegerRangeInclusiveMin),
    inclusive_max: integer_pointer_width_bound(signedness: Unsigned, endpoint: IntegerRangeInclusiveMax)
  )
}

fn integer_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn integer_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn integer_bound_sign_node(sign: IntegerBoundSign) -> Node {
  match sign {
    IntegerBoundNegative => integer_inhabitant_atom(id: integer_tag_bound_negative)
    IntegerBoundNonNegative => integer_inhabitant_atom(id: integer_tag_bound_nonnegative)
  }
}

fn integer_signedness_node(signedness: Signedness) -> Node {
  match signedness {
    Signed => integer_inhabitant_atom(id: integer_tag_signed)
    Unsigned => integer_inhabitant_atom(id: integer_tag_unsigned)
  }
}

fn integer_range_endpoint_node(endpoint: IntegerRangeEndpoint) -> Node {
  match endpoint {
    IntegerRangeInclusiveMin => integer_inhabitant_atom(id: integer_tag_range_inclusive_min)
    IntegerRangeInclusiveMax => integer_inhabitant_atom(id: integer_tag_range_inclusive_max)
  }
}

fn integer_decimal_digit_node(digit: Nat) -> Node {
  if digit == 0 {
    integer_inhabitant_atom(id: integer_tag_digit_0)
  } else if digit == 1 {
    integer_inhabitant_atom(id: integer_tag_digit_1)
  } else if digit == 2 {
    integer_inhabitant_atom(id: integer_tag_digit_2)
  } else if digit == 3 {
    integer_inhabitant_atom(id: integer_tag_digit_3)
  } else if digit == 4 {
    integer_inhabitant_atom(id: integer_tag_digit_4)
  } else if digit == 5 {
    integer_inhabitant_atom(id: integer_tag_digit_5)
  } else if digit == 6 {
    integer_inhabitant_atom(id: integer_tag_digit_6)
  } else if digit == 7 {
    integer_inhabitant_atom(id: integer_tag_digit_7)
  } else if digit == 8 {
    integer_inhabitant_atom(id: integer_tag_digit_8)
  } else {
    integer_inhabitant_atom(id: integer_tag_digit_9)
  }
}

fn integer_decimal_digit_edge(digit: Nat) -> Edge {
  Edge { label: Positional, target: integer_decimal_digit_node(digit: digit) }
}

fn integer_decimal_digits_node(digits: List<Nat>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: digits,
      empty: Empty,
      cons: fn(acc, digit) {
        list_snoc_item(xs: acc, item: integer_decimal_digit_edge(digit: digit))
      }
    )
  }
}

fn integer_interval_bound_node(bound: IntegerIntervalBound) -> Node {
  match bound {
    IntegerConcreteBound { sign, decimal_digits } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        integer_named_edge(
          name: integer_bound_field_kind,
          target: integer_inhabitant_atom(id: integer_tag_bound_concrete)
        ),
        integer_named_edge(
          name: integer_bound_field_sign,
          target: integer_bound_sign_node(sign: sign)
        ),
        integer_named_edge(
          name: integer_bound_field_decimal_digits,
          target: integer_decimal_digits_node(digits: decimal_digits)
        )
      ]
    }
    IntegerPointerWidthBound { signedness, endpoint } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        integer_named_edge(
          name: integer_bound_field_kind,
          target: integer_inhabitant_atom(id: integer_tag_bound_pointer_width)
        ),
        integer_named_edge(
          name: integer_bound_field_signedness,
          target: integer_signedness_node(signedness: signedness)
        ),
        integer_named_edge(
          name: integer_bound_field_endpoint,
          target: integer_range_endpoint_node(endpoint: endpoint)
        )
      ]
    }
  }
}

fn integer_interval_spec_node(spec: IntegerIntervalSpec) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      integer_named_edge(
        name: integer_interval_field_inclusive_min,
        target: integer_interval_bound_node(bound: spec.inclusive_min)
      ),
      integer_named_edge(
        name: integer_interval_field_inclusive_max,
        target: integer_interval_bound_node(bound: spec.inclusive_max)
      )
    ]
  }
}
fn int_add(a: Int, b: Int) -> Int {
  a + b
}

fn int_negate(a: Int) -> Int {
  0 - a
}

fn int_mul(a: Int, b: Int) -> Int {
  a * b
}

fn int_compare(a: Int, b: Int) -> Ordering {
  if a < b {
    Less
  } else {
    if a == b {
      Equal
    } else {
      Greater
    }
  }
}

fn int_is_zero(a: Int) -> Bool {
  a == 0
}
data int_abelian_group: AbelianGroup<Int> = AbelianGroup {
  group: Group {
    monoid: Monoid {
      semigroup: Semigroup { magma: Magma { op: int_add } },
      identity: 0
    },
    inverse: int_negate
  }
}

data int_ordered_ring: OrderedRing<Int> = OrderedRing {
  ring: Ring {
    add: int_abelian_group,
    mul: Monoid {
      semigroup: Semigroup { magma: Magma { op: int_mul } },
      identity: 1
    }
  },
  compare: int_compare
}
data integer_div_by_zero: Symbol = integer_div_by_zero
data integer_modulo_by_zero: Symbol = integer_modulo_by_zero

fn integer_divide_by_zero_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: integer_div_by_zero,
    at: at,
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn integer_modulo_by_zero_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: integer_modulo_by_zero,
    at: at,
    correction: Unavailable { reason: AmbiguousIntent }
  }
}
fn int_div(a: Int, b: Int, at: Locus) -> Outcome<Int> {
  if int_is_zero(a: b) {
    Rejected {
      diagnostics: diagnostics_singleton(d: integer_divide_by_zero_diagnostic(at: at))
    }
  } else {
    Accepted { value: a / b, diagnostics: None }
  }
}

fn int_mod(a: Int, b: Int, at: Locus) -> Outcome<Int> {
  if int_is_zero(a: b) {
    Rejected {
      diagnostics: diagnostics_singleton(d: integer_modulo_by_zero_diagnostic(at: at))
    }
  } else {
    Accepted { value: a % b, diagnostics: None }
  }
}
