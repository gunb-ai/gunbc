// src/v4/std/integer.dag
// Scope: Abstract Int/UInt, fixed-width projections, divide/modulo carriers and diagnostics.
// Consumes: std/node.dag (Instantiation, Symbol); std/nat.dag (Nat); std/machine.dag (MachineWidth, PointerWidth, Word8, Word16, Word32, Word64, Word128); std/algebra.dag (Magma, Semigroup, Monoid, Group, AbelianGroup, Ring, OrderedRing, Ordering); std/diagnostic.dag (Diagnostic, Locus, Correction, NoCorrectionReason, Outcome<T> Tier-2 divide/modulo).
// Status: std integer vocabulary (widths, group completion, divide/modulo outcomes).
// Anchor: https://en.wikipedia.org/wiki/Integer
// Ledger: CP-3229-GREEN-TERMINAL, CP-3229-VERIFY, SL-3229-INTEGER-GROUP-COMPLETION, SL-3229-INTEGER-OVERFLOW-SEMANTICS, SL-3229-INTEGER-REPRESENTATION-STUBS.
// 🟢

module v4.std.integer


import v4.std.algebra {
  AbelianGroup,
  Cons,
  Empty,
  fold_list_node,
  FreeMonoid,
  Group,
  length,
  Magma,
  Monoid,
  OrderedRing,
  Ordering,
  Ring,
  Semigroup
}
import v4.std.collection { List }
import v4.std.diagnostic {Correction, Diagnostic, Locus, NoCorrectionReason, Outcome, Accepted, None, diagnostics_singleton}
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.machine {
  MachineWidth,
  PointerWidth,
  Word8,
  Word16,
  Word32,
  Word64,
  Word128
}
import v4.std.nat { Nat }
type GroupCompletion<M>
type Int = GroupCompletion<Nat>
type UInt = Nat
type Compose<carrier, dimension>

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type Signedness = Signed | Unsigned

// 🟡 coproduct dissolution — SL-3229-INTEGER-REPRESENTATION-STUBS — feature:integer-representation-stub-semantics — dissolve-on-arrival: OnesComplement and SignMagnitude gain target-backed representation semantics or are proven unused by the T-4 fact-bundle catalog.
type Representation
  = TwosComplement
  | OnesComplement // stub — no current target uses this representation
  | SignMagnitude  // stub — no current target uses this representation

// 🟡 coproduct dissolution — SL-3229-INTEGER-OVERFLOW-SEMANTICS — feature:integer-overflow-disposition-semantics — dissolve-on-arrival: wrapping/saturating/trapping/undefined overflow are backed by width, bounds, and Outcome semantics consumed by T-4 fact-bundles.
type OverflowDisposition = Wrapping | Saturating | UndefinedBehavior | Trapping

type Int8 = Compose<Int, MachineWidth<Word8>>
type Int16 = Compose<Int, MachineWidth<Word16>>
type Int32 = Compose<Int, MachineWidth<Word32>>
type Int64 = Compose<Int, MachineWidth<Word64>>
type Int128 = Compose<Int, MachineWidth<Word128>>

type UInt8 = Compose<UInt, MachineWidth<Word8>>
type UInt16 = Compose<UInt, MachineWidth<Word16>>
type UInt32 = Compose<UInt, MachineWidth<Word32>>
type UInt64 = Compose<UInt, MachineWidth<Word64>>
type UInt128 = Compose<UInt, MachineWidth<Word128>>

type IntPlatform = Compose<Int, MachineWidth<PointerWidth>>
type UIntPlatform = Compose<UInt, MachineWidth<PointerWidth>>

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type IntegerBoundSign
  = IntegerBoundNegative
  | IntegerBoundNonNegative

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type IntegerRangeEndpoint
  = IntegerRangeInclusiveMin
  | IntegerRangeInclusiveMax

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type DecimalDigit
  = D0
  | D1
  | D2
  | D3
  | D4
  | D5
  | D6
  | D7
  | D8
  | D9

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type NonZeroDecimalDigit
  = D1
  | D2
  | D3
  | D4
  | D5
  | D6
  | D7
  | D8
  | D9

// 🟢 grounded.
type DecimalNonZeroMagnitude {
  lead: NonZeroDecimalDigit
  tail: List<DecimalDigit>
}

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type DecimalMagnitude
  = DecimalZero
  | DecimalNonZero { magnitude: DecimalNonZeroMagnitude }

// 🟢 coproduct dissolution · CP-3229-GREEN-TERMINAL.
type IntegerIntervalBound
  = IntegerConcreteZero
  | IntegerConcreteBound { sign: IntegerBoundSign, magnitude: DecimalNonZeroMagnitude }
  | IntegerPointerWidthBound { signedness: Signedness, endpoint: IntegerRangeEndpoint }

// 🟢 grounded.
type IntegerIntervalSpec {
  inclusive_min: IntegerIntervalBound
  inclusive_max: IntegerIntervalBound
}

fn decimal_digit_value(d: DecimalDigit) -> Int {
  match d {
    D0 => 0
    D1 => 1
    D2 => 2
    D3 => 3
    D4 => 4
    D5 => 5
    D6 => 6
    D7 => 7
    D8 => 8
    D9 => 9
  }
}

fn decimal_digit_compare(left: DecimalDigit, right: DecimalDigit) -> Ordering {
  int_compare(a: decimal_digit_value(d: left), b: decimal_digit_value(d: right))
}

fn decimal_digit_list_compare(left: FreeMonoid<DecimalDigit>, right: FreeMonoid<DecimalDigit>) -> Ordering {
  match left {
    Empty => match right {
      Empty => Equal
      Cons { head: _, tail: _ } => Less
    }
    Cons { head: left_head, tail: left_tail } => match right {
      Empty => Greater
      Cons { head: right_head, tail: right_tail } =>
        match decimal_digit_compare(left: left_head, right: right_head) {
          Equal => decimal_digit_list_compare(left: left_tail, right: right_tail)
          Less => Less
          Greater => Greater
        }
    }
  }
}

fn decimal_nonzero_magnitude_compare(left: DecimalNonZeroMagnitude, right: DecimalNonZeroMagnitude) -> Ordering {
  let left_len = 1 + length(xs: left.tail)
  let right_len = 1 + length(xs: right.tail)
  if left_len < right_len {
    Less
  } else if left_len > right_len {
    Greater
  } else {
    match decimal_digit_compare(left: left.lead, right: right.lead) {
      Equal => decimal_digit_list_compare(left: left.tail, right: right.tail)
      Less => Less
      Greater => Greater
    }
  }
}

fn integer_interval_bound_compare(left: IntegerIntervalBound, right: IntegerIntervalBound) -> Ordering {
  match left {
    IntegerConcreteZero => match right {
      IntegerConcreteZero => Equal
      IntegerConcreteBound { sign, magnitude: _ } => match sign {
        IntegerBoundNegative => Greater
        IntegerBoundNonNegative => Less
      }
      IntegerPointerWidthBound { signedness: _, endpoint: _ } =>
        if left == right { Equal } else { Less }
    }
    IntegerConcreteBound { sign: left_sign, magnitude: left_magnitude } => match right {
      IntegerConcreteZero => match left_sign {
        IntegerBoundNegative => Less
        IntegerBoundNonNegative => Greater
      }
      IntegerConcreteBound { sign: right_sign, magnitude: right_magnitude } => match left_sign {
        IntegerBoundNegative => match right_sign {
          IntegerBoundNegative => match decimal_nonzero_magnitude_compare(left: left_magnitude, right: right_magnitude) {
            Equal => Equal
            Less => Greater
            Greater => Less
          }
          IntegerBoundNonNegative => Less
        }
        IntegerBoundNonNegative => match right_sign {
          IntegerBoundNegative => Greater
          IntegerBoundNonNegative => decimal_nonzero_magnitude_compare(left: left_magnitude, right: right_magnitude)
        }
      }
      IntegerPointerWidthBound { signedness: _, endpoint: _ } =>
        if left == right { Equal } else { Less }
    }
    IntegerPointerWidthBound { signedness: _, endpoint: _ } =>
      if left == right { Equal } else { Greater }
  }
}

fn integer_interval_bound_less_or_equal(left: IntegerIntervalBound, right: IntegerIntervalBound) -> Bool {
  match integer_interval_bound_compare(left: left, right: right) {
    Less => true
    Equal => true
    Greater => false
  }
}

fn integer_interval_spec_contains(container: IntegerIntervalSpec, contained: IntegerIntervalSpec) -> Bool {
  integer_interval_bound_less_or_equal(left: container.inclusive_min, right: contained.inclusive_min)
    && integer_interval_bound_less_or_equal(left: contained.inclusive_max, right: container.inclusive_max)
}
fn integer_interval_spec_strictly_contains(container: IntegerIntervalSpec, contained: IntegerIntervalSpec) -> Bool {
  integer_interval_spec_contains(container: container, contained: contained)
    && !integer_interval_spec_contains(container: contained, contained: container)
}

fn integer_interval_spec_node_contains(container: Node, contained: Node) -> Bool {
  if container == contained {
    true
  } else if container == integer_interval_spec_node(spec: int128_interval_spec()) {
    (contained == integer_interval_spec_node(spec: int64_interval_spec()))
      || (contained == integer_interval_spec_node(spec: int32_interval_spec()))
      || (contained == integer_interval_spec_node(spec: int16_interval_spec()))
      || (contained == integer_interval_spec_node(spec: int8_interval_spec()))
  } else if container == integer_interval_spec_node(spec: int64_interval_spec()) {
    (contained == integer_interval_spec_node(spec: int32_interval_spec()))
      || (contained == integer_interval_spec_node(spec: int16_interval_spec()))
      || (contained == integer_interval_spec_node(spec: int8_interval_spec()))
  } else if container == integer_interval_spec_node(spec: int32_interval_spec()) {
    (contained == integer_interval_spec_node(spec: int16_interval_spec()))
      || (contained == integer_interval_spec_node(spec: int8_interval_spec()))
  } else if container == integer_interval_spec_node(spec: int16_interval_spec()) {
    contained == integer_interval_spec_node(spec: int8_interval_spec())
  } else if container == integer_interval_spec_node(spec: uint128_interval_spec()) {
    (contained == integer_interval_spec_node(spec: uint64_interval_spec()))
      || (contained == integer_interval_spec_node(spec: uint32_interval_spec()))
      || (contained == integer_interval_spec_node(spec: uint16_interval_spec()))
      || (contained == integer_interval_spec_node(spec: uint8_interval_spec()))
  } else if container == integer_interval_spec_node(spec: uint64_interval_spec()) {
    (contained == integer_interval_spec_node(spec: uint32_interval_spec()))
      || (contained == integer_interval_spec_node(spec: uint16_interval_spec()))
      || (contained == integer_interval_spec_node(spec: uint8_interval_spec()))
  } else if container == integer_interval_spec_node(spec: uint32_interval_spec()) {
    (contained == integer_interval_spec_node(spec: uint16_interval_spec()))
      || (contained == integer_interval_spec_node(spec: uint8_interval_spec()))
  } else if container == integer_interval_spec_node(spec: uint16_interval_spec()) {
    contained == integer_interval_spec_node(spec: uint8_interval_spec())
  } else {
    false
  }
}
fn integer_interval(
  inclusive_min: IntegerIntervalBound,
  inclusive_max: IntegerIntervalBound
) -> IntegerIntervalSpec {
  IntegerIntervalSpec {
    inclusive_min: inclusive_min,
    inclusive_max: inclusive_max
  }
}

fn integer_concrete_zero() -> IntegerIntervalBound {
  IntegerConcreteZero
}

fn integer_concrete_bound(
  sign: IntegerBoundSign,
  magnitude: DecimalNonZeroMagnitude
) -> IntegerIntervalBound {
  IntegerConcreteBound { sign: sign, magnitude: magnitude }
}

fn integer_pointer_width_bound(
  signedness: Signedness,
  endpoint: IntegerRangeEndpoint
) -> IntegerIntervalBound {
  IntegerPointerWidthBound { signedness: signedness, endpoint: endpoint }
}

fn int8_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, magnitude: DecimalNonZeroMagnitude { lead: D1, tail: [D2, D8] }),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D1, tail: [D2, D7] })
  )
}

fn int16_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, magnitude: DecimalNonZeroMagnitude { lead: D3, tail: [D2, D7, D6, D8] }),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D3, tail: [D2, D7, D6, D7] })
  )
}

fn int32_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, magnitude: DecimalNonZeroMagnitude { lead: D2, tail: [D1, D4, D7, D4, D8, D3, D6, D4, D8] }),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D2, tail: [D1, D4, D7, D4, D8, D3, D6, D4, D7] })
  )
}

fn int64_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, magnitude: DecimalNonZeroMagnitude { lead: D9, tail: [D2, D2, D3, D3, D7, D2, D0, D3, D6, D8, D5, D4, D7, D7, D5, D8, D0, D8] }),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D9, tail: [D2, D2, D3, D3, D7, D2, D0, D3, D6, D8, D5, D4, D7, D7, D5, D8, D0, D7] })
  )
}

fn int128_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_bound(sign: IntegerBoundNegative, magnitude: DecimalNonZeroMagnitude { lead: D1, tail: [D7, D0, D1, D4, D1, D1, D8, D3, D4, D6, D0, D4, D6, D9, D2, D3, D1, D7, D3, D1, D6, D8, D7, D3, D0, D3, D7, D1, D5, D8, D8, D4, D1, D0, D5, D7, D2, D8] }),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D1, tail: [D7, D0, D1, D4, D1, D1, D8, D3, D4, D6, D0, D4, D6, D9, D2, D3, D1, D7, D3, D1, D6, D8, D7, D3, D0, D3, D7, D1, D5, D8, D8, D4, D1, D0, D5, D7, D2, D7] })
  )
}

fn uint8_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_zero(),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D2, tail: [D5, D5] })
  )
}

fn uint16_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_zero(),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D6, tail: [D5, D5, D3, D5] })
  )
}

fn uint32_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_zero(),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D4, tail: [D2, D9, D4, D9, D6, D7, D2, D9, D5] })
  )
}

fn uint64_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_zero(),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D1, tail: [D8, D4, D4, D6, D7, D4, D4, D0, D7, D3, D7, D0, D9, D5, D5, D1, D6, D1, D5] })
  )
}

fn uint128_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_concrete_zero(),
    inclusive_max: integer_concrete_bound(sign: IntegerBoundNonNegative, magnitude: DecimalNonZeroMagnitude { lead: D3, tail: [D4, D0, D2, D8, D2, D3, D6, D6, D9, D2, D0, D9, D3, D8, D4, D6, D3, D4, D6, D3, D3, D7, D4, D6, D0, D7, D4, D3, D1, D7, D6, D8, D2, D1, D1, D4, D5, D5] })
  )
}

fn int_platform_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_pointer_width_bound(signedness: Signed, endpoint: IntegerRangeInclusiveMin),
    inclusive_max: integer_pointer_width_bound(signedness: Signed, endpoint: IntegerRangeInclusiveMax)
  )
}

fn uint_platform_interval_spec() -> IntegerIntervalSpec {
  integer_interval(
    inclusive_min: integer_pointer_width_bound(signedness: Unsigned, endpoint: IntegerRangeInclusiveMin),
    inclusive_max: integer_pointer_width_bound(signedness: Unsigned, endpoint: IntegerRangeInclusiveMax)
  )
}

fn integer_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}

fn integer_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn integer_bound_sign_node(sign: IntegerBoundSign) -> Node {
  match sign {
    IntegerBoundNegative => integer_inhabitant_atom(id: ^integer_tag_bound_negative)
    IntegerBoundNonNegative => integer_inhabitant_atom(id: ^integer_tag_bound_nonnegative)
  }
}

fn integer_signedness_node(signedness: Signedness) -> Node {
  match signedness {
    Signed => integer_inhabitant_atom(id: ^integer_tag_signed)
    Unsigned => integer_inhabitant_atom(id: ^integer_tag_unsigned)
  }
}

fn integer_range_endpoint_node(endpoint: IntegerRangeEndpoint) -> Node {
  match endpoint {
    IntegerRangeInclusiveMin => integer_inhabitant_atom(id: ^integer_tag_range_inclusive_min)
    IntegerRangeInclusiveMax => integer_inhabitant_atom(id: ^integer_tag_range_inclusive_max)
  }
}

fn integer_decimal_digit_node(digit: DecimalDigit) -> Node {
  match digit {
    D0 => integer_inhabitant_atom(id: ^integer_tag_digit_0)
    D1 => integer_inhabitant_atom(id: ^integer_tag_digit_1)
    D2 => integer_inhabitant_atom(id: ^integer_tag_digit_2)
    D3 => integer_inhabitant_atom(id: ^integer_tag_digit_3)
    D4 => integer_inhabitant_atom(id: ^integer_tag_digit_4)
    D5 => integer_inhabitant_atom(id: ^integer_tag_digit_5)
    D6 => integer_inhabitant_atom(id: ^integer_tag_digit_6)
    D7 => integer_inhabitant_atom(id: ^integer_tag_digit_7)
    D8 => integer_inhabitant_atom(id: ^integer_tag_digit_8)
    D9 => integer_inhabitant_atom(id: ^integer_tag_digit_9)
  }
}

// NonZeroDecimalDigit ⊂ DecimalDigit: widen the leading digit so a magnitude lowers as a
// uniform digit sequence. The nonzero-lead invariant lives in the type, not the node.
fn integer_nonzero_decimal_digit_widen(digit: NonZeroDecimalDigit) -> DecimalDigit {
  match digit {
    D1 => D1
    D2 => D2
    D3 => D3
    D4 => D4
    D5 => D5
    D6 => D6
    D7 => D7
    D8 => D8
    D9 => D9
  }
}

// A decimal magnitude is an ordered digit sequence (place value = order), so it lowers via the
// canonical FreeMonoid encoding (fold_list_node: named head/tail cons cells), NOT a flat
// positional Conj — positional edges under a Conj fail well_formed (Conj requires labeled edges).
fn integer_decimal_nonzero_node(magnitude: DecimalNonZeroMagnitude) -> Node {
  match magnitude {
    DecimalNonZeroMagnitude { lead, tail } =>
      fold_list_node(
        xs: Cons { head: integer_nonzero_decimal_digit_widen(digit: lead), tail: tail },
        item_node: fn(digit) { integer_decimal_digit_node(digit: digit) }
      )
  }
}

fn integer_decimal_magnitude_node(magnitude: DecimalMagnitude) -> Node {
  match magnitude {
    DecimalZero =>
      fold_list_node(
        xs: Cons { head: D0, tail: Empty },
        item_node: fn(digit) { integer_decimal_digit_node(digit: digit) }
      )
    DecimalNonZero { magnitude } => integer_decimal_nonzero_node(magnitude: magnitude)
  }
}

fn integer_interval_bound_node(bound: IntegerIntervalBound) -> Node {
  match bound {
    IntegerConcreteZero => Node {
      kind: TypeNode { connective: Conj },
      children: [
        integer_named_edge(
          name: ^integer_bound_field_kind,
          target: integer_inhabitant_atom(id: ^integer_tag_bound_zero)
        )
      ]
    }
    IntegerConcreteBound { sign, magnitude } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        integer_named_edge(
          name: ^integer_bound_field_kind,
          target: integer_inhabitant_atom(id: ^integer_tag_bound_concrete)
        ),
        integer_named_edge(
          name: ^integer_bound_field_sign,
          target: integer_bound_sign_node(sign: sign)
        ),
        integer_named_edge(
          name: ^integer_bound_field_magnitude,
          target: integer_decimal_nonzero_node(magnitude: magnitude)
        )
      ]
    }
    IntegerPointerWidthBound { signedness, endpoint } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        integer_named_edge(
          name: ^integer_bound_field_kind,
          target: integer_inhabitant_atom(id: ^integer_tag_bound_pointer_width)
        ),
        integer_named_edge(
          name: ^integer_bound_field_signedness,
          target: integer_signedness_node(signedness: signedness)
        ),
        integer_named_edge(
          name: ^integer_bound_field_endpoint,
          target: integer_range_endpoint_node(endpoint: endpoint)
        )
      ]
    }
  }
}

fn integer_interval_spec_node(spec: IntegerIntervalSpec) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      integer_named_edge(
        name: ^integer_interval_field_inclusive_min,
        target: integer_interval_bound_node(bound: spec.inclusive_min)
      ),
      integer_named_edge(
        name: ^integer_interval_field_inclusive_max,
        target: integer_interval_bound_node(bound: spec.inclusive_max)
      )
    ]
  }
}
fn int_add(a: Int, b: Int) -> Int {
  a + b
}

fn int_negate(a: Int) -> Int {
  0 - a
}

fn int_mul(a: Int, b: Int) -> Int {
  a * b
}

fn int_compare(a: Int, b: Int) -> Ordering {
  if a < b {
    Less
  } else {
    if a == b {
      Equal
    } else {
      Greater
    }
  }
}

fn int_is_zero(a: Int) -> Bool {
  a == 0
}
data int_abelian_group: AbelianGroup<Int> = AbelianGroup {
  group: Group {
    monoid: Monoid {
      semigroup: Semigroup { magma: Magma { op: int_add } },
      identity: 0
    },
    inverse: int_negate
  }
}

data int_ordered_ring: OrderedRing<Int> = OrderedRing {
  ring: Ring {
    add: int_abelian_group,
    mul: Monoid {
      semigroup: Semigroup { magma: Magma { op: int_mul } },
      identity: 1
    }
  },
  compare: int_compare
}
fn integer_divide_by_zero_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^integer_div_by_zero,
    at: at,
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn integer_modulo_by_zero_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: ^integer_modulo_by_zero,
    at: at,
    correction: Unavailable { reason: AmbiguousIntent }
  }
}
fn int_div(a: Int, b: Int, at: Locus) -> Outcome<Int> {
  if int_is_zero(a: b) {
    Rejected {
      diagnostics: diagnostics_singleton(d: integer_divide_by_zero_diagnostic(at: at))
    }
  } else {
    Accepted { value: a / b, diagnostics: None }
  }
}

fn int_mod(a: Int, b: Int, at: Locus) -> Outcome<Int> {
  if int_is_zero(a: b) {
    Rejected {
      diagnostics: diagnostics_singleton(d: integer_modulo_by_zero_diagnostic(at: at))
    }
  } else {
    Accepted { value: a % b, diagnostics: None }
  }
}
