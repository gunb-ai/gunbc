// src/v4/std/integer.dag
//
// Scope: integers — the abstract signed whole numbers and their fixed-
//        width machine projections. This is the projection site: a
//        machine integer is a natural number projected onto a machine
//        width (the v3 `Int64 = Compose<Int, MachineWidth<Word64>>`
//        direction).
// Anchor: https://en.wikipedia.org/wiki/Integer
//
// Owns:
//   - Int — abstract signed integer, constructed from `Nat`
//     (the v3 `AbelianGroup<GroupCompletion<Nat>>` construction chain)
//   - Int8 … Int128, UInt8 … UInt128 — Int / Nat projected onto a
//     std/machine.dag `MachineWidth`
//   - inhabitance: Int inhabits `OrderedRing` / `AbelianGroup`
//   - Tier-2 partial-op totalization for integer divide / modulo
//     (Result-return / refinement-precondition — STRUCTURE.md commitment #2)
//
// Consumes:
//   - std/node.dag: Instantiation, Symbol
//   - std/nat.dag: Nat
//   - std/machine.dag: MachineWidth, PointerWidth, Word8, Word16,
//     Word32, Word64, Word128
//   - std/algebra.dag: Magma, Semigroup, Monoid, Group, AbelianGroup,
//     Ring, OrderedRing, Ordering
//   - std/diagnostic.dag: Diagnostic, Locus, Correction,
//     NoCorrectionReason, Outcome<T> for Tier-2 divide/modulo
//
// D2 (operator-ratified 2026-05-16; see DECISIONS.md D2) — this file is
//   the SINGLE authority for integer algebra inhabitance. `Int` inhabits
//   `OrderedRing` / `AbelianGroup` here, ONCE. That inhabitance is filled
//   by the construction chain — Peano `Nat` (std/nat.dag) →
//   `GroupCompletion` → `AbelianGroup`, and `Compose<MachineWidth>` for
//   the fixed-width projections — so its operation `Arrow` bodies are
//   sub-DAGs of L1 behaviors (THESIS:203's user-function case), never
//   `extdeps/` primitive realizations: the integer chain is fully
//   constructive (contrast std/float.dag's D2b, where IEEE-754 ops ARE
//   primitives — `Arrow` bodies that are `extdeps/` realizations per
//   THESIS:203).
//   A language/format `extdeps` file does NOT re-declare an integer
//   algebra inhabitance: per INVARIANTS P1:42 (`numeric_aliases_align_
//   to_refinements`) a per-language `OrderedRing<<lang>Int, …>` is the
//   forbidden parallel substrate. A language carrier instead ALIAS-
//   IDENTIFIES to the `Int8 … Int128` / `UInt8 … UInt128` declared here
//   (`type RustI32 = Int32`); the algebra flows through the alias.
//   Overflow / UB / arbitrary-precision are DISTINCT carriers here (the
//   wrapping ring, the partial/totalized op, unbounded `Int`); a language
//   selects one via its alias target plus a sibling `OverflowDisposition`
//   carrier declared in its own `extdeps` file.
//
// Status: T-3 modeled 2026-05-16 (jolly-gull-889). Replaces part of the
//   deleted std/primitive.dag; see src/v4/STRUCTURE.md §"scalar/numeric
//   concept decomposition".
// HEADER RECONCILE (2026-05-16, #3190, smart-fox-602 + operator Decision 2):
//   the frozen scaffold header understated delivered imports and remained
//   marked scaffold after the model landed. Consumes now names the actual
//   machine-width, algebra-witness, diagnostic, and Symbol dependencies.
//   Decision 2 also fixes integer-owned diagnostic reasons as Symbol name-
//   references declared in this file, not caller-supplied values.
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.std.integer


import v4.std.algebra {
  AbelianGroup,
  Group,
  Magma,
  Monoid,
  OrderedRing,
  Ordering,
  Ring,
  Semigroup
}
import v4.std.diagnostic {
  Correction,
  Diagnostic,
  Locus,
  NoCorrectionReason,
  Outcome
}
import v4.std.node { Symbol }
import v4.std.machine {
  MachineWidth,
  PointerWidth,
  Word8,
  Word16,
  Word32,
  Word64,
  Word128
}
import v4.std.nat { Nat }


// ─────────────────────────────────────────────────────────────────────
// Modeling notes (read before validating against the anchor)
//
// V4 SPLITS CARRIER FROM WITNESS. The v3 spelling
// `Int = AbelianGroup<GroupCompletion<Nat>>` named the construction chain
// compactly, but v4's scalar files use instance-values for inhabitance
// (see nat.dag / logic.dag): the concrete carrier is named first, then
// the algebra value over that carrier is declared here. Consequently:
//   - `GroupCompletion<M>` is the derived carrier construction.
//   - `Int = GroupCompletion<Nat>` is the abstract signed-integer carrier.
//   - `data int_abelian_group` and `data int_ordered_ring` are the
//     machine-readable inhabitance edges.
//
// GROUP-COMPLETION IS LOCAL TO THIS CONCEPT FILE. std/algebra.dag's v4
// scope is "structures only" and deliberately omits construction
// carriers except FreeMonoid<T>, whose carrier shape is itself the root
// free construction. `GroupCompletion<M>` exists here because this file
// is the sole v4 consumer in the closed tree: the construction is needed
// to model integers from Nat, and exporting it from algebra.dag would
// widen the T-2 structures file after its brief. The record is the
// formal-difference representation: `positive - negative`. Equality is
// quotient equality; comparison below cross-adds to avoid choosing a
// canonical normal form as a hidden second authority.
//
// CONSTRAINED-INHABITANCE GAP (tracked scaffold). Denotationally the
// Grothendieck group completion requires a commutative monoid. v4 does
// not yet have a parametric where-clause syntax such as
// `<M> where M : CommutativeMonoid<_>`. The only authored use here is
// `GroupCompletion<Nat>`, and nat.dag already declares Nat's additive
// `CommutativeMonoid<Nat>` instance, so the mathematical precondition
// holds for the actual construction. Dissolution trigger: when v4 lands
// constrained generic parameters / inhabitance bounds, tighten
// `GroupCompletion<M>` to require the commutative-monoid witness.
//
// FIXED-WIDTH INTEGERS ARE WIDTH PROJECTIONS. A machine integer is not a
// sibling algebra authority beside abstract `Int` / `UInt`; it is the
// abstract carrier composed with the independent machine-width axis
// (`Compose<Int, MachineWidth<Word64>>`, etc.). This preserves the D2
// fact-flow shape from INVARIANTS P1: width rows alias the abstract
// carrier plus a width refinement, and no fixed-width row declares a
// separate OrderedRing/Semiring instance in this file.
//
// TIER-2 TOTALIZATION. Integer division and modulo are partial at divisor
// zero. Per STRUCTURE.md commitment #2, the totalized operations live
// here and return std/diagnostic.dag's ratified `Outcome<Int>` carrier
// (DECISIONS.md I), not a new Result type. The source location is call-
// site context (`at: Locus`), but the failure reason is intrinsic to the
// integer dimension: integer.dag declares the Symbol name-references
// `integer_div_by_zero` and `integer_modulo_by_zero`, then uses those
// names in the produced Diagnostic.


// ─────────────────────────────────────────────────────────────────────
// GroupCompletion<M> — the carrier produced by completing a commutative
// monoid to an abelian group (Grothendieck construction). A value is the
// formal difference `positive - negative`; quotient equality is observed
// by the operations below through cross-addition.
type GroupCompletion<M> {
  positive: M
  negative: M
}


// ─────────────────────────────────────────────────────────────────────
// Int / UInt — abstract integer carriers.
//
// `Int` is the signed carrier obtained by group-completing Nat's
// additive commutative monoid. `UInt` is Nat itself: unsigned integers
// require no additive inverse, so wrapping Nat would only drop facts
// nat.dag already provides.
type Int = GroupCompletion<Nat>
type UInt = Nat


// ─────────────────────────────────────────────────────────────────────
// Fixed-width integer projections over std/machine.dag's width axis.
//
// `Compose<carrier, dimension>` is the D2 projection carrier used by the
// fixed-width aliases. It is intentionally body-less: the dimension is a
// refinement axis, not a runtime field beside the numeric value.
type Compose<carrier, dimension>

type Int8 = Compose<Int, MachineWidth<Word8>>
type Int16 = Compose<Int, MachineWidth<Word16>>
type Int32 = Compose<Int, MachineWidth<Word32>>
type Int64 = Compose<Int, MachineWidth<Word64>>
type Int128 = Compose<Int, MachineWidth<Word128>>

type UInt8 = Compose<UInt, MachineWidth<Word8>>
type UInt16 = Compose<UInt, MachineWidth<Word16>>
type UInt32 = Compose<UInt, MachineWidth<Word32>>
type UInt64 = Compose<UInt, MachineWidth<Word64>>
type UInt128 = Compose<UInt, MachineWidth<Word128>>

type IntPlatform = Compose<Int, MachineWidth<PointerWidth>>
type UIntPlatform = Compose<UInt, MachineWidth<PointerWidth>>


// ─────────────────────────────────────────────────────────────────────
// Integer algebra operations. These functions construct `Int` from
// Nat's Peano operations, then bind those functions into the single
// algebra instance-values below. Operations are not re-declared
// elsewhere; consumers reach them through `int_ordered_ring`.
fn nat_compare_for_int(a: Nat, b: Nat) -> Ordering {
  match a {
    Zero => match b {
      Zero => Equal
      Succ { prev: bp } => Less
    }
    Succ { prev: ap } => match b {
      Zero => Greater
      Succ { prev: bp } => nat_compare_for_int(a: ap, b: bp)
    }
  }
}

fn nat_less_for_int(a: Nat, b: Nat) -> Bool {
  match nat_compare_for_int(a: a, b: b) {
    Less => true
    Equal => false
    Greater => false
  }
}

fn nat_sub_saturating_for_int(a: Nat, b: Nat) -> Nat {
  match a {
    Zero => Zero
    Succ { prev: ap } => match b {
      Zero => a
      Succ { prev: bp } => nat_sub_saturating_for_int(a: ap, b: bp)
    }
  }
}

fn nat_div_total_for_int(a: Nat, b: Nat) -> Nat {
  match b {
    Zero => Zero
    Succ { prev: bp } => if nat_less_for_int(a: a, b: b) {
      Zero
    } else {
      Succ {
        prev: nat_div_total_for_int(
          a: nat_sub_saturating_for_int(a: a, b: b),
          b: b
        )
      }
    }
  }
}

fn nat_mod_total_for_int(a: Nat, b: Nat) -> Nat {
  match b {
    Zero => a
    Succ { prev: bp } => if nat_less_for_int(a: a, b: b) {
      a
    } else {
      nat_mod_total_for_int(a: nat_sub_saturating_for_int(a: a, b: b), b: b)
    }
  }
}

fn int_zero() -> Int {
  GroupCompletion { positive: Zero, negative: Zero }
}

fn int_one() -> Int {
  GroupCompletion { positive: Succ { prev: Zero }, negative: Zero }
}

fn int_add(a: Int, b: Int) -> Int {
  GroupCompletion {
    positive: nat_add(a: a.positive, b: b.positive),
    negative: nat_add(a: a.negative, b: b.negative)
  }
}

fn int_negate(a: Int) -> Int {
  GroupCompletion { positive: a.negative, negative: a.positive }
}

fn int_mul(a: Int, b: Int) -> Int {
  GroupCompletion {
    positive: nat_add(
      a: nat_mul(a: a.positive, b: b.positive),
      b: nat_mul(a: a.negative, b: b.negative)
    ),
    negative: nat_add(
      a: nat_mul(a: a.positive, b: b.negative),
      b: nat_mul(a: a.negative, b: b.positive)
    )
  }
}

fn int_compare(a: Int, b: Int) -> Ordering {
  nat_compare_for_int(
    a: nat_add(a: a.positive, b: b.negative),
    b: nat_add(a: b.positive, b: a.negative)
  )
}

fn int_is_zero(a: Int) -> Bool {
  match int_compare(a: a, b: int_zero()) {
    Less => false
    Equal => true
    Greater => false
  }
}

fn int_is_negative(a: Int) -> Bool {
  match int_compare(a: a, b: int_zero()) {
    Less => true
    Equal => false
    Greater => false
  }
}

fn int_abs_nat(a: Int) -> Nat {
  match int_compare(a: a, b: int_zero()) {
    Less => nat_sub_saturating_for_int(a: a.negative, b: a.positive)
    Equal => Zero
    Greater => nat_sub_saturating_for_int(a: a.positive, b: a.negative)
  }
}

fn int_from_nat(n: Nat) -> Int {
  GroupCompletion { positive: n, negative: Zero }
}

fn int_signs_differ(a: Int, b: Int) -> Bool {
  if int_is_negative(a: a) {
    if int_is_negative(a: b) {
      false
    } else {
      true
    }
  } else {
    int_is_negative(a: b)
  }
}

fn int_from_signed_nat(n: Nat, negative: Bool) -> Int {
  if negative {
    int_negate(a: int_from_nat(n: n))
  } else {
    int_from_nat(n: n)
  }
}


// ─────────────────────────────────────────────────────────────────────
// Inhabitance — Int grounds in AbelianGroup and OrderedRing.
//
// The additive group is named separately because `OrderedRing.ring.add`
// consumes the same authority; it is not re-listed inside the ring.
data int_abelian_group: AbelianGroup<Int> = AbelianGroup {
  group: Group {
    monoid: Monoid {
      semigroup: Semigroup { magma: Magma { op: int_add } },
      identity: GroupCompletion { positive: Zero, negative: Zero }
    },
    inverse: int_negate
  }
}

data int_ordered_ring: OrderedRing<Int> = OrderedRing {
  ring: Ring {
    add: int_abelian_group,
    mul: Monoid {
      semigroup: Semigroup { magma: Magma { op: int_mul } },
      identity: GroupCompletion { positive: Succ { prev: Zero }, negative: Zero }
    }
  },
  compare: int_compare
}


// ─────────────────────────────────────────────────────────────────────
// Diagnostic construction for integer partial operations. The `reason`
// is a Symbol name-reference owned by this integer dimension;
// diagnostic.dag owns only the schema.
data integer_div_by_zero: Symbol = integer_div_by_zero
data integer_modulo_by_zero: Symbol = integer_modulo_by_zero

fn integer_divide_by_zero_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: integer_div_by_zero,
    at: at,
    correction: Unavailable { reason: AmbiguousIntent }
  }
}

fn integer_modulo_by_zero_diagnostic(at: Locus) -> Diagnostic {
  Diagnostic {
    reason: integer_modulo_by_zero,
    at: at,
    correction: Unavailable { reason: AmbiguousIntent }
  }
}


// ─────────────────────────────────────────────────────────────────────
// Tier-2 totalized integer partial operations.
//
// `int_div` and `int_mod` are total functions: divisor zero produces a
// typed `Rejected { diagnostic }`; all other cases produce the value.
// There is no sentinel integer and no panic-shaped boundary.
fn int_div(a: Int, b: Int, at: Locus) -> Outcome<Int> {
  if int_is_zero(a: b) {
    Rejected {
      diagnostic: integer_divide_by_zero_diagnostic(at: at)
    }
  } else {
    Produced {
      value: int_from_signed_nat(
        n: nat_div_total_for_int(a: int_abs_nat(a: a), b: int_abs_nat(a: b)),
        negative: int_signs_differ(a: a, b: b)
      )
    }
  }
}

fn int_mod(a: Int, b: Int, at: Locus) -> Outcome<Int> {
  if int_is_zero(a: b) {
    Rejected {
      diagnostic: integer_modulo_by_zero_diagnostic(at: at)
    }
  } else {
    Produced {
      value: int_from_signed_nat(
        n: nat_mod_total_for_int(a: int_abs_nat(a: a), b: int_abs_nat(a: b)),
        negative: int_is_negative(a: a)
      )
    }
  }
}
