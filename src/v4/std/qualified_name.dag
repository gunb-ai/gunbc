// src/v4/std/qualified_name.dag
// Scope: Qualified names as a projection over symbol sequences.
// Anchor: INVARIANTS.md P1 "Model names must reflect what they are" (T-QN-1).
// Owns: QualifiedName, qualified_name_projection_gated, qualified_name_structure_invalid, qualified_name_singleton, qualified_name_eq, qualified_name_from_node.
// Consumes: std/algebra.dag, std/diagnostic.dag, std/logic.dag, std/node.dag.
// Status: T-QN-1 modeled; T-28 support carrier; consumed by std/catalog.dag, compiler/03_name_resolve.dag.
// Anchor: https://en.wikipedia.org/wiki/Qualified_name

module v4.std.qualified_name


import v4.std.algebra { Cons, Empty, FreeMonoid, fold_list_node_head, fold_list_node_tail, zip_eq }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, NodeFold, Symbol, TypeNode, fold_node }


type QualifiedName = FreeMonoid<Symbol>

// T-8 gate receipt marker — consumed by the 🟡 comment on qualified_name_from_module_node in extdeps/languages/dag.dag; emitted as Diagnostic.reason when segment identity is unavailable pre-T-8.
data qualified_name_projection_gated: Symbol = qualified_name_projection_gated
// Emitted in Diagnostic.reason when a node's structure doesn't match the expected fold_list_node shape.
data qualified_name_structure_invalid: Symbol = qualified_name_structure_invalid


fn qualified_name_singleton(sym: Symbol) -> QualifiedName {
  Cons { head: sym, tail: Empty }
}


fn qualified_name_eq(a: QualifiedName, b: QualifiedName) -> Bool {
  zip_eq(a: a, b: b, eq: fn(x, y) { x == y })
}


// 🟡 traverse-dissolution interim (docs/modeling-discipline.md Practice 4) — feature: traverse-node-outcome-algebra — bind diagnostic.dag Ratified-Q4 — dissolve-on: same Q4 gate as qualified_name_from_node (Outcome-bearing fold_node algebra will carry Outcome natively through the fold, replacing the explicit partial-state tracking in this coproduct; QnFoldStatus collapses entirely); forbidden: promoting QnFoldStatus to a public API or adding arms outside the qualified_name_from_node fold context.
// Internal accumulator for the fold_node algebra in qualified_name_from_node.
// Tracks head and tail independently so the step function is order-independent:
// Conj uses LabeledEdges discipline — labels are the authority, storage order is not.
type QnFoldStatus
  = QnFoldInit                              // initial: neither edge yet seen
  | QnFoldHeadSeen { sym: Symbol }          // head Atom seen; tail edge pending
  | QnFoldTailSeen { tail: QualifiedName }  // tail spine seen; head edge pending
  | QnFoldDone { qn: QualifiedName }        // both edges seen and combined; or leaf result
  | QnFoldError { diag: Diagnostic }        // structural error; propagated up

fn qn_fold_init(n: Node) -> QnFoldStatus {
  match n.kind {
    TypeNode { connective: Conj } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: Empty }
      } else if count(n.children) == 2 {
        QnFoldInit
      } else {
        QnFoldError { diag: Diagnostic {
          reason: qualified_name_structure_invalid,
          at: node_locus(node: n),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
    TypeNode { connective: Atom { identity: sym } } =>
      if count(n.children) == 0 {
        QnFoldDone { qn: Cons { head: sym, tail: Empty } }
      } else {
        QnFoldError { diag: Diagnostic {
          reason: qualified_name_structure_invalid,
          at: node_locus(node: n),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
    _ =>
      QnFoldError { diag: Diagnostic {
        reason: qualified_name_structure_invalid,
        at: node_locus(node: n),
        correction: Unavailable { reason: ExternalContractUnknown }
      }}
  }
}

fn qn_fold_step(acc: QnFoldStatus, edge: Edge, child: QnFoldStatus) -> QnFoldStatus {
  match acc {
    QnFoldError { diag: d } => QnFoldError { diag: d }
    _ =>
      match child {
        QnFoldError { diag: d } => QnFoldError { diag: d }
        QnFoldDone { qn: child_qn } =>
          match edge.label {
            Named { name: ename } =>
              if ename == fold_list_node_head {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: _ } } =>
                    match child_qn {
                      Cons { head: sym, tail: Empty } =>
                        match acc {
                          QnFoldInit => QnFoldHeadSeen { sym: sym }
                          QnFoldTailSeen { tail: tail_qn } => QnFoldDone { qn: Cons { head: sym, tail: tail_qn } }
                          _ => QnFoldError { diag: Diagnostic {
                            reason: qualified_name_structure_invalid,
                            at: node_locus(node: edge.target),
                            correction: Unavailable { reason: ExternalContractUnknown }
                          }}
                        }
                      _ => QnFoldError { diag: Diagnostic {
                        reason: qualified_name_structure_invalid,
                        at: node_locus(node: edge.target),
                        correction: Unavailable { reason: ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: Diagnostic {
                    reason: qualified_name_structure_invalid,
                    at: node_locus(node: edge.target),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  }}
                }
              } else if ename == fold_list_node_tail {
                match edge.target.kind {
                  TypeNode { connective: Conj } =>
                    match acc {
                      QnFoldInit => QnFoldTailSeen { tail: child_qn }
                      QnFoldHeadSeen { sym: sym } => QnFoldDone { qn: Cons { head: sym, tail: child_qn } }
                      _ => QnFoldError { diag: Diagnostic {
                        reason: qualified_name_structure_invalid,
                        at: node_locus(node: edge.target),
                        correction: Unavailable { reason: ExternalContractUnknown }
                      }}
                    }
                  _ => QnFoldError { diag: Diagnostic {
                    reason: qualified_name_structure_invalid,
                    at: node_locus(node: edge.target),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  }}
                }
              } else {
                QnFoldError { diag: Diagnostic {
                  reason: qualified_name_structure_invalid,
                  at: node_locus(node: edge.target),
                  correction: Unavailable { reason: ExternalContractUnknown }
                }}
              }
            _ => QnFoldError { diag: Diagnostic {
              reason: qualified_name_structure_invalid,
              at: node_locus(node: edge.target),
              correction: Unavailable { reason: ExternalContractUnknown }
            }}
          }
        _ => QnFoldError { diag: Diagnostic {
          reason: qualified_name_structure_invalid,
          at: node_locus(node: edge.target),
          correction: Unavailable { reason: ExternalContractUnknown }
        }}
      }
  }
}


// 🟡 traverse-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: traverse-node-outcome-algebra — bind diagnostic.dag Ratified-Q4 — dissolve-on: same Q4 gate (Outcome-bearing fold_node algebra dissolves the nested Rejected/Accepted propagation chains in step); forbidden: re-inlining the carrier ladder after Q4 resolves.
// Accepts a fold_list_node(symbols) Node — the caller obtains this by walking the
// dag_surface_module_header_qualified_name edge of an emitted module header node.
fn qualified_name_from_node(root: Node) -> Outcome<QualifiedName> {
  match root.kind {
    TypeNode { connective: Conj } =>
      let acc = fold_node(n: root, algebra: NodeFold { init: qn_fold_init, step: qn_fold_step })
      match acc {
        QnFoldDone { qn: qn } => outcome_accepted(value: qn)
        QnFoldError { diag: d } => outcome_rejected(d: d)
        _ => outcome_rejected(d: Diagnostic {
          reason: qualified_name_structure_invalid,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      }
    _ => outcome_rejected(d: Diagnostic {
      reason: qualified_name_structure_invalid,
      at: node_locus(node: root),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}
