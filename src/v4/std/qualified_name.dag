// src/v4/std/qualified_name.dag
// Scope: Qualified names as a projection over symbol sequences.
// Anchor: INVARIANTS.md P1 "Model names must reflect what they are" (T-QN-1).
// Owns: QualifiedName, qualified_name_projection_gated, qualified_name_structure_invalid, qualified_name_singleton, qualified_name_eq, qualified_name_from_node.
// Consumes: std/algebra.dag, std/diagnostic.dag, std/logic.dag, std/node.dag.
// Status: T-QN-1 modeled; T-28 support carrier; consumed by std/catalog.dag, compiler/03_name_resolve.dag.
// Anchor: https://en.wikipedia.org/wiki/Qualified_name

module v4.std.qualified_name


import v4.std.algebra { Cons, Empty, FreeMonoid, fold_list_node_head, fold_list_node_tail, zip_eq }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }


type QualifiedName = FreeMonoid<Symbol>

// T-8 gate receipt marker — consumed by the 🟡 comment on qualified_name_from_module_node in extdeps/languages/dag.dag; emitted as Diagnostic.reason when segment identity is unavailable pre-T-8.
data qualified_name_projection_gated: Symbol = qualified_name_projection_gated
// Emitted in Diagnostic.reason when a node's structure doesn't match the expected fold_list_node shape.
data qualified_name_structure_invalid: Symbol = qualified_name_structure_invalid


fn qualified_name_singleton(sym: Symbol) -> QualifiedName {
  Cons { head: sym, tail: Empty }
}


fn qualified_name_eq(a: QualifiedName, b: QualifiedName) -> Bool {
  zip_eq(a: a, b: b, eq: fn(x, y) { x == y })
}


// 🟡 traverse-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: traverse-node-outcome-algebra — bind diagnostic.dag Ratified-Q4 — dissolve-on: v2 bootstrap accepts fn(T) -> Outcome<U> higher-order fn types (Ratified Q4); faithful form sequences over List<Edge> via traverse_node; forbidden: re-inlining the Accepted/Rejected short-circuit ladder after Q4 resolves.
fn qualified_name_find_edge(name: Symbol, n: Node) -> Outcome<Node> {
  let match_count = fold(
    n.children,
    init: 0,
    f: fn(acc, e) {
      match e.label {
        Named { name: ename } => if ename == name { acc + 1 } else { acc }
        _ => acc
      }
    }
  )
  if match_count == 1 {
    fold(
      n.children,
      init: outcome_rejected(Diagnostic {
        reason: qualified_name_structure_invalid,
        at: node_locus(node: n),
        correction: Unavailable { reason: ExternalContractUnknown }
      }),
      f: fn(acc, e) {
        match acc {
          Accepted { value: _, diagnostics: _ } => acc
          Rejected { diagnostics: _ } =>
            match e.label {
              Named { name: ename } =>
                if ename == name { outcome_accepted(value: e.target) } else { acc }
              _ => acc
            }
        }
      }
    )
  } else {
    outcome_rejected(Diagnostic {
      reason: qualified_name_structure_invalid,
      at: node_locus(node: n),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}


fn qualified_name_atom_sym(n: Node) -> Outcome<Symbol> {
  match n.kind {
    TypeNode { connective: Atom { identity: sym } } => outcome_accepted(value: sym)
    _ => outcome_rejected(Diagnostic {
      reason: qualified_name_structure_invalid,
      at: node_locus(node: n),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}


// 🟡 walker-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: traverse-node-outcome-algebra — bind diagnostic.dag Ratified-Q4 — dissolve-on: v2 bootstrap accepts fn(Node) -> Outcome<R> higher-order fn types (Ratified Q4); faithful form is fold_node + NodeFold<Outcome<QualifiedName>> algebra; forbidden: re-inlining the structural Node recursion after Q4 resolves.
// 🟡 traverse-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: traverse-node-outcome-algebra — bind diagnostic.dag Ratified-Q4 — dissolve-on: same Q4 gate (Outcome-bearing fold_node algebra dissolves the nested Rejected/Accepted propagation chains); forbidden: re-inlining the carrier ladder after Q4 resolves.
// Accepts a fold_list_node(symbols) Node — the caller obtains this by walking the
// dag_surface_module_header_qualified_name edge of an emitted module header node.
fn qualified_name_from_node(root: Node) -> Outcome<QualifiedName> {
  match root.kind {
    TypeNode { connective: Conj } =>
      if count(root.children) == 0 {
        outcome_accepted(value: Empty)
      } else if count(root.children) == 2 {
        match qualified_name_find_edge(name: fold_list_node_head, n: root) {
          Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
          Accepted { value: head_node, diagnostics: _ } =>
            match qualified_name_atom_sym(n: head_node) {
              Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
              Accepted { value: sym, diagnostics: _ } =>
                match qualified_name_find_edge(name: fold_list_node_tail, n: root) {
                  Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
                  Accepted { value: tail_node, diagnostics: _ } =>
                    match qualified_name_from_node(root: tail_node) {
                      Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
                      Accepted { value: tail_qn, diagnostics: _ } =>
                        outcome_accepted(value: Cons { head: sym, tail: tail_qn })
                    }
                }
            }
        }
      } else {
        outcome_rejected(Diagnostic {
          reason: qualified_name_structure_invalid,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      }
    _ => outcome_rejected(Diagnostic {
      reason: qualified_name_structure_invalid,
      at: node_locus(node: root),
      correction: Unavailable { reason: ExternalContractUnknown }
    })
  }
}
