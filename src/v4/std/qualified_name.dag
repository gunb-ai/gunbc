// src/v4/std/qualified_name.dag
// Scope: QualifiedName carrier for dotted/scope-qualified identifiers.
// Anchor: INVARIANTS.md P1 "Model names must reflect what they are" (T-QN-1).
// Owns: QualifiedName, qualified_name_singleton, qualified_name_from_node, qualified_name_eq, qualified_name_is_prefix_of.
// Consumes: std/algebra.dag (FreeMonoid, canonical list predicates), std/logic.dag (Bool), std/node.dag (Node, Symbol).
// Status: T-QN-1 modeled; equality/prefix helpers consumed by std/module_graph.dag.

module v4.std.qualified_name


import v4.std.algebra { Cons, Empty, FreeMonoid, is_prefix_of, zip_eq }
import v4.std.logic { Bool }
import v4.std.node { Atom, Node, Symbol, TypeNode }


type QualifiedName = FreeMonoid<Symbol>


fn qualified_name_singleton(sym: Symbol) -> QualifiedName {
  Cons { head: sym, tail: Empty }
}


fn qualified_name_from_node(n: Node) -> QualifiedName? {
  match n.kind {
    TypeNode { connective: Atom { identity: sym } } =>
      Some { value: qualified_name_singleton(sym: sym) }
    _ => None
  }
}


fn qualified_name_eq(a: QualifiedName, b: QualifiedName) -> Bool {
  zip_eq(a: a, b: b, eq: fn(x, y) { x == y })
}


fn qualified_name_is_prefix_of(prefix: QualifiedName, name: QualifiedName) -> Bool {
  is_prefix_of(prefix: prefix, xs: name, eq: fn(a, b) { a == b })
}
