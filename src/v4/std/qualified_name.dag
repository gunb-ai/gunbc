// src/v4/std/qualified_name.dag
// Scope: Qualified names as a projection over symbol sequences.
// Owns: QualifiedName, qualified_name_eq, qualified_name_is_prefix_of.
// Consumes: std/algebra.dag, std/node.dag.
// Status: T-28 support carrier; consumed by std/module_graph.dag.
// Anchor: https://en.wikipedia.org/wiki/Qualified_name


module v4.std.qualified_name


import v4.std.algebra { FreeMonoid, is_prefix_of, zip_eq }
import v4.std.logic { Bool }
import v4.std.node { Symbol }


type QualifiedName = FreeMonoid<Symbol>


fn qualified_name_eq(a: QualifiedName, b: QualifiedName) -> Bool {
  zip_eq(a: a, b: b, eq: fn(x, y) { x == y })
}


fn qualified_name_is_prefix_of(prefix: QualifiedName, name: QualifiedName) -> Bool {
  is_prefix_of(prefix: prefix, xs: name, eq: fn(a, b) { a == b })
}
