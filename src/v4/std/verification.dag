// src/v4/std/verification.dag
// Scope: Closed TestClaim schema — AssertKind, TestgenTier/Layer, TestClassification, ImpossibleBugClass, T19ManualAnchorKey, TestClaim fields.
// Owns: AssertKind TestgenTier TestgenLayer TestClassification ImpossibleBugClass T19ManualAnchorKey T19PresentManualAnchorKey TestClaim assert_kind_for_manual_anchor t19_present_manual_anchor_key
// Consumes: v4.std.node v4.std.diagnostic
// Status: T-3 modeled; substrate extension or file split = operator STOP.

module v4.std.verification


import v4.std.node { Node, Symbol }
import v4.std.diagnostic {
  Outcome,
  Produced,
  Rejected,
  Diagnostic,
  Unavailable,
  UserInputBoundary,
  Textual,
  WholeFile
}


type AssertKind
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = Equals
  | Diagnostic
  | Compiles
  | RoundTrips


type TestgenTier
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = Tier1
  | Tier2
  | Tier3


type TestgenLayer
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = Unit
  | Integration
  | Boundary


type TestClassification {
  tier: TestgenTier
  layer: TestgenLayer
}


type ImpossibleBugClass
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = SuboptimalComplexity
  | IdempotencyContract
  | TransportTypeDrift
  | NestedOptionalFlatten
  | UnenumeratedEffects
  | UnhandledDiagnosticPaths


type T19ManualAnchorKey
// 🟡 coproduct dissolution — DECISIONS.md LB-P4-3212
  = T19ManualTcConjEmpty
  | T19ManualTcDisjEmpty
  | T19ManualTcArrowTwoConj
  | T19ManualTcCardinalityEmpty
  | T19ManualTcInstantiationEmpty
  | T19ManualTcConjEqualsRefl
  | T19ManualNatAddLeftIdentity
  | T19ManualNatAddRightIdentity
  | T19ManualNatAddAssociativity
  | T19ManualNatMulLeftIdentity
  | T19ManualNatMulAnnihilator
  | T19ManualNatMulAssociativity
  | T19ManualAnchorAbsent


type T19PresentManualAnchorKey
// 🟡 coproduct dissolution — DECISIONS.md LB-P4-3212
  = T19ManualTcConjEmpty
  | T19ManualTcDisjEmpty
  | T19ManualTcArrowTwoConj
  | T19ManualTcCardinalityEmpty
  | T19ManualTcInstantiationEmpty
  | T19ManualTcConjEqualsRefl
  | T19ManualNatAddLeftIdentity
  | T19ManualNatAddRightIdentity
  | T19ManualNatAddAssociativity
  | T19ManualNatMulLeftIdentity
  | T19ManualNatMulAnnihilator
  | T19ManualNatMulAssociativity


type TestClaim {
  kind: AssertKind
  label: String
  t19_anchor: T19ManualAnchorKey
  input: Node
  expected: Outcome<Node>
  classification: TestClassification
}


data t19_verification_schema_file: Symbol = t19_verification_schema_file


data t19_manual_anchor_absent_assert_kind: Symbol = t19_manual_anchor_absent_assert_kind


fn t19_manual_anchor_absent_assert_kind_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: t19_manual_anchor_absent_assert_kind,
    at: Textual { file: t19_verification_schema_file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn t19_present_manual_anchor_key(key: T19ManualAnchorKey) -> Outcome<T19PresentManualAnchorKey> {
  match key {
    T19ManualAnchorAbsent =>
      Rejected { diagnostic: t19_manual_anchor_absent_assert_kind_diagnostic() }
    T19ManualTcConjEmpty => Produced { value: T19ManualTcConjEmpty }
    T19ManualTcDisjEmpty => Produced { value: T19ManualTcDisjEmpty }
    T19ManualTcArrowTwoConj => Produced { value: T19ManualTcArrowTwoConj }
    T19ManualTcCardinalityEmpty => Produced { value: T19ManualTcCardinalityEmpty }
    T19ManualTcInstantiationEmpty => Produced { value: T19ManualTcInstantiationEmpty }
    T19ManualTcConjEqualsRefl => Produced { value: T19ManualTcConjEqualsRefl }
    T19ManualNatAddLeftIdentity => Produced { value: T19ManualNatAddLeftIdentity }
    T19ManualNatAddRightIdentity => Produced { value: T19ManualNatAddRightIdentity }
    T19ManualNatAddAssociativity => Produced { value: T19ManualNatAddAssociativity }
    T19ManualNatMulLeftIdentity => Produced { value: T19ManualNatMulLeftIdentity }
    T19ManualNatMulAnnihilator => Produced { value: T19ManualNatMulAnnihilator }
    T19ManualNatMulAssociativity => Produced { value: T19ManualNatMulAssociativity }
  }
}


fn assert_kind_for_manual_anchor(key: T19PresentManualAnchorKey) -> Outcome<AssertKind> {
  match key {
    T19ManualTcConjEmpty => Produced { value: Compiles }
    T19ManualTcDisjEmpty => Produced { value: Compiles }
    T19ManualTcArrowTwoConj => Produced { value: Compiles }
    T19ManualTcCardinalityEmpty => Produced { value: Compiles }
    T19ManualTcInstantiationEmpty => Produced { value: Compiles }
    T19ManualTcConjEqualsRefl => Produced { value: Equals }
    T19ManualNatAddLeftIdentity => Produced { value: Compiles }
    T19ManualNatAddRightIdentity => Produced { value: Compiles }
    T19ManualNatAddAssociativity => Produced { value: Compiles }
    T19ManualNatMulLeftIdentity => Produced { value: Compiles }
    T19ManualNatMulAnnihilator => Produced { value: Compiles }
    T19ManualNatMulAssociativity => Produced { value: Equals }
  }
}
