// src/v4/std/verification.dag
// Scope: Closed TestClaim schema — AssertKind, TestgenTier/Layer, TestClassification, TestClaim fields.
// Owns: AssertKind TestgenTier TestgenLayer TestClassification TestClaim
// Consumes: v4.std.node { Node } v4.std.diagnostic { Outcome }
// Status: T-3 modeled; substrate extension or file split = operator STOP.

module v4.std.verification


import v4.std.node { Node }
import v4.std.diagnostic { Outcome }


type AssertKind
  = Equals
  | Diagnostic
  | Compiles
  | RoundTrips


type TestgenTier
  = Tier1
  | Tier2
  | Tier3


type TestgenLayer
  = Unit
  | Integration
  | Boundary


type TestClassification {
  tier: TestgenTier
  layer: TestgenLayer
}


type TestClaim {
  kind: AssertKind
  label: String
  input: Node
  expected: Outcome<Node>
  classification: TestClassification
}
