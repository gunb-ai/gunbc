// src/v4/std/verification.dag
// Scope: Closed TestClaim schema — AssertKind, TestgenTier/Layer, TestClassification, ImpossibleBugClass, T19ManualAnchorKey, TestClaim fields.
// Owns: AssertKind TestgenTier TestgenLayer TestClassification ImpossibleBugClass T19ManualAnchorKey TestClaim assert_kind_for_manual_anchor
// Consumes: v4.std.node { Node } v4.std.diagnostic { Outcome }
// Status: T-3 modeled; substrate extension or file split = operator STOP.

module v4.std.verification


import v4.std.node { Node }
import v4.std.diagnostic { Outcome }


type AssertKind
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = Equals
  | Diagnostic
  | Compiles
  | RoundTrips


type TestgenTier
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = Tier1
  | Tier2
  | Tier3


type TestgenLayer
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = Unit
  | Integration
  | Boundary


type TestClassification {
  tier: TestgenTier
  layer: TestgenLayer
}


type ImpossibleBugClass
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = SuboptimalComplexity
  | IdempotencyContract
  | TransportTypeDrift
  | NestedOptionalFlatten
  | UnenumeratedEffects
  | UnhandledDiagnosticPaths


type T19ManualAnchorKey
// 🟡 coproduct dissolution — DECISIONS.md LB-P4-3212
  = T19ManualTcConjEmpty
  | T19ManualTcDisjEmpty
  | T19ManualTcArrowTwoConj
  | T19ManualTcCardinalityEmpty
  | T19ManualTcInstantiationEmpty
  | T19ManualTcConjEqualsRefl
  | T19ManualNatAddLeftIdentity
  | T19ManualNatAddRightIdentity
  | T19ManualNatAddAssociativity
  | T19ManualNatMulLeftIdentity
  | T19ManualNatMulAnnihilator
  | T19ManualNatMulAssociativity
  | T19ManualAnchorAbsent


type TestClaim {
  kind: AssertKind
  label: String
  t19_anchor: T19ManualAnchorKey
  input: Node
  expected: Outcome<Node>
  classification: TestClassification
}


fn assert_kind_for_manual_anchor(key: T19ManualAnchorKey) -> AssertKind {
  match key {
    T19ManualTcConjEmpty => Compiles
    T19ManualTcDisjEmpty => Compiles
    T19ManualTcArrowTwoConj => Compiles
    T19ManualTcCardinalityEmpty => Compiles
    T19ManualTcInstantiationEmpty => Compiles
    T19ManualTcConjEqualsRefl => Equals
    T19ManualNatAddLeftIdentity => Compiles
    T19ManualNatAddRightIdentity => Compiles
    T19ManualNatAddAssociativity => Compiles
    T19ManualNatMulLeftIdentity => Compiles
    T19ManualNatMulAnnihilator => Compiles
    T19ManualNatMulAssociativity => Equals
    T19ManualAnchorAbsent => Compiles
  }
}
