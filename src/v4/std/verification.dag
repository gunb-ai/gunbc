// src/v4/std/verification.dag
// Scope: Closed TestClaim schema — AssertKind, TestgenTier/Layer, TestClassification, ImpossibleBugClass, T19ManualAnchorKey, T19PresentManualAnchorKey, TestClaim fields.
// Owns: AssertKind TestgenTier TestgenLayer TestClassification ImpossibleBugClass T19ManualAnchorKey T19PresentManualAnchorKey TestClaim
// Consumes: v4.std.node v4.std.diagnostic
// Status: T-3 modeled; substrate extension or file split = operator STOP.

module v4.std.verification


import v4.std.node { Node }
import v4.std.diagnostic {
  Outcome
}


type AssertKind
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = Equals
  | Diagnostic
  | Compiles
  | RoundTrips


type TestgenTier
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = Tier1
  | Tier2
  | Tier3


type TestgenLayer
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = Unit
  | Integration
  | Boundary


type TestClassification {
  tier: TestgenTier
  layer: TestgenLayer
}


type ImpossibleBugClass
// 🟢 coproduct dissolution — DECISIONS.md LB-P4-3212
  = SuboptimalComplexity
  | IdempotencyContract
  | TransportTypeDrift
  | NestedOptionalFlatten
  | UnenumeratedEffects
  | UnhandledDiagnosticPaths


type T19ManualAnchorKey
// 🟡 coproduct dissolution — DECISIONS.md LB-P4-3212
// RULING-1: DONE — Wave-0 manual-anchor key sum + absent sentinel; receipt: v3 `v4_lens_testgen_dag_smoke_test.rs` (SG-0 P5 / PR #3332).
  = T19ManualTcConjEmpty
  | T19ManualTcDisjEmpty
  | T19ManualTcArrowTwoConj
  | T19ManualTcCardinalityEmpty
  | T19ManualTcInstantiationEmpty
  | T19ManualTcConjEqualsRefl
  | T19ManualNatAddLeftIdentity
  | T19ManualNatAddRightIdentity
  | T19ManualNatAddAssociativity
  | T19ManualNatMulLeftIdentity
  | T19ManualNatMulAnnihilator
  | T19ManualNatMulAssociativity
  | T19ManualAnchorAbsent


type T19PresentManualAnchorKey
// 🟡 coproduct dissolution — DECISIONS.md LB-P4-3212
// RULING-1: WIP — present-only mirror pending M2 manifest fold per DECISIONS LB-P4-3212; receipt: same v3 smoke + INVARIANTS P5 row.
  = T19PresentManualTcConjEmpty
  | T19PresentManualTcDisjEmpty
  | T19PresentManualTcArrowTwoConj
  | T19PresentManualTcCardinalityEmpty
  | T19PresentManualTcInstantiationEmpty
  | T19PresentManualTcConjEqualsRefl
  | T19PresentManualNatAddLeftIdentity
  | T19PresentManualNatAddRightIdentity
  | T19PresentManualNatAddAssociativity
  | T19PresentManualNatMulLeftIdentity
  | T19PresentManualNatMulAnnihilator
  | T19PresentManualNatMulAssociativity


type TestClaim {
  kind: AssertKind
  label: String
  t19_anchor: T19ManualAnchorKey
  input: Node
