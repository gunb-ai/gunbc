module v4.std.projection

import v4.std.artifact { ArtifactKind }
import v4.std.node { Node, Symbol }

// 🟢 coproduct dissolution
type ProjectionKind
  = TestClaimLens
  | BoundaryTestLens
  | TargetTestProjection
  | EmitProjection
  | DiagnosticProjection

type Projection {
  id: Symbol
  kind: ProjectionKind
  input: Node
  output_kind: ArtifactKind
}
