// src/v4/std/type_expr_projection_discipline_zip_fold_predicate.dag
// Scope: SG-2 fold — discipline-aware zip-fold over row envelope + child slots.
// Anchor: connective_edges_conform (node.dag); type_expr_projection row child-slot schema.
// Status: one uniform predicate — positional=by-index, labeled=by-name; no per-connective arms.


module v4.std.type_expr_projection_discipline_zip_fold_predicate

import v4.std.algebra { Cons, Empty, length, list_snoc_item }
import v4.std.collection { List, Optional, Absent, Present }
import v4.std.node {
  Atom,
  Edge,
  EdgeDiscipline,
  LabeledEdges,
  Named,
  NoEdges,
  Node,
  Positional,
  PositionalEdges,
  Symbol,
  TypeNode,
  edges_conform,
  well_formed
}
import v4.std.type_expr_projection_row_schema {
  target_type_expr_discipline_labeled,
  target_type_expr_discipline_no_edges,
  target_type_expr_discipline_positional,
  target_type_expr_field_child_slot_discipline,
  target_type_expr_field_child_slots
}
import v4.std.node_query { find_named_child }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.exact_structural_equality_zip_fold_predicate {
  exact_structural_equality_zip_fold
}

fn type_expr_projection_discipline_from_atom(id: Symbol) -> Optional<EdgeDiscipline> {
  if id == target_type_expr_discipline_no_edges {
    Present { value: NoEdges }
  } else if id == target_type_expr_discipline_labeled {
    Present { value: LabeledEdges }
  } else if id == target_type_expr_discipline_positional {
    Present { value: PositionalEdges }
  } else {
    Absent
  }
}

fn type_expr_projection_child_slot_discipline_from_envelope(node: Node) -> Optional<EdgeDiscipline> {
  match find_named_child(
    root: node,
    name: target_type_expr_field_child_slot_discipline
  ) {
    Accepted { value: discipline_node, diagnostics: _ } =>
      match discipline_node.kind {
        TypeNode { connective: Atom { identity: id } } =>
          type_expr_projection_discipline_from_atom(id: id)
        _ => Absent
      }
    Rejected { diagnostics: _ } => Absent
  }
}

fn type_expr_projection_child_slot_edges_from_graft(node: Node) -> List<Edge> {
  match find_named_child(
    root: node,
    name: target_type_expr_field_child_slots
  ) {
    Accepted { value: facts, diagnostics: _ } => facts.children
    Rejected { diagnostics: _ } => Empty
  }
}

fn type_expr_projection_child_slots_well_formed_if_present(node: Node) -> Bool {
  match find_named_child(
    root: node,
    name: target_type_expr_field_child_slots
  ) {
    Accepted { value: facts, diagnostics: _ } => well_formed(n: facts)
    Rejected { diagnostics: _ } => true
  }
}

fn type_expr_projection_edge_is_child_slots_coordinate(e: Edge) -> Bool {
  match e.label {
    Named { name: n } => n == target_type_expr_field_child_slots
    Positional => false
  }
}

fn type_expr_projection_peel_child_slots_envelope_go(
  xs: List<Edge>,
  acc: List<Edge>,
  saw_child_slots: Bool
) -> Optional<List<Edge>> {
  match xs {
    Empty => Present { value: acc }
    Cons { head: h, tail: t } =>
      if type_expr_projection_edge_is_child_slots_coordinate(e: h) {
        if saw_child_slots {
          Absent
        } else {
          type_expr_projection_peel_child_slots_envelope_go(
            xs: t,
            acc: acc,
            saw_child_slots: true
          )
        }
      } else {
        type_expr_projection_peel_child_slots_envelope_go(
          xs: t,
          acc: list_snoc_item(xs: acc, item: h),
          saw_child_slots: saw_child_slots
        )
      }
  }
}

fn type_expr_projection_peel_child_slots_envelope(children: List<Edge>) -> Optional<List<Edge>> {
  type_expr_projection_peel_child_slots_envelope_go(
    xs: children,
    acc: Empty,
    saw_child_slots: false
  )
}

fn type_expr_projection_edge_equal(left: Edge, right: Edge) -> Bool {
  (left.label == right.label)
    && exact_structural_equality_zip_fold(
      source_facts: left.target,
      candidate: right.target
    )
}

fn type_expr_projection_edges_exact_equal(
  left: List<Edge>,
  right: List<Edge>
) -> Bool {
  (length(xs: left) == length(xs: right))
    && type_expr_projection_edges_prefix_equal(prefix: left, full: right)
}

fn type_expr_projection_edges_prefix_equal(
  prefix: List<Edge>,
  full: List<Edge>
) -> Bool {
  match prefix {
    Empty => true
    Cons { head: ph, tail: pt } =>
      match full {
        Cons { head: fh, tail: ft } =>
          type_expr_projection_edge_equal(left: ph, right: fh)
            && type_expr_projection_edges_prefix_equal(prefix: pt, full: ft)
        Empty => false
      }
  }
}

fn type_expr_projection_row_envelope_exact_equal(
  candidate: Node,
  source_facts: Node
) -> Bool {
  match type_expr_projection_peel_child_slots_envelope(children: source_facts.children) {
    Present { value: envelope } =>
      type_expr_projection_edges_exact_equal(
        left: candidate.children,
        right: envelope
      )
    Absent => false
  }
}

fn type_expr_projection_discipline_zip_fold_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  match type_expr_projection_child_slot_discipline_from_envelope(node: candidate) {
    Present { value: discipline } =>
      let child_slots = type_expr_projection_child_slot_edges_from_graft(node: source_facts)
      well_formed(n: source_facts)
        && well_formed(n: candidate)
        && well_formed(n: algebra)
        && type_expr_projection_child_slots_well_formed_if_present(node: source_facts)
        && (algebra == source_facts)
        && type_expr_projection_row_envelope_exact_equal(
          candidate: candidate,
          source_facts: source_facts
        )
        && edges_conform(children: child_slots, d: discipline)
    Absent => false
  }
}
