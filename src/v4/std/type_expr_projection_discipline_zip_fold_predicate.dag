// src/v4/std/type_expr_projection_discipline_zip_fold_predicate.dag
// Scope: SG-2 fold — discipline-aware zip-fold over row envelope + child slots.
// Anchor: connective_edges_conform (node.dag); type_expr_projection row child-slot schema.
// Status: one uniform predicate — positional=by-index, labeled=by-name; no per-connective arms.


module v4.std.type_expr_projection_discipline_zip_fold_predicate

import v4.std.algebra { Cons, Empty, is_empty, length }
import v4.std.node {
  Atom,
  Edge,
  EdgeDiscipline,
  LabeledEdges,
  Named,
  NoEdges,
  Node,
  Positional,
  PositionalEdges,
  Symbol,
  TypeNode,
  edges_conform,
  well_formed
}
import v4.std.target_model {
  target_type_expr_discipline_labeled,
  target_type_expr_discipline_no_edges,
  target_type_expr_discipline_positional,
  target_type_expr_field_child_slot_discipline
}
import v4.std.node_query { find_named_child }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.exact_structural_equality_zip_fold_predicate {
  exact_structural_equality_zip_fold
}

fn type_expr_projection_discipline_from_atom(id: Symbol) -> EdgeDiscipline {
  if id == target_type_expr_discipline_no_edges {
    NoEdges
  } else if id == target_type_expr_discipline_labeled {
    LabeledEdges
  } else if id == target_type_expr_discipline_positional {
    PositionalEdges
  } else {
    NoEdges
  }
}

fn type_expr_projection_child_slot_discipline_from_envelope(node: Node) -> EdgeDiscipline {
  match find_named_child(
    root: node,
    name: target_type_expr_field_child_slot_discipline
  ) {
    Accepted { value: discipline_node, diagnostics: _ } =>
      match discipline_node.kind {
        TypeNode { connective: Atom { identity: id } } =>
          type_expr_projection_discipline_from_atom(id: id)
        _ => NoEdges
      }
    Rejected { diagnostics: _ } => NoEdges
  }
}

fn type_expr_projection_edge_equal(left: Edge, right: Edge) -> Bool {
  (left.label == right.label)
    && exact_structural_equality_zip_fold(
      source_facts: left.target,
      candidate: right.target
    )
}

fn type_expr_projection_edges_prefix_equal(
  prefix: List<Edge>,
  full: List<Edge>
) -> Bool {
  match prefix {
    Empty => true
    Cons { head: ph, tail: pt } =>
      match full {
        Cons { head: fh, tail: ft } =>
          type_expr_projection_edge_equal(left: ph, right: fh)
            && type_expr_projection_edges_prefix_equal(prefix: pt, full: ft)
        Empty => false
      }
  }
}

fn type_expr_projection_skip_edges(xs: List<Edge>, count: Int) -> List<Edge> {
  if count <= 0 {
    xs
  } else {
    match xs {
      Empty => Empty
      Cons { head: _, tail: t } =>
        type_expr_projection_skip_edges(xs: t, count: count - 1)
    }
  }
}

fn type_expr_projection_discipline_zip_fold_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  let discipline = type_expr_projection_child_slot_discipline_from_envelope(node: candidate)
  let envelope_count = length(xs: candidate.children)
  let child_slots = type_expr_projection_child_slot_suffix(
    full: source_facts.children,
    envelope_count: envelope_count
  )
  well_formed(n: source_facts)
    && well_formed(n: candidate)
    && well_formed(n: algebra)
    && (algebra == source_facts)
    && type_expr_projection_edges_prefix_equal(
      prefix: candidate.children,
      full: source_facts.children
    )
    && edges_conform(children: child_slots, d: discipline)
}
