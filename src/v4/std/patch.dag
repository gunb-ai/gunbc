// src/v4/std/patch.dag
// Scope: field-level overlay patch substrate — per-field Override/Inherit coproduct for hierarchical config layering.
// Consumes: v4.std.algebra { Magma, Semigroup, Monoid }.
// Status: T-4.16 follow-on — FieldPatch monoid + ConfigPatchRecord projection landed.
// Anchor: https://en.wikipedia.org/wiki/Monoid

module v4.std.patch

import v4.std.algebra { Magma, Semigroup, Monoid }

// 🟢 config-patch-record-projection — record-field map: Config field `name: T` → patch field `name: FieldPatch<T>`.
// Consumers: `type *ConfigPatch = ConfigPatchRecord<*Config>`; `fn *_layer(...) = config_patch_layer(...)`.
// PrettierOverrideOptions remains a hand extension (extra `parser` field beyond PrettierFormattingOptions).
type ConfigPatchRecord<Config>

// Per-field `apply_field_patch` fold over `Config`; expanded at call sites from the Config record shape.
// Surface stub — must be intercepted by v3 lowerer (`try_lower_config_patch_layer_invocation`).
// Body returns `base` only for parse/type-check; if lowering misses, patch is silently dropped.
fn config_patch_layer<Config>(base: Config, patch: ConfigPatchRecord<Config>) -> Config {
  base
}

// 🟢 coproduct dissolution — CP-T416-FPATCH-TERMINAL.
// FieldPatch<T> = 1 + T: Inherit = absent/identity, Override = present payload.
type FieldPatch<T>
  = Override { value: T }
  | Inherit


fn field_patch_inherit<T>() -> FieldPatch<T> {
  Inherit
}


fn apply_field_patch<T>(base: T, patch: FieldPatch<T>) -> T {
  match patch {
    Override { value: v } => v
    Inherit => base
  }
}


fn compose_field_patch<T>(left: FieldPatch<T>, right: FieldPatch<T>) -> FieldPatch<T> {
  match right {
    Override { value: v } => Override { value: v }
    Inherit => left
  }
}


fn field_patch_monoid<T>() -> Monoid<FieldPatch<T>> {
  Monoid {
    semigroup: Semigroup {
      magma: Magma {
        op: fn(left, right) { compose_field_patch(left: left, right: right) }
      }
    },
    identity: Inherit,
  }
}
