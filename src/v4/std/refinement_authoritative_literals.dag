// src/v4/std/refinement_authoritative_literals.dag
// Scope: upstream formatter default literals — discharged via make_* at authoritative locus.
// Status: T-25-core formatter dissolution; tied to refinement_formatter_literals_accept.dag.


module v4.std.refinement_authoritative_literals


import v4.std.diagnostic { Accepted, NonEmptyDiagnostics, Outcome, Rejected }
import v4.std.refinement {
  AtLeastMinusOneInt,
  AtLeastMinusTwoInt,
  ExactOneInt,
  NonNegativeInt,
  PositiveInt,
  at_least_minus_one_int_authoritative_literal,
  at_least_minus_two_int_authoritative_literal,
  exact_one_int_authoritative_literal,
  non_negative_int_authoritative_literal,
  positive_int_authoritative_literal
}


// Catalog-row discharge is module-local (not std/refinement.dag). Accepted arm unwraps the
// carrier; Rejected arm is ill-typed (returns Outcome) so a mistyped catalog literal fails
// compile-time rather than fabricating a carrier or diverging (P3/P4).
// Per-literal Accepted witnesses: refinement_formatter_literals_accept.dag.
// 🟡 gated — feature:refinement-authoritative-literal-discharge — bind T-25-tail

fn discharge_positive_int_catalog_row(receipt: Outcome<PositiveInt>) -> PositiveInt {
  match receipt {
    Accepted { value: carrier, diagnostics: _ } => carrier
    Rejected { diagnostics } => positive_int_catalog_row_substrate_fault(diagnostics: diagnostics)
  }
}


fn positive_int_catalog_row_substrate_fault(diagnostics: NonEmptyDiagnostics) -> PositiveInt {
  positive_int_catalog_row_substrate_fault_outcome(diagnostics: diagnostics)
}


fn positive_int_catalog_row_substrate_fault_outcome(diagnostics: NonEmptyDiagnostics) -> Outcome<PositiveInt> {
  Rejected { diagnostics: diagnostics }
}


fn discharge_non_negative_int_catalog_row(receipt: Outcome<NonNegativeInt>) -> NonNegativeInt {
  match receipt {
    Accepted { value: carrier, diagnostics: _ } => carrier
    Rejected { diagnostics } => non_negative_int_catalog_row_substrate_fault(diagnostics: diagnostics)
  }
}


fn non_negative_int_catalog_row_substrate_fault(diagnostics: NonEmptyDiagnostics) -> NonNegativeInt {
  non_negative_int_catalog_row_substrate_fault_outcome(diagnostics: diagnostics)
}


fn non_negative_int_catalog_row_substrate_fault_outcome(
  diagnostics: NonEmptyDiagnostics,
) -> Outcome<NonNegativeInt> {
  Rejected { diagnostics: diagnostics }
}


fn discharge_at_least_minus_one_int_catalog_row(
  receipt: Outcome<AtLeastMinusOneInt>,
) -> AtLeastMinusOneInt {
  match receipt {
    Accepted { value: carrier, diagnostics: _ } => carrier
    Rejected { diagnostics } =>
      at_least_minus_one_int_catalog_row_substrate_fault(diagnostics: diagnostics)
  }
}


fn at_least_minus_one_int_catalog_row_substrate_fault(
  diagnostics: NonEmptyDiagnostics,
) -> AtLeastMinusOneInt {
  at_least_minus_one_int_catalog_row_substrate_fault_outcome(diagnostics: diagnostics)
}


fn at_least_minus_one_int_catalog_row_substrate_fault_outcome(
  diagnostics: NonEmptyDiagnostics,
) -> Outcome<AtLeastMinusOneInt> {
  Rejected { diagnostics: diagnostics }
}


fn discharge_at_least_minus_two_int_catalog_row(
  receipt: Outcome<AtLeastMinusTwoInt>,
) -> AtLeastMinusTwoInt {
  match receipt {
    Accepted { value: carrier, diagnostics: _ } => carrier
    Rejected { diagnostics } =>
      at_least_minus_two_int_catalog_row_substrate_fault(diagnostics: diagnostics)
  }
}


fn at_least_minus_two_int_catalog_row_substrate_fault(
  diagnostics: NonEmptyDiagnostics,
) -> AtLeastMinusTwoInt {
  at_least_minus_two_int_catalog_row_substrate_fault_outcome(diagnostics: diagnostics)
}


fn at_least_minus_two_int_catalog_row_substrate_fault_outcome(
  diagnostics: NonEmptyDiagnostics,
) -> Outcome<AtLeastMinusTwoInt> {
  Rejected { diagnostics: diagnostics }
}


fn discharge_exact_one_int_catalog_row(receipt: Outcome<ExactOneInt>) -> ExactOneInt {
  match receipt {
    Accepted { value: carrier, diagnostics: _ } => carrier
    Rejected { diagnostics } => exact_one_int_catalog_row_substrate_fault(diagnostics: diagnostics)
  }
}


fn exact_one_int_catalog_row_substrate_fault(diagnostics: NonEmptyDiagnostics) -> ExactOneInt {
  exact_one_int_catalog_row_substrate_fault_outcome(diagnostics: diagnostics)
}


fn exact_one_int_catalog_row_substrate_fault_outcome(diagnostics: NonEmptyDiagnostics) -> Outcome<ExactOneInt> {
  Rejected { diagnostics: diagnostics }
}
