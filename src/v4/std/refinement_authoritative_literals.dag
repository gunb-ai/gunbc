// src/v4/std/refinement_authoritative_literals.dag
// Scope: formatter upstream default literal discharge — module-local Outcome unwrap.
// Status: T-25-core formatter dissolution; tied to refinement_formatter_literals_accept.dag.


module v4.std.refinement_authoritative_literals


import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.refinement {
  AtLeastMinusOneInt,
  AtLeastMinusTwoInt,
  ExactOneInt,
  NonNegativeInt,
  PositiveInt,
  at_least_minus_one_int_authoritative_literal,
  at_least_minus_two_int_authoritative_literal,
  exact_one_int_authoritative_literal,
  non_negative_int_authoritative_literal,
  positive_int_authoritative_literal
}


// Catalog discharge (not exported from std/refinement.dag): exhaustive Outcome match with
// bounded Rejected re-attempts (fuel decreases each step — P4). Call sites pass the same Int
// literal as catalog_value so discharge cannot be applied to an unrelated Outcome receipt.
// Accepted per catalog value: refinement_formatter_literals_accept.dag.
// 🟡 gated — feature:refinement-authoritative-literal-discharge — bind T-25-tail

fn discharge_positive_int_catalog_row(receipt: Outcome<PositiveInt>, catalog_value: Int) -> PositiveInt {
  discharge_positive_int_catalog_row_step(receipt: receipt, catalog_value: catalog_value, fuel: 8)
}


fn discharge_positive_int_catalog_row_step(
  receipt: Outcome<PositiveInt>,
  catalog_value: Int,
  fuel: Int,
) -> PositiveInt {
  match receipt {
    Accepted { value: carrier, diagnostics: _ } => carrier
    Rejected { diagnostics } =>
      if fuel <= 0 {
        positive_int_catalog_row_substrate_fault(catalog_value: catalog_value, fuel: fuel - 1)
      } else {
        discharge_positive_int_catalog_row_step(
          receipt: positive_int_authoritative_literal(value: catalog_value),
          catalog_value: catalog_value,
          fuel: fuel - 1
        )
      }
  }
}


fn positive_int_catalog_row_substrate_fault(catalog_value: Int, fuel: Int) -> PositiveInt {
  if fuel <= 0 {
    positive_int_catalog_row_substrate_fault(catalog_value: catalog_value, fuel: fuel - 1)
  } else {
    discharge_positive_int_catalog_row(
      receipt: positive_int_authoritative_literal(value: catalog_value),
      catalog_value: catalog_value
    )
  }
}


