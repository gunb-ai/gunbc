// src/v4/std/refinement_authoritative_literals.dag
// Scope: upstream formatter default literals — per-catalog data discharge at authoritative locus.
// Status: T-25-core formatter dissolution; tied to refinement_formatter_literals_accept.dag.


module v4.std.refinement_authoritative_literals


import v4.std.refinement {
  PositiveInt,
  NonNegativeInt,
  AtLeastMinusOneInt,
  AtLeastMinusTwoInt,
  ExactOneInt,
  make_at_least_minus_one_int_at_authoritative,
  make_at_least_minus_two_int_at_authoritative,
