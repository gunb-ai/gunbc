import v4.std.diagnostic { Accepted, Rejected }


// Per-catalog `data` rows (fixed value: N). Rejected arms call nullary catalog_fault helpers that
// re-run make_* for the same constant (both arms unify as the nominal carrier). Catalog values
// are witnessed accepted in refinement_formatter_literals_accept.dag; persistent reject is a
// substrate authoring fault (no Outcome-as-carrier, no Int->Carrier totalizer).
// 🟡 gated — feature:refinement-authoritative-literal-discharge — bind T-25-tail

fn authoritative_at_least_minus_one_int_minus_1_catalog_fault() -> AtLeastMinusOneInt {
  match make_at_least_minus_one_int_at_authoritative(value: -1) {
    Accepted { value: carrier, diagnostics: _ } => carrier
    Rejected { diagnostics: _ } => authoritative_at_least_minus_one_int_minus_1_catalog_fault()
  }
}

