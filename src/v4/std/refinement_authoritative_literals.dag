// src/v4/std/refinement_authoritative_literals.dag
// Scope: upstream formatter default literals — discharged via make_* at authoritative locus.
// Status: T-25-core formatter dissolution; tied to refinement_formatter_literals_accept.dag.


module v4.std.refinement_authoritative_literals


import v4.std.diagnostic { Accepted, Outcome, Rejected }
import v4.std.refinement {
  AtLeastMinusOneInt,
  AtLeastMinusTwoInt,
  ExactOneInt,
  NonNegativeInt,
  PositiveInt,
  at_least_minus_one_int_authoritative_literal,
  at_least_minus_two_int_authoritative_literal,
  exact_one_int_authoritative_literal,
  non_negative_int_authoritative_literal,
  positive_int_authoritative_literal
}


// Catalog-row discharge lives in this module only (not std/refinement.dag): exhaustive Outcome
// match with bounded Rejected re-propagation; no fabricated carrier on failure (P3/P4).
// Accepted-only rows witnessed per literal in refinement_formatter_literals_accept.dag.
// 🟡 gated — feature:refinement-authoritative-literal-discharge — bind T-25-tail

fn discharge_positive_int_catalog_row(receipt: Outcome<PositiveInt>) -> PositiveInt {
  discharge_positive_int_catalog_row_step(receipt: receipt, steps_remaining: 256)
}


fn discharge_positive_int_catalog_row_step(receipt: Outcome<PositiveInt>, steps_remaining: Int) -> PositiveInt {
  match receipt {
    Accepted { value: carrier, diagnostics: _ } => carrier
    Rejected { diagnostics } =>
      discharge_positive_int_catalog_row_step(
        receipt: Rejected { diagnostics: diagnostics },
        steps_remaining: steps_remaining - 1
      )
  }
}


fn discharge_non_negative_int_catalog_row(receipt: Outcome<NonNegativeInt>) -> NonNegativeInt {
  discharge_non_negative_int_catalog_row_step(receipt: receipt, steps_remaining: 256)
}


fn discharge_non_negative_int_catalog_row_step(
  receipt: Outcome<NonNegativeInt>,
  steps_remaining: Int,
) -> NonNegativeInt {
  match receipt {
    Accepted { value: carrier, diagnostics: _ } => carrier
    Rejected { diagnostics } =>
      discharge_non_negative_int_catalog_row_step(
        receipt: Rejected { diagnostics: diagnostics },
        steps_remaining: steps_remaining - 1
      )
  }
}


fn discharge_at_least_minus_one_int_catalog_row(
  receipt: Outcome<AtLeastMinusOneInt>,
) -> AtLeastMinusOneInt {
  discharge_at_least_minus_one_int_catalog_row_step(receipt: receipt, steps_remaining: 256)
}


