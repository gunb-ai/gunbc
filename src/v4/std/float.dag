// src/v4/std/float.dag
//
// Scope: IEEE-754 binary floating-point — the `Float` scalar. Separate
//        from integer because its arithmetic is APPROXIMATE: rounding
//        breaks associativity / distributivity and NaN breaks reflexive
//        equality, so Float inhabits a weakened algebra rather than an
//        exact `Field`. It is NOT opaque — it is a fully grounded,
//        decomposable concept (bit-record structure + a rounding-aware
//        algebra), consistent with epistemic stacking ("no concept is
//        opaque"); only its *algebra* is weaker than exact arithmetic.
// Anchor: https://en.wikipedia.org/wiki/IEEE_754
//
// Owns:
//   - Float — IEEE-754 binary floating-point (Float32 / Float64). Its
//     STRUCTURE decomposes: a sign / exponent / mantissa bit-record over
//     std/machine.dag, with the non-finite values (NaN, ±Inf, signed
//     zero) modeled as explicit structure. Every part is reachable —
//     nothing opaque.
//   - inhabitance: Float is **typed** to inhabit the rounding-aware
//     `ApproximateField` structure owned by std/algebra.dag (ontology +
//     TASKS.md T-3), **not** an exact `Field` (rounding is non-associative).
//     The std/extdeps typescript.dag header already anticipates this shape;
//     algebra.dag (T-2) owns its exact name and definition. The **machine-
//     readable** `data … ApproximateField<Float>` witness is **deferred**
//     here (see modeling notes "APPROXIMATEFIELD INHABITANCE"); dissolution is
//     grounded `add`/`mul` over interchange + U1 — not silent fabrication in
//     `.dag`. Float's external anchor remains IEEE-754 (the Wikipedia link).
//   - Tier-2 totalization for the partial / non-total operations
//     (NaN-producing ops; ordering in the presence of NaN) — STRUCTURE.md
//     commitment #2
//
// Consumes:
//   - std/node.dag: Conj / Disj shapes; `Symbol` for diagnostic identity
//     wiring (Tier-2 `Rejected` — no Symbol mint here)
//   - std/machine.dag: bit-width interchange authorities (`Bit`, `Word32` /
//     `Word64`) for `Float*` nominal widths
//   - std/algebra.dag: `Ordering` + `ApproximateField` ontology (typed
//     inhabitance target; machine-readable witness still deferred in-file)
//   - std/diagnostic.dag: `Outcome` / `Diagnostic` / `PortLocus` — Tier-2
//     fail-closed compare API (NaN / unavailable inputs)
//   - std/logic.dag: `Bool` (finite sign bit and other carrier-local uses)
//   - std/nat.dag: `Nat` for Peano exponent / significand fields on
//     `FloatBody.Finite` (carrier-local `nat_compare` only; no duplicate
//     numeric authority vs interchange + Grounding)
//
// D2b (operator-ratified 2026-05-16; see DECISIONS.md D2) — Float's
//   algebra inhabitance is NOT constructive the way the integer chain is
//   (there, Peano `Nat` → GroupCompletion → … fills `Int`'s operation
//   `Arrow` bodies with sub-DAGs of L1 behaviors). IEEE-754 round-to-
//   nearest arithmetic is a genuine SPEC PRIMITIVE — irreducible, an
//   open-system fact gunbc consumes (the open-system case INVARIANTS P1
//   explicitly names; not a heuristic).
//   A primitive operation uses the SAME single external-primitive path
//   THESIS:203 already defines — NOT a new one. A primitive op is an
//   `Arrow` reached canonically via `Transform → FunctionRef → Arrow`;
//   the `Arrow`'s `body` is *a realization declaration in `extdeps/`*
//   (THESIS:203's primitive case — contrast the L1-sub-DAG body of a
//   constructive op). The `ApproximateField` inhabitance declared HERE
//   holds `FunctionRef`s to the op `Arrow` signatures; the realizations
//   — anchored to the exact IEEE-754 § — are the per-target
//   `extdeps/languages/*` resolvers (the D2.2 resolver). This file does
//   NOT home a separate `Symbol`+`Anchor` primitive carrier referenced
//   directly by the inhabitance — that would be the second external-
//   primitive path P2 forbids. The `Arrow` HAS a body (the `extdeps/`
//   realization), so it is not a bodiless `fn` (PARSE-1 untriggered),
//   and it is NOT a kernel/A1 extension (no new connective or behavior).
//   A language `extdeps` file alias-identifies its `f32` / `f64` to
//   `Float32` / `Float64` here, supplies those `Arrow`-body realizations,
//   and adds its own operation-semantics siblings (NaN/Inf handling); it
//   does NOT re-declare the `ApproximateField` inhabitance.
//
// Status: scaffold — fill per TASKS.md T-3 (scalar/numeric stack). Replaces
//   part of the deleted std/primitive.dag; see src/v4/STRUCTURE.md
//   §"scalar/numeric concept decomposition".
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.std.float


import v4.std.algebra { Ordering, Less, Equal, Greater }
import v4.std.diagnostic {
  Diagnostic,
  Outcome,
  PortLocus,
  Produced,
  Rejected,
  Unavailable,
  UserInputBoundary,
}
import v4.std.logic { Bool }
import v4.std.machine { Bit, Word32, Word64 }
import v4.std.nat { Nat }
import v4.std.node { Symbol }


// ─────────────────────────────────────────────────────────────────────
// Modeling notes (read before validating against the anchor)
//
// WIDTH NOMINALS — `Float32` / `Float64` are distinct nominal wrappers
// around ONE shared semantic carrier `FloatBody` (IEEE-754 *semantic*
// classification: finite sign + biased exponent + trailing significand
// as Peano `Nat`, vs non-finite tags). Binary32/binary64 **bit layout**
// (interchange formats) remain the authority of `Word32` / `Word64` in
// std/machine.dag — Grounding maps `Float*` ↔ interchange words; this
// file does not duplicate width-correct bit lists (same 🟡 list-length
// scaffold class as machine.dag's `Word*` fields).
//
// P2 NOMINAL WRAPPERS — `Float32` / `Float64` add **no** fields beyond
// `body: FloatBody` and therefore attach **no** structural witness tying
// `Finite.biased_exponent` / `Finite.trailing_significand` to binary32
// (8+23) vs binary64 (11+52) bit counts. A `Float32` value whose `body` is
// `Finite { … }` with exponent/significand magnitudes that could not decode
// from any `Word32` interchange pattern is **still representable** here —
// that hole is the same honest deferral class as **std/machine.dag**'s
// `Word*` / `Byte` list-length vs nominal-width **"LIST FIELD LENGTH vs
// NOMINAL WIDTH — TRACKED SCAFFOLD (🟡)"** block (single P2 authority for
// interchange bit-vectors: `Word32` / `Word64`, not a shadow width engine
// re-authored inside float.dag). Producer-side discipline + bounded
// refinement / dissolution named there close the gap.
//
// NAT FIELDS — `biased_exponent` / `trailing_significand` are honest
// unrefined `Nat` carriers: nominal IEEE field *widths* (8+23 binary32,
// 11+52 binary64) are NOT type-enforced here — the same honest deferral
// pattern as machine.dag's `List<Bit>` width scaffold. Producers must
// respect nominal widths; the dissolution trigger is the same bounded
// refinement substrate named in machine.dag's modeling notes.
//
// APPROXIMATEFIELD INHABITANCE — machine-readable `data … ApproximateField<Float>`
// is **deferred** (tracked scaffold 🟡; INVARIANTS P1/P2 + T-3 operator track):
// wiring `ApproximateField.add` / `mul` to any in-.dag combine on unrefined
// `Nat` exponent/significand fields would either fabricate IEEE float facts or
// install a **second operation authority** beside interchange + Grounding/U1.
// Dissolution = grounded `add`/`mul` realized over `Float32Interchange` /
// `Float64Interchange` (machine.dag `Word*`) on the homomorphism spine.
//
// Until then: **Tier-2** `float_ordered_compare_tier2` carries IEEE **numeric**
// ordered comparison via `float_body_compare_ieee_ordered_outcome` on
// `Float.body` (`±0` magnitude with both `Nat` fields at Peano `Zero` ⇒ `Equal`
// in the `Produced` branch — IEEE numeric equality). For non-finite values, **NaN sign/payload are not modeled**
// on `FloatBody` (`FloatSpecial` is class-only); a separate deterministic
// total compare on the carrier — `float_body_compare_semantic_total` — is used
// only as a **scaffold** order over modeled facts, **not** full interchange-
// grounded IEEE 754 `totalOrder` (P1 faithfulness). Still NOT a packaged
// `ApproximateField` witness.
//
// SYMBOL ANCHORS (P2 / diagnostic.dag) — Tier-2 `Rejected` paths take **two**
// caller-supplied opaque `Symbol`s (K-1: no Symbol mint in this file):
// `failure_reason` binds `Diagnostic.reason` (dimension-owned failure
// identity); `failure_at_port` binds `PortLocus.port` (**where** — a separate
// boundary fact from `reason`, per diagnostic.dag header `reason` vs `at`).
// Fusing both into one symbol regresses Practices 3/5 + INVARIANTS P2; callers
// wire two declaration-site identities (they may coincide only upstream by
// explicit dimension policy — this API does not collapse them here).
//
// INTERCHANGE TYPE ALIASES — machine-readable consumption of machine.dag's
// interchange authorities for Grounding edges (P2 single place for words).
//
// IMPORT CLOSURE — `float.dag` imports `v4.std.diagnostic`, `nat`, `logic`,
// `machine`, `node`, `algebra` only as **declared** std carriers. On the merge
// base (`main`), those modules are **fully modeled** substrate (e.g.
// `diagnostic.dag` owns `Outcome`/`Diagnostic`/`PortLocus` — not a header stub);
// float does not advance ahead of ghost dependencies or duplicate their authority
// (INVARIANTS P1/P2).
type Float32Interchange = Word32
type Float64Interchange = Word64


// ─────────────────────────────────────────────────────────────────────
// FloatSpecial — the closed non-finite discriminant (quiet / signaling
// NaN; ±∞). Anchor: IEEE 754 non-finite classes.
//
// Coproduct dissolution (Practice 4 / INVARIANTS P1 / modeling-
// discipline.md §4) — classification: 🟢 GREEN (terminal). Ledger —
// five patterns attempted:
//   1. Fact placement — FAILS: every float classifier matches these tags
//      uniformly; not a per-consumer scattered fact.
//   2. Variant-is-data — FAILS: four nullary variants — no `{kind,…}`
//      fold without inventing a readable label space (M4).
//   3. Algebraic form — N/A: exceptional-value classification is not an
//      algebra carrier in std/.
//   4. Dimensional — FAILS: a non-finite value is EXACTLY ONE of these
//      alternatives — not simultaneous coordinates.
//   5. Parameterized family — FAILS: the four variants are not one generic
//      `F<X>` / projection over a separately-declared source set (Practice 7).
// Terminal: the irreducible IEEE non-finite partition at semantic float scope.
type FloatSpecial
  = QuietNan
  | SignalingNan
  | PosInfinity
  | NegInfinity


// ─────────────────────────────────────────────────────────────────────
// FloatBody — finite IEEE semantic record vs non-finite tagged class.
//
// Coproduct dissolution (Practice 4 / INVARIANTS P1 / modeling-
// discipline.md §4) — classification: 🟢 GREEN (terminal). Ledger —
// five patterns attempted:
//   1. Fact placement — FAILS: every float consumer folds finite vs
//      non-finite; shared substrate fact, not per-site.
//   2. Variant-is-data — FAILS: `Finite` carries a Conj; `NonFinite` a tag;
//      a flat `{kind,…}` record admits illegal mutual states (P2 inverse).
//   3. Algebraic form — N/A: this is the float semantic carrier, not a
//      compression of a richer algebra row.
//   4. Dimensional — FAILS: a float semantic value is EITHER finite with
//      fields OR non-finite — mutually exclusive, not coordinates.
//   5. Parameterized family — FAILS: `Finite` vs `NonFinite` are not a
//      mechanical `F<X>` family over one source set (Practice 7).
// Terminal: the irreducible finite / non-finite split for IEEE semantics.
type FloatBody
  = Finite {
      sign: Bit
      biased_exponent: Nat
      trailing_significand: Nat
    }
  | NonFinite { tag: FloatSpecial }


// ─────────────────────────────────────────────────────────────────────
// Float32 / Float64 — nominal width wrappers over the shared semantic body.
//
// INVARIANTS P2 — outer nominal discriminates API / defaults only; it does
// **not** refine `FloatBody.Finite` fields to binary32 vs binary64 exponent /
// significand bounds (see modeling notes "P2 NOMINAL WRAPPERS").
type Float32 {
  body: FloatBody
}

type Float64 {
  body: FloatBody
}


// Default scalar float is binary64 (same default spirit as dsl/std/float.dag).
type Float = Float64


// ─────────────────────────────────────────────────────────────────────
// Peano compare — reused for lexicographic float compare (carrier-local;
// nat.dag owns `Nat`; this is float-local scaffolding, not a second Nat).
fn nat_compare(a: Nat, b: Nat) -> Ordering {
  match a {
    Zero => match b {
      Zero => Equal
      Succ { prev: _ } => Less
    }
    Succ { prev: ap } => match b {
      Zero => Greater
      Succ { prev: bp } => nat_compare(a: ap, b: bp)
    }
  }
}


// sign_rank_lex — total deterministic rank for lex ordering: negative (True)
// sorts before non-negative (False) at the first lex key (same finite sign
// phase as IEEE 754 `totalOrder`; not a claim of full interchange `totalOrder`).
fn sign_rank_lex(s: Bit) -> Nat {
  match s {
    true => Zero
    false => Succ { prev: Zero }
  }
}


// ordering_invert — flips Less/Greater; used for negative finite magnitudes when
// composing `float_body_compare_semantic_total` (same invert as IEEE
// `totalOrder` on negative magnitudes; carrier-scaffold only).
fn ordering_invert(o: Ordering) -> Ordering {
  match o {
    Less => Greater
    Greater => Less
    Equal => Equal
  }
}


// float_finite_unsigned_field_order — lexicographic Nat order on encoded
// `(biased_exponent, trailing_significand)` as unsigned magnitude keys
// (correct for **positive** IEEE finite values; negatives compose via
// `ordering_invert` in `float_body_compare_semantic_total`).
fn float_finite_unsigned_field_order(
  ea: Nat,
  fa: Nat,
  eb: Nat,
  fb: Nat,
) -> Ordering {
  let o2 = nat_compare(a: ea, b: eb)
  match o2 {
    Less => Less
    Greater => Greater
    Equal => nat_compare(a: fa, b: fb)
  }
}


fn float_special_rank(t: FloatSpecial) -> Nat {
  match t {
    NegInfinity => Zero
    PosInfinity => Succ { prev: Zero }
    QuietNan => Succ { prev: Succ { prev: Zero } }
    SignalingNan => Succ { prev: Succ { prev: Succ { prev: Zero } } }
  }
}


fn float_body_is_nan(x: FloatBody) -> Bool {
  match x {
    NonFinite { tag: QuietNan } => true
    NonFinite { tag: SignalingNan } => true
    _ => false
  }
}


// float_finite_magnitude_zero — true when `biased_exponent` and
// `trailing_significand` are both Peano `Zero` (IEEE ±0 magnitude on this
// carrier; sign bit may still differ).
fn float_finite_magnitude_zero(e: Nat, f: Nat) -> Bool {
  match e {
    Zero => match f {
      Zero => true
      Succ { prev: _ } => false
    }
    Succ { prev: _ } => false
  }
}


// float_body_compare_semantic_total — deterministic **total** order on the
// modeled `FloatBody` carrier: finite values use sign-rank then unsigned
// exponent/significand lex with **inverted** magnitude keys when both signs are
// negative; non-finite rows use `float_special_rank` on `FloatSpecial` only.
//
// INVARIANTS P1 — **not** full IEEE 754 `totalOrder` over interchange: `QuietNan`
// / `SignalingNan` carry **no** NaN sign or payload here (those bits live on
// `Word32`/`Word64` + Grounding). This order is an honest **scaffold** over the
// discriminant this file owns; do not treat it as interchange-grounded
// `totalOrder`. Distinguishes `-0` before `+0` on the carrier. For Tier-2
// numeric extension (incl. `±0` ⇒ `Equal`), use `float_body_compare_ieee_ordered_outcome`.
// NaN **unordered** IEEE `<` stays Tier-2-only (`Rejected`).
fn float_body_compare_semantic_total(a: FloatBody, b: FloatBody) -> Ordering {
  match a {
    Finite { sign: sa, biased_exponent: ea, trailing_significand: fa } => match b {
      Finite { sign: sb, biased_exponent: eb, trailing_significand: fb } => {
        let o = nat_compare(a: sign_rank_lex(sa), b: sign_rank_lex(sb))
        match o {
          Less => Less
          Greater => Greater
          Equal => {
            let mag = float_finite_unsigned_field_order(
              ea: ea,
              fa: fa,
              eb: eb,
              fb: fb,
            )
            match sa {
              true => ordering_invert(o: mag)
              false => mag
            }
          }
        }
      }
      NonFinite { tag: tb } => match tb {
        NegInfinity => Greater
        _ => Less
      }
    }
    NonFinite { tag: ta } => match b {
      Finite {
        sign: sb
        biased_exponent: eb
        trailing_significand: fb
      } => match ta {
        NegInfinity => Less
        _ => Greater
      }
      NonFinite { tag: tb } => nat_compare(
        a: float_special_rank(ta),
        b: float_special_rank(tb)
      )
    }
  }
}


// float_body_compare_ieee_ordered_outcome — IEEE **numeric** ordered compare on
// `FloatBody` with **API-enforced** NaN fail-closed: returns `Rejected` (Tier-2
// diagnostic shape) if either body is `QuietNan`/`SignalingNan`, else `Produced`
// with the `Ordering` (±0 magnitude collapse per prior discipline). No raw
// `Ordering` surface on NaN inputs (INVARIANTS P2 / P3).
fn float_body_compare_ieee_ordered_outcome(
  a: FloatBody,
  b: FloatBody,
  failure_reason: Symbol,
  failure_at_port: Symbol,
) -> Outcome<Ordering> {
  if float_body_is_nan(a) {
    float_ordered_compare_nan_rejected(
      failure_reason: failure_reason,
      failure_at_port: failure_at_port,
    )
  } else {
    if float_body_is_nan(b) {
      float_ordered_compare_nan_rejected(
        failure_reason: failure_reason,
        failure_at_port: failure_at_port,
      )
    } else {
      Produced {
        value: match a {
          Finite { sign: sa, biased_exponent: ea, trailing_significand: fa } => match b {
            Finite { sign: sb, biased_exponent: eb, trailing_significand: fb } => {
              if float_finite_magnitude_zero(e: ea, f: fa)
                && float_finite_magnitude_zero(e: eb, f: fb)
              {
                Equal
              } else {
                float_body_compare_semantic_total(a: a, b: b)
              }
            }
            NonFinite { tag: tb } => float_body_compare_semantic_total(a: a, b: b)
          }
          NonFinite { tag: ta } => float_body_compare_semantic_total(a: a, b: b)
        },
      }
    }
  }
}


// float_ordered_compare_nan_rejected — shared Tier-2 `Rejected` shape for NaN
// on either operand (single structural literal for both branches; semantics unchanged).
fn float_ordered_compare_nan_rejected(
  failure_reason: Symbol,
  failure_at_port: Symbol,
) -> Outcome<Ordering> {
  Rejected {
    diagnostic: Diagnostic {
      reason: failure_reason,
      at: PortLocus { port: failure_at_port },
      correction: Unavailable { reason: UserInputBoundary },
    }
  }
}


// float_ieee_ordered_compare_outcome — `Float` wrapper over
// `float_body_compare_ieee_ordered_outcome` (same Tier-2 `Symbol` pair).
fn float_ieee_ordered_compare_outcome(
  a: Float,
  b: Float,
  failure_reason: Symbol,
  failure_at_port: Symbol,
) -> Outcome<Ordering> {
  float_body_compare_ieee_ordered_outcome(
    a: a.body,
    b: b.body,
    failure_reason: failure_reason,
    failure_at_port: failure_at_port,
  )
}


// float_ordered_compare_tier2 — STRUCTURE.md Tier-2 name: delegates to
// `float_ieee_ordered_compare_outcome` → `float_body_compare_ieee_ordered_outcome`
// (`Outcome` + NaN fail-closed on `FloatBody`).
fn float_ordered_compare_tier2(
  a: Float,
  b: Float,
  failure_reason: Symbol,
  failure_at_port: Symbol,
) -> Outcome<Ordering> {
  float_ieee_ordered_compare_outcome(
    a: a,
    b: b,
    failure_reason: failure_reason,
    failure_at_port: failure_at_port,
  )
}

