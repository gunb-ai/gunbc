// src/v4/std/float.dag
//
// Scope: IEEE-754 binary floating-point — the `Float` scalar. Separate
//        from integer because its arithmetic is APPROXIMATE: rounding
//        breaks associativity / distributivity and NaN breaks reflexive
//        equality, so Float inhabits a weakened algebra rather than an
//        exact `Field`. It is NOT opaque — it is a fully grounded,
//        decomposable concept (bit-record structure + a rounding-aware
//        algebra), consistent with epistemic stacking ("no concept is
//        opaque"); only its *algebra* is weaker than exact arithmetic.
// Anchor: https://en.wikipedia.org/wiki/IEEE_754
//
// Owns:
//   - Float — IEEE-754 binary floating-point (Float32 / Float64). Its
//     STRUCTURE decomposes: a sign / exponent / mantissa bit-record over
//     std/machine.dag, with the non-finite values (NaN, ±Inf, signed
//     zero) modeled as explicit structure. Every part is reachable —
//     nothing opaque.
//   - inhabitance: Float inhabits the rounding-aware ("approximate")
//     algebra structure owned by std/algebra.dag — NOT an exact `Field`
//     (rounding is non-associative). The std/extdeps typescript.dag
//     header already anticipates this structure as `ApproximateField`;
//     algebra.dag (T-2) owns its exact name and definition. Float's
//     grounding is the IEEE-754 spec (the anchor) — a real external
//     standard — composed with that weakened algebra; it is not an
//     unreconciled exception to the minimal-primitive ontology.
//   - Tier-2 totalization for the partial / non-total operations
//     (NaN-producing ops; ordering in the presence of NaN) — STRUCTURE.md
//     commitment #2
//
// Consumes:
//   - std/node.dag: Conj (the sign/exponent/mantissa record),
//     Disj (the finite | NaN | Inf cases)
//   - std/machine.dag: the bit-widths (Float32 / Float64)
//   - std/algebra.dag: the rounding-aware algebra structure Float inhabits
//
// Status: scaffold — fill per TASKS.md T-3 (scalar/numeric stack). Replaces
//   part of the deleted std/primitive.dag; see src/v4/STRUCTURE.md
//   §"scalar/numeric concept decomposition".
// Brief: see BRIEF_TEMPLATE.md; this file's I/O contract is the immutable
// contract for the worker. Splitting this file requires explicit operator
// ratification (substrate extension = stop signal).


module v4.std.float


import v4.std.algebra { Ordering, Less, Equal, Greater }
import v4.std.diagnostic {
  Diagnostic,
  Outcome,
  PortLocus,
  Produced,
  Rejected,
  Unavailable,
  UserInputBoundary,
}
import v4.std.logic { Bool }
import v4.std.machine { Bit, Word32, Word64 }
import v4.std.nat { Nat }
import v4.std.node { Symbol }


// ─────────────────────────────────────────────────────────────────────
// Modeling notes (read before validating against the anchor)
//
// WIDTH NOMINALS — `Float32` / `Float64` are distinct nominal wrappers
// around ONE shared semantic carrier `FloatBody` (IEEE-754 *semantic*
// classification: finite sign + biased exponent + trailing significand
// as Peano `Nat`, vs non-finite tags). Binary32/binary64 **bit layout**
// (interchange formats) remain the authority of `Word32` / `Word64` in
// std/machine.dag — Grounding maps `Float*` ↔ interchange words; this
// file does not duplicate width-correct bit lists (same 🟡 list-length
// scaffold class as machine.dag's `Word*` fields).
//
// P2 NOMINAL WRAPPERS — `Float32` / `Float64` add **no** fields beyond
// `body: FloatBody` and therefore attach **no** structural witness tying
// `Finite.biased_exponent` / `Finite.trailing_significand` to binary32
// (8+23) vs binary64 (11+52) bit counts. A `Float32` value whose `body` is
// `Finite { … }` with exponent/significand magnitudes that could not decode
// from any `Word32` interchange pattern is **still representable** here —
// that hole is the same honest deferral class as **std/machine.dag**'s
// `Word*` / `Byte` list-length vs nominal-width **"LIST FIELD LENGTH vs
// NOMINAL WIDTH — TRACKED SCAFFOLD (🟡)"** block (single P2 authority for
// interchange bit-vectors: `Word32` / `Word64`, not a shadow width engine
// re-authored inside float.dag). Producer-side discipline + bounded
// refinement / dissolution named there close the gap.
//
// NAT FIELDS — `biased_exponent` / `trailing_significand` are honest
// unrefined `Nat` carriers: nominal IEEE field *widths* (8+23 binary32,
// 11+52 binary64) are NOT type-enforced here — the same honest deferral
// pattern as machine.dag's `List<Bit>` width scaffold. Producers must
// respect nominal widths; the dissolution trigger is the same bounded
// refinement substrate named in machine.dag's modeling notes.
//
// APPROXIMATEFIELD INHABITANCE — machine-readable `data … ApproximateField<Float>`
// is **deferred** (tracked scaffold 🟡; INVARIANTS P1/P2 + T-3 operator track):
// wiring `ApproximateField.add` / `mul` to any in-.dag combine on unrefined
// `Nat` exponent/significand fields would either fabricate IEEE float facts or
// install a **second operation authority** beside interchange + Grounding/U1.
// Dissolution = grounded `add`/`mul` realized over `Float32Interchange` /
// `Float64Interchange` (machine.dag `Word*`) on the homomorphism spine.
//
// Until then: **Tier-2** `float_ordered_compare_tier2` + `float_body_compare_total`
// carry the honest partial ordering story (total semantic order for the
// carrier; fail-closed `Outcome` for NaN — STRUCTURE.md commitment #2) without
// an `ApproximateField` inhabitance witness.
//
// SYMBOL ANCHOR — Tier-2 `Rejected` diagnostics take `reason: Symbol` and
// `PortLocus { port: Symbol }` from the **caller-supplied** opaque anchor
// (K-1: no Symbol mint in data literals). The dimension that surfaces the
// rejection binds the anchor at a declaration site; float.dag supplies
// only the schema-shaped carrier.
//
// INTERCHANGE TYPE ALIASES — machine-readable consumption of machine.dag's
// interchange authorities for Grounding edges (P2 single place for words).
type Float32Interchange = Word32
type Float64Interchange = Word64


// ─────────────────────────────────────────────────────────────────────
// FloatSpecial — the closed non-finite discriminant (quiet / signaling
// NaN; ±∞). Anchor: IEEE 754 non-finite classes.
//
// Coproduct dissolution (Practice 4 / INVARIANTS P1 / modeling-
// discipline.md §4) — classification: 🟢 GREEN (terminal). Ledger —
// five patterns attempted:
//   1. Fact placement — FAILS: every float classifier matches these tags
//      uniformly; not a per-consumer scattered fact.
//   2. Variant-is-data — FAILS: four nullary variants — no `{kind,…}`
//      fold without inventing a readable label space (M4).
//   3. Algebraic form — N/A: exceptional-value classification is not an
//      algebra carrier in std/.
//   4. Dimensional — FAILS: a non-finite value is EXACTLY ONE of these
//      alternatives — not simultaneous coordinates.
//   5. Parameterized family — FAILS: the four variants are not one generic
//      `F<X>` / projection over a separately-declared source set (Practice 7).
// Terminal: the irreducible IEEE non-finite partition at semantic float scope.
type FloatSpecial
  = QuietNan
  | SignalingNan
  | PosInfinity
  | NegInfinity


// ─────────────────────────────────────────────────────────────────────
// FloatBody — finite IEEE semantic record vs non-finite tagged class.
//
// Coproduct dissolution (Practice 4 / INVARIANTS P1 / modeling-
// discipline.md §4) — classification: 🟢 GREEN (terminal). Ledger —
// five patterns attempted:
//   1. Fact placement — FAILS: every float consumer folds finite vs
//      non-finite; shared substrate fact, not per-site.
//   2. Variant-is-data — FAILS: `Finite` carries a Conj; `NonFinite` a tag;
//      a flat `{kind,…}` record admits illegal mutual states (P2 inverse).
//   3. Algebraic form — N/A: this is the float semantic carrier, not a
//      compression of a richer algebra row.
//   4. Dimensional — FAILS: a float semantic value is EITHER finite with
//      fields OR non-finite — mutually exclusive, not coordinates.
//   5. Parameterized family — FAILS: `Finite` vs `NonFinite` are not a
//      mechanical `F<X>` family over one source set (Practice 7).
// Terminal: the irreducible finite / non-finite split for IEEE semantics.
type FloatBody
  = Finite {
      sign: Bit
      biased_exponent: Nat
      trailing_significand: Nat
    }
  | NonFinite { tag: FloatSpecial }


// ─────────────────────────────────────────────────────────────────────
// Float32 / Float64 — nominal width wrappers over the shared semantic body.
//
// INVARIANTS P2 — outer nominal discriminates API / defaults only; it does
// **not** refine `FloatBody.Finite` fields to binary32 vs binary64 exponent /
// significand bounds (see modeling notes "P2 NOMINAL WRAPPERS").
type Float32 {
  body: FloatBody
}

type Float64 {
  body: FloatBody
}


// Default scalar float is binary64 (same default spirit as dsl/std/float.dag).
type Float = Float64


// ─────────────────────────────────────────────────────────────────────
// Peano compare — reused for lexicographic float compare (carrier-local;
// nat.dag owns `Nat`; this is float-local scaffolding, not a second Nat).
fn nat_compare(a: Nat, b: Nat) -> Ordering {
  match a {
    Zero => match b {
      Zero => Equal
      Succ { prev: _ } => Less
    }
    Succ { prev: ap } => match b {
      Zero => Greater
      Succ { prev: bp } => nat_compare(a: ap, b: bp)
    }
  }
}


// sign_rank_lex — total deterministic rank for lex ordering: negative (True)
// sorts before non-negative (False) at the first lex key (NOT IEEE value <).
fn sign_rank_lex(s: Bit) -> Nat {
  match s {
    true => Zero
    false => Succ { prev: Zero }
  }
}


fn float_special_rank(t: FloatSpecial) -> Nat {
  match t {
    NegInfinity => Zero
    PosInfinity => Succ { prev: Zero }
    QuietNan => Succ { prev: Succ { prev: Zero } }
    SignalingNan => Succ { prev: Succ { prev: Succ { prev: Zero } } }
  }
}


fn float_body_is_nan(x: FloatBody) -> Bool {
  match x {
    NonFinite { tag: QuietNan } => true
    NonFinite { tag: SignalingNan } => true
    _ => false
  }
}


// float_body_compare_total — deterministic total order on the semantic carrier
// (lexicographic on sign-rank, exponent, significand, then non-finite tag
// ordering). NOT IEEE `<`; see modeling notes + `float_ordered_compare_tier2`.
fn float_body_compare_total(a: FloatBody, b: FloatBody) -> Ordering {
  match a {
    Finite { sign: sa, biased_exponent: ea, trailing_significand: fa } => match b {
      Finite { sign: sb, biased_exponent: eb, trailing_significand: fb } => {
        let o = nat_compare(a: sign_rank_lex(sa), b: sign_rank_lex(sb))
        match o {
          Less => Less
          Greater => Greater
          Equal => {
            let o2 = nat_compare(a: ea, b: eb)
            match o2 {
              Less => Less
              Greater => Greater
              Equal => nat_compare(a: fa, b: fb)
            }
          }
        }
      }
      NonFinite { tag: tb } => match tb {
        NegInfinity => Greater
        _ => Less
      }
    }
    NonFinite { tag: ta } => match b {
      Finite {
        sign: sb
        biased_exponent: eb
        trailing_significand: fb
      } => match ta {
        NegInfinity => Less
        _ => Greater
      }
      NonFinite { tag: tb } => nat_compare(
        a: float_special_rank(ta),
        b: float_special_rank(tb)
      )
    }
  }
}


// float_ordered_compare_tier2 — Tier-2 totalization for **unordered** `<|Equal|Greater>`
// in the presence of NaN: fail-closed `Rejected` carrying `Diagnostic`, else
// `Produced` with the semantic-carrier total compare (NOT IEEE `<`; see modeling notes).
fn float_ordered_compare_tier2(a: Float, b: Float, diagnostic_anchor: Symbol) -> Outcome<Ordering> {
  if float_body_is_nan(a.body) {
    Rejected {
      diagnostic: Diagnostic {
        reason: diagnostic_anchor,
        at: PortLocus { port: diagnostic_anchor },
        correction: Unavailable { reason: UserInputBoundary },
      }
    }
  } else {
    if float_body_is_nan(b.body) {
      Rejected {
        diagnostic: Diagnostic {
          reason: diagnostic_anchor,
          at: PortLocus { port: diagnostic_anchor },
          correction: Unavailable { reason: UserInputBoundary },
        }
      }
    } else {
      Produced { value: float_body_compare_total(a.body, b.body) }
    }
  }
}

