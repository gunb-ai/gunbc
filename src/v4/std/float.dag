// src/v4/std/float.dag
// Scope: IEEE-754 Float32/Float64 semantic carrier + Tier-2 compare (T-3).
// Anchor: https://en.wikipedia.org/wiki/IEEE_754
// Owns: Float32Interchange, Float64Interchange, FloatSpecial, FloatBody, Float32, Float64, Float, float_totalizer_reason_ieee754_nan_unordered, float_totalizer_port_ieee754_nan_totalizer, nat_compare, sign_rank_lex, ordering_invert, float_finite_unsigned_field_order, float_special_rank, float_body_is_nan, float_finite_magnitude_zero, float_body_compare_semantic_total, float_body_compare_ieee_ordered_outcome, float_ordered_compare_nan_rejected, float_ieee_ordered_compare_outcome, float_ordered_compare_tier2.
// Consumes: std algebra, std diagnostic, std logic, std machine, std nat, std node.
// Status: T-3 modeled.
// Ledger: DECISIONS.md Part 6 (PR #3229).


module v4.std.float


import v4.std.algebra { Ordering, Less, Equal, Greater }
import v4.std.diagnostic {
  Diagnostic,
  Outcome,
  PortLocus,
  Produced,
  Rejected,
  Unavailable,
  UserInputBoundary,
}
import v4.std.logic { Bool }
import v4.std.machine { Bit, Word32, Word64 }
import v4.std.nat { Nat }
import v4.std.node { Symbol }
type Float32Interchange = Word32
type Float64Interchange = Word64
// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type FloatSpecial
  = QuietNan
  | SignalingNan
  | PosInfinity
  | NegInfinity
// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type FloatBody
  = Finite {
      sign: Bit
      biased_exponent: Nat
      trailing_significand: Nat
    }
  | NonFinite { tag: FloatSpecial }
type Float32 {
  body: FloatBody
}

type Float64 {
  body: FloatBody
}
type Float = Float64
data float_totalizer_reason_ieee754_nan_unordered: Symbol = float_totalizer_reason_ieee754_nan_unordered
data float_totalizer_port_ieee754_nan_totalizer: Symbol = float_totalizer_port_ieee754_nan_totalizer
fn nat_compare(a: Nat, b: Nat) -> Ordering {
  match a {
    Zero => match b {
      Zero => Equal
      Succ { prev: _ } => Less
    }
    Succ { prev: ap } => match b {
      Zero => Greater
      Succ { prev: bp } => nat_compare(a: ap, b: bp)
    }
  }
}
fn sign_rank_lex(s: Bit) -> Nat {
  match s {
    true => Zero
    false => Succ { prev: Zero }
  }
}
fn ordering_invert(o: Ordering) -> Ordering {
  match o {
    Less => Greater
    Greater => Less
    Equal => Equal
  }
}
fn float_finite_unsigned_field_order(
  ea: Nat,
  fa: Nat,
  eb: Nat,
  fb: Nat,
) -> Ordering {
  let o2 = nat_compare(a: ea, b: eb)
  match o2 {
    Less => Less
    Greater => Greater
    Equal => nat_compare(a: fa, b: fb)
  }
}


fn float_special_rank(t: FloatSpecial) -> Nat {
  match t {
    NegInfinity => Zero
    PosInfinity => Succ { prev: Zero }
    QuietNan => Succ { prev: Succ { prev: Zero } }
    SignalingNan => Succ { prev: Succ { prev: Succ { prev: Zero } } }
  }
}


fn float_body_is_nan(x: FloatBody) -> Bool {
  match x {
    NonFinite { tag: QuietNan } => true
    NonFinite { tag: SignalingNan } => true
    _ => false
  }
}
fn float_finite_magnitude_zero(e: Nat, f: Nat) -> Bool {
  match e {
    Zero => match f {
      Zero => true
      Succ { prev: _ } => false
    }
    Succ { prev: _ } => false
  }
}
fn float_body_compare_semantic_total(a: FloatBody, b: FloatBody) -> Ordering {
  match a {
    Finite { sign: sa, biased_exponent: ea, trailing_significand: fa } => match b {
      Finite { sign: sb, biased_exponent: eb, trailing_significand: fb } => {
        let o = nat_compare(a: sign_rank_lex(sa), b: sign_rank_lex(sb))
        match o {
          Less => Less
          Greater => Greater
          Equal => {
            let mag = float_finite_unsigned_field_order(
              ea: ea,
              fa: fa,
              eb: eb,
              fb: fb,
            )
            match sa {
              true => ordering_invert(o: mag)
              false => mag
            }
          }
        }
      }
      NonFinite { tag: tb } => match tb {
        NegInfinity => Greater
        _ => Less
      }
    }
    NonFinite { tag: ta } => match b {
      Finite {
        sign: sb
        biased_exponent: eb
        trailing_significand: fb
      } => match ta {
        NegInfinity => Less
        _ => Greater
      }
      NonFinite { tag: tb } => nat_compare(
        a: float_special_rank(ta),
        b: float_special_rank(tb)
      )
    }
  }
}
fn float_body_compare_ieee_ordered_outcome(a: FloatBody, b: FloatBody) -> Outcome<Ordering> {
  if float_body_is_nan(a) {
    float_ordered_compare_nan_rejected()
  } else {
    if float_body_is_nan(b) {
      float_ordered_compare_nan_rejected()
    } else {
      Produced {
        value: match a {
          Finite { sign: sa, biased_exponent: ea, trailing_significand: fa } => match b {
            Finite { sign: sb, biased_exponent: eb, trailing_significand: fb } => {
              if float_finite_magnitude_zero(e: ea, f: fa)
                && float_finite_magnitude_zero(e: eb, f: fb)
              {
                Equal
              } else {
                float_body_compare_semantic_total(a: a, b: b)
              }
            }
            NonFinite { tag: tb } => float_body_compare_semantic_total(a: a, b: b)
          }
          NonFinite { tag: ta } => float_body_compare_semantic_total(a: a, b: b)
        },
      }
    }
  }
}
fn float_ordered_compare_nan_rejected() -> Outcome<Ordering> {
  Rejected {
    diagnostic: Diagnostic {
      reason: float_totalizer_reason_ieee754_nan_unordered,
      at: PortLocus { port: float_totalizer_port_ieee754_nan_totalizer },
      correction: Unavailable { reason: UserInputBoundary },
    }
  }
}
fn float_ieee_ordered_compare_outcome(a: Float, b: Float) -> Outcome<Ordering> {
  float_body_compare_ieee_ordered_outcome(a: a.body, b: b.body)
}
fn float_ordered_compare_tier2(a: Float, b: Float) -> Outcome<Ordering> {
  float_ieee_ordered_compare_outcome(a: a, b: b)
}
