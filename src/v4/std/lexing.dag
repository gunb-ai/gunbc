// src/v4/std/lexing.dag
// Scope: canonical lexing types — Token, Lexeme, LexPattern, LexRule, LexRuleSet.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis
// Status: substrate home (model-before-implement). T-6 incumbent forms remain in v4.compiler.tokenize
//         (LexPattern 11-variant, LexRule TokenRule|TriviaRule, Token+spans). 🟡 feature:std-lexing-migrate-t6-incumbent;
//         dissolves when v4.compiler.tokenize imports these types and retires its local declarations.


module v4.std.lexing


import v4.std.collection { List }
import v4.std.node { Symbol }
import v4.std.text { String }


type Lexeme = String

type LexPattern {
  text: String
}

type LexRule {
  pattern: LexPattern
  token_class: Symbol
}

type LexRuleSet {
  rules: List<LexRule>
}

type Token {
  class: Symbol
  lexeme: Lexeme
}
