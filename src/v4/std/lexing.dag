// src/v4/std/lexing.dag
// Scope: canonical lexical model shared by compiler stages and target-language specs.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis + THESIS.md "Compiler-std consolidation" + src/v4/TASKS.md T-6.
// Status: T-6 lexical data carriers; lexer implementation remains in v4.compiler.tokenize.

module v4.std.lexing

import v4.std.algebra { fold_list }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.node { Symbol }
import v4.std.text { Char, String }

type Lexeme = String

// 🟡 coproduct dissolution — feature:t6-lex-char-class-morphism — consumer:v4.compiler.tokenize.char_in_class — bind TASKS.md T-6 — dissolve-on-arrival: substrate-derived LexCharClass membership morphism replaces per-arm character-range predicates; forbidden: adding LexCharClass arms without the morphism consumer.
type LexCharClass
  = WhitespaceChar
  | DigitChar
  | HexDigitChar
  | IdentStartChar
  | IdentContinueChar
  | StringTextChar
  | LineCommentTextChar
  | BlockCommentTextChar


// 🟡 coproduct dissolution — feature:CP-1b-bidirectional-grammar-carrier — consumer:v4.compiler.tokenize.lex_match_pattern/v4.compiler.translate.lex_rules_literal_for_class — bind docs/design-bidirectional-coercion.md §4 + docs/planning/v4-g-bidir-emit-ingest-unification-scoping-worksheet-2026-06-10.md Phase G — dissolve-on-arrival: LexPattern projects from ConcreteSyntaxSchema alongside grammar projection; forbidden: treating LexPattern as a second concrete-syntax authority or adding parallel lexical and grammar production algebras without explicit structural justification.
type LexPattern
  = EmptyPattern
  | LiteralPattern { text: String }
  | KeywordPattern { text: String }
  | CharPattern { char: Char }
  | CharClassPattern { class: LexCharClass }
  | SequencePattern { left: LexPattern, right: LexPattern }
  | ChoicePattern { left: LexPattern, right: LexPattern }
  | OptionalPattern { element: LexPattern }
  | RepeatPattern { element: LexPattern }
  | OneOrMorePattern { element: LexPattern }
  | DelimitedPattern { open: LexPattern, body: LexPattern, close: LexPattern }


// 🟡 coproduct dissolution — feature:t6-lex-rule-morphism — consumer:v4.compiler.tokenize.lex_try_rule/std.lexing.lex_rule_token_class_member — bind TASKS.md T-6 — dissolve-on-arrival: substrate-derived LexRule fold/projection covers token/trivia rule consumers; forbidden: duplicating LexRule arm matches outside this std query and tokenizer walk.
type LexRule
  = TokenRule { token_class: Symbol, pattern: LexPattern }
  | TriviaRule { pattern: LexPattern }


// Maximal munch: compiler tokenization selects the accepting rule with the longest lexeme;
// equal-length ties prefer the later rule (specific literals/keywords after ident).
type LexRuleSet {
  rules: List<LexRule>
}


// 🟡 coproduct dissolution — feature:t6-lex-rules-language-projection — consumer:v4.compiler.tokenize.tokenize/v4.compiler.target_carriers.TargetModel.lex — bind TASKS.md T-6/T-11 — dissolve-on-arrival: LanguageModel lexical projection carries explicit non-empty rule-set or void-language evidence, replacing VoidLexRules staging; forbidden: treating VoidLexRules as an unbounded default.
type LexRules
  = VoidLexRules
  | ModeledLexRules { root: LexRuleSet }


type Token {
  class: Symbol
  lexeme: Lexeme
  file: Symbol
  start: Int
  end: Int
}


type TokenStream {
  tokens: List<Token>
}


// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature:lex-rule-token-class-query — bound task: src/v4/TASKS.md §T-6.1 (owner/lane: T-6 std lexing substrate follow-up) — dissolve-on-arrival: first PR landing substrate-derived LexRule token_class projection + TokenRule discriminant query deletes this hand-written arm match and routes lex_rule_set_token_class_member through that query in the same commit train; forbidden: duplicating LexRule arm matches outside this std query or laundering through local folds.
fn lex_rule_token_class_member(rule: LexRule, token_class: Symbol) -> Bool {
  match rule {
    TokenRule { token_class: c, pattern: _ } => c == token_class
    TriviaRule { pattern: _ } => false
  }
}

fn lex_rule_set_token_class_member(rules: LexRuleSet, token_class: Symbol) -> Bool {
  fold_list(
    xs: rules.rules,
    empty: false,
    cons: fn(acc, rule) {
      acc || lex_rule_token_class_member(rule: rule, token_class: token_class)
    }
  )
}
