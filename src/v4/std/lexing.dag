// src/v4/std/lexing.dag
// Scope: canonical lexing types — Token, Lexeme, LexPattern, LexRule, LexRuleSet.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis
// Status: substrate home. Simplified placeholder shapes: LexPattern here is {text:String} (incumbent in
//         v4.compiler.tokenize:33-44 is 11-variant coproduct); LexRule is one record (incumbent: TokenRule|TriviaRule);
//         Token omits file/start/end spans. 🟡 feature:std-lexing-migrate-t6-incumbent; dissolves when the
//         richer incumbent shapes relocate here (replacing these placeholders) and v4.compiler.tokenize imports from v4.std.lexing.


module v4.std.lexing


import v4.std.collection { List }
import v4.std.node { Symbol }
import v4.std.text { String }


type Lexeme = String

type LexPattern {
  text: String
}

type LexRule {
  pattern: LexPattern
  token_class: Symbol
}

type LexRuleSet {
  rules: List<LexRule>
}

type Token {
  class: Symbol
  lexeme: Lexeme
}
