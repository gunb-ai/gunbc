// src/v4/std/lexing.dag
// Scope: canonical lexing types — Token, Lexeme, LexPattern, LexRule, LexRuleSet.
// Anchor: https://en.wikipedia.org/wiki/Lexical_analysis
// Status: substrate home. LexPattern is a simplified placeholder (see 🟡 below); incumbent structural
//         forms remain in v4.compiler.tokenize (LexPattern 11-variant coproduct:33-44, LexRule sum, Token+spans).
//         🟡 feature:std-lexing-migrate-t6-incumbent; dissolves when richer shapes relocate here.


module v4.std.lexing


import v4.std.collection { List }
import v4.std.node { Symbol }
import v4.std.text { String }


type Lexeme = String

// 🟡 feature:std-lexing-regex-substrate — {text:String} placeholder; structural carrier is the 11-variant LexPattern coproduct in v4.compiler.tokenize:33-44; do not retire T-6 LexPattern until a proper algebraic carrier lands here.
type LexPattern {
  text: String
}

// 🟡 coproduct dissolution — mirrors T-6 TokenRule|TriviaRule shape (v4.compiler.tokenize:48-50).
type LexRule
  = TokenRule { token_class: Symbol, pattern: LexPattern }
  | TriviaRule { pattern: LexPattern }

type LexRuleSet {
  rules: List<LexRule>
}

type Token {
  class: Symbol
  lexeme: Lexeme
  file: Symbol
  start: Int
  end: Int
}
