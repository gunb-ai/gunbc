// src/v4/std/change.dag
// Scope: change-consequence substrate and recomputation plan carrier.
// Owns: ChangeKind, Change, ChangeSet, AffectedDependency, AffectedExclusion, AffectedSetEvidence, AffectedSet, RecomputePlan.
// Consumes: v4.std.collection, v4.std.dependency, v4.std.diagnostic, v4.std.node.
// Status: Wave-2-A substrate.

module v4.std.change

import v4.std.collection { List }
import v4.std.dependency { DependencyKind, DependencyView, ReadinessLayer }
import v4.std.diagnostic { NonEmptyDiagnostics, Outcome }
import v4.std.node { Node, Path, Symbol }

// 🟢 coproduct dissolution
type ChangeKind
  = NodeChanged
  | NodeAdded
  | NodeRemoved
  | ProjectionChanged
  | ArtifactChanged

type Change {
  kind: ChangeKind
  subject: Node
  at: Path
}

type ChangeSet {
  changes: List<Change>
}

type AffectedDependency {
  change: Change
  dependency: DependencyView
  affected: Node
}

type AffectedExclusion {
  change: Change
  dependency: DependencyView
  usage_site: Node
  changed_dimension: Symbol
}

// 🟡 coproduct dissolution — feature:t21-affected-set-testclaims.
type AffectedSetEvidence
  = AffectedSetReason { reason: Symbol }
  | AffectedSetDiagnostics { diagnostics: NonEmptyDiagnostics }

// 🟢 coproduct dissolution — Wave-2-A affected-set success/fail-closed boundary.
type AffectedSet
  = AffectedSetProduced {
      changes: ChangeSet,
      affected: List<AffectedDependency>,
      exclusions: List<AffectedExclusion>,
      restricted_to: List<DependencyKind>
    }
  | AffectedSetFailClosed {
      changes: ChangeSet,
      evidence: AffectedSetEvidence
    }

type RecomputePlan {
  affected: AffectedSet
  layers: List<ReadinessLayer>
  diagnostic: Outcome<Symbol>
}
