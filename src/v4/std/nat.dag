module v4.std.nat
import v4.std.algebra {
  Magma,
  Semigroup,
  Monoid,
  CommutativeMonoid,
  Semiring,
  CommutativeSemiring,
  Ordering,
  Less,
  Equal,
  Greater,
}
import v4.std.node { Symbol }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Nat
  = Zero
  | Succ { prev: Nat }
fn nat_cata<A>(n: Nat, zero: A, succ: fn(A) -> A) -> A {
  match n {
    Zero => zero
    Succ { prev: p } => succ(nat_cata(n: p, zero: zero, succ: succ))
  }
}
fn nat_add(a: Nat, b: Nat) -> Nat {
  nat_cata(n: a, zero: b, succ: fn(acc) { Succ { prev: acc } })
}
fn nat_mul(a: Nat, b: Nat) -> Nat {
  nat_cata(n: a, zero: Zero, succ: fn(acc) { nat_add(a: b, b: acc) })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived Nat total-order compare (binary query consumer); forbidden: nat_cata / fold launder (operator CORE 2026-05-18).
fn nat_compare(a: Nat, b: Nat) -> Ordering {
  match a {
    Zero => match b {
      Zero => Equal
      Succ { prev: _ } => Less
    }
    Succ { prev: ap } => match b {
      Zero => Greater
      Succ { prev: bp } => nat_compare(a: ap, b: bp)
    }
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived Zero-variant discriminant projection; forbidden: nat_cata / fold launder (operator CORE 2026-05-18).
fn is_zero(n: Nat) -> Bool {
  match n {
    Zero => true
    Succ { prev: _ } => false
  }
}
data nat_additive_commutative_monoid: CommutativeMonoid<Nat> = CommutativeMonoid {
  monoid: Monoid {
    semigroup: Semigroup { magma: Magma { op: nat_add } },
    identity: Zero
  }
}
data nat_semiring: CommutativeSemiring<Nat> = CommutativeSemiring {
  semiring: Semiring {
    add: nat_additive_commutative_monoid,
    mul: Monoid {
      semigroup: Semigroup { magma: Magma { op: nat_mul } },
      identity: Succ { prev: Zero }
    }
  }
}

