// src/v4/std/canonical_grounding.dag
// Scope: W-T-10 canonical Node grounding + edge-wise zip-fold predicate algebra.
// Anchor: TASKS.md T-9 coercion fold; docs/modeling/grounding-worked-examples.md §0.
// Owns: CanonicalNodeGrounding, NodeZipFoldResult, canonical_node_zip_fold_result, canonical_nodes_coincide.
// Consumes: std node, std collection.
// Status: W-T-10 modeled; leaf coincidence is fail-closed on declared Atom identity.

module v4.std.canonical_grounding

import v4.std.collection { List }
import v4.std.node {
  Behavior,
  ComputationNode,
  Connective,
  Edge,
  Hash,
  NoEdges,
  Node,
  PositionalEdges,
  TypeNode,
  LabeledEdges,
  behavior_edges_conform,
  connective_edge_discipline,
  well_formed
}

type CanonicalNodeGrounding {
  canonical: Node
  content_hash: Hash
}

// 🟢 W-T-10 predicate algebra. `Exact` is canonical coincidence without raw Node equality.
type NodeZipFoldResult
  = ZipFoldIdentity
  | ZipFoldExact
  | ZipFoldMismatch

type PositionalZipState {
  index: Int
  ok: Bool
}

// 🟡 predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature:zip-fold-result-acceptance-derived-predicate — dissolve-on-arrival: generated predicate projection for accepted `NodeZipFoldResult`; forbidden: caller-local result matches.
fn zip_fold_result_accepts(r: NodeZipFoldResult) -> Bool {
  match r {
    ZipFoldIdentity => true
    ZipFoldExact => true
    ZipFoldMismatch => false
  }
}

fn zip_fold_result_combine(a: NodeZipFoldResult, b: NodeZipFoldResult) -> NodeZipFoldResult {
  match a {
    ZipFoldMismatch => ZipFoldMismatch
    ZipFoldExact => match b {
      ZipFoldMismatch => ZipFoldMismatch
      _ => ZipFoldExact
    }
    ZipFoldIdentity => b
  }
}

fn node_zip_fold_identity_or_exact(
  left: Node,
  right: Node,
  shapes_match: Bool,
) -> NodeZipFoldResult {
  if shapes_match {
    if left == right { ZipFoldIdentity } else { ZipFoldExact }
  } else {
    ZipFoldMismatch
  }
}

fn edge_at(children: List<Edge>, index: Int) -> Edge? {
  first(skip(children, index))
}

fn canonical_named_edges_match(left: List<Edge>, right: List<Edge>) -> Bool {
  if count(left) != count(right) {
    false
  } else {
    fold(left, init: true, f: fn(acc, le) {
      acc && fold(right, init: false, f: fn(found, re) {
        found || (
          (le.label == re.label)
            && zip_fold_result_accepts(
              r: canonical_node_zip_fold_result(left: le.target, right: re.target)
            )
        )
      })
    })
  }
}

fn canonical_positional_edges_match(left: List<Edge>, right: List<Edge>) -> Bool {
  if count(left) != count(right) {
    false
  } else {
    fold(left, init: PositionalZipState { index: 0, ok: true }, f: fn(acc, le) {
      if acc.ok {
        match edge_at(children: right, index: acc.index) {
          Some { value: re } =>
            PositionalZipState {
              index: acc.index + 1,
              ok: (le.label == re.label)
                && zip_fold_result_accepts(
                  r: canonical_node_zip_fold_result(left: le.target, right: re.target)
                )
            }
          None => PositionalZipState { index: acc.index + 1, ok: false }
        }
      } else {
        PositionalZipState { index: acc.index + 1, ok: false }
      }
    }).ok
  }
}

fn canonical_type_node_shapes_match(
  left: Node,
  right: Node,
  connective: Connective,
) -> Bool {
  match connective_edge_discipline(c: connective) {
    NoEdges => count(left.children) == 0 && count(right.children) == 0
    LabeledEdges => canonical_named_edges_match(left: left.children, right: right.children)
    PositionalEdges => canonical_positional_edges_match(left: left.children, right: right.children)
  }
}

fn canonical_node_zip_fold_result(left: Node, right: Node) -> NodeZipFoldResult {
  if !well_formed(n: left) || !well_formed(n: right) || (left.kind != right.kind) {
    ZipFoldMismatch
  } else {
    let shapes_match = match left.kind {
      TypeNode { connective: c } =>
        canonical_type_node_shapes_match(left: left, right: right, connective: c)
      ComputationNode { behavior: b } =>
        behavior_edges_conform(children: left.children, b: b)
          && canonical_positional_edges_match(left: left.children, right: right.children)
    }
    node_zip_fold_identity_or_exact(left: left, right: right, shapes_match: shapes_match)
  }
}

fn canonical_nodes_coincide(left: Node, right: Node) -> Bool {
  zip_fold_result_accepts(r: canonical_node_zip_fold_result(left: left, right: right))
}

// 🟡 predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature:zip-fold-identity-derived-predicate — dissolve-on-arrival: generated predicate projection for identity `NodeZipFoldResult`; forbidden: caller-local result matches.
fn canonical_nodes_identical(left: Node, right: Node) -> Bool {
  match canonical_node_zip_fold_result(left: left, right: right) {
    ZipFoldIdentity => true
    _ => false
  }
}
