// src/v4/std/canonical_grounding.dag
// Scope: W-T-10 canonical Node grounding + edge-wise zip-fold predicate algebra.
// Anchor: TASKS.md T-9 coercion fold; docs/modeling/grounding-worked-examples.md §0.
// Owns: CanonicalNodeGrounding, NodeZipFoldResult, canonical_node_zip_fold_result, canonical_nodes_coincide.
// Consumes: std node, std collection.
// Status: W-T-10 modeled; leaf coincidence is fail-closed on declared Atom identity.

module v4.std.canonical_grounding

import v4.std.collection { List }
import v4.std.node {
  Behavior,
  ComputationNode,
  Connective,
  Edge,
  Hash,
  NoEdges,
  Node,
  NodeFold,
  PositionalEdges,
  TypeNode,
  LabeledEdges,
  behavior_edges_conform,
  connective_edge_discipline,
  fold_node,
  well_formed
}

type CanonicalNodeGrounding {
  canonical: Node
  content_hash: Hash
}

// 🟢 W-T-10 predicate algebra. `Exact` is canonical coincidence without raw Node equality.
type NodeZipFoldResult
  = ZipFoldIdentity
  | ZipFoldExact
  | ZipFoldMismatch

fn zip_fold_result_accepts(r: NodeZipFoldResult) -> Bool {
  match r {
    ZipFoldIdentity => true
    ZipFoldExact => true
    ZipFoldMismatch => false
  }
}

fn zip_fold_result_combine(a: NodeZipFoldResult, b: NodeZipFoldResult) -> NodeZipFoldResult {
  match a {
    ZipFoldMismatch => ZipFoldMismatch
    ZipFoldExact => match b {
      ZipFoldMismatch => ZipFoldMismatch
      _ => ZipFoldExact
    }
    ZipFoldIdentity => b
  }
}

fn node_zip_fold_identity_or_exact(
  left: Node,
  right: Node,
  shapes_match: Bool,
) -> NodeZipFoldResult {
  if shapes_match {
    if left == right { ZipFoldIdentity } else { ZipFoldExact }
  } else {
    ZipFoldMismatch
  }
}

fn canonical_node_init(n: Node) -> Node {
  Node { kind: n.kind, children: [] }
}

fn canonical_node_step(acc: Node, e: Edge, child: Node) -> Node {
  Node {
    kind: acc.kind,
    children: list_push(
      acc.children,
      Edge { label: e.label, target: child }
    )
  }
}

fn canonical_node(n: Node) -> Node {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: canonical_node_init,
      step: canonical_node_step
    }
  )
}

fn canonical_edge_count_in(children: List<Edge>, item: Edge) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    if e == item {
      acc + 1
    } else {
      acc
    }
  })
}

fn canonical_named_edge_bag_eq(left: List<Edge>, right: List<Edge>) -> Bool {
  if count(left) != count(right) {
    false
  } else {
    fold(left, init: true, f: fn(acc, e) {
      acc && (canonical_edge_count_in(children: left, item: e) == canonical_edge_count_in(children: right, item: e))
    })
  }
}

fn canonical_type_node_shapes_match(
  left: Node,
  right: Node,
  connective: Connective,
) -> Bool {
  match connective_edge_discipline(c: connective) {
    NoEdges => left == right
    LabeledEdges =>
      canonical_named_edge_bag_eq(left: left.children, right: right.children)
    PositionalEdges => left == right
  }
}

fn canonical_computation_node_shapes_match(
  left: Node,
  right: Node,
  behavior: Behavior,
) -> Bool {
  if behavior_edges_conform(children: left.children, b: behavior) {
    left == right
  } else {
    false
  }
}

fn canonical_node_zip_fold_result(left: Node, right: Node) -> NodeZipFoldResult {
  if !well_formed(n: left) || !well_formed(n: right) || (left.kind != right.kind) {
    ZipFoldMismatch
  } else {
    let left_canonical = canonical_node(n: left)
    let right_canonical = canonical_node(n: right)
    let shapes_match = match left_canonical.kind {
      TypeNode { connective: c } =>
        canonical_type_node_shapes_match(left: left_canonical, right: right_canonical, connective: c)
      ComputationNode { behavior: b } =>
        canonical_computation_node_shapes_match(left: left_canonical, right: right_canonical, behavior: b)
    }
    node_zip_fold_identity_or_exact(left: left, right: right, shapes_match: shapes_match)
  }
}

fn canonical_nodes_coincide(left: Node, right: Node) -> Bool {
  zip_fold_result_accepts(r: canonical_node_zip_fold_result(left: left, right: right))
}

fn canonical_nodes_identical(left: Node, right: Node) -> Bool {
  match canonical_node_zip_fold_result(left: left, right: right) {
    ZipFoldIdentity => true
    _ => false
  }
}
