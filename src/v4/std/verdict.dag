// src/v4/std/verdict.dag
// Scope: test-run verdict algebra.
// Anchor: docs/design-v4-compiler-homomorphism.md P3 commitment 6 + T-22 eval runner.
// Status: AI-10 substrate declaration — moves Pass/Fail/Deferred algebra out of 05_eval.dag.
//
// ALGEBRA: (Verdict<T>, verdict_combine, Pass) forms a Monoid where:
//   Pass is the identity (bottom element of the join order).
//   Fail absorbs (join: worst outcome wins).
//   Deferred is sticky: once Deferred, only Fail can promote.
// Ordering: Pass < Deferred < Fail (verdict_combine is the join operation).
// BoundedLattice top (Fail) is not representable as a concrete data constant because
//   Fail carries actual: Outcome<T> — no payload-free top exists for general T.
//   The ordering is structurally sound but the lattice inhabitant requires a concrete T.
// verdict_monoid<T> declares the Monoid<Verdict<T>> inhabitant as a function (not data)
//   because Verdict<T> is polymorphic and Monoid fields must resolve at T.
// verdict_fold fails-closed on empty list: caller supplies the empty-case verdict.


module v4.std.verdict


import v4.std.algebra { Magma, Monoid, Semigroup, is_empty }
import v4.std.collection { List, Optional, Absent }
import v4.std.diagnostic { Diagnostic, Outcome }
import v4.std.nat { Nat, Succ, Zero, nat_add }
// 🟢 coproduct dissolution — CP-AI10-VERDICT-TERMINAL.
// Pass: all expected behaviors confirmed.
// Fail: a claim did not hold; actual outcome is attached for diagnostics.
// Deferred: the evaluator could not decide (e.g. eval not yet realized);
//           a diagnostic explains why, and the actual outcome is preserved.
type Verdict<T>
  = Pass
  | Fail { actual: Outcome<T>, falsification: Optional<FalsificationAttachment<T>> }
  | Deferred { actual: Outcome<T>, diagnostic: Diagnostic }

// W2 default (PR #3938 §11.1 / rung-4 min runner): optional structured falsification beside Fail.actual.
type FalsificationAttachment<T> {
  receipt: T
}
// Binary combining operation for verdicts (join of the Pass < Deferred < Fail order).
// Laws:
//   verdict_combine(Pass, v) = v                (Pass is identity)
//   verdict_combine(Fail{a}, _) = Fail{a}       (Fail absorbs)
//   verdict_combine(Deferred{d,diag}, Fail{b}) = Fail{b}   (Fail promotes Deferred)
//   verdict_combine(Deferred{d,diag}, _) = Deferred{d,diag} (Deferred sticky otherwise)
fn verdict_combine<T>(a: Verdict<T>, b: Verdict<T>) -> Verdict<T> {
  match a {
    Pass => b
    Fail { actual: fa, falsification: ff } => Fail { actual: fa, falsification: ff }
    Deferred { actual: da, diagnostic: diag } => match b {
      Fail { actual: fb, falsification: _ } => Fail { actual: fb, falsification: ff }
      Deferred { actual: _, diagnostic: _ } => Deferred { actual: da, diagnostic: diag }
      Pass => Deferred { actual: da, diagnostic: diag }
    }
  }
}
// Monoid<Verdict<T>> inhabitant: op = verdict_combine, identity = Pass.
// Declared as a fn (not data) because Verdict<T> is polymorphic.
// Mirrors the nat_additive_commutative_monoid pattern in nat.dag:57.
fn verdict_monoid<T>() -> Monoid<Verdict<T>> {
  Monoid {
    semigroup: Semigroup { magma: Magma { op: verdict_combine } },
    identity: Pass
  }
}
// Tally of Verdict<T> populations by variant. Carries genuinely distinct
// per-variant work (different field increments in `verdict_tally_add`),
// so it is the canonical surface for "how many Pass / Fail / Deferred"
// over a list — NOT per-variant `is_*` Bool predicates (which would be
// unconditional predicate-dissolution triggers in std/ per
// docs/modeling-discipline.md). Populations are `Nat` so negative counts
// are unrepresentable in the substrate (count invariant lives in the type,
// not in a hand-checked predicate).
type VerdictTally {
  pass: Nat
  fail: Nat
  deferred: Nat
}
data verdict_tally_empty: VerdictTally = VerdictTally { pass: Zero, fail: Zero, deferred: Zero }
fn verdict_tally_add<T>(t: VerdictTally, v: Verdict<T>) -> VerdictTally {
  match v {
    Pass => VerdictTally { pass: Succ { prev: t.pass }, fail: t.fail, deferred: t.deferred }
    Fail { actual: _ } => VerdictTally { pass: t.pass, fail: Succ { prev: t.fail }, deferred: t.deferred }
    Deferred { actual: _, diagnostic: _ } => VerdictTally { pass: t.pass, fail: t.fail, deferred: Succ { prev: t.deferred } }
  }
}
fn verdict_tally<T>(vs: List<Verdict<T>>) -> VerdictTally {
  fold(vs, init: verdict_tally_empty, f: fn(acc, v) {
    verdict_tally_add(t: acc, v: v)
  })
}
fn verdict_tally_total(t: VerdictTally) -> Nat {
  nat_add(a: nat_add(a: t.pass, b: t.fail), b: t.deferred)
}
// Fold a list of verdicts with the monoid identity (Pass) and verdict_combine.
// Fail-closed on empty list: the caller supplies the empty_verdict to enforce
// the desired policy (typically Fail with a context-specific diagnostic).
fn verdict_fold<T>(
  rs: List<Verdict<T>>,
  empty_verdict: Verdict<T>
) -> Verdict<T> {
  match is_empty(xs: rs) {
    true => empty_verdict
    false => fold(rs, init: Pass, f: fn(acc, v) {
      verdict_combine(a: acc, b: v)
    })
  }
}
