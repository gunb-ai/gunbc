// src/v4/std/verdict.dag
// Scope: test-run verdict algebra.
// Anchor: docs/design-v4-compiler-homomorphism.md P3 commitment 6 + T-22 eval runner.
// Status: AI-10 substrate; Verdict<S,T> + Fail.falsification per verdict-surface-contract (#3961).

module v4.std.verdict


import v4.std.algebra { Magma, Monoid, Semigroup, is_empty }
import v4.std.collection { List, Optional, Absent }
import v4.std.diagnostic { Diagnostic, Outcome }
import v4.std.nat { Nat, Succ, Zero, nat_add }
import v4.std.test_claim_falsification { FalsificationReceipt }

// S threads TestClaimEvalSubject<S> into Fail.falsification (phantom on Pass / Deferred).
type Verdict<S, T>
  = Pass
  | Fail { actual: Outcome<T>, falsification: Optional<FalsificationReceipt<S, T>> }
  | Deferred { actual: Outcome<T>, diagnostic: Diagnostic }

fn verdict_fail<S, T>(actual: Outcome<T>) -> Verdict<S, T> {
  Fail { actual: actual, falsification: Absent }
}

fn verdict_combine<S, T>(a: Verdict<S, T>, b: Verdict<S, T>) -> Verdict<S, T> {
  match a {
    Pass => b
    Fail { actual: fa, falsification: ff } => Fail { actual: fa, falsification: ff }
    Deferred { actual: da, diagnostic: diag } => match b {
      Fail { actual: fb, falsification: bf } => Fail { actual: fb, falsification: bf }
      Deferred { actual: _, diagnostic: _ } => Deferred { actual: da, diagnostic: diag }
      Pass => Deferred { actual: da, diagnostic: diag }
    }
  }
}

fn verdict_monoid<S, T>() -> Monoid<Verdict<S, T>> {
  Monoid {
    semigroup: Semigroup { magma: Magma { op: verdict_combine } },
    identity: Pass
  }
}

type VerdictTally {
  pass: Nat
  fail: Nat
  deferred: Nat
}

data verdict_tally_empty: VerdictTally = VerdictTally { pass: Zero, fail: Zero, deferred: Zero }

fn verdict_tally_add<S, T>(t: VerdictTally, v: Verdict<S, T>) -> VerdictTally {
  match v {
    Pass => VerdictTally { pass: Succ { prev: t.pass }, fail: t.fail, deferred: t.deferred }
    Fail { actual: _, falsification: _ } =>
      VerdictTally { pass: t.pass, fail: Succ { prev: t.fail }, deferred: t.deferred }
    Deferred { actual: _, diagnostic: _ } =>
      VerdictTally { pass: t.pass, fail: t.fail, deferred: Succ { prev: t.deferred } }
  }
}

fn verdict_tally<S, T>(vs: List<Verdict<S, T>>) -> VerdictTally {
  fold(vs, init: verdict_tally_empty, f: fn(acc, v) {
    verdict_tally_add(t: acc, v: v)
  })
}

fn verdict_tally_total(t: VerdictTally) -> Nat {
  nat_add(a: nat_add(a: t.pass, b: t.fail), b: t.deferred)
}

fn verdict_fold<S, T>(
  rs: List<Verdict<S, T>>,
  empty_verdict: Verdict<S, T>
) -> Verdict<S, T> {
  match is_empty(xs: rs) {
    true => empty_verdict
    false => fold(rs, init: Pass, f: fn(acc, v) {
      verdict_combine(a: acc, b: v)
    })
  }
}
