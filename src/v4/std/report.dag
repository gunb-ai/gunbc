// src/v4/std/report.dag
// Scope: advisory report carrier.
// Status: T-17 closed ReportReason; T-23 adds ReportSuggestion + diagnostic seam.
// Anchor: docs/r4-carve-out-routing.md

module v4.std.report

import v4.std.diagnostic { Locus }
import v4.std.node { Symbol }

// 🟢 coproduct dissolution
type ReportReason
  = SynthesisGapDecisionTree
  | SynthesisGapInformationTheoretic

// The diagnostic reason is the ReportReason constructor's own name, via the `discriminant`
// intrinsic — no shadow `data ..._reason: Symbol` tags and no hand-written bridge fn. Callers use
// `discriminant(v: report.reason)` directly (see lens/application.dag advisory_report_diagnostic).

type Report {
  reason: ReportReason
  at: Locus
}

type ReportSuggestion {
  report: Report
  detail: Symbol
}
