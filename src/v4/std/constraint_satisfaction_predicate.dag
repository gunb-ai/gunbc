// src/v4/std/constraint_satisfaction_predicate.dag
// Scope: mechanical constraint-satisfaction preservation check (leaf — no find_witness import).
// Anchor: design-v4-compiler-homomorphism.md M10; consumed by std/constraints + std/find_witness.
// Owns: identity_mvp_preservation_holds, constraint_satisfaction_preservation_holds.
// Consumes: std node.
// Status: identity-MVP predicate bodies delegate to shared helper until per-rule semantics land.


module v4.std.constraint_satisfaction_predicate


import v4.std.node { Node, well_formed }
// 🟡 coproduct dissolution — scaffold:identity-mvp-preservation · dissolve-on: each rule's real predicate semantics land — constraint_satisfaction via T-9/T-25-tail; exact_structural_equality_zip_fold via W-T-10 zip-fold predicate algebra.
fn identity_mvp_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  well_formed(n: source_facts)
    && well_formed(n: algebra)
    && well_formed(n: candidate)
    && (algebra == source_facts)
    && (candidate == source_facts)
}
fn constraint_satisfaction_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  identity_mvp_preservation_holds(
    source_facts: source_facts,
    candidate: candidate,
    algebra: algebra
  )
}
