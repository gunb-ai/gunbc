// src/v4/std/dependency.dag
// Scope: P6 dependency graph substrate — domains, edges, witnesses, SCC, topological plan.
// Owns: DependencySubject, ArtifactDependencyEndpoint, Program/TargetPlan/ArtifactDependencyCause (stage-contract projection), Program/TargetPlan/ArtifactSchedulingReason (edge evidence), scheduling/containment edges, ClosedWorldDependencyWitness, IndependenceAttempt, IndependenceClaim, DependencyDiagnostic, TopologicalPlan.
// Consumes: v4.std.collection, v4.std.node.
// Status: Wave-1 Worker A strict substrate.


module v4.std.dependency


import v4.std.collection { List }
import v4.std.node { Path, Symbol }


// 🟢 coproduct dissolution
type ArtifactDependencyEndpoint
  = ArtifactSubject { artifact: Symbol }
  | ProjectionSubject { projection: Symbol }
  | ModelSubject { model: Symbol }


// 🟢 coproduct dissolution
type DependencySubject
  = NodeSubject { path: Path }
  | ArtifactEndpoint { endpoint: ArtifactDependencyEndpoint }


// 🟢 coproduct dissolution — stage-contract cause tags (no witness; not edge evidence).
type ProgramDependencyCause
  = BindsTo
  | TypeDependsOn
  | DataDependsOn
  | EffectDependsOn
  | ResourceDependsOn
  | ModuleDependsOn


// 🟢 coproduct dissolution — scheduling-edge evidence (witness required).
type ProgramSchedulingReason
  = BindsTo { binding_witness: Symbol }
  | TypeDependsOn { type_witness: Symbol }
  | DataDependsOn { dataflow_witness: Symbol }
  | EffectDependsOn { effect_order_witness: Symbol }
  | ResourceDependsOn { resource_conflict_witness: Symbol }
  | ModuleDependsOn { module_import_witness: Symbol }


// 🟢 coproduct dissolution
type TargetPlanDependencyCause
  = PlacementConstraint
  | TransferDependsOn
  | BarrierBefore


// 🟢 coproduct dissolution
type TargetPlanSchedulingReason
  = PlacementConstraint { placement_witness: Symbol }
  | TransferDependsOn { transfer_witness: Symbol }
  | BarrierBefore { barrier_witness: Symbol }


// 🟢 coproduct dissolution
type ArtifactDependencyCause
  = ModelDependsOn
  | ProjectionDependsOn
  | GeneratedFrom
  | VerifiedBy
  | BootstrapDependsOn
  | PromotionDependsOn


// 🟢 coproduct dissolution
type ArtifactSchedulingReason
  = ModelDependsOn { model_witness: Symbol }
  | ProjectionDependsOn { projection_witness: Symbol }
  | GeneratedFrom { provenance_witness: Symbol }
  | VerifiedBy { verifier_witness: Symbol }
  | BootstrapDependsOn { stage_witness: Symbol }
  | PromotionDependsOn { promotion_witness: Symbol }


type ProgramSchedulingEdge {
  required_before: Path
  dependent_after: Path
  reason: ProgramSchedulingReason
}


type TargetPlanSchedulingEdge {
  required_before: Path
  dependent_after: Path
  reason: TargetPlanSchedulingReason
}


type ArtifactSchedulingEdge {
  required_before: ArtifactDependencyEndpoint
  dependent_after: ArtifactDependencyEndpoint
  reason: ArtifactSchedulingReason
}


// 🟢 coproduct dissolution
type SchedulingDependencyEdge
  = Program { edge: ProgramSchedulingEdge }
  | TargetPlan { edge: TargetPlanSchedulingEdge }
  | Artifact { edge: ArtifactSchedulingEdge }


type ContainmentEdge {
  parent: DependencySubject
  child: DependencySubject
}


// 🟢 coproduct dissolution
type DependencyEdge
  = Containment { edge: ContainmentEdge }
  | Scheduling { edge: SchedulingDependencyEdge }


type DependencyGraph {
  containment: List<ContainmentEdge>
  scheduling: List<SchedulingDependencyEdge>
}


type ProgramSemanticFactsComplete {}
type EffectFactsComplete {}
type ResourceFactsComplete {}
type PlacementFactsComplete {}
type TransferFactsComplete {}
type BarrierFactsComplete {}
type ArtifactGraphFactsComplete {}
type ArtifactProvenanceFactsComplete {}


type ProgramCompletenessFacts {
  program_semantic: ProgramSemanticFactsComplete
  effect: EffectFactsComplete
  resource: ResourceFactsComplete
}


type ProgramClosedWorldWitness {
  region: Symbol
  completeness: ProgramCompletenessFacts
}


type ProgramIndependenceClaim {
  witness: ProgramClosedWorldWitness
  left: Path
  right: Path
}


type TargetPlanCompletenessFacts {
  placement: PlacementFactsComplete
  transfer: TransferFactsComplete
  barrier: BarrierFactsComplete
}


type TargetPlanClosedWorldWitness {
  region: Symbol
  completeness: TargetPlanCompletenessFacts
}


type TargetPlanIndependenceClaim {
  witness: TargetPlanClosedWorldWitness
  left: Path
  right: Path
}


type ArtifactCompletenessFacts {
  artifact_graph: ArtifactGraphFactsComplete
  artifact_provenance: ArtifactProvenanceFactsComplete
}


type ArtifactClosedWorldWitness {
  region: Symbol
  completeness: ArtifactCompletenessFacts
}


type ArtifactIndependenceClaim {
  witness: ArtifactClosedWorldWitness
  left: ArtifactDependencyEndpoint
  right: ArtifactDependencyEndpoint
}


// 🟢 coproduct dissolution
type ClosedWorldDependencyWitness
  = Program { witness: ProgramClosedWorldWitness }
  | TargetPlan { witness: TargetPlanClosedWorldWitness }
  | Artifact { witness: ArtifactClosedWorldWitness }


// 🟢 coproduct dissolution
type IndependenceClaim
  = Program { claim: ProgramIndependenceClaim }
  | TargetPlan { claim: TargetPlanIndependenceClaim }
  | Artifact { claim: ArtifactIndependenceClaim }


// 🟢 coproduct dissolution
type IndependenceAttempt
  = Program { left: Path, right: Path }
  | TargetPlan { left: Path, right: Path }
  | Artifact {
      left: ArtifactDependencyEndpoint,
      right: ArtifactDependencyEndpoint
    }


type NonEmptyDependencySubjects {
  first: DependencySubject
  rest: List<DependencySubject>
}


// 🟢 coproduct dissolution
type DependencyDiagnostic
  = UnknownProgramSchedulingFact { edge: ProgramSchedulingEdge }
  | UnknownTargetPlanSchedulingFact { edge: TargetPlanSchedulingEdge }
  | UnknownArtifactSchedulingFact { edge: ArtifactSchedulingEdge }
  | IndependenceWithoutWitness { attempt: IndependenceAttempt }
  | InvalidCycleReason { edge: SchedulingDependencyEdge }


// 🟢 coproduct dissolution
type Scc
  = AcyclicSingleton { id: Symbol, member: DependencySubject }
  | ValidFixedPointCycle {
      id: Symbol,
      members: NonEmptyDependencySubjects,
      witness: Symbol
    }
  | InvalidCycleScc {
      id: Symbol,
      members: NonEmptyDependencySubjects,
      diagnostic: DependencyDiagnostic
    }


type SccCondensation {
  components: List<Scc>
  order_edges: List<SccOrderEdge>
}


type SccOrderEdge {
  required_before: Symbol
  dependent_after: Symbol
}


type TopologicalLayer {
  ready_after_scc_ids: List<Symbol>
  scheduled_scc_ids: List<Symbol>
}


type TopologicalPlan {
  condensation: SccCondensation
  layers: List<TopologicalLayer>
}


fn empty_dependency_graph() -> DependencyGraph {
  DependencyGraph {
    containment: [],
    scheduling: []
  }
}
