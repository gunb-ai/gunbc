// src/v4/std/dependency.dag
// Scope: typed dependency graph substrate (P6) — domains, edges, witnesses, SCC/topo data.
// Anchor: docs/design-v4-compiler-homomorphism.md P6; edge orientation required_before → dependent_after.
// Rule: EffectDependsOn/ResourceDependsOn are edge classifications derived from modeled facts;
//       scheduling edges are domain-tagged; reason family matches domain (illegal cross-domain states unrepresentable).
// Owns: DependencySubject, ArtifactDependencyEndpoint, Program/TargetPlan/Artifact scheduling reasons, ContainmentEdge,
//       SchedulingDependencyEdge,
//       Program/TargetPlan/Artifact dependency kind summaries, ClosedWorldDependencyWitness, topo carriers.
// Consumes: v4.std.collection, v4.std.node.
// Status: Wave-1 Worker A — strict substrate (data contracts only; no stage implementations).


module v4.std.dependency


import v4.std.collection { List }
import v4.std.node { Path, Symbol }


// RULING-1: 🟢 pretty-much-done — P6 domain partition (program vs target-plan vs artifact).
type DependencyDomain
  = Program
  | TargetPlan
  | Artifact


// RULING-1: 🟢 pretty-much-done — summary labels for pipeline contracts (not edge authorities).
type ProgramDependencyKind
  = BindsTo
  | TypeDependsOn
  | DataDependsOn
  | EffectDependsOn
  | ResourceDependsOn
  | ModuleDependsOn


// RULING-1: 🟢 pretty-much-done — target-plan scheduling relation family (P6 TargetPlan tier).
type TargetPlanDependencyKind
  = PlacementConstraint
  | TransferDependsOn
  | BarrierBefore


// RULING-1: 🟢 pretty-much-done — artifact/projection provenance relation family (P6 Artifact tier).
type ArtifactDependencyKind
  = ModelDependsOn
  | ProjectionDependsOn
  | GeneratedFrom
  | VerifiedBy
  | BootstrapDependsOn
  | PromotionDependsOn


// RULING-1: 🟢 pretty-much-done — edge endpoints (Node graph vs artifact/projection/model refs).
type DependencySubject
  = NodeSubject { path: Path }
  | ArtifactSubject { artifact: Symbol }
  | ProjectionSubject { projection: Symbol }
  | ModelSubject { model: Symbol }


// RULING-1: 🟢 pretty-much-done — program-tier scheduling evidence (pairs with ProgramDependencyKind summaries).
type ProgramSchedulingReason
  = BindingReason { fact: Symbol }
  | TypeReason { constraint: Symbol }
  | DataflowReason { flow: Symbol }
  | EffectReason { effect_order_witness: Symbol }
  | ResourceReason { resource_conflict_witness: Symbol }
  | ModuleReason { module_import: Symbol }


// RULING-1: 🟢 pretty-much-done — target-plan-tier scheduling evidence.
type TargetPlanSchedulingReason
  = PlacementReason { placement_witness: Symbol }
  | TransferReason { transfer_witness: Symbol }
  | BarrierReason { barrier_witness: Symbol }


// RULING-1: 🟢 pretty-much-done — artifact/projection/model scheduling evidence.
type ArtifactSchedulingReason
  = ArtifactReason { provenance: Symbol }
  | ModelReason { model_ref: Symbol }
  | ProjectionReason { projection_ref: Symbol }
  | GeneratedFromReason { source: Symbol }
  | VerifiedByReason { verifier: Symbol }
  | BootstrapReason { stage: Symbol }
  | PromotionReason { promotion_witness: Symbol }


// RULING-1: 🟢 pretty-much-done — program scheduling over node paths (P6 Program tier).
type ProgramSchedulingEdge {
  required_before: Path
  dependent_after: Path
  reason: ProgramSchedulingReason
}


// RULING-1: 🟢 pretty-much-done — target-plan scheduling over node paths (P6 TargetPlan tier).
type TargetPlanSchedulingEdge {
  required_before: Path
  dependent_after: Path
  reason: TargetPlanSchedulingReason
}


// RULING-1: 🟢 pretty-much-done — artifact-tier endpoints (no NodeSubject on artifact scheduling).
type ArtifactDependencyEndpoint
  = ArtifactSubject { artifact: Symbol }
  | ProjectionSubject { projection: Symbol }
  | ModelSubject { model: Symbol }


// RULING-1: 🟢 pretty-much-done — artifact scheduling over ArtifactDependencyEndpoint only (P6 Artifact tier).
type ArtifactSchedulingEdge {
  required_before: ArtifactDependencyEndpoint
  dependent_after: ArtifactDependencyEndpoint
  reason: ArtifactSchedulingReason
}


// RULING-1: 🟢 pretty-much-done — domain fixes reason family and endpoint shape (no Program+PlacementReason).
type SchedulingDependencyEdge
  = Program { edge: ProgramSchedulingEdge }
  | TargetPlan { edge: TargetPlanSchedulingEdge }
  | Artifact { edge: ArtifactSchedulingEdge }


// RULING-1: 🟢 pretty-much-done — structural spine (parent contains child); not a scheduling edge.
type ContainmentEdge {
  parent: DependencySubject
  child: DependencySubject
}


// RULING-1: 🟢 pretty-much-done — tagged union for diagnostics; scheduling carries domain-tagged edges.
type DependencyEdge
  = Containment { edge: ContainmentEdge }
  | Scheduling { edge: SchedulingDependencyEdge }


// RULING-1: 🟢 pretty-much-done — containment tree + typed scheduling sidecar (artifact subjects, not Path).
type DependencyGraph {
  containment: List<ContainmentEdge>
  scheduling: List<SchedulingDependencyEdge>
}


// RULING-1: 🟢 pretty-much-done — program-tier closed-world completeness (P6 Program).
type ProgramCompletenessFact
  = ProgramSemanticFactsComplete
  | EffectFactsComplete
  | ResourceFactsComplete


type ProgramCompletenessFacts {
  first: ProgramCompletenessFact
  rest: List<ProgramCompletenessFact>
}


type ProgramClosedWorldWitness {
  region: Symbol
  completeness: ProgramCompletenessFacts
}


type ProgramIndependenceClaim {
  witness: ProgramClosedWorldWitness
  left: Path
  right: Path
}


// RULING-1: 🟢 pretty-much-done — target-plan-tier closed-world completeness (P6 TargetPlan).
type TargetPlanCompletenessFact
  = PlacementFactsComplete
  | TransferFactsComplete
  | BarrierFactsComplete


type TargetPlanCompletenessFacts {
  first: TargetPlanCompletenessFact
  rest: List<TargetPlanCompletenessFact>
}


type TargetPlanClosedWorldWitness {
  region: Symbol
  completeness: TargetPlanCompletenessFacts
}


type TargetPlanIndependenceClaim {
  witness: TargetPlanClosedWorldWitness
  left: Path
  right: Path
}


// RULING-1: 🟢 pretty-much-done — artifact-tier closed-world completeness (P6 Artifact).
type ArtifactCompletenessFact
  = ArtifactGraphFactsComplete
  | ArtifactProvenanceFactsComplete


type ArtifactCompletenessFacts {
  first: ArtifactCompletenessFact
  rest: List<ArtifactCompletenessFact>
}


type ArtifactClosedWorldWitness {
  region: Symbol
  completeness: ArtifactCompletenessFacts
}


type ArtifactIndependenceClaim {
  witness: ArtifactClosedWorldWitness
  left: ArtifactDependencyEndpoint
  right: ArtifactDependencyEndpoint
}


// RULING-1: 🟢 pretty-much-done — domain fixes completeness family (no Program witness + artifact facts).
type ClosedWorldDependencyWitness
  = Program { witness: ProgramClosedWorldWitness }
  | TargetPlan { witness: TargetPlanClosedWorldWitness }
  | Artifact { witness: ArtifactClosedWorldWitness }


// RULING-1: 🟢 pretty-much-done — domain fixes witness + endpoint shape (no Program witness + ArtifactSubject).
type IndependenceClaim
  = Program { claim: ProgramIndependenceClaim }
  | TargetPlan { claim: TargetPlanIndependenceClaim }
  | Artifact { claim: ArtifactIndependenceClaim }


// RULING-1: 🟢 pretty-much-done — cycle permit/reject classification (P6; not blind rejection).
type CycleClassification
  = Acyclic
  | ValidFixedPoint { witness: Symbol }
  | InvalidCycle { diagnostic: DependencyDiagnostic }


type DependencyDiagnostic {
  reason: Symbol
  edge: DependencyEdge
}


type Scc {
  id: Symbol
  members: List<DependencySubject>
  classification: CycleClassification
}


type SccCondensation {
  components: List<Scc>
  order_edges: List<SccOrderEdge>
}


type SccOrderEdge {
  required_before: Symbol
  dependent_after: Symbol
}


type TopologicalLayer {
  ready_after_scc_ids: List<Symbol>
  scheduled_scc_ids: List<Symbol>
}


// RULING-1: 🟢 pretty-much-done — value only; Witness<TopologicalPlan> lives on RecomputePlan.schedule.
type TopologicalPlan {
  condensation: SccCondensation
  layers: List<TopologicalLayer>
}


data dependency_unknown_effect_fact: Symbol = dependency_unknown_effect_fact
data dependency_unknown_resource_fact: Symbol = dependency_unknown_resource_fact
data dependency_independence_without_witness: Symbol = dependency_independence_without_witness
data dependency_invalid_cycle: Symbol = dependency_invalid_cycle


fn dependency_diagnostic(reason: Symbol, edge: DependencyEdge) -> DependencyDiagnostic {
  DependencyDiagnostic {
    reason: reason,
    edge: edge
  }
}


fn empty_dependency_graph() -> DependencyGraph {
  DependencyGraph {
    containment: [],
    scheduling: []
  }
}
