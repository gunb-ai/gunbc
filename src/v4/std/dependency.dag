// src/v4/std/dependency.dag
// Scope: P6 dependency taxonomy and lens-over-substrate dependency view.
// Owns: DependencyKind, DependencyView, ClassifiedDependencyView, ReadinessLayer, dependency_lens, ready_set, topological_layers, classified_source, classified_dependent, classified_usage_site, classified_dependency_view_eq, dependency_binds_to_edge, dependency_module_import_edge, dependency_bootstrap_depends_edge, classify_named_edge_usage, classify_node_edge_usage, dependency_view_for_edge, append_dependency_views, dependency_fold_init, dependency_fold_step, dependency_fold_algebra, dependency_fold_dependencies, dependency_lens, ReadinessLayer, readiness_fold_init, ready_set_fold_step, ready_set_algebra, readiness_fold_ready, ready_set, append_nodes, topological_layers_fold_init, topological_layers_fold_step, topological_layers_algebra, readiness_fold_layers, topological_layers, append_readiness_layers.
// Consumes: std/collection.dag; std/logic.dag; std/node.dag.
// Status: Wave-2-A substrate.

module v4.std.dependency

import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.node {
  Bind,
  ComputationNode,
  Edge,
  Named,
  Node,
  NodeFold,
  Positional,
  Symbol,
  TypeNode,
  fold_node
}

data dependency_binds_to_edge: Symbol = dependency_binds_to_edge
data dependency_module_import_edge: Symbol = dependency_module_import_edge
data dependency_bootstrap_depends_edge: Symbol = dependency_bootstrap_depends_edge

// 🟢 coproduct dissolution
type DependencyKind
  = Contains
  | BindsTo
  | TypeDependsOn
  | DataDependsOn
  | EffectDependsOn
  | ResourceDependsOn
  | ModuleDependsOn
  | BarrierBefore
  | PlacementDependsOn
  | ModelDependsOn
  | ProjectionDependsOn
  | GeneratedFrom
  | VerifiedBy
  | PromotedBy
  | BootstrapDependsOn

type DependencyView {
  source: Node
  dependent: Node
  kind: DependencyKind
  usage_site: Node
}

type ClassifiedDependencyView<C> {
  dependency: DependencyView
  classification: C
}

fn classified_source<C>(view: ClassifiedDependencyView<C>) -> Node {
  view.dependency.source
}

fn classified_dependent<C>(view: ClassifiedDependencyView<C>) -> Node {
  view.dependency.dependent
}

fn classified_usage_site<C>(view: ClassifiedDependencyView<C>) -> Node {
  view.dependency.usage_site
}

fn classified_dependency_view_eq<C>(
  a: ClassifiedDependencyView<C>,
  b: ClassifiedDependencyView<C>,
  classification_eq: fn(C, C) -> Bool
) -> Bool {
  (a.dependency == b.dependency) && classification_eq(a.classification, b.classification)
}

type DependencyFoldState {
  current: Node
  dependencies: List<DependencyView>
}

fn classify_named_edge_usage(parent: Node, sym: Symbol) -> DependencyKind {
  if sym == dependency_binds_to_edge {
    match parent.kind {
      ComputationNode { behavior: Bind } => Contains
      _ => BindsTo
    }
  } else if sym == dependency_module_import_edge {
    ModuleDependsOn
  } else if sym == dependency_bootstrap_depends_edge {
    BootstrapDependsOn
  } else {
    Contains
  }
}

fn classify_node_edge_usage(parent: Node, edge: Edge) -> DependencyKind {
  match edge.label {
    Named { name: sym } => classify_named_edge_usage(parent: parent, sym: sym)
    Positional => Contains
  }
}

fn dependency_view_for_edge(parent: Node, edge: Edge) -> DependencyView {
  let kind = classify_node_edge_usage(parent: parent, edge: edge)
  DependencyView {
    source: parent,
    dependent: edge.target,
    kind: kind,
    usage_site: edge.target
  }
}

fn append_dependency_views(left: List<DependencyView>, right: List<DependencyView>) -> List<DependencyView> {
  fold(right, init: left, f: fn(acc, item) {
    list_push(acc, item)
  })
}

fn dependency_fold_init(n: Node) -> DependencyFoldState {
  DependencyFoldState {
    current: n,
    dependencies: []
  }
}

fn dependency_fold_step(acc: DependencyFoldState, edge: Edge, child_state: DependencyFoldState) -> DependencyFoldState {
  DependencyFoldState {
    current: acc.current,
    dependencies: append_dependency_views(
      left: list_push(acc.dependencies, dependency_view_for_edge(parent: acc.current, edge: edge)),
      right: child_state.dependencies
    )
  }
}

fn dependency_fold_algebra() -> NodeFold<DependencyFoldState> {
  NodeFold {
    init: dependency_fold_init,
    step: dependency_fold_step
  }
}

fn dependency_fold_dependencies(state: DependencyFoldState) -> List<DependencyView> {
  state.dependencies
}

fn dependency_lens(root: Node) -> List<DependencyView> {
  dependency_fold_dependencies(
    state: fold_node(
      n: root,
      algebra: dependency_fold_algebra()
    )
  )
}

type ReadinessLayer {
  ready: List<Node>
}

type ReadinessFoldState {
  current: Node
  ready: List<Node>
  layers: List<ReadinessLayer>
}

fn readiness_fold_init(n: Node) -> ReadinessFoldState {
  ReadinessFoldState {
    current: n,
    ready: [n],
    layers: []
  }
}

fn ready_set_fold_step(acc: ReadinessFoldState, edge: Edge, child_state: ReadinessFoldState) -> ReadinessFoldState {
  ReadinessFoldState {
    current: acc.current,
    ready: append_nodes(left: acc.ready, right: child_state.ready),
    layers: acc.layers
  }
}

fn ready_set_algebra() -> NodeFold<ReadinessFoldState> {
  NodeFold {
    init: readiness_fold_init,
    step: ready_set_fold_step
  }
}

fn readiness_fold_ready(state: ReadinessFoldState) -> List<Node> {
  state.ready
}

fn ready_set(graph_node: Node) -> List<Node> {
  readiness_fold_ready(
    state: fold_node(
      n: graph_node,
      algebra: ready_set_algebra()
    )
  )
}

fn append_nodes(left: List<Node>, right: List<Node>) -> List<Node> {
  fold(right, init: left, f: fn(acc, item) {
    list_push(acc, item)
  })
}

fn topological_layers_fold_init(n: Node) -> ReadinessFoldState {
  ReadinessFoldState {
    current: n,
    ready: [n],
    layers: [
      ReadinessLayer {
        ready: [n]
      }
    ]
  }
}

fn topological_layers_fold_step(acc: ReadinessFoldState, edge: Edge, child_state: ReadinessFoldState) -> ReadinessFoldState {
  ReadinessFoldState {
    current: acc.current,
    ready: append_nodes(left: acc.ready, right: child_state.ready),
    layers: append_readiness_layers(left: acc.layers, right: child_state.layers)
  }
}

fn topological_layers_algebra() -> NodeFold<ReadinessFoldState> {
  NodeFold {
    init: topological_layers_fold_init,
    step: topological_layers_fold_step
  }
}

fn readiness_fold_layers(state: ReadinessFoldState) -> List<ReadinessLayer> {
  state.layers
}

// 🟡 readiness-rank-layer-merge
fn topological_layers(graph_node: Node) -> List<ReadinessLayer> {
  readiness_fold_layers(
    state: fold_node(
      n: graph_node,
      algebra: topological_layers_algebra()
    )
  )
}

fn append_readiness_layers(left: List<ReadinessLayer>, right: List<ReadinessLayer>) -> List<ReadinessLayer> {
  fold(right, init: left, f: fn(acc, item) {
    list_push(acc, item)
  })
}
