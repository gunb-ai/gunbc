// src/v4/std/determinism.dag
// Scope: determinism as a typed property on function signatures (orthogonal to EffectShape in std/effects.dag).
// Status: operator-directive 2026-05-29; PR-1 substrate — lens enforcement lands in v4/lens/determinism.dag (follow-on).

module v4.std.determinism

import v4.std.logic { Bool }
import v4.std.node { Symbol }

// RULING-1: 🟢 pretty-much-done — closed classification for signature-attached determinism (operator 2026-05-29).
type DeterminismClass
  = Deterministic
  | NonDeterministic { source: NonDetSource }

// RULING-1: 🟢 pretty-much-done — closed non-determinism sources (structural lens forbids these in Deterministic fns).
type NonDetSource
  = HashIteration
  | TimeRead
  | RandomRead
  | EnvRead

type DeterminismFact {
  signature: Symbol,
  classification: DeterminismClass
}

fn determinism_class_eq(a: DeterminismClass, b: DeterminismClass) -> Bool {
  match a {
    Deterministic =>
      match b {
        Deterministic => true
        NonDeterministic { source: _ } => false
      }
    NonDeterministic { source: sa } =>
      match b {
        Deterministic => false
        NonDeterministic { source: sb } => determinism_non_det_source_eq(sa: sa, sb: sb)
      }
  }
}

fn determinism_non_det_source_eq(a: NonDetSource, b: NonDetSource) -> Bool {
  match a {
    HashIteration =>
      match b {
        HashIteration => true
        TimeRead => false
        RandomRead => false
        EnvRead => false
      }
    TimeRead =>
      match b {
        HashIteration => false
        TimeRead => true
        RandomRead => false
        EnvRead => false
      }
    RandomRead =>
      match b {
        HashIteration => false
        TimeRead => false
        RandomRead => true
        EnvRead => false
      }
    EnvRead =>
      match b {
        HashIteration => false
        TimeRead => false
        RandomRead => false
        EnvRead => true
      }
  }
}

fn determinism_fact_eq(a: DeterminismFact, b: DeterminismFact) -> Bool {
  a.signature == b.signature && determinism_class_eq(a: a.classification, b: b.classification)
}
