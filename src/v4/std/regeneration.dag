// src/v4/std/regeneration.dag
// Scope: change-consequence substrate (P8) — ChangeSet, AffectedSet, Projection, Artifact, RecomputePlan.
// Anchor: docs/design-v4-compiler-homomorphism.md P8; T-21 lens/affected_set.dag is a frontier specialization (see A4 report).
// Owns: ChangeKind, Change, ChangeSet, AffectedSet, InvalidationReason, Projection, ArtifactKind, Artifact, RecomputePlan.
// Consumes: v4.std.collection, v4.std.dependency, v4.std.node, v4.std.witness.
// Status: Wave-1 Worker A — strict substrate; bare Symbol only on RULING-1 🟡 gated surfaces declared below.


module v4.std.regeneration


import v4.std.collection { List }
import v4.std.dependency {
  DependencyEdge,
  DependencyGraph,
  DependencySubject,
  TopologicalPlan
}
import v4.std.node { Hash, Path, Symbol }
import v4.std.witness { Witness }


// RULING-1: 🟢 pretty-much-done — stable change-consequence taxonomy (P8 unified regeneration).
type ChangeKind
  = NodeChanged
  | EdgeChanged
  | FactChanged
  | WitnessChanged
  | GrammarChanged
  | LanguageModelChanged
  | HostModelChanged
  | PipelineStageChanged
  | LensContractChanged
  | ProjectionChanged
  | Stage0ContractChanged
  | CorePackageSchemaChanged


// RULING-1: 🟢 pretty-much-done — change subject uses DependencySubject authority (not bare Symbol).
type Change {
  kind: ChangeKind
  at: Path
  subject: DependencySubject
}


type ChangeSet {
  from_revision: Hash
  to_revision: Hash
  changes: List<Change>
}


// RULING-1: 🟢 pretty-much-done — artifact taxonomy; bootstrap kinds reserved, protocol deferred at use.
type ArtifactKind
  = TargetSource
  | TestSource
  | Schema
  | Documentation
  | DiagnosticTable
  | CompilerSource
  | CorePackage
  | Stage0Candidate
  | Stage1Candidate
  | WitnessBundle


// RULING-1: 🟢 pretty-much-done — invalidation evidence carriers for AffectedSet.
type InvalidationReason
  = DirectChange { change: Change }
  | DependencyPropagation { edge: DependencyEdge }
  | ProjectionInputChanged { projection: ProjectionIdentityRef }
  | InvalidationFromLensContract { lens: Symbol }
  | PipelineStageContractChanged { stage: Symbol }


type ArtifactRef {
  kind: ArtifactKind
  identity: Symbol
}


// RULING-1: 🟡 feature:projection-identity-ref consumer:v4.std.regeneration::Projection dissolve-on: AffectedSet.projections carries Projection rows or ProjectionRef substrate (bounds: AffectedSet.projections only; owner: Wave-2 P8 substrate PR after #3439).
type ProjectionIdentityRef = Symbol


// RULING-1: 🟡 feature:recompute-cache-key consumer:v4.std.regeneration::RecomputePlan dissolve-on: CacheKey carrier replaces Symbol in RecomputePlan.cached (bounds: RecomputePlan.cached only; owner: Wave-2 P8 substrate PR after #3439).
type CacheKey = Symbol


// RULING-1: 🟡 feature:recompute-invalidation-key consumer:v4.std.regeneration::RecomputePlan dissolve-on: InvalidationKey carrier replaces Symbol in RecomputePlan.invalidated (bounds: RecomputePlan.invalidated only; owner: Wave-2 P8 substrate PR after #3439).
type InvalidationKey = Symbol


type AffectedSet {
  source: ChangeSet
  graph: DependencyGraph
  invalidations: List<InvalidationReason>
  projections: List<ProjectionIdentityRef>
  artifacts: List<ArtifactRef>
}


// RULING-1: 🟢 pretty-much-done — variant-is-data (Practice 4): output kind is a field, not repeated variants.
type Projection {
  output_artifact_kind: ArtifactKind
  name: Symbol
  input_carrier: Symbol
  depends_on: List<DependencySubject>
  algebra_ref: Symbol
}


// RULING-1: 🟡 feature:witness-ref-substrate consumer:v4.std.witness::WitnessRef dissolve-on: WitnessRef carrier in v4.std.witness (bounds: Artifact.witness_ref only; owner: src/v4/TASKS.md T-3 witness substrate + Wave-2 WitnessRef PR after #3439).
type Artifact {
  kind: ArtifactKind
  identity: Symbol
  content_hash: Hash
  produced_by: DependencySubject
  generated_from: List<DependencySubject>
  dependency_hash: Hash
  witness_ref: Symbol
}


type RecomputePlan {
  affected: AffectedSet
  schedule: Witness<TopologicalPlan>
  cached: List<CacheKey>
  invalidated: List<InvalidationKey>
}


fn empty_change_set(from_revision: Hash, to_revision: Hash) -> ChangeSet {
  ChangeSet {
    from_revision: from_revision,
    to_revision: to_revision,
    changes: []
  }
}


fn empty_affected_set(source: ChangeSet, graph: DependencyGraph) -> AffectedSet {
  AffectedSet {
    source: source,
    graph: graph,
    invalidations: [],
    projections: [],
    artifacts: []
  }
}
