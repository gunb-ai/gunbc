// src/v4/std/regeneration.dag
// Scope: P8 change-consequence substrate — ChangeSet, AffectedSet, Projection, Artifact, RecomputePlan.
// Owns: Change, ChangeSet, AffectedConsequence, AffectedSet, InvalidationReason, Projection, ArtifactKind, Artifact, RecomputePlan.
// Consumes: v4.std.collection, v4.std.dependency, v4.std.node, v4.std.witness.
// Status: Wave-1 Worker A strict substrate.


module v4.std.regeneration


import v4.std.collection { List }
import v4.std.dependency {
  ArtifactDependencyEndpoint,
  DependencyEdge,
  DependencyGraph,
  DependencySubject,
  TopologicalPlan
}
import v4.std.node { Hash, Path, Symbol }
import v4.std.pipeline { CarrierKind }
import v4.std.witness { Witness }


// 🟡 feature:projection-identity-ref consumer:v4.std.regeneration::Projection dissolve-on: Projection substrate rows in AffectedConsequence (bounds: AffectedProjection.projection; owner: src/v4/TASKS.md T-21 §847).
type ProjectionIdentityRef = Symbol


// 🟡 feature:recompute-cache-key consumer:v4.std.regeneration::RecomputePlan dissolve-on: CacheKey in RecomputePlan.cached (bounds: cached field; owner: src/v4/TASKS.md T-20 §802).
type CacheKey = Symbol


// 🟡 feature:recompute-invalidation-key consumer:v4.std.regeneration::RecomputePlan dissolve-on: InvalidationKey in RecomputePlan.invalidated (bounds: invalidated field; owner: src/v4/TASKS.md T-20 §802).
type InvalidationKey = Symbol


// 🟡 feature:lens-contract-ref consumer:v4.lens::LensContract dissolve-on: LensContract in InvalidationFromLensContract (bounds: lens field; owner: src/v4/TASKS.md T-21 §847).
type LensContractRef = Symbol


// 🟡 feature:pipeline-stage-name consumer:v4.std.pipeline::PipelineStage dissolve-on: PipelineStage.name in PipelineStageContractChanged (bounds: stage field; owner: src/v4/std/pipeline.dag semantic_compile_pipeline).
type PipelineStageName = Symbol


// 🟡 feature:stage0-contract-ref consumer:v4.std.regeneration::Stage0Contract dissolve-on: Stage0Contract in Stage0ContractChanged (bounds: contract field; owner: src/v4/TASKS.md T-20 §802 workflow/bootstrap.dag).
type Stage0ContractRef = Symbol


// 🟡 feature:core-package-schema-ref consumer:v4.std.regeneration::CorePackageSchema dissolve-on: CorePackageSchema in CorePackageSchemaChanged (bounds: schema field; owner: docs/design-v4-compiler-homomorphism.md §P9 Stage0Contract ~391).
type CorePackageSchemaRef = Symbol


// 🟢 coproduct dissolution
type Change
  = NodeChanged { at: Path }
  | EdgeChanged { edge: DependencyEdge }
  | FactChanged { at: Path, fact: Symbol }
  | WitnessChanged { at: Path, witness: Symbol }
  | GrammarChanged { grammar: Symbol }
  | LanguageModelChanged { language_model: Symbol }
  | HostModelChanged { host_model: Symbol }
  | PipelineStageChanged { stage: PipelineStageName }
  | LensContractChanged { lens: LensContractRef }
  | ProjectionChanged {
      projection: ProjectionIdentityRef,
      endpoint: ArtifactDependencyEndpoint
    }
  | Stage0ContractChanged { contract: Stage0ContractRef }
  | CorePackageSchemaChanged { schema: CorePackageSchemaRef }


type ChangeSet {
  from_revision: Hash
  to_revision: Hash
  changes: List<Change>
}


// 🟢 coproduct dissolution
type ArtifactKind
  = TargetSource
  | TestSource
  | Schema
  | Documentation
  | DiagnosticTable
  | CompilerSource
  | CorePackage
  | Stage0Candidate
  | Stage1Candidate
  | WitnessBundle


// 🟢 coproduct dissolution
type InvalidationReason
  = DirectChange { change: Change }
  | DependencyPropagation { edge: DependencyEdge }
  | ProjectionInputChanged { projection: ProjectionIdentityRef }
  | InvalidationFromLensContract { lens: LensContractRef }
  | PipelineStageContractChanged { stage: PipelineStageName }


type ArtifactRef {
  kind: ArtifactKind
  identity: Symbol
}


// 🟢 coproduct dissolution
type AffectedConsequence
  = Invalidation { reason: InvalidationReason }
  | AffectedProjection {
      projection: ProjectionIdentityRef,
      because: InvalidationReason
    }
  | AffectedArtifact { artifact: ArtifactRef, because: InvalidationReason }


type AffectedSet {
  source: ChangeSet
  graph: DependencyGraph
  consequences: List<AffectedConsequence>
}


type Projection {
  output_artifact_kind: ArtifactKind
  name: Symbol
  input_carrier: CarrierKind
  depends_on: List<DependencySubject>
  algebra_ref: Symbol
}


// 🟡 feature:witness-ref-substrate consumer:v4.std.witness::WitnessRef dissolve-on: WitnessRef carrier in v4.std.witness (bounds: Artifact.witness_ref; owner: src/v4/TASKS.md T-3 §235 witness.dag).
type Artifact {
  kind: ArtifactKind
  identity: Symbol
  content_hash: Hash
  produced_by: DependencySubject
  generated_from: List<DependencySubject>
  dependency_hash: Hash
  witness_ref: Symbol
}


type RecomputePlan {
  affected: AffectedSet
  schedule: Witness<TopologicalPlan>
  cached: List<CacheKey>
  invalidated: List<InvalidationKey>
}


fn empty_change_set(from_revision: Hash, to_revision: Hash) -> ChangeSet {
  ChangeSet {
    from_revision: from_revision,
    to_revision: to_revision,
    changes: []
  }
}


fn empty_affected_set(source: ChangeSet, graph: DependencyGraph) -> AffectedSet {
  AffectedSet {
    source: source,
    graph: graph,
    consequences: []
  }
}
