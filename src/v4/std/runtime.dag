// src/v4/std/runtime.dag
// Scope: Abstract runtime carriers for v4 evaluation.
// Status: Option-C abstract runtime substrate; concrete runtime bundles live under v4.extdeps.runtimes.*.

module v4.std.runtime

import v4.std.collection { List, Map }
import v4.std.diagnostic { Diagnostic, Outcome }
import v4.std.logic { Bool }
import v4.std.machine { Byte }
import v4.std.model_core { ModelCore, PrimitiveOperationRef, ResourceAccess }
import v4.std.node { Behavior, Node, Symbol }

type RuntimeIdentity {
  identity: Symbol
}

type RuntimeFieldValue {
  field: Symbol
  value: RuntimeValue
}

type EnvironmentBindingKey {
  declaration: Node
}

type EvaluationEnvironment {
  bindings: Map<EnvironmentBindingKey, RuntimeValue>
}

type RuntimePrimitiveValue {
  primitive_type: Node
  bytes: List<Byte>
}

type RuntimeAggregateValue {
  aggregate_type: Node
  fields: List<RuntimeFieldValue>
}

type RuntimeReferenceValue {
  reference_type: Node
  identity: RuntimeIdentity
  referent_type: Node
}

type RuntimeClosureValue {
  arrow_type: Node
  arrow: Node
  environment: EvaluationEnvironment
}

type RuntimeUnitValue {
  unit_type: Node
}

// 🟢 terminal — Practice 4 (docs/modeling-discipline.md §4; INVARIANTS P1 Steps 1–3) — Option-C
// abstract runtime value domain at std/runtime authority. Step-2: arms are mutually exclusive
// inhabitants (a value is one kind), not coordinates over Connective/TargetTypeExprKind (type
// vs runtime boundary). Step-1: DAG-ancestor is observable eval result, not type connectives.
// Step-3: substrate primitive for InterpretationAlgebra / TestClaimRun. Patterns 1–5 N/A (payloads
// structurally distinct; no richer named source). RuntimeValueNodeProjection is separately 🟡.
type RuntimeValue
  = RuntimePrimitive { value: RuntimePrimitiveValue }
  | RuntimeAggregate { value: RuntimeAggregateValue }
  | RuntimeReference { value: RuntimeReferenceValue }
  | RuntimeClosure { value: RuntimeClosureValue }
  | RuntimeUnit { value: RuntimeUnitValue }

// 🟡 gated — feature:leaf-model-runtime-outcome — bind docs/planning/v4-leaf-model-verification-2026-05-30.md §5 —
// dissolve-on-arrival: consumer:leaf-model-fixture-runner lands PanicClassification coproduct (replacing panic_classification: Symbol); forbidden: parallel outcome or panic-class vocab outside std/runtime.dag.
type RuntimeOutcome
  = Panic { panic_classification: Symbol }
  | Wrap
  | CheckedReturn { wrapped_value: Node }
  | ExceptionRaise { exception_node: Node }

// 🟡 coproduct dissolution — consumer:runtime-value-node-reification; fail-closed until RuntimeValue payloads have faithful Node representation.
type RuntimeValueNodeProjection
  = RuntimeValueNodeProjected { node: Node }
  | RuntimeValueNodeUnrepresentable

// ctrl#1533 M-C at the v4.std authority (placement per ctrl#1534 §3.3):
// identity-of-values laws the hosts implementing RuntimeValue must obey.
// Grounded in referential transparency of the total λ-fragment (INVARIANTS
// P1 kernel-calculus worked example): a value denotes its structure, so two
// references to one allocation cannot disagree — identity-of-values is a
// theorem there, not a choice.
//
// Law 1 (soundness, one-way): reference-identical ⇒ structurally equal.
//   Reference-distinct implies NOTHING. This is what licenses a host to
//   short-circuit deep equality on shared subtrees (and what the v2 pure-call
//   memo and CanonKey address-keying already rely on implicitly).
// Law 2 (order-independence): equality and hashing of keyed aggregates are
//   functions of the entry SET — the same entries yield equal values and
//   equal hashes regardless of insertion or iteration order
//   (hash_fields_commutative in the v2 host implements this).
// Executable witnesses: v4.test.claim.std_grounding.value_carrier_laws —
// these must stay green across any carrier swap (ctrl#1533 phase-2 gate).
//
// 🟢 terminal — Practice 4 (docs/modeling-discipline.md §4) — variant-is-data
// (pattern 3) already applied: a three-arm sum (ReferenceIdentical /
// StructurallyEqual / StructurallyDistinct) would let an inhabitant claim
// reference identity WITHOUT structural equality; folding the structural
// verdict into a Bool payload makes Law 1 hold by construction —
// ReferenceIdentical carries no equal:false arm to violate it. Remaining
// arms are mutually exclusive observations (how identity was established),
// not coordinates. Patterns 1,2,4,5 N/A.
type IdentityEvidence
  = ReferenceIdentical
  | StructurallyCompared { equal: Bool }

// Law-1 projection: the equality verdict an IdentityEvidence licenses.
// Reference identity short-circuits to true — that IS Law 1.
fn identity_evidence_equal(evidence: IdentityEvidence) -> Bool {
  match evidence {
    ReferenceIdentical => true
    StructurallyCompared { equal: eq } => eq
  }
}

fn runtime_value_resolved_type(value: RuntimeValue) -> Node {
  match value {
    RuntimePrimitive { value: p } => p.primitive_type
    RuntimeAggregate { value: a } => a.aggregate_type
    RuntimeReference { value: r } => r.reference_type
    RuntimeClosure { value: c } => c.arrow_type
    RuntimeUnit { value: u } => u.unit_type
  }
}

fn runtime_value_node_projection(value: RuntimeValue) -> RuntimeValueNodeProjection {
  match value {
    RuntimePrimitive { value: _ } => RuntimeValueNodeUnrepresentable
    RuntimeAggregate { value: _ } => RuntimeValueNodeUnrepresentable
    RuntimeReference { value: _ } => RuntimeValueNodeUnrepresentable
    RuntimeClosure { value: _ } => RuntimeValueNodeUnrepresentable
    RuntimeUnit { value: _ } => RuntimeValueNodeUnrepresentable
  }
}

type ValueRepresentationModel {
  represent_literal: fn(Node, EvaluationEnvironment) -> Outcome<RuntimeValue>
  represent_result: fn(RuntimeValue) -> Outcome<RuntimeValue>
}

type EvaluationFrame {
  current: Node
  environment: EvaluationEnvironment
}

type EvaluationCall {
  callee: Node
  arguments: List<RuntimeValue>
}

// 🟢 terminal — Practice 4 (docs/modeling-discipline.md §4; INVARIANTS P1 Steps 1–3) — abstract
// control-effect sum for InterpretationAlgebra (continue/return/raise/suspend). Step-2: one effect
// at a time, not coordinates with Outcome/Diagnostic (Raise carries Diagnostic but is the control
// path, not a parallel authority). Step-1: CEK-style control at eval boundary, not Behavior/Node
// connectives. Patterns 1–5 N/A (semantically distinct arms; Continue≠Return despite shared payload
// type). Concrete runtimes (v4.extdeps.runtimes.*) interpret; this carrier is the closed vocabulary.
type ControlTransfer
  = Continue { value: RuntimeValue }
  | Return { value: RuntimeValue }
  | Raise { diagnostic: Diagnostic }
  | Suspend { continuation: EvaluationFrame }

type AllocationSemantics {
  allocate: fn(RuntimeValue) -> Outcome<RuntimeValue>
}

type CallSemantics {
  call: fn(EvaluationCall, EvaluationFrame) -> Outcome<ControlTransfer>
  return_value: fn(RuntimeValue, EvaluationFrame) -> Outcome<ControlTransfer>
}

type ControlSemantics {
  transfer: fn(ControlTransfer, EvaluationFrame) -> Outcome<EvaluationFrame>
  terminal_value: fn(ControlTransfer, EvaluationFrame) -> Outcome<RuntimeValue>
}

type ExecutionSemantics {
  allocation: AllocationSemantics
  calls: CallSemantics
  control: ControlSemantics
}

type ValueInterpreter {
  allocate_literal: fn(Node, EvaluationEnvironment) -> Outcome<RuntimeValue>
}

type TransformInterpreter {
  call_primitive: fn(Node, List<RuntimeValue>, EvaluationEnvironment) -> Outcome<RuntimeValue>
}

type BranchInterpreter {
  choose_branch: fn(Node, RuntimeValue, EvaluationEnvironment) -> Outcome<Node>
}

type LoopInterpreter {
  step_loop: fn(Node, EvaluationEnvironment) -> Outcome<ControlTransfer>
}

type BindInterpreter {
  bind_value: fn(EnvironmentBindingKey, RuntimeValue, EvaluationEnvironment) -> Outcome<EvaluationEnvironment>
}

type InterpretationAlgebra {
  value: ValueInterpreter
  transform: TransformInterpreter
  branch: BranchInterpreter
  loop: LoopInterpreter
  bind: BindInterpreter
}

// P2/P3: one Symbol per top-level interpreter fn ref — co-located with InterpretationAlgebra literals at call sites; cache digests derive from this witness (not manual module pins alone).
type InterpretationStructureWitness {
  allocate_literal: Symbol,
  call_primitive: Symbol,
  choose_branch: Symbol,
  step_loop: Symbol,
  bind_value: Symbol
}

// 🟢 coproduct dissolution — behavior dispatch authority lives with InterpretationAlgebra, not eval consumers.
type RuntimeBehaviorInterpreter
  = ValueRuntimeInterpreter { interpreter: ValueInterpreter }
  | TransformRuntimeInterpreter { interpreter: TransformInterpreter }
  | BranchRuntimeInterpreter { interpreter: BranchInterpreter }
  | LoopRuntimeInterpreter { interpreter: LoopInterpreter }
  | BindRuntimeInterpreter { interpreter: BindInterpreter }

fn interpretation_behavior_dispatch(
  interpretation: InterpretationAlgebra,
  behavior: Behavior
) -> RuntimeBehaviorInterpreter {
  match behavior {
    Value => ValueRuntimeInterpreter { interpreter: interpretation.value }
    Transform => TransformRuntimeInterpreter { interpreter: interpretation.transform }
    Branch => BranchRuntimeInterpreter { interpreter: interpretation.branch }
    Loop => LoopRuntimeInterpreter { interpreter: interpretation.loop }
    Bind => BindRuntimeInterpreter { interpreter: interpretation.bind }
  }
}

type BoundaryAllowance {
  operation: PrimitiveOperationRef
  resource: ResourceAccess
  allowed: Bool
}

type ResourceEffectBoundary {
  ffi: BoundaryAllowance
  exceptions: BoundaryAllowance
  async: BoundaryAllowance
  concurrency: BoundaryAllowance
  identity_reference: BoundaryAllowance
}
