// src/v4/std/timeseries_signal.dag
//
// Scope: CANONICAL S1 — analog passive stream substrate (ctrl#1615 / gentle-lynx-177).
// Gauge-dependent AbsolutePotential vs gauge-free PotentialDifference (torsor pair);
// spice.dag passive projection; map/fold step operators land in follow-on slices.
// Anchor: SPICE3 passive element topology via v4.extdeps.formats.spice Component.
// Status: S1 canonical PR #4895 (valiant-ram-713).

module v4.std.timeseries_signal

import v4.std.collection { Optional, Absent, Present }
import v4.std.float { Float }
import v4.std.node { Symbol }
import v4.extdeps.formats.spice {
  Component,
  Capacitor,
  Inductor,
  NodeRef,
  Resistor,
  SpiceApproxVoltage,
  SpiceValue
}

// --- Affine voltage torsor (two distinct types) -----------------------------
//
// AbsolutePotential is meaningful only against an explicit reference node.
// PotentialDifference is gauge-free. Adding two absolutes is ill-typed by
// construction (no binary add across AbsolutePotential).

// 🟢 coproduct dissolution — reference node for gauge-dependent potential samples.
type PotentialReference
  = GroundReference
  | NodeReference { name: Symbol }

// 🟢 grounded — gauge-dependent absolute potential sample.
type AbsolutePotential {
  reference: PotentialReference
  magnitude: Float
}

// 🟢 grounded — gauge-free potential difference (torsor vector).
type PotentialDifference {
  magnitude: Float
}

// 🟢 grounded — branch current sample at this slice.
type BranchCurrent {
  magnitude: Float
}

// 🟢 grounded — spice approximate carrier bridge to AbsolutePotential reference.
type NamedAffineVoltage {
  reference: PotentialReference
  approx: SpiceApproxVoltage
}

// --- Passive element parameters (interim local dimension types) ------------
//
// 🟡 INTERIM — dissolve-on: (a) snappy-stag Quantity-extension governance
// coordination (gentle-lynx-177) lands a ratified Quantity arm for passive
// elements; (b) Measure.count : Nat carrier reconciles with v4 Float magnitudes
// here (Nat-vs-Float representational gap — do NOT touch measure.dag in this PR).
// Forbidden: ossifying these bare Float wrappers as a parallel quantity ledger.

type Resistance {
  ohms: Float
}

type Capacitance {
  farads: Float
}

type Inductance {
  henries: Float
}

// --- spice.dag structural consumption --------------------------------------

type ResistorSpec {
  name: Symbol
  n_plus: NodeRef
  n_minus: NodeRef
  value: SpiceValue
}

type CapacitorSpec {
  name: Symbol
  n_plus: NodeRef
  n_minus: NodeRef
  value: SpiceValue
}

type InductorSpec {
  name: Symbol
  n_plus: NodeRef
  n_minus: NodeRef
  value: SpiceValue
}

type PassiveComponentSpec
  = ResistorPassive { spec: ResistorSpec }
  | CapacitorPassive { spec: CapacitorSpec }
  | InductorPassive { spec: InductorSpec }

fn passive_spec_from_component(component: Component) -> Optional<PassiveComponentSpec> {
  match component {
    Resistor { name, n_plus, n_minus, value } => Present {
      value: ResistorPassive {
        spec: ResistorSpec {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    }
    Capacitor { name, n_plus, n_minus, value } => Present {
      value: CapacitorPassive {
        spec: CapacitorSpec {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    }
    Inductor { name, n_plus, n_minus, value } => Present {
      value: InductorPassive {
        spec: InductorSpec {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    }
    _ => Absent
  }
}

fn named_affine_voltage(
  reference: PotentialReference,
  approx: SpiceApproxVoltage
) -> NamedAffineVoltage {
  NamedAffineVoltage {
    reference: reference,
    approx: approx
  }
}

fn absolute_potential_from_named(
  named: NamedAffineVoltage,
  magnitude: Float
) -> AbsolutePotential {
  AbsolutePotential {
    reference: named.reference,
    magnitude: magnitude
  }
}
