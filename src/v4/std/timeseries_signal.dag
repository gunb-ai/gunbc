// src/v4/std/timeseries_signal.dag
//
// Scope: time-series signal carriers and passive R/L/C step operators as map/fold
//        algebras over uniform sample streams. Circuit thesis: a netlist component
//        graph composes into stream operators — Resistor is a stateless map
//        (v = R·i, frequency-flat); Capacitor and Inductor are fold-over-dt
//        integrators with explicit state.
// Anchor: SPICE3 passive element constitutive relations (Ohm / capacitor / inductor)
//         as cited in v4.extdeps.formats.spice Component variants.
// M9 DFS: reuses v4.std.algebra {fold_list, fold_list_right, list_snoc_item},
//         v4.std.collection {Optional}, v4.std.float {Float},
//         v4.extdeps.formats.spice {Component, SpiceApproxVoltage, SpiceValue, NodeRef}.
// Status: S1 modeled 2026-06-14 (quick-dove-880).
//
// Substrate note: struct-wrapped List<T>/FreeMonoid<T> fields parameterized by an
// outer type parameter (TimeSeriesSignal<T>) fail v2 full-tree compile in this slice.
// Monomorphic stream aliases (SignalStream, CurrentSignalStream, …) are the inhabited
// carriers until generic record fields lower cleanly.

module v4.std.timeseries_signal

import v4.std.algebra {
  Cons,
  Empty,
  fold_list,
  fold_list_right,
  list_snoc_item,
  FreeMonoid
}
import v4.std.collection { Optional, Absent, Present }
import v4.std.float { Float, Finite }
import v4.std.nat { Zero }
import v4.std.node { Symbol }
import v4.extdeps.formats.spice {
  Component,
  Capacitor,
  Inductor,
  NodeRef,
  Resistor,
  SpiceApproxVoltage,
  SpiceValue
}

// --- Affine named voltage carriers -----------------------------------------
//
// Voltage is affine: only differences are physical; reference is explicit data.

// 🟢 coproduct dissolution — reference node for affine voltage samples.
type AffineVoltageReference
  = GroundReference
  | NodeReference { name: Symbol }

// 🟢 grounded — named voltage sample relative to an explicit reference.
type AffineVoltage {
  reference: AffineVoltageReference
  magnitude: Float
}

// 🟢 grounded — named affine voltage backed by the spice approximate carrier.
type NamedAffineVoltage {
  reference: AffineVoltageReference
  approx: SpiceApproxVoltage
}

// 🟢 grounded — named current sample (reference-free at this slice).
type AffineCurrent {
  magnitude: Float
}

// 🟢 grounded — voltage difference between two affine samples.
type AffineVoltageDelta {
  magnitude: Float
}

// --- Uniform time-step signal ----------------------------------------------

type TimeStepDelta {
  seconds: Float
}

type SignalSample {
  value: Int
}

type SignalStream = FreeMonoid<SignalSample>

type CurrentSignalSample {
  current: AffineCurrent
}

type CurrentSignalStream = FreeMonoid<CurrentSignalSample>

type VoltageSignalSample {
  voltage: AffineVoltage
}

type VoltageSignalStream = FreeMonoid<VoltageSignalSample>

data timeseries_unit_dt: TimeStepDelta = TimeStepDelta {
  seconds: Float {
    body: Finite {
      sign: false,
      biased_exponent: Zero,
      trailing_significand: Zero
    }
  }
}

// --- Map/fold algebra pattern carriers -------------------------------------
//
// Siblings to SourceFold (v4.std.text) and NodeFold (v4.std.node): document the
// step-operator algebra contract. R/L/C passives inhabit these patterns via the
// monomorphic fold/map fns below until generic record fields lower cleanly.

type ResistorMapStep {
  apply: fn(CurrentSignalSample) -> VoltageSignalSample
}

type CapacitorFoldStep {
  init: AffineVoltage
  step: fn(AffineVoltage, CurrentSignalSample, TimeStepDelta) -> AffineVoltage
  project: fn(AffineVoltage) -> VoltageSignalSample
}

type InductorFoldStep {
  init: AffineCurrent
  step: fn(AffineCurrent, VoltageSignalSample, TimeStepDelta) -> AffineCurrent
  project: fn(AffineCurrent) -> CurrentSignalSample
}

// --- Stateless map step (Resistor = map) -----------------------------------

fn map_int_sample_double(sample: SignalSample) -> SignalSample {
  SignalSample { value: sample.value * 2 }
}

fn map_time_series_int(signal: SignalStream) -> SignalStream {
  fold_list_right(
    xs: signal,
    empty: Empty,
    snoc: fn(acc, sample) {
      Cons { head: map_int_sample_double(sample), tail: acc }
    }
  )
}

// --- Stateful fold step (Capacitor / Inductor = fold over dt) ------------

type IntFoldScanAcc {
  state: Int
  outputs: SignalStream
}

fn fold_running_sum_step(
  acc: IntFoldScanAcc,
  sample: SignalSample
) -> IntFoldScanAcc {
  let next = acc.state + sample.value
  IntFoldScanAcc {
    state: next,
    outputs: list_snoc_item(
      xs: acc.outputs,
      item: SignalSample { value: next }
    )
  }
}

fn fold_running_sum_int(signal: SignalStream) -> SignalStream {
  let scanned = fold_list(
    xs: signal,
    empty: IntFoldScanAcc { state: 0, outputs: Empty },
    cons: fn(acc, sample) {
      fold_running_sum_step(acc: acc, sample: sample)
    }
  )
  scanned.outputs
}

// --- Passive element parameters + named field kernel -----------------------
//
// fold the traversal, name the kernel: approximate Float arithmetic stays in
// PassiveFieldOps until std float ops land.

type PassiveFieldOps {
  mul: fn(Float, Float) -> Float
  add: fn(Float, Float) -> Float
  div: fn(Float, Float) -> Float
}

type Resistance {
  ohms: Float
}

type Capacitance {
  farads: Float
}

type Inductance {
  henries: Float
}

type ResistorMapContext {
  resistance: Resistance
  field: PassiveFieldOps
}

fn resistor_map_apply(
  ctx: ResistorMapContext,
  sample: CurrentSignalSample
) -> VoltageSignalSample {
  VoltageSignalSample {
    voltage: AffineVoltage {
      reference: GroundReference,
      magnitude: ctx.field.mul(sample.current.magnitude, ctx.resistance.ohms)
    }
  }
}

// v = R · i  (stateless map, frequency-flat)
fn resistor_map_step(
  resistance: Resistance,
  field: PassiveFieldOps
) -> ResistorMapStep {
  let ctx = ResistorMapContext { resistance: resistance, field: field }
  ResistorMapStep {
    apply: fn(sample) { resistor_map_apply(ctx: ctx, sample: sample) }
  }
}

fn map_resistor_current_to_voltage(
  signal: CurrentSignalStream,
  resistance: Resistance,
  field: PassiveFieldOps
) -> VoltageSignalStream {
  let step = resistor_map_step(resistance: resistance, field: field)
  fold_list_right(
    xs: signal,
    empty: Empty,
    snoc: fn(acc, sample) {
      Cons { head: step.apply(sample), tail: acc }
    }
  )
}

type CapacitorFoldAcc {
  voltage: AffineVoltage
  outputs: VoltageSignalStream
}

fn capacitor_fold_step(
  acc: CapacitorFoldAcc,
  sample: CurrentSignalSample,
  dt: TimeStepDelta,
  capacitance: Capacitance,
  field: PassiveFieldOps
) -> CapacitorFoldAcc {
  let i_dt = field.mul(sample.current.magnitude, dt.seconds)
  let dv = field.div(i_dt, capacitance.farads)
  let next_v = AffineVoltage {
    reference: acc.voltage.reference,
    magnitude: field.add(acc.voltage.magnitude, dv)
  }
  CapacitorFoldAcc {
    voltage: next_v,
    outputs: list_snoc_item(
      xs: acc.outputs,
      item: VoltageSignalSample { voltage: next_v }
    )
  }
}

// i = C · dv/dt  ⇒  v[n] = v[n-1] + (i[n] · dt) / C
fn capacitor_fold_algebra(
  capacitance: Capacitance,
  initial_voltage: AffineVoltage,
  field: PassiveFieldOps
) -> CapacitorFoldStep {
  CapacitorFoldStep {
    init: initial_voltage,
    step: fn(prev_v, sample, dt) {
      capacitor_integrate_voltage(
        capacitance: capacitance,
        field: field,
        prev_v: prev_v,
        sample: sample,
        dt: dt
      )
    },
    project: fn(v) {
      VoltageSignalSample { voltage: v }
    }
  }
}

fn capacitor_integrate_voltage(
  capacitance: Capacitance,
  field: PassiveFieldOps,
  prev_v: AffineVoltage,
  sample: CurrentSignalSample,
  dt: TimeStepDelta
) -> AffineVoltage {
  let i_dt = field.mul(sample.current.magnitude, dt.seconds)
  let dv = field.div(i_dt, capacitance.farads)
  AffineVoltage {
    reference: prev_v.reference,
    magnitude: field.add(prev_v.magnitude, dv)
  }
}

fn fold_capacitor_current_to_voltage(
  signal: CurrentSignalStream,
  capacitance: Capacitance,
  initial_voltage: AffineVoltage,
  dt: TimeStepDelta,
  field: PassiveFieldOps
) -> VoltageSignalStream {
  let algebra = capacitor_fold_algebra(
    capacitance: capacitance,
    initial_voltage: initial_voltage,
    field: field
  )
  let scanned = fold_list(
    xs: signal,
    empty: CapacitorFoldAcc { voltage: algebra.init, outputs: Empty },
    cons: fn(acc, sample) {
      let next_v = algebra.step(acc.voltage, sample, dt)
      CapacitorFoldAcc {
        voltage: next_v,
        outputs: list_snoc_item(xs: acc.outputs, item: algebra.project(next_v))
      }
    }
  )
  scanned.outputs
}

type InductorFoldAcc {
  current: AffineCurrent
  outputs: CurrentSignalStream
}

fn inductor_integrate_current(
  inductance: Inductance,
  field: PassiveFieldOps,
  prev_i: AffineCurrent,
  sample: VoltageSignalSample,
  dt: TimeStepDelta
) -> AffineCurrent {
  let v_dt = field.mul(sample.voltage.magnitude, dt.seconds)
  let di = field.div(v_dt, inductance.henries)
  AffineCurrent {
    magnitude: field.add(prev_i.magnitude, di)
  }
}

// v = L · di/dt  ⇒  i[n] = i[n-1] + (v[n] · dt) / L
fn inductor_fold_algebra(
  inductance: Inductance,
  initial_current: AffineCurrent,
  field: PassiveFieldOps
) -> InductorFoldStep {
  InductorFoldStep {
    init: initial_current,
    step: fn(prev_i, sample, dt) {
      inductor_integrate_current(
        inductance: inductance,
        field: field,
        prev_i: prev_i,
        sample: sample,
        dt: dt
      )
    },
    project: fn(i) {
      CurrentSignalSample { current: i }
    }
  }
}

fn inductor_fold_step(
  acc: InductorFoldAcc,
  sample: VoltageSignalSample,
  dt: TimeStepDelta,
  inductance: Inductance,
  field: PassiveFieldOps
) -> InductorFoldAcc {
  let next_i = inductor_integrate_current(
    inductance: inductance,
    field: field,
    prev_i: acc.current,
    sample: sample,
    dt: dt
  )
  InductorFoldAcc {
    current: next_i,
    outputs: list_snoc_item(
      xs: acc.outputs,
      item: CurrentSignalSample { current: next_i }
    )
  }
}

fn fold_inductor_voltage_to_current(
  signal: VoltageSignalStream,
  inductance: Inductance,
  initial_current: AffineCurrent,
  dt: TimeStepDelta,
  field: PassiveFieldOps
) -> CurrentSignalStream {
  let scanned = fold_list(
    xs: signal,
    empty: InductorFoldAcc { current: initial_current, outputs: Empty },
    cons: fn(acc, sample) {
      inductor_fold_step(
        acc: acc,
        sample: sample,
        dt: dt,
        inductance: inductance,
        field: field
      )
    }
  )
  scanned.outputs
}

// --- spice.dag structural consumption --------------------------------------
//
// Lexeme→Float parsing is a named kernel; this slice wires passive topology only.

type ResistorSpec {
  name: Symbol
  n_plus: NodeRef
  n_minus: NodeRef
  value: SpiceValue
}

type CapacitorSpec {
  name: Symbol
  n_plus: NodeRef
  n_minus: NodeRef
  value: SpiceValue
}

type InductorSpec {
  name: Symbol
  n_plus: NodeRef
  n_minus: NodeRef
  value: SpiceValue
}

// 🟢 coproduct dissolution — passive-only projection from spice Component.
type PassiveComponentSpec
  = ResistorPassive { spec: ResistorSpec }
  | CapacitorPassive { spec: CapacitorSpec }
  | InductorPassive { spec: InductorSpec }

fn passive_spec_from_component(component: Component) -> Optional<PassiveComponentSpec> {
  match component {
    Resistor { name, n_plus, n_minus, value } => Present {
      value: ResistorPassive {
        spec: ResistorSpec {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    }
    Capacitor { name, n_plus, n_minus, value } => Present {
      value: CapacitorPassive {
        spec: CapacitorSpec {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    }
    Inductor { name, n_plus, n_minus, value } => Present {
      value: InductorPassive {
        spec: InductorSpec {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    }
    _ => Absent
  }
}

fn resistor_map_from_spec(
  spec: ResistorSpec,
  ohms: Float,
  field: PassiveFieldOps
) -> TimeSeriesMapStep<CurrentSignalSample, VoltageSignalSample> {
  resistor_map_step(resistance: Resistance { ohms: ohms }, field: field)
}

fn named_affine_voltage(
  reference: AffineVoltageReference,
  approx: SpiceApproxVoltage
) -> NamedAffineVoltage {
  NamedAffineVoltage {
    reference: reference,
    approx: approx
  }
}
