// src/v4/std/timeseries_signal.dag
//
// Scope: affine voltage carriers + spice passive projection (compile-safe S1 slice).
// Stream map/fold operators live in canonical v4.std.circuit (#4894); this module
// retains spice.dag consumption and NamedAffineVoltage bridge pending reconcile.
// Anchor: SPICE3 passive element topology via v4.extdeps.formats.spice Component.
// Status: S1 partial — valiant-ram-713 CI fix; absorb into v4.std.circuit per ctrl#1624.

module v4.std.timeseries_signal

import v4.std.collection { Optional, Absent, Present }
import v4.std.float { Float }
import v4.std.node { Symbol }
import v4.extdeps.formats.spice {
  Component,
  Capacitor,
  Inductor,
  NodeRef,
  Resistor,
  SpiceApproxVoltage,
  SpiceValue
}

// --- Affine named voltage carriers -----------------------------------------

type AffineVoltageReference
  = GroundReference
  | NodeReference { name: Symbol }

type AffineVoltage {
  reference: AffineVoltageReference
  magnitude: Float
}

type NamedAffineVoltage {
  reference: AffineVoltageReference
  approx: SpiceApproxVoltage
}

type AffineCurrent {
  magnitude: Float
}

type AffineVoltageDelta {
  magnitude: Float
}

// --- Passive element parameters (Float kernel deferred) --------------------

type Resistance {
  ohms: Float
}

type Capacitance {
  farads: Float
}

type Inductance {
  henries: Float
}

// --- spice.dag structural consumption --------------------------------------

type ResistorSpec {
  name: Symbol
  n_plus: NodeRef
  n_minus: NodeRef
  value: SpiceValue
}

type CapacitorSpec {
  name: Symbol
  n_plus: NodeRef
  n_minus: NodeRef
  value: SpiceValue
}

type InductorSpec {
  name: Symbol
  n_plus: NodeRef
  n_minus: NodeRef
  value: SpiceValue
}

type PassiveComponentSpec
  = ResistorPassive { spec: ResistorSpec }
  | CapacitorPassive { spec: CapacitorSpec }
  | InductorPassive { spec: InductorSpec }

fn passive_spec_from_component(component: Component) -> Optional<PassiveComponentSpec> {
  match component {
    Resistor { name, n_plus, n_minus, value } => Present {
      value: ResistorPassive {
        spec: ResistorSpec {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    }
    Capacitor { name, n_plus, n_minus, value } => Present {
      value: CapacitorPassive {
        spec: CapacitorSpec {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    }
    Inductor { name, n_plus, n_minus, value } => Present {
      value: InductorPassive {
        spec: InductorSpec {
          name: name,
          n_plus: n_plus,
          n_minus: n_minus,
          value: value
        }
      }
    }
    _ => Absent
  }
}

fn named_affine_voltage(
  reference: AffineVoltageReference,
  approx: SpiceApproxVoltage
) -> NamedAffineVoltage {
  NamedAffineVoltage {
    reference: reference,
    approx: approx
  }
}
