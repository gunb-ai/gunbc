// src/v4/std/find_witness.dag
// Scope: unified candidate-enumeration-and-check primitive (Pass B unification).
// Anchor: docs/design-v4-compiler-homomorphism.md (Pass B unification row); docs/modeling-discipline.md Practice 11.
// Owns: CandidateSet, PreservationPredicate, FindWitnessResult, TargetSelectionPolicy, MultiplicityPolicy,
//       find_witness, verify_witness.
// Consumes: std collection, std diagnostic, std node.
// Status: Wave-2-BC3 modeled; enumeration body scaffold until stage consumers land.
// 🟡 coproduct dissolution — scaffold:find_witness-enum · dissolve-on: W-T-10 wires find_witness/verify_witness bodies.


module v4.std.find_witness


import v4.std.algebra { Cons, Empty, FreeMonoid, free_monoid_fold }
import v4.std.collection { List }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  NodeLocus,
  Outcome,
  Rejected,
  Unavailable,
  outcome_rejected
}
import v4.std.node { Edge, Node, Symbol, TypeNode, Atom, well_formed }
import v4.std.witness { StructuralPropertyWitness }
data find_witness_reason_no_candidate: Symbol = find_witness_reason_no_candidate
data find_witness_reason_ambiguous_candidate: Symbol = find_witness_reason_ambiguous_candidate
data find_witness_reason_not_realized: Symbol = find_witness_reason_not_realized
data preservation_rule_constraint_satisfaction: Symbol = preservation_rule_constraint_satisfaction
data preservation_rule_exact_structural_equality_zip_fold: Symbol = preservation_rule_exact_structural_equality_zip_fold
type CandidateSet {
  candidates: List<Node>
  closedness: StructuralPropertyWitness
}
type PreservationPredicate {
  algebra: Node
  preservation_rule: Symbol
}
// 🟡 coproduct dissolution — scaffold:find-witness-result-witness · dissolve-on: W-T-10 typed witness carriers per caller.
type FindWitnessResult {
  candidate: Node
  witness: StructuralPropertyWitness
  closedness: StructuralPropertyWitness
}
// 🟢 coproduct dissolution — local fold state for fail-closed unique candidate selection.
type PassingCandidateFold
  = NoPassingCandidate
  | OnePassingCandidate { candidate: Node }
  | ManyPassingCandidates
// 🟡 coproduct dissolution — local fold state for exact-structural-preservation-distinct-node-mvp; dissolves with W-T-10 recursive edge-wise zip-fold algebra.
type ExactStructuralEdgeZipState {
  remaining: FreeMonoid<Edge>
  matches: Bool
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type TargetSelectionPolicy
  = TargetDeclaredPriority { priority: Node }
  | UserSelected { selection: Node }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type MultiplicityPolicy
  = UniqueOnly
  | TargetSelection { policy: TargetSelectionPolicy }
fn find_witness_no_candidate_diagnostic(source_facts: Node) -> Diagnostic {
  Diagnostic {
    reason: find_witness_reason_no_candidate,
    at: NodeLocus { node: source_facts },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn find_witness_ambiguous_candidate_diagnostic(source_facts: Node) -> Diagnostic {
  Diagnostic {
    reason: find_witness_reason_ambiguous_candidate,
    at: NodeLocus { node: source_facts },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn find_witness_not_realized_diagnostic(source_facts: Node) -> Diagnostic {
  Diagnostic {
    reason: find_witness_reason_not_realized,
    at: NodeLocus { node: source_facts },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
// 🟡 coproduct dissolution — scaffold:exact-structural-preservation-distinct-node-mvp · dissolve-on: W-T-10 recursive edge-wise structural zip-fold predicate algebra.
fn exact_structural_leaf_coincides(source_facts: Node, candidate: Node) -> Bool {
  match source_facts.kind {
    TypeNode { connective: Atom { identity: _ } } => match candidate.kind {
      TypeNode { connective: Atom { identity: _ } } => true
      _ => source_facts.kind == candidate.kind
    }
    _ => source_facts.kind == candidate.kind
  }
}
fn exact_structural_edge_zip_fold(left: FreeMonoid<Edge>, right: FreeMonoid<Edge>) -> Bool {
  let state = free_monoid_fold(
    xs: left,
    empty: ExactStructuralEdgeZipState { remaining: right, matches: true },
    cons: fn(acc, left_edge) {
      match acc.remaining {
        Empty => ExactStructuralEdgeZipState { remaining: Empty, matches: false }
        Cons { head: right_edge, tail: right_tail } =>
          ExactStructuralEdgeZipState {
            remaining: right_tail,
            matches: acc.matches
              && (left_edge.label == right_edge.label)
              && exact_structural_equality_zip_fold(
                source_facts: left_edge.target,
                candidate: right_edge.target
              )
          }
      }
    }
  )
  state.matches && match state.remaining {
    Empty => true
    Cons { head: _, tail: _ } => false
  }
}
fn exact_structural_equality_zip_fold(source_facts: Node, candidate: Node) -> Bool {
  if (count(source_facts.children) == 0) && (count(candidate.children) == 0) {
    exact_structural_leaf_coincides(source_facts: source_facts, candidate: candidate)
  } else {
    (source_facts.kind == candidate.kind)
      && (count(source_facts.children) == count(candidate.children))
      && exact_structural_edge_zip_fold(left: source_facts.children, right: candidate.children)
  }
}
fn preservation_predicate_holds(
  source_facts: Node,
  candidate: Node,
  predicate: PreservationPredicate,
) -> Bool {
  well_formed(n: source_facts)
    && well_formed(n: predicate.algebra)
    && well_formed(n: candidate)
    && (predicate.preservation_rule == preservation_rule_exact_structural_equality_zip_fold)
    && (predicate.algebra == source_facts)
    && exact_structural_equality_zip_fold(source_facts: source_facts, candidate: candidate)
}
fn passing_candidate_count(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
) -> Int {
  fold(candidates.candidates, init: 0, f: fn(acc, candidate) {
    if preservation_predicate_holds(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate
    ) {
      acc + 1
    } else {
      acc
    }
  })
}
fn only_passing_candidate(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
) -> Outcome<Node> {
  match fold(candidates.candidates, init: NoPassingCandidate, f: fn(acc, candidate) {
    if preservation_predicate_holds(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate
    ) {
      match acc {
        NoPassingCandidate => OnePassingCandidate { candidate: candidate }
        OnePassingCandidate { candidate: _ } => ManyPassingCandidates
        ManyPassingCandidates => ManyPassingCandidates
      }
    } else {
      acc
    }
  }) {
    NoPassingCandidate =>
      outcome_rejected(find_witness_no_candidate_diagnostic(source_facts: source_facts))
    OnePassingCandidate { candidate: only } =>
      Accepted { value: only, diagnostics: None }
    ManyPassingCandidates =>
      outcome_rejected(find_witness_ambiguous_candidate_diagnostic(source_facts: source_facts))
  }
}
fn selected_candidate_count(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
  selection: Node,
) -> Int {
  fold(candidates.candidates, init: 0, f: fn(acc, candidate) {
    if (candidate == selection) && preservation_predicate_holds(
      source_facts: source_facts,
      candidate: candidate,
      predicate: predicate
    ) {
      acc + 1
    } else {
      acc
    }
  })
}
fn accepted_witness_result(
  candidate: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
) -> Outcome<FindWitnessResult> {
  Accepted {
    value: FindWitnessResult {
      candidate: candidate,
      witness: StructuralPropertyWitness {
        property: predicate.preservation_rule,
        evidence: candidate
      },
      closedness: candidates.closedness
    },
    diagnostics: None
  }
}
fn resolve_selected_candidate(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
  selection: Node,
) -> Outcome<FindWitnessResult> {
  match selected_candidate_count(
    source_facts: source_facts,
    candidates: candidates,
    predicate: predicate,
    selection: selection
  ) {
    1 => accepted_witness_result(
      candidate: selection,
      candidates: candidates,
      predicate: predicate
    )
    0 => outcome_rejected(find_witness_no_candidate_diagnostic(source_facts: source_facts))
    _ => outcome_rejected(find_witness_ambiguous_candidate_diagnostic(source_facts: source_facts))
  }
}
fn find_witness(
  source_facts: Node,
  candidates: CandidateSet,
  predicate: PreservationPredicate,
  multiplicity_policy: MultiplicityPolicy,
) -> Outcome<FindWitnessResult> {
  let passing_count = passing_candidate_count(
    source_facts: source_facts,
    candidates: candidates,
    predicate: predicate
  )
  match passing_count {
    0 => outcome_rejected(find_witness_no_candidate_diagnostic(source_facts: source_facts))
    1 => match only_passing_candidate(
      source_facts: source_facts,
      candidates: candidates,
      predicate: predicate
    ) {
      Accepted { value: only, diagnostics: _ } => accepted_witness_result(
        candidate: only,
        candidates: candidates,
        predicate: predicate
      )
      Rejected { diagnostics: r } => Rejected { diagnostics: r }
    }
    _ => match multiplicity_policy {
      UniqueOnly =>
        outcome_rejected(find_witness_ambiguous_candidate_diagnostic(source_facts: source_facts))
      TargetSelection { policy: p } => match p {
        TargetDeclaredPriority { priority: priority } =>
          resolve_selected_candidate(
            source_facts: source_facts,
            candidates: candidates,
            predicate: predicate,
            selection: priority
          )
        UserSelected { selection: selection } =>
          resolve_selected_candidate(
            source_facts: source_facts,
            candidates: candidates,
            predicate: predicate,
            selection: selection
          )
      }
    }
  }
}
fn verify_witness(
  source_facts: Node,
  candidate: Node,
  predicate: PreservationPredicate,
  witness: StructuralPropertyWitness,
) -> Outcome<StructuralPropertyWitness> {
  if preservation_predicate_holds(
    source_facts: source_facts,
    candidate: candidate,
    predicate: predicate
  ) && (witness.property == predicate.preservation_rule) && (witness.evidence == candidate) {
    Accepted { value: witness, diagnostics: None }
  } else {
    outcome_rejected(find_witness_no_candidate_diagnostic(source_facts: source_facts))
  }
}
