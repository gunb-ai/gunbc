// src/v4/std/node_query.dag
// Scope: Outcome-bearing structural queries over Node children.
// Consumes: std/diagnostic.dag, std/node.dag.
// Note: lives here rather than in std/node.dag because std/node.dag is a base module
//       that carries no imports; adding Outcome here would create a circular dep
//       (diagnostic.dag imports node.dag).

module v4.std.node_query


import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  node_locus,
  outcome_accepted,
  outcome_rejected
}
import v4.std.algebra { Cons, Empty, FreeMonoid, list_snoc_item }
import v4.std.collection {
  List,
  Optional,
  optional_absent,
  optional_present
}
import v4.std.type_expr_projection_row_schema {
  target_type_expr_field_child_slots
}
import v4.std.node {
  Ambiguous,
  Arrow,
  Conj,
  Absent,
  Edge,
  Found,
  Named,
  Node,
  Positional,
  Symbol,
  TypeNode,
  arrow_body_target_lookup,
  name_occurrences
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-positional-child-targets — bind node://adhoc-sg2-positional-child-targets — dissolve-on-arrival: substrate canonical positional-child target projection on Node.children; lives in node_query (node.dag is import-free substrate root). forbidden: parallel edge-label filters outside std/node_query (e.g. translate-local conj_positional_targets folds).
fn node_positional_child_targets(node: Node) -> List<Node> {
  fold(node.children, init: Empty, f: fn(acc, e) {
    match e.label {
      Positional => list_snoc_item(xs: acc, item: e.target)
      Named { name: _ } => acc
    }
  })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-labeled-child-edges — bind node://adhoc-sg2-labeled-child-edges — dissolve-on-arrival: substrate canonical labeled-child edge projection on Node.children; lives in node_query (node.dag is import-free substrate root). forbidden: parallel edge-label filters outside std/node_query.
fn node_labeled_child_edges(node: Node) -> List<Edge> {
  fold(node.children, init: Empty, f: fn(acc, e) {
    match e.label {
      Named { name: _ } => list_snoc_item(xs: acc, item: e)
      Positional => acc
    }
  })
}

// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-envelope-without-named-coordinate — bind node://adhoc-sg2-envelope-peel — dissolve-on-arrival: substrate canonical peel of ≤1 named coordinate from a Conj envelope edge list; forbidden: parallel edge-label Bool filters outside std/node_query.
fn node_envelope_without_named_coordinate_go(
  xs: FreeMonoid<Edge>,
  coordinate: Symbol,
  acc: FreeMonoid<Edge>,
  saw_coordinate: Bool
) -> FreeMonoid<Edge>? {
  match xs {
    Empty => optional_present(value: acc)
    Cons { head: h, tail: t } =>
      match h.label {
        Named { name: n } =>
          if n == coordinate {
            if saw_coordinate {
              optional_absent()
            } else {
              node_envelope_without_named_coordinate_go(
                xs: t,
                coordinate: coordinate,
                acc: acc,
                saw_coordinate: true
              )
            }
          } else {
            node_envelope_without_named_coordinate_go(
              xs: t,
              coordinate: coordinate,
              acc: list_snoc_item(xs: acc, item: h),
              saw_coordinate: saw_coordinate
            )
          }
        Positional =>
          node_envelope_without_named_coordinate_go(
            xs: t,
            coordinate: coordinate,
            acc: list_snoc_item(xs: acc, item: h),
            saw_coordinate: saw_coordinate
          )
      }
  }
}

fn node_envelope_without_named_coordinate(
  children: FreeMonoid<Edge>,
  coordinate: Symbol
) -> FreeMonoid<Edge>? {
  node_envelope_without_named_coordinate_go(
    xs: children,
    coordinate: coordinate,
    acc: Empty,
    saw_coordinate: false
  )
}

// 🟢 grounded — canonical single-named-edge-target lookup via name_occurrences uniqueness gate
// (Practice 10: no parallel EdgeLabel walker). Misses and ambiguities fail closed via Outcome.
// Conj guard rejects non-Conj roots (Atom nodes cannot have Named edges; malformed inputs fail closed per P3).
fn find_named_child(root: Node, name: Symbol) -> Outcome<Node> {
  match root.kind {
    TypeNode { connective: Conj } =>
      let count = name_occurrences(name: name, children: root.children)
      if count == 1 {
        fold(
          root.children,
          init: outcome_rejected(d: Diagnostic {
            reason: ^named_child_missing,
            at: node_locus(node: root),
            correction: Unavailable { reason: ExternalContractUnknown }
          }),
          f: fn(acc, e) {
            match acc {
              Accepted { value: _, diagnostics: _ } => acc
              Rejected { diagnostics: _ } =>
                match e.label {
                  Named { name: edge_name } =>
                    if edge_name == name { outcome_accepted(value: e.target) } else { acc }
                  Positional => acc
                }
            }
          }
        )
      } else if count == 0 {
        outcome_rejected(d: Diagnostic {
          reason: ^named_child_missing,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      } else {
        outcome_rejected(d: Diagnostic {
          reason: ^named_child_ambiguous,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      }
    _ =>
      outcome_rejected(d: Diagnostic {
        reason: ^named_child_missing,
        at: node_locus(node: root),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}

// 🟢 grounded — Arrow.body single-named-edge lookup (E-9); wraps std.node arrow_body_target_lookup with Outcome diagnostics.
fn find_arrow_body_child(root: Node) -> Outcome<Node> {
  match root.kind {
    TypeNode { connective: Arrow } =>
      match arrow_body_target_lookup(children: root.children) {
        Found { target: body } => outcome_accepted(value: body)
        Absent =>
          outcome_rejected(d: Diagnostic {
            reason: ^arrow_body_child_missing,
            at: node_locus(node: root),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
        Ambiguous =>
          outcome_rejected(d: Diagnostic {
            reason: ^arrow_body_child_ambiguous,
            at: node_locus(node: root),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
      }
    _ =>
      outcome_rejected(d: Diagnostic {
        reason: ^arrow_body_child_not_arrow,
        at: node_locus(node: root),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}
