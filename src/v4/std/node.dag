// src/v4/std/node.dag
// Scope: v4 substrate root for type and computation nodes.
// Anchor: THESIS.md "Substrate shape" + MODELING.md.
// Owns: Symbol, Hash, Connective, ConnectiveCoproductVariant, Behavior, NodeKind, EdgeLabel, Edge, Node, NodeFold, fold_node, EdgeDiscipline, loop_bound_edge, LoopMeasureTargetLookup, loop_behavior_edges_conform, loop_bound_measure_target, loop_edge_contributes_to_iteration_fold, ...
// Consumes: none (List return types use language surface; explicit v4.std.collection import introduces compile-cycle via collection→…→node).
// Status: T-1 modeled; substrate-extension rule in src/v4/STRUCTURE.md.
// Note: bind_outcome + Outcome helpers live in v4.std.diagnostic; traverse_node/sequence_node (Ratified Q4) deferred until v2 accepts Outcome<R> algebra fn types
// (Ratified Q4) — avoids diagnostic↔node import cycle while keeping fold_node here.


module v4.std.node
type Symbol
type Hash
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Connective
  = Atom { identity: Symbol }
  | Conj
  | Disj
  | Arrow
  | Cardinality
  | Instantiation
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Behavior
  = Value
  | Transform
  | Branch
  | Loop
  | Bind


// 🟡 gated — feature:coproduct-variant-enumeration — bound target: coproduct reflection / variant-enumeration substrate (docs/design-dissolution-lens.md L1.1) — bind task: src/v4/TASKS.md#t-1-stdnodedag--substrate-root — dissolve-on-arrival: derive Connective/Behavior variant lists from coproduct reflection in std/node.dag; delete these mirrors.
// forbidden: parallel hand-enumerated Connective/Behavior universes outside std/node.dag.
type ConnectiveCoproductVariant
  = ConnectiveAtomArm
  | ConnectiveConjArm
  | ConnectiveDisjArm
  | ConnectiveArrowArm
  | ConnectiveCardinalityArm
  | ConnectiveInstantiationArm


fn connective_coproduct_variant_keys() -> List<ConnectiveCoproductVariant> {
  [
    ConnectiveAtomArm,
    ConnectiveConjArm,
    ConnectiveDisjArm,
    ConnectiveArrowArm,
    ConnectiveCardinalityArm,
    ConnectiveInstantiationArm,
  ]
}


fn connective_from_coproduct_variant(
  variant: ConnectiveCoproductVariant,
  atom_identity: Symbol
) -> Connective {
  match variant {
    ConnectiveAtomArm => Atom { identity: atom_identity }
    ConnectiveConjArm => Conj
    ConnectiveDisjArm => Disj
    ConnectiveArrowArm => Arrow
    ConnectiveCardinalityArm => Cardinality
    ConnectiveInstantiationArm => Instantiation
  }
}


fn behavior_coproduct_variants() -> List<Behavior> {
  [Value, Transform, Branch, Loop, Bind]
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type NodeKind
  = TypeNode { connective: Connective }
  | ComputationNode { behavior: Behavior }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type EdgeLabel
  = Named { name: Symbol }
  | Positional
type Edge {
  label: EdgeLabel
  target: Node
}
// 🟡 gated — substrate-shape bridge (docs/modeling-discipline.md Practice 2/10) — feature: node-behavior-loop-bound-edge-tag — owner: T-12 LoopBound cost-lens wiring — lane: shared Interval<D> parent for Loop measure facts — dissolve-on-arrival: replace Symbol-tagged Loop bound attachment with structural Loop-bound coordinate owned by the interval/bound substrate; forbidden: new Loop-bound consumers matching raw Named(loop_bound_edge) outside std.node/std.cardinality.
data loop_bound_edge: Symbol = loop_bound_edge
type Node {
  kind: NodeKind
  children: List<Edge>
}
type NodeFold<R> {
  init: fn(Node) -> R
  step: fn(R, Edge, R) -> R
}
fn fold_node<R>(n: Node, algebra: NodeFold<R>) -> R {
  fold(n.children, init: algebra.init(n), f: fn(acc, e) {
    algebra.step(acc, e, fold_node(n: e.target, algebra: algebra))
  })
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type EdgeDiscipline
  = NoEdges
  | LabeledEdges
  | PositionalEdges
fn connective_edge_discipline(c: Connective) -> EdgeDiscipline {
  match c {
    Atom { identity: _ } => NoEdges
    Conj => LabeledEdges
    Disj => LabeledEdges
    Arrow => PositionalEdges
    Cardinality => PositionalEdges
    Instantiation => PositionalEdges
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived EdgeLabel Named-variant discriminant projection; forbidden: fold laundering.
fn is_named(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => true
    Positional => false
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived EdgeLabel Positional-variant discriminant projection; forbidden: fold laundering.
fn is_positional(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => false
    Positional => true
  }
}

fn all_edges_named(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && is_named(e: e)
  })
}

fn all_edges_positional(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && is_positional(e: e)
  })
}
fn name_occurrences(name: Symbol, children: List<Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Named { name: n } => if n == name { acc + 1 } else { acc }
      Positional => acc
    }
  })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-positional-count — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop positional-child count query; forbidden: parallel ad-hoc Loop arity predicates outside well_formed.
fn loop_positional_child_count(children: List<Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Positional => acc + 1
      Named { name: _ } => acc
    }
  })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-edge-discipline — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop edge-discipline query shared by well_formed and cardinality witnesses; forbidden: parallel ad-hoc Loop edge predicates outside well_formed.
fn loop_body_edges_conform(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Positional => acc
      Named { name: sym } => acc && (sym == loop_bound_edge)
    }
  })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-edge-discipline — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop edge-discipline query shared by well_formed and cardinality witnesses; forbidden: parallel ad-hoc Loop edge predicates outside well_formed.
fn loop_behavior_edges_conform(children: List<Edge>) -> Bool {
  let bound_edges = name_occurrences(name: loop_bound_edge, children: children)
  (bound_edges == 1)
  && loop_body_edges_conform(children: children)
  && (loop_positional_child_count(children: children) >= 1)
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-bound-measure-target — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop loop_bound_edge target projection shared by cardinality witness; forbidden: parallel ad-hoc loop_bound_edge extraction outside well_formed/cardinality.
type LoopMeasureTargetLookup
  = Found { target: Node }
  | Ambiguous
  | Absent
fn loop_bound_measure_target(children: List<Edge>) -> LoopMeasureTargetLookup {
  fold(children, init: Absent, f: fn(acc, e) {
    match e.label {
      Named { name: sym } =>
        if sym == loop_bound_edge {
          match acc {
            Absent => Found { target: e.target }
            Found { target: _ } => Ambiguous
            Ambiguous => Ambiguous
          }
        } else {
          acc
        }
      Positional => acc
    }
  })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-iteration-fold — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop iteration-fold edge query scoped to Loop parents; forbidden: edge-label-only loop_bound_edge skip outside Loop.
fn loop_edge_contributes_to_iteration_fold(parent: Node, e: Edge) -> Bool {
  match parent.kind {
    ComputationNode { behavior: Loop } =>
      match e.label {
        Positional => true
        Named { name: sym } => sym != loop_bound_edge
      }
    _ =>
      match e.label {
        Positional => true
        Named { name: _ } => true
      }
  }
}
fn all_names_distinct(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Named { name: n } => acc && (name_occurrences(name: n, children: children) == 1)
      Positional => acc
    }
  })
}
fn edges_conform(children: List<Edge>, d: EdgeDiscipline) -> Bool {
  match d {
    NoEdges => count(children) == 0
    LabeledEdges =>
      all_edges_named(children: children) && all_names_distinct(children: children)
    PositionalEdges => all_edges_positional(children: children)
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-connective-arity-well-formed — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Connective arity query over positional child count; forbidden: parallel ad-hoc arity predicates outside well_formed.
fn connective_edges_conform(children: List<Edge>, c: Connective) -> Bool {
  match c {
    Atom { identity: _ } => edges_conform(children: children, d: NoEdges)
    Conj => edges_conform(children: children, d: LabeledEdges)
    Disj => edges_conform(children: children, d: LabeledEdges)
    Arrow =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Cardinality =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Instantiation =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-arity-well-formed — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Behavior arity query over positional child count; forbidden: parallel ad-hoc arity predicates outside well_formed.
fn behavior_edges_conform(children: List<Edge>, b: Behavior) -> Bool {
  match b {
    Value => count(children) == 0
    Transform => edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Branch => edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Loop => loop_behavior_edges_conform(children: children)
    Bind => edges_conform(children: children, d: PositionalEdges) && (count(children) == 3)
  }
}
fn locally_well_formed(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: c } => connective_edges_conform(children: n.children, c: c)
    ComputationNode { behavior: b } => behavior_edges_conform(children: n.children, b: b)
  }
}
fn well_formed(n: Node) -> Bool {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        locally_well_formed(n: n0)
      },
      step: fn(acc, _, child_ok) {
        acc && child_ok
      }
    }
  )
}
// 🟢 predicate dissolution — api-review P5 receipt PR #3274 (SG-0 census N/A for v4-only substrate).
fn is_empty_conj_root(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Conj } => count(n.children) == 0
    _ => false
  }
}
type Path {
  steps: List<Symbol>
}
type Edit {
  at: Path
  replacement: Node
}
type Diff {
  edits: List<Edit>
}
