// src/v4/std/node.dag
// Scope: v4 substrate root for type and computation nodes.
// Anchor: THESIS.md "Substrate shape" + MODELING.md.
// Owns: Symbol, Hash, Connective, Behavior, NodeKind, EdgeLabel, Edge, Node, NodeFold, fold_node, NodeOutcomeFold, traverse_node, sequence_node, map_node_outcome, EdgeDiscipline, connective_edge_discipline, edge_is_named, edge_is_positional, all_edges_named, all_edges_positional, name_occurrences, all_names_distinct, edges_conform, node_locally_well_formed, node_well_formed, is_empty_conj_root, Path, Edit, Diff.
// Consumes: std diagnostic, std outcome.
// Status: T-1 modeled; traverse_node substrate per design-v4-compiler-homomorphism Ratified Q4.


module v4.std.node


import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  NonEmptyDiagnostics,
  Outcome,
  PortLocus,
  Rejected,
  Singleton,
  Unavailable
}
import v4.std.outcome { StageDiagnosticPolicy }
type Symbol
type Hash
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Connective
  = Atom { identity: Symbol }
  | Conj
  | Disj
  | Arrow
  | Cardinality
  | Instantiation
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Behavior
  = Value
  | Transform
  | Branch
  | Loop
  | Bind
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type NodeKind
  = TypeNode { connective: Connective }
  | ComputationNode { behavior: Behavior }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type EdgeLabel
  = Named { name: Symbol }
  | Positional
type Edge {
  label: EdgeLabel
  target: Node
}
type Node {
  kind: NodeKind
  children: List<Edge>
}
type NodeFold<R> {
  init: fn(Node) -> R
  step: fn(R, Edge, R) -> R
}
fn fold_node<R>(n: Node, algebra: NodeFold<R>) -> R {
  fold(n.children, init: algebra.init(n), f: fn(acc, e) {
    algebra.step(acc, e, fold_node(n: e.target, algebra: algebra))
  })
}
type NodeOutcomeFold<R> {
  policy: StageDiagnosticPolicy
  init: fn(Node) -> Outcome<R>
  step: fn(Outcome<R>, Edge, Node) -> Outcome<R>
}
data traverse_node_not_realized: Symbol = traverse_node_not_realized
fn traverse_node_not_realized_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: traverse_node_not_realized,
    at: PortLocus { port: traverse_node_not_realized },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn traverse_node<R>(n: Node, algebra: NodeOutcomeFold<R>) -> Outcome<R> {
  Rejected {
    diagnostics: Singleton { diagnostic: traverse_node_not_realized_diagnostic() }
  }
}
fn sequence_node<R>(nodes: List<Node>, algebra: NodeOutcomeFold<R>) -> Outcome<List<R>> {
  Rejected {
    diagnostics: Singleton { diagnostic: traverse_node_not_realized_diagnostic() }
  }
}
fn map_node_outcome<T, U>(o: Outcome<T>, f: fn(T) -> Outcome<U>) -> Outcome<U> {
  match o {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    RejectedSingular { diagnostic: d } =>
      Rejected { diagnostics: Singleton { diagnostic: d } }
    Produced { value: v } => f(v)
    Accepted { value: v, diagnostics: ds } => match f(v) {
      Rejected { diagnostics: d } => Rejected { diagnostics: d }
      RejectedSingular { diagnostic: d } =>
        Rejected { diagnostics: Singleton { diagnostic: d } }
      Produced { value: u } => Accepted { value: u, diagnostics: ds }
      Accepted { value: u, diagnostics: ds2 } => Accepted { value: u, diagnostics: ds }
    }
  }
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type EdgeDiscipline
  = NoEdges
  | LabeledEdges
  | PositionalEdges
fn connective_edge_discipline(c: Connective) -> EdgeDiscipline {
  match c {
    Atom { identity: _ } => NoEdges
    Conj => LabeledEdges
    Disj => LabeledEdges
    Arrow => PositionalEdges
    Cardinality => PositionalEdges
    Instantiation => PositionalEdges
  }
}
fn edge_is_named(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => true
    Positional => false
  }
}
fn edge_is_positional(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => false
    Positional => true
  }
}

fn all_edges_named(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && edge_is_named(e: e)
  })
}

fn all_edges_positional(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && edge_is_positional(e: e)
  })
}
fn name_occurrences(name: Symbol, children: List<Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Named { name: n } => if n == name { acc + 1 } else { acc }
      Positional => acc
    }
  })
}
fn all_names_distinct(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Named { name: n } => acc && (name_occurrences(name: n, children: children) == 1)
      Positional => acc
    }
  })
}
fn edges_conform(children: List<Edge>, d: EdgeDiscipline) -> Bool {
  match d {
    NoEdges => count(children) == 0
    LabeledEdges =>
      all_edges_named(children: children) && all_names_distinct(children: children)
    PositionalEdges => all_edges_positional(children: children)
  }
}
fn node_locally_well_formed(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: c } =>
      edges_conform(children: n.children, d: connective_edge_discipline(c: c))
    ComputationNode { behavior: _ } => true
  }
}
fn node_well_formed(n: Node) -> Bool {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        node_locally_well_formed(n: n0)
      },
      step: fn(acc, _, child_ok) {
        acc && child_ok
      }
    }
  )
}
// 🟢 predicate dissolution — api-review P5 receipt PR #3274 (SG-0 census N/A for v4-only substrate).
fn is_empty_conj_root(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Conj } => count(n.children) == 0
    _ => false
  }
}
type Path {
  steps: List<Symbol>
}
type Edit {
  at: Path
  replacement: Node
}
type Diff {
  edits: List<Edit>
}
