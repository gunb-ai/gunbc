module v4.std.node
type Symbol
type Hash
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Connective
  = Atom { identity: Symbol }
  | Conj
  | Disj
  | Arrow
  | Cardinality
  | Instantiation
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Behavior
  = Value
  | Transform
  | Branch
  | Loop
  | Bind


// 🟡 gated — feature:coproduct-variant-enumeration — bound target: coproduct reflection / variant-enumeration substrate (docs/design-dissolution-lens.md L1.1) — bind task: src/v4/TASKS.md#t-1-stdnodedag--substrate-root — dissolve-on-arrival: derive Connective/Behavior variant lists from coproduct reflection in std/node.dag; delete these mirrors.
// forbidden: parallel hand-enumerated Connective/Behavior universes outside std/node.dag.
type ConnectiveCoproductVariant
  = ConnectiveAtomArm
  | ConnectiveConjArm
  | ConnectiveDisjArm
  | ConnectiveArrowArm
  | ConnectiveCardinalityArm
  | ConnectiveInstantiationArm


fn connective_coproduct_variant_keys() -> List<ConnectiveCoproductVariant> {
  [
    ConnectiveAtomArm,
    ConnectiveConjArm,
    ConnectiveDisjArm,
    ConnectiveArrowArm,
    ConnectiveCardinalityArm,
    ConnectiveInstantiationArm,
  ]
}


fn connective_from_coproduct_variant(
  variant: ConnectiveCoproductVariant,
  atom_identity: Symbol
) -> Connective {
  match variant {
    ConnectiveAtomArm => Atom { identity: atom_identity }
    ConnectiveConjArm => Conj
    ConnectiveDisjArm => Disj
    ConnectiveArrowArm => Arrow
    ConnectiveCardinalityArm => Cardinality
    ConnectiveInstantiationArm => Instantiation
  }
}


fn behavior_coproduct_variants() -> List<Behavior> {
  [Value, Transform, Branch, Loop, Bind]
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type NodeKind
  = TypeNode { connective: Connective }
  | ComputationNode { behavior: Behavior }
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type EdgeLabel
  = Named { name: Symbol }
  | Positional
type Edge {
  label: EdgeLabel
  target: Node
}
// 🟡 gated — substrate-shape bridge (docs/modeling-discipline.md Practice 2/10) — feature: node-behavior-loop-bound-edge-tag — owner: T-12 LoopBound cost-lens wiring — lane: shared Interval<D> parent for Loop measure facts — dissolve-on-arrival: replace Symbol-tagged Loop bound attachment with structural Loop-bound coordinate owned by the interval/bound substrate; forbidden: new Loop-bound consumers matching raw Named(loop_bound_edge) outside std.node/std.cardinality.
data loop_bound_edge: Symbol = loop_bound_edge
type Node {
  kind: NodeKind
  children: List<Edge>
}
type NodeFold<R> {
  init: fn(Node) -> R
  step: fn(R, Edge, R) -> R
}
fn fold_node<R>(n: Node, algebra: NodeFold<R>) -> R {
  fold(n.children, init: algebra.init(n), f: fn(acc, e) {
    algebra.step(acc, e, fold_node(n: e.target, algebra: algebra))
  })
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type EdgeDiscipline
  = NoEdges
  | LabeledEdges
  | PositionalEdges
  // 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-edge-discipline — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: Loop edge discipline as EdgeDiscipline arm consumed by edges_conform and content_hash canonicalization; forbidden: parallel PositionalEdges classifier for Loop outside loop_behavior_edges_conform.
  | LoopBoundEdges
fn connective_edge_discipline(c: Connective) -> EdgeDiscipline {
  match c {
    Atom { identity: _ } => NoEdges
    Conj => LabeledEdges
    Disj => LabeledEdges
    Arrow => PositionalEdges
    Cardinality => PositionalEdges
    Instantiation => PositionalEdges
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived EdgeLabel Named-variant discriminant projection; forbidden: fold laundering.
fn is_named(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => true
    Positional => false
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: coproduct variant-discriminant predicate substrate — bind node://adhoc-2145db6b-69a — dissolve-on-arrival: substrate-derived EdgeLabel Positional-variant discriminant projection; forbidden: fold laundering.
fn is_positional(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => false
    Positional => true
  }
}

fn all_edges_named(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && is_named(e: e)
  })
}

fn all_edges_positional(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && is_positional(e: e)
  })
}
fn name_occurrences(name: Symbol, children: List<Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Named { name: n } => if n == name { acc + 1 } else { acc }
      Positional => acc
    }
  })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-positional-count — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop positional-child count query; forbidden: parallel ad-hoc Loop arity predicates outside well_formed.
fn loop_positional_child_count(children: List<Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Positional => acc + 1
      Named { name: _ } => acc
    }
  })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-edge-discipline — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop edge-discipline query shared by well_formed and cardinality witnesses; forbidden: parallel ad-hoc Loop edge predicates outside well_formed.
fn loop_body_edges_conform(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Positional => acc
      Named { name: sym } => acc && (sym == loop_bound_edge)
    }
  })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-edge-discipline — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop edge-discipline query shared by well_formed and cardinality witnesses; forbidden: parallel ad-hoc Loop edge predicates outside well_formed.
fn loop_behavior_edges_conform(children: List<Edge>) -> Bool {
  let bound_edges = name_occurrences(name: loop_bound_edge, children: children)
  (bound_edges == 1)
  && loop_body_edges_conform(children: children)
  && (loop_positional_child_count(children: children) >= 1)
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-bound-measure-target — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop loop_bound_edge target projection shared by cardinality witness; forbidden: parallel ad-hoc loop_bound_edge extraction outside well_formed/cardinality.
type LoopMeasureTargetLookup
  = Found { target: Node }
  | Ambiguous
  | Absent
fn loop_bound_measure_target(children: List<Edge>) -> LoopMeasureTargetLookup {
  fold(children, init: Absent, f: fn(acc, e) {
    match e.label {
      Named { name: sym } =>
        if sym == loop_bound_edge {
          match acc {
            Absent => Found { target: e.target }
            Found { target: _ } => Ambiguous
            Ambiguous => Ambiguous
          }
        } else {
          acc
        }
      Positional => acc
    }
  })
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-iteration-fold — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Loop iteration-fold edge query scoped to Loop parents; forbidden: edge-label-only loop_bound_edge skip outside Loop.
fn loop_edge_contributes_to_iteration_fold(parent: Node, e: Edge) -> Bool {
  match parent.kind {
    ComputationNode { behavior: Loop } =>
      match e.label {
        Positional => true
        Named { name: sym } => sym != loop_bound_edge
      }
    _ =>
      match e.label {
        Positional => true
        Named { name: _ } => true
      }
  }
}
fn all_names_distinct(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Named { name: n } => acc && (name_occurrences(name: n, children: children) == 1)
      Positional => acc
    }
  })
}
fn edges_conform(children: List<Edge>, d: EdgeDiscipline) -> Bool {
  match d {
    NoEdges => count(children) == 0
    LabeledEdges =>
      all_edges_named(children: children) && all_names_distinct(children: children)
    PositionalEdges => all_edges_positional(children: children)
    LoopBoundEdges => loop_behavior_edges_conform(children: children)
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-connective-arity-well-formed — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Connective arity query over positional child count; forbidden: parallel ad-hoc arity predicates outside well_formed.
fn connective_edges_conform(children: List<Edge>, c: Connective) -> Bool {
  match c {
    Atom { identity: _ } => edges_conform(children: children, d: NoEdges)
    Conj => edges_conform(children: children, d: LabeledEdges)
    Disj => edges_conform(children: children, d: LabeledEdges)
    Arrow =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Cardinality =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Instantiation =>
      edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-arity-well-formed — bind node://adhoc-c28e191d-684 — dissolve-on-arrival: substrate Behavior arity query over positional child count; forbidden: parallel ad-hoc arity predicates outside well_formed.
fn behavior_edges_conform(children: List<Edge>, b: Behavior) -> Bool {
  match b {
    Value => count(children) == 0
    Transform => edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Branch => edges_conform(children: children, d: PositionalEdges) && (count(children) >= 1)
    Loop => edges_conform(children: children, d: LoopBoundEdges)
    Bind => edges_conform(children: children, d: PositionalEdges) && (count(children) == 3)
  }
}
fn locally_well_formed(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: c } => connective_edges_conform(children: n.children, c: c)
    ComputationNode { behavior: b } => behavior_edges_conform(children: n.children, b: b)
  }
}
fn well_formed(n: Node) -> Bool {
  fold_node(
    n: n,
    algebra: NodeFold {
      init: fn(n0) {
        locally_well_formed(n: n0)
      },
      step: fn(acc, _, child_ok) {
        acc && child_ok
      }
    }
  )
}
// 🟢 predicate dissolution — api-review P5 receipt PR #3274 (SG-0 census N/A for v4-only substrate).
fn is_empty_conj_root(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Conj } => count(n.children) == 0
    _ => false
  }
}
data canonical_tag_atom: Symbol = canonical_tag_atom
data canonical_tag_conj: Symbol = canonical_tag_conj
data canonical_tag_disj: Symbol = canonical_tag_disj
data canonical_tag_arrow: Symbol = canonical_tag_arrow
data canonical_tag_cardinality: Symbol = canonical_tag_cardinality
data canonical_tag_instantiation: Symbol = canonical_tag_instantiation
data canonical_tag_value: Symbol = canonical_tag_value
data canonical_tag_transform: Symbol = canonical_tag_transform
data canonical_tag_branch: Symbol = canonical_tag_branch
data canonical_tag_loop: Symbol = canonical_tag_loop
data canonical_tag_bind: Symbol = canonical_tag_bind
data canonical_tag_type_node: Symbol = canonical_tag_type_node
data canonical_tag_computation_node: Symbol = canonical_tag_computation_node
data canonical_tag_named_edge: Symbol = canonical_tag_named_edge
data canonical_tag_positional_edge: Symbol = canonical_tag_positional_edge


fn behavior_edge_discipline(b: Behavior) -> EdgeDiscipline {
  match b {
    Value => NoEdges
    Transform => PositionalEdges
    Branch => PositionalEdges
    Loop => LoopBoundEdges
    Bind => PositionalEdges
  }
}
fn node_edge_discipline(n: Node) -> EdgeDiscipline {
  match n.kind {
    TypeNode { connective: c } => connective_edge_discipline(c: c)
    ComputationNode { behavior: b } => behavior_edge_discipline(b: b)
  }
}
fn named_edge_sort_key(e: Edge) -> Symbol {
  match e.label {
    Named { name: sym } => sym
    Positional => canonical_tag_positional_edge
  }
}
// 🟡 gated — predicate-dissolution interim (docs/modeling-discipline.md Practice 10) — feature: node-behavior-loop-content-hash-canonicalization — bind B1-CANON content_hash — dissolve-on-arrival: Loop/LabeledEdges child reorder scoped to content_hash merkle fold; forbidden: parallel ad-hoc loop_bound_edge placement canonicalization outside this surface.
fn loop_body_edges_for_content_hash(children: List<Edge>) -> List<Edge> {
  filter(children, e => match e.label { Positional => true, Named { name: _ } => false })
}
fn loop_bound_edges_for_content_hash(children: List<Edge>) -> List<Edge> {
  filter(children, e => match e.label {
    Named { name: sym } => sym == loop_bound_edge
    Positional => false
  })
}
fn loop_other_named_edges_for_content_hash(children: List<Edge>) -> List<Edge> {
  sort_by(
    filter(children, e => match e.label {
      Named { name: sym } => sym != loop_bound_edge
      Positional => false
    }),
    e => named_edge_sort_key(e: e)
  )
}
fn canonicalize_loop_children_for_content_hash(children: List<Edge>) -> List<Edge> {
  concat(
    loop_body_edges_for_content_hash(children: children),
    concat(
      loop_other_named_edges_for_content_hash(children: children),
      loop_bound_edges_for_content_hash(children: children)
    )
  )
}
fn canonicalize_node_for_content_hash(n: Node) -> Node {
  match node_edge_discipline(n: n) {
    LabeledEdges =>
      Node {
        kind: n.kind,
        children: sort_by(n.children, e => named_edge_sort_key(e: e))
      }
    NoEdges => n
    PositionalEdges => n
    LoopBoundEdges =>
      Node {
        kind: n.kind,
        children: canonicalize_loop_children_for_content_hash(children: n.children)
      }
  }
}
// 🟢 TERMINAL — B1 merkle_fold: canonicalize_node_for_content_hash at every recursive step (plain fold_node would skip nested LabeledEdges/Loop reorder).
fn fold_node_content_hash<R>(n: Node, algebra: NodeFold<R>) -> R {
  let n = canonicalize_node_for_content_hash(n: n)
  fold(n.children, init: algebra.init(n), f: fn(acc, e) {
    algebra.step(acc, e, fold_node_content_hash(n: e.target, algebra: algebra))
  })
}


fn canonical_hash_of_connective(c: Connective) -> Hash {
  match c {
    Atom { identity: sym } =>
      hash_combine(
        a: atom_identity_hash(s: canonical_tag_atom),
        b: atom_identity_hash(s: sym)
      )
    Conj => atom_identity_hash(s: canonical_tag_conj)
    Disj => atom_identity_hash(s: canonical_tag_disj)
    Arrow => atom_identity_hash(s: canonical_tag_arrow)
    Cardinality => atom_identity_hash(s: canonical_tag_cardinality)
    Instantiation => atom_identity_hash(s: canonical_tag_instantiation)
  }
}


fn canonical_hash_of_behavior(b: Behavior) -> Hash {
  match b {
    Value => atom_identity_hash(s: canonical_tag_value)
    Transform => atom_identity_hash(s: canonical_tag_transform)
    Branch => atom_identity_hash(s: canonical_tag_branch)
    Loop => atom_identity_hash(s: canonical_tag_loop)
    Bind => atom_identity_hash(s: canonical_tag_bind)
  }
}


fn canonical_hash_of_node_kind(kind: NodeKind) -> Hash {
  match kind {
    TypeNode { connective: c } =>
      hash_combine(
        a: atom_identity_hash(s: canonical_tag_type_node),
        b: canonical_hash_of_connective(c: c)
      )
    ComputationNode { behavior: b } =>
      hash_combine(
        a: atom_identity_hash(s: canonical_tag_computation_node),
        b: canonical_hash_of_behavior(b: b)
      )
  }
}


fn canonical_hash_of_edge_label(label: EdgeLabel) -> Hash {
  match label {
    Named { name: sym } =>
      hash_combine(
        a: atom_identity_hash(s: canonical_tag_named_edge),
        b: atom_identity_hash(s: sym)
      )
    Positional => atom_identity_hash(s: canonical_tag_positional_edge)
  }
}


// B1 primitive re-export: v2 runtime hash_combine is available in-module but not importable cross-module until wrapped.
fn combine_hash(a: Hash, b: Hash) -> Hash {
  hash_combine(a: a, b: b)
}


data canonical_tag_scalar_int_zero: Symbol = canonical_tag_scalar_int_zero
data canonical_tag_scalar_int_neg: Symbol = canonical_tag_scalar_int_neg
data canonical_tag_scalar_int_pos: Symbol = canonical_tag_scalar_int_pos
data canonical_tag_scalar_int_nibble_zero: Symbol = canonical_tag_scalar_int_nibble_zero
data canonical_tag_scalar_int_nibble_succ: Symbol = canonical_tag_scalar_int_nibble_succ
data canonical_tag_scalar_int_byte: Symbol = canonical_tag_scalar_int_byte


fn scalar_int_nibble_digest(n: Int) -> Hash {
  if n == 0 {
    atom_identity_hash(s: canonical_tag_scalar_int_nibble_zero)
  } else {
    combine_hash(
      a: atom_identity_hash(s: canonical_tag_scalar_int_nibble_succ),
      b: scalar_int_nibble_digest(n: n - 1)
    )
  }
}


fn scalar_int_byte_digest(b: Int) -> Hash {
  combine_hash(
    a: atom_identity_hash(s: canonical_tag_scalar_int_byte),
    b: combine_hash(
      a: scalar_int_nibble_digest(n: b - (b / 16) * 16),
      b: scalar_int_nibble_digest(n: b / 16)
    )
  )
}


fn scalar_int_le_digits_digest(i: Int) -> Hash {
  if i == 0 {
    atom_identity_hash(s: canonical_tag_scalar_int_zero)
  } else {
    combine_hash(
      a: scalar_int_byte_digest(b: i - (i / 256) * 256),
      b: scalar_int_le_digits_digest(i: i / 256)
    )
  }
}


// O(log |i|) scalar Int digest via base-256 little-endian bytes (not Peano unary on |i|).
fn scalar_int_hash(i: Int) -> Hash {
  if i < 0 {
    combine_hash(
      a: atom_identity_hash(s: canonical_tag_scalar_int_neg),
      b: scalar_int_hash(i: 0 - i)
    )
  } else {
    combine_hash(
      a: atom_identity_hash(s: canonical_tag_scalar_int_pos),
      b: scalar_int_le_digits_digest(i: i)
    )
  }
}


// Char codepoints share the scalar Int encoding (Unicode scalar values).
fn scalar_char_hash(c: Char) -> Hash {
  scalar_int_hash(i: c)
}


// Canonical multiset/bag digest: sort element hashes, then order-sensitive combine_hash fold.
fn bag_hash_digest(empty: Hash, xs: List<Hash>) -> Hash {
  fold(
    sort_by(xs, h => h),
    init: empty,
    f: fn(acc, h) {
      combine_hash(a: acc, b: h)
    }
  )
}


// 🟢 TERMINAL — B1 merkle_fold content_hash over canonical Node form; LabeledEdges children sorted by label before fold (Conj/Disj order-independent); Loop positional body edges preserve list order with loop_bound_edge canonicalized after body; other positional children preserve list order; Hash carrier enforced at v2 primitive boundary (16-hex digest, not arbitrary String).
fn content_hash(n: Node) -> Hash {
  fold_node_content_hash(
    n: n,
    algebra: NodeFold {
      init: fn(n0) { canonical_hash_of_node_kind(kind: n0.kind) },
      step: fn(acc, e, child_hash) {
        hash_combine(
          a: hash_combine(a: acc, b: canonical_hash_of_edge_label(label: e.label)),
          b: child_hash
        )
      }
    }
  )
}


type Path {
  steps: List<Symbol>
}
type Edit {
  at: Path
  replacement: Node
}
type Diff {
  edits: List<Edit>
}
