// ---------------------------------------------------------------------------
// Structural catamorphism over `Node` (derived-ops registry row 1 —
// docs/modeling-discipline.md §10; dissolution P5 / #3243 §1.1).
//
// `fold_node` folds every `Edge.target` before combining at the parent:
// child results are carried as `FoldedEdge<A>` (edge label + folded child).
// Child order matches `n.children` (Freemonoid Cons head-to-tail order).
//
// Supply the F-algebra as `algebra` (or bundle it in `NodeCataAlgebra` and
// call `fold_node_cata`). Use `fold_node(..., algebra: alg.reduce)` to thread
// a record field; do not write `alg.reduce(...)` — call-on-field through a
// parameter is not lowered (Prereq-X1.b).
// ---------------------------------------------------------------------------

type FoldedEdge<A> {
  label: EdgeLabel
  child: A
}

type NodeCataAlgebra<A> {
  reduce: fn(NodeKind, List<FoldedEdge<A>>) -> A
}

fn fold_list_right<T, U>(list: List<T>, init: U, f: fn(T, U) -> U) -> U {
  match list {
    Empty => init
    Cons { head: h, tail: t } => f(h, fold_list_right(list: t, init: init, f: f))
  }
}

fn fold_node<A>(n: Node, algebra: fn(NodeKind, List<FoldedEdge<A>>) -> A) -> A {
  let folded_edges = fold_list_right(
    list: n.children,
    init: Empty,
    f: fn(e: Edge, acc: List<FoldedEdge<A>>) {
      Cons {
        head: FoldedEdge { label: e.label, child: fold_node(n: e.target, algebra: algebra) },
        tail: acc
      }
    }
  )
  algebra(n.kind, folded_edges)
}

fn fold_node_cata<A>(n: Node, alg: NodeCataAlgebra<A>) -> A {
  fold_node(n: n, algebra: alg.reduce)
}

