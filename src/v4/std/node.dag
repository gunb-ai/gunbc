// src/v4/std/node.dag
// Scope: v4 substrate root for type and computation nodes.
// Anchor: THESIS.md "Substrate shape" + MODELING.md.
// Owns: Symbol, Hash, Connective, Behavior, NodeKind, EdgeLabel, Edge, Node, FoldedEdge<T>, NodeFoldAlgebra<T>, fold_node, EdgeDiscipline, connective_edge_discipline, edge_is_named, edge_is_positional, all_edges_named, all_edges_positional, name_occurrences, all_names_distinct, edges_conform, node_locally_well_formed, node_well_formed, is_empty_conj_root, Path, Edit, Diff.
// Consumes: none.
// Status: T-1 modeled; substrate-extension rule in src/v4/STRUCTURE.md.


module v4.std.node
type Symbol
type Hash
// 🟢 coproduct dissolution — DECISIONS.md classification ledger: Connective.
type Connective
  = Atom { identity: Symbol }
  | Conj
  | Disj
  | Arrow
  | Cardinality
  | Instantiation
// 🟢 coproduct dissolution — DECISIONS.md classification ledger: Behavior.
type Behavior
  = Value
  | Transform
  | Branch
  | Loop
  | Bind
// 🟢 coproduct dissolution — DECISIONS.md classification ledger: NodeKind.
type NodeKind
  = TypeNode { connective: Connective }
  | ComputationNode { behavior: Behavior }
// 🟢 coproduct dissolution — DECISIONS.md classification ledger: EdgeLabel.
type EdgeLabel
  = Named { name: Symbol }
  | Positional
type Edge {
  label: EdgeLabel
  target: Node
}
type Node {
  kind: NodeKind
  children: List<Edge>
}
type FoldedEdge<T> {
  label: EdgeLabel
  target: T
}
type NodeFoldAlgebra<T> {
  reduce: fn(NodeKind, List<FoldedEdge<T>>) -> T
}
fn fold_node<T>(n: Node, algebra: NodeFoldAlgebra<T>) -> T {
  let folded_children = fold(n.children, init: [], f: fn(acc, e) {
    list_push(acc, FoldedEdge {
      label: e.label,
      target: fold_node(n: e.target, algebra: algebra)
    })
  })
  algebra.reduce(n.kind, folded_children)
}
// 🟢 coproduct dissolution — DECISIONS.md classification ledger: EdgeDiscipline.
type EdgeDiscipline
  = NoEdges
  | LabeledEdges
  | PositionalEdges
fn connective_edge_discipline(c: Connective) -> EdgeDiscipline {
  match c {
    Atom { identity: _ } => NoEdges
    Conj => LabeledEdges
    Disj => LabeledEdges
    Arrow => PositionalEdges
    Cardinality => PositionalEdges
    Instantiation => PositionalEdges
  }
}
fn edge_is_named(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => true
    Positional => false
  }
}
fn edge_is_positional(e: Edge) -> Bool {
  match e.label {
    Named { name: _ } => false
    Positional => true
  }
}

fn all_edges_named(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && edge_is_named(e: e)
  })
}

fn all_edges_positional(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && edge_is_positional(e: e)
  })
}
fn name_occurrences(name: Symbol, children: List<Edge>) -> Int {
  fold(children, init: 0, f: fn(acc, e) {
    match e.label {
      Named { name: n } => if n == name { acc + 1 } else { acc }
      Positional => acc
    }
  })
}
fn all_names_distinct(children: List<Edge>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    match e.label {
      Named { name: n } => acc && (name_occurrences(name: n, children: children) == 1)
      Positional => acc
    }
  })
}
fn edges_conform(children: List<Edge>, d: EdgeDiscipline) -> Bool {
  match d {
    NoEdges => count(children) == 0
    LabeledEdges =>
      all_edges_named(children: children) && all_names_distinct(children: children)
    PositionalEdges => all_edges_positional(children: children)
  }
}
fn node_locally_well_formed(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: c } =>
      edges_conform(children: n.children, d: connective_edge_discipline(c: c))
    ComputationNode { behavior: _ } => true
  }
}
fn folded_children_well_formed(children: List<FoldedEdge<Bool>>) -> Bool {
  fold(children, init: true, f: fn(acc, e) {
    acc && e.target
  })
}
fn node_well_formed_reduce(kind: NodeKind, children: List<FoldedEdge<Bool>>) -> Bool {
  let local = match kind {
    TypeNode { connective: c } =>
      edges_conform(
        children: fold(children, init: [], f: fn(acc, e) {
          list_push(acc, Edge {
            label: e.label,
            target: Node {
              kind: kind,
              children: []
            }
          })
        }),
        d: connective_edge_discipline(c: c)
      )
    ComputationNode { behavior: _ } => true
  }
  local && folded_children_well_formed(children: children)
}
data node_well_formed_algebra: NodeFoldAlgebra<Bool> = {
  reduce: node_well_formed_reduce
}
fn node_well_formed(n: Node) -> Bool {
  fold_node(n: n, algebra: node_well_formed_algebra)
}
// 🟢 predicate dissolution — DECISIONS.md §CP-1b item 12; docs/audit/dissolution-inventory.md §1.0 R1 (PR #3284).
fn is_empty_conj_root(n: Node) -> Bool {
  match n.kind {
    TypeNode { connective: Conj } => count(n.children) == 0
    _ => false
  }
}
type Path {
  steps: List<Symbol>
}
type Edit {
  at: Path
  replacement: Node
}
type Diff {
  edits: List<Edit>
}
