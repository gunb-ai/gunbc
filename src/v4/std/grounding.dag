fn per_language_fact_bundle_subject_axis_key(
  subject_carrier: Node,
  target: TargetModel,
  fact_axis: ModelCorePrimitiveFactAxis
) -> PerLanguageFactBundleKey {
  PerLanguageFactBundleKey {
    subject_carrier: subject_carrier,
    target: target,
    fact_axis: fact_axis
  }
}


fn per_language_fact_bundle_insert_subject_axis(
  registry: PerLanguageFactBundleRegistry,
  spec_facts: Map<Symbol, Node>,
  subject_carrier: Node,
  target: TargetModel,
  fact_axis: ModelCorePrimitiveFactAxis
) -> Map<Symbol, Node> {
  match map_get(
    registry.by_key,
    per_language_fact_bundle_subject_axis_key(
      subject_carrier: subject_carrier,
      target: target,
      fact_axis: fact_axis
    )
  ) {
    Some { value: fact_value } =>
      map_insert(
        m: spec_facts,
        key: model_core_primitive_fact_axis_symbol(axis: fact_axis),
        value: fact_value
      )
    None =>
      spec_facts
  }
}


fn per_language_fact_bundle_spec_facts_for_subject(
  registry: PerLanguageFactBundleRegistry,
  subject_carrier: Node,
  target: TargetModel
) -> Map<Symbol, Node> {
  per_language_fact_bundle_insert_subject_axis(
    registry: registry,
    spec_facts: per_language_fact_bundle_insert_subject_axis(
      registry: registry,
      spec_facts: per_language_fact_bundle_insert_subject_axis(
        registry: registry,
        spec_facts: per_language_fact_bundle_insert_subject_axis(
          registry: registry,
          spec_facts: per_language_fact_bundle_insert_subject_axis(
            registry: registry,
            spec_facts: per_language_fact_bundle_insert_subject_axis(
              registry: registry,
              spec_facts: empty_map(),
              subject_carrier: subject_carrier,
              target: target,
              fact_axis: ModelCoreFactAxisWidth {}
            ),
            subject_carrier: subject_carrier,
            target: target,
            fact_axis: ModelCoreFactAxisSignedness {}
          ),
          subject_carrier: subject_carrier,
          target: target,
          fact_axis: ModelCoreFactAxisRange {}
        ),
        subject_carrier: subject_carrier,
        target: target,
        fact_axis: ModelCoreFactAxisEncoding {}
      ),
      subject_carrier: subject_carrier,
      target: target,
      fact_axis: ModelCoreFactAxisSurfaceSpelling {}
    ),
    subject_carrier: subject_carrier,
    target: target,
    fact_axis: ModelCoreFactAxisOverflowDisposition {}
  )
}


// G.1 / model_core boundary: project all rows for one subject × target into one PrimitiveFactBundle.
fn primitive_fact_bundle_for_subject(
  registry: PerLanguageFactBundleRegistry,
  subject_carrier: Node,
  target: TargetModel
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: subject_carrier,
    spec_facts: per_language_fact_bundle_spec_facts_for_subject(
      registry: registry,
      subject_carrier: subject_carrier,
      target: target
    )
  }
}


