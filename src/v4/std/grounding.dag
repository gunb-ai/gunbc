// src/v4/std/grounding.dag
// Scope: Branch G.0 — grounding schema / authority (W2.2).
// Status: design closure substrate — indexes per-language fact bundles, hollow-alias bar,
//   SG-1 / SG-1b / SG-2 / SG-5 evidence shapes, and per-target receipt contract for Branch C/G consumers.
// Anchor: Wave-2 plan Branch G.0 (G0.1–G0.4); INVARIANTS P1; docs/modeling-discipline.md Practice 8.


module v4.std.grounding


import v4.std.algebra { fold_list, list_snoc_item }
import v4.std.collection { List, Map, empty_map, map_insert }
import v4.std.diagnostic {
  Diagnostic,
  Outcome,
  Unavailable,
  UserInputBoundary,
  outcome_accepted,
  outcome_rejected,
  port_locus
}
import v4.std.host_run { EmitHostRunReceipt }
import v4.std.logic { Bool }
import v4.std.model_core {
  ModelCorePrimitiveFactAxis,
  PrimitiveFactBundle,
  model_core_primitive_fact_axis_symbol
}
import v4.std.node { Node, Symbol }
import v4.std.target_model { FunctionBoundarySite, TargetModel }


// --- G0.1: per-language fact bundle schema (subject_carrier × target × fact_axis) ---

// P2: substrate carrier + TargetModel (language identity) + closed model_core fact_axis coproduct
// (target_model catalog axes widen PerLanguageFactBundleKey in G.1 — no parallel Symbol taxonomy).
type PerLanguageFactBundleKey {
  subject_carrier: Node
  target: TargetModel
  fact_axis: ModelCorePrimitiveFactAxis
}


// P2: fact payload for key.fact_axis only — no Map that can disagree with the keyed axis.
type PerLanguageFactBundleEntry {
  key: PerLanguageFactBundleKey
  fact_value: Node
}


// P2: keyed registry rejects duplicate PerLanguageFactBundleKey rows, while entries preserve
// complete subject × target bundles for model_core projection.
type PerLanguageFactBundleRegistry {
  by_key: Map<PerLanguageFactBundleKey, Node>
  entries: List<PerLanguageFactBundleEntry>
}


fn empty_per_language_fact_bundle_registry() -> PerLanguageFactBundleRegistry {
  PerLanguageFactBundleRegistry { by_key: empty_map(), entries: [] }
}


data per_language_fact_bundle_duplicate_key_reason: Symbol = per_language_fact_bundle_duplicate_key_reason


fn per_language_fact_bundle_duplicate_key_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: per_language_fact_bundle_duplicate_key_reason,
    at: port_locus(port: per_language_fact_bundle_duplicate_key_reason),
    correction: Unavailable { reason: UserInputBoundary }
  }
}


// 🟡 gated — bootstrap-limitation interim — feature:B-LOOKUP-1 — map_get(Option<V>);
// dissolve-on: bootstrap Witness<V> generic dispatch for Map.lookup (substrate Witness at
// v4.std.collection:54); site: insert_per_language_fact_bundle_entry duplicate-key gate.
fn insert_per_language_fact_bundle_entry(
  registry: PerLanguageFactBundleRegistry,
  key: PerLanguageFactBundleKey,
  fact_value: Node
) -> Outcome<PerLanguageFactBundleRegistry> {
  match map_get(registry.by_key, key) {
    Some { value: _ } =>
      outcome_rejected(d: per_language_fact_bundle_duplicate_key_diagnostic())
    None =>
      outcome_accepted(
        value: PerLanguageFactBundleRegistry {
          by_key: map_insert(m: registry.by_key, key: key, value: fact_value),
          entries: list_snoc_item(
            xs: registry.entries,
            item: PerLanguageFactBundleEntry { key: key, fact_value: fact_value }
          )
        }
      )
  }
}


fn per_language_fact_bundle_entry_matches_subject(
  entry: PerLanguageFactBundleEntry,
  subject_carrier: Node,
  target: TargetModel
) -> Bool {
  (entry.key.subject_carrier == subject_carrier) && (entry.key.target == target)
}


fn per_language_fact_bundle_spec_facts_for_subject(
  registry: PerLanguageFactBundleRegistry,
  subject_carrier: Node,
  target: TargetModel
) -> Map<Symbol, Node> {
  fold_list(
    xs: registry.entries,
    empty: empty_map(),
    cons: fn(acc, entry) {
      if per_language_fact_bundle_entry_matches_subject(
        entry: entry,
        subject_carrier: subject_carrier,
        target: target
      ) {
        map_insert(
          m: acc,
          key: model_core_primitive_fact_axis_symbol(axis: entry.key.fact_axis),
          value: entry.fact_value
        )
      } else {
        acc
      }
    }
  )
}


// G.1 / model_core boundary: project all rows for one subject × target into one PrimitiveFactBundle.
fn primitive_fact_bundle_for_subject(
  registry: PerLanguageFactBundleRegistry,
  subject_carrier: Node,
  target: TargetModel
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: subject_carrier,
    spec_facts: per_language_fact_bundle_spec_facts_for_subject(
      registry: registry,
      subject_carrier: subject_carrier,
      target: target
    )
  }
}


// --- G0.2: no hollow aliases governance bar ---

// 🟢 terminal — G.0 hollow-alias governance posture (T-30 enforces via v4.lens.fact_density).
// Closed nullary carrier: requires named spec facts and permits kernel-ambient atoms — no free
// Bool configuration that could represent requires_named_fact_fields=false (P2 / illegal states).
// `{}` on single-arm coproduct only (v2 export; rust_leaf_model_claim.dag).
type HollowAliasGovernanceBar
  = HollowAliasRequiresNamedFieldsAndKernelAmbient {}


fn hollow_alias_governance_bar() -> HollowAliasGovernanceBar {
  HollowAliasRequiresNamedFieldsAndKernelAmbient {}
}


// --- G0.3: SG-1 / SG-1b / SG-2 / SG-5 evidence (single coproduct; variant arm pins target_model edge family) ---

// 🟢 coproduct dissolution — terminal G.0 evidence-family tag: one arm per closed SG-1 / SG-1b / SG-2 / SG-5
// target_model catalog row kind (variant arm is the authority).
// P2: payload carries canonical target_model lookup coordinates per family — not a shared opaque Node:
//   Sg1/Sg2/Sg5: source_carrier Node key; Sg1b: source_carrier × boundary_site (per
//   target_function_signature_realization_lookup_in_catalog_node in target_model.dag).
type GroundingEvidenceSchema
  = Sg1Evidence { source_carrier: Node }
  | Sg1bEvidence { source_carrier: Node, boundary_site: FunctionBoundarySite }
  | Sg2Evidence { source_carrier: Node }
  | Sg5Evidence { source_carrier: Node }


// --- G0.4: per-target receipt schema (Branch C/G consumer contract; parallels A.3b.3) ---

// Host-boundary receipt: TargetModel authority lives on EmitHostRunReceipt.target only (P2).
// In-process T-38 eval runs project TestClaimRun at v4.compiler.eval — this schema is the
// cross-target grounding receipt for host verification and leaf-model runners.
type PerTargetGroundingReceipt {
  host_run: EmitHostRunReceipt
}


fn per_target_grounding_receipt_target(receipt: PerTargetGroundingReceipt) -> TargetModel {
  receipt.host_run.target
}
