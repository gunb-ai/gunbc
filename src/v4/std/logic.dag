module v4.std.logic


import v4.std.algebra { BooleanAlgebra, BoundedLattice, Lattice }
// 🟢 coproduct dissolution — DECISIONS.md De-Prosed Substrate Receipts: Bool.
type Bool = True | False
data bool_boolean_algebra: BooleanAlgebra<Bool> = BooleanAlgebra {
  bounded_lattice: BoundedLattice {
    lattice: Lattice {
      meet: fn(a, b) {
        match a {
          True => b
          False => False
        }
      },
      join: fn(a, b) {
        match a {
          True => True
          False => b
        }
      }
    },
    top: True,
    bottom: False
  },
  complement: fn(a) {
    match a {
      True => False
      False => True
    }
  }
}
