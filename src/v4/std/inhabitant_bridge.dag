module v4.std.inhabitant_bridge

import v4.std.node { Symbol }

// Structural field label: labeled edge on PrimitiveFacts carrying the std_projection atom.
data facts_field_std_projection: Symbol = facts_field_std_projection

// Canonical bridge key VALUE: MVP1 additive int/number slice (python int, ts number, go-int64).
data std_projection_additive_numeric: Symbol = std_projection_additive_numeric
