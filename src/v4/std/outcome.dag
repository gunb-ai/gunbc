// src/v4/std/outcome.dag
// Scope: Outcome traverse combinators + diagnostic policy carriers + traverse law witnesses.
// Owns: DiagnosticAccumulationPolicy, StageDiagnosticPolicy, NodeOutcomeFold, traverse_node, sequence_node, map_node_outcome, traverse_outcome, map_outcome, bind_outcome, append_non_empty, TraverseIdentityLaw, TraverseCompositionLaw, TraverseFailureMonotonicityLaw.
// Consumes: std diagnostic, std node, std collection, std algebra.
// Status: W-TraverseOutcome substrate (design-v4-compiler-homomorphism Ratified Q4 companion).


module v4.std.outcome


import v4.std.algebra { Empty, Cons }
import v4.std.collection { List }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  More,
  NonEmptyDiagnostics,
  One,
  Outcome,
  PortLocus,
  Produced,
  Rejected,
  Unavailable
}
import v4.std.node { Edge, Node, Symbol }


// 🟡 coproduct dissolution — W-TRAVERSE-OUTCOME-DIAGNOSTIC-POLICY.
// Trigger: per-stage policy drives accumulate vs short-circuit in traverse_node fill.
type DiagnosticAccumulationPolicy
  = Accumulate
  | ShortCircuit


type StageDiagnosticPolicy {
  accumulation: DiagnosticAccumulationPolicy
}


data traverse_identity_law: TraverseIdentityLaw = traverse_identity_law


data traverse_composition_law: TraverseCompositionLaw = traverse_composition_law


data traverse_failure_monotonicity_law: TraverseFailureMonotonicityLaw = traverse_failure_monotonicity_law


type TraverseIdentityLaw {}


type TraverseCompositionLaw {}


type TraverseFailureMonotonicityLaw {}


fn append_non_empty(front: NonEmptyDiagnostics, back: NonEmptyDiagnostics) -> NonEmptyDiagnostics {
  match front {
    One { diagnostic: d } => match back {
      One { diagnostic: d2 } => More { head: d, tail: One { diagnostic: d2 } }
      More { head: h, tail: t } => More { head: d, tail: More { head: h, tail: t } }
    }
    More { head: h, tail: t } => More { head: h, tail: append_non_empty(front: t, back: back) }
  }
}


type NodeOutcomeFold<R> {
  policy: StageDiagnosticPolicy
  init: fn(Node) -> Outcome<R>
  step: fn(Outcome<R>, Edge, Node) -> Outcome<R>
}


data traverse_node_not_realized: Symbol = traverse_node_not_realized


fn traverse_node_not_realized_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: traverse_node_not_realized,
    at: PortLocus { port: traverse_node_not_realized },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn traverse_node<R>(n: Node, algebra: NodeOutcomeFold<R>) -> Outcome<R> {
  Rejected { diagnostic: traverse_node_not_realized_diagnostic() }
}


fn sequence_node<R>(nodes: List<Node>, algebra: NodeOutcomeFold<R>) -> Outcome<List<R>> {
  Rejected { diagnostic: traverse_node_not_realized_diagnostic() }
}


fn map_node_outcome<T, U>(o: Outcome<T>, f: fn(T) -> Outcome<U>) -> Outcome<U> {
  match o {
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
    Produced { value: v } => f(v)
  }
}


fn traverse_outcome<T, U>(xs: List<T>, f: fn(T) -> Outcome<U>) -> Outcome<List<U>> {
  match xs {
    Empty => Produced { value: Empty }
    Cons { head: h, tail: t } => match f(h) {
      Rejected { diagnostic: d } => Rejected { diagnostic: d }
      Produced { value: u } =>
        match traverse_outcome(xs: t, f: f) {
          Rejected { diagnostic: d } => Rejected { diagnostic: d }
          Produced { value: rest } => Produced { value: Cons { head: u, tail: rest } }
        }
    }
  }
}


fn map_outcome<T, U>(o: Outcome<T>, f: fn(T) -> U) -> Outcome<U> {
  match o {
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
    Produced { value: v } => Produced { value: f(v) }
  }
}


fn bind_outcome<T, U>(o: Outcome<T>, f: fn(T) -> Outcome<U>) -> Outcome<U> {
  match o {
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
    Produced { value: v } => f(v)
  }
}
