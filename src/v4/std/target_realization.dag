// src/v4/std/target_realization.dag
// Scope: language-parametric target realization carriers (SG-1 atom, SG-2 type-expression, SG-3 collection).
// Status: SG-1 — TargetAtomRealization canonical home; Rust Symbol/Bool/Char rows in extdeps/languages/rust.dag.
// Anchor: docs/planning/v4-correctness-ladder-2026-05-30.md §10.1; docs/design-target-realization-canonical-home.md §1–§2.

module v4.std.target_realization

import v4.std.algebra { Empty, fold_list, list_snoc_item }
import v4.std.collection { List, Optional, optional_absent }
import v4.std.logic { Bool }
import v4.std.node { Atom, Conj, Edge, Named, Node, Positional, Symbol, TypeNode, content_hash }
import v4.std.target_model { TargetModel }
import v4.std.text { Char, String }
import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  node_locus,
  outcome_rejected
}

// --- SG-2 substrate (minimal atom arm for SG-1; connective arms owned by SG-2 workers) ---

type TargetTypeExpression
  = TargetTypeAlias { spelling: String }

type TargetAtomTypeShape {
  type_spelling: String
}

// 🟡 scaffold — SG-2 owns full per-connective arms; atom arm is live for SG-1 cross-section invariant.
type TargetTypeExpressionProjection {
  target_model: TargetModel
  atom_form: TargetAtomTypeShape
}

// --- SG-1 atom realization vocabulary ---

type SourceAtomValue
  = SourceSymbol { identity: Symbol }
  | SourceBool { value: Bool }
  | SourceChar { codepoint: Char }

type TargetValueExpression
  = TargetExprSymbolIdentity { identity: Symbol }
  | TargetExprSymbolToOwnedString { identity: Symbol }
  | TargetExprBoolLiteral { value: Bool }
  | TargetExprCharUnicodeScalar { codepoint: Char }

// Bidirectional templates: emission and ingestion share the same row (§10.6).
type TargetValueTemplate
  = ValueSymbolIdentityPassthrough
  | ValueSymbolToOwnedString
  | ValueBoolLiteral
  | ValueCharUnicodeScalar

type TargetConstructorTemplate
  = ConstructorAbsent

type TargetAtomRealization {
  source_carrier: Node
  target_model: TargetModel
  type_form: TargetTypeExpression
  value_form: TargetValueTemplate
  constructor_form: Optional<TargetConstructorTemplate>
  display_name: Symbol
}

data target_atom_realization_lookup_miss: Symbol = target_atom_realization_lookup_miss
data target_atom_realization_lookup_ambiguous: Symbol = target_atom_realization_lookup_ambiguous
data target_atom_realization_field_source_carrier: Symbol = target_atom_realization_field_source_carrier
data target_atom_realization_field_type_form: Symbol = target_atom_realization_field_type_form
data target_atom_realization_field_value_form: Symbol = target_atom_realization_field_value_form
data target_atom_realization_field_display_name: Symbol = target_atom_realization_field_display_name
data target_type_alias_field_spelling: Symbol = target_type_alias_field_spelling
data target_value_template_symbol_identity_passthrough: Symbol = target_value_template_symbol_identity_passthrough
data target_value_template_symbol_to_owned_string: Symbol = target_value_template_symbol_to_owned_string
data target_value_template_bool_literal: Symbol = target_value_template_bool_literal
data target_value_template_char_unicode_scalar: Symbol = target_value_template_char_unicode_scalar

// Kernel-ambient type carriers (Node-keyed authority; not spelling-keyed tables).
data symbol_kernel_type_atom: Symbol = symbol_kernel_type_atom
data char_kernel_type_atom: Symbol = char_kernel_type_atom

fn symbol_kernel_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: symbol_kernel_type_atom } },
    children: []
  }
}

fn char_kernel_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: char_kernel_type_atom } },
    children: []
  }
}

fn target_type_expression_spelling(form: TargetTypeExpression) -> String {
  match form {
    TargetTypeAlias { spelling: s } => s
  }
}

fn target_value_template_apply(
  template: TargetValueTemplate,
  value: SourceAtomValue
) -> TargetValueExpression {
  match template {
    ValueSymbolIdentityPassthrough =>
      match value {
        SourceSymbol { identity: id } => TargetExprSymbolIdentity { identity: id }
        _ => target_value_template_mismatch()
      }
    ValueSymbolToOwnedString =>
      match value {
        SourceSymbol { identity: id } => TargetExprSymbolToOwnedString { identity: id }
        _ => target_value_template_mismatch()
      }
    ValueBoolLiteral =>
      match value {
        SourceBool { value: b } => TargetExprBoolLiteral { value: b }
        _ => target_value_template_mismatch()
      }
    ValueCharUnicodeScalar =>
      match value {
        SourceChar { codepoint: c } => TargetExprCharUnicodeScalar { codepoint: c }
        _ => target_value_template_mismatch()
      }
  }
}

fn target_value_template_mismatch() -> TargetValueExpression {
  TargetExprSymbolIdentity { identity: target_atom_realization_lookup_miss }
}

type TargetAtomRealizationLookup
  = TargetAtomRealizationMissing
  | TargetAtomRealizationUnique { row: TargetAtomRealization }
  | TargetAtomRealizationAmbiguous

fn target_atom_realization_lookup_step(
  acc: TargetAtomRealizationLookup,
  row: TargetAtomRealization,
  source_carrier: Node
) -> TargetAtomRealizationLookup {
  if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
    match acc {
      TargetAtomRealizationMissing =>
        TargetAtomRealizationUnique { row: row }
      TargetAtomRealizationUnique { row: _ } => TargetAtomRealizationAmbiguous
      TargetAtomRealizationAmbiguous => TargetAtomRealizationAmbiguous
    }
  } else {
    acc
  }
}

fn target_atom_realization_lookup_in_catalog(
  catalog: List<TargetAtomRealization>,
  source_carrier: Node
) -> Outcome<TargetAtomRealization> {
  match fold_list(
    xs: catalog,
    empty: TargetAtomRealizationMissing,
    cons: fn(acc, row) {
      target_atom_realization_lookup_step(
        acc: acc,
        row: row,
        source_carrier: source_carrier
      )
    }
  ) {
    TargetAtomRealizationMissing =>
      outcome_rejected(target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
    TargetAtomRealizationUnique { row: row } =>
      Accepted { value: row, diagnostics: None }
    TargetAtomRealizationAmbiguous =>
      outcome_rejected(target_atom_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
  }
}

fn target_atom_realization_lookup_miss_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: target_atom_realization_lookup_miss,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_realization_lookup_ambiguous_diagnostic(source_carrier: Node) -> Diagnostic {
  Diagnostic {
    reason: target_atom_realization_lookup_ambiguous,
    at: node_locus(node: source_carrier),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_atom_type_spelling(row: TargetAtomRealization) -> String {
  target_type_expression_spelling(form: row.type_form)
}

fn target_atom_value_expression(
  row: TargetAtomRealization,
  value: SourceAtomValue
) -> TargetValueExpression {
  target_value_template_apply(template: row.value_form, value: value)
}

fn target_type_expression_node(form: TargetTypeExpression) -> Node {
  match form {
    TargetTypeAlias { spelling: s } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          target_realization_named_edge(
            name: target_type_alias_field_spelling,
            target: Node {
              kind: TypeNode { connective: Atom { identity: s } },
              children: []
            }
          )
        ]
      }
  }
}

fn target_value_template_tag(template: TargetValueTemplate) -> Symbol {
  match template {
    ValueSymbolIdentityPassthrough => target_value_template_symbol_identity_passthrough
    ValueSymbolToOwnedString => target_value_template_symbol_to_owned_string
    ValueBoolLiteral => target_value_template_bool_literal
    ValueCharUnicodeScalar => target_value_template_char_unicode_scalar
  }
}

fn target_value_template_node(template: TargetValueTemplate) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: target_value_template_tag(template: template) }
    },
    children: []
  }
}

fn target_atom_realization_to_node(row: TargetAtomRealization) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      target_realization_named_edge(
        name: target_atom_realization_field_source_carrier,
        target: row.source_carrier
      ),
      target_realization_named_edge(
        name: target_atom_realization_field_type_form,
        target: target_type_expression_node(form: row.type_form)
      ),
      target_realization_named_edge(
        name: target_atom_realization_field_value_form,
        target: target_value_template_node(template: row.value_form)
      ),
      target_realization_named_edge(
        name: target_atom_realization_field_display_name,
        target: Node {
          kind: TypeNode { connective: Atom { identity: row.display_name } },
          children: []
        }
      )
    ]
  }
}

fn target_atom_realization_catalog_node(rows: List<TargetAtomRealization>) -> Node {
  fold_list(
    xs: rows,
    empty: Node { kind: TypeNode { connective: Conj }, children: [] },
    cons: fn(acc, row) {
      Node {
        kind: TypeNode { connective: Conj },
        children: list_snoc_item(
          xs: acc.children,
          item: target_realization_named_edge(
            name: row.display_name,
            target: target_atom_realization_to_node(row: row)
          )
        )
      }
    }
  )
}

fn target_realization_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

type TargetAtomRealizationCatalogLookup
  = TargetAtomRealizationCatalogMissing
  | TargetAtomRealizationCatalogUnique { row: TargetAtomRealization }
  | TargetAtomRealizationCatalogAmbiguous

fn target_atom_realization_catalog_lookup_step(
  acc: TargetAtomRealizationCatalogLookup,
  row_node: Node,
  source_carrier: Node
) -> TargetAtomRealizationCatalogLookup {
  let row = target_atom_realization_from_row_node(row_node: row_node)
  if content_hash(n: row.source_carrier) == content_hash(n: source_carrier) {
    match acc {
      TargetAtomRealizationCatalogMissing =>
        TargetAtomRealizationCatalogUnique { row: row }
      TargetAtomRealizationCatalogUnique { row: _ } =>
        TargetAtomRealizationCatalogAmbiguous
      TargetAtomRealizationCatalogAmbiguous => TargetAtomRealizationCatalogAmbiguous
    }
  } else {
    acc
  }
}

fn target_atom_realization_from_row_node(row_node: Node) -> TargetAtomRealization {
  TargetAtomRealization {
    source_carrier: target_atom_realization_conj_child(
      row_node: row_node,
      edge_name: target_atom_realization_field_source_carrier
    ),
    target_model: row_node,
    type_form: target_type_expression_from_node(
      n: target_atom_realization_conj_child(
        row_node: row_node,
        edge_name: target_atom_realization_field_type_form
      )
    ),
    value_form: target_value_template_from_node(
      n: target_atom_realization_conj_child(
        row_node: row_node,
        edge_name: target_atom_realization_field_value_form
      )
    ),
    constructor_form: optional_absent(),
    display_name: target_atom_realization_display_name_from_row(row_node: row_node)
  }
}

fn target_atom_realization_conj_child(row_node: Node, edge_name: Symbol) -> Node {
  match row_node.kind {
    TypeNode { connective: Conj } =>
      fold(
        row_node.children,
        init: row_node,
        f: fn(acc, e) {
          match e.label {
            Named { name: n } =>
              if n == edge_name {
                e.target
              } else {
                acc
              }
            Positional => acc
          }
        }
      )
    _ => row_node
  }
}

fn target_type_expression_from_node(n: Node) -> TargetTypeExpression {
  match target_atom_realization_conj_child(
    row_node: n,
    edge_name: target_type_alias_field_spelling
  ).kind {
    TypeNode { connective: Atom { identity: spelling } } =>
      TargetTypeAlias { spelling: spelling }
    _ => TargetTypeAlias { spelling: "" }
  }
}

fn target_value_template_from_node(n: Node) -> TargetValueTemplate {
  match n.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match id {
        target_value_template_symbol_identity_passthrough =>
          ValueSymbolIdentityPassthrough
        target_value_template_symbol_to_owned_string => ValueSymbolToOwnedString
        target_value_template_bool_literal => ValueBoolLiteral
        target_value_template_char_unicode_scalar => ValueCharUnicodeScalar
        _ => ValueSymbolToOwnedString
      }
    _ => ValueSymbolToOwnedString
  }
}

fn target_atom_realization_display_name_from_row(row_node: Node) -> Symbol {
  match target_atom_realization_conj_child(
    row_node: row_node,
    edge_name: target_atom_realization_field_display_name
  ).kind {
    TypeNode { connective: Atom { identity: id } } => id
    _ => target_atom_realization_lookup_miss
  }
}

fn target_atom_realization_lookup_in_catalog_node(
  catalog: Node,
  source_carrier: Node
) -> Outcome<TargetAtomRealization> {
  match catalog.kind {
    TypeNode { connective: Conj } =>
      match fold(
        catalog.children,
        init: TargetAtomRealizationCatalogMissing,
        f: fn(acc, e) {
          target_atom_realization_catalog_lookup_step(
            acc: acc,
            row_node: e.target,
            source_carrier: source_carrier
          )
        }
      ) {
        TargetAtomRealizationCatalogMissing =>
          outcome_rejected(target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
        TargetAtomRealizationCatalogUnique { row: row } =>
          Accepted { value: row, diagnostics: None }
        TargetAtomRealizationCatalogAmbiguous =>
          outcome_rejected(target_atom_realization_lookup_ambiguous_diagnostic(source_carrier: source_carrier))
      }
    _ =>
      outcome_rejected(target_atom_realization_lookup_miss_diagnostic(source_carrier: source_carrier))
  }
}
