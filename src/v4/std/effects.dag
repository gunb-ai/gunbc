// src/v4/std/effects.dag
// Scope: v4 effect algebra — idempotent/breaking partition (structural mirror of src/v3/std/effects.dag terminal carriers).
// Owns: IdempotentShape BreakingShape EffectShape KeySource IdempotentOperationRef IdempotentOperationSubject idempotent_operation_witness_node idempotent_operation_apply_once idempotent_operation_apply_twice t19_sample_state
// Consumes: v4.std.node
// Status: T-19 idempotent-operation generator authority; full OperationEffect port = TASKS T-8.

module v4.std.effects


import v4.std.node { Atom, Conj, ComputationNode, Edge, Named, Node, Symbol, Transform, TypeNode }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type IdempotentShape
  = ReadEffect
  | UpsertEffect { key_source: KeySource }
  | DeleteEffect { key_source: KeySource }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type BreakingShape
  = CreateEffect { cause: CreateCause }
  | AppendEffect


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type CreateCause
  = PostAlways
  | KeylessFallback { method: Symbol }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type KeySource
  = PathParam { param: Symbol }
  | InputField { field: Symbol }


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type EffectShape
  = IsIdempotent(IdempotentShape)
  | IsBreaking(BreakingShape)


type IdempotentOperationRef {
  callable: Symbol
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type IdempotentOperationSubject
  = ReadIdempotentSample { operation: IdempotentOperationRef }
  | UpsertIdempotentSample { operation: IdempotentOperationRef, key_source: KeySource }
  | DeleteIdempotentSample { operation: IdempotentOperationRef, key_source: KeySource }
  | LabelOnlyIdempotentInhabitance { shape: IdempotentShape, label: Symbol }


data effect_shape_is_idempotent_field: Symbol = effect_shape_is_idempotent_field
data effect_shape_inner_field: Symbol = effect_shape_inner_field
data effect_shape_variant_read: Symbol = effect_shape_variant_read
data effect_shape_variant_upsert: Symbol = effect_shape_variant_upsert
data effect_shape_variant_delete: Symbol = effect_shape_variant_delete
data idempotent_operation_callable_field: Symbol = idempotent_operation_callable_field
data idempotent_operation_key_source_field: Symbol = idempotent_operation_key_source_field
data key_source_path_param_field: Symbol = key_source_path_param_field
data key_source_path_param_value_field: Symbol = key_source_path_param_value_field
data key_source_input_field_field: Symbol = key_source_input_field_field
data key_source_input_value_field: Symbol = key_source_input_value_field
data idempotent_apply_state_field: Symbol = idempotent_apply_state_field
data idempotent_apply_operation_field: Symbol = idempotent_apply_operation_field
data t19_sample_state_value: Symbol = t19_sample_state_value


data t19_sample_get_callable: Symbol = t19_sample_get_callable
data t19_sample_upsert_callable: Symbol = t19_sample_upsert_callable
data t19_sample_delete_callable: Symbol = t19_sample_delete_callable
data t19_sample_path_key_slug: Symbol = t19_sample_path_key_slug
data t19_sample_label_only_callable: Symbol = t19_sample_label_only_callable


data t19_sample_state: Node = Node {
  kind: TypeNode { connective: Atom { identity: t19_sample_state_value } },
  children: []
}


data t19_sample_read_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: t19_sample_get_callable
}


data t19_sample_upsert_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: t19_sample_upsert_callable
}


data t19_sample_delete_operation: IdempotentOperationRef = IdempotentOperationRef {
  callable: t19_sample_delete_callable
}


data t19_sample_upsert_key_source: KeySource = InputField { field: t19_sample_path_key_slug }


data t19_sample_delete_key_source: KeySource = InputField { field: t19_sample_path_key_slug }


data t19_sample_read_subject: IdempotentOperationSubject = ReadIdempotentSample {
  operation: t19_sample_read_operation
}


data t19_sample_upsert_subject: IdempotentOperationSubject = UpsertIdempotentSample {
  operation: t19_sample_upsert_operation,
  key_source: t19_sample_upsert_key_source
}


data t19_sample_delete_subject: IdempotentOperationSubject = DeleteIdempotentSample {
  operation: t19_sample_delete_operation,
  key_source: t19_sample_delete_key_source
}


data t19_sample_label_only_subject: IdempotentOperationSubject = LabelOnlyIdempotentInhabitance {
  shape: ReadEffect,
  label: t19_sample_label_only_callable
}


fn atom_node(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [] }
}


fn key_source_node(key_source: KeySource) -> Node {
  match key_source {
    PathParam { param: p } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: key_source_path_param_field },
            target: atom_node(s: key_source_path_param_field)
          },
          Edge {
            label: Named { name: key_source_path_param_value_field },
            target: atom_node(s: p)
          },
        ]
      }
    InputField { field: f } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: key_source_input_field_field },
            target: atom_node(s: key_source_input_field_field)
          },
          Edge {
            label: Named { name: key_source_input_value_field },
            target: atom_node(s: f)
          },
        ]
      }
  }
}


fn idempotent_shape_node(shape: IdempotentShape) -> Node {
  match shape {
    ReadEffect => atom_node(s: effect_shape_variant_read)
    UpsertEffect { key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: effect_shape_variant_upsert },
            target: atom_node(s: effect_shape_variant_upsert)
          },
          Edge {
            label: Named { name: idempotent_operation_key_source_field },
            target: key_source_node(key_source: key_source)
          },
        ]
      }
    DeleteEffect { key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: effect_shape_variant_delete },
            target: atom_node(s: effect_shape_variant_delete)
          },
          Edge {
            label: Named { name: idempotent_operation_key_source_field },
            target: key_source_node(key_source: key_source)
          },
        ]
      }
  }
}


fn classified_idempotent_effect_node(shape: IdempotentShape) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: effect_shape_is_idempotent_field },
        target: atom_node(s: effect_shape_is_idempotent_field)
      },
      Edge {
        label: Named { name: effect_shape_inner_field },
        target: idempotent_shape_node(shape: shape)
      },
    ]
  }
}


fn idempotent_operation_ref_node(operation: IdempotentOperationRef) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: idempotent_operation_callable_field },
        target: atom_node(s: operation.callable)
      },
    ]
  }
}


fn idempotent_operation_apply_node(state: Node, subject: IdempotentOperationSubject) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Named { name: idempotent_apply_state_field },
        target: state
      },
      Edge {
        label: Named { name: idempotent_apply_operation_field },
        target: idempotent_operation_witness_node(subject: subject)
      },
    ]
  }
}


fn idempotent_operation_apply_once(state: Node, subject: IdempotentOperationSubject) -> Node {
  idempotent_operation_apply_node(state: state, subject: subject)
}


fn idempotent_operation_apply_twice(state: Node, subject: IdempotentOperationSubject) -> Node {
  idempotent_operation_apply_node(
    state: idempotent_operation_apply_node(state: state, subject: subject),
    subject: subject
  )
}


fn idempotent_operation_witness_node(subject: IdempotentOperationSubject) -> Node {
  match subject {
    ReadIdempotentSample { operation: operation } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: ReadEffect)
          },
          Edge {
            label: Named { name: idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ]
      }
    UpsertIdempotentSample { operation: operation, key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: UpsertEffect { key_source: key_source })
          },
          Edge {
            label: Named { name: idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ]
      }
    DeleteIdempotentSample { operation: operation, key_source: key_source } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: DeleteEffect { key_source: key_source })
          },
          Edge {
            label: Named { name: idempotent_operation_callable_field },
            target: idempotent_operation_ref_node(operation: operation)
          },
        ]
      }
    LabelOnlyIdempotentInhabitance { shape: shape, label: label } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Named { name: effect_shape_inner_field },
            target: classified_idempotent_effect_node(shape: shape)
          },
          Edge {
            label: Named { name: idempotent_operation_callable_field },
            target: atom_node(s: label)
          },
        ]
      }
  }
}
