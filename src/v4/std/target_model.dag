fn target_model_type_atom_node(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    span: Unanchored
  }
}

fn target_model_type_conj_node(children: List<Edge>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: children,
    span: Unanchored
  }
}

fn target_canonical_operation_wire_malformed_diagnostic(wire: Node) -> Diagnostic {
  Diagnostic {
    reason: target_canonical_operation_wire_malformed,
    at: node_locus(node: wire),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_model_canonical_operation_algebra_field_from_wire(wire: Node) -> Optional<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == target_canonical_operation_field_algebra_field {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: id } } =>
                    optional_present(value: id)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: field } => optional_present(value: field)
    Absent => optional_absent()
  }
}

fn target_model_canonical_operation_wire_node(operation: CanonicalOperation) -> Node {
  match operation {
    OpAdd { algebra_field: f } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: OpAdd {}) } },
        children: [
          target_model_named_edge(
            name: target_canonical_operation_field_algebra_field,
            target: target_model_type_atom_node(identity: f)
          )
        ],
        span: Unanchored
      }
  }
}

fn canonical_operation_equal(
  left: CanonicalOperation,
  right: CanonicalOperation
) -> Bool {
  match left {
    OpAdd { algebra_field: lf } =>
      match right {
        OpAdd { algebra_field: rf } => lf == rf
      }
  }
}

fn canonical_operation_from_wire_node(wire: Node) -> Outcome<CanonicalOperation> {
  match wire.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == discriminant(v: OpAdd {}) {
        match target_model_canonical_operation_algebra_field_from_wire(wire: wire) {
          Present { value: algebra_field } =>
            outcome_accepted(OpAdd { algebra_field: algebra_field })
          Absent =>
            outcome_rejected(
              target_canonical_operation_wire_malformed_diagnostic(wire: wire)
            )
        }
      } else {
        outcome_rejected(
          target_canonical_operation_wire_malformed_diagnostic(wire: wire)
        )
      }
    _ =>
      outcome_rejected(
        target_canonical_operation_wire_malformed_diagnostic(wire: wire)
      )
  }
}

// 🟡 gated — predicate-dissolution interim (INVARIANTS P3 / modeling-discipline Practice 10) —
// feature:canonical-operation-wire-decode-bool — consumer:target_operator_realization_row_matches_canonical_op
// — bind: operator-catalog row operation wire match — owner: T6 value-expression (lively-badger-242) —
// lane: std/target_model — dissolve-on-arrival: Outcome-bearing wire decode propagates diagnostics
// in catalog lookup; forbidden: Rejected => false silent swallow in substrate Bool matchers.
fn canonical_operation_wire_matches_operation(
  wire: Node,
  operation: CanonicalOperation
) -> Bool {
  match canonical_operation_from_wire_node(wire: wire) {
    Accepted { value: decoded, diagnostics: _ } =>
      canonical_operation_equal(left: decoded, right: operation)
    Rejected { diagnostics: _ } => false
  }
}

fn target_model_operator_shape_wire_node(shape: TargetOperatorShape) -> Node {
  match shape {
    InfixToken { token: t } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: InfixToken {}) } },
        children: [
          target_model_named_edge(
            name: target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: t)
          )
        ],
        span: Unanchored
      }
    PrefixToken { token: t } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: PrefixToken {}) } },
        children: [
          target_model_named_edge(
            name: target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: t)
          )
        ],
        span: Unanchored
      }
    CallIdent { ident: i } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: CallIdent {}) } },
        children: [
          target_model_named_edge(
            name: target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        span: Unanchored
      }
    MethodIdent { ident: i } =>
      Node {
        kind: TypeNode { connective: Atom { identity: discriminant(v: MethodIdent {}) } },
        children: [
          target_model_named_edge(
            name: target_operator_shape_field_token,
            target: target_model_type_atom_node(identity: i)
          )
        ],
        span: Unanchored
      }
  }
}

fn target_operator_shape_wire_malformed_diagnostic(wire: Node) -> Diagnostic {
  Diagnostic {
    reason: target_operator_shape_wire_malformed,
    at: node_locus(node: wire),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_shape_wire_schema_valid(wire: Node) -> Outcome<Bool> {
  match wire.kind {
    TypeNode { connective: Atom { identity: _ } } =>
      if name_occurrences(
        name: target_operator_shape_field_token,
        children: wire.children
      ) != 1 {
        outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
      } else {
        match fold(
          wire.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } => n == target_operator_shape_field_token
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
        }
      }
    _ =>
      outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
  }
}

fn target_operator_shape_token_from_wire(wire: Node) -> Outcome<Symbol> {
  match fold(
    wire.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match edge.label {
            Named { name: n } =>
              if n == target_operator_shape_field_token {
                match edge.target.kind {
                  TypeNode { connective: Atom { identity: token } } =>
                    optional_present(value: token)
                  _ => acc
                }
              } else {
                acc
              }
            Positional => acc
          }
      }
    }
  ) {
    Present { value: token } => outcome_accepted(token)
    Absent =>
      outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
  }
}

fn target_operator_shape_from_wire_node(wire: Node) -> Outcome<TargetOperatorShape> {
  bind_outcome(
    o: target_operator_shape_wire_schema_valid(wire: wire),
    f: fn(_) {
      match wire.kind {
        TypeNode { connective: Atom { identity: id } } =>
          bind_outcome(
            o: target_operator_shape_token_from_wire(wire: wire),
            f: fn(token) {
              if id == discriminant(v: InfixToken {}) {
                outcome_accepted(InfixToken { token: token })
              } else if id == discriminant(v: PrefixToken {}) {
                outcome_accepted(PrefixToken { token: token })
              } else if id == discriminant(v: CallIdent {}) {
                outcome_accepted(CallIdent { ident: token })
              } else if id == discriminant(v: MethodIdent {}) {
                outcome_accepted(MethodIdent { ident: token })
              } else {
                outcome_rejected(
                  target_operator_shape_wire_malformed_diagnostic(wire: wire)
                )
              }
            }
          )
        _ =>
          outcome_rejected(target_operator_shape_wire_malformed_diagnostic(wire: wire))
      }
    }
  )
}

fn target_operator_realization_wire_malformed_diagnostic(row: Node) -> Diagnostic {
  Diagnostic {
    reason: target_operator_realization_wire_malformed,
    at: node_locus(node: row),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn target_operator_realization_row_wire_schema_valid(row: Node) -> Outcome<Bool> {
  match row.kind {
    TypeNode { connective: Conj } =>
      if name_occurrences(
        name: target_operator_realization_field_operation,
        children: row.children
      ) != 1 {
        outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
      } else if name_occurrences(
        name: target_operator_realization_field_shape,
        children: row.children
      ) != 1 {
        outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
      } else {
        match fold(
          row.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == target_operator_realization_field_operation
                  || n == target_operator_realization_field_shape
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          true => outcome_accepted(true)
          false =>
            outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
        }
      }
    _ =>
      outcome_rejected(target_operator_realization_wire_malformed_diagnostic(row: row))
  }
}

fn target_operator_realization_from_wire_row(row: Node) -> Outcome<TargetOperatorRealization> {
  bind_outcome(
    o: target_operator_realization_row_wire_schema_valid(row: row),
    f: fn(_) {
      bind_outcome(
        o: find_named_child(root: row, name: target_operator_realization_field_operation),
        f: fn(operation_wire) {
          bind_outcome(
            o: canonical_operation_from_wire_node(wire: operation_wire),
            f: fn(canonical_op) {
              bind_outcome(
                o: find_named_child(root: row, name: target_operator_realization_field_shape),
                f: fn(shape_wire) {
                  bind_outcome(
                    o: target_operator_shape_from_wire_node(wire: shape_wire),
                    f: fn(shape) {
                      outcome_accepted(
                        TargetOperatorRealization {
                          operation: canonical_op,
                          shape: shape
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn target_operator_realization_node(
  operation: CanonicalOperation,
  shape: TargetOperatorShape
) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: target_operator_realization_field_operation,
        target: target_model_canonical_operation_wire_node(operation: operation)
      ),
      target_model_named_edge(
        name: target_operator_realization_field_shape,
        target: target_model_operator_shape_wire_node(shape: shape)
      )
    ]
  )
}

data target_operator_realization_row_edge: Symbol = target_operator_realization_row_edge

fn target_operator_realizations_catalog_node(rows: List<Node>) -> Node {
  target_model_type_conj_node(
    children: fold_list(
      xs: rows,
      empty: Empty,
      cons: fn(acc, row) {
        Cons {
          head: target_model_named_edge(
            name: target_operator_realization_row_edge,
            target: row
          ),
          tail: acc
        }
      }
    )
  )
}

fn target_value_projection_field_missing_diagnostic(bundle: Node, field: Symbol) -> Diagnostic {
  Diagnostic {
    reason: target_value_projection_field_missing,
    at: node_locus(node: bundle),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn projection_bundle_child(bundle: Node, name: Symbol) -> Outcome<Node> {
  find_named_child(root: bundle, name: name)
}

fn projection_bundle_symbol_field(bundle: Node, field: Symbol) -> Outcome<Symbol> {
  bind_outcome(
    o: find_named_child(root: bundle, name: field),
    f: fn(child) {
      match child.kind {
        TypeNode { connective: Atom { identity: id } } => outcome_accepted(id)
        _ =>
          outcome_rejected(
            target_value_projection_bundle_malformed_diagnostic(bundle: bundle)
          )
      }
    }
  )
}

fn decode_binding_ref_shape_bundle(bundle: Node) -> Outcome<TargetBindingRefShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: bundle,
      field: target_value_expr_field_ident_token
    ),
    f: fn(ident_token) {
      outcome_accepted(
        TargetBindingRefShape { ident_token: ident_token }
      )
    }
  )
}

fn decode_primitive_apply_shape_bundle(bundle: Node) -> Outcome<TargetPrimitiveApplyShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(bundle: bundle, field: target_value_expr_field_open),
    f: fn(open) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: target_value_expr_field_close),
        f: fn(close) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: target_value_expr_field_separator
            ),
            f: fn(separator) {
              outcome_accepted(
                TargetPrimitiveApplyShape {
                  open: open,
                  close: close,
                  separator: separator
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_callable_apply_shape_bundle(bundle: Node) -> Outcome<TargetCallApplyShape> {
  bind_outcome(
    o: projection_bundle_symbol_field(
      bundle: bundle,
      field: target_value_expr_field_ident_token
    ),
    f: fn(callee_ident_token) {
      bind_outcome(
        o: projection_bundle_symbol_field(bundle: bundle, field: target_value_expr_field_open),
        f: fn(open) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: bundle,
              field: target_value_expr_field_separator
            ),
            f: fn(separator) {
              bind_outcome(
                o: projection_bundle_symbol_field(
                  bundle: bundle,
                  field: target_value_expr_field_close
                ),
                f: fn(close) {
                  outcome_accepted(
                    TargetCallApplyShape {
                      callee_ident_token: callee_ident_token,
                      open: open,
                      separator: separator,
                      close: close
                    }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

fn decode_value_expression_projection_bundle(
  bundle: Node
) -> Outcome<TargetValueExpressionProjection> {
  match bundle.kind {
    TypeNode { connective: Conj } =>
      bind_outcome(
        o: projection_bundle_child(
          bundle: bundle,
          name: target_value_expr_field_binding_ref
        ),
        f: fn(binding_ref_bundle) {
          bind_outcome(
            o: decode_binding_ref_shape_bundle(bundle: binding_ref_bundle),
            f: fn(binding_ref_form) {
              bind_outcome(
                o: projection_bundle_child(
                  bundle: bundle,
                  name: target_value_expr_field_primitive_apply
                ),
                f: fn(primitive_bundle) {
                  bind_outcome(
                    o: decode_primitive_apply_shape_bundle(bundle: primitive_bundle),
                    f: fn(primitive_apply_form) {
                      bind_outcome(
                        o: projection_bundle_child(
                          bundle: bundle,
                          name: target_value_expr_field_callable_apply
                        ),
                        f: fn(callable_bundle) {
                          bind_outcome(
                            o: decode_callable_apply_shape_bundle(bundle: callable_bundle),
                            f: fn(callable_apply_form) {
                              outcome_accepted(
                                TargetValueExpressionProjection {
                                  binding_ref_form: binding_ref_form,
                                  primitive_apply_form: primitive_apply_form,
                                  callable_apply_form: callable_apply_form
                                }
                              )
                            }
                          )
                        }
                      )
                    }
                  )
                }
              )
            }
          )
        }
      )
    _ =>
      outcome_rejected(
        target_value_projection_bundle_malformed_diagnostic(bundle: bundle)
      )
  }
}

fn concrete_syntax_token_list_to_node(tokens: List<ConcreteSyntaxToken>) -> Node {
  fold_list_node(xs: tokens, item_node: concrete_syntax_token_to_node)
}

fn grammar_relation_row_attach_bodied_scaffold(
  row: Node,
  scaffold: TargetBodiedArrowStatementScaffold
) -> Node {
  target_model_type_conj_node(
    children: list_append(
      left: row.children,
      right: Cons {
        head: target_model_named_edge(
          name: grammar_relation_field_bodied_scaffold,
          target: bodied_arrow_statement_scaffold_bundle_node(scaffold: scaffold)
        ),
        tail: Empty
      }
    )
  )
}

fn bodied_arrow_statement_scaffold_bundle_node(
  scaffold: TargetBodiedArrowStatementScaffold
) -> Node {
  target_model_type_conj_node(
    children: [
      target_model_named_edge(
        name: target_bodied_arrow_scaffold_field_prefix,
        target: concrete_syntax_token_list_to_node(tokens: scaffold.prefix)
      ),
      target_model_named_edge(
        name: target_bodied_arrow_scaffold_field_suffix,
        target: concrete_syntax_token_list_to_node(tokens: scaffold.suffix)
      )
    ]
  )
}

fn wire_conj_named_binding_atom(parent: Node) -> Outcome<Symbol> {
  bind_outcome(
    o: find_named_child(root: parent, name: concrete_syntax_token_field_binding),
    f: fn(binding_node) {
      match binding_node.kind {
        TypeNode { connective: Atom { identity: binding } } =>
          outcome_accepted(binding)
        _ =>
          outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: parent))
      }
    }
  )
}

fn concrete_syntax_token_wire_malformed_diagnostic(token: Node) -> Diagnostic {
  Diagnostic {
    reason: concrete_syntax_token_wire_malformed,
    at: node_locus(node: token),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn concrete_syntax_token_wire_schema_valid(token: Node) -> Outcome<Bool> {
  match token.kind {
    TypeNode { connective: Conj } =>
      if name_occurrences(
        name: concrete_syntax_token_field_kind,
        children: token.children
      ) != 1 {
        outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: token))
      } else if name_occurrences(
        name: concrete_syntax_token_field_class,
        children: token.children
      ) != 1 {
        outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: token))
      } else {
        match fold(
          token.children,
          init: true,
          f: fn(acc, edge) {
            if acc {
              match edge.label {
                Named { name: n } =>
                  n == concrete_syntax_token_field_kind
                  || n == concrete_syntax_token_field_class
                  || n == concrete_syntax_token_field_binding
                Positional => false
              }
            } else {
              false
            }
          }
        ) {
          false =>
            outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: token))
          true =>
            bind_outcome(
              o: find_named_child(root: token, name: concrete_syntax_token_field_kind),
              f: fn(kind_node) {
                match kind_node.kind {
                  TypeNode { connective: Atom { identity: kind } } =>
                    if kind == concrete_syntax_token_kind_fixed {
                      if name_occurrences(
                        name: concrete_syntax_token_field_binding,
                        children: token.children
                      ) == 0 {
                        outcome_accepted(true)
                      } else {
                        outcome_rejected(
                          concrete_syntax_token_wire_malformed_diagnostic(token: token)
                        )
                      }
                    } else if kind == concrete_syntax_token_kind_bound {
                      if name_occurrences(
                        name: concrete_syntax_token_field_binding,
                        children: token.children
                      ) == 1 {
                        outcome_accepted(true)
                      } else {
                        outcome_rejected(
                          concrete_syntax_token_wire_malformed_diagnostic(token: token)
                        )
                      }
                    } else {
                      outcome_rejected(
                        concrete_syntax_token_wire_malformed_diagnostic(token: token)
                      )
                    }
                  _ =>
                    outcome_rejected(
                      concrete_syntax_token_wire_malformed_diagnostic(token: token)
                    )
                }
              }
            )
        }
      }
    _ =>
      outcome_rejected(concrete_syntax_token_wire_malformed_diagnostic(token: token))
  }
}

fn concrete_syntax_token_from_wire_node(token: Node) -> Outcome<ConcreteSyntaxToken> {
  bind_outcome(
    o: concrete_syntax_token_wire_schema_valid(token: token),
    f: fn(_) {
      bind_outcome(
        o: projection_bundle_child(bundle: token, name: concrete_syntax_token_field_kind),
        f: fn(kind_node) {
          bind_outcome(
            o: projection_bundle_symbol_field(
              bundle: token,
              field: concrete_syntax_token_field_class
            ),
            f: fn(token_class) {
              match kind_node.kind {
                TypeNode { connective: Atom { identity: kind } } =>
                  if kind == concrete_syntax_token_kind_fixed {
                    outcome_accepted(
                      FixedToken { token_class: token_class }
                    )
                  } else if kind == concrete_syntax_token_kind_bound {
                    bind_outcome(
                      o: wire_conj_named_binding_atom(parent: token),
                      f: fn(binding) {
                        outcome_accepted(
                          BoundToken {
                            token_class: token_class,
                            binding: binding
                          }
                        )
                      }
                    )
                  } else {
                    outcome_rejected(
                      concrete_syntax_token_wire_malformed_diagnostic(token: token)
                    )
                  }
                _ =>
                  outcome_rejected(
                    concrete_syntax_token_wire_malformed_diagnostic(token: token)
                  )
              }
            }
          )
        }
      )
    }
  )
}

data target_value_projection_field_missing: Symbol = target_value_projection_field_missing
data target_value_projection_bundle_malformed: Symbol = target_value_projection_bundle_malformed

fn target_value_projection_bundle_malformed_diagnostic(bundle: Node) -> Diagnostic {
  Diagnostic {
    reason: target_value_projection_bundle_malformed,
    at: node_locus(node: bundle),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

type TargetConstructorTemplate
  = CtorTemplateUnit {}

type TargetAtomRealization {
  source_carrier: Node
  target_model: TargetModel
  type_form: TargetTypeExpression
  value_form: TargetValueTemplate
  constructor_form: Optional<TargetConstructorTemplate>
  display_name: Symbol
}

data target_atom_realization_lookup_miss: Symbol = target_atom_realization_lookup_miss
data target_atom_realization_catalog_row_decode_invalid: Symbol = target_atom_realization_catalog_row_decode_invalid

data target_model_edge_value_expression: Symbol = target_model_edge_value_expression

// Kernel-ambient type carriers (Node-keyed authority; not spelling-keyed tables).
data symbol_kernel_type_atom: Symbol = symbol_kernel_type_atom
data char_kernel_type_atom: Symbol = char_kernel_type_atom

fn symbol_kernel_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: symbol_kernel_type_atom } },
    children: [],
    span: Unanchored
}
}

fn char_kernel_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: char_kernel_type_atom } },
    children: [],
    span: Unanchored
}
}

fn source_atom_symbol(identity: Symbol) -> SourceAtomValue {
  SourceAtomSymbol { identity: identity }
}

fn source_atom_bool(value: Bool) -> SourceAtomValue {
  SourceAtomBool { value: value }
}

fn source_atom_char(codepoint: Char) -> SourceAtomValue {
  SourceAtomChar { codepoint: codepoint }
}

fn source_atom_char_projection_from_node(source: Node) -> Optional<SourceAtomValue> {
  match source.kind {
    TypeNode { connective: Atom { identity: c } } =>
      if c == char_kernel_type_atom {
        optional_absent()
      } else {
        optional_present(source_atom_char(codepoint: c))
      }
    _ => optional_absent()
  }
}

// 🟡 gated — feature:free-monoid-node-projection — owner:Modeling DFS / std.algebra lane —
// dissolve-on: std.algebra exports a canonical `Node -> Optional<FreeMonoid<T>>` (or
// `Node -> Optional<String>`) projection over `free_monoid_type_node`'s encoded surface; replace
// this local encoded-node projection with that accessor. The bridge proves Empty or Cons(head:
// Char, tail: String) with fuel derived from the input node tree size so malformed tails fail
// closed without adding an arbitrary string-length cap; named-edge lookup remains delegated to
// node_query. Forbidden: adding another FreeMonoid storage walker outside this receipt.
fn source_atom_string_projection_from_node(source: Node) -> Optional<SourceAtomValue> {
  source_atom_string_projection_from_node_bounded(source: source, fuel: source_atom_string_projection_node_count(source: source))
}

fn source_atom_string_projection_node_count(source: Node) -> Int {
  fold_node(
    n: source,
    algebra: NodeFold {
      init: fn(_) { 1 },
      step: fn(acc, _, child_count) { acc + child_count }
    }
  )
}

fn source_atom_string_projection_from_node_bounded(source: Node, fuel: Int) -> Optional<SourceAtomValue> {
  if fuel <= 0 {
    optional_absent()
  } else {
    match source.kind {
      TypeNode { connective: Atom { identity: id } } =>
        if id == free_monoid_variant_empty {
          optional_present(source_atom_string(value: source))
        } else {
          optional_absent()
        }
      TypeNode { connective: Conj } =>
        if (source.children |> count) != 2 {
          optional_absent()
        } else {
          match find_named_child(root: source, name: free_monoid_field_head) {
            Accepted { value: head } =>
              match find_named_child(root: source, name: free_monoid_field_tail) {
                Accepted { value: tail } =>
                  match source_atom_char_projection_from_node(source: head) {
                    Present { value: _ } =>
                      match source_atom_string_projection_from_node_bounded(source: tail, fuel: fuel - 1) {
                        Present { value: _ } => optional_present(source_atom_string(value: source))
                        Absent => optional_absent()
                      }
                    Absent => optional_absent()
                  }
                Rejected { diagnostics: _ } => optional_absent()
              }
            Rejected { diagnostics: _ } => optional_absent()
          }
        }
      _ => optional_absent()
    }
  }
}

fn source_atom_string(value: Node) -> SourceAtomValue {
  SourceAtomString { value: value }
}

fn target_model_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn source_atom_symbol_projection_from_node(source: Node) -> Optional<SourceAtomValue> {
  match source.kind {
    TypeNode { connective: Atom { identity: id } } =>
      if id == symbol_kernel_type_atom {
        optional_absent()
      } else {
        optional_present(source_atom_symbol(identity: id))
      }
    _ => optional_absent()
  }
}

// Project infer/translate grounding nodes onto SourceAtomValue using row.value_form.kind
// (single authority — consumers must not re-derive carrier-hash projections).
fn source_atom_value_for_value_template(
  source: Node,
  template: TargetValueTemplate
) -> Optional<SourceAtomValue> {
  match template.kind {
    ValueSymbolIdentityPassthrough =>
      source_atom_symbol_projection_from_node(source: source)
    ValueSymbolToOwnedString =>
      source_atom_symbol_projection_from_node(source: source)
    ValueBoolLiteral =>
      match source.kind {
        TypeNode { connective: Atom { identity: id } } =>
          if id == ^target_value_expression_bool_true {
            optional_present(source_atom_bool(value: true))
          } else if id == ^target_value_expression_bool_false {
            optional_present(source_atom_bool(value: false))
          } else {
            optional_absent()
          }
        _ => optional_absent()
      }
    ValueCharUnicodeScalar =>
      source_atom_char_projection_from_node(source: source)
    ValueStringLiteral =>
      source_atom_string_projection_from_node(source: source)
    ValueBindingRef =>
      optional_absent()
    ValuePrimitiveApply =>
      optional_absent()
  }
}

fn source_atom_value_for_realization_row(
  source: Node,
  row: TargetAtomRealization
) -> Optional<SourceAtomValue> {
  source_atom_value_for_value_template(source: source, template: row.value_form)
}

fn source_atom_value_as_symbol(value: SourceAtomValue) -> Optional<Symbol> {
  match value {
    SourceAtomSymbol { identity: id } => optional_present(id)
    _ => optional_absent()
  }
}

fn source_atom_value_as_bool(value: SourceAtomValue) -> Optional<Bool> {
  match value {
    SourceAtomBool { value: b } => optional_present(b)
    _ => optional_absent()
  }
}

fn source_atom_value_as_char(value: SourceAtomValue) -> Optional<Char> {
  match value {
    SourceAtomChar { codepoint: c } => optional_present(c)
    _ => optional_absent()
  }
}

fn source_atom_value_as_string(value: SourceAtomValue) -> Optional<Node> {
  match value {
    SourceAtomString { value: s } => optional_present(s)
    _ => optional_absent()
  }
}

fn target_value_template_for_kind(kind: TargetValueTemplateKind) -> TargetValueTemplate {
  TargetValueTemplate {
    kind: kind,
    node: target_value_template_tag_node(kind: kind)
  }
}

fn target_value_template_tag_node(kind: TargetValueTemplateKind) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: discriminant(v: kind) }
    },
    children: [],
    span: Unanchored
}
}

fn target_value_expression_symbol_identity(identity: Symbol) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprSymbolIdentity,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_symbol_identity_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expression_field_identity,
          target: Node {
            kind: TypeNode { connective: Atom { identity: identity } },
            children: [],
            span: Unanchored
}
        )
      ],
      span: Unanchored
}
  }
}

fn target_value_expression_symbol_to_owned_string(identity: Symbol) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprSymbolToOwnedString,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_symbol_to_owned_string_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expression_field_identity,
          target: Node {
            kind: TypeNode { connective: Atom { identity: identity } },
            children: [],
            span: Unanchored
}
        )
      ],
      span: Unanchored
}
  }
}

fn target_value_expression_bool_literal(value: Bool) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprBoolLiteral,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_bool_literal_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expression_field_value,
          target: target_value_expression_bool_atom(value: value)
        )
      ],
      span: Unanchored
}
  }
}

fn target_value_expression_char_unicode_scalar(codepoint: Char) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprCharUnicodeScalar,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_char_unicode_scalar_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expression_field_codepoint,
          target: Node {
            kind: TypeNode { connective: Atom { identity: codepoint } },
            children: [],
            span: Unanchored
}
        )
      ],
      span: Unanchored
}
  }
}

fn target_value_expression_string_literal(value: Node) -> TargetValueExpression {
  TargetValueExpression {
    kind: TargetValueExprStringLiteral,
    node: Node {
      kind: TypeNode {
        connective: Atom { identity: ^target_value_expression_string_literal_atom }
      },
      children: [
        target_model_named_edge(
          name: ^target_value_expression_field_value,
          target: value
        )
      ],
      span: Unanchored
}
  }
