// src/v4/std/leaf_model_verification.dag
// Scope: Per-leaf-model verification carriers (docs/planning/v4-leaf-model-verification-2026-05-30.md §5).
// Status: Phase 1 — R1 rustc compile verdict surface only; widen with TargetInvocation rows per language.

module v4.std.leaf_model_verification


import v4.std.collection { List }
import v4.std.node { Symbol }
import v4.std.text { String }
import v4.std.diagnostic { Accepted }
import v4.std.verdict { Verdict, verdict_combine }


// Target exercise outcome for compile-only Phase 1 fixtures (rustc / pyright / … widen later).
type TargetCompileVerdict
  = TargetCompileAccepted
  | TargetCompileRejected { diagnostic_code: Symbol }


data target_diagnostic_e0308_type_mismatch: Symbol = target_diagnostic_e0308_type_mismatch


// Stable claim identity — references fact IDs declared in leaf models (not runner concerns).
type LeafModelClaimId
  = RustR1I32SurfaceSpelling


data leaf_model_claim_rust_r1_i32_surface_spelling: LeafModelClaimId = RustR1I32SurfaceSpelling


type LeafModelRustCrateType
  = RustCrateTypeLib


data leaf_model_rust_crate_type_lib: LeafModelRustCrateType = RustCrateTypeLib


type LeafModelRustFixture {
  claim_id: LeafModelClaimId
  source: String
  crate_type: LeafModelRustCrateType
}


type LeafModelFalsificationCase {
  claim_id: LeafModelClaimId
  fixture: LeafModelRustFixture
  expected_verdict: TargetCompileVerdict
}


type LeafModelFixturePair {
  claim_id: LeafModelClaimId
  happy: LeafModelRustFixture
  expected_happy_verdict: TargetCompileVerdict
  falsification: LeafModelFalsificationCase
}


type LeafModelVerificationRunReceipt {
  claim_id: LeafModelClaimId
  happy_verdict: Verdict<TargetCompileVerdict>
  falsification_verdict: Verdict<TargetCompileVerdict>
}


fn leaf_model_verification_run_proven(receipt: LeafModelVerificationRunReceipt) -> Bool {
  match receipt.happy_verdict {
    Pass => match receipt.falsification_verdict {
      Pass => true
      Fail { actual: _ } => false
      Deferred { actual: _, diagnostic: _ } => false
    }
    Fail { actual: _ } => false
    Deferred { actual: _, diagnostic: _ } => false
  }
}


fn leaf_model_verification_claim_passes(receipt: LeafModelVerificationRunReceipt) -> Verdict<LeafModelClaimId> {
  if leaf_model_verification_run_proven(receipt: receipt) {
    Pass
  } else {
    Fail { actual: Accepted { value: receipt.claim_id, diagnostics: None } }
  }
}


fn leaf_model_verification_combine_runs(
  runs: List<LeafModelVerificationRunReceipt>
) -> Verdict<LeafModelClaimId> {
  fold(
    runs,
    init: Pass,
    f: fn(acc, r) {
      verdict_combine(a: acc, b: leaf_model_verification_claim_passes(receipt: r))
    }
  )
}
