// src/v4/std/leaf_model_verification.dag
// Scope: Leaf-model verification carriers — claim / falsification / fixture / report.
// Status: Phase 1 substrate (docs/planning/v4-leaf-model-verification-2026-05-30.md §5).
// Authority: leaf model owns FACTS (stable fact_id in extdeps); this module owns OBLIGA shape.
// Co-authored with Modeling DFS (proud-pike-680) — consume Verdict<Subj,T> from verdict.dag (PR #3961).
// R1 rustc slice: concrete fixture-pair + compile verdict carriers (PR #3972).
// R1 python slice: concrete fixture-pair + exec verdict carriers (W2.6 / PR #3938 §11.4).

module v4.std.leaf_model_verification

import v4.std.collection { List }
import v4.std.nat { Nat }
import v4.std.node { Node, Symbol }
import v4.std.text { String }
import v4.std.verdict { Verdict, verdict_combine }

// Layer A boundary: OBLIGA rows reference model facts structurally (Node projection of declared bindings).
type LeafModelClaim<M, Subject, Expectation> {
  model: M
  fact_id: Node
  subject: Subject
  expectation: Expectation
  falsification_case: FalsificationCase<Subject, Expectation>
}

// REQUIRED paired probe — claim without falsification is not verifiable (planning doc §5).
type FalsificationCase<Subject, Expectation> {
  subject_variant: Subject
  expected_failure_mode: Expectation
}

// 🟡 gated — feature:leaf-model-fixture-runner — bind TASKS.md T-19/T-22 follow-up —
// dissolve-on: testgen emits LeafModelFixture rows and runner exercises target toolchain;
// forbidden: parallel fixture vocabulary outside this carrier.
type TargetArtifact {
  source_text: String
}

// 🟡 gated — feature:leaf-model-fixture-runner — bind TASKS.md T-19/T-22 follow-up —
// dissolve-on: TargetToolchain / TargetEdition / TargetBuildProfile / TargetOverflowDispositionField coproducts replace these Symbol scaffolds;
// forbidden: parallel invocation vocab outside this carrier.
type TargetInvocation {
  toolchain: Symbol
  edition: Symbol
  build_profile: Symbol
  overflow_disposition_field: Symbol
}

type LeafModelFixture<C> {
  claim: C
  artifact: TargetArtifact
  invocation: TargetInvocation
  expected_verdict: Verdict<Symbol, Symbol>
  falsification_artifact: TargetArtifact
  expected_falsification_verdict: Verdict<Symbol, Symbol>
}

type LeafModelClaimVerdictRow {
  claim_id: Symbol
  verdict: Verdict<Symbol, Symbol>
  falsification_verdict: Verdict<Symbol, Symbol>
}

type LeafModelVerificationTotals {
  proven: Nat
  model_failed: Nat
  falsification_caught: Nat
  falsification_missed: Nat
  not_checked: Nat
}

// 🟡 gated — feature:leaf-model-verification-report — dissolve-on: runner fold over report.claims.
type LeafModelVerificationReport<M> {
  model: M
  claims: List<LeafModelClaimVerdictRow>
}

// --- PR #3972 R1 rustc compile slice (happy/falsification fixtures + boundary runner) ---

// 🟢 coproduct dissolution — CP-LMV-TARGET-COMPILE-VERDICT-PHASE1 (Phase 1 R1 rustc gate; widen per target).
type TargetCompileVerdict
  = TargetCompileAccepted
  | TargetCompileRejected { diagnostic_code: Symbol }

// Phase 1 python CPython boundary — py_compile and python3 exec are distinct authorities.
type TargetPythonExerciseVerdict
  = TargetPythonExerciseAccepted
  | TargetPythonCompileRejected { diagnostic_code: Symbol }
  | TargetPythonExecRejected { diagnostic_code: Symbol }

// 🟢 coproduct dissolution — CP-LMV-TARGET-TYPESCRIPT-COMPILE-VERDICT-PHASE1 (Phase 1 tsc gate; widen per target).
type TargetTypeScriptCompileVerdict
  = TargetTypeScriptCompileAccepted
  | TargetTypeScriptCompileRejected { diagnostic_code: Symbol }

// 🟢 coproduct dissolution — CP-LMV-TARGET-TYPESCRIPT-RUNTIME-VERDICT-PHASE1 (Phase 1 Node gate; widen per target).
type TargetTypeScriptRuntimeVerdict
  = TargetTypeScriptRuntimeAccepted
  | TargetTypeScriptRuntimeRejected { diagnostic_code: Symbol }

data target_diagnostic_e0308_type_mismatch: Symbol = target_diagnostic_e0308_type_mismatch
data target_diagnostic_e0423_expected_value_found_type: Symbol = target_diagnostic_e0423_expected_value_found_type
data target_diagnostic_e0599_method_not_found: Symbol = target_diagnostic_e0599_method_not_found
