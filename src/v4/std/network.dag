// src/v4/std/network.dag
// Scope: network boundary carriers.
// Owns: HttpMethod, UriScheme, UriUserInfo, UriHost, UriPort, UriAuthority, UriPath, UriQuery, UriFragment, Url, NetworkAddress.
// Consumes: std text.
// Status: T-26 modeled.


module v4.std.network


import v4.std.text { String }


// Anchor: https://www.rfc-editor.org/rfc/rfc9110.html#name-methods + https://www.rfc-editor.org/rfc/rfc5789.html
// 🟢 coproduct dissolution — DECISIONS.md T-26-HttpMethod
type HttpMethod
  = GET
  | POST
  | PUT
  | PATCH
  | DELETE
  | HEAD
  | OPTIONS
  | TRACE

type UriScheme {
  spelling: String,
}

type UriUserInfo {
  spelling: String,
}

type UriHost {
  spelling: String,
}

type UriPort {
  spelling: String,
}

type UriAuthority {
  userinfo: UriUserInfo,
  host: UriHost,
  port: UriPort,
}

type UriPath {
  spelling: String,
}

type UriQuery {
  spelling: String,
}

type UriFragment {
  spelling: String,
}

// Anchor: https://www.rfc-editor.org/rfc/rfc3986.html#section-3
type Url {
  scheme: UriScheme,
  authority: UriAuthority,
  path: UriPath,
  query: UriQuery,
  fragment: UriFragment,
}


// Anchor: https://www.rfc-editor.org/rfc/rfc3986.html#section-3.2
type NetworkAddress {
  authority: UriAuthority,
}
