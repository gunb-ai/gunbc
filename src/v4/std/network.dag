// src/v4/std/network.dag
// Scope: network boundary carriers.
// Owns: HttpMethod, Rfc3986AbnfProduction, UriScheme, UriUserInfo, UriUserInfoSlot, UriHost, UriPort, UriPortSlot, UriAuthority, UriPath, UriHierPart, UriQuery, UriQuerySlot, UriFragment, UriFragmentSlot, Url, UriRelativePart, UriRelativeReference, UriReference, NetworkAddress.
// Consumes: std text, std nat.
// Status: T-26 modeled.


module v4.std.network


import v4.std.text { String }
import v4.std.nat { Nat }


// Anchor: https://www.rfc-editor.org/rfc/rfc9110.html#name-methods + https://www.rfc-editor.org/rfc/rfc5789.html
// 🟢 coproduct dissolution — DECISIONS.md T-26-HttpMethod
type HttpMethod
  = GET
  | POST
  | PUT
  | PATCH
  | DELETE
  | HEAD
  | OPTIONS
  | CONNECT
  | TRACE

type Rfc3986AbnfProduction {
  name: String,
  expression: String,
}

data rfc3986_scheme_abnf: Rfc3986AbnfProduction = Rfc3986AbnfProduction {
  name: "scheme",
  expression: "ALPHA *( ALPHA / DIGIT / plus / hyphen / dot )",
}

data rfc3986_userinfo_abnf: Rfc3986AbnfProduction = Rfc3986AbnfProduction {
  name: "userinfo",
  expression: "*( unreserved / pct-encoded / sub-delims / colon )",
}

data rfc3986_host_abnf: Rfc3986AbnfProduction = Rfc3986AbnfProduction {
  name: "host",
  expression: "IP-literal / IPv4address / reg-name",
}

data rfc3986_port_abnf: Rfc3986AbnfProduction = Rfc3986AbnfProduction {
  name: "port",
  expression: "*DIGIT",
}

data rfc3986_path_abnf: Rfc3986AbnfProduction = Rfc3986AbnfProduction {
  name: "path",
  expression: "path-abempty / path-absolute / path-noscheme / path-rootless / path-empty",
}

data rfc3986_query_abnf: Rfc3986AbnfProduction = Rfc3986AbnfProduction {
  name: "query",
  expression: "*( pchar / slash / question )",
}

data rfc3986_fragment_abnf: Rfc3986AbnfProduction = Rfc3986AbnfProduction {
  name: "fragment",
  expression: "*( pchar / slash / question )",
}

type UriScheme {
  normalized: String,
  grammar: Rfc3986AbnfProduction,
}

type UriUserInfo {
  spelling: String,
  grammar: Rfc3986AbnfProduction,
}

// 🟢 coproduct dissolution — DECISIONS.md T-26-UriComponentPresence
type UriUserInfoSlot
  = UriUserInfoAbsent
  | UriUserInfoPresent { userinfo: UriUserInfo }

type UriHost {
  spelling: String,
  grammar: Rfc3986AbnfProduction,
}

type UriPort {
  value: Nat,
  grammar: Rfc3986AbnfProduction,
}

// 🟢 coproduct dissolution — DECISIONS.md T-26-UriComponentPresence
type UriPortSlot
  = UriPortAbsent
  | UriPortPresent { port: UriPort }

type UriAuthority {
  userinfo: UriUserInfoSlot,
  host: UriHost,
  port: UriPortSlot,
}

type UriPath {
  spelling: String,
  grammar: Rfc3986AbnfProduction,
}

// 🟢 coproduct dissolution — DECISIONS.md T-26-UriHierPart
type UriHierPart
  = UriHierAuthorityPath { authority: UriAuthority, path: UriPath }
  | UriHierPathAbsolute { path: UriPath }
  | UriHierPathRootless { path: UriPath }
  | UriHierPathEmpty

type UriQuery {
  spelling: String,
  grammar: Rfc3986AbnfProduction,
}

// 🟢 coproduct dissolution — DECISIONS.md T-26-UriComponentPresence
type UriQuerySlot
  = UriQueryAbsent
  | UriQueryPresent { query: UriQuery }

type UriFragment {
  spelling: String,
  grammar: Rfc3986AbnfProduction,
}

// 🟢 coproduct dissolution — DECISIONS.md T-26-UriComponentPresence
type UriFragmentSlot
  = UriFragmentAbsent
  | UriFragmentPresent { fragment: UriFragment }

// Anchor: https://www.rfc-editor.org/rfc/rfc3986.html#section-3
type Url {
  scheme: UriScheme,
  hier_part: UriHierPart,
  query: UriQuerySlot,
  fragment: UriFragmentSlot,
}

// Anchor: https://www.rfc-editor.org/rfc/rfc3986.html#section-4.2
// 🟢 coproduct dissolution — DECISIONS.md T-26-UriRelativePart
type UriRelativePart
  = UriRelativeAuthorityPath { authority: UriAuthority, path: UriPath }
  | UriRelativePathAbsolute { path: UriPath }
  | UriRelativePathNoScheme { path: UriPath }
  | UriRelativePathEmpty

type UriRelativeReference {
  relative_part: UriRelativePart,
  query: UriQuerySlot,
  fragment: UriFragmentSlot,
}

// 🟢 coproduct dissolution — DECISIONS.md T-26-UriReference
type UriReference
  = UriReferenceAbsolute { uri: Url }
  | UriReferenceRelative { relative: UriRelativeReference }


// Anchor: https://www.rfc-editor.org/rfc/rfc3986.html#section-3.2
type NetworkAddress {
  authority: UriAuthority,
}
