// src/v4/std/module_batch.dag
// Scope: Filesystem-free module batch carrier for compile-time ingest (T-35).
// Owns: ModuleBatch, batch_insert, batch_delete.
// Consumes: std/algebra.dag, std/node.dag, std/qualified_name.dag.
// Status: T-35 modeled; consumed by compiler/00_compile.dag.
// Anchor: INVARIANTS.md P2 boundary discipline — files are transport, not compile authority.


module v4.std.module_batch


import v4.std.algebra { FreeMonoid, filter, list_snoc_item }
import v4.std.diagnostic { Accepted, Rejected }
import v4.std.node { Node }
import v4.std.qualified_name {
  QualifiedName,
  qualified_name_eq,
  qualified_name_from_node
}


type ModuleBatch {
  entries: FreeMonoid<Node>
}


fn batch_insert(batch: ModuleBatch, node: Node) -> ModuleBatch {
  ModuleBatch {
    entries: list_snoc_item(xs: batch.entries, item: node)
  }
}


fn batch_delete(batch: ModuleBatch, qname: QualifiedName) -> ModuleBatch {
  ModuleBatch {
    entries: filter(xs: batch.entries, predicate: fn(node) {
      match qualified_name_from_node(root: node) {
        Accepted { value: node_name, diagnostics: _ } =>
          !qualified_name_eq(a: node_name, b: qname)
        Rejected { diagnostics: _ } => true
      }
    })
  }
}
