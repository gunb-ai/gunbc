// src/v4/std/refinement.dag
// Scope: value-predicate refinement substrate — base type plus fail-closed validation obligation discharged at a named constructor boundary.
// Status: T-25-core modeled; hoisted int refinement factories (§A1 substrate). Structural opacity for bare construction: T-25-tail.
// Anchor: https://en.wikipedia.org/wiki/Refinement_type


module v4.std.refinement


import v4.std.logic { Bool }
import v4.std.diagnostic {
  Diagnostic,
  Locus,
  Outcome,
  Accepted,
  Rejected,
  None,
  Unavailable,
  UserInputBoundary,
  diagnostics_singleton,
  port_locus
}
import v4.std.integer { Int }
import v4.std.node { Symbol }


data refinement_authoritative_locus_port: Symbol = refinement_authoritative_locus


fn refinement_authoritative_locus() -> Locus {
  port_locus(port: refinement_authoritative_locus_port)
}


type Validation<B> {
  reason: Symbol
  admits: fn(B) -> Bool
}


// Inhabit via refine (fail-closed) or make_* packing an Accepted refine receipt.
// 🟡 gated — feature:refinement-opaque-carrier — bind T-25-tail — dissolve-on-arrival:
// compiler-enforced construction only via refine / make_*; forbidden: bare Refined { base }.
type Refined<B> {
  base: B
}


fn refine<B>(base: B, by: Validation<B>, at: Locus) -> Outcome<Refined<B>> {
  let admits = by.admits
  if admits(base) {
    Accepted {
      value: Refined { base: base },
      diagnostics: None
    }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: Diagnostic {
          reason: by.reason,
          at: at,
          correction: Unavailable { reason: UserInputBoundary }
        }
      )
    }
  }
}


fn refined_base<B>(r: Refined<B>) -> B {
  r.base
}


fn positive_int_admits(value: Int) -> Bool {
  value >= 1
}


fn non_negative_int_admits(value: Int) -> Bool {
  value >= 0
}


fn at_least_minus_one_int_admits(value: Int) -> Bool {
  value >= -1
}


fn at_least_minus_two_int_admits(value: Int) -> Bool {
  value >= -2
}


fn exact_one_int_admits(value: Int) -> Bool {
  value == 1
}


data positive_int_out_of_range: Symbol = positive_int_out_of_range
data non_negative_int_out_of_range: Symbol = non_negative_int_out_of_range
data at_least_minus_one_int_out_of_range: Symbol = at_least_minus_one_int_out_of_range
data at_least_minus_two_int_out_of_range: Symbol = at_least_minus_two_int_out_of_range
data exact_one_int_out_of_range: Symbol = exact_one_int_out_of_range
data positive_int_validation: Validation<Int> = Validation {
  reason: positive_int_out_of_range,
  admits: positive_int_admits
}


data non_negative_int_validation: Validation<Int> = Validation {
  reason: non_negative_int_out_of_range,
  admits: non_negative_int_admits
}


data at_least_minus_one_int_validation: Validation<Int> = Validation {
  reason: at_least_minus_one_int_out_of_range,
  admits: at_least_minus_one_int_admits
}


data at_least_minus_two_int_validation: Validation<Int> = Validation {
  reason: at_least_minus_two_int_out_of_range,
  admits: at_least_minus_two_int_admits
}


data exact_one_int_validation: Validation<Int> = Validation {
  reason: exact_one_int_out_of_range,
  admits: exact_one_int_admits
}


// Nominal ≥1 int — distinct from other int refinements (posix.dag / extdeps pattern).
// 🟡 gated — feature:refinement-opaque-carrier — bind T-25-tail — dissolve-on-arrival:
// construction only via make_*; forbidden: bare PositiveInt { refined: Refined { base } }.
type PositiveInt {
  refined: Refined<Int>
}


type NonNegativeInt {
  refined: Refined<Int>
}


type AtLeastMinusOneInt {
  refined: Refined<Int>
}


type AtLeastMinusTwoInt {
  refined: Refined<Int>
}


type ExactOneInt {
  refined: Refined<Int>
}


fn positive_int_value(p: PositiveInt) -> Int {
  refined_base(r: p.refined)
}


fn non_negative_int_value(p: NonNegativeInt) -> Int {
  refined_base(r: p.refined)
}


fn at_least_minus_one_int_value(p: AtLeastMinusOneInt) -> Int {
  refined_base(r: p.refined)
}


fn at_least_minus_two_int_value(p: AtLeastMinusTwoInt) -> Int {
  refined_base(r: p.refined)
}


fn exact_one_int_value(p: ExactOneInt) -> Int {
  refined_base(r: p.refined)
}


fn make_positive_int(value: Int, at: Locus) -> Outcome<PositiveInt> {
  match refine(base: value, by: positive_int_validation, at: at) {
    Accepted { value: refined, diagnostics: diagnostics } =>
      Accepted {
        value: PositiveInt { refined: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_non_negative_int(value: Int, at: Locus) -> Outcome<NonNegativeInt> {
  match refine(base: value, by: non_negative_int_validation, at: at) {
    Accepted { value: refined, diagnostics: diagnostics } =>
      Accepted {
        value: NonNegativeInt { refined: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_at_least_minus_one_int(value: Int, at: Locus) -> Outcome<AtLeastMinusOneInt> {
  match refine(base: value, by: at_least_minus_one_int_validation, at: at) {
    Accepted { value: refined, diagnostics: diagnostics } =>
      Accepted {
        value: AtLeastMinusOneInt { refined: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_at_least_minus_two_int(value: Int, at: Locus) -> Outcome<AtLeastMinusTwoInt> {
  match refine(base: value, by: at_least_minus_two_int_validation, at: at) {
    Accepted { value: refined, diagnostics: diagnostics } =>
      Accepted {
        value: AtLeastMinusTwoInt { refined: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_exact_one_int(value: Int, at: Locus) -> Outcome<ExactOneInt> {
  match refine(base: value, by: exact_one_int_validation, at: at) {
    Accepted { value: refined, diagnostics: diagnostics } =>
      Accepted {
        value: ExactOneInt { refined: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_positive_int_at_authoritative(value: Int) -> Outcome<PositiveInt> {
  make_positive_int(value: value, at: refinement_authoritative_locus())
}


fn make_non_negative_int_at_authoritative(value: Int) -> Outcome<NonNegativeInt> {
  make_non_negative_int(value: value, at: refinement_authoritative_locus())
}


fn make_at_least_minus_one_int_at_authoritative(value: Int) -> Outcome<AtLeastMinusOneInt> {
  make_at_least_minus_one_int(value: value, at: refinement_authoritative_locus())
}


fn make_at_least_minus_two_int_at_authoritative(value: Int) -> Outcome<AtLeastMinusTwoInt> {
  make_at_least_minus_two_int(value: value, at: refinement_authoritative_locus())
}


fn make_exact_one_int_at_authoritative(value: Int) -> Outcome<ExactOneInt> {
  make_exact_one_int(value: value, at: refinement_authoritative_locus())
}


fn positive_int_authoritative_literal(value: Int) -> Outcome<PositiveInt> {
  make_positive_int_at_authoritative(value: value)
}


fn non_negative_int_authoritative_literal(value: Int) -> Outcome<NonNegativeInt> {
  make_non_negative_int_at_authoritative(value: value)
}


fn at_least_minus_one_int_authoritative_literal(value: Int) -> Outcome<AtLeastMinusOneInt> {
  make_at_least_minus_one_int_at_authoritative(value: value)
}


fn at_least_minus_two_int_authoritative_literal(value: Int) -> Outcome<AtLeastMinusTwoInt> {
  make_at_least_minus_two_int_at_authoritative(value: value)
}


fn exact_one_int_authoritative_literal(value: Int) -> Outcome<ExactOneInt> {
  make_exact_one_int_at_authoritative(value: value)
}


// Formatter config fields use Outcome<Carrier>: *_authoritative_literal returns Outcome;
// .dag data literals cannot unwrap Rejected at assignment. Witness-proved Accepted for catalog
// values; runtime/user input uses make_* + Outcome. Bare-carrier catalog helpers that stripped
// Rejected were removed (P3); T-25-tail adds structural opacity for bare Refined/PositiveInt.
// Witnesses: refinement_formatter_literals_accept.dag (one per hoisted int type).
