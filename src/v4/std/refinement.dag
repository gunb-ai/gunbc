// src/v4/std/refinement.dag
// Scope: value-predicate refinement substrate — base type plus fail-closed validation obligation discharged at a named constructor boundary.
// Status: T-25-core modeled.
// Anchor: https://en.wikipedia.org/wiki/Refinement_type


module v4.std.refinement


import v4.std.logic { Bool }
import v4.std.diagnostic {
  Diagnostic,
  Locus,
  LocusAnchor,
  Outcome,
  Accepted,
  Rejected,
  None,
  PortLocus,
  Unavailable,
  UserInputBoundary,
  diagnostics_singleton
}
import v4.std.node { Symbol }


data refinement_authoritative_locus_port: Symbol = refinement_authoritative_locus


fn refinement_authoritative_locus() -> Locus {
  PortLocus { anchor: LocusAnchor { at: refinement_authoritative_locus_port } }
}
type Validation<B> {
  reason: Symbol
  admits: fn(B) -> Bool
}
type Refined<B> {
  base: B
}
fn refine<B>(base: B, by: Validation<B>, at: Locus) -> Outcome<Refined<B>> {
  let admits = by.admits
  if admits(base) {
    Accepted { value: Refined { base: base }, diagnostics: None }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: Diagnostic {
          reason: by.reason,
          at: at,
          correction: Unavailable { reason: UserInputBoundary }
        }
      )
    }
  }
}
fn refined_base<B>(r: Refined<B>) -> B {
  r.base
}


// Upstream-documented defaults and other author-known-valid substrate constants:
// discharge Validation at the authoritative boundary (not user/config input).
// User/config input must use refine/make_* with a real Locus.
// 🟡 gated — feature: refinement-opaque-carrier — bind T-25-tail — dissolve-on-arrival: Rejected arm becomes structurally unreachable when Refined is opaque and only refine exports carriers; forbidden: retaining direct Refined { base } construction for invalid bases.
fn refined_for_authoritative_constant<B>(base: B, by: Validation<B>) -> Refined<B> {
  match refine(base: base, by: by, at: refinement_authoritative_locus()) {
    Accepted { value: refined, diagnostics: _ } => refined
    Rejected { diagnostics: _ } => Refined { base: base }
  }
}
