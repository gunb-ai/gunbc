// src/v4/std/refinement.dag
// Scope: value-predicate refinement substrate — base type plus fail-closed validation obligation discharged at a named constructor boundary.
// Status: T-25-core modeled; structural ordered/unordered iteration refinement added (IterationOrdering / IterationClassifier<B> / refine_ordered_iteration).
// Anchor: https://en.wikipedia.org/wiki/Refinement_type


module v4.std.refinement


import v4.std.logic { Bool }
import v4.std.diagnostic {
  Diagnostic,
  Locus,
  Outcome,
  Accepted,
  Rejected,
  None,
  Unavailable,
  UserInputBoundary,
  diagnostics_singleton,
  port_locus
}
import v4.std.node { Symbol }


data refinement_authoritative_locus_port: Symbol = refinement_authoritative_locus


fn refinement_authoritative_locus() -> Locus {
  port_locus(port: refinement_authoritative_locus_port)
}


type Validation<B> {
  reason: Symbol
  admits: fn(B) -> Bool
}


type Refined<B> {
  base: B
}


fn positive_int_admits(value: Int) -> Bool {
  value >= 1
}


fn non_negative_int_admits(value: Int) -> Bool {
  value >= 0
}


fn at_least_minus_one_int_admits(value: Int) -> Bool {
  value >= -1
}


fn at_least_minus_two_int_admits(value: Int) -> Bool {
  value >= -2
}


fn exact_one_int_admits(value: Int) -> Bool {
  value == 1
}


data positive_int_out_of_range: Symbol = positive_int_out_of_range
data non_negative_int_out_of_range: Symbol = non_negative_int_out_of_range
data at_least_minus_one_int_out_of_range: Symbol = at_least_minus_one_int_out_of_range
data at_least_minus_two_int_out_of_range: Symbol = at_least_minus_two_int_out_of_range
data exact_one_int_out_of_range: Symbol = exact_one_int_out_of_range
data positive_int_validation: Validation<Int> = Validation {
  reason: positive_int_out_of_range,
  admits: positive_int_admits
}


data non_negative_int_validation: Validation<Int> = Validation {
  reason: non_negative_int_out_of_range,
  admits: non_negative_int_admits
}


data at_least_minus_one_int_validation: Validation<Int> = Validation {
  reason: at_least_minus_one_int_out_of_range,
  admits: at_least_minus_one_int_admits
}


data at_least_minus_two_int_validation: Validation<Int> = Validation {
  reason: at_least_minus_two_int_out_of_range,
  admits: at_least_minus_two_int_admits
}


data exact_one_int_validation: Validation<Int> = Validation {
  reason: exact_one_int_out_of_range,
  admits: exact_one_int_admits
}


// Nominal external-spec carriers — distinct record types so ≥1 / ≥0 / ≥-1 / ≥-2 / ==1
// obligations are not interchangeable Refined<Int> aliases (posix.dag pattern).
// 🟡 gated — feature:refinement-opaque-carrier — bind T-25-tail — dissolve-on-arrival:
// construction only via make_*; forbidden: bare PositiveInt { refined: Refined { base } }.
type PositiveInt {
  refined: Refined<Int>
}


// 🟡 gated — feature:refinement-opaque-carrier — bind T-25-tail — dissolve-on-arrival:
// construction only via make_*; forbidden: bare NonNegativeInt { refined: Refined { base } }.
type NonNegativeInt {
  refined: Refined<Int>
}


// 🟡 gated — feature:refinement-opaque-carrier — bind T-25-tail — dissolve-on-arrival:
// construction only via make_*; forbidden: bare AtLeastMinusOneInt { refined: Refined { base } }.
type AtLeastMinusOneInt {
  refined: Refined<Int>
}


// 🟡 gated — feature:refinement-opaque-carrier — bind T-25-tail — dissolve-on-arrival:
// construction only via make_*; forbidden: bare AtLeastMinusTwoInt { refined: Refined { base } }.
type AtLeastMinusTwoInt {
  refined: Refined<Int>
}


// 🟡 gated — feature:refinement-opaque-carrier — bind T-25-tail — dissolve-on-arrival:
// construction only via make_*; forbidden: bare ExactOneInt { refined: Refined { base } }.
type ExactOneInt {
  refined: Refined<Int>
}


fn refine<B>(base: B, by: Validation<B>, at: Locus) -> Outcome<Refined<B>> {
  let admits = by.admits
  if admits(base) {
    Accepted { value: Refined { base: base }, diagnostics: None }
  } else {
    Rejected {
      diagnostics: diagnostics_singleton(
        d: Diagnostic {
          reason: by.reason,
          at: at,
          correction: Unavailable { reason: UserInputBoundary }
        }
      )
    }
  }
}


fn refined_base<B>(r: Refined<B>) -> B {
  r.base
}


fn make_positive_int(value: Int, at: Locus) -> Outcome<PositiveInt> {
  match refine(base: value, by: positive_int_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: PositiveInt { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_non_negative_int(value: Int, at: Locus) -> Outcome<NonNegativeInt> {
  match refine(base: value, by: non_negative_int_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: NonNegativeInt { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_at_least_minus_one_int(value: Int, at: Locus) -> Outcome<AtLeastMinusOneInt> {
  match refine(base: value, by: at_least_minus_one_int_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: AtLeastMinusOneInt { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_at_least_minus_two_int(value: Int, at: Locus) -> Outcome<AtLeastMinusTwoInt> {
  match refine(base: value, by: at_least_minus_two_int_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: AtLeastMinusTwoInt { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_exact_one_int(value: Int, at: Locus) -> Outcome<ExactOneInt> {
  match refine(base: value, by: exact_one_int_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: ExactOneInt { refined: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_positive_int_at_authoritative(value: Int) -> Outcome<PositiveInt> {
  make_positive_int(value: value, at: refinement_authoritative_locus())
}


fn make_non_negative_int_at_authoritative(value: Int) -> Outcome<NonNegativeInt> {
  make_non_negative_int(value: value, at: refinement_authoritative_locus())
}


fn make_at_least_minus_one_int_at_authoritative(value: Int) -> Outcome<AtLeastMinusOneInt> {
  make_at_least_minus_one_int(value: value, at: refinement_authoritative_locus())
}


fn make_at_least_minus_two_int_at_authoritative(value: Int) -> Outcome<AtLeastMinusTwoInt> {
  make_at_least_minus_two_int(value: value, at: refinement_authoritative_locus())
}


fn make_exact_one_int_at_authoritative(value: Int) -> Outcome<ExactOneInt> {
  make_exact_one_int(value: value, at: refinement_authoritative_locus())
}


// Authoritative catalog literal boundary — partial; returns Outcome (fail-closed).
fn positive_int_authoritative_literal(value: Int) -> Outcome<PositiveInt> {
  make_positive_int_at_authoritative(value: value)
}


fn non_negative_int_authoritative_literal(value: Int) -> Outcome<NonNegativeInt> {
  make_non_negative_int_at_authoritative(value: value)
}


fn at_least_minus_one_int_authoritative_literal(value: Int) -> Outcome<AtLeastMinusOneInt> {
  make_at_least_minus_one_int_at_authoritative(value: value)
}


fn at_least_minus_two_int_authoritative_literal(value: Int) -> Outcome<AtLeastMinusTwoInt> {
  make_at_least_minus_two_int_at_authoritative(value: value)
}


fn exact_one_int_authoritative_literal(value: Int) -> Outcome<ExactOneInt> {
  make_exact_one_int_at_authoritative(value: value)
}


// Formatter config fields use Outcome<Carrier> (not bare Carrier): *_authoritative_literal and refine
// return Outcome; .dag data literals cannot unwrap Rejected at assignment. Rejected defaults are
// type-inhabitable but witness-proved Accepted for upstream catalog values; emit/runtime match or
// call make_*. Steady-state target is bare Carrier on fields (former formatter-int-refinement
// Refined<Int> intent) — bind T-25-tail / refinement-opaque-carrier for Outcome→Carrier once the
// substrate supports closed proof or discharge without stripping the receipt.
// Witnesses: refinement_formatter_literals_accept.dag; runtime/user input: make_* + Outcome.


// 🟢 coproduct dissolution — TERMINAL at the substrate scope.
// Structural marker classifying whether a collection carrier's iteration order is
// reproducible from its identity. Orderedness is a type-level property of the
// carrier (cons-list shapes such as `v4.std.collection.List` and tree-keyed map
// / set carriers are StructurallyOrdered; hash-bucket carriers such as
// `HashMap` / `HashSet` leak insertion-order and are StructurallyUnordered) —
// NOT a value
// predicate — so the existing `Validation<B>.admits: fn(B) -> Bool` shape cannot
// express it. The unordered arm carries no payload: hash-iteration is the only
// iteration-shaped non-determinism source at this substrate scope, and typing the
// arm over a broader set of non-determinism sources would admit nonsensical
// constructions. If a second iteration-leak source emerges, carve a sub-coproduct
// rather than widening this arm.
type IterationOrdering
  = StructurallyOrdered
  | StructurallyUnordered
data naming_the_leak: Symbol = naming_the_leak
// Ordering classifier — mirrors `Validation<B>` above. The classifier is
// parametric on the carrier `B`; concrete `IterationClassifier<HashMap<K,V>>` /
// `IterationClassifier<BTreeMap<K,V>>` instances are authored *per carrier* at
// the layer that owns each carrier's type identity (substrate `v4.std.collection`
// for stdlib carriers; lens / compiler layers for downstream carriers), and ALWAYS
// return `StructurallyUnordered` for hash carriers and `StructurallyOrdered` for
// ordered carriers — there is no caller choice at the authoring layer. The
// refinement consumes the classifier; passing a forged `fn(B) -> StructurallyOrdered`
// for an unordered B is the same caller-discipline boundary as forging
// `Validation<B>.admits` to always return `true` (already accepted in this file
// for `refine`). INVARIANTS P2 (named-edge derivation, no parallel caller-
// supplied facts beside `base`) is preserved because the classification is
// derived from `base` by the obligation discharger, not declared alongside it.
// True structural derivation — making forgery unrepresentable rather than merely
// disciplined — requires a carrier-keyed witness lookup beyond this substrate
// scope and lands at downstream lens / compiler retrofit layers.
type IterationClassifier<B> {
  classify: fn(B) -> IterationOrdering
}
// Refinement constructor: admits a base collection for deterministic iteration
// only when the supplied classifier derives `StructurallyOrdered` from `base`.
// The unordered arm fails closed with the `naming_the_leak` diagnostic. Shape
// mirrors `refine` above: caller passes `base` and a B-parametric obligation; the
// constructor matches on the discharged classification.
fn refine_ordered_iteration<B>(base: B, by: IterationClassifier<B>, at: Locus) -> Outcome<Refined<B>> {
  let classify = by.classify
  match classify(base) {
    StructurallyOrdered =>
      Accepted { value: Refined { base: base }, diagnostics: None }
    StructurallyUnordered =>
      Rejected {
        diagnostics: diagnostics_singleton(
          d: Diagnostic {
            reason: naming_the_leak,
            at: at,
            correction: Unavailable { reason: UserInputBoundary }
          }
        )
      }
  }
}
