// src/v4/std/agent.dag
// Scope: agent-supplied single-module source carrier for filesystem-free compiler ingest.
// Owns: AgentModuleSource, AgentStore.
// Consumes: std/module_graph.dag, std/node.dag, std/text.dag.
// Status: T-35 modeled — agent store is a virtual module-loader input, not filesystem authority.
// Anchor: docs/design-read-edit-pipeline.md §6.10 (library-first agent surface)

module v4.std.agent

import v4.std.module_graph { ModulePath }
import v4.std.node { Symbol }
import v4.std.text { String }


type AgentModuleSource {
  file: Symbol
  source: String
}


// 🟡 single-module agent store scaffold: feature:T-35-agent-store-single-module.
// Owner/lane: T-28-B module admission + T-35 multi-module agent ingest.
// Dissolve-on: AgentStore carries ordered ModuleEntry source entries plus an
// independent root ModulePath, and compile_with_store feeds source-derived imports.
type AgentStore {
  entry: ModulePath
  module: AgentModuleSource
}
