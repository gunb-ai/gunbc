// src/v4/std/model_core.dag
// Scope: Ratified Q1 shared ModelCore substrate for LanguageModel and HostModel extension.
// Owns: ModelCore, PrimitiveFactBundle, AlgebraInhabitanceDecl, AlgebraLawObligation, EffectSemanticsDecl, PartialitySemanticsDecl, PartialOperationDecl, PartialityDischarge, primitive_fact_axis_width, primitive_fact_axis_signedness, primitive_fact_axis_range, primitive_fact_axis_encoding, wave1_void
// Consumes: v4.std.collection, v4.std.node
// Status: T-33 modeled.


module v4.std.model_core


import v4.std.collection { List }
import v4.std.node { Node, Symbol }


data primitive_fact_axis_width: Symbol = primitive_fact_axis_width
data primitive_fact_axis_signedness: Symbol = primitive_fact_axis_signedness
data primitive_fact_axis_range: Symbol = primitive_fact_axis_range
data primitive_fact_axis_encoding: Symbol = primitive_fact_axis_encoding


type PrimitiveFactBundle {
  substrate_carrier: Node
  spec_facts: Node
}


type AlgebraInhabitanceDecl {
  algebra: Node
  inhabitant: Node
  witness: Node
}


type AlgebraLawObligation {
  inhabitance_witness: Node
  law: Node
}


type PrimitiveOperationRef {
  operation: Node
  effect_signature: Node
}


// 🟡 needs-more-work — feature:model-core-effect-semantics — scaffold:T-33-model-core · dissolve-on: T-33 (#3474) binds EffectSemanticsDecl.operations when first PrimitiveOperationRef carries non-trivial effect (ledger: T-33 · TASKS.md § T-33)
type EffectSemanticsDecl {
  operations: List<PrimitiveOperationRef>
}


type PartialOperationDecl {
  operation: Node
  precondition: Node
  discharge: PartialityDischarge
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PartialityDischarge
  = FailClosedAtBoundary { reason: Symbol }
  | RefinementHonoring { validation: Node }


// 🟡 needs-more-work — feature:model-core-partiality-semantics — scaffold:T-33-model-core · dissolve-on: T-33 (#3474) populates PartialitySemanticsDecl.operations per operator partiality substrate (ledger: T-33 · TASKS.md § T-33)
type PartialitySemanticsDecl {
  operations: List<PartialOperationDecl>
}


type ModelCore {
  primitives: List<PrimitiveFactBundle>
  inhabitance: List<AlgebraInhabitanceDecl>
  laws: List<AlgebraLawObligation>
  effects: EffectSemanticsDecl
  partiality: PartialitySemanticsDecl
}


// 🟡 needs-more-work — feature:model-core-wave1-void-scaffold — dissolve-on: LanguageModel or HostModel carries first non-empty ModelCore (T-4 / T-34)
fn wave1_void() -> ModelCore {
  ModelCore {
    primitives: [],
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}
