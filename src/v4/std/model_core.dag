// src/v4/std/model_core.dag
// Scope: Shared ModelCore substrate for LanguageModel and concrete runtime extdeps.
// Owns: ModelCore, PrimitiveFactBundle, primitive_fact_axis_unbound_diagnostic, AlgebraInhabitanceDecl, AlgebraLawObligation, EffectSignature, ResourceAccess, EffectSemanticsDecl, PartialitySemanticsDecl, PartialOperationDecl, PartialityDischarge, primitive_fact_axis_width, primitive_fact_axis_signedness, primitive_fact_axis_range, primitive_fact_axis_encoding, primitive_fact_axis_surface_spelling, primitive_fact_axis_overflow_disposition, wave1_model_core, wave1_void, model_core_wave1_bool_law_bounded_lattice_identities, model_core_wave1_bool_law_complement_involution, model_core_wave1_bool_law_complement_bounds, model_core_wave1_law_field_subject, model_core_wave1_law_field_algebra, model_core_wave1_law_field_kind
// Consumes: v4.std.collection, v4.std.logic, v4.std.node
// Status: T-33 modeled.


module v4.std.model_core


import v4.std.collection { List, Map }
import v4.std.diagnostic {
  Diagnostic,
  Textual,
  Unavailable,
  UserInputBoundary,
  WholeFile
}
import v4.std.logic { bool_boolean_algebra_node, bool_boolean_algebra_type_node, bool_node, bool_spec_fact_encoding_classical_two_valued, bool_spec_fact_width_one_bit }
import v4.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode }
import v4.std.witness { Holds, Violates, Witness }


data primitive_fact_axis_width: Symbol = primitive_fact_axis_width
data primitive_fact_axis_signedness: Symbol = primitive_fact_axis_signedness
// 🟡 needs-more-work — feature:primitive-fact-axis-range-unbound — scaffold:T-33-model-core · dissolve-on: rust.dag (or any LanguageModel extdep) gains a per-primitive range source carrier (e.g. range_min/range_max fields on RustIntegerPrimitiveFacts) and binds this axis in spec_facts (ledger: T-33 · TASKS.md § T-33)
data primitive_fact_axis_range: Symbol = primitive_fact_axis_range
data primitive_fact_axis_encoding: Symbol = primitive_fact_axis_encoding
data primitive_fact_axis_surface_spelling: Symbol = primitive_fact_axis_surface_spelling
data primitive_fact_axis_overflow_disposition: Symbol = primitive_fact_axis_overflow_disposition


type PrimitiveFactBundle {
  substrate_carrier: Node
  spec_facts: Map<Symbol, Node>
}


data primitive_fact_axis_unbound_reason: Symbol = primitive_fact_axis_unbound_reason


fn primitive_fact_axis_unbound_diagnostic(axis: Symbol) -> Diagnostic {
  Diagnostic {
    reason: primitive_fact_axis_unbound_reason,
    at: Textual { file: axis, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


type AlgebraInhabitanceDecl {
  algebra: Node
  inhabitant: Node
  witness: Node
}


type AlgebraLawObligation {
  inhabitance_witness: Node
  law: Node
}


type ResourceAccess {
  resource: Node
}


type EffectSignature {
  signature: Node
}


type PrimitiveOperationRef {
  operation: Node
  effect_signature: EffectSignature
}


// 🟡 needs-more-work — feature:model-core-effect-semantics — scaffold:T-33-model-core · dissolve-on: T-33 (#3474) binds EffectSemanticsDecl.operations when first PrimitiveOperationRef carries non-trivial effect (ledger: T-33 · TASKS.md § T-33)
type EffectSemanticsDecl {
  operations: List<PrimitiveOperationRef>
}


type PartialOperationDecl {
  operation: Node
  precondition: Node
  discharge: PartialityDischarge
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type PartialityDischarge
  = FailClosedAtBoundary { reason: Symbol }
  | RefinementHonoring { validation: Node }


// 🟡 needs-more-work — feature:model-core-partiality-semantics — scaffold:T-33-model-core · dissolve-on: T-33 (#3474) populates PartialitySemanticsDecl.operations per operator partiality substrate (ledger: T-33 · TASKS.md § T-33)
type PartialitySemanticsDecl {
  operations: List<PartialOperationDecl>
}


type ModelCore {
  primitives: List<PrimitiveFactBundle>
  inhabitance: List<AlgebraInhabitanceDecl>
  laws: List<AlgebraLawObligation>
  effects: EffectSemanticsDecl
  partiality: PartialitySemanticsDecl
}


// 🟡 needs-more-work — feature:model-core-law-expression-carrier — scaffold:T-33-wave2 · the law-kind symbols below are bounded schedule keys for BooleanAlgebra law obligations; the law Node also carries the structural algebra Node and inhabitance witness. dissolve-on: std/algebra exports typed law/equation Nodes for BooleanAlgebra laws, replacing these kind atoms with structural law expressions.
data model_core_wave1_bool_law_bounded_lattice_identities: Symbol = model_core_wave1_bool_law_bounded_lattice_identities
data model_core_wave1_bool_law_complement_involution: Symbol = model_core_wave1_bool_law_complement_involution
data model_core_wave1_bool_law_complement_bounds: Symbol = model_core_wave1_bool_law_complement_bounds
data model_core_wave1_law_field_subject: Symbol = model_core_wave1_law_field_subject
data model_core_wave1_law_field_algebra: Symbol = model_core_wave1_law_field_algebra
data model_core_wave1_law_field_kind: Symbol = model_core_wave1_law_field_kind


fn model_core_wave1_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: []
  }
}


fn model_core_wave1_bool_spec_facts() -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      match axis {
        primitive_fact_axis_width =>
          Holds { value: model_core_wave1_atom(id: bool_spec_fact_width_one_bit) }
        primitive_fact_axis_encoding =>
          Holds { value: model_core_wave1_atom(id: bool_spec_fact_encoding_classical_two_valued) }
        _ =>
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}


fn model_core_wave1_bool_primitive_bundle() -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: bool_node(),
    spec_facts: model_core_wave1_bool_spec_facts()
  }
}


fn model_core_wave1_bool_inhabitance_witness() -> Node {
  bool_boolean_algebra_node()
}


fn model_core_wave1_bool_algebra_node() -> Node {
  bool_boolean_algebra_type_node()
}


fn model_core_wave1_bool_inhabitance() -> AlgebraInhabitanceDecl {
  let witness = model_core_wave1_bool_inhabitance_witness()
  AlgebraInhabitanceDecl {
    algebra: model_core_wave1_bool_algebra_node(),
    inhabitant: bool_node(),
    witness: witness
  }
}


fn model_core_wave1_law_node(law: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: model_core_wave1_law_field_subject },
        target: model_core_wave1_bool_inhabitance_witness()
      },
      Edge {
        label: Named { name: model_core_wave1_law_field_algebra },
        target: model_core_wave1_bool_algebra_node()
      },
      Edge {
        label: Named { name: model_core_wave1_law_field_kind },
        target: model_core_wave1_atom(id: law)
      },
    ]
  }
}


fn model_core_wave1_bool_law_obligation(law: Symbol) -> AlgebraLawObligation {
  AlgebraLawObligation {
    inhabitance_witness: model_core_wave1_bool_inhabitance_witness(),
    law: model_core_wave1_law_node(law: law)
  }
}


fn wave1_model_core() -> ModelCore {
  ModelCore {
    primitives: [
      model_core_wave1_bool_primitive_bundle(),
    ],
    inhabitance: [
      model_core_wave1_bool_inhabitance(),
    ],
    laws: [
      model_core_wave1_bool_law_obligation(law: model_core_wave1_bool_law_bounded_lattice_identities),
      model_core_wave1_bool_law_obligation(law: model_core_wave1_bool_law_complement_involution),
      model_core_wave1_bool_law_obligation(law: model_core_wave1_bool_law_complement_bounds),
    ],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}


fn wave1_void() -> ModelCore {
  wave1_model_core()
}
