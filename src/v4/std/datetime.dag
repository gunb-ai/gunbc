// src/v4/std/datetime.dag
// Scope: RFC 3339 clock-calendar instant facts for format-layer consumers.
// Anchor: https://datatracker.ietf.org/doc/html/rfc3339
// Anchor: https://en.wikipedia.org/wiki/Gregorian_calendar
// Owns: Instant, RFC 3339 date/time field carriers, local date/time profiles,
//       UTC offset carriers, and validation-discharge constructors.
// Consumes: std collection, std diagnostic, std nat, std refinement, std node.
// Status: 🟢 T-3 modeled.

module v4.std.datetime


import v4.std.diagnostic { Locus, Outcome, bind_outcome, outcome_accepted }
import v4.std.collection { List }
import v4.std.nat { Nat }
import v4.std.node { Symbol }
import v4.std.refinement { Refined, Validation, refine, refined_base }


type Year {
  value: Refined<Nat>
}


type MonthOrdinal {
  value: Refined<Nat>
}


type DayOrdinal {
  value: Refined<Nat>
}


type HourOfDay {
  value: Refined<Nat>
}


type MinuteOfHour {
  value: Refined<Nat>
}


type SecondOfMinute {
  value: Refined<Nat>
}


// 🟢 coproduct dissolution — RFC 3339 secfrac digits are decimal digits.
type SecfracDigit
  = SecfracDigit0
  | SecfracDigit1
  | SecfracDigit2
  | SecfracDigit3
  | SecfracDigit4
  | SecfracDigit5
  | SecfracDigit6
  | SecfracDigit7
  | SecfracDigit8
  | SecfracDigit9


type SecfracDigits {
  first: SecfracDigit
  rest: List<SecfracDigit>
}


// 🟢 coproduct dissolution — RFC 3339 secfrac is present or absent at the user-input boundary.
type Subsecond
  = NoSubsecond
  | FractionalSecond { digits: SecfracDigits }


// 🟢 coproduct dissolution — RFC 3339 numeric UTC offsets are explicitly signed.
type TzOffsetSign
  = TzOffsetPlus
  | TzOffsetMinus


type TzOffsetHour {
  value: Refined<Nat>
}


type TzOffsetMinute {
  value: Refined<Nat>
}


type NumericTzOffset {
  sign: TzOffsetSign
  hour: TzOffsetHour
  minute: TzOffsetMinute
}


// 🟢 coproduct dissolution — RFC 3339 time-offset grammar is "Z" or signed numeric offset.
type TzOffset
  = UtcZ
  | SignedOffset { offset: NumericTzOffset }


type CalendarDateFields {
  year: Year
  month: MonthOrdinal
  day: DayOrdinal
}


type CalendarDateValidity {
  refined: Refined<CalendarDateFields>
}


type CalendarDate {
  validity: CalendarDateValidity
}


type ClockTimeFields {
  hour: HourOfDay
  minute: MinuteOfHour
  second: SecondOfMinute
  subsecond: Subsecond
}


type ClockTime {
  fields: ClockTimeFields
}


type LocalDate {
  date: CalendarDate
}


type LocalTime {
  time: ClockTime
}


type LocalDateTime {
  date: CalendarDate
  time: ClockTime
}


type OrdinaryInstantFields {
  date: CalendarDate
  time: ClockTime
  offset: TzOffset
}


type LeapSecondAnnouncement {
  utc_date: CalendarDate
  utc_hour: HourOfDay
  utc_minute: MinuteOfHour
}


type LeapSecondInstantFields {
  announcement: LeapSecondAnnouncement
  second: SecondOfMinute
  subsecond: Subsecond
}


type LeapSecondOffsetRepresentation {
  instant: LeapSecondInstantFields
  local_date: CalendarDate
  local_hour: HourOfDay
  local_minute: MinuteOfHour
  offset: TzOffset
}


type OrdinaryInstantValidity {
  refined: Refined<OrdinaryInstantFields>
}


type LeapSecondInstantValidity {
  refined: Refined<LeapSecondInstantFields>
}


// 🟢 coproduct dissolution — RFC 3339 separates ordinary instants from announced leap-second instants.
type Instant
  = OrdinaryInstant { validity: OrdinaryInstantValidity }
  | LeapSecondInstant { validity: LeapSecondInstantValidity }


type OffsetDateTime {
  instant: Instant
}


// 🟢 coproduct dissolution — TOML §Date-Time exposes these four closed user-input profiles.
type DateTimeValue
  = OffsetDateTimeValue { value: OffsetDateTime }
  | LocalDateTimeValue { value: LocalDateTime }
  | LocalDateValue { value: LocalDate }
  | LocalTimeValue { value: LocalTime }


data year_out_of_range: Symbol = year_out_of_range
data month_out_of_range: Symbol = month_out_of_range
data day_out_of_range: Symbol = day_out_of_range
data hour_out_of_range: Symbol = hour_out_of_range
data minute_out_of_range: Symbol = minute_out_of_range
data second_out_of_range: Symbol = second_out_of_range
data tz_offset_hour_out_of_range: Symbol = tz_offset_hour_out_of_range
data tz_offset_minute_out_of_range: Symbol = tz_offset_minute_out_of_range
data calendar_date_invalid: Symbol = calendar_date_invalid
data ordinary_instant_invalid: Symbol = ordinary_instant_invalid
data leap_second_instant_invalid: Symbol = leap_second_instant_invalid


fn year_value(year: Year) -> Nat {
  refined_base(r: year.value)
}


fn month_value(month: MonthOrdinal) -> Nat {
  refined_base(r: month.value)
}


fn day_value(day: DayOrdinal) -> Nat {
  refined_base(r: day.value)
}


fn second_value(second: SecondOfMinute) -> Nat {
  refined_base(r: second.value)
}


fn minute_value(minute: MinuteOfHour) -> Nat {
  refined_base(r: minute.value)
}


fn hour_value(hour: HourOfDay) -> Nat {
  refined_base(r: hour.value)
}


fn year_admits(value: Nat) -> Bool {
  value <= 9999
}


fn month_admits(value: Nat) -> Bool {
  (value >= 1) && (value <= 12)
}


fn day_admits(value: Nat) -> Bool {
  (value >= 1) && (value <= 31)
}


fn hour_admits(value: Nat) -> Bool {
  value <= 23
}


fn minute_admits(value: Nat) -> Bool {
  value <= 59
}


fn second_admits(value: Nat) -> Bool {
  value <= 60
}


fn tz_offset_hour_admits(value: Nat) -> Bool {
  value <= 23
}


fn tz_offset_minute_admits(value: Nat) -> Bool {
  value <= 59
}


fn divisible_by_4(value: Nat) -> Bool {
  (value % 4) == 0
}


fn divisible_by_100(value: Nat) -> Bool {
  (value % 100) == 0
}


fn divisible_by_400(value: Nat) -> Bool {
  (value % 400) == 0
}


fn leap_year(value: Nat) -> Bool {
  divisible_by_4(value: value)
    && (!divisible_by_100(value: value) || divisible_by_400(value: value))
}


fn calendar_date_admits(fields: CalendarDateFields) -> Bool {
  let year = year_value(year: fields.year)
  let month = month_value(month: fields.month)
  let day = day_value(day: fields.day)
  match month {
    1 => day <= 31
    2 => if leap_year(value: year) {
      day <= 29
    } else {
      day <= 28
    }
    3 => day <= 31
    4 => day <= 30
    5 => day <= 31
    6 => day <= 30
    7 => day <= 31
    8 => day <= 31
    9 => day <= 30
    10 => day <= 31
    11 => day <= 30
    12 => day <= 31
    _ => false
  }
}


fn calendar_date_fields(date: CalendarDate) -> CalendarDateFields {
  refined_base(r: date.validity.refined)
}


fn leap_second_month_end(fields: CalendarDateFields) -> Bool {
  let month = month_value(month: fields.month)
  let day = day_value(day: fields.day)
  ((month == 6) && (day == 30)) || ((month == 12) && (day == 31))
}


fn leap_second_announcement_admits(announcement: LeapSecondAnnouncement) -> Bool {
  let fields = calendar_date_fields(date: announcement.utc_date)
  let hour = hour_value(hour: announcement.utc_hour)
  let minute = minute_value(minute: announcement.utc_minute)
  (hour == 23) && (minute == 59) && leap_second_month_end(fields: fields)
}


fn ordinary_instant_admits(fields: OrdinaryInstantFields) -> Bool {
  let second = second_value(second: fields.time.fields.second)
  second <= 59
}


fn leap_second_instant_admits(fields: LeapSecondInstantFields) -> Bool {
  let second = second_value(second: fields.second)
  (second == 60)
    && leap_second_announcement_admits(announcement: fields.announcement)
}


data year_validation: Validation<Nat> = Validation {
  reason: year_out_of_range,
  admits: year_admits
}


data month_validation: Validation<Nat> = Validation {
  reason: month_out_of_range,
  admits: month_admits
}


data day_validation: Validation<Nat> = Validation {
  reason: day_out_of_range,
  admits: day_admits
}


data hour_validation: Validation<Nat> = Validation {
  reason: hour_out_of_range,
  admits: hour_admits
}


data minute_validation: Validation<Nat> = Validation {
  reason: minute_out_of_range,
  admits: minute_admits
}


data second_validation: Validation<Nat> = Validation {
  reason: second_out_of_range,
  admits: second_admits
}


data tz_offset_hour_validation: Validation<Nat> = Validation {
  reason: tz_offset_hour_out_of_range,
  admits: tz_offset_hour_admits
}


data tz_offset_minute_validation: Validation<Nat> = Validation {
  reason: tz_offset_minute_out_of_range,
  admits: tz_offset_minute_admits
}


data calendar_date_validation: Validation<CalendarDateFields> = Validation {
  reason: calendar_date_invalid,
  admits: calendar_date_admits
}


data ordinary_instant_validation: Validation<OrdinaryInstantFields> = Validation {
  reason: ordinary_instant_invalid,
  admits: ordinary_instant_admits
}


data leap_second_instant_validation: Validation<LeapSecondInstantFields> = Validation {
  reason: leap_second_instant_invalid,
  admits: leap_second_instant_admits
}


fn make_year(value: Nat, at: Locus) -> Outcome<Year> {
  bind_outcome(o: refine(base: value, by: year_validation, at: at), f: fn(refined) {
    outcome_accepted(value: Year { value: refined })
  })
}


fn make_month_ordinal(value: Nat, at: Locus) -> Outcome<MonthOrdinal> {
  bind_outcome(o: refine(base: value, by: month_validation, at: at), f: fn(refined) {
    outcome_accepted(value: MonthOrdinal { value: refined })
  })
}


fn make_day_ordinal(value: Nat, at: Locus) -> Outcome<DayOrdinal> {
  bind_outcome(o: refine(base: value, by: day_validation, at: at), f: fn(refined) {
    outcome_accepted(value: DayOrdinal { value: refined })
  })
}


fn make_hour_of_day(value: Nat, at: Locus) -> Outcome<HourOfDay> {
  bind_outcome(o: refine(base: value, by: hour_validation, at: at), f: fn(refined) {
    outcome_accepted(value: HourOfDay { value: refined })
  })
}


fn make_minute_of_hour(value: Nat, at: Locus) -> Outcome<MinuteOfHour> {
  bind_outcome(o: refine(base: value, by: minute_validation, at: at), f: fn(refined) {
    outcome_accepted(value: MinuteOfHour { value: refined })
  })
}


fn make_second_of_minute(value: Nat, at: Locus) -> Outcome<SecondOfMinute> {
  bind_outcome(o: refine(base: value, by: second_validation, at: at), f: fn(refined) {
    outcome_accepted(value: SecondOfMinute { value: refined })
  })
}


fn make_subsecond(digits: SecfracDigits) -> Subsecond {
  FractionalSecond { digits: digits }
}


fn make_tz_offset_hour(value: Nat, at: Locus) -> Outcome<TzOffsetHour> {
  bind_outcome(o: refine(base: value, by: tz_offset_hour_validation, at: at), f: fn(refined) {
    outcome_accepted(value: TzOffsetHour { value: refined })
  })
}


fn make_tz_offset_minute(value: Nat, at: Locus) -> Outcome<TzOffsetMinute> {
  bind_outcome(o: refine(base: value, by: tz_offset_minute_validation, at: at), f: fn(refined) {
    outcome_accepted(value: TzOffsetMinute { value: refined })
  })
}


fn make_calendar_date(fields: CalendarDateFields, at: Locus) -> Outcome<CalendarDate> {
  bind_outcome(o: refine(base: fields, by: calendar_date_validation, at: at), f: fn(refined) {
    outcome_accepted(value: CalendarDate { validity: CalendarDateValidity { refined: refined } })
  })
}


fn make_clock_time(fields: ClockTimeFields) -> ClockTime {
  ClockTime { fields: fields }
}


fn make_ordinary_instant(fields: OrdinaryInstantFields, at: Locus) -> Outcome<Instant> {
  bind_outcome(o: refine(base: fields, by: ordinary_instant_validation, at: at), f: fn(refined) {
    outcome_accepted(value: OrdinaryInstant { validity: OrdinaryInstantValidity { refined: refined } })
  })
}


fn make_leap_second_instant(fields: LeapSecondInstantFields, at: Locus) -> Outcome<Instant> {
  bind_outcome(o: refine(base: fields, by: leap_second_instant_validation, at: at), f: fn(refined) {
    outcome_accepted(value: LeapSecondInstant { validity: LeapSecondInstantValidity { refined: refined } })
  })
}
