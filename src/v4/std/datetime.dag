// src/v4/std/datetime.dag
// Scope: RFC 3339 clock-calendar instant facts for format-layer consumers.
// Anchor: https://datatracker.ietf.org/doc/html/rfc3339
// Owns: Instant, RFC 3339 date/time field carriers, local date/time profiles,
//       UTC offset carriers, and validation-discharge constructors.
// Consumes: std diagnostic, std nat, std text, std refinement, std node.
// Status: 🟢 T-3 modeled.

module v4.std.datetime


import v4.std.diagnostic { Accepted, Locus, Outcome, Rejected }
import v4.std.nat { Nat }
import v4.std.node { Symbol }
import v4.std.refinement { Refined, Validation, refine }
import v4.std.text { String }


type FourDigitYearLexeme {
  text: String
}


type TwoDigitFieldLexeme {
  text: String
}


type SubsecondLexeme {
  text: String
}


type ParsedFourDigitYearLexeme {
  lexeme: FourDigitYearLexeme
  value: Nat
}


type ParsedTwoDigitFieldLexeme {
  lexeme: TwoDigitFieldLexeme
  value: Nat
}


type Year {
  parsed: Refined<ParsedFourDigitYearLexeme>
}


type MonthOrdinal {
  parsed: Refined<ParsedTwoDigitFieldLexeme>
}


type DayOrdinal {
  parsed: Refined<ParsedTwoDigitFieldLexeme>
}


type HourOfDay {
  parsed: Refined<ParsedTwoDigitFieldLexeme>
}


type MinuteOfHour {
  parsed: Refined<ParsedTwoDigitFieldLexeme>
}


type SecondOfMinute {
  parsed: Refined<ParsedTwoDigitFieldLexeme>
}


type Nanoseconds {
  value: Refined<Nat>
}


type SubsecondDigitCount {
  value: Refined<Nat>
}


type ParsedSubsecondLexeme {
  lexeme: SubsecondLexeme
  digit_count: SubsecondDigitCount
  nanosecond_projection: Nanoseconds
}


// 🟢 coproduct dissolution — RFC 3339 secfrac is present or absent at the user-input boundary.
type Subsecond
  = NoSubsecond
  | FractionalSecond { parsed: ParsedSubsecondLexeme }


// 🟢 coproduct dissolution — RFC 3339 numeric UTC offsets are explicitly signed.
type TzOffsetSign
  = TzOffsetPlus
  | TzOffsetMinus


type TzOffsetHour {
  parsed: Refined<ParsedTwoDigitFieldLexeme>
}


type TzOffsetMinute {
  parsed: Refined<ParsedTwoDigitFieldLexeme>
}


type NumericTzOffset {
  sign: TzOffsetSign
  hour: TzOffsetHour
  minute: TzOffsetMinute
}


// 🟢 coproduct dissolution — RFC 3339 time-offset grammar is "Z" or signed numeric offset.
type TzOffset
  = UtcZ
  | SignedOffset { offset: NumericTzOffset }


type CalendarDateFields {
  year: Year
  month: MonthOrdinal
  day: DayOrdinal
}


type CalendarDateValidity {
  refined: Refined<CalendarDateFields>
}


type CalendarDate {
  validity: CalendarDateValidity
}


type ClockTimeFields {
  hour: HourOfDay
  minute: MinuteOfHour
  second: SecondOfMinute
  subsecond: Subsecond
}


type ClockTime {
  fields: ClockTimeFields
}


type LocalDate {
  date: CalendarDate
}


type LocalTime {
  time: ClockTime
}


type LocalDateTime {
  date: CalendarDate
  time: ClockTime
}


// 🟢 coproduct dissolution — second 60 either is not present or is backed by leap-second evidence.
type LeapSecondEvidence
  = NoLeapSecond
  | LeapSecondPermitted { authority: Symbol }


type InstantFields {
  date: CalendarDate
  time: ClockTime
  offset: TzOffset
  leap_second: LeapSecondEvidence
}


type InstantValidity {
  refined: Refined<InstantFields>
}


type Instant {
  validity: InstantValidity
}


type OffsetDateTime {
  instant: Instant
}


// 🟢 coproduct dissolution — TOML §Date-Time exposes these four closed user-input profiles.
type DateTimeValue
  = OffsetDateTimeValue { value: OffsetDateTime }
  | LocalDateTimeValue { value: LocalDateTime }
  | LocalDateValue { value: LocalDate }
  | LocalTimeValue { value: LocalTime }


data year_out_of_range: Symbol = year_out_of_range
data month_out_of_range: Symbol = month_out_of_range
data day_out_of_range: Symbol = day_out_of_range
data hour_out_of_range: Symbol = hour_out_of_range
data minute_out_of_range: Symbol = minute_out_of_range
data second_out_of_range: Symbol = second_out_of_range
data nanoseconds_out_of_range: Symbol = nanoseconds_out_of_range
data subsecond_digits_out_of_range: Symbol = subsecond_digits_out_of_range
data tz_offset_hour_out_of_range: Symbol = tz_offset_hour_out_of_range
data tz_offset_minute_out_of_range: Symbol = tz_offset_minute_out_of_range
data calendar_date_invalid: Symbol = calendar_date_invalid
data instant_invalid: Symbol = instant_invalid


fn year_value(year: Year) -> Nat {
  year.parsed.base.value
}


fn month_value(month: MonthOrdinal) -> Nat {
  month.parsed.base.value
}


fn day_value(day: DayOrdinal) -> Nat {
  day.parsed.base.value
}


fn second_value(second: SecondOfMinute) -> Nat {
  second.parsed.base.value
}


fn year_admits(parsed: ParsedFourDigitYearLexeme) -> Bool {
  (parsed.value >= 1) && (parsed.value <= 9999)
}


fn month_admits(parsed: ParsedTwoDigitFieldLexeme) -> Bool {
  (parsed.value >= 1) && (parsed.value <= 12)
}


fn day_admits(parsed: ParsedTwoDigitFieldLexeme) -> Bool {
  (parsed.value >= 1) && (parsed.value <= 31)
}


fn hour_admits(parsed: ParsedTwoDigitFieldLexeme) -> Bool {
  parsed.value <= 23
}


fn minute_admits(parsed: ParsedTwoDigitFieldLexeme) -> Bool {
  parsed.value <= 59
}


fn second_admits(parsed: ParsedTwoDigitFieldLexeme) -> Bool {
  parsed.value <= 60
}


fn nanoseconds_admits(value: Nat) -> Bool {
  value <= 999999999
}


fn subsecond_digit_count_admits(value: Nat) -> Bool {
  value >= 1
}


fn tz_offset_hour_admits(parsed: ParsedTwoDigitFieldLexeme) -> Bool {
  parsed.value <= 23
}


fn tz_offset_minute_admits(parsed: ParsedTwoDigitFieldLexeme) -> Bool {
  parsed.value <= 59
}


fn divisible_by(value: Nat, divisor: Nat) -> Bool {
  (value % divisor) == 0
}


fn leap_year(value: Nat) -> Bool {
  divisible_by(value: value, divisor: 4)
    && (!divisible_by(value: value, divisor: 100) || divisible_by(value: value, divisor: 400))
}


fn calendar_date_admits(fields: CalendarDateFields) -> Bool {
  let year = year_value(year: fields.year)
  let month = month_value(month: fields.month)
  let day = day_value(day: fields.day)
  match month {
    1 => day <= 31
    2 => if leap_year(value: year) {
      day <= 29
    } else {
      day <= 28
    }
    3 => day <= 31
    4 => day <= 30
    5 => day <= 31
    6 => day <= 30
    7 => day <= 31
    8 => day <= 31
    9 => day <= 30
    10 => day <= 31
    11 => day <= 30
    12 => day <= 31
    _ => false
  }
}


fn instant_admits(fields: InstantFields) -> Bool {
  let second = second_value(second: fields.time.fields.second)
  if second == 60 {
    match fields.leap_second {
      NoLeapSecond => false
      LeapSecondPermitted { authority: _ } => true
    }
  } else {
    true
  }
}


data year_validation: Validation<ParsedFourDigitYearLexeme> = Validation {
  reason: year_out_of_range,
  admits: year_admits
}


data month_validation: Validation<ParsedTwoDigitFieldLexeme> = Validation {
  reason: month_out_of_range,
  admits: month_admits
}


data day_validation: Validation<ParsedTwoDigitFieldLexeme> = Validation {
  reason: day_out_of_range,
  admits: day_admits
}


data hour_validation: Validation<ParsedTwoDigitFieldLexeme> = Validation {
  reason: hour_out_of_range,
  admits: hour_admits
}


data minute_validation: Validation<ParsedTwoDigitFieldLexeme> = Validation {
  reason: minute_out_of_range,
  admits: minute_admits
}


data second_validation: Validation<ParsedTwoDigitFieldLexeme> = Validation {
  reason: second_out_of_range,
  admits: second_admits
}


data nanoseconds_validation: Validation<Nat> = Validation {
  reason: nanoseconds_out_of_range,
  admits: nanoseconds_admits
}


data subsecond_digit_count_validation: Validation<Nat> = Validation {
  reason: subsecond_digits_out_of_range,
  admits: subsecond_digit_count_admits
}


data tz_offset_hour_validation: Validation<ParsedTwoDigitFieldLexeme> = Validation {
  reason: tz_offset_hour_out_of_range,
  admits: tz_offset_hour_admits
}


data tz_offset_minute_validation: Validation<ParsedTwoDigitFieldLexeme> = Validation {
  reason: tz_offset_minute_out_of_range,
  admits: tz_offset_minute_admits
}


data calendar_date_validation: Validation<CalendarDateFields> = Validation {
  reason: calendar_date_invalid,
  admits: calendar_date_admits
}


data instant_validation: Validation<InstantFields> = Validation {
  reason: instant_invalid,
  admits: instant_admits
}


fn make_year(parsed: ParsedFourDigitYearLexeme, at: Locus) -> Outcome<Year> {
  match refine(base: parsed, by: year_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: Year { parsed: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_month_ordinal(parsed: ParsedTwoDigitFieldLexeme, at: Locus) -> Outcome<MonthOrdinal> {
  match refine(base: parsed, by: month_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted {
        value: MonthOrdinal { parsed: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_day_ordinal(parsed: ParsedTwoDigitFieldLexeme, at: Locus) -> Outcome<DayOrdinal> {
  match refine(base: parsed, by: day_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted {
        value: DayOrdinal { parsed: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_hour_of_day(parsed: ParsedTwoDigitFieldLexeme, at: Locus) -> Outcome<HourOfDay> {
  match refine(base: parsed, by: hour_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted {
        value: HourOfDay { parsed: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_minute_of_hour(parsed: ParsedTwoDigitFieldLexeme, at: Locus) -> Outcome<MinuteOfHour> {
  match refine(base: parsed, by: minute_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted {
        value: MinuteOfHour { parsed: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_second_of_minute(parsed: ParsedTwoDigitFieldLexeme, at: Locus) -> Outcome<SecondOfMinute> {
  match refine(base: parsed, by: second_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted {
        value: SecondOfMinute { parsed: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_nanoseconds(value: Nat, at: Locus) -> Outcome<Nanoseconds> {
  match refine(base: value, by: nanoseconds_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: Nanoseconds { value: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_subsecond_digit_count(value: Nat, at: Locus) -> Outcome<SubsecondDigitCount> {
  match refine(base: value, by: subsecond_digit_count_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted { value: SubsecondDigitCount { value: refined }, diagnostics: diagnostics }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_subsecond(parsed: ParsedSubsecondLexeme) -> Subsecond {
  FractionalSecond { parsed: parsed }
}


fn make_tz_offset_hour(parsed: ParsedTwoDigitFieldLexeme, at: Locus) -> Outcome<TzOffsetHour> {
  match refine(base: parsed, by: tz_offset_hour_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted {
        value: TzOffsetHour { parsed: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_tz_offset_minute(parsed: ParsedTwoDigitFieldLexeme, at: Locus) -> Outcome<TzOffsetMinute> {
  match refine(base: parsed, by: tz_offset_minute_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted {
        value: TzOffsetMinute { parsed: refined },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_calendar_date(fields: CalendarDateFields, at: Locus) -> Outcome<CalendarDate> {
  match refine(base: fields, by: calendar_date_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted {
        value: CalendarDate { validity: CalendarDateValidity { refined: refined } },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}


fn make_clock_time(fields: ClockTimeFields) -> ClockTime {
  ClockTime { fields: fields }
}


fn make_instant(fields: InstantFields, at: Locus) -> Outcome<Instant> {
  match refine(base: fields, by: instant_validation, at: at) {
    Accepted { value: refined, diagnostics } =>
      Accepted {
        value: Instant { validity: InstantValidity { refined: refined } },
        diagnostics: diagnostics
      }
    Rejected { diagnostics } => Rejected { diagnostics: diagnostics }
  }
}
