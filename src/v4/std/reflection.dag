// src/v4/std/reflection.dag
// Scope: read-axis reflection over the program's own type declarations — the substrate
//        so a .dag witness can fold a coproduct type DECLARATION's arm-label set BY
//        EXECUTION, rather than against a hand-maintained mirror.
// Anchor: THESIS.md "Self-inspection" + MODELING.md (DFS the concept DAG from std/node).
// Status: T-REFLECT-1 modeled. Builds on the `coproduct_arm_labels(name)` interpreter
//         intrinsic (single-source registry row in src/v2/04_method.dag), the read-axis
//         counterpart to discriminant(v) (#4488, which reflects a VALUE's own constructor).
//         Intended code consumer: the gated hand-enumerated ConnectiveCoproductVariant /
//         behavior_coproduct_variants mirrors in std/node.dag. NOTE: those mirrors produce
//         typed Connective/Behavior VALUES (consumed by lens/coverage.dag), so fully
//         dissolving them additionally requires a CONSTRUCTION-reflection sibling
//         (build-variant-value-from-label) — pending operator A/B; not built here.

module v4.std.reflection


import v4.std.collection { List }
import v4.std.node { Symbol }


// The reflected shape of a coproduct type DECLARATION: the type's own name plus its
// ordered arm (constructor) label set, derived by execution from the loaded program's
// type table. This is what "reflecting a type declaration" RETURNS — a variant-set /
// arm-label structure attached to v4.std.node's Symbol vocabulary (not a parallel concept).
type CoproductDeclShape {
  declared_type: Symbol,
  arm_labels: List<Symbol>,
}


// Reflect the coproduct declaration named `declared_type` into its declaration shape.
// `coproduct_arm_labels` is the interpreter intrinsic door: it walks the live type table
// for the `Connective::Disj` declaration of that name and returns its arm labels. The host
// does not pre-enumerate — an unknown or non-coproduct name yields an empty arm-label list.
fn reflect_coproduct_decl(declared_type: Symbol) -> CoproductDeclShape {
  CoproductDeclShape {
    declared_type: declared_type,
    arm_labels: coproduct_arm_labels(name: declared_type),
  }
}
