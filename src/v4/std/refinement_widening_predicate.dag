// src/v4/std/refinement_widening_predicate.dag
// Scope: declared refinement-widening preservation check for coercion/find_witness.
// Status: W3.2 Rung 3 — explicit relation-node realization, no implicit non-equal fallback.
// Anchor: INVARIANTS.md P3 fail-closed; THESIS.md derived homomorphism.


module v4.std.refinement_widening_predicate


import v4.std.diagnostic { Accepted, Rejected }
import v4.std.node { Conj, Edge, Named, Node, Symbol, TypeNode, well_formed }
import v4.std.node_query { find_named_child }


data refinement_widening_relation_field_source: Symbol = refinement_widening_relation_field_source
data refinement_widening_relation_field_target: Symbol = refinement_widening_relation_field_target
data refinement_widening_relation_field_evidence: Symbol = refinement_widening_relation_field_evidence


type RefinementWideningRelation {
  source: Node
  target: Node
  evidence: Node
}


fn refinement_widening_relation_node(relation: RefinementWideningRelation) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: refinement_widening_relation_field_source },
        target: relation.source
      },
      Edge {
        label: Named { name: refinement_widening_relation_field_target },
        target: relation.target
      },
      Edge {
        label: Named { name: refinement_widening_relation_field_evidence },
        target: relation.evidence
      }
    ]
  }
}


fn refinement_widening_preservation_holds(
  source_facts: Node,
  candidate: Node,
  algebra: Node,
) -> Bool {
  well_formed(n: source_facts)
    && well_formed(n: candidate)
    && well_formed(n: algebra)
    && match find_named_child(root: algebra, name: refinement_widening_relation_field_source) {
      Accepted { value: source, diagnostics: _ } =>
        match find_named_child(root: algebra, name: refinement_widening_relation_field_target) {
          Accepted { value: target, diagnostics: _ } =>
            match find_named_child(root: algebra, name: refinement_widening_relation_field_evidence) {
              Accepted { value: evidence, diagnostics: _ } =>
                (source == source_facts)
                  && (target == candidate)
                  && well_formed(n: evidence)
                  && (evidence != source_facts)
                  && (evidence != candidate)
                  && (source_facts != candidate)
              Rejected { diagnostics: _ } => false
            }
          Rejected { diagnostics: _ } => false
        }
      Rejected { diagnostics: _ } => false
    }
}
