// v4.std.dependents — reverse-reference (fan-in) of a graph occurrence.
//
// Dependents is a property of an OCCURRENCE in a resolved graph, not of node
// content: occurrence_id is excluded from the content hash (v4.std.node), so the
// reverse edges are graph-relative. It is computed once when the forward
// reference edges are formed; every "unused / dead" analysis is then one read.
//
//   Untracked              — not a referenceable target (the "null" arity)
//   Tracked { uses: [] }    — a target with zero dependents (arity 0) -> DEAD
//   Tracked { uses: [..] }  — live
//
// unused parameter / unused import / dead declaration all collapse to
// no_dependents(dependents(occurrence)): model the property once, derive every
// analysis. Dead-declaration additionally walks reachability from a declared
// root set (exports + tests + entrypoints).

module v4.std.dependents

import v4.std.algebra { is_empty }
import v4.std.collection { List }
import v4.std.logic { Bool }
import v4.std.node { OccurrenceId }

// The empty-vs-null distinction is the carrier: "never a target" and "a target
// with zero uses" are different states, and both are arity-0.
type Dependents
  = Untracked
  | Tracked { uses: List<OccurrenceId> }

// Arity-0 query — the ban predicate. Empty uses (== 0) or absent (null).
fn no_dependents(d: Dependents) -> Bool {
  match d {
    Untracked => true
    Tracked { uses } => is_empty(xs: uses)
  }
}
