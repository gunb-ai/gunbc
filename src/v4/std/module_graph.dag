// src/v4/std/module_graph.dag
// Scope: Module-tree carrier + ancestor-relation Witness for cross-file binding (T-28).
// Owns: ModuleGraph, AncestorRelation; ancestor-prefix Witness; root lookup; validated graph constructor.
// Consumes: std/algebra.dag, std/collection.dag, std/diagnostic.dag, std/logic.dag, std/node.dag, std/qualified_name.dag, std/witness.dag.
// Status: T-28 (bundled into T-8) modeled; primary consumer: compiler/03_name_resolve.dag.
// Anchor: https://en.wikipedia.org/wiki/Module_(programming)


module v4.std.module_graph


import v4.std.algebra { Cons, Empty, FreeMonoid }
import v4.std.collection { Map, empty_map, map_insert }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Unavailable,
  port_locus
}
import v4.std.logic { Bool }
import v4.std.node { Node, Symbol }
import v4.std.qualified_name {
  QualifiedName,
  qualified_name_is_prefix_of
}
import v4.std.witness { Holds, Violates, Witness }


// 🟡 gated — feature:T-8-qualified-root-projection-bridge — bind TASKS.md T-28-B/T-35 and T-28-C — QualifiedRoot is a construction row, not a second module-identity authority: it exists only because qualified_name_from_node is fail-closed until T-8 can project a declared name from each root Node; forbidden: exposing QualifiedRoot as a stable caller contract or using it outside graph admission; dissolve-on: module_graph_from_nodes projects QualifiedName from Node internally and QualifiedRoot is deleted.
type QualifiedRoot {
  name: QualifiedName
  root: Node
}


// 🟡 gated — feature:T-28-carrier-level-uniqueness — bind TASKS.md T-28-C — Map<QualifiedName, Node> cannot represent duplicate roots after construction; module_graph_from_roots is the canonical construction path that rejects duplicate source roots before map insertion; forbidden: direct ModuleGraph record construction outside std/module_graph.dag tests/scaffolds; dissolve-on: substrate opaque-type or smart-constructor primitive enforces module_graph_from_roots/module_graph_from_nodes as the sole construction path.
type ModuleGraph {
  roots: Map<QualifiedName, Node>
}


// 🟡 feature:opaque-proof-constructor — AncestorRelation is a plain record; non-prefix pairs are constructible outside module_ancestor_witness; dissolve-on: substrate opaque-type or smart-constructor primitive enforces module_ancestor_witness as the sole construction path.
type AncestorRelation {
  ancestor: QualifiedName
  descendant: QualifiedName
}


data module_graph_ancestor_not_prefix: Symbol = module_graph_ancestor_not_prefix
data module_graph_root_not_found: Symbol = module_graph_root_not_found
data module_graph_duplicate_root: Symbol = module_graph_duplicate_root


fn module_ancestor_not_prefix_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: module_graph_ancestor_not_prefix,
    at: port_locus(port: module_graph_ancestor_not_prefix),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn module_root_not_found_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: module_graph_root_not_found,
    at: port_locus(port: module_graph_root_not_found),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn module_graph_duplicate_root_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: module_graph_duplicate_root,
    at: port_locus(port: module_graph_duplicate_root),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn module_is_prefix_of(ancestor: QualifiedName, descendant: QualifiedName) -> Bool {
  qualified_name_is_prefix_of(prefix: ancestor, name: descendant)
}


fn module_ancestor_witness(
  ancestor: QualifiedName,
  descendant: QualifiedName
) -> Witness<AncestorRelation> {
  if module_is_prefix_of(ancestor: ancestor, descendant: descendant) {
    Holds {
      value: AncestorRelation {
        ancestor: ancestor,
        descendant: descendant
      }
    }
  } else {
    Violates { diagnostic: module_ancestor_not_prefix_diagnostic() }
  }
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type ModuleGraphBuildState
  = ModuleGraphBuildValid { roots: Map<QualifiedName, Node> }
  | ModuleGraphBuildDuplicate


// 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-qualifiedroot — hand-rolls Empty/Cons accumulation over FreeMonoid<QualifiedRoot>; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T.
fn module_graph_build_fold(
  roots: FreeMonoid<QualifiedRoot>,
  acc: ModuleGraphBuildState
) -> ModuleGraphBuildState {
  match roots {
    Empty => acc
    Cons { head: row, tail: rest } =>
      match acc {
        ModuleGraphBuildDuplicate =>
          module_graph_build_fold(roots: rest, acc: ModuleGraphBuildDuplicate)
        ModuleGraphBuildValid { roots: prior } =>
          module_graph_build_fold(
            roots: rest,
            acc: match map_get(prior, row.name) {
              Some { value: _ } => ModuleGraphBuildDuplicate
              None => ModuleGraphBuildValid {
                roots: map_insert(m: prior, key: row.name, value: row.root)
              }
            }
          )
      }
  }
}


fn module_graph_from_roots(
  roots: FreeMonoid<QualifiedRoot>
) -> Witness<ModuleGraph> {
  match module_graph_build_fold(
    roots: roots,
    acc: ModuleGraphBuildValid { roots: empty_map() }
  ) {
    ModuleGraphBuildValid { roots: admitted } =>
      Holds { value: ModuleGraph { roots: admitted } }
    ModuleGraphBuildDuplicate =>
      Violates { diagnostic: module_graph_duplicate_root_diagnostic() }
  }
}


fn module_graph_root_for_name(
  graph: ModuleGraph,
  name: QualifiedName
) -> Witness<Node> {
  match map_get(graph.roots, name) {
    Some { value: root } => Holds { value: root }
    None => Violates { diagnostic: module_root_not_found_diagnostic() }
  }
}
