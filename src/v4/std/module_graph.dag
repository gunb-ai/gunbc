// src/v4/std/module_graph.dag
// Scope: Module catalog carrier for cross-file binding (T-28).
// Owns: Catalog, Entry; entry lookup; validated catalog constructor.
// Consumes: std/algebra.dag, std/diagnostic.dag, std/node.dag, std/qualified_name.dag, std/witness.dag.
// Status: T-28 (bundled into T-8) modeled; primary consumer: compiler/03_name_resolve.dag.
// Anchor: https://en.wikipedia.org/wiki/Module_(programming)


module v4.std.module_graph


import v4.std.algebra { Empty, Cons, FreeMonoid }
import v4.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Unavailable,
  port_locus
}
import v4.std.node { Node, Symbol }
import v4.std.qualified_name {
  QualifiedName,
  qualified_name_eq
}
import v4.std.witness { Holds, Violates, Witness }


type Entry {
  name: QualifiedName
  root: Node
}


// 🟡 feature:T-28-carrier-level-uniqueness — FreeMonoid<Entry> admits duplicate names at carrier level; catalog_from_entries is the canonical construction path that enforces name uniqueness — dissolve-on: substrate opaque-type or smart-constructor primitive enforces catalog_from_entries as the sole construction path.
type Catalog {
  entries: FreeMonoid<Entry>
}


data catalog_entry_not_found: Symbol = catalog_entry_not_found
data catalog_duplicate_name: Symbol = catalog_duplicate_name


fn catalog_entry_not_found_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: catalog_entry_not_found,
    at: port_locus(port: catalog_entry_not_found),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


fn catalog_duplicate_name_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: catalog_duplicate_name,
    at: port_locus(port: catalog_duplicate_name),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type EntryFindState
  = EntryNotFound
  | EntryFoundOnce { found: Entry }
  | EntryFoundDuplicate


fn entry_find_state_to_witness(state: EntryFindState) -> Witness<Entry> {
  match state {
    EntryNotFound => Violates { diagnostic: catalog_entry_not_found_diagnostic() }
    EntryFoundOnce { found: entry } => Holds { value: entry }
    EntryFoundDuplicate => Violates { diagnostic: catalog_duplicate_name_diagnostic() }
  }
}


// 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-entry — bind TODO — v2 compiler cannot infer T=Entry from FreeMonoid<Entry> for fold_list/zip_eq generic call dispatch; hand-rolls Empty/Cons accumulation; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T; forbidden: fold_list laundering over FreeMonoid<Entry> until that limitation is lifted.
fn catalog_entry_for_name_fold(
  entries: FreeMonoid<Entry>,
  name: QualifiedName,
  acc: EntryFindState
) -> EntryFindState {
  match entries {
    Empty => acc
    Cons { head: entry, tail: rest } =>
      catalog_entry_for_name_fold(
        entries: rest,
        name: name,
        acc: if qualified_name_eq(a: entry.name, b: name) {
          match acc {
            EntryNotFound => EntryFoundOnce { found: entry }
            EntryFoundOnce { found: _ } => EntryFoundDuplicate
            EntryFoundDuplicate => EntryFoundDuplicate
          }
        } else {
          acc
        }
      )
  }
}


fn catalog_entry_for_name(
  catalog: Catalog,
  name: QualifiedName
) -> Witness<Entry> {
  entry_find_state_to_witness(
    state: catalog_entry_for_name_fold(
      entries: catalog.entries,
      name: name,
      acc: EntryNotFound
    )
  )
}


// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type CatalogBuildState
  = BuildValid { seen: FreeMonoid<Entry> }
  | BuildDuplicate


// 🟡 gated — fold_list bootstrap-limitation interim — feature: fold-list-generic-entry — bind TODO — same v2 bootstrap limitation as catalog_entry_for_name_fold; hand-rolls Empty/Cons accumulation over FreeMonoid<Entry>; dissolve-on-arrival: v2 bootstrap fixes FreeMonoid<T> generic type inference for user-defined T.
fn catalog_build_fold(
  entries: FreeMonoid<Entry>,
  acc: CatalogBuildState
) -> CatalogBuildState {
  match entries {
    Empty => acc
    Cons { head: entry, tail: rest } =>
      match acc {
        BuildDuplicate =>
          catalog_build_fold(entries: rest, acc: BuildDuplicate)
        BuildValid { seen: prior } =>
          catalog_build_fold(
            entries: rest,
            acc: match catalog_entry_for_name_fold(
              entries: prior,
              name: entry.name,
              acc: EntryNotFound
            ) {
              EntryNotFound => BuildValid { seen: Cons { head: entry, tail: prior } }
              EntryFoundOnce { found: _ } => BuildDuplicate
              EntryFoundDuplicate => BuildDuplicate
            }
          )
      }
  }
}


fn catalog_from_entries(
  entries: FreeMonoid<Entry>
) -> Witness<Catalog> {
  match catalog_build_fold(entries: entries, acc: BuildValid { seen: Empty }) {
    BuildValid { seen: _ } => Holds { value: Catalog { entries: entries } }
    BuildDuplicate => Violates { diagnostic: catalog_duplicate_name_diagnostic() }
  }
}
