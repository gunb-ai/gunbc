// src/v4/std/constraints.dag
// Scope: canonical source grounding via find_witness + UniqueOnly (T-9 solve_constraints wrapper).
// Anchor: design-v4-compiler-homomorphism.md; TASKS.md T-9; docs/modeling-discipline.md Practice 11.
// Owns: ConstraintGraph, CanonicalGrounding, ConstraintSatisfactionPredicate, ConstraintSolvePolicy,
//       CanonicalGroundingCandidateSet, CanonicalGroundingWitness, constraint_satisfaction_holds,
//       canonical_grounding_candidates, solve_constraints.
// Consumes: std find_witness, std diagnostic, std witness, std node.
// Status: MVP-1 constraint_satisfaction predicate body + closed singleton candidate set for graph root.


module v4.std.constraints


import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  NodeLocus,
  None,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  outcome_rejected,
  outcome_with_diagnostics
}
import v4.std.find_witness {
  CandidateSet,
  PreservationPredicate,
  UniqueOnly,
  find_witness,
  preservation_rule_constraint_satisfaction
}
import v4.std.constraint_satisfaction_predicate {
  constraint_satisfaction_preservation_holds
}
import v4.std.node { Node, Symbol, well_formed }
import v4.std.witness { StructuralPropertyWitness }
data constraint_property_being_canonical: Symbol = constraint_property_being_canonical
data constraint_property_candidate_set_closedness: Symbol = constraint_property_candidate_set_closedness
data constraints_not_realized: Symbol = constraints_not_realized
data constraints_ill_formed_root: Symbol = constraints_ill_formed_root
// 🟡 coproduct dissolution — scaffold:T-9-ground · dissolve-on: richer ConstraintGraph carriers enumerate algebra inhabitants per node.
type ConstraintGraph {
  root: Node
}
type CanonicalGrounding {
  node: Node
  witness: CanonicalGroundingWitness
}
type ConstraintSatisfactionPredicate {
  predicate: PreservationPredicate
}
type ConstraintSolvePolicy {
  graph: ConstraintGraph
}
type CanonicalGroundingCandidateSet {
  set: CandidateSet
}
type CanonicalGroundingWitness {
  structural: StructuralPropertyWitness
  // 🟡 coproduct dissolution — scaffold:T-9-closedness-bridge · dissolve-on: find_witness closedness authority supplies evidence distinct from structural witness.
  closedness: StructuralPropertyWitness
}
fn constraints_not_realized_diagnostic(graph: ConstraintGraph) -> Diagnostic {
  Diagnostic {
    reason: constraints_not_realized,
    at: NodeLocus { node: graph.root },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn constraints_ill_formed_root_diagnostic(graph: ConstraintGraph) -> Diagnostic {
  Diagnostic {
    reason: constraints_ill_formed_root,
    at: NodeLocus { node: graph.root },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
// Concept-home wrapper: mechanical body is sole authority in constraint_satisfaction_predicate.dag.
fn constraint_satisfaction_holds(
  source_facts: Node,
  candidate: Node,
  predicate: ConstraintSatisfactionPredicate,
) -> Bool {
  constraint_satisfaction_preservation_holds(
    source_facts: source_facts,
    candidate: candidate,
    algebra: predicate.predicate.algebra
  )
}
fn constraint_satisfaction_predicate(algebra: Node) -> ConstraintSatisfactionPredicate {
  ConstraintSatisfactionPredicate {
    predicate: PreservationPredicate {
      algebra: algebra,
      preservation_rule: preservation_rule_constraint_satisfaction
    }
  }
}
fn canonical_grounding_candidate_set_closedness(root: Node) -> StructuralPropertyWitness {
  StructuralPropertyWitness {
    property: constraint_property_candidate_set_closedness,
    evidence: root
  }
}
fn canonical_grounding_candidates(
  policy: ConstraintSolvePolicy,
) -> Outcome<CanonicalGroundingCandidateSet> {
  if well_formed(n: policy.graph.root) {
    Accepted {
      value: CanonicalGroundingCandidateSet {
        set: CandidateSet {
          candidates: [policy.graph.root],
          closedness: canonical_grounding_candidate_set_closedness(root: policy.graph.root)
        }
      },
      diagnostics: None
    }
  } else {
    outcome_rejected(constraints_ill_formed_root_diagnostic(graph: policy.graph))
  }
}
fn solve_constraints(policy: ConstraintSolvePolicy) -> Outcome<CanonicalGrounding> {
  bind_outcome(
    o: canonical_grounding_candidates(policy: policy),
    f: fn(grounding_candidates) {
      match find_witness(
        source_facts: policy.graph.root,
        candidates: grounding_candidates.set,
        predicate: constraint_satisfaction_predicate(algebra: policy.graph.root).predicate,
        multiplicity_policy: UniqueOnly
      ) {
        Accepted { value: fw, diagnostics: fw_d } =>
          outcome_with_diagnostics(
            value: CanonicalGrounding {
              node: fw.candidate,
              witness: CanonicalGroundingWitness {
                structural: fw.witness,
                closedness: fw.closedness
              }
            },
            diagnostics: fw_d
          )
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    }
  )
}
