// src/v4/std/constraints.dag
// Scope: canonical source grounding via find_witness + UniqueOnly (T-9 solve_constraints wrapper).
// Anchor: design-v4-compiler-homomorphism.md; TASKS.md T-9; docs/modeling-discipline.md Practice 11.
// Owns: ConstraintGraph, CanonicalGrounding, ConstraintSatisfactionPredicate, ConstraintSolvePolicy,
//       CanonicalGroundingCandidateSet, CanonicalGroundingWitness, solve_constraints.
// Consumes: std find_witness, std diagnostic, std witness, std node.
// Status: Wave-2-BC3 modeled; solve_constraints delegates to find_witness.


module v4.std.constraints


import v4.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  NodeLocus,
  Outcome,
  Rejected,
  Unavailable,
  bind_outcome,
  diagnostics_singleton,
  outcome_rejected,
  rejected_with_pending
}
import v4.std.find_witness {
  CandidateSet,
  PreservationPredicate,
  UniqueOnly,
  find_witness,
  preservation_rule_constraint_satisfaction
}
import v4.std.node { Node, Symbol }
import v4.std.witness { StructuralPropertyWitness }
data constraint_property_being_canonical: Symbol = constraint_property_being_canonical
data constraints_not_realized: Symbol = constraints_not_realized
// 🟡 coproduct dissolution — scaffold:T-9-ground · dissolve-on: W-T-9-impl consumes graph carriers.
type ConstraintGraph {
  root: Node
}
type CanonicalGrounding {
  node: Node
  witness: CanonicalGroundingWitness
}
type ConstraintSatisfactionPredicate {
  predicate: PreservationPredicate
}
type ConstraintSolvePolicy {
  graph: ConstraintGraph
}
type CanonicalGroundingCandidateSet {
  set: CandidateSet
}
type CanonicalGroundingWitness {
  structural: StructuralPropertyWitness
}
fn constraints_not_realized_diagnostic(graph: ConstraintGraph) -> Diagnostic {
  Diagnostic {
    reason: constraints_not_realized,
    at: NodeLocus { node: graph.root },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn canonical_grounding_candidates(
  policy: ConstraintSolvePolicy,
) -> Outcome<CanonicalGroundingCandidateSet> {
  Accepted {
    value: CanonicalGroundingCandidateSet {
      set: CandidateSet {
        candidates: [policy.graph.root],
        closedness: StructuralPropertyWitness {
          property: constraint_property_being_canonical,
          evidence: policy.graph.root
        }
      }
    },
    diagnostics: None
  }
}
fn solve_constraints(policy: ConstraintSolvePolicy) -> Outcome<CanonicalGrounding> {
  bind_outcome(
    o: canonical_grounding_candidates(policy: policy),
    f: fn(grounding_candidates) {
      match find_witness(
        source_facts: policy.graph.root,
        candidates: grounding_candidates.set,
        predicate: PreservationPredicate {
          algebra: policy.graph.root,
          preservation_rule: preservation_rule_constraint_satisfaction
        },
        multiplicity_policy: UniqueOnly
      ) {
        Accepted { value: fw, diagnostics: fw_d } =>
          Accepted {
            value: CanonicalGrounding {
              node: fw.candidate,
              witness: CanonicalGroundingWitness {
                structural: fw.witness
              }
            },
            diagnostics: fw_d
          }
        Rejected { diagnostics: r } => Rejected { diagnostics: r }
      }
    }
  )
}
