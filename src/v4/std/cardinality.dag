// src/v4/std/cardinality.dag
// Scope: cardinality, inhabitance, bounded-natural refinement, descent evidence.
// Anchor: https://en.wikipedia.org/wiki/Cardinality
// Owns: Never, Unit, NonZeroNat, NatLeWitness, UpperBoundedNat, PositiveNatLeWitness, PositiveUpperBoundedNat, nat_le_witness_lower, nat_le_witness_upper, positive_nat_le_witness_lower, positive_nat_le_witness_upper, upper_bounded_nat_value, upper_bounded_nat_inclusive_max, positive_upper_bounded_nat_value, positive_upper_bounded_nat_inclusive_max, nat_le_witness_well_formed, upper_bounded_nat_well_formed, positive_nat_le_witness_well_formed, positive_upper_bounded_nat_well_formed, DescentEvidence, RankingDimension, TerminationProof, Multiplicity.
// Consumes: std collection, std nat, std node.
// Status: T-3 modeled; Wave-A2 inhabitance + bounded-natural refinement carriers.


module v4.std.cardinality

import v4.std.collection { List }
import v4.std.nat { Nat }
import v4.std.node { Symbol }
// 🟢 Part 1 Never/Unit + §PR-3252-cardinality-std (Practice 9).
type Never
type Unit
type NonZeroNat {
  prev: Nat
}
// 🟢 coproduct dissolution — CP-3229-NAT-LE-WITNESS.
type NatLeWitness
  = LeqZero { upper: Nat }
  | LeqSucc { inner: NatLeWitness }
type UpperBoundedNat {
  le: NatLeWitness
}
type PositiveNatLeWitness
  = PositiveLeqSucc { inner: NatLeWitness }
type PositiveUpperBoundedNat {
  le: PositiveNatLeWitness
}
fn nat_le_witness_lower(w: NatLeWitness) -> Nat {
  match w {
    LeqZero { upper: _ } => Zero
    LeqSucc { inner } => Succ { prev: nat_le_witness_lower(w: inner) }
  }
}
fn nat_le_witness_upper(w: NatLeWitness) -> Nat {
  match w {
    LeqZero { upper } => upper
    LeqSucc { inner } => Succ { prev: nat_le_witness_upper(w: inner) }
  }
}
fn positive_nat_le_witness_lower(w: PositiveNatLeWitness) -> Nat {
  match w {
    PositiveLeqSucc { inner } => Succ { prev: nat_le_witness_lower(w: inner) }
  }
}
fn positive_nat_le_witness_upper(w: PositiveNatLeWitness) -> Nat {
  match w {
    PositiveLeqSucc { inner } => Succ { prev: nat_le_witness_upper(w: inner) }
  }
}
fn upper_bounded_nat_value(b: UpperBoundedNat) -> Nat {
  nat_le_witness_lower(w: b.le)
}
fn upper_bounded_nat_inclusive_max(b: UpperBoundedNat) -> Nat {
  nat_le_witness_upper(w: b.le)
}
fn positive_upper_bounded_nat_value(b: PositiveUpperBoundedNat) -> Nat {
  positive_nat_le_witness_lower(w: b.le)
}
fn positive_upper_bounded_nat_inclusive_max(b: PositiveUpperBoundedNat) -> Nat {
  positive_nat_le_witness_upper(w: b.le)
}
fn nat_le_witness_well_formed(w: NatLeWitness) -> Bool {
  match w {
    LeqZero { upper: _ } => true
    LeqSucc { inner } => nat_le_witness_well_formed(w: inner)
  }
}
fn upper_bounded_nat_well_formed(b: UpperBoundedNat) -> Bool {
  nat_le_witness_well_formed(w: b.le)
}
fn positive_nat_le_witness_well_formed(w: PositiveNatLeWitness) -> Bool {
  match w {
    PositiveLeqSucc { inner } => nat_le_witness_well_formed(w: inner)
  }
}
fn positive_upper_bounded_nat_well_formed(b: PositiveUpperBoundedNat) -> Bool {
  positive_nat_le_witness_well_formed(w: b.le)
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type DescentEvidence
  = Strict
  | NonIncreasing
  | DescentUnknown
type RankingDimension {
  measured: Symbol
}
type TerminationProof {
  non_increasing: List<RankingDimension>
  strict: RankingDimension
}
// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type Multiplicity
  = Bounded
  | Unbounded { step: TerminationProof }
