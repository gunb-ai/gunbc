// src/v4/std/cardinality.dag
// Scope: cardinality, inhabitance, bounded-natural refinement, descent evidence.
// Anchor: https://en.wikipedia.org/wiki/Cardinality
// Owns: Never, Unit, NonZeroNat, NatLeWitness, UpperBoundedNat, nat_le_witness_well_formed, upper_bounded_nat_well_formed, DescentEvidence, RankingDimension, TerminationProof, Multiplicity.
// Consumes: std algebra, std collection, std nat, std node.
// Status: T-3 modeled; Wave-A2 inhabitance + bounded-natural refinement carriers.


module v4.std.cardinality

import v4.std.algebra { Ordering, Less, Equal, Greater }
import v4.std.collection { List }
import v4.std.nat { Nat, nat_compare }
import v4.std.node { Symbol }
// 🟢 DECISIONS.md Part 1 Never/Unit + §PR-3252-cardinality-std (Practice 9).
type Never
type Unit
type NonZeroNat {
  prev: Nat
}
// 🟢 coproduct dissolution — DECISIONS.md Part 6 · CP-3229-GREEN-TERMINAL.
type NatLeWitness
  = LeqZero { upper: Nat }
  | LeqSucc { inner: NatLeWitness }
type UpperBoundedNat {
  inclusive_max: Nat
  value: Nat
  le: NatLeWitness
}
fn nat_le_witness_well_formed(value: Nat, inclusive_max: Nat, w: NatLeWitness) -> Bool {
  match w {
    LeqZero { upper } => match value {
      Zero => match nat_compare(a: inclusive_max, b: upper) {
        Equal => true
        Less => false
        Greater => false
      }
      Succ { prev: _ } => false
    }
    LeqSucc { inner } => match value {
      Zero => false
      Succ { prev: vp } => match inclusive_max {
        Zero => false
        Succ { prev: mp } => nat_le_witness_well_formed(value: vp, inclusive_max: mp, w: inner)
      }
    }
  }
}
fn upper_bounded_nat_well_formed(b: UpperBoundedNat) -> Bool {
  nat_le_witness_well_formed(
    value: b.value,
    inclusive_max: b.inclusive_max,
    w: b.le,
  )
}
// 🟢 coproduct dissolution — DECISIONS.md classification ledger: DescentEvidence.
type DescentEvidence
  = Strict
  | NonIncreasing
  | DescentUnknown
type RankingDimension {
  measured: Symbol
}
type TerminationProof {
  non_increasing: List<RankingDimension>
  strict: RankingDimension
}
// 🟢 coproduct dissolution — DECISIONS.md classification ledger: Multiplicity.
type Multiplicity
  = Bounded
  | Unbounded { step: TerminationProof }
