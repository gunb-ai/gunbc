// src/v4/std/cardinality.dag
// Scope: cardinality and descent-evidence substrate.
// Anchor: https://en.wikipedia.org/wiki/Cardinality
// Owns: DescentEvidence, RankingDimension, TerminationProof, Multiplicity.
// Consumes: std collection, std node.
// Status: T-3 modeled.


module v4.std.cardinality

import v4.std.collection { List }
import v4.std.node { Symbol }
// 🟢 coproduct dissolution — DECISIONS.md De-Prosed Substrate Receipts: DescentEvidence.
type DescentEvidence
  = Strict
  | NonIncreasing
  | DescentUnknown
type RankingDimension {
  measured: Symbol
}
type TerminationProof {
  non_increasing: List<RankingDimension>
  strict: RankingDimension
}
// 🟢 coproduct dissolution — DECISIONS.md De-Prosed Substrate Receipts: Multiplicity.
type Multiplicity
  = Bounded
  | Unbounded { step: TerminationProof }
