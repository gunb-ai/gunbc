module v4.std.machine


import v4.std.collection { List }
import v4.std.logic { Bool }
type Bit = Bool
type Byte {
  bits: List<Bit>
}
type Word8 {
  bytes: List<Byte>
}

type Word16 {
  bytes: List<Byte>
}

type Word32 {
  bytes: List<Byte>
}

type Word64 {
  bytes: List<Byte>
}

type Word128 {
  bytes: List<Byte>
}
type MachineWidth<bits>
type PointerWidth
