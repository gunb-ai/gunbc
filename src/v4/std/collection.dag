// src/v4/std/collection.dag
// Scope: container carriers grounded in algebraic constructions.
// Owns: Optional, List, non_empty, list_snoc_item, list_append, Set, FiniteSet, Map, empty_map, map_insert, TotalMap, TotalPolicy.
// Consumes: std/algebra.dag; std/witness.dag; std/diagnostic.dag; std/node.dag.
// Status: T-3 modeled.
// Anchor: https://en.wikipedia.org/wiki/Free_monoid
// AI-3: non_empty removed (duplicate of v4.std.algebra.non_empty).
// AI-PR: list_append, list_snoc_item moved to v4.std.algebra (canonical authority).
//   collection.dag imports diagnostic.dag; diagnostic.dag needs list_append — circular
//   if both lived in collection. Callers must import from v4.std.algebra.


module v4.std.collection


import v4.std.algebra { FreeMonoid, PointwisePower, fold_list, is_empty }
import v4.std.diagnostic { Diagnostic, ExternalContractUnknown, Unavailable, port_locus }
import v4.std.node { Symbol }
import v4.std.witness { Holds, Violates, Witness }
// 🟢 coproduct dissolution — M6-Optional-generic.
// Anchor: initial algebra of F(X) = 1 + T; Haskell Maybe / Rust Option / ML option.
type Optional<T>
  = Absent
  | Present { value: T }
fn optional_diagnostic_absent() -> Optional<Diagnostic> {
  Absent
}
fn optional_diagnostic_present(diagnostic: Diagnostic) -> Optional<Diagnostic> {
  Present { value: diagnostic }
}
type List<T> = FreeMonoid<T>
type Set<T> = PointwisePower<T>
type Map<K, V> {
  lookup: fn(K) -> Witness<V>
}
// Composite struct keys (e.g. { position: Int, production: Symbol }) use structural == in map_insert lookup.
type IndexedLookup<T> {
  index: Int
  value: Witness<T>
}
data map_key_absent: Symbol = map_key_absent
data map_lookup_port: Symbol = map_lookup_port
fn map_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: map_key_absent,
    at: port_locus(port: map_lookup_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn empty_map<K, V>() -> Map<K, V> {
  Map {
    lookup: fn(_) {
      Violates { diagnostic: map_absent_diagnostic() }
    }
  }
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  Map {
    lookup: fn(candidate) {
      match candidate == key {
        true => Holds { value: value }
        false => m.lookup(candidate)
      }
    }
  }
}
fn list_nth<T>(xs: List<T>, wanted: Int, absent: Diagnostic) -> Witness<T> {
  fold_list(
    xs: xs,
    empty: IndexedLookup {
      index: 0,
      value: Violates { diagnostic: absent }
    },
    cons: fn(acc, item) {
      IndexedLookup {
        index: acc.index + 1,
        value: if acc.index == wanted {
          Holds { value: item }
        } else {
          acc.value
        }
      }
    }
  ).value
}
// 🟡 needs-more-work — feature:finite-set-uniqueness-witness — dissolve-on: std/algebra derived unique: Witness<Holds> projection; FiniteSet binds structural unique field
type FiniteSet<T> {
  head: T
  tail: List<T>
}
type TotalMap<K, V> {
  lookup: fn(K) -> V
}
type TotalPolicy<K, Context, RowTemplate> {
  lookup: fn(K, Context) -> RowTemplate
}
