// src/v4/std/collection.dag
// Scope: container carriers grounded in algebraic constructions.
// Anchor: https://en.wikipedia.org/wiki/Free_monoid
// Owns: List, non_empty, list_snoc_item, list_append, Set, FiniteSet, Map,
//       empty_map, map_insert, TotalMap, TotalPolicy.
// Consumes: std algebra, std witness, std diagnostic, std node.
// Status: T-3 modeled; substrate-extension rule in src/v4/STRUCTURE.md.
// Adds (substrate-evolution 5/5): FiniteSet, TotalMap, TotalPolicy primitives
// needed by L1.13.c TableDecisionTree (docs/design-dissolution-lens.md §5
// L1.13.c) and as the canonical carrier for finite-enumerated rows like
// SubsumedFixes (v4.lens.subsumption). Distinct from `Set<T> = PointwisePower<T>`
// which is the membership-predicate (potentially infinite) BooleanAlgebra carrier.


module v4.std.collection


import v4.std.algebra { FreeMonoid, PointwisePower, is_empty }
import v4.std.diagnostic { Diagnostic, ExternalContractUnknown, Unavailable, port_locus }
import v4.std.node { Symbol }
import v4.std.witness { Holds, Violates, Witness }
type List<T> = FreeMonoid<T>
fn non_empty<T>(xs: List<T>) -> Bool {
  match is_empty(xs: xs) {
    true => false
    false => true
  }
}
fn list_snoc_item<T>(xs: FreeMonoid<T>, item: T) -> FreeMonoid<T> {
  list_append(left: xs, right: Cons { head: item, tail: Empty })
}
fn list_append<T>(left: FreeMonoid<T>, right: FreeMonoid<T>) -> FreeMonoid<T> {
  match left {
    Empty => right
    Cons { head: h, tail: t } => Cons {
      head: h,
      tail: list_append(left: t, right: right)
    }
  }
}
type Set<T> = PointwisePower<T>
type Map<K, V> {
  lookup: fn(K) -> Witness<V>
}
data map_key_absent: Symbol = map_key_absent
data map_lookup_port: Symbol = map_lookup_port
fn map_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: map_key_absent,
    at: port_locus(port: map_lookup_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn empty_map<K, V>() -> Map<K, V> {
  Map {
    lookup: fn(_) {
      Violates { diagnostic: map_absent_diagnostic() }
    }
  }
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  Map {
    lookup: fn(candidate) {
      match candidate == key {
        true => Holds { value: value }
        false => m.lookup(candidate)
      }
    }
  }
}
// 🟡 finite-uniqueness witness gated — feature:finite-set-uniqueness-witness;
// bind: node://adhoc-086ab97b-b41 (this PR's substrate-evolution 5/5 work-item)
// → dissolution successor: substrate-extension follow-up to land a derived
// `unique: Witness<Holds>` projection over the `head ++ tail` enumeration
// (mirrors `FreeMonoidUniqueState` in std/algebra; same shape, same `unique:
// Bool` resolution pattern). Flips 🟢 when the derived-witness projection
// lands in v4.std.algebra and FiniteSet binds it as a structural field.
// Until then, FiniteSet's uniqueness obligation is enforced by the consuming
// lens / row validator (e.g. v4.lens.subsumption MechanicalReverification
// runtime, which the parallel swift-owl-884 PR #3496 already wires).
//
// Non-empty, finite enumerated set carrier. Use FiniteSet<T> when the row
// requires the full elements (eager-materialized closed enumeration) — Set<T>
// (= PointwisePower<T>) is the membership-predicate carrier for unbounded
// (possibly infinite) membership queries (Practice 11: scope-from-query, not
// from a baked-in type tag — FiniteSet vs Set is a substrate distinction
// (eager vs predicate), not a scope qualifier on the same shape).
type FiniteSet<T> {
  head: T
  tail: List<T>
}
// TotalMap<K, V> is the substrate carrier for a total table over a finite
// payload-free closed coproduct K with fully-materialized values — i.e. K's
// constructors are all 0-field tags and the row's value-template is
// independent of any payload. See docs/design-dissolution-lens.md §5 L1.13.c
// (Pattern A) for the pattern this carrier dissolves.
//
// Practice 2 (illegal states unrepresentable): the carrier is shaped as a
// total function `fn(K) -> V` (mirroring `Map<K, V>` but without the
// `Witness<V>` wrapper — K is closed and the function is total, so every K
// returns a V with no failure variant). Duplicate keys with conflicting
// values are STRUCTURALLY UNREPRESENTABLE because a function has exactly
// one output per input; key-shadowing is not in the carrier's vocabulary.
// Totality ("every K-variant covered") is enforced by match-exhaustiveness
// on closed K in the `lookup` body — the same well-formedness rule that
// already grounds match-arm coverage elsewhere in the substrate. No
// uniqueness or totality witness fields are needed; the shape is the proof.
type TotalMap<K, V> {
  lookup: fn(K) -> V
}
// TotalPolicy<K, Context, RowTemplate> is the substrate carrier for a
// total dispatch table over a closed coproduct K WITH payload-bearing
// constructors and/or a runtime Context parameter. One row template per
// constructor of K (not per concrete payload value); the RowTemplate
// carries holes that the runtime materializes by substituting the
// constructor's payload + the Context. See docs/design-dissolution-lens.md
// §5 L1.13.c (Pattern B) for the pattern this carrier dissolves (e.g.
// `rust_serde_policy_table` over `VariantNamingConstructor`).
//
// Practice 2 (illegal states unrepresentable): same shape rationale as
// TotalMap — the carrier is a function `fn(K, Context) -> RowTemplate`,
// so duplicate-keys-with-conflicting-row-templates is structurally
// unrepresentable. Totality is match-exhaustiveness on K's constructors
// inside the `lookup` body; payload + Context flow into the row template
// at the call site (`total_policy_apply` in the design-doc clean shape).
type TotalPolicy<K, Context, RowTemplate> {
  lookup: fn(K, Context) -> RowTemplate
}
