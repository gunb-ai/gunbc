// src/v4/std/collection.dag
// Scope: container carriers grounded in algebraic constructions.
// Owns: List, non_empty, list_snoc_item, list_append, Set, FiniteSet, Map, empty_map, map_insert, TotalMap, TotalPolicy.
// Consumes: std/algebra.dag; std/witness.dag; std/diagnostic.dag; std/node.dag.
// Status: T-3 modeled.
// Anchor: https://en.wikipedia.org/wiki/Free_monoid


module v4.std.collection


import v4.std.algebra { FreeMonoid, PointwisePower, is_empty }
import v4.std.diagnostic { Diagnostic, ExternalContractUnknown, Unavailable, port_locus }
import v4.std.node { Symbol }
import v4.std.witness { Holds, Violates, Witness }
type List<T> = FreeMonoid<T>
fn non_empty<T>(xs: List<T>) -> Bool {
  match is_empty(xs: xs) {
    true => false
    false => true
  }
}
fn list_snoc_item<T>(xs: FreeMonoid<T>, item: T) -> FreeMonoid<T> {
  list_append(left: xs, right: Cons { head: item, tail: Empty })
}
fn list_append<T>(left: FreeMonoid<T>, right: FreeMonoid<T>) -> FreeMonoid<T> {
  match left {
    Empty => right
    Cons { head: h, tail: t } => Cons {
      head: h,
      tail: list_append(left: t, right: right)
    }
  }
}
type Set<T> = PointwisePower<T>
type Map<K, V> {
  lookup: fn(K) -> Witness<V>
}
data map_key_absent: Symbol = map_key_absent
data map_lookup_port: Symbol = map_lookup_port
fn map_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: map_key_absent,
    at: port_locus(port: map_lookup_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}
fn empty_map<K, V>() -> Map<K, V> {
  Map {
    lookup: fn(_) {
      Violates { diagnostic: map_absent_diagnostic() }
    }
  }
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  Map {
    lookup: fn(candidate) {
      match candidate == key {
        true => Holds { value: value }
        false => m.lookup(candidate)
      }
    }
  }
}
// 🟡 needs-more-work — feature:finite-set-uniqueness-witness — dissolve-on: std/algebra derived unique: Witness<Holds> projection; FiniteSet binds structural unique field
type FiniteSet<T> {
  head: T
  tail: List<T>
}
type TotalMap<K, V> {
  lookup: fn(K) -> V
}
type TotalPolicy<K, Context, RowTemplate> {
  lookup: fn(K, Context) -> RowTemplate
}
