// src/v4/std/collection.dag
// Scope: container carriers grounded in algebraic constructions.
// Anchor: https://en.wikipedia.org/wiki/Free_monoid
// Owns: List, Set, Map, ListCombinators, SetCombinators, MapCombinators, SetAlgebra.
// Consumes: std algebra, std logic, std witness.
// Status: T-3 modeled; substrate-extension rule in src/v4/STRUCTURE.md.


module v4.std.collection


import v4.std.algebra { FreeMonoid, PointwisePower }
import v4.std.logic { Bool }
import v4.std.witness { Witness }
type List<T> = FreeMonoid<T>
type Set<T> = PointwisePower<T>
type Map<K, V> {
  lookup: fn(K) -> Witness<V>
}
type ListCombinators<T, U, Acc> {
  map: fn(List<T>, fn(T) -> U) -> List<U>
  filter: fn(List<T>, fn(T) -> Bool) -> List<T>
  fold: fn(List<T>, Acc, fn(Acc, T) -> Acc) -> Acc
  flat_map: fn(List<T>, fn(T) -> List<U>) -> List<U>
  any: fn(List<T>, fn(T) -> Bool) -> Bool
  all: fn(List<T>, fn(T) -> Bool) -> Bool
  count: fn(List<T>) -> Int
}
type SetAlgebra<T> {
  union: fn(Set<T>, Set<T>) -> Set<T>
  intersect: fn(Set<T>, Set<T>) -> Set<T>
  diff: fn(Set<T>, Set<T>) -> Set<T>
  complement: fn(Set<T>) -> Set<T>
  member: fn(Set<T>, T) -> Bool
}
type SetCombinators<T, U, Acc> {
  map: fn(Set<T>, fn(T) -> U) -> Set<U>
  filter: fn(Set<T>, fn(T) -> Bool) -> Set<T>
  fold: fn(Set<T>, Acc, fn(Acc, T) -> Acc) -> Acc
  flat_map: fn(Set<T>, fn(T) -> Set<U>) -> Set<U>
  any: fn(Set<T>, fn(T) -> Bool) -> Bool
  all: fn(Set<T>, fn(T) -> Bool) -> Bool
  count: fn(Set<T>) -> Int
}
type MapCombinators<K, V, U, Acc> {
  keys: fn(Map<K, V>) -> List<K>
  values: fn(Map<K, V>) -> List<V>
  map_values: fn(Map<K, V>, fn(V) -> U) -> Map<K, U>
  filter_values: fn(Map<K, V>, fn(V) -> Bool) -> Map<K, V>
  fold_values: fn(Map<K, V>, Acc, fn(Acc, V) -> Acc) -> Acc
  count: fn(Map<K, V>) -> Int
}
