// src/v4/std/host_run.dag
// Scope: emit-host run receipts (W2 / joint runner spec §4.2).
// Status: Host arm of ExecutionEvidence; falsification lives in test_claim_falsification.dag.

module v4.std.host_run


import v4.std.collection { List }
import v4.std.diagnostic { Outcome }
import v4.std.machine { Byte }
import v4.std.target_model { TargetModel }
import v4.std.text { String }
import v4.std.witness { Witness }


type ByteString = List<Byte>

type BuildLog {
  lines: List<String>
}

type ExitOk {
  code: Int
}

type HostExit = Outcome<Witness<ExitOk>>

type EmitHostRunReceipt {
  target: TargetModel
  source_text: String
  exit: HostExit
  stdout_bytes: ByteString
  stderr_bytes: ByteString
  build_log: BuildLog
}

type ValueDiff<A> {
  expected: A
  actual: A
}
