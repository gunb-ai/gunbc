// src/v2.5/extdeps/languages/rust.dag
// Scope: Rust target-primitive fact bundle (scalar/reference/visibility/cost carriers) for the v2.5 fork.
// Owns: RustIntKind, RustIntWidth, RustFloatWidth, RustScalar, RustReferenceKind, NamedSegment, PubInPath, RustVisibility, RustReference, RustCost.
// Consumes: v2_5.std.node.Node, Symbol; kernel-ambient Int, List.
// Status: scaffold:v2_5.std.node — design scaffold until v2_5.std.node lands on the fork (compile exercise blocked).
// Anchor: https://doc.rust-lang.org/reference/

module v2_5.extdeps.languages.rust

import v2_5.std.node { Node, Symbol }

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustIntKind
  = Signed
  | Unsigned

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Bits128
  | Pointer

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustFloatWidth
  = Bits32
  | Bits64

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustScalar
  = IntScalar { kind: RustIntKind, width: RustIntWidth }
  | FloatScalar { width: RustFloatWidth }
  | BoolScalar
  | CharScalar
  | StrScalar
  | NeverScalar

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustReferenceKind
  = Shared
  | Exclusive

type NamedSegment {
  id: Symbol
}

type PubInPath {
  resolved_path: List<NamedSegment>
}

// 🟢 coproduct dissolution — CP-3229-GREEN-TERMINAL.
type RustVisibility
  = Private
  | Pub
  | PubIn { path: PubInPath }

type RustReference {
  kind: RustReferenceKind
  lifetime: Symbol
  referent: Node
}

type RustCost {
  instruction_cost: Int
  allocation_cost: Int
}
