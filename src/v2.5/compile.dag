// Scope: v2.5 pipeline orchestrator — phase-typed stage composition as first-class data.
// Owns: PipelineStageKind, PipelineStageRow, v2_5_compile_pipeline, PipelineCarrier,
//       CompilePipelineState, compile_pipeline_io_ok, run_compile_pipeline_fold, compile.
// Consumes: v2_5.std.diagnostic + v2_5.std.node (Tier 0, PR #3422 — in tree),
//           v2_5.std.stage_types (Tier 1 — vivid-lynx-807, pending),
//           v2_5.compiler.{tokenize,parse,resolve,normalize,infer,complexity,ownership,artifact,emit} (Tier 2 — pending).
// Status: fork scaffold — orchestrator only; does not inspect Node/Edge shape.
//         Full v2.5 compile closure requires Tier 1+2 sibling PRs; v2-compiler can compile Tier 0 std alone today.
// Anchor: https://en.wikipedia.org/wiki/Compiler

module v2_5.compiler.compile

import v2_5.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  PortLocus,
  Unavailable
}
import v2_5.std.stage_types {
  Source,
  TokenStream,
  ParseNode,
  ResolvedNode,
  NormalizedNode,
  InferredNode,
  TargetSource,
  TargetSpec,
  source_type,
  token_stream_type,
  parse_node_type,
  resolved_node_type,
  normalized_node_type,
  inferred_node_type,
  target_source_type
}
import v2_5.compiler.tokenize { tokenize }
import v2_5.compiler.parse { parse }
import v2_5.compiler.resolve { resolve }
import v2_5.compiler.normalize { normalize }
import v2_5.compiler.infer { infer, InferResult }
import v2_5.compiler.complexity {
  ComplexityReport,
  complexity_analyze,
  empty_complexity_report
}
import v2_5.compiler.ownership { OwnershipProof, ownership_analyze }
import v2_5.compiler.artifact {
  ArtifactPlan,
  default_artifact_plan,
  empty_artifact_plan
}
import v2_5.compiler.emit { emit }

// =========================================================================
// Pipeline-as-data — stage order, gate policy, phase I/O symbols (P2)
// =========================================================================

type PipelineStageKind
  = StageTokenize
  | StageParse
  | StageResolve
  | StageNormalize
  | StageInfer
  | StageComplexity
  | StageOwnership
  | StageArtifactPlan
  | StageEmit

type PipelineGatePolicy
  = BlockingOnErrors
  | SurfaceOnly

type PipelineStageRow {
  stage: PipelineStageKind
  gate: PipelineGatePolicy
  consumes: Symbol
  produces: Symbol
}

// Apply PipelineStageRow.gate to a stage-reported would-block flag (single gate authority).
fn pipeline_stage_blocks_emit(policy: PipelineGatePolicy, stage_would_block: Bool) -> Bool {
  match policy {
    BlockingOnErrors => stage_would_block
    SurfaceOnly => false
  }
}

fn pipeline_row_io_matches(row: PipelineStageRow) -> Bool {
  match row.stage {
    StageTokenize => (row.consumes == source_type) && (row.produces == token_stream_type)
    StageParse => (row.consumes == token_stream_type) && (row.produces == parse_node_type)
    StageResolve => (row.consumes == parse_node_type) && (row.produces == resolved_node_type)
    StageNormalize => (row.consumes == resolved_node_type) && (row.produces == normalized_node_type)
    StageInfer => (row.consumes == normalized_node_type) && (row.produces == inferred_node_type)
    StageComplexity => (row.consumes == inferred_node_type) && (row.produces == inferred_node_type)
    StageOwnership => (row.consumes == inferred_node_type) && (row.produces == inferred_node_type)
    StageArtifactPlan => (row.consumes == inferred_node_type) && (row.produces == inferred_node_type)
    StageEmit => (row.consumes == inferred_node_type) && (row.produces == target_source_type)
  }
}

fn pipeline_adjacent_link_ok(prev: PipelineStageRow, next: PipelineStageRow) -> Bool {
  prev.produces == next.consumes
}

// Row constants — shared by the data table and the IO well-formedness gate.
fn pipeline_row_tokenize() -> PipelineStageRow {
  PipelineStageRow { stage: StageTokenize, gate: BlockingOnErrors, consumes: source_type, produces: token_stream_type }
}

fn pipeline_row_parse() -> PipelineStageRow {
  PipelineStageRow { stage: StageParse, gate: BlockingOnErrors, consumes: token_stream_type, produces: parse_node_type }
}

fn pipeline_row_resolve() -> PipelineStageRow {
  PipelineStageRow { stage: StageResolve, gate: BlockingOnErrors, consumes: parse_node_type, produces: resolved_node_type }
}

fn pipeline_row_normalize() -> PipelineStageRow {
  PipelineStageRow { stage: StageNormalize, gate: BlockingOnErrors, consumes: resolved_node_type, produces: normalized_node_type }
}

fn pipeline_row_infer() -> PipelineStageRow {
  PipelineStageRow { stage: StageInfer, gate: BlockingOnErrors, consumes: normalized_node_type, produces: inferred_node_type }
}

fn pipeline_row_complexity() -> PipelineStageRow {
  PipelineStageRow { stage: StageComplexity, gate: SurfaceOnly, consumes: inferred_node_type, produces: inferred_node_type }
}

fn pipeline_row_ownership() -> PipelineStageRow {
  PipelineStageRow { stage: StageOwnership, gate: BlockingOnErrors, consumes: inferred_node_type, produces: inferred_node_type }
}

fn pipeline_row_artifact_plan() -> PipelineStageRow {
  PipelineStageRow { stage: StageArtifactPlan, gate: BlockingOnErrors, consumes: inferred_node_type, produces: inferred_node_type }
}

fn pipeline_row_emit() -> PipelineStageRow {
  PipelineStageRow { stage: StageEmit, gate: BlockingOnErrors, consumes: inferred_node_type, produces: target_source_type }
}

// 🟡 Scaffold receipt only — row builders == table by construction today; real mis-wiring
// should become unrepresentable when Tier 1 gives phase-typed PipelineStageRow constructors.
fn compile_pipeline_io_ok() -> Bool {
  let r0 = pipeline_row_tokenize()
  let r1 = pipeline_row_parse()
  let r2 = pipeline_row_resolve()
  let r3 = pipeline_row_normalize()
  let r4 = pipeline_row_infer()
  let r5 = pipeline_row_complexity()
  let r6 = pipeline_row_ownership()
  let r7 = pipeline_row_artifact_plan()
  let r8 = pipeline_row_emit()
  pipeline_row_io_matches(row: r0)
    && pipeline_row_io_matches(row: r1)
    && pipeline_row_io_matches(row: r2)
    && pipeline_row_io_matches(row: r3)
    && pipeline_row_io_matches(row: r4)
    && pipeline_row_io_matches(row: r5)
    && pipeline_row_io_matches(row: r6)
    && pipeline_row_io_matches(row: r7)
    && pipeline_row_io_matches(row: r8)
    && pipeline_adjacent_link_ok(prev: r0, next: r1)
    && pipeline_adjacent_link_ok(prev: r1, next: r2)
    && pipeline_adjacent_link_ok(prev: r2, next: r3)
    && pipeline_adjacent_link_ok(prev: r3, next: r4)
    && pipeline_adjacent_link_ok(prev: r4, next: r5)
    && pipeline_adjacent_link_ok(prev: r5, next: r6)
    && pipeline_adjacent_link_ok(prev: r6, next: r7)
    && pipeline_adjacent_link_ok(prev: r7, next: r8)
}

// Single authority for row shape — compile_pipeline_io_ok() checks these builders match the table.
data v2_5_compile_pipeline: List<PipelineStageRow> = [
  pipeline_row_tokenize(),
  pipeline_row_parse(),
  pipeline_row_resolve(),
  pipeline_row_normalize(),
  pipeline_row_infer(),
  pipeline_row_complexity(),
  pipeline_row_ownership(),
  pipeline_row_artifact_plan(),
  pipeline_row_emit()
]

data compile_pipeline_mis_wired: Symbol = compile_pipeline_mis_wired
data compile_pipeline_carrier_mismatch: Symbol = compile_pipeline_carrier_mismatch

fn compile_pipeline_mis_wired_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: compile_pipeline_mis_wired,
    at: PortLocus { port: compile_pipeline_mis_wired },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn compile_pipeline_carrier_mismatch_diagnostic(stage: PipelineStageKind) -> Diagnostic {
  Diagnostic {
    reason: compile_pipeline_carrier_mismatch,
    at: PortLocus { port: compile_pipeline_mis_wired },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn pipeline_table_well_formed() -> Outcome<List<PipelineStageRow>> {
  if compile_pipeline_io_ok() {
    Produced { value: v2_5_compile_pipeline }
  } else {
    Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
  }
}

// =========================================================================
// Pipeline carrier — closed sum for execution position (not Node field-presence)
// =========================================================================

type PipelineCarrier
  = CarrierSource { source: Source }
  | CarrierTokens { source: Source, tokens: TokenStream }
  | CarrierParsed { source: Source, tokens: TokenStream, parsed: ParseNode }
  | CarrierResolved { source: Source, tokens: TokenStream, parsed: ParseNode, resolved: ResolvedNode }
  | CarrierNormalized {
      source: Source
      tokens: TokenStream
      parsed: ParseNode
      resolved: ResolvedNode
      normalized: NormalizedNode
    }
  | CarrierInferred {
      source: Source
      spec: TargetSpec
      tokens: TokenStream
      parsed: ParseNode
      resolved: ResolvedNode
      normalized: NormalizedNode
      inferred: InferredNode
    }
  | CarrierEmitted { spec: TargetSpec, inferred: InferredNode, target: TargetSource }
  | CarrierHalted { diagnostics: List<Diagnostic> }

type CompilePipelineState {
  carrier: PipelineCarrier
  spec: TargetSpec
  emit_blocked: Bool
  run_emit: Bool
  complexity: ComplexityReport
  ownership: List<OwnershipProof>
  artifact_plan: ArtifactPlan
  stage_diags: List<Diagnostic>
}

fn pipeline_state_halted(state: CompilePipelineState, diagnostics: List<Diagnostic>) -> CompilePipelineState {
  CompilePipelineState {
    carrier: CarrierHalted { diagnostics: concat(state.stage_diags, diagnostics) },
    spec: state.spec,
    emit_blocked: state.emit_blocked,
    run_emit: state.run_emit,
    complexity: state.complexity,
    ownership: state.ownership,
    artifact_plan: state.artifact_plan,
    stage_diags: concat(state.stage_diags, diagnostics)
  }
}

fn pipeline_state_carrier_mismatch(state: CompilePipelineState, stage: PipelineStageKind) -> CompilePipelineState {
  pipeline_state_halted(state: state, diagnostics: [compile_pipeline_carrier_mismatch_diagnostic(stage: stage)])
}

fn pipeline_carrier_is_halted(carrier: PipelineCarrier) -> Bool {
  match carrier {
    CarrierHalted { diagnostics: _ } => true
    _ => false
  }
}

// =========================================================================
// Stage dispatch — one arm per PipelineStageKind; gates read row.gate only
// =========================================================================

fn apply_pipeline_stage(state: CompilePipelineState, row: PipelineStageRow) -> CompilePipelineState {
  if pipeline_carrier_is_halted(carrier: state.carrier) {
    return state
  }
  match row.stage {
    StageTokenize =>
      match state.carrier {
        CarrierSource { source: source } =>
          match tokenize(source: source) {
            Produced { value: tokens } =>
              CompilePipelineState {
                carrier: CarrierTokens { source: source, tokens: tokens },
                spec: state.spec,
                emit_blocked: state.emit_blocked,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: state.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageParse =>
      match state.carrier {
        CarrierTokens { source: source, tokens: tokens } =>
          match parse(tokens: tokens, source: source) {
            Produced { value: parsed } =>
              CompilePipelineState {
                carrier: CarrierParsed { source: source, tokens: tokens, parsed: parsed },
                spec: state.spec,
                emit_blocked: state.emit_blocked,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: state.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageResolve =>
      match state.carrier {
        CarrierParsed { source: source, tokens: tokens, parsed: parsed } =>
          match resolve(parsed: parsed) {
            Produced { value: resolved } =>
              CompilePipelineState {
                carrier: CarrierResolved { source: source, tokens: tokens, parsed: parsed, resolved: resolved },
                spec: state.spec,
                emit_blocked: state.emit_blocked,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: state.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageNormalize =>
      match state.carrier {
        CarrierResolved { source: source, tokens: tokens, parsed: parsed, resolved: resolved } =>
          match normalize(resolved: resolved) {
            Produced { value: normalized } =>
              CompilePipelineState {
                carrier: CarrierNormalized {
                  source: source,
                  tokens: tokens,
                  parsed: parsed,
                  resolved: resolved,
                  normalized: normalized
                },
                spec: state.spec,
                emit_blocked: state.emit_blocked,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: state.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageInfer =>
      match state.carrier {
        CarrierNormalized { source: source, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized } =>
          match infer(normalized: normalized) {
            Produced { value: result } =>
              let infer_blocks_emit = pipeline_stage_blocks_emit(policy: row.gate, stage_would_block: result.blocks_emit)
              CompilePipelineState {
                carrier: CarrierInferred {
                  source: source,
                  spec: state.spec,
                  tokens: tokens,
                  parsed: parsed,
                  resolved: resolved,
                  normalized: normalized,
                  inferred: result.node
                },
                spec: state.spec,
                emit_blocked: state.emit_blocked || infer_blocks_emit,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: concat(state.stage_diags, result.diagnostics)
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageComplexity =>
      match state.carrier {
        CarrierInferred { source: source, spec: spec, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized, inferred: inferred } =>
          match complexity_analyze(inferred: inferred) {
            Produced { value: result } =>
              let complexity_blocks_emit = pipeline_stage_blocks_emit(policy: row.gate, stage_would_block: result.blocks_emit)
              CompilePipelineState {
                carrier: CarrierInferred {
                  source: source,
                  spec: spec,
                  tokens: tokens,
                  parsed: parsed,
                  resolved: resolved,
                  normalized: normalized,
                  inferred: inferred
                },
                spec: state.spec,
                emit_blocked: state.emit_blocked || complexity_blocks_emit,
                run_emit: state.run_emit,
                complexity: result.report,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: concat(state.stage_diags, result.diagnostics)
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageOwnership =>
      if state.emit_blocked {
        state
      } else {
        match state.carrier {
          CarrierInferred { source: source, spec: spec, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized, inferred: inferred } =>
            match ownership_analyze(inferred: inferred) {
              Produced { value: result } =>
                let ownership_blocks_emit = pipeline_stage_blocks_emit(policy: row.gate, stage_would_block: result.blocks_emit)
                CompilePipelineState {
                  carrier: CarrierInferred {
                    source: source,
                    spec: spec,
                    tokens: tokens,
                    parsed: parsed,
                    resolved: resolved,
                    normalized: normalized,
                    inferred: inferred
                  },
                  spec: state.spec,
                  emit_blocked: state.emit_blocked || ownership_blocks_emit,
                  run_emit: state.run_emit,
                  complexity: state.complexity,
                  ownership: result.proofs,
                  artifact_plan: state.artifact_plan,
                  stage_diags: concat(state.stage_diags, result.diagnostics)
                }
              Rejected { diagnostic: d } =>
                pipeline_state_halted(state: state, diagnostics: [d])
            }
          _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
        }
      }
    StageArtifactPlan =>
      if state.emit_blocked {
        state
      } else {
        match state.carrier {
          CarrierInferred { source: source, spec: spec, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized, inferred: inferred } =>
            match default_artifact_plan(inferred: inferred, spec: state.spec) {
              Produced { value: plan } =>
                CompilePipelineState {
                  carrier: CarrierInferred {
                    source: source,
                    spec: spec,
                    tokens: tokens,
                    parsed: parsed,
                    resolved: resolved,
                    normalized: normalized,
                    inferred: inferred
                  },
                  spec: state.spec,
                  emit_blocked: state.emit_blocked,
                  run_emit: state.run_emit,
                  complexity: state.complexity,
                  ownership: state.ownership,
                  artifact_plan: plan,
                  stage_diags: state.stage_diags
                }
              Rejected { diagnostic: d } =>
                pipeline_state_halted(state: state, diagnostics: [d])
            }
          _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
        }
      }
    StageEmit =>
      if !state.run_emit || state.emit_blocked {
        state
      } else {
        match state.carrier {
          CarrierInferred { source: source, spec: spec, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized, inferred: inferred } =>
            match emit(inferred: inferred, spec: state.spec, plan: state.artifact_plan) {
              Produced { value: target } =>
                CompilePipelineState {
                  carrier: CarrierEmitted { spec: spec, inferred: inferred, target: target },
                  spec: state.spec,
                  emit_blocked: state.emit_blocked,
                  run_emit: state.run_emit,
                  complexity: state.complexity,
                  ownership: state.ownership,
                  artifact_plan: state.artifact_plan,
                  stage_diags: state.stage_diags
                }
              Rejected { diagnostic: d } =>
                pipeline_state_halted(state: state, diagnostics: [d])
            }
          _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
        }
      }
  }
}

fn run_compile_pipeline_fold(pipeline: List<PipelineStageRow>, source: Source, spec: TargetSpec, run_emit: Bool) -> CompilePipelineState {
  let initial = CompilePipelineState {
    carrier: CarrierSource { source: source },
    spec: spec,
    emit_blocked: false,
    run_emit: run_emit,
    complexity: empty_complexity_report(),
    ownership: [],
    artifact_plan: empty_artifact_plan(),
    stage_diags: []
  }
  fold(pipeline, init: initial, f: (state, row) => apply_pipeline_stage(state: state, row: row))
}

// =========================================================================
// Public API — compile : Source × TargetSpec -> Outcome<TargetSource>
// =========================================================================

fn compile_pipeline_emit_blocked_diagnostic(state: CompilePipelineState) -> Diagnostic {
  match state.stage_diags |> first {
    Some { value: d } => d
    None => compile_pipeline_mis_wired_diagnostic()
  }
}

fn compile_pipeline_state_to_outcome(state: CompilePipelineState) -> Outcome<TargetSource> {
  if state.emit_blocked {
    Rejected { diagnostic: compile_pipeline_emit_blocked_diagnostic(state: state) }
  } else {
    match state.carrier {
      CarrierEmitted { target: target } => Produced { value: target }
      CarrierHalted { diagnostics: diags } =>
        match diags |> first {
          Some { value: d } => Rejected { diagnostic: d }
          None => Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
        }
      _ => Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
    }
  }
}

fn compile(source: Source, spec: TargetSpec) -> Outcome<TargetSource> {
  match pipeline_table_well_formed() {
    Produced { value: pipeline } =>
      let state = run_compile_pipeline_fold(pipeline: pipeline, source: source, spec: spec, run_emit: true)
      compile_pipeline_state_to_outcome(state: state)
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}

fn compile_to_inferred(source: Source, spec: TargetSpec) -> Outcome<InferredNode> {
  match pipeline_table_well_formed() {
    Produced { value: pipeline } =>
      let state = run_compile_pipeline_fold(pipeline: pipeline, source: source, spec: spec, run_emit: false)
      if state.emit_blocked {
        Rejected { diagnostic: compile_pipeline_emit_blocked_diagnostic(state: state) }
      } else {
        match state.carrier {
          CarrierInferred { inferred: inferred } => Produced { value: inferred }
          CarrierHalted { diagnostics: diags } =>
            match diags |> first {
              Some { value: d } => Rejected { diagnostic: d }
              None => Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
            }
          _ => Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
        }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}
