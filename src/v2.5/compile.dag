// Scope: v2.5 pipeline orchestrator — phase-typed stage composition as first-class data.
// Owns: PipelineStageKind, PipelineStageRow, v2_5_compile_pipeline, PipelineCarrier,
//       CompilePipelineState, compile_pipeline_io_ok, run_compile_pipeline_fold, compile.
// Consumes: v2_5.std.{diagnostic,node,stage_types,token} (Tier 0+1, PR #3422 + #3418),
//           v2_5.compiler.{ports,tokenize,parse,…} (Tier 2 stubs until stage workers land).
// Status: fork scaffold — orchestrator + Tier 2 stubs; does not inspect Node/Edge shape.
//         Rebased onto #3418 dfb926f8c (ParseModule / ResolvedModule / … phase roots).
// Anchor: https://en.wikipedia.org/wiki/Compiler

module v2_5.compiler.compile

import v2_5.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  PortLocus,
  Unavailable
}
import v2_5.std.node { NamedStep, Path, Symbol }
import v2_5.std.token { TokenStream }
import v2_5.std.stage_types {
  ParseModule,
  ResolvedModule,
  NormalizedModule,
  InferredModule,
  TargetSource
}
import v2_5.compiler.ports { SourceText, TargetSpec }
import v2_5.compiler.tokenize { tokenize }
import v2_5.compiler.parse { parse }
import v2_5.compiler.resolve { resolve }
import v2_5.compiler.normalize { normalize }
import v2_5.compiler.infer { infer, InferResult }
import v2_5.compiler.complexity {
  ComplexityReport,
  complexity_analyze,
  empty_complexity_report
}
import v2_5.compiler.ownership { OwnershipProof, ownership_analyze }
import v2_5.compiler.artifact {
  ArtifactPlan,
  default_artifact_plan,
  empty_artifact_plan
}
import v2_5.compiler.emit { emit }

// Pipeline phase I/O symbols (orchestrator-owned until stage_types exports them).
data source_text_type: Symbol = source_text_type
data token_stream_type: Symbol = token_stream_type
data parse_module_type: Symbol = parse_module_type
data resolved_module_type: Symbol = resolved_module_type
data normalized_module_type: Symbol = normalized_module_type
data inferred_module_type: Symbol = inferred_module_type
data target_source_type: Symbol = target_source_type

// Per-stage port symbols — carrier-mismatch and emit-block fallbacks preserve boundary facts.
data compile_pipeline_stage_tokenize: Symbol = compile_pipeline_stage_tokenize
data compile_pipeline_stage_parse: Symbol = compile_pipeline_stage_parse
data compile_pipeline_stage_resolve: Symbol = compile_pipeline_stage_resolve
data compile_pipeline_stage_normalize: Symbol = compile_pipeline_stage_normalize
data compile_pipeline_stage_infer: Symbol = compile_pipeline_stage_infer
data compile_pipeline_stage_complexity: Symbol = compile_pipeline_stage_complexity
data compile_pipeline_stage_ownership: Symbol = compile_pipeline_stage_ownership
data compile_pipeline_stage_artifact_plan: Symbol = compile_pipeline_stage_artifact_plan
data compile_pipeline_stage_emit: Symbol = compile_pipeline_stage_emit
data compile_pipeline_emit_blocked: Symbol = compile_pipeline_emit_blocked

// =========================================================================
// Pipeline-as-data — stage order, gate policy, phase I/O symbols (P2)
// =========================================================================

type PipelineStageKind
  = StageTokenize
  | StageParse
  | StageResolve
  | StageNormalize
  | StageInfer
  | StageComplexity
  | StageOwnership
  | StageArtifactPlan
  | StageEmit

type PipelineGatePolicy
  = BlockingOnErrors
  | SurfaceOnly

type PipelineStageRow {
  stage: PipelineStageKind
  gate: PipelineGatePolicy
  consumes: Symbol
  produces: Symbol
}

// Apply PipelineStageRow.gate to a stage-reported would-block flag (single gate authority).
fn pipeline_stage_blocks_emit(policy: PipelineGatePolicy, stage_would_block: Bool) -> Bool {
  match policy {
    BlockingOnErrors => stage_would_block
    SurfaceOnly => false
  }
}

fn pipeline_row_io_matches(row: PipelineStageRow) -> Bool {
  match row.stage {
    StageTokenize => (row.consumes == source_text_type) && (row.produces == token_stream_type)
    StageParse => (row.consumes == token_stream_type) && (row.produces == parse_module_type)
    StageResolve => (row.consumes == parse_module_type) && (row.produces == resolved_module_type)
    StageNormalize => (row.consumes == resolved_module_type) && (row.produces == normalized_module_type)
    StageInfer => (row.consumes == normalized_module_type) && (row.produces == inferred_module_type)
    StageComplexity => (row.consumes == inferred_module_type) && (row.produces == inferred_module_type)
    StageOwnership => (row.consumes == inferred_module_type) && (row.produces == inferred_module_type)
    StageArtifactPlan => (row.consumes == inferred_module_type) && (row.produces == inferred_module_type)
    StageEmit => (row.consumes == inferred_module_type) && (row.produces == target_source_type)
  }
}

fn pipeline_adjacent_link_ok(prev: PipelineStageRow, next: PipelineStageRow) -> Bool {
  prev.produces == next.consumes
}

// Row constants — shared by the data table and the IO well-formedness gate.
fn pipeline_row_tokenize() -> PipelineStageRow {
  PipelineStageRow { stage: StageTokenize, gate: BlockingOnErrors, consumes: source_text_type, produces: token_stream_type }
}

fn pipeline_row_parse() -> PipelineStageRow {
  PipelineStageRow { stage: StageParse, gate: BlockingOnErrors, consumes: token_stream_type, produces: parse_module_type }
}

fn pipeline_row_resolve() -> PipelineStageRow {
  PipelineStageRow { stage: StageResolve, gate: BlockingOnErrors, consumes: parse_module_type, produces: resolved_module_type }
}

fn pipeline_row_normalize() -> PipelineStageRow {
  PipelineStageRow { stage: StageNormalize, gate: BlockingOnErrors, consumes: resolved_module_type, produces: normalized_module_type }
}

fn pipeline_row_infer() -> PipelineStageRow {
  PipelineStageRow { stage: StageInfer, gate: BlockingOnErrors, consumes: normalized_module_type, produces: inferred_module_type }
}

fn pipeline_row_complexity() -> PipelineStageRow {
  PipelineStageRow { stage: StageComplexity, gate: SurfaceOnly, consumes: inferred_module_type, produces: inferred_module_type }
}

fn pipeline_row_ownership() -> PipelineStageRow {
  PipelineStageRow { stage: StageOwnership, gate: BlockingOnErrors, consumes: inferred_module_type, produces: inferred_module_type }
}

fn pipeline_row_artifact_plan() -> PipelineStageRow {
  PipelineStageRow { stage: StageArtifactPlan, gate: BlockingOnErrors, consumes: inferred_module_type, produces: inferred_module_type }
}

fn pipeline_row_emit() -> PipelineStageRow {
  PipelineStageRow { stage: StageEmit, gate: BlockingOnErrors, consumes: inferred_module_type, produces: target_source_type }
}

// 🟡 Scaffold receipt only — row builders == table by construction today; real mis-wiring
// should become unrepresentable when Tier 1 gives phase-typed PipelineStageRow constructors.
fn compile_pipeline_io_ok() -> Bool {
  let r0 = pipeline_row_tokenize()
  let r1 = pipeline_row_parse()
  let r2 = pipeline_row_resolve()
  let r3 = pipeline_row_normalize()
  let r4 = pipeline_row_infer()
  let r5 = pipeline_row_complexity()
  let r6 = pipeline_row_ownership()
  let r7 = pipeline_row_artifact_plan()
  let r8 = pipeline_row_emit()
  pipeline_row_io_matches(row: r0)
    && pipeline_row_io_matches(row: r1)
    && pipeline_row_io_matches(row: r2)
    && pipeline_row_io_matches(row: r3)
    && pipeline_row_io_matches(row: r4)
    && pipeline_row_io_matches(row: r5)
    && pipeline_row_io_matches(row: r6)
    && pipeline_row_io_matches(row: r7)
    && pipeline_row_io_matches(row: r8)
    && pipeline_adjacent_link_ok(prev: r0, next: r1)
    && pipeline_adjacent_link_ok(prev: r1, next: r2)
    && pipeline_adjacent_link_ok(prev: r2, next: r3)
    && pipeline_adjacent_link_ok(prev: r3, next: r4)
    && pipeline_adjacent_link_ok(prev: r4, next: r5)
    && pipeline_adjacent_link_ok(prev: r5, next: r6)
    && pipeline_adjacent_link_ok(prev: r6, next: r7)
    && pipeline_adjacent_link_ok(prev: r7, next: r8)
}

// Single authority for row shape — compile_pipeline_io_ok() checks these builders match the table.
data v2_5_compile_pipeline: List<PipelineStageRow> = [
  pipeline_row_tokenize(),
  pipeline_row_parse(),
  pipeline_row_resolve(),
  pipeline_row_normalize(),
  pipeline_row_infer(),
  pipeline_row_complexity(),
  pipeline_row_ownership(),
  pipeline_row_artifact_plan(),
  pipeline_row_emit()
]

data compile_pipeline_mis_wired: Symbol = compile_pipeline_mis_wired
data compile_pipeline_carrier_mismatch: Symbol = compile_pipeline_carrier_mismatch

fn compile_pipeline_port_path(port: Symbol) -> Path {
  Path { steps: [NamedStep { name: port }] }
}

fn pipeline_stage_port(stage: PipelineStageKind) -> Symbol {
  match stage {
    StageTokenize => compile_pipeline_stage_tokenize
    StageParse => compile_pipeline_stage_parse
    StageResolve => compile_pipeline_stage_resolve
    StageNormalize => compile_pipeline_stage_normalize
    StageInfer => compile_pipeline_stage_infer
    StageComplexity => compile_pipeline_stage_complexity
    StageOwnership => compile_pipeline_stage_ownership
    StageArtifactPlan => compile_pipeline_stage_artifact_plan
    StageEmit => compile_pipeline_stage_emit
  }
}

fn compile_pipeline_mis_wired_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: compile_pipeline_mis_wired,
    at: PortLocus { path: compile_pipeline_port_path(port: compile_pipeline_mis_wired) },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn compile_pipeline_carrier_mismatch_diagnostic(stage: PipelineStageKind) -> Diagnostic {
  Diagnostic {
    reason: compile_pipeline_carrier_mismatch,
    at: PortLocus { path: compile_pipeline_port_path(port: pipeline_stage_port(stage: stage)) },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn compile_pipeline_emit_block_diagnostic_for_stage(stage: PipelineStageKind) -> Diagnostic {
  Diagnostic {
    reason: compile_pipeline_emit_blocked,
    at: PortLocus { path: compile_pipeline_port_path(port: pipeline_stage_port(stage: stage)) },
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

type StageEmitGateResult {
  emit_blocked: Bool
  emit_block_diagnostic: Diagnostic?
  stage_diags: List<Diagnostic>
}

// Carry emit-block authority from the stage that set it — not the first flat-list diagnostic.
fn merge_stage_emit_gate(
  state: CompilePipelineState,
  stage: PipelineStageKind,
  policy: PipelineGatePolicy,
  would_block: Bool,
  new_diags: List<Diagnostic>
) -> StageEmitGateResult {
  let blocks = pipeline_stage_blocks_emit(policy: policy, stage_would_block: would_block)
  let block_diag = match state.emit_block_diagnostic {
    Some { value: _ } => state.emit_block_diagnostic
    None =>
      if blocks {
        match new_diags |> first {
          Some { value: d } => Some { value: d }
          None => Some { value: compile_pipeline_emit_block_diagnostic_for_stage(stage: stage) }
        }
      } else {
        none
      }
  }
  StageEmitGateResult {
    emit_blocked: state.emit_blocked || blocks,
    emit_block_diagnostic: block_diag,
    stage_diags: concat(state.stage_diags, new_diags)
  }
}

fn pipeline_table_well_formed() -> Outcome<List<PipelineStageRow>> {
  if compile_pipeline_io_ok() {
    Produced { value: v2_5_compile_pipeline }
  } else {
    Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
  }
}

// =========================================================================
// Pipeline carrier — closed sum for execution position (not Node field-presence)
// =========================================================================

type PipelineCarrier
  = CarrierSource { source: SourceText }
  | CarrierTokens { source: SourceText, tokens: TokenStream }
  | CarrierParsed { source: SourceText, tokens: TokenStream, parsed: ParseModule }
  | CarrierResolved { source: SourceText, tokens: TokenStream, parsed: ParseModule, resolved: ResolvedModule }
  | CarrierNormalized {
      source: SourceText
      tokens: TokenStream
      parsed: ParseModule
      resolved: ResolvedModule
      normalized: NormalizedModule
    }
  | CarrierInferred {
      source: SourceText
      spec: TargetSpec
      tokens: TokenStream
      parsed: ParseModule
      resolved: ResolvedModule
      normalized: NormalizedModule
      inferred: InferredModule
    }
  | CarrierEmitted { spec: TargetSpec, inferred: InferredModule, target: TargetSource }
  | CarrierHalted { diagnostics: List<Diagnostic> }

type CompilePipelineState {
  carrier: PipelineCarrier
  spec: TargetSpec
  emit_blocked: Bool
  emit_block_diagnostic: Diagnostic?
  run_emit: Bool
  complexity: ComplexityReport
  ownership: List<OwnershipProof>
  artifact_plan: ArtifactPlan
  stage_diags: List<Diagnostic>
}

fn pipeline_state_halted(state: CompilePipelineState, diagnostics: List<Diagnostic>) -> CompilePipelineState {
  CompilePipelineState {
    carrier: CarrierHalted { diagnostics: concat(state.stage_diags, diagnostics) },
    spec: state.spec,
    emit_blocked: state.emit_blocked,
    emit_block_diagnostic: state.emit_block_diagnostic,
    run_emit: state.run_emit,
    complexity: state.complexity,
    ownership: state.ownership,
    artifact_plan: state.artifact_plan,
    stage_diags: concat(state.stage_diags, diagnostics)
  }
}

fn pipeline_state_carrier_mismatch(state: CompilePipelineState, stage: PipelineStageKind) -> CompilePipelineState {
  pipeline_state_halted(state: state, diagnostics: [compile_pipeline_carrier_mismatch_diagnostic(stage: stage)])
}

fn pipeline_carrier_is_halted(carrier: PipelineCarrier) -> Bool {
  match carrier {
    CarrierHalted { diagnostics: _ } => true
    _ => false
  }
}

// =========================================================================
// Stage dispatch — one arm per PipelineStageKind; gates read row.gate only
// =========================================================================

fn apply_pipeline_stage(state: CompilePipelineState, row: PipelineStageRow) -> CompilePipelineState {
  if pipeline_carrier_is_halted(carrier: state.carrier) {
    return state
  }
  match row.stage {
    StageTokenize =>
      match state.carrier {
        CarrierSource { source: source } =>
          match tokenize(source: source) {
            Produced { value: tokens } =>
              CompilePipelineState {
                carrier: CarrierTokens { source: source, tokens: tokens },
                spec: state.spec,
                emit_blocked: state.emit_blocked,
                emit_block_diagnostic: state.emit_block_diagnostic,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: state.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageParse =>
      match state.carrier {
        CarrierTokens { source: source, tokens: tokens } =>
          match parse(tokens: tokens, source: source) {
            Produced { value: parsed } =>
              CompilePipelineState {
                carrier: CarrierParsed { source: source, tokens: tokens, parsed: parsed },
                spec: state.spec,
                emit_blocked: state.emit_blocked,
                emit_block_diagnostic: state.emit_block_diagnostic,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: state.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageResolve =>
      match state.carrier {
        CarrierParsed { source: source, tokens: tokens, parsed: parsed } =>
          match resolve(parsed: parsed) {
            Produced { value: resolved } =>
              CompilePipelineState {
                carrier: CarrierResolved { source: source, tokens: tokens, parsed: parsed, resolved: resolved },
                spec: state.spec,
                emit_blocked: state.emit_blocked,
                emit_block_diagnostic: state.emit_block_diagnostic,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: state.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageNormalize =>
      match state.carrier {
        CarrierResolved { source: source, tokens: tokens, parsed: parsed, resolved: resolved } =>
          match normalize(resolved: resolved) {
            Produced { value: normalized } =>
              CompilePipelineState {
                carrier: CarrierNormalized {
                  source: source,
                  tokens: tokens,
                  parsed: parsed,
                  resolved: resolved,
                  normalized: normalized
                },
                spec: state.spec,
                emit_blocked: state.emit_blocked,
                emit_block_diagnostic: state.emit_block_diagnostic,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: state.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageInfer =>
      match state.carrier {
        CarrierNormalized { source: source, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized } =>
          match infer(normalized: normalized) {
            Produced { value: result } =>
              let gate = merge_stage_emit_gate(
                state: state,
                stage: row.stage,
                policy: row.gate,
                would_block: result.blocks_emit,
                new_diags: result.diagnostics
              )
              CompilePipelineState {
                carrier: CarrierInferred {
                  source: source,
                  spec: state.spec,
                  tokens: tokens,
                  parsed: parsed,
                  resolved: resolved,
                  normalized: normalized,
                  inferred: result.module
                },
                spec: state.spec,
                emit_blocked: gate.emit_blocked,
                emit_block_diagnostic: gate.emit_block_diagnostic,
                run_emit: state.run_emit,
                complexity: state.complexity,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: gate.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageComplexity =>
      match state.carrier {
        CarrierInferred { source: source, spec: spec, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized, inferred: inferred } =>
          match complexity_analyze(inferred: inferred) {
            Produced { value: result } =>
              let gate = merge_stage_emit_gate(
                state: state,
                stage: row.stage,
                policy: row.gate,
                would_block: result.blocks_emit,
                new_diags: result.diagnostics
              )
              CompilePipelineState {
                carrier: CarrierInferred {
                  source: source,
                  spec: spec,
                  tokens: tokens,
                  parsed: parsed,
                  resolved: resolved,
                  normalized: normalized,
                  inferred: inferred
                },
                spec: state.spec,
                emit_blocked: gate.emit_blocked,
                emit_block_diagnostic: gate.emit_block_diagnostic,
                run_emit: state.run_emit,
                complexity: result.report,
                ownership: state.ownership,
                artifact_plan: state.artifact_plan,
                stage_diags: gate.stage_diags
              }
            Rejected { diagnostic: d } =>
              pipeline_state_halted(state: state, diagnostics: [d])
          }
        _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
      }
    StageOwnership =>
      if state.emit_blocked {
        state
      } else {
        match state.carrier {
          CarrierInferred { source: source, spec: spec, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized, inferred: inferred } =>
            match ownership_analyze(inferred: inferred) {
              Produced { value: result } =>
                let gate = merge_stage_emit_gate(
                  state: state,
                  stage: row.stage,
                  policy: row.gate,
                  would_block: result.blocks_emit,
                  new_diags: result.diagnostics
                )
                CompilePipelineState {
                  carrier: CarrierInferred {
                    source: source,
                    spec: spec,
                    tokens: tokens,
                    parsed: parsed,
                    resolved: resolved,
                    normalized: normalized,
                    inferred: inferred
                  },
                  spec: state.spec,
                  emit_blocked: gate.emit_blocked,
                  emit_block_diagnostic: gate.emit_block_diagnostic,
                  run_emit: state.run_emit,
                  complexity: state.complexity,
                  ownership: result.proofs,
                  artifact_plan: state.artifact_plan,
                  stage_diags: gate.stage_diags
                }
              Rejected { diagnostic: d } =>
                pipeline_state_halted(state: state, diagnostics: [d])
            }
          _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
        }
      }
    StageArtifactPlan =>
      if state.emit_blocked {
        state
      } else {
        match state.carrier {
          CarrierInferred { source: source, spec: spec, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized, inferred: inferred } =>
            match default_artifact_plan(inferred: inferred, spec: state.spec) {
              Produced { value: plan } =>
                CompilePipelineState {
                  carrier: CarrierInferred {
                    source: source,
                    spec: spec,
                    tokens: tokens,
                    parsed: parsed,
                    resolved: resolved,
                    normalized: normalized,
                    inferred: inferred
                  },
                  spec: state.spec,
                  emit_blocked: state.emit_blocked,
                  emit_block_diagnostic: state.emit_block_diagnostic,
                  run_emit: state.run_emit,
                  complexity: state.complexity,
                  ownership: state.ownership,
                  artifact_plan: plan,
                  stage_diags: state.stage_diags
                }
              Rejected { diagnostic: d } =>
                pipeline_state_halted(state: state, diagnostics: [d])
            }
          _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
        }
      }
    StageEmit =>
      if !state.run_emit || state.emit_blocked {
        state
      } else {
        match state.carrier {
          CarrierInferred { source: source, spec: spec, tokens: tokens, parsed: parsed, resolved: resolved, normalized: normalized, inferred: inferred } =>
            match emit(inferred: inferred, spec: state.spec, plan: state.artifact_plan) {
              Produced { value: target } =>
                CompilePipelineState {
                  carrier: CarrierEmitted { spec: spec, inferred: inferred, target: target },
                  spec: state.spec,
                  emit_blocked: state.emit_blocked,
                  emit_block_diagnostic: state.emit_block_diagnostic,
                  run_emit: state.run_emit,
                  complexity: state.complexity,
                  ownership: state.ownership,
                  artifact_plan: state.artifact_plan,
                  stage_diags: state.stage_diags
                }
              Rejected { diagnostic: d } =>
                pipeline_state_halted(state: state, diagnostics: [d])
            }
          _ => pipeline_state_carrier_mismatch(state: state, stage: row.stage)
        }
      }
  }
}

fn run_compile_pipeline_fold(rows: List<PipelineStageRow>, source: SourceText, spec: TargetSpec, run_emit: Bool) -> CompilePipelineState {
  let initial = CompilePipelineState {
    carrier: CarrierSource { source: source },
    spec: spec,
    emit_blocked: false,
    emit_block_diagnostic: none,
    run_emit: run_emit,
    complexity: empty_complexity_report(),
    ownership: [],
    artifact_plan: empty_artifact_plan(),
    stage_diags: []
  }
  fold(rows, init: initial, f: (state, row) => apply_pipeline_stage(state: state, row: row))
}

// =========================================================================
// Public API — compile : SourceText × TargetSpec -> Outcome<TargetSource>
// =========================================================================

fn compile_pipeline_emit_blocked_diagnostic(state: CompilePipelineState) -> Diagnostic {
  match state.emit_block_diagnostic {
    Some { value: d } => d
    None => compile_pipeline_mis_wired_diagnostic()
  }
}

fn compile_pipeline_state_to_outcome(state: CompilePipelineState) -> Outcome<TargetSource> {
  if state.emit_blocked {
    Rejected { diagnostic: compile_pipeline_emit_blocked_diagnostic(state: state) }
  } else {
    match state.carrier {
      CarrierEmitted { target: target } => Produced { value: target }
      CarrierHalted { diagnostics: diags } =>
        match diags |> first {
          Some { value: d } => Rejected { diagnostic: d }
          None => Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
        }
      _ => Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
    }
  }
}

fn compile(source: SourceText, spec: TargetSpec) -> Outcome<TargetSource> {
  match pipeline_table_well_formed() {
    Produced { value: rows } =>
      let state = run_compile_pipeline_fold(rows: rows, source: source, spec: spec, run_emit: true)
      compile_pipeline_state_to_outcome(state: state)
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}

fn compile_to_inferred(source: SourceText, spec: TargetSpec) -> Outcome<InferredModule> {
  match pipeline_table_well_formed() {
    Produced { value: rows } =>
      let state = run_compile_pipeline_fold(rows: rows, source: source, spec: spec, run_emit: false)
      if state.emit_blocked {
        Rejected { diagnostic: compile_pipeline_emit_blocked_diagnostic(state: state) }
      } else {
        match state.carrier {
          CarrierInferred { inferred: inferred } => Produced { value: inferred }
          CarrierHalted { diagnostics: diags } =>
            match diags |> first {
              Some { value: d } => Rejected { diagnostic: d }
              None => Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
            }
          _ => Rejected { diagnostic: compile_pipeline_mis_wired_diagnostic() }
        }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}
