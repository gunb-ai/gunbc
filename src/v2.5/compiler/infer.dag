import v2_5.compiler.stub_common { empty_inferred_module }

type InferResult {
  module: InferredModule
  blocks_emit: Bool
  diagnostics: List<Diagnostic>
}

fn infer(normalized: NormalizedModule) -> Outcome<InferResult> {
  Produced {
    value: InferResult {
      module: empty_inferred_module(),
      blocks_emit: false,
      diagnostics: []
    }
  }
}
