// src/v2.5/03_normalize.dag
// Scope: sugar dissolution — ResolvedModule -> NormalizedModule (pipeline);
//   SeamResolvedNode -> SeamNormalizedNode (substrate projection seam).
// Owns: normalize, normalize_seam, c3 sugar rule application.
// Consumes: v2_5.std.stage_types (PR #3418), v2_5.std.sugar_rules, v2_5.std.diagnostic,
//   v2_5.compiler.normalize_forward (Resolved* -> Normalized* item projection).
// Seam edge checks: import edge_is_named / edge_is_positional from v2_5.std.node (no local match).
// Authority: src/v4/TASKS.md §T-8 (C3 desugar).

module v2_5.compiler.normalize


import v2_5.std.diagnostic {
  Diagnostic,
  Outcome,
  Textual,
  Unavailable,
  UserInputBoundary,
  WholeFile
}
import v2_5.std.node {
  Atom,
  Arrow,
  Conj,
  Connective,
  edge_is_named,
  edge_is_positional
}
import v2_5.std.stage_types {
  NormalizedComputationForm,
  NormalizedItem,
  NormalizedModule,
  NormalizedTypeForm,
  ResolvedComputationForm,
  ResolvedCore,
  ResolvedCoreForm,
  ResolvedModule,
  ResolvedModuleItem,
  ResolvedSugarForm,
  ResolvedSugared,
  ResolvedTypeForm,
  SeamNormalizedEdge,
  SeamNormalizedItem,
  SeamNormalizedModule,
  SeamNormalizedModuleNode,
  SeamNormalizedNode,
  SeamNormalizedItemNode,
  SeamResolvedEdge,
  SeamResolvedItem,
  SeamResolvedItemForm,
  SeamResolvedModule,
  SeamResolvedModuleNode,
  SeamResolvedNode,
  SeamResolvedItemNode,
  SourceSpan,
  SurfaceSugarKind,
  Symbol,
  c3_surface_sugar_fn,
  c3_surface_sugar_operation,
  c3_surface_sugar_service,
  c3_surface_sugar_type
}
import v2_5.compiler.item_forward {
  normalize_item_core,
  normalize_resolved_imports
}
import v2_5.compiler.seam_builders {
  seam_normalized_computation_form,
  seam_normalized_type_form
}
import v2_5.std.list { Empty }
import v2_5.std.sugar_rules {
  PeelSinglePositionalChild,
  ReplaceWithArrow,
  ReplaceWithConj,
  RequireAllNamed,
  RequireAllPositional,
  RequireExactlyOnePositional,
  SugarEdgeRequirement,
  SugarReplacement,
  SugarRule,
  c3_sugar_rule_for_kind
}


data normalize_reason_malformed_sugar: Symbol = normalize_reason_malformed_sugar


fn malformed_sugar_diagnostic(span: SourceSpan) -> Diagnostic {
  Diagnostic {
    reason: normalize_reason_malformed_sugar,
    at: Textual { file: span.file, extent: WholeFile },
    correction: Unavailable { reason: UserInputBoundary }
  }
}


fn edges_satisfy(requirement: SugarEdgeRequirement, children: List<SeamResolvedEdge>) -> Bool {
  match requirement {
    RequireAllNamed =>
      fold(children, init: true, f: fn(acc, e) {
        acc && edge_is_named(label: e.label)
      })
    RequireAllPositional =>
      fold(children, init: true, f: fn(acc, e) {
        acc && edge_is_positional(label: e.label)
      })
    RequireExactlyOnePositional =>
      if count(children) == 1 {
        match children |> first {
          Some { value: e0 } => edge_is_positional(label: e0.label)
          None => false
        }
      } else {
        false
      }
  }
}


fn symbol_for_sugar(kind: SurfaceSugarKind) -> Symbol {
  match kind {
    ServiceSugar => c3_surface_sugar_service
    FnSugar => c3_surface_sugar_fn
    TypeSugar => c3_surface_sugar_type
    OperationSugar => c3_surface_sugar_operation
  }
}


fn connective_for_replacement(rep: SugarReplacement, sugar: SurfaceSugarKind) -> Connective {
  match rep {
    ReplaceWithConj => Conj
    ReplaceWithArrow => Arrow
    PeelSinglePositionalChild => Atom { identity: symbol_for_sugar(kind: sugar) }
  }
}


fn normalize_seam_edge(e: SeamResolvedEdge) -> Outcome<SeamNormalizedEdge> {
  match normalize_seam_node(n: e.target) {
    Produced { value: target } =>
      Produced {
        value: SeamNormalizedEdge {
          label: e.label,
          target: target
        }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


fn empty_seam_normalized_edges() -> Outcome<List<SeamNormalizedEdge>> {
  Produced { value: Empty }
}


fn normalize_seam_edges(children: List<SeamResolvedEdge>) -> Outcome<List<SeamNormalizedEdge>> {
  fold(children, init: empty_seam_normalized_edges(), f: fn(acc, e) {
    match acc {
      Rejected { diagnostic: d } => Rejected { diagnostic: d }
      Produced { value: done } =>
        match normalize_seam_edge(e: e) {
          Produced { value: ne } =>
            Produced { value: list_push(done, ne) }
          Rejected { diagnostic: d } => Rejected { diagnostic: d }
        }
    }
  })
}


fn normalize_seam_resolved_form(form: SeamResolvedItemForm) -> Outcome<SeamNormalizedItemForm> {
  match form {
    SeamItemType { type_form: tf } =>
      match normalize_resolved_type_form(form: tf) {
        Produced { value: ntf } =>
          Produced { value: seam_normalized_type_form(type_form: ntf) }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
    SeamItemComputation { computation_form: cf } =>
      match normalize_resolved_computation_form(form: cf) {
        Produced { value: ncf } =>
          Produced { value: seam_normalized_computation_form(computation_form: ncf) }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
  }
}


fn normalized_type_from_seam_node(n: SeamResolvedNode, span: SourceSpan) -> Outcome<NormalizedTypeForm> {
  match n {
    SeamResolvedItemNode { item: item } =>
      match item.form {
        SeamItemType { type_form: tf } => normalize_resolved_type_form(form: tf)
        SeamItemComputation { computation_form: _ } =>
          Rejected { diagnostic: malformed_sugar_diagnostic(span: span) }
      }
    SeamResolvedModuleNode { module: _ } =>
      Rejected { diagnostic: malformed_sugar_diagnostic(span: span) }
  }
}


fn apply_sugar_connective_replacement(
  rule: SugarRule,
  children: List<SeamResolvedEdge>
) -> Outcome<NormalizedTypeForm> {
  match normalize_seam_edges(children: children) {
    Produced { value: normalized_children } =>
      Produced {
        value: NormalizedTypeForm {
          connective: connective_for_replacement(
            rep: rule.replacement,
            sugar: rule.sugar
          ),
          children: normalized_children
        }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


fn apply_sugar_rule(
  rule: SugarRule,
  span: SourceSpan,
  children: List<SeamResolvedEdge>
) -> Outcome<NormalizedTypeForm> {
  if edges_satisfy(requirement: rule.edges, children: children) {
    match rule.replacement {
      PeelSinglePositionalChild =>
        match children |> first {
          Some { value: e0 } => normalized_type_from_seam_node(n: e0.target, span: span)
          None => Rejected { diagnostic: malformed_sugar_diagnostic(span: span) }
        }
      _ =>
        apply_sugar_connective_replacement(rule: rule, children: children)
    }
  } else {
    Rejected { diagnostic: malformed_sugar_diagnostic(span: span) }
  }
}


fn normalize_resolved_type_form(form: ResolvedTypeForm) -> Outcome<NormalizedTypeForm> {
  match form {
    ResolvedSugarForm { kind: kind, span: span, children: children } =>
      apply_sugar_rule(
        rule: c3_sugar_rule_for_kind(kind: kind),
        span: span,
        children: children
      )
    ResolvedCoreForm { connective: connective, children: children } =>
      match normalize_seam_edges(children: children) {
        Produced { value: normalized_children } =>
          Produced {
            value: NormalizedTypeForm {
              connective: connective,
              children: normalized_children
            }
          }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
  }
}


fn normalize_resolved_computation_form(
  form: ResolvedComputationForm
) -> Outcome<NormalizedComputationForm> {
  match normalize_seam_edges(children: form.children) {
    Produced { value: normalized_children } =>
      Produced {
        value: NormalizedComputationForm {
          behavior: form.behavior,
          span: form.span,
          children: normalized_children
        }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


fn normalize_seam_item(item: SeamResolvedItem) -> Outcome<SeamNormalizedItem> {
  match normalize_seam_resolved_form(form: item.form) {
    Produced { value: nform } =>
      Produced {
        value: SeamNormalizedItem {
          name: item.name,
          form: nform
        }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


fn empty_seam_normalized_items() -> Outcome<List<SeamNormalizedItem>> {
  Produced { value: Empty }
}


fn normalize_seam_items(items: List<SeamResolvedItem>) -> Outcome<List<SeamNormalizedItem>> {
  fold(items, init: empty_seam_normalized_items(), f: fn(acc, item) {
    match acc {
      Rejected { diagnostic: d } => Rejected { diagnostic: d }
      Produced { value: done } =>
        match normalize_seam_item(item: item) {
          Produced { value: ni } =>
            Produced { value: list_push(done, ni) }
          Rejected { diagnostic: d } => Rejected { diagnostic: d }
        }
    }
  })
}


fn normalize_seam_module(module: SeamResolvedModule) -> Outcome<SeamNormalizedModule> {
  match normalize_seam_items(items: module.items) {
    Produced { value: items } =>
      Produced {
        value: SeamNormalizedModule {
          name: module.name,
          items: items
        }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


fn normalize_seam_node(n: SeamResolvedNode) -> Outcome<SeamNormalizedNode> {
  match n {
    SeamResolvedModuleNode { module: m } =>
      match normalize_seam_module(module: m) {
        Produced { value: nm } =>
          Produced { value: SeamNormalizedModuleNode { module: nm } }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
    SeamResolvedItemNode { item: i } =>
      match normalize_seam_item(item: i) {
        Produced { value: ni } =>
          Produced { value: SeamNormalizedItemNode { item: ni } }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
  }
}


fn normalize_seam(resolved: SeamResolvedNode) -> Outcome<SeamNormalizedNode> {
  normalize_seam_node(n: resolved)
}


fn normalize_module_item(item: ResolvedModuleItem) -> Outcome<NormalizedItem> {
  match item {
    ResolvedSugared { sugar: _, inner: inner, span: _ } =>
      normalize_item_core(item: inner)
    ResolvedCore { item: inner } => normalize_item_core(item: inner)
  }
}


fn empty_normalized_module_items() -> Outcome<List<NormalizedItem>> {
  Produced { value: Empty }
}


fn normalize_module_items(items: List<ResolvedModuleItem>) -> Outcome<List<NormalizedItem>> {
  fold(items, init: empty_normalized_module_items(), f: fn(acc, item) {
    match acc {
      Rejected { diagnostic: d } => Rejected { diagnostic: d }
      Produced { value: done } =>
        match normalize_module_item(item: item) {
          Produced { value: ni } =>
            Produced { value: list_push(done, ni) }
          Rejected { diagnostic: d } => Rejected { diagnostic: d }
        }
    }
  })
}


fn normalize(module: ResolvedModule) -> Outcome<NormalizedModule> {
  match normalize_resolved_imports(imports: module.imports) {
    Produced { value: nimports } =>
      match normalize_module_items(items: module.items) {
        Produced { value: nitems } =>
          Produced {
            value: NormalizedModule {
              name: module.name,
              imports: nimports,
              items: nitems,
              span: module.span
            }
          }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}
