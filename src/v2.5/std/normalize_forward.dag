fn normalize_item_core(item: ResolvedItemCore) -> Outcome<NormalizedItem> {
  match item {
    ResolvedOtherItem { keyword: keyword, raw_span: raw_span } =>
      Produced {
        value: NormalizedOtherItem {
          keyword: keyword,
          raw_span: raw_span
        }
      }
    ResolvedFn {
      name: name,
      type_params: type_params,
      params: params,
      return_type: return_type,
      uses: uses,
      body: body,
      span: span
    } =>
      match normalize_resolved_params(params: type_params) {
        Produced { value: ntype_params } =>
          match normalize_resolved_params(params: params) {
            Produced { value: nparams } =>
              match normalize_resolved_type_expr_opt(expr: return_type) {
                Produced { value: nreturn } =>
                  match normalize_resolved_resource_uses(uses: uses) {
                    Produced { value: nuses } =>
                      match normalize_resolved_block(block: body) {
                        Produced { value: nbody } =>
                          Produced {
                            value: NormalizedFn {
                              name: name,
                              type_params: ntype_params,
                              params: nparams,
                              return_type: nreturn,
                              uses: nuses,
                              body: nbody,
                              span: span
                            }
                          }
                        Rejected { diagnostic: d } => Rejected { diagnostic: d }
                      }
                    Rejected { diagnostic: d } => Rejected { diagnostic: d }
                  }
                Rejected { diagnostic: d } => Rejected { diagnostic: d }
              }
            Rejected { diagnostic: d } => Rejected { diagnostic: d }
          }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
    ResolvedFunc {
      name: name,
      type_params: type_params,
      params: params,
      return_type: return_type,
      uses: uses,
      body: body,
      span: span
    } =>
      match normalize_resolved_params(params: type_params) {
        Produced { value: ntype_params } =>
          match normalize_resolved_params(params: params) {
            Produced { value: nparams } =>
              match normalize_resolved_type_expr_opt(expr: return_type) {
                Produced { value: nreturn } =>
                  match normalize_resolved_resource_uses(uses: uses) {
                    Produced { value: nuses } =>
                      match normalize_resolved_block(block: body) {
                        Produced { value: nbody } =>
                          Produced {
                            value: NormalizedFunc {
                              name: name,
                              type_params: ntype_params,
                              params: nparams,
                              return_type: nreturn,
                              uses: nuses,
                              body: nbody,
                              span: span
                            }
                          }
                        Rejected { diagnostic: d } => Rejected { diagnostic: d }
                      }
                    Rejected { diagnostic: d } => Rejected { diagnostic: d }
                  }
                Rejected { diagnostic: d } => Rejected { diagnostic: d }
              }
            Rejected { diagnostic: d } => Rejected { diagnostic: d }
          }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
    ResolvedTypeDecl {
      name: name,
      type_params: type_params,
      definition: definition,
      span: span
    } =>
      match normalize_resolved_params(params: type_params) {
        Produced { value: ntype_params } =>
          match normalize_resolved_type_expr(expr: definition) {
            Produced { value: ndefinition } =>
              Produced {
                value: NormalizedTypeDecl {
                  name: name,
                  type_params: ntype_params,
                  definition: ndefinition,
                  span: span
                }
              }
            Rejected { diagnostic: d } => Rejected { diagnostic: d }
          }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
    ResolvedDataDecl {
      name: name,
      type_annotation: type_annotation,
      value: value,
      span: span
    } =>
      match normalize_resolved_type_expr(expr: type_annotation) {
        Produced { value: nannotation } =>
          match normalize_resolved_expr(expr: value) {
            Produced { value: nvalue } =>
              Produced {
                value: NormalizedDataDecl {
                  name: name,
                  type_annotation: nannotation,
                  value: nvalue,
                  span: span
                }
              }
            Rejected { diagnostic: d } => Rejected { diagnostic: d }
          }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
    ResolvedService {
      name: name,
      transport: transport,
      operations: operations,
      span: span
    } =>
      match normalize_resolved_transport(transport: transport) {
        Produced { value: ntransport } =>
          match normalize_resolved_operations(operations: operations) {
            Produced { value: noperations } =>
              Produced {
                value: NormalizedService {
                  name: name,
                  transport: ntransport,
                  operations: noperations,
                  span: span
                }
              }
            Rejected { diagnostic: d } => Rejected { diagnostic: d }
          }
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
      }
  }
}
