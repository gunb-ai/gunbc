fn normalize_resolved_import(imp: ResolvedImport) -> Outcome<NormalizedImport> {
  match imp {
    ResolvedImportAll { module_path: module_path, span: span } =>
      Produced {
        value: NormalizedImportAll {
          module_path: module_path,
          span: span
        }
      }
    ResolvedImportNames {
      module_path: module_path,
      names: names,
      span: span
    } =>
      Produced {
        value: NormalizedImportNames {
          module_path: module_path,
          names: names,
          span: span
        }
      }
  }
}


