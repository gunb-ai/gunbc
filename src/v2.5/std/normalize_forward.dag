// src/v2.5/std/normalize_forward.dag
// Scope: structural Resolved* -> Normalized* projection (facts flow forward).
// Owns: normalize_item_core and supporting normalize_resolved_* helpers.
// Consumes: v2_5.std.stage_types, v2_5.std.diagnostic.

module v2_5.std.normalize_forward


import v2_5.std.diagnostic { Outcome }
import v2_5.std.stage_types {
  NormalizedArg,
  NormalizedBlock,
  NormalizedDataDecl,
  NormalizedExpr,
  NormalizedFieldBinding,
  NormalizedFieldInit,
  NormalizedFn,
  NormalizedFunc,
  NormalizedImport,
  NormalizedImportAll,
  NormalizedImportNames,
  NormalizedItem,
  NormalizedMatchArm,
  NormalizedOperation,
  NormalizedOtherItem,
  NormalizedParam,
  NormalizedPattern,
  NormalizedResourceUse,
  NormalizedService,
  NormalizedStringPart,
  NormalizedTypeDecl,
  NormalizedTypeExpr,
  NormalizedTypeField,
  NormalizedTypeVariant,
  NormalizedTransport,
  NormalizedTransportFile,
  NormalizedTransportLocal,
  NormalizedTransportProperty,
  NormalizedTransportRest,
  NormalizedTransportShell,
  ResolvedArg,
  ResolvedBlock,
  ResolvedDataDecl,
  ResolvedExpr,
  ResolvedFieldBinding,
  ResolvedFieldInit,
  ResolvedFn,
  ResolvedFunc,
  ResolvedImport,
  ResolvedImportAll,
  ResolvedImportNames,
  ResolvedItemCore,
  ResolvedMatchArm,
  ResolvedOperation,
  ResolvedOtherItem,
  ResolvedParam,
  ResolvedPattern,
  ResolvedResourceUse,
  ResolvedService,
  ResolvedStringPart,
  ResolvedTypeDecl,
  ResolvedTypeExpr,
  ResolvedTypeField,
  ResolvedTypeVariant,
  ResolvedTransport,
  ResolvedTransportFile,
  ResolvedTransportLocal,
  ResolvedTransportProperty,
  ResolvedTransportRest,
  ResolvedTransportShell,
  ResolvedTypeAtom,
  ResolvedTypeArrow,
  ResolvedTypeConj,
  ResolvedTypeDisj,
  ResolvedTypeError,
  NormalizedTypeAtom,
  NormalizedTypeArrow,
  NormalizedTypeConj,
  NormalizedTypeDisj,
  NormalizedTypeError,
  ResolvedPatBind,
  ResolvedPatLit,
  ResolvedPatVariant,
  ResolvedPatWildcard,
  NormalizedPatBind,
  NormalizedPatLit,
  NormalizedPatVariant,
  NormalizedPatWildcard,
  ResolvedLit,
  ResolvedError,
  ResolvedVar,
  ResolvedFieldAccess,
  ResolvedCall,
  ResolvedMethodCall,
  ResolvedMatch,
  ResolvedIf,
  ResolvedLet,
  ResolvedRecordLit,
  ResolvedListLit,
  ResolvedBinOp,
