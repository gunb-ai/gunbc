// src/v2.5/std/verification.dag
// Scope: closed TestClaim schema for v2.5 fork-local verification rows.
// Owns: CompilerStage, TestSource, AssertKind, TestgenTier, TestgenLayer,
// TestClassification, ImpossibleBugClass, T19ManualAnchorKey, TestClaim,
// TestSuite.
// Consumes: v2_5.std.node, v2_5.std.diagnostic.
// Status: v2.5 Tier 0 supporting substrate.

module v2_5.std.verification

import v2_5.std.node { Symbol }
import v2_5.std.diagnostic { Diagnostic }

// 🟢 coproduct dissolution
type CompilerStage
  = Tokenize
  | Parse
  | Resolve
  | Normalize
  | Infer
  | Emit
  | Compile

// 🟢 coproduct dissolution
type TestSource<T>
  = SourceText { file: Symbol, text: String }
  | ModeledInput { input: T }

// 🟢 coproduct dissolution
type AssertKind<T>
  = Equals { expected: T }
  | DiagnosticAssert { expected: Diagnostic }
  | Compiles
  | RoundTrips { expected: T }

// 🟢 coproduct dissolution
type TestgenTier
  = Tier1
  | Tier2
  | Tier3

// 🟢 coproduct dissolution
type TestgenLayer
  = Unit
  | Integration
  | Boundary

type TestClassification {
  tier: TestgenTier
  layer: TestgenLayer
}

// 🟢 coproduct dissolution
type ImpossibleBugClass
  = SuboptimalComplexity
  | IdempotencyContract
  | TransportTypeDrift
  | NestedOptionalFlatten
  | UnenumeratedEffects
  | UnhandledDiagnosticPaths

// 🟡 coproduct dissolution — consumer:t19-generated-corpus-anchors
type T19ManualAnchorKey
  = T19ManualTcConjEmpty
  | T19ManualTcDisjEmpty
  | T19ManualTcArrowTwoConj
  | T19ManualTcCardinalityEmpty
  | T19ManualTcInstantiationEmpty
  | T19ManualTcConjEqualsRefl
  | T19ManualNatAddLeftIdentity
  | T19ManualNatAddRightIdentity
  | T19ManualNatAddAssociativity
  | T19ManualNatMulLeftIdentity
  | T19ManualNatMulAnnihilator
  | T19ManualNatMulAssociativity
  | T19ManualAnchorAbsent

type TestClaim<Input, Output> {
  name: String
  stage: CompilerStage
  source: TestSource<Input>
  predicate: AssertKind<Output>
  t19_anchor: T19ManualAnchorKey
  classification: TestClassification
}

type TestSuite<Input, Output> {
  name: String
  claims: List<TestClaim<Input, Output>>
}

data verification_schema_smoke_file: Symbol = verification_schema_smoke_file

data verification_schema_smoke: TestClaim<String, String> = TestClaim {
  name: "verification_schema_smoke",
  stage: Compile,
  source: SourceText { file: verification_schema_smoke_file, text: "module smoke" },
  predicate: Equals { expected: "module smoke" },
  t19_anchor: T19ManualAnchorAbsent,
  classification: TestClassification { tier: Tier1, layer: Unit }
}
