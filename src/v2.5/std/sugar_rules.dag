// src/v2.5/std/sugar_rules.dag
// Scope: C3 surface-sugar rewrite rules as first-class data (sugar-as-data).
// Owns: SugarRule, SugarReplacement, c3_sugar_rules.
// Consumes: v2_5.std.stage_types.
// Status: fork — authority for the closed N=4 gunbc .dag sugar forms (src/v4/TASKS.md T-8).

module v2_5.std.sugar_rules


import v2_5.std.stage_types { SurfaceSugarKind, ServiceSugar, FnSugar, TypeSugar, OperationSugar }


type SugarEdgeRequirement
  = RequireAllNamed
  | RequireAllPositional
  | RequireExactlyOnePositional


type SugarReplacement
  = ReplaceWithConj
  | ReplaceWithArrow
  | PeelSinglePositionalChild


type SugarRule {
  sugar: SurfaceSugarKind
  edges: SugarEdgeRequirement
  replacement: SugarReplacement
}


fn c3_sugar_rules() -> List<SugarRule> {
  [
    SugarRule {
      sugar: ServiceSugar
      edges: RequireAllNamed
      replacement: ReplaceWithConj
    },
    SugarRule {
      sugar: FnSugar
      edges: RequireAllPositional
      replacement: ReplaceWithArrow
    },
    SugarRule {
      sugar: TypeSugar
      edges: RequireExactlyOnePositional
      replacement: PeelSinglePositionalChild
    },
    SugarRule {
      sugar: OperationSugar
      edges: RequireAllPositional
      replacement: ReplaceWithArrow
    }
  ]
}
