// v2.5 identity and provenance — shared across all pipeline phases.
// Parse phases use AuthoredName; post-resolve phases use Symbol (from node).
// SourceSpan authority: std.types (FilePath refinement, M2 single-authority).

module v2_5.std.identity

import std.types { SourceSpan, FilePath }
import v2_5.std.node { Symbol }

type AuthoredName {
  text: String
  span: SourceSpan
}

type BoundName {
  symbol: Symbol
  span: SourceSpan
}
