module v2_5.std.syntax

// 🟢 coproduct dissolution — shape-ref: std.syntax BinOp
type BinOp
  = Add | Sub | Mul | Div | Mod
  | Eq | Ne | Lt | Gt | Le | Ge
  | And | Or | NullCoalesce

// 🟢 coproduct dissolution — shape-ref: std.syntax LiteralValue
type LiteralValue
  = LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | LitBool { value: Bool }
  | LitNull

// 🟢 coproduct dissolution — shape-ref: std.syntax AlgebraFieldKind
type AlgebraFieldKind
  = AlgAdd | AlgMul | AlgReciprocal | AlgQuotient | AlgRemainder | AlgCompare | AlgMeet | AlgJoin

// 🟢 coproduct dissolution — v2 surface (not yet in dsl/std/syntax.dag)
type UnaryOpKind
  = Not | Neg

// 🟢 coproduct dissolution
type OperationModifier
  = Idempotent | Readonly | Hermetic

// 🟢 coproduct dissolution
type ExprErrorKind
  = ParseRecoveryError | SemanticExprError | InternalExprError
