// v2.5 syntax carriers — closed sums for operators and literals.
// Authority for expression/type surface metadata used by stage_types.
// Does not import v2, v3, v4, or dsl.

module v2_5.std.syntax

// 🟢 coproduct dissolution — operator closed sum (terminal at syntax boundary)
type BinOp
  = Add | Sub | Mul | Div | Mod
  | Eq | Ne | Lt | Gt | Le | Ge
  | And | Or | NullCoalesce

// 🟢 coproduct dissolution
type UnaryOpKind
  = Not | Neg

// 🟢 coproduct dissolution
type LiteralValue
  = LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | LitBool { value: Bool }
  | LitNull

// 🟢 coproduct dissolution
type OperationModifier
  = Idempotent | Readonly | Hermetic

// 🟢 coproduct dissolution
type ExprErrorKind
  = ParseRecoveryError | SemanticExprError | InternalExprError

// 🟢 coproduct dissolution
type AlgebraFieldKind
  = AlgAdd | AlgMul | AlgReciprocal | AlgQuotient | AlgRemainder | AlgCompare | AlgMeet | AlgJoin
