// src/v2.5/artifact.dag
// Scope: typed artifact-plan — what the pipeline builds, for which target LanguageSpec, into which output location.
// Owns: ArtifactPath, Artifact, ArtifactPlan, single_module_plan.
// Consumes: v2_5.std.language_spec { LanguageSpec }.
// Status: scaffold; dissolves when keen-ibex-355's compile.dag consumes ArtifactPlan.

module v2_5.compiler.artifact

import v2_5.std.language_spec { LanguageSpec }


type ArtifactPath {
  output_dir: String
  file_stem: String
}


type Artifact {
  name: String
  target: LanguageSpec
  entry_modules: List<String>
  output: ArtifactPath
}


type ArtifactPlan {
  artifacts: List<Artifact>
}


fn single_module_plan(
  root_module: String,
  target: LanguageSpec,
  output: ArtifactPath
) -> ArtifactPlan {
  ArtifactPlan {
    artifacts: [Artifact {
      name: root_module,
      target: target,
      entry_modules: [root_module],
      output: output
    }]
  }
}
