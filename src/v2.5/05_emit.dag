// src/v2.5/05_emit.dag
// Scope: Stage 5 of the v2.5 fork — InferredModule × LanguageSpec -> Outcome<TargetSource>.
//        Emission is a fold over closed InferredItem / InferredExpr variants; per-target
//        syntax is data (read from LanguageSpec, owned by src/v2.5/std/language_spec.dag).
// Owns:  TargetFile; TargetSource; emit_stage_locus_port + reason symbols + diagnostic helpers;
//        emit (entry); emit_root; emit_module; render_item dispatch; render_expr + expr_fold_algebra;
//        emit_ident + apply_naming_case + apply_reserved_escape + render_binop_symbol + binop_eq;
//        collect_outcomes; render_* per-variant signatures.
// Consumes: v2_5.std.language_spec (LanguageSpec carrier + all sub-carriers — this file
//             does not redefine them; multi-consumer std/ home).
//           v2_5.std.node (Node, Symbol, NodeFold, fold_node) — Tier 0 (cool-bee-832).
//           v2_5.std.diagnostic (Outcome, Diagnostic, Locus, PortLocus, Produced, Rejected,
//             Unavailable, ExternalContractUnknown) — Tier 0 mirror of v4.
//           v2_5.std.stage_types (InferredNode and its closed-sum variants) — Tier 1
//             (vivid-lynx-807).
// Status: DESIGN SCAFFOLD. Tier 0/1 substrates not yet authored; the import paths above
//         name the expected modules. The framework + LanguageSpec projection + fold
//         algebra + per-target instance pattern (src/v2.5/languages/rust.dag) are the
//         substantive content. When Tier 1 publishes the authoritative InferredNode
//         variant set, the fold step wires to it directly without restructuring.
// Anchor: docs/design-emission-model.md — emission is a structural projection from a typed
//         tree + per-target spec to target source; no decision engine, all real work lives
//         in the substrate facts the spec carries.
// Calibration trigger: PR #3402 "Deferred findings" §1 — per-target file split is the
//         dominant coproduct defect across v2's emit_go / emit_python mirror pair. This
//         file is the fork's resolution: ONE emit function, per-target syntax as data.


module v2_5.compiler.emit


import v2_5.std.language_spec {
  LanguageSpec,
  IdentifierRules,
  NamingCase,
  SnakeCase,
  PascalCase,
  CamelCase,
  AsAuthored,
  ReservedEscape,
  PrefixEscape,
  SuffixEscape,
  NoEscape,
  BlockSyntax,
  BracedBlock,
  IndentedBlock,
  IfForm,
  IfExpression,
  ConditionalTernary,
  IfStatement,
  InterpStyle,
  BinOpRule,
  ConjunctionTypeForm
}
import v2_5.std.syntax {
  BinOp,
  Add, Sub, Mul, Div, Mod,
  Eq, Ne, Lt, Gt, Le, Ge,
  And, Or, NullCoalesce,
  LiteralValue, UnaryOpKind
}
import v2_5.std.identity { BoundName, AuthoredName, SourceSpan }
import v2_5.std.node { Node, Edge, Symbol, NodeFold, fold_node, Path, PathStep, NamedStep }
import v2_5.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  Outcome,
  PortLocus,
  Produced,
  Rejected,
  Unavailable
}
// Tier 1 — variant names from vivid-lynx-807 PR #3418 (reconciled dfb926f8c).
// Canonical pipeline contract: `emit : InferredModule -> TargetSource`. emit
// consumes InferredModule directly, not a generic InferredNode root carrier.
import v2_5.std.stage_types {
  InferredModule,
  InferredItem,
  InferredFn,
  InferredFunc,
  InferredTypeDecl,
  InferredDataDecl,
  InferredService,
  InferredOtherItem,
  InferredExpr,
  InferredLit,
  InferredVar,
  InferredFieldAccess,
  InferredCall,
  InferredMethodCall,
  InferredLambda,
  InferredLet,
  InferredIf,
  InferredMatch,
  InferredBlock,
  InferredRecordLit,
  InferredListLit,
  InferredStringInterp,
  InferredBinOp,
  InferredUnaryOp,
  InferredCast,
  InferredForEach,
  InferredIndex,
  InferredSlice,
  InferredReturn,
  InferredError,
  InferredType,
  InferredPattern,
  InferredMatchArm,
  InferredFieldInit,
  InferredArg,
  InferredImport,
  InferredOperation,
  InferredResourceUse,
  InferredTransport,
  InferredParam
}


// =============================================================================
// Diagnostic symbols + locus port — fail-closed boundaries
// =============================================================================

data emit_stage_locus_port: Symbol = emit_stage_locus_port

data emit_no_inhabitant: Symbol = emit_no_inhabitant
data emit_under_refined: Symbol = emit_under_refined
data emit_unsupported_coercion: Symbol = emit_unsupported_coercion
data emit_missing_language_rule: Symbol = emit_missing_language_rule


fn emit_locus() -> Locus {
  // PortLocus carries a Path (PR #3422 substrate reshape 2026-05-19); the
  // emit stage's port is the single-segment path naming its locus port.
  PortLocus {
    path: Path { steps: [NamedStep { name: emit_stage_locus_port }] }
  }
}


fn emit_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: emit_locus(),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// =============================================================================
// TargetSource — typed output carrier
// =============================================================================
//
// v2 returned `EmitResult { files: List<TextFile>, diagnostics: List<ErrorNode> }`
// — mixing success + failure in one record. v2.5 follows v4's pattern:
// `Outcome<TargetSource>` with the success/failure axis closed at the top.

type TargetFile {
  path: String
  content: String
}

type TargetSource {
  files: List<TargetFile>
  spec_id: Symbol
}


// =============================================================================
// emit — the entry point
// =============================================================================
//
// Per Tier 1's pipeline contract (v2_5.std.stage_types):
//   `emit : InferredModule -> TargetSource`
// emit consumes a fully-inferred module directly — there is no generic
// InferredNode top-level coproduct to dispatch on. Module IS the root carrier.
// This is the phase-typed boundary: emit's signature asserts post-inference.

fn emit(module: InferredModule, spec: LanguageSpec) -> Outcome<TargetSource> {
  match emit_module(module: module, spec: spec) {
    Produced { value: files } =>
      Produced {
        value: TargetSource {
          files: files,
          spec_id: spec.identity.language_id
        }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


// =============================================================================
// emit_module — module → file
// =============================================================================

fn emit_module(module: InferredModule, spec: LanguageSpec) -> Outcome<List<TargetFile>> {
  let import_block = render_imports(used_imports: module.imports, spec: spec)
  let item_outcomes = module.items |> map(i => render_item(item: i, spec: spec))
  match collect_outcomes(items: item_outcomes) {
    Produced { value: item_texts } => {
      let body = item_texts |> join(separator: spec.items.item_separator)
      let content = concat(import_block, body)
      let file_path = render_module_path(name: module.name, spec: spec)
      Produced { value: [TargetFile { path: file_path, content: content }] }
    }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


// =============================================================================
// render_item — closed dispatch over InferredItem variants
// =============================================================================
//
// One match per InferredItem variant; each arm is a small render function that
// reads LanguageSpec and produces a String. The arms are NOT template-holes —
// each variant has structurally distinct rendering needs (data layout differs
// from fn body differs from service definition). They are honestly per-variant.

fn render_item(item: InferredItem, spec: LanguageSpec) -> Outcome<String> {
  match item {
    InferredFn { name: name, type_params: _, params: params, return_type: ret, uses: _, body: body, recursion: _, span: _ } =>
      render_fn(name: name, params: params, return_type: ret, body: body, spec: spec)
    InferredFunc { name: name, type_params: _, params: params, return_type: ret, uses: uses, body: body, recursion: _, span: _ } =>
      render_func(name: name, params: params, return_type: ret, uses: uses, body: body, spec: spec)
    InferredTypeDecl { name: name, type_params: _, definition: definition, span: _ } =>
      render_type_decl(name: name, definition: definition, spec: spec)
    InferredDataDecl { name: name, type_annotation: ty, value: value, span: _ } =>
      render_data_decl(name: name, type_annotation: ty, value: value, spec: spec)
    InferredService { name: name, transport: transport, operations: operations, span: _ } =>
      render_service(name: name, transport: transport, operations: operations, spec: spec)
    InferredOtherItem { keyword: _, raw_span: _ } =>
      // Unrecognized item kind reached emit — surface as fail-closed; the
      // pipeline should have rejected upstream rather than passing through.
      Rejected { diagnostic: emit_diagnostic(reason: emit_under_refined) }
  }
}


// =============================================================================
// render_expr — closed dispatch over InferredExpr via fold_node, Outcome-typed
// =============================================================================
//
// This is where Practice 10 most directly applies. v2's emit_typed_expr was a
// 22-arm hand-rolled walker that re-traversed children at every arm. v2.5: ONE
// fold_node call whose algebra (NodeFold<Outcome<String>>) describes per-variant
// rendering. The recursion is in the substrate (PR #3404 / PR #3422 fold_node);
// the fold result is Outcome-threaded so per-arm failure (an absent
// LanguageSpec rule, an unrecognized variant, etc.) propagates fail-closed to
// the stage boundary instead of degenerating into an empty-string sentinel.
// This is the discipline boundary cursor + codex flagged on the first draft:
// the module signature is Outcome<TargetSource>, so the fold algebra must
// carry diagnostics too, not strip them at the per-arm level.

fn render_expr(expr: InferredExpr, spec: LanguageSpec) -> Outcome<String> {
  fold_node(
    n: inferred_expr_to_node(e: expr),
    algebra: expr_fold_algebra(spec: spec)
  )
}


fn expr_fold_algebra(spec: LanguageSpec) -> NodeFold<Outcome<String>> {
  NodeFold {
    init: fn(n) {
      render_expr_init(node: n, spec: spec)
    },
    step: fn(acc, edge, child_outcome) {
      render_expr_step(parent: acc, edge: edge, child: child_outcome, spec: spec)
    }
  }
}


// Per-variant init: handles leaves and stamps the parent variant's identity
// so step can compose. The dispatch on InferredExpr's variant is once, here,
// not at every recursive call as v2 did.
fn render_expr_init(node: Node, spec: LanguageSpec) -> Outcome<String> {
  render_expr_dispatch(node: node, spec: spec)
}


// Dispatch on InferredExpr variant — exhaustive over the closed sum that Tier
// 1 publishes. Every arm reads LanguageSpec for its syntactic fragments and
// returns Outcome<String>; an unrecognized variant fails closed instead of
// degenerating into an empty string.
fn render_expr_dispatch(node: Node, spec: LanguageSpec) -> Outcome<String> {
  match inferred_expr_variant_of(n: node) {
    InferredLit { value: v, span: _, expr_type: _ } =>
      Produced { value: render_literal(value: v, spec: spec) }
    InferredVar { name: name, expr_type: _ } =>
      Produced { value: emit_ident(name: name, rules: spec.identifiers) }
    InferredFieldAccess { receiver: _, field: field, expr_type: _ } =>
      Produced {
        value: concat(spec.expressions.field_access_separator, emit_ident(name: field, rules: spec.identifiers))
      }
    InferredCall { callee: _, args: _, expr_type: _ } =>
      Produced { value: spec.expressions.call_open }
    InferredMethodCall { receiver: _, method: _, args: _, expr_type: _ } =>
      Produced { value: spec.expressions.method_call_separator }
    InferredBinOp { op: op, left: _, right: _, algebra_field: _, expr_type: _ } =>
      // diagnostic-bearing lookup: a BinOp with no rule in spec.expressions.binops
      // surfaces emit_missing_language_rule rather than a "" fallback.
      render_binop_symbol(op: op, spec: spec)
    InferredUnaryOp { op: _, operand: _, expr_type: _ } =>
      Produced { value: spec.expressions.unary_neg }
    InferredIf { condition: _, then_expr: _, else_expr: _, expr_type: _ } =>
      Produced { value: render_if_form(form: spec.expressions.if_form) }
    InferredMatch { scrutinee: _, arms: _, expr_type: _ } =>
      Produced { value: spec.patterns.match_keyword }
    InferredLet { name: name, value: _, body: _, expr_type: _ } =>
      Produced { value: concat("let ", emit_ident(name: name, rules: spec.identifiers)) }
    InferredLambda { params: _, body: _, expr_type: _ } =>
      Produced { value: render_lambda_prefix(spec: spec) }
    InferredBlock { statements: _, expr_type: _ } =>
      Produced { value: render_block_open(block: spec.items.block) }
    InferredStringInterp { parts: _, expr_type: _ } =>
      Produced { value: render_string_interp_prefix(style: spec.strings.interp_style) }
    InferredRecordLit { type_name: _, fields: _, expr_type: _ } =>
      Produced { value: render_record_open(form: spec.types.conjunction_type) }
    InferredListLit { elements: _, expr_type: _ } =>
      Produced { value: spec.types.container_type.list_open }
    InferredCast { expr: _, target_type: _, expr_type: _ } =>
      Produced { value: render_cast_prefix(spec: spec) }
    InferredForEach { variable: _, iterable: _, body: _, expr_type: _ } =>
      Produced { value: render_foreach_prefix(spec: spec) }
    InferredIndex { base: _, index: _, expr_type: _ } =>
      Produced { value: spec.types.container_type.list_open }
    InferredSlice { base: _, start: _, end: _, expr_type: _ } =>
      Produced { value: spec.types.container_type.list_open }
    InferredReturn { value: _, expr_type: _ } =>
      Produced { value: render_return_prefix(spec: spec) }
    InferredError { kind: _, message: _, span: _ } =>
      // Upstream-stage error reached emit — fail-closed.
      Rejected { diagnostic: emit_diagnostic(reason: emit_under_refined) }
  }
}


// Per-variant step: combines parent's running text with a child render, both
// Outcome-typed. The edge label tells step which structural role the child
// plays (v4 demonstrates the named/positional edge axis; v2.5 follows it).
// Fail-closed: either side Rejected propagates the diagnostic; both Produced
// concatenates the strings.
fn render_expr_step(
  parent: Outcome<String>,
  edge: Edge,
  child: Outcome<String>,
  spec: LanguageSpec
) -> Outcome<String> {
  match parent {
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
    Produced { value: p } =>
      match child {
        Rejected { diagnostic: d } => Rejected { diagnostic: d }
        Produced { value: c } => Produced { value: concat(p, c) }
      }
  }
}


// =============================================================================
// Leaf renderers — small, data-driven, mechanically derivable
// =============================================================================
//
// emit_ident is the canonical example: ONE function, no per-target dispatch
// (PR #3402's apply_reserved_escape principle generalized + grounded in a
// closed NamingCase / ReservedEscape sum).

// Identifiers at emit see post-resolve BoundName (per Tier 1's stage_types:
// "Parse phases use AuthoredName; post-resolve phases use Symbol"). BoundName
// = { symbol: Symbol, span: SourceSpan }; we render from the symbol field.
fn emit_ident(name: BoundName, rules: IdentifierRules) -> String {
  let converted = apply_naming_case(symbol: name.symbol, case: rules.default_case)
  let is_reserved = rules.reserved_words |> any(r => r == name.symbol)
  if is_reserved {
    apply_reserved_escape(name: converted, escape: rules.reserved_escape)
  } else {
    converted
  }
}


fn apply_naming_case(symbol: Symbol, case: NamingCase) -> String {
  match case {
    SnakeCase => to_snake(name: symbol_to_string(s: symbol))
    PascalCase => to_pascal(name: symbol_to_string(s: symbol))
    CamelCase => to_camel(name: symbol_to_string(s: symbol))
    AsAuthored => symbol_to_string(s: symbol)
  }
}


fn apply_reserved_escape(name: String, escape: ReservedEscape) -> String {
  match escape {
    PrefixEscape { prefix: p } => concat(p, name)
    SuffixEscape { suffix: s } => concat(name, s)
    NoEscape => name
  }
}


// Binary-operator symbol — typed dispatch over List<BinOpRule>, diagnostic-
// bearing. v2 had `binop_symbol(op: BinOp, target: RenderTarget)` doing
// string-keyed per-target lookups with no failure surface. In v2.5 the lookup
// is typed AND fail-closed: a BinOp absent from spec.expressions.binops
// surfaces an emit_missing_language_rule diagnostic instead of returning "".
//
// 🟡 The List<BinOpRule> shape lacks structural totality and uniqueness over
// the closed BinOp domain. A Map<BinOp, BinOpRule> would prove uniqueness by
// construction; v2.5 substrate (PR #3422) does not yet expose a Map carrier
// (only node/diagnostic). Until a substrate Map lands, the diagnostic-bearing
// lookup is the boundary that catches gaps. Dissolves on v2_5.std.collection.Map.
fn render_binop_symbol(op: BinOp, spec: LanguageSpec) -> Outcome<String> {
  match spec.expressions.binops |> filter(r => binop_eq(a: r.op, b: op)) |> first {
    Some { value: rule } => Produced { value: rule.symbol }
    None => Rejected { diagnostic: emit_diagnostic(reason: emit_missing_language_rule) }
  }
}


// 🟡 Practice 10: hand-rolled 14-way equality dissolves when the substrate
// publishes derived equality over enum sums (sibling of v2_5.std.collection.Map
// for BinOp keys). Until then this is the explicit-and-honest lookup pred.
// Arms match canonical v2_5.std.syntax.BinOp exactly (Ne/Le/Ge; no StringConcat).
fn binop_eq(a: BinOp, b: BinOp) -> Bool {
  match a {
    Add => match b { Add => true _ => false }
    Sub => match b { Sub => true _ => false }
    Mul => match b { Mul => true _ => false }
    Div => match b { Div => true _ => false }
    Mod => match b { Mod => true _ => false }
    Eq => match b { Eq => true _ => false }
    Ne => match b { Ne => true _ => false }
    Lt => match b { Lt => true _ => false }
    Le => match b { Le => true _ => false }
    Gt => match b { Gt => true _ => false }
    Ge => match b { Ge => true _ => false }
    And => match b { And => true _ => false }
    Or => match b { Or => true _ => false }
    NullCoalesce => match b { NullCoalesce => true _ => false }
  }
}


// =============================================================================
// Per-variant render skeletons — signatures
// =============================================================================
//
// These are the framework's public contract; the bodies follow the same shape
// — fold over their structural sub-children using LanguageSpec to fill
// syntactic fragments. They are sketched as signatures here so per-target data
// files (src/v2.5/languages/<target>.dag) can verify the LanguageSpec they
// instantiate is shaped correctly. Bodies follow once Tier 1's InferredNode
// variant set is published; the variant arms each become a small data-driven
// renderer reading from LanguageSpec, no per-target match arms.

// Signatures match Tier 1 (PR #3418) variant field shapes: name carrier is
// BoundName, body is InferredBlock, item-level types carry their own
// `definition` / `type_annotation` / `value` fields. Rebased against
// stage_types.dag dfb926f8c.
fn render_fn(name: BoundName, params: List<InferredParam>, return_type: InferredType, body: InferredBlock, spec: LanguageSpec) -> Outcome<String>
fn render_func(name: BoundName, params: List<InferredParam>, return_type: InferredType, uses: List<InferredResourceUse>, body: InferredBlock, spec: LanguageSpec) -> Outcome<String>
fn render_type_decl(name: BoundName, definition: InferredType, spec: LanguageSpec) -> Outcome<String>
fn render_data_decl(name: BoundName, type_annotation: InferredType, value: InferredExpr, spec: LanguageSpec) -> Outcome<String>
fn render_service(name: BoundName, transport: InferredTransport, operations: List<InferredOperation>, spec: LanguageSpec) -> Outcome<String>

fn render_literal(value: LiteralValue, spec: LanguageSpec) -> String
fn render_imports(used_imports: List<InferredImport>, spec: LanguageSpec) -> String
fn render_module_path(name: BoundName, spec: LanguageSpec) -> String
fn render_if_form(form: IfForm) -> String
fn render_lambda_prefix(spec: LanguageSpec) -> String
fn render_block_open(block: BlockSyntax) -> String
fn render_string_interp_prefix(style: InterpStyle) -> String
fn render_record_open(form: ConjunctionTypeForm) -> String
fn render_cast_prefix(spec: LanguageSpec) -> String
fn render_foreach_prefix(spec: LanguageSpec) -> String
fn render_return_prefix(spec: LanguageSpec) -> String


// =============================================================================
// Outcome-list collection helper — fail-closed propagation
// =============================================================================

fn collect_outcomes(items: List<Outcome<String>>) -> Outcome<List<String>> {
  items |> fold(init: Produced { value: [] }, f: fn(acc, item) {
    match acc {
      Rejected { diagnostic: d } => Rejected { diagnostic: d }
      Produced { value: vs } =>
        match item {
          Produced { value: v } => Produced { value: concat(vs, [v]) }
          Rejected { diagnostic: d } => Rejected { diagnostic: d }
        }
    }
  })
}


// =============================================================================
// Bridges to substrate / Tier 1 shape — declared here, owned there
// =============================================================================

extern fn inferred_expr_to_node(e: InferredExpr) -> Node
extern fn inferred_expr_variant_of(n: Node) -> InferredExpr
extern fn symbol_to_string(s: Symbol) -> String
extern fn to_snake(name: String) -> String
extern fn to_pascal(name: String) -> String
extern fn to_camel(name: String) -> String


// =============================================================================
// Receipts — v2 patterns that dissolve under this framework
// =============================================================================
//
//   v2 pattern                                          | v2.5 resolution
//   ----------------------------------------------------|--------------------------------
//   `match target { Rust => x | Python => y | Go => z}` | LanguageSpec field read
//   `emit_rust_X` + `emit_go_X` + `emit_py_X` triples   | one `render_X(node, spec)`
//   `render_node_type` 180-line hand-rolled catamorphism | fold_node + TypeRenderRules
//   `emit_typed_expr` 22-arm walker, recursive at arms  | fold_node + expr_fold_algebra
//   `emit_rust_tco_*` family duplicating `emit_rust_*`  | one render path; tail-pos data
//   per-target `escape_X_interp_text`                   | apply_escape_pairs + EscapePair list
//   `reserved_prefix` + `reserved_suffix` (dead)        | typed ReservedEscape coproduct
//   string-tagged "target" string parameter             | typed Symbol via LanguageIdentity
//   `EmitResult { files, diagnostics }` (mixed shape)   | Outcome<TargetSource> closed sum
//   per-target inline `if op_name == "fold" ...` chains | List<BinOpRule> typed lookup
//   coercion match cascades (v2/coercion.dag)           | List<CoercionRule> typed data
//   `RenderTarget = Rust | Python | Go | Dag` tag       | Symbol via LanguageIdentity + spec
