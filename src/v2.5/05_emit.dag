// src/v2.5/05_emit.dag
// Scope: Stage 5 of the v2.5 fork — InferredModule × LanguageSpec -> Outcome<TargetSource>.
//        Emission is a fold over closed InferredItem / InferredExpr variants; per-target
//        syntax is data (read from LanguageSpec, owned by src/v2.5/std/language_spec.dag).
// Owns:  TargetFile; TargetSource; emit_stage_locus_port + reason symbols + diagnostic helpers;
//        emit (entry); emit_module; render_item closed dispatch; render_expr per-variant
//        case-analysis on the closed Tier 1 InferredExpr sum; render_arg / render_if /
//        render_block / render_binop / render_unary_symbol with closed-sum body bodies;
//        emit_ident + apply_naming_case + apply_reserved_escape + binop_eq leaf helpers;
//        bind_outcome / collect_outcomes Outcome-thread combinators;
//        render_* per-variant signatures (skeleton-pending arms).
// Consumes: v2_5.std.language_spec (LanguageSpec carrier + all sub-carriers — this file
//             does not redefine them; multi-consumer std/ home).
//           v2_5.std.node (Symbol, Path / PathStep / NamedStep for PortLocus only) —
//             Tier 0 (cool-bee-832, PR #3422). fold_node intentionally NOT
//             consumed for expression rendering; expr-render is per-variant
//             case-analysis on the closed Tier 1 InferredExpr sum (the
//             closed-sum IS the structural carrier; Practice 10 applies as
//             exhaustive case analysis, not as a generic-Node fold).
//           v2_5.std.diagnostic (Outcome, Diagnostic, Locus, PortLocus, Produced, Rejected,
//             Unavailable, ExternalContractUnknown) — Tier 0 mirror of v4.
//           v2_5.std.stage_types (InferredNode and its closed-sum variants) — Tier 1
//             (vivid-lynx-807).
// Status: DESIGN SCAFFOLD. Tier 0/1 substrates not yet authored; the import paths above
//         name the expected modules. The framework + LanguageSpec projection + fold
//         algebra + per-target instance pattern (src/v2.5/languages/rust.dag) are the
//         substantive content. When Tier 1 publishes the authoritative InferredNode
//         variant set, the fold step wires to it directly without restructuring.
// Anchor: docs/design-emission-model.md — emission is a structural projection from a typed
//         tree + per-target spec to target source; no decision engine, all real work lives
//         in the substrate facts the spec carries.
// Calibration trigger: PR #3402 "Deferred findings" §1 — per-target file split is the
//         dominant coproduct defect across v2's emit_go / emit_python mirror pair. This
//         file is the fork's resolution: ONE emit function, per-target syntax as data.


module v2_5.compiler.emit


import v2_5.std.language_spec {
  LanguageSpec,
  IdentifierRules,
  NamingCase,
  SnakeCase,
  PascalCase,
  CamelCase,
  AsAuthored,
  ReservedEscape,
  PrefixEscape,
  SuffixEscape,
  NoEscape,
  BlockSyntax,
  BracedBlock,
  IndentedBlock,
  IfForm,
  IfExpression,
  ConditionalTernary,
  IfStatement,
  InterpStyle,
  BinOpRule,
  BinOpRender,
  InfixSymbol,
  RightMethodCall,
  PrefixFunction,
  ConjunctionTypeForm
}
import v2_5.std.syntax {
  BinOp,
  Add, Sub, Mul, Div, Mod,
  Eq, Ne, Lt, Gt, Le, Ge,
  And, Or, NullCoalesce,
  LiteralValue,
  LitStr, LitInt, LitFloat, LitBool, LitNull,
  UnaryOpKind,
  Not, Neg
}
import v2_5.std.identity { BoundName, AuthoredName, SourceSpan }
// Symbol + Path/PathStep/NamedStep from substrate. Node / Edge / NodeFold /
// fold_node intentionally NOT imported here — render_expr is per-variant
// structural recursion on the closed InferredExpr sum (not a generic Node
// fold). When render_type's body lands it imports them (type-tree rendering
// IS the appropriate fold_node consumer per Practice 10).
import v2_5.std.node { Symbol, Path, PathStep, NamedStep }
import v2_5.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Locus,
  Outcome,
  PortLocus,
  Produced,
  Rejected,
  Unavailable
}
// Tier 1 — variant names from vivid-lynx-807 PR #3418 (reconciled dfb926f8c).
// Canonical pipeline contract: `emit : InferredModule -> TargetSource`. emit
// consumes InferredModule directly, not a generic InferredNode root carrier.
import v2_5.std.stage_types {
  InferredModule,
  InferredItem,
  InferredFn,
  InferredFunc,
  InferredTypeDecl,
  InferredDataDecl,
  InferredService,
  InferredOtherItem,
  InferredExpr,
  InferredLit,
  InferredVar,
  InferredFieldAccess,
  InferredCall,
  InferredMethodCall,
  InferredLambda,
  InferredLet,
  InferredIf,
  InferredMatch,
  InferredBlock,
  InferredRecordLit,
  InferredListLit,
  InferredStringInterp,
  InferredBinOp,
  InferredUnaryOp,
  InferredCast,
  InferredForEach,
  InferredIndex,
  InferredSlice,
  InferredReturn,
  InferredError,
  InferredType,
  InferredPattern,
  InferredMatchArm,
  InferredFieldInit,
  InferredArg,
  InferredImport,
  InferredOperation,
  InferredResourceUse,
  InferredTransport,
  InferredParam
}


// =============================================================================
// Diagnostic symbols + locus port — fail-closed boundaries
// =============================================================================

data emit_stage_locus_port: Symbol = emit_stage_locus_port

data emit_no_inhabitant: Symbol = emit_no_inhabitant
data emit_under_refined: Symbol = emit_under_refined
data emit_unsupported_coercion: Symbol = emit_unsupported_coercion
data emit_missing_language_rule: Symbol = emit_missing_language_rule


fn emit_locus() -> Locus {
  // PortLocus carries a Path (PR #3422 substrate reshape 2026-05-19); the
  // emit stage's port is the single-segment path naming its locus port.
  PortLocus {
    path: Path { steps: [NamedStep { name: emit_stage_locus_port }] }
  }
}


fn emit_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: emit_locus(),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// =============================================================================
// TargetSource — typed output carrier
// =============================================================================
//
// v2 returned `EmitResult { files: List<TextFile>, diagnostics: List<ErrorNode> }`
// — mixing success + failure in one record. v2.5 follows v4's pattern:
// `Outcome<TargetSource>` with the success/failure axis closed at the top.

type TargetFile {
  path: String
  content: String
}

type TargetSource {
  files: List<TargetFile>
  spec_id: Symbol
}


// =============================================================================
// emit — the entry point
// =============================================================================
//
// Per Tier 1's pipeline contract (v2_5.std.stage_types):
//   `emit : InferredModule -> TargetSource`
// emit consumes a fully-inferred module directly — there is no generic
// InferredNode top-level coproduct to dispatch on. Module IS the root carrier.
// This is the phase-typed boundary: emit's signature asserts post-inference.

fn emit(module: InferredModule, spec: LanguageSpec) -> Outcome<TargetSource> {
  match emit_module(module: module, spec: spec) {
    Produced { value: files } =>
      Produced {
        value: TargetSource {
          files: files,
          spec_id: spec.identity.language_id
        }
      }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


// =============================================================================
// emit_module — module → file
// =============================================================================

fn emit_module(module: InferredModule, spec: LanguageSpec) -> Outcome<List<TargetFile>> {
  let import_block = render_imports(used_imports: module.imports, spec: spec)
  let item_outcomes = module.items |> map(i => render_item(item: i, spec: spec))
  match collect_outcomes(items: item_outcomes) {
    Produced { value: item_texts } => {
      let body = item_texts |> join(separator: spec.items.item_separator)
      let content = concat(import_block, body)
      let file_path = render_module_path(name: module.name, spec: spec)
      Produced { value: [TargetFile { path: file_path, content: content }] }
    }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


// =============================================================================
// render_item — closed dispatch over InferredItem variants
// =============================================================================
//
// One match per InferredItem variant; each arm is a small render function that
// reads LanguageSpec and produces a String. The arms are NOT template-holes —
// each variant has structurally distinct rendering needs (data layout differs
// from fn body differs from service definition). They are honestly per-variant.

fn render_item(item: InferredItem, spec: LanguageSpec) -> Outcome<String> {
  match item {
    InferredFn { name: name, type_params: _, params: params, return_type: ret, uses: _, body: body, recursion: _, span: _ } =>
      render_fn(name: name, params: params, return_type: ret, body: body, spec: spec)
    InferredFunc { name: name, type_params: _, params: params, return_type: ret, uses: uses, body: body, recursion: _, span: _ } =>
      render_func(name: name, params: params, return_type: ret, uses: uses, body: body, spec: spec)
    InferredTypeDecl { name: name, type_params: _, definition: definition, span: _ } =>
      render_type_decl(name: name, definition: definition, spec: spec)
    InferredDataDecl { name: name, type_annotation: ty, value: value, span: _ } =>
      render_data_decl(name: name, type_annotation: ty, value: value, spec: spec)
    InferredService { name: name, transport: transport, operations: operations, span: _ } =>
      render_service(name: name, transport: transport, operations: operations, spec: spec)
    InferredOtherItem { keyword: _, raw_span: _ } =>
      // Unrecognized item kind reached emit — surface as fail-closed; the
      // pipeline should have rejected upstream rather than passing through.
      Rejected { diagnostic: emit_diagnostic(reason: emit_under_refined) }
  }
}


// =============================================================================
// render_expr — per-variant structural recursion on the closed InferredExpr sum
// =============================================================================
//
// REVISED DESIGN. The earlier draft tried to express emit-of-expression as one
// `fold_node` call with a `NodeFold<Outcome<String>>` algebra. Codex review
// #15207 (REQUEST_CHANGES) correctly flagged the fatal defect: the fold's
// `step` cannot reconstruct per-variant structure (call's `(args)` wrapping,
// if-expression's `if cond then ... else ...` arrangement, field-access
// separator placement) from a generic `(parent, edge, child)` triple without
// the per-variant grammar. Concat-only step loses child-role facts; the fold
// shape encodes the wrong emission algorithm.
//
// Reframe per Practice 10 honestly: a Tier 1 closed-sum `InferredExpr` is its
// OWN structural carrier — case analysis over its arms IS the structural
// recursion the discipline names. `fold_node` is appropriate for *generic*
// walks over the substrate Node carrier (e.g. collecting all Symbol leaves
// across an unknown tree); it is not appropriate when every variant has a
// distinct, named-field grammar that the typechecker proves exhaustive.
//
// This file now consumes `InferredExpr` directly via `match`, recursing into
// each variant's named children. The recursion is structural (the closed sum
// proves termination + exhaustiveness) and Outcome-threaded (every per-arm
// failure surfaces at the stage boundary).

fn render_expr(expr: InferredExpr, spec: LanguageSpec) -> Outcome<String> {
  match expr {
    // Leaves
    InferredLit { value: v, span: _, expr_type: _ } =>
      Produced { value: render_literal(value: v, spec: spec) }

    InferredVar { name: name, expr_type: _ } =>
      Produced { value: emit_ident(name: name, rules: spec.identifiers) }

    InferredError { kind: _, message: _, span: _ } =>
      // An upstream-stage error reached emit — fail-closed.
      Rejected { diagnostic: emit_diagnostic(reason: emit_under_refined) }

    // Composites — per-variant recursion preserving the grammar
    InferredFieldAccess { receiver: receiver, field: field, expr_type: _ } =>
      bind_outcome(o: render_expr(expr: receiver, spec: spec), f: fn(receiver_text) {
        Produced {
          value: concat(receiver_text, spec.expressions.field_access_separator,
                        emit_ident(name: field, rules: spec.identifiers))
        }
      })

    InferredCall { callee: callee, args: args, expr_type: _ } =>
      bind_outcome(o: render_args(args: args, spec: spec), f: fn(args_text) {
        Produced {
          value: concat(emit_ident(name: callee, rules: spec.identifiers),
                        spec.expressions.call_open, args_text, spec.expressions.call_close)
        }
      })

    InferredMethodCall { receiver: receiver, method: method, args: args, expr_type: _ } =>
      bind_outcome(o: render_expr(expr: receiver, spec: spec), f: fn(receiver_text) {
        bind_outcome(o: render_args(args: args, spec: spec), f: fn(args_text) {
          Produced {
            value: concat(receiver_text, spec.expressions.method_call_separator,
                          emit_ident(name: method, rules: spec.identifiers),
                          spec.expressions.call_open, args_text, spec.expressions.call_close)
          }
        })
      })

    InferredBinOp { op: op, left: left, right: right, algebra_field: _, expr_type: _ } =>
      bind_outcome(o: render_expr(expr: left, spec: spec), f: fn(left_text) {
        bind_outcome(o: render_expr(expr: right, spec: spec), f: fn(right_text) {
          render_binop(op: op, left: left_text, right: right_text, spec: spec)
        })
      })

    InferredUnaryOp { op: op, operand: operand, expr_type: _ } =>
      bind_outcome(o: render_expr(expr: operand, spec: spec), f: fn(operand_text) {
        Produced { value: concat(render_unary_symbol(op: op, spec: spec), operand_text) }
      })

    InferredIf { condition: condition, then_expr: then_expr, else_expr: else_expr, expr_type: _ } =>
      bind_outcome(o: render_expr(expr: condition, spec: spec), f: fn(cond_text) {
        bind_outcome(o: render_expr(expr: then_expr, spec: spec), f: fn(then_text) {
          bind_outcome(o: render_expr(expr: else_expr, spec: spec), f: fn(else_text) {
            render_if(form: spec.expressions.if_form, cond: cond_text, then_text: then_text, else_text: else_text)
          })
        })
      })

    InferredLet { name: name, value: value, body: body, expr_type: _ } =>
      bind_outcome(o: render_expr(expr: value, spec: spec), f: fn(value_text) {
        bind_outcome(o: render_expr(expr: body, spec: spec), f: fn(body_text) {
          Produced {
            value: concat("let ", emit_ident(name: name, rules: spec.identifiers), " = ",
                          value_text, ";\n", body_text)
          }
        })
      })

    InferredBlock { statements: statements, expr_type: _ } =>
      bind_outcome(
        o: collect_outcomes(items: statements |> map(s => render_expr(expr: s, spec: spec))),
        f: fn(stmt_texts) {
          render_block(block: spec.items.block, statements: stmt_texts)
        })

    // Remaining variants — render arms pending. Each carries its closed
    // structural shape (lambda params + body, match scrutinee + arms, etc.);
    // the per-variant render is a small follow-on commit that does NOT change
    // the dispatch shape. Marked Rejected with emit_under_refined for now so
    // a smoke test surfaces the gap rather than silently emitting "".
    InferredMatch { scrutinee: _, arms: _, expr_type: _ } => render_pending()
    InferredLambda { params: _, body: _, expr_type: _ } => render_pending()
    InferredStringInterp { parts: _, expr_type: _ } => render_pending()
    InferredRecordLit { type_name: _, fields: _, expr_type: _ } => render_pending()
    InferredListLit { elements: _, expr_type: _ } => render_pending()
    InferredCast { expr: _, target_type: _, expr_type: _ } => render_pending()
    InferredForEach { variable: _, iterable: _, body: _, expr_type: _ } => render_pending()
    InferredIndex { base: _, index: _, expr_type: _ } => render_pending()
    InferredSlice { base: _, start: _, end: _, expr_type: _ } => render_pending()
    InferredReturn { value: _, expr_type: _ } => render_pending()
  }
}


// Outcome bind — sequential composition. Bind preserves Rejected; chains the
// success path. This is the standard monadic bind for the Outcome carrier;
// when v2_5.std.diagnostic publishes a canonical `bind` it dissolves to that.
fn bind_outcome(o: Outcome<String>, f: fn(String) -> Outcome<String>) -> Outcome<String> {
  match o {
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
    Produced { value: v } => f(v)
  }
}


// Helper for variants whose render body is a follow-on commit. Surfaces
// fail-closed with under-refined so the smoke detects the gap; per-variant
// bodies replace this with structural rendering as they land.
fn render_pending() -> Outcome<String> {
  Rejected { diagnostic: emit_diagnostic(reason: emit_under_refined) }
}


// render_args — fold over List<InferredArg>, joining with arg_separator.
fn render_args(args: List<InferredArg>, spec: LanguageSpec) -> Outcome<String> {
  let arg_outcomes = args |> map(a => render_arg(arg: a, spec: spec))
  match collect_outcomes(items: arg_outcomes) {
    Produced { value: arg_texts } =>
      Produced { value: arg_texts |> join(separator: spec.expressions.arg_separator) }
    Rejected { diagnostic: d } => Rejected { diagnostic: d }
  }
}


// =============================================================================
// Leaf renderers — small, data-driven, mechanically derivable
// =============================================================================
//
// emit_ident is the canonical example: ONE function, no per-target dispatch
// (PR #3402's apply_reserved_escape principle generalized + grounded in a
// closed NamingCase / ReservedEscape sum).

// Identifiers at emit see post-resolve BoundName (per Tier 1's stage_types:
// "Parse phases use AuthoredName; post-resolve phases use Symbol"). BoundName
// = { symbol: Symbol, span: SourceSpan }; we render from the symbol field.
fn emit_ident(name: BoundName, rules: IdentifierRules) -> String {
  let converted = apply_naming_case(symbol: name.symbol, case: rules.default_case)
  let is_reserved = rules.reserved_words |> any(r => r == name.symbol)
  if is_reserved {
    apply_reserved_escape(name: converted, escape: rules.reserved_escape)
  } else {
    converted
  }
}


fn apply_naming_case(symbol: Symbol, case: NamingCase) -> String {
  match case {
    SnakeCase => to_snake(name: symbol_to_string(s: symbol))
    PascalCase => to_pascal(name: symbol_to_string(s: symbol))
    CamelCase => to_camel(name: symbol_to_string(s: symbol))
    AsAuthored => symbol_to_string(s: symbol)
  }
}


fn apply_reserved_escape(name: String, escape: ReservedEscape) -> String {
  match escape {
    PrefixEscape { prefix: p } => concat(p, name)
    SuffixEscape { suffix: s } => concat(name, s)
    NoEscape => name
  }
}


// render_binop — typed dispatch over List<BinOpRule> + BinOpRender. The shape
// expresses BOTH infix-symbol ops (lhs <symbol> rhs) AND non-infix realizations
// (lhs.method(rhs), fn(lhs, rhs)) without forcing all ops through one mold.
// Codex #15207 finding 3 (Rust's NullCoalesce is `lhs.unwrap_or(rhs)`, not an
// infix operator): the typed BinOpRender carries which shape applies.
// Fail-closed: a BinOp absent from spec.expressions.binops surfaces
// emit_missing_language_rule.
//
// 🟡 The List<BinOpRule> shape lacks structural totality + uniqueness over the
// closed BinOp domain. A Map<BinOp, BinOpRule> would prove uniqueness by
// construction; v2.5 substrate (PR #3422) does not yet expose a Map carrier.
// Until a substrate Map lands, the diagnostic-bearing lookup is the boundary
// that catches gaps. Dissolves on v2_5.std.collection.Map.
fn render_binop(op: BinOp, left: String, right: String, spec: LanguageSpec) -> Outcome<String> {
  match spec.expressions.binops |> filter(r => binop_eq(a: r.op, b: op)) |> first {
    Some { value: rule } =>
      match rule.render {
        InfixSymbol { symbol: s, precedence: _ } =>
          Produced { value: concat(left, s, right) }
        RightMethodCall { method_name: m, open: o, close: c } =>
          // `lhs.method(rhs)` — Rust's .unwrap_or pattern.
          Produced { value: concat(left, ".", m, o, right, c) }
        PrefixFunction { function_name: fname, open: o, separator: sep, close: c } =>
          // `fn(lhs, rhs)` — e.g. some targets emit comparisons as a function.
          Produced { value: concat(fname, o, left, sep, right, c) }
      }
    None => Rejected { diagnostic: emit_diagnostic(reason: emit_missing_language_rule) }
  }
}


fn render_unary_symbol(op: UnaryOpKind, spec: LanguageSpec) -> String {
  match op {
    Not => spec.expressions.unary_not
    Neg => spec.expressions.unary_neg
  }
}


// render_if — IfForm closed sum carries the three target-arrangements
// (value-expression, ternary, statement); each composes the three rendered
// pieces (cond, then, else) per its grammar.
fn render_if(form: IfForm, cond: String, then_text: String, else_text: String) -> Outcome<String> {
  match form {
    IfExpression { kw_if: ki, kw_then: kt, kw_else: ke } =>
      Produced { value: concat(ki, cond, kt, then_text, ke, else_text) }
    ConditionalTernary { then_form: tf, else_form: ef } =>
      // Python "x if c else y" style.
      Produced { value: concat(then_text, tf, cond, ef, else_text) }
    IfStatement { kw_if: _, kw_else: _ } =>
      // Statement-form needs assignment-wrapper to lift to expression
      // position; the lifting decision is per-caller. Surface as
      // under-refined until the caller threads its lifting strategy.
      Rejected { diagnostic: emit_diagnostic(reason: emit_under_refined) }
  }
}


fn render_block(block: BlockSyntax, statements: List<String>) -> Outcome<String> {
  match block {
    BracedBlock { open: o, close: c, statement_terminator: t } =>
      Produced { value: concat(o, statements |> join(separator: t), c) }
    IndentedBlock { header_terminator: ht, statement_terminator: st, indent_unit: _ } =>
      Produced { value: concat(ht, statements |> join(separator: st)) }
  }
}


// render_arg — InferredArg carries optional name (for keyword args) + value.
// Named args render `name: value` (target-syntax-dependent — defaults to the
// param-type separator); positional args render just the value.
fn render_arg(arg: InferredArg, spec: LanguageSpec) -> Outcome<String> {
  bind_outcome(o: render_expr(expr: arg.value, spec: spec), f: fn(value_text) {
    match arg.name {
      Some { value: name } =>
        Produced { value: concat(emit_ident(name: name, rules: spec.identifiers), ": ", value_text) }
      None =>
        Produced { value: value_text }
    }
  })
}


// 🟡 Practice 10: hand-rolled 14-way equality dissolves when the substrate
// publishes derived equality over enum sums (sibling of v2_5.std.collection.Map
// for BinOp keys). Until then this is the explicit-and-honest lookup pred.
// Arms match canonical v2_5.std.syntax.BinOp exactly (Ne/Le/Ge; no StringConcat).
fn binop_eq(a: BinOp, b: BinOp) -> Bool {
  match a {
    Add => match b { Add => true _ => false }
    Sub => match b { Sub => true _ => false }
    Mul => match b { Mul => true _ => false }
    Div => match b { Div => true _ => false }
    Mod => match b { Mod => true _ => false }
    Eq => match b { Eq => true _ => false }
    Ne => match b { Ne => true _ => false }
    Lt => match b { Lt => true _ => false }
    Le => match b { Le => true _ => false }
    Gt => match b { Gt => true _ => false }
    Ge => match b { Ge => true _ => false }
    And => match b { And => true _ => false }
    Or => match b { Or => true _ => false }
    NullCoalesce => match b { NullCoalesce => true _ => false }
  }
}


// =============================================================================
// Per-variant render skeletons — signatures
// =============================================================================
//
// These are the framework's public contract; the bodies follow the same shape
// — fold over their structural sub-children using LanguageSpec to fill
// syntactic fragments. They are sketched as signatures here so per-target data
// files (src/v2.5/languages/<target>.dag) can verify the LanguageSpec they
// instantiate is shaped correctly. Bodies follow once Tier 1's InferredNode
// variant set is published; the variant arms each become a small data-driven
// renderer reading from LanguageSpec, no per-target match arms.

// Signatures match Tier 1 (PR #3418) variant field shapes: name carrier is
// BoundName, body is InferredBlock, item-level types carry their own
// `definition` / `type_annotation` / `value` fields. Rebased against
// stage_types.dag dfb926f8c.
fn render_fn(name: BoundName, params: List<InferredParam>, return_type: InferredType, body: InferredBlock, spec: LanguageSpec) -> Outcome<String>
fn render_func(name: BoundName, params: List<InferredParam>, return_type: InferredType, uses: List<InferredResourceUse>, body: InferredBlock, spec: LanguageSpec) -> Outcome<String>
fn render_type_decl(name: BoundName, definition: InferredType, spec: LanguageSpec) -> Outcome<String>
fn render_data_decl(name: BoundName, type_annotation: InferredType, value: InferredExpr, spec: LanguageSpec) -> Outcome<String>
fn render_service(name: BoundName, transport: InferredTransport, operations: List<InferredOperation>, spec: LanguageSpec) -> Outcome<String>

// Concrete leaf renderers — closed-sum dispatch with real bodies. The earlier
// draft kept these as signatures-only; codex review #15207 noted that approach
// hides the discipline. Inlining the small ones makes the per-variant render
// strategy explicit + the LanguageSpec field reads visible.

fn render_literal(value: LiteralValue, spec: LanguageSpec) -> String {
  match value {
    LitStr { value: s } => concat("\"", s, "\"")
    LitInt { value: i } => int_to_string(i: i)
    LitFloat { value: f } => f
    LitBool { value: b } => if b { "true" } else { "false" }
    LitNull => spec.expressions.null_literal
  }
}


// render_imports — filter rules by trigger, emit one import line per match.
// The framing comes from spec.imports (import_keyword + path_open + path_close);
// each rule supplies only the path body. Codex review #15207 finding 2 — the
// previous shape carried fully-rendered "use ...;" strings AND framing fields;
// now the rule path is bare and the framework composes the line.
fn render_imports(used_imports: List<InferredImport>, spec: LanguageSpec) -> String {
  // 🟡 trigger-matching against used_imports is a follow-on commit (needs the
  // Tier 1 InferredImport coproduct to be walked to extract the used name set
  // that triggers each rule). For now this returns an empty import block; the
  // per-rule line shape compositional structure is the relevant design fact.
  ""
}


fn render_module_path(name: BoundName, spec: LanguageSpec) -> String {
  // Module path is the module's BoundName + the target's file suffix; spec
  // does not yet carry a file-suffix-for-module field. 🟡 add a
  // file_suffix_for_module: String to ItemSyntax when this lands real.
  concat(symbol_to_string(s: name.symbol), ".out")
}


// Skeleton signatures — bodies follow when their per-variant render fills in
// (each is small once the closed structural shape is consumed). Listed for
// LanguageSpec-instance authors to verify the carrier shape they instantiate.
fn render_lambda_prefix(spec: LanguageSpec) -> String
fn render_string_interp_prefix(style: InterpStyle) -> String
fn render_record_open(form: ConjunctionTypeForm) -> String
fn render_cast_prefix(spec: LanguageSpec) -> String
fn render_foreach_prefix(spec: LanguageSpec) -> String
fn render_return_prefix(spec: LanguageSpec) -> String


// =============================================================================
// Outcome-list collection helper — fail-closed propagation
// =============================================================================

fn collect_outcomes(items: List<Outcome<String>>) -> Outcome<List<String>> {
  items |> fold(init: Produced { value: [] }, f: fn(acc, item) {
    match acc {
      Rejected { diagnostic: d } => Rejected { diagnostic: d }
      Produced { value: vs } =>
        match item {
          Produced { value: v } => Produced { value: concat(vs, [v]) }
          Rejected { diagnostic: d } => Rejected { diagnostic: d }
        }
    }
  })
}


// =============================================================================
// Bridges to substrate / Tier 1 shape — declared here, owned there
// =============================================================================

extern fn symbol_to_string(s: Symbol) -> String
extern fn int_to_string(i: Int) -> String
extern fn to_snake(name: String) -> String
extern fn to_pascal(name: String) -> String
extern fn to_camel(name: String) -> String


// =============================================================================
// Receipts — v2 patterns that dissolve under this framework
// =============================================================================
//
//   v2 pattern                                          | v2.5 resolution
//   ----------------------------------------------------|--------------------------------
//   `match target { Rust => x | Python => y | Go => z}` | LanguageSpec field read
//   `emit_rust_X` + `emit_go_X` + `emit_py_X` triples   | one `render_X(node, spec)`
//   `render_node_type` 180-line hand-rolled catamorphism | fold_node + TypeRenderRules (pending)
//   `emit_typed_expr` 22-arm walker, recursive at arms  | per-variant case-analysis on closed
//                                                       | InferredExpr sum (Practice 10 over
//                                                       | the closed-sum carrier; fold_node
//                                                       | applies to generic Node walks, not
//                                                       | to typed-sum dispatch — codex review
//                                                       | #15207 finding 1 disposition)
//   `emit_rust_tco_*` family duplicating `emit_rust_*`  | one render path; tail-pos data
//   per-target `escape_X_interp_text`                   | apply_escape_pairs + EscapePair list
//   `reserved_prefix` + `reserved_suffix` (dead)        | typed ReservedEscape coproduct
//   string-tagged "target" string parameter             | typed Symbol via LanguageIdentity
//   `EmitResult { files, diagnostics }` (mixed shape)   | Outcome<TargetSource> closed sum
//   per-target inline `if op_name == "fold" ...` chains | List<BinOpRule> typed lookup
//   inline infix-vs-method-call op rendering branches   | BinOpRender typed coproduct
//                                                       | (InfixSymbol / RightMethodCall /
//                                                       | PrefixFunction; codex #15207 #3
//                                                       | disposition)
//   coercion match cascades (v2/coercion.dag)           | List<CoercionRule> typed data
//   `RenderTarget = Rust | Python | Go | Dag` tag       | Symbol via LanguageIdentity + spec
//   import line pre-rendered string in each rule        | ImportRules carries per-target framing
//                                                       | (keyword + open + close); ImportRule
//                                                       | carries bare path body only (codex
//                                                       | #15207 #2 disposition — single
//                                                       | authority per axis)
