// v2 module resolver — pure function from parsed modules to dependency-ordered graph.
//
// No I/O — file discovery and parsing are handled by the pipeline.
// Takes a list of parsed Module values and:
//   1. Validates there are no duplicate module declarations
//   2. Resolves each import to its target module
//   3. Validates imported names exist in target modules
//   4. Detects circular dependencies
//   5. Topologically sorts modules (leaves first = dep_order 0)
//
// The resolver is the bridge between "a bag of parsed files" and
// "an ordered graph the typechecker can walk front-to-back".

module v2.compiler.resolve

import v2.std.core { Module, Import, ImportNames, ImportAll, ImportSpecific, Node, Connective, Conj, Disj, Diagnostic, Severity }

// =========================================================================
// Output types
// =========================================================================

type ModuleGraph {
  modules: List<ResolvedModule>
  diagnostics: List<Diagnostic>
}

type ResolvedModule {
  module: Module
  resolved_imports: List<ResolvedImport>
  dep_order: Int
}

type ResolvedImport {
  module_path: String
  names: ImportNames
  target_module: Module?
}

// =========================================================================
// Internal types — used by the topological sort and cycle detection
// =========================================================================

// An edge in the import graph: from_module imports to_module.
type DepEdge {
  from_module: String
  to_module: String
}

// State threaded through Kahn's algorithm.
type KahnState {
  // Modules that have been placed in sorted order so far (ordered output).
  sorted: List<String>
  // O(1) membership set for sorted modules.
  sorted_set: Map<String, Bool>
  // Current in-degree for each module, keyed by module name.
  in_degree_map: Map<String, Int>
  // Module names list (for iteration).
  module_names: List<String>
  // Adjacency: list of edges (dep -> dependant).
  edges: List<DepEdge>
}

// Result of a single Kahn iteration step.
type KahnStepResult {
  state: KahnState
  progress: Bool
}

// Accumulator for Phase 2 — builds imports-by-name map and collects diagnostics.
type ResolveAccum {
  imports_by_name: Map<String, List<ResolvedImport>>
  diagnostics: List<Diagnostic>
}

// Map membership check — returns true if key is present, false otherwise.
// Uses match on map_get since the evaluator represents None as a variant map,
// not as the none literal (Value::Unit), so direct == / != comparisons fail.
fn map_has(m: Map<String, Bool>, key: String) -> Bool {
  match map_get(m, key) {
    Some { value: _ } => true
    None => false
  }
}

// =========================================================================
// Entry point
// =========================================================================

fn resolve_modules(modules: List<Module>) -> ModuleGraph {
  // Phase 1: check for duplicate module declarations
  let dup_diags = check_duplicate_modules(modules: modules)

  // Build a module index for O(1) lookup during import resolution.
  let module_index = modules |> fold(init: empty_map(), f: (acc, m) =>
    map_insert(acc, m.name, m)
  )

  // Phase 2: resolve each module's imports.
  // Build a map from module name to resolved imports for O(1) lookup,
  // and collect diagnostics in a single pass.
  let resolve_accum = modules |> fold(init: ResolveAccum {
    imports_by_name: empty_map(),
    diagnostics: []
  }, f: (acc, m) =>
    let result = resolve_module_imports(module: m, module_index: module_index)
    ResolveAccum {
      imports_by_name: map_insert(acc.imports_by_name, m.name, result.resolved_imports),
      diagnostics: concat(acc.diagnostics, result.diagnostics)
    }
  )
  let imports_by_name = resolve_accum.imports_by_name
  let import_diags = resolve_accum.diagnostics

  // Phase 3: topological sort
  let topo_result = topological_sort(modules: modules)
  let topo_diags = match topo_result.cycle_error {
    Some { value: diag } => [diag]
    None => []
  }

  // Phase 4: assign dep_order from the sorted order.
  // Modules not in the sorted output (cycle members) get no dep_order
  // and are excluded from the acyclic result.
  // Build a map from module name to its position in the sorted list for O(1) lookup.
  let sorted_names = topo_result.sorted
  let sorted_order_map = sorted_names |> enumerate |> fold(init: empty_map(), f: (acc, pair) =>
    map_insert(acc, pair.second, pair.first)
  )
  let acyclic_resolved = modules |> flat_map(m =>
    match map_get(sorted_order_map, m.name) {
      Some { value: order } =>
        match map_get(imports_by_name, m.name) {
          // imports_by_name should contain every module — None is
          // unreachable. Default to [] only as a safe fallback.
          Some { value: imps } =>
            [ResolvedModule {
              module: m,
              resolved_imports: imps,
              dep_order: order
            }]
          None => []
        }
      None => []
    }
  )

  // Sort resolved modules by dep_order (leaves first)
  let sorted_resolved = acyclic_resolved |> sort_by(m => m.dep_order)

  ModuleGraph {
    modules: sorted_resolved,
    diagnostics: concat(dup_diags, import_diags, topo_diags)
  }
}

// =========================================================================
// Module lookup
// =========================================================================

// Find a module by its module declaration path (the `name` field).
fn find_module(module_index: Map<String, Module>, path: String) -> Module? {
  map_get(module_index, path)
}

// =========================================================================
// Import resolution
// =========================================================================

// Result of resolving one module's imports.
type ModuleResolveResult {
  resolved_imports: List<ResolvedImport>
  diagnostics: List<Diagnostic>
}

// Resolve all imports for a single module.
fn resolve_module_imports(module: Module, module_index: Map<String, Module>) -> ModuleResolveResult {
  let results = module.imports |> map(imp =>
    resolve_import(import: imp, module_index: module_index, importing_module: module.name)
  )
  let resolved = results
    |> filter(r => r.resolved.target_module != none && (r.diagnostics |> count == 0))
    |> map(r => r.resolved)
  let diags = results |> flat_map(r => r.diagnostics)
  ModuleResolveResult {
    resolved_imports: resolved,
    diagnostics: diags
  }
}

// Result of resolving a single import statement.
type ImportResolveResult {
  resolved: ResolvedImport
  diagnostics: List<Diagnostic>
}

// Resolve a single import: find target module, validate imported names.
fn resolve_import(
  import: Import,
  module_index: Map<String, Module>,
  importing_module: String
) -> ImportResolveResult {
  let target = find_module(module_index: module_index, path: import.module_path)
  match target {
    None => {
      let diag = Diagnostic {
        severity: Error,
        message: concat("unresolved import: module '", import.module_path, "' not found (imported by '", importing_module, "')"),
        span: Some { value: import.span },
        module_name: Some { value: importing_module }
      }
      ImportResolveResult {
        resolved: ResolvedImport {
          module_path: import.module_path,
          names: import.names,
          target_module: None
        },
        diagnostics: [diag]
      }
    }
    Some { value: target_mod } => {
      // Validate each imported name exists in the target.
      // Build a set from the exported names for O(1) membership checks.
      let exported = get_exported_names(module: target_mod)
      let exported_set = fold(exported, init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
      let name_diags = match import.names {
        ImportAll => []
        ImportSpecific { names: specific_names } =>
          specific_names
            |> filter(name => map_has(m: exported_set, key: name) == false)
            |> map(missing_name =>
              Diagnostic {
                severity: Error,
                message: concat("name '", missing_name, "' not found in module '", import.module_path, "' (imported by '", importing_module, "')"),
                span: Some { value: import.span },
                module_name: Some { value: importing_module }
              }
            )
      }
      ImportResolveResult {
        resolved: ResolvedImport {
          module_path: import.module_path,
          names: import.names,
          target_module: Some { value: target_mod }
        },
        diagnostics: name_diags
      }
    }
  }
}

// =========================================================================
// Exported names
// =========================================================================

// Extract all names from a module that can be imported.
// Every top-level item (type, fn, func, service, resource, data,
// extern func) contributes its name. Sum-type variants also contribute
// their names so callers can import variant constructors directly.
// Explicitly imported names are re-exported: if module A does
// `import B { Foo }`, then importers of A can also see Foo.
// Kernel primitives (String, Int, Bool, etc.) are always available
// and treated as implicitly exported by every module.
fn get_exported_names(module: Module) -> List<String> {
  let item_names = module.items |> map(item => get_item_name(item: item))
  let variant_names = module.items
    |> flat_map(item => get_variant_names(item: item))
  let imported_names = module.imports
    |> flat_map(imp => get_import_specific_names(names: imp.names))
  concat(item_names, variant_names, imported_names, kernel_type_names())
}

// The 8 kernel primitives that are implicitly available in every module.
fn kernel_type_names() -> List<String> {
  ["String", "Int", "Bool", "Float", "Secret", "Json", "Unit", "Bytes"]
}

// Extract explicitly named imports from an ImportNames value.
// Wildcard imports (ImportAll) are not re-exported since the target
// module's full export list is not available at this point.
fn get_import_specific_names(names: ImportNames) -> List<String> {
  match names {
    ImportAll => []
    ImportSpecific { names: ns } => ns
  }
}

// Extract the primary name from an item.
fn get_item_name(item: Node) -> String {
  item.name
}

// Extract variant constructor names from a type definition.
// For sum types (disjunction), each child node is a variant whose name
// is importable. For other items, returns an empty list.
fn get_variant_names(item: Node) -> List<String> {
  match item.connective {
    Some { value: Disj } => item.children |> map(c => c.name)
    _ => []
  }
}

// =========================================================================
// Module dependency extraction
// =========================================================================

// Extract the module paths that a module depends on (from its imports).
fn get_module_deps(module: Module) -> List<String> {
  module.imports |> map(imp => imp.module_path)
}

// =========================================================================
// Duplicate module detection
// =========================================================================

// Check for duplicate module declarations (same name appearing twice).
// DuplicateCheckState — fold accumulator for seen-set duplicate detection.
type DuplicateCheckState {
  seen_names: Map<String, Bool>
  diagnostics: List<Diagnostic>
}

fn check_duplicate_modules(modules: List<Module>) -> List<Diagnostic> {
  // Fold over modules maintaining a seen-names map for O(1) lookup.
  // For each module, check if its name is already in the seen map.
  // If so, emit a diagnostic. Then add the name to the seen map.
  let result = modules |> fold(init: DuplicateCheckState {
    seen_names: empty_map(),
    diagnostics: []
  }, f: fn(state, m) {
    let is_dup = map_has(m: state.seen_names, key: m.name)
    if is_dup {
      DuplicateCheckState {
        seen_names: state.seen_names,
        diagnostics: concat(state.diagnostics, [Diagnostic {
          severity: Error,
          message: concat("duplicate module declaration: '", m.name, "'"),
          span: Some { value: m.span },
          module_name: Some { value: m.name }
        }])
      }
    } else {
      DuplicateCheckState {
        seen_names: map_insert(state.seen_names, m.name, true),
        diagnostics: state.diagnostics
      }
    }
  })
  result.diagnostics
}

// =========================================================================
// Topological sort — Kahn's algorithm
//
// Iterative approach using fold over a bounded number of steps.
// Each step finds all zero-in-degree nodes, removes them, and
// decrements neighbors. Terminates when no progress is made
// (either all sorted, or a cycle exists).
// =========================================================================

type TopoResult {
  sorted: List<String>
  cycle_error: Diagnostic?
}

fn topological_sort(modules: List<Module>) -> TopoResult {
  let module_names = modules |> map(m => m.name)
  let all_edges = modules
    |> flat_map(m =>
      get_module_deps(module: m) |> map(dep =>
        DepEdge { from_module: dep, to_module: m.name }
      )
    )

  // Compute initial in-degrees as a map for O(1) lookup.
  // First initialize all modules to 0, then increment for each edge.
  let zero_degrees = module_names |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, 0)
  )
  let initial_in_degree_map = all_edges |> fold(init: zero_degrees, f: (acc, e) =>
    let current = match map_get(acc, e.to_module) {
      Some { value: d } => d
      None => 0
    }
    map_insert(acc, e.to_module, current + 1)
  )

  let initial_state = KahnState {
    sorted: [],
    sorted_set: empty_map(),
    in_degree_map: initial_in_degree_map,
    module_names: module_names,
    edges: all_edges
  }

  // Run Kahn's algorithm: iterate at most N times (one module emitted per round).
  let module_count = modules |> count
  let final_state = kahn_iterate(state: initial_state, remaining: module_count)

  let sorted_count = final_state.sorted |> count
  if sorted_count == module_count {
    TopoResult { sorted: final_state.sorted, cycle_error: None }
  } else {
    // Modules not in sorted output are part of a cycle
    let cycle_members = module_names
      |> filter(name => map_has(m: final_state.sorted_set, key: name) == false)
    let cycle_desc = cycle_members |> join(separator: " -> ")
    TopoResult {
      sorted: final_state.sorted,
      cycle_error: Some { value: Diagnostic {
        severity: Error,
        message: concat("circular dependency detected: ", cycle_desc),
        span: None,
        module_name: None
      } }
    }
  }
}

// Run up to `remaining` rounds of Kahn's algorithm.
// Each round collects all zero-in-degree nodes, adds them to sorted,
// and decrements in-degrees of their dependants.
fn kahn_iterate(state: KahnState, remaining: Int) -> KahnState {
  if remaining <= 0 {
    return state
  }
  let step = kahn_step(state: state)
  if step.progress == false {
    // No progress — either done or stuck on a cycle
    return step.state
  }
  kahn_iterate(state: step.state, remaining: remaining - 1)
}

// One step of Kahn's algorithm: find all zero-in-degree nodes,
// emit them (sorted), and decrement neighbors' in-degrees.
fn kahn_step(state: KahnState) -> KahnStepResult {
  // Find all nodes with in-degree 0 that aren't already sorted.
  // Uses in_degree_map for O(1) degree lookup and sorted_set for O(1) membership.
  let zero_nodes = state.module_names
    |> filter(name =>
      let deg = match map_get(state.in_degree_map, name) {
        Some { value: d } => d
        None => -1
      }
      deg == 0 && map_has(m: state.sorted_set, key: name) == false
    )
    |> sort_by(name => name)  // deterministic ordering

  if zero_nodes |> count == 0 {
    return KahnStepResult { state: state, progress: false }
  }

  // Build a set from zero_nodes for O(1) membership checks.
  let zero_set = zero_nodes |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, true)
  )

  // Add zero-degree nodes to sorted output
  let new_sorted = concat(state.sorted, zero_nodes)
  let new_sorted_set = zero_nodes |> fold(init: state.sorted_set, f: (acc, name) =>
    map_insert(acc, name, true)
  )

  // Decrement in-degrees: for each edge from a zero_node, decrement target.
  // Mark zero_nodes themselves as -1 so they aren't picked again.
  let decremented = state.edges
    |> filter(e => map_has(m: zero_set, key: e.from_module))
    |> fold(init: state.in_degree_map, f: (acc, e) =>
      let current = match map_get(acc, e.to_module) {
        Some { value: d } => d
        None => -1
      }
      map_insert(acc, e.to_module, current - 1)
    )
  let new_in_degree_map = zero_nodes |> fold(init: decremented, f: (acc, name) =>
    map_insert(acc, name, -1)
  )

  KahnStepResult {
    state: KahnState {
      sorted: new_sorted,
      sorted_set: new_sorted_set,
      in_degree_map: new_in_degree_map,
      module_names: state.module_names,
      edges: state.edges
    },
    progress: true
  }
}

