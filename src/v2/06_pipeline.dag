// v2 compiler pipeline — the full .dag-to-files transform.
//
// The compiler reads .dag source files and emits target-language source
// files. No DAG IR, no interpreter, no executor. Each stage is a pure
// function. The only I/O is reading source files (Filesystem.read).
//
// Pipeline: tokenize -> parse -> resolve -> typecheck -> emit
// Each stage is a pure function. The pipeline wires them together.

module v2.compiler.pipeline

import std.types { FilePath, SourceSpan }
import std.resources { Filesystem }
import v2.std.core {
  Module, Token, TextFile, Diagnostic, CompileResult
}
import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse, ParseResult }
import v2.compiler.resolve { resolve_modules, ModuleGraph }
import v2.compiler.typecheck { typecheck, TypedGraph }
import v2.compiler.emit { emit_rust }

// =========================================================================
// Types
// =========================================================================

type SourceFile {
  path: String
  content: String
}

type Backend = Rust | Python

type StageResult {
  value: List<Module>
  diagnostics: List<Diagnostic>
}

type TokenizeResult {
  tokens: List<Token>
  diagnostics: List<Diagnostic>
}

type ParseStageResult {
  modules: List<Module>
  diagnostics: List<Diagnostic>
}

// Result of compiling a single source file — module (if parse succeeded)
// plus any diagnostics. Follows the value+diagnostics pattern.
type CompileFileResult {
  module: Module?
  diagnostics: List<Diagnostic>
}

// =========================================================================
// Source reading (effectful)
// =========================================================================

fn read_source(path: FilePath) -> SourceFile {
  let content = Filesystem.read(path: path)
  SourceFile { path: path, content: content.content }
}

// =========================================================================
// Diagnostic collection
// =========================================================================

// Gather all diagnostics from a list of parse results.
fn collect_diagnostics(parse_results: List<ParseResult>) -> List<Diagnostic> {
  fold(parse_results, init: [], f: fn(acc, pr) {
    if pr.error != None {
      concat(acc, [Diagnostic {
        severity: Error,
        message: pr.error,
        span: None,
        module_name: None
      }])
    } else {
      acc
    }
  })
}

// =========================================================================
// Single-file convenience wrapper
// =========================================================================

// Compile a single source file through all stages.
// Returns the parsed module (if successful) and any diagnostics.
fn compile_file(source: SourceFile) -> CompileFileResult {
  let tokens = tokenize(source: source.content)
  let result = parse(tokens: tokens)
  if result.error != None {
    let diag = Diagnostic {
      severity: Error,
      message: result.error,
      span: None,
      module_name: None
    }
    CompileFileResult { module: None, diagnostics: [diag] }
  } else {
    CompileFileResult { module: result.module, diagnostics: [] }
  }
}

// =========================================================================
// Full pipeline
// =========================================================================

// Pure compiler pipeline: sources in, compiled files out.
// Wires tokenize -> parse -> resolve -> typecheck -> emit.
fn compile_sources(sources: List<SourceFile>, backend: Backend) -> CompileResult {
  // Stage 1: Tokenize each source file
  let tokenized = map(sources, s => tokenize(source: s.content))

  // Stage 2: Parse each token stream into a module
  let parse_results = map(tokenized, t => parse(tokens: t))

  // Check for parse errors BEFORE extracting modules.
  // parse() returns { module: none } on failure, so extracting p.module
  // before this check would produce List<Module?> — a type violation
  // that the evaluator cannot catch at runtime (S56).
  let parse_diagnostics = collect_diagnostics(parse_results: parse_results)
  let has_errors = any(parse_results, p => p.error != None)

  if has_errors {
    CompileResult {
      files: [],
      diagnostics: parse_diagnostics
    }
  } else {
    // Safe to extract: all parses succeeded, so every p.module is Some.
    let modules = map(parse_results, p => p.module)
    // Stage 3: Resolve imports and build module graph
    let graph = resolve_modules(modules: modules)

    // Stage 4: Type-check the module graph
    let typed = typecheck(graph: graph)

    // Stage 5: Emit target-language files
    let files = match backend {
      Rust => emit_rust(typed: typed)
      Python => []
    }

    CompileResult {
      files: files,
      diagnostics: concat(graph.diagnostics, typed.diagnostics, parse_diagnostics)
    }
  }
}
