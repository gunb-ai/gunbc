// src/v2/extdeps/platform_detection.dag
// Scope: external-system platform detection facts — what `uname -m` and
//        `$env:PROCESSOR_ARCHITECTURE` actually emit, and the canonical mapping back to the
//        std/platform Architecture / OperatingSystem vocabulary. Modeled in extdeps/ per M3
//        because the facts (POSIX uname strings, PowerShell variable name) belong to specs the
//        compiler does not own.
// Status: Release Jun1 §5 Phase 1b prerequisite — modeled 2026-05-29.
// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/utilities/uname.html — POSIX uname.
// Anchor: https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/set_1
//         — Windows `$env:PROCESSOR_ARCHITECTURE` (AMD64 / ARM64 / x86 values).

module v2.extdeps.platform_detection


import v2.std.collection { List }
import v2.std.platform { Aarch64, Architecture, Linux, Macos, OperatingSystem, X86, X86_64 }
import v2.std.text { String }


// Detection command — closed set over the shells the install scripts invoke.
// 🟢 coproduct dissolution — DetectionCommand.
type DetectionCommand
  = UnameMinusM      // POSIX `uname -m` — Linux / macOS / *BSD / Wasi-via-emulator hosts.
  | UnameMinusS      // POSIX `uname -s` — OS kernel name (Linux, Darwin, FreeBSD, …).
  | PowerShellOsArch // `$env:PROCESSOR_ARCHITECTURE` — Windows hosts.


// Anchor: https://pubs.opengroup.org/onlinepubs/9799919799/utilities/uname.html. The raw outputs
// of `uname -m` are platform-defined strings; this mapping is the closed-set authority for what
// each well-known raw string canonicalizes to. macOS ARM reports `arm64` (not `aarch64`); the
// quirk is captured by the (arm64 → Aarch64) row rather than by a normalization shell expression
// (M7 — data table is the authority).
type UnameArchMapping {
  raw_uname_m_output: String
  canonical: Architecture
}

data uname_x86_64: UnameArchMapping = UnameArchMapping {
  raw_uname_m_output: "x86_64",
  canonical: X86_64
}

data uname_amd64: UnameArchMapping = UnameArchMapping {
  raw_uname_m_output: "amd64",
  canonical: X86_64
}

data uname_aarch64: UnameArchMapping = UnameArchMapping {
  raw_uname_m_output: "aarch64",
  canonical: Aarch64
}

// Anchor: macOS-on-Apple-Silicon `uname -m` reports `arm64` rather than `aarch64` (BSD-derived
// Darwin kernel; documented at https://developer.apple.com/documentation/apple-silicon).
data uname_arm64: UnameArchMapping = UnameArchMapping {
  raw_uname_m_output: "arm64",
  canonical: Aarch64
}

data uname_arch_mapping_table: List<UnameArchMapping> = [
  uname_x86_64,
  uname_amd64,
  uname_aarch64,
  uname_arm64
]


// Anchor: POSIX `uname -s` returns the kernel name string. Darwin = macOS family; Linux = Linux
// kernel; CYGWIN_*/MINGW64_*/MSYS_* prefixes appear on Windows-under-Unix-emulators but
// install.sh's Windows path is PowerShell, not uname.
type UnameOsMapping {
  raw_uname_s_output: String
  canonical: OperatingSystem
}

data uname_s_linux: UnameOsMapping = UnameOsMapping {
  raw_uname_s_output: "Linux",
  canonical: Linux
}

data uname_s_darwin: UnameOsMapping = UnameOsMapping {
  raw_uname_s_output: "Darwin",
  canonical: Macos
}

data uname_os_mapping_table: List<UnameOsMapping> = [
  uname_s_linux,
  uname_s_darwin
]


// Anchor: https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/set_1.
// $env:PROCESSOR_ARCHITECTURE values are AMD64 / ARM64 / x86 (closed set per Windows ABI docs).
type PowerShellArchMapping {
  raw_processor_architecture_value: String
  canonical: Architecture
}

data ps_amd64: PowerShellArchMapping = PowerShellArchMapping {
  raw_processor_architecture_value: "AMD64",
  canonical: X86_64
}

data ps_arm64: PowerShellArchMapping = PowerShellArchMapping {
  raw_processor_architecture_value: "ARM64",
  canonical: Aarch64
}

// 32-bit Windows hosts. gunbc does not currently ship an x86-Windows InstallTarget (no tier1/
// tier2 32-bit MSVC release in src/v2/std/target_triple.dag), but closing the PowerShell ABI
// set here keeps the detection table faithful to Windows ABI docs (Practice 1 / P3 — every
// documented external value has a substrate row). Install-channel selection downstream maps
// X86 hosts to a fail-closed "unsupported architecture" diagnostic rather than fabricating an
// aarch64/x86_64 fallback.
data ps_x86: PowerShellArchMapping = PowerShellArchMapping {
  raw_processor_architecture_value: "x86",
  canonical: X86
}

data powershell_arch_mapping_table: List<PowerShellArchMapping> = [
  ps_amd64,
  ps_arm64,
  ps_x86
]


// Anchor: gunb-ai/the-gunbai understanding/platform.rs documents the macOS `arm64 → aarch64`
// normalization as a sed expression. Modeled here as data because the shell expression is the
// concrete projection install.sh emits; downstream shell-emit lenses consume this rather than
// hand-authoring the sed pipeline.
// 🟡 needs-more-work — feature:shell-static-platform-normalize-emit — bind install.sh shell-static
// projection (Phase 1 deliverable) · dissolve-on: install.sh is projected from a typed shell AST
// (ShellStatic emit gate) that consumes UnameArchMapping directly; the literal shell expression
// here disappears in favor of structural projection from the mapping table.
data normalize_uname_m_for_rust_triple_shell_expr: String = "$(uname -m | sed 's/arm64/aarch64/')"


// Documented assumptions install.sh / install.ps1 inherit from this detection model. Each is a
// closed-fact carrier (not a free-form note) so downstream consumers can pattern-match.
type DetectionAssumption {
  identity: String
  description: String
}

data assumption_libc_unobservable_from_uname: DetectionAssumption = DetectionAssumption {
  identity: "libc_unobservable_from_uname",
  description: "uname -m / uname -s do not report libc family; install.sh defaults to musl because the Phase 1 build matrix is musl-only. Glibc Linux selection requires a separate probe (ldd --version) when the build matrix extends."
}

data assumption_wsl_reports_linux: DetectionAssumption = DetectionAssumption {
  identity: "wsl_reports_linux",
  description: "uname -s under WSL2 reports Linux; the Windows host is invisible at this layer. install.sh treats WSL hosts as Linux targets (correct for cargo / native binaries)."
}

data assumption_container_drift_invisible: DetectionAssumption = DetectionAssumption {
  identity: "container_drift_invisible",
  description: "uname reports the kernel arch, not the container image arch; on cross-arch emulated containers (qemu-user-static) the values may not match the runtime arch the binary will execute under."
}

data platform_detection_assumptions: List<DetectionAssumption> = [
  assumption_libc_unobservable_from_uname,
  assumption_wsl_reports_linux,
  assumption_container_drift_invisible
]
