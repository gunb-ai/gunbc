module v2.extdeps.runtimes.effect_io_host_grant


data effect_io_host_grant_note: String = "P-B/P-C effect-io host grant authority (docs/plans/effect-namespace-grants.md 6): the Envelope is the SINGLE per-grant authority for both reach (admit_effect wall) and transport-vs-replay (covering_grant binding). Mode maps to bindings ONCE at runtime construction (effect_io_host_envelope) and dispatch NEVER re-reads ExecutionMode (design line 27, 62 — P-C: 'select handler bindings per grant instead of per-process mode'). A WET runtime carries RealTransport-bound Read+Write grants on the declared backend subtree (frame-wide real ownership — any locator under it permitted by construction); a HERMETIC runtime carries a Replay-bound Read grant and ZERO Write grants (reads served from fixtures, writes refused by absence, fail-closed). EffectIoResourceLocator carries its backend plus content-Hash identity; write admission projects that evidence onto the locator backend's cited namespace. A caller presenting an envelope for a different backend therefore lands outside its grants and is refused by the same EffectRequest AccessPolicy — no consumer-authored decision seam. FRONTIER (operator-approved 2026-07-22): the Replay grant's fixture_store String is declared (effect_io_host_replay_fixture) but the runtime resolves the actual fixture STORE from the still-passed fixture object — the per-grant store-string resolution is a follow-on. The seed eval_service_op transport selection stays on per-process ExecutionMode on its own declared frontier (v1_interpreter.rs, dissolution-triggered)."

data effect_io_host_frame: std.materialization_ladder.Frame = std.materialization_ladder.Frame {
  name: "effect-io-host",
  kind: SharedStateFrame
}

data effect_io_host_http_authority: String = "effect-io.local"

data effect_io_host_storage_service: String = "effect-io-storage"

// FileResourceBackend projects onto CodeNameTree as the interim namespace home for the content-addressed effect-io file store — Hash identity is not a code name, but CodeNameTree keeps backends disjoint under position_under until a dedicated content-addressed NamespaceTree variant is grounded.
data effect_io_host_replay_fixture: String = "effect-io-host-replay"

fn effect_io_host_backend_root(backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend) -> std.effect_grant.NamespacePosition {
  match backend {
    FileResourceBackend =>
      std.effect_grant.NamespacePosition {
        tree: CodeNameTree,
        path: ["effect-io", "file"]
      }
    HttpResourceBackend =>
      std.effect_grant.NamespacePosition {
        tree: UriTree,
        path: [effect_io_host_http_authority]
      }
    StorageResourceBackend =>
      std.effect_grant.NamespacePosition {
        tree: std.effect_grant.ServiceOpTree { service: effect_io_host_storage_service },
        path: [effect_io_host_storage_service]
      }
  }
}

fn effect_io_host_locator_position(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator
) -> std.effect_grant.NamespacePosition {
  match backend {
    FileResourceBackend =>
      std.effect_grant.NamespacePosition {
        tree: CodeNameTree,
        path: ["effect-io", "file", locator.identity]
      }
    HttpResourceBackend =>
      std.effect_grant.NamespacePosition {
        tree: UriTree,
        path: [effect_io_host_http_authority, locator.identity]
      }
    StorageResourceBackend =>
      std.effect_grant.NamespacePosition {
        tree: std.effect_grant.ServiceOpTree { service: effect_io_host_storage_service },
        path: [effect_io_host_storage_service, locator.identity]
      }
  }
}

fn effect_io_host_hermetic_envelope(backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend) -> std.effect_grant.Envelope {
  std.effect_grant.Envelope {
    frame: effect_io_host_frame,
    grants: [
      std.effect_grant.Grant {
        verb: Read,
        root: effect_io_host_backend_root(backend: backend),
        binding: std.effect_grant.Replay { fixture_store: effect_io_host_replay_fixture },
        lifecycle: LifecycleByConvention
      },
    ]
  }
}

fn effect_io_host_wet_envelope(backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend) -> std.effect_grant.Envelope {
  std.effect_grant.Envelope {
    frame: effect_io_host_frame,
    grants: [
      std.effect_grant.Grant {
        verb: Read,
        root: effect_io_host_backend_root(backend: backend),
        binding: RealTransport,
        lifecycle: LifecycleByConvention
      },
      std.effect_grant.Grant {
        verb: Write,
        root: effect_io_host_backend_root(backend: backend),
        binding: RealTransport,
        lifecycle: LifecycleByConvention
      },
    ]
  }
}

fn effect_io_host_envelope(
  mode: std.execution_mode.ExecutionMode,
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend
) -> std.effect_grant.Envelope {
  if execution_mode_is_wet_dispatch(mode: mode) {
    effect_io_host_wet_envelope(backend: backend)
  } else {
    effect_io_host_hermetic_envelope(backend: backend)
  }
}

fn effect_io_host_write_admissible(
  env: std.effect_grant.Envelope,
  locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator
) -> std.access.AccessDecision {
  admit_effect(
    env: env,
    verb: Write,
    target: effect_io_host_locator_position(backend: locator.backend, locator: locator)
  )
}
