module v2.extdeps.runtimes.v2_effect_io_host

import v2.extdeps.file_system { Filesystem, ModeledFileEffects }
import v2.extdeps.runtimes.v2_effect_io_pure {
  EffectIoFixtureStore,
  EffectIoResourceBackend,
  EffectIoResourceLocator,
  FileResourceBackend,
  HttpResourceBackend,
  StorageResourceBackend,
  effect_io_pure_empty_fixture_store,
  effect_io_pure_invoke_handler,
  effect_io_pure_locator_from_args,
  effect_io_pure_operation_node,
  effect_io_pure_store_lookup,
  effect_io_pure_write_payload_from_args
}
import v2.std.execution_mode {
  ExecutionMode,
  Hermetic,
  execution_mode_is_hermetic
}
import v2.std.collection { Absent, List, Map }
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  None,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  node_locus,
  outcome_rejected
}
import v2.std.network { UriAuthority, UriHost, rfc3986_host_abnf }
import v2.std.node { Symbol }
import v2.std.runtime {
  EffectHandler,
  EffectHandlerBinding,
  EffectRequest,
  RuntimeValue
}
import v2.std.witness { Holds, Violates }

type EffectIoHostFileContext {
  filesystem: Filesystem
  effects: ModeledFileEffects
}

type EffectIoHostHttpContext {
  authority: UriAuthority
}

type EffectIoHostStorageContext {
  bucket: Symbol
}

type EffectIoHostBackendContext
  = HostFileContext { context: EffectIoHostFileContext }
  | HostHttpContext { context: EffectIoHostHttpContext }
  | HostStorageContext { context: EffectIoHostStorageContext }

type EffectIoHostHandlerBundle {
  declared_backend: EffectIoResourceBackend
  backend_context: EffectIoHostBackendContext
  mode: ExecutionMode
  fixture: EffectIoFixtureStore
  handlers: EffectHandlerBinding
}

type V4EffectIoHostRuntime {
  bundle_identity: Symbol
  declared_backend: EffectIoResourceBackend
  backend_context: EffectIoHostBackendContext
  mode: ExecutionMode
  fixture_store: EffectIoFixtureStore
  handlers: EffectHandlerBinding
}

fn effect_io_host_deferred_diagnostic(reason: Symbol) -> Diagnostic {
  Diagnostic {
    reason: reason,
    at: node_locus(node: effect_io_pure_operation_node()),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn effect_io_host_file_read(
  _ctx: EffectIoHostFileContext,
  _locator: EffectIoResourceLocator
) -> Outcome<RuntimeValue> {
  outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_file_read_deferred))
}

fn effect_io_host_file_write(
  _ctx: EffectIoHostFileContext,
  _locator: EffectIoResourceLocator,
  _payload: RuntimeValue
) -> Outcome<RuntimeValue> {
  outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_file_write_deferred))
}

fn effect_io_host_http_read(
  _ctx: EffectIoHostHttpContext,
  _locator: EffectIoResourceLocator
) -> Outcome<RuntimeValue> {
  outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_http_read_deferred))
}

fn effect_io_host_http_write(
  _ctx: EffectIoHostHttpContext,
  _locator: EffectIoResourceLocator,
  _payload: RuntimeValue
) -> Outcome<RuntimeValue> {
  outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_http_write_deferred))
}

fn effect_io_host_storage_read(
  _ctx: EffectIoHostStorageContext,
  _locator: EffectIoResourceLocator
) -> Outcome<RuntimeValue> {
  outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_storage_read_deferred))
}

fn effect_io_host_storage_write(
  _ctx: EffectIoHostStorageContext,
  _locator: EffectIoResourceLocator,
  _payload: RuntimeValue
) -> Outcome<RuntimeValue> {
  outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_storage_write_deferred))
}

fn effect_io_host_dispatch_read(
  backend: EffectIoResourceBackend,
  host_ctx: EffectIoHostBackendContext,
  mode: ExecutionMode,
  fixture: EffectIoFixtureStore,
  request: EffectRequest
) -> Outcome<RuntimeValue> {
  match effect_io_pure_locator_from_args(backend: backend, args: request.arguments) {
    Holds { value: locator } =>
      if execution_mode_is_hermetic(mode: mode) {
        effect_io_pure_store_lookup(store: fixture, locator: locator)
      } else {
        match host_ctx {
          HostFileContext { context: ctx } =>
            effect_io_host_file_read(ctx: ctx, locator: locator)
          HostHttpContext { context: ctx } =>
            effect_io_host_http_read(ctx: ctx, locator: locator)
          HostStorageContext { context: ctx } =>
            effect_io_host_storage_read(ctx: ctx, locator: locator)
        }
      }
    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn effect_io_host_dispatch_write(
  backend: EffectIoResourceBackend,
  host_ctx: EffectIoHostBackendContext,
  mode: ExecutionMode,
  request: EffectRequest
) -> Outcome<RuntimeValue> {
  match effect_io_pure_locator_from_args(backend: backend, args: request.arguments) {
    Holds { value: locator } =>
      match effect_io_pure_write_payload_from_args(args: request.arguments) {
        Holds { value: payload } =>
          if execution_mode_is_hermetic(mode: mode) {
            outcome_rejected(
              d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_hermetic_write_rejected)
            )
          } else {
            match host_ctx {
              HostFileContext { context: ctx } =>
                effect_io_host_file_write(ctx: ctx, locator: locator, payload: payload)
              HostHttpContext { context: ctx } =>
                effect_io_host_http_write(ctx: ctx, locator: locator, payload: payload)
              HostStorageContext { context: ctx } =>
                effect_io_host_storage_write(ctx: ctx, locator: locator, payload: payload)
            }
          }
        Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
      }
    Violates { diagnostic: d } => Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn effect_io_host_handler_binding(
  backend: EffectIoResourceBackend,
  host_ctx: EffectIoHostBackendContext,
  mode: ExecutionMode,
  fixture: EffectIoFixtureStore
) -> EffectIoHostHandlerBundle {
  EffectIoHostHandlerBundle {
    declared_backend: backend,
    backend_context: host_ctx,
    mode: mode,
    fixture: fixture,
    handlers: EffectHandlerBinding {
      read_resource: EffectHandler {
        handle: fn(request) {
          effect_io_host_dispatch_read(
            backend: backend,
            host_ctx: host_ctx,
            mode: mode,
            fixture: fixture,
            request: request
          )
        }
      },
      write_resource: EffectHandler {
        handle: fn(request) {
          effect_io_host_dispatch_write(
            backend: backend,
            host_ctx: host_ctx,
            mode: mode,
            request: request
          )
        }
      }
    }
  }
}

data effect_io_host_placeholder_filesystem: Filesystem = Filesystem {}

data effect_io_host_placeholder_file_effects: ModeledFileEffects = ModeledFileEffects {
  file_read: fn(_) {
    outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_file_read_deferred))
  },
  file_write: fn(_) {
    outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_file_write_deferred))
  }
}

data effect_io_host_file_context: EffectIoHostFileContext = EffectIoHostFileContext {
  filesystem: effect_io_host_placeholder_filesystem,
  effects: effect_io_host_placeholder_file_effects
}

data effect_io_host_http_context: EffectIoHostHttpContext = EffectIoHostHttpContext {
  authority: UriAuthority {
    userinfo: Absent,
    host: UriHost {
      spelling: "effect-io.local",
      grammar: rfc3986_host_abnf
    },
    port: Absent
  }
}

data effect_io_host_storage_context: EffectIoHostStorageContext = EffectIoHostStorageContext {
  bucket: ^effect_io_host_storage_bucket
}

fn effect_io_host_backend_context(backend: EffectIoResourceBackend) -> EffectIoHostBackendContext {
  match backend {
    FileResourceBackend =>
      HostFileContext { context: effect_io_host_file_context }
    HttpResourceBackend =>
      HostHttpContext { context: effect_io_host_http_context }
    StorageResourceBackend =>
      HostStorageContext { context: effect_io_host_storage_context }
  }
}

fn effect_io_host_runtime(
  backend: EffectIoResourceBackend,
  mode: ExecutionMode,
  fixture: EffectIoFixtureStore
) -> V4EffectIoHostRuntime {
  let host_ctx = effect_io_host_backend_context(backend: backend)
  let bundle = effect_io_host_handler_binding(
    backend: backend,
    host_ctx: host_ctx,
    mode: mode,
    fixture: fixture
  )
  V4EffectIoHostRuntime {
    bundle_identity: ^v2_effect_io_host_runtime_id,
    declared_backend: bundle.declared_backend,
    backend_context: bundle.backend_context,
    mode: bundle.mode,
    fixture_store: bundle.fixture,
    handlers: bundle.handlers
  }
}

fn effect_io_host_runtime_wave2(backend: EffectIoResourceBackend) -> V4EffectIoHostRuntime {
  effect_io_host_runtime(
    backend: backend,
    mode: Hermetic,
    fixture: effect_io_pure_empty_fixture_store(backend: backend)
  )
}
