module v2.extdeps.runtimes.v2_effect_io_host


type EffectIoHostFileContext {
  filesystem: v2.extdeps.file_system.Filesystem
  effects: v2.extdeps.file_system.ModeledFileEffects
}

type EffectIoHostHttpContext {
  authority: v2.std.network.UriAuthority
}

type EffectIoHostStorageContext {
  bucket: v2.std.node.Symbol
}

type EffectIoHostBackendContext
  = HostFileContext { context: EffectIoHostFileContext }
  | HostHttpContext { context: EffectIoHostHttpContext }
  | HostStorageContext { context: EffectIoHostStorageContext }

type EffectIoHostHandlerBundle {
  declared_backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend
  backend_context: EffectIoHostBackendContext
  mode: std.execution_mode.ExecutionMode
  envelope: std.effect_grant.Envelope
  fixture: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore
  handlers: v2.std.runtime.EffectHandlerBinding
}

type V4EffectIoHostRuntime {
  bundle_identity: v2.std.node.Symbol
  declared_backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend
  backend_context: EffectIoHostBackendContext
  mode: std.execution_mode.ExecutionMode
  envelope: std.effect_grant.Envelope
  fixture_store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore
  handlers: v2.std.runtime.EffectHandlerBinding
}

data effect_io_host_read_dispatch_note: String = "P-C per-grant binding (docs/plans/effect-namespace-grants.md line 62): read dispatch selects real-transport vs replay by the COVERING Read grant's HandlerBinding (covering_grant), NOT by re-reading the per-process ExecutionMode. Mode is consumed exactly once, at envelope construction (effect_io_host_envelope), where it picks the wet (RealTransport) or hermetic (Replay) preset; from there the envelope's grants are the sole authority (§3). An uncovered read is a located refusal (NoCoveringGrant -> effect_io_host_read_outside_grant), fail-closed. FRONTIER (operator-approved 2026-07-22): the Replay grant carries a fixture_store String identity, but the replay handler still resolves the concrete store from the passed EffectIoFixtureStore object rather than from that String -- the per-grant store-string resolution is the declared follow-on."

fn effect_io_host_write_outside_grant_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^effect_io_host_write_outside_grant,
    at: v2.std.diagnostic.node_locus(node: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_operation_node()),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn effect_io_host_read_outside_grant_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^effect_io_host_read_outside_grant,
    at: v2.std.diagnostic.node_locus(node: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_operation_node()),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn effect_io_host_deferred_diagnostic(reason: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: reason,
    at: v2.std.diagnostic.node_locus(node: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_operation_node()),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn effect_io_host_file_read(
  _ctx: EffectIoHostFileContext,
  _locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_file_read_deferred))
}

fn effect_io_host_file_write(
  _ctx: EffectIoHostFileContext,
  _locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator,
  _payload: v2.std.runtime.RuntimeValue
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_file_write_deferred))
}

fn effect_io_host_http_read(
  _ctx: EffectIoHostHttpContext,
  _locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_http_read_deferred))
}

fn effect_io_host_http_write(
  _ctx: EffectIoHostHttpContext,
  _locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator,
  _payload: v2.std.runtime.RuntimeValue
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_http_write_deferred))
}

fn effect_io_host_storage_read(
  _ctx: EffectIoHostStorageContext,
  _locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_storage_read_deferred))
}

fn effect_io_host_storage_write(
  _ctx: EffectIoHostStorageContext,
  _locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator,
  _payload: v2.std.runtime.RuntimeValue
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_storage_write_deferred))
}

fn effect_io_host_dispatch_read(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  host_ctx: EffectIoHostBackendContext,
  read_envelope: std.effect_grant.Envelope,
  fixture: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore,
  request: v2.std.runtime.EffectRequest
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_locator_from_args(backend: backend, args: request.arguments) {
    v2.std.witness.Holds { value: locator } =>
      match std.effect_grant.covering_grant(
        env: read_envelope,
        verb: std.effect_grant.Read,
        target: v2.extdeps.runtimes.effect_io_host_grant.effect_io_host_locator_position(backend: backend, locator: locator)
      ) {
        std.effect_grant.CoveredBy { grant: g } =>
          match g.binding {
            std.effect_grant.RealTransport =>
              match host_ctx {
                HostFileContext { context: ctx } =>
                  effect_io_host_file_read(ctx: ctx, locator: locator)
                HostHttpContext { context: ctx } =>
                  effect_io_host_http_read(ctx: ctx, locator: locator)
                HostStorageContext { context: ctx } =>
                  effect_io_host_storage_read(ctx: ctx, locator: locator)
              }
            std.effect_grant.Replay { fixture_store: s } =>
              v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_store_lookup(store: fixture, locator: locator)
          }
        std.effect_grant.NoCoveringGrant { verb: v, target: t, frame: f } =>
          v2.std.diagnostic.outcome_rejected(d: effect_io_host_read_outside_grant_diagnostic())
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: d) }
  }
}

fn effect_io_host_dispatch_write(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  host_ctx: EffectIoHostBackendContext,
  write_envelope: std.effect_grant.Envelope,
  request: v2.std.runtime.EffectRequest
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_locator_from_args(backend: backend, args: request.arguments) {
    v2.std.witness.Holds { value: locator } =>
      match v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_write_payload_from_args(args: request.arguments) {
        v2.std.witness.Holds { value: payload } =>
          match v2.extdeps.runtimes.effect_io_host_grant.effect_io_host_write_admissible(
            env: write_envelope,
            locator: locator
          ) {
            std.access.Deny { refusal: refusal } =>
              v2.std.diagnostic.outcome_rejected(d: effect_io_host_write_outside_grant_diagnostic())
            std.access.Permit =>
              match host_ctx {
                HostFileContext { context: ctx } =>
                  effect_io_host_file_write(ctx: ctx, locator: locator, payload: payload)
                HostHttpContext { context: ctx } =>
                  effect_io_host_http_write(ctx: ctx, locator: locator, payload: payload)
                HostStorageContext { context: ctx } =>
                  effect_io_host_storage_write(ctx: ctx, locator: locator, payload: payload)
              }
          }
        v2.std.witness.Violates { diagnostic: d } => v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: d) }
      }
    v2.std.witness.Violates { diagnostic: d } => v2.std.diagnostic.Rejected { diagnostics: v2.std.diagnostic.diagnostics_singleton(d: d) }
  }
}

fn effect_io_host_handler_binding(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  host_ctx: EffectIoHostBackendContext,
  mode: std.execution_mode.ExecutionMode,
  fixture: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore
) -> EffectIoHostHandlerBundle {
  let envelope = v2.extdeps.runtimes.effect_io_host_grant.effect_io_host_envelope(mode: mode, backend: backend)
  EffectIoHostHandlerBundle {
    declared_backend: backend,
    backend_context: host_ctx,
    mode: mode,
    envelope: envelope,
    fixture: fixture,
    handlers: v2.std.runtime.EffectHandlerBinding {
      read_resource: v2.std.runtime.EffectHandler {
        handle: fn(request) {
          effect_io_host_dispatch_read(
            backend: backend,
            host_ctx: host_ctx,
            read_envelope: envelope,
            fixture: fixture,
            request: request
          )
        }
      },
      write_resource: v2.std.runtime.EffectHandler {
        handle: fn(request) {
          effect_io_host_dispatch_write(
            backend: backend,
            host_ctx: host_ctx,
            write_envelope: envelope,
            request: request
          )
        }
      }
    }
  }
}

data effect_io_host_placeholder_filesystem: v2.extdeps.file_system.Filesystem = v2.extdeps.file_system.Filesystem {}

data effect_io_host_placeholder_file_effects: v2.extdeps.file_system.ModeledFileEffects = v2.extdeps.file_system.ModeledFileEffects {
  file_read: fn(_) {
    v2.std.diagnostic.outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_file_read_deferred))
  },
  file_write: fn(_) {
    v2.std.diagnostic.outcome_rejected(d: effect_io_host_deferred_diagnostic(reason: ^effect_io_host_file_write_deferred))
  }
}

data effect_io_host_file_context: EffectIoHostFileContext = EffectIoHostFileContext {
  filesystem: effect_io_host_placeholder_filesystem,
  effects: effect_io_host_placeholder_file_effects
}

data effect_io_host_http_context: EffectIoHostHttpContext = EffectIoHostHttpContext {
  authority: v2.std.network.UriAuthority {
    userinfo: v2.std.collection.Absent,
    host: v2.std.network.UriHost {
      spelling: "effect-io.local",
      grammar: v2.std.network.rfc3986_host_abnf
    },
    port: v2.std.collection.Absent
  }
}

data effect_io_host_storage_context: EffectIoHostStorageContext = EffectIoHostStorageContext {
  bucket: ^effect_io_host_storage_bucket
}

fn effect_io_host_backend_context(backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend) -> EffectIoHostBackendContext {
  match backend {
    v2.extdeps.runtimes.v2_effect_io_pure.FileResourceBackend =>
      HostFileContext { context: effect_io_host_file_context }
    v2.extdeps.runtimes.v2_effect_io_pure.HttpResourceBackend =>
      HostHttpContext { context: effect_io_host_http_context }
    v2.extdeps.runtimes.v2_effect_io_pure.StorageResourceBackend =>
      HostStorageContext { context: effect_io_host_storage_context }
  }
}

fn effect_io_host_runtime(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  mode: std.execution_mode.ExecutionMode,
  fixture: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore
) -> V4EffectIoHostRuntime {
  let host_ctx = effect_io_host_backend_context(backend: backend)
  let bundle = effect_io_host_handler_binding(
    backend: backend,
    host_ctx: host_ctx,
    mode: mode,
    fixture: fixture
  )
  V4EffectIoHostRuntime {
    bundle_identity: ^v2_effect_io_host_runtime_id,
    declared_backend: bundle.declared_backend,
    backend_context: bundle.backend_context,
    mode: bundle.mode,
    envelope: bundle.envelope,
    fixture_store: bundle.fixture,
    handlers: bundle.handlers
  }
}

fn effect_io_host_runtime_hermetic(backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend) -> V4EffectIoHostRuntime {
  effect_io_host_runtime(
    backend: backend,
    mode: std.execution_mode.Hermetic,
    fixture: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_empty_fixture_store(backend: backend)
  )
}
