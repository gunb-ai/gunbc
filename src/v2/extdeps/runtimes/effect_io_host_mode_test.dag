module v2.test.runtimes.effect_io_host_mode


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = SubstrateInputsOnly

fn mode_resource_arg(bytes: List<Byte>) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: effect_io_pure_unit_type_node(),
      bytes: bytes
    }
  }
}

fn mode_resource_a() -> v2.std.runtime.RuntimeValue {
  mode_resource_arg(bytes: [])
}

fn mode_resource_b() -> v2.std.runtime.RuntimeValue {
  mode_resource_arg(bytes: [Byte { bits: [true] }])
}

fn mode_payload() -> v2.std.runtime.RuntimeValue {
  mode_resource_arg(bytes: [Byte { bits: [true] }, Byte { bits: [false] }])
}

fn mode_populated_http_fixture() -> v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore {
  let store0 = effect_io_pure_empty_fixture_store(backend: HttpResourceBackend)
  match effect_io_pure_locator_from_args(backend: HttpResourceBackend, args: [mode_resource_a()]) {
    Holds { value: locator } =>
      effect_io_pure_apply_write(store: store0, locator: locator, payload: mode_payload())
    Violates { diagnostic: _ } => store0
  }
}

fn mode_host_read(runtime: v2.extdeps.runtimes.v2_effect_io_host.V4EffectIoHostRuntime, arg: v2.std.runtime.RuntimeValue) -> Outcome<v2.std.runtime.RuntimeValue> {
  let handler = effect_handler_for_kind(binding: runtime.handlers, kind: ReadResource)
  effect_io_pure_invoke_handler(handler: handler, request: effect_io_pure_read_request(args: [arg]))
}

test fn effect_io_host_hermetic_replay_hit_holds() -> Bool {
  let runtime = effect_io_host_runtime(
    backend: HttpResourceBackend,
    mode: Hermetic,
    fixture: mode_populated_http_fixture()
  )
  match mode_host_read(runtime: runtime, arg: mode_resource_a()) {
    Accepted { value: v, diagnostics: None } => v == mode_payload()
    Rejected { diagnostics: _ } => false
  }
}

test fn effect_io_host_hermetic_miss_fail_closed_holds() -> Bool {
  let runtime = effect_io_host_runtime(
    backend: HttpResourceBackend,
    mode: Hermetic,
    fixture: mode_populated_http_fixture()
  )
  match mode_host_read(runtime: runtime, arg: mode_resource_b()) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn effect_io_host_wet_does_not_replay_holds() -> Bool {
  let runtime = effect_io_host_runtime(
    backend: HttpResourceBackend,
    mode: Wet,
    fixture: mode_populated_http_fixture()
  )
  match mode_host_read(runtime: runtime, arg: mode_resource_a()) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

test fn effect_io_host_hermetic_write_fail_closed_holds() -> Bool {
  let runtime = effect_io_host_runtime(
    backend: HttpResourceBackend,
    mode: Hermetic,
    fixture: mode_populated_http_fixture()
  )
  let handler = effect_handler_for_kind(binding: runtime.handlers, kind: WriteResource)
  match effect_io_pure_invoke_handler(
    handler: handler,
    request: effect_io_pure_write_request(args: [mode_resource_b(), mode_payload()])
  ) {
    Rejected { diagnostics: d } => d.head.reason == ^effect_io_host_write_outside_grant
    Accepted { value: _, diagnostics: _ } => false
  }
}
