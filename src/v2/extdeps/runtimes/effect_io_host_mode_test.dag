module v2.test.runtimes.effect_io_host_mode


data live_tree_disposition: v2.std.live_tree.LiveTreeDisposition = v2.std.live_tree.SubstrateInputsOnly

fn mode_resource_arg(bytes: List<v2.std.machine.Byte>) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_unit_type_node(),
      bytes: bytes
    }
  }
}

fn mode_resource_a() -> v2.std.runtime.RuntimeValue {
  mode_resource_arg(bytes: [])
}

fn mode_resource_b() -> v2.std.runtime.RuntimeValue {
  mode_resource_arg(bytes: [v2.std.machine.Byte { bits: [true] }])
}

fn mode_payload() -> v2.std.runtime.RuntimeValue {
  mode_resource_arg(bytes: [v2.std.machine.Byte { bits: [true] }, v2.std.machine.Byte { bits: [false] }])
}

fn mode_populated_http_fixture() -> v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore {
  let store0 = v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_empty_fixture_store(backend: v2.extdeps.runtimes.v2_effect_io_pure.HttpResourceBackend)
  match v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_locator_from_args(backend: v2.extdeps.runtimes.v2_effect_io_pure.HttpResourceBackend, args: [mode_resource_a()]) {
    v2.std.witness.Holds { value: locator } =>
      v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_apply_write(store: store0, locator: locator, payload: mode_payload())
    v2.std.witness.Violates { diagnostic: _ } => store0
  }
}

fn mode_host_read(runtime: v2.extdeps.runtimes.v2_effect_io_host.V4EffectIoHostRuntime, arg: v2.std.runtime.RuntimeValue) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  let handler = v2.std.runtime.effect_handler_for_kind(binding: runtime.handlers, kind: v2.std.runtime.ReadResource)
  v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_invoke_handler(handler: handler, request: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_read_request(args: [arg]))
}

test fn effect_io_host_hermetic_replay_hit_holds() -> Bool {
  let runtime = v2.extdeps.runtimes.v2_effect_io_host.effect_io_host_runtime(
    backend: v2.extdeps.runtimes.v2_effect_io_pure.HttpResourceBackend,
    mode: std.execution_mode.Hermetic,
    fixture: mode_populated_http_fixture()
  )
  match mode_host_read(runtime: runtime, arg: mode_resource_a()) {
    v2.std.diagnostic.Accepted { value: v, diagnostics: v2.std.diagnostic.None } => v == mode_payload()
    v2.std.diagnostic.Rejected { diagnostics: _ } => false
  }
}

test fn effect_io_host_hermetic_miss_fail_closed_holds() -> Bool {
  let runtime = v2.extdeps.runtimes.v2_effect_io_host.effect_io_host_runtime(
    backend: v2.extdeps.runtimes.v2_effect_io_pure.HttpResourceBackend,
    mode: std.execution_mode.Hermetic,
    fixture: mode_populated_http_fixture()
  )
  match mode_host_read(runtime: runtime, arg: mode_resource_b()) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}

test fn effect_io_host_wet_does_not_replay_holds() -> Bool {
  let runtime = v2.extdeps.runtimes.v2_effect_io_host.effect_io_host_runtime(
    backend: v2.extdeps.runtimes.v2_effect_io_pure.HttpResourceBackend,
    mode: std.execution_mode.Wet,
    fixture: mode_populated_http_fixture()
  )
  match mode_host_read(runtime: runtime, arg: mode_resource_a()) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => true
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}

test fn effect_io_host_hermetic_write_fail_closed_holds() -> Bool {
  let runtime = v2.extdeps.runtimes.v2_effect_io_host.effect_io_host_runtime(
    backend: v2.extdeps.runtimes.v2_effect_io_pure.HttpResourceBackend,
    mode: std.execution_mode.Hermetic,
    fixture: mode_populated_http_fixture()
  )
  let handler = v2.std.runtime.effect_handler_for_kind(binding: runtime.handlers, kind: v2.std.runtime.WriteResource)
  match v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_invoke_handler(
    handler: handler,
    request: v2.extdeps.runtimes.v2_effect_io_pure.effect_io_pure_write_request(args: [mode_resource_b(), mode_payload()])
  ) {
    v2.std.diagnostic.Rejected { diagnostics: d } => d.head.reason == ^effect_io_host_write_outside_grant
    v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => false
  }
}
