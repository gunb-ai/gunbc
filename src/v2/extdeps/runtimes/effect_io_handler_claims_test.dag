// Scope: Wave-2 M-E2 gate — per-backend ReadResource→WriteResource round-trip via
//   EffectHandlerBinding dispatch + M5 fixture-store consolidation (node://adhoc-7e32be31-47c):
//   executing witnesses that the in-process fixture key is now value-derived (content-addressed),
//   discriminating (distinct resources → distinct keys; RED if reverted to the constant pin),
//   fail-closed on unrepresentable locators, and that an absent lookup is a kernel Miss.
// Status: E-10 consumer for v2.extdeps.runtimes.v2_effect_io_{pure,host}.dag.

module v2.test.runtimes.effect_io_handler_claims

import v2.extdeps.runtimes.v2_effect_io_host {
  HostHttpContext,
  effect_io_host_runtime_wave2
}
import v2.extdeps.runtimes.v2_effect_io_pure {
  EffectIoResourceBackend,
  FileResourceBackend,
  HttpResourceBackend,
  StorageResourceBackend,
  effect_io_pure_empty_fixture_store,
  effect_io_pure_handler_binding,
  effect_io_pure_invoke_handler,
  effect_io_pure_locator_identity,
  effect_io_pure_read_request,
  effect_io_pure_read_write_roundtrip,
  effect_io_pure_unit_type_node
}
import v2.std.algebra { Cons, Empty }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.machine { Byte }
import v2.std.node { Hash }
import v2.std.runtime {
  ReadResource,
  RuntimePrimitive,
  RuntimePrimitiveValue,
  RuntimeUnit,
  RuntimeUnitValue,
  RuntimeValue,
  effect_handler_for_kind
}
import v2.std.witness { Holds, Violates }

// --- representable resource locators (RuntimePrimitive reifies faithfully; distinct bytes →
//     distinct content_hash) and one unrepresentable locator (RuntimeUnit → fail-closed) ---------

fn effect_io_claim_resource_arg(bytes: List<Byte>) -> RuntimeValue {
  RuntimePrimitive {
    value: RuntimePrimitiveValue {
      primitive_type: effect_io_pure_unit_type_node(),
      bytes: bytes
    }
  }
}

fn effect_io_claim_resource_a() -> RuntimeValue {
  effect_io_claim_resource_arg(bytes: [])
}

fn effect_io_claim_resource_b() -> RuntimeValue {
  effect_io_claim_resource_arg(bytes: [Byte { bits: [true] }])
}

// No faithful Node reification (RuntimeUnit) — the value-derived key MUST fail closed on it.
fn effect_io_claim_unrepresentable_arg() -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue {
      unit_type: effect_io_pure_unit_type_node()
    }
  }
}

fn effect_io_claim_payload() -> RuntimeValue {
  RuntimeUnit {
    value: RuntimeUnitValue {
      unit_type: effect_io_pure_unit_type_node()
    }
  }
}

// --- Wave-2: per-backend binding-dispatch round-trip, now over a content-addressed key ----------
// The write then read-back hit through the SAME value-derived key (no constant-pin coincidence).

test fn effect_io_pure_file_roundtrip_holds() -> Bool {
  effect_io_pure_read_write_roundtrip(
    backend: FileResourceBackend,
    payload: effect_io_claim_payload(),
    locator_arg: effect_io_claim_resource_a()
  )
}

test fn effect_io_pure_http_roundtrip_holds() -> Bool {
  effect_io_pure_read_write_roundtrip(
    backend: HttpResourceBackend,
    payload: effect_io_claim_payload(),
    locator_arg: effect_io_claim_resource_a()
  )
}

test fn effect_io_pure_storage_roundtrip_holds() -> Bool {
  effect_io_pure_read_write_roundtrip(
    backend: StorageResourceBackend,
    payload: effect_io_claim_payload(),
    locator_arg: effect_io_claim_resource_a()
  )
}

// --- M5 convergence proof, by execution -----------------------------------------------------------
//
// DISCRIMINATING: distinct resource locators derive DISTINCT content-addressed keys (RED if the
// derivation is reverted to the ^effect_io_pure_default_locator constant pin, which aliases them),
// and the SAME resource derives the SAME key (determinism — what makes a read-back hit possible).
// This is the executing witness that the in-process handler is now ContentAddressedByValue.
test fn effect_io_pure_value_derived_key_discriminates_holds() -> Bool {
  match effect_io_pure_locator_identity(value: effect_io_claim_resource_a()) {
    Holds { value: key_a } =>
      match effect_io_pure_locator_identity(value: effect_io_claim_resource_b()) {
        Holds { value: key_b } =>
          match effect_io_pure_locator_identity(value: effect_io_claim_resource_a()) {
            Holds { value: key_a_again } =>
              !(key_a == key_b) && (key_a == key_a_again)
            Violates { diagnostic: _ } => false
          }
        Violates { diagnostic: _ } => false
      }
    Violates { diagnostic: _ } => false
  }
}

// FAIL-CLOSED: a locator with no faithful Node reification is a LOUD reject, never a silent alias
// onto a shared key (DESIGN.md §5). RED if the derivation fabricated a key for an unrepresentable arg.
test fn effect_io_pure_unrepresentable_locator_fails_closed_holds() -> Bool {
  match effect_io_pure_locator_identity(value: effect_io_claim_unrepresentable_arg()) {
    Violates { diagnostic: _ } => true
    Holds { value: _ } => false
  }
}

// KERNEL MISS: a content-addressed read against an empty store rejects (the shared
// CacheLookupResult Miss → MissIsDiagnostic), never fabricates a value.
test fn effect_io_pure_absent_lookup_is_kernel_miss_holds() -> Bool {
  let store = effect_io_pure_empty_fixture_store(backend: FileResourceBackend)
  let bundle = effect_io_pure_handler_binding(store: store)
  let read_handler = effect_handler_for_kind(binding: bundle.handlers, kind: ReadResource)
  let read_args = Cons { head: effect_io_claim_resource_a(), tail: Empty }
  match effect_io_pure_invoke_handler(
    handler: read_handler,
    request: effect_io_pure_read_request(args: read_args)
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

// --- host bundle: dispatch through EffectHandlerBinding; HTTP host door fail-closed until host_run ---

// Representable locator so the reject is the HOST-DOOR deferral, not a locator-formation fault.
test fn effect_io_host_read_fail_closed_holds() -> Bool {
  let runtime = effect_io_host_runtime_wave2(backend: FileResourceBackend)
  let read_args = Cons {
    head: effect_io_claim_resource_a(),
    tail: Empty
  }
  let read_handler = effect_handler_for_kind(binding: runtime.handlers, kind: ReadResource)
  match effect_io_pure_invoke_handler(
    handler: read_handler,
    request: effect_io_pure_read_request(args: read_args)
  ) {
    Rejected { diagnostics: _ } => true
    Accepted { value: _, diagnostics: _ } => false
  }
}

// Discriminating: HTTP runtime wires HttpResourceBackend + HostHttpContext (not file defaults).
test fn effect_io_host_http_backend_routes_http_holds() -> Bool {
  let runtime = effect_io_host_runtime_wave2(backend: HttpResourceBackend)
  match runtime.declared_backend {
    HttpResourceBackend =>
      match runtime.backend_context {
        HostHttpContext { context: _ } => true
        _ => false
      }
    _ => false
  }
}
