module v2.extdeps.runtimes.v2_effect_io_pure


type EffectIoResourceBackend
  = FileResourceBackend
  | HttpResourceBackend
  | StorageResourceBackend

type EffectIoResourceLocator {
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend
  identity: v2.std.node.Hash
}

type EffectIoFixtureStore {
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend
  entries: Map<v2.std.node.Hash, v2.std.runtime.RuntimeValue>
}

type EffectIoPureHandlerBundle {
  fixture_store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore
  handlers: v2.std.runtime.EffectHandlerBinding
}

type V4EffectIoPureRuntime {
  bundle_identity: v2.std.node.Symbol
  declared_backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend
  fixture_store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore
  handlers: v2.std.runtime.EffectHandlerBinding
}

fn effect_io_pure_unit_type_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^effect_io_pure_unit_type } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn effect_io_pure_operation_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^effect_io_pure_operation } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn effect_io_pure_effect_signature_node() -> Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^effect_io_pure_effect_signature } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn effect_io_pure_operation_ref() -> v2.std.model_core.PrimitiveOperationRef {
  v2.std.model_core.PrimitiveOperationRef {
    operation: effect_io_pure_operation_node(),
    effect_signature: v2.std.model_core.EffectSignature {
      signature: effect_io_pure_effect_signature_node()
    }
  }
}

fn effect_io_pure_empty_environment() -> v2.std.runtime.EvaluationEnvironment {
  v2.std.runtime.EvaluationEnvironment {
    bindings: std.types.Map {
      lookup: fn(_) {
        Absent
      }
    }
  }
}

fn effect_io_pure_empty_frame() -> v2.std.runtime.EvaluationFrame {
  v2.std.runtime.EvaluationFrame {
    current: effect_io_pure_unit_type_node(),
    environment: effect_io_pure_empty_environment()
  }
}

fn effect_io_pure_args_absent_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^effect_io_pure_args_absent,
    at: node_locus(node: effect_io_pure_operation_node()),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn effect_io_pure_locator_from_args(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  args: List<v2.std.runtime.RuntimeValue>
) -> v2.std.witness.Witness<v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator> {
  match list_nth(xs: args, wanted: 0, absent: effect_io_pure_args_absent_diagnostic()) {
    Holds { value: locator_value } =>
      match effect_io_pure_locator_identity(value: locator_value) {
        Holds { value: digest } =>
          v2.std.witness.Holds {
            value: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator {
              backend: backend,
              identity: digest
            }
          }
        Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn effect_io_pure_locator_unrepresentable_diagnostic() -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^effect_io_pure_locator_unrepresentable,
    at: node_locus(node: effect_io_pure_operation_node()),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn effect_io_pure_locator_identity(value: v2.std.runtime.RuntimeValue) -> v2.std.witness.Witness<v2.std.node.Hash> {
  match runtime_value_node_projection(value: value) {
    RuntimeValueNodeProjected { node: reified } =>
      v2.std.witness.Holds { value: content_hash(n: reified) }
    RuntimeValueNodeUnrepresentable =>
      v2.std.witness.Violates { diagnostic: effect_io_pure_locator_unrepresentable_diagnostic() }
  }
}

fn effect_io_pure_write_payload_from_args(args: List<v2.std.runtime.RuntimeValue>) -> v2.std.witness.Witness<v2.std.runtime.RuntimeValue> {
  match list_nth(xs: args, wanted: 1, absent: effect_io_pure_args_absent_diagnostic()) {
    Holds { value: payload } => v2.std.witness.Holds { value: payload }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn effect_io_pure_backends_match(
  left: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  right: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend
) -> Bool {
  match left {
    FileResourceBackend =>
      match right {
        FileResourceBackend => true
        _ => false
      }
    HttpResourceBackend =>
      match right {
        HttpResourceBackend => true
        _ => false
      }
    StorageResourceBackend =>
      match right {
        StorageResourceBackend => true
        _ => false
      }
  }
}

fn effect_io_pure_store_lookup(
  store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore,
  locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if effect_io_pure_backends_match(left: locator.backend, right: store.backend) {
    match map_get(m: store.entries, key: locator.identity) {
      Accepted { value: opt, diagnostics: None } =>
        match opt {
          Present { value: payload } =>
            v2.std.diagnostic.Accepted { value: payload, diagnostics: v2.std.diagnostic.None }
          Absent =>
            outcome_rejected(
              d: v2.std.diagnostic.Diagnostic {
                reason: ^effect_io_pure_resource_absent,
                at: node_locus(node: effect_io_pure_operation_node()),
                correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
              }
            )
        }
      Rejected { diagnostics: ds } => v2.std.diagnostic.Rejected { diagnostics: ds }
    }
  } else {
    outcome_rejected(
      d: v2.std.diagnostic.Diagnostic {
        reason: ^effect_io_pure_backend_mismatch,
        at: node_locus(node: effect_io_pure_operation_node()),
        correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
      }
    )
  }
}

fn effect_io_pure_handle_read(
  store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore,
  request: v2.std.runtime.EffectRequest
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match effect_io_pure_locator_from_args(backend: store.backend, args: request.arguments) {
    Holds { value: locator } => effect_io_pure_store_lookup(store: store, locator: locator)
    Violates { diagnostic: d } => v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn effect_io_pure_handle_write(
  store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore,
  request: v2.std.runtime.EffectRequest
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match effect_io_pure_locator_from_args(backend: store.backend, args: request.arguments) {
    Holds { value: locator } =>
      match effect_io_pure_write_payload_from_args(args: request.arguments) {
        Holds { value: payload } =>
          if effect_io_pure_backends_match(left: locator.backend, right: store.backend) {
            v2.std.diagnostic.Accepted { value: payload, diagnostics: v2.std.diagnostic.None }
          } else {
            outcome_rejected(
              d: v2.std.diagnostic.Diagnostic {
                reason: ^effect_io_pure_backend_mismatch,
                at: node_locus(node: effect_io_pure_operation_node()),
                correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
              }
            )
          }
        Violates { diagnostic: d } => v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
      }
    Violates { diagnostic: d } => v2.std.diagnostic.Rejected { diagnostics: diagnostics_singleton(d: d) }
  }
}

fn effect_io_pure_invoke_handler(
  handler: v2.std.runtime.EffectHandler,
  request: v2.std.runtime.EffectRequest
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match handler {
    EffectHandler { handle: h } => h(request)
  }
}

fn effect_io_pure_handler_binding(store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore) -> v2.extdeps.runtimes.v2_effect_io_pure.EffectIoPureHandlerBundle {
  EffectIoPureHandlerBundle {
    fixture_store: store,
    handlers: v2.std.runtime.EffectHandlerBinding {
      read_resource: v2.std.runtime.EffectHandler {
        handle: fn(request) {
          effect_io_pure_handle_read(store: store, request: request)
        }
      },
      write_resource: v2.std.runtime.EffectHandler {
        handle: fn(request) {
          effect_io_pure_handle_write(store: store, request: request)
        }
      }
    }
  }
}

fn effect_io_pure_fixture_store(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  entries: Map<v2.std.node.Hash, v2.std.runtime.RuntimeValue>
) -> v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore {
  EffectIoFixtureStore {
    backend: backend,
    entries: entries
  }
}

fn effect_io_pure_empty_fixture_store(backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend) -> v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore {
  effect_io_pure_fixture_store(backend: backend, entries: empty_map())
}

fn effect_io_pure_request(
  kind: v2.std.runtime.EffectRequestKind,
  args: List<v2.std.runtime.RuntimeValue>
) -> v2.std.runtime.EffectRequest {
  v2.std.runtime.EffectRequest {
    kind: kind,
    operation: effect_io_pure_operation_ref(),
    arguments: args,
    continuation: effect_io_pure_empty_frame()
  }
}

fn effect_io_pure_read_request(args: List<v2.std.runtime.RuntimeValue>) -> v2.std.runtime.EffectRequest {
  effect_io_pure_request(kind: ReadResource, args: args)
}

fn effect_io_pure_write_request(args: List<v2.std.runtime.RuntimeValue>) -> v2.std.runtime.EffectRequest {
  effect_io_pure_request(kind: WriteResource, args: args)
}

fn effect_io_pure_append_receipt(
  log: v2.std.runtime.EffectReceiptLog,
  request: v2.std.runtime.EffectRequest,
  result: v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue>
) -> v2.std.runtime.EffectReceiptLog {
  v2.std.runtime.EffectReceiptLog {
    entries: std.algebra.Cons {
      head: v2.std.runtime.EffectReceipt { request: request, result: result },
      tail: log.entries
    }
  }
}

fn effect_io_pure_runtime(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore
) -> v2.extdeps.runtimes.v2_effect_io_pure.V4EffectIoPureRuntime {
  let bundle = effect_io_pure_handler_binding(store: store)
  V4EffectIoPureRuntime {
    bundle_identity: ^v2_effect_io_pure_runtime_id,
    declared_backend: backend,
    fixture_store: bundle.fixture_store,
    handlers: bundle.handlers
  }
}

fn effect_io_pure_runtime_from_backend(backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend) -> v2.extdeps.runtimes.v2_effect_io_pure.V4EffectIoPureRuntime {
  effect_io_pure_runtime(
    backend: backend,
    store: effect_io_pure_empty_fixture_store(backend: backend)
  )
}

fn effect_io_pure_apply_write(
  store: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore,
  locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator,
  payload: v2.std.runtime.RuntimeValue
) -> v2.extdeps.runtimes.v2_effect_io_pure.EffectIoFixtureStore {
  EffectIoFixtureStore {
    backend: store.backend,
    entries: map_insert(m: store.entries, key: locator.identity, value: payload)
  }
}

fn effect_io_pure_read_write_roundtrip(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  payload: v2.std.runtime.RuntimeValue,
  locator_arg: v2.std.runtime.RuntimeValue
) -> Bool {
  match effect_io_pure_locator_from_args(
    backend: backend,
    args: std.algebra.Cons { head: locator_arg, tail: std.algebra.Empty }
  ) {
    Holds { value: locator } =>
      effect_io_pure_roundtrip_through_store(
        backend: backend,
        locator: locator,
        payload: payload,
        locator_arg: locator_arg
      )
    Violates { diagnostic: _ } => false
  }
}

fn effect_io_pure_roundtrip_through_store(
  backend: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceBackend,
  locator: v2.extdeps.runtimes.v2_effect_io_pure.EffectIoResourceLocator,
  payload: v2.std.runtime.RuntimeValue,
  locator_arg: v2.std.runtime.RuntimeValue
) -> Bool {
  let store0 = effect_io_pure_empty_fixture_store(backend: backend)
  let bundle0 = effect_io_pure_handler_binding(store: store0)
  let write_args = std.algebra.Cons { head: locator_arg, tail: std.algebra.Cons { head: payload, tail: std.algebra.Empty } }
  let write_request = effect_io_pure_write_request(args: write_args)
  let write_handler = effect_handler_for_kind(binding: bundle0.handlers, kind: WriteResource)
  match effect_io_pure_invoke_handler(handler: write_handler, request: write_request) {
    Accepted { value: written, diagnostics: None } =>
      if written == payload {
        let store1 = effect_io_pure_apply_write(
          store: store0,
          locator: locator,
          payload: written
        )
        let bundle1 = effect_io_pure_handler_binding(store: store1)
        let read_args = std.algebra.Cons { head: locator_arg, tail: std.algebra.Empty }
        let read_request = effect_io_pure_read_request(args: read_args)
        let read_handler = effect_handler_for_kind(binding: bundle1.handlers, kind: ReadResource)
        match effect_io_pure_invoke_handler(handler: read_handler, request: read_request) {
          Accepted { value: read_back, diagnostics: None } => read_back == written
          _ => false
        }
      } else {
        false
      }
    _ => false
  }
}
