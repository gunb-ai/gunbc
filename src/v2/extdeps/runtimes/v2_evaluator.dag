module v2.extdeps.runtimes.v2_evaluator

type V4EvaluatorRuntime {
  runtime_identity: v2.std.node.Symbol
  core: v2.std.model_core.ModelCore
  values: v2.std.runtime.ValueRepresentationModel
  execution: v2.std.runtime.ExecutionSemantics
  boundary: v2.std.runtime.ResourceEffectBoundary
}

fn v2_eval_unit_type_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^v2_eval_unit_type_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

data v2_eval_bool_literal_pin: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^v2_eval_bool_literal_symbol } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data v2_eval_unit_literal_pin: v2.std.node.Node = v2_eval_unit_type_node()

fn v2_eval_bool_true_byte() -> std.bit.Byte {
  std.bit.Byte { bits: [true] }
}

fn v2_eval_bool_true_primitive() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2_eval_bool_literal_pin,
      bytes: [v2_eval_bool_true_byte()]
    }
  }
}

fn v2_eval_unit_runtime_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeUnit {
    value: v2.std.runtime.RuntimeUnitValue {
      unit_type: v2_eval_unit_literal_pin
    }
  }
}

fn v2_eval_boundary_operation_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^v2_eval_boundary_operation_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn v2_eval_effect_signature_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^v2_eval_boundary_effect_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn v2_eval_runtime_diagnostic(node: v2.std.node.Node) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: ^v2_eval_semantics_deferred,
    at: v2.std.diagnostic.node_locus(node: node),
    correction: v2.std.diagnostic.Unavailable { reason: ExternalContractUnknown }
  }
}

fn v2_eval_binding_lookup_miss(_key: v2.std.runtime.EnvironmentBindingKey) -> v2.std.witness.Witness<v2.std.runtime.RuntimeValue> {
  v2.std.witness.Violates {
    diagnostic: v2.std.diagnostic.Diagnostic {
      reason: ^v2_eval_binding_miss,
      at: v2.std.diagnostic.port_locus(port: ^v2_eval_binding_miss),
      correction: v2.std.diagnostic.Unavailable { reason: AmbiguousIntent }
    }
  }
}

fn v2_eval_empty_bindings() -> std.types.Map<v2.std.runtime.EnvironmentBindingKey, v2.std.runtime.RuntimeValue> {
  std.types.Map {
    lookup: v2_eval_binding_lookup_miss
  }
}

fn v2_eval_empty_environment() -> v2.std.runtime.EvaluationEnvironment {
  v2.std.runtime.EvaluationEnvironment {
    bindings: v2_eval_empty_bindings()
  }
}

fn v2_eval_empty_frame() -> v2.std.runtime.EvaluationFrame {
  v2.std.runtime.EvaluationFrame {
    current: v2_eval_unit_type_node(),
    environment: v2_eval_empty_environment()
  }
}

fn v2_eval_int_type_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^dag_binding_type_int } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn v2_eval_int_runtime_value(value: Int) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2_eval_int_type_node(),
      bytes: v2.std.integer.integer_int_to_signed_i32_le_bytes(value: value)
    }
  }
}

fn v2_eval_bool_runtime_value(is_true: Bool) -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: v2_eval_bool_literal_pin,
      bytes: if is_true {
        [std.bit.Byte { bits: [true, false, false, false, false, false, false, false] }]
      } else {
        [std.bit.Byte { bits: [false, false, false, false, false, false, false, false] }]
      }
    }
  }
}

// 🟢 Terminal (FLAG D): v2_eval_is_literal_shaped_node is the sole admission predicate for eval_type_node_atom Atom literal-vs-binding dispatch; v2_eval_represent_literal routes through it before allocate dispatch — one surface, not a parallel entry guard. Atom rows project dag_node_is_eval_literal_atom (dag.dag single authority); magnitudes are supplied by the interpretation algebra allocate_literal hook, not by this runtime. Non-Atom TypeNodes (Conj record/variant constructs) route to allocate_literal in eval_type_node_atom directly.
fn v2_eval_is_literal_shaped_node(node: v2.std.node.Node) -> Bool {
  if node == v2_eval_bool_literal_pin {
    true
  } else if node == v2_eval_unit_literal_pin {
    true
  } else if v2.extdeps.languages.dag.dag_node_is_eval_literal_atom(node: node) {
    true
  } else {
    false
  }
}

fn v2_eval_represent_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if !v2_eval_is_literal_shaped_node(node: node) {
    v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
  } else if node == v2_eval_bool_literal_pin {
    v2.std.diagnostic.outcome_accepted(value: v2_eval_bool_runtime_value(is_true: true))
  } else if node == v2_eval_unit_literal_pin {
    v2.std.diagnostic.outcome_accepted(value: v2_eval_unit_runtime_value())
  } else if v2.extdeps.languages.dag.dag_node_is_int_literal_atom(node: node) {
    v2.std.diagnostic.bind_outcome(
      o: v2.extdeps.languages.dag.dag_int_literal_magnitude_int_from_node(node: node),
      f: fn(value) {
        v2.std.diagnostic.outcome_accepted(value: v2_eval_int_runtime_value(value: value))
      }
    )
  } else {
    match node.kind {
      TypeNode { connective: Atom { identity: id } } =>
        if id == ^dag_token_kw_true {
          v2.std.diagnostic.outcome_accepted(value: v2_eval_bool_runtime_value(is_true: true))
        } else if id == ^dag_token_kw_false {
          v2.std.diagnostic.outcome_accepted(value: v2_eval_bool_runtime_value(is_true: false))
        } else {
          v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
        }
      _ => v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
    }
  }
}

fn v2_eval_represent_result(value: v2.std.runtime.RuntimeValue) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: value, diagnostics: v2.std.diagnostic.None }
}

fn v2_eval_allocate_literal(node: v2.std.node.Node, env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if node == v2_eval_bool_literal_pin {
    v2.std.diagnostic.Accepted { value: v2_eval_bool_true_primitive(), diagnostics: v2.std.diagnostic.None }
  } else if node == v2_eval_unit_literal_pin {
    v2.std.diagnostic.Accepted { value: v2_eval_unit_runtime_value(), diagnostics: v2.std.diagnostic.None }
  } else {
    v2_eval_represent_literal(node: node, env: env)
  }
}

fn v2_eval_runtime_value_as_int(value: v2.std.runtime.RuntimeValue) -> v2.std.diagnostic.Outcome<Int> {
  match value {
    RuntimePrimitive { value: gunbc.plans.md_helpers.p } =>
      if p.primitive_type == v2_eval_int_type_node() {
        v2.std.integer.integer_signed_i32_le_bytes_to_int(bytes: p.bytes)
      } else {
        v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: p.primitive_type))
      }
    _ => v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: v2_eval_int_type_node()))
  }
}

data v2_eval_runtime_bool_predicate_dissolution_note: String = "🟡 dissolve-on: v2_eval_runtime_bool_is_true and v2_eval_runtime_bool_is_false are coproduct RuntimeValue→Bool predicates (RuntimePrimitive bool-literal pin, one arm true / others false) — parallel to lazy_arm_runtime_bool_true/false in branch_lazy_arm_eval_acceptance_test.dag; NFR roster listing alone is not a predicate-dissolution receipt. DISSOLVES WHEN std/runtime carries canonical RuntimeValue bool decode/eq (single authority for branch condition discrimination) and v2_evaluator branch dispatch routes through it instead of hand-rolled byte probes."

fn v2_eval_runtime_bool_is_true(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: gunbc.plans.md_helpers.p } =>
      if p.primitive_type == v2_eval_bool_literal_pin {
        match v2.std.collection.list_at_optional(xs: p.bytes, index: 0) {
          Present { value: b } => v2.std.integer.integer_byte_bit_at(b: b, shift: 0) == 1
          Absent => false
        }
      } else {
        false
      }
    _ => false
  }
}

fn v2_eval_runtime_bool_is_false(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: gunbc.plans.md_helpers.p } =>
      p.primitive_type == v2_eval_bool_literal_pin && !v2_eval_runtime_bool_is_true(value: value)
    _ => false
  }
}

fn v2_eval_nth_child_target(node: v2.std.node.Node, wanted: Int) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match v2.std.collection.list_at_optional(xs: node.children, index: wanted) {
    Present { value: child } =>
      match child {
        v2.std.node.Edge { label: _, target: extdeps.vendor.arm.arm } =>
          v2.std.diagnostic.outcome_accepted(value: extdeps.vendor.arm.arm)
      }
    Absent =>
      v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
  }
}

fn v2_eval_transform_is_int_add(node: v2.std.node.Node) -> Bool {
  match v2.std.collection.list_at_optional(xs: v2.std.node_query.node_positional_child_targets(node: node), index: 0) {
    Present { value: op_node } =>
      match op_node.kind {
        TypeNode { connective: Atom { identity: id } } =>
          id == ^dag_token_plus
            || v2.std.compilers.target_model.canonical_operation_wire_matches_operation(
              wire: op_node,
              operation: v2.std.compilers.target_model.canonical_operation_op_add()
            )
        _ => false
      }
    Absent => false
  }
}


fn v2_eval_call_primitive(
  node: v2.std.node.Node,
  args: std.types.List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if v2_eval_transform_is_int_add(node: node) {
    if count(args) == 2 {
      match v2.std.collection.list_at_optional(xs: args, index: 0) {
        Present { value: left } =>
          match v2.std.collection.list_at_optional(xs: args, index: 1) {
            Present { value: right } =>
              v2.std.diagnostic.bind_outcome(
                o: v2_eval_runtime_value_as_int(value: left),
                f: fn(l) {
                  v2.std.diagnostic.bind_outcome(
                    o: v2_eval_runtime_value_as_int(value: right),
                    f: fn(r) {
                      v2.std.diagnostic.outcome_accepted(
                        value: v2_eval_int_runtime_value(value: v2.std.integer.int_add(a: l, b: r))
                      )
                    }
                  )
                }
              )
            Absent =>
              v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
          }
        Absent =>
          v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
      }
    } else {
      v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
    }
  } else {
    v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
  }
}

fn v2_eval_choose_branch(
  node: v2.std.node.Node,
  condition: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if count(node.children) == 3 {
    if v2_eval_runtime_bool_is_true(value: condition) {
      v2_eval_nth_child_target(node: node, wanted: 1)
    } else if v2_eval_runtime_bool_is_false(value: condition) {
      v2_eval_nth_child_target(node: node, wanted: 2)
    } else {
      v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
    }
  } else {
    v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
  }
}

fn v2_eval_step_loop(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: node))
}

fn v2_eval_bind_value(
  key: v2.std.runtime.EnvironmentBindingKey,
  value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted {
    value: v2.std.runtime.EvaluationEnvironment {
      bindings: v2.std.collection.map_insert(
        m: env.bindings,
        key: key,
        value: value
      )
    },
    diagnostics: v2.std.diagnostic.None
  }
}

fn v2_eval_allocate(value: v2.std.runtime.RuntimeValue) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Accepted { value: value, diagnostics: v2.std.diagnostic.None }
}

fn v2_eval_call(call: v2.std.runtime.EvaluationCall, _frame: v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: call.callee))
}

fn v2_eval_return_value(value: v2.std.runtime.RuntimeValue, _frame: v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Accepted { value: v2.std.runtime.Return { value: value }, diagnostics: v2.std.diagnostic.None }
}

fn v2_eval_transfer(control: v2.std.runtime.ControlTransfer, frame: v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationFrame> {
  match control {
    Continue { value: v } =>
      v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: v2.std.runtime.runtime_value_resolved_type(value: v)))
    Return { value: v } =>
      v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: v2.std.runtime.runtime_value_resolved_type(value: v)))
    Raise { diagnostic: d } =>
      v2.std.diagnostic.outcome_rejected(d: d)
    Suspend { continuation: c } =>
      v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: c.current))
  }
}

fn v2_eval_terminal_value(control: v2.std.runtime.ControlTransfer, frame: v2.std.runtime.EvaluationFrame) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  match control {
    Continue { value: v } =>
      v2.std.diagnostic.Accepted { value: v, diagnostics: v2.std.diagnostic.None }
    Return { value: v } =>
      v2.std.diagnostic.Accepted { value: v, diagnostics: v2.std.diagnostic.None }
    Raise { diagnostic: d } =>
      v2.std.diagnostic.outcome_rejected(d: d)
    Suspend { continuation: c } =>
      v2.std.diagnostic.outcome_rejected(d: v2_eval_runtime_diagnostic(node: c.current))
  }
}

fn v2_eval_boundary_allowance(allowed: Bool) -> v2.std.runtime.BoundaryAllowance {
  v2.std.runtime.BoundaryAllowance {
    operation: v2.std.model_core.PrimitiveOperationRef {
      operation: v2_eval_boundary_operation_node(),
      effect_signature: v2.std.model_core.EffectSignature {
        signature: v2_eval_effect_signature_node()
      }
    },
    resource: v2.std.model_core.ResourceAccess {
      resource: v2_eval_boundary_operation_node()
    },
    allowed: allowed
  }
}

fn v2_eval_resource_boundary() -> v2.std.runtime.ResourceEffectBoundary {
  v2.std.runtime.ResourceEffectBoundary {
    ffi: v2_eval_boundary_allowance(allowed: false),
    exceptions: v2_eval_boundary_allowance(allowed: false),
    async: v2_eval_boundary_allowance(allowed: false),
    concurrency: v2_eval_boundary_allowance(allowed: false),
    identity_reference: v2_eval_boundary_allowance(allowed: false)
  }
}

fn v2_evaluator_model_core() -> v2.std.model_core.ModelCore {
  v2.std.model_core.bool_model_core()
}

fn v2_evaluator_value_representation() -> v2.std.runtime.ValueRepresentationModel {
  v2.std.runtime.ValueRepresentationModel {
    represent_literal: v2_eval_represent_literal,
    represent_result: v2_eval_represent_result
  }
}

fn v2_evaluator_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter {
      allocate_literal: v2_eval_allocate_literal,
      identity: ^v2_eval_allocate_literal
    },
    transform: v2.std.runtime.TransformInterpreter {
      call_primitive: v2_eval_call_primitive,
      identity: ^v2_eval_call_primitive
    },
    branch: v2.std.runtime.BranchInterpreter {
      choose_branch: v2_eval_choose_branch,
      identity: ^v2_eval_choose_branch
    },
    loop: v2.std.runtime.LoopInterpreter {
      step_loop: v2_eval_step_loop,
      identity: ^v2_eval_step_loop
    },
    bind: v2.std.runtime.BindInterpreter {
      bind_value: v2_eval_bind_value,
      identity: ^v2_eval_bind_value
    },
    match: v2.std.runtime.MatchInterpreter {
      choose_arm: v2.std.runtime.runtime_reject_match_arm,
      identity: ^v2.std.runtime.runtime_reject_match_arm    }
  }
}

fn v2_evaluator_interpretation_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^v2_eval_allocate_literal,
    call_primitive: ^v2_eval_call_primitive,
    choose_branch: ^v2_eval_choose_branch,
    step_loop: ^v2_eval_step_loop,
    bind_value: ^v2_eval_bind_value,    choose_arm: ^v2.std.runtime.runtime_reject_match_arm
  }
}

fn v2_evaluator_execution() -> v2.std.runtime.ExecutionSemantics {
  v2.std.runtime.ExecutionSemantics {
    allocation: v2.std.runtime.AllocationSemantics {
      allocate: v2_eval_allocate
    },
    calls: v2.std.runtime.CallSemantics {
      call: v2_eval_call,
      return_value: v2_eval_return_value
    },
    control: v2.std.runtime.ControlSemantics {
      transfer: v2_eval_transfer,
      terminal_value: v2_eval_terminal_value
    }
  }
}

fn v2_evaluator_boundary() -> v2.std.runtime.ResourceEffectBoundary {
  v2_eval_resource_boundary()
}

fn v2_evaluator_runtime() -> V4EvaluatorRuntime {
  V4EvaluatorRuntime {
    runtime_identity: ^v2_evaluator_runtime_id,
    core: v2_evaluator_model_core(),
    values: v2_evaluator_value_representation(),
    execution: v2_evaluator_execution(),
    boundary: v2_evaluator_boundary()
  }
}
