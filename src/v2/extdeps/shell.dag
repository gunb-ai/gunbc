// src/v2/extdeps/shell.dag — v2 overlay for extdeps.shell (slice 3 migration).
//
// Same module name as dsl/extdeps/shell/shell.dag so Wet dispatch is unchanged.
// Intentionally omits std.types (FilePath/NonEmptyStr) so co-rooted v2 transports
// that also pull v2.compiler.emit do not transitively load dsl/std.algebra and
// collide with v2.std.algebra's FreeMonoid coproduct. Indexed after dsl/ in
// witness_layer_roots so this row wins on module-path overlay.

module extdeps.shell

service shell.Exec {
  operation Run {
    input { script: String }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["sh", "-c", "{script}"] }
    exit {
      0 => Unit
      nonzero => String "Script failed"
    }
    mock_response {
      0 => { exit_code: 0, exit_success: true, stdout: "(mock)", stderr: "" } "Mock shell execution"
    }
  }
}
