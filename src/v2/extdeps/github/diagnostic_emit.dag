module v2.extdeps.github.diagnostic_emit


fn gha_severity_command(severity: v2.std.diagnostic.DiagnosticSeverity) -> String {
  match severity {
    SeverityError => extdeps.github.log_annotations.gha_log_command_error
    SeverityWarning => extdeps.github.log_annotations.gha_log_command_warning
  }
}

fn emit_directive_gha_message(d: v2.std.diagnostic.EmitDirective) -> String {
  concat(
    extdeps.github.log_annotations.gha_message_command_prefix(command: gha_severity_command(severity: d.severity)),
    d.message
  )
}

fn emit_directive_gha_directive(d: v2.std.diagnostic.EmitDirective) -> v2.std.diagnostic.EmitDirective {
  v2.std.diagnostic.EmitDirective { severity: d.severity, message: emit_directive_gha_message(d: d) }
}

fn emit_directive_gha_target_model(d: v2.std.diagnostic.EmitDirective) -> v2.std.compilers.target_model.TargetModel {
  emit_directive_bash_target_model(d: emit_directive_gha_directive(d: d))
}
