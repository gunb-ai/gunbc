fn kotlin_grammar_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  kotlin_atom(id: id)
}

fn kotlin_grammar_nonterminal(production: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Nonterminal { production: production }
}

fn kotlin_grammar_sequence(left: v2.std.grammar.GrammarExpr, right: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Sequence { left: left, right: right }
}

fn kotlin_grammar_choice(left: v2.std.grammar.GrammarExpr, right: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Choice { left: left, right: right }
}

fn kotlin_grammar_optional(element: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.optional.Optional { element: element }
}

fn kotlin_grammar_repeat(element: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Repeat { element: element }
}

fn kotlin_grammar_type_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_terminal(token_class: ^kotlin_token_ident)
}

fn kotlin_grammar_typed_param_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_ident),
    right: kotlin_grammar_sequence(
      left: kotlin_grammar_terminal(token_class: ^kotlin_token_colon),
      right: kotlin_grammar_nonterminal(production: ^kotlin_production_type_expr)
    )
  )
}

fn kotlin_grammar_param_list_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_optional(
    element: kotlin_grammar_sequence(
      left: kotlin_grammar_nonterminal(production: ^kotlin_production_typed_param),
      right: kotlin_grammar_repeat(
        element: kotlin_grammar_sequence(
          left: kotlin_grammar_terminal(token_class: ^kotlin_token_comma),
          right: kotlin_grammar_nonterminal(production: ^kotlin_production_typed_param)
        )
      )
    )
  )
}

fn kotlin_grammar_expr_list_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_optional(
    element: kotlin_grammar_sequence(
      left: kotlin_grammar_nonterminal(production: ^kotlin_production_expr),
      right: kotlin_grammar_repeat(
        element: kotlin_grammar_sequence(
          left: kotlin_grammar_terminal(token_class: ^kotlin_token_comma),
          right: kotlin_grammar_nonterminal(production: ^kotlin_production_expr)
        )
      )
    )
  )
}

fn kotlin_grammar_primary_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_choice(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_ident),
    right: kotlin_grammar_choice(
      left: kotlin_grammar_terminal(token_class: ^kotlin_token_int_literal),
      right: kotlin_grammar_choice(
        left: kotlin_grammar_terminal(token_class: ^kotlin_token_string_literal),
        right: kotlin_grammar_choice(
          left: kotlin_grammar_terminal(token_class: ^kotlin_token_kw_true),
          right: kotlin_grammar_choice(
            left: kotlin_grammar_terminal(token_class: ^kotlin_token_kw_false),
            right: kotlin_grammar_sequence(
              left: kotlin_grammar_terminal(token_class: ^kotlin_token_lparen),
              right: kotlin_grammar_sequence(
                left: kotlin_grammar_nonterminal(production: ^kotlin_production_expr),
                right: kotlin_grammar_terminal(token_class: ^kotlin_token_rparen)
              )
            )
          )
        )
      )
    )
  )
}

fn kotlin_grammar_call_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_nonterminal(production: ^kotlin_production_primary_expr),
    right: kotlin_grammar_repeat(
      element: kotlin_grammar_sequence(
        left: kotlin_grammar_terminal(token_class: ^kotlin_token_lparen),
        right: kotlin_grammar_sequence(
          left: kotlin_grammar_expr_list_expr(),
          right: kotlin_grammar_terminal(token_class: ^kotlin_token_rparen)
        )
      )
    )
  )
}

fn kotlin_grammar_equality_operator_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_choice(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_eq_eq),
    right: kotlin_grammar_terminal(token_class: ^kotlin_token_bang_eq)
  )
}

fn kotlin_grammar_comparison_operator_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_choice(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_lt),
    right: kotlin_grammar_choice(
      left: kotlin_grammar_terminal(token_class: ^kotlin_token_gt),
      right: kotlin_grammar_choice(
        left: kotlin_grammar_terminal(token_class: ^kotlin_token_lt_eq),
        right: kotlin_grammar_terminal(token_class: ^kotlin_token_gt_eq)
      )
    )
  )
}

fn kotlin_grammar_additive_operator_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_choice(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_plus),
    right: kotlin_grammar_terminal(token_class: ^kotlin_token_minus)
  )
}

fn kotlin_grammar_multiplicative_operator_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_choice(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_star),
    right: kotlin_grammar_choice(
      left: kotlin_grammar_terminal(token_class: ^kotlin_token_slash),
      right: kotlin_grammar_terminal(token_class: ^kotlin_token_percent)
    )
  )
}

fn kotlin_grammar_binary_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_nonterminal(production: ^kotlin_production_equality_expr)
}

fn kotlin_grammar_equality_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_nonterminal(production: ^kotlin_production_comparison_expr),
    right: kotlin_grammar_repeat(
      element: kotlin_grammar_sequence(
        left: kotlin_grammar_equality_operator_expr(),
        right: kotlin_grammar_nonterminal(production: ^kotlin_production_comparison_expr)
      )
    )
  )
}

fn kotlin_grammar_comparison_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_nonterminal(production: ^kotlin_production_additive_expr),
    right: kotlin_grammar_repeat(
      element: kotlin_grammar_sequence(
        left: kotlin_grammar_comparison_operator_expr(),
        right: kotlin_grammar_nonterminal(production: ^kotlin_production_additive_expr)
      )
    )
  )
}

fn kotlin_grammar_additive_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_nonterminal(production: ^kotlin_production_multiplicative_expr),
    right: kotlin_grammar_repeat(
      element: kotlin_grammar_sequence(
        left: kotlin_grammar_additive_operator_expr(),
        right: kotlin_grammar_nonterminal(production: ^kotlin_production_multiplicative_expr)
      )
    )
  )
}

fn kotlin_grammar_multiplicative_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_nonterminal(production: ^kotlin_production_call_expr),
    right: kotlin_grammar_repeat(
      element: kotlin_grammar_sequence(
        left: kotlin_grammar_multiplicative_operator_expr(),
        right: kotlin_grammar_nonterminal(production: ^kotlin_production_call_expr)
      )
    )
  )
}

fn kotlin_grammar_expr_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_nonterminal(production: ^kotlin_production_binary_expr)
}

fn kotlin_grammar_return_stmt_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_kw_return),
    right: kotlin_grammar_optional(
      element: kotlin_grammar_nonterminal(production: ^kotlin_production_expr)
    )
  )
}

fn kotlin_grammar_value_stmt_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_choice(
      left: kotlin_grammar_terminal(token_class: ^kotlin_token_kw_val),
      right: kotlin_grammar_terminal(token_class: ^kotlin_token_kw_var)
    ),
    right: kotlin_grammar_sequence(
      left: kotlin_grammar_terminal(token_class: ^kotlin_token_ident),
      right: kotlin_grammar_sequence(
        left: kotlin_grammar_optional(
          element: kotlin_grammar_sequence(
            left: kotlin_grammar_terminal(token_class: ^kotlin_token_colon),
            right: kotlin_grammar_nonterminal(production: ^kotlin_production_type_expr)
          )
        ),
        right: kotlin_grammar_optional(
          element: kotlin_grammar_sequence(
            left: kotlin_grammar_terminal(token_class: ^kotlin_token_equal),
            right: kotlin_grammar_nonterminal(production: ^kotlin_production_expr)
          )
        )
      )
    )
  )
}

fn kotlin_grammar_if_stmt_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_kw_if),
    right: kotlin_grammar_sequence(
      left: kotlin_grammar_terminal(token_class: ^kotlin_token_lparen),
      right: kotlin_grammar_sequence(
        left: kotlin_grammar_nonterminal(production: ^kotlin_production_expr),
        right: kotlin_grammar_sequence(
          left: kotlin_grammar_terminal(token_class: ^kotlin_token_rparen),
          right: kotlin_grammar_sequence(
            left: kotlin_grammar_nonterminal(production: ^kotlin_production_block),
            right: kotlin_grammar_optional(
              element: kotlin_grammar_sequence(
                left: kotlin_grammar_terminal(token_class: ^kotlin_token_kw_else),
                right: kotlin_grammar_choice(
                  left: kotlin_grammar_nonterminal(production: ^kotlin_production_block),
                  right: kotlin_grammar_nonterminal(production: ^kotlin_production_if_stmt)
                )
              )
            )
          )
        )
      )
    )
  )
}

fn kotlin_grammar_while_stmt_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_kw_while),
    right: kotlin_grammar_sequence(
      left: kotlin_grammar_terminal(token_class: ^kotlin_token_lparen),
      right: kotlin_grammar_sequence(
        left: kotlin_grammar_nonterminal(production: ^kotlin_production_expr),
        right: kotlin_grammar_sequence(
          left: kotlin_grammar_terminal(token_class: ^kotlin_token_rparen),
          right: kotlin_grammar_nonterminal(production: ^kotlin_production_block)
        )
      )
    )
  )
}

fn kotlin_grammar_stmt_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_choice(
    left: kotlin_grammar_nonterminal(production: ^kotlin_production_return_stmt),
    right: kotlin_grammar_choice(
      left: kotlin_grammar_nonterminal(production: ^kotlin_production_value_stmt),
      right: kotlin_grammar_choice(
        left: kotlin_grammar_nonterminal(production: ^kotlin_production_if_stmt),
        right: kotlin_grammar_choice(
          left: kotlin_grammar_nonterminal(production: ^kotlin_production_while_stmt),
          right: kotlin_grammar_nonterminal(production: ^kotlin_production_expr)
        )
      )
    )
  )
}

fn kotlin_grammar_stmt_separator_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_choice(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_semicolon),
    right: kotlin_grammar_terminal(token_class: ^kotlin_token_nl)
  )
}

fn kotlin_grammar_stmt_tail_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_stmt_separator_expr(),
    right: kotlin_grammar_nonterminal(production: ^kotlin_production_stmt)
  )
}

fn kotlin_grammar_stmt_list_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_optional(
    element: kotlin_grammar_sequence(
      left: kotlin_grammar_nonterminal(production: ^kotlin_production_stmt),
      right: kotlin_grammar_sequence(
        left: kotlin_grammar_repeat(element: kotlin_grammar_stmt_tail_expr()),
        right: kotlin_grammar_optional(element: kotlin_grammar_stmt_separator_expr())
      )
    )
  )
}

fn kotlin_grammar_block_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_lbrace),
    right: kotlin_grammar_sequence(
      left: kotlin_grammar_stmt_list_expr(),
      right: kotlin_grammar_terminal(token_class: ^kotlin_token_rbrace)
    )
  )
}

fn kotlin_grammar_fn_decl_expr() -> v2.std.grammar.GrammarExpr {
  kotlin_grammar_sequence(
    left: kotlin_grammar_terminal(token_class: ^kotlin_token_kw_fun),
    right: kotlin_grammar_sequence(
      left: kotlin_grammar_terminal(token_class: ^kotlin_token_ident),
      right: kotlin_grammar_sequence(
        left: kotlin_grammar_terminal(token_class: ^kotlin_token_lparen),
        right: kotlin_grammar_sequence(
          left: kotlin_grammar_nonterminal(production: ^kotlin_production_param_list),
          right: kotlin_grammar_sequence(
            left: kotlin_grammar_terminal(token_class: ^kotlin_token_rparen),
            right: kotlin_grammar_sequence(
              left: kotlin_grammar_optional(
                element: kotlin_grammar_sequence(
                  left: kotlin_grammar_terminal(token_class: ^kotlin_token_colon),
                  right: kotlin_grammar_nonterminal(production: ^kotlin_production_type_expr)
                )
              ),
              right: kotlin_grammar_nonterminal(production: ^kotlin_production_block)
            )
          )
        )
      )
    )
  )
}

fn kotlin_grammar_root() -> v2.std.grammar.GrammarRoot {
  let start = kotlin_grammar_production_fn_add()
  let fn_decl = kotlin_grammar_production_fn_decl()
  let typed_param = kotlin_grammar_production_typed_param()
  let param_list = kotlin_grammar_production_param_list()
  let type_expr = kotlin_grammar_production_type_expr()
  let block = kotlin_grammar_production_block()
  let stmt = kotlin_grammar_production_stmt()
  let return_stmt = kotlin_grammar_production_return_stmt()
  let value_stmt = kotlin_grammar_production_value_stmt()
  let if_stmt = kotlin_grammar_production_if_stmt()
  let while_stmt = kotlin_grammar_production_while_stmt()
  let expr = kotlin_grammar_production_expr()
  let binary_expr = kotlin_grammar_production_binary_expr()
  let equality_expr = kotlin_grammar_production_equality_expr()
  let comparison_expr = kotlin_grammar_production_comparison_expr()
  let additive_expr = kotlin_grammar_production_additive_expr()
  let multiplicative_expr = kotlin_grammar_production_multiplicative_expr()
  let call_expr = kotlin_grammar_production_call_expr()
  let primary_expr = kotlin_grammar_production_primary_expr()
  v2.std.grammar.GrammarRoot {
    start: ^kotlin_production_fn_decl,
    productions: [
      start,
      fn_decl,
      typed_param,
      param_list,
      type_expr,
      block,
      stmt,
      return_stmt,
      value_stmt,
      if_stmt,
      while_stmt,
      expr,
      binary_expr,
      equality_expr,
      comparison_expr,
      additive_expr,
      multiplicative_expr,
      call_expr,
      primary_expr
    ],
    sync_tokens: v2.std.grammar.grammar_empty_sync_tokens()
  }
}

fn kotlin_grammar() -> v2.std.grammar.ParseGrammar {
  v2.std.grammar.ModeledGrammar { root: kotlin_grammar_root() }
}

fn kotlin_lex_token_symbol(sym: v2.std.node.Symbol) -> Bool {
  v2.std.compilers.lexing.lex_rule_set_token_class_member(
    rules: kotlin_lex_rules(),
    token_class: sym
  )
}

fn kotlin_language_model_canonical_symbols() -> std.algebra.PointwisePower<v2.std.node.Symbol> {
  std.algebra.PointwisePower {
    member: fn(sym) {
      kotlin_catalog_surface_symbol(sym: sym) ||
        kotlin_lex_token_symbol(sym: sym) ||
        v2.std.grammar.grammar_carries_symbol(grammar: kotlin_grammar(), sym: sym) ||
        sym == ^kotlin_surface_fn_item ||
        sym == ^kotlin_production_fn_add ||
        sym == ^kotlin_source_literal ||
        sym == ^kotlin_emitted_field_binding ||
        sym == ^kotlin_emitted_field_param_type ||
        sym == ^kotlin_emitted_field_signature ||
        sym == ^kotlin_emitted_field_return_expr
    }
  }
}

fn kotlin_model_core() -> v2.std.model_core.ModelCore {
  v2.std.model_core.ModelCore {
    primitives: kotlin_primitive_fact_bundles(),
    inhabitance: kotlin_model_core_inhabitance_decls(),
    laws: [],
    effects: v2.std.model_core.EffectSemanticsDecl { operations: [] },
    partiality: v2.std.model_core.PartialitySemanticsDecl { operations: [] }
  }
}

fn kotlin_language_model() -> v2.std.language_model.LanguageModel {
  v2.std.language_model.LanguageModel {
    lex: kotlin_lex(),
    grammar: kotlin_grammar(),
    language_identity: ^kotlin_language_model_surface_id,
    canonical_symbols: kotlin_language_model_canonical_symbols(),
    core: kotlin_model_core()
  }
}
