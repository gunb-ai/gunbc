module v2.extdeps.languages.kotlin


type KotlinIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64

type KotlinFloatWidth
  = FloatBits32
  | FloatBits64

type KotlinRuntimeRepresentation {}

type KotlinCharacterEncoding
  = Ucs2CodeUnit
  | Ucs2CodeUnitSequence

type KotlinSingletonInhabitance {}

type KotlinControlFlowInhabitance {}

type KotlinFloatValueFormat
  = Ieee754Binary32Precision
  | Ieee754Binary64Precision

type KotlinIntegerOverflowUnspecified {}

type KotlinScalar
  = IntScalar { width: KotlinIntWidth }
  | FloatScalar { width: KotlinFloatWidth }
  | BoolScalar
  | CharScalar
  | StringScalar
  | UnitScalar
  | NothingScalar

type KotlinIntegerPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  width: KotlinIntWidth
  overflow: KotlinIntegerOverflowUnspecified
  representation: KotlinRuntimeRepresentation
}

type KotlinOrderedRingIntWidth
  = OrderedRingBits32
  | OrderedRingBits64

type KotlinOrderedRingIntegerFacts
  = KotlinOrderedRingIntFacts {
      overflow: KotlinIntegerOverflowUnspecified,
      representation: KotlinRuntimeRepresentation
    }
  | KotlinOrderedRingLongFacts {
      overflow: KotlinIntegerOverflowUnspecified,
      representation: KotlinRuntimeRepresentation
    }

type KotlinFloatPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  width: KotlinFloatWidth
  value_format: KotlinFloatValueFormat
  representation: KotlinRuntimeRepresentation
}

type KotlinNonNumericValueFact
  = RuntimeRepresentationFact { representation: KotlinRuntimeRepresentation }
  | CharacterEncodingFact { encoding: KotlinCharacterEncoding }
  | SingletonInhabitanceFact { inhabitance: KotlinSingletonInhabitance }
  | ControlFlowInhabitanceFact { inhabitance: KotlinControlFlowInhabitance }

type KotlinNonNumericPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  scalar: KotlinScalar
  value_fact: KotlinNonNumericValueFact
}

type KotlinGrammarRelationRow {
  head: v2.std.compilers.target_model.ConcreteSyntaxToken
  tail: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
}
fn kotlin_integer_overflow_unspecified_marker() -> KotlinIntegerOverflowUnspecified {
  KotlinIntegerOverflowUnspecified {}
}

fn kotlin_platform_specific_runtime_representation_marker() -> KotlinRuntimeRepresentation {
  KotlinRuntimeRepresentation {}
}

fn kotlin_singleton_object_marker() -> KotlinSingletonInhabitance {
  KotlinSingletonInhabitance {}
}

fn kotlin_uninhabited_control_flow_marker() -> KotlinControlFlowInhabitance {
  KotlinControlFlowInhabitance {}
}

data kotlin_integer_overflow_unspecified: KotlinIntegerOverflowUnspecified = kotlin_integer_overflow_unspecified_marker()
data kotlin_platform_specific_runtime_representation: KotlinRuntimeRepresentation = kotlin_platform_specific_runtime_representation_marker()
data kotlin_singleton_object: KotlinSingletonInhabitance = kotlin_singleton_object_marker()
data kotlin_uninhabited_control_flow: KotlinControlFlowInhabitance = kotlin_uninhabited_control_flow_marker()
data kotlin_facts_byte: KotlinIntegerPrimitiveFacts = KotlinIntegerPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_byte,
  width: Bits8,
  overflow: kotlin_integer_overflow_unspecified,
  representation: kotlin_platform_specific_runtime_representation,
}

data kotlin_facts_short: KotlinIntegerPrimitiveFacts = KotlinIntegerPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_short,
  width: Bits16,
  overflow: kotlin_integer_overflow_unspecified,
  representation: kotlin_platform_specific_runtime_representation,
}

data kotlin_facts_int: KotlinIntegerPrimitiveFacts = KotlinIntegerPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_int,
  width: Bits32,
  overflow: kotlin_integer_overflow_unspecified,
  representation: kotlin_platform_specific_runtime_representation,
}

data kotlin_facts_long: KotlinIntegerPrimitiveFacts = KotlinIntegerPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_long,
  width: Bits64,
  overflow: kotlin_integer_overflow_unspecified,
  representation: kotlin_platform_specific_runtime_representation,
}

data kotlin_facts_float: KotlinFloatPrimitiveFacts = KotlinFloatPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_float,
  width: FloatBits32,
  value_format: Ieee754Binary32Precision,
  representation: kotlin_platform_specific_runtime_representation,
}

data kotlin_facts_double: KotlinFloatPrimitiveFacts = KotlinFloatPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_double,
  width: FloatBits64,
  value_format: Ieee754Binary64Precision,
  representation: kotlin_platform_specific_runtime_representation,
}

data kotlin_facts_boolean: KotlinNonNumericPrimitiveFacts = KotlinNonNumericPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_boolean,
  scalar: BoolScalar,
  value_fact: RuntimeRepresentationFact { representation: kotlin_platform_specific_runtime_representation },
}

data kotlin_facts_char: KotlinNonNumericPrimitiveFacts = KotlinNonNumericPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_char,
  scalar: CharScalar,
  value_fact: CharacterEncodingFact { encoding: Ucs2CodeUnit },
}

data kotlin_facts_string: KotlinNonNumericPrimitiveFacts = KotlinNonNumericPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_string,
  scalar: StringScalar,
  value_fact: CharacterEncodingFact { encoding: Ucs2CodeUnitSequence },
}

data kotlin_facts_unit: KotlinNonNumericPrimitiveFacts = KotlinNonNumericPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_unit,
  scalar: UnitScalar,
  value_fact: SingletonInhabitanceFact { inhabitance: kotlin_singleton_object },
}

data kotlin_facts_nothing: KotlinNonNumericPrimitiveFacts = KotlinNonNumericPrimitiveFacts {
  surface_spelling: ^kotlin_surface_spelling_nothing,
  scalar: NothingScalar,
  value_fact: ControlFlowInhabitanceFact { inhabitance: kotlin_uninhabited_control_flow },
}

data kotlin_integer_facts_catalog: List<KotlinIntegerPrimitiveFacts> = [
  kotlin_facts_byte,
  kotlin_facts_short,
  kotlin_facts_int,
  kotlin_facts_long
]

data kotlin_ordered_ring_facts_int: KotlinOrderedRingIntegerFacts = kotlin_ordered_ring_int_facts()

data kotlin_ordered_ring_facts_long: KotlinOrderedRingIntegerFacts = kotlin_ordered_ring_long_facts()

data kotlin_integer_algebra_inhabitance_facts_catalog: List<KotlinOrderedRingIntegerFacts> = [
  kotlin_ordered_ring_facts_int,
  kotlin_ordered_ring_facts_long
]

data kotlin_float_facts_catalog: List<KotlinFloatPrimitiveFacts> = [
  kotlin_facts_float,
  kotlin_facts_double
]

data kotlin_nonnumeric_facts_catalog: List<KotlinNonNumericPrimitiveFacts> = [
  kotlin_facts_boolean,
  kotlin_facts_char,
  kotlin_facts_string,
  kotlin_facts_unit,
  kotlin_facts_nothing
]

data kotlin_concrete_token_head: v2.std.compilers.target_model.ConcreteSyntaxToken = v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_kw_fun }

fn kotlin_concrete_token_tail() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.BoundToken { token_class: ^kotlin_token_ident, binding: ^kotlin_binding_fn_add },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_lparen },
    v2.std.compilers.target_model.BoundToken { token_class: ^kotlin_token_ident, binding: ^kotlin_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_colon },
    v2.std.compilers.target_model.BoundToken { token_class: ^kotlin_token_ident, binding: ^kotlin_binding_type_int },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_comma },
    v2.std.compilers.target_model.BoundToken { token_class: ^kotlin_token_ident, binding: ^kotlin_binding_param_y },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_colon },
    v2.std.compilers.target_model.BoundToken { token_class: ^kotlin_token_ident, binding: ^kotlin_binding_type_int },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_rparen },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_colon },
    v2.std.compilers.target_model.BoundToken { token_class: ^kotlin_token_ident, binding: ^kotlin_binding_type_int },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_lbrace },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_kw_return },
    v2.std.compilers.target_model.BoundToken { token_class: ^kotlin_token_ident, binding: ^kotlin_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_plus },
    v2.std.compilers.target_model.BoundToken { token_class: ^kotlin_token_ident, binding: ^kotlin_binding_param_y },
    v2.std.compilers.target_model.FixedToken { token_class: ^kotlin_token_rbrace }
  ]
}

fn kotlin_concrete_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  std.algebra.Cons {
    head: kotlin_concrete_token_head,
    tail: kotlin_concrete_token_tail()
  }
}

data kotlin_source_text: String = "fun add(x: Int, y: Int): Int { return x + y }"

data kotlin_bool_grounding: std.algebra.BooleanAlgebra<Bool> = v2.std.logic.bool_boolean_algebra

fn kotlin_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: target }
}

fn kotlin_int_width_node(width: KotlinIntWidth) -> v2.std.node.Node {
  match width {
    Bits8 => kotlin_atom(id: ^kotlin_tag_bits8)
    Bits16 => kotlin_atom(id: ^kotlin_tag_bits16)
    Bits32 => kotlin_atom(id: ^kotlin_tag_bits32)
    Bits64 => kotlin_atom(id: ^kotlin_tag_bits64)
  }
}

fn kotlin_float_width_node(width: KotlinFloatWidth) -> v2.std.node.Node {
  match width {
    FloatBits32 => kotlin_atom(id: ^kotlin_tag_bits32)
    FloatBits64 => kotlin_atom(id: ^kotlin_tag_bits64)
  }
}

fn kotlin_overflow_node(overflow: KotlinIntegerOverflowUnspecified) -> v2.std.node.Node {
  let _witness = overflow
  kotlin_atom(id: ^kotlin_tag_overflow_unspecified)
}

fn kotlin_runtime_representation_node(representation: KotlinRuntimeRepresentation) -> v2.std.node.Node {
  let _witness = representation
  kotlin_atom(id: ^kotlin_tag_platform_specific_runtime_representation)
}

fn kotlin_character_encoding_node(encoding: KotlinCharacterEncoding) -> v2.std.node.Node {
  match encoding {
    Ucs2CodeUnit => kotlin_atom(id: ^kotlin_tag_ucs2_code_unit)
    Ucs2CodeUnitSequence => kotlin_atom(id: ^kotlin_tag_ucs2_code_unit_sequence)
  }
}

fn kotlin_singleton_inhabitance_node(inhabitance: KotlinSingletonInhabitance) -> v2.std.node.Node {
  let _witness = inhabitance
  kotlin_atom(id: ^kotlin_tag_singleton_object)
}

fn kotlin_control_flow_inhabitance_node(inhabitance: KotlinControlFlowInhabitance) -> v2.std.node.Node {
  let _witness = inhabitance
  kotlin_atom(id: ^kotlin_tag_uninhabited_control_flow)
}

fn kotlin_float_value_format_node(value_format: KotlinFloatValueFormat) -> v2.std.node.Node {
  match value_format {
    Ieee754Binary32Precision => kotlin_atom(id: ^kotlin_tag_ieee754_binary32_precision)
    Ieee754Binary64Precision => kotlin_atom(id: ^kotlin_tag_ieee754_binary64_precision)
  }
}

fn kotlin_scalar_node(scalar: KotlinScalar) -> v2.std.node.Node {
  match scalar {
    IntScalar { width } => v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
      children: [
        kotlin_named_edge(
          name: ^kotlin_facts_field_scalar_classifier,
          target: kotlin_atom(id: ^kotlin_tag_scalar_int)
        ),
        kotlin_named_edge(name: ^kotlin_facts_field_width, target: kotlin_int_width_node(width: width))
      ],
      occurrence_id: v2.std.node.SyntheticOccurrence
}
    FloatScalar { width } => v2.std.node.Node {
      kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
      children: [
        kotlin_named_edge(
          name: ^kotlin_facts_field_scalar_classifier,
          target: kotlin_atom(id: ^kotlin_tag_scalar_float)
        ),
        kotlin_named_edge(name: ^kotlin_facts_field_width, target: kotlin_float_width_node(width: width))
      ],
      occurrence_id: v2.std.node.SyntheticOccurrence
}
    BoolScalar => kotlin_atom(id: ^kotlin_tag_scalar_bool)
    CharScalar => kotlin_atom(id: ^kotlin_tag_scalar_char)
    StringScalar => kotlin_atom(id: ^kotlin_tag_scalar_string)
    UnitScalar => kotlin_atom(id: ^kotlin_tag_scalar_unit)
    NothingScalar => kotlin_atom(id: ^kotlin_tag_scalar_nothing)
  }
}

fn kotlin_integer_facts_node(facts: KotlinIntegerPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^kotlin_facts_field_surface_spelling,
        target: kotlin_atom(id: facts.surface_spelling)
      ),
      kotlin_named_edge(name: ^kotlin_facts_field_signedness, target: kotlin_atom(id: ^kotlin_tag_signed)),
      kotlin_named_edge(name: ^kotlin_facts_field_width, target: kotlin_int_width_node(width: facts.width)),
      kotlin_named_edge(
        name: ^kotlin_facts_field_overflow,
        target: kotlin_overflow_node(overflow: facts.overflow)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_representation,
        target: kotlin_runtime_representation_node(representation: facts.representation)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_scalar_classifier,
        target: kotlin_scalar_node(scalar: IntScalar { width: facts.width })
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_float_facts_node(facts: KotlinFloatPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^kotlin_facts_field_surface_spelling,
        target: kotlin_atom(id: facts.surface_spelling)
      ),
      kotlin_named_edge(name: ^kotlin_facts_field_width, target: kotlin_float_width_node(width: facts.width)),
      kotlin_named_edge(
        name: ^kotlin_facts_field_value_format,
        target: kotlin_float_value_format_node(value_format: facts.value_format)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_representation,
        target: kotlin_runtime_representation_node(representation: facts.representation)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_scalar_classifier,
        target: kotlin_scalar_node(scalar: FloatScalar { width: facts.width })
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_nonnumeric_facts_node(facts: KotlinNonNumericPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^kotlin_facts_field_surface_spelling,
        target: kotlin_atom(id: facts.surface_spelling)
      ),
      kotlin_named_edge(
        name: kotlin_nonnumeric_value_fact_field(value_fact: facts.value_fact),
        target: kotlin_nonnumeric_value_fact_node(value_fact: facts.value_fact)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_scalar_classifier,
        target: kotlin_scalar_node(scalar: facts.scalar)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_nonnumeric_value_fact_field(value_fact: KotlinNonNumericValueFact) -> v2.std.node.Symbol {
  match value_fact {
    RuntimeRepresentationFact { representation } => {
      let _witness = representation
      ^kotlin_facts_field_representation
    }
    CharacterEncodingFact { encoding } => {
      let _witness = encoding
      ^kotlin_facts_field_character_encoding
    }
    SingletonInhabitanceFact { inhabitance } => {
      let _witness = inhabitance
      ^kotlin_facts_field_singleton_inhabitance
    }
    ControlFlowInhabitanceFact { inhabitance } => {
      let _witness = inhabitance
      ^kotlin_facts_field_control_flow_inhabitance
    }
  }
}

fn kotlin_nonnumeric_value_fact_axis(value_fact: KotlinNonNumericValueFact) -> v2.std.node.Symbol {
  match value_fact {
    RuntimeRepresentationFact { representation } => {
      let _witness = representation
      ^kotlin_primitive_fact_axis_runtime_representation
    }
    CharacterEncodingFact { encoding } => {
      let _witness = encoding
      ^kotlin_primitive_fact_axis_character_encoding
    }
    SingletonInhabitanceFact { inhabitance } => {
      let _witness = inhabitance
      ^kotlin_primitive_fact_axis_singleton_inhabitance
    }
    ControlFlowInhabitanceFact { inhabitance } => {
      let _witness = inhabitance
      ^kotlin_primitive_fact_axis_control_flow_inhabitance
    }
  }
}

fn kotlin_nonnumeric_value_fact_node(value_fact: KotlinNonNumericValueFact) -> v2.std.node.Node {
  match value_fact {
    RuntimeRepresentationFact { representation } =>
      kotlin_runtime_representation_node(representation: representation)
    CharacterEncodingFact { encoding } =>
      kotlin_character_encoding_node(encoding: encoding)
    SingletonInhabitanceFact { inhabitance } =>
      kotlin_singleton_inhabitance_node(inhabitance: inhabitance)
    ControlFlowInhabitanceFact { inhabitance } =>
      kotlin_control_flow_inhabitance_node(inhabitance: inhabitance)
  }
}

fn kotlin_integer_spec_facts(facts: KotlinIntegerPrimitiveFacts) -> Map<v2.std.node.Symbol, v2.std.node.Node> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(
        v2.std.collection.map_insert(
          v2.std.collection.map_insert(
            v2.std.collection.map_insert(
              v2.std.collection.empty_map(),
              discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}),
              kotlin_atom(id: facts.surface_spelling)
            ),
            discriminant(v: v2.std.model_core.ModelCoreFactAxisWidth {}),
            kotlin_int_width_node(width: facts.width)
          ),
          discriminant(v: v2.std.model_core.ModelCoreFactAxisSignedness {}),
          kotlin_atom(id: ^kotlin_tag_signed)
        ),
        discriminant(v: v2.std.model_core.ModelCoreFactAxisOverflowDisposition {}),
        kotlin_overflow_node(overflow: facts.overflow)
      ),
      ^kotlin_primitive_fact_axis_runtime_representation,
      kotlin_runtime_representation_node(representation: facts.representation)
    ),
    ^kotlin_primitive_fact_axis_scalar_classifier,
    kotlin_scalar_node(scalar: IntScalar { width: facts.width })
  )
}

fn kotlin_float_spec_facts(facts: KotlinFloatPrimitiveFacts) -> Map<v2.std.node.Symbol, v2.std.node.Node> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(
        v2.std.collection.map_insert(
          v2.std.collection.map_insert(
            v2.std.collection.empty_map(),
            discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}),
            kotlin_atom(id: facts.surface_spelling)
          ),
          discriminant(v: v2.std.model_core.ModelCoreFactAxisWidth {}),
          kotlin_float_width_node(width: facts.width)
        ),
        ^kotlin_primitive_fact_axis_value_format,
        kotlin_float_value_format_node(value_format: facts.value_format)
      ),
      ^kotlin_primitive_fact_axis_runtime_representation,
      kotlin_runtime_representation_node(representation: facts.representation)
    ),
    ^kotlin_primitive_fact_axis_scalar_classifier,
    kotlin_scalar_node(scalar: FloatScalar { width: facts.width })
  )
}

fn kotlin_nonnumeric_spec_facts(facts: KotlinNonNumericPrimitiveFacts) -> Map<v2.std.node.Symbol, v2.std.node.Node> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(
        v2.std.collection.empty_map(),
        discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}),
        kotlin_atom(id: facts.surface_spelling)
      ),
      kotlin_nonnumeric_value_fact_axis(value_fact: facts.value_fact),
      kotlin_nonnumeric_value_fact_node(value_fact: facts.value_fact)
    ),
    ^kotlin_primitive_fact_axis_scalar_classifier,
    kotlin_scalar_node(scalar: facts.scalar)
  )
}

fn kotlin_primitive_bundle_from_integer_facts(
  facts: KotlinIntegerPrimitiveFacts
) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: kotlin_integer_facts_node(facts: facts),
    spec_facts: kotlin_integer_spec_facts(facts: facts)
  }
}

fn kotlin_primitive_bundle_from_float_facts(facts: KotlinFloatPrimitiveFacts) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: kotlin_float_facts_node(facts: facts),
    spec_facts: kotlin_float_spec_facts(facts: facts)
  }
}

fn kotlin_primitive_bundle_from_nonnumeric_facts(
  facts: KotlinNonNumericPrimitiveFacts
) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: kotlin_nonnumeric_facts_node(facts: facts),
    spec_facts: kotlin_nonnumeric_spec_facts(facts: facts)
  }
}

fn kotlin_primitive_bundles_from_integer_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  v2.std.algebra.fold_list(
    xs: kotlin_integer_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, facts) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: kotlin_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn kotlin_primitive_bundles_from_float_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  v2.std.algebra.fold_list(
    xs: kotlin_float_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, facts) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: kotlin_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn kotlin_primitive_bundles_from_nonnumeric_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  v2.std.algebra.fold_list(
    xs: kotlin_nonnumeric_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, facts) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: kotlin_primitive_bundle_from_nonnumeric_facts(facts: facts)
      )
    }
  )
}

fn kotlin_primitive_fact_bundles() -> List<v2.std.model_core.PrimitiveFactBundle> {
  v2.std.algebra.list_append(
    left: v2.std.algebra.list_append(
      left: kotlin_primitive_bundles_from_integer_catalog(),
      right: kotlin_primitive_bundles_from_float_catalog()
    ),
    right: kotlin_primitive_bundles_from_nonnumeric_catalog()
  )
}

fn kotlin_ordered_ring_int_facts() -> KotlinOrderedRingIntegerFacts {
  KotlinOrderedRingIntFacts {
    overflow: kotlin_integer_overflow_unspecified,
    representation: kotlin_platform_specific_runtime_representation
  }
}

fn kotlin_ordered_ring_long_facts() -> KotlinOrderedRingIntegerFacts {
  KotlinOrderedRingLongFacts {
    overflow: kotlin_integer_overflow_unspecified,
    representation: kotlin_platform_specific_runtime_representation
  }
}

fn kotlin_ordered_ring_integer_to_primitive_facts(
  facts: KotlinOrderedRingIntegerFacts
) -> KotlinIntegerPrimitiveFacts {
  match facts {
    KotlinOrderedRingIntFacts { overflow, representation } => KotlinIntegerPrimitiveFacts {
      surface_spelling: ^kotlin_surface_spelling_int,
      width: Bits32,
      overflow: overflow,
      representation: representation
    }
    KotlinOrderedRingLongFacts { overflow, representation } => KotlinIntegerPrimitiveFacts {
      surface_spelling: ^kotlin_surface_spelling_long,
      width: Bits64,
      overflow: overflow,
      representation: representation
    }
  }
}

fn kotlin_ordered_ring_integer_facts_node(facts: KotlinOrderedRingIntegerFacts) -> v2.std.node.Node {
  kotlin_integer_facts_node(
    facts: kotlin_ordered_ring_integer_to_primitive_facts(facts: facts)
  )
}

fn kotlin_ordered_ring_integer_algebra_witness_body(
  overflow: KotlinIntegerOverflowUnspecified,
  representation: KotlinRuntimeRepresentation
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^kotlin_witness_integer_ordered_ring,
        target: kotlin_atom(id: ^kotlin_witness_integer_ordered_ring)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_overflow,
        target: kotlin_overflow_node(overflow: overflow)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_representation,
        target: kotlin_runtime_representation_node(representation: representation)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_integer_algebra_witness_node(facts: KotlinOrderedRingIntegerFacts) -> v2.std.node.Node {
  match facts {
    KotlinOrderedRingIntFacts { overflow, representation } =>
      kotlin_ordered_ring_integer_algebra_witness_body(
        overflow: overflow,
        representation: representation
      )
    KotlinOrderedRingLongFacts { overflow, representation } =>
      kotlin_ordered_ring_integer_algebra_witness_body(
        overflow: overflow,
        representation: representation
      )
  }
}

fn kotlin_float_algebra_witness_node(facts: KotlinFloatPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^kotlin_witness_float_approximate_field,
        target: kotlin_atom(id: ^kotlin_witness_float_approximate_field)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_value_format,
        target: kotlin_float_value_format_node(value_format: facts.value_format)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_representation,
        target: kotlin_runtime_representation_node(representation: facts.representation)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_bool_algebra_witness_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^kotlin_witness_bool_boolean_algebra,
        target: kotlin_atom(id: ^kotlin_witness_bool_boolean_algebra)
      ),
      kotlin_named_edge(
        name: ^kotlin_facts_field_representation,
        target: kotlin_runtime_representation_node(
          representation: kotlin_platform_specific_runtime_representation
        )
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_integer_algebra_inhabitance(facts: KotlinOrderedRingIntegerFacts) -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = kotlin_ordered_ring_integer_facts_node(facts: facts)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: v2.std.algebra.ordered_ring_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: kotlin_integer_algebra_witness_node(facts: facts)
  }
}

fn kotlin_float_algebra_inhabitance(facts: KotlinFloatPrimitiveFacts) -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = kotlin_float_facts_node(facts: facts)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: v2.std.algebra.approximate_field_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: kotlin_float_algebra_witness_node(facts: facts)
  }
}

fn kotlin_bool_algebra_inhabitance() -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = kotlin_nonnumeric_facts_node(facts: kotlin_facts_boolean)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: v2.std.algebra.boolean_algebra_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: kotlin_bool_algebra_witness_node()
  }
}

fn kotlin_integer_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  v2.std.algebra.fold_list(
    xs: kotlin_integer_algebra_inhabitance_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, facts) {
      v2.std.algebra.list_snoc_item(xs: acc, item: kotlin_integer_algebra_inhabitance(facts: facts))
    }
  )
}

fn kotlin_float_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  v2.std.algebra.fold_list(
    xs: kotlin_float_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, facts) {
      v2.std.algebra.list_snoc_item(xs: acc, item: kotlin_float_algebra_inhabitance(facts: facts))
    }
  )
}

fn kotlin_bool_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  [
    kotlin_bool_algebra_inhabitance()
  ]
}

fn kotlin_model_core_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  v2.std.algebra.list_append(
    left: v2.std.algebra.list_append(
      left: kotlin_integer_algebra_inhabitance_decls(),
      right: kotlin_float_algebra_inhabitance_decls()
    ),
    right: kotlin_bool_algebra_inhabitance_decls()
  )
}

fn kotlin_integer_catalog_surface_symbol_step(
  sym: v2.std.node.Symbol,
  acc: Bool,
  facts: KotlinIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn kotlin_float_catalog_surface_symbol_step(
  sym: v2.std.node.Symbol,
  acc: Bool,
  facts: KotlinFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn kotlin_nonnumeric_catalog_surface_symbol_step(
  sym: v2.std.node.Symbol,
  acc: Bool,
  facts: KotlinNonNumericPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn kotlin_integer_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  v2.std.algebra.fold_list(
    xs: kotlin_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      kotlin_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn kotlin_float_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  v2.std.algebra.fold_list(
    xs: kotlin_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      kotlin_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn kotlin_nonnumeric_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  v2.std.algebra.fold_list(
    xs: kotlin_nonnumeric_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      kotlin_nonnumeric_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn kotlin_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  kotlin_integer_catalog_surface_symbol(sym: sym) ||
    kotlin_float_catalog_surface_symbol(sym: sym) ||
    kotlin_nonnumeric_catalog_surface_symbol(sym: sym)
}

fn kotlin_integer_inhabitant_node(id: v2.std.node.Symbol, facts: KotlinIntegerPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(name: ^kotlin_inhabitant_field_atom, target: kotlin_atom(id: id)),
      kotlin_named_edge(
        name: ^kotlin_inhabitant_field_facts,
        target: kotlin_integer_facts_node(facts: facts)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_inhabitant_int_node() -> v2.std.node.Node {
  kotlin_integer_inhabitant_node(id: ^kotlin_inhabitant_int, facts: kotlin_facts_int)
}

fn kotlin_declared_inhabitants_root() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(name: ^kotlin_inhabitant_field_int, target: kotlin_inhabitant_int_node())
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_selection_policy_node() -> v2.std.node.Node {
  kotlin_inhabitant_int_node()
}

fn kotlin_param_binding_node(binding: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^kotlin_emitted_field_binding,
        target: kotlin_atom(id: binding)
      ),
      kotlin_named_edge(
        name: ^kotlin_emitted_field_param_type,
        target: kotlin_inhabitant_int_node()
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_add_fn_signature_arrow() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: kotlin_inhabitant_int_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: kotlin_inhabitant_int_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: kotlin_inhabitant_int_node() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_return_add_expr_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(name: ^kotlin_token_plus, target: kotlin_atom(id: ^kotlin_token_plus)),
      kotlin_named_edge(
        name: ^kotlin_binding_param_x,
        target: kotlin_atom(id: ^kotlin_binding_param_x)
      ),
      kotlin_named_edge(
        name: ^kotlin_binding_param_y,
        target: kotlin_atom(id: ^kotlin_binding_param_y)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_emitted_add_fn_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^kotlin_surface_fn_item,
        target: kotlin_atom(id: ^kotlin_surface_fn_item)
      ),
      kotlin_named_edge(
        name: ^kotlin_binding_fn_add,
        target: kotlin_atom(id: ^kotlin_binding_fn_add)
      ),
      kotlin_named_edge(
        name: ^kotlin_binding_param_x,
        target: kotlin_param_binding_node(binding: ^kotlin_binding_param_x)
      ),
      kotlin_named_edge(
        name: ^kotlin_binding_param_y,
        target: kotlin_param_binding_node(binding: ^kotlin_binding_param_y)
      ),
      kotlin_named_edge(
        name: ^kotlin_emitted_field_signature,
        target: kotlin_add_fn_signature_arrow()
      ),
      kotlin_named_edge(
        name: ^kotlin_emitted_field_return_expr,
        target: kotlin_return_add_expr_node()
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_source_text_authority() -> String {
  kotlin_source_text
}

fn kotlin_concrete_token_node(token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> v2.std.node.Node {

  v2.std.compilers.target_model.concrete_syntax_token_to_node(token: token)
}

fn kotlin_serialize_source_prefix_edges() -> List<v2.std.node.Edge> {
  std.algebra.Cons {
    head: kotlin_named_edge(
      name: ^serialize_source_field_source_text,
      target: kotlin_atom(id: ^kotlin_source_literal)
    ),
    tail: std.algebra.Cons {
      head: kotlin_named_edge(
        name: ^serialize_source_field_source_grammar,
        target: kotlin_atom(id: ^kotlin_production_fn_add)
      ),
      tail: std.algebra.Empty
    }
  }
}

fn kotlin_serialize_source_children() -> List<v2.std.node.Edge> {
  v2.std.algebra.list_append(
    left: kotlin_serialize_source_prefix_edges(),
    right: [
      kotlin_named_edge(
        name: ^grammar_relation_field_tokens,
        target: v2.std.grammar.grammar_relation_tokens_node(
          tokens: kotlin_concrete_tokens(),
          token_to_node: kotlin_concrete_token_node
        )
      )
    ]
  )
}

fn kotlin_serialize_source_node() -> v2.std.node.Node {
  let _authority = kotlin_source_text_authority()
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: kotlin_serialize_source_children(),
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_grammar_terminal(token_class: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Terminal { token_class: token_class, stamp: v2.std.grammar.StampClass }
}

fn kotlin_concrete_tokens_list(
  head: v2.std.compilers.target_model.ConcreteSyntaxToken,
  tail: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  std.algebra.Cons { head: head, tail: tail }
}

fn kotlin_grammar_sequence_from_nonempty(
  head: v2.std.compilers.target_model.ConcreteSyntaxToken,
  tail: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.grammar.GrammarExpr {
  v2.std.algebra.fold_list(
    xs: tail,
    empty: kotlin_grammar_terminal(token_class: v2.std.compilers.target_model.concrete_syntax_token_class(token: head)),
    cons: fn(acc, token) {
      v2.std.grammar.Sequence {
        left: acc,
        right: kotlin_grammar_terminal(token_class: v2.std.compilers.target_model.concrete_syntax_token_class(token: token))
      }
    }
  )
}

fn kotlin_grammar_production_from_nonempty(
  head: v2.std.compilers.target_model.ConcreteSyntaxToken,
  tail: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
) -> v2.std.grammar.GrammarProduction {
  v2.std.grammar.GrammarProduction {
    name: ^kotlin_production_fn_add,
    expression: kotlin_grammar_sequence_from_nonempty(head: head, tail: tail),
    emitted: kotlin_emitted_add_fn_node()
  }
}

fn kotlin_grammar_production_fn_add() -> v2.std.grammar.GrammarProduction {
  kotlin_grammar_production_from_nonempty(
    head: kotlin_concrete_token_head,
    tail: kotlin_concrete_token_tail()
  )
}

fn kotlin_grammar_production_fn_decl() -> v2.std.grammar.GrammarProduction {
