fn kotlin_grammar_relation_row() -> KotlinGrammarRelationRow {
  KotlinGrammarRelationRow {
    head: kotlin_concrete_token_head,
    tail: kotlin_concrete_token_tail()
  }
}

fn kotlin_grammar_relation_row_node(row: KotlinGrammarRelationRow) -> v2.std.node.Node {
  let production = kotlin_grammar_production_from_nonempty(head: row.head, tail: row.tail)
  let tokens = kotlin_concrete_tokens_list(head: row.head, tail: row.tail)
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^grammar_relation_field_production,
        target: v2.std.grammar.grammar_production_to_node(production: production)
      ),
      kotlin_named_edge(
        name: ^grammar_relation_field_emitted,
        target: production.emitted
      ),
      kotlin_named_edge(
        name: ^grammar_relation_field_tokens,
        target: v2.std.grammar.grammar_relation_tokens_node(
          tokens: tokens,
          token_to_node: kotlin_concrete_token_node
        )
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_translation_rules_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^kotlin_relation_rule_fn_add,
        target: kotlin_grammar_relation_row_node(row: kotlin_grammar_relation_row())
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_target_model_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      kotlin_named_edge(
        name: ^target_model_edge_selection_policy,
        target: kotlin_selection_policy_node()
      ),
      kotlin_named_edge(
        name: ^target_model_edge_declared_inhabitants,
        target: kotlin_declared_inhabitants_root()
      ),
      kotlin_named_edge(
        name: ^target_model_edge_translation_rules,
        target: kotlin_translation_rules_node()
      ),
      kotlin_named_edge(
        name: ^target_model_edge_serialize_source,
        target: kotlin_serialize_source_node()
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn kotlin_binding_spellings() -> Map<v2.std.node.Symbol, String> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(
        v2.std.collection.map_insert(v2.std.collection.empty_map(), ^kotlin_binding_type_int, "Int"),
        ^kotlin_binding_fn_add,
        "add"
      ),
      ^kotlin_binding_param_x,
      "x"
    ),
    ^kotlin_binding_param_y,
    "y"
  )
}

fn kotlin_target_model() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
    bundle: kotlin_target_model_node(),
    lex: kotlin_lex(),
    binding_spellings: kotlin_binding_spellings(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
    authority_source_text: kotlin_source_text_authority(),
    runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
  }
}

fn kotlin_lex_rule(token_class: v2.std.node.Symbol, text: String) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: token_class,
    pattern: v2.std.compilers.lexing.LiteralPattern { text: text }
  }
}

fn kotlin_keyword_lex_rule(token_class: v2.std.node.Symbol, text: String) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: token_class,
    pattern: v2.std.compilers.lexing.KeywordPattern { text: text }
  }
}

fn kotlin_whitespace_trivia_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TriviaRule {
    pattern: v2.std.compilers.lexing.OneOrMorePattern {
      element: v2.std.compilers.lexing.ChoicePattern {
        left: v2.std.compilers.lexing.LiteralPattern { text: " " },
        right: v2.std.compilers.lexing.LiteralPattern { text: "\t" }
      }
    }
  }
}

fn kotlin_newline_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^kotlin_token_nl,
    pattern: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.LiteralPattern { text: "\r\n" },
      right: v2.std.compilers.lexing.ChoicePattern {
        left: v2.std.compilers.lexing.LiteralPattern { text: "\n" },
        right: v2.std.compilers.lexing.LiteralPattern { text: "\r" }
      }
    }
  }
}

fn kotlin_ident_lex_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentStartChar },
    right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentContinueChar } }
  }
}

fn kotlin_ident_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^kotlin_token_ident,
    pattern: kotlin_ident_lex_pattern()
  }
}

fn kotlin_int_suffix_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.ChoicePattern {
    left: v2.std.compilers.lexing.LiteralPattern { text: "UL" },
    right: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.LiteralPattern { text: "uL" },
      right: v2.std.compilers.lexing.ChoicePattern {
        left: v2.std.compilers.lexing.LiteralPattern { text: "Ul" },
        right: v2.std.compilers.lexing.ChoicePattern {
          left: v2.std.compilers.lexing.LiteralPattern { text: "ul" },
          right: v2.std.compilers.lexing.ChoicePattern {
            left: v2.std.compilers.lexing.LiteralPattern { text: "U" },
            right: v2.std.compilers.lexing.ChoicePattern {
              left: v2.std.compilers.lexing.LiteralPattern { text: "u" },
              right: v2.std.compilers.lexing.ChoicePattern {
                left: v2.std.compilers.lexing.LiteralPattern { text: "L" },
                right: v2.std.compilers.lexing.LiteralPattern { text: "l" }
              }
            }
          }
        }
      }
    }
  }
}

fn kotlin_decimal_digit_or_separator_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.ChoicePattern {
    left: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.DigitChar },
    right: v2.std.compilers.lexing.LiteralPattern { text: "_" }
  }
}

fn kotlin_nonzero_decimal_digit_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.ChoicePattern {
    left: v2.std.compilers.lexing.LiteralPattern { text: "1" },
    right: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.LiteralPattern { text: "2" },
      right: v2.std.compilers.lexing.ChoicePattern {
        left: v2.std.compilers.lexing.LiteralPattern { text: "3" },
        right: v2.std.compilers.lexing.ChoicePattern {
          left: v2.std.compilers.lexing.LiteralPattern { text: "4" },
          right: v2.std.compilers.lexing.ChoicePattern {
            left: v2.std.compilers.lexing.LiteralPattern { text: "5" },
            right: v2.std.compilers.lexing.ChoicePattern {
              left: v2.std.compilers.lexing.LiteralPattern { text: "6" },
              right: v2.std.compilers.lexing.ChoicePattern {
                left: v2.std.compilers.lexing.LiteralPattern { text: "7" },
                right: v2.std.compilers.lexing.ChoicePattern {
                  left: v2.std.compilers.lexing.LiteralPattern { text: "8" },
                  right: v2.std.compilers.lexing.LiteralPattern { text: "9" }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn kotlin_binary_digit_or_separator_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.ChoicePattern {
    left: v2.std.compilers.lexing.LiteralPattern { text: "0" },
    right: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.LiteralPattern { text: "1" },
      right: v2.std.compilers.lexing.LiteralPattern { text: "_" }
    }
  }
}

fn kotlin_decimal_literal_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.ChoicePattern {
    left: v2.std.compilers.lexing.SequencePattern {
      left: v2.std.compilers.lexing.LiteralPattern { text: "0" },
      right: v2.std.compilers.lexing.OptionalPattern { element: kotlin_int_suffix_pattern() }
    },
    right: v2.std.compilers.lexing.SequencePattern {
      left: kotlin_nonzero_decimal_digit_pattern(),
      right: v2.std.compilers.lexing.SequencePattern {
        left: v2.std.compilers.lexing.RepeatPattern { element: kotlin_decimal_digit_or_separator_pattern() },
        right: v2.std.compilers.lexing.OptionalPattern { element: kotlin_int_suffix_pattern() }
      }
    }
  }
}

fn kotlin_hex_literal_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.LiteralPattern { text: "0x" },
      right: v2.std.compilers.lexing.LiteralPattern { text: "0X" }
    },
    right: v2.std.compilers.lexing.SequencePattern {
      left: v2.std.compilers.lexing.OneOrMorePattern {
        element: v2.std.compilers.lexing.ChoicePattern {
          left: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.HexDigitChar },
          right: v2.std.compilers.lexing.LiteralPattern { text: "_" }
        }
      },
      right: v2.std.compilers.lexing.OptionalPattern { element: kotlin_int_suffix_pattern() }
    }
  }
}

fn kotlin_binary_literal_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.LiteralPattern { text: "0b" },
      right: v2.std.compilers.lexing.LiteralPattern { text: "0B" }
    },
    right: v2.std.compilers.lexing.SequencePattern {
      left: v2.std.compilers.lexing.OneOrMorePattern { element: kotlin_binary_digit_or_separator_pattern() },
      right: v2.std.compilers.lexing.OptionalPattern { element: kotlin_int_suffix_pattern() }
    }
  }
}

fn kotlin_int_literal_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.ChoicePattern {
    left: kotlin_hex_literal_pattern(),
    right: v2.std.compilers.lexing.ChoicePattern {
      left: kotlin_binary_literal_pattern(),
      right: kotlin_decimal_literal_pattern()
    }
  }
}

fn kotlin_int_literal_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^kotlin_token_int_literal,
    pattern: kotlin_int_literal_pattern()
  }
}

fn kotlin_string_literal_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^kotlin_token_string_literal,
    pattern: v2.std.compilers.lexing.DelimitedPattern {
      open: v2.std.compilers.lexing.LiteralPattern { text: "\"" },
      body: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.StringTextChar } },
      close: v2.std.compilers.lexing.LiteralPattern { text: "\"" }
    }
  }
}

fn kotlin_lex_rules() -> v2.std.compilers.lexing.LexRuleSet {
  v2.std.compilers.lexing.LexRuleSet {
    rules: [
      kotlin_whitespace_trivia_rule(),
      kotlin_newline_lex_rule(),
      kotlin_string_literal_lex_rule(),
      kotlin_int_literal_lex_rule(),
      kotlin_ident_lex_rule(),
      kotlin_keyword_lex_rule(token_class: ^kotlin_token_kw_fun, text: "fun"),
      kotlin_keyword_lex_rule(token_class: ^kotlin_token_kw_return, text: "return"),
      kotlin_keyword_lex_rule(token_class: ^kotlin_token_kw_val, text: "val"),
      kotlin_keyword_lex_rule(token_class: ^kotlin_token_kw_var, text: "var"),
      kotlin_keyword_lex_rule(token_class: ^kotlin_token_kw_if, text: "if"),
      kotlin_keyword_lex_rule(token_class: ^kotlin_token_kw_else, text: "else"),
      kotlin_keyword_lex_rule(token_class: ^kotlin_token_kw_while, text: "while"),
      kotlin_keyword_lex_rule(token_class: ^kotlin_token_kw_true, text: "true"),
      kotlin_keyword_lex_rule(token_class: ^kotlin_token_kw_false, text: "false"),
      kotlin_lex_rule(token_class: ^kotlin_token_eq_eq, text: "=="),
      kotlin_lex_rule(token_class: ^kotlin_token_bang_eq, text: "!="),
      kotlin_lex_rule(token_class: ^kotlin_token_lt_eq, text: "<="),
      kotlin_lex_rule(token_class: ^kotlin_token_gt_eq, text: ">="),
      kotlin_lex_rule(token_class: ^kotlin_token_plus, text: "+"),
      kotlin_lex_rule(token_class: ^kotlin_token_minus, text: "-"),
      kotlin_lex_rule(token_class: ^kotlin_token_star, text: "*"),
      kotlin_lex_rule(token_class: ^kotlin_token_slash, text: "/"),
      kotlin_lex_rule(token_class: ^kotlin_token_percent, text: "%"),
      kotlin_lex_rule(token_class: ^kotlin_token_lt, text: "<"),
      kotlin_lex_rule(token_class: ^kotlin_token_gt, text: ">"),
      kotlin_lex_rule(token_class: ^kotlin_token_equal, text: "="),
      kotlin_lex_rule(token_class: ^kotlin_token_lbrace, text: "{"),
      kotlin_lex_rule(token_class: ^kotlin_token_rbrace, text: "}"),
      kotlin_lex_rule(token_class: ^kotlin_token_lparen, text: "("),
      kotlin_lex_rule(token_class: ^kotlin_token_rparen, text: ")"),
      kotlin_lex_rule(token_class: ^kotlin_token_lbracket, text: "["),
      kotlin_lex_rule(token_class: ^kotlin_token_rbracket, text: "]"),
      kotlin_lex_rule(token_class: ^kotlin_token_comma, text: ","),
      kotlin_lex_rule(token_class: ^kotlin_token_colon, text: ":"),
      kotlin_lex_rule(token_class: ^kotlin_token_dot, text: "."),
      kotlin_lex_rule(token_class: ^kotlin_token_semicolon, text: ";")
    ]
  }
}

fn kotlin_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules { root: kotlin_lex_rules() }
}

fn kotlin_formal_rhs_from_tokens(tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>) -> List<v2.std.grammar.FormalGrammarSymbol> {
  v2.std.algebra.fold_list(
    xs: tokens,
    empty: std.algebra.Empty,
    cons: fn(acc, token) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: v2.std.grammar.grammar_formal_terminal(identity: v2.std.compilers.target_model.concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn kotlin_formal_production_fn_add() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^kotlin_production_fn_add,
    rhs: kotlin_formal_rhs_from_tokens(tokens: kotlin_concrete_tokens())
  )
}

