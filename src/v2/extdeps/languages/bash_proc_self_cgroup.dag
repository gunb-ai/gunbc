module v2.extdeps.languages.bash_proc_self_cgroup




data bash_membership_refuse_malformed_body: String = "echo \"[calibration] cgroup_membership=malformed\" >&2; exit 1"

data bash_membership_refuse_missing_body: String = "echo \"[calibration] cgroup_membership=missing\" >&2; exit 1"

data bash_membership_refuse_ambiguous_body: String = "echo \"[calibration] cgroup_membership=ambiguous\" >&2; exit 1"

fn bash_membership_assign_from_record(
  record: extdeps.linux.proc_self_cgroup.ProcPidCgroupMembershipRecord,
  walk_var: std.types.NonEmptyStr,
  mount_root: std.types.FilePathParts,
) -> String {
  match record {
    extdeps.linux.proc_self_cgroup.CurrentCgroupObserved { relative_path: rel } =>
      concat(
        walk_var as String,
        "=\"",
        extdeps.linux.proc_self_cgroup.proc_self_cgroup_absolute_path_from_relative(relative_path: rel, mount_root: mount_root),
        "\"",
      )
    extdeps.linux.proc_self_cgroup.MembershipMissing => bash_membership_refuse_missing_body
    extdeps.linux.proc_self_cgroup.MembershipAmbiguous { first: _, second: _ } => bash_membership_refuse_ambiguous_body
    extdeps.linux.proc_self_cgroup.MembershipMalformed { cause: _ } => bash_membership_refuse_malformed_body
  }
}

fn bash_membership_assign_from_content(
  content: String,
  walk_var: std.types.NonEmptyStr,
  mount_root: std.types.FilePathParts,
) -> String {
  bash_membership_assign_from_record(
    record: extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: content),
    walk_var: walk_var,
    mount_root: mount_root,
  )
}

data bash_membership_realization_note: String = "Bash realization for extdeps.linux.proc_self_cgroup unified-hierarchy membership. bash_membership_assign_from_content lowers read_unified_cgroup_membership outcomes to shell text. bash_membership_assign_from_source is the foreign-executor transport: a runtime scan over cgroup_source that mirrors the parser's refusal/observed semantics for wet witnesses. The semantic parser lives in extdeps.linux.proc_self_cgroup; procfs path literal is extdeps.linux.procfs ProcSelfCgroup; this module owns target spelling only."

data bash_membership_runtime_scan_shell_emit_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "v2.extdeps.languages.bash_proc_self_cgroup",
    decl_name: "bash_membership_assign_from_source",
    field: std.decl_ref.WholeDeclaration
  }
}

data bash_membership_runtime_scan_shell_emit_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: bash_membership_assign_from_source — foreign-executor runtime scan over extdeps.linux.procfs ProcSelfCgroup; semantic parser is extdeps.linux.proc_self_cgroup read_unified_cgroup_membership. DISSOLVES WHEN shell→intent Phase 2 binds cgroup membership observation through host_effect_apply without medium-as-string concat.")

fn bash_membership_outcome_tag_from_execution(
  success: Bool,
  stderr: String,
  stdout: String,
  mount_root: std.types.FilePathParts,
) -> extdeps.linux.proc_self_cgroup.UnifiedMembershipOutcomeTag {
  if !success && string_contains(s: stderr, pattern: "cgroup_membership=malformed") {
    extdeps.linux.proc_self_cgroup.OutcomeTagMalformed
  } else if !success && string_contains(s: stderr, pattern: "cgroup_membership=missing") {
    extdeps.linux.proc_self_cgroup.OutcomeTagMissing
  } else if !success && string_contains(s: stderr, pattern: "cgroup_membership=ambiguous") {
    extdeps.linux.proc_self_cgroup.OutcomeTagAmbiguous
  } else if success {
    let abs = std.algebra.trim(s: stdout)
    let root = extdeps.linux.proc_self_cgroup.proc_self_cgroup_mount_root_text(mount_root: mount_root)
    let root_len = string_length(s: root)
    if string_length(s: abs) >= root_len
      && substring(s: abs, start: 0, end: root_len) == root {
      extdeps.linux.proc_self_cgroup.OutcomeTagObserved {
        relative_path: substring(
          s: abs,
          start: root_len,
          end: string_length(s: abs),
        ) as std.types.NonEmptyStr,
      }
    } else {
      extdeps.linux.proc_self_cgroup.OutcomeTagMalformed
    }
  } else {
    extdeps.linux.proc_self_cgroup.OutcomeTagMalformed
  }
}

fn bash_membership_cross_realization_law_holds(
  content: String,
  success: Bool,
  stderr: String,
  stdout: String,
  mount_root: std.types.FilePathParts,
) -> Bool {
  extdeps.linux.proc_self_cgroup.unified_membership_outcome_tag_eq(
    a: extdeps.linux.proc_self_cgroup.unified_membership_outcome_tag(
      record: extdeps.linux.proc_self_cgroup.read_unified_cgroup_membership(content: content)
    ),
    b: bash_membership_outcome_tag_from_execution(
      success: success,
      stderr: stderr,
      stdout: stdout,
      mount_root: mount_root,
    ),
  )
}

data bash_membership_runtime_scan_loop_drift_sketch: String = "_cg_bad=0; _cg_n=0; _cg_rel=\"\"; while IFS= read -r _cg_line || [ -n \"$_cg_line\" ]; do _cg_trim=$(echo \"$_cg_line\" | sed -e 's/^ //' -e 's/ $//'); [ -z \"$_cg_trim\" ] && continue; case \"$_cg_trim\" in *:*:*) ;; *) _cg_bad=1; continue ;; esac; _cg_h=$(echo \"$_cg_trim\" | cut -d: -f1); _cg_ctl=$(echo \"$_cg_trim\" | cut -d: -f2); _cg_path=$(echo \"$_cg_trim\" | cut -d: -f3-); [ -z \"$_cg_h\" ] && _cg_bad=1; [ -z \"$_cg_path\" ] && _cg_bad=1; if [ \"$_cg_h\" = \"0\" ]; then _cg_n=$((_cg_n + 1)); _cg_rel=\"$_cg_path\"; fi; done"

fn bash_membership_runtime_scan_body_drift_sketch(cgroup_source: String) -> String {
  concat(bash_membership_runtime_scan_loop_drift_sketch, " < ", cgroup_source)
}

fn bash_membership_assign_from_source_drift_sketch(
  cgroup_source: String,
  walk_var: std.types.NonEmptyStr,
  mount_root: std.types.FilePathParts,
) -> String {
  concat(
    "{ ",
    bash_membership_runtime_scan_body_drift_sketch(cgroup_source: cgroup_source),
    "; ",
    "[ \"$_cg_bad\" -eq 1 ] && { ",
    bash_membership_refuse_malformed_body,
    "; }; ",
    "[ \"$_cg_n\" -eq 0 ] && { ",
    bash_membership_refuse_missing_body,
    "; }; ",
    "[ \"$_cg_n\" -gt 1 ] && { ",
    bash_membership_refuse_ambiguous_body,
    "; }; ",
    walk_var as String,
    "=\"",
    extdeps.linux.proc_self_cgroup.proc_self_cgroup_mount_root_text(mount_root: mount_root),
    "$_cg_rel\"; ",
    "} || exit 1",
  )
}

data bash_membership_runtime_scan_loop: String = "_cg_bad=0; _cg_n=0; _cg_rel=\"\"; while IFS= read -r _cg_line || [ -n \"$_cg_line\" ]; do _cg_trim=$(echo \"$_cg_line\" | sed -e 's/^ //' -e 's/ $//'); [ -z \"$_cg_trim\" ] && continue; case \"$_cg_trim\" in *:*:*) ;; *) _cg_bad=1; continue ;; esac; _cg_h=$(echo \"$_cg_trim\" | cut -d: -f1); _cg_ctl=$(echo \"$_cg_trim\" | cut -d: -f2); _cg_path=$(echo \"$_cg_trim\" | cut -d: -f3-); [ -z \"$_cg_h\" ] && _cg_bad=1; [ -z \"$_cg_path\" ] && _cg_bad=1; if [ \"$_cg_h\" = \"0\" ] && [ -z \"$_cg_ctl\" ]; then _cg_n=$((_cg_n + 1)); _cg_rel=\"$_cg_path\"; fi; done"

fn bash_membership_runtime_scan_body(cgroup_source: String) -> String {
  concat(bash_membership_runtime_scan_loop, " < ", cgroup_source)
}

fn bash_membership_assign_from_source(
  cgroup_source: String,
  walk_var: std.types.NonEmptyStr,
  mount_root: std.types.FilePathParts,
) -> String {
  concat(
    "{ ",
    bash_membership_runtime_scan_body(cgroup_source: cgroup_source),
    "; ",
    "[ \"$_cg_bad\" -eq 1 ] && { ",
    bash_membership_refuse_malformed_body,
    "; }; ",
    "[ \"$_cg_n\" -eq 0 ] && { ",
    bash_membership_refuse_missing_body,
    "; }; ",
    "[ \"$_cg_n\" -gt 1 ] && { ",
    bash_membership_refuse_ambiguous_body,
    "; }; ",
    walk_var as String,
    "=\"",
    extdeps.linux.proc_self_cgroup.proc_self_cgroup_mount_root_text(mount_root: mount_root),
    "$_cg_rel\"; ",
    "} || exit 1",
  )
}
