module v2.extdeps.languages.rust_translate_underived_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.collection { empty_map }
import v2.std.compilers.target_model {
  ProducedDeclUnwired,
  TargetModel,
  target_model_emit_transforms_empty,
  VoidLexRules
}
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node { Conj, Node, TypeNode }
import std.occurrence_identity { OccurrenceSynthetic }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Minimal TargetModel fixture: translate_grounding_derived_gate_subtree
// takes (tree: InferredTree, root: Node) — it has NO TargetModel parameter,
// so it cannot read any target field structurally, not merely by path.
// translate() opens by binding that gate; for underived nodes the gate
// returns Rejected via canonical_grounding_from_inferred_facts (which also
// takes no TargetModel). Therefore every TargetModel field is dead weight
// on the refusal path and can be minimal/void.
data rust_minimal_underived_refusal_target: TargetModel = TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: OccurrenceSynthetic
  },
  lex: VoidLexRules,
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}
