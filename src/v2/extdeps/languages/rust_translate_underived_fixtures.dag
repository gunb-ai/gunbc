module v2.extdeps.languages.rust_translate_underived_test

import v2.std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import v2.std.collection { empty_map }
import v2.std.compilers.target_model {
  ProducedDeclUnwired,
  TargetModel,
  target_model_emit_transforms_empty,
  VoidLexRules
}
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node { Conj, Node, TypeNode }
import std.occurrence_identity { OccurrenceSynthetic }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

// Minimal TargetModel fixture: the translate refusal gate rejects on
// grounding-not-derived BEFORE reading any TargetModel field, so every
// field can be a minimal/void value. See 06_translate.dag lines 4160-4170:
// translate() evaluates translate_grounding_derived_gate_subtree first;
// for underived nodes it returns Rejected via
// canonical_grounding_from_inferred_facts, which never accesses target.*.
data rust_minimal_underived_refusal_target: TargetModel = TargetModel {
  produced_decl_support: ProducedDeclUnwired,
  bundle: Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: OccurrenceSynthetic
  },
  lex: VoidLexRules,
  binding_spellings: empty_map(),
  token_class_emit_transforms: target_model_emit_transforms_empty,
  authority_source_text: "",
  runtime_row: target_emit_host_runtime_row_unconfigured
}
