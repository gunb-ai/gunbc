module v2.extdeps.languages.bash_orch_tier2


fn bash_orch_procedure_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_orch_procedure_name },
    v2.std.compilers.target_model.FixedToken { token_class: ^bash_token_orch_procedure_open },
    v2.std.compilers.target_model.BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_orch_procedure_body },
    v2.std.compilers.target_model.FixedToken { token_class: ^bash_token_orch_procedure_close }
  ]
}

data bash_orch_procedure_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_orch_procedure_tokens()
)

fn bash_orch_procedure_source_text(name: String, body: String) -> String {
  concat(name, concat("() {\n  ", concat(body, "\n}")))
}

fn bash_orch_procedure_lex() -> v2.std.compilers.lexing.LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: "() {\n  ", class: ^bash_token_orch_procedure_open),
    span(text: "\n}", class: ^bash_token_orch_procedure_close)
  ]))
}

fn bash_orch_procedure_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_orch_procedure,
    lhs: ^bash_production_orch_procedure,
    tokens: bash_orch_procedure_tokens(),
    emitted: bash_orch_procedure_emitted
  )
}

fn bash_orch_procedure_binding_spellings(name: String, body: String) -> Map<v2.std.node.Symbol, String> {
  map_insert(
    map_insert(empty_map(), ^bash_orch_procedure_name, name),
    ^bash_orch_procedure_body, body
  )
}

fn bash_orch_procedure_target_model(name: String, body: String) -> v2.std.compilers.target_model.TargetModel {
  bash_make_bound_tokens_target_model(
    rules: bash_orch_procedure_translation_rules_node(),
    source_literal: ^bash_orch_procedure_source_literal,
    production_name: ^bash_production_orch_procedure,
    tokens: bash_orch_procedure_tokens(),
    source_text: bash_orch_procedure_source_text(name: name, body: body),
    lex: bash_orch_procedure_lex(),
    binding_spellings: bash_orch_procedure_binding_spellings(name: name, body: body)
  )
}

fn bash_orch_call_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_orch_call_spelling }
  ]
}

data bash_orch_call_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_orch_call_tokens()
)

fn bash_orch_call_source_text(spelling: String) -> String {
  spelling
}

fn bash_orch_call_lex(spelling: String) -> v2.std.compilers.lexing.LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: spelling, class: ^bash_token_orch_raw)
  ]))
}

fn bash_orch_call_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_orch_call,
    lhs: ^bash_production_orch_call,
    tokens: bash_orch_call_tokens(),
    emitted: bash_orch_call_emitted
  )
}

fn bash_orch_call_binding_spellings(spelling: String) -> Map<v2.std.node.Symbol, String> {
  map_insert(empty_map(), ^bash_orch_call_spelling, spelling)
}

fn bash_orch_call_target_model(spelling: String) -> v2.std.compilers.target_model.TargetModel {
  bash_make_bound_tokens_target_model(
    rules: bash_orch_call_translation_rules_node(),
    source_literal: ^bash_orch_call_source_literal,
    production_name: ^bash_production_orch_call,
    tokens: bash_orch_call_tokens(),
    source_text: bash_orch_call_source_text(spelling: spelling),
    lex: bash_orch_call_lex(spelling: spelling),
    binding_spellings: bash_orch_call_binding_spellings(spelling: spelling)
  )
}

fn orch_procedure_target_model(name: String, body: String) -> v2.std.compilers.target_model.TargetModel {
  bash_orch_procedure_target_model(name: name, body: body)
}

fn orch_call_target_model(callee: String, args_spelling: String) -> v2.std.compilers.target_model.TargetModel {
  bash_orch_call_target_model(spelling: concat(callee, concat(" ", args_spelling)))
}

fn orch_cmdsubst_assign_target_model(name: String, body: String) -> v2.std.compilers.target_model.TargetModel {
  bash_stmt_assign_target_model(
    name: name,
    value: concat("\"$(", concat(body, ")\""))
  )
}

fn orch_cmdsubst_assign_call_target_model(name: String, callee: String, args_spelling: String) -> v2.std.compilers.target_model.TargetModel {
  let call = orch_call_target_model(callee: callee, args_spelling: args_spelling)
  let cmdsubst = bash_word_cmdsubst_target_model(body: call.authority_source_text)
  bash_stmt_assign_target_model(
    name: name,
    value: cmdsubst.authority_source_text
  )
}

fn orch_cmdsubst_assign_raw_target_model(name: String, body: String) -> v2.std.compilers.target_model.TargetModel {
  bash_stmt_assign_target_model(
    name: name,
    value: bash_word_cmdsubst_source_text(body: body)
  )
}

fn orch_let_assign_target_model(name: String, value: String) -> v2.std.compilers.target_model.TargetModel {
  bash_stmt_assign_target_model(name: name, value: value)
}
