// src/v2/extdeps/languages/rust_wire_serde.dag
// Scope: V2 StringVariant wire-serde naming policy → Rust serde attribute emission (slice 1).
// Status: grammar-inverse enum fixture + VariantNaming-driven attr tokens; CoproductWireContract
//   module resolution is forward work (translate type-item hook).
// Authority: std.serialization.VariantNaming + extdeps.languages.rust.emit rename_all rows.

module v2.extdeps.languages.rust_wire_serde

import std.serialization {
  VariantNaming,
  AsAuthored,
  SnakeCase,
  ScreamingSnakeCase,
  StripPrefixAndSnakeCase,
  StripSuffixAndSnakeCase,
  StripPrefixSuffixAndSnakeCase
}
import extdeps.languages.rust.emit {
  rust_serde_rename_all_snake_case,
  rust_serde_rename_all_screaming_snake_case
}
import v2.std.algebra { Empty, fold_list, list_append, list_snoc_item }
import v2.std.collection { List, Map, empty_map }
import v2.std.compilers.lexing {
  LexRule,
  LexRuleSet,
  LexRules,
  LiteralPattern,
  ModeledLexRules,
  TokenRule
}
import v2.std.compilers.target_model {
  ConcreteSyntaxToken,
  FixedToken,
  TargetModel,
  TargetEmitHostRuntimeRow,
  concrete_syntax_token_class,
  concrete_syntax_token_to_node,
  grammar_relation_tokens_node,
  target_reference_layer_tokens_node
}
import v2.std.grammar {
  GrammarExpr,
  GrammarProduction,
  Sequence,
  Terminal,
  grammar_formal_production,
  grammar_formal_terminal,
  grammar_production_to_node,
  grammar_empty_sync_tokens
}
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}

// --- VariantNaming → extdeps serde attr (single authority, no fork) -----------------

fn rust_wire_serde_string_variant_rename_all_attr(naming: VariantNaming) -> String {
  match naming {
    AsAuthored => ""
    SnakeCase => rust_serde_rename_all_snake_case
    ScreamingSnakeCase => rust_serde_rename_all_screaming_snake_case
    StripPrefixAndSnakeCase { prefix: _ } => ""
    StripSuffixAndSnakeCase { suffix: _ } => ""
    StripPrefixSuffixAndSnakeCase { prefix: _, suffix: _ } => ""
  }
}

fn rust_wire_serde_attr_token_class(naming: VariantNaming) -> Symbol {
  match naming {
    ScreamingSnakeCase => ^rust_ws_token_attr_screaming
    SnakeCase => ^rust_ws_token_attr_snake
    AsAuthored => ^rust_ws_token_attr_empty
    StripPrefixAndSnakeCase { prefix: _ } => ^rust_ws_token_attr_empty
    StripSuffixAndSnakeCase { suffix: _ } => ^rust_ws_token_attr_empty
    StripPrefixSuffixAndSnakeCase { prefix: _, suffix: _ } => ^rust_ws_token_attr_empty
  }
}

// --- ReviewEvent-shaped unit enum fixture (github pulls ReviewEvent wire contract) ---

data rust_ws_review_event_body_golden: String = "pub enum ReviewEvent {\n    Approve,\n    RequestChanges,\n    Comment,\n    Pending,\n}"

data rust_ws_review_event_screaming_golden: String = "#[serde(rename_all = \"SCREAMING_SNAKE_CASE\")]\npub enum ReviewEvent {\n    Approve,\n    RequestChanges,\n    Comment,\n    Pending,\n}"

data rust_ws_review_event_snake_golden: String = "#[serde(rename_all = \"snake_case\")]\npub enum ReviewEvent {\n    Approve,\n    RequestChanges,\n    Comment,\n    Pending,\n}"

fn rust_ws_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn rust_ws_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_ws_concrete_token_node(token: ConcreteSyntaxToken) -> Node {
  concrete_syntax_token_to_node(token: token)
}

fn rust_ws_review_event_tokens(naming: VariantNaming) -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: rust_wire_serde_attr_token_class(naming: naming) },
    FixedToken { token_class: ^rust_ws_token_enum_review_event_body }
  ]
}

fn rust_ws_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn rust_ws_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      rust_ws_lex_rule(
        token_class: ^rust_ws_token_attr_screaming,
        text: "#[serde(rename_all = \"SCREAMING_SNAKE_CASE\")]\n"
      ),
      rust_ws_lex_rule(
        token_class: ^rust_ws_token_attr_snake,
        text: "#[serde(rename_all = \"snake_case\")]\n"
      ),
      rust_ws_lex_rule(token_class: ^rust_ws_token_attr_empty, text: ""),
      rust_ws_lex_rule(
        token_class: ^rust_ws_token_enum_review_event_body,
        text: rust_ws_review_event_body_golden
      )
    ]
  }
}

fn rust_ws_lex() -> LexRules {
  ModeledLexRules { root: rust_ws_lex_rules() }
}

type RustWireSerdeGrammarRow {
  production: GrammarProduction
  emitted: Node
  tokens: List<ConcreteSyntaxToken>
}

fn rust_ws_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn rust_ws_grammar_sequence_from_tokens(tokens: List<ConcreteSyntaxToken>) -> GrammarExpr {
  match fold_list(
    xs: tokens,
    empty: optional_absent(),
    cons: fn(acc, token) {
      let term = rust_ws_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
      match acc {
        Absent => optional_present(value: term)
        Present { value: left } =>
          optional_present(value: Sequence { left: left, right: term })
      }
    }
  ) {
    Absent => rust_ws_grammar_terminal(token_class: ^rust_ws_token_attr_empty)
    Present { value: expr } => expr
  }
}

fn rust_ws_grammar_production_string_variant_enum(tokens: List<ConcreteSyntaxToken>) -> GrammarProduction {
  GrammarProduction {
    name: ^rust_ws_production_string_variant_enum,
    expression: rust_ws_grammar_sequence_from_tokens(tokens: tokens),
    emitted: rust_ws_inhabitant_atom(id: ^rust_ws_surface_string_variant_enum)
  }
}

fn rust_ws_grammar_relation_row(naming: VariantNaming) -> RustWireSerdeGrammarRow {
  let tokens = rust_ws_review_event_tokens(naming: naming)
  RustWireSerdeGrammarRow {
    production: rust_ws_grammar_production_string_variant_enum(tokens: tokens),
    emitted: rust_ws_inhabitant_atom(id: ^rust_ws_emitted_review_event),
    tokens: tokens
  }
}

fn rust_ws_grammar_relation_row_node(row: RustWireSerdeGrammarRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_ws_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: row.production)
      ),
      rust_ws_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      rust_ws_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: rust_ws_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_ws_translation_rules_node(naming: VariantNaming) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_ws_named_edge(
        name: ^rust_ws_relation_rule_review_event,
        target: rust_ws_grammar_relation_row_node(row: rust_ws_grammar_relation_row(naming: naming))
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_ws_target_model_core_edges(naming: VariantNaming) -> List<Edge> {
  [
    rust_ws_named_edge(
      name: ^target_model_edge_translation_rules,
      target: rust_ws_translation_rules_node(naming: naming)
    ),
    rust_ws_named_edge(
      name: ^target_model_edge_serialize_source,
      target: rust_ws_serialize_source_node(naming: naming)
    ),
    rust_ws_named_edge(
      name: ^target_model_edge_reference_layer_tokens,
      target: target_reference_layer_tokens_node(tokens: [])
    )
  ]
}

fn rust_ws_serialize_source_node(naming: VariantNaming) -> Node {
  let row = rust_ws_grammar_relation_row(naming: naming)
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_ws_named_edge(
        name: ^serialize_source_field_source_text,
        target: rust_ws_inhabitant_atom(id: ^rust_ws_source_literal)
      ),
      rust_ws_named_edge(
        name: ^serialize_source_field_source_grammar,
        target: rust_ws_inhabitant_atom(id: ^rust_ws_production_string_variant_enum)
      ),
      rust_ws_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: rust_ws_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_ws_target_model_bundle(naming: VariantNaming) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: rust_ws_target_model_core_edges(naming: naming),
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_ws_authority_source_text(naming: VariantNaming) -> String {
  match naming {
    ScreamingSnakeCase => rust_ws_review_event_screaming_golden
    SnakeCase => rust_ws_review_event_snake_golden
    AsAuthored => rust_ws_review_event_body_golden
    StripPrefixAndSnakeCase { prefix: _ } => rust_ws_review_event_body_golden
    StripSuffixAndSnakeCase { suffix: _ } => rust_ws_review_event_body_golden
    StripPrefixSuffixAndSnakeCase { prefix: _, suffix: _ } => rust_ws_review_event_body_golden
  }
}

fn rust_wire_serde_target_model(naming: VariantNaming) -> TargetModel {
  TargetModel {
    bundle: rust_ws_target_model_bundle(naming: naming),
    lex: rust_ws_lex(),
    binding_spellings: empty_map(),
    authority_source_text: rust_ws_authority_source_text(naming: naming),
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

data rust_wire_serde_review_event_emitted: Node = Node {
  kind: TypeNode { connective: Atom { identity: ^rust_ws_emitted_review_event } },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data rust_wire_serde_screaming_snake_target: TargetModel = rust_wire_serde_target_model(
  naming: ScreamingSnakeCase
)

data rust_wire_serde_snake_case_target: TargetModel = rust_wire_serde_target_model(naming: SnakeCase)
