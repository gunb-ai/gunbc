fn dag_surface_module_header_metadata_edge(e: Edge) -> Bool {
  dag_surface_edge_is(e: e, edge: ^dag_surface_module_header)
    || dag_surface_edge_is(e: e, edge: ^dag_surface_module_header_qualified_name)
}

fn dag_resolve_preserve_module_metadata_subtree(node: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      (id == ^dag_surface_module_header) || (id == ^dag_surface_qualified_name)
    Absent => false
  }
}

fn dag_node_is_module_root_conj(n: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: n) {
    Present { value: id } => id == ^dag_surface_module
    Absent =>
      match n.kind {
        TypeNode { connective: Conj } =>
          fold(
            n.children,
            init: false,
            f: fn(found, e) {
              found || dag_surface_edge_is(e: e, edge: ^dag_surface_module_header)
            }
          )
        TypeNode { connective: _ } => false
        ComputationNode { behavior: _ } => false
      }
  }
}

