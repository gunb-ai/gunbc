      item: dag_grammar_nonterminal(production: ^dag_production_field_pattern)
    )
  )
}

fn dag_grammar_expr_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(item: dag_grammar_nonterminal(production: ^dag_production_expr))
  )
}

fn dag_grammar_untyped_params_helper() -> GrammarExpr {
  dag_grammar_comma_list_expr(item: dag_grammar_terminal(token_class: ^dag_token_ident))
}

fn dag_grammar_postfix_call_suffix_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lparen),
    right: dag_grammar_sequence(
      left: dag_grammar_arg_list_helper(),
      right: dag_grammar_terminal(token_class: ^dag_token_rparen)
    )
  )
}

fn dag_grammar_postfix_expr_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_primary_expr),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_dot),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_ident),
          right: dag_grammar_optional(element: dag_grammar_postfix_call_suffix_expr())
        )
      )
    )
  )
}

fn dag_grammar_primary_ident_suffix_expr() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_choice(
      left: dag_grammar_postfix_call_suffix_expr(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_field_init_list_helper(),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      )
    )
  )
}

fn dag_grammar_primary_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_ident),
      right: dag_grammar_primary_ident_suffix_expr()
    ),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: ^dag_token_int_literal),
      right: dag_grammar_choice(
        left: dag_grammar_terminal(token_class: ^dag_token_string_literal),
        right: dag_grammar_choice(
          left: dag_grammar_terminal(token_class: ^dag_token_kw_true),
          right: dag_grammar_choice(
            left: dag_grammar_terminal(token_class: ^dag_token_kw_false),
            right: dag_grammar_choice(
              left: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: ^dag_token_lbracket),
                right: dag_grammar_sequence(
                  left: dag_grammar_expr_list_helper(),
                  right: dag_grammar_terminal(token_class: ^dag_token_rbracket)
                )
              ),
              right: dag_grammar_choice(
                left: dag_grammar_sequence(
                  left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
                  right: dag_grammar_sequence(
                    left: dag_grammar_field_init_list_helper(),
                    right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
                  )
                ),
                right: dag_grammar_sequence(
                  left: dag_grammar_terminal(token_class: ^dag_token_lparen),
                  right: dag_grammar_sequence(
                    left: dag_grammar_nonterminal(production: ^dag_production_expr),
                    right: dag_grammar_terminal(token_class: ^dag_token_rparen)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn dag_grammar_block_expr_expr() -> GrammarExpr {
  dag_grammar_nonterminal(production: ^dag_production_fn_body)
}

fn dag_grammar_arg_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_colon),
        right: dag_grammar_nonterminal(production: ^dag_production_expr)
      )
    ),
    right: dag_grammar_nonterminal(production: ^dag_production_expr)
  )
}

