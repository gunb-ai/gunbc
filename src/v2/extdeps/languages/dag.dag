data dag_join_eval_subgraph_fixture: Node = dag_join_eval_subgraph_node()

fn dag_field_access_body_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_token_dot)
      },
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_binding_param_r)
      },
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_binding_rec_v)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn dag_field_access_arrow_domain_conj_node() -> Node {
