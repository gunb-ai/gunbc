  LanguageModel {
    lex: dag_lex(),
    grammar: dag_g0_void_grammar(),
    language_identity: ^dag_language_model_surface_id,
    canonical_symbols: dag_language_model_surface_prelude_atoms(),
    core: bool_model_core()
  }
}

fn dag_language_model() -> LanguageModel {
