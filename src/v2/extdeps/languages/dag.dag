fn dag_wave2a_task_type_decl_relation_row_witness() -> Witness<Node> {
  match formal_production_for_lhs_exact(
    productions: dag_wave2a_type_decl_formal_productions(),
    lhs: ^dag_production_type_decl,
    child: dag_wave2a_task_type_decl_emitted()
  ) {
    Holds { value: production } =>
      derive_grammar_relation_row_node(
        production: production,
        productions: dag_wave2a_type_decl_formal_productions(),
        emitted: dag_wave2a_task_type_decl_emitted()
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn dag_wave2a_type_decl_translation_rules_witness() -> Witness<Node> {
  match dag_wave2a_task_type_decl_relation_row_witness() {
    Holds { value: row } =>
      Holds {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            dag_named_edge(
              name: ^grammar_relation_rules_formal_productions,
              target: formal_productions_catalog_to_node(
                productions: dag_wave2a_type_decl_formal_productions()
              )
            ),
            dag_named_edge(name: ^dag_relation_rule_wave2a_type_decl_task, target: row)
          ],
          occurrence_id: SyntheticOccurrence
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

