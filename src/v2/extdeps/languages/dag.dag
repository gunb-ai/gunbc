fn dag_formal_grammar_symbol_from_token(token: ConcreteSyntaxToken) -> FormalGrammarSymbol {
  match token {
    FixedToken { token_class: c } => grammar_formal_terminal(identity: c)
    BoundToken { token_class: c, binding: b } =>
      grammar_formal_terminal_bound(identity: c, binding: b)
  }
}

fn dag_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: dag_formal_grammar_symbol_from_token(token: token)
      )
    }
  )
}

fn dag_formal_production_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: ^dag_production_fn_add,
    rhs: dag_formal_rhs_from_tokens(tokens: dag_concrete_tokens())
  )
}

fn dag_formal_production_fn_pick() -> FormalProduction {
  grammar_formal_production(
