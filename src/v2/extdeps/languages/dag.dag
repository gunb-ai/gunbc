fn dag_grammar_terminal_for_mvp1_rec_token(token: ConcreteSyntaxToken) -> GrammarExpr {
  let cls = concrete_syntax_token_class(token: token)
  match token {
    BoundToken { token_class: c, binding: b } =>
      if (c == ^dag_token_ident) && dag_grammar_rec_field_literal_binding(binding: b) {
        dag_grammar_pick_arm_literal_terminal()
      } else {
        dag_grammar_terminal(token_class: cls)
