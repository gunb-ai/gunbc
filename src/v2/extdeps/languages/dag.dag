fn dag_formal_production_mvp1_fn_bind() -> FormalProduction {
  grammar_formal_production(
    lhs: ^dag_production_mvp1_fn_bind,
    rhs: dag_formal_rhs_from_tokens(tokens: dag_mvp1_bind_concrete_tokens())
  )
}

fn dag_grammar_bind_value_literal_binding(binding: Symbol) -> Bool {
  (binding == ^dag_binding_mvp1_pick_lit_one) || (binding == ^dag_binding_mvp1_pick_lit_two)
}

fn dag_grammar_terminal_for_mvp1_bind_token(token: ConcreteSyntaxToken) -> GrammarExpr {
  let cls = concrete_syntax_token_class(token: token)
  if cls == ^dag_token_kw_in {
    dag_grammar_terminal(token_class: ^dag_token_kw_in)
  } else {
    match token {
      BoundToken { token_class: c, binding: b } =>
        if (c == ^dag_token_ident) && dag_grammar_bind_value_literal_binding(binding: b) {
          dag_grammar_pick_arm_literal_terminal()
        } else {
          dag_grammar_terminal_from_concrete_token(token: token)
        }
      _ => dag_grammar_terminal_from_concrete_token(token: token)
    }
  }
}

fn dag_grammar_sequence_from_token_classes_bind() -> GrammarExpr {
  match fold_list(
    xs: dag_mvp1_bind_concrete_tokens(),
    empty: DagGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        DagGramBuild1StateInit =>
          DagGramBuild1StateReady {
            expr: dag_grammar_terminal_for_mvp1_bind_token(token: token)
          }
        DagGramBuild1StateReady { expr: acc } =>
          DagGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: dag_grammar_terminal_for_mvp1_bind_token(token: token)
            }
          }
      }
    }
  ) {
    DagGramBuild1StateInit =>
      dag_grammar_terminal(token_class: ^dag_token_kw_fn)
    DagGramBuild1StateReady { expr: result } => result
  }
}

fn dag_grammar_production_mvp1_fn_bind() -> GrammarProduction {
  GrammarProduction {
    name: ^dag_production_mvp1_fn_bind,
    expression: dag_grammar_sequence_from_token_classes_bind(),
    emitted: dag_grammar_atom(id: ^dag_surface_fn_decl)
  }
}

// 🟡 gated — COMPREP wave-2 hard-coded bridge scaffold — feature:COMPREP-WAVE2-BODY-BRIDGE —
// consumer:dag_mvp1_bind_captured_flat_atom_binding_for_ident (via
// produce_mvp1_bind_arrow_with_body_from_resolved; executed by comprep_bind_eval_by_execution
// keystone) — dissolve-on: binding_id-branded resolved atoms replace bind flat-index table;
// owner/lane: Mgr-§2 (crisp-crane-18).
fn dag_mvp1_bind_captured_flat_atom_binding_for_ident(
  flat_index: Int,
  ident_atom: Node
) -> Outcome<Symbol> {
  match dag_mvp1_binding_branded_atom_identity(node: ident_atom) {
    Present { value: binding } => outcome_accepted(binding)
    Absent =>
      if !dag_mvp1_node_is_ident_atom(node: ident_atom) {
        outcome_rejected(d: dag_mvp1_captured_flat_atom_binding_miss_diagnostic(flat_index: flat_index))
      } else if flat_index == 5 {
        outcome_accepted(^dag_binding_type_int)
      } else if (flat_index == 8) || (flat_index == 12) {
        outcome_accepted(^dag_binding_mvp1_bind_x)
      } else {
        outcome_rejected(d: dag_mvp1_captured_flat_atom_binding_miss_diagnostic(flat_index: flat_index))
      }
  }
}

fn dag_value_expression_projection() -> TargetValueExpressionProjection {
  TargetValueExpressionProjection {
    binding_ref_form: TargetBindingRefShape { ident_token: ^dag_token_ident },
    primitive_apply_form: TargetPrimitiveApplyShape {
      open: ^dag_token_lparen,
      close: ^dag_token_rparen,
      separator: ^dag_token_comma
    },
    callable_apply_form: TargetCallApplyShape {
      callee_ident_token: ^dag_token_ident,
      open: ^dag_token_lparen,
      separator: ^dag_token_comma,
      close: ^dag_token_rparen
    },
    closure_form: TargetClosureShape {
      fn_token: ^dag_token_kw_fn,
      open: ^dag_token_lparen,
      separator: ^dag_token_comma,
      close: ^dag_token_rparen,
      body_open: ^dag_token_lbrace,
      body_close: ^dag_token_rbrace,
      param_ident_token: ^dag_token_ident
    },
    effect_apply_form: TargetEffectApplyShape {
      callees: [],
      open: ^dag_token_lparen,
      close: ^dag_token_rparen,
      separator: ^dag_token_comma
    },
    conditional_form: TargetConditionalShape {
      if_token: ^dag_token_kw_if,
      then_token: ^dag_token_kw_then,
      else_token: ^dag_token_kw_else
    },
    let_form: TargetBindLetShape {
      let_token: ^dag_token_kw_let,
      assign_token: ^dag_token_eq,
      in_token: ^dag_token_kw_in
    },
    loop_form: TargetLoopShape {
      loop_token: ^dag_token_kw_loop
    },
    record_construct_form: TargetRecordConstructShape {
      open: ^dag_token_lbrace,
      close: ^dag_token_rbrace,
      separator: ^dag_token_comma,
      assign: ^dag_token_colon
    },
    field_access_form: TargetFieldAccessShape {
      dot: ^dag_token_dot
    },
    match_form: TargetMatchShape {
      match_token: ^dag_token_kw_match,
      open: ^dag_token_lbrace,
      close: ^dag_token_rbrace,
      fat_arrow: ^dag_token_fat_arrow,
      arm_separator: ^dag_token_comma
    }
  }
}

