type DagTriviaNormalization
  = DagWhitespaceDeclaredNormalized
  | DagLineCommentFailClosed
  | DagBlockCommentFailClosed

fn dag_whitespace_fidelity() -> FidelityDisposition<DagTriviaNormalization> {
  DeclaredNormalized { feature: DagWhitespaceDeclaredNormalized }
}

fn dag_line_comment_fidelity() -> FidelityDisposition<DagTriviaNormalization> {
  FailClosed { feature: DagLineCommentFailClosed }
}

fn dag_block_comment_fidelity() -> FidelityDisposition<DagTriviaNormalization> {
  FailClosed { feature: DagBlockCommentFailClosed }
}

fn dag_trivia_normalization_feature_node(feature: DagTriviaNormalization) -> Node {
  match feature {
    DagWhitespaceDeclaredNormalized =>
      dag_grammar_atom(id: ^dag_trivia_feature_whitespace)
    DagLineCommentFailClosed =>
      dag_grammar_atom(id: ^dag_trivia_feature_line_comment)
    DagBlockCommentFailClosed =>
      dag_grammar_atom(id: ^dag_trivia_feature_block_comment)
  }
}

fn dag_fidelity_disposition_node(
  disposition: FidelityDisposition<DagTriviaNormalization>
) -> Node {
  match disposition {
    Modeled =>
      dag_grammar_atom(id: ^dag_fidelity_disposition_kind_modeled)
    DeclaredNormalized { feature: feature } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          dag_named_edge(
            name: ^dag_fidelity_disposition_kind_declared_normalized,
            target: dag_grammar_atom(id: ^dag_fidelity_disposition_kind_declared_normalized)
          ),
          dag_named_edge(
            name: ^dag_fidelity_disposition_field_feature,
            target: dag_trivia_normalization_feature_node(feature: feature)
          )
        ],
        occurrence_id: OccurrenceSynthetic
      }
    FailClosed { feature: feature } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          dag_named_edge(
            name: ^dag_fidelity_disposition_kind_fail_closed,
            target: dag_grammar_atom(id: ^dag_fidelity_disposition_kind_fail_closed)
          ),
          dag_named_edge(
            name: ^dag_fidelity_disposition_field_feature,
            target: dag_trivia_normalization_feature_node(feature: feature)
          )
        ],
        occurrence_id: OccurrenceSynthetic
      }
  }
}

fn dag_fidelity_quotient_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
