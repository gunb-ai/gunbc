fn dag_surface_operator_canonicalization_miss_diagnostic(surface_token: Symbol) -> Diagnostic {
  Diagnostic {
    reason: ^dag_surface_operator_canonicalization_miss,
    at: port_locus(port: ^dag_surface_operator_canonicalization_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn dag_surface_operator_canonicalization_member(surface_token: Symbol) -> Outcome<CanonicalOperation> {
  if surface_token == ^dag_token_or_or {
    outcome_accepted(canonical_operation_op_or())
  } else if surface_token == ^dag_token_and_and {
    outcome_accepted(canonical_operation_op_and())
  } else if surface_token == ^dag_token_eq_eq {
    outcome_accepted(canonical_operation_op_eq())
  } else if surface_token == ^dag_token_neq {
    outcome_accepted(canonical_operation_op_ne())
  } else if surface_token == ^dag_token_lt {
    outcome_accepted(canonical_operation_op_lt())
  } else if surface_token == ^dag_token_lte {
    outcome_accepted(canonical_operation_op_le())
  } else if surface_token == ^dag_token_gt {
    outcome_accepted(canonical_operation_op_gt())
  } else if surface_token == ^dag_token_gte {
    outcome_accepted(canonical_operation_op_ge())
  } else if surface_token == ^dag_token_plus {
    outcome_accepted(canonical_operation_op_add())
  } else if surface_token == ^dag_token_minus {
    outcome_accepted(canonical_operation_op_sub())
  } else if surface_token == ^dag_token_star {
    outcome_accepted(canonical_operation_op_mul())
  } else if surface_token == ^dag_token_slash {
    outcome_accepted(canonical_operation_op_div())
  } else {
    outcome_rejected(
      dag_surface_operator_canonicalization_miss_diagnostic(surface_token: surface_token)
    )
  }
}

fn dag_surface_operator_canonicalization_lookup(
  lm: LanguageModel,
  surface_token: Symbol
) -> Outcome<CanonicalOperation> {
  dag_surface_operator_canonicalization_member(surface_token: surface_token)
}

fn dag_keyword_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: KeywordPattern { text: text }
  }
}

fn dag_literal_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn dag_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn dag_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^dag_token_ident,
    pattern: dag_ident_lex_pattern()
  }
}

fn dag_int_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^dag_token_int_literal,
    pattern: OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
  }
}

fn dag_string_escape_char_pattern() -> LexPattern {
  ChoicePattern {
    left: CharPattern { char: 34 },
    right: ChoicePattern {
      left: CharPattern { char: 92 },
      right: ChoicePattern {
        left: CharPattern { char: 110 },
        right: ChoicePattern {
          left: CharPattern { char: 116 },
          right: ChoicePattern {
            left: CharPattern { char: 123 },
            right: CharPattern { char: 125 }
          }
        }
      }
    }
  }
}

fn dag_string_escape_sequence_pattern() -> LexPattern {
  SequencePattern {
    left: CharPattern { char: 92 },
    right: dag_string_escape_char_pattern()
  }
}

fn dag_string_body_element_pattern() -> LexPattern {
  ChoicePattern {
    left: dag_string_escape_sequence_pattern(),
    right: CharClassPattern { class: StringTextChar }
  }
}

fn dag_string_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^dag_token_string_literal,
    pattern: DelimitedPattern {
      open: CharPattern { char: 34 },
      body: RepeatPattern { element: dag_string_body_element_pattern() },
      close: CharPattern { char: 34 }
    }
  }
}

fn dag_whitespace_trivia_rule() -> LexRule {
  TriviaRule {
    pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } }
  }
}

fn dag_lex_rules() -> LexRuleSet {

  LexRuleSet {
    rules: [
      dag_whitespace_trivia_rule(),
      dag_string_literal_lex_rule(),
      dag_int_literal_lex_rule(),
      dag_ident_lex_rule(),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_module, text: "module"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_import, text: "import"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_type, text: "type"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_data, text: "data"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_fn, text: "fn"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_let, text: "let"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_in, text: "in"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_loop, text: "loop"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_match, text: "match"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_if, text: "if"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_then, text: "then"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_else, text: "else"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_true, text: "true"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_false, text: "false"),
      dag_literal_lex_rule(token_class: ^dag_token_arrow, text: "->"),
      dag_literal_lex_rule(token_class: ^dag_token_fat_arrow, text: "=>"),
      dag_literal_lex_rule(token_class: ^dag_token_eq_eq, text: "=="),
      dag_literal_lex_rule(token_class: ^dag_token_neq, text: "!="),
      dag_literal_lex_rule(token_class: ^dag_token_gte, text: ">="),
      dag_literal_lex_rule(token_class: ^dag_token_lte, text: "<="),
      dag_literal_lex_rule(token_class: ^dag_token_or_or, text: "||"),
      dag_literal_lex_rule(token_class: ^dag_token_and_and, text: "&&"),
      dag_literal_lex_rule(token_class: ^dag_token_pipe_gt, text: "|>"),
      dag_literal_lex_rule(token_class: ^dag_token_plus, text: "+"),
      dag_literal_lex_rule(token_class: ^dag_token_minus, text: "-"),
      dag_literal_lex_rule(token_class: ^dag_token_star, text: "*"),
      dag_literal_lex_rule(token_class: ^dag_token_slash, text: "/"),
      dag_literal_lex_rule(token_class: ^dag_token_percent, text: "%"),
      dag_literal_lex_rule(token_class: ^dag_token_bang, text: "!"),
      dag_literal_lex_rule(token_class: ^dag_token_caret, text: "^"),
      dag_literal_lex_rule(token_class: ^dag_token_eq, text: "="),
      dag_literal_lex_rule(token_class: ^dag_token_colon, text: ":"),
      dag_literal_lex_rule(token_class: ^dag_token_comma, text: ","),
      dag_literal_lex_rule(token_class: ^dag_token_dot, text: "."),
      dag_literal_lex_rule(token_class: ^dag_token_pipe, text: "|"),
      dag_literal_lex_rule(token_class: ^dag_token_lbrace, text: "{"),
      dag_literal_lex_rule(token_class: ^dag_token_rbrace, text: "}"),
      dag_literal_lex_rule(token_class: ^dag_token_lparen, text: "("),
      dag_literal_lex_rule(token_class: ^dag_token_rparen, text: ")"),
      dag_literal_lex_rule(token_class: ^dag_token_lbracket, text: "["),
      dag_literal_lex_rule(token_class: ^dag_token_rbracket, text: "]"),
      dag_literal_lex_rule(token_class: ^dag_token_lt, text: "<"),
      dag_literal_lex_rule(token_class: ^dag_token_gt, text: ">"),
      dag_literal_lex_rule(token_class: ^dag_token_question, text: "?"),
      dag_literal_lex_rule(token_class: ^dag_token_match_scrutinee_nop, text: "")
    ]
  }
}

fn dag_lex() -> LexRules {
  ModeledLexRules { root: dag_lex_rules() }
}

fn dag_grammar_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: id }
    },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn dag_named_edge(name: Symbol, target: Node) -> Edge {
  Edge {
    label: Named { name: name },
    target: target
  }
}

fn dag_positional_edge(target: Node) -> Edge {
  Edge {
    label: Positional,
    target: target
  }
}

fn emit_fixed_token(token_class: Symbol) -> Node {
  concrete_syntax_token_to_node(token: FixedToken { token_class: token_class })
}

fn emit_bound_token(token_class: Symbol, binding: Symbol) -> Node {
  concrete_syntax_token_to_node(
    token: BoundToken { token_class: token_class, binding: binding }
  )
}

fn emit_grammar_relation_row(
  production: GrammarProduction,
  emitted: Node,
  tokens: List<Node>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^grammar_relation_field_production,
        target: dag_grammar_atom(id: production.name)
      ),
      dag_named_edge(
        name: ^grammar_relation_field_emitted,
        target: emitted
      ),
      dag_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: tokens,
          token_to_node: fn(token) { token }
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn dag_formal_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^dag_production_module_header,
      rhs: [
        grammar_formal_terminal(identity: ^dag_token_kw_module),
        grammar_formal_nonterminal_occurrence(identity: ^dag_production_qualified_name)
      ]
    ),
    grammar_formal_production(
      lhs: ^dag_production_qualified_name,
      rhs: [
        grammar_formal_terminal_free(identity: ^dag_token_ident)
      ]
    ),
    grammar_formal_production(
