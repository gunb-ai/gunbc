data dag_meet_arrow_with_body_swapped_arms_fixture: Node = dag_bool_binop_arrow_with_body_node(body: dag_meet_body_swapped_arms_node())
data dag_meet_eval_subgraph_fixture: Node = dag_meet_eval_subgraph_node()
data dag_join_arrow_with_body_fixture: Node = dag_bool_binop_arrow_with_body_node(body: dag_join_body_node())
