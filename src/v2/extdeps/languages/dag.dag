// THE DECLARED TYPE OF A GRAMMAR-PRODUCTION EMITTED ATOM. Each production's emitted node is the
// surface atom a production emits into the parse tree, so its declared type is "a dag surface
// production atom", named here by the grammar authority that emits it. An inference rule reads this
// for a member; a production added to dag_grammar_root() is a member by construction.

fn dag_grammar_surface_production_type_node() -> Node {
  dag_grammar_atom(id: ^dag_grammar_surface_production_type_atom)
}

fn dag_grammar_production_emits(production: GrammarProduction, n: Node) -> Bool {
  production.emitted == n
}

// The namespace graft's module-body marker is a surface identity atom of the same kind: it
// occupies the grammar_production_identity_node_projection slot a production's emitted atom
// occupies, so it shares that declared type.
fn dag_grammar_production_member_declared_type(n: Node) -> Optional<Node> {
  if (n == namespace_graft_module_body_marker_node())
    || any(
      xs: dag_grammar_root().productions,
      predicate: fn(production) { dag_grammar_production_emits(production: production, n: n) }
    ) {
    optional_present(value: dag_grammar_surface_production_type_node())
  } else {
    optional_absent()
  }
}

fn dag_g0_void_grammar() -> ParseGrammar {
  VoidGrammar
}

fn dag_grammar() -> ParseGrammar {
  ModeledGrammar { root: dag_grammar_root() }
}

fn dag_pointwise_from_symbol_map(m: Map<Symbol, Bool>) -> PointwisePower<Symbol> {
  PointwisePower {
    member: fn(sym) {
      match map_lookup(m: m, key: sym) {
        Present { value: _ } => true
        Absent => false
      }
    }
  }
}

fn dag_language_model_surface_prelude_map() -> Map<Symbol, Bool> {
  lex_rule_set_token_class_map(rules: dag_lex_rules())
}

fn dag_language_model_surface_prelude_atoms() -> PointwisePower<Symbol> {
  dag_pointwise_from_symbol_map(m: dag_language_model_surface_prelude_map())
}

fn dag_language_model_empty_canonical_symbol_set() -> PointwisePower<Symbol> {
  PointwisePower {
    member: fn(_) {
      false
    }
  }
}

fn dag_language_model_binding_canonical_map(m: Map<Symbol, Bool>) -> Map<Symbol, Bool> {
  grammar_symbol_list_put(
    m: grammar_symbol_list_put(m: m, xs: dag_kernel_value_type_bindings()),
    xs: [
      ^dag_binding_fn_add,
      ^dag_binding_param_x,
      ^dag_binding_param_y,
      ^dag_binding_fn_one_or_two,
      ^dag_binding_fn_one,
      ^dag_binding_bind_x,
      ^dag_binding_pick_lit_one,
      ^dag_binding_pick_lit_two,
      ^dag_loop_measure_sym,
      ^dag_surface_fold_iteration_measure
    ]
  )
}

// Portable share point for the dag canonical set (v2.workflow.floor_pure_producer_share
// derive_cross_claim_share). dag_canonical_symbols wraps this Map in a
// PointwisePower closure at the consumer; that closure is not the stored value.
//
// WHAT THE SET HOLDS: the names the language model mints as atoms a resolved body may carry --
// the lex token classes (a keyword constant reaches a body as its class atom) and the kernel
// bindings -- and NOT every atom the grammar's node encoding carries. That encoding is production
// names plus contextual-keyword terminals (`node`, `rest`, `input`, `output`, ...), which parse
// consumes in their grammar positions; none reaches resolution as a reference. Its consumers read
// membership as "resolves to the kernel atom" (v2.compiler.resolve resolve_atom_unbound,
// resolved_reference_identity, resolve_pattern_atom_is_keyword_constant), so carrying the grammar
// atoms made an unbound `node` in a body resolve, Accepted and silent, to a grammar atom, and a
// declaration spelled `output` resolve to the kernel symbol rather than to its path. Same cut as
// the sugar spellings before it (v2.test.claim.normalize.authored_marker_spelling).
fn dag_canonical_symbol_map() -> Map<Symbol, Bool> {
  dag_language_model_binding_canonical_map(
    m: lex_rule_set_insert_token_classes(m: empty_map(), rules: dag_lex_rules())
  )
}

fn dag_canonical_symbols() -> PointwisePower<Symbol> {
  dag_pointwise_from_symbol_map(m: dag_canonical_symbol_map())
}

fn dag_language_model_void() -> LanguageModel {
  LanguageModel {
    lex: dag_lex(),
    grammar: dag_g0_void_grammar(),
    language_identity: ^dag_language_model_surface_id,
    canonical_symbols: dag_language_model_surface_prelude_atoms(),
    core: bool_model_core()
  }
}

fn dag_language_model() -> LanguageModel {
  LanguageModel {
    lex: dag_lex(),
    grammar: dag_grammar(),
    language_identity: ^dag_language_model_surface_id,
    canonical_symbols: dag_canonical_symbols(),
