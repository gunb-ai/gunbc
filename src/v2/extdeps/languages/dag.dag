}
}

type DagGramBuild1State
  = DagGramBuild1StateInit
  | DagGramBuild1StateReady { expr: GrammarExpr }

fn dag_grammar_sequence_from_token_classes() -> GrammarExpr {
  match fold_list(
    xs: dag_mvp1_concrete_tokens(),
    empty: DagGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        DagGramBuild1StateInit =>
          DagGramBuild1StateReady {
            expr: dag_grammar_terminal_from_concrete_token(token: token)
          }
        DagGramBuild1StateReady { expr: acc } =>
          DagGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: dag_grammar_terminal_from_concrete_token(token: token)
            }
          }
      }
    }
  ) {
    DagGramBuild1StateInit =>
      dag_grammar_terminal(token_class: ^dag_token_kw_fn)
    DagGramBuild1StateReady { expr: result } => result
  }
}

fn dag_formal_grammar_symbol_from_token(token: ConcreteSyntaxToken) -> FormalGrammarSymbol {
  match token {
    FixedToken { token_class: c } => grammar_formal_terminal(identity: c)
    BoundToken { token_class: c, binding: b } =>
      grammar_formal_terminal_bound(identity: c, binding: b)
  }
}

// #g-bidir G.1 — FormalProduction rhs preserves BoundToken bindings (bidir slot bijection).
fn dag_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: dag_formal_grammar_symbol_from_token(token: token)
      )
    }
  )
}

fn dag_formal_production_mvp1_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: ^dag_production_mvp1_fn_add,
    rhs: dag_formal_rhs_from_tokens(tokens: dag_mvp1_concrete_tokens())
  )
}

fn dag_formal_production_mvp1_fn_pick() -> FormalProduction {
  grammar_formal_production(
    lhs: ^dag_production_mvp1_fn_pick,
    rhs: dag_formal_rhs_from_tokens(tokens: dag_mvp1_pick_concrete_tokens())
  )
}

fn dag_formal_production_mvp1_fn_loop() -> FormalProduction {
  grammar_formal_production(
    lhs: ^dag_production_mvp1_fn_loop,
    rhs: dag_formal_rhs_from_tokens(tokens: dag_mvp1_loop_concrete_tokens())
  )
}

fn dag_formal_production_mvp1_fn_match() -> FormalProduction {
