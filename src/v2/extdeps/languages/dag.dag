        ),
        grammar_formal_terminal(identity: ^dag_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^dag_production_type_expr),
        grammar_formal_nonterminal_occurrence(identity: ^dag_production_comma_field_decl_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^dag_production_comma_field_decl_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^dag_production_comma_field_decl_list_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^dag_token_comma),
        grammar_formal_terminal_bound(
          identity: ^dag_token_ident,
