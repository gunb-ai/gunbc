data dag_source_text: String = "fn add(x:Int, y:Int) -> Int { x + y }"

data dag_pick_source_text: String = "fn one_or_two() -> Int { if true then 1 else 2 }"
data dag_pick_false_source_text: String = "fn one_or_two() -> Int { if false then 1 else 2 }"

data dag_loop_source_text: String = "fn one() -> Int { loop 1 }"
data dag_loop_wrong_value_source_text: String = "fn one() -> Int { loop 2 }"

data dag_bind_source_text: String = "fn one() -> Int { { let x = (1) { x } } }"
data dag_bind_wrong_value_source_text: String = "fn one() -> Int { { let x = (2) { x } } }"

data dag_match_source_text: String = "fn one_or_two() -> Int { match true { true => 1, false => 2 } }"

data dag_classical_not_source_text: String = "fn classical_not(a: Classical) -> Classical { match a { True => False, False => True } }"

data dag_rec_source_text: String = "fn mk() -> Rec { Rec { v: 9 } }"

data dag_field_access_source_text: String = "fn get(r: Rec) -> Int { r.v }"

type DagGrammarRelationRow {
  production: FormalProduction
  emitted: Node
  tokens: List<ConcreteSyntaxToken>
}

type DagBodiedFnFamilySpec {
  inhabitant_field: Symbol
  emitted_fn: Node
  grammar_row: DagGrammarRelationRow
  source_literal: Symbol
  production_binding: Symbol
  authority_source_text: String
  relation_rule: Symbol
  scaffold: TargetBodiedArrowStatementScaffold
}

fn dag_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^dag_token_kw_fn },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_fn_add },
    FixedToken { token_class: ^dag_token_lparen },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_param_x },
    FixedToken { token_class: ^dag_token_colon },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_type_int },
    FixedToken { token_class: ^dag_token_comma },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_param_y },
    FixedToken { token_class: ^dag_token_colon },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_type_int },
    FixedToken { token_class: ^dag_token_rparen },
    FixedToken { token_class: ^dag_token_arrow },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_type_int },
    FixedToken { token_class: ^dag_token_lbrace },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_param_x },
    FixedToken { token_class: ^dag_token_plus },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_param_y },
    FixedToken { token_class: ^dag_token_rbrace }
  ]
}

