// DESIGN-6 / grammar-inverse wave-2a — `.dag` type-decl Conj keystone (record with field block).

// DESIGN-1: Conj positional slots = bound-terminal atoms + nonterminal RHS children only.
fn dag_wave2a_qualified_name_emitted(binding: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: dag_inhabitant_atom(id: binding) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

