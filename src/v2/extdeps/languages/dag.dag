      left: dag_grammar_nonterminal(production: ^dag_production_binary_expr),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_repeat(element: dag_grammar_nonterminal(production: ^dag_production_match_arm)),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      )
    )
  )
}

fn dag_grammar_match_arm_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_pattern),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_fat_arrow),
      right: dag_grammar_nonterminal(production: ^dag_production_expr)
    )
  )
}

fn dag_grammar_constructor_pattern_suffix_expr() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_choice(
      left: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_field_pattern_list_helper(),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      ),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lparen),
        right: dag_grammar_sequence(
          left: dag_grammar_pattern_list_helper(),
          right: dag_grammar_terminal(token_class: ^dag_token_rparen)
        )
      )
    )
  )
}

fn dag_grammar_constructor_pattern_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_ident),
    right: dag_grammar_constructor_pattern_suffix_expr()
  )
}

// Pattern forms cover observed src/v2 branches: nullary constructors,
// record-field patterns, keyword/literal patterns, and positional constructor
// payloads such as Composable(inner).
fn dag_grammar_pattern_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_constructor_pattern_expr(),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: ^dag_token_kw_true),
      right: dag_grammar_choice(
        left: dag_grammar_terminal(token_class: ^dag_token_kw_false),
        right: dag_grammar_choice(
          left: dag_grammar_terminal(token_class: ^dag_token_int_literal),
          right: dag_grammar_terminal(token_class: ^dag_token_string_literal)
        )
      )
    )
  )
}

fn dag_grammar_field_pattern_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_colon),
        right: dag_grammar_nonterminal(production: ^dag_production_pattern)
      )
    ),
    right: dag_grammar_terminal(token_class: ^dag_token_ident)
  )
}

fn dag_grammar_if_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_if),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_expr),
      right: dag_grammar_sequence(
        left: dag_grammar_nonterminal(production: ^dag_production_fn_body),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_kw_else),
          right: dag_grammar_choice(
            left: dag_grammar_nonterminal(production: ^dag_production_if_expr),
            right: dag_grammar_nonterminal(production: ^dag_production_fn_body)
          )
        )
      )
    )
  )
}

fn dag_grammar_if_then_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_if),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_expr),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_kw_then),
        right: dag_grammar_sequence(
          left: dag_grammar_nonterminal(production: ^dag_production_expr),
          right: dag_grammar_sequence(
            left: dag_grammar_terminal(token_class: ^dag_token_kw_else),
            right: dag_grammar_nonterminal(production: ^dag_production_expr)
          )
        )
      )
    )
