fn dag_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^dag_binding_fn_add, "add")
  let m1 = map_insert(m0, ^dag_binding_param_x, "x")
  let m2 = map_insert(m1, ^dag_binding_param_y, "y")
  let m3 = map_insert(m2, ^dag_binding_type_int, "Int")
  let m4 = map_insert(m3, ^dag_binding_fn_one_or_two, "one_or_two")
  let m5 = map_insert(m4, ^dag_binding_fn_one, "one")
  let m6 = map_insert(m5, ^dag_binding_bind_x, "x")
  let m7 = map_insert(m6, ^dag_binding_pick_lit_one, "1")
  let m8 = map_insert(m7, ^dag_binding_pick_lit_two, "2")
  let m9 = map_insert(m8, ^dag_binding_type_rec, "Rec")
  let m10 = map_insert(m9, ^dag_binding_fn_mk, "mk")
  let m11 = map_insert(m10, ^dag_binding_fn_get, "get")
  let m12 = map_insert(m11, ^dag_binding_param_r, "r")
  let m13 = map_insert(m12, ^dag_binding_rec_v, "v")
  let m14 = map_insert(m13, ^dag_binding_rec_lit_nine, "9")
  let m15 = map_insert(m14, ^dag_binding_type_variant_holds, "Holds")
  map_insert(m15, ^dag_binding_field_variant_value, "value")
}

fn dag_add_param_binding_ids() -> List<Symbol> {
  [^dag_binding_param_x, ^dag_binding_param_y]
}

fn dag_int_type_binding() -> Symbol {
  ^dag_binding_type_int
}

fn dag_binding_branded_atom_identity(node: Node) -> Optional<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match id == ^dag_token_ident {
        true => Absent
        false => Present { value: id }
      }
    _ => Absent
  }
}

fn dag_loop_measure_node() -> Node {
  dag_type_atom_node(identity: ^dag_loop_measure_sym)
}

fn dag_loop_body_from_literal(lit: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Loop },
    children: [
      Edge {
        label: Positional,
        target: lit
      },
      Edge {
        label: Named { name: ^loop_bound_edge },
        target: dag_loop_measure_node()
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

