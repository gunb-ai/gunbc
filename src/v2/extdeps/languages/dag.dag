fn dag_surface_operator_canonicalization_miss_diagnostic(surface_token: Symbol) -> Diagnostic {
  Diagnostic {
    reason: ^dag_surface_operator_canonicalization_miss,
    at: invariant_port_locus(port: ^dag_surface_operator_canonicalization_port, invariant: ^dag_surface_operator_canonicalization_miss),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn dag_surface_operator_canonicalization_member(surface_token: Symbol) -> Outcome<CanonicalOperation> {
  if surface_token == ^dag_token_or_or {
    outcome_accepted(canonical_operation_op_or())
  } else if surface_token == ^dag_token_and_and {
    outcome_accepted(canonical_operation_op_and())
  } else if surface_token == ^dag_token_eq_eq {
    outcome_accepted(canonical_operation_op_eq())
  } else if surface_token == ^dag_token_neq {
    outcome_accepted(canonical_operation_op_ne())
  } else if surface_token == ^dag_token_lt {
    outcome_accepted(canonical_operation_op_lt())
  } else if surface_token == ^dag_token_lte {
    outcome_accepted(canonical_operation_op_le())
  } else if surface_token == ^dag_token_gt {
    outcome_accepted(canonical_operation_op_gt())
  } else if surface_token == ^dag_token_gte {
    outcome_accepted(canonical_operation_op_ge())
  } else if surface_token == ^dag_token_plus {
    outcome_accepted(canonical_operation_op_add())
  } else if surface_token == ^dag_token_minus {
    outcome_accepted(canonical_operation_op_sub())
  } else if surface_token == ^dag_token_star {
    outcome_accepted(canonical_operation_op_mul())
  } else if surface_token == ^dag_token_slash {
    outcome_accepted(canonical_operation_op_div())
  } else if surface_token == ^dag_token_kw_as {
    outcome_accepted(canonical_operation_op_coerce())
  } else {
    outcome_rejected(
      dag_surface_operator_canonicalization_miss_diagnostic(surface_token: surface_token)
    )
  }
}

fn dag_surface_operator_canonicalization_lookup(
  lm: LanguageModel,
  surface_token: Symbol
) -> Outcome<CanonicalOperation> {
  dag_surface_operator_canonicalization_member(surface_token: surface_token)
}

fn dag_keyword_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: KeywordPattern { text: unicode_scalar_unfold(s: text) }
  }
}

fn dag_literal_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: unicode_scalar_unfold(s: text) }
  }
}

fn dag_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn dag_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^dag_token_ident,
    pattern: dag_ident_lex_pattern()
  }
}

fn dag_int_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^dag_token_int_literal,
    pattern: OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
  }
}

// v1 `scan_number` (v1.compiler.tokenize): digits, then `.` followed by at least one digit, is
// ShLitFloat. v2 G0 had only the integer arm, so `1.8` tokenized as int + dot + int. Postfix
// field access demands a binding name after `.`, so the primary failed, the fn_decl failed as a
// top-level item, the module `repeat` stopped, and `parse_g0_tokens_remain` pointed at leftover
// `fn` — the first remaining token, not the float. The float pattern is strictly longer than the
// integer prefix, so longest-match selects it regardless of list order. Equal-length ties go to
// the LATER rule (`v2.compiler.tokenize`); these two patterns never tie, so this row is not
// placed to win a tie.
fn dag_float_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^dag_token_float_literal,
    pattern: SequencePattern {
      left: OneOrMorePattern { element: CharClassPattern { class: DigitChar } },
      right: SequencePattern {
        left: LiteralPattern { text: "." },
        right: OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
      }
    }
  }
}

// THE STRING ESCAPE VOCABULARY. The dag language's escapes are the ones the v1 tokenizer decodes
// (src/v1/01_tokenize.dag process_escapes), which is what every authored .dag string already means:
// eight single-character escapes, one row each below, and two numeric forms decoded by
// dag_string_decode_step --
//   \"  -> U+0022     \\  -> U+005C     \0  -> U+0000     \n  -> U+000A
//   \r  -> U+000D     \t  -> U+0009     \{  -> U+007B     \}  -> U+007D
//   \xHH      -> the code point HH names (exactly two hex digits)
//   \u{H..H}  -> the code point named by one to six hex digits, which must be a Unicode scalar
//                (std.unicode.types unicode_scalar)
// Hex digits are extdeps.numeric.base16 base16_digit_rows, either case. A brace escape is a literal
// brace and never interpolation (dag/test/claim string_brace_escape_witness_test). Any other
// character after a backslash, a backslash with nothing after it, and a numeric form that is short,
// non-hex, over-long or names a non-scalar are malformed. The v2 lexer admits a backslash as string
// text (StringTextChar), so it is this decode, not the lexer, that refuses a malformed escape.
type DagStringEscape {
  spelled: Int
  value: Int
}

// The last row is carried apart so the derived pattern keeps its right-nested shape: a choice over
// every other row whose innermost alternative is this row's character.
data dag_string_escape_last: DagStringEscape = DagStringEscape { spelled: 125, value: 125 }

fn dag_string_escape_leading() -> List<DagStringEscape> {
  [
    DagStringEscape { spelled: 34, value: 34 },
    DagStringEscape { spelled: 92, value: 92 },
    DagStringEscape { spelled: 48, value: 0 },
    DagStringEscape { spelled: 110, value: 10 },
    DagStringEscape { spelled: 114, value: 13 },
    DagStringEscape { spelled: 116, value: 9 },
    DagStringEscape { spelled: 123, value: 123 }
  ]
}

fn dag_string_escapes() -> List<DagStringEscape> {
  list_append(left: dag_string_escape_leading(), right: [dag_string_escape_last])
}

fn dag_string_escape_char_pattern() -> LexPattern {
  fold_list(
    xs: dag_string_escape_leading(),
    empty: CharPattern { char: dag_string_escape_last.spelled },
    cons: fn(rest, row) { ChoicePattern { left: CharPattern { char: row.spelled }, right: rest } }
  )
}

fn dag_string_escape_sequence_pattern() -> LexPattern {
  SequencePattern {
    left: CharPattern { char: 92 },
    right: dag_string_escape_char_pattern()
  }
}

// v1.compiler.tokenize scan_string_body never treats line feed as a closer:
// only quote, backslash, and interpolation-start end the body walk. This arm
// is that admission on the grammar row — StringTextChar still excludes LF so
// other language models that reuse the class do not grow a second meaning.
fn dag_string_body_element_pattern() -> LexPattern {
  ChoicePattern {
    left: dag_string_escape_sequence_pattern(),
    right: ChoicePattern {
      left: CharPattern { char: 10 },
      right: CharClassPattern { class: StringTextChar }
    }
  }
}

fn dag_string_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^dag_token_string_literal,
    pattern: DelimitedPattern {
      open: CharPattern { char: 34 },
      body: RepeatPattern { element: dag_string_body_element_pattern() },
      close: CharPattern { char: 34 }
    }
  }
}

fn dag_whitespace_trivia_rule() -> LexRule {
  TriviaRule {
    pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } }
  }
}

fn dag_line_comment_annotation_rule() -> LexRule {
  AnnotationRule {
    annotation_class: ^line_comment,
    pattern: SequencePattern {
      left: LiteralPattern { text: "//" },
      right: RepeatPattern { element: CharClassPattern { class: LineCommentTextChar } }
    }
  }
}

fn dag_lex_rules() -> LexRuleSet {

  LexRuleSet {
    rules: [
      dag_whitespace_trivia_rule(),
      dag_string_literal_lex_rule(),
      dag_line_comment_annotation_rule(),
      dag_float_literal_lex_rule(),
      dag_int_literal_lex_rule(),
      dag_ident_lex_rule(),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_module, text: "module"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_import, text: "import"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_alias, text: "alias"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_type, text: "type"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_data, text: "data"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_fn, text: "fn"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_let, text: "let"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_in, text: "in"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_loop, text: "loop"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_match, text: "match"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_if, text: "if"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_then, text: "then"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_else, text: "else"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_true, text: "true"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_false, text: "false"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_where, text: "where"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_as, text: "as"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_return, text: "return"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_nominal_opaque, text: "nominal_opaque"),
      dag_keyword_lex_rule(token_class: ^dag_token_kw_sole_constructor, text: "sole_constructor"),
      dag_literal_lex_rule(token_class: ^dag_token_arrow, text: "->"),
      dag_literal_lex_rule(token_class: ^dag_token_fat_arrow, text: "=>"),
      dag_literal_lex_rule(token_class: ^dag_token_eq_eq, text: "=="),
      dag_literal_lex_rule(token_class: ^dag_token_neq, text: "!="),
      dag_literal_lex_rule(token_class: ^dag_token_gte, text: ">="),
      dag_literal_lex_rule(token_class: ^dag_token_lte, text: "<="),
      dag_literal_lex_rule(token_class: ^dag_token_or_or, text: "||"),
      dag_literal_lex_rule(token_class: ^dag_token_and_and, text: "&&"),
      dag_literal_lex_rule(token_class: ^dag_token_pipe_gt, text: "|>"),
      dag_literal_lex_rule(token_class: ^dag_token_plus, text: "+"),
      dag_literal_lex_rule(token_class: ^dag_token_minus, text: "-"),
      dag_literal_lex_rule(token_class: ^dag_token_star, text: "*"),
      dag_literal_lex_rule(token_class: ^dag_token_slash, text: "/"),
      dag_literal_lex_rule(token_class: ^dag_token_percent, text: "%"),
      dag_literal_lex_rule(token_class: ^dag_token_bang, text: "!"),
      dag_literal_lex_rule(token_class: ^dag_token_caret, text: "^"),
      dag_literal_lex_rule(token_class: ^dag_token_eq, text: "="),
      dag_literal_lex_rule(token_class: ^dag_token_colon, text: ":"),
      dag_literal_lex_rule(token_class: ^dag_token_comma, text: ","),
      dag_literal_lex_rule(token_class: ^dag_token_dot, text: "."),
      dag_literal_lex_rule(token_class: ^dag_token_pipe, text: "|"),
      dag_literal_lex_rule(token_class: ^dag_token_lbrace, text: "{"),
      dag_literal_lex_rule(token_class: ^dag_token_rbrace, text: "}"),
      dag_literal_lex_rule(token_class: ^dag_token_lparen, text: "("),
      dag_literal_lex_rule(token_class: ^dag_token_rparen, text: ")"),
      dag_literal_lex_rule(token_class: ^dag_token_lbracket, text: "["),
      dag_literal_lex_rule(token_class: ^dag_token_rbracket, text: "]"),
      dag_literal_lex_rule(token_class: ^dag_token_lt, text: "<"),
      dag_literal_lex_rule(token_class: ^dag_token_gt, text: ">"),
      dag_literal_lex_rule(token_class: ^dag_token_question, text: "?"),
      dag_literal_lex_rule(token_class: ^dag_token_match_scrutinee_nop, text: "")
    ],
    modes: []
  }
}

fn dag_lex() -> LexRules {
  ModeledLexRules { root: dag_lex_rules() }
}

// EVERY dag TOKEN CLASS IS WRITTEN WITH ONE SPACE AFTER IT. Whitespace is trivia in dag_lex_rules, so
// a space after a token cannot change the tree read back; its absence can. Two adjacent word tokens
// lex as one identifier ("let" "x" -> "letx"), and two adjacent punctuation tokens can spell a third
// (">" "=" -> ">=", "/" "/" opens an annotation), so no token class is exempt. The rows are derived
// from the lex rule set, the one authority for which token classes exist, in the shape the other
// targets declare their separation in (v2.extdeps.languages.verilog verilog_emit_layout_transforms).
fn dag_token_class_emit_transforms() -> Map<Symbol, TokenClassEmitTransform> {
  fold_list(
    xs: lex_rule_set_matching_rules(rules: dag_lex_rules()),
    empty: empty_map(),
    cons: fn(acc, rule) {
      match lex_rule_token_class_optional(rule: rule) {
        Present { value: c } => map_insert(m: acc, key: c, value: EmitSpellingWrap { prefix: "", suffix: " " })
        Absent => acc
      }
    }
  )
}

fn dag_grammar_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode {
      connective: Atom { identity: id }
    },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn dag_named_edge(name: Symbol, target: Node) -> Edge {
  Edge {
    label: Authored { name: name },
    target: target
  }
}

// A DAG SURFACE PRODUCTION'S EDGE: a structural label keyed by this language, so an authored name
// spelled like a production never reaches a reader of the production (gunbc#12473 plan). Readers
// compare the whole label (edge_is_production), never the spelling.
fn dag_surface_edge_label(edge: Symbol) -> EdgeLabel {
  production_edge_label(language: ^dag_language_model_surface_id, edge: edge)
}

fn dag_surface_edge(edge: Symbol, target: Node) -> Edge {
  Edge { label: dag_surface_edge_label(edge: edge), target: target }
}

fn dag_surface_edge_is(e: Edge, edge: Symbol) -> Bool {
  edge_is_production(e: e, language: ^dag_language_model_surface_id, edge: edge)
}

fn dag_positional_edge(target: Node) -> Edge {
  Edge {
    label: Positional,
    target: target
  }
}

fn emit_fixed_token(token_class: Symbol) -> Node {
  concrete_syntax_token_to_node(token: FixedToken { token_class: token_class })
}

fn emit_bound_token(token_class: Symbol, binding: Symbol) -> Node {
  concrete_syntax_token_to_node(
    token: BoundToken { token_class: token_class, binding: binding }
  )
}

fn emit_grammar_relation_row(
  production: GrammarProduction,
  emitted: Node,
  tokens: List<Node>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^grammar_relation_field_production,
        target: dag_grammar_atom(id: production.name)
      ),
      dag_named_edge(
        name: ^grammar_relation_field_emitted,
        target: emitted
      ),
      dag_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: tokens,
          token_to_node: fn(token) { token }
        )
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}


fn dag_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  grammar_expr_terminal(token_class: token_class)
}

fn dag_grammar_terminal_lexeme(token_class: Symbol) -> GrammarExpr {
  grammar_expr_terminal_lexeme(token_class: token_class)
}

// The exact-word terminal: matches ONE lexeme within a token class, so a marker word stays an
// ordinary identifier everywhere else and costs no lexer rule. Seven of this family's marker words
// -- service, operation, input, output, readonly, idempotent, hermetic -- are reserved in
// extdeps.languages.dag.syntax dag_keyword_set, so `^service` is not writable in .dag source at
// all: the caret literal takes an identifier and a keyword is not one. Those seven are interned
// from their String spelling instead, which no keyword rule can intercept.
fn dag_grammar_literal_terminal(token_class: Symbol, lexeme: Symbol) -> GrammarExpr {
  grammar_expr_literal_terminal(token_class: token_class, lexeme: lexeme)
}

fn dag_grammar_nonterminal(production: Symbol) -> GrammarExpr {
  Nonterminal { production: production }
}

fn dag_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}

fn dag_grammar_choice(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Choice { left: left, right: right }
}

fn dag_grammar_optional(element: GrammarExpr) -> GrammarExpr {
  grammar_expr_optional(element: element)
}

fn dag_grammar_repeat(element: GrammarExpr) -> GrammarExpr {
  Repeat { element: element }
}

fn dag_grammar_expect(element: GrammarExpr, reason: ParseRefusalReason) -> GrammarExpr {
  grammar_expr_expect(element: element, reason: reason)
}

fn dag_grammar_comma_list_expr(item: GrammarExpr) -> GrammarExpr {
  dag_grammar_sequence(
    left: item,
    right: dag_grammar_sequence(
      left: dag_grammar_repeat(
        element: dag_grammar_sequence(
          left: dag_grammar_optional(element: dag_grammar_terminal(token_class: ^dag_token_comma)),
          right: item
        )
      ),
      right: dag_grammar_optional(element: dag_grammar_terminal(token_class: ^dag_token_comma))
    )
  )
}

fn dag_grammar_module_header_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_module),
    right: dag_grammar_declared_path_expr()
  )
}

// A DECLARED PATH ENDS AT ITS LAST ADMITTED SEGMENT, AND A KEYWORD AFTER IT REFUSES BY NAME. A path
// segment is an identifier or a type-declaration modifier (dag_grammar_ident_or_type_decl_modifier_name);
// a keyword is not one, so `module rt.match` is not a module path. Without this row the path ended at
// `rt` and the refusal was the generic leftover of `.match`. The guard is a not-predicate, so it
// captures nothing and the path's tree is the qualified name's. It sits on the declaring positions
// (module header, import) and NOT inside qualified_name: an expression admits a keyword after a dot
// (dag_grammar_postfix_dot_suffix_expr, `node.type`), and a pattern -- which reads qualified_name and
// is probed ahead of every match-arm statement -- must not refuse where that expression parses.
fn dag_grammar_declared_path_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_qualified_name),
    right: grammar_expr_not_predicate(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_dot),
        right: grammar_expr_refuse_on_match(element: dag_grammar_keyword_terminal(), reason: KeywordAsPathSegment)
      )
    )
  )
}

// Every keyword a path segment does not admit: the keyword roster less the two modifiers
// dag_grammar_ident_or_type_decl_modifier_name admits (and less `module`, the fold's seed).
fn dag_grammar_keyword_terminal() -> GrammarExpr {
  fold_list(
    xs: dag_binding_name_keyword_tokens(),
    empty: dag_grammar_terminal(token_class: ^dag_token_kw_module),
    cons: fn(acc, tok) {
      if (tok == ^dag_token_kw_module) || (tok == ^dag_token_kw_nominal_opaque) || (tok == ^dag_token_kw_sole_constructor) {
        acc
      } else {
        dag_grammar_choice(left: acc, right: dag_grammar_terminal(token_class: tok))
      }
    }
  )
}

// A KEYWORD IS NOT A VALUE NAME, AND A KEYWORD WHERE ONE IS INTRODUCED REFUSES BY NAME (operator ruling
// via the N7 manager, 2026-10-03: close the binding/reference asymmetry from the BINDER side). Every
// position that introduces a value name -- a parameter, a `let` binder, a `node NAME` / `NAME =` binder,
// a field-pattern binder -- consumes exactly what a value REFERENCE admits (dag_grammar_primary_name_expr:
// an identifier, the two type-declaration modifiers, and the declared contextual set
// dag_contextual_value_name_keywords), so a name is declarable exactly when it is referenceable. Any other
// keyword there refuses as KeywordAsValueName, located at the keyword, rather than as the generic
// leftover parse_g0_tokens_remain at its first USE.
// A field LABEL is not a value name and still admits a keyword (dag_grammar_binding_name_terminal:
// `x.module`, `Rec { module: e }`, `{ module: m }`), and so do the statement and argument guards that
// read it.
//
// THE REFUSAL IS A LEADING GUARD, NEVER A CHOICE ARM. grammar_expr_not_predicate around
// grammar_expr_refuse_on_match captures nothing (v2.compiler.parse parse_sequence_capture answers the
// other side of the sequence), so the name still captures as ONE identifier atom -- the shape the binder
// readers take as pair.left -- and no choice row is added beside the name (the overlap roster those
// productions were cleared to stays at zero).
//
// THE BARE `NAME =` SUGAR CARRIES NO GUARD, AND THE REASON IS MEASURED. A statement's alternatives are
// dispatched by FIRST set, and a not-predicate is transparent to that set, so the let_sugar alternative's
// first set is the value-name tokens and a statement that begins with a keyword never reaches it: a guard
// there could not fire (a bare `loop = 1` refuses as parse_g0_tokens_remain at the keyword, measured).
// It still refuses -- the binder reads the reference production, which admits no other keyword -- but
// unnamed. NEXT TRIGGER, the capability: FIRST-set computation that sees through a refusal guard, at which
// point this form takes dag_grammar_value_name_before(follow: `=`) like the others.
//
// IT FIRES ONLY WHERE THE KEYWORD CAN ONLY BE A BINDER. RefuseOnMatch stops the whole parse, and a pattern
// is probed ahead of every match-arm statement and a `node NAME` sugar ahead of an expression statement,
// so each position names the token that makes the keyword a binder: `:` after a parameter name, `:` or
// `=` after `node NAME`, `,` or `}` after a field-pattern binder. After `let`
// nothing else can follow, so that guard is unconditional. `true` and `false` are literal PATTERNS, so the
// field-pattern guard does not refuse them.
fn dag_grammar_value_name_keyword_terminal(admit_bool_literals: Bool) -> GrammarExpr {
  fold_list(
    xs: dag_binding_name_keyword_tokens(),
    empty: dag_grammar_terminal(token_class: ^dag_token_kw_import),
    cons: fn(acc, tok) {
      if (tok == ^dag_token_kw_import) || dag_keyword_is_reference_value_name(tok: tok) {
        acc
      } else if admit_bool_literals && ((tok == ^dag_token_kw_true) || (tok == ^dag_token_kw_false)) {
        acc
      } else {
        dag_grammar_choice(left: acc, right: dag_grammar_terminal(token_class: tok))
      }
    }
  )
}

// A keyword the REFERENCE production admits as a value name (dag_grammar_primary_name_expr): the
// declared contextual set and the two type-declaration modifiers dag_grammar_ident_or_type_decl_modifier_name
// reads. The binder guard refuses exactly the binding keywords this answers false for.
fn dag_keyword_is_reference_value_name(tok: Symbol) -> Bool {
  (tok == ^dag_token_kw_nominal_opaque)
    || (tok == ^dag_token_kw_sole_constructor)
    || fold_list(xs: dag_contextual_value_name_keywords(), empty: false, cons: fn(acc, k) { acc || (k == tok) })
}

fn dag_grammar_value_name_guard(binder: GrammarExpr) -> GrammarExpr {
  grammar_expr_not_predicate(
    element: grammar_expr_refuse_on_match(element: binder, reason: KeywordAsValueName)
  )
}

// A value name whose binder role is fixed by the token after it.
fn dag_grammar_value_name_before(follow: GrammarExpr) -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_value_name_guard(
      binder: dag_grammar_sequence(left: dag_grammar_value_name_keyword_terminal(admit_bool_literals: false), right: follow)
    ),
    right: dag_grammar_primary_name_expr()
  )
}

// A value name whose position alone makes it a binder (after `let`).
fn dag_grammar_value_name_unconditional() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_value_name_guard(binder: dag_grammar_value_name_keyword_terminal(admit_bool_literals: false)),
    right: dag_grammar_primary_name_expr()
  )
}

// A field-pattern binder: refuses a keyword that ends the field (`,` or `}`). After `:` the position is a
// pattern, where `true` / `false` are literal patterns, so they are admitted there (admit_bool_literals: true).
// Before the field name a keyword ending the field is a PUN -- `R { true }` binds a value named `true`, which
// no reference can name -- so there they refuse like every other keyword (admit_bool_literals: false).
fn dag_grammar_field_pattern_binder_guard(admit_bool_literals: Bool) -> GrammarExpr {
  dag_grammar_value_name_guard(
    binder: dag_grammar_sequence(
      left: dag_grammar_value_name_keyword_terminal(admit_bool_literals: admit_bool_literals),
      right: dag_grammar_choice(
        left: dag_grammar_terminal(token_class: ^dag_token_comma),
        right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
      )
    )
  )
}

// THE FIRST SEGMENT IS A VALUE NAME, SO IT READS THE ONE VALUE-NAME PRODUCTION. A pattern's bare binder is a
// one-segment qualified name (dag_grammar_constructor_pattern_expr), so a pattern binds exactly the names a
// reference reads only if this head is dag_grammar_primary_name_expr -- the identifier, the two
// type-declaration modifiers and the contextual set dag_contextual_value_name_keywords. Without it
// `{ module: module }` declared nothing a later `module` could name. The cost is stated: a type, a declared
// path, an alias or a service head may now also begin with `module` / `data`, which nothing declares, so it
// refuses at resolve; no overlap row is added, because neither keyword shares a first token with an
// identifier. Later segments are unchanged, so `rt.match` still refuses as KeywordAsPathSegment.
fn dag_grammar_qualified_name_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_primary_name_expr(),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_dot),
        right: dag_grammar_ident_or_type_decl_modifier_name()
      )
    )
  )
}

fn dag_grammar_generic_params_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lt),
    right: dag_grammar_sequence(
      left: dag_grammar_comma_list_expr(item: dag_grammar_generic_param_expr()),
      right: dag_grammar_terminal(token_class: ^dag_token_gt)
    )
  )
}

// ONE TYPE PARAMETER: a name, optionally bounded by a KIND (`type MachineWidth<bits: WidthResolution>`),
// as v1 02_parse parse_optional_type_param_kind reads it. Left-factored as seq(name, optional(suffix)),
// the shape the other optional-suffix rules share (dag_grammar_typed_param_expr): an absent kind
// captures as (name, <empty conj>), so no ordered choice re-reads the name. The kind lowers onto the
// binder (v2.compiler.body_lowering_fold body_lower_generic_param_edge_of) and is enforced at each
// application (v2.std.type_binder type_application_conformance).
fn dag_grammar_generic_param_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_ident_or_type_decl_modifier_name(),
    right: dag_grammar_optional(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_colon),
        right: dag_grammar_nonterminal(production: ^dag_production_type_expr)
      )
    )
  )
}

// A PARAMETER MAY REFINE ITS TYPE WITH A WHERE CLAUSE AND MAY CARRY A DEFAULT (`lifetime_seconds: Int
// where range(min: 1, max: 3600) = 3600`), as v1 02_parse parse_param reads it. ONE ALTERNATIVE,
// LEFT-FACTORED: `name: T` is the shared prefix and the tail is optional, so no choice is made on a
// token both readings could start with (operator zero_ambiguity_ruling 2026-10-02). It was a choice
// of `name: T <tail>` before `name: T`, both led by the same binding name. The tail is a refinement
// (optionally followed by a default) or a default; the two start with `where` and `=`, so that inner
// choice is disjoint. A plain parameter captures `name: (T, <empty>)`, which
// v2.compiler.body_lowering_fold body_lower_typed_param_optional reads. A refinement does not lower:
// the fn refuses at the clause (body_lowering_reason_parameter_refinement_unmodeled). A default lowers
// onto the parameter's binder (XL-2 PR2c-ii).
fn dag_grammar_typed_param_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_value_name_before(follow: dag_grammar_terminal(token_class: ^dag_token_colon)),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_colon),
      right: dag_grammar_sequence(
        left: dag_grammar_nonterminal(production: ^dag_production_type_expr),
        right: dag_grammar_optional(
          element: dag_grammar_choice(
            left: dag_grammar_sequence(
              left: dag_grammar_nonterminal(production: ^dag_production_where_refinement_clause),
              right: dag_grammar_optional(element: dag_grammar_nonterminal(production: ^dag_production_default_value))
            ),
            right: dag_grammar_nonterminal(production: ^dag_production_default_value)
          )
        )
      )
    )
  )
}

fn dag_grammar_param_list_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lparen),
    right: dag_grammar_sequence(
      left: dag_grammar_optional(
        element: dag_grammar_comma_list_expr(item: dag_grammar_typed_param_expr())
      ),
      right: dag_grammar_terminal(token_class: ^dag_token_rparen)
    )
  )
}

fn dag_grammar_qualified_type_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_qualified_name),
      right: dag_grammar_optional(
        element: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_lt),
          right: dag_grammar_sequence(
            left: dag_grammar_optional(
              element: dag_grammar_comma_list_expr(item: dag_grammar_generic_arg_expr())
            ),
            right: dag_grammar_terminal(token_class: ^dag_token_gt)
          )
        )
      )
    ),
    right: dag_grammar_optional(
      element: dag_grammar_terminal(token_class: ^dag_token_question)
    )
  )
}

// A generic argument is a type or a natural-number literal: `Compose<Int, MachineWidth<8>>`
// (std.integer), the one axis DESIGN section 2 cites. v1.compiler.parse admits it because its
// lexer gives a digit run the identifier shape, so parse_type_expr reads `8` as a leaf type named
// "8"; the literal is lexeme-stamped here so it carries that same spelling as its atom. It is
// admitted in the argument list only -- a bare `type T = 8` is not a type here.
fn dag_grammar_generic_arg_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_type_expr),
    right: dag_grammar_terminal_lexeme(token_class: ^dag_token_int_literal)
  )
}

fn dag_grammar_type_list_expr() -> GrammarExpr {
  dag_grammar_comma_list_expr(
    item: dag_grammar_nonterminal(production: ^dag_production_type_expr)
  )
}

fn dag_grammar_fn_type_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_fn),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lparen),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_type_list_expr()),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_rparen),
          right: dag_grammar_sequence(
            left: dag_grammar_terminal(token_class: ^dag_token_arrow),
            right: dag_grammar_nonterminal(production: ^dag_production_type_expr)
          )
        )
      )
    )
  )
}

fn dag_grammar_where_predicate_arg_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: ^dag_token_string_literal),
    right: dag_grammar_sequence(
      left: dag_grammar_ident_or_type_decl_modifier_name(),
      right: dag_grammar_optional(
        element: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_colon),
          right: dag_grammar_terminal(token_class: ^dag_token_int_literal)
        )
      )
    )
  )
}

// Predicate spellings and enforcement class live in
// gunbc.where_refinement_predicate_vocabulary (WherePredicateRow). Parse carries
// the authored spelling and does not mint a second table.
fn dag_grammar_where_predicate_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_ident_or_type_decl_modifier_name(),
    right: dag_grammar_optional(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lparen),
        right: dag_grammar_sequence(
          left: dag_grammar_optional(
            element: dag_grammar_comma_list_expr(item: dag_grammar_where_predicate_arg_expr())
          ),
          right: dag_grammar_terminal(token_class: ^dag_token_rparen)
        )
      )
    )
  )
}

// THE PREDICATES ARE SEPARATED BY A REQUIRED COMMA, as v1 02_parse parse_predicates_acc reads them:
// it continues only while it eats a comma and otherwise stops. The general comma list
// (dag_grammar_comma_list_expr) makes the separator optional, which let a clause run on into the
// identifiers that follow it -- `type T = String where brand("T")` followed by `service a.B { .. }`
// read `service` and `a` as two more predicates, since `service` is an exact-word identifier rather
// than a keyword, and refused the module at `.B`. No trailing comma: v1 reads none here.
fn dag_grammar_where_refinement_clause_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_where),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_where_predicate),
      right: dag_grammar_repeat(
        element: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_comma),
          right: dag_grammar_nonterminal(production: ^dag_production_where_predicate)
        )
      )
    )
  )
}

// An anonymous record is a type expression: `type AxisScan = { prefix: List<DeclarationRef>, causes:
// List<NonEmptyStr> }` (std.pareto), the ShLBrace arm of v1.compiler.parse parse_type_expr, which
// admits it in any type position. It is the same field_decl_block production a named record uses,
// so every consumer that classifies a fielded declaration (body_lower_is_structure_preserved_emitted)
// sees one production for both, and its fields are
// unlowered exactly as a named record's are (gunbc.rung_drop
// variant_fields_unlowered_on_the_native_route).
fn dag_grammar_type_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_qualified_type_expr(),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_fn_type),
      right: dag_grammar_nonterminal(production: ^dag_production_field_decl_block)
    )
  )
}

fn dag_grammar_import_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
    right: dag_grammar_sequence(
      left: dag_grammar_comma_list_expr(item: dag_grammar_ident_or_type_decl_modifier_name()),
      right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
    )
  )
}

fn dag_binding_name_keyword_tokens() -> List<Symbol> {
  [
    ^dag_token_kw_module,
    ^dag_token_kw_import,
    ^dag_token_kw_alias,
    ^dag_token_kw_type,
    ^dag_token_kw_data,
    ^dag_token_kw_fn,
    ^dag_token_kw_let,
    ^dag_token_kw_in,
    ^dag_token_kw_loop,
    ^dag_token_kw_match,
    ^dag_token_kw_if,
    ^dag_token_kw_then,
    ^dag_token_kw_else,
    ^dag_token_kw_true,
    ^dag_token_kw_false,
    ^dag_token_kw_where,
    ^dag_token_kw_as,
    ^dag_token_kw_return,
    ^dag_token_kw_nominal_opaque,
    ^dag_token_kw_sole_constructor
  ]
}

fn dag_grammar_binding_name_terminal() -> GrammarExpr {
  fold_list(
    xs: dag_binding_name_keyword_tokens(),
    empty: dag_grammar_terminal_lexeme(token_class: ^dag_token_ident),
    cons: fn(acc, tok) {
      dag_grammar_choice(
        left: acc,
        right: dag_grammar_terminal_lexeme(token_class: tok)
      )
    }
  )
}

// KeywordPattern is G0's only ident-text match, so the two type-decl modifiers are
// keywords. v1 still lexes them as ordinary idents (drop_leading_type_modifier /
// tok_is_ident_text). Every name site that is ident-only in v1 must therefore also
// admit these two token classes, or `^sole_constructor` and `data sole_constructor`
// become an undeclared narrowing. The `test` marker stays ident-only: it is not
// a keyword, and folding these classes into that production would admit
// `sole_constructor fn` as a marked item.
fn dag_grammar_ident_or_type_decl_modifier_name() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal_lexeme(token_class: ^dag_token_ident),
    right: dag_grammar_choice(
      left: dag_grammar_terminal_lexeme(token_class: ^dag_token_kw_nominal_opaque),
      right: dag_grammar_terminal_lexeme(token_class: ^dag_token_kw_sole_constructor)
    )
  )
}

fn dag_grammar_field_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_binding_name_terminal(),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_colon),
      right: dag_grammar_nonterminal(production: ^dag_production_type_expr)
    )
  )
}

// A field: the general field plus v1 parse_field's `[from "key"] [= default]` tail, which v1 admits on
// EVERY field. It was once scoped to the service io_block (review 68343), because a record type does
// lower and nothing then read the tail, so a grammar-only admission would have lowered the type and
// dropped the tail silently. Now the one field reader (v2.compiler.body_lowering_fold
// body_lower_field_items_optional) reads the tail on every field: an io block sets it aside and a
// record type refuses at it (body_lower_first_field_tail_optional, the
// service_interface_member_has_no_carrier class), so admitting it here parses a legitimate v1 form
// without dropping anything.
fn dag_grammar_io_field_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_field_decl_expr(),
    right: dag_grammar_sequence(
      left: dag_grammar_optional(
        element: dag_grammar_sequence(
          left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: ^from),
          right: dag_grammar_terminal(token_class: ^dag_token_string_literal)
        )
      ),
      right: dag_grammar_optional(
        element: dag_grammar_nonterminal(production: ^dag_production_default_value)
      )
    )
  )
}

// A DEFAULT VALUE (`= expr`) IS ONE PRODUCTION, shared by every position v1 admits one: a fn or
// pattern parameter, a service io field and a record field (v1 02_parse parse_param / parse_field).
// One production means one shape for the one carrier that reads it: the binder node, which carries an
// optional default (v2.std.node_query binder_node_parts). Every position lowers it onto its binder
// (v2.compiler.body_lowering_fold body_lower_binder_edge_read; XL-2 PR2c-ii).
fn dag_grammar_default_value_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_eq),
    right: dag_grammar_nonterminal(production: ^dag_production_expr)
  )
}

fn dag_grammar_field_decl_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(item: dag_grammar_io_field_decl_expr())
  )
}

fn dag_grammar_field_decl_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
    right: dag_grammar_sequence(
      left: dag_grammar_field_decl_list_helper(),
      right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
    )
  )
}

fn dag_grammar_fn_body_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_stmt_seq),
      right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
    )
  )
}

fn dag_grammar_stmt_seq_expr() -> GrammarExpr {
  dag_grammar_repeat(element: dag_grammar_nonterminal(production: ^dag_production_stmt))
}

// AN EXPRESSION STATEMENT NEVER BEGINS WITH A LET SPELLING. `name =` and `node name :` / `node name =`
// head the two let_sugar forms (dag_grammar_let_sugar_expr) and begin no expression, so the
// expression alternative is guarded by exactly those heads. The node head is all three tokens:
// a bare `node` statement followed on the next line by a statement that begins with a name (the
// next match arm, an `if`) begins `node name` too, and it is an expression; a two-token guard
// refused it while the sugar, lacking its `:` / `=`, refused it as well. So the guard is read at
// depth three: the two alternatives are disjoint by construction
// and the choice-overlap proof reads the guard. The guard captures nothing; the statement's tree is
// the expression's.
fn dag_grammar_let_sugar_head_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_binding_name_terminal(),
      right: dag_grammar_terminal(token_class: ^dag_token_eq)
    ),
    right: dag_grammar_sequence(
      left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "node")),
      right: dag_grammar_sequence(
        left: dag_grammar_binding_name_terminal(),
        right: dag_grammar_choice(
          left: dag_grammar_terminal(token_class: ^dag_token_colon),
          right: dag_grammar_terminal(token_class: ^dag_token_eq)
        )
      )
    )
  )
}

fn dag_grammar_stmt_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_kw_return),
      right: dag_grammar_nonterminal(production: ^dag_production_expr)
    ),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_let_expr),
      right: dag_grammar_sequence(
        left: grammar_expr_not_predicate(element: dag_grammar_let_sugar_head_expr()),
        right: dag_grammar_nonterminal(production: ^dag_production_expr)
      )
    )
  )
}

// A LET IS A STATEMENT, AND ITS VALUE ENDS THE LET. The expression form `let x = e in body` was
// dropped (statement `let` only, per the 2026-10-02 zero-ambiguity decisions): offered beside the
// statement form, the two shared `let name = value` and the choice picked by order. A value
// followed by `in` therefore refuses here, by name and at the `in` (LetInExpressionDropped), rather
// than as tokens left over; the guard is a not-predicate, so it captures nothing and a statement
// let's tree is unchanged.
fn dag_grammar_let_in_refusal_expr() -> GrammarExpr {
  grammar_expr_not_predicate(
    element: grammar_expr_refuse_on_match(element: dag_grammar_terminal(token_class: ^dag_token_kw_in), reason: LetInExpressionDropped)
  )
}

fn dag_grammar_let_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_kw_let),
        right: dag_grammar_sequence(
          left: dag_grammar_value_name_unconditional(),
          right: dag_grammar_choice(
            left: dag_grammar_sequence(
              left: dag_grammar_terminal(token_class: ^dag_token_colon),
              right: dag_grammar_sequence(
                left: dag_grammar_nonterminal(production: ^dag_production_type_expr),
                right: dag_grammar_sequence(
                  left: dag_grammar_terminal(token_class: ^dag_token_eq),
                  right: dag_grammar_nonterminal(production: ^dag_production_expr)
                )
              )
            ),
            right: dag_grammar_sequence(
              left: dag_grammar_terminal(token_class: ^dag_token_eq),
              right: dag_grammar_nonterminal(production: ^dag_production_expr)
            )
          )
        )
      ),
      right: dag_grammar_let_in_refusal_expr()
    ),
    right: dag_grammar_let_sugar_expr()
  )
}

// v1's TWO OTHER SPELLINGS OF A STATEMENT LET, as v1 02_parse reads them: `node x: e` / `node x = e`
// (parse_node_decl) and a bare `x = e` (parse_bare_assignment), each building the same ExprLet as
// `let x = e`. They are alternatives of THIS production, offered after both `let` forms, so they
// emit let_expr and lower through the one statement-let reader (v2.compiler.body_lowering_fold
// body_lower_let_sugar_optional names the binder and value for them). They begin with a name, so a
// statement that parses today -- which never begins `name =` or `node name :` -- is unaffected.
fn dag_grammar_let_sugar_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "node")),
      right: dag_grammar_sequence(
        left: dag_grammar_value_name_before(
          follow: dag_grammar_choice(
            left: dag_grammar_terminal(token_class: ^dag_token_colon),
            right: dag_grammar_terminal(token_class: ^dag_token_eq)
          )
        ),
        right: dag_grammar_sequence(
          left: dag_grammar_choice(
            left: dag_grammar_terminal(token_class: ^dag_token_colon),
            right: dag_grammar_terminal(token_class: ^dag_token_eq)
          ),
          right: dag_grammar_nonterminal(production: ^dag_production_expr)
        )
      )
    ),
    right: dag_grammar_sequence(
      left: dag_grammar_primary_name_expr(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_eq),
        right: dag_grammar_nonterminal(production: ^dag_production_expr)
      )
    )
  )
}

// THE ORDER IS THE MEANING HERE, SO IT IS ARGUED RATHER THAN LEFT TO READ AS ARBITRARY.
//
// `Choice` is ordered and the first alternative that succeeds is taken, so an alternative placed
// above a longer one that shares its prefix denies the longer one. `binary_expr` descends to
// `dag_grammar_primary_expr_core`, whose final alternatives are `match_expr`, `if_expr` and
// `loop_expr` -- a block-shaped expression is therefore ALREADY a legal binary operand by
// construction. While those three stood above `binary_expr`, `match a { ... } && b` committed to
// `match_expr`, which succeeded having consumed the match alone and left `&& b` reaching no
// production: the parse ended with tokens remaining. Nothing was unrepresentable; the alternative
// that represents it was never offered.
//
// `fn_literal`, `block_expr` and `arrow_lambda` stay ABOVE `binary_expr`, where they already were.
// That is not incidental: `primary_expr_core` admits a braced field-initializer list, so a
// `block_expr` offered after `binary_expr` could be taken as a record literal instead. Their first
// tokens are disjoint from `match`/`if`/`loop`, so moving those three below changes nothing
// between them.
//
// THE TRAILING `match_expr`/`if_expr`/`loop_expr` ALTERNATIVES WERE UNREACHABLE, AND ARE REMOVED.
// They are reachable exactly where `binary_expr` fails and they succeed. But `binary_expr` derives
// each of them as a complete operand -- pipe -> or -> and -> equality -> comparison -> additive ->
// multiplicative -> unary -> postfix -> primary -> primary_expr_core -> match_expr / if_expr /
// loop_expr, with every operator tail a `Repeat` or `Optional` that admits zero -- so wherever one
// of them matches at a position, `binary_expr` has already matched at least that much there and the
// ordered choice never tries them. Kept, they read as a second route to block forms that no input
// can take, and as a second row emit could select backward.
//
// Evidence: `v2.test.parse.block_expr_as_binary_operand_parse` -- two arms red before this reorder
// (a `match` and an `if` heading a binary chain), three controls green on both sides (each block
// form standing alone, and an operand that was never block-shaped).
// A BINARY EXPRESSION NEVER BEGINS AS AN ARROW LAMBDA DOES: `name =>`, or `( name ,` -- a grouped
// expression holds one expression, so a comma after its first name begins only a parameter list.
// The guard says so where the two alternatives meet, so they are disjoint by construction; the
// parenthesised head is three tokens, inside the declared lookahead (v2.compiler.parse
// grammar_choice_lookahead_depth).
fn dag_grammar_arrow_lambda_name_head_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_ident_or_type_decl_modifier_name(),
      right: dag_grammar_terminal(token_class: ^dag_token_fat_arrow)
    ),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lparen),
      right: dag_grammar_sequence(
        left: dag_grammar_ident_or_type_decl_modifier_name(),
        right: dag_grammar_terminal(token_class: ^dag_token_comma)
      )
    )
  )
}

// A BLOCK IN EXPRESSION POSITION NEVER BEGINS AS A BRACE LITERAL DOES: `{}`, `{ name :` or
// `{ "key" :`. `{}` in expression position is the empty brace literal, record or map by expected type
// (operator ruling 2026-10-03, A; docs/plans/map-literal-introduction-design.md reads a headless brace
// by expected type, and the corpus writes `body: { }`, `= {}` and `automatic: {}` as values), and an
// empty block as a value refuses. Positions with a block production of their own -- a fn body, an
// if or else arm, a loop, a fn literal's body, a match arm (dag_grammar_empty_block_body_expr) -- do
// not reach this choice for their block.

fn dag_grammar_block_literal_head_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: ^dag_token_rbrace),
      right: dag_grammar_sequence(
        left: dag_grammar_choice(
          left: dag_grammar_binding_name_terminal(),
          right: dag_grammar_terminal(token_class: ^dag_token_string_literal)
        ),
        right: dag_grammar_terminal(token_class: ^dag_token_colon)
      )
    )
  )
}

fn dag_grammar_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_fn_literal),
    right: dag_grammar_choice(
      left: dag_grammar_sequence(
        left: grammar_expr_not_predicate(element: dag_grammar_block_literal_head_expr()),
        right: dag_grammar_nonterminal(production: ^dag_production_block_expr)
      ),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: ^dag_production_arrow_lambda),
        right: dag_grammar_sequence(
          left: grammar_expr_not_predicate(element: dag_grammar_arrow_lambda_name_head_expr()),
          right: dag_grammar_nonterminal(production: ^dag_production_binary_expr)
        )
      )
    )
  )
}

fn dag_grammar_multiplicative_op_choice() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: ^dag_token_star),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: ^dag_token_slash),
      right: dag_grammar_terminal(token_class: ^dag_token_percent)
    )
  )
}

fn dag_grammar_additive_op_choice() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: ^dag_token_plus),
    right: dag_grammar_terminal(token_class: ^dag_token_minus)
  )
}

fn dag_grammar_comparison_op_choice() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: ^dag_token_gte),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: ^dag_token_lte),
      right: dag_grammar_choice(
        left: dag_grammar_terminal(token_class: ^dag_token_lt),
        right: dag_grammar_terminal(token_class: ^dag_token_gt)
      )
    )
  )
}

fn dag_grammar_equality_op_choice() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: ^dag_token_eq_eq),
    right: dag_grammar_terminal(token_class: ^dag_token_neq)
  )
}

fn dag_grammar_multiplicative_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_unary_expr),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_multiplicative_op_choice(),
        right: dag_grammar_nonterminal(production: ^dag_production_unary_expr)
      )
    )
  )
}

// A `-` THAT BEGINS A LINE AFTER A COMPLETE OPERAND REFUSES. `-` is both infix (subtraction) and
// prefix (negation), and this grammar carries no statement terminator, so `x` then a line `-1` could
// be `x - 1` or two statements; neither reading is safe to pick silently. The seed refuses it
// (v1.compiler.parse is_ambiguous_prefix_infix_newline_boundary, whose dual-role set is exactly
// `-`), and so does this row: where a `-` preceded by a line break (v2.std.grammar AfterLineBreak,
// read from the stream's layout) stands at an additive continuation, the parse refuses at the `-`
// with NewlineBeforeDualRoleOperator. A same-line `-` is subtraction. Every expression reaches this
// continuation, so the rule holds for every statement form -- including a block-headed statement,
// which is an operand since block forms are primaries of binary_expr (#12817).
// THE REFUSAL IS A GUARD, NOT AN ALTERNATIVE. Offered as a choice alternative beside subtraction,
// both arms began with `-` and only their order kept them apart -- the overlap the zero-ambiguity
// ruling (2026-10-02) forbids, inlined once per expansion of this helper. As the not-predicate of a
// refusing match it sits in SEQUENCE before the operator: it consumes nothing, it raises the
// refusal where the line-break `-` stands (a refusal survives the predicate, v2.compiler.parse
// parse_expr_not_predicate), and elsewhere it admits, so the continuation is one route and no
// choice remains here to overlap.
fn dag_grammar_additive_newline_minus_guard() -> GrammarExpr {
  grammar_expr_not_predicate(
    element: grammar_expr_refuse_on_match(
      element: grammar_expr_after_line_break(element: dag_grammar_terminal(token_class: ^dag_token_minus)),
      reason: NewlineBeforeDualRoleOperator
    )
  )
}

fn dag_grammar_additive_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_multiplicative_expr_helper(),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_additive_newline_minus_guard(),
        right: dag_grammar_sequence(
          left: dag_grammar_additive_op_choice(),
          right: dag_grammar_multiplicative_expr_helper()
        )
      )
    )
  )
}

fn dag_grammar_comparison_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_additive_expr_helper(),
    right: dag_grammar_optional(
      element: dag_grammar_sequence(
        left: dag_grammar_comparison_op_choice(),
        right: dag_grammar_additive_expr_helper()
      )
    )
  )
}

fn dag_grammar_equality_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_comparison_expr_helper(),
    right: dag_grammar_optional(
      element: dag_grammar_sequence(
        left: dag_grammar_equality_op_choice(),
        right: dag_grammar_comparison_expr_helper()
      )
    )
  )
}

fn dag_grammar_and_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_equality_expr_helper(),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_and_and),
        right: dag_grammar_equality_expr_helper()
      )
    )
  )
}

fn dag_grammar_or_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_and_expr_helper(),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_or_or),
        right: dag_grammar_and_expr_helper()
      )
    )
  )
}

fn dag_grammar_pipe_expr_helper() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_or_expr_helper(),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_pipe_gt),
        right: dag_grammar_or_expr_helper()
      )
    )
  )
}

fn dag_grammar_binary_expr_expr() -> GrammarExpr {
  dag_grammar_pipe_expr_helper()
}

fn dag_grammar_unary_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_bang),
      right: dag_grammar_nonterminal(production: ^dag_production_unary_expr)
    ),
    right: dag_grammar_choice(
      left: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_minus),
        right: dag_grammar_nonterminal(production: ^dag_production_unary_expr)
      ),
      right: dag_grammar_nonterminal(production: ^dag_production_postfix_expr)
    )
  )
}

fn dag_grammar_arg_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(item: dag_grammar_nonterminal(production: ^dag_production_arg))
  )
}

fn dag_grammar_field_init_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(
      item: dag_grammar_nonterminal(production: ^dag_production_field_init)
    )
  )
}

fn dag_grammar_pattern_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(
      item: dag_grammar_nonterminal(production: ^dag_production_pattern)
    )
  )
}

fn dag_grammar_field_pattern_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(
      item: dag_grammar_nonterminal(production: ^dag_production_field_pattern)
    )
  )
}

fn dag_grammar_expr_list_helper() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_comma_list_expr(item: dag_grammar_nonterminal(production: ^dag_production_expr))
  )
}

fn dag_grammar_untyped_params_helper() -> GrammarExpr {
  dag_grammar_comma_list_expr(item: dag_grammar_ident_or_type_decl_modifier_name())
}

fn dag_grammar_postfix_call_suffix_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lparen),
    right: dag_grammar_sequence(
      left: dag_grammar_arg_list_helper(),
      right: dag_grammar_terminal(token_class: ^dag_token_rparen)
    )
  )
}

// A dotted suffix takes the SAME optional suffix a bare ident takes (dag_grammar_primary_ident_suffix_expr):
// a call suffix OR a brace field-init list. Before this the dotted arm admitted a call suffix only, so
// `a.b.C` consumed as a complete postfix expression and the `{ f: v }` after it was left over -- which is
// why v2 could not read a fully-qualified record literal that v1 accepts. The leftover surfaced at a
// different stage per position (parse in a match arm, normalize at a fn tail, and in a call argument it
// parsed as a SECOND argument), so the spelling axis and the position axis had to be crossed to see it.
fn dag_grammar_postfix_dot_suffix_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_dot),
    right: dag_grammar_sequence(
      left: dag_grammar_binding_name_terminal(),
      right: dag_grammar_primary_ident_suffix_expr()
    )
  )
}

fn dag_grammar_postfix_as_suffix_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_as),
    right: dag_grammar_nonterminal(production: ^dag_production_type_expr)
  )
}

fn dag_grammar_postfix_expr_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_primary_expr),
    right: dag_grammar_repeat(
      element: dag_grammar_choice(
        left: dag_grammar_postfix_dot_suffix_expr(),
        right: dag_grammar_postfix_as_suffix_expr()
      )
    )
  )
}

fn dag_grammar_primary_ident_suffix_expr() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_choice(
      left: dag_grammar_postfix_call_suffix_expr(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_field_init_list_helper(),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      )
    )
  )
}

// The name a caret symbol carries is lexeme-stamped like every other declared name
// (dag_grammar_ident_or_type_decl_modifier_name), so `^a` and `^b` publish different identities
// and v2.compiler.body_lowering_fold lowers the pair to a symbol literal (dag_symbol_literal_node).
// Until MQ-1 PR-2 this site was class-stamped and published the generic ^dag_token_ident for
// every caret literal, which is how two different symbols reached one lowered node.
fn dag_grammar_caret_symbol_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_caret),
    right: dag_grammar_ident_or_type_decl_modifier_name()
  )
}

fn dag_grammar_primary_expr_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_caret_symbol_expr(),
    right: dag_grammar_primary_expr_core()
  )
}

// Interim: primary_expr_core and pattern_expr stamp int_literal with StampLexeme (was StampClass)
// so census-path operands carry distinct lexeme identities resolvable through body lowering.
// dissolve-on: ^migrate_when_general_body_producer_lands — general integer-literal ingestion
// supersedes grammar-level lexeme stamping. Fixture pick tokens (dag_pick_concrete_tokens) retain
// dag_grammar_pick_arm_literal_terminal with StampClass + branded bindings.

// `module` names a value in expression position (std.cross_tree.resolution
// `SourceRootBinding { module: module, root: root }`): it is already a binding name for
// parameters, labels and members (dag_binding_name_keyword_tokens), and v1 reads it as an ordinary
// identifier here. `data` is admitted for the same reason (extdeps.google.sheets writes
// `data: data` in a transport body, naming its io field `data`): it heads a data declaration, which
// is module-level only, so nothing else can begin an expression with it. v1 reads EVERY keyword as a
// name here except the literal keywords and the six that head expressions of their own
// (02_parse parse_primary, dag_non_name_keywords); v2 admits only the declaration-heading keywords a
// source has needed, because a clause keyword (`else`, `then`, `in`, `as`) admitted as a value
// could begin a new statement where the grammar expects the clause. `if`, `match` and `let` head
// expressions of their own and stay out.
fn dag_grammar_primary_name_expr() -> GrammarExpr {
  fold_list(
    xs: dag_contextual_value_name_keywords(),
    empty: dag_grammar_ident_or_type_decl_modifier_name(),
    cons: fn(acc, tok) { dag_grammar_choice(left: acc, right: dag_grammar_terminal_lexeme(token_class: tok)) }
  )
}

// THE KEYWORDS THAT ARE ALSO VALUE NAMES, DECLARED ONCE. `module` and `data` head declarations only, so
// neither can continue or begin an expression of its own, and the corpus names values with them
// (`SourceRootBinding { module: module }`, 136 parameters named `module`). They are admitted as value
// names at BOTH ends: a reference reads them through dag_grammar_primary_name_expr, and a binder IS that
// same production behind the keyword guard (dag_grammar_value_name_before / _unconditional), so a name
// can be declared exactly when it can be referenced -- no declare-but-cannot-use asymmetry. Every other
// keyword at a value-binder position refuses as KeywordAsValueName (operator ruling via the N7 manager,
// 2026-10-03: contextual, symmetric, one set). Adding a keyword here is a language decision: it must
// head nothing that can follow an expression.
fn dag_contextual_value_name_keywords() -> List<Symbol> {
  [^dag_token_kw_module, ^dag_token_kw_data]
}

fn dag_grammar_primary_expr_core() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_primary_name_expr(),
      right: dag_grammar_primary_ident_suffix_expr()
    ),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: ^dag_token_int_literal),
      right: dag_grammar_choice(
        left: dag_grammar_terminal(token_class: ^dag_token_float_literal),
        right: dag_grammar_choice(
          left: dag_grammar_terminal(token_class: ^dag_token_string_literal),
          right: dag_grammar_choice(
            left: dag_grammar_terminal(token_class: ^dag_token_kw_true),
            right: dag_grammar_choice(
              left: dag_grammar_terminal(token_class: ^dag_token_kw_false),
              right: dag_grammar_choice(
                left: dag_grammar_sequence(
                  left: dag_grammar_terminal(token_class: ^dag_token_lbracket),
                  right: dag_grammar_sequence(
                    left: dag_grammar_expr_list_helper(),
                    right: dag_grammar_terminal(token_class: ^dag_token_rbracket)
                  )
                ),
                right: dag_grammar_choice(
                  left: dag_grammar_sequence(
                    left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
                    right: dag_grammar_sequence(
                      left: dag_grammar_field_init_list_helper(),
                      right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
                    )
                  ),
                  right: dag_grammar_choice(
                    left: dag_grammar_sequence(
                      left: dag_grammar_terminal(token_class: ^dag_token_lparen),
                      right: dag_grammar_sequence(
                        left: dag_grammar_nonterminal(production: ^dag_production_expr),
                        right: dag_grammar_terminal(token_class: ^dag_token_rparen)
                      )
                    ),
                    right: dag_grammar_choice(
                      left: dag_grammar_nonterminal(production: ^dag_production_match_expr),
                      right: dag_grammar_choice(
                        left: dag_grammar_nonterminal(production: ^dag_production_if_expr),
                        right: dag_grammar_nonterminal(production: ^dag_production_loop_expr)
                      )
                    )
                  )
                )
              )
            )
          )
        )
        )
    )
  )
}

fn dag_grammar_block_expr_expr() -> GrammarExpr {
  dag_grammar_nonterminal(production: ^dag_production_fn_body)
}

// A NAMED ARGUMENT AND A POSITIONAL ONE ARE DISJOINT BY CONSTRUCTION. Both can begin with a name;
// only the named one continues `name :`. The positional alternative is guarded by the not-predicate
// over exactly that head, so it refuses every input the named one denotes, and the choice-overlap
// proof (v2.compiler.parse lookahead_alternatives_overlap) reads the guard and clears the row. The
// guard captures nothing, so the positional argument's tree is the expression's, as before.
fn dag_grammar_arg_named_head_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_binding_name_terminal(),
    right: dag_grammar_terminal(token_class: ^dag_token_colon)
  )
}

fn dag_grammar_arg_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_binding_name_terminal(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_colon),
        right: dag_grammar_nonterminal(production: ^dag_production_expr)
      )
    ),
    right: dag_grammar_sequence(
      left: grammar_expr_not_predicate(element: dag_grammar_arg_named_head_expr()),
      right: dag_grammar_nonterminal(production: ^dag_production_expr)
    )
  )
}

// A FIELD INIT IS KEYED BY A NAME OR BY A STRING, AND THE PARSE SAYS WHICH. The two keys are two
// alternatives of one choice, and the string alternative is its own production
// (^dag_production_field_init_string_key, emitted ^dag_surface_field_init_string_key), so the key's
// kind is carried by the parse tree as a production identity -- the same fact every reader
// dispatches on -- rather than recovered later from a key atom's spelling. A record literal's field
// is the name alternative; a map literal's entry is the string alternative.
fn dag_grammar_field_init_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_binding_name_terminal(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_colon),
        right: dag_grammar_nonterminal(production: ^dag_production_expr)
      )
    ),
    right: dag_grammar_nonterminal(production: ^dag_production_field_init_string_key)
  )
}

// THE STRING KEY IS THE CLASS-STAMPED STRING TERMINAL -- the one string terminal, whose node carries
// the literal's decoded value (gunbc#12759) -- never a second, spelling-stamped one.
fn dag_grammar_field_init_string_key_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_string_literal),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_colon),
      right: dag_grammar_nonterminal(production: ^dag_production_expr)
    )
  )
}

fn dag_grammar_match_expr_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_match),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_binary_expr),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_optional(
            element: dag_grammar_comma_list_expr(item: dag_grammar_nonterminal(production: ^dag_production_match_arm))
          ),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      )
    )
  )
}

// A STATEMENT BODY ENDS WHERE THE NEXT ARM BEGINS. Arms need no separator (dag_grammar_comma_list_expr
// makes the comma optional), and an arm head such as `Foo =>` begins with something that also parses
// as an expression statement, so under ordered repetition a bare `stmt*` reads the next arm's
// pattern as one more statement of this body. Each statement is therefore guarded by the PEG
// not-predicate over the arm head: `(!(pattern =>) stmt) (!(pattern =>) stmt)*`. The predicate
// captures nothing, so the parsed body is the same statement spine `stmt stmt*` derives.
fn dag_grammar_match_arm_stmt_body_statement() -> GrammarExpr {
  dag_grammar_sequence(
    left: grammar_expr_not_predicate(
      element: dag_grammar_sequence(
        left: dag_grammar_nonterminal(production: ^dag_production_pattern),
        right: dag_grammar_terminal(token_class: ^dag_token_fat_arrow)
      )
    ),
    right: dag_grammar_nonterminal(production: ^dag_production_stmt)
  )
}

fn dag_grammar_match_arm_stmt_body_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_match_arm_stmt_body_statement(),
    right: dag_grammar_repeat(element: dag_grammar_match_arm_stmt_body_statement())
  )
}

// AN ARM BODY IS ONE PRODUCTION: a statement sequence of one or more statements. An expression
// body is the one-statement case, so it is not a second alternative: offered beside the statement
// body, the two shared every expression-led input and the choice picked the expression. The arm
// body lowers through body_lower_stmt_spine (v2.compiler.body_lowering_fold
// body_lower_match_arm_body_lowered), whose last statement is the value, exactly as a fn body's.
// AN EMPTY ARM BODY `{}` IS AN EMPTY BLOCK, NOT A VALUE. In expression position `{}` is the empty
// brace literal (dag_grammar_block_literal_head_expr); an arm body is a body position, where `{}`
// has always meant an empty block (`Absent => {}`, forty arms across the effect workflows). So the
// arm offers it as its own production, and the statement body is guarded against exactly `{ }`: the
// two are disjoint by construction, and an empty block still lowers as one (it has no statement, so
// it refuses as statement_spine_headless, as an empty block did before).
fn dag_grammar_empty_block_body_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
    right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
  )
}

fn dag_grammar_match_arm_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_pattern),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_fat_arrow),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: ^dag_production_empty_block_body),
        right: dag_grammar_sequence(
          left: grammar_expr_not_predicate(element: dag_grammar_empty_block_body_expr()),
          right: dag_grammar_nonterminal(production: ^dag_production_match_arm_stmt_body)
        )
      )
    )
  )
}

fn dag_grammar_constructor_pattern_suffix_expr() -> GrammarExpr {
  dag_grammar_optional(
    element: dag_grammar_choice(
      left: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_field_pattern_list_helper(),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      ),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lparen),
        right: dag_grammar_sequence(
          left: dag_grammar_pattern_list_helper(),
          right: dag_grammar_terminal(token_class: ^dag_token_rparen)
        )
      )
    )
  )
}

fn dag_grammar_constructor_pattern_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_qualified_name),
    right: dag_grammar_constructor_pattern_suffix_expr()
  )
}

fn dag_grammar_pattern_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_constructor_pattern_expr(),
    right: dag_grammar_choice(
      left: dag_grammar_terminal(token_class: ^dag_token_kw_true),
      right: dag_grammar_choice(
        left: dag_grammar_terminal(token_class: ^dag_token_kw_false),
        right: dag_grammar_choice(
          left: dag_grammar_terminal(token_class: ^dag_token_int_literal),
          right: dag_grammar_choice(
            left: dag_grammar_terminal(token_class: ^dag_token_float_literal),
            right: dag_grammar_terminal(token_class: ^dag_token_string_literal)
          )
        )
      )
    )
  )
}

// `name: pattern` or the punned `name`: LEFT-FACTORED on the shared binding name, so the field name is
// read once and the `: pattern` suffix is optional (operator zero_ambiguity_ruling 2026-10-02; it was a
// choice of the two forms, both led by the same name). A punned field captures `(name, <empty>)`.
fn dag_grammar_field_pattern_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_field_pattern_binder_guard(admit_bool_literals: false),
    right: dag_grammar_sequence(
      left: dag_grammar_binding_name_terminal(),
      right: dag_grammar_optional(
        element: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_colon),
          right: dag_grammar_sequence(
            left: dag_grammar_field_pattern_binder_guard(admit_bool_literals: true),
            right: dag_grammar_nonterminal(production: ^dag_production_pattern)
          )
        )
      )
    )
  )
}

// ONE `if`, ITS HEAD READ ONCE. `if cond` is shared by the two forms, so it is the production's
// prefix and the forms are the choice after it: `then` begins the expression form, a block the
// block form, so the next token decides (they were two alternatives repeating the head, an overlap
// no bounded lookahead decides).
//
// THE BLOCK FORM'S `else` IS OPTIONAL, and an `if` without one has no value. That is a fact about
// the value category, not an ambiguity deferred past the parser: the parse is unique either way
// (operator ruling 2026-10-03, for this case only). At statement position, where no value is owed,
// an else-less `if` whose block ends in a return is the early-return guard
// (v2.compiler.body_lowering_fold body_lower_admitted_guard_optional); wherever a value is required
// it refuses at lowering, typed and located, as body_lowering_reason_else_less_if_unlowered. A tree
// with an else is the one the two-form grammar built: a present optional and a choice each pass
// their element through.
fn dag_grammar_if_else_tail_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_else),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_if_expr),
      right: dag_grammar_nonterminal(production: ^dag_production_fn_body)
    )
  )
}

fn dag_grammar_if_block_form_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_fn_body),
    right: dag_grammar_optional(element: dag_grammar_if_else_tail_expr())
  )
}

fn dag_grammar_if_then_form_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_then),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_expr),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_kw_else),
        right: dag_grammar_nonterminal(production: ^dag_production_expr)
      )
    )
  )
}

fn dag_grammar_loop_expr_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_loop),
    right: dag_grammar_nonterminal(production: ^dag_production_expr)
  )
}

fn dag_grammar_if_expr_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_if),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_expr),
      right: dag_grammar_choice(
        left: dag_grammar_if_then_form_expr(),
        right: dag_grammar_if_block_form_expr()
      )
    )
  )
}

fn dag_grammar_fn_literal_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_fn),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lparen),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_untyped_params_helper()),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_rparen),
          right: dag_grammar_sequence(
            left: dag_grammar_optional(
              element: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: ^dag_token_arrow),
                right: dag_grammar_nonterminal(production: ^dag_production_type_expr)
              )
            ),
            right: dag_grammar_nonterminal(production: ^dag_production_fn_body)
          )
        )
      )
    )
  )
}

// Arrow lambda, mirroring the v1 frontend's admission exactly (v1_compiler_parse.rs
// parse_ident_expr / try_lambda_params): a single BARE ident before `=>`, or a
// PARENTHESIZED comma list of two or more idents — v1 treats `()` as the empty
// record literal and `(x)` as a parenthesized expression, so neither is a lambda
// and neither is admitted here. Parse-admitting only (CI2-0): the captured node
// is a grammar-shaped surface for normalize to wrapper-retain, never a fabricated
// semantic form. The single-ident form's FIRST set overlaps binary_expr's, so the
// expr-level choice routes through the ordered backtrack residue by construction.
fn dag_grammar_arrow_lambda_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_sequence(
      left: dag_grammar_ident_or_type_decl_modifier_name(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_fat_arrow),
        right: dag_grammar_arrow_lambda_body_expr()
      )
    ),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lparen),
      right: dag_grammar_sequence(
        left: dag_grammar_ident_or_type_decl_modifier_name(),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_comma),
          right: dag_grammar_sequence(
            left: dag_grammar_ident_or_type_decl_modifier_name(),
            right: dag_grammar_sequence(
              left: dag_grammar_repeat(
                element: dag_grammar_sequence(
                  left: dag_grammar_terminal(token_class: ^dag_token_comma),
                  right: dag_grammar_ident_or_type_decl_modifier_name()
                )
              ),
              right: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: ^dag_token_rparen),
                right: dag_grammar_sequence(
                  left: dag_grammar_terminal(token_class: ^dag_token_fat_arrow),
                  right: dag_grammar_arrow_lambda_body_expr()
                )
              )
            )
          )
        )
      )
    )
  )
}

// A LAMBDA'S BODY IS AN EXPRESSION, OR A STATEMENT SEQUENCE THAT BEGINS WITH A LET. The unbraced
// form `r =>` / `let slug = f(r)` / `[a, b]` ends where the enclosing argument list continues: no
// statement begins with `,` or `)`, so the repetition stops there by construction. The two
// alternatives are disjoint: the statement body's first statement is a let (dag_grammar_let_expr,
// with its two sugar spellings), and the expression alternative is guarded by exactly the let-sugar
// heads (dag_grammar_let_sugar_head_expr) -- the same guard the expression statement carries, since
// `let` itself begins no expression. A body that does not begin with a let is an expression, as it
// always was.
fn dag_grammar_arrow_lambda_body_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_lambda_stmt_body),
    right: dag_grammar_sequence(
      left: grammar_expr_not_predicate(element: dag_grammar_let_sugar_head_expr()),
      right: dag_grammar_nonterminal(production: ^dag_production_expr)
    )
  )
}

// The statement body is the spine `head stmt*` that body_lower_stmt_spine reads for every statement
// sequence: its head is a statement whose captured child is a let (lambda_let_stmt, so its first
// token is a let head and nothing else), its rest the ordinary statements.
fn dag_grammar_lambda_stmt_body_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_lambda_let_stmt),
    right: dag_grammar_repeat(element: dag_grammar_nonterminal(production: ^dag_production_stmt))
  )
}

fn dag_grammar_import_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_import),
    right: dag_grammar_sequence(
      left: dag_grammar_declared_path_expr(),
      right: dag_grammar_optional(element: dag_grammar_nonterminal(production: ^dag_production_import_block))
    )
  )
}

fn dag_grammar_alias_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_alias),
    right: dag_grammar_sequence(
      left: dag_grammar_ident_or_type_decl_modifier_name(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_eq),
        right: dag_grammar_nonterminal(production: ^dag_production_qualified_name)
      )
    )
  )
}

fn dag_grammar_type_variant_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_type_expr),
    right: dag_grammar_sequence(
      left: dag_grammar_optional(
        element: dag_grammar_nonterminal(production: ^dag_production_where_refinement_clause)
      ),
      right: dag_grammar_optional(
        element: dag_grammar_choice(
          left: dag_grammar_nonterminal(production: ^dag_production_field_decl_block),
          right: dag_grammar_nonterminal(production: ^dag_production_positional_variant_payload)
        )
      )
    )
  )
}

// A variant's payload has two spellings of one field list: `Name { f: T }` and the
// positional `Name(T)`, which v1.compiler.parse parse_positional_variant_type_fields reads as
// exactly one field named "0". Positional arity is ONE, as in v1: `Name(T, U)` still refuses
// (tokens remain), so this row admits nothing the seed does not. It lives only in the
// variant slot -- `type R(T)` is not a type_decl body in v1, and it is not one here. The consumer
// that treats a fielded variant as structure, body_lower_is_structure_preserved_emitted, names this
// production beside dag_surface_field_decl_block.
fn dag_grammar_positional_variant_payload_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lparen),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_type_expr),
      right: dag_grammar_terminal(token_class: ^dag_token_rparen)
    )
  )
}

fn dag_grammar_type_alias_rhs_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_type_variant),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_pipe),
        right: dag_grammar_nonterminal(production: ^dag_production_type_variant)
      )
    )
  )
}

// The coproduct form may open with a separator: `type H =\n  | A\n  | B`, the layout most
// multi-line sums in the corpus use and v1.compiler.parse admits. The leading `|` is consumed by
// its own production, before the type_alias_rhs nonterminal, so the rhs production's captured
// shape -- variant, then (pipe variant)* -- is the same with or without it; and sugar
// (v2.std.compilers.sugar sugar_rule_type_alias_rhs_lead) lowers this production to that rhs, so
// the separator leaves no trace after normalize. A bare `|` with no variant after it refuses: the
// optional is a prefix of the rhs, never a substitute for it.
fn dag_grammar_type_alias_rhs_lead_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_optional(element: dag_grammar_terminal(token_class: ^dag_token_pipe)),
    right: dag_grammar_nonterminal(production: ^dag_production_type_alias_rhs)
  )
}

// v1.compiler.parse type_body_tokens_after_modifiers drops at most two leading idents after
// the type name and optional generics: first `nominal_opaque`, then `sole_constructor`
// (drop_leading_type_modifier). G0 has no ident-text match, so the closed set is encoded as
// keyword tokens rather than an optional ident — an optional ident would accept any word in
// that slot and widen past v1. Order is the same two optional drops: reversed or unknown
// spellings remain tokens-remain refusals.
//
// PARSE ADMISSION IS NOT THE SEALING PROPERTY. v1 mints only sole_constructor, via
// parsed_sole_constructor_properties. On the native route the slot is read back off the parse by
// v2.compiler.body_lowering_fold body_lower_type_decl_declared_modifiers, carried on NormalizedTree
// type_declaration_modifiers, and ENFORCED by v2.compiler.construction_confinement (the retired
// drop gunbc.rung_drop.g0_type_decl_modifier_parse_without_sealing_property).
fn dag_grammar_type_decl_modifiers_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_optional(
      element: dag_grammar_terminal(token_class: ^dag_token_kw_nominal_opaque)
    ),
    right: dag_grammar_optional(
      element: dag_grammar_terminal(token_class: ^dag_token_kw_sole_constructor)
    )
  )
}

fn dag_grammar_type_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_type),
    right: dag_grammar_sequence(
      left: dag_grammar_ident_or_type_decl_modifier_name(),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_nonterminal(production: ^dag_production_generic_params)),
        right: dag_grammar_sequence(
          left: dag_grammar_type_decl_modifiers_expr(),
          right: dag_grammar_optional(
            element: dag_grammar_choice(
              left: dag_grammar_nonterminal(production: ^dag_production_field_decl_block),
              right: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: ^dag_token_eq),
                right: dag_grammar_nonterminal(production: ^dag_production_type_alias_rhs_lead)
              )
            )
          )
        )
      )
    )
  )
}

fn dag_grammar_data_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_data),
    right: dag_grammar_sequence(
      left: dag_grammar_ident_or_type_decl_modifier_name(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_colon),
        right: dag_grammar_sequence(
          left: dag_grammar_nonterminal(production: ^dag_production_type_expr),
          right: dag_grammar_sequence(
            left: dag_grammar_terminal(token_class: ^dag_token_eq),
            right: dag_grammar_expect(
              element: dag_grammar_nonterminal(production: ^dag_production_expr),
              reason: DataValueMissingAfterEq
            )
          )
        )
      )
    )
  )
}

// `admit_callers: [decl_ref(..), ..]` between a fn's signature and its body names the only
// declarations allowed to call it (std.integer qualified_octets). v1.compiler.parse
// parse_optional_admit_callers reads it as a field-init on the fn node and refuses an empty list;
// the list here requires a first element for the same reason, so `admit_callers: []` still refuses.
// A trailing comma before `]` is admitted, as dag_grammar_comma_list_expr admits it and as v1 reads
// the list; without it every multi-line caller list written with one refused its whole module.
// `admit_callers` is matched as an exact-word terminal and stays an ordinary identifier everywhere
// else. The fn's Arrow does not carry the clause: normalize reads it off the parse
// (v2.compiler.body_lowering_fold body_lower_fn_decl_declared_admitted_callers) and
// v2.compiler.construction_confinement enforces it (the retired drop gunbc.rung_drop
// admit_callers_discarded_on_the_native_route).
// `uses net: Network, fs: Filesystem` after a fn's return clause declares the resources the fn
// requires, as v1 02_parse parse_uses_clause reads it: one or more comma-separated entries, each a
// name, a type and an optional parenthesised config. `uses` is matched as an exact-word terminal and
// stays an ordinary identifier everywhere else. The clause PARSES; it does not lower yet: v2 has no
// carrier for a fn's resource requirement, so v2.compiler.body_lowering_fold refuses every fn that
// carries one, located at the clause (body_lowering_reason_uses_clause_unmodeled), rather than
// lowering the fn and dropping the requirement.
fn dag_grammar_uses_clause_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "uses")),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_uses_entry),
      right: dag_grammar_repeat(
        element: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_comma),
          right: dag_grammar_nonterminal(production: ^dag_production_uses_entry)
        )
      )
    )
  )
}

fn dag_grammar_uses_entry_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_binding_name_terminal(),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_colon),
      right: dag_grammar_sequence(
        left: dag_grammar_nonterminal(production: ^dag_production_type_expr),
        right: dag_grammar_optional(
          element: dag_grammar_sequence(
            left: dag_grammar_terminal(token_class: ^dag_token_lparen),
            right: dag_grammar_sequence(
              left: dag_grammar_field_init_list_helper(),
              right: dag_grammar_terminal(token_class: ^dag_token_rparen)
            )
          )
        )
      )
    )
  )
}

fn dag_grammar_admit_callers_clause_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(
      token_class: ^dag_token_ident,
      lexeme: symbol_intern_lexeme(lexeme: "admit_callers")
    ),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_colon),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbracket),
        right: dag_grammar_sequence(
          left: dag_grammar_nonterminal(production: ^dag_production_expr),
          right: dag_grammar_sequence(
            left: dag_grammar_repeat(
              element: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: ^dag_token_comma),
                right: dag_grammar_nonterminal(production: ^dag_production_expr)
              )
            ),
            right: dag_grammar_sequence(
              left: dag_grammar_optional(element: dag_grammar_terminal(token_class: ^dag_token_comma)),
              right: dag_grammar_terminal(token_class: ^dag_token_rbracket)
            )
          )
        )
      )
    )
  )
}

// A POSITIONAL READER DEPENDS ON THIS SPINE, so adding or reordering a constituent here is a
// change to that reader's contract and not a local grammar edit.
// v2.compiler.body_lowering_fold `body_lower_fn_decl_return_clause_optional` reaches the return
// clause by walking the sequence spine RIGHT FOUR TIMES from the production's captured child and
// taking the left, rather than by searching the subtree for an arrow -- searching is what
// returned a PARAMETER's fn-type arrow as the function's return type before #12062, and the class
// is gunbc.recurring_failure_mode a_positional_fact_is_obtained_by_searching_for_its_shape.
//
// WHAT THAT READER RELIES ON, stated so it is checkable rather than folded into its own comment:
// this production has FOUR optionals, and only generic_params precedes the return clause, so
// generic_params is the entire risk surface for the depth. The uses clause and the admit_callers
// clause are the third and fourth and sit AFTER the return clause, so they do not shift the depth
// this reader walks.
// An elided optional still occupies
// its slot -- v2.compiler.parse `parse_expr_optional` returns grammar_empty_node on the rejected
// arm -- so the depth does not shift when it is absent. Both arms are held by executing claims in
// test.claim.parse_test_fn_decl_return_clause
// (`nfbcp_falsifier_generic_fn_return_type_holds`, `nfbcp_falsifier_eq_body_fn_return_type_holds`),
// so INSERTING ANY FURTHER OPTIONAL AHEAD OF THE RETURN CLAUSE REDDENS THEM rather than silently
// shifting the read by one. That is the wall; this note is the reason it exists.
// `pattern name(..) -> T { .. }` IS A FN (v1 dag syntax dag_item_forms: the fn prefix with a block
// body, called as a fn by its importers), so it is an alternative HEAD of this one production and
// lowers through the one fn lowering; there is no second declaration kind.
fn dag_grammar_fn_decl_head_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_fn),
    right: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "pattern"))
  )
}

fn dag_grammar_fn_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_fn_decl_head_expr(),
    right: dag_grammar_sequence(
      left: dag_grammar_ident_or_type_decl_modifier_name(),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_nonterminal(production: ^dag_production_generic_params)),
        right: dag_grammar_sequence(
          left: dag_grammar_nonterminal(production: ^dag_production_param_list),
          right: dag_grammar_sequence(
            left: dag_grammar_optional(
              element: dag_grammar_sequence(
                left: dag_grammar_terminal(token_class: ^dag_token_arrow),
                right: dag_grammar_nonterminal(production: ^dag_production_type_expr)
              )
            ),
            right: dag_grammar_sequence(
              left: dag_grammar_optional(
                element: dag_grammar_nonterminal(production: ^dag_production_uses_clause)
              ),
              right: dag_grammar_sequence(
                left: dag_grammar_optional(
                  element: dag_grammar_nonterminal(production: ^dag_production_admit_callers_clause)
                ),
                right: dag_grammar_choice(
                  left: dag_grammar_nonterminal(production: ^dag_production_fn_body),
                  right: dag_grammar_sequence(
                    left: dag_grammar_terminal(token_class: ^dag_token_eq),
                    right: dag_grammar_expect(
                      element: dag_grammar_nonterminal(production: ^dag_production_expr),
                      reason: FnExpressionBodyMissingAfterEq
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

// `test fn` IS A CONTEXTUAL PRODUCTION, NOT A RESERVED KEYWORD. `test` stays an ordinary identifier
// everywhere else — dag/extdeps/languages/typescript/program.dag models the TypeScript
// compiler's own `Cond { test: ... }` field under §3's real-upstream-names rule, and a reserved
// kw_test would break that module's parse. In THIS position the marker is the EXACT WORD `test`, a
// literal terminal, as `service` and `resource` are: the top-level choice is then three distinct
// exact words beside the keyword-led alternatives, disjoint by construction (operator
// zero_ambiguity_ruling 2026-10-02). It used to match ANY identifier and leave a reader to refuse a
// marker other than "test", so the marker overlapped `service`/`resource` and the check sat
// downstream of the grammar. Another identifier in marker position refuses in the grammar, located
// (dag_grammar_module_expr, DeclarationMarkerNotTest).
fn dag_grammar_test_fn_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "test")),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_fn_decl),
      right: dag_grammar_nonterminal(production: ^dag_production_data_decl)
    )
  )
}

// SERVICE FAMILY — stated difference from v1.compiler.parse.
// v1 parse_service_def / parse_service_after_kw / parse_service_entries admit
// `service` Name `{` (config | transport | operation)* `}`; parse_operation_def
// then admits a braced v1 body (input/output/idempotent/readonly/hermetic/
// transport/exit/response/mock_response) or the parenthesized v2-inline form.
// G0 had none of those productions. Every marker word in this nest -- `service`, `operation`,
// `input`, `output`, the modifiers, `transport`, `from`, `exit`, `response`, `mock_response` -- is
// a LITERAL TERMINAL over `dag_token_ident` (`v2.std.grammar` `LiteralTerminal`), never a keyword
// token class. That is a measured choice, not a preference: minting a class per word taxed EVERY
// identifier the lexer reads and every name slot the grammar offers, and moved 192 witnesses'
// eval-step cost up corpus-wide (gunbc#11622, measured against gunbc#11700's floor run). A literal
// terminal costs only where it is authored, and the choice plan keys on (class, word), so these
// ident-led clauses stay FIRST-disjoint and an unknown starter still refuses. Transport kinds stay
// plain idents, as v1 parse_transport_binding matches rest/shell/file as ShIdent. io fields carry
// v1's `Type [from "key"] [= default]` tail (extdeps.shell `Find` declares `max_depth: Int = 1`);
// general type fields do not (see dag_grammar_io_field_decl_expr).
// Service-level `config` follows v1 parse_service_config_block: `config` `{` (field `:` expr)* `}`
// over v1's closed field set. The v2-inline operation form is v1-admitted and not yet in this
// nest — named remainder, not a silent drop. Parsing is not lowering: dag_surface_service_decl lowers
// at declaration grade in v2.compiler.body_lowering_fold body_lower_service_decl, which reads the
// interface and sets realization (transport, config, exit, response, mock_response) and unmodeled
// interface members aside, typed and located.
// A STATUS PATTERN IS AN EXACT CODE (`404`), A CLASS (`5xx`) OR A NAME (`nonzero`). The lexer reads
// `5xx` as the int literal `5` then the identifier `xx`, so the class is that pair, written as the int
// followed by the literal terminal `xx` -- the reading v1 02_parse parse_status_pattern makes. Without it every response block with a status class refused its whole
// module as parse_g0_tokens_remain at the `xx`.
// The three forms are three productions (XL-2 PR3b-i) so lowering reads which was written from the
// emitting production: a CLASS (`5xx`, the int literal then `xx`), an exact CODE, or a NAME (`nonzero`).
// CLASS AND CODE BOTH START WITH THE INT, so the code arm is GUARDED by a not-predicate over the
// class's two tokens (`!(int xx)`): the two arms are disjoint by construction rather than by trying the
// class first (operator zero_ambiguity_ruling 2026-10-02; v2.compiler.parse proves a plain guard covers
// the other arm's prefixes, gunbc#13036). The guard captures nothing, so the code production's tree is
// unchanged. They stay two productions -- not one left-factored `int (xx)?` -- because the lowering
// reads which was written from the production identity.
fn dag_grammar_status_pattern_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_status_pattern_class),
    right: dag_grammar_choice(
      left: dag_grammar_sequence(
        left: grammar_expr_not_predicate(
          element: dag_grammar_sequence(
            left: dag_grammar_terminal(token_class: ^dag_token_int_literal),
            right: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "xx"))
          )
        ),
        right: dag_grammar_nonterminal(production: ^dag_production_status_pattern_code)
      ),
      right: dag_grammar_nonterminal(production: ^dag_production_status_pattern_name)
    )
  )
}

fn dag_grammar_status_type_entry_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_status_pattern),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_fat_arrow),
      right: dag_grammar_sequence(
        left: dag_grammar_nonterminal(production: ^dag_production_type_expr),
        right: dag_grammar_optional(element: dag_grammar_terminal(token_class: ^dag_token_string_literal))
      )
    )
  )
}

fn dag_grammar_status_expr_entry_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_status_pattern),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_fat_arrow),
      right: dag_grammar_sequence(
        left: dag_grammar_nonterminal(production: ^dag_production_expr),
        right: dag_grammar_optional(element: dag_grammar_terminal(token_class: ^dag_token_string_literal))
      )
    )
  )
}

// `input` and `output` are TWO productions, not one io_block over a choice of the two words. A
// literal terminal is captured by its token class alone (v2.std.grammar StampLexeme keeps no
// lexeme), so a single io_block's parse tree could not say which word it matched, and the
// declaration-grade lowering (v2.compiler.body_lowering_fold body_lower_service_decl) needs exactly
// that fact to build an operation's domain and codomain. The production identity carries it.
fn dag_grammar_io_block_expr(keyword: String) -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: keyword)),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(
          element: dag_grammar_comma_list_expr(item: dag_grammar_io_field_decl_expr())
        ),
        right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
      )
    )
  )
}

// EACH MODIFIER KEYWORD IS ITS OWN PRODUCTION (XL-2 PR2c-i). A literal terminal is a match constraint
// that publishes its CLASS (v2.compiler.parse parse_expr_with_first), so `readonly`, `idempotent` and
// `hermetic` would all parse to the same ident atom and the parse could not say which was written. The
// production that emitted the keyword says it, as `input`/`output` are told apart by theirs, and
// v2.compiler.body_lowering_fold body_lower_operation_modifier projects each to its home.
fn dag_grammar_op_modifier_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_op_modifier_readonly),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_op_modifier_idempotent),
      right: dag_grammar_nonterminal(production: ^dag_production_op_modifier_hermetic)
    )
  )
}

fn dag_grammar_keyword_expr(lexeme: String) -> GrammarExpr {
  dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: lexeme))
}

// `requires R, ..` ON AN OPERATION: the resources an opaque operation reaches (D13 step a). Each member
// is an ordinary type expression, so a resource is named exactly as a `uses` clause or a parameter
// names it, and resolution reads it through the same type references. Lowered by
// v2.compiler.body_lowering_fold body_lower_operation_requires onto the operation Arrow's
// ^arrow_resource_requirements_edge.
// THREE DECLARED FORMS, ONE CLAUSE (D13 ruling B: an operation's demand is never read from silence).
// `requires none` declares no requirement in the audited vocabulary; `requires opaque` declares that the
// operation's demand is decided by runtime values (a generic exec), so a caller's demand is Undecided;
// `requires R, ..` names the resources. The two words are their own productions because a literal
// terminal stamps its token CLASS, not its word, so only the production's emitted identity can say
// which word was written. The type list is GUARDED by a not-predicate over the two words, so a
// resource cannot be named `none` or `opaque` BY CONSTRUCTION rather than by trying the words first:
// the list's first position is an identifier other than those two, disjoint from both word arms
// (operator zero_ambiguity_ruling 2026-10-02; v2.compiler.parse proves the guard covers the word
// arms' prefixes, gunbc#13036).
fn dag_grammar_op_requires_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "requires")),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_op_requires_none),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: ^dag_production_op_requires_opaque),
        right: dag_grammar_sequence(
          left: grammar_expr_not_predicate(
            element: dag_grammar_choice(
              left: dag_grammar_keyword_expr(lexeme: "none"),
              right: dag_grammar_keyword_expr(lexeme: "opaque")
            )
          ),
          right: dag_grammar_comma_list_expr(item: dag_grammar_nonterminal(production: ^dag_production_type_expr))
        )
      )
    )
  )
}

// THE TRANSPORT KIND IS A CLOSED CHOICE, NOT A NAME. `transport shell { .. }` selects the realization
// handler kind; it binds nothing and name resolution never looks it up (body lowering sets the member
// aside as a realization member). So the grammar admits exactly the four kinds as literal terminals,
// as dag_grammar_op_modifier_expr does for readonly/idempotent/hermetic: the production holds no
// name terminal, v2.compiler.occurrence_role needs no row for it, and an unknown kind is a located
// parse refusal instead of an accepted identifier. The four are v1 00_core TransportKind's arms.
// EACH TRANSPORT KIND IS ITS OWN PRODUCTION (XL-2 PR3b-i), for the reason each operation modifier is
// (#12964): a literal terminal publishes only its token class, so a choice of four literals parsed which
// kind was written and recorded none of it. Lowering reads the kind from the emitting production
// (v2.compiler.body_lowering_fold body_lower_transport_kind_label_optional).
fn dag_grammar_transport_kind_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_transport_kind_rest),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_transport_kind_shell),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: ^dag_production_transport_kind_file),
        right: dag_grammar_nonterminal(production: ^dag_production_transport_kind_local)
      )
    )
  )
}

fn dag_grammar_transport_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: ^transport),
    right: dag_grammar_sequence(
      left: dag_grammar_transport_kind_expr(),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_field_init_list_helper(),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      )
    )
  )
}

fn dag_grammar_exit_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: ^exit),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
      right: dag_grammar_sequence(
        left: dag_grammar_repeat(
          element: dag_grammar_nonterminal(production: ^dag_production_status_type_entry)
        ),
        right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
      )
    )
  )
}

fn dag_grammar_response_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: ^response),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
      right: dag_grammar_sequence(
        left: dag_grammar_repeat(
          element: dag_grammar_nonterminal(production: ^dag_production_status_type_entry)
        ),
        right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
      )
    )
  )
}

fn dag_grammar_mock_response_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: ^mock_response),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
      right: dag_grammar_sequence(
        left: dag_grammar_repeat(
          element: dag_grammar_nonterminal(production: ^dag_production_status_expr_entry)
        ),
        right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
      )
    )
  )
}

fn dag_grammar_operation_body_entry_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_input_block),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_output_block),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: ^dag_production_op_modifier),
        right: dag_grammar_choice(
          left: dag_grammar_nonterminal(production: ^dag_production_op_requires),
          right: dag_grammar_choice(
            left: dag_grammar_nonterminal(production: ^dag_production_transport),
            right: dag_grammar_choice(
              left: dag_grammar_nonterminal(production: ^dag_production_exit_block),
              right: dag_grammar_choice(
                left: dag_grammar_nonterminal(production: ^dag_production_response_block),
                right: dag_grammar_nonterminal(production: ^dag_production_mock_response_block)
              )
            )
          )
        )
      )
    )
  )
}

fn dag_grammar_operation_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "operation")),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal_lexeme(token_class: ^dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_repeat(
            element: dag_grammar_nonterminal(production: ^dag_production_operation_body_entry)
          ),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      )
    )
  )
}

// v1 parse_config_fields admits exactly five config field names and refuses any other by name;
// the closed set is a choice of one production per name here, so an unknown field still refuses at parse.
// Each config field name is its own production (XL-2 PR3b-i), for the reason each transport kind is: a
// literal terminal publishes only its class, so lowering could not read which field was written.
fn dag_grammar_service_config_field_name_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_service_config_field_name_endpoint),
    right: dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_service_config_field_name_auth),
    right: dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_service_config_field_name_auth_input),
    right: dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_service_config_field_name_auth_source),
    right: dag_grammar_nonterminal(production: ^dag_production_service_config_field_name_rate_limit)
  )
  )
  )
  )
}

fn dag_grammar_service_config_field_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_service_config_field_name_expr(),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_colon),
      right: dag_grammar_nonterminal(production: ^dag_production_expr)
    )
  )
}

fn dag_grammar_service_config_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "config")),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(
          element: dag_grammar_comma_list_expr(
            item: dag_grammar_nonterminal(production: ^dag_production_service_config_field)
          )
        ),
        right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
      )
    )
  )
}

fn dag_grammar_service_body_entry_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_service_config),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_operation),
      right: dag_grammar_nonterminal(production: ^dag_production_transport)
    )
  )
}

fn dag_grammar_service_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "service")),
    right: dag_grammar_sequence(
      left: dag_grammar_nonterminal(production: ^dag_production_qualified_name),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_repeat(
            element: dag_grammar_nonterminal(production: ^dag_production_service_body_entry)
          ),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      )
    )
  )
}

// RESOURCE FAMILY -- stated difference from v1.compiler.parse. v1 parse_resource_def /
// parse_resource_entries admit `resource` Name `{` (prop `:` expr | capability | acquire {..} |
// release {..})* `}`, and SKIP the acquire and release bodies token by token (skip_until_rbrace), so
// `acquire { hermetic }` reaches no carrier there. Here every entry is a closed production and
// nothing is skipped: a property is one of the three v1 names over its closed values (the homes are
// std.resource_contract ResourceKind and ResourceMode, read against them at lowering because a literal
// terminal stamps its token CLASS and not its word, so the value is a lexeme-stamped ident whose
// spelling the lowering projects; expires is a Bool literal), an acquire body admits only
// the `hermetic` execution-mode claim (std.execution_mode Hermetic) or nothing, a release body admits
// nothing, and a capability is the braced input/output form. Anything else is a located parse
// refusal. v1's bare `capability name` and parenthesized `capability name(..) -> T` forms are not
// admitted: the live corpus (dag/std/resources.dag) authors neither. Parsing is not lowering:
// dag_surface_resource_decl lowers in v2.compiler.body_lowering_fold body_lower_resource_decl.
fn dag_grammar_resource_property_expr(keyword: String, value: GrammarExpr) -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: keyword)),
    right: dag_grammar_sequence(left: dag_grammar_terminal(token_class: ^dag_token_colon), right: value)
  )
}

fn dag_grammar_resource_bool_value_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_true),
    right: dag_grammar_terminal(token_class: ^dag_token_kw_false)
  )
}

fn dag_grammar_resource_acquire_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "acquire")),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "hermetic"))),
        right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
      )
    )
  )
}

fn dag_grammar_resource_release_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "release")),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
      right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
    )
  )
}

fn dag_grammar_capability_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "capability")),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal_lexeme(token_class: ^dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_repeat(
            element: dag_grammar_choice(
              left: dag_grammar_nonterminal(production: ^dag_production_input_block),
              right: dag_grammar_nonterminal(production: ^dag_production_output_block)
            )
          ),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      )
    )
  )
}

fn dag_grammar_resource_body_entry_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_resource_kind),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_resource_mode),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: ^dag_production_resource_expires),
        right: dag_grammar_choice(
          left: dag_grammar_nonterminal(production: ^dag_production_capability),
          right: dag_grammar_choice(
            left: dag_grammar_nonterminal(production: ^dag_production_resource_acquire),
            right: dag_grammar_nonterminal(production: ^dag_production_resource_release)
          )
        )
      )
    )
  )
}

fn dag_grammar_resource_decl_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_literal_terminal(token_class: ^dag_token_ident, lexeme: symbol_intern_lexeme(lexeme: "resource")),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal_lexeme(token_class: ^dag_token_ident),
      right: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
        right: dag_grammar_sequence(
          left: dag_grammar_repeat(
            element: dag_grammar_nonterminal(production: ^dag_production_resource_body_entry)
          ),
          right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
        )
      )
    )
  )
}

fn dag_grammar_top_level_item_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_nonterminal(production: ^dag_production_import_decl),
    right: dag_grammar_choice(
      left: dag_grammar_nonterminal(production: ^dag_production_alias_decl),
      right: dag_grammar_choice(
        left: dag_grammar_nonterminal(production: ^dag_production_type_decl),
        right: dag_grammar_choice(
          left: dag_grammar_nonterminal(production: ^dag_production_data_decl),
          right: dag_grammar_choice(
            left: dag_grammar_nonterminal(production: ^dag_production_fn_decl),
            right: dag_grammar_choice(
              left: dag_grammar_nonterminal(production: ^dag_production_test_fn_decl),
              right: dag_grammar_choice(
                left: dag_grammar_nonterminal(production: ^dag_production_service_decl),
                right: dag_grammar_nonterminal(production: ^dag_production_resource_decl)
              )
            )
          )
        )
      )
    )
  )
}

// WHERE THE ITEMS END, AN IDENTIFIER FOLLOWED BY `fn` OR `data` IS A MARKER THAT IS NOT `test`, and
// it refuses by name at the marker instead of leaving the rest of the module to the generic leftover
// refusal. The guard follows the repeat, so it is not a choice alternative and adds no overlap; it is
// a not-predicate, so it captures nothing and the module's tree is the items'.
fn dag_grammar_module_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_module_header),
    right: dag_grammar_sequence(
      left: dag_grammar_repeat(element: dag_grammar_nonterminal(production: ^dag_production_top_level_item)),
      right: grammar_expr_not_predicate(
        element: grammar_expr_refuse_on_match(
          element: dag_grammar_sequence(
            left: dag_grammar_terminal_lexeme(token_class: ^dag_token_ident),
            right: dag_grammar_choice(
              left: dag_grammar_terminal(token_class: ^dag_token_kw_fn),
              right: dag_grammar_terminal(token_class: ^dag_token_kw_data)
            )
          ),
          reason: DeclarationMarkerNotTest
        )
      )
    )
  )
}

fn dag_grammar_production(name: Symbol, expression: GrammarExpr, emitted: Symbol) -> GrammarProduction {
  GrammarProduction {
    name: name,
    expression: expression,
    emitted: dag_grammar_atom(id: emitted)
  }
}

fn dag_grammar_module_production() -> GrammarProduction {
  dag_grammar_production(
    name: ^dag_production_module,
    expression: dag_grammar_module_expr(),
    emitted: ^dag_surface_module
  )
}

fn emit_module_header_emitted_node(qualified_name: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_surface_edge(edge: ^dag_surface_module_header,
        target: dag_grammar_atom(id: ^dag_surface_module_header)
      ),
      dag_surface_edge(edge: ^dag_surface_module_header_qualified_name,
        target: qualified_name
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn emit_row_module_header(qualified_name: Node) -> Node {
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: ^dag_production_module_header,
      expression: dag_grammar_module_header_expr(),
      emitted: ^dag_surface_module_header
    ),
    emitted: emit_module_header_emitted_node(qualified_name: qualified_name),
    tokens: [
      emit_fixed_token(token_class: ^dag_token_kw_module),
      qualified_name
    ]
  )
}

fn emit_import_decl_emitted_node(
  qualified_name: Node,
  import_block: Node?
) -> Node {
  let prefix = [
    dag_surface_edge(edge: ^dag_surface_import_decl,
      target: dag_grammar_atom(id: ^dag_surface_import_decl)
    ),
    dag_surface_edge(edge: ^dag_surface_import_decl_qualified_name,
      target: qualified_name
    )
  ]
  Node {
    kind: TypeNode { connective: Conj },
    children: match import_block {
      Present { value: block } =>
        list_append(
          left: prefix,
          right: [
            dag_surface_edge(edge: ^dag_surface_import_decl_block, target: block)
          ]
        )
      Absent => prefix
    },
    occurrence_id: OccurrenceSynthetic
}
}

fn emit_row_import_decl(
  qualified_name: Node,
  import_block: Node?
) -> Node {
  let prefix = [
    emit_fixed_token(token_class: ^dag_token_kw_import),
    qualified_name
  ]
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: ^dag_production_import_decl,
      expression: dag_grammar_import_decl_expr(),
      emitted: ^dag_surface_import_decl
    ),
    emitted: emit_import_decl_emitted_node(
      qualified_name: qualified_name,
      import_block: import_block
    ),
    tokens: match import_block {
      Present { value: block } => list_append(left: prefix, right: [block])
      Absent => prefix
    }
  )
}

fn emit_alias_decl_emitted_node(binding: Node, target: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_alias_decl,
        target: dag_grammar_atom(id: ^dag_surface_alias_decl)
      ),
      dag_named_edge(
        name: ^dag_surface_alias_decl_binding,
        target: binding
      ),
      dag_named_edge(
        name: ^dag_surface_alias_decl_target,
        target: target
      )
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn emit_row_alias_decl(binding: Node, target: Node) -> Node {
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: ^dag_production_alias_decl,
      expression: dag_grammar_alias_decl_expr(),
      emitted: ^dag_surface_alias_decl
    ),
    emitted: emit_alias_decl_emitted_node(binding: binding, target: target),
    tokens: [
      emit_fixed_token(token_class: ^dag_token_kw_alias),
      binding,
      emit_fixed_token(token_class: ^dag_token_eq),
      target
    ]
  )
}

fn emit_data_decl_emitted_node(
  name_binding: Symbol,
  type_expr: Node,
  expr: Node
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^dag_surface_data_decl,
        target: dag_grammar_atom(id: ^dag_surface_data_decl)
      ),
      dag_named_edge(
        name: ^dag_surface_data_decl_name,
        target: dag_grammar_atom(id: name_binding)
      ),
      dag_named_edge(
        name: ^dag_surface_data_decl_type,
        target: type_expr
      ),
      dag_named_edge(
        name: ^dag_surface_data_decl_expr,
        target: expr
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn emit_row_data_decl(
  name_binding: Symbol,
  type_expr: Node,
  expr: Node
) -> Node {
  emit_grammar_relation_row(
    production: dag_grammar_production(
      name: ^dag_production_data_decl,
      expression: dag_grammar_data_decl_expr(),
      emitted: ^dag_surface_data_decl
    ),
    emitted: emit_data_decl_emitted_node(
      name_binding: name_binding,
      type_expr: type_expr,
      expr: expr
    ),
    tokens: [
      emit_fixed_token(token_class: ^dag_token_kw_data),
      emit_bound_token(token_class: ^dag_token_ident, binding: name_binding),
      emit_fixed_token(token_class: ^dag_token_colon),
      type_expr,
      emit_fixed_token(token_class: ^dag_token_eq),
      expr
    ]
  )
}

fn dag_grammar_root() -> GrammarRoot {
  let module_prod = dag_grammar_module_production()
  let module_header = dag_grammar_production(
    name: ^dag_production_module_header,
    expression: dag_grammar_module_header_expr(),
    emitted: ^dag_surface_module_header
  )
  let top_level_item = dag_grammar_production(
    name: ^dag_production_top_level_item,
    expression: dag_grammar_top_level_item_expr(),
    emitted: ^dag_surface_top_level_item
  )
  let import_decl = dag_grammar_production(
    name: ^dag_production_import_decl,
    expression: dag_grammar_import_decl_expr(),
    emitted: ^dag_surface_import_decl
  )
  let alias_decl = dag_grammar_production(
    name: ^dag_production_alias_decl,
    expression: dag_grammar_alias_decl_expr(),
    emitted: ^dag_surface_alias_decl
  )
  let type_decl = dag_grammar_production(
    name: ^dag_production_type_decl,
    expression: dag_grammar_type_decl_expr(),
    emitted: ^dag_surface_type_decl
  )
  let data_decl = dag_grammar_production(
    name: ^dag_production_data_decl,
    expression: dag_grammar_data_decl_expr(),
    emitted: ^dag_surface_data_decl
  )
  let fn_decl = dag_grammar_production(
    name: ^dag_production_fn_decl,
    expression: dag_grammar_fn_decl_expr(),
    emitted: ^dag_surface_fn_decl
  )
  let test_fn_decl = dag_grammar_production(
    name: ^dag_production_test_fn_decl,
    expression: dag_grammar_test_fn_decl_expr(),
    emitted: ^dag_surface_test_fn_decl
  )
  let service_decl = dag_grammar_production(
    name: ^dag_production_service_decl,
    expression: dag_grammar_service_decl_expr(),
    emitted: ^dag_surface_service_decl
  )
  let resource_decl = dag_grammar_production(
    name: ^dag_production_resource_decl,
    expression: dag_grammar_resource_decl_expr(),
    emitted: ^dag_surface_resource_decl
  )
  let resource_body_entry = dag_grammar_production(
