fn dag_complement_match_body(
  scrutinee: Node,
  true_body_lit: Symbol,
  false_body_lit: Symbol
) -> Node {
  dag_match_body_from_arms(
    scrutinee: scrutinee,
    true_arm: dag_match_arm_node(
      pattern_lit: ^dag_complement_lit_true,
      body_lit: true_body_lit
    ),
    false_arm: dag_match_arm_node(
      pattern_lit: ^dag_complement_lit_false,
      body_lit: false_body_lit
    )
