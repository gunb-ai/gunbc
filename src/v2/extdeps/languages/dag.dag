fn dag_wave2a_comma_field_decl_list_emitted() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: dag_inhabitant_atom(id: ^dag_binding_wave2a_field_id) },
      Edge {
        label: Positional,
