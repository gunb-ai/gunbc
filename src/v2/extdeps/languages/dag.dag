fn dag_rec_family_spec() -> DagBodiedFnFamilySpec {
  DagBodiedFnFamilySpec {
    inhabitant_field: dag_inhabitant_field_rec_fn,
    emitted_fn: dag_fixture_emitted_rec_fn,
    grammar_row: DagGrammarRelationRow {
      production: dag_formal_production_fn_rec(),
      emitted: dag_fixture_emitted_rec_fn,
      tokens: dag_rec_concrete_tokens()
    },
    source_literal: ^dag_rec_source_literal,
    production_binding: ^dag_production_fn_rec,
    authority_source_text: dag_rec_source_text,
    relation_rule: ^dag_relation_rule_fn_rec,
    scaffold: dag_rec_bodied_arrow_statement_scaffold()
  }
}

fn dag_rec_grammar_relation_row_node() -> Node {
  dag_bodied_fn_grammar_relation_row_node(spec: dag_rec_family_spec())
}

fn dag_rec_translation_rules_node() -> Node {
  dag_bodied_fn_translation_rules_node(spec: dag_rec_family_spec())
}

fn dag_rec_target_model_bundle_node() -> Node {
  dag_bodied_fn_target_model_bundle_node(spec: dag_rec_family_spec())
}

fn dag_rec_target_model() -> TargetModel {
  dag_bodied_fn_target_model(
    spec: dag_rec_family_spec(),
    runtime_row: Absent
  )
}

fn dag_field_access_statement_prefix_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^dag_token_kw_fn },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_fn_get },
    FixedToken { token_class: ^dag_token_lparen },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_param_r },
    FixedToken { token_class: ^dag_token_colon },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_type_rec },
    FixedToken { token_class: ^dag_token_rparen },
    FixedToken { token_class: ^dag_token_arrow },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_type_int },
    FixedToken { token_class: ^dag_token_lbrace }
  ]
}

fn dag_field_access_bodied_arrow_statement_scaffold() -> TargetBodiedArrowStatementScaffold {
  derive_bodied_arrow_scaffold(
    signature_with_open: dag_field_access_statement_prefix_tokens(),
    block_close: dag_pick_statement_suffix_tokens(),
    mode: dag_block_evaluation_mode()
  )
}

fn dag_field_access_family_spec() -> DagBodiedFnFamilySpec {
  DagBodiedFnFamilySpec {
    inhabitant_field: dag_inhabitant_field_field_access_fn,
    emitted_fn: dag_fixture_emitted_field_access_fn,
    grammar_row: DagGrammarRelationRow {
      production: dag_formal_production_fn_field_access(),
      emitted: dag_fixture_emitted_field_access_fn,
      tokens: dag_field_access_concrete_tokens()
    },
    source_literal: ^dag_field_access_source_literal,
    production_binding: ^dag_production_fn_field_access,
    authority_source_text: dag_field_access_source_text,
    relation_rule: ^dag_relation_rule_fn_field_access,
    scaffold: dag_field_access_bodied_arrow_statement_scaffold()
  }
}

fn dag_field_access_grammar_relation_row_node() -> Node {
  dag_bodied_fn_grammar_relation_row_node(spec: dag_field_access_family_spec())
}

fn dag_field_access_translation_rules_node() -> Node {
  dag_bodied_fn_translation_rules_node(spec: dag_field_access_family_spec())
}

fn dag_field_access_target_model_bundle_node() -> Node {
  dag_bodied_fn_target_model_bundle_node(spec: dag_field_access_family_spec())
}

fn dag_field_access_target_model() -> TargetModel {
  dag_bodied_fn_target_model(
    spec: dag_field_access_family_spec(),
    runtime_row: Absent
  )
}

fn dag_target_model() -> TargetModel {
  TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: dag_target_model_node(),
    lex: dag_lex(),
    binding_spellings: dag_binding_spellings(),
    token_class_emit_transforms: dag_token_class_emit_transforms(),
    authority_source_text: dag_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn dag_round_trip_atom(s: Symbol) -> Node {
  Node { kind: TypeNode { connective: Atom { identity: s } }, children: [],
 occurrence_id: OccurrenceSynthetic
}
}

fn dag_round_trip_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Authored { name: name }, target: target }
}

fn dag_round_trip_bool_node(pass: Bool) -> Node {
  if pass {
    dag_round_trip_atom(s: ^dag_round_trip_axis_ready)
  } else {
    dag_round_trip_atom(s: ^dag_round_trip_axis_not_ready)
  }
}

fn dag_round_trip_lex_ready() -> Bool {
  dag_lex_token_symbol(sym: ^dag_token_kw_module) &&
  dag_lex_token_symbol(sym: ^dag_token_kw_import) &&
  dag_lex_token_symbol(sym: ^dag_token_kw_alias) &&
  dag_lex_token_symbol(sym: ^dag_token_kw_data) &&
  dag_lex_token_symbol(sym: ^dag_token_kw_fn) &&
  dag_lex_token_symbol(sym: ^dag_token_ident) &&
  dag_lex_token_symbol(sym: ^dag_token_dot) &&
  dag_lex_token_symbol(sym: ^dag_token_lbrace) &&
  dag_lex_token_symbol(sym: ^dag_token_rbrace) &&
  dag_lex_token_symbol(sym: ^dag_token_colon) &&
  dag_lex_token_symbol(sym: ^dag_token_eq) &&
  dag_lex_token_symbol(sym: ^dag_token_lparen) &&
  dag_lex_token_symbol(sym: ^dag_token_rparen) &&
  dag_lex_token_symbol(sym: ^dag_token_arrow)
}

fn dag_round_trip_grammar_ready(lm: LanguageModel) -> Bool {
  grammar_carries_symbol(grammar: lm.grammar, sym: ^dag_production_module) &&
  grammar_carries_symbol(grammar: lm.grammar, sym: ^dag_production_module_header) &&
  grammar_carries_symbol(grammar: lm.grammar, sym: ^dag_production_import_decl) &&
  grammar_carries_symbol(grammar: lm.grammar, sym: ^dag_production_alias_decl) &&
  grammar_carries_symbol(grammar: lm.grammar, sym: ^dag_production_data_decl) &&
  grammar_carries_symbol(grammar: lm.grammar, sym: ^dag_production_fn_decl)
}

fn dag_round_trip_trivia_fidelity_resolved() -> Bool {
  dag_whitespace_fidelity() == DeclaredNormalized { feature: DagWhitespaceDeclaredNormalized } &&
  dag_line_comment_fidelity() == FailClosed { feature: DagLineCommentFailClosed } &&
  dag_block_comment_fidelity() == FailClosed { feature: DagBlockCommentFailClosed }
}

fn dag_round_trip_authorities_ready() -> Bool {
  let lm = dag_language_model()
  dag_round_trip_lex_ready() &&
  dag_round_trip_grammar_ready(lm: lm) &&
  dag_round_trip_trivia_fidelity_resolved()
}

fn parse_production_emitted_identity_optional(node: Node) -> Optional<Symbol> {
  match named_child_lookup(root: node, name: ^grammar_production_identity_node_projection) {
    NamedChildFound { target: id_node } => node_atom_identity_optional(node: id_node)
    NamedChildMissing => Absent
    NamedChildAmbiguous => Absent
  }
}

fn dag_node_is_fn_decl(node: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } => id == ^dag_surface_fn_decl
    Absent => false
  }
}

fn parse_production_captured_child_optional(node: Node) -> Optional<Node> {
  match named_child_lookup(root: node, name: ^grammar_production_captured_node_projection) {
    NamedChildFound { target: captured } => Present { value: captured }
    NamedChildMissing => Absent
    NamedChildAmbiguous => Absent
  }
}

type ParseSubtreeFind
  = ParseSubtreeAbsent
  | ParseSubtreeFound { captured: Node }

fn parse_subtree_locate_production_under_children(
  root: Node,
  emitted: Symbol,
  require_captured: Bool
) -> Node? {
  fold(
    root.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          parse_subtree_locate_production_matching(
            root: edge.target,
            emitted: emitted,
            require_captured: require_captured
          )
      }
    }
  )
}

fn parse_subtree_locate_production_matching(
  root: Node,
  emitted: Symbol,
  require_captured: Bool
) -> Node? {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      match id == emitted {
        true =>
          match require_captured {
            false => Present { value: root }
            true =>
              match parse_production_captured_child_optional(node: root) {
                Present { value: _ } => Present { value: root }
                Absent =>
                  parse_subtree_locate_production_under_children(
                    root: root,
                    emitted: emitted,
                    require_captured: require_captured
                  )
              }
          }
        false =>
          parse_subtree_locate_production_under_children(
            root: root,
            emitted: emitted,
            require_captured: require_captured
          )
      }
    Absent =>
      parse_subtree_locate_production_under_children(
        root: root,
        emitted: emitted,
        require_captured: require_captured
      )
  }
}

fn parse_subtree_locate_production(root: Node, emitted: Symbol) -> Node? {
  parse_subtree_locate_production_matching(
    root: root,
    emitted: emitted,
    require_captured: false
  )
}

fn parse_subtree_find_production_captured(root: Node, emitted: Symbol) -> ParseSubtreeFind {
  match parse_subtree_locate_production_matching(
    root: root,
    emitted: emitted,
    require_captured: true
  ) {
    Absent => ParseSubtreeAbsent
    Present { value: node } =>
      match parse_production_captured_child_optional(node: node) {
        Present { value: captured } => ParseSubtreeFound { captured: captured }
        Absent => ParseSubtreeAbsent
      }
  }
}

fn dag_surface_kw_then_ident_node_from_captured(captured: Node) -> Outcome<Node> {
  match find_named_child(root: captured, name: ^grammar_sequence_right_node_projection) {
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
    Accepted { value: after_kw, diagnostics: _ } =>
      match find_named_child(root: after_kw, name: ^grammar_sequence_left_node_projection) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: ident_node, diagnostics: diags } =>
          Accepted { value: ident_node, diagnostics: diags }
      }
  }
}

// The declaration's CONTENT: the sequence to the right of the name on the same
// kw-then-ident spine the decoder walks. A Named graft edge targets this, never the
// captured shell, so the declaring identifier is not walked as a mention of itself
// (measured: a data declaration's own name reached the reference-site census as a
// site when the edge targeted the whole captured shell).
fn dag_surface_kw_then_ident_rest_from_captured(captured: Node) -> Optional<Node> {
  match find_named_child(root: captured, name: ^grammar_sequence_right_node_projection) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: after_kw, diagnostics: _ } =>
      match find_named_child(root: after_kw, name: ^grammar_sequence_right_node_projection) {
        Rejected { diagnostics: _ } => Absent
        Accepted { value: rest, diagnostics: _ } => Present { value: rest }
      }
  }
}

fn dag_surface_kw_then_ident_from_captured(captured: Node) -> Optional<Symbol> {
  match dag_surface_kw_then_ident_node_from_captured(captured: captured) {
    Rejected { diagnostics: _ } => Absent
    Accepted { value: ident_node, diagnostics: _ } =>
      match dag_binding_branded_atom_identity(node: ident_node) {
        Present { value: binding } => Present { value: binding }
        Absent =>
          match node_atom_identity_optional(node: ident_node) {
            Present { value: sym } =>
              if dag_lex_token_symbol(sym: sym) {
                optional_absent()
              } else {
                optional_present(value: sym)
              }
            Absent => optional_absent()
          }
      }
  }
}

// THE NAMED-ARGUMENT SPINE, AND IT LIVES HERE BECAUSE THIS MODULE OWNS THE PRODUCTION IT
// DECODES. dag_grammar_arg_expr is Choice(Seq(binding_name, Seq(colon, expr)), expr): a named
// argument carries its NAME in the sequence left and its VALUE two rights in, past the colon; a
// positional one is a bare expr with no name. That spine was being re-decoded by every stage
// that needed it -- v2.lens.complexity_accumulator_copy.analyze arg_value_node reproduces it
// step for step, and v2.compiler.body_lowering_fold body_lower_named_arg_value_optional carries
// it fused with that stage's own operand lowering -- so a reader had to pick among three
// spellings of one fact (DESIGN section 2: net concepts must not grow by re-invention).
//
// It CANNOT live in either of those: v2.compiler.body_lowering_fold imports
// v2.compiler.fold_lowering, so a compiler stage consuming the body-lowering copy would close an
// import cycle, and acyclicity is the import graph's only structural law (DESIGN section 3). The
// decoder belongs at the layer below both, beside the grammar that declares the production.
//
// body_lower_named_arg_value_optional is NOT a redundant copy of this and is deliberately left
// alone: it returns a LOWERED OPERAND rather than the raw value node, so it is this spine plus
// body lowering's own read. Unfusing it is a body-lowering change, tracked as its own obligation
// rather than performed from here.
fn dag_named_arg_name_optional(arg_capture: Node) -> Optional<Symbol> {
  match dag_named_arg_name_node_optional(arg_capture: arg_capture) {
    Present { value: name_node } => node_atom_identity_optional(node: name_node)
    Absent => Absent
  }
}

// The name's token node itself, for a reader that must keep its occurrence
// (v2.compiler.occurrence_role). The name-only decoder above is this one's projection.
fn dag_named_arg_name_node_optional(arg_capture: Node) -> Optional<Node> {
  match find_named_child(root: arg_capture, name: ^grammar_sequence_left_node_projection) {
    Accepted { value: name_node, diagnostics: _ } => Present { value: name_node }
    Rejected { diagnostics: _ } => Absent
  }
}

fn dag_named_arg_value_optional(arg_capture: Node) -> Optional<Node> {
  match find_named_child(root: arg_capture, name: ^grammar_sequence_right_node_projection) {
    Rejected { diagnostics: _ } => dag_named_arg_value_absent()
    Accepted { value: after_name, diagnostics: _ } =>
      match find_named_child(root: after_name, name: ^grammar_sequence_left_node_projection) {
        Rejected { diagnostics: _ } => dag_named_arg_value_absent()
        Accepted { value: separator, diagnostics: _ } =>
          match node_atom_identity_optional(node: separator) {
            Absent => dag_named_arg_value_absent()
            Present { value: sep } =>
              if sep == ^dag_token_colon {
                match find_named_child(
                  root: after_name,
                  name: ^grammar_sequence_right_node_projection
                ) {
                  Accepted { value: value_node, diagnostics: _ } =>
                    dag_named_arg_value_present(node: value_node)
                  Rejected { diagnostics: _ } => dag_named_arg_value_absent()
                }
              } else {
                dag_named_arg_value_absent()
              }
          }
      }
  }
}

// The DIRECT named arguments of one call. The walk stops at every ^dag_surface_arg it reaches
// and never descends into one, so an argument belonging to a NESTED call inside an argument
// value is unreachable from the outer call. That stopping rule is the correctness property, not
// an optimisation: a plain recursive search finds a nested `f:` before the outer one whenever an
// earlier argument carries a nested call, which is how a whole-subtree first-match comes to
// answer about the wrong subject. Same stopping rule the lens direct-capture collectors use
// (v2.lens.complexity_accumulator_copy.analyze collect_direct_captures and its sibling in
// v2.lens.identity_captured_navigation.analyze), stated once here for the keyed lookup.
fn dag_call_named_arg_value_optional(node: Node, name: Symbol) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_arg {
        match parse_production_captured_child_optional(node: node) {
          Absent => dag_named_arg_value_absent()
          Present { value: arg_capture } =>
            match dag_named_arg_name_optional(arg_capture: arg_capture) {
              Absent => dag_named_arg_value_absent()
              Present { value: got } =>
                if got == name {
                  dag_named_arg_value_optional(arg_capture: arg_capture)
                } else {
                  dag_named_arg_value_absent()
                }
            }
        }
      } else {
        dag_call_named_arg_value_under_children(node: node, name: name)
      }
    Absent => dag_call_named_arg_value_under_children(node: node, name: name)
  }
}

fn dag_call_named_arg_value_under_children(node: Node, name: Symbol) -> Optional<Node> {
  fold(node.children, init: dag_named_arg_value_absent(), f: fn(acc, e) {
    match acc {
      Present { value: _ } => acc
      Absent => dag_call_named_arg_value_optional(node: e.target, name: name)
    }
  })
}

// The DIRECT argument at one declared POSITION of one call, under the same stopping rule as the
// named lookup above: the walk counts each ^dag_surface_arg it reaches, in source order, and never
// descends into one. A NAMED argument sitting at that position answers Absent -- its slot is
// decided by its name, never by where it was written -- so a call reaches its step by exactly one
// of the two readings.
type DagPositionalArgScan {
  seen: Int
  decided: Bool
  found: Optional<Node>
}

fn dag_call_positional_arg_value_optional(node: Node, position: Int) -> Optional<Node> {
  let scan = dag_call_positional_arg_scan(
    node: node,
    position: position,
    acc: DagPositionalArgScan { seen: 0, decided: false, found: dag_named_arg_value_absent() }
  )
  scan.found
}

fn dag_call_positional_arg_scan(node: Node, position: Int, acc: DagPositionalArgScan) -> DagPositionalArgScan {
  if acc.decided {
    acc
  } else {
    match parse_production_emitted_identity_optional(node: node) {
      Present { value: id } =>
        if id == ^dag_surface_arg {
          dag_call_positional_arg_visit(node: node, position: position, acc: acc)
        } else {
          dag_call_positional_arg_scan_children(node: node, position: position, acc: acc)
        }
      Absent => dag_call_positional_arg_scan_children(node: node, position: position, acc: acc)
    }
  }
}

fn dag_call_positional_arg_visit(node: Node, position: Int, acc: DagPositionalArgScan) -> DagPositionalArgScan {
  if acc.seen == position {
    DagPositionalArgScan { seen: acc.seen + 1, decided: true, found: dag_positional_arg_value(arg: node) }
  } else {
    DagPositionalArgScan { seen: acc.seen + 1, decided: false, found: acc.found }
  }
}

fn dag_positional_arg_value(arg: Node) -> Optional<Node> {
  match parse_production_captured_child_optional(node: arg) {
    Absent => dag_named_arg_value_absent()
    Present { value: arg_capture } =>
      match dag_named_arg_value_optional(arg_capture: arg_capture) {
        Present { value: _ } => dag_named_arg_value_absent()
        Absent => dag_named_arg_value_present(node: arg_capture)
      }
  }
}

fn dag_call_positional_arg_scan_children(node: Node, position: Int, acc: DagPositionalArgScan) -> DagPositionalArgScan {
  fold(node.children, init: acc, f: fn(inner, e) {
    dag_call_positional_arg_scan(node: e.target, position: position, acc: inner)
  })
}

fn dag_named_arg_value_absent() -> Optional<Node> {
  Absent
}

fn dag_named_arg_value_present(node: Node) -> Optional<Node> {
  Present { value: node }
}

fn parse_qn_lexeme_segment(sym_node: Node, root: Node) -> Outcome<Symbol> {
  match node_atom_identity_optional(node: sym_node) {
    Present { value: id } =>
      if id == ^dag_token_ident {
        outcome_rejected(Diagnostic {
          reason: ^qualified_name_projection_gated,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      } else if id == ^dag_token_dot {
        outcome_rejected(Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      } else {
        outcome_accepted(value: id)
      }
    Absent =>
      outcome_rejected(Diagnostic {
        reason: ^qualified_name_structure_invalid,
        at: node_locus(node: root),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
  }
}

// ONE SEGMENT WALKER, TWO READINGS. The walker validates each segment once (parse_qn_lexeme_segment)
// and hands the segment's token node and its identity to `seg`; a caller that wants names takes
// the identity, and body lowering takes an atom lowered from the token (v2.std.node
// node_lowered_from) so each segment keeps its minted occurrence (XL-2 LoweringOccurrenceProjection;
// docs/plans/lowering-occurrence-projection-design.md). Two walkers would be two authorities for
// what a qualified name's segments are.
fn parse_qn_segment_with<T>(sym_node: Node, root: Node, seg: fn(Node, Symbol) -> T) -> Outcome<T> {
  match parse_qn_lexeme_segment(sym_node: sym_node, root: root) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: id, diagnostics: _ } => outcome_accepted(value: seg(sym_node, id))
  }
}

fn parse_qn_repeat_suffix_ident_with<T>(sequence_capture: Node, root: Node, seg: fn(Node, Symbol) -> T) -> Outcome<T> {
  match find_named_child(
    root: sequence_capture,
    name: ^grammar_sequence_right_node_projection
  ) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: ident_node, diagnostics: _ } =>
      parse_qn_segment_with(sym_node: ident_node, root: root, seg: seg)
  }
}

fn parse_qn_repeat_suffixes_with<T>(repeat_capture: Node, root: Node, seg: fn(Node, Symbol) -> T) -> Outcome<List<T>> {
  if is_empty_conj_root(n: repeat_capture) {
    outcome_accepted(value: Empty)
  } else {
    match find_named_child(
      root: repeat_capture,
      name: ^grammar_sequence_left_node_projection
    ) {
      Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
      Accepted { value: head_sequence, diagnostics: _ } =>
        match parse_qn_repeat_suffix_ident_with(sequence_capture: head_sequence, root: root, seg: seg) {
          Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
          Accepted { value: item, diagnostics: _ } =>
            match find_named_child(
              root: repeat_capture,
              name: ^grammar_sequence_right_node_projection
            ) {
              Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
              Accepted { value: tail, diagnostics: _ } =>
                match parse_qn_repeat_suffixes_with(repeat_capture: tail, root: root, seg: seg) {
                  Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
                  Accepted { value: suffixes, diagnostics: tail_diag } =>
                    outcome_with_diagnostics(
                      value: list_append(
                        left: Cons { head: item, tail: Empty },
                        right: suffixes
                      ),
                      diagnostics: tail_diag
                    )
                }
            }
        }
    }
  }
}

fn parse_qualified_name_segments_from_capture_with<T>(qn_capture: Node, root: Node, seg: fn(Node, Symbol) -> T) -> Outcome<List<T>> {
  match find_named_child(root: qn_capture, name: ^grammar_sequence_left_node_projection) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: head_node, diagnostics: _ } =>
      match parse_qn_segment_with(sym_node: head_node, root: root, seg: seg) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: head_item, diagnostics: _ } =>
          match find_named_child(
            root: qn_capture,
            name: ^grammar_sequence_right_node_projection
          ) {
            Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
            Accepted { value: repeat_node, diagnostics: _ } =>
              match parse_qn_repeat_suffixes_with(repeat_capture: repeat_node, root: root, seg: seg) {
                Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
                Accepted { value: suffixes, diagnostics: tail_diag } =>
                  outcome_with_diagnostics(
                    value: list_append(
                      left: Cons { head: head_item, tail: Empty },
                      right: suffixes
                    ),
                    diagnostics: tail_diag
                  )
              }
          }
      }
  }
}

fn parse_qn_repeat_suffixes(repeat_capture: Node, root: Node) -> Outcome<List<Symbol>> {
  parse_qn_repeat_suffixes_with(repeat_capture: repeat_capture, root: root, seg: fn(n, id) { id })
}

fn parse_qualified_name_segments_from_capture(qn_capture: Node, root: Node) -> Outcome<List<Symbol>> {
  parse_qualified_name_segments_from_capture_with(qn_capture: qn_capture, root: root, seg: fn(n, id) { id })
}

// Each segment as an atom lowered from its own token.
fn parse_qualified_name_segment_atoms_from_capture(qn_capture: Node, root: Node) -> Outcome<List<Node>> {
  parse_qualified_name_segments_from_capture_with(qn_capture: qn_capture, root: root, seg: fn(n, id) {
    node_lowered_from(kind: TypeNode { connective: Atom { identity: id } }, children: [], source: n)
  })
}

fn parse_comma_ident_list_items(
  comma_list_capture: Node,
  root: Node
) -> Outcome<List<Symbol>> {
  match find_named_child(root: comma_list_capture, name: ^grammar_sequence_left_node_projection) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: head_node, diagnostics: _ } =>
      match parse_qn_lexeme_segment(sym_node: head_node, root: root) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: head_sym, diagnostics: head_diag } =>
          match find_named_child(
            root: comma_list_capture,
            name: ^grammar_sequence_right_node_projection
          ) {
            Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
            Accepted { value: outer_right, diagnostics: _ } =>
              match find_named_child(
                root: outer_right,
                name: ^grammar_sequence_left_node_projection
              ) {
                Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
                Accepted { value: repeat_node, diagnostics: _ } =>
                  match parse_qn_repeat_suffixes(repeat_capture: repeat_node, root: root) {
                    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
                    Accepted { value: suffixes, diagnostics: tail_diag } =>
                      outcome_with_diagnostics(
                        value: list_append(
                          left: Cons { head: head_sym, tail: Empty },
                          right: suffixes
                        ),
                        diagnostics: tail_diag
                      )
                  }
              }
          }
      }
  }
}

fn parse_import_block_idents(
  import_decl_node: Node,
  root: Node
) -> Outcome<List<Symbol>> {
  match parse_subtree_find_production_captured(
    root: import_decl_node,
    emitted: ^dag_surface_import_block
  ) {
    ParseSubtreeAbsent => outcome_accepted(value: Empty)
    ParseSubtreeFound { captured: block_capture } =>
      match find_named_child(
        root: block_capture,
        name: ^grammar_sequence_right_node_projection
      ) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: inner_seq, diagnostics: _ } =>
          match find_named_child(
            root: inner_seq,
            name: ^grammar_sequence_left_node_projection
          ) {
            Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
            Accepted { value: comma_list_capture, diagnostics: _ } =>
              parse_comma_ident_list_items(
                comma_list_capture: comma_list_capture,
                root: root
              )
          }
      }
  }
}

data alias_binding_row_not_alias_decl: Symbol = ^alias_binding_row_not_alias_decl

fn alias_binding_row_binding_from_decl(decl: Node, module_root: Node) -> Outcome<Symbol> {
  match parse_production_captured_child_optional(node: decl) {
    Present { value: captured } =>
      match dag_surface_kw_then_ident_node_from_captured(captured: captured) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: ident_node, diagnostics: _ } =>
          parse_qn_lexeme_segment(sym_node: ident_node, root: module_root)
      }
    Absent =>
      match find_named_child(root: decl, name: ^dag_surface_alias_decl_binding) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: binding_node, diagnostics: _ } =>
          parse_qn_lexeme_segment(sym_node: binding_node, root: module_root)
      }
  }
}

fn alias_binding_row_target_from_decl(decl: Node, module_root: Node) -> Outcome<QualifiedName> {
  match parse_subtree_find_production_captured(
    root: decl,
    emitted: ^dag_surface_qualified_name
  ) {
    ParseSubtreeFound { captured: qn_capture } =>
      match parse_qualified_name_segments_from_capture(qn_capture: qn_capture, root: module_root) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: segments, diagnostics: _ } =>
          qualified_name_from_symbol_segments(segments: segments, root: module_root)
      }
    ParseSubtreeAbsent =>
      match find_named_child(root: decl, name: ^dag_surface_alias_decl_target) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: qn_node, diagnostics: _ } =>
          qualified_name_from_node(root: qn_node)
      }
  }
}

// AN IMPORT IS AN ALIAS ROW PER NAMED ITEM, AND THAT IS THE WHOLE OF THE TRANSMUTATION.
// docs/plans/namespace-resolution-design.md section 13 rules that `import` becomes a binding node at
// the IMPORTING position -- "the source of truth is the walk's resolved target" -- so
// `import m.p { A, B }` in module S is two rows, S.A -> m.p.A and S.B -> m.p.B, carried in the SAME
// AliasBindingRow type an `alias` decl produces. Minting a second row type here would give one
// concept two names (DESIGN section 3) and would let the two forms drift apart in the one place
// they must not: what a binding at a position MEANS.
//
// THE BLOCK IS THE BINDING SET, NOT THE MODULE. A block-less `import m.p` yields ZERO rows rather
// than every name m.p declares. Admitting the module wholesale is a using-directive, which the
// cited reference model (extdeps.languages.cpp.name_lookup, [basic.lookup.udir]) carries as an
// EXCLUDED form and which section 13's edit-stability invariant forbids for the same reason:
// a name added to m.p would silently start binding in S. Zero rows is not a silent drop -- the
// reference that wanted the name is then off its own chain and refuses, located, at the reference
// site, which is where section 13 puts the refusal.
//
// AN UNUSED IMPORT IS NO LONGER INERT, which is a real consequence of this transmutation and not a
// side note (review 69789 on gunbc#12009 found a stale one in this same change). Before it, an
// import block that named something the module never used was bookkeeping; now it MINTS A BINDING
// at the importing position and is a claimant like any other, so a stale name that collides with
// something else bound there is an ambiguity the resolver will refuse. That is the ruled model
// working as intended -- section 13 makes an alias an ordinary binding node and calls an unused one
// lintable dead code -- but it moves stale imports from harmless to load-bearing, and an author
// deleting a use must now delete its import row with it.
// THE IMPORTED MODULE'S PATH, READ IN WHICHEVER FORM THE TREE IS IN. A parsed tree still carries
// the grammar's capture for the qualified name; a normalized one carries the emitted edge
// `dag_surface_import_decl_qualified_name` instead. Both are this row's authority for the same fact,
// and reading only one of them is how a reader looks correct and silently returns nothing on the
// tree it is actually given. The alias form's reader cannot stand in here: its fallback names
// `dag_surface_alias_decl_target`, an edge no import decl has.
fn import_decl_target_module(decl: Node, module_root: Node) -> Outcome<QualifiedName> {
  match parse_subtree_find_production_captured(
    root: decl,
    emitted: ^dag_surface_qualified_name
  ) {
    ParseSubtreeFound { captured: qn_capture } =>
      match parse_qualified_name_segments_from_capture(qn_capture: qn_capture, root: module_root) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: segments, diagnostics: _ } =>
          qualified_name_from_symbol_segments(segments: segments, root: module_root)
      }
    ParseSubtreeAbsent =>
      match find_labeled_child(root: decl, label: dag_surface_edge_label(edge: ^dag_surface_import_decl_qualified_name)) {
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
        Accepted { value: qn_node, diagnostics: _ } =>
          qualified_name_from_node(root: qn_node)
      }
  }
}

fn import_binding_rows_from_decl_node(
  decl: Node,
  module_root: Node
) -> Outcome<List<AliasBindingRow>> {
  match parse_production_emitted_identity_optional(node: decl) {
    Absent =>
      outcome_rejected(Diagnostic {
        reason: ^import_binding_row_not_import_decl,
        at: node_locus(node: decl),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    Present { value: id } =>
      if id != ^dag_surface_import_decl {
        outcome_rejected(Diagnostic {
          reason: ^import_binding_row_not_import_decl,
          at: node_locus(node: decl),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      } else {
        bind_outcome(
          o: import_decl_target_module(decl: decl, module_root: module_root),
          f: fn(target_module) {
            bind_outcome(
              o: parse_import_block_idents(import_decl_node: decl, root: module_root),
              f: fn(names) {
                outcome_accepted(
                  value: fold_list(
                    xs: names,
                    empty: Empty,
                    cons: fn(acc, name) {
                      list_snoc_item(
                        xs: acc,
                        item: AliasBindingRow {
                          binding: name,
                          target: qualified_name_snoc(qn: target_module, segment: name)
                        }
                      )
                    }
                  )
                )
              }
            )
          }
        )
      }
  }
}

fn alias_binding_row_from_decl_node(decl: Node, module_root: Node) -> Outcome<AliasBindingRow> {
  match parse_production_emitted_identity_optional(node: decl) {
    Present { value: id } =>
      if id != ^dag_surface_alias_decl {
        outcome_rejected(Diagnostic {
          reason: ^alias_binding_row_not_alias_decl,
          at: node_locus(node: decl),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      } else {
        match alias_binding_row_binding_from_decl(decl: decl, module_root: module_root) {
          Rejected { diagnostics: d } => Rejected { diagnostics: d }
          Accepted { value: binding, diagnostics: bd } =>
            match alias_binding_row_target_from_decl(decl: decl, module_root: module_root) {
              Rejected { diagnostics: d } => Rejected { diagnostics: d }
              Accepted { value: target, diagnostics: td } =>
                Accepted {
                  value: AliasBindingRow { binding: binding, target: target },
                  diagnostics: diagnostics_merge(outer: bd, inner: td)
                }
            }
        }
      }
    Absent =>
      match find_named_child(root: decl, name: ^dag_surface_alias_decl_binding) {
        Accepted { value: _, diagnostics: _ } =>
          match alias_binding_row_binding_from_decl(decl: decl, module_root: module_root) {
            Rejected { diagnostics: d } => Rejected { diagnostics: d }
            Accepted { value: binding, diagnostics: bd } =>
              match alias_binding_row_target_from_decl(decl: decl, module_root: module_root) {
                Rejected { diagnostics: d } => Rejected { diagnostics: d }
                Accepted { value: target, diagnostics: td } =>
                  Accepted {
                    value: AliasBindingRow { binding: binding, target: target },
                    diagnostics: diagnostics_merge(outer: bd, inner: td)
                  }
              }
          }
        Rejected { diagnostics: _ } =>
          outcome_rejected(Diagnostic {
            reason: ^alias_binding_row_not_alias_decl,
            at: node_locus(node: decl),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
      }
  }
}

fn qualified_name_append_segment(qn: QualifiedName, sym: Symbol) -> QualifiedName {
  match qn {
    Empty => Cons { head: sym, tail: Empty }
    Cons { head: h, tail: t } =>
      Cons { head: h, tail: qualified_name_append_segment(qn: t, sym: sym) }
  }
}

fn qualified_name_from_symbol_segments(segments: List<Symbol>, root: Node) -> Outcome<QualifiedName> {
  let qn = fold_list(
    xs: segments,
    empty: Empty,
    cons: fn(acc, sym) {
      qualified_name_append_segment(qn: acc, sym: sym)
    }
  )
  match qn {
    Empty =>
      outcome_rejected(Diagnostic {
        reason: ^qualified_name_structure_invalid,
        at: node_locus(node: root),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    Cons { head: _, tail: _ } =>
      if for_all(xs: qn, predicate: fn(sym) { sym != ^dag_token_ident }) {
        outcome_accepted(value: qn)
      } else {
        outcome_rejected(Diagnostic {
          reason: ^qualified_name_projection_gated,
          at: node_locus(node: root),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      }
  }
}

fn qualified_name_from_emit_shaped_module_root(root: Node) -> Outcome<QualifiedName> {
  match find_labeled_child(root: root, label: dag_surface_edge_label(edge: ^dag_surface_module_header)) {
    Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
    Accepted { value: _, diagnostics: _ } =>
      match find_labeled_child(root: root, label: dag_surface_edge_label(edge: ^dag_surface_module_header_qualified_name)) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: qn_node, diagnostics: _ } =>
          match qualified_name_from_node(root: qn_node) {
            Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
            Accepted { value: qn, diagnostics: _ } =>
              match qn {
                Empty =>
                  outcome_rejected(Diagnostic {
                    reason: ^qualified_name_structure_invalid,
                    at: node_locus(node: root),
                    correction: Unavailable { reason: ExternalContractUnknown }
                  })
                Cons { head: _, tail: _ } =>
                  if for_all(xs: qn, predicate: fn(sym) { sym != ^dag_token_ident }) {
                    outcome_accepted(value: qn)
                  } else {
                    outcome_rejected(Diagnostic {
                      reason: ^qualified_name_projection_gated,
                      at: node_locus(node: root),
                      correction: Unavailable { reason: ExternalContractUnknown }
                    })
                  }
              }
          }
      }
  }
}

fn qualified_name_from_parsed_module_root(root: Node) -> Outcome<QualifiedName> {
  match parse_subtree_find_production_captured(root: root, emitted: ^dag_surface_qualified_name) {
    ParseSubtreeAbsent =>
      outcome_rejected(Diagnostic {
        reason: ^named_child_missing,
        at: node_locus(node: root),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    ParseSubtreeFound { captured: qn_capture } =>
      match parse_qualified_name_segments_from_capture(qn_capture: qn_capture, root: root) {
        Rejected { diagnostics: diags } => Rejected { diagnostics: diags }
        Accepted { value: segments, diagnostics: _ } =>
          qualified_name_from_symbol_segments(segments: segments, root: root)
      }
  }
}

fn namespace_graft_unwrap_module_working_root(root: Node) -> Node {
  match parse_production_emitted_identity_optional(node: root) {
    Present { value: id } =>
      if id == ^dag_surface_module {
        match parse_production_captured_child_optional(node: root) {
          Present { value: captured } => captured
          Absent => root
        }
      } else {
        root
      }
    Absent => root
  }
}

fn namespace_graft_has_module_header(root: Node) -> Bool {
  match find_labeled_child(root: root, label: dag_surface_edge_label(edge: ^dag_surface_module_header)) {
    Accepted { value: _, diagnostics: _ } => true
    Rejected { diagnostics: _ } => false
  }
}

fn namespace_graft_node_is_conj(node: Node) -> Bool {
  match node.kind {
    TypeNode { connective: Conj } => true
    TypeNode { connective: _ } => false
    ComputationNode { behavior: _ } => false
  }
}

// THE GRAFT BODY IS MARKED BY ITS PRODUCER, NOT INFERRED BY ITS READERS. The
// containment spine is a chain of single-Named-edge Conj wrappers, and a module
// body with exactly one Named member whose target is a Conj is the same shape as
// one more segment: `p { Flag: Conj }` read as `p.Flag`. Every spine consumer
// (this QN reader, symbol_index_fill, name_resolve export admission, the
// reference-site collector) inherited that ambiguity. The graft therefore stamps
// the body Conj with the same provenance vocabulary the module shell already uses
// -- grammar_production_identity_node_projection -> Atom(identity) -- so the
// spine ends where the producer says it ends. The captured projection is
// deliberately NOT emitted: the members are the body, and a captured wrapper
// would re-create the one-Named-Conj level the fill misreads.
data namespace_graft_module_body_identity: Symbol = ^namespace_graft_module_body

// The one constructor of the marker node: emitted by namespace_graft_build_body_conj.
// It is a surface identity atom, not a type denotation, so infer grounds it with the
// grammar authority's surface-production type (dag_grammar_production_member_declared_type)
// and a marked body stays a fully evidenced product.
fn namespace_graft_module_body_marker_node() -> Node {
  dag_inhabitant_atom(id: namespace_graft_module_body_identity)
}

// THE MARK MEANS A NAMESPACE BODY, AND MARKED BODIES MERGE ON GRAFT (XL-2 service spine; ruling
// 2026-10-01). A module body is one namespace body; so is the body under a shared service-name prefix:
// `service shell.Find` and `service shell.Env` each lower to `shell -> <namespace body>`
// (v2.compiler.body_lowering_fold body_lower_service_node), and v2.compiler.namespace_graft merges
// same-named MARKED bodies into one, so an operation's declaration path is
// <module>.<service segments...>.<Op>. Only marked bodies merge: two same-named declarations, or a
// marked body and an unmarked declaration of one name, still refuse at the second. A namespace body
// grants NO scope: a member of shell.Find does not see shell.Env's names, or the enclosing body's,
// without qualification or an import; it is a path segment, never a lexical frame. NOTE FOR THE
// EdgeLabel CUT (gunbc#12473): this mark is a namespace-body classification, so the per-segment
// marker that cut classifies covers both the module body and a service-prefix body.
fn namespace_graft_namespace_body_node(edges: List<Edge>, source: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: concat([dag_named_edge(name: ^grammar_production_identity_node_projection, target: namespace_graft_module_body_marker_node())], edges),
    occurrence_id: source.occurrence_id
  }
}

// A marked body's members -- its children without the mark -- PREPENDED onto `acc` (so in reverse
// order): the one O(members) step the graft's group merge is built from, reversed once by its caller
// (v2.compiler.namespace_graft namespace_graft_group_members). Written over FreeMonoid<Edge>, List's own
// carrier, so the branch that keeps `acc` and the branch that conses agree on one type (the emitter does
// not yet unify the List alias with a Cons literal: gunbc.recurring_failure_mode
// carrier_alias_refuses_its_own_carriers_constructor).
fn namespace_graft_namespace_body_members_onto(body: Node, acc: FreeMonoid<Edge>) -> FreeMonoid<Edge> {
  fold(body.children, init: acc, f: fn(a, e) {
    match e.label {
      Authored { name: sym } =>
        if sym == ^grammar_production_identity_node_projection { a } else { Cons { head: e, tail: a } }
      StructuralLabel { label: _ } => Cons { head: e, tail: a }
      Positional => Cons { head: e, tail: a }
    }
  })
}

fn namespace_graft_node_is_module_body(node: Node) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } => id == namespace_graft_module_body_identity
    Absent => false
  }
}

// A SPINE SEGMENT IS WHAT THE PRODUCER'S MARK SAYS IT IS, NOT WHAT IT LOOKS LIKE. A single-Named-Conj
// wrapper is a spine segment only when the chain of such wrappers below it ends at the body the graft
// stamped (namespace_graft_node_is_module_body). Shape alone was the predicate before
// (namespace_graft_spine_segment_edge_optional, deleted), and it read a record field whose type is an
// inline record -- `type R { inner: { a: Int } }` -- as a dotted-name segment, so symbol_index_fill
// indexed `R.a` and never `R.inner`; the Arrow-domain instance (#12501) was the same guess. No chain
// inside a declaration reaches the module-body marker, so no declaration can be read as a namespace.
// Grounded in the existing mark rather than a second one minted per segment: a per-segment Core
// marker waits on the EdgeLabel coproduct ruling (gunbc#12473).
fn namespace_graft_spine_chain_reaches_module_body(node: Node) -> Bool {
  namespace_graft_node_is_module_body(node: namespace_graft_spine_shaped_end(node: node))
}

// Where the single-Named-Conj chain from `node` stops. The body marker stops it
// (namespace_graft_spine_shaped_edge_optional refuses a marked body), so for a verified spine this
// is the module body.
fn namespace_graft_spine_shaped_end(node: Node) -> Node {
  match namespace_graft_spine_shaped_edge_optional(node: node) {
    Present { value: edge } => namespace_graft_spine_shaped_end(node: edge.target)
    Absent => node
  }
}

// THE ONE LINEAR SPINE WALK. Every link below a verified segment is itself a segment -- the chain
// that verified it passes through them -- so a walker verifies once at its entry and then steps by
// shape. Re-verifying membership at every level would re-walk the
// remaining chain per step, a quadratic fold (DESIGN section 6, bare minimum cost). Present only
// when `node` is a spine segment; the value is the marked module body the spine ends at.
fn namespace_graft_spine_body_optional(node: Node) -> Optional<Node> {
  match namespace_graft_spine_shaped_edge_optional(node: node) {
    Present { value: edge } =>
      let end = namespace_graft_spine_shaped_end(node: edge.target)
      if namespace_graft_node_is_module_body(node: end) {
        optional_present(value: end)
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

fn namespace_graft_spine_shaped_edge_optional(node: Node) -> Optional<Edge> {
  match node.kind {
    TypeNode { connective: Conj } =>
      if namespace_graft_node_is_module_body(node: node) {
        optional_absent()
      } else if count(node.children) != 1 {
        optional_absent()
      } else {
        match list_at_optional(xs: node.children, index: 0) {
          Absent => optional_absent()
          Present { value: edge } =>
            match edge.label {
              Authored { name: _ } =>
                if namespace_graft_node_is_conj(node: edge.target) {
                  optional_present(value: edge)
                } else {
                  optional_absent()
                }
              StructuralLabel { label: _ } => optional_absent()
              Positional => optional_absent()
            }
        }
      }
    _ => optional_absent()
  }
}

fn namespace_graft_graft_captured_spine(root: Node) -> Optional<Node> {
  let captured = namespace_graft_unwrap_module_working_root(root: root)
  if namespace_graft_has_module_header(root: captured) {
    optional_absent()
  } else {
    optional_present(value: captured)
  }
}

fn qualified_name_from_graft_spine(root: Node) -> Outcome<QualifiedName> {
  match namespace_graft_graft_captured_spine(root: root) {
    Absent =>
      outcome_rejected(Diagnostic {
        reason: ^qualified_name_structure_invalid,
        at: node_locus(node: root),
        correction: Unavailable { reason: ExternalContractUnknown }
      })
    Present { value: captured } =>
      if namespace_graft_spine_chain_reaches_module_body(node: captured) {
        namespace_graft_qualified_name_from_spine_node(node: captured, acc: Empty)
      } else {
        outcome_rejected(Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: captured),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      }
  }
}

// Entered only once the chain is verified to end at the marked body, so it steps by shape.
fn namespace_graft_qualified_name_from_spine_node(node: Node, acc: QualifiedName) -> Outcome<QualifiedName> {
  match namespace_graft_spine_shaped_edge_optional(node: node) {
    Present { value: edge } =>
      match edge.label {
        Authored { name: seg } =>
          namespace_graft_qualified_name_from_spine_node(
            node: edge.target,
            acc: qualified_name_snoc(qn: acc, segment: seg)
          )
        StructuralLabel { label: _ } =>
          outcome_rejected(Diagnostic {
            reason: ^qualified_name_structure_invalid,
            at: node_locus(node: node),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
        Positional =>
          outcome_rejected(Diagnostic {
            reason: ^qualified_name_structure_invalid,
            at: node_locus(node: node),
            correction: Unavailable { reason: ExternalContractUnknown }
          })
      }
    Absent =>
      if is_empty(xs: acc) {
        outcome_rejected(Diagnostic {
          reason: ^qualified_name_structure_invalid,
          at: node_locus(node: node),
          correction: Unavailable { reason: ExternalContractUnknown }
        })
      } else {
        outcome_accepted(value: acc)
      }
  }
}

fn namespace_graft_already_grafted(root: Node) -> Bool {
  let working = namespace_graft_unwrap_module_working_root(root: root)
  if namespace_graft_has_module_header(root: working) {
    false
  } else {
    match qualified_name_from_graft_spine(root: root) {
      Accepted { value: qn, diagnostics: _ } => !is_empty(xs: qn)
      Rejected { diagnostics: _ } => false
    }
  }
}

// SINGLE-AUTHORITY QN reader (dissolves the interim compiler-layer dual-arm wrapper
// qualified_name_from_module_node_graft_aware, namespace-resolution-design.md section 10 dissolve
// 1). Grafted roots: QN from containment nesting position (qualified_name_from_graft_spine — the
// section 10/13 single naming authority; the spine cluster homes here so the reader needs no
// compiler-layer import). Pre-graft ingress: header-path read (parsed capture or emit-shaped Named
// edges — parse emits header metadata until the normalize graft fires; no header shim re-stamped
// onto grafted trees). Wet-ingest RED controls:
// program_assembly_real_ingest_module_roots_parse_holds +
// validate_module_roots_red_on_parsed_roots.

fn qualified_name_from_module_node(root: Node) -> Outcome<QualifiedName> {
  if namespace_graft_already_grafted(root: root) {
    qualified_name_from_graft_spine(root: root)
  } else {
    match parse_production_emitted_identity_optional(node: root) {
      Present { value: id } =>
        if id == ^dag_surface_module {
          qualified_name_from_parsed_module_root(root: root)
        } else {
          qualified_name_from_emit_shaped_module_root(root: root)
        }
      Absent =>
        qualified_name_from_emit_shaped_module_root(root: root)
    }
  }
}

// THE DAG TARGET EMITS BY READING dag_grammar_root BACKWARD (docs/plans/dag-emit-one-grammar-backward.md).
// The productions are the ones ingest reads forward, so a production added there is emitted with no
// edit here. Emit's subject is the PARSE TREE. Emitting a lowered or constructed program needs body
// lowering's own inverse, a declared frontier whose consumer is gen-2 self-host emission. This
// function is not that, and must not be cited as full dag emission.
//
// A terminal's spelling is either a fixed lexeme (its lex rule, or the word a literal terminal names)
// or the inverse of the decode that parse ran on its class: the int magnitude, the float lexeme, and
// the string value re-encoded over the same escape rows. A value-carrying class with no inverse here
// refuses, located at the terminal. It never falls back to an atom's spelling.
fn dag_emit_refusal(reason: Symbol, captured: Node) -> Outcome<String> {
  outcome_rejected(
    d: Diagnostic {
      reason: reason,
      at: node_locus(node: captured),
      correction: Unavailable { reason: CorrectionNotModeled }
    }
  )
}

// Each literal is read back by the model's own reader for its payload -- the same readers lowering
// uses -- and a literal without its payload refuses by a reason that names which one, at the literal.
fn dag_emit_class_terminal_spelling(lex: LexRules, token_class: Symbol, captured: Node) -> Outcome<String> {
  if token_class == ^dag_token_int_literal {
    match dag_int_literal_magnitude_node_optional(node: captured) {
      Absent => dag_emit_refusal(reason: ^dag_emit_int_literal_magnitude_missing, captured: captured)
      Present { value: _ } =>
        bind_outcome(
          o: dag_int_literal_magnitude_int_from_node(node: captured),
          f: fn(v) { outcome_accepted(value: int_to_decimal_string(value: v)) }
        )
    }
  } else if token_class == ^dag_token_string_literal {
    match dag_string_literal_value_optional(node: captured) {
      Present { value: value } => outcome_accepted(value: dag_string_literal_encoded(value: value))
      Absent => dag_emit_refusal(reason: ^dag_emit_string_literal_value_missing, captured: captured)
    }
  } else if token_class == ^dag_token_float_literal {
    match dag_float_literal_lexeme_optional(node: captured) {
      Present { value: lexeme } => outcome_accepted(value: lexeme)
      Absent => dag_emit_refusal(reason: ^dag_emit_float_literal_lexeme_missing, captured: captured)
    }
  } else {
    match lex_rules_literal_for_class(rules: lex, token_class: token_class) {
      Accepted { value: spelling, diagnostics: d } => Accepted { value: spelling, diagnostics: d }
      Rejected { diagnostics: _ } => dag_emit_refusal(reason: ^dag_emit_token_class_untransformable, captured: captured)
    }
  }
}

fn dag_emit_token_spelling(lex: LexRules, terminal: GrammarEmitTerminal) -> Outcome<String> {
  match terminal {
    GrammarEmitClassTerminal { token_class: c, captured: n } => dag_emit_class_terminal_spelling(lex: lex, token_class: c, captured: n)
    GrammarEmitLexemeTerminal { token_class: _, lexeme: l } => outcome_accepted(value: symbol_lexeme(sym: l))
    GrammarEmitLineBreak => outcome_accepted(value: "")
  }
}

// THE TEXT BUILT SO FAR, and whether the next token is to follow a line break the grammar requires.
type DagEmitText {
  text: String
  break_pending: Bool
}

// Whitespace is trivia in dag_lex_rules, so one space between tokens cannot change the tree that is
// read back. A line break is written only where the grammar requires one (GrammarEmitLineBreak).
// Layout is otherwise a projection over this text, not a fact of the emit.
fn dag_emit_text_step(lex: LexRules, acc: DagEmitText, t: GrammarEmitTerminal) -> Outcome<DagEmitText> {
  match t {
    GrammarEmitLineBreak => outcome_accepted(value: DagEmitText { text: acc.text, break_pending: true })
    GrammarEmitClassTerminal { token_class: _, captured: _ } =>
      bind_outcome(
        o: dag_emit_token_spelling(lex: lex, terminal: t),
        f: fn(spelled) {
          let separator = if acc.text == "" { "" } else if acc.break_pending { "\n" } else { " " }
          outcome_accepted(value: DagEmitText { text: concat(acc.text, concat(separator, spelled)), break_pending: false })
        }
      )
    GrammarEmitLexemeTerminal { token_class: _, lexeme: _ } =>
      bind_outcome(
        o: dag_emit_token_spelling(lex: lex, terminal: t),
        f: fn(spelled) {
          let separator = if acc.text == "" { "" } else if acc.break_pending { "\n" } else { " " }
          outcome_accepted(value: DagEmitText { text: concat(acc.text, concat(separator, spelled)), break_pending: false })
        }
      )
  }
}

// The lexer is built once per emit and read by every terminal, never rebuilt per token.
fn dag_emit_terminals_text(lex: LexRules, terminals: List<GrammarEmitTerminal>) -> Outcome<String> {
  bind_outcome(
    o: fold(
      terminals,
      init: outcome_accepted(value: DagEmitText { text: "", break_pending: false }),
      f: fn(acc, t) { bind_outcome(o: acc, f: fn(state) { dag_emit_text_step(lex: lex, acc: state, t: t) }) }
    ),
    f: fn(state) { outcome_accepted(value: state.text) }
  )
}

fn dag_emit_parse_tree_with_root(root: GrammarRoot, tree: Node) -> Outcome<String> {
  bind_outcome(
    o: grammar_emit_parse_tree(root: root, tree: tree),
    f: fn(terminals) { dag_emit_terminals_text(lex: dag_lex(), terminals: terminals) }
  )
}

fn dag_emit_parse_tree(tree: Node) -> Outcome<String> {
  dag_emit_parse_tree_with_root(root: dag_grammar_root(), tree: tree)
}
