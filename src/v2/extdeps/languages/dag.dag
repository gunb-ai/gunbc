  )
}

fn dag_grammar_production_mvp1_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: ^dag_production_mvp1_fn_add,
    expression: dag_grammar_sequence_from_token_classes(),
    emitted: dag_grammar_atom(id: ^dag_surface_fn_decl)
  }
}

fn dag_grammar_production_mvp1_fn_pick() -> GrammarProduction {
  GrammarProduction {
    name: ^dag_production_mvp1_fn_pick,
    expression: dag_grammar_sequence_from_token_classes_pick(),
    emitted: dag_grammar_atom(id: ^dag_surface_fn_decl)
  }
}

// 🟡 narrow approximation — companion to dag_grammar_pick_arm_literal_binding: loop-body
// literal-binding whitelist for `loop <lit>` positions. Hard-lists the two mvp1 pick-lit
// bindings the emit round-trip re-ingests as idents. WHY stopgap: no value_expression grammar
// production exists in dag.dag yet. dissolve-on: replace with the value_expression production
// when it lands in dag.dag (same debt as pick-arm terminal + binding whitelist).
fn dag_grammar_loop_body_literal_binding(binding: Symbol) -> Bool {
  (binding == ^dag_binding_mvp1_pick_lit_one) || (binding == ^dag_binding_mvp1_pick_lit_two)
}

fn dag_grammar_terminal_for_mvp1_loop_token(token: ConcreteSyntaxToken) -> GrammarExpr {
  let cls = concrete_syntax_token_class(token: token)
  if cls == ^dag_token_kw_loop {
    dag_grammar_terminal(token_class: ^dag_token_kw_loop)
  } else {
    match token {
      BoundToken { token_class: c, binding: b } =>
        if (c == ^dag_token_ident) && dag_grammar_loop_body_literal_binding(binding: b) {
          dag_grammar_pick_arm_literal_terminal()
        } else {
          dag_grammar_terminal_from_concrete_token(token: token)
        }
      _ => dag_grammar_terminal_from_concrete_token(token: token)
    }
  }
}

fn dag_grammar_sequence_from_token_classes_loop() -> GrammarExpr {
  match fold_list(
    xs: dag_mvp1_loop_concrete_tokens(),
    empty: DagGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        DagGramBuild1StateInit =>
          DagGramBuild1StateReady {
            expr: dag_grammar_terminal_for_mvp1_loop_token(token: token)
          }
        DagGramBuild1StateReady { expr: acc } =>
          DagGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: dag_grammar_terminal_for_mvp1_loop_token(token: token)
            }
          }
      }
    }
  ) {
    DagGramBuild1StateInit =>
      dag_grammar_terminal(token_class: ^dag_token_kw_fn)
    DagGramBuild1StateReady { expr: result } => result
  }
}

fn dag_grammar_production_mvp1_fn_loop() -> GrammarProduction {
  GrammarProduction {
    name: ^dag_production_mvp1_fn_loop,
    expression: dag_grammar_sequence_from_token_classes_loop(),
    emitted: dag_grammar_atom(id: ^dag_surface_fn_decl)
  }
}

