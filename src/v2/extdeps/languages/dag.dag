}

fn dag_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  grammar_expr_terminal(token_class: token_class)
}


fn dag_grammar_terminal_bound(token_class: Symbol, binding: Symbol) -> GrammarExpr {
  grammar_expr_terminal_bound(token_class: token_class, binding: binding)
}


fn dag_grammar_terminal_from_concrete_token(token: ConcreteSyntaxToken) -> GrammarExpr {
  formal_grammar_symbol_to_grammar_expr(
    sym: dag_formal_grammar_symbol_from_token(token: token)
  )
}

fn dag_grammar_nonterminal(production: Symbol) -> GrammarExpr {
  Nonterminal { production: production }
}

fn dag_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}

fn dag_grammar_choice(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Choice { left: left, right: right }
}

fn dag_grammar_optional(element: GrammarExpr) -> GrammarExpr {
  grammar_expr_optional(element: element)
}

fn dag_grammar_repeat(element: GrammarExpr) -> GrammarExpr {
  Repeat { element: element }
}

fn dag_grammar_comma_list_expr(item: GrammarExpr) -> GrammarExpr {
  dag_grammar_sequence(
    left: item,
    right: dag_grammar_sequence(
      left: dag_grammar_repeat(
        element: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_comma),
          right: item
        )
      ),
      right: dag_grammar_optional(element: dag_grammar_terminal(token_class: ^dag_token_comma))
    )
  )
}

fn dag_grammar_module_header_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_module),
    right: dag_grammar_nonterminal(production: ^dag_production_qualified_name)
  )
}

fn dag_grammar_qualified_name_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_ident),
    right: dag_grammar_repeat(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_dot),
        right: dag_grammar_terminal(token_class: ^dag_token_ident)
      )
    )
  )
}

fn dag_grammar_generic_params_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lt),
    right: dag_grammar_sequence(
      left: dag_grammar_comma_list_expr(item: dag_grammar_terminal(token_class: ^dag_token_ident)),
      right: dag_grammar_terminal(token_class: ^dag_token_gt)
    )
  )
}

fn dag_grammar_typed_param_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_ident),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_colon),
      right: dag_grammar_nonterminal(production: ^dag_production_type_expr)
    )
  )
}

fn dag_grammar_param_list_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lparen),
    right: dag_grammar_sequence(
      left: dag_grammar_optional(
        element: dag_grammar_comma_list_expr(item: dag_grammar_typed_param_expr())
      ),
      right: dag_grammar_terminal(token_class: ^dag_token_rparen)
    )
  )
}

fn dag_grammar_qualified_type_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_nonterminal(production: ^dag_production_qualified_name),
    right: dag_grammar_optional(
      element: dag_grammar_sequence(
        left: dag_grammar_terminal(token_class: ^dag_token_lt),
        right: dag_grammar_sequence(
          left: dag_grammar_optional(
            element: dag_grammar_comma_list_expr(
              item: dag_grammar_nonterminal(production: ^dag_production_type_expr)
            )
          ),
          right: dag_grammar_terminal(token_class: ^dag_token_gt)
        )
      )
    )
  )
}

fn dag_grammar_type_list_expr() -> GrammarExpr {
  dag_grammar_comma_list_expr(
    item: dag_grammar_nonterminal(production: ^dag_production_type_expr)
  )
}

fn dag_grammar_fn_type_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_fn),
    right: dag_grammar_sequence(
      left: dag_grammar_terminal(token_class: ^dag_token_lparen),
      right: dag_grammar_sequence(
        left: dag_grammar_optional(element: dag_grammar_type_list_expr()),
        right: dag_grammar_sequence(
          left: dag_grammar_terminal(token_class: ^dag_token_rparen),
          right: dag_grammar_sequence(
            left: dag_grammar_terminal(token_class: ^dag_token_arrow),
            right: dag_grammar_nonterminal(production: ^dag_production_type_expr)
          )
        )
      )
    )
  )
}

fn dag_grammar_type_expr() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_qualified_type_expr(),
    right: dag_grammar_nonterminal(production: ^dag_production_fn_type)
  )
}

fn dag_grammar_import_block_expr() -> GrammarExpr {
  dag_grammar_sequence(
    left: dag_grammar_terminal(token_class: ^dag_token_lbrace),
    right: dag_grammar_sequence(
      left: dag_grammar_comma_list_expr(item: dag_grammar_terminal(token_class: ^dag_token_ident)),
      right: dag_grammar_terminal(token_class: ^dag_token_rbrace)
    )
  )
}

fn dag_grammar_field_decl_expr() -> GrammarExpr {
