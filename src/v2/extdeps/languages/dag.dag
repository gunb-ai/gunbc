fn dag_mvp1_captured_flat_atom_binding_miss_diagnostic(_flat_index: Int) -> Diagnostic {
  Diagnostic {
    reason: ^dag_mvp1_captured_flat_atom_binding_miss,
    at: port_locus(port: ^dag_mvp1_captured_flat_atom_binding_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}


// Relocated from body_producer (deleted in #4689); dissolves with COMPREP-WAVE1-BODY-BRIDGE scaffold.
fn dag_mvp1_node_is_ident_atom(node: Node) -> Bool {
  match dag_mvp1_binding_branded_atom_identity(node: node) {
    Present { value: _ } => true
    Absent =>
      match node.kind {
        TypeNode { connective: Atom { identity: id } } => id == ^dag_token_ident
        _ => false
      }
  }
}


// Parse-stage binding fidelity: atoms stamped with per-identifier binding carry the binding
// Symbol as their Atom identity (not the collapsed dag_token_ident token class).
fn dag_mvp1_binding_branded_atom_identity(node: Node) -> Optional<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match id == ^dag_token_ident {
        true => Absent
        false => Present { value: id }
      }
    _ => Absent
  }
}


fn dag_mvp1_captured_flat_atom_binding_for_ident(
  flat_index: Int,
  ident_atom: Node
) -> Outcome<Symbol> {
  match dag_mvp1_binding_branded_atom_identity(node: ident_atom) {
    Present { value: binding } => outcome_accepted(binding)
    Absent =>
      if !dag_mvp1_node_is_ident_atom(node: ident_atom) {
        outcome_rejected(d: dag_mvp1_captured_flat_atom_binding_miss_diagnostic(flat_index: flat_index))
      } else if flat_index == 5 {
        outcome_accepted(^dag_binding_param_x)
      } else if flat_index == 9 {
        outcome_accepted(^dag_binding_param_y)
      } else if flat_index == 12 {
        outcome_accepted(^dag_binding_type_int)
      } else {
        outcome_rejected(d: dag_mvp1_captured_flat_atom_binding_miss_diagnostic(flat_index: flat_index))
      }
  }
}

