// RTADD / ctrl#1489 — MVP-1 add keystone target model (mirror rust_mvp1_target_model).
data dag_mvp1_source_text: String = "fn add(x:Int, y:Int) -> Int { x + y }"

// COMPREP wave-2 M0-B1 — Bool if-then-else body keystone (design-comprep-m0-branch-mapping.md).
data dag_mvp1_pick_source_text: String = "fn one_or_two() -> Int { if true then 1 else 2 }"
data dag_mvp1_pick_false_source_text: String = "fn one_or_two() -> Int { if false then 1 else 2 }"

// COMPREP wave-2 M0-Loop — loop expression body keystone.
data dag_mvp1_loop_source_text: String = "fn one() -> Int { loop 1 }"
data dag_mvp1_loop_wrong_value_source_text: String = "fn one() -> Int { loop 2 }"
// COMPREP wave-2 M0-Bind — let-in expression body keystone.
data dag_mvp1_bind_source_text: String = "fn one() -> Int { let x = 1 in x }"
data dag_mvp1_bind_wrong_value_source_text: String = "fn one() -> Int { let x = 2 in x }"
// COMPREP wave-2 M0-Match — Bool match expression body keystone.
data dag_mvp1_match_source_text: String = "fn one_or_two() -> Int { match true { true => 1, false => 2 } }"
// COMPREP wave-2 M0-Record — record construct body keystone.
data dag_mvp1_rec_source_text: String = "fn mk() -> Rec { Rec { v: 9 } }"
// COMPREP wave-2 M0-FieldAccess — field access body keystone.
data dag_mvp1_field_access_source_text: String = "fn get(r: Rec) -> Int { r.v }"

fn dag_mvp1_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^dag_token_kw_fn },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_fn_add },
    FixedToken { token_class: ^dag_token_lparen },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_param_x },
    FixedToken { token_class: ^dag_token_colon },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_type_int },
    FixedToken { token_class: ^dag_token_comma },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_param_y },
    FixedToken { token_class: ^dag_token_colon },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_type_int },
    FixedToken { token_class: ^dag_token_rparen },
    FixedToken { token_class: ^dag_token_arrow },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_type_int },
    FixedToken { token_class: ^dag_token_lbrace },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_param_x },
    FixedToken { token_class: ^dag_token_plus },
    BoundToken { token_class: ^dag_token_ident, binding: ^dag_binding_param_y },
    FixedToken { token_class: ^dag_token_rbrace }
  ]
}

