// THE KERNEL VALUE TYPES, ONE ROSTER. A kernel type is a type whose values the kernel carries, and
// what it DENOTES is a node its std authority owns: v2.std.integer integer_int_type_node,
// v2.std.logic bool_node, v2.std.node symbol_type_node, v2.std.compilers.target_model symbol_kernel_type_node and
// char_kernel_type_node. A row points at that node and mints none of its own.
//
// THE CANONICAL BINDING OF A KERNEL TYPE IS THE ATOM IDENTITY OF ITS VALUE-TYPE NODE, derived from
// the row (dag_kernel_value_type_binding) and written nowhere else. So the three questions asked of
// a kernel type are three folds over these rows and cannot disagree: which binding a spelling takes
// (dag_kernel_type_binding_optional), which binding a declaration takes
// (dag_kernel_type_declaration_binding_optional), and what a binding denotes
// (dag_binding_denotation). Before this roster each was its own if-chain, and for Bool they did
// disagree: v2.compiler.resolve bound a declared `Bool` to bool_node's identity while the join
// denoted a second symbol only hand-built fixtures carried, so a declared Bool on the resolve route
// reached every declared-type judgment as an atom the join answered Absent for.
//
// A SPELLING ROW IS A SEPARATE FACT FROM BEING A KERNEL ATOM. `spelling` and `declarations` say that
// v2.compiler.resolve binds that authored name, where it resolves to one of those declarations or
// to nothing, to the kernel type. Int and Bool carry them. Int's two declarations stand until its
// de-fork lane consolidates them (docs/plans/dag-v2-defork-audit.md), and its row follows that lane
// rather than choosing. Bool's lane has landed: std.types Bool is its one declaration, and its row
// names that declaration as what the v2 carrier bool_node carries, keyed by identity rather than by
// bool_node's module.
//
// SYMBOL IS A KERNEL TYPE BY ITS DECLARATION'S OWN NODE (gunbc#12549): the spelling `Symbol` and
// the declaration v2.std.node Symbol bind to v2.std.node symbol_type_node's identity, which is what a
// symbol literal is typed as. That row is an ordinary spelled row like Int's and Bool's.
//
// WHAT STAYS A FORK, RECORDED AND NOT RESOLVED HERE: v2.std.compilers.target_model carries its OWN
// kernel atoms for Symbol and Char (symbol_kernel_type_node, char_kernel_type_node), a second
// authority beside the declaration each spelling resolves to (v2.std.node Symbol, std.types Char).
// The ruling for Int and Bool is one authority, the declaration visible in scope, so those two rows
// carry NO spelling -- binding a spelling to them here would change what every reference resolves
// to -- and name in `converges_on` the declaration each converges on once de-forked. Nothing binds
// through `converges_on`; it is the de-fork lane's subject, read today only by the control that
// holds the fork as it is (v2.test.claim.compiler.kernel_value_type_roster_witness_test).
//
// A kernel type with NO value-type node in a v2 std authority has no row: there is nothing for one
// to point at. Float, Secret, Json, Unit and Bytes (std.types kernel_type_set) are in that state,
// each rostered under gunbc.recurring_failure_mode with its node as the trigger. STRING IS A KERNEL TYPE
// BY ITS OWN DECLARATION (gunbc#12760): v2.std.node String, the opaque host text, with
// host_text_type_node. It is NOT v2.std.text String, which is the structural FreeMonoid<Char>
// (DESIGN section 4, the text ruling). Its row is the one whose foreign_declaration is
// ForeignDeclarationBinds: String is the one kernel spelling the corpus also declares with another
// meaning, so a String declaration the author reached binds that declaration and the host text
// applies only where none is visible (neat-boar-16, decision A). Every other row refuses a foreign
// declaration of its spelling.
type KernelValueType {
  value_type: Node
  spelling: Optional<String>
  declarations: List<QualifiedName>
  converges_on: Optional<QualifiedName>
  foreign_declaration: KernelSpellingForeignDeclaration
}

data dag_kernel_value_type_roster: List<KernelValueType> = [
  KernelValueType {
    value_type: integer_int_type_node(),
    spelling: optional_present(value: "Int"),
    declarations: [
      qualified_name_from_dotted_string(dotted: "v2.std.integer.Int"),
      qualified_name_from_dotted_string(dotted: "std.integer.Int")
    ],
    converges_on: optional_absent()
    foreign_declaration: ForeignDeclarationRefuses
  },
  KernelValueType {
    value_type: bool_node(),
    spelling: optional_present(value: "Bool"),
    declarations: [qualified_name_from_dotted_string(dotted: "std.types.Bool")],
    converges_on: optional_absent()
    foreign_declaration: ForeignDeclarationRefuses
  },
  KernelValueType {
    value_type: symbol_type_node(),
    spelling: optional_present(value: "Symbol"),
    declarations: [qualified_name_from_dotted_string(dotted: "v2.std.node.Symbol")],
    converges_on: optional_absent()
    foreign_declaration: ForeignDeclarationRefuses
  },
  KernelValueType {
    value_type: host_text_type_node(),
    spelling: optional_present(value: "String"),
    declarations: [qualified_name_from_dotted_string(dotted: "v2.std.node.String")],
    converges_on: optional_absent(),
    foreign_declaration: ForeignDeclarationBinds
  },
  KernelValueType {
    value_type: symbol_kernel_type_node(),
    spelling: optional_absent(),
    declarations: [],
    converges_on: optional_present(value: qualified_name_from_dotted_string(dotted: "v2.std.node.Symbol"))
    foreign_declaration: ForeignDeclarationRefuses
  },
  KernelValueType {
    value_type: char_kernel_type_node(),
    spelling: optional_absent(),
    declarations: [],
    converges_on: optional_present(value: qualified_name_from_dotted_string(dotted: "std.types.Char"))
    foreign_declaration: ForeignDeclarationRefuses
  }
]

// THE DAG LANGUAGE'S PRIMITIVES IN THE STRUCTURE-SIGNATURE WORLD, as every other language model states its
// own (v2.extdeps.languages.rust rust_integer_algebra_inhabitance, rust_bool_algebra_inhabitance; swift,
// java, lean, cpp, python likewise): the kernel Int inhabits the ordered ring and the kernel Bool the boolean
// algebra, each over its kernel value-type node from dag_kernel_value_type_roster. An operator names its field
// in THIS vocabulary (v2.std.compilers.target_model canonical_operation_op_add is ^ring_field_add, op_or is
// ^lattice_field_join), so a reader asking whether a type carries an operator's field asks these rows.
// THE FACT IS NOT RESTATED: each row's WITNESS is a reference to the std value that already IS the
// inhabitance -- v2.std.integer int_ordered_ring: OrderedRing<Int> and v2.std.logic bool_boolean_algebra:
// BooleanAlgebra<Bool> -- the same way v2.extdeps.languages.cpp cpp_bool_grounding cites the latter. That the
// std.algebra record (add/mul/join) and the signature node (^ring_field_add, ..) are two representations of one
// structure with no declared mapping is gunbc.recurring_failure_mode
// algebra_structure_has_two_representations_with_no_declared_mapping, not resolved here.
// CONSUMER: the v2 infer algebra-operator arm (v2.compiler.infer infer_algebra_field_result_type: the Bool join
// and Int add through one route), landing in gunbc#13060, stacked on this change; until it lands these rows are a
// declared frontier read only by v2.test.claim.dag_algebra_inhabitance.
fn dag_int_algebra_inhabitance() -> AlgebraInhabitanceDecl {
  let inhabitant = integer_int_type_node()
  AlgebraInhabitanceDecl {
    algebra: ordered_ring_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: declaration_reference_node(qn: qualified_name_from_dotted_string(dotted: "v2.std.integer.int_ordered_ring"), occurrence_id: OccurrenceSynthetic)
  }
}

fn dag_bool_algebra_inhabitance() -> AlgebraInhabitanceDecl {
  let inhabitant = bool_node()
  AlgebraInhabitanceDecl {
    algebra: boolean_algebra_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: declaration_reference_node(qn: qualified_name_from_dotted_string(dotted: "v2.std.logic.bool_boolean_algebra"), occurrence_id: OccurrenceSynthetic)
  }
}

fn dag_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  [dag_int_algebra_inhabitance(), dag_bool_algebra_inhabitance()]
}

fn dag_kernel_value_type_binding(row: KernelValueType) -> Optional<Symbol> {
  match row.value_type.kind {
    TypeNode { connective: Atom { identity: id } } => optional_present(value: id)
    _ => optional_absent()
  }
}

fn dag_kernel_value_type_bindings() -> List<Symbol> {
  fold(dag_kernel_value_type_roster, init: [], f: fn(acc, row) {
    match dag_kernel_value_type_binding(row: row) {
      Present { value: binding } => list_snoc_item(xs: acc, item: binding)
      Absent => acc
    }
  })
}

fn dag_kernel_value_type_spelled(row: KernelValueType, sym: Symbol) -> Bool {
  match row.spelling {
    Present { value: spelling } => symbol_lexeme(sym: sym) == spelling
    Absent => false
  }
}

// The first row a predicate selects, with its binding. A row whose value-type node is not an atom
// has no binding and selects nothing.
fn dag_kernel_value_type_first(select: fn(KernelValueType, Symbol) -> Bool) -> Optional<KernelValueType> {
  fold(dag_kernel_value_type_roster, init: optional_absent(), f: fn(acc, row) {
    match acc {
      Present { value: _ } => acc
      Absent =>
        match dag_kernel_value_type_binding(row: row) {
          Absent => acc
          Present { value: binding } => if select(row, binding) { optional_present(value: row) } else { acc }
        }
    }
  })
}

fn dag_kernel_value_type_row_binding(found: Optional<KernelValueType>) -> Optional<Symbol> {
  match found {
    Present { value: row } => dag_kernel_value_type_binding(row: row)
    Absent => optional_absent()
  }
}

fn dag_int_type_binding() -> Symbol {
  ^dag_binding_type_int
}

// THE BINDING A KERNEL TYPE SPELLING TAKES. The roster is keyed here by spelling, so
// v2.compiler.resolve asks it only where no declaration answered the name (unbound). It also gates
// the ambiguous case, whose candidates are read through
// dag_kernel_type_declaration_binding_optional. Where a declaration answered, resolve reads
// dag_kernel_type_declaration_binding_optional instead
// (gunbc.recurring_failure_mode kernel_type_spelling_captured_a_module_declaration). A symbol that
// already IS a kernel binding answers itself.
fn dag_kernel_type_binding_optional(sym: Symbol) -> Optional<Symbol> {
  dag_kernel_value_type_row_binding(
    found: dag_kernel_value_type_first(select: fn(row, binding) {
      (sym == binding) || dag_kernel_value_type_spelled(row: row, sym: sym)
    })
  )
}

// WHAT ANOTHER DECLARATION OF A KERNEL SPELLING MEANS. For Int, Bool and Symbol the corpus has no
// second meaning, so a foreign declaration of the spelling is a capture hazard and refuses
// (v2.compiler.resolve resolve_kernel_type_reading). String is the one kernel spelling the corpus
// already declares with a DIFFERENT meaning: v2.std.text and std.string_type declare the structural
// FreeMonoid<Char>, deliberately, and hundreds of modules import it. So a String declaration the
// author reached binds THAT declaration, and the kernel host text applies only where none is visible
// (neat-boar-16's ruling, decision A). Representation is decided by declaration identity, never by
// the spelling.
type KernelSpellingForeignDeclaration
  = ForeignDeclarationRefuses
  | ForeignDeclarationBinds

fn dag_kernel_type_foreign_declaration(canonical: Symbol) -> KernelSpellingForeignDeclaration {
  match dag_kernel_value_type_first(select: fn(_row, binding) { canonical == binding }) {
    Present { value: row } => row.foreign_declaration
    Absent => ForeignDeclarationRefuses
  }
}

// THE KERNEL SPELLING OF THE TYPE A STRING LITERAL DENOTES: host text, the kernel `String`
// (DESIGN section 4, Ruling 3; ruling neat-boar-16: an unimported String denotes the kernel text
// binding, never std.string_type). It is admitted as a key type only where the kernel table above
// binds it, which it does since gunbc#12760 (v2.std.node String, host_text_type_node); a `String`
// that resolves to a declaration is a different type. Consumed by v2.compiler.resolve's map arm (the key-kind rule).
fn dag_kernel_string_type_spelling(sym: Symbol) -> Bool {
  symbol_lexeme(sym: sym) == "String"
}

// THE DECLARATIONS A KERNEL TYPE SPELLING DENOTES. A kernel spelling that resolves, through an
// import or another module's declaration, to a declaration a row lists takes that row's binding.
// Resolving to any other declaration is refused rather than captured
// (v2.compiler.resolve resolve_kernel_type_reading).
fn dag_kernel_type_declaration_binding_optional(path: QualifiedName) -> Optional<Symbol> {
  dag_kernel_value_type_row_binding(
    found: dag_kernel_value_type_first(select: fn(row, _binding) {
      any(xs: row.declarations, predicate: fn(declared) { declared == path })
    })
  )
}

// THE BINDING->DENOTATION JOIN. What a kernel binding DENOTES is its row's value-type node, the
// node its std authority owns; infer consumes it (v2.compiler.infer infer_node_facts) and the
// declared-type judge compares at it. Specimen-scope interim in the same frame as
// infer_node_declared_in_dag_inhabitants: deletes in favor of consuming resolution output when
// the resolver hands infer declaration-resolved identities directly (the namespace migration's
// completed state).
fn dag_binding_denotation(sym: Symbol) -> Optional<Node> {
  match dag_kernel_value_type_first(select: fn(_row, binding) { sym == binding }) {
    Present { value: row } => optional_present(value: row.value_type)
    Absent => optional_absent()
  }
}

fn dag_binding_branded_atom_identity(node: Node) -> Optional<Symbol> {
  match node.kind {
    TypeNode { connective: Atom { identity: id } } =>
      match id == ^dag_token_ident {
        true => Absent
        false => Present { value: id }
      }
    TypeNode { connective: _ } => Absent
    ComputationNode { behavior: _ } => Absent
  }
}

fn dag_loop_measure_node() -> Node {
  dag_type_atom_node(identity: ^dag_loop_measure_sym)
}

fn dag_loop_body_from_literal(lit: Node) -> Node {
  Node {
    kind: ComputationNode { behavior: Loop },
    children: [
      Edge {
        label: Positional,
        target: lit
      },
      Edge {
        label: core_edge_label(marker: LoopBoundEdge),
        target: dag_loop_measure_node()
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn dag_loop_body_node() -> Node {
  dag_loop_body_from_literal(lit: dag_int_literal_fixture_one())
}

fn dag_loop_body_wrong_value_node() -> Node {
  dag_loop_body_from_literal(lit: dag_int_literal_fixture_two())
}

fn dag_loop_arrow_with_body_node() -> Node {
  dag_arrow_with_body_node(
    domain: dag_pick_arrow_domain_conj_node(),
    return_type_binding: ^dag_binding_type_int,
    body: dag_loop_body_node()
  )
}

fn dag_loop_arrow_with_body_wrong_value_node() -> Node {
  dag_arrow_with_body_node(
    domain: dag_pick_arrow_domain_conj_node(),
    return_type_binding: ^dag_binding_type_int,
    body: dag_loop_body_wrong_value_node()
  )
}

data dag_loop_body_fixture: Node = dag_loop_body_node()
data dag_loop_arrow_with_body_fixture: Node = dag_loop_arrow_with_body_node()
data dag_loop_arrow_with_body_wrong_value_fixture: Node = dag_loop_arrow_with_body_wrong_value_node()
data dag_fixture_emitted_loop_fn: Node = dag_loop_arrow_with_body_fixture

fn dag_node_is_kw_true_atom(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => id == ^dag_token_kw_true
    Absent => false
  }
}

fn dag_node_is_kw_false_atom(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => id == ^dag_token_kw_false
    Absent => false
  }
}

fn dag_node_is_int_literal_atom(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => id == ^dag_token_int_literal
    Absent => false
  }
}

// A CARET SYMBOL LOWERS TO A SYMBOL LITERAL, NOT A REFERENCE: std.syntax LitSymbol, elaborated as
// std.literal_elaboration KernelSymbolLiteral. Its name terminal is lexeme-stamped by
// dag_grammar_caret_symbol_expr (the int literal's StampLexeme precedent), so the node is the caret
// atom carrying that terminal -- with its authored occurrence -- as its one named payload. The
// payload is the symbol's value, never a name the resolver looks up.
fn dag_symbol_literal_node(name: Node, occurrence_id: NodeOccurrenceIdentity) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^dag_token_caret } },
    children: [Edge { label: Authored { name: ^symbol_literal_name_field }, target: name }],
    occurrence_id: occurrence_id
  }
}

fn dag_symbol_literal_name_edge_target_optional(edge: Edge) -> Optional<Node> {
  match edge.label {
    Authored { name: field } =>
      if field == ^symbol_literal_name_field {
        optional_present(value: edge.target)
      } else {
        optional_absent()
      }
    StructuralLabel { label: _ } => optional_absent()
    Positional => optional_absent()
  }
}

fn dag_symbol_literal_name_optional(node: Node) -> Optional<Node> {
  match node_atom_identity_optional(node: node) {
    Absent => optional_absent()
    Present { value: id } =>
      if (id == ^dag_token_caret) && (length(xs: node.children) == 1) {
        match list_at_optional(xs: node.children, index: 0) {
          Present { value: edge } => dag_symbol_literal_name_edge_target_optional(edge: edge)
          Absent => optional_absent()
        }
      } else {
        optional_absent()
      }
  }
}

fn dag_node_is_float_literal_atom(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => id == ^dag_token_float_literal
    Absent => false
  }
}

// Single authority for eval literal-vs-binding dispatch (v2_eval_is_literal_shaped_node projects
// this). Fixture pick literals admit both token_class (^dag_pick_lit_*) and branded binding
// (^dag_binding_pick_lit_*) rows — same ingest surface, two spellings. Complement bool literals
// (^dag_complement_lit_*) are logic-ingest tokens used as scrutinee/body literals in complement
// fixtures. dissolve-on: general body producer lands grammar-owned literal classification and this
// roster folds into it.

fn dag_symbol_is_fixture_pick_literal(id: Symbol) -> Bool {
  (id == ^dag_pick_lit_one)
    || (id == ^dag_pick_lit_two)
    || (id == ^dag_binding_pick_lit_one)
    || (id == ^dag_binding_pick_lit_two)
}

fn dag_symbol_is_complement_bool_literal(id: Symbol) -> Bool {
  (id == ^dag_complement_lit_true) || (id == ^dag_complement_lit_false)
}

fn dag_symbol_is_fixture_record_literal_atom(id: Symbol) -> Bool {
  (id == ^dag_binding_rec_v)
    || (id == ^dag_rec_lit_nine)
    || (id == ^dag_binding_type_variant_true)
}

fn dag_symbol_is_fixture_body_literal_atom(id: Symbol) -> Bool {
  dag_symbol_is_fixture_pick_literal(id: id)
    || dag_symbol_is_complement_bool_literal(id: id)
    || dag_symbol_is_fixture_record_literal_atom(id: id)
}

fn dag_node_is_eval_literal_atom(node: Node) -> Bool {
  dag_node_is_kw_true_atom(node: node)
    || dag_node_is_kw_false_atom(node: node)
    || dag_node_is_int_literal_atom(node: node)
    || match node_atom_identity_optional(node: node) {
         Present { value: id } => dag_symbol_is_fixture_body_literal_atom(id: id)
         Absent => false
       }
}

// THE PARAMETER IS THE NODE-LEVEL OCCURRENCE, NOT THE RAW ID. It is assigned straight into
// Node.occurrence_id, which is a NodeOccurrenceIdentity -- the coproduct of OccurrenceSynthetic and
// OccurrenceMinted. A bare OccurrenceId is the PAYLOAD INSIDE one of those arms, never a member of
// the coproduct itself, which is the whole modeling error in one line.
// Declaring the raw OccurrenceId here meant a caller could satisfy the signature
// with an unwrapped id and build a Node whose occurrence field held a value outside the coproduct;
// every downstream match over the two variants then failed at run time with a non-exhaustive
// pattern on OccurrenceId, which is what took the required floor red at #8833. Every real caller
// was already passing a NodeOccurrenceIdentity (OccurrenceSynthetic at the fixtures, node.occurrence_id
// in the body-lowering fold), so this declaration was the outlier, not them.
fn dag_int_literal_node_from_magnitude(magnitude: DecimalMagnitude, occurrence_id: NodeOccurrenceIdentity) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^dag_token_int_literal } },
    children: [
      Edge {
        label: Authored { name: ^integer_literal_magnitude_field },
        target: integer_decimal_magnitude_node(magnitude: magnitude)
      }
    ],
    occurrence_id: occurrence_id
  }
}

fn dag_int_literal_node_from_lexeme(lexeme: String, occurrence_id: NodeOccurrenceIdentity) -> Outcome<Node> {
  match integer_string_to_decimal_digits_optional(s: lexeme) {
    Present { value: digits } =>
      outcome_accepted(
        value: dag_int_literal_node_from_magnitude(
          magnitude: decimal_digits_to_magnitude(digits: digits),
          occurrence_id: occurrence_id
        )
      )
    Absent =>
      outcome_rejected(
        d: Diagnostic {
          reason: ^dag_int_literal_lexeme_invalid,
          at: invariant_port_locus(
            port: ^dag_int_literal_decode_port,
            invariant: ^dag_int_literal_lexeme_invalid
          ),
          correction: Unavailable { reason: CorrectionNotModeled }
        }
      )
  }
}

// Lexeme capture, not IEEE decode. Identity stays `dag_token_float_literal` so 1.8 and 2.5
// are not the same class-stamped atom. Magnitude home is the dissolve-on below, not this string.
fn dag_float_literal_node_from_lexeme(lexeme: String, occurrence_id: NodeOccurrenceIdentity) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^dag_token_float_literal } },
    children: [
      Edge {
        label: Authored { name: ^float_literal_lexeme_field },
        target: Node {
          kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: lexeme) } },
          children: [],
          occurrence_id: OccurrenceSynthetic
        }
      }
    ],
    occurrence_id: occurrence_id
  }
}

// The lexeme a float literal carries, read the way the int literal's magnitude is: from the payload
// edge of the float class atom, absent on any other node.
fn dag_float_literal_lexeme_optional(node: Node) -> Optional<String> {
  match node_atom_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_token_float_literal {
        fold(node.children, init: optional_absent(), f: fn(acc, edge) {
          match acc {
            Present { value: _ } => acc
            Absent =>
              match edge.label {
                Authored { name: field } =>
                  if field == ^float_literal_lexeme_field {
                    match node_atom_identity_optional(node: edge.target) {
                      Present { value: l } => optional_present(value: symbol_lexeme(sym: l))
                      Absent => optional_absent()
                    }
                  } else {
                    optional_absent()
                  }
                StructuralLabel { label: _ } => optional_absent()
                Positional => optional_absent()
              }
          }
        })
      } else {
        optional_absent()
      }
    Absent => optional_absent()
  }
}

// A STRING LITERAL CARRIES ITS VALUE. The token's lexeme is its spelling -- the framing quotes and
// every escape as written -- and the value is that spelling decoded through dag_string_escapes: the
// quotes removed, each escape replaced by the scalar its row names. The node is the string-literal
// class atom with the decoded value as its one named payload (^string_literal_value_field), the
// shape the int literal's magnitude and the float literal's lexeme already use, so two different
// literals are two different nodes. Before this, every string literal parsed to one childless
// ^dag_token_string_literal atom and its value was dropped. The payload is host text interned as a
// Symbol; how it relates to v2.std.text String (FreeMonoid<Char>) is not decided here
// (gunbc.rung_drop text_boundary_identity_wall), and nothing coerces it.
type DagStringDecode
  = DagStringDecodeText { text: String }
  | DagStringDecodeEscape { text: String }
  | DagStringDecodeHex { text: String, digits: Int, value: Int }
  | DagStringDecodeUnicodeOpen { text: String }
  | DagStringDecodeUnicode { text: String, digits: Int, value: Int }
  | DagStringDecodeMalformed { spelled: Int }

fn dag_string_escape_value_optional(spelled: Int) -> Optional<Int> {
  fold_list(
    xs: dag_string_escapes(),
    empty: optional_absent(),
    cons: fn(found, row) { if row.spelled == spelled { optional_present(value: row.value) } else { found } }
  )
}

fn dag_string_hex_digit_optional(c: Int) -> Optional<Int> {
  let spelled = from_code_point(cp: c)
  fold_list(
    xs: base16_digit_rows,
    empty: optional_absent(),
    cons: fn(found, row) { if (row.lower == spelled) || (row.upper == spelled) { optional_present(value: row.value) } else { found } }
  )
}

fn dag_string_decode_append(text: String, code_point: Int) -> DagStringDecode {
  DagStringDecodeText { text: concat(text, from_code_point(cp: code_point)) }
}

fn dag_string_decode_escape_step(t: String, c: Int) -> DagStringDecode {
  if c == 120 {
    DagStringDecodeHex { text: t, digits: 0, value: 0 }
  } else if c == 117 {
    DagStringDecodeUnicodeOpen { text: t }
  } else {
    match dag_string_escape_value_optional(spelled: c) {
      Present { value: v } => dag_string_decode_append(text: t, code_point: v)
      Absent => DagStringDecodeMalformed { spelled: c }
    }
  }
}

fn dag_string_decode_hex_step(t: String, digits: Int, value: Int, c: Int) -> DagStringDecode {
  match dag_string_hex_digit_optional(c: c) {
    Present { value: d } =>
      if digits == 1 {
        dag_string_decode_append(text: t, code_point: (value * 16) + d)
      } else {
        DagStringDecodeHex { text: t, digits: 1, value: d }
      }
    Absent => DagStringDecodeMalformed { spelled: c }
  }
}

fn dag_string_decode_unicode_step(t: String, digits: Int, value: Int, c: Int) -> DagStringDecode {
  if c == 125 {
    if (digits > 0) && unicode_scalar(code_point: value) {
      dag_string_decode_append(text: t, code_point: value)
    } else {
      DagStringDecodeMalformed { spelled: c }
    }
  } else {
    match dag_string_hex_digit_optional(c: c) {
      Present { value: d } =>
        if digits >= 6 {
          DagStringDecodeMalformed { spelled: c }
        } else {
          DagStringDecodeUnicode { text: t, digits: digits + 1, value: (value * 16) + d }
        }
      Absent => DagStringDecodeMalformed { spelled: c }
    }
  }
}

fn dag_string_decode_step(state: DagStringDecode, c: Int) -> DagStringDecode {
  match state {
    DagStringDecodeText { text: t } =>
      if c == 92 {
        DagStringDecodeEscape { text: t }
      } else {
        dag_string_decode_append(text: t, code_point: c)
      }
    DagStringDecodeEscape { text: t } => dag_string_decode_escape_step(t: t, c: c)
    DagStringDecodeHex { text: t, digits: n, value: v } => dag_string_decode_hex_step(t: t, digits: n, value: v, c: c)
    DagStringDecodeUnicodeOpen { text: t } =>
      if c == 123 {
        DagStringDecodeUnicode { text: t, digits: 0, value: 0 }
      } else {
        DagStringDecodeMalformed { spelled: c }
      }
    DagStringDecodeUnicode { text: t, digits: n, value: v } => dag_string_decode_unicode_step(t: t, digits: n, value: v, c: c)
    DagStringDecodeMalformed { spelled: m } => DagStringDecodeMalformed { spelled: m }
  }
}

// The lexeme's scalars in order; a lexeme is framed when its first and last scalars are the quote
// and there are at least two of them.
fn dag_string_literal_body_optional(lexeme: String) -> Optional<List<Int>> {
  let cs = unicode_scalar_unfold(s: lexeme)
  let n = length(xs: cs)
  if n < 2 {
    optional_absent()
  } else {
    match list_at_optional(xs: cs, index: 0) {
      Present { value: open } =>
        match list_at_optional(xs: cs, index: n - 1) {
          Present { value: close } =>
            if (open == 34) && (close == 34) {
              optional_present(value: list_init(xs: skip(xs: cs, n: 1)))
            } else {
              optional_absent()
            }
          Absent => optional_absent()
        }
      Absent => optional_absent()
    }
  }
}

fn dag_string_literal_refusal(reason: Symbol, occurrence_id: NodeOccurrenceIdentity) -> Outcome<String> {
  outcome_rejected(
    d: Diagnostic {
      reason: reason,
      at: node_locus(
        node: Node {
          kind: TypeNode { connective: Atom { identity: ^dag_token_string_literal } },
          children: [],
          occurrence_id: occurrence_id
        }
      ),
      correction: Unavailable { reason: CorrectionNotModeled }
    }
  )
}

// An escape left open at the closing quote, or one the decode could not complete, is malformed.
fn dag_string_literal_escape_refusal(occurrence_id: NodeOccurrenceIdentity) -> Outcome<String> {
  dag_string_literal_refusal(reason: ^dag_string_literal_escape_malformed, occurrence_id: occurrence_id)
}

// THE VALUE A STRING LITERAL'S LEXEME SPELLS: the framing quotes removed and each escape replaced
// by the code point the escape vocabulary above names. Refuses, located at `occurrence_id`, when the
// lexeme is not quote-framed (^dag_string_literal_lexeme_unframed) or carries an escape that
// vocabulary calls malformed (^dag_string_literal_escape_malformed). The raw spelling is never
// answered as the value. Every reader of string-literal text decodes here, so the escape
// vocabulary has one reader.
fn dag_string_literal_decoded_text(lexeme: String, occurrence_id: NodeOccurrenceIdentity) -> Outcome<String> {
  match dag_string_literal_body_optional(lexeme: lexeme) {
    Absent => dag_string_literal_refusal(reason: ^dag_string_literal_lexeme_unframed, occurrence_id: occurrence_id)
    Present { value: body } =>
      match fold(body, init: DagStringDecodeText { text: "" }, f: fn(st, c) { dag_string_decode_step(state: st, c: c) }) {
        DagStringDecodeText { text: value } => outcome_accepted(value: value)
        DagStringDecodeEscape { text: _ } => dag_string_literal_escape_refusal(occurrence_id: occurrence_id)
        DagStringDecodeHex { text: _, digits: _, value: _ } => dag_string_literal_escape_refusal(occurrence_id: occurrence_id)
        DagStringDecodeUnicodeOpen { text: _ } => dag_string_literal_escape_refusal(occurrence_id: occurrence_id)
        DagStringDecodeUnicode { text: _, digits: _, value: _ } => dag_string_literal_escape_refusal(occurrence_id: occurrence_id)
        DagStringDecodeMalformed { spelled: _ } => dag_string_literal_escape_refusal(occurrence_id: occurrence_id)
      }
  }
}

// THE ENCODE IS THE DECODE'S INVERSE OVER ONE TABLE. A scalar that some dag_string_escapes row
// decodes to is written as that row's escape; any other control scalar is written in the numeric
// `\u{H..H}` form the decode admits; everything else is written as itself. So decode(encode(v)) is v
// for every value, and no second escape vocabulary exists. Encode(decode(s)) need not be s, and does
// not need to be: the round trip is owed on the parse tree, not on the spelling.
fn dag_string_escape_spelled_optional(value: Int) -> Optional<Int> {
  fold_list(
    xs: dag_string_escapes(),
    empty: optional_absent(),
    cons: fn(found, row) { if row.value == value { optional_present(value: row.spelled) } else { found } }
  )
}

fn dag_string_hex_digit_text(value: Int) -> String {
  fold_list(
    xs: base16_digit_rows,
    empty: "",
    cons: fn(found, row) { if row.value == value { row.lower } else { found } }
  )
}

fn dag_string_hex_text(value: Int) -> String {
  let rest = value / 16
  let digit = dag_string_hex_digit_text(value: value - (rest * 16))
  if rest == 0 {
    digit
  } else {
    concat(dag_string_hex_text(value: rest), digit)
  }
}

fn dag_string_encode_scalar(c: Int) -> String {
  match dag_string_escape_spelled_optional(value: c) {
    Present { value: spelled } => concat("\\", from_code_point(cp: spelled))
    Absent =>
      if (c < 32) || (c == 127) {
        concat("\\u\{", concat(dag_string_hex_text(value: c), "\}"))
      } else {
        from_code_point(cp: c)
      }
  }
}

fn dag_string_literal_encoded(value: String) -> String {
  concat(
    "\"",
    concat(
      fold(unicode_scalar_unfold(s: value), init: "", f: fn(acc, c) { concat(acc, dag_string_encode_scalar(c: c)) }),
      "\""
    )
  )
}

// The string-literal node for a lexeme: its decoded text as the value payload, or the decode's
// located refusal.
fn dag_string_literal_node_from_lexeme(lexeme: String, occurrence_id: NodeOccurrenceIdentity) -> Outcome<Node> {
  match dag_string_literal_decoded_text(lexeme: lexeme, occurrence_id: occurrence_id) {
    Accepted { value: value, diagnostics: _ } =>
      outcome_accepted(value: dag_string_literal_node(value: value, occurrence_id: occurrence_id))
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn dag_string_literal_node(value: String, occurrence_id: NodeOccurrenceIdentity) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^dag_token_string_literal } },
    children: [
      Edge {
        label: Authored { name: ^string_literal_value_field },
        target: Node {
          kind: TypeNode { connective: Atom { identity: symbol_intern_lexeme(lexeme: value) } },
          children: [],
          occurrence_id: OccurrenceSynthetic
        }
      }
    ],
    occurrence_id: occurrence_id
  }
}

// The decoded value a string-literal node carries: its payload atom's interned identity. Absent for
// every other node, including a payload-less string-literal atom.
fn dag_string_literal_value_edge_target_optional(edge: Edge) -> Optional<Node> {
  match edge.label {
    Authored { name: field } =>
      if field == ^string_literal_value_field {
        optional_present(value: edge.target)
      } else {
        optional_absent()
      }
    StructuralLabel { label: _ } => optional_absent()
    Positional => optional_absent()
  }
}

fn dag_string_literal_value_payload_optional(node: Node) -> Optional<Node> {
  if dag_node_is_string_literal_atom(node: node) && (length(xs: node.children) == 1) {
    match list_at_optional(xs: node.children, index: 0) {
      Present { value: edge } => dag_string_literal_value_edge_target_optional(edge: edge)
      Absent => optional_absent()
    }
  } else {
    optional_absent()
  }
}

fn dag_string_literal_value_symbol_optional(node: Node) -> Optional<Symbol> {
  match dag_string_literal_value_payload_optional(node: node) {
    Present { value: payload } => node_atom_identity_optional(node: payload)
    Absent => optional_absent()
  }
}

fn dag_string_literal_value_optional(node: Node) -> Optional<String> {
  match dag_string_literal_value_symbol_optional(node: node) {
    Present { value: v } => optional_present(value: symbol_lexeme(sym: v))
    Absent => optional_absent()
  }
}

fn dag_node_is_string_literal_atom(node: Node) -> Bool {
  match node_atom_identity_optional(node: node) {
    Present { value: id } => id == ^dag_token_string_literal
    Absent => false
  }
}

data dag_float_literal_magnitude_home_dissolve_on: DissolutionCondition = retires_dissolution(
  ref: decl_ref(
    module_path: "v2.extdeps.languages.dag",
    decl_name: "dag_float_literal_node_from_lexeme"
  )
)

fn dag_int_literal_magnitude_edge_target_optional(edge: Edge) -> Optional<Node> {
  match edge {
    Edge { label: Authored { name: field }, target: magnitude } =>
      if field == ^integer_literal_magnitude_field {
        optional_present(value: magnitude)
      } else {
        optional_absent()
      }
    Edge { label: StructuralLabel { label: _ }, target: _ } => optional_absent()
    Edge { label: Positional, target: _ } => optional_absent()
  }
}

fn dag_int_literal_magnitude_node_optional(node: Node) -> Optional<Node> {
  if dag_node_is_int_literal_atom(node: node) {
    fold(node.children, init: optional_absent(), f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent => dag_int_literal_magnitude_edge_target_optional(edge: edge)
      }
    })
  } else {
    optional_absent()
  }
}

fn dag_int_literal_magnitude_int_from_node(node: Node) -> Outcome<Int> {
  if dag_node_is_int_literal_atom(node: node) {
    match dag_int_literal_magnitude_node_optional(node: node) {
      Present { value: magnitude_node } =>
        integer_decimal_magnitude_node_to_int(node: magnitude_node)
      Absent =>
        outcome_rejected(
          d: Diagnostic {
            reason: ^dag_int_literal_lexeme_invalid,
            at: node_locus(node: node),
            correction: Unavailable { reason: CorrectionNotModeled }
          }
        )
    }
  } else {
    outcome_rejected(
      d: Diagnostic {
        reason: ^dag_int_literal_lexeme_invalid,
        at: node_locus(node: node),
        correction: Unavailable { reason: CorrectionNotModeled }
      }
    )
  }
}

type DagCanonicalLiteral
  = DagCanonicalBoolLiteral { value: Bool }
  | DagCanonicalIntLiteral { magnitude: Int }
  | DagCanonicalSymbolLiteral { symbol: Symbol }
  | DagCanonicalStringLiteral { value: Symbol }

fn dag_canonical_literal_shape_diagnostic(node: Node) -> Diagnostic {
  Diagnostic {
    reason: ^dag_literal_shape_invalid,
    at: node_locus(node: node),
    correction: Unavailable { reason: CorrectionNotModeled }
  }
}

// dag_canonical_literal_from_node is the single typed query for inference-facing DAG literal shape.
// It preserves the Bool-vs-Int distinction and the decoded integer magnitude in a coproduct instead
// of publishing sibling is_* predicates over Node storage. Bool literals admit exactly the
// childless true/false atoms. Int literals admit exactly one named, decodable magnitude child.
// Symbol literals admit exactly the caret atom with one named name payload (dag_symbol_literal_node)
// whose terminal carries an identity; the symbol is that identity. String literals admit the
// string-literal atom with its one named decoded-value payload (dag_string_literal_node, #12759); the
// value is that payload's interned identity. A payload-less string-literal atom is malformed.
// Every other shape is a typed refusal.

fn dag_canonical_literal_from_node(node: Node) -> Outcome<DagCanonicalLiteral> {
  match dag_symbol_literal_name_optional(node: node) {
    Present { value: name } =>
      match node_atom_identity_optional(node: name) {
        Present { value: symbol } => outcome_accepted(value: DagCanonicalSymbolLiteral { symbol: symbol })
        Absent => outcome_rejected(dag_canonical_literal_shape_diagnostic(node: node))
      }
    Absent =>
      if node_atom_identity_optional(node: node) == optional_present(value: ^dag_token_string_literal) {
        match dag_string_literal_value_symbol_optional(node: node) {
          Present { value: v } => outcome_accepted(value: DagCanonicalStringLiteral { value: v })
          Absent => outcome_rejected(dag_canonical_literal_shape_diagnostic(node: node))
        }
      } else if dag_node_is_kw_true_atom(node: node) && (length(xs: node.children) == 0) {
        outcome_accepted(value: DagCanonicalBoolLiteral { value: true })
      } else if dag_node_is_kw_false_atom(node: node) && (length(xs: node.children) == 0) {
        outcome_accepted(value: DagCanonicalBoolLiteral { value: false })
      } else if dag_node_is_int_literal_atom(node: node) && (length(xs: node.children) == 1) {
        match dag_int_literal_magnitude_int_from_node(node: node) {
          Accepted { value: magnitude, diagnostics: d } =>
            Accepted {
              value: DagCanonicalIntLiteral { magnitude: magnitude },
              diagnostics: d
            }
          Rejected { diagnostics: _ } =>
            outcome_rejected(dag_canonical_literal_shape_diagnostic(node: node))
        }
      } else {
        outcome_rejected(dag_canonical_literal_shape_diagnostic(node: node))
      }
  }
}

fn dag_type_atom_node(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

// A DECLARED ARROW FOR A FIXTURE, built the way the declared-signature lowering builds one: the
// domain and its declared order come from one mint (v2.std.arrow_signature
// declared_signature), so a fixture
// cannot build a domain and an order that disagree. `domain` is the AUTHORED parameter list, in the
// order the fixture declares it; it is never a canonicalized node, whose label-sorted sequence is not
// a declared order. A fixture that tests a malformed order builds its Arrow by hand, and says so.
fn dag_arrow_with_body_node(
  domain: Node,
  return_type_binding: Symbol,
  body: Node
) -> Node {
  let signature = declared_signature(params: domain.children, source: domain)
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      signature.domain,
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: return_type_binding)
      },
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: return_type_binding)
      },
      signature.order,
      Edge { label: core_edge_label(marker: ArrowBodyEdge), target: body }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn dag_add_operator_node() -> Node {
  dag_type_atom_node(identity: ^dag_token_plus)
}

fn dag_arrow_domain_conj_node() -> Node {
  let children = fold_list(
    xs: dag_add_param_binding_ids(),
    empty: Empty,
    cons: fn(acc, binding_id) {
      list_snoc_item(
        xs: acc,
        item: binder_edge(name: binding_id, type_node: dag_type_atom_node(identity: dag_int_type_binding()))
      )
    }
  )
  Node {
    kind: TypeNode { connective: Conj },
    children: children,
    occurrence_id: OccurrenceSynthetic
  }
}

// AN OPERAND THAT NAMES A PARAMETER IS A LEXICAL REFERENCE, and resolve records its binding by the
// reference's own occurrence (v2.compiler.resolve resolve_lexical_reference), refusing a synthetic
// one as resolve_reason_lexical_reference_unkeyed. So the fixture's two operands carry MINTED
// occurrences, as normalize's output would, at distinct ids by position (left 1, right 2): the
// swapped variant swaps the names, not the ids. Content hash does not read occurrence ids, so every
// hash-keyed reader of these fixtures is unchanged.
fn dag_fixture_operand_reference_node(binding: Symbol, occurrence: Int) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: binding } },
    children: [],
    occurrence_id: OccurrenceMinted { id: OccurrenceId { value: occurrence } }
  }
}

fn dag_binary_body_node(operator: Node, left_binding: Symbol, right_binding: Symbol) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge { label: Positional, target: operator },
      Edge {
        label: Positional,
        target: dag_fixture_operand_reference_node(binding: left_binding, occurrence: 1)
      },
      Edge {
        label: Positional,
        target: dag_fixture_operand_reference_node(binding: right_binding, occurrence: 2)
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn dag_add_arrow_signature_node() -> Node {
  let signature = declared_signature(params: dag_arrow_domain_conj_node().children, source: dag_arrow_domain_conj_node())
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      signature.domain,
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_binding_type_int)
      },
      Edge {
        label: Positional,
        target: dag_type_atom_node(identity: ^dag_binding_type_int)
      },
      signature.order
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn dag_add_binary_body_node() -> Node {
  dag_binary_body_node(
    operator: dag_add_operator_node(),
    left_binding: ^dag_binding_param_x,
    right_binding: ^dag_binding_param_y
  )
}

fn dag_add_binary_body_swapped_operands_node() -> Node {
  dag_binary_body_node(
    operator: dag_add_operator_node(),
    left_binding: ^dag_binding_param_y,
    right_binding: ^dag_binding_param_x
  )
}

fn dag_add_arrow_with_body_node() -> Node {
  dag_arrow_with_body_node(
    domain: dag_arrow_domain_conj_node(),
    return_type_binding: ^dag_binding_type_int,
    body: dag_add_binary_body_node()
  )
}

