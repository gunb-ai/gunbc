fn dag_formal_production_fn_bind() -> FormalProduction {
  grammar_formal_production(
    lhs: ^dag_production_fn_bind,
    rhs: dag_formal_rhs_from_tokens(tokens: dag_bind_concrete_tokens())
  )
}

fn dag_value_expression_projection() -> TargetValueExpressionProjection {
  TargetValueExpressionProjection {
    binding_ref_form: TargetBindingRefShape { ident_token: ^dag_token_ident },
    primitive_apply_form: TargetPrimitiveApplyShape {
      open: ^dag_token_lparen,
      close: ^dag_token_rparen,
      separator: ^dag_token_comma
    },
    callable_apply_form: TargetCallApplyShape {
      callee_ident_token: ^dag_token_ident,
      open: ^dag_token_lparen,
      separator: ^dag_token_comma,
      close: ^dag_token_rparen
    },
    closure_form: TargetClosureShape {
      fn_token: ^dag_token_kw_fn,
      open: ^dag_token_lparen,
      separator: ^dag_token_comma,
      close: ^dag_token_rparen,
      body_open: ^dag_token_lbrace,
      body_close: ^dag_token_rbrace,
      param_ident_token: ^dag_token_ident
    },
    effect_apply_form: TargetEffectApplyShape {
      callees: [],
      open: ^dag_token_lparen,
      close: ^dag_token_rparen,
      separator: ^dag_token_comma
    },
    conditional_form: TargetConditionalShape {
      if_token: ^dag_token_kw_if,
      then_token: ^dag_token_kw_then,
      else_token: ^dag_token_kw_else
    },
    let_form: TargetBindLetShape {
      let_token: ^dag_token_kw_let,
      assign_token: ^dag_token_eq,
      in_token: ^dag_token_kw_in
    },
    loop_form: TargetLoopShape {
      loop_token: ^dag_token_kw_loop
    },
    record_construct_form: TargetRecordConstructShape {
      open: ^dag_token_lbrace,
      close: ^dag_token_rbrace,
      separator: ^dag_token_comma,
      assign: ^dag_token_colon,
      record_literal_names_type: Prepend
    },
    field_access_form: TargetFieldAccessShape {
      dot: ^dag_token_dot
    },
    match_form: TargetMatchShape {
      match_token: ^dag_token_kw_match,
      scrutinee_open: ^dag_token_match_scrutinee_nop,
      scrutinee_close: ^dag_token_match_scrutinee_nop,
      open: ^dag_token_lbrace,
      close: ^dag_token_rbrace,
      fat_arrow: ^dag_token_fat_arrow,
      arm_separator: ^dag_token_comma
    },
    block_evaluation_mode: dag_block_evaluation_mode()
  }
}

fn dag_block_evaluation_mode() -> BlockEvaluationMode {
  ValueProducing
}

fn dag_operator_realizations_catalog_node() -> Node {
  target_operator_realizations_catalog_node(rows: [])
}

fn dag_grammar_relation_row_node(row: DagGrammarRelationRow) -> Node {
  grammar_relation_row_to_node(
    row: derive_grammar_relation_row(production: row.production, emitted: row.emitted),
    tokens: grammar_relation_tokens_node(
      tokens: row.tokens,
      token_to_node: dag_concrete_token_node
    )
  )
}

fn dag_family_serialize_source_node(
  source_literal: Symbol,
  production_binding: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  authority_source_text: String
) -> Node {
  let _authority = authority_source_text
  Node {
    kind: TypeNode { connective: Conj },
    children: list_append(
      left: [
        dag_named_edge(
          name: ^serialize_source_field_source_text,
          target: dag_inhabitant_atom(id: source_literal)
        ),
        dag_named_edge(
          name: ^serialize_source_field_source_grammar,
          target: dag_inhabitant_atom(id: production_binding)
        )
      ],
      right: [
        dag_named_edge(
          name: ^grammar_relation_field_tokens,
          target: grammar_relation_tokens_node(
            tokens: tokens,
            token_to_node: dag_concrete_token_node
          )
        )
      ]
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn dag_bodied_fn_zip_fold_closure_edges(spec: DagBodiedFnFamilySpec) -> List<Edge> {
  [
    dag_named_edge(
      name: spec.inhabitant_field,
      target: spec.emitted_fn
    )
  ]
}

fn dag_bodied_fn_declared_inhabitants_root(spec: DagBodiedFnFamilySpec) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_append(
      left: list_append(
        left: dag_declared_inhabitants_core().children,
        right: dag_zip_fold_closure_edges()
      ),
      right: dag_bodied_fn_zip_fold_closure_edges(spec: spec)
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn dag_bodied_fn_grammar_relation_row_node(spec: DagBodiedFnFamilySpec) -> Node {
  dag_grammar_relation_row_node(row: spec.grammar_row)
}

fn dag_bodied_fn_translation_rules_node(spec: DagBodiedFnFamilySpec) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: spec.relation_rule,
        target: grammar_relation_row_attach_bodied_scaffold(
          row: dag_bodied_fn_grammar_relation_row_node(spec: spec),
          scaffold: spec.scaffold
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn dag_bodied_fn_serialize_source_node(spec: DagBodiedFnFamilySpec) -> Node {
  dag_family_serialize_source_node(
    source_literal: spec.source_literal,
    production_binding: spec.production_binding,
    tokens: spec.grammar_row.tokens,
    authority_source_text: spec.authority_source_text
  )
}

fn dag_bodied_fn_target_model_bundle_node(spec: DagBodiedFnFamilySpec) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      dag_named_edge(
        name: ^target_model_edge_selection_policy,
        target: dag_selection_policy_node()
      ),
      dag_named_edge(
        name: ^target_model_edge_declared_inhabitants,
        target: dag_bodied_fn_declared_inhabitants_root(spec: spec)
      ),
      dag_named_edge(
        name: ^target_model_edge_translation_rules,
        target: dag_bodied_fn_translation_rules_node(spec: spec)
      ),
      dag_named_edge(
        name: ^target_model_edge_serialize_source,
        target: dag_bodied_fn_serialize_source_node(spec: spec)
      ),
      dag_named_edge(
        name: ^target_model_edge_fidelity_quotient,
        target: dag_fidelity_quotient_node()
      ),
      dag_named_edge(
        name: ^target_model_edge_value_expression_projection,
        target: value_expr_projection_bundle_node(
          projection: dag_value_expression_projection()
        )
      ),
      dag_named_edge(
        name: ^target_model_edge_operator_realizations,
        target: dag_operator_realizations_catalog_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn dag_bodied_fn_target_model(
  spec: DagBodiedFnFamilySpec,
  runtime_row: Optional<TargetEmitHostRuntimeRow>
) -> TargetModel {
  match runtime_row {
    Present { value: row } =>
      TargetModel {
        bundle: dag_bodied_fn_target_model_bundle_node(spec: spec),
        lex: dag_lex(),
        binding_spellings: dag_binding_spellings(),
        token_class_emit_transforms: target_model_emit_transforms_empty,
        authority_source_text: spec.authority_source_text,
        runtime_row: row
      }
    Absent =>
      TargetModel {
        bundle: dag_bodied_fn_target_model_bundle_node(spec: spec),
        lex: dag_lex(),
        binding_spellings: dag_binding_spellings(),
        token_class_emit_transforms: target_model_emit_transforms_empty,
        authority_source_text: spec.authority_source_text,
        runtime_row: target_emit_host_runtime_row_unconfigured
      }
  }
}

fn dag_nullary_fn_statement_prefix_tokens(
  fn_name_binding: Symbol,
  return_type_binding: Symbol
) -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^dag_token_kw_fn },
    BoundToken { token_class: ^dag_token_ident, binding: fn_name_binding },
    FixedToken { token_class: ^dag_token_lparen },
    FixedToken { token_class: ^dag_token_rparen },
    FixedToken { token_class: ^dag_token_arrow },
    BoundToken { token_class: ^dag_token_ident, binding: return_type_binding },
    FixedToken { token_class: ^dag_token_lbrace }
  ]
}

fn dag_pick_statement_prefix_tokens() -> List<ConcreteSyntaxToken> {
