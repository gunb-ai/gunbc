fn dag_grammar_pick_condition_terminal() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: ^dag_token_kw_true),
    right: dag_grammar_terminal(token_class: ^dag_token_kw_false)
  )
}

// 🟡 narrow approximation of arm=value_expression. Branch/pick arms ARE value-expressions
// (a literal, a variable, or a computation), so the arm grammar position should be the
// value_expression production. WHY stopgap: no value_expression grammar production exists in
// dag.dag today, so this widens the arm terminal to int_literal|ident — canonical source text
// lexes 1/2 as int_literal, and emit round-trip re-ingests binding-ref idents at the same
// positions (§2 pick target model). dissolve-on: replace with the value_expression production
// when it lands in dag.dag.
fn dag_grammar_pick_arm_literal_terminal() -> GrammarExpr {
  dag_grammar_choice(
    left: dag_grammar_terminal(token_class: ^dag_token_int_literal),
    right: dag_grammar_terminal(token_class: ^dag_token_ident)
  )
}

// 🟡 narrow approximation — companion to dag_grammar_pick_arm_literal_terminal above: the pick-arm
// literal-binding whitelist. It hard-lists the two mvp1 pick-lit bindings (pick_lit_one/_two) that the
// emit round-trip re-ingests as idents at the arm positions. WHY stopgap: same as the terminal — no
// value_expression grammar production exists in dag.dag yet, so accepted arm bindings are enumerated
// rather than derived from that production. dissolve-on: replace with the value_expression production
// when it lands in dag.dag (both the terminal widening and this binding whitelist go away together).
fn dag_grammar_pick_arm_literal_binding(binding: Symbol) -> Bool {
  (binding == ^dag_binding_mvp1_pick_lit_one)
    || (binding == ^dag_binding_mvp1_pick_lit_two)
}

fn dag_grammar_terminal_for_mvp1_pick_token(token: ConcreteSyntaxToken) -> GrammarExpr {
  let cls = concrete_syntax_token_class(token: token)
  if cls == ^dag_token_kw_true {
    dag_grammar_pick_condition_terminal()
  } else {
    match token {
      BoundToken { token_class: c, binding: b } =>
        if (c == ^dag_token_ident) && dag_grammar_pick_arm_literal_binding(binding: b) {
          dag_grammar_pick_arm_literal_terminal()
        } else {
          dag_grammar_terminal_from_concrete_token(token: token)
        }
      _ => dag_grammar_terminal_from_concrete_token(token: token)
    }
  }
}

fn dag_grammar_sequence_from_token_classes_pick() -> GrammarExpr {
  match fold_list(
    xs: dag_mvp1_pick_concrete_tokens(),
    empty: DagGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        DagGramBuild1StateInit =>
          DagGramBuild1StateReady {
            expr: dag_grammar_terminal_for_mvp1_pick_token(token: token)
          }
        DagGramBuild1StateReady { expr: acc } =>
          DagGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: dag_grammar_terminal_for_mvp1_pick_token(token: token)
            }
          }
      }
    }
  ) {
    DagGramBuild1StateInit =>
      dag_grammar_terminal(token_class: ^dag_token_kw_fn)
    DagGramBuild1StateReady { expr: result } => result
  }
}

fn dag_grammar_match_arm_literal_binding(binding: Symbol) -> Bool {
  dag_grammar_pick_arm_literal_binding(binding: binding)
}

fn dag_grammar_terminal_for_mvp1_match_token(token: ConcreteSyntaxToken) -> GrammarExpr {
  let cls = concrete_syntax_token_class(token: token)
  if (cls == ^dag_token_kw_true) || (cls == ^dag_token_kw_false) {
    dag_grammar_pick_condition_terminal()
  } else {
    match token {
      BoundToken { token_class: c, binding: b } =>
        if (c == ^dag_token_ident) && dag_grammar_match_arm_literal_binding(binding: b) {
          dag_grammar_pick_arm_literal_terminal()
        } else {
          dag_grammar_terminal(token_class: cls)
        }
      _ => dag_grammar_terminal(token_class: cls)
    }
  }
}

fn dag_grammar_sequence_from_token_classes_match() -> GrammarExpr {
  match fold_list(
    xs: dag_mvp1_match_concrete_tokens(),
    empty: DagGramBuild1StateInit,
    cons: fn(state, token) {
