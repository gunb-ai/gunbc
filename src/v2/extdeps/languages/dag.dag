}

fn dag_meet_body_node() -> Node {
  dag_complement_match_body(
    scrutinee: dag_complement_param_scrutinee_node(),
    true_body_lit: ^dag_binding_param_b,
    false_body_lit: ^dag_complement_lit_false
  )
}

fn dag_meet_body_swapped_arms_node() -> Node {
  dag_complement_match_body(
