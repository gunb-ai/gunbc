fn dag_type_decl_structural_formal_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^dag_production_qualified_name,
      rhs: [
        grammar_formal_terminal_free(identity: ^dag_token_ident)
      ]
    ),
    grammar_formal_production(lhs: ^dag_production_qualified_name_repeat_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^dag_production_type_expr,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^dag_production_qualified_name)
      ]
    ),
    grammar_formal_production(
      lhs: ^dag_production_comma_field_decl_list,
      rhs: [
        grammar_formal_terminal_free(identity: ^dag_token_ident),
        grammar_formal_terminal(identity: ^dag_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^dag_production_type_expr),
        grammar_formal_terminal(identity: ^dag_token_comma),
        grammar_formal_terminal_free(identity: ^dag_token_ident),
        grammar_formal_terminal(identity: ^dag_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^dag_production_type_expr),
        grammar_formal_nonterminal_occurrence(identity: ^dag_production_comma_field_decl_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^dag_production_comma_field_decl_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^dag_production_field_decl_block,
      rhs: [
        grammar_formal_terminal(identity: ^dag_token_lbrace),
        grammar_formal_nonterminal_occurrence(identity: ^dag_production_comma_field_decl_list),
        grammar_formal_terminal(identity: ^dag_token_rbrace)
      ]
    ),
    grammar_formal_production(
      lhs: ^dag_production_type_decl,
      rhs: [
        grammar_formal_terminal(identity: ^dag_token_kw_type),
        grammar_formal_terminal_free(identity: ^dag_token_ident),
        grammar_formal_nonterminal_occurrence(identity: ^dag_production_field_decl_block)
      ]
    )
  ]
}

