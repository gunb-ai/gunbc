module v2.extdeps.languages.machine_code

import v2.std.grammar {
  StampClass,
  StampBinding, FormalProduction, ParseGrammar, GrammarExpr, GrammarProduction, GrammarRoot, GrammarSchema, GrammarSchemaProbe, GrammarSchemaProbeBinding, ModeledGrammar, grammar_atom, grammar_empty_sync_tokens, grammar_formal_nonterminal, grammar_formal_terminal }
import v2.std.compilers.lexing {
  CharClassPattern,
  LexPattern,
  LexRule,
  LexRuleSet,
  LexRules,
  LiteralPattern,
  ModeledLexRules,
  OneOrMorePattern,
  TokenRule,
  TriviaRule,
  WhitespaceChar
}
import std.algebra { Empty }
import v2.std.algebra { list_map }
import v2.std.collection { Absent, List, Map, Present }
import v2.std.machine { Byte }
import v2.std.text { String }
import v2.std.model_core {
  EffectSemanticsDecl,
  ModelCore,
  PartialitySemanticsDecl,
  PrimitiveFactBundle,
  ModelCoreFactAxisEncoding,
  ModelCoreFactAxisOverflowDisposition,
  ModelCoreFactAxisSignedness,
  ModelCoreFactAxisSurfaceSpelling,
  primitive_fact_axis_unbound_diagnostic,
  ModelCoreFactAxisWidth
}
import v2.std.node { Atom, Conj, Edge, Named, Node, Symbol, TypeNode, SyntheticOccurrence }

type Isa
  = X86_64Isa { revision: Symbol }
  | Aarch64Isa { revision: Symbol }
  | RiscV64Isa { revision: Symbol }

type ByteOrder
  = LittleEndian
  | BigEndian

type InstructionLength
  = FixedLength { width: InstructionWord }
  | VariableLength { max_bytes: InstructionByteLimitRef }

type InstructionByteLimitRef {
  isa: Isa,
  limit: Symbol
}

type OperandFieldWidthRef {
  isa: Isa,
  width: Symbol
}

type MachineIntKind
  = Signed
  | Unsigned

type MachineIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Bits128

type MachineScalar
  = IntScalar { kind: MachineIntKind, width: MachineIntWidth }

type MachineDisplacement32WidthClass
  = DisplacementEncodingBits32 {}

type MachineDisplacement64WidthClass
  = DisplacementEncodingBits64 {}

type MachineSignedDisplacement32 {
  width: MachineDisplacement32WidthClass
}

type MachineSignedDisplacement64 {
  width: MachineDisplacement64WidthClass
}

type InstructionWord
  = Instr16
  | Instr32
  | Instr64
  | Instr128

type RegisterClass
  = GeneralPurposeRegister
  | FloatingPointRegister
  | VectorRegister
  | PredicateRegister
  | FlagsRegister
  | ControlRegister

type RegisterDeclaration {
  isa: Isa
  name: Symbol
  class: RegisterClass
}

type RegisterRef {
  declaration: RegisterDeclaration
}

type IndexScale
  = Scale1
  | Scale2
  | Scale4
  | Scale8

type AddressingMode
  = AbsoluteAddress { displacement: MachineSignedDisplacement64 }
  | RegisterIndirect { base: RegisterRef }
  | BaseDisplacement { base: RegisterRef, displacement: MachineSignedDisplacement32 }
  | BaseIndexScale {
      base: RegisterRef,
      index: RegisterRef,
      scale: IndexScale,
      displacement: MachineSignedDisplacement32
    }
  | PcRelative { displacement: MachineSignedDisplacement32 }

type Operand
  = RegisterOperand { register: RegisterRef }
  | ImmediateOperand { bytes: ByteSequence, order: ByteOrder }
  | MemoryOperand { mode: AddressingMode }

type ByteSequence {
  bytes: List<Byte>
}

type InstructionProductionRef {
  isa: Isa
  opcode: Symbol
}

type RegisterOperandSlotRef {
  slot: Symbol
}

type ImmediateOperandSlotRef {
  slot: Symbol
}

type MemoryOperandSlotRef {
  slot: Symbol
}

type ImmediateOperandTarget
  = LiteralImmediate
  | PcRelativeImmediate
  | AbsoluteAddressImmediate

type ImmediateOperandConstraint {
  width: OperandFieldWidthRef
  order: ByteOrder
  target: ImmediateOperandTarget
}

type MemoryOperandConstraint
  = AbsoluteAddressSlot { displacement_width: OperandFieldWidthRef }
  | RegisterIndirectSlot { allowed_bases: List<RegisterRef> }
  | BaseDisplacementSlot {
      allowed_bases: List<RegisterRef>,
      displacement_width: OperandFieldWidthRef
    }
  | BaseIndexScaleSlot {
      allowed_bases: List<RegisterRef>,
      allowed_indexes: List<RegisterRef>,
      scale: IndexScale,
      displacement_width: OperandFieldWidthRef
    }
  | PcRelativeSlot { displacement_width: OperandFieldWidthRef }

type InstructionOperandSlot
  = RegisterInstructionSlot {
      name: RegisterOperandSlotRef,
      allowed_registers: List<RegisterRef>
    }
  | ImmediateInstructionSlot {
      name: ImmediateOperandSlotRef,
      constraint: ImmediateOperandConstraint
    }
  | MemoryInstructionSlot {
      name: MemoryOperandSlotRef,
      constraint: MemoryOperandConstraint
    }

type InstructionProduction {
  reference: InstructionProductionRef
  slots: List<InstructionOperandSlot>
}

type OperandBinding
  = RegisterOperandBinding {
      slot: RegisterOperandSlotRef,
      register: RegisterRef
    }
  | ImmediateOperandBinding {
      slot: ImmediateOperandSlotRef,
      bytes: ByteSequence
    }
  | MemoryOperandBinding {
      slot: MemoryOperandSlotRef,
      mode: AddressingMode
    }

type DecodedInstruction {
  production: InstructionProductionRef
  operands: List<OperandBinding>
}

type MachineFidelityFeature
  = ValidInstructionEncoding
  | InstructionAliasSpelling
  | PaddingByteRun
  | UndecodableByteRun
  | PrivilegedOrUndefinedEncoding
  | IsaRevisionMismatch
  | AmbiguousDecode

type MachineIntegerOverflowBehavior
  = WrapModuloWidth
  | TrapOnOverflow
  | UndefinedByIsa

type MachineIntegerOperationSemantics<IRCarrier> {
  overflow: MachineIntegerOverflowBehavior
  writes_flags: FlagWriteDisposition
}

type FlagWriteDisposition
  = DoesNotWriteFlags
  | WritesArchitecturalFlags
  | WritesPredicateRegister

type MachineIntegerPrimitiveFacts {
  surface_spelling: Symbol
  kind: MachineIntKind
  width: MachineIntWidth
  overflow_release: MachineIntegerOverflowBehavior
  std_projection: Symbol
}
data mc_facts_int8: MachineIntegerPrimitiveFacts = MachineIntegerPrimitiveFacts {
  surface_spelling: ^mc_surface_spelling_int8,
  kind: Signed,
  width: Bits8,
  overflow_release: WrapModuloWidth,
  std_projection: ^mc_std_projection_int8,
}

data mc_facts_uint8: MachineIntegerPrimitiveFacts = MachineIntegerPrimitiveFacts {
  surface_spelling: ^mc_surface_spelling_uint8,
  kind: Unsigned,
  width: Bits8,
  overflow_release: WrapModuloWidth,
  std_projection: ^mc_std_projection_uint8,
}

data mc_facts_int32: MachineIntegerPrimitiveFacts = MachineIntegerPrimitiveFacts {
  surface_spelling: ^mc_surface_spelling_int32,
  kind: Signed,
  width: Bits32,
  overflow_release: WrapModuloWidth,
  std_projection: ^mc_std_projection_int32,
}

data mc_facts_uint32: MachineIntegerPrimitiveFacts = MachineIntegerPrimitiveFacts {
  surface_spelling: ^mc_surface_spelling_uint32,
  kind: Unsigned,
  width: Bits32,
  overflow_release: WrapModuloWidth,
  std_projection: ^mc_std_projection_uint32,
}

data mc_facts_int64: MachineIntegerPrimitiveFacts = MachineIntegerPrimitiveFacts {
  surface_spelling: ^mc_surface_spelling_int64,
  kind: Signed,
  width: Bits64,
  overflow_release: WrapModuloWidth,
  std_projection: ^mc_std_projection_int64,
}

data mc_facts_uint64: MachineIntegerPrimitiveFacts = MachineIntegerPrimitiveFacts {
  surface_spelling: ^mc_surface_spelling_uint64,
  kind: Unsigned,
  width: Bits64,
  overflow_release: WrapModuloWidth,
  std_projection: ^mc_std_projection_uint64,
}

data mc_integer_facts_catalog: List<MachineIntegerPrimitiveFacts> = [
  mc_facts_int8,
  mc_facts_uint8,
  mc_facts_int32,
  mc_facts_uint32,
  mc_facts_int64,
  mc_facts_uint64,
]

fn mc_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn mc_int_kind_node(kind: MachineIntKind) -> Node {
  match kind {
    Signed => mc_inhabitant_atom(id: ^mc_tag_signed)
    Unsigned => mc_inhabitant_atom(id: ^mc_tag_unsigned)
  }
}

fn mc_int_width_node(width: MachineIntWidth) -> Node {
  match width {
    Bits8 => mc_inhabitant_atom(id: ^mc_tag_bits8)
    Bits16 => mc_inhabitant_atom(id: ^mc_tag_bits16)
    Bits32 => mc_inhabitant_atom(id: ^mc_tag_bits32)
    Bits64 => mc_inhabitant_atom(id: ^mc_tag_bits64)
    Bits128 => mc_inhabitant_atom(id: ^mc_tag_bits128)
  }
}

fn mc_overflow_node(overflow: MachineIntegerOverflowBehavior) -> Node {
  match overflow {
    WrapModuloWidth => mc_inhabitant_atom(id: ^mc_tag_wrap_modulo)
    TrapOnOverflow => mc_inhabitant_atom(id: ^mc_tag_trap_on_overflow)
    UndefinedByIsa => mc_inhabitant_atom(id: ^mc_tag_undefined_by_isa)
  }
}

fn mc_integer_facts_node(facts: MachineIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) },
        target: mc_inhabitant_atom(id: facts.surface_spelling)
      },
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisSignedness {}) },
        target: mc_int_kind_node(kind: facts.kind)
      },
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisWidth {}) },
        target: mc_int_width_node(width: facts.width)
      },
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisOverflowDisposition {}) },
        target: mc_overflow_node(overflow: facts.overflow_release)
      },
      Edge {
        label: Named { name: discriminant(v: ModelCoreFactAxisEncoding {}) },
        target: mc_inhabitant_atom(id: ^mc_repr_twos_complement)
      },
      Edge {
        label: Named { name: ^mc_facts_field_std_projection },
        target: mc_inhabitant_atom(id: facts.std_projection)
      }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn mc_integer_spec_facts(facts: MachineIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          v2.std.optional.Present { value: mc_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisWidth {}) {
          v2.std.optional.Present { value: mc_int_width_node(width: facts.width) }
      } else if axis == discriminant(v: ModelCoreFactAxisSignedness {}) {
          v2.std.optional.Present { value: mc_int_kind_node(kind: facts.kind) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          v2.std.optional.Present { value: mc_inhabitant_atom(id: ^mc_repr_twos_complement) }
      } else if axis == discriminant(v: ModelCoreFactAxisOverflowDisposition {}) {
          v2.std.optional.Present { value: mc_overflow_node(overflow: facts.overflow_release) }
      } else {
          v2.std.optional.Absent
      }
    }
  }
}

fn mc_primitive_bundle_from_integer_facts(facts: MachineIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: mc_integer_facts_node(facts: facts),
    spec_facts: mc_integer_spec_facts(facts: facts)
  }
}

fn mc_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  list_map(xs: mc_integer_facts_catalog, f: fn(facts) {
    mc_primitive_bundle_from_integer_facts(facts: facts)
  })
}

fn machine_code_model_core() -> ModelCore {
  ModelCore {
    primitives: mc_primitive_bundles_from_integer_catalog(),
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}
fn machine_code_lex_token(token_class: Symbol, pattern: LexPattern) -> LexRule {
  TokenRule { token_class: token_class, pattern: pattern }
}

fn machine_code_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn machine_code_lex(token_class: Symbol, spelling: String) -> LexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: [
        TriviaRule { pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } } },
        machine_code_lex_token(token_class: token_class, pattern: LiteralPattern { text: spelling })
      ]
    }
  }
}

fn machine_code_grammar(
  production_name: Symbol,
  token_class: Symbol,
  emitted_identity: Symbol
) -> ParseGrammar {
  let start = GrammarProduction {
    name: production_name,
    expression: machine_code_grammar_terminal(token_class: token_class),
    emitted: grammar_atom(identity: emitted_identity)
  }
  ModeledGrammar {
    root: GrammarRoot {
      start: production_name,
      productions: [start],
      sync_tokens: grammar_empty_sync_tokens()
    }
  }
}

fn machine_code_formal_production(production_name: Symbol, token_class: Symbol) -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: production_name),
    rhs: [grammar_formal_terminal(identity: token_class)]
  }
}

fn machine_code_x86_64_lex() -> LexRules {
  machine_code_lex(token_class: ^machine_code_token_x86_64_nop, spelling: "nop")
}

fn machine_code_x86_64_grammar() -> ParseGrammar {
  machine_code_grammar(
    production_name: ^machine_code_production_x86_64_nop,
    token_class: ^machine_code_token_x86_64_nop,
    emitted_identity: ^machine_code_surface_x86_64_nop_instruction
  )
}

fn machine_code_x86_64_ingest_grammar_schema() -> GrammarSchema {
  GrammarSchema {
    lex: machine_code_x86_64_lex(),
    grammar: machine_code_x86_64_grammar()
  }
}

fn machine_code_x86_64_ingest_grammar_probe() -> GrammarSchemaProbeBinding {
  GrammarSchemaProbeBinding {
    schema: machine_code_x86_64_ingest_grammar_schema(),
    probe: GrammarSchemaProbe {
      fixture: "nop",
      production: machine_code_formal_production(
        production_name: ^machine_code_production_x86_64_nop,
        token_class: ^machine_code_token_x86_64_nop
      ),
      expected_parse_surface: grammar_atom(identity: ^machine_code_surface_x86_64_nop_instruction)
    }
  }
}

