    schema: machine_code_riscv64_ingest_grammar_schema(),
    probe: GrammarSchemaProbe {
      fixture: "nop",
      production: machine_code_formal_production(
        production_name: ^machine_code_production_riscv64_nop,
        token_class: ^machine_code_token_riscv64_nop
      ),
      expected_parse_surface: grammar_atom(identity: ^machine_code_surface_riscv64_nop_instruction)
    }
  }
}
