module v2.extdeps.languages.bash_build


fn bash_build_word_kinded(kind: v2.std.node.Symbol, value: String) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: kind } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      },
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: value } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_word_lit(text: String) -> v2.std.node.Node {
  bash_build_word_kinded(kind: ^bash_fold_word_kind_lit, value: text)
}

fn bash_build_word_var(name: String) -> v2.std.node.Node {
  bash_build_word_kinded(kind: ^bash_fold_word_kind_var, value: name)
}

fn bash_build_word_compound(kind: v2.std.node.Symbol, payload: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: kind } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: payload }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_word_concat(parts: v2.std.node.Node) -> v2.std.node.Node {
  bash_build_word_compound(kind: ^bash_fold_word_kind_concat, payload: parts)
}

fn bash_build_word_cmdsubst(body: v2.std.node.Node) -> v2.std.node.Node {
  bash_build_word_compound(kind: ^bash_fold_word_kind_cmdsubst, payload: body)
}

fn bash_build_stmt_tag(binding: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: binding } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_command_words_single(word: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: word }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_command_words_pair(left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: left },
      v2.std.node.Edge { label: v2.std.node.Positional, target: right }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_command(words: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: bash_build_stmt_tag(binding: ^bash_production_fold_command)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: words }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_command_words_from_lits_suffix(
  lits: List<String>,
  accumulated: v2.std.node.Node,
  index: Int
) -> v2.std.node.Node {
  match v2.std.collection.list_at_optional(xs: lits, index: index) {
    v2.std.collection.Present { value: lit } =>
      bash_build_command_words_from_lits_suffix(
        lits: lits,
        accumulated: bash_build_command_words_pair(
          left: accumulated,
          right: bash_build_word_lit(text: lit)
        ),
        index: index + 1
      )
    Absent => accumulated
  }
}

fn bash_build_command_from_lits(lits: List<String>) -> v2.std.node.Node {
  match v2.std.algebra.list_head(xs: lits) {
    v2.std.algebra.HeadFound { value: first } =>
      bash_build_command(
        words: bash_build_command_words_from_lits_suffix(
          lits: lits,
          accumulated: bash_build_command_words_single(word: bash_build_word_lit(text: first)),
          index: 1
        )
      )
    v2.std.algebra.HeadAbsent =>
      bash_build_command(
        words: bash_build_command_words_single(word: bash_build_word_lit(text: ""))
      )
  }
}

fn bash_build_command_lit_var(lit: String, var_name: String) -> v2.std.node.Node {
  bash_build_command(
    words: bash_build_command_words_pair(
      left: bash_build_command_words_single(word: bash_build_word_lit(text: lit)),
      right: bash_build_word_var(name: var_name)
    )
  )
}

fn bash_build_exit(code: String) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: bash_build_stmt_tag(binding: ^bash_production_fold_exit)
      },
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: code } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_assign(name: String, value: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: bash_build_stmt_tag(binding: ^bash_production_fold_assign)
      },
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: name } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: value }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_assign_lit(name: String, text: String) -> v2.std.node.Node {
  bash_build_assign(name: name, value: bash_build_word_lit(text: text))
}

fn bash_build_assign_var(name: String, var_name: String) -> v2.std.node.Node {
  bash_build_assign(name: name, value: bash_build_word_var(name: var_name))
}

fn bash_build_binary_stmt(binding: v2.std.node.Symbol, left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: bash_build_stmt_tag(binding: binding) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: left },
      v2.std.node.Edge { label: v2.std.node.Positional, target: right }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_and_then(left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.node.Node {
  bash_build_binary_stmt(
    binding: ^bash_production_fold_and_then,
    left: left,
    right: right
  )
}

fn bash_build_or_else(left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.node.Node {
  bash_build_binary_stmt(
    binding: ^bash_production_fold_or_else,
    left: left,
    right: right
  )
}

fn bash_build_pipe(left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.node.Node {
  bash_build_binary_stmt(
    binding: ^bash_production_fold_pipe,
    left: left,
    right: right
  )
}

fn bash_build_stmt_list_single(stmt: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: stmt }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_stmt_list_pair(left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: left },
      v2.std.node.Edge { label: v2.std.node.Positional, target: right }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_subshell(body: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: bash_build_stmt_tag(binding: ^bash_production_fold_subshell)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: body }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_if(cond: v2.std.node.Node, body: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: bash_build_stmt_tag(binding: ^bash_production_fold_if)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: cond },
      v2.std.node.Edge { label: v2.std.node.Positional, target: body }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_with_redir(inner: v2.std.node.Node, redir: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: bash_build_stmt_tag(binding: ^bash_production_fold_with_redir)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: inner },
      v2.std.node.Edge { label: v2.std.node.Positional, target: bash_build_stmt_tag(binding: redir) }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_with_redir_to_file(inner: v2.std.node.Node, path: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: bash_build_stmt_tag(binding: ^bash_production_fold_with_redir)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: inner },
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: bash_build_stmt_tag(binding: ^bash_production_fold_redir_to_file)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: path }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_negation(inner: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: bash_build_stmt_tag(binding: ^bash_build_stmt_negation)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: inner }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn bash_build_word_list_from_nodes_suffix(
  words: List<v2.std.node.Node>,
  accumulated: v2.std.node.Node,
  index: Int
) -> v2.std.node.Node {
  match v2.std.collection.list_at_optional(xs: words, index: index) {
    v2.std.collection.Present { value: word } =>
      bash_build_word_list_from_nodes_suffix(
        words: words,
        accumulated: bash_build_command_words_pair(left: accumulated, right: word),
        index: index + 1
      )
    Absent => accumulated
  }
}

fn bash_build_word_list_from_nodes(words: List<v2.std.node.Node>) -> v2.std.node.Node {
  match v2.std.algebra.list_head(xs: words) {
    v2.std.algebra.HeadFound { value: first } =>
      bash_build_word_list_from_nodes_suffix(
        words: words,
        accumulated: bash_build_command_words_single(word: first),
        index: 1
      )
    v2.std.algebra.HeadAbsent =>
      bash_build_command_words_single(
        word: bash_build_word_kinded(kind: ^bash_build_refused_empty_word_list, value: "")
      )
  }
}

fn bash_build_word_concat_parts(parts: List<v2.std.node.Node>) -> v2.std.node.Node {
  bash_build_word_concat(parts: bash_build_word_list_from_nodes(words: parts))
}

fn bash_build_command_words_from_nodes(words: List<v2.std.node.Node>) -> v2.std.node.Node {
  bash_build_word_list_from_nodes(words: words)
}

fn bash_build_command_with_words(words: List<v2.std.node.Node>) -> v2.std.node.Node {
  bash_build_command(words: bash_build_command_words_from_nodes(words: words))
}

fn bash_build_test_bracket(words: List<v2.std.node.Node>) -> v2.std.node.Node {
  bash_build_command_with_words(
    words: concat(
      [bash_build_word_lit(text: "[")],
      concat(words, [bash_build_word_lit(text: "]")])
    )
  )
}

fn bash_build_stmt_list_from_nodes_suffix(
  stmts: List<v2.std.node.Node>,
  accumulated: v2.std.node.Node,
  index: Int
) -> v2.std.node.Node {
  match v2.std.collection.list_at_optional(xs: stmts, index: index) {
    v2.std.collection.Present { value: stmt } =>
      bash_build_stmt_list_from_nodes_suffix(
        stmts: stmts,
        accumulated: bash_build_stmt_list_pair(left: accumulated, right: stmt),
        index: index + 1
      )
    Absent => accumulated
  }
}

fn bash_build_stmt_list_from_nodes(stmts: List<v2.std.node.Node>) -> v2.std.node.Node {
  match v2.std.algebra.list_head(xs: stmts) {
    v2.std.algebra.HeadFound { value: first } =>
      bash_build_stmt_list_from_nodes_suffix(
        stmts: stmts,
        accumulated: bash_build_stmt_list_single(stmt: first),
        index: 1
      )
    v2.std.algebra.HeadAbsent =>
      v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Positional,
            target: bash_build_stmt_tag(binding: ^bash_build_refused_empty_stmt_list)
          }
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
      }
  }
}

fn bash_build_command_from_word_nodes(words: List<v2.std.node.Node>) -> v2.std.node.Node {
  bash_build_command_with_words(words: words)
}

fn bash_build_if_from_stmts(cond: v2.std.node.Node, then_stmts: List<v2.std.node.Node>) -> v2.std.node.Node {
  bash_build_if(
    cond: cond,
    body: bash_build_stmt_list_from_nodes(stmts: then_stmts)
  )
}

fn bash_build_subshell_from_stmts(stmts: List<v2.std.node.Node>) -> v2.std.node.Node {
  bash_build_subshell(body: bash_build_stmt_list_from_nodes(stmts: stmts))
}

fn bash_build_word_concat_from_nodes(parts: List<v2.std.node.Node>) -> v2.std.node.Node {
  bash_build_word_concat_parts(parts: parts)
}
