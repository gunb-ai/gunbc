fn java_grammar_primitive_type_expr() -> GrammarExpr {
  java_grammar_choice(
    left: java_grammar_terminal(token_class: ^java_token_kw_byte),
    right: java_grammar_choice(
      left: java_grammar_terminal(token_class: ^java_token_kw_short),
      right: java_grammar_choice(
        left: java_grammar_terminal(token_class: ^java_token_kw_int),
        right: java_grammar_choice(
          left: java_grammar_terminal(token_class: ^java_token_kw_long),
          right: java_grammar_choice(
            left: java_grammar_terminal(token_class: ^java_token_kw_float),
            right: java_grammar_choice(
              left: java_grammar_terminal(token_class: ^java_token_kw_double),
              right: java_grammar_choice(
                left: java_grammar_terminal(token_class: ^java_token_kw_boolean),
                right: java_grammar_terminal(token_class: ^java_token_kw_char)
              )
            )
          )
        )
      )
    )
  )
}

fn java_grammar_result_expr() -> GrammarExpr {
  java_grammar_choice(
    left: java_grammar_nonterminal(production: ^java_production_primitive_type),
    right: java_grammar_terminal(token_class: ^java_token_kw_void)
  )
}

fn java_grammar_formal_parameter_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_nonterminal(production: ^java_production_type),
    right: java_grammar_terminal(token_class: ^java_token_ident)
  )
}

fn java_grammar_formal_parameter_list_expr() -> GrammarExpr {
  java_grammar_comma_list_expr(item: java_grammar_formal_parameter_expr())
}

fn java_grammar_method_declarator_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_terminal(token_class: ^java_token_ident),
    right: java_grammar_sequence(
      left: java_grammar_terminal(token_class: ^java_token_lparen),
      right: java_grammar_sequence(
        left: java_grammar_optional(
          element: java_grammar_nonterminal(production: ^java_production_formal_parameter_list)
        ),
        right: java_grammar_terminal(token_class: ^java_token_rparen)
      )
    )
  )
}

fn java_grammar_primary_expression_expr() -> GrammarExpr {
  java_grammar_terminal(token_class: ^java_token_ident)
}

fn java_grammar_multiplicative_expression_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_nonterminal(production: ^java_production_primary_expression),
    right: java_grammar_repeat(
      element: java_grammar_sequence(
        left: java_grammar_terminal(token_class: ^java_token_star),
        right: java_grammar_nonterminal(production: ^java_production_primary_expression)
      )
    )
  )
}

fn java_grammar_additive_expression_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_nonterminal(production: ^java_production_multiplicative_expression),
    right: java_grammar_repeat(
      element: java_grammar_sequence(
        left: java_grammar_choice(
          left: java_grammar_terminal(token_class: ^java_token_plus),
          right: java_grammar_terminal(token_class: ^java_token_minus)
        ),
        right: java_grammar_nonterminal(production: ^java_production_multiplicative_expression)
      )
    )
  )
}

fn java_grammar_expression_expr() -> GrammarExpr {
  java_grammar_nonterminal(production: ^java_production_additive_expression)
}

fn java_grammar_return_statement_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_terminal(token_class: ^java_token_kw_return),
    right: java_grammar_sequence(
      left: java_grammar_optional(
        element: java_grammar_nonterminal(production: ^java_production_expression)
      ),
      right: java_grammar_terminal(token_class: ^java_token_semicolon)
    )
  )
}

fn java_grammar_local_variable_declaration_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_nonterminal(production: ^java_production_type),
    right: java_grammar_terminal(token_class: ^java_token_ident)
  )
}

fn java_grammar_local_variable_declaration_statement_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_nonterminal(production: ^java_production_local_variable_declaration),
    right: java_grammar_terminal(token_class: ^java_token_semicolon)
  )
}

fn java_grammar_statement_expr() -> GrammarExpr {
  java_grammar_nonterminal(production: ^java_production_return_statement)
}

fn java_grammar_block_statement_expr() -> GrammarExpr {
  java_grammar_choice(
    left: java_grammar_nonterminal(production: ^java_production_local_variable_declaration_statement),
    right: java_grammar_nonterminal(production: ^java_production_statement)
  )
}

fn java_grammar_block_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_terminal(token_class: ^java_token_lbrace),
    right: java_grammar_sequence(
      left: java_grammar_repeat(element: java_grammar_nonterminal(production: ^java_production_block_statement)),
      right: java_grammar_terminal(token_class: ^java_token_rbrace)
    )
  )
}

fn java_grammar_method_header_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_terminal(token_class: ^java_token_kw_static),
    right: java_grammar_sequence(
      left: java_grammar_nonterminal(production: ^java_production_result),
      right: java_grammar_nonterminal(production: ^java_production_method_declarator)
    )
  )
}

fn java_grammar_method_body_expr() -> GrammarExpr {
  java_grammar_nonterminal(production: ^java_production_block)
}

fn java_grammar_method_declaration_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_nonterminal(production: ^java_production_method_header),
    right: java_grammar_nonterminal(production: ^java_production_method_body)
  )
}

fn java_grammar_field_declaration_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_terminal(token_class: ^java_token_kw_static),
    right: java_grammar_sequence(
      left: java_grammar_nonterminal(production: ^java_production_type),
      right: java_grammar_sequence(
        left: java_grammar_terminal(token_class: ^java_token_ident),
        right: java_grammar_terminal(token_class: ^java_token_semicolon)
      )
    )
  )
}

fn java_grammar_class_member_declaration_expr() -> GrammarExpr {
  java_grammar_choice(
    left: java_grammar_nonterminal(production: ^java_production_method_declaration),
    right: java_grammar_nonterminal(production: ^java_production_field_declaration)
  )
}

fn java_grammar_class_body_declaration_expr() -> GrammarExpr {
  java_grammar_nonterminal(production: ^java_production_class_member_declaration)
}

fn java_grammar_class_body_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_terminal(token_class: ^java_token_lbrace),
    right: java_grammar_sequence(
      left: java_grammar_repeat(element: java_grammar_nonterminal(production: ^java_production_class_body_declaration)),
      right: java_grammar_terminal(token_class: ^java_token_rbrace)
    )
  )
}

fn java_grammar_class_declaration_expr() -> GrammarExpr {
  java_grammar_sequence(
    left: java_grammar_terminal(token_class: ^java_token_kw_public),
    right: java_grammar_sequence(
      left: java_grammar_terminal(token_class: ^java_token_kw_class),
      right: java_grammar_sequence(
        left: java_grammar_terminal(token_class: ^java_token_ident),
        right: java_grammar_nonterminal(production: ^java_production_class_body)
      )
    )
  )
}

fn java_grammar_compilation_unit_expr() -> GrammarExpr {
  java_grammar_nonterminal(production: ^java_production_class_declaration)
}

fn java_grammar_type_expr() -> GrammarExpr {
  java_grammar_nonterminal(production: ^java_production_primitive_type)
}

fn java_grammar_root() -> GrammarRoot {
  let compilation_unit = java_grammar_production(
    name: ^java_production_compilation_unit,
    expression: java_grammar_compilation_unit_expr(),
    emitted: ^java_surface_compilation_unit
  )
  let class_declaration = java_grammar_production(
    name: ^java_production_class_declaration,
    expression: java_grammar_class_declaration_expr(),
    emitted: ^java_surface_class_declaration
  )
  let class_member_declaration = java_grammar_production(
    name: ^java_production_class_member_declaration,
    expression: java_grammar_class_member_declaration_expr(),
    emitted: ^java_surface_class_member_declaration
  )
  let class_body_declaration = java_grammar_production(
    name: ^java_production_class_body_declaration,
    expression: java_grammar_class_body_declaration_expr(),
    emitted: ^java_surface_class_body_declaration
  )
  let class_body = java_grammar_production(
    name: ^java_production_class_body,
    expression: java_grammar_class_body_expr(),
    emitted: ^java_surface_class_body
  )
  let method_header = java_grammar_production(
    name: ^java_production_method_header,
    expression: java_grammar_method_header_expr(),
    emitted: ^java_surface_method_header
  )
  let method_body = java_grammar_production(
    name: ^java_production_method_body,
    expression: java_grammar_method_body_expr(),
    emitted: ^java_surface_method_body
  )
  let method_declaration = java_grammar_production(
    name: ^java_production_method_declaration,
    expression: java_grammar_method_declaration_expr(),
    emitted: ^java_surface_method_declaration
  )
  let field_declaration = java_grammar_production(
    name: ^java_production_field_declaration,
    expression: java_grammar_field_declaration_expr(),
    emitted: ^java_surface_field_declaration
  )
  let primitive_type = java_grammar_production(
    name: ^java_production_primitive_type,
    expression: java_grammar_primitive_type_expr(),
    emitted: ^java_surface_primitive_type
  )
  let result = java_grammar_production(
    name: ^java_production_result,
    expression: java_grammar_result_expr(),
    emitted: ^java_surface_result
  )
  let type = java_grammar_production(
    name: ^java_production_type,
    expression: java_grammar_type_expr(),
    emitted: ^java_surface_type
  )
  let formal_parameter_list = java_grammar_production(
    name: ^java_production_formal_parameter_list,
    expression: java_grammar_formal_parameter_list_expr(),
    emitted: ^java_surface_formal_parameter_list
  )
  let method_declarator = java_grammar_production(
    name: ^java_production_method_declarator,
    expression: java_grammar_method_declarator_expr(),
    emitted: ^java_surface_method_declarator
  )
  let block = java_grammar_production(
    name: ^java_production_block,
    expression: java_grammar_block_expr(),
    emitted: ^java_surface_block
  )
  let block_statement = java_grammar_production(
    name: ^java_production_block_statement,
    expression: java_grammar_block_statement_expr(),
    emitted: ^java_surface_block_statement
  )
  let statement = java_grammar_production(
    name: ^java_production_statement,
    expression: java_grammar_statement_expr(),
    emitted: ^java_surface_statement
  )
  let return_statement = java_grammar_production(
    name: ^java_production_return_statement,
    expression: java_grammar_return_statement_expr(),
    emitted: ^java_surface_return_statement
  )
  let local_variable_declaration = java_grammar_production(
    name: ^java_production_local_variable_declaration,
    expression: java_grammar_local_variable_declaration_expr(),
    emitted: ^java_surface_local_variable_declaration
  )
  let local_variable_declaration_statement = java_grammar_production(
    name: ^java_production_local_variable_declaration_statement,
    expression: java_grammar_local_variable_declaration_statement_expr(),
    emitted: ^java_surface_local_variable_declaration_statement
  )
  let expression = java_grammar_production(
    name: ^java_production_expression,
    expression: java_grammar_expression_expr(),
    emitted: ^java_surface_expression
  )
  let additive_expression = java_grammar_production(
    name: ^java_production_additive_expression,
    expression: java_grammar_additive_expression_expr(),
    emitted: ^java_surface_additive_expression
  )
  let multiplicative_expression = java_grammar_production(
    name: ^java_production_multiplicative_expression,
    expression: java_grammar_multiplicative_expression_expr(),
    emitted: ^java_surface_multiplicative_expression
  )
  let primary_expression = java_grammar_production(
    name: ^java_production_primary_expression,
    expression: java_grammar_primary_expression_expr(),
    emitted: ^java_surface_primary_expression
  )
  let method_add = java_grammar_production_method_add()
  GrammarRoot {
    start: ^java_production_compilation_unit,
    productions: [
      compilation_unit,
      class_declaration,
      class_member_declaration,
      class_body_declaration,
      class_body,
      method_header,
      method_body,
      method_declaration,
      field_declaration,
      primitive_type,
      result,
      type,
      formal_parameter_list,
      method_declarator,
      block,
      block_statement,
      statement,
      return_statement,
      local_variable_declaration,
      local_variable_declaration_statement,
      expression,
      additive_expression,
      multiplicative_expression,
      primary_expression,
      method_add
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn java_grammar() -> ParseGrammar {
  ModeledGrammar { root: java_grammar_root() }
}

fn java_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      java_catalog_surface_symbol(sym: sym) ||
        sym == ^java_surface_spelling_void ||
        lex_rule_set_token_class_member(rules: java_lex_rules(), token_class: sym) ||
        grammar_carries_symbol(grammar: java_grammar(), sym: sym) ||
        sym == ^java_surface_method_item ||
        sym == ^java_production_method_add ||
        sym == ^java_source_literal
    }
  }
}

fn java_language_model() -> LanguageModel {
  LanguageModel {
    lex: java_lex(),
    grammar: java_grammar(),
    language_identity: ^java_language_model_surface_id,
    canonical_symbols: java_canonical_symbols(),
    core: java_model_core()
  }
}

fn java_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: JavaIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn java_float_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: JavaFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn java_noninteger_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: JavaNonIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn java_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: java_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      java_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn java_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: java_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      java_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn java_noninteger_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: java_noninteger_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      java_noninteger_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn java_catalog_surface_symbol(sym: Symbol) -> Bool {
  java_integer_catalog_surface_symbol(sym: sym) ||
    java_float_catalog_surface_symbol(sym: sym) ||
    java_noninteger_catalog_surface_symbol(sym: sym)
}

fn java_method_add_lex_token_symbol(sym: Symbol) -> Bool {
  sym == ^java_token_kw_static ||
    sym == ^java_token_ident ||
    sym == ^java_token_kw_int ||
    sym == ^java_token_kw_return ||
    sym == ^java_token_plus ||
    sym == ^java_token_lbrace ||
    sym == ^java_token_rbrace ||
    sym == ^java_token_lparen ||
    sym == ^java_token_rparen ||
    sym == ^java_token_comma ||
    sym == ^java_token_semicolon
}

fn java_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      java_catalog_surface_symbol(sym: sym) ||
        sym == ^java_surface_spelling_void ||
        java_method_add_lex_token_symbol(sym: sym) ||
        sym == ^java_surface_method_item ||
        sym == ^java_production_method_add ||
        sym == ^java_source_literal
    }
  }
}

fn java_integer_spec_facts(facts: JavaIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: java_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisWidth {}) {
          Holds { value: java_int_width_node(width: facts.width) }
      } else if axis == discriminant(v: ModelCoreFactAxisSignedness {}) {
          Holds { value: java_int_kind_node(kind: facts.signedness) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: java_integer_encoding_fact(facts: facts) }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn java_float_spec_facts(facts: JavaFloatPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: java_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisWidth {}) {
          Holds { value: java_float_width_node(width: facts.width) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: java_inhabitant_atom(id: facts.ieee754_binary) }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn java_noninteger_spec_facts(facts: JavaNonIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: java_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: java_inhabitant_atom(id: facts.representation) }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn java_primitive_bundle_from_integer_facts(facts: JavaIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: java_integer_facts_node(facts: facts),
    spec_facts: java_integer_spec_facts(facts: facts)
  }
}

fn java_primitive_bundle_from_float_facts(facts: JavaFloatPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: java_float_facts_node(facts: facts),
    spec_facts: java_float_spec_facts(facts: facts)
  }
}

fn java_primitive_bundle_from_noninteger_facts(
  facts: JavaNonIntegerPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: java_noninteger_facts_node(facts: facts),
    spec_facts: java_noninteger_spec_facts(facts: facts)
  }
}

fn java_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: java_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: java_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn java_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: java_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: java_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn java_primitive_bundles_from_noninteger_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: java_noninteger_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: java_primitive_bundle_from_noninteger_facts(facts: facts)
      )
    }
  )
}

fn java_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  list_append(
    left: list_append(
      left: java_primitive_bundles_from_integer_catalog(),
      right: java_primitive_bundles_from_float_catalog()
    ),
    right: java_primitive_bundles_from_noninteger_catalog()
  )
}

fn java_symbol_node(id: Symbol) -> Node {
  java_inhabitant_atom(id: id)
}

fn java_wrapping_integer_algebra_witness_node(facts: JavaIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      java_named_edge(
        name: ^java_witness_integer_commutative_semiring_modular,
        target: java_symbol_node(id: ^java_witness_integer_commutative_semiring_modular)
      ),
      java_named_edge(
        name: ^java_facts_field_signedness,
        target: java_int_kind_node(kind: facts.signedness)
      ),
      java_named_edge(
        name: ^java_facts_field_width,
        target: java_int_width_node(width: facts.width)
      ),
      java_named_edge(
        name: ^java_facts_field_std_projection,
        target: java_symbol_node(id: facts.std_projection)
      ),
      java_named_edge(
        name: ^java_facts_field_overflow_release,
        target: java_overflow_node(overflow: facts.overflow_release)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn java_bool_algebra_witness_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      java_named_edge(
        name: ^java_witness_bool_boolean_algebra,
        target: java_symbol_node(id: ^java_witness_bool_boolean_algebra)
      ),
      java_named_edge(
        name: ^java_facts_field_std_projection,
        target: java_symbol_node(id: java_facts_boolean.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn java_wrapping_integer_algebra_inhabitance(facts: JavaIntegerPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = java_integer_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: commutative_semiring_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: java_wrapping_integer_algebra_witness_node(facts: facts)
  }
}

fn java_bool_algebra_inhabitance() -> AlgebraInhabitanceDecl {
  let inhabitant = java_noninteger_facts_node(facts: java_facts_boolean)
  AlgebraInhabitanceDecl {
    algebra: boolean_algebra_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: java_bool_algebra_witness_node()
  }
}

fn java_integer_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: java_integer_algebra_inhabitance_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: java_wrapping_integer_algebra_inhabitance(facts: facts))
    }
  )
}

fn java_bool_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  [
    java_bool_algebra_inhabitance()
  ]
}

fn java_model_core_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  list_append(
    left: java_integer_algebra_inhabitance_decls(),
    right: java_bool_algebra_inhabitance_decls()
  )
}

fn java_model_core_law_node(witness: Node, algebra: Node, key: JavaModelCoreLawKey) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      java_named_edge(name: ^model_core_law_field_subject, target: witness),
      java_named_edge(name: ^model_core_law_field_algebra, target: algebra),
      java_named_edge(
        name: ^model_core_law_field_kind,
        target: java_inhabitant_atom(id: discriminant(v: key))
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn java_model_core_law_obligation(witness: Node, law: Node) -> AlgebraLawObligation {
  AlgebraLawObligation {
    inhabitance_witness: witness,
    law: law
  }
}

fn java_wrapping_integer_law_obligations(facts: JavaIntegerPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = java_wrapping_integer_algebra_witness_node(facts: facts)
  let inhabitant = java_integer_facts_node(facts: facts)
  let algebra = commutative_semiring_type_node(inhabitant: inhabitant)
  [
    java_model_core_law_obligation(
      witness: witness,
      law: java_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: JavaLawIntegerAddAssociativeModular
      )
    ),
    java_model_core_law_obligation(
      witness: witness,
      law: java_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: JavaLawIntegerAddCommutativeModular
      )
    ),
    java_model_core_law_obligation(
      witness: witness,
      law: java_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: JavaLawIntegerMulAssociativeModular
      )
    ),
    java_model_core_law_obligation(
      witness: witness,
      law: java_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: JavaLawIntegerMulCommutativeModular
      )
    ),
    java_model_core_law_obligation(
      witness: witness,
      law: java_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: JavaLawIntegerDistributiveModular
      )
    ),
    java_model_core_law_obligation(
      witness: witness,
      law: java_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: JavaLawIntegerModularWrap
      )
    )
  ]
}

fn java_bool_algebra_laws() -> List<AlgebraLawObligation> {
  let witness = java_bool_algebra_witness_node()
  let inhabitant = java_noninteger_facts_node(facts: java_facts_boolean)
  let algebra = boolean_algebra_type_node(inhabitant: inhabitant)
  [
    java_model_core_law_obligation(
      witness: witness,
      law: java_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: JavaLawBoolBoundedLattice
      )
    ),
    java_model_core_law_obligation(
      witness: witness,
      law: java_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: JavaLawBoolComplement
      )
    )
  ]
}

fn java_integer_algebra_laws() -> List<AlgebraLawObligation> {
  fold_list(
    xs: java_integer_algebra_inhabitance_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(left: acc, right: java_wrapping_integer_law_obligations(facts: facts))
    }
  )
}

fn java_model_core_law_obligations() -> List<AlgebraLawObligation> {
  list_append(
    left: java_integer_algebra_laws(),
    right: java_bool_algebra_laws()
  )
}

fn java_pure_operation(operation: Symbol) -> PrimitiveOperationRef {
  PrimitiveOperationRef {
    operation: java_symbol_node(id: operation),
    effect_signature: EffectSignature {
      signature: java_symbol_node(id: ^java_effect_signature_pure_value)
    }
  }
}

fn java_effect_semantics() -> EffectSemanticsDecl {
  EffectSemanticsDecl {
    operations: [
      java_pure_operation(operation: ^java_op_integer_add),
      java_pure_operation(operation: ^java_op_integer_sub),
      java_pure_operation(operation: ^java_op_integer_mul),
      java_pure_operation(operation: ^java_op_integer_neg),
      java_pure_operation(operation: ^java_op_integer_div),
      java_pure_operation(operation: ^java_op_integer_rem),
      java_pure_operation(operation: ^java_op_integer_compare),
      java_pure_operation(operation: ^java_op_float_add),
      java_pure_operation(operation: ^java_op_float_sub),
      java_pure_operation(operation: ^java_op_float_mul),
      java_pure_operation(operation: ^java_op_float_div),
      java_pure_operation(operation: ^java_op_float_compare),
      java_pure_operation(operation: ^java_op_bool_and),
      java_pure_operation(operation: ^java_op_bool_or),
      java_pure_operation(operation: ^java_op_bool_not)
    ]
  }
}

fn java_fail_closed_partial_operation(
  operation: Symbol,
  precondition: Symbol,
  reason: Symbol
) -> PartialOperationDecl {
  PartialOperationDecl {
    operation: java_symbol_node(id: operation),
    precondition: java_symbol_node(id: precondition),
    discharge: FailClosedAtBoundary { reason: reason }
  }
}

fn java_partiality_semantics() -> PartialitySemanticsDecl {
  PartialitySemanticsDecl {
    operations: [
      java_fail_closed_partial_operation(
        operation: ^java_op_integer_div,
        precondition: ^java_precondition_integer_divisor_nonzero,
        reason: ^java_partial_integer_divide_by_zero
      ),
      java_fail_closed_partial_operation(
        operation: ^java_op_integer_rem,
        precondition: ^java_precondition_integer_divisor_nonzero,
        reason: ^java_partial_integer_remainder_by_zero
      )
    ]
  }
}

fn java_model_core() -> ModelCore {
  ModelCore {
    primitives: java_primitive_fact_bundles(),
    inhabitance: java_model_core_inhabitance_decls(),
    laws: java_model_core_law_obligations(),
    effects: java_effect_semantics(),
    partiality: java_partiality_semantics()
  }
}

fn java_method_add_language_model() -> LanguageModel {
  LanguageModel {
    lex: java_method_add_lex(),
    grammar: java_method_add_grammar(),
    language_identity: ^java_language_model_surface_id,
    canonical_symbols: java_language_model_canonical_symbols(),
    core: java_model_core()
  }
}
