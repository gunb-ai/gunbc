        grammar_formal_nonterminal_occurrence(identity: ^java_production_multiplicative_expression),
        grammar_formal_nonterminal_occurrence(identity: ^java_production_additive_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^java_production_expression,
