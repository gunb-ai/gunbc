    ),
    grammar_formal_production(
      lhs: ^java_production_return_statement,
      rhs: [
        grammar_formal_terminal(identity: ^java_token_kw_return),
        grammar_formal_terminal(identity: ^java_token_semicolon)
      ]
    ),
    grammar_formal_production(
      lhs: ^java_production_return_statement,
