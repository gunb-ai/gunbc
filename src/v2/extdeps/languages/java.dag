    grammar_formal_production(lhs: ^java_production_compilation_unit, rhs: [grammar_formal_nonterminal_occurrence(identity: ^java_production_class_declaration)]),
    grammar_formal_production(
      lhs: ^java_production_class_declaration,
      rhs: [
        grammar_formal_terminal(identity: ^java_token_kw_public),
        grammar_formal_terminal(identity: ^java_token_kw_class),
