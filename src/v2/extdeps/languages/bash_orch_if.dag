fn bash_log_matches_grep_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_grep_kw },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_log_matches_pattern },
    FixedToken { token_class: ^bash_token_grep_sp },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_log_matches_source }
  ]
}

data bash_log_matches_grep_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_log_matches_grep_tokens()
)

fn bash_log_matches_grep_source_text(pattern: String, source: String) -> String {
  concat("grep -qiE ", concat(pattern, concat(" ", source)))
}

fn bash_log_matches_grep_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: "grep -qiE ", class: ^bash_token_grep_kw),
    span(text: " ", class: ^bash_token_grep_sp)
  ]))
}

fn bash_log_matches_grep_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_log_matches_grep,
    lhs: ^bash_production_log_matches_grep,
    tokens: bash_log_matches_grep_tokens(),
    emitted: bash_log_matches_grep_emitted
  )
}

fn bash_log_matches_grep_binding_spellings(pattern: String, source: String) -> Map<Symbol, String> {
  map_insert(
    map_insert(empty_map(), ^bash_log_matches_pattern, pattern),
    ^bash_log_matches_source, source
  )
}

fn bash_log_matches_grep_target_model(pattern: String, source: String) -> TargetModel {
  bash_make_bound_tokens_target_model(
    rules: bash_log_matches_grep_translation_rules_node(),
    source_literal: ^bash_log_matches_grep_source_literal,
    production_name: ^bash_production_log_matches_grep,
    tokens: bash_log_matches_grep_tokens(),
    source_text: bash_log_matches_grep_source_text(pattern: pattern, source: source),
    lex: bash_log_matches_grep_lex(),
    binding_spellings: bash_log_matches_grep_binding_spellings(pattern: pattern, source: source)
  )
}

fn bash_stmt_or_ignore_fail_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_or_ignore_fail_stmt },
    FixedToken { token_class: ^bash_token_or_ignore_fail_sep }
  ]
}

data bash_stmt_or_ignore_fail_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_stmt_or_ignore_fail_tokens()
)

fn bash_stmt_or_ignore_fail_source_text(stmt: String) -> String {
  concat(stmt, " || true")
}

fn bash_stmt_or_ignore_fail_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: " || true", class: ^bash_token_or_ignore_fail_sep)
  ]))
}

fn bash_stmt_or_ignore_fail_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_stmt_or_ignore_fail,
    lhs: ^bash_production_stmt_or_ignore_fail,
    tokens: bash_stmt_or_ignore_fail_tokens(),
    emitted: bash_stmt_or_ignore_fail_emitted
  )
}

fn bash_stmt_or_ignore_fail_binding_spellings(stmt: String) -> Map<Symbol, String> {
  map_insert(empty_map(), ^bash_stmt_or_ignore_fail_stmt, stmt)
}

fn bash_stmt_or_ignore_fail_target_model(stmt: String) -> TargetModel {
  bash_make_bound_tokens_target_model(
    rules: bash_stmt_or_ignore_fail_translation_rules_node(),
    source_literal: ^bash_stmt_or_ignore_fail_source_literal,
    production_name: ^bash_production_stmt_or_ignore_fail,
    tokens: bash_stmt_or_ignore_fail_tokens(),
    source_text: bash_stmt_or_ignore_fail_source_text(stmt: stmt),
    lex: bash_stmt_or_ignore_fail_lex(),
    binding_spellings: bash_stmt_or_ignore_fail_binding_spellings(stmt: stmt)
  )
}

fn orch_if_target_model(cond: String, body: String) -> TargetModel {
  bash_stmt_if_target_model(cond: cond, body: body)
}

fn orch_if_else_target_model(cond: String, then_body: String, else_body: String) -> TargetModel {
  bash_stmt_if_else_target_model(cond: cond, then_body: then_body, else_body: else_body)
}
