module v2.extdeps.languages.bash_orch_if

import v2.std.compilers.lexing { LexRules, phrase, phrase_to_lex_rules, span }
import v2.std.compilers.target_model {
  BoundToken,
  ConcreteSyntaxToken,
  FixedToken,
  TargetModel,
  bound_tokens_source_text,
  render_target_text
}
import v2.std.collection { List, Map, empty_map, map_insert }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Outcome,
  Unavailable,
  bind_outcome,
  outcome_accepted,
  outcome_rejected,
  port_locus
}
import std.filesystem.types { EntryKind }
import v2.std.node { Node, Symbol }
import std.path_intent { PathIntent, PathPredicate, DirnameAscent, PathRef, PathLiteral, PathJoin, PathNonempty, PathNotEq, PathEntryKind, Not, And, Or }
import std.types { FilePathParts }
import v2.std.text { String }
import v2.extdeps.languages.bash {
  bash_conj_emitted_from_tokens,
  bash_relation_translation_rules_node,
  bash_make_bound_tokens_target_model,
  bash_stmt_assign_target_model,
  bash_stmt_if_target_model,
  bash_stmt_if_block_target_model,
  bash_stmt_negation_target_model,
  bash_stmt_andor_target_model,
}
import v2.extdeps.languages.bash_orch_tier2 {
  orch_cmdsubst_assign_raw_target_model
}

data bash_path_operand_unquoted_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_./-@"
data bash_path_ident_start_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
data bash_path_ident_continue_alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789"

fn bash_path_ident_char_ok(ch: String, first: Bool) -> Bool {
  if first {
    string_length(s: ch) == 1 && string_contains(s: bash_path_ident_start_alphabet, pattern: ch)
  } else {
    string_length(s: ch) == 1 && string_contains(s: bash_path_ident_continue_alphabet, pattern: ch)
  }
}

fn bash_path_ident_ok_at(name: String, i: Int, n: Int) -> Bool {
  if i >= n {
    true
  } else {
    let ch = char_at(s: name, pos: i)
    if !bash_path_ident_char_ok(ch: ch, first: i == 0) {
      false
    } else {
      bash_path_ident_ok_at(name: name, i: i + 1, n: n)
    }
  }
}

fn bash_path_ident_ok(name: String) -> Bool {
  let n = string_length(s: name)
  if n == 0 {
    false
  } else {
    bash_path_ident_ok_at(name: name, i: 0, n: n)
  }
}

fn bash_path_unquoted_ok_at(path: String, i: Int, n: Int) -> Bool {
  if i >= n {
    true
  } else {
    let ch = char_at(s: path, pos: i)
    if string_length(s: ch) != 1 || !string_contains(s: bash_path_operand_unquoted_alphabet, pattern: ch) {
      false
    } else {
      bash_path_unquoted_ok_at(path: path, i: i + 1, n: n)
    }
  }
}

fn bash_path_unquoted_ok(path: String) -> Bool {
  let n = string_length(s: path)
  if n == 0 {
    false
  } else {
    bash_path_unquoted_ok_at(path: path, i: 0, n: n)
  }
}

fn bash_relative_parts_text(parts: FilePathParts) -> String {
  fold(parts.segments, init: "", f: fn(acc, seg) {
    let seg_text = seg as String
    if acc == "" { seg_text } else { concat(acc, concat("/", seg_text)) }
  })
}

fn bash_absolute_parts_text(parts: FilePathParts) -> String {
  concat("/", bash_relative_parts_text(parts: parts))
}

fn bash_path_intent_text(path: PathIntent) -> Outcome<String> {
  match path {
    PathRef { name: n } =>
      if !bash_path_ident_ok(name: n as String) {
        outcome_rejected(bash_path_intent_invalid_diagnostic())
      } else {
        outcome_accepted(concat("$", n as String))
      }
    PathLiteral { parts: p } =>
      if !bash_path_unquoted_ok(path: bash_absolute_parts_text(parts: p)) {
        outcome_rejected(bash_path_intent_invalid_diagnostic())
      } else {
        outcome_accepted(bash_absolute_parts_text(parts: p))
      }
    PathJoin { base: b, suffix: s } =>
      bind_outcome(
        o: bash_path_intent_text(path: b),
        f: fn(base_text) {
          if !bash_path_unquoted_ok(path: bash_relative_parts_text(parts: s)) {
            outcome_rejected(bash_path_intent_invalid_diagnostic())
          } else {
            outcome_accepted(concat(base_text, concat("/", bash_relative_parts_text(parts: s))))
          }
        }
      )
  }
}

fn bash_path_operand_quoted_text(path: PathIntent) -> Outcome<String> {
  bind_outcome(
    o: bash_path_intent_text(path: path),
    f: fn(text) { outcome_accepted(concat("\"", concat(text, "\""))) }
  )
}

fn bash_test_path_kind_op(kind: EntryKind) -> Outcome<String> {
  match kind {
    RegularFile => outcome_accepted("-f ")
    Directory => outcome_accepted("-d ")
    Symlink => outcome_accepted("-L ")
    Missing => outcome_accepted("! -e ")
    Other => outcome_rejected(bash_path_intent_invalid_diagnostic())
  }
}

fn bash_test_path_kind_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_test_lbracket },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_test_path_kind_op },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_test_path_kind_operand },
    FixedToken { token_class: ^bash_token_test_rbracket }
  ]
}

data bash_test_path_kind_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_test_path_kind_tokens()
)

fn bash_test_path_kind_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: "[ ", class: ^bash_token_test_lbracket),
    span(text: " ]", class: ^bash_token_test_rbracket)
  ]))
}

fn bash_test_path_kind_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_test_path_kind,
    lhs: ^bash_production_test_path_kind,
    tokens: bash_test_path_kind_tokens(),
    emitted: bash_test_path_kind_emitted
  )
}

fn bash_test_path_kind_binding_spellings(op: String, operand: String) -> Map<Symbol, String> {
  map_insert(
    map_insert(empty_map(), ^bash_test_path_kind_op, op),
    ^bash_test_path_kind_operand, operand
  )
}

fn bash_test_path_kind_target_model(op: String, operand: String) -> Outcome<TargetModel> {
  bind_outcome(
    o: bound_tokens_source_text(
      tokens: bash_test_path_kind_tokens(),
      lex: bash_test_path_kind_lex(),
      binding_spellings: bash_test_path_kind_binding_spellings(op: op, operand: operand)
    ),
    f: fn(source_text) {
      outcome_accepted(
        bash_make_bound_tokens_target_model(
          rules: bash_test_path_kind_translation_rules_node(),
          source_literal: ^bash_test_path_kind_source_literal,
          production_name: ^bash_production_test_path_kind,
          tokens: bash_test_path_kind_tokens(),
          source_text: render_target_text(t: source_text),
          lex: bash_test_path_kind_lex(),
          binding_spellings: bash_test_path_kind_binding_spellings(op: op, operand: operand)
        )
      )
    }
  )
}

fn bash_path_intent_invalid_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^bash_path_intent_operand_invalid,
    at: port_locus(port: ^bash_path_intent_operand_port),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn bash_path_predicate_target_model(predicate: PathPredicate) -> Outcome<TargetModel> {
  match predicate {
    PathNonempty { path: p } =>
      bind_outcome(
        o: bash_path_operand_quoted_text(path: p),
        f: fn(operand) {
          bash_test_str_nonempty_target_model(operand: operand)
        }
      )
    PathNotEq { lhs: l, rhs: r } =>
      bind_outcome(
        o: bash_path_operand_quoted_text(path: l),
        f: fn(lhs) {
          bind_outcome(
            o: bash_path_operand_quoted_text(path: r),
            f: fn(rhs) { bash_test_str_not_eq_target_model(lhs: lhs, rhs: rhs) }
          )
        }
      )
    PathEntryKind { path: p, kind: k } =>
      bind_outcome(
        o: bash_path_operand_quoted_text(path: p),
        f: fn(operand) {
          bind_outcome(
            o: bash_test_path_kind_op(kind: k),
            f: fn(op) { bash_test_path_kind_target_model(op: op, operand: operand) }
          )
        }
      )
    Not { inner: i } =>
      bind_outcome(
        o: bash_path_predicate_target_model(predicate: i),
        f: fn(inner) {
          outcome_accepted(
            bash_stmt_negation_target_model(inner: inner.authority_source_text)
          )
        }
      )
    And { lhs: l, rhs: r } =>
      bind_outcome(
        o: bash_path_predicate_target_model(predicate: l),
        f: fn(lhs) {
          bind_outcome(
            o: bash_path_predicate_target_model(predicate: r),
            f: fn(rhs) {
              outcome_accepted(
                bash_stmt_andor_target_model(
                  left: lhs.authority_source_text,
                  op: "&&",
                  right: rhs.authority_source_text
                )
              )
            }
          )
        }
      )
    Or { lhs: l, rhs: r } =>
      bind_outcome(
        o: bash_path_predicate_target_model(predicate: l),
        f: fn(lhs) {
          bind_outcome(
            o: bash_path_predicate_target_model(predicate: r),
            f: fn(rhs) {
              outcome_accepted(
                bash_stmt_andor_target_model(
                  left: lhs.authority_source_text,
                  op: "||",
                  right: rhs.authority_source_text
                )
              )
            }
          )
        }
      )
  }
}

fn bash_dirname_ascent_target_model(ascent: DirnameAscent) -> Outcome<TargetModel> {
  match ascent.path {
    PathRef { name: n } =>
      if !bash_path_ident_ok(name: n as String) {
        outcome_rejected(bash_path_intent_invalid_diagnostic())
      } else {
        outcome_accepted(
          orch_cmdsubst_assign_raw_target_model(
            name: ascent.target,
            body: concat("dirname \"", concat(concat("$", n as String), "\""))
          )
        )
      }
    PathLiteral { parts: p } =>
      if !bash_path_unquoted_ok(path: bash_absolute_parts_text(parts: p)) {
        outcome_rejected(bash_path_intent_invalid_diagnostic())
      } else {
        outcome_accepted(
          orch_cmdsubst_assign_raw_target_model(
            name: ascent.target,
            body: concat("dirname \"", concat(bash_absolute_parts_text(parts: p), "\""))
          )
        )
      }
    PathJoin { base: b, suffix: s } =>
      bind_outcome(
        o: bash_path_intent_text(path: PathJoin { base: b, suffix: s }),
        f: fn(text) {
          outcome_accepted(
            orch_cmdsubst_assign_raw_target_model(
              name: ascent.target,
              body: concat("dirname \"", concat(text, "\""))
            )
          )
        }
      )
  }
}

fn bash_stmt_if_else_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_if_kw },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_if_cond },
    FixedToken { token_class: ^bash_token_if_then },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_if_body },
    FixedToken { token_class: ^bash_token_if_else },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_if_else_body },
    FixedToken { token_class: ^bash_token_if_fi }
  ]
}

data bash_stmt_if_else_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_stmt_if_else_tokens()
)

fn bash_stmt_if_else_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: "if ", class: ^bash_token_if_kw),
    span(text: "; then ", class: ^bash_token_if_then),
    span(text: "; else ", class: ^bash_token_if_else),
    span(text: "; fi", class: ^bash_token_if_fi)
  ]))
}

fn bash_stmt_if_else_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_stmt_if_else,
    lhs: ^bash_production_stmt_if_else,
    tokens: bash_stmt_if_else_tokens(),
    emitted: bash_stmt_if_else_emitted
  )
}

fn bash_stmt_if_else_binding_spellings(
  cond: String,
  then_body: String,
  else_body: String
) -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^bash_stmt_if_cond, cond),
      ^bash_stmt_if_body, then_body
    ),
    ^bash_stmt_if_else_body, else_body
  )
}

fn bash_stmt_if_else_target_model(cond: String, then_body: String, else_body: String) -> Outcome<TargetModel> {
  bind_outcome(
    o: bound_tokens_source_text(
      tokens: bash_stmt_if_else_tokens(),
      lex: bash_stmt_if_else_lex(),
      binding_spellings: bash_stmt_if_else_binding_spellings(
        cond: cond,
        then_body: then_body,
        else_body: else_body
      )
    ),
    f: fn(source_text) {
      outcome_accepted(
        bash_make_bound_tokens_target_model(
          rules: bash_stmt_if_else_translation_rules_node(),
          source_literal: ^bash_stmt_if_else_source_literal,
          production_name: ^bash_production_stmt_if_else,
          tokens: bash_stmt_if_else_tokens(),
          source_text: render_target_text(t: source_text),
          lex: bash_stmt_if_else_lex(),
          binding_spellings: bash_stmt_if_else_binding_spellings(
            cond: cond,
            then_body: then_body,
            else_body: else_body
          )
        )
      )
    }
  )
}

data bash_stmt_if_else_block_note: String = "Same If/else semantics as bash_stmt_if_else_tokens, spelled with real newlines around each body instead of the single-line \"; then \"/\"; else \"/\"; fi\" join. Selected by orch_emit_if_step (05_emit_orchestration.dag) when either arm's Pipeline carries more than one step — see bash_stmt_if_block_note (bash.dag) for why this is a formatting realization, not a correctness fix. Reuses bash_stmt_if_cond/bash_stmt_if_body/bash_stmt_if_else_body as binding keys, same fields as the inline row."

fn bash_stmt_if_else_block_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_if_kw },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_if_cond },
    FixedToken { token_class: ^bash_token_if_then_block },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_if_body },
    FixedToken { token_class: ^bash_token_if_else_block },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_if_else_body },
    FixedToken { token_class: ^bash_token_if_fi_block }
  ]
}

data bash_stmt_if_else_block_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_stmt_if_else_block_tokens()
)

fn bash_stmt_if_else_block_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: "if ", class: ^bash_token_if_kw),
    span(text: "; then\n", class: ^bash_token_if_then_block),
    span(text: "\nelse\n", class: ^bash_token_if_else_block),
    span(text: "\nfi", class: ^bash_token_if_fi_block)
  ]))
}

fn bash_stmt_if_else_block_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_stmt_if_else_block,
    lhs: ^bash_production_stmt_if_else_block,
    tokens: bash_stmt_if_else_block_tokens(),
    emitted: bash_stmt_if_else_block_emitted
  )
}

fn bash_stmt_if_else_block_target_model(cond: String, then_body: String, else_body: String) -> Outcome<TargetModel> {
  bind_outcome(
    o: bound_tokens_source_text(
      tokens: bash_stmt_if_else_block_tokens(),
      lex: bash_stmt_if_else_block_lex(),
      binding_spellings: bash_stmt_if_else_binding_spellings(
        cond: cond,
        then_body: then_body,
        else_body: else_body
      )
    ),
    f: fn(source_text) {
      outcome_accepted(
        bash_make_bound_tokens_target_model(
          rules: bash_stmt_if_else_block_translation_rules_node(),
          source_literal: ^bash_stmt_if_else_block_source_literal,
          production_name: ^bash_production_stmt_if_else_block,
          tokens: bash_stmt_if_else_block_tokens(),
          source_text: render_target_text(t: source_text),
          lex: bash_stmt_if_else_block_lex(),
          binding_spellings: bash_stmt_if_else_binding_spellings(
            cond: cond,
            then_body: then_body,
            else_body: else_body
          )
        )
      )
    }
  )
}

