module v2.extdeps.languages.bash_orch_if

fn bash_stmt_if_else_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_if_kw },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_if_cond },
    FixedToken { token_class: ^bash_token_if_then },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_if_body },
    FixedToken { token_class: ^bash_token_if_else },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_if_else_body },
    FixedToken { token_class: ^bash_token_if_fi }
  ]
}

data bash_stmt_if_else_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_stmt_if_else_tokens()
)

fn bash_stmt_if_else_source_text(cond: String, then_body: String, else_body: String) -> String {
  concat(
    "if ",
    concat(
      cond,
      concat(
        "; then ",
        concat(then_body, concat("; else ", concat(else_body, "; fi")))
      )
    )
  )
}

fn bash_stmt_if_else_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: "if ", class: ^bash_token_if_kw),
    span(text: "; then ", class: ^bash_token_if_then),
    span(text: "; else ", class: ^bash_token_if_else),
    span(text: "; fi", class: ^bash_token_if_fi)
  ]))
}

fn bash_stmt_if_else_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_stmt_if_else,
    lhs: ^bash_production_stmt_if_else,
    tokens: bash_stmt_if_else_tokens(),
    emitted: bash_stmt_if_else_emitted
  )
}

fn bash_stmt_if_else_binding_spellings(
  cond: String,
  then_body: String,
  else_body: String
) -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^bash_stmt_if_cond, cond),
      ^bash_stmt_if_body, then_body
    ),
    ^bash_stmt_if_else_body, else_body
  )
}

fn bash_stmt_if_else_target_model(cond: String, then_body: String, else_body: String) -> TargetModel {
  bash_make_bound_tokens_target_model(
    rules: bash_stmt_if_else_translation_rules_node(),
    source_literal: ^bash_stmt_if_else_source_literal,
    production_name: ^bash_production_stmt_if_else,
    tokens: bash_stmt_if_else_tokens(),
    source_text: bash_stmt_if_else_source_text(cond: cond, then_body: then_body, else_body: else_body),
    lex: bash_stmt_if_else_lex(),
    binding_spellings: bash_stmt_if_else_binding_spellings(
      cond: cond,
      then_body: then_body,
      else_body: else_body
    )
  )
}

fn bash_test_str_eq_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_test_lbracket },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_test_str_eq_lhs },
    FixedToken { token_class: ^bash_token_test_eq },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_test_str_eq_rhs },
    FixedToken { token_class: ^bash_token_test_rbracket }
  ]
}

data bash_test_str_eq_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_test_str_eq_tokens()
)

fn bash_test_str_eq_source_text(lhs: String, rhs: String) -> String {
  concat("[ ", concat(lhs, concat(" = ", concat(rhs, " ]"))))
}

fn bash_test_str_eq_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: "[ ", class: ^bash_token_test_lbracket),
    span(text: " = ", class: ^bash_token_test_eq),
    span(text: " ]", class: ^bash_token_test_rbracket)
  ]))
}

fn bash_test_str_eq_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_test_str_eq,
    lhs: ^bash_production_test_str_eq,
    tokens: bash_test_str_eq_tokens(),
    emitted: bash_test_str_eq_emitted
  )
}

fn bash_test_str_eq_binding_spellings(lhs: String, rhs: String) -> Map<Symbol, String> {
  map_insert(
    map_insert(empty_map(), ^bash_test_str_eq_lhs, lhs),
    ^bash_test_str_eq_rhs, rhs
  )
}

fn bash_test_str_eq_target_model(lhs: String, rhs: String) -> TargetModel {
  bash_make_bound_tokens_target_model(
    rules: bash_test_str_eq_translation_rules_node(),
    source_literal: ^bash_test_str_eq_source_literal,
    production_name: ^bash_production_test_str_eq,
    tokens: bash_test_str_eq_tokens(),
    source_text: bash_test_str_eq_source_text(lhs: lhs, rhs: rhs),
    lex: bash_test_str_eq_lex(),
    binding_spellings: bash_test_str_eq_binding_spellings(lhs: lhs, rhs: rhs)
  )
}

