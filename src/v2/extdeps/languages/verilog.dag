module v2.extdeps.languages.verilog


data verilog_std_integer_signedness_migration_note: String = "Signedness consumer migration: verilog imports std.integer.Signedness. Semantic equivalence: verilog signed/unsigned on net, port, and parameter declarations is the same interpretive axis as std.integer Signed/Unsigned — whether a bit pattern is read as two's-complement signed range or unsigned modular arithmetic; no Verilog-specific signedness semantics beyond this axis are modeled on these fields."

type PortDirection
  = Input
  | Output
  | Inout

type NonTriregNetKind
  = Wire
  | Tri
  | Wand
  | TriAnd
  | Wor
  | TriOr
  | Tri0
  | Tri1
  | Supply0
  | Supply1
  | Uwire

type NetType
  = NonTriregNet { kind: NonTriregNetKind }
  | TriregNet

type EdgeTrigger
  = PosEdge
  | NegEdge
  | AnyChange

type ProceduralAssignKind
  = Blocking
  | NonBlocking

type ConstantUnaryOperator
  = ConstUnaryPlus
  | ConstUnaryMinus
  | ConstUnaryLogicalNot
  | ConstUnaryBitwiseNot
  | ConstUnaryReductionAnd
  | ConstUnaryReductionNand
  | ConstUnaryReductionOr
  | ConstUnaryReductionNor
  | ConstUnaryReductionXor
  | ConstUnaryReductionXnorTildeCaret
  | ConstUnaryReductionXnorCaretTilde

type ConstantBinaryOperator
  = ConstBinaryAdd
  | ConstBinarySub
  | ConstBinaryMul
  | ConstBinaryDiv
  | ConstBinaryMod
  | ConstBinaryEq
  | ConstBinaryNe
  | ConstBinaryCaseEq
  | ConstBinaryCaseNe
  | ConstBinaryLogicalAnd
  | ConstBinaryLogicalOr
  | ConstBinaryPower
  | ConstBinaryLt
  | ConstBinaryLe
  | ConstBinaryGt
  | ConstBinaryGe
  | ConstBinaryBitwiseAnd
  | ConstBinaryBitwiseOr
  | ConstBinaryBitwiseXor
  | ConstBinaryBitwiseXnorTildeCaret
  | ConstBinaryBitwiseXnorCaretTilde
  | ConstBinaryLogicalShiftLeft
  | ConstBinaryLogicalShiftRight
  | ConstBinaryArithmeticShiftLeft
  | ConstBinaryArithmeticShiftRight

type ConstantRangeExpression
  = ConstantRangeSingle { expression: ConstantExpression }
  | ConstantRange { msb: ConstantExpression, lsb: ConstantExpression }
  | ConstantIndexedRangePlus { base: ConstantExpression, width: ConstantExpression }
  | ConstantIndexedRangeMinus { base: ConstantExpression, width: ConstantExpression }

type ConstantSelect
  = NoConstantSelect
  | ConstantSelectRange { range: ConstantRangeExpression }

type ConstantPrimary
  = ConstantNumber { lexeme: String }
  | ConstantParameterReference { name: v2.std.node.Symbol, select: ConstantSelect }
  | ConstantSpecparamReference { name: v2.std.node.Symbol, select: ConstantSelect }
  | ConstantFunctionCallPrimary { call: ConstantFunctionCall }
  | ConstantSystemFunctionCallPrimary { call: ConstantSystemFunctionCall }
  | ConstantConcatenationPrimary { concatenation: ConstantConcatenation }
  | ConstantMultipleConcatenationPrimary { multiple: ConstantMultipleConcatenation }
  | ConstantParenthesizedExpressionPrimary { expression: ConstantExpression }
  | ConstantMinTypMaxPrimary { min: ConstantExpression, typ: ConstantExpression, max: ConstantExpression }
  | ConstantString { lexeme: String }

type ConstantFunctionCall {
  function_name: v2.std.node.Symbol
  attributes: AttributeInstanceClause
  arguments: List<ConstantExpression>
}

type ConstantSystemFunctionCall {
  system_function_name: v2.std.node.Symbol
  arguments: List<ConstantExpression>
}

type ConstantConcatenation {
  expressions: List<ConstantExpression>
}

type ConstantMultipleConcatenation {
  repeat_count: ConstantExpression
  concatenation: ConstantConcatenation
}

type ConstantExpression
  = ConstantPrimaryExpression { primary: ConstantPrimary }
  | ConstantUnaryExpression { attributes: AttributeInstanceClause, op: ConstantUnaryOperator, operand: ConstantPrimary }
  | ConstantBinaryExpression { lhs: ConstantExpression, attributes: AttributeInstanceClause, op: ConstantBinaryOperator, rhs: ConstantExpression }
  | ConstantConditionalExpression { condition: ConstantExpression, attributes: AttributeInstanceClause, if_true: ConstantExpression, if_false: ConstantExpression }

type VectorRange {
  msb: ConstantExpression
  lsb: ConstantExpression
}

type PackingShape
  = Scalar
  | Packed { range: VectorRange }

type NetVectoredPacking
  = NetUnranged
  | NetRanged { vectoredness: VectorednessClause, range: VectorRange }

type DriveStrengthClause
  = NoDriveStrength
  | DriveStrengthLexeme { lexeme: String }

type ChargeStrengthClause
  = NoChargeStrength
  | ChargeStrengthLexeme { lexeme: String }

type DelayClause
  = NoDelay
  | DelayLexeme { lexeme: String }

type AttributeInstanceClause
  = NoAttributeInstances
  | AttributeInstanceLexeme { lexeme: String }

type VectorednessClause
  = NoVectoredness
  | VectoredNet
  | ScalaredNet

type UnpackedDimensionsClause
  = NoUnpackedDimensions
  | UnpackedDimensionsLexeme { lexeme: String }

type VariableInitializerClause
  = NoVariableInitializer
  | VariableInitializerLexeme { lexeme: String }

type NetDeclaration
  = NonTriregIdentifierForm {
      kind: NonTriregNetKind
      net_packing: NetVectoredPacking
      signedness: std.integer.Signedness
      delay: DelayClause
      identifiers: List<NetIdentifierDeclarator>
    }
  | NonTriregAssignForm {
      kind: NonTriregNetKind
      drive_strength: DriveStrengthClause
      net_packing: NetVectoredPacking
      signedness: std.integer.Signedness
      delay: DelayClause
      assignments: List<NetAssignmentDeclarator>
    }
  | TriregIdentifierForm {
      charge_strength: ChargeStrengthClause
      net_packing: NetVectoredPacking
      signedness: std.integer.Signedness
      delay: DelayClause
      identifiers: List<NetIdentifierDeclarator>
    }
  | TriregAssignForm {
      drive_strength: DriveStrengthClause
      net_packing: NetVectoredPacking
      signedness: std.integer.Signedness
      delay: DelayClause
      assignments: List<NetAssignmentDeclarator>
    }

type NetAssignmentDeclarator {
  name: v2.std.node.Symbol
  rhs_lexeme: String
}

type NetIdentifierDeclarator {
  name: v2.std.node.Symbol
  unpacked_dimensions: UnpackedDimensionsClause
}

type VariableDeclaration
  = RegVariable { packing: PackingShape, signedness: std.integer.Signedness, declarators: List<VariableDeclarator> }
  | IntegerVariable { declarators: List<VariableDeclarator> }
  | RealVariable { declarators: List<VariableDeclarator> }
  | TimeVariable { declarators: List<VariableDeclarator> }
  | RealTimeVariable { declarators: List<VariableDeclarator> }

type VariableDeclarator
  = NamedVariable {
      name: v2.std.node.Symbol
      unpacked_dimensions: UnpackedDimensionsClause
    }
  | InitializedVariable {
      name: v2.std.node.Symbol
      initializer_lexeme: String
    }

type OutputPortAnsiNetTypeKind
  = OutputAnsiNetType { kind: NonTriregNetKind, packing: PackingShape, signedness: std.integer.Signedness }
  | OutputAnsiNoNetType { packing: PackingShape, signedness: std.integer.Signedness }

type OutputPortAnsiVariableTypeKind
  = OutputAnsiRegType { packing: PackingShape, signedness: std.integer.Signedness }
  | OutputAnsiIntegerType
  | OutputAnsiTimeType

type NonAnsiPort
  = BlankNonAnsiPort
  | ExpressionNonAnsiPort { expression_lexeme: String }
  | ExternalNamedBlankPort { external_name: v2.std.node.Symbol }
  | ExternalNamedExpressionPort { external_name: v2.std.node.Symbol, expression_lexeme: String }

type AnsiNetPortType
  = AnsiInputInoutNet { kind: NonTriregNetKind, packing: PackingShape, signedness: std.integer.Signedness }
  | AnsiInputInoutNoNetType { packing: PackingShape, signedness: std.integer.Signedness }

type AnsiPortDeclaration
  = AnsiInputPort {
      net: AnsiNetPortType
      names: List<v2.std.node.Symbol>
    }
  | AnsiOutputNetPort {
      type_kind: OutputPortAnsiNetTypeKind
      names: List<v2.std.node.Symbol>
    }
  | AnsiOutputVariablePort {
      type_kind: OutputPortAnsiVariableTypeKind
      names: List<AnsiOutputPortDeclarator>
    }
  | AnsiInoutPort {
      net: AnsiNetPortType
      names: List<v2.std.node.Symbol>
    }

type AnsiHeaderPort {
  attributes: AttributeInstanceClause
  decl: AnsiPortDeclaration
}

type AnsiOutputPortDeclarator {
  name: v2.std.node.Symbol
  initializer: VariableInitializerClause
}

type ParameterTypeKind
  = UntypedParameter { packing: PackingShape, signedness: std.integer.Signedness }
  | IntegerParameter
  | RealParameter
  | TimeParameter
  | RealTimeParameter

type ParameterAssignment {
  name: v2.std.node.Symbol
  default_lexeme: String
}

type ParameterDeclaration {
  type_kind: ParameterTypeKind
  assignments: List<ParameterAssignment>
}

type SensitivityItem {
  trigger: EdgeTrigger
  event_expression_lexeme: String
}

type NetAssignment {
  lhs_lexeme: String
  rhs_lexeme: String
}

type ContinuousAssign {
  drive_strength: DriveStrengthClause
  delay: DelayClause
  assignments: List<NetAssignment>
}

type AlwaysBlock {
  sensitivity: AlwaysBlockSensitivity
  body_lexeme: String
}

type AlwaysBlockSensitivity
  = NoEventControl
  | ImplicitAtStar
  | ExplicitEventList { items: List<SensitivityItem> }

type InitialBlock {
  body_lexeme: String
}

type PortConnectionActual
  = ExpressionConnection { expression_lexeme: String }
  | BlankConnection

type OrderedPortConnection {
  attributes: AttributeInstanceClause
  actual: PortConnectionActual
}

type NamedPortConnection {
  attributes: AttributeInstanceClause
  port: v2.std.node.Symbol
  actual: PortConnectionActual
}

type PortConnections
  = NoPortConnections
  | PositionalConnections {
      actuals: List<OrderedPortConnection>
    }
  | NamedConnections {
      connections: List<NamedPortConnection>
    }

type ParameterOverrideActual
  = BlankParameterOverride
  | ParameterOverrideExpression { lexeme: String }

type NamedParameterOverride {
  parameter: v2.std.node.Symbol
  actual: ParameterOverrideActual
}

type ParameterOverrides
  = NoParameterOverrides
  | OrderedParameterOverrides { actuals: List<String> }
  | NamedParameterOverrides { overrides: List<NamedParameterOverride> }

type InstanceRangeClause
  = NoInstanceRange
  | InstanceRange { range: VectorRange }

type ModuleInstance {
  instance_name: v2.std.node.Symbol
  instance_range: InstanceRangeClause
  connections: PortConnections
}

type ModuleInstantiation {
  module_name: v2.std.node.Symbol
  parameter_overrides: ParameterOverrides
  instances: List<ModuleInstance>
}

type DefparamAssignment {
  target_path: String
  value_lexeme: String
}

type DefparamDeclaration {
  assignments: List<DefparamAssignment>
}

type GenerateRegion {
  body_lexeme: String
}

type LoopGenerateConstruct {
  body_lexeme: String
}

type ConditionalGenerateConstruct {
  body_lexeme: String
}

type SpecifyBlock {
  body_lexeme: String
}

type LifetimeClause
  = StaticLifetime
  | AutomaticLifetime

type FunctionReturnTypeClause
  = NoFunctionReturnType
  | FunctionReturnTypeLexeme { lexeme: String }

type TaskDeclaration {
  lifetime: LifetimeClause
  name: v2.std.node.Symbol
  body_lexeme: String
}

type FunctionDeclaration {
  lifetime: LifetimeClause
  return_type: FunctionReturnTypeClause
  name: v2.std.node.Symbol
  body_lexeme: String
}

type EventDeclarator {
  name: v2.std.node.Symbol
  unpacked_dimensions: UnpackedDimensionsClause
}

type EventDeclaration {
  event_declarators: List<EventDeclarator>
}

type GenvarDeclaration {
  genvar_names: List<v2.std.node.Symbol>
}

type LocalParameterDeclaration {
  type_kind: ParameterTypeKind
  assignments: List<ParameterAssignment>
}

type PrimitiveGateKind
  = GateAnd
  | GateNand
  | GateOr
  | GateNor
  | GateXor
  | GateXnor
  | GateBuf
  | GateNot
  | GateBufif0
  | GateBufif1
  | GateNotif0
  | GateNotif1
  | GateNmos
  | GatePmos
  | GateCmos
  | GateRnmos
  | GateRpmos
  | GateRcmos
  | GateTran
  | GateRtran
  | GateTranif0
  | GateTranif1
  | GateRtranif0
  | GateRtranif1
  | GatePulldown
  | GatePullup

type GateInstantiation {
  gate_kind: PrimitiveGateKind
  body_lexeme: String
}

type UdpInstanceName
  = NoUdpInstanceName
  | NamedUdpInstance { name: v2.std.node.Symbol, instance_range: InstanceRangeClause }

type UdpInstance {
  instance_name: UdpInstanceName
  body_lexeme: String
}

type UdpInstantiation {
  udp_name: v2.std.node.Symbol
  drive_strength: DriveStrengthClause
  delay: DelayClause
  instances: List<UdpInstance>
}

type UdpDefinition {
  attributes: AttributeInstanceClause
  name: v2.std.node.Symbol
  body_lexeme: String
}

type SpecparamAssignment
  = NamedSpecparamAssignment { name: v2.std.node.Symbol, value_lexeme: String }
  | PulseControlSpecparam { lexeme: String }

type SpecparamDeclaration {
  packing: PackingShape
  assignments: List<SpecparamAssignment>
}

type AnsiModuleItem
  = ContinuousAssignItem { attributes: AttributeInstanceClause, assign: ContinuousAssign }
  | AlwaysBlockItem { attributes: AttributeInstanceClause, always_block: AlwaysBlock }
  | InitialBlockItem { attributes: AttributeInstanceClause, initial_block: InitialBlock }
  | NetDeclarationItem { attributes: AttributeInstanceClause, net: NetDeclaration }
  | VariableDeclarationItem { attributes: AttributeInstanceClause, variable: VariableDeclaration }
  | ParameterDeclarationItem { attributes: AttributeInstanceClause, parameter: ParameterDeclaration }
  | LocalParameterDeclarationItem { attributes: AttributeInstanceClause, local_parameter: LocalParameterDeclaration }
  | ModuleInstantiationItem { attributes: AttributeInstanceClause, instantiation: ModuleInstantiation }
  | DefparamDeclarationItem { attributes: AttributeInstanceClause, defparam: DefparamDeclaration }
  | GenerateRegionItem { generate_region: GenerateRegion }
  | LoopGenerateConstructItem { attributes: AttributeInstanceClause, loop_generate: LoopGenerateConstruct }
  | ConditionalGenerateConstructItem { attributes: AttributeInstanceClause, conditional_generate: ConditionalGenerateConstruct }
  | SpecifyBlockItem { specify_block: SpecifyBlock }
  | TaskDeclarationItem { attributes: AttributeInstanceClause, task: TaskDeclaration }
  | FunctionDeclarationItem { attributes: AttributeInstanceClause, function_decl: FunctionDeclaration }
  | EventDeclarationItem { attributes: AttributeInstanceClause, event_decl: EventDeclaration }
  | GenvarDeclarationItem { attributes: AttributeInstanceClause, genvar_decl: GenvarDeclaration }
  | GateInstantiationItem { attributes: AttributeInstanceClause, gate: GateInstantiation }
  | UdpInstantiationItem { attributes: AttributeInstanceClause, udp_instance: UdpInstantiation }
  | SpecparamDeclarationItem { attributes: AttributeInstanceClause, specparam: SpecparamDeclaration }

type NonAnsiModuleItem
  = NonAnsiAnsiCompatItem { item: AnsiModuleItem }
  | NonAnsiPortDeclarationItem {
      attributes: AttributeInstanceClause,
      port_decl: AnsiPortDeclaration
    }

type ModuleParameterPortList
  = NoModuleParameterPortList
  | ModuleParameters { parameters: List<ParameterDeclaration> }

type ModuleKeyword
  = ModuleKw
  | MacromoduleKw

type VerilogModule
  = NoPortListModule {
      attributes: AttributeInstanceClause,
      module_keyword: ModuleKeyword,
      name: v2.std.node.Symbol,
      parameter_port_list: ModuleParameterPortList,
      items: List<AnsiModuleItem>
    }
  | EmptyPortListModule {
      attributes: AttributeInstanceClause,
      module_keyword: ModuleKeyword,
      name: v2.std.node.Symbol,
      parameter_port_list: ModuleParameterPortList,
      items: List<AnsiModuleItem>
    }
  | NonAnsiVerilogModule {
      attributes: AttributeInstanceClause,
      module_keyword: ModuleKeyword,
      name: v2.std.node.Symbol,
      parameter_port_list: ModuleParameterPortList,
      header_ports: List<NonAnsiPort>,
      items: List<NonAnsiModuleItem>
    }
  | AnsiVerilogModule {
      attributes: AttributeInstanceClause,
      module_keyword: ModuleKeyword,
      name: v2.std.node.Symbol,
      parameter_port_list: ModuleParameterPortList,
      header_ports: List<AnsiHeaderPort>,
      items: List<AnsiModuleItem>
    }

type VerilogCost {
  gate_cost: v2.std.nat.Nat
  area_cost: v2.std.nat.Nat
}
fn verilog_lex_token(token_class: v2.std.node.Symbol, pattern: v2.std.compilers.lexing.LexPattern) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule { token_class: token_class, pattern: pattern }
}

fn verilog_grammar_terminal(token_class: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  Terminal { token_class: token_class, stamp: v2.std.grammar.StampClass }
}

fn verilog_grammar_sequence(left: v2.std.grammar.GrammarExpr, right: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Sequence { left: left, right: right }
}

fn verilog_identifier_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentStartChar },
    right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentContinueChar } }
  }
}

fn verilog_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules {
    root: v2.std.compilers.lexing.LexRuleSet {
      rules: [
        v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.WhitespaceChar } } },
        verilog_lex_token(token_class: ^verilog_token_ident, pattern: verilog_identifier_pattern()),
        verilog_lex_token(token_class: ^verilog_token_kw_module, pattern: v2.std.compilers.lexing.KeywordPattern { text: "module" }),
        verilog_lex_token(token_class: ^verilog_token_kw_endmodule, pattern: v2.std.compilers.lexing.KeywordPattern { text: "endmodule" }),
        verilog_lex_token(
          token_class: ^verilog_token_port_direction,
          pattern: v2.std.compilers.lexing.ChoicePattern {
            left: v2.std.compilers.lexing.KeywordPattern { text: "input" },
            right: v2.std.compilers.lexing.KeywordPattern { text: "output" }
          }
        ),
        verilog_lex_token(token_class: ^verilog_token_kw_wire, pattern: v2.std.compilers.lexing.KeywordPattern { text: "wire" }),
        verilog_lex_token(token_class: ^verilog_token_kw_assign, pattern: v2.std.compilers.lexing.KeywordPattern { text: "assign" }),
        verilog_lex_token(token_class: ^verilog_token_semicolon, pattern: v2.std.compilers.lexing.LiteralPattern { text: ";" }),
        verilog_lex_token(token_class: ^verilog_token_lparen, pattern: v2.std.compilers.lexing.LiteralPattern { text: "(" }),
        verilog_lex_token(token_class: ^verilog_token_rparen, pattern: v2.std.compilers.lexing.LiteralPattern { text: ")" }),
        verilog_lex_token(token_class: ^verilog_token_comma, pattern: v2.std.compilers.lexing.LiteralPattern { text: "," }),
        verilog_lex_token(token_class: ^verilog_token_equals, pattern: v2.std.compilers.lexing.LiteralPattern { text: "=" }),
        verilog_lex_token(token_class: ^verilog_token_unary_operator, pattern: v2.std.compilers.lexing.LiteralPattern { text: "~" }),
        verilog_lex_token(
          token_class: ^verilog_token_binary_operator,
          pattern: v2.std.compilers.lexing.ChoicePattern {
            left: v2.std.compilers.lexing.LiteralPattern { text: "&" },
            right: v2.std.compilers.lexing.LiteralPattern { text: "|" }
          }
        )
      ]
    }
  }
}

fn verilog_source_text_module_expr() -> v2.std.grammar.GrammarExpr {
  verilog_grammar_sequence(
    left: verilog_grammar_terminal(token_class: ^verilog_token_kw_module),
    right: verilog_grammar_sequence(
      left: verilog_grammar_terminal(token_class: ^verilog_token_ident),
      right: verilog_grammar_sequence(
        left: verilog_grammar_terminal(token_class: ^verilog_token_semicolon),
        right: verilog_grammar_terminal(token_class: ^verilog_token_kw_endmodule)
      )
    )
  )
}

fn verilog_grammar() -> v2.std.grammar.ParseGrammar {
  let start = v2.std.grammar.GrammarProduction {
    name: ^verilog_production_source_text_module,
    expression: verilog_source_text_module_expr(),
    emitted: v2.std.grammar.grammar_atom(identity: ^verilog_surface_module_decl)
  }
  v2.std.grammar.ModeledGrammar {
    root: v2.std.grammar.GrammarRoot {
      start: ^verilog_production_source_text_module,
      productions: [start],
      sync_tokens: v2.std.grammar.grammar_empty_sync_tokens()
    }
  }
}

fn verilog_source_text_module_formal_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.FormalProduction {
    lhs: v2.std.grammar.grammar_formal_nonterminal(identity: ^verilog_production_source_text_module),
    rhs: [
      v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_kw_module),
      v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_ident),
      v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_semicolon),
      v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_kw_endmodule)
    ]
  }
}

// THE BOUNDED EMISSION PROFILE, as formal productions rather than a printer. Every byte of the
// interlock module derives from these rows: the keywords, the punctuation, the whitespace and the
// operators are grammar facts here, so product.compute_board can construct structure and own no
// Verilog syntax at all.
//
// DIRECTION IS A BOUND TERMINAL, NOT AN ALTERNATION, and the reason is a real constraint on how
// alternation may be used at all. Productions sharing an lhs are selected by UNIQUE STRUCTURAL
// MATCH against the emitted node (formal_production_unique_lhs_exact_match), and a concrete
// terminal contributes NO child to that node. So `direction -> kw_input` and
// `direction -> kw_output` are structurally identical, match indistinguishably, and refuse as
// grammar_relation_row_backward_selection_ambiguous. TypeScript's params_opt alternation works
// only because its alternatives differ in child count — empty versus one nonterminal occurrence.
// Alternation therefore expresses OPTIONALITY and SHAPE, never a choice between two spellings;
// a spelling choice is a binding, and the lexical class spans both keywords so the same
// production also reparses either one.
//
// COMPOSITION IS THE POINT. The port list is right-recursive rather than three hard-coded slots,
// so a module with two or four ports is the same grammar — a fixed arity would prove a fixture,
// not a module grammar. Expressions nest through their own nonterminals for the same reason: a
// row whose token list happened to spell the whole module would only be the hand serializer
// moved into data.
fn verilog_emission_formal_productions() -> List<v2.std.grammar.FormalProduction> {
  [
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_ansi_port,
      rhs: [
        v2.std.grammar.grammar_formal_terminal_free(identity: ^verilog_token_port_direction),
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_kw_wire),
        v2.std.grammar.grammar_formal_terminal_free(identity: ^verilog_token_ident)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_port_list,
      rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_ansi_port)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_port_list,
      rhs: [
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_ansi_port),
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_comma),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_port_list)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_expr,
      rhs: [v2.std.grammar.grammar_formal_terminal_free(identity: ^verilog_token_ident)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_expr,
      rhs: [
        v2.std.grammar.grammar_formal_terminal_free(identity: ^verilog_token_unary_operator),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_expr)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_expr,
      rhs: [
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_lparen),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_expr),
        v2.std.grammar.grammar_formal_terminal_free(identity: ^verilog_token_binary_operator),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_expr),
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_rparen)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_continuous_assign,
      rhs: [
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_kw_assign),
        v2.std.grammar.grammar_formal_terminal_free(identity: ^verilog_token_ident),
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_equals),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_expr),
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_semicolon)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_assign_list,
      rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_continuous_assign)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_assign_list,
      rhs: [
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_continuous_assign),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_assign_list)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^verilog_production_ansi_module_decl,
      rhs: [
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_kw_module),
        v2.std.grammar.grammar_formal_terminal_free(identity: ^verilog_token_ident),
        v2.std.grammar.grammar_formal_terminal_free(identity: ^verilog_token_lparen),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_port_list),
        v2.std.grammar.grammar_formal_terminal_free(identity: ^verilog_token_rparen),
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_semicolon),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^verilog_production_assign_list),
        v2.std.grammar.grammar_formal_terminal(identity: ^verilog_token_kw_endmodule)
      ]
    )
  ]
}

// LAYOUT IS TARGET-OWNED, AND THIS IS WHERE IT LIVES. target_text_seq concatenates exactly, so
// every space and newline in an emitted module is declared here or does not exist. None of it may
// return to product.compute_board, which is the whole point of the exercise.
//
// WHY THE HEADER AND EXPRESSION PARENTHESES ARE DIFFERENT TOKEN CLASSES. A transform is keyed by
// token class, so one paren class cannot render " (\n" around a port list and "(" inside an
// expression. The oracle needs both. Splitting the class is what makes the layout expressible;
// the two classes lex the same literal, which is a REPARSE question and is called out in the
// module note rather than papered over here.
fn verilog_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn verilog_conj(children: List<v2.std.node.Edge>) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: children,
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn verilog_slot(target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Positional, target: target }
}

// THE EMITTED NODE CARRIES ONE SLOT PER VARIABLE POSITION, and its ARITY is what the backward
// selector matches on. That is why the expression forms have one, two and three slots rather than
// sharing a shape and relying on a discriminant nobody compares: a signal reference carries its
// name, a unary application carries operator and operand, a binary one carries operand, operator
// and operand. Concrete punctuation contributes no slot, which is exactly why the parentheses and
// the keywords are invisible here and live entirely in the layout profile.
fn verilog_signal_reference(name: v2.std.node.Symbol) -> v2.std.node.Node {
  verilog_conj(children: [verilog_slot(target: verilog_atom(id: name))])
}

fn verilog_unary_application(operator: v2.std.node.Symbol, operand: v2.std.node.Node) -> v2.std.node.Node {
  verilog_conj(children: [
    verilog_slot(target: verilog_atom(id: operator)),
    verilog_slot(target: operand)
  ])
}

fn verilog_binary_application(left: v2.std.node.Node, operator: v2.std.node.Symbol, right: v2.std.node.Node) -> v2.std.node.Node {
  verilog_conj(children: [
    verilog_slot(target: left),
    verilog_slot(target: verilog_atom(id: operator)),
    verilog_slot(target: right)
  ])
}

fn verilog_ansi_port(direction: v2.std.node.Symbol, name: v2.std.node.Symbol) -> v2.std.node.Node {
  verilog_conj(children: [
    verilog_slot(target: verilog_atom(id: direction)),
    verilog_slot(target: verilog_atom(id: name))
  ])
}

fn verilog_port_list_one(port: v2.std.node.Node) -> v2.std.node.Node {
  verilog_conj(children: [verilog_slot(target: port)])
}

fn verilog_port_list_cons(port: v2.std.node.Node, rest: v2.std.node.Node) -> v2.std.node.Node {
  verilog_conj(children: [verilog_slot(target: port), verilog_slot(target: rest)])
}

fn verilog_continuous_assign(lhs: v2.std.node.Symbol, value: v2.std.node.Node) -> v2.std.node.Node {
  verilog_conj(children: [
    verilog_slot(target: verilog_atom(id: lhs)),
    verilog_slot(target: value)
  ])
}

fn verilog_assign_list_one(assignment: v2.std.node.Node) -> v2.std.node.Node {
  verilog_conj(children: [verilog_slot(target: assignment)])
}

fn verilog_assign_list_cons(assignment: v2.std.node.Node, rest: v2.std.node.Node) -> v2.std.node.Node {
  verilog_conj(children: [verilog_slot(target: assignment), verilog_slot(target: rest)])
}

// THE HEADER PARENTHESES ARE BOUND SLOTS, and that is what lets ONE lexical class serve both the
// port list and an expression. A transform is keyed by token class, so two classes were needed to
// give " (\n" in the header and "(" inside an expression — and two classes lexing the same literal
// would have made reparse ambiguous, since the lexer cannot know which one it is looking at. A
// bound slot takes its spelling from its emitted atom instead, so the header carries its own
// layout and the expression parens stay bare. One class, no lexical ambiguity, same bytes.
fn verilog_module_declaration(name: v2.std.node.Symbol, ports: v2.std.node.Node, assignments: v2.std.node.Node) -> v2.std.node.Node {
  verilog_conj(children: [
    verilog_slot(target: verilog_atom(id: name)),
    verilog_slot(target: verilog_atom(id: ^verilog_header_open)),
    verilog_slot(target: ports),
    verilog_slot(target: verilog_atom(id: ^verilog_header_close)),
    verilog_slot(target: assignments)
  ])
}

fn verilog_emit_layout_transforms() -> Map<v2.std.node.Symbol, fn(String) -> String> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(
        v2.std.collection.map_insert(
          v2.std.collection.map_insert(
            v2.std.collection.map_insert(
              v2.std.collection.map_insert(
                v2.std.collection.map_insert(
                  v2.std.collection.map_insert(v2.std.collection.empty_map(), ^verilog_token_kw_module, fn(s) { concat(s, " ") }),
                  ^verilog_token_kw_wire,
                  fn(s) { concat(s, " ") }
                ),
                ^verilog_token_comma,
                fn(s) { concat(s, "\n") }
              ),
              ^verilog_token_semicolon,
              fn(s) { concat(s, "\n") }
            ),
            ^verilog_token_semicolon,
            fn(s) { concat(s, "\n") }
          ),
          ^verilog_token_kw_wire,
          fn(s) { concat(s, " ") }
        ),
        ^verilog_token_kw_assign,
        fn(s) { concat("  ", concat(s, " ")) }
      ),
      ^verilog_token_equals,
      fn(s) { concat(" ", concat(s, " ")) }
    ),
    ^verilog_token_kw_endmodule,
    fn(s) { concat(s, "\n") }
  )
}

// THE INTERLOCK EXEMPLAR. The binding symbol in a derived row comes from the EMITTED atom
// (FormalBindingConjSlotEmittedAtom reads node_atom_identity_optional on the slot), not from the
// production's binding symbol — the production only says WHICH slot is bound. That is what lets
// four ports share one production and still carry four different names, and it is why one signal
// atom can serve as a port name, an assignment target and an expression reference at once: those
// are the same identity spelled the same way, so forking them would be three names for one thing.
fn verilog_interlock_ports() -> v2.std.node.Node {
  verilog_port_list_cons(
    port: verilog_ansi_port(direction: ^verilog_interlock_dir_input, name: ^verilog_interlock_conditioned_good),
    rest: verilog_port_list_cons(
      port: verilog_ansi_port(direction: ^verilog_interlock_dir_input, name: ^verilog_interlock_fault),
      rest: verilog_port_list_cons(
        port: verilog_ansi_port(direction: ^verilog_interlock_dir_output, name: ^verilog_interlock_power_permit),
        rest: verilog_port_list_one(
          port: verilog_ansi_port(direction: ^verilog_interlock_dir_output, name: ^verilog_interlock_reset_release)
        )
      )
    )
  )
}

fn verilog_interlock_assignments() -> v2.std.node.Node {
  verilog_assign_list_cons(
    assignment: verilog_continuous_assign(
      lhs: ^verilog_interlock_power_permit,
      value: verilog_binary_application(
        left: verilog_signal_reference(name: ^verilog_interlock_conditioned_good),
        operator: ^verilog_interlock_op_and,
        right: verilog_unary_application(
          operator: ^verilog_interlock_op_not,
          operand: verilog_signal_reference(name: ^verilog_interlock_fault)
        )
      )
    ),
    rest: verilog_assign_list_one(
      assignment: verilog_continuous_assign(
        lhs: ^verilog_interlock_reset_release,
        value: verilog_binary_application(
          left: verilog_signal_reference(name: ^verilog_interlock_conditioned_good),
          operator: ^verilog_interlock_op_and,
          right: verilog_signal_reference(name: ^verilog_interlock_power_permit)
        )
      )
    )
  )
}

fn verilog_interlock_emitted() -> v2.std.node.Node {
  verilog_module_declaration(
    name: ^verilog_interlock_module_name,
    ports: verilog_interlock_ports(),
    assignments: verilog_interlock_assignments()
  )
}

// The spellings the bound slots resolve to. The two directions pad to equal width because the
// oracle aligns them; that padding is layout and therefore lives here, on the target, exactly
// like the transforms.
fn verilog_binding_spellings() -> Map<v2.std.node.Symbol, String> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(
        v2.std.collection.map_insert(
          v2.std.collection.map_insert(
            v2.std.collection.map_insert(
              v2.std.collection.map_insert(
                v2.std.collection.map_insert(
                  v2.std.collection.map_insert(
                    v2.std.collection.map_insert(
                      v2.std.collection.map_insert(v2.std.collection.empty_map(), ^verilog_interlock_op_not, "~"),
                      ^verilog_header_open,
                      " (\n"
                    ),
                    ^verilog_header_close,
                    "\n)"
                  ),
                  ^verilog_interlock_module_name,
                  "board_power_interlock"
                ),
              ^verilog_interlock_dir_input,
              "  input  "
            ),
              ^verilog_interlock_dir_output,
              "  output "
            ),
            ^verilog_interlock_conditioned_good,
            "conditioned_good"
          ),
          ^verilog_interlock_fault,
          "fault"
        ),
        ^verilog_interlock_power_permit,
        "power_permit"
      ),
      ^verilog_interlock_reset_release,
      "reset_release"
    ),
    ^verilog_interlock_op_and,
    " & "
  )
}

// THE DERIVED RELATION POPULATION. Nothing here is a hand-authored token list: each row is
// DERIVED from a formal production plus the exemplar slot it corresponds to, which is what makes
// emission the backward reading of the same grammar the parser reads forward. A row whose tokens
// were written out by hand would be the product-local printer wearing a different hat.
fn verilog_relation_row_for_productions(
  productions: List<v2.std.grammar.FormalProduction>,
  lhs: v2.std.node.Symbol,
  emitted: v2.std.node.Node
) -> v2.std.witness.Witness<v2.std.node.Node> {
  match v2.std.grammar.formal_production_for_lhs_exact(productions: productions, lhs: lhs, child: emitted) {
    Holds { value: production } =>
      v2.std.grammar.derive_grammar_relation_row_node(
        production: production,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

// The same population in reverse authoring order. Selection is structural, so this must derive a
// byte-identical row; if it did not, the grammar would be an ordered table pretending to be a
// relation and the first matching row would win.
fn verilog_emission_formal_productions_reversed() -> List<v2.std.grammar.FormalProduction> {
  reverse(verilog_emission_formal_productions())
}

fn verilog_relation_row_for(lhs: v2.std.node.Symbol, emitted: v2.std.node.Node) -> v2.std.witness.Witness<v2.std.node.Node> {
  let productions = verilog_emission_formal_productions()
  match v2.std.grammar.formal_production_for_lhs_exact(productions: productions, lhs: lhs, child: emitted) {
    Holds { value: production } =>
      v2.std.grammar.derive_grammar_relation_row_node(
        production: production,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn verilog_module_relation_row() -> v2.std.witness.Witness<v2.std.node.Node> {
  verilog_relation_row_for(
    lhs: ^verilog_production_ansi_module_decl,
    emitted: verilog_interlock_emitted()
  )
}

fn verilog_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: target }
}

fn verilog_row_or_empty(lhs: v2.std.node.Symbol, emitted: v2.std.node.Node) -> v2.std.node.Node {
  match verilog_relation_row_for(lhs: lhs, emitted: emitted) {
    Holds { value: row } => row
    Violates { diagnostic: _ } => verilog_conj(children: [])
  }
}

// ONE ROW PER PRODUCTION SHAPE, NOT PER OCCURRENCE. Reverse selection matches a row by its
// PRODUCTION against the emitted child (formal_production_matches_lhs_exact_child), not by atom
// identity, so the single ansi_port row serves all four ports and the single binary row serves
// both assignments. Each row is derived from the sub-node of the exemplar that exhibits its
// shape, which is why the exemplar has to contain every shape the profile claims to emit.
fn verilog_first_port() -> v2.std.node.Node {
  verilog_ansi_port(direction: ^verilog_interlock_dir_input, name: ^verilog_interlock_conditioned_good)
}

fn verilog_first_assign() -> v2.std.node.Node {
  verilog_continuous_assign(
    lhs: ^verilog_interlock_power_permit,
    value: verilog_binary_application(
      left: verilog_signal_reference(name: ^verilog_interlock_conditioned_good),
      operator: ^verilog_interlock_op_and,
      right: verilog_unary_application(
        operator: ^verilog_interlock_op_not,
        operand: verilog_signal_reference(name: ^verilog_interlock_fault)
      )
    )
  )
}

fn verilog_emission_translation_rules() -> v2.std.node.Node {
  verilog_conj(children: [
    verilog_named_edge(
      name: ^grammar_relation_rules_formal_productions,
      target: formal_productions_catalog_to_node(productions: verilog_emission_formal_productions())
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_module,
      target: verilog_row_or_empty(lhs: ^verilog_production_ansi_module_decl, emitted: verilog_interlock_emitted())
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_port_list_cons,
      target: verilog_row_or_empty(lhs: ^verilog_production_port_list, emitted: verilog_interlock_ports())
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_port_list_one,
      target: verilog_row_or_empty(
        lhs: ^verilog_production_port_list,
        emitted: verilog_port_list_one(
          port: verilog_ansi_port(direction: ^verilog_interlock_dir_output, name: ^verilog_interlock_reset_release)
        )
      )
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_ansi_port,
      target: verilog_row_or_empty(lhs: ^verilog_production_ansi_port, emitted: verilog_first_port())
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_assign_list_cons,
      target: verilog_row_or_empty(lhs: ^verilog_production_assign_list, emitted: verilog_interlock_assignments())
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_assign_list_one,
      target: verilog_row_or_empty(
        lhs: ^verilog_production_assign_list,
        emitted: verilog_assign_list_one(assignment: verilog_first_assign())
      )
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_continuous_assign,
      target: verilog_row_or_empty(lhs: ^verilog_production_continuous_assign, emitted: verilog_first_assign())
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_expr_signal_reference,
      target: verilog_row_or_empty(
        lhs: ^verilog_production_expr,
        emitted: verilog_signal_reference(name: ^verilog_interlock_conditioned_good)
      )
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_expr_unary,
      target: verilog_row_or_empty(
        lhs: ^verilog_production_expr,
        emitted: verilog_unary_application(
          operator: ^verilog_interlock_op_not,
          operand: verilog_signal_reference(name: ^verilog_interlock_fault)
        )
      )
    ),
    verilog_named_edge(
      name: ^verilog_relation_rule_expr_binary,
      target: verilog_row_or_empty(
        lhs: ^verilog_production_expr,
        emitted: verilog_binary_application(
          left: verilog_signal_reference(name: ^verilog_interlock_conditioned_good),
          operator: ^verilog_interlock_op_and,
          right: verilog_signal_reference(name: ^verilog_interlock_power_permit)
        )
      )
    )
  ])
}

fn verilog_emission_target_model() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    bundle: verilog_conj(children: [
      verilog_named_edge(
        name: ^target_model_edge_translation_rules,
        target: verilog_emission_translation_rules()
      )
    ]),
    lex: verilog_lex(),
    binding_spellings: verilog_binding_spellings(),
    token_class_emit_transforms: verilog_emit_layout_transforms(),
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured,
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired
  }
}

// EMISSION DERIVES ITS ROW FROM THE PROGRAM BEING EMITTED. Row derivation walks the emitted tree
// and INLINES the tokens of every nested nonterminal, so a derived row already carries the whole
// program's token sequence; serialization then replays it. That means the rules population is not
// a fixed language table that different programs select from — selecting a row derived from some
// other program replays THAT program. The composition is real, and it happens at derivation.
fn verilog_target_model_with_single_row(row: v2.std.node.Node) -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    bundle: verilog_conj(children: [
      verilog_named_edge(
        name: ^target_model_edge_translation_rules,
        target: verilog_conj(children: [
          verilog_named_edge(
            name: ^grammar_relation_rules_formal_productions,
            target: formal_productions_catalog_to_node(productions: verilog_emission_formal_productions())
          ),
          verilog_named_edge(name: ^verilog_relation_rule_program, target: row)
        ])
      )
    ]),
    lex: verilog_lex(),
    binding_spellings: verilog_binding_spellings(),
    token_class_emit_transforms: verilog_emit_layout_transforms(),
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured,
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired
  }
}

// WHAT A VERILOG IDENTIFIER MAY BE. This is a fact about Verilog, so it lives with Verilog. It
// sat in product.compute_board, which meant a board module carried the language's reserved-word
// roster and its punctuation set — the second Verilog authority this lane exists to remove. A
// second target consuming this grammar gets the same admission for free rather than re-deriving
// it from the same specification.
data verilog_reserved_words: List<String> = [
  "module", "endmodule", "input", "output", "inout", "wire", "reg", "assign",
  "always", "initial", "begin", "end", "if", "else", "case", "endcase",
  "posedge", "negedge", "parameter", "localparam", "function", "endfunction",
  "integer", "real", "time", "genvar", "generate", "endgenerate", "task", "endtask",
]

data verilog_forbidden_identifier_characters: List<String> = [
  " ", "\t", "\n", "-", ".", ",", ";", ":", "(", ")", "[", "]", "{", "}",
  "\"", "'", "/", "\\", "+", "*", "&", "|", "~", "^", "%", "!", "=", "<", ">",
  "?", "#", "@", "`",
]

fn verilog_identifier_is_reserved(spelling: String) -> Bool {
  fold(verilog_reserved_words, init: false, f: fn(acc, w) { acc || w == spelling })
}

fn verilog_identifier_contains_forbidden(spelling: String) -> Bool {
  fold(verilog_forbidden_identifier_characters, init: false, f: fn(acc, ch) {
    acc || std.types.list_length(items: split(s: spelling, delimiter: ch)) > 1
  })
}

fn verilog_identifier_is_admissible(spelling: String) -> Bool {
  spelling != ""
    && !verilog_identifier_is_reserved(spelling: spelling)
    && !verilog_identifier_contains_forbidden(spelling: spelling)
}

// THE TARGET-OWNED SPELLINGS EVERY VERILOG PROGRAM SHARES: the two port directions and the three
// boolean operators. A product supplies the spellings for ITS identifiers and merges them over
// these, so no consumer has to know that "input" is padded to align with "output" or that the
// conjunction renders with surrounding spaces. Those are layout decisions and they stay here.
fn verilog_base_spellings() -> Map<v2.std.node.Symbol, String> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(
        v2.std.collection.map_insert(
          v2.std.collection.map_insert(
            v2.std.collection.map_insert(
              v2.std.collection.map_insert(v2.std.collection.empty_map(), ^verilog_header_open, " (\n"),
              ^verilog_header_close,
              "\n)"
            ),
            ^verilog_dir_input,
            "  input  "
          ),
          ^verilog_dir_output,
          "  output "
        ),
        ^verilog_op_and,
        " & "
      ),
      ^verilog_op_or,
      " | "
    ),
    ^verilog_op_not,
    "~"
  )
}

fn verilog_emission_rules_for_row(row: v2.std.node.Node) -> v2.std.node.Node {
  verilog_conj(children: [
    verilog_named_edge(
      name: ^grammar_relation_rules_formal_productions,
      target: formal_productions_catalog_to_node(productions: verilog_emission_formal_productions())
    ),
    verilog_named_edge(name: ^verilog_relation_rule_program, target: row)
  ])
}

fn verilog_target_model_for(row: v2.std.node.Node, spellings: Map<v2.std.node.Symbol, String>) -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    bundle: verilog_conj(children: [
      verilog_named_edge(
        name: ^target_model_edge_translation_rules,
        target: verilog_conj(children: [
          verilog_named_edge(
            name: ^grammar_relation_rules_formal_productions,
            target: formal_productions_catalog_to_node(productions: verilog_emission_formal_productions())
          ),
          verilog_named_edge(name: ^verilog_relation_rule_program, target: row)
        ])
      )
    ]),
    lex: verilog_lex(),
    binding_spellings: spellings,
    token_class_emit_transforms: verilog_emit_layout_transforms(),
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured,
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired
  }
}

// EMIT A MODULE. This is the whole target surface a product needs: hand it a module node and a
// spelling map, get bytes or a typed refusal. Deriving the row from the node being emitted is
// what makes this compositional rather than a replay of some exemplar.
type VerilogEmission
  = VerilogEmitted { source: String }
  | VerilogEmissionRefused { reason: v2.std.node.Symbol }

fn verilog_emit_module(module_node: v2.std.node.Node, spellings: Map<v2.std.node.Symbol, String>) -> VerilogEmission {
  match verilog_relation_row_for(lhs: ^verilog_production_ansi_module_decl, emitted: module_node) {
    Holds { value: row } =>
      match v2.compiler.translate.target_serialize_relation_row_from_model_bounded(
        4096,
        verilog_target_model_for(row: row, spellings: spellings),
        module_node
      ) {
        Accepted { value: text, diagnostics: _ } => VerilogEmitted { source: v2.std.compilers.target_model.render_target_text(t: text) }
        Rejected { diagnostics: d } => VerilogEmissionRefused { reason: d.head.reason }
      }
    Violates { diagnostic: d } => VerilogEmissionRefused { reason: d.reason }
  }
}

fn verilog_ingest_grammar_schema() -> v2.std.grammar.GrammarSchema {
  v2.std.grammar.GrammarSchema {
    lex: verilog_lex(),
    grammar: verilog_grammar()
  }
}

fn verilog_ingest_grammar_probe() -> v2.std.grammar.GrammarSchemaProbeBinding {
  v2.std.grammar.GrammarSchemaProbeBinding {
    schema: verilog_ingest_grammar_schema(),
    probe: v2.std.grammar.GrammarSchemaProbe {
      fixture: "module m; endmodule",
      production: verilog_source_text_module_formal_production(),
      expected_parse_surface: v2.std.grammar.grammar_atom(identity: ^verilog_surface_module_decl)
    }
  }
}
