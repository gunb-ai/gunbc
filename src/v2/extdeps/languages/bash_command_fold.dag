      grammar_formal_terminal(identity: ^bash_token_stmt_exit_kw),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

fn bash_fold_assign_rhs(value_word_kind: Symbol) -> List<FormalGrammarSymbol> {
  [
    bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_assign),
    grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
    grammar_formal_terminal(identity: ^bash_token_assign_eq),
    grammar_formal_nonterminal_occurrence(identity: value_word_kind)
  ]
}

fn bash_fold_operand_assign_lit_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_operand,
    rhs: bash_fold_assign_rhs(value_word_kind: ^bash_production_fold_lit_word)
  )
}

fn bash_fold_operand_assign_double_quoted_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_operand,
    rhs: bash_fold_assign_rhs(value_word_kind: ^bash_production_fold_double_quoted_word)
  )
}

