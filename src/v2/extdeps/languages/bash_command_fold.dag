fn bash_fold_assign_cmdsubst_top_production() -> FormalProduction {
  bash_fold_top_level_production(
    binding: ^bash_production_fold_assign,
    rule_rhs: bash_fold_assign_rhs(value_word_kind: ^bash_production_fold_cmdsubst_word)
  )
}

fn bash_fold_subshell_top_production() -> FormalProduction {
  bash_fold_top_level_production(
    binding: ^bash_production_fold_subshell,
    rule_rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_subshell),
      grammar_formal_terminal(identity: ^bash_token_subshell_open),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_stmt_list),
      grammar_formal_terminal(identity: ^bash_token_subshell_close)
    ]
  )
}

fn bash_fold_if_top_production() -> FormalProduction {
  bash_fold_top_level_production(
    binding: ^bash_production_fold_if,
    rule_rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_if),
      grammar_formal_terminal(identity: ^bash_token_if_kw),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand),
      grammar_formal_terminal(identity: ^bash_token_if_then),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_stmt_list),
      grammar_formal_terminal(identity: ^bash_token_if_fi)
    ]
  )
}

fn bash_fold_list_stmt_productions() -> List<FormalProduction> {
  [
    bash_fold_and_then_top_production(),
    bash_fold_or_else_top_production(),
    bash_fold_pipe_top_production(),
    bash_fold_subshell_top_production(),
    bash_fold_if_top_production()
  ]
}

fn bash_fold_formal_productions() -> List<FormalProduction> {
  list_append(
    list_append(
      list_append(
        list_append(
          list_append(
            bash_fold_word_leaf_productions(),
            bash_fold_word_compound_productions()
          ),
          bash_fold_concat_parts_productions()
        ),
        list_append(
          bash_fold_command_words_leaf_productions(),
          bash_fold_command_words_list_productions()
        )
      ),
      list_append(
        bash_fold_stmt_list_leaf_productions(),
        bash_fold_stmt_list_pair_productions()
      )
    ),
    list_append(
      list_append(
        [
          bash_fold_command_top_production(),
          bash_fold_exit_top_production(),
          bash_fold_assign_lit_top_production(),
          bash_fold_assign_var_top_production(),
          bash_fold_assign_concat_top_production(),
          bash_fold_assign_cmdsubst_top_production()
        ],
        list_append(
          bash_fold_list_stmt_productions(),
          bash_fold_with_redir_productions()
        )
      ),
      bash_fold_operand_productions()
    )
  )
}

// THE FOLD'S GRAMMAR IS ONE VALUE, BUILT ONCE AND CARRIED TO EVERY LEAF. The production catalog,
// its encoding as a catalog node, the lex rules and the emit transforms are the same for every word
// and command this fold serializes; only the relation row depends on the emitted node. Rebuilding
// them inside each leaf re-derived a constant once per command, so the cost of a script grew with
// its command count rather than its bytes (re-derive with claim_batch eval_steps over
// gunbc.live_deploy.emit approval_broker_dark_install_script). Declared once here, a leaf's own work
// is the row and the serialization of its tokens.
data bash_fold_formal_production_catalog: List<FormalProduction> = bash_fold_formal_productions()

data bash_fold_formal_production_catalog_node: Node = formal_productions_catalog_to_node(
  productions: bash_fold_formal_production_catalog
)

data bash_fold_lex_carried: LexRules = bash_fold_lex()

data bash_fold_binding_spellings_carried: Map<Symbol, String> = bash_fold_binding_spellings()

data bash_fold_emit_transforms_carried: Map<Symbol, TokenClassEmitTransform> = bash_fold_emit_transforms()

fn bash_fold_translation_rules_node_for_row(row: Node, rule_name: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^grammar_relation_rules_formal_productions,
        target: bash_fold_formal_production_catalog_node
      ),
      bash_named_edge(
        name: rule_name,
        target: row
      )
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

// THE SERIALIZER'S RECURSION BUDGET FOR ONE ROW'S RULES, from the carried catalog count. It is the
// subtree count of bash_fold_translation_rules_node_for_row(row) -- the rules root, the catalog node
// and the row -- which this module builds and so can count without walking the catalog per leaf;
// test.claim.bash_command_fold_carried_catalog pins the two equal over real rows.
data bash_fold_formal_production_catalog_subtree_count: Int = node_subtree_count(
  n: bash_fold_formal_production_catalog_node
)

fn bash_fold_translation_rules_budget_for_row(row: Node) -> Int {
  1 + bash_fold_formal_production_catalog_subtree_count + node_subtree_count(n: row)
}

fn bash_fold_relation_row_witness(emitted: Node, lhs: Symbol) -> Witness<Node> {
  derive_grammar_relation_row_for_lhs(productions: bash_fold_formal_production_catalog, lhs: lhs, emitted: emitted)
}

fn bash_fold_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: chars(s: text) }
  }
}

data bash_fold_stmt_kind_sentinel: String = "\u{0002}"
data bash_fold_word_lit_sentinel: String = "\u{0000}"
data bash_fold_word_var_sentinel: String = "\u{0001}"
data bash_fold_word_concat_sentinel: String = "\u{0003}"
data bash_fold_word_cmdsubst_sentinel: String = "\u{0004}"

fn bash_fold_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      bash_fold_lex_rule(token_class: ^bash_token_word_sep, text: " "),
      bash_fold_lex_rule(token_class: ^bash_token_stmt_exit_kw, text: "exit "),
      bash_fold_lex_rule(token_class: ^bash_token_assign_eq, text: "="),
      bash_fold_lex_rule(token_class: ^bash_token_and_then, text: " && "),
      bash_fold_lex_rule(token_class: ^bash_token_or_else, text: " || "),
      bash_fold_lex_rule(token_class: ^bash_token_pipe, text: " | "),
      bash_fold_lex_rule(token_class: ^bash_token_subshell_open, text: "("),
      bash_fold_lex_rule(token_class: ^bash_token_subshell_close, text: ")"),
      bash_fold_lex_rule(token_class: ^bash_token_stmt_sep, text: "; "),
      bash_fold_lex_rule(token_class: ^bash_token_if_kw, text: "if "),
      bash_fold_lex_rule(token_class: ^bash_token_if_then, text: "; then "),
      bash_fold_lex_rule(token_class: ^bash_token_if_fi, text: "; fi"),
      bash_fold_lex_rule(token_class: ^bash_fold_stmt_kind_tag, text: bash_fold_stmt_kind_sentinel),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_lit, text: bash_fold_word_lit_sentinel),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_var, text: bash_fold_word_var_sentinel),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_concat, text: bash_fold_word_concat_sentinel),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_cmdsubst, text: bash_fold_word_cmdsubst_sentinel),
      bash_fold_lex_rule(token_class: ^bash_fold_cmdsubst_open, text: "$("),
      bash_fold_lex_rule(token_class: ^bash_fold_cmdsubst_close, text: ")"),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_stderr_null, text: " 2>/dev/null"),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_stdout_and_stderr_null, text: " >/dev/null 2>&1"),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_stdout_null, text: " >/dev/null"),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_stdout_to_stderr, text: " >&2"),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_to_file, text: " > "),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_stderr_to_file, text: " 2> ")
    ],
    modes: []
  }
}

fn bash_fold_lex() -> LexRules {
  ModeledLexRules { root: bash_fold_lex_rules() }
}

// INGEST-direction lex view. §4 asymmetry — ingest RECOGNIZES a superset of what emit PRODUCES.
// Recognized-but-UNMODELED control keywords (no production); presence marks an incompletely-modeled
// control form => AmbiguousParse, never Violation. Emit set (bash_fold_lex_rules) UNCHANGED so emit
// stays byte-identical. Word boundaries ride the spelling (trailing/leading space; done/esac
// terminal; do carries a REQUIRED leading space so at the d of done its spelling is never a prefix
// candidate — do and done do not collide at one start position, so no maximal-munch arbitration is
// needed). newline reuses existing separator class bash_token_orch_seq_newline (bash.dag:1184).

fn bash_ingest_only_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_for, text: "for "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_do, text: " do"),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_done, text: "done"),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_while, text: "while "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_until, text: "until "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_select, text: "select "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_case, text: "case "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_esac, text: "esac"),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_case_clause_sep, text: ";;"),
      bash_fold_lex_rule(token_class: ^bash_ingest_brace_open, text: "{ "),
      bash_fold_lex_rule(token_class: ^bash_ingest_brace_close, text: "; }"),
      bash_fold_lex_rule(token_class: ^bash_token_orch_seq_newline, text: "\n")
    ],
    modes: []
  }
}

fn bash_ingest_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: list_append(
      left: bash_fold_lex_rules().rules,
      right: bash_ingest_only_lex_rules().rules
    ),
    modes: []
  }
}

fn bash_fold_emit_transforms() -> Map<Symbol, TokenClassEmitTransform> {
  let m0 = bash_token_class_emit_transforms_carried
  let m1 = map_insert(m0, ^bash_fold_word_kind_lit, EmitSpellingConstant { value: "" })
  let m2 = map_insert(m1, ^bash_fold_word_kind_var, EmitSpellingConstant { value: "" })
  let m3 = map_insert(m2, ^bash_fold_stmt_kind_tag, EmitSpellingConstant { value: "" })
  let m4 = map_insert(m3, ^bash_fold_word_kind_concat, EmitSpellingConstant { value: "" })
  let m5 = map_insert(m4, ^bash_fold_word_kind_cmdsubst, EmitSpellingConstant { value: "" })
  map_insert(m5, ^bash_token_orch_raw, EmitSpellingIdentity)
}

fn bash_fold_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^bash_fold_word_kind_lit, "")
  map_insert(m0, ^bash_fold_word_kind_var, "")
}

// THE TARGET MODEL OF ONE ALREADY-DERIVED ROW. The serialize source and the translation rules are
// both spelled from the row the caller holds, so the row is derived once per leaf rather than once
// per consumer of it.
fn bash_fold_target_model_for_row(
  row: Node,
  source_literal: Symbol,
  source_text: String,
  production_binding: Symbol,
  rule_name: Symbol
) -> Witness<TargetModel> {
  Holds {
    value: target_model_make_with_emit_transforms(
      bundle: bash_target_model_bundle(
        rules: bash_fold_translation_rules_node_for_row(row: row, rule_name: rule_name)),
      lex: bash_fold_lex_carried,
      binding_spellings: bash_fold_binding_spellings_carried,
      token_class_emit_transforms: bash_fold_emit_transforms_carried,
      authority_source_text: source_text,
      runtime_row: target_emit_host_runtime_row_unconfigured
    )
  }
}

fn bash_fold_target_model_for_emitted_witness(
  emitted: Node,
  source_literal: Symbol,
  source_text: String,
  production_binding: Symbol,
  rule_name: Symbol
) -> Witness<TargetModel> {
  match bash_fold_relation_row_witness(emitted: emitted, lhs: production_binding) {
    Holds { value: row } =>
      bash_fold_target_model_for_row(
        row: row,
        source_literal: source_literal,
        source_text: source_text,
        production_binding: production_binding,
        rule_name: rule_name
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_raw_line_target_model(text: String) -> TargetModel {
  bash_word_pass_target_model(spelling: text)
}

fn bash_fold_negation_target_model(inner_spelling: String) -> TargetModel {
  bash_stmt_negation_target_model(inner: inner_spelling)
}

fn bash_fold_env_prefixed_target_model(
  name: String,
  value_spelling: String,
  command_spelling: String
) -> TargetModel {
  bash_stmt_env_prefixed_target_model(
    name: name,
    value: value_spelling,
    command: command_spelling
  )
}

fn bash_fold_with_redir_target_model(stmt_spelling: String, redir_spelling: String) -> TargetModel {
  bash_stmt_with_redir_target_model(stmt: stmt_spelling, redir: redir_spelling)
}

fn bash_fold_heredoc_target_model(path_spelling: String, delimiter: String, body: String) -> TargetModel {
  bash_stmt_heredoc_target_model(path: path_spelling, delimiter: delimiter, body: body)
}

fn bash_fold_with_redir_wrong_target_model_witness() -> Witness<TargetModel> {
  Holds {
    value: bash_fold_with_redir_target_model(
      stmt_spelling: "'true'",
      redir_spelling: ">/dev/null 2>&1"
    )
  }
}

fn bash_fold_heredoc_wrong_target_model_witness() -> Witness<TargetModel> {
  Holds {
    value: bash_fold_heredoc_target_model(
      path_spelling: "'out'",
      delimiter: "EOF",
      body: "world"
    )
  }
}

fn bash_fold_raw_line_wrong_target_model_witness() -> Witness<TargetModel> {
  Holds {
    value: bash_fold_raw_line_target_model(text: "wrong")
  }
}

fn bash_fold_negation_wrong_target_model_witness() -> Witness<TargetModel> {
  Holds {
    value: bash_fold_negation_target_model(inner_spelling: "(true)")
  }
}

fn bash_fold_env_prefixed_wrong_target_model_witness() -> Witness<TargetModel> {
  Holds {
    value: bash_fold_env_prefixed_target_model(
      name: "TMPDIR",
      value_spelling: "'/x'",
      command_spelling: "'true'"
    )
  }
}

data bash_fold_cmd_true_wrong_emitted: Node = bash_build_command(
  words: bash_build_command_words_single(
    word: bash_build_word_lit(text: "echo")
  )
)

data bash_fold_exit_42_emitted: Node = bash_build_exit(code: "42")

data bash_fold_exit_wrong_emitted: Node = bash_build_exit(code: "0")

data bash_fold_assign_foo_bar_emitted: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: bash_build_stmt_tag(binding: ^bash_production_fold_assign)
    },
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: "FOO" } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    },
    Edge {
      label: Positional,
      target: bash_build_word_lit(text: "bar")
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

data bash_fold_assign_x_home_emitted: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: bash_build_stmt_tag(binding: ^bash_production_fold_assign)
    },
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: "X" } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    },
    Edge {
      label: Positional,
      target: bash_build_word_var(name: "HOME")
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

data bash_fold_assign_wrong_emitted: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: bash_build_stmt_tag(binding: ^bash_production_fold_assign)
    },
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: "FOO" } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    },
    Edge {
      label: Positional,
      target: bash_build_word_lit(text: "baz")
    }
  ],
  occurrence_id: OccurrenceSynthetic
}

fn bash_fold_cmd_true_wrong_target_model_witness() -> Witness<TargetModel> {
  bash_fold_target_model_for_emitted_witness(
    emitted: bash_fold_cmd_true_wrong_emitted,
    source_literal: ^bash_fold_cmd_true_wrong_source_literal,
    source_text: "'echo'",
    production_binding: ^bash_production_fold_command,
    rule_name: ^bash_relation_rule_fold_command
  )
}

fn bash_fold_exit_wrong_target_model_witness() -> Witness<TargetModel> {
  bash_fold_target_model_for_emitted_witness(
    emitted: bash_fold_exit_wrong_emitted,
    source_literal: ^bash_fold_exit_wrong_source_literal,
    source_text: "exit 0",
    production_binding: ^bash_production_fold_exit,
    rule_name: ^bash_relation_rule_fold_exit
  )
}

fn bash_fold_assign_wrong_target_model_witness() -> Witness<TargetModel> {
  bash_fold_target_model_for_emitted_witness(
    emitted: bash_fold_assign_wrong_emitted,
    source_literal: ^bash_fold_assign_wrong_source_literal,
    source_text: "FOO='baz'",
    production_binding: ^bash_production_fold_assign,
    rule_name: ^bash_relation_rule_fold_assign
  )
}

fn bash_fold_and_then_wrong_target_model_witness() -> Witness<TargetModel> {
  bash_fold_target_model_for_emitted_witness(
    emitted: bash_fold_and_then_true_false_emitted,
    source_literal: ^bash_fold_and_then_wrong_source_literal,
    source_text: "'true' || 'false'",
    production_binding: ^bash_production_fold_or_else,
    rule_name: ^bash_relation_rule_fold_or_else
  )
}

fn bash_fold_pipe_wrong_target_model_witness() -> Witness<TargetModel> {
  bash_fold_target_model_for_emitted_witness(
    emitted: bash_fold_pipe_echo_hi_wc_emitted,
    source_literal: ^bash_fold_pipe_wrong_source_literal,
    source_text: "'echo' 'hi' && 'wc' '-c'",
    production_binding: ^bash_production_fold_and_then,
    rule_name: ^bash_relation_rule_fold_and_then
  )
}
