fn bash_fold_top_level_production(binding: Symbol, rule_rhs: List<FormalGrammarSymbol>) -> FormalProduction {
  grammar_formal_production(lhs: binding, rhs: rule_rhs)
}

fn bash_fold_and_then_top_production() -> FormalProduction {
  bash_fold_top_level_production(
    binding: ^bash_production_fold_and_then,
    rule_rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_and_then),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand),
      grammar_formal_terminal(identity: ^bash_token_and_then),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand)
