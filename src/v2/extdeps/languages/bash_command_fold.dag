fn bash_fold_with_redir_file_rhs(redir_binding: Symbol, redir_token: Symbol, path_word_kind: Symbol) -> List<FormalGrammarSymbol> {
  [
    bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_with_redir),
    grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand),
    bash_fold_stmt_kind_tag_terminal(binding: redir_binding),
    grammar_formal_terminal(identity: redir_token),
    grammar_formal_nonterminal_occurrence(identity: path_word_kind)
  ]
}

fn bash_fold_with_redir_rhs_alternatives() -> List<List<FormalGrammarSymbol>> {
  [
    bash_fold_with_redir_fixed_rhs(
      redir_binding: ^bash_production_fold_redir_stderr_null,
      redir_token: ^bash_fold_redir_stderr_null
    ),
    bash_fold_with_redir_fixed_rhs(
      redir_binding: ^bash_production_fold_redir_stdout_and_stderr_null,
      redir_token: ^bash_fold_redir_stdout_and_stderr_null
    ),
    bash_fold_with_redir_fixed_rhs(
      redir_binding: ^bash_production_fold_redir_stdout_null,
      redir_token: ^bash_fold_redir_stdout_null
    ),
    bash_fold_with_redir_fixed_rhs(
      redir_binding: ^bash_production_fold_redir_stdout_to_stderr,
      redir_token: ^bash_fold_redir_stdout_to_stderr
    ),
    bash_fold_with_redir_to_file_rhs(path_word_kind: ^bash_production_fold_lit_word),
    bash_fold_with_redir_to_file_rhs(path_word_kind: ^bash_production_fold_var_word),
    bash_fold_with_redir_stderr_to_file_rhs(path_word_kind: ^bash_production_fold_lit_word),
    bash_fold_with_redir_stderr_to_file_rhs(path_word_kind: ^bash_production_fold_var_word)
  ]
}

fn bash_fold_with_redir_productions() -> List<FormalProduction> {
  list_append(
    list_map(xs: bash_fold_with_redir_rhs_alternatives(), f: fn(rhs) {
      grammar_formal_production(lhs: ^bash_production_fold_with_redir, rhs: rhs)
    }),
    list_map(xs: bash_fold_with_redir_rhs_alternatives(), f: fn(rhs) {
      grammar_formal_production(lhs: ^bash_production_fold_operand, rhs: rhs)
    })
  )
}

