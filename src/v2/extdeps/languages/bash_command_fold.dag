data bash_fold_diagnostic_anchor: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: OccurrenceSynthetic
}

fn bash_fold_stmt_kind_tag_terminal(binding: Symbol) -> FormalGrammarSymbol {
  grammar_formal_terminal_bound(
    identity: ^bash_fold_stmt_kind_tag,
    binding: binding
  )
}

fn bash_fold_unsupported_variant_diagnostic(variant: Symbol) -> Diagnostic {
  Diagnostic {
    reason: variant,
    at: node_locus(node: bash_fold_diagnostic_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn bash_fold_serialize_refused(variant: Symbol) -> Outcome<String> {
  Rejected {
    diagnostics: diagnostics_singleton(
      d: bash_fold_unsupported_variant_diagnostic(variant: variant)
    )
  }
}

fn bash_fold_delegated_needs_component_spellings_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^bash_fold_delegated_target_needs_component_spellings,
    at: node_locus(node: bash_fold_diagnostic_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

data bash_fold_cmd_true_emitted: Node = bash_build_command(
  words: bash_build_command_words_single(
    word: bash_build_word_lit(text: "true")
  )
)

data bash_fold_cmd_echo_hi_emitted: Node = bash_build_command(
  words: bash_build_command_words_pair(
    left: bash_build_command_words_single(
      word: bash_build_word_lit(text: "echo")
    ),
    right: bash_build_word_lit(text: "hi")
  )
)

data bash_fold_cmd_var_x_emitted: Node = bash_build_command(
  words: bash_build_command_words_single(
    word: bash_build_word_var(name: "X")
  )
)

data bash_fold_cmd_false_emitted: Node = bash_build_command(
  words: bash_build_command_words_single(
    word: bash_build_word_lit(text: "false")
  )
)

data bash_fold_cmd_wc_minus_c_emitted: Node = bash_build_command(
  words: bash_build_command_words_pair(
    left: bash_build_command_words_single(
      word: bash_build_word_lit(text: "wc")
    ),
    right: bash_build_word_lit(text: "-c")
  )
)

data bash_fold_and_then_true_false_emitted: Node = bash_build_and_then(
  left: bash_fold_cmd_true_emitted,
  right: bash_fold_cmd_false_emitted
)

data bash_fold_pipe_echo_hi_wc_emitted: Node = bash_build_pipe(
  left: bash_fold_cmd_echo_hi_emitted,
  right: bash_fold_cmd_wc_minus_c_emitted
)


fn bash_fold_word_compound_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_word,
      rhs: [
        grammar_formal_terminal_bound(identity: ^bash_fold_word_kind_concat, binding: ^bash_fold_word_kind_concat),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_concat_parts)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_cmdsubst_word,
      rhs: [
        grammar_formal_terminal_bound(identity: ^bash_fold_word_kind_cmdsubst, binding: ^bash_fold_word_kind_cmdsubst),
        grammar_formal_terminal(identity: ^bash_fold_cmdsubst_open),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand),
        grammar_formal_terminal(identity: ^bash_fold_cmdsubst_close)
      ]
    )
  ]
}

// The word kinds the grammar admits as words in their own right. A quoted
// variable is not one of them: `"$X"` is `double_quoted_word` over one
// `var_bare_word`, so it arrives through the double-quoted row and nothing here
// has to know that variables exist.
fn bash_fold_word_leaf_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_lit_word,
      rhs: [
        grammar_formal_terminal_bound(identity: ^bash_fold_word_kind_lit, binding: ^bash_fold_word_kind_lit),
        grammar_formal_terminal_free(identity: ^bash_token_lit)
      ]
    )
  ]
}

fn bash_fold_concat_parts_leaf_production(word_kind: Symbol) -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_concat_parts,
    rhs: [grammar_formal_nonterminal_occurrence(identity: word_kind)]
  )
}

fn bash_fold_concat_parts_pair_production(word_kind: Symbol) -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_concat_parts,
    rhs: [
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_concat_parts),
      grammar_formal_nonterminal_occurrence(identity: word_kind)
    ]
  )
}

fn bash_fold_concat_parts_productions() -> List<FormalProduction> {
  [
    bash_fold_concat_parts_leaf_production(word_kind: ^bash_production_fold_lit_word),
    bash_fold_concat_parts_leaf_production(word_kind: ^bash_production_fold_concat_word),
    bash_fold_concat_parts_leaf_production(word_kind: ^bash_production_fold_cmdsubst_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_lit_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_concat_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_cmdsubst_word)
  ]
}

fn bash_fold_command_words_leaf_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_lit_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_concat_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_cmdsubst_word)]
    )
  ]
}

fn bash_fold_command_words_list_production(word_kind: Symbol) -> FormalProduction {
