  bash_fold_target_model_for_emitted_witness(
    emitted: bash_fold_pipe_echo_hi_wc_emitted,
    source_literal: ^bash_fold_pipe_wrong_source_literal,
    source_text: "'echo' 'hi' && 'wc' '-c'",
