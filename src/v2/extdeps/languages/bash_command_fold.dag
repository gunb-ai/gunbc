}

fn bash_fold_case_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_case,
    rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_case),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand),
      grammar_formal_terminal(identity: ^bash_ingest_case_in_kw),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_list),
      grammar_formal_terminal(identity: ^bash_ingest_case_arm_newline),
      grammar_formal_terminal(identity: ^bash_ingest_kw_esac)
    ]
