module v2.extdeps.languages.bash_command_fold

import extdeps.languages.bash.program {
  AndOr,
  AndOrOp,
  AndThen,
  Assign,
  Command,
  Exit,
  If,
  Lit,
  OrElse,
  Pipe,
  ShellStmt,
  ShellWord,
  Subshell,
  VarRef,
  serialize_stmt
}
import v2.extdeps.languages.bash {
  bash_named_edge,
  bash_token_class_emit_transforms,
  bash_target_model_bundle,
  bash_word_atom
}
import v2.std.algebra { list_append }
import v2.std.collection {
  Absent,
  List,
  Map,
  Present,
  empty_map,
  list_at_optional,
  list_nth,
  map_insert
}
import v2.std.compilers.lexing {
  LexRule,
  LexRuleSet,
  LexRules,
  LiteralPattern,
  ModeledLexRules,
  TokenRule
}
import v2.std.compilers.target_model {
  TargetModel,
  target_model_make_with_emit_transforms
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.node_query { find_named_child }
import v2.std.grammar {
  FormalGrammarSymbol,
  FormalProduction,
  derive_grammar_relation_row_node,
  formal_production_for_lhs_exact,
  formal_productions_catalog_to_node,
  grammar_formal_nonterminal_occurrence,
  grammar_formal_production,
  grammar_formal_terminal,
  grammar_formal_terminal_bound,
  grammar_formal_terminal_free
}
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.witness { Holds, Violates, Witness }

fn bash_fold_word_kinded_emitted(kind: Symbol, value: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: kind } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: value } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_word_lit_emitted(text: String) -> Node {
  bash_fold_word_kinded_emitted(kind: ^bash_fold_word_kind_lit, value: text)
}

fn bash_fold_word_var_emitted(name: String) -> Node {
  bash_fold_word_kinded_emitted(kind: ^bash_fold_word_kind_var, value: name)
}

fn bash_fold_stmt_tag(binding: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: binding } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_stmt_kind_tag_terminal(binding: Symbol) -> FormalGrammarSymbol {
  grammar_formal_terminal_bound(
    identity: ^bash_fold_stmt_kind_tag,
    binding: binding
  )
}

data bash_fold_diagnostic_anchor: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn bash_fold_unsupported_variant_diagnostic(variant: Symbol) -> Diagnostic {
  Diagnostic {
    reason: variant,
    at: node_locus(node: bash_fold_diagnostic_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn bash_fold_word_emitted_witness(w: ShellWord) -> Witness<Node> {
  match w {
    Lit { text: t } => Holds { value: bash_fold_word_lit_emitted(text: t) }
    VarRef { name: n } => Holds { value: bash_fold_word_var_emitted(name: n) }
    Concat { parts: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_word_concat) }
    CmdSubst { body: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_word_cmdsubst) }
    Raw { text: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_word_raw) }
  }
}

fn bash_fold_command_words_single_emitted(word: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: word }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_command_words_pair_emitted(left: Node, right: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: left },
      Edge { label: Positional, target: right }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_command_emitted(words: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: bash_fold_stmt_tag(binding: ^bash_production_fold_command)
      },
      Edge { label: Positional, target: words }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_words_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^bash_fold_words_empty,
    at: node_locus(node: bash_fold_diagnostic_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn bash_fold_command_words_emitted_from_list_suffix_witness(
  words: List<ShellWord>,
  accumulated: Node,
  index: Int
) -> Witness<Node> {
  match list_at_optional(xs: words, index: index) {
    Present { value: w } =>
      match bash_fold_word_emitted_witness(w: w) {
        Holds { value: word_node } =>
          bash_fold_command_words_emitted_from_list_suffix_witness(
            words: words,
            accumulated: bash_fold_command_words_pair_emitted(
              left: accumulated,
              right: word_node
            ),
            index: index + 1
          )
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Absent => Holds { value: accumulated }
  }
}

fn bash_fold_command_words_emitted_witness(words: List<ShellWord>) -> Witness<Node> {
  match list_nth(xs: words, wanted: 0, absent: bash_fold_words_absent_diagnostic()) {
    Holds { value: w0 } =>
      match bash_fold_word_emitted_witness(w: w0) {
        Holds { value: word0 } =>
          bash_fold_command_words_emitted_from_list_suffix_witness(
            words: words,
            accumulated: bash_fold_command_words_single_emitted(word: word0),
            index: 1
          )
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_exit_emitted(code: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: bash_fold_stmt_tag(binding: ^bash_production_fold_exit)
      },
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: code } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_assign_emitted_witness(name: String, value: ShellWord) -> Witness<Node> {
  match bash_fold_word_emitted_witness(w: value) {
    Holds { value: word_node } =>
      Holds {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Positional,
              target: bash_fold_stmt_tag(binding: ^bash_production_fold_assign)
            },
            Edge {
              label: Positional,
              target: Node {
                kind: TypeNode { connective: Atom { identity: name } },
                children: [],
                occurrence_id: SyntheticOccurrence
              }
            },
            Edge { label: Positional, target: word_node }
          ],
          occurrence_id: SyntheticOccurrence
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

type BashFoldStmtBundle {
  production_binding: Symbol
  relation_rule: Symbol
  emitted: Node
}

fn bash_fold_binary_stmt_emitted_witness(
  binding: Symbol,
  left: ShellStmt,
  right: ShellStmt
) -> Witness<Node> {
  match bash_fold_stmt_emitted_witness(stmt: left) {
    Holds { value: left_emitted } =>
      match bash_fold_stmt_emitted_witness(stmt: right) {
        Holds { value: right_emitted } =>
          Holds {
            value: Node {
              kind: TypeNode { connective: Conj },
              children: [
                Edge { label: Positional, target: bash_fold_stmt_tag(binding: binding) },
                Edge { label: Positional, target: left_emitted },
                Edge { label: Positional, target: right_emitted }
              ],
              occurrence_id: SyntheticOccurrence
            }
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_stmt_list_single_emitted(stmt: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: stmt }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_stmt_list_pair_emitted(left: Node, right: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: left },
      Edge { label: Positional, target: right }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_stmts_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^bash_fold_stmts_empty,
    at: node_locus(node: bash_fold_diagnostic_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn bash_fold_stmt_list_emitted_from_suffix_witness(
  stmts: List<ShellStmt>,
  accumulated: Node,
  index: Int
) -> Witness<Node> {
  match list_at_optional(xs: stmts, index: index) {
    Present { value: s } =>
      match bash_fold_stmt_emitted_witness(stmt: s) {
        Holds { value: stmt_node } =>
          bash_fold_stmt_list_emitted_from_suffix_witness(
            stmts: stmts,
            accumulated: bash_fold_stmt_list_pair_emitted(
              left: accumulated,
              right: stmt_node
            ),
            index: index + 1
          )
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Absent => Holds { value: accumulated }
  }
}

fn bash_fold_stmt_list_emitted_witness(stmts: List<ShellStmt>) -> Witness<Node> {
  match list_nth(xs: stmts, wanted: 0, absent: bash_fold_stmts_absent_diagnostic()) {
    Holds { value: s0 } =>
      match bash_fold_stmt_emitted_witness(stmt: s0) {
        Holds { value: stmt0 } =>
          bash_fold_stmt_list_emitted_from_suffix_witness(
            stmts: stmts,
            accumulated: bash_fold_stmt_list_single_emitted(stmt: stmt0),
            index: 1
          )
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_subshell_emitted(body: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: bash_fold_stmt_tag(binding: ^bash_production_fold_subshell)
      },
      Edge { label: Positional, target: body }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_if_emitted(cond: Node, body: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: bash_fold_stmt_tag(binding: ^bash_production_fold_if)
      },
      Edge { label: Positional, target: cond },
      Edge { label: Positional, target: body }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_stmt_bundle_witness(stmt: ShellStmt) -> Witness<BashFoldStmtBundle> {
  match stmt {
    Command { words: ws } =>
      match bash_fold_command_words_emitted_witness(words: ws) {
        Holds { value: words_node } =>
          Holds {
            value: BashFoldStmtBundle {
              production_binding: ^bash_production_fold_command,
              relation_rule: ^bash_relation_rule_fold_command,
              emitted: bash_fold_command_emitted(words: words_node)
            }
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Exit { code: c } =>
      Holds {
        value: BashFoldStmtBundle {
          production_binding: ^bash_production_fold_exit,
          relation_rule: ^bash_relation_rule_fold_exit,
          emitted: bash_fold_exit_emitted(code: to_string(c))
        }
      }
    Assign { name: n, value: v } =>
      match bash_fold_assign_emitted_witness(name: n, value: v) {
        Holds { value: emitted } =>
          Holds {
            value: BashFoldStmtBundle {
              production_binding: ^bash_production_fold_assign,
              relation_rule: ^bash_relation_rule_fold_assign,
              emitted: emitted
            }
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    AndOr { left: l, op: AndThen, right: r } =>
      match bash_fold_binary_stmt_emitted_witness(
        binding: ^bash_production_fold_and_then,
        left: l,
        right: r
      ) {
        Holds { value: emitted } =>
          Holds {
            value: BashFoldStmtBundle {
              production_binding: ^bash_production_fold_and_then,
              relation_rule: ^bash_relation_rule_fold_and_then,
              emitted: emitted
            }
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    AndOr { left: l, op: OrElse, right: r } =>
      match bash_fold_binary_stmt_emitted_witness(
        binding: ^bash_production_fold_or_else,
        left: l,
        right: r
      ) {
        Holds { value: emitted } =>
          Holds {
            value: BashFoldStmtBundle {
              production_binding: ^bash_production_fold_or_else,
              relation_rule: ^bash_relation_rule_fold_or_else,
              emitted: emitted
            }
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Pipe { left: l, right: r } =>
      match bash_fold_binary_stmt_emitted_witness(
        binding: ^bash_production_fold_pipe,
        left: l,
        right: r
      ) {
        Holds { value: emitted } =>
          Holds {
            value: BashFoldStmtBundle {
              production_binding: ^bash_production_fold_pipe,
              relation_rule: ^bash_relation_rule_fold_pipe,
              emitted: emitted
            }
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    If { cond: c, then: body } =>
      match bash_fold_stmt_emitted_witness(stmt: c) {
        Holds { value: cond_emitted } =>
          match bash_fold_stmt_list_emitted_witness(stmts: body) {
            Holds { value: body_emitted } =>
              Holds {
                value: BashFoldStmtBundle {
                  production_binding: ^bash_production_fold_if,
                  relation_rule: ^bash_relation_rule_fold_if,
                  emitted: bash_fold_if_emitted(cond: cond_emitted, body: body_emitted)
                }
              }
            Violates { diagnostic: d } => Violates { diagnostic: d }
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Subshell { body: b } =>
      match bash_fold_stmt_list_emitted_witness(stmts: b) {
        Holds { value: body_emitted } =>
          Holds {
            value: BashFoldStmtBundle {
              production_binding: ^bash_production_fold_subshell,
              relation_rule: ^bash_relation_rule_fold_subshell,
              emitted: bash_fold_subshell_emitted(body: body_emitted)
            }
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    BraceGroup { body: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_brace_group) }
    EnvPrefixed { name: _, value: _, command: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_env_prefixed) }
    WithRedir { stmt: _, redir: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_with_redir) }
    Heredoc { path: _, delimiter: _, body: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_heredoc) }
    Negation { stmt: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_negation) }
    RawLine { text: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_raw_line) }
  }
}

fn bash_fold_stmt_emitted_witness(stmt: ShellStmt) -> Witness<Node> {
  match bash_fold_stmt_bundle_witness(stmt: stmt) {
    Holds { value: bundle } => Holds { value: bundle.emitted }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_production_binding_for_stmt(stmt: ShellStmt) -> Symbol {
  match bash_fold_stmt_bundle_witness(stmt: stmt) {
    Holds { value: bundle } => bundle.production_binding
    Violates { diagnostic: _ } => ^bash_production_fold_unsupported
  }
}

fn bash_fold_relation_rule_for_stmt(stmt: ShellStmt) -> Symbol {
  match bash_fold_stmt_bundle_witness(stmt: stmt) {
    Holds { value: bundle } => bundle.relation_rule
    Violates { diagnostic: _ } => ^bash_relation_rule_fold_unsupported
  }
}

data bash_fold_cmd_true_emitted: Node = bash_fold_command_emitted(
  words: bash_fold_command_words_single_emitted(
    word: bash_fold_word_lit_emitted(text: "true")
  )
)

data bash_fold_cmd_echo_hi_emitted: Node = bash_fold_command_emitted(
  words: bash_fold_command_words_pair_emitted(
    left: bash_fold_command_words_single_emitted(
      word: bash_fold_word_lit_emitted(text: "echo")
    ),
    right: bash_fold_word_lit_emitted(text: "hi")
  )
)

data bash_fold_cmd_var_x_emitted: Node = bash_fold_command_emitted(
  words: bash_fold_command_words_single_emitted(
    word: bash_fold_word_var_emitted(name: "X")
  )
)

data bash_fold_cmd_false_emitted: Node = bash_fold_command_emitted(
  words: bash_fold_command_words_single_emitted(
    word: bash_fold_word_lit_emitted(text: "false")
  )
)

data bash_fold_cmd_wc_minus_c_emitted: Node = bash_fold_command_emitted(
  words: bash_fold_command_words_pair_emitted(
    left: bash_fold_command_words_single_emitted(
      word: bash_fold_word_lit_emitted(text: "wc")
    ),
    right: bash_fold_word_lit_emitted(text: "-c")
  )
)

data bash_fold_and_then_true_false_emitted: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: bash_fold_stmt_tag(binding: ^bash_production_fold_and_then)
    },
    Edge { label: Positional, target: bash_fold_cmd_true_emitted },
    Edge { label: Positional, target: bash_fold_cmd_false_emitted }
  ],
  occurrence_id: SyntheticOccurrence
}

data bash_fold_pipe_echo_hi_wc_emitted: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: bash_fold_stmt_tag(binding: ^bash_production_fold_pipe)
    },
    Edge { label: Positional, target: bash_fold_cmd_echo_hi_emitted },
    Edge { label: Positional, target: bash_fold_cmd_wc_minus_c_emitted }
  ],
  occurrence_id: SyntheticOccurrence
}

fn bash_fold_word_leaf_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_lit_word,
      rhs: [
        grammar_formal_terminal_bound(identity: ^bash_fold_word_kind_lit, binding: ^bash_fold_word_kind_lit),
        grammar_formal_terminal_free(identity: ^bash_token_lit)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_var_word,
      rhs: [
        grammar_formal_terminal_bound(identity: ^bash_fold_word_kind_var, binding: ^bash_fold_word_kind_var),
        grammar_formal_terminal_free(identity: ^bash_token_var_ref)
      ]
    )
  ]
}

fn bash_fold_command_words_leaf_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_lit_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_var_word)]
    )
  ]
}

fn bash_fold_command_words_list_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_command_words),
        grammar_formal_terminal(identity: ^bash_token_word_sep),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_lit_word)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_command_words),
        grammar_formal_terminal(identity: ^bash_token_word_sep),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_var_word)
      ]
    )
  ]
}

fn bash_fold_stmt_list_leaf_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_stmt_list,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand)]
    )
  ]
}

fn bash_fold_stmt_list_pair_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_stmt_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_stmt_list),
        grammar_formal_terminal(identity: ^bash_token_stmt_sep),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand)
      ]
    )
  ]
}

fn bash_fold_operand_command_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_operand,
    rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_command),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_command_words)
    ]
  )
}

fn bash_fold_operand_exit_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_operand,
    rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_exit),
      grammar_formal_terminal(identity: ^bash_token_stmt_exit_kw),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

fn bash_fold_operand_assign_lit_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_operand,
    rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_assign),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
      grammar_formal_terminal(identity: ^bash_token_assign_eq),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_lit_word)
    ]
  )
}

fn bash_fold_operand_assign_var_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_operand,
    rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_assign),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
      grammar_formal_terminal(identity: ^bash_token_assign_eq),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_var_word)
