  words: bash_build_command_words_single(
    word: bash_build_word_lit(text: "echo")
  )
)

data bash_fold_exit_42_emitted: Node = bash_build_exit(code: "42")

data bash_fold_exit_wrong_emitted: Node = bash_build_exit(code: "0")

