      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_concat_parts),
      grammar_formal_nonterminal_occurrence(identity: word_kind)
    ]
  )
}

fn bash_fold_concat_parts_productions() -> List<FormalProduction> {
  [
    bash_fold_concat_parts_leaf_production(word_kind: ^bash_production_fold_lit_word),
    bash_fold_concat_parts_leaf_production(word_kind: ^bash_production_fold_var_word),
    bash_fold_concat_parts_leaf_production(word_kind: ^bash_production_fold_concat_word),
    bash_fold_concat_parts_leaf_production(word_kind: ^bash_production_fold_cmdsubst_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_lit_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_var_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_concat_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_cmdsubst_word)
  ]
}

