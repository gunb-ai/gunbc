    emitted: bash_fold_and_then_true_false_emitted,
    source_literal: ^bash_fold_and_then_wrong_source_literal,
    source_text: "'true' || 'false'",
    production_binding: ^bash_production_fold_or_else,
    rule_name: ^bash_relation_rule_fold_or_else
  )
}

