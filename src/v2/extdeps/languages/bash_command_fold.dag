  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: bash_build_stmt_tag(binding: ^bash_production_fold_assign)
    },
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Atom { identity: "X" } },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
    },
    Edge {
      label: Positional,
      target: bash_build_word_var(name: "HOME")
    }
