fn bash_fold_operand_productions() -> List<FormalProduction> {
  [
    bash_fold_operand_command_production(),
    bash_fold_operand_exit_production(),
    bash_fold_operand_assign_lit_production(),
    bash_fold_operand_assign_var_production(),
