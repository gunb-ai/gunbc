fn bash_fold_with_redir_fixed_rhs(redir_binding: Symbol, redir_token: Symbol) -> List<FormalGrammarSymbol> {
  [
    bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_with_redir),
    grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand),
    bash_fold_stmt_kind_tag_terminal(binding: redir_binding),
    grammar_formal_terminal(identity: redir_token)
  ]
}

fn bash_fold_with_redir_to_file_rhs(path_word_kind: Symbol) -> List<FormalGrammarSymbol> {
  bash_fold_with_redir_file_rhs(
    redir_binding: ^bash_production_fold_redir_to_file,
    redir_token: ^bash_fold_redir_to_file,
    path_word_kind: path_word_kind
  )
}

