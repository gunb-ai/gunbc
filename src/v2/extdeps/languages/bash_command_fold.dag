fn bash_fold_if_top_production() -> FormalProduction {
  bash_fold_top_level_production(
    binding: ^bash_production_fold_if,
    rule_rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_if),
      grammar_formal_terminal(identity: ^bash_token_if_kw),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_operand),
      grammar_formal_terminal(identity: ^bash_token_if_then),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_stmt_list),
      grammar_formal_terminal(identity: ^bash_token_if_fi)
    ]
  )
}

fn bash_fold_list_stmt_productions() -> List<FormalProduction> {
  [
    bash_fold_and_then_top_production(),
    bash_fold_or_else_top_production(),
    bash_fold_pipe_top_production(),
    bash_fold_subshell_top_production(),
    bash_fold_if_top_production()
  ]
}

fn bash_fold_formal_productions() -> List<FormalProduction> {
  list_append(
    list_append(
      list_append(
        list_append(
          list_append(
            bash_fold_word_leaf_productions(),
            bash_fold_word_compound_productions()
          ),
          bash_fold_concat_parts_productions()
        ),
        list_append(
          bash_fold_command_words_leaf_productions(),
          bash_fold_command_words_list_productions()
        )
      ),
      list_append(
        bash_fold_stmt_list_leaf_productions(),
        bash_fold_stmt_list_pair_productions()
      )
    ),
    list_append(
      list_append(
        [
          bash_fold_command_top_production(),
          bash_fold_exit_top_production(),
          bash_fold_assign_lit_top_production(),
          bash_fold_assign_var_top_production(),
          bash_fold_assign_concat_top_production(),
          bash_fold_assign_cmdsubst_top_production()
        ],
        list_append(
          bash_fold_list_stmt_productions(),
          bash_fold_with_redir_productions()
        )
      ),
      bash_fold_operand_productions()
    )
  )
}

fn bash_fold_translation_rules_node_for_emitted(
  emitted: Node,
  lhs: Symbol,
  rule_name: Symbol
) -> Witness<Node> {
  match bash_fold_relation_row_witness(emitted: emitted, lhs: lhs) {
    Holds { value: row } =>
      Holds {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            bash_named_edge(
              name: ^grammar_relation_rules_formal_productions,
              target: formal_productions_catalog_to_node(
                productions: bash_fold_formal_productions()
              )
            ),
            bash_named_edge(
              name: rule_name,
              target: row
            )
          ],
          occurrence_id: SyntheticOccurrence
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_relation_row_witness(emitted: Node, lhs: Symbol) -> Witness<Node> {
  let productions = bash_fold_formal_productions()
  match formal_production_for_lhs_exact(
    productions: productions,
    lhs: lhs,
    child: emitted
  ) {
    Holds { value: production } =>
      derive_grammar_relation_row_node(
        production: production,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_serialize_source_witness(
  emitted: Node,
  source_literal: Symbol,
  production_binding: Symbol
) -> Witness<Node> {
  match bash_fold_relation_row_witness(emitted: emitted, lhs: production_binding) {
    Holds { value: row } =>
      match find_named_child(root: row, name: ^grammar_relation_field_tokens) {
        Accepted { value: tokens_root, diagnostics: _ } =>
          Holds {
            value: Node {
              kind: TypeNode { connective: Conj },
              children: [
                bash_named_edge(
                  name: ^serialize_source_field_source_text,
                  target: bash_word_atom(id: source_literal)
                ),
                bash_named_edge(
                  name: ^serialize_source_field_source_grammar,
                  target: bash_word_atom(id: production_binding)
                ),
                bash_named_edge(
                  name: ^grammar_relation_field_tokens,
                  target: tokens_root
                )
              ],
              occurrence_id: SyntheticOccurrence
            }
          }
        Rejected { diagnostics: nd } => Violates { diagnostic: nd.head }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn bash_fold_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      bash_fold_lex_rule(token_class: ^bash_token_word_sep, text: " "),
      bash_fold_lex_rule(token_class: ^bash_token_stmt_exit_kw, text: "exit "),
      bash_fold_lex_rule(token_class: ^bash_token_assign_eq, text: "="),
      bash_fold_lex_rule(token_class: ^bash_token_and_then, text: " && "),
      bash_fold_lex_rule(token_class: ^bash_token_or_else, text: " || "),
      bash_fold_lex_rule(token_class: ^bash_token_pipe, text: " | "),
      bash_fold_lex_rule(token_class: ^bash_token_subshell_open, text: "("),
      bash_fold_lex_rule(token_class: ^bash_token_subshell_close, text: ")"),
      bash_fold_lex_rule(token_class: ^bash_token_stmt_sep, text: "; "),
      bash_fold_lex_rule(token_class: ^bash_token_if_kw, text: "if "),
      bash_fold_lex_rule(token_class: ^bash_token_if_then, text: "; then "),
      bash_fold_lex_rule(token_class: ^bash_token_if_fi, text: "; fi"),
      bash_fold_lex_rule(token_class: ^bash_fold_stmt_kind_tag, text: "\u{0002}"),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_lit, text: "\u{0000}"),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_var, text: "\u{0001}"),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_concat, text: "\u{0003}"),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_cmdsubst, text: "\u{0004}"),
      bash_fold_lex_rule(token_class: ^bash_fold_cmdsubst_open, text: "$("),
      bash_fold_lex_rule(token_class: ^bash_fold_cmdsubst_close, text: ")"),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_stderr_null, text: " 2>/dev/null"),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_stdout_and_stderr_null, text: " >/dev/null 2>&1"),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_stdout_to_stderr, text: " >&2"),
      bash_fold_lex_rule(token_class: ^bash_fold_redir_to_file, text: " > ")
    ]
  }
}

fn bash_fold_lex() -> LexRules {
  ModeledLexRules { root: bash_fold_lex_rules() }
}

data bash_ingest_only_lex_rules_note: String = "no-smuggled-programs HALF B: INGEST-direction lex view. §4 asymmetry — ingest RECOGNIZES a superset of what emit PRODUCES. Recognized-but-UNMODELED control keywords (no production); presence marks an incompletely-modeled control form => AmbiguousParse, never Violation. Emit set (bash_fold_lex_rules) UNCHANGED so emit stays byte-identical. Word boundaries ride the spelling (trailing/leading space; done/esac terminal; do is spelled with a REQUIRED leading space so at the d of done its spelling can never be a prefix candidate — do and done do not collide at the same start position, so no maximal-munch arbitration between them is needed). newline reuses existing separator class bash_token_orch_seq_newline (bash.dag:1184)."

fn bash_ingest_only_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_for, text: "for "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_do, text: " do"),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_done, text: "done"),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_while, text: "while "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_until, text: "until "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_select, text: "select "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_case, text: "case "),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_esac, text: "esac"),
      bash_fold_lex_rule(token_class: ^bash_ingest_kw_case_clause_sep, text: ";;"),
      bash_fold_lex_rule(token_class: ^bash_ingest_brace_open, text: "{ "),
      bash_fold_lex_rule(token_class: ^bash_ingest_brace_close, text: "; }"),
      bash_fold_lex_rule(token_class: ^bash_token_orch_seq_newline, text: "\n")
    ]
  }
}

fn bash_ingest_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: list_append(
      left: bash_fold_lex_rules().rules,
      right: bash_ingest_only_lex_rules().rules
    )
  }
}

fn bash_fold_kind_emit_transform(_spelling: String) -> String {
  ""
}

fn bash_fold_stmt_kind_tag_emit_transform(_spelling: String) -> String {
  ""
}

fn bash_fold_identity_emit_transform(spelling: String) -> String {
  spelling
}

fn bash_fold_emit_transforms() -> Map<Symbol, fn(String) -> String> {
  let m0 = bash_token_class_emit_transforms()
  let m1 = map_insert(m0, ^bash_fold_word_kind_lit, bash_fold_kind_emit_transform)
  let m2 = map_insert(m1, ^bash_fold_word_kind_var, bash_fold_kind_emit_transform)
  let m3 = map_insert(m2, ^bash_fold_stmt_kind_tag, bash_fold_stmt_kind_tag_emit_transform)
  let m4 = map_insert(m3, ^bash_fold_word_kind_concat, bash_fold_kind_emit_transform)
  let m5 = map_insert(m4, ^bash_fold_word_kind_cmdsubst, bash_fold_kind_emit_transform)
  map_insert(m5, ^bash_token_orch_raw, bash_fold_identity_emit_transform)
}

fn bash_fold_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^bash_fold_word_kind_lit, "")
  map_insert(m0, ^bash_fold_word_kind_var, "")
}

fn bash_fold_target_model_bundle_witness(
  emitted: Node,
  source_literal: Symbol,
  production_binding: Symbol,
  rule_name: Symbol
) -> Witness<Node> {
  match bash_fold_serialize_source_witness(
    emitted: emitted,
    source_literal: source_literal,
    production_binding: production_binding
  ) {
    Holds { value: serialize_source } =>
      match bash_fold_translation_rules_node_for_emitted(
        emitted: emitted,
        lhs: production_binding,
        rule_name: rule_name
      ) {
        Holds { value: rules } =>
          Holds {
            value: bash_target_model_bundle(
              rules: rules,
              serialize_source: serialize_source
            )
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_target_model_for_emitted_witness(
  emitted: Node,
  source_literal: Symbol,
  source_text: String,
  production_binding: Symbol,
  rule_name: Symbol
) -> Witness<TargetModel> {
  match bash_fold_target_model_bundle_witness(
    emitted: emitted,
    source_literal: source_literal,
    production_binding: production_binding,
    rule_name: rule_name
  ) {
    Holds { value: bundle } =>
      Holds {
        value: target_model_make_with_emit_transforms(
          bundle: bundle,
          lex: bash_fold_lex(),
          binding_spellings: bash_fold_binding_spellings(),
          token_class_emit_transforms: bash_fold_emit_transforms(),
          authority_source_text: source_text,
          runtime_row: target_emit_host_runtime_row_unconfigured
        )
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_raw_line_target_model(text: String) -> TargetModel {
  bash_word_pass_target_model(spelling: text)
}

fn bash_fold_negation_target_model(inner_spelling: String) -> TargetModel {
