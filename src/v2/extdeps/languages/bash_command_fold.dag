      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_seq),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_stmt_list)
    ]
  )
}

fn bash_fold_brace_group_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_brace_group,
    rhs: [
