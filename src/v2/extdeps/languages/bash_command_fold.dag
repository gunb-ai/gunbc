      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_list),
      grammar_formal_terminal(identity: ^bash_ingest_kw_esac)
    ]
  )
}

// A case arm, block form: pattern on the 'case' line, body at its own indent,
// ';;' closing the arm on its own line. Bash manual, node "Bash Conditional
// Expressions": [ [(] pattern [| pattern] command-list ;; ].
fn bash_fold_case_clause_block_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_case_clause_block,
    rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_case_clause_block),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
      grammar_formal_terminal(identity: ^bash_ingest_case_pattern_sep),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_body),
      grammar_formal_terminal(identity: ^bash_ingest_case_block_lead),
      grammar_formal_terminal(identity: ^bash_ingest_kw_case_clause_sep)
    ]
  )
}

fn bash_fold_case_clause_inline_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_case_clause_inline,
    rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_case_clause_inline),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
      grammar_formal_terminal(identity: ^bash_ingest_case_pattern_sep),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_body),
      grammar_formal_terminal(identity: ^bash_ingest_case_inline_lead),
      grammar_formal_terminal(identity: ^bash_ingest_kw_case_clause_sep)
    ]
  )
}

// The arm body is a command list. Bash manual, node "Lists": commands are
// separated by ';' or a newline, which is why the block arm and the inline arm
// are two spellings of one grammar shape rather than two constructs.
fn bash_fold_case_clause_body_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_case_clause_body,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_stmt_list)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_case_clause_list,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_block)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_case_clause_list,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_inline)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_case_clause_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_list),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_case_clause_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_list),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_case_clause_inline)
      ]
    )
  ]
}

fn bash_fold_for_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_for,
    rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_for),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
      grammar_formal_terminal(identity: ^bash_ingest_kw_in),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_command_words),
      grammar_formal_terminal(identity: ^bash_ingest_kw_do),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_stmt_list),
      grammar_formal_terminal(identity: ^bash_ingest_kw_done)
    ]
  )
}

fn bash_fold_operand_for_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_operand,
    rhs: [
      bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_for),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
      grammar_formal_terminal(identity: ^bash_ingest_kw_in),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_command_words),
      grammar_formal_terminal(identity: ^bash_ingest_kw_do),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_stmt_list),
      grammar_formal_terminal(identity: ^bash_ingest_kw_done)
    ]
  )
}

// Bash manual, node "Arrays": name=(word1 word2 …). Elements are words, so each
// keeps its own quoting; the list shape is the same one a command's words use.
fn bash_fold_array_assign_element_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_array_elements,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_command_words)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_array_assign,
      rhs: [
        bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_array_assign),
        grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
        grammar_formal_terminal(identity: ^bash_token_array_paren_open),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_array_elements),
        grammar_formal_terminal(identity: ^bash_token_array_paren_close)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_operand,
      rhs: [
        bash_fold_stmt_kind_tag_terminal(binding: ^bash_production_fold_array_assign),
        grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
        grammar_formal_terminal(identity: ^bash_token_array_paren_open),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_array_elements),
        grammar_formal_terminal(identity: ^bash_token_array_paren_close)
      ]
    )
  ]
}

// The four new word kinds. A leaf word is its kind sentinel plus its free text,
// exactly as the lit and var kinds are declared above.
fn bash_fold_bare_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_bare_word,
    rhs: [
      grammar_formal_terminal_bound(identity: ^bash_fold_word_kind_bare, binding: ^bash_fold_word_kind_bare),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

fn bash_fold_array_expansion_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_array_expansion_word,
    rhs: [
      grammar_formal_terminal_bound(
        identity: ^bash_fold_word_kind_array_expansion,
        binding: ^bash_fold_word_kind_array_expansion
      ),
      grammar_formal_terminal(identity: ^bash_token_array_expand_open),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
      grammar_formal_terminal(identity: ^bash_token_array_expand_all)
    ]
  )
}

fn bash_fold_param_error_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_param_error_word,
    rhs: [
      grammar_formal_terminal_bound(
        identity: ^bash_fold_word_kind_param_error,
        binding: ^bash_fold_word_kind_param_error
      ),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

// The numbered positional parameter: `$0` .. `$9`. Its own row, because it is not a
// variable and not `$*`/`$@` -- three different things in the manual, and the lane
// says so in three rows.
fn bash_fold_positional_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_positional_word,
    rhs: [
      grammar_formal_terminal_bound(
        identity: ^bash_fold_word_kind_positional,
        binding: ^bash_fold_word_kind_positional
      ),
      grammar_formal_terminal(identity: ^bash_token_dollar),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

fn bash_fold_positional_all_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_positional_all_word,
    rhs: [
      grammar_formal_terminal_bound(
        identity: ^bash_fold_word_kind_positional_all,
        binding: ^bash_fold_word_kind_positional_all
      ),
      grammar_formal_terminal(identity: ^bash_token_dollar),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

// THE EXIT-STATUS PARAMETER AS A WORD. Bash manual, node "Special Parameters": `$?` is
// the status of the most recently executed foreground pipeline. The row owns the `$`
// (the terminal below) and the node carries only the `?`, which the serializer
// re-checks on the way out, so nothing can be spelled `$` plus arbitrary text. Its
// reason for existing: the CI floor-attempt wrapper (dag/gunbc/ci/ci_failure_class.dag)
// recorded the attempt's status with the VARIABLE row and the name `?`, which the checked
// variable builder refuses -- the whole program then failed to serialize and the caller
// silently swapped in its error-script fallback: a command never run, reporting a
// failure. A construct the grammar cannot express must fail loudly, and it must have a
// row to be added to.
fn bash_fold_exit_status_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_exit_status_word,
    rhs: [
      grammar_formal_terminal_bound(
        identity: ^bash_fold_word_kind_exit_status,
        binding: ^bash_fold_word_kind_exit_status
      ),
      grammar_formal_terminal(identity: ^bash_token_dollar),
      // FREE, not a nonterminal occurrence: the `?` is the node's own carried text,
      // spelled through the orchestrator's raw-token channel exactly as the positional
      // kinds' text is (bash_fold_positional_all_word_production). Declaring it as a
      // nonterminal makes the row unmatchable and the emitter then reports
      // grammar_relation_production_not_found for a node that is perfectly well formed.
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

fn bash_fold_double_quoted_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_double_quoted_word,
    rhs: [
      grammar_formal_terminal_bound(
        identity: ^bash_fold_word_kind_double_quoted,
        binding: ^bash_fold_word_kind_double_quoted
      ),
      grammar_formal_terminal(identity: ^bash_token_double_quote_open),
      grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_concat_parts),
      grammar_formal_terminal(identity: ^bash_token_double_quote_close)
    ]
  )
}

// The inert text of a double-quoted word. Bash manual, node "Quotes": within
// double quotes only '$', backquote, '"', '\' and '!' stay special, so those
// are what the constructor refuses; the spelling itself is identity.
fn bash_fold_quoted_text_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_quoted_text_word,
    rhs: [
      grammar_formal_terminal_bound(
        identity: ^bash_fold_word_kind_quoted_text,
        binding: ^bash_fold_word_kind_quoted_text
      ),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

// THE BRACKET-TEST OPERATOR, AS A WORD OF ITS OWN. bash(1), node "Bash Conditional
// Expressions", gives a conditional expression its meaning from operator tokens that are
// NOT quoted: `[ a != b ]` tests inequality, `[ a "!=" b ]` compares the three strings and
// is true of every pair. So the operator cannot be a quoted literal and cannot be a bare
// word either -- the bare alphabet has no '!' at all, and widening it would let '!' into
// every unquoted position in a script (history expansion there, and the closed set below
// exists precisely so that does not happen). It gets its own production: a kind token,
// then the operator text through the same free slot every other word kind uses, with the
// text checked against the closed set by bash_build_word_test_operator on the way in and
// by the serializer's arm on the way out. A word that is not one of the manual's operators
// has no row and cannot be spelled by anything.
fn bash_fold_test_operator_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_test_operator_word,
    rhs: [
      grammar_formal_terminal_bound(
        identity: ^bash_fold_word_kind_test_operator,
        binding: ^bash_fold_word_kind_test_operator
      ),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

fn bash_fold_var_bare_word_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_var_bare_word,
    rhs: [
      grammar_formal_terminal_bound(
        identity: ^bash_fold_word_kind_var_bare,
        binding: ^bash_fold_word_kind_var_bare
      ),
      grammar_formal_terminal(identity: ^bash_token_dollar),
      grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
    ]
  )
}

fn bash_fold_new_word_productions() -> List<FormalProduction> {
  [
    bash_fold_bare_word_production(),
    bash_fold_var_bare_word_production(),
    bash_fold_array_expansion_word_production(),
    bash_fold_param_error_word_production(),
    bash_fold_positional_all_word_production(),
    bash_fold_exit_status_word_production(),
    bash_fold_positional_word_production(),
    bash_fold_test_operator_word_production(),
    bash_fold_double_quoted_word_production(),
    bash_fold_quoted_text_word_production()
  ]
}

// The new word kinds are words: they may stand alone as a value and appear in a
// command's word list, exactly like the lit and var kinds.
fn bash_fold_new_word_leaf_productions() -> List<FormalProduction> {
  bash_fold_new_word_productions()
}

// A new-kind word must also stand ALONE in a command's word list, exactly as lit/var/concat/cmdsubst
// do: the base of the left spine is 'command_words -> word'. 'new_word_leaf_productions' above is the
// word's OWN production; these are the command_words membership leaves, the sibling of
// bash_fold_command_words_leaf_productions. Without them a single new-kind word (and so any command or
// function containing one) had a command_words node with no production.
fn bash_fold_new_command_words_leaf_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_bare_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_var_bare_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_array_expansion_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_param_error_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_positional_all_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_positional_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_test_operator_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_exit_status_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_double_quoted_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_quoted_text_word)]
    )
  ]
}

fn bash_fold_new_command_words_list_productions() -> List<FormalProduction> {
  [
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_var_bare_word),
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_quoted_text_word),
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_double_quoted_word),
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_bare_word),
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_array_expansion_word),
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_param_error_word),
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_positional_all_word),
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_positional_word),
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_test_operator_word),
    bash_fold_command_words_list_production(word_kind: ^bash_production_fold_exit_status_word)
  ]
}

fn bash_fold_new_concat_parts_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_bare_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_array_expansion_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_param_error_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_positional_all_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_positional_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_test_operator_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_exit_status_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_var_bare_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_double_quoted_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_concat_parts,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_quoted_text_word)]
    ),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_bare_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_array_expansion_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_param_error_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_positional_all_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_positional_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_var_bare_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_double_quoted_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_quoted_text_word),
    bash_fold_concat_parts_pair_production(word_kind: ^bash_production_fold_exit_status_word)
  ]
}

// Assignment accepts the parameter-error word as its value: IDX=${1:?usage…} is
// an assignment whose value is a parameter expansion, not a literal.
fn bash_fold_operand_assign_param_error_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_operand,
    rhs: bash_fold_assign_rhs(value_word_kind: ^bash_production_fold_param_error_word)
  )
}

fn bash_fold_operand_assign_var_bare_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^bash_production_fold_operand,
    rhs: bash_fold_assign_rhs(value_word_kind: ^bash_production_fold_var_bare_word)
  )
}

fn bash_fold_new_construct_productions() -> List<FormalProduction> {
  list_append(
    list_append(
      list_append(
        [
          bash_fold_function_def_production(),
          bash_fold_operand_function_def_production(),
          bash_fold_seq_production(),
          bash_fold_operand_seq_production(),
          bash_fold_brace_group_production(),
          bash_fold_operand_brace_group_production(),
          bash_fold_comment_production(),
          bash_fold_operand_comment_production(),
          bash_fold_case_production(),
          bash_fold_operand_case_production(),
          bash_fold_case_clause_block_production(),
          bash_fold_case_clause_inline_production(),
          bash_fold_for_production(),
          bash_fold_operand_for_production()
        ],
        bash_fold_case_clause_body_productions()
      ),
      bash_fold_array_assign_element_productions()
    ),
    list_append(
      list_append(
        list_append(
          list_append(
            bash_fold_new_word_leaf_productions(),
            bash_fold_new_command_words_list_productions()
          ),
          bash_fold_new_command_words_leaf_productions()
        ),
        bash_fold_new_concat_parts_productions()
      ),
      [
        bash_fold_operand_assign_param_error_production(),
        bash_fold_operand_assign_var_bare_production()
      ]
    )
  )
}
