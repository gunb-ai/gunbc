module v2.extdeps.languages.bash_command_fold

import extdeps.languages.bash.program {
  Assign,
  Command,
  Exit,
  Lit,
  ShellStmt,
  ShellWord,
  VarRef,
  serialize_stmt
}
import v2.extdeps.languages.bash {
  bash_named_edge,
  bash_token_class_emit_transforms,
  bash_target_model_bundle,
  bash_word_atom
}
import v2.std.collection {
  Absent,
  List,
  Map,
  Present,
  empty_map,
  list_at_optional,
  list_nth,
  map_insert
}
import v2.std.compilers.lexing {
  LexRule,
  LexRuleSet,
  LexRules,
  LiteralPattern,
  ModeledLexRules,
  TokenRule
}
import v2.std.compilers.target_model {
  TargetModel,
  target_model_make_with_emit_transforms
}
import v2.std.diagnostic {
  Accepted,
  Diagnostic,
  ExternalContractUnknown,
  Rejected,
  Unavailable,
  node_locus
}
import v2.std.node_query { find_named_child }
import v2.std.grammar {
  FormalProduction,
  derive_grammar_relation_row_node,
  formal_production_for_lhs_exact,
  formal_productions_catalog_to_node,
  grammar_formal_nonterminal_occurrence,
  grammar_formal_production,
  grammar_formal_terminal,
  grammar_formal_terminal_bound,
  grammar_formal_terminal_free
}
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.witness { Holds, Violates, Witness }

fn bash_fold_word_kinded_emitted(kind: Symbol, value: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: kind } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: value } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_word_lit_emitted(text: String) -> Node {
  bash_fold_word_kinded_emitted(kind: ^bash_fold_word_kind_lit, value: text)
}

fn bash_fold_word_var_emitted(name: String) -> Node {
  bash_fold_word_kinded_emitted(kind: ^bash_fold_word_kind_var, value: name)
}

data bash_fold_diagnostic_anchor: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

fn bash_fold_unsupported_variant_diagnostic(variant: Symbol) -> Diagnostic {
  Diagnostic {
    reason: variant,
    at: node_locus(node: bash_fold_diagnostic_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn bash_fold_word_emitted_witness(w: ShellWord) -> Witness<Node> {
  match w {
    Lit { text: t } => Holds { value: bash_fold_word_lit_emitted(text: t) }
    VarRef { name: n } => Holds { value: bash_fold_word_var_emitted(name: n) }
    Concat { parts: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_word_concat) }
    CmdSubst { body: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_word_cmdsubst) }
    Raw { text: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_word_raw) }
  }
}

fn bash_fold_command_words_single_emitted(word: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: word }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_command_words_pair_emitted(left: Node, right: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: left },
      Edge { label: Positional, target: right }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_command_emitted(words: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: words }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_words_absent_diagnostic() -> Diagnostic {
  Diagnostic {
    reason: ^bash_fold_words_empty,
    at: node_locus(node: bash_fold_diagnostic_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn bash_fold_command_words_emitted_from_list_suffix_witness(
  words: List<ShellWord>,
  accumulated: Node,
  index: Int
) -> Witness<Node> {
  match list_at_optional(xs: words, index: index) {
    Present { value: w } =>
      match bash_fold_word_emitted_witness(w: w) {
        Holds { value: word_node } =>
          bash_fold_command_words_emitted_from_list_suffix_witness(
            words: words,
            accumulated: bash_fold_command_words_pair_emitted(
              left: accumulated,
              right: word_node
            ),
            index: index + 1
          )
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Absent => Holds { value: accumulated }
  }
}

fn bash_fold_command_words_emitted_witness(words: List<ShellWord>) -> Witness<Node> {
  match list_nth(xs: words, wanted: 0, absent: bash_fold_words_absent_diagnostic()) {
    Holds { value: w0 } =>
      match bash_fold_word_emitted_witness(w: w0) {
        Holds { value: word0 } =>
          bash_fold_command_words_emitted_from_list_suffix_witness(
            words: words,
            accumulated: bash_fold_command_words_single_emitted(word: word0),
            index: 1
          )
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_exit_emitted(code: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: code } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_fold_assign_emitted_witness(name: String, value: ShellWord) -> Witness<Node> {
  match bash_fold_word_emitted_witness(w: value) {
    Holds { value: word_node } =>
      Holds {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            Edge {
              label: Positional,
              target: Node {
                kind: TypeNode { connective: Atom { identity: name } },
                children: [],
                occurrence_id: SyntheticOccurrence
              }
            },
            Edge { label: Positional, target: word_node }
          ],
          occurrence_id: SyntheticOccurrence
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_production_binding_for_stmt(stmt: ShellStmt) -> Symbol {
  match stmt {
    Command { words: _ } => ^bash_production_fold_command
    Exit { code: _ } => ^bash_production_fold_exit
    Assign { name: _, value: _ } => ^bash_production_fold_assign
    If { cond: _, then: _ } => ^bash_production_fold_unsupported
    Subshell { body: _ } => ^bash_production_fold_unsupported
    BraceGroup { body: _ } => ^bash_production_fold_unsupported
    AndOr { left: _, op: _, right: _ } => ^bash_production_fold_unsupported
    Pipe { left: _, right: _ } => ^bash_production_fold_unsupported
    EnvPrefixed { name: _, value: _, command: _ } => ^bash_production_fold_unsupported
    WithRedir { stmt: _, redir: _ } => ^bash_production_fold_unsupported
    Heredoc { path: _, delimiter: _, body: _ } => ^bash_production_fold_unsupported
    Negation { stmt: _ } => ^bash_production_fold_unsupported
    RawLine { text: _ } => ^bash_production_fold_unsupported
  }
}

fn bash_fold_relation_rule_for_stmt(stmt: ShellStmt) -> Symbol {
  match stmt {
    Command { words: _ } => ^bash_relation_rule_fold_command
    Exit { code: _ } => ^bash_relation_rule_fold_exit
    Assign { name: _, value: _ } => ^bash_relation_rule_fold_assign
    If { cond: _, then: _ } => ^bash_relation_rule_fold_unsupported
    Subshell { body: _ } => ^bash_relation_rule_fold_unsupported
    BraceGroup { body: _ } => ^bash_relation_rule_fold_unsupported
    AndOr { left: _, op: _, right: _ } => ^bash_relation_rule_fold_unsupported
    Pipe { left: _, right: _ } => ^bash_relation_rule_fold_unsupported
    EnvPrefixed { name: _, value: _, command: _ } => ^bash_relation_rule_fold_unsupported
    WithRedir { stmt: _, redir: _ } => ^bash_relation_rule_fold_unsupported
    Heredoc { path: _, delimiter: _, body: _ } => ^bash_relation_rule_fold_unsupported
    Negation { stmt: _ } => ^bash_relation_rule_fold_unsupported
    RawLine { text: _ } => ^bash_relation_rule_fold_unsupported
  }
}

fn bash_fold_stmt_emitted_witness(stmt: ShellStmt) -> Witness<Node> {
  match stmt {
    Command { words: ws } =>
      match bash_fold_command_words_emitted_witness(words: ws) {
        Holds { value: words_node } =>
          Holds { value: bash_fold_command_emitted(words: words_node) }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Exit { code: c } => Holds { value: bash_fold_exit_emitted(code: to_string(c)) }
    Assign { name: n, value: v } => bash_fold_assign_emitted_witness(name: n, value: v)
    If { cond: _, then: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_if) }
    Subshell { body: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_subshell) }
    BraceGroup { body: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_brace_group) }
    AndOr { left: _, op: _, right: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_and_or) }
    Pipe { left: _, right: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_pipe) }
    EnvPrefixed { name: _, value: _, command: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_env_prefixed) }
    WithRedir { stmt: _, redir: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_with_redir) }
    Heredoc { path: _, delimiter: _, body: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_heredoc) }
    Negation { stmt: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_negation) }
    RawLine { text: _ } =>
      Violates { diagnostic: bash_fold_unsupported_variant_diagnostic(variant: ^bash_fold_stmt_raw_line) }
  }
}

data bash_fold_cmd_true_emitted: Node = bash_fold_command_emitted(
  words: bash_fold_command_words_single_emitted(
    word: bash_fold_word_lit_emitted(text: "true")
  )
)

data bash_fold_cmd_echo_hi_emitted: Node = bash_fold_command_emitted(
  words: bash_fold_command_words_pair_emitted(
    left: bash_fold_command_words_single_emitted(
      word: bash_fold_word_lit_emitted(text: "echo")
    ),
    right: bash_fold_word_lit_emitted(text: "hi")
  )
)

data bash_fold_cmd_var_x_emitted: Node = bash_fold_command_emitted(
  words: bash_fold_command_words_single_emitted(
    word: bash_fold_word_var_emitted(name: "X")
  )
)

fn bash_fold_formal_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^bash_production_fold_lit_word,
      rhs: [
        grammar_formal_terminal_bound(identity: ^bash_fold_word_kind_lit, binding: ^bash_fold_word_kind_lit),
        grammar_formal_terminal_free(identity: ^bash_token_lit)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_var_word,
      rhs: [
        grammar_formal_terminal_bound(identity: ^bash_fold_word_kind_var, binding: ^bash_fold_word_kind_var),
        grammar_formal_terminal_free(identity: ^bash_token_var_ref)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_lit_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_var_word)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_command_words),
        grammar_formal_terminal(identity: ^bash_token_word_sep),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_lit_word)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command_words,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_command_words),
        grammar_formal_terminal(identity: ^bash_token_word_sep),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_var_word)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_command,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_command_words)]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_exit,
      rhs: [
        grammar_formal_terminal(identity: ^bash_token_stmt_exit_kw),
        grammar_formal_terminal_free(identity: ^bash_token_orch_raw)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_assign,
      rhs: [
        grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
        grammar_formal_terminal(identity: ^bash_token_assign_eq),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_lit_word)
      ]
    ),
    grammar_formal_production(
      lhs: ^bash_production_fold_assign,
      rhs: [
        grammar_formal_terminal_free(identity: ^bash_token_orch_raw),
        grammar_formal_terminal(identity: ^bash_token_assign_eq),
        grammar_formal_nonterminal_occurrence(identity: ^bash_production_fold_var_word)
      ]
    )
  ]
}

fn bash_fold_translation_rules_node_for_emitted(
  emitted: Node,
  lhs: Symbol,
  rule_name: Symbol
) -> Node {
  match bash_fold_relation_row_witness(emitted: emitted, lhs: lhs) {
    Holds { value: row } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          bash_named_edge(
            name: ^grammar_relation_rules_formal_productions,
            target: formal_productions_catalog_to_node(
              productions: bash_fold_formal_productions()
            )
          ),
          bash_named_edge(
            name: rule_name,
            target: row
          )
        ],
        occurrence_id: SyntheticOccurrence
      }
    Violates { diagnostic: _ } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [],
        occurrence_id: SyntheticOccurrence
      }
  }
}

fn bash_fold_relation_row_witness(emitted: Node, lhs: Symbol) -> Witness<Node> {
  match formal_production_for_lhs_exact(
    productions: bash_fold_formal_productions(),
    lhs: lhs,
    child: emitted
  ) {
    Holds { value: production } =>
      derive_grammar_relation_row_node(
        production: production,
        productions: bash_fold_formal_productions(),
        emitted: emitted
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_serialize_source_witness(
  emitted: Node,
  source_literal: Symbol,
  production_binding: Symbol
) -> Witness<Node> {
  match bash_fold_relation_row_witness(emitted: emitted, lhs: production_binding) {
    Holds { value: row } =>
      match find_named_child(root: row, name: ^grammar_relation_field_tokens) {
        Accepted { value: tokens_root, diagnostics: _ } =>
          Holds {
            value: Node {
              kind: TypeNode { connective: Conj },
              children: [
                bash_named_edge(
                  name: ^serialize_source_field_source_text,
                  target: bash_word_atom(id: source_literal)
                ),
                bash_named_edge(
                  name: ^serialize_source_field_source_grammar,
                  target: bash_word_atom(id: production_binding)
                ),
                bash_named_edge(
                  name: ^grammar_relation_field_tokens,
                  target: tokens_root
                )
              ],
              occurrence_id: SyntheticOccurrence
            }
          }
        Rejected { diagnostics: nd } => Violates { diagnostic: nd.head }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn bash_fold_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      bash_fold_lex_rule(token_class: ^bash_token_word_sep, text: " "),
      bash_fold_lex_rule(token_class: ^bash_token_stmt_exit_kw, text: "exit "),
      bash_fold_lex_rule(token_class: ^bash_token_assign_eq, text: "="),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_lit, text: "\u{0000}"),
      bash_fold_lex_rule(token_class: ^bash_fold_word_kind_var, text: "\u{0001}")
    ]
  }
}

fn bash_fold_lex() -> LexRules {
  ModeledLexRules { root: bash_fold_lex_rules() }
}

data bash_fold_word_kind_marker_dissolution_trigger: String = "🟡 dissolve-on: phantom \\u{0000}/\\u{0001} kind-marker lex bytes and zero-width bash_fold_kind_emit_transform are replaced by real bash word-class lexing that disambiguates lit vs var without sentinel bytes"

fn bash_fold_kind_emit_transform(spelling: String) -> String {
  ""
}

fn bash_fold_identity_emit_transform(spelling: String) -> String {
  spelling
}

fn bash_fold_emit_transforms() -> Map<Symbol, fn(String) -> String> {
  let m0 = bash_token_class_emit_transforms()
  let m1 = map_insert(m0, ^bash_fold_word_kind_lit, bash_fold_kind_emit_transform)
  let m2 = map_insert(m1, ^bash_fold_word_kind_var, bash_fold_kind_emit_transform)
  map_insert(m2, ^bash_token_orch_raw, bash_fold_identity_emit_transform)
}

fn bash_fold_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^bash_fold_word_kind_lit, "")
  map_insert(m0, ^bash_fold_word_kind_var, "")
}

fn bash_fold_target_model_bundle_witness(
  emitted: Node,
  source_literal: Symbol,
  source_text: String,
  production_binding: Symbol,
  rule_name: Symbol
) -> Witness<Node> {
  match bash_fold_serialize_source_witness(
    emitted: emitted,
    source_literal: source_literal,
    production_binding: production_binding
  ) {
    Holds { value: serialize_source } =>
      Holds {
        value: bash_target_model_bundle(
          rules: bash_fold_translation_rules_node_for_emitted(
            emitted: emitted,
            lhs: production_binding,
            rule_name: rule_name
          ),
          serialize_source: serialize_source
        )
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_target_model_for_emitted_witness(
  emitted: Node,
  source_literal: Symbol,
  source_text: String,
  production_binding: Symbol,
  rule_name: Symbol
) -> Witness<TargetModel> {
  match bash_fold_target_model_bundle_witness(
    emitted: emitted,
    source_literal: source_literal,
    source_text: source_text,
    production_binding: production_binding,
    rule_name: rule_name
  ) {
    Holds { value: bundle } =>
      Holds {
        value: target_model_make_with_emit_transforms(
          bundle: bundle,
          lex: bash_fold_lex(),
          binding_spellings: bash_fold_binding_spellings(),
          token_class_emit_transforms: bash_fold_emit_transforms(),
          authority_source_text: source_text,
          runtime_row: target_emit_host_runtime_row_unconfigured
        )
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_fold_target_model_for_stmt_witness(stmt: ShellStmt) -> Witness<TargetModel> {
  match bash_fold_stmt_emitted_witness(stmt: stmt) {
    Holds { value: emitted } =>
      bash_fold_target_model_for_emitted_witness(
        emitted: emitted,
        source_literal: ^bash_fold_dynamic_source_literal,
        source_text: serialize_stmt(s: stmt),
        production_binding: bash_fold_production_binding_for_stmt(stmt: stmt),
        rule_name: bash_fold_relation_rule_for_stmt(stmt: stmt)
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

