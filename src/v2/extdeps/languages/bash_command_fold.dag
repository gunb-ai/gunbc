fn bash_fold_subshell_wrong_target_model_witness() -> Witness<TargetModel> {
  match bash_fold_stmt_bundle_witness(
    stmt: Subshell { body: [Command { words: [Lit { text: "true" }] }] }
  ) {
    Holds { value: bundle } =>
      bash_fold_target_model_for_emitted_witness(
        emitted: bundle.emitted,
        source_literal: ^bash_fold_subshell_wrong_source_literal,
        source_text: "(false)",
        production_binding: ^bash_production_fold_subshell,
        rule_name: ^bash_relation_rule_fold_subshell
      )
    Violates { diagnostic: _ } =>
      Violates {
        diagnostic: Diagnostic {
          reason: ^bash_fold_subshell_wrong_fixture_build_failed,
          at: node_locus(node: bash_fold_diagnostic_anchor),
          correction: Unavailable { reason: ExternalContractUnknown }
        }
      }
  }
}

fn bash_fold_if_wrong_target_model_witness() -> Witness<TargetModel> {
  match bash_fold_stmt_bundle_witness(
    stmt: If {
      cond: Command { words: [Lit { text: "true" }] },
      then: [Command { words: [Lit { text: "echo" }, Lit { text: "hi" }] }]
    }
  ) {
    Holds { value: bundle } =>
      bash_fold_target_model_for_emitted_witness(
        emitted: bundle.emitted,
        source_literal: ^bash_fold_if_wrong_source_literal,
        source_text: "if false; then 'echo' 'hi'; fi",
        production_binding: ^bash_production_fold_if,
        rule_name: ^bash_relation_rule_fold_if
      )
    Violates { diagnostic: _ } =>
      Violates {
        diagnostic: Diagnostic {
          reason: ^bash_fold_if_wrong_fixture_build_failed,
          at: node_locus(node: bash_fold_diagnostic_anchor),
          correction: Unavailable { reason: ExternalContractUnknown }
        }
      }
  }
}
