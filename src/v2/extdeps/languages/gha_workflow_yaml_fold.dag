    lhs: ^gha_production_fold_step_head,
    rhs: [
      gha_fold_prod_kind_tag_terminal(binding: ^gha_production_fold_step_head_run),
      grammar_formal_terminal(identity: ^gha_token_yaml_block_run_head),
      grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_scalar)
    ]
