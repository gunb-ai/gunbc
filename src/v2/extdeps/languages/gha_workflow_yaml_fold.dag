    ]
  )
}

fn gha_fold_job_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^gha_production_fold_job,
    rhs: [
      gha_fold_prod_kind_tag_terminal(binding: ^gha_production_fold_job),
      grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_runs_on),
      grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_steps_block),
      grammar_formal_terminal(identity: ^gha_token_yaml_job_trailing_newline)
    ]
  )
}

fn gha_fold_formal_productions() -> List<FormalProduction> {
  list_append(
    list_append(
      [gha_fold_scalar_leaf_production()],
      [
        gha_fold_flow_labels_leaf_production(),
        gha_fold_flow_labels_pair_production()
      ]
    ),
    list_append(
      [
        gha_fold_step_head_run_production(),
        gha_fold_step_head_uses_production(),
        gha_fold_step_tail_run_production(),
        gha_fold_step_tail_uses_production(),
        gha_fold_flat_step_head_run_production(),
        gha_fold_flat_step_tail_uses_production(),
        gha_fold_step_list_leaf_production(),
        gha_fold_step_list_pair_production()
      ],
      [
        gha_fold_runs_on_self_hosted_production(),
        gha_fold_steps_block_production(),
        gha_fold_job_production()
      ]
    )
  )
}

fn gha_fold_relation_row_witness(emitted: Node, lhs: Symbol) -> Witness<Node> {
  let productions = gha_fold_formal_productions()
  match formal_production_for_lhs_exact(
    productions: productions,
    lhs: lhs,
    child: emitted
  ) {
    Holds { value: production } =>
      derive_grammar_relation_row_node(
        production: production,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn gha_fold_formal_production_for_job_witness(emitted: Node) -> Witness<FormalProduction> {
  formal_production_for_lhs_exact(
    productions: gha_fold_formal_productions(),
    lhs: ^gha_production_fold_job,
    child: emitted
  )
}

data gha_fold_pilot_job_emitted: Node = gha_fold_job_emitted(
  runs_on: gha_fold_runs_on_self_hosted_emitted(
    labels: gha_fold_flow_labels_pair_emitted(
      left: gha_fold_flow_labels_single_emitted(
        label: gha_fold_scalar_emitted(text: "self-hosted")
      ),
      right: gha_fold_scalar_emitted(text: "linux")
    )
  ),
  steps_block: gha_fold_steps_block_emitted(
    step_list: gha_fold_step_list_pair_emitted(
      left: gha_fold_step_list_single_emitted(
        step_head: gha_fold_step_head_run_emitted(
          scalar: gha_fold_scalar_emitted(text: "echo hi")
        )
      ),
      right: gha_fold_step_tail_uses_emitted(
        scalar: gha_fold_scalar_emitted(text: "actions/checkout@v4")
      )
    )
  )
)

fn gha_fold_serialize_source_witness(
  emitted: Node,
  source_literal: Symbol,
  production_binding: Symbol
) -> Witness<Node> {
  match gha_fold_relation_row_witness(emitted: emitted, lhs: production_binding) {
    Holds { value: row } =>
      match find_named_child(root: row, name: ^grammar_relation_field_tokens) {
        Accepted { value: tokens_root, diagnostics: _ } =>
          Holds {
            value: Node {
              kind: TypeNode { connective: Conj },
              children: [
                bash_named_edge(
                  name: ^serialize_source_field_source_text,
                  target: bash_word_atom(id: source_literal)
                ),
                bash_named_edge(
                  name: ^serialize_source_field_source_grammar,
                  target: bash_word_atom(id: production_binding)
                ),
                bash_named_edge(
                  name: ^grammar_relation_field_tokens,
                  target: tokens_root
                )
              ],
              occurrence_id: SyntheticOccurrence
            }
          }
        Rejected { diagnostics: nd } => Violates { diagnostic: nd.head }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn gha_fold_translation_rules_node_for_emitted(
  emitted: Node,
  lhs: Symbol,
  rule_name: Symbol
) -> Witness<Node> {
  match gha_fold_relation_row_witness(emitted: emitted, lhs: lhs) {
    Holds { value: row } =>
      Holds {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            bash_named_edge(
              name: ^grammar_relation_rules_formal_productions,
              target: formal_productions_catalog_to_node(
                productions: gha_fold_formal_productions()
              )
            ),
            bash_named_edge(name: rule_name, target: row)
          ],
          occurrence_id: SyntheticOccurrence
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn gha_fold_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn gha_fold_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      gha_fold_lex_rule(token_class: ^gha_token_yaml_runs_on_prefix, text: "runs-on: ["),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_flow_sep, text: ", "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_runs_on_suffix, text: "]\n"),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_steps_header, text: "steps:\n"),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_block_run_head, text: "  - run: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_block_uses_head, text: "  - uses: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_block_run_tail, text: "\n  - run: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_block_uses_tail, text: "\n  - uses: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_flat_run_head, text: "run: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_flat_uses_tail, text: "\nuses: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_job_trailing_newline, text: "\n"),
      gha_fold_lex_rule(token_class: ^gha_fold_prod_kind_tag, text: "\u{0002}"),
      gha_fold_lex_rule(token_class: ^gha_fold_scalar_kind, text: "\u{0000}")
    ]
  }
}

fn gha_fold_lex() -> LexRules {
  ModeledLexRules { root: gha_fold_lex_rules() }
}

data gha_fold_kind_marker_dissolution_trigger: String = "🟡 dissolve-on: phantom \\u{0000}/\\u{0002} kind-marker lex bytes (gha_fold_scalar_kind / gha_fold_prod_kind_tag) and zero-width gha_fold_scalar_kind_emit_transform / gha_fold_kind_emit_transform are replaced by real YAML step-class lexing that disambiguates production tags without sentinel bytes"

fn gha_fold_kind_emit_transform(_spelling: String) -> String {
  ""
}

fn gha_fold_scalar_kind_emit_transform(_spelling: String) -> String {
  ""
}

fn gha_fold_identity_emit_transform(spelling: String) -> String {
  spelling
}

fn gha_fold_emit_transforms() -> Map<Symbol, fn(String) -> String> {
  let m0 = map_insert(empty_map(), ^gha_fold_prod_kind_tag, gha_fold_kind_emit_transform)
  let m1 = map_insert(m0, ^gha_fold_scalar_kind, gha_fold_scalar_kind_emit_transform)
  map_insert(m1, ^gha_token_scalar_value, gha_fold_identity_emit_transform)
}

fn gha_fold_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^gha_fold_prod_kind_tag, "")
  map_insert(m0, ^gha_fold_scalar_kind, "")
}

fn gha_fold_target_model_bundle_witness(
  emitted: Node,
  source_literal: Symbol,
  production_binding: Symbol,
  rule_name: Symbol
) -> Witness<Node> {
  match gha_fold_serialize_source_witness(
    emitted: emitted,
    source_literal: source_literal,
    production_binding: production_binding
  ) {
    Holds { value: serialize_source } =>
      match gha_fold_translation_rules_node_for_emitted(
        emitted: emitted,
        lhs: production_binding,
        rule_name: rule_name
      ) {
        Holds { value: rules } =>
          Holds {
            value: bash_target_model_bundle(
              rules: rules,
              serialize_source: serialize_source
            )
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn gha_fold_target_model_for_emitted_witness(
  emitted: Node,
  source_literal: Symbol,
  source_text: String,
  production_binding: Symbol,
  rule_name: Symbol
) -> Witness<TargetModel> {
  match gha_fold_target_model_bundle_witness(
    emitted: emitted,
    source_literal: source_literal,
    production_binding: production_binding,
    rule_name: rule_name
  ) {
    Holds { value: bundle } =>
      Holds {
        value: target_model_make_with_emit_transforms(
          bundle: bundle,
          lex: gha_fold_lex(),
          binding_spellings: gha_fold_binding_spellings(),
          token_class_emit_transforms: gha_fold_emit_transforms(),
          authority_source_text: source_text,
          runtime_row: target_emit_host_runtime_row_unconfigured
        )
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn gha_fold_job_emitted_witness(job: Job) -> Witness<Node> {
  match gha_fold_job_bundle_witness(job: job) {
    Holds { value: bundle } => Holds { value: bundle.emitted }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn gha_fold_target_model_for_job_witness(job: Job, source_text: String) -> Witness<TargetModel> {
  match gha_fold_job_bundle_witness(job: job) {
    Holds { value: bundle } =>
      gha_fold_target_model_for_emitted_witness(
        emitted: bundle.emitted,
        source_literal: ^gha_fold_dynamic_source_literal,
        source_text: source_text,
        production_binding: bundle.production_binding,
        rule_name: bundle.relation_rule
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn gha_fold_flat_step_head_run_emitted(scalar: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_flat_step_head_run)
      },
      Edge { label: Positional, target: scalar }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_flat_step_tail_uses_emitted(scalar: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_flat_step_tail_uses)
      },
      Edge { label: Positional, target: scalar }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

data gha_fold_flat_steps_wrong_emitted: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: gha_fold_prod_tag(binding: ^gha_production_fold_job)
    },
    Edge {
      label: Positional,
      target: gha_fold_runs_on_self_hosted_emitted(
        labels: gha_fold_flow_labels_pair_emitted(
          left: gha_fold_flow_labels_single_emitted(
            label: gha_fold_scalar_emitted(text: "self-hosted")
          ),
          right: gha_fold_scalar_emitted(text: "linux")
        )
      )
    },
    Edge {
      label: Positional,
      target: Node {
        kind: TypeNode { connective: Conj },
        children: [
          Edge {
            label: Positional,
            target: gha_fold_prod_tag(binding: ^gha_production_fold_steps_block)
          },
          Edge {
            label: Positional,
            target: gha_fold_step_list_pair_emitted(
              left: gha_fold_step_list_single_emitted(
                step_head: gha_fold_flat_step_head_run_emitted(
                  scalar: gha_fold_scalar_emitted(text: "echo hi")
                )
              ),
              right: gha_fold_flat_step_tail_uses_emitted(
                scalar: gha_fold_scalar_emitted(text: "actions/checkout@v4")
              )
            )
          }
        ],
        occurrence_id: SyntheticOccurrence
      }
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn gha_fold_flat_steps_wrong_target_model_witness(source_text: String) -> Witness<TargetModel> {
  gha_fold_target_model_for_emitted_witness(
    emitted: gha_fold_flat_steps_wrong_emitted,
    source_literal: ^gha_fold_flat_steps_wrong_source_literal,
    source_text: source_text,
    production_binding: ^gha_production_fold_job,
    rule_name: ^gha_relation_rule_fold_job
  )
}

data gha_fold_job_wrong_production_emitted: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [
    Edge {
      label: Positional,
      target: gha_fold_prod_tag(binding: ^gha_production_fold_runs_on_self_hosted)
    },
    Edge {
      label: Positional,
      target: gha_fold_flow_labels_single_emitted(
        label: gha_fold_scalar_emitted(text: "self-hosted")
      )
    }
  ],
  occurrence_id: SyntheticOccurrence
}

fn gha_fold_job_wrong_production_target_model_witness(source_text: String) -> Witness<TargetModel> {
  gha_fold_target_model_for_emitted_witness(
    emitted: gha_fold_job_wrong_production_emitted,
    source_literal: ^gha_fold_job_wrong_production_source_literal,
    source_text: source_text,
    production_binding: ^gha_production_fold_job,
    rule_name: ^gha_relation_rule_fold_job
  )
}
