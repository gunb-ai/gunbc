type GhaFoldStepBundle {
  production_binding: Symbol,
  relation_rule: Symbol,
  emitted: Node
}

type GhaFoldJobBundle {
  production_binding: Symbol,
  relation_rule: Symbol,
  emitted: Node
}

fn gha_fold_prod_tag(binding: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: binding } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_prod_kind_tag_terminal(binding: Symbol) -> FormalGrammarSymbol {
  grammar_formal_terminal_bound(
    identity: ^gha_fold_prod_kind_tag,
    binding: binding
  )
}

data gha_fold_diagnostic_anchor: Node = Node {
  kind: TypeNode { connective: Conj },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data gha_fold_diagnostic_anchor_dissolution_trigger: String = "🟡 dissolve-on: gha_fold_diagnostic_anchor — shared empty Conj placeholder locus for fold reject diagnostics (gha_fold_unsupported_variant_diagnostic, unsupported step kind / empty step list / non-self-hosted runner rejects, wrong-production and flat-steps perturbation witnesses). DISSOLVES WHEN GHA fold serialize lands beyond the pilot: production emit callers surface Violates diagnostics through emit() with node_locus over the offending Job/Step subtree in GhaFoldJobBundle.emitted, retiring the synthetic anchor."

fn gha_fold_unsupported_variant_diagnostic(variant: Symbol) -> Diagnostic {
  Diagnostic {
    reason: variant,
    at: node_locus(node: gha_fold_diagnostic_anchor),
    correction: Unavailable { reason: ExternalContractUnknown }
  }
}

fn gha_fold_scalar_emitted(text: String) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: ^gha_fold_scalar_kind } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      },
      Edge {
        label: Positional,
        target: Node {
          kind: TypeNode { connective: Atom { identity: emit_inline_scalar_text(s: text) } },
          children: [],
          occurrence_id: SyntheticOccurrence
        }
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_flow_labels_single_emitted(label: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [Edge { label: Positional, target: label }],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_flow_labels_pair_emitted(left: Node, right: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: left },
      Edge { label: Positional, target: right }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_flow_labels_emitted_from_list_suffix_witness(
  labels: List<String>,
  accumulated: Node,
  index: Int
) -> Witness<Node> {
  match list_at_optional(xs: labels, index: index) {
    Present { value: label } =>
      gha_fold_flow_labels_emitted_from_list_suffix_witness(
        labels: labels,
        accumulated: gha_fold_flow_labels_pair_emitted(
          left: accumulated,
          right: gha_fold_scalar_emitted(text: label)
        ),
        index: index + 1
      )
    Absent => Holds { value: accumulated }
  }
}

fn gha_fold_flow_labels_emitted_witness(labels: List<String>) -> Witness<Node> {
  match list_nth(
    xs: labels,
    wanted: 0,
    absent: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_flow_labels_empty)
  ) {
    Holds { value: first } =>
      gha_fold_flow_labels_emitted_from_list_suffix_witness(
        labels: labels,
        accumulated: gha_fold_flow_labels_single_emitted(
          label: gha_fold_scalar_emitted(text: first)
        ),
        index: 1
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn gha_fold_runs_on_self_hosted_emitted(labels: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_runs_on_self_hosted)
      },
      Edge { label: Positional, target: labels }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_step_head_run_emitted(scalar: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_step_head_run)
      },
      Edge { label: Positional, target: scalar }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_step_head_uses_emitted(scalar: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_step_head_uses)
      },
      Edge { label: Positional, target: scalar }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_step_tail_run_emitted(scalar: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_step_tail_run)
      },
      Edge { label: Positional, target: scalar }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_step_tail_uses_emitted(scalar: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_step_tail_uses)
      },
      Edge { label: Positional, target: scalar }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_uses_ref_text(uses: ActionRef) -> String {
  concat(
    concat(concat(concat(uses.owner, "/"), uses.repo), "@"),
    uses.ref
  )
}

fn gha_fold_step_head_emitted_from_emit(emit: GhaPilotStepEmit) -> Witness<Node> {
  match emit {
    GhaPilotRunEmit { run: r } =>
      Holds {
        value: gha_fold_step_head_run_emitted(
          scalar: gha_fold_scalar_emitted(text: r)
        )
      }
    GhaPilotUsesEmit { uses: u } =>
      Holds {
        value: gha_fold_step_head_uses_emitted(
          scalar: gha_fold_scalar_emitted(text: gha_fold_uses_ref_text(uses: u))
        )
      }
  }
}

fn gha_fold_step_tail_emitted_from_emit(emit: GhaPilotStepEmit) -> Witness<Node> {
  match emit {
    GhaPilotRunEmit { run: r } =>
      Holds {
        value: gha_fold_step_tail_run_emitted(
          scalar: gha_fold_scalar_emitted(text: r)
        )
      }
    GhaPilotUsesEmit { uses: u } =>
      Holds {
        value: gha_fold_step_tail_uses_emitted(
          scalar: gha_fold_scalar_emitted(text: gha_fold_uses_ref_text(uses: u))
        )
      }
  }
}

fn gha_fold_step_list_emitted_from_suffix_witness(
  job: Job,
  accumulated: Node,
  index: Int
) -> Witness<Node> {
  match list_at_optional(xs: job.steps, index: index) {
    Present { value: step } =>
      match gha_fold_pilot_emit_step(step: step) {
        Present { value: emit } =>
          match gha_fold_step_tail_emitted_from_emit(emit: emit) {
            Holds { value: tail } =>
              gha_fold_step_list_emitted_from_suffix_witness(
                job: job,
                accumulated: gha_fold_step_list_pair_emitted(left: accumulated, right: tail),
                index: index + 1
              )
            Violates { diagnostic: d } => Violates { diagnostic: d }
          }
        Absent =>
          Violates {
            diagnostic: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_unsupported_step_kind)
          }
      }
    Absent => Holds { value: accumulated }
  }
}

fn gha_fold_step_list_emitted_witness(job: Job) -> Witness<Node> {
  match list_nth(
    xs: job.steps,
    wanted: 0,
    absent: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_step_list_empty)
  ) {
    Holds { value: first } =>
      match gha_fold_pilot_emit_step(step: first) {
        Present { value: emit } =>
          match gha_fold_step_head_emitted_from_emit(emit: emit) {
            Holds { value: head } =>
              gha_fold_step_list_emitted_from_suffix_witness(
                job: job,
                accumulated: gha_fold_step_list_single_emitted(step_head: head),
                index: 1
              )
            Violates { diagnostic: d } => Violates { diagnostic: d }
          }
        Absent =>
          Violates {
            diagnostic: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_unsupported_step_kind)
          }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn gha_fold_step_list_single_emitted(step_head: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: step_head }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_step_list_pair_emitted(left: Node, right: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge { label: Positional, target: left },
      Edge { label: Positional, target: right }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_steps_block_emitted(step_list: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_steps_block)
      },
      Edge { label: Positional, target: step_list }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_job_emitted(runs_on: Node, steps_block: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_job)
      },
      Edge { label: Positional, target: runs_on },
      Edge { label: Positional, target: steps_block }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn gha_fold_job_bundle_witness(job: Job) -> Witness<GhaFoldJobBundle> {
  match job.runner {
    SelfHosted { labels: ls } =>
      match gha_fold_flow_labels_emitted_witness(labels: ls) {
        Holds { value: flow_labels } =>
          match gha_fold_step_list_emitted_witness(job: job) {
            Holds { value: step_list } =>
              Holds {
                value: GhaFoldJobBundle {
                  production_binding: ^gha_production_fold_job,
                  relation_rule: ^gha_relation_rule_fold_job,
                  emitted: gha_fold_job_emitted(
                    runs_on: gha_fold_runs_on_self_hosted_emitted(labels: flow_labels),
                    steps_block: gha_fold_steps_block_emitted(step_list: step_list)
                  )
                }
              }
            Violates { diagnostic: d } => Violates { diagnostic: d }
          }
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    _ =>
      Violates {
        diagnostic: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_runner_not_self_hosted_pilot)
      }
  }
}

fn gha_fold_scalar_leaf_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^gha_production_fold_scalar,
    rhs: [
      grammar_formal_terminal_bound(identity: ^gha_fold_scalar_kind, binding: ^gha_fold_scalar_kind),
      grammar_formal_terminal_free(identity: ^gha_token_scalar_value)
    ]
  )
}

fn gha_fold_flow_labels_leaf_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^gha_production_fold_flow_labels,
    rhs: [grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_scalar)]
  )
}

fn gha_fold_flow_labels_pair_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^gha_production_fold_flow_labels,
    rhs: [
      grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_flow_labels),
      grammar_formal_terminal(identity: ^gha_token_yaml_flow_sep),
      grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_scalar)
    ]
  )
}

