  grammar_formal_production(
    lhs: ^gha_production_fold_runs_on,
    rhs: [
      gha_fold_prod_kind_tag_terminal(binding: ^gha_production_fold_runs_on_self_hosted),
      grammar_formal_terminal(identity: ^gha_token_yaml_runs_on_prefix),
      grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_flow_labels),
      grammar_formal_terminal(identity: ^gha_token_yaml_runs_on_suffix)
    ]
  )
