    lhs: ^gha_production_fold_step_tail,
    rhs: [
      gha_fold_prod_kind_tag_terminal(binding: ^gha_production_fold_flat_step_tail_uses),
      v2.std.grammar.grammar_formal_terminal(identity: ^gha_token_yaml_flat_uses_tail),
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_scalar)
    ]
