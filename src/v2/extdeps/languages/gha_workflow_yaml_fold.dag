      gha_fold_prod_kind_tag_terminal(binding: ^gha_production_fold_step_head_run),
      v2.std.grammar.grammar_formal_terminal(identity: ^gha_token_yaml_block_run_head),
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_scalar)
    ]
  )
}

fn gha_fold_step_head_uses_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
