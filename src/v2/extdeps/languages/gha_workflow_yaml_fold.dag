module v2.extdeps.languages.gha_workflow_yaml_fold


type GhaFoldStepBundle {
  production_binding: v2.std.node.Symbol,
  relation_rule: v2.std.node.Symbol,
  emitted: v2.std.node.Node
}

type GhaFoldJobBundle {
  production_binding: v2.std.node.Symbol,
  relation_rule: v2.std.node.Symbol,
  emitted: v2.std.node.Node
}

fn gha_fold_prod_tag(binding: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: binding } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_prod_kind_tag_terminal(binding: v2.std.node.Symbol) -> v2.std.grammar.FormalGrammarSymbol {
  v2.std.grammar.grammar_formal_terminal_bound(
    identity: ^gha_fold_prod_kind_tag,
    binding: binding
  )
}

data gha_fold_diagnostic_anchor: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

fn gha_fold_unsupported_variant_diagnostic(variant: v2.std.node.Symbol) -> v2.std.diagnostic.Diagnostic {
  v2.std.diagnostic.Diagnostic {
    reason: variant,
    at: v2.std.diagnostic.node_locus(node: gha_fold_diagnostic_anchor),
    correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
  }
}

fn gha_fold_scalar_emitted(text: String) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^gha_fold_scalar_kind } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      },
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: extdeps.languages.yaml.emit.emit_inline_scalar_text(s: text) } },
          children: [],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_flow_labels_single_emitted(label: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [v2.std.node.Edge { label: v2.std.node.Positional, target: label }],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_flow_labels_pair_emitted(left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: left },
      v2.std.node.Edge { label: v2.std.node.Positional, target: right }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_flow_labels_emitted_from_list_suffix_witness(
  labels: List<String>,
  accumulated: v2.std.node.Node,
  index: Int
) -> v2.std.witness.Witness<v2.std.node.Node> {
  match v2.std.collection.list_at_optional(xs: labels, index: index) {
    v2.std.optional.Present { value: label } =>
      gha_fold_flow_labels_emitted_from_list_suffix_witness(
        labels: labels,
        accumulated: gha_fold_flow_labels_pair_emitted(
          left: accumulated,
          right: gha_fold_scalar_emitted(text: label)
        ),
        index: index + 1
      )
    v2.std.optional.Absent => v2.std.witness.Holds { value: accumulated }
  }
}

fn gha_fold_flow_labels_emitted_witness(labels: List<String>) -> v2.std.witness.Witness<v2.std.node.Node> {
  match v2.std.collection.list_nth(
    xs: labels,
    wanted: 0,
    absent: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_flow_labels_empty)
  ) {
    Holds { value: first } =>
      gha_fold_flow_labels_emitted_from_list_suffix_witness(
        labels: labels,
        accumulated: gha_fold_flow_labels_single_emitted(
          label: gha_fold_scalar_emitted(text: first)
        ),
        index: 1
      )
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn gha_fold_runs_on_self_hosted_emitted(labels: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_runs_on_self_hosted)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: labels }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_step_head_run_emitted(scalar: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_step_head_run)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: scalar }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_step_head_uses_emitted(scalar: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_step_head_uses)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: scalar }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_step_tail_run_emitted(scalar: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_step_tail_run)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: scalar }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_step_tail_uses_emitted(scalar: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_step_tail_uses)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: scalar }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_uses_ref_text(uses: extdeps.github.actions.ActionRef) -> String {
  concat(
    concat(concat(concat(uses.owner, "/"), uses.repo), "@"),
    uses.ref
  )
}

fn gha_fold_step_head_emitted_from_emit(emit: v2.extdeps.github.gha_fold_pilot_emit.GhaPilotStepEmit) -> v2.std.witness.Witness<v2.std.node.Node> {
  match emit {
    GhaPilotRunEmit { run: r } =>
      v2.std.witness.Holds {
        value: gha_fold_step_head_run_emitted(
          scalar: gha_fold_scalar_emitted(text: r)
        )
      }
    GhaPilotUsesEmit { uses: u } =>
      v2.std.witness.Holds {
        value: gha_fold_step_head_uses_emitted(
          scalar: gha_fold_scalar_emitted(text: gha_fold_uses_ref_text(uses: u))
        )
      }
  }
}

fn gha_fold_step_tail_emitted_from_emit(emit: v2.extdeps.github.gha_fold_pilot_emit.GhaPilotStepEmit) -> v2.std.witness.Witness<v2.std.node.Node> {
  match emit {
    GhaPilotRunEmit { run: r } =>
      v2.std.witness.Holds {
        value: gha_fold_step_tail_run_emitted(
          scalar: gha_fold_scalar_emitted(text: r)
        )
      }
    GhaPilotUsesEmit { uses: u } =>
      v2.std.witness.Holds {
        value: gha_fold_step_tail_uses_emitted(
          scalar: gha_fold_scalar_emitted(text: gha_fold_uses_ref_text(uses: u))
        )
      }
  }
}

fn gha_fold_step_list_emitted_from_suffix_witness(
  job: extdeps.github.actions.Job,
  accumulated: v2.std.node.Node,
  index: Int
) -> v2.std.witness.Witness<v2.std.node.Node> {
  match v2.std.collection.list_at_optional(xs: job.steps, index: index) {
    v2.std.optional.Present { value: step } =>
      match v2.extdeps.github.gha_fold_pilot_emit.gha_fold_pilot_emit_step(step: step) {
        v2.std.optional.Present { value: emit } =>
          match gha_fold_step_tail_emitted_from_emit(emit: emit) {
            Holds { value: tail } =>
              gha_fold_step_list_emitted_from_suffix_witness(
                job: job,
                accumulated: gha_fold_step_list_pair_emitted(left: accumulated, right: tail),
                index: index + 1
              )
            Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
          }
        v2.std.optional.Absent =>
          v2.std.witness.Violates {
            diagnostic: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_unsupported_step_kind)
          }
      }
    v2.std.optional.Absent => v2.std.witness.Holds { value: accumulated }
  }
}

fn gha_fold_step_list_emitted_witness(job: extdeps.github.actions.Job) -> v2.std.witness.Witness<v2.std.node.Node> {
  match v2.std.collection.list_nth(
    xs: job.steps,
    wanted: 0,
    absent: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_step_list_empty)
  ) {
    Holds { value: first } =>
      match v2.extdeps.github.gha_fold_pilot_emit.gha_fold_pilot_emit_step(step: first) {
        v2.std.optional.Present { value: emit } =>
          match gha_fold_step_head_emitted_from_emit(emit: emit) {
            Holds { value: head } =>
              gha_fold_step_list_emitted_from_suffix_witness(
                job: job,
                accumulated: gha_fold_step_list_single_emitted(step_head: head),
                index: 1
              )
            Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
          }
        v2.std.optional.Absent =>
          v2.std.witness.Violates {
            diagnostic: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_unsupported_step_kind)
          }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn gha_fold_step_list_single_emitted(step_head: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: step_head }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_step_list_pair_emitted(left: v2.std.node.Node, right: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: left },
      v2.std.node.Edge { label: v2.std.node.Positional, target: right }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_steps_block_emitted(step_list: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_steps_block)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: step_list }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_job_emitted(runs_on: v2.std.node.Node, steps_block: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_job)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: runs_on },
      v2.std.node.Edge { label: v2.std.node.Positional, target: steps_block }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_job_bundle_witness(job: extdeps.github.actions.Job) -> v2.std.witness.Witness<GhaFoldJobBundle> {
  match job.runner {
    SelfHosted { labels: ls } =>
      match gha_fold_flow_labels_emitted_witness(labels: ls) {
        Holds { value: flow_labels } =>
          match gha_fold_step_list_emitted_witness(job: job) {
            Holds { value: step_list } =>
              v2.std.witness.Holds {
                value: GhaFoldJobBundle {
                  production_binding: ^gha_production_fold_job,
                  relation_rule: ^gha_relation_rule_fold_job,
                  emitted: gha_fold_job_emitted(
                    runs_on: gha_fold_runs_on_self_hosted_emitted(labels: flow_labels),
                    steps_block: gha_fold_steps_block_emitted(step_list: step_list)
                  )
                }
              }
            Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
          }
        Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    _ =>
      v2.std.witness.Violates {
        diagnostic: gha_fold_unsupported_variant_diagnostic(variant: ^gha_fold_runner_not_self_hosted_pilot)
      }
  }
}

fn gha_fold_scalar_leaf_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^gha_production_fold_scalar,
    rhs: [
      v2.std.grammar.grammar_formal_terminal_bound(identity: ^gha_fold_scalar_kind, binding: ^gha_fold_scalar_kind),
      v2.std.grammar.grammar_formal_terminal_free(identity: ^gha_token_scalar_value)
    ]
  )
}

fn gha_fold_flow_labels_leaf_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^gha_production_fold_flow_labels,
    rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_scalar)]
  )
}

fn gha_fold_flow_labels_pair_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^gha_production_fold_flow_labels,
    rhs: [
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_flow_labels),
      v2.std.grammar.grammar_formal_terminal(identity: ^gha_token_yaml_flow_sep),
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_scalar)
    ]
  )
}

