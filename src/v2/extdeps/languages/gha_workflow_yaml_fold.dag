fn gha_fold_runs_on_self_hosted_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^gha_production_fold_runs_on,
    rhs: [
      gha_fold_prod_kind_tag_terminal(binding: ^gha_production_fold_runs_on_self_hosted),
      v2.std.grammar.grammar_formal_terminal(identity: ^gha_token_yaml_runs_on_prefix),
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_flow_labels),
      v2.std.grammar.grammar_formal_terminal(identity: ^gha_token_yaml_runs_on_suffix)
    ]
  )
}

fn gha_fold_steps_block_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^gha_production_fold_steps_block,
    rhs: [
      gha_fold_prod_kind_tag_terminal(binding: ^gha_production_fold_steps_block),
      v2.std.grammar.grammar_formal_terminal(identity: ^gha_token_yaml_steps_header),
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_step_list)
    ]
  )
}

fn gha_fold_job_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^gha_production_fold_job,
    rhs: [
      gha_fold_prod_kind_tag_terminal(binding: ^gha_production_fold_job),
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_runs_on),
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^gha_production_fold_steps_block),
      v2.std.grammar.grammar_formal_terminal(identity: ^gha_token_yaml_job_trailing_newline)
    ]
  )
}

fn gha_fold_formal_productions() -> List<v2.std.grammar.FormalProduction> {
  v2.std.algebra.list_append(
    v2.std.algebra.list_append(
      [gha_fold_scalar_leaf_production()],
      [
        gha_fold_flow_labels_leaf_production(),
        gha_fold_flow_labels_pair_production()
      ]
    ),
    v2.std.algebra.list_append(
      [
        gha_fold_step_head_run_production(),
        gha_fold_step_head_uses_production(),
        gha_fold_step_tail_run_production(),
        gha_fold_step_tail_uses_production(),
        gha_fold_flat_step_head_run_production(),
        gha_fold_flat_step_tail_uses_production(),
        gha_fold_step_list_leaf_production(),
        gha_fold_step_list_pair_production()
      ],
      [
        gha_fold_runs_on_self_hosted_production(),
        gha_fold_steps_block_production(),
        gha_fold_job_production()
      ]
    )
  )
}

fn gha_fold_relation_row_witness(emitted: v2.std.node.Node, lhs: v2.std.node.Symbol) -> v2.std.witness.Witness<v2.std.node.Node> {
  let productions = gha_fold_formal_productions()
  match v2.std.grammar.formal_production_for_lhs_exact(
    productions: productions,
    lhs: lhs,
    child: emitted
  ) {
    Holds { value: production } =>
      v2.std.grammar.derive_grammar_relation_row_node(
        production: production,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn gha_fold_formal_production_for_job_witness(emitted: v2.std.node.Node) -> v2.std.witness.Witness<v2.std.grammar.FormalProduction> {
  v2.std.grammar.formal_production_for_lhs_exact(
    productions: gha_fold_formal_productions(),
    lhs: ^gha_production_fold_job,
    child: emitted
  )
}

data gha_fold_pilot_job_emitted: v2.std.node.Node = gha_fold_job_emitted(
  runs_on: gha_fold_runs_on_self_hosted_emitted(
    labels: gha_fold_flow_labels_pair_emitted(
      left: gha_fold_flow_labels_single_emitted(
        label: gha_fold_scalar_emitted(text: "self-hosted")
      ),
      right: gha_fold_scalar_emitted(text: "linux")
    )
  ),
  steps_block: gha_fold_steps_block_emitted(
    step_list: gha_fold_step_list_pair_emitted(
      left: gha_fold_step_list_single_emitted(
        step_head: gha_fold_step_head_run_emitted(
          scalar: gha_fold_scalar_emitted(text: "echo hi")
        )
      ),
      right: gha_fold_step_tail_uses_emitted(
        scalar: gha_fold_scalar_emitted(text: "actions/checkout@v4")
      )
    )
  )
)

fn gha_fold_serialize_source_witness(
  emitted: v2.std.node.Node,
  source_literal: v2.std.node.Symbol,
  production_binding: v2.std.node.Symbol
) -> v2.std.witness.Witness<v2.std.node.Node> {
  match gha_fold_relation_row_witness(emitted: emitted, lhs: production_binding) {
    Holds { value: row } =>
      match v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_tokens) {
        Accepted { value: tokens_root, diagnostics: _ } =>
          v2.std.witness.Holds {
            value: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
              children: [
                v2.extdeps.languages.bash.bash_named_edge(
                  name: ^serialize_source_field_source_text,
                  target: v2.extdeps.languages.bash.bash_word_atom(id: source_literal)
                ),
                v2.extdeps.languages.bash.bash_named_edge(
                  name: ^serialize_source_field_source_grammar,
                  target: v2.extdeps.languages.bash.bash_word_atom(id: production_binding)
                ),
                v2.extdeps.languages.bash.bash_named_edge(
                  name: ^grammar_relation_field_tokens,
                  target: tokens_root
                )
              ],
              occurrence_id: v2.std.node.SyntheticOccurrence
            }
          }
        Rejected { diagnostics: nd } => v2.std.witness.Violates { diagnostic: nd.head }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn gha_fold_translation_rules_node_for_emitted(
  emitted: v2.std.node.Node,
  lhs: v2.std.node.Symbol,
  rule_name: v2.std.node.Symbol
) -> v2.std.witness.Witness<v2.std.node.Node> {
  match gha_fold_relation_row_witness(emitted: emitted, lhs: lhs) {
    Holds { value: row } =>
      v2.std.witness.Holds {
        value: v2.std.node.Node {
          kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
          children: [
            v2.extdeps.languages.bash.bash_named_edge(
              name: ^grammar_relation_rules_formal_productions,
              target: v2.std.grammar.formal_productions_catalog_to_node(
                productions: gha_fold_formal_productions()
              )
            ),
            v2.extdeps.languages.bash.bash_named_edge(name: rule_name, target: row)
          ],
          occurrence_id: v2.std.node.SyntheticOccurrence
        }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn gha_fold_lex_rule(token_class: v2.std.node.Symbol, text: String) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: token_class,
    pattern: v2.std.compilers.lexing.LiteralPattern { text: text }
  }
}

data gha_fold_prod_kind_sentinel: String = "\u{0002}"
data gha_fold_scalar_kind_sentinel: String = "\u{0000}"

fn gha_fold_lex_rules() -> v2.std.compilers.lexing.LexRuleSet {
  v2.std.compilers.lexing.LexRuleSet {
    rules: [
      gha_fold_lex_rule(token_class: ^gha_token_yaml_runs_on_prefix, text: "runs-on: ["),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_flow_sep, text: ", "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_runs_on_suffix, text: "]\n"),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_steps_header, text: "steps:\n"),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_block_run_head, text: "  - run: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_block_uses_head, text: "  - uses: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_block_run_tail, text: "\n  - run: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_block_uses_tail, text: "\n  - uses: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_flat_run_head, text: "run: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_flat_uses_tail, text: "\nuses: "),
      gha_fold_lex_rule(token_class: ^gha_token_yaml_job_trailing_newline, text: "\n"),
      gha_fold_lex_rule(token_class: ^gha_fold_prod_kind_tag, text: gha_fold_prod_kind_sentinel),
      gha_fold_lex_rule(token_class: ^gha_fold_scalar_kind, text: gha_fold_scalar_kind_sentinel)
    ]
  }
}

fn gha_fold_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules { root: gha_fold_lex_rules() }
}

fn gha_fold_kind_emit_transform(_spelling: String) -> String {
  ""
}

fn gha_fold_scalar_kind_emit_transform(_spelling: String) -> String {
  ""
}

fn gha_fold_identity_emit_transform(spelling: String) -> String {
  spelling
}

fn gha_fold_emit_transforms() -> Map<v2.std.node.Symbol, fn(String) -> String> {
  let m0 = v2.std.collection.map_insert(v2.std.collection.empty_map(), ^gha_fold_prod_kind_tag, gha_fold_kind_emit_transform)
  let m1 = v2.std.collection.map_insert(m0, ^gha_fold_scalar_kind, gha_fold_scalar_kind_emit_transform)
  v2.std.collection.map_insert(m1, ^gha_token_scalar_value, gha_fold_identity_emit_transform)
}

fn gha_fold_binding_spellings() -> Map<v2.std.node.Symbol, String> {
  let m0 = v2.std.collection.map_insert(v2.std.collection.empty_map(), ^gha_fold_prod_kind_tag, "")
  v2.std.collection.map_insert(m0, ^gha_fold_scalar_kind, "")
}

fn gha_fold_target_model_bundle_witness(
  emitted: v2.std.node.Node,
  source_literal: v2.std.node.Symbol,
  production_binding: v2.std.node.Symbol,
  rule_name: v2.std.node.Symbol
) -> v2.std.witness.Witness<v2.std.node.Node> {
  match gha_fold_serialize_source_witness(
    emitted: emitted,
    source_literal: source_literal,
    production_binding: production_binding
  ) {
    Holds { value: serialize_source } =>
      match gha_fold_translation_rules_node_for_emitted(
        emitted: emitted,
        lhs: production_binding,
        rule_name: rule_name
      ) {
        Holds { value: rules } =>
          v2.std.witness.Holds {
            value: v2.extdeps.languages.bash.bash_target_model_bundle(
              rules: rules,
              serialize_source: serialize_source
            )
          }
        Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn gha_fold_target_model_for_emitted_witness(
  emitted: v2.std.node.Node,
  source_literal: v2.std.node.Symbol,
  source_text: String,
  production_binding: v2.std.node.Symbol,
  rule_name: v2.std.node.Symbol
) -> v2.std.witness.Witness<v2.std.compilers.target_model.TargetModel> {
  match gha_fold_target_model_bundle_witness(
    emitted: emitted,
    source_literal: source_literal,
    production_binding: production_binding,
    rule_name: rule_name
  ) {
    Holds { value: bundle } =>
      v2.std.witness.Holds {
        value: v2.std.compilers.target_model.target_model_make_with_emit_transforms(
          bundle: bundle,
          lex: gha_fold_lex(),
          binding_spellings: gha_fold_binding_spellings(),
          token_class_emit_transforms: gha_fold_emit_transforms(),
          authority_source_text: source_text,
          runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
        )
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn gha_fold_job_emitted_witness(job: extdeps.github.actions.Job) -> v2.std.witness.Witness<v2.std.node.Node> {
  match gha_fold_job_bundle_witness(job: job) {
    Holds { value: bundle } => v2.std.witness.Holds { value: bundle.emitted }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn gha_fold_target_model_for_job_witness(job: extdeps.github.actions.Job, source_text: String) -> v2.std.witness.Witness<v2.std.compilers.target_model.TargetModel> {
  match gha_fold_job_bundle_witness(job: job) {
    Holds { value: bundle } =>
      gha_fold_target_model_for_emitted_witness(
        emitted: bundle.emitted,
        source_literal: ^gha_fold_dynamic_source_literal,
        source_text: source_text,
        production_binding: bundle.production_binding,
        rule_name: bundle.relation_rule
      )
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn gha_fold_flat_step_head_run_emitted(scalar: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_flat_step_head_run)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: scalar }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn gha_fold_flat_step_tail_uses_emitted(scalar: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: gha_fold_prod_tag(binding: ^gha_production_fold_flat_step_tail_uses)
      },
      v2.std.node.Edge { label: v2.std.node.Positional, target: scalar }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

data gha_fold_flat_steps_wrong_emitted: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Positional,
      target: gha_fold_prod_tag(binding: ^gha_production_fold_job)
    },
    v2.std.node.Edge {
      label: v2.std.node.Positional,
      target: gha_fold_runs_on_self_hosted_emitted(
        labels: gha_fold_flow_labels_pair_emitted(
          left: gha_fold_flow_labels_single_emitted(
            label: gha_fold_scalar_emitted(text: "self-hosted")
          ),
          right: gha_fold_scalar_emitted(text: "linux")
        )
      )
    },
    v2.std.node.Edge {
      label: v2.std.node.Positional,
      target: v2.std.node.Node {
        kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
        children: [
          v2.std.node.Edge {
            label: v2.std.node.Positional,
            target: gha_fold_prod_tag(binding: ^gha_production_fold_steps_block)
          },
          v2.std.node.Edge {
            label: v2.std.node.Positional,
            target: gha_fold_step_list_pair_emitted(
              left: gha_fold_step_list_single_emitted(
                step_head: gha_fold_flat_step_head_run_emitted(
                  scalar: gha_fold_scalar_emitted(text: "echo hi")
                )
              ),
              right: gha_fold_flat_step_tail_uses_emitted(
                scalar: gha_fold_scalar_emitted(text: "actions/checkout@v4")
              )
            )
          }
        ],
        occurrence_id: v2.std.node.SyntheticOccurrence
      }
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

fn gha_fold_flat_steps_wrong_target_model_witness(source_text: String) -> v2.std.witness.Witness<v2.std.compilers.target_model.TargetModel> {
  gha_fold_target_model_for_emitted_witness(
    emitted: gha_fold_flat_steps_wrong_emitted,
    source_literal: ^gha_fold_flat_steps_wrong_source_literal,
    source_text: source_text,
    production_binding: ^gha_production_fold_job,
    rule_name: ^gha_relation_rule_fold_job
  )
}

data gha_fold_job_wrong_production_emitted: v2.std.node.Node = v2.std.node.Node {
  kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
  children: [
    v2.std.node.Edge {
      label: v2.std.node.Positional,
      target: gha_fold_prod_tag(binding: ^gha_production_fold_runs_on_self_hosted)
    },
    v2.std.node.Edge {
      label: v2.std.node.Positional,
      target: gha_fold_flow_labels_single_emitted(
        label: gha_fold_scalar_emitted(text: "self-hosted")
      )
    }
  ],
  occurrence_id: v2.std.node.SyntheticOccurrence
}

fn gha_fold_job_wrong_production_target_model_witness(source_text: String) -> v2.std.witness.Witness<v2.std.compilers.target_model.TargetModel> {
  gha_fold_target_model_for_emitted_witness(
    emitted: gha_fold_job_wrong_production_emitted,
    source_literal: ^gha_fold_job_wrong_production_source_literal,
    source_text: source_text,
    production_binding: ^gha_production_fold_job,
    rule_name: ^gha_relation_rule_fold_job
  )
}
