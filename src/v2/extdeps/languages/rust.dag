    occurrence_id: SyntheticOccurrence
}
}

fn rust_sg2_malformed_sum_extra_positional_emitted() -> Node {
  let base = rust_sg2_sum_xy_emitted()
  Node {
    kind: base.kind,
    children: list_snoc_item(
      xs: base.children,
      item: Edge {
        label: Positional,
        target: rust_sg2_atom_node(binding: ^rust_binding_sg2_y)
      }
    ),
    occurrence_id: SyntheticOccurrence
}
}
