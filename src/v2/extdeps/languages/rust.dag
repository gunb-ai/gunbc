fn rust_sg2_emitted_without_named_edge(base: Node, field: Symbol) -> Node {
  Node {
    kind: base.kind,
    children: fold(base.children, init: Empty, f: fn(acc, e) {
      match e.label {
        Named { name: n } =>
          if n == field {
            acc
          } else {
            list_snoc_item(xs: acc, item: e)
          }
        Positional => list_snoc_item(xs: acc, item: e)
      }
    }),
    occurrence_id: SyntheticOccurrence
}
}

fn rust_sg2_malformed_atom_missing_surface_emitted() -> Node {
