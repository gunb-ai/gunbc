      rust_named_edge(name: ^rust_inhabitant_field_bool, target: rust_noninteger_inhabitant_node(id: ^rust_inhabitant_bool, facts: rust_facts_bool)),
      rust_named_edge(name: ^rust_inhabitant_field_char, target: rust_noninteger_inhabitant_node(id: ^rust_inhabitant_char, facts: rust_facts_char)),
      rust_named_edge(name: ^rust_inhabitant_field_str, target: rust_noninteger_inhabitant_node(id: ^rust_inhabitant_str, facts: rust_facts_str)),
      rust_named_edge(name: ^rust_inhabitant_field_unit, target: rust_noninteger_inhabitant_node(id: ^rust_inhabitant_unit, facts: rust_facts_unit)),
      rust_named_edge(name: ^rust_inhabitant_field_never, target: rust_noninteger_inhabitant_node(id: ^rust_inhabitant_never, facts: rust_facts_never))
