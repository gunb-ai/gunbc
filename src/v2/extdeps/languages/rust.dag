fn rust_collection_repr_bundle_node(form: TargetRepresentation) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^target_collection_repr_field_kind,
        target: rust_inhabitant_atom(id: discriminant(v: form.kind))
      ),
      rust_named_edge(
        name: ^target_collection_repr_field_apply,
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            rust_named_edge(
              name: ^target_type_expr_field_surface,
              target: rust_inhabitant_atom(id: form.apply.surface)
            ),
            rust_named_edge(
              name: ^target_type_expr_field_open,
              target: rust_inhabitant_atom(id: form.apply.open)
            ),
            rust_named_edge(
              name: ^target_type_expr_field_separator,
              target: rust_inhabitant_atom(id: form.apply.separator)
            ),
            rust_named_edge(
              name: ^target_type_expr_field_close,
              target: rust_inhabitant_atom(id: form.apply.close)
            )
          ],
          occurrence_id: SyntheticOccurrence
}
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_collection_witness_bundle_node(witness: RequiredTraitWitness) -> Node {
  match witness {
    TargetCollectionWitnessOrd { type_param: type_param } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(
            name: ^target_collection_witness_field_trait_name,
            target: rust_inhabitant_atom(id: ^target_collection_trait_ord)
          ),
          rust_named_edge(
            name: ^target_collection_witness_field_type_param,
            target: rust_inhabitant_atom(id: type_param)
          )
        ],
        occurrence_id: SyntheticOccurrence
}
    TargetCollectionWitnessHash { type_param: type_param } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(
            name: ^target_collection_witness_field_trait_name,
            target: rust_inhabitant_atom(id: ^target_collection_trait_hash)
          ),
          rust_named_edge(
            name: ^target_collection_witness_field_type_param,
            target: rust_inhabitant_atom(id: type_param)
          )
        ],
        occurrence_id: SyntheticOccurrence
}
    TargetCollectionWitnessEq { type_param: type_param } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(
            name: ^target_collection_witness_field_trait_name,
            target: rust_inhabitant_atom(id: ^target_collection_trait_eq)
          ),
          rust_named_edge(
            name: ^target_collection_witness_field_type_param,
            target: rust_inhabitant_atom(id: type_param)
          )
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn rust_collection_choice_bundle_node(choice: TargetRepresentationChoice) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^target_collection_choice_field_form,
        target: rust_collection_repr_bundle_node(form: choice.form)
      ),
      rust_named_edge(
        name: ^target_collection_choice_field_constraints,
        target: fold_list_node(
          xs: choice.constraints,
          item_node: rust_collection_witness_bundle_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

