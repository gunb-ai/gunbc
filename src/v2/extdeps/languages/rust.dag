fn rust_target_model_core_edges_full(operator_catalog: Node, rules: Node) -> List<Edge> {
  [
    rust_named_edge(
      name: ^target_model_edge_selection_policy,
      target: rust_selection_policy_node()
    ),
    rust_named_edge(
      name: ^target_model_edge_declared_inhabitants,
      target: rust_add_declared_inhabitants_root()
    ),
    rust_named_edge(
      name: ^target_model_edge_translation_rules,
      target: rules
    ),
    rust_named_edge(
      name: ^target_model_edge_serialize_source,
      target: rust_add_serialize_source_node()
    ),
    rust_named_edge(
      name: ^target_model_edge_collection_realization,
      target: rust_collection_realization_catalog_node()
    ),
    rust_named_edge(
      name: ^target_model_edge_reference_layer_tokens,
      target: target_reference_layer_tokens_node(tokens: rust_reference_layer_tokens())
    ),
    rust_named_edge(
      name: ^target_model_edge_use_site_ownership_realizations,
      target: target_use_site_ownership_catalog_node(
        rows: rust_sg_rc_use_site_ownership_catalog()
      )
    ),
    rust_named_edge(
      name: ^target_model_edge_value_semantics_carriers,
      target: target_value_semantics_carriers_node(
        atoms: rust_value_semantics_carrier_atoms()
      )
    ),
    rust_named_edge(
      name: ^target_model_edge_type_expression_projection,
      target: rust_type_expression_projection_bundle_node()
    ),
    rust_named_edge(
      name: ^target_model_edge_value_expression_projection,
      target: value_expr_projection_bundle_node(
        projection: rust_value_expression_projection()
      )
    ),
    rust_named_edge(
      name: ^target_model_edge_semantic_decl_emission,
      target: rust_semantic_decl_emission_bundle_node()
    ),
    rust_named_edge(
      name: ^target_model_edge_operator_realizations,
      target: operator_catalog
    )
  ]
}

fn rust_target_model_core_edges() -> List<Edge> {
  rust_target_model_core_edges_with_operators(
    operator_catalog: rust_operator_realizations_catalog_node()
  )
}

fn rust_target_model_bundle_core() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: rust_target_model_core_edges(),
    occurrence_id: SyntheticOccurrence
}
}

fn rust_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^rust_binding_fn_add, "add")
  let ma2 = map_insert(m0, ^rust_binding_fn_add2, "add2")
  let m1 = map_insert(ma2, ^rust_binding_param_x, "x")
  let m2 = map_insert(m1, ^rust_binding_param_y, "y")
  let mx = map_insert(m2, ^dag_binding_param_x, "x")
  let my = map_insert(mx, ^dag_binding_param_y, "y")
  let mi = map_insert(my, ^dag_binding_type_int, "i32")
  let m3 = map_insert(mi, ^rust_collection_surface_btree_set, "std::collections::BTreeSet")
  let m4 = map_insert(m3, ^rust_collection_surface_hash_set, "std::collections::HashSet")
  let m5 = map_insert(m4, ^rust_collection_surface_vec, "Vec")
  map_insert(m5, ^target_collection_set_carrier, "Set")
}

fn rust_emit_host_runtime_primitive_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^rust_emit_host_runtime_primitive_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

data rust_emit_host_toolchain_pin_note: String = "Toolchain pin materialized into every emitted cargo workspace (fleet incident 2026-07-22: runners with no rustup default refuse cargo builds in $RUNNER_TOOL_CACHE workspaces — the repo checkout builds only because rust-toolchain.toml is present there; srv1 masked this via a hand-set default). The channel literal mirrors the sole in-repo authority rust-toolchain.toml; dissolve-on: the emitter derives this row from that file instead of a mirrored literal."

data rust_emit_host_toolchain_pin: String = "[toolchain]\nchannel = \"1.93.0\"\n"

data rust_emit_host_cargo_manifest: String = "[package]\nname = \"gunbc_emit_host\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[[bin]]\nname = \"emit_host\"\npath = \"src/main.rs\"\n"

data rust_emit_host_main_suffix: String = "\n\nfn main() { let value = add(2, 3); let bytes = [0u8, (value & 0xff) as u8, ((value >> 8) & 0xff) as u8, ((value >> 16) & 0xff) as u8, ((value >> 24) & 0xff) as u8]; let _ = std::io::Write::write_all(&mut std::io::stdout(), &bytes); }\n"

fn rust_host_transport_descriptor() -> HostTransportDescriptor {
  HostTransportDescriptor {
    identity: ^rust_host_transport_identity,
    workspace: [
      WorkspaceFile {
        path: "Cargo.toml",
        content: FixedText { text: rust_emit_host_cargo_manifest }
      },
      WorkspaceFile {
        path: "rust-toolchain.toml",
        content: FixedText { text: rust_emit_host_toolchain_pin }
      },
      WorkspaceFile {
        path: "src/main.rs",
        content: EmittedWithSuffix { suffix: rust_emit_host_main_suffix }
      }
    ],
    build: [
      ProcessInvocation {
        program: HostToolProgram { executable: "cargo" },
        args: [LiteralArg { text: "build" }, LiteralArg { text: "--quiet" }]
      }
    ],
    run: ProcessInvocation {
      program: HostToolProgram { executable: "cargo" },
      args: [LiteralArg { text: "run" }, LiteralArg { text: "--quiet" }]
    },
    runtime_value_codec: FixedWidthBytes { width: 5 }
  }
}

fn rust_runtime_row() -> TargetEmitHostRuntimeRow {
  HostRuntimeRowPresent {
    row: EmitHostRuntimeRow {
      transport: rust_host_transport_descriptor(),
      runtime_primitive_type: rust_emit_host_runtime_primitive_type_node()
    }
  }
}

