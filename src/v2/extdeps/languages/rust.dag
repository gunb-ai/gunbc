fn rust_sg2_binding_spellings() -> Map<Symbol, String> {

  let m0 = map_insert(empty_map(), ^rust_binding_sg2_foobar, "FooBar")
  let m1 = map_insert(m0, ^rust_binding_sg2_x, "X")
  let m2 = map_insert(m1, ^rust_binding_sg2_y, "Y")
  let m3 = map_insert(m2, ^rust_binding_sg2_rc, "Rc")
  let m4 = map_insert(m3, ^rust_binding_sg_rc_box, "Box")
  let m5 = map_insert(m4, ^target_carrier_diagnostics, "Diagnostics")
  let m6 = map_insert(m5, ^target_carrier_node, "Node")
  let m7 = map_insert(m6, ^target_carrier_test_claim, "TestClaim")
  let m8 = map_insert(m7, ^target_carrier_free_monoid, "FreeMonoid")
  let m9 = map_insert(m8, ^target_carrier_outcome, "Outcome")
  let m10 = map_insert(m9, ^target_carrier_model_core, "ModelCore")
  let m11 = map_insert(m10, ^target_carrier_algebra_inhabitance_decl, "AlgebraInhabitanceDecl")
  let m12 = map_insert(m11, ^target_carrier_probe_heap, "ProbeHeap")
  let m13 = map_insert(m12, ^rust_collection_surface_btree_set, "std::collections::BTreeSet")
  let m14 = map_insert(m13, ^rust_collection_surface_hash_set, "std::collections::HashSet")
  let m15 = map_insert(m14, ^rust_collection_surface_vec, "Vec")
  let m16 = map_insert(m15, ^target_collection_set_carrier, "Set")
  let m18 = map_insert(m16, ^rust_target_atom_type_spelling_string, "String")
  let m19 = map_insert(m18, ^rust_sg_rc_ctor_rc_new, "Rc::new")
  map_insert(m19, ^rust_sg_rc_ctor_box_new, "Box::new")
}
fn rust_sg2_wave1_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      rust_ident_lex_rule(),
      rust_lex_rule(token_class: ^rust_token_lt, text: "<"),
      rust_lex_rule(token_class: ^rust_token_gt, text: ">"),
      rust_lex_rule(token_class: ^rust_token_comma, text: ", "),
      rust_lex_rule(token_class: ^rust_token_colon, text: ": "),
      rust_lex_rule(token_class: ^rust_token_lbrace, text: " { "),
      rust_lex_rule(token_class: ^rust_token_rbrace, text: " }"),
      rust_lex_rule(token_class: ^rust_token_lparen, text: "("),
      rust_lex_rule(token_class: ^rust_token_rparen, text: ")"),
      rust_lex_rule(token_class: ^rust_token_arrow, text: " -> "),
      rust_lex_rule(token_class: ^rust_token_pipe, text: " | ")
    ]
  }
}

fn rust_sg2_type_expr_target_model_bundle_core() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^target_model_edge_type_expression_projection,
        target: rust_type_expression_projection_bundle_node()
      ),
      rust_named_edge(
        name: ^target_model_edge_serialize_source,
        target: rust_sg2_serialize_source_node()
      ),
      rust_named_edge(
        name: ^target_model_edge_translation_rules,
        target: Node {
          kind: TypeNode { connective: Conj },
          children: Empty,
          occurrence_id: SyntheticOccurrence
}
      ),
      rust_named_edge(
        name: ^target_model_edge_selection_policy,
        target: rust_mvp1_selection_policy_node()
      ),
      rust_named_edge(
        name: ^target_model_edge_declared_inhabitants,
        target: rust_declared_inhabitants_root()
      ),
      rust_named_edge(
        name: ^target_model_edge_collection_realization,
        target: rust_collection_realization_catalog_node()
      ),
      rust_named_edge(
        name: ^target_model_edge_reference_layer_tokens,
        target: target_reference_layer_tokens_node(tokens: rust_reference_layer_tokens())
      ),
      rust_named_edge(
        name: ^target_model_edge_use_site_ownership_realizations,
        target: target_use_site_ownership_catalog_node(
          rows: rust_sg_rc_use_site_ownership_catalog()
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_sg2_type_expr_target_model_node() -> Node {
  match rust_sg2_type_expr_target_model_bundle_core().kind {
    TypeNode { connective: Conj } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: list_snoc_item(
          xs: rust_sg2_type_expr_target_model_bundle_core().children,
          item: rust_named_edge(
            name: ^target_model_edge_signature_realizations,
            target: target_function_signature_realization_catalog_node(
              rows: rust_target_function_signature_realization_catalog
            )
          )
        ),
        occurrence_id: SyntheticOccurrence
}
    _ => rust_sg2_type_expr_target_model_bundle_core()
  }
}

