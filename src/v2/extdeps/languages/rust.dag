  rust_fixture_emitted_add_fn
}

fn rust_source_text_authority() -> String {
  rust_source_text
}

fn rust_concrete_token_node(token: ConcreteSyntaxToken) -> Node {

  concrete_syntax_token_to_node(token: token)
}

fn rust_add_serialize_source_prefix_edges() -> List<Edge> {
  [
    rust_named_edge(
      name: ^serialize_source_field_source_text,
      target: rust_inhabitant_atom(id: ^rust_source_literal)
    ),
    rust_named_edge(
      name: ^serialize_source_field_source_grammar,
      target: rust_inhabitant_atom(id: ^rust_production_fn_add)
    )
  ]
}

fn rust_serialize_source_children() -> List<Edge> {

  list_append(
    left: rust_add_serialize_source_prefix_edges(),
    right: [
      rust_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: rust_concrete_tokens(),
          token_to_node: rust_concrete_token_node
        )
      )
    ]
  )
}

fn rust_add_serialize_source_node() -> Node {

  let _authority = rust_source_text_authority()
  Node {
    kind: TypeNode { connective: Conj },
    children: rust_serialize_source_children(),
    occurrence_id: SyntheticOccurrence
}
}

fn rust_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

type RustGramBuild1State
  = RustGramBuild1StateInit
  | RustGramBuild1StateReady { expr: GrammarExpr }

fn rust_grammar_sequence_from_concrete_tokens(tokens: List<ConcreteSyntaxToken>) -> GrammarExpr {
  match fold_list(
    xs: tokens,
    empty: RustGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        RustGramBuild1StateInit =>
          RustGramBuild1StateReady {
            expr: rust_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
          }
        RustGramBuild1StateReady { expr: acc } =>
          RustGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: rust_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    RustGramBuild1StateInit =>
      rust_grammar_terminal(token_class: ^rust_token_kw_fn)
    RustGramBuild1StateReady { expr: result } => result
  }
}

fn rust_grammar_sequence_from_token_classes() -> GrammarExpr {
  rust_grammar_sequence_from_concrete_tokens(tokens: rust_concrete_tokens())
}

fn rust_grammar_relation_row() -> RustGrammarRelationRow {
  RustGrammarRelationRow {
    production: rust_grammar_production_fn_add(),
    emitted: rust_emitted_add_fn_node(),
    tokens: rust_concrete_tokens()
  }
}

fn rust_grammar_relation_row_node(row: RustGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: row.production)
      ),
      rust_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      rust_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: rust_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_value_expression_projection() -> TargetValueExpressionProjection {
  TargetValueExpressionProjection {
    binding_ref_form: TargetBindingRefShape { ident_token: ^rust_token_ident },
    primitive_apply_form: TargetPrimitiveApplyShape {
      open: ^rust_token_lparen,
      close: ^rust_token_rparen,
      separator: ^rust_token_comma
    },
    callable_apply_form: TargetCallApplyShape {
      callee_ident_token: ^rust_token_ident,
      open: ^rust_token_lparen,
      separator: ^rust_token_comma,
      close: ^rust_token_rparen
    },
    closure_form: TargetClosureShape {
      fn_token: ^rust_token_closure_pipe,
      open: ^rust_token_closure_nop,
      separator: ^rust_token_comma,
      close: ^rust_token_closure_pipe,
      body_open: ^rust_token_lbrace,
      body_close: ^rust_token_rbrace,
      param_ident_token: ^rust_token_ident
    },
    effect_apply_form: TargetEffectApplyShape {
      callees: [],
      open: ^rust_token_lparen,
      close: ^rust_token_rparen,
      separator: ^rust_token_comma
    },
    conditional_form: TargetConditionalShape {
      if_token: ^rust_token_kw_if,
      then_token: ^rust_token_lbrace,
      else_token: ^rust_token_unwired_else
    },
    let_form: TargetBindLetShape {
      let_token: ^rust_token_kw_let,
      assign_token: ^rust_token_equal,
      in_token: ^rust_token_semicolon
    },
    loop_form: TargetLoopShape { loop_token: ^rust_token_unwired_loop },
    record_construct_form: TargetRecordConstructShape {
      open: ^rust_token_lbrace,
      close: ^rust_token_rbrace,
      separator: ^rust_token_comma,
      assign: ^rust_token_colon,
      record_literal_names_type: Prepend
    },
    field_access_form: TargetFieldAccessShape { dot: ^rust_token_dot },
    match_form: TargetMatchShape {
      match_token: ^rust_token_unwired_match,
      scrutinee_open: ^rust_token_lparen,
      scrutinee_close: ^rust_token_rparen,
      open: ^rust_token_lbrace,
      close: ^rust_token_rbrace,
      fat_arrow: ^rust_token_unwired_fat_arrow,
      arm_separator: ^rust_token_comma
    },
    block_evaluation_mode: ValueProducing
  }
}

fn rust_operator_realization_row(operation: CanonicalOperation, token: Symbol) -> Node {
  target_operator_realization_node(
    operation: operation,
    shape: InfixToken { token: token }
  )
}

fn rust_add_operator_realization_row() -> Node {
  rust_operator_realization_row(
    operation: canonical_operation_op_add(),
    token: ^rust_token_plus
  )
}

fn rust_binop_operator_lex_rules() -> List<LexRule> {
  [
    rust_lex_rule(token_class: ^rust_token_oror, text: " || "),
    rust_lex_rule(token_class: ^rust_token_andand, text: " && "),
    rust_lex_rule(token_class: ^rust_token_eqeq, text: " == "),
    rust_lex_rule(token_class: ^rust_token_neq, text: " != "),
    rust_lex_rule(token_class: ^rust_token_le, text: " <= "),
    rust_lex_rule(token_class: ^rust_token_ge, text: " >= "),
    rust_lex_rule(token_class: ^rust_token_lt, text: " < "),
    rust_lex_rule(token_class: ^rust_token_gt, text: " > "),
    rust_lex_rule(token_class: ^rust_token_minus, text: " - "),
    rust_lex_rule(token_class: ^rust_token_star, text: " * "),
    rust_lex_rule(token_class: ^rust_token_slash, text: " / ")
  ]
}

fn rust_operator_realizations_catalog_node() -> Node {
  target_operator_realizations_catalog_node(rows: [
    rust_operator_realization_row(operation: canonical_operation_op_or(), token: ^rust_token_oror),
    rust_operator_realization_row(operation: canonical_operation_op_and(), token: ^rust_token_andand),
    rust_operator_realization_row(operation: canonical_operation_op_eq(), token: ^rust_token_eqeq),
    rust_operator_realization_row(operation: canonical_operation_op_ne(), token: ^rust_token_neq),
    rust_operator_realization_row(operation: canonical_operation_op_lt(), token: ^rust_token_lt),
    rust_operator_realization_row(operation: canonical_operation_op_le(), token: ^rust_token_le),
    rust_operator_realization_row(operation: canonical_operation_op_gt(), token: ^rust_token_gt),
    rust_operator_realization_row(operation: canonical_operation_op_ge(), token: ^rust_token_ge),
    rust_add_operator_realization_row(),
    rust_operator_realization_row(operation: canonical_operation_op_sub(), token: ^rust_token_minus),
    rust_operator_realization_row(operation: canonical_operation_op_mul(), token: ^rust_token_star),
    rust_operator_realization_row(operation: canonical_operation_op_div(), token: ^rust_token_slash)
  ])
}

fn rust_add_signature_with_open() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_kw_fn },
    BoundToken { token_class: ^rust_token_ident, binding: ^rust_binding_fn_add },
    FixedToken { token_class: ^rust_token_lparen },
    BoundToken { token_class: ^rust_token_ident, binding: ^rust_binding_param_x },
    FixedToken { token_class: ^rust_token_colon },
    FixedToken { token_class: ^rust_token_ty_i32 },
    FixedToken { token_class: ^rust_token_comma },
    BoundToken { token_class: ^rust_token_ident, binding: ^rust_binding_param_y },
    FixedToken { token_class: ^rust_token_colon },
    FixedToken { token_class: ^rust_token_ty_i32 },
    FixedToken { token_class: ^rust_token_rparen },
    FixedToken { token_class: ^rust_token_arrow },
    FixedToken { token_class: ^rust_token_ty_i32 },
