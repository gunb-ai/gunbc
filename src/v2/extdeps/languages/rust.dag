fn rust_target_model_node() -> Node {

  Node {
    kind: TypeNode { connective: Conj },
    children: list_snoc_item(
      xs: rust_target_model_core_edges(),
      item: rust_named_edge(
        name: ^target_model_edge_atom_realizations,
        target: target_atom_realization_catalog_node(
          rows: rust_target_atom_realization_catalog,
          host_bundle: rust_target_model_bundle_core()
        )
      )
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn rust_target_model() -> TargetModel {
  TargetModel {
    bundle: rust_target_model_node(),
    lex: rust_fn_add_lex(),
    binding_spellings: rust_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: rust_source_text_authority(),
    runtime_row: rust_runtime_row()
  }
}

fn rust_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn rust_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn rust_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^rust_token_ident,
    pattern: rust_ident_lex_pattern()
  }
}

fn rust_staging_match_additional_lex_rules() -> List<LexRule> {
  [
    rust_lex_rule(token_class: ^rust_token_unwired_match, text: "match "),
    rust_lex_rule(token_class: ^rust_token_unwired_fat_arrow, text: " => "),
    rust_lex_rule(token_class: ^dag_token_kw_true, text: "true"),
    rust_lex_rule(token_class: ^dag_token_kw_false, text: "false")
  ]
}

fn rust_staging_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: list_append(
      left: rust_fn_add_lex_rules().rules,
      right: rust_staging_match_additional_lex_rules()
    )
  }
}

fn rust_staging_lex() -> LexRules {
  ModeledLexRules { root: rust_staging_lex_rules() }
}

fn rust_fn_add_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: list_append(
      left: [
        rust_lex_rule(token_class: ^rust_token_kw_fn, text: "fn "),
        rust_ident_lex_rule(),
        rust_lex_rule(token_class: ^rust_token_ty_i32, text: "i32"),
        rust_lex_rule(token_class: ^rust_token_plus, text: " + "),
        rust_lex_rule(token_class: ^rust_token_arrow, text: " -> "),
        rust_lex_rule(token_class: ^rust_token_lbrace, text: " { "),
        rust_lex_rule(token_class: ^rust_token_rbrace, text: " }"),
        rust_lex_rule(token_class: ^rust_token_lparen, text: "("),
        rust_lex_rule(token_class: ^rust_token_rparen, text: ")"),
        rust_lex_rule(token_class: ^rust_token_comma, text: ", "),
        rust_lex_rule(token_class: ^rust_token_colon, text: ": "),
        rust_lex_rule(token_class: ^rust_token_dot, text: "."),
        rust_lex_rule(token_class: ^rust_token_pipe, text: " | ")
      ],
      right: rust_binop_operator_lex_rules()
    )
  }
}

fn rust_fn_add_lex() -> LexRules {
  ModeledLexRules { root: rust_fn_add_lex_rules() }
}

fn rust_grammar_atom(id: Symbol) -> Node {
  rust_inhabitant_atom(id: id)
}

fn rust_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn rust_formal_production_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: ^rust_production_fn_add,
    rhs: rust_formal_rhs_from_tokens(tokens: rust_concrete_tokens())
  )
}

fn rust_decl_derive_lex_spelling(text: String) -> String {
  concat(text, "\n")
}

fn rust_decl_derive_lex_rule(token_class: Symbol, text: String) -> LexRule {
  rust_lex_rule(token_class: token_class, text: rust_decl_derive_lex_spelling(text: text))
}

fn rust_decl_shared_derive_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^rust_decl_derive_attr,
      rhs: [
        grammar_formal_terminal_bound(
          identity: ^rust_token_derive_struct,
          binding: ^rust_decl_derive_struct_binding
        )
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_decl_derive_attr,
      rhs: [
        grammar_formal_terminal_bound(
          identity: ^rust_token_derive_struct_copy,
          binding: ^rust_decl_derive_struct_copy_binding
        )
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_decl_derive_attr,
      rhs: [
        grammar_formal_terminal_bound(
          identity: ^rust_token_derive_enum,
          binding: ^rust_decl_derive_enum_binding
        )
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_decl_derive_attr,
      rhs: [
        grammar_formal_terminal_bound(
          identity: ^rust_token_derive_enum_copy,
          binding: ^rust_decl_derive_enum_copy_binding
        )
      ]
    )
  ]
}

fn rust_coproduct_variant_edge_has_payload(edge: Edge) -> Bool {
  match edge.target.kind {
    TypeNode { connective: Conj } =>
      match edge.target.children {
        Empty => false
        Cons { head: _, tail: _ } => true
      }
    _ => false
  }
}

fn rust_coproduct_all_variants_nullary(edges: List<Edge>) -> Bool {
  fold_list(
    xs: edges,
    empty: true,
    cons: fn(acc, edge) { acc && !rust_coproduct_variant_edge_has_payload(edge: edge) }
  )
}

fn rust_decl_struct_derive_binding() -> Symbol {
  ^rust_decl_derive_struct_binding
}

fn rust_decl_enum_derive_binding_for_coproduct(coproduct: Node) -> Symbol {
  repr_grounding_derive_surface_binding_for_coproduct(coproduct: coproduct)
}

fn rust_decl_derive_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(
    empty_map(),
    ^rust_decl_derive_struct_binding,
    rust_decl_derive_lex_spelling(text: rust_struct_derives)
  )
  let m1 = map_insert(
    m0,
    ^rust_decl_derive_struct_copy_binding,
    rust_decl_derive_lex_spelling(text: rust_struct_derives_copy)
  )
  let m2 = map_insert(
    m1,
    ^rust_decl_derive_enum_binding,
    rust_decl_derive_lex_spelling(text: rust_enum_derives)
  )
  map_insert(
    m2,
    ^rust_decl_derive_enum_copy_binding,
    rust_decl_derive_lex_spelling(text: rust_enum_derives_copy)
  )
}

fn rust_decl_shared_field_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^rust_decl_qualified_name,
      rhs: [ grammar_formal_terminal_free(identity: ^rust_token_ident) ]
    ),
    grammar_formal_production(
      lhs: ^rust_decl_type_expr,
      rhs: [ grammar_formal_nonterminal_occurrence(identity: ^rust_decl_qualified_name) ]
    ),
    grammar_formal_production(
      lhs: ^rust_decl_field,
      rhs: [
        grammar_formal_terminal_free(identity: ^rust_token_ident),
        grammar_formal_terminal(identity: ^rust_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^rust_decl_type_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_decl_field_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_decl_field),
        grammar_formal_nonterminal_occurrence(identity: ^rust_decl_field_list_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_decl_field_list_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^rust_decl_field),
        grammar_formal_nonterminal_occurrence(identity: ^rust_decl_field_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^rust_decl_field_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^rust_decl_field_block,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lbrace),
        grammar_formal_nonterminal_occurrence(identity: ^rust_decl_field_list),
        grammar_formal_terminal(identity: ^rust_token_rbrace)
      ]
    )
  ]
}

fn rust_decl_shared_generic_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^rust_decl_type_param_list,
