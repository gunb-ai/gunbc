fn rust_mvp1_selection_policy_node() -> Node {
  rust_inhabitant_i32_node()
}

data rust_mvp1_fixture_i32_inhabitant: Node = rust_inhabitant_i32_node()

data rust_mvp1_fixture_emitted_add_fn: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: rust_mvp1_fixture_i32_inhabitant },
    Edge { label: Positional, target: rust_mvp1_fixture_i32_inhabitant },
    Edge { label: Positional, target: rust_mvp1_fixture_i32_inhabitant }
  ],
  occurrence_id: SyntheticOccurrence
}

fn rust_mvp1_i32_overflow_disposition_node() -> Node {
  rust_overflow_disposition_node(
    disposition: rust_integer_overflow_disposition(kind: Signed, width: Bits32)
  )
}

fn rust_mvp1_i32_scalar_node() -> Node {
  rust_scalar_node(scalar: IntScalar { kind: Signed, width: Bits32 })
}

fn rust_mvp1_i32_zip_fold_closure_edges() -> List<Edge> {
  [
    rust_named_edge(
      name: ^rust_inhabitant_field_mvp1_add_fn,
      target: rust_mvp1_fixture_emitted_add_fn
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_inhabitant_atom,
      target: rust_inhabitant_atom(id: ^rust_inhabitant_i32)
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_facts,
      target: rust_integer_facts_node(facts: rust_facts_i32)
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_spelling,
      target: rust_inhabitant_atom(id: ^rust_surface_spelling_i32)
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_std_projection,
      target: rust_inhabitant_atom(id: ^rust_std_projection_int32)
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_signed,
      target: rust_int_kind_node(kind: Signed)
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_width,
      target: rust_int_width_node(width: Bits32)
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_overflow,
      target: rust_mvp1_i32_overflow_disposition_node()
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_scalar,
      target: rust_mvp1_i32_scalar_node()
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_scalar_int,
      target: rust_inhabitant_atom(id: ^rust_tag_scalar_int)
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_panic_overflow,
      target: rust_overflow_node(overflow: PanicOnOverflow)
    ),
    rust_named_edge(
      name: ^rust_coercion_field_i32_wrap_overflow,
      target: rust_overflow_node(overflow: TwoComplementWrap)
    )
  ]
}

fn rust_mvp1_coercion_candidate_edges() -> List<Edge> {
  list_append(
    left: rust_declared_inhabitants_root().children,
    right: rust_mvp1_i32_zip_fold_closure_edges()
  )
}

fn rust_mvp1_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: rust_mvp1_coercion_candidate_edges(),
    occurrence_id: SyntheticOccurrence
}
}

fn rust_mvp1_emitted_add_fn_node() -> Node {
  rust_mvp1_fixture_emitted_add_fn
}

fn rust_mvp1_source_text_authority() -> String {
  rust_mvp1_source_text
}

fn rust_concrete_token_node(token: ConcreteSyntaxToken) -> Node {

  concrete_syntax_token_to_node(token: token)
}

fn rust_mvp1_serialize_source_prefix_edges() -> List<Edge> {
  [
    rust_named_edge(
      name: ^serialize_source_field_source_text,
      target: rust_inhabitant_atom(id: ^rust_mvp1_source_literal)
    ),
    rust_named_edge(
      name: ^serialize_source_field_source_grammar,
      target: rust_inhabitant_atom(id: ^rust_production_mvp1_fn_add)
    )
  ]
}

fn rust_mvp1_serialize_source_children() -> List<Edge> {

  list_append(
    left: rust_mvp1_serialize_source_prefix_edges(),
    right: [
      rust_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: rust_mvp1_concrete_tokens(),
          token_to_node: rust_concrete_token_node
        )
      )
    ]
  )
}

fn rust_mvp1_serialize_source_node() -> Node {

  let _authority = rust_mvp1_source_text_authority()
  Node {
    kind: TypeNode { connective: Conj },
    children: rust_mvp1_serialize_source_children(),
    occurrence_id: SyntheticOccurrence
}
}

fn rust_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

type RustGramBuild1State
  = RustGramBuild1StateInit
  | RustGramBuild1StateReady { expr: GrammarExpr }

fn rust_grammar_sequence_from_token_classes() -> GrammarExpr {
  match fold_list(
    xs: rust_mvp1_concrete_tokens(),
    empty: RustGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        RustGramBuild1StateInit =>
          RustGramBuild1StateReady {
            expr: rust_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
          }
        RustGramBuild1StateReady { expr: acc } =>
          RustGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: rust_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    RustGramBuild1StateInit =>
      rust_grammar_terminal(token_class: ^rust_token_kw_fn)
    RustGramBuild1StateReady { expr: result } => result
  }
}

fn rust_mvp1_grammar_relation_row() -> RustGrammarRelationRow {
  RustGrammarRelationRow {
    production: rust_grammar_production_mvp1_fn_add(),
    emitted: rust_mvp1_emitted_add_fn_node(),
    tokens: rust_mvp1_concrete_tokens()
  }
}

fn rust_grammar_relation_row_node(row: RustGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: row.production)
      ),
      rust_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      rust_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: rust_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_mvp1_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^rust_relation_rule_mvp1_fn_add,
        target: rust_grammar_relation_row_node(row: rust_mvp1_grammar_relation_row())
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}
fn rust_set_collection_apply_btree() -> TargetGenericApply {
  TargetGenericApply {
    surface: ^rust_collection_surface_btree_set,
    open: ^rust_token_lt,
    separator: ^rust_token_comma,
    field_label_separator: optional_absent(),
    close: ^rust_token_gt
  }
}

fn rust_set_collection_apply_hash() -> TargetGenericApply {
  TargetGenericApply {
    surface: ^rust_collection_surface_hash_set,
    open: ^rust_token_lt,
    separator: ^rust_token_comma,
    field_label_separator: optional_absent(),
    close: ^rust_token_gt
  }
}

fn rust_free_monoid_collection_apply_vec() -> TargetGenericApply {
  TargetGenericApply {
    surface: ^rust_collection_surface_vec,
    open: ^rust_token_lt,
    separator: ^rust_token_comma,
    close: ^rust_token_gt
  }
}

fn rust_set_collection_primary_choice() -> TargetRepresentationChoice {
  TargetRepresentationChoice {
    form: TargetRepresentation {
      kind: TargetCollectionReprBTreeSet,
      apply: rust_set_collection_apply_btree()
    },
    constraints: [
      TargetCollectionWitnessOrd { type_param: ^target_collection_type_param_t }
    ]
  }
}

fn rust_set_collection_hash_choice() -> TargetRepresentationChoice {
  TargetRepresentationChoice {
    form: TargetRepresentation {
      kind: TargetCollectionReprHashSet,
      apply: rust_set_collection_apply_hash()
    },
    constraints: [
      TargetCollectionWitnessHash { type_param: ^target_collection_type_param_t },
      TargetCollectionWitnessEq { type_param: ^target_collection_type_param_t }
    ]
  }
}

fn rust_set_collection_alternative_choices() -> List<TargetRepresentationChoice> {
  Cons {
    head: rust_set_collection_hash_choice(),
    tail: Empty
  }
}

fn rust_free_monoid_collection_primary_choice() -> TargetRepresentationChoice {
  TargetRepresentationChoice {
    form: TargetRepresentation {
      kind: TargetCollectionReprVec,
      apply: rust_free_monoid_collection_apply_vec()
    },
    constraints: []
  }
}

fn rust_free_monoid_collection_alternative_choices() -> List<TargetRepresentationChoice> {
  Empty
}

fn rust_collection_repr_bundle_node(form: TargetRepresentation) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^target_collection_repr_field_kind,
        target: rust_inhabitant_atom(id: discriminant(v: form.kind))
      ),
      rust_named_edge(
        name: ^target_collection_repr_field_apply,
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            rust_named_edge(
              name: ^target_type_expr_field_surface,
              target: rust_inhabitant_atom(id: form.apply.surface)
            ),
            rust_named_edge(
              name: ^target_type_expr_field_open,
              target: rust_inhabitant_atom(id: form.apply.open)
            ),
            rust_named_edge(
              name: ^target_type_expr_field_separator,
              target: rust_inhabitant_atom(id: form.apply.separator)
            ),
            rust_named_edge(
              name: ^target_type_expr_field_close,
              target: rust_inhabitant_atom(id: form.apply.close)
            )
          ],
          occurrence_id: SyntheticOccurrence
}
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_collection_witness_bundle_node(witness: RequiredTraitWitness) -> Node {
  match witness {
    TargetCollectionWitnessOrd { type_param: type_param } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(
            name: ^target_collection_witness_field_trait_name,
            target: rust_inhabitant_atom(id: ^target_collection_trait_ord)
          ),
          rust_named_edge(
            name: ^target_collection_witness_field_type_param,
            target: rust_inhabitant_atom(id: type_param)
          )
        ],
        occurrence_id: SyntheticOccurrence
}
    TargetCollectionWitnessHash { type_param: type_param } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(
            name: ^target_collection_witness_field_trait_name,
            target: rust_inhabitant_atom(id: ^target_collection_trait_hash)
          ),
          rust_named_edge(
            name: ^target_collection_witness_field_type_param,
            target: rust_inhabitant_atom(id: type_param)
          )
        ],
        occurrence_id: SyntheticOccurrence
}
    TargetCollectionWitnessEq { type_param: type_param } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(
            name: ^target_collection_witness_field_trait_name,
            target: rust_inhabitant_atom(id: ^target_collection_trait_eq)
          ),
          rust_named_edge(
            name: ^target_collection_witness_field_type_param,
            target: rust_inhabitant_atom(id: type_param)
          )
        ],
        occurrence_id: SyntheticOccurrence
}
  }
}

fn rust_collection_choice_bundle_node(choice: TargetRepresentationChoice) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^target_collection_choice_field_form,
        target: rust_collection_repr_bundle_node(form: choice.form)
      ),
      rust_named_edge(
        name: ^target_collection_choice_field_constraints,
        target: fold_list_node(
          xs: choice.constraints,
          item_node: rust_collection_witness_bundle_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_set_collection_realization_bundle_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^target_collection_row_field_source_carrier,
        target: target_collection_set_carrier_node()
      ),
      rust_named_edge(
        name: ^target_collection_row_field_primary,
        target: rust_collection_choice_bundle_node(choice: rust_set_collection_primary_choice())
      ),
      rust_named_edge(
        name: ^target_collection_row_field_alternatives,
        target: fold_list_node(
          xs: rust_set_collection_alternative_choices(),
          item_node: rust_collection_choice_bundle_node
        )
      ),
      rust_named_edge(
        name: ^target_collection_row_field_fallback,
        target: rust_inhabitant_atom(id: ^target_collection_set_no_representation)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_free_monoid_collection_realization_bundle_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^target_collection_row_field_source_carrier,
        target: target_carrier_free_monoid_node()
      ),
      rust_named_edge(
        name: ^target_collection_row_field_primary,
        target: rust_collection_choice_bundle_node(choice: rust_free_monoid_collection_primary_choice())
      ),
      rust_named_edge(
        name: ^target_collection_row_field_alternatives,
        target: fold_list_node(
          xs: rust_free_monoid_collection_alternative_choices(),
          item_node: rust_collection_choice_bundle_node
        )
      ),
      rust_named_edge(
        name: ^target_collection_row_field_fallback,
        target: rust_inhabitant_atom(id: ^target_collection_free_monoid_no_representation)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_collection_realization_catalog_node() -> Node {
  fold_list_node(
    xs: Cons {
      head: rust_set_collection_realization_bundle_node(),
      tail: Cons { head: rust_free_monoid_collection_realization_bundle_node(), tail: Empty }
    },
    item_node: fn(row) { row }
  )
}

fn rust_mvp1_target_model_core_edges() -> List<Edge> {
  [
    rust_named_edge(
      name: ^target_model_edge_selection_policy,
      target: rust_mvp1_selection_policy_node()
    ),
    rust_named_edge(
      name: ^target_model_edge_declared_inhabitants,
      target: rust_mvp1_declared_inhabitants_root()
    ),
    rust_named_edge(
      name: ^target_model_edge_translation_rules,
      target: rust_mvp1_translation_rules_node()
    ),
    rust_named_edge(
      name: ^target_model_edge_serialize_source,
      target: rust_mvp1_serialize_source_node()
    ),
    rust_named_edge(
      name: ^target_model_edge_collection_realization,
      target: rust_collection_realization_catalog_node()
    ),
    rust_named_edge(
      name: ^target_model_edge_reference_layer_tokens,
      target: target_reference_layer_tokens_node(tokens: rust_reference_layer_tokens())
    ),
    rust_named_edge(
      name: ^target_model_edge_use_site_ownership_realizations,
      target: target_use_site_ownership_catalog_node(
        rows: rust_sg_rc_use_site_ownership_catalog()
      )
    ),
    rust_named_edge(
      name: ^target_model_edge_value_semantics_carriers,
      target: target_value_semantics_carriers_node(
        atoms: rust_value_semantics_carrier_atoms()
      )
    ),
    rust_named_edge(
      name: ^target_model_edge_type_expression_projection,
      target: rust_type_expression_projection_bundle_node()
    )
  ]
}

fn rust_mvp1_target_model_bundle_core() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: rust_mvp1_target_model_core_edges(),
    occurrence_id: SyntheticOccurrence
}
}

fn rust_mvp1_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^rust_binding_fn_add, "add")
  let m1 = map_insert(m0, ^rust_binding_param_x, "x")
  let m2 = map_insert(m1, ^rust_binding_param_y, "y")
  let m3 = map_insert(m2, ^rust_collection_surface_btree_set, "std::collections::BTreeSet")
  let m4 = map_insert(m3, ^rust_collection_surface_hash_set, "std::collections::HashSet")
  let m5 = map_insert(m4, ^rust_collection_surface_vec, "Vec")
  map_insert(m5, ^target_collection_set_carrier, "Set")
}

fn rust_emit_host_runtime_primitive_type_node() -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^rust_emit_host_runtime_primitive_symbol } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_host_transport_mvp1_descriptor() -> HostTransportDescriptor {
  HostTransportDescriptor {
    identity: ^rust_host_transport_mvp1_identity,
    workspace: [
      WorkspaceFile {
        path: "src/main.rs",
        content: EmittedSource
      }
    ],
    build: [
      ProcessInvocation {
        tool: ^host_tool_cargo,
        args: [LiteralArg { text: "build" }]
      }
    ],
    run: ProcessInvocation {
      tool: ^host_tool_cargo,
      args: [LiteralArg { text: "run" }]
    },
    runtime_value_codec: FixedWidthBytes { width: 5 }
  }
}

fn rust_mvp1_runtime_row() -> TargetEmitHostRuntimeRow {
  HostRuntimeRowPresent {
    row: EmitHostRuntimeRow {
      transport: rust_host_transport_mvp1_descriptor(),
      runtime_primitive_type: rust_emit_host_runtime_primitive_type_node()
    }
  }
}

fn rust_mvp1_target_model_staging() -> TargetModel {
  TargetModel {
    bundle: rust_mvp1_target_model_bundle_core(),
    lex: rust_wave1_lex(),
    binding_spellings: rust_mvp1_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: rust_mvp1_source_text_authority(),
    runtime_row: rust_mvp1_runtime_row()
  }
}
fn rust_target_atom_type_form(spelling: Symbol) -> TargetTypeExpression {
  target_atom_alias_type_expression(
    spelling: spelling,
    atom_form: rust_type_expression_projection().atom_form
  )
}

data rust_target_atom_realization_symbol: TargetAtomRealization = TargetAtomRealization {
  source_carrier: symbol_kernel_type_node(),
  target_model: rust_mvp1_target_model_staging(),
  type_form: rust_target_atom_type_form(spelling: ^rust_target_atom_type_spelling_string),
  value_form: target_value_template_for_kind(kind: ValueSymbolToOwnedString),
  constructor_form: optional_absent(),
  display_name: ^symbol_kernel_type_atom
}

data rust_target_atom_realization_bool: TargetAtomRealization = TargetAtomRealization {
  source_carrier: bool_node(),
  target_model: rust_mvp1_target_model_staging(),
  type_form: rust_target_atom_type_form(spelling: ^rust_surface_spelling_bool),
  value_form: target_value_template_for_kind(kind: ValueBoolLiteral),
  constructor_form: optional_absent(),
  display_name: ^bool_node_symbol
}

data rust_target_atom_realization_char: TargetAtomRealization = TargetAtomRealization {
  source_carrier: char_kernel_type_node(),
  target_model: rust_mvp1_target_model_staging(),
  type_form: rust_target_atom_type_form(spelling: ^rust_surface_spelling_char),
  value_form: target_value_template_for_kind(kind: ValueCharUnicodeScalar),
  constructor_form: optional_absent(),
  display_name: ^char_kernel_type_atom
}

data rust_target_atom_realization_catalog: List<TargetAtomRealization> = [
  rust_target_atom_realization_symbol,
  rust_target_atom_realization_bool,
  rust_target_atom_realization_char
]

data rust_target_function_signature_realization_symbol_param: TargetFunctionSignatureRealization = TargetFunctionSignatureRealization {
  source_carrier: symbol_kernel_type_node(),
  target_model: rust_sg2_type_expr_target_model_staging(),
  boundary_site: FunctionBoundaryParam,
  signature_type_form: rust_target_atom_realization_symbol.type_form
}

data rust_target_function_signature_realization_symbol_return: TargetFunctionSignatureRealization = TargetFunctionSignatureRealization {
  source_carrier: symbol_kernel_type_node(),
  target_model: rust_sg2_type_expr_target_model_staging(),
  boundary_site: FunctionBoundaryReturn,
  signature_type_form: rust_target_atom_realization_symbol.type_form
}

data rust_target_function_signature_realization_catalog: List<TargetFunctionSignatureRealization> = [
  rust_target_function_signature_realization_symbol_param,
  rust_target_function_signature_realization_symbol_return
]

fn rust_mvp1_target_model_node() -> Node {

  Node {
    kind: TypeNode { connective: Conj },
    children: list_snoc_item(
      xs: rust_mvp1_target_model_core_edges(),
      item: rust_named_edge(
        name: ^target_model_edge_atom_realizations,
        target: target_atom_realization_catalog_node(
          rows: rust_target_atom_realization_catalog,
          host_bundle: rust_mvp1_target_model_bundle_core()
        )
      )
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn rust_mvp1_target_model() -> TargetModel {
  TargetModel {
    bundle: rust_mvp1_target_model_node(),
    lex: rust_wave1_lex(),
    binding_spellings: rust_mvp1_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: rust_mvp1_source_text_authority(),
    runtime_row: rust_mvp1_runtime_row()
  }
}

fn rust_conj_emitted_from_tokens(tokens: List<ConcreteSyntaxToken>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: tokens,
      empty: Empty,
      cons: fn(acc, token) {
        match token {
          BoundToken { binding: binding, token_class: _ } =>
            list_snoc_item(
              xs: acc,
              item: Edge { label: Positional, target: rust_inhabitant_atom(id: binding) }
            )
          FixedToken { token_class: _ } => acc
        }
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_formal_symbol_from_token(token: ConcreteSyntaxToken) -> FormalGrammarSymbol {
  match token {
    FixedToken { token_class: c } => grammar_formal_terminal(identity: c)
    BoundToken { token_class: c, binding: b } =>
      grammar_formal_terminal_bound(identity: c, binding: b)
  }
}

fn rust_formal_rhs_from_tokens_with_bindings(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(xs: acc, item: rust_formal_symbol_from_token(token: token))
    }
  )
}

fn rust_formal_production_from_tokens(lhs: Symbol, tokens: List<ConcreteSyntaxToken>) -> FormalProduction {
  grammar_formal_production(lhs: lhs, rhs: rust_formal_rhs_from_tokens_with_bindings(tokens: tokens))
}

fn rust_lhs_exact_relation_row_witness(
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Witness<Node> {
  let production = rust_formal_production_from_tokens(lhs: lhs, tokens: tokens)
  let productions = [production]
  match formal_production_for_lhs_exact(productions: productions, lhs: lhs, child: emitted) {
    Holds { value: selected } =>
      derive_grammar_relation_row_node(
        production: selected,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn rust_empty_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_relation_translation_rules_node(
  rule_name: Symbol,
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Node {
  match rust_lhs_exact_relation_row_witness(lhs: lhs, tokens: tokens, emitted: emitted) {
    Holds { value: row } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(name: rule_name, target: row)
        ],
        occurrence_id: SyntheticOccurrence
      }
    Violates { diagnostic: _ } => rust_empty_translation_rules_node()
  }
}

fn rust_serialize_source_prefix_edges(source_text_binding: Symbol, production_binding: Symbol) -> List<Edge> {
  [
    rust_named_edge(
      name: ^serialize_source_field_source_text,
      target: rust_inhabitant_atom(id: source_text_binding)
    ),
    rust_named_edge(
      name: ^serialize_source_field_source_grammar,
      target: rust_inhabitant_atom(id: production_binding)
    )
  ]
}

fn rust_serialize_source_node(
  source_text_binding: Symbol,
  production_binding: Symbol,
  tokens: List<ConcreteSyntaxToken>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_append(
      left: rust_serialize_source_prefix_edges(
        source_text_binding: source_text_binding,
        production_binding: production_binding
      ),
      right: [
        rust_named_edge(
          name: ^grammar_relation_field_tokens,
          target: grammar_relation_tokens_node(
            tokens: tokens,
            token_to_node: rust_concrete_token_node
          )
        )
      ]
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_target_model_bundle(rules: Node, serialize_source: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^target_model_edge_translation_rules, target: rules),
      rust_named_edge(name: ^target_model_edge_serialize_source, target: serialize_source)
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_string_literal_escape(spelling: String) -> String {
  replace(replace(spelling, "\\", "\\\\"), "\"", "\\\"")
}

fn rust_string_literal_spelling(spelling: String) -> String {
  concat("\"", concat(rust_string_literal_escape(spelling: spelling), "\""))
}

fn rust_emit_directive_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_macro_eprintln_open },
    BoundToken { token_class: ^rust_token_str_lit, binding: ^emit_directive_message },
    FixedToken { token_class: ^rust_token_rparen }
  ]
}

data rust_emit_directive_emitted_call: Node = rust_conj_emitted_from_tokens(
  tokens: rust_emit_directive_concrete_tokens()
)

fn rust_emit_directive_source_text(d: EmitDirective) -> String {
  concat("eprintln!(", concat(rust_string_literal_spelling(spelling: d.message), ")"))
}

fn rust_emit_directive_lex() -> LexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: [
        rust_lex_rule(token_class: ^rust_token_macro_eprintln_open, text: "eprintln!("),
        rust_lex_rule(token_class: ^rust_token_rparen, text: ")")
      ]
    }
  }
}

fn rust_emit_directive_translation_rules_node() -> Node {
  rust_relation_translation_rules_node(
    rule_name: ^rust_relation_rule_emit_directive_eprintln,
    lhs: ^rust_production_emit_directive_eprintln,
    tokens: rust_emit_directive_concrete_tokens(),
    emitted: rust_emit_directive_emitted_call
  )
}

fn rust_emit_directive_serialize_source_node() -> Node {
  rust_serialize_source_node(
    source_text_binding: ^rust_emit_directive_source_literal,
    production_binding: ^rust_production_emit_directive_eprintln,
    tokens: rust_emit_directive_concrete_tokens()
  )
}

fn rust_emit_directive_message_spellings(d: EmitDirective) -> Map<Symbol, String> {
  map_insert(empty_map(), ^emit_directive_message, d.message)
}

fn rust_emit_directive_token_class_emit_transforms() -> Map<Symbol, fn(String) -> String> {
  map_insert(empty_map(), ^rust_token_str_lit, rust_string_literal_spelling)
}

fn rust_emit_directive_target_model(d: EmitDirective) -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: rust_target_model_bundle(
      rules: rust_emit_directive_translation_rules_node(),
      serialize_source: rust_emit_directive_serialize_source_node()
    ),
    lex: rust_emit_directive_lex(),
    binding_spellings: rust_emit_directive_message_spellings(d: d),
    token_class_emit_transforms: rust_emit_directive_token_class_emit_transforms(),
    authority_source_text: rust_emit_directive_source_text(d: d),
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn rust_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn rust_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn rust_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^rust_token_ident,
    pattern: rust_ident_lex_pattern()
  }
}

fn rust_wave1_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      rust_lex_rule(token_class: ^rust_token_kw_fn, text: "fn "),
      rust_ident_lex_rule(),
      rust_lex_rule(token_class: ^rust_token_ty_i32, text: "i32"),
      rust_lex_rule(token_class: ^rust_token_plus, text: " + "),
      rust_lex_rule(token_class: ^rust_token_arrow, text: " -> "),
      rust_lex_rule(token_class: ^rust_token_lbrace, text: " { "),
      rust_lex_rule(token_class: ^rust_token_rbrace, text: " }"),
      rust_lex_rule(token_class: ^rust_token_lparen, text: "("),
      rust_lex_rule(token_class: ^rust_token_rparen, text: ")"),
      rust_lex_rule(token_class: ^rust_token_comma, text: ", "),
      rust_lex_rule(token_class: ^rust_token_colon, text: ": ")
    ]
  }
}

fn rust_wave1_lex() -> LexRules {
  ModeledLexRules { root: rust_wave1_lex_rules() }
}

fn rust_grammar_atom(id: Symbol) -> Node {
  rust_inhabitant_atom(id: id)
}

fn rust_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn rust_formal_production_mvp1_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: ^rust_production_mvp1_fn_add,
    rhs: rust_formal_rhs_from_tokens(tokens: rust_mvp1_concrete_tokens())
  )
}

fn rust_wave1_formal_productions() -> List<FormalProduction> {
  [rust_formal_production_mvp1_fn_add()]
}

fn rust_grammar_production_mvp1_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: ^rust_production_mvp1_fn_add,
    expression: rust_grammar_sequence_from_token_classes(),
    emitted: rust_grammar_atom(id: ^rust_surface_fn_item)
  }
}

fn rust_wave1_grammar_root() -> GrammarRoot {
  let start = rust_grammar_production_mvp1_fn_add()
  GrammarRoot { start: ^rust_production_mvp1_fn_add, productions: [start], sync_tokens: grammar_empty_sync_tokens() }
}

fn rust_wave1_grammar() -> ParseGrammar {
  ModeledGrammar { root: rust_wave1_grammar_root() }
}

fn rust_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: RustIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn rust_float_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: RustFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn rust_noninteger_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: RustNonIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn rust_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      rust_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn rust_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      rust_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn rust_noninteger_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: rust_noninteger_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      rust_noninteger_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn rust_catalog_surface_symbol(sym: Symbol) -> Bool {
  rust_integer_catalog_surface_symbol(sym: sym) ||
    rust_float_catalog_surface_symbol(sym: sym) ||
    rust_noninteger_catalog_surface_symbol(sym: sym)
}

fn rust_wave1_lex_token_symbol(sym: Symbol) -> Bool {
  sym == ^rust_token_kw_fn ||
    sym == ^rust_token_ident ||
    sym == ^rust_token_ty_i32 ||
    sym == ^rust_token_plus ||
    sym == ^rust_token_arrow ||
    sym == ^rust_token_lbrace ||
    sym == ^rust_token_rbrace ||
    sym == ^rust_token_lparen ||
    sym == ^rust_token_rparen ||
    sym == ^rust_token_comma ||
    sym == ^rust_token_colon
}

fn rust_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      rust_catalog_surface_symbol(sym: sym) ||
        rust_wave1_lex_token_symbol(sym: sym) ||
        sym == ^rust_surface_fn_item ||
        sym == ^rust_production_mvp1_fn_add ||
        sym == ^rust_mvp1_source_literal
    }
  }
}

fn rust_symbol_node(id: Symbol) -> Node {
  rust_inhabitant_atom(id: id)
}

fn rust_integer_algebra_witness_node(facts: RustIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^rust_witness_checked_integer_arithmetic, target: rust_symbol_node(id: ^rust_witness_checked_integer_arithmetic)),
      rust_named_edge(name: ^rust_facts_field_std_projection, target: rust_symbol_node(id: facts.std_projection)),
      rust_named_edge(name: ^rust_facts_field_overflow_disposition, target: rust_overflow_disposition_node(disposition: facts.overflow_disposition))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_float_algebra_witness_node(facts: RustFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^rust_witness_float_approximate_field, target: rust_symbol_node(id: ^rust_witness_float_approximate_field)),
      rust_named_edge(name: ^rust_facts_field_ieee754_binary, target: rust_symbol_node(id: facts.ieee754_binary)),
      rust_named_edge(name: ^rust_facts_field_std_projection, target: rust_symbol_node(id: facts.std_projection))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_bool_algebra_witness_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^rust_witness_bool_boolean_algebra, target: rust_symbol_node(id: ^rust_witness_bool_boolean_algebra)),
      rust_named_edge(name: ^rust_facts_field_std_projection, target: rust_symbol_node(id: rust_facts_bool.std_projection))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_integer_algebra_inhabitance(facts: RustIntegerPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = rust_integer_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: ordered_ring_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: rust_integer_algebra_witness_node(facts: facts)
  }
}

fn rust_float_algebra_inhabitance(facts: RustFloatPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = rust_float_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: approximate_field_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: rust_float_algebra_witness_node(facts: facts)
  }
}

fn rust_bool_algebra_inhabitance() -> AlgebraInhabitanceDecl {
  let inhabitant = rust_noninteger_facts_node(facts: rust_facts_bool)
  AlgebraInhabitanceDecl {
    algebra: boolean_algebra_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: rust_bool_algebra_witness_node()
  }
}

fn rust_integer_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: rust_integer_algebra_inhabitance(facts: facts))
    }
  )
}

fn rust_float_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: rust_float_algebra_inhabitance(facts: facts))
    }
  )
}

fn rust_bool_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  [
    rust_bool_algebra_inhabitance()
  ]
}

fn rust_model_core_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  list_append(
    left: list_append(
      left: rust_integer_algebra_inhabitance_decls(),
      right: rust_float_algebra_inhabitance_decls()
    ),
    right: rust_bool_algebra_inhabitance_decls()
  )
}

fn rust_model_core_law_node(witness: Node, algebra: Node, key: RustModelCoreLawKey) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^model_core_wave1_law_field_subject, target: witness),
      rust_named_edge(name: ^model_core_wave1_law_field_algebra, target: algebra),
      rust_named_edge(
        name: ^model_core_wave1_law_field_kind,
        target: rust_inhabitant_atom(id: discriminant(v: key))
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_model_core_law_obligation(witness: Node, law: Node) -> AlgebraLawObligation {
  AlgebraLawObligation {
    inhabitance_witness: witness,
    law: law
  }
}

fn rust_integer_law_obligations(facts: RustIntegerPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = rust_integer_algebra_witness_node(facts: facts)
  let inhabitant = rust_integer_facts_node(facts: facts)
  let algebra = ordered_ring_type_node(inhabitant: inhabitant)
  [
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerAddAssociativeWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerAddCommutativeWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerMulAssociativeWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerMulCommutativeWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerDistributiveWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerTotalOrderOverRepresentableValues
      )
    )
  ]
}

fn rust_float_law_obligations(facts: RustFloatPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = rust_float_algebra_witness_node(facts: facts)
  let inhabitant = rust_float_facts_node(facts: facts)
  let algebra = approximate_field_type_node(inhabitant: inhabitant)
  [
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawFloatIeee754Rounding
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawFloatNanInfCarriedByIeee754
      )
    )
  ]
}

fn rust_bool_algebra_laws() -> List<AlgebraLawObligation> {
  let witness = rust_bool_algebra_witness_node()
  let inhabitant = rust_noninteger_facts_node(facts: rust_facts_bool)
  let algebra = boolean_algebra_type_node(inhabitant: inhabitant)
  [
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawBoolBoundedLattice
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawBoolComplement
      )
    )
  ]
}

fn rust_integer_algebra_laws() -> List<AlgebraLawObligation> {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(left: acc, right: rust_integer_law_obligations(facts: facts))
    }
  )
}

fn rust_float_algebra_laws() -> List<AlgebraLawObligation> {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(left: acc, right: rust_float_law_obligations(facts: facts))
    }
  )
}

fn rust_model_core_law_obligations() -> List<AlgebraLawObligation> {
  list_append(
    left: list_append(
      left: rust_integer_algebra_laws(),
      right: rust_float_algebra_laws()
    ),
    right: rust_bool_algebra_laws()
  )
}

fn rust_pure_operation(operation: Symbol) -> PrimitiveOperationRef {
  PrimitiveOperationRef {
    operation: rust_symbol_node(id: operation),
    effect_signature: EffectSignature {
      signature: rust_symbol_node(id: ^rust_effect_signature_pure_value)
    }
  }
}

fn rust_effect_semantics_wave2() -> EffectSemanticsDecl {
  EffectSemanticsDecl {
    operations: [
      rust_pure_operation(operation: ^rust_op_integer_add),
      rust_pure_operation(operation: ^rust_op_integer_sub),
      rust_pure_operation(operation: ^rust_op_integer_mul),
      rust_pure_operation(operation: ^rust_op_integer_neg),
      rust_pure_operation(operation: ^rust_op_integer_div),
      rust_pure_operation(operation: ^rust_op_integer_rem),
      rust_pure_operation(operation: ^rust_op_integer_compare),
      rust_pure_operation(operation: ^rust_op_float_add),
      rust_pure_operation(operation: ^rust_op_float_sub),
      rust_pure_operation(operation: ^rust_op_float_mul),
      rust_pure_operation(operation: ^rust_op_float_div),
      rust_pure_operation(operation: ^rust_op_float_compare),
      rust_pure_operation(operation: ^rust_op_bool_and),
      rust_pure_operation(operation: ^rust_op_bool_or),
      rust_pure_operation(operation: ^rust_op_bool_not)
    ]
  }
}

fn rust_fail_closed_partial_operation(
  operation: Symbol,
  precondition: Symbol,
  reason: Symbol
) -> PartialOperationDecl {
  PartialOperationDecl {
    operation: rust_symbol_node(id: operation),
    precondition: rust_symbol_node(id: precondition),
    discharge: FailClosedAtBoundary { reason: reason }
  }
}

fn rust_partiality_semantics_wave2() -> PartialitySemanticsDecl {
  PartialitySemanticsDecl {
    operations: [
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_add,
        precondition: ^rust_precondition_integer_result_representable,
        reason: ^rust_partial_checked_integer_overflow
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_sub,
        precondition: ^rust_precondition_integer_result_representable,
        reason: ^rust_partial_checked_integer_overflow
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_mul,
        precondition: ^rust_precondition_integer_result_representable,
        reason: ^rust_partial_checked_integer_overflow
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_neg,
        precondition: ^rust_precondition_integer_result_representable,
        reason: ^rust_partial_checked_integer_overflow
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_div,
        precondition: ^rust_precondition_integer_divisor_nonzero,
        reason: ^rust_partial_integer_divide_by_zero
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_rem,
        precondition: ^rust_precondition_integer_divisor_nonzero,
        reason: ^rust_partial_integer_remainder_by_zero
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_div,
        precondition: ^rust_precondition_signed_division_not_min_over_negative_one,
        reason: ^rust_partial_signed_min_divide_by_negative_one
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_rem,
        precondition: ^rust_precondition_signed_division_not_min_over_negative_one,
        reason: ^rust_partial_signed_min_divide_by_negative_one
      )
    ]
  }
}

fn rust_per_language_fact_bundle_key(
  subject_carrier: Node,
  fact_axis: ModelCorePrimitiveFactAxis
) -> PerLanguageFactBundleKey {
  PerLanguageFactBundleKey {
    subject_carrier: subject_carrier,
    target: rust_mvp1_target_model(),
    fact_axis: fact_axis
  }
}

fn rust_per_language_fact_bundle_entry(
  subject_carrier: Node,
  fact_axis: ModelCorePrimitiveFactAxis,
  fact_value: Node
) -> PerLanguageFactBundleEntry {
  PerLanguageFactBundleEntry {
    key: rust_per_language_fact_bundle_key(
      subject_carrier: subject_carrier,
      fact_axis: fact_axis
    ),
    fact_value: fact_value
  }
}

fn rust_integer_per_language_fact_bundle_entries(
  facts: RustIntegerPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  let subject_carrier = rust_integer_facts_node(facts: facts)
  [
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisSurfaceSpelling {},
      fact_value: rust_inhabitant_atom(id: facts.surface_spelling)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisWidth {},
      fact_value: rust_int_width_node(width: facts.overflow_disposition.ir_carrier.width)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisSignedness {},
      fact_value: rust_int_kind_node(kind: facts.overflow_disposition.ir_carrier.kind)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisEncoding {},
      fact_value: rust_inhabitant_atom(id: ^rust_repr_integer_twos_complement)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisRange {},
      fact_value: rust_integer_range_node(carrier: facts.overflow_disposition.ir_carrier)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisOverflowDisposition {},
      fact_value: rust_overflow_disposition_node(disposition: facts.overflow_disposition)
    )
  ]
}

fn rust_float_per_language_fact_bundle_entries(
  facts: RustFloatPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  let subject_carrier = rust_float_facts_node(facts: facts)
  [
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisSurfaceSpelling {},
      fact_value: rust_inhabitant_atom(id: facts.surface_spelling)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisWidth {},
      fact_value: rust_float_width_node(width: facts.width)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisEncoding {},
      fact_value: rust_inhabitant_atom(id: facts.ieee754_binary)
    )
  ]
}

fn rust_noninteger_per_language_fact_bundle_entries(
  facts: RustNonIntegerPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  let subject_carrier = rust_noninteger_facts_node(facts: facts)
  [
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisSurfaceSpelling {},
      fact_value: rust_inhabitant_atom(id: facts.surface_spelling)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisEncoding {},
      fact_value: rust_inhabitant_atom(id: facts.representation)
    )
  ]
}

fn rust_per_language_fact_bundle_entries_from_integer_catalog() -> List<PerLanguageFactBundleEntry> {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(
        left: acc,
        right: rust_integer_per_language_fact_bundle_entries(facts: facts)
      )
    }
  )
}

fn rust_per_language_fact_bundle_entries_from_float_catalog() -> List<PerLanguageFactBundleEntry> {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(
        left: acc,
        right: rust_float_per_language_fact_bundle_entries(facts: facts)
      )
    }
  )
}

fn rust_per_language_fact_bundle_entries_from_noninteger_catalog() -> List<PerLanguageFactBundleEntry> {
  fold_list(
    xs: rust_noninteger_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(
        left: acc,
        right: rust_noninteger_per_language_fact_bundle_entries(facts: facts)
      )
    }
  )
}

fn rust_per_language_fact_bundle_entries() -> List<PerLanguageFactBundleEntry> {
  list_append(
    left: list_append(
      left: rust_per_language_fact_bundle_entries_from_integer_catalog(),
      right: rust_per_language_fact_bundle_entries_from_float_catalog()
    ),
    right: rust_per_language_fact_bundle_entries_from_noninteger_catalog()
  )
}

fn rust_insert_per_language_fact_bundle_entry_outcome(
  acc: Outcome<PerLanguageFactBundleRegistry>,
  entry: PerLanguageFactBundleEntry
) -> Outcome<PerLanguageFactBundleRegistry> {
  match acc {
    Accepted { value: registry, diagnostics: _ } =>
      insert_per_language_fact_bundle_entry(
        registry: registry,
        key: entry.key,
        fact_value: entry.fact_value
      )
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_per_language_fact_bundle_registry() -> Outcome<PerLanguageFactBundleRegistry> {
  fold_list(
    xs: rust_per_language_fact_bundle_entries(),
    empty: outcome_accepted(value: empty_per_language_fact_bundle_registry()),
    cons: fn(acc, entry) {
      rust_insert_per_language_fact_bundle_entry_outcome(acc: acc, entry: entry)
    }
  )
}

fn rust_snoc_primitive_bundle(
  acc: Outcome<List<PrimitiveFactBundle>>,
  registry: PerLanguageFactBundleRegistry,
  subject_carrier: Node
) -> Outcome<List<PrimitiveFactBundle>> {
  match acc {
    Accepted { value: bundles, diagnostics: _ } => match primitive_fact_bundle_for_subject(
      registry: registry,
      subject_carrier: subject_carrier,
      target: rust_mvp1_target_model()
    ) {
      Accepted { value: bundle, diagnostics: d } =>
        Accepted {
          value: list_snoc_item(xs: bundles, item: bundle),
          diagnostics: d
        }
      Rejected { diagnostics: d } => Rejected { diagnostics: d }
    }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_primitive_bundles_from_integer_catalog_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc, facts) {
      rust_snoc_primitive_bundle(
        acc: acc,
        registry: registry,
        subject_carrier: rust_integer_facts_node(facts: facts)
      )
    }
  )
}

fn rust_primitive_bundles_from_float_catalog_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc, facts) {
      rust_snoc_primitive_bundle(
        acc: acc,
        registry: registry,
        subject_carrier: rust_float_facts_node(facts: facts)
      )
    }
  )
}

fn rust_primitive_bundles_from_noninteger_catalog_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  fold_list(
    xs: rust_noninteger_facts_catalog,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc, facts) {
      rust_snoc_primitive_bundle(
        acc: acc,
        registry: registry,
        subject_carrier: rust_noninteger_facts_node(facts: facts)
      )
    }
  )
}

fn rust_append_primitive_bundle_outcomes(
  left: Outcome<List<PrimitiveFactBundle>>,
  right: Outcome<List<PrimitiveFactBundle>>
) -> Outcome<List<PrimitiveFactBundle>> {
  match left {
    Accepted { value: l, diagnostics: _ } => match right {
      Accepted { value: r, diagnostics: d } =>
        Accepted { value: list_append(left: l, right: r), diagnostics: d }
      Rejected { diagnostics: d } => Rejected { diagnostics: d }
    }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_wave1_primitive_fact_bundles_from_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  rust_append_primitive_bundle_outcomes(
    left: rust_append_primitive_bundle_outcomes(
      left: rust_primitive_bundles_from_integer_catalog_registry(registry: registry),
      right: rust_primitive_bundles_from_float_catalog_registry(registry: registry)
    ),
    right: rust_primitive_bundles_from_noninteger_catalog_registry(registry: registry)
  )
}

fn rust_model_core_wave1() -> Outcome<ModelCore> {
  match rust_per_language_fact_bundle_registry() {
    Accepted { value: registry, diagnostics: _ } =>
      match rust_wave1_primitive_fact_bundles_from_registry(registry: registry) {
        Accepted { value: primitives, diagnostics: d } =>
          Accepted {
            value: ModelCore {
              primitives: primitives,
              inhabitance: rust_model_core_inhabitance_decls(),
              laws: rust_model_core_law_obligations(),
              effects: rust_effect_semantics_wave2(),
              partiality: rust_partiality_semantics_wave2()
            },
            diagnostics: d
          }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_language_model_wave1() -> Outcome<LanguageModel> {
  match rust_model_core_wave1() {
    Accepted { value: core, diagnostics: d } =>
      Accepted {
        value: LanguageModel {
          lex: rust_wave1_lex(),
          grammar: rust_wave1_grammar(),
          language_identity: ^rust_language_model_surface_id,
          canonical_symbols: rust_language_model_canonical_symbols(),
          core: core
        },
        diagnostics: d
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_whitespace_trivia_rule() -> LexRule {
  TriviaRule {
    pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } }
  }
}

fn rust_int_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^rust_token_int_literal,
    pattern: OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
  }
}

fn rust_wave2_additional_lex_rules() -> List<LexRule> {
  [
    rust_whitespace_trivia_rule(),
    rust_int_literal_lex_rule(),
    rust_lex_rule(token_class: ^rust_token_kw_let, text: "let"),
    rust_lex_rule(token_class: ^rust_token_kw_if, text: "if"),
    rust_lex_rule(token_class: ^rust_token_kw_else, text: "else"),
    rust_lex_rule(token_class: ^rust_token_kw_return, text: "return"),
    rust_lex_rule(token_class: ^rust_token_equal, text: "="),
    rust_lex_rule(token_class: ^rust_token_gt, text: ">"),
    rust_lex_rule(token_class: ^rust_token_semicolon, text: ";")
  ]
}

fn rust_wave2_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: list_append(
      left: rust_wave1_lex_rules().rules,
      right: rust_wave2_additional_lex_rules()
    )
  }
}

fn rust_wave2_lex() -> LexRules {
  ModeledLexRules { root: rust_wave2_lex_rules() }
}

fn rust_wave2_formal_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(lhs: ^rust_production_type, rhs: [grammar_formal_terminal(identity: ^rust_token_ty_i32)]),
    grammar_formal_production(
      lhs: ^rust_production_typed_param,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_ident),
        grammar_formal_terminal(identity: ^rust_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_type)
      ]
    ),
    grammar_formal_production(lhs: ^rust_production_param_list, rhs: []),
    grammar_formal_production(
      lhs: ^rust_production_param_list,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_typed_param)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_param_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_typed_param),
        grammar_formal_terminal(identity: ^rust_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_typed_param),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_param_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^rust_production_param_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^rust_production_param_list_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_typed_param),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_param_list_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_fn_item,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_fn),
        grammar_formal_terminal(identity: ^rust_token_ident),
        grammar_formal_terminal(identity: ^rust_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_param_list),
        grammar_formal_terminal(identity: ^rust_token_rparen),
        grammar_formal_terminal(identity: ^rust_token_arrow),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_type),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block)
      ]
    ),
    grammar_formal_production(lhs: ^rust_production_primary_expr, rhs: [grammar_formal_terminal(identity: ^rust_token_ident)]),
    grammar_formal_production(
      lhs: ^rust_production_primary_expr,
      rhs: [grammar_formal_terminal(identity: ^rust_token_int_literal)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_primary_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_terminal(identity: ^rust_token_rparen)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_additive_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_primary_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_additive_expr,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_additive_expr),
        grammar_formal_terminal(identity: ^rust_token_plus),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_primary_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_comparison_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_additive_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_comparison_expr,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_additive_expr),
        grammar_formal_terminal(identity: ^rust_token_gt),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_additive_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_return_expr,
      rhs: [grammar_formal_terminal(identity: ^rust_token_kw_return)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_return_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_return),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_without_block,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_return_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_without_block,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_comparison_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lbrace),
        grammar_formal_terminal(identity: ^rust_token_rbrace)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lbrace),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_terminal(identity: ^rust_token_rbrace)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lbrace),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmts),
        grammar_formal_terminal(identity: ^rust_token_rbrace)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lbrace),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmts),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_terminal(identity: ^rust_token_rbrace)
      ]
    ),
    grammar_formal_production(lhs: ^rust_production_stmts, rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmt)]),
    grammar_formal_production(
      lhs: ^rust_production_stmts,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmts),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmt)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_let),
        grammar_formal_terminal(identity: ^rust_token_ident),
        grammar_formal_terminal(identity: ^rust_token_equal),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_terminal(identity: ^rust_token_semicolon)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_stmt,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_without_block),
        grammar_formal_terminal(identity: ^rust_token_semicolon)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_with_block)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_stmt,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_with_block),
        grammar_formal_terminal(identity: ^rust_token_semicolon)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_let_stmt)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_stmt)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_with_block,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_if_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_with_block,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_block)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_if_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_if),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_if_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_if),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block),
        grammar_formal_terminal(identity: ^rust_token_kw_else),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_if_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_if),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block),
        grammar_formal_terminal(identity: ^rust_token_kw_else),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_if_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_with_block)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_without_block)]
    ),
    rust_formal_production_mvp1_fn_add()
  ]
}

fn rust_formal_production_matches_lhs(production: FormalProduction, lhs: Symbol) -> Bool {
  production.lhs.identity == lhs
}

fn rust_formal_production_list_has_lhs(productions: List<FormalProduction>, lhs: Symbol) -> Bool {
  fold_list(
    xs: productions,
    empty: false,
    cons: fn(found, production) {
      found || rust_formal_production_matches_lhs(production: production, lhs: lhs)
    }
  )
}

fn rust_grammar_nonterminal(production: Symbol) -> GrammarExpr {
  Nonterminal { production: production }
}

fn rust_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}

fn rust_grammar_choice(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Choice { left: left, right: right }
}

fn rust_grammar_optional(element: GrammarExpr) -> GrammarExpr {
  Optional { element: element }
}

fn rust_grammar_repeat(element: GrammarExpr) -> GrammarExpr {
  Repeat { element: element }
}

fn rust_grammar_production(name: Symbol, expression: GrammarExpr, emitted: Symbol) -> GrammarProduction {
  GrammarProduction {
    name: name,
    expression: expression,
    emitted: rust_grammar_atom(id: emitted)
  }
}

fn rust_grammar_type_expr() -> GrammarExpr {
  rust_grammar_terminal(token_class: ^rust_token_ty_i32)
}

fn rust_grammar_typed_param_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_ident),
    right: rust_grammar_sequence(
      left: rust_grammar_terminal(token_class: ^rust_token_colon),
      right: rust_grammar_nonterminal(production: ^rust_production_type)
    )
  )
}

fn rust_grammar_param_list_expr() -> GrammarExpr {
  rust_grammar_optional(
    element: rust_grammar_sequence(
      left: rust_grammar_nonterminal(production: ^rust_production_typed_param),
      right: rust_grammar_repeat(
        element: rust_grammar_sequence(
          left: rust_grammar_terminal(token_class: ^rust_token_comma),
          right: rust_grammar_nonterminal(production: ^rust_production_typed_param)
        )
      )
    )
  )
}

fn rust_grammar_primary_expr() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_terminal(token_class: ^rust_token_ident),
    right: rust_grammar_choice(
      left: rust_grammar_terminal(token_class: ^rust_token_int_literal),
      right: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_lparen),
        right: rust_grammar_sequence(
          left: rust_grammar_nonterminal(production: ^rust_production_expr),
          right: rust_grammar_terminal(token_class: ^rust_token_rparen)
        )
      )
    )
  )
}

fn rust_grammar_additive_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_nonterminal(production: ^rust_production_primary_expr),
    right: rust_grammar_repeat(
      element: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_plus),
        right: rust_grammar_nonterminal(production: ^rust_production_primary_expr)
      )
    )
  )
}

fn rust_grammar_comparison_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_nonterminal(production: ^rust_production_additive_expr),
    right: rust_grammar_optional(
      element: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_gt),
        right: rust_grammar_nonterminal(production: ^rust_production_additive_expr)
      )
    )
  )
}

fn rust_grammar_expr_without_block() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_nonterminal(production: ^rust_production_return_expr),
    right: rust_grammar_nonterminal(production: ^rust_production_comparison_expr)
  )
}

fn rust_grammar_expr_with_block() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_nonterminal(production: ^rust_production_if_expr),
    right: rust_grammar_nonterminal(production: ^rust_production_block)
  )
}

fn rust_grammar_expr_expr() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_nonterminal(production: ^rust_production_expr_with_block),
    right: rust_grammar_nonterminal(production: ^rust_production_expr_without_block)
  )
}

fn rust_grammar_expr_stmt_expr() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_sequence(
      left: rust_grammar_nonterminal(production: ^rust_production_expr_without_block),
      right: rust_grammar_terminal(token_class: ^rust_token_semicolon)
    ),
    right: rust_grammar_sequence(
      left: rust_grammar_nonterminal(production: ^rust_production_expr_with_block),
      right: rust_grammar_optional(
        element: rust_grammar_terminal(token_class: ^rust_token_semicolon)
      )
    )
  )
}

fn rust_grammar_return_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_kw_return),
    right: rust_grammar_optional(
      element: rust_grammar_nonterminal(production: ^rust_production_expr)
    )
  )
}

fn rust_grammar_let_stmt_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_kw_let),
    right: rust_grammar_sequence(
      left: rust_grammar_terminal(token_class: ^rust_token_ident),
      right: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_equal),
        right: rust_grammar_sequence(
          left: rust_grammar_nonterminal(production: ^rust_production_expr),
          right: rust_grammar_terminal(token_class: ^rust_token_semicolon)
        )
      )
    )
  )
}

fn rust_grammar_if_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_kw_if),
    right: rust_grammar_sequence(
      left: rust_grammar_nonterminal(production: ^rust_production_expr),
      right: rust_grammar_sequence(
        left: rust_grammar_nonterminal(production: ^rust_production_block),
        right: rust_grammar_optional(
          element: rust_grammar_sequence(
            left: rust_grammar_terminal(token_class: ^rust_token_kw_else),
            right: rust_grammar_choice(
              left: rust_grammar_nonterminal(production: ^rust_production_block),
              right: rust_grammar_nonterminal(production: ^rust_production_if_expr)
            )
          )
        )
      )
    )
  )
}

fn rust_grammar_stmt_expr() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_nonterminal(production: ^rust_production_let_stmt),
    right: rust_grammar_nonterminal(production: ^rust_production_expr_stmt)
  )
}

fn rust_grammar_block_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_lbrace),
    right: rust_grammar_sequence(
      left: rust_grammar_repeat(element: rust_grammar_nonterminal(production: ^rust_production_stmt)),
      right: rust_grammar_sequence(
        left: rust_grammar_optional(element: rust_grammar_nonterminal(production: ^rust_production_expr)),
        right: rust_grammar_terminal(token_class: ^rust_token_rbrace)
      )
    )
  )
}

fn rust_grammar_fn_item_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_kw_fn),
    right: rust_grammar_sequence(
      left: rust_grammar_terminal(token_class: ^rust_token_ident),
      right: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_lparen),
        right: rust_grammar_sequence(
          left: rust_grammar_nonterminal(production: ^rust_production_param_list),
          right: rust_grammar_sequence(
            left: rust_grammar_terminal(token_class: ^rust_token_rparen),
            right: rust_grammar_sequence(
              left: rust_grammar_terminal(token_class: ^rust_token_arrow),
              right: rust_grammar_sequence(
                left: rust_grammar_nonterminal(production: ^rust_production_type),
                right: rust_grammar_nonterminal(production: ^rust_production_block)
              )
            )
          )
        )
      )
    )
  )
}

fn rust_wave2_grammar_root() -> GrammarRoot {
  let fn_item = rust_grammar_production(
    name: ^rust_production_fn_item,
    expression: rust_grammar_fn_item_expr(),
    emitted: ^rust_surface_fn_item
  )
  let typed_param = rust_grammar_production(
    name: ^rust_production_typed_param,
    expression: rust_grammar_typed_param_expr(),
    emitted: ^rust_surface_typed_param
  )
  let param_list = rust_grammar_production(
    name: ^rust_production_param_list,
    expression: rust_grammar_param_list_expr(),
    emitted: ^rust_surface_param_list
  )
  let type_prod = rust_grammar_production(
    name: ^rust_production_type,
    expression: rust_grammar_type_expr(),
    emitted: ^rust_surface_type
  )
  let block = rust_grammar_production(
    name: ^rust_production_block,
    expression: rust_grammar_block_expr(),
    emitted: ^rust_surface_block
  )
  let stmt = rust_grammar_production(
    name: ^rust_production_stmt,
    expression: rust_grammar_stmt_expr(),
    emitted: ^rust_surface_stmt
  )
  let expr_stmt = rust_grammar_production(
    name: ^rust_production_expr_stmt,
    expression: rust_grammar_expr_stmt_expr(),
    emitted: ^rust_surface_expr_stmt
  )
  let let_stmt = rust_grammar_production(
    name: ^rust_production_let_stmt,
    expression: rust_grammar_let_stmt_expr(),
    emitted: ^rust_surface_let_stmt
  )
  let if_expr = rust_grammar_production(
    name: ^rust_production_if_expr,
    expression: rust_grammar_if_expr(),
    emitted: ^rust_surface_if_expr
  )
  let return_expr = rust_grammar_production(
    name: ^rust_production_return_expr,
    expression: rust_grammar_return_expr(),
    emitted: ^rust_surface_return_expr
  )
  let expr_without_block = rust_grammar_production(
    name: ^rust_production_expr_without_block,
    expression: rust_grammar_expr_without_block(),
    emitted: ^rust_surface_expr_without_block
  )
  let expr_with_block = rust_grammar_production(
    name: ^rust_production_expr_with_block,
    expression: rust_grammar_expr_with_block(),
    emitted: ^rust_surface_expr_with_block
  )
  let expr = rust_grammar_production(
    name: ^rust_production_expr,
    expression: rust_grammar_expr_expr(),
    emitted: ^rust_surface_expr
  )
  let comparison_expr = rust_grammar_production(
    name: ^rust_production_comparison_expr,
    expression: rust_grammar_comparison_expr(),
    emitted: ^rust_surface_comparison_expr
  )
  let additive_expr = rust_grammar_production(
    name: ^rust_production_additive_expr,
    expression: rust_grammar_additive_expr(),
    emitted: ^rust_surface_additive_expr
  )
  let primary_expr = rust_grammar_production(
    name: ^rust_production_primary_expr,
    expression: rust_grammar_primary_expr(),
    emitted: ^rust_surface_primary_expr
  )
  let mvp1_fn_add = rust_grammar_production_mvp1_fn_add()
  GrammarRoot {
    start: ^rust_production_fn_item,
    productions: [
      fn_item,
      typed_param,
      param_list,
      type_prod,
      block,
      stmt,
      expr_stmt,
      let_stmt,
      if_expr,
      return_expr,
      expr_without_block,
      expr_with_block,
      expr,
      comparison_expr,
      additive_expr,
      primary_expr,
      mvp1_fn_add
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn rust_wave2_grammar() -> ParseGrammar {
  ModeledGrammar { root: rust_wave2_grammar_root() }
}

fn rust_language_model_wave2_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      rust_catalog_surface_symbol(sym: sym) ||
        lex_rule_set_token_class_member(rules: rust_wave2_lex_rules(), token_class: sym) ||
        grammar_carries_symbol(grammar: rust_wave2_grammar(), sym: sym) ||
        sym == ^rust_surface_fn_item ||
        sym == ^rust_production_mvp1_fn_add ||
        sym == ^rust_mvp1_source_literal
    }
  }
}

fn rust_language_model_wave2() -> Outcome<LanguageModel> {
  match rust_model_core_wave1() {
    Accepted { value: core, diagnostics: d } =>
      Accepted {
        value: LanguageModel {
          lex: rust_wave2_lex(),
          grammar: rust_wave2_grammar(),
          language_identity: ^rust_language_model_surface_id,
          canonical_symbols: rust_language_model_wave2_canonical_symbols(),
          core: core
        },
        diagnostics: d
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_type_expression_projection() -> TargetTypeExpressionProjection {
  TargetTypeExpressionProjection {
    atom_form: TargetAtomTypeShape {
      surface: ^rust_surface_type_atom,
      ident_token: ^rust_token_ident
    },
    conj_form: TargetGenericApply {
      surface: ^rust_surface_type_record,
      open: ^rust_token_lbrace,
      separator: ^rust_token_comma,
      field_label_separator: optional_present(value: ^rust_token_colon),
      close: ^rust_token_rbrace
    },
    disj_form: TargetSumTypeShape {
      surface: ^rust_surface_type_sum,
      variant_separator: ^rust_token_pipe
    },
    arrow_form: TargetFunctionTypeShape {
      surface: ^rust_surface_type_arrow,
      open: ^rust_token_lparen,
      close: ^rust_token_rparen,
      arrow: ^rust_token_arrow,
      param_ident_token: ^rust_token_ident,
      param_type_separator: ^rust_token_colon,
      param_list_separator: ^rust_token_comma
    },
    cardinality_form: TargetGenericApply {
      surface: ^rust_surface_type_cardinality,
      open: ^rust_token_lt,
      separator: ^rust_token_comma,
      field_label_separator: optional_absent(),
      close: ^rust_token_gt
    },
    instantiation_form: TargetGenericApply {
      surface: ^rust_surface_type_generic_apply,
      open: ^rust_token_lt,
      separator: ^rust_token_comma,
      field_label_separator: optional_absent(),
      close: ^rust_token_gt
    }
  }
}
data rust_sg2_type_alias_text: String = "type Sg2Probe = Rc<FooBar<X, Y>>;"

fn rust_reference_layer_tokens() -> TargetReferenceLayerTokens {
  TargetReferenceLayerTokens {
    rc_type_head: ^rust_binding_sg2_rc,
    box_type_head: ^rust_binding_sg_rc_box,
    rc_new_ctor: ^rust_sg_rc_ctor_rc_new,
    box_new_ctor: ^rust_sg_rc_ctor_box_new
  }
}

