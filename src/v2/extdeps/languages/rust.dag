type RustIntKind
  = Signed
  | Unsigned

type RustIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Bits128
  | Pointer

type RustFloatWidth
  = FloatBits32
  | FloatBits64

type RustScalar
  = IntScalar { kind: RustIntKind, width: RustIntWidth }
  | FloatScalar { width: RustFloatWidth }
  | BoolScalar
  | CharScalar
  | StrScalar
  | UnitScalar
  | NeverScalar

type RustIntegerCarrier {
  kind: RustIntKind
  width: RustIntWidth
}

type RustIntegerPrimitiveFacts {
  surface_spelling: Symbol
  overflow_disposition: OverflowDisposition<RustIntegerCarrier>
  std_projection: Symbol
}

type RustFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: RustFloatWidth
  ieee754_binary: Symbol
  std_projection: Symbol
}

type RustNonIntegerScalar
  = NonIntegerBoolScalar
  | NonIntegerCharScalar
  | NonIntegerStrScalar
  | NonIntegerUnitScalar
  | NonIntegerNeverScalar

type RustNonIntegerPrimitiveFacts {
  surface_spelling: Symbol
  scalar: RustNonIntegerScalar
  std_projection: Symbol
  representation: Symbol
}

type RustReferenceKind
  = Shared
  | Exclusive

type NamedSegment {
  id: Symbol
}

type PubInPath {
  resolved_path: List<NamedSegment>
}

type RustVisibility
  = Private
  | Pub
  | PubIn { path: PubInPath }

type RustReference {
  kind: RustReferenceKind
  lifetime: Symbol
  referent: Node
}

type RustCost {
  instruction_cost: Int
  allocation_cost: Int
}

type OverflowAction
  = PanicOnOverflow
  | TwoComplementWrap

type OverflowDisposition<IRCarrier> {
  ir_carrier: IRCarrier
  checked_arithmetic_debug_default: OverflowAction
  checked_arithmetic_release_default: OverflowAction
  checked_arithmetic_overflow_checks_enabled: OverflowAction
  checked_arithmetic_overflow_checks_disabled: OverflowAction
}

type RustGrammarRelationRow {
  production: GrammarProduction
  emitted: Node
  tokens: List<ConcreteSyntaxToken>
}

type RustModelCoreLawKey
  = RustLawIntegerAddAssociativeWhenRepresentable
  | RustLawIntegerAddCommutativeWhenRepresentable
  | RustLawIntegerMulAssociativeWhenRepresentable
  | RustLawIntegerMulCommutativeWhenRepresentable
  | RustLawIntegerDistributiveWhenRepresentable
  | RustLawIntegerTotalOrderOverRepresentableValues
  | RustLawFloatIeee754Rounding
  | RustLawFloatNanInfCarriedByIeee754
  | RustLawBoolBoundedLattice
  | RustLawBoolComplement
fn rust_integer_overflow_disposition(kind: RustIntKind, width: RustIntWidth) -> OverflowDisposition<RustIntegerCarrier> {
  OverflowDisposition {
    ir_carrier: RustIntegerCarrier { kind: kind, width: width },
    checked_arithmetic_debug_default: PanicOnOverflow,
    checked_arithmetic_release_default: TwoComplementWrap,
    checked_arithmetic_overflow_checks_enabled: PanicOnOverflow,
    checked_arithmetic_overflow_checks_disabled: TwoComplementWrap
  }
}

fn rust_mvp1_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_kw_fn },
    BoundToken { token_class: ^rust_token_ident, binding: ^rust_binding_fn_add },
    FixedToken { token_class: ^rust_token_lparen },
    BoundToken { token_class: ^rust_token_ident, binding: ^rust_binding_param_x },
    FixedToken { token_class: ^rust_token_colon },
    FixedToken { token_class: ^rust_token_ty_i32 },
    FixedToken { token_class: ^rust_token_comma },
    BoundToken { token_class: ^rust_token_ident, binding: ^rust_binding_param_y },
    FixedToken { token_class: ^rust_token_colon },
    FixedToken { token_class: ^rust_token_ty_i32 },
    FixedToken { token_class: ^rust_token_rparen },
    FixedToken { token_class: ^rust_token_arrow },
    FixedToken { token_class: ^rust_token_ty_i32 },
    FixedToken { token_class: ^rust_token_lbrace },
    BoundToken { token_class: ^rust_token_ident, binding: ^rust_binding_param_x },
    FixedToken { token_class: ^rust_token_plus },
    BoundToken { token_class: ^rust_token_ident, binding: ^rust_binding_param_y },
    FixedToken { token_class: ^rust_token_rbrace }
  ]
}
data rust_mvp1_source_text: String = "fn add(x: i32, y: i32) -> i32 { x + y }"

