data rust_fixture_i32_inhabitant: Node = rust_inhabitant_i32_node()

data rust_fixture_emitted_add_fn: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: rust_fixture_i32_inhabitant },
    Edge { label: Positional, target: rust_fixture_i32_inhabitant },
    Edge { label: Positional, target: rust_fixture_i32_inhabitant }
  ],
