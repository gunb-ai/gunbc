  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^rust_inhabitant_field_i8, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_i8, facts: rust_facts_i8)),
      rust_named_edge(name: ^rust_inhabitant_field_i16, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_i16, facts: rust_facts_i16)),
      rust_named_edge(name: ^rust_inhabitant_field_i32, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_i32, facts: rust_facts_i32)),
      rust_named_edge(name: ^rust_inhabitant_field_i64, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_i64, facts: rust_facts_i64)),
      rust_named_edge(name: ^rust_inhabitant_field_i128, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_i128, facts: rust_facts_i128)),
      rust_named_edge(name: ^rust_inhabitant_field_u8, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_u8, facts: rust_facts_u8)),
      rust_named_edge(name: ^rust_inhabitant_field_u16, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_u16, facts: rust_facts_u16)),
      rust_named_edge(name: ^rust_inhabitant_field_u32, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_u32, facts: rust_facts_u32)),
      rust_named_edge(name: ^rust_inhabitant_field_u64, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_u64, facts: rust_facts_u64)),
      rust_named_edge(name: ^rust_inhabitant_field_u128, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_u128, facts: rust_facts_u128)),
      rust_named_edge(name: ^rust_inhabitant_field_isize, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_isize, facts: rust_facts_isize)),
      rust_named_edge(name: ^rust_inhabitant_field_usize, target: rust_integer_inhabitant_node(id: ^rust_inhabitant_usize, facts: rust_facts_usize)),
      rust_named_edge(name: ^rust_inhabitant_field_f32, target: rust_float_inhabitant_node(id: ^rust_inhabitant_f32, facts: rust_facts_f32)),
