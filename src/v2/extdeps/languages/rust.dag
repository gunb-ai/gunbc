fn rust_grammar_production_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: ^rust_production_fn_add,
    expression: rust_grammar_sequence_from_token_classes(),
    emitted: rust_grammar_atom(id: ^rust_surface_fn_item)
  }
}

fn rust_fn_add_grammar_root() -> GrammarRoot {
  let start = rust_grammar_production_fn_add()
  GrammarRoot { start: ^rust_production_fn_add, productions: [start], sync_tokens: grammar_empty_sync_tokens() }
}

fn rust_fn_add_grammar() -> ParseGrammar {
  ModeledGrammar { root: rust_fn_add_grammar_root() }
}

fn rust_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: RustIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn rust_float_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: RustFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn rust_noninteger_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: RustNonIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn rust_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      rust_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn rust_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      rust_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn rust_noninteger_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: rust_noninteger_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      rust_noninteger_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn rust_catalog_surface_symbol(sym: Symbol) -> Bool {
  rust_integer_catalog_surface_symbol(sym: sym) ||
    rust_float_catalog_surface_symbol(sym: sym) ||
    rust_noninteger_catalog_surface_symbol(sym: sym)
}

fn rust_fn_add_lex_token_symbol(sym: Symbol) -> Bool {
  lex_rule_set_token_class_member(rules: rust_fn_add_lex_rules(), token_class: sym)
}

fn rust_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      rust_catalog_surface_symbol(sym: sym) ||
        rust_fn_add_lex_token_symbol(sym: sym) ||
        sym == ^rust_surface_fn_item ||
        sym == ^rust_production_fn_add ||
        sym == ^rust_source_literal
    }
  }
}

fn rust_symbol_node(id: Symbol) -> Node {
  rust_inhabitant_atom(id: id)
}

fn rust_integer_algebra_witness_node(facts: RustIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^rust_witness_checked_integer_arithmetic, target: rust_symbol_node(id: ^rust_witness_checked_integer_arithmetic)),
      rust_named_edge(name: ^rust_facts_field_std_projection, target: rust_symbol_node(id: facts.std_projection)),
      rust_named_edge(name: ^rust_facts_field_overflow_disposition, target: rust_overflow_disposition_node(disposition: facts.overflow_disposition))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_float_algebra_witness_node(facts: RustFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^rust_witness_float_approximate_field, target: rust_symbol_node(id: ^rust_witness_float_approximate_field)),
      rust_named_edge(name: ^rust_facts_field_ieee754_binary, target: rust_symbol_node(id: facts.ieee754_binary)),
      rust_named_edge(name: ^rust_facts_field_std_projection, target: rust_symbol_node(id: facts.std_projection))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_bool_algebra_witness_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^rust_witness_bool_boolean_algebra, target: rust_symbol_node(id: ^rust_witness_bool_boolean_algebra)),
      rust_named_edge(name: ^rust_facts_field_std_projection, target: rust_symbol_node(id: rust_facts_bool.std_projection))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_integer_algebra_inhabitance(facts: RustIntegerPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = rust_integer_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: ordered_ring_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: rust_integer_algebra_witness_node(facts: facts)
  }
}

fn rust_float_algebra_inhabitance(facts: RustFloatPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = rust_float_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: approximate_field_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: rust_float_algebra_witness_node(facts: facts)
  }
}

fn rust_bool_algebra_inhabitance() -> AlgebraInhabitanceDecl {
  let inhabitant = rust_noninteger_facts_node(facts: rust_facts_bool)
  AlgebraInhabitanceDecl {
    algebra: boolean_algebra_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: rust_bool_algebra_witness_node()
  }
}

fn rust_integer_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: rust_integer_algebra_inhabitance(facts: facts))
    }
  )
}

fn rust_float_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: rust_float_algebra_inhabitance(facts: facts))
    }
  )
}

fn rust_bool_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  [
    rust_bool_algebra_inhabitance()
  ]
}

fn rust_model_core_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  list_append(
    left: list_append(
      left: rust_integer_algebra_inhabitance_decls(),
      right: rust_float_algebra_inhabitance_decls()
    ),
    right: rust_bool_algebra_inhabitance_decls()
  )
}

fn rust_model_core_law_node(witness: Node, algebra: Node, key: RustModelCoreLawKey) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^model_core_law_field_subject, target: witness),
      rust_named_edge(name: ^model_core_law_field_algebra, target: algebra),
      rust_named_edge(
        name: ^model_core_law_field_kind,
        target: rust_inhabitant_atom(id: discriminant(v: key))
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_model_core_law_obligation(witness: Node, law: Node) -> AlgebraLawObligation {
  AlgebraLawObligation {
    inhabitance_witness: witness,
    law: law
  }
}

fn rust_integer_law_obligations(facts: RustIntegerPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = rust_integer_algebra_witness_node(facts: facts)
  let inhabitant = rust_integer_facts_node(facts: facts)
  let algebra = ordered_ring_type_node(inhabitant: inhabitant)
  [
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerAddAssociativeWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerAddCommutativeWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerMulAssociativeWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerMulCommutativeWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerDistributiveWhenRepresentable
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawIntegerTotalOrderOverRepresentableValues
      )
    )
  ]
}

fn rust_float_law_obligations(facts: RustFloatPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = rust_float_algebra_witness_node(facts: facts)
  let inhabitant = rust_float_facts_node(facts: facts)
  let algebra = approximate_field_type_node(inhabitant: inhabitant)
  [
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawFloatIeee754Rounding
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawFloatNanInfCarriedByIeee754
      )
    )
  ]
}

fn rust_bool_algebra_laws() -> List<AlgebraLawObligation> {
  let witness = rust_bool_algebra_witness_node()
  let inhabitant = rust_noninteger_facts_node(facts: rust_facts_bool)
  let algebra = boolean_algebra_type_node(inhabitant: inhabitant)
  [
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawBoolBoundedLattice
      )
    ),
    rust_model_core_law_obligation(
      witness: witness,
      law: rust_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: RustLawBoolComplement
      )
    )
  ]
}

fn rust_integer_algebra_laws() -> List<AlgebraLawObligation> {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(left: acc, right: rust_integer_law_obligations(facts: facts))
    }
  )
}

fn rust_float_algebra_laws() -> List<AlgebraLawObligation> {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(left: acc, right: rust_float_law_obligations(facts: facts))
    }
  )
}

fn rust_model_core_law_obligations() -> List<AlgebraLawObligation> {
  list_append(
    left: list_append(
      left: rust_integer_algebra_laws(),
      right: rust_float_algebra_laws()
    ),
    right: rust_bool_algebra_laws()
  )
}

fn rust_pure_operation(operation: Symbol) -> PrimitiveOperationRef {
  PrimitiveOperationRef {
    operation: rust_symbol_node(id: operation),
    effect_signature: EffectSignature {
      signature: rust_symbol_node(id: ^rust_effect_signature_pure_value)
    }
  }
}

fn rust_effect_semantics() -> EffectSemanticsDecl {
  EffectSemanticsDecl {
    operations: [
      rust_pure_operation(operation: ^rust_op_integer_add),
      rust_pure_operation(operation: ^rust_op_integer_sub),
      rust_pure_operation(operation: ^rust_op_integer_mul),
      rust_pure_operation(operation: ^rust_op_integer_neg),
      rust_pure_operation(operation: ^rust_op_integer_div),
      rust_pure_operation(operation: ^rust_op_integer_rem),
      rust_pure_operation(operation: ^rust_op_integer_compare),
      rust_pure_operation(operation: ^rust_op_float_add),
      rust_pure_operation(operation: ^rust_op_float_sub),
      rust_pure_operation(operation: ^rust_op_float_mul),
      rust_pure_operation(operation: ^rust_op_float_div),
      rust_pure_operation(operation: ^rust_op_float_compare),
      rust_pure_operation(operation: ^rust_op_bool_and),
      rust_pure_operation(operation: ^rust_op_bool_or),
      rust_pure_operation(operation: ^rust_op_bool_not)
    ]
  }
}

fn rust_fail_closed_partial_operation(
  operation: Symbol,
  precondition: Symbol,
  reason: Symbol
) -> PartialOperationDecl {
  PartialOperationDecl {
    operation: rust_symbol_node(id: operation),
    precondition: rust_symbol_node(id: precondition),
    discharge: FailClosedAtBoundary { reason: reason }
  }
}

fn rust_partiality_semantics() -> PartialitySemanticsDecl {
  PartialitySemanticsDecl {
    operations: [
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_add,
        precondition: ^rust_precondition_integer_result_representable,
        reason: ^rust_partial_checked_integer_overflow
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_sub,
        precondition: ^rust_precondition_integer_result_representable,
        reason: ^rust_partial_checked_integer_overflow
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_mul,
        precondition: ^rust_precondition_integer_result_representable,
        reason: ^rust_partial_checked_integer_overflow
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_neg,
        precondition: ^rust_precondition_integer_result_representable,
        reason: ^rust_partial_checked_integer_overflow
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_div,
        precondition: ^rust_precondition_integer_divisor_nonzero,
        reason: ^rust_partial_integer_divide_by_zero
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_rem,
        precondition: ^rust_precondition_integer_divisor_nonzero,
        reason: ^rust_partial_integer_remainder_by_zero
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_div,
        precondition: ^rust_precondition_signed_division_not_min_over_negative_one,
        reason: ^rust_partial_signed_min_divide_by_negative_one
      ),
      rust_fail_closed_partial_operation(
        operation: ^rust_op_integer_rem,
        precondition: ^rust_precondition_signed_division_not_min_over_negative_one,
        reason: ^rust_partial_signed_min_divide_by_negative_one
      )
    ]
  }
}

fn rust_per_language_fact_bundle_key(
  subject_carrier: Node,
  fact_axis: ModelCorePrimitiveFactAxis
) -> PerLanguageFactBundleKey {
  PerLanguageFactBundleKey {
    subject_carrier: subject_carrier,
    target: rust_target_model(),
    fact_axis: fact_axis
  }
}

fn rust_per_language_fact_bundle_entry(
  subject_carrier: Node,
  fact_axis: ModelCorePrimitiveFactAxis,
  fact_value: Node
) -> PerLanguageFactBundleEntry {
  PerLanguageFactBundleEntry {
    key: rust_per_language_fact_bundle_key(
      subject_carrier: subject_carrier,
      fact_axis: fact_axis
    ),
    fact_value: fact_value
  }
}

fn rust_integer_per_language_fact_bundle_entries(
  facts: RustIntegerPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  let subject_carrier = rust_integer_facts_node(facts: facts)
  [
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisSurfaceSpelling {},
      fact_value: rust_inhabitant_atom(id: facts.surface_spelling)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisWidth {},
      fact_value: rust_int_width_node(width: facts.overflow_disposition.ir_carrier.width)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisSignedness {},
      fact_value: rust_int_kind_node(kind: facts.overflow_disposition.ir_carrier.kind)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisEncoding {},
      fact_value: rust_inhabitant_atom(id: ^rust_repr_integer_twos_complement)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisRange {},
      fact_value: rust_integer_range_node(carrier: facts.overflow_disposition.ir_carrier)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisOverflowDisposition {},
      fact_value: rust_overflow_disposition_node(disposition: facts.overflow_disposition)
    )
  ]
}

fn rust_float_per_language_fact_bundle_entries(
  facts: RustFloatPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  let subject_carrier = rust_float_facts_node(facts: facts)
  [
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisSurfaceSpelling {},
      fact_value: rust_inhabitant_atom(id: facts.surface_spelling)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisWidth {},
      fact_value: rust_float_width_node(width: facts.width)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisEncoding {},
      fact_value: rust_inhabitant_atom(id: facts.ieee754_binary)
    )
  ]
}

fn rust_noninteger_per_language_fact_bundle_entries(
  facts: RustNonIntegerPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  let subject_carrier = rust_noninteger_facts_node(facts: facts)
  [
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisSurfaceSpelling {},
      fact_value: rust_inhabitant_atom(id: facts.surface_spelling)
    ),
    rust_per_language_fact_bundle_entry(
      subject_carrier: subject_carrier,
      fact_axis: ModelCoreFactAxisEncoding {},
      fact_value: rust_inhabitant_atom(id: facts.representation)
    )
  ]
}

fn rust_per_language_fact_bundle_entries_from_integer_catalog() -> List<PerLanguageFactBundleEntry> {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(
        left: acc,
        right: rust_integer_per_language_fact_bundle_entries(facts: facts)
      )
    }
  )
}

fn rust_per_language_fact_bundle_entries_from_float_catalog() -> List<PerLanguageFactBundleEntry> {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(
        left: acc,
        right: rust_float_per_language_fact_bundle_entries(facts: facts)
      )
    }
  )
}

fn rust_per_language_fact_bundle_entries_from_noninteger_catalog() -> List<PerLanguageFactBundleEntry> {
  fold_list(
    xs: rust_noninteger_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(
        left: acc,
        right: rust_noninteger_per_language_fact_bundle_entries(facts: facts)
      )
    }
  )
}

fn rust_per_language_fact_bundle_entries() -> List<PerLanguageFactBundleEntry> {
  list_append(
    left: list_append(
      left: rust_per_language_fact_bundle_entries_from_integer_catalog(),
      right: rust_per_language_fact_bundle_entries_from_float_catalog()
    ),
    right: rust_per_language_fact_bundle_entries_from_noninteger_catalog()
  )
}

fn rust_insert_per_language_fact_bundle_entry_outcome(
  acc: Outcome<PerLanguageFactBundleRegistry>,
  entry: PerLanguageFactBundleEntry
) -> Outcome<PerLanguageFactBundleRegistry> {
  match acc {
    Accepted { value: registry, diagnostics: _ } =>
      insert_per_language_fact_bundle_entry(
        registry: registry,
        key: entry.key,
        fact_value: entry.fact_value
      )
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_per_language_fact_bundle_registry() -> Outcome<PerLanguageFactBundleRegistry> {
  fold_list(
    xs: rust_per_language_fact_bundle_entries(),
    empty: outcome_accepted(value: empty_per_language_fact_bundle_registry()),
    cons: fn(acc, entry) {
      rust_insert_per_language_fact_bundle_entry_outcome(acc: acc, entry: entry)
    }
  )
}

fn rust_snoc_primitive_bundle(
  acc: Outcome<List<PrimitiveFactBundle>>,
  registry: PerLanguageFactBundleRegistry,
  subject_carrier: Node
) -> Outcome<List<PrimitiveFactBundle>> {
  match acc {
    Accepted { value: bundles, diagnostics: _ } => match primitive_fact_bundle_for_subject(
      registry: registry,
      subject_carrier: subject_carrier,
      target: rust_target_model()
    ) {
      Accepted { value: bundle, diagnostics: d } =>
        Accepted {
          value: list_snoc_item(xs: bundles, item: bundle),
          diagnostics: d
        }
      Rejected { diagnostics: d } => Rejected { diagnostics: d }
    }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_primitive_bundles_from_integer_catalog_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  fold_list(
    xs: rust_integer_facts_catalog,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc, facts) {
      rust_snoc_primitive_bundle(
        acc: acc,
        registry: registry,
        subject_carrier: rust_integer_facts_node(facts: facts)
      )
    }
  )
}

fn rust_primitive_bundles_from_float_catalog_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  fold_list(
    xs: rust_float_facts_catalog,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc, facts) {
      rust_snoc_primitive_bundle(
        acc: acc,
        registry: registry,
        subject_carrier: rust_float_facts_node(facts: facts)
      )
    }
  )
}

fn rust_primitive_bundles_from_noninteger_catalog_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  fold_list(
    xs: rust_noninteger_facts_catalog,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc, facts) {
      rust_snoc_primitive_bundle(
        acc: acc,
        registry: registry,
        subject_carrier: rust_noninteger_facts_node(facts: facts)
      )
    }
  )
}

fn rust_append_primitive_bundle_outcomes(
  left: Outcome<List<PrimitiveFactBundle>>,
  right: Outcome<List<PrimitiveFactBundle>>
) -> Outcome<List<PrimitiveFactBundle>> {
  match left {
    Accepted { value: l, diagnostics: _ } => match right {
      Accepted { value: r, diagnostics: d } =>
        Accepted { value: list_append(left: l, right: r), diagnostics: d }
      Rejected { diagnostics: d } => Rejected { diagnostics: d }
    }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_primitive_fact_bundles_from_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  rust_append_primitive_bundle_outcomes(
    left: rust_append_primitive_bundle_outcomes(
      left: rust_primitive_bundles_from_integer_catalog_registry(registry: registry),
      right: rust_primitive_bundles_from_float_catalog_registry(registry: registry)
    ),
    right: rust_primitive_bundles_from_noninteger_catalog_registry(registry: registry)
  )
}

fn rust_model_core() -> Outcome<ModelCore> {
  match rust_per_language_fact_bundle_registry() {
    Accepted { value: registry, diagnostics: _ } =>
      match rust_primitive_fact_bundles_from_registry(registry: registry) {
        Accepted { value: primitives, diagnostics: d } =>
          Accepted {
            value: ModelCore {
              primitives: primitives,
              inhabitance: rust_model_core_inhabitance_decls(),
              laws: rust_model_core_law_obligations(),
              effects: rust_effect_semantics(),
              partiality: rust_partiality_semantics()
            },
            diagnostics: d
          }
        Rejected { diagnostics: d } => Rejected { diagnostics: d }
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_fn_add_language_model() -> Outcome<LanguageModel> {
  match rust_model_core() {
    Accepted { value: core, diagnostics: d } =>
      Accepted {
        value: LanguageModel {
          lex: rust_fn_add_lex(),
          grammar: rust_fn_add_grammar(),
          language_identity: ^rust_language_model_surface_id,
          canonical_symbols: rust_language_model_canonical_symbols(),
          core: core
        },
        diagnostics: d
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_whitespace_trivia_rule() -> LexRule {
  TriviaRule {
    pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } }
  }
}

fn rust_int_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^rust_token_int_literal,
    pattern: OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
  }
}

fn rust_extended_lex_rules() -> List<LexRule> {
  [
    rust_whitespace_trivia_rule(),
    rust_int_literal_lex_rule(),
    rust_lex_rule(token_class: ^rust_token_kw_let, text: "let"),
    rust_lex_rule(token_class: ^rust_token_kw_if, text: "if"),
    rust_lex_rule(token_class: ^rust_token_kw_else, text: "else"),
    rust_lex_rule(token_class: ^rust_token_kw_return, text: "return"),
    rust_lex_rule(token_class: ^rust_token_equal, text: "="),
    rust_lex_rule(token_class: ^rust_token_gt, text: ">"),
    rust_lex_rule(token_class: ^rust_token_semicolon, text: ";")
  ]
}

fn rust_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: list_append(
      left: rust_fn_add_lex_rules().rules,
      right: rust_extended_lex_rules()
    )
  }
}

fn rust_lex() -> LexRules {
  ModeledLexRules { root: rust_lex_rules() }
}

fn rust_formal_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(lhs: ^rust_production_type, rhs: [grammar_formal_terminal(identity: ^rust_token_ty_i32)]),
    grammar_formal_production(
      lhs: ^rust_production_typed_param,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_ident),
        grammar_formal_terminal(identity: ^rust_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_type)
      ]
    ),
    grammar_formal_production(lhs: ^rust_production_param_list, rhs: []),
    grammar_formal_production(
      lhs: ^rust_production_param_list,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_typed_param)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_param_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_typed_param),
        grammar_formal_terminal(identity: ^rust_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_typed_param),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_param_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^rust_production_param_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^rust_production_param_list_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_typed_param),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_param_list_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_fn_item,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_fn),
        grammar_formal_terminal(identity: ^rust_token_ident),
        grammar_formal_terminal(identity: ^rust_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_param_list),
        grammar_formal_terminal(identity: ^rust_token_rparen),
        grammar_formal_terminal(identity: ^rust_token_arrow),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_type),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block)
      ]
    ),
    grammar_formal_production(lhs: ^rust_production_primary_expr, rhs: [grammar_formal_terminal(identity: ^rust_token_ident)]),
    grammar_formal_production(
      lhs: ^rust_production_primary_expr,
      rhs: [grammar_formal_terminal(identity: ^rust_token_int_literal)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_primary_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_terminal(identity: ^rust_token_rparen)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_additive_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_primary_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_additive_expr,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_additive_expr),
        grammar_formal_terminal(identity: ^rust_token_plus),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_primary_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_comparison_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_additive_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_comparison_expr,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_additive_expr),
        grammar_formal_terminal(identity: ^rust_token_gt),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_additive_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_return_expr,
      rhs: [grammar_formal_terminal(identity: ^rust_token_kw_return)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_return_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_return),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_without_block,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_return_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_without_block,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_comparison_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lbrace),
        grammar_formal_terminal(identity: ^rust_token_rbrace)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lbrace),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_terminal(identity: ^rust_token_rbrace)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lbrace),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmts),
        grammar_formal_terminal(identity: ^rust_token_rbrace)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_block,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_lbrace),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmts),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_terminal(identity: ^rust_token_rbrace)
      ]
    ),
    grammar_formal_production(lhs: ^rust_production_stmts, rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmt)]),
    grammar_formal_production(
      lhs: ^rust_production_stmts,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmts),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_stmt)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_let_stmt,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_let),
        grammar_formal_terminal(identity: ^rust_token_ident),
        grammar_formal_terminal(identity: ^rust_token_equal),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_terminal(identity: ^rust_token_semicolon)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_stmt,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_without_block),
        grammar_formal_terminal(identity: ^rust_token_semicolon)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_with_block)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_stmt,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_with_block),
        grammar_formal_terminal(identity: ^rust_token_semicolon)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_let_stmt)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_stmt,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_stmt)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_with_block,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_if_expr)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr_with_block,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_block)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_if_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_if),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_if_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_if),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block),
        grammar_formal_terminal(identity: ^rust_token_kw_else),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_if_expr,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_if),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_block),
        grammar_formal_terminal(identity: ^rust_token_kw_else),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_if_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_with_block)]
    ),
    grammar_formal_production(
      lhs: ^rust_production_expr,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^rust_production_expr_without_block)]
    ),
    rust_formal_production_fn_add()
  ]
}

fn rust_formal_production_matches_lhs(production: FormalProduction, lhs: Symbol) -> Bool {
  production.lhs.identity == lhs
}

fn rust_formal_production_list_has_lhs(productions: List<FormalProduction>, lhs: Symbol) -> Bool {
  fold_list(
    xs: productions,
    empty: false,
    cons: fn(found, production) {
      found || rust_formal_production_matches_lhs(production: production, lhs: lhs)
    }
  )
}

fn rust_grammar_nonterminal(production: Symbol) -> GrammarExpr {
  Nonterminal { production: production }
}

fn rust_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}

fn rust_grammar_choice(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Choice { left: left, right: right }
}

fn rust_grammar_optional(element: GrammarExpr) -> GrammarExpr {
  Optional { element: element }
}

fn rust_grammar_repeat(element: GrammarExpr) -> GrammarExpr {
  Repeat { element: element }
}

fn rust_grammar_production(name: Symbol, expression: GrammarExpr, emitted: Symbol) -> GrammarProduction {
  GrammarProduction {
    name: name,
    expression: expression,
    emitted: rust_grammar_atom(id: emitted)
  }
}

fn rust_grammar_type_expr() -> GrammarExpr {
  rust_grammar_terminal(token_class: ^rust_token_ty_i32)
}

fn rust_grammar_typed_param_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_ident),
    right: rust_grammar_sequence(
      left: rust_grammar_terminal(token_class: ^rust_token_colon),
      right: rust_grammar_nonterminal(production: ^rust_production_type)
    )
  )
}

fn rust_grammar_param_list_expr() -> GrammarExpr {
  rust_grammar_optional(
    element: rust_grammar_sequence(
      left: rust_grammar_nonterminal(production: ^rust_production_typed_param),
      right: rust_grammar_repeat(
        element: rust_grammar_sequence(
          left: rust_grammar_terminal(token_class: ^rust_token_comma),
          right: rust_grammar_nonterminal(production: ^rust_production_typed_param)
        )
      )
    )
  )
}

fn rust_grammar_primary_expr() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_terminal(token_class: ^rust_token_ident),
    right: rust_grammar_choice(
      left: rust_grammar_terminal(token_class: ^rust_token_int_literal),
      right: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_lparen),
        right: rust_grammar_sequence(
          left: rust_grammar_nonterminal(production: ^rust_production_expr),
          right: rust_grammar_terminal(token_class: ^rust_token_rparen)
        )
      )
    )
  )
}

fn rust_grammar_additive_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_nonterminal(production: ^rust_production_primary_expr),
    right: rust_grammar_repeat(
      element: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_plus),
        right: rust_grammar_nonterminal(production: ^rust_production_primary_expr)
      )
    )
  )
}

fn rust_grammar_comparison_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_nonterminal(production: ^rust_production_additive_expr),
    right: rust_grammar_optional(
      element: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_gt),
        right: rust_grammar_nonterminal(production: ^rust_production_additive_expr)
      )
    )
  )
}

fn rust_grammar_expr_without_block() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_nonterminal(production: ^rust_production_return_expr),
    right: rust_grammar_nonterminal(production: ^rust_production_comparison_expr)
  )
}

fn rust_grammar_expr_with_block() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_nonterminal(production: ^rust_production_if_expr),
    right: rust_grammar_nonterminal(production: ^rust_production_block)
  )
}

fn rust_grammar_expr_expr() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_nonterminal(production: ^rust_production_expr_with_block),
    right: rust_grammar_nonterminal(production: ^rust_production_expr_without_block)
  )
}

fn rust_grammar_expr_stmt_expr() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_sequence(
      left: rust_grammar_nonterminal(production: ^rust_production_expr_without_block),
      right: rust_grammar_terminal(token_class: ^rust_token_semicolon)
    ),
    right: rust_grammar_sequence(
      left: rust_grammar_nonterminal(production: ^rust_production_expr_with_block),
      right: rust_grammar_optional(
        element: rust_grammar_terminal(token_class: ^rust_token_semicolon)
      )
    )
  )
}

fn rust_grammar_return_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_kw_return),
    right: rust_grammar_optional(
      element: rust_grammar_nonterminal(production: ^rust_production_expr)
    )
  )
}

fn rust_grammar_let_stmt_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_kw_let),
    right: rust_grammar_sequence(
      left: rust_grammar_terminal(token_class: ^rust_token_ident),
      right: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_equal),
        right: rust_grammar_sequence(
          left: rust_grammar_nonterminal(production: ^rust_production_expr),
          right: rust_grammar_terminal(token_class: ^rust_token_semicolon)
        )
      )
    )
  )
}

fn rust_grammar_if_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_kw_if),
    right: rust_grammar_sequence(
      left: rust_grammar_nonterminal(production: ^rust_production_expr),
      right: rust_grammar_sequence(
        left: rust_grammar_nonterminal(production: ^rust_production_block),
        right: rust_grammar_optional(
          element: rust_grammar_sequence(
            left: rust_grammar_terminal(token_class: ^rust_token_kw_else),
            right: rust_grammar_choice(
              left: rust_grammar_nonterminal(production: ^rust_production_block),
              right: rust_grammar_nonterminal(production: ^rust_production_if_expr)
            )
          )
        )
      )
    )
  )
}

fn rust_grammar_stmt_expr() -> GrammarExpr {
  rust_grammar_choice(
    left: rust_grammar_nonterminal(production: ^rust_production_let_stmt),
    right: rust_grammar_nonterminal(production: ^rust_production_expr_stmt)
  )
}

fn rust_grammar_block_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_lbrace),
    right: rust_grammar_sequence(
      left: rust_grammar_repeat(element: rust_grammar_nonterminal(production: ^rust_production_stmt)),
      right: rust_grammar_sequence(
        left: rust_grammar_optional(element: rust_grammar_nonterminal(production: ^rust_production_expr)),
        right: rust_grammar_terminal(token_class: ^rust_token_rbrace)
      )
    )
  )
}

fn rust_grammar_fn_item_expr() -> GrammarExpr {
  rust_grammar_sequence(
    left: rust_grammar_terminal(token_class: ^rust_token_kw_fn),
    right: rust_grammar_sequence(
      left: rust_grammar_terminal(token_class: ^rust_token_ident),
      right: rust_grammar_sequence(
        left: rust_grammar_terminal(token_class: ^rust_token_lparen),
        right: rust_grammar_sequence(
          left: rust_grammar_nonterminal(production: ^rust_production_param_list),
          right: rust_grammar_sequence(
            left: rust_grammar_terminal(token_class: ^rust_token_rparen),
            right: rust_grammar_sequence(
              left: rust_grammar_terminal(token_class: ^rust_token_arrow),
              right: rust_grammar_sequence(
                left: rust_grammar_nonterminal(production: ^rust_production_type),
                right: rust_grammar_nonterminal(production: ^rust_production_block)
              )
            )
          )
        )
      )
    )
  )
}

fn rust_grammar_root() -> GrammarRoot {
  let fn_item = rust_grammar_production(
    name: ^rust_production_fn_item,
    expression: rust_grammar_fn_item_expr(),
    emitted: ^rust_surface_fn_item
  )
  let typed_param = rust_grammar_production(
    name: ^rust_production_typed_param,
    expression: rust_grammar_typed_param_expr(),
    emitted: ^rust_surface_typed_param
  )
  let param_list = rust_grammar_production(
    name: ^rust_production_param_list,
    expression: rust_grammar_param_list_expr(),
    emitted: ^rust_surface_param_list
  )
  let type_prod = rust_grammar_production(
    name: ^rust_production_type,
    expression: rust_grammar_type_expr(),
    emitted: ^rust_surface_type
  )
  let block = rust_grammar_production(
    name: ^rust_production_block,
    expression: rust_grammar_block_expr(),
    emitted: ^rust_surface_block
  )
  let stmt = rust_grammar_production(
    name: ^rust_production_stmt,
    expression: rust_grammar_stmt_expr(),
    emitted: ^rust_surface_stmt
  )
  let expr_stmt = rust_grammar_production(
    name: ^rust_production_expr_stmt,
    expression: rust_grammar_expr_stmt_expr(),
    emitted: ^rust_surface_expr_stmt
  )
  let let_stmt = rust_grammar_production(
    name: ^rust_production_let_stmt,
    expression: rust_grammar_let_stmt_expr(),
    emitted: ^rust_surface_let_stmt
  )
  let if_expr = rust_grammar_production(
    name: ^rust_production_if_expr,
    expression: rust_grammar_if_expr(),
    emitted: ^rust_surface_if_expr
  )
  let return_expr = rust_grammar_production(
    name: ^rust_production_return_expr,
    expression: rust_grammar_return_expr(),
    emitted: ^rust_surface_return_expr
  )
  let expr_without_block = rust_grammar_production(
    name: ^rust_production_expr_without_block,
    expression: rust_grammar_expr_without_block(),
    emitted: ^rust_surface_expr_without_block
  )
  let expr_with_block = rust_grammar_production(
    name: ^rust_production_expr_with_block,
    expression: rust_grammar_expr_with_block(),
    emitted: ^rust_surface_expr_with_block
  )
  let expr = rust_grammar_production(
    name: ^rust_production_expr,
    expression: rust_grammar_expr_expr(),
    emitted: ^rust_surface_expr
  )
  let comparison_expr = rust_grammar_production(
    name: ^rust_production_comparison_expr,
    expression: rust_grammar_comparison_expr(),
    emitted: ^rust_surface_comparison_expr
  )
  let additive_expr = rust_grammar_production(
    name: ^rust_production_additive_expr,
    expression: rust_grammar_additive_expr(),
    emitted: ^rust_surface_additive_expr
  )
  let primary_expr = rust_grammar_production(
    name: ^rust_production_primary_expr,
    expression: rust_grammar_primary_expr(),
    emitted: ^rust_surface_primary_expr
  )
  let fn_add = rust_grammar_production_fn_add()
  GrammarRoot {
    start: ^rust_production_fn_item,
    productions: [
      fn_item,
      typed_param,
      param_list,
      type_prod,
      block,
      stmt,
      expr_stmt,
      let_stmt,
      if_expr,
      return_expr,
      expr_without_block,
      expr_with_block,
      expr,
      comparison_expr,
      additive_expr,
      primary_expr,
      fn_add
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn rust_grammar() -> ParseGrammar {
  ModeledGrammar { root: rust_grammar_root() }
}

fn rust_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      rust_catalog_surface_symbol(sym: sym) ||
        lex_rule_set_token_class_member(rules: rust_lex_rules(), token_class: sym) ||
        grammar_carries_symbol(grammar: rust_grammar(), sym: sym) ||
        sym == ^rust_surface_fn_item ||
        sym == ^rust_production_fn_add ||
        sym == ^rust_source_literal
    }
  }
}

fn rust_language_model() -> Outcome<LanguageModel> {
  match rust_model_core() {
    Accepted { value: core, diagnostics: d } =>
      Accepted {
        value: LanguageModel {
          lex: rust_lex(),
          grammar: rust_grammar(),
          language_identity: ^rust_language_model_surface_id,
          canonical_symbols: rust_canonical_symbols(),
          core: core
        },
        diagnostics: d
      }
    Rejected { diagnostics: d } => Rejected { diagnostics: d }
  }
}

fn rust_type_expression_projection() -> TargetTypeExpressionProjection {
  TargetTypeExpressionProjection {
    atom_form: TargetAtomTypeShape {
      surface: ^rust_surface_type_atom,
      ident_token: ^rust_token_ident
    },
    conj_form: TargetGenericApply {
      surface: ^rust_surface_type_record,
      open: ^rust_token_lbrace,
      separator: ^rust_token_comma,
      field_label_separator: optional_present(value: ^rust_token_colon),
      close: ^rust_token_rbrace
    },
    disj_form: TargetSumTypeShape {
      surface: ^rust_surface_type_sum,
      variant_separator: ^rust_token_pipe
    },
    arrow_form: TargetFunctionTypeShape {
      surface: ^rust_surface_type_arrow,
      open: ^rust_token_lparen,
      close: ^rust_token_rparen,
      arrow: ^rust_token_arrow,
      param_ident_token: ^rust_token_ident,
      param_type_separator: ^rust_token_colon,
      param_list_separator: ^rust_token_comma
    },
    cardinality_form: TargetGenericApply {
      surface: ^rust_surface_type_cardinality,
      open: ^rust_token_lt,
      separator: ^rust_token_comma,
      field_label_separator: optional_absent(),
      close: ^rust_token_gt
    },
    instantiation_form: TargetGenericApply {
      surface: ^rust_surface_type_generic_apply,
      open: ^rust_token_lt,
      separator: ^rust_token_comma,
      field_label_separator: optional_absent(),
      close: ^rust_token_gt
    }
  }
}
data rust_sg2_type_alias_text: String = "type Sg2Probe = Rc<FooBar<X, Y>>;"

fn rust_reference_layer_tokens() -> TargetReferenceLayerTokens {
  TargetReferenceLayerTokens {
    rc_type_head: ^rust_binding_sg2_rc,
    box_type_head: ^rust_binding_sg_rc_box,
    rc_new_ctor: ^rust_sg_rc_ctor_rc_new,
    box_new_ctor: ^rust_sg_rc_ctor_box_new
  }
}

fn rust_sg_rc_use_site_ownership_catalog() -> List<TargetUseSiteOwnershipRealization> {
  [
    TargetUseSiteOwnershipRealization {
      source_carrier: target_carrier_diagnostics_node(),
      source_projection: UseSiteOwnershipExactCarrier,
      use_site: OwnershipAtFunctionReturn,
      reference_layer: ReferenceLayerRc,
      display_name: ^rust_sg_rc_diagnostics_return
    },
    TargetUseSiteOwnershipRealization {
      source_carrier: target_carrier_diagnostics_node(),
      source_projection: UseSiteOwnershipExactCarrier,
      use_site: OwnershipAtFunctionParameter,
      reference_layer: ReferenceLayerOwned,
      display_name: ^rust_sg_rc_diagnostics_param
    },
    TargetUseSiteOwnershipRealization {
      source_carrier: target_carrier_node_node(),
      source_projection: UseSiteOwnershipExactCarrier,
      use_site: OwnershipAtFunctionReturn,
      reference_layer: ReferenceLayerRc,
      display_name: ^rust_sg_rc_node_return
    },
    TargetUseSiteOwnershipRealization {
      source_carrier: target_carrier_node_node(),
      source_projection: UseSiteOwnershipExactCarrier,
