fn rust_inhabitant_node(id: Symbol, facts: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^rust_inhabitant_field_atom, target: rust_inhabitant_atom(id: id)),
      rust_named_edge(name: ^rust_inhabitant_field_facts, target: facts)
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_integer_inhabitant_node(id: Symbol, facts: RustIntegerPrimitiveFacts) -> Node {
