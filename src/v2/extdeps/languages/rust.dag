  rust_facts_f64
]

data rust_noninteger_facts_catalog: List<RustNonIntegerPrimitiveFacts> = [
  rust_facts_bool,
  rust_facts_char,
  rust_facts_str,
  rust_facts_unit,
  rust_facts_never
]

data rust_integer_algebra_inhabitance_rust_facts_i32: AlgebraInhabitanceDecl = rust_integer_algebra_inhabitance(facts: rust_facts_i32)

data rust_atom_realization_symbol_node: Node = rust_inhabitant_atom(id: ^rust_atom_realization_symbol)

fn rust_leaf_model_fact_id_node_rust_facts_i32() -> Node {
  rust_integer_facts_node(facts: rust_facts_i32)
}

fn rust_leaf_model_fact_id_node_algebra_inhabitance_rust_facts_i32() -> Node {
  rust_integer_algebra_inhabitance_rust_facts_i32.algebra
}

fn rust_leaf_model_fact_id_node_atom_realization_symbol() -> Node {
  rust_atom_realization_symbol_node
}

data rust_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

type RustNever = Never

fn rust_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_int_kind_node(kind: RustIntKind) -> Node {
  match kind {
    Signed => rust_inhabitant_atom(id: ^rust_tag_signed)
    Unsigned => rust_inhabitant_atom(id: ^rust_tag_unsigned)
  }
}

fn rust_int_width_node(width: RustIntWidth) -> Node {
  match width {
    Bits8 => rust_inhabitant_atom(id: ^rust_tag_bits8)
    Bits16 => rust_inhabitant_atom(id: ^rust_tag_bits16)
    Bits32 => rust_inhabitant_atom(id: ^rust_tag_bits32)
    Bits64 => rust_inhabitant_atom(id: ^rust_tag_bits64)
    Bits128 => rust_inhabitant_atom(id: ^rust_tag_bits128)
    Pointer => rust_inhabitant_atom(id: ^rust_tag_pointer)
  }
}

fn rust_float_width_node(width: RustFloatWidth) -> Node {
  match width {
    FloatBits32 => rust_inhabitant_atom(id: ^rust_tag_bits32)
    FloatBits64 => rust_inhabitant_atom(id: ^rust_tag_bits64)
  }
}

fn rust_overflow_node(overflow: OverflowAction) -> Node {
  match overflow {
    PanicOnOverflow => rust_inhabitant_atom(id: ^rust_tag_panic_on_overflow)
    TwoComplementWrap => rust_inhabitant_atom(id: ^rust_tag_two_complement_wrap)
  }
}

fn rust_integer_carrier_as_scalar(carrier: RustIntegerCarrier) -> RustScalar {
  IntScalar { kind: carrier.kind, width: carrier.width }
}

fn rust_integer_carrier_interval_spec(carrier: RustIntegerCarrier) -> IntegerIntervalSpec {
  match carrier.kind {
    Signed => match carrier.width {
      Bits8 => int8_interval_spec()
      Bits16 => int16_interval_spec()
      Bits32 => int32_interval_spec()
      Bits64 => int64_interval_spec()
      Bits128 => int128_interval_spec()
      Pointer => int_platform_interval_spec()
    }
    Unsigned => match carrier.width {
      Bits8 => uint8_interval_spec()
      Bits16 => uint16_interval_spec()
      Bits32 => uint32_interval_spec()
      Bits64 => uint64_interval_spec()
      Bits128 => uint128_interval_spec()
      Pointer => uint_platform_interval_spec()
    }
  }
}

fn rust_overflow_disposition_node(disposition: OverflowDisposition<RustIntegerCarrier>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^rust_overflow_field_ir_carrier,
        target: rust_scalar_node(
          scalar: rust_integer_carrier_as_scalar(carrier: disposition.ir_carrier)
        )
      ),
      rust_named_edge(
        name: ^rust_overflow_field_checked_arithmetic_debug_default,
        target: rust_overflow_node(overflow: disposition.checked_arithmetic_debug_default)
      ),
      rust_named_edge(
        name: ^rust_overflow_field_checked_arithmetic_release_default,
        target: rust_overflow_node(overflow: disposition.checked_arithmetic_release_default)
      ),
      rust_named_edge(
        name: ^rust_overflow_field_checked_arithmetic_checks_enabled,
        target: rust_overflow_node(overflow: disposition.checked_arithmetic_overflow_checks_enabled)
      ),
      rust_named_edge(
        name: ^rust_overflow_field_checked_arithmetic_checks_disabled,
        target: rust_overflow_node(overflow: disposition.checked_arithmetic_overflow_checks_disabled)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_scalar_node(scalar: RustScalar) -> Node {
  match scalar {
    IntScalar { kind, width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        rust_named_edge(
          name: ^rust_scalar_field_classifier,
          target: rust_inhabitant_atom(id: ^rust_tag_scalar_int)
        ),
        rust_named_edge(name: ^rust_scalar_field_kind, target: rust_int_kind_node(kind: kind)),
        rust_named_edge(name: ^rust_scalar_field_width, target: rust_int_width_node(width: width))
      ],
      occurrence_id: SyntheticOccurrence
}
    FloatScalar { width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        rust_named_edge(
          name: ^rust_scalar_field_classifier,
          target: rust_inhabitant_atom(id: ^rust_tag_scalar_float)
        ),
        rust_named_edge(name: ^rust_scalar_field_width, target: rust_float_width_node(width: width))
      ],
      occurrence_id: SyntheticOccurrence
}
    BoolScalar => rust_inhabitant_atom(id: ^rust_tag_scalar_bool)
    CharScalar => rust_inhabitant_atom(id: ^rust_tag_scalar_char)
    StrScalar => rust_inhabitant_atom(id: ^rust_tag_scalar_str)
    UnitScalar => rust_inhabitant_atom(id: ^rust_tag_scalar_unit)
    NeverScalar => rust_inhabitant_atom(id: ^rust_tag_scalar_never)
  }
}

fn rust_noninteger_scalar_as_rust_scalar(scalar: RustNonIntegerScalar) -> RustScalar {
  match scalar {
    NonIntegerBoolScalar => BoolScalar
    NonIntegerCharScalar => CharScalar
    NonIntegerStrScalar => StrScalar
    NonIntegerUnitScalar => UnitScalar
    NonIntegerNeverScalar => NeverScalar
  }
}

fn rust_integer_range_node(carrier: RustIntegerCarrier) -> Node {
  integer_interval_spec_node(spec: rust_integer_carrier_interval_spec(carrier: carrier))
}

fn rust_integer_facts_node(facts: RustIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^rust_facts_field_surface_spelling,
        target: rust_inhabitant_atom(id: facts.surface_spelling)
      ),
      rust_named_edge(
        name: ^rust_facts_field_signedness,
        target: rust_int_kind_node(kind: facts.overflow_disposition.ir_carrier.kind)
      ),
      rust_named_edge(
        name: ^rust_facts_field_width,
        target: rust_int_width_node(width: facts.overflow_disposition.ir_carrier.width)
      ),
      rust_named_edge(
        name: ^rust_facts_field_range,
        target: rust_integer_range_node(carrier: facts.overflow_disposition.ir_carrier)
      ),
      rust_named_edge(
        name: ^rust_facts_field_overflow_disposition,
        target: rust_overflow_disposition_node(disposition: facts.overflow_disposition)
      ),
      rust_named_edge(
        name: ^rust_facts_field_std_projection,
        target: rust_inhabitant_atom(id: facts.std_projection)
      ),
      rust_named_edge(
        name: ^rust_facts_field_scalar_classifier,
        target: rust_scalar_node(
          scalar: rust_integer_carrier_as_scalar(carrier: facts.overflow_disposition.ir_carrier)
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_float_facts_node(facts: RustFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^rust_facts_field_surface_spelling,
        target: rust_inhabitant_atom(id: facts.surface_spelling)
      ),
      rust_named_edge(name: ^rust_facts_field_width, target: rust_float_width_node(width: facts.width)),
      rust_named_edge(
        name: ^rust_facts_field_ieee754_binary,
        target: rust_inhabitant_atom(id: facts.ieee754_binary)
      ),
      rust_named_edge(
        name: ^rust_facts_field_std_projection,
        target: rust_inhabitant_atom(id: facts.std_projection)
      ),
      rust_named_edge(
        name: ^rust_facts_field_scalar_classifier,
        target: rust_scalar_node(scalar: FloatScalar { width: facts.width })
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn rust_noninteger_facts_node(facts: RustNonIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^rust_facts_field_surface_spelling,
        target: rust_inhabitant_atom(id: facts.surface_spelling)
      ),
      rust_named_edge(
        name: ^rust_facts_field_scalar_classifier,
        target: rust_scalar_node(
          scalar: rust_noninteger_scalar_as_rust_scalar(scalar: facts.scalar)
        )
      ),
      rust_named_edge(
        name: ^rust_facts_field_std_projection,
        target: rust_inhabitant_atom(id: facts.std_projection)
      ),
      rust_named_edge(
        name: ^rust_facts_field_representation,
        target: rust_inhabitant_atom(id: facts.representation)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

