module v2.extdeps.languages.dag_add_fixture

import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.node {
  Arrow,
  Atom,
  ComputationNode,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  Transform,
  TypeNode
}

// The five canonical add-tree fixtures are a small authority consumed independently of the full
// DAG grammar and language model. Keeping their construction here lets fixture-only consumers
// resolve exactly that authority instead of importing the unrelated grammar closure.

fn dag_add_fixture_atom(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: OccurrenceSynthetic
  }
}

fn dag_add_fixture_domain() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      Edge {
        label: Named { name: ^dag_binding_param_x },
        target: dag_add_fixture_atom(identity: ^dag_binding_type_int)
      },
      Edge {
        label: Named { name: ^dag_binding_param_y },
        target: dag_add_fixture_atom(identity: ^dag_binding_type_int)
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn dag_add_fixture_body(left_binding: Symbol, right_binding: Symbol) -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: dag_add_fixture_atom(identity: ^dag_token_plus)
      },
      Edge {
        label: Positional,
        target: dag_add_fixture_atom(identity: left_binding)
      },
      Edge {
        label: Positional,
        target: dag_add_fixture_atom(identity: right_binding)
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn dag_add_fixture_arrow(body: Node) -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: dag_add_fixture_domain() },
      Edge {
        label: Positional,
        target: dag_add_fixture_atom(identity: ^dag_binding_type_int)
      },
      Edge {
        label: Positional,
        target: dag_add_fixture_atom(identity: ^dag_binding_type_int)
      },
      Edge { label: Named { name: ^arrow_body_edge }, target: body }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn dag_add_fixture_signature() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: dag_add_fixture_domain() },
      Edge {
        label: Positional,
        target: dag_add_fixture_atom(identity: ^dag_binding_type_int)
      },
      Edge {
        label: Positional,
        target: dag_add_fixture_atom(identity: ^dag_binding_type_int)
      }
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

data dag_add_arrow_signature_fixture: Node = dag_add_fixture_signature()
data dag_add_binary_body_fixture: Node = dag_add_fixture_body(
  left_binding: ^dag_binding_param_x,
  right_binding: ^dag_binding_param_y
)
data dag_add_binary_body_swapped_operands_fixture: Node = dag_add_fixture_body(
  left_binding: ^dag_binding_param_y,
  right_binding: ^dag_binding_param_x
)
data dag_add_arrow_with_body_fixture: Node = dag_add_fixture_arrow(
  body: dag_add_binary_body_fixture
)
data dag_add_arrow_with_body_swapped_operands_fixture: Node = dag_add_fixture_arrow(
  body: dag_add_binary_body_swapped_operands_fixture
)
