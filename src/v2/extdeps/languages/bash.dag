  LexRuleSet {
    rules: [
      bash_lex_rule(token_class: ^bash_token_word_bash, text: "'bash'"),
      bash_lex_rule(
        token_class: ^bash_token_word_source_root_ingest_gate_sh,
        text: " 'scripts/source-root-ingest-gate.sh'"
      )
    ]
  }
}

