  )
}

fn bash_stmt_heredoc_binding_spellings(path: String, delimiter: String, body: String) -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(empty_map(), ^bash_stmt_heredoc_path, path),
        ^bash_stmt_heredoc_delim_open, delimiter
      ),
      ^bash_stmt_heredoc_body, body
    ),
    ^bash_stmt_heredoc_delim_close, delimiter
  )
}

fn bash_stmt_heredoc_target_model(path: String, delimiter: String, body: String) -> TargetModel {
  bash_make_bound_tokens_target_model(
    rules: bash_stmt_heredoc_translation_rules_node(),
    source_literal: ^bash_stmt_heredoc_source_literal,
    production_name: ^bash_production_stmt_heredoc,
