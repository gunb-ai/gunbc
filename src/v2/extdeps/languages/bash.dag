  tokens: bash_stmt_heredoc_tokens()
)

fn bash_stmt_heredoc_source_text(path: String, delimiter: String, body: String) -> String {
  concat("cat > ", concat(path,
    concat(" <<'", concat(delimiter, concat("'\n", concat(body, concat("\n", delimiter)))))))
}

fn bash_stmt_heredoc_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: "cat > ", class: ^bash_token_heredoc_kw),
    span(text: " <<'", class: ^bash_token_heredoc_dlt_open),
    span(text: "'\n", class: ^bash_token_heredoc_nl1),
    span(text: "\n", class: ^bash_token_heredoc_nl2)
  ]))
}

