fn bash_make_fixed_tokens_target_model(
  rules: Node,
  source_literal: Symbol,
  production_name: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  source_text: String,
  lex: LexRules
) -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: bash_target_model_bundle(
      rules: rules,
      serialize_source: bash_serialize_source_node(
        source_text_binding: source_literal,
        production_binding: production_name,
        tokens: tokens
      )
    ),
    lex: lex,
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn bash_make_bound_tokens_target_model(
  rules: Node,
  source_literal: Symbol,
  production_name: Symbol,
