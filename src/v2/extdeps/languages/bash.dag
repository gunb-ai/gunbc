fn bash_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^bash_binding_var_ROOT, "ROOT")
  let m1 = map_insert(m0, ^bash_binding_lit_ROOT, "ROOT")
  let m2 = map_insert(m1, ^bash_binding_lit_a_quote_b, "a'b")
  let m3 = map_insert(m2, ^bash_binding_var_WORKDIR, "WORKDIR")
  let m4 = map_insert(m3, ^bash_binding_var_OUT, "OUT")
  let m5 = map_insert(m4, ^bash_binding_var_GUNBC, "GUNBC")
  let m6 = map_insert(m5, ^bash_binding_var_CARGO_TARGET_DIR, "CARGO_TARGET_DIR")
  let m7 = map_insert(m6, ^bash_binding_lit_target_release_gunbc, "/target/release/gunbc")
  let m8 = map_insert(m7, ^bash_binding_lit_target, "/target")
  let m9 = map_insert(m8, ^bash_binding_exit_code_1, "1")
  map_insert(m9, ^bash_binding_exit_code_0, "0")
}

// POSIX §2.2.2 — inside single quotes every character is literal; embedded `'` → `'\''`.
fn bash_single_quote(spelling: String) -> String {
  concat("'", concat(replace(spelling, "'", "'\\''"), "'"))
}

// Layout + quoting composed (§2: not a Cartesian product enum case in std).
fn bash_single_quote_spaced(spelling: String) -> String {
  concat(" ", bash_single_quote(spelling: spelling))
}

fn bash_var_ref_spelling(spelling: String) -> String {
  concat("\"$", concat(spelling, "\""))
}

fn bash_token_class_emit_transforms() -> Map<Symbol, fn(String) -> String> {
  let m0 = map_insert(empty_map(), ^bash_token_lit, bash_single_quote)
  let m1 = map_insert(m0, ^bash_token_lit_spaced, bash_single_quote_spaced)
  map_insert(m1, ^bash_token_var_ref, bash_var_ref_spelling)
}

fn bash_serialize_source_node(
  source_text_binding: Symbol,
  production_binding: Symbol,
  tokens: List<ConcreteSyntaxToken>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^serialize_source_field_source_text,
        target: bash_word_atom(id: source_text_binding)
      ),
      bash_named_edge(
        name: ^serialize_source_field_source_grammar,
        target: bash_word_atom(id: production_binding)
      ),
      bash_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: tokens,
          token_to_node: bash_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_target_model_bundle(rules: Node, serialize_source: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^target_model_edge_translation_rules,
        target: rules
      ),
      bash_named_edge(
        name: ^target_model_edge_serialize_source,
        target: serialize_source
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_mvp1_serialize_source_node() -> Node {
  bash_serialize_source_node(
    source_text_binding: ^bash_mvp1_source_literal,
    production_binding: ^bash_production_command,
    tokens: bash_mvp1_concrete_tokens()
  )
}

fn bash_bound_words_serialize_source_node() -> Node {
  bash_serialize_source_node(
    source_text_binding: ^bash_bound_words_source_literal,
    production_binding: ^bash_production_bound_words,
    tokens: bash_bound_words_concrete_tokens()
  )
}

fn bash_embedded_quote_serialize_source_node() -> Node {
  bash_serialize_source_node(
    source_text_binding: ^bash_embedded_quote_source_literal,
    production_binding: ^bash_production_embedded_quote_lit,
    tokens: bash_embedded_quote_concrete_tokens()
  )
}

fn bash_mvp1_target_model_bundle() -> Node {
  bash_target_model_bundle(
    rules: bash_mvp1_translation_rules_node(),
    serialize_source: bash_mvp1_serialize_source_node()
  )
}

fn bash_bound_words_target_model_bundle() -> Node {
  bash_target_model_bundle(
    rules: bash_bound_words_translation_rules_node(),
    serialize_source: bash_bound_words_serialize_source_node()
  )
}

fn bash_embedded_quote_target_model_bundle() -> Node {
  bash_target_model_bundle(
    rules: bash_embedded_quote_translation_rules_node(),
    serialize_source: bash_embedded_quote_serialize_source_node()
  )
}

// =========================================================================
// Lex — POSIX single-quoting + token-adjacent layout baked into each literal (interim policy,
// dissolves with rust.dag's T-6 TokenLayout). `'git'` then ` 'rev-parse'` then ` '--show-toplevel'`
// concatenate to the canonical source text.
// =========================================================================

fn bash_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn bash_mvp1_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      bash_lex_rule(token_class: ^bash_token_word_git, text: "'git'"),
      bash_lex_rule(token_class: ^bash_token_word_rev_parse, text: " 'rev-parse'"),
      bash_lex_rule(token_class: ^bash_token_word_show_toplevel, text: " '--show-toplevel'")
    ]
  }
}

fn bash_mvp1_lex() -> LexRules {
  ModeledLexRules { root: bash_mvp1_lex_rules() }
}

fn bash_mvp1_target_model() -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: bash_mvp1_target_model_bundle(),
    lex: bash_mvp1_lex(),
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: bash_mvp1_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn bash_bound_words_target_model() -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: bash_bound_words_target_model_bundle(),
    lex: bash_mvp1_lex(),
    binding_spellings: bash_binding_spellings(),
    token_class_emit_transforms: bash_token_class_emit_transforms(),
    authority_source_text: bash_bound_words_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn bash_embedded_quote_target_model() -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: bash_embedded_quote_target_model_bundle(),
    lex: bash_mvp1_lex(),
    binding_spellings: bash_binding_spellings(),
    token_class_emit_transforms: bash_token_class_emit_transforms(),
    authority_source_text: bash_embedded_quote_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

