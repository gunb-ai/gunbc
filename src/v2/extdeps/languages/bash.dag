    rule_name: ^bash_relation_rule_or_else_with_redir,
    lhs: ^bash_production_or_else_with_redir,
    tokens: bash_or_else_with_redir_concrete_tokens(),
    emitted: bash_or_else_with_redir_emitted
  )
}

// =========================================================================
// Slice 5b — If / Subshell / Heredoc + pipe|precedence brace-group keystone.
// Pipe binds tighter than &&: flat `'true' && 'false' | 'true'` mis-groups as
// `'true' && ('false' | 'true')`. Correct emit wraps the AndOr operand: `{ 'true' && 'false'; } | 'true'`.
// Authority: program.dag BraceGroup + Pipe fixture (not the sidecar's flat Pipe concat).
// =========================================================================

fn bash_subshell_true_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_lparen },
    FixedToken { token_class: ^bash_token_word_true },
    FixedToken { token_class: ^bash_token_rparen }
  ]
}

data bash_subshell_true_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_subshell_true_concrete_tokens()
)

data bash_subshell_true_source_text: String = "('true')"

fn bash_subshell_true_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_subshell_true,
    lhs: ^bash_production_subshell_true,
    tokens: bash_subshell_true_concrete_tokens(),
    emitted: bash_subshell_true_emitted
  )
}

fn bash_if_true_then_false_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_kw_if },
    FixedToken { token_class: ^bash_token_word_true },
    FixedToken { token_class: ^bash_token_semicolon },
    FixedToken { token_class: ^bash_token_kw_then },
    FixedToken { token_class: ^bash_token_word_false },
    FixedToken { token_class: ^bash_token_semicolon },
    FixedToken { token_class: ^bash_token_kw_fi }
  ]
}

data bash_if_true_then_false_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_if_true_then_false_concrete_tokens()
)

data bash_if_true_then_false_source_text: String = "if 'true'; then 'false'; fi"

fn bash_if_true_then_false_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_if_true_then_false,
    lhs: ^bash_production_if_true_then_false,
    tokens: bash_if_true_then_false_concrete_tokens(),
    emitted: bash_if_true_then_false_emitted
  )
}

fn bash_heredoc_simple_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_cat },
    FixedToken { token_class: ^bash_token_greater },
    FixedToken { token_class: ^bash_token_word_out },
    FixedToken { token_class: ^bash_token_heredoc_open_eof },
    FixedToken { token_class: ^bash_token_heredoc_body_hi },
