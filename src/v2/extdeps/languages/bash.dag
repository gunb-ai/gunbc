  tokens: bash_heredoc_simple_concrete_tokens()
)

data bash_heredoc_simple_source_text: String = "cat > 'out' <<'EOF'\nhi\nEOF"

fn bash_heredoc_simple_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_heredoc_simple,
    lhs: ^bash_production_heredoc_simple,
    tokens: bash_heredoc_simple_concrete_tokens(),
    emitted: bash_heredoc_simple_emitted
  )
}

// Subshell nesting AndOr — recursion test only (|| has equal precedence to &&; parens
// change bytes but not parse grouping). `'(' 'true' && 'false' ')' || 'true'`
fn bash_subshell_and_or_nested_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_lparen },
    FixedToken { token_class: ^bash_token_word_true },
    FixedToken { token_class: ^bash_token_and_then },
    FixedToken { token_class: ^bash_token_word_false },
    FixedToken { token_class: ^bash_token_rparen },
    FixedToken { token_class: ^bash_token_or_else },
    FixedToken { token_class: ^bash_token_word_true }
  ]
}

data bash_subshell_and_or_nested_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_subshell_and_or_nested_concrete_tokens()
)

data bash_subshell_and_or_nested_source_text: String = "('true' && 'false') || 'true'"

fn bash_subshell_and_or_nested_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_subshell_and_or_nested,
    lhs: ^bash_production_subshell_and_or_nested,
    tokens: bash_subshell_and_or_nested_concrete_tokens(),
    emitted: bash_subshell_and_or_nested_emitted
  )
}

// Pipe { AndOr{a,&&,b}, c } — brace-group wrap is mandatory because | binds tighter than &&.
// Correct: `{ 'true' && 'false'; } | 'true'`. Wrong flat concat: `'true' && 'false' | 'true'`.
fn bash_pipe_and_or_brace_grouped_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_lbrace },
    FixedToken { token_class: ^bash_token_word_true },
    FixedToken { token_class: ^bash_token_and_then },
    FixedToken { token_class: ^bash_token_word_false },
    FixedToken { token_class: ^bash_token_semicolon_rbrace },
    FixedToken { token_class: ^bash_token_pipe },
    FixedToken { token_class: ^bash_token_word_true }
  ]
}

data bash_pipe_and_or_brace_grouped_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_pipe_and_or_brace_grouped_concrete_tokens()
)

data bash_pipe_and_or_brace_grouped_source_text: String = "{ 'true' && 'false'; } | 'true'"

fn bash_pipe_and_or_brace_grouped_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_pipe_and_or_brace_grouped,
    lhs: ^bash_production_pipe_and_or_brace_grouped,
    tokens: bash_pipe_and_or_brace_grouped_concrete_tokens(),
    emitted: bash_pipe_and_or_brace_grouped_emitted
  )
}

fn bash_pipe_and_or_flat_wrong_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_true },
    FixedToken { token_class: ^bash_token_and_then },
    FixedToken { token_class: ^bash_token_word_false },
    FixedToken { token_class: ^bash_token_pipe },
    FixedToken { token_class: ^bash_token_word_true }
  ]
}

data bash_pipe_and_or_flat_wrong_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_pipe_and_or_flat_wrong_concrete_tokens()
