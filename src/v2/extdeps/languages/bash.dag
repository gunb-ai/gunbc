    FixedToken { token_class: ^bash_token_word_echo },
    FixedToken { token_class: ^bash_token_word_hi },
    FixedToken { token_class: ^bash_token_pipe },
    FixedToken { token_class: ^bash_token_word_wc },
    FixedToken { token_class: ^bash_token_word_minus_c }
  ]
}

fn bash_pipe_grammar_production() -> GrammarProduction {
  GrammarProduction {
    name: ^bash_production_pipe,
    expression: bash_grammar_sequence_from_tokens(tokens: bash_pipe_concrete_tokens()),
    emitted: bash_word_atom(id: ^bash_surface_pipe_stmt)
