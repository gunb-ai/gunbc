    source_text: bash_stmt_heredoc_source_text(path: path, delimiter: delimiter, body: body),
    lex: bash_stmt_heredoc_lex(),
    binding_spellings: bash_stmt_heredoc_binding_spellings(path: path, delimiter: delimiter, body: body)
  )
}

