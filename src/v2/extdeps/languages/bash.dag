) -> Map<Symbol, String> {
  map_insert(
  map_insert(
  map_insert(
  map_insert(
  map_insert(
  map_insert(
  map_insert(empty_map(), ^orch_retry_occ1, occ1),
    ^orch_retry_occ2, occ2),
    ^orch_retry_occ3, occ3),
