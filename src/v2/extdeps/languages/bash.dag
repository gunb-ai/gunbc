// src/v2/extdeps/languages/bash.dag
// Scope: Bash (POSIX.1-2017 Shell Command Language) as a v2 emit TARGET — the 19th LanguageModel
// peer of rust/python/go/…, a TargetModel of translation rows consumed by the row-driven emit
// (DESIGN.md §4: `emit = serialize_target ∘ translate`, one grammar read backward). This is the
// authority that DISSOLVES the `extdeps/languages/bash/program.dag` sidecar serializer
// (`serialize_bash`): a transport authors INTENT and `emit(intent, Bash)` renders shell the same
// row-driven way `emit(intent, Rust)` already does — no per-language hand-rolled emitter.
//
// Anchor: https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html
//
// MIGRATION SLICE 1 — fixed-token command `'git' 'rev-parse' '--show-toplevel'` (landed #5155).
//
// MIGRATION SLICE 2 — bound-word emit-time quoting via `token_class_emit_transforms` on
// TargetModel (target_model.dag). Dynamic words (VarRef, Lit payloads) use BoundToken rows;
// POSIX single-quote / double-quoted var-ref wrapping runs at emit time keyed by token class.
//
// MIGRATION SLICE 3 — relocate source_root_ingest gate transport to v2.workflow
// (v2.workflow.source_root_ingest_transport); live path still serialize_bash today.
// Row-driven emit(byte-identity) is proven by bash_emit_source_root_ingest_gate_holds;
// emit(intent, Bash) flip for the live transport is a later slice in this arc.
//
// MIGRATION SLICE 4 — ShellStmt compound constructs (AndOr / Pipe / WithRedir) as translation
// rows. Byte-identical to serialize_bash for each fixture; witnesses in bash_emit_command_test.
//
// MIGRATION SLICE 5a — cross Arrow→Conj: Conj-positional emitted + FormalProduction flat rhs
// on the lhs-exact structural path (`derive_grammar_relation_row_node`); dissolves slice-4's
// `bash_fixed_tokens_grammar_relation_row` Arrow exact-equality scaffold.
// Next slices: If/Subshell/Heredoc → Assign/EnvPrefixed/Exit → migrate sidecar consumers →
// delete program.dag.
//
// v2-clean (no std.render / std.unicode imports) so witnesses execute under the v1 interpreter.

module v2.extdeps.languages.bash

import v2.std.algebra { Empty, fold_list, list_snoc_item }
import v2.std.grammar {
  FormalGrammarSymbol,
  FormalProduction,
  derive_grammar_relation_row_node,
  formal_production_for_lhs_exact,
  grammar_formal_production,
  grammar_formal_terminal,
  grammar_formal_terminal_bound,
  grammar_relation_tokens_node
}
import v2.std.compilers.lexing {
  LexRule,
  LexRuleSet,
  LexRules,
  LiteralPattern,
  ModeledLexRules,
  TokenRule
}
import v2.std.compilers.target_model {
  BoundToken,
  ConcreteSyntaxToken,
  FixedToken,
  TargetModel,
  target_model_emit_transforms_empty,
  target_model_make_with_emit_transforms,
  concrete_syntax_token_to_node
}
import v2.std.collection { List, Map, empty_map, map_insert }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.witness { Holds, Violates, Witness }

// =========================================================================
// The emitted intent (the `translate`-side anchor).
//
// Conj of leaf-Atom positional children — one atom per bound-token slot (FixedToken
// occurrences in FormalProduction.rhs are unbound and carry no emitted child).
// lhs-exact-supported: grammar relation row selection walks FormalProduction rhs
// against positional emitted children (`formal_production_for_lhs_exact` →
// `derive_grammar_relation_row_node`), not Arrow exact-fixture equality.
// =========================================================================

fn bash_word_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_conj_emitted_from_tokens(tokens: List<ConcreteSyntaxToken>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: tokens,
      empty: Empty,
      cons: fn(acc, token) {
        match token {
          BoundToken { binding: binding, token_class: _ } =>
            list_snoc_item(
              xs: acc,
              item: Edge { label: Positional, target: bash_word_atom(id: binding) }
            )
          FixedToken { token_class: _ } => acc
        }
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}


fn bash_formal_symbol_from_token(token: ConcreteSyntaxToken) -> FormalGrammarSymbol {
  match token {
    FixedToken { token_class: c } => grammar_formal_terminal(identity: c)
    BoundToken { token_class: c, binding: b } =>
      grammar_formal_terminal_bound(identity: c, binding: b)
  }
}

fn bash_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(xs: acc, item: bash_formal_symbol_from_token(token: token))
    }
  )
}

fn bash_formal_production_from_fixture(
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>
) -> FormalProduction {
  grammar_formal_production(
    lhs: lhs,
    rhs: bash_formal_rhs_from_tokens(tokens: tokens)
  )
}

fn bash_lhs_exact_relation_row_witness(
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Witness<Node> {
  let production = bash_formal_production_from_fixture(lhs: lhs, tokens: tokens)
  let productions = [production]
  match formal_production_for_lhs_exact(
    productions: productions,
    lhs: lhs,
    child: emitted
  ) {
    Holds { value: selected } =>
      derive_grammar_relation_row_node(
        production: selected,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_empty_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_relation_translation_rules_witness(
  rule_name: Symbol,
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Witness<Node> {
  match bash_lhs_exact_relation_row_witness(
    lhs: lhs,
    tokens: tokens,
    emitted: emitted
  ) {
    Holds { value: row } =>
      Holds {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            bash_named_edge(name: rule_name, target: row)
          ],
          occurrence_id: SyntheticOccurrence
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_relation_translation_rules_node(
  rule_name: Symbol,
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Node {
  match bash_relation_translation_rules_witness(
    rule_name: rule_name,
    lhs: lhs,
    tokens: tokens,
    emitted: emitted
  ) {
    Holds { value: rules } => rules
    Violates { diagnostic: _ } => bash_empty_translation_rules_node()
  }
}


// The canonical shell text emit must produce (POSIX single-quoted words). Byte-identical to
// `serialize_bash(command([lit("git"), lit("rev-parse"), lit("--show-toplevel")]))`.
data bash_mvp1_source_text: String = "'git' 'rev-parse' '--show-toplevel'"

// =========================================================================
// Concrete tokens — every word a FixedToken (no bound/dynamic words in slice 1).
// =========================================================================

fn bash_mvp1_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_git },
    FixedToken { token_class: ^bash_token_word_rev_parse },
    FixedToken { token_class: ^bash_token_word_show_toplevel }
  ]
}

data bash_mvp1_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_mvp1_concrete_tokens()
)

fn bash_concrete_token_node(token: ConcreteSyntaxToken) -> Node {
  // Serialize through the single shared morphism (no parallel wire authority).
  concrete_syntax_token_to_node(token: token)
}

fn bash_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

// =========================================================================
// Grammar relation row: emitted intent ⇄ concrete token sequence.
// =========================================================================

fn bash_mvp1_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_command,
    lhs: ^bash_production_command,
    tokens: bash_mvp1_concrete_tokens(),
    emitted: bash_mvp1_emitted_command
  )
}

fn bash_bound_words_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_bound_words,
    lhs: ^bash_production_bound_words,
    tokens: bash_bound_words_concrete_tokens(),
    emitted: bash_bound_words_emitted_command
  )
}

fn bash_embedded_quote_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_embedded_quote_lit,
    lhs: ^bash_production_embedded_quote_lit,
    tokens: bash_embedded_quote_concrete_tokens(),
    emitted: bash_embedded_quote_emitted_command
  )
}

// =========================================================================
// Slice 2 — bound words: VarRef double-quoted + Lit single-quoted at emit time.
// Byte-identical to serialize_bash(command([var_ref("ROOT"), lit("ROOT")])) => "$ROOT" 'ROOT'
// =========================================================================

fn bash_bound_words_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken { token_class: ^bash_token_var_ref, binding: ^bash_binding_var_ROOT },
    BoundToken { token_class: ^bash_token_lit_spaced, binding: ^bash_binding_lit_ROOT }
  ]
}

data bash_bound_words_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_bound_words_concrete_tokens()
)

data bash_bound_words_source_text: String = "\"$ROOT\" 'ROOT'"

// Single-word bound lit with an embedded single quote — total POSIX escaping.
fn bash_embedded_quote_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken {
      token_class: ^bash_token_lit,
      binding: ^bash_binding_lit_a_quote_b
    }
  ]
}

data bash_embedded_quote_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_embedded_quote_concrete_tokens()
)

data bash_embedded_quote_source_text: String = "'a'\\''b'"

// =========================================================================
// Slice 3 — source-root-ingest gate: fixed two-word Command.
// Byte-identical to serialize_bash(command([lit("bash"), lit("scripts/source-root-ingest-gate.sh")]))
// modulo the sidecar's trailing newline (immaterial to `sh -c`).
// =========================================================================

fn bash_source_root_ingest_gate_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_bash },
    FixedToken { token_class: ^bash_token_word_source_root_ingest_gate_sh }
  ]
}

data bash_source_root_ingest_gate_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_source_root_ingest_gate_concrete_tokens()
)

data bash_source_root_ingest_gate_source_text: String = "'bash' 'scripts/source-root-ingest-gate.sh'"

fn bash_source_root_ingest_gate_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_source_root_ingest_gate,
    lhs: ^bash_production_source_root_ingest_gate,
    tokens: bash_source_root_ingest_gate_concrete_tokens(),
    emitted: bash_source_root_ingest_gate_emitted_command
  )
}

// =========================================================================
// Slice 4 — AndOr / Pipe / WithRedir (POSIX §2.9 lists / compound commands).
// Shared helper: bash_conj_emitted_from_tokens.
// Each row is byte-identical to serialize_bash for the matching ShellStmt fixture.
// =========================================================================

fn bash_and_then_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_true },
    FixedToken { token_class: ^bash_token_and_then },
    FixedToken { token_class: ^bash_token_word_false }
  ]
}

// AndOr { AndThen } — `'true' && 'false'`
data bash_and_then_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_and_then_concrete_tokens()
)

data bash_and_then_source_text: String = "'true' && 'false'"

fn bash_and_then_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_and_then,
    lhs: ^bash_production_and_then,
    tokens: bash_and_then_concrete_tokens(),
    emitted: bash_and_then_emitted
  )
}

fn bash_or_else_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_true },
    FixedToken { token_class: ^bash_token_or_else },
    FixedToken { token_class: ^bash_token_word_false }
  ]
}

// AndOr { OrElse } — `'true' || 'false'`
data bash_or_else_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_or_else_concrete_tokens()
)

data bash_or_else_source_text: String = "'true' || 'false'"

fn bash_or_else_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_or_else,
    lhs: ^bash_production_or_else,
    tokens: bash_or_else_concrete_tokens(),
    emitted: bash_or_else_emitted
  )
}

fn bash_with_redir_stderr_null_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_git },
    FixedToken { token_class: ^bash_token_word_rev_parse },
    FixedToken { token_class: ^bash_token_word_show_toplevel },
    FixedToken { token_class: ^bash_token_redir_stderr_null }
  ]
}

// WithRedir { StderrToNull } — `'git' 'rev-parse' '--show-toplevel' 2>/dev/null`
data bash_with_redir_stderr_null_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_with_redir_stderr_null_concrete_tokens()
)

data bash_with_redir_stderr_null_source_text: String = "'git' 'rev-parse' '--show-toplevel' 2>/dev/null"

fn bash_with_redir_stderr_null_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_with_redir_stderr_null,
    lhs: ^bash_production_with_redir_stderr_null,
    tokens: bash_with_redir_stderr_null_concrete_tokens(),
    emitted: bash_with_redir_stderr_null_emitted
  )
}

fn bash_pipe_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_echo },
    FixedToken { token_class: ^bash_token_word_hi },
    FixedToken { token_class: ^bash_token_pipe },
    FixedToken { token_class: ^bash_token_word_wc },
    FixedToken { token_class: ^bash_token_word_minus_c }
  ]
}

// Pipe — `'echo' 'hi' | 'wc' '-c'`
data bash_pipe_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_pipe_concrete_tokens()
)

data bash_pipe_source_text: String = "'echo' 'hi' | 'wc' '-c'"

fn bash_pipe_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_pipe,
    lhs: ^bash_production_pipe,
    tokens: bash_pipe_concrete_tokens(),
    emitted: bash_pipe_emitted
  )
}

fn bash_or_else_with_redir_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_git },
    FixedToken { token_class: ^bash_token_word_rev_parse },
    FixedToken { token_class: ^bash_token_word_show_toplevel },
    FixedToken { token_class: ^bash_token_redir_stderr_null },
    FixedToken { token_class: ^bash_token_or_else },
    FixedToken { token_class: ^bash_token_word_pwd }
  ]
}

// host_prelude-shaped OrElse over WithRedir — `'git' 'rev-parse' '--show-toplevel' 2>/dev/null || 'pwd'`
// Composes the standalone WithRedir + OrElse token classes (not a fused lex literal).
data bash_or_else_with_redir_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_or_else_with_redir_concrete_tokens()
)

data bash_or_else_with_redir_source_text: String = "'git' 'rev-parse' '--show-toplevel' 2>/dev/null || 'pwd'"

fn bash_or_else_with_redir_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_or_else_with_redir,
    lhs: ^bash_production_or_else_with_redir,
    tokens: bash_or_else_with_redir_concrete_tokens(),
    emitted: bash_or_else_with_redir_emitted
  )
}

fn bash_binding_spellings() -> Map<Symbol, String> {
  let m0 = map_insert(empty_map(), ^bash_binding_var_ROOT, "ROOT")
  let m1 = map_insert(m0, ^bash_binding_lit_ROOT, "ROOT")
  map_insert(m1, ^bash_binding_lit_a_quote_b, "a'b")
}

// POSIX §2.2.2 — inside single quotes every character is literal; embedded `'` → `'\''`.
fn bash_single_quote(spelling: String) -> String {
  concat("'", concat(replace(spelling, "'", "'\\''"), "'"))
}

// Layout + quoting composed (§2: not a Cartesian product enum case in std).
fn bash_single_quote_spaced(spelling: String) -> String {
  concat(" ", bash_single_quote(spelling: spelling))
}

fn bash_var_ref_spelling(spelling: String) -> String {
  concat("\"$", concat(spelling, "\""))
}

fn bash_token_class_emit_transforms() -> Map<Symbol, fn(String) -> String> {
  let m0 = map_insert(empty_map(), ^bash_token_lit, bash_single_quote)
  let m1 = map_insert(m0, ^bash_token_lit_spaced, bash_single_quote_spaced)
  map_insert(m1, ^bash_token_var_ref, bash_var_ref_spelling)
}

fn bash_serialize_source_node(
  source_text_binding: Symbol,
  production_binding: Symbol,
  tokens: List<ConcreteSyntaxToken>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^serialize_source_field_source_text,
        target: bash_word_atom(id: source_text_binding)
      ),
      bash_named_edge(
        name: ^serialize_source_field_source_grammar,
        target: bash_word_atom(id: production_binding)
      ),
      bash_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: tokens,
          token_to_node: bash_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_target_model_bundle(rules: Node, serialize_source: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^target_model_edge_translation_rules,
        target: rules
      ),
      bash_named_edge(
        name: ^target_model_edge_serialize_source,
        target: serialize_source
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_mvp1_serialize_source_node() -> Node {
  bash_serialize_source_node(
    source_text_binding: ^bash_mvp1_source_literal,
    production_binding: ^bash_production_command,
    tokens: bash_mvp1_concrete_tokens()
  )
}

fn bash_bound_words_serialize_source_node() -> Node {
  bash_serialize_source_node(
    source_text_binding: ^bash_bound_words_source_literal,
    production_binding: ^bash_production_bound_words,
    tokens: bash_bound_words_concrete_tokens()
  )
}

fn bash_embedded_quote_serialize_source_node() -> Node {
  bash_serialize_source_node(
    source_text_binding: ^bash_embedded_quote_source_literal,
    production_binding: ^bash_production_embedded_quote_lit,
    tokens: bash_embedded_quote_concrete_tokens()
  )
}

fn bash_mvp1_target_model_bundle() -> Node {
  bash_target_model_bundle(
    rules: bash_mvp1_translation_rules_node(),
    serialize_source: bash_mvp1_serialize_source_node()
  )
}

fn bash_bound_words_target_model_bundle() -> Node {
  bash_target_model_bundle(
    rules: bash_bound_words_translation_rules_node(),
    serialize_source: bash_bound_words_serialize_source_node()
  )
}

fn bash_embedded_quote_target_model_bundle() -> Node {
  bash_target_model_bundle(
    rules: bash_embedded_quote_translation_rules_node(),
    serialize_source: bash_embedded_quote_serialize_source_node()
  )
}

// =========================================================================
// Lex — POSIX single-quoting + token-adjacent layout baked into each literal (interim policy,
// dissolves with rust.dag's T-6 TokenLayout). `'git'` then ` 'rev-parse'` then ` '--show-toplevel'`
// concatenate to the canonical source text.
// =========================================================================

fn bash_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn bash_mvp1_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      bash_lex_rule(token_class: ^bash_token_word_git, text: "'git'"),
      bash_lex_rule(token_class: ^bash_token_word_rev_parse, text: " 'rev-parse'"),
      bash_lex_rule(token_class: ^bash_token_word_show_toplevel, text: " '--show-toplevel'")
    ]
  }
}

fn bash_mvp1_lex() -> LexRules {
  ModeledLexRules { root: bash_mvp1_lex_rules() }
}

fn bash_mvp1_target_model() -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: bash_mvp1_target_model_bundle(),
    lex: bash_mvp1_lex(),
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: bash_mvp1_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn bash_bound_words_target_model() -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: bash_bound_words_target_model_bundle(),
    lex: bash_mvp1_lex(),
    binding_spellings: bash_binding_spellings(),
    token_class_emit_transforms: bash_token_class_emit_transforms(),
    authority_source_text: bash_bound_words_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn bash_embedded_quote_target_model() -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: bash_embedded_quote_target_model_bundle(),
    lex: bash_mvp1_lex(),
    binding_spellings: bash_binding_spellings(),
    token_class_emit_transforms: bash_token_class_emit_transforms(),
    authority_source_text: bash_embedded_quote_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn bash_source_root_ingest_gate_serialize_source_node() -> Node {
  bash_serialize_source_node(
    source_text_binding: ^bash_source_root_ingest_gate_source_literal,
    production_binding: ^bash_production_source_root_ingest_gate,
    tokens: bash_source_root_ingest_gate_concrete_tokens()
  )
}

fn bash_source_root_ingest_gate_target_model_bundle() -> Node {
  bash_target_model_bundle(
    rules: bash_source_root_ingest_gate_translation_rules_node(),
    serialize_source: bash_source_root_ingest_gate_serialize_source_node()
  )
}

fn bash_source_root_ingest_gate_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      bash_lex_rule(token_class: ^bash_token_word_bash, text: "'bash'"),
      bash_lex_rule(
        token_class: ^bash_token_word_source_root_ingest_gate_sh,
        text: " 'scripts/source-root-ingest-gate.sh'"
      )
    ]
  }
}

fn bash_source_root_ingest_gate_lex() -> LexRules {
  ModeledLexRules { root: bash_source_root_ingest_gate_lex_rules() }
}

fn bash_source_root_ingest_gate_target_model() -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: bash_source_root_ingest_gate_target_model_bundle(),
    lex: bash_source_root_ingest_gate_lex(),
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: bash_source_root_ingest_gate_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn bash_make_fixed_tokens_target_model(
  rules: Node,
  source_literal: Symbol,
  production_name: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  source_text: String,
  lex: LexRules
) -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: bash_target_model_bundle(
      rules: rules,
      serialize_source: bash_serialize_source_node(
        source_text_binding: source_literal,
        production_binding: production_name,
        tokens: tokens
      )
    ),
    lex: lex,
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn bash_and_then_lex() -> LexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: [
        bash_lex_rule(token_class: ^bash_token_word_true, text: "'true'"),
        bash_lex_rule(token_class: ^bash_token_and_then, text: " && "),
        bash_lex_rule(token_class: ^bash_token_word_false, text: "'false'")
      ]
    }
  }
}

fn bash_and_then_target_model() -> TargetModel {
  bash_make_fixed_tokens_target_model(
    rules: bash_and_then_translation_rules_node(),
    source_literal: ^bash_and_then_source_literal,
    production_name: ^bash_production_and_then,
    tokens: bash_and_then_concrete_tokens(),
    source_text: bash_and_then_source_text,
    lex: bash_and_then_lex()
  )
}

fn bash_or_else_lex() -> LexRules {
