fn bash_bound_words_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken { token_class: ^bash_token_var_ref, binding: ^bash_binding_var_ROOT },
    BoundToken { token_class: ^bash_token_lit_spaced, binding: ^bash_binding_lit_ROOT }
  ]
}

data bash_bound_words_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_bound_words_concrete_tokens()
)

data bash_bound_words_source_text: String = "\"$ROOT\" 'ROOT'"

fn bash_embedded_quote_concrete_tokens() -> List<ConcreteSyntaxToken> {
