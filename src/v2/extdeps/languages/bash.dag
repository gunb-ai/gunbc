fn bash_subshell_true_phrase() -> LexicalPhrase {
  phrase([
    span(text: "(",      class: ^bash_token_lparen),
    span(text: "'true'", class: ^bash_token_word_true),
    span(text: ")",      class: ^bash_token_rparen)
  ])
}

fn bash_if_true_then_false_phrase() -> LexicalPhrase {
  phrase([
    span(text: "if ",     class: ^bash_token_kw_if),
    span(text: "'true'",  class: ^bash_token_word_true),
    span(text: "; ",      class: ^bash_token_semicolon),
    span(text: "then ",   class: ^bash_token_kw_then),
    span(text: "'false'", class: ^bash_token_word_false),
    span(text: "; ",      class: ^bash_token_semicolon),
    span(text: "fi",      class: ^bash_token_kw_fi)
  ])
}

fn bash_heredoc_simple_phrase() -> LexicalPhrase {
  phrase([
    span(text: "cat",         class: ^bash_token_word_cat),
    span(text: " > ",         class: ^bash_token_greater),
    span(text: "'out'",       class: ^bash_token_word_out),
    span(text: " <<'EOF'\n",  class: ^bash_token_heredoc_open_eof),
    span(text: "hi\n",        class: ^bash_token_heredoc_body_hi),
    span(text: "EOF",         class: ^bash_token_heredoc_close_eof)
  ])
}

fn bash_subshell_and_or_nested_phrase() -> LexicalPhrase {
  phrase([
    span(text: "(",       class: ^bash_token_lparen),
    span(text: "'true'",  class: ^bash_token_word_true),
    span(text: " && ",    class: ^bash_token_and_then),
    span(text: "'false'", class: ^bash_token_word_false),
    span(text: ")",       class: ^bash_token_rparen),
    span(text: " || ",    class: ^bash_token_or_else),
    span(text: "'true'",  class: ^bash_token_word_true)
  ])
}

fn bash_pipe_and_or_brace_grouped_phrase() -> LexicalPhrase {
  phrase([
    span(text: "{ ",      class: ^bash_token_lbrace),
    span(text: "'true'",  class: ^bash_token_word_true),
    span(text: " && ",    class: ^bash_token_and_then),
    span(text: "'false'", class: ^bash_token_word_false),
    span(text: "; }",     class: ^bash_token_semicolon_rbrace),
    span(text: " | ",     class: ^bash_token_pipe),
    span(text: "'true'",  class: ^bash_token_word_true)
  ])
}

fn bash_pipe_and_or_flat_wrong_phrase() -> LexicalPhrase {
  phrase([
    span(text: "'true'",  class: ^bash_token_word_true),
    span(text: " && ",    class: ^bash_token_and_then),
    span(text: "'false'", class: ^bash_token_word_false),
    span(text: " | ",     class: ^bash_token_pipe),
    span(text: "'true'",  class: ^bash_token_word_true)
  ])
}

