// src/v2/extdeps/languages/bash.dag
// Scope: Bash (POSIX.1-2017 Shell Command Language) as a v2 emit TARGET — the 19th LanguageModel
// peer of rust/python/go/…, a TargetModel of translation rows consumed by the row-driven emit
// (DESIGN.md §4: `emit = serialize_target ∘ translate`, one grammar read backward). This is the
// authority that DISSOLVES the `extdeps/languages/bash/program.dag` sidecar serializer
// (`serialize_bash`): a transport authors INTENT and `emit(intent, Bash)` renders shell the same
// row-driven way `emit(intent, Rust)` already does — no per-language hand-rolled emitter.
//
// Anchor: https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html
//
// MIGRATION SLICE 1 — fixed-token command `'git' 'rev-parse' '--show-toplevel'` (landed #5155).
//
// MIGRATION SLICE 2 — bound-word emit-time quoting via `token_class_emit_transforms` on
// TargetModel (target_model.dag). Dynamic words (VarRef, Lit payloads) use BoundToken rows;
// POSIX single-quote / double-quoted var-ref wrapping runs at emit time keyed by token class.
//
// MIGRATION SLICE 3 — relocate source_root_ingest gate transport to v2.workflow
// (v2.workflow.source_root_ingest_transport); live path still serialize_bash today.
// Row-driven emit(byte-identity) is proven by bash_emit_source_root_ingest_gate_holds;
// emit(intent, Bash) flip for the live transport is a later slice in this arc.
//
// MIGRATION SLICE 4 — ShellStmt compound constructs (AndOr / Pipe / WithRedir) as translation
// rows. Byte-identical to serialize_bash for each fixture; witnesses in bash_emit_command_test.
//
// MIGRATION SLICE 5a — cross Arrow→Conj: Conj-positional emitted + FormalProduction flat rhs
// on the lhs-exact structural path (`derive_grammar_relation_row_node`); dissolves slice-4's
// `bash_fixed_tokens_grammar_relation_row` Arrow exact-equality scaffold.
// Bash is the first PRODUCTION consumer of the T-11-gated lhs-exact path
// (feature:grammar-inverse-lhs-exact-selection); on parser-convergence dissolution, migrate
// these bash FormalProduction rows together with typescript's.
// MIGRATION SLICE 5b — If / Subshell / Heredoc + pipe|precedence brace-group keystone
// (`Pipe { AndOr left }` must emit `{ a && b; } | c`, not flat `a && b | c`). Subshell
// nesting AndOr is a separate recursion fixture. Witnesses in bash_emit_command_test.
// Next slices: Assign/EnvPrefixed/Exit → migrate sidecar consumers → delete program.dag.
//
// v2-clean (no std.render / std.unicode imports) so witnesses execute under the v1 interpreter.

module v2.extdeps.languages.bash

import v2.std.algebra { Empty, fold_list, list_snoc_item }
import v2.std.grammar {
  FormalGrammarSymbol,
  FormalProduction,
  derive_grammar_relation_row_node,
  formal_production_for_lhs_exact,
  grammar_formal_production,
  grammar_formal_terminal,
  grammar_formal_terminal_bound,
  grammar_relation_tokens_node
}
import v2.std.compilers.lexing {
  LexRules,
  LexicalPhrase,
  phrase_text,
  phrase_to_lex_rules,
  phrase_to_source_text
}
import v2.std.compilers.target_model {
  BoundToken,
  ConcreteSyntaxToken,
  FixedToken,
  TargetModel,
  phrase_to_fixed_concrete_tokens,
  target_model_emit_transforms_empty,
  target_model_make_with_emit_transforms,
  concrete_syntax_token_to_node
}
import v2.std.collection { List, Map, empty_map, map_insert }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.witness { Holds, Violates, Witness }

// =========================================================================
// The emitted intent (the `translate`-side anchor).
//
// Conj of leaf-Atom positional children — one atom per bound-token slot (FixedToken
// occurrences in FormalProduction.rhs are unbound and carry no emitted child).
// lhs-exact-supported: grammar relation row selection walks FormalProduction rhs
// against positional emitted children (`formal_production_for_lhs_exact` →
// `derive_grammar_relation_row_node`), not Arrow exact-fixture equality.
// =========================================================================

fn bash_word_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_conj_emitted_from_tokens(tokens: List<ConcreteSyntaxToken>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: tokens,
      empty: Empty,
      cons: fn(acc, token) {
        match token {
          BoundToken { binding: binding, token_class: _ } =>
            list_snoc_item(
              xs: acc,
              item: Edge { label: Positional, target: bash_word_atom(id: binding) }
            )
          FixedToken { token_class: _ } => acc
        }
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}


fn bash_formal_symbol_from_token(token: ConcreteSyntaxToken) -> FormalGrammarSymbol {
  match token {
    FixedToken { token_class: c } => grammar_formal_terminal(identity: c)
    BoundToken { token_class: c, binding: b } =>
      grammar_formal_terminal_bound(identity: c, binding: b)
  }
}

fn bash_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(xs: acc, item: bash_formal_symbol_from_token(token: token))
    }
  )
}

fn bash_formal_production_from_fixture(
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>
) -> FormalProduction {
  grammar_formal_production(
    lhs: lhs,
    rhs: bash_formal_rhs_from_tokens(tokens: tokens)
  )
}

fn bash_lhs_exact_relation_row_witness(
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Witness<Node> {
  let production = bash_formal_production_from_fixture(lhs: lhs, tokens: tokens)
  let productions = [production]
  match formal_production_for_lhs_exact(
    productions: productions,
    lhs: lhs,
    child: emitted
  ) {
    Holds { value: selected } =>
      derive_grammar_relation_row_node(
        production: selected,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_empty_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_relation_translation_rules_witness(
  rule_name: Symbol,
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Witness<Node> {
  match bash_lhs_exact_relation_row_witness(
    lhs: lhs,
    tokens: tokens,
    emitted: emitted
  ) {
    Holds { value: row } =>
      Holds {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            bash_named_edge(name: rule_name, target: row)
          ],
          occurrence_id: SyntheticOccurrence
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_relation_translation_rules_node(
  rule_name: Symbol,
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Node {
  match bash_relation_translation_rules_witness(
    rule_name: rule_name,
    lhs: lhs,
    tokens: tokens,
    emitted: emitted
  ) {
    Holds { value: rules } => rules
    Violates { diagnostic: _ } => bash_empty_translation_rules_node()
  }
}


// =========================================================================
// Lexical phrases — one authority per fixed-token phrase (DESIGN.md §3).
//
// Each phrase is authored ONCE: the `text:` row reads LEFT-TO-RIGHT as the shell text the
// phrase emits, and the `classes:` row names each fragment's token class in the same order.
// The lex rule set, the concrete-token sequence, and the source-text string all PROJECT
// from these (phrase_to_lex_rules / phrase_to_fixed_concrete_tokens / phrase_to_source_text),
// so the three can no longer drift (DESIGN.md §2 horizontal: one concept, derive every use).
// The byte-identity to serialize_bash is proven by execution in bash_emit_command_test.
//
// Bound-word phrases (bash_bound_words / bash_embedded_quote) are spelled at emit time
// from a binding, not a literal fragment, so they are NOT LexicalPhrases yet — a
// binding-carrying span is the migration-time extension (see lexing.dag T-6 note).
// =========================================================================

fn bash_mvp1_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["'git'", " 'rev-parse'", " '--show-toplevel'"],
    classes: [^bash_token_word_git, ^bash_token_word_rev_parse, ^bash_token_word_show_toplevel]
  )
}

fn bash_source_root_ingest_gate_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["'bash'", " 'scripts/source-root-ingest-gate.sh'"],
    classes: [^bash_token_word_bash, ^bash_token_word_source_root_ingest_gate_sh]
  )
}

fn bash_and_then_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["'true'", " && ", "'false'"],
    classes: [^bash_token_word_true, ^bash_token_and_then, ^bash_token_word_false]
  )
}

fn bash_or_else_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["'true'", " || ", "'false'"],
    classes: [^bash_token_word_true, ^bash_token_or_else, ^bash_token_word_false]
  )
}

fn bash_with_redir_stderr_null_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["'git'", " 'rev-parse'", " '--show-toplevel'", " 2>/dev/null"],
    classes: [^bash_token_word_git, ^bash_token_word_rev_parse, ^bash_token_word_show_toplevel, ^bash_token_redir_stderr_null]
  )
}

fn bash_pipe_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["'echo'", " 'hi'", " | ", "'wc'", " '-c'"],
    classes: [^bash_token_word_echo, ^bash_token_word_hi, ^bash_token_pipe, ^bash_token_word_wc, ^bash_token_word_minus_c]
  )
}

fn bash_or_else_with_redir_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["'git'", " 'rev-parse'", " '--show-toplevel'", " 2>/dev/null", " || ", "'pwd'"],
    classes: [^bash_token_word_git, ^bash_token_word_rev_parse, ^bash_token_word_show_toplevel, ^bash_token_redir_stderr_null, ^bash_token_or_else, ^bash_token_word_pwd]
  )
}

// The canonical shell text emit must produce (POSIX single-quoted words). Byte-identical to
// `serialize_bash(command([lit("git"), lit("rev-parse"), lit("--show-toplevel")]))`.
data bash_mvp1_source_text: String = phrase_to_source_text(p: bash_mvp1_phrase())

// =========================================================================
// Concrete tokens — every word a FixedToken (no bound/dynamic words in slice 1).
// =========================================================================

fn bash_mvp1_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_mvp1_phrase())
}

data bash_mvp1_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_mvp1_concrete_tokens()
)

fn bash_concrete_token_node(token: ConcreteSyntaxToken) -> Node {
  // Serialize through the single shared morphism (no parallel wire authority).
  concrete_syntax_token_to_node(token: token)
}

fn bash_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

// =========================================================================
// Grammar relation row: emitted intent ⇄ concrete token sequence.
// =========================================================================

fn bash_mvp1_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_command,
    lhs: ^bash_production_command,
    tokens: bash_mvp1_concrete_tokens(),
    emitted: bash_mvp1_emitted_command
  )
}

fn bash_bound_words_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_bound_words,
    lhs: ^bash_production_bound_words,
    tokens: bash_bound_words_concrete_tokens(),
    emitted: bash_bound_words_emitted_command
  )
}

fn bash_embedded_quote_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_embedded_quote_lit,
    lhs: ^bash_production_embedded_quote_lit,
    tokens: bash_embedded_quote_concrete_tokens(),
    emitted: bash_embedded_quote_emitted_command
  )
}

// =========================================================================
// Slice 2 — bound words: VarRef double-quoted + Lit single-quoted at emit time.
// Byte-identical to serialize_bash(command([var_ref("ROOT"), lit("ROOT")])) => "$ROOT" 'ROOT'
// =========================================================================

fn bash_bound_words_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken { token_class: ^bash_token_var_ref, binding: ^bash_binding_var_ROOT },
    BoundToken { token_class: ^bash_token_lit_spaced, binding: ^bash_binding_lit_ROOT }
  ]
}

data bash_bound_words_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_bound_words_concrete_tokens()
)

data bash_bound_words_source_text: String = "\"$ROOT\" 'ROOT'"

// Single-word bound lit with an embedded single quote — total POSIX escaping.
fn bash_embedded_quote_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken {
      token_class: ^bash_token_lit,
      binding: ^bash_binding_lit_a_quote_b
    }
  ]
}

data bash_embedded_quote_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_embedded_quote_concrete_tokens()
)

data bash_embedded_quote_source_text: String = "'a'\\''b'"

// =========================================================================
// Slice 3 — source-root-ingest gate: fixed two-word Command.
// Byte-identical to serialize_bash(command([lit("bash"), lit("scripts/source-root-ingest-gate.sh")]))
// modulo the sidecar's trailing newline (immaterial to `sh -c`).
// =========================================================================

fn bash_source_root_ingest_gate_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_source_root_ingest_gate_phrase())
}

data bash_source_root_ingest_gate_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_source_root_ingest_gate_concrete_tokens()
)

data bash_source_root_ingest_gate_source_text: String = phrase_to_source_text(p: bash_source_root_ingest_gate_phrase())

fn bash_source_root_ingest_gate_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_source_root_ingest_gate,
    lhs: ^bash_production_source_root_ingest_gate,
    tokens: bash_source_root_ingest_gate_concrete_tokens(),
    emitted: bash_source_root_ingest_gate_emitted_command
  )
}

// =========================================================================
// Slice 4 — AndOr / Pipe / WithRedir (POSIX §2.9 lists / compound commands).
// Shared helper: bash_conj_emitted_from_tokens.
// Each row is byte-identical to serialize_bash for the matching ShellStmt fixture.
// =========================================================================

fn bash_and_then_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_and_then_phrase())
}

// AndOr { AndThen } — `'true' && 'false'`
data bash_and_then_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_and_then_concrete_tokens()
)

data bash_and_then_source_text: String = phrase_to_source_text(p: bash_and_then_phrase())

fn bash_and_then_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_and_then,
    lhs: ^bash_production_and_then,
    tokens: bash_and_then_concrete_tokens(),
    emitted: bash_and_then_emitted
  )
}

fn bash_or_else_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_or_else_phrase())
}

// AndOr { OrElse } — `'true' || 'false'`
data bash_or_else_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_or_else_concrete_tokens()
)

data bash_or_else_source_text: String = phrase_to_source_text(p: bash_or_else_phrase())

fn bash_or_else_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_or_else,
    lhs: ^bash_production_or_else,
    tokens: bash_or_else_concrete_tokens(),
    emitted: bash_or_else_emitted
  )
}

fn bash_with_redir_stderr_null_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_with_redir_stderr_null_phrase())
}

// WithRedir { StderrToNull } — `'git' 'rev-parse' '--show-toplevel' 2>/dev/null`
data bash_with_redir_stderr_null_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_with_redir_stderr_null_concrete_tokens()
)

data bash_with_redir_stderr_null_source_text: String = phrase_to_source_text(p: bash_with_redir_stderr_null_phrase())

fn bash_with_redir_stderr_null_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_with_redir_stderr_null,
    lhs: ^bash_production_with_redir_stderr_null,
    tokens: bash_with_redir_stderr_null_concrete_tokens(),
    emitted: bash_with_redir_stderr_null_emitted
  )
}

fn bash_pipe_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_pipe_phrase())
}

// Pipe — `'echo' 'hi' | 'wc' '-c'`
data bash_pipe_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_pipe_concrete_tokens()
)

data bash_pipe_source_text: String = phrase_to_source_text(p: bash_pipe_phrase())

fn bash_pipe_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_pipe,
    lhs: ^bash_production_pipe,
    tokens: bash_pipe_concrete_tokens(),
    emitted: bash_pipe_emitted
  )
}

fn bash_or_else_with_redir_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_or_else_with_redir_phrase())
}

// host_prelude-shaped OrElse over WithRedir — `'git' 'rev-parse' '--show-toplevel' 2>/dev/null || 'pwd'`
// Composes the standalone WithRedir + OrElse token classes (not a fused lex literal).
data bash_or_else_with_redir_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_or_else_with_redir_concrete_tokens()
)

data bash_or_else_with_redir_source_text: String = phrase_to_source_text(p: bash_or_else_with_redir_phrase())

fn bash_or_else_with_redir_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_or_else_with_redir,
    lhs: ^bash_production_or_else_with_redir,
    tokens: bash_or_else_with_redir_concrete_tokens(),
    emitted: bash_or_else_with_redir_emitted
  )
}

// =========================================================================
// Slice 5b — If / Subshell / Heredoc + pipe|precedence brace-group keystone.
// Pipe binds tighter than &&: flat `'true' && 'false' | 'true'` mis-groups as
// `'true' && ('false' | 'true')`. Correct emit wraps the AndOr operand: `{ 'true' && 'false'; } | 'true'`.
// Authority: program.dag BraceGroup + Pipe fixture (not the sidecar's flat Pipe concat).
//
// Lexical phrases (same single-authority form as the slice-1..4 phrases above): `text:`
// reads left-to-right as the shell text, `classes:` names each fragment's token class.
// =========================================================================

fn bash_subshell_true_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["(", "'true'", ")"],
    classes: [^bash_token_lparen, ^bash_token_word_true, ^bash_token_rparen]
  )
}

fn bash_if_true_then_false_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["if ", "'true'", "; ", "then ", "'false'", "; ", "fi"],
    classes: [^bash_token_kw_if, ^bash_token_word_true, ^bash_token_semicolon, ^bash_token_kw_then, ^bash_token_word_false, ^bash_token_semicolon, ^bash_token_kw_fi]
  )
}

fn bash_heredoc_simple_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["cat", " > ", "'out'", " <<'EOF'\n", "hi\n", "EOF"],
    classes: [^bash_token_word_cat, ^bash_token_greater, ^bash_token_word_out, ^bash_token_heredoc_open_eof, ^bash_token_heredoc_body_hi, ^bash_token_heredoc_close_eof]
  )
}

fn bash_subshell_and_or_nested_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["(", "'true'", " && ", "'false'", ")", " || ", "'true'"],
    classes: [^bash_token_lparen, ^bash_token_word_true, ^bash_token_and_then, ^bash_token_word_false, ^bash_token_rparen, ^bash_token_or_else, ^bash_token_word_true]
  )
}

fn bash_pipe_and_or_brace_grouped_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["{ ", "'true'", " && ", "'false'", "; }", " | ", "'true'"],
    classes: [^bash_token_lbrace, ^bash_token_word_true, ^bash_token_and_then, ^bash_token_word_false, ^bash_token_semicolon_rbrace, ^bash_token_pipe, ^bash_token_word_true]
  )
}

fn bash_pipe_and_or_flat_wrong_phrase() -> LexicalPhrase {
  phrase_text(
    text:    ["'true'", " && ", "'false'", " | ", "'true'"],
    classes: [^bash_token_word_true, ^bash_token_and_then, ^bash_token_word_false, ^bash_token_pipe, ^bash_token_word_true]
  )
}

fn bash_subshell_true_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_subshell_true_phrase())
}

data bash_subshell_true_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_subshell_true_concrete_tokens()
)

data bash_subshell_true_source_text: String = phrase_to_source_text(p: bash_subshell_true_phrase())

fn bash_subshell_true_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_subshell_true,
    lhs: ^bash_production_subshell_true,
    tokens: bash_subshell_true_concrete_tokens(),
    emitted: bash_subshell_true_emitted
  )
}

fn bash_if_true_then_false_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_if_true_then_false_phrase())
}

data bash_if_true_then_false_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_if_true_then_false_concrete_tokens()
)

data bash_if_true_then_false_source_text: String = phrase_to_source_text(p: bash_if_true_then_false_phrase())

fn bash_if_true_then_false_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_if_true_then_false,
    lhs: ^bash_production_if_true_then_false,
    tokens: bash_if_true_then_false_concrete_tokens(),
    emitted: bash_if_true_then_false_emitted
  )
}

fn bash_heredoc_simple_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_heredoc_simple_phrase())
}

data bash_heredoc_simple_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_heredoc_simple_concrete_tokens()
)

data bash_heredoc_simple_source_text: String = phrase_to_source_text(p: bash_heredoc_simple_phrase())

fn bash_heredoc_simple_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_heredoc_simple,
    lhs: ^bash_production_heredoc_simple,
    tokens: bash_heredoc_simple_concrete_tokens(),
    emitted: bash_heredoc_simple_emitted
  )
}

// Subshell nesting AndOr — recursion test only (|| has equal precedence to &&; parens
// change bytes but not parse grouping). `'(' 'true' && 'false' ')' || 'true'`
fn bash_subshell_and_or_nested_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_subshell_and_or_nested_phrase())
}

data bash_subshell_and_or_nested_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_subshell_and_or_nested_concrete_tokens()
)

data bash_subshell_and_or_nested_source_text: String = phrase_to_source_text(p: bash_subshell_and_or_nested_phrase())

fn bash_subshell_and_or_nested_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_subshell_and_or_nested,
    lhs: ^bash_production_subshell_and_or_nested,
    tokens: bash_subshell_and_or_nested_concrete_tokens(),
    emitted: bash_subshell_and_or_nested_emitted
  )
}

// Pipe { AndOr{a,&&,b}, c } — brace-group wrap is mandatory because | binds tighter than &&.
// Correct: `{ 'true' && 'false'; } | 'true'`. Wrong flat concat: `'true' && 'false' | 'true'`.
fn bash_pipe_and_or_brace_grouped_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_pipe_and_or_brace_grouped_phrase())
}

data bash_pipe_and_or_brace_grouped_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_pipe_and_or_brace_grouped_concrete_tokens()
)

data bash_pipe_and_or_brace_grouped_source_text: String = phrase_to_source_text(p: bash_pipe_and_or_brace_grouped_phrase())

fn bash_pipe_and_or_brace_grouped_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_pipe_and_or_brace_grouped,
    lhs: ^bash_production_pipe_and_or_brace_grouped,
    tokens: bash_pipe_and_or_brace_grouped_concrete_tokens(),
    emitted: bash_pipe_and_or_brace_grouped_emitted
  )
}

