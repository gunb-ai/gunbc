fn emit_directive_bash_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_echo },
    BoundToken { token_class: ^bash_token_lit_spaced, binding: ^emit_directive_message },
    FixedToken { token_class: ^bash_token_redir_stdout_to_stderr }
  ]
}

data emit_directive_bash_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: emit_directive_bash_concrete_tokens()
)

fn emit_directive_bash_source_text(d: EmitDirective) -> String {
  concat("'echo'", concat(bash_single_quote_spaced(spelling: d.message), " >&2"))
}

fn emit_directive_bash_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: "'echo'", class: ^bash_token_word_echo),
    span(text: " >&2",   class: ^bash_token_redir_stdout_to_stderr)
  ]))
}

fn emit_directive_bash_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_emit_directive_echo_stderr,
    lhs: ^bash_production_emit_directive_echo_stderr,
    tokens: emit_directive_bash_concrete_tokens(),
    emitted: emit_directive_bash_emitted_command
  )
}

fn emit_directive_bash_message_spellings(d: EmitDirective) -> Map<Symbol, String> {
  map_insert(empty_map(), ^emit_directive_message, d.message)
}

fn emit_directive_bash_target_model(d: EmitDirective) -> TargetModel {
  bash_make_bound_tokens_target_model(
    rules: emit_directive_bash_translation_rules_node(),
    source_literal: ^bash_emit_directive_echo_stderr_source_literal,
    production_name: ^bash_production_emit_directive_echo_stderr,
    tokens: emit_directive_bash_concrete_tokens(),
    source_text: emit_directive_bash_source_text(d: d),
    lex: emit_directive_bash_lex(),
    binding_spellings: emit_directive_bash_message_spellings(d: d)
  )
}

