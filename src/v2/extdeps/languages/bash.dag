// =========================================================================
// Slice 5c — Assign / EnvPrefixed / CmdSubst + Concat.
// Byte-identical to serialize_bash for each fixture.
// Shared operator tokens: ^bash_token_assign_name (BoundToken + binding_spellings),
// ^bash_token_assign_eq ("="), ^bash_token_cmdsubst_open ("$(") — one row per construct,
// not per transport variable (§2 horizontal; dissolves N×M fused-name fork).
// =========================================================================

// Assign { CmdSubst { Command } } — bash_serializer_witness / transport keystone:
// assign(name: "OUT", value: CmdSubst { body: command([mktemp, -d]) })
fn bash_assign_cmdsubst_mktemp_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken { token_class: ^bash_token_assign_name, binding: ^bash_binding_var_OUT },
    FixedToken { token_class: ^bash_token_assign_eq },
    FixedToken { token_class: ^bash_token_cmdsubst_open },
    FixedToken { token_class: ^bash_token_word_mktemp },
    FixedToken { token_class: ^bash_token_word_minus_d_spaced },
    FixedToken { token_class: ^bash_token_rparen }
  ]
}

