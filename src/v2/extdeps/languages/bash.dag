fn retry_eagain_seg_a() -> String {
  "BUILD_LOG=$(mktemp)\nif ! ("
}

fn retry_eagain_seg_b() -> String {
  ") 2>&1 | tee \"$BUILD_LOG\"; then\n  if grep -qiE '"
}

fn retry_eagain_seg_c() -> String {
  "' \"$BUILD_LOG\"; then\n    echo \"::warning::"
}

fn retry_eagain_seg_d() -> String {
  "\"\n    RETRY_LOG=$(mktemp)\n    if ! ( "
}

fn retry_eagain_seg_e() -> String {
  " ) 2>&1 | tee \"$RETRY_LOG\"; then\n      if grep -qiE '"
}

fn retry_eagain_seg_f() -> String {
  "' \"$RETRY_LOG\"; then\n        echo \"::warning::"
}

fn retry_eagain_seg_g() -> String {
  "\"\n        "
}

fn retry_eagain_seg_h() -> String {
  " || exit 1\n      else\n        exit 1\n      fi\n    fi\n    rm -f \"$RETRY_LOG\"\n  else\n    exit 1\n  fi\nfi\nrm -f \"$BUILD_LOG\"\n"
}

fn bash_env_binding_spelling(b: EnvBinding) -> String {
  match b {
    EnvSet { name: n, value: v } => concat(concat(n, "="), concat(v, " "))
    EnvUnset { name: n } => concat("env -u ", concat(n, " "))
  }
}

fn bash_env_prefix(env: FreeMonoid<EnvBinding>) -> String {
  fold_list(
    xs: env,
    empty: "",
    cons: fn(acc, b) { concat(acc, bash_env_binding_spelling(b: b)) }
  )
}

fn retry_eagain_bash_lex_for(tail_text: String, tail_class: Symbol) -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: retry_eagain_seg_a(), class: ^bash_token_retry_seg_a),
    span(text: retry_eagain_seg_b(), class: ^bash_token_retry_seg_b),
    span(text: retry_eagain_seg_c(), class: ^bash_token_retry_seg_c),
    span(text: retry_eagain_seg_d(), class: ^bash_token_retry_seg_d),
    span(text: retry_eagain_seg_e(), class: ^bash_token_retry_seg_e),
    span(text: retry_eagain_seg_f(), class: ^bash_token_retry_seg_f),
    span(text: retry_eagain_seg_g(), class: ^bash_token_retry_seg_g),
    span(text: tail_text, class: tail_class)
  ]))
}

fn orch_run_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^orch_run_rendered }
  ]
