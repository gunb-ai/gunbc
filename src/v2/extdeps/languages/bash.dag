    emitted: orch_run_emitted_command
  )
}

fn orch_run_binding_spellings(r: Run) -> Map<Symbol, String> {
  map_insert(empty_map(), ^orch_run_rendered, orch_run_rendered_spelling(r: r))
}

fn orch_run_target_model(r: Run) -> TargetModel {
  bash_make_bound_tokens_target_model(
    rules: orch_run_translation_rules_node(),
    source_literal: ^bash_orch_run_source_literal,
