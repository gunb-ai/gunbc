    FixedToken { token_class: ^bash_token_heredoc_kw },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_heredoc_path },
    FixedToken { token_class: ^bash_token_heredoc_dlt_open },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_heredoc_delim_open },
    FixedToken { token_class: ^bash_token_heredoc_nl1 },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_heredoc_body },
    FixedToken { token_class: ^bash_token_heredoc_nl2 },
