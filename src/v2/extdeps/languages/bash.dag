    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_andor_left },
    FixedToken { token_class: ^bash_token_andor_sp1 },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_andor_op },
    FixedToken { token_class: ^bash_token_andor_sp2 },
    BoundToken { token_class: ^bash_token_orch_raw, binding: ^bash_stmt_andor_right }
  ]
}

data bash_stmt_andor_emitted: Node = bash_conj_emitted_from_tokens(
  tokens: bash_stmt_andor_tokens()
)

fn bash_stmt_andor_source_text(left: String, op: String, right: String) -> String {
  concat(left, concat(" ", concat(op, concat(" ", right))))
}

fn bash_stmt_andor_lex() -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: " ", class: ^bash_token_andor_sp1),
    span(text: " ", class: ^bash_token_andor_sp2)
  ]))
}

fn bash_stmt_andor_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_stmt_andor,
    lhs: ^bash_production_stmt_andor,
    tokens: bash_stmt_andor_tokens(),
    emitted: bash_stmt_andor_emitted
  )
}

fn bash_stmt_andor_binding_spellings(left: String, op: String, right: String) -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^bash_stmt_andor_left, left),
      ^bash_stmt_andor_op, op
    ),
    ^bash_stmt_andor_right, right
  )
}

fn bash_stmt_andor_target_model(left: String, op: String, right: String) -> TargetModel {
  bash_make_bound_tokens_target_model(
    rules: bash_stmt_andor_translation_rules_node(),
    source_literal: ^bash_stmt_andor_source_literal,
    production_name: ^bash_production_stmt_andor,
    tokens: bash_stmt_andor_tokens(),
    source_text: bash_stmt_andor_source_text(left: left, op: op, right: right),
    lex: bash_stmt_andor_lex(),
    binding_spellings: bash_stmt_andor_binding_spellings(left: left, op: op, right: right)
  )
}

