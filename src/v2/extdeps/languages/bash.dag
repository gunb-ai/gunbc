// src/v2/extdeps/languages/bash.dag
// Scope: Bash (POSIX.1-2017 Shell Command Language) as a v2 emit TARGET — the 19th LanguageModel
// peer of rust/python/go/…, a TargetModel of translation rows consumed by the row-driven emit
// (DESIGN.md §4: `emit = serialize_target ∘ translate`, one grammar read backward). This is the
// authority that DISSOLVES the `extdeps/languages/bash/program.dag` sidecar serializer
// (`serialize_bash`): a transport authors INTENT and `emit(intent, Bash)` renders shell the same
// row-driven way `emit(intent, Rust)` already does — no per-language hand-rolled emitter.
//
// Anchor: https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html
//
// MIGRATION SLICE 1 — fixed-token command `'git' 'rev-parse' '--show-toplevel'` (landed #5155).
//
// MIGRATION SLICE 2 — bound-word emit-time quoting via `token_class_emit_transforms` on
// TargetModel (target_model.dag). Dynamic words (VarRef, Lit payloads) use BoundToken rows;
// POSIX single-quote / double-quoted var-ref wrapping runs at emit time keyed by token class.
//
// MIGRATION SLICE 3 — relocate source_root_ingest gate transport to v2.workflow
// (v2.workflow.source_root_ingest_transport); live path still serialize_bash today.
// Row-driven emit(byte-identity) is proven by bash_emit_source_root_ingest_gate_holds;
// emit(intent, Bash) flip for the live transport is a later slice in this arc.
//
// MIGRATION SLICE 4 — ShellStmt compound constructs (AndOr / Pipe / WithRedir) as translation
// rows. Byte-identical to serialize_bash for each fixture; witnesses in bash_emit_command_test.
//
// MIGRATION SLICE 5a — cross Arrow→Conj: Conj-positional emitted + FormalProduction flat rhs
// on the lhs-exact structural path (`derive_grammar_relation_row_node`); dissolves slice-4's
// `bash_fixed_tokens_grammar_relation_row` Arrow exact-equality scaffold.
// Next slices: If/Subshell/Heredoc → Assign/EnvPrefixed/Exit → migrate sidecar consumers →
// delete program.dag.
//
// v2-clean (no std.render / std.unicode imports) so witnesses execute under the v1 interpreter.

module v2.extdeps.languages.bash

import v2.std.algebra { Empty, fold_list, list_snoc_item }
import v2.std.diagnostic {
  Diagnostic,
  ExternalContractUnknown,
  Unavailable,
  node_locus
}
import v2.std.grammar {
  FormalGrammarSymbol,
  FormalProduction,
  GrammarExpr,
  Sequence,
  derive_grammar_relation_row_node,
  formal_production_for_lhs_exact,
  grammar_expr_terminal,
  grammar_formal_production,
  grammar_formal_terminal_bound,
  grammar_relation_tokens_node
}
import v2.std.compilers.lexing {
  LexRule,
  LexRuleSet,
  LexRules,
  LiteralPattern,
  ModeledLexRules,
  TokenRule
}
import v2.std.compilers.target_model {
  BoundToken,
  ConcreteSyntaxToken,
  FixedToken,
  TargetModel,
  target_model_emit_transforms_empty,
  target_model_make_with_emit_transforms,
  concrete_syntax_token_class,
  concrete_syntax_token_to_node
}
import v2.std.collection { List, Map, empty_map, list_nth, map_insert }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.witness { Holds, Violates, Witness }

// =========================================================================
// The emitted intent (the `translate`-side anchor).
//
// An Arrow of leaf-Atom children — one atom per command word. Arrow + leaf children means: (a)
// `translate`'s structure-preserving fold is identity (raw == node), and (b) the shape is NOT
// lhs-exact-supported, so the grammar relation row is selected by exact fixture equality on
// `grammar_relation_field_emitted` (06_translate.dag → grammar.dag
// grammar_relation_row_emitted_reverse_parse_matches, the Arrow fallback). This is the same emit
// anchor shape rust's mvp1 add-fn uses. The intent's *modeled* form (a real ShellStmt/Command
// vocabulary the transports lower from) is a later slice; here it is a synthetic rendering anchor.
// =========================================================================

fn bash_word_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

data bash_mvp1_emitted_command: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: bash_word_atom(id: ^bash_word_git) },
    Edge { label: Positional, target: bash_word_atom(id: ^bash_word_rev_parse) },
    Edge { label: Positional, target: bash_word_atom(id: ^bash_word_show_toplevel) }
  ],
  occurrence_id: SyntheticOccurrence
}

// The canonical shell text emit must produce (POSIX single-quoted words). Byte-identical to
// `serialize_bash(command([lit("git"), lit("rev-parse"), lit("--show-toplevel")]))`.
data bash_mvp1_source_text: String = "'git' 'rev-parse' '--show-toplevel'"

// =========================================================================
// Concrete tokens — every word a FixedToken (no bound/dynamic words in slice 1).
// =========================================================================

fn bash_mvp1_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_git },
    FixedToken { token_class: ^bash_token_word_rev_parse },
    FixedToken { token_class: ^bash_token_word_show_toplevel }
  ]
}

fn bash_concrete_token_node(token: ConcreteSyntaxToken) -> Node {
  // Serialize through the single shared morphism (no parallel wire authority).
  concrete_syntax_token_to_node(token: token)
}

fn bash_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

// =========================================================================
// Grammar relation row: emitted intent ⇄ concrete token sequence.
// =========================================================================

fn bash_grammar_command_expression() -> GrammarExpr {
  Sequence {
    left: Sequence {
      left: grammar_expr_terminal(token_class: ^bash_token_word_git),
      right: grammar_expr_terminal(token_class: ^bash_token_word_rev_parse)
    },
    right: grammar_expr_terminal(token_class: ^bash_token_word_show_toplevel)
  }
}

fn bash_grammar_production_command() -> GrammarProduction {
  GrammarProduction {
    name: ^bash_production_command,
    expression: bash_grammar_command_expression(),
    emitted: bash_word_atom(id: ^bash_surface_command)
  }
}

fn bash_grammar_relation_row_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: bash_grammar_production_command())
      ),
      bash_named_edge(name: ^grammar_relation_field_emitted, target: bash_mvp1_emitted_command),
      bash_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: bash_mvp1_concrete_tokens(),
          token_to_node: bash_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_mvp1_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^bash_relation_rule_command,
        target: bash_grammar_relation_row_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_bound_words_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^bash_relation_rule_bound_words,
        target: bash_bound_words_grammar_relation_row_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_embedded_quote_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^bash_relation_rule_embedded_quote_lit,
        target: bash_embedded_quote_grammar_relation_row_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// =========================================================================
// Slice 2 — bound words: VarRef double-quoted + Lit single-quoted at emit time.
// Byte-identical to serialize_bash(command([var_ref("ROOT"), lit("ROOT")])) => "$ROOT" 'ROOT'
// =========================================================================

data bash_bound_words_emitted_command: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: bash_word_atom(id: ^bash_binding_var_ROOT) },
    Edge { label: Positional, target: bash_word_atom(id: ^bash_binding_lit_ROOT) }
  ],
  occurrence_id: SyntheticOccurrence
}

data bash_bound_words_source_text: String = "\"$ROOT\" 'ROOT'"

fn bash_bound_words_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken { token_class: ^bash_token_var_ref, binding: ^bash_binding_var_ROOT },
    BoundToken { token_class: ^bash_token_lit_spaced, binding: ^bash_binding_lit_ROOT }
  ]
}

fn bash_bound_words_grammar_expression() -> GrammarExpr {
  Sequence {
    left: grammar_expr_terminal(token_class: ^bash_token_var_ref),
    right: grammar_expr_terminal(token_class: ^bash_token_lit_spaced)
  }
}

fn bash_bound_words_grammar_production() -> GrammarProduction {
  GrammarProduction {
    name: ^bash_production_bound_words,
    expression: bash_bound_words_grammar_expression(),
    emitted: bash_word_atom(id: ^bash_surface_bound_words)
  }
}

fn bash_bound_words_grammar_relation_row_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: bash_bound_words_grammar_production())
      ),
      bash_named_edge(
        name: ^grammar_relation_field_emitted,
        target: bash_bound_words_emitted_command
      ),
      bash_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: bash_bound_words_concrete_tokens(),
          token_to_node: bash_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// Single-word bound lit with an embedded single quote — total POSIX escaping.
data bash_embedded_quote_emitted_command: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: bash_word_atom(id: ^bash_binding_lit_a_quote_b) }
  ],
  occurrence_id: SyntheticOccurrence
}

data bash_embedded_quote_source_text: String = "'a'\\''b'"

fn bash_embedded_quote_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    BoundToken {
      token_class: ^bash_token_lit,
      binding: ^bash_binding_lit_a_quote_b
    }
  ]
}

fn bash_embedded_quote_grammar_production() -> GrammarProduction {
  GrammarProduction {
    name: ^bash_production_embedded_quote_lit,
    expression: grammar_expr_terminal(token_class: ^bash_token_lit),
    emitted: bash_word_atom(id: ^bash_surface_embedded_quote_lit)
  }
}

fn bash_embedded_quote_grammar_relation_row_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: bash_embedded_quote_grammar_production())
      ),
      bash_named_edge(
        name: ^grammar_relation_field_emitted,
        target: bash_embedded_quote_emitted_command
      ),
      bash_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: bash_embedded_quote_concrete_tokens(),
          token_to_node: bash_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// =========================================================================
// Slice 3 — source-root-ingest gate: fixed two-word Command.
// Byte-identical to serialize_bash(command([lit("bash"), lit("scripts/source-root-ingest-gate.sh")]))
// modulo the sidecar's trailing newline (immaterial to `sh -c`).
// =========================================================================

data bash_source_root_ingest_gate_emitted_command: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: bash_word_atom(id: ^bash_word_bash) },
    Edge {
      label: Positional,
      target: bash_word_atom(id: ^bash_word_source_root_ingest_gate_sh)
    }
  ],
  occurrence_id: SyntheticOccurrence
}

data bash_source_root_ingest_gate_source_text: String = "'bash' 'scripts/source-root-ingest-gate.sh'"

fn bash_source_root_ingest_gate_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_bash },
    FixedToken { token_class: ^bash_token_word_source_root_ingest_gate_sh }
  ]
}

fn bash_source_root_ingest_gate_grammar_expression() -> GrammarExpr {
  Sequence {
    left: grammar_expr_terminal(token_class: ^bash_token_word_bash),
    right: grammar_expr_terminal(token_class: ^bash_token_word_source_root_ingest_gate_sh)
  }
}

fn bash_source_root_ingest_gate_grammar_production() -> GrammarProduction {
  GrammarProduction {
    name: ^bash_production_source_root_ingest_gate,
    expression: bash_source_root_ingest_gate_grammar_expression(),
    emitted: bash_word_atom(id: ^bash_surface_source_root_ingest_gate)
  }
}

fn bash_source_root_ingest_gate_grammar_relation_row_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(
          production: bash_source_root_ingest_gate_grammar_production()
        )
      ),
      bash_named_edge(
        name: ^grammar_relation_field_emitted,
        target: bash_source_root_ingest_gate_emitted_command
      ),
      bash_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: bash_source_root_ingest_gate_concrete_tokens(),
          token_to_node: bash_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_source_root_ingest_gate_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^bash_relation_rule_source_root_ingest_gate,
        target: bash_source_root_ingest_gate_grammar_relation_row_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// =========================================================================
// Slice 4 — AndOr / Pipe / WithRedir (POSIX §2.9 lists / compound commands).
// Shared helpers: bash_arrow_emitted_from_words, bash_grammar_sequence_from_tokens.
// Each row is byte-identical to serialize_bash for the matching ShellStmt fixture.
// =========================================================================

fn bash_fixed_tokens_grammar_relation_row(
  production: GrammarProduction,
  emitted: Node,
  tokens: List<ConcreteSyntaxToken>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: production)
      ),
      bash_named_edge(name: ^grammar_relation_field_emitted, target: emitted),
      bash_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: tokens,
          token_to_node: bash_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_arrow_emitted_from_words(ids: List<Symbol>) -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: fold_list(
      xs: ids,
      empty: Empty,
      cons: fn(acc, sym) {
        list_snoc_item(
          xs: acc,
          item: Edge { label: Positional, target: bash_word_atom(id: sym) }
        )
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}

type BashGramSeqBuild
  = BashGramSeqInit
  | BashGramSeqReady { expr: GrammarExpr }

// Left-nested Sequence spine from a concrete-token row (shared by slice-4 fixtures).
fn bash_grammar_sequence_from_tokens(tokens: List<ConcreteSyntaxToken>) -> GrammarExpr {
  match fold_list(
    xs: tokens,
    empty: BashGramSeqInit,
    cons: fn(state, token) {
      match state {
        BashGramSeqInit =>
          BashGramSeqReady {
            expr: grammar_expr_terminal(
              token_class: concrete_syntax_token_class(token: token)
            )
          }
        BashGramSeqReady { expr: acc } =>
          BashGramSeqReady {
            expr: Sequence {
              left: acc,
              right: grammar_expr_terminal(
                token_class: concrete_syntax_token_class(token: token)
              )
            }
          }
      }
    }
  ) {
    BashGramSeqInit =>
      grammar_expr_terminal(token_class: ^bash_token_word_git)
    BashGramSeqReady { expr: result } => result
  }
}

// AndOr { AndThen } — `'true' && 'false'`
data bash_and_then_emitted: Node = bash_arrow_emitted_from_words(
  ids: [^bash_word_true, ^bash_surface_and_then, ^bash_word_false]
)

data bash_and_then_source_text: String = "'true' && 'false'"

fn bash_and_then_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_true },
    FixedToken { token_class: ^bash_token_and_then },
    FixedToken { token_class: ^bash_token_word_false }
  ]
}

fn bash_and_then_grammar_production() -> GrammarProduction {
  GrammarProduction {
    name: ^bash_production_and_then,
    expression: bash_grammar_sequence_from_tokens(tokens: bash_and_then_concrete_tokens()),
    emitted: bash_word_atom(id: ^bash_surface_and_then_stmt)
  }
}

fn bash_and_then_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^bash_relation_rule_and_then,
        target: bash_fixed_tokens_grammar_relation_row(
          production: bash_and_then_grammar_production(),
          emitted: bash_and_then_emitted,
          tokens: bash_and_then_concrete_tokens()
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// AndOr { OrElse } — `'true' || 'false'`
data bash_or_else_emitted: Node = bash_arrow_emitted_from_words(
  ids: [^bash_word_true, ^bash_surface_or_else, ^bash_word_false]
)

data bash_or_else_source_text: String = "'true' || 'false'"

fn bash_or_else_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_true },
    FixedToken { token_class: ^bash_token_or_else },
    FixedToken { token_class: ^bash_token_word_false }
  ]
}

fn bash_or_else_grammar_production() -> GrammarProduction {
  GrammarProduction {
    name: ^bash_production_or_else,
    expression: bash_grammar_sequence_from_tokens(tokens: bash_or_else_concrete_tokens()),
    emitted: bash_word_atom(id: ^bash_surface_or_else_stmt)
  }
}

fn bash_or_else_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^bash_relation_rule_or_else,
        target: bash_fixed_tokens_grammar_relation_row(
          production: bash_or_else_grammar_production(),
          emitted: bash_or_else_emitted,
          tokens: bash_or_else_concrete_tokens()
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// WithRedir { StderrToNull } — `'git' 'rev-parse' '--show-toplevel' 2>/dev/null`
data bash_with_redir_stderr_null_emitted: Node = bash_arrow_emitted_from_words(
  ids: [
    ^bash_word_git,
    ^bash_word_rev_parse,
    ^bash_word_show_toplevel,
    ^bash_surface_redir_stderr_null
  ]
)

data bash_with_redir_stderr_null_source_text: String = "'git' 'rev-parse' '--show-toplevel' 2>/dev/null"

fn bash_with_redir_stderr_null_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_git },
    FixedToken { token_class: ^bash_token_word_rev_parse },
    FixedToken { token_class: ^bash_token_word_show_toplevel },
    FixedToken { token_class: ^bash_token_redir_stderr_null }
  ]
}

fn bash_with_redir_stderr_null_grammar_production() -> GrammarProduction {
  GrammarProduction {
    name: ^bash_production_with_redir_stderr_null,
    expression: bash_grammar_sequence_from_tokens(
      tokens: bash_with_redir_stderr_null_concrete_tokens()
    ),
    emitted: bash_word_atom(id: ^bash_surface_with_redir_stderr_null)
  }
}

fn bash_with_redir_stderr_null_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^bash_relation_rule_with_redir_stderr_null,
        target: bash_fixed_tokens_grammar_relation_row(
          production: bash_with_redir_stderr_null_grammar_production(),
          emitted: bash_with_redir_stderr_null_emitted,
          tokens: bash_with_redir_stderr_null_concrete_tokens()
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// Pipe — `'echo' 'hi' | 'wc' '-c'`
data bash_pipe_emitted: Node = bash_arrow_emitted_from_words(
  ids: [
    ^bash_word_echo,
    ^bash_word_hi,
    ^bash_surface_pipe,
    ^bash_word_wc,
    ^bash_word_minus_c
