import v2.std.diagnostic { EmitDirective }
import v2.std.orchestration { EnvBinding, EnvSet, EnvUnset, Run }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}
import v2.std.witness { Holds, Violates, Witness }

fn bash_word_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_conj_emitted_from_tokens(tokens: List<ConcreteSyntaxToken>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: tokens,
      empty: Empty,
      cons: fn(acc, token) {
        match token {
          BoundToken { binding: binding, token_class: _ } =>
            list_snoc_item(
              xs: acc,
              item: Edge { label: Positional, target: bash_word_atom(id: binding) }
            )
          FixedToken { token_class: _ } => acc
        }
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_formal_symbol_from_token(token: ConcreteSyntaxToken) -> FormalGrammarSymbol {
  match token {
    FixedToken { token_class: c } => grammar_formal_terminal(identity: c)
    BoundToken { token_class: c, binding: b } =>
      grammar_formal_terminal_bound(identity: c, binding: b)
  }
}

fn bash_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(xs: acc, item: bash_formal_symbol_from_token(token: token))
    }
  )
}

fn bash_formal_production_from_fixture(
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>
) -> FormalProduction {
  grammar_formal_production(
    lhs: lhs,
    rhs: bash_formal_rhs_from_tokens(tokens: tokens)
  )
}

fn bash_lhs_exact_relation_row_witness(
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Witness<Node> {
  let production = bash_formal_production_from_fixture(lhs: lhs, tokens: tokens)
  let productions = [production]
  match formal_production_for_lhs_exact(
    productions: productions,
    lhs: lhs,
    child: emitted
  ) {
    Holds { value: selected } =>
      derive_grammar_relation_row_node(
        production: selected,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_empty_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_relation_translation_rules_witness(
  rule_name: Symbol,
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Witness<Node> {
  match bash_lhs_exact_relation_row_witness(
    lhs: lhs,
    tokens: tokens,
    emitted: emitted
  ) {
    Holds { value: row } =>
      Holds {
        value: Node {
          kind: TypeNode { connective: Conj },
          children: [
            bash_named_edge(name: rule_name, target: row)
          ],
          occurrence_id: SyntheticOccurrence
        }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn bash_relation_translation_rules_node(
  rule_name: Symbol,
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Node {
  match bash_relation_translation_rules_witness(
    rule_name: rule_name,
    lhs: lhs,
    tokens: tokens,
    emitted: emitted
  ) {
    Holds { value: rules } => rules
    Violates { diagnostic: _ } => bash_empty_translation_rules_node()
  }
}

fn bash_mvp1_phrase() -> LexicalPhrase {
  phrase([
    span(text: "'git'",             class: ^bash_token_word_git),
    span(text: " 'rev-parse'",      class: ^bash_token_word_rev_parse),
    span(text: " '--show-toplevel'", class: ^bash_token_word_show_toplevel)
  ])
}

fn bash_source_root_ingest_gate_phrase() -> LexicalPhrase {
  phrase([
    span(text: "'bash'",                              class: ^bash_token_word_bash),
    span(text: " 'scripts/source-root-ingest-gate.sh'", class: ^bash_token_word_source_root_ingest_gate_sh)
  ])
}

fn bash_and_then_phrase() -> LexicalPhrase {
  phrase([
    span(text: "'true'",  class: ^bash_token_word_true),
    span(text: " && ",    class: ^bash_token_and_then),
    span(text: "'false'", class: ^bash_token_word_false)
  ])
}

fn bash_or_else_phrase() -> LexicalPhrase {
  phrase([
    span(text: "'true'",  class: ^bash_token_word_true),
    span(text: " || ",    class: ^bash_token_or_else),
    span(text: "'false'", class: ^bash_token_word_false)
  ])
}

fn bash_with_redir_stderr_null_phrase() -> LexicalPhrase {
  phrase([
    span(text: "'git'",              class: ^bash_token_word_git),
    span(text: " 'rev-parse'",       class: ^bash_token_word_rev_parse),
    span(text: " '--show-toplevel'", class: ^bash_token_word_show_toplevel),
    span(text: " 2>/dev/null",       class: ^bash_token_redir_stderr_null)
  ])
}

fn bash_pipe_phrase() -> LexicalPhrase {
  phrase([
    span(text: "'echo'", class: ^bash_token_word_echo),
    span(text: " 'hi'",  class: ^bash_token_word_hi),
    span(text: " | ",    class: ^bash_token_pipe),
    span(text: "'wc'",   class: ^bash_token_word_wc),
    span(text: " '-c'",  class: ^bash_token_word_minus_c)
  ])
}

fn bash_or_else_with_redir_phrase() -> LexicalPhrase {
  phrase([
    span(text: "'git'",              class: ^bash_token_word_git),
    span(text: " 'rev-parse'",       class: ^bash_token_word_rev_parse),
    span(text: " '--show-toplevel'", class: ^bash_token_word_show_toplevel),
    span(text: " 2>/dev/null",       class: ^bash_token_redir_stderr_null),
    span(text: " || ",               class: ^bash_token_or_else),
    span(text: "'pwd'",              class: ^bash_token_word_pwd)
  ])
}

data bash_mvp1_source_text: String = phrase_to_source_text(p: bash_mvp1_phrase())

fn bash_mvp1_concrete_tokens() -> List<ConcreteSyntaxToken> {
  phrase_to_fixed_concrete_tokens(p: bash_mvp1_phrase())
}

data bash_mvp1_emitted_command: Node = bash_conj_emitted_from_tokens(
  tokens: bash_mvp1_concrete_tokens()
)

fn bash_concrete_token_node(token: ConcreteSyntaxToken) -> Node {

  concrete_syntax_token_to_node(token: token)
}

fn bash_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn bash_mvp1_translation_rules_node() -> Node {
  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_command,
    lhs: ^bash_production_command,
    tokens: bash_mvp1_concrete_tokens(),
    emitted: bash_mvp1_emitted_command
  )
}

