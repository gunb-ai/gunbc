  bash_relation_translation_rules_node(
    rule_name: ^bash_relation_rule_stmt_if,
    lhs: ^bash_production_stmt_if,
    tokens: bash_stmt_if_tokens(),
    emitted: bash_stmt_if_emitted
  )
}

