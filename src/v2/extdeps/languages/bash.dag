  tokens: orch_run_tokens()
)

fn orch_run_rendered_spelling(r: Run) -> String {
  concat(bash_env_prefix(env: r.env), r.command)
}

fn orch_run_source_text(r: Run) -> String {
  orch_run_rendered_spelling(r: r)
}

fn orch_run_lex(r: Run) -> LexRules {
  phrase_to_lex_rules(p: phrase([
    span(text: orch_run_rendered_spelling(r: r), class: ^bash_token_orch_raw)
  ]))
}

