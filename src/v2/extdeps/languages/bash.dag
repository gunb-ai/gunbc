// src/v2/extdeps/languages/bash.dag
// Scope: Bash (POSIX.1-2017 Shell Command Language) as a v2 emit TARGET — the 19th LanguageModel
// peer of rust/python/go/…, a TargetModel of translation rows consumed by the row-driven emit
// (DESIGN.md §4: `emit = serialize_target ∘ translate`, one grammar read backward). This is the
// authority that DISSOLVES the `extdeps/languages/bash/program.dag` sidecar serializer
// (`serialize_bash`): a transport authors INTENT and `emit(intent, Bash)` renders shell the same
// row-driven way `emit(intent, Rust)` already does — no per-language hand-rolled emitter.
//
// Anchor: https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html
//
// MIGRATION SLICE 1 (this file) — the minimal proof that `emit(_, Bash)` renders real shell through
// the existing pipeline with ZERO substrate change: a single fixed command
//   'git' 'rev-parse' '--show-toplevel'
// emitted from a synthetic intent node, every word a single-quoted FixedToken. The quoting +
// adjacent layout are baked into each token's `LiteralPattern.text` (the same interim
// layout-in-literal policy rust uses, e.g. "fn " not "fn"; see rust.dag T-6 TokenLayout). This
// matches `serialize_bash`'s `single_quote` output for fixed words byte-for-byte (POSIX §2.2.2:
// inside single quotes every character is literal).
//
// 🟡 SCOPED FOLLOW-ON (slice 2, may touch load-bearing substrate — design carefully / escalate):
// BOUND words (a dynamic value — a variable path, a user-supplied argument) cannot pre-bake quotes,
// so the `single_quote` wrapper (with the canonical `'\''` escape for an embedded `'`) needs a home
// as an emit-time spelling transform keyed by token class — single-quoting is NOT a lex
// *recognition* concern today (lex rules are ingest patterns; `token_spelling_from_model` reads
// `LiteralPattern.text` verbatim). That wrapper, then growing rows to cover the ShellWord/ShellStmt
// surface, then migrating the 7 sidecar consumers, then deleting program.dag — the full arc.
//
// v2-clean (no std.render / std.unicode imports) so witnesses execute under the v1 interpreter.

module v2.extdeps.languages.bash

import v2.std.grammar {
  GrammarExpr,
  GrammarProduction,
  Sequence,
  grammar_expr_terminal,
  grammar_production_to_node,
  grammar_relation_tokens_node
}
import v2.std.compilers.lexing {
  LexRule,
  LexRuleSet,
  LexRules,
  LiteralPattern,
  ModeledLexRules,
  TokenRule
}
import v2.std.compilers.target_model {
  ConcreteSyntaxToken,
  FixedToken,
  TargetModel,
  concrete_syntax_token_to_node
}
import v2.std.collection { List, empty_map }
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node {
  Arrow,
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Positional,
  Symbol,
  SyntheticOccurrence,
  TypeNode
}

// =========================================================================
// The emitted intent (the `translate`-side anchor).
//
// An Arrow of leaf-Atom children — one atom per command word. Arrow + leaf children means: (a)
// `translate`'s structure-preserving fold is identity (raw == node), and (b) the shape is NOT
// lhs-exact-supported, so the grammar relation row is selected by exact fixture equality on
// `grammar_relation_field_emitted` (06_translate.dag → grammar.dag
// grammar_relation_row_emitted_reverse_parse_matches, the Arrow fallback). This is the same emit
// anchor shape rust's mvp1 add-fn uses. The intent's *modeled* form (a real ShellStmt/Command
// vocabulary the transports lower from) is a later slice; here it is a synthetic rendering anchor.
// =========================================================================

fn bash_word_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

data bash_mvp1_emitted_command: Node = Node {
  kind: TypeNode { connective: Arrow },
  children: [
    Edge { label: Positional, target: bash_word_atom(id: ^bash_word_git) },
    Edge { label: Positional, target: bash_word_atom(id: ^bash_word_rev_parse) },
    Edge { label: Positional, target: bash_word_atom(id: ^bash_word_show_toplevel) }
  ],
  occurrence_id: SyntheticOccurrence
}

// The canonical shell text emit must produce (POSIX single-quoted words). Byte-identical to
// `serialize_bash(command([lit("git"), lit("rev-parse"), lit("--show-toplevel")]))`.
data bash_mvp1_source_text: String = "'git' 'rev-parse' '--show-toplevel'"

// =========================================================================
// Concrete tokens — every word a FixedToken (no bound/dynamic words in slice 1).
// =========================================================================

fn bash_mvp1_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^bash_token_word_git },
    FixedToken { token_class: ^bash_token_word_rev_parse },
    FixedToken { token_class: ^bash_token_word_show_toplevel }
  ]
}

fn bash_concrete_token_node(token: ConcreteSyntaxToken) -> Node {
  // Serialize through the single shared morphism (no parallel wire authority).
  concrete_syntax_token_to_node(token: token)
}

fn bash_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

// =========================================================================
// Grammar relation row: emitted intent ⇄ concrete token sequence.
// =========================================================================

fn bash_grammar_command_expression() -> GrammarExpr {
  Sequence {
    left: Sequence {
      left: grammar_expr_terminal(token_class: ^bash_token_word_git),
      right: grammar_expr_terminal(token_class: ^bash_token_word_rev_parse)
    },
    right: grammar_expr_terminal(token_class: ^bash_token_word_show_toplevel)
  }
}

fn bash_grammar_production_command() -> GrammarProduction {
  GrammarProduction {
    name: ^bash_production_command,
    expression: bash_grammar_command_expression(),
    emitted: bash_word_atom(id: ^bash_surface_command)
  }
}

fn bash_grammar_relation_row_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: bash_grammar_production_command())
      ),
      bash_named_edge(name: ^grammar_relation_field_emitted, target: bash_mvp1_emitted_command),
      bash_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: bash_mvp1_concrete_tokens(),
          token_to_node: bash_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn bash_mvp1_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^bash_relation_rule_command,
        target: bash_grammar_relation_row_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// serialize_source — the grammar-inverse path (06_translate.dag grammar_inverse_source_validated)
// reads this edge and asserts its token targets are byte-identical to the relation row's, so the
// SAME `grammar_relation_tokens_node` builder feeds both (no second token authority). All-Named Conj
// so `well_formed` passes (Conj-requires-named is strict). The source_text/source_grammar atoms are
// liveness anchors pairing the emitted text with its production, mirroring rust's mvp1.
fn bash_mvp1_serialize_source_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^serialize_source_field_source_text,
        target: bash_word_atom(id: ^bash_mvp1_source_literal)
      ),
      bash_named_edge(
        name: ^serialize_source_field_source_grammar,
        target: bash_word_atom(id: ^bash_production_command)
      ),
      bash_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: bash_mvp1_concrete_tokens(),
          token_to_node: bash_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// Emit bundle. `translation_rules` (the row `emit` matches + serializes) + `serialize_source` (the
// grammar-inverse validator). No `target_model_edge_type_expression_projection` edge — the bundle
// reads as ProjectionAbsent so `translate_node` takes the mvp1 grammar-match path (06_translate.dag),
// and the Arrow emitted node is `TypeExprKindNotEmitted` (the grammar-inverse serialize branch).
// Coercion/ingest edges (selection_policy, declared_inhabitants) are not exercised by emit and are
// deliberately omitted from slice 1.
fn bash_mvp1_target_model_bundle() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      bash_named_edge(
        name: ^target_model_edge_translation_rules,
        target: bash_mvp1_translation_rules_node()
      ),
      bash_named_edge(
        name: ^target_model_edge_serialize_source,
        target: bash_mvp1_serialize_source_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

// =========================================================================
// Lex — POSIX single-quoting + token-adjacent layout baked into each literal (interim policy,
// dissolves with rust.dag's T-6 TokenLayout). `'git'` then ` 'rev-parse'` then ` '--show-toplevel'`
// concatenate to the canonical source text.
// =========================================================================

fn bash_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn bash_mvp1_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      bash_lex_rule(token_class: ^bash_token_word_git, text: "'git'"),
      bash_lex_rule(token_class: ^bash_token_word_rev_parse, text: " 'rev-parse'"),
      bash_lex_rule(token_class: ^bash_token_word_show_toplevel, text: " '--show-toplevel'")
    ]
  }
}

fn bash_mvp1_lex() -> LexRules {
  ModeledLexRules { root: bash_mvp1_lex_rules() }
}

fn bash_mvp1_target_model() -> TargetModel {
  TargetModel {
    bundle: bash_mvp1_target_model_bundle(),
    lex: bash_mvp1_lex(),
    binding_spellings: empty_map(),
    authority_source_text: bash_mvp1_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}
