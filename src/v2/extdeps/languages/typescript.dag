fn ts_sg2_arrow_mixed_wire_emitted() -> v2.std.node.Node {
  let golden = ts_sg2_arrow_xy_emitted()
  v2.std.node.Node {
    kind: golden.kind,
    children: v2.std.algebra.list_snoc_item(
      xs: golden.children,
      item: ts_named_edge(
        name: ^target_type_expr_field_codomain,
        target: v2.std.compilers.target_model.target_type_expr_atom_emitted(
          form: ts_type_expression_projection().atom_form,
          identity: ^ts_binding_sg2_y
        )
      )
    ),
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_sg2_arrow_source_type_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: ts_sg2_atom_node(binding: ^ts_binding_sg2_x) },
      v2.std.node.Edge { label: v2.std.node.Positional, target: ts_sg2_atom_node(binding: ^ts_binding_sg2_y) }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_sg2_binary_fn_source_type_node() -> v2.std.node.Node {
  v2.std.algebra.algebra_binary_fn_node(
    domain: ts_sg2_atom_node(binding: ^ts_binding_sg2_x),
    codomain: ts_sg2_atom_node(binding: ^ts_binding_sg2_y)
  )
}

fn ts_sg2_arrow_malformed_source_type_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: ts_sg2_atom_node(binding: ^ts_binding_sg2_x) }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_sg2_conj_xy_emitted() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_type_expr_record_emitted(
    form: ts_type_expression_projection().conj_form,
    fields: [
      v2.std.compilers.target_model.TargetTypeExprFieldSlot {
        label: ^ts_binding_sg2_x,
        type_expr: v2.std.compilers.target_model.target_type_expr_atom_emitted(
          form: ts_type_expression_projection().atom_form,
          identity: ^ts_binding_sg2_x
        )
      },
      v2.std.compilers.target_model.TargetTypeExprFieldSlot {
        label: ^ts_binding_sg2_y,
        type_expr: v2.std.compilers.target_model.target_type_expr_atom_emitted(
          form: ts_type_expression_projection().atom_form,
          identity: ^ts_binding_sg2_y
        )
      }
    ]
  )
}

fn ts_sg2_conj_source_type_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ts_named_edge(name: ^ts_binding_sg2_x, target: ts_sg2_atom_node(binding: ^ts_binding_sg2_x)),
      ts_named_edge(name: ^ts_binding_sg2_y, target: ts_sg2_atom_node(binding: ^ts_binding_sg2_y))
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_sg2_sum_xy_emitted() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_type_expr_sum_emitted(
    form: ts_type_expression_projection().disj_form,
    variants: [
      v2.std.compilers.target_model.TargetTypeExprVariantSlot {
        label: ^ts_binding_sg2_x,
        type_expr: v2.std.compilers.target_model.target_type_expr_atom_emitted(
          form: ts_type_expression_projection().atom_form,
          identity: ^ts_binding_sg2_x
        )
      },
      v2.std.compilers.target_model.TargetTypeExprVariantSlot {
        label: ^ts_binding_sg2_y,
        type_expr: v2.std.compilers.target_model.target_type_expr_atom_emitted(
          form: ts_type_expression_projection().atom_form,
          identity: ^ts_binding_sg2_y
        )
      }
    ]
  )
}

fn ts_sg2_disj_source_type_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Disj },
    children: [
      ts_named_edge(name: ^ts_binding_sg2_x, target: ts_sg2_atom_node(binding: ^ts_binding_sg2_x)),
      ts_named_edge(name: ^ts_binding_sg2_y, target: ts_sg2_atom_node(binding: ^ts_binding_sg2_y))
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_task_target_model_bundle_witness() -> v2.std.witness.Witness<v2.std.node.Node> {
  match ts_translation_rules_witness() {
    Holds { value: rules } =>
      match ts_task_serialize_source_witness() {
        Holds { value: serialize } =>
          v2.std.witness.Holds {
            value: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
              children: [
                ts_named_edge(
                  name: ^target_model_edge_selection_policy,
                  target: ts_inhabitant_number_node()
                ),
                ts_named_edge(
                  name: ^target_model_edge_declared_inhabitants,
                  target: ts_add_declared_inhabitants_root()
                ),
                ts_named_edge(
                  name: ^target_model_edge_translation_rules,
                  target: rules
                ),
                ts_named_edge(
                  name: ^target_model_edge_serialize_source,
                  target: serialize
                )
              ],
              occurrence_id: v2.std.node.SyntheticOccurrence
}
          }
        Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn ts_task_target_model_witness() -> v2.std.witness.Witness<v2.std.compilers.target_model.TargetModel> {
  match ts_task_target_model_bundle_witness() {
    Holds { value: bundle } =>
      v2.std.witness.Holds {
        value: v2.std.compilers.target_model.TargetModel {
          produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
          bundle: bundle,
          lex: ts_lex(),
          binding_spellings: ts_binding_spellings(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
          authority_source_text: ts_task_type_alias_source_text,
          runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
        }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn ts_fn_add_target_model() -> v2.std.node.Node {
  ts_target_atom_realization_target_model_node()
}

fn ts_lex_rule(token_class: v2.std.node.Symbol, text: String) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: token_class,
    pattern: v2.std.compilers.lexing.LiteralPattern { text: text }
  }
}

fn ts_ident_lex_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentStartChar },
    right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentContinueChar } }
  }
}

fn ts_ident_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^ts_token_ident,
    pattern: ts_ident_lex_pattern()
  }
}

fn ts_fn_add_lex_rules() -> v2.std.compilers.lexing.LexRuleSet {
  v2.std.compilers.lexing.LexRuleSet {
    rules: [
      ts_lex_rule(token_class: ^ts_token_kw_function, text: "function "),
      ts_lex_rule(token_class: ^ts_token_kw_return, text: "return "),
      ts_ident_lex_rule(),
      ts_lex_rule(token_class: ^ts_token_ty_number, text: "number"),
      ts_lex_rule(token_class: ^ts_token_plus, text: " + "),
      ts_lex_rule(token_class: ^ts_token_lbrace, text: " { "),
      ts_lex_rule(token_class: ^ts_token_rbrace, text: " }"),
      ts_lex_rule(token_class: ^ts_token_lparen, text: "("),
      ts_lex_rule(token_class: ^ts_token_rparen, text: ")"),
      ts_lex_rule(token_class: ^ts_token_comma, text: ", "),
      ts_lex_rule(token_class: ^ts_token_colon, text: ": "),
      ts_lex_rule(token_class: ^ts_token_dot, text: "."),
      ts_lex_rule(token_class: ^ts_token_semicolon, text: ";"),
      ts_lex_rule(token_class: ^ts_token_effect_read_callee, text: "__gunbc_effect_read"),
      ts_lex_rule(token_class: ^ts_token_effect_write_callee, text: "__gunbc_effect_write"),
      ts_lex_rule(token_class: ^ts_token_kw_true, text: "true"),
      ts_lex_rule(token_class: ^ts_token_kw_false, text: "false"),
      ts_lex_rule(token_class: ^ts_token_ternary_nop, text: ""),
      ts_lex_rule(token_class: ^ts_token_ternary_question, text: " ? "),
      ts_lex_rule(token_class: ^ts_token_ternary_colon, text: " : ")
    ]
  }
}

fn ts_fn_add_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules { root: ts_fn_add_lex_rules() }
}

fn ts_grammar_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  ts_inhabitant_atom(id: id)
}

fn ts_grammar_production_fn_add() -> v2.std.grammar.GrammarProduction {
  v2.std.grammar.GrammarProduction {
    name: ^ts_production_fn_add,
    expression: ts_grammar_sequence_from_token_classes(),
    emitted: ts_grammar_atom(id: ^ts_surface_fn_item)
  }
}

fn ts_fn_add_grammar_root() -> v2.std.grammar.GrammarRoot {
  let start = ts_grammar_production_fn_add()
  v2.std.grammar.GrammarRoot { start: ^ts_production_fn_add, productions: [start], sync_tokens: v2.std.grammar.grammar_empty_sync_tokens() }
}

fn ts_fn_add_grammar() -> v2.std.grammar.ParseGrammar {
  v2.std.grammar.ModeledGrammar { root: ts_fn_add_grammar_root() }
}

fn ts_fn_add_lex_token_symbol(sym: v2.std.node.Symbol) -> Bool {
  sym == ^ts_token_kw_function ||
    sym == ^ts_token_kw_return ||
    sym == ^ts_token_ident ||
    sym == ^ts_token_ty_number ||
    sym == ^ts_token_plus ||
    sym == ^ts_token_lbrace ||
    sym == ^ts_token_rbrace ||
    sym == ^ts_token_lparen ||
    sym == ^ts_token_rparen ||
    sym == ^ts_token_comma ||
    sym == ^ts_token_colon ||
    sym == ^ts_token_semicolon
}

fn ts_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  sym == ts_facts_boolean.surface_spelling ||
  v2.std.algebra.fold_list(
    xs: ts_numeric_facts_catalog,
    empty: false,
    cons: fn(acc, row) {
      acc || sym == match row {
        TsNumericFactsNumber { facts: f } => f.surface_spelling
        TsNumericFactsBigInt { facts: f } => f.surface_spelling
      }
    }
  )
}

fn ts_language_model_canonical_symbols() -> Set<v2.std.node.Symbol> {
  std.types.Set {
    member: fn(sym) {
      ts_catalog_surface_symbol(sym: sym) ||
        ts_fn_add_lex_token_symbol(sym: sym) ||
        sym == ^ts_surface_fn_item ||
        sym == ^ts_production_fn_add ||
        sym == ^ts_source_literal
    }
  }
}

fn ts_number_spec_facts(facts: TsNumberPrimitiveFacts) -> Map<v2.std.node.Symbol, v2.std.node.Node> {
  std.types.Map {
    lookup: fn(axis) {
      if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}) {
          v2.std.optional.Present { value: ts_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisWidth {}) {
          v2.std.optional.Present { value: ts_inhabitant_atom(id: ^ts_tag_bits64) }
      } else if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) {
          v2.std.optional.Present { value: ts_inhabitant_atom(id: facts.ieee754_binary) }
      } else {
          v2.std.optional.Absent
      }
    }
  }
}

fn ts_bigint_spec_facts(facts: TsBigIntPrimitiveFacts) -> Map<v2.std.node.Symbol, v2.std.node.Node> {
  std.types.Map {
    lookup: fn(axis) {
      if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}) {
          v2.std.optional.Present { value: ts_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) {
          v2.std.optional.Present { value: ts_inhabitant_atom(id: facts.encoding) }
      } else {
          v2.std.optional.Absent
      }
    }
  }
}

fn ts_bool_spec_facts(facts: TsBooleanPrimitiveFacts) -> Map<v2.std.node.Symbol, v2.std.node.Node> {
  std.types.Map {
    lookup: fn(axis) {
      if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisSurfaceSpelling {}) {
          v2.std.optional.Present { value: ts_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: v2.std.model_core.ModelCoreFactAxisEncoding {}) {
          v2.std.optional.Present { value: ts_inhabitant_atom(id: facts.encoding) }
      } else {
          v2.std.optional.Absent
      }
    }
  }
}

fn ts_primitive_bundle_from_number_facts(facts: TsNumberPrimitiveFacts) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: ts_number_facts_node(facts: facts),
    spec_facts: ts_number_spec_facts(facts: facts)
  }
}

fn ts_primitive_bundle_from_bigint_facts(facts: TsBigIntPrimitiveFacts) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: ts_bigint_facts_node(facts: facts),
    spec_facts: ts_bigint_spec_facts(facts: facts)
  }
}

fn ts_primitive_bundle_from_bool_facts(facts: TsBooleanPrimitiveFacts) -> v2.std.model_core.PrimitiveFactBundle {
  v2.std.model_core.PrimitiveFactBundle {
    substrate_carrier: ts_bool_facts_node(facts: facts),
    spec_facts: ts_bool_spec_facts(facts: facts)
  }
}

fn ts_numeric_primitive_fact_bundles() -> List<v2.std.model_core.PrimitiveFactBundle> {
  v2.std.algebra.fold_list(
    xs: ts_numeric_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, row) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: match row {
          TsNumericFactsNumber { facts: f } =>
            ts_primitive_bundle_from_number_facts(facts: f)
          TsNumericFactsBigInt { facts: f } =>
            ts_primitive_bundle_from_bigint_facts(facts: f)
        }
      )
    }
  )
}

fn ts_number_primitive_fact_bundles() -> List<v2.std.model_core.PrimitiveFactBundle> {
  v2.std.algebra.list_snoc_item(
    xs: ts_numeric_primitive_fact_bundles(),
    item: ts_primitive_bundle_from_bool_facts(facts: ts_facts_boolean)
  )
}

fn ts_number_algebra_witness_node(facts: TsNumberPrimitiveFacts) -> v2.std.node.Node {
  ts_primitive_algebra_witness_node(
    witness_field_name: ^ts_witness_number_approximate_field,
    witness_tag: ^ts_witness_number_approximate_field,
    middle_field_name: ^ts_facts_field_ieee754_binary,
    middle_field_target: ts_inhabitant_atom(id: facts.ieee754_binary),
    std_projection_field_name: ^facts_field_std_projection,
    std_projection: facts.std_projection
  )
}

fn ts_bigint_algebra_witness_node(facts: TsBigIntPrimitiveFacts) -> v2.std.node.Node {
  ts_primitive_algebra_witness_node(
    witness_field_name: ^ts_witness_bigint_ordered_ring,
    witness_tag: ^ts_witness_bigint_ordered_ring,
    middle_field_name: ^ts_facts_field_operation_semantics,
    middle_field_target: ts_bigint_operation_semantics_node(),
    std_projection_field_name: ^facts_field_std_projection,
    std_projection: facts.std_projection
  )
}

fn ts_bool_algebra_witness_node() -> v2.std.node.Node {
  ts_primitive_algebra_witness_node(
    witness_field_name: ^ts_witness_bool_boolean_algebra,
    witness_tag: ^ts_witness_bool_boolean_algebra,
    middle_field_name: ^ts_facts_field_encoding,
    middle_field_target: ts_inhabitant_atom(id: ts_facts_boolean.encoding),
    std_projection_field_name: ^ts_facts_field_std_projection,
    std_projection: ts_facts_boolean.std_projection
  )
}

fn ts_number_algebra_inhabitance(facts: TsNumberPrimitiveFacts) -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = ts_number_inhabitant_node(id: ^ts_inhabitant_number, facts: facts)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: v2.std.algebra.approximate_field_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: ts_number_algebra_witness_node(facts: facts)
  }
}

fn ts_bigint_algebra_inhabitance(facts: TsBigIntPrimitiveFacts) -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = ts_bigint_inhabitant_node(id: ^ts_inhabitant_bigint, facts: facts)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: v2.std.algebra.ordered_ring_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: ts_bigint_algebra_witness_node(facts: facts)
  }
}

fn ts_bool_algebra_inhabitance() -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = ts_inhabitant_boolean_node()
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: v2.std.algebra.boolean_algebra_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: ts_bool_algebra_witness_node()
  }
}

data ts_number_algebra_inhabitance_ts_facts_number: v2.std.model_core.AlgebraInhabitanceDecl = ts_number_algebra_inhabitance(facts: ts_facts_number)
data ts_bigint_algebra_inhabitance_ts_facts_bigint: v2.std.model_core.AlgebraInhabitanceDecl = ts_bigint_algebra_inhabitance(facts: ts_facts_bigint)

data ts_bool_algebra_inhabitance_ts_facts_boolean: v2.std.model_core.AlgebraInhabitanceDecl = ts_bool_algebra_inhabitance()

fn ts_target_atom_type_form(spelling: v2.std.node.Symbol) -> v2.std.compilers.target_model.TargetTypeExpression {
  v2.std.compilers.target_model.target_atom_alias_type_expression(
    spelling: spelling,
    atom_form: ts_type_expression_projection().atom_form
  )
}

data ts_target_atom_realization_symbol: v2.std.compilers.target_model.TargetAtomRealization = v2.std.compilers.target_model.TargetAtomRealization {
  source_carrier: v2.std.compilers.target_model.symbol_kernel_type_node(),
  target_model: ts_target_atom_realization_target_model_staging(),
  type_form: ts_target_atom_type_form(spelling: ^ts_surface_spelling_symbol),
  value_form: v2.std.compilers.target_model.target_value_template_for_kind(kind: v2.std.compilers.target_model.ValueSymbolIdentityPassthrough),
  constructor_form: v2.std.optional.optional_absent(),
  display_name: ^symbol_kernel_type_atom
}

fn ts_numeric_algebra_inhabitance_step(
  acc: List<v2.std.model_core.AlgebraInhabitanceDecl>,
  row: TsEcma262NumericPrimitiveFactsUnion
) -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  match row {
    TsNumericFactsNumber { facts: f } =>
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: ts_number_algebra_inhabitance(facts: f)
      )
    TsNumericFactsBigInt { facts: f } =>
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: ts_bigint_algebra_inhabitance(facts: f)
      )
  }
}

fn ts_numeric_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  v2.std.algebra.fold_list(
    xs: ts_numeric_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, row) {
      ts_numeric_algebra_inhabitance_step(acc: acc, row: row)
    }
  )
}

fn ts_bool_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  [
    ts_bool_algebra_inhabitance()
  ]
}

fn ts_model_core_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  v2.std.algebra.list_append(
    left: ts_numeric_algebra_inhabitance_decls(),
    right: ts_bool_algebra_inhabitance_decls()
  )
}

fn ts_number_model_core() -> v2.std.model_core.ModelCore {
  v2.std.model_core.ModelCore {
    primitives: ts_number_primitive_fact_bundles(),
    inhabitance: ts_model_core_inhabitance_decls(),
    laws: [],
    effects: v2.std.model_core.EffectSemanticsDecl { operations: [] },
    partiality: v2.std.model_core.PartialitySemanticsDecl { operations: [] }
  }
}

fn ts_fn_add_language_model() -> v2.std.language_model.LanguageModel {
  v2.std.language_model.LanguageModel {
    language_identity: ^ts_language_model_surface_id,
    canonical_symbols: ts_language_model_canonical_symbols(),
    core: ts_number_model_core(),
    lex: ts_fn_add_lex(),
    grammar: ts_fn_add_grammar()
  }
}

fn ts_num_lit_lex_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.DigitChar } }
}

fn ts_num_lit_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule { token_class: ^ts_token_num_lit, pattern: ts_num_lit_lex_pattern() }
}

fn ts_string_lit_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^ts_token_string_lit,
    pattern: v2.std.compilers.lexing.DelimitedPattern {
      open: v2.std.compilers.lexing.LiteralPattern { text: "'" },
      body: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.StringTextChar } },
      close: v2.std.compilers.lexing.LiteralPattern { text: "'" }
    }
  }
}

fn ts_lex_rules() -> v2.std.compilers.lexing.LexRuleSet {
  v2.std.compilers.lexing.LexRuleSet {
    rules: [
      ts_lex_rule(token_class: ^ts_token_kw_function, text: "function "),
      ts_lex_rule(token_class: ^ts_token_kw_return, text: "return "),
      ts_lex_rule(token_class: ^ts_token_kw_let, text: "let "),
      ts_lex_rule(token_class: ^ts_token_kw_const, text: "const "),
      ts_lex_rule(token_class: ^ts_token_kw_type, text: "type "),
      ts_lex_rule(token_class: ^ts_token_kw_true, text: "true"),
      ts_lex_rule(token_class: ^ts_token_kw_false, text: "false"),
      ts_ident_lex_rule(),
      ts_lex_rule(token_class: ^ts_token_ty_number, text: "number"),
      ts_lex_rule(token_class: ^ts_token_ty_string, text: "string"),
      ts_lex_rule(token_class: ^ts_token_ty_boolean, text: "boolean"),
      ts_lex_rule(token_class: ^ts_token_ty_void, text: "void"),
      ts_num_lit_lex_rule(),
      ts_lex_rule(token_class: ^ts_token_plus, text: " + "),
      ts_lex_rule(token_class: ^ts_token_minus, text: " - "),
      ts_lex_rule(token_class: ^ts_token_star, text: " * "),

      ts_lex_rule(token_class: ^ts_token_eq, text: " ="),
      ts_lex_rule(token_class: ^ts_token_pipe, text: " | "),
      ts_string_lit_lex_rule(),
      ts_lex_rule(token_class: ^ts_token_lbrace, text: " { "),
      ts_lex_rule(token_class: ^ts_token_rbrace, text: " }"),
      ts_lex_rule(token_class: ^ts_token_lparen, text: "("),
      ts_lex_rule(token_class: ^ts_token_rparen, text: ")"),
      ts_lex_rule(token_class: ^ts_token_lbracket, text: "["),
      ts_lex_rule(token_class: ^ts_token_rbracket, text: "]"),
      ts_lex_rule(token_class: ^ts_token_comma, text: ", "),
      ts_lex_rule(token_class: ^ts_token_colon, text: ": "),
      ts_lex_rule(token_class: ^ts_token_semicolon, text: ";"),
      ts_lex_rule(token_class: ^ts_token_kw_import, text: "import "),
      ts_lex_rule(token_class: ^ts_token_kw_from, text: "from "),
      ts_lex_rule(token_class: ^ts_token_import_lbrace, text: "{ "),
      ts_lex_rule(token_class: ^ts_token_import_rbrace, text: " } "),
      ts_lex_rule(token_class: ^ts_token_module_quote, text: "\""),
      ts_lex_rule(token_class: ^ts_token_module_path_sep, text: "/")
    ]
  }
}

fn ts_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules { root: ts_lex_rules() }
}

fn ts_lex_token_symbol(sym: v2.std.node.Symbol) -> Bool {
  v2.std.compilers.lexing.lex_rule_set_token_class_member(rules: ts_lex_rules(), token_class: sym)
}

fn ts_formal_grammar_symbol_from_token(token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> v2.std.grammar.FormalGrammarSymbol {
  match token {
    FixedToken { token_class: c } => v2.std.grammar.grammar_formal_terminal(identity: c)
    BoundToken { token_class: c, binding: b } => v2.std.grammar.grammar_formal_terminal_bound(identity: c, binding: b)
  }
}

fn ts_formal_rhs_from_tokens(tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>) -> List<v2.std.grammar.FormalGrammarSymbol> {
  v2.std.algebra.fold_list(
    xs: tokens,
    empty: std.algebra.Empty,
    cons: fn(acc, token) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: ts_formal_grammar_symbol_from_token(token: token)
      )
    }
  )
}

fn ts_formal_production_fn_add() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^ts_production_fn_add,
    rhs: ts_formal_rhs_from_tokens(tokens: ts_canonical_add_fn_tokens())
  )
}

