data ts_host_transport_harness_suffix: String = "
const __gunbc_r = add(2, 3);
const __gunbc_b = Buffer.alloc(4);
__gunbc_b.writeInt32LE(__gunbc_r, 0);
process.stdout.write(__gunbc_b);
"

fn ts_host_transport_descriptor() -> v2.std.host_transport.HostTransportDescriptor {
  v2.std.host_transport.HostTransportDescriptor {
    identity: ^ts_host_transport_identity,
    workspace: [
      v2.std.host_transport.WorkspaceFile {
        path: "fixture.ts",
        content: v2.std.host_transport.EmittedWithSuffix { suffix: ts_host_transport_harness_suffix }
      }
    ],
    build: [
      v2.std.host_transport.ProcessInvocation {
        program: v2.std.host_transport.HostToolProgram { executable: "npx" },
        args: [
          v2.std.host_transport.LiteralArg { text: "-y" },
          v2.std.host_transport.LiteralArg { text: "typescript@5.9.2" },
          v2.std.host_transport.LiteralArg { text: "tsc" },
          v2.std.host_transport.LiteralArg { text: "--target" },
          v2.std.host_transport.LiteralArg { text: "ES2022" },
          v2.std.host_transport.LiteralArg { text: "--module" },
          v2.std.host_transport.LiteralArg { text: "commonjs" },
          v2.std.host_transport.LiteralArg { text: "--outDir" },
          v2.std.host_transport.LiteralArg { text: "." },
          v2.std.host_transport.LiteralArg { text: "fixture.ts" }
        ]
      }
    ],
    run: v2.std.host_transport.ProcessInvocation {
      program: v2.std.host_transport.HostToolProgram { executable: "node" },
      args: [v2.std.host_transport.ProducedArtifact { path: "fixture.js" }]
    },
    runtime_value_codec: v2.std.host_transport.SignedI32Le
  }
}

