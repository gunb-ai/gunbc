    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^ts_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_colon },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_ty_number },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_rparen },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_colon },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_ty_number },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_lbrace },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_kw_return },
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^ts_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_semicolon },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_rbrace }
  ]
}

