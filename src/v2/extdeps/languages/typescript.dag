data ts_host_transport_mvp1_harness_suffix: String = "
const __gunbc_r = add(2, 3);
const __gunbc_b = Buffer.alloc(4);
__gunbc_b.writeInt32LE(__gunbc_r, 0);
process.stdout.write(__gunbc_b);
"

fn ts_host_transport_mvp1_descriptor() -> HostTransportDescriptor {
  HostTransportDescriptor {
    identity: ^ts_host_transport_mvp1_identity,
    workspace: [
      WorkspaceFile {
        path: "fixture.ts",
        content: EmittedWithSuffix { suffix: ts_host_transport_mvp1_harness_suffix }
      }
    ],
    build: [
      ProcessInvocation {
        tool: ^host_tool_npx,
        args: [
          LiteralArg { text: "-y" },
          LiteralArg { text: "typescript@5.9.2" },
          LiteralArg { text: "tsc" },
          LiteralArg { text: "--target" },
          LiteralArg { text: "ES2022" },
          LiteralArg { text: "--module" },
          LiteralArg { text: "commonjs" },
          LiteralArg { text: "--outDir" },
          LiteralArg { text: "." },
          LiteralArg { text: "fixture.ts" }
        ]
      }
    ],
    run: ProcessInvocation {
      tool: ^host_tool_node,
      args: [ProducedArtifact { path: "fixture.js" }]
    },
    runtime_value_codec: SignedI32Le
  }
}

