module v2.extdeps.languages.typescript


type TsNumberPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  ieee754_binary: v2.std.node.Symbol
  std_projection: v2.std.node.Symbol
}

type TsBigIntPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  std_projection: v2.std.node.Symbol
  encoding: v2.std.node.Symbol
}

type TsBooleanPrimitiveFacts {
  surface_spelling: v2.std.node.Symbol
  std_projection: v2.std.node.Symbol
  encoding: v2.std.node.Symbol
}

type TsEcma262NumericPrimitiveFactsUnion
  = TsNumericFactsNumber { facts: TsNumberPrimitiveFacts }
  | TsNumericFactsBigInt { facts: TsBigIntPrimitiveFacts }

type TsGrammarRelationRow {
  production: v2.std.grammar.FormalProduction
  emitted: v2.std.node.Node
  tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
}

data ts_task_type_alias_source_text: String = "type Task = { id: TaskId, title: string, status: TaskStatus };"
data ts_pr3_identity_source_text: String = "function identity(x: number): number { return x; }"
data ts_source_text: String = "function add(x: number, y: number): number { return x + y; }"

data ts_facts_number: TsNumberPrimitiveFacts = TsNumberPrimitiveFacts {
  surface_spelling: ^ts_surface_spelling_number,
  ieee754_binary: ^ts_ieee754_binary64,
  std_projection: ^std_projection_additive_numeric,
}

data ts_facts_bigint: TsBigIntPrimitiveFacts = TsBigIntPrimitiveFacts {
  surface_spelling: ^ts_surface_spelling_bigint,
  std_projection: ^ts_std_projection_bigint,
  encoding: ^ts_repr_bigint_exact_unbounded,
}

data ts_facts_boolean: TsBooleanPrimitiveFacts = TsBooleanPrimitiveFacts {
  surface_spelling: ^ts_surface_spelling_boolean,
  std_projection: ^ts_std_projection_bool,
  encoding: ^ts_repr_boolean_ecma_boolean,
}

data ts_bool_grounding: std.algebra.BooleanAlgebra<Bool> = v2.std.logic.bool_boolean_algebra

data ts_numeric_facts_catalog: List<TsEcma262NumericPrimitiveFactsUnion> = [
  TsNumericFactsNumber { facts: ts_facts_number },
  TsNumericFactsBigInt { facts: ts_facts_bigint }
]

fn ts_inhabitant_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: target }
}

fn ts_primitive_algebra_witness_node(
  witness_field_name: v2.std.node.Symbol,
  witness_tag: v2.std.node.Symbol,
  middle_field_name: v2.std.node.Symbol,
  middle_field_target: v2.std.node.Node,
  std_projection_field_name: v2.std.node.Symbol,
  std_projection: v2.std.node.Symbol
) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ts_named_edge(
        name: witness_field_name,
        target: ts_inhabitant_atom(id: witness_tag)
      ),
      ts_named_edge(
        name: middle_field_name,
        target: middle_field_target
      ),
      ts_named_edge(
        name: std_projection_field_name,
        target: ts_inhabitant_atom(id: std_projection)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
  }
}

fn ts_number_arithmetic_semantics_node() -> v2.std.node.Node {
  ts_inhabitant_atom(id: ^ts_tag_number_ieee754_binary64)
}

fn ts_number_bitwise_semantics_node() -> v2.std.node.Node {
  ts_inhabitant_atom(id: ^ts_tag_number_bitwise_int32_uint32)
}

fn ts_bigint_operation_semantics_node() -> v2.std.node.Node {
  ts_inhabitant_atom(id: ^ts_tag_bigint_exact_unbounded)
}

fn ts_bool_operation_semantics_node(facts: TsBooleanPrimitiveFacts) -> v2.std.node.Node {
  ts_inhabitant_atom(id: facts.encoding)
}

fn ts_number_facts_node(facts: TsNumberPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ts_named_edge(
        name: ^ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ^ts_facts_field_arithmetic_semantics,
        target: ts_number_arithmetic_semantics_node()
      ),
      ts_named_edge(
        name: ^ts_facts_field_bitwise_semantics,
        target: ts_number_bitwise_semantics_node()
      ),
      ts_named_edge(
        name: ^ts_facts_field_width,
        target: ts_inhabitant_atom(id: ^ts_tag_bits64)
      ),
      ts_named_edge(
        name: ^ts_facts_field_ieee754_binary,
        target: ts_inhabitant_atom(id: facts.ieee754_binary)
      ),
      ts_named_edge(
        name: ^facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_bigint_facts_node(facts: TsBigIntPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ts_named_edge(
        name: ^ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ^ts_facts_field_operation_semantics,
        target: ts_bigint_operation_semantics_node()
      ),
      ts_named_edge(
        name: ^facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      ),
      ts_named_edge(
        name: ^ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: facts.encoding)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_bool_facts_node(facts: TsBooleanPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ts_named_edge(
        name: ^ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ^ts_facts_field_operation_semantics,
        target: ts_bool_operation_semantics_node(facts: facts)
      ),
      ts_named_edge(
        name: ^facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      ),
      ts_named_edge(
        name: ^ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: facts.encoding)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_number_inhabitant_node(id: v2.std.node.Symbol, facts: TsNumberPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ts_named_edge(name: ^ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ^ts_inhabitant_field_facts,
        target: ts_number_facts_node(facts: facts)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_bigint_inhabitant_node(id: v2.std.node.Symbol, facts: TsBigIntPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ts_named_edge(name: ^ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ^ts_inhabitant_field_facts,
        target: ts_bigint_facts_node(facts: facts)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_bool_inhabitant_node(id: v2.std.node.Symbol, facts: TsBooleanPrimitiveFacts) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ts_named_edge(name: ^ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ^ts_inhabitant_field_facts,
        target: ts_bool_facts_node(facts: facts)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_inhabitant_number_node() -> v2.std.node.Node {
  ts_number_inhabitant_node(id: ^ts_inhabitant_number, facts: ts_facts_number)
}

fn ts_inhabitant_bigint_node() -> v2.std.node.Node {
  ts_bigint_inhabitant_node(id: ^ts_inhabitant_bigint, facts: ts_facts_bigint)
}

fn ts_inhabitant_boolean_node() -> v2.std.node.Node {
  ts_bool_inhabitant_node(id: ^ts_inhabitant_boolean, facts: ts_facts_boolean)
}

fn ts_declared_inhabitants_root() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ts_named_edge(name: ^ts_inhabitant_field_number, target: ts_inhabitant_number_node()),
      ts_named_edge(name: ^ts_inhabitant_field_bigint, target: ts_inhabitant_bigint_node()),
      ts_named_edge(name: ^ts_inhabitant_field_boolean, target: ts_inhabitant_boolean_node())
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_number_zip_fold_closure_edges() -> List<v2.std.node.Edge> {
  [
    ts_named_edge(
      name: ^ts_inhabitant_field_add_fn,
      target: ts_emitted_add_fn_node()
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_inhabitant_atom,
      target: ts_inhabitant_atom(id: ^ts_inhabitant_number)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_facts,
      target: ts_number_facts_node(facts: ts_facts_number)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_spelling,
      target: ts_inhabitant_atom(id: ^ts_surface_spelling_number)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_arithmetic,
      target: ts_number_arithmetic_semantics_node()
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_bitwise,
      target: ts_number_bitwise_semantics_node()
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_width,
      target: ts_inhabitant_atom(id: ^ts_tag_bits64)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_ieee754,
      target: ts_inhabitant_atom(id: ^ts_ieee754_binary64)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_std_projection,
      target: ts_inhabitant_atom(id: ^std_projection_additive_numeric)
    )
  ]
}

fn ts_coercion_candidate_edges() -> List<v2.std.node.Edge> {
  v2.std.algebra.list_append(
    left: ts_declared_inhabitants_root().children,
    right: ts_number_zip_fold_closure_edges()
  )
}

fn ts_add_declared_inhabitants_root() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: ts_coercion_candidate_edges(),
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_selection_policy_node() -> v2.std.node.Node {
  ts_inhabitant_number_node()
}

fn ts_emitted_add_fn_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: ts_inhabitant_number_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: ts_inhabitant_number_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: ts_inhabitant_number_node() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}


// Delimiting discipline for this target. ts_token_kw_then named a THEN KEYWORD
// TYPESCRIPT DOES NOT HAVE: the shape was a copy of .dag's ML-style
// if/then/else, and none of its three tokens had a lex rule, so nothing ever
// executed it and nothing caught the fiction. TypeScript's if/else is a
// statement; the conditional operator is its value form, and it is
// self-delimiting -- `c ? a : b` ends with its else arm. No value-producing
// loop either, so loop_token stays unspelled and the loop form refuses.
fn ts_value_expression_projection() -> v2.std.compilers.target_model.TargetValueExpressionProjection {
  ts_value_expression_projection_full(
    record_literal_names_type: v2.std.compilers.target_model.Omit,
    block_evaluation_mode: ts_block_evaluation_mode()
  )
}

fn ts_module_projection() -> v2.std.compilers.target_model.TargetModuleProjection {
  v2.std.compilers.target_model.TargetModuleProjection {
    import_form: v2.std.compilers.target_model.EsModuleImport {
      import_token: ^ts_token_kw_import,
      names_open: ^ts_token_import_lbrace,
      names_separator: ^ts_token_comma,
      names_close: ^ts_token_import_rbrace,
      from_token: ^ts_token_kw_from,
      path_open: ^ts_token_module_quote,
      path_segment_separator: ^ts_token_module_path_sep,
      path_close: ^ts_token_module_quote,
      terminator: ^ts_token_semicolon,
      name_ident_token: ^ts_token_ident,
      path_segment_token: ^ts_token_module_path_segment
    }
  }
}

fn ts_value_expression_projection_with_record_literal_naming(
  record_literal_names_type: v2.std.compilers.target_model.RecordLiteralTypeNaming
) -> v2.std.compilers.target_model.TargetValueExpressionProjection {
  ts_value_expression_projection_full(
    record_literal_names_type: record_literal_names_type,
    block_evaluation_mode: ts_block_evaluation_mode()
  )
}

fn ts_value_expression_projection_with_block_evaluation_mode(
  block_evaluation_mode: v2.std.compilers.target_model.BlockEvaluationMode
) -> v2.std.compilers.target_model.TargetValueExpressionProjection {
  ts_value_expression_projection_full(
    record_literal_names_type: v2.std.compilers.target_model.Omit,
    block_evaluation_mode: block_evaluation_mode
  )
}

fn ts_value_expression_projection_full(
  record_literal_names_type: v2.std.compilers.target_model.RecordLiteralTypeNaming,
  block_evaluation_mode: v2.std.compilers.target_model.BlockEvaluationMode
) -> v2.std.compilers.target_model.TargetValueExpressionProjection {
  v2.std.compilers.target_model.TargetValueExpressionProjection {
    binding_ref_form: v2.std.compilers.target_model.TargetBindingRefShape { ident_token: ^ts_token_ident },
    primitive_apply_form: v2.std.compilers.target_model.TargetPrimitiveApplyShape {
      open: ^ts_token_lparen,
      close: ^ts_token_rparen,
      separator: ^ts_token_comma
    },
    callable_apply_form: v2.std.compilers.target_model.TargetCallApplyShape {
      callee_ident_token: ^ts_token_ident,
      open: ^ts_token_lparen,
      separator: ^ts_token_comma,
      close: ^ts_token_rparen
    },

    closure_form: v2.std.compilers.target_model.TargetClosureShape {
      fn_token: ^ts_token_kw_function,
      open: ^ts_token_lparen,
      separator: ^ts_token_comma,
      close: ^ts_token_rparen,
      body_open: ^ts_token_lbrace,
      body_close: ^ts_token_rbrace,
      param_ident_token: ^ts_token_ident
    },

    effect_apply_form: v2.std.compilers.target_model.TargetEffectApplyShape {
      callees: [
        v2.std.compilers.target_model.TargetEffectCalleeRow {
          effect_kind: ^ReadResource,
          callee: ^ts_token_effect_read_callee
        },
        v2.std.compilers.target_model.TargetEffectCalleeRow {
          effect_kind: ^WriteResource,
          callee: ^ts_token_effect_write_callee
        }
      ],
      open: ^ts_token_lparen,
      close: ^ts_token_rparen,
      separator: ^ts_token_comma
    },

    conditional_form: v2.std.compilers.target_model.TargetConditionalShape {
      if_token: ^ts_token_ternary_nop,
      then_token: ^ts_token_ternary_question,
      else_token: ^ts_token_ternary_colon,
      delimiting: v2.std.compilers.target_model.ConditionalSelfDelimiting
    },

    let_form: v2.std.compilers.target_model.TargetBindLetShape {
      let_token: ^ts_token_kw_let,
      assign_token: ^ts_token_eq,
      in_token: ^ts_token_unwired_bind_in
    },
    loop_form: v2.std.compilers.target_model.TargetLoopShape {
      loop_token: ^ts_token_unwired_loop
    },

    record_construct_form: v2.std.compilers.target_model.TargetRecordConstructShape {
      open: ^ts_token_lbrace,
      close: ^ts_token_rbrace,
      separator: ^ts_token_comma,
      assign: ^ts_token_colon,
      record_literal_names_type: record_literal_names_type
    },
    field_access_form: v2.std.compilers.target_model.TargetFieldAccessShape {
      dot: ^ts_token_dot
    },
    match_form: v2.std.compilers.target_model.TargetMatchShape {
      match_token: ^ts_token_unwired_match,
      scrutinee_open: ^ts_token_lparen,
      scrutinee_close: ^ts_token_rparen,
      open: ^ts_token_lbrace,
      close: ^ts_token_rbrace,
      fat_arrow: ^ts_token_fat_arrow,
      arm_separator: ^ts_token_comma
    },
    bool_literal_form: v2.std.compilers.target_model.TargetBoolLiteralShape {
      true_token: ^ts_token_kw_true,
      false_token: ^ts_token_kw_false
    },
    block_evaluation_mode: block_evaluation_mode
  }
}

fn ts_add_operator_realization_row() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_operator_realization_node(
    operation: v2.std.compilers.target_model.canonical_operation_op_add(),
    shape: v2.std.compilers.target_model.InfixToken { token: ^ts_token_plus }
  )
}

fn ts_operator_realizations_catalog_node() -> v2.std.node.Node {
  v2.std.compilers.target_model.target_operator_realizations_catalog_node(rows: [ts_add_operator_realization_row()])
}

fn ts_block_evaluation_mode() -> v2.std.compilers.target_model.BlockEvaluationMode {
  v2.std.compilers.target_model.StatementSequenced {
    return_token: ^ts_token_kw_return,
    statement_terminator: ^ts_token_semicolon
  }
}

fn ts_add_signature_with_open() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_kw_function },
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^ts_binding_fn_add },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_lparen },
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^ts_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_colon },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_ty_number },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_comma },
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^ts_binding_param_y },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_colon },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_ty_number },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_rparen },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_colon },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_ty_number },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_lbrace }
  ]
}

fn ts_add_block_close() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_rbrace }
  ]
}

fn ts_bodied_arrow_statement_scaffold() -> v2.std.compilers.target_model.TargetBodiedArrowStatementScaffold {
  v2.std.compilers.target_model.derive_bodied_arrow_scaffold(
    signature_with_open: ts_add_signature_with_open(),
    block_close: ts_add_block_close(),
    mode: ts_block_evaluation_mode()
  )
}

fn ts_fn_add_statement_prefix_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  let scaffold = ts_bodied_arrow_statement_scaffold()
  scaffold.prefix
}

fn ts_fn_add_statement_suffix_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  let scaffold = ts_bodied_arrow_statement_scaffold()
  scaffold.suffix
}

fn ts_compose_add_fn_tokens(body_tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>) -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  v2.std.algebra.list_append(
    left: v2.std.algebra.list_append(
      left: ts_fn_add_statement_prefix_tokens(),
      right: body_tokens
    ),
    right: ts_fn_add_statement_suffix_tokens()
  )
}

fn ts_source_text_authority() -> String {
  ts_source_text
}

fn ts_concrete_token_node(token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> v2.std.node.Node {

  v2.std.compilers.target_model.concrete_syntax_token_to_node(token: token)
}

fn ts_serialize_source_prefix_edges() -> List<v2.std.node.Edge> {
  [
    ts_named_edge(
      name: ^serialize_source_field_source_text,
      target: ts_inhabitant_atom(id: ^ts_source_literal)
    ),
    ts_named_edge(
      name: ^serialize_source_field_source_grammar,
      target: ts_inhabitant_atom(id: ^ts_production_fn_add)
    )
  ]
}

fn ts_serialize_source_children() -> List<v2.std.node.Edge> {
  v2.std.algebra.list_append(
    left: ts_serialize_source_prefix_edges(),
    right: [
      ts_named_edge(
        name: ^grammar_relation_field_tokens,
        target: v2.std.grammar.grammar_relation_tokens_node(
          tokens: ts_canonical_add_fn_tokens(),
          token_to_node: ts_concrete_token_node
        )
      )
    ]
  )
}

fn ts_serialize_source_node() -> v2.std.node.Node {
  let _authority = ts_source_text_authority()
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: ts_serialize_source_children(),
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ts_grammar_terminal(token_class: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Terminal { token_class: token_class, stamp: v2.std.grammar.StampClass }
}

type TsGramBuild1State
  = TsGramBuild1StateInit
  | TsGramBuild1StateReady { expr: v2.std.grammar.GrammarExpr }

fn ts_grammar_sequence_from_token_classes() -> v2.std.grammar.GrammarExpr {
  match v2.std.algebra.fold_list(
    xs: ts_canonical_add_fn_tokens(),
    empty: TsGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        TsGramBuild1StateInit =>
          TsGramBuild1StateReady {
            expr: ts_grammar_terminal(token_class: v2.std.compilers.target_model.concrete_syntax_token_class(token: token))
          }
        TsGramBuild1StateReady { expr: acc } =>
          TsGramBuild1StateReady {
            expr: v2.std.grammar.Sequence {
              left: acc,
              right: ts_grammar_terminal(token_class: v2.std.compilers.target_model.concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    TsGramBuild1StateInit =>
      ts_grammar_terminal(token_class: ^ts_token_kw_function)
    TsGramBuild1StateReady { expr: result } => result
  }
}

fn ts_grammar_relation_row() -> TsGrammarRelationRow {
  TsGrammarRelationRow {
    production: ts_formal_production_fn_add(),
    emitted: ts_emitted_add_fn_node(),
    tokens: ts_canonical_add_fn_tokens()
  }
}

fn ts_add_return_body_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  [
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_x },
    v2.std.compilers.target_model.FixedToken { token_class: ^ts_token_plus },
    v2.std.compilers.target_model.BoundToken { token_class: ^ts_token_ident, binding: ^dag_binding_param_y }
  ]
}

fn ts_canonical_add_fn_tokens() -> List<v2.std.compilers.target_model.ConcreteSyntaxToken> {
  ts_compose_add_fn_tokens(body_tokens: ts_add_return_body_tokens())
}

fn ts_fn_add_bodied_relation_row_node() -> v2.std.node.Node {
  v2.std.compilers.target_model.grammar_relation_row_attach_bodied_scaffold(
