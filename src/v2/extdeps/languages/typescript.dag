        left: v2.std.grammar.Terminal { token_class: ^ts_token_ident, stamp: v2.std.grammar.StampClass },
        right: v2.std.grammar.Sequence {
          left: v2.std.grammar.Terminal { token_class: ^ts_token_eq, stamp: v2.std.grammar.StampClass },
          right: v2.std.grammar.Sequence {
            left: v2.std.grammar.Nonterminal { production: ^ts_production_type_annotation },
            right: v2.std.grammar.Terminal { token_class: ^ts_token_semicolon, stamp: v2.std.grammar.StampClass }
          }
        }
      }
    },
    emitted: ts_grammar_atom(id: ^ts_surface_type_alias_decl)
  }
}

