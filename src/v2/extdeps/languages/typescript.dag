fn ts_task_formal_productions() -> List<v2.std.grammar.FormalProduction> {
  [
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_type_string,
      rhs: [v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_ty_string)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_type_annotation,
      rhs: [v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_ty_string)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_type_annotation,
      rhs: [v2.std.grammar.grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_type_task_id)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_type_annotation,
      rhs: [v2.std.grammar.grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_type_task_status)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_type_annotation,
      rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_record_type)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_record_field,
      rhs: [
        v2.std.grammar.grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_field_id),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_colon),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_type_annotation)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_record_field,
      rhs: [
        v2.std.grammar.grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_field_title),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_colon),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_type_annotation)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_record_field,
      rhs: [
        v2.std.grammar.grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_field_status),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_colon),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_type_annotation)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_record_fields,
      rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_record_field)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_record_fields,
      rhs: [
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_record_fields),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_comma),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_record_field)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_record_type,
      rhs: [
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_lbrace),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_record_fields),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_rbrace)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_type_alias_decl,
      rhs: [
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_kw_type),
        v2.std.grammar.grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_task),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_eq),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_type_annotation),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_semicolon)
      ]
    )
  ]
}

fn ts_task_type_alias_relation_row_witness() -> v2.std.witness.Witness<v2.std.node.Node> {
  ts_eager_grammar_relation_row_witness(lhs: ^ts_production_type_alias_decl)
}

fn ts_task_serialize_source_children() -> List<v2.std.node.Edge> {
  [
    ts_named_edge(
      name: ^serialize_source_field_source_text,
      target: ts_inhabitant_atom(id: ^ts_task_type_alias_source_literal)
    ),
    ts_named_edge(
      name: ^serialize_source_field_source_grammar,
      target: ts_inhabitant_atom(id: ^ts_production_type_alias_decl)
    )
  ]
}

fn ts_grammar_relation_row_token_edges_witness(row: v2.std.node.Node) -> v2.std.witness.Witness<List<v2.std.node.Edge>> {
  match v2.std.node_query.find_named_child(root: row, name: ^grammar_relation_field_tokens) {
    Accepted { value: tokens_root, diagnostics: _ } =>
      match tokens_root.kind {
        TypeNode { connective: v2.std.node.Conj } => v2.std.witness.Holds { value: tokens_root.children }
        _ =>
          v2.std.witness.Violates {
            diagnostic: v2.std.diagnostic.Diagnostic {
              reason: ^grammar_relation_row_tokens_not_conj,
              at: v2.std.diagnostic.node_locus(node: tokens_root),
              correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
            }
          }
      }
    Rejected { diagnostics: nd } => v2.std.witness.Violates { diagnostic: nd.head }
  }
}

fn ts_task_serialize_source_witness() -> v2.std.witness.Witness<v2.std.node.Node> {
  match ts_task_type_alias_relation_row_witness() {
    Holds { value: row } =>
      match ts_grammar_relation_row_token_edges_witness(row: row) {
        Holds { value: token_edges } =>
          v2.std.witness.Holds {
            value: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
              children: v2.std.algebra.list_append(
                left: ts_task_serialize_source_children(),
                right: token_edges
              ),
              occurrence_id: v2.std.node.SyntheticOccurrence
}
          }
        Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

