      v2.std.node.Edge {
        label: v2.std.node.Positional,
        target: ts_record_fields_pair_emitted(
          left: ts_record_fields_pair_emitted(
            left: ts_record_fields_single_emitted(
              field: ts_record_field_emitted(
                field_binding: ^ts_binding_field_id,
                type_child: ts_type_annotation_name_emitted(binding: ^ts_binding_type_task_id)
              )
            ),
            right: ts_record_field_emitted(
              field_binding: ^ts_binding_field_title,
              type_child: ts_field_type_string_emitted()
            )
          ),
          right: ts_record_field_emitted(
            field_binding: ^ts_binding_field_status,
            type_child: ts_type_annotation_name_emitted(binding: ^ts_binding_type_task_status)
          )
