fn ts_wave2a_grammar_root() -> GrammarRoot {
  let mvp1 = ts_grammar_production_mvp1_fn_add()
  let ty_num = ts_grammar_production_wave2a_type_number()
  let ty_str = ts_grammar_production_wave2a_type_string()
  let ty_bool = ts_grammar_production_wave2a_type_boolean()
  let ty_void = ts_grammar_production_wave2a_type_void()
  let ty_name = ts_grammar_production_wave2a_type_name()
  let rec_field = ts_grammar_production_wave2a_record_field()
  let rec_fields = ts_grammar_production_wave2a_record_fields()
  let rec_type = ts_grammar_production_wave2a_record_type()
  let type_annot = ts_grammar_production_wave2a_type_annotation()
  let let_decl = ts_grammar_production_wave2a_let_decl()
  let const_decl = ts_grammar_production_wave2a_const_decl()
  let type_alias_decl = ts_grammar_production_wave2a_type_alias_decl()
  let union_type = ts_grammar_production_wave2a_union_type()
  let pr3_primary_type = ts_grammar_production_pr3_primary_type()
  let pr3_array_type = ts_grammar_production_pr3_array_type()
  let pr3_typed_param = ts_grammar_production_pr3_typed_param()
  let pr3_typed_params = ts_grammar_production_pr3_typed_params()
  let pr3_typed_params_opt = ts_grammar_production_pr3_typed_params_opt()
  let pr3_typed_fn_decl = ts_grammar_production_pr3_typed_fn_decl()
  let item = ts_grammar_production_wave2a_item()
  GrammarRoot {
    start: ^ts_production_wave2a_item,
    productions: [mvp1, ty_num, ty_str, ty_bool, ty_void, ty_name, rec_field, rec_fields, rec_type, union_type, type_annot, let_decl, const_decl, type_alias_decl, pr3_primary_type, pr3_array_type, pr3_typed_param, pr3_typed_params, pr3_typed_params_opt, pr3_typed_fn_decl, item],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn ts_wave2a_grammar() -> ParseGrammar {
  ModeledGrammar { root: ts_wave2a_grammar_root() }
}

fn ts_language_model_canonical_symbols_wave2a() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      ts_catalog_surface_symbol(sym: sym) ||
        ts_wave2a_lex_token_symbol(sym: sym) ||
        grammar_carries_symbol(grammar: ts_wave2a_grammar(), sym: sym) ||
        sym == ^ts_mvp1_source_literal
    }
  }
}

fn ts_language_model_wave2a() -> LanguageModel {
  LanguageModel {
    language_identity: ^ts_language_model_surface_id,
    canonical_symbols: ts_language_model_canonical_symbols_wave2a(),
    core: ts_model_core_wave1(),
    lex: ts_wave2a_lex(),
    grammar: ts_wave2a_grammar()
  }
}

type TsStringPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
  code_unit_inhabitant: Symbol
}
data ts_facts_string: TsStringPrimitiveFacts = TsStringPrimitiveFacts {
  surface_spelling: ^ts_surface_spelling_string,
  encoding: ^ts_repr_string_utf16_code_unit_sequence,
  std_projection: ^ts_std_projection_string,
  code_unit_inhabitant: ^ts_inhabitant_utf16_code_unit
}

fn ts_string_facts_node(facts: TsStringPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ^ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ^ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: facts.encoding)
      ),
      ts_named_edge(
        name: ^facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_string_inhabitant_node(id: Symbol, facts: TsStringPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ^ts_inhabitant_field_string, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(name: ^ts_facts_field_encoding, target: ts_inhabitant_atom(id: facts.encoding)),
      ts_named_edge(
        name: ^ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_string_algebra_witness_node(facts: TsStringPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ^ts_witness_string_free_monoid,
        target: ts_inhabitant_atom(id: ^ts_witness_string_free_monoid)
      ),
      ts_named_edge(
        name: ^ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: facts.encoding)
      ),
      ts_named_edge(
        name: ^facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_string_algebra_inhabitance(facts: TsStringPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = ts_string_inhabitant_node(id: ^ts_inhabitant_string, facts: facts)
  let code_unit = ts_inhabitant_atom(id: facts.code_unit_inhabitant)
  AlgebraInhabitanceDecl {
    algebra: free_monoid_type_node(inhabitant: code_unit),
    inhabitant: inhabitant,
    witness: ts_string_algebra_witness_node(facts: facts)
  }
}

data ts_string_algebra_inhabitance_ts_facts_string: AlgebraInhabitanceDecl = ts_string_algebra_inhabitance(facts: ts_facts_string)

fn ts_string_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  [
    ts_string_algebra_inhabitance(facts: ts_facts_string)
  ]
}

fn ts_model_core_inhabitance_decls_wave2b() -> List<AlgebraInhabitanceDecl> {
  list_append(
    left: ts_model_core_inhabitance_decls(),
    right: ts_string_algebra_inhabitance_decls()
  )
}

fn ts_string_spec_facts(facts: TsStringPrimitiveFacts) -> Map<Symbol, Node> {
  let m0 = empty_map()
  let m1 = map_insert(
    m: m0,
    key: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}),
    value: ts_inhabitant_atom(id: facts.surface_spelling)
  )
  let m2 = map_insert(
    m: m1,
    key: discriminant(v: ModelCoreFactAxisEncoding {}),
    value: ts_inhabitant_atom(id: facts.encoding)
  )
  m2
}

fn ts_primitive_bundle_from_string_facts(facts: TsStringPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: ts_string_facts_node(facts: facts),
    spec_facts: ts_string_spec_facts(facts: facts)
  }
}

fn ts_wave2b_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  list_append(
    left: ts_wave1_primitive_fact_bundles(),
    right: [ts_primitive_bundle_from_string_facts(facts: ts_facts_string)]
  )
}

fn ts_g14_grounding_target_model() -> TargetModel {
  ts_sg2_type_expr_target_model()
}

fn ts_insert_per_language_primitive_axis(
  registry: PerLanguageFactBundleRegistry,
  subject: Node,
  target: TargetModel,
  axis: ModelCorePrimitiveFactAxis,
  value: Node
) -> Outcome<PerLanguageFactBundleRegistry> {
  insert_per_language_fact_bundle_entry(
    registry: registry,
    key: PerLanguageFactBundleKey {
      subject_carrier: subject,
      target: target,
      fact_axis: axis
    },
    fact_value: value
  )
}

fn ts_build_per_language_fact_bundle_registry() -> Outcome<PerLanguageFactBundleRegistry> {
  let target = ts_g14_grounding_target_model()
  let number_subject = ts_number_facts_node(facts: ts_facts_number)
  let bigint_subject = ts_bigint_facts_node(facts: ts_facts_bigint)
  let bool_subject = ts_bool_facts_node(facts: ts_facts_boolean)
  let string_subject = ts_string_facts_node(facts: ts_facts_string)
  match ts_insert_per_language_primitive_axis(
    registry: empty_per_language_fact_bundle_registry(),
    subject: number_subject,
    target: target,
    axis: ModelCoreFactAxisSurfaceSpelling {},
    value: ts_inhabitant_atom(id: ts_facts_number.surface_spelling)
  ) {
    Accepted { value: r0, diagnostics: _ } =>
      match ts_insert_per_language_primitive_axis(
        registry: r0,
        subject: number_subject,
        target: target,
        axis: ModelCoreFactAxisWidth {},
        value: ts_inhabitant_atom(id: ^ts_tag_bits64)
      ) {
        Accepted { value: r1, diagnostics: _ } =>
          match ts_insert_per_language_primitive_axis(
            registry: r1,
            subject: number_subject,
            target: target,
            axis: ModelCoreFactAxisEncoding {},
            value: ts_inhabitant_atom(id: ts_facts_number.ieee754_binary)
          ) {
            Accepted { value: r2, diagnostics: _ } =>
              match ts_insert_per_language_primitive_axis(
                registry: r2,
                subject: bigint_subject,
                target: target,
                axis: ModelCoreFactAxisSurfaceSpelling {},
                value: ts_inhabitant_atom(id: ts_facts_bigint.surface_spelling)
              ) {
                Accepted { value: r3, diagnostics: _ } =>
                  match ts_insert_per_language_primitive_axis(
                    registry: r3,
                    subject: bigint_subject,
                    target: target,
                    axis: ModelCoreFactAxisEncoding {},
                    value: ts_inhabitant_atom(id: ts_facts_bigint.encoding)
                  ) {
                    Accepted { value: r4, diagnostics: _ } =>
                      match ts_insert_per_language_primitive_axis(
                        registry: r4,
                        subject: bool_subject,
                        target: target,
                        axis: ModelCoreFactAxisSurfaceSpelling {},
                        value: ts_inhabitant_atom(id: ts_facts_boolean.surface_spelling)
                      ) {
                        Accepted { value: r5, diagnostics: _ } =>
                          match ts_insert_per_language_primitive_axis(
                            registry: r5,
                            subject: bool_subject,
                            target: target,
                            axis: ModelCoreFactAxisEncoding {},
                            value: ts_inhabitant_atom(id: ts_facts_boolean.encoding)
                          ) {
                            Accepted { value: r6, diagnostics: _ } =>
                              match ts_insert_per_language_primitive_axis(
                                registry: r6,
                                subject: string_subject,
                                target: target,
                                axis: ModelCoreFactAxisSurfaceSpelling {},
                                value: ts_inhabitant_atom(id: ts_facts_string.surface_spelling)
                              ) {
                                Accepted { value: r7, diagnostics: _ } =>
                                  ts_insert_per_language_primitive_axis(
                                    registry: r7,
                                    subject: string_subject,
                                    target: target,
                                    axis: ModelCoreFactAxisEncoding {},
                                    value: ts_inhabitant_atom(id: ts_facts_string.encoding)
                                  )
                                Rejected { diagnostics: d } =>
                                  Rejected { diagnostics: d }
                              }
                            Rejected { diagnostics: d } =>
                              Rejected { diagnostics: d }
                          }
                        Rejected { diagnostics: d } =>
                          Rejected { diagnostics: d }
                      }
                    Rejected { diagnostics: d } =>
                      Rejected { diagnostics: d }
                  }
                Rejected { diagnostics: d } =>
                  Rejected { diagnostics: d }
              }
            Rejected { diagnostics: d } =>
              Rejected { diagnostics: d }
          }
        Rejected { diagnostics: d } =>
          Rejected { diagnostics: d }
      }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

data ts_per_language_fact_bundle_registry_outcome: Outcome<PerLanguageFactBundleRegistry> = ts_build_per_language_fact_bundle_registry()

type TsModelCoreLawKey
  = TsLawNumberIeee754Rounding
  | TsLawNumberNanInfCarriedByIeee754
  | TsLawBigIntAddAssociative
  | TsLawBigIntAddCommutative
  | TsLawBigIntMulAssociative
  | TsLawBigIntMulCommutative
  | TsLawBigIntDistributive
  | TsLawBigIntTotalOrder
  | TsLawBoolBoundedLattice
  | TsLawBoolComplement
  | TsLawStringConcatAssociative
  | TsLawStringConcatLeftIdentity
  | TsLawStringConcatRightIdentity

fn ts_model_core_law_node(witness: Node, algebra: Node, key: TsModelCoreLawKey) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ^model_core_wave1_law_field_subject, target: witness),
      ts_named_edge(name: ^model_core_wave1_law_field_algebra, target: algebra),
      ts_named_edge(
        name: ^model_core_wave1_law_field_kind,
        target: ts_inhabitant_atom(id: discriminant(v: key))
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_model_core_law_obligation(witness: Node, law: Node) -> AlgebraLawObligation {
  AlgebraLawObligation {
    inhabitance_witness: witness,
    law: law
  }
}

fn ts_number_law_obligations(facts: TsNumberPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = ts_number_algebra_witness_node(facts: facts)
  let inhabitant = ts_number_inhabitant_node(id: ^ts_inhabitant_number, facts: facts)
  let algebra = approximate_field_type_node(inhabitant: inhabitant)
  [
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawNumberIeee754Rounding
      )
    ),
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawNumberNanInfCarriedByIeee754
      )
    )
  ]
}

fn ts_bigint_law_obligations(facts: TsBigIntPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = ts_bigint_algebra_witness_node(facts: facts)
  let inhabitant = ts_bigint_inhabitant_node(id: ^ts_inhabitant_bigint, facts: facts)
  let algebra = ordered_ring_type_node(inhabitant: inhabitant)
  [
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawBigIntAddAssociative
      )
    ),
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawBigIntAddCommutative
      )
    ),
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawBigIntMulAssociative
      )
    ),
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawBigIntMulCommutative
      )
    ),
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawBigIntDistributive
      )
    ),
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawBigIntTotalOrder
      )
    )
  ]
}

fn ts_bool_law_obligations() -> List<AlgebraLawObligation> {
  let witness = ts_bool_algebra_witness_node()
  let inhabitant = ts_inhabitant_boolean_node()
  let algebra = boolean_algebra_type_node(inhabitant: inhabitant)
  [
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawBoolBoundedLattice
      )
    ),
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawBoolComplement
      )
    )
  ]
}

fn ts_string_law_obligations(facts: TsStringPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = ts_string_algebra_witness_node(facts: facts)
  let code_unit = ts_inhabitant_atom(id: facts.code_unit_inhabitant)
  let algebra = free_monoid_type_node(inhabitant: code_unit)
  [
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawStringConcatAssociative
      )
    ),
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawStringConcatLeftIdentity
      )
    ),
    ts_model_core_law_obligation(
      witness: witness,
      law: ts_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: TsLawStringConcatRightIdentity
      )
    )
  ]
}

fn ts_number_law_step(
  acc: List<AlgebraLawObligation>,
  row: TsEcma262NumericPrimitiveFactsUnion
) -> List<AlgebraLawObligation> {
  match row {
    TsNumericFactsNumber { facts: f } =>
      list_append(left: acc, right: ts_number_law_obligations(facts: f))
    TsNumericFactsBigInt { facts: _ } => acc
  }
}

fn ts_bigint_law_step(
  acc: List<AlgebraLawObligation>,
  row: TsEcma262NumericPrimitiveFactsUnion
) -> List<AlgebraLawObligation> {
  match row {
    TsNumericFactsNumber { facts: _ } => acc
    TsNumericFactsBigInt { facts: f } =>
      list_append(left: acc, right: ts_bigint_law_obligations(facts: f))
  }
}

fn ts_number_law_decls() -> List<AlgebraLawObligation> {
  fold_list(
    xs: ts_numeric_facts_catalog,
    empty: Empty,
    cons: fn(acc, row) { ts_number_law_step(acc: acc, row: row) }
  )
}

fn ts_bigint_law_decls() -> List<AlgebraLawObligation> {
  fold_list(
    xs: ts_numeric_facts_catalog,
    empty: Empty,
    cons: fn(acc, row) { ts_bigint_law_step(acc: acc, row: row) }
  )
}

fn ts_model_core_law_obligations() -> List<AlgebraLawObligation> {
  list_append(
    left: list_append(
      left: list_append(
        left: ts_number_law_decls(),
        right: ts_bigint_law_decls()
      ),
      right: ts_bool_law_obligations()
    ),
    right: ts_string_law_obligations(facts: ts_facts_string)
  )
}
fn ts_pure_operation(operation: Symbol) -> PrimitiveOperationRef {
  PrimitiveOperationRef {
    operation: ts_inhabitant_atom(id: operation),
    effect_signature: EffectSignature {
      signature: ts_inhabitant_atom(id: ^ts_effect_signature_pure_value)
    }
  }
}

fn ts_effect_semantics_wave2b() -> EffectSemanticsDecl {
  EffectSemanticsDecl {
    operations: [
      ts_pure_operation(operation: ^ts_op_number_add),
      ts_pure_operation(operation: ^ts_op_number_sub),
      ts_pure_operation(operation: ^ts_op_number_mul),
      ts_pure_operation(operation: ^ts_op_number_div),
      ts_pure_operation(operation: ^ts_op_number_neg),
      ts_pure_operation(operation: ^ts_op_number_compare),
      ts_pure_operation(operation: ^ts_op_bigint_add),
      ts_pure_operation(operation: ^ts_op_bigint_sub),
      ts_pure_operation(operation: ^ts_op_bigint_mul),
      ts_pure_operation(operation: ^ts_op_bigint_div),
      ts_pure_operation(operation: ^ts_op_bigint_rem),
      ts_pure_operation(operation: ^ts_op_bigint_neg),
      ts_pure_operation(operation: ^ts_op_bigint_compare),
      ts_pure_operation(operation: ^ts_op_bool_and),
      ts_pure_operation(operation: ^ts_op_bool_or),
      ts_pure_operation(operation: ^ts_op_bool_not),
      ts_pure_operation(operation: ^ts_op_string_concat)
    ]
  }
}
fn ts_fail_closed_partial_operation(
  operation: Symbol,
  precondition: Symbol,
  reason: Symbol
) -> PartialOperationDecl {
  PartialOperationDecl {
    operation: ts_inhabitant_atom(id: operation),
    precondition: ts_inhabitant_atom(id: precondition),
    discharge: FailClosedAtBoundary { reason: reason }
  }
}

fn ts_partiality_semantics_wave2b() -> PartialitySemanticsDecl {
  PartialitySemanticsDecl {
    operations: [
      ts_fail_closed_partial_operation(
        operation: ^ts_op_bigint_div,
        precondition: ^ts_precondition_bigint_divisor_nonzero,
        reason: ^ts_partial_bigint_divide_by_zero
      ),
      ts_fail_closed_partial_operation(
        operation: ^ts_op_bigint_rem,
        precondition: ^ts_precondition_bigint_divisor_nonzero,
        reason: ^ts_partial_bigint_remainder_by_zero
      )
    ]
  }
}

fn ts_model_core_wave2b() -> ModelCore {
  ModelCore {
    primitives: ts_wave2b_primitive_fact_bundles(),
    inhabitance: ts_model_core_inhabitance_decls_wave2b(),
    laws: ts_model_core_law_obligations(),
    effects: ts_effect_semantics_wave2b(),
    partiality: ts_partiality_semantics_wave2b()
  }
}

fn ts_language_model_canonical_symbols_wave2b() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      ts_language_model_canonical_symbols_wave2a().member(sym: sym) ||
        sym == ^ts_surface_spelling_string
    }
  }
}

fn ts_language_model_wave2b() -> LanguageModel {
  LanguageModel {
    language_identity: ^ts_language_model_surface_id,
    canonical_symbols: ts_language_model_canonical_symbols_wave2b(),
    core: ts_model_core_wave2b(),
    lex: ts_wave2a_lex(),
    grammar: ts_wave2a_grammar()
  }
}
