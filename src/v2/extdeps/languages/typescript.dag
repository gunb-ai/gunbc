fn ts_pr3_identity_formal_productions() -> List<v2.std.grammar.FormalProduction> {
  [
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_type_number,
      rhs: [v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_ty_number)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_type_annotation,
      rhs: [v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_ty_number)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_pr3_typed_param,
      rhs: [
        v2.std.grammar.grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_param_x),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_colon),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_type_annotation)
      ]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_pr3_typed_params_opt,
      rhs: []
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_pr3_typed_params_opt,
      rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_pr3_typed_params)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_pr3_typed_params,
      rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_pr3_typed_param)]
    ),
    v2.std.grammar.grammar_formal_production(
      lhs: ^ts_production_pr3_typed_fn_decl,
      rhs: [
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_kw_function),
        v2.std.grammar.grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_pr3_identity),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_lparen),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_pr3_typed_params_opt),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_rparen),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_colon),
        v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ts_production_type_annotation),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_lbrace),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_kw_return),
