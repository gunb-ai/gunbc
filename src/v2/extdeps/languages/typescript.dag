    name: ^ts_production_type_number,
    expression: v2.std.grammar.Terminal { token_class: ^ts_token_ty_number, stamp: v2.std.grammar.StampClass },
    emitted: ts_grammar_atom(id: ^ts_surface_type_number)
  }
}

