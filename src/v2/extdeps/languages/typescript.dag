    grammar_formal_production(
      lhs: ^ts_production_wave2a_record_field,
      rhs: [
        grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_field_id),
        grammar_formal_terminal(identity: ^ts_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^ts_production_wave2a_type_annotation)
      ]
    ),
    grammar_formal_production(
      lhs: ^ts_production_wave2a_record_field,
      rhs: [
        grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_field_title),
        grammar_formal_terminal(identity: ^ts_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^ts_production_wave2a_type_annotation)
      ]
    ),
    grammar_formal_production(
      lhs: ^ts_production_wave2a_record_field,
      rhs: [
        grammar_formal_terminal_bound(identity: ^ts_token_ident, binding: ^ts_binding_field_status),
        grammar_formal_terminal(identity: ^ts_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^ts_production_wave2a_type_annotation)
      ]
    ),
    grammar_formal_production(
      lhs: ^ts_production_wave2a_record_fields,
