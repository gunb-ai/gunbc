        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_semicolon),
        v2.std.grammar.grammar_formal_terminal(identity: ^ts_token_rbrace)
      ]
    )
  ]
}

fn ts_exemplar_emitted_for_lhs(lhs: v2.std.node.Symbol) -> v2.std.witness.Witness<v2.std.node.Node> {
  if lhs == ^ts_production_type_alias_decl {
    v2.std.witness.Holds { value: ts_task_type_alias_emitted() }
  } else if lhs == ^ts_production_pr3_typed_fn_decl {
    v2.std.witness.Holds { value: ts_pr3_identity_typed_fn_emitted() }
  } else if lhs == ^ts_production_fn_add {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^grammar_relation_emitted_not_conj,
        at: v2.std.diagnostic.node_locus(node: ts_emitted_add_fn_node()),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    }
  } else {
    v2.std.witness.Violates {
      diagnostic: v2.std.diagnostic.Diagnostic {
        reason: ^grammar_relation_production_not_found,
        at: v2.std.diagnostic.node_locus(node: ts_inhabitant_atom(id: lhs)),
        correction: v2.std.diagnostic.Unavailable { reason: v2.std.diagnostic.ExternalContractUnknown }
      }
    }
  }
}

fn ts_exemplared_formal_productions_for_lhs(lhs: v2.std.node.Symbol) -> List<v2.std.grammar.FormalProduction> {
  if lhs == ^ts_production_type_alias_decl {
    ts_task_formal_productions()
  } else if lhs == ^ts_production_pr3_typed_fn_decl {
    ts_pr3_identity_formal_productions()
  } else {
    []
  }
}

fn ts_eager_grammar_relation_row_witness(lhs: v2.std.node.Symbol) -> v2.std.witness.Witness<v2.std.node.Node> {
  match ts_exemplar_emitted_for_lhs(lhs: lhs) {
    Holds { value: emitted } =>
      let productions = ts_exemplared_formal_productions_for_lhs(lhs: lhs)
      match v2.std.grammar.formal_production_for_lhs_exact(
        productions: productions,
        lhs: lhs,
        child: emitted
      ) {
        Holds { value: production } =>
          v2.std.grammar.derive_grammar_relation_row_node(
            production: production,
            productions: productions,
            emitted: emitted
          )
        Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn ts_fn_add_scaffold_relation_row_node() -> v2.std.node.Node {
  ts_grammar_relation_row_node(row: ts_grammar_relation_row())
}

fn ts_pr3_identity_relation_row_witness() -> v2.std.witness.Witness<v2.std.node.Node> {
  ts_eager_grammar_relation_row_witness(lhs: ^ts_production_pr3_typed_fn_decl)
}

