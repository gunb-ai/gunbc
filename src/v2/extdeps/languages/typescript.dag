fn ts_exemplar_emitted_for_lhs(lhs: Symbol) -> Witness<Node> {
  if lhs == ^ts_production_wave2a_type_alias_decl {
    Holds { value: ts_wave2a_task_type_alias_emitted() }
  } else if lhs == ^ts_production_pr3_typed_fn_decl {
    Holds { value: ts_pr3_identity_typed_fn_emitted() }
  } else if lhs == ^ts_production_mvp1_fn_add {
    Violates {
      diagnostic: Diagnostic {
        reason: ^grammar_relation_emitted_not_conj,
        at: node_locus(node: ts_mvp1_emitted_add_fn_node()),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  } else {
    Violates {
      diagnostic: Diagnostic {
        reason: ^grammar_relation_production_not_found,
        at: node_locus(node: ts_inhabitant_atom(id: lhs)),
        correction: Unavailable { reason: ExternalContractUnknown }
      }
    }
  }
}

fn ts_exemplared_formal_productions_for_lhs(lhs: Symbol) -> List<FormalProduction> {
  if lhs == ^ts_production_wave2a_type_alias_decl {
    ts_wave2a_task_formal_productions()
  } else if lhs == ^ts_production_pr3_typed_fn_decl {
    ts_pr3_identity_formal_productions()
  } else {
    []
  }
}

fn ts_eager_grammar_relation_row_witness(lhs: Symbol) -> Witness<Node> {
  match ts_exemplar_emitted_for_lhs(lhs: lhs) {
    Holds { value: emitted } =>
      let productions = ts_exemplared_formal_productions_for_lhs(lhs: lhs)
      match formal_production_for_lhs_exact(
        productions: productions,
        lhs: lhs,
        child: emitted
      ) {
        Holds { value: production } =>
          derive_grammar_relation_row_node(
            production: production,
            productions: productions,
            emitted: emitted
          )
        Violates { diagnostic: d } => Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

