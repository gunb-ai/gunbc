  v2.std.grammar.GrammarProduction {
    name: ^ts_production_type_alias_decl,
    expression: v2.std.grammar.Sequence {
      left: v2.std.grammar.Terminal { token_class: ^ts_token_kw_type, stamp: v2.std.grammar.StampClass },
