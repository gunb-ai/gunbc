fn ts_grammar_production_pr3_typed_fn_decl() -> v2.std.grammar.GrammarProduction {
  v2.std.grammar.GrammarProduction {
    name: ^ts_production_pr3_typed_fn_decl,
    expression: v2.std.grammar.Sequence {
