  [
    ts_named_edge(
      name: ^serialize_source_field_source_text,
      target: ts_inhabitant_atom(id: ^ts_pr3_identity_source_literal)
    ),
    ts_named_edge(
      name: ^serialize_source_field_source_grammar,
      target: ts_inhabitant_atom(id: ^ts_production_pr3_typed_fn_decl)
    )
  ]
}

fn ts_pr3_identity_serialize_source_witness() -> v2.std.witness.Witness<v2.std.node.Node> {
  match ts_pr3_identity_relation_row_witness() {
    Holds { value: row } =>
      match ts_grammar_relation_row_token_edges_witness(row: row) {
        Holds { value: token_edges } =>
          v2.std.witness.Holds {
            value: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
              children: v2.std.algebra.list_append(
                left: ts_pr3_identity_serialize_source_children(),
                right: token_edges
              ),
              occurrence_id: v2.std.node.SyntheticOccurrence
}
          }
        Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn ts_pr3_translation_rules_witness() -> v2.std.witness.Witness<v2.std.node.Node> {
  match ts_task_type_alias_relation_row_witness() {
    Holds { value: task_row } =>
      match ts_pr3_identity_relation_row_witness() {
        Holds { value: pr3_row } =>
          v2.std.witness.Holds {
            value: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
              children: [
                ts_named_edge(
                  name: ^ts_relation_rule_fn_add,
                  target: ts_fn_add_scaffold_relation_row_node()
                ),
                ts_named_edge(
                  name: ^ts_relation_rule_type_alias_task,
                  target: task_row
                ),
                ts_named_edge(
                  name: ^ts_relation_rule_pr3_identity,
                  target: pr3_row
                )
              ],
              occurrence_id: v2.std.node.SyntheticOccurrence
}
          }
        Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

fn ts_pr3_identity_target_model_bundle_witness() -> v2.std.witness.Witness<v2.std.node.Node> {
  match ts_pr3_translation_rules_witness() {
    Holds { value: rules } =>
      match ts_pr3_identity_serialize_source_witness() {
        Holds { value: serialize } =>
          v2.std.witness.Holds {
            value: v2.std.node.Node {
              kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
              children: [
                ts_named_edge(
                  name: ^target_model_edge_selection_policy,
                  target: ts_inhabitant_number_node()
                ),
                ts_named_edge(
                  name: ^target_model_edge_declared_inhabitants,
                  target: ts_add_declared_inhabitants_root()
                ),
                ts_named_edge(
                  name: ^target_model_edge_translation_rules,
                  target: rules
                ),
                ts_named_edge(
                  name: ^target_model_edge_serialize_source,
                  target: serialize
                )
              ],
              occurrence_id: v2.std.node.SyntheticOccurrence
}
          }
        Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
      }
    Violates { diagnostic: d } => v2.std.witness.Violates { diagnostic: d }
  }
}

