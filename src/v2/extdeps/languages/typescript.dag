type TsNumberPrimitiveFacts {
  surface_spelling: Symbol
  ieee754_binary: Symbol
  std_projection: Symbol
}

type TsBigIntPrimitiveFacts {
  surface_spelling: Symbol
  std_projection: Symbol
  encoding: Symbol
}

type TsBooleanPrimitiveFacts {
  surface_spelling: Symbol
  std_projection: Symbol
  encoding: Symbol
}

type TsEcma262NumericPrimitiveFactsUnion
  = TsNumericFactsNumber { facts: TsNumberPrimitiveFacts }
  | TsNumericFactsBigInt { facts: TsBigIntPrimitiveFacts }

type TsGrammarRelationRow {
  production: FormalProduction
  emitted: Node
  tokens: List<ConcreteSyntaxToken>
}

data ts_task_type_alias_source_text: String = "type Task = { id: TaskId, title: string, status: TaskStatus };"
data ts_pr3_identity_source_text: String = "function identity(x: number): number { return x; }"
data ts_mvp1_source_text: String = "function add(x: number, y: number): number { return x + y; }"

data ts_facts_number: TsNumberPrimitiveFacts = TsNumberPrimitiveFacts {
  surface_spelling: ^ts_surface_spelling_number,
  ieee754_binary: ^ts_ieee754_binary64,
  std_projection: ^std_projection_additive_numeric,
}

data ts_facts_bigint: TsBigIntPrimitiveFacts = TsBigIntPrimitiveFacts {
  surface_spelling: ^ts_surface_spelling_bigint,
  std_projection: ^ts_std_projection_bigint,
  encoding: ^ts_repr_bigint_exact_unbounded,
}

data ts_facts_boolean: TsBooleanPrimitiveFacts = TsBooleanPrimitiveFacts {
  surface_spelling: ^ts_surface_spelling_boolean,
  std_projection: ^ts_std_projection_bool,
  encoding: ^ts_repr_boolean_ecma_boolean,
}

data ts_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

data ts_numeric_facts_catalog: List<TsEcma262NumericPrimitiveFactsUnion> = [
  TsNumericFactsNumber { facts: ts_facts_number },
  TsNumericFactsBigInt { facts: ts_facts_bigint }
]

fn ts_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn ts_number_arithmetic_semantics_node() -> Node {
  ts_inhabitant_atom(id: ^ts_tag_number_ieee754_binary64)
}

fn ts_number_bitwise_semantics_node() -> Node {
  ts_inhabitant_atom(id: ^ts_tag_number_bitwise_int32_uint32)
}

fn ts_bigint_operation_semantics_node() -> Node {
  ts_inhabitant_atom(id: ^ts_tag_bigint_exact_unbounded)
}

fn ts_bool_operation_semantics_node(facts: TsBooleanPrimitiveFacts) -> Node {
  ts_inhabitant_atom(id: facts.encoding)
}

fn ts_number_facts_node(facts: TsNumberPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ^ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ^ts_facts_field_arithmetic_semantics,
        target: ts_number_arithmetic_semantics_node()
      ),
      ts_named_edge(
        name: ^ts_facts_field_bitwise_semantics,
        target: ts_number_bitwise_semantics_node()
      ),
      ts_named_edge(
        name: ^ts_facts_field_width,
        target: ts_inhabitant_atom(id: ^ts_tag_bits64)
      ),
      ts_named_edge(
        name: ^ts_facts_field_ieee754_binary,
        target: ts_inhabitant_atom(id: facts.ieee754_binary)
      ),
      ts_named_edge(
        name: ^facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_bigint_facts_node(facts: TsBigIntPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ^ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ^ts_facts_field_operation_semantics,
        target: ts_bigint_operation_semantics_node()
      ),
      ts_named_edge(
        name: ^facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      ),
      ts_named_edge(
        name: ^ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: facts.encoding)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_bool_facts_node(facts: TsBooleanPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(
        name: ^ts_facts_field_surface_spelling,
        target: ts_inhabitant_atom(id: facts.surface_spelling)
      ),
      ts_named_edge(
        name: ^ts_facts_field_operation_semantics,
        target: ts_bool_operation_semantics_node(facts: facts)
      ),
      ts_named_edge(
        name: ^facts_field_std_projection,
        target: ts_inhabitant_atom(id: facts.std_projection)
      ),
      ts_named_edge(
        name: ^ts_facts_field_encoding,
        target: ts_inhabitant_atom(id: facts.encoding)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_number_inhabitant_node(id: Symbol, facts: TsNumberPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ^ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ^ts_inhabitant_field_facts,
        target: ts_number_facts_node(facts: facts)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_bigint_inhabitant_node(id: Symbol, facts: TsBigIntPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ^ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ^ts_inhabitant_field_facts,
        target: ts_bigint_facts_node(facts: facts)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_bool_inhabitant_node(id: Symbol, facts: TsBooleanPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ^ts_inhabitant_field_atom, target: ts_inhabitant_atom(id: id)),
      ts_named_edge(
        name: ^ts_inhabitant_field_facts,
        target: ts_bool_facts_node(facts: facts)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_inhabitant_number_node() -> Node {
  ts_number_inhabitant_node(id: ^ts_inhabitant_number, facts: ts_facts_number)
}

fn ts_inhabitant_bigint_node() -> Node {
  ts_bigint_inhabitant_node(id: ^ts_inhabitant_bigint, facts: ts_facts_bigint)
}

fn ts_inhabitant_boolean_node() -> Node {
  ts_bool_inhabitant_node(id: ^ts_inhabitant_boolean, facts: ts_facts_boolean)
}

fn ts_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ts_named_edge(name: ^ts_inhabitant_field_number, target: ts_inhabitant_number_node()),
      ts_named_edge(name: ^ts_inhabitant_field_bigint, target: ts_inhabitant_bigint_node()),
      ts_named_edge(name: ^ts_inhabitant_field_boolean, target: ts_inhabitant_boolean_node())
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_mvp1_number_zip_fold_closure_edges() -> List<Edge> {
  [
    ts_named_edge(
      name: ^ts_inhabitant_field_mvp1_add_fn,
      target: ts_mvp1_emitted_add_fn_node()
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_inhabitant_atom,
      target: ts_inhabitant_atom(id: ^ts_inhabitant_number)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_facts,
      target: ts_number_facts_node(facts: ts_facts_number)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_spelling,
      target: ts_inhabitant_atom(id: ^ts_surface_spelling_number)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_arithmetic,
      target: ts_number_arithmetic_semantics_node()
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_bitwise,
      target: ts_number_bitwise_semantics_node()
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_width,
      target: ts_inhabitant_atom(id: ^ts_tag_bits64)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_ieee754,
      target: ts_inhabitant_atom(id: ^ts_ieee754_binary64)
    ),
    ts_named_edge(
      name: ^ts_coercion_field_number_std_projection,
      target: ts_inhabitant_atom(id: ^std_projection_additive_numeric)
    )
  ]
}

fn ts_mvp1_coercion_candidate_edges() -> List<Edge> {
  list_append(
    left: ts_declared_inhabitants_root().children,
    right: ts_mvp1_number_zip_fold_closure_edges()
  )
}

fn ts_mvp1_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: ts_mvp1_coercion_candidate_edges(),
    occurrence_id: SyntheticOccurrence
}
}

fn ts_mvp1_selection_policy_node() -> Node {
  ts_inhabitant_number_node()
}

fn ts_mvp1_emitted_add_fn_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: ts_inhabitant_number_node() },
      Edge { label: Positional, target: ts_inhabitant_number_node() },
      Edge { label: Positional, target: ts_inhabitant_number_node() }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ts_mvp1_add_binary_body_node() -> Node {
  Node {
    kind: ComputationNode { behavior: Transform },
    children: [
      Edge {
        label: Positional,
        target: ts_inhabitant_atom(id: ^dag_token_plus)
      },
      Edge {
        label: Positional,
        target: ts_inhabitant_atom(id: ^dag_binding_param_x)
      },
      Edge {
        label: Positional,
        target: ts_inhabitant_atom(id: ^dag_binding_param_y)
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_mvp1_emitted_add_fn_with_body_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: ts_inhabitant_number_node() },
      Edge { label: Positional, target: ts_inhabitant_number_node() },
      Edge { label: Positional, target: ts_inhabitant_number_node() },
      Edge {
        label: Named { name: ^arrow_body_edge },
        target: ts_mvp1_add_binary_body_node()
      }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ts_value_expression_projection() -> TargetValueExpressionProjection {
  ts_value_expression_projection_full(
    record_literal_names_type: Omit,
    block_evaluation_mode: ts_block_evaluation_mode()
  )
}

fn ts_module_projection() -> TargetModuleProjection {
  TargetModuleProjection {
    import_form: EsModuleImport {
      import_token: ^ts_token_kw_import,
      names_open: ^ts_token_import_lbrace,
      names_separator: ^ts_token_comma,
      names_close: ^ts_token_import_rbrace,
      from_token: ^ts_token_kw_from,
      path_open: ^ts_token_module_quote,
      path_segment_separator: ^ts_token_module_path_sep,
      path_close: ^ts_token_module_quote,
      terminator: ^ts_token_semicolon,
      name_ident_token: ^ts_token_ident,
      path_segment_token: ^ts_token_module_path_segment
    }
  }
}

fn ts_value_expression_projection_with_record_literal_naming(
  record_literal_names_type: RecordLiteralTypeNaming
) -> TargetValueExpressionProjection {
  ts_value_expression_projection_full(
    record_literal_names_type: record_literal_names_type,
    block_evaluation_mode: ts_block_evaluation_mode()
  )
}

fn ts_value_expression_projection_with_block_evaluation_mode(
  block_evaluation_mode: BlockEvaluationMode
) -> TargetValueExpressionProjection {
  ts_value_expression_projection_full(
    record_literal_names_type: Omit,
    block_evaluation_mode: block_evaluation_mode
  )
}

fn ts_value_expression_projection_full(
  record_literal_names_type: RecordLiteralTypeNaming,
  block_evaluation_mode: BlockEvaluationMode
) -> TargetValueExpressionProjection {
  TargetValueExpressionProjection {
    binding_ref_form: TargetBindingRefShape { ident_token: ^ts_token_ident },
    primitive_apply_form: TargetPrimitiveApplyShape {
      open: ^ts_token_lparen,
      close: ^ts_token_rparen,
      separator: ^ts_token_comma
    },
    callable_apply_form: TargetCallApplyShape {
      callee_ident_token: ^ts_token_ident,
      open: ^ts_token_lparen,
      separator: ^ts_token_comma,
      close: ^ts_token_rparen
    },

    closure_form: TargetClosureShape {
      fn_token: ^ts_token_kw_function,
      open: ^ts_token_lparen,
      separator: ^ts_token_comma,
      close: ^ts_token_rparen,
      body_open: ^ts_token_lbrace,
      body_close: ^ts_token_rbrace,
      param_ident_token: ^ts_token_ident
    },

    effect_apply_form: TargetEffectApplyShape {
      callees: [
        TargetEffectCalleeRow {
          effect_kind: ^ReadResource,
          callee: ^ts_token_effect_read_callee
        },
        TargetEffectCalleeRow {
          effect_kind: ^WriteResource,
          callee: ^ts_token_effect_write_callee
        }
      ],
      open: ^ts_token_lparen,
      close: ^ts_token_rparen,
      separator: ^ts_token_comma
    },

    conditional_form: TargetConditionalShape {
      if_token: ^ts_token_kw_if,
      then_token: ^ts_token_kw_then,
      else_token: ^ts_token_kw_else
    },

    let_form: TargetBindLetShape {
      let_token: ^ts_token_kw_let,
      assign_token: ^ts_token_eq,
      in_token: ^ts_token_unwired_bind_in
    },
    loop_form: TargetLoopShape {
      loop_token: ^ts_token_unwired_loop
    },

    record_construct_form: TargetRecordConstructShape {
      open: ^ts_token_lbrace,
      close: ^ts_token_rbrace,
      separator: ^ts_token_comma,
      assign: ^ts_token_colon,
      record_literal_names_type: record_literal_names_type
    },
    field_access_form: TargetFieldAccessShape {
      dot: ^ts_token_dot
    },
    match_form: TargetMatchShape {
      match_token: ^ts_token_unwired_match,
      open: ^ts_token_lbrace,
      close: ^ts_token_rbrace,
      fat_arrow: ^ts_token_fat_arrow,
      arm_separator: ^ts_token_comma
    },
    block_evaluation_mode: block_evaluation_mode
  }
}

fn ts_add_operator_realization_row() -> Node {
  target_operator_realization_node(
    operation: canonical_operation_op_add(),
    shape: InfixToken { token: ^ts_token_plus }
  )
}

fn ts_operator_realizations_catalog_node() -> Node {
  target_operator_realizations_catalog_node(rows: [ts_add_operator_realization_row()])
}

fn ts_block_evaluation_mode() -> BlockEvaluationMode {
  StatementSequenced {
    return_token: ^ts_token_kw_return,
    statement_terminator: ^ts_token_semicolon
  }
}

fn ts_add_signature_with_open() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^ts_token_kw_function },
    BoundToken { token_class: ^ts_token_ident, binding: ^ts_binding_fn_add },
    FixedToken { token_class: ^ts_token_lparen },
    BoundToken { token_class: ^ts_token_ident, binding: ^ts_binding_param_x },
    FixedToken { token_class: ^ts_token_colon },
    FixedToken { token_class: ^ts_token_ty_number },
    FixedToken { token_class: ^ts_token_comma },
    BoundToken { token_class: ^ts_token_ident, binding: ^ts_binding_param_y },
    FixedToken { token_class: ^ts_token_colon },
    FixedToken { token_class: ^ts_token_ty_number },
    FixedToken { token_class: ^ts_token_rparen },
    FixedToken { token_class: ^ts_token_colon },
    FixedToken { token_class: ^ts_token_ty_number },
    FixedToken { token_class: ^ts_token_lbrace }
  ]
}

fn ts_add_block_close() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^ts_token_rbrace }
  ]
}

fn ts_mvp1_bodied_arrow_statement_scaffold() -> TargetBodiedArrowStatementScaffold {
  derive_bodied_arrow_scaffold(
    signature_with_open: ts_add_signature_with_open(),
    block_close: ts_add_block_close(),
    mode: ts_block_evaluation_mode()
  )
}

fn ts_mvp1_fn_add_statement_prefix_tokens() -> List<ConcreteSyntaxToken> {
  let scaffold = ts_mvp1_bodied_arrow_statement_scaffold()
  scaffold.prefix
}

fn ts_mvp1_fn_add_statement_suffix_tokens() -> List<ConcreteSyntaxToken> {
  let scaffold = ts_mvp1_bodied_arrow_statement_scaffold()
  scaffold.suffix
}

fn ts_mvp1_compose_add_fn_tokens(body_tokens: List<ConcreteSyntaxToken>) -> List<ConcreteSyntaxToken> {
  list_append(
    left: list_append(
      left: ts_mvp1_fn_add_statement_prefix_tokens(),
      right: body_tokens
    ),
    right: ts_mvp1_fn_add_statement_suffix_tokens()
  )
}

fn ts_mvp1_source_text_authority() -> String {
  ts_mvp1_source_text
}

fn ts_concrete_token_node(token: ConcreteSyntaxToken) -> Node {

  concrete_syntax_token_to_node(token: token)
}

fn ts_mvp1_serialize_source_prefix_edges() -> List<Edge> {
  [
    ts_named_edge(
      name: ^serialize_source_field_source_text,
      target: ts_inhabitant_atom(id: ^ts_mvp1_source_literal)
    ),
    ts_named_edge(
      name: ^serialize_source_field_source_grammar,
      target: ts_inhabitant_atom(id: ^ts_production_mvp1_fn_add)
    )
  ]
}

fn ts_mvp1_serialize_source_children() -> List<Edge> {
  list_append(
    left: ts_mvp1_serialize_source_prefix_edges(),
    right: [
      ts_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: ts_mvp1_canonical_add_fn_tokens(),
          token_to_node: ts_concrete_token_node
        )
      )
    ]
  )
}

fn ts_mvp1_serialize_source_node() -> Node {
  let _authority = ts_mvp1_source_text_authority()
  Node {
    kind: TypeNode { connective: Conj },
    children: ts_mvp1_serialize_source_children(),
    occurrence_id: SyntheticOccurrence
}
}

fn ts_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

type TsGramBuild1State
  = TsGramBuild1StateInit
  | TsGramBuild1StateReady { expr: GrammarExpr }

fn ts_grammar_sequence_from_token_classes() -> GrammarExpr {
  match fold_list(
    xs: ts_mvp1_canonical_add_fn_tokens(),
    empty: TsGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        TsGramBuild1StateInit =>
          TsGramBuild1StateReady {
            expr: ts_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
          }
        TsGramBuild1StateReady { expr: acc } =>
          TsGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: ts_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    TsGramBuild1StateInit =>
      ts_grammar_terminal(token_class: ^ts_token_kw_function)
    TsGramBuild1StateReady { expr: result } => result
  }
}

fn ts_mvp1_grammar_relation_row() -> TsGrammarRelationRow {
  TsGrammarRelationRow {
    production: ts_formal_production_mvp1_fn_add(),
    emitted: ts_mvp1_emitted_add_fn_node(),
    tokens: ts_mvp1_canonical_add_fn_tokens()
  }
}

