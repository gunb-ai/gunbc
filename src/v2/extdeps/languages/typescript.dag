  }
}

fn ts_runtime_row() -> v2.std.host_transport.TargetEmitHostRuntimeRow {
  v2.std.host_transport.HostRuntimeRowPresent {
    row: v2.std.host_transport.EmitHostRuntimeRow {
      transport: ts_host_transport_descriptor(),
      runtime_primitive_type: ts_emit_host_runtime_primitive_type_node()
    }
  }
}

fn ts_type_expression_projection() -> v2.std.compilers.target_model.TargetTypeExpressionProjection {
  v2.std.compilers.target_model.TargetTypeExpressionProjection {
    atom_form: v2.std.compilers.target_model.TargetAtomTypeShape {
      surface: ^ts_surface_type_atom,
      ident_token: ^ts_token_ident
    },
    conj_form: v2.std.compilers.target_model.TargetGenericApply {
      surface: ^ts_surface_type_record,
      open: ^ts_token_lbrace,
      separator: ^ts_token_comma,
      field_label_separator: v2.std.optional.optional_present(value: ^ts_token_colon),
      close: ^ts_token_rbrace
    },
    disj_form: v2.std.compilers.target_model.TargetSumTypeShape {
      surface: ^ts_surface_type_sum,
      variant_separator: ^ts_token_pipe
    },
    arrow_form: v2.std.compilers.target_model.TargetFunctionTypeShape {
      surface: ^ts_surface_type_arrow,
      open: ^ts_token_lparen,
      close: ^ts_token_rparen,
      arrow: ^ts_token_fat_arrow,
      param_ident_token: ^ts_token_ident,
      param_type_separator: ^ts_token_colon,
      param_list_separator: ^ts_token_comma
    },
    cardinality_form: v2.std.compilers.target_model.TargetGenericApply {
      surface: ^ts_surface_type_cardinality,
      open: ^ts_token_lt,
      separator: ^ts_token_comma,
      field_label_separator: v2.std.optional.optional_absent(),
      close: ^ts_token_gt
    },
    instantiation_form: v2.std.compilers.target_model.TargetGenericApply {
      surface: ^ts_surface_type_generic_apply,
      open: ^ts_token_lt,
      separator: ^ts_token_comma,
      field_label_separator: v2.std.optional.optional_absent(),
      close: ^ts_token_gt
    }
  }
}

fn ts_type_expression_projection_bundle_node() -> v2.std.node.Node {
  v2.std.compilers.target_model.type_expr_projection_step_algebra(projection: ts_type_expression_projection())
}

