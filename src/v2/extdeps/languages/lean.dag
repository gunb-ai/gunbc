module v2.extdeps.languages.lean
import v2.std.language_model { LanguageModel }

import v2.std.grammar {
  StampClass,
  StampBinding,
  FormalGrammarSymbol,
  FormalProduction,
  GrammarExpr,
  GrammarProduction,
  GrammarRoot,
  GrammarSchema,
  GrammarSchemaProbe,
  GrammarSchemaProbeBinding,
  ModeledGrammar,
  ParseGrammar,
  Sequence,
  Terminal,
  grammar_atom,
  grammar_carries_symbol,
  grammar_empty_sync_tokens,
  grammar_formal_nonterminal,
  grammar_formal_terminal
}
import v2.std.compilers.lexing {
  CharClassPattern,
  DigitChar,
  LexPattern,
  LexRule,
  LexRuleSet,
  LexRules,
  LiteralPattern,
  ModeledLexRules,
  OneOrMorePattern,
  TokenRule,
  lex_rule_set_token_class_member
}
import v2.std.collection { List, Map, Set }
import v2.std.logic { Bool, bool_boolean_algebra }
import v2.std.algebra {
  BooleanAlgebra,
  Cons,
  Empty,
  boolean_algebra_type_node,
  commutative_ring_type_node,
  fold_list,
  list_snoc_item
}
import v2.std.text { String }
import v2.std.model_core {
  AlgebraInhabitanceDecl,
  EffectSemanticsDecl,
  ModelCore,
  PartialitySemanticsDecl,
  PrimitiveFactBundle,
  ModelCoreFactAxisEncoding,
  ModelCoreFactAxisSignedness,
  ModelCoreFactAxisSurfaceSpelling,
  primitive_fact_axis_unbound_diagnostic,
  ModelCoreFactAxisWidth
}
import v2.std.witness { Holds, Violates }
import v2.std.node {
  Atom,
  Conj,
  Edge,
  Named,
  Node,
  Symbol,
  TypeNode,
  SyntheticOccurrence
}

type LeanDeclarationKind
  = LeanDef
  | LeanTheorem
  | LeanInductive
  | LeanStructure
  | LeanAxiom

type LeanName {
  namespace: List<Symbol>
  local: Symbol
}

type LeanLevel
  = LeanLevelZero
  | LeanLevelSucc { predecessor: LeanLevelRef }
  | LeanLevelMax { left: LeanLevelRef, right: LeanLevelRef }
  | LeanLevelIMax { left: LeanLevelRef, right: LeanLevelRef }
  | LeanLevelParam { name: Symbol }

type LeanLevelRef {
  name: LeanName
}

type LeanLevelNode {
  name: LeanName
  level: LeanLevel
}

type LeanBinderInfo
  = ExplicitBinder
  | ImplicitBinder
  | StrictImplicitBinder
  | InstanceImplicitBinder

type LeanBinder {
  name: LeanName
  type: LeanTermRef
  info: LeanBinderInfo
}

type LeanTermRef {
  name: LeanName
}

type LeanTermNode {
  name: LeanName
  form: LeanTermForm
}

type LeanTermForm
  = LeanSort { level: LeanLevelRef }
  | LeanConst { name: LeanName, levels: List<LeanLevelRef> }
  | LeanVar { name: LeanName }
  | LeanApp { function: LeanTermRef, argument: LeanTermRef }
  | LeanLambda { binder: LeanBinder, body: LeanTermRef }
  | LeanForall { binder: LeanBinder, body: LeanTermRef }
  | LeanLet { binder: LeanBinder, value: LeanTermRef, body: LeanTermRef }
  | LeanMatch { scrutinee: LeanTermRef, alternatives: List<LeanMatchAlternative> }

type LeanMatchAlternative {
  constructor: LeanName
  binders: List<LeanBinder>
  body: LeanTermRef
}

type LeanTerminationMeasure {
  subject: LeanName
  measure: LeanTermRef
}

type LeanTerminationBy
  = LeanStructuralTermination { decreasing_parameter: LeanName }
  | LeanWellFoundedTermination { measure: LeanTerminationMeasure }

type LeanDecreasingProof {
  proof: LeanTermRef
}

type LeanTerminationClause
  = LeanTerminationByClause { termination: LeanTerminationBy }
  | LeanDecreasingBy { proof: LeanDecreasingProof }

type LeanDefinitionTermination
  = LeanNoExplicitTermination
  | LeanTerminationByOnly { termination: LeanTerminationBy }
  | LeanDecreasingByOnly { proof: LeanDecreasingProof }
  | LeanTerminationByWithDecreasingBy {
      termination: LeanTerminationBy,
      proof: LeanDecreasingProof
    }

type LeanProofArtifact
  = LeanTheoremProofArtifact {
      name: LeanName,
      type: LeanTermRef,
      proof: LeanTermRef
    }
  | LeanDefinitionTerminationArtifact {
      name: LeanName,
      type: LeanTermRef,
      body: LeanTermRef,
      termination: LeanDefinitionTermination
    }

type LeanFidelityFeature
  = LeanKernelTerm
  | LeanPrettyNameSpelling
  | LeanWhitespaceAndLayout
  | LeanTacticScript
  | LeanElaboratorOnlySyntax
  | LeanUnresolvedUniverseLevel
  | LeanUnsupportedTheoremClass

type LeanProofCheckSemantics<IRCarrier> {
  kernel_definitional_reduction: Bool
  opaque_axiom_boundary: Bool
  proof_irrelevance_for_propositions: Bool
}

type LeanIntKind
  = Signed
  | Unsigned

type LeanIntWidth
  = Bits8
  | Bits16
  | Bits32
  | Bits64
  | Pointer

type LeanScalar
  = IntScalar { kind: LeanIntKind, width: LeanIntWidth }
  | BoolScalar

type LeanPrimitiveFacts {
  surface_spelling: Symbol
  scalar: LeanScalar
  representation: Symbol
}

data lean_facts_int8: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_int8,
  scalar: IntScalar { kind: Signed, width: Bits8 },
  representation: ^lean_repr_fixed_precision_integer
}

data lean_facts_int16: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_int16,
  scalar: IntScalar { kind: Signed, width: Bits16 },
  representation: ^lean_repr_fixed_precision_integer
}

data lean_facts_int32: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_int32,
  scalar: IntScalar { kind: Signed, width: Bits32 },
  representation: ^lean_repr_fixed_precision_integer
}

data lean_facts_int64: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_int64,
  scalar: IntScalar { kind: Signed, width: Bits64 },
  representation: ^lean_repr_fixed_precision_integer
}

data lean_facts_uint8: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_uint8,
  scalar: IntScalar { kind: Unsigned, width: Bits8 },
  representation: ^lean_repr_fixed_precision_integer
}

data lean_facts_uint16: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_uint16,
  scalar: IntScalar { kind: Unsigned, width: Bits16 },
  representation: ^lean_repr_fixed_precision_integer
}

data lean_facts_uint32: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_uint32,
  scalar: IntScalar { kind: Unsigned, width: Bits32 },
  representation: ^lean_repr_fixed_precision_integer
}

data lean_facts_uint64: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_uint64,
  scalar: IntScalar { kind: Unsigned, width: Bits64 },
  representation: ^lean_repr_fixed_precision_integer
}

data lean_facts_usize: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_usize,
  scalar: IntScalar { kind: Unsigned, width: Pointer },
  representation: ^lean_repr_usize_platform_word
}

data lean_facts_bool: LeanPrimitiveFacts = LeanPrimitiveFacts {
  surface_spelling: ^lean_surface_spelling_bool,
  scalar: BoolScalar,
  representation: ^lean_repr_bool_inductive
}

data lean_mvp1_source_text: String = "def dec (n : Int32) : Int32 := n - 1\n  termination_by n"
data lean_primitive_facts_catalog: List<LeanPrimitiveFacts> = [
  lean_facts_int8,
  lean_facts_int16,
  lean_facts_int32,
  lean_facts_int64,
  lean_facts_uint8,
  lean_facts_uint16,
  lean_facts_uint32,
  lean_facts_uint64,
  lean_facts_usize,
  lean_facts_bool
]

data lean_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn lean_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn lean_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn lean_int_kind_node(kind: LeanIntKind) -> Node {
  match kind {
    Signed => lean_inhabitant_atom(id: ^lean_tag_signed)
    Unsigned => lean_inhabitant_atom(id: ^lean_tag_unsigned)
  }
}

fn lean_int_width_node(width: LeanIntWidth) -> Node {
  match width {
    Bits8 => lean_inhabitant_atom(id: ^lean_tag_bits8)
    Bits16 => lean_inhabitant_atom(id: ^lean_tag_bits16)
    Bits32 => lean_inhabitant_atom(id: ^lean_tag_bits32)
    Bits64 => lean_inhabitant_atom(id: ^lean_tag_bits64)
    Pointer => lean_inhabitant_atom(id: ^lean_tag_pointer)
  }
}

fn lean_scalar_node(scalar: LeanScalar) -> Node {
  match scalar {
    IntScalar { kind, width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        lean_named_edge(
          name: ^lean_scalar_field_classifier,
          target: lean_inhabitant_atom(id: ^lean_tag_scalar_int)
        ),
        lean_named_edge(name: ^lean_scalar_field_kind, target: lean_int_kind_node(kind: kind)),
        lean_named_edge(name: ^lean_scalar_field_width, target: lean_int_width_node(width: width))
      ],
      occurrence_id: SyntheticOccurrence
}
    BoolScalar => lean_inhabitant_atom(id: ^lean_tag_scalar_bool)
  }
}

fn lean_primitive_facts_node(facts: LeanPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      lean_named_edge(
        name: ^lean_facts_field_surface_spelling,
        target: lean_inhabitant_atom(id: facts.surface_spelling)
      ),
      lean_named_edge(
        name: ^lean_facts_field_scalar_classifier,
        target: lean_scalar_node(scalar: facts.scalar)
      ),
      lean_named_edge(
        name: ^lean_facts_field_representation,
        target: lean_inhabitant_atom(id: facts.representation)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn lean_primitive_inhabitant_node(id: Symbol, facts: LeanPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      lean_named_edge(name: ^lean_inhabitant_field_atom, target: lean_inhabitant_atom(id: id)),
      lean_named_edge(
        name: ^lean_inhabitant_field_facts,
        target: lean_primitive_facts_node(facts: facts)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn lean_inhabitant_int32_node() -> Node {
  lean_primitive_inhabitant_node(id: ^lean_inhabitant_int32, facts: lean_facts_int32)
}

fn lean_int_spec_facts(facts: LeanPrimitiveFacts, kind: LeanIntKind, width: LeanIntWidth) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: lean_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisWidth {}) {
          Holds { value: lean_int_width_node(width: width) }
      } else if axis == discriminant(v: ModelCoreFactAxisSignedness {}) {
          Holds { value: lean_int_kind_node(kind: kind) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: lean_inhabitant_atom(id: facts.representation) }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn lean_bool_spec_facts(facts: LeanPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: lean_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: lean_inhabitant_atom(id: facts.representation) }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

fn lean_primitive_bundle_from_facts(facts: LeanPrimitiveFacts) -> PrimitiveFactBundle {
  match facts.scalar {
    IntScalar { kind, width } => PrimitiveFactBundle {
      substrate_carrier: lean_primitive_facts_node(facts: facts),
      spec_facts: lean_int_spec_facts(facts: facts, kind: kind, width: width)
    }
    BoolScalar => PrimitiveFactBundle {
      substrate_carrier: lean_primitive_facts_node(facts: facts),
      spec_facts: lean_bool_spec_facts(facts: facts)
    }
  }
}

fn lean_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: lean_primitive_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: lean_primitive_bundle_from_facts(facts: facts)
      )
    }
  )
}

fn lean_catalog_surface_symbol_step(sym: Symbol, acc: Bool, facts: LeanPrimitiveFacts) -> Bool {
  acc || sym == facts.surface_spelling
}

fn lean_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: lean_primitive_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      lean_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn lean_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn lean_mvp1_token_class_tail() -> List<Symbol> {
  [
    ^lean_token_name_dec,
    ^lean_token_lparen,
    ^lean_token_name_n,
    ^lean_token_colon,
    ^lean_token_type_int32,
    ^lean_token_rparen,
    ^lean_token_colon,
    ^lean_token_type_int32,
    ^lean_token_assign,
    ^lean_token_name_n,
    ^lean_token_minus,
    ^lean_token_numeric_literal,
    ^lean_token_kw_termination_by,
    ^lean_token_name_n
  ]
}

fn lean_mvp1_formal_token_classes() -> List<Symbol> {
  Cons {
    head: ^lean_token_kw_def,
    tail: lean_mvp1_token_class_tail()
  }
}

fn lean_formal_rhs_from_token_classes(classes: List<Symbol>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: classes,
    empty: Empty,
    cons: fn(acc, token_class) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: token_class)
      )
    }
  )
}

fn lean_mvp1_def_dec_formal_production() -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: ^lean_production_mvp1_def_dec),
    rhs: lean_formal_rhs_from_token_classes(classes: lean_mvp1_formal_token_classes())
  }
}

data lean_mvp1_def_dec_formal_production_authority: FormalProduction = lean_mvp1_def_dec_formal_production()

fn lean_grammar_sequence_from_nonempty(
  head: Symbol,
  tail: List<Symbol>
) -> GrammarExpr {
  fold_list(
    xs: tail,
    empty: lean_grammar_terminal(token_class: head),
    cons: fn(acc, token_class) {
      Sequence {
        left: acc,
        right: lean_grammar_terminal(token_class: token_class)
      }
    }
  )
}

fn lean_mvp1_def_dec_parse_expr() -> GrammarExpr {
  lean_grammar_sequence_from_nonempty(
    head: ^lean_token_kw_def,
    tail: lean_mvp1_token_class_tail()
  )
}

fn lean_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: text }
  }
}

fn lean_numeric_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^lean_token_numeric_literal,
    pattern: OneOrMorePattern { element: CharClassPattern { class: DigitChar } }
  }
}

fn lean_wave1_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      lean_lex_rule(token_class: ^lean_token_kw_termination_by, text: "\n  termination_by "),
      lean_lex_rule(token_class: ^lean_token_assign, text: " := "),
      lean_lex_rule(token_class: ^lean_token_minus, text: " - "),
      lean_lex_rule(token_class: ^lean_token_kw_def, text: "def "),
      lean_lex_rule(token_class: ^lean_token_type_int32, text: "Int32"),
      lean_lex_rule(token_class: ^lean_token_name_dec, text: "dec "),
      lean_numeric_literal_lex_rule(),
      lean_lex_rule(token_class: ^lean_token_name_n, text: "n"),
      lean_lex_rule(token_class: ^lean_token_lparen, text: "("),
      lean_lex_rule(token_class: ^lean_token_colon, text: " : "),
      lean_lex_rule(token_class: ^lean_token_rparen, text: ")")
    ]
  }
}

fn lean_wave1_lex() -> LexRules {
  ModeledLexRules { root: lean_wave1_lex_rules() }
}

fn lean_wave1_lex_token_symbol(sym: Symbol) -> Bool {
  lex_rule_set_token_class_member(
    rules: lean_wave1_lex_rules(),
    token_class: sym
  )
}

fn lean_wave1_grammar_root() -> GrammarRoot {
  let start = GrammarProduction {
    name: ^lean_production_mvp1_def_dec,
    expression: lean_mvp1_def_dec_parse_expr(),
    emitted: grammar_atom(identity: ^lean_surface_def_item)
  }
  GrammarRoot {
    start: ^lean_production_mvp1_def_dec,
    productions: [start],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn lean_wave1_grammar() -> ParseGrammar {
  ModeledGrammar { root: lean_wave1_grammar_root() }
}

fn lean_ingest_grammar_schema() -> GrammarSchema {
  GrammarSchema {
    lex: lean_wave1_lex(),
    grammar: lean_wave1_grammar()
  }
}

fn lean_ingest_grammar_probe() -> GrammarSchemaProbeBinding {
  GrammarSchemaProbeBinding {
    schema: lean_ingest_grammar_schema(),
    probe: GrammarSchemaProbe {
      fixture: lean_mvp1_source_text,
      production: lean_mvp1_def_dec_formal_production(),
      expected_parse_surface: grammar_atom(identity: ^lean_surface_def_item)
    }
  }
}

data lean_ingest_grammar_probe_authority: GrammarSchemaProbeBinding = lean_ingest_grammar_probe()

fn lean_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      lean_catalog_surface_symbol(sym: sym) ||
        lean_wave1_lex_token_symbol(sym: sym) ||
        grammar_carries_symbol(grammar: lean_wave1_grammar(), sym: sym) ||
        sym == ^lean_mvp1_source_literal
    }
  }
}

fn lean_integer_algebra_witness_node(facts: LeanPrimitiveFacts, kind: LeanIntKind, width: LeanIntWidth) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      lean_named_edge(
        name: ^lean_witness_integer_commutative_ring,
        target: lean_inhabitant_atom(id: ^lean_witness_integer_commutative_ring)
      ),
      lean_named_edge(
        name: ^lean_witness_field_representation,
        target: lean_inhabitant_atom(id: facts.representation)
      ),
      lean_named_edge(
        name: ^lean_witness_field_signedness,
        target: lean_int_kind_node(kind: kind)
      ),
      lean_named_edge(
        name: ^lean_witness_field_width,
        target: lean_int_width_node(width: width)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn lean_bool_algebra_witness_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      lean_named_edge(
        name: ^lean_witness_bool_boolean_algebra,
        target: lean_inhabitant_atom(id: ^lean_witness_bool_boolean_algebra)
      ),
      lean_named_edge(
        name: ^lean_witness_field_representation,
        target: lean_inhabitant_atom(id: ^lean_repr_bool_inductive)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn lean_scalar_algebra_inhabitance(facts: LeanPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = lean_primitive_facts_node(facts: facts)
  match facts.scalar {

    IntScalar { kind, width } => AlgebraInhabitanceDecl {
      algebra: commutative_ring_type_node(inhabitant: inhabitant),
      inhabitant: inhabitant,
      witness: lean_integer_algebra_witness_node(facts: facts, kind: kind, width: width)
    }
    BoolScalar => AlgebraInhabitanceDecl {
      algebra: boolean_algebra_type_node(inhabitant: inhabitant),
      inhabitant: inhabitant,
      witness: lean_bool_algebra_witness_node()
    }
  }
}

fn lean_model_core_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: lean_primitive_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: lean_scalar_algebra_inhabitance(facts: facts))
    }
  )
}

fn lean_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: lean_wave1_primitive_fact_bundles(),
    inhabitance: lean_model_core_inhabitance_decls(),
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn lean_language_model_wave1() -> LanguageModel {
  LanguageModel {
    lex: lean_wave1_lex(),
    grammar: lean_wave1_grammar(),
    language_identity: ^lean_language_model_surface_id,
    canonical_symbols: lean_language_model_canonical_symbols(),
    core: lean_model_core_wave1()
  }
}
