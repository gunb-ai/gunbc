    cons: fn(acc, facts) {
      python_g1_2_snoc_primitive_bundle(
        acc: acc,
        registry: registry,
        subject_carrier: python_singleton_facts_node(facts: facts)
      )
    }
  )
}

fn python_g1_2_append_primitive_bundle_outcomes(
  left: Outcome<List<PrimitiveFactBundle>>,
  right: Outcome<List<PrimitiveFactBundle>>
) -> Outcome<List<PrimitiveFactBundle>> {
  match left {
    Accepted { value: l, diagnostics: _ } => match right {
      Accepted { value: r, diagnostics: d } =>
        Accepted { value: list_append(left: l, right: r), diagnostics: d }
      Rejected { diagnostics: d } =>
        Rejected { diagnostics: d }
    }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn python_g1_2_primitive_bundles_from_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  python_g1_2_append_primitive_bundle_outcomes(
    left: python_g1_2_append_primitive_bundle_outcomes(
      left: python_g1_2_append_primitive_bundle_outcomes(
        left: python_g1_2_append_primitive_bundle_outcomes(
          left: python_g1_2_integer_primitive_bundles_from_registry(registry: registry),
          right: python_g1_2_float_primitive_bundles_from_registry(registry: registry)
        ),
        right: python_g1_2_complex_primitive_bundles_from_registry(registry: registry)
      ),
      right: python_g1_2_bool_primitive_bundles_from_registry(registry: registry)
    ),
    right: python_g1_2_singleton_primitive_bundles_from_registry(registry: registry)
  )
}

fn python_g1_2_primitive_fact_bundles() -> Outcome<List<PrimitiveFactBundle>> {
  match python_g1_2_fact_bundle_registry() {
    Accepted { value: registry, diagnostics: _ } =>
      python_g1_2_primitive_bundles_from_registry(registry: registry)
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn python_integer_algebra_witness_node(facts: PythonIntegerPrimitiveFacts) -> Node {
  python_primitive_algebra_witness_node(
    witness_field_name: ^python_witness_int_ordered_ring_arbitrary_precision,
    witness_tag: ^python_witness_int_ordered_ring_arbitrary_precision,
    middle_field_name: ^python_facts_field_encoding,
    middle_field_value: facts.encoding,
    std_projection: facts.std_projection
  )
}

fn python_float_algebra_witness_node(facts: PythonFloatPrimitiveFacts) -> Node {
  python_primitive_algebra_witness_node(
    witness_field_name: ^python_witness_float_approximate_field,
    witness_tag: ^python_witness_float_approximate_field,
    middle_field_name: ^python_facts_field_machine_representation,
    middle_field_value: facts.machine_representation,
    std_projection: facts.std_projection
  )
}

fn python_bool_algebra_witness_node(facts: PythonBoolPrimitiveFacts) -> Node {
  python_primitive_algebra_witness_node(
    witness_field_name: ^python_witness_bool_boolean_algebra,
    witness_tag: ^python_witness_bool_boolean_algebra,
    middle_field_name: ^python_facts_field_encoding,
    middle_field_value: facts.encoding,
    std_projection: facts.std_projection
  )
}

fn python_integer_algebra_inhabitance(facts: PythonIntegerPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = python_integer_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: ordered_ring_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: python_integer_algebra_witness_node(facts: facts)
  }
}

fn python_float_algebra_inhabitance(facts: PythonFloatPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = python_float_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: approximate_field_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: python_float_algebra_witness_node(facts: facts)
  }
}

fn python_bool_algebra_inhabitance(facts: PythonBoolPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = python_bool_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: boolean_algebra_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: python_bool_algebra_witness_node(facts: facts)
  }
}

fn python_integer_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: python_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: python_integer_algebra_inhabitance(facts: facts))
    }
  )
}

fn python_float_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: python_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: python_float_algebra_inhabitance(facts: facts))
    }
  )
}

fn python_bool_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: python_bool_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: python_bool_algebra_inhabitance(facts: facts))
    }
  )
}

fn python_model_core_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  list_append(
    left: list_append(
      left: python_integer_algebra_inhabitance_decls(),
      right: python_float_algebra_inhabitance_decls()
    ),
    right: python_bool_algebra_inhabitance_decls()
  )
}

fn python_model_core() -> Outcome<ModelCore> {
  match python_g1_2_primitive_fact_bundles() {
    Accepted { value: primitives, diagnostics: d } =>
      Accepted {
        value: ModelCore {
          primitives: primitives,
          inhabitance: python_model_core_inhabitance_decls(),
          laws: [],
          effects: EffectSemanticsDecl { operations: [] },
          partiality: PartialitySemanticsDecl { operations: [] }
        },
        diagnostics: d
      }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn python_inhabitant_node(id: Symbol, facts: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(name: ^python_inhabitant_field_atom, target: python_inhabitant_atom(id: id)),
      python_named_edge(name: ^python_inhabitant_field_facts, target: facts)
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn python_int_inhabitant_node() -> Node {
  python_inhabitant_node(
    id: ^python_inhabitant_int,
    facts: python_integer_facts_node(facts: python_facts_int)
  )
}

fn python_float_inhabitant_node() -> Node {
  python_inhabitant_node(
    id: ^python_inhabitant_float,
    facts: python_float_facts_node(facts: python_facts_float)
  )
}

fn python_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(name: ^python_inhabitant_field_int, target: python_int_inhabitant_node()),
      python_named_edge(name: ^python_inhabitant_field_float, target: python_float_inhabitant_node())
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn python_int_zip_fold_closure_edges() -> List<Edge> {
  [
    python_named_edge(
      name: ^python_inhabitant_field_add_fn,
      target: python_emitted_add_fn_node()
    ),
    python_named_edge(
      name: ^python_coercion_field_int_inhabitant_atom,
      target: python_inhabitant_atom(id: ^python_inhabitant_int)
    ),
    python_named_edge(
      name: ^python_coercion_field_int_facts,
      target: python_integer_facts_node(facts: python_facts_int)
    ),
    python_named_edge(
      name: ^python_coercion_field_int_spelling,
      target: python_inhabitant_atom(id: ^python_surface_spelling_int)
    ),
    python_named_edge(
      name: ^python_coercion_field_int_encoding,
      target: python_inhabitant_atom(id: ^python_repr_int_arbitrary_precision)
    ),
    python_named_edge(
      name: ^python_coercion_field_int_std_projection,
      target: python_inhabitant_atom(id: ^std_projection_additive_numeric)
    )
  ]
}

fn python_coercion_candidate_edges() -> List<Edge> {
  list_append(
    left: python_declared_inhabitants_root().children,
    right: python_int_zip_fold_closure_edges()
  )
}

fn python_add_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: python_coercion_candidate_edges(),
    occurrence_id: SyntheticOccurrence
}
}

fn python_selection_policy_node() -> Node {
  python_int_inhabitant_node()
}

fn python_emitted_add_fn_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: python_int_inhabitant_node() },
      Edge { label: Positional, target: python_int_inhabitant_node() },
      Edge { label: Positional, target: python_int_inhabitant_node() }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn python_concrete_token_node(token: ConcreteSyntaxToken) -> Node {

  concrete_syntax_token_to_node(token: token)
}

fn python_serialize_source_children() -> List<Edge> {
  list_append(
    left: [
      python_named_edge(name: ^serialize_source_field_source_text, target: python_inhabitant_atom(id: ^python_source_literal)),
      python_named_edge(name: ^serialize_source_field_source_grammar, target: python_inhabitant_atom(id: ^python_production_fn_add))
    ],
    right: [
      python_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: python_concrete_tokens(),
          token_to_node: python_concrete_token_node
        )
      )
    ]
  )
}

fn python_serialize_source_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: python_serialize_source_children(),
    occurrence_id: SyntheticOccurrence
}
}

fn python_formal_rhs_from_token_classes() -> List<FormalGrammarSymbol> {
  fold_list(
    xs: python_concrete_tokens(),
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn python_formal_symbol_to_grammar_expr(sym: FormalGrammarSymbol) -> GrammarExpr {
  formal_grammar_symbol_to_grammar_expr(sym: sym)
}

fn python_formal_epsilon_grammar_expr() -> GrammarExpr {
  Optional {
    element: Terminal { token_class: ^python_formal_epsilon_shim_terminal, stamp: StampClass }
  }
}

type PythonFormalRhsToExprState
  = PythonFormalRhsToExprUninitialized
  | PythonFormalRhsToExprReady { expr: GrammarExpr }

fn python_formal_rhs_to_grammar_expr(rhs: List<FormalGrammarSymbol>) -> GrammarExpr {
  match fold_list(
    xs: rhs,
    empty: PythonFormalRhsToExprUninitialized,
    cons: fn(state, sym) {
      let piece = python_formal_symbol_to_grammar_expr(sym: sym)
      match state {
        PythonFormalRhsToExprUninitialized =>
          PythonFormalRhsToExprReady { expr: piece }
        PythonFormalRhsToExprReady { expr: acc } =>
          PythonFormalRhsToExprReady {
            expr: Sequence { left: acc, right: piece }
          }
      }
    }
  ) {
    PythonFormalRhsToExprUninitialized => python_formal_epsilon_grammar_expr()
    PythonFormalRhsToExprReady { expr: result } => result
  }
}

type PythonFormalAltChoiceState
  = PythonFormalAltChoiceUninitialized
  | PythonFormalAltChoiceReady { expr: GrammarExpr }

fn python_formal_alternatives_to_choice_expr(alts: List<List<FormalGrammarSymbol>>) -> GrammarExpr {
  match fold_list(
    xs: alts,
    empty: PythonFormalAltChoiceUninitialized,
    cons: fn(state, rhs) {
      let alt_expr = python_formal_rhs_to_grammar_expr(rhs: rhs)
      match state {
        PythonFormalAltChoiceUninitialized =>
          PythonFormalAltChoiceReady { expr: alt_expr }
        PythonFormalAltChoiceReady { expr: acc } =>
          PythonFormalAltChoiceReady {
            expr: Choice { left: acc, right: alt_expr }
          }
      }
    }
  ) {
    PythonFormalAltChoiceUninitialized => python_formal_epsilon_grammar_expr()
    PythonFormalAltChoiceReady { expr: result } => result
  }
}

fn python_formal_rhs_alternatives_accum_empty() -> List<List<FormalGrammarSymbol>> {
  Empty
}

fn python_formal_collect_rhs_alternative(
  acc: List<List<FormalGrammarSymbol>>,
  prod: FormalProduction
) -> List<List<FormalGrammarSymbol>> {
  list_snoc_item(xs: acc, item: prod.rhs)
}

fn python_formal_rhs_alternatives_from_productions(
  prods: List<FormalProduction>
) -> List<List<FormalGrammarSymbol>> {
  fold_list(
    xs: prods,
    empty: python_formal_rhs_alternatives_accum_empty(),
    cons: python_formal_collect_rhs_alternative
  )
}

fn python_formal_productions_to_grammar_expr(prods: List<FormalProduction>) -> GrammarExpr {
  python_formal_alternatives_to_choice_expr(
    alts: python_formal_rhs_alternatives_from_productions(prods: prods)
  )
}

fn python_formal_production_alts(
  head: FormalProduction,
  alts: List<FormalProduction>
) -> List<FormalProduction> {
  list_append(left: [head], right: alts)
}

fn python_formal_productions_to_grammar_production(
  head: FormalProduction,
  alts: List<FormalProduction>,
  emitted: Symbol
) -> GrammarProduction {
  GrammarProduction {
    name: head.lhs.identity,
    expression: python_formal_productions_to_grammar_expr(
      prods: python_formal_production_alts(head: head, alts: alts)
    ),
    emitted: python_grammar_atom(id: emitted)
  }
}

fn python_formal_production_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: ^python_production_fn_add,
    rhs: python_formal_rhs_from_token_classes()
  )
}

fn python_formal_productions() -> List<FormalProduction> {
  [python_formal_production_fn_add()]
}

fn python_grammar_production_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: ^python_production_fn_add,
    expression: python_formal_productions_to_grammar_expr(
      prods: [python_formal_production_fn_add()]
    ),
    emitted: python_emitted_add_fn_node()
  }
}

fn python_grammar_relation_row() -> PythonGrammarRelationRow {
  PythonGrammarRelationRow {
    production: python_formal_production_fn_add(),
    emitted: python_emitted_add_fn_node(),
    tokens: python_concrete_tokens()
  }
}

fn python_grammar_relation_row_node(row: PythonGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(name: ^grammar_relation_field_production, target: formal_production_to_node(production: row.production)),
      python_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      python_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: python_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn python_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: ^python_relation_rule_fn_add,
        target: python_grammar_relation_row_node(row: python_grammar_relation_row())
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn python_emit_host_runtime_primitive_type_node() -> Node {
  Node {
