fn python_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^python_binding_fn_add, "add"),
      ^python_binding_param_x,
      "x"
    ),
    ^python_binding_param_y,
    "y"
  )
}

fn python_target_model() -> TargetModel {
  TargetModel {
    bundle: python_target_model_node(),
    lex: python_lex(),
    binding_spellings: python_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: python_source_text,
    runtime_row: python_runtime_row()
  }
}

fn python_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule { token_class: token_class, pattern: LiteralPattern { text: text } }
}

fn python_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn python_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^python_token_ident,
    pattern: python_ident_lex_pattern()
  }
}

fn python_nonzero_digit_char_pattern() -> LexPattern {
  ChoicePattern {
    left: CharPattern { char: 49 },
    right: ChoicePattern {
      left: CharPattern { char: 50 },
      right: ChoicePattern {
        left: CharPattern { char: 51 },
        right: ChoicePattern {
          left: CharPattern { char: 52 },
          right: ChoicePattern {
            left: CharPattern { char: 53 },
            right: ChoicePattern {
              left: CharPattern { char: 54 },
              right: ChoicePattern {
                left: CharPattern { char: 55 },
                right: ChoicePattern {
                  left: CharPattern { char: 56 },
                  right: CharPattern { char: 57 }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn python_decimal_int_literal_pattern() -> LexPattern {
  ChoicePattern {
    left: LiteralPattern { text: "0" },
    right: SequencePattern {
      left: python_nonzero_digit_char_pattern(),
      right: RepeatPattern { element: CharClassPattern { class: DigitChar } }
    }
  }
}

fn python_int_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^python_token_int_literal,
    pattern: python_decimal_int_literal_pattern()
  }
}

fn python_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      python_lex_rule(token_class: ^python_token_rparen_suite_indent, text: "):\n    "),
      python_lex_rule(token_class: ^python_token_colon_if_suite_indent, text: ":\n        "),
      python_lex_rule(token_class: ^python_token_newline_if_stmt, text: "\n    if "),
      python_lex_rule(token_class: ^python_token_newline_return_inner, text: "\n        return "),
      python_lex_rule(token_class: ^python_token_newline_return_outer, text: "\n    return "),
      python_lex_rule(token_class: ^python_token_kw_def, text: "def "),
      python_lex_rule(token_class: ^python_token_kw_return, text: "return "),
      python_lex_rule(token_class: ^python_token_kw_if, text: "if "),
      python_int_literal_lex_rule(),
      python_ident_lex_rule(),
      python_lex_rule(token_class: ^python_token_equal, text: " = "),
      python_lex_rule(token_class: ^python_token_plus, text: " + "),
      python_lex_rule(token_class: ^python_token_greater, text: " > "),
      python_lex_rule(token_class: ^python_token_lparen, text: "("),
      python_lex_rule(token_class: ^python_token_comma, text: ", "),
      python_lex_rule(token_class: ^python_token_rparen, text: ")"),
      python_lex_rule(token_class: ^python_token_colon, text: ": ")
    ]
  }
}

fn python_lex() -> LexRules {
  ModeledLexRules { root: python_lex_rules() }
}

fn python_grammar_atom(id: Symbol) -> Node {
  python_inhabitant_atom(id: id)
}

fn python_grammar_root() -> GrammarRoot {
  GrammarRoot {
    start: ^python_production_fn_def,
    productions: [
      python_grammar_production_fn_add(),
      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_fn_def,
          rhs: [
            grammar_formal_terminal(identity: ^python_token_kw_def),
            grammar_formal_terminal(identity: ^python_token_ident),
            grammar_formal_terminal(identity: ^python_token_lparen),
            grammar_formal_terminal(identity: ^python_token_ident),
            grammar_formal_terminal(identity: ^python_token_rparen_suite_indent),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_suite)
          ]
        ),
        alts: Empty,
        emitted: ^python_surface_fn_item
      ),

      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_suite,
          rhs: [
            grammar_formal_nonterminal_occurrence(identity: ^python_production_stmt),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_suite)
          ]
        ),
        alts: [
          grammar_formal_production(
            lhs: ^python_production_suite,
            rhs: [grammar_formal_nonterminal_occurrence(identity: ^python_production_stmt)]
          )
        ],
        emitted: ^python_surface_suite
      ),
      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_stmt,
          rhs: [grammar_formal_nonterminal_occurrence(identity: ^python_production_assign_stmt)]
        ),
        alts: [
          grammar_formal_production(
            lhs: ^python_production_stmt,
            rhs: [grammar_formal_nonterminal_occurrence(identity: ^python_production_if_stmt)]
          ),
          grammar_formal_production(
            lhs: ^python_production_stmt,
            rhs: [grammar_formal_nonterminal_occurrence(identity: ^python_production_return_stmt)]
          )
        ],
        emitted: ^python_surface_stmt
      ),
      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_assign_stmt,
          rhs: [
            grammar_formal_terminal(identity: ^python_token_ident),
            grammar_formal_terminal(identity: ^python_token_equal),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_additive)
          ]
        ),
        alts: Empty,
        emitted: ^python_surface_assign_stmt
      ),

      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_if_stmt,
          rhs: [
            grammar_formal_terminal(identity: ^python_token_newline_if_stmt),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_comparison),
            grammar_formal_terminal(identity: ^python_token_colon_if_suite_indent),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_return_stmt)
          ]
        ),
        alts: Empty,
        emitted: ^python_surface_if_stmt
      ),
      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_return_stmt,
          rhs: [
            grammar_formal_terminal(identity: ^python_token_newline_return_inner),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_primary)
          ]
        ),
        alts: [
          grammar_formal_production(
            lhs: ^python_production_return_stmt,
            rhs: [
              grammar_formal_terminal(identity: ^python_token_newline_return_outer),
              grammar_formal_nonterminal_occurrence(identity: ^python_production_primary)
            ]
          ),
          grammar_formal_production(
            lhs: ^python_production_return_stmt,
            rhs: [
              grammar_formal_terminal(identity: ^python_token_kw_return),
              grammar_formal_nonterminal_occurrence(identity: ^python_production_primary)
            ]
          )
        ],
        emitted: ^python_surface_return_stmt
      ),
      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_comparison,
          rhs: [
            grammar_formal_nonterminal_occurrence(identity: ^python_production_additive),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_comparison_tail)
          ]
        ),
        alts: Empty,
        emitted: ^python_surface_comparison
      ),

      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_comparison_tail,
          rhs: [
            grammar_formal_terminal(identity: ^python_token_greater),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_additive)
          ]
        ),
        alts: [grammar_formal_production(lhs: ^python_production_comparison_tail, rhs: Empty)],
        emitted: ^python_surface_comparison_tail
      ),
      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_additive,
          rhs: [
            grammar_formal_nonterminal_occurrence(identity: ^python_production_primary),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_additive_tail)
          ]
        ),
        alts: Empty,
        emitted: ^python_surface_additive
      ),

      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_additive_tail,
          rhs: [
            grammar_formal_terminal(identity: ^python_token_plus),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_primary),
            grammar_formal_nonterminal_occurrence(identity: ^python_production_additive_tail)
          ]
        ),
        alts: [grammar_formal_production(lhs: ^python_production_additive_tail, rhs: Empty)],
        emitted: ^python_surface_additive_tail
      ),
      python_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^python_production_primary,
          rhs: [grammar_formal_terminal(identity: ^python_token_ident)]
        ),
        alts: [
          grammar_formal_production(
            lhs: ^python_production_primary,
            rhs: [grammar_formal_terminal(identity: ^python_token_int_literal)]
          )
        ],
        emitted: ^python_surface_primary
      )
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn python_grammar() -> ParseGrammar {
  ModeledGrammar { root: python_grammar_root() }
}

fn python_lex_token_symbol(sym: Symbol) -> Bool {
  lex_rule_set_token_class_member(
    rules: python_lex_rules(),
    token_class: sym
  )
}

fn python_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  python_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: python_integer_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn python_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  python_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: python_float_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn python_complex_catalog_surface_symbol(sym: Symbol) -> Bool {
  python_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: python_complex_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn python_bool_catalog_surface_symbol(sym: Symbol) -> Bool {
  python_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: python_bool_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn python_singleton_catalog_surface_symbol(sym: Symbol) -> Bool {
  python_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: python_singleton_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn python_catalog_surface_symbol(sym: Symbol) -> Bool {
  python_integer_catalog_surface_symbol(sym: sym) ||
    python_float_catalog_surface_symbol(sym: sym) ||
    python_complex_catalog_surface_symbol(sym: sym) ||
    python_bool_catalog_surface_symbol(sym: sym) ||
    python_singleton_catalog_surface_symbol(sym: sym)
}

fn python_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      python_catalog_surface_symbol(sym: sym) ||
        python_lex_token_symbol(sym: sym) ||
        grammar_carries_symbol(grammar: python_grammar(), sym: sym) ||
        sym == ^python_surface_fn_item ||
        sym == ^python_production_fn_add ||
        sym == ^python_source_literal
    }
  }
}

fn python_language_model() -> Outcome<LanguageModel> {
  match python_model_core() {
    Accepted { value: core, diagnostics: d } =>
      Accepted {
        value: LanguageModel {
          lex: python_lex(),
          grammar: python_grammar(),
          language_identity: ^python_language_model_surface_id,
          canonical_symbols: python_language_model_canonical_symbols(),
          core: core
        },
        diagnostics: d
      }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}
