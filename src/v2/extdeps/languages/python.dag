fn python_g1_2_singleton_fact_bundle_entries(
  facts: PythonSingletonPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  python_g1_2_pair_axis_fact_bundle_entries(
    carrier: python_singleton_facts_node(facts: facts),
    surface_spelling: facts.surface_spelling,
    encoding_value: ^python_repr_singleton_sole_inhabitant
  )
}

fn python_g1_2_integer_catalog_entries() -> List<PerLanguageFactBundleEntry> {
  python_per_language_fact_bundle_entries_from_catalog_rows(
    rows: python_integer_facts_catalog,
    row_to_entries: fn(facts) {
      python_g1_2_integer_fact_bundle_entries(facts: facts)
    }
  )
}

fn python_g1_2_float_catalog_entries() -> List<PerLanguageFactBundleEntry> {
  python_per_language_fact_bundle_entries_from_catalog_rows(
    rows: python_float_facts_catalog,
    row_to_entries: fn(facts) {
      python_g1_2_float_fact_bundle_entries(facts: facts)
    }
  )
}

fn python_g1_2_complex_catalog_entries() -> List<PerLanguageFactBundleEntry> {
  python_per_language_fact_bundle_entries_from_catalog_rows(
    rows: python_complex_facts_catalog,
    row_to_entries: fn(facts) {
      python_g1_2_complex_fact_bundle_entries(facts: facts)
    }
  )
}

fn python_g1_2_bool_catalog_entries() -> List<PerLanguageFactBundleEntry> {
  python_per_language_fact_bundle_entries_from_catalog_rows(
    rows: python_bool_facts_catalog,
    row_to_entries: fn(facts) {
      python_g1_2_bool_fact_bundle_entries(facts: facts)
    }
  )
}

fn python_g1_2_singleton_catalog_entries() -> List<PerLanguageFactBundleEntry> {
  python_per_language_fact_bundle_entries_from_catalog_rows(
    rows: python_singleton_facts_catalog,
    row_to_entries: fn(facts) {
      python_g1_2_singleton_fact_bundle_entries(facts: facts)
    }
  )
}

fn python_g1_2_fact_bundle_entries() -> List<PerLanguageFactBundleEntry> {
  list_append(
    left: list_append(
      left: list_append(
        left: list_append(
          left: python_g1_2_integer_catalog_entries(),
          right: python_g1_2_float_catalog_entries()
        ),
        right: python_g1_2_complex_catalog_entries()
      ),
      right: python_g1_2_bool_catalog_entries()
    ),
    right: python_g1_2_singleton_catalog_entries()
  )
}

fn python_g1_2_insert_fact_bundle_entry(
  registry: PerLanguageFactBundleRegistry,
  entry: PerLanguageFactBundleEntry
) -> Outcome<PerLanguageFactBundleRegistry> {
  insert_per_language_fact_bundle_entry(
    registry: registry,
    key: entry.key,
    fact_value: entry.fact_value
  )
}

fn python_g1_2_insert_entries(
  registry: Outcome<PerLanguageFactBundleRegistry>,
  entry: PerLanguageFactBundleEntry
) -> Outcome<PerLanguageFactBundleRegistry> {
  match registry {
    Accepted { value: r, diagnostics: _ } =>
      python_g1_2_insert_fact_bundle_entry(registry: r, entry: entry)
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn python_g1_2_fact_bundle_registry() -> Outcome<PerLanguageFactBundleRegistry> {
  fold_list(
    xs: python_g1_2_fact_bundle_entries(),
    empty: outcome_accepted(value: empty_per_language_fact_bundle_registry()),
    cons: fn(acc, entry) {
      python_g1_2_insert_entries(registry: acc, entry: entry)
    }
  )
}

fn python_g1_2_snoc_primitive_bundle(
  acc: Outcome<List<PrimitiveFactBundle>>,
  registry: PerLanguageFactBundleRegistry,
  subject_carrier: Node
) -> Outcome<List<PrimitiveFactBundle>> {
  match acc {
    Accepted { value: bundles, diagnostics: _ } => match primitive_fact_bundle_for_subject(
      registry: registry,
      subject_carrier: subject_carrier,
      target: python_target_model()
    ) {
      Accepted { value: bundle, diagnostics: d } =>
        Accepted {
          value: list_snoc_item(xs: bundles, item: bundle),
          diagnostics: d
        }
      Rejected { diagnostics: d } =>
        Rejected { diagnostics: d }
    }
    Rejected { diagnostics: d } =>
      Rejected { diagnostics: d }
  }
}

fn python_g1_2_integer_primitive_bundles_from_registry(
  registry: PerLanguageFactBundleRegistry
) -> Outcome<List<PrimitiveFactBundle>> {
  fold_list(
    xs: python_integer_facts_catalog,
    empty: outcome_accepted(value: Empty),
    cons: fn(acc, facts) {
      python_g1_2_snoc_primitive_bundle(
        acc: acc,
        registry: registry,
        subject_carrier: python_integer_facts_node(facts: facts)
      )
    }
  )
}

fn python_g1_2_float_primitive_bundles_from_registry(
