fn python_target_model_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(name: ^target_model_edge_selection_policy, target: python_selection_policy_node()),
      python_named_edge(name: ^target_model_edge_declared_inhabitants, target: python_add_declared_inhabitants_root()),
      python_named_edge(name: ^target_model_edge_translation_rules, target: python_translation_rules_node()),
      python_named_edge(name: ^target_model_edge_serialize_source, target: python_serialize_source_node())
    ],
