module v2.extdeps.languages.python


type PythonSingletonKind
  = NoneT | NotImplementedT | EllipsisT

type PythonScalar
  = IntScalar | FloatScalar | ComplexScalar | BoolScalar | Singleton { kind: PythonSingletonKind }

type PythonCost {
  operation_cost: Int
  allocation_cost: Int
}

type PythonGrammarRelationRow {
  production: FormalProduction
  emitted: Node
  tokens: List<ConcreteSyntaxToken>
}

type PythonIntegerPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type PythonFloatPrimitiveFacts {
  surface_spelling: Symbol
  machine_representation: Symbol
  std_projection: Symbol
}

type PythonComplexPrimitiveFacts {
  surface_spelling: Symbol
  component_machine_representation: Symbol
  std_projection: Symbol
}

type PythonBoolPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type PythonSingletonPrimitiveFacts {
  surface_spelling: Symbol
  kind: PythonSingletonKind
  std_projection: Symbol
}

data python_integer_algebra_inhabitance_python_facts_int: AlgebraInhabitanceDecl = python_integer_algebra_inhabitance(facts: python_facts_int)
data python_atom_realization_symbol_node: Node = python_inhabitant_atom(id: ^python_atom_realization_symbol)

data python_source_text: String = "def add(x, y): return x + y"

fn python_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^python_token_kw_def },
    BoundToken { token_class: ^python_token_ident, binding: ^python_binding_fn_add },
    FixedToken { token_class: ^python_token_lparen },
    BoundToken { token_class: ^python_token_ident, binding: ^python_binding_param_x },
    FixedToken { token_class: ^python_token_comma },
    BoundToken { token_class: ^python_token_ident, binding: ^python_binding_param_y },
    FixedToken { token_class: ^python_token_rparen },
    FixedToken { token_class: ^python_token_colon },
    FixedToken { token_class: ^python_token_kw_return },
    BoundToken { token_class: ^python_token_ident, binding: ^python_binding_param_x },
    FixedToken { token_class: ^python_token_plus },
    BoundToken { token_class: ^python_token_ident, binding: ^python_binding_param_y }
  ]
}

data python_facts_int: PythonIntegerPrimitiveFacts = PythonIntegerPrimitiveFacts {
  surface_spelling: ^python_surface_spelling_int,
  encoding: ^python_repr_int_arbitrary_precision,
  std_projection: ^std_projection_additive_numeric
}

data python_facts_float: PythonFloatPrimitiveFacts = PythonFloatPrimitiveFacts {
  surface_spelling: ^python_surface_spelling_float,
  machine_representation: ^python_repr_float_machine_double_precision,
  std_projection: ^python_std_projection_float
}

data python_facts_complex: PythonComplexPrimitiveFacts = PythonComplexPrimitiveFacts {
  surface_spelling: ^python_surface_spelling_complex,
  component_machine_representation: ^python_repr_complex_pair_machine_double_precision,
  std_projection: ^python_std_projection_complex
}

data python_facts_bool: PythonBoolPrimitiveFacts = PythonBoolPrimitiveFacts {
  surface_spelling: ^python_surface_spelling_bool,
  encoding: ^python_repr_bool_int_subtype,
  std_projection: ^python_std_projection_bool
}

data python_facts_none: PythonSingletonPrimitiveFacts = PythonSingletonPrimitiveFacts {
  surface_spelling: ^python_surface_spelling_none,
  kind: NoneT,
  std_projection: ^python_std_projection_none
}

data python_facts_notimplemented: PythonSingletonPrimitiveFacts = PythonSingletonPrimitiveFacts {
  surface_spelling: ^python_surface_spelling_notimplemented,
  kind: NotImplementedT,
  std_projection: ^python_std_projection_notimplemented
}

data python_facts_ellipsis: PythonSingletonPrimitiveFacts = PythonSingletonPrimitiveFacts {
  surface_spelling: ^python_surface_spelling_ellipsis,
  kind: EllipsisT,
  std_projection: ^python_std_projection_ellipsis
}

data python_integer_facts_catalog: List<PythonIntegerPrimitiveFacts> = [
  python_facts_int
]

data python_float_facts_catalog: List<PythonFloatPrimitiveFacts> = [
  python_facts_float
]

data python_complex_facts_catalog: List<PythonComplexPrimitiveFacts> = [
  python_facts_complex
]

data python_bool_facts_catalog: List<PythonBoolPrimitiveFacts> = [
  python_facts_bool
]

data python_singleton_facts_catalog: List<PythonSingletonPrimitiveFacts> = [
  python_facts_none,
  python_facts_notimplemented,
  python_facts_ellipsis
]

data py_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn python_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn python_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn python_primitive_facts_node(
  surface_spelling: Symbol,
  middle_field_name: Symbol,
  middle_field_value: Symbol,
  std_projection: Symbol
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: ^python_facts_field_surface_spelling,
        target: python_inhabitant_atom(id: surface_spelling)
      ),
      python_named_edge(
        name: middle_field_name,
        target: python_inhabitant_atom(id: middle_field_value)
      ),
      python_named_edge(
        name: ^facts_field_std_projection,
        target: python_inhabitant_atom(id: std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn python_primitive_algebra_witness_node(
  witness_field_name: Symbol,
  witness_tag: Symbol,
  middle_field_name: Symbol,
  middle_field_value: Symbol,
  std_projection: Symbol
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      python_named_edge(
        name: witness_field_name,
        target: python_inhabitant_atom(id: witness_tag)
      ),
      python_named_edge(
        name: middle_field_name,
        target: python_inhabitant_atom(id: middle_field_value)
      ),
      python_named_edge(
        name: ^facts_field_std_projection,
        target: python_inhabitant_atom(id: std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn python_catalog_surface_symbol_in_rows<T>(
  sym: Symbol,
  rows: List<T>,
  row_surface_spelling: fn(T) -> Symbol
) -> Bool {
  fold_list(
    xs: rows,
    empty: false,
    cons: fn(acc, row) {
      acc || sym == row_surface_spelling(row)
    }
  )
}

fn python_per_language_fact_bundle_entries_from_catalog_rows<T>(
  rows: List<T>,
  row_to_entries: fn(T) -> List<PerLanguageFactBundleEntry>
) -> List<PerLanguageFactBundleEntry> {
  fold_list(
    xs: rows,
    empty: Empty,
    cons: fn(acc, row) {
      list_append(left: acc, right: row_to_entries(row))
    }
  )
}

fn python_g1_2_pair_axis_fact_bundle_entries(
  carrier: Node,
  surface_spelling: Symbol,
  encoding_value: Symbol
) -> List<PerLanguageFactBundleEntry> {
  [
    python_g1_2_fact_bundle_entry(
      subject_carrier: carrier,
      fact_axis: ModelCoreFactAxisSurfaceSpelling {},
      fact_value: python_inhabitant_atom(id: surface_spelling)
    ),
    python_g1_2_fact_bundle_entry(
      subject_carrier: carrier,
      fact_axis: ModelCoreFactAxisEncoding {},
      fact_value: python_inhabitant_atom(id: encoding_value)
    )
  ]
}

fn python_integer_facts_node(facts: PythonIntegerPrimitiveFacts) -> Node {
  python_primitive_facts_node(
    surface_spelling: facts.surface_spelling,
    middle_field_name: ^python_facts_field_encoding,
    middle_field_value: facts.encoding,
    std_projection: facts.std_projection
  )
}

fn python_float_facts_node(facts: PythonFloatPrimitiveFacts) -> Node {
  python_primitive_facts_node(
    surface_spelling: facts.surface_spelling,
    middle_field_name: ^python_facts_field_machine_representation,
    middle_field_value: facts.machine_representation,
    std_projection: facts.std_projection
  )
}

fn python_complex_facts_node(facts: PythonComplexPrimitiveFacts) -> Node {
  python_primitive_facts_node(
    surface_spelling: facts.surface_spelling,
    middle_field_name: ^python_facts_field_component_machine_representation,
    middle_field_value: facts.component_machine_representation,
    std_projection: facts.std_projection
  )
}

fn python_bool_facts_node(facts: PythonBoolPrimitiveFacts) -> Node {
  python_primitive_facts_node(
    surface_spelling: facts.surface_spelling,
    middle_field_name: ^python_facts_field_encoding,
    middle_field_value: facts.encoding,
    std_projection: facts.std_projection
  )
}

fn python_singleton_facts_node(facts: PythonSingletonPrimitiveFacts) -> Node {
  python_primitive_facts_node(
    surface_spelling: facts.surface_spelling,
    middle_field_name: ^python_facts_field_singleton_kind,
    middle_field_value: discriminant(v: facts.kind),
    std_projection: facts.std_projection
  )
}

fn python_g1_2_fact_bundle_key(subject_carrier: Node, fact_axis: ModelCorePrimitiveFactAxis) -> PerLanguageFactBundleKey {
  PerLanguageFactBundleKey {
    subject_carrier: subject_carrier,
    target: python_target_model(),
    fact_axis: fact_axis
  }
}

fn python_g1_2_fact_bundle_entry(
  subject_carrier: Node,
  fact_axis: ModelCorePrimitiveFactAxis,
  fact_value: Node
) -> PerLanguageFactBundleEntry {
  PerLanguageFactBundleEntry {
    key: python_g1_2_fact_bundle_key(
      subject_carrier: subject_carrier,
      fact_axis: fact_axis
    ),
    fact_value: fact_value
  }
}

fn python_g1_2_integer_fact_bundle_entries(
  facts: PythonIntegerPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  python_g1_2_pair_axis_fact_bundle_entries(
    carrier: python_integer_facts_node(facts: facts),
    surface_spelling: facts.surface_spelling,
    encoding_value: facts.encoding
  )
}

