  facts: PythonFloatPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  python_g1_2_pair_axis_fact_bundle_entries(
    carrier: python_float_facts_node(facts: facts),
    surface_spelling: facts.surface_spelling,
    encoding_value: facts.machine_representation
  )
}

fn python_g1_2_complex_fact_bundle_entries(
  facts: PythonComplexPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  python_g1_2_pair_axis_fact_bundle_entries(
    carrier: python_complex_facts_node(facts: facts),
    surface_spelling: facts.surface_spelling,
    encoding_value: facts.component_machine_representation
  )
