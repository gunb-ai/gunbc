module v2.extdeps.languages.rust_sg2_mode2_test

import std.algebra { Empty }
import std.occurrence_identity { OccurrenceSynthetic }

import v2.std.compilers.lexing { ModeledLexRules }
import v2.std.compilers.target_model {
  ProducedDeclUnwired,
  TargetModel,
  target_model_emit_transforms_empty
}
import v2.std.host_transport { target_emit_host_runtime_row_unconfigured }
import v2.std.node { Conj, Node, TypeNode }

import v2.extdeps.languages.rust {
  rust_named_edge,
  rust_sg2_binding_spellings,
  rust_sg2_lex_rules,
  rust_type_expression_projection_bundle_node
}

/// Minimal TargetModel for sg2_mode2 non-grammar emit tests.
///
/// Reads:         binding_spellings (atom spellings), lex (fixed-token spellings),
///                bundle type_expression_projection edge (translate/serialize),
///                bundle translation_rules edge (measure budget).
/// Unread and omitted: selection_policy, declared_inhabitants,
///                collection_realization, serialize_source, reference_layer_tokens,
///                use_site_ownership_realizations, signature_realizations.
fn rust_sg2_mode2_shared_target_model() -> TargetModel {
  TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: Node {
      kind: TypeNode { connective: Conj },
      children: [
        rust_named_edge(
          name: ^target_model_edge_type_expression_projection,
          target: rust_type_expression_projection_bundle_node()
        ),
        rust_named_edge(
          name: ^target_model_edge_translation_rules,
          target: Node {
            kind: TypeNode { connective: Conj },
            children: Empty,
            occurrence_id: OccurrenceSynthetic
          }
        )
      ],
      occurrence_id: OccurrenceSynthetic
    },
    lex: ModeledLexRules { root: rust_sg2_lex_rules() },
    binding_spellings: rust_sg2_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}
