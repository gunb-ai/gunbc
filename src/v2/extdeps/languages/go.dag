fn go_int_zip_fold_closure_edges() -> List<Edge> {
  [
    go_named_edge(
      name: ^go_inhabitant_field_add_fn,
      target: go_emitted_add_fn_node()
    ),
    go_named_edge(
      name: ^go_coercion_field_int_inhabitant_atom,
      target: go_inhabitant_atom(id: ^go_inhabitant_int)
    ),
    go_named_edge(
      name: ^go_coercion_field_int_facts,
      target: go_integer_facts_node(facts: go_facts_int)
    ),
    go_named_edge(
      name: ^go_coercion_field_int_spelling,
