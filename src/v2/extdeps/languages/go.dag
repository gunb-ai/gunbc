fn go_complex_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  []
}

fn go_bool_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  [
    go_bool_algebra_inhabitance()
  ]
}

fn go_model_core_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  list_append(
    left: list_append(
      left: list_append(
        left: list_append(
          left: go_integer_algebra_inhabitance_decls(),
          right: go_float_algebra_inhabitance_decls()
        ),
        right: go_bool_algebra_inhabitance_decls()
      ),
      right: go_string_algebra_inhabitance_decls()
    ),
    right: go_complex_algebra_inhabitance_decls()
  )
}

fn go_model_core_wave1() -> ModelCore {
  ModelCore {
    primitives: go_wave1_primitive_fact_bundles(),
    inhabitance: go_model_core_inhabitance_decls(),
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn go_int_inhabitant_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(name: ^inhabitant_field_atom, target: go_inhabitant_atom(id: ^go_inhabitant_int)),
      go_named_edge(name: ^go_inhabitant_field_facts, target: go_integer_facts_node(facts: go_facts_int))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn go_int_additive_numeric_inhabitant_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(name: ^inhabitant_field_atom, target: go_inhabitant_atom(id: ^go_inhabitant_int)),
      go_named_edge(
        name: ^go_inhabitant_field_facts,
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            go_named_edge(
              name: ^facts_field_surface_spelling,
              target: go_inhabitant_atom(id: go_facts_int_additive_numeric.surface_spelling)
            ),
            go_named_edge(
              name: ^facts_field_width,
              target: go_signed_int_width_node(width: go_facts_int_additive_numeric.width)
            ),
            go_named_edge(
              name: ^go_facts_field_signedness,
              target: go_int_kind_node(kind: Signed)
            ),
            go_named_edge(
              name: ^go_facts_field_overflow,
              target: go_overflow_node(
                overflow: SignedTypedIntegerTruncatesSilentlyOnOverflow
              )
            ),
            go_named_edge(
              name: ^go_facts_field_encoding,
              target: go_inhabitant_atom(id: go_facts_int_additive_numeric.encoding)
            ),
            go_named_edge(
              name: ^facts_field_std_projection,
              target: go_inhabitant_atom(id: go_facts_int_additive_numeric.std_projection)
            )
          ],
          occurrence_id: SyntheticOccurrence
        }
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn go_int64_additive_numeric_inhabitant_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(name: ^inhabitant_field_atom, target: go_inhabitant_atom(id: ^go_inhabitant_int)),
      go_named_edge(
        name: ^go_inhabitant_field_facts,
        target: Node {
          kind: TypeNode { connective: Conj },
          children: [
            go_named_edge(
              name: ^facts_field_surface_spelling,
              target: go_inhabitant_atom(id: go_facts_int64.surface_spelling)
            ),
            go_named_edge(
              name: ^facts_field_width,
              target: go_signed_int_width_node(width: go_facts_int64.width)
            ),
            go_named_edge(
              name: ^go_facts_field_signedness,
              target: go_int_kind_node(kind: Signed)
            ),
            go_named_edge(
              name: ^go_facts_field_overflow,
              target: go_overflow_node(
                overflow: SignedTypedIntegerTruncatesSilentlyOnOverflow
              )
            ),
            go_named_edge(
              name: ^go_facts_field_encoding,
              target: go_inhabitant_atom(id: go_facts_int64.encoding)
            ),
            go_named_edge(
              name: ^facts_field_std_projection,
              target: go_inhabitant_atom(id: go_facts_int64.std_projection)
            )
          ],
          occurrence_id: SyntheticOccurrence
        }
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

