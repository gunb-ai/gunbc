fn go_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn go_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(xs: acc, item: grammar_formal_terminal(identity: concrete_syntax_token_class(token: token)))
    }
  )
}

fn go_formal_production_fn_add() -> FormalProduction {
  FormalProduction {
    lhs: FormalNonterminal { identity: ^go_production_fn_add },
    rhs: go_formal_rhs_from_tokens(tokens: go_concrete_tokens())
  }
}

fn go_wave1_formal_productions() -> List<FormalProduction> {
  [go_formal_production_fn_add()]
}

type GoGramBuild1State
  = GoGramBuild1StateInit
  | GoGramBuild1StateReady { expr: GrammarExpr }

fn go_grammar_sequence_from_token_classes() -> GrammarExpr {
  match fold_list(
    xs: go_concrete_tokens(),
    empty: GoGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        GoGramBuild1StateInit =>
          GoGramBuild1StateReady {
            expr: go_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
          }
        GoGramBuild1StateReady { expr: acc } =>
          GoGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: go_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    GoGramBuild1StateInit =>
      go_grammar_terminal(token_class: ^go_token_kw_func)
    GoGramBuild1StateReady { expr: result } => result
  }
}

fn go_grammar_atom(id: Symbol) -> Node {
  go_inhabitant_atom(id: id)
}

fn go_grammar_production_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: ^go_production_fn_add,
    expression: go_grammar_sequence_from_token_classes(),
    emitted: go_emitted_add_fn_node()
  }
}

fn go_grammar_relation_row() -> GoGrammarRelationRow {
  GoGrammarRelationRow {
    production: go_grammar_production_fn_add(),
    tokens: go_concrete_tokens()
  }
}

