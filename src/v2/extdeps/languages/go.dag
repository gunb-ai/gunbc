fn go_serialize_source_children() -> List<Edge> {
  list_append(
    left: [
      go_named_edge(name: ^serialize_source_field_source_text, target: go_inhabitant_atom(id: ^go_source_literal)),
      go_named_edge(name: ^serialize_source_field_source_grammar, target: go_inhabitant_atom(id: ^go_production_fn_add))
    ],
    right: [
      go_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: go_concrete_tokens(),
          token_to_node: go_concrete_token_node
        )
