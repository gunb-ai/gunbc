fn go_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  list_append(
    left: list_append(
      left: list_append(
        left: list_append(
          left: go_primitive_bundles_from_integer_catalog(),
          right: go_primitive_bundles_from_float_catalog()
        ),
        right: go_primitive_bundles_from_complex_catalog()
      ),
      right: go_primitive_bundles_from_bool_catalog()
    ),
    right: go_primitive_bundles_from_string_catalog()
  )
}

fn go_per_language_fact_bundle_key(
  subject: Node,
  axis: ModelCorePrimitiveFactAxis
) -> PerLanguageFactBundleKey {
  PerLanguageFactBundleKey {
    subject_carrier: subject,
    target: go_target_model(),
    fact_axis: axis
  }
}

fn go_per_language_fact_bundle_entry(
  subject: Node,
  axis: ModelCorePrimitiveFactAxis,
  fact_value: Node
) -> PerLanguageFactBundleEntry {
  PerLanguageFactBundleEntry {
    key: go_per_language_fact_bundle_key(subject: subject, axis: axis),
    fact_value: fact_value
  }
}

fn go_integer_per_language_fact_bundle_entries(
  facts: GoIntegerPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  match facts {
    GoSignedIntegerPrimitiveFacts {
      surface_spelling,
      width,
      encoding,
      std_projection: _
    } => [
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisSurfaceSpelling {},
        fact_value: go_inhabitant_atom(id: surface_spelling)
      ),
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisWidth {},
        fact_value: go_signed_int_width_node(width: width)
      ),
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisSignedness {},
        fact_value: go_int_kind_node(kind: Signed)
      ),
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisOverflowDisposition {},
        fact_value: go_overflow_node(
          overflow: SignedTypedIntegerTruncatesSilentlyOnOverflow
        )
      ),
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisEncoding {},
        fact_value: go_inhabitant_atom(id: encoding)
      )
    ]
    GoUnsignedIntegerPrimitiveFacts {
      surface_spelling,
      width,
      encoding,
      std_projection: _
    } => [
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisSurfaceSpelling {},
        fact_value: go_inhabitant_atom(id: surface_spelling)
      ),
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisWidth {},
        fact_value: go_unsigned_int_width_node(width: width)
      ),
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisSignedness {},
        fact_value: go_int_kind_node(kind: Unsigned)
      ),
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisOverflowDisposition {},
        fact_value: go_overflow_node(
          overflow: UnsignedTypedIntegerTruncatesSilentlyOnOverflow
        )
      ),
      go_per_language_fact_bundle_entry(
        subject: go_integer_facts_node(facts: facts),
        axis: ModelCoreFactAxisEncoding {},
        fact_value: go_inhabitant_atom(id: encoding)
      )
    ]
  }
}

fn go_float_per_language_fact_bundle_entries(
  facts: GoFloatPrimitiveFacts
) -> List<PerLanguageFactBundleEntry> {
  [
    go_per_language_fact_bundle_entry(
