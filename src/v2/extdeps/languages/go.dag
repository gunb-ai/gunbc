fn go_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: go_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: go_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

