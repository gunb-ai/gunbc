    ),
    go_named_edge(
      name: ^go_coercion_field_int_width,
      target: go_signed_int_width_node(width: SignedPlatformInt)
    ),
    go_named_edge(
      name: ^go_coercion_field_int_signed,
      target: go_inhabitant_atom(id: ^go_tag_signed)
    ),
    go_named_edge(
      name: ^go_coercion_field_int_overflow,
      target: go_overflow_node(overflow: SignedTypedIntegerTruncatesSilentlyOnOverflow)
    ),
    go_named_edge(
      name: ^go_coercion_field_int_encoding,
      target: go_inhabitant_atom(id: ^go_repr_twos_complement_integer)
    ),
    go_named_edge(
      name: ^go_coercion_field_int_std_projection,
      target: go_inhabitant_atom(id: ^go_std_projection_int)
    )
  ]
}

fn go_coercion_candidate_edges() -> List<Edge> {
  list_append(
    left: go_declared_inhabitants_root().children,
    right: go_int_zip_fold_closure_edges()
  )
}

fn go_add_declared_inhabitants_root() -> Node {
  Node {
