      go_named_edge(name: ^go_relation_rule_fn_add, target: go_grammar_relation_row_node(row: go_grammar_relation_row()))
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn go_binding_spellings() -> Map<Symbol, String> {
