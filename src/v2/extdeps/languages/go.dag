  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(name: ^grammar_relation_field_production, target: grammar_production_to_node(production: row.production)),
      go_named_edge(name: ^grammar_relation_field_emitted, target: row.production.emitted),
      go_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: go_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

