fn go_g1_3_per_language_fact_bundle_entry_rows() -> List<PerLanguageFactBundleEntry> {
  list_append(
    left: list_append(
      left: list_append(
        left: list_append(
          left: go_per_language_fact_bundle_entries_from_integer_catalog(),
          right: go_per_language_fact_bundle_entries_from_float_catalog()
        ),
        right: go_per_language_fact_bundle_entries_from_complex_catalog()
      ),
      right: go_per_language_fact_bundle_entries_from_bool_catalog()
    ),
    right: go_per_language_fact_bundle_entries_from_string_catalog()
  )
}

fn go_g1_3_per_language_fact_bundle_registry_step(
  acc: Outcome<PerLanguageFactBundleRegistry>,
  entry: PerLanguageFactBundleEntry
) -> Outcome<PerLanguageFactBundleRegistry> {
  bind_outcome(o: acc, f: fn(registry) {
    insert_per_language_fact_bundle_entry(
      registry: registry,
      key: entry.key,
      fact_value: entry.fact_value
    )
  })
}

fn go_g1_3_per_language_fact_bundle_registry() -> Outcome<PerLanguageFactBundleRegistry> {
  fold_list(
    xs: go_g1_3_per_language_fact_bundle_entry_rows(),
    empty: outcome_accepted(value: empty_per_language_fact_bundle_registry()),
    cons: go_g1_3_per_language_fact_bundle_registry_step
  )
}

fn go_integer_algebra_witness_node(facts: GoIntegerPrimitiveFacts) -> Node {
  match facts {
    GoSignedIntegerPrimitiveFacts {
      surface_spelling: _,
      width,
      encoding,
      std_projection
    } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: ^go_witness_integer_commutative_ring,
          target: go_inhabitant_atom(id: ^go_witness_integer_commutative_ring)
        ),
        go_named_edge(
          name: ^go_facts_field_width,
          target: go_signed_int_width_node(width: width)
        ),
        go_named_edge(
          name: ^go_facts_field_signedness,
          target: go_int_kind_node(kind: Signed)
        ),
        go_named_edge(
          name: ^go_facts_field_overflow,
          target: go_overflow_node(
            overflow: SignedTypedIntegerTruncatesSilentlyOnOverflow
          )
        ),
        go_named_edge(
          name: ^go_facts_field_encoding,
          target: go_inhabitant_atom(id: encoding)
        ),
        go_named_edge(
          name: ^facts_field_std_projection,
          target: go_inhabitant_atom(id: std_projection)
        )
      ],
      occurrence_id: SyntheticOccurrence
}
    GoUnsignedIntegerPrimitiveFacts {
      surface_spelling: _,
      width,
      encoding,
      std_projection
    } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        go_named_edge(
          name: ^go_witness_integer_commutative_ring,
          target: go_inhabitant_atom(id: ^go_witness_integer_commutative_ring)
        ),
        go_named_edge(
          name: ^go_facts_field_width,
          target: go_unsigned_int_width_node(width: width)
        ),
        go_named_edge(
          name: ^go_facts_field_signedness,
          target: go_int_kind_node(kind: Unsigned)
        ),
        go_named_edge(
          name: ^go_facts_field_overflow,
          target: go_overflow_node(
            overflow: UnsignedTypedIntegerTruncatesSilentlyOnOverflow
          )
        ),
        go_named_edge(
          name: ^go_facts_field_encoding,
          target: go_inhabitant_atom(id: encoding)
        ),
        go_named_edge(
          name: ^facts_field_std_projection,
          target: go_inhabitant_atom(id: std_projection)
        )
      ],
      occurrence_id: SyntheticOccurrence
}
  }
}

fn go_float_algebra_witness_node(facts: GoFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(
        name: ^go_witness_float_approximate_field,
        target: go_inhabitant_atom(id: ^go_witness_float_approximate_field)
      ),
      go_named_edge(
        name: ^go_facts_field_ieee754_binary,
        target: go_inhabitant_atom(id: facts.ieee754_binary)
      ),
      go_named_edge(
        name: ^go_facts_field_std_projection,
        target: go_inhabitant_atom(id: facts.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn go_bool_algebra_witness_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(
        name: ^go_witness_bool_boolean_algebra,
        target: go_inhabitant_atom(id: ^go_witness_bool_boolean_algebra)
      ),
      go_named_edge(
        name: ^go_facts_field_std_projection,
        target: go_inhabitant_atom(id: go_facts_bool.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn go_string_algebra_witness_node(facts: GoStringPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(
        name: ^go_witness_string_free_monoid,
        target: go_inhabitant_atom(id: ^go_witness_string_free_monoid)
      ),
      go_named_edge(
        name: ^go_facts_field_encoding,
        target: go_inhabitant_atom(id: facts.encoding)
      ),
      go_named_edge(
        name: ^go_facts_field_std_projection,
        target: go_inhabitant_atom(id: facts.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn go_string_element_node() -> Node {
  go_integer_facts_node(facts: go_facts_uint8)
}

fn go_integer_algebra_inhabitance(facts: GoIntegerPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = go_integer_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: commutative_ring_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: go_integer_algebra_witness_node(facts: facts)
  }
}

data go_atom_realization_symbol_node: Node = go_inhabitant_atom(id: ^go_atom_realization_symbol)
data go_integer_algebra_inhabitance_go_facts_int: AlgebraInhabitanceDecl = go_integer_algebra_inhabitance(facts: go_facts_int)
data go_integer_algebra_inhabitance_go_facts_int64: AlgebraInhabitanceDecl = go_integer_algebra_inhabitance(facts: go_facts_int64)

fn go_leaf_model_fact_id_node_atom_realization_symbol() -> Node {
  go_atom_realization_symbol_node
}

fn go_float_algebra_inhabitance(facts: GoFloatPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = go_float_facts_node(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: approximate_field_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: go_float_algebra_witness_node(facts: facts)
  }
}

fn go_bool_algebra_inhabitance() -> AlgebraInhabitanceDecl {
  let inhabitant = go_bool_facts_node(facts: go_facts_bool)
  AlgebraInhabitanceDecl {
    algebra: boolean_algebra_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: go_bool_algebra_witness_node()
  }
}

