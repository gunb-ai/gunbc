fn go_string_facts_node(facts: GoStringPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      go_named_edge(
        name: ^go_facts_field_surface_spelling,
        target: go_inhabitant_atom(id: facts.surface_spelling)
      ),
      go_named_edge(
        name: ^go_facts_field_encoding,
        target: go_inhabitant_atom(id: facts.encoding)
      ),
      go_named_edge(
        name: ^go_facts_field_std_projection,
        target: go_inhabitant_atom(id: facts.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn go_empty_primitive_spec_facts() -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      Violates {
        diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
      }
    }
  }
}

fn go_primitive_fact_map_2(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(go_empty_primitive_spec_facts(), axis0, fact0),
    axis1,
    fact1
  )
}

fn go_primitive_fact_map_3(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node,
  axis2: Symbol,
  fact2: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(
      map_insert(go_empty_primitive_spec_facts(), axis0, fact0),
      axis1,
      fact1
    ),
    axis2,
    fact2
  )
}

fn go_primitive_fact_map_5(
  axis0: Symbol,
  fact0: Node,
  axis1: Symbol,
  fact1: Node,
  axis2: Symbol,
  fact2: Node,
  axis3: Symbol,
  fact3: Node,
  axis4: Symbol,
  fact4: Node
) -> Map<Symbol, Node> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(
          map_insert(go_empty_primitive_spec_facts(), axis0, fact0),
          axis1,
          fact1
        ),
        axis2,
        fact2
      ),
      axis3,
      fact3
    ),
    axis4,
    fact4
  )
}

fn go_primitive_bundle_from_integer_facts(facts: GoIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  match facts {
    GoSignedIntegerPrimitiveFacts {
      surface_spelling,
      width,
      encoding,
      std_projection: _
    } => PrimitiveFactBundle {
      substrate_carrier: go_integer_facts_node(facts: facts),
      spec_facts: go_primitive_fact_map_5(
        axis0: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}),
        fact0: go_inhabitant_atom(id: surface_spelling),
        axis1: discriminant(v: ModelCoreFactAxisWidth {}),
        fact1: go_signed_int_width_node(width: width),
        axis2: discriminant(v: ModelCoreFactAxisSignedness {}),
        fact2: go_int_kind_node(kind: Signed),
        axis3: discriminant(v: ModelCoreFactAxisOverflowDisposition {}),
        fact3: go_overflow_node(
          overflow: SignedTypedIntegerTruncatesSilentlyOnOverflow
        ),
        axis4: discriminant(v: ModelCoreFactAxisEncoding {}),
        fact4: go_inhabitant_atom(id: encoding)
      )
    }
    GoUnsignedIntegerPrimitiveFacts {
      surface_spelling,
      width,
      encoding,
      std_projection: _
    } => PrimitiveFactBundle {
      substrate_carrier: go_integer_facts_node(facts: facts),
      spec_facts: go_primitive_fact_map_5(
        axis0: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}),
        fact0: go_inhabitant_atom(id: surface_spelling),
        axis1: discriminant(v: ModelCoreFactAxisWidth {}),
        fact1: go_unsigned_int_width_node(width: width),
        axis2: discriminant(v: ModelCoreFactAxisSignedness {}),
        fact2: go_int_kind_node(kind: Unsigned),
        axis3: discriminant(v: ModelCoreFactAxisOverflowDisposition {}),
        fact3: go_overflow_node(
          overflow: UnsignedTypedIntegerTruncatesSilentlyOnOverflow
        ),
        axis4: discriminant(v: ModelCoreFactAxisEncoding {}),
        fact4: go_inhabitant_atom(id: encoding)
      )
    }
  }
}

fn go_primitive_bundle_from_float_facts(facts: GoFloatPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: go_float_facts_node(facts: facts),
    spec_facts: go_primitive_fact_map_3(
      axis0: discriminant(v: ModelCoreFactAxisSurfaceSpelling {}),
      fact0: go_inhabitant_atom(id: facts.surface_spelling),
      axis1: discriminant(v: ModelCoreFactAxisWidth {}),
      fact1: go_float_width_node(width: facts.width),
      axis2: discriminant(v: ModelCoreFactAxisEncoding {}),
      fact2: go_inhabitant_atom(id: facts.ieee754_binary)
    )
  }
}

