fn go_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule { token_class: token_class, pattern: LiteralPattern { text: text } }
}

fn go_keyword_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule { token_class: token_class, pattern: KeywordPattern { text: text } }
}

fn go_whitespace_trivia_rule() -> LexRule {

  TriviaRule {
    pattern: OneOrMorePattern { element: LiteralPattern { text: " " } }
  }
}

fn go_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn go_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^go_token_ident,
    pattern: go_ident_lex_pattern()
  }
}

fn go_wave1_lex_rules() -> LexRuleSet {

  LexRuleSet {
    rules: [
      go_whitespace_trivia_rule(),
      go_ident_lex_rule(),
      go_keyword_lex_rule(token_class: ^go_token_kw_func, text: "func "),
      go_lex_rule(token_class: ^go_token_lparen, text: "("),

      go_lex_rule(token_class: ^go_token_ty_int, text: " int"),
      go_lex_rule(token_class: ^go_token_comma, text: ", "),
      go_lex_rule(token_class: ^go_token_rparen, text: ")"),
      go_lex_rule(token_class: ^go_token_lbrace, text: " { "),
      go_keyword_lex_rule(token_class: ^go_token_kw_return, text: "return "),
      go_lex_rule(token_class: ^go_token_plus, text: " + "),
      go_lex_rule(token_class: ^go_token_rbrace, text: " }")
    ]
  }
}

fn go_wave1_lex() -> LexRules {
  ModeledLexRules { root: go_wave1_lex_rules() }
}

fn go_wave1_grammar_root() -> GrammarRoot {
  let start = go_grammar_production_fn_add()
  GrammarRoot {
    start: ^go_production_fn_add,
    productions: [start],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn go_wave1_grammar() -> ParseGrammar {
  ModeledGrammar { root: go_wave1_grammar_root() }
}

fn go_wave1_lex_token_symbol(sym: Symbol) -> Bool {
  lex_rule_set_token_class_member(
    rules: go_wave1_lex_rules(),
    token_class: sym
  )
}

fn go_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: GoIntegerPrimitiveFacts
) -> Bool {
  match facts {
    GoSignedIntegerPrimitiveFacts {
      surface_spelling,
      width: _,
      encoding: _,
      std_projection: _
    } => acc || sym == surface_spelling
    GoUnsignedIntegerPrimitiveFacts {
      surface_spelling,
      width: _,
      encoding: _,
      std_projection: _
    } => acc || sym == surface_spelling
  }
}

fn go_float_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: GoFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn go_complex_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: GoComplexPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn go_bool_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: GoBoolPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn go_string_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: GoStringPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn go_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: go_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      go_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn go_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: go_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      go_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn go_complex_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: go_complex_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      go_complex_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn go_bool_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: go_bool_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      go_bool_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn go_string_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: go_string_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      go_string_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn go_catalog_surface_symbol(sym: Symbol) -> Bool {
  go_integer_catalog_surface_symbol(sym: sym) ||
    go_float_catalog_surface_symbol(sym: sym) ||
    go_complex_catalog_surface_symbol(sym: sym) ||
    go_bool_catalog_surface_symbol(sym: sym) ||
    go_string_catalog_surface_symbol(sym: sym)
}

fn go_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      go_catalog_surface_symbol(sym: sym) ||
        go_wave1_lex_token_symbol(sym: sym) ||
        grammar_carries_symbol(grammar: go_wave1_grammar(), sym: sym) ||
        sym == ^go_production_fn_add ||
        sym == ^go_source_literal
    }
  }
}

fn go_language_model_wave1() -> LanguageModel {
  LanguageModel {
    lex: go_wave1_lex(),
    grammar: go_wave1_grammar(),
    language_identity: ^go_language_model_surface_id,
    canonical_symbols: go_language_model_canonical_symbols(),
    core: go_model_core_wave1()
  }
}
