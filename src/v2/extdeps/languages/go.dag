type SignedIntWidth
  = SignedBits8
  | SignedBits16
  | SignedBits32
  | SignedBits64
  | SignedPlatformInt

type UnsignedIntWidth
  = UnsignedBits8
  | UnsignedBits16
  | UnsignedBits32
  | UnsignedBits64
  | UnsignedPlatformInt
  | UnsignedPointerSized

type GoFloatWidth
  = FloatBits32
  | FloatBits64

type GoComplexWidth
  = ComplexBits64
  | ComplexBits128

type GoScalarKind
  = Int
  | Float
  | Complex
  | ScalarBool
  | ScalarString

type GoScalar
  = SignedIntScalar { width: SignedIntWidth }
  | UnsignedIntScalar { width: UnsignedIntWidth }
  | FloatScalar { width: GoFloatWidth }
  | ComplexScalar { width: GoComplexWidth }
  | BoolScalar
  | StringScalar

type GoChannelDirection
  = SendRecv
  | SendOnly
  | RecvOnly

type GoExportLocus
  = PackageBlock
  | StructField
  | MethodName

type GoExportStatus
  = Exported { locus: GoExportLocus }
  | Unexported { locus: GoExportLocus }

type GoChannel {
  direction: GoChannelDirection
  element_type_ref: Symbol
}

type GoCost {
  instruction_cost: Int
  allocation_cost: Int
}

type GoGrammarRelationRow {
  production: GrammarProduction
  tokens: List<ConcreteSyntaxToken>
}

type GoBuiltinIntegerArithmeticOverflow
  = SignedTypedIntegerTruncatesSilentlyOnOverflow
  | UnsignedTypedIntegerTruncatesSilentlyOnOverflow

type GoIntegerOverflowDisposition<IRCarrier> {
  debug_default: GoBuiltinIntegerArithmeticOverflow
  release_default: GoBuiltinIntegerArithmeticOverflow
}

type GoIntKind
  = Signed
  | Unsigned

type GoIntegerPrimitiveFacts
  = GoSignedIntegerPrimitiveFacts {
      surface_spelling: Symbol
      width: SignedIntWidth
      encoding: Symbol
      std_projection: Symbol
    }
  | GoUnsignedIntegerPrimitiveFacts {
      surface_spelling: Symbol
      width: UnsignedIntWidth
      encoding: Symbol
      std_projection: Symbol
    }

type GoFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: GoFloatWidth
  ieee754_binary: Symbol
  std_projection: Symbol
}

type GoComplexPrimitiveFacts {
  surface_spelling: Symbol
  width: GoComplexWidth
  component_ieee754_binary: Symbol
  std_projection: Symbol
}

type GoBoolPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type GoStringPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

data go_source_text: String = "func add(x int, y int) int { return x + y }"

fn go_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^go_token_kw_func },
    BoundToken { token_class: ^go_token_ident, binding: ^go_binding_fn_add },
    FixedToken { token_class: ^go_token_lparen },
    BoundToken { token_class: ^go_token_ident, binding: ^go_binding_param_x },
    FixedToken { token_class: ^go_token_ty_int },
    FixedToken { token_class: ^go_token_comma },
    BoundToken { token_class: ^go_token_ident, binding: ^go_binding_param_y },
    FixedToken { token_class: ^go_token_ty_int },
    FixedToken { token_class: ^go_token_rparen },
    FixedToken { token_class: ^go_token_ty_int },
    FixedToken { token_class: ^go_token_lbrace },
    FixedToken { token_class: ^go_token_kw_return },
    BoundToken { token_class: ^go_token_ident, binding: ^go_binding_param_x },
    FixedToken { token_class: ^go_token_plus },
    BoundToken { token_class: ^go_token_ident, binding: ^go_binding_param_y },
    FixedToken { token_class: ^go_token_rbrace }
  ]
}
data go_facts_int8: GoIntegerPrimitiveFacts = GoSignedIntegerPrimitiveFacts {
  surface_spelling: ^go_surface_spelling_int8,
  width: SignedBits8,
  encoding: ^go_repr_twos_complement_integer,
  std_projection: ^go_std_projection_int8,
}

