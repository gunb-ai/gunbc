fn ecmascript_primitive_bundles_from_singleton_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  ecmascript_primitive_fact_bundles_from_catalog_rows(
    rows: ecmascript_singleton_facts_catalog,
    row_to_bundle: fn(facts) {
      ecmascript_primitive_bundle_from_singleton_facts(facts: facts)
    }
  )
}

fn ecmascript_primitive_fact_bundles() -> List<v2.std.model_core.PrimitiveFactBundle> {
  v2.std.algebra.list_append(
    left: v2.std.algebra.list_append(
      left: v2.std.algebra.list_append(
        left: v2.std.algebra.list_append(
          left: v2.std.algebra.list_append(
            left: ecmascript_primitive_bundles_from_number_catalog(),
            right: ecmascript_primitive_bundles_from_bigint_catalog()
          ),
          right: ecmascript_primitive_bundles_from_boolean_catalog()
        ),
        right: ecmascript_primitive_bundles_from_string_catalog()
      ),
      right: ecmascript_primitive_bundles_from_symbol_catalog()
    ),
    right: ecmascript_primitive_bundles_from_singleton_catalog()
  )
}

fn ecmascript_number_algebra_witness_node(facts: EcmascriptNumberPrimitiveFacts) -> v2.std.node.Node {
  ecmascript_primitive_algebra_witness_node(
    witness_field_name: ^ecmascript_witness_number_approximate_field,
    witness_tag: ^ecmascript_witness_number_approximate_field,
    middle_field_name: ^ecmascript_facts_field_machine_representation,
    middle_field_value: facts.machine_representation,
    std_projection: facts.std_projection
  )
}

fn ecmascript_bigint_algebra_witness_node(facts: EcmascriptBigIntPrimitiveFacts) -> v2.std.node.Node {
  ecmascript_primitive_algebra_witness_node(
    witness_field_name: ^ecmascript_witness_bigint_ordered_ring,
    witness_tag: ^ecmascript_witness_bigint_ordered_ring,
    middle_field_name: ^ecmascript_facts_field_encoding,
    middle_field_value: facts.encoding,
    std_projection: facts.std_projection
  )
}

fn ecmascript_boolean_algebra_witness_node(facts: EcmascriptBooleanPrimitiveFacts) -> v2.std.node.Node {
  ecmascript_primitive_algebra_witness_node(
    witness_field_name: ^ecmascript_witness_bool_boolean_algebra,
    witness_tag: ^ecmascript_witness_bool_boolean_algebra,
    middle_field_name: ^ecmascript_facts_field_encoding,
    middle_field_value: facts.encoding,
    std_projection: facts.std_projection
  )
}

fn ecmascript_number_algebra_inhabitance(facts: EcmascriptNumberPrimitiveFacts) -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = ecmascript_number_facts_node(facts: facts)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: v2.std.algebra.approximate_field_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: ecmascript_number_algebra_witness_node(facts: facts)
  }
}

fn ecmascript_bigint_algebra_inhabitance(facts: EcmascriptBigIntPrimitiveFacts) -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = ecmascript_bigint_facts_node(facts: facts)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: v2.std.algebra.ordered_ring_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: ecmascript_bigint_algebra_witness_node(facts: facts)
  }
}

fn ecmascript_boolean_algebra_inhabitance(facts: EcmascriptBooleanPrimitiveFacts) -> v2.std.model_core.AlgebraInhabitanceDecl {
  let inhabitant = ecmascript_boolean_facts_node(facts: facts)
  v2.std.model_core.AlgebraInhabitanceDecl {
    algebra: v2.std.algebra.boolean_algebra_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: ecmascript_boolean_algebra_witness_node(facts: facts)
  }
}

fn ecmascript_number_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  v2.std.algebra.fold_list(
    xs: ecmascript_number_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, facts) {
      v2.std.algebra.list_snoc_item(xs: acc, item: ecmascript_number_algebra_inhabitance(facts: facts))
    }
  )
}

fn ecmascript_bigint_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  v2.std.algebra.fold_list(
    xs: ecmascript_bigint_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, facts) {
      v2.std.algebra.list_snoc_item(xs: acc, item: ecmascript_bigint_algebra_inhabitance(facts: facts))
    }
  )
}

fn ecmascript_boolean_algebra_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  v2.std.algebra.fold_list(
    xs: ecmascript_boolean_facts_catalog,
    empty: std.algebra.Empty,
    cons: fn(acc, facts) {
      v2.std.algebra.list_snoc_item(xs: acc, item: ecmascript_boolean_algebra_inhabitance(facts: facts))
    }
  )
}

fn ecmascript_model_core_inhabitance_decls() -> List<v2.std.model_core.AlgebraInhabitanceDecl> {
  v2.std.algebra.list_append(
    left: v2.std.algebra.list_append(
      left: ecmascript_number_algebra_inhabitance_decls(),
      right: ecmascript_bigint_algebra_inhabitance_decls()
    ),
    right: ecmascript_boolean_algebra_inhabitance_decls()
  )
}

fn ecmascript_model_core() -> v2.std.model_core.ModelCore {
  v2.std.model_core.ModelCore {
    primitives: ecmascript_primitive_fact_bundles(),
    inhabitance: ecmascript_model_core_inhabitance_decls(),
    laws: [],
    effects: v2.std.model_core.EffectSemanticsDecl { operations: [] },
    partiality: v2.std.model_core.PartialitySemanticsDecl { operations: [] }
  }
}

fn ecmascript_inhabitant_node(id: v2.std.node.Symbol, facts: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ecmascript_named_edge(name: ^ecmascript_inhabitant_field_atom, target: ecmascript_inhabitant_atom(id: id)),
      ecmascript_named_edge(name: ^ecmascript_inhabitant_field_facts, target: facts)
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ecmascript_number_inhabitant_node() -> v2.std.node.Node {
  ecmascript_inhabitant_node(
    id: ^ecmascript_inhabitant_number,
    facts: ecmascript_number_facts_node(facts: ecmascript_facts_number)
  )
}

fn ecmascript_bigint_inhabitant_node() -> v2.std.node.Node {
  ecmascript_inhabitant_node(
    id: ^ecmascript_inhabitant_bigint,
    facts: ecmascript_bigint_facts_node(facts: ecmascript_facts_bigint)
  )
}

fn ecmascript_declared_inhabitants_root() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ecmascript_named_edge(name: ^ecmascript_inhabitant_field_number, target: ecmascript_number_inhabitant_node()),
      ecmascript_named_edge(name: ^ecmascript_inhabitant_field_bigint, target: ecmascript_bigint_inhabitant_node())
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ecmascript_selection_policy_node() -> v2.std.node.Node {
  ecmascript_number_inhabitant_node()
}

fn ecmascript_emitted_add_fn_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: ecmascript_number_inhabitant_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: ecmascript_number_inhabitant_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: ecmascript_number_inhabitant_node() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ecmascript_concrete_token_node(token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> v2.std.node.Node {

  v2.std.compilers.target_model.concrete_syntax_token_to_node(token: token)
}

fn ecmascript_serialize_source_children() -> List<v2.std.node.Edge> {
  v2.std.algebra.list_append(
    left: [
      ecmascript_named_edge(name: ^serialize_source_field_source_text, target: ecmascript_inhabitant_atom(id: ^ecmascript_source_literal)),
      ecmascript_named_edge(name: ^serialize_source_field_source_grammar, target: ecmascript_inhabitant_atom(id: ^ecmascript_production_fn_add))
    ],
    right: [
      ecmascript_named_edge(
        name: ^grammar_relation_field_tokens,
        target: v2.std.grammar.grammar_relation_tokens_node(
          tokens: ecmascript_concrete_tokens(),
          token_to_node: ecmascript_concrete_token_node
        )
      )
    ]
  )
}

fn ecmascript_serialize_source_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: ecmascript_serialize_source_children(),
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ecmascript_formal_rhs_from_token_classes() -> List<v2.std.grammar.FormalGrammarSymbol> {
  v2.std.algebra.fold_list(
    xs: ecmascript_concrete_tokens(),
    empty: std.algebra.Empty,
    cons: fn(acc, token) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: v2.std.grammar.grammar_formal_terminal(identity: v2.std.compilers.target_model.concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn ecmascript_formal_symbol_to_grammar_expr(sym: v2.std.grammar.FormalGrammarSymbol) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.formal_grammar_symbol_to_grammar_expr(sym: sym)
}

fn ecmascript_formal_epsilon_grammar_expr() -> v2.std.grammar.GrammarExpr {
  v2.std.optional.Optional {
    element: v2.std.grammar.Terminal { token_class: ^ecmascript_formal_epsilon_shim_terminal, stamp: v2.std.grammar.StampClass }
  }
}

type EcmascriptFormalRhsToExprState
  = EcmascriptFormalRhsToExprUninitialized
  | EcmascriptFormalRhsToExprReady { expr: v2.std.grammar.GrammarExpr }

fn ecmascript_formal_rhs_to_grammar_expr(rhs: List<v2.std.grammar.FormalGrammarSymbol>) -> v2.std.grammar.GrammarExpr {
  match v2.std.algebra.fold_list(
    xs: rhs,
    empty: EcmascriptFormalRhsToExprUninitialized,
    cons: fn(state, sym) {
      let piece = ecmascript_formal_symbol_to_grammar_expr(sym: sym)
      match state {
        EcmascriptFormalRhsToExprUninitialized =>
          EcmascriptFormalRhsToExprReady { expr: piece }
        EcmascriptFormalRhsToExprReady { expr: acc } =>
          EcmascriptFormalRhsToExprReady {
            expr: v2.std.grammar.Sequence { left: acc, right: piece }
          }
      }
    }
  ) {
    EcmascriptFormalRhsToExprUninitialized => ecmascript_formal_epsilon_grammar_expr()
    EcmascriptFormalRhsToExprReady { expr: result } => result
  }
}

type EcmascriptFormalAltChoiceState
  = EcmascriptFormalAltChoiceUninitialized
  | EcmascriptFormalAltChoiceReady { expr: v2.std.grammar.GrammarExpr }

fn ecmascript_formal_alternatives_to_choice_expr(alts: List<List<v2.std.grammar.FormalGrammarSymbol>>) -> v2.std.grammar.GrammarExpr {
  match v2.std.algebra.fold_list(
    xs: alts,
    empty: EcmascriptFormalAltChoiceUninitialized,
    cons: fn(state, rhs) {
      let alt_expr = ecmascript_formal_rhs_to_grammar_expr(rhs: rhs)
      match state {
        EcmascriptFormalAltChoiceUninitialized =>
          EcmascriptFormalAltChoiceReady { expr: alt_expr }
        EcmascriptFormalAltChoiceReady { expr: acc } =>
          EcmascriptFormalAltChoiceReady {
            expr: v2.std.grammar.Choice { left: acc, right: alt_expr }
          }
      }
    }
  ) {
    EcmascriptFormalAltChoiceUninitialized => ecmascript_formal_epsilon_grammar_expr()
    EcmascriptFormalAltChoiceReady { expr: result } => result
  }
}

fn ecmascript_formal_rhs_alternatives_accum_empty() -> List<List<v2.std.grammar.FormalGrammarSymbol>> {
  std.algebra.Empty
}

fn ecmascript_formal_collect_rhs_alternative(
  acc: List<List<v2.std.grammar.FormalGrammarSymbol>>,
  prod: v2.std.grammar.FormalProduction
) -> List<List<v2.std.grammar.FormalGrammarSymbol>> {
  v2.std.algebra.list_snoc_item(xs: acc, item: prod.rhs)
}

fn ecmascript_formal_rhs_alternatives_from_productions(
  prods: List<v2.std.grammar.FormalProduction>
) -> List<List<v2.std.grammar.FormalGrammarSymbol>> {
  v2.std.algebra.fold_list(
    xs: prods,
    empty: ecmascript_formal_rhs_alternatives_accum_empty(),
    cons: ecmascript_formal_collect_rhs_alternative
  )
}

fn ecmascript_formal_productions_to_grammar_expr(prods: List<v2.std.grammar.FormalProduction>) -> v2.std.grammar.GrammarExpr {
  ecmascript_formal_alternatives_to_choice_expr(
    alts: ecmascript_formal_rhs_alternatives_from_productions(prods: prods)
  )
}

fn ecmascript_formal_production_alts(
  head: v2.std.grammar.FormalProduction,
  alts: List<v2.std.grammar.FormalProduction>
) -> List<v2.std.grammar.FormalProduction> {
  v2.std.algebra.list_append(left: [head], right: alts)
}

fn ecmascript_formal_productions_to_grammar_production(
  head: v2.std.grammar.FormalProduction,
  alts: List<v2.std.grammar.FormalProduction>,
  emitted: v2.std.node.Symbol
) -> v2.std.grammar.GrammarProduction {
  v2.std.grammar.GrammarProduction {
    name: head.lhs.identity,
    expression: ecmascript_formal_productions_to_grammar_expr(
      prods: ecmascript_formal_production_alts(head: head, alts: alts)
    ),
    emitted: ecmascript_grammar_atom(id: emitted)
  }
}

fn ecmascript_formal_production_fn_add() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^ecmascript_production_fn_add,
    rhs: ecmascript_formal_rhs_from_token_classes()
  )
}

fn ecmascript_formal_productions() -> List<v2.std.grammar.FormalProduction> {
  [ecmascript_formal_production_fn_add()]
}

fn ecmascript_grammar_production_fn_add() -> v2.std.grammar.GrammarProduction {
  v2.std.grammar.GrammarProduction {
    name: ^ecmascript_production_fn_add,
    expression: ecmascript_formal_productions_to_grammar_expr(
      prods: [ecmascript_formal_production_fn_add()]
    ),
    emitted: ecmascript_emitted_add_fn_node()
  }
}

fn ecmascript_grammar_relation_row() -> EcmascriptGrammarRelationRow {
  EcmascriptGrammarRelationRow {
    production: ecmascript_formal_production_fn_add(),
    emitted: ecmascript_emitted_add_fn_node(),
    tokens: ecmascript_concrete_tokens()
  }
}

fn ecmascript_grammar_relation_row_node(row: EcmascriptGrammarRelationRow) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ecmascript_named_edge(name: ^grammar_relation_field_production, target: v2.std.grammar.formal_production_to_node(production: row.production)),
      ecmascript_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      ecmascript_named_edge(
        name: ^grammar_relation_field_tokens,
        target: v2.std.grammar.grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: ecmascript_concrete_token_node
        )
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ecmascript_translation_rules_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ecmascript_named_edge(
        name: ^ecmascript_relation_rule_fn_add,
        target: ecmascript_grammar_relation_row_node(row: ecmascript_grammar_relation_row())
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ecmascript_target_model_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      ecmascript_named_edge(name: ^target_model_edge_selection_policy, target: ecmascript_selection_policy_node()),
      ecmascript_named_edge(name: ^target_model_edge_declared_inhabitants, target: ecmascript_declared_inhabitants_root()),
      ecmascript_named_edge(name: ^target_model_edge_translation_rules, target: ecmascript_translation_rules_node()),
      ecmascript_named_edge(name: ^target_model_edge_serialize_source, target: ecmascript_serialize_source_node())
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn ecmascript_binding_spellings() -> Map<v2.std.node.Symbol, String> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(v2.std.collection.empty_map(), ^ecmascript_binding_fn_add, "add"),
      ^ecmascript_binding_param_x,
      "x"
    ),
    ^ecmascript_binding_param_y,
    "y"
  )
}

fn ecmascript_target_model() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
    bundle: ecmascript_target_model_node(),
    lex: ecmascript_lex(),
    binding_spellings: ecmascript_binding_spellings(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
    authority_source_text: ecmascript_source_text,
    runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
  }
}

fn ecmascript_lex_rule(token_class: v2.std.node.Symbol, text: String) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule { token_class: token_class, pattern: v2.std.compilers.lexing.LiteralPattern { text: text } }
}

fn ecmascript_ident_lex_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentStartChar },
    right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentContinueChar } }
  }
}

fn ecmascript_ident_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^ecmascript_token_ident,
    pattern: ecmascript_ident_lex_pattern()
  }
}

fn ecmascript_nonzero_digit_char_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.ChoicePattern {
    left: v2.std.compilers.lexing.CharPattern { char: 49 },
    right: v2.std.compilers.lexing.ChoicePattern {
      left: v2.std.compilers.lexing.CharPattern { char: 50 },
      right: v2.std.compilers.lexing.ChoicePattern {
        left: v2.std.compilers.lexing.CharPattern { char: 51 },
        right: v2.std.compilers.lexing.ChoicePattern {
          left: v2.std.compilers.lexing.CharPattern { char: 52 },
          right: v2.std.compilers.lexing.ChoicePattern {
            left: v2.std.compilers.lexing.CharPattern { char: 53 },
            right: v2.std.compilers.lexing.ChoicePattern {
              left: v2.std.compilers.lexing.CharPattern { char: 54 },
              right: v2.std.compilers.lexing.ChoicePattern {
                left: v2.std.compilers.lexing.CharPattern { char: 55 },
                right: v2.std.compilers.lexing.ChoicePattern {
                  left: v2.std.compilers.lexing.CharPattern { char: 56 },
                  right: v2.std.compilers.lexing.CharPattern { char: 57 }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn ecmascript_decimal_int_literal_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.ChoicePattern {
    left: v2.std.compilers.lexing.LiteralPattern { text: "0" },
    right: v2.std.compilers.lexing.SequencePattern {
      left: ecmascript_nonzero_digit_char_pattern(),
      right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.DigitChar } }
    }
  }
}

fn ecmascript_int_literal_lex_rule() -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule {
    token_class: ^ecmascript_token_int_literal,
    pattern: ecmascript_decimal_int_literal_pattern()
  }
}

fn ecmascript_lex_rules() -> v2.std.compilers.lexing.LexRuleSet {
  v2.std.compilers.lexing.LexRuleSet {
    rules: [
      ecmascript_lex_rule(token_class: ^ecmascript_token_rparen_lbrace_inner_open, text: ") {\n        "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_rparen_lbrace_open, text: ") { "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_semicolon_rbrace_inner_close, text: ";\n    }"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_semicolon_rbrace_close, text: "; }"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_if_open, text: "if ("),
      ecmascript_lex_rule(token_class: ^ecmascript_token_let_assign_semicolon, text: "let "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_return_inner, text: "\n        return "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_return_outer, text: "\n    return "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_kw_function, text: "function "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_kw_return, text: "return "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_kw_if, text: "if "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_kw_let, text: "let "),
      ecmascript_int_literal_lex_rule(),
      ecmascript_ident_lex_rule(),
      ecmascript_lex_rule(token_class: ^ecmascript_token_equal, text: " = "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_plus, text: " + "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_greater, text: " > "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_lparen, text: "("),
      ecmascript_lex_rule(token_class: ^ecmascript_token_rparen, text: ")"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_lbrace, text: "{"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_rbrace, text: "}"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_comma, text: ", "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_semicolon, text: ";")
    ]
  }
}

fn ecmascript_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules { root: ecmascript_lex_rules() }
}

fn ecmascript_grammar_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  ecmascript_inhabitant_atom(id: id)
}

fn ecmascript_grammar_root() -> v2.std.grammar.GrammarRoot {
  v2.std.grammar.GrammarRoot {
    start: ^ecmascript_production_fn_decl,
    productions: [
      ecmascript_grammar_production_fn_add(),

      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_fn_decl,
          rhs: [
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_kw_function),
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_ident),
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_lparen),
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_ident),
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_rparen_lbrace_open),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_block)
          ]
        ),
        alts: std.algebra.Empty,
        emitted: ^ecmascript_surface_fn_item
      ),

      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_block,
          rhs: [
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_stmt),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_block)
          ]
        ),
        alts: [
          v2.std.grammar.grammar_formal_production(
            lhs: ^ecmascript_production_block,
            rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_stmt)]
          )
        ],
        emitted: ^ecmascript_surface_block
      ),
      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_stmt,
          rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_assign_stmt)]
        ),
        alts: [
          v2.std.grammar.grammar_formal_production(
            lhs: ^ecmascript_production_stmt,
            rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_if_stmt)]
          ),
          v2.std.grammar.grammar_formal_production(
            lhs: ^ecmascript_production_stmt,
            rhs: [v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_return_stmt)]
          )
        ],
        emitted: ^ecmascript_surface_stmt
      ),

      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_assign_stmt,
          rhs: [
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_kw_let),
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_ident),
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_equal),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive),
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_semicolon)
          ]
        ),
        alts: std.algebra.Empty,
        emitted: ^ecmascript_surface_assign_stmt
      ),

      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_if_stmt,
          rhs: [
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_if_open),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_comparison),
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_rparen_lbrace_inner_open),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_return_stmt)
          ]
        ),
        alts: std.algebra.Empty,
        emitted: ^ecmascript_surface_if_stmt
      ),

      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_return_stmt,
          rhs: [
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_return_inner),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary),
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_semicolon)
          ]
        ),
        alts: [
          v2.std.grammar.grammar_formal_production(
            lhs: ^ecmascript_production_return_stmt,
            rhs: [
              v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_return_outer),
              v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary),
              v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_semicolon)
            ]
          ),
          v2.std.grammar.grammar_formal_production(
            lhs: ^ecmascript_production_return_stmt,
            rhs: [
              v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_kw_return),
              v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary)
            ]
          )
        ],
        emitted: ^ecmascript_surface_return_stmt
      ),
      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_comparison,
          rhs: [
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_comparison_tail)
          ]
        ),
        alts: std.algebra.Empty,
        emitted: ^ecmascript_surface_comparison
      ),

      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_comparison_tail,
          rhs: [
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_greater),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive)
          ]
        ),
        alts: [v2.std.grammar.grammar_formal_production(lhs: ^ecmascript_production_comparison_tail, rhs: std.algebra.Empty)],
        emitted: ^ecmascript_surface_comparison_tail
      ),
      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_additive,
          rhs: [
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive_tail)
          ]
        ),
        alts: std.algebra.Empty,
        emitted: ^ecmascript_surface_additive
      ),

      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_additive_tail,
          rhs: [
            v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_plus),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary),
            v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive_tail)
          ]
        ),
        alts: [v2.std.grammar.grammar_formal_production(lhs: ^ecmascript_production_additive_tail, rhs: std.algebra.Empty)],
        emitted: ^ecmascript_surface_additive_tail
      ),
      ecmascript_formal_productions_to_grammar_production(
        head: v2.std.grammar.grammar_formal_production(
          lhs: ^ecmascript_production_primary,
          rhs: [v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_ident)]
        ),
        alts: [
          v2.std.grammar.grammar_formal_production(
            lhs: ^ecmascript_production_primary,
            rhs: [v2.std.grammar.grammar_formal_terminal(identity: ^ecmascript_token_int_literal)]
          )
        ],
        emitted: ^ecmascript_surface_primary
      )
    ],
    sync_tokens: v2.std.grammar.grammar_empty_sync_tokens()
  }
}

fn ecmascript_grammar() -> v2.std.grammar.ParseGrammar {
  v2.std.grammar.ModeledGrammar { root: ecmascript_grammar_root() }
}

fn ecmascript_lex_token_symbol(sym: v2.std.node.Symbol) -> Bool {
  v2.std.compilers.lexing.lex_rule_set_token_class_member(
    rules: ecmascript_lex_rules(),
    token_class: sym
  )
}

fn ecmascript_number_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  ecmascript_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: ecmascript_number_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn ecmascript_bigint_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  ecmascript_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: ecmascript_bigint_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn ecmascript_boolean_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  ecmascript_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: ecmascript_boolean_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn ecmascript_string_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  ecmascript_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: ecmascript_string_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn ecmascript_symbol_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  ecmascript_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: ecmascript_symbol_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn ecmascript_singleton_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  ecmascript_catalog_surface_symbol_in_rows(
    sym: sym,
    rows: ecmascript_singleton_facts_catalog,
    row_surface_spelling: fn(facts) { facts.surface_spelling }
  )
}

fn ecmascript_catalog_surface_symbol(sym: v2.std.node.Symbol) -> Bool {
  ecmascript_number_catalog_surface_symbol(sym: sym) ||
    ecmascript_bigint_catalog_surface_symbol(sym: sym) ||
    ecmascript_boolean_catalog_surface_symbol(sym: sym) ||
    ecmascript_string_catalog_surface_symbol(sym: sym) ||
    ecmascript_symbol_catalog_surface_symbol(sym: sym) ||
    ecmascript_singleton_catalog_surface_symbol(sym: sym)
}

fn ecmascript_language_model_canonical_symbols() -> std.algebra.PointwisePower<v2.std.node.Symbol> {
  std.algebra.PointwisePower {
    member: fn(sym) {
      ecmascript_catalog_surface_symbol(sym: sym) ||
        ecmascript_lex_token_symbol(sym: sym) ||
        v2.std.grammar.grammar_carries_symbol(grammar: ecmascript_grammar(), sym: sym) ||
        sym == ^ecmascript_surface_fn_item ||
        sym == ^ecmascript_production_fn_add ||
        sym == ^ecmascript_source_literal
    }
  }
}

fn ecmascript_language_model() -> v2.std.language_model.LanguageModel {
  v2.std.language_model.LanguageModel {
    lex: ecmascript_lex(),
    grammar: ecmascript_grammar(),
    language_identity: ^ecmascript_language_model_surface_id,
    canonical_symbols: ecmascript_language_model_canonical_symbols(),
    core: ecmascript_model_core()
  }
}
