    kind: TypeNode { connective: Conj },
    children: [
      ecmascript_named_edge(name: ^ecmascript_inhabitant_field_atom, target: ecmascript_inhabitant_atom(id: id)),
      ecmascript_named_edge(name: ^ecmascript_inhabitant_field_facts, target: facts)
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ecmascript_number_inhabitant_node() -> Node {
  ecmascript_inhabitant_node(
    id: ^ecmascript_inhabitant_number,
    facts: ecmascript_number_facts_node(facts: ecmascript_facts_number)
