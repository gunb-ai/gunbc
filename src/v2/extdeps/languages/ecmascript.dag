fn ecmascript_primitive_bundle_from_number_facts(
  facts: EcmascriptNumberPrimitiveFacts
) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: ecmascript_number_facts_node(facts: facts),
    spec_facts: ecmascript_number_spec_facts(facts: facts)
  }
}

