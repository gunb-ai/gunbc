        target: ecmascript_inhabitant_atom(id: facts.surface_spelling)
      ),
      ecmascript_named_edge(
        name: ^ecmascript_facts_field_encoding,
        target: ecmascript_inhabitant_atom(id: facts.encoding)
      ),
      ecmascript_named_edge(
        name: ^ecmascript_facts_field_std_projection,
        target: ecmascript_inhabitant_atom(id: facts.std_projection)
