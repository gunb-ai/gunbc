fn ecmascript_primitive_bundles_from_number_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: ecmascript_number_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: ecmascript_primitive_bundle_from_number_facts(facts: facts)
      )
    }
  )
}

