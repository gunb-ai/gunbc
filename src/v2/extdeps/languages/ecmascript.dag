        name: ^ecmascript_facts_field_surface_spelling,
        target: ecmascript_inhabitant_atom(id: facts.surface_spelling)
      ),
      ecmascript_named_edge(
        name: ^ecmascript_facts_field_singleton_kind,
        target: ecmascript_inhabitant_atom(id: discriminant(v: facts.kind))
      ),
      ecmascript_named_edge(
        name: ^ecmascript_facts_field_std_projection,
        target: ecmascript_inhabitant_atom(id: facts.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ecmascript_number_spec_facts(facts: EcmascriptNumberPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          Holds { value: ecmascript_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          Holds { value: ecmascript_inhabitant_atom(id: facts.machine_representation) }
      } else {
          Violates {
            diagnostic: primitive_fact_axis_unbound_diagnostic(axis: axis)
          }
      }
    }
  }
}

