type EcmascriptSingletonKind
  = UndefinedT | NullT

type EcmascriptScalar
  = NumberScalar | BigIntScalar | BooleanScalar | StringScalar | SymbolScalar | Singleton { kind: EcmascriptSingletonKind }

type EcmascriptCost {
  operation_cost: Int
  allocation_cost: Int
}

type EcmascriptGrammarRelationRow {
  production: FormalProduction
  emitted: Node
  tokens: List<ConcreteSyntaxToken>
}

type EcmascriptNumberPrimitiveFacts {
  surface_spelling: Symbol
  machine_representation: Symbol
  std_projection: Symbol
}

type EcmascriptBigIntPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type EcmascriptBooleanPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type EcmascriptStringPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type EcmascriptSymbolPrimitiveFacts {
  surface_spelling: Symbol
  encoding: Symbol
  std_projection: Symbol
}

type EcmascriptSingletonPrimitiveFacts {
  surface_spelling: Symbol
  kind: EcmascriptSingletonKind
  std_projection: Symbol
}

data ecmascript_source_text: String = "function add(x, y) { return x + y; }"

fn ecmascript_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^ecmascript_token_kw_function },
    BoundToken { token_class: ^ecmascript_token_ident, binding: ^ecmascript_binding_fn_add },
    FixedToken { token_class: ^ecmascript_token_lparen },
    BoundToken { token_class: ^ecmascript_token_ident, binding: ^ecmascript_binding_param_x },
    FixedToken { token_class: ^ecmascript_token_comma },
    BoundToken { token_class: ^ecmascript_token_ident, binding: ^ecmascript_binding_param_y },
    FixedToken { token_class: ^ecmascript_token_rparen_lbrace_open },
    FixedToken { token_class: ^ecmascript_token_kw_return },
    BoundToken { token_class: ^ecmascript_token_ident, binding: ^ecmascript_binding_param_x },
    FixedToken { token_class: ^ecmascript_token_plus },
    BoundToken { token_class: ^ecmascript_token_ident, binding: ^ecmascript_binding_param_y },
    FixedToken { token_class: ^ecmascript_token_semicolon_rbrace_close }
  ]
}

data ecmascript_facts_number: EcmascriptNumberPrimitiveFacts = EcmascriptNumberPrimitiveFacts {
  surface_spelling: ^ecmascript_surface_spelling_number,
  machine_representation: ^ecmascript_repr_number_ieee754_binary64,
  std_projection: ^ecmascript_std_projection_number
}

data ecmascript_facts_bigint: EcmascriptBigIntPrimitiveFacts = EcmascriptBigIntPrimitiveFacts {
  surface_spelling: ^ecmascript_surface_spelling_bigint,
  encoding: ^ecmascript_repr_bigint_arbitrary_precision,
  std_projection: ^ecmascript_std_projection_bigint
}

data ecmascript_facts_boolean: EcmascriptBooleanPrimitiveFacts = EcmascriptBooleanPrimitiveFacts {
  surface_spelling: ^ecmascript_surface_spelling_boolean,
  encoding: ^ecmascript_repr_boolean_ecma_boolean,
  std_projection: ^ecmascript_std_projection_boolean
}

data ecmascript_facts_string: EcmascriptStringPrimitiveFacts = EcmascriptStringPrimitiveFacts {
  surface_spelling: ^ecmascript_surface_spelling_string,
  encoding: ^ecmascript_repr_string_utf16_code_unit_sequence,
  std_projection: ^ecmascript_std_projection_string
}

data ecmascript_facts_symbol: EcmascriptSymbolPrimitiveFacts = EcmascriptSymbolPrimitiveFacts {
  surface_spelling: ^ecmascript_surface_spelling_symbol,
  encoding: ^ecmascript_repr_symbol_unique_identity,
  std_projection: ^ecmascript_std_projection_symbol
}

data ecmascript_facts_undefined: EcmascriptSingletonPrimitiveFacts = EcmascriptSingletonPrimitiveFacts {
  surface_spelling: ^ecmascript_surface_spelling_undefined,
  kind: UndefinedT,
  std_projection: ^ecmascript_std_projection_undefined
}

data ecmascript_facts_null: EcmascriptSingletonPrimitiveFacts = EcmascriptSingletonPrimitiveFacts {
  surface_spelling: ^ecmascript_surface_spelling_null,
  kind: NullT,
  std_projection: ^ecmascript_std_projection_null
}

data ecmascript_number_facts_catalog: List<EcmascriptNumberPrimitiveFacts> = [
  ecmascript_facts_number
]

data ecmascript_bigint_facts_catalog: List<EcmascriptBigIntPrimitiveFacts> = [
  ecmascript_facts_bigint
]

data ecmascript_boolean_facts_catalog: List<EcmascriptBooleanPrimitiveFacts> = [
  ecmascript_facts_boolean
]

data ecmascript_string_facts_catalog: List<EcmascriptStringPrimitiveFacts> = [
  ecmascript_facts_string
]

data ecmascript_symbol_facts_catalog: List<EcmascriptSymbolPrimitiveFacts> = [
  ecmascript_facts_symbol
]

data ecmascript_singleton_facts_catalog: List<EcmascriptSingletonPrimitiveFacts> = [
  ecmascript_facts_undefined,
  ecmascript_facts_null
]

data ecmascript_bool_grounding: BooleanAlgebra<Bool> = bool_boolean_algebra

fn ecmascript_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn ecmascript_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn ecmascript_primitive_facts_node(
  surface_spelling: Symbol,
  middle_field_name: Symbol,
  middle_field_value: Symbol,
  std_projection: Symbol
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ecmascript_named_edge(
        name: ^ecmascript_facts_field_surface_spelling,
        target: ecmascript_inhabitant_atom(id: surface_spelling)
      ),
      ecmascript_named_edge(
        name: middle_field_name,
        target: ecmascript_inhabitant_atom(id: middle_field_value)
      ),
      ecmascript_named_edge(
        name: ^ecmascript_facts_field_std_projection,
        target: ecmascript_inhabitant_atom(id: std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ecmascript_primitive_spec_facts(
  surface_spelling: Symbol,
  encoding_value: Symbol
) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          v2.std.optional.Present { value: ecmascript_inhabitant_atom(id: surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          v2.std.optional.Present { value: ecmascript_inhabitant_atom(id: encoding_value) }
      } else {
          v2.std.optional.Absent
      }
    }
  }
}

fn ecmascript_primitive_algebra_witness_node(
  witness_field_name: Symbol,
  witness_tag: Symbol,
  middle_field_name: Symbol,
  middle_field_value: Symbol,
  std_projection: Symbol
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ecmascript_named_edge(
        name: witness_field_name,
        target: ecmascript_inhabitant_atom(id: witness_tag)
      ),
      ecmascript_named_edge(
        name: middle_field_name,
        target: ecmascript_inhabitant_atom(id: middle_field_value)
      ),
      ecmascript_named_edge(
        name: ^ecmascript_facts_field_std_projection,
        target: ecmascript_inhabitant_atom(id: std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn ecmascript_catalog_surface_symbol_in_rows<T>(
  sym: Symbol,
  rows: List<T>,
  row_surface_spelling: fn(T) -> Symbol
) -> Bool {
  fold_list(
    xs: rows,
    empty: false,
    cons: fn(acc, row) {
      acc || sym == row_surface_spelling(row)
    }
  )
}

fn ecmascript_primitive_fact_bundles_from_catalog_rows<T>(
  rows: List<T>,
  row_to_bundle: fn(T) -> PrimitiveFactBundle
) -> List<PrimitiveFactBundle> {
  fold_list(
    xs: rows,
    empty: Empty,
    cons: fn(acc, row) {
      list_snoc_item(xs: acc, item: row_to_bundle(row))
    }
  )
}

fn ecmascript_number_facts_node(facts: EcmascriptNumberPrimitiveFacts) -> Node {
  ecmascript_primitive_facts_node(
    surface_spelling: facts.surface_spelling,
    middle_field_name: ^ecmascript_facts_field_machine_representation,
    middle_field_value: facts.machine_representation,
    std_projection: facts.std_projection
  )
}

