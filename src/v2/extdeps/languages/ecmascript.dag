fn ecmascript_wave1_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  list_append(
    left: list_append(
      left: list_append(
        left: list_append(
          left: list_append(
            left: ecmascript_primitive_bundles_from_number_catalog(),
            right: ecmascript_primitive_bundles_from_bigint_catalog()
          ),
          right: ecmascript_primitive_bundles_from_boolean_catalog()
        ),
        right: ecmascript_primitive_bundles_from_string_catalog()
      ),
      right: ecmascript_primitive_bundles_from_symbol_catalog()
    ),
    right: ecmascript_primitive_bundles_from_singleton_catalog()
  )
}

