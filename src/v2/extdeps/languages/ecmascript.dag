    kind: TypeNode { connective: Conj },
    children: ecmascript_mvp1_serialize_source_children(),
    occurrence_id: SyntheticOccurrence
}
}

// --- FormalProduction authority (flat rhs) + GrammarExpr operational shim (parse.dag) ---

fn ecmascript_formal_rhs_from_token_classes() -> List<FormalGrammarSymbol> {
  fold_list(
    xs: ecmascript_mvp1_concrete_tokens(),
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: concrete_syntax_token_class(token: token))
      )
    }
  )
}

// 🟡 gated — feature:ecmascript-formal-symbol-to-grammar-expr-shim — bind gunbc#4761 / CP-1b —
// interim FormalGrammarSymbol → GrammarExpr projection for operational parse lowering only;
// dissolve-on: std/grammar substrate projects FormalGrammarSymbol to GrammarExpr directly.
fn ecmascript_formal_symbol_to_grammar_expr(sym: FormalGrammarSymbol) -> GrammarExpr {
  formal_grammar_symbol_to_grammar_expr(sym: sym)
}

// 🟡 gated — feature:ecmascript-formal-epsilon-grammar-expr-shim — bind gunbc#4761 / CP-1b —
// dissolve-on: std/grammar epsilon projection replaces Optional+sentinel terminal shim.
fn ecmascript_formal_epsilon_grammar_expr() -> GrammarExpr {
  Optional {
    element: Terminal { token_class: ^ecmascript_formal_epsilon_shim_terminal, stamp: StampClass }
  }
}

// 🟡 gated — feature:ecmascript-formal-rhs-to-expr-shim-fold — bind gunbc#4761 / CP-1b —
// interim fold carrier for FormalProduction.rhs → GrammarExpr Sequence lowering only;
// dissolve-on: std/grammar substrate fold_non_empty_right (or equivalent) replaces this coproduct.
type EcmascriptFormalRhsToExprState
  = EcmascriptFormalRhsToExprUninitialized
  | EcmascriptFormalRhsToExprReady { expr: GrammarExpr }

fn ecmascript_formal_rhs_to_grammar_expr(rhs: List<FormalGrammarSymbol>) -> GrammarExpr {
  match fold_list(
    xs: rhs,
    empty: EcmascriptFormalRhsToExprUninitialized,
    cons: fn(state, sym) {
      let piece = ecmascript_formal_symbol_to_grammar_expr(sym: sym)
      match state {
        EcmascriptFormalRhsToExprUninitialized =>
          EcmascriptFormalRhsToExprReady { expr: piece }
        EcmascriptFormalRhsToExprReady { expr: acc } =>
          EcmascriptFormalRhsToExprReady {
            expr: Sequence { left: acc, right: piece }
          }
      }
    }
  ) {
    EcmascriptFormalRhsToExprUninitialized => ecmascript_formal_epsilon_grammar_expr()
    EcmascriptFormalRhsToExprReady { expr: result } => result
  }
}

// 🟡 gated — feature:ecmascript-formal-alt-choice-shim-fold — bind gunbc#4761 / CP-1b —
// interim fold carrier for multi-alt FormalProduction lhs → GrammarExpr Choice lowering only;
// dissolve-on: std/grammar substrate fold_non_empty_right (or equivalent) replaces this coproduct.
type EcmascriptFormalAltChoiceState
  = EcmascriptFormalAltChoiceUninitialized
  | EcmascriptFormalAltChoiceReady { expr: GrammarExpr }

fn ecmascript_formal_alternatives_to_choice_expr(alts: List<List<FormalGrammarSymbol>>) -> GrammarExpr {
  match fold_list(
    xs: alts,
    empty: EcmascriptFormalAltChoiceUninitialized,
    cons: fn(state, rhs) {
      let alt_expr = ecmascript_formal_rhs_to_grammar_expr(rhs: rhs)
      match state {
        EcmascriptFormalAltChoiceUninitialized =>
          EcmascriptFormalAltChoiceReady { expr: alt_expr }
        EcmascriptFormalAltChoiceReady { expr: acc } =>
          EcmascriptFormalAltChoiceReady {
            expr: Choice { left: acc, right: alt_expr }
          }
      }
    }
  ) {
    EcmascriptFormalAltChoiceUninitialized => ecmascript_formal_epsilon_grammar_expr()
    EcmascriptFormalAltChoiceReady { expr: result } => result
  }
}

fn ecmascript_formal_rhs_alternatives_accum_empty() -> List<List<FormalGrammarSymbol>> {
  Empty
}

fn ecmascript_formal_collect_rhs_alternative(
  acc: List<List<FormalGrammarSymbol>>,
  prod: FormalProduction
) -> List<List<FormalGrammarSymbol>> {
  list_snoc_item(xs: acc, item: prod.rhs)
}

fn ecmascript_formal_rhs_alternatives_from_productions(
  prods: List<FormalProduction>
) -> List<List<FormalGrammarSymbol>> {
  fold_list(
    xs: prods,
    empty: ecmascript_formal_rhs_alternatives_accum_empty(),
    cons: ecmascript_formal_collect_rhs_alternative
  )
}

fn ecmascript_formal_productions_to_grammar_expr(prods: List<FormalProduction>) -> GrammarExpr {
  ecmascript_formal_alternatives_to_choice_expr(
    alts: ecmascript_formal_rhs_alternatives_from_productions(prods: prods)
  )
}

fn ecmascript_formal_production_alts(
  head: FormalProduction,
  alts: List<FormalProduction>
) -> List<FormalProduction> {
  list_append(left: [head], right: alts)
}

fn ecmascript_formal_productions_to_grammar_production(
  head: FormalProduction,
  alts: List<FormalProduction>,
  emitted: Symbol
) -> GrammarProduction {
  GrammarProduction {
    name: head.lhs.identity,
    expression: ecmascript_formal_productions_to_grammar_expr(
      prods: ecmascript_formal_production_alts(head: head, alts: alts)
    ),
    emitted: ecmascript_grammar_atom(id: emitted)
  }
}

fn ecmascript_formal_production_mvp1_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: ^ecmascript_production_mvp1_fn_add,
    rhs: ecmascript_formal_rhs_from_token_classes()
  )
}

fn ecmascript_wave1_formal_productions() -> List<FormalProduction> {
  [ecmascript_formal_production_mvp1_fn_add()]
}

fn ecmascript_grammar_production_mvp1_fn_add() -> GrammarProduction {
  GrammarProduction {
    name: ^ecmascript_production_mvp1_fn_add,
    expression: ecmascript_formal_productions_to_grammar_expr(
      prods: [ecmascript_formal_production_mvp1_fn_add()]
    ),
    emitted: ecmascript_mvp1_emitted_add_fn_node()
  }
}

fn ecmascript_mvp1_grammar_relation_row() -> EcmascriptGrammarRelationRow {
  EcmascriptGrammarRelationRow {
    production: ecmascript_formal_production_mvp1_fn_add(),
    emitted: ecmascript_mvp1_emitted_add_fn_node(),
    tokens: ecmascript_mvp1_concrete_tokens()
  }
}


fn ecmascript_grammar_relation_row_node(row: EcmascriptGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ecmascript_named_edge(name: ^grammar_relation_field_production, target: formal_production_to_node(production: row.production)),
      ecmascript_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      ecmascript_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: ecmascript_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ecmascript_mvp1_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ecmascript_named_edge(
        name: ^ecmascript_relation_rule_mvp1_fn_add,
        target: ecmascript_grammar_relation_row_node(row: ecmascript_mvp1_grammar_relation_row())
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ecmascript_mvp1_target_model_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      ecmascript_named_edge(name: ^target_model_edge_selection_policy, target: ecmascript_mvp1_selection_policy_node()),
      ecmascript_named_edge(name: ^target_model_edge_declared_inhabitants, target: ecmascript_declared_inhabitants_root()),
      ecmascript_named_edge(name: ^target_model_edge_translation_rules, target: ecmascript_mvp1_translation_rules_node()),
      ecmascript_named_edge(name: ^target_model_edge_serialize_source, target: ecmascript_mvp1_serialize_source_node())
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn ecmascript_mvp1_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^ecmascript_binding_fn_add, "add"),
      ^ecmascript_binding_param_x,
      "x"
    ),
    ^ecmascript_binding_param_y,
    "y"
  )
}

fn ecmascript_mvp1_target_model() -> TargetModel {
  TargetModel {
    bundle: ecmascript_mvp1_target_model_node(),
    lex: ecmascript_wave1_lex(),
    binding_spellings: ecmascript_mvp1_binding_spellings(),
    authority_source_text: ecmascript_mvp1_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn ecmascript_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule { token_class: token_class, pattern: LiteralPattern { text: text } }
}

fn ecmascript_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn ecmascript_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^ecmascript_token_ident,
    pattern: ecmascript_ident_lex_pattern()
  }
}

// 🟡 predicate dissolution — feature:ecmascript-wave2a-decimal-int-literal — bind gunbc#4761 —
// dissolve-on: std LexCharClass carries NonZeroDigitChar (or full ES2022 NumericLiteral LexPattern).
// 🟡 gated — feature:ecmascript-wave2a-decimal-int-literal — ASCII 49–57 ladder until
// `NonZeroDigitChar` lands on v2.std.compilers.lexing; consumed only by ecmascript_decimal_int_literal_pattern.
fn ecmascript_nonzero_digit_char_pattern() -> LexPattern {
  ChoicePattern {
    left: CharPattern { char: 49 },
    right: ChoicePattern {
      left: CharPattern { char: 50 },
      right: ChoicePattern {
        left: CharPattern { char: 51 },
        right: ChoicePattern {
          left: CharPattern { char: 52 },
          right: ChoicePattern {
            left: CharPattern { char: 53 },
            right: ChoicePattern {
              left: CharPattern { char: 54 },
              right: ChoicePattern {
                left: CharPattern { char: 55 },
                right: ChoicePattern {
                  left: CharPattern { char: 56 },
                  right: CharPattern { char: 57 }
                }
              }
            }
          }
        }
      }
    }
  }
}

// 🟡 gated — feature:ecmascript-wave2a-decimal-int-literal — decimal subset `0` | [1-9][0-9]* only;
// wave-2a fixture uses 0/1. Does not model 0b/0o/0x bases, NumericLiteralSeparator (`_`), nor
// the `n` BigIntLiteral suffix per ES2022 §12.8.3. Dissolves when T-6/T-7 lands the full
// NumericLiteral LexPattern.
fn ecmascript_decimal_int_literal_pattern() -> LexPattern {
  ChoicePattern {
    left: LiteralPattern { text: "0" },
    right: SequencePattern {
      left: ecmascript_nonzero_digit_char_pattern(),
      right: RepeatPattern { element: CharClassPattern { class: DigitChar } }
    }
  }
}

fn ecmascript_int_literal_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^ecmascript_token_int_literal,
    pattern: ecmascript_decimal_int_literal_pattern()
  }
}

// 🟡 gated — feature:T-6-token-layout-trivia-policy — layout/whitespace/insignificant-trivia is
// baked into LiteralPattern.text below (e.g. ") { ", "; }") instead of ES2022 §12.2
// WhiteSpace/LineTerminator/Comment trivia carriers. Dissolves when T-6 supplies
// TokenLayout/TriviaPolicy and token_sequence_to_source interleaves layout
// (https://tc39.es/ecma262/2022/#sec-white-space).
fn ecmascript_wave1_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      ecmascript_lex_rule(token_class: ^ecmascript_token_rparen_lbrace_inner_open, text: ") {\n        "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_rparen_lbrace_open, text: ") { "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_semicolon_rbrace_inner_close, text: ";\n    }"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_semicolon_rbrace_close, text: "; }"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_if_open, text: "if ("),
      ecmascript_lex_rule(token_class: ^ecmascript_token_let_assign_semicolon, text: "let "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_return_inner, text: "\n        return "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_return_outer, text: "\n    return "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_kw_function, text: "function "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_kw_return, text: "return "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_kw_if, text: "if "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_kw_let, text: "let "),
      ecmascript_int_literal_lex_rule(),
      ecmascript_ident_lex_rule(),
      ecmascript_lex_rule(token_class: ^ecmascript_token_equal, text: " = "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_plus, text: " + "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_greater, text: " > "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_lparen, text: "("),
      ecmascript_lex_rule(token_class: ^ecmascript_token_rparen, text: ")"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_lbrace, text: "{"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_rbrace, text: "}"),
      ecmascript_lex_rule(token_class: ^ecmascript_token_comma, text: ", "),
      ecmascript_lex_rule(token_class: ^ecmascript_token_semicolon, text: ";")
    ]
  }
}

fn ecmascript_wave1_lex() -> LexRules {
  ModeledLexRules { root: ecmascript_wave1_lex_rules() }
}

fn ecmascript_grammar_atom(id: Symbol) -> Node {
  ecmascript_inhabitant_atom(id: id)
}

fn ecmascript_wave1_grammar_root() -> GrammarRoot {
  GrammarRoot {
    start: ^ecmascript_production_fn_decl,
    productions: [
      ecmascript_grammar_production_mvp1_fn_add(),
      // FunctionDeclaration (ES2022 §15.2): `function` BindingIdentifier `(` FormalParameters `)` Block.
      // MVP-1 monomorphizes FormalParameters to a single binding identifier — wider arity is wave-2a
      // extension after T-6/T-7 lex/grammar substrate broadens.
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_fn_decl,
          rhs: [
            grammar_formal_terminal(identity: ^ecmascript_token_kw_function),
            grammar_formal_terminal(identity: ^ecmascript_token_ident),
            grammar_formal_terminal(identity: ^ecmascript_token_lparen),
            grammar_formal_terminal(identity: ^ecmascript_token_ident),
            grammar_formal_terminal(identity: ^ecmascript_token_rparen_lbrace_open),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_block)
          ]
        ),
        alts: Empty,
        emitted: ^ecmascript_surface_fn_item
      ),
      // Block (ES2022 §14.2): `{` StatementList `}` — layout baked into the closing composite token.
      // Left-biased Choice: longer/recursive block alt must precede single-stmt alt.
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_block,
          rhs: [
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_stmt),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_block)
          ]
        ),
        alts: [
          grammar_formal_production(
            lhs: ^ecmascript_production_block,
            rhs: [grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_stmt)]
          )
        ],
        emitted: ^ecmascript_surface_block
      ),
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_stmt,
          rhs: [grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_assign_stmt)]
        ),
        alts: [
          grammar_formal_production(
            lhs: ^ecmascript_production_stmt,
            rhs: [grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_if_stmt)]
          ),
          grammar_formal_production(
            lhs: ^ecmascript_production_stmt,
            rhs: [grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_return_stmt)]
          )
        ],
        emitted: ^ecmascript_surface_stmt
      ),
      // LexicalDeclaration (ES2022 §14.3.1): `let` BindingIdentifier `=` AssignmentExpression `;`.
      // MVP carries plain `Identifier = AssignmentExpression` form; `let` keyword and semicolon
      // emission are layout-baked.
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_assign_stmt,
          rhs: [
            grammar_formal_terminal(identity: ^ecmascript_token_kw_let),
            grammar_formal_terminal(identity: ^ecmascript_token_ident),
            grammar_formal_terminal(identity: ^ecmascript_token_equal),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive),
            grammar_formal_terminal(identity: ^ecmascript_token_semicolon)
          ]
        ),
        alts: Empty,
        emitted: ^ecmascript_surface_assign_stmt
      ),
      // IfStatement (ES2022 §14.6) head: `if (` Expression `) {` Statement `}` — single-body MVP.
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_if_stmt,
          rhs: [
            grammar_formal_terminal(identity: ^ecmascript_token_if_open),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_comparison),
            grammar_formal_terminal(identity: ^ecmascript_token_rparen_lbrace_inner_open),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_return_stmt)
          ]
        ),
        alts: Empty,
        emitted: ^ecmascript_surface_if_stmt
      ),
      // ReturnStatement (ES2022 §14.10): `return` Expression `;` — layout alts cover outer/inner.
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_return_stmt,
          rhs: [
            grammar_formal_terminal(identity: ^ecmascript_token_return_inner),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary),
            grammar_formal_terminal(identity: ^ecmascript_token_semicolon)
          ]
        ),
        alts: [
          grammar_formal_production(
            lhs: ^ecmascript_production_return_stmt,
            rhs: [
              grammar_formal_terminal(identity: ^ecmascript_token_return_outer),
              grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary),
              grammar_formal_terminal(identity: ^ecmascript_token_semicolon)
            ]
          ),
          grammar_formal_production(
            lhs: ^ecmascript_production_return_stmt,
            rhs: [
              grammar_formal_terminal(identity: ^ecmascript_token_kw_return),
              grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary)
            ]
          )
        ],
        emitted: ^ecmascript_surface_return_stmt
      ),
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_comparison,
          rhs: [
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_comparison_tail)
          ]
        ),
        alts: Empty,
        emitted: ^ecmascript_surface_comparison
      ),
      // Left-biased Choice: consuming alt before empty tail alt.
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_comparison_tail,
          rhs: [
            grammar_formal_terminal(identity: ^ecmascript_token_greater),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive)
          ]
        ),
        alts: [grammar_formal_production(lhs: ^ecmascript_production_comparison_tail, rhs: Empty)],
        emitted: ^ecmascript_surface_comparison_tail
      ),
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_additive,
          rhs: [
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive_tail)
          ]
        ),
        alts: Empty,
        emitted: ^ecmascript_surface_additive
      ),
      // Left-biased Choice: consuming alt before empty tail alt.
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_additive_tail,
          rhs: [
            grammar_formal_terminal(identity: ^ecmascript_token_plus),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_primary),
            grammar_formal_nonterminal_occurrence(identity: ^ecmascript_production_additive_tail)
          ]
        ),
        alts: [grammar_formal_production(lhs: ^ecmascript_production_additive_tail, rhs: Empty)],
        emitted: ^ecmascript_surface_additive_tail
      ),
      ecmascript_formal_productions_to_grammar_production(
        head: grammar_formal_production(
          lhs: ^ecmascript_production_primary,
          rhs: [grammar_formal_terminal(identity: ^ecmascript_token_ident)]
        ),
        alts: [
          grammar_formal_production(
            lhs: ^ecmascript_production_primary,
            rhs: [grammar_formal_terminal(identity: ^ecmascript_token_int_literal)]
          )
        ],
        emitted: ^ecmascript_surface_primary
      )
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn ecmascript_wave1_grammar() -> ParseGrammar {
  ModeledGrammar { root: ecmascript_wave1_grammar_root() }
}

fn ecmascript_wave1_lex_token_symbol(sym: Symbol) -> Bool {
  lex_rule_set_token_class_member(
    rules: ecmascript_wave1_lex_rules(),
    token_class: sym
  )
}

fn ecmascript_catalog_surface_spelling_eq(sym: Symbol, spelling: Symbol) -> Bool {
  sym == spelling
}

fn ecmascript_catalog_surface_fold_false() -> Bool {
  false
}

fn ecmascript_number_catalog_surface_step(
  sym: Symbol,
  acc: Bool,
  facts: EcmascriptNumberPrimitiveFacts
) -> Bool {
  acc || ecmascript_catalog_surface_spelling_eq(sym: sym, spelling: facts.surface_spelling)
}

fn ecmascript_number_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: ecmascript_number_facts_catalog,
    empty: ecmascript_catalog_surface_fold_false(),
    cons: fn(acc, facts) {
      ecmascript_number_catalog_surface_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn ecmascript_bigint_catalog_surface_step(
  sym: Symbol,
  acc: Bool,
  facts: EcmascriptBigIntPrimitiveFacts
) -> Bool {
  acc || ecmascript_catalog_surface_spelling_eq(sym: sym, spelling: facts.surface_spelling)
}

fn ecmascript_bigint_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: ecmascript_bigint_facts_catalog,
    empty: ecmascript_catalog_surface_fold_false(),
    cons: fn(acc, facts) {
      ecmascript_bigint_catalog_surface_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn ecmascript_boolean_catalog_surface_step(
  sym: Symbol,
  acc: Bool,
  facts: EcmascriptBooleanPrimitiveFacts
) -> Bool {
  acc || ecmascript_catalog_surface_spelling_eq(sym: sym, spelling: facts.surface_spelling)
}

fn ecmascript_boolean_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: ecmascript_boolean_facts_catalog,
    empty: ecmascript_catalog_surface_fold_false(),
    cons: fn(acc, facts) {
      ecmascript_boolean_catalog_surface_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn ecmascript_string_catalog_surface_step(
  sym: Symbol,
  acc: Bool,
  facts: EcmascriptStringPrimitiveFacts
) -> Bool {
  acc || ecmascript_catalog_surface_spelling_eq(sym: sym, spelling: facts.surface_spelling)
}

fn ecmascript_string_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: ecmascript_string_facts_catalog,
    empty: ecmascript_catalog_surface_fold_false(),
    cons: fn(acc, facts) {
      ecmascript_string_catalog_surface_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn ecmascript_symbol_catalog_surface_step(
  sym: Symbol,
  acc: Bool,
  facts: EcmascriptSymbolPrimitiveFacts
) -> Bool {
  acc || ecmascript_catalog_surface_spelling_eq(sym: sym, spelling: facts.surface_spelling)
}

fn ecmascript_symbol_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: ecmascript_symbol_facts_catalog,
    empty: ecmascript_catalog_surface_fold_false(),
    cons: fn(acc, facts) {
      ecmascript_symbol_catalog_surface_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn ecmascript_singleton_catalog_surface_step(
  sym: Symbol,
  acc: Bool,
  facts: EcmascriptSingletonPrimitiveFacts
) -> Bool {
  acc || ecmascript_catalog_surface_spelling_eq(sym: sym, spelling: facts.surface_spelling)
}

fn ecmascript_singleton_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: ecmascript_singleton_facts_catalog,
    empty: ecmascript_catalog_surface_fold_false(),
    cons: fn(acc, facts) {
      ecmascript_singleton_catalog_surface_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn ecmascript_catalog_surface_symbol(sym: Symbol) -> Bool {
  ecmascript_number_catalog_surface_symbol(sym: sym) ||
    ecmascript_bigint_catalog_surface_symbol(sym: sym) ||
    ecmascript_boolean_catalog_surface_symbol(sym: sym) ||
    ecmascript_string_catalog_surface_symbol(sym: sym) ||
    ecmascript_symbol_catalog_surface_symbol(sym: sym) ||
    ecmascript_singleton_catalog_surface_symbol(sym: sym)
}

fn ecmascript_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      ecmascript_catalog_surface_symbol(sym: sym) ||
        ecmascript_wave1_lex_token_symbol(sym: sym) ||
        grammar_carries_symbol(grammar: ecmascript_wave1_grammar(), sym: sym) ||
        sym == ^ecmascript_surface_fn_item ||
        sym == ^ecmascript_production_mvp1_fn_add ||
        sym == ^ecmascript_mvp1_source_literal
    }
  }
}

fn ecmascript_language_model_wave1() -> EcmascriptLanguageModel {
  EcmascriptLanguageModel {
    lex: ecmascript_wave1_lex(),
    grammar: ecmascript_wave1_grammar(),
    language_identity: ^ecmascript_language_model_surface_id,
    canonical_symbols: ecmascript_language_model_canonical_symbols(),
    core: ecmascript_model_core_wave1()
  }
}
