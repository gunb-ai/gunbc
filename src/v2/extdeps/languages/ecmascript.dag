fn ecmascript_primitive_bundles_from_number_catalog() -> List<v2.std.model_core.PrimitiveFactBundle> {
  ecmascript_primitive_fact_bundles_from_catalog_rows(
    rows: ecmascript_number_facts_catalog,
    row_to_bundle: fn(facts) {
      ecmascript_primitive_bundle_from_number_facts(facts: facts)
    }
  )
}

