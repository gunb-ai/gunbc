fn ecmascript_singleton_facts_node(facts: EcmascriptSingletonPrimitiveFacts) -> v2.std.node.Node {
  ecmascript_primitive_facts_node(
    surface_spelling: facts.surface_spelling,
    middle_field_name: ^ecmascript_facts_field_singleton_kind,
    middle_field_value: discriminant(v: facts.kind),
    std_projection: facts.std_projection
  )
}

fn ecmascript_number_spec_facts(facts: EcmascriptNumberPrimitiveFacts) -> Map<v2.std.node.Symbol, v2.std.node.Node> {
  ecmascript_primitive_spec_facts(
    surface_spelling: facts.surface_spelling,
    encoding_value: facts.machine_representation
  )
}

fn ecmascript_bigint_spec_facts(facts: EcmascriptBigIntPrimitiveFacts) -> Map<v2.std.node.Symbol, v2.std.node.Node> {
  ecmascript_primitive_spec_facts(
