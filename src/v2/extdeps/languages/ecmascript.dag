  concrete_syntax_token_to_node(token: token)
}



fn ecmascript_mvp1_serialize_source_children() -> List<Edge> {
  list_append(
    left: [
      ecmascript_named_edge(name: ^serialize_source_field_source_text, target: ecmascript_inhabitant_atom(id: ^ecmascript_mvp1_source_literal)),
      ecmascript_named_edge(name: ^serialize_source_field_source_grammar, target: ecmascript_inhabitant_atom(id: ^ecmascript_production_mvp1_fn_add))
    ],
    right: [
      ecmascript_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
