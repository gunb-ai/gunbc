fn wasm_grammar_production_numeric_const_instr() -> GrammarProduction {
  GrammarProduction {
    name: ^wasm_production_numeric_const_instr,
    expression: wasm_grammar_numeric_const_instr_expr(),
    emitted: wasm_grammar_atom(id: ^wasm_surface_numeric_const_instr)
  }
}

fn wasm_grammar_production_numeric_binop_instr() -> GrammarProduction {
  GrammarProduction {
    name: ^wasm_production_numeric_binop_instr,
    expression: wasm_grammar_numeric_binop_instr_expr(),
    emitted: wasm_grammar_atom(id: ^wasm_surface_numeric_binop_instr)
  }
}

fn wasm_grammar_root() -> GrammarRoot {
  let start = wasm_grammar_production_text_fragment()
  let fn_add = wasm_grammar_production_fn_add()
  let module = wasm_grammar_production_module()
  let value_type = wasm_grammar_production_value_type()
  let i32_numeric_literal = wasm_grammar_production_i32_numeric_literal()
  let i64_numeric_literal = wasm_grammar_production_i64_numeric_literal()
  let f32_numeric_literal = wasm_grammar_production_f32_numeric_literal()
  let f64_numeric_literal = wasm_grammar_production_f64_numeric_literal()
  let localidx = wasm_grammar_production_localidx()
  let numeric_const = wasm_grammar_production_numeric_const_instr()
  let numeric_binop = wasm_grammar_production_numeric_binop_instr()
  GrammarRoot {
    start: ^wasm_production_text_fragment,
    productions: [
      start,
      fn_add,
      module,
      value_type,
      i32_numeric_literal,
      i64_numeric_literal,
      f32_numeric_literal,
      f64_numeric_literal,
      localidx,
      numeric_const,
      numeric_binop
    ],
    sync_tokens: grammar_empty_sync_tokens()
  }
}

fn wasm_grammar() -> ParseGrammar {
  ModeledGrammar { root: wasm_grammar_root() }
}

fn wasm_lex_token_symbol(sym: Symbol) -> Bool {
  lex_rule_set_token_class_member(
    rules: wasm_lex_rules(),
    token_class: sym
  )
}

fn wasm_integer_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: WasmIntegerPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn wasm_float_catalog_surface_symbol_step(
  sym: Symbol,
  acc: Bool,
  facts: WasmFloatPrimitiveFacts
) -> Bool {
  acc || sym == facts.surface_spelling
}

fn wasm_integer_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: wasm_integer_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      wasm_integer_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn wasm_float_catalog_surface_symbol(sym: Symbol) -> Bool {
  fold_list(
    xs: wasm_float_facts_catalog,
    empty: false,
    cons: fn(acc, facts) {
      wasm_float_catalog_surface_symbol_step(sym: sym, acc: acc, facts: facts)
    }
  )
}

fn wasm_catalog_surface_symbol(sym: Symbol) -> Bool {
  wasm_integer_catalog_surface_symbol(sym: sym) ||
    wasm_float_catalog_surface_symbol(sym: sym)
}

fn wasm_language_model_canonical_symbols() -> Set<Symbol> {
  Set {
    member: fn(sym) {
      wasm_catalog_surface_symbol(sym: sym) ||
        wasm_lex_token_symbol(sym: sym) ||
        sym == ^wasm_surface_fn_item ||
        sym == ^wasm_surface_text_fragment ||
        sym == ^wasm_surface_module_item ||
        sym == ^wasm_surface_value_type ||
        sym == ^wasm_surface_i32_numeric_literal ||
        sym == ^wasm_surface_i64_numeric_literal ||
        sym == ^wasm_surface_f32_numeric_literal ||
        sym == ^wasm_surface_f64_numeric_literal ||
        sym == ^wasm_surface_numeric_const_instr ||
        sym == ^wasm_surface_numeric_binop_instr ||
        sym == ^wasm_surface_localidx ||
        sym == ^wasm_binding_localidx_0 ||
        sym == ^wasm_binding_localidx_1 ||
        sym == ^wasm_numeric_immediate_field_token_class ||
        sym == ^wasm_numeric_immediate_field_width ||
        sym == ^wasm_numeric_immediate_field_validation ||
        sym == ^wasm_numeric_immediate_validation_i32_range ||
        sym == ^wasm_numeric_immediate_validation_i64_range ||
        sym == ^wasm_numeric_immediate_validation_f32_payload ||
        sym == ^wasm_numeric_immediate_validation_f64_payload ||
        sym == ^wasm_localidx_validation_u32_range ||
        sym == ^wasm_production_fn_add ||
        sym == ^wasm_production_text_fragment ||
        sym == ^wasm_production_module ||
        sym == ^wasm_production_value_type ||
        sym == ^wasm_production_i32_numeric_literal ||
        sym == ^wasm_production_i64_numeric_literal ||
        sym == ^wasm_production_f32_numeric_literal ||
        sym == ^wasm_production_f64_numeric_literal ||
        sym == ^wasm_production_numeric_const_instr ||
        sym == ^wasm_production_numeric_binop_instr ||
        sym == ^wasm_production_localidx ||
        sym == ^wasm_source_literal
    }
  }
}

fn wasm_integer_spec_facts(facts: WasmIntegerPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          v2.std.optional.Present { value: wasm_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisWidth {}) {
          v2.std.optional.Present { value: wasm_int_width_node(width: facts.width) }
      } else if axis == discriminant(v: ModelCoreFactAxisSignedness {}) {
          v2.std.optional.Present { value: wasm_inhabitant_atom(id: ^wasm_tag_sign_agnostic_modular) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          v2.std.optional.Present { value: wasm_inhabitant_atom(id: ^wasm_repr_sign_agnostic_modular) }
      } else if axis == discriminant(v: ModelCoreFactAxisOverflowDisposition {}) {
          v2.std.optional.Present { value: wasm_inhabitant_atom(id: ^wasm_tag_modular_wrap) }
      } else {
          v2.std.optional.Absent
      }
    }
  }
}

fn wasm_float_spec_facts(facts: WasmFloatPrimitiveFacts) -> Map<Symbol, Node> {
  Map {
    lookup: fn(axis) {
      if axis == discriminant(v: ModelCoreFactAxisSurfaceSpelling {}) {
          v2.std.optional.Present { value: wasm_inhabitant_atom(id: facts.surface_spelling) }
      } else if axis == discriminant(v: ModelCoreFactAxisWidth {}) {
          v2.std.optional.Present { value: wasm_float_width_node(width: facts.width) }
      } else if axis == discriminant(v: ModelCoreFactAxisEncoding {}) {
          v2.std.optional.Present { value: wasm_inhabitant_atom(id: facts.ieee754_binary) }
      } else {
          v2.std.optional.Absent
      }
    }
  }
}

fn wasm_primitive_bundle_from_integer_facts(facts: WasmIntegerPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: wasm_integer_facts_node(facts: facts),
    spec_facts: wasm_integer_spec_facts(facts: facts)
  }
}

fn wasm_primitive_bundle_from_float_facts(facts: WasmFloatPrimitiveFacts) -> PrimitiveFactBundle {
  PrimitiveFactBundle {
    substrate_carrier: wasm_float_facts_node(facts: facts),
    spec_facts: wasm_float_spec_facts(facts: facts)
  }
}

fn wasm_primitive_bundles_from_integer_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: wasm_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: wasm_primitive_bundle_from_integer_facts(facts: facts)
      )
    }
  )
}

fn wasm_primitive_bundles_from_float_catalog() -> List<PrimitiveFactBundle> {
  fold_list(
    xs: wasm_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(
        xs: acc,
        item: wasm_primitive_bundle_from_float_facts(facts: facts)
      )
    }
  )
}

fn wasm_primitive_fact_bundles() -> List<PrimitiveFactBundle> {
  list_append(
    left: wasm_primitive_bundles_from_integer_catalog(),
    right: wasm_primitive_bundles_from_float_catalog()
  )
}

type WasmModelCoreLawKey
  = WasmLawIntegerAddAssociativeModular
  | WasmLawIntegerAddCommutativeModular
  | WasmLawIntegerMulAssociativeModular
  | WasmLawIntegerMulCommutativeModular
  | WasmLawIntegerDistributiveModular
  | WasmLawIntegerModularWrap
  | WasmLawFloatIeee754Rounding
  | WasmLawFloatNanInfCarriedByIeee754
fn wasm_integer_algebra_witness_node(facts: WasmIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(
        name: ^wasm_witness_integer_commutative_semiring_modular,
        target: wasm_inhabitant_atom(id: ^wasm_witness_integer_commutative_semiring_modular)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_surface_spelling,
        target: wasm_inhabitant_atom(id: facts.surface_spelling)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_width,
        target: wasm_int_width_node(width: facts.width)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_std_projection,
        target: wasm_inhabitant_atom(id: facts.std_projection)
      ),
      wasm_named_edge(
        name: discriminant(v: ModelCoreFactAxisSignedness {}),
        target: wasm_inhabitant_atom(id: ^wasm_tag_sign_agnostic_modular)
      ),
      wasm_named_edge(
        name: discriminant(v: ModelCoreFactAxisOverflowDisposition {}),
        target: wasm_inhabitant_atom(id: ^wasm_tag_modular_wrap)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn wasm_float_algebra_witness_node(facts: WasmFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(
        name: ^wasm_witness_float_approximate_field,
        target: wasm_inhabitant_atom(id: ^wasm_witness_float_approximate_field)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_ieee754_binary,
        target: wasm_inhabitant_atom(id: facts.ieee754_binary)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_std_projection,
        target: wasm_inhabitant_atom(id: facts.std_projection)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn wasm_integer_algebra_inhabitance(facts: WasmIntegerPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = wasm_integer_inhabitant_for_facts(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: commutative_semiring_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: wasm_integer_algebra_witness_node(facts: facts)
  }
}

fn wasm_float_algebra_inhabitance(facts: WasmFloatPrimitiveFacts) -> AlgebraInhabitanceDecl {
  let inhabitant = wasm_float_inhabitant_for_facts(facts: facts)
  AlgebraInhabitanceDecl {
    algebra: approximate_field_type_node(inhabitant: inhabitant),
    inhabitant: inhabitant,
    witness: wasm_float_algebra_witness_node(facts: facts)
  }
}

fn wasm_integer_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: wasm_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: wasm_integer_algebra_inhabitance(facts: facts))
    }
  )
}

fn wasm_float_algebra_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  fold_list(
    xs: wasm_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_snoc_item(xs: acc, item: wasm_float_algebra_inhabitance(facts: facts))
    }
  )
}

fn wasm_model_core_inhabitance_decls() -> List<AlgebraInhabitanceDecl> {
  list_append(
    left: wasm_integer_algebra_inhabitance_decls(),
    right: wasm_float_algebra_inhabitance_decls()
  )
}

fn wasm_model_core_law_node(witness: Node, algebra: Node, key: WasmModelCoreLawKey) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(name: ^model_core_law_field_subject, target: witness),
      wasm_named_edge(name: ^model_core_law_field_algebra, target: algebra),
      wasm_named_edge(
        name: ^model_core_law_field_kind,
        target: wasm_inhabitant_atom(id: discriminant(v: key))
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn wasm_model_core_law_obligation(witness: Node, law: Node) -> AlgebraLawObligation {
  AlgebraLawObligation {
    inhabitance_witness: witness,
    law: law
  }
}

fn wasm_integer_law_obligations(facts: WasmIntegerPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = wasm_integer_algebra_witness_node(facts: facts)
  let inhabitant = wasm_integer_inhabitant_for_facts(facts: facts)
  let algebra = commutative_semiring_type_node(inhabitant: inhabitant)
  [
    wasm_model_core_law_obligation(
      witness: witness,
      law: wasm_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: WasmLawIntegerAddAssociativeModular
      )
    ),
    wasm_model_core_law_obligation(
      witness: witness,
      law: wasm_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: WasmLawIntegerAddCommutativeModular
      )
    ),
    wasm_model_core_law_obligation(
      witness: witness,
      law: wasm_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: WasmLawIntegerMulAssociativeModular
      )
    ),
    wasm_model_core_law_obligation(
      witness: witness,
      law: wasm_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: WasmLawIntegerMulCommutativeModular
      )
    ),
    wasm_model_core_law_obligation(
      witness: witness,
      law: wasm_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: WasmLawIntegerDistributiveModular
      )
    ),
    wasm_model_core_law_obligation(
      witness: witness,
      law: wasm_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: WasmLawIntegerModularWrap
      )
    )
  ]
}

fn wasm_float_law_obligations(facts: WasmFloatPrimitiveFacts) -> List<AlgebraLawObligation> {
  let witness = wasm_float_algebra_witness_node(facts: facts)
  let inhabitant = wasm_float_inhabitant_for_facts(facts: facts)
  let algebra = approximate_field_type_node(inhabitant: inhabitant)
  [
    wasm_model_core_law_obligation(
      witness: witness,
      law: wasm_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: WasmLawFloatIeee754Rounding
      )
    ),
    wasm_model_core_law_obligation(
      witness: witness,
      law: wasm_model_core_law_node(
        witness: witness,
        algebra: algebra,
        key: WasmLawFloatNanInfCarriedByIeee754
      )
    )
  ]
}

fn wasm_integer_algebra_laws() -> List<AlgebraLawObligation> {
  fold_list(
    xs: wasm_integer_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(left: acc, right: wasm_integer_law_obligations(facts: facts))
    }
  )
}

fn wasm_float_algebra_laws() -> List<AlgebraLawObligation> {
  fold_list(
    xs: wasm_float_facts_catalog,
    empty: Empty,
    cons: fn(acc, facts) {
      list_append(left: acc, right: wasm_float_law_obligations(facts: facts))
    }
  )
}

fn wasm_model_core_law_obligations() -> List<AlgebraLawObligation> {
  list_append(
    left: wasm_integer_algebra_laws(),
    right: wasm_float_algebra_laws()
  )
}

fn wasm_pure_operation(operation: Symbol) -> PrimitiveOperationRef {
  PrimitiveOperationRef {
    operation: wasm_inhabitant_atom(id: operation),
    effect_signature: EffectSignature {
      signature: wasm_inhabitant_atom(id: ^wasm_effect_signature_pure_value)
    }
  }
}

fn wasm_effect_semantics() -> EffectSemanticsDecl {
  EffectSemanticsDecl {
    operations: [
      wasm_pure_operation(operation: ^wasm_op_integer_add),
      wasm_pure_operation(operation: ^wasm_op_integer_sub),
      wasm_pure_operation(operation: ^wasm_op_integer_mul),
      wasm_pure_operation(operation: ^wasm_op_integer_div_s),
      wasm_pure_operation(operation: ^wasm_op_integer_div_u),
      wasm_pure_operation(operation: ^wasm_op_integer_rem_s),
      wasm_pure_operation(operation: ^wasm_op_integer_rem_u),
      wasm_pure_operation(operation: ^wasm_op_integer_and),
      wasm_pure_operation(operation: ^wasm_op_integer_or),
      wasm_pure_operation(operation: ^wasm_op_integer_xor),
      wasm_pure_operation(operation: ^wasm_op_integer_shl),
      wasm_pure_operation(operation: ^wasm_op_integer_shr_s),
      wasm_pure_operation(operation: ^wasm_op_integer_shr_u),
      wasm_pure_operation(operation: ^wasm_op_integer_rotl),
      wasm_pure_operation(operation: ^wasm_op_integer_rotr),
      wasm_pure_operation(operation: ^wasm_op_float_add),
      wasm_pure_operation(operation: ^wasm_op_float_sub),
      wasm_pure_operation(operation: ^wasm_op_float_mul),
      wasm_pure_operation(operation: ^wasm_op_float_div),
      wasm_pure_operation(operation: ^wasm_op_float_min),
      wasm_pure_operation(operation: ^wasm_op_float_max),
      wasm_pure_operation(operation: ^wasm_op_float_copysign)
    ]
  }
}

fn wasm_fail_closed_partial_operation(
  operation: Symbol,
  precondition: Symbol,
  reason: Symbol
) -> PartialOperationDecl {
  PartialOperationDecl {
    operation: wasm_inhabitant_atom(id: operation),
    precondition: wasm_inhabitant_atom(id: precondition),
    discharge: FailClosedAtBoundary { reason: reason }
  }
}

fn wasm_partiality_semantics() -> PartialitySemanticsDecl {
  PartialitySemanticsDecl {
    operations: [
      wasm_fail_closed_partial_operation(
        operation: ^wasm_op_integer_div_s,
        precondition: ^wasm_precondition_integer_divisor_nonzero,
        reason: ^wasm_partial_integer_divide_by_zero
      ),
      wasm_fail_closed_partial_operation(
        operation: ^wasm_op_integer_div_s,
        precondition: ^wasm_precondition_signed_quotient_not_min_over_negative_one,
        reason: ^wasm_partial_signed_quotient_overflow
      ),
      wasm_fail_closed_partial_operation(
        operation: ^wasm_op_integer_div_u,
        precondition: ^wasm_precondition_integer_divisor_nonzero,
        reason: ^wasm_partial_integer_divide_by_zero
      ),
      wasm_fail_closed_partial_operation(
        operation: ^wasm_op_integer_rem_s,
        precondition: ^wasm_precondition_integer_divisor_nonzero,
        reason: ^wasm_partial_integer_remainder_by_zero
      ),
      wasm_fail_closed_partial_operation(
        operation: ^wasm_op_integer_rem_u,
        precondition: ^wasm_precondition_integer_divisor_nonzero,
        reason: ^wasm_partial_integer_remainder_by_zero
      )
    ]
  }
}

fn wasm_model_core() -> ModelCore {
  ModelCore {
    primitives: wasm_primitive_fact_bundles(),
    inhabitance: wasm_model_core_inhabitance_decls(),
    laws: wasm_model_core_law_obligations(),
    effects: wasm_effect_semantics(),
    partiality: wasm_partiality_semantics()
  }
}

fn wasm_language_model() -> LanguageModel {
  LanguageModel {
    lex: wasm_lex(),
    grammar: wasm_grammar(),
    language_identity: ^wasm_language_model_surface_id,
    canonical_symbols: wasm_language_model_canonical_symbols(),
    core: wasm_model_core()
  }
}

