module v2.extdeps.languages.english


type Determiner
  = DefiniteArticle
  | IndefiniteArticle

type FormalNounPhrase {
  determiner: Determiner
  head: v2.std.node.Symbol
}

type FormalSentence
  = SvoSentence   { subject: FormalNounPhrase, verb: v2.std.node.Symbol, object: FormalNounPhrase }
  | CopulaSentence { subject: FormalNounPhrase, copula: v2.std.node.Symbol, complement: FormalNounPhrase }

type EnglishLexRules {
  rules: v2.std.compilers.lexing.LexRules
}

type EnglishGrammar {
  grammar: v2.std.grammar.ParseGrammar
}

type EnglishFidelityFeature
  = FormalSubsetSvo
  | FormalSubsetCopula
  | FormalSubsetAdverbial
  | FormalSubsetIntransitive
  | ArticleDeterminer
  | OutOfSubsetProse
  | AmbiguousConstruct
  | MalformedSentence

fn english_feature_disposition(f: EnglishFidelityFeature) -> v2.extdeps.languages.fidelity.FidelityDisposition<EnglishFidelityFeature> {
  match f {
    FormalSubsetSvo => Modeled
    FormalSubsetCopula => Modeled
    FormalSubsetAdverbial => v2.extdeps.languages.fidelity.FailClosed { feature: FormalSubsetAdverbial }
    FormalSubsetIntransitive => v2.extdeps.languages.fidelity.FailClosed { feature: FormalSubsetIntransitive }
    ArticleDeterminer => Modeled
    OutOfSubsetProse => v2.extdeps.languages.fidelity.FailClosed { feature: OutOfSubsetProse }
    AmbiguousConstruct => v2.extdeps.languages.fidelity.FailClosed { feature: AmbiguousConstruct }
    MalformedSentence => v2.extdeps.languages.fidelity.FailClosed { feature: MalformedSentence }
  }
}
fn english_lex_token(token_class: v2.std.node.Symbol, pattern: v2.std.compilers.lexing.LexPattern) -> v2.std.compilers.lexing.LexRule {
  v2.std.compilers.lexing.TokenRule { token_class: token_class, pattern: pattern }
}

fn english_word_pattern() -> v2.std.compilers.lexing.LexPattern {
  v2.std.compilers.lexing.SequencePattern {
    left: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentStartChar },
    right: v2.std.compilers.lexing.RepeatPattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.IdentContinueChar } }
  }
}

fn english_lex() -> v2.std.compilers.lexing.LexRules {
  v2.std.compilers.lexing.ModeledLexRules {
    root: v2.std.compilers.lexing.LexRuleSet {
      rules: [
        v2.std.compilers.lexing.TriviaRule { pattern: v2.std.compilers.lexing.OneOrMorePattern { element: v2.std.compilers.lexing.CharClassPattern { class: v2.std.compilers.lexing.WhitespaceChar } } },
        english_lex_token(token_class: ^english_token_word, pattern: english_word_pattern()),
        english_lex_token(token_class: ^english_token_period, pattern: v2.std.compilers.lexing.LiteralPattern { text: "." }),
        english_lex_token(token_class: ^english_token_indefinite_article, pattern: v2.std.compilers.lexing.KeywordPattern { text: "a" }),
        english_lex_token(token_class: ^english_token_indefinite_article, pattern: v2.std.compilers.lexing.KeywordPattern { text: "an" }),
        english_lex_token(token_class: ^english_token_definite_article, pattern: v2.std.compilers.lexing.KeywordPattern { text: "the" }),
        english_lex_token(token_class: ^english_token_copula, pattern: v2.std.compilers.lexing.KeywordPattern { text: "is" })
      ]
    }
  }
}

fn english_grammar_terminal(token_class: v2.std.node.Symbol) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Terminal { token_class: token_class, stamp: v2.std.grammar.StampClass }
}

fn english_grammar_sequence(left: v2.std.grammar.GrammarExpr, right: v2.std.grammar.GrammarExpr) -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Sequence { left: left, right: right }
}

fn english_article_expr() -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Choice {
    left: english_grammar_terminal(token_class: ^english_token_definite_article),
    right: english_grammar_terminal(token_class: ^english_token_indefinite_article)
  }
}

fn english_article_nonterminal() -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Nonterminal { production: ^english_production_article }
}

fn english_svo_sentence_expr() -> v2.std.grammar.GrammarExpr {
  english_grammar_sequence(
    left: english_article_nonterminal(),
    right: english_grammar_sequence(
      left: english_grammar_terminal(token_class: ^english_token_word),
      right: english_grammar_sequence(
        left: english_grammar_terminal(token_class: ^english_token_word),
        right: english_grammar_sequence(
          left: english_article_nonterminal(),
          right: english_grammar_sequence(
            left: english_grammar_terminal(token_class: ^english_token_word),
            right: english_grammar_terminal(token_class: ^english_token_period)
          )
        )
      )
    )
  )
}

fn english_copula_sentence_expr() -> v2.std.grammar.GrammarExpr {
  english_grammar_sequence(
    left: english_article_nonterminal(),
    right: english_grammar_sequence(
      left: english_grammar_terminal(token_class: ^english_token_word),
      right: english_grammar_sequence(
        left: english_grammar_terminal(token_class: ^english_token_copula),
        right: english_grammar_sequence(
          left: english_article_nonterminal(),
          right: english_grammar_sequence(
            left: english_grammar_terminal(token_class: ^english_token_word),
            right: english_grammar_terminal(token_class: ^english_token_period)
          )
        )
      )
    )
  )
}

fn english_productions() -> List<v2.std.grammar.GrammarProduction> {
  let article = v2.std.grammar.GrammarProduction {
    name: ^english_production_article,
    expression: english_article_expr(),
    emitted: v2.std.grammar.grammar_atom(identity: ^english_surface_article)
  }
  let svo = v2.std.grammar.GrammarProduction {
    name: ^english_production_svo_sentence,
    expression: english_svo_sentence_expr(),
    emitted: v2.std.grammar.grammar_atom(identity: ^english_surface_svo)
  }
  let copula = v2.std.grammar.GrammarProduction {
    name: ^english_production_copula_sentence,
    expression: english_copula_sentence_expr(),
    emitted: v2.std.grammar.grammar_atom(identity: ^english_surface_copula)
  }
  let sentence = v2.std.grammar.GrammarProduction {
    name: ^english_production_sentence,
    expression: v2.std.grammar.Choice {
      left: v2.std.grammar.Nonterminal { production: ^english_production_svo_sentence },
      right: v2.std.grammar.Nonterminal { production: ^english_production_copula_sentence }
    },
    emitted: v2.std.grammar.grammar_atom(identity: ^english_surface_sentence)
  }
  [sentence, article, svo, copula]
}

fn english_grammar() -> v2.std.grammar.ParseGrammar {
  v2.std.grammar.ModeledGrammar {
    root: v2.std.grammar.GrammarRoot {
      start: ^english_production_sentence,
      productions: english_productions(),
      sync_tokens: v2.std.grammar.grammar_empty_sync_tokens()
    }
  }
}

fn english_model_core() -> v2.std.model_core.ModelCore {
  v2.std.model_core.ModelCore {
    primitives: [],
    inhabitance: [],
    laws: [],
    effects: v2.std.model_core.EffectSemanticsDecl { operations: [] },
    partiality: v2.std.model_core.PartialitySemanticsDecl { operations: [] }
  }
}

fn english_language_model() -> v2.std.language_model.LanguageModel {
  v2.std.language_model.LanguageModel {
    canonical_symbols: v2.std.language_model.language_model_empty_canonical_symbols(),
    language_identity: ^english_language_identity,
    core: english_model_core(),
    lex: english_lex(),
    grammar: english_grammar()
  }
}

fn english_lex_rules_wrapper() -> EnglishLexRules {
  EnglishLexRules {
    rules: english_lex()
  }
}

fn english_grammar_wrapper() -> EnglishGrammar {
  EnglishGrammar {
    grammar: english_grammar()
  }
}

fn english_ingest_grammar_schema() -> v2.std.grammar.GrammarSchema {
  v2.std.grammar.GrammarSchema {
    lex: english_lex(),
    grammar: english_grammar()
  }
}

fn english_article_formal_production_definite() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.FormalProduction {
    lhs: v2.std.grammar.grammar_formal_nonterminal(identity: ^english_production_article),
    rhs: [v2.std.grammar.grammar_formal_terminal(identity: ^english_token_definite_article)]
  }
}

fn english_article_formal_production_indefinite() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.FormalProduction {
    lhs: v2.std.grammar.grammar_formal_nonterminal(identity: ^english_production_article),
    rhs: [v2.std.grammar.grammar_formal_terminal(identity: ^english_token_indefinite_article)]
  }
}

fn english_svo_formal_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.FormalProduction {
    lhs: v2.std.grammar.grammar_formal_nonterminal(identity: ^english_production_svo_sentence),
    rhs: [
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^english_production_article),
      v2.std.grammar.grammar_formal_terminal(identity: ^english_token_word),
      v2.std.grammar.grammar_formal_terminal(identity: ^english_token_word),
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^english_production_article),
      v2.std.grammar.grammar_formal_terminal(identity: ^english_token_word),
      v2.std.grammar.grammar_formal_terminal(identity: ^english_token_period)
    ]
  }
}

fn english_copula_formal_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.FormalProduction {
    lhs: v2.std.grammar.grammar_formal_nonterminal(identity: ^english_production_copula_sentence),
    rhs: [
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^english_production_article),
      v2.std.grammar.grammar_formal_terminal(identity: ^english_token_word),
      v2.std.grammar.grammar_formal_terminal(identity: ^english_token_copula),
      v2.std.grammar.grammar_formal_nonterminal_occurrence(identity: ^english_production_article),
      v2.std.grammar.grammar_formal_terminal(identity: ^english_token_word),
      v2.std.grammar.grammar_formal_terminal(identity: ^english_token_period)
    ]
  }
}

fn english_ingest_grammar_probe() -> v2.std.grammar.GrammarSchemaProbeBinding {
  v2.std.grammar.GrammarSchemaProbeBinding {
    schema: english_ingest_grammar_schema(),
    probe: v2.std.grammar.GrammarSchemaProbe {
      fixture: "the function is a handler.",
      production: english_copula_formal_production(),
      expected_parse_surface: v2.std.grammar.grammar_atom(identity: ^english_surface_copula)
    }
  }
}

data english_add_fn_source_text: String = "the add is a function. the add takes the x. the add takes the y. the add returns the sum. the sum adds the x. the sum adds the y."

fn english_named_edge(name: v2.std.node.Symbol, target: v2.std.node.Node) -> v2.std.node.Edge {
  v2.std.node.Edge { label: v2.std.node.Named { name: name }, target: target }
}

fn english_inhabitant_atom(id: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: id } },
    children: [],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn english_noun_facts_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      english_named_edge(
        name: ^english_facts_field_surface_spelling,
        target: english_inhabitant_atom(id: ^english_surface_spelling_noun)
      ),
      english_named_edge(
        name: ^english_facts_field_grammar_category,
        target: english_inhabitant_atom(id: ^english_category_formal_noun_phrase)
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn english_noun_inhabitant_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      english_named_edge(
        name: ^english_inhabitant_field_atom,
        target: english_inhabitant_atom(id: ^english_inhabitant_noun)
      ),
      english_named_edge(
        name: ^english_inhabitant_field_facts,
        target: english_noun_facts_node()
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn english_add_fn_emitted_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Arrow },
    children: [
      v2.std.node.Edge { label: v2.std.node.Positional, target: english_noun_inhabitant_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: english_noun_inhabitant_node() },
      v2.std.node.Edge { label: v2.std.node.Positional, target: english_noun_inhabitant_node() }
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

