module v2.extdeps.languages.english


type Determiner
  = DefiniteArticle
  | IndefiniteArticle

type FormalNounPhrase {
  determiner: Determiner
  head: Symbol
}

type FormalSentence
  = SvoSentence   { subject: FormalNounPhrase, verb: Symbol, object: FormalNounPhrase }
  | CopulaSentence { subject: FormalNounPhrase, copula: Symbol, complement: FormalNounPhrase }

type EnglishLexRules {
  rules: LexRules
}

type EnglishGrammar {
  grammar: ParseGrammar
}

type EnglishFidelityFeature
  = FormalSubsetSvo
  | FormalSubsetCopula
  | FormalSubsetAdverbial
  | FormalSubsetIntransitive
  | ArticleDeterminer
  | OutOfSubsetProse
  | AmbiguousConstruct
  | MalformedSentence

fn english_feature_disposition(f: EnglishFidelityFeature) -> FidelityDisposition<EnglishFidelityFeature> {
  match f {
    FormalSubsetSvo => Modeled
    FormalSubsetCopula => Modeled
    FormalSubsetAdverbial => FailClosed { feature: FormalSubsetAdverbial }
    FormalSubsetIntransitive => FailClosed { feature: FormalSubsetIntransitive }
    ArticleDeterminer => Modeled
    OutOfSubsetProse => FailClosed { feature: OutOfSubsetProse }
    AmbiguousConstruct => FailClosed { feature: AmbiguousConstruct }
    MalformedSentence => FailClosed { feature: MalformedSentence }
  }
}
fn english_lex_token(token_class: Symbol, pattern: LexPattern) -> LexRule {
  TokenRule { token_class: token_class, pattern: pattern }
}

fn english_word_pattern() -> LexPattern {
  SequencePattern {
    left: CharClassPattern { class: IdentStartChar },
    right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
  }
}

fn english_lex() -> LexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: [
        TriviaRule { pattern: OneOrMorePattern { element: CharClassPattern { class: WhitespaceChar } } },
        english_lex_token(token_class: ^english_token_word, pattern: english_word_pattern()),
        english_lex_token(token_class: ^english_token_period, pattern: LiteralPattern { text: "." }),
        english_lex_token(token_class: ^english_token_indefinite_article, pattern: KeywordPattern { text: "a" }),
        english_lex_token(token_class: ^english_token_indefinite_article, pattern: KeywordPattern { text: "an" }),
        english_lex_token(token_class: ^english_token_definite_article, pattern: KeywordPattern { text: "the" }),
        english_lex_token(token_class: ^english_token_copula, pattern: KeywordPattern { text: "is" })
      ]
    }
  }
}

fn english_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn english_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}

fn english_article_expr() -> GrammarExpr {
  Choice {
    left: english_grammar_terminal(token_class: ^english_token_definite_article),
    right: english_grammar_terminal(token_class: ^english_token_indefinite_article)
  }
}

fn english_article_nonterminal() -> GrammarExpr {
  Nonterminal { production: ^english_production_article }
}

fn english_svo_sentence_expr() -> GrammarExpr {
  english_grammar_sequence(
    left: english_article_nonterminal(),
    right: english_grammar_sequence(
      left: english_grammar_terminal(token_class: ^english_token_word),
      right: english_grammar_sequence(
        left: english_grammar_terminal(token_class: ^english_token_word),
        right: english_grammar_sequence(
          left: english_article_nonterminal(),
          right: english_grammar_sequence(
            left: english_grammar_terminal(token_class: ^english_token_word),
            right: english_grammar_terminal(token_class: ^english_token_period)
          )
        )
      )
    )
  )
}

fn english_copula_sentence_expr() -> GrammarExpr {
  english_grammar_sequence(
    left: english_article_nonterminal(),
    right: english_grammar_sequence(
      left: english_grammar_terminal(token_class: ^english_token_word),
      right: english_grammar_sequence(
        left: english_grammar_terminal(token_class: ^english_token_copula),
        right: english_grammar_sequence(
          left: english_article_nonterminal(),
          right: english_grammar_sequence(
            left: english_grammar_terminal(token_class: ^english_token_word),
            right: english_grammar_terminal(token_class: ^english_token_period)
          )
        )
      )
    )
  )
}

fn english_productions() -> List<GrammarProduction> {
  let article = GrammarProduction {
    name: ^english_production_article,
    expression: english_article_expr(),
    emitted: grammar_atom(identity: ^english_surface_article)
  }
  let svo = GrammarProduction {
    name: ^english_production_svo_sentence,
    expression: english_svo_sentence_expr(),
    emitted: grammar_atom(identity: ^english_surface_svo)
  }
  let copula = GrammarProduction {
    name: ^english_production_copula_sentence,
    expression: english_copula_sentence_expr(),
    emitted: grammar_atom(identity: ^english_surface_copula)
  }
  let sentence = GrammarProduction {
    name: ^english_production_sentence,
    expression: Choice {
      left: Nonterminal { production: ^english_production_svo_sentence },
      right: Nonterminal { production: ^english_production_copula_sentence }
    },
    emitted: grammar_atom(identity: ^english_surface_sentence)
  }
  [sentence, article, svo, copula]
}

fn english_grammar() -> ParseGrammar {
  ModeledGrammar {
    root: GrammarRoot {
      start: ^english_production_sentence,
      productions: english_productions(),
      sync_tokens: grammar_empty_sync_tokens()
    }
  }
}

fn english_model_core() -> ModelCore {
  ModelCore {
    primitives: [],
    inhabitance: [],
    laws: [],
    effects: EffectSemanticsDecl { operations: [] },
    partiality: PartialitySemanticsDecl { operations: [] }
  }
}

fn english_language_model() -> LanguageModel {
  LanguageModel {
    canonical_symbols: language_model_empty_canonical_symbols(),
    language_identity: ^english_language_identity,
    core: english_model_core(),
    lex: english_lex(),
    grammar: english_grammar()
  }
}

fn english_lex_rules_wrapper() -> EnglishLexRules {
  EnglishLexRules {
    rules: english_lex()
  }
}

fn english_grammar_wrapper() -> EnglishGrammar {
  EnglishGrammar {
    grammar: english_grammar()
  }
}

fn english_ingest_grammar_schema() -> GrammarSchema {
  GrammarSchema {
    lex: english_lex(),
    grammar: english_grammar()
  }
}

fn english_article_formal_production_definite() -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: ^english_production_article),
    rhs: [grammar_formal_terminal(identity: ^english_token_definite_article)]
  }
}

fn english_article_formal_production_indefinite() -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: ^english_production_article),
    rhs: [grammar_formal_terminal(identity: ^english_token_indefinite_article)]
  }
}

fn english_svo_formal_production() -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: ^english_production_svo_sentence),
    rhs: [
      grammar_formal_nonterminal_occurrence(identity: ^english_production_article),
      grammar_formal_terminal(identity: ^english_token_word),
      grammar_formal_terminal(identity: ^english_token_word),
      grammar_formal_nonterminal_occurrence(identity: ^english_production_article),
      grammar_formal_terminal(identity: ^english_token_word),
      grammar_formal_terminal(identity: ^english_token_period)
    ]
  }
}

fn english_copula_formal_production() -> FormalProduction {
  FormalProduction {
    lhs: grammar_formal_nonterminal(identity: ^english_production_copula_sentence),
    rhs: [
      grammar_formal_nonterminal_occurrence(identity: ^english_production_article),
      grammar_formal_terminal(identity: ^english_token_word),
      grammar_formal_terminal(identity: ^english_token_copula),
      grammar_formal_nonterminal_occurrence(identity: ^english_production_article),
      grammar_formal_terminal(identity: ^english_token_word),
      grammar_formal_terminal(identity: ^english_token_period)
    ]
  }
}

fn english_ingest_grammar_probe() -> GrammarSchemaProbeBinding {
  GrammarSchemaProbeBinding {
    schema: english_ingest_grammar_schema(),
    probe: GrammarSchemaProbe {
      fixture: "the function is a handler.",
      production: english_copula_formal_production(),
      expected_parse_surface: grammar_atom(identity: ^english_surface_copula)
    }
  }
}

data english_add_fn_source_text: String = "the add is a function. the add takes the x. the add takes the y. the add returns the sum. the sum adds the x. the sum adds the y."

fn english_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Named { name: name }, target: target }
}

fn english_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: SyntheticOccurrence
}
}

fn english_noun_facts_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      english_named_edge(
        name: ^english_facts_field_surface_spelling,
        target: english_inhabitant_atom(id: ^english_surface_spelling_noun)
      ),
      english_named_edge(
        name: ^english_facts_field_grammar_category,
        target: english_inhabitant_atom(id: ^english_category_formal_noun_phrase)
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn english_noun_inhabitant_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      english_named_edge(
        name: ^english_inhabitant_field_atom,
        target: english_inhabitant_atom(id: ^english_inhabitant_noun)
      ),
      english_named_edge(
        name: ^english_inhabitant_field_facts,
        target: english_noun_facts_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn english_add_fn_emitted_node() -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: english_noun_inhabitant_node() },
      Edge { label: Positional, target: english_noun_inhabitant_node() },
      Edge { label: Positional, target: english_noun_inhabitant_node() }
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn english_add_fn_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [

    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_fn_add },
    BoundToken { token_class: ^english_token_copula, binding: ^english_binding_copula_is },
    BoundToken { token_class: ^english_token_indefinite_article, binding: ^english_binding_article_a },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_noun_function },
    BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_fn_add },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_takes },
    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_param_x },
    BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_fn_add },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_takes },
    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_param_y },
    BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_fn_add },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_returns },
    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_noun_sum },
    BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_noun_sum_subject },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_adds },
    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_param_x },
    BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_noun_sum_subject },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_adds },
    BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    BoundToken { token_class: ^english_token_word, binding: ^english_binding_param_y },
    FixedToken { token_class: ^english_token_period }
  ]
}

fn english_add_fn_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(
        map_insert(
          map_insert(
            map_insert(
              map_insert(
                map_insert(
                  map_insert(
                    map_insert(
                      map_insert(
                        map_insert(
                          map_insert(empty_map(), ^english_binding_article_the, "the "),
                          ^english_binding_article_a,
                          "a "
                        ),
                        ^english_binding_copula_is,
                        "is "
                      ),
                      ^english_binding_fn_add,
                      "add "
                    ),
                    ^english_binding_noun_function,
                    "function"
                  ),
                  ^english_binding_verb_takes,
                  "takes "
                ),
                ^english_binding_param_x,
                "x"
              ),
              ^english_binding_param_y,
              "y"
            ),
            ^english_binding_verb_returns,
            "returns "
          ),
          ^english_binding_noun_sum,
          "sum"
        ),
        ^english_binding_noun_sum_subject,
        "sum "
      ),
      ^english_binding_verb_adds,
      "adds "
    ),
    ^english_binding_sentence_separator,
    ". "
  )
}

fn english_concrete_token_node(token: ConcreteSyntaxToken) -> Node {

  concrete_syntax_token_to_node(token: token)
}

fn english_add_fn_formal_rhs() -> List<FormalGrammarSymbol> {
  fold_list(
    xs: english_add_fn_concrete_tokens(),
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn english_add_fn_formal_production() -> FormalProduction {
  grammar_formal_production(
    lhs: ^english_production_add_fn_paragraph,
    rhs: english_add_fn_formal_rhs()
  )
}

type EnglishGrammarRelationRow {
  production: FormalProduction
  emitted: Node
  tokens: List<ConcreteSyntaxToken>
}

fn english_add_fn_relation_row() -> EnglishGrammarRelationRow {
  EnglishGrammarRelationRow {
    production: english_add_fn_formal_production(),
    emitted: english_add_fn_emitted_node(),
    tokens: english_add_fn_concrete_tokens()
  }
}

fn english_grammar_relation_row_node(row: EnglishGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      english_named_edge(
        name: ^grammar_relation_field_production,
        target: formal_production_to_node(production: row.production)
      ),
      english_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      english_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: english_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn english_add_fn_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      english_named_edge(
        name: ^english_relation_rule_add_fn,
        target: english_grammar_relation_row_node(row: english_add_fn_relation_row())
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn english_add_fn_serialize_source_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      english_named_edge(
        name: ^serialize_source_field_source_text,
        target: english_inhabitant_atom(id: ^english_add_fn_source_literal)
      ),
      english_named_edge(
        name: ^serialize_source_field_source_grammar,
        target: english_inhabitant_atom(id: ^english_production_add_fn_paragraph)
      ),
      english_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: english_add_fn_concrete_tokens(),
          token_to_node: english_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn english_add_fn_zip_fold_closure_edges() -> List<Edge> {
  [
    english_named_edge(
      name: ^english_inhabitant_field_add_fn,
      target: english_add_fn_emitted_node()
    ),
    english_named_edge(
      name: ^english_coercion_field_noun_inhabitant_atom,
      target: english_inhabitant_atom(id: ^english_inhabitant_noun)
    ),
    english_named_edge(
      name: ^english_coercion_field_noun_facts,
      target: english_noun_facts_node()
    ),
    english_named_edge(
      name: ^english_coercion_field_noun_spelling,
      target: english_inhabitant_atom(id: ^english_surface_spelling_noun)
    ),
    english_named_edge(
      name: ^english_coercion_field_noun_category,
      target: english_inhabitant_atom(id: ^english_category_formal_noun_phrase)
    )
  ]
}

fn english_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_append(
      left: [
        english_named_edge(
          name: ^english_inhabitant_field_noun,
          target: english_noun_inhabitant_node()
        )
      ],
      right: english_add_fn_zip_fold_closure_edges()
    ),
    occurrence_id: SyntheticOccurrence
}
}

fn english_selection_policy_node() -> Node {
  english_noun_inhabitant_node()
}

fn english_add_fn_target_model_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      english_named_edge(name: ^target_model_edge_selection_policy, target: english_selection_policy_node()),
      english_named_edge(name: ^target_model_edge_declared_inhabitants, target: english_declared_inhabitants_root()),
      english_named_edge(name: ^target_model_edge_translation_rules, target: english_add_fn_translation_rules_node()),
      english_named_edge(name: ^target_model_edge_serialize_source, target: english_add_fn_serialize_source_node())
    ],
    occurrence_id: SyntheticOccurrence
}
}

fn english_add_fn_target_model() -> TargetModel {
  TargetModel {
    bundle: english_add_fn_target_model_node(),
    lex: english_lex(),
    binding_spellings: english_add_fn_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: english_add_fn_source_text,
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn english_sentence_nonterminal() -> GrammarExpr {
  Nonterminal { production: ^english_production_sentence }
}

fn english_add_fn_paragraph_expr() -> GrammarExpr {
  Sequence {
    left: english_sentence_nonterminal(),
    right: Sequence {
      left: english_sentence_nonterminal(),
      right: Sequence {
        left: english_sentence_nonterminal(),
        right: Sequence {
          left: english_sentence_nonterminal(),
          right: Sequence {
            left: english_sentence_nonterminal(),
            right: english_sentence_nonterminal()
          }
        }
      }
    }
  }
}

fn english_add_fn_paragraph_production() -> GrammarProduction {
  GrammarProduction {
    name: ^english_production_add_fn_paragraph,
    expression: english_add_fn_paragraph_expr(),
    emitted: english_add_fn_emitted_node()
  }
}

fn english_add_fn_paragraph_grammar() -> ParseGrammar {
  ModeledGrammar {
    root: GrammarRoot {
      start: ^english_production_add_fn_paragraph,
      productions: list_append(
        left: [english_add_fn_paragraph_production()],
        right: english_productions()
      ),
      sync_tokens: grammar_empty_sync_tokens()
    }
  }
}
