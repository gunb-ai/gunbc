  [

    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_fn_add },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_copula, binding: ^english_binding_copula_is },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_indefinite_article, binding: ^english_binding_article_a },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_noun_function },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_fn_add },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_takes },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_param_x },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_fn_add },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_takes },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_param_y },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_fn_add },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_returns },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_noun_sum },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_noun_sum_subject },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_adds },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_param_x },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_period, binding: ^english_binding_sentence_separator },

    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_noun_sum_subject },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_verb_adds },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_definite_article, binding: ^english_binding_article_the },
    v2.std.compilers.target_model.BoundToken { token_class: ^english_token_word, binding: ^english_binding_param_y },
    v2.std.compilers.target_model.FixedToken { token_class: ^english_token_period }
  ]
}

fn english_add_fn_binding_spellings() -> Map<v2.std.node.Symbol, String> {
  v2.std.collection.map_insert(
    v2.std.collection.map_insert(
      v2.std.collection.map_insert(
        v2.std.collection.map_insert(
          v2.std.collection.map_insert(
            v2.std.collection.map_insert(
              v2.std.collection.map_insert(
                v2.std.collection.map_insert(
                  v2.std.collection.map_insert(
                    v2.std.collection.map_insert(
                      v2.std.collection.map_insert(
                        v2.std.collection.map_insert(
                          v2.std.collection.map_insert(v2.std.collection.empty_map(), ^english_binding_article_the, "the "),
                          ^english_binding_article_a,
                          "a "
                        ),
                        ^english_binding_copula_is,
                        "is "
                      ),
                      ^english_binding_fn_add,
                      "add "
                    ),
                    ^english_binding_noun_function,
                    "function"
                  ),
                  ^english_binding_verb_takes,
                  "takes "
                ),
                ^english_binding_param_x,
                "x"
              ),
              ^english_binding_param_y,
              "y"
            ),
            ^english_binding_verb_returns,
            "returns "
          ),
          ^english_binding_noun_sum,
          "sum"
        ),
        ^english_binding_noun_sum_subject,
        "sum "
      ),
      ^english_binding_verb_adds,
      "adds "
    ),
    ^english_binding_sentence_separator,
    ". "
  )
}

fn english_concrete_token_node(token: v2.std.compilers.target_model.ConcreteSyntaxToken) -> v2.std.node.Node {

  v2.std.compilers.target_model.concrete_syntax_token_to_node(token: token)
}

fn english_add_fn_formal_rhs() -> List<v2.std.grammar.FormalGrammarSymbol> {
  v2.std.algebra.fold_list(
    xs: english_add_fn_concrete_tokens(),
    empty: std.algebra.Empty,
    cons: fn(acc, token) {
      v2.std.algebra.list_snoc_item(
        xs: acc,
        item: v2.std.grammar.grammar_formal_terminal(identity: v2.std.compilers.target_model.concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn english_add_fn_formal_production() -> v2.std.grammar.FormalProduction {
  v2.std.grammar.grammar_formal_production(
    lhs: ^english_production_add_fn_paragraph,
    rhs: english_add_fn_formal_rhs()
  )
}

type EnglishGrammarRelationRow {
  production: v2.std.grammar.FormalProduction
  emitted: v2.std.node.Node
  tokens: List<v2.std.compilers.target_model.ConcreteSyntaxToken>
}

fn english_add_fn_relation_row() -> EnglishGrammarRelationRow {
  EnglishGrammarRelationRow {
    production: english_add_fn_formal_production(),
    emitted: english_add_fn_emitted_node(),
    tokens: english_add_fn_concrete_tokens()
  }
}

fn english_grammar_relation_row_node(row: EnglishGrammarRelationRow) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      english_named_edge(
        name: ^grammar_relation_field_production,
        target: v2.std.grammar.formal_production_to_node(production: row.production)
      ),
      english_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      english_named_edge(
        name: ^grammar_relation_field_tokens,
        target: v2.std.grammar.grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: english_concrete_token_node
        )
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn english_add_fn_translation_rules_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      english_named_edge(
        name: ^english_relation_rule_add_fn,
        target: english_grammar_relation_row_node(row: english_add_fn_relation_row())
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn english_add_fn_serialize_source_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      english_named_edge(
        name: ^serialize_source_field_source_text,
        target: english_inhabitant_atom(id: ^english_add_fn_source_literal)
      ),
      english_named_edge(
        name: ^serialize_source_field_source_grammar,
        target: english_inhabitant_atom(id: ^english_production_add_fn_paragraph)
      ),
      english_named_edge(
        name: ^grammar_relation_field_tokens,
        target: v2.std.grammar.grammar_relation_tokens_node(
          tokens: english_add_fn_concrete_tokens(),
          token_to_node: english_concrete_token_node
        )
      )
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn english_add_fn_zip_fold_closure_edges() -> List<v2.std.node.Edge> {
  [
    english_named_edge(
      name: ^english_inhabitant_field_add_fn,
      target: english_add_fn_emitted_node()
    ),
    english_named_edge(
      name: ^english_coercion_field_noun_inhabitant_atom,
      target: english_inhabitant_atom(id: ^english_inhabitant_noun)
    ),
    english_named_edge(
      name: ^english_coercion_field_noun_facts,
      target: english_noun_facts_node()
    ),
    english_named_edge(
      name: ^english_coercion_field_noun_spelling,
      target: english_inhabitant_atom(id: ^english_surface_spelling_noun)
    ),
    english_named_edge(
      name: ^english_coercion_field_noun_category,
      target: english_inhabitant_atom(id: ^english_category_formal_noun_phrase)
    )
  ]
}

fn english_declared_inhabitants_root() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: v2.std.algebra.list_append(
      left: [
        english_named_edge(
          name: ^english_inhabitant_field_noun,
          target: english_noun_inhabitant_node()
        )
      ],
      right: english_add_fn_zip_fold_closure_edges()
    ),
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn english_selection_policy_node() -> v2.std.node.Node {
  english_noun_inhabitant_node()
}

fn english_add_fn_target_model_node() -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Conj },
    children: [
      english_named_edge(name: ^target_model_edge_selection_policy, target: english_selection_policy_node()),
      english_named_edge(name: ^target_model_edge_declared_inhabitants, target: english_declared_inhabitants_root()),
      english_named_edge(name: ^target_model_edge_translation_rules, target: english_add_fn_translation_rules_node()),
      english_named_edge(name: ^target_model_edge_serialize_source, target: english_add_fn_serialize_source_node())
    ],
    occurrence_id: v2.std.node.SyntheticOccurrence
}
}

fn english_add_fn_target_model() -> v2.std.compilers.target_model.TargetModel {
  v2.std.compilers.target_model.TargetModel {
    produced_decl_support: v2.std.compilers.target_model.ProducedDeclUnwired,
    bundle: english_add_fn_target_model_node(),
    lex: english_lex(),
    binding_spellings: english_add_fn_binding_spellings(),
    token_class_emit_transforms: v2.std.compilers.target_model.target_model_emit_transforms_empty,
    authority_source_text: english_add_fn_source_text,
    runtime_row: v2.std.host_transport.target_emit_host_runtime_row_unconfigured
  }
}

fn english_sentence_nonterminal() -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Nonterminal { production: ^english_production_sentence }
}

fn english_add_fn_paragraph_expr() -> v2.std.grammar.GrammarExpr {
  v2.std.grammar.Sequence {
    left: english_sentence_nonterminal(),
    right: v2.std.grammar.Sequence {
      left: english_sentence_nonterminal(),
      right: v2.std.grammar.Sequence {
        left: english_sentence_nonterminal(),
        right: v2.std.grammar.Sequence {
          left: english_sentence_nonterminal(),
          right: v2.std.grammar.Sequence {
            left: english_sentence_nonterminal(),
            right: english_sentence_nonterminal()
          }
        }
      }
    }
  }
}

fn english_add_fn_paragraph_production() -> v2.std.grammar.GrammarProduction {
  v2.std.grammar.GrammarProduction {
    name: ^english_production_add_fn_paragraph,
    expression: english_add_fn_paragraph_expr(),
    emitted: english_add_fn_emitted_node()
  }
}

fn english_add_fn_paragraph_grammar() -> v2.std.grammar.ParseGrammar {
  v2.std.grammar.ModeledGrammar {
    root: v2.std.grammar.GrammarRoot {
      start: ^english_production_add_fn_paragraph,
      productions: v2.std.algebra.list_append(
        left: [english_add_fn_paragraph_production()],
        right: english_productions()
      ),
      sync_tokens: v2.std.grammar.grammar_empty_sync_tokens()
    }
  }
}
