    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_fn_one },
    FixedToken { token_class: ^rust_token_lparen },
    FixedToken { token_class: ^rust_token_rparen },
    FixedToken { token_class: ^rust_token_arrow },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_type_int },
    FixedToken { token_class: ^rust_token_lbrace }
  ]
}

fn rust_bind_literal_block_close() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_rbrace }
  ]
}

fn rust_bind_literal_bodied_scaffold() -> TargetBodiedArrowStatementScaffold {
  derive_bodied_arrow_scaffold(
    signature_with_open: rust_bind_literal_signature_with_open(),
    block_close: rust_bind_literal_block_close(),
    mode: ValueProducing
  )
}

fn rust_bind_literal_golden_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_kw_fn },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_fn_one },
    FixedToken { token_class: ^rust_token_lparen },
    FixedToken { token_class: ^rust_token_rparen },
    FixedToken { token_class: ^rust_token_arrow },
