data rust_fold_call_emit_host_suffix: String = "\n\nfn fold_call_callee(xs: i32, z: i32, f: impl Fn(i32, i32) -> i32) -> i32 { f(xs, z) }\n\nfn main() { let value = fold_demo(3, 4); let bytes = [0u8, (value & 0xff) as u8, ((value >> 8) & 0xff) as u8, ((value >> 16) & 0xff) as u8, ((value >> 24) & 0xff) as u8]; let _ = std::io::Write::write_all(&mut std::io::stdout(), &bytes); }\n"

fn rust_fold_call_host_transport_descriptor() -> HostTransportDescriptor {
  HostTransportDescriptor {
    identity: ^rust_host_transport_fold_call_identity,
    workspace: [
      WorkspaceFile {
        path: "Cargo.toml",
        content: FixedText { text: rust_emit_host_cargo_manifest }
      },
      WorkspaceFile {
        path: "rust-toolchain.toml",
        content: FixedText { text: rust_emit_host_toolchain_pin }
      },
      WorkspaceFile {
        path: "src/main.rs",
        content: EmittedWithSuffix { suffix: rust_fold_call_emit_host_suffix }
      }
    ],
    build: [
      ProcessInvocation {
        program: HostToolProgram { executable: "cargo" },
        args: [LiteralArg { text: "build" }, LiteralArg { text: "--quiet" }]
      }
    ],
    run: ProcessInvocation {
      program: HostToolProgram { executable: "cargo" },
      args: [LiteralArg { text: "run" }, LiteralArg { text: "--quiet" }]
    },
    runtime_value_codec: FixedWidthBytes { width: 5 }
  }
}

fn rust_fold_call_runtime_row() -> TargetEmitHostRuntimeRow {
  HostRuntimeRowPresent {
    row: EmitHostRuntimeRow {
      transport: rust_fold_call_host_transport_descriptor(),
      runtime_primitive_type: rust_emit_host_runtime_primitive_type_node()
    }
  }
}

