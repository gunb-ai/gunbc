  let _authority = rust_fold_call_source_text
  Node {
    kind: TypeNode { connective: Conj },
    children: list_append(
      left: rust_fold_call_serialize_source_prefix_edges(),
      right: [
        rust_named_edge(
          name: ^grammar_relation_field_tokens,
          target: grammar_relation_tokens_node(
            tokens: rust_fold_call_concrete_tokens(),
            token_to_node: rust_concrete_token_node
          )
        )
      ]
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_fold_call_binding_spellings() -> Map<Symbol, String> {
