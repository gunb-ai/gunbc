    FixedToken { token_class: ^rust_token_kw_let },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_bind_x },
    FixedToken { token_class: ^rust_token_equal },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_pick_lit_one },
    FixedToken { token_class: ^rust_token_semicolon },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_bind_x },
