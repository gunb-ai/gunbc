data rust_rec_source_text: String = "fn mk() -> Rec { Rec { v: 9 } }"

data rust_rec_wrong_value_source_text: String = "fn mk() -> Rec { Rec { v: 8 } }"

fn rust_rec_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_kw_fn },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_fn_mk },
    FixedToken { token_class: ^rust_token_lparen },
    FixedToken { token_class: ^rust_token_rparen },
    FixedToken { token_class: ^rust_token_arrow },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_type_rec },
    FixedToken { token_class: ^rust_token_lbrace },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_type_rec },
    FixedToken { token_class: ^rust_token_lbrace },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_rec_v },
    FixedToken { token_class: ^rust_token_colon },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_rec_lit_nine },
    FixedToken { token_class: ^rust_token_rbrace },
    FixedToken { token_class: ^rust_token_rbrace }
  ]
}

fn rust_rec_signature_with_open() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_kw_fn },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_fn_mk },
    FixedToken { token_class: ^rust_token_lparen },
    FixedToken { token_class: ^rust_token_rparen },
    FixedToken { token_class: ^rust_token_arrow },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_type_rec },
    FixedToken { token_class: ^rust_token_lbrace }
  ]
}

fn rust_rec_block_close() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_rbrace }
  ]
}

fn rust_rec_bodied_arrow_statement_scaffold() -> TargetBodiedArrowStatementScaffold {
  derive_bodied_arrow_scaffold(
    signature_with_open: rust_rec_signature_with_open(),
    block_close: rust_rec_block_close(),
    mode: ValueProducing
  )
}

fn rust_rec_grammar_sequence() -> GrammarExpr {
  match fold_list(
    xs: rust_rec_concrete_tokens(),
    empty: RustGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        RustGramBuild1StateInit =>
          RustGramBuild1StateReady {
            expr: rust_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
          }
        RustGramBuild1StateReady { expr: acc } =>
          RustGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: rust_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    RustGramBuild1StateInit =>
      rust_grammar_terminal(token_class: ^rust_token_kw_fn)
    RustGramBuild1StateReady { expr: result } => result
  }
}

fn rust_formal_production_fn_rec() -> FormalProduction {
