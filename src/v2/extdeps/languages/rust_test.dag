data rust_loop_emit_host_main_suffix: String = "\n\nfn main() { let value = one(); let bytes = [0u8, (value & 0xff) as u8, ((value >> 8) & 0xff) as u8, ((value >> 16) & 0xff) as u8, ((value >> 24) & 0xff) as u8]; let _ = std::io::Write::write_all(&mut std::io::stdout(), &bytes); }\n"

fn rust_loop_host_transport_descriptor() -> HostTransportDescriptor {
  HostTransportDescriptor {
    identity: ^rust_host_transport_loop_identity,
    workspace: [
      WorkspaceFile {
        path: "Cargo.toml",
        content: FixedText { text: rust_emit_host_cargo_manifest }
      },
      WorkspaceFile {
        path: "rust-toolchain.toml",
        content: FixedText { text: rust_emit_host_toolchain_pin }
      },
      WorkspaceFile {
        path: "src/main.rs",
        content: EmittedWithSuffix { suffix: rust_loop_emit_host_main_suffix }
      }
    ],
    build: [
      ProcessInvocation {
        program: HostToolProgram { executable: "cargo" },
        args: [LiteralArg { text: "build" }, LiteralArg { text: "--quiet" }]
      }
    ],
    run: ProcessInvocation {
      program: HostToolProgram { executable: "cargo" },
      args: [LiteralArg { text: "run" }, LiteralArg { text: "--quiet" }]
    },
    runtime_value_codec: FixedWidthBytes { width: 5 }
  }
}

fn rust_loop_runtime_row() -> TargetEmitHostRuntimeRow {
  HostRuntimeRowPresent {
    row: EmitHostRuntimeRow {
      transport: rust_loop_host_transport_descriptor(),
      runtime_primitive_type: rust_emit_host_runtime_primitive_type_node()
    }
  }
}

fn rust_loop_target_model_staging() -> TargetModel {
  TargetModel {
    bundle: rust_loop_target_model_bundle_core(),
    lex: rust_loop_lex(),
    binding_spellings: rust_loop_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: rust_loop_source_text,
    runtime_row: rust_loop_runtime_row()
  }
}

