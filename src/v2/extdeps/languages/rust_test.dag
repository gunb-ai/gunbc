fn rust_bool_fn_block_close() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_rbrace }
  ]
}

fn rust_bool_fn_concrete_tokens(
  signature_with_open: List<ConcreteSyntaxToken>,
  body_tokens: List<ConcreteSyntaxToken>
) -> List<ConcreteSyntaxToken> {
  list_append(
    left: list_append(left: signature_with_open, right: body_tokens),
    right: rust_bool_fn_block_close()
  )
}

fn rust_bool_fn_grammar_sequence(tokens: List<ConcreteSyntaxToken>) -> GrammarExpr {
  match fold_list(
    xs: tokens,
    empty: RustGramBuild1StateInit,
    cons: fn(state, token) {
      match state {
        RustGramBuild1StateInit =>
          RustGramBuild1StateReady {
            expr: rust_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
          }
        RustGramBuild1StateReady { expr: acc } =>
          RustGramBuild1StateReady {
            expr: Sequence {
              left: acc,
              right: rust_grammar_terminal(token_class: concrete_syntax_token_class(token: token))
            }
          }
      }
    }
  ) {
    RustGramBuild1StateInit =>
      rust_grammar_terminal(token_class: ^rust_token_kw_fn)
    RustGramBuild1StateReady { expr: result } => result
  }
}

fn rust_bool_fn_bodied_relation_row_node(
  production_sym: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  signature_with_open: List<ConcreteSyntaxToken>
) -> Node {
  grammar_relation_row_attach_bodied_scaffold(
    row: rust_grammar_relation_row_node(
      row: RustGrammarRelationRow {
        production: GrammarProduction {
          name: production_sym,
          expression: rust_bool_fn_grammar_sequence(tokens: tokens),
          emitted: rust_grammar_atom(id: ^rust_surface_fn_item)
        },
        emitted: rust_grammar_atom(id: ^rust_surface_fn_item),
        tokens: tokens
      }
    ),
    scaffold: derive_bodied_arrow_scaffold(
      signature_with_open: signature_with_open,
      block_close: rust_bool_fn_block_close(),
      mode: ValueProducing
    )
  )
}

fn rust_bool_fn_translation_rules_node(
  relation_sym: Symbol,
  production_sym: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  signature_with_open: List<ConcreteSyntaxToken>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: relation_sym,
        target: rust_bool_fn_bodied_relation_row_node(
          production_sym: production_sym,
          tokens: tokens,
          signature_with_open: signature_with_open
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_bool_fn_serialize_source_node(
  source_literal_sym: Symbol,
  production_sym: Symbol,
  tokens: List<ConcreteSyntaxToken>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^serialize_source_field_source_text,
        target: rust_inhabitant_atom(id: source_literal_sym)
      ),
      rust_named_edge(
        name: ^serialize_source_field_source_grammar,
        target: rust_inhabitant_atom(id: production_sym)
      ),
      rust_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: tokens,
          token_to_node: rust_concrete_token_node
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_bool_fn_additional_lex_rules() -> List<LexRule> {
  [
    rust_lex_rule(token_class: ^rust_token_unwired_match, text: "match "),
    rust_lex_rule(token_class: ^rust_token_unwired_fat_arrow, text: " => "),
    rust_lex_rule(token_class: ^rust_token_ty_bool, text: "Bool"),
    rust_lex_rule(token_class: ^dag_binding_param_a, text: "a"),
    rust_lex_rule(token_class: ^dag_binding_param_b, text: "b"),
    rust_lex_rule(token_class: ^dag_complement_lit_true, text: "True"),
    rust_lex_rule(token_class: ^dag_complement_lit_false, text: "False")
  ]
}

fn rust_bool_fn_lex() -> LexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: list_append(
        left: rust_fn_add_lex_rules().rules,
        right: rust_bool_fn_additional_lex_rules()
      )
    }
  }
}

