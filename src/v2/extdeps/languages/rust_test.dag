data rust_loop_source_text: String = "fn one() -> i32 { loop { break 1; } }"

data rust_loop_wrong_value_source_text: String = "fn one() -> i32 { loop { break 2; } }"

fn rust_loop_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_kw_fn },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_fn_one },
    FixedToken { token_class: ^rust_token_lparen },
    FixedToken { token_class: ^rust_token_rparen },
    FixedToken { token_class: ^rust_token_arrow },
    FixedToken { token_class: ^rust_token_ty_i32 },
    FixedToken { token_class: ^rust_token_lbrace },
    FixedToken { token_class: ^rust_token_unwired_loop },
