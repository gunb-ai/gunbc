fn rust_literal_emit_binding_spellings() -> Map<Symbol, String> {
  let m0 = rust_binding_spellings()
  let m1 = map_insert(m0, ^dag_binding_fn_one, "one")
  let m2 = map_insert(m1, ^dag_binding_type_int, "i32")
  let m3 = map_insert(m2, ^dag_binding_bind_x, "x")
  let m4 = map_insert(m3, ^dag_binding_pick_lit_one, "1")
  map_insert(m4, ^dag_binding_pick_lit_two, "2")
}

fn rust_literal_emit_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: list_append(
      left: list_append(
        left: rust_fn_add_lex_rules().rules,
        right: [
          rust_int_literal_lex_rule(),
          rust_lex_rule(token_class: ^rust_token_kw_let, text: "let "),
          rust_lex_rule(token_class: ^rust_token_equal, text: " = "),
          rust_lex_rule(token_class: ^rust_token_semicolon, text: "; ")
        ]
      ),
      right: [
        rust_lex_rule(token_class: ^rust_token_lit_true, text: "true"),
        rust_lex_rule(token_class: ^rust_token_lit_false, text: "false"),
        rust_lex_rule(token_class: ^rust_token_ty_bool, text: "bool"),
        rust_lex_rule(token_class: ^rust_lit_char_a, text: "'a'"),
        rust_lex_rule(token_class: ^rust_lit_char_b, text: "'b'")
      ]
    )
  }
}

fn rust_literal_emit_lex() -> LexRules {
  ModeledLexRules { root: rust_literal_emit_lex_rules() }
}

data rust_bind_int_literal_source_text: String = "fn one() -> i32 { let x = 1; x }"

data rust_bind_int_literal_wrong_source_text: String = "fn one() -> i32 { let x = 2; x }"

data rust_bind_bool_literal_source_text: String = "fn one() -> i32 { let x = true; x }"

data rust_bind_bool_literal_wrong_source_text: String = "fn one() -> i32 { let x = false; x }"

data rust_bind_char_literal_source_text: String = "fn one() -> i32 { let x = 'a'; x }"

data rust_bind_char_literal_wrong_source_text: String = "fn one() -> i32 { let x = 'b'; x }"

data rust_literal_emit_string_refusal_note: String = "rope-string ValueStringLiteral emit unsupported in target_value_expression_to_concrete_tokens until engine lands literal-kind synthesis"

fn rust_type_atom_node(identity: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: identity } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_nullary_arrow_domain_conj_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_bind_let_body_node(
  key_binding: Symbol,
  value_lit: Symbol,
  body_binding: Symbol
) -> Node {
  Node {
    kind: ComputationNode { behavior: Bind },
    children: [
      Edge { label: Positional, target: rust_type_atom_node(identity: key_binding) },
      Edge { label: Positional, target: rust_type_atom_node(identity: value_lit) },
      Edge { label: Positional, target: rust_type_atom_node(identity: body_binding) }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_arrow_with_body_node(
  return_type_binding: Symbol,
  body: Node
) -> Node {
  Node {
    kind: TypeNode { connective: Arrow },
    children: [
      Edge { label: Positional, target: rust_nullary_arrow_domain_conj_node() },
      Edge {
        label: Positional,
        target: rust_type_atom_node(identity: return_type_binding)
      },
      Edge {
        label: Positional,
        target: rust_type_atom_node(identity: return_type_binding)
      },
      Edge { label: Named { name: ^arrow_body_edge }, target: body }
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_bind_bool_literal_arrow_node() -> Node {
  rust_arrow_with_body_node(
    return_type_binding: ^dag_binding_type_int,
    body: rust_bind_let_body_node(
      key_binding: ^dag_binding_bind_x,
      value_lit: ^rust_token_lit_true,
      body_binding: ^dag_binding_bind_x
    )
  )
}

fn rust_bind_bool_literal_wrong_arrow_node() -> Node {
  rust_arrow_with_body_node(
    return_type_binding: ^dag_binding_type_int,
    body: rust_bind_let_body_node(
      key_binding: ^dag_binding_bind_x,
      value_lit: ^rust_token_lit_false,
      body_binding: ^dag_binding_bind_x
    )
  )
}

fn rust_bind_char_literal_arrow_node() -> Node {
  rust_arrow_with_body_node(
    return_type_binding: ^dag_binding_type_int,
    body: rust_bind_let_body_node(
      key_binding: ^dag_binding_bind_x,
      value_lit: ^rust_lit_char_a,
      body_binding: ^dag_binding_bind_x
    )
  )
}

fn rust_bind_char_literal_wrong_arrow_node() -> Node {
  rust_arrow_with_body_node(
    return_type_binding: ^dag_binding_type_int,
    body: rust_bind_let_body_node(
      key_binding: ^dag_binding_bind_x,
      value_lit: ^rust_lit_char_b,
      body_binding: ^dag_binding_bind_x
    )
  )
}

fn rust_bind_literal_signature_with_open() -> List<ConcreteSyntaxToken> {
