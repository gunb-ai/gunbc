fn rust_classical_not_target_model_bundle_core() -> Node {
  let core = rust_target_model_core_edges_with_operators(
    operator_catalog: rust_operator_realizations_catalog_node()
  )
  Node {
    kind: TypeNode { connective: Conj },
    children: fold(
      core,
      init: Empty,
      f: fn(acc, edge) {
        match edge.label {
          Named { name: n } =>
            if n == ^target_model_edge_translation_rules {
              list_snoc_item(
                xs: acc,
                item: rust_named_edge(
                  name: ^target_model_edge_translation_rules,
                  target: rust_classical_not_translation_rules_node()
                )
              )
            } else {
              list_snoc_item(xs: acc, item: edge)
            }
          Positional => list_snoc_item(xs: acc, item: edge)
        }
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_classical_not_ingested_binding_spellings() -> Map<Symbol, String> {
  let m0 = rust_binding_spellings()
  let m1 = map_insert(m0, ^dag_binding_fn_classical_not, "classical_not")
  let m2 = map_insert(m1, ^dag_binding_octet_one, "1")
  map_insert(m2, ^dag_binding_octet_zero, "0")
