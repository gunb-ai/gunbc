fn rust_bind_literal_grammar_relation_row() -> RustGrammarRelationRow {
  RustGrammarRelationRow {
    production: rust_grammar_production_fn_bind_literal(),
    emitted: dag_bind_arrow_with_body_fixture,
    tokens: rust_bind_literal_golden_tokens()
  }
}

fn rust_bind_literal_bodied_relation_row_node() -> Node {
  grammar_relation_row_attach_bodied_scaffold(
    row: rust_grammar_relation_row_node(row: rust_bind_literal_grammar_relation_row()),
    scaffold: rust_bind_literal_bodied_scaffold()
  )
}

fn rust_bind_literal_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^rust_relation_rule_fn_bind_literal,
        target: rust_bind_literal_bodied_relation_row_node()
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_bind_literal_target_model_bundle() -> Node {
  let core = rust_target_model_core_edges_with_operators(
    operator_catalog: rust_operator_realizations_catalog_node()
  )
  Node {
    kind: TypeNode { connective: Conj },
    children: fold(
      core,
      init: Empty,
      f: fn(acc, edge) {
        match edge.label {
          Named { name: n } =>
            if n == ^target_model_edge_translation_rules {
              list_snoc_item(
                xs: acc,
                item: rust_named_edge(
                  name: ^target_model_edge_translation_rules,
                  target: rust_bind_literal_translation_rules_node()
                )
              )
            } else {
              list_snoc_item(xs: acc, item: edge)
            }
          Positional => list_snoc_item(xs: acc, item: edge)
        }
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_bind_literal_target_model() -> TargetModel {
  TargetModel {
    bundle: rust_bind_literal_target_model_bundle(),
    lex: rust_literal_emit_lex(),
    binding_spellings: rust_literal_emit_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: rust_bind_int_literal_source_text,
    runtime_row: rust_runtime_row()
  }
}

fn rust_conj_emitted_from_tokens(tokens: List<ConcreteSyntaxToken>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: fold_list(
      xs: tokens,
      empty: Empty,
      cons: fn(acc, token) {
        match token {
          BoundToken { binding: binding, token_class: _ } =>
            list_snoc_item(
              xs: acc,
              item: Edge { label: Positional, target: rust_inhabitant_atom(id: binding) }
            )
          FixedToken { token_class: _ } => acc
        }
      }
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_formal_symbol_from_token(token: ConcreteSyntaxToken) -> FormalGrammarSymbol {
  match token {
    FixedToken { token_class: c } => grammar_formal_terminal(identity: c)
    BoundToken { token_class: c, binding: b } =>
      grammar_formal_terminal_bound(identity: c, binding: b)
  }
}

fn rust_formal_rhs_from_tokens_with_bindings(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(xs: acc, item: rust_formal_symbol_from_token(token: token))
    }
  )
}

fn rust_formal_production_from_tokens(lhs: Symbol, tokens: List<ConcreteSyntaxToken>) -> FormalProduction {
  grammar_formal_production(lhs: lhs, rhs: rust_formal_rhs_from_tokens_with_bindings(tokens: tokens))
}

fn rust_lhs_exact_relation_row_witness(
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Witness<Node> {
  let production = rust_formal_production_from_tokens(lhs: lhs, tokens: tokens)
  let productions = [production]
  match formal_production_for_lhs_exact(productions: productions, lhs: lhs, child: emitted) {
    Holds { value: selected } =>
      derive_grammar_relation_row_node(
        production: selected,
        productions: productions,
        emitted: emitted
      )
    Violates { diagnostic: d } => Violates { diagnostic: d }
  }
}

fn rust_empty_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_relation_translation_rules_node(
  rule_name: Symbol,
  lhs: Symbol,
  tokens: List<ConcreteSyntaxToken>,
  emitted: Node
) -> Node {
  match rust_lhs_exact_relation_row_witness(lhs: lhs, tokens: tokens, emitted: emitted) {
    Holds { value: row } =>
      Node {
        kind: TypeNode { connective: Conj },
        children: [
          rust_named_edge(name: rule_name, target: row)
        ],
        occurrence_id: SyntheticOccurrence
      }
    Violates { diagnostic: _ } => rust_empty_translation_rules_node()
  }
}

fn rust_serialize_source_prefix_edges(source_text_binding: Symbol, production_binding: Symbol) -> List<Edge> {
  [
    rust_named_edge(
      name: ^serialize_source_field_source_text,
      target: rust_inhabitant_atom(id: source_text_binding)
    ),
    rust_named_edge(
      name: ^serialize_source_field_source_grammar,
      target: rust_inhabitant_atom(id: production_binding)
    )
  ]
}

fn rust_serialize_source_node(
  source_text_binding: Symbol,
  production_binding: Symbol,
  tokens: List<ConcreteSyntaxToken>
) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: list_append(
      left: rust_serialize_source_prefix_edges(
        source_text_binding: source_text_binding,
        production_binding: production_binding
      ),
      right: [
        rust_named_edge(
          name: ^grammar_relation_field_tokens,
          target: grammar_relation_tokens_node(
            tokens: tokens,
            token_to_node: rust_concrete_token_node
          )
        )
      ]
    ),
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_target_model_bundle(rules: Node, serialize_source: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(name: ^target_model_edge_translation_rules, target: rules),
      rust_named_edge(name: ^target_model_edge_serialize_source, target: serialize_source)
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_string_literal_escape(spelling: String) -> String {
  replace(replace(spelling, "\\", "\\\\"), "\"", "\\\"")
}

fn rust_string_literal_spelling(spelling: String) -> String {
  concat("\"", concat(rust_string_literal_escape(spelling: spelling), "\""))
}

fn rust_emit_directive_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_macro_eprintln_open },
    BoundToken { token_class: ^rust_token_str_lit, binding: ^emit_directive_message },
    FixedToken { token_class: ^rust_token_rparen }
  ]
}

data rust_emit_directive_emitted_call: Node = rust_conj_emitted_from_tokens(
  tokens: rust_emit_directive_concrete_tokens()
)

fn rust_emit_directive_source_text(d: EmitDirective) -> String {
  concat("eprintln!(", concat(rust_string_literal_spelling(spelling: d.message), ")"))
}

fn rust_emit_directive_lex() -> LexRules {
  ModeledLexRules {
    root: LexRuleSet {
      rules: [
        rust_lex_rule(token_class: ^rust_token_macro_eprintln_open, text: "eprintln!("),
        rust_lex_rule(token_class: ^rust_token_rparen, text: ")")
      ]
    }
  }
}

fn rust_emit_directive_translation_rules_node() -> Node {
  rust_relation_translation_rules_node(
    rule_name: ^rust_relation_rule_emit_directive_eprintln,
    lhs: ^rust_production_emit_directive_eprintln,
    tokens: rust_emit_directive_concrete_tokens(),
    emitted: rust_emit_directive_emitted_call
  )
}

fn rust_emit_directive_serialize_source_node() -> Node {
  rust_serialize_source_node(
    source_text_binding: ^rust_emit_directive_source_literal,
    production_binding: ^rust_production_emit_directive_eprintln,
    tokens: rust_emit_directive_concrete_tokens()
  )
}

fn rust_emit_directive_message_spellings(d: EmitDirective) -> Map<Symbol, String> {
  map_insert(empty_map(), ^emit_directive_message, d.message)
}

fn rust_emit_directive_token_class_emit_transforms() -> Map<Symbol, fn(String) -> String> {
  map_insert(empty_map(), ^rust_token_str_lit, rust_string_literal_spelling)
}

fn rust_emit_directive_target_model(d: EmitDirective) -> TargetModel {
  target_model_make_with_emit_transforms(
    bundle: rust_target_model_bundle(
      rules: rust_emit_directive_translation_rules_node(),
      serialize_source: rust_emit_directive_serialize_source_node()
    ),
    lex: rust_emit_directive_lex(),
    binding_spellings: rust_emit_directive_message_spellings(d: d),
    token_class_emit_transforms: rust_emit_directive_token_class_emit_transforms(),
    authority_source_text: rust_emit_directive_source_text(d: d),
    runtime_row: target_emit_host_runtime_row_unconfigured
  )
}

fn rust_fn_add_formal_productions() -> List<FormalProduction> {
  [rust_formal_production_fn_add()]
}

fn rust_type_alias_decl_structural_formal_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^rust_production_type_alias_qualified_name,
      rhs: [
        grammar_formal_terminal_free(identity: ^rust_token_ident)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_type_alias_type_expr,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_type_alias_qualified_name)
      ]
    ),
    grammar_formal_production(
      lhs: ^rust_production_type_alias_decl,
      rhs: [
        grammar_formal_terminal(identity: ^rust_token_kw_type),
        grammar_formal_terminal_free(identity: ^rust_token_ident),
        grammar_formal_terminal(identity: ^rust_token_type_alias_eq),
        grammar_formal_nonterminal_occurrence(identity: ^rust_production_type_alias_type_expr),
        grammar_formal_terminal(identity: ^rust_token_semicolon)
      ]
    )
  ]
}

fn rust_type_alias_decl_productions_only_translation_rules() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      rust_named_edge(
        name: ^grammar_relation_rules_formal_productions,
        target: formal_productions_catalog_to_node(
          productions: rust_type_alias_decl_structural_formal_productions()
        )
      )
    ],
    occurrence_id: SyntheticOccurrence
  }
}

fn rust_type_alias_decl_structural_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      rust_whitespace_trivia_rule(),
      rust_lex_rule(token_class: ^rust_token_kw_type, text: "type "),
      rust_lex_rule(token_class: ^rust_token_type_alias_eq, text: " = "),
      rust_lex_rule(token_class: ^rust_token_semicolon, text: ";"),
      rust_ident_lex_rule()
    ]
  }
}

fn rust_type_alias_decl_structural_lex() -> LexRules {
  ModeledLexRules { root: rust_type_alias_decl_structural_lex_rules() }
}

fn rust_type_alias_decl_structural_target_model() -> TargetModel {
  TargetModel {
    bundle: Node {
      kind: TypeNode { connective: Conj },
      children: [
        rust_named_edge(
          name: ^target_model_edge_translation_rules,
          target: rust_type_alias_decl_productions_only_translation_rules()
        )
      ],
      occurrence_id: SyntheticOccurrence
    },
    lex: rust_type_alias_decl_structural_lex(),
    binding_spellings: empty_map(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: "",
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

data rust_filesystem_read_family_note: String = "filesystem_read native family (neat-carp-312, Task 1): the emitted crate's cargo run subprocess has its cwd forced to a /tmp/gunbc_emit_on_demand_* cache workspace (v1_interpreter.rs emit_host_run_transport_in_workspace), disconnected from the git checkout -- there is no .dag-callable builtin exposing cwd/repo-root (confirmed absent: grep of the v1 builtin dispatch table near filesystem_read's own registration turned up nothing, and std.effect_axes.region_repo_root is a symbolic NamespacePosition, never a literal path). Rather than hand-hardcoding an absolute path that would only resolve on one machine (explicitly disallowed), the REAL file content is read once via the real filesystem_read builtin at .dag construction time (correctly resolved against the interpreter's own workspace_root() convention, the same mechanism dag/test/claim/filesystem_read_hermetic_witness.dag already relies on) and carried into the emitted crate as an extra WorkspaceFile (FixedText) placed inside the workspace the native process's cwd IS rooted at; the native fn filesystem_read(path: &str) then reads that workspace-relative path for real via std::fs::read_to_string, so both legs perform a genuine disk read of independently-obtained bytes, and the native leg never receives a baked machine-specific path."

data rust_filesystem_read_family_prelude: String = "\n\nfn filesystem_read(path: &str) -> String { std::fs::read_to_string(path).expect(\"read file\") }"

data rust_filesystem_read_family_fixture_path: String = "fixture/exec_dag_content.txt"

data rust_filesystem_read_family_member_contains_bash: RustEmitHostFamilyMember = RustEmitHostFamilyMember {
  member_id: "contains_bash",
  result_expression: "if filesystem_read(\"fixture/exec_dag_content.txt\").contains(\"bash\") { 1 } else { 0 }"
}

fn rust_filesystem_read_family_dispatch_members() -> List<RustEmitHostFamilyMember> {
  [rust_filesystem_read_family_member_contains_bash]
}

fn rust_filesystem_read_family_host_transport_descriptor(fixture_content: String) -> HostTransportDescriptor {
  HostTransportDescriptor {
    identity: ^rust_host_transport_filesystem_read_family_identity,
    workspace: [
      WorkspaceFile {
        path: "Cargo.toml",
        content: FixedText { text: rust_emit_host_cargo_manifest }
      },
      WorkspaceFile {
        path: "rust-toolchain.toml",
        content: FixedText { text: rust_emit_host_toolchain_pin }
      },
      WorkspaceFile {
        path: rust_filesystem_read_family_fixture_path,
        content: FixedText { text: fixture_content }
      },
      WorkspaceFile {
        path: "src/main.rs",
        content: EmittedWithSuffix {
          suffix: rust_family_main_suffix(
            prelude: rust_filesystem_read_family_prelude,
            members: rust_filesystem_read_family_dispatch_members()
          )
        }
      }
    ],
    build: [
      ProcessInvocation {
        program: HostToolProgram { executable: "cargo" },
        args: [LiteralArg { text: "build" }, LiteralArg { text: "--quiet" }]
      }
    ],
    run: ProcessInvocation {
      program: HostToolProgram { executable: "cargo" },
      args: [LiteralArg { text: "run" }, LiteralArg { text: "--quiet" }]
    },
    runtime_value_codec: FixedWidthBytes { width: 5 }
  }
}

fn rust_filesystem_read_family_runtime_row(fixture_content: String) -> TargetEmitHostRuntimeRow {
  emitted_family_runtime_row_gated(
    family: FilesystemReadFamily,
    present: EmitHostRuntimeRow {
      transport: rust_filesystem_read_family_host_transport_descriptor(fixture_content: fixture_content),
      runtime_primitive_type: rust_emit_host_runtime_primitive_type_node()
    }
  )
}

fn rust_filesystem_read_family_target_model_staging(fixture_content: String) -> TargetModel {
  let base = rust_logic_meet_target_model_staging()
  TargetModel {
    bundle: base.bundle,
    lex: base.lex,
    binding_spellings: base.binding_spellings,
    token_class_emit_transforms: base.token_class_emit_transforms,
    authority_source_text: base.authority_source_text,
    runtime_row: rust_filesystem_read_family_runtime_row(fixture_content: fixture_content)
  }
}

data rust_shell_exec_run_family_note: String = "shell_exec_run native family (neat-carp-312, Task 2): a SEPARATE family from filesystem_read (not folded in), because its host-effect is a process spawn (bottom transport), a genuinely different confinement class from a file read, and keeping them separate keeps the effect roster (Task 4) legible per-effect-kind rather than per-PR-lane. Unlike Task 1, this family has NO cwd/repo-path problem: the two argv literals baked into the generated Rust prelude are derived by calling shell_materialize_argv_for_operation against dag/extdeps/shell/exec.dag's shell.Exec.Run operation AT .dag CONSTRUCTION TIME, in the INTERPRETER's own process (whose relative-path resolution is the same workspace_root() convention Task 1's fixture read already uses) -- not inside the emitted native binary -- so no embedded-fixture trick is needed here. This is real single-authority derivation, not a hand-typed literal kept in sync by convention: if shell.Exec.Run's transport block ever changes argv, this family's emitted argv changes with it at .dag build time, with no Rust edit required. package/bin/extra_args are passed empty because shell.Exec.Run's transport argv is the fixed literal [\"bash\", \"-s\"] with no package/bin/args template interpolation (confirmed via dag/extdeps/shell/exec.dag and the cargo_build_run_argv_witness_test.dag precedent, and via v1_interpreter.rs's materialize_shell_argv_for_operation dispatch, which only substitutes those params when the argv expression references them)."

data rust_shell_exec_run_family_dag_path: String = "dag/extdeps/shell/exec.dag"

data rust_shell_exec_run_family_service: String = "shell.Exec"

data rust_shell_exec_run_family_operation: String = "Run"

fn rust_shell_exec_run_family_argv() -> List<String> {
  shell_materialize_argv_for_operation(
    rust_shell_exec_run_family_dag_path,
    rust_shell_exec_run_family_service,
    rust_shell_exec_run_family_operation,
    "",
    "",
    []
  )
}

fn rust_shell_exec_run_family_argv_token(index: Int) -> String {
  rust_shell_exec_run_family_argv().skip(n: index).first()
}

fn rust_shell_exec_run_family_prelude() -> String {
  concat(
    "\n\nfn shell_exec_run_native(script: &str) -> String { use std::io::Write; let mut child = std::process::Command::new(\"",
    rust_shell_exec_run_family_argv_token(index: 0),
    "\").arg(\"",
    rust_shell_exec_run_family_argv_token(index: 1),
    "\").stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped()).spawn().expect(\"spawn shell\"); if let Some(mut stdin) = child.stdin.take() { let _ = stdin.write_all(script.as_bytes()); } let output = child.wait_with_output().expect(\"wait shell\"); String::from_utf8_lossy(&output.stdout).to_string() }"
  )
}

data rust_shell_exec_run_family_member_echo: RustEmitHostFamilyMember = RustEmitHostFamilyMember {
  member_id: "echo_native_shell_ok",
  result_expression: "if shell_exec_run_native(\"echo native_shell_ok\\n\").contains(\"native_shell_ok\") { 1 } else { 0 }"
}

fn rust_shell_exec_run_family_dispatch_members() -> List<RustEmitHostFamilyMember> {
  [rust_shell_exec_run_family_member_echo]
}

fn rust_shell_exec_run_family_host_transport_descriptor() -> HostTransportDescriptor {
  HostTransportDescriptor {
    identity: ^rust_host_transport_shell_exec_run_family_identity,
    workspace: [
      WorkspaceFile {
        path: "Cargo.toml",
        content: FixedText { text: rust_emit_host_cargo_manifest }
      },
      WorkspaceFile {
        path: "rust-toolchain.toml",
        content: FixedText { text: rust_emit_host_toolchain_pin }
      },
      WorkspaceFile {
        path: "src/main.rs",
        content: EmittedWithSuffix {
          suffix: rust_family_main_suffix(
            prelude: rust_shell_exec_run_family_prelude(),
            members: rust_shell_exec_run_family_dispatch_members()
          )
        }
      }
    ],
    build: [
      ProcessInvocation {
        program: HostToolProgram { executable: "cargo" },
        args: [LiteralArg { text: "build" }, LiteralArg { text: "--quiet" }]
      }
    ],
    run: ProcessInvocation {
      program: HostToolProgram { executable: "cargo" },
      args: [LiteralArg { text: "run" }, LiteralArg { text: "--quiet" }]
    },
    runtime_value_codec: FixedWidthBytes { width: 5 }
  }
}

fn rust_shell_exec_run_family_runtime_row() -> TargetEmitHostRuntimeRow {
  emitted_family_runtime_row_gated(
    family: ShellExecRunFamily,
    present: EmitHostRuntimeRow {
      transport: rust_shell_exec_run_family_host_transport_descriptor(),
      runtime_primitive_type: rust_emit_host_runtime_primitive_type_node()
    }
