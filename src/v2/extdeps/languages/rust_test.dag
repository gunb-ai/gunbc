fn rust_bool_fn_target_model(
  fn_binding: Symbol,
  fn_spelling: String,
  source_text: String,
  signature_with_open: List<ConcreteSyntaxToken>,
  body_tokens: List<ConcreteSyntaxToken>,
  production_sym: Symbol,
  relation_sym: Symbol,
  source_literal_sym: Symbol,
  host_identity_sym: Symbol,
  main_suffix: String
) -> TargetModel {
  let tokens = rust_bool_fn_concrete_tokens(
    signature_with_open: signature_with_open,
    body_tokens: body_tokens
  )
  let m0 = map_insert(empty_map(), fn_binding, fn_spelling)
  let m1 = map_insert(m0, ^dag_binding_param_a, "a")
  let binding_spellings = map_insert(m1, ^dag_binding_param_b, "b")
  TargetModel {
    bundle: Node {
      kind: TypeNode { connective: Conj },
      children: rust_bool_fn_target_model_core_edges(
        translation_rules: rust_bool_fn_translation_rules_node(
          relation_sym: relation_sym,
          production_sym: production_sym,
          tokens: tokens,
          signature_with_open: signature_with_open
        ),
        serialize_source: rust_bool_fn_serialize_source_node(
          source_literal_sym: source_literal_sym,
          production_sym: production_sym,
          tokens: tokens
        )
      ),
      occurrence_id: SyntheticOccurrence
    },
    lex: rust_bool_fn_lex(),
    binding_spellings: binding_spellings,
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: source_text,
    runtime_row: rust_bool_fn_host_runtime_row(
      host_identity_sym: host_identity_sym,
      main_suffix: main_suffix
    )
  }
}

fn rust_bool_binop_signature_with_open(fn_binding: Symbol) -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_kw_fn },
    BoundToken { token_class: ^rust_token_ident, binding: fn_binding },
    FixedToken { token_class: ^rust_token_lparen },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_param_a },
    FixedToken { token_class: ^rust_token_colon },
    FixedToken { token_class: ^rust_token_ty_bool },
    FixedToken { token_class: ^rust_token_comma },
    BoundToken { token_class: ^rust_token_ident, binding: ^dag_binding_param_b },
    FixedToken { token_class: ^rust_token_colon },
    FixedToken { token_class: ^rust_token_ty_bool },
    FixedToken { token_class: ^rust_token_rparen },
    FixedToken { token_class: ^rust_token_arrow },
    FixedToken { token_class: ^rust_token_ty_bool },
    FixedToken { token_class: ^rust_token_lbrace }
  ]
}

fn rust_bool_binop_body_tokens(true_body: Symbol, false_body: Symbol) -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^rust_token_unwired_match },
    FixedToken { token_class: ^rust_token_lparen },
    FixedToken { token_class: ^dag_binding_param_a },
    FixedToken { token_class: ^rust_token_rparen },
    FixedToken { token_class: ^rust_token_lbrace },
    FixedToken { token_class: ^dag_complement_lit_true },
    FixedToken { token_class: ^rust_token_unwired_fat_arrow },
    FixedToken { token_class: true_body },
    FixedToken { token_class: ^rust_token_comma },
    FixedToken { token_class: ^dag_complement_lit_false },
    FixedToken { token_class: ^rust_token_unwired_fat_arrow },
    FixedToken { token_class: false_body },
    FixedToken { token_class: ^rust_token_rbrace }
  ]
}

