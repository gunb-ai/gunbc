module v2.extdeps.languages.swift_decl

import std.types { List }
import std.occurrence_identity { OccurrenceSynthetic }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import v2.std.grammar {
  FormalGrammarSymbol,
  grammar_formal_terminal,
  grammar_formal_terminal_free,
  grammar_formal_nonterminal_occurrence,
  grammar_formal_nested_occurrence,
  grammar_formal_production,
  formal_productions_catalog_to_node,
  FormalProduction
}
import v2.std.compilers.target_model { EmitLineBreaks, EmitSpellingEscape, EmitSpellingQuote }
import v2.std.compilers.semantic_decl_emission {
  TargetSemanticDeclColumnPlain,
  ColumnUnwired,
  ColumnWired,
  MembersInsideTypeBody,
  TargetSemanticDeclCoproductEnumSurface,
  TargetSemanticDeclEmitTransformRow,
  TargetSemanticDeclSurfaceProjection,
  semantic_decl_binding_spelling_row,
  semantic_decl_emission_bundle,
  semantic_decl_lex_ident_row,
  semantic_decl_lex_literal_row,
  semantic_decl_lex_whitespace_trivia_row,
  semantic_decl_serialize_profile_bundle
}
import std.algebra { list_append }
import v2.std.node {
  Conj,
  Edge,
  Authored,
  Node,
  Symbol,
  TypeNode,
  NotADeclaration
}

// SWIFT TYPE DECLARATIONS AS ROWS, READ BY THE SHARED SEMANTIC-DECL FOLD (std.compilers.semantic_decl_emission).
// No fold edit: a record projects to a structure declaration and a coproduct to a union-style
// enumeration whose payload variants carry labeled associated values. Grammar cited to The Swift
// Programming Language, Swift 6.2 (github.com/swiftlang/swift-book, tag swift-6.2-RELEASE),
// Language Reference > Declarations: `struct-declaration`, `union-style-enum` /
// `union-style-enum-case-list` (one `case` introducing a comma-separated list whose members may
// carry a `tuple-type`), and `generic-parameter-clause` with a protocol-composition requirement.
//
// THE CONFORMANCE CLAUSE IS `Equatable, Sendable`, BOTH SWIFT STANDARD LIBRARY PROTOCOLS, AND
// NOTHING MORE. Every emitted member is a `let` and every payload an associated value, so the
// declarations are values: Equatable and Sendable are synthesized by the compiler from the members,
// and the Swift compiler refuses the synthesis if a member does not conform -- the claim is checked
// by swiftc, not asserted here. Codable is deliberately NOT declared: its synthesized JSON shape
// would be a second wire encoding beside gunbc.auth.approval_device_wire's, which owns the bytes.
//
// CONSUMER (DESIGN section 3c): a declared frontier. The named consumer is the approve-ios
// protocol-slice emission of gunbc.auth.approval_device_wire's records and coproducts, gated on the
// v2 closure-emit route rendering a module's members (gunbc#12239); until then the executing
// consumer is v2.test.claim.emit.swift_semantic_decl_routing at the emit_semantic_type_decl boundary.

// THE TWO KNOWN GAPS, AS DISSOLUTION CONDITIONS ON THE SHARED CARRIER (std.dissolution), read by
// gunbc.dissolution_census like every other such row rather than by a target-local type.
data swift_decl_reserved_word_escape_frontier: DissolutionCondition = unbound_dissolution(
  description: "A declaration, field or variant spelled like a Swift keyword (TSPL Lexical Structure > Keywords and Punctuation) is emitted bare by v2.extdeps.languages.swift_decl, and swiftc refuses the text rather than this emitter. DISSOLVES WHEN the Swift ident lex row carries Swift's backtick escape for the reserved-word roster, SUFFICIENT FOR any .dag identifier to emit as a Swift identifier naming the same member."
)

data swift_decl_primitive_spelling_frontier: DissolutionCondition = unbound_dissolution(
  description: "v2.extdeps.languages.swift_decl spells field type atoms by their .dag symbol (Int, String, Bool coincide with Swift standard library names); width-qualified and branded types (UInt8, NonEmptyStr, Timestamp) reach a Swift type only if one of that name exists. DISSOLVES WHEN field atoms resolve through v2.extdeps.languages.swift's primitive facts, SUFFICIENT FOR every field type in gunbc.auth.approval_device_wire to emit as a declared Swift type."
)

fn swift_decl_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Authored { name: name }, target: target, declaration: NotADeclaration }
}

fn swift_decl_type_expr_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_qualified_name,
      rhs: [ grammar_formal_terminal_free(identity: ^swift_token_ident) ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_type_expr,
      rhs: [ grammar_formal_nonterminal_occurrence(identity: ^swift_decl_qualified_name) ]
    )
  ]
}

// `generic-parameter-clause`: each parameter carries the same requirement the declaration's own
// conformance clause needs, so the synthesized Equatable/Sendable conformance holds for every
// instantiation rather than only for some.
fn swift_decl_generic_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_type_param_list,
      rhs: [
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_param_requirement),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_type_param_list_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_type_param_list_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_comma),
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_param_requirement),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_type_param_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_decl_type_param_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^swift_decl_generic_params,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_generic_lt),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_type_param_list),
        grammar_formal_terminal(identity: ^swift_token_generic_gt)
      ]
    )
  ]
}

// A STRUCTURE'S STORED PROPERTIES: `let name: Type`, separated by `; ` so one declaration is one line.
fn swift_decl_struct_field_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_field,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_line_start),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_doc_list),
        grammar_formal_terminal(identity: ^swift_token_kw_let),
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_type_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_field_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field_list_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_field_list_suffix,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_decl_field_list_suffix, rhs: []),
    // THE BODY IS ONE NESTED OCCURRENCE: each line starts with a line break (swift_token_line_start) that renders
    // inside the nest, so it is indented by the spelled unit; the closing brace's break is outside it.
    grammar_formal_production(
      lhs: ^swift_decl_field_block,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_lbrace),
        grammar_formal_nested_occurrence(identity: ^swift_decl_field_list, unit: ^swift_indent),
        grammar_formal_terminal(identity: ^swift_token_rbrace)
      ]
    ),
    // A structure's constants share its body, after the stored fields: `static let name = "text"`.
    grammar_formal_production(
      lhs: ^swift_decl_field_block,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_lbrace),
        grammar_formal_nested_occurrence(identity: ^swift_decl_field_list, unit: ^swift_indent),
        grammar_formal_nested_occurrence(identity: ^swift_decl_member_list, unit: ^swift_indent),
        grammar_formal_terminal(identity: ^swift_token_rbrace)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_member,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_line_start),
        grammar_formal_terminal(identity: ^swift_token_kw_static_let),
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_equals),
        grammar_formal_terminal_free(identity: ^swift_token_string_lit)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_member_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_member),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_member_list_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_member_list_suffix,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_member),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_member_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_decl_member_list_suffix, rhs: [])
  ]
}

// A DECLARATION'S LEADING IMPORTS: `import Module` lines ahead of the declaration, in the same emission. The list is
// nullable (the nil terminator of an empty import list derives nothing), so a declaration without imports is unchanged.
fn swift_decl_header_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_header_line,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_comment_prefix),
        grammar_formal_terminal_free(identity: ^swift_token_header_text),
        grammar_formal_terminal(identity: ^swift_token_header_end)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_header_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_header_line),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_header_list)
      ]
    ),
    grammar_formal_production(lhs: ^swift_decl_header_list, rhs: [])
  ]
}

// A DECLARATION'S DOC LINES: `/// text` lines directly above the declaration. Nullable like the header list.
fn swift_decl_doc_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_doc_line,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_doc_prefix),
        grammar_formal_terminal_free(identity: ^swift_token_header_text),
        grammar_formal_terminal(identity: ^swift_token_doc_end)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_doc_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_doc_line),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_doc_list)
      ]
    ),
    grammar_formal_production(lhs: ^swift_decl_doc_list, rhs: [])
  ]
}

// A DECLARATION'S CONFORMANCE CLAUSE over the names it states: `: A, B`. A declaration naming none takes the
// target's fixed `swift_token_conformance` literal in the top productions instead, consuming no clause edge.
fn swift_decl_conformance_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_conformance_clause,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_colon),
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_conformance_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_conformance_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_comma),
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_conformance_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_decl_conformance_suffix, rhs: [])
  ]
}

fn swift_decl_import_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_import,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_kw_import),
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_import_end)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_import_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_import),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_import_list)
      ]
    ),
    grammar_formal_production(lhs: ^swift_decl_import_list, rhs: [])
  ]
}

fn swift_decl_struct_top_productions() -> List<FormalProduction> {
  list_append(
    left: swift_decl_struct_top_productions_with(conformance: [ grammar_formal_terminal(identity: ^swift_token_conformance) ]),
    right: swift_decl_struct_top_productions_with(conformance: [ grammar_formal_nonterminal_occurrence(identity: ^swift_decl_conformance_clause) ])
  )
}

fn swift_decl_struct_top_productions_with(conformance: List<FormalGrammarSymbol>) -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_struct,
      rhs: list_append(
        left: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_header_list),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_import_list),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_doc_list),
        grammar_formal_terminal(identity: ^swift_token_kw_struct),
        grammar_formal_terminal_free(identity: ^swift_token_ident)
        ],
        right: list_append(left: conformance, right: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field_block)
        ])
      )
    ),
    grammar_formal_production(
      lhs: ^swift_decl_struct,
      rhs: list_append(
        left: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_header_list),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_import_list),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_doc_list),
        grammar_formal_terminal(identity: ^swift_token_kw_struct),
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_generic_params)
        ],
        right: list_append(left: conformance, right: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field_block)
        ])
      )
    )
  ]
}

// AN ENUMERATION CASE'S ASSOCIATED VALUES: a labeled `tuple-type`, `(name: Type, ...)`. The
// payload is the same record surface a structure's body is, spelled with Swift's tuple punctuation.
fn swift_decl_variant_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_field,
      rhs: [
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_terminal(identity: ^swift_token_colon),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_type_expr)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_field_list,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field_list_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_field_list_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_decl_field_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^swift_decl_field_block,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_lparen),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field_list),
        grammar_formal_terminal(identity: ^swift_token_rparen)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_variant,
      rhs: [ grammar_formal_terminal_free(identity: ^swift_token_ident) ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_variant,
      rhs: [
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_field_block)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_variant_list,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_line_start),
        grammar_formal_terminal(identity: ^swift_token_kw_case),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_variant),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_variant_list_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^swift_decl_variant_list_suffix,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_comma),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_variant),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_variant_list_suffix)
      ]
    ),
    grammar_formal_production(lhs: ^swift_decl_variant_list_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^swift_decl_variant_block,
      rhs: [
        grammar_formal_terminal(identity: ^swift_token_lbrace),
        grammar_formal_nested_occurrence(identity: ^swift_decl_variant_list, unit: ^swift_indent),
        grammar_formal_terminal(identity: ^swift_token_rbrace)
      ]
    )
  ]
}

fn swift_decl_enum_top_productions() -> List<FormalProduction> {
  list_append(
    left: swift_decl_enum_top_productions_with(conformance: [ grammar_formal_terminal(identity: ^swift_token_conformance) ]),
    right: swift_decl_enum_top_productions_with(conformance: [ grammar_formal_nonterminal_occurrence(identity: ^swift_decl_conformance_clause) ])
  )
}

fn swift_decl_enum_top_productions_with(conformance: List<FormalGrammarSymbol>) -> List<FormalProduction> {
  [
    grammar_formal_production(
      lhs: ^swift_decl_enum,
      rhs: list_append(
        left: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_header_list),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_import_list),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_doc_list),
        grammar_formal_terminal(identity: ^swift_token_kw_enum),
        grammar_formal_terminal_free(identity: ^swift_token_ident)
        ],
        right: list_append(left: conformance, right: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_variant_block)
        ])
      )
    ),
    grammar_formal_production(
      lhs: ^swift_decl_enum,
      rhs: list_append(
        left: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_header_list),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_import_list),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_doc_list),
        grammar_formal_terminal(identity: ^swift_token_kw_enum),
        grammar_formal_terminal_free(identity: ^swift_token_ident),
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_generic_params)
        ],
        right: list_append(left: conformance, right: [
        grammar_formal_nonterminal_occurrence(identity: ^swift_decl_variant_block)
        ])
      )
    )
  ]
}

fn swift_decl_struct_formal_productions() -> List<FormalProduction> {
  list_append(
    left: swift_decl_type_expr_productions(),
    right: list_append(
      left: swift_decl_generic_productions(),
      right: list_append(
        left: swift_decl_struct_field_productions(),
        right: list_append(left: list_append(left: swift_decl_header_productions(), right: list_append(left: swift_decl_import_productions(), right: list_append(left: swift_decl_doc_productions(), right: swift_decl_conformance_productions()))), right: swift_decl_struct_top_productions())
      )
    )
  )
}

fn swift_decl_enum_formal_productions() -> List<FormalProduction> {
  list_append(
    left: swift_decl_type_expr_productions(),
    right: list_append(
      left: swift_decl_generic_productions(),
      right: list_append(
        left: swift_decl_variant_productions(),
        right: list_append(left: list_append(left: swift_decl_header_productions(), right: list_append(left: swift_decl_import_productions(), right: list_append(left: swift_decl_doc_productions(), right: swift_decl_conformance_productions()))), right: swift_decl_enum_top_productions())
      )
    )
  )
}

fn swift_decl_productions_only_translation_rules(productions: List<FormalProduction>) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      swift_decl_named_edge(
        name: ^grammar_relation_rules_formal_productions,
        target: formal_productions_catalog_to_node(productions: productions)
      )
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn swift_struct_general_decl_productions_only_translation_rules() -> Node {
  swift_decl_productions_only_translation_rules(productions: swift_decl_struct_formal_productions())
}

fn swift_enum_general_decl_productions_only_translation_rules() -> Node {
  swift_decl_productions_only_translation_rules(productions: swift_decl_enum_formal_productions())
}

fn swift_semantic_decl_lex_rows() -> List<Node> {
  [
    semantic_decl_lex_whitespace_trivia_row(),
    semantic_decl_lex_literal_row(token_class: ^swift_token_comment_prefix, text: "// "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_doc_prefix, text: "/// "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_header_end, text: "\n"),
    semantic_decl_lex_literal_row(token_class: ^swift_token_doc_end, text: ""),
    semantic_decl_lex_ident_row(token_class: ^swift_token_header_text),
    semantic_decl_lex_literal_row(token_class: ^swift_token_kw_import, text: "import "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_import_end, text: "\n"),
    semantic_decl_lex_literal_row(token_class: ^swift_token_kw_struct, text: "struct "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_kw_enum, text: "enum "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_kw_let, text: "let "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_conformance, text: ": Equatable, Sendable"),
    semantic_decl_lex_literal_row(token_class: ^swift_token_param_requirement, text: ": Equatable & Sendable"),
    semantic_decl_lex_literal_row(token_class: ^swift_token_generic_lt, text: "<"),
    semantic_decl_lex_literal_row(token_class: ^swift_token_generic_gt, text: ">"),
    semantic_decl_lex_literal_row(token_class: ^swift_token_kw_case, text: "case "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_line_start, text: ""),
    semantic_decl_lex_literal_row(token_class: ^swift_token_lbrace, text: " {"),
    semantic_decl_lex_literal_row(token_class: ^swift_token_rbrace, text: "}"),
    semantic_decl_lex_literal_row(token_class: ^swift_token_lparen, text: "("),
    semantic_decl_lex_literal_row(token_class: ^swift_token_rparen, text: ")"),
    semantic_decl_lex_literal_row(token_class: ^swift_token_colon, text: ": "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_comma, text: ", "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_kw_static_let, text: "static let "),
    semantic_decl_lex_literal_row(token_class: ^swift_token_equals, text: " = "),
    semantic_decl_lex_ident_row(token_class: ^swift_token_ident),
    semantic_decl_lex_ident_row(token_class: ^swift_token_string_lit)
  ]
}

fn swift_semantic_decl_serialize_profile_bundle_node() -> Node {
  semantic_decl_serialize_profile_bundle(
    lex_rows: swift_semantic_decl_lex_rows(),
    spelling_rows: [ semantic_decl_binding_spelling_row(binding: ^swift_indent, spelling: "    ") ],
    emit_transform_rows: [
      TargetSemanticDeclEmitTransformRow { token_class: ^swift_token_line_start, transform: EmitLineBreaks { before: 1, after: 0 } },
      TargetSemanticDeclEmitTransformRow { token_class: ^swift_token_doc_end, transform: EmitLineBreaks { before: 0, after: 1 } },
      TargetSemanticDeclEmitTransformRow { token_class: ^swift_token_rbrace, transform: EmitLineBreaks { before: 1, after: 0 } },
      TargetSemanticDeclEmitTransformRow {
        token_class: ^swift_token_string_lit,
        transform: EmitSpellingQuote {
        prefix: "",
        open: "\"",
        close: "\"",
          escapes: [
            EmitSpellingEscape { from: "\\", to: "\\\\" },
            EmitSpellingEscape { from: "\"", to: "\\\"" },
            EmitSpellingEscape { from: "\n", to: "\\n" },
            EmitSpellingEscape { from: "\r", to: "\\r" }
          ]
        }
      }
    ]
  )
}

fn swift_semantic_decl_surface_projection() -> TargetSemanticDeclSurfaceProjection {
  TargetSemanticDeclSurfaceProjection {
    record_decoration_lines: [],
    field_type_before_name: false,
    type_expr_field_scope: false,
    struct_typedef_name_after_fields: false,
    enum_name_after_variants: false,
    field_type_permit_only_int: false,
    coproduct_layout: TargetSemanticDeclCoproductEnumSurface,
    member_projection: ColumnWired { placement: MembersInsideTypeBody },
    import_projection: ColumnWired { placement: TargetSemanticDeclColumnPlain {} },
    header_projection: ColumnWired { placement: TargetSemanticDeclColumnPlain {} },
    doc_projection: ColumnWired { placement: TargetSemanticDeclColumnPlain {} },
    conformance_projection: ColumnWired { placement: TargetSemanticDeclColumnPlain {} },
    coproduct_decoration_rules: []
  }
}

// One profile serves both declaration kinds, carried once (the rust_semantic_decl_emission_bundle_node shape).
fn swift_semantic_decl_emission_bundle_node() -> Node {
  let serialize_profile = swift_semantic_decl_serialize_profile_bundle_node()
  semantic_decl_emission_bundle(
    identity: ^swift_semantic_decl_emission_identity,
    enum_translation_rules: swift_enum_general_decl_productions_only_translation_rules(),
    struct_translation_rules: swift_struct_general_decl_productions_only_translation_rules(),
    enum_serialize_profile: serialize_profile,
    struct_serialize_profile: serialize_profile,
    surface: swift_semantic_decl_surface_projection()
  )
}
