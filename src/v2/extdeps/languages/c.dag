data c_emit_host_type_decl_main_suffix: String = "\n\nint main(void) {\n  Point p = { 2, 3 };\n  Bool b = True;\n  if (p.x + p.y != 5) { return 1; }\n  if (b != True) { return 2; }\n  unsigned char out[5] = {0, 5, 0, 0, 0};\n  extern long write(int, const void *, unsigned long);\n  write(1, out, 5);\n  return 0;\n}\n"

data c_emit_host_type_decl_inject_fault_main_suffix: String = "\n\nint main(void) {\n  Point p = { 2, 3 };\n  unsigned char out[5] = {0, 4, 0, 0, 0};\n  extern long write(int, const void *, unsigned long);\n  write(1, out, 5);\n  return 0;\n}\n"

data c_emit_host_type_decl_main_suffix_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "🟡 dissolve-on: c_emit_host_type_decl_main_suffix + c_emit_host_type_decl_inject_fault_main_suffix — type-decl smoke-driver main harness fragments spliced after emitted Point/Bool/Answer typedefs via v2.std.host_transport.EmittedWithSuffix (parallel to c_emit_host_main_suffix_dissolution_trigger). DISSOLVES WHEN a modeled C main producer emits the harness from grammar rows — retire these string carriers then.")

fn c_type_decl_host_transport_descriptor(main_suffix: String) -> v2.std.host_transport.HostTransportDescriptor {
  v2.std.host_transport.HostTransportDescriptor {
    identity: ^c_type_decl_host_transport_identity,
    workspace: [
      v2.std.host_transport.WorkspaceFile {
        path: "fixture.c",
        content: v2.std.host_transport.EmittedWithSuffix { suffix: main_suffix }
      }
    ],
    build: [
      v2.std.host_transport.ProcessInvocation {
        program: v2.std.host_transport.HostToolProgram { executable: "cc" },
        args: [v2.std.host_transport.LiteralArg { text: "fixture.c" }, v2.std.host_transport.LiteralArg { text: "-o" }, v2.std.host_transport.LiteralArg { text: "fixture" }]
      }
    ],
    run: v2.std.host_transport.ProcessInvocation {
      program: v2.std.host_transport.ProducedProgram { path: "fixture" },
      args: []
    },
    runtime_value_codec: v2.std.host_transport.FixedWidthBytes { width: 5 }
  }
}

